          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_esper_010_esper_07",
      "hash64": "49A59D62ABD9D429",
      "text": "더구나 상대가 [VAR 0x0100(0000)][VAR 0x1900(0006)]라면\\n리파도 제 실력을 발휘할 수 있으니까![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
