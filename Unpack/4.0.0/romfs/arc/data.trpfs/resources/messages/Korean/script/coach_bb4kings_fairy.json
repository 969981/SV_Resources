        }
      ]
    },
    {
      "ordinal": 66,
      "label": "coach_bb4kings_fairy_randomtalk_02",
      "hash64": "F901F710E781190B",
      "text": "저희 아빠는 체육관 관장인데\\n엄청 험상궂게 생겼어요.\\c\\n남자애들이 말을 걸었을 때\\n아빠 이름을 대면 다들 도망칠 정도예요.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
