          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_botan_a_select_01",
      "hash64": "20DD942EF5E4E181",
      "text": "뭐 하고 있어?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_botan_a_select_02",
      "hash64": "20DD912EF5E4DC68",
      "text": "무슨 일이야?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_botan_a_04",
      "hash64": "3628B6A5496FE219",
      "text": "아니...\\n저... 그게...\\r\\n자백하는 수밖에 없나...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_botan_a_05",
      "hash64": "3628B5A5496FE066",
      "text": "저걸 봐 봐.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_botan_a_06",
      "hash64": "3628B4A5496FDEB3",
      "text": "그렇게 된 거야... 알았지?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_botan_a_select_03",
      "hash64": "20DD922EF5E4DE1B",
      "text": "어떻게 된 건데?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_botan_a_select_04",
      "hash64": "20DD972EF5E4E69A",
      "text": "설명해 줘",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_botan_a_07",
      "hash64": "3628B3A5496FDD00",
      "text": "아, 미안\\n너무 놀라서 허둥지둥하네.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_botan_a_08",
      "hash64": "3628C2A5496FF67D",
      "text": "요, 요즘, 단 친구들이랑\\n등교하게 됐잖아...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_botan_a_09",
      "hash64": "3628C1A5496FF4CA",
      "text": "그래서 애들이 잘 적응하고 있나\\n걱정돼서 보고 있던 거야...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_botan_a_aku_01",
      "hash64": "65304FA143DF53AA",
      "text": "...우리 말이야. 역시 아직은\\n아웃사이더 같은 느낌이지 않아?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_botan_a_fairy_01",
      "hash64": "1D3B2C79154455C0",
      "text": "그야 그렇지.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_botan_a_fairy_02",
      "hash64": "1D3B2F7915445AD9",
      "text": "선생님들하고는\\n오해가 풀렸다지만,[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_botan_a_fairy_03",
      "hash64": "1D3B2E7915445926",
      "text": "모두가 “그래, 그랬구나” 하고\\n이해해 주기는 어렵지 않겠어?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_botan_a_aku_02",
      "hash64": "65304EA143DF51F7",
      "text": "그렇겠지~?\\n그렇다면 역시...\\r\\n노선을 변경할 수밖에 없겠네.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_botan_a_10",
      "hash64": "3625B4A5496DA8DC",
      "text": "노선을... 변경해...?\\n개조해서 입었던 교복을\\r\\n평범한 옷으로 바꾼다는 걸까...?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_botan_a_11",
      "hash64": "3625B5A5496DAA8F",
      "text": "피나... 티가...\\n학교에 적응하려고 노력하고 있구나...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_botan_a_fairy_04",
      "hash64": "1D3B317915445E3F",
      "text": "노선을 변경한다니, 뭘 하려고?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_botan_a_aku_03",
      "hash64": "65304DA143DF5044",
      "text": "아 그거? 글쎄...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_botan_a_aku_04",
      "hash64": "65304CA143DF4E91",
      "text": "큰 소리로 모두에게\\n인사해 보면 어떨까?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_botan_a_fairy_05",
      "hash64": "1D3B307915445C8C",
      "text": "뭐어!? 뭐야 그게!\\n나는 절대 안 해! 알았어?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_botan_a_12",
      "hash64": "3625B6A5496DAC42",
      "text": "...어라?\\n뭔가 이상한데?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_botan_a_aku_05",
      "hash64": "65304BA143DF4CDE",
      "text": "그러지 말고\\n일단 내 말 좀 들어 봐, 오르티가.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_botan_a_aku_06",
      "hash64": "65304AA143DF4B2B",
      "text": "라임 님의 라이브가 어떤지\\n잘 생각해 보라고.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_botan_a_aku_07",
      "hash64": "653049A143DF4978",
      "text": "분위기가 가라앉은 회장에서\\n라임 님은 일단 큰 소리로 샤우팅...\\r\\n인사로 분위기를 띄우잖아![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_botan_a_fairy_06",
      "hash64": "1D3B3379154461A5",
      "text": "그건 라이브니까 그렇지.\\n여기는 학교잖아![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_botan_a_aku_08",
      "hash64": "653048A143DF47C5",
      "text": "그럼, 오르티가 너는 아무것도 안 하고\\n계속 아웃사이더로 있어도 좋은 거야?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_botan_a_fairy_07",
      "hash64": "1D3B327915445FF2",
      "text": "그, 그건 싫지만...[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_botan_a_aku_09",
      "hash64": "653047A143DF4612",
      "text": "그렇지? 그렇다면 역시\\n큰 소리로 인사해 보는 수밖에 없다고!\\r\\n자, 하나 둘...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_botan_a_aku_10",
      "hash64": "652CCAA143DC3BD4",
      "text": "여러분~!!\\n안녕하십니까~!![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "kizuna_botan_a_fairy_08",
      "hash64": "1D3B35791544650B",
      "text": "잠깐, 야!\\n피나! 아이, 창피하게![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "kizuna_botan_a_aku_11",
      "hash64": "652CCBA143DC3D87",
      "text": "안녕하십니까~!!\\n자, 오르티가 너도![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
