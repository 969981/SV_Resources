      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc01_0430_sister_01",
      "hash64": "CBFF4DD8D0C2736B",
      "text": "이런~ 역시 싫은가 봐.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
