    {
      "ordinal": 2,
      "label": "sub_025_sitappa_a_03",
      "hash64": "374EC6ECC983ADC2",
      "text": "아무것도 대접해 줄 건 없지만\\n...이걸 줄게.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
