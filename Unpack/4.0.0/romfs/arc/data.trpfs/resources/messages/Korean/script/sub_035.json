          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sub_035_mgirl_12",
      "hash64": "4A5CAB61B3DBE1FA",
      "text": "우와! 정말 작구나!\\n[VAR 0x0101(0001)]계의 작은 아이돌 같아!\\r\\n대단히 매력적이야!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
