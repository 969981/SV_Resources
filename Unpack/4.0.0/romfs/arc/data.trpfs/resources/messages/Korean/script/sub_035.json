          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_035_mgirl_14",
      "hash64": "4A5CA561B3DBD7C8",
      "text": "분명히 세계에서 가장 작은\\n[VAR 0x0101(0001)]일 거야!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_035_mgirl_15",
      "hash64": "4A5CA661B3DBD97B",
      "text": "커다란 포켓몬을\\n보여 줘서 고마워!\\r\\n이 증표를 달아 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sub_035_mgirl_16",
      "hash64": "4A5CA761B3DBDB2E",
      "text": "조그만 포켓몬을\\n보여 줘서 고마워!\\r\\n이 증표를 달아 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
