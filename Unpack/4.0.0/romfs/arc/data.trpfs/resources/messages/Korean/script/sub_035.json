          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_035_mgirl_13",
      "hash64": "4A5CAC61B3DBE3AD",
      "text": "What a SMALL 포켓몬~!!!!\\c\\n이 정도로 작은 아이는\\n좀처럼 보기 힘들다구!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
