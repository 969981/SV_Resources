          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side01_0000_friend_13",
      "hash64": "A853598B63CDBEEC",
      "text": "집 앞에서 기다릴 테니까\\n나중에 보자![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
