    {
      "ordinal": 34,
      "label": "gym_normal_030_shop_00",
      "hash64": "04CA2005066AAA90",
      "text": "체육관 테스트 때문에 오신 손님이시군요!\\n보물식당 비밀 메뉴에 대한\\r\\n힌트는 얻으셨나요?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
