        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc02_0050_fairybb_24",
      "hash64": "17FDD2564E4BAD90",
      "text": "다음은 게이트를 통해\\n[VAR 0xFF00(0006)]테라리움 돔[VAR 0xFF00(0000)]으로 가 봐요![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
