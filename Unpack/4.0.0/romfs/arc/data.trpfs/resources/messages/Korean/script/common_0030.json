    {
      "ordinal": 2,
      "label": "common_0030_mama_03",
      "hash64": "73E051C9F3FED425",
      "text": "오늘부터 새 학교에 가게 돼서\\n많이 기대됐나 보네?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
