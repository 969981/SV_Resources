          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0030_mama_04",
      "hash64": "73E04AC9F3FEC840",
      "text": "실은 엄마도\\n많이 기대하고 있어![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
