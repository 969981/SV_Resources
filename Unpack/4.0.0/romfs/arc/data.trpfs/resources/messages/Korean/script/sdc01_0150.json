      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc01_0150_shop_02",
      "hash64": "105B34B2987AB293",
      "text": "어라?\\n너는 팔데아에서 온 애인가 보구나?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
