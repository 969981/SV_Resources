    },
    {
      "ordinal": 66,
      "label": "coach_paldea_friend_randomtalk_02",
      "hash64": "9EB3DE09A671C6BF",
      "text": "[VAR 0x0100(0000)]네 어머님이\\n만들어 주신 요리, 맛있었어!\\c\\n다음에는 네가 만든\\n샌드위치도 먹어 보게 해 줘![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
