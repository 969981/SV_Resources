    {
      "ordinal": 2,
      "label": "coach_bb4kings_dragon_sp01_00",
      "hash64": "0DC137C9AC11B066",
      "text": "왔구나, 챔피언.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
