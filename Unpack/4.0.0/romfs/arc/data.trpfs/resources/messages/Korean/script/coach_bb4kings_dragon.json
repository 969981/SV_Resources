    },
    {
      "ordinal": 42,
      "label": "coach_bb4kings_dragon_trade_02_02",
      "hash64": "931380940D09310F",
      "text": "희귀한 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
