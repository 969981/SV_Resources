    {
      "ordinal": 41,
      "label": "coach_bb4kings_dragon_trade_02_01",
      "hash64": "931381940D0932C2",
      "text": "어버이가 자신이 아닌 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
