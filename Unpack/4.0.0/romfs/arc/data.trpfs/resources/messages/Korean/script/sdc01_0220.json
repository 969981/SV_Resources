    {
      "ordinal": 2,
      "label": "sdc01_0220_sister_01",
      "hash64": "3BFDE75713F5A850",
      "text": "칫, 그새 일어났잖아.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
