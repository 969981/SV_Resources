          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0220_brother_02",
      "hash64": "B91452C0B7BAD1B7",
      "text": "마지막 간판을 찾으러 출발할까~?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
