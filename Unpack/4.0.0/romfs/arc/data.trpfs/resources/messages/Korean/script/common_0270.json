    {
      "ordinal": 1,
      "label": "common_0270_head_teacher_02",
      "hash64": "F612F886ADD63A71",
      "text": "오렌지 아카데미는 마음에 드셨나요?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
