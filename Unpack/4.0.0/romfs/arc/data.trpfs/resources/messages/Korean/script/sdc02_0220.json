    },
    {
      "ordinal": 33,
      "label": "sdc02_0220_announcement_04",
      "hash64": "D2468E1286E8B001",
      "text": "브라이어 선생님이 손님과 함께\\n기다리고 있사오니",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
