      ]
    },
    {
      "ordinal": 45,
      "label": "sdc02_0130_dragonbb_12",
      "hash64": "556BA394434EAAEA",
      "text": "사천왕과 싸우기 전에\\n소소한 게임도 해야 하니까\\r\\n기대해도 좋을걸?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
