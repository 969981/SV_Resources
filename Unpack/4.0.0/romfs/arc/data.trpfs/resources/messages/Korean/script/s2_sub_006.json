            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_006_boy_06",
      "hash64": "078D6145277CD75C",
      "text": "오오오... 굉장해!\\n동경심마저 생길 정도야!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_006_boy_07",
      "hash64": "078D6245277CD90F",
      "text": "보답으로 가라르지방에서 유행하는\\n최강의 감정 표현을 가르쳐 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_006_system_01",
      "hash64": "A543D85A3529B876",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)] 남자아이로부터\\n[VAR 0xFF00(0008)]리자몽 포즈 감정 표현[VAR 0xFF00(0000)]을 배웠다!",
