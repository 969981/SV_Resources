          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "s2_sub_010_headbb_33",
      "hash64": "111DBB69A27BF0ED",
      "text": "앞으로도 돔의 포켓몬들과\\n사이좋게 지내렴![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "s2_sub_010_head_09",
      "hash64": "15B674B8135DC190",
      "text": "...시아노 선생님?\\n말씀 중에 죄송합니다만...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s2_sub_010_head_10",
      "hash64": "15B2F7B8135AB752",
      "text": "슬슬 학생들 앞에서\\n클라베리라고 부르시는 건 어떻게 안 될지...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "s2_sub_010_head_11",
      "hash64": "15B2F8B8135AB905",
      "text": "저기... 제 말 듣고 계시죠?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "s2_sub_010_headbb_18",
      "hash64": "1124AC69A281F61E",
      "text": "굿 모닝! 아침부터 부지런하네!\\c\\n나는 일찍 깨서 나왔단다.\\n나이를 먹으니까 오래 못 자겠더라고.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "s2_sub_010_headbb_19",
      "hash64": "1124AD69A281F7D1",
      "text": "안녕, [VAR 0x0100(0000)]!\\n교환 유학은 잘 만끽하고 있니?\\c\\n포켓몬도 많이 잡고!\\n블루레크도 하면서 즐겁게 지내렴![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "s2_sub_010_headbb_20",
      "hash64": "11213E69A27F055D",
      "text": "석양을 구경하기에\\n완전 최고의 자리지 않니?\\c\\n이것만 봐도 바다 한가운데에\\n학교를 짓기 잘했단 생각이 든단 말이지~[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "s2_sub_010_headbb_21",
      "hash64": "11213D69A27F03AA",
      "text": "안녕, [VAR 0x0100(0000)]!\\n너는 밤에도 기운이 넘치는구나~\\c\\n이 아저씨는\\n슬슬 자러 가야지.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "s2_sub_010_headbb_22",
      "hash64": "11213C69A27F01F7",
      "text": "안녕!\\n오늘은 비가 오네~\\c\\n뭐, 옷이 젖더라도\\n파도 때문인지 비 때문인지 알 수 없는 게\\r\\n우리 아카데미의 장점이니까.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "s2_sub_010_headbb_23",
      "hash64": "11213B69A27F0044",
      "text": "안녕, [VAR 0x0100(0000)]!\\n또 비가 오네~\\c\\n입구에 지붕을 설치할 수도 있었지만,\\n물을 좋아하는 포켓몬도 있으니까 그만뒀어![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "s2_sub_010_headbb_24",
      "hash64": "11213A69A27EFE91",
      "text": "아쉽지만 오늘은\\n석양을 보기 그른 모양이야.\\c\\n테라리움 돔의 하늘로\\n인공 석양이나 즐길까?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "s2_sub_010_headbb_25",
      "hash64": "11213969A27EFCDE",
      "text": "안녕, [VAR 0x0100(0000)]!\\n비에 젖으면서도 열심이구나~\\c\\n바닥이 미끄러울 테니\\n바다에 빠지지 않게 조심하렴~[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
