          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_sub_010_headbb_15",
      "hash64": "1124A969A281F105",
      "text": "이야~ [VAR 0x0100(0000)]의 보물찾기는\\n우리 아카데미에서도 대성공인걸![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
