  "entries": [
    {
      "ordinal": 0,
      "label": "class_e_07_battle_01",
      "hash64": "83CD34680E21DA36",
      "text": "안녕! 마지막 수업도 기운차게!\\n잘 마무리해 보자![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
