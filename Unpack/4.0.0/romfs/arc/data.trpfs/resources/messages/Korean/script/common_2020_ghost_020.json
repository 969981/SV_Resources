      "label": "common_2020_ghost_020_ghost_01",
      "hash64": "C4780CFDD2B29596",
      "text": "네가 체육관 테스트를 받으러 온 게\\n진짜 엊그제 일인 것 같은데[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
