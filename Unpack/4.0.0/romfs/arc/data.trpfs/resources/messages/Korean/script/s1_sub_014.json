          "code_hex": "BDFF",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_014_header_12",
      "hash64": "5C4E3CC3E115D6EC",
      "text": "현재 위치에 따라\\n바뀌도록 설정했습니다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s1_sub_014_select_00",
      "hash64": "FA5357055DDCC748",
      "text": "“현재 위치에 따라”로 변경!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
