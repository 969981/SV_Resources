      ]
    },
    {
      "ordinal": 1,
      "label": "class_a_08_ecology_02",
      "hash64": "E61209A4A4133C3E",
      "text": "지금까지 배운 것을 모두 복습하는 정도니까\\n여러분이라면 문제없을 거예요~![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
