    {
      "ordinal": 1,
      "label": "sdc01_0100_sister_02",
      "hash64": "6ED1BAA3196FDF86",
      "text": "흐응~?\\n우리랑 교류라는 게\\r\\n하고 싶으시다?[VAR 0x0114(0044)]",
      "flags": 0,
