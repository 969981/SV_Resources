      "ordinal": 21,
      "label": "sdc01_0100_student1_01",
      "hash64": "F5FB6C36E5761431",
      "text": "나이스 파이트~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
