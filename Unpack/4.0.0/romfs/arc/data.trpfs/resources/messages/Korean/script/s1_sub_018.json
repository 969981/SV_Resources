    },
    {
      "ordinal": 15,
      "label": "s1_sub_018_woman_npc",
      "hash64": "4173059D9564CBB3",
      "text": "하트 감정 표현...\\n다른 사람이랑 같이 해 봐.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s1_sub_018_man_npc",
      "hash64": "89644607171F7931",
      "text": "사람에게나 포켓몬에게나\\n러브가 넘치고 있구나...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
