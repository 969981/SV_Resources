  "entries": [
    {
      "ordinal": 0,
      "label": "common_2020_mizu_010_mizu_01",
      "hash64": "23B358EDDFA19B4F",
      "text": "어서 옵쇼~!\\n카라프체육관에 잘 오셨습니다![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
