      "label": "s2_sub_041_synchro_01",
      "hash64": "86F82819633C9676",
      "text": "으음~ 싱크로~![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
