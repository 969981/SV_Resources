    },
    {
      "ordinal": 2,
      "label": "s2_sub_041_synchro_02",
      "hash64": "86F82719633C94C3",
      "text": "...앗!\\n나는 대단한 연구원이야.\\r\\n이름은 싱크로미![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
