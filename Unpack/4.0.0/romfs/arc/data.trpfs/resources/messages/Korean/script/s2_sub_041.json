          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_041_synchro_03",
      "hash64": "86F82619633C9310",
      "text": "너, 괜찮다면 대단한 실험에\\n협력해 주지 않을래?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_041_synchro_04",
      "hash64": "86F82D19633C9EF5",
      "text": "...세기의 대발견을\\n직접 목격할 수 있는 기회인데!?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_041_synchro_05",
      "hash64": "86F82C19633C9D42",
      "text": "[EMPTY 31]",
