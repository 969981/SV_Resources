    },
    {
      "ordinal": 40,
      "label": "coach_teacher_head_trade_01_03",
      "hash64": "ADDDD6D5FDF322AC",
      "text": "감사합니다.\\n저는 빠모트를 드리겠습니다.\\r\\n[VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양은 어떻게 하실 거죠?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
