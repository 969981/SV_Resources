        }
      ]
    },
    {
      "ordinal": 63,
      "label": "coach_teacher_head_randomtalk_02",
      "hash64": "E7F34E7502756660",
      "text": "시아노 선생님이라면\\n조금 전에 입구 로비에서 봤습니다.\\c\\n서류 업무는 제대로 하고 계신 건지...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
