    },
    {
      "ordinal": 2,
      "label": "sub_042_staff_03",
      "hash64": "6DA0F110727994C7",
      "text": "[VAR 0x0105(0001)]에서\\n당신이 쓰러뜨린 트레이너는...\\r\\n[VAR 0x0201(0003)]명이군요!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
