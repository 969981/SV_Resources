      "ordinal": 0,
      "label": "sub_042_staff_01",
      "hash64": "6DA0F3107279982D",
      "text": "안녕하세요, 포켓몬리그입니다!\\n포켓몬 승부는 하고 계십니까!?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
