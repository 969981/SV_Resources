      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_kusa_010_kusa_03",
      "hash64": "5570C5F19675A52F",
      "text": "그런 건 아무래도 좋다!![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
