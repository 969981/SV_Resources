          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_kusa_010_kusa_04",
      "hash64": "5570C2F19675A016",
      "text": "너와의 예술적인 배틀을 떠올리면서\\n다시 만나게 될 날을 그렇게 기원했건만![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_kusa_010_kusa_05",
      "hash64": "5570C3F19675A1C9",
      "text": "이렇게 와 줘서 정말 기쁘구나!\\n어머니와 같은 자연이시여, 감사합니다...![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_kusa_010_kusa_06",
      "hash64": "5570C0F196759CB0",
      "text": "이 뒤에 치프 챔피언과\\n만날 예정이었다만 그건 캔슬이다!\\r\\n자! 나와 같이 예술에 대해 얘기하지 않겠나![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
