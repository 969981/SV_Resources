      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_health_a_04a",
      "hash64": "2BB1BECD5888CF18",
      "text": "흐음~\\n전학 온 지 얼마 안 됐구나~[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
