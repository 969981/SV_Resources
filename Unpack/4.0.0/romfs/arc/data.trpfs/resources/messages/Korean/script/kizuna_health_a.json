      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_health_a_04b",
      "hash64": "2BB1C1CD5888D431",
      "text": "에이, 속이려고 해 봤자\\n나한테는 안 통한다구...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
