        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_health_a_07",
      "hash64": "AA92A861935473D0",
      "text": "아, 그렇지!\\n보물찾기였나? 그거 시작했지?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
