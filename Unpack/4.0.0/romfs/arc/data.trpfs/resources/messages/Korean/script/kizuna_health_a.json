      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_health_a_05",
      "hash64": "AA92AA6193547736",
      "text": "아~ [VAR 0x0100(0000)][VAR 0x1900(0006)]구나!\\n소문의 그 아이인가 보네~[VAR 0x0114(0028)]",
