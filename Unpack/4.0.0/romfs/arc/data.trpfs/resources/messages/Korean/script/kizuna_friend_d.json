    {
      "ordinal": 1,
      "label": "kizuna_friend_d_02",
      "hash64": "141BF53C57527CDC",
      "text": "...... ......[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
