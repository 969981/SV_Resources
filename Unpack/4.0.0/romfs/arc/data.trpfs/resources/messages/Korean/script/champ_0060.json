    {
      "ordinal": 7,
      "label": "champ_0060_rival_07b",
      "hash64": "C80228A67A69894E",
      "text": "미안!\\n너무 강한 애들만 꺼냈나 봐.[VAR 0x0114(0004)]",
      "flags": 0,
