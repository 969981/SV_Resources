          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2100_head_teacher_04",
      "hash64": "02387CD22F4BB273",
      "text": "바로 [VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양입니다![VAR 0x0114(000A)]",
