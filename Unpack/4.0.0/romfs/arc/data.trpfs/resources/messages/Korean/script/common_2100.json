      ]
    },
    {
      "ordinal": 1,
      "label": "common_2100_head_teacher_02",
      "hash64": "023882D22F4BBCA5",
      "text": "이미 알고 계신 분들도\\n있으시겠지만...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
