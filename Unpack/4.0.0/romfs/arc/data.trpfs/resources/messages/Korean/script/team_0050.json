    },
    {
      "ordinal": 36,
      "label": "team_0050_botan_09",
      "hash64": "B1BA6939D0BFF9F9",
      "text": "스타더스트 대작전의 전투반인\\n[VAR 0x0100(0000)][VAR 0x1900(0003)] 보기에\\r\\n스타단은 어떤 것 같아...?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
