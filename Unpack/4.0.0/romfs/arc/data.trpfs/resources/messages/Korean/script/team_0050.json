          "args_hex": [
            "0003"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "team_0050_select_03",
      "hash64": "72B56F1AFFE6365F",
      "text": "강했어",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "team_0050_select_04",
      "hash64": "72B56C1AFFE63146",
      "text": "그럭저럭이었어",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "team_0050_botan_10",
      "hash64": "B1BDF639D0C31F67",
      "text": "...흐음.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0050_botan_11",
      "hash64": "B1BDF539D0C31DB4",
      "text": "소문에 의하면,\\n스타단은 원래부터 불량하지는 않았대.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "team_0050_botan_12",
      "hash64": "B1BDF839D0C322CD",
      "text": "대부분이 괴롭힘을 당했거나\\n남들과 어울리는 게 서툴 뿐인...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "team_0050_botan_13",
      "hash64": "B1BDF739D0C3211A",
      "text": "그런 사람들이 모여서\\n스타단을 결성한 거래.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "team_0050_botan_14",
      "hash64": "B1BDF239D0C3189B",
      "text": "혼자서는 맞설 수 없는\\n괴롭힘에 저항하기 위해서 말이야...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "team_0050_botan_15",
      "hash64": "B1BDF139D0C316E8",
      "text": "아, 이건 학생들의 SNS를 해킹해서\\n알아낸 정보인데...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "team_0050_botan_16",
      "hash64": "B1BDF439D0C31C01",
      "text": "5명의 보스를 모아서 단을 결성한\\n진짜 흑막도 있다는 것 같아...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "team_0050_botan_17",
      "hash64": "B1BDF339D0C31A4E",
      "text": "말을 많이 했더니 목이 아파...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "team_0050_botan_18",
      "hash64": "B1BDEE39D0C311CF",
      "text": "남은 단의 아지트도\\n그... 열심히 해.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
