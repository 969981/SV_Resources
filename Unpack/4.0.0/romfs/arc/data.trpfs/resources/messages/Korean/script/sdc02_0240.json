      "label": "sdc02_0240_brother_02",
      "hash64": "E5516D344920DC30",
      "text": "이제 좀... 진정됐어요.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
