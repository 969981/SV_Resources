    },
    {
      "ordinal": 2,
      "label": "sdc02_0240_bbteacher_03",
      "hash64": "D96E49F4CEC7BC43",
      "text": "좋아!\\n드디어 출발할 수 있겠네![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
