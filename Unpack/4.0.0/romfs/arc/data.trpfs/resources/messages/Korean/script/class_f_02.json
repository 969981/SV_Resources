          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_f_02_dragon_03",
      "hash64": "29271535F9FB3657",
      "text": "그래서 오늘은 여러분이\\n미술에 대한 흥미를 느끼실 수 있도록...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_f_02_dragon_04",
      "hash64": "29271235F9FB313E",
      "text": "특별 게스트를 모셨습니다![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
