    {
      "ordinal": 16,
      "label": "class_f_02_dragon_answer_02",
      "hash64": "B5B4B0F8E0F4125B",
      "text": "아깝네요, [VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양!\\n이건 불꽃에 약한 타입입니다![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 11,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
