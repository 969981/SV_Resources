          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_f_02_dragon_06",
      "hash64": "29271035F9FB2DD8",
      "text": "그럼, 딥상어동 선배님.\\n테라스탈을 부탁드리겠습니다![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_f_02_poke_02",
      "hash64": "877FFF16215C5BF2",
      "text": "띠이~브!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_f_02_dragon_07",
      "hash64": "29271135F9FB2F8B",
      "text": "테라스탈오브를 사용하면\\n포켓몬이 테라스탈합니다.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_f_02_dragon_08",
      "hash64": "29270E35F9FB2A72",
      "text": "평소에는 드래곤타입인\\n딥상어동 선배입니다만...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_f_02_dragon_09",
      "hash64": "29270F35F9FB2C25",
      "text": "지금은 테라스탈 파워에 의해\\n평소와 다른 타입으로 변했지요?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_f_02_dragon_10",
      "hash64": "292A7C35F9FE1B33",
      "text": "자, 머리 위에서 빛나고 있는\\n이 아름다운 꽃의 형상들은...\\r\\n어떤 타입을 나타내는 걸까요?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
