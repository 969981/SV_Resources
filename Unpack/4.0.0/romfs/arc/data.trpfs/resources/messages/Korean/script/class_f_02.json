    {
      "ordinal": 15,
      "label": "class_f_02_dragon_answer_01",
      "hash64": "B5B4B1F8E0F4140E",
      "text": "[VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양!\\n100점 만점입니다![VAR 0x0114(0012)]",
      "flags": 0,
