      "hash64": "D1986E131C4677EF",
      "text": "아하하!\\n저는 완전 상관없어요![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
