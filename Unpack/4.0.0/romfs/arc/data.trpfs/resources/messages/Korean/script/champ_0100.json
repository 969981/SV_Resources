    {
      "ordinal": 15,
      "label": "champ_0100_chairman_08",
      "hash64": "257AC52918241DA9",
      "text": "포켓몬리그 위원장과\\n겸직으로 맡고 있어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
