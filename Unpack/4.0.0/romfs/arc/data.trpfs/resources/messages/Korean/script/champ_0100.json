      "ordinal": 24,
      "label": "champ_0100_chairman_11",
      "hash64": "257748291821136B",
      "text": "잠깐만요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
