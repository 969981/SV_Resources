          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0100_rival_03",
      "hash64": "D19503131C438C47",
      "text": "앗! 어째서 치프가\\n[VAR 0x0100(0000)][VAR 0x1900(0006)]랑 같이...!?[VAR 0x0114(0004)]",
      "flags": 0,
