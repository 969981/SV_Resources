      "ordinal": 25,
      "label": "champ_0100_rival_13",
      "hash64": "D1986B131C4672D6",
      "text": "네? 무슨 일이세요?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
