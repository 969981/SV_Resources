      "ordinal": 18,
      "label": "champ_0100_rival_08",
      "hash64": "D194FC131C438062",
      "text": "엥!? [VAR 0x0100(0000)],\\n벌써 유명인이 된 거야!?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
