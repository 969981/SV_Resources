      "ordinal": 26,
      "label": "champ_0100_chairman_12",
      "hash64": "257749291821151E",
      "text": "그 시합, 괜찮다면 저도\\n견학하고 싶어서요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
