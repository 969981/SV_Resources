          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0100_rival_05",
      "hash64": "D19501131C4388E1",
      "text": "이분은 말이지~ 모두가 동경하는\\n챔피언 랭크 중에서도 정점에 있는...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
