      "hash64": "25774729182111B8",
      "text": "후후...\\n인기가 많으시네요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
