          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0100_rival_02",
      "hash64": "D19502131C438A94",
      "text": "체육관에서 한 승부도 잘 봤어!\\n또 저번보다 강해졌던데![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
