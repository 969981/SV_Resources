      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "champ_0100_select_02",
      "hash64": "4D7383B3C29BE89E",
      "text": "대단한 사람...!?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "champ_0100_rival_04",
      "hash64": "D19500131C43872E",
      "text": "어라!?\\n제대로는 설명해 준 적이 없던가!?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
