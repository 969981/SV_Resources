      ]
    },
    {
      "ordinal": 41,
      "label": "team_0160_doku_02",
      "hash64": "1D9A2FE70425B6D7",
      "text": "동의하오...\\n모란 나리도 같이...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
