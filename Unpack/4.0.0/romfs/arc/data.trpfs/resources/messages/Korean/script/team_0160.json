          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0160_botan_07",
      "hash64": "1B118DCD8DCB51E3",
      "text": "그게... 재밌어 보이긴 하고,\\n뭔가 윈윈처럼 느껴지긴 하는데...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0160_fairy_02",
      "hash64": "DD5A983A638C2DB1",
      "text": "벌을 받는 입장인 우리가 말하는 게\\n조금 이상하긴 하지만, 모란도 같이 하자![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
