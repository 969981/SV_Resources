      ]
    },
    {
      "ordinal": 42,
      "label": "team_0160_kakutou_02",
      "hash64": "515BA81EB832E816",
      "text": "학교도 같이 다니는 거야!\\n무슨 일이 있어도, 우리가 지켜 줄 테니까![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
