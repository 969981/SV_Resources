          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "team_0160_botan_02",
      "hash64": "1B1190CD8DCB56FC",
      "text": "...응? 네?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
