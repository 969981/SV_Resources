    },
    {
      "ordinal": 1,
      "label": "team_0160_head_teacher_02",
      "hash64": "40212EBBE39C5B65",
      "text": "아카데미를 대표해서\\n스타단 여러분께 드릴 말씀이 있습니다.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
