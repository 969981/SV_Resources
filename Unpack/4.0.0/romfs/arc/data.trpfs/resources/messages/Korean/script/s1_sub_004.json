  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_004_woman_01",
      "hash64": "966BBC4DF81B81B8",
      "text": "오~호호호!\\n오~호호호![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_004_woman_02",
      "hash64": "966BBF4DF81B86D1",
      "text": "이게 그 소문으로만 듣던\\n팔데아 10경 중 하나...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_004_man_01",
      "hash64": "9813539872C175D2",
      "text": "맞아, 나리아!\\n여기가 바로 마구찌르기 폭포야![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_004_woman_03",
      "hash64": "966BBE4DF81B851E",
      "text": "상상했던 것과는 다르게\\n심심한 폭포네...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_004_woman_04",
      "hash64": "966BC14DF81B8A37",
      "text": "뭐, 심심하긴 하지만,\\n음이온이 느껴지니 괜찮아![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_004_man_02",
      "hash64": "9813529872C1741F",
      "text": "오~ 역시 나의 나리아!\\n언제나 포지티브한 레이디라니까![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_004_man_03",
      "hash64": "9813519872C1726C",
      "text": "내게는 음이온뿐만 아니라\\n셀럽 이온까지 느껴지는 것 같은데![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_004_man_04",
      "hash64": "9813509872C170B9",
      "text": "그야말로 셀럽계의 공기 청정기!\\n유후~![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_004_woman_05",
      "hash64": "966BC04DF81B8884",
      "text": "오~ 빌리오!\\n듣기 좋은 진실, 땡큐![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_004_woman_06",
      "hash64": "966BC34DF81B8D9D",
      "text": "어머, 당신은...\\n지난번의 그 서민님![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_004_man_05",
      "hash64": "98134F9872C16F06",
      "text": "정말이군!\\n틀림없이 지난번의 그 서민이야![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_004_man_06",
      "hash64": "98134E9872C16D53",
      "text": "우연인지 운명인지... 그게 아니면,\\n우리 나리아의 셀럽 이온에 이끌린 건가?[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_004_woman_07",
      "hash64": "966BC24DF81B8BEA",
      "text": "오~호호호!\\n과연, 그런 거였군요![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_004_woman_08",
      "hash64": "966BB54DF81B75D3",
      "text": "사람들에게 꿈을 선사하는 것이\\n우리 셀럽들의 의무...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_004_woman_09",
      "hash64": "966BB44DF81B7420",
      "text": "그러니 이것을 드리겠어요.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_004_woman_10",
      "hash64": "9668374DF81869E2",
      "text": "잘 들으세요, 서민님.\\n돈은 음이온과 같은 존재예요.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_004_woman_11",
      "hash64": "9668384DF8186B95",
      "text": "둘러싸여 있으면 안정감과\\n평온함을 가져다주지만...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_sub_004_woman_12",
      "hash64": "9668354DF818667C",
      "text": "그렇게 해서 얻은 행복이\\n진실된 것인지는 알 수 없으니까요.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_sub_004_man_07",
      "hash64": "98134D9872C16BA0",
      "text": "오오... 심오하도다!\\n어린이에겐 너무 심오한 이야기라구, 나리아![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_sub_004_woman_13",
      "hash64": "9668364DF818682F",
      "text": "가자, 빌리오!\\n나, 명소도 아무것도 아닌\\r\\n[VAR 0xFF00(0006)]외진 곳[VAR 0xFF00(0000)]에 가고 싶어졌어![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_sub_004_man_08",
      "hash64": "98135C9872C1851D",
      "text": "유후~!\\n명소를 너무 다닌 나머지, 질려 버리다니!\\r\\n역시 우리 나리아는 셀럽의 귀감이라니까![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_004_man_09",
      "hash64": "98135B9872C1836A",
      "text": "남부 에리어 5와 남부 에리어 1 경계에\\n좋은 장소가 있다구![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_004_secretary_01",
      "hash64": "343F29DD74AED680",
      "text": "나리아 님과 빌리오 님께서는\\n팔데아지방 북부 에리어 2에 있는\\r\\n관광 명소로 유명한 폭포를 보러 가셨습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    }
  ]
}
