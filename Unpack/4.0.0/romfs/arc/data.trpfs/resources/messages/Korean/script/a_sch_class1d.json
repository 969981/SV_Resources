    {
      "ordinal": 7,
      "label": "a_sch_class1d_ni01",
      "hash64": "5501833A02E03C8A",
      "text": "양손에 나옹!\\n좋아하는 포켓몬에게 둘러싸여서\\r\\n행 복 해...!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
