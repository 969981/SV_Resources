      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "hud_net_status_offline_message01",
      "hash64": "DE55FC03F0658F36",
      "text": "인터넷 접속을 종료합니다.\\n괜찮겠습니까?",
