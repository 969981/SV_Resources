        }
      ]
    },
    {
      "ordinal": 4,
      "label": "hud_net_status_online_message01",
      "hash64": "B6725021CB781372",
      "text": "인터넷 접속에\\n필요한 정보를 받았습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "hud_net_status_online_message02",
      "hash64": "B6724F21CB7811BF",
      "text": "접속하고 있습니다.\\n잠시 기다려 주십시오...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "hud_net_status_online_message03",
      "hash64": "B6724E21CB78100C",
      "text": "리포트를 작성하고 있습니다.\\n잠시 기다려 주십시오...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "hud_net_status_online_message04",
      "hash64": "B6724D21CB780E59",
      "text": "인터넷에 접속했습니다.",
