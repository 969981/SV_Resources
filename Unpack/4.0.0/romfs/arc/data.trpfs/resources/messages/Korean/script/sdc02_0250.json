    },
    {
      "ordinal": 10,
      "label": "sdc02_0250_sister_02",
      "hash64": "7EFDE8C60D8013D5",
      "text": "엄마야! 깜짝이야!![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
