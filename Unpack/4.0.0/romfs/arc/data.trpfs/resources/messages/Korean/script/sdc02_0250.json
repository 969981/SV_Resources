    },
    {
      "ordinal": 16,
      "label": "sdc02_0250_bbteacher_05",
      "hash64": "703B898FDD7C1D7E",
      "text": "그보다 [VAR 0xFF00(0006)]더 깊은 곳[VAR 0xFF00(0000)]이니까![VAR 0x0114(0042)]",
