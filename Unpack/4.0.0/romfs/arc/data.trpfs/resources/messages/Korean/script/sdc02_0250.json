      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0250_sister_03",
      "hash64": "7EFDE7C60D801222",
      "text": "아으! 어쩌고돈인데... 뭐였더라!?\\n아무튼 너 말야... 너무 크다고![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
