      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0250_legend_02",
      "hash64": "D38743BABA551F22",
      "text": "아갸아...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc02_0250_brother_05",
      "hash64": "D18258A817368622",
      "text": "너도 멤버였던 거구나.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
