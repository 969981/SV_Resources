          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "ajito_doku_040_dokuboss_18",
      "hash64": "7EE6445EC924DFB8",
      "text": "그러니, 진 보스 나리가 귀환할 때까지\\n우리는 아지트를 지켜야만 하는 것이오![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "ajito_doku_040_student_09",
      "hash64": "E66373EF86A24393",
      "text": "너희들이 그렇게까지 신뢰하는\\n진 보스는 대체 누구지?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
