    {
      "ordinal": 49,
      "label": "ajito_doku_040_student_13",
      "hash64": "E666FDEF86A563E8",
      "text": "그래서 추명 나리는\\n학교에 가지 않는 거군요...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
