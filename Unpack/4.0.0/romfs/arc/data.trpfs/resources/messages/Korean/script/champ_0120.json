          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0120_dragon_10",
      "hash64": "FB4EFFF69816BB4A",
      "text": "저도 사천왕으로서\\n즐거운 마음으로 기다리고 있겠습니다.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
