    {
      "ordinal": 3,
      "label": "champ_0120_dragon_04",
      "hash64": "FB5269F69819A53F",
      "text": "가장 먼저\\n[VAR 0x0101(0001)][VAR 0x1900(0002)] 내보내자마자![VAR 0x0114(0012)]",
