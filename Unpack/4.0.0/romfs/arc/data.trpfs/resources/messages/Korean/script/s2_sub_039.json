          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_039_steel_09",
      "hash64": "794C40F237DE3B54",
      "text": "공중날기 타임어택에 새로\\n특급 코스를 설계했으니\\r\\n실력에 자신 있다면 도전해 주세요.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
