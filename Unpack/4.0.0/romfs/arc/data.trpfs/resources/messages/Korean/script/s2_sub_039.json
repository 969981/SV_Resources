        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_039_steel_10",
      "hash64": "7948B3F237DB15E6",
      "text": "공중날기 타임어택의\\n상급 코스를 클리어하면\\c\\n특급 코스에도 도전하실 수 있으니\\n실력에 자신 있다면 도전해 주세요.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
