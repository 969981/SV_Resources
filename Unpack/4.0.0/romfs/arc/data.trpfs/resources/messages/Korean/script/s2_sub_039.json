      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_039_legend_03",
      "hash64": "0D2284BD495E0F72",
      "text": "아갸아아스!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_039_system_01",
      "hash64": "1EA3E8AF2CA275D4",
      "text": "[VAR 0x0101(0001)][VAR 0x1900(0001)]\\n라이드 기술: 비행을 배웠다!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
