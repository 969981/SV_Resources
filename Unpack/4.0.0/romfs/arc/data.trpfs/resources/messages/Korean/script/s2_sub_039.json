    },
    {
      "ordinal": 2,
      "label": "s2_sub_039_steel_03",
      "hash64": "794C3AF237DE3122",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0003)] 챔피언이 된 뒤로\\n카지는 자신의 랭크를 포기했습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
