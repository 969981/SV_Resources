    {
      "ordinal": 1,
      "label": "s2_sub_039_steel_02",
      "hash64": "794C3BF237DE32D5",
      "text": "리그부 일... 그리고\\n카지 일은 감사했습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
