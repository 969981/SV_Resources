          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_01_system_01",
      "hash64": "62E99FF70BADB89A",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)]\\n50BP를 지불했다!",
