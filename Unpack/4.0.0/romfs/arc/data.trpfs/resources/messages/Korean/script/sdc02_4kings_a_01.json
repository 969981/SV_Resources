          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_01_clerk_04",
      "hash64": "D29BDD253506EA47",
      "text": "저...\\nBP가 부족하신 것 같네요...\\r\\n블루레크를 통해 모은 다음 도전해 주세요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
