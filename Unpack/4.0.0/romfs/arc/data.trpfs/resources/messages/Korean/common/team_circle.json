    {
      "ordinal": 38,
      "label": "team_circle_win_01_00",
      "hash64": "9A76A3A7D6767E7F",
      "text": "유니언 서클을 통해\\n친구와 함께 모험하겠습니까?",
      "flags": 0,
      "text_status": "DECODED",
