      ]
    },
    {
      "ordinal": 36,
      "label": "s1_sub_015_caretaker_32",
      "hash64": "AA103DEB9356FBA2",
      "text": "이 석상만 있으면 멋진 사진 명소로\\n관광객들을 잔뜩 끌어모을 수 있겠어![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
