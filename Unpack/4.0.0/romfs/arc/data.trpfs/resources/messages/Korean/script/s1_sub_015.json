      ]
    },
    {
      "ordinal": 34,
      "label": "s1_sub_015_worker_01",
      "hash64": "CC9B1C239B704542",
      "text": "원래 있었던 흠집이랑 얼룩도\\n완벽하게 재현했습죠!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "s1_sub_015_caretaker_31",
      "hash64": "AA103CEB9356F9EF",
      "text": "하하하!\\n장인의 기술이 빛을 발휘한 게로군![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
