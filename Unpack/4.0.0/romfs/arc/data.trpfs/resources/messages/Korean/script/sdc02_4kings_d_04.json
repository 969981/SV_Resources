    {
      "ordinal": 2,
      "label": "sdc02_4kings_d_04_dragonbb_03",
      "hash64": "0A40D89D4A8946BC",
      "text": "지금까지 코트 밖에서 본 게 전부였던가?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
