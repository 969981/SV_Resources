    {
      "ordinal": 0,
      "label": "class_b_01_math_01",
      "hash64": "57E6FF15A01D88CB",
      "text": "다들 만나서 반가워.\\n수학을 맡고 있는 타임 선생님이라고 해.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
