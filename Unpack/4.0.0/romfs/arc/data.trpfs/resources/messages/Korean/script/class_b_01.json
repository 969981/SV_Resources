          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_b_01_math_02",
      "hash64": "57E70015A01D8A7E",
      "text": "여러분들에게 먼저 질문 하나 할게.\\n수학이나 계산하는 것은\\r\\n다들 좋아하니?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_b_01_popup_01",
      "hash64": "1C7DF4F0B24454F1",
      "text": "좋아해요~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "class_b_01_popup_02",
      "hash64": "1C7DF1F0B2444FD8",
      "text": "조금은...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_b_01_popup_03",
      "hash64": "1C7DF2F0B244518B",
      "text": "으음...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_b_01_math_03",
      "hash64": "57E70115A01D8C31",
      "text": "어머나, 후후후...\\n대답해 줘서 고마워.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_b_01_math_04",
      "hash64": "57E70215A01D8DE4",
      "text": "좋아하는 사람도 있고, 싫어하는 사람도 있고\\n다양하니 정말 멋지네.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_b_01_math_05",
      "hash64": "57E70315A01D8F97",
      "text": "다들 너무 걱정하지 않아도 돼.\\c\\n선생님과 함께\\n신나게 공부해 보자~![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_b_01_math_06",
      "hash64": "57E70415A01D914A",
      "text": "그러고 보니,\\n다들 포켓몬의 타입 상성은 잘 알고 있니?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_b_01_math_07",
      "hash64": "57E70515A01D92FD",
      "text": "풀은 물에 강하고\\n물은 불꽃에 강하지?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_b_01_math_08",
      "hash64": "57E6F615A01D7980",
      "text": "그럼, 포켓몬에 대해 잘 알 것 같은\\n[VAR 0x0100(0000)]에게 질문 하나 할까?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_b_01_math_09",
      "hash64": "57E6F715A01D7B33",
      "text": "불꽃에 강한 물타입 기술 물대포를\\n불꽃타입 포켓몬에게 사용하면\\r\\n데미지는 어떻게 되지?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_b_01_select_01",
      "hash64": "27E4F980E00456F1",
      "text": "절반이 된다",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_b_01_select_02",
      "hash64": "27E4F680E00451D8",
      "text": "변하지 않는다",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_b_01_select_03",
      "hash64": "27E4F780E004538B",
      "text": "두 배가 된다",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_b_01_math_answer_01",
      "hash64": "1723D885F3F4473C",
      "text": "어머, 대단한 역발상인데?\\n그렇지만 선생님이라면\\r\\n싫어하는 것에 닿으면 더 괴로울 것 같아.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
