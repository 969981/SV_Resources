      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "sub_001_kimawari_03",
      "hash64": "2711297578B3D633",
      "text": "해루미를 [VAR 0x0201(0001)]마리 발견했다!\\n해루미 광장으로 데려가자!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
