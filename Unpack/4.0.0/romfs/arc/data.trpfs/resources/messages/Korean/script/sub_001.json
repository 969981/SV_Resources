    {
      "ordinal": 46,
      "label": "sub_001_keeper_01",
      "hash64": "B1C254ED006DD28A",
      "text": "체육관에 합격한 거 축하해!\\n체육관 배지가 눈부시네!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 47,
