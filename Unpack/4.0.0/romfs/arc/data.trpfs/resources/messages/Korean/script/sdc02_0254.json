      "label": "sdc02_0254_brother_04",
      "hash64": "1395062E5B93D499",
      "text": "전설의 포켓몬이\\n안에 있는 걸까...?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
