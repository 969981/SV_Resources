    {
      "ordinal": 17,
      "label": "sdc02_0254_bbteacher_04",
      "hash64": "4E2F8B64BCE0D7D5",
      "text": "테사 님이 맡긴\\n정체불명의 아이템이라고?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
