          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2070_rival_04a",
      "hash64": "36FEABCD000213EF",
      "text": "씩씩하고 멋진 대답인걸!\\n그 기세로 챔피언의 실력을 보여 주는 거야![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2070_rival_04b",
      "hash64": "36FEACCD000215A2",
      "text": "아하하! 농담하지 마!\\n아직 잠이 덜 깬 거야?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
