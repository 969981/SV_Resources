          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2070_rival_11",
      "hash64": "8756C158BF45E63E",
      "text": "교장 선생님이 마음에 들어 하셨을 때\\n얼마나 가슴이 철렁했는지 몰라![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
