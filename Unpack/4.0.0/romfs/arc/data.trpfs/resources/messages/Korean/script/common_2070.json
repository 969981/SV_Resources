          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2070_rival_05",
      "hash64": "8753C158BF43B067",
      "text": "[VAR 0x0100(0000)] 덕분에 치프도\\n게스트로 참가해 준다고 하고, 정말 최고야![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
