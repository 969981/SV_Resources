          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0240_fly_06",
      "hash64": "5AFD15EB25E56AD4",
      "text": "그럼, 업무를 시작하죠.\\n잘 부탁드립니다.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0240_fly_07",
      "hash64": "5AFD16EB25E56C87",
      "text": "몰라볼 정도로 성장하셨군요.\\n치프가 마음에 들어 할 만하시네요.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
