          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0240_fly_02",
      "hash64": "5AFD11EB25E56408",
      "text": "귀찮게도 저는\\n사천왕도 겸임하고 있습니다.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0240_fly_03",
      "hash64": "5AFD12EB25E565BB",
      "text": "체육관에서는 저와 비슷한\\n노말타입을 사용했습니다만[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0240_fly_04",
      "hash64": "5AFD17EB25E56E3A",
      "text": "윗선에서\\n여기서는 다른 타입을 사용하라더군요...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0240_fly_05",
      "hash64": "5AFD18EB25E56FED",
      "text": "혹시 불만이 있으시다면\\n치프에게 말씀해 주세요.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
