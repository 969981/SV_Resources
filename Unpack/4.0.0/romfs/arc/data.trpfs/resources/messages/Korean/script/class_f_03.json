      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_f_03_select_03",
      "hash64": "CF4EFAFB6A2297A1",
      "text": "고스트타입",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_f_03_dragon_answer_01",
      "hash64": "769515401675C2CB",
      "text": "아깝네요, [VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양!\\n물에서 상태가 변한 타입입니다![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
