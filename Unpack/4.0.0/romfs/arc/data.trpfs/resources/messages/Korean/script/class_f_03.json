      "hash64": "BA140F3BD444D382",
      "text": "팔자크입니다.\\n오늘 수업도 잘 부탁드립니다.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
