    },
    {
      "ordinal": 16,
      "label": "class_f_03_dragon_answer_02",
      "hash64": "769516401675C47E",
      "text": "[VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양!\\n100점 만점입니다![VAR 0x0114(0012)]",
      "flags": 0,
