          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_mizu_randomtalk_04",
      "hash64": "0AC0F59213BEA99C",
      "text": "내가 교환해 준 가비루사는\\n아주 예리하단다!\\c\\n가끔 스스로 살을 버릴 때가 있으니\\n너무 놀라지 말거라![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
