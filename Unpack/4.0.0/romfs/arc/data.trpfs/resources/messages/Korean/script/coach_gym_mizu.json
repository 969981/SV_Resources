    {
      "ordinal": 0,
      "label": "coach_gym_mizu_first_00",
      "hash64": "7E7F65259EA676C5",
      "text": "어서 옵쇼~![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
