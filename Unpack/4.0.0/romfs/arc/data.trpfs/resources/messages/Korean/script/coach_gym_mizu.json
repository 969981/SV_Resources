    {
      "ordinal": 34,
      "label": "coach_gym_mizu_trade_02_01",
      "hash64": "DCC54F25225A7B5B",
      "text": "어버이가 자신이 아닌 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
