      "ordinal": 50,
      "label": "coach_gym_mizu_battleend_win_01_01",
      "hash64": "207D18FC9DF0FE54",
      "text": "사나이 곤포!\\n다음 승부도 기대하고 있으마![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
