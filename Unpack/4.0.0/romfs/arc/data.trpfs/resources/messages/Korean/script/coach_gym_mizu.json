    {
      "ordinal": 38,
      "label": "coach_gym_mizu_trade_03_01",
      "hash64": "07434319D8F1B746",
      "text": "우오오옷~!?\\n설마 거절을 당할 줄이야![VAR 0x0114(0018)]",
