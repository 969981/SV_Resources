    },
    {
      "ordinal": 39,
      "label": "coach_gym_mizu_trade_04_00",
      "hash64": "AF971A123C7292CA",
      "text": "나와 포켓몬 교환을 할 마음이 든 거냐!?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
