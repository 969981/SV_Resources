    },
    {
      "ordinal": 55,
      "label": "coach_gym_mizu_randomtalk_03",
      "hash64": "0AC0F49213BEA7E9",
      "text": "네가 교환해 준 [VAR 0x0101(0001)][VAR 0x1900(0001)]\\n아주 팔팔하더구나!\\r\\n앞으로가 기대되는 포켓몬이란 말이지![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
