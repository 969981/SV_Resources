      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0485_bbteacher_02",
      "hash64": "7248949413607152",
      "text": "이걸로 모두...는 아니지만\\n어느 정도 모였네.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
