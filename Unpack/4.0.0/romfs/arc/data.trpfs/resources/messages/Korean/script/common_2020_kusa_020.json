      "label": "common_2020_kusa_020_kusa_01",
      "hash64": "9A4E50C60C312BAA",
      "text": "보아라, [VAR 0x0100(0000)]!\\n보울마을의 풍차를![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
