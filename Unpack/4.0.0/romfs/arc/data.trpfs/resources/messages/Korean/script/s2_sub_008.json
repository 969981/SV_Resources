          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_008_kakutou_01",
      "hash64": "0C92CC5883E7E6ED",
      "text": "[VAR 0x0100(0000)], 시간 괜찮아?\\n아이들에게 공부를 가르쳐 주지 않을래?[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
