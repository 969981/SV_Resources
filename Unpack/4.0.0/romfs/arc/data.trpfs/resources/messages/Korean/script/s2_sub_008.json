      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s2_sub_008_fairy_02",
      "hash64": "BB429D3E873D68D3",
      "text": "오잉!? 너!\\n어, 어어어어, 어째서 여기에!?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
