    {
      "ordinal": 15,
      "label": "s2_sub_008_select_02",
      "hash64": "ED56BC93D31EFDC6",
      "text": "선생님인데요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
