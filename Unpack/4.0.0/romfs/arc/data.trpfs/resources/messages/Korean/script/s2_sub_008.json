          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_008_kakutou_02",
      "hash64": "0C92C95883E7E1D4",
      "text": "응, 알았어!\\n기다리고 있을게![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_008_kakutou_03",
      "hash64": "0C92CA5883E7E387",
      "text": "만세~!\\n그럼, 교실로 안내할게![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_008_aku_04",
      "hash64": "4368C859C8651DE3",
      "text": "다들 공부는 잘하고 있지~?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_008_fairy_01",
      "hash64": "BB429E3E873D6A86",
      "text": "거 참 말이 많네.\\n감시하러 온 거야?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_008_aku_05",
      "hash64": "4368C759C8651C30",
      "text": "감시하지 않으면\\n농땡이 피울 거 아니야.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
