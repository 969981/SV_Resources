          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_sub_008_kakutou_04",
      "hash64": "0C92C75883E7DE6E",
      "text": "미안해, 추명아.\\n시험이랑 상관없는 집중력만 오르게 해서...[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
