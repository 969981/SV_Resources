          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_008_doku_03",
      "hash64": "20C01FEA316F3032",
      "text": "으음!? 비파 나리의 배후에서\\n누군가의 기척이...?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_008_doku_04",
      "hash64": "20C01AEA316F27B3",
      "text": "수상한 자로군! 에잇!\\n숨지 말고 모습을 드러내시오![VAR 0x0114(0023)]",
