    {
      "ordinal": 10,
      "label": "s2_sub_008_doku_02",
      "hash64": "20C020EA316F31E5",
      "text": "몇 번을 봐도\\n집중력이 오르는구려.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
