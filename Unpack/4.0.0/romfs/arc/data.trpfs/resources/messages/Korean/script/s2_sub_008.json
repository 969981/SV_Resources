    },
    {
      "ordinal": 1,
      "label": "s2_sub_008_aku_02",
      "hash64": "4368CE59C8652815",
      "text": "급한 일은 아니니까\\n편한 때에 와도 노 프라블럼이야![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
