      "ordinal": 14,
      "label": "s2_sub_008_select_01",
      "hash64": "ED56BB93D31EFC13",
      "text": "[VAR 0x0100(0000)]인데요!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
