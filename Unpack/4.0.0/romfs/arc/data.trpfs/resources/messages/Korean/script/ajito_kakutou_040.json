      "ordinal": 42,
      "label": "ajito_kakutou_040_sitappa_03",
      "hash64": "E7EEF1AC2C216F2B",
      "text": "...하고 싶은 말이 뭐야?[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
