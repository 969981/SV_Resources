          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "ajito_kakutou_040_sitappa_13",
      "hash64": "E7F279AC2C248C1A",
      "text": "반 아이들의 괴롭힘이\\n나에게로 향하게 된 거야.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
