        }
      ]
    },
    {
      "ordinal": 64,
      "label": "ajito_kakutou_040_sitappa_17",
      "hash64": "E7F275AC2C24854E",
      "text": "지금까지 내가 한 이야기를 듣고도\\n그런 소문을 믿는 거야?[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "ajito_kakutou_040_nelke_16",
      "hash64": "5C14DD40FEE2F87E",
      "text": "아니, 그건...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
