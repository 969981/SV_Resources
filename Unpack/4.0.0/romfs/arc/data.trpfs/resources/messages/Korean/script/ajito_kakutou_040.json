      ]
    },
    {
      "ordinal": 44,
      "label": "ajito_kakutou_040_nelke_09",
      "hash64": "5C185C40FEE60622",
      "text": "이유가 뭔지 가르쳐 줄 수 있나?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
