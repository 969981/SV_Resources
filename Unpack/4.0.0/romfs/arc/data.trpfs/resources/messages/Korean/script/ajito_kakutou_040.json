    },
    {
      "ordinal": 51,
      "label": "ajito_kakutou_040_sitappa_09",
      "hash64": "E7EEEBAC2C2164F9",
      "text": "그전까지 가장 인기 있던\\n나를 제치고 말이야...[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
