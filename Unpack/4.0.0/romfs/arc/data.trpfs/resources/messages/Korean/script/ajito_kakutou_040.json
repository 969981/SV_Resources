      "label": "ajito_kakutou_040_sitappa_08",
      "hash64": "E7EEEAAC2C216346",
      "text": "입학한 지 얼마 되지 않아\\n비파는 아카데미의 인기 스타가 되었어.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
