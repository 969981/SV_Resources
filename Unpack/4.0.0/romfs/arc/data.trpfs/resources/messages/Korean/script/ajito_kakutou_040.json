    },
    {
      "ordinal": 45,
      "label": "ajito_kakutou_040_sitappa_04",
      "hash64": "E7EEF6AC2C2177AA",
      "text": "눈썰미가 좋네.\\n...좋아, 가르쳐 줄게.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
