    },
    {
      "ordinal": 60,
      "label": "ajito_kakutou_040_sitappa_15",
      "hash64": "E7F273AC2C2481E8",
      "text": "머물 곳이 없는 게 얼마나 힘든지 잘 안다고,\\n나를 스타단에 초대해 준 거야.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
