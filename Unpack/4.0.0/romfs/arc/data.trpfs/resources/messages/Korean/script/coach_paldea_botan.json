    },
    {
      "ordinal": 58,
      "label": "coach_paldea_botan_randomtalk_03",
      "hash64": "7ADCE8A95190B3F6",
      "text": "네가 교환해 준 [VAR 0x0101(0001)],\\n내 브이브이들과도 사이좋게 지내고 있어.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
