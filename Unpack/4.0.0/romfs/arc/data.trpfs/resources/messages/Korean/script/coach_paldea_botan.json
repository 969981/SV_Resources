          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_paldea_botan_sp01_01",
      "hash64": "0E6B0418CCBB992B",
      "text": "그건 그렇고 이 방...\\n모르는 사람들이 너무 많아서 그런가\\r\\n뭔가 답답해...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_paldea_botan_sp01_select_01",
      "hash64": "A2AB83E067D113F2",
      "text": "괜찮아질 거야!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_paldea_botan_sp01_select_02",
      "hash64": "A2AB82E067D1123F",
      "text": "힘내!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea_botan_sp01_02",
      "hash64": "0E6B0518CCBB9ADE",
      "text": "으음... 음...\\c\\n사람들이 다 [VAR 0x0100(0000)]처럼\\n인싸력이 높지는 않은데...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
