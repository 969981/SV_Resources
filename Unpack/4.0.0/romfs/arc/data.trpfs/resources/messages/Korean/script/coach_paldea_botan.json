    {
      "ordinal": 1,
      "label": "coach_paldea_botan_first_01",
      "hash64": "07BA7C400EAD5EE7",
      "text": "여기가 부실 맞지?\\n이제부터 내가 접수하려고.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
