          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_paldea_botan_sp01_03",
      "hash64": "0E6B0618CCBB9C91",
      "text": "뭐, 적응 훈련인 셈 치고\\n조금은... 힘내 볼게...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea_botan_sp01_04",
      "hash64": "0E6B0718CCBB9E44",
      "text": "그렇다고 이런 낯선 곳에\\n혼자 오래 남겨 두면 안 돼.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea_botan_sp02_00",
      "hash64": "3C250D1F2F9741A7",
      "text": "[VAR 0x0100(0000)], 그거 알아!?\\n블루베리 아카데미, 진짜 굉장한 곳이었어![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
