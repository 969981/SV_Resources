      "hash64": "A061F0FFA7BAFC72",
      "text": "[VAR 0x0100(0000)]!\\n그레이프 아카데미에 어서 와![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
