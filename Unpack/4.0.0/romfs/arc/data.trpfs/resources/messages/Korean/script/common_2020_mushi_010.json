    },
    {
      "ordinal": 11,
      "label": "common_2020_mushi_010_mushi_09",
      "hash64": "B33179C9607712EB",
      "text": "우후후, 기대되네~\\n그럼 장소를 옮기자~[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
