    },
    {
      "ordinal": 10,
      "label": "common_2020_mushi_010_mushi_retry",
      "hash64": "E737D6A2FCBCFCE2",
      "text": "왔구나~ 새로운 챔피언의 실력,\\n한번 맛봐도 될까~?[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
