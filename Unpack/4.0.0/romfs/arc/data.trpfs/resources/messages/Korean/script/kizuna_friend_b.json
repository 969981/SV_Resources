      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_friend_b_03a",
      "hash64": "2C700479EDF63C88",
      "text": "엄마가 학생 시절에\\n연구하던 표본이래![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
