      "hash64": "EC8C2D4CC93A3B86",
      "text": "이걸 봐 봐![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
