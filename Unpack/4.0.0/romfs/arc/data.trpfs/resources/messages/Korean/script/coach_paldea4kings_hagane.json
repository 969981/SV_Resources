      "hash64": "F7208EBBC1886795",
      "text": "그랬더니, 테사 언니가\\n사천왕으로 초대해 주셨어요...[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
