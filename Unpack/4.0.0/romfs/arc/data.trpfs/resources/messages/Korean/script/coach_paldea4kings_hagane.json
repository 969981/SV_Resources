    },
    {
      "ordinal": 16,
      "label": "coach_paldea4kings_hagane_sp02_03",
      "hash64": "F5E560B69A7AFE1A",
      "text": "교실도 선생님도 전부 처음이라\\n두근두근해요~![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
