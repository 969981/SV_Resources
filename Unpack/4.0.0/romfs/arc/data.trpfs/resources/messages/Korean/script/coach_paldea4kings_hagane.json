      "label": "coach_paldea4kings_hagane_sp03_02c",
      "hash64": "74A27709DAB40789",
      "text": "우와아~!\\n그렇게나 언니로 보여요~!?[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
