      "ordinal": 32,
      "label": "coach_paldea4kings_hagane_sp03_02b",
      "hash64": "74A27609DAB405D6",
      "text": "우와아~! 굉장해요!\\n맞힌 사람은 처음이에요![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
