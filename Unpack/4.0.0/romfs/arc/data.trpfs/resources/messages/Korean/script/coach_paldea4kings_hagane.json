    {
      "ordinal": 14,
      "label": "coach_paldea4kings_hagane_sp02_01",
      "hash64": "F5E55EB69A7AFAB4",
      "text": "학교라는 곳은\\n정말 재미있는 곳이네요~[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
