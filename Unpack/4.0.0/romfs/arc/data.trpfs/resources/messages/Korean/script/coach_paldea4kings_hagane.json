    {
      "ordinal": 13,
      "label": "coach_paldea4kings_hagane_sp02_00",
      "hash64": "F5E55FB69A7AFC67",
      "text": "호출을 받아서 또 왔어요![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
