      "ordinal": 31,
      "label": "coach_paldea4kings_hagane_sp03_02",
      "hash64": "F72087BBC1885BB0",
      "text": "으~!\\n뽀삐, 그 정도로 어리지 않은데...[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
