    {
      "ordinal": 15,
      "label": "coach_paldea4kings_hagane_sp02_02",
      "hash64": "F5E561B69A7AFFCD",
      "text": "뽀삐는 아직\\n학교에 다닌 적이 없거든요.[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
