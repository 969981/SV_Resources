      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side01_0020_mama_07",
      "hash64": "510DA457FC29391B",
      "text": "어머, 그러니...?\\n그래도 일단 너한테 줄게.[VAR 0x0114(002B)]",
