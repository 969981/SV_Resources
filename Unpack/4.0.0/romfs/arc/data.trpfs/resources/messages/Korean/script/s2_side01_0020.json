          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "1900",
          "args_hex": [
            "0003"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_side01_0020_friend_08",
      "hash64": "173BE99E992CDD06",
