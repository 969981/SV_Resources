    },
    {
      "ordinal": 3,
      "label": "s2_side01_0020_rival_01",
      "hash64": "F20982A16E90F9F7",
      "text": "전에 뵀던 것도\\n기억하고 계셔서 기뻤어![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
