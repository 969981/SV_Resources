    },
    {
      "ordinal": 6,
      "label": "s2_side01_0020_botan_02",
      "hash64": "CA8C00C03806B344",
      "text": "앗, Nintendo Switch!\\n무슨 게임이 들었을까~?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
