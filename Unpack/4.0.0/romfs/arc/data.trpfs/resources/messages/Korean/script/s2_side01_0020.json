    {
      "ordinal": 5,
      "label": "s2_side01_0020_friend_03",
      "hash64": "173BF09E992CE8EB",
      "text": "어째 좀\\n지나치게 귀여운 느낌도 들지만...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
