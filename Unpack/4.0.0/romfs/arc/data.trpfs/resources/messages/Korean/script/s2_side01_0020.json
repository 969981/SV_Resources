    },
    {
      "ordinal": 9,
      "label": "s2_side01_0020_botan_03",
      "hash64": "CA8C01C03806B4F7",
      "text": "간식![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
