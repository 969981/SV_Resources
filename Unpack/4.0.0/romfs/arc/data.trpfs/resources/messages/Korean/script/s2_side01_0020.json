        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0020_mama_01",
      "hash64": "510DAA57FC29434D",
      "text": "다들 배는 더 안 고프니?\\n간식이라도 가져다줄까?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
