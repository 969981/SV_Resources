      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0020_rival_02",
      "hash64": "F20983A16E90FBAA",
      "text": "탐리스 쿠션!\\n엄청 푹신푹신해 보인다![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
