    {
      "ordinal": 38,
      "label": "legend_0040_friend_15",
      "hash64": "87B11288B93D643D",
      "text": "그렇지, [VAR 0x0100(0000)].\\n이걸 봐 줘.[VAR 0x0114(0006)]",
