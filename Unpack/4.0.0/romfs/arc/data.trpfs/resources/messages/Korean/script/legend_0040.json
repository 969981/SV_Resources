      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 50,
      "label": "legend_0040_friend_24",
      "hash64": "87AE0388B93B14E9",
