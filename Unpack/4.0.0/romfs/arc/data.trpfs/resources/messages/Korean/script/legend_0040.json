      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "legend_0040_friend_14",
      "hash64": "87B11188B93D628A",
      "text": "이 녀석도 이상한 방향으로\\n건강해진 것 같단 말이지.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
