      ]
    },
    {
      "ordinal": 39,
      "label": "legend_0040_friend_16",
      "hash64": "87B10F88B93D5F24",
      "text": "비전스파이스 주변에는\\n반드시 주인 포켓몬이 있잖아.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
