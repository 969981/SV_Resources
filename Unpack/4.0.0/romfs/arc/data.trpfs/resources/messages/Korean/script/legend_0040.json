      "ordinal": 53,
      "label": "legend_0040_friend_27",
      "hash64": "87AE0088B93B0FD0",
      "text": "마피티프의 상태가\\n점점 좋아지고 있어![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
