        }
      ]
    },
    {
      "ordinal": 40,
      "label": "legend_0040_friend_17",
      "hash64": "87B11088B93D60D7",
      "text": "이 책에 따르면\\n녀석들은 스파이스의 성분에 의해\\r\\n크고 강해진 거래.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
