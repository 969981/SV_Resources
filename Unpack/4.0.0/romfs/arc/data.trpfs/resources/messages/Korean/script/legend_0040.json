      "hash64": "87AE0F88B93B294D",
      "text": "너를 만난 뒤로는\\n좋은 일만 있는 것 같아![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
