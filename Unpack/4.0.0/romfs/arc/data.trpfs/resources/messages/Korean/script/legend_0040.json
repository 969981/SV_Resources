          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "legend_0040_friend_18",
      "hash64": "87B10588B93D4E26",
      "text": "어쩌면 이 동굴은 주인 포켓몬의\\n먹이 저장고인지도 모르겠어.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
