      "ordinal": 51,
      "label": "legend_0040_friend_25",
      "hash64": "87AE0288B93B1336",
      "text": "마피티프~! 너~!![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
