    },
    {
      "ordinal": 37,
      "label": "coach_paldea4kings_zimen_trade_02_03",
      "hash64": "57D2DB2C1B9FF893",
      "text": "색이 다른 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
