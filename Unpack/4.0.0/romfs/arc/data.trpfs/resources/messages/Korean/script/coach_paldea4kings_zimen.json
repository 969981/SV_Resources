    {
      "ordinal": 36,
      "label": "coach_paldea4kings_zimen_trade_02_02",
      "hash64": "57D2DA2C1B9FF6E0",
      "text": "희귀한 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
