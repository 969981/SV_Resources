            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_paldea4kings_zimen_first_01",
      "hash64": "F0E7C7F03A2BD0FC",
      "text": "칠리가 왔다고! 잘 부탁해![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_paldea4kings_zimen_sp01_00",
      "hash64": "743CA50901C57281",
      "text": "설마, [VAR 0x0100(0000)]\\n네 쪽에서 초대를 할 줄이야![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_paldea4kings_zimen_sp01_01",
      "hash64": "743CA40901C570CE",
      "text": "그렇게도\\n이 칠리 님이 보고 싶었던 거야?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_paldea4kings_zimen_sp01_select_01",
      "hash64": "D4717B8263D1451D",
      "text": "네!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_paldea4kings_zimen_sp01_select_02",
      "hash64": "D471788263D14004",
      "text": "흐음...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea4kings_zimen_sp01_03",
      "hash64": "743CA20901C56D68",
      "text": "솔직하니 보기 좋은데!\\n제법 귀여운 구석이 있어.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_paldea4kings_zimen_sp01_03b",
      "hash64": "48745F4E027847FE",
      "text": "내키지는 않았던 거구만!\\n아하하! 이거 혼자 원맨쇼를 해 버렸네![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea4kings_zimen_sp01_04",
      "hash64": "743CA90901C5794D",
      "text": "아무튼 결국, 이 아카데미에\\n활기를 불어넣으면 되는 거지?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea4kings_zimen_sp01_05",
      "hash64": "743CA80901C5779A",
      "text": "그런 건 내 특기니까\\n이 칠리 님만 믿으셔![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_paldea4kings_zimen_sp02_00",
      "hash64": "78B3E31FD517400E",
      "text": "지난번에는 총대장의 수행원 자격으로\\n여기에 온 거야.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_paldea4kings_zimen_sp02_01",
      "hash64": "78B3E41FD51741C1",
      "text": "그 사람, 완벽해 보이지만\\n제법 덜렁거릴 때가 있어서\\r\\n이 칠리 님이 돌보지 않으면 안 된다고.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_paldea4kings_zimen_sp02_select_01",
      "hash64": "416A704DF61BF9C0",
      "text": "의외네요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "coach_paldea4kings_zimen_sp02_select_02",
      "hash64": "416A734DF61BFED9",
      "text": "멋진 콤비네요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_paldea4kings_zimen_sp02_02",
      "hash64": "78B3E11FD5173CA8",
      "text": "왜, 그때도 이상한 디스크를\\n브라이어라는 사람에게 주는 걸 깜빡했잖아![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_paldea4kings_zimen_sp02_02b",
      "hash64": "30E45317167C4B3E",
      "text": "뭐, 그런 셈이지!\\n같이 일한 지 제법 오래되기도 했고.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_paldea4kings_zimen_sp02_03",
      "hash64": "78B3E21FD5173E5B",
      "text": "가끔은 머리카락에\\n초롱순이 감긴 채로 일할 때도 있어.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_paldea4kings_zimen_sp02_04",
      "hash64": "78B3E71FD51746DA",
      "text": "...아, 이거\\n총대장한테는 말하면 안 돼.\\r\\n들켰다간 크게 혼날 테니까...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_paldea4kings_zimen_sp02_05",
      "hash64": "78B3E81FD517488D",
      "text": "이 칠리 님과 둘만의 비밀이야![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_paldea4kings_zimen_sp03_00",
      "hash64": "770B991AADACD51F",
      "text": "학생들에게 이것저것 가르치는 게\\n재미있긴 하지만, 머리를 써야 해서 힘들어...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_paldea4kings_zimen_sp03_01",
      "hash64": "770B981AADACD36C",
      "text": "내가 일할 때만큼은\\n진지 모드가 되거든.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_paldea4kings_zimen_sp03_02",
      "hash64": "770B9B1AADACD885",
      "text": "안경도 빡 쓰고 말이야.\\n렌즈에 도수는 없지만![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_paldea4kings_zimen_sp03_03",
      "hash64": "770B9A1AADACD6D2",
      "text": "그러고 보니 너는, 면접 때\\n진지한 칠리를 본 적 있구나.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_paldea4kings_zimen_sp03_04",
      "hash64": "770B951AADACCE53",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)] 평소의 칠리와\\n진지한 칠리 중에 어느 쪽이 더 좋아?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "1900",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea4kings_zimen_sp03_select_01",
      "hash64": "6813464A803E76FB",
      "text": "평소의 칠리",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "coach_paldea4kings_zimen_sp03_select_02",
      "hash64": "6813474A803E78AE",
      "text": "진지한 칠리",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "coach_paldea4kings_zimen_sp03_05",
      "hash64": "770B941AADACCCA0",
      "text": "흐음~ 그렇구나!?\\n그렇다면 너랑 있을 때는\\c\\n힘을 쭉~ 빼고\\n평소 모습대로 있어야겠네.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_paldea4kings_zimen_sp03_05b",
      "hash64": "F5796B551C9FEDA6",
      "text": "흐음~ 그렇구나!?\\n제 진지한 모습이 좋으시다면\\r\\n정중히 대하도록 하겠습니다.\\r\\n...하하, 농담이야![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_paldea4kings_zimen_sp03_06",
      "hash64": "770B971AADACD1B9",
      "text": "아무튼, 참고해 둘게~[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_paldea4kings_zimen_trade_01_00",
      "hash64": "535B9E15484E2CB9",
      "text": "우리 말이야.\\n어째 요즘 자주 대화하는 것 같지 않아?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_paldea4kings_zimen_trade_01_01",
      "hash64": "535B9D15484E2B06",
      "text": "그만큼 서로를 잘 알게 됐다는 뜻이니\\n기념으로 뭔가 하지 않을래?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_paldea4kings_zimen_trade_01_02",
      "hash64": "535B9C15484E2953",
      "text": "그래! 이 칠리 님과\\n포켓몬을 교환하는 건 어때?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_paldea4kings_zimen_trade_01_03",
      "hash64": "535B9B15484E27A0",
      "text": "좋아! 결정됐네.\\n나는 우파를 줄게!\\r\\n너는 어떤 아이를 줄래?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
