      ]
    },
    {
      "ordinal": 11,
      "label": "a_sch_shop01_ni05",
      "hash64": "686AA835F8946A34",
      "text": "포켓몬과 먹을 야식을 사러 왔어.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
