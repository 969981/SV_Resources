    {
      "ordinal": 1,
      "label": "kizuna_battle_b_02",
      "hash64": "284774AC63350864",
      "text": "너를 가정실에서 만날 줄이야!\\n의외인걸![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
