    },
    {
      "ordinal": 2,
      "label": "kizuna_battle_b_select_01",
      "hash64": "0AD49203C0A0F58C",
      "text": "선생님도 의외네요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_battle_b_select_02",
      "hash64": "0AD49503C0A0FAA5",
      "text": "뭐 하러 오신 거예요?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_battle_b_03",
      "hash64": "284775AC63350A17",
      "text": "그게... 나는 말이지...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
