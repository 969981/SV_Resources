      "ordinal": 21,
      "label": "kizuna_battle_b_12",
      "hash64": "284ADEAC6337F259",
      "text": "그렇구나! 버터~!\\n지도 감사합니다![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
