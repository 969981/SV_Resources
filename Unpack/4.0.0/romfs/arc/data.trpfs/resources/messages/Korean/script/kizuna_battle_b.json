        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_battle_b_04",
      "hash64": "284772AC633504FE",
      "text": "이런, 들켜 버렸네...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
