          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_battle_b_home_03",
      "hash64": "C24E3F658481254B",
      "text": "그렇군.\\n앞으로는 조심하도록 하지.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
