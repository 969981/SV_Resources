      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_battle_b_06",
      "hash64": "284770AC63350198",
      "text": "들켜 버렸으니 어쩔 수 없지![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
