      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_battle_b_08",
      "hash64": "28476EAC6334FE32",
      "text": "이번 특훈에서 만든 샌드위치인데\\n한번 먹어 봐![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
