        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_battle_b_home_01",
      "hash64": "C24E4165848128B1",
      "text": "샌드위치를 만드는 특훈 중이라더군.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
