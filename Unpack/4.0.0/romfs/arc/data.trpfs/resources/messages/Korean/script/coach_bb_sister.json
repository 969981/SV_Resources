    },
    {
      "ordinal": 49,
      "label": "coach_bb_sister_trade_04_00",
      "hash64": "4E02B6120C2A4164",
      "text": "역시 나랑\\n포켓몬 교환이 하고 싶어진 거야?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
