          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "coach_bb_sister_trade_01_03",
      "hash64": "A737712B537B5F58",
      "text": "자세는 되어 있네!\\n나는 차데스를 줄 건데\\r\\n너는 어떻게 할래?[VAR 0x0114(0044)]",
