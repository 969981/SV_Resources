            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "coach_bb_sister_battleend_lose_00_00",
      "hash64": "868368BFB727D6F3",
      "text": "헤헷!\\n내가 전력을 다하면 이 정도라구!\\c\\n블루베리그 챔피언 자리는\\n언제든지 받아 줄 테니까 말만 해![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "coach_bb_sister_randomtalk_00",
      "hash64": "CE57B502C1301F12",
      "text": "어째서 카지처럼\\n할아버지 말투를 쓰지 않냐고?\\c\\n그야 내가 더 멋지니까 그렇지![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "coach_bb_sister_randomtalk_01",
      "hash64": "CE57B602C13020C5",
      "text": "너, 아카데미에도 리그부에도 쉽게 적응하고\\n정말 무서울 지경이라니까!\\r\\n스파이 같은 게 적성인 거 아니야?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "coach_bb_sister_randomtalk_02",
      "hash64": "CE57B302C1301BAC",
      "text": "오거폰은 잘 지내고 있어?\\c\\n가면찾아조로서 세벗들을 무찌르던 일이\\n가끔씩 생각난단 말이지.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
