    {
      "ordinal": 59,
      "label": "coach_bb_sister_battleend_win_01_00",
      "hash64": "11C0F87C545260C1",
      "text": "...잘 들어.\\n내가 승리를 양보해 준 거야![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
