    },
    {
      "ordinal": 56,
      "label": "coach_bb_sister_battleend_win_00_02",
      "hash64": "E888E4879ECFB116",
      "text": "아! 잠깐 기다려!\\n상으로 이걸 줄 테니까![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
