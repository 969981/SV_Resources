    },
    {
      "ordinal": 44,
      "label": "coach_bb_sister_trade_02_01",
      "hash64": "5529B3470ECBDEB1",
      "text": "어버이가 자신이 아닌 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
