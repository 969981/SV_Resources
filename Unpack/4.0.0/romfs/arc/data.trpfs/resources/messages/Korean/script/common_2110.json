    {
      "ordinal": 0,
      "label": "common_2110_announce_01",
      "hash64": "1F70B67B077993A5",
      "text": "오늘의 제1라운드!\\n여러분이 주목해야 할 시합은...!?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_2110_announce_02",
      "hash64": "1F70B37B07798E8C",
      "text": "챔피언 [VAR 0x0100(0000)] VS...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
