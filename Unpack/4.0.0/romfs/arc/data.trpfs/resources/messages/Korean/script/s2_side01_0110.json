    },
    {
      "ordinal": 2,
      "label": "s2_side01_0110_brother_02",
      "hash64": "D866F7954CC0E4D4",
      "text": "어째서 여기 계신 거예요!?\\n누나는 괜찮아요!?\\r\\n아, 그리고 여기서 여자아이 못 보셨어요!?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
