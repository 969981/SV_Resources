      ]
    },
    {
      "ordinal": 5,
      "label": "sch_entrance01_girl_02",
      "hash64": "A478D0916FCE4A89",
      "text": "오컬처라는 이상한 잡지 말이야!\\n순 엉터리 같은 거짓말만 적혀 있어!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
