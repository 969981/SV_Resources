          ]
        }
      ]
    },
    {
      "ordinal": 67,
      "label": "sch_entrance01_man_05",
      "hash64": "4A9BB6FB162BB26E",
      "text": "페퍼랑 같은 반인데\\n작년부터 일이 좀 많은 모양이야.\\r\\n나도 그 기분 잘 알지.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
