      "ordinal": 20,
      "label": "sch_entrance01_boy_05",
      "hash64": "EB33DCE6A2437BE0",
      "text": "여기에 있는 사람 모두 다\\n공부하러 온 거구나~",
      "flags": 0,
      "text_status": "DECODED",
