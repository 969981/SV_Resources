      "ordinal": 40,
      "label": "sch_entrance01_girl_08",
      "hash64": "A478D6916FCE54BB",
      "text": "교과서를 소리 내서 읽으면\\n눈이랑 입이랑 귀를 모두 써서 외울 수 있어!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
