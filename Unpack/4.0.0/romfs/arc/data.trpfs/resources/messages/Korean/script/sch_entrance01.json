      ]
    },
    {
      "ordinal": 62,
      "label": "sch_entrance01_girl_06",
      "hash64": "A478D4916FCE5155",
      "text": "밤중의 학교는 신기한 것 같아!\\n낮일 때랑 돌아다니는 사람이 다르잖아.\\c\\n마을 밖에서도 낮이냐 밤이냐에 따라\\n다른 포켓몬을 만날 수 있어.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
