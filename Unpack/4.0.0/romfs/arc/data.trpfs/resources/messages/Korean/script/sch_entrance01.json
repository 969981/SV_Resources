      "label": "sch_entrance01_poke_34",
      "hash64": "01B78A09590C87BD",
      "text": "[EMPTY 76]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "004C"
          ]
        }
      ]
    },
    {
