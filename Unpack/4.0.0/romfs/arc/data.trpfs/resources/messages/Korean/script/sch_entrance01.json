    {
      "ordinal": 58,
      "label": "sch_entrance01_boy_08",
      "hash64": "EB33E9E6A24391F7",
      "text": "오래 같이 걸어 다니다 보면\\n진화하는 포켓몬도 있대.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
