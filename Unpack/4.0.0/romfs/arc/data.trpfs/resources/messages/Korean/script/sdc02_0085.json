      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0085_sister_03",
      "hash64": "3A154C7B04EB6132",
      "text": "후후! 선생님이 알려 주셨어!\\n설마 네가 우리 학교에 있을 줄이야.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
