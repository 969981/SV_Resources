        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0085_sister_04",
      "hash64": "3A15477B04EB58B3",
      "text": "이미 다 알고 있거든!\\n어설프게 거짓말해 봤자 소용없다구![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0085_sister_05",
      "hash64": "3A15467B04EB5700",
      "text": "그럼 오랜만에 얼굴이나 한번 볼까![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
