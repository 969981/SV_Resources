        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0085_sister_06",
      "hash64": "3A15497B04EB5C19",
      "text": "어디 보자...\\n테라리움 돔에는 가 봤어?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
