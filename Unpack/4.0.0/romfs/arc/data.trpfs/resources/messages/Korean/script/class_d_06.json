      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_d_06_language_answer_01",
      "hash64": "A5B86F79282F62FD",
      "text": "Sorry, [VAR 0x0100(0000)]~!\\n기쁨과는 꽤 거리가 있는 Voice지 않을까?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
