    },
    {
      "ordinal": 2,
      "label": "class_d_06_yes_01",
      "hash64": "78D14F97ED7B12A7",
      "text": "네!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "class_d_06_yes_02",
      "hash64": "78D15097ED7B145A",
      "text": "Yes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_d_06_language_03",
      "hash64": "F1C42798E7E45AD2",
      "text": "대답까지 훌륭하구나!\\n역시 우수한 학생들이라니까~![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
