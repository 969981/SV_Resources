          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_d_06_language_14",
      "hash64": "F1C0A498E7E14662",
      "text": "피카츄의...[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
