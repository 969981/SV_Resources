      ]
    },
    {
      "ordinal": 22,
      "label": "class_d_06_poke_03",
      "hash64": "0864DE3253BE1DB3",
      "text": "피카아...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "class_d_06_language_15",
      "hash64": "F1C0A598E7E14815",
      "text": "...는 슬픔의 감정!\\n다시 말해, 울고 싶을 때 내는 소리란다![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
