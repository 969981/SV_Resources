    {
      "ordinal": 2,
      "label": "legend_0120_friend_02",
      "hash64": "128CFA72A6CCF9DC",
      "text": "먼저 말 걸어 놓고 아니라니!\\n뭔가 조련당하는 기분이네...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
