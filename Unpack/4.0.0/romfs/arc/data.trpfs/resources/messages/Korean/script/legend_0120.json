        }
      ]
    },
    {
      "ordinal": 4,
      "label": "legend_0120_friend_04",
      "hash64": "128CF872A6CCF676",
      "text": "바우후 와우!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "legend_0120_friend_05",
      "hash64": "128CF972A6CCF829",
      "text": "마피티프도 준비됐대![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
