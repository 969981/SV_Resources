          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "legend_0120_select_03",
      "hash64": "5ACB8A3B6D657CFF",
      "text": "네모!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "legend_0120_select_04",
      "hash64": "5ACB873B6D6577E6",
      "text": "모란!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "legend_0120_select_05",
      "hash64": "5ACB883B6D657999",
      "text": "네모...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "legend_0120_select_06",
      "hash64": "5ACB853B6D657480",
      "text": "모란...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "legend_0120_friend_16a",
      "hash64": "5A0576D17235D494",
      "text": "오호라, 학생회장이라!\\c\\n확실히 녀석이라면\\n아무리 강한 포켓몬이 나타나도\\r\\n문제없을 거야![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "legend_0120_friend_16b",
      "hash64": "5A0579D17235D9AD",
      "text": "스타단의 진 보스인\\n천재 해커 모란 말이야?\\r\\n확실히 녀석이라면 제격이긴 한데...\\c\\n그런 위험한 녀석이랑은\\n대체 어느 틈에 친구가 된 거야...!?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "legend_0120_friend_16c",
      "hash64": "5A0578D17235D7FA",
      "text": "학생회장이라...\\c\\n확실히 제격인 것 같지만,\\n네가 챔피언이 되기 전까지는\\r\\n꿈쩍도 하지 않을 것 같은데?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "legend_0120_friend_16d",
      "hash64": "5A0573D17235CF7B",
      "text": "흐응~ 그런 녀석이 있구나.\\c\\n뭔가 은혜 갚을 일이라도 있거나\\n친한 사이가 아니면 안 도와주지 않을까?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "legend_0120_friend_17a",
      "hash64": "5A0252D172336191",
      "text": "아무튼! 멤버를 모두 모으게 되면\\n다시 연락하도록 하자![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "legend_0120_friend_18a",
      "hash64": "59D662D1720E41D6",
      "text": "동료가 되어 줄 만한 녀석이 있으면\\n한번 말을 걸어 봐![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "legend_0120_friend_17b",
      "hash64": "5A024FD172335C78",
      "text": "오오!? 뭐야!\\n동료가 되어 줄 만한 녀석들이\\r\\n벌써 다 모인 것 같은데!?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "legend_0120_friend_18b",
      "hash64": "59D661D1720E4023",
      "text": "녀석들에게는\\n내가 연락해 둘 테니까\\c\\n대공 근처에 있는\\n제로게이트라는 시설에서 만나자!\\c\\n위치 정보를 보내줄 테니까\\n빨리 오라고![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
