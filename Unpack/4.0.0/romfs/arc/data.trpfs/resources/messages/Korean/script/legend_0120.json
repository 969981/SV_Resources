            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "legend_0120_friend_03",
      "hash64": "128CFB72A6CCFB8F",
      "text": "좋아!\\n마피티프도 준비됐지!?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
