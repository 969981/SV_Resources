      "hash64": "B858C5E597C45A55",
      "text": "[VAR 0x0100(0000)]!\\n나는 이미 다 알고 있다구![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
