    },
    {
      "ordinal": 14,
      "label": "coach_gym_denki_sp02_00",
      "hash64": "B9940FEABED1F364",
      "text": "앗, [VAR 0x0100(0000)]!\\n헬로봉주르니하오안녕~![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
