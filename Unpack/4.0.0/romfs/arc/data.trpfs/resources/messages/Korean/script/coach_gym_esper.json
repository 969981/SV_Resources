    },
    {
      "ordinal": 1,
      "label": "coach_gym_esper_first_01",
      "hash64": "2D97FCDC3B58BD6E",
      "text": "리파의 마법에 걸리고 싶은 사람은 누구?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
