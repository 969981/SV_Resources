          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_esper_sp01_01",
      "hash64": "52A8E06EF1BB7844",
      "text": "리파는 [VAR 0x0100(0000)]의 호출이라는\\n이야기를 듣고[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_esper_sp01_02",
      "hash64": "52A8E36EF1BB7D5D",
      "text": "공중날기택시를 불러서\\n쏜살같이 날아왔다고.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_esper_sp01_03",
      "hash64": "52A8E26EF1BB7BAA",
      "text": "리파의 수업... 학생들에게는 조금\\n자극이 강할 텐데 괜찮을까?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_gym_esper_sp01_04",
      "hash64": "52A8DD6EF1BB732B",
      "text": "나중에 무슨 일 생기면\\n책임져 주는 거다?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_gym_esper_sp01_05",
      "hash64": "52A8DC6EF1BB7178",
      "text": "후후후...\\n든든한 리파의 기사님이네.\\r\\n농담이니까 걱정하지 마.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_gym_esper_sp01_05b",
      "hash64": "305FAA84C1812F2E",
      "text": "후후후...\\n걱정하는 모습이 귀엽네.\\r\\n농담이니까 걱정하지 마.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_gym_esper_sp02_00",
      "hash64": "FC4317675651B988",
      "text": "또 불러 주다니\\n정말 영광인걸.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_esper_sp02_01",
      "hash64": "FC4318675651BB3B",
      "text": "그러고 보니, [VAR 0x0100(0000)].\\n리파가 무슨 일을 하는지 기억하고 있어?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_esper_sp02_select_01",
      "hash64": "25883AAEC9E113C2",
      "text": "여객기 승무원",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "coach_gym_esper_sp02_select_02",
      "hash64": "258839AEC9E1120F",
      "text": "네이처 아티스트",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "coach_gym_esper_sp02_select_03",
      "hash64": "258838AEC9E1105C",
      "text": "메이크업 아티스트",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_gym_esper_sp02_02",
      "hash64": "FC4319675651BCEE",
      "text": "노노, [VAR 0x0100(0000)].\\n확실히 승무원도 잘 어울리겠지만\\c\\n리파는 메이크업 아티스트야.\\n이젠 잊으면 안 돼![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_gym_esper_sp02_02b",
      "hash64": "F7C0B697ACE361E4",
      "text": "노노, [VAR 0x0100(0000)].\\n그건 이상한 예술가의 별명이고\\c\\n리파는 메이크업 아티스트야.\\n이젠 잊으면 안 돼![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_gym_esper_sp02_02c",
      "hash64": "F7C0B797ACE36397",
      "text": "고~저스!\\n리파는 메이크업 아티스트야!\\c\\n모델과 체육관 관장도\\n겸업으로 하고 있지만.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_esper_sp02_03",
      "hash64": "FC431A675651BEA1",
      "text": "여기에는 모르는 사람들이 많아서\\n리파의 직업을 가르쳐 주면\\r\\n다들 관심 있어 하더라.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_esper_sp02_04",
      "hash64": "FC431B675651C054",
      "text": "팔데아에서는 유명인으로 통했는데\\n해외에서는 리파도 아직 멀었나 봐.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_esper_sp02_05",
      "hash64": "FC431C675651C207",
      "text": "이렇게 된 거 리파의 아름다움의 비결을\\n세계에 풀 패키지로 전파해야겠어![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_esper_sp03_00",
      "hash64": "CE890D60F3760F59",
      "text": "그러고 보니, [VAR 0x0100(0000)].\\n리파와 한 약속, 기억하고 있어?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_esper_sp03_01",
      "hash64": "CE890C60F3760DA6",
      "text": "연상의 어드바이스를\\n기억하다니, 기특한걸?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_esper_sp03_01b",
      "hash64": "68EDCCBDB199640C",
      "text": "그런 맹한 캐릭터도 귀엽긴 하지만...\\n봐주는 건 이번뿐이야.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_esper_sp03_02",
      "hash64": "CE890B60F3760BF3",
      "text": "재능을 한계까지 끌어올려서\\n계속 눈부시게 빛나달라고 약속했지...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_esper_sp03_03",
      "hash64": "CE890A60F3760A40",
      "text": "근데, 괜한 걱정이었나 봐!\\n오히려... 후후!\\r\\n리파를 깜짝 놀라게 할 정도였어.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_gym_esper_sp03_04",
      "hash64": "CE891160F3761625",
      "text": "어때? 좀 더 어른이 되고 나면\\n리파의 회사에 오지 않겠어?\\r\\n너라면 세계도 노려볼 수 있을 거야.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_esper_sp03_select_01",
      "hash64": "3AC4424555EA2645",
      "text": "잘 부탁드려요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_gym_esper_sp03_select_02",
      "hash64": "3AC43F4555EA212C",
      "text": "어떡하지...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_gym_esper_sp03_05",
      "hash64": "CE891060F3761472",
      "text": "후후!\\n대답은 나중에 들을게.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_esper_trade_01_00",
      "hash64": "5FDF20F4F514844B",
      "text": "리파와의 새로운 약속\\n절대 잊어버리면 안 돼.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_esper_trade_01_01",
      "hash64": "5FDF1FF4F5148298",
      "text": "무슨 일이 있어도 잊을 수 없게...\\n리파와 추억을 만들어 둘까?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
