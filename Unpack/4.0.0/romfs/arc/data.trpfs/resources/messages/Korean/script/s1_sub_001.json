      ]
    },
    {
      "ordinal": 23,
      "label": "s1_sub_001_ecology_19",
      "hash64": "452CD6139DA43D96",
      "text": "트레이너가 맡지 않은 알은\\n아카데미로 보내져서\\r\\n아카데미 내에서 키우고 있는데...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
