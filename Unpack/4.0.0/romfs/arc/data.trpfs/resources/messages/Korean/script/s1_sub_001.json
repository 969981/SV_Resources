      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_001_ecology_21",
      "hash64": "453066139DA7681D",
      "text": "...그러니까\\n[VAR 0x0100(0000)]도 받아 줘![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
