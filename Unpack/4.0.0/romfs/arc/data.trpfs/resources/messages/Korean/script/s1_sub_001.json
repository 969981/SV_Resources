      "ordinal": 10,
      "label": "s1_sub_001_ecology_08",
      "hash64": "452951139DA125C0",
      "text": "내가 만든 샌드위치야!\\n맛있게 먹어~[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
