    {
      "ordinal": 8,
      "label": "s1_sub_001_ecology_06",
      "hash64": "45295F139DA13D8A",
      "text": "그래! 사과도 할 겸\\n피크닉을 열어 줄게~[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
