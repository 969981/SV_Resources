      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_001_ecology_07",
      "hash64": "452960139DA13F3D",
      "text": "이런 일이 있을 줄 알고\\n클라벨 선생님한테\\r\\n테이블이랑 이것저것을 빌려 왔거든~[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
