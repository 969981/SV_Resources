      "ordinal": 11,
      "label": "s1_sub_001_ecology_09",
      "hash64": "452952139DA12773",
      "text": "...모양이 조금 이상하지만\\n맛은 걱정하지 않아도 돼~[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
