      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_rival_d_19",
      "hash64": "0E61A510107EB044",
      "text": "너만은 언제까지고\\n나와 대등한 사람이었으면 좋겠어![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
