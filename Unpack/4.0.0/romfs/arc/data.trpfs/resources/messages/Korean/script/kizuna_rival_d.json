      "ordinal": 24,
      "label": "kizuna_rival_d_system_06",
      "hash64": "AF6D406F3486BBDA",
      "text": "친구잖아!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
