      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_rival_d_21",
      "hash64": "0E572D1010758FD7",
      "text": "조금 부끄러운 이야기를 해 버렸네![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
