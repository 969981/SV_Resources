    },
    {
      "ordinal": 5,
      "label": "kizuna_rival_d_system_01",
      "hash64": "AF6D3B6F3486B35B",
      "text": "잘 정리돼 있네!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_rival_d_system_02",
      "hash64": "AF6D3C6F3486B50E",
      "text": "네모다워!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_rival_d_06",
      "hash64": "0E5E1A10107B8E3C",
      "text": "어라? 생각해 보니\\n[VAR 0x0100(0000)]의 방에는\\r\\n간 적 있는데...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
