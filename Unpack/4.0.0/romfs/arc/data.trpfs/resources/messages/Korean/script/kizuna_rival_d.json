          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_rival_d_09",
      "hash64": "0E5E2110107B9A21",
      "text": "포켓몬 승부를 진짜\\n무지무지하게 좋아하거든?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
