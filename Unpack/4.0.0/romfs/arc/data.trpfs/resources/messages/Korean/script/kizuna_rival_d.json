      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_rival_d_05",
      "hash64": "0E5E1D10107B9355",
      "text": "짠짜잔~!!\\n네모 룸에 어서 오시라~![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
