      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_rival_d_04",
      "hash64": "0E5E1C10107B91A2",
      "text": "괜찮다면 내 방에 가서\\n잠깐 이야기하자![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
