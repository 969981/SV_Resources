      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_rival_d_03",
      "hash64": "0E5E1710107B8923",
      "text": "그랬더니 진짜로 만났네![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
