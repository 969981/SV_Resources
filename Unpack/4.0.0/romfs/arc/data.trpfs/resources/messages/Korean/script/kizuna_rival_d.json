      "ordinal": 23,
      "label": "kizuna_rival_d_system_05",
      "hash64": "AF6D3F6F3486BA27",
      "text": "물론이지!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
