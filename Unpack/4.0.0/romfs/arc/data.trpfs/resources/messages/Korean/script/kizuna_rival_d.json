      "label": "kizuna_rival_d_20",
      "hash64": "0E572C1010758E24",
      "text": "헤헤...\\n고마워, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
