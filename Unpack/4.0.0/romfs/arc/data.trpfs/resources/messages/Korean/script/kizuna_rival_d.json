          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_rival_d_system_03",
      "hash64": "AF6D3D6F3486B6C1",
      "text": "그랬구나",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_rival_d_system_04",
      "hash64": "AF6D3E6F3486B874",
      "text": "알고 있어",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_rival_d_10",
      "hash64": "0E619E10107EA45F",
      "text": "응, 아무튼 그러니까...\\n누구든 좋아하는 일에는 푹 빠지게 되잖아.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_rival_d_11",
      "hash64": "0E619D10107EA2AC",
      "text": "나도 그렇게 푹 빠지다 보니까...\\n챔피언까지 될 수 있었어.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_rival_d_12",
      "hash64": "0E61A010107EA7C5",
      "text": "근데 다들 그게 엄청난 일이고,\\n보통은...\\r\\n쉽게 될 수 없다는 거야.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_rival_d_13",
      "hash64": "0E619F10107EA612",
      "text": "그래서 당시에는 “네모는 천재니까~”라든가\\n“자란 환경이 다르니까~”라든가\\r\\n별의별 말을 다 들었어.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_rival_d_14",
      "hash64": "0E619A10107E9D93",
      "text": "그랬더니 왠지 모르게\\n남들과 어떤 벽 같은 게 느껴져서...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_rival_d_15",
      "hash64": "0E619910107E9BE0",
      "text": "친구와 포켓몬 승부를 할 때도\\n두 사람 다 즐거울 수 있게\\r\\n일부러 힘을 빼게 됐어.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_rival_d_16",
      "hash64": "0E619C10107EA0F9",
      "text": "...아! 물론\\n지금은 전력으로 하고 있어![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_rival_d_17",
      "hash64": "0E619B10107E9F46",
      "text": "전력을 다해도\\n이길 수 없을 것 같은 상대가\\r\\n옆에 있으니까 너무 즐거워서 말이야![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
