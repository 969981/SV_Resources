    {
      "ordinal": 8,
      "label": "common_1100_select_01",
      "hash64": "CF70140E04FD7386",
      "text": "그럴지도 몰라!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "common_1100_select_02",
      "hash64": "CF70130E04FD71D3",
      "text": "그런가?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "common_1100_rival_04",
      "hash64": "0E61F1BD5903E4E1",
      "text": "음...?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
