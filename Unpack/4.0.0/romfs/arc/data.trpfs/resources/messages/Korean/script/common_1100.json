          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_1100_rival_05b",
      "hash64": "744F5DBE419B3A24",
      "text": "확실히 미래스러운 느낌은 있으니까!\\n이름도 그렇잖아!\\r\\n분명 그럴 거야~![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
