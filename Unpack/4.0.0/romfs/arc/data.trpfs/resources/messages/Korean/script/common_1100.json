    {
      "ordinal": 13,
      "label": "common_1100_rival_06",
      "hash64": "0E61EFBD5903E17B",
      "text": "아차! 페퍼!\\n잊고 있었는데~[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
