    {
      "ordinal": 2,
      "label": "common_1100_botan_01",
      "hash64": "E8349DF91EB56604",
      "text": "음...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
