      ]
    },
    {
      "ordinal": 11,
      "label": "common_1100_rival_05a",
      "hash64": "744F60BE419B3F3D",
      "text": "확실히 고대스러운 느낌은 있으니까!\\n이름도 그렇잖아!\\r\\n분명 그럴 거야~![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
