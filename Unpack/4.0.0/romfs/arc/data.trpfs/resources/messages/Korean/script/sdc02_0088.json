      "hash64": "4F39881CD20CF780",
      "text": "그렇다면 평생\\n약해 빠진 채로 살지 그래?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
