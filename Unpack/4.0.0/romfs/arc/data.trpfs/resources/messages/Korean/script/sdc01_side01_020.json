          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_side01_020_brother_34",
      "hash64": "A021D035E043A755",
      "text": "블루베리 아카데미에서도\\n누나가 나 대신 다 알아서 해 주니까...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
