          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_side01_020_brother_35",
      "hash64": "A021CF35E043A5A2",
      "text": "혼자서도 잘할 수 있게\\n더 강해지고 싶어...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_side01_020_brother_36",
      "hash64": "A021CE35E043A3EF",
      "text": "자기 몫을 다할 수 있는 사람이 돼서\\n도깨비님이랑...\\r\\n친구가 될 거야.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
