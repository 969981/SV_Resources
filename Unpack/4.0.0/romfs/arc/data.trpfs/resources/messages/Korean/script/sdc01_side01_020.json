      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_side01_020_brother_16",
      "hash64": "A028DE35E049DDCD",
      "text": "아... 그렇지!\\n사진, 찍어야 했지![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
