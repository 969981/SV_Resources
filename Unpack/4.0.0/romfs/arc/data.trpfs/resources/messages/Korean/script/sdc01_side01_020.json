    },
    {
      "ordinal": 27,
      "label": "sdc01_side01_020_brother_33",
      "hash64": "A021C935E0439B70",
      "text": "나도 도깨비님처럼\\n멋있어지고 싶어.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
