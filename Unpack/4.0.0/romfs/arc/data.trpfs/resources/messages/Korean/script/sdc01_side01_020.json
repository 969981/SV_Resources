    {
      "ordinal": 24,
      "label": "sdc01_side01_020_brother_32",
      "hash64": "A021CA35E0439D23",
      "text": "세벗들이 빼앗은 가면은\\n북신센터에 보관되어 있어.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
