    {
      "ordinal": 10,
      "label": "sdc01_side01_020_brother_09",
      "hash64": "A0255B35E046C95D",
      "text": "그럼, 간판을 읽어 봐.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
