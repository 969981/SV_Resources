    },
    {
      "ordinal": 40,
      "label": "sdc01_side01_020_brother_41",
      "hash64": "A032CB35E0521209",
      "text": "싫다면 어쩔 수 없지...\\n그치만, 너한테 꼭 보여 주고 싶어...![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
