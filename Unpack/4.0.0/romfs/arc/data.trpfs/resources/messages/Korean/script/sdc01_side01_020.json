      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "sdc01_side01_020_select_08",
      "hash64": "F3A3FE10EE5888E2",
      "text": "어쩌지...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "sdc01_side01_020_brother_40",
      "hash64": "A032CA35E0521056",
      "text": "마, 만세!\\n[VAR 0x0100(0000)]에게도 보여 주고 싶었거든...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
