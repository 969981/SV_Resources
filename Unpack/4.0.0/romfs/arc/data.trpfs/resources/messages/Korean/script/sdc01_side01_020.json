    {
      "ordinal": 33,
      "label": "sdc01_side01_020_brother_18",
      "hash64": "A028D035E049C603",
      "text": "역시 [VAR 0x0100(0000)]에게 맡기니까\\n안심이 되는 것 같아.[VAR 0x0114(0043)]",
      "flags": 0,
