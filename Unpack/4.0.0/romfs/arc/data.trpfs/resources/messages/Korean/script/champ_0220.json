      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0220_steel_02",
      "hash64": "9293522F48E4CC50",
      "text": "칠리 언니, 진 거예요~!?[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0220_ground_10",
      "hash64": "D983454188D21203",
      "text": "맞아!\\n엄청 강하더라니까~[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "champ_0220_ground_11",
      "hash64": "D983444188D21050",
      "text": "나는 옆에서 견학하고 있을 테니까\\n언니의 복수, 부탁할게![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "champ_0220_steel_03",
      "hash64": "9293532F48E4CE03",
      "text": "네![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
