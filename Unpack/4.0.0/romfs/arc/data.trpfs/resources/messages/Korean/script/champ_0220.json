    {
      "ordinal": 0,
      "label": "champ_0220_stopper_01",
      "hash64": "A70D68ECF0A6BE31",
      "text": "돌아갈 수 없다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "champ_0220_stopper_02",
      "hash64": "A70D65ECF0A6B918",
      "text": "승부에서 이기지 않으면\\n앞으로 갈 수 없다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "champ_0220_system_01",
      "hash64": "73B89DD4C5087C33",
