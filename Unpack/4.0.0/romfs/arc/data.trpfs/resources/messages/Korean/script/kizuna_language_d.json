          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_language_d_13",
      "hash64": "C77C0265D90979C0",
      "text": "포켓몬의 말은 잘 모르지만,\\n방금 그건 분명히 Yes라는 뜻이겠지!?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
