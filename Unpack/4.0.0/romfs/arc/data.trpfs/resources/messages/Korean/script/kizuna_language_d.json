      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_language_d_08b",
      "hash64": "F9F39C0FC76634FE",
      "text": "왜 그래?\\n갑자기 My name을 부르고 말이야.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
