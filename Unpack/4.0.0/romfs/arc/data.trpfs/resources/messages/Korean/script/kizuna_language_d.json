          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_language_d_14",
      "hash64": "C77C0965D90985A5",
      "text": "친애하는 [VAR 0x0100(0000)]!\\n땡큐 Very very 감사![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
