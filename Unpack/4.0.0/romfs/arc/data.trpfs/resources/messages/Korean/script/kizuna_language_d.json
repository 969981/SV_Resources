    {
      "ordinal": 3,
      "label": "kizuna_language_d_03",
      "hash64": "C7790265D90743E9",
      "text": "HA! HA! HA! 조용한 것 역시\\n이 아이의 개성인 거지~![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
