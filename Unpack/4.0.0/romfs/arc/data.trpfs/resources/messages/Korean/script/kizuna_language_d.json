      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_language_d_12",
      "hash64": "C77C0365D9097B73",
      "text": "빠모!\\n마, 말을 했어!![VAR 0x0114(0026)]",
