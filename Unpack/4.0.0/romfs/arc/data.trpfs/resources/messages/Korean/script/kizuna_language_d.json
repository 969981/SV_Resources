      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_language_d_09",
      "hash64": "C7790865D9074E1B",
      "text": "아...! 그렇구나!\\n나랑 같이 있으면 된다는 거지!?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
