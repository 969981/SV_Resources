    },
    {
      "ordinal": 9,
      "label": "common_0215_rival_07",
      "hash64": "3D1DB1B8D9FFF52E",
      "text": "그럼, [VAR 0x0100(0000)]!\\n알차게 승부해 보자![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
