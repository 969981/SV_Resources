      ]
    },
    {
      "ordinal": 4,
      "label": "common_0215_rival_05",
      "hash64": "3D1DAFB8D9FFF1C8",
      "text": "얼마나 강해졌나\\n나랑 승부해서 확인해 보지 않을래!?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
