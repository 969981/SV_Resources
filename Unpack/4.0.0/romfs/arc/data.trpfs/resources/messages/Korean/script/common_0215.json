      ]
    },
    {
      "ordinal": 10,
      "label": "common_0215_rival_08a",
      "hash64": "D9594C1A6DDF620A",
      "text": "대단해! [VAR 0xFF00(0006)]테라스탈 포켓몬[VAR 0xFF00(0000)]을 상대로\\n그냥 이겨 버리다니![VAR 0x0114(0004)]",
