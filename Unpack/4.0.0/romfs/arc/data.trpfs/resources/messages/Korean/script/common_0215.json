      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_0215_rival_06a",
      "hash64": "D96D301A6DEFDB80",
      "text": "만세~!\\n역시 친구가 있어야 한다니까![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
