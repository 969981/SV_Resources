    },
    {
      "ordinal": 14,
      "label": "common_0215_rival_14",
      "hash64": "3D1A32B8D9FCE78A",
      "text": "[VAR 0x0100(0000)]에게\\n승부해 준 보답을 해야지! 기력의조각이야![VAR 0x0114(0004)]",
