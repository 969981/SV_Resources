          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0070_rival_02",
      "hash64": "FA14B18685E997C8",
      "text": "역시 그랬구나!\\n건너편 집에 사는 이웃 주민![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0070_rival_03",
      "hash64": "FA14B28685E9997B",
      "text": "어떤 아이가 이사 온 걸까\\n무지하게 궁금했었어![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0070_rival_04",
      "hash64": "FA14B78685E9A1FA",
      "text": "내 이름은 네모!\\n평소에는 학교 기숙사에서 지내지만\\r\\n이웃끼리 잘 지내보자~![VAR 0x0114(0004)]",
      "flags": 0,
