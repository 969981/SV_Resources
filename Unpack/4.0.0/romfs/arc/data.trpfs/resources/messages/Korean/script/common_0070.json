        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_0070_head_teacher_01",
      "hash64": "FC1844C97563E466",
      "text": "생각보다 빨리 도착하셨군요.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
