      "label": "common_0070_rival_00",
      "hash64": "FA14B38685E99B2E",
      "text": "안녕~!\\n우리 처음 보는 사이 맞지?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
