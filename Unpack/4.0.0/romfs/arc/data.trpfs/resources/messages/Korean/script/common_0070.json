    {
      "ordinal": 9,
      "label": "common_0070_rival_05a",
      "hash64": "DAD958958C0153A4",
      "text": "씩씩하고 멋진 대답인걸!\\n앞으로 잘 부탁해~![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
