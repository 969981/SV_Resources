      ]
    },
    {
      "ordinal": 25,
      "label": "s2_sub_007_aku_15",
      "hash64": "BBF60BAC09DBE506",
      "text": "나름 우리가 가르쳐 보기도 했거든?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
