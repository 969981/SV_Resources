      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_sub_007_aku_14",
      "hash64": "BBF60CAC09DBE6B9",
      "text": "이대로 있다간 유급할지도 모른대...\\n겨우 아카데미로 돌아왔는데 말이야.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
