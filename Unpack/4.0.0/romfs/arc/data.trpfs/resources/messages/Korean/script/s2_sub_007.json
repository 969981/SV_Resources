      "ordinal": 22,
      "label": "s2_sub_007_kakutou_07",
      "hash64": "F9A04EA118EF0C14",
      "text": "멜리랑 티가랑\\n추명이 셋을 말하는 거야.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
