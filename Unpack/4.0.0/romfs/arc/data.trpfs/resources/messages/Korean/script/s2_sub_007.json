      ]
    },
    {
      "ordinal": 23,
      "label": "s2_sub_007_aku_13",
      "hash64": "BBF60DAC09DBE86C",
      "text": "그래, 걔네들! 아무튼, 녀석들이 계속\\n추가 시험에 합격하질 못해서...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
