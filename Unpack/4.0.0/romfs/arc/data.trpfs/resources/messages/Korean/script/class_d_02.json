      ]
    },
    {
      "ordinal": 20,
      "label": "class_d_02_language_13",
      "hash64": "F15750CD7B7FF197",
      "text": "칭찬받아서 나쁘게 생각하는 사람은\\n거의 없으니까![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
