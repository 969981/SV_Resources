          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_02_language_05",
      "hash64": "F15ABACD7B82DB8C",
      "text": "Today is 해외에서 사용하면\\n상대를 기쁘게 할 수 있는 말을 주제로\\r\\nLesson을 할 생각이야![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
