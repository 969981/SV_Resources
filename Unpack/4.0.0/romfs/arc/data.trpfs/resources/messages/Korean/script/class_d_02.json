          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_d_02_language_10",
      "hash64": "F15751CD7B7FF34A",
      "text": "해외 사람이 자기 나라의\\n음식을 칭찬하면\\r\\n누구라도 Happy하지 않겠어!?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
