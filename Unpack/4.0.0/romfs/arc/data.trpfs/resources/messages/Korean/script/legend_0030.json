        }
      ]
    },
    {
      "ordinal": 71,
      "label": "legend_0030_friend_37b",
      "hash64": "F64DCC88119D04DC",
      "text": "아빠의 연구실에서\\n이 책을 발견했거든.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
