          ]
        }
      ]
    },
    {
      "ordinal": 73,
      "label": "legend_0030_friend_39",
      "hash64": "1D012B99E9AD72D4",
      "text": "그렇지만 나는\\n이 책의 내용이 진짜라고 생각해![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
