      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 84,
      "label": "legend_0030_friend_47",
      "hash64": "1CE9A199E999A975",
      "text": "우... 하하, 하하하...!\\n눈이 너무 작아서\\r\\n뜬 건지 안 뜬 건지도 모르겠어![VAR 0x0114(0006)]",
