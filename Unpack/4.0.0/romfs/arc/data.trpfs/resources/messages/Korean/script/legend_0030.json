          ]
        }
      ]
    },
    {
      "ordinal": 72,
      "label": "legend_0030_friend_38",
      "hash64": "1D012C99E9AD7487",
      "text": "거짓말 같은 이야기가 잔뜩 적혀 있는\\n아무도 못 믿을 오컬트 책이지.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
