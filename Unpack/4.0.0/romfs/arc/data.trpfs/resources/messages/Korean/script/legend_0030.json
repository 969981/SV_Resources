    {
      "ordinal": 70,
      "label": "legend_0030_friend_36a",
      "hash64": "F651B38811A0C338",
      "text": "엄마의 연구실에서\\n이 책을 발견했거든.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
