          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 74,
      "label": "legend_0030_friend_40",
      "hash64": "1CE99A99E9999D90",
      "text": "책에 나온 바로는\\n5개의 비전스파이스를 전부 먹으면\\r\\n어떤 상처든 병이든 낫는대![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 75,
      "label": "legend_0030_friend_41",
      "hash64": "1CE99B99E9999F43",
      "text": "실제로 저번에 찾은 스파이스를 먹였더니\\n엄청나게 차가웠던 마피티프의 발이\\r\\n조금 따뜻해지기도 했고.[VAR 0x0114(0006)]",
      "flags": 0,
