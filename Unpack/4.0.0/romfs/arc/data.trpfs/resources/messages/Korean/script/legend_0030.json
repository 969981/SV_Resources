      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 79,
      "label": "legend_0030_friend_43",
      "hash64": "1CE99D99E999A2A9",
      "text": "우와아아! 마피티프!\\n너 설마...!\\r\\n눈이 보이는 거야!?[VAR 0x0114(0006)]",
