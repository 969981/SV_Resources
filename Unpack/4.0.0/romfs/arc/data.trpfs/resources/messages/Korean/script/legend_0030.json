        }
      ]
    },
    {
      "ordinal": 81,
      "label": "legend_0030_friend_45",
      "hash64": "1CE99F99E999A60F",
      "text": "네가 계속... 계속!\\n앞도 못 보고!\\r\\n내가 얼마나 걱정을...![VAR 0x0114(0006)]",
