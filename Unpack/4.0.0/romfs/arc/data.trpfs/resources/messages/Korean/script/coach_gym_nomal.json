    },
    {
      "ordinal": 35,
      "label": "coach_gym_nomal_trade_03_01",
      "hash64": "4B8BB97C80D02CB2",
      "text": "...그럼, 다음에 일정이 맞으면\\n부탁드리겠습니다.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
