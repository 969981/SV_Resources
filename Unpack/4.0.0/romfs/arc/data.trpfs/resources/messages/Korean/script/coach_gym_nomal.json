    {
      "ordinal": 46,
      "label": "coach_gym_nomal_battleend_win_01_00",
      "hash64": "254DF25C3A838DFB",
      "text": "이것을 드리겠습니다.\\n오늘은 이만 마무리하도록 하죠.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
