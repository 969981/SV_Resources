    {
      "ordinal": 42,
      "label": "coach_gym_nomal_battleend_win_00_01",
      "hash64": "5154FD629BEDA55D",
      "text": "당신이라는 사람은\\n점점 더 강해지시네요.[VAR 0x0114(0015)]",
