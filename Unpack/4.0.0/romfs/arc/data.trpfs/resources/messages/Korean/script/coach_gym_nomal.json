    {
      "ordinal": 30,
      "label": "coach_gym_nomal_trade_02_00",
      "hash64": "20A14487C9DCF6B4",
      "text": "당신의 [VAR 0x0101(0001)][VAR 0x1900(0004)]\\n제 노고고치를 교환하시겠습니까?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
