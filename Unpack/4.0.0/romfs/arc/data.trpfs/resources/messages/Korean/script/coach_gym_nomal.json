        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_gym_nomal_randomtalk_04",
      "hash64": "365666E3B8700300",
      "text": "지난번에 교환해 드린\\n노고고치는 잘 지내고 있습니까?\\c\\n비행타입으로 테라스탈하는...\\n공중날기노고고치입니다.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
