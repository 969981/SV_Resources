          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0100_rival_12",
      "hash64": "5292513E0601CC55",
      "text": "가까이 가면 배틀을 하게 되지만\\n[VAR 0x0101(0001)][VAR 0x1900(0004)] 함께니까 괜찮을 거야![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
