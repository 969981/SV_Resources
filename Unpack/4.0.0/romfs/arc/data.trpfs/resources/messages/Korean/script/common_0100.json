          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0100_poke_01",
      "hash64": "FEC5BA1FC36F988C",
      "text": "꾸우꾸우!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_0100_rival_18",
      "hash64": "5292573E0601D687",
      "text": "앗! 마침 잘됐다![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0100_rival_19",
      "hash64": "5292563E0601D4D4",
      "text": "실전으로 익히는 게 더 빠를 거야!\\n[VAR 0x0100(0000)]! 가서 싸워 봐![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
