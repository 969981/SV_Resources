          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0100_rival_17",
      "hash64": "52924C3E0601C3D6",
      "text": "잔뜩 가지고 있으니까\\n너한테도 나눠 줄게![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
