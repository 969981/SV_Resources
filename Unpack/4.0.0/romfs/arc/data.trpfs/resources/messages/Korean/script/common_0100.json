        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0100_rival_02",
      "hash64": "528EC73E05FEAC00",
      "text": "너도 잘 아는\\n이 [VAR 0xFF00(0006)]몬스터볼[VAR 0xFF00(0000)]이라는 도구야![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
