      "text": "[VAR 0x0100(0000)]!\\n여기부터가 티스푼 오솔길이야![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
