          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_bb_brother_sp01_02",
      "hash64": "CD0657629AEB76DF",
      "text": "제빈은 혼자 히죽거리면서\\n나를 쳐다보긴 했지만...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb_brother_sp01_03",
      "hash64": "CD0656629AEB752C",
      "text": "그래도 제대로 사과했어.\\n그동안 한 일에 대해... 미안하다고 말이야.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_bb_brother_sp01_select_01",
      "hash64": "7B95975FE6DF1221",
      "text": "잘됐다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_bb_brother_sp01_select_02",
      "hash64": "7B95945FE6DF0D08",
      "text": "친해졌구나!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_bb_brother_sp01_04",
      "hash64": "CD0655629AEB7379",
      "text": "...응! 잘됐어.\\n이게 다 [VAR 0x0100(0000)] 덕분이야.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
