          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb_brother_sp01_04b",
      "hash64": "4D36318D3E1496E1",
      "text": "친해졌다...고 하기에는\\n조금 다른 것 같지만...\\r\\n좀 더... 음.\\r\\n노력해... 보려고.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
