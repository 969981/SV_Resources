          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb_brother_sp01_05",
      "hash64": "CD0654629AEB71C6",
      "text": "휴학하는 동안 놓친 것들도\\n이제부터 따라잡을 생각이야...![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb_brother_sp02_00",
      "hash64": "2781177BE3515FF2",
      "text": "북신에서는 페퍼랑 친구들이랑\\n놀러 와 줘서 고마웠어.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb_brother_sp02_01",
      "hash64": "2781187BE35161A5",
      "text": "집에서 쉬는 동안, 지금까지 있었던 일들이\\n머릿속을 떠나지 않아서 많이 힘들었는데...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb_brother_sp02_02",
      "hash64": "2781157BE3515C8C",
      "text": "너희가 놀러 와 줘서\\n많이 도움이 됐어.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb_brother_sp02_03",
      "hash64": "2781167BE3515E3F",
      "text": "살짝 이상한 일도 있긴 했지만...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb_brother_sp02_select_03",
      "hash64": "A9DD7FFF7C8F6BAA",
      "text": "시유가...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb_brother_sp02_select_04",
      "hash64": "A9DD7AFF7C8F632B",
      "text": "수슈수슈!?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_bb_brother_sp02_05",
      "hash64": "2781147BE3515AD9",
      "text": "그래, 그거! 누나는 여전히 부끄러워하니까\\n말했다간 한 대 얻어맞을지도 몰라![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb_brother_sp02_05b",
      "hash64": "71B08983433D2BC1",
      "text": "그래, 그거! 지금이야 웃으면서\\n이야기할 수 있지만, 엄청 무서웠어![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb_brother_sp02_06",
      "hash64": "2781117BE35155C0",
      "text": "나... 많이 고민했는데\\n드디어 결심이 섰어.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb_brother_sp02_07",
      "hash64": "2781127BE3515773",
      "text": "어떤 건지는 다음에 알려 줄 테니까\\n그때까지 기다려 줘![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb_brother_sp03_00",
      "hash64": "50B90D7098D3DCA3",
      "text": "[VAR 0x0100(0000)]!\\n나 있잖아! 블루베리그에서...\\r\\n...제명해 달라고 했어![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
