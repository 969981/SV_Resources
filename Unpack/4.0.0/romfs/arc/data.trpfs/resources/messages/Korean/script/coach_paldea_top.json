            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_paldea_top_sp02_04c",
      "hash64": "22016EA3718A9B67",
      "text": "하솔 님이시라면!\\n블루베리그의 사천왕인 분이군요.\\c\\n포켓몬리그에는\\n불꽃타입의 전문가가 없으니\\r\\n신선함을 줄 수 있겠네요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea_top_sp02_04d",
      "hash64": "22016BA3718A964E",
      "text": "네리네 님이시라면!\\n블루베리그의 사천왕인 분이군요.\\c\\n같은 강철타입 전문가로서\\n뽀삐와 친하게 지낼 수 있겠네요.\\c\\n냉철한 판단력에서 나오는 전략이\\n팔데아에 빛을 가져다줄지도 모르겠어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_paldea_top_sp02_04e",
      "hash64": "22016CA3718A9801",
      "text": "타로 님이시라면!\\n블루베리그의 사천왕인 분이군요.\\c\\n듣기로, 아버님께서 하나지방의\\n체육관 관장이시라고...\\c\\n포켓몬리그에는\\n페어리타입의 전문가가 없으니\\r\\n한번 이야기를 나눠 보고 싶네요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 61,
