    {
      "ordinal": 0,
      "label": "coach_paldea_top_first_00",
      "hash64": "6DA4ECE3D88E9763",
      "text": "여기가 보기 드문 재능을\\n가진 자들이 모인 부실이군요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
