        }
      ]
    },
    {
      "ordinal": 63,
      "label": "coach_paldea_top_randomtalk_02",
      "hash64": "638FC9E20AE3DC60",
      "text": "블루베리 아카데미의 입구 로비는\\n정말 독창적이고 멋진 것 같아요.\\c\\n물론 우리 아카데미의 입구 홀도\\n거기에 뒤지지 않는다고 생각하지만요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
