    {
      "ordinal": 30,
      "label": "coach_paldea_top_sp03_01",
      "hash64": "39451DFFAE9CE188",
      "text": "최근에는 거의\\n블루베리 아카데미에만 계신 것 같네요...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
