          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "coach_paldea_top_randomtalk_01",
      "hash64": "638FCCE20AE3E179",
      "text": "저도 몇 번인가\\n제로랩에 간 적이 있는데...\\c\\n남청의디스크를 입구 패널에\\n넣어 볼 생각은 전혀 못 했어요.\\c\\n후후... 역시 당신은\\n제 상상을 아득히 초월하는 분이네요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 62,
