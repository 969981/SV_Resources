          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_paldea_top_sp02_04f",
      "hash64": "220169A3718A92E8",
      "text": "제빈 님이시라면!\\n블루베리그의 사천왕인 분이군요.\\c\\n듣기로, 할아버님께서 하나지방의\\n체육관 관장이시라고...\\c\\n카지 님이 두각을 드러내기 전까지\\n챔피언이셨다고도 들었어요.\\r\\n정말 흥미롭고 보기 드문 재능이네요...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
