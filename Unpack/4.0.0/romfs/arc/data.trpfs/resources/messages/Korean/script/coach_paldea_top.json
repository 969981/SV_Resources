          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_paldea_top_sp01_00",
      "hash64": "B5926AF1B0B480DD",
      "text": "그리 오래 있지는 못하지만\\n잠깐이나마 함께하도록 할게요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_paldea_top_sp01_select_01",
      "hash64": "954258941752ACE9",
      "text": "와 주셔서 감사해요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "coach_paldea_top_sp01_select_02",
      "hash64": "954255941752A7D0",
      "text": "바쁘신가 보네요",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_paldea_top_sp01_01",
      "hash64": "B59269F1B0B47F2A",
      "text": "바쁘다는 핑계로\\n챔피언 [VAR 0x0100(0000)]의 초대를\\r\\n헛되게 할 수는 없죠.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_paldea_top_sp01_02",
      "hash64": "B59268F1B0B47D77",
      "text": "하나지방의 포켓몬리그와\\n시아노 님과도 용건이 있으니\\r\\n너무 마음 쓰지 않으셔도 돼요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_paldea_top_sp01_03",
      "hash64": "B59267F1B0B47BC4",
      "text": "게다가 가까운 미래에\\n이 아카데미에서 팔데아로 올\\r\\n젊은 인재가 늘어날 기회라 생각하니...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea_top_sp01_04",
      "hash64": "B59266F1B0B47A11",
      "text": "당신의 초대가\\n더욱 매력적으로 느껴졌어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea_top_sp01_05",
      "hash64": "B59265F1B0B4785E",
      "text": "그러고 보니...\\n브라이어 님한테서 제로의 대공동에서도\\r\\n크게 활약하셨다고 들었어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_paldea_top_sp01_06",
      "hash64": "B59264F1B0B476AB",
      "text": "여기에서 이야기하기에는\\n듣는 이가 많으니\\r\\n나중에 자세히 들려주시면 감사하겠어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_paldea_top_sp02_00",
      "hash64": "0EC7290AF805A3EA",
      "text": "안녕하세요,\\n챔피언 [VAR 0x0100(0000)].[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
