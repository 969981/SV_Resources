            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "coach_paldea_top_trade_01_01",
      "hash64": "22F2B5CE6722AC12",
      "text": "제가 당신을 진정으로\\n필요로 하고 있다는 증거로...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "coach_paldea_top_trade_01_02",
      "hash64": "22F2B4CE6722AA5F",
      "text": "서로의 포켓몬을\\n교환하지 않으시겠어요?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
