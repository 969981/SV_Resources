    },
    {
      "ordinal": 36,
      "label": "coach_paldea_top_sp03_04",
      "hash64": "394522FFAE9CEA07",
      "text": "당신이야말로 팔데아를 비추는\\n커다란 빛이니까요...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
