    {
      "ordinal": 59,
      "label": "coach_paldea_top_battleend_win_01_01",
      "hash64": "BFEDE1798BED63AA",
      "text": "글러브에 대한 대답은...\\n천천히 기다리고 있겠어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
