    },
    {
      "ordinal": 35,
      "label": "coach_paldea_top_sp03_03b",
      "hash64": "ED59EB75B49859E4",
      "text": "당신의 의견도 물론 존중하지만...\\c\\n개인적으로는 앞으로도 함께\\n팔데아의 사람들을 이끌어 갔으면 좋겠어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
