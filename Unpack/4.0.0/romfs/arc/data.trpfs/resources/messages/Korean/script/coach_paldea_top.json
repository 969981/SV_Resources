      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "coach_paldea_top_sp03_select_02",
      "hash64": "5E2EA428C53D132A",
      "text": "하나도 괜찮을지도...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "coach_paldea_top_sp03_03",
      "hash64": "39451FFFAE9CE4EE",
      "text": "후후...\\n그렇게 말씀하시니 안심이 되네요.\\c\\n앞으로도 함께\\n팔데아의 사람들을 이끌어 가도록 해요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
