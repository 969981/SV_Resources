  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0230_gfather_01",
      "hash64": "B61F513772593802",
      "text": "Bada bene: è una storia lunga.\\nVuoi che te la racconti ora?[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0230_gfather_02",
      "hash64": "B61F50377259364F",
      "text": "Va bene, te la racconterò quando vorrai\\nsentirla.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0230_gfather_03",
      "hash64": "B61F4F377259349C",
      "text": "Questa storia si tramanda oralmente solo\\nnella nostra famiglia... Io stesso l’ho sentita\\r\\nda mio padre.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0230_gfather_04",
      "hash64": "B61F4E37725932E9",
      "text": "Si tratta di una verità che nessun altro\\nin paese dovrà mai conoscere.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0230_gfather_05",
      "hash64": "B61F4D3772593136",
      "text": "Mi raccomando, non fatene parola con nessuno,\\nmai.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0230_sister_01",
      "hash64": "58DB3930F6695A99",
      "text": "Capito...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0230_history_01",
      "hash64": "487E69A94330FA57",
      "text": "Tanto tempo fa, un uomo e un orco smarriti\\ngiunsero a Nordivia da terre lontane.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0230_history_02",
      "hash64": "487E6AA94330FC0A",
      "text": "Il loro aspetto insolito spaventò gli abitanti\\ndel paese...[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0230_history_03",
      "hash64": "487E6BA94330FDBD",
      "text": "... che quindi impedirono loro di avvicinarvisi.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0230_history_04",
      "hash64": "487E64A94330F1D8",
      "text": "L’uomo e l’orco si dispiacquero molto\\ndell’ostilità dimostrata dagli abitanti...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0230_history_05",
      "hash64": "487E65A94330F38B",
      "text": "Ma a loro bastava stare insieme per essere felici,\\ne si rintanarono nel monte, in una grotta isolata.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0230_history_06",
      "hash64": "487E66A94330F53E",
      "text": "Il mascheraio del paese, l’unico che provasse\\npietà per l’uomo e per l’orco...[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0230_history_07",
      "hash64": "487E67A94330F6F1",
      "text": "Decise di fabbricare per loro una varietà\\ndi maschere.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0230_history_08",
      "hash64": "487E60A94330EB0C",
      "text": "Stupende maschere brillanti, ornate di esotiche\\ngemme che lo straniero aveva portato con sé.[VAR 0x0114(0030)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0230_history_09",
      "hash64": "487E61A94330ECBF",
      "text": "Indossandole, i due avrebbero potuto celare\\nil loro volto e mescolarsi alla gente del luogo.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0230_history_10",
      "hash64": "4881EEA94334122D",
      "text": "L’uomo e l’orco gioirono della gentilezza\\ndel mascheraio, e lo ringraziarono di cuore.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0230_history_11",
      "hash64": "4881EDA94334107A",
      "text": "Fu così che da quel giorno poterono unirsi\\nalla festa del paese all’insaputa della gente.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0230_history_12",
      "hash64": "4881ECA943340EC7",
      "text": "Le maschere della misteriosa coppia erano così\\nbelle da guadagnarsi subito l’ammirazione di tutti.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0230_history_13",
      "hash64": "4881EBA943340D14",
      "text": "La loro fama raggiunse presto anche regioni\\nremote.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0230_history_14",
      "hash64": "4881EAA943340B61",
      "text": "Avendo forse sentito parlare di queste rare\\nmaschere brillanti...[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0230_history_15",
      "hash64": "4881E9A9433409AE",
      "text": "... alcuni avidi Pokémon giunsero a Nordivia.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0230_history_16",
      "hash64": "4881E8A9433407FB",
      "text": "Si introdussero nella grotta in cui vivevano\\nl’uomo e l’orco...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0230_history_17",
      "hash64": "4881E7A943340648",
      "text": "E tentarono di trafugare le maschere che erano\\ngelosamente custodite in quel luogo.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0230_history_18",
      "hash64": "4881E6A943340495",
      "text": "L’uomo, che per fatalità si trovava lì, riuscì\\na proteggere una sola delle maschere...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0230_history_19",
      "hash64": "4881E5A9433402E2",
      "text": "Ma, ormai privo di forze, non riuscì a impedire\\nche i Pokémon assalitori rubassero le tre restanti.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0230_history_20",
      "hash64": "488554A94336F556",
      "text": "Dopo un po’, l’orco tornò alla grotta...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0230_history_21",
      "hash64": "488555A94336F709",
      "text": "Tuttavia, vi trovò solo la maschera di colore\\nturchese e le tracce dello scontro avvenuto.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0230_history_22",
      "hash64": "488552A94336F1F0",
      "text": "L’orco indossò la maschera e scese in paese,\\nforse con il proposito di cercare l’uomo.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0230_history_23",
      "hash64": "488553A94336F3A3",
      "text": "Trovò invece i tre Pokémon, intenti a ostentare\\ncon gioia il loro bottino, e li debellò.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0230_history_24",
      "hash64": "488558A94336FC22",
      "text": "Gli abitanti del paese, ignari dei fatti, non\\ncomprendevano cosa fosse accaduto.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0230_history_25",
      "hash64": "488559A94336FDD5",
      "text": "Tutto ciò che i loro occhi videro fu la figura\\ndi un orco infuriato, e ne furono terrorizzati.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0230_history_26",
      "hash64": "488556A94336F8BC",
      "text": "Credettero così che i tre Pokémon avessero\\nprotetto il paese dall’attacco dell’orco...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0230_history_27",
      "hash64": "488557A94336FA6F",
      "text": "Li chiamarono affettuosamente \"beniamici\" e\\nli seppellirono con tutti gli onori.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_0230_history_28",
      "hash64": "48855CA9433702EE",
      "text": "L’orco, ferito e sconsolato, si ritirò nella grotta\\nisolata del monte vicino.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_0230_history_29",
      "hash64": "48855DA9433704A1",
