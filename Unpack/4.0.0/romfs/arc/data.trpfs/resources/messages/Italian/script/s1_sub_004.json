  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_004_woman_01",
      "hash64": "966BBC4DF81B81B8",
      "text": "Ooooh oh oh oh! Ooooh oh oh oh![VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_004_woman_02",
      "hash64": "966BBF4DF81B86D1",
      "text": "Quindi questa sarebbe una delle tanto\\nchiacchierate dieci meraviglie di Paldea...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_004_man_01",
      "hash64": "9813539872C175D2",
      "text": "Proprio così, Abby cara! Benvenuta alle Cascate\\nFuria![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_004_woman_03",
      "hash64": "966BBE4DF81B851E",
      "text": "Mmh, non so, me le immaginavo meno...\\nmediocri. La mia doccia è più spettacolare.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_004_woman_04",
      "hash64": "966BC14DF81B8A37",
      "text": "Però, mediocri o meno, senti che ioni negativi![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_004_man_02",
      "hash64": "9813529872C1741F",
      "text": "Abby, come al solito sei una vera regina, sempre\\ndisposta a guardare il lato positivo delle cose![VAR 0x0114(0040)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_004_man_03",
      "hash64": "9813519872C1726C",
      "text": "Grazie a te, oltre agli ioni negativi, ora l’aria è\\ncarica di ioni... megadivi![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_004_man_04",
      "hash64": "9813509872C170B9",
      "text": "Avere una Celebrità come te vicina apporta\\nbenessere al corpo e all’anima![VAR 0x0114(0040)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_004_woman_05",
      "hash64": "966BC04DF81B8884",
      "text": "Oh, Nab! Grazie, caro. Che dire?\\nÈ la pura verità.[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_004_woman_06",
      "hash64": "966BC34DF81B8D9D",
      "text": "Mh...?\\nAh, quell[VAR 0x1100(00FF,0101)]oa non è [VAR 0x1100(00FF,0202)]illa plebe[VAR 0x1100(00FF,0101)]oa della volta scorsa?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0202"
          ]
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_004_man_05",
      "hash64": "98134F9872C16F06",
      "text": "Hai ragione! Quel suo aspetto plebeico\\nè inconfondibile![VAR 0x0114(0040)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_004_man_06",
      "hash64": "98134E9872C16D53",
      "text": "Sarà qui per caso, per uno scherzo del destino,\\no per respirare ioni megadivi a pieni polmoni?[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_004_woman_07",
      "hash64": "966BC24DF81B8BEA",
      "text": "Ooooh oh oh oh! Salve, carissim[VAR 0x1100(00FF,0101)]oa! Mi allieta\\nrivederla![VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_004_woman_08",
      "hash64": "966BB54DF81B75D3",
      "text": "Il compito di noi Celebrità è elargire sogni\\nalla plebe...[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_004_woman_09",
      "hash64": "966BB44DF81B7420",
      "text": "Perciò accetti pure questo modestissimo regalo\\nda parte mia.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_004_woman_10",
      "hash64": "9668374DF81869E2",
      "text": "Plebe[VAR 0x1100(00FF,0101)]oa, mi ascolti. Il denaro è come gli ioni\\nnegativi, sa?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_004_woman_11",
      "hash64": "9668384DF8186B95",
      "text": "Esserne immersi dà sicurezza e rende sereni, ma...[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_sub_004_woman_12",
      "hash64": "9668354DF818667C",
      "text": "La felicità così ottenuta può realmente dirsi\\nfelicità?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_sub_004_man_07",
      "hash64": "98134D9872C16BA0",
      "text": "P-Per tutte le carte di credito! Che concetti\\nprofondi! Forse anche troppo per un[VAR 0x1100(00FF,0B0A)] ragazzinoa ragazzina,\\r\\nAbby cara![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0B0A"
          ]
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_sub_004_woman_13",
      "hash64": "9668364DF818682F",
      "text": "Bene, Nab caro, ora ho proprio voglia di andare\\nin un [VAR 0xFF00(0006)]posto fuorimano[VAR 0xFF00(0000)], del tutto oscuro ai più.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_sub_004_man_08",
      "hash64": "98135C9872C1851D",
      "text": "A-ha! Tutti questi posti famosi ti annoiano!\\c\\nAbby cara, sei il faro che illumina la strada\\nlastricata d’oro di noi Celebrità![VAR 0x0114(0040)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_004_man_09",
      "hash64": "98135B9872C1836A",
      "text": "Conosco un posticino delizioso sul confine\\ntra l’Area 5 Sud e l’Area 1 Sud![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_004_secretary_01",
      "hash64": "343F29DD74AED680",
      "text": "I signori Nab e Abby si sono recati nell’Area 2\\nNord di Paldea per vedere delle famose cascate.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
