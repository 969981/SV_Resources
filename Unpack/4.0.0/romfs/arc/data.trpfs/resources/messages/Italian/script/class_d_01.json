          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_d_01_language_11",
      "hash64": "B86AA925961B6C94",
      "text": "Danke! Merci! Xièxie!\\nQueste parole significano tutte \"grazie\"!\\r\\nDirei che l’aiuto più grande era \"gracias\"![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_d_01_language_12",
      "hash64": "B86AAC25961B71AD",
      "text": "Sono tutte parole diverse, sia nella lunghezza\\nche nel suono. Affascinante, vero?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_d_01_language_13",
      "hash64": "B86AAB25961B6FFA",
      "text": "Ma adesso è il momento della dritta del giorno![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_d_01_language_14",
      "hash64": "B86AA625961B677B",
      "text": "Quando andate all’estero, provate a dire\\nqualcosa nella lingua del posto!\\c\\nBasta anche solo una o due parole, niente di più![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_d_01_language_15",
      "hash64": "B86AA525961B65C8",
      "text": "Gli abitanti del luogo apprezzeranno il vostro\\nsforzo e l’intenzione di voler comunicare con\\r\\nloro, e ne saranno senz’altro very happy![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_d_01_language_16",
      "hash64": "B86AA825961B6AE1",
      "text": "Spesso basta solo saper dire \"ciao\", \"che buono\"\\ne \"grazie\" nella lingua del posto per cavarsela\\r\\nnelle situazioni più comuni![VAR 0x0114(0026)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_d_01_language_17",
      "hash64": "B86AA725961B692E",
      "text": "Per il resto, basta usare i gesti, e in un modo o\\nnell’altro riuscirete a comunicare il necessario![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_d_01_language_18",
      "hash64": "B86AA225961B60AF",
      "text": "Oh, è suonata la campanella!\\nPurtroppo per oggi dobbiamo fermarci qui.[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_d_01_language_19",
      "hash64": "B86AA125961B5EFC",
      "text": "Allora... Adiós, bye-bye!\\nSee you next time![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    }
  ]
