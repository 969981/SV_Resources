      ]
    },
    {
      "ordinal": 11,
      "label": "common_0990_friend_09",
      "hash64": "9C4F55DF0F4F9052",
      "text": "Raggiungici appena puoi![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
