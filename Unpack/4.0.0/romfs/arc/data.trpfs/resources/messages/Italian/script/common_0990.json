          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0990_friend_08",
      "hash64": "9C4F56DF0F4F9205",
      "text": "Allora ci vediamo tutti e quattro all’Area Zero![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
