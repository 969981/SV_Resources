          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_side02_0035_camera_02",
      "hash64": "32EDE28013904C19",
      "text": "Mio padre non la usava più, così l’ho presa io.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_side02_0035_camera_03",
      "hash64": "32EDE18013904A66",
      "text": "Questa sarà la nostra base mentre cerchiamo\\nLuna Cremisi.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_side02_0035_dog_01",
      "hash64": "D95290E2CA22E04D",
      "text": "Grooowh!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_side02_0035_camera_04",
      "hash64": "32EDE48013904F7F",
      "text": "Luna Cremisi è molto più diffidente degli altri\\nPokémon.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0035_camera_05",
      "hash64": "32EDE38013904DCC",
      "text": "Dicono sia per questo che si mostra di rado\\nagli esseri umani.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_side02_0035_camera_06",
      "hash64": "32EDE680139052E5",
      "text": "Perciò, dobbiamo muoverci sul campo con molta\\ncautela.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_side02_0035_camera_07",
      "hash64": "32EDE58013905132",
      "text": "Ed è qui che il tuo ruolo di assistente si fa\\nindispensabile: avrei bisogno che mi aiutassi\\r\\n[VAR 0xFF00(0006)]facendo delle foto[VAR 0xFF00(0000)] ai Pokémon![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_side02_0035_camera_08",
      "hash64": "32EDE8801390564B",
      "text": "Vorrei che fotografassi i Pokémon che saltano\\nfuori da queste parti nelle notti nebbiose.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_side02_0035_camera_09",
      "hash64": "32EDE78013905498",
      "text": "Prima cerchiamo di immortalare quanti più\\nPokémon possibili.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_side02_0035_camera_10",
      "hash64": "32EA7A80138D658A",
      "text": "Poi diamo in pasto i dati delle tue foto\\nal mio dispositivo cerca-Pokémon![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_side02_0035_camera_11",
      "hash64": "32EA7B80138D673D",
      "text": "Così facendo, smetterà di reagire alla presenza\\ndei Pokémon che non ci interessano...\\c\\nE alla fine ci indicherà il luogo esatto\\nin cui si trova Luna Cremisi![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 159,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_side02_0035_select_01",
      "hash64": "66DDCC2DC348E231",
      "text": "Geniale!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s1_side02_0035_select_02",
      "hash64": "66DDC92DC348DD18",
      "text": "Non ci ho capito un tubo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s1_side02_0035_camera_12",
      "hash64": "32EA7880138D6224",
      "text": "Eh? Hai capito al volo la mia spiegazione?![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_side02_0035_camera_13",
      "hash64": "32EA7980138D63D7",
      "text": "Io ti ho solo detto quello che ho letto\\nnel manuale.\\c\\nMe l’hanno dato al negozio dell’usato dove ho\\ncomprato il dispositivo, ma non ho mica chiaro\\r\\ncome funziona.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 166,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_side02_0035_camera_14",
      "hash64": "32EA7680138D5EBE",
      "text": "Vero? Non è mica tanto chiaro.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_0035_camera_15",
      "hash64": "32EA7780138D6071",
      "text": "È quello che dice il manuale...\\c\\nMe lo hanno dato al negozio dell’usato dove ho\\ncomprato il dispositivo, ma non ho mica idea\\r\\ndi come funzioni.\\c\\nBah, in qualche modo faremo![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 179,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_side02_0035_camera_16",
      "hash64": "32EA7480138D5B58",
      "text": "In base a ciò che ho scoperto finora, da queste\\nparti nelle notti nebbiose appaiono una ventina\\r\\ndi specie diverse.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_side02_0035_camera_17",
      "hash64": "32EA7580138D5D0B",
      "text": "L’idea è quella di dividerci equamente il lavoro.\\c\\nTu quindi dovresti fotografare [VAR 0xFF00(0006)]10 specie[VAR 0xFF00(0000)] di\\nPokémon.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_side02_0035_camera_18",
      "hash64": "32EA7280138D57F2",
      "text": "Se uniamo le forze, riusciremo senz’altro a\\nscovare Luna Cremisi.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_side02_0035_camera_19",
      "hash64": "32EA7380138D59A5",
      "text": "Ah, un’altra cosa: assicurati che i Pokémon\\nnon vengano troppo piccoli in foto. E poi...\\c\\nEvita di andare in giro cavalcando un Pokémon:\\ni soggetti delle foto potrebbero scappare![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 181,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_side02_0035_camera_20",
      "hash64": "32E77480138B2581",
      "text": "Avvisami quando sei pront[VAR 0x1100(00FF,0101)]oa. Aspetteremo nella\\ntenda che arrivi una [VAR 0xFF00(0006)]notte nebbiosa[VAR 0xFF00(0000)].[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
