    {
      "ordinal": 11,
      "label": "ajito_aku_010_select_03",
      "hash64": "8681CB90FFF4296D",
      "text": "Accetto la sfida!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "ajito_aku_010_select_04",
      "hash64": "8681C490FFF41D88",
      "text": "Me ne torno a casa...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
