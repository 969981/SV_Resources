  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_4kings_d_01_clerk_00",
      "hash64": "743806B7EE256EA4",
      "text": "Se vuoi osservare i seguaci del Superquattro,\\nfai pure con comodo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_d_01_clerk_01",
      "hash64": "743807B7EE257057",
      "text": "I seguaci di Aris, il Superquattro della Piazza\\ndei Ghiacciai, ti danno il benvenuto!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_d_01_clerk_02",
      "hash64": "743808B7EE25720A",
      "text": "Ti chiami [VAR 0x0100(0000)], giusto? Sei qui per\\nscalare i ranghi della Lega Mirtillo, immagino.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_d_01_clerk_03",
      "hash64": "743809B7EE2573BD",
      "text": "Puoi partecipare alla Prova del Superquattro\\nin cambio di 50 PM! Ce li hai?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_d_01_dragonbb_01",
      "hash64": "4196A3A64BDC857D",
      "text": "Spe’, un momento. L[VAR 0x1100(00FF,0101)]uei è con me, non\\npreoccuparti![VAR 0x0114(004A)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_d_01_clerk_04",
      "hash64": "743802B7EE2567D8",
      "text": "Aris! Ma veramente, stando al regolamento...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_d_01_dragonbb_02",
      "hash64": "4196A0A64BDC8064",
      "text": "Li metto io i 50 PM. Dovrebbe andar bene così,\\nno?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_d_01_clerk_05",
      "hash64": "743803B7EE25698B",
      "text": "Beh, veramente... Ok, ricevuto. Per stavolta\\nfacciamo un’eccezione.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_d_01_dragonbb_03",
      "hash64": "4196A1A64BDC8217",
      "text": "Ah ah ah. Ti devo un favore![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_4kings_d_01_dragonbb_04",
      "hash64": "41969EA64BDC7CFE",
      "text": "Yo, futur[VAR 0x1100(00FF,0D0A)]o Campionea Campionessa![VAR 0x0114(004A)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
