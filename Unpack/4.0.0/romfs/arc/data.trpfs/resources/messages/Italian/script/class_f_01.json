          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_f_01_dragon_08",
      "hash64": "F80DD69BF3F4E607",
      "text": "Non c’è una risposta esatta.\\nLa cosa importante per me è che riflettiate.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_f_01_dragon_09",
      "hash64": "F80DD59BF3F4E454",
      "text": "Ad esempio, potremmo chiederci come mai\\npercepiamo come belli dei fiori sbocciati lungo\\r\\nuna strada.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_f_01_dragon_10",
      "hash64": "F80A489BF3F1BEE6",
      "text": "Potremmo farci delle domande sulla differenza\\ntra l’azzurro del cielo e l’azzurro del mare,\\r\\noppure sul mutare dei colori degli alberi.\\c\\nO ancora sul movimento del mulino a vento\\ndi Los Tazones, o sulla temperatura gelida\\r\\ndell’acqua di Garrafopoli.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 225,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 255,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_f_01_dragon_11",
      "hash64": "F80A499BF3F1C099",
      "text": "Riflettere ci permette di percepire in modo più\\nchiaro e profondo tutto ciò che ci circonda.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_f_01_dragon_12",
      "hash64": "F80A469BF3F1BB80",
      "text": "E così quando sarete stanchi per lo studio\\noppure oberati di lavoro...[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_f_01_dragon_13",
      "hash64": "F80A479BF3F1BD33",
      "text": "Forse queste riflessioni vi potranno dare\\nun piccolo sostegno.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_f_01_dragon_14",
      "hash64": "F80A4C9BF3F1C5B2",
      "text": "Sono discorsi forse non di immediata\\ncomprensione, ma non preoccupatevi.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_f_01_dragon_15",
      "hash64": "F80A4D9BF3F1C765",
      "text": "L’arte non è indispensabile alla vita umana,\\nma la rende molto più godibile![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_f_01_dragon_16",
      "hash64": "F80A4A9BF3F1C24C",
      "text": "Se riuscirò a regalare un minimo tocco di colore\\nalla vostra vita, potrò dirmi soddisfatto.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_f_01_dragon_17",
      "hash64": "F80A4B9BF3F1C3FF",
      "text": "Dalla prossima volta faremo esperienza\\npratica della bellezza. Fine![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    }
