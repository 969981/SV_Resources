    {
      "ordinal": 3,
      "label": "sdc02_4kings_b_01_clerk_03",
      "hash64": "6F0522D6EB09270F",
      "text": "Puoi partecipare alla Prova della Superquattro\\nin cambio di 50 PM! Ce li hai?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_b_01_clerk_04",
      "hash64": "6F051FD6EB0921F6",
      "text": "Com’è possibile? Non sembri avere abbastanza\\nPM... Però puoi ottenerli con le Ricreattività!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_b_01_system_01",
      "hash64": "876FD5B083B0E1A9",
      "text": "Hai inviato 50 PM!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_b_01_clerk_05",
      "hash64": "6F0520D6EB0923A9",
      "text": "Ricevuti, grazie mille!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
