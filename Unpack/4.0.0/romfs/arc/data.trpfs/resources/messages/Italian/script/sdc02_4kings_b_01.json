      "hash64": "6F0523D6EB0928C2",
      "text": "Se vuoi osservare i seguaci della Superquattro,\\nfai pure con comodo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
