      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "schoolmap_5_0",
      "hash64": "565E55BCA58C311E",
      "text": "L’area d’ingresso dell’Istituto Mirtillo, al centro della quale\\nè situata l’arena.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "schoolmap_5_1",
      "hash64": "565E56BCA58C32D1",
      "text": "Un’oasi sottomarina divisa in quattro settori tutti da\\nesplorare, creata per facilitare lo studio dei Pokémon.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "schoolmap_5_2",
      "hash64": "565E53BCA58C2DB8",
      "text": "L’aula della classe di Riben. Viene utilizzata anche come\\naula comune.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 54,
      "label": "schoolmap_5_3",
      "hash64": "565E54BCA58C2F6B",
      "text": "L’aula della classe di Rubra. La responsabile della classe è\\nla professoressa Rea.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "schoolmap_5_4",
      "hash64": "565E59BCA58C37EA",
      "text": "Qui si vende un po’ di tutto, da articoli di uso quotidiano\\na strumenti vari. Attenzione però: si accettano solo PM.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 56,
      "label": "schoolmap_5_5",
      "hash64": "565E5ABCA58C399D",
      "text": "Le porzioni dei piatti preparati dalla cuoca della mensa\\nsono molto abbondanti. La pancia piena è assicurata!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 57,
      "label": "schoolmap_5_6",
      "hash64": "565E57BCA58C3484",
      "text": "La tua stanza. Una camera tutta per te all’interno\\ndella scuola.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 58,
      "label": "schoolmap_5_7",
      "hash64": "565E58BCA58C3637",
      "text": "La stanza di Rubra. È piena di oggetti scelti con cura.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 59,
      "label": "schoolmap_5_8",
      "hash64": "565E4DBCA58C2386",
      "text": "La stanza di Riben. Contiene numerose prove\\ndel suo impegno e della sua costanza.",
      "flags": 0,
