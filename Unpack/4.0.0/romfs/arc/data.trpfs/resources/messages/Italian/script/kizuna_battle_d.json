      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_battle_d_select_01",
      "hash64": "81BF09B554170E22",
      "text": "Sì, voglio comprare qualcosa...",
      "flags": 0,
      "text_status": "DECODED",
