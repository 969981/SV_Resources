          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_mushi_010_receptionist_05",
      "hash64": "12BB235357DBC321",
      "text": "Per superare l’Esame della Palestra devi far\\nrotolare una palla a forma di oliva fino\\r\\nal traguardo.\\c\\nSe ci riesci, vedrai quante olive l’anno prossimo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
