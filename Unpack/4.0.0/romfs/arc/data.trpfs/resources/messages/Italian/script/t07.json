          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "t07_42",
      "hash64": "E7C3FEC3C3F4CA79",
      "text": "Una volta stavo vagando fuori città ed ero a\\ntanto così dal perdere i sensi...\\c\\nQuand’ecco che è spuntata fuori una ragazza\\ndel Centro Pokémon e mi ha salvato la pellaccia!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
