          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0040_headbb_04",
      "hash64": "91242DF43F80CA06",
      "text": "E non è finita...[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
