  "entries": [
    {
      "ordinal": 0,
      "label": "common_2090_staff_01",
      "hash64": "C4F4EF63999FC327",
      "text": "Vuoi iscriverti al grande torneo scolastico?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_2090_staff_02",
      "hash64": "C4F4F063999FC4DA",
      "text": "Allora... tu sei [VAR 0x0100(0000)], un[VAR 0x1100(00FF,0B0A)] Allenator’Allenatrice\\ndi Rango Campione, giusto?",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0B0A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2090_staff_03",
      "hash64": "C4F4F163999FC68D",
      "text": "Perfetto, adesso sei iscritt[VAR 0x1100(00FF,0101)]oa.\\nDirigiti pure verso il luogo dell’evento!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_012_announce_00",
      "hash64": "835D61A437E8925A",
      "text": "Signore e signori, benvenuti a questa nuova\\nedizione del grande torneo scolastico!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_012_announce_01",
      "hash64": "835D62A437E8940D",
      "text": "Procediamo senza indugi con la prima estrazione!\\nChi saranno i contendenti della prima lotta?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_012_announce_02",
      "hash64": "835D5FA437E88EF4",
      "text": "E ora, la seconda sfida! So che morite dalla\\nvoglia di sapere chi sono i prossimi contendenti,\\r\\nquindi bando alle ciance! Estrazione, prego!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_012_announce_03",
      "hash64": "835D60A437E890A7",
      "text": "Ed eccoci giunti alla terza sfida! Sono rimasti solo\\nquattro sfidanti! Estraiamo i nomi!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_012_announce_04",
      "hash64": "835D5DA437E88B8E",
      "text": "Siamo finalmente giunti alla sfida finale...\\c\\nEcco a voi i grandi talenti che si affronteranno\\nper stabilire chi è il più forte della scuola!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_012_announce_intro_00",
      "hash64": "97756563206B2279",
      "text": "[VAR 0x1100(00FF,0E0B)]Il CampioneLa Campionessa [VAR 0x0100(0000)] contro...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0E0B"
          ]
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_012_announce_intro_01",
      "hash64": "97756463206B20C6",
      "text": "Pepe della 2ª G, il cuoco dalla spezia facile!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_012_announce_intro_02",
      "hash64": "97756363206B1F13",
      "text": "Penny della 1ª D, l’hacker stellare!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_012_announce_intro_03",
      "hash64": "97756263206B1D60",
      "text": "Dendra, la sanguigna Docente di lotta!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_012_announce_intro_04",
      "hash64": "97756963206B2945",
      "text": "Thyma, la Docente di matematica, calcolatrice\\ndi vittorie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_012_announce_intro_05",
      "hash64": "97756863206B2792",
      "text": "Morasia, Docente di storia e investigatrice\\ndell’antichità!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_012_announce_intro_06",
      "hash64": "97756763206B25DF",
      "text": "Mimosa, l’angelica infermiera scolastica!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sub_012_announce_intro_07",
      "hash64": "97756663206B242C",
      "text": "Guaro, il casalingo dallo sguardo di ghiaccio,\\nDocente di economia domestica!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_012_announce_intro_08",
      "hash64": "97756D63206B3011",
      "text": "Zim, il benevolo Docente di biologia!",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sub_012_announce_intro_09",
      "hash64": "97756C63206B2E5E",
      "text": "Salvis, grande comunicatore e Docente\\ndi lingue!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sub_012_announce_intro_10",
      "hash64": "9771DF63206808F0",
      "text": "Nemi, Campionessa e fortissima rappresentante\\ndegli studenti!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sub_012_announce_intro_11",
      "hash64": "9771E06320680AA3",
      "text": "Clavel, il Preside dell’accademia dai modi\\ngarbati!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sub_012_announce_intro_12",
      "hash64": "9771E16320680C56",
      "text": "Oranzio, il drago ruggente, Docente\\ndi educazione artistica!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sub_012_announce_intro_13",
      "hash64": "9771E26320680E09",
      "text": "Alisma, amministratrice dell’accademia nonché\\nSupercampionessa!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sub_012_chara_01_01",
      "hash64": "EB3B7AECC59255DD",
      "text": "Ugh, [VAR 0x0100(0000)]! E va bene...\\nQuesta lotta sarà la mia occasione![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sub_012_chara_01_02",
      "hash64": "EB3B77ECC59250C4",
      "text": "Tsk! Maddai, si può essere più sfortunati?\\nProprio tu mi dovevi capitare come avversari[VAR 0x1100(00FF,0101)]oa...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sub_012_chara_02_01",
      "hash64": "9206BAD37E412F6A",
      "text": "Ah... Anche se sei tu, [VAR 0x0100(0000)], preparati\\na subire l’attacco dei miei piccoli Vivì![VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sub_012_chara_02_02",
      "hash64": "9206B9D37E412DB7",
      "text": "Sei proprio forte, [VAR 0x0100(0000)]...\\nPerò sono orgogliosa di te, in un certo senso.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sub_012_chara_03_01",
      "hash64": "E86C66DB19AABCDF",
      "text": "Ti sconfiggerò, novellin[VAR 0x1100(00FF,0101)]oa! Sarà una lotta tra titani![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sub_012_chara_03_02",
      "hash64": "E86C67DB19AABE92",
      "text": "Mi brucia, ma una sconfitta è una sconfitta!\\nTi auguro di vincere anche la prossima lotta![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sub_012_chara_04_01",
      "hash64": "1A117704D2E3CAC4",
      "text": "Chi si vede, [VAR 0x0100(0000)]!\\nChe sia una lotta tranquilla, mi raccomando.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sub_012_chara_04_02",
      "hash64": "1A117A04D2E3CFDD",
      "text": "Sarebbe stato bello affrontarti all’apice della mia\\ncarriera... Buona fortuna per la prossima sfida.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sub_012_chara_05_01",
      "hash64": "EF2663101BEF8699",
      "text": "Fammi un po’ decifrare i misteri della tua\\npotenza![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sub_012_chara_05_02",
      "hash64": "EF2660101BEF8180",
      "text": "I vinti devono lasciare spazio ai vincitori.\\nAscendi al trono che ti spetta di diritto.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sub_012_chara_06_01",
      "hash64": "95F1A2F6D49E6026",
      "text": "Dici che il modo in cui mi hanno presentata è\\nridicolo? Beh, magari li vedrai davvero, gli angeli![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sub_012_chara_06_02",
      "hash64": "95F1A1F6D49E5E73",
      "text": "Buona fortuna nella prossima lotta e tranquill[VAR 0x1100(00FF,0101)]oa:\\nse vi fate male ci penso io a curarvi![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sub_012_chara_07_01",
      "hash64": "C3ABAEFD377A0DBB",
      "text": "È meraviglioso avere te come avversari[VAR 0x1100(00FF,0101)]oa.\\nLascia che ti mostri di cosa sono capace![VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sub_012_chara_07_02",
      "hash64": "C3ABAFFD377A0F6E",
      "text": "La tua forza mi lascia senza parole. Non mi\\nstupisce che tu sia diventat[VAR 0x1100(00FF,0101)]oa Campione[VAR 0x1100(00FF,0300)]ssa![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0300"
          ]
        },
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sub_012_chara_08_01",
      "hash64": "34C79EA363FADA50",
      "text": "È un onore lottare contro di te,\\n[VAR 0x0100(0000)]. Vedrai, farò del mio meglio![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sub_012_chara_08_02",
      "hash64": "34C7A1A363FADF69",
      "text": "Bene bene, vai e vinci anche per me![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sub_012_chara_09_01",
      "hash64": "6061AAA9C5082185",
      "text": "Carissim[VAR 0x1100(00FF,0101)]oa [VAR 0x0100(0000)]!\\nIo sono qui, non scappo né mi nascondo![VAR 0x0114(0026)]",
