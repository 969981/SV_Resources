    },
    {
      "ordinal": 12,
      "label": "kizuna_language_c_06",
      "hash64": "19F3474A1E12C8D5",
      "text": "Never mind! Tranquillo, non importa![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
