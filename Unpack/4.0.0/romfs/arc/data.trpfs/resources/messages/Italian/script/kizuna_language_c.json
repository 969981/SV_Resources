    },
    {
      "ordinal": 11,
      "label": "kizuna_language_c_ecology_03",
      "hash64": "3D325B92640E99DB",
      "text": "Mi dispiace di non aver potuto essere d’aiuto...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
