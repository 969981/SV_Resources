    {
      "ordinal": 5,
      "label": "common_2140_top_03",
      "hash64": "9A17D76E1A2F55A4",
      "text": "Diligenza e costanza ci hanno portato ai vertici\\ndella nostra disciplina...[VAR 0x0114(0011)]",
