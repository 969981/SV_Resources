      "ordinal": 20,
      "label": "ajito_fairy_010_jentle_13",
      "hash64": "F2237C00C8F8AB5A",
      "text": "Magnifico, diamo il via alle danze.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
