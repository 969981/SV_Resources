          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "atlantis_talk_05_botan_01",
      "hash64": "83B6F385AE7EA1A3",
      "text": "È ancora rintanato nella sua Poké Ball.[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "atlantis_talk_05_rival_03",
      "hash64": "169E9E8064C85103",
      "text": "Ah, me n’ero scordata...[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "atlantis_talk_05_friend_01a",
      "hash64": "D0DB0588BEACC0F6",
      "text": "Il fatto che venga dal passato è una novità\\nanche per me.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "atlantis_talk_05_friend_01b",
      "hash64": "D0DB0488BEACBF43",
      "text": "Il fatto che venga dal futuro è una novità\\nanche per me.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "atlantis_talk_05_friend_02a",
      "hash64": "D0DEED88BEB08105",
      "text": "Mia mamma un giorno tornò improvvisamente\\na casa portandolo con sé.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "atlantis_talk_05_friend_02b",
      "hash64": "D0DEEA88BEB07BEC",
      "text": "Mio papà un giorno tornò improvvisamente\\na casa portandolo con sé.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "atlantis_talk_05_friend_03",
      "hash64": "6C5A0731BFB3E7B9",
      "text": "E per un breve periodo abbiamo vissuto tutti\\ninsieme nel laboratorio del faro.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "atlantis_talk_05_friend_04",
      "hash64": "6C5A0831BFB3E96C",
      "text": "Ho dovuto promettere di non dirlo a nessuno,\\ne per un po’ ho dovuto anche badare a lui.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "atlantis_talk_05_rival_04",
      "hash64": "169EA38064C85982",
      "text": "Ora si spiega perché sei così informato![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "atlantis_talk_05_friend_05",
      "hash64": "6C5A0931BFB3EB1F",
      "text": "Ma un giorno [VAR 0x0101(0001)] è impazzito\\ne ha attaccato un Pokémon selvatico.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "atlantis_talk_05_friend_06",
      "hash64": "6C5A0A31BFB3ECD2",
      "text": "Di conseguenza la gente della zona ha\\ncominciato a insospettirsi...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "atlantis_talk_05_friend_07a",
      "hash64": "D0EFE988BEBEED6C",
      "text": "E subito dopo mia mamma l’ha riportato\\nnell’Area Zero.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "atlantis_talk_05_friend_07b",
      "hash64": "D0EFEC88BEBEF285",
      "text": "E subito dopo mio papà l’ha riportato\\nnell’Area Zero.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "atlantis_talk_05_botan_05",
      "hash64": "83B6F785AE7EA86F",
      "text": "Non mi stupisce... D’altronde è un Pokémon\\ndi un’altra epoca.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "atlantis_talk_05_friend_08",
      "hash64": "6C5A0C31BFB3F038",
      "text": "Già. Se l’avessero scoperto sarebbe stato\\nun disastro.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "atlantis_talk_05_friend_09a",
      "hash64": "D0F5F588BEC36D7E",
      "text": "Da quel giorno non ho più visto né mia mamma\\nné Koraidon.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "atlantis_talk_05_friend_09b",
      "hash64": "D0F5F488BEC36BCB",
      "text": "Da quel giorno non ho più visto né mio papà\\nné Miraidon.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "atlantis_talk_05_friend_09",
      "hash64": "6C5A0D31BFB3F1EB",
      "text": "Ripensandoci ora mi rendo conto di quanto\\nsia stato infantile...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "atlantis_talk_05_friend_10",
      "hash64": "6C5D8A31BFB6FC29",
      "text": "Ma per molto tempo l’ho incolpato di avermi\\nportato via la famiglia.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "atlantis_talk_05_friend_11",
      "hash64": "6C5D8931BFB6FA76",
      "text": "La verità è che odiavo [VAR 0x0101(0001)] e non\\nmi andava di parlarne.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "atlantis_talk_05_friend_12",
      "hash64": "6C5D8831BFB6F8C3",
      "text": "Mi dispiace di non averti detto niente,\\n[VAR 0x0100(0000)].[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "atlantis_talk_05_rival_10",
      "hash64": "16A1A58064CA92BF",
      "text": "Avresti dovuto condividere subito\\ndelle informazioni così strabilianti![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "atlantis_talk_05_botan_06",
      "hash64": "83B6F885AE7EAA22",
      "text": "Prima che venissimo qui, perlomeno.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "atlantis_talk_05_friend_13",
      "hash64": "6C5D8731BFB6F710",
      "text": "Voi due siete impossibili...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
