          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0020_select_01",
      "hash64": "D05D8F35FD616BF2",
      "text": "Sì, lo conosco",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc01_0020_select_02",
      "hash64": "D05D8E35FD616A3F",
      "text": "No, mai sentito",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc01_0020_bbteacher_07",
      "hash64": "0821AE5AC6B63056",
      "text": "Beh, dopotutto è il libro sul paranormale più\\nfamoso del secolo.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0020_bbteacher_08",
      "hash64": "0821B95AC6B64307",
      "text": "Ah, no? Strano... Eppure sono certa che anche\\nquesta scuola abbia ricevuto delle copie.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0020_bbteacher_09",
      "hash64": "0821B85AC6B64154",
      "text": "Devi sapere che Callugaris, l’autore del libro,\\nè un mio antenato.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0020_bbteacher_10",
      "hash64": "081E2B5AC6B31BE6",
      "text": "E io sono in possesso del libro originale.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0020_bbteacher_11",
      "hash64": "081E2C5AC6B31D99",
      "text": "Ammira: nelle versioni stampate successivamente\\nqueste pagine sono praticamente illeggibili.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0020_bbteacher_12",
      "hash64": "081E295AC6B31880",
      "text": "Il nome del Pokémon raffigurato è [VAR 0xFF00(0006)]Terapagos[VAR 0xFF00(0000)].[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0020_bbteacher_13",
      "hash64": "081E2A5AC6B31A33",
      "text": "È un Pokémon avvolto nel mistero, che Callugaris\\nincontrò nei meandri più reconditi dell’Area\\r\\nZero... Anche se nessuno ci crede.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0020_bbteacher_14",
      "hash64": "081E2F5AC6B322B2",
      "text": "Il mio sogno è trovare Terapagos e provare\\na tutti che Callugaris aveva ragione.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0020_bbteacher_15",
      "hash64": "081E305AC6B32465",
      "text": "Peccato che non sia ancora riuscita a ottenere\\nl’autorizzazione per accedere all’Area Zero...[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0020_bbteacher_16",
      "hash64": "081E2D5AC6B31F4C",
      "text": "Ma poco male, per ora mi concentrerò su ciò\\nche posso fare.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0020_student1_01",
      "hash64": "A97DD108C793D8D8",
      "text": "Professoressa Rea, siamo pronti!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc01_0020_bbteacher_17",
