    {
      "ordinal": 5,
      "label": "sdc01_0000_ecology_03",
      "hash64": "5772AAE9CF9E0036",
      "text": "Ti chiamo a proposito di un viaggio di studio\\norganizzato dall’accademia ogni anno.\\c\\nSi svolge in questo periodo in collaborazione\\ncon un altro istituto.[VAR 0x0114(002A)]",
      "flags": 0,
