    {
      "ordinal": 10,
      "label": "common_0095_mama_12",
      "hash64": "E4EF55E37D0E0826",
      "text": "Insomma, oggi inizia la tua avventura lontano da\\ncasa! Ogni giorno avrà una nuova sorpresa...[VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
