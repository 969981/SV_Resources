    },
    {
      "ordinal": 9,
      "label": "common_2020_esper_020_esper_10",
      "hash64": "58CC1AD5E8052E98",
      "text": "Al primo fallimento si abbandonano\\nall’autodistruzione...\\c\\nE cadono così in basso che finiscono per essere\\nmolto più infelici delle persone comuni.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
