    },
    {
      "ordinal": 10,
      "label": "common_2020_esper_020_esper_11",
      "hash64": "58CC1BD5E805304B",
      "text": "Sarebbe stato molto meglio se non avessero\\navuto nemmeno quel mezzo talento, non credi?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
