    {
      "ordinal": 2,
      "label": "common_2020_esper_020_esper_03",
      "hash64": "58CF9DD5E8084308",
      "text": "Sai cosa ti dico? Sono davvero contenta...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
