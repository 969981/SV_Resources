    },
    {
      "ordinal": 17,
      "label": "class_c_03_history_answer_03",
      "hash64": "0CF29D46CA4E4249",
      "text": "... Esatto! Allora quell’aria concentrata non era\\nsolo una finta. Complimenti![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
