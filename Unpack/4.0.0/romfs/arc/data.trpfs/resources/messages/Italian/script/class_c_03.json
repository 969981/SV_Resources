          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_c_03_history_15a",
      "hash64": "E248B0BAC46C95EE",
      "text": "\"Se hai fame di sapere, mangiati un’arancia!\"[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
