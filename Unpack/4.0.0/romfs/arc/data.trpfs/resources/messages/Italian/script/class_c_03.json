          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_c_03_history_17",
      "hash64": "94BDEEC7582392A1",
      "text": "Oops... Mi sono dilungata un po’ troppo.\\nNon voglio trattenervi oltre la lezione...[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
