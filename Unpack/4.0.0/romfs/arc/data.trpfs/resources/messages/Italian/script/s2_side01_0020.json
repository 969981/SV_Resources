          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s2_side01_0020_friend_11",
      "hash64": "173F769E99300274",
      "text": "Nemi dovrebbe sul serio imparare a regolare\\nil volume della voce.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
