          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "s2_side01_0020_friend_12",
      "hash64": "173F799E9930078D",
      "text": "Meglio andare, prima che inizi a strillare\\ndi nuovo![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
