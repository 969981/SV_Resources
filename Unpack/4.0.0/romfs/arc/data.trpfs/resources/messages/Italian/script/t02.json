    {
      "ordinal": 18,
      "label": "t02_21",
      "hash64": "B8F48BABB6A8AA0B",
      "text": "Mi hanno raccontato che Pelipper trasporta\\nlettere e pacchi nel becco!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
