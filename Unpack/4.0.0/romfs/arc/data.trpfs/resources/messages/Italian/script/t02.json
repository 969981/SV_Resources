      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "t02_23",
      "hash64": "B8F48DABB6A8AD71",
      "text": "Stai andando a scuola? Fai attenzione per strada,\\ne ricordati di salvare spesso il gioco.",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
