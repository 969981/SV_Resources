    },
    {
      "ordinal": 38,
      "label": "team_0070_botan_06",
      "hash64": "29E67890A8C5E642",
      "text": "La persona che ha creato il Team Star, nonché\\nla causa di tutti i nostri mali...[VAR 0x0114(0008)]",
