    },
    {
      "ordinal": 39,
      "label": "team_0070_botan_07",
      "hash64": "29E67990A8C5E7F5",
      "text": "Se non lo sconfiggiamo, finirò per perdere\\nil mio tesoro...[VAR 0x0114(0008)]",
