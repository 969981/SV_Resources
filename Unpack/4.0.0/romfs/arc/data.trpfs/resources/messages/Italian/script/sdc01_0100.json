    {
      "ordinal": 10,
      "label": "sdc01_0100_sister_09",
      "hash64": "6ED1C1A3196FEB6B",
      "text": "La conversazione non è mai stata il suo forte.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
