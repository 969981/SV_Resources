      "ordinal": 18,
      "label": "ajito_doku_010_student_06",
      "hash64": "8FC7CD649BB09B51",
      "text": "Qui ci penso io, Recluta! Tu vai a svegliare\\ni tuoi amici!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "ajito_doku_010_sitappa_09",
      "hash64": "FE3FDEE5CC9BD0C3",
      "text": "Eh? E tu che c’entri?[VAR 0x0114(002F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
