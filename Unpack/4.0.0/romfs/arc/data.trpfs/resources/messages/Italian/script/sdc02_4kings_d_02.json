    {
      "ordinal": 17,
      "label": "sdc02_4kings_d_02_enemy_all_01",
      "hash64": "C7BA86F4AC3BE73F",
      "text": "　　　　　　　　　 Ohilà!\\nSalve, piacere!　　　　　　　　Ehi, ciao![VAR 0x0114(004D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
