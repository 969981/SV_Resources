      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sdc01_0430_gfather_03",
      "hash64": "7CE90E884A5AF7CE",
      "text": "A quanto pare mi sono sbagliato di grosso\\nriguardo agli abitanti del paese.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
