    {
      "ordinal": 3,
      "label": "sdc01_0430_sister_02",
      "hash64": "CBFF4ED8D0C2751E",
      "text": "Rirì! Si può sapere che intenzioni hai?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
