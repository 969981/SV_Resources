    },
    {
      "ordinal": 1,
      "label": "kizuna_head_a_02",
      "hash64": "9F3E5D33C6DE47C3",
      "text": "Si sta godendo appieno la sua ricerca di tesori?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
