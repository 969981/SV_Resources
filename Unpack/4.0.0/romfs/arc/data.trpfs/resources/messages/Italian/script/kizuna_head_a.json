          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_head_a_04",
      "hash64": "9F3E6333C6DE51F5",
      "text": "La ricerca di tesori non comporta obblighi\\ndi alcun tipo, si senta liber[VAR 0x1100(00FF,0101)]oa di fare ciò che\\r\\npiù le aggrada.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_head_a_05",
      "hash64": "9F3E6233C6DE5042",
      "text": "Ohibò, quasi me ne scordavo. Sa, di recente mi\\nè sorto un dubbio che non mi dà tregua...[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_head_a_06",
      "hash64": "9F3E6133C6DE4E8F",
      "text": "Vorrei approfittarne per chiedere la sua\\nopinione.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_head_a_07",
      "hash64": "9F3E6033C6DE4CDC",
      "text": "Riguarda quella che credo essere una delle\\nespressioni utilizzate da voi giovani...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_head_a_08",
      "hash64": "9F3E6733C6DE58C1",
      "text": "Saprebbe dirmi cosa caspiterina vorrebbe dire\\n\"chill\"?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_head_a_select_03",
      "hash64": "92AF84A599928CEF",
      "text": "Vuol dire \"rilassarsi\", o \"rilassante\"!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_head_a_select_04",
      "hash64": "92AF81A5999287D6",
      "text": "Si dice a qualcuno che è agitato!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_head_a_select_05",
      "hash64": "92AF82A599928989",
      "text": "Si dice quando si ha voglia di un gelato!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "kizuna_head_a_09a",
      "hash64": "755F18FAEBCE919D",
      "text": "Capisco! Quindi se volessi costruire una frase di\\nesempio, potrei dire: \"Oggi è la giornata ideale\\r\\nper passare un pomeriggio chill all’aperto\"?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_head_a_09b",
      "hash64": "755F15FAEBCE8C84",
      "text": "Credo di aver compreso. Deduco sia un termine\\ncon accezione negativa, utilizzato in situazioni\\r\\ndall’atmosfera tesa...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_head_a_09c",
      "hash64": "755F16FAEBCE8E37",
      "text": "Un gelato?! È dunque un termine correlato\\nal refrigerio offerto da tale dessert?\\c\\nAmmetto che senza di lei non sarei mai giunto\\nalla risposta...[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_head_a_10",
      "hash64": "9F3AD933C6DB31A0",
      "text": "Trovo il linguaggio giovanile difficile da\\ncomprendere, ma imparando a padroneggiarlo\\r\\nsento di potermi avvicinare ai miei cari studenti.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
