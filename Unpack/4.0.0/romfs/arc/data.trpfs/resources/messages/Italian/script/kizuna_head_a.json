          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_head_a_03b",
      "hash64": "753D1DFAEBB1B3B6",
      "text": "Oh cielo, mi rincresce sentirlo...[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
