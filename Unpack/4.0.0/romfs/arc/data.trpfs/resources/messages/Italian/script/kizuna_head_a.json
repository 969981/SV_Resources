      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_head_a_select_01",
      "hash64": "92AF86A599929055",
      "text": "Certo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_head_a_select_02",
      "hash64": "92AF83A599928B3C",
      "text": "Insomma...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_head_a_03a",
      "hash64": "753D1CFAEBB1B203",
      "text": "Sono lieto di sentirglielo dire![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
