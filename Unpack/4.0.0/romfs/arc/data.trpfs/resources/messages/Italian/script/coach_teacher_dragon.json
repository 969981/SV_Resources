      "hash64": "FAA7DBE6492B3173",
      "text": "Docente di arte!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_dragon_sp02_select_02",
      "hash64": "FAA7DCE6492B3326",
      "text": "Superquattro!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_dragon_sp02_02",
      "hash64": "ABAAE87B8608A82D",
      "text": "Ciò mi rassicura.\\c\\nQualche giorno fa ho avuto l’impressione che\\ngli studenti non accolgano di buon grado\\r\\nle mie lezioni d’arte.\\c\\nChe abbia frainteso?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
