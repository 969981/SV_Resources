      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_dragon_sp03_00",
      "hash64": "035710832287CAF6",
      "text": "Pare che gli studenti dell’istituto non solo\\ngestiscano in autonomia il consiglio studentesco,\\r\\nma addirittura partecipino all’amministrazione\\r\\ndella scuola![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
