      "label": "sdc01_0090_student1_01",
      "hash64": "6364CD10CA6CB763",
      "text": "Siamo quattro studenti dell’accademia e due\\ndell’Istituto Mirtillo.\\c\\nQuindi una coppia dovrà essere per forza\\nformata da due studenti di Paldea...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
