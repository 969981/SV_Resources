    },
    {
      "ordinal": 7,
      "label": "sdc01_0090_caretaker_02",
      "hash64": "B1C8AB68D090A16A",
      "text": "E voi vedete di aiutarli, chiaro?[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
