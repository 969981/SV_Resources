          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0090_caretaker_04",
      "hash64": "B1C8A568D0909738",
      "text": "Si tratta di una prova di... orientamento![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0090_caretaker_05",
      "hash64": "B1C8A668D09098EB",
      "text": "Dovrete formare gruppi di due e cercare\\n[VAR 0xFF00(0006)]tre cartelli[VAR 0xFF00(0000)] installati a Nordivia.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0090_caretaker_06",
      "hash64": "B1C8A768D0909A9E",
      "text": "Ogni cartello riporta un estratto di un racconto\\npopolare di questa zona. Il vostro compito è\\r\\nleggerli tutti per conoscere la nostra storia...[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0090_caretaker_07",
      "hash64": "B1C8A868D0909C51",
      "text": "... e poi farvi una foto insieme davanti al cartello\\ncon uno smartphone o una fotocamera.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0090_caretaker_08",
      "hash64": "B1C8A168D090906C",
      "text": "Una volta fatte le foto davanti a tutti e tre\\ni cartelli, la vostra missione sarà compiuta![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0090_caretaker_09",
      "hash64": "B1C8A268D090921F",
      "text": "Insomma, si tratta di un tour guidato da voi stessi\\nalla scoperta della storia di Nordivia![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0090_caretaker_10",
      "hash64": "B1CC2F68D093B78D",
      "text": "È molto più divertente così che stare a sentire\\ni miei racconti interminabili, no?[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
