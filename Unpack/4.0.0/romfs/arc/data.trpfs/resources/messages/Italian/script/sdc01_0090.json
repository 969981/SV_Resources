    {
      "ordinal": 9,
      "label": "sdc01_0090_brother_02",
      "hash64": "94B84A0498629184",
      "text": "Ah... ehm...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
