    {
      "ordinal": 23,
      "label": "sdc01_0090_bbteacher_05",
      "hash64": "12AE6B4198269FB1",
      "text": "Troppo... giusta?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
