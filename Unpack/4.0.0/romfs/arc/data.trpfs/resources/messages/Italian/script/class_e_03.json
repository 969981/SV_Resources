          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_e_03_battle_08",
      "hash64": "60E8469A515A8435",
      "text": "È facile lasciarsi prendere dallo sconforto!\\nPuò sembrare che la sconfitta sia inevitabile...[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_e_03_battle_09",
      "hash64": "60E8459A515A8282",
      "text": "Ma ora ho una domandina per voi![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_e_03_battle_10",
      "hash64": "60E4C89A51577844",
      "text": "Il Pokémon avversario inizia a utilizzare lo\\nscudo Teracristal. Voi come rispondete?[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_e_03_select_01",
      "hash64": "AB71E26C3F620374",
      "text": "Chiudo gli occhi e mi preparo al peggio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_e_03_select_02",
      "hash64": "AB71E56C3F62088D",
      "text": "Chiamo la mamma per chiederle aiuto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_e_03_select_03",
      "hash64": "AB71E46C3F6206DA",
      "text": "Attacco con la teracristallizzazione!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_e_03_battle_answer_01",
      "hash64": "956C446586DBA4F3",
      "text": "Come?! Ma no, non ammettere la sconfitta così\\nfacilmente! Non bisogna arrendersi mai... Anzi,\\r\\nsi deve continuare a lottare con tutte le forze![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_e_03_battle_answer_02",
      "hash64": "956C456586DBA6A6",
      "text": "Come?! Ma no, non esageriamo, suvvia!\\nNon bisogna arrendersi mai... Anzi, si deve\\r\\ncontinuare a lottare con tutte le forze![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_e_03_battle_answer_03",
      "hash64": "956C466586DBA859",
      "text": "Brav[VAR 0x1100(00FF,0101)]oa, novellin[VAR 0x1100(00FF,0101)]oa! Risposta esatta! Vedo che i Raid\\nTeracristal non sono più un mistero per te, eh?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
