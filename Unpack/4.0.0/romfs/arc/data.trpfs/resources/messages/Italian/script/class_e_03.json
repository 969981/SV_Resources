      ]
    },
    {
      "ordinal": 5,
      "label": "class_e_03_battle_06",
      "hash64": "60E8489A515A879B",
      "text": "Riceverà molti meno danni![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
