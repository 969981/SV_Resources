    {
      "ordinal": 21,
      "label": "class_e_03_battle_16",
      "hash64": "60E4C69A515774DE",
      "text": "Occhio per occhio, dente per dente... e\\nTeracristal per Teracristal![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
