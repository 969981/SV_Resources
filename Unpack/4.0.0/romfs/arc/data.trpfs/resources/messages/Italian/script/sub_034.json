    {
      "ordinal": 3,
      "label": "sub_034_select_01",
      "hash64": "CEC57F51382C7B18",
      "text": "Ho vinto!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_034_select_02",
      "hash64": "CEC58251382C8031",
      "text": "È stata dura!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_034_ecology_03",
      "hash64": "AE533CC3090DFE1E",
      "text": "Coooosa?! Ma quindi l’hai affrontato?!?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
