    {
      "ordinal": 0,
      "label": "ajito_doku_040_dokuboss_00",
      "hash64": "7EE9C25EC927EBA9",
      "text": "Sono mortificato... Perdonatemi.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
