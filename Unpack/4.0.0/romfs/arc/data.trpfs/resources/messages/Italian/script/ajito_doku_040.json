          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_doku_040_system_01",
      "hash64": "F1B3A41EED808681",
      "text": "Un anno e qualche mese prima...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "ajito_doku_040_dokuboss_01",
      "hash64": "7EE9C15EC927E9F6",
      "text": "Perdonatemi...\\nHo tardato a procurarmi le stoffe, ahimè...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_doku_040_honooboss_01",
      "hash64": "3FEE639A2D55390C",
      "text": "Pazzeschi... Questi stivali sono veramente\\npazzeschi...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_doku_040_dokuboss_02",
      "hash64": "7EE9C05EC927E843",
      "text": "Per realizzarli, d’ispirazione mi fu la mossa\\nNitrocarica...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_doku_040_kakutouboss_01",
      "hash64": "4918872BA1141559",
      "text": "La mia uniforme è proprio come la volevo!\\nGrazie mille![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_doku_040_dokuboss_03",
      "hash64": "7EE9BF5EC927E690",
      "text": "Sono lieto di aver realizzato l’idea di \"pop star\\ninfernale\" che desideravi, nobile Nespera.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "ajito_doku_040_akuboss_01",
      "hash64": "36523EDB08117B0C",
      "text": "Con questo, abbiamo rinnovato tutte le uniformi.\\nGrazie, Henzo.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_doku_040_akuboss_02",
      "hash64": "365241DB08118025",
      "text": "Ora anche voi sembrate delle vere dure.\\nNessuno vi mancherà di rispetto.[VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_doku_040_fairyboss_01",
      "hash64": "0E1DF61F5DCB6AEA",
      "text": "Certo che sei bravissimo![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_doku_040_fairyboss_02",
      "hash64": "0E1DF51F5DCB6937",
      "text": "Quelli che ti prendono in giro solo perché sei\\nun otaku non capiscono niente, Henzo.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_doku_040_dokuboss_04",
      "hash64": "7EE9C65EC927F275",
      "text": "La via dell’otaku è aspra e irta di spine.\\nNon mi aspetto comprensione dalla plebaglia.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_doku_040_honooboss_02",
      "hash64": "3FEE669A2D553E25",
      "text": "Oooh, attenzione! Parole di fuoco, eh, Henzo?[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_doku_040_kakutouboss_02",
      "hash64": "4918842BA1141040",
      "text": "Secondo me sei veramente un grande.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "ajito_doku_040_akuboss_03",
      "hash64": "365240DB08117E72",
      "text": "Beh, adesso non ci resta che allenarci nelle lotte\\nper prepararci all’Operazione Star.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "ajito_doku_040_akuboss_04",
      "hash64": "36523BDB081175F3",
      "text": "Noi siamo i capibanda, non possiamo sfigurare\\ndi fronte agli altri membri del team.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "ajito_doku_040_dokuboss_05",
      "hash64": "7EE9C55EC927F0C2",
      "text": "E sia... Dedicherò anima e corpo\\nall’addestramento...![VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_doku_040_dokuboss_06",
      "hash64": "7EE9C45EC927EF0F",
      "text": "Ho dedicato anima e corpo al team, ma le regole\\nmi impongono di non opporre resistenza...[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_doku_040_dokuboss_07",
      "hash64": "7EE9C35EC927ED5C",
      "text": "E le regole sono sacre...[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "ajito_doku_040_dokuboss_08",
      "hash64": "7EE9CA5EC927F941",
      "text": "Pertanto... credo di poterti affidare questa.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_doku_040_waza_01",
      "hash64": "D28430A2470ED9B9",
      "text": "Ti conferisco anche questo marchingegno in cui\\nè preservata una mossa che ti permetterà di\\r\\nspargere sudiciume.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_doku_040_dokuboss_09",
      "hash64": "7EE9C95EC927F78E",
      "text": "Il tuo nome è [VAR 0x0100(0000)], se non erro.[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "ajito_doku_040_dokuboss_10",
      "hash64": "7EE63C5EC924D220",
      "text": "La mia disfatta è così evidente che non lascia\\nspazio a rancore o amarezza...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "ajito_doku_040_student_01",
      "hash64": "E6637BEF86A2512B",
      "text": "Nobile Henzo!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "ajito_doku_040_dokuboss_11",
      "hash64": "7EE63D5EC924D3D3",
      "text": "A-Amico mio?[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "ajito_doku_040_nelke_01",
      "hash64": "BD2F1C2F0598E27F",
      "text": "Voleva assolutamente vederti e parlare con te.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "ajito_doku_040_student_02",
      "hash64": "E6637CEF86A252DE",
      "text": "Nobile Henzo, ascoltami anche solo\\nper un istante!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "ajito_doku_040_dokuboss_12",
      "hash64": "7EE63E5EC924D586",
      "text": "[EMPTY 61]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "003D"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "ajito_doku_040_nelke_02",
      "hash64": "BD2F1D2F0598E432",
      "text": "[EMPTY 61]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "003D"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "ajito_doku_040_dokuboss_13",
      "hash64": "7EE63F5EC924D739",
      "text": "... Cosa ti porta qui da me?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "ajito_doku_040_student_03",
      "hash64": "E6637DEF86A25491",
      "text": "Sono venuto per il tuo bene!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "ajito_doku_040_student_04",
      "hash64": "E6637EEF86A25644",
      "text": "Se continui a non presentarti a scuola\\nti espelleranno, lo sai...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "ajito_doku_040_dokuboss_14",
      "hash64": "7EE6405EC924D8EC",
      "text": "...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_doku_040_student_05",
      "hash64": "E6637FEF86A257F7",
      "text": "Noi che eravamo presi di mira dai bulli ora\\npossiamo andare a scuola senza problemi...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "ajito_doku_040_student_06",
      "hash64": "E66380EF86A259AA",
      "text": "Ed è solo grazie all’impegno del Team Star\\nche ha condotto quell’operazione!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "ajito_doku_040_student_07",
      "hash64": "E66381EF86A25B5D",
      "text": "Non voglio che persone come voi vengano\\nespulse dalla scuola!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "ajito_doku_040_dokuboss_15",
      "hash64": "7EE6415EC924DA9F",
      "text": "... Perdonami.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "ajito_doku_040_student_08",
      "hash64": "E66372EF86A241E0",
      "text": "Non siete ancora riusciti a contattare l’Arcicapo?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "ajito_doku_040_dokuboss_16",
      "hash64": "7EE6425EC924DC52",
      "text": "No, non ne abbiamo notizia da quel giorno...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "ajito_doku_040_dokuboss_17",
      "hash64": "7EE6435EC924DE05",
      "text": "Senza l’Arcicapo, non esiste il team...\\c\\nE senza il team, non può esservi gioia nella vita\\nscolastica![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
