        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_f_06_dragon_06",
      "hash64": "F720445829541104",
      "text": "Conoscete le dieci meraviglie di Paldea?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
