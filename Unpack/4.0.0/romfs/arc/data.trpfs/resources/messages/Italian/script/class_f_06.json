      "ordinal": 27,
      "label": "class_f_06_dragon_22",
      "hash64": "F7193858294DDDF2",
      "text": "Non vi sto dicendo di non andarci, solo di non\\navere aspettative troppo alte.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
