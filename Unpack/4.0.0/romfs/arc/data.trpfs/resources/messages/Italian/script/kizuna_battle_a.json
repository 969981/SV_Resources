        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_battle_a_03b",
      "hash64": "BE0453237F1A51F2",
      "text": "Ah, scusa! Non volevo essere invadente...\\nIn effetti, l’allenamento è una cosa privata.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_battle_a_04",
      "hash64": "23D034958FE33771",
      "text": "In ogni caso, ti propongo una bella corsetta per\\nil campo sportivo![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
