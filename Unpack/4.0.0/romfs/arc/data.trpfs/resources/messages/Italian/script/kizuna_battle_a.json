          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_battle_a_system_02",
      "hash64": "5CE62AAF22FB90EB",
      "text": "Il panino della professoressa Dendra è troppo\\nasciutto e ha un odore pungente.\\r\\nPer di più non sa di molto...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_battle_a_10",
      "hash64": "23CD32958FE0FE34",
      "text": "Allora, com’era? Ti è piaciuto il mio panino?[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
