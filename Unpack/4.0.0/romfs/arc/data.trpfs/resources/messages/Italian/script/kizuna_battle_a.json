        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_battle_a_05",
      "hash64": "23D033958FE335BE",
      "text": "Pronti, partenza... Via![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
