    },
    {
      "ordinal": 13,
      "label": "kizuna_battle_a_select_01",
      "hash64": "16F8CA5379943209",
      "text": "Sì, buono...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "kizuna_battle_a_select_02",
      "hash64": "16F8C75379942CF0",
      "text": "Beh, a essere sincer[VAR 0x1100(00FF,0101)]oa...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 3,
