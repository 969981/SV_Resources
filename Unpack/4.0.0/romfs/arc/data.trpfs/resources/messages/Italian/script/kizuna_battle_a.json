    },
    {
      "ordinal": 6,
      "label": "kizuna_battle_a_system_01",
      "hash64": "5CE62BAF22FB929E",
      "text": "Hai fatto tre giri del campo sportivo assieme\\nalla professoressa Dendra.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_battle_a_06",
      "hash64": "23D032958FE3340B",
      "text": "Fiuu! Che bella sudata![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
