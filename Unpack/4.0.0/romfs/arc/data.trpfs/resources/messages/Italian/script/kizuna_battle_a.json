          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_battle_a_11",
      "hash64": "23CD33958FE0FFE7",
      "text": "Ah, scusa! Non volevo metterti in difficoltà.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
