  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_043_student_f_01",
      "hash64": "4B26BF5C7600182C",
      "text": "Ciao! Se intrecci dei Rami Galarnoce sai cosa\\nci puoi fare? Eh? Lo sai?\\c\\nDegli accessori!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_sub_043_student_f_02",
      "hash64": "4B26C25C76001D45",
      "text": "Se mi porti dei Rami Galarnoce, posso farti\\nuna Fascia Galarnoce o una Corona Galarnoce!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_043_select_01",
      "hash64": "DF5476E50DC8F73E",
      "text": "Vorrei una Fascia Galarnoce!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_043_select_02",
      "hash64": "DF5475E50DC8F58B",
      "text": "Vorrei una Corona Galarnoce!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_043_select_03",
      "hash64": "DF5474E50DC8F3D8",
      "text": "Magari un’altra volta...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_043_student_f_03",
      "hash64": "4B26C15C76001B92",
      "text": "Adesso non ti serve, eh? Ok, allora alla prossima!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_043_student_f_04",
      "hash64": "4B26BC5C76001313",
      "text": "Per fare una Fascia Galarnoce mi servono\\n8 Rami Galarnoce. Hai quel che serve, no?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_043_student_f_05",
      "hash64": "4B26BB5C76001160",
      "text": "Per fare una Corona Galarnoce mi servono\\n15 Rami Galarnoce. Hai quel che serve, no?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_043_student_f_06",
      "hash64": "4B26BE5C76001679",
      "text": "Non hai abbastanza Rami Galarnoce!\\nRaccogline un po’ in giro per il Settore Costa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s2_sub_043_student_f_07",
      "hash64": "4B26BD5C760014C6",
      "text": "Perfetto! Lascia fare a me!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_043_student_f_08",
      "hash64": "4B26C85C76002777",
      "text": "Intreccia di qua...\\nIntreccia di là...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_043_student_f_09",
      "hash64": "4B26C75C760025C4",
      "text": "Ecco fatto! Intrecciata di fresco solo per te!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_043_student_f_10",
      "hash64": "4B233A5C75FD0056",
      "text": "Prova a farla indossare a uno Slowpoke di Galar!\\nVedrai che amore!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
