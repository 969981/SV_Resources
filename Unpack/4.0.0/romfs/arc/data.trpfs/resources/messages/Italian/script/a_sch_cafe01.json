      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "a_sch_cafe01_eve19",
      "hash64": "1B919530F6E77D7F",
      "text": "In altre regioni va di moda il riso al curry, a quel\\nche sembra... Tu l’hai mai assaggiato?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
