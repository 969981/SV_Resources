      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_038_man_07",
      "hash64": "04DCA9FBE2125A02",
      "text": "La luce, eh? Mmh... No! Non ci siamo proprio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_038_man_08",
      "hash64": "04DCACFBE2125F1B",
      "text": "Ah! Il vento?! Non è male! Anzi, ti dirò,\\nmi piace...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s2_sub_038_man_09",
      "hash64": "04DCABFBE2125D68",
      "text": "Le tenebre... Sì, le mie amate tenebre. Laddove\\nil mio cuore oscuro s’inaridisce sempre più...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s2_sub_038_man_10",
      "hash64": "04D93EFBE20F6E5A",
      "text": "Come boh?! Vedi di rifletterci meglio, su!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "s2_sub_038_man_11",
      "hash64": "04D93FFBE20F700D",
      "text": "Dimmi.... senti anche tu quel fremito... quel\\nmaledetto fremito della mano?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s2_sub_038_select_06",
      "hash64": "2C3000979E4B3379",
      "text": "La mano destra?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s2_sub_038_select_07",
      "hash64": "2C2FFF979E4B31C6",
      "text": "La mano sinistra?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "s2_sub_038_man_12",
      "hash64": "04D93CFBE20F6AF4",
      "text": "Destra...? Oh, scusa. Devo aver fatto un tragico\\nerrore di valutazione...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s2_sub_038_man_13",
      "hash64": "04D93DFBE20F6CA7",
      "text": "Sì! Esatto! La mano sinistra! Sei proprio come\\nme... Un[VAR 0x1100(00FF,0100)]a mi[VAR 0x1100(00FF,0101)]oa simile, finalmente!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
