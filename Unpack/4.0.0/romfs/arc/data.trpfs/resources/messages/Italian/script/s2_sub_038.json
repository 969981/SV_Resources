      "ordinal": 0,
      "label": "s2_sub_038_man_01",
      "hash64": "04DCA3FBE2124FD0",
      "text": "NO! Non ti avvicinare! Io... Io sono un immenso\\npericolo...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_038_man_02",
      "hash64": "04DCA6FBE21254E9",
      "text": "Ignora la mia esistenza... Fammi questo favore...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
