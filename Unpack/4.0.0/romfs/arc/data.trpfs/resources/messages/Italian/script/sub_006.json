          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sub_006_trainer_20",
      "hash64": "B98B4C6E5772D01D",
      "text": "Complimenti! Hai completato per la prima volta\\nla Pista Purogelo! Ormai sei un[VAR 0x1100(00FF,0908)] maestroa maestra dello\\r\\nslalom! Ti meriti un premio!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
