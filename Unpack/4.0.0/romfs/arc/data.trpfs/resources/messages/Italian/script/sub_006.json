  "entries": [
    {
      "ordinal": 0,
      "label": "sub_006_trainer_01",
      "hash64": "B992376E5778CB1C",
      "text": "A quanto pare hai battuto Grusha!\\nCongratulazioni per la tua medaglia!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_006_trainer_02",
      "hash64": "B9923A6E5778D035",
      "text": "Anche se hai già superato l’Esame della Palestra,\\npuoi scivolare sulla neve della Sierra Napada\\r\\ntutte le volte che vuoi!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_006_trainer_03",
      "hash64": "B992396E5778CE82",
      "text": "Vuoi cimentarti in uno slalom?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_006_trainer_04",
      "hash64": "B992346E5778C603",
      "text": "Quale pista ti va di provare?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_006_trainer_05",
      "hash64": "B992336E5778C450",
      "text": "Scegli la Pista Polneve? Ok! Goditi questa bella\\ndiscesa in tranquillità!",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_006_trainer_06",
      "hash64": "B992366E5778C969",
      "text": "Scegli la Pista Bora? Ok! Fammi vedere cosa sai\\nfare!",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_006_trainer_07",
      "hash64": "B992356E5778C7B6",
      "text": "Scegli la Pista Purogelo? Ok! Preparati a una\\nsciata estrema!",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_006_trainer_08",
      "hash64": "B992406E5778DA67",
      "text": "Sali in groppa a un Pokémon per scivolare\\nlungo un percorso immerso nella natura\\r\\ndella Sierra Napada! Semplice, no?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_006_trainer_09",
      "hash64": "B9923F6E5778D8B4",
      "text": "Potrai scegliere tra tre piste. Se raggiungerai\\nil traguardo entro un certo tempo vincerai\\r\\nun piccolo premio.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_006_trainer_10",
      "hash64": "B98EB26E5775B346",
      "text": "Metticela tutta e cerca sempre di migliorare\\nil tuo record personale!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
