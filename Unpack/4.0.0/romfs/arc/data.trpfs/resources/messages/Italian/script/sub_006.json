    {
      "ordinal": 15,
      "label": "sub_006_trainer_16",
      "hash64": "B98EB46E5775B6AC",
      "text": "Oh? Non hai ancora mai finito la Pista Bora...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_006_trainer_17",
      "hash64": "B98EB56E5775B85F",
