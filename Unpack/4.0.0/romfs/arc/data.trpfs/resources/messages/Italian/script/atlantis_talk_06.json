    },
    {
      "ordinal": 6,
      "label": "atlantis_talk_06_friend_01",
      "hash64": "10E89254D8D7EFAE",
      "text": "Mmh, non direi... Sembra parecchio impaurito.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
