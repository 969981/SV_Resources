    {
      "ordinal": 2,
      "label": "atlantis_talk_06_botan_01",
      "hash64": "DBB816BCF28A672C",
      "text": "Così pare.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
