    },
    {
      "ordinal": 16,
      "label": "atlantis_talk_06_friend_04",
      "hash64": "10E89754D8D7F82D",
      "text": "Quindi vuoi dire che è stato ferito qui\\nnell’Area Zero, come Mabosstiff?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "atlantis_talk_06_botan_08",
      "hash64": "DBB81FBCF28A7677",
      "text": "Non ne sono sicura... Però non può più neanche\\nassumere la Forma Lotta, giusto?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
