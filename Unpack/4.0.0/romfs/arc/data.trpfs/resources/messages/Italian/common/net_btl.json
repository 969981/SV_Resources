      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 77,
      "label": "msg_ui_netbtl_message_31",
      "hash64": "1FF8905810880386",
      "text": "Comunicazione delle regole in corso.\\nAttendi...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 78,
      "label": "msg_ui_netbtl_message_32",
      "hash64": "1FF88F58108801D3",
      "text": "Si è verificato un problema con i dati delle\\nregole inviati. Scegli nuovamente le regole\\r\\ndella lotta.\\c",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
