          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0060_fairybb_09",
      "hash64": "826FC83D939058D8",
      "text": "Infine, laggiù in fondo, abbiamo\\nil Settore Ghiacciai, con clima polare.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
