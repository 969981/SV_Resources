      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sdc02_0060_fairybb_13",
      "hash64": "826C5A3D938D6817",
      "text": "In effetti è un ambiente molto ordinario.\\c\\nNon c’è nulla che ostacoli lo sguardo, quindi\\nè una zona perfetta per osservare i Pokémon\\r\\nnel loro habitat![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
