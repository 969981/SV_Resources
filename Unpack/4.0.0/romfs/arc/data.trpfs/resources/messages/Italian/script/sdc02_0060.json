      "ordinal": 12,
      "label": "sdc02_0060_headbb_02",
      "hash64": "A14519385BCF1CAE",
      "text": "Siamo stati meticolosissimi![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
