          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0060_fairybb_14",
      "hash64": "826C573D938D62FE",
      "text": "Eheh, vedo che siamo in sintonia.\\c\\nÈ quello che piace di più anche a me!\\nHa un’atmosfera che trasmette serenità![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
