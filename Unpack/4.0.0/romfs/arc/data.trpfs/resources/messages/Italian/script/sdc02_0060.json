          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0060_fairybb_10",
      "hash64": "826C5B3D938D69CA",
      "text": "La temperatura e l’umidità vengono regolate\\ncon precisione per ciascun settore.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
