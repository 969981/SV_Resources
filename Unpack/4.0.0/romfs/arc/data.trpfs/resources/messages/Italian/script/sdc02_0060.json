          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc02_0060_headbb_04",
      "hash64": "A1451B385BCF2014",
      "text": "Dunque, il motivo è presto detto...\\nGuardate il soffitto![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc02_0060_headbb_05",
      "hash64": "A1451C385BCF21C7",
      "text": "Quello che vedete è il [VAR 0xFF00(0006)]Nucleo del Bioterarium[VAR 0xFF00(0000)],\\nil fulcro dell’intera struttura.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
