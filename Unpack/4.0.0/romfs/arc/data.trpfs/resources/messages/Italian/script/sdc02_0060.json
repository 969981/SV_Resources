        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0060_fairybb_18",
      "hash64": "826C533D938D5C32",
      "text": "Ebbene, Preside Bluebert...[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
