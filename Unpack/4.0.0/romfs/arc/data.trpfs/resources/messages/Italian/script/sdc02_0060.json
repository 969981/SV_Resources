          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0060_fairybb_15",
      "hash64": "826C583D938D64B1",
      "text": "Ti piacciono i terreni aspri e irregolari, eh?\\c\\nIn quella zona si trova anche un minerale\\nmisterioso chiamato pietrelettrica![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0060_fairybb_16",
      "hash64": "826C553D938D5F98",
      "text": "Hai una predilezione per i posti freddi, vedo!\\c\\nA dirla tutta io preferisco evitarli, ma i Pokémon\\ndi tipo Ghiaccio sono molto carini![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0060_fairybb_17",
      "hash64": "826C563D938D614B",
      "text": "Ad ogni modo, quando hai bisogno di rimettere\\nin sesto i tuoi Pokémon, puoi usare liberamente\\r\\ni [VAR 0xFF00(0006)]dispositivi di cura automatici[VAR 0xFF00(0000)] installati all’interno\\r\\ndel Bioterarium.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
