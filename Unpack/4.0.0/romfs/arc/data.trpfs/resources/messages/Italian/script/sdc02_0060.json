          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0060_fairybb_19",
      "hash64": "826C543D938D5DE5",
      "text": "Può spiegarci come mai all’Istituto Mirtillo capita\\nche i Pokémon selvatici si teracristallizzino\\r\\no che si formino cristalli?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
