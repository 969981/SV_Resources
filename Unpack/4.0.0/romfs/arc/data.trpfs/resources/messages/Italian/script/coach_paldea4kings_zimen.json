        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_paldea4kings_zimen_sp01_00",
      "hash64": "743CA50901C57281",
      "text": "Nun me l’aspettavo ’sta chiamata tua, nì.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
