      ]
    },
    {
      "ordinal": 3,
      "label": "coach_paldea4kings_zimen_sp01_01",
      "hash64": "743CA40901C570CE",
      "text": "Dì ’a verità, c’avevi voja de rivedè a Capsi\\ntua, vè?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_paldea4kings_zimen_sp01_select_01",
      "hash64": "D4717B8263D1451D",
      "text": "Eh sì!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_paldea4kings_zimen_sp01_select_02",
      "hash64": "D471788263D14004",
      "text": "Mmmh... Beh, insomma...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea4kings_zimen_sp01_03",
      "hash64": "743CA20901C56D68",
      "text": "Brav[VAR 0x1100(00FF,0101)]oa, così me piaci! Onest[VAR 0x1100(00FF,0101)]oa, sincer[VAR 0x1100(00FF,0101)]oa.\\nPòi fa finta de no quanto te pare, ma sotto sotto\\r\\nlo so che sei ’n amore![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
