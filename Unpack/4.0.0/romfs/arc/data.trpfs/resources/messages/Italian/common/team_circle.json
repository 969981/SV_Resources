      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "team_circle_win_01_02",
      "hash64": "9A76A5A7D67681E5",
      "text": "Quando inizi a giocare con gli amici\\nin una Cerchia contatto vi ritroverete\\r\\npresso un Centro Pokémon.\\c\\nSe si verifica un errore di connessione mentre\\ngiochi con i tuoi amici della Cerchia contatto,\\r\\nuscirai automaticamente dalla cerchia.\\c\\nSe si disconnette il giocatore che ha creato\\nla cerchia, questa verrà sciolta.\\c\\nSi consiglia di giocare in un ambiente provvisto\\ndi una connessione stabile.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
