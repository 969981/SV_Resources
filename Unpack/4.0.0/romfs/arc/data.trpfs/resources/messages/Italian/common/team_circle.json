    {
      "ordinal": 38,
      "label": "team_circle_win_01_00",
      "hash64": "9A76A3A7D6767E7F",
      "text": "Vuoi usare la Cerchia contatto per partire\\nall’avventura insieme ai tuoi amici?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
