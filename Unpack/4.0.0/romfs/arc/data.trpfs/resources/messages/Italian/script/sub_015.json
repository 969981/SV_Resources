      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_015_system_release_04",
      "hash64": "2F717BEB248457F7",
      "text": "Chieeeen!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_015_system_release_05",
      "hash64": "2F717AEB24845644",
      "text": "Chien-Pao è stato nuovamente sigillato\\nnel santuario!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_015_system_release_06",
      "hash64": "2F717DEB24845B5D",
      "text": "Sembra che le porte del santuario non si\\napriranno per un po’.",
      "flags": 0,
      "text_status": "DECODED",
