    {
      "ordinal": 0,
      "label": "sub_015_system_kui_01",
      "hash64": "CBD71E33F4417D1E",
      "text": "Conficcato nel terreno c’è un paletto nero\\ndall’aria sinistra...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_015_system_kui_02",
      "hash64": "CBD71D33F4417B6B",
      "text": "Vuoi estrarre il paletto?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_015_system_kui_03",
      "hash64": "CBD71C33F44179B8",
      "text": "Appena l’hai estratto, il paletto si è\\nsgretolato ed è scomparso!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_015_system_kui_04",
      "hash64": "CBD72333F441859D",
      "text": "Paooo...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_015_system_kui_05",
      "hash64": "CBD72233F44183EA",
      "text": "Si è sentito uno strano verso provenire dal\\nsantuario...!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_015_system_release_01",
      "hash64": "2F7176EB24844F78",
      "text": "Dal santuario proviene un debole suono...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_015_system_release_02",
      "hash64": "2F7179EB24845491",
      "text": "Vuoi toccare il santuario?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_015_system_release_03",
      "hash64": "2F7178EB248452DE",
      "text": "Rattle rattle...\\nRATTLE RATTLE RATTLE RATTLE...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
