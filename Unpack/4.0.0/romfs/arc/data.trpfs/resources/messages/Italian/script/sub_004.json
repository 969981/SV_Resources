    {
      "ordinal": 2,
      "label": "sub_004_01",
      "hash64": "93AEF6B5DB5A8D28",
      "text": "Complimenti per aver sconfitto Aceria,\\nla Capopalestra di Moldulcia!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_004_02",
      "hash64": "93AEF9B5DB5A9241",
      "text": "Ora che hai ottenuto la medaglia di Aceria potrai\\nmetterti alla prova in una versione speciale della\\r\\nruzzolata dell’oliva!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_004_03",
      "hash64": "93AEF8B5DB5A908E",
      "text": "La differenza con le altre sta nel fatto che\\ni tuoi progressi verranno cronometrati.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_004_04",
      "hash64": "93AEFBB5DB5A95A7",
      "text": "Se riuscirai a completare la prova in tempi\\nrecord riceverai un fantastico regalo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_004_05",
      "hash64": "93AEFAB5DB5A93F4",
      "text": "Vuoi cimentarti nella ruzzolata dell’oliva\\nspeciale?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_004_chose_1",
      "hash64": "4FB821B325D7CD5D",
      "text": "Ruzzolata sia!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_004_chose_2",
      "hash64": "4FB81EB325D7C844",
      "text": "Qual è il mio tempo migliore?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_004_chose_3",
      "hash64": "4FB81FB325D7C9F7",
      "text": "Non ora",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_004_chose_1_after",
      "hash64": "2A420F8B49E0B7AC",
      "text": "Perfetto! Mi raccomando: mentre fai rotolare\\nl’oliva, desidera ardentemente un buon raccolto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_004_chose_2_after",
      "hash64": "7E610F0AB9D13AA5",
      "text": "Il tuo tempo migliore è [VAR 0x0201(0001)]:[VAR 0x0201(0002)]:[VAR 0x0201(0003)].",
