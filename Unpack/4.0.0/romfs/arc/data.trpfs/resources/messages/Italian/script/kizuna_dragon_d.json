      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_dragon_d_21",
      "hash64": "2EF41B88739EC9DA",
      "text": "Bene! D’ora in avanti, il sottoscritto...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
