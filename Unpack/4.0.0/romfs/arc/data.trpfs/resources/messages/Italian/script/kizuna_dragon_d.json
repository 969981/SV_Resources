    },
    {
      "ordinal": 24,
      "label": "kizuna_dragon_d_tamer_08",
      "hash64": "E71EABDABA06AAE1",
      "text": "Tsk! Arrivederci!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "kizuna_dragon_d_16",
      "hash64": "2EF7848873A1B21C",
      "text": "Ahimè, ti chiedo scusa per questo spettacolo\\ndeplorevole.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
