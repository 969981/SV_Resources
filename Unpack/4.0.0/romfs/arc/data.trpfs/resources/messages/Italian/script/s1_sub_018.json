            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_018_woman_npc",
      "hash64": "4173059D9564CBB3",
      "text": "Prova a fare la posa cuore insieme a qualcuno!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s1_sub_018_man_npc",
      "hash64": "89644607171F7931",
      "text": "L’amore dilaga, tra le persone e tra i Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
