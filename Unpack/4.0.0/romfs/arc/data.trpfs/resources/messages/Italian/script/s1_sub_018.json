  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_018_woman_01",
      "hash64": "2E13479A8E038F9F",
      "text": "Noi ci amiamo alla follia, vero?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s1_sub_018_man_01",
      "hash64": "A4BEB69B60D0EE99",
      "text": "Altroché! Passiamo insieme ogni ora, ogni\\nminuto e ogni secondo della giornata!\\c\\nScommetto che nel mondo dei Pokémon non\\nesiste una coppia con un legame così forte!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_018_woman_02",
      "hash64": "2E13489A8E039152",
      "text": "Proprio così!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_018_woman_03",
      "hash64": "2E13499A8E039305",
      "text": "Ehi tu!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_018_woman_04",
      "hash64": "2E13429A8E038720",
      "text": "Se trovi una coppia di Pokémon innamorata\\nquanto noi, portacela qua!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s1_sub_018_man_02",
      "hash64": "A4BEB39B60D0E980",
      "text": "Io, però, scommetto che non c’è.\\nAhahah!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s1_sub_018_woman_05",
      "hash64": "2E13439A8E0388D3",
      "text": "Hai trovato una coppia di Pokémon inseparabili\\nche si amano alla follia?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_018_man_03",
      "hash64": "A4BEB49B60D0EB33",
      "text": "Come vedi, non esiste! Ahahah!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s1_sub_018_man_04",
      "hash64": "A4BEB99B60D0F3B2",
      "text": "Quel Pokémon non mi sembra molto innamorato!\\nAhahah!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s1_sub_018_man_05",
      "hash64": "A4BEBA9B60D0F565",
      "text": "Come come?! Tandemaus?!\\c\\nQuesta sì che è una coppia di innamorati\\naffiatatissimi e inseparabili!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_018_man_06",
      "hash64": "A4BEB79B60D0F04C",
      "text": "Come come?! Maushold?!\\c\\nQuesta sì che una coppia affiatatissima!\\nHa anche un piccolino bello come il sole!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_018_man_07",
      "hash64": "A4BEB89B60D0F1FF",
      "text": "Come come?! Maushold?!\\c\\nUna coppia così innamorata che ha addirittura\\ndue piccoli! Questa sì che è una famiglia felice!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_018_woman_06",
      "hash64": "2E13449A8E038A86",
      "text": "Chi l’avrebbe mai detto... Nel mondo dei\\nPokémon ci sono coppie affiatate come noi!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s1_sub_018_woman_07",
      "hash64": "2E13459A8E038C39",
      "text": "Grazie per avercene mostrata una!\\nPer sdebitarci, ti insegneremo questa posa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s1_sub_018_system_01",
      "hash64": "715C9973D3928E94",
      "text": "Hai imparato la[VAR 0xFF00(0008)] posa cuore (destra)[VAR 0xFF00(0000)] e la\\n[VAR 0xFF00(0008)]posa cuore (sinistra)[VAR 0xFF00(0000)] dalla coppietta!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
