          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_f_05_dragon_04",
      "hash64": "5A9FE8AEC3AD2B4F",
      "text": "Prego, entra pure, Brassi.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
