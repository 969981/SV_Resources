      ]
    },
    {
      "ordinal": 4,
      "label": "class_f_05_kusa_01",
      "hash64": "68E2B514A1C72785",
      "text": "Con permesso![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_f_05_kusa_02",
      "hash64": "68E2B214A1C7226C",
      "text": "Il mio nome è Brassius, sono un artista\\nspecializzato in Pokémon di tipo Erba![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_f_05_dragon_05",
      "hash64": "5A9FE7AEC3AD299C",
      "text": "L’attività artistica di Brassius è incentrata\\nsu opere tridimensionali, come le sculture.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_f_05_dragon_06",
      "hash64": "5A9FEAAEC3AD2EB5",
      "text": "La sua opera più famosa è il \"Sunflora arreso\"\\na Los Tazones.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_f_05_dragon_07",
      "hash64": "5A9FE9AEC3AD2D02",
      "text": "Chi di voi ha sfidato la Palestra di Los Tazones\\navrà avuto modo di vederla.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_f_05_kusa_03",
      "hash64": "68E2B314A1C7241F",
      "text": "Sì, vedo alcune facce note.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_f_05_kusa_04",
      "hash64": "68E2B014A1C71F06",
      "text": "Sappiate che siete molto fortunati a poter\\nseguire le lezioni di Oran.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_f_05_kusa_05",
      "hash64": "68E2B114A1C720B9",
      "text": "Tempo fa, quando avevo perso ogni speranza\\ne mi trovavo nel baratro della disperazione...[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_f_05_kusa_06",
      "hash64": "68E2AE14A1C71BA0",
      "text": "... fu proprio Oran a salvarmi! È il mio maestro\\ndi vita![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_f_05_kusa_07",
      "hash64": "68E2AF14A1C71D53",
      "text": "Se sono riuscito a definire il mio stile attuale\\nè soltanto merito suo...![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_f_05_dragon_08",
      "hash64": "5A9FECAEC3AD321B",
      "text": "Brassi...![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_f_05_dragon_09",
      "hash64": "5A9FEBAEC3AD3068",
      "text": "Vecchie storie a parte, oggi vorrei chiederti di\\nfare lezione nel tuo stile personalissimo.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_f_05_kusa_08",
      "hash64": "68E2BC14A1C7336A",
      "text": "Con piacere![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_f_05_kusa_09",
      "hash64": "68E2BD14A1C7351D",
      "text": "Dunque... Prima si parlava del \"Sunflora arreso\".[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_f_05_kusa_10",
      "hash64": "68E63A14A1CA3F5B",
      "text": "Qualcuno di voi riesce a capire con quale stato\\nd’animo ho realizzato l’espressione di filosofica\\r\\nrassegnazione di quel Sunflora?[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_f_05_select_01",
      "hash64": "1738F3B775F84FC1",
      "text": "Gioia",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "class_f_05_select_02",
      "hash64": "1738F0B775F84AA8",
      "text": "Tristezza",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "class_f_05_select_03",
      "hash64": "1738F1B775F84C5B",
      "text": "Rabbia",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "class_f_05_kusa_11",
      "hash64": "68E63914A1CA3DA8",
      "text": "No! Sbagliato, sbagliato, sbagliato!\\nSono tutte sbagliate...!![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_f_05_kusa_12",
      "hash64": "68E63C14A1CA42C1",
      "text": "Quando l’ho scolpito, ero in piena desolazione\\ncreativa![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_f_05_kusa_13",
      "hash64": "68E63B14A1CA410E",
      "text": "Se non avesse riscosso successo mi sarei ritirato,\\nabbandonando la mia carriera d’artista...\\c\\nEro pronto ad appendere lo scalpello al chiodo![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_f_05_dragon_10",
      "hash64": "5A9C7EAEC3AA415A",
      "text": "Per questo si chiama \"Sunflora arreso\", vero?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_f_05_kusa_14",
      "hash64": "68E63E14A1CA4627",
      "text": "Proprio così, Oran![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_f_05_kusa_15",
      "hash64": "68E63D14A1CA4474",
      "text": "Ai miei esordi come artista ho sofferto di una\\ngrave malattia e ho trascorso un periodo\\r\\ndi grande sconforto.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_f_05_kusa_16",
      "hash64": "68E64014A1CA498D",
      "text": "Volevo creare qualcosa che vendesse...\\nMi importava solo dei soldi e del successo.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_f_05_kusa_17",
      "hash64": "68E63F14A1CA47DA",
      "text": "Le creazioni nate da questi miei pensieri erano\\nsolo spazzatura di una superficialità vomitevole![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "class_f_05_kusa_18",
      "hash64": "68E63214A1CA31C3",
      "text": "In quel periodo incontrai Oran, che mi aprì\\ngli occhi su quanto fossi piccolo e gretto...\\r\\nBeh, ormai è acqua passata, comunque![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "class_f_05_kusa_19",
      "hash64": "68E63114A1CA3010",
      "text": "E quel che riuscii a creare poi fu proprio\\nquel Sunflora![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "class_f_05_dragon_11",
      "hash64": "5A9C7FAEC3AA430D",
      "text": "Ma... nemmeno io sapevo niente di tutto\\nquesto...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "class_f_05_kusa_20",
      "hash64": "68DBA814A1C0F2C0",
      "text": "Sono quelle cose che è più difficile dire proprio\\nalle persone care.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "class_f_05_kusa_21",
      "hash64": "68DBA914A1C0F473",
      "text": "Perciò, per quanto immagino che anche voi\\nadolescenti abbiate tante preoccupazioni...[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "class_f_05_kusa_22",
      "hash64": "68DBAA14A1C0F626",
      "text": "... il mio consiglio è di fare quello che volete\\ndavvero, liberamente.\\c\\nBasta che non diate fastidio agli altri, è chiaro.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "class_f_05_kusa_23",
      "hash64": "68DBAB14A1C0F7D9",
      "text": "Da parte mia è tutto.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
