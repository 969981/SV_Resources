    },
    {
      "ordinal": 29,
      "label": "coach_teacher_math_sp03_01",
      "hash64": "7D958920BDDA2D04",
      "text": "Dopo aver parlato con te, sono andata\\ndirettamente dal Preside dell’Istituto Mirtillo!\\c\\nGli ho esposto la necessità di aumentare\\nle lezioni delle altre materie![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
