      "hash64": "7E297A3B191EDAF4",
      "text": "È stato istruttivo!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_math_sp02_10",
      "hash64": "A932FA271EEA55AF",
      "text": "Uh uh uh... Sei tanto gentile, [VAR 0x0100(0000)].\\nCercherò di impegnarmi anch’io nel mio piccolo.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
