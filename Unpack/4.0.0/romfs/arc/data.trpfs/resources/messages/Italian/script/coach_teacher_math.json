    },
    {
      "ordinal": 19,
      "label": "coach_teacher_math_sp02_04",
      "hash64": "A92F78271EE742F2",
      "text": "Gran parte delle lezioni tratta di lotta\\no di materie affini...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
