    },
    {
      "ordinal": 20,
      "label": "coach_teacher_math_sp02_05",
      "hash64": "A92F79271EE744A5",
      "text": "Ciò è utile per coloro che puntano a un futuro\\nimpiego in cui sfruttare tali conoscenze...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_math_sp02_06",
      "hash64": "A92F76271EE73F8C",
