      "hash64": "6CA0E14B0F44D43D",
      "text": "Allora, [VAR 0x0100(0000)], ci pensi tu alla porta?[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
