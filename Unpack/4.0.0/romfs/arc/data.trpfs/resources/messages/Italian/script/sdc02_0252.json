        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0252_brother_01",
      "hash64": "DDDCA75853B39AAC",
      "text": "Quindi questo... è il punto più profondo?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0252_select_01",
      "hash64": "39BCA7ABE351F41E",
      "text": "Precisamente!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_0252_select_02",
      "hash64": "39BCA6ABE351F26B",
      "text": "Per niente!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc02_0252_bbteacher_02",
      "hash64": "6CA0DD4B0F44CD71",
      "text": "In un certo senso lo è, e allo stesso tempo\\nnon lo è.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0252_bbteacher_03",
      "hash64": "6CA0DC4B0F44CBBE",
      "text": "È il punto più profondo raggiunto a suo tempo\\ndalla squadra di osservazione dell’Area Zero.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0252_bbteacher_04",
      "hash64": "6CA0DF4B0F44D0D7",
      "text": "Poi, a quanto mi è stato detto, al piano inferiore\\ndel Laboratorio Zero c’è una stanza misteriosa\\r\\nla cui funzione non ci è chiara.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
