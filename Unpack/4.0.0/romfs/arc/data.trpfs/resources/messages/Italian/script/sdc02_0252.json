    },
    {
      "ordinal": 1,
      "label": "sdc02_0252_bbteacher_01",
      "hash64": "6CA0DA4B0F44C858",
      "text": "A giudicare dall’aspetto, direi che questo è\\nil Laboratorio Zero.\\c\\nCorrisponde perfettamente alla descrizione\\ndi Alisma.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
