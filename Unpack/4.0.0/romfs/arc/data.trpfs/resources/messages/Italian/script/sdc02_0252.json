          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0252_bbteacher_05",
      "hash64": "6CA0DE4B0F44CF24",
      "text": "Ma il luogo che voglio raggiungere si trova\\nancora più sotto...[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0252_sister_02",
      "hash64": "09E186BFBA11523F",
      "text": "Ok, non ci sto capendo molto, ma... in pratica\\nbasta che entriamo nel... Com’è che si chiama...?\\r\\nLaboratorio Zero?[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
