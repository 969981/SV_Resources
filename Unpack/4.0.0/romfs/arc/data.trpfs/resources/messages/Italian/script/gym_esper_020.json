          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_esper_020_trainer_04",
      "hash64": "392ABE25B77CEEB0",
      "text": "Le regole dell’esercizio sono semplici!\\c\\nTi farò vedere come si fa. Osserva bene e imita\\ncorrettamente i movimenti![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
