    {
      "ordinal": 3,
      "label": "gym_esper_020_receptionist_04",
      "hash64": "9C27B088C6C61CD2",
      "text": "Esci dalla palestra, vai a sinistra, e arriverai nel\\nluogo in cui si svolge l’esercizio.\\c\\nTroverai una donna con una tuta nera.\\nParlale, e ti spiegherà tutte le regole.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
