    },
    {
      "ordinal": 22,
      "label": "gym_esper_020_battle_b_01",
      "hash64": "D4DF63147BD9742D",
      "text": "Vorrei tanto rafforzare i muscoli. Consigli?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
