      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_esper_020_trainer_07",
      "hash64": "392AC125B77CF3C9",
      "text": "Nessun problema! L’importante è prepararsi\\nal meglio! Torna da me quando sei pront[VAR 0x1100(00FF,0101)]oa.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
