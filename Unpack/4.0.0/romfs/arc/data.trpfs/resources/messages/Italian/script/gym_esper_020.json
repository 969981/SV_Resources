          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_esper_020_trainer_08",
      "hash64": "392ACA25B77D0314",
      "text": "Brav[VAR 0x1100(00FF,0101)]oa! Ottima esecuzione! Tu e il tuo Pokémon\\nsiete splendidi![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
