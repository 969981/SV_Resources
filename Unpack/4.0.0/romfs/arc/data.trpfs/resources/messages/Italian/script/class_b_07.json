      "hash64": "BA90C0C352E35F15",
      "text": "Bentrovati, ragazzi! Pronti per un’altra\\nentusiasmante lezione?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
