          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_b_07_math_15",
      "hash64": "BA9448C352E67C04",
      "text": "Allora, ricapitolando: la potenza iniziale della\\nmossa è 100.\\c\\nLa moltiplichiamo per 1,5 perché è dello stesso\\ntipo del Pokémon, e otteniamo 150.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_b_07_math_16",
      "hash64": "BA944BC352E6811D",
      "text": "A questo 150 applichiamo il vantaggio di tipo,\\novvero raddoppiamo il valore, ottenendo 300.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_b_07_math_17",
      "hash64": "BA944AC352E67F6A",
      "text": "Alla fine la nostra mossa diventa 3 volte più\\npotente! Incredibile, non è vero?[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_b_07_math_18",
      "hash64": "BA943DC352E66953",
      "text": "Se poi il tipo originale del Pokémon è lo stesso\\ndel teratipo, anziché moltiplicare per 1,5,\\r\\ndovremo moltiplicare per 2![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_b_07_math_19",
      "hash64": "BA943CC352E667A0",
      "text": "Certo, questo non significa che non possiate\\nusare mosse di tipi diversi, anzi!\\c\\nPotrebbe essere un modo per sorprendere\\nil vostro avversario![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_b_07_math_20",
      "hash64": "BA8A33C352DE03D0",
      "text": "Comunque, ogni Pokémon, come ogni persona,\\nha determinate caratteristiche uniche.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_b_07_math_21",
      "hash64": "BA8A34C352DE0583",
      "text": "E alla fine è puntando su quelle che si riesce\\na dare il meglio.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_b_07_math_22",
      "hash64": "BA8A35C352DE0736",
      "text": "Se c’è una cosa che vorrei che ricordaste sempre,\\nè proprio questa.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_b_07_math_23",
      "hash64": "BA8A36C352DE08E9",
      "text": "È anche una cosa molto elementare, è vero, ma\\nproprio per questo, forse, ancora più valida.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_b_07_math_24",
      "hash64": "BA8A37C352DE0A9C",
      "text": "E così anche quest’ultima lezione è volata via![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "class_b_07_math_25",
      "hash64": "BA8A38C352DE0C4F",
      "text": "È stato un piacere potervi trasmettere il mio\\namore per la matematica![VAR 0x0114(0025)]",
