    {
      "ordinal": 17,
      "label": "class_b_07_math_answer_01",
      "hash64": "A2797D00F12DF956",
      "text": "Ah! Ci sei andat[VAR 0x1100(00FF,0101)]oa vicino...\\c\\nSe calcolassi solo il potenziamento dato dal tipo\\nmoltiplicando per 1,5, in effetti otterresti 150...[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
