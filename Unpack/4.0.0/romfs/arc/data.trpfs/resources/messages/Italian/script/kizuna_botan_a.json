      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_botan_a_04",
      "hash64": "3628B6A5496FE219",
      "text": "Ehm... Vedi, ecco... Uhm...\\nNon mi resta che confessare, eh...?[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
