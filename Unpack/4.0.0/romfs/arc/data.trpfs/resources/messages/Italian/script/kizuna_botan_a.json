    },
    {
      "ordinal": 7,
      "label": "kizuna_botan_a_06",
      "hash64": "3628B4A5496FDEB3",
      "text": "Hai capito... no?[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
