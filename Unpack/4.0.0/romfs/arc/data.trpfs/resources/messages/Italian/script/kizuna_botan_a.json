      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_botan_a_05",
      "hash64": "3628B5A5496FE066",
      "text": "Dai un’occhiata laggiù.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
