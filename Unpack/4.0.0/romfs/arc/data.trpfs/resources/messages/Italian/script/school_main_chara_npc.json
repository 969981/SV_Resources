        }
      ]
    },
    {
      "ordinal": 24,
      "label": "school_main_chara_historyteacher_05",
      "hash64": "E27F458E75633148",
      "text": "Come va con i tesori portatori di sciagura?\\nSe vuoi disfartene, io me li prendo volentieri.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
