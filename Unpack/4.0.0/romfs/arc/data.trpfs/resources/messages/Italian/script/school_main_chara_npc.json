      "label": "school_main_chara_hometeacher_01",
      "hash64": "1E92750EDE0E0DFB",
      "text": "Mettiti pure a tuo agio, non far caso a me.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
