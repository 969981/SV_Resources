    {
      "ordinal": 25,
      "label": "school_main_chara_healthteacher_01",
      "hash64": "AD66439216327F3E",
      "text": "Se sei stanc[VAR 0x1100(00FF,0101)]oa, perché non ti fai un riposino\\nin infermeria?[VAR 0x0114(0028)]",
