    },
    {
      "ordinal": 23,
      "label": "school_main_chara_historyteacher_04",
      "hash64": "E27F468E756332FB",
      "text": "Vai a fare qualche indagine sui tesori portatori\\ndi sciagura, se ti viene voglia.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
