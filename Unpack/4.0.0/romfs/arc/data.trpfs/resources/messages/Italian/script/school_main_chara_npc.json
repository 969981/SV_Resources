    {
      "ordinal": 16,
      "label": "school_main_chara_battleteacher_01",
      "hash64": "FCF05F98B306ACEA",
      "text": "Osu, novellin[VAR 0x1100(00FF,0101)]oa! I muscoli sono una gran cosa, sai?[VAR 0x0114(0024)]",
