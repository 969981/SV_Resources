          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_a_05_ecology_10",
      "hash64": "87DFE20EF8980224",
      "text": "Cambiano aspetto e le loro statistiche subiscono\\nun’impennata.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
