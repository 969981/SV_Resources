          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_a_05_ecology_14",
      "hash64": "87DFDE0EF897FB58",
      "text": "In quel caso, quando comincia a evolversi basta\\nrestare calmi e pronunciare la formula magica.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
