      ]
    },
    {
      "ordinal": 23,
      "label": "class_a_05_ecology_18",
      "hash64": "87DFDA0EF897F48C",
      "text": "Potete anche impedirgli di evolversi dandogli\\nlo strumento Pietrastante.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_a_05_ecology_19",
      "hash64": "87DFDB0EF897F63F",
      "text": "A proposito, i requisiti per l’evoluzione variano\\nda Pokémon a Pokémon.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_a_05_ecology_20",
      "hash64": "87EA540EF8A1185F",
      "text": "Alcuni possono evolversi con uno strumento,\\ncome la Pietrafocaia o la Pietratuono.\\c\\nAltri devono imparare una specifica mossa,\\no sconfiggere un certo Pokémon.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
