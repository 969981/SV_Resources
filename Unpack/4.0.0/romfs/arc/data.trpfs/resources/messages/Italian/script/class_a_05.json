          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_a_05_ecology_13",
      "hash64": "87DFE50EF898073D",
      "text": "Però c’è anche chi preferirebbe che il proprio\\nPokémon conservasse le sembianze che gli sono\\r\\npiù care, invece di evolversi.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
