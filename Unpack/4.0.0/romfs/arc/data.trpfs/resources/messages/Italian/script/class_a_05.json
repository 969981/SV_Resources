    {
      "ordinal": 0,
      "label": "class_a_05_ecology_01",
      "hash64": "87E3670EF89B19FA",
      "text": "Salve, ragazzi! Siete pronti a imparare\\ntante cose nuove?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
