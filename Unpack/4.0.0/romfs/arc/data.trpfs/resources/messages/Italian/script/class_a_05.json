        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_a_05_ecology_answer_03",
      "hash64": "59FAA649A854ADF9",
      "text": "Accipicchia... A quanto pare [VAR 0x0100(0000)] è\\nl’unica voce fuori dal coro.\\c\\nIl pulsante C... Aaah, sentirne parlare\\nmi mette proprio nostalgia![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
