    {
      "ordinal": 21,
      "label": "class_a_05_ecology_16",
      "hash64": "87DFE00EF897FEBE",
      "text": "Ebbene, la formula magica è: \"Annulla\\nl’evoluzione con il pulsante B!\"[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
