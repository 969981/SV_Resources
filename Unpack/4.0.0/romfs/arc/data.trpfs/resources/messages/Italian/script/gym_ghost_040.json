    },
    {
      "ordinal": 5,
      "label": "gym_ghost_040_receptionist_nobattle",
      "hash64": "D0A496BAB24C009D",
      "text": "Per sfidare Lima ti servono almeno due Pokémon\\nin grado di lottare!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
