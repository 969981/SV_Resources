    {
      "ordinal": 29,
      "label": "gym_ghost_040_ghost_15",
      "hash64": "143A30F9B1C5766E",
      "text": "Il mio nome è Lima, aka lo spirito del ritmo![VAR 0x0114(001B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
