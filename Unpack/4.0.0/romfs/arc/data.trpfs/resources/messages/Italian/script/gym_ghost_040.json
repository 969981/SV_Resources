      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_ghost_040_system_01",
      "hash64": "CDB670A9B4004749",
      "text": "Dall’arena si sente qualcuno parlare in modo\\nmolto ritmato!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_ghost_040_man_01",
      "hash64": "F4F1D304F7C6E0B2",
      "text": "Oggi è il giorno, qui è il luogo e quest’è l’ora! ♪\\nIo e il mio team ti manderemo alla malora! ♪",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_ghost_040_man_02",
      "hash64": "F4F1D204F7C6DEFF",
      "text": "Apri bene quelle orecchie, o Capopalestra! ♪\\n’Ste rime sono fresche, non è vecchia minestra! ♪",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_ghost_040_system_02",
      "hash64": "CDB66DA9B4004230",
      "text": "Bum bum chica chica...\\nBum bum chica chica...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "gym_ghost_040_ghost_01",
      "hash64": "1436B0F9B1C26717",
      "text": "Le tue rime sono fresche? ♪\\nAllora stiamo freschi! ♪\\c\\nBro, puzzi di culla, ancora non sei nulla. ♪\\nE vuoi tenermi testa? Ma fatti una siesta! ♪[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
