    },
    {
      "ordinal": 19,
      "label": "gym_ghost_040_ghost_07",
      "hash64": "1436AEF9B1C263B1",
      "text": "Yo! Ma tu sei quell[VAR 0x1100(00FF,0101)]oa che mi ha fatto da gruppo\\nspalla!\\c\\nSei qui per una lotta di Pokémon o per una\\nbattaglia di rime?[VAR 0x0114(001B)]",
