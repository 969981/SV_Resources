    },
    {
      "ordinal": 35,
      "label": "s2_sub_010_headbb_18",
      "hash64": "1124AC69A281F61E",
      "text": "Buongiorno! Sei mattinier[VAR 0x1100(00FF,0101)]oa!\\c\\nIo mi sono alzato perché ormai ero sveglio...\\nQuando si invecchia, si dorme anche di meno.[VAR 0x0114(004B)]",
      "flags": 0,
