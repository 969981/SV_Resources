    {
      "ordinal": 32,
      "label": "s2_sub_010_head_09",
      "hash64": "15B674B8135DC190",
      "text": "Preside Bluebert, scusi se interrompo la sua\\nconversazione, ma...[VAR 0x0114(000A)]",
