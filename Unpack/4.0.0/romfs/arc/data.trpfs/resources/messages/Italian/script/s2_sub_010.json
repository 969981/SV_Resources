    {
      "ordinal": 33,
      "label": "s2_sub_010_head_10",
      "hash64": "15B2F7B8135AB752",
      "text": "Come dicevo... Potrebbe evitare di chiamarmi\\n\"Velly\" davanti agli studenti...?[VAR 0x0114(000A)]",
