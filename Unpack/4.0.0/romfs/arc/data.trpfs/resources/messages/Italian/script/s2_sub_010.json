    {
      "ordinal": 10,
      "label": "s2_sub_010_headbb_03",
      "hash64": "11282B69A28503C2",
      "text": "Sei ancora agli inizi, vedo.\\c\\nMa non avere fretta, il tuo soggiorno di studio\\nè appena cominciato.[VAR 0x0114(004B)]",
