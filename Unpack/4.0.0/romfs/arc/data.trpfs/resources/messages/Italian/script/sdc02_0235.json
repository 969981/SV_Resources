    },
    {
      "ordinal": 8,
      "label": "sdc02_0235_ground_04",
      "hash64": "D979CBBDBDC55EFF",
      "text": "Essì! C’hai proprio talento! C’hai così tanto\\ntalento che...[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
