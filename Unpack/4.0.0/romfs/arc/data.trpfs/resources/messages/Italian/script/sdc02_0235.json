    },
    {
      "ordinal": 9,
      "label": "sdc02_0235_ground_05",
      "hash64": "D979CABDBDC55D4C",
      "text": "Te le devi sempre annà a cercà! Te possino![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
