      "hash64": "D9AB61BFDCE1FFB2",
      "text": "No, sono qui per la verifica della palestra!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
