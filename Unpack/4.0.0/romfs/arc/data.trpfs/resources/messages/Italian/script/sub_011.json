      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "sub_011_takara_cook_05",
      "hash64": "23786CEE06E9CA76",
      "text": "Accidenti, non hai abbastanza teraliti!\\nMe ne servono 50...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "sub_011_takara_cook_06",
      "hash64": "23786BEE06E9C8C3",
      "text": "Preparerò una ricetta speciale che cambierà\\nil teratipo di uno dei tuoi Pokémon!\\c\\nMa per farlo ho bisogno del tuo aiuto: dovrai\\nraccogliere per me 50 teraliti.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
