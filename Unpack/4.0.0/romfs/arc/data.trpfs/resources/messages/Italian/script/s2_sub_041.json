          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_041_synchro_12",
      "hash64": "86F4A51963398206",
      "text": "Mi sembri decisamente portat[VAR 0x1100(00FF,0101)]oa per questo.\\nPerché non mi fai da assistente ancora una volta?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
