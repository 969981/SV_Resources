          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_sub_041_synchro_14",
      "hash64": "86F4A7196339856C",
      "text": "Ti è venuta voglia di aiutarmi offrendoti\\nvolontari[VAR 0x1100(00FF,0101)]oa per un esperimento rivoluzionario?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
