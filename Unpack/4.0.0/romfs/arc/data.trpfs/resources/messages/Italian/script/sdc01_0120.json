          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0120_sister_02",
      "hash64": "204EE5B2E8AAB314",
      "text": "Tsk! Non t’hanno insegnato che non si curiosa\\nin casa altrui?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0120_sister_03",
      "hash64": "204EE6B2E8AAB4C7",
      "text": "Comunque, non so perché ma nella rimessa\\nc’erano solo due maschere...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0120_sister_04",
      "hash64": "204EE3B2E8AAAFAE",
      "text": "E quindi, niente... Spiacente per te, ma le regole\\nsono regole![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0120_sister_05",
      "hash64": "204EE4B2E8AAB161",
      "text": "Sono arrivata prima, perciò la maschera\\nme la prendo io. Così è la vita![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0120_select_01",
      "hash64": "4B6B4756877BB589",
      "text": "Che delusione...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc01_0120_select_02",
      "hash64": "4B6B4456877BB070",
      "text": "Tanto non la volevo...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc01_0120_sister_06",
      "hash64": "204EE1B2E8AAAC48",
      "text": "Su, su, non fare il muso lungo![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0120_sister_07",
      "hash64": "204EE2B2E8AAADFB",
      "text": "Come premio di consolazione ti concedo\\ndi ammirare la mia figura in abiti da festa...\\r\\nDurante una lotta, s’intende![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0120_sister_08",
      "hash64": "204EDFB2E8AAA8E2",
      "text": "In posizione, forza![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0120_sister_09",
      "hash64": "204EE0B2E8AAAA95",
      "text": "Bah, chi se ne importa di com’è andata la lotta.\\nTanto la maschera me la tengo![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
