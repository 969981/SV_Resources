      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0120_sister_10",
      "hash64": "20524DB2E8AD99A3",
      "text": "E ora me la metto pure...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0120_sister_11",
      "hash64": "20524CB2E8AD97F0",
      "text": "Allora? Sto da favola, vero?[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0120_brother_02",
      "hash64": "BCDEAAB2405C5288",
      "text": "S-Senti, [VAR 0x0100(0000)]... Se vuoi puoi usare\\nla mia, di maschera...[VAR 0x0114(0043)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
