      "hash64": "7075073D9FB33F0A",
      "text": "Potrei avere un... panino gusto forte, per favore?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
