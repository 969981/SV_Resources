          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_home_b_06",
      "hash64": "7074FA3D9FB328F3",
      "text": "Nel nostro menu mi intriga particolarmente\\nil panino con burro di arachidi, dolce e gustoso.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
