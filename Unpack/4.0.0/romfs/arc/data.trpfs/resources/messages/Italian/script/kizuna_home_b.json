      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_home_b_04",
      "hash64": "7074FC3D9FB32C59",
      "text": "Io sono qui per... ispezionare la mensa scolastica,\\ndiciamo.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
