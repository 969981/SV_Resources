    },
    {
      "ordinal": 4,
      "label": "champ_0220_ground_02",
      "hash64": "D97FDD4188CF2B74",
      "text": "La prima dei Superquattro ad affrontarti...\\nsarò io, Capsi![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
