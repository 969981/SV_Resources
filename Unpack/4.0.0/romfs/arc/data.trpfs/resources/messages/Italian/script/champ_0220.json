      ]
    },
    {
      "ordinal": 16,
      "label": "champ_0220_steel_03",
      "hash64": "9293532F48E4CE03",
      "text": "Puoi contarci![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
