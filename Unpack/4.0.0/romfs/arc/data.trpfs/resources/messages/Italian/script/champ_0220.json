          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0220_ground_03",
      "hash64": "D97FDE4188CF2D27",
      "text": "E se pensi che c’andrò piano con te... è mejo\\nche te dai ’na svejata, perché mo se balla![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0220_ground_04",
      "hash64": "D97FDB4188CF280E",
      "text": "Ahò, certo che nun scherzi mica!\\nChe tranvata c’ho preso!![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0220_ground_05",
      "hash64": "D97FDC4188CF29C1",
      "text": "Hai capito ’st[VAR 0x1100(00FF,0A0A)]o gnappoloa gnappola... È stata proprio\\n’na doccia fredda! Spettacolo, però.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0A0A"
          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0220_ground_06",
      "hash64": "D97FD94188CF24A8",
      "text": "Ma occhio eh, che mica so capaci tutti a superà\\nla prova pratica! Anzi, a dittela tutta, ce riescono\\r\\ngiusto in quattro Meowth...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0220_ground_07",
      "hash64": "D97FDA4188CF265B",
      "text": "Però forse... e dico forse, nun me fraintende!\\nForse te qualche speranza ce l’hai pure.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0220_ground_08",
      "hash64": "D97FD74188CF2142",
      "text": "Mo appizza ’e recchie! ’A seconda Superquattro\\nc’ha ’na squadra clamorosa.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0220_ground_09",
      "hash64": "D97FD84188CF22F5",
      "text": "Daje su, viè ’n po’ qua, micrognappola![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
