      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0220_steel_02",
      "hash64": "9293522F48E4CC50",
      "text": "Capsi, ma non avrai mica perso![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0220_ground_10",
      "hash64": "D983454188D21203",
      "text": "Che te devo dì, Verì? M’ha dato ’na ripassata\\nche nun maa scordo più![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "champ_0220_ground_11",
      "hash64": "D983444188D21050",
      "text": "Daje, comunque mo me metto qua a guardà che\\ncombinate voiantr[VAR 0x1100(00FF,0101)]ie. Daje forte, Verì! Vendicame![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
