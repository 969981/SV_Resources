    {
      "ordinal": 7,
      "label": "common_2070_rival_04b",
      "hash64": "36FEACCD000215A2",
      "text": "Ahahah! Sempre a scherzare! Per mezzo secondo\\nti ho creduto![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
