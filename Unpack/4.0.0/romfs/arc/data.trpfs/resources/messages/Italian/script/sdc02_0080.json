          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0080_select_03",
      "hash64": "49B42DEA169DAC51",
      "text": "È stata uno spasso!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "sdc02_0080_select_04",
      "hash64": "49B42EEA169DAE04",
      "text": "Più facile del previsto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "sdc02_0080_fairybb_06",
      "hash64": "CE97A37B27A6EEDB",
      "text": "Davvero? Che bello!\\nSono proprio contenta per te.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc02_0080_fairybb_07",
      "hash64": "CE97A27B27A6ED28",
      "text": "Davvero? Le lezioni dell’accademia devono\\nessere decisamente più complesse, allora...![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc02_0080_fairybb_08",
      "hash64": "CE97A17B27A6EB75",
      "text": "Ah, quasi dimenticavo!\\nDevo fare un salto alla sede del club![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc02_0080_fairybb_09",
      "hash64": "CE97A07B27A6E9C2",
      "text": "Temo che il nostro piccolo tour si concluderà qui.\\nMa prima di lasciarti ti spiego un’ultima cosa![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
