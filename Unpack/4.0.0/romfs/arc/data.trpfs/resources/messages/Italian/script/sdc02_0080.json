        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0080_select_01",
      "hash64": "49B42BEA169DA8EB",
      "text": "Ce l’ho messa tutta!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sdc02_0080_select_02",
      "hash64": "49B42CEA169DAA9E",
      "text": "È stata una passeggiata!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sdc02_0080_fairybb_02",
      "hash64": "CE97A77B27A6F5A7",
      "text": "Non te la cavi bene solo nelle lotte, allora.\\nSei un[VAR 0x1100(00FF,0101)] ’espert[VAR 0x1100(00FF,0101)]oa anche nel catturare Pokémon...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
