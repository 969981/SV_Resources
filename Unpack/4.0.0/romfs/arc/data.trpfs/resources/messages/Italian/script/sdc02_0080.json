            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0080_fairybb_03",
      "hash64": "CE97A67B27A6F3F4",
      "text": "Da questo si intuisce che l’Accademia Arancia è\\nuna scuola d’eccellenza.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0080_fairybb_04",
      "hash64": "CE97A57B27A6F241",
      "text": "Da questo si intuisce che l’Accademia Uva è\\nuna scuola d’eccellenza.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0080_teacher_20",
      "hash64": "EE5FBE1F07FC7F96",
      "text": "Bene, ragazzi, venite tutti qui!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "sdc02_0080_teacher_21",
      "hash64": "EE5FBF1F07FC8149",
      "text": "Per oggi non abbiamo più tempo,\\nquindi la lezione finisce qui!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "sdc02_0080_teacher_22",
      "hash64": "EE5FBC1F07FC7C30",
      "text": "Chi non fosse ancora riuscito a catturare\\nun Pokémon, lo faccia come compito per casa!\\c\\nLa lezione è conclusa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc02_0080_mob_01",
      "hash64": "9A95444F99F3B847",
      "text": "Che barba! Mi tocca farlo come compito\\nper casa.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "sdc02_0080_fairybb_05",
      "hash64": "CE97A47B27A6F08E",
      "text": "[VAR 0x0100(0000)], come ti è sembrata\\nla tua prima lezione all’Istituto Mirtillo?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
