          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_gym_nomal_sp01_select_01",
      "hash64": "508901898B20563B",
      "text": "Il panino del Ponte Villaggio",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_gym_nomal_sp01_select_02",
      "hash64": "508902898B2057EE",
      "text": "Il Conostropoli",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_gym_nomal_sp01_05",
      "hash64": "F68092F619D16AE0",
      "text": "Capisco, ti piacciono i panini. Lo immaginavo.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_nomal_sp01_05b",
      "hash64": "ADE43A2DDED7FAE6",
      "text": "Capisco, preferisci i dolci.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_nomal_sp01_06",
      "hash64": "F68095F619D16FF9",
      "text": "Grazie. La tua opinione conta.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_nomal_sp01_07",
      "hash64": "F68094F619D16E46",
      "text": "Una volta terminate le mie incombenze\\ndidattiche, andrò a mangiarne a sazietà.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_nomal_sp02_00",
      "hash64": "CA798DEFB8675DB0",
      "text": "Oh, eccoti qui...[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_nomal_sp02_01",
      "hash64": "CA798EEFB8675F63",
      "text": "Come anticipato per le vie brevi, sono andato\\na provare i panini del Ponte Villaggio.\\c\\nAvevano un gusto inusuale, diverso rispetto\\na quelli di Paldea. Ma li ho apprezzati.\\c\\nErano piuttosto dolci. Nella preparazione erano\\nstate impiegate delle bacche. Forse per questo\\r\\nil mio Staraptor non smetteva di beccarli...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 173,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 271,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 319,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_gym_nomal_sp02_01b",
      "hash64": "73ECE25657A66EB3",
      "text": "Come anticipato per le vie brevi, sono andato\\na provare i Conostropoli.\\c\\nAvevano una consistenza soffice ma un gusto\\nintenso. Veramente ottimi al palato.\\c\\nIl gelato al sale di Nacli di Zucchero Gelato\\na Paldea continua a essere il non plus ultra.\\c\\nIl Conostropoli, tuttavia, grazie alla sua ricchezza\\ndi ingredienti scelti con cura, gli si avvicina...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 155,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 250,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 357,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_gym_nomal_sp02_02",
      "hash64": "CA798FEFB8676116",
      "text": "Le mie più sentite scuse. Mi sono dilungato.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_nomal_sp02_03",
      "hash64": "CA7990EFB86762C9",
      "text": "Per me mangiare è il punto culminante\\ndi un viaggio.\\c\\nIl tema mi rende inavvertitamente loquace.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_nomal_sp02_04",
      "hash64": "CA7991EFB867647C",
      "text": "Tornare a casa mia e mangiare le solite\\npolpette di riso, però... è tutto un altro\\r\\nlivello di soddisfazione.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_nomal_sp03_00",
      "hash64": "F3B1A3E46DEA10C1",
      "text": "Dimmi... hai mai usufruito dei servizi della mensa\\ndell’Istituto Mirtillo?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_nomal_sp03_01",
      "hash64": "F3B1A2E46DEA0F0E",
      "text": "Non è male.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_nomal_sp03_01b",
      "hash64": "00E73626C4B83484",
      "text": "Davvero? Non è male.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_nomal_sp03_02",
      "hash64": "F3B1A1E46DEA0D5B",
      "text": "I piatti hanno un sapore deciso e sono pensati\\nper una clientela giovane; degne di nota\\r\\nle porzioni generose.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_nomal_sp03_03",
      "hash64": "F3B1A0E46DEA0BA8",
      "text": "L’opzione delle \"patate scolastiche\" è talmente\\nvoluminosa che invita a fare salti di gioia.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_nomal_sp03_04",
      "hash64": "F3B1A7E46DEA178D",
      "text": "Ti raccomando di provarle, se non lo hai ancora\\nfatto.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_gym_nomal_trade_01_00",
      "hash64": "23FC6E8CF2B8BFC3",
      "text": "Non mi aspettavo che avresti ascoltato con tale\\nattenzione i miei sproloqui...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_nomal_trade_01_01",
      "hash64": "23FC6D8CF2B8BE10",
      "text": "Sei decisamente un individuo singolare.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_nomal_trade_01_02",
      "hash64": "23FC708CF2B8C329",
      "text": "Forse così singolare da gradire anche\\nuno scambio di Pokémon con me?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_nomal_trade_01_03",
      "hash64": "23FC6F8CF2B8C176",
      "text": "Io ho intenzione di inviare Dudunsparce, ma\\nlascio il tuo contributo a tua discrezione.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_nomal_trade_01_04",
      "hash64": "23FC728CF2B8C68F",
      "text": "[VAR 0x0101(0001)]... Di certo il suo allenamento\\nsarà un investimento proficuo.\\r\\nTi ringrazio.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
