    },
    {
      "ordinal": 49,
      "label": "coach_gym_nomal_randomtalk_00",
      "hash64": "36566AE3B87009CC",
      "text": "L’Esame della Palestra di Mesturia è molto\\nben congegnato, a mio modesto avviso.\\c\\nSi riescono a fare dei tagli al numero\\ndegli sfidanti facendoli lottare tra loro.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 165,
