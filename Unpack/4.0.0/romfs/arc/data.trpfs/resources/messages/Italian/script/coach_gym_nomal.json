          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_gym_nomal_randomtalk_01",
      "hash64": "36566BE3B8700B7F",
      "text": "Spero che il Supercapo non ti stia mettendo\\nin difficoltà.\\c\\nSe non le dici chiaramente di no, non avrai\\nun attimo di pace. Credimi.[VAR 0x0114(0015)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
