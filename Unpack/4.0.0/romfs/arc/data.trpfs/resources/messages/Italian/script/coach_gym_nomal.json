    },
    {
      "ordinal": 3,
      "label": "coach_gym_nomal_sp01_01",
      "hash64": "F68096F619D171AC",
      "text": "Convochi personale addirittura a livello\\ninterregionale...\\c\\nNon avrai preso a modello qualcuno\\ndi mia conoscenza, spero.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
