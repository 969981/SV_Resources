    },
    {
      "ordinal": 53,
      "label": "coach_gym_nomal_randomtalk_04",
      "hash64": "365666E3B8700300",
      "text": "Come sta il Dudunsparce che ti ho ceduto\\nin precedenza?\\c\\nÈ un Dudunsparce che vola... e si teracristallizza\\nnel tipo Volante, per l’appunto.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
