    {
      "ordinal": 2,
      "label": "coach_gym_nomal_sp01_00",
      "hash64": "F68097F619D1735F",
      "text": "... Oh, sei tu.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
