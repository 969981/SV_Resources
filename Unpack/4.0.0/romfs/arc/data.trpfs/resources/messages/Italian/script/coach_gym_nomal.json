      "label": "coach_gym_nomal_trade_02_00",
      "hash64": "20A14487C9DCF6B4",
      "text": "Vuoi scambiare il tuo [VAR 0x0101(0001)] per\\nil mio Dudunsparce?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
