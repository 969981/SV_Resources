    },
    {
      "ordinal": 52,
      "label": "coach_gym_nomal_randomtalk_03",
      "hash64": "36566DE3B8700EE5",
      "text": "[VAR 0x0101(0001)] sta bene. Non credo che la sua\\nsia solo una vitalità di facciata.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
