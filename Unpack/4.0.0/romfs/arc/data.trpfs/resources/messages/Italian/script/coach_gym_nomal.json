        }
      ]
    },
    {
      "ordinal": 51,
      "label": "coach_gym_nomal_randomtalk_02",
      "hash64": "36566CE3B8700D32",
      "text": "È una seccatura che nell’Esame dei Campioni\\nil turno del prof. Oranzio venga dopo il mio.\\c\\nSe fossero la signorina Capsi o Verina, non mi\\ncostringerebbero a fare la scortesia di chiamarle\\r\\na voce alta. Capirebbero che è il loro turno.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
