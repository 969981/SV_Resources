          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_nomal_sp01_02",
      "hash64": "F68099F619D176C5",
      "text": "Per me non è un problema, anzi.\\nMi piacciono gli incarichi fuori sede.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_nomal_sp01_03",
      "hash64": "F68098F619D17512",
      "text": "Sono qui per lavoro, ma ne approfitterò\\nper togliermi qualche sfizio.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_gym_nomal_sp01_04",
      "hash64": "F68093F619D16C93",
      "text": "Tra i cibi tipici di Unima di norma si annoverano\\nil panino del Ponte Villaggio e il Conostropoli.\\r\\nA te quale interesserebbe?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
