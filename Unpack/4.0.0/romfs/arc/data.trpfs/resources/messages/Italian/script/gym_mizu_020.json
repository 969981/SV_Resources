          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "gym_mizu_020_mizu_07",
      "hash64": "930AFB305CF0CB85",
      "text": "Alla famosa [VAR 0xFF00(0006)]asta[VAR 0xFF00(0000)] di Marinada c’è un articolo che\\ndobbiamo assolutamente prendere all’amo![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
