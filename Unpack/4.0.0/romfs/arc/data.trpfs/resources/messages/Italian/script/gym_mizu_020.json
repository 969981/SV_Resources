    },
    {
      "ordinal": 20,
      "label": "gym_mizu_020_select_01",
      "hash64": "54C29DBBFD75281A",
      "text": "Ho trovato il portafogli!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "gym_mizu_020_select_02",
      "hash64": "54C29CBBFD752667",
      "text": "Devo consegnare un oggetto smarrito!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "gym_mizu_020_system_01",
      "hash64": "C22350BAFFC104CD",
      "text": "Hai consegnato il Portafogli di Algaro\\nal suo legittimo proprietario!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "gym_mizu_020_mizu_03",
      "hash64": "930AF7305CF0C4B9",
      "text": "Per tutti i mari! Il mio portafogli!![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_mizu_020_mizu_04",
      "hash64": "930AF8305CF0C66C",
      "text": "Come come? Lo staff della palestra ti ha chiesto\\ndi venire a portarmelo?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_mizu_020_mizu_05",
      "hash64": "930AF9305CF0C81F",
      "text": "Gah ah ah! Mi hai fatto un favorone!\\nGrazie per essere venut[VAR 0x1100(00FF,0101)]oa fin qui![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_mizu_020_mizu_06",
      "hash64": "930AFA305CF0C9D2",
      "text": "Oh! E scusa se il mio apprendista ti ha infastidito![VAR 0x0114(0018)]",
