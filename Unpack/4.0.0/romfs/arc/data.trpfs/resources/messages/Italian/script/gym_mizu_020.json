          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "gym_mizu_020_mizu_11",
      "hash64": "930E79305CF3D776",
      "text": "Che tonicità! Non serve neanche toccarle, si vede\\nche sono ricche di sostanze nutritive![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "gym_mizu_020_mizu_12",
      "hash64": "930E78305CF3D5C3",
      "text": "E che lucentezza! Quasi abbagliano da quanto\\nriflettono la luce![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_mizu_020_mizu_13",
      "hash64": "930E77305CF3D410",
      "text": "Per non parlare di quel forte profumo di mare!\\nSono chiaramente freschissime![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "gym_mizu_020_mizu_14",
      "hash64": "930E7E305CF3DFF5",
      "text": "Corpo di mille Dondozo, LE VOGLIO![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "gym_mizu_020_mizu_15",
      "hash64": "930E7D305CF3DE42",
      "text": "Ma torniamo a noi! Devi avere davvero un palato\\nfine se vuoi sfidare la Palestra di Garrafopoli![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "gym_mizu_020_mizu_16",
      "hash64": "930E7C305CF3DC8F",
      "text": "Ora hai l’occasione di dimostrarlo! Partecipa\\nall’asta al posto mio e aggiudicati quelle alghe![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "gym_mizu_020_select_03",
      "hash64": "54C29BBBFD7524B4",
      "text": "Come funziona un’asta?",
      "flags": 0,
