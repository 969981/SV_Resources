    },
    {
      "ordinal": 8,
      "label": "gym_mizu_020_trainer_01b",
      "hash64": "033218E8AA806199",
      "text": "Tranquillo, capitano! Vado io a cercarlo di corsa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_020_trainer_02",
      "hash64": "0B79F51B0482ECC8",
      "text": "Ah! E tu che vuoi? Se cerchi il capitano Algaro,\\nbeh, mi dispiace ma ora ha da fare!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_020_trainer_03",
      "hash64": "0B79F61B0482EE7B",
      "text": "Non mi interessa chi sei, se intendi disturbarlo\\ndevi vedertela col suo apprendista numero uno!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_020_trainer_04",
      "hash64": "0B79FB1B0482F6FA",
      "text": "Siamo impegnatissimi, qui! Non vorrai mica\\ndirmi che il tuo affare è più urgente del nostro?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_020_select_a",
      "hash64": "3ECD48AC469CDCAC",
      "text": "L’hai detto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_020_select_b",
      "hash64": "3ECD4BAC469CE1C5",
      "text": "Beh, in effetti no...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_020_trainer_05",
      "hash64": "0B79FC1B0482F8AD",
      "text": "E allora tornatene a casa, che noialtri\\nstiamo lavorando!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_020_trainer_06",
      "hash64": "0B79F91B0482F394",
      "text": "Hai la testa dura, moccios[VAR 0x1100(00FF,0101)]oa! Te la sei voluta tu!\\nOra ci penso io a farti stare buon[VAR 0x1100(00FF,0101)]oa!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_020_trainer_07",
      "hash64": "0B79FA1B0482F547",
      "text": "Ah, povero me! Non ho più un soldo!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "gym_mizu_020_mizu_01",
      "hash64": "930AF5305CF0C153",
      "text": "Ehia! Avanti, avanti! Cos’è questa baraonda?\\nCosa bolle in pentola, qui...?[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_mizu_020_trainer_08",
      "hash64": "0B79EF1B0482E296",
      "text": "Ca-Capitano Algaro! Quest[VAR 0x1100(00FF,0101)]oa ragazzin[VAR 0x1100(00FF,0101)]oa qui\\nstava...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
