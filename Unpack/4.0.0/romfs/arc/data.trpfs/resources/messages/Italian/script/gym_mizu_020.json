      "label": "gym_mizu_020_mizu_23",
      "hash64": "93117F305CF6177F",
      "text": "Se ti sono avanzati dei soldi, tienili pure\\ncome mancia!\\c\\nPuoi anche usarli per qualche altra asta,\\nse preferisci![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
