      "hash64": "93117A305CF60F00",
      "text": "Per tutti i mari! Non c’è! È sparito!![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
