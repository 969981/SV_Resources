          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "gym_mizu_020_mizu_08",
      "hash64": "930AFC305CF0CD38",
      "text": "Quindi eravamo tutti e due un po’ sulle spine.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "gym_mizu_020_shop_01",
      "hash64": "4C49FA89878568CE",
      "text": "Signore e signori, osservate l’ultimo, imperdibile\\nlotto di oggi!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "gym_mizu_020_mizu_09",
      "hash64": "930AFD305CF0CEEB",
      "text": "Bluh?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "gym_mizu_020_shop_02",
      "hash64": "4C49F9898785671B",
      "text": "Ecco il nostro pezzo forte di oggi: le leggendarie\\nalghe di Hoenn! Ci sono partecipanti?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "gym_mizu_020_mizu_10",
      "hash64": "930E7A305CF3D929",
      "text": "Blublub![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
