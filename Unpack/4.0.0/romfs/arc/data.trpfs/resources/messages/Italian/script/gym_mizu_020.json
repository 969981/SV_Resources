    {
      "ordinal": 62,
      "label": "gym_mizu_020_system_02",
      "hash64": "C2234DBAFFC0FFB4",
      "text": "Hai consegnato le alghe leggendarie ad Algaro!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
