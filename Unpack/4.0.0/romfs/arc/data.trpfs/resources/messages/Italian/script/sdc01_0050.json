          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0050_caretaker_04",
      "hash64": "359CCBD235905884",
      "text": "Se posso chiedere... per caso quei due ragazzini\\ndi prima ti hanno dato fastidio?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0050_caretaker_05",
      "hash64": "359CCCD235905A37",
      "text": "Guarda, con loro non so proprio che Magikarp\\npigliare...\\c\\nRubra in particolare è sempre stata una tipa\\ndifficile. Spero non ti abbia importunato troppo.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 154,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0050_caretaker_06",
      "hash64": "359CCDD235905BEA",
      "text": "Come dici?! Alla fermata della corriera c’è\\nuno studente che si sente poco bene?![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0050_caretaker_07",
      "hash64": "359CCED235905D9D",
      "text": "Allora non c’è tempo da perdere. Mi armo subito\\ndi medicine e vado a vedere come sta![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0050_caretaker_08",
      "hash64": "359CBFD235904420",
      "text": "Tu vai pure avanti e aspettami al circolo\\ncomunale.[VAR 0x0114(0045)]",
