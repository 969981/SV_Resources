          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0050_caretaker_03",
      "hash64": "359CCAD2359056D1",
      "text": "Mi presento: sono il responsabile del circolo\\ncomunale e gestisco molte strutture del paese.\\c\\nSarò io a prendermi cura di voi durante la vostra\\npermanenza.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
