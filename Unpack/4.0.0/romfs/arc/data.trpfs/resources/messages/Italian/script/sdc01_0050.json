        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0050_caretaker_09",
      "hash64": "359CC0D2359045D3",
      "text": "A più tardi![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
