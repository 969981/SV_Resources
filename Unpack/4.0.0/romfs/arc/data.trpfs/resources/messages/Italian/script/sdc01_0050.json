    {
      "ordinal": 32,
      "label": "sdc01_0050_caretaker_10",
      "hash64": "35A04DD235936B41",
      "text": "La strada che porta al paese è un po’\\nmalridotta...\\c\\nNon sai a quanta gente viene il mal d’auto\\na percorrerla![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
