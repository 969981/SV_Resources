    {
      "ordinal": 14,
      "label": "sdc02_4kings_a_04_firebb_14",
      "hash64": "12D1705DCDC3458C",
      "text": "Scusa, ho abbassato troppo la fiamma...\\nComunque sei davvero forte, [VAR 0x0100(0000)]!![VAR 0x0114(0047)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
