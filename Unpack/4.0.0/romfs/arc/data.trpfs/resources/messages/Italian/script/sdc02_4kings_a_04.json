          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_04_firebb_07",
      "hash64": "12D4F35DCDC659FC",
      "text": "Se voglio lottare, lotto! Non trovi che sia più\\nsemplice, così?![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
