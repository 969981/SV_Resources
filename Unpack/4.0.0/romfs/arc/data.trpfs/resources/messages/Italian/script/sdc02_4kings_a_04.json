    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_04_firebb_05",
      "hash64": "12D4F55DCDC65D62",
      "text": "Se uno ha qualcosa da dire, lo deve dire subito![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
