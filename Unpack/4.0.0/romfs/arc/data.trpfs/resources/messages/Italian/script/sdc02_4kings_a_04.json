    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_04_firebb_06",
      "hash64": "12D4F45DCDC65BAF",
      "text": "E io non sono certo il tipo da star lì a rimuginare\\nsu tutti i dettagli![VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
