    {
      "ordinal": 0,
      "label": "a_sch_shop01_eve01",
      "hash64": "56B8FBC8C1F1307B",
      "text": "Il mio Pokémon si addormenta sempre\\novunque sia!\\c\\nChe stia usando la mossa Riposo per recuperare\\nle energie?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
