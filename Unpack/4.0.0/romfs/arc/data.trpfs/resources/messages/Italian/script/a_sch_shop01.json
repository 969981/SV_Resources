      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "a_sch_shop01_eve08",
      "hash64": "56B8F2C8C1F12130",
      "text": "Che buono il profumo del pane appena sfornato!\\nNon resisto! Alla fine lo compro sempre!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "a_sch_shop01_eve09",
      "hash64": "56B8F3C8C1F122E3",
      "text": "A te ti piace il pane? A me mi piacciono di più\\nle polpette di riso!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
