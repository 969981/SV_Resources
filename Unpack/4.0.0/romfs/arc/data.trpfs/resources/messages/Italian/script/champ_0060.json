      "hash64": "04D13B04809124DB",
      "text": "Tieni! Un piccolo regalo per ringraziarti\\ndella bella lotta![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
