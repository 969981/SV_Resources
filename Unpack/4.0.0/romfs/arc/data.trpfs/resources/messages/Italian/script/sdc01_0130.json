        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0130_sister_11",
      "hash64": "05D81F9DE4B20611",
      "text": "Dai, prestami il tuo Bastone Rotoselfie! Voglio\\nscattare una foto ricordo.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
