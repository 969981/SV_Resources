    },
    {
      "ordinal": 19,
      "label": "sdc01_0130_sister_08",
      "hash64": "05DB9C9DE4B5104F",
      "text": "Ah?! Ma se io ne so molto più di te\\nsulle tradizioni di Nordivia!\\c\\nMostra un po’ più di rispetto per tua sorella\\nmaggiore![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
