    {
      "ordinal": 18,
      "label": "sdc01_0130_brother_04",
      "hash64": "D4DE2CC737F619ED",
      "text": "I-Io? Niente! È solo che, insomma... si vede che\\nnon conosci per niente l’orco della leggenda.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
