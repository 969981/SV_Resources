        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0130_brother_05",
      "hash64": "D4DE2BC737F6183A",
      "text": "Uff...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
