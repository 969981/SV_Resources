    },
    {
      "ordinal": 16,
      "label": "sdc01_0130_brother_03",
      "hash64": "D4DE25C737F60E08",
      "text": "Ih ih ih...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
