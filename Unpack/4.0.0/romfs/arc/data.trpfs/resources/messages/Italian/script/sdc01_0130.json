      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_0130_sister_02",
      "hash64": "05DBA69DE4B5214D",
      "text": "Eheheh... Nordivia riesce a tenere testa\\nanche alle vostre metropoli![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0130_sister_03",
      "hash64": "05DBA59DE4B51F9A",
      "text": "Che c’è? Questo spettacolo t’ha lasciat[VAR 0x1100(00FF,0101)]oa senza\\nparole?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 3,
