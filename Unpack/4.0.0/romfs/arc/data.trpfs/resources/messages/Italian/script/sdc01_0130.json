    {
      "ordinal": 17,
      "label": "sdc01_0130_sister_07",
      "hash64": "05DBA19DE4B518CE",
      "text": "Mmmh? Che hai da ridere, tu?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
