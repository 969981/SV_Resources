      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0130_select_01",
      "hash64": "B3C352491FE42AFC",
      "text": "Ebbene sì!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
