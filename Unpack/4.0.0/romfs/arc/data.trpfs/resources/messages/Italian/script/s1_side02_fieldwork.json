    },
    {
      "ordinal": 31,
      "label": "s1_side02_fieldwork_sazare_pokehint_08",
      "hash64": "28306555EE017A1C",
      "text": "Verrà fuori una bella raccolta di foto di Pokémon\\ndi vari tipi.\\c\\nI Pokémon di tipo Spettro vanno fotografati\\nprima che scompaiano![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
