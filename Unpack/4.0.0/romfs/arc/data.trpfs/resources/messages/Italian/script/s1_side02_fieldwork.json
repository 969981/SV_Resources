          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_side02_fieldwork_sazare_pokehint_02",
      "hash64": "28306F55EE018B1A",
      "text": "Assistente, te la cavi bene con la macchina\\nfotografica!\\c\\nHai provato a cercare in alto? Ci potrebbero\\nessere dei Pokémon anche sugli alberi![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_side02_fieldwork_sazare_pokehint_03",
      "hash64": "28307055EE018CCD",
      "text": "Assistente, devo dire che hai occhio per le foto!\\c\\nScommetto che riusciresti a immortalare per bene\\nanche Pokémon in movimento.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_side02_fieldwork_sazare_pokehint_04",
      "hash64": "28306955EE0180E8",
      "text": "Assistente, non te ne lasci scappare uno, eh!\\c\\nDovrebbero esserci dei Pokémon anche nelle\\ngrotte qui intorno. So che riuscirai a fotografarli![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_side02_fieldwork_sazare_pokehint_05",
      "hash64": "28306A55EE01829B",
      "text": "Hai un talento naturale per la fotografia!\\c\\nPer te sarà un gioco da ragazzi immortalare\\ni Pokémon che vivono nello specchio d’acqua\\r\\nche si trova a nord-ovest![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 163,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
