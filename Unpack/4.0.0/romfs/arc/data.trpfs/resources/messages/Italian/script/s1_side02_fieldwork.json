    },
    {
      "ordinal": 29,
      "label": "s1_side02_fieldwork_sazare_pokehint_06",
      "hash64": "28306B55EE01844E",
      "text": "Mmh... Questa è proprio venuta bene!\\c\\nComunque, prima in una zona rocciosa all’ombra\\nsono inciampata su qualcosa.\\r\\nFai attenzione a dove metti i piedi![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
