    {
      "ordinal": 30,
      "label": "s1_side02_fieldwork_sazare_pokehint_07",
      "hash64": "28306C55EE018601",
      "text": "Ormai ci hai preso la mano, eh?\\c\\nTi direi di non avvicinarti troppo ai Pokémon\\npiù guardinghi, perché scappano via...\\r\\nMa ho come l’impressione che tu lo sappia già.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
