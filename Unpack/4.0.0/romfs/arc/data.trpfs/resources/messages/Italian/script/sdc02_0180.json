    },
    {
      "ordinal": 12,
      "label": "sdc02_0180_dragonbb_09",
      "hash64": "6A5BC4E1902FC27D",
      "text": "A un certo punto, però... è cambiato.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
