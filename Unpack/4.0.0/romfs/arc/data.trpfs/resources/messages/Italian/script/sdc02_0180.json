    {
      "ordinal": 16,
      "label": "sdc02_0180_reception_03",
      "hash64": "B94DB3F7E1543BB1",
      "text": "Mi scuso per l’attesa. È tutto pronto.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc02_0180_reception_04",
      "hash64": "B94DB4F7E1543D64",
      "text": "Vuoi sfidare Riben, il Campione della Lega\\nMirtillo?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sdc02_0180_reception_05",
      "hash64": "B94DB5F7E1543F17",
      "text": "Torna pure quando avrai ultimato tutti\\ni preparativi.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc02_0180_reception_06",
      "hash64": "B94DB6F7E15440CA",
      "text": "D’accordo. La sfida inizierà a breve.\\nTi prego di prepararti.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
