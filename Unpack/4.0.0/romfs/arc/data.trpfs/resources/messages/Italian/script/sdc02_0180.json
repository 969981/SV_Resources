    {
      "ordinal": 3,
      "label": "sdc02_0180_reception_02",
      "hash64": "B94DB2F7E15439FE",
      "text": "Dammi un minuto: sbrigo subito le pratiche\\nper la sfida contro il Campione.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
