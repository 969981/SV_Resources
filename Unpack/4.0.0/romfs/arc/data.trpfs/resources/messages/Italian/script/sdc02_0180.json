    },
    {
      "ordinal": 14,
      "label": "sdc02_0180_dragonbb_11",
      "hash64": "6A5F40E19032CB08",
      "text": "Bisogna che qualcuno gli dia una svegliata.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
