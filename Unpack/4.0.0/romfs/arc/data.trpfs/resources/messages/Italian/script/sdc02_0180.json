    {
      "ordinal": 2,
      "label": "sdc02_0180_reception_01",
      "hash64": "B94DB1F7E154384B",
      "text": "Tu sei [VAR 0x0100(0000)], dico bene?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
