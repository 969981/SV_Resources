          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_bb4kings_honoo_sp01_05",
      "hash64": "C24D3251CE031C97",
      "text": "E io che sono il più debole dei Superquattro,\\npurtroppo... dovrò abbandonare la compagnia![VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
