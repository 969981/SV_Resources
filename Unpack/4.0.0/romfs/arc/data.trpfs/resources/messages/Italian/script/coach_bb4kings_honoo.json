            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb4kings_honoo_sp03_01",
      "hash64": "4600625FCBEC51A9",
      "text": "Pare che mi faranno restare tra i Superquattro![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
