    },
    {
      "ordinal": 8,
      "label": "coach_bb4kings_honoo_sp01_select_01",
      "hash64": "3E4ABBAA2F752252",
      "text": "Ah, davvero?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_bb4kings_honoo_sp01_select_02",
      "hash64": "3E4ABAAA2F75209F",
      "text": "Scusa!",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "coach_bb4kings_honoo_sp01_06",
      "hash64": "C24D3351CE031E4A",
      "text": "Già, è una bella rottura! Però le regole sono\\nqueste, che ci possiamo fare?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb4kings_honoo_sp01_07",
      "hash64": "C24D3451CE031FFD",
      "text": "L’importante è che l’atmosfera del Club Lega sia\\ntornata quella di prima. Sono più contento così![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb4kings_honoo_sp01_08",
      "hash64": "C24D2551CE030680",
      "text": "È tutto merito tuo, [VAR 0x0100(0000)]!\\nVolevo solo dirti questo, così, a fiamma viva.\\r\\nGrazie![VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
