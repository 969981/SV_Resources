            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb4kings_honoo_sp03_select_01",
      "hash64": "23BA9267B1786E38",
      "text": "Che bello!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_honoo_sp03_select_02",
      "hash64": "23BA9567B1787351",
      "text": "Perché?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_honoo_sp03_02",
      "hash64": "46005F5FCBEC4C90",
      "text": "Sì, troppo bello! Oppure no? Boh, non lo so\\nnemmeno io![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_bb4kings_honoo_sp03_02b",
      "hash64": "DEEF01C78286BF36",
      "text": "Boh? Non lo so nemmeno io![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_bb4kings_honoo_sp03_03",
      "hash64": "4600605FCBEC4E43",
      "text": "Non ho ben capito, ma a quanto pare Riben\\nha deciso di interrompere gli studi...[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_bb4kings_honoo_sp03_04",
      "hash64": "4600655FCBEC56C2",
      "text": "Quindi la classifica della LeMi rimarrà congelata\\nper un po’... O qualcosa del genere![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_bb4kings_honoo_sp03_05",
      "hash64": "4600665FCBEC5875",
      "text": "Rupi me l’ha anche spiegato, ma era troppo\\ncomplicato e ora non ricordo più nulla![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_bb4kings_honoo_sp03_06",
      "hash64": "4600635FCBEC535C",
      "text": "I Superquattro hanno diritto a una base nelle\\nvarie piazze del Bioterarium, e questo mi torna\\r\\nsempre utile, quindi tanto meglio![VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_bb4kings_honoo_trade_01_00",
      "hash64": "AA4C118044763190",
      "text": "... Ops, scusa! È che mi sembra di poter parlare\\ndi tutto con te![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_bb4kings_honoo_trade_01_01",
      "hash64": "AA4C128044763343",
      "text": "Vorrei che la nostra amicizia bruciasse a fiamma\\npiù alta! Che ne dici, [VAR 0x0100(0000)]?[VAR 0x0114(0047)]",
