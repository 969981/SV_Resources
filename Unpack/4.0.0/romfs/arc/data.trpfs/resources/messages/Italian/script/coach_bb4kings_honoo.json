          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_bb4kings_honoo_sp01_04",
      "hash64": "C24D3151CE031AE4",
      "text": "E non è tutto! Visto che ora sei Campione[VAR 0x1100(00FF,0300)]ssa,\\nRiben retrocederà a Superquattro...[VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0300"
