      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0485_bbteacher_03",
      "hash64": "7248959413607305",
      "text": "Prego, signor responsabile, a lei la parola![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
