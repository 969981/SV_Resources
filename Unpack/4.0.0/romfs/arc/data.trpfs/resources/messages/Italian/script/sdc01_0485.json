          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0485_caretaker_02",
      "hash64": "3150FED224DF8B20",
      "text": "Ho il piacere di annunciarvi che tutte le coppie\\ndi partecipanti hanno terminato il giro dei cartelli\\r\\nalla scoperta della storia di Nordivia...\\c\\nDichiaro quindi conclusa la prova d’orientamento![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 101,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 199,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0020_student1_01",
      "hash64": "A97DD108C793D8D8",
      "text": "Evvivaaa!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc01_0020_student2_01",
      "hash64": "51D209012B15592F",
      "text": "È stato uno spasso!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc01_0485_caretaker_03",
      "hash64": "3150FFD224DF8CD3",
      "text": "Mi fa piacere sentirlo!\\nGrazie per aver partecipato![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0485_caretaker_04",
      "hash64": "315104D224DF9552",
      "text": "Ecco qui un piccolo premio per voi![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0485_system_01",
      "hash64": "F3BEBB968EFF4758",
      "text": "Ricevi un [VAR 0xFF00(0008)]assortimento di mochi di Nordivia[VAR 0xFF00(0000)]\\ndal responsabile!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0485_system_02",
      "hash64": "F3BEBE968EFF4C71",
      "text": "Hai messo l’assortimento di mochi di Nordivia\\nnella tasca [VAR 0xFF00(0008)]Strumenti vari[VAR 0xFF00(0000)].",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0485_caretaker_05",
      "hash64": "315105D224DF9705",
      "text": "Ad essere sincero, pensavo che ci avreste messo\\ndi più! Siete tutti degli studenti ammirevoli![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0485_caretaker_06",
      "hash64": "315102D224DF91EC",
      "text": "Manca ancora un po’ alla fine del viaggio\\ndi studio...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0485_caretaker_07",
      "hash64": "315103D224DF939F",
      "text": "Quindi sentitevi pure liberi di continuare a\\nesplorare Nordivia, se vi fa piacere.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0485_caretaker_08",
      "hash64": "315108D224DF9C1E",
      "text": "Professoressa, lei voleva aggiungere qualcosa?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0485_bbteacher_04",
      "hash64": "72488E9413606720",
      "text": "Purtroppo devo informarvi che per motivi\\ndi forza maggiore, io, Rubra e Riben dovremo\\r\\nfar ritorno all’Istituto Mirtillo prima del previsto.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0485_select_01",
      "hash64": "D8F9CE96FF99CA23",
      "text": "Che peccato!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sdc01_0485_select_02",
      "hash64": "D8F9CF96FF99CBD6",
      "text": "Come mai?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc01_0485_bbteacher_05",
      "hash64": "72488F94136068D3",
      "text": "Sono davvero desolata, ma ci sono novità sulla\\nVoragine di Paldea e sono costretta a rientrare.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0485_bbteacher_06",
      "hash64": "7248909413606A86",
      "text": "Comunque, vi sono stata accanto fino ad ora,\\ne ho potuto vedere quanto siete in gamba.\\c\\nSo che ve la caverete a meraviglia anche senza\\ndi me.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0485_bbteacher_07",
      "hash64": "7248919413606C39",
      "text": "Signor responsabile, da ora in avanti affido a lei\\ngli altri ragazzi.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0485_caretaker_09",
      "hash64": "315109D224DF9DD1",
      "text": "Ma certo, nessun problema.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0485_bbteacher_08",
      "hash64": "72489A9413607B84",
      "text": "E infine... Rubra, anche tu volevi dire qualcosa,\\ngiusto?[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0485_sister_02",
      "hash64": "A3B6622AC7E88306",
      "text": "Sì...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0485_sister_03",
      "hash64": "A3B6632AC7E884B9",
      "text": "Mio fratello non sta molto bene e non è\\npotuto venire, quindi parlo anche per lui...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0485_sister_04",
      "hash64": "A3B6642AC7E8866C",
      "text": "Beh... Come tutti sapete, io sono cresciuta\\nin questo paesino.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0485_sister_05",
      "hash64": "A3B6652AC7E8881F",
      "text": "E non mi è mai andato giù che dei forestieri\\ncome voi venissero qui.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0020_student1_02",
      "hash64": "A97DD408C793DDF1",
      "text": "Davvero...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "sdc01_0485_sister_06",
      "hash64": "A3B6662AC7E889D2",
      "text": "Era come se qualcuno stesse entrando a casa\\nnostra con le scarpe piene di fango...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0485_sister_07",
      "hash64": "A3B6672AC7E88B85",
      "text": "Però, ora che ho passato del tempo assieme\\na voi, mi sono accorta di quanto mi sbagliassi.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0485_sister_08",
      "hash64": "A3B6682AC7E88D38",
      "text": "Anzi, chiacchierando con tutti voi mi sono pure\\ndivertita.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0485_sister_09",
      "hash64": "A3B6692AC7E88EEB",
      "text": "Diciamo che... ho capito che è sbagliato\\navere pregiudizi![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_0485_sister_10",
      "hash64": "A3B9E62AC7EB9929",
      "text": "Quindi... Niente... Volevo solo dirvi che è stata\\nuna gioia conoscervi! Grazie per essere venuti![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_0485_sister_11",
      "hash64": "A3B9E52AC7EB9776",
      "text": "Soprattutto tu, [VAR 0x0100(0000)]...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc01_0485_sister_12",
      "hash64": "A3B9E42AC7EB95C3",
      "text": "Sono contenta che fra tutte le persone che\\npotevano capitare qui, sia arrivat[VAR 0x1100(00FF,0101)]oa proprio tu.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc01_0485_sister_13",
      "hash64": "A3B9E32AC7EB9410",
      "text": "Beh, in ogni caso, spero che questa non sia\\nl’ultima volta che ci vediamo.[VAR 0x0114(0044)]",
