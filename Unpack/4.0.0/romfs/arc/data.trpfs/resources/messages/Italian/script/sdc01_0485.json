          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0485_caretaker_01",
      "hash64": "315101D224DF9039",
      "text": "Grazie! Ebbene, ehm... Buongiorno a tutti![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
