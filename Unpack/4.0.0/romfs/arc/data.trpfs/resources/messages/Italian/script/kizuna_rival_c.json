    {
      "ordinal": 9,
      "label": "kizuna_rival_c_07b",
      "hash64": "F790D3772D7ED73E",
      "text": "Beh, non hai tutti i torti... Vincere è più bello che\\nperdere, ma anche perdere ha il suo perché![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
