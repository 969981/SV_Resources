        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_rival_c_04",
      "hash64": "05FBEDD5E6CC85C1",
      "text": "Beh, l’altro giorno l’ho rivisto nell’atrio e l’ho\\nsubito sfidato. Ma lui mi ha detto di no![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
