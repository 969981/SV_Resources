      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_rival_c_select_02",
      "hash64": "AA608AC26FF60DC0",
      "text": "Sarà... Però vincere è meglio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_rival_c_07a",
      "hash64": "F790D2772D7ED58B",
      "text": "Vero?! Vabbè, è chiaro che a nessuno piace\\nperdere, però si può imparare molto anche da\\r\\nuna sconfitta, ecco![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
