          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_rival_c_10",
      "hash64": "05F86BD5E6C97304",
      "text": "E poi non sono mica perfetta! Sono ancora\\nun disastro a lanciare le Poké Ball, ad esempio...[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
