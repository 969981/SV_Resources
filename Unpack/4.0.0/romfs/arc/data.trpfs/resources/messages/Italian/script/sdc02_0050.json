          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0050_fairybb_05",
      "hash64": "180467564E51166D",
      "text": "Preside Bluebert, non m’interrompa per favore,\\npotrei perdere il filo...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0050_fairybb_06",
      "hash64": "180464564E511154",
      "text": "Dicevo, qui la brezza marina è piacevole,\\ncosì quando non ci sono sfide gli studenti\\r\\nin pausa vengono a rilassarsi sulle gradinate.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
