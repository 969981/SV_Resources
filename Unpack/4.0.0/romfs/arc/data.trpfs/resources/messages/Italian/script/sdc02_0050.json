          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0050_fairybb_04",
      "hash64": "180466564E5114BA",
      "text": "Vedrai che qui avrai molte più occasioni che\\nin altre scuole per far lottare i tuoi Pokémon![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0050_headbb_01",
      "hash64": "94C8213947E4A4F8",
      "text": "Giusto, giusto! Proprio così![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
