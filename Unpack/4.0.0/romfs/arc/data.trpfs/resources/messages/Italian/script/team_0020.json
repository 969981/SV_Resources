          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "team_0020_cassiopeia_10",
      "hash64": "062DFC805A902265",
      "text": "Sono il preced... No, ti basti sapere che io e\\nil Team Star abbiamo dei conti in sospeso.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "team_0020_nelke_11",
      "hash64": "08278CF2E5576A42",
      "text": "Capisco. Allora non chiedo altro.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
