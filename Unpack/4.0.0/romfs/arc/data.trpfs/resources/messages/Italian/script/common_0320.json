      ]
    },
    {
      "ordinal": 8,
      "label": "common_0320_friend_02",
      "hash64": "BC71D05D2B33ECB2",
      "text": "Sono io, Pepe! Volevo assicurarmi che fossi\\nriuscit[VAR 0x1100(00FF,0101)]oa a partire senza problemi![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
