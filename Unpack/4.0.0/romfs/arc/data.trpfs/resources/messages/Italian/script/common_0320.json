    {
      "ordinal": 0,
      "label": "common_0320_system_01",
      "hash64": "C369BD5C68FE9F90",
      "text": "Rotoroto-rotoroto-rotoroto...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_0320_rival_01",
      "hash64": "BA4146DC052E9BAD",
      "text": "Pronto? Ciao, sono io, Nemi![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
