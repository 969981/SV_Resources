      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0230_ground_01",
      "hash64": "82F883171B541B04",
      "text": "Se dice \"vendicarti\", Verì! Nun so’ mica ’na\\nBaccauva![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
