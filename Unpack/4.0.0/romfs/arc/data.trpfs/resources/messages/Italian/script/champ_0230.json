    {
      "ordinal": 4,
      "label": "champ_0230_steel_03",
      "hash64": "B87B02FC2206410C",
      "text": "I tuoi attacchi debolissimi non ci faranno neanche\\nun graffio, vedrai.[VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
