    },
    {
      "ordinal": 8,
      "label": "champ_0230_ground_02",
      "hash64": "82F886171B54201D",
      "text": "Me dispiace, pischellé, ma ’na sconfitta è\\n’na sconfitta. Chiama il prossimo, daje![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
