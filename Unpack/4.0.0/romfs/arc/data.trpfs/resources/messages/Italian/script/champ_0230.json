    {
      "ordinal": 6,
      "label": "champ_0230_steel_05",
      "hash64": "B87B00FC22063DA6",
      "text": "Nooo! Ma non è giusto!!! Io volevo vendemmiarti\\ne invece...[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
