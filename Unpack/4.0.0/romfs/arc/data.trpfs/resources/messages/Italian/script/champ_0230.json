    },
    {
      "ordinal": 9,
      "label": "champ_0230_steel_06",
      "hash64": "B87AFFFC22063BF3",
      "text": "Ooh, hai ragione! Dall’ultima volta è passato così\\ntanto tempo che me lo stavo per dimenticare.[VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
