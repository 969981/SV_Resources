    },
    {
      "ordinal": 5,
      "label": "champ_0230_steel_04",
      "hash64": "B87B01FC22063F59",
      "text": "Venite fuori, amici miei![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
