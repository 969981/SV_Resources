      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_0210_select_02",
      "hash64": "04F745F15E1EA2B2",
      "text": "Quale cosa?",
      "flags": 0,
      "text_status": "DECODED",
