          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sdc02_0230_chairman_17",
      "hash64": "7A9E1C6FC1E19774",
      "text": "Motivo per cui...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "sdc02_0230_bbteacher_17",
      "hash64": "FA3035C9DB9C0807",
      "text": "... avete selezionato la sottoscritta, che richiede\\ndi esplorare l’Area Zero ormai da molto tempo.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
