    {
      "ordinal": 49,
      "label": "sdc02_0230_bbteacher_18",
      "hash64": "FA302AC9DB9BF556",
      "text": "Ovviamente nessuno può obbligarvi, ma avervi\\ncon me sarebbe un aiuto prezioso![VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
