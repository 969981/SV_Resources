    {
      "ordinal": 50,
      "label": "sdc02_0230_bbteacher_19",
      "hash64": "FA302BC9DB9BF709",
      "text": "Quindi... che ne dite di partire tutti insieme\\nper esplorare l’Area Zero?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
