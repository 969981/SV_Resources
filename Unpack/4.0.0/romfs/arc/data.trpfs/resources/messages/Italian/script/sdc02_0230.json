          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "sdc02_0230_select_05",
      "hash64": "93842D741EF6945E",
      "text": "Conti su di me!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "sdc02_0230_select_06",
      "hash64": "93842C741EF692AB",
      "text": "Non saprei...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "sdc02_0230_chairman_21",
      "hash64": "7AA1226FC1E3D77D",
      "text": "Esattamente quello che mi aspettavo\\ndal[VAR 0x1100(00FF,0E09)] Campionela Campionessa.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0E09"
          ]
        },
        {
          "kind": "control",
          "offset_units": 68,
