          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc02_0230_bbteacher_16",
      "hash64": "FA3034C9DB9C0654",
      "text": "Si figuri, proceda pure.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc02_0230_chairman_08",
      "hash64": "7A9A8D6FC1DE6EA0",
      "text": "Vi porgo le mie scuse per non essermi ancora\\npresentata. Mi chiamo Alisma, e rivesto il ruolo\\r\\ndi presidentessa della Lega Pokémon di Paldea.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc02_0230_chairman_09",
      "hash64": "7A9A8E6FC1DE7053",
      "text": "Poco più di una decina di anni fa, la Lega\\nPokémon decise di supportare le ricerche\\r\\nsull’Area Zero, la voragine al centro di Paldea.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc02_0230_chairman_10",
      "hash64": "7A9E1B6FC1E195C1",
      "text": "Ora che quella fase è conclusa, ci occupiamo\\ndi monitorare e gestire il territorio al suo interno.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc02_0230_chairman_11",
      "hash64": "7A9E1A6FC1E1940E",
      "text": "L’Area Zero è un luogo colmo di pericoli\\ne misteri...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc02_0230_chairman_12",
      "hash64": "7A9E196FC1E1925B",
      "text": "Di norma non permettiamo a nessuno l’accesso,\\ne meno che mai le ricerche in loco.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc02_0230_chairman_13",
      "hash64": "7A9E186FC1E190A8",
      "text": "Tuttavia...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0230_chairman_14",
      "hash64": "7A9E1F6FC1E19C8D",
      "text": "Di recente abbiamo rischiato che alcuni Pokémon\\nparticolarmente feroci salissero in superficie...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "sdc02_0230_chairman_15",
      "hash64": "7A9E1E6FC1E19ADA",
      "text": "E ciò mi ha convinta della necessità di riprendere\\nle ricerche nell’area il più presto possibile.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "sdc02_0230_chairman_16",
      "hash64": "7A9E1D6FC1E19927",
      "text": "La Lega Pokémon però non dispone né\\ndel personale adatto per questa operazione,\\r\\nné del tempo necessario per portarla a termine...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
