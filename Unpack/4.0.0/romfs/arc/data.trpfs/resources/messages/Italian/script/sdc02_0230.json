        }
      ]
    },
    {
      "ordinal": 55,
      "label": "sdc02_0230_sister_04",
      "hash64": "645DEC9FA07ED84D",
      "text": "Ehm... In quanto a me...\\nImmagino che la mia partecipazione sia scontata.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "sdc02_0230_bbteacher_20",
      "hash64": "FA2CACC9DB98E965",
      "text": "Sì, apprezzerei molto se potessi seguirmi\\ncome al solito.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "sdc02_0230_dragonbb_04",
      "hash64": "907620C937B44F70",
      "text": "Mi spiace, ma io ne resto fuori.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "sdc02_0230_dragonbb_05",
      "hash64": "907621C937B45123",
      "text": "Il Club Lega è nel caos, non posso mica\\npiantare tutti ora.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "sdc02_0230_sister_05",
      "hash64": "645DEB9FA07ED69A",
      "text": "Sì, certo, bella scusa. Scommetto che non c’hai\\nvoglia, tutto lì.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "sdc02_0230_dragonbb_06",
      "hash64": "907622C937B452D6",
      "text": "Ehe-eh-eh, m’hai sgamato.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "sdc02_0230_dragonbb_07",
      "hash64": "907623C937B45489",
      "text": "L’ex-Campione invece che vuole fare?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "sdc02_0230_brother_03",
      "hash64": "179B38E7C9CE370E",
      "text": "Io... voglio andarci.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "sdc02_0230_brother_04",
      "hash64": "179B3BE7C9CE3C27",
      "text": "Se c’è davvero un Pokémon leggendario...\\nVoglio vederlo... voglio catturarlo.\\r\\nNon mi lascerò sfuggire quest’occasione.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
