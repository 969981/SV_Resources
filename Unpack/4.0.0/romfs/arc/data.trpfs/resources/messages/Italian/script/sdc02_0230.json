          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "sdc02_0230_chairman_19",
      "hash64": "7A9E126FC1E18676",
      "text": "L’Istituto Mirtillo vanta una schiera di Allenatori\\npreparati e talentuosi.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sdc02_0230_chairman_20",
      "hash64": "7AA1216FC1E3D5CA",
      "text": "[VAR 0xBD06(0000)]Sapere di poter contare anche sul[VAR 0x1100(00FF,0E09)] Campionela Campionessa\\n[VAR 0x0100(0000)] mi rasserena abbastanza da\\r\\naffidarvi\\r\\nquesto compito.[VAR 0x0114(0011)]",
