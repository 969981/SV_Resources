          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "sdc02_0230_dragonbb_08",
      "hash64": "90762CC937B463D4",
      "text": "Ah sì?[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "sdc02_0230_bbteacher_21",
      "hash64": "FA2CABC9DB98E7B2",
      "text": "Allora è deciso! È un peccato per Aris, ma\\nla squadra di ricerca sarà composta da me,\\r\\n[VAR 0x0100(0000)], Rubra e Riben.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
