      ]
    },
    {
      "ordinal": 17,
      "label": "class_d_02_language_10",
      "hash64": "F15751CD7B7FF34A",
      "text": "D’altronde, come non essere super happy\\nquando una persona di un altro paese ci dice\\r\\nche le piace il cibo della nostra terra?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
