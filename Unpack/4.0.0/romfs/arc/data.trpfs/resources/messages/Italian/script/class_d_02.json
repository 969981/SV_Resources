      ]
    },
    {
      "ordinal": 18,
      "label": "class_d_02_language_11",
      "hash64": "F15752CD7B7FF4FD",
      "text": "Ma adesso è il momento della dritta del giorno![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
