      ]
    },
    {
      "ordinal": 20,
      "label": "class_d_02_language_13",
      "hash64": "F15750CD7B7FF197",
      "text": "Non esiste persona al mondo a cui non piacciano\\ni complimenti![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
