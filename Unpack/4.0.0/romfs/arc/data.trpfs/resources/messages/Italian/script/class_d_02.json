      ]
    },
    {
      "ordinal": 19,
      "label": "class_d_02_language_12",
      "hash64": "F1574FCD7B7FEFE4",
      "text": "Il primo passo per una comunicazione efficace\\nè fare dei complimenti all’interlocutore![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
