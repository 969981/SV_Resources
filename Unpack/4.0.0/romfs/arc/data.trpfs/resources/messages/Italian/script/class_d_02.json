    {
      "ordinal": 5,
      "label": "class_d_02_language_04",
      "hash64": "F15ABBCD7B82DD3F",
      "text": "La volta scorsa abbiamo visto come si dice\\n\"Grazie!\" in varie lingue straniere.[VAR 0x0114(0026)]",
