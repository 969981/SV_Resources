    {
      "ordinal": 15,
      "label": "class_d_02_language_08",
      "hash64": "F15ABFCD7B82E40B",
      "text": "Se usate queste parole al mercato o al ristorante\\ndel posto, riceverete un bello smile![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
