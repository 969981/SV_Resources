    },
    {
      "ordinal": 15,
      "label": "coach_teacher_history_sp02_04",
      "hash64": "666D0FF03CD5C92A",
      "text": "Più tardi io e il mio Pokémon ci faremo una bella\\nnuotata! Voglio proprio esplorare quelle rovine![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
