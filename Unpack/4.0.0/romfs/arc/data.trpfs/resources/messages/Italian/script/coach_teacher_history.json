    },
    {
      "ordinal": 25,
      "label": "coach_teacher_history_sp03_02",
      "hash64": "8F3803E4F1FB7095",
      "text": "Ieri mi sono immersa con il mio Lumineon\\nper raggiungere le rovine subacquee di Unima...[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
