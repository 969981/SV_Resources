          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_history_sp03_03",
      "hash64": "8F3802E4F1FB6EE2",
      "text": "C... Che esperienza stupenda...\\nÈ stato... veramente il massimo...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_history_sp03_04",
      "hash64": "8F37FDE4F1FB6663",
      "text": "Antichi dispositivi per impedire l’accesso agli\\nintrusi! Antiche iscrizioni sulle pareti![VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_history_sp03_05",
      "hash64": "8F37FCE4F1FB64B0",
      "text": "Il confronto intellettuale con gli umani\\ndel passato è stato deliziosamente istruttivo![VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_history_sp03_06",
      "hash64": "8F37FFE4F1FB69C9",
      "text": "Tuttavia, sarebbe un peccato raggiungere\\nsubito la parte più recondita delle rovine.\\r\\nPreferisco esplorarle un po’ per volta.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
