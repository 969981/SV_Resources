    },
    {
      "ordinal": 14,
      "label": "coach_teacher_history_sp02_03",
      "hash64": "666D0AF03CD5C0AB",
      "text": "Gli occhi del Preside non possono arrivare fin\\nqui. Devo approfittare di questa occasione.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
