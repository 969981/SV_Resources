      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_history_trade_01_02",
      "hash64": "3D5AF6BE8D787D03",
      "text": "Va bene uno qualsiasi, basta che sia tuo.\\nSono sicura che mi sarà utile in qualche modo.\\r\\nIo ti do un Gimmighoul... Che ne dici?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
