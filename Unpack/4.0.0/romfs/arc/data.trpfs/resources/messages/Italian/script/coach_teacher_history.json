            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_history_sp03_01b",
      "hash64": "5794A3072E3703FA",
      "text": "Uh uh, tutt’altro... Sono così su di giri che ho\\nesaurito completamente le forze.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
