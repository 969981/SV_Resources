          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_history_sp01_05b",
      "hash64": "FB5565433062B998",
      "text": "Mmh? Sei più accomodante del previsto.\\nUh uh... Meglio così.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
