    },
    {
      "ordinal": 31,
      "label": "coach_teacher_history_trade_01_01",
      "hash64": "3D5AF7BE8D787EB6",
      "text": "Tu sei [VAR 0x1100(00FF,0E0B)]il Campionela Campionessa, no...? Perché non fai uno\\nscambio di Pokémon con me?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
