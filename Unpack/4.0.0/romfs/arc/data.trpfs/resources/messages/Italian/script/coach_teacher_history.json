      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_history_sp02_05",
      "hash64": "666D10F03CD5CADD",
      "text": "Uh uh! Ti pare che mi lasci sfuggire un’occasione\\nsimile?\\c\\nQualunque cosa stimoli la mia curiosità\\narcheologica è un tesoro irrinunciabile per me![VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
