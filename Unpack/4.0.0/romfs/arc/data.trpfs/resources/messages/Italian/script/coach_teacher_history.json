    },
    {
      "ordinal": 10,
      "label": "coach_teacher_history_sp01_04",
      "hash64": "0D3851D6F584A61D",
      "text": "Sarai una marionetta sotto il mio controllo...\\nGongolo già all’idea![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
