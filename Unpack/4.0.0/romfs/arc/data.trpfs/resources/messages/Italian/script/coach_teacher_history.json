      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_history_sp03_select_02",
      "hash64": "8C4F427AD5A90E7E",
      "text": "Non si sente bene?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_history_sp03_01",
      "hash64": "8F3800E4F1FB6B7C",
      "text": "Non si vede? Sono così su di giri che ho esaurito\\ncompletamente le forze.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
