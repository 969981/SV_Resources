    },
    {
      "ordinal": 11,
      "label": "coach_teacher_history_sp02_00",
      "hash64": "666D0BF03CD5C25E",
      "text": "Ah, sei tu... ma più vecchi[VAR 0x1100(00FF,0101)]oa rispetto all’ultima\\nvolta che ci siamo vist[VAR 0x1100(00FF,0101)]ie.[VAR 0x0114(0027)]",
