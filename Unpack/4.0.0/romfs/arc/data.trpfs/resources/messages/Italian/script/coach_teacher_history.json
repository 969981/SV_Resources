      "ordinal": 4,
      "label": "coach_teacher_history_sp01_02",
      "hash64": "0D384BD6F5849BEB",
      "text": "Uh uh... Diciamo pure che ti ho fatto un favore.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
