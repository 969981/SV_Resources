      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_history_sp01_05",
      "hash64": "0D3850D6F584A46A",
      "text": "Uh uh! Sì invece, raccogli quello che hai seminato!\\nDal canto mio, spero in un raccolto abbondante.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
