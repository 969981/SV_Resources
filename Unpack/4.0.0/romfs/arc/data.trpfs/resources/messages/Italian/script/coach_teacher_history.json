      "hash64": "2FC3C3870821A010",
      "text": "Che bello!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_history_sp02_select_02",
      "hash64": "2FC3C6870821A529",
      "text": "Faccia attenzione",
