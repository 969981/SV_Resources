    },
    {
      "ordinal": 3,
      "label": "coach_teacher_history_sp01_01",
      "hash64": "0D384CD6F5849D9E",
      "text": "Sinceramente non avevo la minima voglia di\\nvenire, ma non volevo farti perdere la faccia.[VAR 0x0114(0027)]",
