    },
    {
      "ordinal": 57,
      "label": "coach_teacher_history_randomtalk_03",
      "hash64": "1E5F9987D3C01B17",
      "text": "Il tuo [VAR 0x0101(0001)] si sta rivelando utile.\\nMi dà una mano a esplorare le rovine.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
