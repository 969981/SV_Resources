    },
    {
      "ordinal": 13,
      "label": "coach_teacher_history_sp02_02",
      "hash64": "666D09F03CD5BEF8",
      "text": "Ad esempio, ci sono delle antiche rovine\\nsommerse che solleticano la mia curiosità![VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
