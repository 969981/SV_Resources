    {
      "ordinal": 5,
      "label": "coach_teacher_history_sp01_03",
      "hash64": "0D384AD6F5849A38",
      "text": "Uno di questi giorni potrai ricambiare facendo\\nciò che ti dico.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
