    },
    {
      "ordinal": 26,
      "label": "s1_sub_003_man_09",
      "hash64": "F2AB932F8DFAFB7D",
      "text": "Wow! Resti splendida anche dopo la sconfitta,\\nAbby![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
