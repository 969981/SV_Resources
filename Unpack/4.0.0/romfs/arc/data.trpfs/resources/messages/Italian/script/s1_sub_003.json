          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_sub_003_woman_17",
      "hash64": "C9E838545529AB94",
      "text": "Mi ascolti, plebe[VAR 0x1100(00FF,0101)]oa. È importante decidere come\\nmettere a frutto i propri risparmi.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
