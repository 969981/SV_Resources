    },
    {
      "ordinal": 15,
      "label": "s1_sub_003_woman_10",
      "hash64": "C9E837545529A9E1",
      "text": "Gradirebbe per caso una sfida Pokémon\\ncontro di me?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
