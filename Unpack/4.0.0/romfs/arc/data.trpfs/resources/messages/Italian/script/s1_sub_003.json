          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_003_woman_09",
      "hash64": "C9E4AA5455268473",
      "text": "Permette? Salve, signor[VAR 0x1100(00FF,0A07)] plebeoina plebea.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
