    },
    {
      "ordinal": 5,
      "label": "s1_sub_003_woman_04",
      "hash64": "C9E4B55455269724",
      "text": "Uhm, fammici pensare un po’...[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
