    },
    {
      "ordinal": 22,
      "label": "s1_sub_003_woman_14",
      "hash64": "C9E83B545529B0AD",
      "text": "Suppongo che, a volte, anche il rifiuto della\\nplebe possa essere un’esperienza interessante.\\c\\nTuttavia, il tempo di una Celebrità è prezioso.\\nPerciò la affronterò lo stesso, e subito!![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
