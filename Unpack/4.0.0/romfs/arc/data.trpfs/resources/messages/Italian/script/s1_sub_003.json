    },
    {
      "ordinal": 3,
      "label": "s1_sub_003_woman_03",
      "hash64": "C9E4B45455269571",
      "text": "Oh, Nab! Grazie, caro. Che dire?\\nÈ la pura verità.[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
