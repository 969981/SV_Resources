    },
    {
      "ordinal": 11,
      "label": "s1_sub_003_man_05",
      "hash64": "F2AB872F8DFAE719",
      "text": "Su, Abby cara, cerca di calmarti! Guarda che\\nnon va da nessuna parte![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_003_woman_08",
      "hash64": "C9E4A954552682C0",
      "text": "Sì, devi scusarmi. È che non mi capita quasi mai\\ndi vedere membri del popolino in carne e ossa...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_003_man_06",
      "hash64": "F2AB842F8DFAE200",
      "text": "Ma naturalmente! Come potresti? D’altronde,\\nsei la presidentessa dell’Immobiliare Paldea![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
