    },
    {
      "ordinal": 37,
      "label": "sdc01_side01_020_select_07",
      "hash64": "F3A40110EE588DFB",
      "text": "Ma certo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "sdc01_side01_020_select_08",
      "hash64": "F3A3FE10EE5888E2",
      "text": "Non saprei...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "sdc01_side01_020_brother_40",
      "hash64": "A032CA35E0521056",
      "text": "E-Evvai! Non vedo l’ora di mostrartela...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
