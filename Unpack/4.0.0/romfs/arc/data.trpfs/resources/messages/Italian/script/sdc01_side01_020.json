          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_side01_020_system_01",
      "hash64": "3631694BB7E1ED0A",
      "text": "L’orco possedeva quattro misteriose maschere\\nbrillanti.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sdc01_side01_020_system_02",
      "hash64": "3631684BB7E1EB57",
      "text": "A seconda di quale indossava, i poteri della clava\\nda lui brandita mutavano.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc01_side01_020_system_03",
      "hash64": "3631674BB7E1E9A4",
      "text": "Grazie alla maschera verdazzurra, poteva ridar\\nvita alla vegetazione avvizzita.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc01_side01_020_system_04",
      "hash64": "3631664BB7E1E7F1",
      "text": "Grazie alla maschera purpurea, poteva generare\\nlingue di fuoco persino dalla fiammella\\r\\ndi una candela.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_side01_020_system_05",
      "hash64": "3631654BB7E1E63E",
      "text": "Grazie alla maschera turchina, poteva arrestare\\nil corso dei fiumi.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc01_side01_020_system_06",
      "hash64": "3631644BB7E1E48B",
      "text": "Grazie alla maschera bigia, poteva frantumare\\ncon agio solidi massi.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc01_side01_020_system_07",
      "hash64": "3631634BB7E1E2D8",
      "text": "Prima di perire, i beniamici rubarono tre delle\\nmaschere, privando l’orco di una parte dei\\r\\nsuoi poteri.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_side01_020_brother_10",
      "hash64": "A028D835E049D39B",
      "text": "Hai finito di leggere...?[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
