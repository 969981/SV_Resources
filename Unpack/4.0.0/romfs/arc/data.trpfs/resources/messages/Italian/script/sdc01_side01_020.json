          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc01_side01_020_brother_41",
      "hash64": "A032CB35E0521209",
      "text": "Se non ti va, pazienza... ma... mi piacerebbe\\ndavvero mostrartela, ecco...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
