          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_041_synchro_02",
      "hash64": "86F82719633C94C3",
      "text": "Oh, hallo! Mein Name ist Synchrona.\\nIch bin eine geniale Forscherin![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_041_synchro_03",
      "hash64": "86F82619633C9310",
      "text": "Möchtest du mir eventuell bei einem\\nrevolutionären Experiment helfen?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_041_synchro_04",
      "hash64": "86F82D19633C9EF5",
      "text": "Was?! Du möchtest mir bei der Entdeckung des\\nJahrhunderts nicht zur Hand gehen?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_041_synchro_05",
      "hash64": "86F82C19633C9D42",
      "text": "[EMPTY 31]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_041_synchro_add_01",
      "hash64": "A20963AB7E34341A",
      "text": "Ausgezeichnet! Dann begeben wir uns mal zum\\nVersuchsgelände.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_041_synchro_add_02",
      "hash64": "A20962AB7E343267",
      "text": "Für das Experiment musst du ein Pokémon\\naus seinem Ball lassen.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_041_synchro_add_03",
      "hash64": "A20961AB7E3430B4",
      "text": "Sag Bescheid, wenn du bereit bist.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_041_synchro_add_04",
      "hash64": "A20960AB7E342F01",
      "text": "Und, hilfst du mir bei meinem revolutionären\\nExperiment?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_041_synchro_06",
      "hash64": "86F82B19633C9B8F",
      "text": "Sehr schön! Dann wollen wir mal!\\nSYNCHRONISATION![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_sub_041_synchro_07",
      "hash64": "86F82A19633C99DC",
      "text": "Die Gefühle von dir und deinem Pokémon sind\\nnun synchronisiert![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_041_synchro_08",
      "hash64": "86F83119633CA5C1",
      "text": "Durch die Synchronisation bewegt sich dein\\nPokémon genau so, wie du es möchtest.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_041_synchro_09",
      "hash64": "86F83019633CA40E",
      "text": "Probier es doch mal aus! Geh bitte zu diesem\\nBaum da.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_041_synchro_10",
      "hash64": "86F4A31963397EA0",
      "text": "Oh, wow! Du bist ja ein richtiges Naturtalent![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_041_synchro_11",
      "hash64": "86F4A41963398053",
      "text": "Dank dir hab ich viele nützliche Daten sammeln\\nkönnen. Hier, für dich![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_041_synchro_12",
      "hash64": "86F4A51963398206",
      "text": "Da du anscheinend ein Händchen dafür hast,\\ndarf ich dich um einen weiteren Gefallen bitten?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_sub_041_synchro_13",
      "hash64": "86F4A619633983B9",
      "text": "Das nächste Experiment erfordert ein bisschen\\nmehr Aufwand, aber dafür ist die Belohnung\\r\\nauch entsprechend größer.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_sub_041_synchro_14",
      "hash64": "86F4A7196339856C",
      "text": "Na, hilfst du mir bei meinem revolutionären\\nExperiment?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_sub_041_synchro_15",
      "hash64": "86F4A8196339871F",
      "text": "Das wird DIE Entdeckung des Jahrhunderts...\\nUnd du willst daran nicht teilhaben?![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_sub_041_synchro_16",
      "hash64": "86F4A919633988D2",
      "text": "Sehr schön! Dann wollen wir mal!\\nSYNCHRONISATION![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_sub_041_synchro_17",
      "hash64": "86F4AA1963398A85",
      "text": "Du synchronisierst dich erneut mit einem\\nPokémon![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_041_synchro_18",
      "hash64": "86F4AB1963398C38",
      "text": "Nun, da du zum zweiten Mal eine Synchronisation\\ndurchgeführt hast, müsstest du verschiedene\\r\\nHandlungen ausführen können.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_sub_041_synchro_19",
      "hash64": "86F4AC1963398DEB",
      "text": "Testen wir doch gleich mal deine Fertigkeiten\\nin ein paar Kämpfen.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_sub_041_synchro_20",
      "hash64": "86FEB5196341F1BB",
      "text": "Wow! Noch synchronisierter kann man ja\\ngar nicht sein![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_sub_041_synchro_21",
      "hash64": "86FEB4196341F008",
      "text": "Ein außerordentliches Talent wie du verdient\\neine revolutionäre Belohnung.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_sub_041_synchro_22",
      "hash64": "86FEB7196341F521",
      "text": "Sie ist ein Prototyp, daher sieht sie ein bisschen...\\nNun ja, sie sieht eben aus, wie sie aussieht.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_sub_041_synchro_23",
      "hash64": "86FEB6196341F36E",
      "text": "Aber wenn du sie einsetzt, kannst du dich\\njederzeit mit deinen Pokémon synchronisieren!\\c\\nProbier es bitte mit verschiedenen Pokémon aus.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_sub_041_synchro_24",
      "hash64": "86FEB9196341F887",
      "text": "Okay, brechen wir das Experiment ab.\\c\\nKomm bitte wieder, wenn du dich erneut\\nsynchronisieren möchtest.\\c\\nHm, vielleicht war die Belastung für [VAR 0x1100(00FF,0304,0000)]seinihr Gehirn\\neinfach zu groß...[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0304",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 184,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s2_sub_041_synchro_25",
      "hash64": "86FEB8196341F6D4",
      "text": "Benutzt du auch schön die Synchromaschine?\\c\\nWenn du die L-Taste gedrückt hältst und dann\\ndie R-Taste drückst, kannst du synchronisieren![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_sub_041_synchro_26",
      "hash64": "86FEBB196341FBED",
      "text": "Ich danke dir für all das Synchronisieren!\\c\\nDie Daten, die du für mich gesammelt hast, sind\\nungemein hilfreich.\\c\\nLass mich dir für deine Hilfe ein paar BP geben.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
