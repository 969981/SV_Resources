      "hash64": "877FFF16215C5BF2",
      "text": "Kaumalaaat!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_f_02_dragon_07",
      "hash64": "29271135F9FB2F8B",
      "text": "Mithilfe eines Terakristall-Orbs können Pokémon\\neine Terakristallisierung durchführen.[VAR 0x0114(0012)]",
