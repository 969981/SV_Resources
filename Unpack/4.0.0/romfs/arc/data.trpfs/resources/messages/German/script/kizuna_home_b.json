      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_home_b_02",
      "hash64": "7074FE3D9FB32FBF",
      "text": "Führt dich etwa auch der Hunger her?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_home_b_select_01",
      "hash64": "41E2A3C4A8BB79C1",
      "text": "Ich könnte schon ’nen Happen vertragen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_home_b_select_02",
      "hash64": "41E2A0C4A8BB74A8",
      "text": "Ich bin nur zufällig hier.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_home_b_03a",
      "hash64": "C9F8BCB65D77E337",
      "text": "Richtig so! Du solltest keine Kämpfe auf leeren\\nMagen austragen.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_home_b_03b",
      "hash64": "C9F8BDB65D77E4EA",
      "text": "Wer weiß, vielleicht hat dich ja das\\nunwiderstehliche Aroma hergelockt.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_home_b_04",
      "hash64": "7074FC3D9FB32C59",
      "text": "Ich für meinen Teil bin in erster Linie hier, um...\\ndie Mensa zu inspizieren.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_home_b_05",
      "hash64": "7074FB3D9FB32AA6",
      "text": "Mit anderen Worten, ich überprüfe, wie es um\\nden Nährwert des Essens bestellt ist, das unsere\\r\\nSchüler täglich zu sich nehmen.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_home_b_06",
      "hash64": "7074FA3D9FB328F3",
      "text": "Auf der Speisekarte steht ein süßer Leckerbissen,\\ndem mein ganz besonderes Interesse gilt:\\r\\ndas Erdnussbuttersandwich.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_home_b_07",
      "hash64": "7074F93D9FB32740",
      "text": "Da werde ich doch gleich mal eins bestellen...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_home_b_mob_01",
      "hash64": "72BB0B4A3B889909",
      "text": "Oh, guckt mal! Da ist ja Señor Saguaro. In Sachen\\nStil reicht ihm echt keiner so schnell das Wasser.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "kizuna_home_b_mob_02",
      "hash64": "72BB084A3B8893F0",
      "text": "Die Lehrer kommen also auch in die Mensa.\\nOb er wohl ein Eiersandwich bestellt?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_home_b_mob_03",
      "hash64": "72BB094A3B8895A3",
      "text": "Quatsch! Er bestellt sich garantiert ein „Inferno“,\\ndas schärfste Sandwich auf der Karte!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_home_b_mob_04",
      "hash64": "72BB0E4A3B889E22",
      "text": "Oh, stimmt! Das wär supercool.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "kizuna_home_b_08",
      "hash64": "7075083D9FB340BD",
      "text": "...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_home_b_09",
      "hash64": "7075073D9FB33F0A",
      "text": "Ich hätte gerne ein Infernosandwich. Es geht doch\\nnichts über ein leichtes Ziepen auf der Zunge...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_home_b_select_03",
      "hash64": "41E2A1C4A8BB765B",
      "text": "Aber Señor Saguaro, was ist mit...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_home_b_select_04",
      "hash64": "41E2A6C4A8BB7EDA",
      "text": "Und das Erdnussbuttersandwich?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_home_b_10",
      "hash64": "7071FA3D9FB0F31C",
      "text": "Richtig, du hattest ja das Erdnussbuttersandwich\\nvorgeschlagen. Verzeihung, mein Fehler!\\r\\nDann nehme ich doch lieber das.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_home_b_11",
      "hash64": "7071FB3D9FB0F4CF",
      "text": "Uff. Beinahe hätte ich wirklich etwas Scharfes\\nbestellt, dabei mag ich das doch überhaupt nicht.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_home_b_12",
      "hash64": "7071FC3D9FB0F682",
      "text": "[VAR 0xBD06(0000)]Ich danke dir für dein Eingreifen,\\n[VAR 0x0100(0000)].[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_home_b_13",
      "hash64": "7071FD3D9FB0F835",
      "text": "Offenbar halten mich hier alle für verwegen, taff,\\nunverwüstlich und obendrein noch stilsicher...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_home_b_14",
      "hash64": "7071F63D9FB0EC50",
      "text": "Ich möchte niemandem diese Illusion nehmen,\\nalso versuche ich stets, diesem Bild gerecht\\r\\nzu werden.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_home_b_15",
      "hash64": "7071F73D9FB0EE03",
      "text": "Jetzt hab ich dir die ungeschminkte Wahrheit\\nerzählt, ohne es eigentlich zu wollen...\\r\\nBitte behalte das für dich, ja?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_home_b_system_01",
      "hash64": "1F8785FE16DAD786",
      "text": "Du hast dich noch ein bisschen mehr mit\\nSeñor Saguaro angefreundet!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
