    {
      "ordinal": 39,
      "label": "sdc01_0110_gfather_08",
      "hash64": "A482ECB3042500A8",
      "text": "Ich hoffe, unsere beiden Chaoten und du\\nwerdet richtig dicke Freunde.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc01_0110_gmother_12",
      "hash64": "24BE959E9306FEBC",
      "text": "Die Masken sollten im Schuppen sein. Ich glaube\\nsogar... Ja, es müssten sogar drei Masken sein.\\c\\nStreitet euch bitte nicht darum, ja?[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
