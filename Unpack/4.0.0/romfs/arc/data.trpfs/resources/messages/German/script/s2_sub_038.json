  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_038_man_01",
      "hash64": "04DCA3FBE2124FD0",
      "text": "Halt! Komm mir lieber nicht zu nahe...\\nVon mir geht nämlich eine große Gefahr aus!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_038_man_02",
      "hash64": "04DCA6FBE21254E9",
      "text": "Ignorier mich am besten einfach, okay?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_038_man_03",
      "hash64": "04DCA5FBE2125336",
      "text": "...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_038_man_04",
      "hash64": "04DCA8FBE212584F",
      "text": "Jetzt sag bloß... Ist es denn die Möglichkeit...?\\nDu etwa auch...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_038_man_05",
      "hash64": "04DCA7FBE212569C",
      "text": "Tatsache! Du hast die „Stimme“ also auch gehört,\\nnicht wahr?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_038_man_06",
      "hash64": "04DCAAFBE2125BB5",
      "text": "Verstehe. Sag mal... Von wem kommt deiner\\nMeinung nach diese Stimme?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_038_select_01",
      "hash64": "2C3001979E4B352C",
      "text": "Vom Licht",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_038_select_02",
      "hash64": "2C3004979E4B3A45",
      "text": "Vom Wind",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_038_select_03",
      "hash64": "2C3003979E4B3892",
      "text": "Von der Dunkelheit",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s2_sub_038_select_04",
      "hash64": "2C2FFE979E4B3013",
      "text": "Von niemandem",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_038_select_05",
      "hash64": "2C2FFD979E4B2E60",
      "text": "Keine Ahnung",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_038_man_07",
      "hash64": "04DCA9FBE2125A02",
      "text": "Vom Licht, sagst du? Nein, das stimmt so nicht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_038_man_08",
      "hash64": "04DCACFBE2125F1B",
      "text": "Wie bitte? Vom Wind also? Na gut, damit kann\\nich arbeiten...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s2_sub_038_man_09",
      "hash64": "04DCABFBE2125D68",
      "text": "Die Dunkelheit... Ja, die Dunkelheit ist meine\\nGefährtin. Sie lindert den Schmerz in meinem\\r\\npechschwarzen Herz...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_038_man_10",
      "hash64": "04D93EFBE20F6E5A",
      "text": "Von niemandem! Ist das dein Ernst?!\\c\\nEcht jetzt, streng mal deine grauen Zellen ein\\nbisschen an!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_038_man_11",
      "hash64": "04D93FFBE20F700D",
      "text": "Du spürst es auch, oder? Dieses schaurige\\nKribbeln in deiner Hand...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s2_sub_038_select_06",
      "hash64": "2C3000979E4B3379",
      "text": "Meiner rechten Hand?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s2_sub_038_select_07",
      "hash64": "2C2FFF979E4B31C6",
      "text": "Meiner linken Hand?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "s2_sub_038_man_12",
      "hash64": "04D93CFBE20F6AF4",
      "text": "Deiner rechten Hand?! Dann hab ich mich wohl\\ndoch ziemlich in dir getäuscht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s2_sub_038_man_13",
      "hash64": "04D93DFBE20F6CA7",
      "text": "Ganz genau! Ich spreche von deiner linken Hand.\\c\\nWusste ich doch, dass wir Seelenverwandte sind!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_sub_038_man_14",
      "hash64": "04D93AFBE20F678E",
      "text": "Da du mein Schicksal teilst, möchte ich dir dieses\\nZeichen des Zwielichts anvertrauen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "s2_sub_011_system_01",
      "hash64": "340BF1E47E73D21E",
      "text": "Der Junge hat dir die Pose [VAR 0xFF00(0008)]Festgehaltene Hand[VAR 0xFF00(0000)]\\nbeigebracht!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_038_man_npc",
      "hash64": "C1792A01F38D539A",
      "text": "Eine Sache noch, [VAR 0x1100(00FF,1312,0000)]SchicksalsgefährteSchicksalsgefährtin!\\c\\nLass nicht zu, dass die Macht der linken Hand\\nvon dir Besitz ergreift!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
