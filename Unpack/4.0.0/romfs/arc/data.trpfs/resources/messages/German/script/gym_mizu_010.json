  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "gym_mizu_010_mizu_01",
      "hash64": "C38DF125E6D2FF90",
      "text": "Mein lieber Scholli! Ich bin schon viel zu spät\\ndran![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_mizu_010_receptionist_01",
      "hash64": "7C6C59D62A6DB258",
      "text": "M-Moment, warten Sie! Señor Kombu!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "gym_mizu_010_receptionist_02",
      "hash64": "7C6C5CD62A6DB771",
      "text": "Ach, weg ist er. Dabei hat er doch das hier\\nvergessen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mizu_010_receptionist_03",
      "hash64": "7C6C5BD62A6DB5BE",
      "text": "Entschuldige, aber du bist doch sicher hier,\\num den Arenaleiter herauszufordern, oder?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mizu_010_select_01",
      "hash64": "D3677BC9BEA50865",
      "text": "Ja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mizu_010_select_02",
      "hash64": "D36778C9BEA5034C",
      "text": "Na ja...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_mizu_010_receptionist_04a",
      "hash64": "D9DFDBEA18744342",
      "text": "Das dachte ich mir!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_mizu_010_receptionist_04b",
      "hash64": "D9DFDAEA1874418F",
      "text": "Kein Grund zur Schüchternheit! Du bist bestimmt\\n[VAR 0x1100(00FF,1312,0000)]ein Herausforderereine Herausforderin!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1312",
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mizu_010_receptionist_05",
      "hash64": "7C6C5DD62A6DB924",
      "text": "Der große Mann gerade eben war der hiesige\\nArenaleiter, Kombu.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_010_receptionist_06",
      "hash64": "7C6C60D62A6DBE3D",
      "text": "Der ist mir vielleicht einer... Gerade ist er los,\\num auf dem Markt einzukaufen, und hat seine\\r\\nGeldbörse hier vergessen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_010_receptionist_07",
      "hash64": "7C6C5FD62A6DBC8A",
      "text": "Das wird ihm sicher noch Probleme bereiten...\\c\\nWärst du vielleicht so freundlich und würdest ihm\\nseine Geldbörse bringen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_010_receptionist_08a",
      "hash64": "D9B6D3EA18513096",
      "text": "Wie nett von dir, vielen Dank! Dafür würde ich dir\\nam liebsten gleich hier den Arenaorden geben!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_010_receptionist_08b",
      "hash64": "D9B6D2EA18512EE3",
      "text": "Es tut mir leid, aber ohne Kombu kannst du dich\\nnicht an dieser Arena versuchen.\\c\\nUnd ich kann meinen Platz am Empfang auch\\nnicht verlassen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_010_receptionist_09",
      "hash64": "7C6C51D62A6DA4C0",
      "text": "Ich verlasse mich auf dich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_010_receptionist_10",
      "hash64": "7C6954D62A6B7402",
      "text": "Deine Sonderzustellung würde ich dann auch\\ndirekt als Arenaprüfung gelten lassen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_010_receptionist_11",
      "hash64": "7C6955D62A6B75B5",
      "text": "Kombu hat sich nach [VAR 0xFF00(0006)]Puerto Marinedo[VAR 0xFF00(0000)]\\naufgemacht. Das liegt jenseits der Wüste\\r\\nim Westen.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_010_receptionist_12",
      "hash64": "7C6952D62A6B709C",
      "text": "Oh, aber pass gut auf dich auf! In der Wüste soll\\nes viele gefährliche Pokémon geben.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
