    {
      "ordinal": 5,
      "label": "common_0270_head_teacher_05",
      "hash64": "F612F986ADD63C24",
      "text": "Du fragst dich vielleicht, warum wir uns nicht\\nvorhin in der Mensa hätten unterhalten können...\\c\\nDoch es gibt einen bestimmten Grund, aus dem\\nich dich hergebeten habe.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
