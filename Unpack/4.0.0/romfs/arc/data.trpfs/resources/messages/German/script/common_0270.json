    {
      "ordinal": 4,
      "label": "common_0270_head_teacher_04",
      "hash64": "F612FA86ADD63DD7",
      "text": "Verstehe... Du kannst mich jederzeit um Rat\\nfragen, wenn du Hilfe benötigst, vergiss das nicht.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
