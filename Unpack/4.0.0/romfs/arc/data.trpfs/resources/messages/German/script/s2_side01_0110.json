    {
      "ordinal": 12,
      "label": "s2_side01_0110_select_01",
      "hash64": "35B934CA2717E415",
      "text": "Ein Mädchen in Schuluniform!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s2_side01_0110_select_02",
      "hash64": "35B931CA2717DEFC",
      "text": "Ein energiegeladenes Mädchen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s2_side01_0110_gfather_07",
      "hash64": "1897B17FB5868DE0",
      "text": "Oh! Jetzt, wo du es sagst... Wir haben tatsächlich\\nvorhin ein Mädchen in Schuluniform getroffen.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_side01_0110_gfather_08",
      "hash64": "1897C07FB586A75D",
      "text": "Oh! Jetzt, wo du es sagst... Wir haben tatsächlich\\nvorhin ein lebhaftes Mädchen getroffen, das wir\\r\\nnoch nicht kannten.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
