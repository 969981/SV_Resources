    {
      "ordinal": 0,
      "label": "sdc02_0252_sister_01",
      "hash64": "09E187BFBA1153F2",
      "text": "Wow, unglaublich! Das erinnert mich an den\\nKristallsee![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
