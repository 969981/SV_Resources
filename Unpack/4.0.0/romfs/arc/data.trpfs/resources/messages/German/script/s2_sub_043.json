{
  "version": "4.0.0",
  "language": "de",
  "language_raw": "German",
  "source": "message/dat/German/script/s2_sub_043.dat",
  "paired_tbl": "message/dat/German/script/s2_sub_043.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_043_student_f_01",
      "hash64": "4B26BF5C7600182C",
      "text": "Wusstest du, dass man aus Galarnuss-Zweigen\\nAccessoires herstellen kann?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_043_student_f_02",
      "hash64": "4B26C25C76001D45",
      "text": "Wenn du mir Galarnuss-Zweige gibst, mache ich\\ndir daraus entweder einen Galarnuss-Reif oder\\r\\neinen Galarnuss-Kranz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_043_select_01",
      "hash64": "DF5476E50DC8F73E",
      "text": "Ich hätte gern einen Galarnuss-Reif.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_043_select_02",
      "hash64": "DF5475E50DC8F58B",
      "text": "Ich hätte gern einen Galarnuss-Kranz.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_043_select_03",
      "hash64": "DF5474E50DC8F3D8",
      "text": "Ein andermal vielleicht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_043_student_f_03",
      "hash64": "4B26C15C76001B92",
      "text": "Im Moment brauchst du keinen?\\nAlles klar, dann bis später!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_043_student_f_04",
      "hash64": "4B26BC5C76001313",
      "text": "Für einen Galarnuss-Reif bräuchte ich\\n8 Galarnuss-Zweige. Einverstanden?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_043_student_f_05",
      "hash64": "4B26BB5C76001160",
      "text": "Für einen Galarnuss-Kranz bräuchte ich\\n15 Galarnuss-Zweige. Einverstanden?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_043_student_f_06",
      "hash64": "4B26BE5C76001679",
      "text": "Du hast nicht genug Galarnuss-Zweige!\\c\\nWenn du im Küsten-Areal herumläufst, kannst du\\nwelche sammeln.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_043_student_f_07",
      "hash64": "4B26BD5C760014C6",
      "text": "Alles klar! Dann mach ich mich gleich ans Werk.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_043_student_f_08",
      "hash64": "4B26C85C76002777",
      "text": "Hier ein Zweig, da ein Zweig...\\nUnd einmal rum, dann wieder durch...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_043_student_f_09",
      "hash64": "4B26C75C760025C4",
      "text": "Hier, bitte schön! Frisch gewebt und brandneu!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_043_student_f_10",
      "hash64": "4B233A5C75FD0056",
      "text": "Du solltest ihn einem Galar-Flegmon geben!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
