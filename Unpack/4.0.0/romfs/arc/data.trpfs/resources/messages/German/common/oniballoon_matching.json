    {
      "ordinal": 30,
      "label": "oniballoon_matching_msg_00_00",
      "hash64": "49EB457ABC0455E4",
      "text": "Das Team wurde aufgelöst!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "oniballoon_matching_msg_00_01",
      "hash64": "49EB467ABC045797",
      "text": "Es wurde kein Team gefunden.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "oniballoon_matching_msg_00_02",
      "hash64": "49EB477ABC04594A",
      "text": "Du konntest dem Team nicht beitreten.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "oniballoon_matching_msg_01_00",
      "hash64": "48AFFB7594F6BCD5",
      "text": "Möchtest du das Team verlassen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "oniballoon_matching_msg_01_01",
      "hash64": "48AFFA7594F6BB22",
      "text": "Du hast das Team verlassen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "oniballoon_matching_msg_01_02",
      "hash64": "48AFF97594F6B96F",
      "text": "Möchtest du mit diesen Teilnehmern das Spiel\\nbeginnen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "oniballoon_matching_msg_02_00",
      "hash64": "7719798DA1EC3CC2",
      "text": "Möchtest du das Team auflösen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "oniballoon_matching_msg_03_00",
      "hash64": "1F6D2F86056CE033",
      "text": "Mindestens ein Teilnehmer bereitet sich noch vor.\\nBitte warte noch etwas mit dem Spielbeginn.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "oniballoon_matching_con_00_00",
      "hash64": "79E59C9EB0672FA5",
      "text": "Ja",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "oniballoon_matching_con_00_01",
      "hash64": "79E59B9EB0672DF2",
      "text": "Nein",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "oniballoon_entrynpc_01",
      "hash64": "4B3DD23D885F6D3A",
      "text": "Hallöchen! Wie sieht’s aus, möchtest du am\\nOni-Austreibungsspiel teilnehmen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "oniballoon_entrynpc_02",
      "hash64": "4B3DD13D885F6B87",
      "text": "Alles klar, dann komm bitte hier entlang.\\nTreib schön viele Oni aus!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "oniballoon_entrynpc_03",
      "hash64": "4B3DD03D885F69D4",
      "text": "Komm bald mal wieder!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "oniballoon_entrynpc_04",
      "hash64": "4B3DCF3D885F6821",
      "text": "Du hast zum ersten Mal den Schwierigkeitsgrad\\n„Einfach“ geschafft, gut gemacht!\\c\\nHier, das ist für dich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "oniballoon_entrynpc_05",
      "hash64": "4B3DCE3D885F666E",
      "text": "Versuch dich doch mal am Schwierigkeitsgrad\\n„Normal“, den schaffst du sicher auch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "oniballoon_entrynpc_06",
      "hash64": "4B3DCD3D885F64BB",
      "text": "Du hast zum ersten Mal den Schwierigkeitsgrad\\n„Normal“ geschafft. Glückwunsch, echt super!\\c\\nHier, das ist für dich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "oniballoon_entrynpc_07",
      "hash64": "4B3DCC3D885F6308",
      "text": "Du solltest mal den Schwierigkeitsgrad „Schwer“\\nprobieren. Ich glaube, du hast das Zeug dazu!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 47,
      "label": "oniballoon_entrynpc_08",
      "hash64": "4B3DCB3D885F6155",
      "text": "Wow, du hast tatsächlich den Schwierigkeitsgrad\\n„Schwer“ geschafft! Phänomenale Leistung!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 48,
      "label": "oniballoon_entrynpc_08_2",
      "hash64": "925FF7862C6613A4",
      "text": "Hm, jemandem wie dir kann ich dieses Pokémon\\nvielleicht anvertrauen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 49,
      "label": "oniballoon_entrynpc_08_3",
      "hash64": "925FF8862C661557",
      "text": "Weißt du, es gibt da dieses gefräßige Mampfaxo,\\ndas jedes Mal ankommt, wenn wir das\\r\\nOni-Austreibungsspiel veranstalten.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "oniballoon_entrynpc_08_4",
      "hash64": "925FF5862C66103E",
      "text": "Dieser Nimmersatt hat so einen Appetit, dass die\\nSpielschwierigkeit oft ins Unermessliche steigt...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "oniballoon_entrynpc_08_5",
      "hash64": "925FF6862C6611F1",
      "text": "Aber mir scheint, bei dir wäre dieses Mampfaxo\\nperfekt aufgehoben!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "oniballoon_entrynpc_08_6",
      "hash64": "925FF3862C660CD8",
      "text": "Du erhältst ein Mampfaxo von der jungen Frau!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "oniballoon_entrynpc_09",
      "hash64": "4B3DCA3D885F5FA2",
      "text": "Oh, deine Boxen sind voll! Komm doch wieder,\\nwenn du etwas Platz geschaffen hast.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 54,
      "label": "oniballoon_entrynpc_10",
      "hash64": "4B3A4D3D885C5564",
      "text": "Ich will spielen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "oniballoon_entrynpc_11",
      "hash64": "4B3A4E3D885C5717",
      "text": "Wegen dem Mampfaxo...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 56,
      "label": "oniballoon_entrynpc_12",
      "hash64": "4B3A4F3D885C58CA",
      "text": "Richtig, das Mampfaxo! Diesmal geb ich es dir!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
