      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_language_b_03",
      "hash64": "F0BB4A556890403F",
      "text": "Dieses Pamo ist zusammengebrochen. Es scheint\\nihm gar nicht gut zu gehen!\\c\\nWas soll ich tun? Was soll ich nur tun?![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_language_b_select_01",
      "hash64": "8B1DD4B854BEBE44",
      "text": "Geben Sie ihm einen Trank!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_language_b_select_02",
      "hash64": "8B1DD7B854BEC35D",
      "text": "Bleiben Sie ruhig.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_language_b_04",
      "hash64": "F0BB475568903B26",
      "text": "Natürlich... Wir brauchen einen Trank! Hast du\\nzufällig einen zur Hand?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_language_b_05",
      "hash64": "F0BB485568903CD9",
      "text": "Was? Du hast keinen? Und jetzt? Was sollen\\nwir tun?!\\c\\nOh! Schon gut, ich habe ja einen Trank in meiner\\nTasche![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_language_b_06",
      "hash64": "F0BB4555689037C0",
      "text": "Hier, my little friend! Ich hoffe, dass der Trank\\ndich wieder auf Vordermann bringt.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
