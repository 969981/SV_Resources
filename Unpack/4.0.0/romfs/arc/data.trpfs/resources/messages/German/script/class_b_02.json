      ]
    },
    {
      "ordinal": 15,
      "label": "class_b_02_math_10",
      "hash64": "3727562F0C6FB574",
      "text": "Beim Kauf von mindestens zehn Pokébällen einer\\nArt...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_b_02_math_11",
      "hash64": "3727572F0C6FB727",
      "text": "...erhält man als Bonus zusätzlich einen\\nPremierball!\\c\\nDieser ist an seiner weißen Farbe erkennbar.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
