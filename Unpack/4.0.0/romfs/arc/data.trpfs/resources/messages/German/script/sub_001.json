    {
      "ordinal": 42,
      "label": "sub_001_kimawari_02",
      "hash64": "2711287578B3D480",
      "text": "Du hast ein Sonnflora gefunden!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "sub_001_kimawari_03",
      "hash64": "2711297578B3D633",
      "text": "Du hast [VAR 0x0201(0001)] Sonnflora gefunden!\\nBringe [VAR 0x1101(0001,0302)]essie zum Sonnflora-Plaza!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0302"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sub_001_kimawari_04",
      "hash64": "27112E7578B3DEB2",
      "text": "Du hast alle Sonnflora in Bolardin gefunden!\\nBringe sie zum Sonnflora-Plaza!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "sub_001_kimawari_05",
      "hash64": "27112F7578B3E065",
      "text": "[EMPTY 87]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0057"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "sub_001_keeper_01",
      "hash64": "B1C254ED006DD28A",
      "text": "Glückwunsch zu deinem Sieg in der Arena!\\nDer Orden glänzt ja richtig!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 47,
      "label": "sub_001_keeper_02",
      "hash64": "B1C253ED006DD0D7",
      "text": "[EMPTY 87]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0057"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sub_001_keeper_03",
      "hash64": "B1C252ED006DCF24",
      "text": "Es war beeindruckend, wie du die Sonnflora bei\\ndeiner Arenaprüfung eingesammelt hast.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 49,
      "label": "sub_001_keeper_04",
      "hash64": "B1C251ED006DCD71",
      "text": "Auch die Sonnflora haben sich über so [VAR 0x1100(00FF,0405,0000)]eineneine\\n[VAR 0x1100(00FF,1514,0000)]talentierten Sammlertalentierte Sammlerin gefreut!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0405",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1514",
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "sub_001_keeper_05",
      "hash64": "B1C250ED006DCBBE",
      "text": "Würdest du dich noch an einer weiteren\\nSonnflora-Suche beteiligen wollen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "sub_001_keeper_06",
      "hash64": "B1C24FED006DCA0B",
      "text": "Juhuuu! Das wird ihnen bestimmt ein strahlendes\\nLächeln ins Gesicht zaubern!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "sub_001_keeper_07",
      "hash64": "B1C24EED006DC858",
      "text": "Dann werde ich die Sonnflora jetzt bitten,\\nsich in der ganzen Stadt zu verteilen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "sub_001_kimawari_06",
      "hash64": "27112C7578B3DB4C",
      "text": "Sonnflooora!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 54,
      "label": "sub_001_keeper_09",
      "hash64": "B1C24CED006DC4F2",
      "text": "Hast du das gehört? Sie sagen, dass sie\\nbereit sind!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "sub_001_keeper_10",
      "hash64": "B1BF4FED006B9434",
      "text": "Es verstecken sich noch [VAR 0x0201(0001)] Sonnflora in Bolardin.",
