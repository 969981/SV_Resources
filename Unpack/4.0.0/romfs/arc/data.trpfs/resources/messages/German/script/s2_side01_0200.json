    {
      "ordinal": 12,
      "label": "s2_side01_0200_sister_05",
      "hash64": "C88069744112A3ED",
      "text": "Ist das dein Ernst?! Jo und ich sind beide mehr\\nals zehn Mal gegen dich angetreten!![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
