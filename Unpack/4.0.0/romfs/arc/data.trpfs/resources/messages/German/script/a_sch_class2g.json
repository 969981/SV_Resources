          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "a_sch_class2g_eve02",
      "hash64": "C4CB07F110C5ACC2",
      "text": "Ich hab mehr Angst davor, meine Note zu\\nerfahren, als vor der Prüfung selbst...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "a_sch_class2g_eve03",
      "hash64": "C4CB08F110C5AE75",
      "text": "Ich mache eine Pause und schaue nach draußen.\\nVielleicht sollte ich bald auf Schatzsuche gehen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "a_sch_class2g_eve04",
