            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_0305_rival_02",
      "hash64": "7B3D7CADF77F0C43",
      "text": "Jetzt können wir endlich auf Schatzsuche gehen!\\nYippie![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0305_select_01",
      "hash64": "2D36583380FB23AA",
      "text": "Was denn für ein Schatz?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_0305_select_02",
      "hash64": "2D36573380FB21F7",
      "text": "Worum geht es dabei?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0305_rival_03",
      "hash64": "7B3D7BADF77F0A90",
      "text": "Stimmt, das kennst du ja noch gar nicht.\\nKomm, ich erklär dir alles auf dem Weg![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0305_rival_04a",
      "hash64": "E89B219B8CF283FC",
      "text": "Die Schatzsuche ist das wichtigste Ereignis an der\\nOrangen-Akademie.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0305_rival_04b",
      "hash64": "E89B249B8CF28915",
      "text": "Die Schatzsuche ist das wichtigste Ereignis an der\\nTrauben-Akademie.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0305_rival_05",
      "hash64": "7B3D81ADF77F14C2",
      "text": "Aber trotz des Namens muss am Ende deiner\\nSchatzsuche nicht unbedingt ein greifbarer\\r\\nSchatz liegen.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0305_rival_06",
      "hash64": "7B3D80ADF77F130F",
      "text": "Es geht darum, Paldea frei zu erkunden und\\ndabei alle möglichen Erfahrungen zu sammeln![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0305_rival_07",
      "hash64": "7B3D7FADF77F115C",
      "text": "Du kannst zum Beispiel Arenaleiter herausfordern\\noder Leuten in Not helfen...\\c\\nUnd klar – wenn du einen richtigen, echten Schatz\\nsuchen willst, nur zu![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 153,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0305_rival_08",
      "hash64": "7B3D86ADF77F1D41",
      "text": "Auf diese Weise lernt man vieles, was man an der\\nAkademie sonst nicht beigebracht bekommt.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0305_rival_09",
      "hash64": "7B3D85ADF77F1B8E",
      "text": "Es gibt auch viele Gelegenheiten zu kämpfen.\\nDas ist ideal für mich![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0305_rival_10",
      "hash64": "7B39F8ADF77BF620",
      "text": "Wenn wir uns auf unserer Schatzsuche begegnen,\\nmusst du unbedingt gegen mich kämpfen, ja?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
