          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_e_02_battle_04",
      "hash64": "70CABB58714A45F6",
      "text": "Auf euren Reisen werden euch bestimmt große,\\nleuchtende [VAR 0xFF00(0006)]Kristalle[VAR 0xFF00(0000)] ins Auge fallen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_e_02_battle_05",
      "hash64": "70CABC58714A47A9",
      "text": "Sie bestehen aus Terakristall-Energie, die bis an\\ndie Oberfläche gedrungen ist.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_e_02_battle_06",
      "hash64": "70CAB958714A4290",
      "text": "Untersucht ihr diese Kristalle, könnt ihr zusammen\\nmit drei Freunden oder anderen Trainern gegen\\r\\nein Terakristall-Pokémon kämpfen![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_e_02_battle_07",
      "hash64": "70CABA58714A4443",
      "text": "Diese Kämpfe nennt man Tera-Raids.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_e_02_battle_08",
      "hash64": "70CAC758714A5A5A",
      "text": "Doch seid gewarnt: Bei Terakristall-Pokémon\\nhandelt es sich um äußerst starke Kontrahenten![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_e_02_battle_09",
      "hash64": "70CAC858714A5C0D",
      "text": "Manchmal verhalten sie sich anders als\\ngewöhnliche Pokémon. Deshalb dürft ihr nicht\\r\\neine Sekunde lang unachtsam sein![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_e_02_battle_10",
      "hash64": "70CDC558714C8CCB",
      "text": "Glücklicherweise steht Trainern in Tera-Raids eine\\nbesondere Aktion zur Verfügung: das [VAR 0xFF00(0006)]Anfeuern[VAR 0xFF00(0000)].[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_e_02_battle_11",
      "hash64": "70CDC458714C8B18",
      "text": "Es gibt drei verschiedene Arten des Anfeuerns.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_e_02_battle_12",
      "hash64": "70CDC758714C9031",
      "text": "Mit einem herzhaften „[VAR 0xFF00(0006)]Haut rein![VAR 0xFF00(0000)]“ werden der\\nAngriff und der Spezial-Angriff aller Pokémon\\r\\nauf der Mitstreiterseite gesteigert.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_e_02_battle_13",
      "hash64": "70CDC658714C8E7E",
      "text": "„[VAR 0xFF00(0006)]Bleibt standhaft![VAR 0xFF00(0000)]“ erhöht derweil sowohl die\\nVerteidigung als auch die Spezial-Verteidigung\\r\\naller Pokémon auf der Mitstreiterseite.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_e_02_battle_14",
      "hash64": "70CDC958714C9397",
      "text": "Und die dritte Variante? Mal sehen, wer von euch\\ndie Antwort schon kennt.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_e_02_battle_15",
      "hash64": "70CDC858714C91E4",
      "text": "Was ruft man, um die KP sämtlicher Pokémon\\nauf der Mitstreiterseite aufzufüllen?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_e_02_select_01",
      "hash64": "01A34312FE4FBD7F",
      "text": "Auf die Beine!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "class_e_02_select_02",
      "hash64": "01A34412FE4FBF32",
      "text": "Ab ins Bett!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_e_02_select_03",
      "hash64": "01A34512FE4FC0E5",
      "text": "Das wird nichts!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_e_02_battle_answer_01",
      "hash64": "FCAF0805E9FC6FF6",
      "text": "Das ist die richtige Antwort! Vielleicht solltest du\\nab jetzt meinen Unterricht leiten, Neuzugang![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_e_02_battle_answer_02",
      "hash64": "FCAF0705E9FC6E43",
      "text": "Wie bitte? Da hat wohl jemand letzte Nacht\\nnicht genug Schlaf bekommen, wie?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_e_02_battle_answer_03",
      "hash64": "FCAF0605E9FC6C90",
      "text": "Wie bitte? Nein, aber so gar nicht. Das klingt ja\\neher, als würden sie dadurch KP verlieren...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_e_02_battle_16",
      "hash64": "70CDCB58714C96FD",
      "text": "Mit einem aufmunternden „[VAR 0xFF00(0006)]Auf die Beine![VAR 0xFF00(0000)]“ füllt\\nihr nicht nur die KP eurer Pokémon wieder auf,\\r\\nsondern heilt auch ihre Statusveränderungen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_e_02_battle_17",
      "hash64": "70CDCA58714C954A",
      "text": "Innerhalb eines Tera-Raids könnt ihr die\\nAnfeuern-Funktion bis zu dreimal verwenden.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_e_02_battle_18",
      "hash64": "70CDBD58714C7F33",
      "text": "Allerdings solltet ihr euch gut überlegen, ob ihr\\ndas tut, denn durch den Einsatz von Anfeuern\\r\\nkommt euer Pokémon eine Runde nicht zum Zug.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_e_02_battle_19",
      "hash64": "70CDBC58714C7D80",
      "text": "Ich fasse noch einmal zusammen![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_e_02_battle_20",
      "hash64": "70C3B358714419B0",
      "text": "Wenn ihr in einem Tera-Raid auf Granit beißt,\\nversucht es mit der Anfeuern-Funktion![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_e_02_battle_21",
      "hash64": "70C3B45871441B63",
      "text": "Wer weiß, welche Möglichkeiten sich auftun,\\nwenn ihr euren Mitstreitern unter die Arme greift.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_e_02_battle_22",
      "hash64": "70C3B55871441D16",
      "text": "Hmpf. Eigentlich wollte ich euch das Ganze noch\\nin der Praxis demonstrieren, aber unsere Zeit ist\\r\\nwohl um...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_e_02_battle_23",
      "hash64": "70C3B65871441EC9",
      "text": "Also dann, der Unterricht ist vorbei.\\nSeht zu, dass ihr alle fit bleibt![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
