      ]
    },
    {
      "ordinal": 1,
      "label": "class_e_02_battle_02",
      "hash64": "70CABD58714A495C",
      "text": "Na, was haltet ihr von der Schatzsuche?\\nAufregend, nicht wahr?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
