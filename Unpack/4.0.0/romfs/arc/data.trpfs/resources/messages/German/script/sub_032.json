    {
      "ordinal": 1,
      "label": "sub_032_ecology_01",
      "hash64": "1D7AA910BEAF177A",
      "text": "Wie geht’s, wie steht’s, [VAR 0x0100(0000)]?\\nHier ist Jim![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
