            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sub_032_ecology_04",
      "hash64": "1D7AA610BEAF1261",
      "text": "Ach ja. Natürlich, Señor Direktor, ich komme\\nsofort zum Punkt.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_032_ecology_05",
      "hash64": "1D7AA510BEAF10AE",
      "text": "Ich wollte dir mitteilen, dass gerade in der ganzen\\nRegion extrem fordernde Tera-Raids auftauchen.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_032_ecology_06",
      "hash64": "1D7AA410BEAF0EFB",
      "text": "Ständig erreichen uns Berichte von Schülern,\\nderen Pokémon verletzt wurden.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_032_ecology_07",
      "hash64": "1D7AA310BEAF0D48",
      "text": "Das Lehrpersonal hat sich aufgeteilt, um der\\nSache auf den Grund zu gehen, aber wir sind\\r\\nleider etwas unterbesetzt.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_032_ecology_08",
      "hash64": "1D7AA210BEAF0B95",
      "text": "Jeeedenfalls haben wir uns gefragt, ob uns\\ndas preisgekrönte Turnier-Ass nicht unter die\\r\\nArme greifen könnte...?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sub_032_select_01",
      "hash64": "600E90A1DE178896",
      "text": "Klar, ich pack mit an!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_032_select_02",
      "hash64": "600E8FA1DE1786E3",
      "text": "Vielleicht, wenn’s sich mal ergibt...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_032_ecology_09",
      "hash64": "1D7AA110BEAF09E2",
      "text": "Supi, das freut mich! Besten Dank auch![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_032_ecology_10",
      "hash64": "1D772410BEABFFA4",
      "text": "Deine Pokédex-App wird alle relevanten Daten\\nautomatisch aufzeichnen, sodass wir sie später\\r\\nauswerten können.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_032_ecology_11",
      "hash64": "1D772510BEAC0157",
      "text": "Dann rechne ich damit, dass du dir einige dieser\\nknallharten Tera-Raids zeitnah vornimmst![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sub_032_ecology_12",
      "hash64": "1D772610BEAC030A",
      "text": "Aber selbst du als Turnier-Ass solltest die Raids\\nnicht auf die leichte Schulter nehmen.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sub_032_ecology_13",
      "hash64": "1D772710BEAC04BD",
      "text": "Ich will auf keinen Fall erleben, wie sich einer\\nmeiner lieben Schüler dabei verletzt.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sub_032_ecology_14",
      "hash64": "1D772010BEABF8D8",
      "text": "Dann wünsche ich dir viel Erfolg! Und danke dir\\nfür deine Hilfe![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
