            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_032_head_teacher_01",
      "hash64": "4BC620DFBE062313",
      "text": "*räusper*\\nSeñor Jim...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
