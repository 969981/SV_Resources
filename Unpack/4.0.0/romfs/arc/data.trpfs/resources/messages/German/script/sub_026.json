  "entries": [
    {
      "ordinal": 0,
      "label": "sub_025_sitappa_a_01",
      "hash64": "374EC4ECC983AA5C",
      "text": "Wir sind eine Gruppe von Leuten, die Team Star\\nverlassen haben.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_025_sitappa_a_02",
      "hash64": "374EC7ECC983AF75",
      "text": "Operation Stardust...? Herausforderungen...?\\nDavon hören wir zum ersten Mal.\\c\\nAber wir stehen auch nicht mehr in Kontakt mit\\ndenen, die das Sagen haben.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_025_sitappa_a_03",
      "hash64": "374EC6ECC983ADC2",
      "text": "Trotzdem schön, dass du bei uns vorbeischaust.\\c\\nEs ist zwar nicht viel, aber hier hast du ein kleines\\nWillkommensgeschenk.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_025_system_01",
      "hash64": "284BBDA29079A845",
      "text": "Du erhältst eine [VAR 0xFF00(0008)]Sportkappe (Star)[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_025_sitappa_a_04",
      "hash64": "374EC1ECC983A543",
      "text": "Fühl dich wie zu Hause und bleib, solange du\\nmagst. Aber du kannst natürlich auch jederzeit\\r\\nwieder gehen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sub_025_sitappa_a_05",
      "hash64": "374EC0ECC983A390",
      "text": "Wir sind eine Gruppe von Leuten, die Team Star\\nverlassen haben.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_025_sitappa_b_01",
      "hash64": "61CCBCE1801AED13",
      "text": "Wir haben einfach keine Lust mehr auf den\\nganzen Team-Star-Kram...\\c\\nDas bleibt jetzt bitte unter uns, aber wir gehen\\nheimlich sogar wieder zur Akademie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_025_sitappa_c_01",
      "hash64": "5EDE10DC579B18FE",
      "text": "Hat uns gefreut! Also, halt die Ohren steif und\\nhasta la vistar!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_025_sitappa_d_01",
      "hash64": "895C88D10E333535",
      "text": "Hier wird nicht gekämpft. Und genau deshalb\\nfühlen wir uns so wohl.\\c\\nDas ist viel besser als in der Akademie,\\nbei Team Star oder zu Hause.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    }
  ]
}
