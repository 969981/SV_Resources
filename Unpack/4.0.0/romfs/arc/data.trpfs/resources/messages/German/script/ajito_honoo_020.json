      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "ajito_honoo_020_cassiopeia_01",
      "hash64": "86C1998FCFED7A81",
      "text": "Du bist also mit dem Rüpel fertiggeworden.\\nGut gemacht.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_honoo_020_cassiopeia_02",
      "hash64": "86C1968FCFED7568",
      "text": "Dort drinnen hält sich die Schedir-Bande auf,\\ndie aus Team Stars Feuer-Mitgliedern besteht.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_honoo_020_cassiopeia_03",
      "hash64": "86C1978FCFED771B",
      "text": "Ihr Boss, Irsa, ist das Ass im Ärmel von Team Star.\\nSie kümmert sich um alles und löst absolut jedes\\r\\nProblem – wenn nötig, mit Gewalt.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_honoo_020_cassiopeia_04",
      "hash64": "86C19C8FCFED7F9A",
      "text": "Unsere Kampfansage wird Irsa sicher ziemlich\\ndie Laune verdorben haben.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_honoo_020_cassiopeia_05",
      "hash64": "86C19D8FCFED814D",
      "text": "Vermutlich versuchen ihre Handlanger gerade,\\nsie zu beruhigen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_honoo_020_cassiopeia_06",
      "hash64": "86C19A8FCFED7C34",
      "text": "Am besten bringst du den Haufen Rüpel zügig\\nzur Strecke.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "ajito_honoo_020_cassiopeia_07",
      "hash64": "86C19B8FCFED7DE7",
      "text": "Wenn niemand übrig ist, um sie zu besänftigen,\\nwird sie sich schon zeigen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_honoo_020_cassiopeia_08",
      "hash64": "86C1908FCFED6B36",
      "text": "[EMPTY 15]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
