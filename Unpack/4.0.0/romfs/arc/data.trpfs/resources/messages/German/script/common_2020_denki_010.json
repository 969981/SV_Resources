      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_denki_010_denki_03",
      "hash64": "8820E1DABE3D3C75",
      "text": "Bitte was?! Du bist gerade erst Champ geworden\\nund darfst schon den Top-Champ vertreten?[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
