          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0010_rival_16b",
      "hash64": "382BDA5BAEEAB197",
      "text": "Das kannst du laut sagen! Das war die\\nNummer Eins.\\c\\nSie ist der absolute Wahnsinn... Ich wäre auch\\ngern so stark und cool wie sie!\\c\\nAber da bin ich nicht die Einzige – jeder\\nPokémon-Trainer himmelt sie an![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 209,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0010_rival_17",
      "hash64": "5D915519843A353C",
      "text": "Übrigens, erinnerst du dich noch daran, was ich\\ndich vorhin im Klassenzimmer gefragt hab?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0010_rival_02a",
      "hash64": "2F15A25BA9A652E5",
      "text": "Du hast doch gesagt, dass es dein Ziel sei,\\nden Pokédex zu vervollständigen, oder?\\c\\nAber hör mal...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0010_rival_02b",
      "hash64": "2F159F5BA9A64DCC",
      "text": "Du hast doch gesagt, dass es dein Ziel sei,\\n[VAR 0x1100(00FF,1513,0000)]ein starker Trainereine starke Trainerin zu werden, oder?\\c\\nIch hab da eine Idee...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1513",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0010_rival_02c",
      "hash64": "2F15A05BA9A64F7F",
      "text": "Du hast doch gesagt, dass du noch nicht wüsstest,\\nwas dein Ziel sei, oder?\\c\\nAlso, ich hab da eine Idee...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0010_rival_03",
      "hash64": "5D8DD11984371F19",
      "text": "Willst du nicht auch versuchen, ebenso wie ich\\nden [VAR 0xFF00(0006)]Champ-Rang[VAR 0xFF00(0000)] zu erreichen?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0010_slect_01",
      "hash64": "EE507076B7697910",
      "text": "Ja, gute Idee!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "champ_0010_slect_02",
      "hash64": "EE507376B7697E29",
      "text": "Ich weiß ja nicht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "champ_0010_rival_04a",
      "hash64": "2F1CAE5BA9AC85F7",
      "text": "Echt?! Das ging ja flott! Aber lass mich erst mal\\nerklären, was es damit auf sich hat.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "champ_0010_rival_04b",
      "hash64": "2F1CAF5BA9AC87AA",
      "text": "Ach komm, jemand Starkes wie du darf sein Talent\\nnicht vergeuden! Ich erklär dir mal die Details...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "champ_0010_rival_05",
      "hash64": "5D8DD3198437227F",
      "text": "Trainer, die den Champ-Rang wollen, trainieren\\nihre Pokémon, bis sie unglaublich stark sind.\\c\\nSie sind echte Kampfprofis und die Attacken\\nihrer Pokémon fesseln jeden Zuschauer![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 178,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "champ_0010_rival_06",
      "hash64": "5D8DD41984372432",
      "text": "Wenn du von der Pokémon-Liga anerkannt wirst,\\nzeichnen sie dich mit dem Champ-Rang aus.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "champ_0010_rival_07",
      "hash64": "5D8DD519843725E5",
      "text": "Aber um dieses Ziel zu erreichen, genügt es\\nnicht, nur am Unterricht teilzunehmen.\\c\\nDu musst alle acht Pokémon-Arenen bezwingen\\nund dir so die jeweiligen Arenaorden schnappen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 177,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "champ_0010_rival_08",
      "hash64": "5D8DD61984372798",
      "text": "Und dann gibt es noch eine letzte Hürde, die du\\nüberwinden musst: die Champ-Prüfung![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "champ_0010_rival_09",
      "hash64": "5D8DD7198437294B",
      "text": "Wenn du die bestehst, erhältst du ganz offiziell\\nden Champ-Rang![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "champ_0010_rival_10",
      "hash64": "5D915419843A3389",
      "text": "Dieser Titel ist eine echte Auszeichnung und der\\nTraum eines jeden Pokémon-Trainers!\\c\\nIch, äh, will jetzt hier nicht rumprahlen, aber...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "champ_0010_rival_11",
      "hash64": "5D915319843A31D6",
      "text": "Bei der letzten Schatzsuche habe ich den\\nChamp-Rang erreicht![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "champ_0010_rival_16",
      "hash64": "5D915619843A36EF",
      "text": "Ach ja, die Schatzsuche ist eine besondere freie\\nProjektarbeit, die bald wieder losgeht.\\c\\nDas letzte Mal fing sie gleich nach der Aufnahme\\nin die Akademie an.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 160,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "champ_0010_rival_12",
      "hash64": "5D915219843A3023",
      "text": "Man ist dafür außerhalb der Akademie unterwegs,\\nerlebt allerlei Abenteuer und lernt ganz auf\\r\\neigene Faust. Das ist ein Heidenspaß![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "champ_0010_rival_13",
      "hash64": "5D915119843A2E70",
      "text": "Hm, wo ich so darüber nachdenke...\\nVielleicht war ja diese Erfahrung an sich der\\r\\nSchatz, nach dem ich gesucht habe?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "champ_0010_rival_14",
      "hash64": "5D915819843A3A55",
      "text": "Jedenfalls habe ich das Gefühl, durch dich noch\\nstärker werden zu können, [VAR 0x0100(0000)].[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "champ_0010_rival_18",
      "hash64": "5D915C19843A4121",
      "text": "Weißt du was? Ich trage die Arenen einfach\\nschon mal in deiner Karten-App ein.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "champ_0010_rival_15",
      "hash64": "5D915719843A38A2",
      "text": "Denk mal darüber nach![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
