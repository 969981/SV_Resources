    {
      "ordinal": 5,
      "label": "champ_0010_select_03",
      "hash64": "3009FF203298CE9F",
      "text": "Wer war das?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "champ_0010_select_04",
      "hash64": "3009FC203298C986",
      "text": "Was für eine coole Person...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "champ_0010_rival_16a",
      "hash64": "382BDB5BAEEAB34A",
      "text": "Kein Wunder, dass sie deine Neugier geweckt\\nhat. Das war die Nummer Eins!\\c\\nSie ist echt der Wahnsinn... Ich wäre auch gern\\nso stark und cool wie sie!\\c\\nAber da bin ich nicht die Einzige – jeder\\nPokémon-Trainer himmelt sie an![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 151,
