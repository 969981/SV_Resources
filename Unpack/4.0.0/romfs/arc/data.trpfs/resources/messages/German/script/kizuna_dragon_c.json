    },
    {
      "ordinal": 2,
      "label": "kizuna_dragon_c_03",
      "hash64": "FD55995EBA6B18ED",
      "text": "Ich war so tief in Gedanken versunken, ich habe\\ndich gar nicht kommen sehen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_dragon_c_04",
      "hash64": "FD55925EBA6B0D08",
      "text": "Ich muss mich bei dir entschuldigen für das,\\nwas letztes Mal auf dem Sportplatz passiert ist...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_dragon_c_select_01",
      "hash64": "919C6BF04B41CC5E",
      "text": "Das ist nicht notwendig.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_dragon_c_select_02",
      "hash64": "919C6AF04B41CAAB",
      "text": "Wovon reden Sie?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_dragon_c_05a",
      "hash64": "E37843F6C3EA3C6E",
      "text": "Haha... Das ist sehr taktvoll von dir.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_dragon_c_05b",
      "hash64": "E37842F6C3EA3ABB",
      "text": "Ich musste mich doch inmitten unserer\\nUnterhaltung plötzlich davonmachen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_dragon_c_06",
      "hash64": "FD55945EBA6B106E",
      "text": "Die Trainerin, die an dem Tag auftauchte,\\nist eine Verwandte von mir.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_dragon_c_08",
      "hash64": "FD558E5EBA6B063C",
      "text": "Meine Familie ist seit jeher auf das Training von\\nDrachen-Pokémon spezialisiert.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_dragon_c_09",
      "hash64": "FD558F5EBA6B07EF",
      "text": "Seit meiner Kindheit wurde ich dazu erzogen,\\nirgendwann als Oberhaupt an der Spitze meiner\\r\\nFamilie zu stehen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_dragon_c_10",
      "hash64": "FD591C5EBA6E2D5D",
      "text": "Jedoch war ich in meiner Jugend ausgesprochen\\nrebellisch.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_dragon_c_11",
      "hash64": "FD591B5EBA6E2BAA",
      "text": "Eines Tages lief ich von zu Hause weg, mit dem\\nfesten Entschluss, meinen Lebensunterhalt mit\\r\\nMusik zu verdienen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_dragon_c_12",
      "hash64": "FD591A5EBA6E29F7",
      "text": "Seitdem ist viel geschehen. Heute stehe ich hier\\nals Kunstlehrer... und Mitglied der Top Vier.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_dragon_c_13",
      "hash64": "FD59195EBA6E2844",
      "text": "Nachdem ich mich neulich doch so abrupt\\nverabschiedet hatte, bat mich meine Verwandte,\\r\\ndas Unterrichten aufzugeben.\\c\\nStattdessen sollte ich nach Hause kommen und\\ndie Nachfolge als Familienoberhaupt antreten.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 212,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_dragon_c_14",
      "hash64": "FD59185EBA6E2691",
      "text": "Anscheinend geht es dem derzeitigen Kopf der\\nFamilie, meinem Vater, gesundheitlich nicht gut.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_dragon_c_15",
      "hash64": "FD59175EBA6E24DE",
      "text": "Ah, ich bitte um Entschuldigung.\\c\\nFür mich als Lehrer ist es beschämend,\\nSchüler mit meinen Problemen zu belasten.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_dragon_c_select_03",
      "hash64": "919C69F04B41C8F8",
      "text": "Nicht doch, sie sind ein guter Lehrer!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_dragon_c_select_04",
      "hash64": "919C70F04B41D4DD",
      "text": "Bitte geben Sie das Unterrichten nicht auf!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "kizuna_dragon_c_16",
      "hash64": "FD59165EBA6E232B",
      "text": "Deine Worte sind mir ein großer Trost,\\n[VAR 0x1100(00FF,0506,0000)]lieberliebe [VAR 0x0100(0000)]...[VAR 0x0114(0012)]",
      "flags": 0,
