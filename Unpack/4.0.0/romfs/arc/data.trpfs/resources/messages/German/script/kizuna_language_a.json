          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_language_a_04",
      "hash64": "9640893C202A5579",
      "text": "Wie ich schon im Unterricht immer sage,\\nKommunikation ist das Wichtigste![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_language_a_05",
      "hash64": "9640883C202A53C6",
      "text": "Wenn du etwas im Unterricht nicht verstehst\\noder wenn du Probleme an der Akademie hast...[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_language_a_06",
      "hash64": "9640873C202A5213",
      "text": "Just tell me! Ihr Schüler könnt immer auf mich\\nzählen.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
