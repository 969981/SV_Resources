          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0100_rival_21a",
      "hash64": "3745A964270B7AB2",
      "text": "Ein Tipp: Wirf einen Pokéball, wenn das Pokémon\\nfast besiegt ist. Das erleichtert das Fangen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0100_rival_20b",
      "hash64": "3742C66427097622",
      "text": "Weise Entscheidung! Wenn du befürchtest, nicht\\ngewinnen zu können, ist Flucht eine gute Option.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0100_rival_21b",
      "hash64": "3745A864270B78FF",
      "text": "Aber wenn du stärker bist, solltest du versuchen,\\ndas Pokémon mit einem Pokéball zu fangen.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0100_rival_20c",
      "hash64": "3742C764270977D5",
      "text": "Wow! Das war allererste Sahne! Ich hätte nicht\\ngedacht, dass dir das direkt gelingt![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_0100_rival_21c",
      "hash64": "3745A764270B774C",
      "text": "Was das Fangen von Pokémon angeht, bin ich\\necht ungeschickt... Vielleicht kannst du ja MIR\\r\\nein paar Tricks beibringen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0100_rival_20d",
      "hash64": "3742C06427096BF0",
      "text": "Oh, du hast verloren! Hast du vielleicht zu lange\\ngezögert, es anzugreifen?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "common_0100_rival_21d",
      "hash64": "3745A664270B7599",
      "text": "Einige wilde Pokémon erkennen einen Trainer an,\\nwenn sie sehen, wie stark er ist.\\c\\nAlso gib im Kampf alles und scheu dich nicht\\ndavor, Pokébälle zu werfen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 157,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "common_0100_rival_07",
      "hash64": "528ECC3E05FEB47F",
      "text": "Aber nicht jeder Wurf gelingt, also solltest du\\nimmer ausreichend Pokébälle bei dir tragen.\\r\\nHier hast du noch ein paar.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "common_0100_rival_08",
      "hash64": "528ED13E05FEBCFE",
      "text": "Du solltest ein Pokémon erst schwächen, bevor\\ndu einen Pokéball wirfst. Merk dir das, ja?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "common_0100_rival_09",
      "hash64": "528ED23E05FEBEB1",
      "text": "Stell dich unterwegs am besten ein paar wilden\\nPokémon und probier das Fangen gleich mal aus![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "common_0100_rival_14",
      "hash64": "52924B3E0601C223",
      "text": "Wie wär’s, wenn wir zum Leuchtturm da gehen?\\nVon dort oben können wir die Akademie sehen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "common_0100_rival_10",
      "hash64": "52924F3E0601C8EF",
      "text": "Wenn dein[VAR 0x1101(00FD,0100)]e Pokémon müde [VAR 0x1101(00FD,0403)]istsind, kann ich [VAR 0x1101(00FD,0302)]essie für\\ndich wieder fit machen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
