    {
      "ordinal": 14,
      "label": "common_0100_rival_20a",
      "hash64": "3742C5642709746F",
      "text": "Wow, sehr gut! Mit jedem besiegten Pokémon\\nwird [VAR 0x0101(0001)] stärker und stärker.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
