          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_008_fairy_01",
      "hash64": "BB429E3E873D6A86",
      "text": "Nerv uns nicht. Hast du etwa nichts Besseres zu\\ntun, als uns zu überwachen?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
