          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_008_aku_04",
      "hash64": "4368C859C8651DE3",
      "text": "Yo, yo, yo! Lernt ihr alle ordentlich?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
