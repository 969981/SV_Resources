    {
      "ordinal": 0,
      "label": "sdc01_0485_bbteacher_01",
      "hash64": "7248939413606F9F",
      "text": "Ah, [VAR 0x0100(0000)]![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
