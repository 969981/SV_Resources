      "hash64": "E4F2D8E37D111C96",
      "text": "Oh, [VAR 0x0100(0000)]![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
