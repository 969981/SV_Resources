          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_0095_mama_02",
      "hash64": "E4F2D7E37D111AE3",
      "text": "Du machst dich also jetzt zusammen mit Nemila\\nauf den Weg zur Akademie, ja?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0095_rival_01",
      "hash64": "C21E4249095E5426",
      "text": "Machen Sie sich keine Sorgen! Ich werde mich gut\\num [VAR 0x1100(00FF,0303,0000)]ihnsie kümmern![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0095_mama_03",
      "hash64": "E4F2D6E37D111930",
      "text": "Wie schön, dass du gleich eine Freundin\\ngefunden hast, mein Schatz![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0095_mama_04",
      "hash64": "E4F2DDE37D112515",
      "text": "Ich habe eben in der Broschüre der Akademie\\ngelesen, was für großartige Personen dort lehren!\\c\\nAußerdem scheint es eine Menge nützlicher\\nEinrichtungen zu geben, die du nach Lust\\r\\nund Laune nutzen kannst.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 179,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 207,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0095_mama_05",
      "hash64": "E4F2DCE37D112362",
      "text": "Nemila steht dir jetzt auch zur Seite, also wird\\ndas bestimmt eine tolle Erfahrung für dich![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0095_mama_09",
      "hash64": "E4F2E0E37D112A2E",
      "text": "Ab heute beginnt dein Leben an der Akademie...\\nSchau zu, dass du immer regelmäßig isst, ja?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0095_mama_06",
      "hash64": "E4F2DBE37D1121AF",
      "text": "Hier, etwas Geld und Verpflegung für [VAR 0x1100(00FF,0406,0000)]meinenmein\\n[VAR 0x1100(00FF,0E0D,0000)]großen Jungengroßes Mädchen![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0406",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0E0D",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0095_mama_10",
      "hash64": "E4EF53E37D0E04C0",
      "text": "Ach, und die hier nimmst du am besten auch\\nnoch mit.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0095_mama_11",
      "hash64": "E4EF54E37D0E0673",
      "text": "Für den Fall, dass sich dein kleiner Begleiter\\nverletzt.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0095_mama_12",
      "hash64": "E4EF55E37D0E0826",
      "text": "Dann verlässt du jetzt wohl das Nest, hach...\\c\\nEs erwarten dich spannende neue Eindrücke und\\nBekanntschaften am laufenden Band.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0095_mama_13",
      "hash64": "E4EF56E37D0E09D9",
      "text": "Ich wünsche dir nur das Beste und viel Erfolg\\nbei allem!\\c\\nBei den Dingen, die dir Spaß machen, aber auch\\nbei denen, die dir schwerfallen mögen.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0095_mama_07",
      "hash64": "E4F2DAE37D111FFC",
      "text": "Und du kannst natürlich jederzeit nach Hause\\nkommen und dich bei Mama ausruhen.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0095_mama_08",
      "hash64": "E4F2E1E37D112BE1",
      "text": "Dann macht euch mal auf den Weg.\\nUnd passt gut auf euch auf![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0095_rival_02",
      "hash64": "C21E4149095E5273",
      "text": "Deine Mutter ist ja total lieb![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0095_rival_03",
      "hash64": "C21E4049095E50C0",
      "text": "Aber wo waren wir noch mal stehen geblieben...?\\c\\nAch richtig, ich wollte dir zeigen, wie man\\nPokémon fängt![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0095_rival_04",
      "hash64": "C21E4749095E5CA5",
      "text": "Hier rüber![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
