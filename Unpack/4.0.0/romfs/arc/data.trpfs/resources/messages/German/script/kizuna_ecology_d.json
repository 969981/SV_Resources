          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_ecology_d_06",
      "hash64": "652B179A7659FBA4",
      "text": "Da, nimm nur. Ein kleiner Dank für deine Mühen.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
