    },
    {
      "ordinal": 14,
      "label": "sdc02_0010_headteacher_06",
      "hash64": "2F8FCFC3B7EC732B",
      "text": "Das hier ist Cyano, der Direktor der\\nBlaubeer-Akademie.\\c\\nEr ist derjenige, der dich für den\\nSchüleraustausch gewinnen möchte.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0010_headbb_08",
      "hash64": "1F17BF3F0FC0296F",
      "text": "Jawohl! Der Direktor, das bin ich!\\nHatte ich das noch nicht erwähnt?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
