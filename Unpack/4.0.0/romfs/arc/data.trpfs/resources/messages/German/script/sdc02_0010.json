          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0010_headteacher_07",
      "hash64": "2F8FCEC3B7EC7178",
      "text": "[VAR 0x1100(00FF,0506,0000)]SeinerIhrer Reaktion nach zu urteilen, hattest du das\\nwohl versäumt.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0506",
            "0000"
          ]
