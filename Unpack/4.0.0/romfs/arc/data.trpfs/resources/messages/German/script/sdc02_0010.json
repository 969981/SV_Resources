    },
    {
      "ordinal": 12,
      "label": "sdc02_0010_headteacher_04",
      "hash64": "2F8FD1C3B7EC7691",
      "text": "Das mag schon richtig sein, aber...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
