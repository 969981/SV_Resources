      ]
    },
    {
      "ordinal": 2,
      "label": "s2_side02_0000_camera_02",
      "hash64": "9042752F47698CE8",
      "text": "Ach, du bist’s, Partner! Nein, nicht „Partner“...\\n[VAR 0x0100(0000)] war dein Name![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
