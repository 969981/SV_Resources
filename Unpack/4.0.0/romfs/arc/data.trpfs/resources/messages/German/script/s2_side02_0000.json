          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_side02_0000_select_01",
      "hash64": "A9B6CC034E7F0708",
      "text": "Oh! Gemma!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_side02_0000_select_02",
      "hash64": "A9B6CF034E7F0C21",
      "text": "Kennen wir uns?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_side02_0000_camera_03",
      "hash64": "9042762F47698E9B",
      "text": "Die einzig wahre! Lange nicht gesehen, was?\\nDu siehst frisch und munter aus![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side02_0000_camera_04",
      "hash64": "90427B2F4769971A",
      "text": "Na, hör mal! Ich bin’s, Gemma! Ich hätte nicht\\ngedacht, dass du mir so die kalte Schulter\\r\\nzeigen würdest.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side02_0000_camera_05",
      "hash64": "90427C2F476998CD",
      "text": "Es kommt mir wie gestern vor, dass du mir in\\nKitakami bei den Nachforschungen zu Blutmond\\r\\ngeholfen hast.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side02_0000_camera_24",
      "hash64": "903B672F47635670",
      "text": "Zur Feier unseres Wiedersehens zeige ich dir\\neine neue Pose![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side02_0000_system_01",
      "hash64": "281F9E2E7F49CB0B",
      "text": "Gemma hat dir die Pose [VAR 0xFF00(0008)]Hand am Kinn[VAR 0xFF00(0000)]\\nbeigebracht!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side02_0000_camera_06",
      "hash64": "9042792F476993B4",
      "text": "Wow! Das Fukano, das ich dir anvertraut hatte,\\nhat sich ja entwickelt![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side02_0000_camera_07",
      "hash64": "90427A2F47699567",
      "text": "Ganz schön beeindruckend! Was für ein\\nprächtiges Arkani![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side02_0000_camera_08",
      "hash64": "90426F2F476982B6",
      "text": "Das Band zwischen zwei Fukano bleibt\\nunverwüstlich, auch wenn sie sich entwickeln.\\c\\nDu freust dich bestimmt sehr, dein Brüderchen\\nwiederzusehen, oder, Fukano?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 160,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side02_0000_poke_02",
      "hash64": "047BA6D75672BF2A",
      "text": "Fukaaa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s2_side02_0000_camera_09",
      "hash64": "9042702F47698469",
      "text": "Oh! Wie ich sehe, begleitet dich das Fukano,\\ndas ich dir anvertraut habe![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_side02_0000_camera_10",
      "hash64": "90457D2F476BD057",
      "text": "Unsere Fukano sind durch ein unverwüstliches\\nBand miteinander verbunden. Dass sie sich jetzt\\r\\nwiedersehen, ist also Schicksal. Hab ich recht?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side02_0000_poke_03",
      "hash64": "047BA7D75672C0DD",
      "text": "Kano!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s2_side02_0000_camera_11",
      "hash64": "90457C2F476BCEA4",
      "text": "Wie geht es dem Fukano, das ich dir anvertraut\\nhabe? Macht es sich gut?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side02_0000_camera_12",
      "hash64": "90457F2F476BD3BD",
      "text": "Nimm es doch hin und wieder mal auf deine\\nAbenteuer mit. Dann freut es sich![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side02_0000_poke_04",
      "hash64": "047BA0D75672B4F8",
      "text": "Kano...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "s2_side02_0000_camera_13",
      "hash64": "90457E2F476BD20A",
      "text": "Ah, du bist also gerade wegen eines\\nSchüleraustauschs hier, verstehe![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_side02_0000_camera_14",
      "hash64": "9045792F476BC98B",
      "text": "Wie es der Zufall so will, hab ich vor Kurzem an\\nder hiesigen Akademie einen Job als Fotografin\\r\\nangefangen.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_side02_0000_select_03",
      "hash64": "A9B6CE034E7F0A6E",
      "text": "Wow!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "s2_side02_0000_select_04",
      "hash64": "A9B6D1034E7F0F87",
      "text": "Du hast es eben drauf!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "s2_side02_0000_camera_15",
      "hash64": "9045782F476BC7D8",
      "text": "Hihihi! Ganz schön cool, was?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_side02_0000_camera_16",
      "hash64": "90457B2F476BCCF1",
      "text": "Hihihi! Ganz genau![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_side02_0000_camera_17",
      "hash64": "90457A2F476BCB3E",
      "text": "Na ja, noch bin ich aber in der Probezeit...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_side02_0000_camera_18",
      "hash64": "9045752F476BC2BF",
      "text": "Anscheinend will die Akademie Schnappschüsse\\nder Kuppel und einiger Schüler zu PR-Zwecken\\r\\nnutzen. Wie wär’s mit einem Foto von dir?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_side02_0000_camera_19",
      "hash64": "9045742F476BC10C",
      "text": "Ach, wo wir gerade von Fotos sprechen! Ich hab\\nein paar [VAR 0xFF00(0006)]brandheiße Infos[VAR 0xFF00(0000)] aufgeschnappt![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s2_side02_0000_camera_20",
      "hash64": "903B6B2F47635D3C",
      "text": "Aber wenn ich dir davon erzähle, düst du\\nbestimmt sofort wieder ab...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_side02_0000_camera_21",
      "hash64": "903B6C2F47635EEF",
      "text": "Machen wir’s so: Du fängst richtig viele Pokémon\\nin der Kuppel, damit ich unauffällig Fotos von\\r\\nihnen schießen kann.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "s2_side02_0000_camera_22",
      "hash64": "903B6D2F476360A2",
      "text": "Sobald du, sagen wir mal... 200 Pokémon in\\ndeinem Blaubeer-Pokédex registriert hast,\\r\\nsollte ich genug Material gesammelt haben.\\c\\nDann verrate ich dir meine [VAR 0xFF00(0006)]brandheißen Infos[VAR 0xFF00(0000)]![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
