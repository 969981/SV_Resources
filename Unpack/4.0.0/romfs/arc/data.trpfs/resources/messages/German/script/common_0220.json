      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_0220_rival_05a",
      "hash64": "751C4FE554A1047B",
      "text": "Aha, du legst also großen Wert aufs Äußere, hm?\\c\\nOder willst du dir vielleicht eine Frisur zulegen,\\ndie dich bei Pokémon-Kämpfen nicht stört?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
