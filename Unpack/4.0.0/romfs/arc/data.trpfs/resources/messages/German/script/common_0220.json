          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0220_rival_06",
      "hash64": "F8853B08C42AC391",
      "text": "Oh, wo wir gerade von Kämpfen sprechen...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0220_rival_07",
      "hash64": "F8853A08C42AC1DE",
      "text": "Ich will unbedingt sehen, wie du die\\nTerakristallisierung einsetzt![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0220_rival_08",
      "hash64": "F8853508C42AB95F",
      "text": "Es gibt eigentlich ein gewisses Prozedere, bevor\\nman das darf, aber ich mach das schon für dich.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0220_rival_09",
      "hash64": "F8853408C42AB7AC",
      "text": "Du kannst dich in der Zwischenzeit ruhig ein\\nwenig in der Stadt umsehen.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0220_rival_12",
      "hash64": "F881B508C427AA08",
      "text": "Hier gibt’s auch eine Boutique, falls du deine\\nUniform ein bisschen aufpeppen willst.\\r\\nOh, und tolle Restaurants![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0220_rival_13",
      "hash64": "F881B608C427ABBB",
      "text": "Ich persönlich würde dir das Geschäft BotoBeutel\\nwärmstens empfehlen.\\c\\nDort werden praktische Items verkauft, die du\\ndeinen Pokémon zum Tragen geben kannst.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 158,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0220_rival_10",
      "hash64": "F881B708C427AD6E",
      "text": "Wenn du genug gesehen hast, treffen wir uns\\nam besten vor der Akademie!\\c\\nAber mach dich auf eine ganz schön lange\\nTreppe gefasst...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
