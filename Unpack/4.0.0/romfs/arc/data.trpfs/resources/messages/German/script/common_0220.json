          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0220_rival_05b",
      "hash64": "751C50E554A1062E",
      "text": "Ah, du bist wohl ein kleiner Gourmet?\\c\\nNa ja, mit knurrendem Magen kämpft es sich\\naber auch schlecht, das stimmt.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
