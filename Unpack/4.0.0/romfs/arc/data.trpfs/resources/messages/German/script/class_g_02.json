        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_g_02_home_02",
      "hash64": "8981660884E66601",
      "text": "In der letzten Stunde habe ich euch erklärt,\\nwelche Vorteile ein beim Picknick sorgfältig\\r\\nzubereitetes Essen mit sich bringen kann.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
