          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_g_02_home_03",
      "hash64": "8981650884E6644E",
      "text": "Durch den Verzehr von zubereiteten Gerichten\\nkann man S-Kräfte erhalten und auch die KP aller\\r\\nTeam-Pokémon wiederherstellen. Praktisch, oder?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_g_02_home_04",
      "hash64": "8981680884E66967",
      "text": "Doch was, wenn ihr gerade nicht in der Lage\\nseid, etwas Leckeres zuzubereiten?\\c\\nWenn ihr euch in einem Kampf befindet und\\neuer Pokémon fix und fertig ist?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 156,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_g_02_home_05",
      "hash64": "8981670884E667B4",
      "text": "Dann solltet ihr Heil-Items wie [VAR 0xFF00(0006)]Tränke[VAR 0xFF00(0000)] einsetzen,\\ndie ihr beim Pokémon-Supermarkt oder im\\r\\nAkademiekiosk kaufen könnt.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_g_02_home_06",
      "hash64": "89816A0884E66CCD",
      "text": "Praktisch sind diese vor allem deshalb, weil ihr sie\\ndirekt aus eurem Beutel heraus einsetzen könnt.\\c\\nDer Nachteil? Jedes einzelne Exemplar kann nur\\nein Mal eingesetzt werden.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 177,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_g_02_home_07",
      "hash64": "8981690884E66B1A",
      "text": "Ein Trank stellt 20 KP wieder her, ein Supertrank\\n60 KP und ein Hypertrank 120 KP.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_g_02_home_08",
      "hash64": "89815C0884E65503",
      "text": "Je teurer das Item, desto mehr KP füllt es auf.\\c\\nWie viele davon ihr mit euch herumtragt,\\nmüsst ihr mit eurem Geldbeutel aushandeln.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_g_02_home_09",
      "hash64": "89815B0884E65350",
      "text": "Aber wenn eines sicher ist, dann, dass eure Reise\\nstets Überraschungen bereithalten wird.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_g_02_home_10",
      "hash64": "897DDE0884E34912",
      "text": "Stellt euch folgende Situation vor...\\c\\nEure Pokémon sind verletzt, doch ihr habt keine\\nTränke und eure Zutaten für Sandwiches sind\\r\\naufgebraucht. Von einem Pokémon-Center fehlt\\r\\nweit und breit jede Spur...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
