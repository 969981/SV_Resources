      "hash64": "8981630884E660E8",
      "text": "Packt eure Handys weg, wir beginnen jetzt\\nmit dem Unterricht.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
