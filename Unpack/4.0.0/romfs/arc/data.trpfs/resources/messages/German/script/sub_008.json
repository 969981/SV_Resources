        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sub_008_master_02",
      "hash64": "800BD54176DAD3D0",
      "text": "Soll eines deiner Pokémon mein\\nSuper-Spezialtraining absolvieren?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_008_master_03",
      "hash64": "800BD64176DAD583",
