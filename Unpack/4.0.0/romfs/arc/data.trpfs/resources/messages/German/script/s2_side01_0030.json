    {
      "ordinal": 1,
      "label": "s2_side01_0030_rival_01",
      "hash64": "FDAF2A3F123373E4",
      "text": "Na, was hast du als Reiseproviant mitgenommen,\\n[VAR 0x0100(0000)]?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
