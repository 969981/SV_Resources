    {
      "ordinal": 1,
      "label": "gym_normal_040_gym_receptionist_01",
      "hash64": "E493BA44D381D951",
      "text": "[VAR 0xBD06(0000)]Willkommen in der Arena von Mesclarra,\\n[VAR 0x0100(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_normal_040_gym_receptionist_02",
      "hash64": "E493B744D381D438",
      "text": "Wenn du gegen Arenaleiter Aoki antreten willst,\\nsprich bitte mit dem Personal der Schatzstube.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_normal_040_receptionist_00",
      "hash64": "0EB8253E4E40262A",
      "text": "Hallo, [VAR 0x0100(0000)]!\\c\\nHerzlich willkommen in der Schatzstube,\\ndem Sponsor der Mesclarra-Arena.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_normal_040_receptionist_01",
      "hash64": "0EB8263E4E4027DD",
      "text": "Möchtest du Arenaleiter Aoki herausfordern, den\\naußergewöhnlich gewöhnlichen Angestellten?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_normal_040_receptionist_02",
      "hash64": "0EB8233E4E4022C4",
      "text": "Dann begib dich jetzt bitte zum Kampfplatz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_normal_040_receptionist_03",
      "hash64": "0EB8243E4E402477",
      "text": "Sag einfach Bescheid, sobald du bereit bist!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_normal_040_receptionist_05",
      "hash64": "0EB8223E4E402111",
      "text": "Aokiii! Du bist dran!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_normal_040_normal_01",
      "hash64": "E4ECB2AC02E1AAE5",
      "text": "Hallo.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_normal_040_normal_02",
      "hash64": "E4ECAFAC02E1A5CC",
      "text": "Ich heiße Aoki und wurde der Mesclarra-Arena\\nals Arenaleiter zugeteilt.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_normal_040_normal_03",
      "hash64": "E4ECB0AC02E1A77F",
      "text": "Glückwunsch zur bestandenen Arenaprüfung.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_normal_040_normal_04",
      "hash64": "E4ECADAC02E1A266",
      "text": "Ähm... Du solltest übrigens auch die anderen\\nGerichte hier probieren. Die sind alle recht gut,\\r\\nnicht nur die Reisbällchen.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_normal_040_normal_05",
      "hash64": "E4ECAEAC02E1A419",
      "text": "Aber lassen wir den Smalltalk, sonst kriege ich\\nvon der Chefetage einen auf den Deckel...\\c\\nBringen wir diesen Kampf hinter uns.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_normal_040_normal_06",
      "hash64": "E4ECABAC02E19F00",
      "text": "Sehr [VAR 0x1100(00FF,1617,0000)]geehrter Herausforderergeehrte Herausforderin, beiliegend ist\\nmeine Einladung zum Kampf. Hochachtungsvoll,\\r\\nArenaleiter Aoki.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1617",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_normal_040_normal_07",
      "hash64": "E4ECACAC02E1A0B3",
      "text": "Deine Stärke ist außergewöhnlich. Das hat mich\\nganz aus dem Konzept gebracht... Sozusagen.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_normal_040_normal_08",
      "hash64": "E4ECB9AC02E1B6CA",
      "text": "Da ich verloren habe, muss ich dir nun diesen\\nOrden hier überreichen...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_normal_040_normal_09",
      "hash64": "E4ECBAAC02E1B87D",
      "text": "Der Kampf hat mich ganz schön hungrig gemacht.\\nWas hältst du davon, gemeinsam einen Happen\\r\\nzu essen?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_normal_040_normal_badge",
      "hash64": "3B461CE2FFA60749",
      "text": "Wenn du [VAR 0x0200(0001)] Arenaorden besitzt, lassen sich\\nPokémon bis Level [VAR 0x0201(0002)] leichter fangen...\\c\\nAh, und sie folgen allen deinen Anweisungen.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_normal_040_normal_badge_all",
      "hash64": "36909BBFC4BE01F9",
      "text": "Wenn du acht Arenaorden besitzt, kannst du alle\\nPokémon fangen...\\c\\nAußerdem widersetzen sie sich nicht deinen\\nAnweisungen.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_normal_040_normal_10",
      "hash64": "E4F037AC02E4C2BB",
      "text": "Ich finde das Essen hier ziemlich schmackhaft.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_normal_040_normal_waza",
      "hash64": "8A8AE8E413551DA3",
      "text": "Ein Kind wie du hat dafür vielleicht noch keine\\nVerwendung, aber nimm das hier bitte trotzdem.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_normal_040_normal_11",
      "hash64": "E4F036AC02E4C108",
      "text": "Und keine Sorge, die Rechnung geht natürlich\\nauf mich.\\c\\nSchließlich bin ich hier der Erwachsene mit\\nfestem Einkommen.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_normal_040_normal_12",
      "hash64": "E4F039AC02E4C621",
      "text": "In diesem Sinne, auf Wiedersehen.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_normal_040_receptionist_04",
      "hash64": "0EB8213E4E401F5E",
      "text": "Glückwunsch zu deinem Sieg in der Arena von\\nMesclarra!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
