    {
      "ordinal": 38,
      "label": "team_circle_win_01_00",
      "hash64": "9A76A3A7D6767E7F",
      "text": "Möchtest du dich mit Freunden verbinden,\\num mit ihnen Abenteuer zu erleben?",
