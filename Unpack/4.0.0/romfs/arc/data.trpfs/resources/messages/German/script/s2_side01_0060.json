      "ordinal": 24,
      "label": "s2_side01_0060_brother_12",
      "hash64": "5770CB3E3D38F5D9",
      "text": "Hä?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
