      "ordinal": 26,
      "label": "s2_side01_0060_rival_04",
      "hash64": "BE6E7FB6C0633E6C",
      "text": "Auf geht’s![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
