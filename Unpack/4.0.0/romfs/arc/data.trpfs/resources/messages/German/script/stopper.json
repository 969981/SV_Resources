      ]
    },
    {
      "ordinal": 5,
      "label": "stopper_common_0088_01",
      "hash64": "ECCF9E54E76ADA81",
      "text": "Wenn ich mich nicht irre, wartet Nemila am\\nStrand auf dich.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "stopper_common_0095_01",
      "hash64": "ADEDF249B490056F",
      "text": "Du hast noch kein Pokémon ausgewählt. Lass den\\nDirektor wissen, wie du dich entschieden hast!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "stopper_common_0170_01",
      "hash64": "1AA738F3C7B66831",
      "text": "Hun, hun! Moooon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "stopper_common_0170_02",
      "hash64": "1AA735F3C7B66318",
      "text": "Dem Geheul der Hundemon nach zu urteilen,\\nwäre es wohl besser, nicht hineinzugehen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "stopper_common_0170_03",
      "hash64": "1AA736F3C7B664CB",
      "text": "Da vorne sieht es gefährlich aus, daher solltest du\\nbesser nicht weitergehen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "stopper_common_0220_01",
      "hash64": "E0A8E5E3699496F9",
      "text": "Nichts wie auf zur Akademie! Du solltest Nemila\\nnicht warten lassen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "stopper_legend_0110_01",
      "hash64": "B4EB790148952C4F",
      "text": "Nanu...? Die Tür ist verschlossen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "stopper_dan_ajito_00",
      "hash64": "98CD61823F2547F1",
      "text": "Test, Test... Funktioniert das Ding überhaupt...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "stopper_dan_ajito_01",
      "hash64": "98CD60823F25463E",
      "text": "Hey, es ist strengstens verboten, sich einfach so\\nin unser Versteck zu schleichen![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "stopper_dan_ajito_02",
      "hash64": "98CD5F823F25448B",
      "text": "Wenn du unbedingt dein Glück versuchen willst,\\ndann klingle doch lieber und fordere uns offiziell\\r\\nzum Kampf heraus, wie es sich gehört![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
