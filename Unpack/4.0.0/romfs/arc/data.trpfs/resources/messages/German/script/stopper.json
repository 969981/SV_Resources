  "entries": [
    {
      "ordinal": 0,
      "label": "stopper_general_01",
      "hash64": "CB04017349BE696B",
      "text": "Schau lieber später noch mal hier vorbei!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "stopper_general_02",
      "hash64": "CB04027349BE6B1E",
      "text": "Du solltest vorerst lieber das Innere der\\nAkademie weiter erkunden!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "stopper_common_0030_01",
      "hash64": "C463F20AE2942618",
      "text": "Du bist noch nicht ganz bereit für die Akademie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "stopper_common_0060_01",
      "hash64": "70939D9739950D67",
      "text": "Begib dich gemeinsam mit den Pokémon zum\\nHaus am Ende des Weges!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "stopper_common_0070_01",
      "hash64": "818C7E69674F1B44",
      "text": "[VAR 0xBD06(0000)]Mensch, [VAR 0x0100(0000)]! Du musst doch noch\\ndein\\r\\nPokémon\\r\\nwählen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
