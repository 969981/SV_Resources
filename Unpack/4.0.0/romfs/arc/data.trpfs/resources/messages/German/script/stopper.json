    {
      "ordinal": 17,
      "label": "stopper_common_1300_01",
      "hash64": "BA179E5583835271",
      "text": "Die Fahrstuhltür ist fest verriegelt.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "stopper_common_1180_01",
      "hash64": "59D8EDE234F9E96B",
      "text": "Nutze die Schalttafel unten, um das Tor zum\\nLabor Null zu öffnen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "stopper_common_0130_01",
      "hash64": "D762C5524C148B7D",
      "text": "Du solltest das Pokémon nicht einfach seinem\\nSchicksal überlassen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "stopper_gym_stopper_01",
      "hash64": "3C471CB7DEB9F172",
      "text": "Die Arenaprüfung läuft gerade. Du solltest jetzt\\nnicht in die Arena gehen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "stopper_sdc02_0250_01",
