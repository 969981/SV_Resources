          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_e_07_battle_26",
      "hash64": "83D3C7680E273FAD",
      "text": "Wählt die Regeln aus, die am besten zu euch\\npassen, damit ihr euch spannende Kämpfe mit\\r\\neuren Freunden liefern könnt![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
