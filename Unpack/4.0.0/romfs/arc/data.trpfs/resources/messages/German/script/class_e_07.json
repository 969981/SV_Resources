    },
    {
      "ordinal": 11,
      "label": "class_e_07_battle_12",
      "hash64": "83C9B1680E1EC5C6",
      "text": "Bei Kämpfen mit [VAR 0xFF00(0006)]Normalen Regeln[VAR 0xFF00(0000)] treten alle\\nPokémon auf Level 50 gegeneinander an,\\r\\nungeachtet ihres tatsächlichen Levels.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_e_07_battle_13",
      "hash64": "83C9B2680E1EC779",
      "text": "Pokémon mit niedrigerem Level werden\\ndementsprechend auf Level 50 hochgestuft und\\r\\nkönnen zeigen, was sie wirklich draufhaben![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
