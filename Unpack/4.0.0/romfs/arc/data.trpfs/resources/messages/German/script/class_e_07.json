          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_e_07_battle_05",
      "hash64": "83CD38680E21E102",
      "text": "Heute sprechen wir über die Regeln, die während\\nLink-Kämpfen gelten.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_e_07_battle_06",
      "hash64": "83CD37680E21DF4F",
      "text": "Wenn zwei Trainer an Link-Kämpfen teilnehmen,\\nkönnen sie entweder einen Einzelkampf oder\\r\\neinen Doppelkampf austragen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_e_07_battle_07",
      "hash64": "83CD36680E21DD9C",
      "text": "Sollten sich sogar vier Trainer zusammenfinden,\\nsteht ihnen der Multikampf zur Auswahl.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_e_07_battle_08",
      "hash64": "83CD3D680E21E981",
      "text": "Während eurer freien Projektarbeit könnt ihr\\nKämpfe mit unterschiedlich vielen und starken\\r\\nPokémon austragen, frei nach Lust und Laune![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_e_07_battle_09",
      "hash64": "83CD3C680E21E7CE",
      "text": "Aber Link-Kämpfe unterliegen speziellen\\nKampfregeln, die ihr euch merken solltet.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_e_07_battle_10",
      "hash64": "83C9AF680E1EC260",
      "text": "Unter anderem betreffen sie die Level der\\nteilnehmenden Pokémon.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_e_07_battle_11",
      "hash64": "83C9B0680E1EC413",
      "text": "Hat ein Kampf [VAR 0xFF00(0006)]Keine Einschränkungen[VAR 0xFF00(0000)], bleiben\\ndie Level teilnehmender Pokémon so, wie sie sind!\\c\\nAußerdem können sich innerhalb eines Teams\\nmehrere Pokémon derselben Art befinden und\\r\\nmehrere Exemplare des gleichen Items können\\r\\ngetragen werden.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
