      "label": "class_e_07_battle_24",
      "hash64": "83D3C5680E273C47",
      "text": "Ich fasse noch einmal zusammen![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
