      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "class_e_07_battle_answer_01",
      "hash64": "1F260AB5952803D7",
      "text": "Das ist leider falsch! Bei den Normalen Regeln\\nwird der Level aller Pokémon auf 50 gesetzt.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_e_07_battle_answer_02",
      "hash64": "1F260BB59528058A",
      "text": "Ich wusste, dass du die Lauscher ordentlich\\ngespitzt hattest, Neuzugang![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_e_07_battle_21",
      "hash64": "83D3C0680E2733C8",
      "text": "Wenn man aus strategischen Gründen ein\\nPokémon auf Level 5 antreten lassen möchte,\\r\\ndann sollte man die Strengen Regeln auswählen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_e_07_battle_22",
      "hash64": "83D3C3680E2738E1",
      "text": "Alternativ steht einem natürlich auch die Option\\nKeine Einschränkungen offen.\\c\\nDann darf man beliebig mit Pokémon aller Level\\nund mit jeder Art von getragenen Items antreten.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 176,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_e_07_battle_23",
      "hash64": "83D3C2680E27372E",
      "text": "Diese Kampfregeln eignen sich bestens für\\nzwanglose Duelle unter Freunden.[VAR 0x0114(0024)]",
