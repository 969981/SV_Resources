          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_e_07_battle_19",
      "hash64": "83C9B8680E1ED1AB",
      "text": "Nun gut. Beantwortet mir mal folgende Frage![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_e_07_battle_20",
      "hash64": "83D3C1680E27357B",
      "text": "Welche Regeln wählt man, wenn man bewusst\\nein Pokémon mit einem niedrigen Level einsetzen\\r\\nmöchte? Normale Regeln oder Strenge Regeln?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
