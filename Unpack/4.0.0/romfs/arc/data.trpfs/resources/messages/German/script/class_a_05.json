          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_a_05_ecology_16",
      "hash64": "87DFE00EF897FEBE",
      "text": "Um die Entwicklung eines Pokémon abzubrechen,\\nmüsst ihr den B-Knopf drücken.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_a_05_ecology_17",
      "hash64": "87DFE10EF8980071",
      "text": "Wenn ihr das tut, sobald die Entwicklung beginnt,\\nkönnt ihr verhindern, dass euer Pokémon sein\\r\\nAussehen verändert.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_a_05_ecology_18",
      "hash64": "87DFDA0EF897F48C",
      "text": "Ihr könnt eurem Pokémon aber auch einen\\nEwigstein zum Tragen geben, um zu verhindern,\\r\\ndass es sich entwickelt.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_a_05_ecology_19",
      "hash64": "87DFDB0EF897F63F",
      "text": "Übrigens: Die Bedingungen für eine Entwicklung\\nunterscheiden sich je nach Pokémon.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_a_05_ecology_20",
      "hash64": "87EA540EF8A1185F",
      "text": "Es gibt Pokémon, die sich durch den Einsatz\\nvon Items wie zum Beispiel einem Feuerstein\\r\\noder einem Donnerstein entwickeln.\\c\\nAndere Pokémon müssen für die Entwicklung\\neine bestimmte Attacke erlernt haben oder ein\\r\\nbestimmtes Pokémon im Kampf besiegen.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 216,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 257,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_a_05_ecology_21",
      "hash64": "87EA530EF8A116AC",
      "text": "Die Art und Weise, wie sich Rasaff zu Epitaff\\nentwickelt, ist besonders ungewöhnlich![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_a_05_ecology_22",
      "hash64": "87EA560EF8A11BC5",
      "text": "Es gibt da eine Att--[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_a_05_ecology_23",
      "hash64": "87EA550EF8A11A12",
      "text": "Hoppla! Jetzt ist die Zeit schon wieder um.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_a_05_ecology_24",
      "hash64": "87EA500EF8A11193",
      "text": "Machen wir Schluss für heute. Vielen Dank euch\\nallen für eure Aufmerksamkeit![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
