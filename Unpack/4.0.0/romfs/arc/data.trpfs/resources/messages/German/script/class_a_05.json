          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_a_05_ecology_answer_02",
      "hash64": "59FAA549A854AC46",
      "text": "Ganz genau, ihr habt recht![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_a_05_ecology_answer_03",
      "hash64": "59FAA649A854ADF9",
      "text": "Oje, du hast als [VAR 0x1100(00FF,0708,0000)]EinzigerEinzige eine falsche Antwort\\ngegeben, [VAR 0x0100(0000)].\\c\\nDer C-Knopf... Da hat dich wohl die Nostalgie\\ngepackt![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0708",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
