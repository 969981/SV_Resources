          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_ecology_b_06",
      "hash64": "077F176A5BB7043E",
      "text": "Da, nimm nur. Ein kleiner Dank für deine Mühen.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_ecology_b_07",
      "hash64": "077F186A5BB705F1",
      "text": "Also, ich muss schon sagen, [VAR 0x0100(0000)]...\\nDu bist ein kleines Fangtalent, kann das sein?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
