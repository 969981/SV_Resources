          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_ecology_b_04",
      "hash64": "077F156A5BB700D8",
      "text": "Hoppla, entschuldige... Da ist die Begeisterung\\nein wenig mit mir durchgegangen.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
