          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_ecology_b_05",
      "hash64": "077F166A5BB7028B",
      "text": "Ich bin mir jedenfalls sicher, dass du noch eine\\ngroße Hilfe für meine Forschung sein wirst.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
