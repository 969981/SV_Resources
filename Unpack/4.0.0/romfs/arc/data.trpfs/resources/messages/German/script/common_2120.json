      "label": "common_2120_announce_01",
      "hash64": "53A1D6DB4C6269FA",
      "text": "Weiter geht es mit Runde 2. Welche Trainer\\ntreten diesmal gegeneinander an...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_2120_announce_02",
      "hash64": "53A1D5DB4C626847",
      "text": "Champ [VAR 0x0100(0000)] gegen...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
