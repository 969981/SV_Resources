    },
    {
      "ordinal": 15,
      "label": "common_2120_ecology_11",
      "hash64": "A46AA82180A2F0C8",
      "text": "Oje... Ist der Direktor wütend?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
