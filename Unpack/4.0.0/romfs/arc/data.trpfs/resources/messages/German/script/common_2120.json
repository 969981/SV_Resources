          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2120_ecology_09",
      "hash64": "A4672C21809FE83D",
      "text": "Wow, ein Satz mit X, das war wohl nix!\\nDu hast es echt drauf, [VAR 0x0100(0000)]![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2120_ecology_10",
      "hash64": "A46AA92180A2F27B",
      "text": "Bei deinem selbstsicheren Auftreten würdest du\\nsicher einen besseren Lehrer abgeben als ich![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
