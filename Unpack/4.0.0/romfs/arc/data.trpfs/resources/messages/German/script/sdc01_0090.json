  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0090_bbteacher_01",
      "hash64": "12AE6F419826A67D",
      "text": "Guten Morgen, alle zusammen!\\nHabt ihr gut geschlafen?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0090_bbteacher_02",
      "hash64": "12AE6C419826A164",
      "text": "Ab heute sind auch die Schüler der\\nBlaubeer-Akademie mit von der Partie.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0090_bbteacher_03",
      "hash64": "12AE6D419826A317",
      "text": "Könnt ihr euch bitte kurz vorstellen?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0090_sister_01",
      "hash64": "4496B518E49CBCF9",
      "text": "Hallo, ich bin Hana![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0090_sister_02",
      "hash64": "4496B218E49CB7E0",
      "text": "Ich hoffe, wir werden uns gut vertragen,\\nihr Fremd-- ihr aus Paldea! Hehe.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0090_brother_01",
      "hash64": "94B84D049862969D",
      "text": "I-Ich... bin Jo...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0090_caretaker_01",
      "hash64": "B1C8AA68D0909FB7",
      "text": "Die beiden stammen aus diesem Dorf. Ihr könnt\\nsie also ruhig fragen, wenn ihr Hilfe braucht.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0090_caretaker_02",
      "hash64": "B1C8AB68D090A16A",
      "text": "Zeigt euch von eurer besten Seite, ihr zwei.\\nIch verlasse mich auf euch.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0090_sister_03",
      "hash64": "4496B318E49CB993",
      "text": "Jaja.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0090_brother_02",
      "hash64": "94B84A0498629184",
      "text": "K-Klaro...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0090_caretaker_03",
      "hash64": "B1C8AC68D090A31D",
      "text": "Nun gut, dann erkläre ich euch mal, worum es\\nbei dieser Exkursion geht.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0090_caretaker_04",
      "hash64": "B1C8A568D0909738",
      "text": "Eure Aufgabe ist ein Orientierungslauf![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0090_caretaker_05",
      "hash64": "B1C8A668D09098EB",
      "text": "Ihr müsst euch in Paare aufteilen und die [VAR 0xFF00(0006)]drei[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]Infotafeln[VAR 0xFF00(0000)] finden, die in der Kitakami-Provinz\\r\\naufgestellt wurden.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0090_caretaker_06",
      "hash64": "B1C8A768D0909A9E",
      "text": "Auf den Tafeln stehen Auszüge einer alten\\nLegende aus Kitakami. Wenn ihr sie lest, erfahrt\\r\\nihr mehr über die Geschichte dieser Provinz.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0090_caretaker_07",
      "hash64": "B1C8A868D0909C51",
      "text": "Anschließend macht ihr bitte ein Foto von euch\\nzweien vor der jeweiligen Infotafel.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0090_caretaker_08",
      "hash64": "B1C8A168D090906C",
      "text": "Sobald ihr euch vor allen drei Infotafeln\\nfotografiert habt, ist die Mission abgeschlossen.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0090_caretaker_09",
      "hash64": "B1C8A268D090921F",
      "text": "Betrachtet es als eine Art Erkundungstour durch\\nKitakami und die Geschichte der Provinz![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0090_caretaker_10",
      "hash64": "B1CC2F68D093B78D",
      "text": "Das ist doch viel spannender, als wenn ich euch\\nhier einen langen Vortrag halten würde, oder?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0090_bbteacher_04",
      "hash64": "12AE6A4198269DFE",
      "text": "Das nenne ich mal eine innovative Aufgabe![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0090_caretaker_11",
      "hash64": "B1CC2E68D093B5DA",
      "text": "Oh, fast hätte ich es vergessen! Ihr bekommt\\nalle noch ein Geschenk von mir.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0090_caretaker_12",
      "hash64": "B1CC2D68D093B427",
      "text": "Ich habe gehört, die sind gerade der letzte Schrei\\nin den Großstädten.\\c\\nDie könnt ihr für eure Aufgabe sicher gut\\ngebrauchen![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0090_caretaker_14",
      "hash64": "B1CC2B68D093B0C1",
      "text": "Hier, ich bring euch auch gleich eine total hippe\\nSelfie-Pose bei, die ich mir ausgedacht habe![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0090_system_01",
      "hash64": "DDE13EB68F388552",
      "text": "Der Verwalter hat dir die [VAR 0xFF00(0008)]Coolness[VAR 0xFF00(0000)]-Pose\\nbeigebracht!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0090_bbteacher_05",
      "hash64": "12AE6B4198269FB1",
      "text": "Die ist also total hip, ja...?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0090_bbteacher_06",
      "hash64": "12AE684198269A98",
      "text": "Nun, diese Exkursion soll auch den Austausch\\nzwischen unseren Schulen fördern.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0090_bbteacher_07",
      "hash64": "12AE694198269C4B",
      "text": "Zudem wäre es sicherlich sehr nützlich, jemanden\\ndabeizuhaben, der sich in Kitakami auskennt.\\c\\nIhr könnt euch sicher denken, worauf ich\\nhinauswill...[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 151,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0090_bbteacher_08",
      "hash64": "12AE664198269732",
      "text": "Wenn möglich, solltet ihr euch mit jemandem\\naus der jeweils anderen Akademie zusammentun.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0090_caretaker_13",
      "hash64": "B1CC2C68D093B274",
      "text": "Sag mir bitte sofort Bescheid, falls Hana oder Jo\\nProbleme machen.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0090_student1_01",
      "hash64": "6364CD10CA6CB763",
      "text": "Wir sind vier Schüler von der [VAR 0x1107(00FF,0505)]OrangTrauben-Akademie\\nund zwei von der Blaubeer-Akademie.\\c\\nDas heißt, zwei von unserer Schule müssen ein\\nPaar bilden.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0505"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0090_student2_01",
      "hash64": "8F6BD5172BD6C9AC",
      "text": "Dieser Hana trau ich nicht über den Weg.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "sdc01_0090_student3_01",
      "hash64": "3A8F21213B3FE301",
      "text": "Der Gedanke, mit jemand Fremdem als Team\\nzusammenzuarbeiten, macht mich nervös...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "sdc01_0090_brother_03",
      "hash64": "94B84B0498629337",
      "text": "Argh...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0090_stopper_01",
      "hash64": "3DD6A55A136A6852",
      "text": "Unterhalte dich ein wenig mit den anderen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
