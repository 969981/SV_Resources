      ]
    },
    {
      "ordinal": 1,
      "label": "coach_teacher_health_first_01",
      "hash64": "DB9760C44104B9DC",
      "text": "Das hier ist dann wohl mein neuer Sanitätsraum,\\nnicht wahr?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_health_sp01_00",
      "hash64": "359B4BB7C4E55061",
      "text": "Ach, dann hast du mich also herbestellt, ja?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_health_sp01_01",
      "hash64": "359B4AB7C4E54EAE",
      "text": "War ich vielleicht überrascht, als es auf einmal\\nhieß, ich soll auf Geschäftsreise![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_health_sp01_02",
      "hash64": "359B49B7C4E54CFB",
      "text": "Und wer hätte gedacht, dass ich nicht an unserer\\nAkademie meinen allerersten Unterricht abhalten\\r\\nwürde, sondern ausgerechnet hier![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_health_sp01_select_01",
      "hash64": "A49B12D57D51AF3D",
      "text": "Hals- und Beinbruch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_health_sp01_select_02",
      "hash64": "A49B0FD57D51AA24",
      "text": "Das wird ein Kinderspiel!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_health_sp01_03",
      "hash64": "359B48B7C4E54B48",
      "text": "Du steckst ja nicht in meiner Haut, da sagt sich\\nso was leicht...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_health_sp01_03b",
      "hash64": "FC27BA43919EB85E",
      "text": "Von deinem Selbstvertrauen würde ich mir auch\\ngern eine Scheibe abschneiden![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_health_sp01_04",
      "hash64": "359B4FB7C4E5572D",
      "text": "Aber versteh mich nicht falsch, ich bin natürlich\\ndankbar, dass du mir diese Chance ermöglichst.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_health_sp01_05",
      "hash64": "359B4EB7C4E5557A",
      "text": "Packen wir es an! Herzlich willkommen in Mimis\\nSanitätsraum an der Blaubeer-Akademie![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_health_sp02_00",
      "hash64": "8ED009D10C36736E",
      "text": "[VAR 0xBD06(0000)]Hey, [VAR 0x0100(0000)]! Ich muss dir was\\nerzählen![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_health_sp02_01",
      "hash64": "8ED00AD10C367521",
      "text": "Ich hatte ja heute meinen ersten Unterricht\\nals Lehrerin, aber...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_health_sp02_02",
      "hash64": "8ED007D10C367008",
      "text": "Also der Unterricht selbst lief super, denke ich...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_health_sp02_03",
      "hash64": "8ED008D10C3671BB",
      "text": "Aber ich hab mich leider im Klassenzimmer\\ngeirrt und eine andere Klasse unterrichtet![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_health_sp02_select_01",
      "hash64": "BFCE805A3DD52AE0",
      "text": "Das ist ja ärgerlich...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_health_sp02_select_02",
      "hash64": "BFCE835A3DD52FF9",
      "text": "So was kommt vor!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_health_sp02_04",
      "hash64": "8ED00DD10C367A3A",
      "text": "Die Klasse war grade beim Selbststudium und da\\nhab ich mich ans Pult gestellt und den Unterricht\\r\\nzum Thema Gesundheitslehre begonnen.\\c\\nIch muss wie ein Eindringling gewirkt haben...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 186,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_health_sp02_04b",
      "hash64": "E201D237C091E388",
      "text": "Echt jetzt? Wo kommt so was bitte vor?!\\c\\nIch freu mich zwar, dass du zu mir hältst, aber an\\neiner Akademie darf so was nicht passieren.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_health_sp02_05",
      "hash64": "8ED00ED10C367BED",
      "text": "Lassen wir das Thema lieber. Wenn ich nur daran\\ndenke, könnte ich heulen. So peinlich war das![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_health_sp02_06",
      "hash64": "8ED00BD10C3676D4",
      "text": "Unangenehme Dinge vergisst man lieber schnell\\nund macht’s beim nächsten Mal besser![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_health_sp03_00",
      "hash64": "386A3FC970CCB2FF",
      "text": "[VAR 0xBD06(0000)]Hey, [VAR 0x0100(0000)]! Hättest du mal\\neben\\r\\neine\\r\\nMinute?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_health_sp03_01",
      "hash64": "386A3EC970CCB14C",
      "text": "Ich hab doch neulich in der falschen Klasse\\nunterrichtet, erinnerst du dich?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_health_sp03_02",
      "hash64": "386A41C970CCB665",
      "text": "Stell dir vor, mehrere Schüler aus der Klasse sind\\nanschließend mit Fragen zu mir gekommen![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_health_sp03_03",
      "hash64": "386A40C970CCB4B2",
      "text": "Für mich war das ja damals eine ziemliche\\nBlamage, die ich einfach nur vergessen will.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_health_sp03_04",
      "hash64": "386A3BC970CCAC33",
      "text": "Aber wenn ich an die Schüler denke, dann war\\ndoch nicht alles umsonst.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_health_sp03_05",
      "hash64": "386A3AC970CCAA80",
      "text": "Du glaubst gar nicht, wie glücklich mich das\\nmacht![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_health_sp03_select_01",
      "hash64": "4D1BAAAD33FA2C1B",
      "text": "Das ist doch super!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_health_sp03_select_02",
      "hash64": "4D1BABAD33FA2DCE",
      "text": "Da sind Sie bestimmt mächtig stolz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_health_sp03_06",
      "hash64": "386A3DC970CCAF99",
      "text": "Du sagst es![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_health_sp03_07",
      "hash64": "386A3CC970CCADE6",
      "text": "Unterrichten ist zwar jede Menge Arbeit,\\naber es macht auch total viel Spaß.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_health_sp03_08",
      "hash64": "386A47C970CCC097",
      "text": "Ich bin echt froh, dass ich meinen Traum vom\\nLehrberuf nie aufgegeben habe. Danke dafür![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_health_trade_01_00",
      "hash64": "8F74B786FF4D1059",
      "text": "Ach, hör mal. Hast du kurz Zeit?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_teacher_health_trade_01_01",
      "hash64": "8F74B686FF4D0EA6",
      "text": "Weißt du, du bist einfach immer für mich da,\\nwenn ich Hilfe brauche...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_teacher_health_trade_01_02",
      "hash64": "8F74B586FF4D0CF3",
      "text": "Und da wollte ich fragen, ob wir nicht bei einem\\nPokémon-Tausch unsere Freundschaft vertiefen\\r\\nwollen?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_teacher_health_trade_01_03",
      "hash64": "8F74B486FF4D0B40",
      "text": "Klasse! Ich würde dir mein Garstella anbieten.\\nWas hast du denn für mich?[VAR 0x0114(0028)]",
