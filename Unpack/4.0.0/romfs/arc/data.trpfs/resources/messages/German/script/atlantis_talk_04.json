  "entries": [
    {
      "ordinal": 0,
      "label": "atlantis_talk_04_friend_01",
      "hash64": "0B6F503EBE96FC38",
      "text": "Wie sind deine Eltern so, Nemila?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "atlantis_talk_04_rival_01",
      "hash64": "2F943421E23CA2E4",
      "text": "Hm... Ganz normal, würde ich sagen.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "atlantis_talk_04_botan_01",
      "hash64": "ECC8A4A044460EC2",
      "text": "Erzähl keinen Unsinn. Sogar ich weiß, dass dein\\nVater der Präsident der Smart-Rotom-Firma ist![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "atlantis_talk_04_rival_02",
      "hash64": "2F943721E23CA7FD",
      "text": "Woher weißt du das?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "atlantis_talk_04_botan_02",
      "hash64": "ECC8A3A044460D0F",
      "text": "Er ist eben berühmt. Außerdem habe ich auch\\nselber etwas recherchiert...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "atlantis_talk_04_friend_02",
      "hash64": "0B6F533EBE970151",
      "text": "Du bist also eine verwöhnte kleine Prinzessin\\naus gutem Hause?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "atlantis_talk_04_rival_03",
      "hash64": "2F943621E23CA64A",
      "text": "Was?! Nein! Absolut nicht![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "atlantis_talk_04_rival_04",
      "hash64": "2F943121E23C9DCB",
      "text": "Hm, aber... Na ja...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "atlantis_talk_04_rival_05",
      "hash64": "2F943021E23C9C18",
      "text": "Mutter und Vater haben sich nie wirklich\\neingemischt, und das war okay so.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "atlantis_talk_04_rival_06",
      "hash64": "2F943321E23CA131",
      "text": "Um die Familienfirma wird sich meine große\\nSchwester kümmern, daher hatte ich viel Freiheit.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "atlantis_talk_04_friend_03",
      "hash64": "0B6F523EBE96FF9E",
      "text": "Du nennst deine Eltern „Mutter“ und „Vater“?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "atlantis_talk_04_botan_03",
      "hash64": "ECC8A2A044460B5C",
      "text": "Da spricht wohl doch die Prinzessin aus gutem\\nHause...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "atlantis_talk_04_rival_07",
      "hash64": "2F943221E23C9F7E",
      "text": "Argh, jetzt reicht’s aber!\\nCosima, wie ist denn deine Familie so?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "atlantis_talk_04_botan_04",
      "hash64": "ECC8A1A0444609A9",
      "text": "Ähm... Also...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "atlantis_talk_04_botan_05",
      "hash64": "ECC8A0A0444607F6",
      "text": "Supernervig.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "atlantis_talk_04_rival_08",
      "hash64": "2F942D21E23C96FF",
      "text": "Wieso? Sind sie überfürsorglich oder so?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "atlantis_talk_04_botan_06",
      "hash64": "ECC89FA044460643",
      "text": "Mein Dad ist sooo peinlich! Er ist anhänglich, viel\\nzu laut und gibt mir Spitznamen wie „Cosirosi“![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "atlantis_talk_04_botan_07",
      "hash64": "ECC89EA044460490",
      "text": "Es ist zum Haareraufen, sag ich euch!\\nEr ist so meganervig![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "atlantis_talk_04_friend_04",
      "hash64": "0B6F553EBE9704B7",
      "text": "Da kriegt man ja echt Mitleid... mit deinem Vater,\\nCosirosi![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "atlantis_talk_04_botan_08",
      "hash64": "ECC8ADA044461E0D",
      "text": "Pfff, sehr witzig![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "atlantis_talk_04_rival_09",
      "hash64": "2F942C21E23C954C",
      "text": "Äääh... [VAR 0x0100(0000)], was ist mir dir?\\nDeine Mutter schien ja supernett zu sein![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "atlantis_talk_04_friend_05",
      "hash64": "0B6F543EBE970304",
      "text": "Du hast sie mal getroffen?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "atlantis_talk_04_rival_10",
      "hash64": "2F912F21E23A648E",
      "text": "Ja! Ihr selbst gemachtes Sandwich sah echt\\nlecker aus![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "atlantis_talk_04_friend_06",
      "hash64": "0B6F573EBE97081D",
      "text": "Wow, hast du’s gut. Was würde ich jetzt für\\nso ein Sandwich geben...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    }
  ]
}
