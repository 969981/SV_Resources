          "kind": "control",
          "offset_units": 160,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_e_01_battle_08",
      "hash64": "D9208F7370DE96E3",
      "text": "Diese Eigenschaften umfassen unter anderem\\nStärke, Typ und [VAR 0xFF00(0006)]Kategorie[VAR 0xFF00(0000)].[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
