      "label": "class_e_01_select_02",
      "hash64": "203A7842D4356C1B",
      "text": "Physische Attacken und Spezial-Attacken",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
