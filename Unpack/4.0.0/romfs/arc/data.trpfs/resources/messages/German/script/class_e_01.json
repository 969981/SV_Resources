          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_e_01_battle_09",
      "hash64": "D9208E7370DE9530",
      "text": "Je stärker eine Attacke ist, desto mehr Schaden\\nrichtet sie an.\\c\\nDer Schaden steigt noch weiter, wenn der Gegner\\ngegenüber dem Typ der Attacke schwach ist.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 157,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_e_01_battle_10",
      "hash64": "D91D117370DB8AF2",
      "text": "Von den Kategorien gibt es zwei an der Zahl.\\nNeuzugang, kannst du mir sagen, welche?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
