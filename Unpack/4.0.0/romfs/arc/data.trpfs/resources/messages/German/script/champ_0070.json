    },
    {
      "ordinal": 7,
      "label": "champ_0070_top_07",
      "hash64": "ED5B57300D1EFED2",
      "text": "Mein Name ist Sagaria. Ich bin die Präsidentin\\nder Pokémon-Liga. Das ist die Organisation,\\r\\ndie für die Verwaltung der Arenen zuständig ist.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
