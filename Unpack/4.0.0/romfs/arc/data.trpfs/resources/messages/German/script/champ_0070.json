      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0070_top_06",
      "hash64": "ED5B58300D1F0085",
      "text": "Oh, ich habe mich ja noch gar nicht vorgestellt.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
