  "entries": [
    {
      "ordinal": 0,
      "label": "sub_046_child_f_01",
      "hash64": "AF56210A305FD036",
      "text": "Magst du mir zeigen, wie zutraulich dein[VAR 0x1101(00FD,0100)]e\\nPokémon [VAR 0x1101(00FD,0403)]istsind?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0403"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sub_046_child_f_02",
      "hash64": "AF56200A305FCE83",
      "text": "Bei welchem Pokémon hast du das Gefühl,\\ndass es zutraulich ist?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_046_child_f_03",
      "hash64": "AF561F0A305FCCD0",
      "text": "Hm... Dann schauen wir doch mal, wie zutraulich\\n[VAR 0x0102(0001)] ist...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_046_child_f_04",
      "hash64": "AF56260A305FD8B5",
      "text": "Ihr seid die besten Freunde! Man sieht, dass ihr\\neure gemeinsame Zeit richtig genießt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_046_child_f_05",
      "hash64": "AF56250A305FD702",
      "text": "Wow, dein Pokémon ist sehr zutraulich! Ihr zwei\\nhabt euch offensichtlich richtig gern.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_046_child_f_06",
      "hash64": "AF56240A305FD54F",
      "text": "Ihr versteht euch ja richtig gut und habt bestimmt\\neine Menge Spaß zusammen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_046_child_f_07",
      "hash64": "AF56230A305FD39C",
      "text": "Ihr versteht euch schon ziemlich gut, aber da ist\\nnoch Luft nach oben!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_046_child_f_08",
      "hash64": "AF562A0A305FDF81",
      "text": "Ihr mögt euch schon ein bisschen. Ihr werdet\\nbestimmt noch gute Freunde!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_046_child_f_09",
      "hash64": "AF56290A305FDDCE",
      "text": "Hm, seine Einstellung zu dir ist recht neutral.\\nIch hoffe, ihr lernt euch bald besser kennen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_046_child_f_10",
      "hash64": "AF529C0A305CB860",
      "text": "Seid ihr euch gerade erst begegnet?\\nEuer Umgang miteinander wirkt ein wenig steif.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_046_child_f_11",
      "hash64": "AF529D0A305CBA13",
      "text": "Nanu? Was ist denn da los? Dein Pokémon ist dir\\ngegenüber ja überhaupt nicht zutraulich...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_046_child_f_12",
      "hash64": "AF529E0A305CBBC6",
      "text": "Als Zeichen eurer Freundschaft hab ich hier was\\nTolles für dich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_046_system_01",
      "hash64": "4DBAA28FEF755C82",
      "text": "[VAR 0xBD06(0000)][VAR 0x0102(0001)] wurde das Zutraulichkeitsband\\nangesteckt!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_046_child_f_13",
      "hash64": "AF529F0A305CBD79",
      "text": "Komm jederzeit wieder vorbei!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_046_child_f_14",
      "hash64": "AF52A00A305CBF2C",
      "text": "Je mehr Zeit du mit deinen Pokémon verbringst,\\ndesto zutraulicher werden sie auch.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
