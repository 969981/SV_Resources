    {
      "ordinal": 48,
      "label": "coach_teacher_history_battleend_win_00_02",
      "hash64": "1473B63FE834ACFE",
      "text": "Gut... Hier, ich schenke dir eine Kleinigkeit.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
