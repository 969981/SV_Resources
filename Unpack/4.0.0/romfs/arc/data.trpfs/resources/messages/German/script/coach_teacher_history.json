          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_history_sp01_02",
      "hash64": "0D384BD6F5849BEB",
      "text": "Hehehe... Sieh es als eine Art Gefallen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_history_sp01_03",
      "hash64": "0D384AD6F5849A38",
      "text": "Im Gegenzug musst du irgendwann tun, was ich\\nverlange.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_history_sp01_select_01",
      "hash64": "57AE81059636D3ED",
      "text": "Moment mal...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_history_sp01_select_02",
      "hash64": "57AE7E059636CED4",
      "text": "Verstanden!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_history_sp01_05",
      "hash64": "0D3850D6F584A46A",
      "text": "Hehehe. Man erntet, was man sät. Hoff also\\nbesser auf eine gute Ernte.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_history_sp01_05b",
      "hash64": "FB5565433062B998",
      "text": "Oh? Wie unerwartet gehorsam du doch bist.\\nHehehe... Das kommt mir sehr gelegen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_history_sp01_04",
      "hash64": "0D3851D6F584A61D",
      "text": "Mal sehen, zu was für einer kleinen Marionette\\ndu werden wirst... Das wird sicher interessant.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_history_sp02_00",
      "hash64": "666D0BF03CD5C25E",
      "text": "Ah, du schon wieder? Du bist wieder einige Tage\\nälter geworden.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_history_sp02_01",
      "hash64": "666D0CF03CD5C411",
      "text": "Zuerst war ich nur sehr widerwillig hier, aber ich\\nhabe meine Meinung geändert.\\c\\nDie Einall-Region ist eine wahre Fundgrube an\\nuralter Geschichte![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_history_sp02_02",
      "hash64": "666D09F03CD5BEF8",
      "text": "Ich brenne vor allem darauf, die alten Ruinen zu\\nerkunden, die auf dem Meeresboden liegen![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_history_sp02_03",
      "hash64": "666D0AF03CD5C0AB",
      "text": "Zudem kann der Direktor hier seine Nase nicht in\\nmeine Angelegenheiten stecken. Sehr vorteilhaft.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_history_sp02_04",
      "hash64": "666D0FF03CD5C92A",
      "text": "Nachher werde ich gleich mal mit meinen\\nPokémon schwimmen gehen und meine\\r\\nEntdeckungstour starten![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_history_sp02_select_01",
      "hash64": "2FC3C3870821A010",
      "text": "Viel Spaß!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_history_sp02_select_02",
      "hash64": "2FC3C6870821A529",
      "text": "Seien Sie vorsichtig!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_history_sp02_05",
      "hash64": "666D10F03CD5CADD",
      "text": "Hehehe... Ist es überhaupt möglich, dabei keinen\\nSpaß zu haben?\\c\\nSich vom Gedankengut der Antike inspirieren zu\\nlassen, ist von unschätzbarem Wert.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_history_sp02_05b",
      "hash64": "E11E87375F47828D",
      "text": "Hehehe... Keine Sorge. Wenn ich umgeben von\\nRuinen und Artefakten meine letzte Ruhe finden\\r\\nsollte, wäre ich mehr als zufrieden.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_history_sp03_00",
      "hash64": "8F3801E4F1FB6D2F",
      "text": "Aaargh... Hey... [VAR 0x0100(0000)]...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_history_sp03_select_01",
      "hash64": "8C4F417AD5A90CCB",
      "text": "Alles in Ordnung?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_history_sp03_select_02",
      "hash64": "8C4F427AD5A90E7E",
      "text": "Geht es Ihnen nicht gut?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_history_sp03_01",
      "hash64": "8F3800E4F1FB6B7C",
      "text": "Ist es nicht offensichtlich? Ich habe mich von\\nmeinem Enthusiasmus so mitreißen lassen,\\r\\ndass ich vollkommen erschöpft bin.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_history_sp03_01b",
      "hash64": "5794A3072E3703FA",
      "text": "Hehehe... Im Gegenteil! Ich habe mich von\\nmeinem Enthusiasmus so mitreißen lassen,\\r\\ndass ich vollkommen erschöpft bin.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_history_sp03_02",
      "hash64": "8F3803E4F1FB7095",
      "text": "Gestern bin ich gemeinsam mit Lumineon zur\\nUnterwasserruine von Einall geschwommen...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_history_sp03_03",
      "hash64": "8F3802E4F1FB6EE2",
      "text": "Es war... überragend... Einfach phänomenal...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_history_sp03_04",
      "hash64": "8F37FDE4F1FB6663",
      "text": "Antike Vorrichtungen, die Eindringlinge\\nabwehren! Uralte Inschriften an den Wänden![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_history_sp03_05",
      "hash64": "8F37FCE4F1FB64B0",
      "text": "Der intellektuelle Vergleich mit den Menschen\\nder Antike war wirklich wunderbar erleuchtend![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_history_sp03_06",
      "hash64": "8F37FFE4F1FB69C9",
      "text": "Es wäre viel zu schade, direkt bis zum tiefsten\\nTeil der Ruine vorzudringen.\\c\\nIch plane, sie schrittweise zu erkunden.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_history_trade_01_00",
      "hash64": "3D5AF8BE8D788069",
      "text": "[VAR 0xBD06(0000)]Ah, [VAR 0x0100(0000)]! Ich hatte eine\\ntolle\\r\\nIdee![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
