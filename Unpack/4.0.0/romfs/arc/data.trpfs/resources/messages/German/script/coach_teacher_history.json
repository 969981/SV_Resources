      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "coach_teacher_history_trade_03_00",
      "hash64": "1484CCCEFE4AD287",
      "text": "Es scheint, als hättest du nur ein einziges\\nhandlungsfähiges Pokémon bei dir.\\c\\nEs wäre ratsam, mindestens zwei Pokémon\\nmitzubringen, bevor wir tauschen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
