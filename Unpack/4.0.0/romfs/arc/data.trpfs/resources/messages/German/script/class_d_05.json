      "label": "class_d_05_yes_02",
      "hash64": "37FC83BE86968825",
      "text": "Yes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_d_05_language_03",
      "hash64": "6D2EFBECA3C31A67",
      "text": "Das war ja mal eine tolle Antwort. Gracias!\\nGanz wie erwartet von so tollen Schülern![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
