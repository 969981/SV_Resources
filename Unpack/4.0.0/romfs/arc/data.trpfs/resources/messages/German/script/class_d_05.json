    },
    {
      "ordinal": 30,
      "label": "class_d_05_language_18",
      "hash64": "6D326AECA3C60CDB",
      "text": "Auch Pokémon derselben Art kommunizieren auf\\nganz unterschiedliche Weise.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "class_d_05_language_19",
      "hash64": "6D3269ECA3C60B28",
      "text": "Je nach Gemütslage oder Befinden ändert sich\\nnämlich ihr Tonfall.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "class_d_05_language_20",
      "hash64": "6D27F0ECA3BCE908",
      "text": "Versucht mal, nach dem Unterricht genauer auf\\ndie Laute der Pokémon zu achten.\\c\\nSo könnt ihr lernen, eure Pokémon besser zu\\nverstehen.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "class_d_05_language_21",
      "hash64": "6D27F1ECA3BCEABB",
      "text": "Pokémon sind wundersame, wundersame Wesen.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "class_d_05_language_22",
      "hash64": "6D27F2ECA3BCEC6E",
      "text": "Manche von ihnen benutzen gar keine regulären\\nLaute.\\c\\nStattdessen kommunizieren sie über Ultraschall,\\nelektromagnetische Wellen oder Telepathie.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
