          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_d_05_language_04",
      "hash64": "6D2EF8ECA3C3154E",
      "text": "In der ersten Hälfte des Semesters haben wir uns\\nWörter und Ausdrücke aus der ganzen Welt\\r\\nangeschaut.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_05_language_05",
      "hash64": "6D2EF9ECA3C31701",
      "text": "In der zweiten Hälfte wird der Kurs etwas anders\\nablaufen. Ab jetzt kümmern wir uns nämlich ums\\r\\nHörverstehen.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_d_05_language_06",
      "hash64": "6D2EF6ECA3C311E8",
      "text": "Let’s go! Pikachu![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
