  "entries": [
    {
      "ordinal": 0,
      "label": "sub_011_takara_cook_00",
      "hash64": "237871EE06E9D2F5",
      "text": "Willkommen! Du kannst deine Bestellung am\\nEmpfang aufgeben.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_011_takara_cook_01",
      "hash64": "237870EE06E9D142",
      "text": "Ich hab gehört, du hast Aoki geschlagen.\\nSehr beeindruckend!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_011_takara_cook_02",
      "hash64": "23786FEE06E9CF8F",
      "text": "Für so großartige Kunden wie dich bereite ich ein\\nganz besonderes Gericht zu – eins, mit dem sich\\r\\nder Tera-Typ eines Pokémon ändern lässt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_011_takara_cook_03",
      "hash64": "23786EEE06E9CDDC",
      "text": "Dafür benötige ich allerdings eine Zutat namens\\nTera-Stück. Besuche mich, wenn du ein paar\\r\\ndavon in die Finger bekommst.\\c\\nAch ja, hier ist noch ein kleines Geschenk!\\nDamit kannst du den Tera-Typ zu Normal ändern.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_011_takara_cook_04",
      "hash64": "23786DEE06E9CC29",
      "text": "Soll ich mein Spezialrezept zubereiten, um den\\nTera-Typ eines deiner Pokémon zu ändern?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
