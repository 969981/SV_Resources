    {
      "ordinal": 24,
      "label": "sub_011_takara_select_03",
      "hash64": "D68D266840CF37F0",
      "text": "Abbrechen",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "sub_011_takara_cook_05",
      "hash64": "23786CEE06E9CA76",
      "text": "Oh, das reicht leider nicht. Du benötigst\\n50 Tera-Stücke.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "sub_011_takara_cook_06",
      "hash64": "23786BEE06E9C8C3",
      "text": "Es ist ganz einfach: Du bringst mir Zutaten und\\nich bereite damit ein besonderes Gericht zu,\\r\\ndas den Tera-Typ eines Pokémon ändern kann.\\c\\nIch brauche für jedes Gericht 50 Tera-Stücke.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sub_011_takara_cook_07",
      "hash64": "23786AEE06E9C710",
      "text": "Welchem Pokémon möchtest du das Gericht\\nzu essen geben?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
