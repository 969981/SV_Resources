            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_health_d_10",
      "hash64": "062CE78C86334D09",
      "text": "Ich werde also noch ein Weilchen länger hier im\\nSanitätsraum mein Unwesen treiben...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
