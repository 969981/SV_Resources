        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_health_d_08",
      "hash64": "0629698C86304118",
      "text": "Aber ich bin dir irre dankbar, dass du mir den\\nnötigen Schubser verpasst hast.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
