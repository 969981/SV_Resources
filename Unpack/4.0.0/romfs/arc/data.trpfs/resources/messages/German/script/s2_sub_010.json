          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_010_headbb_first_04",
      "hash64": "5055D40A700B1C38",
      "text": "Ah, richtig. Was macht dein Fortschritt im\\nBlaubeer-Pokédex?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_010_headbb_first_05",
      "hash64": "5055D50A700B1DEB",
      "text": "Zeig ihn mir doch, wenn du eine ordentliche\\nAnzahl an Pokémon registriert hast![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_010_headbb_first_06",
      "hash64": "5055D60A700B1F9E",
      "text": "Und wenn dein Pokédex vollständig ist, sollst du\\nauch eine Menge Lob von mir bekommen.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_010_headbb_01",
      "hash64": "11282969A285005C",
      "text": "Hallöchen, [VAR 0x0100(0000)].[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
