            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_010_headbb_02",
      "hash64": "11282C69A2850575",
      "text": "Du hast in der Tera-Kuppel [VAR 0x0202(0001)] Pokémon-Art[VAR 0x1101(0001,0200)]en\\ngefangen.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0202",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0200"
