  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0430_ogre_01",
      "hash64": "721FB3C1311E137A",
      "text": "Pooon...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc01_0430_sister_01",
      "hash64": "CBFF4DD8D0C2736B",
      "text": "Oje, es hat echt Angst...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0430_brother_01",
      "hash64": "B30F4CC7D6156887",
      "text": "M-Macht euch keine Sorgen![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0430_sister_02",
      "hash64": "CBFF4ED8D0C2751E",
      "text": "Jo! Willst du uns endlich mal verraten,\\nwas das werden soll?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0430_brother_02",
      "hash64": "B30F4DC7D6156A3A",
      "text": "Ich kann mir vorstellen, dass du Angst hast.\\nAber ich hab mich um alles gekümmert...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0430_brother_03",
      "hash64": "B30F4EC7D6156BED",
      "text": "Also bitte, Oni... Vertrau mir und komm mit, ja?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0430_people_01",
      "hash64": "04AB79A5880E5D6E",
      "text": "D-Der Oni... Ogerpon...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc01_0430_people_02",
      "hash64": "04AB78A5880E5BBB",
      "text": "Es existiert also wirklich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc01_0430_ogre_02",
      "hash64": "721FB2C1311E11C7",
      "text": "P-Pon...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sdc01_0430_select_01",
      "hash64": "0A5307DC793D299B",
      "text": "Mach dir keine Sorgen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc01_0430_select_02",
      "hash64": "0A5308DC793D2B4E",
      "text": "Wir sollten Jo vertrauen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sdc01_0430_caretaker_01",
      "hash64": "9A314B5A446CFDA1",
      "text": "Das ist also der Oni vom Oniyama...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0430_caretaker_02",
      "hash64": "9A31485A446CF888",
      "text": "Nein, entschuldige, ich sollte dich bei deinem\\nrichtigen Namen nennen – Ogerpon![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0430_caretaker_03",
      "hash64": "9A31495A446CFA3B",
      "text": "Die Bewohner von Kitakami haben dich lange\\nZeit für einen Missetäter gehalten.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0430_caretaker_04",
      "hash64": "9A314E5A446D02BA",
      "text": "Dafür möchten wir uns aufrichtig entschuldigen.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0430_ogre_03",
      "hash64": "721FB1C1311E1014",
      "text": "Pon...?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc01_0430_sister_03",
      "hash64": "CBFF4FD8D0C276D1",
      "text": "Bin ich im falschen Film? Woher kommt denn der\\nplötzliche Sinneswandel?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0430_gfather_01",
      "hash64": "7CE90C884A5AF468",
      "text": "Jo ist im ganzen Dorf rumgegangen und hat\\nallen die wahre Geschichte erzählt.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0430_gfather_02",
      "hash64": "7CE90F884A5AF981",
      "text": "Ich wollte ihn davon abbringen, weil ich\\nbefürchtete, dass er damit den Groll der\\r\\nBewohner auf sich ziehen würde, aber...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0430_people_03",
      "hash64": "04AB77A5880E5A08",
      "text": "Tut uns echt leid, lieber Oni!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc01_0430_people_04",
      "hash64": "04AB7EA5880E65ED",
      "text": "Das kleine Ogerpon ist so süß!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sdc01_0430_gfather_03",
      "hash64": "7CE90E884A5AF7CE",
      "text": "Offenbar hatte ich mir umsonst Sorgen gemacht.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0430_sister_04",
      "hash64": "CBFF50D8D0C27884",
      "text": "Es muss hart für dich gewesen sein, mit all den\\nLeuten zu reden... Saubere Arbeit, Jo![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0430_brother_04",
      "hash64": "B30F47C7D6156008",
      "text": "Ab jetzt musst du dein Gesicht nicht mehr\\nhinter einer Maske verstecken.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0430_brother_05",
      "hash64": "B30F48C7D61561BB",
      "text": "Du kannst jederzeit zu uns ins Dorf kommen![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0430_ogre_04",
      "hash64": "721FB0C1311E0E61",
      "text": "Poooon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "sdc01_0430_caretaker_05",
      "hash64": "9A314F5A446D046D",
      "text": "Die drei Masken, die wir im Kulturzentrum\\naufbewahrt hatten, gehören ja dir, Ogerpon.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0430_caretaker_06",
      "hash64": "9A314C5A446CFF54",
      "text": "Wenn ihr sie mittlerweile den drei Gefährten\\nabgenommen habt, kannst du sie gern behalten.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0430_sister_06",
      "hash64": "CBFF52D8D0C27BEA",
      "text": "Jetzt haben wir nicht nur die Masken\\nzurückgeholt, sondern auch dieses uralte\\r\\nMissverständnis aufgeklärt![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0430_sister_07",
      "hash64": "CBFF53D8D0C27D9D",
      "text": "Diese Mission war echt ein Riesenerfolg![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0430_sister_08",
      "hash64": "CBFF44D8D0C26420",
      "text": "Aber jetzt ist es Zeit, Ogerpon nach Hause\\nzu bringen.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0430_caretaker_07",
      "hash64": "9A314D5A446D0107",
      "text": "Es ist eine Schande, dass wir Ogerpon all die\\nJahre über Unrecht getan haben...\\c\\nVon jetzt an werden wir dafür sorgen, dass nur\\nnoch die wahre Geschichte überliefert wird.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 173,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    }
  ]
}
