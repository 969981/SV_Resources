    {
      "ordinal": 12,
      "label": "kizuna_home_d_mob_01",
      "hash64": "5F8CA5AC90CF3D77",
      "text": "Hallöchen, Señor Saguaro! Oh, was essen Sie\\ndenn da?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_home_d_11",
