    {
      "ordinal": 5,
      "label": "kizuna_home_d_system_01",
      "hash64": "23FEA4E7BABD75E0",
      "text": "Möchtest du Señor Saguaro etwas von dem\\nSüßen Geheimgewürz abgeben?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_home_d_system_02",
      "hash64": "23FEA7E7BABD7AF9",
      "text": "Du besitzt leider kein Süßes Geheimgewürz...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_home_d_06",
      "hash64": "CDB47A6DB9FA27F9",
