          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_language_d_04",
      "hash64": "C7790365D907459C",
      "text": "Nur fürchte ich, dass es Schwierigkeiten haben\\nwird, mit seinen Freunden zu kommunizieren,\\r\\nwenn es keinen Laut von sich gibt.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_language_d_05",
      "hash64": "C7790465D907474F",
      "text": "Wilde Pokémon informieren sich gegenseitig mit\\nihren Rufen über alles Mögliche.\\c\\nWo man Nahrung findet, ob Feinde aufgetaucht\\nsind und so weiter.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_language_d_06",
      "hash64": "C7790565D9074902",
      "text": "Wenn es in die Wildnis zurückkehrt, kann es also\\nmöglicherweise nicht mit seinen Artgenossen\\r\\nkommunizieren.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
