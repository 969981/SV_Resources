      "hash64": "C7790165D9074236",
      "text": "Pamo geht es prächtig![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
