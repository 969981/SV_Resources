      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_language_d_03",
      "hash64": "C7790265D90743E9",
      "text": "Hahaha! Das Kleine ist einfach eher der ruhige\\nTyp.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
