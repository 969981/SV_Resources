          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0150_rival_05",
      "hash64": "7BBADC9943FE0422",
      "text": "Während du dich durch die Liga kämpfst, schau\\nich mir noch mal die Attacken meiner Pokémon\\r\\nan und überleg mir neue Kampfstrategien.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
