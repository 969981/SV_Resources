      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0150_rival_06",
      "hash64": "7BBADB9943FE026F",
      "text": "Also dann, gib dein Bestes, [VAR 0x0100(0000)]!\\nIch werd mich auch anstrengen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
