          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0150_chairman_06",
      "hash64": "C708AAE1401D354A",
      "text": "Es wäre mir eine Freude, wenn du dich der\\nChamp-Prüfung in der Pokémon-Liga stellen\\r\\nwürdest.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
