    },
    {
      "ordinal": 4,
      "label": "champ_0150_rival_03",
      "hash64": "7BBAD69943FDF9F0",
      "text": "Das heißt dann auch, dass...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
