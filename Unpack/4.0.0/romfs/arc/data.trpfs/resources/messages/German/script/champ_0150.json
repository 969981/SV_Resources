    {
      "ordinal": 6,
      "label": "champ_0150_chairman_03",
      "hash64": "C708A7E1401D3031",
      "text": "Du hast nun alle acht Arenaorden beisammen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
