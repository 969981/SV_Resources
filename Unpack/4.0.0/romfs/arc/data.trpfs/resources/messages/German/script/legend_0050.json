      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "legend_0050_select_04",
      "hash64": "CD0CFC4801CC644E",
      "text": "Wie meinst du das?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "legend_0050_friend_15",
      "hash64": "F0558E89AF8221FC",
      "text": "Ich spreche von einer seelischen Wunde...\\nWie heißt das noch gleich? Trauma?\\r\\nDavon hab ich mal in einem Buch gelesen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
