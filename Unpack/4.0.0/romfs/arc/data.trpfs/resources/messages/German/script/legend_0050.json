      ]
    },
    {
      "ordinal": 6,
      "label": "legend_0050_friend_b",
      "hash64": "5DDA3539FD757318",
      "text": "[VAR 0xFF00(0006)]Salziges Geheimgewürz[VAR 0xFF00(0000)] lindert Schmerzen und\\nTaubheit in den Gliedmaßen.\\c\\nAnscheinend hilft es auch gegen den Schwund\\nvon Muskelkraft![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
