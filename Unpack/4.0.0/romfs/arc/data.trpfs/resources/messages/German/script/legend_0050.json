    {
      "ordinal": 8,
      "label": "legend_0050_friend_d",
      "hash64": "5DDA3B39FD757D4A",
      "text": "[VAR 0xFF00(0006)]Saures Geheimgewürz[VAR 0xFF00(0000)] ist vollgepackt mit\\nNährstoffen!\\c\\nEs soll hervorragend gegen Erschöpfung wirken\\nund im Handumdrehen für Erholung sorgen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
