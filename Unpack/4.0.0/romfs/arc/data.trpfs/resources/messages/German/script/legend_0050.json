    {
      "ordinal": 9,
      "label": "legend_0050_friend_e",
      "hash64": "5DDA3C39FD757EFD",
      "text": "[VAR 0xFF00(0006)]Scharfes Geheimgewürz[VAR 0xFF00(0000)] verbessert den\\nStoffwechsel!\\c\\nEs treibt den Kreislauf an, damit man stark\\nschwitzt und so Giftstoffe aus dem Körper\\r\\nschwemmt![VAR 0x0114(0006)]",
