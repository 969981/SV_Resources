        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0120_sister_04",
      "hash64": "204EE3B2E8AAAFAE",
      "text": "Tja, Pech gehabt, würd ich sagen![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0120_sister_05",
      "hash64": "204EE4B2E8AAB161",
      "text": "Wer zu spät kommt, den bestraft das Leben.\\nDann gehst du halt ohne Maske.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
