    {
      "ordinal": 10,
      "label": "sdc01_0120_sister_08",
      "hash64": "204EDFB2E8AAA8E2",
      "text": "Na los, auf Position![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
