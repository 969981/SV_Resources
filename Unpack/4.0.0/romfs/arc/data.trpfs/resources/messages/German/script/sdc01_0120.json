          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0120_sister_03",
      "hash64": "204EE6B2E8AAB4C7",
      "text": "Im Schuppen waren jedenfalls nur zwei Masken.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
