    {
      "ordinal": 6,
      "label": "common_2020_ghost_010_ghost_04",
      "hash64": "2BFC262B68E5FB44",
      "text": "Sagaria schickt also dich als Vertretung...[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
