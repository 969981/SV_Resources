      ]
    },
    {
      "ordinal": 1,
      "label": "common_0170_rival_18",
      "hash64": "3BFA8943B399EB66",
      "text": "Woah! Ist alles in Ordnung mit ihm?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0170_rival_02",
      "hash64": "3BFE1943B39D15ED",
      "text": "Vielleicht ist es erschöpft, weil es seine ganze\\nKraft aufgebraucht hat...?\\c\\nUnd was für ein Pokémon ist das überhaupt?\\nEs sieht ein bisschen wie ein Mopex aus,\\r\\naber so eine Form hab ich noch nie gesehen...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 162,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 211,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0170_rival_03",
      "hash64": "3BFE1843B39D143A",
      "text": "Und dann hat es auch noch plötzlich sein\\nAussehen geändert... Meinst du, es geht ihm gut?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0170_select_01",
      "hash64": "2E344D741B9C5604",
      "text": "Gute Frage...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_0170_select_02",
      "hash64": "2E3450741B9C5B1D",
      "text": "Keine Ahnung.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0170_rival_04",
      "hash64": "3BFE1343B39D0BBB",
      "text": "Du weißt es also auch nicht.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
