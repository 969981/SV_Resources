      "label": "common_0170_rival_stopper",
      "hash64": "A568ECA3B38B5516",
      "text": "Hey! Da geht es doch gar nicht zum Leuchtturm![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
