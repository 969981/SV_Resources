      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "a_sch_shop01_ni05",
      "hash64": "686AA835F8946A34",
      "text": "Ich bin hier, um einen Snack für mich und mein\\nPokémon zu besorgen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
