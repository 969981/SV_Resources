      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "a_sch_shop01_eve08",
      "hash64": "56B8F2C8C1F12130",
      "text": "Das frisch gebackene Brot duftet köstlich!\\nIch kann ihm einfach nicht widerstehen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "a_sch_shop01_eve09",
      "hash64": "56B8F3C8C1F122E3",
      "text": "Magst du Brot? Ich bevorzuge ja Reisbällchen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
