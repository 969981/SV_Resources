    },
    {
      "ordinal": 25,
      "label": "team_0140_fairyboss_02",
      "hash64": "6B377B0DEA0D2680",
      "text": "Big Boss! Jetzt komm schon![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
