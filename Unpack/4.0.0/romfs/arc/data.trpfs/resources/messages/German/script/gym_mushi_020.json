    },
    {
      "ordinal": 27,
      "label": "gym_mushi_020_select_01",
      "hash64": "8B7B0826C1D6E9A3",
      "text": "Ich mach weiter!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "gym_mushi_020_select_02",
      "hash64": "8B7B0926C1D6EB56",
      "text": "Ich gebe auf.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "gym_mushi_020_trainer_19",
      "hash64": "5BE4B32D0541B7D3",
      "text": "Hey, die Abkürzung musst du dir erst verdienen!\\nHier ist Ende Gelände für dich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "gym_mushi_020_trainer_21",
      "hash64": "5BEEAB2D0549FEC0",
      "text": "Du hast meine Olini von deiner Stärke überzeugt.\\nSchau, sie bewegen sich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "gym_mushi_020_trainer_20",
      "hash64": "5BEEAC2D054A0073",
      "text": "Ich hab dich mit einem Kampf von deiner\\nAufgabe abgelenkt, weil ich dir zeigen wollte,\\r\\nwie hart der Olivenanbau ist!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "gym_mushi_020_ui_01",
      "hash64": "0252BBB540E60E61",
      "text": "Aufgeben",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
