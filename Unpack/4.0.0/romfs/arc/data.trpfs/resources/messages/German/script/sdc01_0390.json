          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0390_sister_09",
      "hash64": "CCCBBE1E99C69220",
      "text": "Also dann, holen wir uns die Masken\\ndes Oni zurück![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
