      "label": "sdc01_0390_brother_05",
      "hash64": "DDA116F3F1492D06",
      "text": "Ich hab was zu erledigen...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
