          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0390_sister_08",
      "hash64": "CCCBBF1E99C693D3",
      "text": "Damit wir die Infos über die drei Gefährten nicht\\nvergessen, werd ich sie in deinem Smart-Rotom\\r\\nspeichern, [VAR 0x0100(0000)].[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
