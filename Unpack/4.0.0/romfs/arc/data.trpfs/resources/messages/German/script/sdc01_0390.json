    },
    {
      "ordinal": 17,
      "label": "sdc01_0390_brother_03",
      "hash64": "DDA118F3F149306C",
      "text": "Ich... komm nicht mit.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
