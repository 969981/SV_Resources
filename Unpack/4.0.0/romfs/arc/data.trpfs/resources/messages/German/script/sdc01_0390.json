      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0390_sister_03",
      "hash64": "CCCBC81E99C6A31E",
      "text": "Du zuerst, Jo![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
