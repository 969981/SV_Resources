          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_d_04_dragonbb_02",
      "hash64": "0A40D99D4A89486F",
      "text": "Dich so kampfbereit direkt vor mir zu sehen,\\nist schon krass...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_d_04_dragonbb_03",
      "hash64": "0A40D89D4A8946BC",
      "text": "Bisher war ich bei deinen Kämpfen immer nur\\nZuschauer.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_d_04_dragonbb_04",
      "hash64": "0A40D79D4A894509",
      "text": "Jetzt steh ich dir zum ersten Mal als Gegner\\ngegenüber.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_d_04_dragonbb_05",
      "hash64": "0A40D69D4A894356",
      "text": "Ich weiß, dass du’s in der Blaubeer-Liga\\nunbedingt an die Spitze schaffen musst, [VAR 0x1100(00FF,0403,0000)]BroGirl...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0403",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_d_04_dragonbb_06",
      "hash64": "0A40D59D4A8941A3",
      "text": "Sonst haben wir ein riesiges Problem.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_d_04_dragonbb_07",
      "hash64": "0A40D49D4A893FF0",
      "text": "Aber...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_d_04_dragonbb_08",
      "hash64": "0A40E39D4A89596D",
      "text": "Ich kann dich trotzdem nich’ einfach gewinnen\\nlassen, da hätten wir beide keinen Spaß dran!\\c\\nDeswegen werd ich jetzt so richtig auf die Pauke\\nhauen, hehe![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 156,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_d_04_dragonbb_09",
      "hash64": "0A40E29D4A8957BA",
      "text": "Egal, genug gelabert![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_4kings_d_04_dragonbb_10",
      "hash64": "0A3D559D4A86324C",
      "text": "Sei einfach du selbst und kämpf so, wie du’s\\nimmer tust, [VAR 0x0100(0000)].[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_4kings_d_04_dragonbb_11",
      "hash64": "0A3D569D4A8633FF",
      "text": "Ich werd mich auch nich’ verstellen,\\nverlass dich drauf![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_4kings_d_04_dragonbb_12",
      "hash64": "0A3D579D4A8635B2",
      "text": "Okay... Dann legen wir mal los, [VAR 0x1100(00FF,0403,0000)]BroGirl![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0403",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_4kings_d_04_dragonbb_13",
      "hash64": "0A3D589D4A863765",
      "text": "Lass uns diesen Kampf so richtig genießen![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_4kings_d_04_dragonbb_14",
      "hash64": "0A3D519D4A862B80",
      "text": "Hehehe! Das hat übelst viel Spaß gemacht,\\noder?![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_4kings_d_04_dragonbb_15",
      "hash64": "0A3D529D4A862D33",
      "text": "Du kannst dir gar nich’ vorstellen, wie froh ich\\nbin, dass ich dich in die Liga-AG eingeladen hab![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_4kings_d_04_dragonbb_16",
      "hash64": "0A3D539D4A862EE6",
      "text": "Jetz’, wo du gegen mich gewonnen hast, müssen\\nwir dich auch offiziell in die AG aufnehmen!\\r\\nNa, was sagst du dazu?![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_4kings_d_04_dragonbb_17",
      "hash64": "0A3D549D4A863099",
      "text": "Hehehe! Gute Antwort![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_4kings_d_04_dragonbb_18",
      "hash64": "0A3D5D9D4A863FE4",
      "text": "Ach komm, jetz’ tu nich’ so! In Wahrheit geht\\ndamit für dich doch auch ein Traum in Erfüllung![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_4kings_d_04_dragonbb_19",
      "hash64": "0A3D5E9D4A864197",
      "text": "Lass uns gleich ein Foto machen, das du für deine\\nAnmeldung benutzen kannst.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_4kings_d_04_dragonbb_20",
      "hash64": "0A47E79D4A8F7EE7",
      "text": "Ich musste mich ein bisschen zusammenreißen,\\nsonst wird Tara wieder stinkig. Sie nimmt das mit\\r\\nden Fotos ziemlich ernst, weißte.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_4kings_d_04_dragonbb_21",
      "hash64": "0A47E69D4A8F7D34",
      "text": "Öhm... Da war doch noch was...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_4kings_d_04_dragonbb_22",
      "hash64": "0A47E99D4A8F824D",
      "text": "Ach ja! Du kriegst noch ’ne TM von mir, weil du\\nein Top-Vier-Mitglied besiegt hast und so...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_4kings_d_04_dragonbb_23",
      "hash64": "0A47E89D4A8F809A",
      "text": "Hab total vergessen, eine einzupacken.\\nMomentchen, bin gleich wieder da![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_4kings_d_04_clerk_npc",
      "hash64": "FE43F66BFAD1E3D8",
      "text": "Glückwunsch zu deinem Sieg über Levy von den\\nTop Vier!",
      "flags": 0,
      "text_status": "DECODED",
