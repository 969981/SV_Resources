    {
      "ordinal": 0,
      "label": "sdc02_4kings_d_04_dragonbb_01",
      "hash64": "0A40DA9D4A894A22",
      "text": "Mal sehen... Ja, hier gefällt’s mir.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
