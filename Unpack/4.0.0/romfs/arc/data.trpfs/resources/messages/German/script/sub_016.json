  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_016_system_kui_01",
      "hash64": "4C38F1CE9AE28A93",
      "text": "Hier steckt ein unheilvoll anmutender schwarzer\\nPfahl im Boden...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_016_system_kui_02",
      "hash64": "4C38F2CE9AE28C46",
      "text": "Möchtest du ihn herausziehen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_016_system_kui_03",
      "hash64": "4C38F3CE9AE28DF9",
      "text": "Als du den Pfahl aus dem Boden ziehst,\\nzerfällt er und löst sich in Luft auf!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_016_system_kui_04",
      "hash64": "4C38F4CE9AE28FAC",
      "text": "Chooo...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_016_system_kui_05",
      "hash64": "4C38F5CE9AE2915F",
      "text": "Aus Richtung des Schreins ertönt ein seltsamer\\nRuf...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_016_system_release_01",
      "hash64": "0D38A4AA29FEC449",
      "text": "Leise Geräusche dringen aus dem Inneren des\\nSchreins hervor...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_016_system_release_02",
      "hash64": "0D38A1AA29FEBF30",
      "text": "Möchtest du den Schrein berühren?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_016_system_release_03",
      "hash64": "0D38A2AA29FEC0E3",
      "text": "*ratter* *ratter*\\n*rumpel* *rumpel*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_016_system_release_07",
      "hash64": "0D38A6AA29FEC7AF",
      "text": "*RUMMS*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_016_system_release_04",
      "hash64": "0D38A7AA29FEC962",
      "text": "Chochong!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_016_system_release_05",
      "hash64": "0D38A8AA29FECB15",
      "text": "Chongjian wurde erneut im Schrein versiegelt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_016_system_release_06",
      "hash64": "0D38A5AA29FEC5FC",
      "text": "Offenbar wird es etwas dauern, bis sich das Tor\\ndes Schreins wieder öffnet.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_016_system_hokora_01",
      "hash64": "5E2F0FED1EB3D91C",
      "text": "Auf dem Schrein ist etwas kaum Leserliches\\neingraviert...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_016_system_hokora_02",
      "hash64": "5E2F12ED1EB3DE35",
      "text": "AN DIESEM ORT WURDEN DIE UNHEILSTAFELN\\nVERSIEGELT.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_016_system_hokora_03",
      "hash64": "5E2F11ED1EB3DC82",
      "text": "DAS SIEGEL DER UNHEILSTAFELN WURDE\\nGEBROCHEN.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
