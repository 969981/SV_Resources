  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_side01_030_brother_01",
      "hash64": "2C5EE0F8ACDFF912",
      "text": "Das hier ist die Paradiesebene.\\nZiemlich trostlos, was?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_side01_030_brother_02",
      "hash64": "2C5EDFF8ACDFF75F",
      "text": "Der Überlieferung zufolge wurde der Oni hier\\nwohl häufiger gesehen...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_side01_030_brother_03",
      "hash64": "2C5EDEF8ACDFF5AC",
      "text": "Aber sag mal... W-Was hältst du von einem\\nKampf, bevor wir uns um die Infotafel kümmern?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_side01_030_select_01",
      "hash64": "08A96501DBB565C0",
      "text": "Klar doch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_side01_030_select_02",
      "hash64": "08A96801DBB56AD9",
      "text": "Hm, weiß nicht so recht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc01_side01_030_brother_04",
      "hash64": "2C5EDDF8ACDFF3F9",
      "text": "Dann mach ich erst mal dein[VAR 0x1101(00FD,0100)]e Pokémon\\nwieder fit.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_side01_030_brother_05",
      "hash64": "2C5EDCF8ACDFF246",
      "text": "Bitte... Ich mach auch vorher dein[VAR 0x1101(00FD,0100)]e Pokémon\\nwieder fit.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_side01_030_brother_06",
      "hash64": "2C5EDBF8ACDFF093",
      "text": "Dieses Mal... gewinne ich![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_side01_030_brother_07",
      "hash64": "2C5EDAF8ACDFEEE0",
      "text": "Verloren...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_side01_030_brother_08",
      "hash64": "2C5EE9F8ACE0085D",
      "text": "Ich bin zu schwach...\\nKein Wunder, dass...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_side01_030_brother_09",
      "hash64": "2C5EE8F8ACE006AA",
      "text": "Egal... Auf zur Infotafel. Bringen wir die Aufgabe\\nendlich hinter uns.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_side01_030_system_01",
      "hash64": "E9094D2B1A6E9F13",
      "text": "Nähert sich dir zur Dämmerstunde außerhalb des\\nDorfes eine Schattengestalt, so sei auf der Hut.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sdc01_side01_030_system_02",
      "hash64": "E9094E2B1A6EA0C6",
      "text": "Setze auf der Stelle eine Maske auf, um dein\\nAntlitz zu verbergen, und verneige dich.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc01_side01_030_system_03",
      "hash64": "E9094F2B1A6EA279",
      "text": "Ob Mensch oder Oni, er wird nur die Maske\\nsehen und dich deines Weges gehen lassen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc01_side01_030_system_04",
      "hash64": "E909502B1A6EA42C",
      "text": "Solltest du keine Maske zur Hand haben,\\nso hoffe, dass der Schatten sich als Mensch\\r\\nerweist.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_side01_030_system_05",
      "hash64": "E909512B1A6EA5DF",
      "text": "In diesem Fall darfst du den Sonnenaufgang\\nerneut erleben und wirst nie mehr deine Maske\\r\\nvergessen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_side01_030_system_06",
      "hash64": "E909522B1A6EA792",
      "text": "Entpuppt sich der Schatten jedoch als Oni,\\nhat fürwahr dein letztes Stündlein geschlagen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc01_side01_030_system_07",
      "hash64": "E909532B1A6EA945",
      "text": "Der Oni raubt jedem die Seele, dessen Gesicht\\ner erblickt. Du wirst nie ins Dorf zurückkehren.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sdc01_side01_030_brother_18",
      "hash64": "2C5B63F8ACDCEED4",
      "text": "Früher hatten die Leute immer eine Maske dabei.\\nJetzt rate mal, wer die alle hergestellt hat?\\c\\nNiemand anderes als der Urururopa von meinem\\nOpa... oder so ähnlich.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 165,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_side01_030_brother_19",
      "hash64": "2C5B64F8ACDCF087",
      "text": "Das ist ja toll!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc01_side01_030_brother_20",
      "hash64": "2C656DF8ACE55457",
      "text": "Die Geschichte ist also wahr?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sdc01_side01_030_brother_21",
      "hash64": "2C656CF8ACE552A4",
      "text": "Dass der Oni den Menschen die Seele geraubt\\nhaben soll, halte ich für eine Lüge.\\c\\nAber der Teil mit den Masken und dass meine\\nFamilie sie angefertigt hat, stimmt wirklich.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 173,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_side01_030_brother_22",
      "hash64": "2C656FF8ACE557BD",
      "text": "Wir stellen seit vielen Generationen Masken her.\\nMein Opa ist zum Beispiel auch Maskenschnitzer.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_side01_030_brother_23",
      "hash64": "2C656EF8ACE5560A",
      "text": "Sogar das Maskenfest sollen sich unsere\\nVorfahren ausgedacht haben.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_side01_030_brother_10",
      "hash64": "2C5B5BF8ACDCE13C",
      "text": "Aber mir gefällt nicht, was hier auf der Tafel\\nsteht...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_side01_030_brother_24",
      "hash64": "2C6569F8ACE54D8B",
      "text": "Sie hatten Angst vor dem Oni, okay, aber...\\nWarum mussten sie gleich so überreagieren\\r\\nund ihn aus dem Dorf vertreiben...?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_side01_030_brother_11",
      "hash64": "2C5B5CF8ACDCE2EF",
      "text": "Der arme Oni muss sich bestimmt total einsam\\ngefühlt haben...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_side01_030_brother_25",
      "hash64": "2C6568F8ACE54BD8",
      "text": "Wie kann man andere nur so behandeln...\\nund ausschließen...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_side01_030_select_05",
      "hash64": "08A96901DBB56C8C",
      "text": "Das ist echt schlimm.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "sdc01_side01_030_select_06",
      "hash64": "08A96C01DBB571A5",
      "text": "Tut mir leid...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "sdc01_side01_030_brother_12",
      "hash64": "2C5B5DF8ACDCE4A2",
      "text": "Du siehst das also auch so, ja?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_side01_030_brother_13",
      "hash64": "2C5B5EF8ACDCE655",
      "text": "Was tut dir leid...?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_side01_030_brother_14",
      "hash64": "2C5B57F8ACDCDA70",
      "text": "Lass uns schnell noch ein Foto machen.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_side01_030_brother_15",
      "hash64": "2C5B58F8ACDCDC23",
      "text": "Damit wär unsere Aufgabe abgeschlossen.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_side01_030_brother_16",
      "hash64": "2C5B59F8ACDCDDD6",
      "text": "Meine Pokémon und ich müssen noch viel\\nstärker werden...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc01_side01_030_brother_17",
      "hash64": "2C5B5AF8ACDCDF89",
      "text": "Ich... geh dann mal nach Hause.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
