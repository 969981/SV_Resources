        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_kusa_010_kusa_04",
      "hash64": "5570C2F19675A016",
      "text": "Das einzig Wichtige ist die Kunst!\\c\\nSeit unserem letzten künstlerischen Wettstreit\\nhab ich mir oft gedacht, dass wir das unbedingt\\r\\nmal wiederholen müssen.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
