          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 159,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_kusa_010_kusa_05",
      "hash64": "5570C3F19675A1C9",
      "text": "Tausend Küsse an Mutter Natur, dass sie deine\\nSchritte ein weiteres Mal zu mir gelenkt hat![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_kusa_010_kusa_06",
      "hash64": "5570C0F196759CB0",
      "text": "Eigentlich war für heute noch ein Treffen mit dem\\nTop-Champ angesetzt, doch das streiche ich ganz\\r\\nflink aus meinem Terminkalender. Weg damit!\\c\\nLass uns stattdessen doch lieber über Kunst\\nphilosophieren![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
