    {
      "ordinal": 3,
      "label": "common_2020_kusa_010_select_02",
      "hash64": "E2009DCCCBA17AB8",
      "text": "Also, eigentlich bin ich Champ...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_kusa_010_kusa_03",
      "hash64": "5570C5F19675A52F",
      "text": "Pfff. Na, dann eben nicht!\\nIst ja auch völlig unwichtig.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
