    {
      "ordinal": 34,
      "label": "gym_normal_030_shop_00",
      "hash64": "04CA2005066AAA90",
      "text": "Du bist wegen der Arenaprüfung hier, stimmt’s?\\nNa, hast du alle Hinweise für das geheime\\r\\nGericht der Schatzstube beisammen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_normal_030_shop_01",
      "hash64": "04CA2105066AAC43",
      "text": "Alles klar! Was darf es also sein?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
