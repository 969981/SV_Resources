    },
    {
      "ordinal": 2,
      "label": "champ_0115_select_01",
      "hash64": "B2E6D23719592565",
      "text": "Alles tipptopp!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "champ_0115_select_02",
      "hash64": "B2E6CF371959204C",
      "text": "Ich weiß nicht recht.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "champ_0115_ecology_03a",
      "hash64": "DE054D390646C078",
      "text": "Oooh, so was hört man gern. Du hast dein Ziel\\nvoll im Blick, was?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
