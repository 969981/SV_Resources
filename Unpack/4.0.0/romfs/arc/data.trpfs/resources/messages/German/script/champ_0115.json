          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0115_ecology_03b",
      "hash64": "DE0550390646C591",
      "text": "Hehe... Ja, Direktor Clavels Aufgaben haben es\\nganz schön in sich.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0115_ecology_04",
      "hash64": "87159A642D54537C",
      "text": "Viele Schüler nehmen im Rahmen ihrer\\nSchatzsuche die Arenen in Angriff.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0115_ecology_05",
      "hash64": "87159B642D54552F",
      "text": "Das ist zwar nicht leicht, aber es lohnt sich.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0115_ecology_06",
      "hash64": "87159C642D5456E2",
      "text": "Deswegen bin ich auch hier – um dich anzufeuern!\\nImmerhin bin ich dein Klassenlehrer.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0115_ecology_07",
      "hash64": "87159D642D545895",
      "text": "Das hier sollte dir bei deiner Schatzsuche\\nbehilflich sein.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0115_ecology_08",
      "hash64": "87159E642D545A48",
      "text": "Als Entwickler des Pokédex würde es mich\\nnatürlich auch freuen, wenn du bei dessen\\r\\nVervollständigung weiterhin dein Bestes gibst![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
