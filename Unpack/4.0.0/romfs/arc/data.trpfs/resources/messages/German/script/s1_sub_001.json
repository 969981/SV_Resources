      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_001_select_02",
      "hash64": "1D7146A7871682F4",
      "text": "Was machen Sie denn hier?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_001_ecology_02",
      "hash64": "45295B139DA136BE",
      "text": "Hehe, ich bin natürlich hergekommen, um zu\\nsehen, wie du dich so machst!\\c\\nSchließlich bin ich dein Klassenlehrer.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
