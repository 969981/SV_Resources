          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_001_ecology_03",
      "hash64": "45295C139DA13871",
      "text": "Und wo ich schon mal hier bin, konnte ich es mir\\nnicht nehmen lassen, die Pokémon von Kitakami\\r\\nzu erforschen und...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_001_ecology_04",
      "hash64": "45295D139DA13A24",
      "text": "Moment... Oh nein, ich Schussel![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_001_ecology_05",
      "hash64": "45295E139DA13BD7",
      "text": "Ich war so in meine Forschung vertieft, dass ich\\nbisher ganz vergessen habe, nach dir zu sehen...\\r\\nTut mir leid, ehrlich![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_001_ecology_06",
      "hash64": "45295F139DA13D8A",
      "text": "Was hältst du von einem kleinen Picknick\\nals Entschuldigung?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_001_ecology_07",
      "hash64": "452960139DA13F3D",
      "text": "Gut, dass ich mir einen Tisch von Direktor Clavel\\nausgeliehen habe. Es lohnt sich, auf seine eigene\\r\\nVergesslichkeit vorbereitet zu sein...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_001_ecology_08",
      "hash64": "452951139DA125C0",
      "text": "Keine falsche Bescheidenheit, das Sandwich ist\\nfür dich! Hau rein![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_001_ecology_09",
      "hash64": "452952139DA12773",
      "text": "Es sieht vielleicht ein biiisschen komisch aus,\\naber dafür schmeckt es umso besser. Garantiert![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_001_ecology_10",
      "hash64": "452CDF139DA44CE1",
      "text": "Normalerweise komme ich nicht so oft raus,\\ndeshalb macht mich all die Forschungsarbeit\\r\\nhier draußen ganz schön fertig...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_001_ecology_11",
      "hash64": "452CDE139DA44B2E",
      "text": "Und du umrundest für deine Schatzsuche gefühlt\\ndie halbe Welt... Respekt, echt![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_001_ecology_12",
      "hash64": "452CDD139DA4497B",
      "text": "Aber nanu? Was liegt denn da im Korb...?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_001_ecology_13",
      "hash64": "452CDC139DA447C8",
      "text": "Tadaaa![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_001_ecology_14",
      "hash64": "452CE3139DA453AD",
      "text": "Oooh! Aaah! Ein Pokémon-Ei!![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_sub_001_ecology_15",
      "hash64": "452CE2139DA451FA",
      "text": "Na, so was! Dabei ist doch nur Schluppuck hier.\\nWie ist das möglich?![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_sub_001_select_03",
      "hash64": "1D7147A7871684A7",
      "text": "Ja, wie nur...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s1_sub_001_select_04",
      "hash64": "1D7144A787167F8E",
      "text": "Haben Sie das reingetan?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "s1_sub_001_ecology_16",
      "hash64": "452CE1139DA45047",
      "text": "Hehe... Na gut, die Wahrheit ist, dass ich das Ei\\ndort versteckt habe.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_001_ecology_17",
      "hash64": "452CE0139DA44E94",
      "text": "Hehe... Dir kann man echt nichts vormachen![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_001_ecology_18",
      "hash64": "452CD7139DA43F49",
      "text": "Bestimmt hast du schon mal ein Pokémon-Ei\\nbei einem Picknick gefunden, oder?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_sub_001_ecology_19",
      "hash64": "452CD6139DA43D96",
      "text": "Wenn Trainer sich um solch ein Ei nicht kümmern\\nkönnen, übergeben sie es normalerweise in die\\r\\nObhut der Akademie.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_sub_001_ecology_20",
      "hash64": "453065139DA7666A",
      "text": "Aber ich dachte mir, es kann nicht schaden,\\nwenn sich stattdessen hier und da unsere\\r\\ntalentierten Schüler dieser Eier annehmen.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_001_ecology_21",
      "hash64": "453066139DA7681D",
      "text": "In diesem Sinne...\\nBitte schön, [VAR 0x0100(0000)]![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_sub_001_system_01",
      "hash64": "4CE7DECB5A676AEA",
      "text": "Du erhältst ein Pokémon-Ei!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "s1_sub_001_ecology_22",
      "hash64": "453063139DA76304",
      "text": "Hehe... Möglicherweise war es ein wenig\\nübertrieben, extra deshalb nach Kitakami zu\\r\\nkommen, aber...\\c\\nBei dir habe ich immerhin das Gefühl,\\ndass das Ei in guten Händen ist.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 176,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_sub_001_ecology_23",
      "hash64": "453064139DA764B7",
      "text": "Übrigens... Benutzt du hier auch die\\nPokédex-App?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s1_sub_001_ecology_24",
      "hash64": "453061139DA75F9E",
      "text": "Wenn du Pokémon der Kitakami-Provinz fängst,\\nfüllt sich dadurch dein Kitakami-Pokédex.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s1_sub_001_ecology_25",
      "hash64": "453062139DA76151",
      "text": "Ich werde noch eine Weile in der Umgebung\\nmit meiner Forschungsarbeit beschäftigt sein...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "s1_sub_001_ecology_26",
      "hash64": "45305F139DA75C38",
      "text": "Also komm unbedingt wieder zu mir, falls du den\\nKitakami-Pokédex vervollständigst![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
