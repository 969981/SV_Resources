    },
    {
      "ordinal": 2,
      "label": "gym_kusa_020_receptionist_03",
      "hash64": "01E16963DBE1936E",
      "text": "Das sind Pokémon, die wie sonnenförmige\\nBlumen aussehen. Sie werden sich überall\\r\\nin Bolardin verstecken.\\c\\nUm die Arenaprüfung zu bestehen, musst du\\n[VAR 0x0201(0001)] Sonnflora einsammeln und sie zum\\r\\nSonnflora-Plaza bringen!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 153,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
