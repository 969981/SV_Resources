          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_kusa_020_receptionist_04",
      "hash64": "01E16C63DBE19887",
      "text": "Du hast [VAR 0x0200(0001)] Sonnflora eingesammelt, es fehl[VAR 0x1101(0002,0201)]ten also\\nnoch [VAR 0x0201(0002)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0002",
            "0201"
          ]
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_kusa_020_receptionist_05",
      "hash64": "01E16B63DBE196D4",
      "text": "Man kann sie an unerwarteten Stellen finden, zum\\nBeispiel an hohen Orten oder hinter Gebäuden.\\c\\nSchau dir also alles am besten aus mehreren\\nBlickwinkeln an!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_kusa_020_receptionist_09",
      "hash64": "01E15F63DBE18270",
      "text": "Bitte sammle zehn Sonnflora ein und bring sie\\ndann zum Sonnflora-Plaza!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
