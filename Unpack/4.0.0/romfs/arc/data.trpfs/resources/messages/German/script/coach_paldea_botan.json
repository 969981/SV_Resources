          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_paldea_botan_sp02_02",
      "hash64": "3C250F1F2F97450D",
      "text": "Auf einer der tieferen Ebenen befindet sich\\nwohl eine Anlage, die der Entwicklung von\\r\\nRessourcen dient.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
