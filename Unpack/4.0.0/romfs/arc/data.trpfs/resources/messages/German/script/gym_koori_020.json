  "entries": [
    {
      "ordinal": 0,
      "label": "gym_koori_020_receptionist_01",
      "hash64": "370501FDAA453FEC",
      "text": "Willkommen in der Montanata-Arena!\\c\\nMöchtest du die Erklärung zur Arenaprüfung\\nnoch einmal hören?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_koori_020_receptionist_02",
      "hash64": "370504FDAA454505",
      "text": "Deine Aufgabe wird es sein, am [VAR 0xFF00(0006)]Schneeberg-[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]Slalom[VAR 0xFF00(0000)] teilzunehmen.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_koori_020_receptionist_03",
      "hash64": "370503FDAA454352",
      "text": "Du musst auf deinem Reit-Pokémon die Piste\\nhinunterschlittern und dabei das Ziel innerhalb\\r\\ndes Zeitlimits erreichen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_koori_020_receptionist_04",
      "hash64": "3704FEFDAA453AD3",
      "text": "Die genauen Regeln werden dir am Startpunkt\\nder Strecke neben der Arena erklärt. Geh einfach\\r\\nnach draußen und folge dem Aufgang links!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
