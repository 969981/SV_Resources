      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0370_sister_03",
      "hash64": "9CDE97ED10BF99F4",
      "text": "Na gut, dann wartet Ogerpon eben hier auf uns.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
