    {
      "ordinal": 2,
      "label": "sdc01_0370_brother_01",
      "hash64": "D776693279C11D54",
      "text": "Bestimmt möchte es nicht ins Dorf.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
