    },
    {
      "ordinal": 4,
      "label": "sdc01_0370_sister_02",
      "hash64": "9CDE98ED10BF9BA7",
      "text": "Stimmt, da hast du recht...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
