          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_side02_0000_camera_04",
      "hash64": "EFBD25B47EB49D5B",
      "text": "Du bist Teil dieser Schülergruppe, die für die\\nExkursion aus Paldea gekommen ist![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_side02_0000_select_01",
      "hash64": "C406F9299D65C0D5",
      "text": "Das stimmt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0000_select_02",
      "hash64": "C406F6299D65BBBC",
      "text": "Woher wussten Sie das?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s1_side02_0000_camera_05",
      "hash64": "EFBD24B47EB49BA8",
      "text": "Hihihi! Das hier ist ein kleines Dorf.\\nDa kommt einem so einiges zu Ohren.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_side02_0000_camera_06",
      "hash64": "EFBD27B47EB4A0C1",
      "text": "Ich bin Gemma, eine Reisende mit einem kleinen\\nFaible für Kameras.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_side02_0000_camera_07",
      "hash64": "EFBD26B47EB49F0E",
      "text": "Und das ist mein Partner Fukano. Schau dir nur\\nmal das süße Horn auf seinem Kopf an![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_side02_0000_dog_01",
      "hash64": "89D356223DEC9CE1",
      "text": "Kanooo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s1_side02_0000_camera_08",
      "hash64": "EFBD21B47EB4968F",
      "text": "Das kommt jetzt etwas plötzlich, aber darf ich\\nein Foto von dir machen?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_side02_0000_camera_09",
      "hash64": "EFBD20B47EB494DC",
      "text": "Hey, [VAR 0x1100(00FF,0607,0000)]KleinerKleine... Die Zustimmung kam mir aber\\netwas zu schnell.\\c\\nMan darf Fremden nicht so leicht vertrauen![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0607",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
