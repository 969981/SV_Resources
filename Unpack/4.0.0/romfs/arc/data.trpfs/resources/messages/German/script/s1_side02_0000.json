      ]
    },
    {
      "ordinal": 2,
      "label": "s1_side02_0000_camera_03",
      "hash64": "EFBD2AB47EB4A5DA",
      "text": "Und du bist...? Moment, lass mich raten![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
