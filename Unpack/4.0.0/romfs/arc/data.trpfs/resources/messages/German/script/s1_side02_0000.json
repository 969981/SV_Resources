        {
          "kind": "control",
          "offset_units": 161,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_0000_camera_15",
      "hash64": "EFB9A8B47EB1931D",
      "text": "Hast du nicht was zu erledigen, [VAR 0x1100(00FF,0607,0000)]KleinerKleine?\\c\\n150 Pokémon aus dem Kitakami-Pokédex fangen\\noder so?\\c\\nKomm wieder, wenn du damit fertig bist.\\c\\nZeit ist ein wertvolles Gut! Oder wie man heute\\nsagt: Zeit ist Geld![VAR 0x0114(0046)]",
      "flags": 0,
