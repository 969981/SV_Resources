    {
      "ordinal": 1,
      "label": "s1_side02_0000_camera_02",
      "hash64": "EFBD2BB47EB4A78D",
      "text": "Oh! Ich hab dich gar nicht bemerkt.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
