      "label": "sdc02_4kings_a_01_system_01",
      "hash64": "62E99FF70BADB89A",
      "text": "Du überträgst 50 BP!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_01_clerk_05",
      "hash64": "D29BDC253506E894",
      "text": "Vielen Dank! Hiermit bestätige ich deine\\nTeilnahme an der Top-Vier-Challenge.",
