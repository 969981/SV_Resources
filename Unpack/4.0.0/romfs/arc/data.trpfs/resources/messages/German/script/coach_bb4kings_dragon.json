          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_bb4kings_dragon_sp01_02",
      "hash64": "0DC135C9AC11AD00",
      "text": "Seit du Champ geworden bist, is’ keine Spur\\nmehr von diesen ätzenden Vibes in der AG.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb4kings_dragon_sp01_03",
      "hash64": "0DC136C9AC11AEB3",
      "text": "Du kennst mich, mir wär’s am liebsten gewesen,\\ndas Kriegsbeil mit Jo zu begraben...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_bb4kings_dragon_sp01_04",
      "hash64": "0DC13BC9AC11B732",
      "text": "Aber es läuft eben nich’ immer so, wie man’s\\nsich wünscht.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_bb4kings_dragon_sp01_select_01",
      "hash64": "AF30C322A3B69568",
      "text": "Das wird schon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_bb4kings_dragon_sp01_select_02",
      "hash64": "AF30C622A3B69A81",
      "text": "Irgendwann bestimmt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_bb4kings_dragon_sp01_05",
      "hash64": "0DC13CC9AC11B8E5",
      "text": "Da sagst du was! Würd auch nichts anderes von\\ndir erwarten, machst dich echt super als Champ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb4kings_dragon_sp01_06",
      "hash64": "0DC139C9AC11B3CC",
      "text": "Aber... ich fühl mich ein bisschen schlecht, [VAR 0x1100(00FF,0403,0000)]BroGirl.\\nAm Ende sah’s nämlich so aus, als hätt ich dich\\r\\nwegen dieser Sache mit der Liga-AG ausgenutzt.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0403",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 157,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb4kings_dragon_sp01_07",
      "hash64": "0DC13AC9AC11B57F",
      "text": "Das hatte ich aber nie vor, ich schwör’s![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb4kings_dragon_sp01_08",
      "hash64": "0DC13FC9AC11BDFE",
      "text": "Trotzdem will ich mich dafür noch mal bei dir\\nentschuldigen, das war echt nich’ cool von mir.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb4kings_dragon_sp02_00",
      "hash64": "B48C79B064C08D59",
      "text": "Yo, [VAR 0x0100(0000)]![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
