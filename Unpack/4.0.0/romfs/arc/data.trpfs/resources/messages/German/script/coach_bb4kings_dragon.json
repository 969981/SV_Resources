          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb4kings_dragon_sp02_01",
      "hash64": "B48C78B064C08BA6",
      "text": "Wie geht’s [VAR 0x1100(00FF,0C0A,0000)]dem Leiterder Leiterin unserer AG heut so?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0C0A",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
