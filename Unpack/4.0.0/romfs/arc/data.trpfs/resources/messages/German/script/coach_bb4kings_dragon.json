          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_dragon_sp03_03",
      "hash64": "E24686B6C79C3CA1",
      "text": "Ihr is’ leider nich’ entgangen, dass ich mich bisher\\nganz geschickt um jegliche Arbeit gedrückt hab.\\r\\nZum Dank hab ich jetz’ umso mehr zu tun...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
