          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb4kings_dragon_sp02_select_01",
      "hash64": "6F8FF36E35FFF045",
      "text": "[VAR 0x1100(00FF,0806,0000)]LeiterLeiterin?!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
