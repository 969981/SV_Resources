  "entries": [
    {
      "ordinal": 0,
      "label": "s1_side02_0060_camera_boxfull",
      "hash64": "1C4DAAE9C41D0D4B",
      "text": "Du hast ja gar keinen Platz für weitere Pokémon!\\nWeder in deinem Team noch in deinen Boxen.\\c\\nAlso, ich will jetzt nicht sagen, warum, aber schaff\\ndoch mal etwas Platz und komm dann wieder, ja?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
