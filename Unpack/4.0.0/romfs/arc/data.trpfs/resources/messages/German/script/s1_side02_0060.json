          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_side02_0060_camera_01",
      "hash64": "443526A6423B3A9A",
      "text": "Da bist du ja, Partner![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_side02_0060_camera_02",
      "hash64": "443525A6423B38E7",
      "text": "Ich hab’s geschafft, die Fotos von Blutmond\\nzu entwickeln![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_side02_0060_select_01",
      "hash64": "75749C56FDB0EFAB",
      "text": "Ich will sie sehen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_side02_0060_select_02",
      "hash64": "75749D56FDB0F15E",
      "text": "Wie sind sie geworden?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0060_camera_03",
      "hash64": "443524A6423B3734",
      "text": "Na ja... Auf den Bildern ist Blutmond entweder\\nverschwommen oder abgeschnitten...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_side02_0060_camera_04",
      "hash64": "443523A6423B3581",
      "text": "Leider ist keins davon so richtig vorzeigbar.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_side02_0060_camera_05",
      "hash64": "443522A6423B33CE",
      "text": "Aber weißt du was?\\c\\nVon allen Bildern, die ich bisher gemacht habe,\\nsind das meine absoluten Lieblingsfotos![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_side02_0060_camera_06",
      "hash64": "443521A6423B321B",
      "text": "Ich glaube, ich habe mir immer viel zu viele\\nGedanken gemacht.\\c\\nÜber den theoretischen Aspekt des\\nFotografierens...\\c\\nDarüber, wie die Fotos bei den Preisrichtern\\nankommen...\\c\\nDarüber, was ich fotografieren will...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 177,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 219,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_side02_0060_camera_07",
      "hash64": "443520A6423B3068",
      "text": "Dabei reicht es für ein Foto schon, einfach\\ndie Kamera auf ein Motiv zu richten und\\r\\nden Auslöser zu drücken.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_side02_0060_camera_08",
      "hash64": "44351FA6423B2EB5",
      "text": "Das habe ich durch dich gelernt.\\nDanke, Partner.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_side02_0060_camera_09",
      "hash64": "44351EA6423B2D02",
      "text": "Moment, da fällt mir ein... Ich hab dich nie nach\\ndeinem Namen gefragt![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_side02_0060_camera_10",
      "hash64": "4431A1A6423822C4",
      "text": "Tut mir leid! Das kommt zwar ziemlich spät,\\naber... Wie heißt du eigentlich?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_side02_0060_select_03",
      "hash64": "75749E56FDB0F311",
      "text": "Ich heiße [VAR 0x0100(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_side02_0060_select_04",
      "hash64": "75749F56FDB0F4C4",
      "text": "[VAR 0x0100(0000)]...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_side02_0060_camera_11",
      "hash64": "4431A2A642382477",
      "text": "[VAR 0x0100(0000)]! Der Name passt zu dir![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_side02_0060_camera_12",
      "hash64": "4431A3A64238262A",
      "text": "[VAR 0x0100(0000)] also! Nanu, was ist mit dir?\\nIst es dir etwa peinlich, dich vorzustellen?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_0060_camera_13",
      "hash64": "4431A4A6423827DD",
      "text": "Dann stell ich mich auch noch mal vor.\\nIch bin Gemma...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_side02_0060_camera_14",
      "hash64": "44319DA642381BF8",
      "text": "Eine Fotografin mit einem riesigen Faible für\\nKameras![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_side02_0060_camera_15",
      "hash64": "44319EA642381DAB",
      "text": "Ab jetzt werde ich immer voller Stolz sagen,\\nwas mir gefällt.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_side02_0060_camera_16",
      "hash64": "44319FA642381F5E",
      "text": "Ach ja, fast hätte ich die Belohnung für dich\\nvergessen![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_side02_0060_camera_17",
      "hash64": "4431A0A642382111",
      "text": "Du hast mich so toll unterstützt... Da hast du dir\\ndas hier redlich verdient.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_side02_0060_camera_18",
      "hash64": "443199A64238152C",
      "text": "Und das ist noch nicht alles...\\c\\nMein Fukano hat nämlich einen kleinen Bruder,\\nder völlig versessen aufs Kämpfen ist.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_side02_0060_camera_19",
      "hash64": "44319AA6423816DF",
      "text": "Ich denke, bei dir wäre er besser aufgehoben\\nals bei mir.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_side02_0060_system_01",
      "hash64": "FB7A90977AC48E50",
      "text": "Du erhältst ein Fukano von Gemma!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "s1_side02_0060_camera_20",
      "hash64": "443B93A642405F7F",
      "text": "Trainiere den kleinen Racker, damit er ordentlich\\nstark wird, okay?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_side02_0060_camera_21",
      "hash64": "443B92A642405DCC",
      "text": "Tja, damit hätte ich mein Ziel erreicht.\\nDann sollte ich wohl langsam weiterziehen.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_side02_0060_camera_22",
      "hash64": "443B95A6424062E5",
      "text": "Es ist etwas traurig, doch hier trennen sich\\nunsere Wege.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_side02_0060_camera_23",
      "hash64": "443B94A642406132",
      "text": "Aber weißt du was? Das Band zwischen zwei\\nFukano ist unverwüstlich.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s1_side02_0060_camera_24",
      "hash64": "443B8FA6424058B3",
      "text": "Auch wenn sie getrennt voneinander trainiert\\nwerden, führt das Schicksal sie irgendwann\\r\\nbestimmt wieder zusammen![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s1_side02_0060_select_05",
      "hash64": "7574A056FDB0F677",
      "text": "Ja, wir sehen uns sicher wieder!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "s1_side02_0060_select_06",
      "hash64": "7574A156FDB0F82A",
      "text": "Ich werde Fukano gut trainieren!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "s1_side02_0060_camera_25",
      "hash64": "443B8EA642405700",
      "text": "Hehe, ich freu mich schon drauf![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s1_side02_0060_camera_26",
      "hash64": "443B91A642405C19",
      "text": "Also dann...\\nBis bald, [VAR 0x0100(0000)]![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
