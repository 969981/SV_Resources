          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_a_06_ecology_03",
      "hash64": "61FC266A34258F33",
      "text": "Leider hat Direktor Clavel irgendwie davon Wind\\nbekommen und mir eine saftige Standpauke\\r\\ngehalten. Uff...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_a_06_ecology_04",
      "hash64": "61FC2B6A342597B2",
      "text": "Er meinte, er würde mir sofort ansehen,\\nwenn ich irgendwas vor ihm verheimliche.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_a_06_ecology_05",
      "hash64": "61FC2C6A34259965",
      "text": "War ich etwa ganz bleich im Gesicht? Oder bin\\nich rot angelaufen? Keine Ahnung...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_a_06_ecology_06",
      "hash64": "61FC296A3425944C",
      "text": "Aber wo wir gerade von Farben sprechen...\\c\\nDarum geht es auch in der heutigen\\nUnterrichtsstunde![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_a_06_ecology_07",
      "hash64": "61FC2A6A342595FF",
      "text": "Die Farben und Musterungen zweier Pokémon\\nderselben Art können sich nämlich je nach\\r\\nGeschlecht oder anderen individuellen\\r\\nEigenheiten leicht unterscheiden.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 161,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_a_06_ecology_08",
      "hash64": "61FC2F6A34259E7E",
      "text": "Ganz selten werden Pokémon auch mit einer\\nfür ihre Art ungewöhnlichen Verteilung an\\r\\nFarbpigmenten geboren.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_a_06_ecology_09",
      "hash64": "61FC306A3425A031",
      "text": "In solchen Fällen sprechen wir von\\n[VAR 0xFF00(0006)]Schillernden Pokémon[VAR 0xFF00(0000)].[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
