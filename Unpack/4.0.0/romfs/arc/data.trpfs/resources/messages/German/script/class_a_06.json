          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_a_06_ecology_10",
      "hash64": "61FFAD6A3428AA6F",
      "text": "Die Chancen, so einem Exemplar über den Weg\\nzu laufen, sind aber ziemlich gering.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_a_06_ecology_11",
      "hash64": "61FFAC6A3428A8BC",
      "text": "Weiß jemand, mit welcher Wahrscheinlichkeit\\nman Schillernden Pokémon begegnen kann?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_a_06_select_01",
      "hash64": "83E5677B4BB4CFE7",
      "text": "1 zu 40",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_a_06_select_02",
      "hash64": "83E5687B4BB4D19A",
      "text": "1 zu 400",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_a_06_select_03",
      "hash64": "83E5697B4BB4D34D",
      "text": "1 zu 4000",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_a_06_ecology_answer_01",
      "hash64": "886153BB6C0A8C32",
      "text": "Wenn im Schnitt jedes vierzigste Pokémon ein\\nSchillerndes Pokémon wäre, könnten wir sie\\r\\nbesser erforschen. Aber sie sind viiiel seltener.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_a_06_ecology_answer_02",
      "hash64": "886152BB6C0A8A7F",
      "text": "Oh, die Richtung stimmt schon mal! Aber eine\\nChance von 1 zu 400 wäre trotzdem noch ein\\r\\nbisschen zu hoch.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_a_06_ecology_answer_03",
      "hash64": "886151BB6C0A88CC",
      "text": "Wow, Volltreffer! Ich glaube, vor mir sitzt\\n[VAR 0x1100(00FF,2220,0000)]ein angehender Pokémon-Professoreine angehende Pokémon-Professorin![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "2220",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_a_06_ecology_12",
      "hash64": "61FFAF6A3428ADD5",
      "text": "Tatsächlich beträgt die Chance, ein Schillerndes\\nPokémon zu Gesicht zu kriegen, nur 1 zu 4000![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_a_06_ecology_13",
      "hash64": "61FFAE6A3428AC22",
      "text": "Dabei macht es keinen Unterschied, ob ihr einem\\nwilden Pokémon begegnet oder eines aus einem\\r\\nEi schlüpft.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_a_06_ecology_14",
      "hash64": "61FFA96A3428A3A3",
      "text": "Falls das Ei aber von Pokémon stammt, die aus\\nRegionen mit unterschiedlichen Sprachen\\r\\nkommen...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_a_06_ecology_15",
      "hash64": "61FFA86A3428A1F0",
      "text": "...besteht eine höhere Chance, dass das daraus\\nschlüpfende Pokémon ein Schillerndes ist.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_a_06_ecology_16",
      "hash64": "61FFAB6A3428A709",
      "text": "Warum? Tjaaa, dieses Geheimnis wurde noch\\nnicht gelüftet.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_a_06_ecology_17",
      "hash64": "61FFAA6A3428A556",
      "text": "Außerdem soll es so eine Art Glücksbringer\\ngeben, der die Wahrscheinlichkeit erhöht,\\r\\neinem Schillernden Pokémon zu begegnen...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_a_06_ecology_18",
      "hash64": "61FFB56A3428B807",
      "text": "Wissenschaftlich fundiert klingt das nicht gerade,\\naber es wär schon toll, wenn das stimmen würde![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_a_06_ecology_19",
      "hash64": "61FFB46A3428B654",
      "text": "Ups, es hat geklingelt.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_a_06_ecology_20",
      "hash64": "61F5BB6A34206DB4",
      "text": "Dann sind wir für heute fertig. Danke und haltet\\ndie Ohren steif![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
