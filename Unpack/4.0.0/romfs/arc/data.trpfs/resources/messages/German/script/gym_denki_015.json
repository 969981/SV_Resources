      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_denki_015_select_02",
      "hash64": "09252F6E0C8AFCCD",
      "text": "Hola, ciao und hallöle zurück!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_denki_015_denki_03a",
      "hash64": "AB88D62C5AA8DE3E",
      "text": "Genau! Ich bin Enigmara, die Arenaleiterin.\\nGleichzeitig lade ich als traumhafte Influencerin\\r\\nVideos im Netz hoch.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
