    },
    {
      "ordinal": 7,
      "label": "gym_denki_015_denki_03b",
      "hash64": "AB88D52C5AA8DC8B",
      "text": "Wooow, du sprichst meine Sprache ja fließend!\\nIst nicht deine erste Show, was?[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
