    },
    {
      "ordinal": 9,
      "label": "gym_denki_015_denki_04",
      "hash64": "E12A3257CA10E62A",
      "text": "Danke, dass ich dich heute als [VAR 0x1100(00FF,0E0E,0000)]HerausfordererHerausforderin in\\nder Fermanca-Arena begrüßen darf![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
