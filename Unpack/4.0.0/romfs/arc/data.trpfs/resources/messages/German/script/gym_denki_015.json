    },
    {
      "ordinal": 8,
      "label": "gym_denki_015_denki_03",
      "hash64": "E12A2D57CA10DDAB",
      "text": "Vielleicht fühlst du dich von dieser Situation etwas\\nüberrumpelt. Doch keine Zeit für Panik, denn...\\c\\nWir sind schon live, und das weltweit!\\nAlso schön lächeln![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
