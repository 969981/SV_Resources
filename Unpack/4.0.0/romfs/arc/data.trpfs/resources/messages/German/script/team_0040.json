        }
      ]
    },
    {
      "ordinal": 1,
      "label": "team_0040_select_01",
      "hash64": "8DFCA77950E4BCD8",
      "text": "Señor Direktor?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "team_0040_select_02",
      "hash64": "8DFCAA7950E4C1F1",
      "text": "Leval?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "team_0040_nelke_02",
      "hash64": "59AB8202A7EA8494",
      "text": "Nur, um das noch mal klarzustellen: Gerade bin\\nich Leval. Bitte vergiss das nicht.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "team_0040_nelke_03",
      "hash64": "59AB8302A7EA8647",
      "text": "Volltreffer! Momentan bin ich Leval.\\nGut aufgepasst.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "team_0040_nelke_04",
      "hash64": "59AB8002A7EA812E",
      "text": "Jetzt muss ich mich aber erst mal bei dir\\nbedanken, [VAR 0x0100(0000)].[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "team_0040_nelke_05",
      "hash64": "59AB8102A7EA82E1",
      "text": "Ohne dich hätte ich sicher nicht Teil von\\nOperation Stardust sein können![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "team_0040_select_03",
      "hash64": "8DFCA97950E4C03E",
      "text": "Warum war das so wichtig?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "team_0040_select_04",
      "hash64": "8DFCAC7950E4C557",
      "text": "Was ist Ihr, äh, dein Ziel?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "team_0040_nelke_06",
      "hash64": "59AB7E02A7EA7DC8",
      "text": "Ich möchte der Sache mit Team Star und den\\nRätseln, die sie umgeben, auf den Grund gehen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "team_0040_select_05",
      "hash64": "8DFCAB7950E4C3A4",
      "text": "Was für eine Sache?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "team_0040_select_06",
      "hash64": "8DFCAE7950E4C8BD",
      "text": "Was für Rätsel?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "team_0040_nelke_07",
      "hash64": "59AB7F02A7EA7F7B",
      "text": "Sie sollen viele Schüler durch ständiges Mobbing\\ndazu gebracht haben, die Akademie zu verlassen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "team_0040_nelke_08",
      "hash64": "59AB7C02A7EA7A62",
      "text": "Zudem hecken sie in ihren Verstecken angeblich\\neinen Plan aus, die Akademie anzugreifen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "team_0040_nelke_09",
      "hash64": "59AB7D02A7EA7C15",
      "text": "Aber für diese üblen Gerüchte, die über sie im\\nUmlauf sind, gibt es keine Beweise.\\c\\nSo wie ich das sehe, ist das größte Problem eher\\nein anderes...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "team_0040_nelke_10",
      "hash64": "59AEEA02A7ED6B23",
      "text": "Die Mitglieder von Team Star fehlen schon seit\\nlanger Zeit unentschuldigt im Unterricht...\\c\\nSie lassen sich überhaupt nicht mehr in der\\nAkademie blicken.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 155,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "team_0040_nelke_11",
      "hash64": "59AEE902A7ED6970",
      "text": "Fünf von ihnen – die sogenannten „Bosse“ von\\nTeam Star – fehlen schon seit über einem Jahr.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "team_0040_nelke_12",
      "hash64": "59AEEC02A7ED6E89",
      "text": "Dazu kommt, dass ihre Handlanger in letzter Zeit\\nangefangen haben, für Unruhe zu sorgen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "team_0040_nelke_13",
      "hash64": "59AEEB02A7ED6CD6",
      "text": "Deshalb habe ich Team Star darum gebeten,\\nsich aufzulösen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "team_0040_nelke_14",
      "hash64": "59AEEE02A7ED71EF",
      "text": "Sollten sie sich dem widersetzen, bleibt mir nichts\\nanderes übrig, als sie der Akademie zu verweisen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "team_0040_nelke_15",
      "hash64": "59AEED02A7ED703C",
      "text": "Bisher habe ich noch nichts von ihnen gehört und\\nder Zeitpunkt, bis zu dem sie eine Entscheidung\\r\\ntreffen sollen, rückt immer näher...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "team_0040_nelke_16",
      "hash64": "59AEF002A7ED7555",
      "text": "Und dann habe ich gehört, wie du mit Cassiopeia\\ntelefoniert hast.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "team_0040_system_01",
      "hash64": "E9FA55E86C3AB05B",
      "text": "*brrring-rrring*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "team_0040_cassiopeia_01",
      "hash64": "1B07436709C75031",
      "text": "[VAR 0xBD06(0000)]Cassiopeia hier. Kannst du mich hören,\\n[VAR 0x0100(0000)]?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "team_0040_nelke_17",
      "hash64": "59AEEF02A7ED73A2",
      "text": "Argh...![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "team_0040_nelke_18",
      "hash64": "59AEF202A7ED78BB",
      "text": "*flüster* Wir reden ein andermal weiter.\\nPass gut auf dich auf.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "team_0040_cassiopeia_02",
      "hash64": "1B07406709C74B18",
      "text": "Du bist wieder in der Nähe von einem Versteck.\\nAber... War da gerade jemand bei dir?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "team_0040_select_07",
      "hash64": "8DFCAD7950E4C70A",
      "text": "Nein, hier ist niemand.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "team_0040_select_08",
      "hash64": "8DFCA07950E4B0F3",
      "text": "Ich bin alleine.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "team_0040_cassiopeia_03",
      "hash64": "1B07416709C74CCB",
      "text": "Okay... Jedenfalls wird Team Star jetzt sicher\\nwachsamer sein, wo du einen Boss besiegt hast.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "team_0040_cassiopeia_04",
      "hash64": "1B07466709C7554A",
      "text": "Die Einnahme der restlichen Verstecke wird daher\\nhöchstwahrscheinlich schwieriger werden.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "team_0040_cassiopeia_05",
      "hash64": "1B07476709C756FD",
      "text": "Bleib weiterhin wachsam. Ich melde mich später\\nwieder.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    }
  ]
