    {
      "ordinal": 13,
      "label": "team_0190_botan_12",
      "hash64": "5712BB0133B376CC",
      "text": "Ich werde wohl nie in Worte fassen können,\\nwie dankbar ich dir bin. Darum... Hier...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
