      "hash64": "0929C9B11ABC4D07",
      "text": "Wie kommt’s?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "team_0190_botan_05",
      "hash64": "5716460133B698D4",
      "text": "Sie meinten, dass ich es wiedergutmachen kann,\\nindem ich ehrenamtlich als Ingenieurin bei der\\r\\nPokémon-Liga aushelfe.\\c\\nSie haben sogar gefragt, ob ich nach meinem\\nAbschluss dort arbeiten will![VAR 0x0114(0008)]",
