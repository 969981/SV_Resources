    {
      "ordinal": 9,
      "label": "team_0190_botan_08",
      "hash64": "57163B0133B68623",
      "text": "Sorry, dass ich dich hergerufen habe. Ich bin nicht\\nso gut darin, persönlich mit Leuten zu sprechen.[VAR 0x0114(0008)]",
