    {
      "ordinal": 5,
      "label": "kizuna_botan_b_doku_01",
      "hash64": "56D19D9ADF00CBC7",
      "text": "Hm...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
