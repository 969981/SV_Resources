    {
      "ordinal": 2,
      "label": "a_sch_room02_eve03",
      "hash64": "5ED855C6313F1247",
      "text": "Gute Zeichnungen sehen fast wie Fotos aus.\\c\\nWarum benutzen Künstler dann nicht gleich die\\nKamera-App?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "a_sch_room02_eve04",
      "hash64": "5ED852C6313F0D2E",
      "text": "Gemalte Bilder haben einen künstlerischen Wert,\\nden Fotos nicht haben. Andersrum gilt das auch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "a_sch_room02_eve05",
      "hash64": "5ED853C6313F0EE1",
      "text": "Was für eine großartige Skulptur! Da werden\\nselbst Pokémon neidisch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
