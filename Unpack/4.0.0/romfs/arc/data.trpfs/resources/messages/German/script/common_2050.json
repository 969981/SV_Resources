  "entries": [
    {
      "ordinal": 0,
      "label": "common_2050_top_01",
      "hash64": "7B9F6001D9F9E6D4",
      "text": "Das ist also dein Zimmer hier in der Akademie...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2050_top_02",
      "hash64": "7B9F6301D9F9EBED",
      "text": "Dann ist das quasi der Ort, an dem du zum\\nChamp herangereift bist.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2050_top_03",
      "hash64": "7B9F6201D9F9EA3A",
      "text": "Obwohl... Du lebst ja noch gar nicht so lange\\nin der Akademie.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2050_top_04",
      "hash64": "7B9F5D01D9F9E1BB",
      "text": "Vielleicht sollte ich bald mal deinem Elternhaus\\neinen Besuch abstatten...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2050_top_05",
      "hash64": "7B9F5C01D9F9E008",
      "text": "Aber zurück zum eigentlichen Thema.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2050_top_06",
      "hash64": "7B9F5F01D9F9E521",
      "text": "Mich würde interessieren, welche Eindrücke die\\nArenaleiter bei dir hinterlassen haben.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2050_top_07",
      "hash64": "7B9F5E01D9F9E36E",
      "text": "Wer hat dich deiner Meinung nach im Kampf\\nam wenigsten gefordert?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2050_top_08",
      "hash64": "7B9F5901D9F9DAEF",
      "text": "Wer hat bei dir den bleibendsten Eindruck\\nhinterlassen?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2050_top_09",
      "hash64": "7B9F5801D9F9D93C",
      "text": "Und wer hat sich im Kampf als die härteste Nuss\\nerwiesen?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2050_top_10",
      "hash64": "7B9BDB01D9F6CEFE",
      "text": "Zu guter Letzt noch die wichtigste Frage\\nvon allen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2050_top_11",
      "hash64": "7B9BDC01D9F6D0B1",
      "text": "Welchen Arenaleiter magst du am meisten?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2050_top_12",
      "hash64": "7B9BD901D9F6CB98",
      "text": "So, das wären auch schon alle Fragen.\\nVielen Dank![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2050_top_13",
      "hash64": "7B9BDA01D9F6CD4B",
      "text": "Deine Eindrücke waren höchst interessant.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2050_top_14",
      "hash64": "7B9BDF01D9F6D5CA",
      "text": "Sie werden mir bei meiner Planung gewiss von\\ngroßer Hilfe sein. Bitte nimm dies als Zeichen\\r\\nmeiner Dankbarkeit an.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2050_top_15",
      "hash64": "7B9BE001D9F6D77D",
      "text": "Dank deiner Hilfe ist mein Terminplan nun\\nnicht mehr so überladen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_2050_top_16",
      "hash64": "7B9BDD01D9F6D264",
      "text": "Es spricht also nichts gegen meine Teilnahme an\\ndem Turnier, über das wir im Büro des Direktors\\r\\ngesprochen haben.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_2050_top_17",
      "hash64": "7B9BDE01D9F6D417",
      "text": "Champ Nemila wird sich bestimmt darüber\\nfreuen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_2050_top_18",
      "hash64": "7B9BD301D9F6C166",
      "text": "So, dann verabschiede ich mich fürs Erste.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_2050_top_19",
      "hash64": "7B9BD401D9F6C319",
      "text": "Du bist sicher ziemlich erschöpft. Lass es für den\\nRest des Tages mal ruhig angehen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
