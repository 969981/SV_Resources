      "ordinal": 0,
      "label": "sub_035_mgirl_01",
      "hash64": "4A602E61B3DEF66A",
      "text": "Na, möchtest du gerne wissen, wie groß dein[VAR 0x1101(00FD,0100)]e\\nPokémon [VAR 0x1101(00FD,0403)]istsind?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 3,
