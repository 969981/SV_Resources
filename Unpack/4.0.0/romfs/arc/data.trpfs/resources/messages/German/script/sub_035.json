    {
      "ordinal": 18,
      "label": "sub_035_mgirl_17",
      "hash64": "4A5CA861B3DBDCE1",
      "text": "Sprich mich jederzeit an, wenn du die Größe\\ndeiner Pokémon wissen willst.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sub_035_mgirl_18",
      "hash64": "4A5CA161B3DBD0FC",
      "text": "Hey, wusstest du, dass Pokémon derselben Art\\nunterschiedlich groß sein können?\\c\\nMeine Pachirisu sind der beste Beweis dafür.\\nIhr Größenunterschied ist offensichtlich, oder?\\c\\nIch brauche Pokémon derweil nur anzuschauen,\\num ihre Größe ganz exakt feststellen zu können!",
      "flags": 0,
