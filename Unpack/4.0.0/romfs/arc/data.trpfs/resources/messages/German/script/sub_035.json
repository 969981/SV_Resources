          "args_hex": [
            "00FD",
            "0403"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sub_035_mgirl_02",
      "hash64": "4A602D61B3DEF4B7",
      "text": "Welches Pokémon soll ich mir mal näher\\nansehen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_035_mgirl_03",
      "hash64": "4A602C61B3DEF304",
      "text": "Dein [VAR 0x0102(0001)], ja?\\nGut, dann wollen wir mal...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_035_mgirl_04",
      "hash64": "4A602B61B3DEF151",
      "text": "Meine Güte, ist das ein Koloss!\\c\\nSolch ein überdimensionales Exemplar trifft man\\nnicht alle Tage!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_035_mgirl_05",
      "hash64": "4A602A61B3DEEF9E",
      "text": "[VAR 0xBD06(0000)]Das dürfte wohl das größte [VAR 0x0101(0001)] der\\nWelt sein!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sub_035_mgirl_06",
      "hash64": "4A602961B3DEEDEB",
      "text": "Beeindruckend! Wer ein so groß geratenes\\nPokémon an seiner Seite hat, braucht sich wohl\\r\\nvor nichts und niemandem mehr zu fürchten!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_035_mgirl_07",
      "hash64": "4A602861B3DEEC38",
      "text": "Hui! Dein Pokémon scheint ein ordentliches Stück\\ngrößer zu sein als seine Artgenossen!\\c\\nDas ist etwas ganz Besonderes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_035_mgirl_08",
      "hash64": "4A602761B3DEEA85",
      "text": "Dein Pokémon scheint ein bisschen größer zu sein\\nals seine Artgenossen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_035_mgirl_09",
      "hash64": "4A602661B3DEE8D2",
      "text": "Na, wer sagt’s denn! Ein ganz und gar normal\\ngroßes Pokémon, herrlich erquickend in seiner\\r\\nDurchschnittlichkeit!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_035_mgirl_10",
      "hash64": "4A5CA961B3DBDE94",
      "text": "Dein Pokémon scheint ein bisschen kleiner zu sein\\nals seine Artgenossen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_035_mgirl_11",
      "hash64": "4A5CAA61B3DBE047",
      "text": "Hui! Dein Pokémon scheint ein ordentliches Stück\\nkleiner zu sein als seine Artgenossen!\\c\\nDas ist etwas ganz Besonderes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
