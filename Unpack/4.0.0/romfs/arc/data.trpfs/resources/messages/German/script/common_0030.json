    {
      "ordinal": 1,
      "label": "common_0030_mama_02",
      "hash64": "73E050C9F3FED272",
      "text": "Oh, du trägst ja schon deine Uniform![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
