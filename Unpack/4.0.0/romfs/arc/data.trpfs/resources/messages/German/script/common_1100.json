    },
    {
      "ordinal": 3,
      "label": "common_1100_rival_03",
      "hash64": "0E61F2BD5903E694",
      "text": "Fühlst du dich nicht gut, Cosima?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
