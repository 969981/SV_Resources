    },
    {
      "ordinal": 4,
      "label": "common_1100_botan_02",
      "hash64": "E834A0F91EB56B1D",
      "text": "Hm? Oh, doch, alles in Ordnung.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
