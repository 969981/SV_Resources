          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_1100_botan_03",
      "hash64": "E8349FF91EB5696A",
      "text": "Mir geht nur diese Zeitmaschine nicht aus\\ndem Kopf...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_1100_botan_04a",
      "hash64": "46C3DF4F2E330A7E",
      "text": "Die Pokémon hier in Zone Null sind aus der\\nVergangenheit hergekommen, richtig?\\c\\nKann es dann nicht sein, dass Koraidon auch aus\\nder Vergangenheit stammt?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
