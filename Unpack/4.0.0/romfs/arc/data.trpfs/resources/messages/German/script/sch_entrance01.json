    {
      "ordinal": 20,
      "label": "sch_entrance01_boy_05",
      "hash64": "EB33DCE6A2437BE0",
      "text": "Kaum zu glauben, dass wirklich alle aus einem\\nbestimmten Grund hier sind: um etwas zu lernen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sch_entrance01_boy_06",
      "hash64": "EB33DFE6A24380F9",
      "text": "Wählst du den naturwissenschaftlichen oder eher\\nden geisteswissenschaftlichen Zweig?\\c\\nWenn dein Herz für Pokémon schlägt, ist der\\nuniverselle Zweig vielleicht das Richtige für dich.",
