    {
      "ordinal": 39,
      "label": "sch_entrance01_boy_10",
      "hash64": "EB305BE6A2406AD6",
      "text": "Diese Cosima aus dem naturwissenschaftlichen\\nZweig ist echt auf Zack und hat viel Ahnung von\\r\\nTechnik.\\c\\nIch habe gehört, dass sie vor Kurzem erst an die\\nAkademie zurückgekehrt ist.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sch_entrance01_girl_08",
      "hash64": "A478D6916FCE54BB",
      "text": "Wenn man laut aus einem Schulbuch vorliest,\\nlernen Mund und Ohren gleich mit!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "sch_entrance01_girl_09",
      "hash64": "A478D5916FCE5308",
      "text": "Ich hab mich hier einschulen lassen, weil ich mehr\\nüber Pokémon lernen wollte, aber jetzt bin ich\\r\\ntotal neugierig auf den naturwissenschaftlichen\\r\\nZweig!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
