    {
      "ordinal": 2,
      "label": "sdc02_0235_ground_01",
      "hash64": "D979C6BDBDC55680",
      "text": "Hallo! Ich bin auch mit von der Partie.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
