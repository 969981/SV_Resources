          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0235_ground_02",
      "hash64": "D979C9BDBDC55B99",
      "text": "Hätte nicht gedacht, dass wir uns hier\\nüber den Weg laufen würden![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0235_chairman_02",
      "hash64": "2C6DB5047B65BEE1",
      "text": "Auch fern der Grenzen unserer Region scheinst\\ndu als Champ Paldeas dein Talent unter Beweis\\r\\nzu stellen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 106,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0235_select_01",
      "hash64": "ABB7C9C24ACDCE91",
      "text": "Ich geb mein Bestes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_0235_select_02",
      "hash64": "ABB7C6C24ACDC978",
      "text": "So macht man das als Champ!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_0235_chairman_03",
      "hash64": "2C6DB4047B65BD2E",
      "text": "Hihi... Mir war von Anfang an klar, was für ein\\naußerordentliches Talent du bist.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0235_ground_04",
      "hash64": "D979CBBDBDC55EFF",
      "text": "Das stimmt. Ein ganz außerordentliches Talent...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0235_ground_05",
      "hash64": "D979CABDBDC55D4C",
      "text": "Und außergewöhnlich dreist noch dazu![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0235_ground_06",
      "hash64": "D979CDBDBDC56265",
      "text": "Jeder weiß, dass man den Schlund nicht ohne\\nErlaubnis betreten darf!\\c\\nUnd du spazierst trotzdem einfach rein![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0235_ground_07",
      "hash64": "D979CCBDBDC560B2",
      "text": "Ich bin mächtig sauer deswegen![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0235_select_03",
      "hash64": "ABB7C7C24ACDCB2B",
      "text": "Tut mir leid...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc02_0235_select_04",
      "hash64": "ABB7CCC24ACDD3AA",
      "text": "So macht man das als Champ...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0235_ground_08",
      "hash64": "D979CFBDBDC565CB",
      "text": "Eine Entschuldigung macht es auch nicht besser!\\c\\nIch bin schier vom Stuhl gekippt, als ich die\\nGeschichte gehört hab![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0235_ground_09",
      "hash64": "D979CEBDBDC56418",
      "text": "Ob du Champ bist oder nicht, ist völlig egal!\\nWas verboten ist, ist verboten![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0235_chairman_04",
      "hash64": "2C6DB7047B65C247",
      "text": "Beruhige dich, Cay. [VAR 0x1100(00FF,0303,0000)]IhmIhr ist ja nichts passiert.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0235_chairman_05",
      "hash64": "2C6DB6047B65C094",
      "text": "[VAR 0xBD06(0000)]Außerdem stünde es jetzt ziemlich schlecht um\\nPaldea, wenn Champ [VAR 0x0100(0000)] Zone Null\\r\\nnicht\\r\\nbetreten hätte.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
