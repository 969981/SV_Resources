      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0235_ground_10",
      "hash64": "D97661BDBDC2750A",
      "text": "Hmpf, stimmt schon, aber...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0235_ground_11",
      "hash64": "D97662BDBDC276BD",
      "text": "Na gut, dem obersten Boss zuliebe will ich mal\\nein Auge zudrücken.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0235_chairman_06",
      "hash64": "2C6DB9047B65C5AD",
      "text": "Wie du siehst, hat sich Cay wirklich Sorgen um\\ndich gemacht.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0235_chairman_07",
      "hash64": "2C6DB8047B65C3FA",
      "text": "Nun denn, Champ [VAR 0x0100(0000)].[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0235_chairman_08",
      "hash64": "2C6DAB047B65ADE3",
      "text": "Diesmal begibst du dich mit der offiziellen\\nErlaubnis der Pokémon-Liga nach Zone Null.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0235_chairman_09",
      "hash64": "2C6DAA047B65AC30",
      "text": "Nur eine Handvoll Leute wissen, was sich dort in\\nden Tiefen mit der Zeitmaschine zugetragen hat.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0235_chairman_10",
      "hash64": "2C6A2D047B62A1F2",
      "text": "In Anbetracht eurer anstehenden Expedition habe\\nich Ms Brianna über die Gefahren in Zone Null\\r\\ninformiert, jedoch ohne ins Detail zu gehen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0235_ground_12",
      "hash64": "D9765FBDBDC271A4",
      "text": "Ach ja, wolltest du dieser Brianna nicht etwas\\ngeben?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc02_0235_chairman_11",
      "hash64": "2C6A2E047B62A3A5",
      "text": "Du hast recht. Das habe ich glatt vergessen...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc02_0235_chairman_12",
      "hash64": "2C6A2B047B629E8C",
      "text": "[VAR 0xBD06(0000)]Champ [VAR 0x0100(0000)], würdest du\\ndas hier\\r\\nbitte\\r\\nan dich\\r\\nnehmen?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 1,
