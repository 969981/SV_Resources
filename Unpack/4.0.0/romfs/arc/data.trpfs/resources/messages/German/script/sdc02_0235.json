          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc02_0235_ground_13",
      "hash64": "D97660BDBDC27357",
      "text": "Was ist das? Eine TM?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc02_0235_chairman_13",
      "hash64": "2C6A2C047B62A03F",
      "text": "Das ist eine Scheibe, die einer der Forscher in\\nZone Null an seinen Geldgeber geschickt hat.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0235_chairman_14",
      "hash64": "2C6A29047B629B26",
      "text": "Wir haben sie von unserer Forschungsabteilung\\nuntersuchen lassen und herausgefunden, dass es\\r\\nsich definitiv nicht um eine TM handelt.\\c\\nSie scheint aber auch kein einfaches\\nSpeichermedium zu sein.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 200,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc02_0235_chairman_15",
      "hash64": "2C6A2A047B629CD9",
      "text": "Wir wissen nicht, wie und wofür sie genutzt wird,\\ndoch sie hat sicher etwas mit Zone Null zu tun.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
