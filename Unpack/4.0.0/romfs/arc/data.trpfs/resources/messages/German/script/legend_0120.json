    },
    {
      "ordinal": 2,
      "label": "legend_0120_friend_02",
      "hash64": "128CFA72A6CCF9DC",
      "text": "Erst sprichst du mich an und dann sagst du Nein?\\nSo auf Abruf zu sein, schmeckt mir gar nicht![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
