          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "legend_0120_friend_03",
      "hash64": "128CFB72A6CCFB8F",
      "text": "Jawoll! Mastifioso, bist du auch bereit?![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "legend_0120_friend_04",
      "hash64": "128CF872A6CCF676",
      "text": "Maff, maff!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "legend_0120_friend_05",
      "hash64": "128CF972A6CCF829",
      "text": "Mastifioso sagt, es kann losgehen![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "legend_0120_select_01",
      "hash64": "5ACB8C3B6D658065",
      "text": "Du kämpfst mit Mastifioso?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "legend_0120_select_02",
      "hash64": "5ACB893B6D657B4C",
      "text": "Glaubst du, das geht gut?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "legend_0120_friend_06",
      "hash64": "128CF672A6CCF310",
      "text": "Okay, ich versteh schon, warum du dir Sorgen\\nmachst...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "legend_0120_friend_07",
      "hash64": "128CF772A6CCF4C3",
      "text": "Aber es ist wirklich kaum zu glauben, wie gut es\\nihm geht, seit es wieder gesund ist.\\c\\nEs strotzt nur so vor Energie![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "legend_0120_friend_08",
      "hash64": "128D0472A6CD0ADA",
      "text": "Und es bettelt sogar schon die ganze Zeit darum,\\ngegen dich zu kämpfen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "legend_0120_friend_09",
      "hash64": "128D0572A6CD0C8D",
      "text": "Früher war es richtig kampfbegeistert, weißt du!\\nAuch wenn wir immer gegen die Schulsprecherin\\r\\nverloren haben...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "legend_0120_friend_10",
      "hash64": "12900272A6CF3D4B",
      "text": "Aber genug gelabert! Mach dir keine Sorgen![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "legend_0120_friend_11",
      "hash64": "12900172A6CF3B98",
      "text": "Dank der Geheimgewürze sind wir quasi wie\\nneugeboren. Und gleich kriegst du eine\\r\\nKostprobe unserer neuen Stärke![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "legend_0120_friend_12",
      "hash64": "12900472A6CF40B1",
      "text": "Wohl bekomms![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "legend_0120_friend_13",
      "hash64": "12900372A6CF3EFE",
      "text": "Wow! So stark ist also jemand, der es schafft,\\nHerrscher-Pokémon zu bezwingen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "legend_0120_friend_14",
      "hash64": "12900672A6CF4417",
      "text": "Mir ist ehrlich gesagt nicht ganz wohl bei dem\\nGedanken, dein einziger Begleiter zu sein...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "legend_0120_friend_15",
      "hash64": "12900572A6CF4264",
      "text": "In Zone Null wimmelt es nur so von superstarken\\nPokémon und komischen Maschinen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "legend_0120_friend_16",
      "hash64": "12900872A6CF477D",
      "text": "Wenn uns vielleicht noch zwei weitere Leute\\nbegleiten könnten...\\c\\nAm besten [VAR 0xFF00(0006)]jemand Starkes auf dem Champ-Rang[VAR 0xFF00(0000)]\\nund[VAR 0xFF00(0006)] jemand, der sich gut mit Technik auskennt[VAR 0xFF00(0000)].[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
