      ]
    },
    {
      "ordinal": 19,
      "label": "legend_0120_select_03",
      "hash64": "5ACB8A3B6D657CFF",
      "text": "Klingt nach Nemila!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "legend_0120_select_04",
      "hash64": "5ACB873B6D6577E6",
      "text": "Klingt nach Cosima!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "legend_0120_select_05",
      "hash64": "5ACB883B6D657999",
      "text": "Vielleicht Nemila...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "legend_0120_select_06",
      "hash64": "5ACB853B6D657480",
      "text": "Vielleicht Cosima...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "legend_0120_friend_16a",
      "hash64": "5A0576D17235D494",
      "text": "Ja klar, die Schulsprecherin!\\c\\nMit ihr müssen wir uns keine Sorgen machen, egal\\nwie stark die Pokémon sind, die uns angreifen![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "legend_0120_friend_16b",
      "hash64": "5A0579D17235D9AD",
      "text": "Cosima? Diese Superhackerin? Big Boss von\\nTeam Star?\\c\\nIch schätze schon, dass sie geeignet wäre...\\nAber sag mal, wann hast du bitte solche\\r\\ndubiosen Freunde gefunden??[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 171,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "legend_0120_friend_16c",
      "hash64": "5A0578D17235D7FA",
      "text": "Die Schulsprecherin...?\\c\\nGeeignet wäre sie sicher, aber bis du nicht auch\\nChamp geworden bist, rührt sie wahrscheinlich\\r\\nkeinen Finger für uns.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "legend_0120_friend_16d",
      "hash64": "5A0573D17235CF7B",
      "text": "Ach, und die ist technisch begabt, ja?\\c\\nAber glaubst du, sie würde uns einfach so helfen?\\nWenn wir nur enger mit ihr befreundet wären\\r\\noder sie uns was schulden würde, oder so...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 182,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "legend_0120_friend_17a",
      "hash64": "5A0252D172336191",
      "text": "Schauen wir mal, was passiert! Lass uns wieder\\nsprechen, wenn wir Verbündete gefunden haben![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "legend_0120_friend_18a",
      "hash64": "59D662D1720E41D6",
      "text": "Halt mich auf dem Laufenden, wenn du Leute\\nfindest, die wir mit ins Boot holen können![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "legend_0120_friend_17b",
      "hash64": "5A024FD172335C78",
      "text": "Krass! Also kennst du bereits die perfekten Leute,\\ndie wir einspannen können![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "legend_0120_friend_18b",
      "hash64": "59D661D1720E4023",
      "text": "Dann melde ich mich mal bei ihnen und erkläre,\\nwas wir vorhaben.\\c\\nWir treffen uns dann alle in der Nähe vom\\nSchlund bei einer Einrichtung namens Tor Null!\\c\\nIch schick dir die Info, wie du dorthin kommst.\\nUnd lass mich nicht zu lange warten![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
