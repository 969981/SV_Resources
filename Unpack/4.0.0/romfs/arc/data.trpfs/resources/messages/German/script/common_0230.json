          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0230_head_teacher_03",
      "hash64": "C0DB5A22B31FB71A",
      "text": "Nun, von unserer Schulsprecherin mit dem\\nChamp-Rang hatte ich auch nichts anderes\\r\\nerwartet.\\c\\nDanke, dass du unseren Neuzugang herumführst,\\nNemila.[VAR 0x0114(000A)]",
