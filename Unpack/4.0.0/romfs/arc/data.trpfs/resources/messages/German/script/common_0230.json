          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0230_head_teacher_02b",
      "hash64": "D4748AF65EE6D15D",
      "text": "Tatsächlich? Das klingt nach einer\\nabenteuerreichen Reise.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
