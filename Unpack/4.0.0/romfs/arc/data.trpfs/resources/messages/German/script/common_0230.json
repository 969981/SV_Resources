    {
      "ordinal": 7,
      "label": "common_0230_select_01",
      "hash64": "0554FE5451260E41",
      "text": "Es war der Wahnsinn!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_0230_select_02",
      "hash64": "0554FB5451260928",
      "text": "Es war kein Zuckerschlecken...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "common_0230_head_teacher_02a",
      "hash64": "D47487F65EE6CC44",
      "text": "Der Dank dafür gebührt wohl Nemila. Unsere\\nAkademie kann sehr stolz auf sie sein.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
