          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0230_rival_02",
      "hash64": "7FE30473EF51A80A",
      "text": "Dort am Empfang kannst du dich für die\\nverschiedensten Kurse anmelden.\\c\\nAußerdem gelangt man von hier aus zu allen\\nmöglichen Einrichtungen innerhalb des Geländes.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
