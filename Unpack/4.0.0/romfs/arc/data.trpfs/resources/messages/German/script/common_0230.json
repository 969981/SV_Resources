      "ordinal": 24,
      "label": "common_0230_rival_05",
      "hash64": "7FE2FF73EF519F8B",
      "text": "Wird gemacht, Direktor Clavel![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
