          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0230_rival_03",
      "hash64": "7FE30573EF51A9BD",
      "text": "Die Eingangshalle ist so groß, dass man hier\\nproblemlos Pokémon-Kämpfe bestreiten könnte,\\r\\nfindest du nicht auch?!\\c\\nAber leider ist das laut Schulordnung verboten...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
