    {
      "ordinal": 2,
      "label": "common_0230_rival_01",
      "hash64": "7FE30373EF51A657",
      "text": "Das hier ist die Eingangshalle![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
