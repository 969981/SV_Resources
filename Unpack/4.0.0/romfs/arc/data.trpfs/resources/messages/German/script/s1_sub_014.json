  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_014_header_01",
      "hash64": "5C51C3C3E118F228",
      "text": "Oh, [VAR 0x1100(00FF,0E0B,0000)]ein Schülereine Schülerin aus Paldea!\\nDu kommst genau richtig.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0E0B",
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_014_header_02",
      "hash64": "5C51C6C3E118F741",
      "text": "Hier im Gemeindehaus von Kitakami sind wir\\nimmer für unsere Touristen und Besucher da.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_014_header_03",
      "hash64": "5C51C5C3E118F58E",
      "text": "Wusstest du schon, dass sich das Design vom\\noberen und unteren Rahmen mancher Menüs\\r\\nabhängig von deinem Standort ändert?\\c\\nDas kannst du zum Beispiel sehen, wenn du\\ndeinen Beutel oder bestimmte Funktionen\\r\\nauf deinem Smart-Rotom öffnest!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 208,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_014_header_09",
      "hash64": "5C51BBC3E118E490",
      "text": "Möchtest du die Einstellungen zum oberen und\\nunteren Rahmen mancher Menüs ändern?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_014_header_04",
      "hash64": "5C51C8C3E118FAA7",
      "text": "[EMPTY 21]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_014_header_05",
      "hash64": "5C51C7C3E118F8F4",
      "text": "[EMPTY 21]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
