            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_014_header_14",
      "hash64": "5C4E3AC3E115D386",
      "text": "Na denn, ich wünsche dir weiterhin viel Spaß\\nhier in Kitakami!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_014_header_06",
      "hash64": "5C51CAC3E118FE0D",
      "text": "Bitte sehr, es wird nun immer das Paldea-Design\\nangezeigt.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s1_sub_014_header_07",
      "hash64": "5C51C9C3E118FC5A",
      "text": "[EMPTY 21]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_014_header_12",
      "hash64": "5C4E3CC3E115D6EC",
      "text": "Bitte sehr, das Design wechselt jetzt abhängig\\nvon deinem Standort.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s1_sub_014_select_00",
      "hash64": "FA5357055DDCC748",
      "text": "Ich möchte wechselnde Designs!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s1_sub_014_select_06",
      "hash64": "FA535D055DDCD17A",
      "text": "Ich bleibe bei den wechselnden Designs.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s1_sub_014_select_01",
      "hash64": "FA5358055DDCC8FB",
      "text": "Ich möchte das Paldea-Design!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
