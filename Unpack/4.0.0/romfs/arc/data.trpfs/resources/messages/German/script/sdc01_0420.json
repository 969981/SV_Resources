      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0420_sister_05",
      "hash64": "DABF42802A1503DE",
      "text": "Hä, Jo? Was machst du denn hier?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0420_brother_02",
      "hash64": "20B1073777FE57FD",
      "text": "Ähm, ich... Ich hätte eine Bitte an euch.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0420_brother_03",
      "hash64": "20B1063777FE564A",
      "text": "Könntet ihr ins Dorf kommen und...\\nden Oni mitbringen?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0420_select_01",
      "hash64": "9DF9DF558F2AB736",
      "text": "Aber die Leute im Dorf...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sdc01_0420_select_02",
      "hash64": "9DF9DE558F2AB583",
      "text": "Ist das eine gute Idee?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sdc01_0420_brother_04",
      "hash64": "20B1013777FE4DCB",
      "text": "B-Bitte, ihr müsst mir einfach vertrauen...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
