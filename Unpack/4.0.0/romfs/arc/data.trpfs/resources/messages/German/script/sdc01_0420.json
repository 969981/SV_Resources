        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0420_brother_05",
      "hash64": "20B1003777FE4C18",
      "text": "Das war schon alles![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0420_sister_06",
      "hash64": "DABF41802A15022B",
      "text": "Was hat er bloß vor? Im Dorf halten doch alle\\nOgerpon für böse.\\c\\nIch weiß nicht, ob wir es wirklich dorthin\\nmitnehmen sollten...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
