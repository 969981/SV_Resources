          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sdc02_0110_dragonbb_22",
      "hash64": "23A6E39E05C998CB",
      "text": "Gut, dann stimmen wir halt ab.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "sdc02_0110_dragonbb_23",
      "hash64": "23A6E29E05C99718",
      "text": "Ich bin natürlich voll dafür.\\nTara, was meinst du?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "sdc02_0110_fairybb_06",
      "hash64": "99B2032E37E9E235",
      "text": "Ich... Es tut mir leid, aber ich finde, dass das\\ngegen die Regeln verstößt...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "sdc02_0110_fairybb_07",
      "hash64": "99B2022E37E9E082",
      "text": "Matt?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sdc02_0110_firebb_02",
      "hash64": "2841B4CC8370CD00",
      "text": "Hm? Ich find’s gut![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "sdc02_0110_firebb_03",
      "hash64": "2841B5CC8370CEB3",
      "text": "Wenn [VAR 0x1100(00FF,0302,0000)]ersie hier zur Schule geht, ist [VAR 0x1100(00FF,0302,0000)]ersie auch [VAR 0x1100(00FF,0403,0000)]eineine\\n[VAR 0x1100(00FF,0907,0000)]SchülerSchülerin der Akademie, oder nicht?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302",
            "0000"
          ]
        },
