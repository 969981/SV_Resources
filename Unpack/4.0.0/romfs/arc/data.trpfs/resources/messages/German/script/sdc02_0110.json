      ]
    },
    {
      "ordinal": 50,
      "label": "sdc02_0110_firebb_04",
      "hash64": "2841BACC8370D732",
      "text": "Was sagst du dazu, Erin?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
