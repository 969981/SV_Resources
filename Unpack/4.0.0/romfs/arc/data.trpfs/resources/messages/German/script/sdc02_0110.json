      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_0110_dragonbb_05",
      "hash64": "23ADD49E05CF9DFC",
      "text": "Ja, oder? Eine Antwort ganz nach meinem\\nGeschmack, hehehe.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
