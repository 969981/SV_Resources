        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0110_dragonbb_07",
      "hash64": "23ADD69E05CFA162",
      "text": "Sag mal... Du hast doch starke Pokémon, oder?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
