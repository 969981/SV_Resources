    {
      "ordinal": 42,
      "label": "sdc02_0110_dragonbb_20",
      "hash64": "23A6E59E05C99C31",
      "text": "[VAR 0x1100(00FF,0302,0000)]ErSie besucht denselben Unterricht wie wir und hat\\nein Zimmer hier an unserer Akademie.\\c\\nDas reicht doch wohl, um [VAR 0x1100(00FF,0303,0000)]ihnsie genauso zu\\nbehandeln wie alle anderen![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
