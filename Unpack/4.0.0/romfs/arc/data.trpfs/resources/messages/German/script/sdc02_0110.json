      "text": "Das klingt super!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc02_0110_select_02",
      "hash64": "6FF85DE8A29A7624",
