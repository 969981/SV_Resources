          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0110_dragonbb_06",
      "hash64": "23ADD79E05CFA315",
      "text": "Hehehe, du hörst dich an wie meine Mutter.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
