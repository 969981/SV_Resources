          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0320_brother_03",
      "hash64": "130C3B18BDE88DA1",
      "text": "Dass der Oni eigentlich gar nicht böse ist...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0320_brother_04",
      "hash64": "130C3C18BDE88F54",
      "text": "Die drei Gefährten sind die wahren Bösen,\\naber ausgestoßen wurde der Oni![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0320_sister_02",
      "hash64": "4E9074DDA26A63A2",
      "text": "Ja... das wussten wir.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
