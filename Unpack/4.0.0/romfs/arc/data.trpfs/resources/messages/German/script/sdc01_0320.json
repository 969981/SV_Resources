        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0320_brother_02",
      "hash64": "130C3A18BDE88BEE",
      "text": "Ihr wusstet es, oder?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
