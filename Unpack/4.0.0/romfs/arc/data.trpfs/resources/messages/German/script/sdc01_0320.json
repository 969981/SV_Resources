    {
      "ordinal": 1,
      "label": "sdc01_0320_sister_01",
      "hash64": "4E9073DDA26A61EF",
      "text": "Jo! Sag mal, geht’s noch? Was soll das bitte?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
