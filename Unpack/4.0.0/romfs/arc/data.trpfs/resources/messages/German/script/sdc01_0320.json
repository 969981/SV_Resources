      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0320_brother_08",
      "hash64": "130C3018BDE87AF0",
      "text": "Dabei wisst ihr doch, wie wichtig mir der Oni ist![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
