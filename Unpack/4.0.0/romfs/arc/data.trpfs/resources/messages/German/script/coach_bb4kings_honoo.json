    },
    {
      "ordinal": 26,
      "label": "coach_bb4kings_honoo_sp03_01",
      "hash64": "4600625FCBEC51A9",
      "text": "Offenbar gehöre ich doch noch zu den Top Vier![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb4kings_honoo_sp03_select_01",
      "hash64": "23BA9267B1786E38",
      "text": "Das freut mich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_honoo_sp03_select_02",
      "hash64": "23BA9567B1787351",
      "text": "Wie kommt’s?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_honoo_sp03_02",
      "hash64": "46005F5FCBEC4C90",
      "text": "Mich auch... denke ich? Weiß nicht![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_bb4kings_honoo_sp03_02b",
      "hash64": "DEEF01C78286BF36",
      "text": "Tja, das weiß ich auch nicht so wirklich.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
