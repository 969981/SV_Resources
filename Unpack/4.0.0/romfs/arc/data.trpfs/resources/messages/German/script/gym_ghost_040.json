    },
    {
      "ordinal": 2,
      "label": "gym_ghost_040_receptionist_01",
      "hash64": "C76E71C6C3591663",
      "text": "Möchtest du Arenaleiterin Etta, die Rapperin mit\\nRhythmus in der Seele, herausfordern?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_ghost_040_receptionist_02",
      "hash64": "C76E72C6C3591816",
      "text": "Dann bringe ich dich jetzt zum Kampfplatz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_ghost_040_receptionist_03",
      "hash64": "C76E73C6C35919C9",
      "text": "Sag einfach Bescheid, sobald du bereit bist!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_ghost_040_receptionist_nobattle",
      "hash64": "D0A496BAB24C009D",
      "text": "Du brauchst mindestens zwei kampffähige\\nPokémon, um Etta herausfordern zu können.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_ghost_040_man_00",
      "hash64": "F4F1D404F7C6E265",
      "text": "Yo! Yo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_ghost_040_system_01",
      "hash64": "CDB670A9B4004749",
      "text": "Auf dem Kampfplatz gibt jemand einen\\nrhythmischen Sprechgesang zum Besten.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_ghost_040_man_01",
      "hash64": "F4F1D304F7C6E0B2",
      "text": "Unsern Rap-Battle heute wirste verlier’n! ♪\\nYo, yo, wir siegen, du endest auf allen vier’n. ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_ghost_040_man_02",
      "hash64": "F4F1D204F7C6DEFF",
      "text": "Spitz die Ohr’n für meinen Rap, Arenaleiterin! ♪\\nIch steh an der Spitze, ich bin der King! ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_ghost_040_system_02",
      "hash64": "CDB66DA9B4004230",
      "text": "Bumm, tss, chak! Bumm, tss, chak...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "gym_ghost_040_ghost_01",
      "hash64": "1436B0F9B1C26717",
      "text": "Der King willst du sein? Ha, du bist echt lahm! ♪\\nDeine Rhymes sind nichts als Kinderkram! ♪\\c\\nLoser wie du können gleich nach Hause geh’n. ♪\\nNo way, zieh Leine, auf Nimmerwiederseh’n! ♪[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 187,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_ghost_040_ghost_02",
      "hash64": "1436B1F9B1C268CA",
      "text": "Ich bin Etta, immer härter, immer besser. ♪\\nMeine Rhymes schlagen ein wie Dynamit, ♪\\r\\nmach dich bereit für den unschlagbaren Beat! ♪[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_ghost_040_ghost_03",
      "hash64": "1436B2F9B1C26A7D",
      "text": "Du hast echt ’ne Macke, kleiner Möchtegern! ♪\\nLern lieber rappen und halt dich von mir fern! ♪\\r\\nGeh heim, lass es sein, ich sag Nein. ♪[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_ghost_040_system_03",
      "hash64": "CDB66EA9B40043E3",
      "text": "Bumm, tss, chak! Bumm, tss, chak...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_ghost_040_man_03",
      "hash64": "F4F1D104F7C6DD4C",
      "text": "Verloren, neu geboren, doch es is’ nicht vorbei. ♪\\nNächstes Mal komm ich nachmittags um drei! ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "gym_ghost_040_ghost_04",
      "hash64": "1436ABF9B1C25E98",
      "text": "Warte, wo willste hin?! Ich bin noch nicht fertig!\\c\\nPah... Nachmittags um drei? Was sollte das denn?\\nDas ist mir echt zu viel Freestyle...[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_ghost_040_ghost_05",
      "hash64": "1436ACF9B1C2604B",
      "text": "Und schon ist es aus, was ein mieser Gag. ♪\\nGibt’s hier niemanden mit genügend Swag? ♪[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_ghost_040_ghost_06",
      "hash64": "1436ADF9B1C261FE",
      "text": "Hm...?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_ghost_040_ghost_07",
      "hash64": "1436AEF9B1C263B1",
      "text": "Yooo, du hast doch für mich die Show eröffnet!\\nBist du [VAR 0x1100(00FF,1614,0000)]mein nächster Gegnermeine nächste Gegnerin?\\c\\nWillst du meine Pokémon oder meine Rhymes\\nherausfordern?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1614",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 104,
