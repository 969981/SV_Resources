          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "gym_ghost_040_ghost_18",
      "hash64": "143A2DF9B1C57155",
      "text": "Die meisten kommen nur zum Flexen her,\\naber du hast es geschafft, mich so richtig\\r\\nzu flashen.\\c\\nDen Orden hast du dir absolut verdient, yo![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
