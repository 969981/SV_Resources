    },
    {
      "ordinal": 17,
      "label": "coach_paldea_rival_sp02_05",
      "hash64": "DFB33C48DD5BE15E",
      "text": "Ich bin erst mit sieben Jahren nach Paldea\\ngezogen, musst du wissen.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
