          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_paldea_rival_sp03_02",
      "hash64": "3618ED5078C57752",
      "text": "Außerdem sagen alle, dass DU der Champ\\ndieser Liga bist![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_paldea_rival_sp03_select_03",
      "hash64": "6EEFD71B8165C400",
      "text": "Da haben sie recht!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_paldea_rival_sp03_select_04",
      "hash64": "6EEFDE1B8165CFE5",
      "text": "Ich weiß nicht, wovon du redest...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_paldea_rival_sp03_03",
      "hash64": "3618EE5078C57905",
      "text": "Also stimmt’s wirklich! Hör mal, so was musst du\\nmir doch direkt erzählen!![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_paldea_rival_sp03_03b",
      "hash64": "B1D659BD378D4A05",
      "text": "Versuch nicht, dich rauszuwinden! Ich hab sogar\\nZeugen dafür![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_paldea_rival_sp03_04",
      "hash64": "3618E75078C56D20",
      "text": "Ooh, ich brenne richtig darauf, jetzt sofort gegen\\nden Champ der Blaubeer-Liga zu kämpfen...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_paldea_rival_sp03_05",
      "hash64": "3618E85078C56ED3",
      "text": "Aber vor allem bin ich einfach megastolz,\\ndass [VAR 0x1100(00FF,0D0B,0000)]mein Rivalemeine Rivalin sich dermaßen gut schlägt!![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0D0B",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
