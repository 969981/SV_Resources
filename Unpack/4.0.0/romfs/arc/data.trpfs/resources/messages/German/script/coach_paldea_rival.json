      "hash64": "F1D997FD29AB7FE9",
      "text": "So ist es viel greifbarer!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
