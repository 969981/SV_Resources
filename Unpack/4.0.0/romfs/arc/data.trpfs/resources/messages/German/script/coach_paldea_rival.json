      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_paldea_rival_sp03_01",
      "hash64": "3618EC5078C5759F",
      "text": "Dacht ich’s mir! Warum hast du das nicht sofort\\nerwähnt?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
