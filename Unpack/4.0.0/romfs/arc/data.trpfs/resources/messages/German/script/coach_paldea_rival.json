    },
    {
      "ordinal": 4,
      "label": "coach_paldea_rival_sp01_02",
      "hash64": "38E7FD6224AD0984",
      "text": "Der Lehrplan hier scheint voll und ganz auf\\nPokémon-Kämpfe ausgerichtet zu sein...\\c\\nDas heißt, ich kann mich SO RICHTIG\\naustoben, oder?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
