    {
      "ordinal": 1,
      "label": "sdc01_0000_ecology_01",
      "hash64": "5772A8E9CF9DFCD0",
      "text": "Hallo, [VAR 0x0100(0000)]! Ich bin’s, Jim!\\nWie geht’s, wie steht’s?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
