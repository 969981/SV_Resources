          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0000_select_01",
      "hash64": "DE4357C74FC0BE90",
      "text": "Hallo, Señor Jim!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc01_0000_select_02",
      "hash64": "DE435AC74FC0C3A9",
      "text": "Ist was passiert?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_0000_ecology_02",
      "hash64": "5772ABE9CF9E01E9",
      "text": "Entschuldige, dass ich dich einfach so anrufe,\\ndu bist sicher schwer beschäftigt...\\c\\nAber glaub mir, es lohnt sich, dass du den Anruf\\nangenommen hast![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 152,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0000_ecology_03",
      "hash64": "5772AAE9CF9E0036",
      "text": "Es ist nämlich so, dass unsere Akademie jedes\\nJahr zu dieser Zeit eine Exkursion veranstaltet.\\c\\nUnd zwar in Zusammenarbeit mit einer anderen\\nSchule.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0000_ecology_04",
      "hash64": "5772ADE9CF9E054F",
      "text": "Und ob du’s glaubst oder nicht – du wurdest\\nals [VAR 0x1100(00FF,0C0A,0000)]TeilnehmerTeilnehmerin ausgewählt![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0C0A",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0000_ecology_06",
      "hash64": "5772AFE9CF9E08B5",
      "text": "Dieses Jahr geht die Reise in die östlich gelegene\\n[VAR 0xFF00(0006)]Kitakami-Provinz[VAR 0xFF00(0000)]![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0000_ecology_07",
      "hash64": "5772AEE9CF9E0702",
      "text": "Da sie ziemlich weit weg liegt, ist die Anzahl der\\nTeilnehmer diesmal besonders beschränkt.\\c\\nDu hast also echt Glück, dabei zu sein![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0000_ecology_08",
      "hash64": "5772B1E9CF9E0C1B",
      "text": "Komm bitte in die [VAR 0xFF00(0006)]Eingangshalle[VAR 0xFF00(0000)] der Akademie,\\ndort erhältst du dann alle weiteren Details.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0000_ecology_09",
      "hash64": "5772B0E9CF9E0A68",
      "text": "Oh, und du wirst natürlich nicht zur Teilnahme\\ngezwungen, aber das ist wirklich eine einmalige\\r\\nGelegenheit. Also nur keine falsche Scheu![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0000_ecology_10",
      "hash64": "576F43E9CF9B1B5A",
      "text": "Na dann, wir sehen uns![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
