          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0040_bbteacher_10",
      "hash64": "EC50F68D853AEA2C",
      "text": "Könntest du dich schon mal nach Midoriya\\naufmachen und den Verwalter im Gemeindehaus\\r\\nvon unserer Ankunft unterrichten?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0040_bbteacher_11",
      "hash64": "EC50F78D853AEBDF",
      "text": "Und sag ihm bitte auch, dass wir jemanden\\ndabeihaben, dem es nicht so gut geht.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0040_select_01",
      "hash64": "0B5A1531CC6F91AC",
      "text": "Selbstverständlich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc01_0040_select_02",
      "hash64": "0B5A1831CC6F96C5",
      "text": "Wird gemacht!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc01_0040_bbteacher_12",
      "hash64": "EC50F88D853AED92",
      "text": "Wunderbar, danke dir! Ich kümmere mich derweil\\num unseren Patienten.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0040_student1_02",
      "hash64": "8EF4D27E10435217",
      "text": "Ich bin zum ersten Mal außerhalb von Paldea,\\nund... wow! Selbst die Luft riecht anders!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc01_0040_student2_02",
      "hash64": "3CE71099CB93CAA4",
      "text": "Hoffentlich geht es ihm bald wieder besser.\\nDie Busfahrt war aber auch unheimlich holprig...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc01_0040_student3_02",
      "hash64": "67658A8E822BEA41",
      "text": "Aaaah... Mein Kopf brummt auch ganz schön...\\nJetzt kann ich verstehen, wie sich Enton immer\\r\\nfühlen müssen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
