      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_b_08_ansewer_04a",
      "hash64": "ED6DD0B72B01577F",
      "text": "Er wird verdoppelt.",
