    {
      "ordinal": 0,
      "label": "s2_side01_0090_system_01",
      "hash64": "9D4CAE1632B00349",
      "text": "Nanu? Da ist etwas im Topf versteckt...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_side01_0090_system_02",
      "hash64": "9D4CAB1632AFFE30",
      "text": "Du findest eine Fernbedienung!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_side01_0080_friend_01",
      "hash64": "E9A59ED99AFB3197",
      "text": "Grrr! Sieht aus, als dürftest du entscheiden,\\nwas wir uns angucken.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
