    {
      "ordinal": 3,
      "label": "s2_side01_0080_brother_01",
      "hash64": "91D444A7ABA8EA9F",
      "text": "[VAR 0xBD06(0000)]Klasse, [VAR 0x0100(0000)]! Du würdest\\nsicher\\r\\n[VAR 0x1100(00FF,0405,0000)]eineneine\\r\\n[VAR 0x1100(00FF,0405,0000)]gutengute\\r\\n[VAR 0x1100(00FF,0A08,0000)]DetektivDetektivin abgeben![VAR 0x0114(0043)]",
