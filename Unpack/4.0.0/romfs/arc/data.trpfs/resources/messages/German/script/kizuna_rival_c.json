          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_rival_c_04",
      "hash64": "05FBEDD5E6CC85C1",
      "text": "Ich bin ihm noch mal in der Eingangshalle\\nbegegnet, aber... er wollte partout nicht gegen\\r\\nmich kämpfen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 106,
