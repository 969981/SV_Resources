      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_rival_c_select_02",
      "hash64": "AA608AC26FF60DC0",
      "text": "Gewinnen macht mehr Spaß...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_rival_c_07a",
      "hash64": "F790D2772D7ED58B",
      "text": "Sag ich ja! Keine Frage, niemand verliert gerne.\\nDoch auch aus einer Niederlage kann man sehr\\r\\nviel lernen.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_rival_c_07b",
      "hash64": "F790D3772D7ED73E",
      "text": "Versteh mich nicht falsch, ich gewinne natürlich\\nauch lieber als zu verlieren, aber solange man\\r\\nSpaß dabei hat...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
