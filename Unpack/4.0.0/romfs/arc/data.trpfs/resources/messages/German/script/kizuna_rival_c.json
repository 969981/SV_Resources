          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_rival_c_08",
      "hash64": "05FBE9D5E6CC7EF5",
      "text": "Hach ja... Pokémon-Kämpfe sind schon eine\\nSache für sich.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_rival_c_09",
      "hash64": "05FBE8D5E6CC7D42",
      "text": "Außerdem stör ich mich an dem Wörtchen\\n„Naturtalent“. Ich hab mir nämlich wirklich alles\\r\\nhart erarbeitet![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_rival_c_10",
      "hash64": "05F86BD5E6C97304",
      "text": "Und fürs Werfen von Pokébällen wurde mir ganz\\ngewiss kein Talent in die Wiege gelegt, darin bin\\r\\nich eine komplette Niete![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
