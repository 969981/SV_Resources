          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_rival_c_06",
      "hash64": "05FBEBD5E6CC825B",
      "text": "Ich versteh ihn nicht. Pokémon-Kämpfe machen\\ndoch selbst dann noch Spaß, wenn man mal den\\r\\nKürzeren zieht, oder?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
