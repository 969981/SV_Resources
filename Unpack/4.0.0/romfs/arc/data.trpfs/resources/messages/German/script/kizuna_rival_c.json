      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_rival_c_select_01",
      "hash64": "AA608DC26FF612D9",
      "text": "Ganz meine Meinung!",
      "flags": 0,
      "text_status": "DECODED",
