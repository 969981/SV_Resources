      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "common_0240_teacher_08",
      "hash64": "2494B256355700E3",
      "text": "Danke, dass du uns ein bisschen was über dich\\nverraten hast, [VAR 0x0100(0000)].\\c\\nIch bin Jim, der Biologielehrer der Akademie\\nund außerdem dein Klassenlehrer![VAR 0x0114(002A)]",
