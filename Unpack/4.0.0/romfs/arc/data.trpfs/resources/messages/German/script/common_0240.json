          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "common_0240_rival_02",
      "hash64": "04200C98BCE712F3",
      "text": "Du hast dich ja dazu entschlossen, an unsere\\nAkademie zu kommen, also...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
