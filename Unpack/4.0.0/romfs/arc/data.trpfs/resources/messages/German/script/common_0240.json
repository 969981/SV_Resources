    {
      "ordinal": 31,
      "label": "common_0240_rival_01",
      "hash64": "04200D98BCE714A6",
      "text": "Ich, hier! Bitte![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
