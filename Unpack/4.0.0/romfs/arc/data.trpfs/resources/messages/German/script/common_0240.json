      "label": "common_0240_teacher_09",
      "hash64": "2494B1563556FF30",
      "text": "Dein Platz ist dort in der zweiten Reihe.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
