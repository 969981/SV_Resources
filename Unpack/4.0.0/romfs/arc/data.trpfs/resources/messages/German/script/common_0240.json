      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "common_0240_rival_03a",
      "hash64": "E984D588FCA21B13",
      "text": "Ach, du sammelst gerne Pokémon! Gut, dass ich\\ndir die Pokédex-App eingerichtet habe! Hehe![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "common_0240_rival_03b",
      "hash64": "E984D688FCA21CC6",
      "text": "Das wirst du bestimmt, ganz sicher! Du und ich,\\nwir werden zusammen die Allerstärksten![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
