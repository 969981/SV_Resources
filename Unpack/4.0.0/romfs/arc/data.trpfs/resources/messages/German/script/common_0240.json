          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "common_0240_select_09",
      "hash64": "8B4D0DCBB8D73B22",
      "text": "Ich möchte den Pokédex vervollständigen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "common_0240_select_10",
      "hash64": "8B4990CBB8D430E4",
      "text": "Ich möchte [VAR 0x1100(00FF,1513,0000)]ein starker Trainereine starke Trainerin werden.",
