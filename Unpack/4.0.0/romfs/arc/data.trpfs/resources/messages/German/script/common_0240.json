          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "common_0240_rival_03",
      "hash64": "04200B98BCE71140",
      "text": "Was ist dein Ziel für die Zukunft?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
