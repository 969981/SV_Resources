    {
      "ordinal": 2,
      "label": "common_0240_teacher_01",
      "hash64": "2494B95635570CC8",
      "text": "Heute gibt es aufregende Neuigkeiten.\\nNaaa, seid ihr neugierig?[VAR 0x0114(002A)]",
