      "hash64": "EF85C997133C4B51",
      "text": "Na klar! Und wie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
