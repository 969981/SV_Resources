      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1513",
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "common_0240_select_11",
      "hash64": "8B4991CBB8D43297",
