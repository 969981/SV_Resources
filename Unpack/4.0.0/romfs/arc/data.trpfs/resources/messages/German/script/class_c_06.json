    {
      "ordinal": 29,
      "label": "class_c_06_history_21",
      "hash64": "2C9432E747558DAD",
      "text": "In den Bücherregalen im Erdgeschoss der\\nEingangshalle müsstet ihr allerdings ein\\r\\nExemplar finden.\\c\\nAlso schaut mal rein, wenn es euch interessiert.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
