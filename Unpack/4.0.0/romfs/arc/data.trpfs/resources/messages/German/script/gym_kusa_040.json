      ]
    },
    {
      "ordinal": 10,
      "label": "gym_kusa_040_kusa_04",
      "hash64": "C851624498B05538",
      "text": "Wahrlich avantgardistisch![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
