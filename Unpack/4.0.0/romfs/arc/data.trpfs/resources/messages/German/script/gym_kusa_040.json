    {
      "ordinal": 6,
      "label": "gym_kusa_040_kusa_01",
      "hash64": "C851674498B05DB7",
      "text": "Respekt, dass du es bis hierhin geschafft hast![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
