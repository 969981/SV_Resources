          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_paldea4kings_zimen_sp01_00",
      "hash64": "743CA50901C57281",
      "text": "Ich hätte nicht gedacht, dass du mich einladen\\nwürdest, [VAR 0x0100(0000)].[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_paldea4kings_zimen_sp01_01",
      "hash64": "743CA40901C570CE",
      "text": "Hast du mich etwa so sehr vermisst?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_paldea4kings_zimen_sp01_select_01",
      "hash64": "D4717B8263D1451D",
      "text": "Ja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_paldea4kings_zimen_sp01_select_02",
      "hash64": "D471788263D14004",
      "text": "Ähm...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea4kings_zimen_sp01_03",
      "hash64": "743CA20901C56D68",
      "text": "Schön, dass du so ehrlich bist. Das gefällt mir![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_paldea4kings_zimen_sp01_03b",
      "hash64": "48745F4E027847FE",
      "text": "Bahaha! Du hättest dich ruhig auf den Witz\\neinlassen können![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea4kings_zimen_sp01_04",
      "hash64": "743CA90901C5794D",
      "text": "Dieser Akademie täte es gut, wenn hier mal\\njemand richtig für Stimmung sorgen würde![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea4kings_zimen_sp01_05",
      "hash64": "743CA80901C5779A",
      "text": "Das ist meine Spezialität, also überlass das\\nruhig mir.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_paldea4kings_zimen_sp02_00",
      "hash64": "78B3E31FD517400E",
      "text": "Neulich war ich als Bodyguard für den obersten\\nBoss hier.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_paldea4kings_zimen_sp02_01",
      "hash64": "78B3E41FD51741C1",
      "text": "Nach außen wirkt sie zwar perfekt, aber sie kann\\nziemlich verpeilt sein. Deswegen muss ich immer\\r\\nein Auge auf sie haben.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_paldea4kings_zimen_sp02_select_01",
      "hash64": "416A704DF61BF9C0",
      "text": "Das hätte ich nicht gedacht!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "coach_paldea4kings_zimen_sp02_select_02",
      "hash64": "416A734DF61BFED9",
      "text": "Ihr seid ein gutes Team!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_paldea4kings_zimen_sp02_02",
      "hash64": "78B3E11FD5173CA8",
      "text": "Weißt du nicht mehr? Sie hatte doch vergessen,\\ndieser Brianna so ’ne komische Scheibe zu geben.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_paldea4kings_zimen_sp02_02b",
      "hash64": "30E45317167C4B3E",
      "text": "Das stimmt! Wir kennen uns auch schon ziemlich\\nlange.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_paldea4kings_zimen_sp02_03",
      "hash64": "78B3E21FD5173E5B",
      "text": "Manchmal kommt sie zur Arbeit, ohne zu merken,\\ndass sich ihr Lumispross total in ihren Haaren\\r\\nverheddert hat...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_paldea4kings_zimen_sp02_04",
      "hash64": "78B3E71FD51746DA",
      "text": "Ah! Sag ihr aber nicht, dass ich dir das erzählt\\nhab! Sonst krieg ich voll Ärger mit ihr.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_paldea4kings_zimen_sp02_05",
      "hash64": "78B3E81FD517488D",
      "text": "Das bleibt unser Geheimnis, okay?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_paldea4kings_zimen_sp03_00",
      "hash64": "770B991AADACD51F",
      "text": "Es macht zwar Spaß, den Schülern hier was\\nbeizubringen, aber es ist schon hart, ständig\\r\\nmeine grauen Zellen anstrengen zu müssen.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_paldea4kings_zimen_sp03_01",
      "hash64": "770B981AADACD36C",
      "text": "Bei der Arbeit schalte ich nämlich in einen extra\\nseriösen Modus um, musst du wissen.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_paldea4kings_zimen_sp03_02",
      "hash64": "770B9B1AADACD885",
      "text": "Dann setz ich sogar ’ne Brille auf!\\nDie Gläser haben allerdings keine Stärke.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_paldea4kings_zimen_sp03_03",
      "hash64": "770B9A1AADACD6D2",
      "text": "Ach, warum erkläre ich das überhaupt? Du hast\\nmich ja bei der mündlichen Prüfung so erlebt.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_paldea4kings_zimen_sp03_04",
      "hash64": "770B951AADACCE53",
      "text": "Wen magst du lieber? Die normale Cay oder\\ndie seriöse Cay?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea4kings_zimen_sp03_select_01",
      "hash64": "6813464A803E76FB",
      "text": "Die normale Cay",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "coach_paldea4kings_zimen_sp03_select_02",
      "hash64": "6813474A803E78AE",
      "text": "Die seriöse Cay",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "coach_paldea4kings_zimen_sp03_05",
      "hash64": "770B941AADACCCA0",
      "text": "Ach echt?! Dann muss ich mich ja nicht so\\nanstrengen und kann ganz ich selbst sein,\\r\\nwenn wir uns sehen![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 106,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_paldea4kings_zimen_sp03_05b",
      "hash64": "F5796B551C9FEDA6",
      "text": "Ach echt?! Wenn das so ist, sollte ich mich wohl\\nbemühen, dir mit Höflichkeit gegenüberzutreten,\\r\\nwenn wir uns begegnen?\\c\\nBahaha, das kannst du dir abschminken![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 164,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_paldea4kings_zimen_sp03_06",
      "hash64": "770B971AADACD1B9",
      "text": "Ich werde deine Antwort in Betracht ziehen,\\nwenn ich drüber nachdenke, in welche Richtung\\r\\nich mich entwickeln will.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_paldea4kings_zimen_trade_01_00",
      "hash64": "535B9E15484E2CB9",
      "text": "In letzter Zeit unterhalten wir zwei uns ganz\\nschön oft![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_paldea4kings_zimen_trade_01_01",
      "hash64": "535B9D15484E2B06",
      "text": "Wir kennen uns jetzt besser und wissen, dass wir\\ngut miteinander klarkommen.\\c\\nDas sollten wir mit irgendwas feiern![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_paldea4kings_zimen_trade_01_02",
      "hash64": "535B9C15484E2953",
      "text": "Ich hab’s! Lass uns Pokémon tauschen![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_paldea4kings_zimen_trade_01_03",
      "hash64": "535B9B15484E27A0",
      "text": "So gefällt mir das! Dann ist es beschlossen.\\nIch geb dir ein Felino. Was bekomm ich von dir?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_paldea4kings_zimen_trade_01_04",
      "hash64": "535BA215484E3385",
      "text": "Ein [VAR 0x0101(0001)]! Cool!\\nIch werde mich gewissenhaft um es kümmern.\\c\\nBehalt das Datum unseres Tauschs auch immer\\nschön in Erinnerung, klar?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
