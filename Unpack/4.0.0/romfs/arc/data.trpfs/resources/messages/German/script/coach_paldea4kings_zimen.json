    {
      "ordinal": 1,
      "label": "coach_paldea4kings_zimen_first_01",
      "hash64": "F0E7C7F03A2BD0FC",
      "text": "Hallo auch! Ich bin Cay!\\nAuf gute Zusammenarbeit![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
