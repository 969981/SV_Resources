  "entries": [
    {
      "ordinal": 0,
      "label": "gym_mizu_020_receptionist_01",
      "hash64": "5A1F61160267AF3F",
      "text": "Bestimmt ist Kombu schon ganz verzweifelt,\\nweil er seine Geldbörse nicht findet...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "gym_mizu_020_receptionist_02",
      "hash64": "5A1F62160267B0F2",
      "text": "Bitte bring sie ihm nach [VAR 0xFF00(0006)]Puerto Marinedo[VAR 0xFF00(0000)]!\\nDie Stadt liegt jenseits der Wüste.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_mizu_020_receptionist_03",
      "hash64": "5A1F63160267B2A5",
      "text": "[EMPTY 67]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_mizu_020_trainer_01a",
      "hash64": "033215E8AA805C80",
      "text": "Was, du bist schon wieder hier? Zieh Leine!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mizu_020_mizu_26",
      "hash64": "93117A305CF60F00",
      "text": "Mein lieber Scholli! Sie ist weg![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_mizu_020_mizu_27",
      "hash64": "93117B305CF610B3",
      "text": "Meine Geldbörse ist weg!!![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_mizu_020_mizu_28",
      "hash64": "931188305CF626CA",
      "text": "So wird mir das Angebot des Tages sicher vor\\nder Nase weggeschnappt...[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_mizu_020_mizu_29",
      "hash64": "931189305CF6287D",
      "text": "*schnüff*[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mizu_020_trainer_01b",
      "hash64": "033218E8AA806199",
      "text": "Chef, beruhigen Sie sich! Ich mache mich sofort\\nauf die Suche!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_020_trainer_02",
      "hash64": "0B79F51B0482ECC8",
      "text": "Was gibt’s? Falls du was von Chef Kombu willst,\\nder ist gerade beschäftigt.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_020_trainer_03",
      "hash64": "0B79F61B0482EE7B",
      "text": "Als sein bester Lehrling kann ich nicht zulassen,\\ndass er gestört wird – egal, wer nach ihm fragt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_020_trainer_04",
      "hash64": "0B79FB1B0482F6FA",
      "text": "Oder willst du etwa behaupten, dass dein\\nAnliegen wichtig genug ist, um uns damit\\r\\nzu belästigen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_020_select_a",
      "hash64": "3ECD48AC469CDCAC",
      "text": "Ja, genau!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_020_select_b",
      "hash64": "3ECD4BAC469CE1C5",
      "text": "Nein, eigentlich nicht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_020_trainer_05",
      "hash64": "0B79FC1B0482F8AD",
      "text": "Dann lass uns jetzt in Ruhe, wir haben zu tun!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_020_trainer_06",
      "hash64": "0B79F91B0482F394",
      "text": "Was für ein störrisches Kind! Na schön, dann hol\\nich mir eben etwas Kleingeld von dir!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_020_trainer_07",
      "hash64": "0B79FA1B0482F547",
      "text": "Wie konnte das passieren?! Jetzt bin ich auch\\nnoch meinen Notgroschen los...!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "gym_mizu_020_mizu_01",
      "hash64": "930AF5305CF0C153",
      "text": "Menschenskinder...! Was hat denn der Krach hier\\nzu bedeuten...?![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_mizu_020_trainer_08",
      "hash64": "0B79EF1B0482E296",
      "text": "Ch-Chef Kombu! D-Dieses Kind hier...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "gym_mizu_020_mizu_02",
      "hash64": "930AF6305CF0C306",
      "text": "[VAR 0x1100(00FF,0B09,0000)]Ein KundeEine Kundin für diesen mittellosen Mann,\\nder seine Geldbörse verloren hat?\\c\\nWas gibt es denn...?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0B09",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_mizu_020_select_01",
      "hash64": "54C29DBBFD75281A",
      "text": "Ihre Geldbörse!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "gym_mizu_020_select_02",
      "hash64": "54C29CBBFD752667",
      "text": "Sie haben das hier vergessen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "gym_mizu_020_system_01",
      "hash64": "C22350BAFFC104CD",
      "text": "Du übergibst Kombus Geldbörse!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "gym_mizu_020_mizu_03",
      "hash64": "930AF7305CF0C4B9",
      "text": "Na, so was!! Ist das etwa meine Geldbörse?![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_mizu_020_mizu_04",
      "hash64": "930AF8305CF0C66C",
      "text": "Was meinst du? Jemand vom Empfang der Arena\\nhat dich gebeten, sie mir zu bringen?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_mizu_020_mizu_05",
      "hash64": "930AF9305CF0C81F",
      "text": "Bwahaha! Du bist meine Rettung! Danke, dass du\\nextra vorbeigekommen bist![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_mizu_020_mizu_06",
      "hash64": "930AFA305CF0C9D2",
      "text": "Tut mir leid, dass dir mein Lehrling eben so an\\nden Kragen gegangen ist![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "gym_mizu_020_mizu_07",
      "hash64": "930AFB305CF0CB85",
      "text": "Weißt du, Puerto Marinedo ist berühmt für seine\\n[VAR 0xFF00(0006)]Auktionen[VAR 0xFF00(0000)], und dieses Mal wird etwas versteigert,\\r\\ndas ich unbedingt in die Finger bekommen will![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 155,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "gym_mizu_020_mizu_08",
      "hash64": "930AFC305CF0CD38",
      "text": "Deswegen waren wir beide etwas angespannt.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "gym_mizu_020_shop_01",
      "hash64": "4C49FA89878568CE",
      "text": "Nur zu, kommen Sie näher! Das hier ist unser\\nletztes Angebot für heute!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "gym_mizu_020_mizu_09",
      "hash64": "930AFD305CF0CEEB",
      "text": "Hm...?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "gym_mizu_020_shop_02",
      "hash64": "4C49F9898785671B",
      "text": "Unser heutiges Highlight ist das legendäre\\nSeegras aus der Hoenn-Region! Na?\\r\\nWer bietet zuerst?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "gym_mizu_020_mizu_10",
      "hash64": "930E7A305CF3D929",
      "text": "M-Mein lieber Scholli![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "gym_mizu_020_mizu_11",
      "hash64": "930E79305CF3D776",
      "text": "Ich brauche es nur anzusehen, um zu erkennen,\\ndass dieses Seegras voller Nährstoffe steckt![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "gym_mizu_020_mizu_12",
      "hash64": "930E78305CF3D5C3",
      "text": "Dieser blendende Glanz, der von ihm ausgeht,\\nwenn es Licht reflektiert![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_mizu_020_mizu_13",
      "hash64": "930E77305CF3D410",
      "text": "Es strotzt nur so vor Frische! Und erst dieser\\naromatische Küstenduft![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "gym_mizu_020_mizu_14",
      "hash64": "930E7E305CF3DFF5",
      "text": "Ich muss es einfach haben!!![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "gym_mizu_020_mizu_15",
      "hash64": "930E7D305CF3DE42",
      "text": "He, du! Wenn du dich an der Garrafosa-Arena\\nversuchen willst, ist Finesse sehr wichtig![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "gym_mizu_020_mizu_16",
      "hash64": "930E7C305CF3DC8F",
      "text": "Und das ist die perfekte Gelegenheit, dich darin\\nzu üben! Geh und ersteigere diese Zutat für mich![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "gym_mizu_020_select_03",
      "hash64": "54C29BBBFD7524B4",
      "text": "Und wie genau geht das?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "gym_mizu_020_select_04",
      "hash64": "54C29ABBFD752301",
      "text": "Ich gebe mein Bestes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "gym_mizu_020_mizu_17",
      "hash64": "930E7B305CF3DADC",
      "text": "Bei einer Auktion liefert man sich quasi einen\\nWettkampf mit den anderen Gästen, um ein\\r\\nProdukt zu erstehen.\\c\\nWer sein Geld am besten im Blick hat und das\\nhöchste Gebot äußert, kann sich das Objekt\\r\\nder Begierde angeln![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
