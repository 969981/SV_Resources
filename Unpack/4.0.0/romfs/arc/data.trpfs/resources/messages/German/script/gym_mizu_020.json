          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "gym_mizu_020_mizu_18",
      "hash64": "930E82305CF3E6C1",
      "text": "Bwahaha! In deinem Alter kennst du dich schon\\nmit Auktionen aus?! Du bist echt was Besonderes![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "gym_mizu_020_mizu_19",
      "hash64": "930E81305CF3E50E",
      "text": "Hier, mit diesem Geld solltest du für den Kampf\\ngerüstet sein. Stell dich schlau an und ersteigere\\r\\ndas Seegras für mich! Volle Kraft voraus![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "gym_mizu_020_seri_01",
      "hash64": "E9E0F72565D1DA3D",
      "text": "Also dann, es geht los!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "gym_mizu_020_seri_02",
      "hash64": "E9E0F42565D1D524",
      "text": "Das Startgebot für das legendäre Seegras aus der\\nHoenn-Region liegt bei [VAR 0x0205(0001,002E)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
