    {
      "ordinal": 58,
      "label": "gym_mizu_020_seri_04a",
      "hash64": "3B0D548C03879DED",
      "text": "[VAR 0x0205(0001,002E)]  zum Ersten... zum Zweiten... uuund\\nzum Dritten! Verkauft!\\c\\nDer junge Herr hier ist der Meistbietende!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
