            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "champ_0045_dragon_02",
      "hash64": "7ADAD6B0E91C4D9F",
      "text": "Nemila hat erwähnt, dass es einen\\nvielversprechenden Neuling gibt.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0045_dragon_03",
      "hash64": "7ADAD5B0E91C4BEC",
      "text": "Ach, entschuldige bitte, dass ich dich einfach so\\nanspreche. Ich sollte mich erst mal vorstellen.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0045_dragon_04",
      "hash64": "7ADAD4B0E91C4A39",
      "text": "Mein Name lautet Sinius. Ich bin ein Mitglied der\\nTop Vier der Pokémon-Liga und unterrichte\\r\\nKunst an der Akademie.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0045_dragon_05",
      "hash64": "7ADAD3B0E91C4886",
      "text": "Ich würde wirklich gern mehr über deine\\nBeweggründe erfahren, [VAR 0x0100(0000)].\\c\\nWas bewegt dich dazu, Arenaorden zu sammeln?\\nWarum möchtest du Champ werden?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0045_select_01",
      "hash64": "2E5C21729333EC2B",
      "text": "Ich möchte stärker werden.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "champ_0045_select_02",
      "hash64": "2E5C22729333EDDE",
      "text": "Eine Freundin hat es vorgeschlagen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "champ_0045_select_03",
      "hash64": "2E5C23729333EF91",
      "text": "Ich möchte meinen Schatz finden.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "champ_0045_select_04",
      "hash64": "2E5C24729333F144",
      "text": "Einfach nur so.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "champ_0045_dragon_06",
      "hash64": "7ADAD2B0E91C46D3",
      "text": "Danke für deine Antwort.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0045_dragon_07",
      "hash64": "7ADAD1B0E91C4520",
      "text": "Auf diese Frage gibt es keine richtige oder\\nfalsche Antwort.\\c\\nWie heißt es doch so schön? Alle Wege führen\\nzum Schlund von Paldea.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0045_dragon_08",
      "hash64": "7ADAE0B0E91C5E9D",
      "text": "Wusstest du, dass deine Freundin Nemila der\\njüngste Champ in der Geschichte Paldeas ist?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0045_dragon_09",
      "hash64": "7ADADFB0E91C5CEA",
      "text": "Möglicherweise verbirgt sich in dir das gleiche\\nPotenzial wie in ihr.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0045_dragon_10",
      "hash64": "7AD752B0E919377C",
      "text": "Wenn du nach dem Champ-Rang strebst,\\nwirst du mir früher oder später im Kampf\\r\\ngegenüberstehen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0045_dragon_11",
      "hash64": "7AD753B0E919392F",
      "text": "Ich kann dir nur empfehlen, lang und hart zu\\ntrainieren. Dann hast du selbst bei einer\\r\\nNiederlage nichts zu bereuen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "champ_0045_dragon_12",
      "hash64": "7AD754B0E9193AE2",
      "text": "Oh, und du bist natürlich auch jederzeit in\\nmeinem Kunstunterricht willkommen![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    }
  ]
