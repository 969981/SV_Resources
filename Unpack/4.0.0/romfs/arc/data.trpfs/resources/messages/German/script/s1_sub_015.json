        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_015_select_01",
      "hash64": "D3AA8208D3BA4BC0",
      "text": "10.000  spenden",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s1_sub_015_select_02",
      "hash64": "D3AA8508D3BA50D9",
      "text": "100.000  spenden",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "s1_sub_015_select_03",
      "hash64": "D3AA8408D3BA4F26",
      "text": "Vielleicht beim nächsten Mal",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s1_sub_015_caretaker_17",
      "hash64": "AA174AEB935D3067",
      "text": "Du willst also eine Spende in Höhe von\\n10.000  einreichen?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_sub_015_caretaker_18",
      "hash64": "AA173FEB935D1DB6",
      "text": "Potz Blitz! Du willst also eine Spende in Höhe\\nvon unglaublichen 100.000  einreichen?![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_015_caretaker_19",
      "hash64": "AA1740EB935D1F69",
      "text": "Zur Erinnerung: Unser Ziel sind 1.000.000 !\\nDu weißt, wo du mich finden kannst.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_015_caretaker_20",
      "hash64": "AA13C1EB935A11C5",
      "text": "Leider scheinst du nicht genug Geld für so eine\\nSpende dabeizuhaben...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_sub_015_caretaker_21",
      "hash64": "AA13C0EB935A1012",
      "text": "Herzlichen Dank! Nimm das hier, damit du nicht\\nmit leeren Händen gehst.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_sub_015_caretaker_22",
      "hash64": "AA13BFEB935A0E5F",
      "text": "Wir haben jetzt [VAR 0x0206(0001,002E)]  gesammelt. Unser\\nZiel von 1.000.000  rückt näher und näher![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "0206",
          "args_hex": [
            "0001",
            "002E"
          ]
        },
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_015_caretaker_23",
      "hash64": "AA13BEEB935A0CAC",
      "text": "W-Wenn mich nicht alles täuscht...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_sub_015_caretaker_38",
      "hash64": "AA1043EB935705D4",
      "text": "Ja! Mit dieser Spende haben wir tatsächlich\\nunser Ziel von 1.000.000  erreicht![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_sub_015_caretaker_24",
      "hash64": "AA13BDEB935A0AF9",
      "text": "Das heißt, wir können die Gefährten-Statuen\\nendlich restaurieren![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_sub_015_caretaker_25",
      "hash64": "AA13BCEB935A0946",
      "text": "Weißt du was? Ich rufe jetzt sofort unseren\\nSpezialisten dafür an... *biep* *bup* *biep*[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s1_sub_015_caretaker_26",
      "hash64": "AA13BBEB935A0793",
      "text": "Ja, hallo? Ich bin’s. Wir haben das nötige Geld\\nfür die Restaurierung von Du-weißt-schon-was\\r\\nzusammen. Ihr könnt mit den Arbeiten beginnen![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s1_sub_015_caretaker_27",
      "hash64": "AA13BAEB935A05E0",
      "text": "So, die Restaurationsarbeiten scheinen\\nabgeschlossen zu sein!\\c\\nWarum überzeugen wir uns nicht gleich selbst\\nvon dem Ergebnis?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 1,
          "code_hex": "BE01",
