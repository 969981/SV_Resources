            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_015_caretaker_03",
      "hash64": "AA1A4EEB935F6D0A",
      "text": "Nochmals vielen Dank für deine Hilfe bei der\\nSache mit Ogerpon.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_015_caretaker_04",
      "hash64": "AA1A49EB935F648B",
      "text": "Wer hätte gedacht, dass die drei Gefährten in\\nWahrheit die Übeltäter waren?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_015_caretaker_05",
      "hash64": "AA1A48EB935F62D8",
      "text": "Um ein Haar hätten wir wieder eine Lüge an die\\nnächste Generation weitergegeben.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_015_caretaker_06",
      "hash64": "AA1A4BEB935F67F1",
      "text": "Apropos...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_015_caretaker_07",
      "hash64": "AA1A4AEB935F663E",
      "text": "Mir ist klar, dass die drei Gefährten diese Ehre\\neigentlich nicht verdient haben, aber...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_015_caretaker_08",
      "hash64": "AA1A45EB935F5DBF",
      "text": "Erinnerst du dich an ihre Statuen auf dem\\nGefährten-Platz, die zerstört wurden, als die\\r\\ndrei wieder zum Leben erwachten?\\c\\nIch fände es sehr schade, die Statuen in diesem\\nZustand zu lassen, du nicht auch?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 208,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_015_caretaker_09",
      "hash64": "AA1A44EB935F5C0C",
      "text": "Genau, genau! An der Akademie scheinen sie\\neuch gut zu erziehen.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_015_caretaker_10",
      "hash64": "AA1747EB935D2B4E",
      "text": "Du warst doch dabei, als die Statuen zerstört\\nwurden, oder?\\c\\nDann müsstest du wissen, was für ein trauriger\\nAnblick sie jetzt sind![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_015_caretaker_11",
      "hash64": "AA1748EB935D2D01",
      "text": "Die Gefährten mögen böse gewesen sein, aber\\nihre niedlichen Statuen haben so viele Tourist--\\r\\nIch meine, die Statuen trifft doch keine Schuld![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_015_caretaker_12",
      "hash64": "AA1745EB935D27E8",
      "text": "Deshalb möchte ich eine [VAR 0xFF00(0006)]Spendensammlung[VAR 0xFF00(0000)] für\\ndie Restaurierung unserer geliebten Statuen ins\\r\\nLeben rufen![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_015_caretaker_13",
      "hash64": "AA1746EB935D299B",
      "text": "Ich nehme Spenden ab 10.000  entgegen und\\ndas Ziel liegt bei 1.000.000 ![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_015_caretaker_14",
      "hash64": "AA174BEB935D321A",
      "text": "Aber von [VAR 0x1100(00FF,0F0D,0000)]einem Schülereiner Schülerin kann ich natürlich\\nkein Geld verlangen...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0F0D",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_015_caretaker_15",
      "hash64": "AA174CEB935D33CD",
      "text": "Wärst du so gut, deine Eltern und Lehrer so\\nunaufdringlich wie möglich – aber so aufdringlich\\r\\nwie nötig – um eine Spende zu bitten?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_015_caretaker_16",
      "hash64": "AA1749EB935D2EB4",
      "text": "[VAR 0xBD06(0000)]Bisher haben wir [VAR 0x0206(0001,002E)]  an Spenden\\nfür\\r\\nunsere\\r\\ngeliebten\\r\\nStatuen\\r\\ngesammelt.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
