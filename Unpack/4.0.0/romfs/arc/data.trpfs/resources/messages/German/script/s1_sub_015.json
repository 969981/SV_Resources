    {
      "ordinal": 1,
      "label": "s1_sub_015_caretaker_02",
      "hash64": "AA1A4FEB935F6EBD",
      "text": "Ah, [VAR 0x0100(0000)]! Guten Abend![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
