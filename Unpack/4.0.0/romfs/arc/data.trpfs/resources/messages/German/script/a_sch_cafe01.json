    {
      "ordinal": 5,
      "label": "a_sch_cafe01_eve14",
      "hash64": "1B919830F6E78298",
      "text": "Sandwiches schmecken auch mit Früchten lecker!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
