        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0300_sister_16",
      "hash64": "0E4D13C22ADFF019",
      "text": "Aber... was wollen Sie hier?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
