    },
    {
      "ordinal": 1,
      "label": "champ_0200_ground_02",
      "hash64": "31D7E31AA830905A",
      "text": "Die mündliche Prüfung ist vorbei.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
