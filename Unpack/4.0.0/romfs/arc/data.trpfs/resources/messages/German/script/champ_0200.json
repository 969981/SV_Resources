          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0200_ground_03",
      "hash64": "31D7E41AA830920D",
      "text": "Und, wer hätt’s gedacht, ich darf dir gratulieren,\\n[VAR 0x0100(0000)]![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0200_ground_04",
      "hash64": "31D7DD1AA8308628",
      "text": "Du hast den ersten Teil der Champ-Prüfung\\nmit Bravour bestanden![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0200_ground_05a",
      "hash64": "E256214BCA76A10E",
      "text": "Und das auch noch gleich beim ersten Versuch!\\nIch glaub, das hat seit Nemila keiner mehr\\r\\ngeschafft.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0200_ground_05b",
      "hash64": "E256204BCA769F5B",
      "text": "Eigentlich hätte ich gedacht, du würdest es\\ngleich beim ersten Mal schaffen...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0200_ground_06",
      "hash64": "31D7DF1AA830898E",
      "text": "Aber egal, Zeit zum Grübeln haben wir auch\\nspäter noch. Auf zur nächsten Prüfung![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0200_ground_07",
      "hash64": "31D7E01AA8308B41",
      "text": "Dabei stehen dir Pokémon-Kämpfe gegen die\\nTop Vier bevor.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0200_ground_08",
      "hash64": "31D7D91AA8307F5C",
      "text": "Deshalb nennen wir diesen Teil auch...\\ndie praktische Prüfung![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0200_ground_09",
      "hash64": "31D7DA1AA830810F",
      "text": "Ich weiß, kein besonders einfallsreicher Name...\\nAber hey, er erfüllt seinen Zweck![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0200_ground_10",
      "hash64": "31DAE71AA832CCFD",
      "text": "Du wirst gegen vier ausgewählte Trainer der\\nPokémon-Liga antreten, und zwar hintereinander.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0200_ground_11",
      "hash64": "31DAE61AA832CB4A",
      "text": "Das wird kein Kinderspiel, also sieh zu,\\ndass du dich gut vorbereitest!\\c\\nWenn du so weit bist, geh einfach durch die Tür\\nhinter mir.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0200_ground_12",
      "hash64": "31DAE51AA832C997",
      "text": "Wenn du dich gut auf die praktische Prüfung\\nvorbereitet fühlst, geh durch die Tür hinter mir.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
