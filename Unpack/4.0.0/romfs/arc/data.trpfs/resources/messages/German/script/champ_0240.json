          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0240_fly_03",
      "hash64": "5AFD12EB25E565BB",
      "text": "In meiner Arena verwende ich Pokémon vom Typ\\nNormal. Die passen gut zu meiner Persönlichkeit.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0240_fly_04",
      "hash64": "5AFD17EB25E56E3A",
      "text": "Leider hat meine Chefin mich dazu verdonnert,\\nhier einen anderen Typ einzusetzen...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0240_fly_05",
      "hash64": "5AFD18EB25E56FED",
      "text": "Beschwerden kannst du daher gleich an den\\nTop-Champ richten.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0240_fly_06",
      "hash64": "5AFD15EB25E56AD4",
      "text": "Also gut, Dienstbeginn. Fangen wir gleich an.\\nDie Stechuhr verzeiht keine Trödelei.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0240_fly_07",
      "hash64": "5AFD16EB25E56C87",
      "text": "Du bist kaum wiederzuerkennen. Kein Wunder,\\ndass der Top-Champ dich mag.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
