      "label": "champ_0240_fly_10",
      "hash64": "5B0099EB25E880F7",
      "text": "Hm, er lässt auf sich warten.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
