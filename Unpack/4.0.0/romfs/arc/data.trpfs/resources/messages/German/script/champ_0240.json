    {
      "ordinal": 0,
      "label": "champ_0240_system_01",
      "hash64": "282D15851D1DCCB9",
      "text": "Bist du bereit, gegen Aoki von den Top Vier\\nanzutreten?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "champ_0240_fly_01",
      "hash64": "5AFD14EB25E56921",
      "text": "Ach, du schon wieder?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
