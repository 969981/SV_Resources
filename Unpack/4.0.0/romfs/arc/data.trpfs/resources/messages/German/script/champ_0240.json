      "ordinal": 11,
      "label": "champ_0240_ground_01",
      "hash64": "7A09E7C76116B39B",
      "text": "Ähm... Ich glaub, er hat dich nicht gehört...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
