      "label": "champ_0240_fly_09",
      "hash64": "5AFD0CEB25E55B89",
      "text": "Das ist dein Stichwort, Sinius...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
