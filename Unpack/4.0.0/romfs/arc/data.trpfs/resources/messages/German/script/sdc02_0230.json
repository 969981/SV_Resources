          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "sdc02_0230_bbteacher_18",
      "hash64": "FA302AC9DB9BF556",
      "text": "Das ist natürlich rein freiwillig, aber es wäre eine\\ngroße Erleichterung für mich, wenn ihr mitkämt.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "sdc02_0230_bbteacher_19",
      "hash64": "FA302BC9DB9BF709",
      "text": "Was meint ihr? Wollen wir gemeinsam Zone Null\\nerkunden?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "sdc02_0230_select_05",
      "hash64": "93842D741EF6945E",
      "text": "Ich bin dabei!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "sdc02_0230_select_06",
      "hash64": "93842C741EF692AB",
      "text": "Ich weiß nicht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "sdc02_0230_chairman_21",
      "hash64": "7AA1226FC1E3D77D",
      "text": "Ich habe nichts anderes von dir erwartet,\\nChamp [VAR 0x0100(0000)]![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "sdc02_0230_chairman_22",
      "hash64": "7AA11F6FC1E3D264",
      "text": "Da du Zone Null bereits einmal erkundet hast,\\nbitte ich dich inständig, sie zu begleiten,\\r\\nChamp [VAR 0x0100(0000)].[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "sdc02_0230_sister_04",
      "hash64": "645DEC9FA07ED84D",
      "text": "Also ich... geh mit, denk ich.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "sdc02_0230_bbteacher_20",
      "hash64": "FA2CACC9DB98E965",
      "text": "Danke, dass du dich mir wie immer anschließt.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "sdc02_0230_dragonbb_04",
      "hash64": "907620C937B44F70",
      "text": "Sorry, aber ich passe.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "sdc02_0230_dragonbb_05",
      "hash64": "907621C937B45123",
      "text": "Die Liga-AG is’ grad voll in Aufruhr. Da kann ich\\nmich nich’ so einfach verdünnisieren.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "sdc02_0230_sister_05",
      "hash64": "645DEB9FA07ED69A",
      "text": "Ja, klaaar. Hat sicher nichts damit zu tun,\\ndass du einfach nur zu faul dafür bist, hm?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "sdc02_0230_dragonbb_06",
      "hash64": "907622C937B452D6",
      "text": "Hehehe. Du hast mich durchschaut.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "sdc02_0230_dragonbb_07",
      "hash64": "907623C937B45489",
      "text": "Aber es würde mich interessieren, was unser\\nEx-Champ vorhat.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "sdc02_0230_brother_03",
      "hash64": "179B38E7C9CE370E",
      "text": "...Ich geh auch mit.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "sdc02_0230_brother_04",
      "hash64": "179B3BE7C9CE3C27",
      "text": "Wenn es dort ein Legendäres Pokémon gibt...\\nwill ich es treffen... und fangen.\\r\\nDiesmal wirklich...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
