          "offset_units": 42,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc02_0230_chairman_07",
      "hash64": "7A9A9C6FC1DE881D",
      "text": "Ms Brianna, dürfte ich die Erklärung der Details\\nübernehmen?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc02_0230_bbteacher_16",
      "hash64": "FA3034C9DB9C0654",
      "text": "Selbstverständlich![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc02_0230_chairman_08",
      "hash64": "7A9A8D6FC1DE6EA0",
      "text": "Erst einmal möchte ich mich vorstellen.\\c\\nMein Name ist Sagaria. Ich bin die Präsidentin\\nder Pokémon-Liga in Paldea.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc02_0230_chairman_09",
      "hash64": "7A9A8E6FC1DE7053",
      "text": "Vor mehr als zehn Jahren unterstützte die\\nPokémon-Liga Forschungen zu Zone Null,\\r\\neinem Gebiet, das sich in einem Schlund\\r\\nim Zentrum Paldeas befindet.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 155,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc02_0230_chairman_10",
      "hash64": "7A9E1B6FC1E195C1",
      "text": "Die Forschungen sind nun abgeschlossen,\\naber wir übernehmen weiterhin die Verwaltung\\r\\ndes Schlunds.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc02_0230_chairman_11",
      "hash64": "7A9E1A6FC1E1940E",
      "text": "Zone Null ist ein Ort voller Geheimnisse und\\nGefahren.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc02_0230_chairman_12",
      "hash64": "7A9E196FC1E1925B",
      "text": "Wir erlauben grundsätzlich niemandem, sie zu\\nbetreten, geschweige denn zu erforschen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc02_0230_chairman_13",
      "hash64": "7A9E186FC1E190A8",
      "text": "Allerdings... sieht die Sache momentan etwas\\nanders aus.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0230_chairman_14",
      "hash64": "7A9E1F6FC1E19C8D",
      "text": "Es besteht die Gefahr, dass brutale Pokémon\\nvon dort in die Außenwelt gelangen könnten.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "sdc02_0230_chairman_15",
      "hash64": "7A9E1E6FC1E19ADA",
      "text": "Es werden daher schleunigst weitere\\nNachforschungen benötigt.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "sdc02_0230_chairman_16",
      "hash64": "7A9E1D6FC1E19927",
      "text": "Doch die Pokémon-Liga kann weder das Personal\\nnoch die Zeit aufbringen, in Zone Null tätig zu\\r\\nwerden.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sdc02_0230_chairman_17",
      "hash64": "7A9E1C6FC1E19774",
      "text": "Und deshalb...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "sdc02_0230_bbteacher_17",
      "hash64": "FA3035C9DB9C0807",
      "text": "Deshalb wurde ich für diese Aufgabe auserkoren,\\nda ich schon seit geraumer Zeit darum bitte,\\r\\ndort Untersuchungen anstellen zu dürfen.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "sdc02_0230_chairman_18",
      "hash64": "7A9E136FC1E18829",
      "text": "Es beschämt mich zutiefst, dass wir nicht besser\\nauf diese Situation vorbereitet sind...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "sdc02_0230_chairman_19",
      "hash64": "7A9E126FC1E18676",
      "text": "Doch auf die Blaubeer-Akademie gehen viele\\ntalentierte Schüler, die im Trainieren von\\r\\nPokémon bestens bewandert sind.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sdc02_0230_chairman_20",
      "hash64": "7AA1216FC1E3D5CA",
      "text": "[VAR 0xBD06(0000)]Und wenn Champ [VAR 0x0100(0000)]\\nauch\\r\\nan\\r\\neurer\\r\\nSeite ist,\\r\\nfällt es mir\\r\\ngleich\\r\\nleichter,\\r\\ndiese\\r\\nExpedition\\r\\nins Leben\\r\\nzu rufen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
