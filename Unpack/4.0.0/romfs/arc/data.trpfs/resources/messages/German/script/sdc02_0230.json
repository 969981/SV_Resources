          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0230_select_01",
      "hash64": "938431741EF69B2A",
      "text": "Vielen Dank!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sdc02_0230_select_02",
