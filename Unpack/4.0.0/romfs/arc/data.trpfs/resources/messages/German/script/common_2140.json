          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2140_announce_04",
      "hash64": "8D4FA68FFBF47AD7",
      "text": "U-Unglaublich! [VAR 0x1100(00FF,0E0C,0000)]D-Der SiegerD-Die Siegerin des\\nGroßen Akademieturniers...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
