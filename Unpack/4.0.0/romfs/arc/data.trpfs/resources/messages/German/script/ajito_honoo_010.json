          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_honoo_010_sitappa_05",
      "hash64": "0EBFF2CAF3C6A2D7",
      "text": "Woah, du bist irre stark...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
