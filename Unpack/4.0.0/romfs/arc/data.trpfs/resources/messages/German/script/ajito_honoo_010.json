      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "ajito_honoo_010_sitappa_03",
      "hash64": "0EBFF0CAF3C69F71",
      "text": "Richtig so, sehr weise Entscheidung.\\nHasta la vistar![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
