          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_honoo_010_select_01",
      "hash64": "F2512E54849FE70F",
      "text": "Ich kehre nicht um!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "ajito_honoo_010_select_02",
      "hash64": "F2512F54849FE8C2",
