      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "champ_0125_select_02",
      "hash64": "E5768ECFB995BDF7",
      "text": "Ach, du übertreibst...",
