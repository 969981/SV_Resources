    {
      "ordinal": 10,
      "label": "s2_side01_0050_friend_02",
      "hash64": "CA7C0710D7006017",
      "text": "So sieht’s aus.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
