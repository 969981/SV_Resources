    {
      "ordinal": 17,
      "label": "s2_side01_0050_friend_04",
      "hash64": "CA7C0510D7005CB1",
      "text": "Hat sich dieser Jo eigentlich inzwischen mal\\nbei dir gemeldet?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
