    },
    {
      "ordinal": 6,
      "label": "s2_side01_0050_rival_03",
      "hash64": "6B6AA896E5DDE1E0",
      "text": "Hallöchen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
