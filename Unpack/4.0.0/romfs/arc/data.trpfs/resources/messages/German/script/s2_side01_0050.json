    },
    {
      "ordinal": 7,
      "label": "s2_side01_0050_caretaker_02",
      "hash64": "A86DE1BE5C0FEFFF",
      "text": "Hoho! Hallöchen zurück. Ich bin der hiesige\\nVerwalter.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
