    },
    {
      "ordinal": 8,
      "label": "s2_side01_0050_caretaker_03",
      "hash64": "A86DE0BE5C0FEE4C",
      "text": "Jo hat mir schon von euch erzählt.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
