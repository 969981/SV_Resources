        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_a_04_ecology_03",
      "hash64": "105FC740CDB246AD",
      "text": "Es besteht aber kein Grund zur Eile, also geht die\\nFragen langsam an.[VAR 0x0114(002A)]",
