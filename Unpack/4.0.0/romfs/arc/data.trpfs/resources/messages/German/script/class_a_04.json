    {
      "ordinal": 16,
      "label": "class_a_04_question_04",
      "hash64": "3BCBF411B28D4FEA",
      "text": "4. Was hilft NICHT beim Fangen von Pokémon?\\nA) Ihnen eine Beere zu geben\\nB) Sie von hinten zu überraschen\\nC) Sie zu vergiften\\nD) Einen geeigneten Pokéball zu werfen",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_a_04_ansewer_04a",
      "hash64": "2996E0BE947E5150",
      "text": "Ihnen eine Beere zu geben",
      "flags": 0,
