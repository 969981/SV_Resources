    {
      "ordinal": 25,
      "label": "class_a_04_question_06",
      "hash64": "3BCBF211B28D4C84",
      "text": "☆ Zusatzfrage ohne Einfluss auf deine Note ☆\\n\\nWas hältst du vom Pokédex? Ist er einfach zu\\nbedienen? Ich würde mich freuen, deine ehrliche\\nMeinung zu hören!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "class_a_04_ansewer_06a",
      "hash64": "298FD4BE94781E3E",
      "text": "Ja, er ist total einfach zu bedienen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "class_a_04_ansewer_06b",
      "hash64": "298FD3BE94781C8B",
      "text": "Er ist ganz okay.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "class_a_04_ansewer_06c",
      "hash64": "298FD2BE94781AD8",
      "text": "Ich benutze ihn ehrlich gesagt nicht so oft...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
