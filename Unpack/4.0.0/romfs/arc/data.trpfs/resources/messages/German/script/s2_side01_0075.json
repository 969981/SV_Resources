    {
      "ordinal": 21,
      "label": "s2_side01_0075_brother_11",
      "hash64": "743659CBC2FFB8B6",
      "text": "Hana ist zwar eigenwillig, egoistisch und nimmt\\nkein Blatt vor den Mund...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
