  "entries": [
    {
      "ordinal": 0,
      "label": "sub_014_system_kui_01",
      "hash64": "1A7B3A8AE0ECFF5D",
      "text": "Hier steckt ein unheilvoll anmutender schwarzer\\nPfahl im Boden...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_014_system_kui_02",
      "hash64": "1A7B378AE0ECFA44",
      "text": "Möchtest du ihn herausziehen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_014_system_kui_03",
      "hash64": "1A7B388AE0ECFBF7",
      "text": "Als du den Pfahl aus dem Boden ziehst,\\nzerfällt er und löst sich in Luft auf!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_014_system_kui_04",
      "hash64": "1A7B358AE0ECF6DE",
      "text": "Luuu...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_014_system_kui_05",
      "hash64": "1A7B368AE0ECF891",
      "text": "Aus Richtung des Schreins ertönt ein seltsamer\\nRuf...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_014_system_release_01",
      "hash64": "A5872331365DB1CF",
      "text": "Leise Geräusche dringen aus dem Inneren des\\nSchreins hervor...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_014_system_release_02",
      "hash64": "A5872431365DB382",
      "text": "Möchtest du den Schrein berühren?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_014_system_release_03",
      "hash64": "A5872531365DB535",
      "text": "*ratter* *ratter*\\n*rumpel* *rumpel*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_014_system_release_07",
      "hash64": "A5872131365DAE69",
      "text": "*RUMMS*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_014_system_release_04",
      "hash64": "A5871E31365DA950",
      "text": "Lu!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_014_system_release_05",
      "hash64": "A5871F31365DAB03",
      "text": "Dinglu wurde erneut im Schrein versiegelt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_014_system_release_06",
      "hash64": "A5872031365DACB6",
      "text": "Offenbar wird es etwas dauern, bis sich das Tor\\ndes Schreins wieder öffnet.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_014_system_hokora_01",
      "hash64": "FB3D6C305BC176A6",
      "text": "Auf dem Schrein ist etwas kaum Leserliches\\neingraviert...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_014_system_hokora_02",
      "hash64": "FB3D6B305BC174F3",
      "text": "AN DIESEM ORT WURDE DAS UNHEILSGEFÄSS\\nVERSIEGELT.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_014_system_hokora_03",
      "hash64": "FB3D6A305BC17340",
      "text": "DAS SIEGEL DES UNHEILSGEFÄSSES WURDE\\nGEBROCHEN.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
