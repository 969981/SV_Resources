          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_039_steel_08",
      "hash64": "794C41F237DE3D07",
      "text": "Wenn ich mich nicht täusche, sollte es nun in der\\nLage sein, uneingeschränkt zu fliegen.\\c\\nEin unerwartetes, aber durchaus akzeptables\\nErgebnis.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
