          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_039_steel_09",
      "hash64": "794C40F237DE3B54",
      "text": "Ich habe übrigens eine neue, extrem schwere\\nStrecke für das Flugrennen entworfen.\\c\\nStelle dich dieser Herausforderung, wenn du dir\\ndeiner Fertigkeiten sicher bist.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
