          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_039_steel_04",
      "hash64": "794C35F237DE28A3",
      "text": "Das ist schade, aber wir verlieren ihn gewiss\\nnicht aus den Augen.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
