          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_039_steel_05",
      "hash64": "794C34F237DE26F0",
      "text": "Es überwiegt die Freude darüber, dass er\\nwieder zu sich selbst zurückgefunden hat.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
