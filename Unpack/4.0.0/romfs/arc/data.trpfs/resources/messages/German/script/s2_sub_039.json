      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_039_steel_03",
      "hash64": "794C3AF237DE3122",
      "text": "Als du Champ geworden bist, hat Jo sich\\nvollständig aus dem Rangsystem zurückgezogen.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
