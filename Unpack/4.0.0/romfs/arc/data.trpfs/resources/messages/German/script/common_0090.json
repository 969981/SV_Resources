      ]
    },
    {
      "ordinal": 32,
      "label": "common_0090_head_teacher_08",
      "hash64": "F3A817A8F421466F",
      "text": "Doch auch wenn sich die Zeiten ändern mögen –\\nder Zauber, Pokémon zu begegnen, verblasst nie.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
