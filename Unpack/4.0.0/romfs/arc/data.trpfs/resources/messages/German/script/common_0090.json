          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "common_0090_head_teacher_09",
      "hash64": "F3A816A8F42144BC",
      "text": "So wird auch jede einzelne eurer vielen\\nBegegnungen euch dabei helfen, weiter zu\\r\\nwachsen.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
