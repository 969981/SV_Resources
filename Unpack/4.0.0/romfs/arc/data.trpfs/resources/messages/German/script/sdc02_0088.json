      "label": "sdc02_0088_sister_26",
      "hash64": "D771BD0265E070B0",
      "text": "Das war doch...![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
