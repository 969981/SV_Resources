          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0088_sister_13",
      "hash64": "D76E3A0265DD5C40",
      "text": "Bist du bereit? Ich werde dich aus den Socken\\nhauen. Und zwar in einem Doppelkampf![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0088_sister_14",
      "hash64": "D76E410265DD6825",
      "text": "Pfff! Dabei bin ich durch die Terakristallisierung\\ndoch stärker geworden!\\c\\nAber nein, du musstest gleich NOCH stärker\\nwerden...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0088_sister_15",
      "hash64": "D76E400265DD6672",
