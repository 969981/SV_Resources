    {
      "ordinal": 51,
      "label": "sdc02_0088_select_03",
      "hash64": "CD41A953A74E3BB9",
      "text": "Genau!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "sdc02_0088_select_04",
      "hash64": "CD41AA53A74E3D6C",
      "text": "Ja, wir sind Freunde!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "sdc02_0088_dragonbb_07",
      "hash64": "5C2CE08CB4CF466C",
      "text": "Soso! Verstehe, coole Sache.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
