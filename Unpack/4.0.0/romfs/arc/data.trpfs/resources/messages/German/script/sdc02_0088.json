        }
      ]
    },
    {
      "ordinal": 49,
      "label": "sdc02_0088_sister_21",
      "hash64": "D771C40265E07C95",
      "text": "[VAR 0xBD06(0000)]Das ist [VAR 0x0100(0000)]. [VAR 0x1100(00FF,0302,0000)]ErSie ist als\\n[VAR 0x1100(00FF,1210,0000)]AustauschschülerAustauschschülerin\\r\\nhier\\r\\nund\\r\\n[VAR 0x1100(00FF,0D0A,0000)]ein Freundeine Freundin\\r\\nvon mir--[VAR 0x0114(0044)]",
