          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "sdc02_0088_sister_25",
      "hash64": "D771C00265E075C9",
      "text": "Ich komm auch mit.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
