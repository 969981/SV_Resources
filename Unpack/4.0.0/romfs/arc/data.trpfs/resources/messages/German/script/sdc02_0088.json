          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0088_brother_01",
      "hash64": "4F398D1CD20CFFFF",
      "text": "Ernsthaft? Warum kriegst du das nicht hin?![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
