    {
      "ordinal": 50,
      "label": "sdc02_0088_dragonbb_06",
      "hash64": "5C2CE18CB4CF481F",
      "text": "Aaah, dann bist du also auch mit Jo befreundet,\\nstimmt’s?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
