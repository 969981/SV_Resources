    },
    {
      "ordinal": 7,
      "label": "sdc02_0088_steelbb_04",
      "hash64": "6FCC4EABD7F29B3B",
      "text": "Es war mir eine Freude, Hana. Bis bald.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
