          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "sdc02_0088_dragonbb_08",
      "hash64": "5C2CE78CB4CF5251",
      "text": "[VAR 0xBD06(0000)]Hey, [VAR 0x0100(0000)]! Wie wär’s, wenn ich dir\\nunseren\\r\\nAG-Raum zeig?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
