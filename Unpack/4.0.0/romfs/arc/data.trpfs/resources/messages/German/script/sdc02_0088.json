      "label": "sdc02_0088_select_02",
      "hash64": "CD41A853A74E3A06",
      "text": "Warum fragst du?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sdc02_0088_sister_17",
      "hash64": "D76E3E0265DD630C",
