    },
    {
      "ordinal": 10,
      "label": "sdc02_0088_sister_07",
      "hash64": "D76B3E0265DB2D35",
      "text": "Hm, alsooo...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
