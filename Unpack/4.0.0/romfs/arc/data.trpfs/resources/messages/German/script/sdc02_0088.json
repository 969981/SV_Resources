        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0088_sister_10",
      "hash64": "D76E3D0265DD6159",
      "text": "Weißt du was? Ich war in letzter Zeit zusammen\\nmit Ms Brianna in verschiedenen Regionen\\r\\nunterwegs, um ihr bei ihrer Forschung zu helfen.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
