        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0088_sister_05",
      "hash64": "D76B3C0265DB29CF",
      "text": "Oh. Ja, wir sehen uns![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
