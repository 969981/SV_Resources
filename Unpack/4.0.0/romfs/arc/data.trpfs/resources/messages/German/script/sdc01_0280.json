      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0280_student1_02",
      "hash64": "088E166CA2287891",
      "text": "Ich soll dir von Hana ausrichten, dass sie bei sich\\nzu Hause wartet und du zu ihr kommen sollst,\\r\\n„und zwar dalli“! Äh, ihre Worte, nicht meine...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0280_student1_03",
      "hash64": "088E156CA22876DE",
      "text": "Dich lädt sie zu sich nach Hause ein und mich\\nnicht... obwohl ich ihr Partner bin!\\r\\nWas läuft da zwischen euch beiden, hm?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
