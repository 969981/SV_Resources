          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0280_student2_01",
      "hash64": "0752CB677B1ADDCF",
      "text": "Der Verwalter hat uns ein paar superkrasse\\nMasken gezeigt, hehe!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc01_0280_student3_01",
      "hash64": "31D0DF5C31B2501A",
      "text": "Du hast schon alle Infotafeln gefunden?!\\nWow, das ging ja schnell!\\c\\nMeine Team-Partnerin will nicht, dass es mir\\nwieder schlecht geht, darum lassen wir die Suche\\r\\nlangsam angehen, ganz ohne Stress. Voll nett!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
