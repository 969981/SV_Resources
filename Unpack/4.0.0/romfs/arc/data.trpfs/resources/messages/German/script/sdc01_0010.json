          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0010_bbteacher_09",
      "hash64": "D367DA83C789B43D",
      "text": "Nun, wie du eben gehört hast, lautet mein\\nName Brianna.\\c\\nIch bin Lehrerin an der Blaubeer-Akademie.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
