          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0010_bbteacher_11",
      "hash64": "D36B5683C78CBCC8",
      "text": "Die Kitakami-Provinz ist für ihre Ländlichkeit\\nberühmt. Sie mag etwas abgelegen sein, birgt\\r\\naber auch ein paar wundersame Geheimnisse.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
