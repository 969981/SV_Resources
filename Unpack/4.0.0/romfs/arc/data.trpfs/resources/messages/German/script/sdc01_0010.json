          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0010_ecology_05",
      "hash64": "4FF118C5AFE06047",
      "text": "Diese Schule liegt in der Einall-Region und\\nMs Brianna ist dort für den Lehrplan zuständig.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0010_bbteacher_10",
      "hash64": "D36B5783C78CBE7B",
      "text": "Dieses Jahr betreut die Blaubeer-Akademie die\\nExkursion, daher bin ich gekommen, um dich\\r\\nabzuholen, [VAR 0x0100(0000)].[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
