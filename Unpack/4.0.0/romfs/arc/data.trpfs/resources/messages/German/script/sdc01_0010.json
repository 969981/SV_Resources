      "label": "sdc01_0010_ecology_07",
      "hash64": "4FF11AC5AFE063AD",
      "text": "Hmmm...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
