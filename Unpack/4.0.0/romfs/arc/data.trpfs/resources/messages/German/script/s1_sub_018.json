{
  "version": "4.0.0",
  "language": "de",
  "language_raw": "German",
  "source": "message/dat/German/script/s1_sub_018.dat",
  "paired_tbl": "message/dat/German/script/s1_sub_018.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_018_woman_01",
      "hash64": "2E13479A8E038F9F",
      "text": "Sag mal, findest du nicht auch, dass wir das\\nverliebteste Pärchen überhaupt sind?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s1_sub_018_man_01",
      "hash64": "A4BEB69B60D0EE99",
      "text": "Na klar! Ich wette, es gibt nicht einmal Pokémon,\\ndie so unzertrennlich sind wie wir!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_018_woman_02",
      "hash64": "2E13489A8E039152",
      "text": "Nicht wahr?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_018_woman_03",
      "hash64": "2E13499A8E039305",
      "text": "Oh, du da!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_018_woman_04",
      "hash64": "2E13429A8E038720",
      "text": "Wenn du zufällig ein Pokémon-Pärchen findest,\\ndas genauso verliebt ist wie mein Schatz und ich,\\r\\nwürdest du es uns bitte zeigen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_018_man_02",
      "hash64": "A4BEB39B60D0E980",
      "text": "Ich bezweifle aber stark, dass es eins gibt! Ahaha!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s1_sub_018_woman_05",
      "hash64": "2E13439A8E0388D3",
      "text": "Hast du ein unzertrennliches Pokémon-Paar\\ngefunden?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_018_man_03",
      "hash64": "A4BEB49B60D0EB33",
      "text": "Aha! Ich hab’s doch gesagt, das gibt es nicht!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s1_sub_018_man_04",
      "hash64": "A4BEB99B60D0F3B2",
      "text": "Lass mal sehen... Das soll ein unzertrennliches\\nPaar sein?! Dass ich nicht lache! Ahaha!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s1_sub_018_man_05",
      "hash64": "A4BEBA9B60D0F565",
      "text": "W-Was hast du da? Ein Zwieps?!\\c\\nEin unzertrennliches Duo, ein Herz und eine\\nSeele?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_018_man_06",
      "hash64": "A4BEB79B60D0F04C",
      "text": "W-Was hast du da? Ein Famieps?!\\c\\nSie haben einander so lieb, dass sie ein\\nklitzekleines, rundes Baby bekommen haben?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_018_man_07",
      "hash64": "A4BEB89B60D0F1FF",
      "text": "W-Was hast du da? Ein Famieps?!\\c\\nSie lieben sich so sehr, dass sie gleich zwei Babys\\nbekommen haben?! So eine glückliche Familie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_018_woman_06",
      "hash64": "2E13449A8E038A86",
      "text": "Liebe wie unsere... Es gibt sie also auch in der\\nWelt der Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s1_sub_018_woman_07",
      "hash64": "2E13459A8E038C39",
      "text": "Danke, dass du uns das gezeigt hast! Lass uns dir\\nim Gegenzug zwei Posen beibringen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s1_sub_018_system_01",
      "hash64": "715C9973D3928E94",
      "text": "Das Paar hat dir die Posen [VAR 0xFF00(0008)]Herz (rechte Hälfte)[VAR 0xFF00(0000)]\\nund [VAR 0xFF00(0008)]Herz (linke Hälfte)[VAR 0xFF00(0000)] beigebracht!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
