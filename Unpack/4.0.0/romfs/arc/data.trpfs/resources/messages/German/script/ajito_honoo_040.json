    },
    {
      "ordinal": 12,
      "label": "ajito_honoo_040_kakutouboss_03",
      "hash64": "A93E40F7A9667B03",
      "text": "Die Mädchen an der Akademie haben Irsa um\\nihre Schönheit beneidet und sie dafür schikaniert.\\c\\nIrsa ist mit Absicht so schroff und nimmt kein Blatt\\nvor den Mund, um dem entgegenzuwirken.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
