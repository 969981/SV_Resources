          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_honoo_040_fairyboss_03",
      "hash64": "553BCAF0C90A05F4",
      "text": "Mit deinem losen Mundwerk und schlechten\\nBenehmen hast du dich auch nicht gerade beliebt\\r\\ngemacht, oder?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
