    },
    {
      "ordinal": 6,
      "label": "ajito_honoo_040_dokuboss_01",
      "hash64": "8CB3ED175179BD66",
      "text": "Es ist vollbracht, nobler Otis![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
