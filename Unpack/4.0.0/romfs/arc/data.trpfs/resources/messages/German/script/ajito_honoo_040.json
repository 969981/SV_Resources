    {
      "ordinal": 13,
      "label": "ajito_honoo_040_kakutouboss_04",
      "hash64": "A93E45F7A9668382",
      "text": "Aber... Das führte wohl dazu, dass sie negativ\\nauffiel...[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
