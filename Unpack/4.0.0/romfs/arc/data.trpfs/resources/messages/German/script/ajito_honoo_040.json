          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "ajito_honoo_040_honooboss_29",
      "hash64": "2B2D2DFF78CE1132",
      "text": "Ah. Ihr wisst also nichts davon...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
