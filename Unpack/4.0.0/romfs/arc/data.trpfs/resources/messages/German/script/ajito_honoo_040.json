          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "ajito_honoo_040_nelke_12",
      "hash64": "CC92D95F385CDB5F",
      "text": "Ihr habt es noch nie zuvor verwendet...? Und von\\nwas für einem großen Kampf sprichst du?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
