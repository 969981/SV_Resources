    {
      "ordinal": 11,
      "label": "ajito_honoo_040_kakutouboss_02",
      "hash64": "A93E3FF7A9667950",
      "text": "Da liegst du falsch, Otis.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
