            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2150_top_06",
      "hash64": "0A419A85D8339ED0",
      "text": "Alle Trainerinnen und Trainer haben heute den\\nWillen bewiesen, noch stärker zu werden.\\c\\nIch hoffe inständig, dass dieser wie ein Funke auf\\nalle Menschen hier in Paldea überspringen möge.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 188,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2150_top_07",
      "hash64": "0A419B85D833A083",
      "text": "Somit wird diese Region stets aufs Neue die\\nChamps von Morgen hervorbringen![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_2150_top_08",
      "hash64": "0A41A885D833B69A",
      "text": "Das wünsche ich mir von ganzem Herzen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_2150_head_teacher_07",
      "hash64": "5F8497A42219FF57",
      "text": "Señora Sagaria, haben Sie vielen Dank für diese\\nbewegenden Worte![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_2150_head_teacher_08",
      "hash64": "5F848CA42219ECA6",
      "text": "Eigentlich würde sich das als perfekter Zeitpunkt\\nanbieten, um das Turnier zu beenden...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_2150_head_teacher_09",
      "hash64": "5F848DA42219EE59",
      "text": "Doch ihm verdanken wir einen regen Austausch\\nzwischen Kollegium und Schülerschaft, der sogar\\r\\ndas Potenzial haben könnte, die gesamte Region\\r\\nzu erfassen und zu beleben.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 173,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_2150_head_teacher_10",
      "hash64": "5F881AA4221D13C7",
      "text": "In Anbetracht dessen habe ich beschlossen,\\ndas Große Akademieturnier fortan in regulären\\r\\nAbständen stattfinden zu lassen![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_2150_mobs_01",
      "hash64": "1135BFF0C7326A65",
      "text": "Wooow! Fantastisch, Señor Direktor!\\nGeniale Idee!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "common_2150_mobs_02",
      "hash64": "1135BCF0C732654C",
      "text": "Hm, vielleicht sollte ich nächstes Mal auch\\nteilnehmen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "common_2150_rival_01",
      "hash64": "78CE8ECB9EDE23F8",
      "text": "Waaaah, ich freu mich so!! JUHUUU!![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "common_2150_head_teacher_11",
      "hash64": "5F8819A4221D1214",
      "text": "Ich hoffe doch sehr, dass du nächstes Mal nicht\\nnur hinter den Kulissen aktiv sein wirst, Nemila.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "common_2150_rival_02",
      "hash64": "78CE91CB9EDE2911",
      "text": "Den Spaß werde ich mir nicht noch mal entgehen\\nlassen, Señor Direktor, Sie haben mein Wort![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "common_2150_head_teacher_12",
      "hash64": "5F881CA4221D172D",
      "text": "Sehr schön. Dann erkläre ich hiermit das erste\\nGroße Akademieturnier offiziell für beendet![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "common_2150_head_teacher_13",
      "hash64": "5F881BA4221D157A",
      "text": "Habt alle recht herzlichen Dank! Ich freue mich\\nbereits darauf, euch beim nächsten Mal wieder\\r\\nbegrüßen zu dürfen![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
