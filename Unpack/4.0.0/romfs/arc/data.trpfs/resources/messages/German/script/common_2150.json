          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2150_head_teacher_03a",
      "hash64": "683FC9E5F221F59E",
      "text": "„Mit Tradition als Fundament\\nwächst Stärke bis ans Firmament!“[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2150_head_teacher_03b",
      "hash64": "683FC8E5F221F3EB",
      "text": "„Was auf Individualität gebaut,\\nbald schon Richtung Zukunft schaut!“[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2150_head_teacher_04a",
      "hash64": "6850C9E5F23068D1",
      "text": "So lautet das Motto der Orangen-Akademie.\\nUnd dieser wundervolle Wettstreit stand ganz\\r\\nin dessen Zeichen![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
