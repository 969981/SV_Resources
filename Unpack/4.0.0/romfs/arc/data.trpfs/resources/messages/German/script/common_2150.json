          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2150_head_teacher_06",
      "hash64": "5F8496A42219FDA4",
      "text": "Ohne weitere Umschweife übergebe ich nun das\\nWort an unseren Ehrengast, Vorstandsvorsitzende\\r\\nSagaria. Bitte sehr![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2150_top_01",
      "hash64": "0A41A185D833AAB5",
      "text": "Angetrieben vom lautstarken Zuspruch aller\\nAnwesenden haben sich die Trainerinnen und\\r\\nTrainer heute gegenseitig zu Höchstleistungen\\r\\nangespornt und Erstaunliches erreicht.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 176,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2150_top_02",
      "hash64": "0A419E85D833A59C",
      "text": "Tief in mir spüre ich, dass dies der Kern all\\ndessen ist, was nicht nur diese Akademie...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2150_top_03",
      "hash64": "0A419F85D833A74F",
      "text": "...sondern ganz Paldea beseelt und stimuliert![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2150_top_04",
      "hash64": "0A419C85D833A236",
      "text": "[VAR 0xBD06(0000)]Champ [VAR 0x0100(0000)] hat seit dem Ablegen\\n[VAR 0x1100(00FF,0506,0000)]seinerihrer\\r\\nletzten Prüfung\\r\\nnoch mal\\r\\ndeutlich\\r\\nan\\r\\nStärke\\r\\nhinzugewonnen...[VAR 0x0114(0011)]",
