          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2150_head_teacher_04b",
      "hash64": "6850C6E5F23063B8",
      "text": "So lautet das Motto der Trauben-Akademie.\\nUnd dieser wundervolle Wettstreit stand ganz\\r\\nin dessen Zeichen![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
