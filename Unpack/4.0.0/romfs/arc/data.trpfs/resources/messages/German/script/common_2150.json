    },
    {
      "ordinal": 6,
      "label": "common_2150_head_teacher_05",
      "hash64": "5F8499A4221A02BD",
      "text": "Da meine Ansprachen dazu neigen, sich in die\\nLänge zu ziehen, möchte ich an dieser Stelle\\r\\nzum Ende kommen.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
