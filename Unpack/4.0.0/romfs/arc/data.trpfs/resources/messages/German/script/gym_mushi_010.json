            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_mushi_010_receptionist_history",
      "hash64": "1D34FC39E3AF567A",
      "text": "Der Olivenanbau spielt eine bedeutende Rolle\\nhier in Moldrid.\\c\\nSeit Generationen veranstalten wir daher das\\nOlivenerntefest, um eine reiche Ernte zu erbitten.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_mushi_010_receptionist_05",
      "hash64": "12BB235357DBC321",
      "text": "Um die Arenaprüfung zu bestehen, musst du\\neinen Ball, der einer Olive nachempfunden ist,\\r\\nins Ziel rollen.\\c\\nWenn dir das gelingt, werden wir nächstes Jahr\\nsicher mit einer reichen Olivenernte belohnt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mushi_010_receptionist_06",
      "hash64": "12BB205357DBBE08",
      "text": "Wende dich für Details bitte an das Personal\\nvor Ort.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mushi_010_receptionist_map",
      "hash64": "DFC4229CB253ADF4",
      "text": "Der Austragungsort für das Olivenrollen ist\\n[VAR 0xFF00(0006)]nördlich der Stadt[VAR 0xFF00(0000)].\\c\\nIch markiere ihn für dich auf deiner Karte.",
