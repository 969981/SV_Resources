      ]
    },
    {
      "ordinal": 4,
      "label": "gym_mushi_010_receptionist_03",
      "hash64": "12BB255357DBC687",
      "text": "Bevor du dich mit Arenaleiterin Ronah messen\\nkannst, musst du die Arenaprüfung bestehen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mushi_010_receptionist_04",
      "hash64": "12BB225357DBC16E",
      "text": "Deine Aufgabe wird es sein, am [VAR 0xFF00(0006)]Olivenrollen[VAR 0xFF00(0000)]\\nteilzunehmen!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
