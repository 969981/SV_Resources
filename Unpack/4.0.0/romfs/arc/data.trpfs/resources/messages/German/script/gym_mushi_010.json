    {
      "ordinal": 2,
      "label": "gym_mushi_010_receptionist_01",
      "hash64": "12BB275357DBC9ED",
      "text": "Willkommen in der Arena von Moldrid!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mushi_010_receptionist_02",
      "hash64": "12BB245357DBC4D4",
      "text": "Lass mich dich zuallererst als [VAR 0x1100(00FF,0E0E,0000)]HerausfordererHerausforderin\\nregistrieren...\\c\\nDein Name ist [VAR 0x0100(0000)], sagst du?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0E0E",
            "0000"
          ]
        },
        {
          "kind": "control",
