          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_koori_sp03_05",
      "hash64": "4DD3686F921AAD97",
      "text": "Eigentlich wollte ich nie wieder auf mein Board\\nsteigen, aber...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_koori_sp03_06",
      "hash64": "4DD3696F921AAF4A",
      "text": "Vielleicht könnte ich es wieder angehen...\\nZumindest, während ich hier bin.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_koori_trade_01_00",
      "hash64": "C361CA51FA0A3C12",
      "text": "Sorry, aber manchmal werd ich eben schwach.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_koori_trade_01_01",
      "hash64": "C361CB51FA0A3DC5",
      "text": "Wo ich gerade ohnehin schon ziemlich uncool\\nwirke... Ich hab eine noch uncoolere Idee.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_koori_trade_01_02",
      "hash64": "C361C851FA0A38AC",
      "text": "Sollen wir Pokémon tauschen, du und ich?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_koori_trade_01_03",
      "hash64": "C361C951FA0A3A5F",
      "text": "Du bist dabei? Dann gebe ich dir mein Flaniwal.\\nUnd was hast du für mich?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_gym_koori_trade_01_04",
      "hash64": "C361C651FA0A3546",
      "text": "[VAR 0x0101(0001)]... Nicht schlecht.\\c\\nDu hast es mir anvertraut, also werde ich es auf\\nkeinen Fall auf Eis legen.\\c\\nEs ist bei mir gut aufgehoben.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
