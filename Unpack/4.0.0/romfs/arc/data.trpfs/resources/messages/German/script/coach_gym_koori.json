          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_koori_sp02_00",
      "hash64": "A2B0996582B268A9",
      "text": "Du schon wieder...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_koori_sp02_01",
      "hash64": "A2B0986582B266F6",
      "text": "Warst du schon mal im Polar-Areal der Kuppel?\\nZiemlich beeindruckend, oder?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_koori_sp02_02",
      "hash64": "A2B0976582B26543",
      "text": "Der Schnee dort ist so weich... Man würde nie\\ndenken, dass er künstlich ist.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_koori_sp02_03",
      "hash64": "A2B0966582B26390",
      "text": "Und es gibt sowohl gerade als auch kurvige\\nPassagen. Optimal für Snowboarder.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_gym_koori_sp02_select_01",
      "hash64": "0A146F6F18BACCD5",
      "text": "Du fährst wieder Snowboard?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_gym_koori_sp02_select_02",
      "hash64": "0A146C6F18BAC7BC",
      "text": "Dann ab auf die Piste!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_gym_koori_sp02_04",
      "hash64": "A2B09D6582B26F75",
      "text": "Ah... So war das nicht gemeint.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_koori_sp02_05",
      "hash64": "A2B09C6582B26DC2",
      "text": "Wenn ich einen Schneeberg sehe, habe ich immer\\nnoch die Angewohnheit, ihn genau unter die Lupe\\r\\nzu nehmen.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_koori_sp02_06",
      "hash64": "A2B09B6582B26C0F",
      "text": "Dass sie einfach einen ganzen Berg auf dem\\nSchulgelände hochziehen... Echt Wahnsinn.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_koori_sp03_00",
      "hash64": "4DD3636F921AA518",
      "text": "Vorhin war ich auf diesem schneebedeckten Berg\\nim Polar-Areal.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_koori_sp03_01",
      "hash64": "4DD3646F921AA6CB",
      "text": "Ich weiß nicht, ob’s daran lag, dass ich mal auf\\neinem anderen Berg als dem Montanata war...\\c\\nAber als ich zugesehen habe, wie Flaniwal und\\ndie anderen dort im Schnee herumgetollt sind...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 189,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_koori_sp03_02",
      "hash64": "4DD3656F921AA87E",
      "text": "Als ich das sah, musste ich einfach... Also...\\nI-Ich habe mir mein Snowboard geschnappt.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_koori_sp03_select_03",
      "hash64": "3172AE49C79029EC",
      "text": "Super!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "coach_gym_koori_sp03_select_04",
      "hash64": "3172AD49C7902839",
      "text": "Wie lief es?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "coach_gym_koori_sp03_03",
      "hash64": "4DD3666F921AAA31",
      "text": "Nun, die Schneebedingungen waren gut...\\nJa... Es war gut.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_koori_sp03_04",
      "hash64": "4DD3676F921AABE4",
      "text": "Es ist eine Weile her, seit ich auf der Piste war...\\nIch muss zugeben, ich hab mich etwas zu sehr\\r\\nreingesteigert.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
