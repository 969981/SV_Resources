      "hash64": "A70D68ECF0A6BE31",
      "text": "Du kannst nicht mehr umkehren.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "champ_0220_stopper_02",
      "hash64": "A70D65ECF0A6B918",
      "text": "Um weiterzukommen, musst du erst gewinnen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
