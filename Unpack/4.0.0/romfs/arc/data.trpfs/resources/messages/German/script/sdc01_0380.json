  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0380_npc_key_01",
      "hash64": "0D51978EED95686A",
      "text": "Ich habe Beatori zum Oniyama fliegen sehen.\\nEs war unglaublich schnell!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc01_0380_npc_key_02",
      "hash64": "0D51968EED9566B7",
      "text": "Ich hab Boninu von den drei Gefährten gesehen!\\c\\nMit seinem herrlichen lila Schal war es auf der\\nParadiesebene unverkennbar.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0380_npc_key_03",
      "hash64": "0D51958EED956504",
      "text": "Erst dachte ich, da würde ein Mensch auf dem\\nBoden liegen... Aber es war Benesaru, das sich\\r\\ngerade ein Mittagsschläfchen gegönnt hat!\\c\\nKein Wunder, am Teich schläft es sich bestimmt\\nsehr gut.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0380_system_02",
      "hash64": "12B9CEF5C1892D17",
      "text": "Du hast einen Hinweis zu den drei Gefährten\\nerhalten!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_0380_system_03",
      "hash64": "12B9CDF5C1892B64",
      "text": "Du hast jetzt zwei Hinweise zu den drei\\nGefährten!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc01_0380_system_01",
      "hash64": "12B9CFF5C1892ECA",
      "text": "Du hast einige Hinweise zu den drei Gefährten\\ngesammelt. Zeit für eine Lagebesprechung!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc01_0380_sister_01",
      "hash64": "3CE52BD6CB165B21",
      "text": "Wir fragen uns einfach durch, bis wir jemanden\\nfinden, der die drei Gefährten gesehen hat.\\c\\nWenn wir fertig sind, treffen wir uns wieder.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
