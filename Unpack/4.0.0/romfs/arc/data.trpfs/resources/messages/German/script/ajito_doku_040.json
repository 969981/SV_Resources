  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "ajito_doku_040_dokuboss_00",
      "hash64": "7EE9C25EC927EBA9",
      "text": "Meine Gefährten... Vergebt mir...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_doku_040_system_01",
      "hash64": "F1B3A41EED808681",
      "text": "Ein Jahr und einige Monate zuvor...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "ajito_doku_040_dokuboss_01",
      "hash64": "7EE9C15EC927E9F6",
      "text": "Vergebt mir die Verzögerung. Ich stieß auf nicht\\nunbeträchtliche Hindernisse bei der Beschaffung\\r\\nder Stoffe.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_doku_040_honooboss_01",
      "hash64": "3FEE639A2D55390C",
      "text": "Abgefahren... Diese Stiefel sind so was von\\nabgefahren![VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_doku_040_dokuboss_02",
      "hash64": "7EE9C05EC927E843",
      "text": "Inspiration für diese verlieh mir die Attacke\\nNitroladung...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_doku_040_kakutouboss_01",
      "hash64": "4918872BA1141559",
      "text": "Meine Uniform sieht einfach genau so aus,\\nwie ich sie mir vorgestellt hatte! Tausend Dank![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_doku_040_dokuboss_03",
      "hash64": "7EE9BF5EC927E690",
      "text": "Es erfüllt mich mit Freude, dass mein Entwurf das\\nKonzept „Popstar der Unterwelt“ wie gewünscht\\r\\nwiderspiegelt, werte Rioba.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "ajito_doku_040_akuboss_01",
      "hash64": "36523EDB08117B0C",
      "text": "Damit wären alle Modifikationen an unseren\\nUniformen abgeschlossen. Danke, Shugi![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_doku_040_akuboss_02",
      "hash64": "365241DB08118025",
      "text": "Jetzt, wo ihr zwei so bedrohlich ausseht, wird uns\\nso schnell sicher keiner mehr dumm anmachen![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_doku_040_fairyboss_01",
      "hash64": "0E1DF61F5DCB6AEA",
      "text": "Du hast echt ein Händchen für so was![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_doku_040_fairyboss_02",
      "hash64": "0E1DF51F5DCB6937",
      "text": "Unglaublich, dass diese Idioten damals auf dir\\nherumgehackt haben, nur weil du nerdy bist.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_doku_040_dokuboss_04",
      "hash64": "7EE9C65EC927F275",
      "text": "Der Weg des Nerds ist dornig und voller\\nWiderstand. Er entzieht sich dem Verständnis\\r\\ngewöhnlicher Menschen.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_doku_040_honooboss_02",
      "hash64": "3FEE669A2D553E25",
      "text": "Schau an, Shugi, welch ein Temperament!\\nDas Thema geht dir ja echt zu Herzen![VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_doku_040_kakutouboss_02",
      "hash64": "4918842BA1141040",
      "text": "Richtig so, Shugi, lass dich nicht unterkriegen!\\nIch find dich total cool![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "ajito_doku_040_akuboss_03",
      "hash64": "365240DB08117E72",
      "text": "Okay, als Nächstes steht Kampftraining auf dem\\nPlan, damit wir auch richtig auf Operation Star\\r\\nvorbereitet sind.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "ajito_doku_040_akuboss_04",
      "hash64": "36523BDB081175F3",
      "text": "Als Bosse können wir es uns nicht erlauben,\\nschwächer als andere Team-Mitglieder zu sein.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "ajito_doku_040_dokuboss_05",
      "hash64": "7EE9C55EC927F0C2",
      "text": "So ist es... Ich widme mich fortan mit Leib und\\nSeele der Schulung meiner Kampffertigkeiten![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_doku_040_dokuboss_06",
      "hash64": "7EE9C45EC927EF0F",
      "text": "Auch wenn ich mich mit Leib und Seele dagegen\\nauflehnen will... Gesetz ist Gesetz.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_doku_040_dokuboss_07",
      "hash64": "7EE9C35EC927ED5C",
      "text": "Wir müssen unserem Kodex Folge leisten.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "ajito_doku_040_dokuboss_08",
      "hash64": "7EE9CA5EC927F941",
      "text": "Somit bleibt mir nichts anderes übrig, als dies\\nhier an Euch abzutreten...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_doku_040_waza_01",
      "hash64": "D28430A2470ED9B9",
      "text": "Des Weiteren sollt Ihr dieses Gerät besitzen.\\nEs enthält die Anweisungen für eine Attacke,\\r\\nmit der man seine Feinde mit Müll bedeckt.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_doku_040_dokuboss_09",
      "hash64": "7EE9C95EC927F78E",
      "text": "Euer Name lautet [VAR 0x0100(0000)], nicht wahr?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "ajito_doku_040_dokuboss_10",
      "hash64": "7EE63C5EC924D220",
      "text": "Ich habe eine klare Niederlage erlitten, bei der\\nGroll und Bitterkeit fehl am Platz wären.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "ajito_doku_040_student_01",
      "hash64": "E6637BEF86A2512B",
      "text": "Meister Shugi!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "ajito_doku_040_dokuboss_11",
      "hash64": "7EE63D5EC924D3D3",
      "text": "M-Mein Kamerad?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "ajito_doku_040_nelke_01",
      "hash64": "BD2F1C2F0598E27F",
      "text": "Er bestand darauf, dich zu treffen und persönlich\\nmit dir zu sprechen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "ajito_doku_040_student_02",
      "hash64": "E6637CEF86A252DE",
      "text": "Meister Shugi, bitte hört mir zu! Ich brauche nur\\neinen Moment Eurer kostbaren Zeit!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "ajito_doku_040_dokuboss_12",
      "hash64": "7EE63E5EC924D586",
      "text": "[EMPTY 61]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "003D"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "ajito_doku_040_nelke_02",
      "hash64": "BD2F1D2F0598E432",
      "text": "[EMPTY 61]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "003D"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "ajito_doku_040_dokuboss_13",
      "hash64": "7EE63F5EC924D739",
      "text": "Weshalb habt Ihr mich aufgesucht?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "ajito_doku_040_student_03",
      "hash64": "E6637DEF86A25491",
      "text": "Ich wollte Euch zu Hilfe eilen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "ajito_doku_040_student_04",
      "hash64": "E6637EEF86A25644",
      "text": "Meister Shugi, wenn Ihr weiterhin dem Unterricht\\nfernbleibt, werdet Ihr der Akademie verwiesen,\\r\\nnicht wahr?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "ajito_doku_040_dokuboss_14",
      "hash64": "7EE6405EC924D8EC",
      "text": "...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_doku_040_student_05",
      "hash64": "E6637FEF86A257F7",
      "text": "Diejenigen von uns, die einst gemobbt wurden,\\nkönnen inzwischen wieder zur Akademie gehen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "ajito_doku_040_student_06",
      "hash64": "E66380EF86A259AA",
      "text": "Das haben wir nur Team Star zu verdanken!\\nEure harte Arbeit an jener Operation hat das\\r\\nermöglicht!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "ajito_doku_040_student_07",
      "hash64": "E66381EF86A25B5D",
      "text": "Es wäre nicht fair, wenn genau die, denen wir\\nso viel zu verdanken haben, der Akademie\\r\\nverwiesen würden!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "ajito_doku_040_dokuboss_15",
      "hash64": "7EE6415EC924DA9F",
      "text": "Vergebt mir...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
