    },
    {
      "ordinal": 37,
      "label": "ajito_doku_040_student_08",
      "hash64": "E66372EF86A241E0",
      "text": "Hat Euer Big Boss Euch immer noch nicht\\nkontaktiert...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "ajito_doku_040_dokuboss_16",
      "hash64": "7EE6425EC924DC52",
      "text": "So ist es. Seit jenem Tag...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
