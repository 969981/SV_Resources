          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "ajito_doku_040_dokuboss_17",
      "hash64": "7EE6435EC924DE05",
      "text": "Ohne unseren hochgeachteten Big Boss gäbe es\\ndas Team nicht...\\c\\nUnd ohne das Team wäre jener glückliche Alltag,\\nder nun an der Akademie herrscht, undenkbar.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 158,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "ajito_doku_040_dokuboss_18",
      "hash64": "7EE6445EC924DFB8",
      "text": "Bis zur Rückkehr unseres noblen Big Boss bleibt\\nuns keine andere Wahl, als all unsere Kräfte\\r\\naufzubieten, um die Verstecke zu verteidigen![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
