    },
    {
      "ordinal": 46,
      "label": "ajito_doku_040_dokuboss_21",
      "hash64": "7EF04D5EC92D4388",
      "text": "Big Boss beschreibt sich selbst als Außenseiter,\\nder selten einen Fuß vor die Tür setzt.\\c\\nAuslöser dafür sollen wie bei uns die Schikanen\\nniederträchtiger Tyrannen gewesen sein.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
