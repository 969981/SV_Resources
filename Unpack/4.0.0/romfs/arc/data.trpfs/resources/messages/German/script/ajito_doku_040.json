          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "ajito_doku_040_student_12",
      "hash64": "E666FEEF86A5659B",
      "text": "Das tut mir leid...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 48,
      "label": "ajito_doku_040_dokuboss_22",
      "hash64": "7EF0505EC92D48A1",
      "text": "Doch obgleich uns sein wahrer Name und sein\\nwahres Antlitz unbekannt sind, ist Big Boss\\r\\ndennoch unser hochgeschätzter Kamerad.\\c\\nUns bleibt also nur das Warten auf seine\\nhoffentlich baldige Rückkehr.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
