    },
    {
      "ordinal": 30,
      "label": "coach_paldea_friend_sp03_select_01",
      "hash64": "42657E2BDF84E362",
      "text": "Was soll das heißen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "coach_paldea_friend_sp03_select_02",
      "hash64": "42657D2BDF84E1AF",
      "text": "Mit wem denn?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "coach_paldea_friend_sp03_03",
      "hash64": "F2E209507D92DD01",
      "text": "Also, so richtig weiß ich das auch nicht...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
