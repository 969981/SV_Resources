          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea_friend_sp01_04b",
      "hash64": "F756EEB6ED4E79D0",
      "text": "Oha! Dann sind wir ganz einer Meinung!\\c\\nWenn man sich dabei genug anstrengt, werden\\nimmerhin auch die eigenen Sandwiches leckerer![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_paldea_friend_sp01_05",
      "hash64": "CB523F60EF7A9845",
      "text": "Der Direktor meinte, dass wir Extrapunkte für\\nunsere Akademie zu Hause sammeln können,\\r\\nwenn wir hier am Unterricht teilnehmen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_paldea_friend_sp01_06",
      "hash64": "CB523C60EF7A932C",
      "text": "Leider hab ich in dieser Hinsicht ein kleines\\nbisschen Nachholbedarf...\\c\\nAlso leg ich mich ordentlich ins Zeug, solange ich\\nhier bin![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_paldea_friend_sp02_00",
      "hash64": "C6DAFC4A1C28C239",
      "text": "[VAR 0xBD06(0000)]Hey, [VAR 0x0100(0000)]! Hör mal, ich hab da\\neine\\r\\nFrage...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
