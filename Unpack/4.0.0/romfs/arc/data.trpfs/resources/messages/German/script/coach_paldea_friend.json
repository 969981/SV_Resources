          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_paldea_friend_sp02_select_01",
      "hash64": "0525FB7097BB1AE5",
      "text": "Meinst du?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_paldea_friend_sp02_select_02",
      "hash64": "0525F87097BB15CC",
      "text": "Das kann nicht sein...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_paldea_friend_sp02_02",
      "hash64": "C6DAFA4A1C28BED3",
      "text": "Was? Du musstest für eine Top-Vier-Challenge\\nein feurig-scharfes Sandwich zubereiten?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_paldea_friend_sp02_03",
      "hash64": "C6DAF94A1C28BD20",
      "text": "Hmm... Dann hab ich mich möglicherweise geirrt.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_paldea_friend_sp02_04",
      "hash64": "C6DB004A1C28C905",
      "text": "Aber als ich neulich in der Tera-Kuppel gekocht\\nhab, standen plötzlich lauter Blaubeer-Schüler\\r\\num mich herum...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_paldea_friend_sp02_05",
      "hash64": "C6DAFF4A1C28C752",
      "text": "Sie haben mich angestarrt, als hätten sie so was\\nnoch nie gesehen! War mir echt peinlich...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_paldea_friend_sp02_06",
      "hash64": "C6DAFE4A1C28C59F",
      "text": "Irgendwie kam es dann so, dass ich einfach allen\\nein Sandwich in die Hand gedrückt hab...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_paldea_friend_sp02_select_03",
      "hash64": "0525F97097BB177F",
      "text": "Klingt toll!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_paldea_friend_sp02_select_04",
      "hash64": "0525F67097BB1266",
      "text": "Das war aber lieb von dir!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_paldea_friend_sp02_07",
      "hash64": "C6DAFD4A1C28C3EC",
      "text": "Das war ganz und gar nicht toll!!\\c\\nAch... du meinst für die anderen? Vielleicht...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea_friend_sp02_07b",
      "hash64": "0EDFF2EDD9444A4A",
      "text": "Das hat nix mit Nettigkeit zu tun! Ich konnte\\neinfach dem Druck nicht standhalten...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_paldea_friend_sp02_08",
      "hash64": "C6DB044A1C28CFD1",
      "text": "Wenn Sandwiches hier nichts Außergewöhnliches\\nsind, warum haben die mich dann so angestarrt?![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_paldea_friend_sp02_09",
      "hash64": "C6DB034A1C28CE1E",
      "text": "Diese Blaubeer-Akademie macht mich echt\\nfertig...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
