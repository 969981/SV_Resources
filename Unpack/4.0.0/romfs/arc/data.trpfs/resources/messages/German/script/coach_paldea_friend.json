        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_paldea_friend_sp01_select_01",
      "hash64": "95CEA937E1C91388",
      "text": "Kampfkurs!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_paldea_friend_sp01_select_02",
      "hash64": "95CEAC37E1C918A1",
      "text": "Hauswirtschaftskurs!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_paldea_friend_sp01_04",
      "hash64": "CB523E60EF7A9692",
      "text": "Kein Wunder, du bist ja selbst so ein superstarker\\nChamp wie Nemila...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
