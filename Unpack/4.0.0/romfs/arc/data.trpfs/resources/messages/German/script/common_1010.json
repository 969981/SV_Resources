      ]
    },
    {
      "ordinal": 7,
      "label": "common_1010_friend_04",
      "hash64": "DE58BEE54966D7F7",
      "text": "Das ist wirklich seltsam... Letztes Mal war das\\nLicht an...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_1010_rival_05",
      "hash64": "22F3AC2606CE7658",
      "text": "Oh! Jetzt ist es an![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
