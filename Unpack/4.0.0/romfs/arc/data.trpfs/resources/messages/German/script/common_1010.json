        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_1010_botan_02",
      "hash64": "36AD1F9F80D93C4F",
      "text": "Anscheinend... war der Stromsparmodus\\naktiviert.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
