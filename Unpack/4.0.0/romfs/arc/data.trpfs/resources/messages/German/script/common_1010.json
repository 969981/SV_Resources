    {
      "ordinal": 16,
      "label": "common_1010_botan_05",
      "hash64": "36AD1C9F80D93736",
      "text": "Urks, die redet ja wie ein Wasserfall...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
