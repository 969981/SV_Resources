          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_1010_rival_03",
      "hash64": "22F3B22606CE808A",
      "text": "Wie bitte? Willst du dich mit mir anlegen?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
