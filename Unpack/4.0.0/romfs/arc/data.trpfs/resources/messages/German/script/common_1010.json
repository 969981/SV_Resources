          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_1010_rival_06",
      "hash64": "22F3AF2606CE7B71",
      "text": "Oh! Du bist die mit dem flauschigen\\nEvoli-Rucksack![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_1010_botan_04",
      "hash64": "36AD1D9F80D938E9",
      "text": "Die mit dem Rucksack...? Ähm, mein Name ist\\nCosima...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_1010_rival_07",
      "hash64": "22F3AE2606CE79BE",
      "text": "Alles klar! Schön, dich kennenzulernen, Cosima!\\nWir haben bisher noch gar nicht miteinander\\r\\ngesprochen, oder?\\c\\nIch heiße Nemila und bin in der 1-A. Du kennst\\ndich also gut mit Computern aus, was?\\r\\nMagst du auch Pokémon-Kämpfe?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
