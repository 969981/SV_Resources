          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_1010_rival_04",
      "hash64": "22F3AD2606CE780B",
      "text": "Hmpf. Aber dafür ist es hier eh viel zu dunkel.\\nWo sind denn jetzt die starken Pokémon?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
