        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_1010_friend_05",
      "hash64": "DE58BDE54966D644",
      "text": "Was?! Aber wie...?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
