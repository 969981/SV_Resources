      ]
    },
    {
      "ordinal": 10,
      "label": "common_1010_botan_01",
      "hash64": "36AD209F80D93E02",
      "text": "I-Ich habe es angeschaltet.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
