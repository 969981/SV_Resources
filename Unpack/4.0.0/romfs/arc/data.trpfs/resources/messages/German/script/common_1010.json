          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_1010_friend_03",
      "hash64": "DE58BBE54966D2DE",
      "text": "In der Akademie nervt sie zwar ’n bisschen,\\naber hier könnte sie tatsächlich nützlich sein.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
