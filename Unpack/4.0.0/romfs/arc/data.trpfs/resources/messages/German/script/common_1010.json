      ]
    },
    {
      "ordinal": 12,
      "label": "common_1010_botan_03",
      "hash64": "36AD1E9F80D93A9C",
      "text": "Ich habe mich ins System gehackt und die\\nEinstellungen überschrieben...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
