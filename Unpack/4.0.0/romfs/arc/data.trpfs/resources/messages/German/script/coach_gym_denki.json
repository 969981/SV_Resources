          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_denki_sp01_04c",
      "hash64": "5CE2A50FFB6E7B94",
      "text": "Den Direktor?! Wie langweilig ist das denn...?\\nRiecht stark nach Risiko... Meinst du echt?\\c\\nMit einem Boomer als Gast kann ich meine Views\\necht vergessen...[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
