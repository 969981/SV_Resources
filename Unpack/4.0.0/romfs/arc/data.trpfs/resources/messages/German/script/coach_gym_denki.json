          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_denki_sp02_02c",
      "hash64": "28911AE23EC6212B",
      "text": "Meine Viewerzahl ist explodiert, als der Direktor\\naufgetreten ist!!\\c\\nWas ist das bitte für einer?! Der muss doch\\nvorher schon irgendwie berühmt gewesen sein!\\c\\nNeben ihm sah ich fast schon farblos aus...\\nSchon krass, was es für Leute gibt.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
