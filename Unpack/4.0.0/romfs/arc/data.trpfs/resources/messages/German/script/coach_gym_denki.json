    {
      "ordinal": 24,
      "label": "coach_gym_denki_sp03_02",
      "hash64": "B858C3E597C456EF",
      "text": "Und das, obwohl du jung, sympathisch und auch\\nnoch Champ bist! Was für eine Ehre...![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
