    {
      "ordinal": 4,
      "label": "coach_gym_denki_sp01_02",
      "hash64": "8F15FBF6083A8119",
      "text": "Das ist mein nächstes Streaming-Projekt, an dem\\nich gerade mit Vollkaracho arbeite.[VAR 0x0114(0019)]",
