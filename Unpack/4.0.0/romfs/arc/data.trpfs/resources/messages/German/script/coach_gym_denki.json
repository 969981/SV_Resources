    {
      "ordinal": 10,
      "label": "coach_gym_denki_sp01_04b",
      "hash64": "5CE2A60FFB6E7D47",
      "text": "Die Schüler haben ihre eigene Liga organisiert?\\nKlingt ein bisschen steif, aber warum nicht...[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
