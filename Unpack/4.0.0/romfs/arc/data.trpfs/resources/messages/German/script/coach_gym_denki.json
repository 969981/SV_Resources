      "label": "coach_gym_denki_sp03_04",
      "hash64": "B858C1E597C45389",
      "text": "Was?! Echt jetzt, kein Witz?! Boah, wie viel\\nGlück ich habe![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
