    },
    {
      "ordinal": 19,
      "label": "coach_gym_denki_sp02_03",
      "hash64": "B99412EABED1F87D",
      "text": "Die Akademie hat sich bei mir für die tolle\\nWerbung bedankt... Ehehehihi...![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_denki_sp02_04",
      "hash64": "B9940BEABED1EC98",
      "text": "Da lohnt es sich für mich, noch ein paar Videos\\nmehr über die Blaubeer-Akademie zu machen.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_denki_sp02_05",
      "hash64": "B9940CEABED1EE4B",
      "text": "Sag mir unbedingt Bescheid, falls du noch\\nweitere Tipps für mich hast![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
