    },
    {
      "ordinal": 17,
      "label": "coach_gym_denki_sp02_02b",
      "hash64": "289119E23EC61F78",
      "text": "Die Blaubeer-Liga ist megagut angekommen!\\c\\nMan kann sich halt einfach super in die Schüler\\nreinversetzen, die dort ihr Bestes geben.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
