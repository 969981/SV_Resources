      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_gym_denki_sp01_04",
      "hash64": "8F15FDF6083A847F",
      "text": "Whaaat?! Eine Kuppel mit vier künstlichen\\nArealen? Wie abgefahren, so was gibt’s hier?![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
