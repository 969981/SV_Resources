    {
      "ordinal": 8,
      "label": "s1_sub_005_woman_05",
      "hash64": "89A247AD938DA655",
      "text": "Ooohohoho! Wie recht du doch hast,\\nmein lieber Billy![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
