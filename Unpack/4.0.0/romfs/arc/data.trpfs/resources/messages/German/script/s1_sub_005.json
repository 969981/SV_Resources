    {
      "ordinal": 7,
      "label": "s1_sub_005_man_04",
      "hash64": "4B740052D1B10F54",
      "text": "Dein Charisma wirkt so anziehend, dass du die\\nLeute selbst an einen Ort wie diesen lockst![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
