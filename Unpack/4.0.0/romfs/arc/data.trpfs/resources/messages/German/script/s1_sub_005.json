    {
      "ordinal": 10,
      "label": "s1_sub_005_woman_07",
      "hash64": "89A245AD938DA2EF",
      "text": "In diesem Sinne: Das hier ist für dich.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
