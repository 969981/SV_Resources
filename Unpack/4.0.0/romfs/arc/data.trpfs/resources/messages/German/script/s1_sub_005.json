          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_005_woman_09",
      "hash64": "89A24BAD938DAD21",
      "text": "Deine Möglichkeiten sind so unermesslich wie\\nder blaue Ozean...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_005_man_05",
      "hash64": "4B740152D1B11107",
      "text": "Was spüre ich da? Sind das deine Worte der\\nWeisheit, die meinen Körper durchdringen?!\\c\\nAh, so erfrischend wie kühles Wasser nach einer\\nanstrengenden Yoga-Stunde...[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 165,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
