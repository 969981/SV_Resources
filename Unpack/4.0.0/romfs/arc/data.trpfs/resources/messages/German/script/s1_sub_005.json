    {
      "ordinal": 15,
      "label": "s1_sub_005_man_06",
      "hash64": "4B740252D1B112BA",
      "text": "Uh, là, là! In Kitakami waren wir doch neulich!\\nJetzt willst du wieder zurück?\\c\\nAn eine Jetsetterin wie dich muss die Welt sich\\nerst gewöhnen![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
