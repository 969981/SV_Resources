          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_005_woman_08",
      "hash64": "89A24AAD938DAB6E",
      "text": "Und lass mich noch ein bisschen meiner Weisheit\\nmit dir teilen...\\c\\nGeld findet man dort, wo man es am wenigsten\\nerwartet. Besonders in Einöden wie dieser hier![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
