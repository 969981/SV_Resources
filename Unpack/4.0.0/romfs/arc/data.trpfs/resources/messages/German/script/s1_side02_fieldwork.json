        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_side02_fieldwork_sazare_pokeget_13",
      "hash64": "3BDA360B859C2C93",
      "text": "Das Glühwürmchen-Pokémon Volbeat! Es soll mit\\nseinem Hinterteil Lichtzeichen malen können.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_side02_fieldwork_sazare_pokeget_14",
      "hash64": "3BDA3B0B859C3512",
      "text": "Das Requiem-Pokémon Zwirrlicht! Ihm nachts zu\\nbegegnen, hinterlässt einen bleibenden Eindruck,\\r\\nnicht wahr?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
