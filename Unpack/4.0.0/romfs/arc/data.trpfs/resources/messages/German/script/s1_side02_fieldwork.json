      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_side02_fieldwork_sazare_pokeget_02",
      "hash64": "3BDDBF0B859F4B35",
      "text": "Das ist das Kerzen-Pokémon Lichtel!\\nDie schwebende Flamme sieht im Dunkeln\\r\\neinfach magisch aus, findest du nicht?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
