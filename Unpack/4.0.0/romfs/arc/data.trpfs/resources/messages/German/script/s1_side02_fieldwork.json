          "kind": "control",
          "offset_units": 138,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 163,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "s1_side02_fieldwork_sazare_pokehint_11",
      "hash64": "28337255EE03C60A",
      "text": "Deine Motive, deine Komposition...\\nIch bin begeistert! Dein Talent ist an dieser\\r\\nAufgabe schon fast verschwendet.\\c\\nÜbrigens, hast du das nordwestliche Ufer schon\\nbesucht?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
