    },
    {
      "ordinal": 31,
      "label": "s1_side02_fieldwork_sazare_pokehint_08",
      "hash64": "28306555EE017A1C",
      "text": "Du hast schon tolle Fotos von Pokémon\\nverschiedener Typen gesammelt!\\c\\nGeister-Pokémon muss man besonders schnell\\nfotografieren, bevor sie einfach verschwinden.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
