    {
      "ordinal": 36,
      "label": "s1_side02_fieldwork_sazare_poke_02",
      "hash64": "AA2CC38F9F94CE29",
      "text": "Forsche fleißig weiter, okay? Ich verlasse mich\\nauf dich, Partner![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
