      ]
    },
    {
      "ordinal": 35,
      "label": "s1_side02_fieldwork_sazare_pokehint_12",
      "hash64": "28337155EE03C457",
      "text": "Im nebligen Wald scheint es immer noch ein paar\\nunfotografierte Pokémon zu geben![VAR 0x0114(0046)]",
