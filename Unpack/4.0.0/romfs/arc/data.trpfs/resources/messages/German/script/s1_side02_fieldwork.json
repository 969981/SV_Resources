    },
    {
      "ordinal": 10,
      "label": "s1_side02_fieldwork_sazare_pokeget_05",
      "hash64": "3BDDB80B859F3F50",
      "text": "Oh, das Giftechsen-Pokémon Molunk!\\nOb es wohl im Dunkeln auf Beutejagd ist?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_side02_fieldwork_sazare_pokeget_06",
      "hash64": "3BDDBB0B859F4469",
      "text": "Wow! Donarion, das Kneifkäfer-Pokémon!\\nSein großer Kiefer kommt auf dem Foto super\\r\\nzur Geltung![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
