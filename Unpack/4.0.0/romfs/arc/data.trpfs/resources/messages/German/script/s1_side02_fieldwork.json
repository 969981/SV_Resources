          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "s1_side02_fieldwork_sazare_camera_05",
      "hash64": "4080A167AF6F7596",
      "text": "Aaah, jetzt reicht’s aber! Geh und mach\\nstattdessen Fotos von Pokémon! Na los![VAR 0x0114(0046)]",
