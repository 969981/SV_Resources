          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_fieldwork_sazare_pokeget_12",
      "hash64": "3BDA350B859C2AE0",
      "text": "Das Stromfisch-Pokémon Zapplardin! Hut ab,\\ndass du so ein winziges Pokémon überhaupt\\r\\nbemerkt hast![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
