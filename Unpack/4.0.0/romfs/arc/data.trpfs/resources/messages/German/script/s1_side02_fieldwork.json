          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "s1_side02_fieldwork_sazare_pokehint_09",
      "hash64": "28306655EE017BCF",
      "text": "Deine Fotos zeigen die natürliche Schönheit der\\nPokémon in all ihrer Pracht!\\c\\nBei deinem Talent kannst du bestimmt auch\\nPokémon ablichten, die in den Baumwipfeln\\r\\nauf Nahrungssuche sind![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 163,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 190,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s1_side02_fieldwork_sazare_pokehint_10",
      "hash64": "28337355EE03C7BD",
      "text": "Das sind wirklich großartige Aufnahmen!\\c\\nÜbrigens, ich habe vorhin ein Donnern aus der\\nnordöstlichen Richtung gehört. Vielleicht gibt es\\r\\ndort Elektro-Pokémon?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
