          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_side02_fieldwork_sazare_pokeget_15",
      "hash64": "3BDA3C0B859C36C5",
      "text": "Das ist Hoothoot, das Eulen-Pokémon! Ich würde\\ngerne mal ein Foto von dem Moment machen,\\r\\nin dem es aufs andere Bein wechselt![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
