      ]
    },
    {
      "ordinal": 56,
      "label": "s1_side02_fieldwork_sazare_camera_03",
      "hash64": "4080A367AF6F78FC",
      "text": "Sorry, das ist mir etwas peinlich. Ich bin es nicht\\ngewohnt, auch mal vor der Kamera zu stehen...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
