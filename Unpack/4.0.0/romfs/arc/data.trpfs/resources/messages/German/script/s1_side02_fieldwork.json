          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_side02_fieldwork_sazare_pokeget_03",
      "hash64": "3BDDBE0B859F4982",
      "text": "Ah, Brimova, das Geruhsam-Pokémon!\\nDie Stille des Waldes scheint diesem Pokémon\\r\\nsehr zu gefallen.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
