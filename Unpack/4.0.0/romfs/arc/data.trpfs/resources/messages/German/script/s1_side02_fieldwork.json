          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_side02_fieldwork_sazare_pokeget_04",
      "hash64": "3BDDB90B859F4103",
      "text": "Das ist Kleinstein, das Gesteins-Pokémon!\\nPass auf, dass du nicht versehentlich über eines\\r\\nvon ihnen stolperst.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
