          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_side02_fieldwork_sazare_pokeget_16",
      "hash64": "3BDA390B859C31AC",
      "text": "Oh! Die Glühwürmchen-Pokémon Volbeat und\\nIllumise! Einfach ein perfektes Paar! Tolles Foto![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_side02_fieldwork_sazare_pokeget_17",
      "hash64": "3BDA3A0B859C335F",
      "text": "Das Glühwürmchen-Pokémon Illumise! Ob das\\nVolbeat wohl hergekommen ist, um sich mit ihm\\r\\nzu treffen?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
