      ]
    },
    {
      "ordinal": 57,
      "label": "s1_side02_fieldwork_sazare_camera_04",
      "hash64": "4080A267AF6F7749",
      "text": "Okay, okay, genug jetzt! Ich werde ja ganz\\nverlegen... So ein Foto willst du nicht![VAR 0x0114(0046)]",
