    {
      "ordinal": 54,
      "label": "s1_side02_fieldwork_sazare_camera_01",
      "hash64": "4080A567AF6F7C62",
      "text": "Hm? Willst du etwa auch von mir Fotos machen?\\nDabei bin ich doch gar kein Pokémon![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
