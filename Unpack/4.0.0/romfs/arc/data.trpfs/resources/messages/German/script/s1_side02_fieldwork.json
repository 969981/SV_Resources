          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_side02_fieldwork_sazare_pokeget_11",
      "hash64": "3BDA380B859C2FF9",
      "text": "Das Wasserlinsen-Pokémon Loturzel! Es muss\\nschön sein, so friedlich vor sich hin zu treiben.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
