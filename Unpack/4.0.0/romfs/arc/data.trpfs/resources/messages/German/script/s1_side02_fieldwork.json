            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_side02_fieldwork_sazare_pokeget_18",
      "hash64": "3BDA3F0B859C3BDE",
      "text": "Das Glühwürmchen-Pokémon Volbeat! Ob das\\nIllumise wohl hergekommen ist, um sich mit ihm\\r\\nzu treffen?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
