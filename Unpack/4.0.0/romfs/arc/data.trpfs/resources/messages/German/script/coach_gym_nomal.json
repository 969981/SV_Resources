      "hash64": "42D22D0900D22469",
      "text": "Hallo. Ich komme von der Pokémon-Liga der\\nPaldea-Region.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
