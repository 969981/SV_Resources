      ]
    },
    {
      "ordinal": 1,
      "label": "coach_gym_nomal_first_01",
      "hash64": "42D22C0900D222B6",
      "text": "Mein Name ist Aoki. Auf gute Zusammenarbeit.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_gym_nomal_sp01_00",
      "hash64": "F68097F619D1735F",
      "text": "Ach, du bist es?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_nomal_sp01_01",
      "hash64": "F68096F619D171AC",
      "text": "Du lässt mich also den weiten Weg in eine völlig\\nfremde Region kommen...\\c\\nNimmst du dir etwa ein Beispiel an einer\\ngewissen Person?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_nomal_sp01_02",
      "hash64": "F68099F619D176C5",
      "text": "Aber ich mag Dienstreisen, also werde ich mich\\nnicht beschweren.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_nomal_sp01_03",
      "hash64": "F68098F619D17512",
      "text": "Ich bin zwar geschäftlich hier, aber ich werde die\\nGelegenheit nutzen, auch etwas Spaß zu haben.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_gym_nomal_sp01_04",
      "hash64": "F68093F619D16C93",
      "text": "Übrigens, in der Einall-Region sind wohl zwei\\nspezielle Speisen sehr beliebt: das Dorfsandwich\\r\\nund das Stratos-Eis. Was davon klingt leckerer?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_gym_nomal_sp01_select_01",
      "hash64": "508901898B20563B",
      "text": "Das Dorfsandwich",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_gym_nomal_sp01_select_02",
      "hash64": "508902898B2057EE",
      "text": "Das Stratos-Eis",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_gym_nomal_sp01_05",
      "hash64": "F68092F619D16AE0",
      "text": "Verstehe, du isst gerne Sandwiches. Natürlich.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_nomal_sp01_05b",
      "hash64": "ADE43A2DDED7FAE6",
      "text": "Verstehe, du magst also Süßes.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_nomal_sp01_06",
      "hash64": "F68095F619D16FF9",
      "text": "Gut zu wissen...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_nomal_sp01_07",
      "hash64": "F68094F619D16E46",
      "text": "Wenn mein Vortrag vorbei ist, schlage ich mir\\nden Bauch voll.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_nomal_sp02_00",
      "hash64": "CA798DEFB8675DB0",
      "text": "Du schon wieder...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_nomal_sp02_01",
      "hash64": "CA798EEFB8675F63",
      "text": "Ich habe das Dorfsandwich probiert, von dem\\nwir letztens gesprochen haben.\\c\\nEs war sehr gut, wenn auch auf eine andere Art\\nals die Sandwiches, die man aus Paldea kennt.\\c\\nDa es mit Beeren zubereitet wird, war es wohl\\nganz nach Staraptors Geschmack.\\r\\nEs hat emsig danach gepickt...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 170,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 251,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 285,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_gym_nomal_sp02_01b",
      "hash64": "73ECE25657A66EB3",
      "text": "Ich habe das Stratos-Eis probiert, von dem wir\\nletztens gesprochen haben.\\c\\nDie cremige Konsistenz und der reichhaltige\\nGeschmack machen es wirklich zu einem Erlebnis.\\c\\nIn Paldea ist ja das Geosali-Salz-Eis von\\n„Heiß auf Eis“ eine kulinarische Sensation.\\c\\nAllerdings kommt das Stratos-Eis dem dank der\\nvielen hochwertigen Zutaten sehr nahe...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 168,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 257,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 347,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_gym_nomal_sp02_02",
      "hash64": "CA798FEFB8676116",
      "text": "Entschuldige. Ich wollte dich nicht vollschwatzen.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_nomal_sp02_03",
      "hash64": "CA7990EFB86762C9",
      "text": "Den wahren Reiz einer Geschäftsreise macht für\\nmich das Ausprobieren neuer Gerichte aus.\\c\\nIch könnte mich stundenlang darüber auslassen.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_nomal_sp02_04",
      "hash64": "CA7991EFB867647C",
      "text": "Aber letztendlich gibt es doch nichts Besseres,\\nals nach der Heimkehr wieder die gewohnten\\r\\nReisbällchen essen zu können...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_nomal_sp03_00",
      "hash64": "F3B1A3E46DEA10C1",
      "text": "Sag mal... Hast du schon einmal in der Mensa der\\nBlaubeer-Akademie gegessen?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_nomal_sp03_01",
      "hash64": "F3B1A2E46DEA0F0E",
      "text": "Das Essen dort ist nicht übel, hab ich recht?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_nomal_sp03_01b",
      "hash64": "00E73626C4B83484",
      "text": "Verstehe. Das Essen dort ist nicht übel.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_nomal_sp03_02",
      "hash64": "F3B1A1E46DEA0D5B",
      "text": "Die Speisen sind zwar kräftig gewürzt, so wie es\\ndie jungen Leute wohl mögen, aber die großen\\r\\nPortionen machen das Angebot äußerst attraktiv.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_nomal_sp03_03",
      "hash64": "F3B1A0E46DEA0BA8",
      "text": "Der Berg Akademie-Fritten hat mich fast\\nzu einem Freudensprung veranlasst.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_nomal_sp03_04",
      "hash64": "F3B1A7E46DEA178D",
      "text": "Falls du die noch nicht probiert hast, kann ich sie\\nnur wärmstens empfehlen.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_gym_nomal_trade_01_00",
      "hash64": "23FC6E8CF2B8BFC3",
      "text": "Mit so [VAR 0x1100(00FF,1C1A,0000)]einem aufmerksamen Zuhörereiner aufmerksamen Zuhörerin wie dir\\nhätte ich niemals gerechnet.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1C1A",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_nomal_trade_01_01",
      "hash64": "23FC6D8CF2B8BE10",
      "text": "Wie ungewöhnlich du doch bist.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_nomal_trade_01_02",
      "hash64": "23FC708CF2B8C329",
      "text": "Kann ich dich am Ende auch für einen\\nPokémon-Tausch begeistern?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_nomal_trade_01_03",
      "hash64": "23FC6F8CF2B8C176",
      "text": "Ich biete dir mein Dummimisel an. Wähle ruhig\\nein beliebiges Pokémon für den Tausch.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_nomal_trade_01_04",
      "hash64": "23FC728CF2B8C68F",
      "text": "Dein [VAR 0x0101(0001)] ist durchaus interessant.\\nEs wird sich lohnen, es zu trainieren.\\c\\nIch danke vielmals für den Tausch.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
