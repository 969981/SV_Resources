          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "coach_gym_nomal_randomtalk_02",
      "hash64": "36566CE3B8700D32",
      "text": "Es ist bedauerlich, dass ausgerechnet Sinius bei\\nder Top-Vier-Prüfung nach mir an der Reihe ist.\\c\\nCay und Poppy würden mich auch hören, ohne\\ndass ich meine Stimme erhebe.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
