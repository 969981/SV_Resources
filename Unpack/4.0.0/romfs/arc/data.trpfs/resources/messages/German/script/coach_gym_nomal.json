    },
    {
      "ordinal": 49,
      "label": "coach_gym_nomal_randomtalk_00",
      "hash64": "36566AE3B87009CC",
      "text": "Ich prahle nur ungern, aber die Arenaprüfung der\\nMesclarra-Arena habe ich gut gestaltet.\\c\\nDie Herausforderer gegeneinander antreten zu\\nlassen ist effizient und spart Arbeitskräfte.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
