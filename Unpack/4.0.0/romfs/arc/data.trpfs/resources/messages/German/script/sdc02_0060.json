          "offset_units": 19,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0060_fairybb_03",
      "hash64": "826FC23D93904EA6",
      "text": "Kaum zu glauben, dass wir uns unter der\\nMeeresoberfläche befinden, oder?\\c\\nDa Projektionen an die Wände und die Decke\\ngeworfen werden, könnte man meinen, wir seien\\r\\noben im Freien![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 164,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 183,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0060_fairybb_04",
      "hash64": "826FC53D939053BF",
      "text": "Hier werden die optimalen Lebensräume für\\nverschiedene Pokémon künstlich erzeugt.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0060_headbb_01",
      "hash64": "A14518385BCF1AFB",
      "text": "Das habe ich übrigens alles selbst entworfen,\\nund es war nicht billig, das darfst du mir glauben![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0060_fairybb_05",
      "hash64": "826FC43D9390520C",
      "text": "Im Inneren der Kuppel gibt es vier Areale.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0060_fairybb_06",
      "hash64": "826FC73D93905725",
      "text": "Hier siehst du das subtropische Savannen-Areal.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0060_fairybb_07",
      "hash64": "826FC63D93905572",
      "text": "Rechts davon befindet sich das Küsten-Areal,\\ndas eher tropisch angehaucht ist.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0060_fairybb_08",
      "hash64": "826FC93D93905A8B",
      "text": "Auf der linken Seite haben wir das zerklüftete\\nCanyon-Areal.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0060_fairybb_09",
      "hash64": "826FC83D939058D8",
      "text": "Und zum Schluss gibt es dort hinten noch das\\nschneebedeckte Polar-Areal.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0060_fairybb_10",
      "hash64": "826C5B3D938D69CA",
      "text": "Die Temperatur und Luftfeuchtigkeit werden\\nin jedem Areal strengstens reguliert.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0060_fairybb_11",
      "hash64": "826C5C3D938D6B7D",
      "text": "Daher trifft man in den vier Bereichen völlig\\nverschiedene Pokémon an![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0060_headbb_02",
      "hash64": "A14519385BCF1CAE",
      "text": "Ganz schön ausgetüftelt, was?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0060_fairybb_12",
      "hash64": "826C593D938D6664",
      "text": "Welches Areal interessiert dich am meisten?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0060_select_01",
      "hash64": "52386A030425028D",
      "text": "Das subtropische Savannen-Areal",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_0060_select_02",
      "hash64": "523867030424FD74",
      "text": "Das tropische Küsten-Areal",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc02_0060_select_03",
      "hash64": "523868030424FF27",
      "text": "Das zerklüftete Canyon-Areal",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc02_0060_select_04",
      "hash64": "523865030424FA0E",
      "text": "Das schneebedeckte Polar-Areal",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sdc02_0060_fairybb_13",
      "hash64": "826C5A3D938D6817",
      "text": "Das ist das Areal mit der größten Ähnlichkeit\\nzu seinem natürlichen Gegenstück.\\c\\nEs gibt kaum etwas, das einem die Sicht\\nversperrt, daher kann man dort sehr leicht\\r\\nPokémon in freier Wildbahn beobachten.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 165,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 207,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0060_fairybb_14",
      "hash64": "826C573D938D62FE",
      "text": "Hihi, da liegen wir auf einer Wellenlänge!\\nDieses Areal gefällt mir auch am besten.\\c\\nMan kann dort so schön entspannen und\\ndie Seele baumeln lassen.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0060_fairybb_15",
      "hash64": "826C583D938D64B1",
      "text": "Oho, du magst also raue Umgebungen?\\c\\nIn diesem Areal gibt es auch ein besonderes\\nMineral namens Elektrolith![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0060_fairybb_16",
      "hash64": "826C553D938D5F98",
      "text": "Du magst es also kalt, was?\\c\\nIch komme mit Kälte nicht so gut klar,\\naber Eis-Pokémon können echt niedlich sein![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0060_fairybb_17",
      "hash64": "826C563D938D614B",
      "text": "Wenn du deine Pokémon wieder aufpäppeln\\nwillst, stehen dir hier im Inneren der Kuppel\\r\\nsogenannte [VAR 0xFF00(0006)]Heilomaten[VAR 0xFF00(0000)] zur freien Verfügung.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0060_fairybb_18",
      "hash64": "826C533D938D5C32",
      "text": "Und nun eine Frage an Sie, Direktor Cyano.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0060_fairybb_19",
      "hash64": "826C543D938D5DE5",
      "text": "Wie kommt es, dass an der Blaubeer-Akademie\\nwilde Pokémon terakristallisieren und Kristalle\\r\\nentstehen?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0060_headbb_03",
      "hash64": "A1451A385BCF1E61",
      "text": "Öh, das soll ich beantworten? Aber das weißt du\\ndoch sicher selbst...\\c\\nAaaah, ich versteh schon! Ich soll auch mal was\\nzu der Tour beitragen, ähem...[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 151,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc02_0060_headbb_04",
      "hash64": "A1451B385BCF2014",
      "text": "Ja, also der Grund dafür hängt an der Decke.\\nSchaut mal nach oben![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc02_0060_headbb_05",
      "hash64": "A1451C385BCF21C7",
      "text": "Das, was da am künstlichen Himmel prangt,\\nist der [VAR 0xFF00(0006)]Kuppelkern[VAR 0xFF00(0000)].[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc02_0060_headbb_06",
      "hash64": "A1451D385BCF237A",
      "text": "In ihm befindet sich eine Flüssigkeit, die mit\\neiner speziellen Substanz aus Paldea versetzt ist.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc02_0060_headbb_07",
      "hash64": "A1451E385BCF252D",
      "text": "Er strahlt kontinuierlich Terakristall-Energie aus\\nund ermöglicht so innerhalb der Kuppel die\\r\\nTerakristallisierung.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0060_fairybb_20",
      "hash64": "8269553D938B29C1",
      "text": "Ganz genau, eine wunderbare Erklärung![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc02_0060_fairybb_21",
      "hash64": "8269543D938B280E",
      "text": "Wo Sie es gerade erwähnen... Was ist eigentlich\\ndiese spezielle Substanz im Kern der Kuppel?\\c\\nDazu gibt es keine öffentlichen Informationen,\\noder?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
