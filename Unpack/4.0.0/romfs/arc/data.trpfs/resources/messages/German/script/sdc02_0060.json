    },
    {
      "ordinal": 46,
      "label": "sdc02_0060_fairybb_28",
      "hash64": "82694D3D938B1C29",
      "text": "Hm, meiner Meinung nach macht es mehr Spaß,\\ndie Tera-Kuppel im Alleingang zu erkunden.\\c\\nEine Führung, bei der man jemand anderem\\nfolgen muss, wäre da wahrscheinlich eher lästig...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
