        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0060_fairybb_02",
      "hash64": "826FC33D93905059",
      "text": "Die [VAR 0xFF00(0006)]Tera-Kuppel[VAR 0xFF00(0000)]![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
