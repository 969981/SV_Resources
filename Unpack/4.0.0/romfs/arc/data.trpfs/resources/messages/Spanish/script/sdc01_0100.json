      "hash64": "6ED1B9A3196FDDD3",
      "text": "Te llamabas [VAR 0x0100(0000)], ¿no?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
