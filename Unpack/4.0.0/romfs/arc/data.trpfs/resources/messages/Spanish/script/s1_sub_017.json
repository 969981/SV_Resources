  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_017_man_01",
      "hash64": "C22C7AA9C24788E6",
      "text": "Oye, tío, menudo[VAR 0x1101(00FD,0100)]s Pokémon te gastas, ¿en?",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
