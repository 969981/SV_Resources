      ]
    },
    {
      "ordinal": 10,
      "label": "gym_kusa_040_kusa_04",
      "hash64": "C851624498B05538",
      "text": "¡Eso denota que tienes sensibilidad para el arte![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_kusa_040_kusa_05",
      "hash64": "C851634498B056EB",
      "text": "Espero que no me defraudes y que muestres en\\ncombate ese gusto por lo artístico.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
