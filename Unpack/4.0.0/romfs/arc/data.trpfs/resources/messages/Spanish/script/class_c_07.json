      "ordinal": 0,
      "label": "class_c_07_history_01",
      "hash64": "1E1E4EEDD0C2B0A6",
      "text": "¡Buenas, cabecillas pensantes!\\nUn día más viejos, un día más sabios.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
