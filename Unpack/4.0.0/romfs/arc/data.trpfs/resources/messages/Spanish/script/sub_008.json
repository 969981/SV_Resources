          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sub_008_master_02",
      "hash64": "800BD54176DAD3D0",
      "text": "¿Quieres someter a alguno de tus Pokémon al\\nEntrenamiento Extremo?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_008_master_03",
      "hash64": "800BD64176DAD583",
      "text": "¿A cuál vas a elegir?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_008_master_cancel",
      "hash64": "A65424BE9F55C27C",
      "text": "Ven a verme cuando estés list[VAR 0x1100(00FF,0101)]oa.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
