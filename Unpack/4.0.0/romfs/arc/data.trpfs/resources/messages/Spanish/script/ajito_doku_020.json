      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_doku_020_cassiopeia_02",
      "hash64": "BDF6B7D267EEA478",
      "text": "Esta es la base del grupo Veneno del Team Star,\\ntambién conocido como Escuadrón Tsih.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_doku_020_cassiopeia_03",
      "hash64": "BDF6B8D267EEA62B",
      "text": "Su jefe, Henzo, es todo un manitas y se ocupa de\\ndiseñar los trajes del equipo.\\c\\nUn tipo bastante... peculiar, la verdad.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
