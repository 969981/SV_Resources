    {
      "ordinal": 27,
      "label": "gym_mushi_020_select_01",
      "hash64": "8B7B0826C1D6E9A3",
      "text": "¡Quiero seguir!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "gym_mushi_020_select_02",
      "hash64": "8B7B0926C1D6EB56",
      "text": "Mejor lo dejo",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "gym_mushi_020_trainer_19",
      "hash64": "5BE4B32D0541B7D3",
      "text": "¡Oye, que tomar el atajo es parte del examen!\\nVoy a pararte los pies ahora mismo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "gym_mushi_020_trainer_21",
      "hash64": "5BEEAB2D0549FEC0",
      "text": "¡Eres tan fuerte que incluso las aceitunas te abren\\npaso!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "gym_mushi_020_trainer_20",
      "hash64": "5BEEAC2D054A0073",
      "text": "Intento incordiar a todos los que participan en la\\naceitunada para que entiendan lo laborioso que\\r\\nes cultivar aceitunas.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
