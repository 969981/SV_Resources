  "entries": [
    {
      "ordinal": 0,
      "label": "sub_016_system_kui_01",
      "hash64": "4C38F1CE9AE28A93",
      "text": "Hay una estaca negra y siniestra clavada...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_016_system_kui_02",
      "hash64": "4C38F2CE9AE28C46",
      "text": "¿Quieres extraerla?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_016_system_kui_03",
      "hash64": "4C38F3CE9AE28DF9",
      "text": "¡Al intentar extraerla, se ha deshecho en\\npedazos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_016_system_kui_04",
      "hash64": "4C38F4CE9AE28FAC",
      "text": "Wooo...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_016_system_kui_05",
      "hash64": "4C38F5CE9AE2915F",
      "text": "Te ha parecido oír una voz misteriosa en la\\ndirección del santuario...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_016_system_release_01",
      "hash64": "0D38A4AA29FEC449",
      "text": "Se oye un sonido distante proveniente del\\ninterior del santuario...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_016_system_release_02",
      "hash64": "0D38A1AA29FEBF30",
      "text": "¿Quieres tocar el santuario?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_016_system_release_03",
      "hash64": "0D38A2AA29FEC0E3",
      "text": "Clin, clin, clin...\\n¡¡Clin, clin, clin, clin!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_016_system_release_07",
      "hash64": "0D38A6AA29FEC7AF",
      "text": "¡¡¡Clooonc!!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_016_system_release_04",
      "hash64": "0D38A7AA29FEC962",
      "text": "¡¡Chieeen!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_016_system_release_05",
      "hash64": "0D38A8AA29FECB15",
      "text": "¡Wo-Chien ha quedado sellado en el santuario\\nde nuevo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_016_system_release_06",
      "hash64": "0D38A5AA29FEC5FC",
      "text": "Parece que la puerta del santuario no podrá\\nabrirse durante un tiempo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_016_system_hokora_01",
      "hash64": "5E2F0FED1EB3D91C",
      "text": "Hay una inscripción tallada en la entrada al\\nsantuario, apenas legible...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_016_system_hokora_02",
      "hash64": "5E2F12ED1EB3DE35",
      "text": "\"Aquí residen selladas las Tablillas de la\\nDebacle\".",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_016_system_hokora_03",
      "hash64": "5E2F11ED1EB3DC82",
      "text": "\"El sello que retenía a las Tablillas de la Debacle\\nha sido destruido\".",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
