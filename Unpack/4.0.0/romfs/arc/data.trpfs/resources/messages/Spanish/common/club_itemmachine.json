  "entries": [
    {
      "ordinal": 0,
      "label": "club_itemmachine_msg_first_00",
      "hash64": "6C76D0975AF7CD8E",
      "text": "Gracias por ofrecerte a probar mi impresora\\nde objetos.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "club_itemmachine_msg_first_01",
      "hash64": "6C76D1975AF7CF41",
      "text": "¡Yo soy su inventora! Marie, del Club de Ciencia.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "club_itemmachine_msg_first_02",
      "hash64": "6C76CE975AF7CA28",
      "text": "La idea es ir de sala en sala enseñando a la gente\\nde los demás clubes a usarla.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "club_itemmachine_msg_first_03",
      "hash64": "6C76CF975AF7CBDB",
      "text": "¡Así que vamos a ello! A ver...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "club_itemmachine_msg_first_04",
      "hash64": "6C76D4975AF7D45A",
      "text": "La impresora de objetos es un aparato que te\\npermite convertir materiales y puntos arándano\\r\\nen toda clase de objetos.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "club_itemmachine_msg_first_05",
      "hash64": "6C76D5975AF7D60D",
      "text": "¿Que cómo funciona exactamente?\\c\\n¡Eso es secreto! Todavía estoy esperando a que\\nme aprueben las patentes...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "club_itemmachine_msg_first_06",
      "hash64": "6C76D2975AF7D0F4",
      "text": "En fin, a lo que iba.\\c\\n¡Es un aparato maravilloso capaz de convertir\\nmateriales en objetos como por arte de magia!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "club_itemmachine_msg_first_07",
      "hash64": "6C76D3975AF7D2A7",
      "text": "Nunca sabes lo que te va a salir y, además, es\\nmuy fácil de usar, ya lo verás.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "club_itemmachine_msg_start_00",
      "hash64": "47D2451C8CF88184",
      "text": "¿Quieres imprimir algún objeto?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
