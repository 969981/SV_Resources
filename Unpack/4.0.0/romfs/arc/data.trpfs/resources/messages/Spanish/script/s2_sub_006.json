    },
    {
      "ordinal": 5,
      "label": "s2_sub_006_boy_06",
      "hash64": "078D6145277CD75C",
      "text": "¡Buah, qué fuerte! ¡Ojalá yo también tuviera uno!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
