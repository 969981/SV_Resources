            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc01_side01_020_select_07",
      "hash64": "F3A40110EE588DFB",
      "text": "¡Venga, vamos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "sdc01_side01_020_select_08",
      "hash64": "F3A3FE10EE5888E2",
      "text": "No lo veo claro...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "sdc01_side01_020_brother_40",
      "hash64": "A032CA35E0521056",
      "text": "¡Ay, qué bien que quieras ir! No sabes las ganas\\nque tenía de enseñártela.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc01_side01_020_brother_41",
      "hash64": "A032CB35E0521209",
      "text": "Que no te asuste el nombre, no es para tanto.\\nVa, que me hace mucha ilu enseñártela...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc01_side01_020_brother_42",
      "hash64": "A032C835E0520CF0",
      "text": "Tú sube por ahí un buen rato, hasta que veas\\nuna bifurcación con dos carteles.\\c\\nA la izquierda está el Paso del Averno, pero, si\\ngiras a la derecha, llegarás a la Gruta del Pavor.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 181,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "sdc01_side01_020_brother_43",
      "hash64": "A032C935E0520EA3",
      "text": "Me voy adelantando. Te espero arriba, ¿vale?\\n¡Hasta ahora![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
