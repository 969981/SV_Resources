      "hash64": "237871EE06E9D2F5",
      "text": "¡Bienvenid[VAR 0x1100(00FF,0101)]oa! En el mostrador de la entrada\\ntomarán nota de tu pedido.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
