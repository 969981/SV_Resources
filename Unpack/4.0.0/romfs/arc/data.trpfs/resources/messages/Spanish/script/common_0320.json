    {
      "ordinal": 9,
      "label": "common_0320_friend_03",
      "hash64": "BC71D15D2B33EE65",
      "text": "Has decidido tomar la salida este, ¿no?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
