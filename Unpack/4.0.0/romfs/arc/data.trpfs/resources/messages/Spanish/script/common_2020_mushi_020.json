    },
    {
      "ordinal": 12,
      "label": "common_2020_mushi_020_mushi_13",
      "hash64": "83DBAD0936B28FF5",
      "text": "¡Así que eso mismo pienso hacer a partir de este\\ninstante![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
