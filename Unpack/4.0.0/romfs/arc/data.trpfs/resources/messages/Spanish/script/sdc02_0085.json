    },
    {
      "ordinal": 1,
      "label": "sdc02_0085_sister_01",
      "hash64": "3A154A7B04EB5DCC",
      "text": "¡Hola, [VAR 0x0100(0000)]! ¡Soy yo, Corin![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
