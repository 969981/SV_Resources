          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0085_sister_02",
      "hash64": "3A154D7B04EB62E5",
      "text": "¡¿Es verdad que te han invitado a venir de\\nintercambio a la Academia Arándano?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0085_sister_03",
      "hash64": "3A154C7B04EB6132",
      "text": "¡Je, je! Me lo ha chivado la profe. ¡Qué guay,\\nno me puedo creer que te vaya a ver aquí![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0085_sister_04",
      "hash64": "3A15477B04EB58B3",
      "text": "¡Oye! ¿Y esto a qué viene? Mis fuentes me lo han\\nconfirmado ya, no me vengas con cuentos.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0085_sister_05",
      "hash64": "3A15467B04EB5700",
      "text": "Ya estamos tardando en vernos, ¿eh?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0085_sister_06",
      "hash64": "3A15497B04EB5C19",
      "text": "A ver... Te habrán hablado del Biodomo, ¿no?[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0085_sister_07",
      "hash64": "3A15487B04EB5A66",
      "text": "Pues justo en el centro hay un lugar llamado\\nPlaza Cúbica. Nos vemos allí.\\c\\nNi se te ocurra hacerme esperar, o te vas a\\nenterar de lo que es bueno.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
