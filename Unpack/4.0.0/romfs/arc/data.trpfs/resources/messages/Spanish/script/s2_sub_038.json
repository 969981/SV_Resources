  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_038_man_01",
      "hash64": "04DCA3FBE2124FD0",
      "text": "¡Ten cuidado! Te advierto que soy muy peligroso.\\n¡Será mejor que te mantengas alejad[VAR 0x1100(00FF,0101)]oa de mí!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_sub_038_man_02",
      "hash64": "04DCA6FBE21254E9",
      "text": "Déjame solo, por favor...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_038_man_03",
      "hash64": "04DCA5FBE2125336",
      "text": "...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_038_man_04",
      "hash64": "04DCA8FBE212584F",
      "text": "Espera... ¿Es posible que seas... como yo?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_038_man_05",
      "hash64": "04DCA7FBE212569C",
      "text": "¿Entonces tú también...? ¿Tú también has oído\\nuna \"voz\" que te llamaba?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_038_man_06",
      "hash64": "04DCAAFBE2125BB5",
      "text": "Lo suponía... ¿Qué es lo que te ha traído hasta\\neste lugar?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_038_select_01",
      "hash64": "2C3001979E4B352C",
      "text": "Me ha guiado la luz",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_038_select_02",
      "hash64": "2C3004979E4B3A45",
      "text": "Me ha guiado el viento",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_038_select_03",
      "hash64": "2C3003979E4B3892",
      "text": "Me ha guiado la oscuridad",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s2_sub_038_select_04",
      "hash64": "2C2FFE979E4B3013",
      "text": "He llegado de casualidad",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_038_select_05",
      "hash64": "2C2FFD979E4B2E60",
      "text": "No tengo ni idea",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_038_man_07",
      "hash64": "04DCA9FBE2125A02",
      "text": "Así que la luz... No, creo que me equivocaba\\ncontigo...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_038_man_08",
      "hash64": "04DCACFBE2125F1B",
      "text": "¡¿Así que te ha guiado el viento?! Qué cosas...\\nSí, la verdad es que suena bastante poético...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s2_sub_038_man_09",
      "hash64": "04DCABFBE2125D68",
      "text": "La oscuridad... Sí... La oscuridad nos trata bien\\ny nos priva de las sensaciones que normalmente\\r\\napesadumbrarían nuestros lóbregos corazones...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_038_man_10",
      "hash64": "04D93EFBE20F6E5A",
      "text": "¿De casualidad? Vaya respuesta más vaga...\\c\\n¿Por qué no piensas un poco mejor en lo que\\nte ha conducido hasta mí?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_038_man_11",
      "hash64": "04D93FFBE20F700D",
      "text": "¿Tú también languideces? ¿Cedes bajo el peso\\nde la pena?... No, no hablo contigo... Hablo...\\r\\ncon tu mano.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_038_select_06",
      "hash64": "2C3000979E4B3379",
      "text": "¿La derecha?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s2_sub_038_select_07",
      "hash64": "2C2FFF979E4B31C6",
      "text": "¿La izquierda?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "s2_sub_038_man_12",
      "hash64": "04D93CFBE20F6AF4",
      "text": "¿La derecha?... Te pido disculpas, debo de haber\\nvisto mal...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s2_sub_038_man_13",
      "hash64": "04D93DFBE20F6CA7",
      "text": "¡Sí! ¡Lo sabía! ¡Eres como yo!... Tú y yo somos\\nalmas gemelas...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "s2_sub_038_man_14",
      "hash64": "04D93AFBE20F678E",
      "text": "Para ti, mi alma gemela, no hay secretos que\\nvalgan. Compartiré contigo la misteriosa seña\\r\\nde un corazón apesadumbrado.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_sub_011_system_01",
      "hash64": "340BF1E47E73D21E",
      "text": "¡El chico te ha enseñado el gesto [VAR 0xFF00(0008)]Agarrar mano[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_038_man_npc",
      "hash64": "C1792A01F38D539A",
      "text": "¡Mi alma gemela! No dejes que el pesar que\\natormenta tu mano izquierda te engulla.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
