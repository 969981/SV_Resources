    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_d_01_clerk_05",
      "hash64": "743803B7EE25698B",
      "text": "Me temo que... Ains... Está bien, supongo que\\nharé una excepción.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_d_01_dragonbb_03",
      "hash64": "4196A1A64BDC8217",
      "text": "Je, je. ¡Gracias, máquina![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
