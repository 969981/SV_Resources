      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_2020_esper_010_select_02",
      "hash64": "5D4C73E974ED2C57",
      "text": "Lo mismo digo",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_esper_010_esper_03a",
      "hash64": "FE4BCEAA032E697C",
      "text": "¡Ju, ju! Me encanta que tengas tanta confianza.\\nEspero que nunca la pierdas.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
