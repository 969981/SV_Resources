  "entries": [
    {
      "ordinal": 0,
      "label": "gym_esper_020_receptionist_01",
      "hash64": "9C27AD88C6C617B9",
      "text": "¡Bienvenid[VAR 0x1100(00FF,0101)]oa al Gimnasio de Pueblo Alforno!\\n¿Quieres escuchar de nuevo la explicación?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
