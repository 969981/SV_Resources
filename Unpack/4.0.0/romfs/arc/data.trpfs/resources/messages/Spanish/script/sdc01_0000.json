          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0000_ecology_04",
      "hash64": "5772ADE9CF9E054F",
      "text": "¡Resulta que tú estás entre los alumnos elegidos\\npara ir, [VAR 0x0100(0000)]![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
