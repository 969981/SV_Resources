    },
    {
      "ordinal": 2,
      "label": "sdc01_0300_sister_03",
      "hash64": "0E4A0EC22ADDB1C3",
      "text": "Las rocas de esta zona siempre están iluminadas,\\npor alguna extraña razón. Qué curioso, ¿no?\\c\\nY la guinda es ese rumor de que aquí te puedes\\ntopar con gente que ha pasado a mejor vida.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
