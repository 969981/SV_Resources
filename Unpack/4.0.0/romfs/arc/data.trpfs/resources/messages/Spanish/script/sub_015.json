  "entries": [
    {
      "ordinal": 0,
      "label": "sub_015_system_kui_01",
      "hash64": "CBD71E33F4417D1E",
      "text": "Hay una estaca negra y siniestra clavada...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_015_system_kui_02",
      "hash64": "CBD71D33F4417B6B",
      "text": "¿Quieres extraerla?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_015_system_kui_03",
      "hash64": "CBD71C33F44179B8",
      "text": "¡Al intentar extraerla, se ha deshecho en\\npedazos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_015_system_kui_04",
      "hash64": "CBD72333F441859D",
      "text": "Paooo...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_015_system_kui_05",
      "hash64": "CBD72233F44183EA",
      "text": "Te ha parecido oír una voz misteriosa en la\\ndirección del santuario...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_015_system_release_01",
      "hash64": "2F7176EB24844F78",
      "text": "Se oye un sonido distante proveniente del\\ninterior del santuario...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_015_system_release_02",
      "hash64": "2F7179EB24845491",
      "text": "¿Quieres tocar el santuario?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_015_system_release_03",
      "hash64": "2F7178EB248452DE",
      "text": "Clin, clin, clin...\\n¡¡Clin, clin, clin, clin!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_015_system_release_07",
      "hash64": "2F717CEB248459AA",
      "text": "¡¡¡Clooonc!!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_015_system_release_04",
      "hash64": "2F717BEB248457F7",
      "text": "¡¡Chieeen!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_015_system_release_05",
      "hash64": "2F717AEB24845644",
      "text": "¡Chien-Pao ha quedado sellado en el santuario\\nde nuevo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_015_system_release_06",
      "hash64": "2F717DEB24845B5D",
      "text": "Parece que la puerta del santuario no podrá\\nabrirse durante un tiempo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_015_system_hokora_01",
      "hash64": "375C3504754E3827",
      "text": "Hay una inscripción tallada en la entrada al\\nsantuario, apenas legible...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_015_system_hokora_02",
      "hash64": "375C3604754E39DA",
      "text": "\"Aquí reside sellada la Espada de la Debacle\".",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_015_system_hokora_03",
      "hash64": "375C3704754E3B8D",
      "text": "\"El sello que retenía a la Espada de la Debacle\\nha sido destruido\".",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
