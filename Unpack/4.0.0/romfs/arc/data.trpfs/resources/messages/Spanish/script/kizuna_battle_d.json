          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_battle_d_system_01",
      "hash64": "FDB0D9B2C190B2E5",
      "text": "¡Te has ganado la amistad de Kendra!",
