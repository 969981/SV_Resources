    {
      "ordinal": 0,
      "label": "ajito_doku_010_sitappa_01",
      "hash64": "FE3FE6E5CC9BDE5B",
      "text": "¿Por qué no te piras por donde has venido, eh?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_doku_010_student_01",
      "hash64": "8FC7CE649BB09D04",
      "text": "¡No! ¡Tengo que ver al jefe del grupo Veneno\\ncomo sea! ¡Llévame ante don Henzo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "ajito_doku_010_sitappa_02",
      "hash64": "FE3FE7E5CC9BE00E",
      "text": "¡Y dale! Él mismo nos ha pedido que no dejemos\\npasar a nadie que no forme parte del Team Star,\\r\\n¡así que largo![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_doku_010_student_02",
      "hash64": "8FC7D1649BB0A21D",
      "text": "¡Y yo te digo que no pienso moverme de aquí\\nhasta que haya podido hablar con don Henzo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "ajito_doku_010_sitappa_03",
      "hash64": "FE3FE8E5CC9BE1C1",
      "text": "Tenía que venir el plasta de turno a tocarme\\nlas narices...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_doku_010_system_01",
      "hash64": "C90A82F2B8B9430C",
      "text": "Parece que alguien está teniendo una discusión.\\n¿Qué quieres hacer?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
