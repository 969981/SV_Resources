            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_doku_010_student_04",
      "hash64": "8FC7CB649BB097EB",
      "text": "¡Un momento, señor Recluta! ¿Est[VAR 0x1100(00FF,0101)]ea de aquí no es\\n[VAR 0x0100(0000)]?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
