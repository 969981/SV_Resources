    },
    {
      "ordinal": 22,
      "label": "s2_sub_004_dokuboss_09",
      "hash64": "3977866B72C14C13",
      "text": "Espero contar con vuestro apoyo en el futuro.[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
