    {
      "ordinal": 6,
      "label": "s2_sub_041_synchro_add_01",
      "hash64": "A20963AB7E34341A",
      "text": "¡Genial! Venga, vayamos al lugar del\\nexperimento.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_041_synchro_add_02",
      "hash64": "A20962AB7E343267",
      "text": "Necesitas llevar a algún Pokémon fuera de la\\nPoké Ball para este experimento.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_041_synchro_add_03",
      "hash64": "A20961AB7E3430B4",
      "text": "¡Avísame cuando estés list[VAR 0x1100(00FF,0101)]oa![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
