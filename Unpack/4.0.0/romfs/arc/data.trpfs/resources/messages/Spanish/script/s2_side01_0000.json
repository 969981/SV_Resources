          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_side01_0000_system_02",
      "hash64": "E9779061F010DFF9",
      "text": "Y jurarías que se ha movido ligeramente...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_side01_0000_system_03",
      "hash64": "E9778F61F010DE46",
      "text": "♪Rotom, tom...\\nRotom, tom...♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_side01_0000_friend_01",
      "hash64": "A84FD78B63CAAC2F",
      "text": "¡[VAR 0x0100(0000)]! ¡Buenas! Soy yo, Damián.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0000_friend_02",
      "hash64": "A84FD88B63CAADE2",
      "text": "Oye, ¡que ya me he enterado!\\c\\nQue si campamentos, que si intercambios...\\n¡Menuda aventura! No paras quiet[VAR 0x1100(00FF,0101)]oa, ¿eh?[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0000_select_01",
      "hash64": "BF719182D239233B",
      "text": "¡Estuvo genial!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0000_select_02",
      "hash64": "BF719282D23924EE",
      "text": "Bueno, tampoco fue para tanto",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0000_friend_03",
      "hash64": "A84FD98B63CAAF95",
      "text": "Buah, ¡qué envidia me das! Me habría encantado\\nir contigo.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0000_friend_04",
      "hash64": "A84FD28B63CAA3B0",
      "text": "¡No me seas sosainas! ¿Ahora vas de madur[VAR 0x1100(00FF,0101)]oa\\npor la vida o qué?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side01_0000_friend_05",
      "hash64": "A84FD38B63CAA563",
      "text": "No sé cómo lo haces, pero desde que ingresaste\\nen la academia no han parado de pasarte cosas.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0000_friend_06",
      "hash64": "A84FD48B63CAA716",
      "text": "Seguro que has tenido mucho lío últimamente.\\n¿Se ha calmado ya un poco la cosa?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0000_friend_07",
      "hash64": "A84FD58B63CAA8C9",
      "text": "Verás, es que te llamaba para preguntarte que,\\nsi tienes tiempo y te apetece, claro...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side01_0000_friend_08",
      "hash64": "A84FDE8B63CAB814",
      "text": "¿Por qué no quedamos en tu casa? ¿Qué me\\ndices?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side01_0000_select_03",
      "hash64": "BF719382D23926A1",
      "text": "¡Cuando quieras!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s2_side01_0000_select_04",
      "hash64": "BF719482D2392854",
      "text": "¿Y eso?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "s2_side01_0000_friend_09",
      "hash64": "A84FDF8B63CAB9C7",
      "text": "¿De verdad? ¡Genial! Así me gusta, que podamos\\nvernos prontito. ¡Me encanta la gente decidida![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side01_0000_friend_10",
      "hash64": "A8535C8B63CDC405",
      "text": "No es por nada en particular. Es lo que hacen\\nlos buenos amigos, ¿no? Eh...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side01_0000_friend_11",
      "hash64": "A8535B8B63CDC252",
      "text": "Bueno, ¡pues no se hable más![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side01_0000_friend_12",
      "hash64": "A8535A8B63CDC09F",
      "text": "Vivías en Pueblo Cahíz, ¿verdad?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side01_0000_friend_13",
      "hash64": "A853598B63CDBEEC",
      "text": "Vale, pues nos vemos delante de tu casa.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_side01_0000_system_04",
      "hash64": "E9779261F010E35F",
      "text": "¿...?",
      "flags": 0,
