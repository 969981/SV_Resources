            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_bb4kings_dragon_randomtalk_00",
      "hash64": "8E0EAA7E32F9DEC5",
      "text": "¿A que te has pensado que lo que llevo a la\\ncintura es una falda?\\c\\n¡Je, je, je! ¡Pues no! Es mi capa, que la llevo ahí\\natada porque así mola más.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "coach_bb4kings_dragon_randomtalk_01",
      "hash64": "8E0EA97E32F9DD12",
      "text": "Estudiar se me da pésimo, ¿sabes? He repetido\\ncurso como tres veces ya...\\c\\n¡Pero yo lo veo como algo bueno! Así puedo\\ndisfrutar de la vida en la academia más tiempo.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "coach_bb4kings_dragon_randomtalk_02",
      "hash64": "8E0EA87E32F9DB5F",
      "text": "Benditas sean las sillas, en serio. ¿Qué sería de\\nla vida sin ellas? Te lo digo yo: un asco.\\c\\nHabiendo sillas, no entiendo cómo la gente se\\nqueda de pie. ¡De verdad que no lo entiendo![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
