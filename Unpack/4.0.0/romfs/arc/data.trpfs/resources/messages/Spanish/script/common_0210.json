    {
      "ordinal": 9,
      "label": "common_0210_rival_10",
      "hash64": "38E6CE67BE59CBF3",
      "text": "Para fabricar MT, para pagar en las tiendas...\\n¡si es que los puntos de liga son hipermegaútiles!\\c\\nTengo la cuenta a rebosar, así que te voy a\\ntransferir unos cuantos, ¿vale?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
