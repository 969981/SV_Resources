        }
      ]
    },
    {
      "ordinal": 1,
      "label": "atlantis_talk_06_rival_02",
      "hash64": "A26ABCCFE7B6F08F",
      "text": "Y luego vivió durante un tiempo en el Área Cero\\njunto a[VAR 0x1107(00FF,0A0D)] la profesoral profesor y otro ejemplar, ¿no?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0A0D"
