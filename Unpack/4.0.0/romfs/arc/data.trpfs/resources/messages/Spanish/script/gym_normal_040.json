            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_normal_040_gym_receptionist_02",
      "hash64": "E493B744D381D438",
      "text": "Si quieres enfrentarte a nuestro líder Laureano,\\nhabla con el camarero del Mesón El Tesoro.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_normal_040_receptionist_00",
      "hash64": "0EB8253E4E40262A",
      "text": "¡Bienvenid[VAR 0x1100(00FF,0101)]oa al Mesón El Tesoro, patrocinador del\\nGimnasio de Pueblo Mestura!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_normal_040_receptionist_01",
      "hash64": "0EB8263E4E4027DD",
      "text": "¿Quieres enfrentarte al Líder de Gimnasio\\nLaureano, el Oficinista Extraordinario?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_normal_040_receptionist_02",
      "hash64": "0EB8233E4E4022C4",
      "text": "En tal caso, dirígete a la arena de combate.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_normal_040_receptionist_03",
      "hash64": "0EB8243E4E402477",
      "text": "Avísame cuando estés list[VAR 0x1100(00FF,0101)]oa, no hay prisa.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_normal_040_receptionist_05",
      "hash64": "0EB8223E4E402111",
      "text": "¡Laureano! ¡Te toca!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_normal_040_normal_01",
      "hash64": "E4ECB2AC02E1AAE5",
      "text": "Hola.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_normal_040_normal_02",
      "hash64": "E4ECAFAC02E1A5CC",
      "text": "Yo soy Laureano y desempeño labores de Líder\\nde Gimnasio en Pueblo Mestura.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_normal_040_normal_03",
      "hash64": "E4ECB0AC02E1A77F",
      "text": "Enhorabuena por haber aprobado el examen.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_normal_040_normal_04",
      "hash64": "E4ECADAC02E1A266",
      "text": "Por cierto... Aquí todo les sale rico, no solo los\\nonigiris. Deberías probar los otros platos.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_normal_040_normal_05",
      "hash64": "E4ECAEAC02E1A419",
      "text": "Pero no nos liemos hablando o mi superiora se\\nenfadará. Vamos a lo que nos toca.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_normal_040_normal_06",
      "hash64": "E4ECABAC02E19F00",
      "text": "Por la presente, yo, Laureano, te emplazo a un\\ncombate Pokémon ahora mismo.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_normal_040_normal_07",
      "hash64": "E4ECACAC02E1A0B3",
      "text": "Posees una fuerza fuera de lo común. Se lee la\\nestupefacción en mi rostro.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_normal_040_normal_08",
      "hash64": "E4ECB9AC02E1B6CA",
      "text": "Como me has ganado, tendría que entregarte\\nla medalla de turno.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_normal_040_normal_09",
      "hash64": "E4ECBAAC02E1B87D",
      "text": "Pero tanto combatir me ha abierto el apetito.\\n¿Te apetece comer conmigo?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_normal_040_normal_badge",
      "hash64": "3B461CE2FFA60749",
      "text": "Con [VAR 0x0200(0001)] medalla[VAR 0x1101(0001,0100)]s en tu inventario, resulta más fácil\\natrapar Pokémon de hasta Nv. [VAR 0x0201(0002)]...\\r\\nE incluso te hacen caso cuando les dices algo.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_normal_040_normal_badge_all",
      "hash64": "36909BBFC4BE01F9",
      "text": "He oído que cuando tienes las ocho medallas\\npuedes atrapar Pokémon de cualquier nivel más\\r\\nfácilmente... Y no te ignoran si les pides algo.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_normal_040_normal_10",
      "hash64": "E4F037AC02E4C2BB",
      "text": "Aquí todo está rico y sabe a lo que tiene que\\nsaber. Es lo normal, ¿no?[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_normal_040_normal_waza",
      "hash64": "8A8AE8E413551DA3",
      "text": "Por cierto, toma esto. Tienes buena presencia,\\nasí que quizá no te haga ni falta, pero acéptalo.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_normal_040_normal_11",
      "hash64": "E4F036AC02E4C108",
      "text": "Y no te preocupes por la cuenta, que invito yo.\\nPara algo trabajo.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_normal_040_normal_12",
      "hash64": "E4F039AC02E4C621",
      "text": "Atentamente, me despido.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_normal_040_receptionist_04",
      "hash64": "0EB8213E4E401F5E",
      "text": "¡Enhorabuena por superar el Gimnasio de Pueblo\\nMestura!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
