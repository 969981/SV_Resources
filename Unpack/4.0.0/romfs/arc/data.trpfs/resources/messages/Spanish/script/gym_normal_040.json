      "hash64": "E493BA44D381D951",
      "text": "Bienvenid[VAR 0x1100(00FF,0101)]oa de nuevo, [VAR 0x0100(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
