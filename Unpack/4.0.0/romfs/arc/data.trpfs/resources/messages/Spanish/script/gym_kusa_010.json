    },
    {
      "ordinal": 4,
      "label": "gym_kusa_010_receptionist_history",
      "hash64": "A60C21835437EBCC",
      "text": "Verás, Pueblo Altamía es una villa que se\\ncaracteriza por su devoción al arte.\\c\\nY aquí tenemos una costumbre para dar la\\nbienvenida a los foráneos.\\c\\nConsiste en hacer que reúnan Sunflora, Pokémon\\nque representan la inspiración de la naturaleza\\r\\nen nuestras obras de arte y la gratitud al sol por\\r\\nhacerla crecer.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
