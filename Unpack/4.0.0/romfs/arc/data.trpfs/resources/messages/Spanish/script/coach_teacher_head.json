    {
      "ordinal": 32,
      "label": "coach_teacher_head_sp03_05",
      "hash64": "768C0122D18AC254",
      "text": "Hmm...\\c\\nAquí dan mucha importancia a los combates\\nPokémon y a la independencia del alumnado.\\c\\nPuedo imaginar que eso se haya ganado tu\\ncorazón.[VAR 0x0114(000A)]",
