    {
      "ordinal": 34,
      "label": "coach_teacher_head_sp03_05c",
      "hash64": "FAA8252A0EC80375",
      "text": "Hmm...\\c\\nCiertamente, el Biodomo es ideal para observar\\na los Pokémon en su hábitat natural.\\c\\nAunque no creo que la naturaleza de Paldea\\ntenga nada que envidiarle.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
