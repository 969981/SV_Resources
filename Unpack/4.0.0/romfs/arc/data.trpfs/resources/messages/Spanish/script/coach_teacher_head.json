          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_head_sp01_04b",
      "hash64": "498688639CD57F69",
      "text": "¿Acaso ha ocurrido algo?\\c\\nPiensa que, si no te sintieras a gusto por el\\nmotivo que fuere, siempre puedes regresar.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
