    },
    {
      "ordinal": 5,
      "label": "coach_teacher_head_sp01_02",
      "hash64": "F2D94814D3A25777",
      "text": "Como tu director, no podría estar más orgulloso.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
