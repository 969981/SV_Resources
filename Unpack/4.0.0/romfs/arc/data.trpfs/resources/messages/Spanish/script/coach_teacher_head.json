    {
      "ordinal": 13,
      "label": "coach_teacher_head_sp02_01",
      "hash64": "4C0E092E1AF37F9D",
      "text": "¿Como, por un suponer... que el director Mirtilo\\nte haya estado avasallando o mareando con\\r\\nideas descabelladas?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
