          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_head_sp02_select_01",
      "hash64": "66926F384EBEA96C",
      "text": "No, todo va bien",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_head_sp02_select_02",
      "hash64": "669272384EBEAE85",
      "text": "No, se porta bien conmigo",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_head_sp02_02",
      "hash64": "4C0E062E1AF37A84",
      "text": "Entiendo... Me alivia oírlo.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_head_sp02_03",
      "hash64": "4C0E072E1AF37C37",
      "text": "Hace mucho tiempo, cuando apenas éramos unos\\njovenzuelos, el director Mirtilo y yo fuimos\\r\\ncompañeros de universidad.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_head_sp02_04",
      "hash64": "4C0E042E1AF3771E",
      "text": "Por aquel entonces, ya me importunaba a mí\\ncon sus comentarios.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_head_sp02_05",
      "hash64": "4C0E052E1AF378D1",
      "text": "¿Sabes qué me dijo cuando me ascendieron a\\ndirector de la academia?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_head_sp02_06",
      "hash64": "4C0E022E1AF373B8",
      "text": "\"¡Oyeee, Clavelín! Como tampoco tienes mucha\\nplanta que digamos, ¿por qué no te cuelgas unas\\r\\nHonor Balls de la cintura?\".[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_head_sp02_07",
      "hash64": "4C0E032E1AF3756B",
      "text": "Comentarios de ese cariz estaban a la orden del\\ndía... Y yo, tonto de mí, voy y le sigo la corriente.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_head_sp02_08",
      "hash64": "4C0E002E1AF37052",
      "text": "Lo único que quiero decir es que, si algo te\\npreocupara, puedes contármelo.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
