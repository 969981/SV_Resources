          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_head_sp01_03",
      "hash64": "F2D94714D3A255C4",
      "text": "¿Qué tal marcha todo en la Academia Arándano?\\n¿Te adaptas bien al nuevo entorno?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_head_sp01_select_01",
      "hash64": "1BE69E4EC3A02AE9",
      "text": "¡Estupendamente!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_head_sp01_select_02",
      "hash64": "1BE69B4EC3A025D0",
      "text": "Más o menos...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_head_sp01_04",
      "hash64": "F2D94614D3A25411",
      "text": "Me alegra sobremanera tu respuesta. Fue un\\nacierto enviarte aquí.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
