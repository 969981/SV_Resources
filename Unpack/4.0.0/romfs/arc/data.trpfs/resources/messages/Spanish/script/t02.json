    {
      "ordinal": 6,
      "label": "t02_03",
      "hash64": "B8FB95ABB6AED9B7",
      "text": "Aaah... ¡Ay, qué sed tenía!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
