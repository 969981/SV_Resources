    {
      "ordinal": 4,
      "label": "t02_01",
      "hash64": "B8FB97ABB6AEDD1D",
      "text": "Los Centros Pokémon son perfectos para quedar\\ncon los amigos.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
