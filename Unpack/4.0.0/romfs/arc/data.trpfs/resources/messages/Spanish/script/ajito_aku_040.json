            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "ajito_aku_040_select_01",
      "hash64": "36FB30E5FE02D53E",
      "text": "Así es",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "ajito_aku_040_select_02",
      "hash64": "36FB2FE5FE02D38B",
      "text": "Pues no",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "ajito_aku_040_akuboss_14",
      "hash64": "B7BD032A84205C6A",
      "text": "Hmm... Y dime una cosa: ¿te lo pasas bien allí?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "ajito_aku_040_select_03",
      "hash64": "36FB2EE5FE02D1D8",
      "text": "Superbién",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "ajito_aku_040_select_04",
      "hash64": "36FB35E5FE02DDBD",
      "text": "No mucho",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "ajito_aku_040_akuboss_15",
      "hash64": "B7BD042A84205E1D",
      "text": "Ya veo. Hmm...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "ajito_aku_040_nelke_01",
      "hash64": "141F57B4A3D0E657",
      "text": "¡Qué pasa! Tú eres Anán, ¿no?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "ajito_aku_040_akuboss_16",
      "hash64": "B7BD012A84205904",
      "text": "¡Ostras, un tupé con patas! ¿Qué hay, tío?\\n¿Le has pedido a un Quaxly que te peine?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "ajito_aku_040_nelke_02",
      "hash64": "141F58B4A3D0E80A",
      "text": "¿Puedo hablar contigo un segundo?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_aku_040_akuboss_17",
      "hash64": "B7BD022A84205AB7",
      "text": "Uf, no sé por qué me da que va a ser un peñazo.\\nPero no tengo nada mejor que hacer. Dispara.[VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "ajito_aku_040_nelke_03",
      "hash64": "141F59B4A3D0E9BD",
      "text": "[EMPTY 62]",
