    {
      "ordinal": 4,
      "label": "a_sch_room03_eve07",
      "hash64": "8AA0F155E0D179C4",
      "text": "¡Pikachu es taaan mono! ¡Incluso de espaldas!",
      "flags": 0,
      "text_status": "DECODED",
