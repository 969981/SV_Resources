          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_012_announce_intro_01",
      "hash64": "97756463206B20C6",
      "text": "¡El cocinero legendario!\\n¡Damián, de la clase de 2.º G!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_012_announce_intro_02",
      "hash64": "97756363206B1F13",
      "text": "¡La hacker estelar!\\n¡Noa, de la clase de 1.º D!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_012_announce_intro_03",
      "hash64": "97756263206B1D60",
      "text": "¡Nuestra querida profesora de Combate!\\nLa apasionada... ¡Kendra!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_012_announce_intro_04",
      "hash64": "97756963206B2945",
      "text": "¡Nuestra querida profesora de Matemáticas!\\nLa experta en aritmética... ¡Mila!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_012_announce_intro_05",
      "hash64": "97756863206B2792",
      "text": "¡Nuestra querida profesora de Historia!\\nLa intrépida exploradora del pasado... ¡Cloe!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_012_announce_intro_06",
      "hash64": "97756763206B25DF",
      "text": "¡Nuestra querida experta en salud!\\nEl ángel de la enfermería... ¡Mimí!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sub_012_announce_intro_07",
      "hash64": "97756663206B242C",
      "text": "¡Nuestro querido profesor de Hogar!\\nDuro por fuera, tierno por dentro... ¡Hugo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_012_announce_intro_08",
      "hash64": "97756D63206B3011",
      "text": "¡Nuestro querido profesor de Biología!\\nEl simpático y enrollado... ¡Cinio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sub_012_announce_intro_09",
      "hash64": "97756C63206B2E5E",
      "text": "¡Nuestro querido profesor de Lingüística!\\nEl gran comunicador... ¡Silvio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sub_012_announce_intro_10",
      "hash64": "9771DF63206808F0",
      "text": "¡La delegada estudiantil más fuerte de la historia!\\n¡La Campeona Mencía!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sub_012_announce_intro_11",
      "hash64": "9771E06320680AA3",
      "text": "¡El director de la academia en persona!\\nEl hombre de exquisitos modales... ¡Clavel!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sub_012_announce_intro_12",
      "hash64": "9771E16320680C56",
      "text": "¡Nuestro querido profesor de Arte!\\nEl dragón rugiente... ¡Hesperio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sub_012_announce_intro_13",
      "hash64": "9771E26320680E09",
      "text": "La superintendenta de la academia y\\nSupercampeona... ¡Ságita!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sub_012_chara_01_01",
      "hash64": "EB3B7AECC59255DD",
      "text": "Vaya, tenías que ser tú. Bueno, ¡lo tomaré como\\nuna oportunidad única para probar mi fuerza![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sub_012_chara_01_02",
      "hash64": "EB3B77ECC59250C4",
      "text": "Meh, otra derrota más para la lista. ¡Si es que\\ncontra ti no había posibilidad, amig[VAR 0x1100(00FF,0101)]oa![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sub_012_chara_02_01",
      "hash64": "9206BAD37E412F6A",
      "text": "Mis Vivis no se echarán atrás ni aunque me toque\\ncontra ti.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sub_012_chara_02_02",
      "hash64": "9206B9D37E412DB7",
      "text": "Te sales de fuerte, como siempre. Y lo peor de\\ntodo es que me siento orgullosa.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sub_012_chara_03_01",
      "hash64": "E86C66DB19AABCDF",
      "text": "¡Ey, novatill[VAR 0x1100(00FF,0101)]oa! Has encontrado la horma de tu\\nzapato. ¡Prepárate para perder![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sub_012_chara_03_02",
      "hash64": "E86C67DB19AABE92",
      "text": "Mal que me pese, reconozco la derrota.\\n¡Suerte en el siguiente combate![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sub_012_chara_04_01",
      "hash64": "1A117704D2E3CAC4",
      "text": "Anda, [VAR 0x0100(0000)].\\nVamos a tomárnoslo con calma, ¿eh?[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sub_012_chara_04_02",
      "hash64": "1A117A04D2E3CFDD",
      "text": "Ah, tendrías que haberme conocido en mis años\\nmozos... ¡Sigue esforzándote así![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sub_012_chara_05_01",
      "hash64": "EF2663101BEF8699",
      "text": "Estoy lista para analizar y descifrar el secreto de\\ntu fuerza.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sub_012_chara_05_02",
      "hash64": "EF2660101BEF8180",
      "text": "La historia la escriben los vencedores. Rubrícala\\ny reclama el trono.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sub_012_chara_06_01",
      "hash64": "95F1A2F6D49E6026",
      "text": "Aish, vaya apodo más cutre... Pues nada, si soy\\nun ángel... ¡libremos un combate divino![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sub_012_chara_06_02",
      "hash64": "95F1A1F6D49E5E73",
      "text": "Dalo todo en el siguiente, ¿eh? Y, si te haces\\ndaño, pasa por la enfermería.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sub_012_chara_07_01",
      "hash64": "C3ABAEFD377A0DBB",
      "text": "Me complace combatir contra ti. Deja que te\\nmuestre de lo que soy capaz.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sub_012_chara_07_02",
      "hash64": "C3ABAFFD377A0F6E",
      "text": "¡Impresionante! ¿Qué decir de tu fuerza salvo\\nque es digna de un[VAR 0x1100(00FF,0A08)] Campeóna Campeona?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0A08"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sub_012_chara_08_01",
      "hash64": "34C79EA363FADA50",
      "text": "¡Qué honor combatir contra ti, [VAR 0x0100(0000)]!\\nHazme un favor: ¡nada de contenernos! ¿Vale?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sub_012_chara_08_02",
      "hash64": "34C7A1A363FADF69",
      "text": "¡Ole! Y ahora hazme otro favor y gana de mi\\nparte al resto de participantes.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sub_012_chara_09_01",
      "hash64": "6061AAA9C5082185",
      "text": "Let's go, my dear [VAR 0x0100(0000)]!\\nAquí no hay retirada ni rendición que valga.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sub_012_chara_09_02",
      "hash64": "6061A7A9C5081C6C",
      "text": "Ay, me temo que es el fin de mi intervención.\\nBye-bye, sayōnara![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sub_012_chara_10_01",
      "hash64": "2E080F1B4ECA5BAB",
      "text": "¡Yujuuu! ¡Qué guay que estemos tú y yo en la\\nfinalísima!\\c\\n¡Ahí va un combate épico entre Campeon[VAR 0x1100(00FF,0101)]eas![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
