    {
      "ordinal": 0,
      "label": "common_2090_staff_01",
      "hash64": "C4F4EF63999FC327",
      "text": "¿Quieres inscribirte en la Gran Pugna\\nAcadémica?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_2090_staff_02",
      "hash64": "C4F4F063999FC4DA",
      "text": "Te llamas [VAR 0x0100(0000)] y tienes el rango de\\nCampe[VAR 0x1100(00FF,0302)]ónona, ¿cierto?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2090_staff_03",
      "hash64": "C4F4F163999FC68D",
      "text": "Ya he completado tu inscripción.\\nPuedes dirigirte a la arena de combate.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_012_announce_00",
      "hash64": "835D61A437E8925A",
      "text": "¡Bienvenidos a una nueva edición de la\\nGran Pugna Académica!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_012_announce_01",
      "hash64": "835D62A437E8940D",
      "text": "¡Damos paso a la primera ronda de combates!\\n¿Quiénes se enfrentarán en el duelo de hoy?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_012_announce_02",
      "hash64": "835D5FA437E88EF4",
      "text": "Damos paso ahora a la segunda ronda.\\n¿Quiénes medirán sus fuerzas a continuación?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_012_announce_03",
      "hash64": "835D60A437E890A7",
      "text": "¡Hemos llegado a las ansiadas semifinales!\\nTan solo quedan cuatro Entrenadores en liza.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_012_announce_04",
      "hash64": "835D5DA437E88B8E",
      "text": "Ahora ya solo quedan dos contendientes en pie.\\n¡Ha llegado la hora de la gran final!\\c\\n¿Quién posee la mayor de las fuerzas?\\nTodo se decidirá entre estos dos portentos.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_012_announce_intro_00",
      "hash64": "97756563206B2279",
      "text": "[VAR 0x1100(00FF,0B0A)]El CampeónLa Campeona [VAR 0x0100(0000)] contra...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0B0A"
