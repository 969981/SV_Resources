    },
    {
      "ordinal": 50,
      "label": "coach_gym_nomal_randomtalk_01",
      "hash64": "36566BE3B8700B7F",
      "text": "Espero que la súper no te esté encasquetando\\ntodo el trabajo una vez más.\\c\\nAprende a negarte a tiempo o no tendrás un\\nsegundo de respiro, créeme.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
