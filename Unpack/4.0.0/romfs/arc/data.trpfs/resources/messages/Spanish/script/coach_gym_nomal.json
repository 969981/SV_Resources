    {
      "ordinal": 1,
      "label": "coach_gym_nomal_first_01",
      "hash64": "42D22C0900D222B6",
      "text": "Me llamo Laureano. Encantado de cono...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
