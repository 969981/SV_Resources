      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_f_02_dragon_05",
      "hash64": "29271335F9FB32F1",
      "text": "¡Os presento al profesor Gible![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
