    },
    {
      "ordinal": 7,
      "label": "class_f_02_poke_02",
      "hash64": "877FFF16215C5BF2",
      "text": "¡Giiible!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_f_02_dragon_07",
      "hash64": "29271135F9FB2F8B",
      "text": "Mediante el uso de un Orbe Teracristal, los\\nPokémon pueden experimentar un fenómeno\\r\\ndenominado teracristalización.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
