          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_f_02_dragon_16",
      "hash64": "292A8235F9FE2565",
      "text": "¡Y obtener una bella victoria![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
