      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_language_d_select_01",
      "hash64": "4C9EA760060359BA",
      "text": "¿Y si se queda aquí?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_language_d_select_02",
      "hash64": "4C9EA66006035807",
      "text": "¿Por qué no te lo quedas?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "kizuna_language_d_08a",
      "hash64": "F9F39B0FC766334B",
      "text": "¿Aquí? ¿En la academia?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_language_d_08b",
      "hash64": "F9F39C0FC76634FE",
      "text": "¡Vaya! No esperaba esa respuesta.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_language_d_09",
      "hash64": "C7790865D9074E1B",
      "text": "Hmm... Puede que tengas razón... Quizá lo mejor\\nsea que se quede en la academia conmigo.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_language_d_10",
      "hash64": "C77C0565D9097ED9",
      "text": "Estaba tan empeñado en curarlo y ponerlo en\\nlibertad que ni se me había ocurrido.[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_language_d_11",
      "hash64": "C77C0465D9097D26",
      "text": "¿Qué te parece la idea, Pawmi?\\n¿Quieres quedarte conmigo?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_language_d_poke_03",
      "hash64": "9D5A164D2E32E64B",
      "text": "...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_language_d_poke_04",
      "hash64": "9D5A1B4D2E32EECA",
      "text": "Pawmi...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_language_d_12",
      "hash64": "C77C0365D9097B73",
      "text": "¡Pawmi! ¡Ha... ha hablado![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_language_d_13",
      "hash64": "C77C0265D90979C0",
      "text": "¡Aun sin dominar el idioma de los Pokémon,\\nsé de sobra que eso era un rotundo \"sí\"![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_language_d_14",
      "hash64": "C77C0965D90985A5",
      "text": "De nuevo: thank you, my dear [VAR 0x0100(0000)].[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_language_d_16",
      "hash64": "C77C0765D909823F",
      "text": "No sé si será el regalo más indicado para\\nagradecer tu ayuda, pero aquí tienes:\\r\\nun Pokémon muy poco común.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_language_d_system_02",
      "hash64": "652DA48DF72792D4",
      "text": "¡El profesor Silvio te ha entregado un Meowth!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "kizuna_language_d_15",
      "hash64": "C77C0865D90983F2",
      "text": "¡Qué alegría! ¡Te prometo que cuidaré de Pawmi\\ncomo se merece! ¡Tienes mi palabra![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_language_d_system_01",
      "hash64": "652DA78DF72797ED",
      "text": "¡Te has ganado la amistad de Silvio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
