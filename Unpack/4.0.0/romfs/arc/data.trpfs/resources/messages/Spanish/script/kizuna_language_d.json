      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_language_d_07",
      "hash64": "C7790665D9074AB5",
      "text": "[VAR 0xBD06(0000)]Dime, [VAR 0x0100(0000)], ¿qué crees que debería\\nhacer?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
