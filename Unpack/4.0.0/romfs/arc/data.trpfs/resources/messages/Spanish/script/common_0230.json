    {
      "ordinal": 5,
      "label": "common_0230_head_teacher_01",
      "hash64": "C0DB5822B31FB3B4",
      "text": "Hola, [VAR 0x0100(0000)]. Hola, Mencía.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
