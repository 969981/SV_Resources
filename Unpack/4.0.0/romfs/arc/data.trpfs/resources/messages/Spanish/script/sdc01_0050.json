    {
      "ordinal": 16,
      "label": "sdc01_0050_sister_15",
      "hash64": "02AFAB5163FE58AC",
      "text": "Oye, mira... Has durado más de lo que esperaba.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
