    {
      "ordinal": 14,
      "label": "sdc01_0050_brother_06",
      "hash64": "6A1E76D8B21FCD84",
      "text": "¡Ofú! ¡Eres casi tan fuerte como Corin![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
