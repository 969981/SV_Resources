    {
      "ordinal": 15,
      "label": "sdc01_0050_sister_10",
      "hash64": "02AFA85163FE5393",
      "text": "Qué rabia... ¡Tú lo que has tenido es potra![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
