          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0050_sister_13",
      "hash64": "02AFA95163FE5546",
      "text": "Arg, tenía que llegar este...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0050_sister_14",
      "hash64": "02AFAC5163FE5A5F",
      "text": "Vamos, enano. Nos piramos de aquí.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
