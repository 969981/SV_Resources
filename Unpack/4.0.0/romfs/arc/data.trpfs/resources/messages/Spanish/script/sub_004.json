      "text": "Salir",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_004_chose_1_after",
      "hash64": "2A420F8B49E0B7AC",
      "text": "¡Muy bien! Pues ya sabes, ¡a hacer rodar la\\naceituna y a desear una buena cosecha!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
