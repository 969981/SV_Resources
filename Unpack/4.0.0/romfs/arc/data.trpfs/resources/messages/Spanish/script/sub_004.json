    {
      "ordinal": 2,
      "label": "sub_004_01",
      "hash64": "93AEF6B5DB5A8D28",
      "text": "Enhorabuena por haber derrotado a Araceli en el\\nGimnasio de Pueblo Pirotín.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_004_02",
      "hash64": "93AEF9B5DB5A9241",
      "text": "Ahora que tienes su medalla, puedes participar\\nen una versión especial de la aceitunada.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_004_03",
      "hash64": "93AEF8B5DB5A908E",
      "text": "En ella, se registrará el tiempo que tardes en\\ncompletarla.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_004_04",
      "hash64": "93AEFBB5DB5A95A7",
      "text": "Si consigues una buena marca, recibirás un\\nregalillo estupendo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_004_05",
      "hash64": "93AEFAB5DB5A93F4",
      "text": "¿Quieres participar en la aceitunada especial?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_004_chose_1",
      "hash64": "4FB821B325D7CD5D",
      "text": "Participar",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_004_chose_2",
      "hash64": "4FB81EB325D7C844",
      "text": "Ver récord",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
