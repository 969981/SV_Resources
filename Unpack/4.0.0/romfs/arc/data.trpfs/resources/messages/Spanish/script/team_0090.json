      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "team_0090_cassiopeia_12",
      "hash64": "40994A6F65777B34",
      "text": "Sabes que el Team Star se formó originalmente\\npor estudiantes que estaban sufriendo acoso...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
