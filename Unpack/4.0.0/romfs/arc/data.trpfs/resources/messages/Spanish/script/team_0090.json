          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "team_0090_cassiopeia_13",
      "hash64": "40994B6F65777CE7",
      "text": "Al poco de formarse, hubo un enfrentamiento\\nentre los jefes y los abusones en cuestión.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "team_0090_cassiopeia_14",
      "hash64": "4099486F657777CE",
      "text": "El resultado fue una victoria aplastante del Team\\nStar. No les llegaron ni a la suela del zapato.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "team_0090_cassiopeia_15",
      "hash64": "4099496F65777981",
      "text": "Por no llegar, no llegaron ni a combatir, porque\\nlos abusones acabaron renunciando en bloque.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "team_0090_cassiopeia_16",
      "hash64": "4099466F65777468",
      "text": "El Team Star les metió tanto miedo en el cuerpo\\nque, al final, dejaron la academia uno tras otro.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "team_0090_cassiopeia_17",
      "hash64": "4099476F6577761B",
      "text": "Y esa es la razón de que el Team Star terminase\\npor ganarse tan mala fama...[VAR 0x0114(0009)]",
