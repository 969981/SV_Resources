          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_botan_c_select_01",
      "hash64": "8AB98C4D1ECCC26F",
      "text": "¿Pasa algo?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_botan_c_select_02",
      "hash64": "8AB98D4D1ECCC422",
      "text": "¿A qué has venido?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_botan_c_03",
      "hash64": "0E996FB5BB587BF6",
      "text": "Pues verás...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_botan_c_04",
      "hash64": "0E9972B5BB58810F",
      "text": "E-está corriendo un rumor muy raro: que el Team\\nStar planea una operación en el taller de Arte.\\r\\nY claro, me ha entrado la preocupación...[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_botan_c_05",
      "hash64": "0E9971B5BB587F5C",
      "text": "Aunque en mi opinión será una chorrada que se\\nhan inventado los que todavía les tienen miedo.[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_botan_c_06",
      "hash64": "0E9974B5BB588475",
      "text": "No tendría sentido que fuera verdad. ¿Qué clase\\nde operación iban a querer realizar aquí?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_botan_c_hono_01",
      "hash64": "32C34BE2DE9BCEED",
      "text": "¿Se puede? ¡Bah, como si no![VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_botan_c_07",
      "hash64": "0E9973B5BB5882C2",
      "text": "¡Uah! ¡Pues han venido![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_botan_c_kakutou_01",
      "hash64": "BC38D191D225A331",
      "text": "¡Esa escultura de Staraptor es una pasada!\\nParece que está a punto de utilizar A Bocajarro.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_botan_c_hono_02",
      "hash64": "32C348E2DE9BC9D4",
      "text": "Eh, tú, pardillo. ¿Eres del club de Arte?[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_botan_c_student_01",
      "hash64": "FAD62A53CBFFD714",
      "text": "Ah, s-sí, lo soy...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_botan_c_hono_03",
      "hash64": "32C349E2DE9BCB87",
      "text": "...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_botan_c_08",
      "hash64": "0E9976B5BB5887DB",
      "text": "N-no me creo que esto esté pasando de verdad.\\n¡¿Eran ciertos los rumores?![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_botan_c_09",
      "hash64": "0E9975B5BB588628",
      "text": "No, no puede ser. Qué tontería. De momento\\nveamos qué pasa...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_botan_c_student_02",
      "hash64": "FAD62D53CBFFDC2D",
      "text": "Esto... ¿Buscabais algo?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_botan_c_hono_04",
      "hash64": "32C346E2DE9BC66E",
      "text": "Pueees... Es que... Venía a que...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_botan_c_student_03",
      "hash64": "FAD62C53CBFFDA7A",
      "text": "¿A que qué?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "kizuna_botan_c_hono_05",
      "hash64": "32C347E2DE9BC821",
      "text": "¡A que como me vaciles, la lío![VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_botan_c_10",
      "hash64": "0E9608B5BB55971A",
      "text": "¡Ay, que sí es una operación! ¡Un asalto![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_botan_c_kakutou_02",
      "hash64": "BC38CE91D2259E18",
      "text": "¡Meli, no te sulfures![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_botan_c_kakutou_03",
      "hash64": "BC38CF91D2259FCB",
      "text": "Entiendo que te dé vergüenza contestar, pero\\nno tienes por qué ponerte tan a la defensiva\\r\\npara disimular.[VAR 0x0114(0022)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_botan_c_hono_06",
      "hash64": "32C344E2DE9BC308",
      "text": "S-sí, tienes razón, Eri... Perdona.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_botan_c_hono_07",
      "hash64": "32C345E2DE9BC4BB",
      "text": "A ver, es que... me gustaría unirme... al club,\\nsi se puede...[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_botan_c_student_04",
      "hash64": "FAD62753CBFFD1FB",
      "text": "¡Ah, vienes a apuntarte! Perdona, no me lo\\nesperaba. ¡Menudo susto me has metido!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "kizuna_botan_c_student_05",
      "hash64": "FAD62653CBFFD048",
      "text": "A ver... Cualquiera se puede apuntar al club,\\nclaro, pero...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "kizuna_botan_c_kakutou_04",
      "hash64": "BC38D491D225A84A",
      "text": "¡Qué bien, Meli![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_botan_c_hono_08",
      "hash64": "32C342E2DE9BBFA2",
      "text": "Espera, Eri. Lo has cortado a mitad de frase.\\nSeguro que iba a poner alguna pega, ¿a que sí?[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_botan_c_student_06",
      "hash64": "FAD62953CBFFD561",
      "text": "Ah, no. Solo iba a preguntarte por qué te querías\\nunir al club. Mera curiosidad.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "kizuna_botan_c_hono_09",
      "hash64": "32C343E2DE9BC155",
      "text": "¿Que por qué?...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_botan_c_hono_10",
      "hash64": "32C6B0E2DE9EB063",
      "text": "Es que... esto que llevo puesto me lo ha hecho\\nun colega y tal. Las botas también.[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_botan_c_hono_11",
      "hash64": "32C6AFE2DE9EAEB0",
      "text": "Y como me gusta tanto la ropa con llamas\\npintadas, quiero hacer mis propios diseños...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "kizuna_botan_c_hono_12",
      "hash64": "32C6B2E2DE9EB3C9",
      "text": "¡Por eso me molaría aprender a pintar![VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "kizuna_botan_c_hono_13",
      "hash64": "32C6B1E2DE9EB216",
      "text": "Tengo cero experiencia con el tema, eso sí.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_botan_c_hono_14",
      "hash64": "32C6B4E2DE9EB72F",
      "text": "Pero al ver ese churro de Fletchling en la pared\\nme doy cuenta de que no pasa nada si me sale\\r\\nun pintarrajo, con tal de que tenga su encanto.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "kizuna_botan_c_student_07",
      "hash64": "FAD62853CBFFD3AE",
      "text": "¿Te refieres al cuadro de Fletchling que hay en\\nel taller? Ese... lo he pintado yo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "kizuna_botan_c_hono_15",
      "hash64": "32C6B3E2DE9EB57C",
      "text": "¡¿En serio?! Yo pensaba que sería de algún niño\\ndel parvulario.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "kizuna_botan_c_student_08",
      "hash64": "FAD62353CBFFCB2F",
      "text": "Ja, ja... No eres la primera que me dice algo así.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "kizuna_botan_c_mobs_01",
      "hash64": "B969FCA4B7C06176",
      "text": "La sencillez de los cuadros de nuestro presi es su\\nmejor cualidad.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "kizuna_botan_c_hono_16",
      "hash64": "32C6B6E2DE9EBA95",
      "text": "Anda, ¿tú eres el presidente del club?[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "kizuna_botan_c_mobs_02",
      "hash64": "B969FBA4B7C05FC3",
      "text": "¿Cómo te llamas? Ya que te has apuntado,\\ntendrás que decirnos tu nombre.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "kizuna_botan_c_mobs_03",
      "hash64": "B969FAA4B7C05E10",
      "text": "Oye, ¡me encantan tus botas! ¿Las puedo ver en\\ndetalle?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "kizuna_botan_c_hono_17",
      "hash64": "32C6B5E2DE9EB8E2",
      "text": "Ah, esto... Me llamo Melo y... si te has fijado en\\nmis botas, eso es que tienes buen gusto.\\c\\nMe las ha hecho un colega que es muy friki de\\nestas cosas.[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 153,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "kizuna_botan_c_11",
      "hash64": "0E9609B5BB5598CD",
      "text": "O sea, que lo del rumor era un malentendido...\\c\\nAun así, no tenía ni idea de que Meli quisiera\\nexplorar su vena artística...[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "kizuna_botan_c_kakutou_05",
      "hash64": "BC38D591D225A9FD",
      "text": "¡Qué ganas de ver sus cuadros! ¿A que sí?[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "kizuna_botan_c_12",
      "hash64": "0E9606B5BB5593B4",
      "text": "Ya...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "kizuna_botan_c_13",
      "hash64": "0E9607B5BB559567",
      "text": "¡Aaah, Eri! ¡¿Cómo nos has visto?![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "kizuna_botan_c_kakutou_06",
      "hash64": "BC38D291D225A4E4",
      "text": "¿Cómo no iba a veros? Estáis a plena vista.\\nMe he acercado a ver qué hacíais.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "kizuna_botan_c_kakutou_07",
      "hash64": "BC38D391D225A697",
      "text": "Pero creo que Meli no se ha dado cuenta.\\nEstá tan nerviosa la pobre...[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "kizuna_botan_c_14",
      "hash64": "0E9604B5BB55904E",
      "text": "Pensaba que Meli era inmune a los nervios.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "kizuna_botan_c_kakutou_08",
      "hash64": "BC38C891D22593E6",
      "text": "A todo el mundo le da un poquito de miedo\\nprobar cosas nuevas. Por eso he venido a darle\\r\\napoyo moral. Pero creo que no me necesita.[VAR 0x0114(0022)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "kizuna_botan_c_kakutou_09",
      "hash64": "BC38C991D2259599",
      "text": "Por cierto, hablando de hacer cosas nuevas...\\nAlba y yo hemos fundado un club de lucha libre.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "kizuna_botan_c_kakutou_10",
      "hash64": "BC3C5691D228BB07",
      "text": "Estoy dispuesta a disfrutar a tope del tiempo que\\nme queda en la academia, ¡igual que Meli![VAR 0x0114(0022)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "kizuna_botan_c_kakutou_11",
      "hash64": "BC3C5591D228B954",
      "text": "Bueno, os dejo. ¡Me ha encantado veros!\\n¡Astro la vista![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "kizuna_botan_c_15",
      "hash64": "0E9605B5BB559201",
      "text": "...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "kizuna_botan_c_16",
      "hash64": "0E9602B5BB558CE8",
      "text": "Meli y Eri se están esforzando un montón por\\nintegrarse en la academia, ¿no crees?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "kizuna_botan_c_17",
      "hash64": "0E9603B5BB558E9B",
      "text": "En fin, yo también me marcho. Astro la vista...[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    }
  ]
}
