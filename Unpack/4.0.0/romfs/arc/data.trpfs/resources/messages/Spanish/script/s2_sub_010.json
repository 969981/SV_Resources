          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s2_sub_010_head_10",
      "hash64": "15B2F7B8135AB752",
      "text": "Insisto: ¿podría dejar de llamarme Clavelín\\ndelante de los alum...?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
