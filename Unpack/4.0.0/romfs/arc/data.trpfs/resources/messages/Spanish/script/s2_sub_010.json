      "hash64": "5055D90A700B24B7",
      "text": "[VAR 0xBD06(0000)]Uy, pero si es [VAR 0x0100(0000)]. ¿Qué haces tú\\npor aquí?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
