            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_sub_010_headbb_first_select_01",
      "hash64": "46A11261D8481D4E",
      "text": "Vengo a hablar",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_010_headbb_first_select_02",
      "hash64": "46A11161D8481B9B",
      "text": "¿Y usted?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_010_headbb_first_02",
      "hash64": "5055DA0A700B266A",
      "text": "¿Conmigo? ¡Vaya, me halagas![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_010_headbb_first_03",
      "hash64": "5055DB0A700B281D",
      "text": "Pues aquí me tienes, disfrutando de la brisa\\nmarina con la mirada perdida en el infinito...\\c\\nY esperando a que alguien se digne a iniciar un\\ncombate interesante.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 163,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_010_headbb_first_04",
      "hash64": "5055D40A700B1C38",
      "text": "Ah, por cierto, y antes de que se me vaya de la\\ncabeza... ¿Qué tal llevas la Pokédex Arándano?[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_010_headbb_first_05",
      "hash64": "5055D50A700B1DEB",
      "text": "Puedes mostrármela cuando te apetezca, si crees\\nque ya has progresado lo suficiente.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_010_headbb_first_06",
      "hash64": "5055D60A700B1F9E",
      "text": "Y, si logras completarla, vas a saber lo que es un\\nbuen aluvión de alabanzas.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_010_headbb_01",
      "hash64": "11282969A285005C",
      "text": "¡Qué tal, [VAR 0x0100(0000)]![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_010_headbb_02",
      "hash64": "11282C69A2850575",
      "text": "A ver, a ver... Hasta ahora has capturado...\\n¡[VAR 0x0202(0001)] especie[VAR 0x1101(0001,0100)]s de Pokémon en el Biodomo![VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0202",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_010_headbb_03",
      "hash64": "11282B69A28503C2",
      "text": "Poquita cosa de momento, pero todo se andará.\\c\\nAl fin y al cabo, acabas de llegar a la academia,\\ncomo quien dice.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_sub_010_headbb_04",
      "hash64": "11282669A284FB43",
      "text": "Ya has reunido unos cuantos, ¿eh?\\c\\nPiensa que tienes varias áreas que puedes\\npatearte. ¡A la aventura sin miedo![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_010_headbb_05",
      "hash64": "11282569A284F990",
      "text": "Ya has registrado bastantes, ¿eh?\\c\\n¿A que es impresionante la cantidad de especies\\ndiferentes que tenemos por aquí?\\c\\nY todo gracias a un sistema de climatización que\\nes el no va más. ¡No hemos reparado en gastos![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 216,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_010_headbb_06",
      "hash64": "11282869A284FEA9",
      "text": "¡Ya has registrado un montonazo!\\c\\nYa para lo que te queda, complétala, ¿no?\\n¡Te falta nada y menos![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_010_headbb_07",
      "hash64": "11282769A284FCF6",
      "text": "¡Uy! ¡No me digas que los has registrado todos\\ntoditos![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_010_headbb_08",
      "hash64": "11283269A2850FA7",
      "text": "¡Has completado la Pokédex Arándano! ¡Olé tú!\\n¡No puedo más que felicitarte![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_010_headbb_09",
      "hash64": "11283169A2850DF4",
      "text": "Ahora tenemos más datos que nunca de todas las\\nespecies de Pokémon que habitan el Biodomo,\\r\\n¡y todo gracias a ti![VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_sub_010_headbb_10",
      "hash64": "1124A469A281E886",
      "text": "Esto que has hecho tiene mucho mérito, ¿eh?\\nPiensa que nadie lo había logrado hasta ahora.\\c\\n¡Ni siquiera nuestros alumnos, y eso que estudian\\na tiempo completo aquí![VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_sub_010_headbb_11",
      "hash64": "1124A569A281EA39",
      "text": "¡Es un momento histórico! Toma, te mereces un\\nseñor premio a la altura de la hazaña.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_sub_010_head_01",
      "hash64": "15B67CB8135DCF28",
      "text": "He aquí al director Mirtilo y a [VAR 0x0100(0000)].\\c\\n¿Qué tal marcha el programa de intercambio?\\n¿Progresa adecuadamente?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_sub_010_headbb_12",
      "hash64": "1124A269A281E520",
      "text": "¡Pero si es mi Clavelín! ¿Qué tal?\\c\\nPues mira, me alegra que me hagas esa pregunta,\\nporque resulta que [VAR 0x0100(0000)]...[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_sub_010_head_02",
      "hash64": "15B67FB8135DD441",
      "text": "¡Qué me dice![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_010_head_03",
      "hash64": "15B67EB8135DD28E",
      "text": "Veo que sigues forjando tu leyenda dondequiera\\nque vas. No esperaba menos de ti.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_sub_010_headbb_13",
      "hash64": "1124A369A281E6D3",
      "text": "Je, je, je... Ya sabía yo que no me equivocaba.\\n¡Sigo teniendo muy buen ojo para la gente![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_sub_010_head_04",
      "hash64": "15B681B8135DD7A7",
      "text": "La emoción del director Mirtilo no deja lugar a\\ndudas: tu labor ha sido encomiable.\\c\\nPermíteme a mí también darte la enhorabuena.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_sub_010_head_05",
      "hash64": "15B680B8135DD5F4",
      "text": "Y ahora corresponde premiar tu esfuerzo con el\\nconsabido y bien merecido diploma.\\c\\nTambién recibirás un mensaje por parte de la\\ncompañía certificadora de la Pokédex.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_sub_010_head_06",
      "hash64": "15B683B8135DDB0D",
      "text": "Podrás verlo cuando gustes solo con acceder a la\\naplicación.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_sub_010_headbb_14",
      "hash64": "1124A869A281EF52",
      "text": "¡Míralo, ahí le ha salido la vena de programador!\\nDi que sí, Clavelín, que para eso no hay edad.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_sub_010_head_07",
      "hash64": "15B682B8135DD95A",
      "text": "Oiga, que no soy tan mayor...[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s2_sub_010_head_08",
      "hash64": "15B675B8135DC343",
      "text": "Y, por enésima vez, preferiría que no se refiriera\\na mí con ese apelativo frente al alumnado.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_sub_010_headbb_15",
      "hash64": "1124A969A281F105",
      "text": "¡Huelga decir que tu búsqueda del tesoro está\\nsiendo un exitazo también en nuestra academia,\\r\\nvisto lo visto![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
