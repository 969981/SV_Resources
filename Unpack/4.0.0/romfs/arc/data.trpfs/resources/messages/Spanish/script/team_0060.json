      "hash64": "FD96721F923FAF2B",
      "text": "¡Eeeh! ¡Qué pasa, [VAR 0x0100(0000)]![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
