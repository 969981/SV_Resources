          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "team_0060_select_01",
      "hash64": "FE4584CC0003AA7A",
      "text": "¿Señor director?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "team_0060_select_02",
      "hash64": "FE4583CC0003A8C7",
      "text": "¡Qué pasa, Cael!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "team_0060_nelke_02",
      "hash64": "FD96731F923FB0DE",
      "text": "¿Aún seguimos con lo de director? Que me llamo\\nCael, colegui. Ca-el. Métetelo en la mollera.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "team_0060_nelke_03",
      "hash64": "FD96741F923FB291",
      "text": "Veo que ya vas captando cómo va la cosa.\\n¡Así me gusta![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "team_0060_nelke_04",
      "hash64": "FD96751F923FB444",
      "text": "Y ahora, rebobinemos. Como te iba diciendo\\nla otra vez...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "team_0060_nelke_05",
      "hash64": "FD96761F923FB5F7",
      "text": "Me acoplé a esto de la Operación Stardust para\\naclarar dos cosas.\\c\\nLa primera, por qué la están liando tan parda los\\ndel Team Star.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "team_0060_nelke_06",
      "hash64": "FD96771F923FB7AA",
      "text": "Y la segunda, por qué a la que alguien se une a\\nese grupo, ya no pisa un aula ni por accidente.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "team_0060_nelke_07",
      "hash64": "FD96781F923FB95D",
      "text": "En cierto sentido, se podría decir que Casiopea\\ny yo estamos en la misma onda... aunque en su\\r\\ncaso veo cierta obcecación con disolverlos sí o sí.[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "team_0060_nelke_08",
      "hash64": "FD96691F923F9FE0",
      "text": "¿Pero sabes una cosa? Toda esta movida me ha\\npermitido acercarme un poco más a ellos.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "team_0060_nelke_09",
      "hash64": "FD966A1F923FA193",
      "text": "Hablando se entiende la basca, como dicen por\\nmis lares. Nada como pararse un rato a charlar\\r\\ntranquilamente para ver por dónde van los tiros.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "team_0060_nelke_10",
      "hash64": "FD99F71F9242C701",
      "text": "Pero aún necesito más información.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "team_0060_nelke_11",
      "hash64": "FD99F61F9242C54E",
      "text": "Por eso quiero seguir hablando con miembros\\nde otros escuadrones del Team Star.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "team_0060_nelke_12",
      "hash64": "FD99F51F9242C39B",
      "text": "Así que ya sabes: cuando quieras ir a por otra de\\nsus bases, cuenta conmigo. ¡Nos vemos![VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    }
  ]
