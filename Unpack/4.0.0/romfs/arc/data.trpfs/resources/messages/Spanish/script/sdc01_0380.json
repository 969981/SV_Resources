          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0380_npc_key_02",
      "hash64": "0D51968EED9566B7",
      "text": "He visto al compatrón Okidogi paseando por\\nla zona del elíseo.\\c\\n¡Su bufanda morada es fabulosa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0380_npc_key_03",
      "hash64": "0D51958EED956504",
      "text": "Iba por la laguna y me he encontrado lo que\\npensaba que era alguien desmayado, ¡pero no!\\r\\nEra Munkidori echándose una siesta...\\c\\nNo le culpo, la verdad, por esa zona se está\\nmuy bien.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0380_system_02",
      "hash64": "12B9CEF5C1892D17",
      "text": "¡Has conseguido una pista sobre el paradero\\nde los compatrones!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_0380_system_03",
      "hash64": "12B9CDF5C1892B64",
      "text": "¡Has conseguido otra pista sobre el paradero\\nde los compatrones!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc01_0380_system_01",
      "hash64": "12B9CFF5C1892ECA",
      "text": "¡Ya has conseguido pistas acerca del paradero\\nde los tres compatrones! Ve a reunirte con Corin.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc01_0380_sister_01",
      "hash64": "3CE52BD6CB165B21",
      "text": "Separémonos para buscar testimonios de gente\\nque haya visto a los compatrones. Después, nos\\r\\nreuniremos para contrastar información.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
