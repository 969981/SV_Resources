    {
      "ordinal": 14,
      "label": "common_2110_mobs_02",
      "hash64": "2D42C16ACEC448A8",
      "text": "¡Qué primer combate tan espectacular!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "common_2110_friend_09",
      "hash64": "FF7D9E2F20C08D98",
      "text": "¡Uf, se nota que tienes madera de Campe[VAR 0x1100(00FF,0302)]ónona!\\c\\nMe da rabia haber perdido, pero ha sido un\\nhonor.[VAR 0x0114(0006)]",
