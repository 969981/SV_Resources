          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2110_friend_04",
      "hash64": "FF7D9B2F20C0887F",
      "text": "En el Área Cero me quedó bien claro que aún no\\ndaba la talla en cuanto a fuerza, que digamos.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
