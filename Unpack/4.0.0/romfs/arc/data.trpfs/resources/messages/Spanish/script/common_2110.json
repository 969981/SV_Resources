    {
      "ordinal": 2,
      "label": "common_2110_announce_03",
      "hash64": "1F70B47B0779903F",
      "text": "¡Damián, de la clase de 2.º G!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_2110_friend_01",
      "hash64": "FF7D962F20C08000",
      "text": "Que me haya tocado contra ti, con la diferencia\\nde nivel que hay, es un poco de risa...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
