          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2110_friend_02",
      "hash64": "FF7D992F20C08519",
      "text": "¿Qué? ¿Acaso te sorprende que yo también me\\nhaya apuntado al torneo?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2110_friend_03a",
      "hash64": "E2EC9F14A71EA4E5",
      "text": "Je, je, ¡tendrías que haber visto la cara que se te\\nha quedado![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2110_friend_03b",
      "hash64": "E2EC9C14A71E9FCC",
      "text": "¿Entonces ya te lo olías? Somos buenos amigos,\\nasí que tiene su lógica...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
