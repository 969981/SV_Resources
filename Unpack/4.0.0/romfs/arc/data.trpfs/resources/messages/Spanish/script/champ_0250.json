          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0250_dragon_03",
      "hash64": "6EE320E937D908B4",
      "text": "Aunque el hecho de que podamos enfrentarnos\\ntan pronto sobrepasa todas mis expectativas.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
