          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0250_dragon_02",
      "hash64": "6EE321E937D90A67",
      "text": "Ser testigo del crecimiento de un joven brote es\\nen verdad maravilloso.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
