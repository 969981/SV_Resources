  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_046_child_f_01",
      "hash64": "AF56210A305FD036",
      "text": "¿Me dejas que vea lo amigos que sois tu[VAR 0x1101(00FD,0100)]s\\nPokémon y tú?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sub_046_child_f_02",
      "hash64": "AF56200A305FCE83",
      "text": "¿A qué Pokémon quieres saber si le caes bien?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_046_child_f_03",
      "hash64": "AF561F0A305FCCD0",
      "text": "A ver, a ver... Vamos a ver qué tal os lleváis\\n[VAR 0x0102(0001)] y tú.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_046_child_f_04",
      "hash64": "AF56260A305FD8B5",
      "text": "¡Sois los mejores amigos del mundo mundial!\\n¡Estar juntos os hace muy felices!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_046_child_f_05",
      "hash64": "AF56250A305FD702",
      "text": "¡Sois muy buenos amigos! Puedo ver que los dos\\nos apreciáis mucho.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_046_child_f_06",
      "hash64": "AF56240A305FD54F",
      "text": "¡Pues sí, sois buenos amigos! Y os lo pasáis bien\\njuntos.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_046_child_f_07",
      "hash64": "AF56230A305FD39C",
      "text": "No os lleváis mal, pero podríais llevaros mejor\\naún.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_046_child_f_08",
      "hash64": "AF562A0A305FDF81",
      "text": "Estáis empezando a conoceros, así que seguro\\nque dentro de poco os llevaréis muy bien.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_046_child_f_09",
      "hash64": "AF56290A305FDDCE",
      "text": "Pues os lleváis... normal. ¡Pero espero que dentro\\nde un tiempo estéis a partir un piñón!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_046_child_f_10",
      "hash64": "AF529C0A305CB860",
      "text": "Os acabáis de conocer hace nada, ¿no?\\nSe nota que aún no os sentís muy cómodos.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_046_child_f_11",
      "hash64": "AF529D0A305CBA13",
      "text": "¡Pero bueno! ¿Ha pasado algo entre vosotros?\\nDiría que no os lleváis nada bien...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_046_child_f_12",
      "hash64": "AF529E0A305CBBC6",
      "text": "¡Tengo algo para celebrar lo bien que os lleváis!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_046_system_01",
      "hash64": "4DBAA28FEF755C82",
      "text": "¡[VAR 0x0102(0001)] ha recibido una Cinta Amistad!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_046_child_f_13",
      "hash64": "AF529F0A305CBD79",
      "text": "¡Vuelve cuando quieras!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_046_child_f_14",
      "hash64": "AF52A00A305CBF2C",
      "text": "Cuanto más tiempo pases con tus Pokémon,\\nmejor os llevaréis.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
