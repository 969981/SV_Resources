    {
      "ordinal": 1,
      "label": "team_0150_nelke_01",
      "hash64": "8E99782DDE19EAE7",
      "text": "Bonito desenlace, sí, señor.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
