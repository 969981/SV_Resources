      "ordinal": 16,
      "label": "sdc01_0430_sister_03",
      "hash64": "CBFF4FD8D0C276D1",
      "text": "¡¿P-pero qué?! ¿Qué mosca os ha picado?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
