          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0010_ecology_05",
      "hash64": "4FF118C5AFE06047",
      "text": "Es una academia que se encuentra en la región\\nde Teselia.\\c\\nBrie se encarga de coordinar los asuntos\\nacadémicos.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
