          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0010_bbteacher_10",
      "hash64": "D36B5783C78CBE7B",
      "text": "Este año le corresponde a la Academia Arándano\\nencargarse de la supervisión de los alumnos que\\r\\nparticipan en el campamento.\\c\\nPor eso he venido a recogerte, [VAR 0x0100(0000)].[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
