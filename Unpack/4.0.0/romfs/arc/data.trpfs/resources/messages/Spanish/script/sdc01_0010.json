    },
    {
      "ordinal": 14,
      "label": "sdc01_0010_bbteacher_09",
      "hash64": "D367DA83C789B43D",
      "text": "Bueno, como ya ha desvelado aquí nuestro\\namigo, me llamo Brie.\\c\\nSoy una de las docentes de la Academia\\nArándano.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
