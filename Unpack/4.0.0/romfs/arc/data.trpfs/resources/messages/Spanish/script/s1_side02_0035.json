    {
      "ordinal": 12,
      "label": "s1_side02_0035_select_01",
      "hash64": "66DDCC2DC348E231",
      "text": "¡No puede fallar!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s1_side02_0035_select_02",
      "hash64": "66DDC92DC348DD18",
      "text": "¡No he entendido ni papa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s1_side02_0035_camera_12",
      "hash64": "32EA7880138D6224",
      "text": "¡Guau! ¿Has entendido mi explicación?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
