    },
    {
      "ordinal": 16,
      "label": "s1_side02_0035_camera_14",
      "hash64": "32EA7680138D5EBE",
      "text": "¡Menos mal! ¡Pensaba que era la única![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
