      "ordinal": 0,
      "label": "s1_side02_0035_camera_01",
      "hash64": "32EDDF8013904700",
      "text": "Tiene ya sus años, pero no está mal, ¿no?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
