          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_side02_0035_camera_13",
      "hash64": "32EA7980138D63D7",
      "text": "Eso es lo que ponía en el manual, al menos.\\c\\nLo compré en una tienda de segunda mano y la\\nverdad es que no entiendo muy bien cómo va.\\c\\nPero oye, si funciona, ¡victoria![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
