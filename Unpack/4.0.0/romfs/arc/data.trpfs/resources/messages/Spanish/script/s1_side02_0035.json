          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_side02_0035_dog_01",
      "hash64": "D95290E2CA22E04D",
      "text": "¡Grooow!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_side02_0035_camera_04",
      "hash64": "32EDE48013904F7F",
      "text": "Dicen que Luna Carmesí se anda con más cautela\\nque otros Pokémon.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0035_camera_05",
      "hash64": "32EDE38013904DCC",
      "text": "Y que por eso casi nadie ha logrado verlo.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_side02_0035_camera_06",
      "hash64": "32EDE680139052E5",
      "text": "De modo que, para encontrarlo, vamos a tener\\nque investigar bien a fondo.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_side02_0035_camera_07",
      "hash64": "32EDE58013905132",
      "text": "¡Soci[VAR 0x1100(00FF,0101)]oa, voy a necesitar que me eches un cable\\n[VAR 0xFF00(0006)]sacando fotos [VAR 0xFF00(0000)]a los Pokémon![VAR 0x0114(0046)]",
      "flags": 0,
