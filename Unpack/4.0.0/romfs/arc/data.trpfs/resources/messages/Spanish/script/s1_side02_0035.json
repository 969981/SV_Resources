      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_0035_camera_15",
      "hash64": "32EA7780138D6071",
      "text": "Yo tampoco entiendo muy bien lo que hace.\\c\\nLo compré en una tienda de segunda mano\\ny esa es la explicación que daba el manual...\\c\\nPero vaya, si lo pone ahí, será verdad, ¿no?\\nDigo yo...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
