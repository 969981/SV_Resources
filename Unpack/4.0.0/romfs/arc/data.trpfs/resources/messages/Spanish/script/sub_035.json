          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sub_035_mgirl_17",
      "hash64": "4A5CA861B3DBDCE1",
      "text": "Si quieres que evalúe el tamaño de un Pokémon,\\nya sabes dónde estoy.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sub_035_mgirl_18",
      "hash64": "4A5CA161B3DBD0FC",
      "text": "¿Sabías que el tamaño de los Pokémon varía\\nincluso dentro de una misma especie?\\c\\nSi no te lo crees, mira a mis Pachirisu.\\n¿Ves la diferencia? ¡Para mí está clarísima!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
