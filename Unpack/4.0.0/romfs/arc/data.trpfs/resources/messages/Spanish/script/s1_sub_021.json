    {
      "ordinal": 2,
      "label": "s1_sub_021_gmother_02",
      "hash64": "5B28E3DD088D7CF2",
      "text": "Es que a Corin y a Cass esta talla ya no les sirve,\\n¿sabes?[VAR 0x0114(0037)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
