          "args_hex": [
            "0037"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_021_gmother_03",
      "hash64": "5B28E4DD088D7EA5",
      "text": "Ser son del mismo color que los que usan ellos,\\npero póntelos, que no te son viejos.[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
