    {
      "ordinal": 34,
      "label": "gym_normal_030_shop_00",
      "hash64": "04CA2005066AAA90",
      "text": "¡Buenas! Estás haciendo el examen de gimnasio,\\n¿verdad? ¿Has reunido ya todas las pistas sobre\\r\\nla comanda secreta del Mesón El Tesoro?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_normal_030_shop_01",
      "hash64": "04CA2105066AAC43",
      "text": "En ese caso, te tomo nota. ¿Qué va a ser?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "gym_normal_030_select_01",
      "hash64": "5E3EAA16A3EF1757",
      "text": "Onigiris a la parrilla",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
