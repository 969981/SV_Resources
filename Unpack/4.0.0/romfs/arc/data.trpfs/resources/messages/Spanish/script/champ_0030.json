    },
    {
      "ordinal": 8,
      "label": "champ_0030_rival_05",
      "hash64": "E06B83ED899B2515",
      "text": "Cómo me alegro de que me hicieras caso.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
