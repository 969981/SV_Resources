    {
      "ordinal": 8,
      "label": "gym_koori_040_koori_02",
      "hash64": "4FB91D84C5B57FBE",
      "text": "¿Hm? ¿Has venido a desafiarme?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
