    {
      "ordinal": 11,
      "label": "gym_koori_040_koori_05",
      "hash64": "4FB92084C5B584D7",
      "text": "Sin embargo, no te confíes demasiado.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
