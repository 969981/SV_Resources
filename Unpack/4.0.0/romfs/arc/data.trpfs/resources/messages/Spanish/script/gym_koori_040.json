    },
    {
      "ordinal": 10,
      "label": "gym_koori_040_koori_04",
      "hash64": "4FB91F84C5B58324",
      "text": "He visto cómo te manejas en la pista.\\nPura sangre fría.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
