      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "team_circle_win_01_02",
      "hash64": "9A76A5A7D67681E5",
      "text": "El Círculo Unión te permite reunirte con amigos\\nen los Centros Pokémon para salir de aventuras.\\c\\nSi tu conexión se interrumpe mientras estás\\njugando con amigos mediante el Círculo Unión,\\r\\nabandonarás automáticamente el grupo.\\c\\nSi se interrumpe la conexión de la persona que\\ncreó el grupo, este se disolverá.\\c\\nComprueba que tengas una conexión estable\\nantes de jugar.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
