      "hash64": "EBBEB77C4A16B48B",
      "text": "A ver... Este es buen sitio.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
