          "kind": "control",
          "offset_units": 39,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0302"
          ]
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0100"
          ]
