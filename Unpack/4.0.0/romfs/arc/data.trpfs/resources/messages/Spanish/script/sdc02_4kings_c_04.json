          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_4kings_c_04_fairybb_13",
      "hash64": "EBC2397C4A19C748",
      "text": "¡¿Has visto cómo han combatido nuestros\\nPokémon?![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_4kings_c_04_fairybb_14",
      "hash64": "EBC2407C4A19D32D",
      "text": "¡¿No te han parecido todos una monada?![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_4kings_c_04_select_01",
      "hash64": "D00BCFCD2F27B3F8",
      "text": "¡Sí, monísimos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_4kings_c_04_select_02",
      "hash64": "D00BD2CD2F27B911",
      "text": "¡Han estado muy guais!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc02_4kings_c_04_select_03",
      "hash64": "D00BD1CD2F27B75E",
      "text": "¡Tú sí que eres mona!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc02_4kings_c_04_fairybb_15",
      "hash64": "EBC23F7C4A19D17A",
      "text": "¡Ji, ji, ji! ¿A que sí? Podría pasarme el día entero\\nmirándolos combatir, es que son tan adorables...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_4kings_c_04_fairybb_16",
      "hash64": "EBC23E7C4A19CFC7",
      "text": "¡No, no! ¡Que estamos hablando de monería![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_4kings_c_04_fairybb_17",
      "hash64": "EBC23D7C4A19CE14",
      "text": "¡No, no! ¡Que estamos hablando de los Pokémon![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_4kings_c_04_fairybb_18",
      "hash64": "EBC2347C4A19BEC9",
      "text": "Ay, si es que tu[VAR 0x1101(00FD,0100)]s Pokémon también [VAR 0x1101(00FD,0302)]esson cuqui[VAR 0x1101(00FD,0100)]s\\na más no poder.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0100"
