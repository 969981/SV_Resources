          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0010_headbb_10",
      "hash64": "1F14413F0FBD1D7E",
      "text": "Uy, ahora no caigo... ¿Qué era?[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0010_headbb_11",
      "hash64": "1F14423F0FBD1F31",
      "text": "No lo tengo claro... No lo te... ¡Oh!\\c\\n¡Aaah, eso es! ¡Noroteo! ¿No coincidió con dos\\nde nuestros alumnos en el campamento?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0010_headbb_12",
      "hash64": "1F143F3F0FBD1A18",
      "text": "Fue una de ellos quien te recomendó, ¿sabes?\\nUna muchacha llamada Corin, si no recuerdo mal.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0010_headbb_13",
      "hash64": "1F14403F0FBD1BCB",
      "text": "¡Aaah, ya sé! Una fuente fidedigna me dijo que\\nun[VAR 0x1100(00FF,0100)]a alumn[VAR 0x1100(00FF,0101)]oa le había llamado mucho la atención.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
