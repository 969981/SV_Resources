          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0010_headbb_09",
      "hash64": "1F17BE3F0FC027BC",
      "text": "¡Buena pregunta, Clavelín! Hmm, pues verás...[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
