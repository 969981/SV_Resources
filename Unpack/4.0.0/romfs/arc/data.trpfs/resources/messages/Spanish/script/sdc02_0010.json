          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0010_headteacher_08",
      "hash64": "2F8FCDC3B7EC6FC5",
      "text": "A propósito... ¿Qué le ha llevado a decidirse por\\n[VAR 0x1100(00FF,0402)]élella en esta ocasión?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 3,
