          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_battle_b_16",
      "hash64": "284AE2AC6337F925",
      "text": "Creo que, gracias a vosotros, poco a poco voy\\nentendiendo cómo funciona esto.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
