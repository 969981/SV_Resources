    {
      "ordinal": 1,
      "label": "kizuna_battle_b_02",
      "hash64": "284774AC63350864",
      "text": "¡No esperaba encontrarme contigo en el aula\\nde Hogar![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
