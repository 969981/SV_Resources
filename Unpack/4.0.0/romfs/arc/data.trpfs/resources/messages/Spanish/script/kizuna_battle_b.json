      "ordinal": 25,
      "label": "kizuna_battle_b_15",
      "hash64": "284ADFAC6337F40C",
      "text": "¡En fin![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
