    {
      "ordinal": 3,
      "label": "gym_mizu_020_trainer_01a",
      "hash64": "033215E8AA805C80",
      "text": "¡Pero bueno! ¿Otra vez tú?",
      "flags": 0,
      "text_status": "DECODED",
