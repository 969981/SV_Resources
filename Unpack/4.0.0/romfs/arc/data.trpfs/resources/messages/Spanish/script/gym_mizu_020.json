          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "gym_mizu_020_mizu_21",
      "hash64": "931181305CF61AE5",
      "text": "Muchas gracias por haberme procurado las algas,\\nmuchach[VAR 0x1100(00FF,0101)]oa.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
