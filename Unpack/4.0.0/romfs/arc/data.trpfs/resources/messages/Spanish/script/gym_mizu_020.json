    {
      "ordinal": 49,
      "label": "gym_mizu_020_seri_select_03",
      "hash64": "2DAAB664BC809AB2",
      "text": "No pujar por ahora",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 50,
      "label": "gym_mizu_020_seri_03a",
      "hash64": "3B17448C038FD742",
      "text": "¡Bien! ¡Tenemos [VAR 0x0205(0005,202F)]  por aquí!\\c\\n¿Quién se anima a subir la oferta?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
