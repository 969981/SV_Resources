          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "gym_mizu_020_mizu_24",
      "hash64": "93117C305CF61266",
      "text": "Ahora supongo que toca poner rumbo al\\ngimnasio.[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
