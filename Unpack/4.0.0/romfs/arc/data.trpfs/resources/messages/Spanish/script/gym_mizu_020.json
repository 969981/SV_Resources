          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "gym_mizu_020_mizu_08",
      "hash64": "930AFC305CF0CD38",
      "text": "Estamos los dos la mar de nerviosos.[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "gym_mizu_020_shop_01",
      "hash64": "4C49FA89878568CE",
      "text": "¡Atención, señoras y señores! ¡Estamos a punto\\nde presentar el último lote del día!\\c\\n¡Me lo quitan de las manos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "gym_mizu_020_mizu_09",
      "hash64": "930AFD305CF0CEEB",
      "text": "¿Eh?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "gym_mizu_020_shop_02",
      "hash64": "4C49F9898785671B",
      "text": "He aquí el plato fuerte de hoy: ¡las legendarias\\nalgas de Hoenn! ¡Que comience la puja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "gym_mizu_020_mizu_10",
      "hash64": "930E7A305CF3D929",
      "text": "¡Por mis barbos![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "gym_mizu_020_mizu_11",
      "hash64": "930E79305CF3D776",
      "text": "¡Qué elasticidad! ¡No me hace falta ni tocarlas\\npara saber que rebosan de nutrientes![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "gym_mizu_020_mizu_12",
      "hash64": "930E78305CF3D5C3",
      "text": "¡Y qué lustre! ¡Reflejan tanta luz que te quedas\\nmedio cegato al mirarlas![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_mizu_020_mizu_13",
      "hash64": "930E77305CF3D410",
      "text": "¡Y qué me dices de ese olor a mar! ¡No deja\\nlugar a dudas de su tremenda frescura![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "gym_mizu_020_mizu_14",
      "hash64": "930E7E305CF3DFF5",
      "text": "¡Las quiero! ¡Tienen que ser mías![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "gym_mizu_020_mizu_15",
      "hash64": "930E7D305CF3DE42",
      "text": "Atiende. Aprobar el examen de mi gimnasio\\nrequiere buen gusto y paladar refinado.[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "gym_mizu_020_mizu_16",
      "hash64": "930E7C305CF3DC8F",
      "text": "¡La ocasión la pintan calva! ¡Quiero que me\\nconsigas esas algas en la subasta![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "gym_mizu_020_select_03",
      "hash64": "54C29BBBFD7524B4",
      "text": "¿Y cómo va eso?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "gym_mizu_020_select_04",
      "hash64": "54C29ABBFD752301",
      "text": "¡Eso está hecho!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "gym_mizu_020_mizu_17",
      "hash64": "930E7B305CF3DADC",
      "text": "Es muy sencillo: se trata de competir contra otros\\nclientes por la compra de un artículo.\\c\\nCada uno va ofreciendo sumas en función de su\\npresupuesto y, al final, quien haya ofertado la\\r\\ncantidad mayor se lleva el Sprigatito al agua.[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 186,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 236,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "gym_mizu_020_mizu_18",
      "hash64": "930E82305CF3E6C1",
      "text": "¡Fua, ja, ja! ¿A tu edad y ya sabes cómo funciona\\nuna subasta? ¡Eres un fenómeno, chic[VAR 0x1100(00FF,0101)]oa![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "gym_mizu_020_mizu_19",
      "hash64": "930E81305CF3E50E",
      "text": "Toma, aquí tienes los cuartos. ¡Ahora emplea la\\nmateria gris y gana esa subasta por mí![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "gym_mizu_020_seri_01",
      "hash64": "E9E0F72565D1DA3D",
      "text": "¡Empezamos ya, señoras y señores!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "gym_mizu_020_seri_02",
      "hash64": "E9E0F42565D1D524",
      "text": "¡El precio de partida de las legendarias algas de\\nHoenn es de [VAR 0x0205(0001,202F)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
