    },
    {
      "ordinal": 62,
      "label": "gym_mizu_020_system_02",
      "hash64": "C2234DBAFFC0FFB4",
      "text": "Le has entregado a Fuco las algas legendarias.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 63,
      "label": "gym_mizu_020_mizu_22",
      "hash64": "93117E305CF615CC",
      "text": "¡Qué algas tan magníficas! Si no hubiera podido\\ncomprarlas, me habría subido por las paredes.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "gym_mizu_020_mizu_23",
      "hash64": "93117F305CF6177F",
      "text": "¡Lo que haya sobrado del presupuesto te lo\\npuedes quedar como premio!\\c\\nÚsalo si quieres para pujar si ves algún artículo\\nque te guste.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
