        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0115_ecology_07",
      "hash64": "87159D642D545895",
      "text": "Esto te vendrá muy bien para tu búsqueda del\\ntesoro.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
