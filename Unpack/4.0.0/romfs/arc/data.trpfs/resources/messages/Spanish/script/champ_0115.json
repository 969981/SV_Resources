        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0115_ecology_06",
      "hash64": "87159C642D5456E2",
      "text": "Y como tutor tuyo que soy, he venido a animarte\\npara que sepas que cuentas con mi apoyo.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
