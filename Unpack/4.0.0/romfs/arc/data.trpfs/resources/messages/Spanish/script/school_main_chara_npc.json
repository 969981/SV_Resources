    },
    {
      "ordinal": 17,
      "label": "school_main_chara_battleteacher_02",
      "hash64": "FCF05E98B306AB37",
      "text": "¡Ey, novatill[VAR 0x1100(00FF,0101)]oa! ¿Estás entrenando como es\\ndebido?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
