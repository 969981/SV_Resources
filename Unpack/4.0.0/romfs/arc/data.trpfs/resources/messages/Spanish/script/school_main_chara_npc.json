          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "school_main_chara_languageteacher_04",
      "hash64": "05A585A7D5BE1581",
      "text": "¡Pawmi se encuentra muy bien!\\nLo que pasa es que es algo vergonzoso.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
