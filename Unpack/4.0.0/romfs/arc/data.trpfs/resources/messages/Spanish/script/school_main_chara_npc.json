    },
    {
      "ordinal": 16,
      "label": "school_main_chara_battleteacher_01",
      "hash64": "FCF05F98B306ACEA",
      "text": "¡Ey, novatill[VAR 0x1100(00FF,0101)]oa, a ver esos músculos!\\n¡No hay nada como estar en buena forma![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
