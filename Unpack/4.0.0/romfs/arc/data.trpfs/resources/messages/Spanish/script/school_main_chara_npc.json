          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "school_main_chara_mathteacher_02",
      "hash64": "1F03A79EE6406E8B",
      "text": "[VAR 0xBD06(0000)]Anda, [VAR 0x0100(0000)], ¿qué tal? Te veo muy\\nbien y eso me alegra mucho.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
