        }
      ]
    },
    {
      "ordinal": 18,
      "label": "school_main_chara_mathteacher_01",
      "hash64": "1F03A89EE640703E",
      "text": "¡Hola! No dudes en preguntarme cualquier duda\\nque tengas, criatura.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
