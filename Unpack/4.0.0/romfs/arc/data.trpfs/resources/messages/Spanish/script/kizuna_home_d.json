  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_home_d_01",
      "hash64": "CDB47B6DB9FA29AC",
      "text": "Escucha, sobre aquello que hablamos,\\n[VAR 0x0100(0000)]...[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_home_d_02",
      "hash64": "CDB47E6DB9FA2EC5",
      "text": "Ya he logrado identificar ese famoso condimento\\nde dulzura suprema.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_home_d_03",
      "hash64": "CDB47D6DB9FA2D12",
      "text": "Lo llaman... ¡Especia Oculta Dulce![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_home_d_04",
      "hash64": "CDB4786DB9FA2493",
      "text": "Si por casualidad encontraras esta especia\\ndurante tu búsqueda del tesoro, te agradecería\\r\\nen el alma que compartieras un poco conmigo.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_home_d_05",
      "hash64": "CDB4776DB9FA22E0",
      "text": "¿Tienes algo que comentarme sobre la Especia\\nOculta Dulce, [VAR 0x0100(0000)]?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_home_d_system_01",
      "hash64": "23FEA4E7BABD75E0",
      "text": "¿Quieres darle a Hugo un poco de Especia\\nOculta Dulce?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_home_d_system_02",
      "hash64": "23FEA7E7BABD7AF9",
      "text": "No tienes Especia Oculta Dulce.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_home_d_06",
      "hash64": "CDB47A6DB9FA27F9",
      "text": "¡Oh, sí! Es... es... ¡la Especia Oculta Dulce![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_home_d_07",
      "hash64": "CDB4796DB9FA2646",
      "text": "T-tengo que... ¡cocinar algo con ella ahora\\nmismo![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_home_d_08",
      "hash64": "CDB4846DB9FA38F7",
      "text": "Es tan... tan...[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_home_d_09",
      "hash64": "CDB4836DB9FA3744",
      "text": "¡Duuulceee![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_home_d_10",
      "hash64": "CDB0F66DB9F711D6",
      "text": "¡Esto ha de superar al néctar y la ambrosía!\\nEs como la Miel, ¡pero cien veces más dulce![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_home_d_mob_01",
      "hash64": "5F8CA5AC90CF3D77",
      "text": "¡Profe, profe! ¿Qué estás comiendo?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_home_d_11",
      "hash64": "CDB0F76DB9F71389",
      "text": "¡¡Ah!![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_home_d_mob_02",
      "hash64": "5F8CA6AC90CF3F2A",
      "text": "¡Tiene un olor superdulce! ¡Y estabas disfrutando\\nun montón!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_home_d_12",
      "hash64": "CDB0F46DB9F70E70",
      "text": "¡N-no es lo que parece! Puedo explicarlo...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_home_d_mob_03",
      "hash64": "5F8CA7AC90CF40DD",
      "text": "¿A ti también te gustan los dulces? ¡Qué guay!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_home_d_13",
      "hash64": "CDB0F56DB9F71023",
      "text": "¡¿Guay?!...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_home_d_14",
      "hash64": "CDB0FA6DB9F718A2",
      "text": "Todo este tiempo preocupándome por agradar\\ny por mantener una imagen...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_home_d_15",
      "hash64": "CDB0FB6DB9F71A55",
      "text": "Y resulta que le estaba dando importancia a\\ncosas que ni la tenían.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_home_d_16",
      "hash64": "CDB0F86DB9F7153C",
      "text": "Bueno, te prometí una recompensa y aquí la\\ntienes.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_home_d_17",
      "hash64": "CDB0F96DB9F716EF",
      "text": "No solo me has permitido saborear un dulzor\\ninolvidable...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_home_d_18",
      "hash64": "CDB0FE6DB9F71F6E",
      "text": "También me has hecho abrir la mente a nuevas\\nperspectivas.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_home_d_19",
      "hash64": "CDB0FF6DB9F72121",
      "text": "Te estoy profundamente agradecido.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_home_d_system_03",
      "hash64": "23FEA6E7BABD7946",
      "text": "¡Te has ganado la amistad de Hugo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
