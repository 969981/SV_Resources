          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_sub_007_man_05",
      "hash64": "440A6CEDEC31C42D",
      "text": "¡Si es que Inmobiliaria Paldea es una empresa\\nde alto ranking con una presi de alto standing!\\c\\n¡Eres un espejo donde toda Celebridad debería\\nreflejarse![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
