          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_007_man_04",
      "hash64": "440A6BEDEC31C27A",
      "text": "¡Esa es mi Enrica! ¡Dándole lecciones a alguien\\nque precisamente se las acaba de impartir![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_sub_007_woman_12",
      "hash64": "A44E49E088FA7787",
      "text": "¿Sabes qué te digo, Ricardo? Que ahora me ha\\nentrado el capricho de ir a escalar una [VAR 0xFF00(0006)]montaña[VAR 0xFF00(0000)].\\c\\nUn poco como mi empresa, pero cambiando\\nla altura de miras por mirar desde las alturas.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
