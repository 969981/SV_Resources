    },
    {
      "ordinal": 20,
      "label": "s1_sub_007_secretary_01",
      "hash64": "B961E550E6A71A4B",
      "text": "Doña Enrica y don Ricardo se han desplazado\\na la mayor masa de agua de Paldea.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "s1_sub_007_secretary_02",
      "hash64": "B961E650E6A71BFE",
