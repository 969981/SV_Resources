          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0089_dragonbb_10",
      "hash64": "29C61C05FA78603B",
