          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0089_sister_03",
      "hash64": "CA06882959B07056",
      "text": "A ver, todo lo que has dicho es verdad, pero\\npodrías explicar las cosas un poquito mejor...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
