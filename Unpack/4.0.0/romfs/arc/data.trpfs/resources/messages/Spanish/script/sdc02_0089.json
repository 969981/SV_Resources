          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0089_dragonbb_08",
      "hash64": "29C29E05FA75544A",
      "text": "¡Bah! Además, la dinámica ha cambiado un poco\\núltimamente...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
