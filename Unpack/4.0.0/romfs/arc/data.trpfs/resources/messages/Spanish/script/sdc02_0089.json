          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0089_dragonbb_06",
      "hash64": "29C29005FA753C80",
      "text": "En el club nos enfrentamos los unos a los otros\\npara pulir nuestras habilidades y así poder\\r\\nalcanzar luego un puesto más alto en la liga.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0089_dragonbb_07",
      "hash64": "29C29105FA753E33",
      "text": "A veces se gana, a veces se pierde, ¡pero en el\\nClub de la Liga siempre nos lo pasamos genial![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
