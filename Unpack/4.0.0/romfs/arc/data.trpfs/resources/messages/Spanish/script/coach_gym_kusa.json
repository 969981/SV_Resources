          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_gym_kusa_sp01_select_01",
      "hash64": "A0B376FEFB2B9812",
      "text": "¡Me alegro!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_gym_kusa_sp01_select_02",
      "hash64": "A0B375FEFB2B965F",
      "text": "¿Mariqué?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_gym_kusa_sp01_05",
      "hash64": "E49EE4BA7377E757",
      "text": "¿Mi alegría motiva la tuya propia? ¡Podríamos\\ndefinirlo entonces como una feliz coincidencia![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_gym_kusa_sp01_05b",
      "hash64": "F1E5DDD234BDDF0F",
      "text": "¡Maridaje! ¡El noble arte de combinar elementos\\nheterogéneos manteniendo la armonía artística![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_kusa_sp01_04",
      "hash64": "E49EE3BA7377E5A4",
      "text": "Me placería auparme a ese misterioso objeto\\nque pende del techo, ¡para regodearme con la\\r\\nvisión del Biodomo en todo su esplendor![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
