    {
      "ordinal": 55,
      "label": "coach_gym_kusa_randomtalk_00",
      "hash64": "1FDAFE1F72B4C8A3",
      "text": "Las dependencias de esta academia hacen gala\\nde un diseño verdaderamente sobresaliente.\\c\\nMe gustaría conocer el nombre del arquitecto.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
