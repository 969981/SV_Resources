      ]
    },
    {
      "ordinal": 53,
      "label": "coach_gym_kusa_battleend_win_01_01",
      "hash64": "AE478201CDB0DC5F",
      "text": "Ah, la inspiración me desborda por momentos...\\c\\nDéjame paladear este momento e imbuirme de\\nese dulce susurro que emiten mis musas.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
