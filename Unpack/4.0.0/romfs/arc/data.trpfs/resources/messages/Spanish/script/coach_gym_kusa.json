            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_kusa_randomtalk_01",
      "hash64": "1FDAFD1F72B4C6F0",
      "text": "El combate, al igual que el arte, no está exento\\nde adversidades: ¡no todo es fino divertimento!\\c\\nTu duende, lejos de florecer, se marchitará si\\nrenuncias a la cultura del esfuerzo.\\c\\n¡Procura no rendirte jamás![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
