          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_kusa_sp01_02",
      "hash64": "E49EE1BA7377E23E",
      "text": "Aunque sea otra región, veo que las costumbres\\nde los púberes se mantienen inmutables.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_kusa_sp01_03",
      "hash64": "E49EE2BA7377E3F1",
      "text": "¡¡Pero qué decir del fabuloso Biodomo!!\\c\\n¡Contemplar ese maridaje de entornos diversos\\nentre sí no hace sino estimular mi vena creativa![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
