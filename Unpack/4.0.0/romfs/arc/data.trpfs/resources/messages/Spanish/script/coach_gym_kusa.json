    },
    {
      "ordinal": 3,
      "label": "coach_gym_kusa_sp01_01",
      "hash64": "E49EE0BA7377E08B",
      "text": "Acabo de dar las últimas cinceladas a mi nueva\\nobra, así que he acudido raudo y veloz para dar\\r\\nun cierto respiro a mi vena artística.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
