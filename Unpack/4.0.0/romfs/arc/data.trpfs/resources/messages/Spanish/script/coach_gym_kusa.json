      "ordinal": 54,
      "label": "coach_gym_kusa_battleend_lose_00_00",
      "hash64": "A0955EEA7006A9B0",
      "text": "¡Esta vez te he hecho yo trizas a ti!\\c\\n¡El arte es algo que se debe cultivar, y a veces la\\nderrota es el mejor abono![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
