    {
      "ordinal": 52,
      "label": "coach_gym_kusa_battleend_win_01_00",
      "hash64": "AE478101CDB0DAAC",
      "text": "¡Ja, ja, ja! ¡Una derrota sin malas artes! Es más,\\n¡con muy buenas artes! ¡Toda una obra maestra!\\c\\nTe mereces este premio, porque yo haré trazos...\\n¡pero tú me haces trizas![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
