      "ordinal": 3,
      "label": "coach_gym_esper_sp01_01",
      "hash64": "52A8E06EF1BB7844",
      "text": "Bueno, no imaginas qué ilu me ha hecho que me\\nhayas invitado a venir.[VAR 0x0114(001C)]",
