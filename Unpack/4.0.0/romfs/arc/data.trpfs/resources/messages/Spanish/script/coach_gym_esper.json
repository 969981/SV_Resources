      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_gym_esper_sp02_02",
      "hash64": "FC4319675651BCEE",
      "text": "¡Uy, no, no! Aunque no te falta razón, cariño.\\nCon mi estilo, podría ser azafata perfectamente.\\c\\nPero no, ¡trabajo de maquilladora profesional!\\nQue no se te olvide, ¿vale?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 173,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
