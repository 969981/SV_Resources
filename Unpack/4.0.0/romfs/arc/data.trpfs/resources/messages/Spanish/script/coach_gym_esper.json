    },
    {
      "ordinal": 56,
      "label": "coach_gym_esper_randomtalk_03",
      "hash64": "EDF6111629A1CE6D",
      "text": "[VAR 0xBD06(0000)]¡Tu [VAR 0x0101(0001)] es la base perfecta para mi\\nmagia!\\r\\nConmigo, su belleza brillará como nunca.[VAR 0x0114(001C)]",
