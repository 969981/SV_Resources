    },
    {
      "ordinal": 24,
      "label": "coach_gym_esper_sp03_03",
      "hash64": "CE890A60F3760A40",
      "text": "Yo aquí, preocupada todo este tiempo...\\n¡Y vas tú y superas todas mis expectativas![VAR 0x0114(001C)]",
