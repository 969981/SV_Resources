    },
    {
      "ordinal": 53,
      "label": "coach_gym_esper_randomtalk_00",
      "hash64": "EDF60E1629A1C954",
      "text": "La verdad es que estoy superocupada, pero, si es\\npor ti, vendré en un abrir y cerrar de ojos.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
