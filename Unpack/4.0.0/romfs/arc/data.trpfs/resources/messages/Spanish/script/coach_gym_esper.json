          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_esper_sp02_04",
      "hash64": "FC431B675651C054",
      "text": "En Paldea, soy famosa, pero en el extranjero aún\\nme queda mucho trabajo por hacer.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
