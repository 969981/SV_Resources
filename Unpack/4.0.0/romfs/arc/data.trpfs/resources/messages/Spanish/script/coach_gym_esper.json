    {
      "ordinal": 8,
      "label": "coach_gym_esper_sp01_05b",
      "hash64": "305FAA84C1812F2E",
      "text": "Ju, ju... ¡Estás tan mon[VAR 0x1100(00FF,0101)]oa con esa carita nerviosa!\\nPero era broma, no te preocupes.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
