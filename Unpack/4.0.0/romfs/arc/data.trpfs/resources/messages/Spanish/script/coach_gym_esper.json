    },
    {
      "ordinal": 4,
      "label": "coach_gym_esper_sp01_02",
      "hash64": "52A8E36EF1BB7D5D",
      "text": "En cuanto me lo dijeron, pedí un taxi volador\\npara venir en menos que canta un Torchic.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
