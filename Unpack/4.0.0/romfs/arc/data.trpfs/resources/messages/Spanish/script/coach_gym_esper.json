    },
    {
      "ordinal": 57,
      "label": "coach_gym_esper_randomtalk_04",
      "hash64": "EDF60A1629A1C288",
      "text": "¿Qué tal está mi pequeño Flittlecillo, cariño?\\c\\nEs el mejor, y además es fuerte como él solo.\\nTe ha dejado sin habla, ¿verdad?[VAR 0x0114(001C)]",
