    },
    {
      "ordinal": 15,
      "label": "coach_gym_esper_sp02_02b",
      "hash64": "F7C0B697ACE361E4",
      "text": "¡Uy, no, no! Esa disciplina es solo para gente\\nmás peculiar.\\c\\nEn cierto modo, yo también soy artista, pero mi\\nlienzo son los rostros.\\c\\n¡Trabajo de maquilladora profesional! Que no se\\nte olvide, ¿vale?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
