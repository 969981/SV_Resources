          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_gym_esper_sp01_05",
      "hash64": "52A8DC6EF1BB7178",
      "text": "¡Ju, ju! ¡Así me gusta, siempre dispuest[VAR 0x1100(00FF,0101)]oa a acudir\\nal rescate! Pero era broma, tranquil[VAR 0x1100(00FF,0101)]oa.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
