          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_esper_sp02_03",
      "hash64": "FC431A675651BEA1",
      "text": "Aquí hay mucha gente que no me conoce...\\c\\nEso sí, en cuanto menciono a qué me dedico,\\ntodos quedan fascinados de repente.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
