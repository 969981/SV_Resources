    },
    {
      "ordinal": 16,
      "label": "coach_gym_esper_sp02_02c",
      "hash64": "F7C0B797ACE36397",
      "text": "¡Bingo! ¡Diez puntos para ti!\\c\\nAsí es, soy maquilladora profesional, aunque\\ntambién hago de modelo y Líder de Gimnasio.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
