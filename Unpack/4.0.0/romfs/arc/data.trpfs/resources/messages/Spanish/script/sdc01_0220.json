    },
    {
      "ordinal": 5,
      "label": "sdc01_0220_sister_04",
      "hash64": "3BFDEC5713F5B0CF",
      "text": "[VAR 0xBD06(0000)]¡Tengo que hablar de un asunto muy serio con\\n[VAR 0x0100(0000)]![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
