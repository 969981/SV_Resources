    {
      "ordinal": 2,
      "label": "sdc01_0220_sister_01",
      "hash64": "3BFDE75713F5A850",
      "text": "Oh, no. Ya se ha levantado.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
