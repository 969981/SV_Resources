    },
    {
      "ordinal": 3,
      "label": "sdc01_0220_brother_02",
      "hash64": "B91452C0B7BAD1B7",
      "text": "¿Vamos a por el cartel que falta?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
