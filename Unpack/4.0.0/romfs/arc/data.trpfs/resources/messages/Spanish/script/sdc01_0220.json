      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0220_sister_02",
      "hash64": "3BFDEA5713F5AD69",
      "text": "¡Ve tú solo y no molestes, Cass![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
