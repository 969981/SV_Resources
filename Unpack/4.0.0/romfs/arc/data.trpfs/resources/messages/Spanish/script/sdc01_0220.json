        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0220_brother_03",
      "hash64": "B91451C0B7BAD004",
      "text": "Jobar, Corin, l[VAR 0x1100(00FF,0101)]oa estás acaparando todo el rato,\\nno es justo. Eres... eres lo peor.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
