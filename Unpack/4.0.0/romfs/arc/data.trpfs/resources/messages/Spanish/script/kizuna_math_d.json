          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_math_d_02",
      "hash64": "2C21F1A1DF8E09CE",
      "text": "He decidido tenderle una emboscadita a la chica\\nque no para de observarme.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_math_d_select_01",
      "hash64": "9D49A5E8910AAAE2",
      "text": "¡¿Una emboscadita?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_math_d_select_02",
      "hash64": "9D49A4E8910AA92F",
      "text": "¡¿Y eso por qué?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_d_03",
      "hash64": "2C21F2A1DF8E0B81",
      "text": "Tengo que zanjar este asunto. Es muy incómodo\\nque te miren constantemente, ¿sabes?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_d_04",
      "hash64": "2C21F3A1DF8E0D34",
      "text": "El otro día en el comedor me quedé con su cara.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_d_05",
      "hash64": "2C21F4A1DF8E0EE7",
      "text": "¡Ah![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_d_06",
      "hash64": "2C21F5A1DF8E109A",
      "text": "¡Eres tú! ¡Tú eres la que me ha estado mirando![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_d_woman_01",
      "hash64": "EB672704C6358444",
      "text": "¡Lí... Líder Mila!\\n¿Pero cómo es posible...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_d_woman_02",
      "hash64": "EB672A04C635895D",
      "text": "¡P-perdóneme! No sabía que se había dado\\ncuenta...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_d_07",
      "hash64": "2C21F6A1DF8E124D",
      "text": "¡¿Cómo no iba a darme cuenta, criatura, si era a\\ntodas horas?! Dime, ¿qué me querías preguntar?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_d_woman_03",
      "hash64": "EB672904C63587AA",
      "text": "Ah, verá...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_d_woman_04",
      "hash64": "EB672404C6357F2B",
      "text": "Es que he sido su mayor fan desde que era Líder\\nde Gimnasio.\\c\\n¡Y me encantan los movimientos de tipo Roca!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_d_08",
      "hash64": "2C21E7A1DF8DF8D0",
      "text": "Uy, no me digas...[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_math_d_woman_05",
      "hash64": "EB672304C6357D78",
      "text": "Pero, hace año y medio, lo dejó usted de\\nrepente... ¿Por qué abandonó el gimnasio?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_d_09",
      "hash64": "2C21E8A1DF8DFA83",
      "text": "Ay, criatura... ¿Eso es lo que tenías tanto afán por\\npreguntarme?[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_math_d_woman_06",
      "hash64": "EB672604C6358291",
      "text": "El motivo de su retirada no se dio a conocer\\njamás al público.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_math_d_woman_07",
      "hash64": "EB672504C63580DE",
      "text": "Y entre los alumnos corre el rumor de que, cada\\nvez que se le pregunta, evita el tema...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_math_d_woman_08",
      "hash64": "EB672004C635785F",
      "text": "Me moría por saber la verdad, pero supuse que\\nusted quizá no querría hablar del asunto y me\\r\\ndaba cosa parecer una maleducada...\\c\\nPor eso no me atrevía a preguntarle.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_math_d_10",
      "hash64": "2C24F5A1DF904671",
      "text": "Conque esa era la razón de que me miraras tan\\nfijamente... Perdona, es que me pusiste nerviosa.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_math_d_woman_09",
      "hash64": "EB671F04C63576AC",
      "text": "¿Nerviosa?...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "kizuna_math_d_11",
      "hash64": "2C24F4A1DF9044BE",
      "text": "Da igual. Querías saber por qué lo dejé, ¿no?\\c\\nSimplemente fue porque me apetecía dedicarme\\nde lleno a la enseñanza.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_math_d_12",
      "hash64": "2C24F3A1DF90430B",
      "text": "No porque me disgustara ser Líder de Gimnasio.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_math_d_13",
      "hash64": "2C24F2A1DF904158",
      "text": "De hecho, cuando me preguntan al respecto,\\nme embarga la nostalgia y me pongo triste...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_math_d_14",
      "hash64": "2C24F9A1DF904D3D",
      "text": "De ahí que acabe evitando las preguntas de los\\nalumnos.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_math_d_woman_10",
      "hash64": "EB63A204C6326C6E",
      "text": "Ah... Ahora la entiendo.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "kizuna_math_d_woman_11",
      "hash64": "EB63A304C6326E21",
      "text": "¿Ha pensado alguna vez en retomar su puesto\\ncomo Líder de Gimnasio?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "kizuna_math_d_15",
      "hash64": "2C24F8A1DF904B8A",
      "text": "Siento decepcionarte, pero no voy a volver.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_math_d_16",
      "hash64": "2C24F7A1DF9049D7",
      "text": "Ahora la líder es mi hermana, y lo está haciendo\\nde fábula.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_math_d_17",
      "hash64": "2C24F6A1DF904824",
      "text": "Y la enseñanza ahora mismo es lo que más me\\nllena y motiva.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_math_d_18",
      "hash64": "2C24EDA1DF9038D9",
      "text": "Así que preferiría que me llamases señorita Mila,\\nno \"líder\". También me puedes tutear, si quieres.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_math_d_woman_12",
      "hash64": "EB63A004C6326908",
      "text": "Vale... Es una pena, pero entiendo que usted...\\ndigooo, que tu decisión está tomada.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "kizuna_math_d_woman_13",
      "hash64": "EB63A104C6326ABB",
      "text": "¡Muchas gracias por contármelo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "kizuna_math_d_19",
      "hash64": "2C24ECA1DF903726",
      "text": "Ea, ¡misterio resuelto![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "kizuna_math_d_20",
      "hash64": "2C287BA1DF935FFA",
      "text": "Ay, con tanta expectación me he puesto como un\\nflan... ¡Igual me he pasado de pomposa![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_math_d_21",
      "hash64": "2C287CA1DF9361AD",
      "text": "Llevo una temporadita agobiada por sentirme\\ntan observada, qué quieres que te diga.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "kizuna_math_d_22",
      "hash64": "2C2879A1DF935C94",
      "text": "Así que me alegro de que haya resultado ser una\\nfan y de haberte tenido como apoyo moral hoy.\\c\\nGracias a ti, he podido afrontar una pregunta\\nmuy difícil para mí.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 163,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "kizuna_math_d_23",
      "hash64": "2C287AA1DF935E47",
      "text": "Te estoy muy agradecida. Eres siempre la mar de\\noportun[VAR 0x1100(00FF,0101)]oa, [VAR 0x0100(0000)].[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "kizuna_math_d_24",
      "hash64": "2C2877A1DF93592E",
      "text": "Toma, te voy a hacer un regalito por ayudarme.\\nEspero que te venga bien durante tus aventuras.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "kizuna_math_d_system_01",
      "hash64": "13D34B6D971897A5",
      "text": "¡Te has ganado la amistad de Mila!",
      "flags": 0,
