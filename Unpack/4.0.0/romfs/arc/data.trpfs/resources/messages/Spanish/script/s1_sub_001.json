    {
      "ordinal": 0,
      "label": "s1_sub_001_ecology_00",
      "hash64": "452959139DA13358",
      "text": "¡Ah, [VAR 0x0100(0000)]! Tenía que comentarte una\\ncosilla, pero hay un pequeño inconveniente...\\c\\nHablamos cuando hayas organizado tu equipo\\no tus cajas y tengas espacio, si te parece bien.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
