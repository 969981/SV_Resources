      ]
    },
    {
      "ordinal": 22,
      "label": "coach_paldea_botan_sp03_01b",
      "hash64": "E9D1D9156F8358D1",
      "text": "¿Eh? ¿Qué te pasa? Bueno, yo te lo voy a contar,\\nme escuches o no.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
