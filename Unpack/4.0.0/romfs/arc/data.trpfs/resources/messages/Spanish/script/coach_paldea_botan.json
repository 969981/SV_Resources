      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "coach_paldea_botan_sp03_01",
      "hash64": "E6DB38293EA35109",
      "text": "¡Ay, gracias! ¡Es que estoy tan emocionada que,\\nsi no lo suelto, exploto![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
