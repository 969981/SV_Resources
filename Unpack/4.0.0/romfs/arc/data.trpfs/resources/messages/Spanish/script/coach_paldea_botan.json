      "ordinal": 34,
      "label": "coach_paldea_botan_trade_01_03",
      "hash64": "4E17AC31A687F649",
      "text": "¡Genial! Pues yo te ofrezco a mi querido Vivi.\\n¿Qué me das a cambio?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
