          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_paldea_botan_sp03_02",
      "hash64": "E6DB35293EA34BF0",
      "text": "¡Me han dejado entrar en la planta submarina!\\n¡Ha sido increíble![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea_botan_sp03_03",
      "hash64": "E6DB36293EA34DA3",
      "text": "Estaba en la entrada de la academia investigando\\nun poco...[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_paldea_botan_sp03_04",
      "hash64": "E6DB3B293EA35622",
      "text": "Cuando, de repente, ha aparecido un hombre\\nvestido de blanco, muy elegante y risueño él,\\r\\ny me ha llevado hasta la planta.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_paldea_botan_sp03_05",
      "hash64": "E6DB3C293EA357D5",
      "text": "Era un señor bastante raro, si te digo la verdad...\\n¿O lo mismo era un hada disfrazada de señor?[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
