    },
    {
      "ordinal": 3,
      "label": "coach_paldea_botan_sp01_01",
      "hash64": "0E6B0418CCBB992B",
      "text": "Aunque esta habitación me agobia un poco...\\nEstá llena de gente que no conozco.[VAR 0x0114(0008)]",
