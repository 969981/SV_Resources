    {
      "ordinal": 9,
      "label": "coach_paldea_botan_sp02_00",
      "hash64": "3C250D1F2F9741A7",
      "text": "¡¿Sabías que esta academia es lo más?![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
