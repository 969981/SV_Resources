      "label": "coach_paldea_botan_sp01_select_01",
      "hash64": "A2AB83E067D113F2",
      "text": "¡No pasa nada!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_paldea_botan_sp01_select_02",
      "hash64": "A2AB82E067D1123F",
      "text": "¡Tú puedes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea_botan_sp01_02",
      "hash64": "0E6B0518CCBB9ADE",
      "text": "Ay... Uf... No sé...\\c\\nNo todos tenemos tanto don de gentes como\\ntú, ¿sabes?[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
