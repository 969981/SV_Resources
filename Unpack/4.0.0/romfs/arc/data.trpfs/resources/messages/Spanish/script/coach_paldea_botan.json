          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_paldea_botan_trade_01_00",
      "hash64": "4E17A931A687F130",
      "text": "Me encanta esta academia. Tenía mis dudas,\\npero al final me alegro de haber venido.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
