      "ordinal": 35,
      "label": "coach_paldea_botan_trade_01_04",
      "hash64": "4E17AD31A687F7FC",
      "text": "[VAR 0x0101(0001)] es muy tú... Vale. L-lo cuidaré\\ntoda la vida...[VAR 0x0114(0008)]",
      "flags": 0,
