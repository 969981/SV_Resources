    {
      "ordinal": 56,
      "label": "coach_paldea_botan_randomtalk_01",
      "hash64": "7ADCE6A95190B090",
      "text": "En Paldea, los taxis voladores usan Squawkabilly,\\npero en mi región natal suelen ser Corviknight.\\c\\n¡Y en el Biodomo usan a otro Pokémon distinto!\\n¿Te habías fijado?[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
