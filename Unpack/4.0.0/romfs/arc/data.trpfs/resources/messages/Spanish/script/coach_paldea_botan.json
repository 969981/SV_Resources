          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_paldea_botan_sp01_03",
      "hash64": "0E6B0618CCBB9C91",
      "text": "En fin, supongo que no me queda otra que\\nacostumbrarme...\\c\\nMe lo tomaré como un ejercicio para salir de mi\\nzona de confort.[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
