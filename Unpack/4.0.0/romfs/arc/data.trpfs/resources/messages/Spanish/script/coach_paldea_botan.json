          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_paldea_botan_trade_01_01",
      "hash64": "4E17AA31A687F2E3",
      "text": "Mira, te propongo algo... Pero no te pienses que\\nes solo para agradecerte el haberme invitado...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
