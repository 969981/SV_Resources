    {
      "ordinal": 2,
      "label": "gym_denki_010_receptionist_01",
      "hash64": "D3D284EC17F4C2B2",
      "text": "¡Bienvenid[VAR 0x1100(00FF,0101)]oa al Gimnasio de Ciudad Leudal!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
