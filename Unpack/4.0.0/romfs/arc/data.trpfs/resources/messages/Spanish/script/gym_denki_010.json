          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_denki_010_receptionist_05",
      "hash64": "D3D280EC17F4BBE6",
      "text": "La señorita e-Nigma compagina su labor como\\nLíder de Gimnasio con el mundo del streaming,\\r\\nlo que significa que vas a participar en una de\\r\\nsus retransmisiones en directo.\\c\\n¡Procura que el público se lo pase bien!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
