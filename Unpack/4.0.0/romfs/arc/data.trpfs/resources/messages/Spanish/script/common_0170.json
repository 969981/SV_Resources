      ]
    },
    {
      "ordinal": 3,
      "label": "common_0170_rival_03",
      "hash64": "3BFE1843B39D143A",
      "text": "Además, ha cambiado de aspecto así, como si\\nnada... ¿Es normal? ¿Deberíamos preocuparnos?[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0170_select_01",
      "hash64": "2E344D741B9C5604",
      "text": "Tal vez sí, tal vez no",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_0170_select_02",
      "hash64": "2E3450741B9C5B1D",
