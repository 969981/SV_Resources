      ]
    },
    {
      "ordinal": 2,
      "label": "common_0170_rival_02",
      "hash64": "3BFE1943B39D15ED",
      "text": "Pobre, parece agotado... Habrá usado toda la\\nenergía que le quedaba.\\c\\nA todo esto, ¿qué especie de Pokémon será?\\nMe recuerda un poco a un Cyclizar, pero es el\\r\\nprimero que veo con esta pinta tan rara...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 160,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
