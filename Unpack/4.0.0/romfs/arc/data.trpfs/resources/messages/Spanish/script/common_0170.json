          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0170_rival_10",
      "hash64": "3BFA9143B399F8FE",
      "text": "Pues pensaba que se había unido a tu equipo...\\nQué pena.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
