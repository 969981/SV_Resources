        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0170_rival_15",
      "hash64": "3BFA9643B39A017D",
      "text": "Por cierto, hay un movimiento que te vendrá muy\\nbien si te toca enfrentarte a Pokémon fuertotes.\\c\\nCon este objeto que te voy a dar, puedes\\nenseñárselo a uno de tus Pokémon.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
