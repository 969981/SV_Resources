          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0170_rival_05",
      "hash64": "3BFE1243B39D0A08",
      "text": "Pero bueno, ¡lo importante es que, al final, todo\\nesto se ha quedado en un susto![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
