    {
      "ordinal": 1,
      "label": "common_0170_rival_18",
      "hash64": "3BFA8943B399EB66",
      "text": "¡Oh, no! ¡¿Estás bien?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
