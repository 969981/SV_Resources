      ]
    },
    {
      "ordinal": 13,
      "label": "common_0170_rival_09",
      "hash64": "3BFE0E43B39D033C",
      "text": "¡¿Quéee?! ¡¿No le has dado ninguna instrucción?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
