          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_e_06_battle_05",
      "hash64": "A7EAFDE2D5FF38CD",
      "text": "Hablando de máquinas de MT... ¿Las habéis\\nestado usando?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
