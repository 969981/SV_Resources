    },
    {
      "ordinal": 5,
      "label": "class_e_06_battle_06",
      "hash64": "A7EAFAE2D5FF33B4",
      "text": "Vamos a comprobarlo con una pregunta rapidita.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
