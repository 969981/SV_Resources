          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_side02_0000_camera_13",
      "hash64": "EFB9A2B47EB188EB",
      "text": "Por cierto, tengo pensado pasar una temporadita\\npor aquí dedicándome a lo mío.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_side02_0000_camera_14",
      "hash64": "EFB9A7B47EB1916A",
      "text": "Espero que, cuando hayas terminado lo que\\ntengas que hacer, vengas a hablar conmigo.\\c\\n¡Creo que deberías aspirar a registrar, por lo\\nmenos, 150 Pokémon distintos en la Pokédex\\r\\nde Noroteo![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
