      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0000_select_02",
      "hash64": "C406F6299D65BBBC",
      "text": "¿Cómo lo sabes?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s1_side02_0000_camera_05",
      "hash64": "EFBD24B47EB49BA8",
      "text": "¡Je! Esta villa no es muy grande y la gente habla,\\n¿sabes?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
