    {
      "ordinal": 5,
      "label": "coach_bb4kings_hagane_sp01_select_01",
      "hash64": "C3836108EE7B8717",
      "text": "¡Está pletórico!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_bb4kings_hagane_sp01_select_02",
      "hash64": "C3836208EE7B88CA",
      "text": "¡No para de volar!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_bb4kings_hagane_sp01_03",
      "hash64": "C99A4C82D0940E4E",
      "text": "Me alegro.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
