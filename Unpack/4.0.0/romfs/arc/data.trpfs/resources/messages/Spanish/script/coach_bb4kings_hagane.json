          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb4kings_hagane_sp01_05",
      "hash64": "C99A4E82D09411B4",
      "text": "Seguramente es su resiliencia la que le permitió\\ndesenvolverse con semejante ufanía.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
