          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_bb4kings_hagane_sp03_01",
      "hash64": "F12996725EAB798A",
      "text": "Últimamente me siento algo extraña.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_bb4kings_hagane_sp03_02",
      "hash64": "F12995725EAB77D7",
      "text": "En ocasiones siento una opresión en el pecho,\\ny he perdido incluso el apetito.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb4kings_hagane_sp03_03",
      "hash64": "F12994725EAB7624",
      "text": "Sin embargo, el diagnóstico de la enfermería no\\nha revelado ninguna anomalía.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb4kings_hagane_sp03_04",
      "hash64": "F12993725EAB7471",
      "text": "¿Acaso se está produciendo en mí algún tipo de\\ncambio fisiológico?[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb4kings_hagane_sp03_select_01",
      "hash64": "56E9BF2FE7EA6109",
      "text": "¿Por qué será?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_hagane_sp03_select_02",
      "hash64": "56E9BC2FE7EA5BF0",
      "text": "¿Te pasa a menudo?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_hagane_sp03_05",
      "hash64": "F12992725EAB72BE",
      "text": "Lo desconozco totalmente.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_bb4kings_hagane_sp03_05b",
      "hash64": "7516B456DD542BD4",
      "text": "No se ajusta a ningún patrón de regularidad.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_bb4kings_hagane_sp03_06",
      "hash64": "F12991725EAB710B",
      "text": "En cualquier caso, sí he notado que los síntomas\\nse manifiestan cuando pienso en Cass.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_bb4kings_hagane_sp03_07",
      "hash64": "F12990725EAB6F58",
      "text": "Pero considero que no existe ningún tipo de\\nrelación causa-efecto.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_bb4kings_hagane_sp03_08",
      "hash64": "F1298F725EAB6DA5",
      "text": "En fin...[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_bb4kings_hagane_trade_01_00",
      "hash64": "88C64154CA3E800F",
      "text": "Constato que los síntomas se han aliviado tras\\nesta conversación contigo, [VAR 0x0100(0000)].[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_bb4kings_hagane_trade_01_01",
      "hash64": "88C64054CA3E7E5C",
      "text": "Es posible que nuestra interacción produzca una\\nespecie de efecto terapéutico.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
