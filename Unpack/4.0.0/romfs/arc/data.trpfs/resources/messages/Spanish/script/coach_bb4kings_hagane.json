          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb4kings_hagane_sp01_06",
      "hash64": "C99A5182D09416CD",
      "text": "Creo que hacer lo propio con otros Pokémon\\npodría resultar peligroso.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb4kings_hagane_sp01_07",
      "hash64": "C99A5082D094151A",
      "text": "Por lo general, el vuelo contrarreloj se realiza\\na lomos de Skarmory.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb4kings_hagane_sp01_08",
      "hash64": "C99A4382D093FF03",
      "text": "Bien. Eso es todo lo que quería comunicarte.\\nPongamos fin a nuestra conversación.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb4kings_hagane_sp02_00",
      "hash64": "F484C1778787444C",
      "text": "Tengo una pregunta para ti, [VAR 0x0100(0000)].[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb4kings_hagane_sp02_01",
      "hash64": "F484C277878745FF",
      "text": "¿Cuáles son las circunstancias bajo las cuales\\nconociste a Cass?[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb4kings_hagane_sp02_select_01",
      "hash64": "D2A78799FC4F6886",
      "text": "Coincidimos en un campamento",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb4kings_hagane_sp02_select_02",
      "hash64": "D2A78699FC4F66D3",
      "text": "Era mi pareja",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_bb4kings_hagane_sp02_02",
      "hash64": "F484C377878747B2",
      "text": "De modo que así fue...\\c\\nCiertamente, había vuelto a Noroteo antes de\\nmostrar ese cambio de actitud.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb4kings_hagane_sp02_02b",
      "hash64": "04DFF41B4ADF0670",
      "text": "¡¿Pa-pareja?! Ejem, disculpa.\\c\\nQuieres decir que formasteis pareja para realizar\\nuna actividad de vuestro campamento. Ya veo.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb4kings_hagane_sp02_03",
      "hash64": "F484C47787874965",
      "text": "Tenía curiosidad por saber qué motivó esa\\nexaltación de Cass hacia ti.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb4kings_hagane_sp02_04",
      "hash64": "F484BD7787873D80",
      "text": "No parece que el problema radique en la forma\\nen que os conocisteis.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb4kings_hagane_sp02_05",
      "hash64": "F484BE7787873F33",
      "text": "He preguntado cuanto quería preguntar.\\nMuchas gracias. Eso es todo.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_bb4kings_hagane_sp03_00",
      "hash64": "F12997725EAB7B3D",
      "text": "Te quería consultar una cosa, [VAR 0x0100(0000)].[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
