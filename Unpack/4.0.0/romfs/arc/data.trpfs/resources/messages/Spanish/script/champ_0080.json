    {
      "ordinal": 1,
      "label": "champ_0080_dragon_02",
      "hash64": "0B8707B70EFDD454",
      "text": "Parece que progresas adecuadamente en tu\\nperiplo por los gimnasios.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
