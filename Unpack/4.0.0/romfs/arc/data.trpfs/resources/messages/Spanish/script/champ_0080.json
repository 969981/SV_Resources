          "args_hex": [
            "00FF",
            "0301"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0080_ground_02",
      "hash64": "964B949853F508E4",
      "text": "Porque, si es así, ¡he oído que tienes fuerza para\\nparar un tren![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0080_select_01",
      "hash64": "2A34295819C78B50",
      "text": "¡Y se quedan cortos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "champ_0080_select_02",
      "hash64": "2A342C5819C79069",
      "text": "Exageran...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "champ_0080_ground_03a",
      "hash64": "577A27D6A961A002",
      "text": "¡Ja, ja, ja! Está claro que [VAR 0x1100(00FF,0A09)]el chavalla chavala no tiene\\nabuela.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
