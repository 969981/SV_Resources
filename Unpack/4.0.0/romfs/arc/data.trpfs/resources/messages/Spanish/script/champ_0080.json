          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0080_ground_01",
      "hash64": "964B979853F50DFD",
      "text": "¡Venga ya! ¿Tú eres es[VAR 0x1100(00FF,0101)]ea de[VAR 0x1100(00FF,0301)]l la que habla todo\\nquisqui?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 3,
