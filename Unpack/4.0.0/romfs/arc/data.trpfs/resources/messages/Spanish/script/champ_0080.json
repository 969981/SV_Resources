            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0080_ground_03b",
      "hash64": "577A26D6A9619E4F",
      "text": "Venga, que la tienes y lo sabes. ¡No me vengas\\nahora con falsa modestia![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0080_dragon_03",
      "hash64": "0B8708B70EFDD607",
      "text": "Os presento: ella es Cayena.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0080_ground_04",
      "hash64": "964B929853F5057E",
      "text": "¡Encantada! Aquí estoy para lo que haga falta.\\nPuedes llamarme Caye, por cierto.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0080_ground_05",
      "hash64": "964B939853F50731",
      "text": "Sé que mi belleza impone, me lo dicen mucho,\\npero es que nací así. ¡Tranqui, que no muerdo![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0080_dragon_04",
      "hash64": "0B8705B70EFDD0EE",
      "text": "Como has podido comprobar, Cayena es una\\njoven... muy amiga de la broma.\\c\\nPero que eso no te engañe, porque también es\\nmiembro del Alto Mando junto a un servidor.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 164,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0080_ground_06",
      "hash64": "964B909853F50218",
      "text": "¡Oye, que lo he dicho muy en serio![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0080_ground_07",
      "hash64": "964B919853F503CB",
      "text": "Pero bueno, a lo que vamos. Hmm...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0080_ground_08",
      "hash64": "964B8E9853F4FEB2",
      "text": "Mira que no te conozco de nada, pero así de\\nprimeras ya me has causado buena impresión.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "champ_0080_dragon_05",
      "hash64": "0B8706B70EFDD2A1",
      "text": "¡Y cómo no iba a hacerlo! Estamos ante un[VAR 0x1100(00FF,0101)]oa de\\nl[VAR 0x1100(00FF,0101)]oas alumn[VAR 0x1100(00FF,0101)]oas más destacad[VAR 0x1100(00FF,0101)]oas de la academia.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
