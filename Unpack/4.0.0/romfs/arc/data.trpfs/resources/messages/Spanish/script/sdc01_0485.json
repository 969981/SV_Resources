    {
      "ordinal": 35,
      "label": "sdc01_0485_sister_12",
      "hash64": "A3B9E42AC7EB95C3",
      "text": "No sabes cuánto me alegro de que hayas venido\\ntú y no otra persona.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
