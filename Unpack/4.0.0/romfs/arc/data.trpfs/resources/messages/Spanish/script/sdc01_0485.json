    },
    {
      "ordinal": 36,
      "label": "sdc01_0485_sister_13",
      "hash64": "A3B9E32AC7EB9410",
      "text": "¡Y, bueno, tampoco es que no nos vayamos\\na volver a ver nunca más![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
