      "label": "sdc01_0485_caretaker_10",
      "hash64": "315486D224E2A80F",
      "text": "Hay que ver cómo es esta chica...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
