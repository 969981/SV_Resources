          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc01_0485_sister_16",
      "hash64": "A3B9E82AC7EB9C8F",
      "text": "Me niego a decirte adiós, así que... ¡Hasta otra![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
