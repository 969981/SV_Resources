    },
    {
      "ordinal": 25,
      "label": "coach_paldea_friend_sp02_08",
      "hash64": "C6DB044A1C28CFD1",
      "text": "Si preparar bocadillos no es algo tan raro aquí,\\n¿a qué venía tanta fascinación?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
