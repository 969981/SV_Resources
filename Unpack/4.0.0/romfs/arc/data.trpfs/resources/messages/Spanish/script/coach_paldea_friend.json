      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_paldea_friend_sp02_select_02",
      "hash64": "0525F87097BB15CC",
      "text": "Yo diría que sí se lleva...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_paldea_friend_sp02_02",
      "hash64": "C6DAFA4A1C28BED3",
      "text": "¿Cómo? ¿Que tuviste que preparar un bocadillo\\nextrapicante para un reto del Alto Mando?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
