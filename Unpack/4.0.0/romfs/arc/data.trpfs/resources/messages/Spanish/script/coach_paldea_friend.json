    {
      "ordinal": 10,
      "label": "coach_paldea_friend_sp01_05",
      "hash64": "CB523F60EF7A9845",
      "text": "Lo bueno es que podré seguir con mis estudios\\naun estando aquí.\\c\\n¡El director Clavel me ha dicho que podrían\\nconvalidarme algunas clases![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
