    },
    {
      "ordinal": 11,
      "label": "class_e_07_battle_12",
      "hash64": "83C9B1680E1EC5C6",
      "text": "Sin embargo, si seleccionáis el [VAR 0xFF00(0006)]reglamento[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]normal[VAR 0xFF00(0000)], todos los Pokémon pasarán a ser de\\r\\nNv. 50 para el combate, sin importar el nivel\\r\\nque tuviesen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
