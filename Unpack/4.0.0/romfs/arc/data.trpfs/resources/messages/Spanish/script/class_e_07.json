          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_e_07_battle_25",
      "hash64": "83D3C4680E273A94",
      "text": "Con el reglamento normal, todos los Pokémon\\ncombatirán a Nv. 50; con el reglamento con\\r\\nrestricciones, en cambio, cada uno mantendrá\\r\\nsu nivel actual si es inferior a 50.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
