          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "a_sch_shop01_eve03",
      "hash64": "56B8FDC8C1F133E1",
      "text": "Imagina tener que caminar hasta la ciudad cada\\nvez que necesitaras algo... ¡Uf!\\c\\n¡No sé qué haría sin la tienda de la academia!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "a_sch_shop01_eve06",
      "hash64": "56B900C8C1F138FA",
      "text": "Es muuuy frustrante quedarse sin Poké Balls y ver\\nhuir al Pokémon que estabas intentando capturar.\\c\\n¡Voy a comprar todas las que pueda para que\\nnunca vuelva a ocurrirme!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "a_sch_shop01_eve07",
      "hash64": "56B901C8C1F13AAD",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
