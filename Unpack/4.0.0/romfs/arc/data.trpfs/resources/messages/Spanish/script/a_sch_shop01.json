    {
      "ordinal": 0,
      "label": "a_sch_shop01_eve01",
      "hash64": "56B8FBC8C1F1307B",
      "text": "Mi Pokémon siempre se queda frito a la primera\\nde cambio.\\c\\n¿Estará usando el movimiento Descanso para\\nreponer fuerzas?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
