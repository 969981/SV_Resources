    {
      "ordinal": 10,
      "label": "a_sch_shop01_ni04",
      "hash64": "686AA935F8946BE7",
      "text": "Pociones, Antiparalizadores, unos cuantos\\nAntídotos...\\c\\n¿Debería echar un par de Antihielos a la cesta\\nya que estoy?",
      "flags": 0,
      "text_status": "DECODED",
