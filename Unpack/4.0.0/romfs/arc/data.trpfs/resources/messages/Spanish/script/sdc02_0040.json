            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0040_fairybb_09",
      "hash64": "EE9E03F44274D84E",
      "text": "¿Cómo? ¡¿Yo?![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc02_0040_headbb_15",
      "hash64": "9127BAF43F83EF74",
      "text": "Hombre, si lo hago yo solo, me sentiría un tanto\\ndesamparado.\\c\\nTú controlas mejor estos temas, ¿no te parece?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc02_0040_fairybb_10",
      "hash64": "EE9A76F44271B2E0",
      "text": "Bueno, eso no se lo voy a discutir, pero tiene que\\nhaber alguien más indicado que yo para...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc02_0040_fairybb_11",
      "hash64": "EE9A77F44271B493",
      "text": "¡Ah, no te lo tomes a mal, por favor! No insinúo\\nen absoluto que me disguste la idea.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc02_0040_fairybb_12",
      "hash64": "EE9A78F44271B646",
      "text": "Es simplemente que el director Mirtilo tiene por\\ncostumbre delegar sus funciones y...[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0040_fairybb_13",
      "hash64": "EE9A79F44271B7F9",
      "text": "¡Eso no está nada bien![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
