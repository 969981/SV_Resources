      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0040_headbb_02",
      "hash64": "91242FF43F80CD6C",
      "text": "¡Bienvenid[VAR 0x1100(00FF,0101)]oa a mi querida Academia Arándano![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
