          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0040_headbb_03",
      "hash64": "912430F43F80CF1F",
      "text": "Eso que tienes ante ti es la entrada. El resto de\\nla academia se encuentra sumergida bajo el mar.\\c\\n¿A que es genial? ¡Magia potagia![VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0040_headbb_04",
      "hash64": "91242DF43F80CA06",
      "text": "Y fíjate en esto...[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0040_headbb_05",
      "hash64": "91242EF43F80CBB9",
      "text": "Menuda explosión de azul, ¿eh? Azul arándano,\\npara ser más exactos. ¡Nuestra seña de identidad![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0040_headbb_06",
      "hash64": "91242BF43F80C6A0",
      "text": "Y no sé qué más te podría contar...[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0040_headbb_07",
      "hash64": "91242CF43F80C853",
      "text": "O más bien cuéntame tú, ¡no me seas tímid[VAR 0x1100(00FF,0101)]oa!\\n¿No tienes alguna pregunta?[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0040_select_01",
      "hash64": "65A9E70EAD5FA5C7",
      "text": "¿Por qué está sumergida la academia?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc02_0040_select_02",
      "hash64": "65A9E80EAD5FA77A",
      "text": "¿De dónde proviene el nombre?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sdc02_0040_select_03",
      "hash64": "65A9E90EAD5FA92D",
      "text": "¿De qué conoce al director Clavel?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc02_0040_headbb_08",
      "hash64": "912439F43F80DE6A",
      "text": "Conque en eso te has ido a fijar. Nos ha salido\\ncurios[VAR 0x1100(00FF,0101)]oa [VAR 0x1100(00FF,0202)]ella nuev[VAR 0x1100(00FF,0101)]oa.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0202"
          ]
        },
        {
          "kind": "control",
          "offset_units": 76,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0040_headbb_09",
      "hash64": "91243AF43F80E01D",
      "text": "¡Pero eso tiene fácil respuesta! ¿Cómo era?\\nSí, hombre, sí, en concreto, esto...[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0040_fairybb_01",
      "hash64": "EE9DFBF44274CAB6",
      "text": "Al parecer, por la planta submarina anexa a la\\nacademia desde donde se estudian y aprovechan\\r\\nlos recursos naturales renovables de la zona.[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0040_fairybb_02",
      "hash64": "EE9DFAF44274C903",
      "text": "Proviene de lo que representa el arándano en el\\nmundo de las flores: una vida fructífera.\\c\\n¡Al menos esa es la teoría, si no me equivoco![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0040_fairybb_03",
      "hash64": "EE9DF9F44274C750",
      "text": "Se conocieron en la uni, durante la época en la\\nque ambos cursaban sus estudios de posgrado.\\r\\n¡O al menos eso tengo entendido![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0040_headbb_10",
      "hash64": "9127B7F43F83EA5B",
      "text": "¡Exactamente! ¡Me has quitado las palabras de\\nla boca![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0040_headbb_11",
      "hash64": "9127B6F43F83E8A8",
      "text": "Tú siempre tan atenta, Aroa.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0040_fairybb_04",
      "hash64": "EE9E00F44274D335",
      "text": "No es nada.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0040_fairybb_05",
      "hash64": "EE9DFFF44274D182",
      "text": "¿Tenemos un[VAR 0x1100(00FF,0100)]a invitad[VAR 0x1100(00FF,0101)]oa hoy?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0040_headbb_12",
      "hash64": "9127B9F43F83EDC1",
      "text": "¡Y tanto! Te presento a [VAR 0x0100(0000)].\\c\\nHa venido como estudiante de intercambio.\\n¡Espero que hagáis buenas migas![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0040_fairybb_06",
      "hash64": "EE9DFEF44274CFCF",
      "text": "¡Hala! ¿Es [VAR 0x1100(00FF,0909)]el famosola famosa estudiante que decían que\\niba a venir desde Paldea?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0909"
          ]
        },
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0040_fairybb_07",
      "hash64": "EE9DFDF44274CE1C",
      "text": "Uy, pues siento no haberme presentado antes.\\nSoy Aroa, estudiante de segundo curso.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0040_fairybb_08",
      "hash64": "EE9E04F44274DA01",
      "text": "Tienes que ser alguien fuera de lo común, ¿no?\\c\\nEl director Mirtilo no suele saberse los nombres\\nde los alumnos.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0040_headbb_13",
      "hash64": "9127B8F43F83EC0E",
      "text": "¡Pero bueno![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0040_headbb_14",
      "hash64": "9127BBF43F83F127",
      "text": "[VAR 0xBD06(0000)]En fin, Aroíta, ya puestos, ¿por qué no das un\\nvoltio por la academia con [VAR 0x0100(0000)]\\r\\ny le explicas\\r\\ncómo funciona todo?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
