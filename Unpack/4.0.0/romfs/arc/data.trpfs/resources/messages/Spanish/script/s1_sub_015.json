          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_015_caretaker_07",
      "hash64": "AA1A4AEB935F663E",
      "text": "Ya sé que los compatrones resultaron ser los\\nmalos del cuento...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_015_caretaker_08",
      "hash64": "AA1A45EB935F5DBF",
      "text": "¡Pero yo qué quieres que te diga! A mí me dan\\nuna pena tremenda las estatuas del parque que\\r\\nesos tres rompieron al resucitar. ¿A ti no?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_015_caretaker_09",
      "hash64": "AA1A44EB935F5C0C",
      "text": "¿A que sí? Tú me entiendes, ¿verdad, mocit[VAR 0x1100(00FF,0101)]oa?\\n¡Oish, mira que os educan bien en esa academia![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_015_caretaker_10",
      "hash64": "AA1747EB935D2B4E",
      "text": "¡Pero si tú viste en primera fila cómo dejaban\\nlas pobres hechas polvo!\\c\\nMira, aunque me digas eso, no me creo que te\\npuedan dejar indiferente.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_015_caretaker_11",
      "hash64": "AA1748EB935D2D01",
      "text": "Las estatuas en sí no tienen la culpa de que los\\ncompatrones fuesen unos malhechores...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_015_caretaker_12",
      "hash64": "AA1745EB935D27E8",
      "text": "En fin, todo esto para decirte que estamos\\nrecaudando fondos para reconstruir las estatuas.\\c\\nLo he denominado [VAR 0xFF00(0006)]colecta benéfica para los[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]compatrones[VAR 0xFF00(0000)].[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
