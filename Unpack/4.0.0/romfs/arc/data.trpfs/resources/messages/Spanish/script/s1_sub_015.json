      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s1_sub_015_select_02",
      "hash64": "D3AA8508D3BA50D9",
      "text": "Donar 100 000 ",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "s1_sub_015_select_03",
      "hash64": "D3AA8408D3BA4F26",
      "text": "Quizá en otra ocasión",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s1_sub_015_caretaker_17",
      "hash64": "AA174AEB935D3067",
      "text": "¿Quieres donar 10 000 ?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
