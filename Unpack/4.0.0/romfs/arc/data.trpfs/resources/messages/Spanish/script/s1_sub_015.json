          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_sub_015_caretaker_18",
      "hash64": "AA173FEB935D1DB6",
      "text": "¡Recórcholis! ¿En serio quieres donar 100 000 ?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
