          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_015_caretaker_15",
      "hash64": "AA174CEB935D33CD",
      "text": "¡Quizá podrías pedirles a tus padres o a tu tutor\\no algo así que contribuyan por ti![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
