          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s1_sub_015_caretaker_30",
      "hash64": "AA103BEB9356F83C",
      "text": "¡Pero qué obra de arte! ¡Han quedado idénticas!\\n¡Es como si nunca se hubiesen roto![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
