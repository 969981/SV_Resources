          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_015_caretaker_06",
      "hash64": "AA1A4BEB935F67F1",
      "text": "♪¡Por cieeerto!♪[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
