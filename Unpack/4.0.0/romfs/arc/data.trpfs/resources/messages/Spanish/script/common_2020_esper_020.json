    },
    {
      "ordinal": 6,
      "label": "common_2020_esper_020_esper_07",
      "hash64": "58CFA1D5E80849D4",
      "text": "¡Deja que te muestre el verdadero poder del\\nejercicio emocional![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
