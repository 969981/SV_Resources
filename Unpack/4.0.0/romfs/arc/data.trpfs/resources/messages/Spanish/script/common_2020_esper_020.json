      "ordinal": 12,
      "label": "common_2020_esper_020_esper_13",
      "hash64": "58CC1DD5E80533B1",
      "text": "¡Prométeme que llegarás a lo más alto![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
