          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_esper_020_esper_09",
      "hash64": "58CF97D5E80838D6",
      "text": "La industria del maquillaje es muy competitiva.\\nNo es raro que alguien con un talento decente\\r\\ndesaparezca de la noche a la mañana...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_esper_020_esper_10",
      "hash64": "58CC1AD5E8052E98",
      "text": "Cuando ven que ya no mejoran, se frustran.\\nCuanto más se obsesionan, peor les sale todo,\\r\\nhasta que no pueden más y tiran la toalla.\\c\\nAl final, lo pasan peor que la gente que carece\\nde talento alguno.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 204,
