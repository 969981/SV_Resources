          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_esper_020_esper_11",
      "hash64": "58CC1BD5E805304B",
      "text": "Serían más felices si hubieran nacido sin ese don,\\nprobablemente.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2020_esper_020_esper_12",
      "hash64": "58CC1CD5E80531FE",
      "text": "Dime que no correrás la misma suerte que ellos.\\nDime que pulirás tu talento para sacarle partido\\r\\nal máximo.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
