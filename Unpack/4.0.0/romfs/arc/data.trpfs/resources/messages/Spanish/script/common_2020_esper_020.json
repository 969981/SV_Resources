    },
    {
      "ordinal": 7,
      "label": "common_2020_esper_020_esper_08",
      "hash64": "58CF98D5E8083A89",
      "text": "Fuerza... Belleza... Chic[VAR 0x1100(00FF,0101)]oa, es que lo tienes todo.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
