        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_botan_b_doku_05",
      "hash64": "56D1999ADF00C4FB",
      "text": "Me gustaría aquistar los cinco ropajes de ninja\\nque hoy se ofrecen en aquesto puesto de venta.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
