          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_botan_b_06",
      "hash64": "E3AE72C104645EE0",
      "text": "La verdad es que, de todo el Team Star, en cierto\\nsentido Henzo es el que más me preocupa.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
