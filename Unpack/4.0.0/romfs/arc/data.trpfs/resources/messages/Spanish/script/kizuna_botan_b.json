      "hash64": "56D5229ADF03E39D",
      "text": "¡Camarada![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
