      "ordinal": 21,
      "label": "kizuna_botan_b_select_03",
      "hash64": "9C6186E66962170A",
      "text": "Hay que detenerlo",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
