          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_botan_b_shop_01",
      "hash64": "CEB99516CE53ECD8",
      "text": "Eeeh... ¿El disfraz de ninja, has dicho?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "kizuna_botan_b_shop_02",
      "hash64": "CEB99816CE53F1F1",
      "text": "Lo siento mucho. Se acaban de llevar los dos\\núltimos que nos quedaban.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_botan_b_doku_06",
      "hash64": "56D19A9ADF00C6AE",
      "text": "¡Oh, cruel destino!...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
