    },
    {
      "ordinal": 16,
      "label": "kizuna_botan_b_doku_07",
      "hash64": "56D19B9ADF00C861",
      "text": "Privado de esos ropajes, ¿qué será de mí?...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
