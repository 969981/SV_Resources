          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_botan_b_doku_09",
      "hash64": "56D1959ADF00BE2F",
      "text": "Y cuando lo encuentres... ¡Tendrás que postrarte\\nante él e implorar su generosidad![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_botan_b_07",
      "hash64": "E3AE73C104646093",
      "text": "¡Guaaau! ¿Henzo ha sido siempre así de guapo?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_botan_b_08",
      "hash64": "E3AE80C1046476AA",
      "text": "Ay, no, eso ahora no viene a cuento. Lo que\\nimporta es que va a hacer el ridículo si se tira\\r\\nal suelo de rodillas delante de otro cliente.\\c\\nSerá mejor que le paremos los pies,\\n¿no te parece?[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
