          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_botan_b_doku_08",
      "hash64": "56D1949ADF00BC7C",
      "text": "No, Henzo... ¡Aún hay esperanza! Síguele la pista\\nal rufián que adquirió las últimas existencias.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
