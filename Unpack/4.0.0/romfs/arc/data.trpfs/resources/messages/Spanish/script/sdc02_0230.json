          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0230_bbteacher_09",
      "hash64": "FA33AFC9DB9F0D2C",
      "text": "Bien, vayamos al grano entonces.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
