          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "sdc02_0230_chairman_15",
      "hash64": "7A9E1E6FC1E19ADA",
      "text": "Esto me hace considerar seriamente la necesidad\\nde retomar la investigación con carácter urgente.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "sdc02_0230_chairman_16",
      "hash64": "7A9E1D6FC1E19927",
      "text": "Sin embargo, la Liga Pokémon carece del tiempo\\ny recursos humanos necesarios para tal empresa...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sdc02_0230_chairman_17",
      "hash64": "7A9E1C6FC1E19774",
      "text": "Y de ahí que...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
