      "label": "sdc02_0230_dragonbb_07",
      "hash64": "907623C937B45489",
      "text": "A ver, ¿y su eminencia excampeonil qué opina?[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
