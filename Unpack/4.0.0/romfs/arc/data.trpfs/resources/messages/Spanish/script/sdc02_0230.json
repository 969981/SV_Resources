        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc02_0230_chairman_08",
      "hash64": "7A9A8D6FC1DE6EA0",
      "text": "Disculpadme por no haberme presentado como\\nmandan los cánones.\\c\\nMe llamo Ságita y presido la Liga Pokémon\\nde Paldea.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
