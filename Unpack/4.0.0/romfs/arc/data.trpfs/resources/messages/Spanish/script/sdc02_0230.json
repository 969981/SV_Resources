          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc02_0230_chairman_11",
      "hash64": "7A9E1A6FC1E1940E",
      "text": "El Área Cero es un lugar que rezuma misterio\\ny peligro a partes iguales.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
