          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0230_bbteacher_10",
      "hash64": "FA3032C9DB9C02EE",
      "text": "Quiero que vosotros y yo...[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
