    },
    {
      "ordinal": 46,
      "label": "sdc02_0230_chairman_18",
      "hash64": "7A9E136FC1E18829",
      "text": "Una tardanza inexcusable por nuestra parte.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
