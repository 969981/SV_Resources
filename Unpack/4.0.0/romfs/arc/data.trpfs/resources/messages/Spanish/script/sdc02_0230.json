          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "sdc02_0230_dragonbb_06",
      "hash64": "907622C937B452D6",
      "text": "Je, je, je. ¿Es tan obvio?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
