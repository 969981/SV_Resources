    },
    {
      "ordinal": 40,
      "label": "sdc02_0230_chairman_13",
      "hash64": "7A9E186FC1E190A8",
      "text": "No obstante...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
