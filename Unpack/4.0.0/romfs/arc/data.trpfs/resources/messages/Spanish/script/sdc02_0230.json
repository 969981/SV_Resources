      ]
    },
    {
      "ordinal": 59,
      "label": "sdc02_0230_sister_05",
      "hash64": "645DEB9FA07ED69A",
      "text": "Ya, fijo. A ti lo que te pasa es que te da pereza.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
