    {
      "ordinal": 4,
      "label": "common_2130_battle_02",
      "hash64": "3C3C46BF3B5E4141",
      "text": "¡No sabes las ganas que tenía de un torneo como\\neste!\\c\\nCuando termine, sabremos quién es el más fuerte\\nde toda la academia...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
