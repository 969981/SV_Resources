    },
    {
      "ordinal": 12,
      "label": "common_2130_battle_09",
      "hash64": "3C3C3BBF3B5E2E90",
      "text": "Qué derrota más vergonzosa...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
