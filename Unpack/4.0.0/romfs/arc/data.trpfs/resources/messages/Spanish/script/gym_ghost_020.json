    {
      "ordinal": 7,
      "label": "gym_ghost_020_mc_04",
      "hash64": "75CFE25A7E892527",
      "text": "Combates Dobles: ¡¡el doble de acción, el doble\\nde diversión y el doble de gresca!!\\c\\n¡Dale un buen espectáculo al público para hacer\\nque suba la temperatura y provocar un deshielo![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
