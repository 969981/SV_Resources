      ]
    },
    {
      "ordinal": 15,
      "label": "gym_ghost_020_mc_cancel",
      "hash64": "356C8E8436519EE5",
      "text": "Tranqui, que no te estamos pidiendo poca cosa.\\n¡Para esto hay que prepararse bien![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
