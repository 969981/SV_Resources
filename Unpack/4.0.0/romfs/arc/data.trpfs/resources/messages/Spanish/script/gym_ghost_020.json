          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_ghost_020_mc_06",
      "hash64": "75CFE45A7E89288D",
      "text": "¿Te ha quedado claro cómo va la cosa?\\n¿List[VAR 0x1100(00FF,0101)]oa para matxakar al rival?[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
