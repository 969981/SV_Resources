          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
