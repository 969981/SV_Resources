      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_ghost_020_mc_no_double",
      "hash64": "3CE24182F9EB5218",
      "text": "¡Eeepa! ¡Debes llevar al menos dos Pokémon\\ncontigo para participar, colega![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
