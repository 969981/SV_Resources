          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_f_06_dragon_11",
      "hash64": "F723C75829572574",
      "text": "Así como el pico más alto de Sierra Napada,\\nconocido como la [VAR 0xFF00(0006)]Cumbre de Paldea[VAR 0xFF00(0000)].[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_f_06_dragon_12",
      "hash64": "F723CA5829572A8D",
      "text": "Hay otro risco en Sierra Napada que debe su\\nnombre a su particular orografía.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_f_06_dragon_13",
      "hash64": "F723C958295728DA",
      "text": "Y ahora os formulo esta pregunta...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_f_06_dragon_14",
      "hash64": "F723C4582957205B",
      "text": "¿Cómo se llama este risco de tres picos de\\nSierra Napada?\\c\\nSi queréis una pista, os diré que el nombre alude\\na una parte del cuerpo.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
