          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "legend_0120_friend_16",
      "hash64": "12900872A6CF477D",
      "text": "Así que yo diría que, como mínimo, necesitamos\\na dos personas más...\\c\\nAlguien fuerte que [VAR 0xFF00(0006)]tenga el rango de Campeón[VAR 0xFF00(0000)]\\ny alguien que [VAR 0xFF00(0006)]sea un as de la tecnología[VAR 0xFF00(0000)]...[VAR 0x0114(0006)]",
