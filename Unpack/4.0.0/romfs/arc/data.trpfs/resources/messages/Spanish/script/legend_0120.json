      ]
    },
    {
      "ordinal": 29,
      "label": "legend_0120_friend_17b",
      "hash64": "5A024FD172335C78",
      "text": "¡Ostras! ¡Pues yo diría que ya tenemos a dos\\ncandidatas perfectas para nuestro equipo![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "legend_0120_friend_18b",
      "hash64": "59D661D1720E4023",
      "text": "No te preocupes, que ya me encargo yo de\\nponerme en contacto con ellas.\\c\\n¿Sabes esa instalación que hay al lado del foso,\\nla Puerta Cero? ¡Pues nos vemos allí!\\c\\nTe mando la ubicación. ¡No tardes![VAR 0x0114(0006)]",
