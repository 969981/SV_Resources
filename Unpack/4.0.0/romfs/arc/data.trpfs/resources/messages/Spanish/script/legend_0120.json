      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "legend_0120_friend_05",
      "hash64": "128CF972A6CCF829",
      "text": "¡Mabosstiff está más que preparado![VAR 0x0114(0006)]",
