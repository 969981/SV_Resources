    {
      "ordinal": 6,
      "label": "legend_0120_select_01",
      "hash64": "5ACB8C3B6D658065",
      "text": "¡¿Vas a luchar con Mabosstiff?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "legend_0120_select_02",
      "hash64": "5ACB893B6D657B4C",
      "text": "¡¿Estás seguro?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "legend_0120_friend_06",
      "hash64": "128CF672A6CCF310",
      "text": "Entiendo que te preocupes por él, pero...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
