          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "legend_0120_friend_18a",
      "hash64": "59D662D1720E41D6",
      "text": "¡Tú sigue pensando por si se te ocurre alguien\\nmás a quien pueda interesarle![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
