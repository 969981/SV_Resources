          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "legend_0120_friend_08",
      "hash64": "128D0472A6CD0ADA",
      "text": "No para de lloriquear y de pedirme que le deje\\nluchar contra ti.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
