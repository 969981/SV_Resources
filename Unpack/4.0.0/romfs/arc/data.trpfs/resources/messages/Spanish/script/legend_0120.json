      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "legend_0120_select_04",
      "hash64": "5ACB873B6D6577E6",
      "text": "¡Noa sería perfecta!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "legend_0120_select_05",
      "hash64": "5ACB883B6D657999",
