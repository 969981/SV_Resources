          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "legend_0120_friend_09",
      "hash64": "128D0572A6CD0C8D",
      "text": "Este campeón siempre ha sido un apasionado\\nde los combates.\\c\\nAunque tampoco esperes algo al nivel de la\\ndelegada...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
