    {
      "ordinal": 16,
      "label": "s2_sub_002_follower_16",
      "hash64": "B8610CDEF172672B",
      "text": "Pues me temo que todavía no has superado el\\nnivel fácil.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s2_sub_002_follower_17",
      "hash64": "B8610BDEF1726578",
      "text": "En cuanto al nivel intermedio, todavía no lo has\\nsuperado.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "s2_sub_002_follower_18",
      "hash64": "B8610ADEF17263C5",
      "text": "Por lo que respecta al nivel difícil, todavía no lo\\nhas superado.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s2_sub_002_select_01",
      "hash64": "7C1C955AA8057B4D",
      "text": "¡Vamos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "s2_sub_002_select_02",
      "hash64": "7C1C925AA8057634",
      "text": "¿Me lo explicas?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "s2_sub_002_select_03",
      "hash64": "7C1C935AA80577E7",
      "text": "¿Cuáles son mis plusmarcas?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "s2_sub_002_select_04",
      "hash64": "7C1C905AA80572CE",
