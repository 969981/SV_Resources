    },
    {
      "ordinal": 37,
      "label": "s2_sub_002_follower_30",
      "hash64": "B867FEDEF1786E0F",
      "text": "El nivel ultradifícil, por último, todavía no lo has\\nsuperado.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "s2_sub_002_follower_31",
      "hash64": "B867FDDEF1786C5C",
      "text": "¡Guau, menuda hazaña la tuya! ¡Me rindo ante ti!\\n¡Has superado el mismísimo nivel ultradifícil!\\c\\nTe felicito de todo corazón. Y, como muestra,\\n¡aquí tienes un aluvión de puntos arándano!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
