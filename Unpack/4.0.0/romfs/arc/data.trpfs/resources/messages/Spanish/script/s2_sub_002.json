  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_002_follower_01",
      "hash64": "B85D8DDEF16F5987",
      "text": "¡Felicidades por tu victoria contra Nerina!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_002_follower_02",
      "hash64": "B85D8EDEF16F5B3A",
      "text": "Aquí podrás afrontar su reto tanto como quieras,\\nindependientemente de la Liga Arándano.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_002_follower_03",
      "hash64": "B85D8FDEF16F5CED",
      "text": "¿Quieres afrontar el vuelo contrarreloj?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_002_follower_04",
      "hash64": "B85D88DEF16F5108",
      "text": "¿En qué nivel?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_002_follower_05",
      "hash64": "B85D89DEF16F52BB",
      "text": "El nivel fácil, ¿no? ¡Vale, pues a divertirse!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_002_follower_06",
      "hash64": "B85D8ADEF16F546E",
      "text": "El nivel intermedio, ¿no? ¡Vale, pues a por todas!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_002_follower_07",
      "hash64": "B85D8BDEF16F5621",
      "text": "El nivel difícil, ¿no? ¡Vale, pues procura hilar fino!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_002_follower_19",
      "hash64": "B86109DEF1726212",
      "text": "El nivel ultradifícil, ¿no? ¡Vale, pues procura hilar\\nultrafino!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_002_follower_08",
      "hash64": "B85D84DEF16F4A3C",
      "text": "Deberás surcar los cielos del Biodomo utilizando\\nlas capacidades voladoras de tu Pokémontura.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s2_sub_002_follower_09",
      "hash64": "B85D85DEF16F4BEF",
      "text": "Si llegas a la meta respetando el tiempo límite\\nconcedido, obtendrás el aprobado.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_002_follower_10",
      "hash64": "B86112DEF172715D",
      "text": "Al atravesar los aros de Magnemite, se extenderá\\ndicho tiempo límite.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_002_follower_11",
      "hash64": "B86111DEF1726FAA",
      "text": "¡Esfuérzate al máximo e intenta superar tu propia\\nplusmarca!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_002_follower_12",
      "hash64": "B86110DEF1726DF7",
      "text": "A ver, que echo un vistazo...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
