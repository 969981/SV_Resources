      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_side02_0020_camera_13",
      "hash64": "91110CA99DBAE271",
      "text": "Contigo a mi lado, puede que logre encontrarlo\\ny sacarle una foto. Entonces, seguro que...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
