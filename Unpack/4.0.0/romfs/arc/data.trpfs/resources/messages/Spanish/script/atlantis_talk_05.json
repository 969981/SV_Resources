        }
      ]
    },
    {
      "ordinal": 2,
      "label": "atlantis_talk_05_rival_02",
      "hash64": "169E9D8064C84F50",
      "text": "¿Me dejas que me enfrente a él?\\n¡Porfa, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
