      "label": "atlantis_talk_05_rival_10",
      "hash64": "16A1A58064CA92BF",
      "text": "¡Ya te vale! ¿Cómo no compartes algo tan gordo\\ncon tus amig[VAR 0x1100(00FF,0101)]oas?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
