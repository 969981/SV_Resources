          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "atlantis_talk_05_friend_11",
      "hash64": "6C5D8931BFB6FA76",
      "text": "Llegué a odiar tanto a [VAR 0x0101(0001)] que ni\\nsiquiera quería hablar de él.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
