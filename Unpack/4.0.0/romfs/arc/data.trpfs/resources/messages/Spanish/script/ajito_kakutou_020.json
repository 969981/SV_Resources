    {
      "ordinal": 1,
      "label": "ajito_kakutou_020_cassiopeia_01",
      "hash64": "781BBADBBA8A3082",
      "text": "Veo que ya te has encargado de la guardia.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
