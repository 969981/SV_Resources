    },
    {
      "ordinal": 2,
      "label": "ajito_kakutou_020_cassiopeia_02",
      "hash64": "781BB9DBBA8A2ECF",
      "text": "Te encuentras ante la base del Escuadrón Caph,\\nel grupo Lucha del Team Star.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
