    },
    {
      "ordinal": 9,
      "label": "ajito_kakutou_020_cassiopeia_07",
      "hash64": "781BB4DBBA8A2650",
      "text": "¡¿Que Eri se retiró?! ¡Imposible![VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_kakutou_020_cassiopeia_08",
      "hash64": "781BC3DBBA8A3FCD",
      "text": "En ese caso, un ataque directo a la base es tu\\núnica opción.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
