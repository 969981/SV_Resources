          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_kakutou_020_select_01",
      "hash64": "27F32B7B4AAD33F3",
      "text": "Así ha sido",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_kakutou_020_select_02",
      "hash64": "27F32C7B4AAD35A6",
      "text": "Ya me la he encontrado",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "ajito_kakutou_020_cassiopeia_06",
      "hash64": "781BB5DBBA8A2803",
      "text": "¡Lo sabía! ¿Qué ha pasado?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
