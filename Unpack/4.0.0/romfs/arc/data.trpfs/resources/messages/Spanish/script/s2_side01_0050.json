      "text": "¡Qué disciplinado! ¿Creéis que estará en casa?\\nPodríamos ir a echar un vistazo.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
