    {
      "ordinal": 11,
      "label": "s2_side01_0050_friend_03",
      "hash64": "CA7C0610D7005E64",
      "text": "¿Pero qué dices? ¡Te patina la mandarina!\\nNosotros tres no habíamos venido nunca aquí.[VAR 0x0114(0006)]",
