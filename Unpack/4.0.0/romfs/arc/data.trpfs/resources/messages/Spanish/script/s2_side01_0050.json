    {
      "ordinal": 2,
      "label": "s2_side01_0050_botan_01",
      "hash64": "8E475FE6A0AFCAA8",
      "text": "Uuuh... Qué mareo llevo encima...\\n¿Falta mucho?...[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
