    {
      "ordinal": 3,
      "label": "s2_side01_0050_friend_01",
      "hash64": "CA7C0810D70061CA",
      "text": "Eso te pasa por tirarte todo el viaje mirando\\nel móvil.[VAR 0x0114(0006)]",
