    {
      "ordinal": 13,
      "label": "s2_side01_0050_caretaker_06",
      "hash64": "A86DDDBE5C0FE933",
      "text": "Podéis alojaros en este edificio, faltaría más.\\nLos futones ya están preparados.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
