    {
      "ordinal": 18,
      "label": "s2_side01_0050_botan_04",
      "hash64": "8E4764E6A0AFD327",
      "text": "¿Que quéee? ¿Cómo que NO tiene móvil?\\n¡¿Pero todavía existe gente así?![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
