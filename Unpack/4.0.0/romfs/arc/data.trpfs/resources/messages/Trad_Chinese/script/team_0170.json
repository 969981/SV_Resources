      "text": "[VAR 0x0100(0000)]同學，\\n[VAR 0x1100(00FF,0101)]你妳來了啊。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
