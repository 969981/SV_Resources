  "source": "message/dat/Trad_Chinese/script/sub_017.dat",
  "paired_tbl": "message/dat/Trad_Chinese/script/sub_017.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_017_system_kui_01",
      "hash64": "9AE43EF6D8FB58EC",
      "text": "這裡埋著漆黑且\\n散發不祥氣息的樁柱……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_017_system_kui_02",
      "hash64": "9AE441F6D8FB5E05",
      "text": "要拔出樁柱嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_017_system_kui_03",
      "hash64": "9AE440F6D8FB5C52",
      "text": "拔出樁柱後，\\n樁柱開始崩裂然後消失了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_017_system_kui_04",
      "hash64": "9AE43BF6D8FB53D3",
      "text": "咕……喲……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_017_system_kui_05",
      "hash64": "9AE43AF6D8FB5220",
      "text": "從祠堂的方向\\n傳來了謎樣的聲音……！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_017_system_release_01",
      "hash64": "7540343DC23ACBCA",
      "text": "從祠堂裡傳出了\\n微弱的聲響……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_017_system_release_02",
      "hash64": "7540333DC23ACA17",
      "text": "要觸摸祠堂嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_017_system_release_03",
      "hash64": "7540323DC23AC864",
      "text": "喀噠喀噠喀噠喀噠……\\n嘎噠嘎噠……嘎噠嘎噠！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_017_system_release_07",
      "hash64": "75402E3DC23AC198",
      "text": "嘎噠～！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_017_system_release_04",
      "hash64": "7540313DC23AC6B1",
      "text": "咕喲咕喲～",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_017_system_release_05",
      "hash64": "7540303DC23AC4FE",
      "text": "古玉魚\\n再次被封印到祠堂中了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_017_system_release_06",
      "hash64": "75402F3DC23AC34B",
      "text": "祠堂的門看來\\n暫時不會打開了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_017_system_hokora_01",
      "hash64": "81FC49FF6742A6ED",
      "text": "祠堂上刻著模糊的文字……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_017_system_hokora_02",
      "hash64": "81FC46FF6742A1D4",
      "text": "災禍之玉封印於此",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_017_system_hokora_03",
      "hash64": "81FC47FF6742A387",
      "text": "災禍之玉封印已解",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
