      "hash64": "7ADAD7B0E91C4F52",
      "text": "[VAR 0x1100(00FF,0101)]你妳就是傳說中的\\n[VAR 0x0100(0000)]同學……是吧？[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
