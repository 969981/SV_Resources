{
  "version": "4.0.0",
  "language": "zh-Hant",
  "language_raw": "Trad_Chinese",
  "source": "message/dat/Trad_Chinese/script/t03.dat",
  "paired_tbl": "message/dat/Trad_Chinese/script/t03.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "t03_01",
      "hash64": "E3798BA06D461908",
      "text": "經常幫寶可夢回復體力！\\n看到商店就去買必需品！\\r\\n這就是冒險的秘訣！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "t03_03",
      "hash64": "E3798DA06D461C6E",
      "text": "我用這台卡車在運送橄欖。\\n收成的時期總是忙得不可開交！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "t03_14",
      "hash64": "E37602A06D42FA66",
      "text": "「慕滋」賣的點心！\\n滋味很～美妙，非常受歡迎喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "t03_15",
      "hash64": "E37603A06D42FC19",
      "text": "圓模道館的道館館主是\\n戰鬥甜點師，阿楓！\\r\\n可別因為她外表甜美就大意了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "t03_16",
      "hash64": "E37600A06D42F700",
      "text": "圓模鎮正在\\n慶祝橄欖豐收祭！\\r\\n道館測驗也配合豐收祭做了調整喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "t03_17",
      "hash64": "E37601A06D42F8B3",
      "text": "滾啊滾鏘鏘～！\\c\\n團珠蛛會用線球包覆住身體，\\n保護自己不受外敵傷害喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "t03_23",
      "hash64": "E372FDA06D40BC10",
      "text": "這裡是圓模鎮。\\n意思就是個圓形的模子！\\r\\n形狀和橄欖一樣呢！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "t03_28",
      "hash64": "E37308A06D40CEC1",
      "text": "據說彩粉蝶的樣子\\n會按照棲息地而不一樣。\\c\\n這些傢伙是從哪裡來的呢？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "t03_39",
      "hash64": "E36F83A06D3DB6EB",
      "text": "在這間店可以一邊喝茶，\\n一邊觀賞道館的對戰。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
