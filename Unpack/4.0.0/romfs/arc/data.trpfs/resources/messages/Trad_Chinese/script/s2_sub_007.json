      "hash64": "BBF28BAC09D8D5AF",
      "text": "[VAR 0x0100(0000)]！[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
