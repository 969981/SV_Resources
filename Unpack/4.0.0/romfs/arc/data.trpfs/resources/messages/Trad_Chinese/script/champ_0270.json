    },
    {
      "ordinal": 34,
      "label": "champ_0270_rival_answer_a01",
      "hash64": "D41EE9F3AD4C6109",
      "text": "啊哈哈！我家後面呀！\\n那是我們第一次對戰的地方呢～[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
