          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2020_koori_020_koori_13",
      "hash64": "9154015018C5D559",
      "text": "下次對戰時，我不會輸給[VAR 0x1100(00FF,0101)]你妳的。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2020_koori_020_koori_14",
      "hash64": "9154025018C5D70C",
      "text": "下雪山時多小心，\\n別感冒了。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
