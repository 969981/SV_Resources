          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_kusa_010_kusa_08",
      "hash64": "5570CEF19675B47A",
      "text": "只要能再次與[VAR 0x1100(00FF,0101)]你妳合作，\\n理由是什麼都沒關係！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
