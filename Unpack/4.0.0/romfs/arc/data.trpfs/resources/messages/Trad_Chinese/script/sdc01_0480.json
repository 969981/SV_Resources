      "hash64": "17B1F8D2AF61C93D",
      "text": "[VAR 0x0100(0000)]，\\n[VAR 0x1100(00FF,0101)]你妳昨天好厲害啊。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
