          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_botan_c_02",
      "hash64": "0E9970B5BB587DA9",
      "text": "人家是第一次走進美術教室。\\n顏料的味道……\\r\\n聞起來真不錯。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_botan_c_select_01",
      "hash64": "8AB98C4D1ECCC26F",
      "text": "怎麼了嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_botan_c_select_02",
      "hash64": "8AB98D4D1ECCC422",
      "text": "有事嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_botan_c_03",
      "hash64": "0E996FB5BB587BF6",
      "text": "啊，其實呢……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_botan_c_04",
      "hash64": "0E9972B5BB58810F",
      "text": "人、人家聽到傳聞，\\n說天星隊要來美術教室大鬧，\\r\\n有些擔心所以來看看……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_botan_c_05",
      "hash64": "0E9971B5BB587F5C",
      "text": "雖然人家知道那應該只是胡說八道，\\n畢竟有一些人還很害怕天星隊……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_botan_c_06",
      "hash64": "0E9974B5BB588475",
      "text": "總之不可能。\\n那種事情是不會發生的。\\r\\n再說，為什麼要來美術教室大鬧？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_botan_c_hono_01",
      "hash64": "32C34BE2DE9BCEED",
      "text": "打擾囉～[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_botan_c_07",
      "hash64": "0E9973B5BB5882C2",
      "text": "欸！還真的來了！？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_botan_c_kakutou_01",
      "hash64": "BC38D191D225A331",
      "text": "哇～是姆克鷹！\\n牠是在使出近身戰嗎？[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_botan_c_hono_02",
      "hash64": "32C348E2DE9BC9D4",
      "text": "我說你……\\n你是美術社的社員嗎？[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_botan_c_student_01",
      "hash64": "FAD62A53CBFFD714",
      "text": "是、是的……\\n我是社員……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_botan_c_hono_03",
      "hash64": "32C349E2DE9BCB87",
      "text": "…………[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_botan_c_08",
      "hash64": "0E9976B5BB5887DB",
      "text": "該、該不會要來大鬧的傳聞是真的！？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_botan_c_09",
      "hash64": "0E9975B5BB588628",
      "text": "不、不對，\\n不可能有那一回事的。\\r\\n總之先看看狀況……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_botan_c_student_02",
      "hash64": "FAD62D53CBFFDC2D",
      "text": "那個……\\n有什麼事嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_botan_c_hono_04",
      "hash64": "32C346E2DE9BC66E",
      "text": "就是……那個……\\n我打……打……[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_botan_c_student_03",
      "hash64": "FAD62C53CBFFDA7A",
      "text": "打……？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "kizuna_botan_c_hono_05",
      "hash64": "32C347E2DE9BC821",
      "text": "打爛！！[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_botan_c_10",
      "hash64": "0E9608B5BB55971A",
      "text": "什麼！？\\n果然是要來大鬧的！？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_botan_c_kakutou_02",
      "hash64": "BC38CE91D2259E18",
      "text": "才不是那樣的吧，梅洛！！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_botan_c_kakutou_03",
      "hash64": "BC38CF91D2259FCB",
      "text": "妳要害羞我是沒意見，\\n但妳掩飾的方法也太糟了！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_botan_c_hono_06",
      "hash64": "32C344E2DE9BC308",
      "text": "抱、抱歉，枇琶姐……[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_botan_c_hono_07",
      "hash64": "32C345E2DE9BC4BB",
      "text": "那個呀……\\n我打算……成為社員。\\r\\n我想加入……美術社……[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_botan_c_student_04",
      "hash64": "FAD62753CBFFD1FB",
      "text": "啊，社員！妳想加入美術社啊。\\n呼～真是嚇壞我了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "kizuna_botan_c_student_05",
      "hash64": "FAD62653CBFFD048",
      "text": "那個～要加入美術社，\\n基本上是沒問題……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "kizuna_botan_c_kakutou_04",
      "hash64": "BC38D491D225A84A",
      "text": "太好了！梅洛！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_botan_c_hono_08",
      "hash64": "32C342E2DE9BBFA2",
      "text": "不，等等，枇琶姐。\\n這傢伙剛剛是說「基本上」。\\r\\n該不會有什麼交換條件嗎？[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_botan_c_student_06",
      "hash64": "FAD62953CBFFD561",
      "text": "啊，不是，我只是想聽聽看\\n妳想加入美術社的理由……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "kizuna_botan_c_hono_09",
      "hash64": "32C343E2DE9BC155",
      "text": "理由嗎……[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_botan_c_hono_10",
      "hash64": "32C6B0E2DE9EB063",
      "text": "我的這身衣服和靴子\\n都是朋友幫我做的……[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_botan_c_hono_11",
      "hash64": "32C6AFE2DE9EAEB0",
      "text": "我很喜歡像這種\\n火焰在燃燒的設計……\\r\\n所以也想要自己做做看。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "kizuna_botan_c_hono_12",
      "hash64": "32C6B2E2DE9EB3C9",
      "text": "……所以！畫畫！\\n我想試試看畫畫！[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "kizuna_botan_c_hono_13",
      "hash64": "32C6B1E2DE9EB216",
      "text": "雖然到現在為止，\\n我從來沒有任何畫畫的經驗……[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_botan_c_hono_14",
      "hash64": "32C6B4E2DE9EB72F",
      "text": "但我看了牆壁上那幅小箭雀的畫，\\n就覺得就算畫得不好，\\r\\n只要有味道就行了。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "kizuna_botan_c_student_07",
      "hash64": "FAD62853CBFFD3AE",
      "text": "小箭雀……\\n那是……我的作品……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "kizuna_botan_c_hono_15",
      "hash64": "32C6B3E2DE9EB57C",
      "text": "你的作品！？\\n那不是５歲小孩的畫！？[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "kizuna_botan_c_student_08",
      "hash64": "FAD62353CBFFCB2F",
      "text": "啊哈哈，經常有人這麼說。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "kizuna_botan_c_mobs_01",
      "hash64": "B969FCA4B7C06176",
      "text": "我們社長的畫，\\n特色就在那份純真的感覺喔～",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "kizuna_botan_c_hono_16",
      "hash64": "32C6B6E2DE9EBA95",
      "text": "什麼！而且你竟然是社長！？[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "kizuna_botan_c_mobs_02",
      "hash64": "B969FBA4B7C05FC3",
      "text": "那個，妳叫什麼名字！？\\n以後請多多指教！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "kizuna_botan_c_mobs_03",
      "hash64": "B969FAA4B7C05E10",
      "text": "妳的靴子好酷喔！\\n讓我仔細看看！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "kizuna_botan_c_hono_17",
      "hash64": "32C6B5E2DE9EB8E2",
      "text": "我、我叫做梅洛可……\\n呃……我的靴子很帥吧？\\r\\n這是我的一個阿宅朋友幫我做的。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "kizuna_botan_c_11",
      "hash64": "0E9609B5BB5598CD",
      "text": "大、大鬧果真是個誤會。\\n……總之，真是太好了。\\r\\n梅洛成了美術社社員啊～[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "kizuna_botan_c_kakutou_05",
      "hash64": "BC38D591D225A9FD",
      "text": "真想趕快看到梅洛畫的作品，是吧～[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "kizuna_botan_c_12",
      "hash64": "0E9606B5BB5593B4",
      "text": "嗯……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "kizuna_botan_c_13",
      "hash64": "0E9607B5BB559567",
      "text": "哇，枇琶姐！\\n妳早就發現我一直在觀察嗎！？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "kizuna_botan_c_kakutou_06",
      "hash64": "BC38D291D225A4E4",
      "text": "妳覺得自己躲得很好嗎！？\\n牡丹[VAR 0x1100(00FF,0101)]你妳們就大大方方地在這裡，\\r\\n我還覺得奇怪呢……[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "kizuna_botan_c_kakutou_07",
      "hash64": "BC38D391D225A697",
      "text": "不過梅洛她緊張得都沒注意到。[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "kizuna_botan_c_14",
      "hash64": "0E9604B5BB55904E",
      "text": "咦？梅洛她也會緊張？？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "kizuna_botan_c_kakutou_08",
      "hash64": "BC38C891D22593E6",
      "text": "不論是誰，挑戰新事物總會害怕的。\\n……所以我就陪她來了！\\r\\n不過，看來她一個人也沒問題了。[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "kizuna_botan_c_kakutou_09",
      "hash64": "BC38C991D2259599",
      "text": "對了！\\n我也和田中一起\\r\\n建立了摔角社喔。[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "kizuna_botan_c_kakutou_10",
      "hash64": "BC3C5691D228BB07",
      "text": "我要盡情享受校園生活，\\n不會輸給梅洛的！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "kizuna_botan_c_kakutou_11",
      "hash64": "BC3C5591D228B954",
      "text": "那麼，今天星苦了～！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "kizuna_botan_c_15",
      "hash64": "0E9605B5BB559201",
      "text": "…………[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "kizuna_botan_c_16",
      "hash64": "0E9602B5BB558CE8",
      "text": "梅洛和枇琶姐都在努力。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "kizuna_botan_c_17",
      "hash64": "0E9603B5BB558E9B",
      "text": "人家也該努力……\\n今天星苦了～[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
