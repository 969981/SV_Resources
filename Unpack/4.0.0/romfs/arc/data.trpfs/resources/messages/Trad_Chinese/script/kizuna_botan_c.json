    {
      "ordinal": 0,
      "label": "kizuna_botan_c_01",
      "hash64": "0E996DB5BB587890",
      "text": "哈、哈囉，[VAR 0x0100(0000)]。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
