    {
      "ordinal": 24,
      "label": "s2_sub_041_synchro_20",
      "hash64": "86FEB5196341F1BB",
      "text": "唔唔～嗯！[VAR 0x1100(00FF,0101)]你妳的同步性\\n簡直要衝破表了！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
