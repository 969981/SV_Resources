            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0485_bbteacher_02",
      "hash64": "7248949413607152",
      "text": "這樣所有人……也不到所有，\\n但參加者都到齊了。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0485_sister_01",
      "hash64": "A3B6612AC7E88153",
      "text": "…………[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0485_bbteacher_03",
      "hash64": "7248959413607305",
      "text": "那麼，\\n管理員先生，請吧。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0485_caretaker_01",
      "hash64": "315101D224DF9039",
      "text": "好的，欸～\\n大家早安。[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0485_caretaker_02",
      "hash64": "3150FED224DF8B20",
      "text": "想不到，所有的小組都\\n找完了寫有北上歷史的看板……\\r\\n順利完成定向越野了！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0020_student1_01",
      "hash64": "A97DD108C793D8D8",
      "text": "太好了～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc01_0020_student2_01",
      "hash64": "51D209012B15592F",
      "text": "真的很好玩呢！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc01_0485_caretaker_03",
      "hash64": "3150FFD224DF8CD3",
      "text": "哎呀～太感謝了。\\n真的是辛苦了！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0485_caretaker_04",
      "hash64": "315104D224DF9552",
      "text": "我這裡有定向越野的\\n參加獎要發給大家。[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0485_system_01",
      "hash64": "F3BEBB968EFF4758",
      "text": "[VAR 0x0100(0000)]從管理員那裡\\n得到了[VAR 0xFF00(0008)]北上糬組合[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0485_system_02",
      "hash64": "F3BEBE968EFF4C71",
      "text": "[VAR 0x0100(0000)]把北上糬組合\\n放入了[VAR 0xFF00(0008)]道具[VAR 0xFF00(0000)]口袋。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0485_caretaker_05",
      "hash64": "315105D224DF9705",
      "text": "我原本以為會需要更多的時間才能完成，\\n但大家真是太優秀了！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0485_caretaker_06",
      "hash64": "315102D224DF91EC",
      "text": "距離夏令營結束\\n還有好一段期間。[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0485_caretaker_07",
      "hash64": "315103D224DF939F",
      "text": "學院的大家\\n請自由地在北上冒險。[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0485_caretaker_08",
      "hash64": "315108D224DF9C1E",
      "text": "還有……[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0485_bbteacher_04",
      "hash64": "72488E9413606720",
      "text": "非常抱歉，因為種種因素，\\n我、丹瑜和烏栗，\\r\\n我們幾個來自藍莓學園的人\\r\\n必須早大家一步回去了。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0485_select_01",
      "hash64": "D8F9CE96FF99CA23",
      "text": "真捨不得！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sdc01_0485_select_02",
      "hash64": "D8F9CF96FF99CBD6",
      "text": "為什麼？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc01_0485_bbteacher_05",
      "hash64": "72488F94136068D3",
      "text": "真的很抱歉。\\n跟巨坑相關的事有一些進展，\\r\\n我無論如何都得過去。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0485_bbteacher_06",
      "hash64": "7248909413606A86",
      "text": "雖然我是以領隊的職責陪著大家，\\n但你們實在是非常優秀，\\r\\n相信即使我不在也沒問題的。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0485_bbteacher_07",
      "hash64": "7248919413606C39",
      "text": "不好意思，接下來就要\\n麻煩管理員先生你照顧大家了。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0485_caretaker_09",
      "hash64": "315109D224DF9DD1",
      "text": "放心放心，沒問題的。[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0485_bbteacher_08",
      "hash64": "72489A9413607B84",
      "text": "然後……丹瑜，\\n妳不是有話想說嗎？[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0485_sister_02",
      "hash64": "A3B6622AC7E88306",
      "text": "……是的。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0485_sister_03",
      "hash64": "A3B6632AC7E884B9",
      "text": "我弟弟身體不太舒服，\\n所以由我代表……[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0485_sister_04",
      "hash64": "A3B6642AC7E8866C",
      "text": "嗯～如大家所知，\\n我是在這個村子出生的。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0485_sister_05",
      "hash64": "A3B6652AC7E8881F",
      "text": "你們這些外地人來到村子裡，\\n我原本很反感！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0020_student1_02",
      "hash64": "A97DD408C793DDF1",
      "text": "呃……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "sdc01_0485_sister_06",
      "hash64": "A3B6662AC7E889D2",
      "text": "我總覺得你們會毫無顧忌地\\n闖進對我們而言很重要的地方……[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0485_sister_07",
      "hash64": "A3B6672AC7E88B85",
      "text": "但是和大家相處之後，\\n我發現根本沒有那回事。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0485_sister_08",
      "hash64": "A3B6682AC7E88D38",
      "text": "實際上和大家交流之後，\\n我發現很有趣。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0485_sister_09",
      "hash64": "A3B6692AC7E88EEB",
      "text": "我開始覺得先入為主的想法……\\n真的不太好！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_0485_sister_10",
      "hash64": "A3B9E62AC7EB9929",
      "text": "總之……我過得很開心！\\n謝謝大家來到這裡！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_0485_sister_11",
      "hash64": "A3B9E52AC7EB9776",
      "text": "特別是[VAR 0x0100(0000)]……[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc01_0485_sister_12",
      "hash64": "A3B9E42AC7EB95C3",
      "text": "我很慶幸\\n來到這裡的人是[VAR 0x1100(00FF,0101)]你妳。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc01_0485_sister_13",
      "hash64": "A3B9E32AC7EB9410",
      "text": "不過呢！反正也不是\\n這輩子再也見不到了！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc01_0485_sister_14",
      "hash64": "A3B9EA2AC7EB9FF5",
      "text": "藍莓學園裡\\n有很多強大的訓練家，\\r\\n[VAR 0x1100(00FF,0101)]你妳下次來玩吧！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc01_0485_sister_15",
      "hash64": "A3B9E92AC7EB9E42",
      "text": "啊，對了！\\n我得整理行李才行！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc01_0485_sister_16",
      "hash64": "A3B9E82AC7EB9C8F",
      "text": "那麼，下次再見喔！\\n我才不要說拜拜呢！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc01_0485_caretaker_10",
      "hash64": "315486D224E2A80F",
      "text": "該說真像那孩子的作風，\\n還是怎麼說呢……[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc01_0485_bbteacher_09",
      "hash64": "72489B9413607D37",
      "text": "孩子們的每一個瞬間\\n都如此閃耀無比，\\r\\n對大人來說簡直是太耀眼了呢。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "sdc01_0485_bbteacher_10",
      "hash64": "724C189413638775",
      "text": "那麼，\\n夏令營就到此告一段落！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "sdc01_0485_bbteacher_11",
      "hash64": "724C1794136385C2",
      "text": "我們一起向\\n管理員先生道謝吧！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sdc01_0485_all_01",
      "hash64": "7A0D70B76944E1F4",
