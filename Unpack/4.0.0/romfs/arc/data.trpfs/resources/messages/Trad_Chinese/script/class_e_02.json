          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_e_02_battle_14",
      "hash64": "70CDC958714C9397",
      "text": "而第３種是……\\n讓我來問問各位吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_e_02_battle_15",
      "hash64": "70CDC858714C91E4",
      "text": "能夠回復我方全體體力的聲援\\n叫什麼名字呢！？[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_e_02_select_01",
      "hash64": "01A34312FE4FBD7F",
      "text": "啦啦療癒",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "class_e_02_select_02",
      "hash64": "01A34412FE4FBF32",
      "text": "猛猛澆傷藥",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_e_02_select_03",
      "hash64": "01A34512FE4FC0E5",
      "text": "爆裂回復波",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_e_02_battle_answer_01",
      "hash64": "FCAF0805E9FC6FF6",
      "text": "正確答案！\\n轉學生[VAR 0x1100(00FF,0101)]你妳真是對戰學的大師啊！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_e_02_battle_answer_02",
      "hash64": "FCAF0705E9FC6E43",
      "text": "猛猛澆傷藥……！？\\n這與其說是聲援，不如說是\\r\\n強制性的醫療行為啊……！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_e_02_battle_answer_03",
      "hash64": "FCAF0605E9FC6C90",
      "text": "爆裂回復波……！？\\n相當有焦香味呢。\\r\\n要是真有這樣的招式，我真想用看看！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_e_02_battle_16",
      "hash64": "70CDCB58714C96FD",
      "text": "第３種是[VAR 0xFF00(0006)]啦啦療癒[VAR 0xFF00(0000)]！\\n它能回復體力，\\r\\n還能治癒異常狀態，非常優秀！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_e_02_battle_17",
      "hash64": "70CDCA58714C954A",
      "text": "在１場太晶團體戰中，\\n最多可以進行３次聲援喔！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_e_02_battle_18",
      "hash64": "70CDBD58714C7F33",
      "text": "順帶一提，\\n使用聲援會消耗自己的回合，\\r\\n寶可夢在那一回合無法出招喔！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_e_02_battle_19",
      "hash64": "70CDBC58714C7D80",
      "text": "結論！！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_e_02_battle_20",
      "hash64": "70C3B358714419B0",
      "text": "硬的不行，就來軟的！\\n要是再不行，就用聲援吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_e_02_battle_21",
      "hash64": "70C3B45871441B63",
      "text": "透過支援夥伴，\\n說不定能開闢另一條路喔！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_e_02_battle_22",
      "hash64": "70C3B55871441D16",
      "text": "唔唔！我原本打算讓各位親身體驗的，\\n想不到時間已經到了……[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_e_02_battle_23",
      "hash64": "70C3B65871441EC9",
      "text": "那麼，就此解散！\\n祝各位今天也活力滿分！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    }
  ]
