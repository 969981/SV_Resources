    {
      "ordinal": 0,
      "label": "sdc02_0160_dragonbb_01",
      "hash64": "458C47E1C3BE8503",
      "text": "嘿～未來的冠軍。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
