          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0160_dragonbb_02",
      "hash64": "458C48E1C3BE86B6",
      "text": "抱歉，抱歉，\\n讓[VAR 0x1100(00FF,0101)]你妳等了一下。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0160_dragonbb_03",
      "hash64": "458C49E1C3BE8869",
      "text": "[VAR 0x1100(00FF,0101)]你妳已經打敗\\n第３個四天王啦。\\r\\n[VAR 0x1100(00FF,0101)]你妳已經超越厲害，根本是驚駭啦！[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0160_dragonbb_a_01",
      "hash64": "3515A0ADCF5388A7",
      "text": "赤松的\\n實力也不算弱，\\r\\n他只是想法單純。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0160_dragonbb_a_02",
      "hash64": "3515A1ADCF538A5A",
      "text": "不過，\\n那也是他的優點。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0160_dragonbb_a_03",
      "hash64": "3515A2ADCF538C0D",
      "text": "我好喜歡以前社團活動結束後，\\n大家一起吃赤松做的飯的時間啊～[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0160_dragonbb_a_04",
      "hash64": "35159BADCF538028",
      "text": "原來那傢伙也用自己的方式\\n……煩惱著啊。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0160_dragonbb_b_01",
      "hash64": "E1EBC8B7E02DF950",
      "text": "納莉那傢伙很有趣吧？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0160_dragonbb_b_02",
      "hash64": "E1EBCBB7E02DFE69",
      "text": "那傢伙和丹瑜說話的時候，\\n莫名其妙地還能一搭一唱，\\r\\n這點也很逗趣。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0160_dragonbb_b_03",
      "hash64": "E1EBCAB7E02DFCB6",
      "text": "納莉她啊，\\n既認真又不會變通……\\r\\n但其實比其他人都來得心思細膩。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0160_dragonbb_b_04",
      "hash64": "E1EBCDB7E02E01CF",
      "text": "雖然她容易被人誤會，\\n但[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳要理解她喔。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0160_dragonbb_c_01",
      "hash64": "0D85D4BE413B4085",
      "text": "紫竽她是因為太喜歡可愛的東西，\\n結果寶可夢對戰就變強了。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0160_dragonbb_c_02",
      "hash64": "0D85D1BE413B3B6C",
      "text": "因為喜歡，所以旁人眼中的努力，\\n對她而言都不算是努力。很厲害吧。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0160_dragonbb_c_03",
      "hash64": "0D85D2BE413B3D1F",
      "text": "……不過呢！這一點我猜[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳\\n也不輸給紫竽就是了。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0160_dragonbb_c_04",
      "hash64": "0D85CFBE413B3806",
      "text": "不像某人為了追求強大的實力，\\n犧牲了周圍的人，也犧牲了自己……\\r\\n真希望那個人多學學[VAR 0x1100(00FF,0101)]你妳們啊。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0160_dragonbb_c_05",
      "hash64": "0D85D0BE413B39B9",
      "text": "話說回來，紫竽她只有在叫\\n我的時候口氣特別不客氣。\\r\\n……到底是為什麼？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0160_dragonbb_d_01",
      "hash64": "63EB9CC5DCA4FD8E",
      "text": "對了……拿去吧。\\n這是我們說好的東西。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0160_dragonbb_d_02",
      "hash64": "63EB9BC5DCA4FBDB",
      "text": "別在意上面有灰塵啊。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0160_dragonbb_04",
      "hash64": "458C4AE1C3BE8A1C",
      "text": "要是在眼前見識到\\n像死黨[VAR 0x1100(00FF,0101)]你妳這樣的才能……\\c\\n也難怪烏栗那傢伙\\n會受到影響了。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0160_dragonbb_05",
      "hash64": "458C4BE1C3BE8BCF",
      "text": "……那麼。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0160_dragonbb_lasta",
      "hash64": "08FA6799065307D3",
      "text": "最後的末天王，\\n……是赤松啊。\\c\\n那傢伙熱情得讓人難受，\\n[VAR 0x1100(00FF,0101)]你妳用冰涼的水幫他降降溫吧。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0160_dragonbb_lastb",
      "hash64": "08FA689906530986",
      "text": "最後的末天王，\\n……是納莉啊。\\c\\n那傢伙冰冰冷冷的，\\n[VAR 0x1100(00FF,0101)]你妳用炙熱的火焰烤烤她吧。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0160_dragonbb_lastac",
      "hash64": "9485B905BF161010",
      "text": "最後的末天王，\\n……是紫竽啊。\\c\\n那傢伙有那～麼一點棘手，\\n但死黨[VAR 0x1100(00FF,0101)]你妳應該沒問題的。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0160_dragonbb_lastd",
      "hash64": "08FA6A9906530CEC",
      "text": "最後的末天王，\\n……是我啊。\\c\\n幸好[VAR 0x1100(00FF,0101)]你妳讓我排在最後一個，\\n我做好充～足的準備囉。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0160_dragonbb_06",
      "hash64": "458C4CE1C3BE8D82",
      "text": "那好，\\n[VAR 0x1100(00FF,0101)]你妳好好加油啊～[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
