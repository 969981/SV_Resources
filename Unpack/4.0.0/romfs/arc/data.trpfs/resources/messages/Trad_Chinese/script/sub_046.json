      "hash64": "AF56210A305FD036",
      "text": "能讓我看看[VAR 0x1100(00FF,0101)]你妳和\\n寶可夢有多友好嗎？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
