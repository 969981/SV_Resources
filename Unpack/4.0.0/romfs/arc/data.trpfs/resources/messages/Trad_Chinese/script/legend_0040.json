    {
      "ordinal": 35,
      "label": "legend_0040_friend_13",
      "hash64": "87B10C88B93D5A0B",
      "text": "真是的。\\n你好歹認真地品嚐一下味道吧。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
