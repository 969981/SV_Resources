      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "legend_0040_friend_14",
      "hash64": "87B11188B93D628A",
      "text": "這傢伙也變得更有活力了呢。\\n往奇怪的方向就是了……[VAR 0x0114(0006)]",
