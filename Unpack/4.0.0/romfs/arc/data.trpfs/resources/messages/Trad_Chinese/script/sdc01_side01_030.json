    {
      "ordinal": 0,
      "label": "sdc01_side01_030_brother_01",
      "hash64": "2C5EE0F8ACDFF912",
      "text": "這裡是樂土荒地，\\n很荒涼唄。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
