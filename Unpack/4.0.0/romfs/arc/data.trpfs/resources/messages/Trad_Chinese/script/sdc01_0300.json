      "hash64": "0E4A10C22ADDB529",
      "text": "[VAR 0x0100(0000)]，[VAR 0x1100(00FF,0101)]你妳來了！\\n[VAR 0x1100(00FF,0101)]你妳瞧！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
