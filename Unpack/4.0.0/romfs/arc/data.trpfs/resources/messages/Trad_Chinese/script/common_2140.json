          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2140_top_02",
      "hash64": "9A17D86E1A2F5757",
      "text": "我就知道\\n能夠在決賽與[VAR 0x1100(00FF,0101)]你妳相會。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2140_top_03",
      "hash64": "9A17D76E1A2F55A4",
      "text": "鑽研至極的力量與力量……[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2140_top_04",
      "hash64": "9A17D66E1A2F53F1",
      "text": "兩相碰撞時，\\n將使人們為之狂熱著迷……[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2140_top_05",
      "hash64": "9A17D56E1A2F523E",
      "text": "這個狀況非常接近\\n我想像的理想世界。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2140_top_06",
      "hash64": "9A17D46E1A2F508B",
      "text": "不論是身為寶可夢聯盟的會長，\\n或是學院的理事長……[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2140_top_07",
      "hash64": "9A17D36E1A2F4ED8",
      "text": "我都非常滿意。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2140_top_08",
      "hash64": "9A17D26E1A2F4D25",
      "text": "若是我們能在此相互提升，\\n就能激發出更大的加乘效果。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2140_top_09",
      "hash64": "9A17D16E1A2F4B72",
      "text": "來吧，冠軍[VAR 0x0100(0000)]！\\n為了引領人們邁向更高的境界！[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2140_top_10",
      "hash64": "9A14D46E1A2D1AB4",
      "text": "我首席冠軍\\n將不惜展現力量！[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2140_announce_04",
      "hash64": "8D4FA68FFBF47AD7",
      "text": "想、想不到\\n校園最強大賽的優勝者……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "common_2140_announce_05",
      "hash64": "8D4FA58FFBF47924",
      "text": "也就是校園最強的\\n寶可夢訓練家……\\r\\n是冠軍[VAR 0x0100(0000)]～！！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
