  "entries": [
    {
      "ordinal": 0,
      "label": "s1_other_area_plaza_01_01",
      "hash64": "6AB0144E789321D1",
      "text": "這裡是寶伴廣場。\\c\\n原本被叫做寶伴公園，\\n但不知何時名字就變了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_other_area_plaza_03_01",
      "hash64": "6774003CCC4EB6F3",
      "text": "在那裡面的是寶伴像！\\c\\n寶伴是很久很久以前\\n守護了村子的英雄呢！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_other_area_plaza_03_02",
      "hash64": "6774013CCC4EB8A6",
      "text": "喂！寶伴像怎麼壞了！\\n丹瑜她終於闖下大禍了嗎！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_other_area_plaza_03_03",
      "hash64": "6774023CCC4EBA59",
      "text": "就算寶伴牠們是壞蛋，\\n我對寶伴像還是有種說不上的喜歡。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_other_area_plaza_03_04",
      "hash64": "6774033CCC4EBC0C",
      "text": "謝謝[VAR 0x1100(00FF,0101)]你妳幫忙修寶伴像！\\n我也有捐了一點錢喔。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    }
  ]
}
