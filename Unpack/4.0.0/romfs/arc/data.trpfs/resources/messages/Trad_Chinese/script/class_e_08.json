      "ordinal": 22,
      "label": "class_e_08_battle_04",
      "hash64": "07ED891083233064",
      "text": "漂亮的戰鬥！\\n我相信各位一定都是１００分！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
