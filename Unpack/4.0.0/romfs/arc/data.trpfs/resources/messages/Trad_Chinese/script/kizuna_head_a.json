      "hash64": "9F3E5E33C6DE4976",
      "text": "哎呀？\\n[VAR 0x0100(0000)]同學。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
