      ]
    },
    {
      "ordinal": 1,
      "label": "common_0095_mama_02",
      "hash64": "E4F2D7E37D111AE3",
      "text": "聽說[VAR 0x1100(00FF,0101)]你妳要和妮莫一起去上學？[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
