      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "a_sch_shop01_ni07",
      "hash64": "686AAA35F8946D9A",
      "text": "這裡的麵包很鬆軟！\\n就算牙齒不好也能放心地吃。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
