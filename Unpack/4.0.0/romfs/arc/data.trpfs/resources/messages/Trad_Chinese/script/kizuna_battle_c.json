    {
      "ordinal": 0,
      "label": "kizuna_battle_c_health_01",
      "hash64": "1441AD1DBE335EE1",
      "text": "不要不要，我絕對不要～！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
