      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0010_select_01",
      "hash64": "D39DDF856D1796FE",
      "text": "[VAR 0x0100(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
