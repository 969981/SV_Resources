    },
    {
      "ordinal": 1,
      "label": "sdc02_0010_headbb_02",
      "hash64": "1F17C93F0FC03A6D",
      "text": "我好像在哪裡看過～\\n嗯～到底是誰來著？[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
