    },
    {
      "ordinal": 3,
      "label": "sdc01_3gods_B_sister_04",
      "hash64": "A80E3AC9A88E4AAA",
      "text": "真是的，有完沒完啊！\\n怎麼天上飛的地上跑的，個個都變大了！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
