    },
    {
      "ordinal": 46,
      "label": "common_0090_rival_22",
      "hash64": "DE94AC74D9A53F50",
      "text": "在去學校之前，我先教[VAR 0x1100(00FF,0101)]你妳吧！\\n跟我來～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
