      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "team_0115_nelke_02a",
      "hash64": "774DCF241C0592DE",
      "text": "哎呀，\\n我現在是聶凱。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
