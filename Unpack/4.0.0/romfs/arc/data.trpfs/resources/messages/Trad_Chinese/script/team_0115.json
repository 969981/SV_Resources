      "ordinal": 24,
      "label": "team_0115_nelke_16",
      "hash64": "4DA892DB987A945A",
      "text": "[VAR 0x0100(0000)]同學。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
