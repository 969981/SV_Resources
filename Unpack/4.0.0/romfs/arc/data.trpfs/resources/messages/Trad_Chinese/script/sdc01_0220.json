      "hash64": "B91453C0B7BAD36A",
      "text": "[VAR 0x0100(0000)]！早啊～[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
