    {
      "ordinal": 8,
      "label": "common_0990_friend_06",
      "hash64": "9C4F58DF0F4F956B",
      "text": "我找到兩個願意一起去\\n第零區的夥伴了！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
