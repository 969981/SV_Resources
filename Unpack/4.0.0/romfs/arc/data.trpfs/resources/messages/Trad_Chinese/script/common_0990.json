      ]
    },
    {
      "ordinal": 10,
      "label": "common_0990_friend_08",
      "hash64": "9C4F56DF0F4F9205",
      "text": "我們可以４個人\\n一起往第零區出發啦～！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
