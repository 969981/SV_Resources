    {
      "ordinal": 11,
      "label": "common_0990_friend_09",
      "hash64": "9C4F55DF0F4F9052",
      "text": "總之，我們先集合吧！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
