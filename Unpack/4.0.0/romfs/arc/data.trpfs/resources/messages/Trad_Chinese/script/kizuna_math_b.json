    },
    {
      "ordinal": 2,
      "label": "kizuna_math_b_03",
      "hash64": "A86EBA93E1A4C8D7",
      "text": "……如果我要問的問題很奇怪，\\n還請[VAR 0x1100(00FF,0101)]你妳見諒喔。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
