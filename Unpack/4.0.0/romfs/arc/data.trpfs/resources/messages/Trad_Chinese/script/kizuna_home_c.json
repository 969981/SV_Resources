      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_home_c_02",
      "hash64": "9C0F8C4400C153DA",
      "text": "……我有件事情務必想請[VAR 0x1100(00FF,0101)]你妳幫忙。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
