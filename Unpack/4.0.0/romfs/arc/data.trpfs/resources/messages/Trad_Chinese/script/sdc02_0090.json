    {
      "ordinal": 0,
      "label": "sdc02_0090_sister_01",
      "hash64": "81BECB092710817A",
      "text": "哦～？\\n看來這裡就是[VAR 0x1100(00FF,0101)]你妳的房間了。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
