            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_025_system_01",
      "hash64": "284BBDA29079A845",
      "text": "[VAR 0x0100(0000)]\\n獲得了[VAR 0xFF00(0008)]運動帽（星星）[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
