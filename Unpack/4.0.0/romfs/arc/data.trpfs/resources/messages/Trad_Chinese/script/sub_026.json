      ]
    },
    {
      "ordinal": 4,
      "label": "sub_025_sitappa_a_04",
      "hash64": "374EC1ECC983A543",
      "text": "不論[VAR 0x1100(00FF,0101)]你妳是想一直待在這裡，\\n還是想回去都隨便[VAR 0x1100(00FF,0101)]你妳。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
