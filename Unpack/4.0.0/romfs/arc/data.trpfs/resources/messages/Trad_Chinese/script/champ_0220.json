    {
      "ordinal": 0,
      "label": "champ_0220_stopper_01",
      "hash64": "A70D68ECF0A6BE31",
      "text": "不能回頭了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "champ_0220_stopper_02",
      "hash64": "A70D65ECF0A6B918",
      "text": "不打贏對戰就無法前進！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
