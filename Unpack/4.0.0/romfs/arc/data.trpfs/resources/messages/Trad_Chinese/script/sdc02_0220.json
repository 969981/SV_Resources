      "label": "sdc02_0220_brother_01",
      "hash64": "6A683D528A4BB7FB",
      "text": "……不會輸。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
