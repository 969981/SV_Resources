      "text": "聯盟社冠軍烏栗同學，\\n四天王首席杜若同學。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
