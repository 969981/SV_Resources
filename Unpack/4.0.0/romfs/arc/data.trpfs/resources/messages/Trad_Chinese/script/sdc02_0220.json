    },
    {
      "ordinal": 33,
      "label": "sdc02_0220_announcement_04",
      "hash64": "D2468E1286E8B001",
      "text": "白蕾雅老師與客人\\n有事找你們。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
