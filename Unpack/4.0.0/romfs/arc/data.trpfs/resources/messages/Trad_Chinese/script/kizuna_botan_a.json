          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_botan_a_02",
      "hash64": "3628B8A5496FE57F",
      "text": "噓！\\n快躲起來！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_botan_a_03",
      "hash64": "3628B7A5496FE3CC",
      "text": "呼～好險……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_botan_a_select_01",
      "hash64": "20DD942EF5E4E181",
      "text": "妳在做什麼？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_botan_a_select_02",
      "hash64": "20DD912EF5E4DC68",
      "text": "怎麼了嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_botan_a_04",
      "hash64": "3628B6A5496FE219",
      "text": "呃……\\n這個……那個……\\r\\n看來只有老實說了……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_botan_a_05",
      "hash64": "3628B5A5496FE066",
      "text": "[VAR 0x1100(00FF,0101)]你妳看那裡。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_botan_a_06",
      "hash64": "3628B4A5496FDEB3",
      "text": "就是那麼一回事……喔？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_botan_a_select_03",
      "hash64": "20DD922EF5E4DE1B",
      "text": "那麼一回事？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_botan_a_select_04",
      "hash64": "20DD972EF5E4E69A",
      "text": "能說明一下嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_botan_a_07",
      "hash64": "3628B3A5496FDD00",
      "text": "啊，抱歉。\\n剛剛人家嚇了一跳，還有點慌張。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_botan_a_08",
      "hash64": "3628C2A5496FF67D",
      "text": "最、最近，\\n天星隊的大家開始來上學了……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_botan_a_09",
      "hash64": "3628C1A5496FF4CA",
      "text": "但人家擔心他們能不能適應學校，\\n所以一直觀察著他們……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_botan_a_aku_01",
      "hash64": "65304FA143DF53AA",
      "text": "……我們果然還是\\n和這裡格格不入嗎？[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_botan_a_fairy_01",
      "hash64": "1D3B2C79154455C0",
      "text": "那是當然的啊。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_botan_a_fairy_02",
      "hash64": "1D3B2F7915445AD9",
      "text": "就算我們解開了\\n和老師們之間的誤會……[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_botan_a_fairy_03",
      "hash64": "1D3B2E7915445926",
      "text": "大家也不可能就乖乖地\\n展開雙手歡迎我們啊。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_botan_a_aku_02",
      "hash64": "65304EA143DF51F7",
      "text": "我想也是。\\n看來，我們大概……\\r\\n還是只有改變路線了。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_botan_a_10",
      "hash64": "3625B4A5496DA8DC",
      "text": "改變……路線……？\\n大家的制服都改造了，\\r\\n要穿回普通的衣服嗎……？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_botan_a_11",
      "hash64": "3625B5A5496DAA8F",
      "text": "阿皮……奧爾……\\n他們都在努力地想融入學校……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_botan_a_fairy_04",
      "hash64": "1D3B317915445E3F",
      "text": "你說要改變路線，那要怎麼做？[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_botan_a_aku_03",
      "hash64": "65304DA143DF5044",
      "text": "欸？這個嘛……[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_botan_a_aku_04",
      "hash64": "65304CA143DF4E91",
      "text": "大聲地向大家打招呼？之類的？[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_botan_a_fairy_05",
      "hash64": "1D3B307915445C8C",
      "text": "啥！？那也太蠢了！\\n我絕對不要！[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_botan_a_12",
      "hash64": "3625B6A5496DAC42",
      "text": "……嗯？\\n重點好像不太對？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_botan_a_aku_05",
      "hash64": "65304BA143DF4CDE",
      "text": "不，奧爾迪加，你聽好了。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_botan_a_aku_06",
      "hash64": "65304AA143DF4B2B",
      "text": "實際上萊姆的現場表演也是這樣。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_botan_a_aku_07",
      "hash64": "653049A143DF4978",
      "text": "如果會場的氣氛一點都不嗨，\\n萊姆首先會放聲大吼……\\r\\n先向大家問好來暖暖場子。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_botan_a_fairy_06",
      "hash64": "1D3B3379154461A5",
      "text": "因為那是現場表演啊。\\n這裡可是學校耶。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_botan_a_aku_08",
      "hash64": "653048A143DF47C5",
      "text": "那奧爾迪加你打算就這樣什麼都不做，\\n繼續和學校格格不入嗎？[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_botan_a_fairy_07",
      "hash64": "1D3B327915445FF2",
      "text": "我、我才不想呢……[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_botan_a_aku_09",
      "hash64": "653047A143DF4612",
      "text": "是吧？那樣的話，\\n不覺得只剩大聲問好這個方法了嗎？\\r\\n好，我們來吧……[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_botan_a_aku_10",
      "hash64": "652CCAA143DC3BD4",
      "text": "大～家～！！\\n早～安～！！[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "kizuna_botan_a_fairy_08",
      "hash64": "1D3B35791544650B",
      "text": "喂！皮拿！\\n這也太丟臉了！[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "kizuna_botan_a_aku_11",
      "hash64": "652CCBA143DC3D87",
      "text": "大家好～！！\\n來，奧爾迪加也一起問好！[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_botan_a_fairy_09",
      "hash64": "1D3B347915446358",
      "text": "我說你！\\n你該不會只是想做發聲練習吧！？[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
