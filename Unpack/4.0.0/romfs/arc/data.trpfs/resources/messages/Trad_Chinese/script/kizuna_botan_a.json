      "hash64": "3628B9A5496FE732",
      "text": "哇！哇！[VAR 0x0100(0000)]！？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
