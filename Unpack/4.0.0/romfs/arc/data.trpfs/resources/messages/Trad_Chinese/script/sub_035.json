          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_035_mgirl_05",
      "hash64": "4A602A61B3DEEF9E",
      "text": "牠一定是全世界最大隻的\\n[VAR 0x0101(0001)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sub_035_mgirl_06",
      "hash64": "4A602961B3DEEDEB",
      "text": "哎呀！牠很大隻呢！\\n讓人可以放心地整個靠上去，\\r\\n安心感超群！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_035_mgirl_07",
      "hash64": "4A602861B3DEEC38",
      "text": "呵呵！看來牠比一般的孩子\\n還來得大隻很多呢！\\r\\n[VAR 0x1100(00FF,0101)]你妳要好好珍惜牠這個特色喔！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
