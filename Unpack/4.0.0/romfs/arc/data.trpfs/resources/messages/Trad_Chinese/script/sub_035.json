    {
      "ordinal": 9,
      "label": "sub_035_mgirl_10",
      "hash64": "4A5CA961B3DBDE94",
      "text": "牠似乎比一般的孩子\\n還稍微來得小隻一點！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
