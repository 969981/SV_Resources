    {
      "ordinal": 1,
      "label": "sub_035_mgirl_02",
      "hash64": "4A602D61B3DEF4B7",
      "text": "[VAR 0x1100(00FF,0101)]你妳想知道哪一隻\\n寶可夢的尺寸呢？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
