    {
      "ordinal": 2,
      "label": "sub_035_mgirl_03",
      "hash64": "4A602C61B3DEF304",
      "text": "嗯，我看看喔。\\n[VAR 0x1100(00FF,0101)]你妳的[VAR 0x0102(0001)]……",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
