        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_035_mgirl_08",
      "hash64": "4A602761B3DEEA85",
      "text": "牠似乎比一般的孩子\\n還稍微來得大隻一點！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_035_mgirl_09",
      "hash64": "4A602661B3DEE8D2",
      "text": "標準中的標準！\\n牠屬於平均的尺寸，\\r\\n充滿著正統王道的魅力呢。",
      "flags": 0,
      "text_status": "DECODED",
