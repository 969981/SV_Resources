      ]
    },
    {
      "ordinal": 3,
      "label": "sub_035_mgirl_04",
      "hash64": "4A602B61B3DEF151",
      "text": "真是隻BIG寶可夢！！！！\\c\\n實在是很少有機會能看到\\n這麼大隻的寶可夢呢！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
