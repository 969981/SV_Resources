  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_014_system_kui_01",
      "hash64": "1A7B3A8AE0ECFF5D",
      "text": "這裡埋著漆黑且\\n散發不祥氣息的樁柱……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_014_system_kui_02",
      "hash64": "1A7B378AE0ECFA44",
      "text": "要拔出樁柱嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_014_system_kui_03",
      "hash64": "1A7B388AE0ECFBF7",
      "text": "拔出樁柱後，\\n樁柱開始崩裂然後消失了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_014_system_kui_04",
      "hash64": "1A7B358AE0ECF6DE",
      "text": "叮……咕……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_014_system_kui_05",
      "hash64": "1A7B368AE0ECF891",
      "text": "從祠堂的方向\\n傳來了謎樣的聲音……！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_014_system_release_01",
      "hash64": "A5872331365DB1CF",
      "text": "從祠堂裡傳出了\\n微弱的聲響……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_014_system_release_02",
      "hash64": "A5872431365DB382",
      "text": "要觸摸祠堂嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_014_system_release_03",
      "hash64": "A5872531365DB535",
      "text": "喀噠喀噠喀噠喀噠……\\n嘎噠嘎噠……嘎噠嘎噠！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_014_system_release_07",
      "hash64": "A5872131365DAE69",
      "text": "嘎噠～！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_014_system_release_04",
      "hash64": "A5871E31365DA950",
      "text": "叮叮咕～！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_014_system_release_05",
      "hash64": "A5871F31365DAB03",
      "text": "古鼎鹿\\n再次被封印到祠堂中了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_014_system_release_06",
      "hash64": "A5872031365DACB6",
      "text": "祠堂的門看來\\n暫時不會打開了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_014_system_hokora_01",
      "hash64": "FB3D6C305BC176A6",
      "text": "祠堂上刻著模糊的文字……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_014_system_hokora_02",
      "hash64": "FB3D6B305BC174F3",
      "text": "災禍之鼎封印於此",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_014_system_hokora_03",
      "hash64": "FB3D6A305BC17340",
      "text": "災禍之鼎封印已解",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
