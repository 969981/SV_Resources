    {
      "ordinal": 2,
      "label": "s2_side01_0060_brother_03",
      "hash64": "576D623E3D360D97",
      "text": "抱歉，我家裡有點忙，\\n所以沒能去接你們……[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
