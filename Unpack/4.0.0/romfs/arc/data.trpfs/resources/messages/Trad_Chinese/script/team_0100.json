      "hash64": "F15CEAAEA19EC994",
      "text": "洛托洛托洛托……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "team_0100_cassiopeia_01",
      "hash64": "BB40B1EA9F220216",
      "text": "……[VAR 0x1100(00FF,0101)]你妳距離\\n第５個基地很近了呢。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
