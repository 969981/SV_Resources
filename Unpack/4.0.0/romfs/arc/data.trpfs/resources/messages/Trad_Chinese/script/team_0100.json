            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "team_0100_cassiopeia_02",
      "hash64": "BB40B0EA9F220063",
      "text": "最後的小隊\\n就在那個地方。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "team_0100_cassiopeia_03",
      "hash64": "BB40AFEA9F21FEB0",
      "text": "一路戰鬥過來，辛苦[VAR 0x1100(00FF,0101)]你妳了。\\n謝謝[VAR 0x1100(00FF,0101)]你妳，[VAR 0x0100(0000)]。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
