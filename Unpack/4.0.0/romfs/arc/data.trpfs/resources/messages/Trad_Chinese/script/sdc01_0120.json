    {
      "ordinal": 1,
      "label": "sdc01_0120_brother_01",
      "hash64": "BCDEADB2405C57A1",
      "text": "姐～\\n[VAR 0x0100(0000)]來了。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
