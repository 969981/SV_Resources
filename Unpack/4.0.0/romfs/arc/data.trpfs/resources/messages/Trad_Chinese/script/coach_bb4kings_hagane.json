    },
    {
      "ordinal": 4,
      "label": "coach_bb4kings_hagane_sp01_02",
      "hash64": "C99A4D82D0941001",
      "text": "啊嘎嘶在那之後都還好嗎？[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
