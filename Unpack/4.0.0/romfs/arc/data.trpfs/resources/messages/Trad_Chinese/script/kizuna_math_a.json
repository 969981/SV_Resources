    },
    {
      "ordinal": 14,
      "label": "kizuna_math_a_mob_02",
      "hash64": "74F36AAA300E38D8",
      "text": "泰姆老師，\\n妳以前真的是道館館主嗎～！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_a_10",
      "hash64": "FA797778265211F4",
      "text": "那是真的喔～\\n老師我，可是很強的呢！[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
