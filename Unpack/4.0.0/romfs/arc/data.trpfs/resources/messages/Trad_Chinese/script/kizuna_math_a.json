    },
    {
      "ordinal": 16,
      "label": "kizuna_math_a_mob_03",
      "hash64": "74F36BAA300E3A8B",
      "text": "好厲害～！\\n老師為什麼不當館主了呢～？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
