      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_a_09",
      "hash64": "FA7C7478265442B2",
      "text": "哎呀，真是有活力的聲音。\\n我們照順序一個一個來說話喔。\\r\\n畢竟泰姆老師我只有一個人。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
