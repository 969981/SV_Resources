      "hash64": "FA797878265213A7",
      "text": "這個嘛，我想我只會跟\\n能遵守順序的好孩子說。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
