        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_honoo_010_sitappa_04",
      "hash64": "0EBFF1CAF3C6A124",
      "text": "好！看我採取正當防衛\\n把[VAR 0x1100(00FF,0101)]你妳打到落花流水！[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
