  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_015_system_kui_01",
      "hash64": "CBD71E33F4417D1E",
      "text": "這裡埋著漆黑且\\n散發不祥氣息的樁柱……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_015_system_kui_02",
      "hash64": "CBD71D33F4417B6B",
      "text": "要拔出樁柱嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_015_system_kui_03",
      "hash64": "CBD71C33F44179B8",
      "text": "拔出樁柱後，\\n樁柱開始崩裂然後消失了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_015_system_kui_04",
      "hash64": "CBD72333F441859D",
      "text": "咆……咕……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_015_system_kui_05",
      "hash64": "CBD72233F44183EA",
      "text": "從祠堂的方向\\n傳來了謎樣的聲音……！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_015_system_release_01",
      "hash64": "2F7176EB24844F78",
      "text": "從祠堂裡傳出了\\n微弱的聲響……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_015_system_release_02",
      "hash64": "2F7179EB24845491",
      "text": "要觸摸祠堂嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_015_system_release_03",
      "hash64": "2F7178EB248452DE",
      "text": "喀噠喀噠喀噠喀噠……\\n嘎噠嘎噠……嘎噠嘎噠！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_015_system_release_07",
      "hash64": "2F717CEB248459AA",
      "text": "嘎噠～！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_015_system_release_04",
      "hash64": "2F717BEB248457F7",
      "text": "咆咕！！咆咕！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_015_system_release_05",
      "hash64": "2F717AEB24845644",
      "text": "古劍豹\\n再次被封印到祠堂中了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_015_system_release_06",
      "hash64": "2F717DEB24845B5D",
      "text": "祠堂的門看來\\n暫時不會打開了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_015_system_hokora_01",
      "hash64": "375C3504754E3827",
      "text": "祠堂上刻著模糊的文字……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_015_system_hokora_02",
      "hash64": "375C3604754E39DA",
      "text": "災禍之劍封印於此",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_015_system_hokora_03",
      "hash64": "375C3704754E3B8D",
      "text": "災禍之劍封印已解",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
