    },
    {
      "ordinal": 45,
      "label": "dome_center_square_npc_57_01",
      "hash64": "3E10A6B2C3624931",
      "text": "聯盟社的孩子們之間\\n人際關係不太好？\\r\\n身為老師，我不能置之不理。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
