    },
    {
      "ordinal": 46,
      "label": "dome_center_square_npc_57_02",
      "hash64": "3E10A3B2C3624418",
      "text": "聯盟社的孩子們\\n似乎穩定下來了。\\r\\n身為老師，我什麼都沒幫到。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
