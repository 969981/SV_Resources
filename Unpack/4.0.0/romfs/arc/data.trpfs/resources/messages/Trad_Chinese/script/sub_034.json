          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sub_034_ecology_09",
      "hash64": "AE5332C3090DED20",
      "text": "說不定接下來也會繼續確認到\\n黑色結晶的太晶團體戰～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
