          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_1000_friend_04",
      "hash64": "ADA757E7112C25AA",
      "text": "我找來的那兩個人\\n應該已經在零區閘口等著了。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
