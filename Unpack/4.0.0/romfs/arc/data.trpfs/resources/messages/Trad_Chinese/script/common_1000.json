          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_1000_friend_08",
      "hash64": "ADA74BE7112C1146",
      "text": "這次可以回到故鄉，\\n說不定牠會很高興。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
