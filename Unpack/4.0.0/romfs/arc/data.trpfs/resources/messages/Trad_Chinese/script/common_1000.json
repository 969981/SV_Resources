        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_1000_friend_07",
      "hash64": "ADA756E7112C23F7",
      "text": "[VAR 0x0101(0001)]牠的出生地？\\n據說就是第零區呢。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
