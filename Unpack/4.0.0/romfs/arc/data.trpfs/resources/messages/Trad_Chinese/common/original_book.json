            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "original_book_title_12_01_A",
      "hash64": "F43324FD792A21BB",
      "text": "幻之寶可夢的想像圖",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "original_book_honbun_12_01_A",
      "hash64": "36C0F6E8CB473B81",
      "text": "觀測隊負責素描的隊員\\n所畫下的幻之寶可夢。\\n棲息在第零區中層以下的\\n神秘寶可夢個個巨大無比，\\n且性情極為凶暴。\\n據說該隊員是以這些特徵為底，\\n一邊想像著第零區裡如果真有\\n幻之寶可夢，牠會長成什麼樣子，\\n然後一邊畫下這張圖的。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "original_book_title_12_01_B",
      "hash64": "F43325FD792A236E",
      "text": "幻之寶可夢的想像圖",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "original_book_honbun_12_01_B",
      "hash64": "36C0F3E8CB473668",
      "text": "觀測隊負責素描的隊員\\n所畫下的幻之寶可夢。\\n棲息在第零區中層以下的\\n神秘寶可夢個個體型嬌小，\\n且性情極為殘忍。\\n據說該隊員是以這些特徵為底，\\n一邊想像著第零區裡如果真有\\n幻之寶可夢，牠會長成什麼樣子，\\n然後一邊畫下這張圖的。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "original_book_title_13_01",
      "hash64": "43F02FC8DCEEC2E2",
      "text": "謎樣的記憶",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
