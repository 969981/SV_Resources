          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0070_rival_02",
      "hash64": "FA14B18685E997C8",
      "text": "果然沒錯！\\n[VAR 0x1100(00FF,0101)]你妳是住在對面那棟房子的鄰居！[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0070_rival_03",
      "hash64": "FA14B28685E9997B",
      "text": "我一直超級好奇\\n新搬來的是什麼樣的人。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0070_rival_04",
      "hash64": "FA14B78685E9A1FA",
      "text": "我叫妮莫！\\n平常是住在學校的宿舍。\\r\\n不過既然我們是鄰居，就交個朋友吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
