    {
      "ordinal": 9,
      "label": "common_0070_rival_05a",
      "hash64": "DAD958958C0153A4",
      "text": "真是個發自肚子的好回答！\\n以後就請多多指教囉～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
