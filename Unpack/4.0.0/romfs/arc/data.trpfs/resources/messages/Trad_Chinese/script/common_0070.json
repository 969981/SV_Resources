    {
      "ordinal": 2,
      "label": "common_0070_rival_01",
      "hash64": "FA14B48685E99CE1",
      "text": "校長！該不會……[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
