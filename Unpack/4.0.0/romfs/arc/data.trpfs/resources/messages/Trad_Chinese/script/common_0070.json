        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0070_rival_05b",
      "hash64": "DAD95B958C0158BD",
      "text": "咦？[VAR 0x1100(00FF,0101)]你妳很緊張嗎？\\n是不是我聲音太大了？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
