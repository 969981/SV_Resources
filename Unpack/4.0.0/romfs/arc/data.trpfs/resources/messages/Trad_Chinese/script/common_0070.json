        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0070_head_teacher_02",
      "hash64": "FC1843C97563E2B3",
      "text": "這位是今天轉學到我們學院的\\n[VAR 0x0100(0000)]同學。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
