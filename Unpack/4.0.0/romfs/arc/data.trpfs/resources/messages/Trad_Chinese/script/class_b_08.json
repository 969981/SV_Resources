      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_b_08_question_04",
      "hash64": "B20776FF66E792E9",
      "text": "４　如果使用２次劍舞，\\n　　攻擊就會提高４個等級。\\n　　這時候招式的傷害會變成幾倍呢？\\n\\n・２倍　・３倍　・４倍",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_b_08_ansewer_04a",
      "hash64": "ED6DD0B72B01577F",
