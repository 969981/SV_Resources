      ]
    },
    {
      "ordinal": 2,
      "label": "class_b_08_question_01",
      "hash64": "B20779FF66E79802",
      "text": "１　在店裡付３０００，\\n　　全額用來買１個６００的超級球，\\n　　最多可以帶回多少個球呢？\\n\\n・５個　・６個　・７個",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "class_b_08_ansewer_01a",
      "hash64": "ED63DCB72AF9175E",
