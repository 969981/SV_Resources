      ]
    },
    {
      "ordinal": 1,
      "label": "coach_teacher_battle_first_01",
      "hash64": "DD62798DBA6EF8DC",
      "text": "我是熱血沸騰的凰檗！\\n我們來一同燃燒鬥志吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
