    },
    {
      "ordinal": 7,
      "label": "a_sch_class1d_ni01",
      "hash64": "5501833A02E03C8A",
      "text": "兩手都有喵喵！\\n被喜歡的寶可夢給環繞，\\r\\n真是太、幸、福、了……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
