    },
    {
      "ordinal": 1,
      "label": "a_sch_class1d_eve02",
      "hash64": "E309CDAF3BF5CC38",
      "text": "小貓怪進化以後\\n會變得超帥氣的喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
