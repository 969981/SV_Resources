    },
    {
      "ordinal": 1,
      "label": "champ_0125_rival_02",
      "hash64": "92913AE50E940043",
      "text": "能夠把徽章收集到這個程度的挑戰者，\\n是整體的一成都不到喔！！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
