        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0125_select_01",
      "hash64": "E5768FCFB995BFAA",
      "text": "謝謝！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "champ_0125_select_02",
      "hash64": "E5768ECFB995BDF7",
      "text": "是嗎……？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "champ_0125_rival_05",
      "hash64": "92913FE50E9408C2",
      "text": "別這樣！\\n該說謝謝的人是我！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
