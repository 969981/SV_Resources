          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0125_rival_06",
      "hash64": "92913EE50E94070F",
      "text": "是啊～！我們第一次對戰的時候，\\n我就知道[VAR 0x1100(00FF,0101)]你妳肯～定會變強了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
