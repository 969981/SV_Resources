          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0125_rival_03",
      "hash64": "929139E50E93FE90",
      "text": "真不愧是我看上的\\n寶可夢訓練家！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
