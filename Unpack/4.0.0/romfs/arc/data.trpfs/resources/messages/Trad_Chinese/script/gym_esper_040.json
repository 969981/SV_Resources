          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_esper_040_receptionist_01",
      "hash64": "1F919732251A207B",
      "text": "[VAR 0x1100(00FF,0101)]你妳要挑戰超能魔法幻妝師……\\n道館館主莉普嗎？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_esper_040_receptionist_02",
      "hash64": "1F919832251A222E",
      "text": "那麼，請讓我帶[VAR 0x1100(00FF,0101)]你妳前往對戰場。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_esper_040_receptionist_03",
      "hash64": "1F919932251A23E1",
      "text": "等[VAR 0x1100(00FF,0101)]你妳準備好後，\\n請隨時告訴我一聲。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_esper_040_esper_entry_01",
      "hash64": "EA01E71F5103C776",
      "text": "這樣嗎……我知道了。\\n由我這邊進行吧。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_esper_040_esper_entry_02",
      "hash64": "EA01E61F5103C5C3",
      "text": "廣告詞就用易懂的\\n「自然，帶來美麗」。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_esper_040_esper_entry_03",
      "hash64": "EA01E51F5103C410",
      "text": "新顏色的眼影\\n也拜託你下單嘍。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_esper_040_esper_entry_04",
      "hash64": "EA01EC1F5103CFF5",
      "text": "……哪裡，謝謝你喔。\\n那麼，再聯絡～[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_esper_040_esper_01",
      "hash64": "A1A3806506F21EE3",
      "text": "[VAR 0x1100(00FF,0101)]你妳好啊～[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_esper_040_esper_02",
      "hash64": "A1A3816506F22096",
      "text": "我是道館館主莉普。\\c\\n但其實彩妝藝術家\\n才是我的本行。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_esper_040_esper_03",
      "hash64": "A1A3826506F22249",
      "text": "凰檗她有誇獎[VAR 0x1100(00FF,0101)]你妳喲。\\n她說[VAR 0x1100(00FF,0101)]你妳很霹靂呢。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_esper_040_esper_04",
      "hash64": "A1A3836506F223FC",
      "text": "嗯呵呵……[VAR 0x0100(0000)]。\\n可愛的挑戰者。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_esper_040_esper_05",
      "hash64": "A1A3846506F225AF",
      "text": "莉普我推出的體操讓你們變得更美，\\n你們一定很高興吧？[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_esper_040_esper_06",
      "hash64": "A1A3856506F22762",
      "text": "[VAR 0x1100(00FF,0101)]你妳把寶可夢的外表\\n也整理得乾乾淨淨。\\r\\n……[VAR 0x1100(00FF,0101)]你妳很有美觀意識喲。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_esper_040_esper_06b",
      "hash64": "9B02AAAACD784500",
      "text": "[EMPTY 30]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_esper_040_esper_07",
      "hash64": "A1A3866506F22915",
      "text": "不論是人類或寶可夢，\\n儀容打扮都是很重要的呢。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_esper_040_esper_08",
      "hash64": "A1A3876506F22AC8",
      "text": "能讓任何人都搖身一變的魔術。\\n……那就是化妝。\\r\\n……那就是彩妝。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_esper_040_esper_09",
      "hash64": "A1A3886506F22C7B",
      "text": "讓莉普我的招式把[VAR 0x1100(00FF,0101)]你妳的寶可夢\\n變得更～美麗吧！！[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_esper_040_esper_10",
      "hash64": "A1A7056506F536B9",
      "text": "不只輸了對戰，\\n竟然連比美也是平手……[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_esper_040_esper_11",
      "hash64": "A1A7046506F53506",
      "text": "[VAR 0x1100(00FF,0101)]你妳好棒……！\\n非常地，嗯，頂級棒……！[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_esper_040_esper_12",
      "hash64": "A1A7036506F53353",
      "text": "在[VAR 0x1100(00FF,0101)]你妳哪天成為大人物之前，\\n也許莉普我該把[VAR 0x1100(00FF,0101)]你妳給私藏起來？[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_esper_040_esper_13",
      "hash64": "A1A7026506F531A0",
      "text": "……但是莉普我現在得\\n重新琢磨琢磨自己才是。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_esper_040_esper_14",
      "hash64": "A1A7096506F53D85",
      "text": "[VAR 0x0100(0000)]，恭喜。\\n當作獎勵的道館徽章，\\r\\n就讓我用這個壓箱姿勢交給[VAR 0x1100(00FF,0101)]你妳吧。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_esper_040_esper_badge",
      "hash64": "4A010119989BC04B",
      "text": "如果有[VAR 0x0200(0001)]個道館徽章，\\n就會比較容易捕捉等級[VAR 0x0201(0002)]以下的寶可夢，\\r\\n而且牠們都會乖巧地聽話呢。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_esper_040_esper_badge_all",
      "hash64": "AD2165F57B02D8E7",
      "text": "要是有８個道館徽章的話，\\n不論什麼寶可夢都能捉到手，\\r\\n而且牠們都會乖～巧地聽話呢。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_esper_040_esper_waza",
      "hash64": "799E8E5F8222D3D9",
      "text": "只要好好鍛鍊體幹，\\n這個招式也能用得得心應手的。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_esper_040_esper_17",
      "hash64": "A1A7066506F5386C",
      "text": "[VAR 0x1100(00FF,0101)]你妳和莉普我的雙人照，\\n千萬不可以放上網路喲。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "gym_esper_040_esper_15",
      "hash64": "A1A7086506F53BD2",
      "text": "……又是流汗又是什麼的，\\n讓我有點掉妝了呢。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
