    {
      "ordinal": 0,
      "label": "gym_esper_040_receptionist_00",
      "hash64": "1F919632251A1EC8",
      "text": "[VAR 0x0100(0000)]，\\n歡迎光臨焙固道館。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
