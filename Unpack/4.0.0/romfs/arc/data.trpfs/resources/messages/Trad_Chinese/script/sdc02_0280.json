    {
      "ordinal": 2,
      "label": "sdc02_0280_brother_01",
      "hash64": "0E2F7C867BEA2945",
      "text": "零之秘寶……在哪裡！？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
