    },
    {
      "ordinal": 60,
      "label": "coach_teacher_ecology_randomtalk_03",
      "hash64": "2B971500F5690A83",
      "text": "[VAR 0x0100(0000)]的[VAR 0x0101(0001)]是\\n非～常有個性的寶可夢呢～！\\r\\n我很期待牠的成長喔～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
