          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_teacher_ecology_randomtalk_01",
      "hash64": "2B971700F5690DE9",
      "text": "最近能在許多地區往往返返，\\n讓我覺得很開心～\\c\\n移動時只要放空一下，馬上就是目的地了，\\n對我來說一點都不辛苦喔～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_teacher_ecology_randomtalk_02",
      "hash64": "2B971400F56908D0",
      "text": "我不小心穿著涼鞋\\n就來到別人的學校了～\\c\\n萬一被克拉韋爾校長看到，\\n可能又要挨罵了～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
