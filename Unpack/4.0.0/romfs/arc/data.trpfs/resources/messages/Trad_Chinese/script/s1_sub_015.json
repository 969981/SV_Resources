      ]
    },
    {
      "ordinal": 38,
      "label": "s1_sub_015_system_02",
      "hash64": "B40A6B32127386C6",
      "text": "[VAR 0x0100(0000)]從管理員那裡\\n學會了[VAR 0xFF00(0008)]萬歲表情[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
