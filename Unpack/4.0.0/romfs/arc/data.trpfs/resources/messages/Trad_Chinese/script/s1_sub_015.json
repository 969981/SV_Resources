        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_015_caretaker_13",
      "hash64": "AA1746EB935D299B",
      "text": "捐款以每口1萬為單位！\\n目標金額是100萬！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_015_caretaker_14",
      "hash64": "AA174BEB935D321A",
      "text": "話雖如此，我也不忍心\\n讓學生來掏腰包……[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
