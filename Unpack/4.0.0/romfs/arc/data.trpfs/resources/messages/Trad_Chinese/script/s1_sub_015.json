          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_015_caretaker_04",
      "hash64": "AA1A49EB935F648B",
      "text": "真沒想到原來寶伴是壞蛋，\\n厄鬼椪才是受害者！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_015_caretaker_05",
      "hash64": "AA1A48EB935F62D8",
      "text": "我們差點就要把錯誤的歷史\\n傳給後代了。[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_015_caretaker_06",
      "hash64": "AA1A4BEB935F67F1",
      "text": "……話、說、回、來！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_015_caretaker_07",
      "hash64": "AA1A4AEB935F663E",
      "text": "即使我心知肚明\\n寶伴才是壞蛋……[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_015_caretaker_08",
      "hash64": "AA1A45EB935F5DBF",
      "text": "但在寶伴復活時壞掉的\\n那些廣場的石像！\\c\\n[VAR 0x1100(00FF,0101)]你妳不覺得就讓它們壞在那邊，\\n實在是於心不忍嗎？[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_015_caretaker_09",
      "hash64": "AA1A44EB935F5C0C",
      "text": "是吧，是吧！\\n真不愧是學院的學生！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_015_caretaker_10",
      "hash64": "AA1747EB935D2B4E",
      "text": "寶伴像壞掉的時候，\\n[VAR 0x1100(00FF,0101)]你妳人也在現場吧？\\r\\n嘴上說歸說，但[VAR 0x1100(00FF,0101)]你妳肯定很在意！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
