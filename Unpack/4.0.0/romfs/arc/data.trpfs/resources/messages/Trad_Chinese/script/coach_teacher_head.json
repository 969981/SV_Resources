    },
    {
      "ordinal": 60,
      "label": "coach_teacher_head_battleend_lose_00_00",
      "hash64": "44600B37F799571F",
      "text": "真是一場白熱化的對戰，\\n不論誰贏都不奇怪呢。\\c\\n輸了之後的行動才是最重要的。\\n我相信[VAR 0x1100(00FF,0101)]你妳應該很明白這一點。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
