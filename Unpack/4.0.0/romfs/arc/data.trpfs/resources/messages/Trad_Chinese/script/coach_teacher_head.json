    {
      "ordinal": 58,
      "label": "coach_teacher_head_battleend_win_01_00",
      "hash64": "2081D37226111F5D",
      "text": "真的是一場非常精彩的對戰。\\n讓我們互相讚揚彼此的努力吧。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
