    },
    {
      "ordinal": 57,
      "label": "coach_teacher_head_reward_00",
      "hash64": "93C05EAD2ACCB3C0",
      "text": "[VAR 0x0100(0000)]從克拉韋爾校長那裡\\n得到了[VAR 0xFF00(0008)]聶凱帽[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
