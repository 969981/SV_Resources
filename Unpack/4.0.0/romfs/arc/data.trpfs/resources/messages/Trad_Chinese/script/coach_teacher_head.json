            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_teacher_head_first_01",
      "hash64": "7AEC149832B803B0",
      "text": "我是橘子學院的校長，\\n克拉韋爾。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_head_first_01b",
      "hash64": "972AD09E2EAE7DD6",
      "text": "我是葡萄學院的校長，\\n克拉韋爾。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_head_sp01_00",
      "hash64": "F2D94A14D3A25ADD",
      "text": "我從席藍校長那裡聽說了\\n[VAR 0x0100(0000)]同學[VAR 0x1100(00FF,0101)]你妳的傑出表現喔。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_head_sp01_01",
      "hash64": "F2D94914D3A2592A",
      "text": "他說[VAR 0x1100(00FF,0101)]你妳在社團活動拿下了第一名，\\n而且還很積極地參加校外活動。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_head_sp01_02",
      "hash64": "F2D94814D3A25777",
      "text": "聽得讓我這個學院的校長\\n也很驕傲呢。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_head_sp01_03",
      "hash64": "F2D94714D3A255C4",
      "text": "[VAR 0x1100(00FF,0101)]你妳在藍莓學園的生活\\n一切都好嗎？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_head_sp01_select_01",
      "hash64": "1BE69E4EC3A02AE9",
      "text": "我過得很開心！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_head_sp01_select_02",
      "hash64": "1BE69B4EC3A025D0",
      "text": "我想想……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_head_sp01_04",
      "hash64": "F2D94614D3A25411",
      "text": "這答案真是令我非常高興。\\n當時請[VAR 0x1100(00FF,0101)]你妳來到這裡，真是太好了。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_head_sp01_04b",
      "hash64": "498688639CD57F69",
      "text": "是有很多讓[VAR 0x1100(00FF,0101)]你妳煩惱的事嗎？\\c\\n……若是遇上了什麼難處，\\n歡迎[VAR 0x1100(00FF,0101)]你妳隨時回來。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_head_sp01_05",
      "hash64": "F2D94514D3A2525E",
      "text": "我會作為客座講師\\n待在這裡一陣子，\\r\\n有什麼事的話，請來告訴我喔。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_head_sp02_00",
      "hash64": "4C0E082E1AF37DEA",
      "text": "話說，[VAR 0x0100(0000)]同學，\\n在學園裡有什麼讓[VAR 0x1100(00FF,0101)]你妳煩惱的事嗎？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_head_sp02_01",
      "hash64": "4C0E092E1AF37F9D",
      "text": "例如……\\n被席藍校長耍得團團轉，\\r\\n或是被交代一些難以達成的事之類的？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_head_sp02_select_01",
      "hash64": "66926F384EBEA96C",
      "text": "一切都很好！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_head_sp02_select_02",
      "hash64": "669272384EBEAE85",
      "text": "他人很好喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_head_sp02_02",
      "hash64": "4C0E062E1AF37A84",
      "text": "這樣啊……\\n那我就放心了。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_head_sp02_03",
      "hash64": "4C0E072E1AF37C37",
      "text": "我和席藍校長\\n以前就讀同一所學校。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_head_sp02_04",
      "hash64": "4C0E042E1AF3771E",
      "text": "其實從那時開始，\\n我就被他耍得團團轉。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_head_sp02_05",
      "hash64": "4C0E052E1AF378D1",
      "text": "我被指派到學院\\n擔任校長時也是……[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_head_sp02_06",
      "hash64": "4C0E022E1AF373B8",
      "text": "「小韋你缺乏的就是威嚴，\\n所以你試著把紀念球掛在腰上如何！？」[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_head_sp02_07",
      "hash64": "4C0E032E1AF3756B",
      "text": "當時是他對我這麼說的……\\n乖乖聽話的我也該反省就是了。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_head_sp02_08",
      "hash64": "4C0E002E1AF37052",
      "text": "要是[VAR 0x1100(00FF,0101)]你妳遇上了什麼事，\\n請隨時和我聯絡喔。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_head_sp03_00",
      "hash64": "768BFE22D18ABD3B",
      "text": "因為[VAR 0x0100(0000)]同學[VAR 0x1100(00FF,0101)]你妳\\n來到藍莓學園留學……[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_head_sp03_01",
      "hash64": "768BFD22D18ABB88",
      "text": "讓我也更有機會\\n拜訪這裡了。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_head_sp03_02",
      "hash64": "768C0022D18AC0A1",
      "text": "參觀學院以外的學校，\\n能學到非常多的東西呢。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_head_sp03_03",
      "hash64": "768BFF22D18ABEEE",
      "text": "我打算將這裡的優點引進學院，\\n請讓我聽聽[VAR 0x1100(00FF,0101)]你妳的意見。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_head_sp03_04",
      "hash64": "768C0222D18AC407",
      "text": "[VAR 0x0100(0000)]同學[VAR 0x1100(00FF,0101)]你妳最喜歡\\n藍莓學園的哪一點？[VAR 0x0114(000A)]",
