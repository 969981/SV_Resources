    },
    {
      "ordinal": 59,
      "label": "coach_teacher_head_battleend_win_01_01",
      "hash64": "2081D27226111DAA",
      "text": "記得要讓[VAR 0x0101(0002)]\\n得到充分的休息喔。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
