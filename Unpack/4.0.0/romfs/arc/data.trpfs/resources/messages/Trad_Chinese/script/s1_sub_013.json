      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_013_picnic_02",
      "hash64": "686A7AA477DFA8D5",
      "text": "我好煩惱椅子要設計成什麼樣，\\n才會方便在野餐時使用。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_013_picnic_03",
      "hash64": "686A79A477DFA722",
      "text": "可不可以讓大叔我看看\\n[VAR 0x1100(00FF,0101)]你妳有哪些桌巾咧？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
