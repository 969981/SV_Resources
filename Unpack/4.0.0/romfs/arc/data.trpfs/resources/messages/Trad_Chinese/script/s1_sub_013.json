    {
      "ordinal": 6,
      "label": "s1_sub_013_picnic_04",
      "hash64": "686A74A477DF9EA3",
      "text": "嗯哼嗯哼，原來原來！\\n帕底亞有這樣的設計啊……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
