    },
    {
      "ordinal": 50,
      "label": "coach_teacher_dragon_randomtalk_01",
      "hash64": "F7321789F9C61E30",
      "text": "藍莓學園的學生\\n也都是一群好孩子呢。\\r\\n教起來非常有成就感是也。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
