    {
      "ordinal": 43,
      "label": "coach_teacher_dragon_battleend_win_00_02",
      "hash64": "7E8DF206A5F41F77",
      "text": "小生……無比感慨……\\n嗚哦喔喔～哦喔喔！！[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
