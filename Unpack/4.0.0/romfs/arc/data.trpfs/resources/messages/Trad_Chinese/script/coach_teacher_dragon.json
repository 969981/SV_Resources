    {
      "ordinal": 30,
      "label": "coach_teacher_dragon_trade_02_00",
      "hash64": "D320C3AC42B4583F",
      "text": "[VAR 0x0100(0000)]同學，[VAR 0x1100(00FF,0101)]你妳確定要用\\n[VAR 0x0101(0001)]和小生的凍脊龍交換嗎？[VAR 0x0114(0012)]",
