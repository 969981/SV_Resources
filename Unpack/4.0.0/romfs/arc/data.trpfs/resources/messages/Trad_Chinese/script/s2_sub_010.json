      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_010_headbb_06",
      "hash64": "11282869A284FEA9",
      "text": "[VAR 0x1100(00FF,0101)]你妳收集到相當多了呢。\\c\\n既然已經進展到這裡，\\n當然就是要完成才行囉～！[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
