      ]
    },
    {
      "ordinal": 38,
      "label": "s2_sub_010_headbb_21",
      "hash64": "11213D69A27F03AA",
      "text": "[VAR 0x0100(0000)]，晚安。\\n到了晚上[VAR 0x1100(00FF,0101)]你妳還是很有活力呢～\\c\\n我是個大叔，差不多要睡了。[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
