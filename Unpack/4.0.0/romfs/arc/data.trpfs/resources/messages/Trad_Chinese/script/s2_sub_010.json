          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_010_headbb_first_03",
      "hash64": "5055DB0A700B281D",
      "text": "我啊～我正一邊感受海風，\\n一邊望著對戰場發呆，\\r\\n想著會不會撞見有趣的對戰開始喔～[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
