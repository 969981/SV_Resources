      ]
    },
    {
      "ordinal": 40,
      "label": "s2_sub_010_headbb_23",
      "hash64": "11213B69A27F0044",
      "text": "[VAR 0x0100(0000)]，[VAR 0x1100(00FF,0101)]你妳好。\\n雨還在下啊～\\c\\n雖然在入口加上屋頂\\n也不是不行，\\c\\n但也有喜歡水的寶可夢在，\\n所以我就打消這個念頭了！[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
