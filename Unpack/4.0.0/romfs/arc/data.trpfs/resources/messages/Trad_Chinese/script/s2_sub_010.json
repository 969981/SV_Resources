    {
      "ordinal": 1,
      "label": "s2_sub_010_headbb_first_select_01",
      "hash64": "46A11261D8481D4E",
      "text": "我來找你！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_010_headbb_first_select_02",
      "hash64": "46A11161D8481B9B",
      "text": "校長你呢？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_010_headbb_first_02",
      "hash64": "5055DA0A700B266A",
      "text": "[VAR 0x1100(00FF,0101)]你妳想和我說話呀！\\n我啊～還真是受歡迎！[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
