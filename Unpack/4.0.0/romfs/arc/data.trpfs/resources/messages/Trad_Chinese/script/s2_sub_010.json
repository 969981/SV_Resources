      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_010_headbb_05",
      "hash64": "11282569A284F990",
      "text": "看來[VAR 0x1100(00FF,0101)]你妳收集到不少了呢。\\c\\n這裡有很多不一樣的寶可夢吧？\\n巨蛋的空調可是很花錢的呢～[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
