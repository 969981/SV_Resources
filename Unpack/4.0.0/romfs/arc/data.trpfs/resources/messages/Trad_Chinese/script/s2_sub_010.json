      ]
    },
    {
      "ordinal": 39,
      "label": "s2_sub_010_headbb_22",
      "hash64": "11213C69A27F01F7",
      "text": "早安！\\n今天是下雨天喔～\\c\\n不過就算身上濕了，\\n也不知是被浪花濺到，還是給雨水淋到的，\\r\\n這可以說是藍莓學園的亮點呢。[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
