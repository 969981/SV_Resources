          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "s2_sub_010_headbb_24",
      "hash64": "11213A69A27EFE91",
      "text": "可惜！\\n今天似乎看不到夕陽了。\\c\\n我去欣賞生態巨蛋空中的\\n人工夕陽好了。[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
