          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s2_sub_010_head_10",
      "hash64": "15B2F7B8135AB752",
      "text": "你在學生面前叫我小韋的這件事，\\n差不多該……[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "s2_sub_010_head_11",
      "hash64": "15B2F8B8135AB905",
      "text": "哈囉～……\\n你有在聽嗎？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "s2_sub_010_headbb_18",
      "hash64": "1124AC69A281F61E",
      "text": "早安！[VAR 0x1100(00FF,0101)]你妳真是早起！\\c\\n我醒來之後就睡不著了～\\n人上了年紀後，就睡不久了呢。[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "s2_sub_010_headbb_19",
      "hash64": "1124AD69A281F7D1",
      "text": "[VAR 0x0100(0000)]，[VAR 0x1100(00FF,0101)]你妳好。\\n交換留學的生活如何呢？\\c\\n希望[VAR 0x1100(00FF,0101)]你妳多多捕捉寶可夢，\\n盡情享受藍樂活喔！[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
