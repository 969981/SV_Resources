      "label": "kizuna_language_d_system_02",
      "hash64": "652DA48DF72792D4",
      "text": "[VAR 0x0100(0000)]受賽吉老師\\n託付了一隻喵喵！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
