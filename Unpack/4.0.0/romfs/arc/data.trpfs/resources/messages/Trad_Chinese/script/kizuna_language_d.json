    {
      "ordinal": 9,
      "label": "kizuna_language_d_select_01",
      "hash64": "4C9EA760060359BA",
      "text": "應該是這裡？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
