          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_language_d_11",
      "hash64": "C77C0465D9097D26",
