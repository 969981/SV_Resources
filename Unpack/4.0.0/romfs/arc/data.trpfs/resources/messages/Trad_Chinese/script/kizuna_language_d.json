      "ordinal": 23,
      "label": "kizuna_language_d_15",
      "hash64": "C77C0865D90983F2",
      "text": "我真的很高興！\\n接下來我也會負起責任\\r\\n照顧布撥牠的！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
