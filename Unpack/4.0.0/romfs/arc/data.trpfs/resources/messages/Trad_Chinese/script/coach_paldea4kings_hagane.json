      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea4kings_hagane_sp01_01",
      "hash64": "1EB056AB4FA0A8EB",
      "text": "欸嘿！[VAR 0x0114(0014)]",
      "flags": 0,
