    },
    {
      "ordinal": 13,
      "label": "coach_paldea4kings_hagane_sp02_00",
      "hash64": "F5E55FB69A7AFC67",
      "text": "因為受到邀請，\\n所以波琵我又來了！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
