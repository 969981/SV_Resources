          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_paldea4kings_hagane_sp02_07",
      "hash64": "F5E55CB69A7AF74E",
      "text": "大哥哥，\\n謝謝你這麼貼心！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
