      "label": "coach_paldea4kings_hagane_sp02_07b",
      "hash64": "4FB3B6487EF1FFC4",
      "text": "大姐姐，\\n謝謝妳這麼貼心！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
