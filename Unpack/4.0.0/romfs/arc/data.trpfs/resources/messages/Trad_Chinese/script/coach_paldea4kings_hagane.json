          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_paldea4kings_hagane_sp03_01",
      "hash64": "F7208ABBC18860C9",
      "text": "在大哥哥的眼中，\\n你覺得波琵我看起來像是幾歲呢？[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_paldea4kings_hagane_sp03_01b",
      "hash64": "74AC6809DABC4291",
      "text": "在大姐姐的眼中，\\n妳覺得波琵我看起來像是幾歲呢？[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
