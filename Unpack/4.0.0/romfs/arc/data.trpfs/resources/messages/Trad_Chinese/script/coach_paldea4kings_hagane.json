          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_paldea4kings_hagane_sp02_06",
      "hash64": "F5E55DB69A7AF901",
      "text": "……因為波琵我和\\n周圍的人有一點不一樣，\\r\\n所以忍不住有些擔心！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
