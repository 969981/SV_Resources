          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea4kings_hagane_sp01_03",
      "hash64": "1EB058AB4FA0AC51",
      "text": "波琵我是第一次來海外，\\n雖然很想很想去玩……[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea4kings_hagane_sp01_04",
      "hash64": "1EB059AB4FA0AE04",
      "text": "但是波琵我會教藍～莓的大家\\n寶可夢的事情的！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_paldea4kings_hagane_sp01_select_03",
      "hash64": "65BC09B26DB5864C",
      "text": "加油！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "coach_paldea4kings_hagane_sp01_select_04",
      "hash64": "65BC08B26DB58499",
      "text": "波琵妳好棒！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "coach_paldea4kings_hagane_sp01_05",
      "hash64": "1EB05AAB4FA0AFB7",
      "text": "欸嘿！我會加油的～！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
