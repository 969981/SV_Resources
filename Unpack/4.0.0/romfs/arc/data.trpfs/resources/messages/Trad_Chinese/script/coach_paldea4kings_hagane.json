    },
    {
      "ordinal": 25,
      "label": "coach_paldea4kings_hagane_sp03_00b",
      "hash64": "74A97E09DABA321C",
      "text": "哎呀，大姐姐。[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
