      "hash64": "F72089BBC1885F16",
      "text": "哎呀，大哥哥。[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
