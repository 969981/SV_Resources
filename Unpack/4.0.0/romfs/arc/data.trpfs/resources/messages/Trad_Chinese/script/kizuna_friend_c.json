      "label": "kizuna_friend_c_16",
      "hash64": "401F8142B8B9869A",
      "text": "嗯，就是這種地方\\n讓這本書看起來很可疑！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
