    {
      "ordinal": 1,
      "label": "kizuna_friend_c_select_01",
      "hash64": "713537F71E980ACD",
      "text": "算是吧",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "kizuna_friend_c_select_02",
      "hash64": "713534F71E9805B4",
      "text": "我只是路過",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_friend_c_02a",
      "hash64": "B657A85FE6FC0F1E",
      "text": "喂喂！\\n[VAR 0x1100(00FF,0101)]你妳不要連腦袋瓜都變一等一的啊～[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
