          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_friend_c_13b",
      "hash64": "AF056E5FE337B4B9",
      "text": "咦？\\n但是未來的寶可夢牠會出現在這裡，\\r\\n是因為我爸他打造了時光機嘛？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
