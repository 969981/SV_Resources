          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_friend_c_02b",
      "hash64": "B657A75FE6FC0D6B",
      "text": "[VAR 0x1100(00FF,0101)]你妳在用入口的樓梯鍛鍊腳力嗎？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
