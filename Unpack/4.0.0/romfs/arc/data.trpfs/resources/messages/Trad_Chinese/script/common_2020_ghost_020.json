  "entries": [
    {
      "ordinal": 0,
      "label": "common_2020_ghost_020_ghost_01",
      "hash64": "C4780CFDD2B29596",
      "text": "寶貝[VAR 0x1100(00FF,0101)]你妳來挑戰道館測驗，\\n也不過是不久之前的事。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
