          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2020_ghost_020_ghost_02",
      "hash64": "C4780BFDD2B293E3",
      "text": "現在卻成了冠軍，\\n還能代替首席辦事呢。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2020_ghost_020_ghost_03",
      "hash64": "C4780AFDD2B29230",
      "text": "到了我這年紀，\\n時間真是稍縱即逝啊。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2020_ghost_020_ghost_04",
      "hash64": "C47811FDD2B29E15",
      "text": "……哎，這種感傷事跟我一點都不合適！\\n韻律高手萊姆，這就來與[VAR 0x1100(00FF,0101)]你妳交手！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2020_ghost_020_ghost_05",
      "hash64": "C47810FDD2B29C62",
      "text": "這是認真對戰的時候，\\nCHECK OUT MY SOUL！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_ghost_020_ghost_06",
      "hash64": "C4780FFDD2B29AAF",
      "text": "就算[VAR 0x1100(00FF,0101)]你妳這嫩葉才高八斗，\\n也得要花時間才會成熟！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_ghost_020_ghost_07",
      "hash64": "C4780EFDD2B298FC",
      "text": "看[VAR 0x1100(00FF,0101)]你妳如何讓我顫動，\\n在這對戰SHAKE MY SOUL！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_ghost_020_ghost_08",
      "hash64": "C47815FDD2B2A4E1",
      "text": "HAHAHA！竟然有這回事！\\n寶貝[VAR 0x1100(00FF,0101)]你妳的拳頭真是棒透頂了！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_ghost_020_ghost_09",
      "hash64": "C47814FDD2B2A32E",
      "text": "我的靈魂瘋狂顫動，\\n都快要變成果凍了！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_ghost_020_ghost_10",
      "hash64": "C47487FDD2AF7DC0",
      "text": "剛才我嫌[VAR 0x1100(00FF,0101)]你妳是個新手，\\n真是抱歉喔。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_ghost_020_ghost_11",
      "hash64": "C47488FDD2AF7F73",
      "text": "我想讓也慈認同幽靈的力量，\\n所以就一時心急了。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2020_ghost_020_ghost_12",
      "hash64": "C47489FDD2AF8126",
      "text": "[VAR 0x1100(00FF,0101)]你妳這渾身的勁兒是真的。\\n我可以掛保證。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2020_ghost_020_ghost_13",
      "hash64": "C4748AFDD2AF82D9",
      "text": "今後，我萊姆就是[VAR 0x1100(00FF,0101)]你妳的後盾了。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2020_ghost_020_ghost_14",
      "hash64": "C4748BFDD2AF848C",
      "text": "要是遇上令人火大的訓練家\\n或是幽靈，馬上叫我一聲吧。\\r\\n我會幫[VAR 0x1100(00FF,0101)]你妳出一把力的。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2020_ghost_020_ghost_15",
      "hash64": "C4748CFDD2AF863F",
      "text": "去謳歌GOOD的今生今世吧！\\n拜拜囉！寶貝！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    }
  ]
