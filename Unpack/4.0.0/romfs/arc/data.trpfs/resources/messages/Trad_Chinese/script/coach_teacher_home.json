    },
    {
      "ordinal": 40,
      "label": "coach_teacher_home_trade_01_03",
      "hash64": "8B53B1341D6CB331",
      "text": "我就送出提布莉姆吧。\\n[VAR 0x0100(0000)]同學[VAR 0x1100(00FF,0101)]你妳怎麼打算？[VAR 0x0114(0029)]",
      "flags": 0,
