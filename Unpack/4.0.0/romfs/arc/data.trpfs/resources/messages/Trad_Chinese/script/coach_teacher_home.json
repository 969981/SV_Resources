    {
      "ordinal": 32,
      "label": "coach_teacher_home_sp03_05",
      "hash64": "8C60D5B9C31003ED",
      "text": "小仙奶如果要進化成霜奶仙，\\n就要先讓牠加入同行寶可夢，\\r\\n然後原地轉圈圈。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
