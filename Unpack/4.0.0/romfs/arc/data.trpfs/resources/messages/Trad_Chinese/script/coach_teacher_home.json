          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_teacher_home_sp03_09",
      "hash64": "8C60C9B9C30FEF89",
      "text": "我也是為了要讓我的霜奶仙變成\\n現在這個樣子，所以調整過轉法。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
