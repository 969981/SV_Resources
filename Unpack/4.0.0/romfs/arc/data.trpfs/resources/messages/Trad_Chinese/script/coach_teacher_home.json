    },
    {
      "ordinal": 1,
      "label": "coach_teacher_home_first_01",
      "hash64": "EBABC613F7C84B3F",
      "text": "名為薩瓦羅，\\n以後請多指教。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
