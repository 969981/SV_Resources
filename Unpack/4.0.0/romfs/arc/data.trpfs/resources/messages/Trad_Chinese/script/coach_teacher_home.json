          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_teacher_home_sp03_06",
      "hash64": "8C60D2B9C30FFED4",
      "text": "如此一來，鮮奶油就會被攪拌，\\n變成鬆鬆軟軟的霜奶仙了。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_teacher_home_sp03_07",
      "hash64": "8C60D3B9C3100087",
      "text": "到時，可別忘了\\n讓小仙奶攜帶糖飾。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_teacher_home_sp03_08",
      "hash64": "8C60C8B9C30FEDD6",
      "text": "霜奶仙的外表會根據小仙奶攜帶的糖飾\\n與[VAR 0x1100(00FF,0101)]你妳的轉法而不同，要特別留意。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
