      "label": "sdc01_0060_caretaker_01",
      "hash64": "010966663D1CD946",
      "text": "大家，請往這邊來。[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
