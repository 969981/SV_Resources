          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_head_d_04",
      "hash64": "44C31D1A7E778530",
      "text": "我非常明白不應該\\n把這種事情託付給別人……[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_head_d_05",
      "hash64": "44C31E1A7E7786E3",
      "text": "但今後如果[VAR 0x0100(0000)]同學\\n[VAR 0x1100(00FF,0101)]你妳能和牡丹同學成為朋友，\\r\\n我會非常感激的。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
