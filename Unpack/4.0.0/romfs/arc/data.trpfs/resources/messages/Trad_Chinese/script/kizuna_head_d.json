      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_head_d_07",
      "hash64": "44C3201A7E778A49",
      "text": "這是校長獎。\\n請[VAR 0x1100(00FF,0101)]你妳收下吧。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
