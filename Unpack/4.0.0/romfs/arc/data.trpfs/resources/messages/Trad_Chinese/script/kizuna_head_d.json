      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_head_d_select_01",
      "hash64": "CF8A472FB375DBB6",
      "text": "當然好！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_head_d_select_02",
      "hash64": "CF8A462FB375DA03",
      "text": "我們已經是朋友了",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_head_d_06",
      "hash64": "44C31F1A7E778896",
      "text": "……我真的非常高興\\n[VAR 0x1100(00FF,0101)]你妳轉到我們學校來。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
