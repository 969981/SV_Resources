            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_head_d_03",
      "hash64": "44C3241A7E779115",
      "text": "牡丹同學她非常感謝[VAR 0x1100(00FF,0101)]你妳喔。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
