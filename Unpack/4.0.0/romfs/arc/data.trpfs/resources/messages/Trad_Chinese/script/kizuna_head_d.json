    {
      "ordinal": 1,
      "label": "kizuna_head_d_02",
      "hash64": "44C3231A7E778F62",
      "text": "對於牡丹同學的處置\\n也往好的方向發展，\\r\\n作為校長我總算能安心了。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
