      ]
    },
    {
      "ordinal": 36,
      "label": "sdc02_0088_brother_07",
      "hash64": "4F398B1CD20CFC99",
      "text": "我的社團不需要\\n拿不出全力的傢伙。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc02_0088_mob_03",
      "hash64": "59A0E38F0F061055",
      "text": "等等！烏栗！\\n原諒我！求求你！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "sdc02_0088_sister_29",
      "hash64": "D771CC0265E08A2D",
      "text": "……[VAR 0x1100(00FF,0101)]你妳嚇了一跳吧？[VAR 0x0114(0044)]",
