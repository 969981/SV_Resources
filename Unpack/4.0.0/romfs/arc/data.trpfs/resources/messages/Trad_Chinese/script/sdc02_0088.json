    },
    {
      "ordinal": 1,
      "label": "sdc02_0088_steelbb_01",
      "hash64": "6FCC51ABD7F2A054",
      "text": "我懂。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
