    },
    {
      "ordinal": 35,
      "label": "sdc02_0088_brother_06",
      "hash64": "4F398A1CD20CFAE6",
      "text": "……退社申請。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
