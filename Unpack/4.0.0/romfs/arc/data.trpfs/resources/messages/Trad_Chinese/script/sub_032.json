          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sub_032_ecology_13",
      "hash64": "1D772710BEAC04BD",
      "text": "萬一心愛的學生受傷什麼的，\\n老師我會很難過的……[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sub_032_ecology_14",
      "hash64": "1D772010BEABF8D8",
