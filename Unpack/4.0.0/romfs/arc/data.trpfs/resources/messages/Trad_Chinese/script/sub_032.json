    {
      "ordinal": 13,
      "label": "sub_032_ecology_10",
      "hash64": "1D772410BEABFFA4",
      "text": "圖鑑App會自動抓到調查資料的。[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
