    {
      "ordinal": 2,
      "label": "sub_032_ecology_02",
      "hash64": "1D7AA810BEAF15C7",
      "text": "恭喜[VAR 0x1100(00FF,0101)]你妳在校園最強大賽中\\n獲得優勝～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
