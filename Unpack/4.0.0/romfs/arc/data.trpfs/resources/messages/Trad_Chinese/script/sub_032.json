    {
      "ordinal": 15,
      "label": "sub_032_ecology_12",
      "hash64": "1D772610BEAC030A",
      "text": "不過即使[VAR 0x1100(00FF,0101)]你妳是校園最強的人，\\n也不能勉強拼過頭喔～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
