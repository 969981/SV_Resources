          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_032_ecology_03",
      "hash64": "1D7AA710BEAF1414",
      "text": "自己的學生獲得校園最強的稱號，\\n老師我也是很有面子～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_032_head_teacher_01",
      "hash64": "4BC620DFBE062313",
      "text": "……咳咳！吉尼亞老師！[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sub_032_ecology_04",
      "hash64": "1D7AA610BEAF1261",
      "text": "啊，克拉韋爾校長。\\n我這就切入主題～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_032_ecology_05",
      "hash64": "1D7AA510BEAF10AE",
      "text": "其實呢，\\n最近四處很多地方都發現了\\r\\n強大的太晶團體戰～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
