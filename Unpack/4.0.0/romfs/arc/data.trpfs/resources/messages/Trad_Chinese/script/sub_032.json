    },
    {
      "ordinal": 10,
      "label": "sub_032_select_01",
      "hash64": "600E90A1DE178896",
      "text": "交給我吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_032_select_02",
      "hash64": "600E8FA1DE1786E3",
      "text": "有空的話",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_032_ecology_09",
      "hash64": "1D7AA110BEAF09E2",
      "text": "哇～太棒了！\\n謝謝[VAR 0x1100(00FF,0101)]你妳～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
