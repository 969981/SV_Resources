          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_032_ecology_06",
      "hash64": "1D7AA410BEAF0EFB",
      "text": "學院學生們的寶可夢\\n受傷的報告接連不斷地出現～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_032_ecology_07",
      "hash64": "1D7AA310BEAF0D48",
      "text": "老師們也在分工調查，\\n但人手實在不夠……[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_032_ecology_08",
      "hash64": "1D7AA210BEAF0B95",
      "text": "所以呢，如果能請校園最強的\\n[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳伸出援手，\\r\\n那真是幫了我們一個大忙……[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
