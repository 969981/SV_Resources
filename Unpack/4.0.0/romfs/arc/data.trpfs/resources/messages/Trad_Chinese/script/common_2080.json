      "hash64": "9C0D5D3D3BBC23DA",
      "text": "[VAR 0x1100(00FF,0101)]你妳來了，[VAR 0x0100(0000)]。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
