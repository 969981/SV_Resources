            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2080_rival_02",
      "hash64": "9C0D5C3D3BBC2227",
      "text": "想要參加校園最強大賽的話，\\n必須要向工作人員申請參賽！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2080_rival_03",
      "hash64": "9C0D5B3D3BBC2074",
      "text": "那麼，就麻煩你\\n說明大賽規則了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2080_staff_01",
      "hash64": "B6EF1D39889F0EA4",
      "text": "校園最強大賽規定\\n不論是學生或老師都能夠參賽。\\r\\n是勝者晉級式的隨機對戰！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2080_staff_02",
      "hash64": "B6EF2039889F13BD",
      "text": "比賽的對手會由營運組\\n透過抽籤決定，因此……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_2080_staff_03",
      "hash64": "B6EF1F39889F120A",
      "text": "直到在對戰場上面對面之前，\\n無法得知自己的對手會是誰！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_2080_staff_04",
      "hash64": "B6EF1A39889F098B",
      "text": "獲勝的人可以繼續下一場對戰。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_2080_staff_05",
      "hash64": "B6EF1939889F07D8",
      "text": "但只要輸一場就算出局，\\n無法繼續參加之後的對戰。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_2080_staff_06",
      "hash64": "B6EF1C39889F0CF1",
      "text": "也就是說，在對戰中連戰連勝，\\n直到成為最後唯一剩下的一個人，\\r\\n那個人就是校園最強的訓練家！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2080_rival_04",
      "hash64": "9C0D5A3D3BBC1EC1",
      "text": "謝謝你！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2080_rival_05",
      "hash64": "9C0D593D3BBC1D0E",
      "text": "這是我和克拉韋爾校長\\n商量出來的大賽規則喔！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2080_rival_06",
      "hash64": "9C0D583D3BBC1B5B",
      "text": "以目前參賽的人數來說，\\n大概贏個４場左右就能拿下優勝了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2080_rival_07",
      "hash64": "9C0D573D3BBC19A8",
      "text": "老師們各個也都是高手。\\n[VAR 0x1100(00FF,0101)]你妳要加油喔！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2080_rival_08",
      "hash64": "9C0D563D3BBC17F5",
      "text": "[VAR 0x1100(00FF,0101)]你妳不可以輸給我以外的人喔～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2080_staff_07",
      "hash64": "B6EF1B39889F0B3E",
      "text": "等[VAR 0x1100(00FF,0101)]你妳準備好後，\\n請告訴我一聲。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    }
  ]
}
