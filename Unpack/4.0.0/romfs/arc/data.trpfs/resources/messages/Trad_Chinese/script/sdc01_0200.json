      "label": "sdc01_0200_student1_01",
      "hash64": "3F18ACBE5B08EB80",
      "text": "我今天一定要和丹瑜\\n一起去心跳加速的定向越野！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
