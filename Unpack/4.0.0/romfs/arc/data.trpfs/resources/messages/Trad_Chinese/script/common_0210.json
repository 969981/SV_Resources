          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0210_rival_04",
      "hash64": "38E36467BE56E1FE",
      "text": "那麼，就麻煩妳詳細說明了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0210_pokecen_01",
      "hash64": "AD11B217AFBB942A",
      "text": "好的，請交給我！\\n歡迎光臨寶可夢中心。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_0210_pokecen_02",
      "hash64": "AD11B117AFBB9277",
      "text": "我可以幫大家的寶可夢\\n恢復活力喔。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0210_pokecen_03",
      "hash64": "AD11B017AFBB90C4",
      "text": "那邊的設備是\\n招式學習器機！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_0210_pokecen_04",
      "hash64": "AD11AF17AFBB8F11",
      "text": "用那個裝置就可以製作\\n能讓寶可夢學習招式的招式學習器。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_0210_pokecen_05",
