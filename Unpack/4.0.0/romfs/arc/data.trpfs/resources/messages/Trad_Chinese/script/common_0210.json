        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0210_rival_03",
      "hash64": "38E36767BE56E717",
      "text": "在這裡可以做很多\\n關於寶可夢的事喔！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
