          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0120_dragon_10",
      "hash64": "FB4EFFF69816BB4A",
      "text": "身為四天王的一分子，\\n小生也滿懷期待地等著[VAR 0x1100(00FF,0101)]你妳呢。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
