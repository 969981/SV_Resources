    {
      "ordinal": 2,
      "label": "champ_0120_dragon_03",
      "hash64": "FB5266F69819A026",
      "text": "１００分滿分！實在漂亮！\\n……無可挑剔！！[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
