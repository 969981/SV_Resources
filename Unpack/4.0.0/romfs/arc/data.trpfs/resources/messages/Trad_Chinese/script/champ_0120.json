    },
    {
      "ordinal": 3,
      "label": "champ_0120_dragon_04",
      "hash64": "FB5269F69819A53F",
      "text": "[VAR 0x1100(00FF,0101)]你妳先手迅雷不及掩耳地\\n派出了[VAR 0x0101(0001)]！[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
