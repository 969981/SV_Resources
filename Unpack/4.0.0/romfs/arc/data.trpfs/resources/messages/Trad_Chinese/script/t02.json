    {
      "ordinal": 18,
      "label": "t02_21",
      "hash64": "B8F48BABB6A8AA0B",
      "text": "聽說大嘴鷗會把物品或信件\\n放進鳥嘴中來幫忙運送喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
