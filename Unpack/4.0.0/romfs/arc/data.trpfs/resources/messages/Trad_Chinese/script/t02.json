    {
      "ordinal": 20,
      "label": "t02_23",
      "hash64": "B8F48DABB6A8AD71",
      "text": "[VAR 0x1100(00FF,0101)]你妳要去上學了？\\n記得勤寫紀錄，路上小心喔。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
