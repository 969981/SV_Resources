            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "t02_03",
      "hash64": "B8FB95ABB6AED9B7",
      "text": "唏嚕嚕嚕……\\n啊～我喝到都飽了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
