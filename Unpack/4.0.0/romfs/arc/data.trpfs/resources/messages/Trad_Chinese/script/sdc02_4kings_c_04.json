    },
    {
      "ordinal": 22,
      "label": "sdc02_4kings_c_04_fairybb_20",
      "hash64": "EBC5C27C4A1CE5EA",
      "text": "讓大～家聚在一起，\\n散播這份可愛咯！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
