    {
      "ordinal": 3,
      "label": "sdc02_4kings_c_04_fairybb_04",
      "hash64": "EBBEBA7C4A16B9A4",
      "text": "老實說我很驚訝……\\n但我是不會夾帶個人感情的！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
