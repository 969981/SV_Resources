      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc02_4kings_c_04_select_03",
      "hash64": "D00BD1CD2F27B75E",
      "text": "紫竽也可愛！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc02_4kings_c_04_fairybb_15",
      "hash64": "EBC23F7C4A19D17A",
      "text": "呵呵呵！就是說吧～！\\n從後面看過去的時候，\\r\\n那些孩子們的屁股超～可愛的……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
