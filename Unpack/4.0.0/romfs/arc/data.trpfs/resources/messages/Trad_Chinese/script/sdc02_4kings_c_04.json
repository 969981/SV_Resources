        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_c_04_fairybb_09",
      "hash64": "EBBEAF7C4A16A6F3",
      "text": "這次我會拿出全力\\n和[VAR 0x1100(00FF,0101)]你妳對戰的……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
