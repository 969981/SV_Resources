          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_4kings_c_04_fairybb_16",
      "hash64": "EBC23E7C4A19CFC7",
      "text": "噗噗～！答錯囉！\\n我現在啊！\\r\\n是在說關於「可愛」的事！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
