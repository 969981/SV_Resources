          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_4kings_c_04_fairybb_10",
      "hash64": "EBC23C7C4A19CC61",
      "text": "我想我應該能讓[VAR 0x1100(00FF,0101)]你妳\\n深刻地了解……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
