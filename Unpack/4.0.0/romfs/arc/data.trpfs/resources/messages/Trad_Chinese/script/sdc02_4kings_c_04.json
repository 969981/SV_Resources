      "hash64": "EBBEB87C4A16B63E",
      "text": "重新自我介紹一下，\\n我是四天王紫竽。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
