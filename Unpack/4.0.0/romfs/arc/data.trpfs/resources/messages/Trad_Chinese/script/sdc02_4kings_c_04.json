      "ordinal": 23,
      "label": "sdc02_4kings_c_04_fairybb_21",
      "hash64": "EBC5C37C4A1CE79D",
      "text": "呼～這張照片\\n值得永久珍藏……！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
