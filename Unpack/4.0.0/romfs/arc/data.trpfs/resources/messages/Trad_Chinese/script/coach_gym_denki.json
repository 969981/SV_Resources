    },
    {
      "ordinal": 9,
      "label": "coach_gym_denki_sp01_04",
      "hash64": "8F15FDF6083A847F",
      "text": "人工巨蛋裡有４個區域～！？\\n哇～那是什麼！太厲害了！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
