          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_denki_sp02_02c",
      "hash64": "28911AE23EC6212B",
      "text": "校長登場之後\\n觀眾數就神速飆升！！\\c\\n那位究竟是何方神聖！？\\n肯定不是外行人吧！？\\c\\n就連我的個性都差點輸給他了。\\n世界上真的有怪物存在啊～……[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
