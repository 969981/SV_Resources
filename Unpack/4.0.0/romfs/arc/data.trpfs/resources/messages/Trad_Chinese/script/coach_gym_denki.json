    },
    {
      "ordinal": 17,
      "label": "coach_gym_denki_sp02_02b",
      "hash64": "289119E23EC61F78",
      "text": "藍莓聯盟的影片\\n相當受歡迎喔～！\\c\\n果然看官們見到學生們努力的樣子，\\n都特別容易投入感情呢！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
