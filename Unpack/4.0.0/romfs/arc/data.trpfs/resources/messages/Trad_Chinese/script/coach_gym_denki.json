    {
      "ordinal": 15,
      "label": "coach_gym_denki_sp02_01",
      "hash64": "B99410EABED1F517",
      "text": "我用[VAR 0x1100(00FF,0101)]你妳之前告訴我的題材\\n製作了影片……[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
