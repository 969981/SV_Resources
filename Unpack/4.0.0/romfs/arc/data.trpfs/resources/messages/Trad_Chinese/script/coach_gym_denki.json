    },
    {
      "ordinal": 10,
      "label": "coach_gym_denki_sp01_04b",
      "hash64": "5CE2A60FFB6E7D47",
      "text": "在學園內營運的模擬聯盟！？\\n雖然太正經了點，但感覺不錯！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
