      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_denki_sp01_04c",
      "hash64": "5CE2A50FFB6E7B94",
      "text": "校……校長？聽起來好無……\\n好像有點風險，真的沒問題嗎？\\c\\n請來上節目的來賓如果缺乏個性的話，\\n那可真的會出事的……[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
