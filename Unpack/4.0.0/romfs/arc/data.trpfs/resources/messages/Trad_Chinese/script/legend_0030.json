          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 83,
      "label": "legend_0030_mastiff_06",
      "hash64": "CF1EE9A9FFB57950",
      "text": "舔……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 84,
      "label": "legend_0030_friend_47",
      "hash64": "1CE9A199E999A975",
      "text": "唔……嘻、嘻哈哈哈……！\\n牠圓圓的眼睛太小了，\\r\\n有沒有睜開我都搞不清楚了～！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 85,
      "label": "legend_0030_friend_48",
      "hash64": "1CE9A299E999AB28",
      "text": "調味料的力量好厲害！\\n果然是貨真價實！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 86,
      "label": "legend_0030_friend_49",
      "hash64": "1CE9A399E999ACDB",
      "text": "我絕對要讓獒教父\\n恢復到像以前一樣，\\r\\n充滿活力的樣子。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 87,
      "label": "legend_0030_friend_50",
      "hash64": "1CECA099E99BDD99",
      "text": "……事情就是這樣，所以啊～[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 88,
      "label": "legend_0030_friend_51",
      "hash64": "1CEC9F99E99BDBE6",
      "text": "我們要找的調味料剩下３種！\\n一起加油吧！[VAR 0x0114(0006)]",
