      ]
    },
    {
      "ordinal": 78,
      "label": "legend_0030_mastiff_05",
      "hash64": "CF1EECA9FFB57E69",
      "text": "…………",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 79,
      "label": "legend_0030_friend_43",
      "hash64": "1CE99D99E999A2A9",
      "text": "哇哇哇！獒教父！\\n你這是……！\\r\\n你的眼睛能看得見了嗎！？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 80,
      "label": "legend_0030_friend_44",
      "hash64": "1CE99E99E999A45C",
      "text": "太好了！太好了！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 81,
      "label": "legend_0030_friend_45",
      "hash64": "1CE99F99E999A60F",
      "text": "一直以來……一直以來！\\n牠的眼睛都沒有睜開！\\r\\n我真的超擔心的……！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 82,
      "label": "legend_0030_friend_46",
      "hash64": "1CE9A099E999A7C2",
      "text": "嗚嗚……太好了！\\n真的是太好了……！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
