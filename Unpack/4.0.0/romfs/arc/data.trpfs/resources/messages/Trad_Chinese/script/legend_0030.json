        }
      ]
    },
    {
      "ordinal": 37,
      "label": "legend_0030_legend_07",
      "hash64": "D29F989AB7565C8A",
      "text": "啊嘎！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "legend_0030_friend_16",
      "hash64": "1CFA3299E9A7600B",
      "text": "果然秘傳調味料的\\n效果就是驚人～[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "legend_0030_friend_17",
      "hash64": "1CFA3199E9A75E58",
      "text": "……不驚人的話，\\n我可就傷腦筋了。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "legend_0030_legend_08",
      "hash64": "D29F8B9AB7564673",
      "text": "嗅嗅……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "legend_0030_legend_09",
      "hash64": "D29F8A9AB75644C0",
      "text": "啊嘎～？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "legend_0030_friend_18",
      "hash64": "1CFA3099E9A75CA5",
      "text": "不許碰！！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "legend_0030_friend_19",
      "hash64": "1CFA2F99E9A75AF2",
      "text": "那不是給你的！！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "legend_0030_legend_10",
      "hash64": "D29C8D9AB7541402",
      "text": "啊嘎……？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "legend_0030_friend_20",
      "hash64": "1CFD9E99E9AA4D66",
      "text": "啊……抱歉。\\n我不該那麼大聲的。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "legend_0030_friend_21",
      "hash64": "1CFD9F99E9AA4F19",
      "text": "或許我該好好地跟\\n[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳說明才是。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "legend_0030_friend_22",
      "hash64": "1CFD9C99E9AA4A00",
      "text": "……出來吧。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "legend_0030_friend_23",
      "hash64": "1CFD9D99E9AA4BB3",
      "text": "這傢伙是獒教父，\\n牠是我的搭檔。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "legend_0030_legend_11",
      "hash64": "D29C8E9AB75415B5",
      "text": "啊……嘎啊。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 50,
      "label": "legend_0030_mastiff_01",
      "hash64": "CF1EF0A9FFB58535",
      "text": "…………",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "legend_0030_friend_24",
      "hash64": "1CFDA299E9AA5432",
      "text": "來，吃一點能幫忙\\n恢復活力的三明治吧。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "legend_0030_friend_25",
      "hash64": "1CFDA399E9AA55E5",
      "text": "嗯，慢慢吃。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "legend_0030_friend_26",
      "hash64": "1CFDA099E9AA50CC",
      "text": "你小口小口地吃不要緊。\\n要慢慢地、慢慢地咬喔。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "legend_0030_mastiff_03",
      "hash64": "CF1EEEA9FFB581CF",
      "text": "…………",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "legend_0030_friend_27",
      "hash64": "1CFDA199E9AA527F",
      "text": "這傢伙不久之前……\\n受了很重的傷。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "legend_0030_friend_28",
      "hash64": "1CFDA699E9AA5AFE",
      "text": "在那之後，\\n牠的身體就一直很差……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "legend_0030_select_03",
      "hash64": "9CADEA1511477A09",
      "text": "傷藥沒用嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 58,
      "label": "legend_0030_select_04",
      "hash64": "9CADEB1511477BBC",
      "text": "寶可夢中心呢？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 59,
      "label": "legend_0030_friend_29a",
      "hash64": "ED609A880C7BB570",
      "text": "不論是傷藥還是寶可夢中心，\\n都治不好牠。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "legend_0030_friend_29b",
      "hash64": "ED609D880C7BBA89",
      "text": "他們說牠的狀況\\n不是普通的傷或疾病。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "legend_0030_friend_30",
      "hash64": "1D012499E9AD66EF",
      "text": "……對我來說，\\n最重要的只有獒教父這傢伙而已。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "legend_0030_friend_31",
      "hash64": "1D012399E9AD653C",
      "text": "我發誓不論用什麼樣的方法，\\n都一定要治好牠。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "legend_0030_friend_32",
      "hash64": "1D012699E9AD6A55",
      "text": "所以我在網路和書上\\n調查了許多種治療方法，\\r\\n而且幾乎都嘗試過了。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "legend_0030_friend_33",
      "hash64": "1D012599E9AD68A2",
      "text": "但不論哪一個方法都不太有效，\\n正當我快要放棄的時候……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "legend_0030_friend_34",
      "hash64": "1D012099E9AD6023",
      "text": "我終於發現了\\n秘傳調味料的存在！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 66,
      "label": "legend_0030_select_05",
      "hash64": "9CADEC1511477D6F",
      "text": "那本書是？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 67,
      "label": "legend_0030_select_06",
      "hash64": "9CADED1511477F22",
      "text": "你調查得真仔細",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 68,
      "label": "legend_0030_friend_35a",
      "hash64": "F646C3881196D6E3",
      "text": "我在我媽的\\n研究所裡找到的。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 69,
      "label": "legend_0030_friend_35b",
      "hash64": "F646C4881196D896",
      "text": "我在我爸的\\n研究所裡找到的。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 70,
      "label": "legend_0030_friend_36a",
      "hash64": "F651B38811A0C338",
      "text": "我在我媽的研究所裡\\n找到了這本書。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 71,
      "label": "legend_0030_friend_37b",
      "hash64": "F64DCC88119D04DC",
      "text": "我在我爸的研究所裡\\n找到了這本書。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 72,
      "label": "legend_0030_friend_38",
      "hash64": "1D012C99E9AD7487",
      "text": "這本怪力亂神的書誰也不會信，\\n裡面盡寫些胡說八道的內容。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
