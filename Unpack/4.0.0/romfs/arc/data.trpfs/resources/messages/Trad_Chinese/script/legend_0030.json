    {
      "ordinal": 36,
      "label": "legend_0030_friend_15",
      "hash64": "1CFA3399E9A761BE",
      "text": "總覺得牠好像又成長了？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
