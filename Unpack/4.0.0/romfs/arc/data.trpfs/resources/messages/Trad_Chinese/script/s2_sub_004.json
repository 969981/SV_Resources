          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_004_dokuboss_01",
      "hash64": "39778E6B72C159AB",
      "text": "明白了！\\n讓我們一同前往戰場吧！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_004_dokuboss_02",
      "hash64": "39778F6B72C15B5E",
      "text": "在下徹夜縫製的\\n[VAR 0x01C1(0001)]！\\r\\n起標價[VAR 0x0205(0003,0000)]。哈！請喊價！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "01C1",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 13,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
