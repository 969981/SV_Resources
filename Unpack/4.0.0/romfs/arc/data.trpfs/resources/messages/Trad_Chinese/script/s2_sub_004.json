    },
    {
      "ordinal": 15,
      "label": "s2_sub_004_dokuboss_03",
      "hash64": "3977906B72C15D11",
      "text": "現在的價格是[VAR 0x0205(0003,0000)]！\\n還有其他閣下要出價嗎！？[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
