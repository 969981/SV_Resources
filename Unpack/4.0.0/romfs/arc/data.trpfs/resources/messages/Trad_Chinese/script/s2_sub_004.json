    {
      "ordinal": 3,
      "label": "s2_sub_004_dokuboss_first_02",
      "hash64": "F50D294DF406AB79",
      "text": "唔嗯！？\\nYou是[VAR 0x0100(0000)]閣下！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
