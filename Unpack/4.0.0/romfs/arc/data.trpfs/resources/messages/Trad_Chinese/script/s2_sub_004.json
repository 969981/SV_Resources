        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_004_dokuboss_04",
      "hash64": "3977916B72C15EC4",
      "text": "[VAR 0x0100(0000)]閣下\\n出價[VAR 0x0205(0003,0000)]！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
