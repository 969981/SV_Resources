          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_004_select_01",
      "hash64": "30C1E78E12BDA29F",
      "text": "你在做什麼？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_004_select_02",
      "hash64": "30C1E88E12BDA452",
      "text": "特別的服飾是？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_004_dokuboss_first_04",
      "hash64": "F50D2B4DF406AEDF",
      "text": "哦哦，不愧是you，\\n眼光真嗨啊。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_004_dokuboss_first_05",
      "hash64": "F50D2A4DF406AD2C",
      "text": "在下秋明在夢境裡得到天啟，\\n創造出了original的服飾……[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_004_dokuboss_first_06",
      "hash64": "F50D2D4DF406B245",
      "text": "其後有幸取得此漬沁市場的許可，\\n便前來販售了。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_004_dokuboss_first_07",
      "hash64": "F50D2C4DF406B092",
      "text": "市場規定需採拍賣形式販售。\\n因此如欲購買，請標下商品。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_sub_004_dokuboss_pop_01",
      "hash64": "A90C316878EAA173",
      "text": "[VAR 0x01C0(0009)]，\\n有意購買嗎～？　▶",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "01C0",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_004_dokuboss_00",
      "hash64": "39778D6B72C157F8",
      "text": "此乃在下創造出的original服飾，\\n取名為[VAR 0x01C1(0001)]！\\r\\n起標價[VAR 0x0205(0003,0000)]！You是否要出價競標……？[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "01C1",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
