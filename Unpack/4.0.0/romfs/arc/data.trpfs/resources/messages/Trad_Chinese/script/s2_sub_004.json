      "ordinal": 26,
      "label": "s2_sub_004_system_01",
      "hash64": "75858643B50679EC",
      "text": "[VAR 0x0100(0000)]從秋明那裡\\n學會了[VAR 0xFF00(0008)]螢光棒之舞表情[VAR 0xFF00(0000)]！[VAR 0x0114(0023)]",
      "flags": 0,
