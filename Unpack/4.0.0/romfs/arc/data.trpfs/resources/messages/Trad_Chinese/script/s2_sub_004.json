            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_004_dokuboss_first_03",
      "hash64": "F50D284DF406A9C6",
      "text": "上次讀書會\\n承蒙you照顧了。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
