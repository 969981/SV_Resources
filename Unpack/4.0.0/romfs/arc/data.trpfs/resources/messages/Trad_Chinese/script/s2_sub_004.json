      "ordinal": 27,
      "label": "s2_sub_004_dokuboss_last_04",
      "hash64": "3B6057639E9162C1",
      "text": "那麼秋明總店\\n就此歇業！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
