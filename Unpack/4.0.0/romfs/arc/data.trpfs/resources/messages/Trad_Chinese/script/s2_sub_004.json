          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_sub_004_dokuboss_05",
      "hash64": "3977926B72C16077",
      "text": "那位閣下\\n以[VAR 0x0205(0003,0000)]得標了！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_sub_004_dokuboss_10",
      "hash64": "397B136B72C47181",
      "text": "本次拍賣就此落幕！\\n[VAR 0x0100(0000)]閣下漂亮地得標了！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_sub_004_dokuboss_06",
      "hash64": "3977936B72C1622A",
      "text": "得標價格是[VAR 0x0205(0003,0000)]！\\n來……收下商品吧！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
