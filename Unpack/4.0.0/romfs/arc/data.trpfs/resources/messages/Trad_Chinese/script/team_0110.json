    },
    {
      "ordinal": 44,
      "label": "team_0110_cassiopeia_20",
      "hash64": "ED11E5614AF8B6FA",
      "text": "……那麼，我等你們來。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
