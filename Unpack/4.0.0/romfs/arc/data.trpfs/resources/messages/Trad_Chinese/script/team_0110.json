    {
      "ordinal": 43,
      "label": "team_0110_nelke_03",
      "hash64": "AAF265C21941D559",
      "text": "我知道了。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
