    {
      "ordinal": 10,
      "label": "s2_side01_0020_friend_04",
      "hash64": "173BF59E992CF16A",
      "text": "不用不用！這怎麼好意思！\\n妳……您太客氣了！！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
