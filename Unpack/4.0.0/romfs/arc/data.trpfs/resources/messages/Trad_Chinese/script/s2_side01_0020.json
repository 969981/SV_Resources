    {
      "ordinal": 8,
      "label": "s2_side01_0020_mama_01",
      "hash64": "510DAA57FC29434D",
      "text": "大家都吃飽了嗎？\\n要不要來些點心？[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
