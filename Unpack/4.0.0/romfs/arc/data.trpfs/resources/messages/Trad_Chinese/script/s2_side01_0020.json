          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0020_mama_02",
      "hash64": "510DA757FC293E34",
      "text": "嘻嘻，\\n不用那麼拘謹沒關係的。[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
