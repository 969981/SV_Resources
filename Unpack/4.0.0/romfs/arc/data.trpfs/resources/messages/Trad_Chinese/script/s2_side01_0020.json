      "label": "s2_side01_0020_mama_03",
      "hash64": "510DA857FC293FE7",
      "text": "把這裡當成自己的家，\\n好好放鬆吧。[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
