      "hash64": "E419974E6477255C",
      "text": "也要好好說聲對不起，\\n然後告訴對方我愛你，這樣就一切ＯＫ了！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
