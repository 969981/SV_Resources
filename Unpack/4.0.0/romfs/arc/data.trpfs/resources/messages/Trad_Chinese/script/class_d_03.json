      "ordinal": 23,
      "label": "class_d_03_language_16",
      "hash64": "E419944E64772043",
      "text": "吵架時best的解決方式\\n就是盡早道歉！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
