      "ordinal": 22,
      "label": "class_d_03_language_15",
      "hash64": "E419954E647721F6",
      "text": "這時候，讓我偏題一下！\\n來自賽吉的貼心小建議！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
