    {
      "ordinal": 1,
      "label": "sdc02_0240_bbteacher_02",
      "hash64": "D96E48F4CEC7BA90",
      "text": "我沒有要催促[VAR 0x1100(00FF,0101)]你妳的意思，\\n但我已經迫不及待想出發了！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
