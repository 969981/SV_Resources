    {
      "ordinal": 35,
      "label": "team_0050_botan_08",
      "hash64": "B1BA6839D0BFF846",
      "text": "呃，[VAR 0x1100(00FF,0101)]你妳叫做\\n[VAR 0x0100(0000)]……對吧？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
