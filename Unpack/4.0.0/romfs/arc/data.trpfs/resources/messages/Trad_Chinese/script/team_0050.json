            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "team_0050_botan_09",
      "hash64": "B1BA6939D0BFF9F9",
      "text": "[VAR 0x0100(0000)]，\\n以[VAR 0x1100(00FF,0101)]你妳身為星塵大作戰戰鬥班成員來看，\\r\\n……[VAR 0x1100(00FF,0101)]你妳覺得天星隊怎麼樣？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
