          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bbteacher_head_first_21b",
      "hash64": "A6531424CD600F38",
      "text": "該怎麼稱呼才好呢？\\n嗯～……藍莓女王之類的？[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
