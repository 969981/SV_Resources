      "ordinal": 19,
      "label": "coach_bbteacher_head_first_16",
      "hash64": "93A032F57DD5CFCC",
      "text": "對手是[VAR 0x1100(00FF,0101)]你妳的話，\\n或許我可以對戰得很開心。[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
