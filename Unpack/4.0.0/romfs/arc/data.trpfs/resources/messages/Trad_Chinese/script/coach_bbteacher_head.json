          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bbteacher_head_first_11",
      "hash64": "93A031F57DD5CE19",
      "text": "託[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳的福，\\n學園裡的很多人\\r\\n還有很多社團，都充滿了活力喔。[VAR 0x0114(004B)]",
