    },
    {
      "ordinal": 12,
      "label": "coach_bbteacher_head_first_09",
      "hash64": "93A3BDF57DD8F1D4",
      "text": "那麼，\\n我差不多該公布答案了！[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
