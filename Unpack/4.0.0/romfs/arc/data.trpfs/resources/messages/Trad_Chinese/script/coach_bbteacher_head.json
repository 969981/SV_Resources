    },
    {
      "ordinal": 13,
      "label": "coach_bbteacher_head_first_10",
      "hash64": "93A030F57DD5CC66",
      "text": "哇，想不到吧！\\n其實我就是番紅～！[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
