    },
    {
      "ordinal": 1,
      "label": "coach_teacher_history_first_01",
      "hash64": "F3ABE80DE7EBE70C",
      "text": "[VAR 0x0100(0000)]，是[VAR 0x1100(00FF,0101)]你妳嗎？\\n叫我來這裡的人……[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
