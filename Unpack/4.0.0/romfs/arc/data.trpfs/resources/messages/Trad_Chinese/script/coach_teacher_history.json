          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_history_sp01_00",
      "hash64": "0D384DD6F5849F51",
      "text": "竟敢招待我來新的建築物，\\n[VAR 0x1100(00FF,0101)]你妳可真了不起啊？[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_history_sp01_01",
      "hash64": "0D384CD6F5849D9E",
      "text": "我本來一點興趣也沒有，\\n是顧及[VAR 0x1100(00FF,0101)]你妳的情面才來的。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_history_sp01_02",
      "hash64": "0D384BD6F5849BEB",
      "text": "呵呵呵……換句話說，\\n[VAR 0x1100(00FF,0101)]你妳欠我一個人情了。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_history_sp01_03",
      "hash64": "0D384AD6F5849A38",
      "text": "作為回報，遲早有一天\\n我會吩咐[VAR 0x1100(00FF,0101)]你妳幫我辦事的。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_history_sp01_select_01",
      "hash64": "57AE81059636D3ED",
      "text": "怎麼這樣……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_history_sp01_select_02",
      "hash64": "57AE7E059636CED4",
      "text": "我知道了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_history_sp01_05",
      "hash64": "0D3850D6F584A46A",
      "text": "呵呵呵！這是[VAR 0x1100(00FF,0101)]你妳自己播下的種，\\n[VAR 0x1100(00FF,0101)]你妳就好好祈禱豐收吧。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_history_sp01_05b",
      "hash64": "FB5565433062B998",
      "text": "哎呀？[VAR 0x1100(00FF,0101)]你妳意外地聽話啊。\\n呵呵呵……我倒是省事了。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_history_sp01_04",
      "hash64": "0D3851D6F584A61D",
      "text": "那麼，要讓[VAR 0x1100(00FF,0101)]你妳成為\\n什麼樣的傀儡才好呢……\\r\\n我已經開始期待了。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_history_sp02_00",
      "hash64": "666D0BF03CD5C25E",
      "text": "什麼啊，原來是[VAR 0x1100(00FF,0101)]你妳。\\n[VAR 0x1100(00FF,0101)]你妳又比以前古老好幾天了。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_history_sp02_01",
      "hash64": "666D0CF03CD5C411",
      "text": "我之前雖是不情不願地遠赴至此，\\n但仔細一想，這裡是合眾地區……\\r\\n是積澱了古老歷史的寶庫啊！[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_history_sp02_02",
      "hash64": "666D09F03CD5BEF8",
      "text": "其中，沉睡在海底的古老遺跡\\n最讓我的好奇心洶湧而上！！[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_history_sp02_03",
      "hash64": "666D0AF03CD5C0AB",
      "text": "……在這裡校長應該也看不到，\\n對我倒是省事了。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_history_sp02_04",
      "hash64": "666D0FF03CD5C92A",
      "text": "待會我就讓寶可夢游泳，\\n喲呵～！地帶我去探索吧！[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_history_sp02_select_01",
      "hash64": "2FC3C3870821A010",
      "text": "聽起來好有趣！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_history_sp02_select_02",
      "hash64": "2FC3C6870821A529",
      "text": "小心安全喔",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_history_sp02_05",
      "hash64": "666D10F03CD5CADD",
      "text": "呵呵呵！\\n這樂趣叫我怎能不好好享受一番呢！\\c\\n被考古的思維刺激，\\n這可是無能替代的至寶啊。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_history_sp02_05b",
      "hash64": "E11E87375F47828D",
      "text": "呵呵呵，[VAR 0x1100(00FF,0101)]你妳不必擔心。\\c\\n若能在遺跡和遺物的懷抱中衰亡，\\n那我也沒有遺憾了。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_history_sp03_00",
      "hash64": "8F3801E4F1FB6D2F",
      "text": "啊、啊啊……\\n[VAR 0x0100(0000)]……是[VAR 0x1100(00FF,0101)]你妳啊……[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_history_sp03_select_01",
      "hash64": "8C4F417AD5A90CCB",
      "text": "妳怎麼了？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_history_sp03_select_02",
      "hash64": "8C4F427AD5A90E7E",
      "text": "妳沒精神嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_history_sp03_01",
      "hash64": "8F3800E4F1FB6B7C",
      "text": "[VAR 0x1100(00FF,0101)]你妳看不出來嗎？\\n我是過於滿足，滿足得疲憊了。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_history_sp03_01b",
      "hash64": "5794A3072E3703FA",
      "text": "呵呵呵，不，正好相反……\\n我是過於滿足，滿足得疲憊了。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_history_sp03_02",
      "hash64": "8F3803E4F1FB7095",
      "text": "昨天我讓霓虹魚帶我游到了\\n合眾的海底遺跡……[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_history_sp03_03",
      "hash64": "8F3802E4F1FB6EE2",
      "text": "那裡太……太棒了……\\n真的是……美妙到了極致……[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_history_sp03_04",
      "hash64": "8F37FDE4F1FB6663",
      "text": "阻擋入侵者的古老裝置！\\n記載在壁面上的古代文字！[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_history_sp03_05",
      "hash64": "8F37FCE4F1FB64B0",
      "text": "和古代的人們鬥智，\\n真是極具意義，又甘又甜啊！[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_history_sp03_06",
      "hash64": "8F37FFE4F1FB69C9",
      "text": "但是一口氣就到達\\n遺跡的最深處，實在太可惜了。\\r\\n我打算慢慢地探索。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
