        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_kusa_020_keeper_07",
      "hash64": "3530CAAE0E137581",
      "text": "嘩～啦～嘩～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "gym_kusa_020_keeper_09",
      "hash64": "3530C4AE0E136B4F",
      "text": "向日花怪們都準備好囉！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "gym_kusa_020_keeper_10",
      "hash64": "3533D1AE0E15B73D",
      "text": "道館測驗開始！\\n當[VAR 0x1100(00FF,0101)]你妳集滿[VAR 0x0201(0001)]隻向日花怪後，\\r\\n就把牠們帶到向日花怪廣場來吧。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
