          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_kusa_020_receptionist_03",
      "hash64": "01E16963DBE1936E",
      "text": "集滿[VAR 0x0201(0001)]隻在深缽鎮裡，\\n像太陽又像花兒的寶可夢，\\r\\n也就是向日花怪。\\c\\n並且將牠們帶到向日花怪廣場，\\n就算通過道館測驗了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
