      "ordinal": 33,
      "label": "gym_kusa_020_kusapoke_12",
      "hash64": "F905CB795684297E",
      "text": "要放棄收集向日花怪嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
