          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_kusa_020_keeper_11",
      "hash64": "3533D0AE0E15B58A",
      "text": "那麼，請開始吧！\\n向日花怪們就拜託[VAR 0x1100(00FF,0101)]你妳囉！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_kusa_020_keeper_02",
      "hash64": "3530CDAE0E137A9A",
      "text": "[VAR 0x1100(00FF,0101)]你妳帶著的向日花怪……\\n一共是[VAR 0x0201(0001)]隻！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
