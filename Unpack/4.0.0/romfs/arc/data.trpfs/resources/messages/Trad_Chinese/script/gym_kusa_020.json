    {
      "ordinal": 4,
      "label": "gym_kusa_020_receptionist_05",
      "hash64": "01E16B63DBE196D4",
      "text": "牠們會在高處或是建築物後面等\\n讓人意想不到的地方。\\r\\n所以最好從各種角度去找找看喔。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
