    {
      "ordinal": 8,
      "label": "a_sch_room03_ni02",
      "hash64": "788188171F202D2A",
      "text": "這孩子很膽小，\\n所以沒有什麼力量，\\r\\n但是牠的動作很敏捷喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
