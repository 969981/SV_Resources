          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_e_01_battle_04",
      "hash64": "D9209B7370DEAB47",
      "text": "好，接下來各位同學\\n將在我的課堂上學習\\r\\n寶可夢的戰鬥！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_e_01_battle_05",
      "hash64": "D9209A7370DEA994",
      "text": "為了不讓任何人落後，\\n我會從最基本的事情教起！\\r\\n所以第一次接觸的人也可以放心！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_e_01_battle_06",
      "hash64": "D9209D7370DEAEAD",
      "text": "就當自己是上了艘可靠的大船……不，\\n就當是自己掛在鐵掌力士的肩膀上，\\r\\n讓我們一同燃燒鬥志吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
