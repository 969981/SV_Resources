          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_e_01_battle_03",
      "hash64": "D920987370DEA62E",
      "text": "肌肉結實的\\n格鬥屬性！！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
