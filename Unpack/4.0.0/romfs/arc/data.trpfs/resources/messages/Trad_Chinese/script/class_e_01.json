          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_e_01_battle_08",
      "hash64": "D9208F7370DE96E3",
      "text": "那就是威力、屬性……\\n以及[VAR 0xFF00(0006)]分類[VAR 0xFF00(0000)]！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
