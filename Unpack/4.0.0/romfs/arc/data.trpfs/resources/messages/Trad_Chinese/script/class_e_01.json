          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_e_01_battle_07",
      "hash64": "D9209C7370DEACFA",
      "text": "說到寶可夢的攻擊招式，\\n種類可說是非常多。\\r\\n每種招式都有不同的以下幾點！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
