      ]
    },
    {
      "ordinal": 1,
      "label": "class_e_01_battle_02",
      "hash64": "D920997370DEA7E1",
      "text": "年齡是２５！\\n興趣是練肌肉！\\r\\n喜歡的屬性是……[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
