      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0250_dragon_10",
      "hash64": "6EDF9DE937D5F444",
      "text": "嗚哦喔喔～哦喔喔！！[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
