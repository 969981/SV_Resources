      "label": "champ_0250_ground_04",
      "hash64": "89A40E74A5D9B1F9",
      "text": "無可挑剔的及格！[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
