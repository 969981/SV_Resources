      ]
    },
    {
      "ordinal": 26,
      "label": "champ_0250_ground_08",
      "hash64": "89A41A74A5D9C65D",
      "text": "[VAR 0x1100(00FF,0101)]你妳看裡面那扇門～[VAR 0x0114(0013)]",
