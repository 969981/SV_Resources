      "ordinal": 20,
      "label": "champ_0250_steel_03",
      "hash64": "A9A7E58A84824296",
      "text": "哇～！實力硬梆梆喔～！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
