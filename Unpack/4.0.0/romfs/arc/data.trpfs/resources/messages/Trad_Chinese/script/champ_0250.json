      "label": "champ_0250_system_01",
      "hash64": "15AF2B84C54614D8",
      "text": "要挑戰四天王八朔嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "champ_0250_dragon_01",
      "hash64": "6EE322E937D90C1A",
      "text": "小生早就知道\\n[VAR 0x1100(00FF,0101)]你妳遲早會來到這裡是也。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
