          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0250_dragon_07",
      "hash64": "6EE31CE937D901E8",
      "text": "堅守技能測驗\\n最終堡壘之龍，八朔。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
