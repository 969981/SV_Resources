      "ordinal": 17,
      "label": "champ_0250_dragon_11",
      "hash64": "6EDF9EE937D5F5F7",
      "text": "可、可素！\\n小生就是忍不住嘛～！[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
