          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0250_dragon_17",
      "hash64": "6EDF9CE937D5F291",
      "text": "現在就讓[VAR 0x1100(00FF,0101)]你妳親身感受何謂\\n猛烈無比的勝負氣息吧！！[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
