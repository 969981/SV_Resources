      "label": "champ_0250_dragon_08",
      "hash64": "6EE31BE937D90035",
      "text": "……太、太棒勒嗚啊！[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
