    {
      "ordinal": 1,
      "label": "ajito_kakutou_010_kakutouboss_02",
      "hash64": "4B28867826B0DECA",
      "text": "竟然可以抵擋\\n我的寶可夢的攻擊。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
