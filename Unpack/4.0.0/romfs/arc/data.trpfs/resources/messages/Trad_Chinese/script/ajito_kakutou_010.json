          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_kakutou_010_nelke_06",
      "hash64": "94C02D31DE6429AC",
      "text": "我看到有個像隊員的學生，\\n就跟她搭了下話……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_kakutou_010_nelke_07",
      "hash64": "94C02E31DE642B5F",
      "text": "想不到她突然襲擊過來，\\n現在我剛跟她打完一場對戰。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_kakutou_010_sitappa_00",
      "hash64": "4178C2401BDFB539",
      "text": "枇琶！\\n妳果然在這裡！[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
