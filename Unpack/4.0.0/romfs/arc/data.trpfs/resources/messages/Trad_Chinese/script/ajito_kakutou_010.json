    },
    {
      "ordinal": 10,
      "label": "ajito_kakutou_010_nelke_05",
      "hash64": "94C03031DE642EC5",
      "text": "[VAR 0x0100(0000)]！[VAR 0x1100(00FF,0101)]你妳來了啊！[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
