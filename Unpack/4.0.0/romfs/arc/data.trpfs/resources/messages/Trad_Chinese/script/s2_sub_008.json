          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_sub_008_kakutou_08",
      "hash64": "0C92C35883E7D7A2",
      "text": "這　樣　不　對　吧？[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
