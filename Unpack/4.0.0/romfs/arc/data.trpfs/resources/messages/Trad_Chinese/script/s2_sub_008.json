    {
      "ordinal": 1,
      "label": "s2_sub_008_aku_02",
      "hash64": "4368CE59C8652815",
      "text": "這件事不著急，\\n不論什麼時候都no problem的。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
