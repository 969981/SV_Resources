          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_008_aku_03",
      "hash64": "4368CD59C8652662",
      "text": "那麼，讓我們專心來stand by，\\n準備開始study吧！[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
