      "ordinal": 25,
      "label": "s2_sub_008_kakutou_06",
      "hash64": "0C92C55883E7DB08",
      "text": "[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]他她是\\n為大家著想才來的喔。[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
