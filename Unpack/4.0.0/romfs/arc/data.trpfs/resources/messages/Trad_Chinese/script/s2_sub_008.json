          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "s2_sub_008_aku_07",
      "hash64": "4368C959C8651F96",
      "text": "奧爾迪加他是不想\\n讓[VAR 0x1100(00FF,0101)]你妳看到他的矬樣。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
