            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s2_sub_008_kakutou_10",
      "hash64": "0C96315883EAC863",
      "text": "對了，梅洛呢？[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "s2_sub_008_doku_08",
      "hash64": "20C026EA316F3C17",
      "text": "梅洛可閣下在幾個時辰前\\n說要去做伸展運動，\\r\\n便大搖大擺地離去了。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "s2_sub_008_fairy_09",
      "hash64": "BB42A63E873D781E",
      "text": "她絕對是在偷懶！\\n她可是梅洛可耶。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "s2_sub_008_kakutou_11",
      "hash64": "0C96305883EAC6B0",
      "text": "嗯～雖然我覺得\\n一口咬定是不好的……[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "s2_sub_008_aku_08",
      "hash64": "4368D459C8653247",
      "text": "[VAR 0x0100(0000)]，不好意思，\\n可以請[VAR 0x1100(00FF,0101)]你妳幫忙去找梅洛可嗎？\\r\\n我想她至少人會在學院裡的！[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "s2_sub_008_aku_09",
      "hash64": "4368D359C8653094",
      "text": "我們會在[VAR 0x1100(00FF,0101)]你妳去找她的時候，\\n把適合讀書的環境stand by起來的！[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "s2_sub_008_kakutou_12",
      "hash64": "0C96335883EACBC9",
      "text": "[VAR 0x0100(0000)]，真抱歉，\\n梅洛就拜託[VAR 0x1100(00FF,0101)]你妳了！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
