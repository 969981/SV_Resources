    },
    {
      "ordinal": 26,
      "label": "s2_sub_008_kakutou_07",
      "hash64": "0C92C65883E7DCBB",
      "text": "但你卻對[VAR 0x1100(00FF,0101)]他她說出\\n那麼失禮的話……[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
