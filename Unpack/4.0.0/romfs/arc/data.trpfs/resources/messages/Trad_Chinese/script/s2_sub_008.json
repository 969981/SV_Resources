      "ordinal": 29,
      "label": "s2_sub_008_kakutou_09",
      "hash64": "0C92C45883E7D955",
      "text": "你　該　道　歉　的　人　不　是　我　吧？[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
