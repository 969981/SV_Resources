          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_sub_008_fairy_08",
      "hash64": "BB42A73E873D79D1",
      "text": "啊……嗯，\\n[VAR 0x0100(0000)]，抱歉。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
