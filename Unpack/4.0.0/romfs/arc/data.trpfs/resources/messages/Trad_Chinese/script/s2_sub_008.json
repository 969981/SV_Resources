          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_sub_008_fairy_07",
      "hash64": "BB42A03E873D6DEC",
      "text": "啊……枇琶姐，對不起。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
