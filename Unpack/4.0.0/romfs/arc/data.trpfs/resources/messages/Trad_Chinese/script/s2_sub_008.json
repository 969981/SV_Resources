    {
      "ordinal": 31,
      "label": "s2_sub_008_doku_07",
      "hash64": "20C01BEA316F2966",
      "text": "氣勢驚人的枇琶閣下……\\n實在罕見。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
