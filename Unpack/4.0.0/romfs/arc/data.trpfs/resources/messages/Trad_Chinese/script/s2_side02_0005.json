    {
      "ordinal": 11,
      "label": "s2_side02_0005_camera_08",
      "hash64": "46A1067C1A918CE1",
      "text": "神秘的地方加上神秘的寶可夢！\\n如果是真的，那可就不得了了！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
