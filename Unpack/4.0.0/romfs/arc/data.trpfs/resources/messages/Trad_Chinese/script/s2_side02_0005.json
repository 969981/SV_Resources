          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side02_0005_camera_14",
      "hash64": "469D7C7C1A8E6C8C",
      "text": "如果想再看一次照片，\\n隨時來跟我說吧。[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
