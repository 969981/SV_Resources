      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side02_0005_camera_15",
      "hash64": "469D7D7C1A8E6E3F",
      "text": "期待[VAR 0x1100(00FF,0101)]你妳能有很讚的調查結果喔，\\n[VAR 0x0100(0000)]！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
