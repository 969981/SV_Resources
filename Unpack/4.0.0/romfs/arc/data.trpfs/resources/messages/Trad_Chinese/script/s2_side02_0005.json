          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side02_0005_camera_06",
      "hash64": "46A1007C1A9182AF",
      "text": "……那麼按照約定，\\n我來告訴[VAR 0x1100(00FF,0101)]你妳那個[VAR 0xFF00(0006)]珍貴的消息[VAR 0xFF00(0000)]吧！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
