    },
    {
      "ordinal": 8,
      "label": "s2_side02_0005_camera_07",
      "hash64": "46A0FF7C1A9180FC",
      "text": "……[VAR 0x1100(00FF,0101)]你妳看這些照片。[VAR 0x0114(0046)]",
