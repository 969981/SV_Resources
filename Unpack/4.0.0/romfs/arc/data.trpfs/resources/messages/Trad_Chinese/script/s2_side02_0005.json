        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side02_0005_camera_09",
      "hash64": "46A1057C1A918B2E",
      "text": "這裡似乎是帕底亞地區的某個地方，\\n[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳有去過嗎？[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
