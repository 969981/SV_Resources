          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "team_0070_cassiopeia_13",
      "hash64": "54BACAE74487B281",
      "text": "但是，當老大所有人都引退之後，\\n相信真老大就會親自出馬。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
