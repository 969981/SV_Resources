        }
      ]
    },
    {
      "ordinal": 26,
      "label": "team_0070_cassiopeia_12",
      "hash64": "54BAC9E74487B0CE",
      "text": "討厭受到注目的真老大沒有基地，\\n並且一直隱藏著真正的身分。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
