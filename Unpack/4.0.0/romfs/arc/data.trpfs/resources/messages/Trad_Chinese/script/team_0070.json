      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "team_0070_cassiopeia_10",
      "hash64": "54BAC7E74487AD68",
      "text": "這個率領５名老大的神秘人物，\\n真實身分完全不清不楚……[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
