          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "team_0070_legend_01",
      "hash64": "975AD4A280DEB204",
      "text": "啊嘎嘶！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "team_0070_botan_03",
      "hash64": "29E67590A8C5E129",
      "text": "嗚哇哇哇！\\n人家可沒有在問你啊！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "team_0070_botan_04",
      "hash64": "29E67690A8C5E2DC",
      "text": "啊啊啊～……！！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "team_0070_botan_05",
      "hash64": "29E67790A8C5E48F",
      "text": "幕後黑手的存在……\\n人家也從仙后那裡聽說了。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "team_0070_botan_06",
      "hash64": "29E67890A8C5E642",
      "text": "天星隊的創始者，\\n萬惡的根源……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0070_botan_07",
      "hash64": "29E67990A8C5E7F5",
      "text": "不打倒那傢伙的話，\\n人家會失去自己的寶物……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0070_select_03",
      "hash64": "C5B8E79DED5EA3C5",
      "text": "什麼意思？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "team_0070_select_04",
      "hash64": "C5B8E09DED5E97E0",
      "text": "牡丹的寶物？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "team_0070_botan_08",
      "hash64": "29E67A90A8C5E9A8",
      "text": "啊，不是，那個……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
