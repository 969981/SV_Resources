          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "team_0070_botan_09",
      "hash64": "29E67B90A8C5EB5B",
      "text": "呃……報酬！\\n趁人家還沒忘記的時候……拿去吧！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
