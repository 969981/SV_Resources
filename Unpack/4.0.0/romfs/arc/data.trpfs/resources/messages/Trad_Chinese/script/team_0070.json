    },
    {
      "ordinal": 33,
      "label": "team_0070_botan_02",
      "hash64": "29E67490A8C5DF76",
      "text": "呃、呃……\\n[VAR 0x1100(00FF,0101)]你妳在談什麼很重大的話題嗎？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
