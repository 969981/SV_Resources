      "label": "common_1010_friend_09",
      "hash64": "DE58B1E54966C1E0",
      "text": "讓我正式自我介紹吧。我是派帕！\\n喜歡的東西是獒教父和料理……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
