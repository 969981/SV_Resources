      ]
    },
    {
      "ordinal": 17,
      "label": "common_1010_friend_06",
      "hash64": "DE58C0E54966DB5D",
      "text": "她是我請校長介紹的\\n懂高科技的傢伙。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
