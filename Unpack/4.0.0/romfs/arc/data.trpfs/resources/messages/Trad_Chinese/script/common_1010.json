          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_1010_rival_05",
      "hash64": "22F3AC2606CE7658",
      "text": "亮了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_1010_friend_05",
      "hash64": "DE58BDE54966D644",
      "text": "怎麼回事？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_1010_botan_01",
      "hash64": "36AD209F80D93E02",
      "text": "人……人家弄的。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_1010_botan_02",
      "hash64": "36AD1F9F80D93C4F",
      "text": "這裡好像是自動進入了\\n省電模式。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_1010_botan_03",
      "hash64": "36AD1E9F80D93A9C",
      "text": "駭進系統\\n就能強行解除……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_1010_rival_06",
      "hash64": "22F3AF2606CE7B71",
      "text": "啊～！\\n伊布包包毛茸茸的人！！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_1010_botan_04",
      "hash64": "36AD1D9F80D938E9",
      "text": "毛茸……？\\n呃，人家叫牡丹……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_1010_rival_07",
      "hash64": "22F3AE2606CE79BE",
      "text": "我們第一次說話呢！\\n我叫妮莫！是１－Ａ班的！\\r\\n妳對機械很拿手喔！\\r\\n妳喜歡寶可夢對戰嗎！？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_1010_botan_05",
      "hash64": "36AD1C9F80D93736",
      "text": "呃，氣勢好強……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
