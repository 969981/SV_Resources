      "ordinal": 18,
      "label": "common_1010_friend_07",
      "hash64": "DE58BFE54966D9AA",
      "text": "我說這可以幫上[VAR 0x0100(0000)]的忙，\\n她就用光速衝來了。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
