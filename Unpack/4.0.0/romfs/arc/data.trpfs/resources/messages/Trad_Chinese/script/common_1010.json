      "label": "common_1010_friend_08",
      "hash64": "DE58B2E54966C393",
      "text": "妳蠻講義氣的嘛。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
