    {
      "ordinal": 1,
      "label": "common_1010_rival_01",
      "hash64": "22F3B02606CE7D24",
      "text": "哈囉！[VAR 0x0100(0000)]！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
