        }
      ]
    },
    {
      "ordinal": 36,
      "label": "ajito_fairy_040_fairyboss_16",
      "hash64": "1720046E92DD6B90",
      "text": "管家。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "ajito_fairy_040_fairyboss_17",
      "hash64": "1720056E92DD6D43",
      "text": "練鋼琴的時間到了？\\n你是來接我的對吧。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "ajito_fairy_040_fairyboss_18",
      "hash64": "1720126E92DD835A",
      "text": "正好我剛從老大的位子引退了，\\n差不多也該回家……[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "ajito_fairy_040_jentle_02",
      "hash64": "474975A54A121611",
      "text": "……不，\\n我想向少爺介紹一個人。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
