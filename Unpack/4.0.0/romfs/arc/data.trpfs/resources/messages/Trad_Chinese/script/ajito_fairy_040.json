        }
      ]
    },
    {
      "ordinal": 35,
      "label": "ajito_fairy_040_jentle_01",
      "hash64": "474972A54A1210F8",
      "text": "……奧爾迪加少爺。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
