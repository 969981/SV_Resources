    {
      "ordinal": 13,
      "label": "sub_002_trainer_14",
      "hash64": "622783C782EEA496",
      "text": "這次我也很期待[VAR 0x1100(00FF,0101)]你妳的表現喔！\\n永不停歇的挑戰，開始！[VAR 0x0114(0024)]",
      "flags": 0,
