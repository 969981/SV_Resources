        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sub_002_trainer_19",
      "hash64": "622790C782EEBAAD",
      "text": "以最高紀錄為目標，\\n不斷精進吧！[VAR 0x0114(0024)]",
      "flags": 0,
