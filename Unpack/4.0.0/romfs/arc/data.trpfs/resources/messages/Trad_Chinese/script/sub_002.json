    {
      "ordinal": 0,
      "label": "sub_002_trainer_01",
      "hash64": "622B0CC782F1C338",
      "text": "轉學生！[VAR 0x1100(00FF,0101)]你妳贏了莉普了啊！\\n恭喜[VAR 0x1100(00FF,0101)]你妳獲得道館徽章！\\c\\n那傢伙從以前就樣樣能幹，\\n偶爾吞敗仗也是一種良藥！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
