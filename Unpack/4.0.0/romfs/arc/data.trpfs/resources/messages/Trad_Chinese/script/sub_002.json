    {
      "ordinal": 11,
      "label": "sub_002_trainer_12",
      "hash64": "622785C782EEA7FC",
      "text": "朝新紀錄每天精進！\\n嘿呀！來做體操吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
