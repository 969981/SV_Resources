          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_002_trainer_13",
      "hash64": "622786C782EEA9AF",
      "text": "[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳的最高紀錄是……\\n驚人的[VAR 0x0201(0001)]次！[VAR 0x0114(0024)]",
