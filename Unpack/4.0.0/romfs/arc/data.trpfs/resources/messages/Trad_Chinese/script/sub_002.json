          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_002_trainer_15",
      "hash64": "622784C782EEA649",
      "text": "在這裡，道館的及格者也能\\n繼續享受喜怒驚樂體操的樂趣！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sub_002_trainer_16",
      "hash64": "622781C782EEA130",
      "text": "體操分為「基本」和\\n「直到失敗為止」這兩種規則。[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sub_002_trainer_17",
      "hash64": "622782C782EEA2E3",
      "text": "「基本」和道館測驗相同，\\n需要從頭到尾完成體操！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sub_002_trainer_18",
      "hash64": "62278FC782EEB8FA",
      "text": "「直到失敗為止」則是不停地做體操，\\n直到做錯動作為止！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
