            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sub_002_trainer_11",
      "hash64": "622788C782EEAD15",
      "text": "[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳的最高紀錄是……\\n[VAR 0x0201(0001)]次！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
