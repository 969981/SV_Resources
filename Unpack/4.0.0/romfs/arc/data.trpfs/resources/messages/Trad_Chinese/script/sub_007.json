    },
    {
      "ordinal": 2,
      "label": "sub_007_model_03",
      "hash64": "B85949A3158352AF",
      "text": "那麼讓我來看看\\n[VAR 0x0102(0001)]的努力程度喔！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
