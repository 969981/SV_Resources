          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_007_model_05b",
      "hash64": "C303E51D8E1F8611",
      "text": "……嗯！\\n試著再更努力看看！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
