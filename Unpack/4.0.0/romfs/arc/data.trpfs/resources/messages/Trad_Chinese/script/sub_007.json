          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_007_model_04a",
      "hash64": "C300FE1D8E1D7AB5",
      "text": "嗯……哦……這個嘛……\\n沒想到……啊啊……甚至連這種事！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_007_model_04b",
      "hash64": "C300FB1D8E1D759C",
      "text": "嗯嗯……原來如此……\\n啊～……那樣啊……哦……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_007_model_05a",
      "hash64": "C303E21D8E1F80F8",
      "text": "我說[VAR 0x0102(0001)]你呀……\\c\\n真的是非～常努力呢！\\n讓我幫你戴上努力過的證明！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
