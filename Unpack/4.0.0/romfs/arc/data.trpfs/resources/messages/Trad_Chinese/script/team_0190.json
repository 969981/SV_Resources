    },
    {
      "ordinal": 16,
      "label": "team_0190_botan_15",
      "hash64": "5712BA0133B37519",
      "text": "[VAR 0x0100(0000)]，人家會還這個人情。\\n要是有什麼事，儘管說。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
