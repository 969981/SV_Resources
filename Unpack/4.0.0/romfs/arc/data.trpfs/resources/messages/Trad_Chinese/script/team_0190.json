      "ordinal": 0,
      "label": "team_0190_botan_01",
      "hash64": "5716420133B69208",
      "text": "……今天星苦了～[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
