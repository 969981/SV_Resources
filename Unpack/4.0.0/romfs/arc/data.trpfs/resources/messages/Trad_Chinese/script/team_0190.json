          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "team_0190_botan_17",
      "hash64": "5712B80133B371B3",
      "text": "下次[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳傷腦筋的時候，\\n就換人家來幫[VAR 0x1100(00FF,0101)]你妳。[VAR 0x0114(0008)]",
