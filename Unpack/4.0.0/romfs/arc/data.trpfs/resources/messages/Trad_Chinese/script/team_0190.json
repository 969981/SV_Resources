          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "team_0190_botan_02",
      "hash64": "5716450133B69721",
      "text": "這是由創建天星隊的６個成員\\n最初想出的問候方式。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "team_0190_botan_03",
      "hash64": "5716440133B6956E",
      "text": "雖然土到不行，\\n但反而很有味道吧？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "team_0190_botan_04",
      "hash64": "5716470133B69A87",
      "text": "……不當發行ＬＰ的事，\\n人家原本以為會下場慘痛，\\r\\n想不到一下子就被原諒了……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "team_0190_select_01",
      "hash64": "0929CAB11ABC4EBA",
      "text": "太好了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "team_0190_select_02",
      "hash64": "0929C9B11ABC4D07",
      "text": "結果呢？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "team_0190_botan_05",
      "hash64": "5716460133B698D4",
      "text": "他們說只要人家作為寶可夢聯盟的工程師，\\n進行義工活動就能一筆勾銷。\\r\\n還希望人家畢業以後一定要到聯盟去工作。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "team_0190_botan_06",
      "hash64": "5716490133B69DED",
      "text": "校長和那個叫也慈的人\\n也把人家從上到下誇獎了一番，\\r\\n說人家有很棒的才能什麼的……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
