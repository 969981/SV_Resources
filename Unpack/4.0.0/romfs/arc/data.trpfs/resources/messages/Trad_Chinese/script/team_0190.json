          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "team_0190_botan_09",
      "hash64": "57163A0133B68470",
      "text": "人家老是找不到合適的說法，\\n不過……那個……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
