    },
    {
      "ordinal": 8,
      "label": "sdc01_0010_bbteacher_07",
      "hash64": "D367CC83C7899C73",
      "text": "哎呀，抱歉。\\n忘了先自我介紹。我是……[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
