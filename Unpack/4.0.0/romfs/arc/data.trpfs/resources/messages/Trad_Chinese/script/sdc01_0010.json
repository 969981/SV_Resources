      "label": "sdc01_0010_bbteacher_13",
      "hash64": "D36B5883C78CC02E",
      "text": "我正期待著在領隊的同時，\\n還可以順便去進行調查呢。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
