      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0010_bbteacher_14",
      "hash64": "D36B5B83C78CC547",
      "text": "哪天有機會的話，真希望也能讓我\\n好好調查一下帕底亞巨坑裡面啊……[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
