      "ordinal": 13,
      "label": "sdc01_0010_ecology_04",
      "hash64": "4FF117C5AFE05E94",
      "text": "啊，白蕾雅老師。\\n真不好意思～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
