      "ordinal": 18,
      "label": "sdc01_0010_bbteacher_12",
      "hash64": "D36B5983C78CC1E1",
      "text": "在那裡檢測出了和帕底亞地區的\\n太晶化現象相同的能量！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
