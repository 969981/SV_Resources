    {
      "ordinal": 9,
      "label": "sdc01_0010_ecology_01",
      "hash64": "4FF114C5AFE0597B",
      "text": "白蕾雅老師～！\\n抱歉我來晚了～！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
