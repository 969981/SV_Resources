    },
    {
      "ordinal": 40,
      "label": "sdc02_0110_fairybb_05",
      "hash64": "99B2002E37E9DD1C",
      "text": "[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]他她的確很強，\\n但再怎麼說……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
