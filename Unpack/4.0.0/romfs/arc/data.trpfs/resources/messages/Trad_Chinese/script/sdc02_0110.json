      "ordinal": 52,
      "label": "sdc02_0110_dragonbb_24",
      "hash64": "23A6E99E05C9A2FD",
      "text": "２比２啊……[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
