      "label": "sdc02_0110_brother_12",
      "hash64": "21B37E74C277DB51",
      "text": "…………[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
