      "ordinal": 59,
      "label": "sdc02_0110_fairybb_08",
      "hash64": "99B2052E37E9E59B",
      "text": "啊，烏栗！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "sdc02_0110_fairybb_09",
      "hash64": "99B2042E37E9E3E8",
      "text": "杜若！\\n我覺得那是不好的！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "sdc02_0110_dragonbb_27",
      "hash64": "23A6E69E05C99DE4",
      "text": "抱歉啊，[VAR 0x0100(0000)]。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
