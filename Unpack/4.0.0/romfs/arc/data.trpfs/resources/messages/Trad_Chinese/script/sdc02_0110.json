          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "sdc02_0110_dragonbb_21",
      "hash64": "23A6E49E05C99A7E",
      "text": "而且，我們學園\\n注重學生的自主性。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sdc02_0110_dragonbb_22",
      "hash64": "23A6E39E05C998CB",
      "text": "……我們來表決吧。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "sdc02_0110_dragonbb_23",
      "hash64": "23A6E29E05C99718",
      "text": "我當然是舉雙手贊成。\\n……紫竽妳呢？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "sdc02_0110_fairybb_06",
      "hash64": "99B2032E37E9E235",
      "text": "我……對不起，\\n以規則上來說，應該是不行的……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "sdc02_0110_fairybb_07",
      "hash64": "99B2022E37E9E082",
      "text": "赤松呢？[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sdc02_0110_firebb_02",
      "hash64": "2841B4CC8370CD00",
      "text": "啊？我覺得可以啊！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "sdc02_0110_firebb_03",
      "hash64": "2841B5CC8370CEB3",
      "text": "既然人在學園裡，\\n就是這裡的學生對吧！？[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "sdc02_0110_firebb_04",
      "hash64": "2841BACC8370D732",
      "text": "納莉學姐呢！？[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "sdc02_0110_steelbb_02",
      "hash64": "F58398E85D3AC20B",
      "text": "納莉我依照規則，\\n表示反對。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
