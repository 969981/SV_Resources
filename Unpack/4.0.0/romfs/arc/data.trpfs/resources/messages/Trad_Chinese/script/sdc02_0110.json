        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0110_dragonbb_19",
      "hash64": "23AA649E05CCA9D5",
      "text": "什麼嘛，\\n大家盡說些冷淡的話！[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
