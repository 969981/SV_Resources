    },
    {
      "ordinal": 34,
      "label": "sdc02_0110_dragonbb_17",
      "hash64": "23AA669E05CCAD3B",
      "text": "我們已經是\\n小手拉小手的好朋友囉！[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
