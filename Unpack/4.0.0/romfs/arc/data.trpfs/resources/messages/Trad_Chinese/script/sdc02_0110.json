    },
    {
      "ordinal": 38,
      "label": "sdc02_0110_steelbb_01",
      "hash64": "F58399E85D3AC3BE",
      "text": "他校學生參加藍莓聯盟。\\n……史無前例。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
