          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "sdc02_0110_dragonbb_20",
      "hash64": "23A6E59E05C99C31",
      "text": "[VAR 0x1100(00FF,0101)]他她在我們學園上課，\\n在宿舍也有[VAR 0x1100(00FF,0101)]他她自己的房間！\\r\\n這樣還不算是同一個學園的夥伴嗎！？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
