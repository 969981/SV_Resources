      "ordinal": 57,
      "label": "sdc02_0110_dragonbb_26",
      "hash64": "23A6E79E05C99F97",
      "text": "嘿嘿……有結論了。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
