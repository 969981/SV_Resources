          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_kusa_sp03_03",
      "hash64": "11CD12CD595FC403",
      "text": "讓我忍不住沉浸在愉悅裡，\\n上上下下了好幾次！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
