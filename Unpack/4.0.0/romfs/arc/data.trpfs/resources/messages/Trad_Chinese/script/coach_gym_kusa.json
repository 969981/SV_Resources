      "label": "coach_gym_kusa_sp03_01",
      "hash64": "11CD14CD595FC769",
      "text": "實在是前衛！！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
