    {
      "ordinal": 33,
      "label": "coach_gym_kusa_trade_01_02",
      "hash64": "A2CAF1BF4E5139B6",
      "text": "閣下要和我來一次\\n充滿藝術氣息的寶可夢交換嗎？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
