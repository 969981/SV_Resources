      "hash64": "EB651E4CF38C48F8",
      "text": "真棒！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_gym_kusa_sp03_select_02",
      "hash64": "EB65214CF38C4E11",
