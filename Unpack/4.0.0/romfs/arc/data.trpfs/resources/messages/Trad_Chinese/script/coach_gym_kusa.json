          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_gym_kusa_trade_01_03",
      "hash64": "A2CAF2BF4E513B69",
      "text": "Yes！[VAR 0x0100(0000)]前衛！\\n我要送出向日花怪！\\r\\n閣下要選擇哪一隻寶可夢！？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
