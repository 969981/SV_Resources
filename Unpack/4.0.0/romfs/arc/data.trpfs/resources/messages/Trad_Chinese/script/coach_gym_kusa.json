          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_kusa_sp03_02",
      "hash64": "11CD11CD595FC250",
      "text": "那些像是團珠蛛吐出的\\n絲一樣的物體\\r\\n還兼具了電梯的功能！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
