            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "coach_gym_kusa_battleend_win_01_00",
      "hash64": "AE478101CDB0DAAC",
      "text": "哈～哈哈哈！\\n我輸得真有藝術氣息啊！\\c\\n在把我當成養分吸收的同時，\\n把這個也帶走吧！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_gym_kusa_battleend_win_01_01",
      "hash64": "AE478201CDB0DC5F",
      "text": "靈感不停湧上……\\n讓我暫時沉浸在餘韻之中吧！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_gym_kusa_battleend_lose_00_00",
      "hash64": "A0955EEA7006A9B0",
      "text": "這次是閣下成為了我的養分！\\c\\n有時敗北也能成為\\n培育藝術的肥料！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_gym_kusa_randomtalk_00",
      "hash64": "1FDAFE1F72B4C8A3",
      "text": "這個學園的校舍\\n設計非常不錯。\\r\\n真想知道設計師的名字是什麼。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_kusa_randomtalk_01",
      "hash64": "1FDAFD1F72B4C6F0",
      "text": "無論是對戰還是藝術，\\n都不會只有開心的事。\\c\\n但是千萬不可放棄。\\n一旦放棄掙扎，就只有枯萎一途。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_gym_kusa_randomtalk_02",
      "hash64": "1FDB001F72B4CC09",
      "text": "在學院裡，阿朔的課\\n想上多少次都行對吧？\\c\\n閣下要意識到這是件多麼幸運的事，\\n好好地走接下來的人生之路啊。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_gym_kusa_randomtalk_03",
      "hash64": "1FDAFF1F72B4CA56",
      "text": "閣下託付給我的[VAR 0x0101(0001)]\\n實在是前衛。\\r\\n讓我想在有朝一日製作牠的雕塑啊。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_gym_kusa_randomtalk_04",
      "hash64": "1FDB021F72B4CF6F",
      "text": "我託付給閣下的向日花怪\\n過得還平安嗎？\\c\\n記得給牠充足的陽光\\n還有水分啊。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "coach_gym_kusa_randomtalk_sp",
      "hash64": "20AACC1F7365C2E8",
      "text": "前些日子首席冠軍\\n悄悄告訴了我一件事。\\c\\n她說閣下最喜歡的\\n道館館主就是我！！\\c\\n能夠滿足[VAR 0x0100(0000)]前衛的審美眼光，\\n那我可算是得償所願了！！\\c\\n下次就讓我們以「感謝」為主題\\n來共同創作吧！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
