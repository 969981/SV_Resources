          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_gym_kusa_sp02_05b",
      "hash64": "267C25FFF1A1491E",
      "text": "是嗎！\\n不知道的話，就讓我告訴閣下吧！！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_kusa_sp02_02",
      "hash64": "BA20EBC5BCE0A2ED",
      "text": "那傢伙能以蟲寶可夢為主題，\\n畫出深具妙趣的畫作。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_kusa_sp02_03",
      "hash64": "BA20EAC5BCE0A13A",
      "text": "將一種屬性昇華成藝術……\\n這種感性與我相似，所以我很感興趣。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_kusa_sp02_04",
      "hash64": "BA20E5C5BCE098BB",
      "text": "據說那傢伙的工作室在飛雲市，\\n回程時我就順便去看看吧。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_kusa_sp03_00",
      "hash64": "11CD13CD595FC5B6",
      "text": "之前跟閣下說過的\\n飛雲市的藝術家！\\r\\n我去了一趟那傢伙的工作室之後發現……[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
