          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_gym_kusa_trade_01_04",
      "hash64": "A2CAF3BF4E513D1C",
      "text": "竟然是[VAR 0x0101(0001)]，真有意思！\\n我的靈感整個湧上來了！\\r\\n感謝閣下的審美眼光！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
