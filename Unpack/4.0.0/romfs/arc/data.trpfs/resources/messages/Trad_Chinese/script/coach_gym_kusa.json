          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_gym_kusa_trade_04_00",
      "hash64": "71927D95957453C5",
      "text": "閣下果然還是想要\\n交換寶可夢是嗎？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "coach_gym_kusa_talkto_00",
      "hash64": "B7391A7E53993839",
      "text": "離上課還有一些時間，\\n和我一起創作名為對戰的藝術如何？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "coach_gym_kusa_cancel_00",
      "hash64": "6A2CFDDEDDA86E6A",
      "text": "要是沒興致的話就算了，\\n我不會勉強閣下的。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "coach_gym_kusa_battlestart_00",
      "hash64": "ABAAB20995052AC0",
      "text": "好！讓我們帶著藝術氣息\\n移動到外面去吧！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "coach_gym_kusa_battlestart_01",
      "hash64": "ABAAB30995052C73",
      "text": "[EMPTY 61]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
