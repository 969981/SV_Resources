    },
    {
      "ordinal": 36,
      "label": "coach_gym_kusa_trade_02_00",
      "hash64": "D08479C5B12C06FF",
      "text": "閣下要用[VAR 0x0101(0001)]\\n來交換我的向日花怪是吧？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
