      "ordinal": 1,
      "label": "sdc02_0340_bbteacher_01",
      "hash64": "27CFCE8BC7D5A360",
      "text": "大家都沒事吧！？[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
