          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0070_top_07",
      "hash64": "ED5B57300D1EFED2",
      "text": "我叫也慈，\\n是負責營運寶可夢道館的\\r\\n寶可夢聯盟的會長。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
