          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0070_top_05a",
      "hash64": "712CCDA64BA49717",
      "text": "我聽到了很好的答案。\\n不可多得的年輕才華……\\r\\n請[VAR 0x1100(00FF,0101)]你妳以更高的境界為目標精進吧。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
