    {
      "ordinal": 8,
      "label": "champ_0070_top_08",
      "hash64": "ED5B5A300D1F03EB",
      "text": "如果[VAR 0x1100(00FF,0101)]你妳正在收集道館徽章的路上，\\n我們將會在這條路的彼端再次相遇。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
