          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0070_top_05b",
      "hash64": "712CCEA64BA498CA",
      "text": "什麼，這樣啊。\\n不可多得的年輕才華……\\r\\n以[VAR 0x1100(00FF,0101)]你妳的實力，那真是太可惜了。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
