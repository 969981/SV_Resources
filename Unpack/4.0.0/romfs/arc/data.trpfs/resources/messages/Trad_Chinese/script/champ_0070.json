    {
      "ordinal": 3,
      "label": "champ_0070_top_04",
      "hash64": "ED5B56300D1EFD1F",
      "text": "[VAR 0x1100(00FF,0101)]你妳也是以成為冠軍為目標嗎？[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
