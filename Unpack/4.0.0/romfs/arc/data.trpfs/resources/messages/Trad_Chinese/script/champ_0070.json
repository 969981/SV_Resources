    },
    {
      "ordinal": 6,
      "label": "champ_0070_top_06",
      "hash64": "ED5B58300D1F0085",
      "text": "抱歉，我還沒自我介紹。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
