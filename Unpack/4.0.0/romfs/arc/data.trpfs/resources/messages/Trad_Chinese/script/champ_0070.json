    {
      "ordinal": 2,
      "label": "champ_0070_top_03",
      "hash64": "ED5B53300D1EF806",
      "text": "我記得[VAR 0x1100(00FF,0101)]你妳的名字叫……\\n[VAR 0x0100(0000)]。[VAR 0x0114(002C)]",
