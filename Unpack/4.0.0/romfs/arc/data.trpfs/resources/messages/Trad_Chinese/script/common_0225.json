      "hash64": "B93CA51B98593B6E",
      "text": "什麼！？啊，抱歉！\\n是我誤會了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
