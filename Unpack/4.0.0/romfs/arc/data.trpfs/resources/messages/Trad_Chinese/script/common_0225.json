      "ordinal": 14,
      "label": "common_0225_sitappa_a_06",
      "hash64": "37B1802F7B043542",
      "text": "就是說啊！\\n你盯好原先那個戴眼鏡的！[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
