        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0000_select_01",
      "hash64": "BF719182D239233B",
      "text": "很不得了喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0000_select_02",
