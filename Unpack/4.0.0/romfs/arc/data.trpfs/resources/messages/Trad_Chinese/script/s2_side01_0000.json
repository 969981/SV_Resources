    {
      "ordinal": 0,
      "label": "s2_side01_0000_system_01",
      "hash64": "E9778D61F010DAE0",
      "text": "在各式各樣的雜貨中\\n混雜著一件蒙著灰塵的擺飾！\\r\\n……聞起來極其香甜！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
