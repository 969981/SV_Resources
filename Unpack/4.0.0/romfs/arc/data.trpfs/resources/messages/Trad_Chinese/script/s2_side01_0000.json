      "text": "也還好啦",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0000_friend_03",
      "hash64": "A84FD98B63CAAF95",
      "text": "嘿～真好～！\\n真可惜我沒能一起去！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
