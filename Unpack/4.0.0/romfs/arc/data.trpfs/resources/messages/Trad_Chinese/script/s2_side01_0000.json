      "ordinal": 15,
      "label": "s2_side01_0000_friend_09",
      "hash64": "A84FDF8B63CAB9C7",
      "text": "真的假的！太好了！\\n秒答歡迎派！我太高興啦！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
