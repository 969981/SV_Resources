          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0000_friend_02",
      "hash64": "A84FD88B63CAADE2",
      "text": "我聽說囉，[VAR 0x1100(00FF,0101)]你妳這傢伙！\\n聽說[VAR 0x1100(00FF,0101)]你妳在夏令營和交換留學的時候\\r\\n都來了場大冒險！……是吧！？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
