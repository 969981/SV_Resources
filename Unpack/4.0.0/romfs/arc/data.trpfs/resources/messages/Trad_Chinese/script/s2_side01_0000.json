          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_side01_0000_system_02",
      "hash64": "E9779061F010DFF9",
      "text": "擺飾看起來好像\\n微微動了一下……？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_side01_0000_system_03",
      "hash64": "E9778F61F010DE46",
      "text": "洛托洛托洛托……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_side01_0000_friend_01",
      "hash64": "A84FD78B63CAAC2F",
      "text": "[VAR 0x0100(0000)]！\\n喲！是我，派帕啦！[VAR 0x0114(0006)]",
