      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_side01_0120_select_02",
      "hash64": "CBCBD95F41F65A57",
      "text": "你們沒事吧！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0120_friend_02",
      "hash64": "74E9E95E9C053327",
      "text": "啊……那個……\\n不好意思電話突然斷了。\\r\\n……你們一定以為我們出事了吧。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
