      "ordinal": 14,
      "label": "s2_side01_0120_friend_07",
      "hash64": "74E9E45E9C052AA8",
      "text": "哇啊！？上面！！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
