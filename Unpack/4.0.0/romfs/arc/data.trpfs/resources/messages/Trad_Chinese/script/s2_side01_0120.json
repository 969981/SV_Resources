    },
    {
      "ordinal": 12,
      "label": "s2_side01_0120_brother_03",
      "hash64": "F9277AADA6D1FAEE",
      "text": "話說回來，我……\\n說不定知道為什麼\\r\\n……村子的人會變奇怪了。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
