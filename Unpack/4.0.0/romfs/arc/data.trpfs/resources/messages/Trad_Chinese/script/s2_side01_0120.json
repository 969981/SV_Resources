      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0120_friend_06",
      "hash64": "74E9E55E9C052C5B",
      "text": "好啦好啦。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
