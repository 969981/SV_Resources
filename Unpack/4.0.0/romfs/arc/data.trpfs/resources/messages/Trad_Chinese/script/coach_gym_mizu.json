          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_mizu_sp02_04b",
      "hash64": "31F61B0012B09FAE",
      "text": "雖說偶爾吃點垃圾食物也沒關係，\\n但每餐都吃可是會營養失調的！[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_mizu_sp02_05",
      "hash64": "5DAF5BED2B0100AB",
      "text": "學生們等著吧！\\n食堂就是小魚仔成群出沒的漁場！\\r\\n海岱俱樂部要開始營業啦！[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_mizu_sp03_00",
      "hash64": "060394E58E8282B5",
      "text": "哦哦！告訴[VAR 0x1100(00FF,0101)]你妳一件事，\\n保證[VAR 0x1100(00FF,0101)]你妳聽了嚇一跳！[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
