      "ordinal": 30,
      "label": "coach_gym_mizu_trade_01_02",
      "hash64": "DE6D1A2A49C40E7D",
      "text": "不如我們就順著這股勁頭，\\n來交換寶可夢吧！？[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
