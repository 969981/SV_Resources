          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_mizu_sp03_01",
      "hash64": "060393E58E828102",
      "text": "藍莓學園的學生食堂\\n和海岱俱樂部……\\r\\n決定要聯手合作啦！[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
