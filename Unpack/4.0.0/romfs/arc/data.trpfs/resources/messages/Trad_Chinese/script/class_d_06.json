      ]
    },
    {
      "ordinal": 9,
      "label": "class_d_06_language_07",
      "hash64": "F1C42398E7E45406",
      "text": "Today，我們會更深入了解\\n寶可夢的語言喔！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
