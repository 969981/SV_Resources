    },
    {
      "ordinal": 19,
      "label": "class_d_06_language_answer_02",
      "hash64": "A5B86C79282F5DE4",
      "text": "噹噹噹！[VAR 0x0100(0000)]！\\nSuper duper正確答案！真厲害啊～！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
