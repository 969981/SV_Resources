        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_d_06_language_08",
      "hash64": "F1C42E98E7E466B7",
      "text": "Please！\\n皮卡丘！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
