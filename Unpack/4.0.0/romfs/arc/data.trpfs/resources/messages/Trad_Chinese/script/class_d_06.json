      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_d_06_language_09",
      "hash64": "F1C42D98E7E46504",
      "text": "好像有點沒活力？\\n聲音聽起來也似乎比較低沉呢！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
