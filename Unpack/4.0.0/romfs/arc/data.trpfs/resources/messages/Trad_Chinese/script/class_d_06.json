      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_d_06_language_03",
      "hash64": "F1C42798E7E45AD2",
      "text": "連回答都很優秀！\\n各位果然是我傑出的學子們～！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
