    {
      "ordinal": 7,
      "label": "class_d_06_poke_01",
      "hash64": "0864E03253BE2119",
      "text": "皮卡丘！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_d_06_language_06",
      "hash64": "F1C42498E7E455B9",
      "text": "正如我們上一堂課所學的，\\n即使是相同寶可夢，\\r\\n也會視情況用不同的聲音來表達，對吧！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
