          "args_hex": [
            "003E"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_teacher_battle_battleend_win_01_00",
      "hash64": "A239ACE353D2D7D9",
      "text": "今天的对战也很棒哦！\\n转学生，谢谢你！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_teacher_battle_battleend_win_01_01",
      "hash64": "A239ABE353D2D626",
      "text": "下次别想像这次一样哦！\\n让我们朝着夕阳嘿呀吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_teacher_battle_battleend_lose_00_00",
      "hash64": "884CAC292CE7905B",
      "text": "这次是我赢了！\\n我保住了对战学老师的面子！\\c\\n你就看着大海，\\n吞下输掉的不甘心吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_teacher_battle_randomtalk_00",
      "hash64": "99851A61ABA5B89A",
      "text": "联盟社的活动室里\\n挤满了年轻人，\\r\\n真是青春气息爆棚呀！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_teacher_battle_randomtalk_01",
      "hash64": "99851B61ABA5BA4D",
      "text": "其实啊，\\n我有些害怕坐飞机……\\c\\n所以来蓝莓学园对我来说，\\n是非常需要气势的一件事！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_teacher_battle_randomtalk_02",
      "hash64": "99851861ABA5B534",
      "text": "在对战中也是\\n可以锻炼身体的！\\c\\n下次对战时就看看我吧！\\n我就是靠那个动作来提升心肺功能的！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "coach_teacher_battle_randomtalk_03",
      "hash64": "99851961ABA5B6E7",
      "text": "转学生的[VAR 0x0101(0001)]\\n今天也充满活力！\\c\\n我做的三明治\\n它也吃得津津有味哦！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "coach_teacher_battle_randomtalk_04",
      "hash64": "99851661ABA5B1CE",
      "text": "我交换给你的玛沙那最近如何！？\\n那孩子是拳击高手！\\c\\n无论敌人有多强，\\n它都会用各种各样的拳击将对方击碎！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
