{
  "version": "4.0.0",
  "language": "zh-Hans",
  "language_raw": "Simp_Chinese",
  "source": "message/dat/Simp_Chinese/script/sub_016.dat",
  "paired_tbl": "message/dat/Simp_Chinese/script/sub_016.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_016_system_kui_01",
      "hash64": "4C38F1CE9AE28A93",
      "text": "这里埋着漆黑且\\n充满不祥气息的桩子……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_016_system_kui_02",
      "hash64": "4C38F2CE9AE28C46",
      "text": "要把桩子拔出来吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_016_system_kui_03",
      "hash64": "4C38F3CE9AE28DF9",
      "text": "桩子被拔出后，\\n崩裂成碎屑消失了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_016_system_kui_04",
      "hash64": "4C38F4CE9AE28FAC",
      "text": "咕……唏……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_016_system_kui_05",
      "hash64": "4C38F5CE9AE2915F",
      "text": "从祠的方向传来了\\n神秘的声音……！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_016_system_release_01",
      "hash64": "0D38A4AA29FEC449",
      "text": "祠里传出\\n微弱的声音……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_016_system_release_02",
      "hash64": "0D38A1AA29FEBF30",
      "text": "要触摸祠吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_016_system_release_03",
      "hash64": "0D38A2AA29FEC0E3",
      "text": "咔嗒咔嗒　咔嗒咔嗒……\\n喀哒喀哒喀哒　喀哒喀哒！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_016_system_release_07",
      "hash64": "0D38A6AA29FEC7AF",
      "text": "嘎哒～！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_016_system_release_04",
      "hash64": "0D38A7AA29FEC962",
      "text": "咕唏咕唏！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_016_system_release_05",
      "hash64": "0D38A8AA29FECB15",
      "text": "古简蜗被再次\\n封印在祠里了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_016_system_release_06",
      "hash64": "0D38A5AA29FEC5FC",
      "text": "看起来祠的门\\n暂时不会打开了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_016_system_hokora_01",
      "hash64": "5E2F0FED1EB3D91C",
      "text": "祠里刻着\\n模糊的文字……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_016_system_hokora_02",
      "hash64": "5E2F12ED1EB3DE35",
      "text": "灾祸之简封印于此",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_016_system_hokora_03",
      "hash64": "5E2F11ED1EB3DC82",
      "text": "灾祸之简封印已解",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
