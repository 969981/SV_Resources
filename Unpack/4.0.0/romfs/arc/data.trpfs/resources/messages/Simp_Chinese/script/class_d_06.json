      "hash64": "F1C42598E7E4576C",
      "text": "亲爱的同学们！\\n你们心情都还美丽吗～？[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
