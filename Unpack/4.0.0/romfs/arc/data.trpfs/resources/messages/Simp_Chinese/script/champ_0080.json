    {
      "ordinal": 0,
      "label": "champ_0080_dragon_01",
      "hash64": "0B870AB70EFDD96D",
      "text": "这不是[VAR 0x0100(0000)]吗？[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
