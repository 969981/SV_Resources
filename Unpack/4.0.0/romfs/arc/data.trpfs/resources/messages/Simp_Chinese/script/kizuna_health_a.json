      "ordinal": 0,
      "label": "kizuna_health_a_01",
      "hash64": "AA92AE6193547E02",
      "text": "欢迎来到\\n米莫莎的医务室～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
