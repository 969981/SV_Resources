          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "sdc01_0485_bbteacher_11",
      "hash64": "724C1794136385C2",
      "text": "让我们一起\\n给管理员道谢吧！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
