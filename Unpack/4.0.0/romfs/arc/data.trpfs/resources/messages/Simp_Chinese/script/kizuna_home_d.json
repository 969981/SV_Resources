      "hash64": "CDB47B6DB9FA29AC",
      "text": "[VAR 0x0100(0000)]，\\n关于上次那件事……[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
