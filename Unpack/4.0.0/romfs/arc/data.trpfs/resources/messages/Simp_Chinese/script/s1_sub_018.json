          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_018_woman_npc",
      "hash64": "4173059D9564CBB3",
      "text": "相亲相爱的动作……\\n跟别人一起摆摆看吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s1_sub_018_man_npc",
      "hash64": "89644607171F7931",
      "text": "无论是人还是宝可梦，\\n都充满着爱意呀。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
