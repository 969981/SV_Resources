      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "common_2050_select_07",
      "hash64": "9C12C8E034814281",
      "text": "莱姆",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "common_2050_select_08",
      "hash64": "9C12C1E03481369C",
