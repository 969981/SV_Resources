    {
      "ordinal": 0,
      "label": "sdc02_4kings_a_01_clerk_00",
      "hash64": "D29BD9253506E37B",
      "text": "你可以自由参观\\n四天王小队～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_a_01_clerk_01",
      "hash64": "D29BD8253506E1C8",
      "text": "这里是草原广场，\\n四天王赤松的小队欢迎你来！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_a_01_clerk_02",
      "hash64": "D29BDB253506E6E1",
      "text": "你是蓝莓联盟的挑战者\\n……[VAR 0x0100(0000)]，没错吧？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_a_01_clerk_03",
      "hash64": "D29BDA253506E52E",
      "text": "参加四天王挑战\\n需要支付５０ＢＰ！\\r\\n你愿意支付吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_01_clerk_04",
      "hash64": "D29BDD253506EA47",
      "text": "那个～\\n你的ＢＰ好像不够啊……\\r\\n参加蓝乐活来获得ＢＰ吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_01_system_01",
      "hash64": "62E99FF70BADB89A",
      "text": "[VAR 0x0100(0000)]支付了\\n５０ＢＰ！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_01_clerk_05",
      "hash64": "D29BDC253506E894",
      "text": "非常感谢！\\n已确认收到！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
