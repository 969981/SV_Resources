          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_kusa_010_kusa_04",
      "hash64": "5570C2F19675A016",
      "text": "我一再地回想起我们\\n那充满艺术性的对战，\\r\\n满心渴望能与阁下再次相会。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_kusa_010_kusa_05",
      "hash64": "5570C3F19675A1C9",
      "text": "很高兴阁下能来找我！\\n感谢宛如母亲的大自然……！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_kusa_010_kusa_06",
      "hash64": "5570C0F196759CB0",
      "text": "我稍后本来是和首席冠军有约，\\n但我要取消这个计划！\\r\\n要不要和我畅谈一下艺术？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_kusa_010_kusa_07",
      "hash64": "5570C1F196759E63",
      "text": "怎么，原来阁下是代替\\n首席冠军来的啊！也好！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_kusa_010_kusa_08",
      "hash64": "5570CEF19675B47A",
      "text": "只要能再次与阁下合作，\\n是什么理由都无所谓！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_kusa_010_kusa_09",
      "hash64": "5570CFF19675B62D",
      "text": "那么，[VAR 0x0100(0000)]，\\n准备好打开艺术之门了吧？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
