      "label": "common_2020_kusa_010_kusa_10",
      "hash64": "55744CF19678C06B",
      "text": "真是前卫艺术！\\n那我们就去工作室吧。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
