    {
      "ordinal": 4,
      "label": "atlantis_talk_07_botan_03",
      "hash64": "163D48759661A127",
      "text": "呃～！你快去医务室\\n检查一下你的感情吧。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
