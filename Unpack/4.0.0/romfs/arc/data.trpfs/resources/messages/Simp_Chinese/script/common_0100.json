    {
      "ordinal": 1,
      "label": "common_0100_rival_11",
      "hash64": "52924E3E0601C73C",
      "text": "我们的冒险\\n就从这条路开始！\\c\\n和城镇不同，\\n道路和草丛\\r\\n会出现野生的宝可梦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
