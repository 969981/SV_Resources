    },
    {
      "ordinal": 5,
      "label": "sdc02_0300_bbteacher_04",
      "hash64": "42B5825C06A35B7B",
      "text": "不过，你现在能当场展示一下\\n太乐巴戈斯的实力吗？[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
