      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0300_brother_02",
      "hash64": "F08C2AEE9388FEF1",
      "text": "……[VAR 0x0100(0000)]，你听见了吧？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
