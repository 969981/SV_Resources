    {
      "ordinal": 2,
      "label": "sdc02_0300_bbteacher_01",
      "hash64": "42B5855C06A36094",
      "text": "干得漂亮，乌栗！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
