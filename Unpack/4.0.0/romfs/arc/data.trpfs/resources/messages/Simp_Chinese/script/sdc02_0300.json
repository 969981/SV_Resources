        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0300_bbteacher_03",
      "hash64": "42B5875C06A363FA",
      "text": "这样随时都可以\\n研究太乐巴戈斯了……[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
