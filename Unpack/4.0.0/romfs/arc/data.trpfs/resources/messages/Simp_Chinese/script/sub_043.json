    {
      "ordinal": 0,
      "label": "sub_043_picnicnpc_system_01",
      "hash64": "2E948E3A4B50B1D3",
      "text": "[VAR 0x0100(0000)]\\n获得了[VAR 0xFF00(0008)]各种食材[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
