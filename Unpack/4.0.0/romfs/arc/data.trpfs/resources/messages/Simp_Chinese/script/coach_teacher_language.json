    },
    {
      "ordinal": 64,
      "label": "coach_teacher_language_randomtalk_01",
      "hash64": "B01600B72F24CBC1",
      "text": "赛吉我出差的时候，\\n都是我班上的students\\r\\n在帮我照顾布拨！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
