    {
      "ordinal": 0,
      "label": "coach_teacher_language_first_00",
      "hash64": "F507D98D230335BB",
      "text": "蓝莓学园的同学们！\\n你们真会问候人！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
