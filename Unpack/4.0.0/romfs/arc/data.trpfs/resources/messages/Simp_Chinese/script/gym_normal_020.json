    {
      "ordinal": 34,
      "label": "gym_normal_030_shop_00",
      "hash64": "04CA2005066AAA90",
      "text": "你是参加道馆测验的客人吧！\\n宝食堂秘密菜单的提示，\\r\\n你都收集到了吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_normal_030_shop_01",
      "hash64": "04CA2105066AAC43",
      "text": "……那么，请点菜。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
