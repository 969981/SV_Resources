      "hash64": "7B3D7DADF77F0DF6",
      "text": "[VAR 0x0100(0000)]！\\n[VAR 0x0100(0000)]！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
