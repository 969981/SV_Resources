      "ordinal": 0,
      "label": "class_d_07_language_01",
      "hash64": "F78081D5B9B474EB",
      "text": "亲爱的同学们！\\n大家状态如何呀？[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
