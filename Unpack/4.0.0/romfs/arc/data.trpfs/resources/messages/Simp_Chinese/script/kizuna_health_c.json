          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_health_c_11",
      "hash64": "D7BCFE747938AB9D",
      "text": "……不过，也许稍微\\n有一点点影响吧！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_health_c_12",
      "hash64": "D7BCFB747938A684",
      "text": "所以……\\n我有点感谢[VAR 0x1100(00FF,0101)]他她……[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
