      "hash64": "D7C06274793B8B60",
      "text": "啊，[VAR 0x0100(0000)]。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
