    },
    {
      "ordinal": 53,
      "label": "coach_gym_mizu_randomtalk_01",
      "hash64": "0AC0F29213BEA483",
      "text": "在生态巨蛋中\\n坚强绽放的花儿！\\r\\n多么宝贵的存在呀……！[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
