            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_normal_040_gym_receptionist_01",
      "hash64": "E493BA44D381D951",
      "text": "[VAR 0x0100(0000)]，\\n欢迎你来到锦汇道馆。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_normal_040_gym_receptionist_02",
      "hash64": "E493B744D381D438",
      "text": "想要挑战道馆馆主青木的话，\\n就请和宝食堂的店员说一声吧。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_normal_040_receptionist_00",
      "hash64": "0EB8253E4E40262A",
      "text": "[VAR 0x0100(0000)]，欢迎你来到\\n锦汇道馆的后援店，宝食堂！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_normal_040_receptionist_01",
      "hash64": "0EB8263E4E4027DD",
      "text": "超凡脱俗上班族青木……\\n要挑战这个道馆馆主吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_normal_040_receptionist_02",
      "hash64": "0EB8233E4E4022C4",
      "text": "那么，请进入对战场。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_normal_040_receptionist_03",
      "hash64": "0EB8243E4E402477",
      "text": "等你准备好了，\\n随时都可以告诉我。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_normal_040_receptionist_05",
      "hash64": "0EB8223E4E402111",
      "text": "青木～！\\n上场啦～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_normal_040_normal_01",
      "hash64": "E4ECB2AC02E1AAE5",
      "text": "你好。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_normal_040_normal_02",
      "hash64": "E4ECAFAC02E1A5CC",
      "text": "我是被分配到锦汇道馆的\\n道馆馆主青木。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_normal_040_normal_03",
      "hash64": "E4ECB0AC02E1A77F",
      "text": "道馆测验辛苦了。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_normal_040_normal_04",
      "hash64": "E4ECADAC02E1A266",
      "text": "话说……这家店\\n烤饭团之外的东西也很好吃。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_normal_040_normal_05",
      "hash64": "E4ECAEAC02E1A419",
      "text": "闲聊太多的话\\n会惹我的上司发火的，\\r\\n赶快开始对战吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_normal_040_normal_06",
      "hash64": "E4ECABAC02E19F00",
      "text": "你好，我是青木。\\n请多多指教。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_normal_040_normal_07",
      "hash64": "E4ECACAC02E1A0B3",
      "text": "你真是非同寻常地厉害啊。\\n这不禁让我的表情都消失了。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_normal_040_normal_08",
      "hash64": "E4ECB9AC02E1B6CA",
      "text": "既然我输了，\\n我就会把徽章给你……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_normal_040_normal_09",
      "hash64": "E4ECBAAC02E1B87D",
      "text": "不过……对战后我饿了。\\n要不要和我一起去吃顿饭？[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_normal_040_normal_badge",
      "hash64": "3B461CE2FFA60749",
      "text": "有[VAR 0x0200(0001)]个道馆徽章的话，\\n等级[VAR 0x0201(0002)]以下的宝可梦会更容易捉到……\\r\\n而且也会听你的话。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_normal_040_normal_badge_all",
      "hash64": "36909BBFC4BE01F9",
      "text": "有８个道馆徽章的话，\\n不管是什么样的宝可梦都能捉到，\\r\\n而且它们应该不会违背你的指示吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_normal_040_normal_10",
      "hash64": "E4F037AC02E4C2BB",
      "text": "这里的菜味道不错，\\n很好吃。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_normal_040_normal_waza",
      "hash64": "8A8AE8E413551DA3",
      "text": "虽然像你这样有精神的孩子\\n似乎不需要这个，但也请你收下吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_normal_040_normal_11",
      "hash64": "E4F036AC02E4C108",
      "text": "饭钱就算了，我好歹是个大人，\\n怎么能让小孩掏钱……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_normal_040_normal_12",
      "hash64": "E4F039AC02E4C621",
      "text": "那么，再见了。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_normal_040_receptionist_04",
      "hash64": "0EB8213E4E401F5E",
      "text": "恭喜！\\n你突破了锦汇道馆！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "gym_normal_040_normal_npc",
      "hash64": "81F01A478E5F110D",
      "text": "嚼啊嚼……\\n咽啊咽……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    }
  ]
}
