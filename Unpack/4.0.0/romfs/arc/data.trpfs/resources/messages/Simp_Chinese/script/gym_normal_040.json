  "entries": [
    {
      "ordinal": 0,
      "label": "gym_normal_040_kari_message_01",
      "hash64": "037A8BFAA0BE01FB",
      "text": "[EMPTY 25]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
