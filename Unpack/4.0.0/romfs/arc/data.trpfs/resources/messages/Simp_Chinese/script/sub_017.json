{
  "version": "4.0.0",
  "language": "zh-Hans",
  "language_raw": "Simp_Chinese",
  "source": "message/dat/Simp_Chinese/script/sub_017.dat",
  "paired_tbl": "message/dat/Simp_Chinese/script/sub_017.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_017_system_kui_01",
      "hash64": "9AE43EF6D8FB58EC",
      "text": "这里埋着漆黑且\\n充满不祥气息的桩子……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_017_system_kui_02",
      "hash64": "9AE441F6D8FB5E05",
      "text": "要把桩子拔出来吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_017_system_kui_03",
      "hash64": "9AE440F6D8FB5C52",
      "text": "桩子被拔出后，\\n崩裂成碎屑消失了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_017_system_kui_04",
      "hash64": "9AE43BF6D8FB53D3",
      "text": "咕……吁……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_017_system_kui_05",
      "hash64": "9AE43AF6D8FB5220",
      "text": "从祠的方向传来了\\n神秘的声音……！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_017_system_release_01",
      "hash64": "7540343DC23ACBCA",
      "text": "祠里传出\\n微弱的声音……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_017_system_release_02",
      "hash64": "7540333DC23ACA17",
      "text": "要触摸祠吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_017_system_release_03",
      "hash64": "7540323DC23AC864",
      "text": "咔嗒咔嗒　咔嗒咔嗒……\\n喀哒喀哒喀哒　喀哒喀哒！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_017_system_release_07",
      "hash64": "75402E3DC23AC198",
      "text": "嘎哒～！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_017_system_release_04",
      "hash64": "7540313DC23AC6B1",
      "text": "咕吁咕吁～",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_017_system_release_05",
      "hash64": "7540303DC23AC4FE",
      "text": "古玉鱼被再次\\n封印在祠里了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_017_system_release_06",
      "hash64": "75402F3DC23AC34B",
      "text": "看起来祠的门\\n暂时不会打开了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_017_system_hokora_01",
      "hash64": "81FC49FF6742A6ED",
      "text": "祠里刻着\\n模糊的文字……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_017_system_hokora_02",
      "hash64": "81FC46FF6742A1D4",
      "text": "灾祸之玉封印于此",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_017_system_hokora_03",
      "hash64": "81FC47FF6742A387",
      "text": "灾祸之玉封印已解",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
