          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_gym_nomal_battleend_win_00_01",
      "hash64": "5154FD629BEDA55D",
      "text": "你真是个\\n能越来越强的人啊。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "coach_gym_nomal_battleend_win_00_02",
      "hash64": "5154FA629BEDA044",
      "text": "相信你出了不少汗，\\n请收下这个吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "coach_gym_nomal_battleend_win_00_03",
      "hash64": "5154FB629BEDA1F7",
      "text": "矿物质可是很重要的。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
