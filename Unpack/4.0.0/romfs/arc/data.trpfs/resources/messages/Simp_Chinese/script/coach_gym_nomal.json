    {
      "ordinal": 41,
      "label": "coach_gym_nomal_battleend_win_00_00",
      "hash64": "5154FC629BEDA3AA",
      "text": "……辛苦了。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
