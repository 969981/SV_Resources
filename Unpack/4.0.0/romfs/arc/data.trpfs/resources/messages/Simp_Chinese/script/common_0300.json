          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0300_head_teacher_02",
      "hash64": "817FFE1AF3FCB6BD",
      "text": "不知道大家有没有听进去我的嘱咐。\\c\\n……学生们都这么活泼，\\n让我时刻都放不下心来啊。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0300_man_b_01",
      "hash64": "AEE0017188589A58",
      "text": "让我们想做什么就做什么，\\n我反而会头疼啊。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0300_man_c_01",
      "hash64": "84620D7CD1C15E6D",
      "text": "等的就是你，寻宝！\\n我要用花了零花钱买的相机\\r\\n拍下最棒的照片！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0300_man_d_01",
      "hash64": "B1AF75833440D676",
      "text": "对我来说，\\n寻宝就是寻找宝可梦！\\r\\n我要把图鉴填得满满的～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0300_woman_b_01",
      "hash64": "51356B66502B327E",
      "text": "我该去哪里才好呢？\\n真希望有人能帮我决定……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "common_0300_woman_c_01",
      "hash64": "5424176B78AB0693",
      "text": "我要去各种地方\\n野餐个够～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
