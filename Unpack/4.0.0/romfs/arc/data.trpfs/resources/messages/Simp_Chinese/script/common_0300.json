      ]
    },
    {
      "ordinal": 3,
      "label": "common_0300_legend_01",
      "hash64": "52B8ADC5682341BE",
      "text": "[VAR 0x0100(0000)]！我们走吧～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
