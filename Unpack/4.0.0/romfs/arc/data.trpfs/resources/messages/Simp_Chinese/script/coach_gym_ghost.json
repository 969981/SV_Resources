          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "coach_gym_ghost_trade_03_01",
      "hash64": "77D40D742CFE98FA",
      "text": "怎么啦，不交换了吗！？\\n你要再多配合我一点哦！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "coach_gym_ghost_trade_04_00",
      "hash64": "2D2C34ABE420B176",
      "text": "要来和我进行宝可梦交换吗？\\n[VAR 0x0100(0000)]ａ．ｋ．ａ冠军。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_gym_ghost_talkto_00",
      "hash64": "0EA79DD27727ACCA",
      "text": "是[VAR 0x0100(0000)]你呀？\\n是想来和我一起演出吗？[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "coach_gym_ghost_cancel_00",
      "hash64": "F942D81B895D1DD9",
      "text": "灵魂对决，不如一别？\\n火速放弃，我好丧气！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "coach_gym_ghost_battlestart_00",
      "hash64": "91356F85B215BAED",
      "text": "哈！这可是你说的哦！\\n让我们的灵魂混搭起来吧！！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "coach_gym_ghost_battlestart_01",
      "hash64": "91356E85B215B93A",
      "text": "我专攻双打对战！\\n想和我合奏的话，\\r\\n就带上２只以上的宝可梦吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "coach_gym_ghost_battleend_win_00_00",
      "hash64": "3E6BFA995725EC42",
      "text": "HAHAHA！好啊～！\\n我深深地感受到了你的灵魂！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "coach_gym_ghost_battleend_win_00_01",
      "hash64": "3E6BFB995725EDF5",
      "text": "我会支持你的哦。\\n虽然不能给你什么特别的关照。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "coach_gym_ghost_battleend_win_00_02",
      "hash64": "3E6BF8995725E8DC",
      "text": "你想要我为巡演制作的运动鞋吗？\\n穿上去意外地舒服哦。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "coach_gym_ghost_battleend_win_00_03",
      "hash64": "3E6BF9995725EA8F",
      "text": "这可是稀罕货，\\n到你进坟墓那天也要带着哦。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_gym_ghost_reward_00",
      "hash64": "8DB84E65DF8BA28A",
      "text": "[VAR 0x0100(0000)]从莱姆那里\\n获得了[VAR 0xFF00(0008)]幽灵运动鞋[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "coach_gym_ghost_battleend_win_01_00",
      "hash64": "E6BFB091BAA68FB3",
      "text": "你的妙语简直是SWAG！\\n连地狱都为之震撼！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "coach_gym_ghost_battleend_win_01_01",
      "hash64": "E6BFAF91BAA68E00",
      "text": "等你灵魂高昂时就再来找我吧！\\n拜拜，宝贝！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_gym_ghost_battleend_lose_00_00",
      "hash64": "BC8F890B5D1C6C89",
      "text": "HAHAHA！\\n你喜欢我的演出吗？\\c\\n要是你想再次和我一起演出，\\n我会把你邀请到最前排的！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_gym_ghost_randomtalk_00",
      "hash64": "B11B6179BF8E2B14",
      "text": "我有一首\\n叫《GHOST FATHER》的代表作，\\r\\n你听过这首乐曲吗？\\c\\n歌词是我在\\n给父亲扫墓时想到的。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_gym_ghost_randomtalk_01",
      "hash64": "B11B6279BF8E2CC7",
      "text": "入口那儿的对战场\\n挺不错嘛。\\c\\n周围都是观众席，\\n应该也能用来做演出。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_ghost_randomtalk_02",
      "hash64": "B11B6379BF8E2E7A",
      "text": "你可不要干坏事\\n让泰姆姐为难哦！\\c\\n她要是被惹怒了\\n会比我更可怕哦！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_gym_ghost_randomtalk_03",
      "hash64": "B11B6479BF8E302D",
      "text": "你的[VAR 0x0101(0001)]！\\n真是很积极啊！\\c\\n在我唱歌的时候，\\n它还会配合我助兴呢！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_gym_ghost_randomtalk_04",
      "hash64": "B11B5D79BF8E2448",
      "text": "DJ MUZAIGOU过得还好吧！？\\c\\n你给它听音乐的话，\\n它就会开心地跳舞哦！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_gym_ghost_randomtalk_sp",
      "hash64": "B1FF9379C050784F",
      "text": "我从也慈那里听说，\\n[VAR 0x0100(0000)]！你……\\c\\n把我提名为\\n你最喜欢的道馆馆主了！？\\c\\n哼！居然有向我\\n表达好感的怪家伙！\\c\\n……但！这可是\\n来自你的认可。\\r\\n我就老实地收下你的心意吧！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
