    },
    {
      "ordinal": 2,
      "label": "coach_gym_ghost_sp01_00",
      "hash64": "94C17D7A841114B7",
      "text": "[VAR 0x0100(0000)]！是你呀！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
