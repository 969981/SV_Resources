          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_ghost_sp01_01",
      "hash64": "94C17C7A84111304",
      "text": "深情灵魂饶舌乐莱姆这名字呀，\\n可是闻名世界的哦。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_ghost_sp01_02",
      "hash64": "94C17F7A8411181D",
      "text": "居然敢把这么有名的我叫来，\\n你真是个大人物，HAHAHA！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_ghost_sp01_03",
      "hash64": "94C17E7A8411166A",
      "text": "既然得到了冠军的青睐，\\n那么我也不好拒绝了！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_gym_ghost_sp01_04",
      "hash64": "94C1797A84110DEB",
      "text": "就用我的灵魂说唱！\\n来给蓝莓的小家伙们\\r\\n上一课吧！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_gym_ghost_sp01_select_01",
      "hash64": "901D6A3D4A970823",
      "text": "拜托了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_gym_ghost_sp01_select_02",
      "hash64": "901D6B3D4A9709D6",
      "text": "不是让你教说唱！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_gym_ghost_sp01_05",
      "hash64": "94C1787A84110C38",
      "text": "你真会配合嘛！\\n对战的课程也交给我吧！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_ghost_sp01_05b",
      "hash64": "D5CC122E68F7FCEE",
      "text": "哪会是说唱，\\n才不会那样！HAHAHA！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_ghost_sp02_00",
      "hash64": "3E5BB372E8A75448",
      "text": "蓝莓流行\\n双打对战呀。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_ghost_sp02_01",
      "hash64": "3E5BB472E8A755FB",
      "text": "我之所以喜欢双打对战，\\n是因为要思考的东西很多，很DEEP！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_ghost_sp02_02",
      "hash64": "3E5BB572E8A757AE",
      "text": "当２只宝可梦的招式混搭起来时，\\n那可是超SWAG的合奏！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_ghost_sp02_select_01",
      "hash64": "50FA35A9A0FBE382",
      "text": "这样啊",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_gym_ghost_sp02_select_02",
      "hash64": "50FA34A9A0FBE1CF",
      "text": "真酷！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_gym_ghost_sp02_03",
      "hash64": "3E5BB672E8A75961",
      "text": "HAHAHA！你！\\n真的听明白了吗！？[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_ghost_sp02_03b",
      "hash64": "9D300841545C4019",
      "text": "HAHAHA！\\n你很懂行嘛！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_ghost_sp02_04",
      "hash64": "3E5BB772E8A75B14",
      "text": "要是双打比单打更流行的话，\\n我的活动也能进行得更轻松。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_ghost_sp02_05",
      "hash64": "3E5BB872E8A75CC7",
      "text": "就让我把双打的技巧刻到\\n蓝莓那些小家伙们的骨子里吧！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_ghost_sp03_00",
      "hash64": "6726A9679DCCFF19",
      "text": "[VAR 0x0100(0000)]！\\n喘口气，break一下吧！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_ghost_sp03_01",
      "hash64": "6726A8679DCCFD66",
      "text": "我很感谢你\\n把我叫到了蓝莓来。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_ghost_sp03_02",
      "hash64": "6726A7679DCCFBB3",
      "text": "我喜欢被小孩包围。\\n因为这充满灵魂，能得到力量。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_ghost_sp03_03",
      "hash64": "6726A6679DCCFA00",
      "text": "你对于我喜欢小孩这件事\\n感到很意外吗？[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_ghost_sp03_select_01",
      "hash64": "C6693166A7261C05",
      "text": "很意外！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "coach_gym_ghost_sp03_select_02",
      "hash64": "C6692E66A72616EC",
      "text": "没那回事",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "coach_gym_ghost_sp03_04",
      "hash64": "6726AD679DCD05E5",
      "text": "HAHAHA！别人经常这样说我！\\n毕竟我的样子也很炫嘛！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_ghost_sp03_04b",
      "hash64": "13BE2E1123606465",
      "text": "HAHAHA！我看上去\\n像个温柔的奶奶吗？[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_ghost_sp03_05",
      "hash64": "6726AC679DCD0432",
      "text": "以前我并不擅长与小孩相处，\\n但自从有了孙子之后，\\r\\n就变得十分喜欢小孩了。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_ghost_sp03_06",
      "hash64": "6726AB679DCD027F",
      "text": "一看到和我孙子\\n差不多大的你们努力的样子，\\r\\n我就忍不住会热泪盈眶。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_ghost_trade_01_00",
      "hash64": "FB86C2822AE6FD0B",
      "text": "HAHAHA！\\n伤感的蓝调可不适合我呀。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_ghost_trade_01_01",
      "hash64": "FB86C1822AE6FB58",
      "text": "让我们来一场合奏！\\n振作起精神吧！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_ghost_trade_01_02",
      "hash64": "FB86C4822AE70071",
      "text": "要来进行宝可梦交换吗？\\n[VAR 0x0100(0000)]ａ．ｋ．ａ冠军。[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_gym_ghost_trade_01_03",
      "hash64": "FB86C3822AE6FEBE",
      "text": "我会推出DJ MUZAIGOU！\\n[VAR 0x0100(0000)]，你呢？[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_gym_ghost_trade_01_04",
      "hash64": "FB86C6822AE703D7",
      "text": "你的判断！让我SO FUN！\\n搭配很赞！感谢交换！\\c\\n我要竭尽全力培育它，\\n好让它能在双打对战大显身手！[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
