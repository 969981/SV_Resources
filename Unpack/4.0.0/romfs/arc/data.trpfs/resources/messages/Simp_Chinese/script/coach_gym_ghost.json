    {
      "ordinal": 36,
      "label": "coach_gym_ghost_trade_02_01",
      "hash64": "A3DAF97A8E687BAF",
      "text": "无法使用初训家不是自己的\\n宝可梦进行交换。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "coach_gym_ghost_trade_02_02",
      "hash64": "A3DAFA7A8E687D62",
      "text": "无法使用稀有宝可梦\\n进行交换。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "coach_gym_ghost_trade_02_03",
      "hash64": "A3DAFB7A8E687F15",
      "text": "无法使用异色宝可梦\\n进行交换。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "coach_gym_ghost_trade_03_00",
      "hash64": "77D40E742CFE9AAD",
      "text": "１只宝可梦？\\n交换不可能♪\\c\\n同行不落单，\\n才能来交换♪[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
