    {
      "ordinal": 1,
      "label": "coach_gym_ghost_first_01",
      "hash64": "E2556246BBB7BB2E",
      "text": "想听我讲解何谓灵魂的人！\\n就是你们吗！？[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
