          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_gym_ghost_trade_02_00",
      "hash64": "A3DAF87A8E6879FC",
      "text": "[VAR 0x0100(0000)]你要用[VAR 0x0101(0001)]\\n和我的MUZAIGOU交换吗？[VAR 0x0114(001B)]",
      "flags": 0,
