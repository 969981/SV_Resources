      "ordinal": 32,
      "label": "sdc02_0110_fairybb_02",
      "hash64": "99B1FF2E37E9DB69",
      "text": "我也是在入口那边\\n听席蓝校长介绍的……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
