          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0110_dragonbb_03",
      "hash64": "23ADD29E05CF9A96",
      "text": "在咱们食堂，阿若我觉得啊～\\n学园套餐是最推荐的！[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0110_dragonbb_04",
      "hash64": "23ADD59E05CF9FAF",
      "text": "整体比较柔软，\\n不怎么嚼也没问题。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0110_select_01",
      "hash64": "6FF860E8A29A7B3D",
      "text": "真不错！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc02_0110_select_02",
      "hash64": "6FF85DE8A29A7624",
      "text": "还是细嚼慢咽吧",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_0110_dragonbb_05",
      "hash64": "23ADD49E05CF9DFC",
      "text": "对吧～？嘿嘿嘿，\\n你很明白嘛。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0110_dragonbb_06",
      "hash64": "23ADD79E05CFA315",
      "text": "嘿嘿嘿，\\n你说话好像我妈啊～[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0110_dragonbb_07",
      "hash64": "23ADD69E05CFA162",
      "text": "[VAR 0x0100(0000)]……\\n你很擅长宝可梦对战吧？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0110_dragonbb_08",
      "hash64": "23ADD99E05CFA67B",
      "text": "以你的实力，\\n能在蓝莓联盟争第一了。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0110_dragonbb_09",
      "hash64": "23ADD89E05CFA4C8",
      "text": "要是交换留学生能在学园\\n成为第一，肯定超～有趣吧？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0110_dragonbb_10",
      "hash64": "23AA6B9E05CCB5BA",
      "text": "所以，我希望[VAR 0x0100(0000)]你\\n参加蓝莓联盟。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0110_select_03",
      "hash64": "6FF85EE8A29A77D7",
      "text": "我要参加！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc02_0110_select_04",
      "hash64": "6FF85BE8A29A72BE",
      "text": "怎么办……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0110_mob_01",
      "hash64": "70585A5604902CED",
      "text": "哇，冠军！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_0110_mob_02",
      "hash64": "70585756049027D4",
      "text": "四天王也在！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc02_0110_dragonbb_11",
      "hash64": "23AA6C9E05CCB76D",
      "text": "哦，你们来啦。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0110_brother_01",
      "hash64": "21AFF774C274C015",
      "text": "杜若……\\n你找我有什么事？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0110_dragonbb_12",
      "hash64": "23AA699E05CCB254",
      "text": "什么事不事的，\\n这里是食堂哦。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0110_dragonbb_13",
      "hash64": "23AA6A9E05CCB407",
      "text": "我只是想邀请你\\n一起吃个饭而已～[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0110_brother_02",
      "hash64": "21AFF474C274BAFC",
      "text": "……无聊。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0110_brother_03",
      "hash64": "21AFF574C274BCAF",
      "text": "有这闲工夫，\\n把宝可梦变强一点怎么样？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0110_brother_04",
      "hash64": "21AFF274C274B796",
      "text": "你就是这样才会输给我。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0110_dragonbb_14",
      "hash64": "23AA679E05CCAEEE",
      "text": "……啊～被拒绝了。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0110_dragonbb_15",
      "hash64": "23AA689E05CCB0A1",
      "text": "就算有乌栗你最～喜欢的\\n朋友在，也不行吗～？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
