      "label": "sdc02_0110_brother_05",
      "hash64": "21AFF374C274B949",
      "text": "什么……[VAR 0x0100(0000)]！？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
