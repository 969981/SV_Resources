      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "sdc02_0110_brother_06",
      "hash64": "21AFF074C274B430",
