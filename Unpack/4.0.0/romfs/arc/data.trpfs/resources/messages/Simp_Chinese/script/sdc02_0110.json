    },
    {
      "ordinal": 1,
      "label": "sdc02_0110_dragonbb_02",
      "hash64": "23ADD39E05CF9C49",
      "text": "别站着说话，快坐下吧。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
