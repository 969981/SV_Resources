  "entries": [
    {
      "ordinal": 0,
      "label": "atlantis_talk_02_friend_01a",
      "hash64": "BE3F79B9DAD020A1",
      "text": "……我活到现在\\n都没怎么见过我妈。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
