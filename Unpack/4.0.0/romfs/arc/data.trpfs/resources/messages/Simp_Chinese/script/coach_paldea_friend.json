            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "coach_paldea_friend_randomtalk_00",
      "hash64": "9EB3E009A671CA25",
      "text": "我在巨蛋里看海的时候，\\n有只正在游泳的原野水母吓了我一跳！\\c\\n那家伙好像是别的宝可梦，\\n但它们长得超像啊！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
