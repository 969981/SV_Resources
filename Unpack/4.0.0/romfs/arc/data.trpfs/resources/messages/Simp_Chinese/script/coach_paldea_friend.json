      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "coach_paldea_friend_sp03_07",
      "hash64": "F2E20D507D92E3CD",
      "text": "说了半天，原来是你的熟人啊！\\n看来这个学园也有怪家伙呀！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
