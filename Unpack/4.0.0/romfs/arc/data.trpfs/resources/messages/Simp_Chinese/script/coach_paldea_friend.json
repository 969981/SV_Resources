          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "coach_paldea_friend_trade_01_01",
      "hash64": "065D7934CE2D31B5",
      "text": "它是一只特性\\n有点怪的贪心栗鼠……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
