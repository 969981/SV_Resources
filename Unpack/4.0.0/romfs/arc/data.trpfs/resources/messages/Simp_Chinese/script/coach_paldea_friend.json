          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_paldea_friend_trade_01_02",
      "hash64": "065D7634CE2D2C9C",
      "text": "机会难得，\\n我们就来交换宝可梦吧！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "coach_paldea_friend_trade_01_03",
      "hash64": "065D7734CE2D2E4F",
      "text": "好的！那么\\n我就拿贪心栗鼠来交换！\\r\\n[VAR 0x0100(0000)]你要用哪只来交换？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
