          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "coach_paldea_friend_trade_01_00",
      "hash64": "065D7834CE2D3002",
      "text": "对了，说起怪家伙……\\n我想给你看看这个家伙！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
