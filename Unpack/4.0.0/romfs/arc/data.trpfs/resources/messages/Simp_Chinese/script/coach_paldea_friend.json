          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "coach_paldea_friend_sp03_07b",
      "hash64": "49004EC56098E25D",
      "text": "被错认的那一方可承受不来啊。\\n看来这个学园也有怪家伙呀！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
