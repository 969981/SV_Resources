    {
      "ordinal": 58,
      "label": "schoolmap_5_7",
      "hash64": "565E58BCA58C3637",
      "text": "丹瑜的房间。\\n有许多很讲究的小物件。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 59,
      "label": "schoolmap_5_8",
      "hash64": "565E4DBCA58C2386",
      "text": "乌栗的房间。\\n有许多努力的痕迹。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 60,
      "label": "schoolmap_5_9",
      "hash64": "565E4EBCA58C2539",
      "text": "联盟社使用的活动室。\\n能从电脑使用ＢＰ进行赞助。",
      "flags": 0,
