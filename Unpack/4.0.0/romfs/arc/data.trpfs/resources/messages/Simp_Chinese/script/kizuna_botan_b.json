      "label": "kizuna_botan_b_02",
      "hash64": "E3AE76C1046465AC",
      "text": "蹑手蹑脚……（我在观察秋明的样子。）\\n偷偷地……（说话小声一点。）[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
