    {
      "ordinal": 22,
      "label": "class_f_08_dragon_04",
      "hash64": "F4463FAB39E671F8",
      "text": "各位上了一整期的美术课，\\n小生对此感激不尽。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
