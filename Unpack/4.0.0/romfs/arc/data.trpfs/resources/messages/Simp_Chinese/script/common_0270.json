    {
      "ordinal": 1,
      "label": "common_0270_head_teacher_02",
      "hash64": "F612F886ADD63A71",
      "text": "你对橘子学院还算满意吗？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
