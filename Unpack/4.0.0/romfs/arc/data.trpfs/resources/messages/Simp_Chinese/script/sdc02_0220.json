    {
      "ordinal": 10,
      "label": "sdc02_0220_dragonbb_10",
      "hash64": "41B7DF823CDF29CC",
      "text": "什么？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
