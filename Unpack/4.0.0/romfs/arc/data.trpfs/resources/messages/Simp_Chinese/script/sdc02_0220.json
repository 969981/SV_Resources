      "ordinal": 17,
      "label": "sdc02_0220_fairybb_02",
      "hash64": "90B02986A38D994B",
      "text": "呃……\\n首先是[VAR 0x0100(0000)]，\\r\\n恭喜你成为冠军！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
