        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0220_dragonbb_05",
      "hash64": "41BB60823CE23AD6",
      "text": "虽然我这个输给你的人\\n没什么资格说，但你还是……[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0220_dragonbb_06",
      "hash64": "41BB5F823CE23923",
      "text": "像过去那样享受对战吧。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
