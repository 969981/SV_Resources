      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0220_dragonbb_04",
      "hash64": "41BB61823CE23C89",
      "text": "……乌栗啊。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
