    {
      "ordinal": 1,
      "label": "sdc02_0250_bbteacher_02",
      "hash64": "703B8C8FDD7C2297",
      "text": "我做梦都在想的第零区！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
