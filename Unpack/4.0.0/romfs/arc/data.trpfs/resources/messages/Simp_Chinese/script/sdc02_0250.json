      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0250_brother_01",
      "hash64": "D18254A817367F56",
      "text": "哇呀……[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0250_brother_02",
      "hash64": "D18253A817367DA3",
      "text": "呃、那个……[VAR 0x0100(0000)]你\\n之前来过这里……对吧？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
