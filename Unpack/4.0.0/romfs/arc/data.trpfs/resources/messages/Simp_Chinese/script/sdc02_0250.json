            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0250_sister_01",
      "hash64": "7EFDE5C60D800EBC",
      "text": "这也太……震撼了吧。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
