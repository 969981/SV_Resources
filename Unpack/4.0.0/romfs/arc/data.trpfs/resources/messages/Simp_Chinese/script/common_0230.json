      "hash64": "A061EFFFA7BAFABF",
      "text": "[VAR 0x0100(0000)]！\\n欢迎你来到橘子学院！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
