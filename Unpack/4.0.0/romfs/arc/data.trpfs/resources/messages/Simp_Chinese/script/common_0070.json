    {
      "ordinal": 17,
      "label": "common_0070_head_teacher_06",
      "hash64": "FC1847C97563E97F",
      "text": "你决定好要让哪只宝可梦\\n成为你的搭档了吗？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
