          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_ghost_010_receptionist_04",
      "hash64": "56627B775F563FDD",
      "text": "冰柜道馆的道馆测验是……\\n[VAR 0xFF00(0006)]开场表演[VAR 0xFF00(0000)]！\\r\\n……也就是所谓的暖场秀！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_ghost_010_receptionist_05",
      "hash64": "56627A775F563E2A",
      "text": "在道馆馆主开始现场演出之前，\\n请你在舞台上进行宝可梦对战！\\r\\n用殊死的热斗点燃观众席吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_ghost_010_receptionist_06",
      "hash64": "566279775F563C77",
      "text": "只要和演出会场的ＭＣ说一声，\\n就能开始道馆测验了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_ghost_010_receptionist_07",
      "hash64": "566278775F563AC4",
      "text": "好了，快去吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
