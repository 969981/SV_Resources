    },
    {
      "ordinal": 2,
      "label": "gym_ghost_010_receptionist_03",
      "hash64": "566274775F5633F8",
      "text": "想和本道馆的\\n馆主莱姆对战，\\r\\n需要先通过道馆测验才行。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
