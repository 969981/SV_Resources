      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "gym_ghost_010_receptionist_02",
      "hash64": "566275775F5635AB",
      "text": "我要登记一下\\n挑战者的名字……\\r\\n你是[VAR 0x0100(0000)]，没错吧？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
