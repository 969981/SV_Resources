          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_038_man_npc",
      "hash64": "C1792A01F38D539A",
      "text": "哼，我的同志啊，\\n你要小心……别被左手吞噬咯……！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
