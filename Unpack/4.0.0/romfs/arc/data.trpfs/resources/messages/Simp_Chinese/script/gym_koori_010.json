    {
      "ordinal": 2,
      "label": "gym_koori_010_receptionist_03",
      "hash64": "C2D8D031076D1D59",
      "text": "想和本道馆的\\n馆主古鲁夏对战，\\r\\n需要先通过道馆测验才行。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
