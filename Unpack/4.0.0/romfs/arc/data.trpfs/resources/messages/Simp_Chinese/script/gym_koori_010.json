          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_koori_010_receptionist_04",
      "hash64": "C2D8D131076D1F0C",
      "text": "霜抹山道馆的道馆测验是……\\n[VAR 0xFF00(0006)]雪山速滑[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_koori_010_receptionist_05",
      "hash64": "C2D8D231076D20BF",
      "text": "你要骑着坐骑宝可梦在指定赛道上滑行，\\n并在限制时间内到达终点！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_koori_010_receptionist_06",
      "hash64": "C2D8D331076D2272",
      "text": "详细规则请你先出本道馆，\\n爬上左手边的坡道，\\r\\n到那前面的雪山速滑起点处后再做说明吧。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
