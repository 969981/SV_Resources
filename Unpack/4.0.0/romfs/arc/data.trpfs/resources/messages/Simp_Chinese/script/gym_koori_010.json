        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_koori_010_receptionist_07",
      "hash64": "C2D8D431076D2425",
      "text": "好了，快去吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
