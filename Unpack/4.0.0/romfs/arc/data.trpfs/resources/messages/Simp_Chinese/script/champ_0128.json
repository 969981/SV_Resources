          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0128_rival_09",
      "hash64": "A5DB997965336E47",
      "text": "距离冠军级只差一点了！\\n剩下的２个道馆也要加油哦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0128_rival_10",
      "hash64": "A5DF167965367885",
      "text": "我送你回前台吧！[VAR 0x0114(0004)]",
