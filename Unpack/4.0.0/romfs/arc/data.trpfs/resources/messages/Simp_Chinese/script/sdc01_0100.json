      "ordinal": 0,
      "label": "sdc01_0100_sister_01",
      "hash64": "6ED1B9A3196FDDD3",
      "text": "你是那个\\n叫[VAR 0x0100(0000)]的吧？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
