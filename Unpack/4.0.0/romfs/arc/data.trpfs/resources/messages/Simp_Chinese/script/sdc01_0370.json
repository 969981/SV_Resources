      "hash64": "C88D6434EE0BF0BB",
      "text": "嘎……嘎嗷。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc01_0370_sister_01",
      "hash64": "9CDE99ED10BF9D5A",
      "text": "厄诡椪它怎么了？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
