      "label": "team_0170_head_teacher_01",
      "hash64": "F79DE108E752CF5D",
      "text": "[VAR 0x0100(0000)]同学，\\n你来了啊。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
