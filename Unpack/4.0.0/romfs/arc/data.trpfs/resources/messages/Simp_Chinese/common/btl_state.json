      "hash64": "DA8A0216B2928334",
      "text": "戏法空间",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "BTR_STATE_08_02",
      "hash64": "DA8A0516B292884D",
      "text": "在５回合内，\\n速度慢的宝可梦可以先行动。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 18,
