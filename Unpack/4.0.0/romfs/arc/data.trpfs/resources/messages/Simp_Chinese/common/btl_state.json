      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "BTR_STATE_09_02",
      "hash64": "DBC52B1BD99FE430",
      "text": "在５回合内，\\n变得无法使用持有物。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 20,
