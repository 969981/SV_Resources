      "hash64": "7BB6BDDA13718E71",
      "text": "大晴天",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "BTR_STATE_01_02",
      "hash64": "7BB6BADA13718958",
      "text": "天气为晴朗状态。\\n火属性的招式威力会提高。\\n水属性的招式威力会降低。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "BTR_STATE_02_01",
      "hash64": "773F7DC3401FBD7E",
      "text": "下雨",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "BTR_STATE_02_02",
      "hash64": "773F7CC3401FBBCB",
      "text": "天气为下雨状态。\\n水属性的招式威力会提高。\\n火属性的招式威力会降低。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "BTR_STATE_03_01",
      "hash64": "7A2E29C8689F9193",
      "text": "沙暴",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "BTR_STATE_03_02",
      "hash64": "7A2E2AC8689F9346",
      "text": "天气为沙暴状态。\\n岩石、地面和钢属性以外的宝可梦，\\n每回合会受到伤害。\\n岩石属性的特防会变强。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "BTR_STATE_04_01",
      "hash64": "4A11A9B05A3879C0",
      "text": "下雪",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "BTR_STATE_04_02",
      "hash64": "4A11ACB05A387ED9",
      "text": "天气为下雪状态。\\n暴风雪变得容易命中。\\n冰属性的防御变强。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "BTR_STATE_05_01",
      "hash64": "A1BDF5B7F6B7D9B5",
      "text": "电气场地",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "BTR_STATE_05_02",
      "hash64": "A1BDF2B7F6B7D49C",
      "text": "在５回合内，\\n地面上的宝可梦不会变为睡眠状态。\\n电属性的招式威力会提高。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "BTR_STATE_06_01",
      "hash64": "7354759FE9C25662",
      "text": "青草场地",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "BTR_STATE_06_02",
      "hash64": "7354749FE9C254AF",
      "text": "在５回合内，\\n地面上的宝可梦会缓缓回复ＨＰ。\\n草属性的招式威力会提高。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "BTR_STATE_07_01",
