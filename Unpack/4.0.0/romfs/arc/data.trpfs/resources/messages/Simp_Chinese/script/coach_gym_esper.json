            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "coach_gym_esper_battlestart_00",
      "hash64": "B9F6217E5B0CFB2D",
      "text": "呵呵，那就这样。\\n我们去对战场吧。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
