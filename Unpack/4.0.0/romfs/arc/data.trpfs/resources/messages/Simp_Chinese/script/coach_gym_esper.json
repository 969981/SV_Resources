    },
    {
      "ordinal": 40,
      "label": "coach_gym_esper_trade_04_00",
      "hash64": "9184931EAE4E38B6",
      "text": "呵呵！等你很久了。\\n你要和莉普我的飘飘雏交换了吗？[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
