    {
      "ordinal": 45,
      "label": "coach_gym_esper_battleend_win_00_00",
      "hash64": "331C8663F6947082",
      "text": "美丽至极，强大无比，\\n而且有魔法加持！[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
