    },
    {
      "ordinal": 36,
      "label": "coach_gym_esper_trade_02_02",
      "hash64": "083358ED589604A2",
      "text": "无法使用稀有宝可梦\\n进行交换。",
      "flags": 0,
      "text_status": "DECODED",
