            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_gym_esper_cancel_00",
      "hash64": "78D119A3A48A3819",
      "text": "哎呀，你居然拒绝了莉普我的邀请，\\n真是个大人物啊。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
