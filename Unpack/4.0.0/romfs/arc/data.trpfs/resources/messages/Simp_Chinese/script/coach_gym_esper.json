          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "coach_gym_esper_battleend_win_00_02",
      "hash64": "331C8463F6946D1C",
      "text": "你说不定能超越莉普我，\\n成为一个超级大人物，\\r\\n所以让我送你点好东西吧。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "coach_gym_esper_battleend_win_00_03",
      "hash64": "331C8563F6946ECF",
      "text": "那可是很“大强”的东西哦。\\n回礼就等你以后出人头地再给我吧。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
