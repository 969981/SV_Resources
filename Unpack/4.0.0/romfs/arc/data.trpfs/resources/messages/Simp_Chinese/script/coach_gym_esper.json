            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "coach_gym_esper_battleend_win_00_01",
      "hash64": "331C8763F6947235",
      "text": "……很高兴你遵守了\\n和莉普我之间的约定。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
