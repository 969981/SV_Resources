          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "coach_gym_esper_talkto_00",
      "hash64": "766091068790F10A",
      "text": "嘿，[VAR 0x0100(0000)]。\\n要和莉普我一起追求究极的美吗？[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
