    },
    {
      "ordinal": 39,
      "label": "coach_gym_esper_trade_03_01",
      "hash64": "32B16BE20F2D753A",
      "text": "拜托你要在莉普我\\n改变心意前再来哦。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
