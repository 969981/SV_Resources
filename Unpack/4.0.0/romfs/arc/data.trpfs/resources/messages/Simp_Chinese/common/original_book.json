      ]
    },
    {
      "ordinal": 35,
      "label": "original_book_honbun_11_01",
      "hash64": "513C114BEC1C480E",
      "text": "[EMPTY 65]",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": [
        {
