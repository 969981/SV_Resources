            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "original_book_title_12_01_A",
      "hash64": "F43324FD792A21BB",
      "text": "幻之宝可梦想象图",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "original_book_honbun_12_01_A",
      "hash64": "36C0F6E8CB473B81",
      "text": "由负责素描的观测队队员\\n所描绘的幻之宝可梦。\\n栖息在第零区中层以下的\\n神秘的宝可梦们\\n全都异常地巨大和凶暴。\\n据说队员是以这些特征为基础，\\n一边想象如果第零区有\\n幻之宝可梦，那它会是什么样子，\\n然后一边画出来的。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "original_book_title_12_01_B",
      "hash64": "F43325FD792A236E",
      "text": "幻之宝可梦想象图",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "original_book_honbun_12_01_B",
      "hash64": "36C0F3E8CB473668",
      "text": "由负责素描的观测队队员\\n所描绘的幻之宝可梦。\\n栖息在第零区中层以下的\\n神秘的宝可梦们\\n全都异常地小巧和残忍。\\n据说队员是以这些特征为基础，\\n一边想象如果第零区有\\n幻之宝可梦，那它会是什么样子，\\n然后一边画出来的。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "original_book_title_13_01",
      "hash64": "43F02FC8DCEEC2E2",
      "text": "神秘记忆",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "original_book_honbun_13_01",
      "hash64": "540B055D9803AAAC",
      "text": "本人海哲在第零区的最深处\\n曾一度与队伍走散落难，\\n被队伍找回时已经昏迷倒地。\\n也许是那时所做的梦，\\n在我的记忆中，我似乎在\\n不认识的地方与什么人说过话。\\n左边是我被发现时所拿着的笔记，\\n虽然其笔迹是我的，\\n但对此我毫无记忆。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "original_book_title_14_01",
      "hash64": "4C527803069DFAF1",
      "text": "■盘的宝■梦？",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "original_book_honbun_14_01",
      "hash64": "22661533DECAD327",
      "text": "与观测队■员■散时，\\n我■觉自■在巨坑的底■\\n看■了奇■的物体。\\n我甚■还不■道那■秘■■体\\n是不是■可梦是否■活■■。\\n它■外壳■由多层■\\n六■形■体构■，比宝■还闪■。\\n那形■■直就像是圆■。",
      "flags": 0,
      "text_status": "DECODED",
      "tokens": []
    },
    {
