      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc01_0340_sister_11",
      "hash64": "7AAC6B19EB6DFAF8",
      "text": "怎么了……？[VAR 0x0114(0044)]",
