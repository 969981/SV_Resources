    },
    {
      "ordinal": 9,
      "label": "sdc02_0258_bbteacher_03",
      "hash64": "4CAEEBCA3BF8EBFC",
      "text": "呵呵呵……[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
