      "label": "sdc02_0258_bbteacher_01",
      "hash64": "4CAEEDCA3BF8EF62",
      "text": "啊啊，简直太厉害了！\\n电梯正在不断下降！！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
