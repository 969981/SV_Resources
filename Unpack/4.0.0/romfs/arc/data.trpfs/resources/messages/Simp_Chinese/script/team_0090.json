      "ordinal": 30,
      "label": "team_0090_cassiopeia_14",
      "hash64": "4099486F657777CE",
      "text": "结果，\\n天星队大获全胜……\\r\\n不，甚至那都算不上对决。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
