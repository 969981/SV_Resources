          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "team_0090_system_03",
      "hash64": "CEB958DBE0C2FD68",
      "text": "能用招式学习器机制作的\\n招式学习器的种类增加了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "team_0090_cassiopeia_18",
      "hash64": "4099446F65777102",
      "text": "灵活运用招式学习器吧。\\n剩下的老大也交给你了。\\r\\n……追加报酬去找补给班的人领取吧。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0090_botan_01",
      "hash64": "B3E7EE01EEFC0CD5",
      "text": "那、那个，我已经来了……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0090_legend_01",
      "hash64": "90AB9FDEF2103B16",
      "text": "啊嘎嘶！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "team_0090_botan_02",
      "hash64": "B3E7EB01EEFC07BC",
      "text": "呜啊啊！\\n你不要出来！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "team_0090_botan_03",
      "hash64": "B3E7EC01EEFC096F",
      "text": "啊啊啊啊～……！！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "team_0090_botan_04",
      "hash64": "B3E7E901EEFC0456",
      "text": "……哦～天星队原来\\n还有那样的过去啊。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "team_0090_botan_05",
      "hash64": "B3E7EA01EEFC0609",
      "text": "本来是想消灭霸凌，\\n结果现在他们自己却变得人见人怕……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "team_0090_botan_06",
      "hash64": "B3E7E701EEFC00F0",
      "text": "太搞笑了。\\n老师和学生也都是笨蛋。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "team_0090_botan_07",
      "hash64": "B3E7E801EEFC02A3",
      "text": "当大家正在被霸凌的时候，\\n哪怕有一个外人能注意到这一点……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "team_0090_botan_08",
      "hash64": "B3E7F501EEFC18BA",
      "text": "那很快就应该能明白\\n天星队并不坏……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "team_0090_botan_09",
      "hash64": "B3E7F601EEFC1A6D",
      "text": "在这样都是笨蛋的学校里，\\n即使去战斗，\\r\\n也只有自己吃亏的份……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "team_0090_botan_10",
      "hash64": "B3EB7301EEFF24AB",
      "text": "创建天星队的\\n那个叫真老大的也一定\\r\\n是个无可救药的傻瓜。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "team_0090_select_05",
      "hash64": "200589D705811EC5",
      "text": "没那回事",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "team_0090_select_06",
      "hash64": "200586D7058119AC",
      "text": "是吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "team_0090_botan_11",
      "hash64": "B3EB7201EEFF22F8",
      "text": "…………就是这样。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "team_0090_botan_12",
      "hash64": "B3EB7501EEFF2811",
      "text": "嗯，这次的报酬。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
