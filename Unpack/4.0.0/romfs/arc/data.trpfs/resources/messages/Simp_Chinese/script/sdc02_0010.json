    {
      "ordinal": 0,
      "label": "sdc02_0010_headbb_01",
      "hash64": "1F17C63F0FC03554",
      "text": "咦～？这张脸……[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
