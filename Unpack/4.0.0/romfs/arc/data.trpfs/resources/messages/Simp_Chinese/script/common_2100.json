    {
      "ordinal": 0,
      "label": "common_2100_head_teacher_01",
      "hash64": "02387FD22F4BB78C",
      "text": "大家都到齐了吧？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
