          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_0210_rival_02",
      "hash64": "38E36667BE56E564",
      "text": "这里是宝可梦中心！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0210_rival_03",
      "hash64": "38E36767BE56E717",
      "text": "很多和宝可梦有关的事\\n都可以在这里做！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0210_rival_04",
      "hash64": "38E36467BE56E1FE",
      "text": "那好，详细说明就麻烦你了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0210_pokecen_01",
      "hash64": "AD11B217AFBB942A",
      "text": "好的！\\n欢迎到宝可梦中心来。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_0210_pokecen_02",
      "hash64": "AD11B117AFBB9277",
      "text": "我会让大家的宝可梦\\n恢复活力的。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0210_pokecen_03",
      "hash64": "AD11B017AFBB90C4",
      "text": "那边的设备是\\n招式学习器机！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_0210_pokecen_04",
      "hash64": "AD11AF17AFBB8F11",
      "text": "用那个装置可以制作\\n能让宝可梦学习招式的招式学习器。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_0210_pokecen_05",
      "hash64": "AD11AE17AFBB8D5E",
      "text": "要制作招式学习器需要[VAR 0xFF00(0006)]ＬＰ[VAR 0xFF00(0000)]和\\n宝可梦的[VAR 0xFF00(0006)]掉落物[VAR 0xFF00(0000)]哦。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0210_rival_10",
      "hash64": "38E6CE67BE59CBF3",
      "text": "我有很多能在商店和招式学习器机\\n使用的ＬＰ！分一些给你吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0210_rival_11",
      "hash64": "38E6CD67BE59CA40",
      "text": "另外，还有这个！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0210_system_01",
      "hash64": "F7614DBDC1C939C0",
      "text": "妮莫把很多宝可梦的\\n[VAR 0xFF00(0008)]掉落物[VAR 0xFF00(0000)]分给了[VAR 0x0100(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0210_pokecen_06",
      "hash64": "AD11AD17AFBB8BAB",
      "text": "在旁边的友好商店\\n可以购买用来捕捉宝可梦的精灵球，\\r\\n以及伤药等道具。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0210_shop_01",
      "hash64": "7B9566714708511F",
      "text": "也可以用简称[VAR 0xFF00(0006)]ＬＰ[VAR 0xFF00(0000)]的\\n“联盟支付点”支付哦。\\r\\n１ＬＰ折合１。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0210_pokecen_07",
      "hash64": "AD11AC17AFBB89F8",
      "text": "在联盟集友圈可以通过通讯\\n来募集一起去冒险的成员哦。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "common_0210_pokecen_08",
      "hash64": "AD11AB17AFBB8845",
      "text": "如果遇到困难了，\\n就请到宝可梦中心来吧。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "common_0210_rival_05",
      "hash64": "38E36567BE56E3B1",
      "text": "好～！谢谢！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0210_rival_06",
      "hash64": "38E36267BE56DE98",
      "text": "有困难就去宝可梦中心！\\n考试会考这个的哦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0210_rival_08",
      "hash64": "38E36067BE56DB32",
      "text": "另外，等你对宝可梦更熟悉后，\\n要记得这句我力推的口诀！\\r\\n“[VAR 0xFF00(0006)]Ｒ键Let's Go！[VAR 0xFF00(0000)]”[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_0210_rival_09",
      "hash64": "38E36167BE56DCE5",
      "text": "这样就可以拜托走在一起的宝可梦\\n“去把掉在地上的道具捡来～！”\\r\\n或是“去战斗吧～！”之类的哦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0210_rival_07",
      "hash64": "38E36367BE56E04B",
      "text": "穿过平碟镇就是\\n南第１区出名的上下学时会走的坡道！\\c\\n那里到处都是血气方刚的训练家，\\n你要加油啊！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
