    {
      "ordinal": 0,
      "label": "common_0210_rival_01",
      "hash64": "38E36967BE56EA7D",
      "text": "喂～！[VAR 0x0100(0000)]！\\n这边，这边！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
