            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "coach_teacher_dragon_battlestart_01",
      "hash64": "BA471C76554E94B3",
      "text": "[EMPTY 54]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
