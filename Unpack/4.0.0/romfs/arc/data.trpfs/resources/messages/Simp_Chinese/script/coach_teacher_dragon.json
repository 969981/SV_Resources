            "0036"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "coach_teacher_dragon_battleend_win_00_00",
      "hash64": "7E8DF406A5F422DD",
      "text": "……我们在联盟交手时，\\n虽然你的表现还不够成熟，\\r\\n但隐藏着一股尚未完善的实力。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_teacher_dragon_battleend_win_00_01",
      "hash64": "7E8DF306A5F4212A",
      "text": "但那份实力在现在，\\n已经如此……无可撼动……[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "coach_teacher_dragon_battleend_win_00_02",
      "hash64": "7E8DF206A5F41F77",
      "text": "小生……感慨万分……\\n呜哇啊啊啊，呜啊啊啊！！[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "coach_teacher_dragon_battleend_win_00_03",
      "hash64": "7E8DF106A5F41DC4",
      "text": "希望你今后也能不骄不躁，\\n在自己的路上自由地大步前行。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "coach_teacher_dragon_reward_00",
      "hash64": "A72C9DE23E875FD5",
      "text": "[VAR 0x0100(0000)]受八朔老师的启发，\\n想出了[VAR 0xFF00(0008)]感慨万分动作[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "coach_teacher_dragon_battleend_win_01_00",
      "hash64": "D4F39E0E415DACEC",
      "text": "谢谢你和小生对战。\\c\\n你这么努力，\\n小生要赠予你巨龙奖。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "coach_teacher_dragon_battleend_win_01_01",
      "hash64": "D4F39F0E415DAE9F",
      "text": "要是你觉得还能从小生身上学到什么，\\n就请再来交手吧。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "coach_teacher_dragon_battleend_lose_00_00",
      "hash64": "92A632C7CDBF57F0",
      "text": "这次就由小生\\n摘下美丽的胜利了。\\c\\n但从刚刚那场比试的进程来看……\\n下次结果如何就不得而知了。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "coach_teacher_dragon_randomtalk_00",
      "hash64": "F7321889F9C61FE3",
      "text": "看到每次见面都在成长的你，\\n小生会不由自主地……\\r\\n热泪盈眶啊。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_teacher_dragon_randomtalk_01",
      "hash64": "F7321789F9C61E30",
      "text": "蓝莓学园的学生\\n也都是些好孩子。\\r\\n教起来非常有成就感。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "coach_teacher_dragon_randomtalk_02",
      "hash64": "F7321A89F9C62349",
      "text": "小生曾经在酿光市的\\n大屏幕上看到了阿寇。\\c\\n能看到朋友努力的样子，\\n这真是件让人高兴的事啊。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "coach_teacher_dragon_randomtalk_03",
      "hash64": "F7321989F9C62196",
      "text": "[VAR 0x0100(0000)]你交换给小生的\\n[VAR 0x0101(0001)]是个很棒的孩子哦。\\c\\n它会积极主动地\\n给小生当画画的模特。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_teacher_dragon_randomtalk_04",
      "hash64": "F7321C89F9C626AF",
      "text": "冻脊龙过得还好吗？\\c\\n它很喜欢被摸肚子，\\n偶尔揉一揉它，它会很高兴的。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    }
  ]
