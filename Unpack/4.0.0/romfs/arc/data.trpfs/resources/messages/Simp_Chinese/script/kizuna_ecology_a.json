      "label": "kizuna_ecology_a_02",
      "hash64": "33860570BD20EA59",
      "text": "[VAR 0x0100(0000)]，\\n你已经习惯学校了吗～？[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
