      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_2020_mushi_010_select_02",
      "hash64": "79B29ECC9A614A40",
      "text": "我是冠军！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_mushi_010_mushi_03",
      "hash64": "B33173C9607708B9",
      "text": "好耶～！我答对了～！\\n因为[VAR 0x0100(0000)]你很强啊～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
