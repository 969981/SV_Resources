    },
    {
      "ordinal": 5,
      "label": "common_2020_mushi_010_mushi_04",
      "hash64": "B33174C960770A6C",
      "text": "而且你津津有味地\\n吃了我做的蛋糕。\\r\\n这样的孩子都很有成长空间呢～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
