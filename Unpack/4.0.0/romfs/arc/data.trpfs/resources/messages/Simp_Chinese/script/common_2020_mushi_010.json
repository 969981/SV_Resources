    },
    {
      "ordinal": 7,
      "label": "common_2020_mushi_010_mushi_06",
      "hash64": "B33176C960770DD2",
      "text": "……首席会来视察这事\\n被我忘了个精光呢～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
