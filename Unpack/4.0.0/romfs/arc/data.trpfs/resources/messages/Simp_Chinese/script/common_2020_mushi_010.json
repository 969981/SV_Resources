    },
    {
      "ordinal": 6,
      "label": "common_2020_mushi_010_mushi_05",
      "hash64": "B33175C960770C1F",
      "text": "哎呀～你是帮首席冠军\\n办事来的呀～？[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
