    {
      "ordinal": 1,
      "label": "common_2020_mushi_010_mushi_02",
      "hash64": "B33172C960770706",
      "text": "哎呀哎呀～莫非传闻中的\\n新冠军就是你～？[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
