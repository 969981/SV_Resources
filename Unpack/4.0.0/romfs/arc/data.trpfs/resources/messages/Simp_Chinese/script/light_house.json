{
  "version": "4.0.0",
  "language": "zh-Hans",
  "language_raw": "Simp_Chinese",
  "source": "message/dat/Simp_Chinese/script/light_house.dat",
  "paired_tbl": "message/dat/Simp_Chinese/script/light_house.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "light_house_east_01",
      "hash64": "949680CF782EEFBA",
      "text": "灯塔上面很安静啊。\\n叫做电海燕的宝可梦\\r\\n偶尔也会来这里歇息哦。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "light_house_east_02",
      "hash64": "94967FCF782EEE07",
      "text": "我在通向这里的坡道上看到洛托姆了！\\n是没有进入手机的天然的洛托姆！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "light_house_east_03",
      "hash64": "94967ECF782EEC54",
      "text": "最先进的城镇\\n竟然和大自然背靠背！\\r\\n让我这个登山女孩怦然心动啊。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "light_house_west_01",
      "hash64": "E34070F63FE676BC",
      "text": "从上面看的话，\\n市场也会变得那么小耶！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "light_house_west_03",
      "hash64": "E34072F63FE67A22",
      "text": "你也是穿过\\n烘烘沙漠而来的吗？\\r\\n有没有看到奇怪的宝可梦？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "light_house_west_04",
      "hash64": "E3406DF63FE671A3",
      "text": "要回玻瓶市的话，\\n无论如何都要使用飞翔出租车吧。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "light_house_west_08",
      "hash64": "E34079F63FE68607",
      "text": "我在拍卖会上花了一大笔钱……\\n海风侵蚀了我的眼睛！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "light_house_north_05",
      "hash64": "8C8B5391EE4487E6",
      "text": "小小的狗儿软乎乎！\\n嗯～！那就是狗仔包！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
