      "hash64": "CEBF02DE3455A961",
      "text": "[EMPTY 23]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
