      ]
    },
    {
      "ordinal": 9,
      "label": "atlantis_talk_01_02_friend_01",
      "hash64": "C5163AF4DFD67934",
      "text": "我说你们啊。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
