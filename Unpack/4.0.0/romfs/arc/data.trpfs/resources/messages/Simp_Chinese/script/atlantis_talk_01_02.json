      "ordinal": 12,
      "label": "atlantis_talk_01_02_botan_06",
      "hash64": "4D947B388CF33177",
      "text": "没问你……\\n话说你得意个啥？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
