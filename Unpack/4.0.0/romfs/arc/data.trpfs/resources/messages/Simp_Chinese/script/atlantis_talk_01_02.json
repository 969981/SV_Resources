    {
      "ordinal": 8,
      "label": "atlantis_talk_01_02_botan_05",
      "hash64": "4D947C388CF3332A",
      "text": "还能这样啊，真行……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
