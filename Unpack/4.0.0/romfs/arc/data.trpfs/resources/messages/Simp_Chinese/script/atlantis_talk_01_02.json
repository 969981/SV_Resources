      "ordinal": 11,
      "label": "atlantis_talk_01_02_friend_03",
      "hash64": "C5163CF4DFD67C9A",
      "text": "你们还差得远呢！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
