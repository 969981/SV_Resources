    },
    {
      "ordinal": 1,
      "label": "atlantis_talk_01_02_botan_01",
      "hash64": "4D9478388CF32C5E",
      "text": "咦？呃，\\n[VAR 0x1100(00FF,0101)]他她救了我……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
