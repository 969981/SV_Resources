    {
      "ordinal": 10,
      "label": "atlantis_talk_01_02_friend_02",
      "hash64": "C5163DF4DFD67E4D",
      "text": "与我和[VAR 0x0100(0000)]的\\n友情往事相比的话……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
