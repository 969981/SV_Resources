      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "class_e_08_battle_03",
      "hash64": "07ED881083232EB1",
      "text": "时间到！！\\n放下铅笔！[VAR 0x0114(0024)]",
