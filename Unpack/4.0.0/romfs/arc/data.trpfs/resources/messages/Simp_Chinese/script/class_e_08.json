      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_e_08_question_03",
      "hash64": "475F07BAE5D7C00B",
      "text": "３　想要获得ＬＰ时，\\n　　应该怎么办呢？\\n\\n・去挑战道馆　・与掉落物交换\\n・当个骇客",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
