    {
      "ordinal": 1,
      "label": "class_e_08_battle_02",
      "hash64": "07ED871083232CFE",
      "text": "那么，就请拿出干劲\\n与试卷一决胜负吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
