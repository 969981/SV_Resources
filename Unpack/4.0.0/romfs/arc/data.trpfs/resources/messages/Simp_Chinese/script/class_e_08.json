      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "class_e_08_question_02",
      "hash64": "475F06BAE5D7BE58",
      "text": "２　通过“Ｒ键Let's Go”让宝可梦对战，\\n　　这种被称作什么？\\n\\n・请多对战　　・随意战斗\\n・自主对战",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "class_e_08_ansewer_02a",
      "hash64": "A15B2FEDE9CF7D82",
