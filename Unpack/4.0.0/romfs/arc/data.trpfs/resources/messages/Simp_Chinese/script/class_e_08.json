      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_e_08_question_04",
      "hash64": "475F0CBAE5D7C88A",
      "text": "４　在连接对战的受限规则中，\\n　　若宝可梦等级较高，\\n　　等级会被统一调整为〇〇。\\n\\n・５０　・６０　・１００",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
