    {
      "ordinal": 7,
      "label": "kizuna_history_a_06",
      "hash64": "363F10B6BA15A335",
      "text": "哦，你喜欢旧的东西啊，\\n果然很有天赋。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
