      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_history_a_03",
      "hash64": "363F0BB6BA159AB6",
      "text": "真是耐人寻味。\\n你着实是个有趣的学生。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
