          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_history_a_07",
      "hash64": "363F0FB6BA15A182",
      "text": "如果是这孩子，总有一天\\n会对我有所帮助。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
