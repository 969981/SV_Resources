          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_history_a_08",
      "hash64": "363F12B6BA15A69B",
      "text": "……哎呀，别放在心上，\\n我只是自言自语两句而已。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
