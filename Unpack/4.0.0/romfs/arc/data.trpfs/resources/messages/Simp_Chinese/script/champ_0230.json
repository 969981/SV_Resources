    {
      "ordinal": 0,
      "label": "champ_0230_system_01",
      "hash64": "6DD6B9F2EFEEE2AA",
      "text": "要挑战四天王波琵吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "champ_0230_steel_01a",
      "hash64": "7F4D8B6DD0A5AC49",
      "text": "能接受第二轮测验不容易啊。\\n不过大哥哥，我就要在这里和你说拜拜了！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
