    {
      "ordinal": 6,
      "label": "sdc02_4kings_c_01_clerk_05",
      "hash64": "4B1051ADCBA7E66E",
      "text": "非常感谢！\\n已确认收到！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
