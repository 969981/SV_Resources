          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_c_01_clerk_03",
      "hash64": "4B1053ADCBA7E9D4",
      "text": "参加四天王挑战\\n需要支付５０ＢＰ！\\r\\n你愿意支付吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_c_01_clerk_04",
      "hash64": "4B1052ADCBA7E821",
      "text": "虽然有些难以开口，\\n但你的ＢＰ好像不够啊……\\r\\n参加蓝乐活来获得ＢＰ吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_c_01_system_01",
      "hash64": "03880224B52AB2E4",
      "text": "[VAR 0x0100(0000)]支付了\\n５０ＢＰ！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
