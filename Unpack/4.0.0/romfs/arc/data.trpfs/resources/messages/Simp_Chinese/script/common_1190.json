      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "common_1190_hakase_11a",
      "hash64": "8DF392A8FDB423B2",
      "text": "这不是宝可梦的过失。\\n是博士本人\\r\\n误判了它的力量。[VAR 0x0114(000C)]",
