    {
      "ordinal": 17,
      "label": "common_1190_hakase_08a",
      "hash64": "9538B7A9016DD00C",
      "text": "我并不是奥琳博士本人。[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
