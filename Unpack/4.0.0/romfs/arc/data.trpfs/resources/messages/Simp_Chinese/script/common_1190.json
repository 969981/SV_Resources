      "label": "common_1190_hakase_10a",
      "hash64": "8DF0AEA8FDB21D6F",
      "text": "由于第４观测站发生的事故，\\n真正的博士已经不在了。[VAR 0x0114(000C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
