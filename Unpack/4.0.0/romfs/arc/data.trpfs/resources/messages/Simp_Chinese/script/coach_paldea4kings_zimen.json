      "hash64": "F0E7C8F03A2BD2AF",
      "text": "[VAR 0x0100(0000)]～我来啦～[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
