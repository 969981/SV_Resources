          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_1095_rival_02",
      "hash64": "2A635E8FC9D0870C",
      "text": "啊哈哈！\\n牡丹，你太爱担心了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
