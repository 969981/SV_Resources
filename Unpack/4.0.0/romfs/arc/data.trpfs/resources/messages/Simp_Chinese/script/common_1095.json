        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_1095_botan_01",
      "hash64": "533EDFD13EB66CE7",
      "text": "又有什么东西要出来……\\n一定会出来……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
