      "label": "common_1095_botan_03",
      "hash64": "533EE1D13EB6704D",
      "text": "但是……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
