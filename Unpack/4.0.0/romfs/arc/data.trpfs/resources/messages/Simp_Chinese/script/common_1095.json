    },
    {
      "ordinal": 19,
      "label": "common_1095_friend_08a",
      "hash64": "9F79CDDDD3A1FEC7",
      "text": "那～么伟大的博士\\n到底在想什么呢？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
