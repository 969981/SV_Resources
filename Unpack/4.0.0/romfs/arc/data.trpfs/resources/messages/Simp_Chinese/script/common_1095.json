    {
      "ordinal": 1,
      "label": "common_1095_rival_01",
      "hash64": "2A63618FC9D08C25",
      "text": "我们能喘口气了呢～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
