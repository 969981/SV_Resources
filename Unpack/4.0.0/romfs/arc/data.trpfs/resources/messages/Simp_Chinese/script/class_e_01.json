    {
      "ordinal": 13,
      "label": "class_e_01_battle_answer_01",
      "hash64": "ED6FCB063F1DCCF1",
      "text": "不只答错，还带点令人担心的焦香！\\n你怎么了，转学生！？\\r\\n是正在讴歌青春吗！？[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
