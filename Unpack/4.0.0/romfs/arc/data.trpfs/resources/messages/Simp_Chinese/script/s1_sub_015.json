          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_sub_015_caretaker_38",
      "hash64": "AA1043EB935705D4",
      "text": "让金额达到1000000了！\\n目标成功达成～！！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_sub_015_caretaker_24",
      "hash64": "AA13BDEB935A0AF9",
      "text": "这下终于能修复宝伴像了！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_sub_015_caretaker_25",
      "hash64": "AA13BCEB935A0946",
      "text": "我马上跟修理公司联络。\\n哒、哒、哒……好了！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s1_sub_015_caretaker_26",
      "hash64": "AA13BBEB935A0793",
      "text": "喂喂？是我是我。\\n上次说的那件事，钱我已经凑齐了。\\r\\n让工人他们开工吧～！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
