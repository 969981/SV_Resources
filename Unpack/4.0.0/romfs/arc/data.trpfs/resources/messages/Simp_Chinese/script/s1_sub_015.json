    {
      "ordinal": 33,
      "label": "s1_sub_015_caretaker_30",
      "hash64": "AA103BEB9356F83C",
      "text": "这……这难以言喻的既视感！\\n它看起来就跟以前一模一样啊！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
