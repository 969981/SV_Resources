      "ordinal": 31,
      "label": "s1_sub_015_caretaker_28",
      "hash64": "AA13C9EB935A1F5D",
      "text": "哦哦……这就是……！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
