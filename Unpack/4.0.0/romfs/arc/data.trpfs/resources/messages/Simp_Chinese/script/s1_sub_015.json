          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_015_caretaker_23",
      "hash64": "AA13BEEB935A0CAC",
      "text": "你、你刚刚的捐款……[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
