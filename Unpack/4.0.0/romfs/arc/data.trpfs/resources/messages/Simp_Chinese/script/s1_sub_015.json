      ]
    },
    {
      "ordinal": 34,
      "label": "s1_sub_015_worker_01",
      "hash64": "CC9B1C239B704542",
      "text": "我们让原本就有的\\n伤痕和污垢也完美重现了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "s1_sub_015_caretaker_31",
      "hash64": "AA103CEB9356F9EF",
      "text": "哈哈哈！\\n各位工匠的技术实在是高超啊！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "s1_sub_015_caretaker_32",
      "hash64": "AA103DEB9356FBA2",
      "text": "只要有宝伴像在，就不愁会有\\n大批游客来这里拍照拍到嗨啊嗨！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "s1_sub_015_caretaker_37",
      "hash64": "AA103AEB9356F689",
      "text": "万岁～！万岁～！\\n来，你也跟我一起做！[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "s1_sub_015_system_02",
      "hash64": "B40A6B32127386C6",
      "text": "[VAR 0x0100(0000)]从管理员那里\\n学会了[VAR 0xFF00(0008)]万岁动作[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
