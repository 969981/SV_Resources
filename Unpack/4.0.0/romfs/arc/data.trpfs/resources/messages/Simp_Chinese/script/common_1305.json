    {
      "ordinal": 18,
      "label": "common_1305_rival_04",
      "hash64": "5BB1A7D73F701516",
      "text": "[VAR 0x0101(0001)]，你也很伤心吧……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
