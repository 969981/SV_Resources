      ]
    },
    {
      "ordinal": 26,
      "label": "common_1305_botan_06b",
      "hash64": "67C041C4FD7D1E74",
      "text": "但他一定正在未来\\n快乐地冒险呢。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
