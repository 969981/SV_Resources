          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_1305_friend_08",
      "hash64": "478BA25794895DAC",
