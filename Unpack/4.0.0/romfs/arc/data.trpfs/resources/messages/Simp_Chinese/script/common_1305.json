        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_1305_friend_05",
      "hash64": "478BA7579489662B",
      "text": "虽然不确定……但我早就知道了。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
