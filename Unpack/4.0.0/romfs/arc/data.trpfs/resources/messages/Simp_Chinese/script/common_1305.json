          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_1305_friend_06",
      "hash64": "478BA857948967DE",
      "text": "那家伙……虽然是个冒牌货，\\n但[VAR 0x1107(00FF,0101)]她他用那张脸和那声音\\r\\n叫了我的名字。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_1305_friend_07",
      "hash64": "478BA95794896991",
      "text": "即使是冒牌货，[VAR 0x1107(00FF,0101)]她他的心情也是真的……\\n所以我啊……总觉得……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0101"
