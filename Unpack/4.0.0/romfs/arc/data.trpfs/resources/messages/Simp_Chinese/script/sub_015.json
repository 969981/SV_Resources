{
  "version": "4.0.0",
  "language": "zh-Hans",
  "language_raw": "Simp_Chinese",
  "source": "message/dat/Simp_Chinese/script/sub_015.dat",
  "paired_tbl": "message/dat/Simp_Chinese/script/sub_015.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_015_system_kui_01",
      "hash64": "CBD71E33F4417D1E",
      "text": "这里埋着漆黑且\\n充满不祥气息的桩子……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_015_system_kui_02",
      "hash64": "CBD71D33F4417B6B",
      "text": "要把桩子拔出来吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_015_system_kui_03",
      "hash64": "CBD71C33F44179B8",
      "text": "桩子被拔出后，\\n崩裂成碎屑消失了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_015_system_kui_04",
      "hash64": "CBD72333F441859D",
      "text": "咕……咆……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_015_system_kui_05",
      "hash64": "CBD72233F44183EA",
      "text": "从祠的方向传来了\\n神秘的声音……！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_015_system_release_01",
      "hash64": "2F7176EB24844F78",
      "text": "祠里传出\\n微弱的声音……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_015_system_release_02",
      "hash64": "2F7179EB24845491",
      "text": "要触摸祠吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_015_system_release_03",
      "hash64": "2F7178EB248452DE",
      "text": "咔嗒咔嗒　咔嗒咔嗒……\\n喀哒喀哒喀哒　喀哒喀哒！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_015_system_release_07",
      "hash64": "2F717CEB248459AA",
      "text": "嘎哒～！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_015_system_release_04",
      "hash64": "2F717BEB248457F7",
      "text": "咕咆！！咕咆！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_015_system_release_05",
      "hash64": "2F717AEB24845644",
      "text": "古剑豹被再次\\n封印在祠里了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_015_system_release_06",
      "hash64": "2F717DEB24845B5D",
      "text": "看起来祠的门\\n暂时不会打开了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_015_system_hokora_01",
      "hash64": "375C3504754E3827",
      "text": "祠里刻着\\n模糊的文字……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_015_system_hokora_02",
      "hash64": "375C3604754E39DA",
      "text": "灾祸之剑封印于此",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_015_system_hokora_03",
      "hash64": "375C3704754E3B8D",
      "text": "灾祸之剑封印已解",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
