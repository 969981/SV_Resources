    {
      "ordinal": 5,
      "label": "sdc02_0340_bbteacher_03",
      "hash64": "27CFD08BC7D5A6C6",
      "text": "啊，嗯，\\n我没事哦……！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
