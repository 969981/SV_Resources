      "ordinal": 6,
      "label": "sdc02_0340_bbteacher_04",
      "hash64": "27CFD38BC7D5ABDF",
      "text": "都是我不好，\\n让大家遭遇了危险。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
