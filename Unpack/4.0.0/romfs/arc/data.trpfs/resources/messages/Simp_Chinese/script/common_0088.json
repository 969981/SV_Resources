      "ordinal": 17,
      "label": "common_0088_rival_11",
      "hash64": "58628ECA257EB0E9",
      "text": "……那好！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
