          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0088_rival_01",
      "hash64": "586592CA2580ED8C",
      "text": "[VAR 0x0100(0000)]……\\n你选择了[VAR 0x0101(0001)]……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
