          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0088_head_teacher_06",
      "hash64": "84EF32F70151D428",
      "text": "宝可梦要收进叫做精灵球的\\n道具里面哦。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
