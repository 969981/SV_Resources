          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0088_rival_06",
      "hash64": "586591CA2580EBD9",
      "text": "是的！因为那时我有其他\\n想要培育的宝可梦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0088_rival_07",
      "hash64": "586590CA2580EA26",
      "text": "现在我想和[VAR 0x0100(0000)]\\n一起迎接新的伙伴！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
