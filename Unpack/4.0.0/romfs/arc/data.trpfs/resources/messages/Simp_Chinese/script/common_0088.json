      ]
    },
    {
      "ordinal": 6,
      "label": "common_0088_head_teacher_07",
      "hash64": "84EF33F70151D5DB",
      "text": "哦？\\n妮莫同学在入学时……\\r\\n没有领到宝可梦吗？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
