    {
      "ordinal": 1,
      "label": "common_0088_head_teacher_02",
      "hash64": "84EF36F70151DAF4",
      "text": "这是你的第一只宝可梦。\\n请好好培育它。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
