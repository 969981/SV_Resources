        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0088_head_teacher_08",
      "hash64": "84EF30F70151D0C2",
      "text": "你的想法真是太棒了。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0088_head_teacher_09",
      "hash64": "84EF31F70151D275",
      "text": "请你和[VAR 0x0100(0000)]同学\\n从同一条起跑线上开始吧。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
