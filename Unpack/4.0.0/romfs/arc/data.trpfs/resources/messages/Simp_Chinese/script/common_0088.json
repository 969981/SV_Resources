    {
      "ordinal": 22,
      "label": "common_0088_head_teacher_05",
      "hash64": "84EF35F70151D941",
      "text": "妮莫同学正在海滩等你。\\n陪她对战她会很高兴的。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
