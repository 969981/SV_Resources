      ]
    },
    {
      "ordinal": 4,
      "label": "common_0088_rival_02",
      "hash64": "586595CA2580F2A5",
      "text": "跟你超～般配啊！\\n平衡性也不错嘛！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0088_rival_05",
      "hash64": "58658ECA2580E6C0",
      "text": "克拉韦尔校长！\\n可以让我也选１只吗？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
