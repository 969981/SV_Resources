      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0360_sister_02",
      "hash64": "5D54CB646FBBDB8E",
      "text": "别想使出３打１\\n这种卑鄙的手段！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
