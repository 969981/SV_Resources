      "label": "sdc01_0360_brother_14",
      "hash64": "06BAB521119A8B41",
      "text": "我也是……？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
