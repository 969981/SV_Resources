    },
    {
      "ordinal": 47,
      "label": "sdc01_0360_sister_18",
      "hash64": "5D57C7646FBE0A99",
      "text": "你有什么不满吗？\\n小心我取消你副队长的资格！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
