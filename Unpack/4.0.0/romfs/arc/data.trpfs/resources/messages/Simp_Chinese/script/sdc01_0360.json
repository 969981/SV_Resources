      "label": "sdc01_0360_select_03",
      "hash64": "799D970EFD5E1731",
      "text": "赞成！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "sdc01_0360_select_04",
      "hash64": "799D980EFD5E18E4",
      "text": "这名字……",
      "flags": 0,
