      "ordinal": 17,
      "label": "sdc01_0360_brother_03",
      "hash64": "06B7362111977D9D",
      "text": "面、面具的事，\\n我一下子气昏了头……[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
