      "label": "sdc01_0360_sister_16",
      "hash64": "5D57D1646FBE1B97",
      "text": "我们３人结成\\n“夺回面具小队”吧！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
