      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 46,
      "label": "sdc01_0360_sister_17",
      "hash64": "5D57D0646FBE19E4",
      "text": "这个主意超赞吧！\\n我特命你为副队长！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
