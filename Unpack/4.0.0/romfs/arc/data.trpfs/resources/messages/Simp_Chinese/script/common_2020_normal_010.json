          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2020_normal_010_normal_02",
      "hash64": "5D19725F176D573A",
      "text": "那个人干得出这种事来。\\n我全都猜出来了……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2020_normal_010_select_01",
      "hash64": "D91C9440602F3F4A",
      "text": "请多指教",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_2020_normal_010_select_02",
      "hash64": "D91C9340602F3D97",
      "text": "谢谢",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_normal_010_normal_03",
      "hash64": "5D19735F176D58ED",
      "text": "你太客气了……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_normal_010_normal_04",
      "hash64": "5D196C5F176D4D08",
      "text": "首席是我的上司，不过想不到\\n她居然连学生都会肆意使唤……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_normal_010_normal_05",
      "hash64": "5D196D5F176D4EBB",
      "text": "是这样啊。为了能让首席\\n参加学校的大赛，于是你来帮她……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_normal_010_normal_06",
      "hash64": "5D196E5F176D506E",
      "text": "你要是心甘情愿的话倒也罢。\\n要是我的话，肯定不干……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_normal_010_normal_07",
      "hash64": "5D196F5F176D5221",
      "text": "……………………\\n……………………[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_normal_010_normal_08",
      "hash64": "5D19685F176D463C",
      "text": "那么，让我赶快\\n把这项工作做完吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_normal_010_normal_retry",
      "hash64": "3F87283E5A69AFBE",
      "text": "让我快点\\n把这麻烦的工作做完吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2020_normal_010_normal_09",
      "hash64": "5D19695F176D47EF",
      "text": "好，我们去食堂。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
