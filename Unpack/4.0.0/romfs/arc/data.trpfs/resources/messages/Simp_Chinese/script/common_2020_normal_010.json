      "ordinal": 0,
      "label": "common_2020_normal_010_normal_01",
      "hash64": "5D19715F176D5587",
      "text": "和首席碰面的时间……\\n不请自来的稀客……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
