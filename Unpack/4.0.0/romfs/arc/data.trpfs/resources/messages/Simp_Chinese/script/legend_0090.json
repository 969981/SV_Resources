            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "legend_0090_friend_10",
      "hash64": "B8765DF0CBF860F7",
      "text": "门开了……我们走。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "legend_0090_friend_11",
      "hash64": "B8765CF0CBF85F44",
      "text": "就来个速战速决吧。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
