    {
      "ordinal": 0,
      "label": "legend_0090_friend_01",
      "hash64": "B872D8F0CBF54921",
      "text": "什么嘛，我竟然没你快！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
