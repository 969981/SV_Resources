    {
      "ordinal": 7,
      "label": "sdc01_0160_sister_12",
      "hash64": "3E1E508EF0100D3D",
      "text": "似乎获胜了呢！！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
