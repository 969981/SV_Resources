    },
    {
      "ordinal": 5,
      "label": "sdc01_0160_sister_11",
      "hash64": "3E1E4D8EF0100824",
      "text": "分数一样！？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
