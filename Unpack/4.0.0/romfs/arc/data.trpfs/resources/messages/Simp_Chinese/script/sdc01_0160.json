    },
    {
      "ordinal": 1,
      "label": "sdc01_0160_shop_02",
      "hash64": "E38FEBD94C35C448",
      "text": "你的分数是[VAR 0x0205(0001,0000)]，\\n请收下奖品～！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
