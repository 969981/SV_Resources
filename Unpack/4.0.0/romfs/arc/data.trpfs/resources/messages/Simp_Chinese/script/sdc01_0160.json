    },
    {
      "ordinal": 8,
      "label": "sdc01_0160_sister_04",
      "hash64": "3E1B4C8EF00DD09A",
      "text": "真不甘心～！虽然很想报一箭之仇，\\n但是零花钱剩得不多了……[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
