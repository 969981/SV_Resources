    {
      "ordinal": 2,
      "label": "sdc01_0160_sister_01",
      "hash64": "3E1B498EF00DCB81",
      "text": "我这个号称全村第一的\\n撞鬼气球之王……[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
