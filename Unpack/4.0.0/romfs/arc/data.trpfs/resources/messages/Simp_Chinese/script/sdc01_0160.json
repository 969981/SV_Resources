      "ordinal": 16,
      "label": "sdc01_0160_sister_09",
      "hash64": "3E1B418EF00DBDE9",
      "text": "你听好了～！我们姐弟合力，\\n绝对不会输给什么乡外人的！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
