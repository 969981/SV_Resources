    },
    {
      "ordinal": 12,
      "label": "sdc01_0160_brother_01",
      "hash64": "6F09A4184C6ECEE5",
      "text": "才……才不要。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
