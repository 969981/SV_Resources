    },
    {
      "ordinal": 9,
      "label": "sdc01_0160_sister_05",
      "hash64": "3E1B4D8EF00DD24D",
      "text": "阿栗！你来代替我\\n打败[VAR 0x0100(0000)]！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
