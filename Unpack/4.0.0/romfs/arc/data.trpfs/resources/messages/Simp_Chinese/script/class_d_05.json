          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_d_05_language_14",
      "hash64": "6D3266ECA3C6060F",
      "text": "皮卡丘的……[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_d_05_poke_03",
      "hash64": "DCDE97CD94E732B6",
      "text": "皮嘎！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "class_d_05_language_15",
      "hash64": "6D3265ECA3C6045C",
      "text": "……是愤怒的心情！\\n这是它在生气时的声音哦！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_d_05_language_16",
      "hash64": "6D3268ECA3C60975",
      "text": "刚才是我让皮卡丘\\n假装一下生气的样子！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_d_05_language_17",
      "hash64": "6D3267ECA3C607C2",
      "text": "它的演技很棒对不对？\\n大家给它送上热情的掌声吧！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_d_05_popup_01",
      "hash64": "B80FB7BCCDBC3AF3",
      "text": "啪啪啪啪啪！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "class_d_05_language_18",
      "hash64": "6D326AECA3C60CDB",
      "text": "就算是同样的宝可梦，\\n也不止有一种表达方式！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "class_d_05_language_19",
      "hash64": "6D3269ECA3C60B28",
      "text": "随着心情、身体状况的不同，\\n宝可梦发出的声音也会改变。[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "class_d_05_language_20",
      "hash64": "6D27F0ECA3BCE908",
      "text": "大家下课后仔细听一听吧！\\n这可以让你更深了解宝可梦哦！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "class_d_05_language_21",
      "hash64": "6D27F1ECA3BCEABB",
      "text": "话虽如此，但宝可梦是\\n非常非常不可思议的生物！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "class_d_05_language_22",
      "hash64": "6D27F2ECA3BCEC6E",
      "text": "其中也有一些宝可梦不用语言，\\n而是通过超音波、电磁波或心灵感应\\r\\n来与伙伴沟通的哦！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "class_d_05_language_23",
      "hash64": "6D27F3ECA3BCEE21",
      "text": "讲到这里，分享一个\\n来自赛吉的贴心小建议！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "class_d_05_language_24",
      "hash64": "6D27F4ECA3BCEFD4",
      "text": "在野餐给宝可梦洗澡澡时，\\n如果你一直捉弄宝可梦的话，\\r\\n可能就会像刚才那样惹它生气哦！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "class_d_05_language_25",
      "hash64": "6D27F5ECA3BCF187",
      "text": "那么，adios，bye bye！\\nSee you next time！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
