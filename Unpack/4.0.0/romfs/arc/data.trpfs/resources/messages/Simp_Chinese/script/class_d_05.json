    {
      "ordinal": 23,
      "label": "class_d_05_language_answer_03",
      "hash64": "CD9EAD856FD16D58",
      "text": "太～棒了！[VAR 0x0100(0000)]！\\n超级very very正确！嘿！宝可梦博士！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
