    },
    {
      "ordinal": 1,
      "label": "class_d_05_language_02",
      "hash64": "6D2EFAECA3C318B4",
      "text": "今天起就是语言学的后半段咯！\\n同学们，Are you ready？[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
