          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_language_b_09",
      "hash64": "F0BB54556890513D",
      "text": "可就算是那样，也不能\\n把它放在这里不管啊。[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
