        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_language_b_06",
      "hash64": "F0BB4555689037C0",
      "text": "用伤药的力量，\\n快快～恢复活力吧～！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
