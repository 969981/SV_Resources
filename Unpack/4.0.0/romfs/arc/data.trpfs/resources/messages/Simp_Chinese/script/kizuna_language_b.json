      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_language_b_04",
      "hash64": "F0BB475568903B26",
      "text": "对了，伤药！\\n[VAR 0x0100(0000)]你有吗！？[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
