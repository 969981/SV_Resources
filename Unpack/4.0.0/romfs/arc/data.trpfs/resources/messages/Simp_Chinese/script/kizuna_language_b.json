      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_language_b_08",
      "hash64": "F0BB535568904F8A",
      "text": "这只布拨看起来\\n好像没有训练家，\\r\\n难道是野生的宝可梦闯进了学校？[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
