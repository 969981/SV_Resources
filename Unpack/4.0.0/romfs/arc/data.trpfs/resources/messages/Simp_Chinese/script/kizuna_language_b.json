      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_language_b_07",
      "hash64": "F0BB465568903973",
      "text": "呼……看来\\n总算是化险为夷了！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
