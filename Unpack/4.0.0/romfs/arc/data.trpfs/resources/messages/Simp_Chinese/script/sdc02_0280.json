    },
    {
      "ordinal": 1,
      "label": "sdc02_0280_sister_02",
      "hash64": "A7F73F278832FAC8",
      "text": "感觉气氛很不一样啊。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
