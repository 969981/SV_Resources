      "ordinal": 7,
      "label": "sdc02_0280_brother_04",
      "hash64": "0E2F77867BEA20C6",
      "text": "就一定能在下次对战时\\n战胜[VAR 0x0100(0000)]！！[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
