      "hash64": "31D7E21AA8308EA7",
      "text": "辛苦了。[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
