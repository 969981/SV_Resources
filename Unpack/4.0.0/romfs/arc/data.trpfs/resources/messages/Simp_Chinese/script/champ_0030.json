    {
      "ordinal": 3,
      "label": "champ_0030_rival_03",
      "hash64": "E06B7DED899B1AE3",
      "text": "啊！对了，\\n你的道馆闯得怎么样了？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
