      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "champ_0030_rival_04a",
      "hash64": "F1D27CA0D29C7E19",
      "text": "啊哈哈！[VAR 0x0100(0000)]，恭喜你！\\n以你的实力，这是理所当然的～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
