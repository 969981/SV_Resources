    {
      "ordinal": 3,
      "label": "sub_025_old_m_04",
      "hash64": "E88C2F60750C668E",
      "text": "呵呵！就是它，就是它。\\n感觉和[VAR 0x0101(0001)]的距离更近了。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
