            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea4kings_hagane_sp01_03",
      "hash64": "1EB058AB4FA0AC51",
      "text": "这是我第一次来到海外，\\n其实很想玩个够……[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea4kings_hagane_sp01_04",
      "hash64": "1EB059AB4FA0AE04",
      "text": "但波琵我会把宝可梦的事\\n教给蓝莓的大家！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
