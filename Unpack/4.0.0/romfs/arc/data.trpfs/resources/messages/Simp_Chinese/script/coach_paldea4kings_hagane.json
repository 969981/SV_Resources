    },
    {
      "ordinal": 33,
      "label": "coach_paldea4kings_hagane_sp03_02c",
      "hash64": "74A27709DAB40789",
      "text": "哎呀呀～！我看起来\\n有那么像个大姐姐吗～！？[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
