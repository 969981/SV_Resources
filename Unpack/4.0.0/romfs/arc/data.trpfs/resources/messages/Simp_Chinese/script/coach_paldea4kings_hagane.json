    {
      "ordinal": 13,
      "label": "coach_paldea4kings_hagane_sp02_00",
      "hash64": "F5E55FB69A7AFC67",
      "text": "我收到邀请，\\n所以又来啦！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
