      "hash64": "F5E55DB69A7AF901",
      "text": "……波琵我和周围的人\\n有点不一样，\\r\\n所以忍不住有点担心！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
