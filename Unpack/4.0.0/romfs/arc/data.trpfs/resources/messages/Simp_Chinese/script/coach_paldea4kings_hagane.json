          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_paldea4kings_hagane_sp02_04",
      "hash64": "F5E55BB69A7AF59B",
      "text": "不知道波琵以后能不能也作为\\n学生去学校上学呀～……[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
