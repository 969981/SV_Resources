    {
      "ordinal": 7,
      "label": "coach_paldea4kings_hagane_sp01_02",
      "hash64": "1EB057AB4FA0AA9E",
      "text": "因为有联盟的人\\n陪我一起坐飞机！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
