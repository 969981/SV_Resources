  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_001_ecology_00",
      "hash64": "452959139DA13358",
      "text": "啊，[VAR 0x0100(0000)]！\\n有件小～事要处理下～\\c\\n等你整理好满满的同行宝可梦跟盒子之后，\\n我们可以来聊一聊吗～？[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
