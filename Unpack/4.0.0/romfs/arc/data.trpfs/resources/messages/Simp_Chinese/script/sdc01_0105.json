      "hash64": "0390DAB4896C949E",
      "text": "[VAR 0x0100(0000)]！\\n路特别窄，你还好吧？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
