      "ordinal": 32,
      "label": "s2_side01_0110_brother_10",
      "hash64": "D86A5F954CC3CB63",
      "text": "啊啊啊啊～！？！？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
