      "label": "s2_side01_0110_gfather_01",
      "hash64": "1897B77FB5869812",
      "text": "哦哦，是乌栗\\n和[VAR 0x0100(0000)]呀。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
