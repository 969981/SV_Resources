      "hash64": "D86A5E954CC3C9B0",
      "text": "咕呜……啊啊……[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
