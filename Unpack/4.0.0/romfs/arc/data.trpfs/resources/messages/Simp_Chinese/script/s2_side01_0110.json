      "label": "s2_side01_0110_brother_12",
      "hash64": "D86A61954CC3CEC9",
      "text": "连爷爷和奶奶都……\\n变怪了……[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
