    {
      "ordinal": 43,
      "label": "coach_paldea_botan_talkto_00",
      "hash64": "8965887284ABC5D9",
      "text": "难道[VAR 0x0100(0000)]你\\n是来找我踢场的？[VAR 0x0114(0008)]",
