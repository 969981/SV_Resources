          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "coach_paldea_botan_battleend_win_00_01",
      "hash64": "5D92E4A1292DA68A",
      "text": "我居然能和天星队之外的人\\n变得这么要好。\\r\\n能遇见[VAR 0x0100(0000)]你……真好。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "coach_paldea_botan_battleend_win_00_02",
      "hash64": "5D92E3A1292DA4D7",
      "text": "啊，我突然开始自说自话，抱歉啦！\\n不知怎的，突然就想说出这些话！\\r\\n来！这个！给你！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
