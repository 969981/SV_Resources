          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_paldea_botan_battleend_win_00_03",
      "hash64": "5D92E2A1292DA324",
      "text": "……总、总之就是这样。\\n今天星苦了～[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
