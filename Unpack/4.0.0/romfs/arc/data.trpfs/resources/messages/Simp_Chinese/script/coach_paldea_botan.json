    },
    {
      "ordinal": 41,
      "label": "coach_paldea_botan_trade_03_01",
      "hash64": "2541FE42175B1E81",
      "text": "不交换啦？\\n我和超赞的布布一起等着你哦。[VAR 0x0114(0008)]",
