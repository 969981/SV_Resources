    },
    {
      "ordinal": 40,
      "label": "coach_paldea_botan_trade_03_00",
      "hash64": "2541FD42175B1CCE",
      "text": "只有１只宝可梦的话没法交换啊。\\n同行宝可梦得有２只以上才行。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
