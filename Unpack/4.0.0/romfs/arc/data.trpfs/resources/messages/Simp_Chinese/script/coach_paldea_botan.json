    },
    {
      "ordinal": 44,
      "label": "coach_paldea_botan_cancel_00",
      "hash64": "882249ABF50D2A0A",
      "text": "我看到你的眼睛放光，\\n所以才以为是来踢场的。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
