      "hash64": "1CDF3707EDAB0EA5",
      "text": "要来继续之前没能完成的\\n宝可梦交换吗？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
