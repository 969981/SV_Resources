    {
      "ordinal": 36,
      "label": "coach_paldea_botan_trade_02_00",
      "hash64": "7A1EB33807F206DF",
      "text": "用[VAR 0x0100(0000)]你的[VAR 0x0101(0001)]\\n和我的布布交换，可以吧？[VAR 0x0114(0008)]",
