      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "coach_paldea_botan_trade_02_02",
      "hash64": "7A1EB53807F20A45",
      "text": "无法使用稀有宝可梦\\n进行交换。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "coach_paldea_botan_trade_02_03",
      "hash64": "7A1EB43807F20892",
      "text": "无法使用异色宝可梦\\n进行交换。",
