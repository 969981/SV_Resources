    },
    {
      "ordinal": 45,
      "label": "coach_paldea_botan_battlestart_00",
      "hash64": "53A189DFCDE56FE0",
      "text": "有人主动找上门来，\\n不奉陪怎么行呢。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
