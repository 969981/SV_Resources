    {
      "ordinal": 47,
      "label": "coach_paldea_botan_battleend_win_00_00",
      "hash64": "5D92E5A1292DA83D",
      "text": "哎～真是的，搞什么啊～\\n布布们被干掉了啦～[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
