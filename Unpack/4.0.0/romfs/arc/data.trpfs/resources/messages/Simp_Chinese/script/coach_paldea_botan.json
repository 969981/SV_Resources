    {
      "ordinal": 52,
      "label": "coach_paldea_botan_battleend_win_01_00",
      "hash64": "60EE0FA65209714C",
      "text": "又～被你打得布布叫了。\\n啊～要被榨干啦～[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
