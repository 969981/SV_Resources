        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc02_0235_chairman_17",
      "hash64": "2C6A28047B629973",
      "text": "要是觉得没机会使用它的话，\\n记得要还给我哦。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
