          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc02_0235_chairman_21",
      "hash64": "2C6726047B606036",
      "text": "那么，我先告辞了。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0235_brother_01",
      "hash64": "3C46D606237D94A9",
      "text": "是叫……第零区来着？\\n快出发吧，我想去。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
