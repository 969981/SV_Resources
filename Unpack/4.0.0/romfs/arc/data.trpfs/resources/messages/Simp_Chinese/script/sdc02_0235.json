          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc02_0235_chairman_18",
      "hash64": "2C6A35047B62AF8A",
      "text": "……在第零区，\\n仍有很多未解之谜。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc02_0235_chairman_19",
      "hash64": "2C6A36047B62B13D",
      "text": "虽说你去过一次最深处，\\n但对那里的地形和宝可梦，\\r\\n还是要千万小心。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc02_0235_chairman_20",
      "hash64": "2C6727047B6061E9",
      "text": "作为冠军，\\n你要带领大家行动哦。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc02_0235_ground_15",
      "hash64": "D9765EBDBDC26FF1",
      "text": "……其实辛俐我也想跟着去，\\n但工作让我走不开啊。[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc02_0235_ground_16",
      "hash64": "D9765BBDBDC26AD8",
      "text": "[VAR 0x0100(0000)]，\\n要适度地卯劲加油哦～！[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
