          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0060_fairybb_24",
      "hash64": "8269593D938B308D",
      "text": "机会难得，[VAR 0x0100(0000)]，\\n一起去上你在我们学校的第一节课吧？[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
