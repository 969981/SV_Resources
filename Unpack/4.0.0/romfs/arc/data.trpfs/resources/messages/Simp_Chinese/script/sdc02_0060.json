      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "sdc02_0060__announcement_01",
      "hash64": "10F0599633C6AC75",
      "text": "技能课就要\\n在海岸区开始了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "sdc02_0060__announcement_02",
      "hash64": "10F0569633C6A75C",
      "text": "请上课的学生\\n到海岸区集合。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "sdc02_0060_system_02",
      "hash64": "81AEFE26D775E3B7",
      "text": "咚——铛——咚——叮♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "sdc02_0060_fairybb_23",
      "hash64": "8269523D938B24A8",
      "text": "看来刚好要\\n开始上课了！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
