          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "sdc02_0060_fairybb_25",
      "hash64": "8269583D938B2EDA",
      "text": "嘻嘻嘻，\\n真是个爱学习的好学生！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
