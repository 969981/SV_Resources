    {
      "ordinal": 34,
      "label": "sdc02_0060_headbb_16",
      "hash64": "A1489F385BD23637",
      "text": "这事儿全交给白蕾雅负责了，\\n我有点不太清楚啊。[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
