    },
    {
      "ordinal": 43,
      "label": "sdc02_0060_fairybb_26",
      "hash64": "8269573D938B2D27",
      "text": "你不喜欢学习吗？\\n这个机会……很难得哦！！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
