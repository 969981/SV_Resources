      "ordinal": 44,
      "label": "sdc02_0060_fairybb_27",
      "hash64": "8269563D938B2B74",
      "text": "我帮你把巨蛋内的地图\\n添加到手机洛托姆上吧。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
