      ]
    },
    {
      "ordinal": 33,
      "label": "common_0090_head_teacher_09",
      "hash64": "F3A816A8F42144BC",
      "text": "与宝可梦有多少次相遇，就会为你们\\n带来多少次大幅成长的机会。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
