    },
    {
      "ordinal": 34,
      "label": "common_0090_head_teacher_10",
      "hash64": "F3A499A8F41E3A7E",
      "text": "请以完成图鉴为目标，\\n好好努力吧。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
