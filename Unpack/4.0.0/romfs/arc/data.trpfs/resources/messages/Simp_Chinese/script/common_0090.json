    },
    {
      "ordinal": 36,
      "label": "common_0090_head_teacher_12",
      "hash64": "F3A497A8F41E3718",
      "text": "如果妮莫同学你肯带着\\n[VAR 0x0100(0000)]同学到学院的话，\\r\\n我会很感谢你的……[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
