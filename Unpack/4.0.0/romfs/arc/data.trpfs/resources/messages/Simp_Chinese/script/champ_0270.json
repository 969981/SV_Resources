          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "champ_0270_rival_23",
      "hash64": "0D489ECEA0E0748B",
      "text": "我会在桌台市中央广场的\\n对战场等你的～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
