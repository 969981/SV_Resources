          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "champ_0270_rival_19",
      "hash64": "0D45A0CEA0DE421A",
      "text": "[VAR 0x0100(0000)]……\\n克拉韦尔校长说的课外活动，\\r\\n只属于自己的[VAR 0xFF00(0006)]寻宝[VAR 0xFF00(0000)]，你还记得吗？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
