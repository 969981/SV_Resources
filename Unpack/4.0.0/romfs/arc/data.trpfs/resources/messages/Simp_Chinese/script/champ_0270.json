          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "champ_0270_rival_answer_a02",
      "hash64": "D41EE6F3AD4C5BF0",
      "text": "那里毕竟太贴近我的生活。\\n对我来说，可能会少了些特别的感觉啊～[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "champ_0270_rival_answer_a03",
      "hash64": "D41EE7F3AD4C5DA3",
      "text": "[VAR 0x0100(0000)]，\\n还有其他的备选吗？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
