    {
      "ordinal": 23,
      "label": "champ_0270_chairman_03",
      "hash64": "02FA690BAA6F8636",
      "text": "既然你是个冠军，\\n就也要为对手多考虑一下哦。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
