          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "champ_0270_rival_20",
      "hash64": "0D489FCEA0E0763E",
      "text": "我要寻找的宝物\\n就是彼此能拿出全力来对战的\\r\\n势均力敌的劲敌……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
