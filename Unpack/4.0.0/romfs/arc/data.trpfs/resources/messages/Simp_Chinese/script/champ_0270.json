      "ordinal": 29,
      "label": "champ_0270_chairman_05",
      "hash64": "02FA6B0BAA6F899C",
      "text": "嗯……我想应该有\\n更适合二位的地方才对吧？[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
