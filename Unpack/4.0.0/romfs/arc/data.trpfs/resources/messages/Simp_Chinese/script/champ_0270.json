    {
      "ordinal": 24,
      "label": "champ_0270_rival_13",
      "hash64": "0D4596CEA0DE311C",
      "text": "呃，您说得对……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
