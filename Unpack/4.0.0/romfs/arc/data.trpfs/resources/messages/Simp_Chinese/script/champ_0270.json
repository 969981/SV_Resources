          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "champ_0270_chairman_answer_c01",
      "hash64": "4865105BA35B4C64",
      "text": "宝食堂……？那里是个\\n和二位有渊源的地方吗？[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "champ_0270_chairman_answer_c02",
      "hash64": "4865135BA35B517D",
      "text": "不是，那里是锦汇道馆的\\n对战场对吧？\\r\\n要说和青木的回忆倒是有……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "champ_0270_chairman_answer_c03",
      "hash64": "4865125BA35B4FCA",
      "text": "突然去那里的话，\\n青木大概会不乐意的……\\c\\n如果有其他合适的地方，\\n能优先选择那里吗？[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "champ_0270_rival_18",
      "hash64": "0D45A1CEA0DE43CD",
      "text": "桌台市……好啊！\\n那是我们开启冒险的地方！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
