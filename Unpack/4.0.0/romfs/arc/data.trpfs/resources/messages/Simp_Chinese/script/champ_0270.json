    {
      "ordinal": 1,
      "label": "champ_0270_rival_02",
      "hash64": "0D4215CEA0DB2012",
      "text": "就算你不说我也知道。\\n你成为冠军了吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
