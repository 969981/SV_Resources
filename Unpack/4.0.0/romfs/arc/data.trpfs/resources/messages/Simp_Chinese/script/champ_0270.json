        }
      ]
    },
    {
      "ordinal": 25,
      "label": "champ_0270_rival_14",
      "hash64": "0D4595CEA0DE2F69",
      "text": "我总是会忘了这个！对不起啊。\\n[VAR 0x0100(0000)]、[VAR 0x0101(0001)]。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
