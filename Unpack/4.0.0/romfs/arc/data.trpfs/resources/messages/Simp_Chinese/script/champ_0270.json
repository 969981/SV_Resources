      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "champ_0270_rival_answer_a01",
      "hash64": "D41EE9F3AD4C6109",
      "text": "啊哈哈！是我家后面吗？\\n我们第一次对战就是在那儿呢～[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
