          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_mushi_sp01_select_01",
      "hash64": "702ED4B3FE23108A",
      "text": "是我叫你来的",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_gym_mushi_sp01_select_02",
      "hash64": "702ED3B3FE230ED7",
      "text": "真不可思议",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_gym_mushi_sp01_02",
      "hash64": "F177A880C0FE8446",
      "text": "哎呀～是[VAR 0x0100(0000)]你\\n叫我来的～？真让人高兴呀～！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_gym_mushi_sp01_02b",
      "hash64": "4CD776C7F07A892C",
      "text": "哎呀～但你的表情\\n看上去很平静呀～\\c\\n难道是[VAR 0x0100(0000)]你\\n把我叫来的～！？[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_gym_mushi_sp01_03",
      "hash64": "F177A980C0FE85F9",
      "text": "要是那样的话～\\n就完全没有不可思议的地方了～\\r\\n呵呵呵……[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_gym_mushi_sp01_04",
      "hash64": "F177AA80C0FE87AC",
      "text": "既然我是被叫来当教员的，\\n那可得认真一点才行～！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_mushi_sp01_05",
      "hash64": "F177AB80C0FE895F",
      "text": "让我把虫宝可梦的魅力！\\n传递给学园的各位吧～！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_mushi_sp02_00",
      "hash64": "C6F9B08C0A67418F",
      "text": "[VAR 0x0100(0000)]～你听我说～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
