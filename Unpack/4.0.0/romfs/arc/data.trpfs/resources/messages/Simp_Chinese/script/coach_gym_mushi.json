          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_mushi_sp02_05",
      "hash64": "C6F9AB8C0A673910",
      "text": "在帕底亚不会出现\\n这种虫宝可梦呀～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_mushi_sp02_06",
      "hash64": "C6F9AE8C0A673E29",
      "text": "新的甜点要不就用电电虫\\n做主题来创作吧～！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_mushi_sp03_00",
      "hash64": "F3003A926BD07DBE",
      "text": "哎呀～[VAR 0x0100(0000)]～！\\n我来问～你！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
