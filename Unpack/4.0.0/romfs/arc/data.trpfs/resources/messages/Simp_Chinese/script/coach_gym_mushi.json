      "label": "coach_gym_mushi_first_01",
      "hash64": "460FACA24F6D7C8F",
      "text": "哎呀～说起来我是作为\\n道馆馆主被叫来的～？[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
