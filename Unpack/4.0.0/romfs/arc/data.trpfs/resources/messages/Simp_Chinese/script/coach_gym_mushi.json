      "hash64": "F177A680C0FE80E0",
      "text": "哎呀哎呀～\\n[VAR 0x0100(0000)]～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
