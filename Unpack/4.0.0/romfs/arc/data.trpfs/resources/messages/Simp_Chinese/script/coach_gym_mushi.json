          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_mushi_sp02_01",
      "hash64": "C6F9AF8C0A673FDC",
      "text": "我前阵子在生态巨蛋\\n悠哉悠哉地散步时～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_mushi_sp02_02",
      "hash64": "C6F9B28C0A6744F5",
      "text": "和可爱的虫宝可梦\\n有了一场美妙的邂逅～！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_mushi_sp02_03",
      "hash64": "C6F9B18C0A674342",
      "text": "它又小又可爱，\\n还拥有电属性～\\r\\n你知道那宝可梦叫什么吗～？[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
