        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_mushi_sp03_03b",
      "hash64": "B9DE3CCD3343666B",
      "text": "叮咚！你答对了～！\\n你观察我观察得很仔细嘛～！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
