          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_mushi_sp03_04",
      "hash64": "F3003E926BD0848A",
      "text": "滴蛛霸拥有水属性，\\n会栖息在水边哦～！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_mushi_sp03_05",
      "hash64": "F3003F926BD0863D",
      "text": "你要不要在散步时\\n顺便去找找它呢～！？[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_gym_mushi_trade_01_00",
      "hash64": "26172FE1E4E94C08",
      "text": "托你的福，我遇到了新的虫宝可梦。\\n真是让人乐呵呵～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_gym_mushi_trade_01_01",
      "hash64": "261730E1E4E94DBB",
      "text": "难道[VAR 0x0100(0000)]你\\n也喜欢虫宝可梦～？[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_gym_mushi_trade_01_02",
      "hash64": "261731E1E4E94F6E",
      "text": "要不来和我进行宝可梦交换～\\n培育更～多虫宝可梦吧～？[VAR 0x0114(0016)]",
