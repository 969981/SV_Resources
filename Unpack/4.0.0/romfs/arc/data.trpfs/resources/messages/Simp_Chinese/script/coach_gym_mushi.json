      "ordinal": 29,
      "label": "coach_gym_mushi_sp03_03",
      "hash64": "F30039926BD07C0B",
      "text": "哎呀～你答错了哦～\\n稍微再想想吧～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
