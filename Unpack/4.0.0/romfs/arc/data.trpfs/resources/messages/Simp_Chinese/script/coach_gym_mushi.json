    },
    {
      "ordinal": 58,
      "label": "coach_gym_mushi_randomtalk_01",
      "hash64": "F7614BF83218FF08",
      "text": "全靠派舒蕾・慕滋的\\n店员努力工作，\\r\\n我才有机会外出～\\c\\n可要好好珍视\\n肯支持自己的人啊～！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
