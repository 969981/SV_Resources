    },
    {
      "ordinal": 3,
      "label": "coach_gym_mushi_sp01_01",
      "hash64": "F177A780C0FE8293",
      "text": "没想到能在这里遇到你，\\n真是不可思议啊～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
