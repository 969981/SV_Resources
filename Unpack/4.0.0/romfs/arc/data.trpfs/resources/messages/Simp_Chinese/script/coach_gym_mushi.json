          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_mushi_sp02_04b",
      "hash64": "817AD2F5AD689F93",
      "text": "应该就是那孩子～！\\n因为它还“电电”地叫了～！[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
