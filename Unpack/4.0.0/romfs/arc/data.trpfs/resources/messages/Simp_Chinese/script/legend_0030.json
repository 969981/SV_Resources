    {
      "ordinal": 35,
      "label": "legend_0030_system_08",
      "hash64": "B772CE14A0ACE7F3",
      "text": "[VAR 0x0101(0001)]\\n学会了坐骑招式：攀崖！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
