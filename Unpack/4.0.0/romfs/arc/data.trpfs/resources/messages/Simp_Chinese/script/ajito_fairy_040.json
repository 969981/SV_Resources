          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "ajito_fairy_040_jentle_04",
      "hash64": "474977A54A121977",
      "text": "[EMPTY 85]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0055"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "ajito_fairy_040_jentle_05",
      "hash64": "474976A54A1217C4",
      "text": "……他和我有一点点交情。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "ajito_fairy_040_fairyboss_21",
      "hash64": "171C836E92DA5A86",
      "text": "[EMPTY 85]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0055"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "ajito_fairy_040_jentle_06",
      "hash64": "474979A54A121CDD",
      "text": "[EMPTY 85]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0055"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "ajito_fairy_040_nelke_01",
      "hash64": "9D4A6DAA47F5949D",
      "text": "叫我聂凯吧。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "ajito_fairy_040_fairyboss_22",
      "hash64": "171C826E92DA58D3",
      "text": "哦……你的目的是什么？[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "ajito_fairy_040_nelke_02",
      "hash64": "9D4A6AAA47F58F84",
      "text": "你是服装公司的公子……\\n有这样的背景，为何还要加入天星队？[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "ajito_fairy_040_fairyboss_23",
      "hash64": "171C816E92DA5720",
      "text": "一上来就问人问题，真没礼貌。\\n理由和其他队员一样。\\r\\n因为我也一直被人霸凌……[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "ajito_fairy_040_nelke_03",
      "hash64": "9D4A6BAA47F59137",
      "text": "看来学院里\\n果然有霸凌行为啊……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "ajito_fairy_040_fairyboss_24",
      "hash64": "171C886E92DA6305",
      "text": "你不知道也很正常。\\n毕竟现在整个学校都很太平。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "ajito_fairy_040_fairyboss_25",
      "hash64": "171C876E92DA6152",
      "text": "而且那些爱霸凌人的学生\\n都已经退学了。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "ajito_fairy_040_nelke_04",
      "hash64": "9D4A68AA47F58C1E",
      "text": "……这是怎么回事？[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "ajito_fairy_040_jentle_07",
      "hash64": "474978A54A121B2A",
      "text": "……关于这一点，就由我这个\\n上一任校长来说明吧。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "ajito_fairy_040_fairyboss_26",
      "hash64": "171C866E92DA5F9F",
      "text": "……老管家。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "ajito_fairy_040_jentle_08",
      "hash64": "47496BA54A120513",
      "text": "大约在１年半之前，\\n天星队和霸凌他们的学生之间\\r\\n发生了一场骚动。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "ajito_fairy_040_jentle_09",
      "hash64": "47496AA54A120360",
      "text": "虽然事情没有闹到不可收拾，\\n但也是一件前所未闻的大事件。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "ajito_fairy_040_jentle_10",
      "hash64": "4745EDA54A0EF922",
      "text": "这件事导致的结果是\\n身为霸凌的加害者的学生们\\r\\n在那之后退学了。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "ajito_fairy_040_nelke_05",
      "hash64": "9D4A69AA47F58DD1",
      "text": "可是学院里没有那样的记录……！[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "ajito_fairy_040_jentle_11",
      "hash64": "4745EEA54A0EFAD5",
      "text": "想必也是没有吧……\\n因为记录被当时的\\r\\n教导主任删掉了……[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "ajito_fairy_040_nelke_06",
      "hash64": "9D4A66AA47F588B8",
      "text": "删掉了记录！？\\n天啊，居然会发生这种事……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "ajito_fairy_040_jentle_12",
      "hash64": "4745EBA54A0EF5BC",
      "text": "在我正愁于如何处置天星队的时候，\\n有个学生出现在了我的面前。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "ajito_fairy_040_jentle_13",
      "hash64": "4745ECA54A0EF76F",
      "text": "那个学生说\\n自己会为天星队负全责。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "ajito_fairy_040_jentle_14",
      "hash64": "4745E9A54A0EF256",
      "text": "作为交换条件，那个学生\\n请求我免除对伙伴们的处分。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 66,
      "label": "ajito_fairy_040_fairyboss_27",
      "hash64": "171C856E92DA5DEC",
      "text": "咦！？这种事……！\\n根本没听说过啊……！！[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 67,
      "label": "ajito_fairy_040_jentle_15",
      "hash64": "4745EAA54A0EF409",
      "text": "我接受了那个学生的请求，\\n打消了处分天星队的念头。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 68,
      "label": "ajito_fairy_040_jentle_16",
      "hash64": "4745E7A54A0EEEF0",
      "text": "然后，我要求那个学生\\n进行为期１年半的留学。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 69,
      "label": "ajito_fairy_040_nelke_07",
      "hash64": "9D4A67AA47F58A6B",
      "text": "１年半……？留学……？[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 70,
      "label": "ajito_fairy_040_jentle_17",
      "hash64": "4745E8A54A0EF0A3",
      "text": "……用来代替处分。\\n天星队是霸凌行为的受害者。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 71,
      "label": "ajito_fairy_040_jentle_18",
      "hash64": "4745F5A54A0F06BA",
      "text": "我希望让那个学生的心灵\\n得到休息，于是以留学的名义\\r\\n让他回到了他的老家伽勒尔地区。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 72,
      "label": "ajito_fairy_040_jentle_19",
      "hash64": "4745F6A54A0F086D",
      "text": "就在那时，当时的教导主任\\n为了逃避自己的责任，\\c\\n把和事件相关的记录\\n都从服务器上删掉了……[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 73,
      "label": "ajito_fairy_040_nelke_08",
      "hash64": "9D4A64AA47F58552",
      "text": "岂有此理！\\n他居然隐瞒了真相吗……！[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 74,
      "label": "ajito_fairy_040_jentle_20",
      "hash64": "474267A54A0BDF99",
      "text": "当然，我对教导主任\\n做出了应有的处分。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 75,
      "label": "ajito_fairy_040_jentle_21",
      "hash64": "474266A54A0BDDE6",
      "text": "但是，没能制止\\n这种行为的我以及\\r\\n其他老师也有同样的责任……[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 76,
      "label": "ajito_fairy_040_jentle_24",
      "hash64": "47426BA54A0BE665",
      "text": "于是为了承担责任，\\n我辞去了校长一职。\\c\\n也请当时所有的老师\\n也一起辞职了。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 77,
      "label": "ajito_fairy_040_nelke_09",
      "hash64": "9D4A65AA47F58705",
      "text": "所以１年半前\\n老师们才会大换血啊……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 78,
      "label": "ajito_fairy_040_jentle_22",
      "hash64": "474265A54A0BDC33",
      "text": "我给大家添麻烦了啊。[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 79,
      "label": "ajito_fairy_040_fairyboss_28",
      "hash64": "171C8C6E92DA69D1",
      "text": "老管家，\\n为什么你现在会说这个？[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 80,
      "label": "ajito_fairy_040_jentle_23",
      "hash64": "474264A54A0BDA80",
      "text": "……不管是少爷还是天星队，\\n再这样下去可不行。\\r\\n我希望这能成为一个契机……[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 81,
      "label": "ajito_fairy_040_fairyboss_29",
      "hash64": "171C8B6E92DA681E",
      "text": "事到如今，背叛伙伴自己一个人\\n去学校这种事是无法想象的。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 82,
      "label": "ajito_fairy_040_nelke_10",
      "hash64": "9D4DD2AA47F87613",
      "text": "看来你真的很重视\\n天星队的各位啊。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 83,
      "label": "ajito_fairy_040_fairyboss_30",
      "hash64": "1718FE6E92D742B0",
      "text": "那还用说。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 84,
      "label": "ajito_fairy_040_fairyboss_31",
      "hash64": "1718FF6E92D74463",
      "text": "毕竟他们……都是我的宝物啊。[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
