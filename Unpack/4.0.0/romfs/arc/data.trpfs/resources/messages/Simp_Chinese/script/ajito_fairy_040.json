        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0055"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "ajito_fairy_040_jentle_03",
      "hash64": "474974A54A12145E",
      "text": "[EMPTY 85]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
