            "0055"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "ajito_fairy_040_fairyboss_20",
      "hash64": "171C846E92DA5C39",
      "text": "[EMPTY 85]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
