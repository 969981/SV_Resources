          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
