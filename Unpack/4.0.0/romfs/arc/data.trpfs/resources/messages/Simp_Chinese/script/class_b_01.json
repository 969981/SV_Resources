          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_b_01_math_answer_03",
      "hash64": "1723DA85F3F44AA2",
      "text": "没错！答得非常好！\\n不愧是[VAR 0x0100(0000)]你呢！[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_b_01_math_10",
      "hash64": "57EA8415A020A0A1",
      "text": "只要使出的招式属性是对方的弱点，\\n那就是效果绝佳！\\r\\n给予的伤害会变成２倍。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_b_01_math_11",
      "hash64": "57EA8315A0209EEE",
      "text": "相反，如果是对方擅长的属性，\\n那就会效果不好……\\r\\n伤害只有通常的一半。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_b_01_math_12",
      "hash64": "57EA8215A0209D3B",
      "text": "哦呵呵！这更像是对战学的内容，\\n虽然对凰檗老师有些抱歉，\\r\\n但我想如果拿宝可梦对战来举例的话……[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_b_01_math_13",
      "hash64": "57EA8115A0209B88",
      "text": "就算是你们不太喜欢的数学，\\n也能让大家一起乐在其中，对吧？[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_b_01_math_14",
      "hash64": "57EA8815A020A76D",
      "text": "哎呀，下课铃响了？\\n已经到时间了呀，真可惜……[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_b_01_math_15",
      "hash64": "57EA8715A020A5BA",
      "text": "我会发自内心地期待\\n下次继续和大家一起学习哦。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
