    {
      "ordinal": 2,
      "label": "s1_sub_021_gmother_02",
      "hash64": "5B28E3DD088D7CF2",
      "text": "丹瑜和乌栗\\n已经穿不下这个尺码了。[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
