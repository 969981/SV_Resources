    },
    {
      "ordinal": 3,
      "label": "s1_sub_021_gmother_03",
      "hash64": "5B28E4DD088D7EA5",
      "text": "虽然和他俩的衣服颜色一样，\\n但这些不是穿剩的旧衣服，放心好了。[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
