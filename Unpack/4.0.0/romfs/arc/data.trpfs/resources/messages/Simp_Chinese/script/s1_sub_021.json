            "0037"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_021_gmother_04",
      "hash64": "5B28DDDD088D72C0",
      "text": "孩子真是\\n说长大就长大啊～呵呵。[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
