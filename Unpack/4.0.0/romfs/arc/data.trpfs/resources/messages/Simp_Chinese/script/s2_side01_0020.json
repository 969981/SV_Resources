    {
      "ordinal": 0,
      "label": "s2_side01_0020_rival_00",
      "hash64": "F20981A16E90F844",
      "text": "虽然我们是突然来打扰，\\n却还是享用了一顿美餐呢！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
