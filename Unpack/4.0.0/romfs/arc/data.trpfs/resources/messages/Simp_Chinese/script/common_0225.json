      "label": "common_0225_rival_16",
      "hash64": "B940151B985C2F95",
      "text": "[VAR 0x0100(0000)]，了不起！\\n看来你为她解围了啊。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
