          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "common_0225_rival_24",
      "hash64": "B936211B9853EF74",
      "text": "和太晶属性同属性的招式\\n会变得更强！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "common_0225_rival_25",
      "hash64": "B936221B9853F127",
      "text": "偶尔也会有宝可梦太晶化为\\n完全不同的属性，\\r\\n所以这会大大提升战术的灵活度！\\c\\n太晶化之后，太晶珠就会暂时无法使用。\\n要去宝可梦中心蓄能哦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
