          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "common_0225_rival_15",
      "hash64": "B940121B985C2A7C",
      "text": "他们出席率很低，\\n还会成群结队地飙车，\\r\\n老师们似乎也都对他们很头疼。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
