          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "common_0225_sitappa_b_11",
      "hash64": "0EE2FF3AC5DB6869",
      "text": "那、那么，我就先告辞了！\\n今天星苦了～！[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "common_0225_sitappa_a_10",
      "hash64": "37B4802F7B066B19",
      "text": "我也先失陪了！\\n今天星苦了～！[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
