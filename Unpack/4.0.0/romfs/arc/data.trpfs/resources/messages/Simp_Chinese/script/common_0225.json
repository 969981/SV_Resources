          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0225_sitappa_b_01",
      "hash64": "0EE6033AC5DDA50C",
      "text": "你到底要怎样？\\n就不想和伙伴们一起度过耀眼的青春吗！？[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0225_botan_02",
      "hash64": "4C08219FF9AD0D82",
      "text": "…………不想。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0225_sitappa_a_02",
      "hash64": "37B17C2F7B042E76",
      "text": "我们劝人入队可是有指标的！\\n你就快点加入天星队吧！[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0225_botanl_02",
      "hash64": "1575D05F6C1DC3F8",
      "text": "这……伤脑筋啊。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0225_select_01",
      "hash64": "761BE9D65A99502B",
      "text": "帮忙",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_0225_select_02",
      "hash64": "761BEAD65A9951DE",
      "text": "静观",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_0225_sitappa_b_02",
      "hash64": "0EE6063AC5DDAA25",
      "text": "嗯？你有事要找天星队吗！？[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0225_sitappa_b_03",
      "hash64": "0EE6053AC5DDA872",
      "text": "要是想入队的话，就稍等一下！\\n我们现在正和她谈着呢！[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0225_sitappa_a_03",
      "hash64": "37B17D2F7B043029",
      "text": "我们是让爱哭的孩子都能笑呵呵的天星队。\\n你知道我们，没错吧？[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0225_sitappa_a_04",
      "hash64": "37B17E2F7B0431DC",
      "text": "既然你都知道，怎么还这个态度？\\n不是说只要加入天星队，大家就会怕我，\\r\\n然后有机会爬到最上面去吗？[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0225_sitappa_a_05",
      "hash64": "37B17F2F7B04338F",
      "text": "怎么回事？连你也是这个样子……\\n特地加入天星队，却落到这个地步，\\r\\n那我岂不是还在最底层？[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0225_sitappa_b_04",
      "hash64": "0EE6003AC5DD9FF3",
      "text": "总是被人看扁的话，\\n天星队的脸面该往哪搁！\\r\\n只能对战！不得不这样，不是吗？[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0225_sitappa_a_06",
      "hash64": "37B1802F7B043542",
      "text": "说得对啊！你就盯好\\n最开始的那个戴眼镜的吧！[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0225_sitappa_a_07",
      "hash64": "37B1812F7B0436F5",
      "text": "至于这个自大的新面孔，\\n就让我来把[VAR 0x1100(00FF,0101)]他她变成星星吧！[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0225_sitappa_a_08",
      "hash64": "37B1822F7B0438A8",
      "text": "这个新面孔是怎么回事？\\n贼厉害啊……[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0225_sitappa_b_05",
      "hash64": "0EE5FF3AC5DD9E40",
      "text": "我的后辈输了……！？[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0225_sitappa_b_06",
      "hash64": "0EE6023AC5DDA359",
      "text": "既然如此，只好让我这个前辈\\n来会会你了……！？[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_0225_rival_01",
      "hash64": "B93CAA1B985943ED",
      "text": "你们几个！\\n在搞什么啊～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0225_sitappa_a_09",
      "hash64": "37B1832F7B043A5B",
      "text": "呃，是学生会长……[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "common_0225_sitappa_b_07",
      "hash64": "0EE6013AC5DDA1A6",
      "text": "被一个麻烦的家伙发现了……[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "common_0225_rival_02",
      "hash64": "B93CA71B98593ED4",
      "text": "[VAR 0x0100(0000)]！\\n真是的！你不能这样！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "common_0225_rival_03",
      "hash64": "B93CA81B98594087",
      "text": "要宝可梦对战的话，\\n你的对手应该是本、姑、娘！\\r\\n……对吧！？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "common_0225_select_03",
      "hash64": "761BEBD65A995391",
      "text": "不是这码事……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "common_0225_select_04",
      "hash64": "761BECD65A995544",
      "text": "天星队的人……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "common_0225_rival_04",
      "hash64": "B93CA51B98593B6E",
      "text": "咦！？啊，对不起！\\n是我误会了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "common_0225_rival_05",
      "hash64": "B93CA61B98593D21",
      "text": "还真的！\\n仔细一看，原来是天星队！\\r\\n又在强行劝人入队！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "common_0225_sitappa_b_08",
      "hash64": "0EE60C3AC5DDB457",
      "text": "嗯，没错，你好。[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "common_0225_rival_06",
      "hash64": "B93CA31B98593808",
      "text": "……原来如此！本来呢，\\n身为学生会长，我是有义务\\r\\n来平息这个纠纷的。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "common_0225_rival_07",
      "hash64": "B93CA41B985939BB",
      "text": "但是机会难得！[VAR 0x0100(0000)]，\\n你就用这个超级秘密道具，把事情解决了吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "common_0225_rival_19",
      "hash64": "B940161B985C3148",
      "text": "只要拥有太晶珠，\\n就能在对战中将宝可梦\\r\\n[VAR 0xFF00(0006)]太晶化[VAR 0xFF00(0000)]！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
