          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "common_0225_rival_14",
      "hash64": "B940131B985C2C2F",
      "text": "所谓的天星队，\\n是由一群调皮的学生组成的。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
