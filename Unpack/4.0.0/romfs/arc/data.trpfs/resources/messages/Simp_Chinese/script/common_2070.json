          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2070_rival_04a",
      "hash64": "36FEABCD000213EF",
      "text": "你的反应真爽快！\\n我想要见识一下你身为冠军的实力！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2070_rival_04b",
      "hash64": "36FEACCD000215A2",
      "text": "啊哈哈！你就知道开玩笑！\\n睡糊涂了吧～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
