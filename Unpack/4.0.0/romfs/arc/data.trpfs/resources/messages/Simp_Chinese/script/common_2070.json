      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2070_rival_05",
      "hash64": "8753C158BF43B067",
      "text": "[VAR 0x0100(0000)]，多亏了你，\\n首席才能作为嘉宾参赛，真是太棒了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
