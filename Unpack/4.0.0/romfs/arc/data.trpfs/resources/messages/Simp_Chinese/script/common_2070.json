    {
      "ordinal": 2,
      "label": "common_2070_rival_09",
      "hash64": "8753B558BF439C03",
      "text": "啊，大赛的名称？\\n我管它叫“校内最强大赛”！\\r\\n很简单易懂吧～？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
