      "hash64": "F15AB6CD7B82D4C0",
      "text": "亲爱的同学们！\\n今天的心情是不是最棒的呀！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
