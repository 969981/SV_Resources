          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
