          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_d_02_language_04",
      "hash64": "F15ABBCD7B82DD3F",
      "text": "上一堂课我教了各位\\n各种语言的“谢谢”，对吧！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_02_language_05",
      "hash64": "F15ABACD7B82DB8C",
      "text": "而today的主题呢，就选一个\\n在国外说了会让人开心的词语，\\r\\n来一堂赛吉的语言课吧！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_d_02_language_06",
      "hash64": "F15ABDCD7B82E0A5",
      "text": "那么，我开始咯……！\\nDelicious！おいしい！Buono！\\r\\n有人知道这些是什么意思吗？[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
