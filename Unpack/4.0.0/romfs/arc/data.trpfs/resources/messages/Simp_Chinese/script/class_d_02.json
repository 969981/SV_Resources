    },
    {
      "ordinal": 1,
      "label": "class_d_02_language_02",
      "hash64": "F15AB9CD7B82D9D9",
      "text": "赛吉的语言学要开始咯。\\nAre you ready？\\r\\n用“是”或“Yes”来回答吧！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
