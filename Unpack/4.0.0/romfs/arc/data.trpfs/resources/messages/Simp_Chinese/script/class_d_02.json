          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_d_02_language_answer_03",
      "hash64": "DE6A8C54C60CC733",
      "text": "Oh～[VAR 0x0100(0000)]！\\n我收到[VAR 0x0100(0000)]的SOS了！\\r\\n虽然是wrong answer，但我感受到了！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
