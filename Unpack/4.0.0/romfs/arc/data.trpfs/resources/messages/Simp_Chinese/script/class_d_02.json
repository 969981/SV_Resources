          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_d_02_language_answer_02",
      "hash64": "DE6A8B54C60CC580",
      "text": "Oh～[VAR 0x0100(0000)]！\\n对不起有用的话，还要警察做什么！\\r\\n很可惜，那是wrong answer！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
