      "hash64": "30B8D53961E44EA3",
      "text": "对不起",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_d_02_select_03",
      "hash64": "30B8D43961E44CF0",
      "text": "救救我",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_d_02_language_answer_01",
      "hash64": "DE6A8E54C60CCA99",
      "text": "Oh～超级very very正确！\\n真不愧是[VAR 0x0100(0000)]！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
