  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_014_header_01",
      "hash64": "5C51C3C3E118F228",
      "text": "欢迎你，\\n这位帕底亚的同学。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s1_sub_014_header_02",
      "hash64": "5C51C6C3E118F741",
      "text": "我们北上公民馆\\n正在助力观光事业。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_014_header_03",
      "hash64": "5C51C5C3E118F58E",
      "text": "用手中的手机洛托姆\\n打开包包等页面时的\\r\\n上下边框颜色！\\c\\n现在会根据\\n所在的地图改变颜色哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_014_header_09",
      "hash64": "5C51BBC3E118E490",
      "text": "手机洛托姆的上下边框颜色！\\n要更改设置吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_014_header_04",
