    {
      "ordinal": 9,
      "label": "s1_sub_014_header_12",
      "hash64": "5C4E3CC3E115D6EC",
      "text": "我帮你设置成\\n根据地图变色了哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
