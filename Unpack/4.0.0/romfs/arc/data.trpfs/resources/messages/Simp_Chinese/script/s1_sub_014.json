    {
      "ordinal": 6,
      "label": "s1_sub_014_header_14",
      "hash64": "5C4E3AC3E115D386",
      "text": "那么就维持现在的设置\\n继续享受北上观光之旅吧。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_014_header_06",
      "hash64": "5C51CAC3E118FE0D",
      "text": "我帮你设置成\\n帕底亚色了哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
