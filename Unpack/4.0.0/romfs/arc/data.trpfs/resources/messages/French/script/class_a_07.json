      "label": "class_a_07_ecology_01",
      "hash64": "8C1247CA4CA11B3C",
      "text": "Bonjour, les enfants ! J’espère qu’il vous tarde\\nd’en apprendre plus sur la biologie ![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
