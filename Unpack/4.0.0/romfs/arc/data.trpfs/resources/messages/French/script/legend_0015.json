  "entries": [
    {
      "ordinal": 0,
      "label": "legend_0015_system_01",
      "hash64": "2ABC17BB8F9E8665",
      "text": "Motiti ♪ Motiti ♪ Motiti ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "legend_0015_cassiopeia_01",
      "hash64": "357DB39716622F2B",
      "text": "... Allô, [VAR 0x0100(0000)] ?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "legend_0015_cassiopeia_02",
      "hash64": "357DB497166230DE",
      "text": "J’ai piraté ton téléphone vite fait pour te parler.\\nJ’espère que ça ne te dérange pas.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "legend_0015_select_01",
      "hash64": "AECA47BE2224E1A2",
      "text": "C’est qui ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "legend_0015_select_02",
      "hash64": "AECA46BE2224DFEF",
      "text": "Comment ça, « piraté » ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "legend_0015_cassiopeia_03",
      "hash64": "357DB59716623291",
      "text": "Disons que j’ai temporairement pris le contrôle\\nde ton appareil.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "legend_0015_cassiopeia_04",
      "hash64": "357DB69716623444",
      "text": "Mon nom est Cassiopée.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "legend_0015_cassiopeia_05",
      "hash64": "357DB797166235F7",
      "text": "Je sais déjà qui tu es.\\nTu es un[VAR 0x1100(00FF,0100)]e Dresseu[VAR 0x1100(00FF,0201)]rse doté[VAR 0x1100(00FF,0100)]e d’un grand talent.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0201"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "legend_0015_cassiopeia_06",
      "hash64": "357DB897166237AA",
      "text": "Et je souhaite que tu te serves de ce talent pour\\nm’aider à accomplir une tâche.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "legend_0015_cassiopeia_07",
      "hash64": "357DB9971662395D",
      "text": "Tu connais la Team Star, n’est-ce pas ?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "legend_0015_cassiopeia_14",
      "hash64": "35813C9716654DCD",
      "text": "... Ce n’est pas beau de mentir.\\nTu l’as déjà croisée. Je le sais.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "legend_0015_cassiopeia_15",
      "hash64": "35813B9716654C1A",
      "text": "... Merci pour ton honnêteté.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "legend_0015_cassiopeia_08",
      "hash64": "357DAA9716621FE0",
      "text": "La Team Star est un groupe de délinquants\\ncomposé d’élèves de l’académie.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "legend_0015_cassiopeia_09",
      "hash64": "357DAB9716622193",
      "text": "Ils ne respectent pas la discipline de l’école\\net ne font que causer des problèmes.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "legend_0015_cassiopeia_10",
      "hash64": "3581389716654701",
      "text": "On ne peut pas rester sans rien faire à leur\\négard... C’est pourquoi j’ai décidé d’agir ![VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "legend_0015_cassiopeia_11",
      "hash64": "358137971665454E",
      "text": "Je veux démanteler leur organisation pour\\nla réduire en poussière.\\c\\nPour cela, j’ai élaboré un plan que j’appelle\\nl’Opération Stardust ![VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "legend_0015_cassiopeia_12",
      "hash64": "358136971665439B",
      "text": "J’ai besoin d’un[VAR 0x1100(00FF,0100)]e associé[VAR 0x1100(00FF,0100)]e pour cette opération,\\net je veux que ce soit toi.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "legend_0015_cassiopeia_13",
      "hash64": "35813597166541E8",
      "text": "... Inutile de me répondre tout de suite. Je te\\nrecontacterai plus tard pour te parler des détails.\\c\\nSalut.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
