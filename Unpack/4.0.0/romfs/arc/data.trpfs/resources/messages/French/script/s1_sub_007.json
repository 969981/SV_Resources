      ]
    },
    {
      "ordinal": 18,
      "label": "s1_sub_007_man_05",
      "hash64": "440A6CEDEC31C42D",
      "text": "Allez ! C’est vrai que Paldea Immobilier est\\nune société blanche comme neige !\\c\\nTu es un modèle de vertu pour tous\\nles influenceurs, Naire ![VAR 0x0114(0040)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_sub_007_man_06",
      "hash64": "440A69EDEC31BF14",
      "text": "Il y a une montagne enneigée où nous pourrions\\nnous délecter de crème glacée tout en admirant\\r\\nles Pokémon de type Glace ![VAR 0x0114(0040)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
