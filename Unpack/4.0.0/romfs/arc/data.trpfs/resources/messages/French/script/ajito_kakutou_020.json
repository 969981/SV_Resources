  "entries": [
    {
      "ordinal": 0,
      "label": "ajito_kakutou_020_system_01",
      "hash64": "0B61EF4F3E66C368",
      "text": "Motiti ♪ Motiti ♪ Motiti ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "ajito_kakutou_020_cassiopeia_01",
      "hash64": "781BBADBBA8A3082",
      "text": "Ça y est, tu as libéré l’entrée ? Bravo.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_kakutou_020_cassiopeia_02",
      "hash64": "781BB9DBBA8A2ECF",
      "text": "Ici, c’est le repaire de l’équipe Combat\\nde la Team Star... Le Groupe Caph.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_kakutou_020_cassiopeia_03",
      "hash64": "781BB8DBBA8A2D1C",
      "text": "Nèflie, la boss du groupe, est une athlète\\nqui pratique le catch.\\c\\nC’est elle qui a entraîné tous les membres\\nde la Team Star.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_kakutou_020_cassiopeia_04",
      "hash64": "781BB7DBBA8A2B69",
      "text": "Je pense que notre lettre de défi a dû éveiller\\nsa méfiance.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_kakutou_020_cassiopeia_05",
      "hash64": "781BB6DBBA8A29B6",
      "text": "Elle sera en première ligne si des intrus\\ns’approchent de son repaire.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_kakutou_020_select_01",
      "hash64": "27F32B7B4AAD33F3",
      "text": "Effectivement, elle était là.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_kakutou_020_select_02",
      "hash64": "27F32C7B4AAD35A6",
      "text": "Je l’ai déjà croisée.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "ajito_kakutou_020_cassiopeia_06",
      "hash64": "781BB5DBBA8A2803",
      "text": "Tu l’as vue ?!\\nAlors ? Comment ça s’est passé ?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_kakutou_020_cassiopeia_07",
      "hash64": "781BB4DBBA8A2650",
      "text": "Elle... elle a fui ?!\\nMais... ça ne lui ressemble pas ![VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_kakutou_020_cassiopeia_08",
      "hash64": "781BC3DBBA8A3FCD",
      "text": "Dans ce cas, tu vas devoir mener une attaque\\nfrontale. Il n’y a pas d’autre choix.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_kakutou_020_cassiopeia_09",
      "hash64": "781BC2DBBA8A3E1A",
      "text": "[EMPTY 18]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
