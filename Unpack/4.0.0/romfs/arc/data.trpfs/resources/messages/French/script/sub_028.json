  "paired_tbl": "message/dat/French/script/sub_028.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_028_middlef_00",
      "hash64": "D1EDE1F9BC47230F",
      "text": "Oh, ça alors... J’ai l’impression que tes existences\\npassées ont été riches en aventures !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_028_middlef_01",
      "hash64": "D1EDE0F9BC47215C",
      "text": "Je suis capable de visualiser tes vies antérieures\\nau simple contact de ton Motismart.\\c\\nJ’appelle cela la Motismancie.\\nDésires-tu essayer ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_028_middlef_02",
      "hash64": "D1EDE3F9BC472675",
      "text": "Hmmm... Il vaut sans doute mieux s’abstenir.\\nLes arts divinatoires peuvent être effrayants.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_028_middlef_03",
      "hash64": "D1EDE2F9BC4724C2",
      "text": "Oui... Je vois... un aperçu d’une de tes vies\\npassées... Je vois... un des lieux où tu as vécu... !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_028_select_a",
      "hash64": "35D0BFAD69D0E96D",
      "text": "La région de Kanto ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_028_select_b",
      "hash64": "35D0BCAD69D0E454",
      "text": "La région de Galar ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_028_select_c",
      "hash64": "35D0BDAD69D0E607",
      "text": "La région de Sinnoh ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_028_select_d",
      "hash64": "35D0BAAD69D0E0EE",
      "text": "La région de Hisui ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_028_select_e",
      "hash64": "35D0BBAD69D0E2A1",
      "text": "Ça ira, merci...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_028_middlef_04",
      "hash64": "D1EDDDF9BC471C43",
      "text": "Oui, ma vision est limpide !\\nDans une vie antérieure, tu as...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_028_middlef_a",
      "hash64": "036CE3FECEFF3FC2",
      "text": "Tu as sillonné Kanto avec ton partenaire !\\nTu l’encourageais d’ailleurs avec une drôle\\r\\nde phrase : « Let’s go ! »",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sub_028_middlef_b",
      "hash64": "036CE2FECEFF3E0F",
      "text": "Tu as exploré Galar et relevé d’incroyables défis\\naux côtés de gigantesques Pokémon Dynamax !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_028_middlef_c",
      "hash64": "036CE1FECEFF3C5C",
      "text": "Tu as parcouru les souterrains de Sinnoh et suscité\\nl’admiration au Super Show Concours !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_028_middlef_d",
      "hash64": "036CE0FECEFF3AA9",
      "text": "Tu as vécu des aventures extraordinaires\\navec un étrange téléphone à la main !\\c\\nMais... c’est où, Hisui ? Je n’avais jamais entendu\\nparler de cette région...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_028_middlef_05",
      "hash64": "D1EDDCF9BC471A90",
      "text": "Merci de m’avoir permis de me plonger\\ndans une de tes vies antérieures.\\c\\nJe vais te confectionner une coque de téléphone\\nqui reflète tes souvenirs.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sub_028_middlef_06",
      "hash64": "D1EDDFF9BC471FA9",
      "text": "Attends un instant...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_028_middlef_07",
      "hash64": "D1EDDEF9BC471DF6",
      "text": "Voilà, ta coque est prête !\\nJ’espère qu’elle te plaît.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sub_028_system_a",
      "hash64": "4AF36B673E33A1D0",
      "text": "Vous obtenez la [VAR 0xFF00(0008)]Coque Pika-voli[VAR 0xFF00(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sub_028_system_b",
      "hash64": "4AF36E673E33A6E9",
      "text": "Vous obtenez la [VAR 0xFF00(0008)]Coque Ball Masqué[VAR 0xFF00(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sub_028_system_c",
      "hash64": "4AF36D673E33A536",
      "text": "Vous obtenez la [VAR 0xFF00(0008)]Coque Pokémontre[VAR 0xFF00(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sub_028_system_d",
      "hash64": "4AF370673E33AA4F",
      "text": "Vous obtenez la [VAR 0xFF00(0008)]Coque Smarceus[VAR 0xFF00(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sub_028_middlef_08",
      "hash64": "D1EDE9F9BC4730A7",
      "text": "Si tu souhaites te replonger dans tes vies\\nantérieures, reviens me voir.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sub_028_middlef_09",
      "hash64": "D1EDE8F9BC472EF4",
      "text": "Tu en as vécu, des aventures dans tes vies\\npassées ! Merci d’avoir fait appel à moi !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "sub_028_middlef_10",
      "hash64": "D1EA5BF9BC440986",
      "text": "Est-ce que tes coques de téléphone te plaisent ?\\nJ’espère qu’elles te rappellent de bons souvenirs.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
