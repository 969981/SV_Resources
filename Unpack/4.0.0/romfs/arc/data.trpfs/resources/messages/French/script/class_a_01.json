  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "class_a_01_ecology_01",
      "hash64": "6B6041D212741466",
      "text": "Bonjour, les enfants ! Mon nom est monsieur Jacq.\\nJe suis votre professeur de biologie.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_a_01_ecology_02",
      "hash64": "6B6040D2127412B3",
      "text": "Comptez sur moi pour vous apprendre tout\\nce qu’il y a à savoir sur nos amis les Pokémon.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_a_01_ecology_03",
      "hash64": "6B603FD212741100",
      "text": "Si vous pouvez aimer ces créatures encore un peu\\nplus grâce à moi, je crois que je serai comblé ![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_a_01_ecology_04",
      "hash64": "6B6046D212741CE5",
      "text": "Ce que je vais vous enseigner aujourd’hui va\\nvous permettre de mieux connaître les Pokémon.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_a_01_ecology_05",
      "hash64": "6B6045D212741B32",
      "text": "Si vous voulez devenir plus proche d’un\\nde vos Pokémon...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_a_01_ecology_06",
      "hash64": "6B6044D21274197F",
      "text": "... il suffit de le faire sortir de sa Poké Ball\\net de vous promener avec lui.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_a_01_ecology_07",
      "hash64": "6B6043D2127417CC",
      "text": "Pour cela, vous devrez appuyer sur le [VAR 0xFF00(0006)]bouton ZR[VAR 0xFF00(0000)].\\c\\nJ’ai d’ailleurs une formule pour m’en souvenir :\\n« Bouton ZR appuyé, Poké Ball lancée ! »\\c\\nVotre Pokémon restera derrière vous et vous\\nsuivra sans faute. Je trouve ça très mignon ![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 242,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_a_01_ecology_08",
      "hash64": "6B604AD2127423B1",
      "text": "Essayez de lui adresser la parole de temps\\nen temps. Je suis sûr qu’il vous répondra !\\c\\nEt, qui sait, peut-être apprendrez-vous à mieux\\nle connaître en interagissant ainsi avec lui ![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 184,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_a_01_ecology_09",
      "hash64": "6B6049D2127421FE",
      "text": "Mais attention : il y a certains endroits où il est\\ninterdit de se promener avec un Pokémon.\\r\\nOù, à votre avis ?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_a_01_select_01",
      "hash64": "F08E3FAE26F1BE32",
      "text": "Au bord de la mer.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_a_01_select_02",
      "hash64": "F08E3EAE26F1BC7F",
      "text": "Dans les bâtiments.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_a_01_select_03",
      "hash64": "F08E3DAE26F1BACC",
      "text": "Dans les hautes herbes.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_a_01_ecology_answer_01",
      "hash64": "49413B87A89B35A7",
      "text": "C’est vrai que certains Pokémon n’aiment pas\\nl’eau, mais ils peuvent monter sur des bateaux\\r\\nprévus à cet effet.\\c\\nÇa ne devrait donc pas être un problème.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 158,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_a_01_ecology_answer_02",
      "hash64": "49413C87A89B375A",
      "text": "Bravo, [VAR 0x0100(0000)], c’est exactement ça !\\nJe vois que tu t’es bien préparé[VAR 0x1100(00FF,0100)]e pour ce cours ![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_a_01_ecology_answer_03",
      "hash64": "49413D87A89B390D",
      "text": "Au contraire, les Pokémon adorent les hautes\\nherbes. Ils seront très heureux de s’y promener.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_a_01_ecology_10",
      "hash64": "6B5D3CD21271D610",
      "text": "La bonne réponse était : à l’intérieur des\\nbâtiments.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_a_01_ecology_11",
      "hash64": "6B5D3DD21271D7C3",
      "text": "Certains Pokémon risqueraient d’endommager\\nles murs ou les meubles, c’est pour ça qu’ils\\r\\nn’ont pas le droit de se promener en intérieur.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_a_01_ecology_12",
      "hash64": "6B5D3ED21271D976",
      "text": "Alors, si vous voulez sortir votre Pokémon de\\nsa Poké Ball, faites-le à l’extérieur, d’accord ?\\c\\nJe me permets de dire ça, car j’en vois parfois\\ndans les salles de classe...[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 175,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_a_01_ecology_13",
      "hash64": "6B5D3FD21271DB29",
      "text": "Bref, vous l’avez compris, les balades sont un bon\\nmoyen de resserrer les liens avec votre Pokémon.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_a_01_ecology_14",
      "hash64": "6B5D40D21271DCDC",
      "text": "Oh, j’allais oublier ! Seul le Pokémon en tête de\\nvotre équipe peut se promener à vos côtés.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_a_01_ecology_15",
      "hash64": "6B5D41D21271DE8F",
      "text": "Souvenez-vous de ma formule et tout ira bien :\\n« [VAR 0xFF00(0006)]Bouton ZR[VAR 0xFF00(0000)] appuyé, Poké Ball lancée ! »\\c\\nEt si vous lancez votre Poké Ball sur un Pokémon\\nsauvage, cela déclenchera un combat.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 184,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_a_01_ecology_16",
      "hash64": "6B5D42D21271E042",
      "text": "C’est tout pour aujourd’hui. Je compte sur vous\\npour bien réviser avant notre prochaine leçon.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    }
  ]
}
