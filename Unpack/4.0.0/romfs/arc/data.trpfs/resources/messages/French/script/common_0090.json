      ]
    },
    {
      "ordinal": 31,
      "label": "common_0090_head_teacher_07",
      "hash64": "F3A81CA8F4214EEE",
      "text": "Ho ho ho... C’était une autre époque.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
