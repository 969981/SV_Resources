    {
      "ordinal": 1,
      "label": "kizuna_dragon_c_02",
      "hash64": "FD55985EBA6B173A",
      "text": "Oh, c’est vous, [VAR 0x0100(0000)].[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
