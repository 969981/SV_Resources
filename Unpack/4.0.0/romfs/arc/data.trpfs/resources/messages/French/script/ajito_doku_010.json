  "entries": [
    {
      "ordinal": 0,
      "label": "ajito_doku_010_sitappa_01",
      "hash64": "FE3FE6E5CC9BDE5B",
      "text": "Non, mais tu vas t’en aller, à la fin ?![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_doku_010_student_01",
      "hash64": "8FC7CE649BB09D04",
      "text": "Pas question ! Je partirai pas avant de voir\\nle boss de l’équipe Poison !\\r\\nJe veux parler à Erio-sensei !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_doku_010_sitappa_02",
      "hash64": "FE3FE7E5CC9BE00E",
      "text": "Mais puisque je te dis que c’est le boss lui-même\\nqui nous a ordonné de laisser entrer personne ![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_doku_010_student_02",
      "hash64": "8FC7D1649BB0A21D",
      "text": "Je m’en fiche ! Je veux le voir !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "ajito_doku_010_sitappa_03",
      "hash64": "FE3FE8E5CC9BE1C1",
      "text": "Oh, par pitié...\\nSois sympa et fiche-moi la paix, d’accord ?[VAR 0x0114(002F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_doku_010_system_01",
      "hash64": "C90A82F2B8B9430C",
      "text": "Ces deux-là ont l’air de se disputer.\\nQue faire ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "ajito_doku_010_select_01",
      "hash64": "D6C26E8EEA4346BF",
      "text": "Les interpeller",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_doku_010_select_02",
      "hash64": "D6C26F8EEA434872",
      "text": "S’approcher d’eux",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "ajito_doku_010_student_03",
      "hash64": "8FC7D0649BB0A06A",
      "text": "Hmmm ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "ajito_doku_010_sitappa_04",
      "hash64": "FE3FE9E5CC9BE374",
      "text": "Quoi ? Toi aussi, t’es venu[VAR 0x1100(00FF,0100)]e me casser les pieds ?\\nC’est vraiment pas ma journée...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_doku_010_sitappa_05",
      "hash64": "FE3FEAE5CC9BE527",
      "text": "J’aurais dû y réfléchir à deux fois avant\\nde rejoindre la Team Star...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_doku_010_student_04",
      "hash64": "8FC7CB649BB097EB",
      "text": "Attends, Sbire-san ! Tu l[VAR 0x1100(00FF,0101)]ea reconnais pas ?\\nJe crois que c’est [VAR 0x0100(0000)] !",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_doku_010_sitappa_06",
      "hash64": "FE3FEBE5CC9BE6DA",
      "text": "[VAR 0x0100(0000)]...\\nL[VAR 0x1100(00FF,0605)]e typa fille qui a défié la Team Star ?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0605"
          ]
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_doku_010_select_03",
      "hash64": "D6C2708EEA434A25",
      "text": "Oui, c’est moi.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "ajito_doku_010_select_04",
      "hash64": "D6C2698EEA433E40",
      "text": "Faites vos prières.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "ajito_doku_010_student_05",
      "hash64": "8FC7CA649BB09638",
      "text": "J’en étais sûr !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "ajito_doku_010_sitappa_07",
      "hash64": "FE3FECE5CC9BE88D",
      "text": "Ouah, ça craint ![VAR 0x0114(002F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_doku_010_sitappa_08",
      "hash64": "FE3FDDE5CC9BCF10",
      "text": "On a joué aux jeux vidéo toute la nuit, les autres\\ndoivent encore être en train de pioncer...[VAR 0x0114(002F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_doku_010_student_06",
      "hash64": "8FC7CD649BB09B51",
      "text": "Laisse-moi m’occuper d[VAR 0x1100(00FF,0505)]e lui’elle, Sbire-san !\\nPendant ce temps, va réveiller tes compagnons !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0505"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "ajito_doku_010_sitappa_09",
      "hash64": "FE3FDEE5CC9BD0C3",
      "text": "Hein ? Mais pourquoi tu ferais ça pour nous ?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_doku_010_student_07",
      "hash64": "8FC7CC649BB0999E",
      "text": "Si le repaire est sans défense, ça veut dire\\nqu’Erio-sensei est en danger !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "ajito_doku_010_student_08",
      "hash64": "8FC7C7649BB0911F",
      "text": "Et je dois tout à Erio-sensei !\\nC’est un mentor, pour moi !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "ajito_doku_010_student_09",
      "hash64": "8FC7C6649BB08F6C",
      "text": "Face aux difficultés, je brave le danger !\\nC’est mon nindô, c’est ma vocation !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "ajito_doku_010_sitappa_10",
      "hash64": "FE42EBE5CC9E1CB1",
      "text": "Je comprends rien à ce que tu racontes, mais...\\nmerci pour ton aide, petit ![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "ajito_doku_010_student_10",
      "hash64": "8FC449649BAD852E",
      "text": "Vile canaille, t’oses t’en prendre à mon sensei !\\nÇa va pas se passer comme ça !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "ajito_doku_010_select_05",
      "hash64": "D6C26A8EEA433FF3",
      "text": "OK !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "ajito_doku_010_select_06",
      "hash64": "D6C26B8EEA4341A6",
      "text": "Attends !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "ajito_doku_010_student_11",
      "hash64": "8FC44A649BAD86E1",
      "text": "Sage est celui qui bat en retraite quand\\nl’exigent les circonstances !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "ajito_doku_010_student_12",
      "hash64": "8FC447649BAD81C8",
      "text": "Ninpôôôôôôôôôôôô !!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "ajito_doku_010_student_13",
      "hash64": "8FC448649BAD837B",
      "text": "Erio-sensei... Pardonnez-moi...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "ajito_doku_010_nelke_01",
      "hash64": "5F2032885202D340",
      "text": "[VAR 0x0100(0000)] ! Ça va ?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "ajito_doku_010_nelke_02",
      "hash64": "5F2035885202D859",
      "text": "Je surveillais le repaire quand j’ai remarqué\\nqu’il y avait du grabuge, par ici.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "ajito_doku_010_nelke_03",
      "hash64": "5F2034885202D6A6",
      "text": "Je suis venu aussi vite que j’ai pu.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_doku_010_student_14",
      "hash64": "8FC44D649BAD8BFA",
      "text": "Grrr... !\\nUn complice ?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "ajito_doku_010_nelke_04",
      "hash64": "5F2037885202DBBF",
      "text": "Mais... c’est un élève ? En tout cas, il n’a pas\\nl’air de faire partie de la Team Star.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "ajito_doku_010_student_15",
      "hash64": "8FC44E649BAD8DAD",
      "text": "Je fais p’têt’ pas partie de la Team Star...\\nmais Erio-sensei est mon mentor !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "ajito_doku_010_student_16",
      "hash64": "8FC44B649BAD8894",
      "text": "Et je dois absolument le voir !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "ajito_doku_010_nelke_05",
      "hash64": "5F2036885202DA0C",
      "text": "... Il a l’air déterminé.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "ajito_doku_010_nelke_06",
      "hash64": "5F2039885202DF25",
      "text": "J’ai quelques questions à lui poser.\\nPendant ce temps, occupe-toi du repaire.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "ajito_doku_010_nelke_07",
      "hash64": "5F2038885202DD72",
      "text": "Viens avec moi, mon « pote », on va discuter.\\nEt t’inquiète, je ne vais pas te mordre.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    }
  ]
