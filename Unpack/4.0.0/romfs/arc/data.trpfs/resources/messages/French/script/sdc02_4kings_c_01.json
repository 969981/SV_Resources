  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_4kings_c_01_clerk_00",
      "hash64": "4B1056ADCBA7EEED",
      "text": "Tu peux flâner dans le coin et discuter avec nous\\nà ta guise. N’hésite pas !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_c_01_clerk_01",
      "hash64": "4B1055ADCBA7ED3A",
      "text": "Bienvenue au Poste Côtier, le domaine de\\nmiss Taro et de son équipe !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_c_01_clerk_02",
      "hash64": "4B1054ADCBA7EB87",
      "text": "Tu souhaites donc faire tes preuves face à la\\nLigue Myrtille ?\\c\\nEt tu t’appelles... [VAR 0x0100(0000)], c’est ça ?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_c_01_clerk_03",
      "hash64": "4B1053ADCBA7E9D4",
      "text": "Pour participer à ce défi du Conseil 4,\\nil te faut 50 PM.\\c\\nVeux-tu procéder au paiement ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_c_01_clerk_04",
      "hash64": "4B1052ADCBA7E821",
      "text": "Oh non... Il semble que tu ne possèdes\\npas suffisamment de PM...\\c\\nJe te suggère de faire quelques activités Myrtille\\npour en récupérer !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_c_01_system_01",
      "hash64": "03880224B52AB2E4",
      "text": "Vous avez envoyé 50 PM.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_c_01_clerk_05",
      "hash64": "4B1051ADCBA7E66E",
      "text": "Merci beaucoup ! Je confirme la bonne réception\\nde tes Points Myrtille.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_c_01_clerk_06",
      "hash64": "4B1050ADCBA7E4BB",
      "text": "C’est à vous, miss Taro !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
