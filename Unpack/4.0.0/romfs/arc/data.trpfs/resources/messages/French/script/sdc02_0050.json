        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc02_0050_fairybb_24",
      "hash64": "17FDD2564E4BAD90",
      "text": "Continuons la visite en allant au [VAR 0xFF00(0006)]Terra-Dôme[VAR 0xFF00(0000)] !\\nOn peut y aller en passant par les portillons\\r\\njuste ici ![VAR 0x0114(0049)]",
