    {
      "ordinal": 0,
      "label": "s1_side02_0020_camera_01",
      "hash64": "91148EA99DBDF52E",
      "text": "Alors, l’étudiant[VAR 0x1100(00FF,0100)]e, t’es d’attaque pour\\nune séance pho... euh, pour un combat ?[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
