          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_esper_trade_01_02",
      "hash64": "5FDF22F4F51487B1",
      "text": "... Je sais ! Serais-tu d’accord pour que\\nnous échangions des Pokémon ?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
