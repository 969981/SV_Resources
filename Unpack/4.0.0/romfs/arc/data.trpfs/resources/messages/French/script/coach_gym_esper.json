      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_esper_trade_01_00",
      "hash64": "5FDF20F4F514844B",
      "text": "Fais-moi plaisir et garde bien en tête cette\\nnouvelle promesse.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_esper_trade_01_01",
      "hash64": "5FDF1FF4F5148298",
      "text": "L’idéal serait de rendre ce moment inoubliable,\\npour que tu te souviennes de cette promesse...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
