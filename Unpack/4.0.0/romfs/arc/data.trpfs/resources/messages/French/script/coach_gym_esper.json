          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_esper_sp03_select_01",
      "hash64": "3AC4424555EA2645",
      "text": "Oh si, j’adorerais !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_gym_esper_sp03_select_02",
      "hash64": "3AC43F4555EA212C",
      "text": "Je ne sais pas trop...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_gym_esper_sp03_05",
      "hash64": "CE891060F3761472",
      "text": "Pas de précipitation ! La réponse attendra\\nle moment venu.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
