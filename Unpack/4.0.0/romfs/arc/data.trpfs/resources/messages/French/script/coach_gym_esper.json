    {
      "ordinal": 52,
      "label": "coach_gym_esper_battleend_lose_00_00",
      "hash64": "9DBA5066B6FFF7C9",
      "text": "Ma performance en combat était aussi\\nresplendissante que ma personne !\\c\\nSurtout, ne te formalise pas. Tu feras mieux\\nla prochaine fois.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
