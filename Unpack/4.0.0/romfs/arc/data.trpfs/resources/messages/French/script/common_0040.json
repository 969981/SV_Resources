          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0040_mama_06",
      "hash64": "CEBAA7BB4FF1BBD1",
      "text": "Par ici, monsieur Clavel.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0040_head_teacher_09",
      "hash64": "086DA259457457B9",
      "text": "Volontiers.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0040_head_teacher_10",
      "hash64": "08712F5945777D27",
      "text": "Je vous en prie, faites comme si je n’étais pas là\\net montez donc dans votre chambre.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0040_mama_07",
      "hash64": "CEBAA6BB4FF1BA1E",
      "text": "Qu’est-ce que tu attends pour aller te préparer\\npour l’école ?\\c\\nVa donc chercher ton sac et ton chapeau\\n[VAR 0xFF00(0006)]dans ta chambre[VAR 0xFF00(0000)], mon cœur ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
