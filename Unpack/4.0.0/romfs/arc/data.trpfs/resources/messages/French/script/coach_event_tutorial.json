    {
      "ordinal": 20,
      "label": "coach_event_tutorial_headbb_16",
      "hash64": "024C00020AA293AA",
      "text": "Les personnes que tu inviteras pourront utiliser\\ncette salle pour se reposer entre les cours.\\c\\nTu pourras donc les y retrouver et discuter avec\\nelles en toute tranquillité.[VAR 0x0114(004B)]",
      "flags": 0,
