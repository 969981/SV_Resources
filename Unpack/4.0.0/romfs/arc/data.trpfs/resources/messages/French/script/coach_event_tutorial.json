      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0300"
