    },
    {
      "ordinal": 1,
      "label": "kizuna_language_a_02",
      "hash64": "96408B3C202A58DF",
      "text": "Tu as fait tout ce chemin juste pour me voir ?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
