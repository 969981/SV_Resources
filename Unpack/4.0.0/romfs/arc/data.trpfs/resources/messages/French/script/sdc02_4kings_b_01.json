    {
      "ordinal": 0,
      "label": "sdc02_4kings_b_01_clerk_00",
      "hash64": "6F0523D6EB0928C2",
      "text": "Tu peux faire le tour des lieux comme bon\\nte semble, n’hésite pas !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_b_01_clerk_01",
      "hash64": "6F0524D6EB092A75",
      "text": "Bienvenue au Poste Canyon, le domaine\\nde mademoiselle Nérine et de son équipe !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_b_01_clerk_02",
      "hash64": "6F0521D6EB09255C",
      "text": "Tu souhaites donc faire tes preuves face à la\\nLigue Myrtille ?\\c\\nEt tu t’appelles... [VAR 0x0100(0000)], c’est ça ?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 86,
