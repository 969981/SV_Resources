          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_b_01_clerk_03",
      "hash64": "6F0522D6EB09270F",
      "text": "Pour participer à ce défi du Conseil 4,\\nil te faut 50 PM.\\r\\nTu veux procéder au paiement ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_b_01_clerk_04",
      "hash64": "6F051FD6EB0921F6",
      "text": "Je suis vraiment désolé, mais tu n’as pas assez\\nde Points Myrtille... Pense à faire des\\r\\nactivités Myrtille pour en obtenir !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_b_01_system_01",
      "hash64": "876FD5B083B0E1A9",
      "text": "Vous avez envoyé 50 PM.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_b_01_clerk_05",
      "hash64": "6F0520D6EB0923A9",
      "text": "Merci beaucoup ! Je confirme la bonne réception\\nde tes Points Myrtille.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_b_01_clerk_06",
