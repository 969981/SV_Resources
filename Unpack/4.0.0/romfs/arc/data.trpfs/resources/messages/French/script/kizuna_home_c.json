      "hash64": "9C0F8B4400C15227",
      "text": "Tiens, [VAR 0x0100(0000)].[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
