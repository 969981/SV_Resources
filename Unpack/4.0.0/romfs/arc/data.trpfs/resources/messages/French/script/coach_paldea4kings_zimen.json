    },
    {
      "ordinal": 2,
      "label": "coach_paldea4kings_zimen_sp01_00",
      "hash64": "743CA50901C57281",
      "text": "J’dois avouer que j’m’attendais pas à recevoir\\ncette invitation, [VAR 0x0100(0000)] ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
