          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_paldea4kings_zimen_sp01_select_01",
      "hash64": "D4717B8263D1451D",
      "text": "Oui !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_paldea4kings_zimen_sp01_select_02",
      "hash64": "D471788263D14004",
      "text": "Euh, ce n’est pas vraiment ça...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea4kings_zimen_sp01_03",
      "hash64": "743CA20901C56D68",
      "text": "T’es honnête, c’est cool !\\nEt puis, ça m’fait bien plaisir ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_paldea4kings_zimen_sp01_03b",
      "hash64": "48745F4E027847FE",
      "text": "Roh, ça va, j’te taquine ! Tu pourrais jouer le jeu\\nau lieu de me mettre un vent ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea4kings_zimen_sp01_04",
      "hash64": "743CA90901C5794D",
      "text": "Bon alors, j’dois faire quoi ?\\nMettre un peu d’ambiance dans c’bahut ?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea4kings_zimen_sp01_05",
      "hash64": "743CA80901C5779A",
      "text": "Ça, c’est grave dans mes cordes !\\nTu peux compter sur moi ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_paldea4kings_zimen_sp02_00",
      "hash64": "78B3E31FD517400E",
      "text": "C’est cool d’être ici. J’étais pas revenue depuis\\nla dernière fois, quand j’escortais la Cheffe.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_paldea4kings_zimen_sp02_01",
      "hash64": "78B3E41FD51741C1",
      "text": "Elle a l’air super pro, mais en vrai, des fois,\\nelle est très tête en l’air. C’est hallucinant.\\r\\nDu coup, j’reste avec elle pour la surveiller ![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_paldea4kings_zimen_sp02_select_01",
      "hash64": "416A704DF61BF9C0",
      "text": "On ne dirait pas !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "coach_paldea4kings_zimen_sp02_select_02",
      "hash64": "416A734DF61BFED9",
      "text": "Vous faites un bon duo !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_paldea4kings_zimen_sp02_02",
      "hash64": "78B3E11FD5173CA8",
      "text": "Tu t’souviens pas d’la dernière fois ?\\c\\nElle avait carrément oublié de donner\\nle disque chelou à Bria ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_paldea4kings_zimen_sp02_02b",
      "hash64": "30E45317167C4B3E",
      "text": "T’as vu ! Faut dire qu’ça fait un bail\\nqu’on s’connaît, elle et moi.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_paldea4kings_zimen_sp02_03",
      "hash64": "78B3E21FD5173E5B",
      "text": "N’empêche que des fois, elle fait d’ces trucs...\\c\\nGenre, ça lui arrive de débarquer au taf avec\\nson Germéclat emmêlé dans les cheveux, sans\\r\\nqu’elle s’en rende compte... C’est n’imp ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 187,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_paldea4kings_zimen_sp02_04",
      "hash64": "78B3E71FD51746DA",
      "text": "Mais surtout, lui dis pas que j’t’ai raconté ça !\\nElle me passerait un d’ces savons si elle savait.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_paldea4kings_zimen_sp02_05",
      "hash64": "78B3E81FD517488D",
      "text": "Donc ça reste entre nous, hein ?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_paldea4kings_zimen_sp03_00",
      "hash64": "770B991AADACD51F",
      "text": "Franchement, c’est marrant d’apprendre\\ndes trucs aux élèves, mais ça m’prend la tête ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_paldea4kings_zimen_sp03_01",
      "hash64": "770B981AADACD36C",
      "text": "Ben ouais ! Quand j’bosse, j’me mets toujours\\nen mode « professionnel ».[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_paldea4kings_zimen_sp03_02",
      "hash64": "770B9B1AADACD885",
      "text": "Du coup, hop ! J’mets mes lunettes pour rentrer\\ndans l’personnage. Ouais, parce qu’elles servent\\r\\nà rien d’autre. J’ai pas d’problème de vue ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_paldea4kings_zimen_sp03_03",
      "hash64": "770B9A1AADACD6D2",
      "text": "D’ailleurs, quand t’as passé ton épreuve orale\\nà l’examen de maîtrise, c’était la Cayenn\\r\\npro qu’t’avais en face de toi ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_paldea4kings_zimen_sp03_04",
      "hash64": "770B951AADACCE53",
      "text": "Tu m’préfères comment, toi ?\\nEn mode normal ou en mode pro ?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea4kings_zimen_sp03_select_01",
      "hash64": "6813464A803E76FB",
      "text": "En mode normal !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "coach_paldea4kings_zimen_sp03_select_02",
      "hash64": "6813474A803E78AE",
      "text": "En mode professionnel !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "coach_paldea4kings_zimen_sp03_05",
      "hash64": "770B941AADACCCA0",
      "text": "Ah ouais ?\\c\\nC’est cool ! J’vais pouvoir éviter d’me prendre\\nla tête quand j’suis avec toi et être moi-même ![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_paldea4kings_zimen_sp03_05b",
      "hash64": "F5796B551C9FEDA6",
      "text": "Ah ouais ?\\c\\nDans ce cas, dorénavant, je m’adresserai\\nà vous avec politesse et courtoisie, m[VAR 0x1100(00FF,0507)]onsieuradame...\\c\\nNan, j’rigole ! Ça fait trop chelou ![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 93,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0507"
          ]
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 154,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_paldea4kings_zimen_sp03_06",
      "hash64": "770B971AADACD1B9",
      "text": "En tout cas, j’tâcherai d’garder en tête\\nc’que tu m’as dit ![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_paldea4kings_zimen_trade_01_00",
      "hash64": "535B9E15484E2CB9",
      "text": "D’ailleurs, j’y pense... On papote un max\\ntou[VAR 0x1100(00FF,0200)]tes les deux, ces derniers temps ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0200"
          ]
        },
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_paldea4kings_zimen_trade_01_01",
      "hash64": "535B9D15484E2B06",
      "text": "On s’est grave rapproché[VAR 0x1100(00FF,0100)]es et tout...\\nViens, on fait un truc stylé pour marquer l’coup ![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_paldea4kings_zimen_trade_01_02",
      "hash64": "535B9C15484E2953",
      "text": "Ah, je sais ! Un échange Pokémon !\\nÇa t’dit qu’on en fasse un ?[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_paldea4kings_zimen_trade_01_03",
      "hash64": "535B9B15484E27A0",
      "text": "Super ! C’est parti !\\nMoi, j’pense te filer un Axoloto !\\r\\nEt toi, t’as quoi pour moi ?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
