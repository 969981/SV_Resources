  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0390_ogre_01",
      "hash64": "01C73E893B5670F9",
      "text": "Mopopon !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc01_0390_sister_01",
      "hash64": "CCCBC61E99C69FB8",
      "text": "Nous revoilà, Ogerpon ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
