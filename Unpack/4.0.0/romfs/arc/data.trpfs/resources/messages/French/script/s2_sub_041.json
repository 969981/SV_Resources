            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_041_synchro_02",
      "hash64": "86F82719633C94C3",
      "text": "Oh, pardon. Je m’entraînais !\\c\\nMon nom est Cronie, et je suis une chercheuse\\nde génie. Ni plus, ni moins ![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_041_synchro_03",
      "hash64": "86F82619633C9310",
      "text": "Je suis en train de mener une expérience\\nincroyable en ce moment !\\c\\nCela m’aiderait beaucoup si tu te portais\\nvolontaire pour y participer. Tu veux bien ?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 156,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_041_synchro_04",
      "hash64": "86F82D19633C9EF5",
      "text": "Quoi, sérieusement ?! M-mais... c’est peut-être\\nta chance d’assister à la découverte du siècle ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_041_synchro_05",
      "hash64": "86F82C19633C9D42",
      "text": "[EMPTY 31]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_041_synchro_add_01",
      "hash64": "A20963AB7E34341A",
      "text": "Tu es motivé[VAR 0x1100(00FF,0100)]e, ça me plaît !\\nAllez, direction la zone d’expérimentation ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_041_synchro_add_02",
      "hash64": "A20962AB7E343267",
      "text": "Pour participer à cette expérience, il faut\\nque tu aies un Pokémon sorti de sa Poké Ball.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_041_synchro_add_03",
      "hash64": "A20961AB7E3430B4",
      "text": "Reviens me voir quand tu seras fin prêt[VAR 0x1100(00FF,0100)]e ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_041_synchro_add_04",
      "hash64": "A20960AB7E342F01",
      "text": "Tu te sens prêt[VAR 0x1100(00FF,0100)]e à participer à une expérience\\nincroyable ?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_041_synchro_06",
      "hash64": "86F82B19633C9B8F",
      "text": "Ha ha ! J’aime ta motivation !\\nDu coup, on peut s’y mettre tout de suite !\\c\\nPrêt[VAR 0x1100(00FF,0100)]e ? Synchronisatiooon !!![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 82,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_sub_041_synchro_07",
      "hash64": "86F82A19633C99DC",
      "text": "Bien ! Ton esprit est actuellement synchronisé\\navec celui de ton Pokémon ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_041_synchro_08",
      "hash64": "86F83119633CA5C1",
      "text": "En d’autres termes, ton Pokémon va réagir et\\nse déplacer en adéquation avec tes pensées.[VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_041_synchro_09",
      "hash64": "86F83019633CA40E",
      "text": "Allez, c’est l’heure de tester les déplacements !\\nTu vois l’arbre, là-bas ? Essaie d’aller jusqu’à lui ![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_041_synchro_10",
      "hash64": "86F4A31963397EA0",
      "text": "Ouah ! C’est que tu m’as l’air naturellement\\ndoué[VAR 0x1100(00FF,0100)]e pour la synchronisation ![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_041_synchro_11",
      "hash64": "86F4A41963398053",
      "text": "Merci ! J’ai pu récolter de précieuses données.\\nCe n’est pas grand-chose, mais voilà pour toi ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_041_synchro_12",
      "hash64": "86F4A51963398206",
      "text": "Tu as un énorme potentiel ! J’aimerais beaucoup\\nque tu me prêtes de nouveau assistance ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_sub_041_synchro_13",
      "hash64": "86F4A619633983B9",
      "text": "Et comme la prochaine expérience sera plus\\nexigeante, je te promets un beau cadeau ![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_sub_041_synchro_14",
      "hash64": "86F4A7196339856C",
      "text": "Alors, est-ce que cela te dirait de participer\\nà une autre expérience incroyable ?[VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_sub_041_synchro_15",
      "hash64": "86F4A8196339871F",
      "text": "Mais... tu n’es pas sérieu[VAR 0x1100(00FF,0201)]xse ! Tu ne veux pas faire\\npartie de l’équipe visionnaire à l’origine de\\r\\nla découverte du siècle... non, du millénaire ?![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0201"
          ]
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 155,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_sub_041_synchro_16",
      "hash64": "86F4A919633988D2",
      "text": "OK, on y va. Tu es prêt[VAR 0x1100(00FF,0100)]e ?\\nC’est parti ! Synchronisatiooon !!![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_sub_041_synchro_17",
      "hash64": "86F4AA1963398A85",
      "text": "Comme je l’ai déjà expliqué, ton esprit est\\nsynchronisé avec celui de ton Pokémon ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_041_synchro_18",
      "hash64": "86F4AB1963398C38",
      "text": "Puisque tu n’en es plus à ton coup d’essai,\\ntu devrais arriver à te déplacer plus librement ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_sub_041_synchro_19",
      "hash64": "86F4AC1963398DEB",
      "text": "Pour le vérifier, on va faire un test d’aptitude\\nau combat. Essaie d’affronter des Pokémon ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_sub_041_synchro_20",
      "hash64": "86FEB5196341F1BB",
      "text": "Ouahou ! Rien à dire, tu es un[VAR 0x1100(00FF,0100)]e véritable\\npro de la synchronisation ![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_sub_041_synchro_21",
      "hash64": "86FEB4196341F008",
      "text": "À talent exceptionnel, récompense\\nexceptionnelle ! Accepte donc ceci ![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_sub_041_synchro_22",
      "hash64": "86FEB7196341F521",
      "text": "Bon, comme c’est encore un prototype,\\nle design n’est pas tout à fait au point...[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_sub_041_synchro_23",
      "hash64": "86FEB6196341F36E",
      "text": "Mais tu pourras l’utiliser pour te synchroniser\\navec tes Pokémon où et quand tu voudras !\\r\\nN’hésite pas à essayer avec plein de Pokémon ![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_sub_041_synchro_24",
      "hash64": "86FEB9196341F887",
      "text": "Aïe ! Interruption de l’expérience...\\c\\nC’était peut-être trop intense. N’hésite pas à\\nréessayer une fois que ton mal de tête ira mieux ![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s2_sub_041_synchro_25",
      "hash64": "86FEB8196341F6D4",
      "text": "Alors, tu arrives à utiliser le Synchrotron ?\\c\\nPour t’en servir, il faut maintenir le bouton L,\\npuis appuyer sur le bouton R ![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_sub_041_synchro_26",
      "hash64": "86FEBB196341FBED",
      "text": "Oh ! Mais je vois que tu te sers beaucoup\\ndu Synchrotron ! Merci pour toutes ces données.\\r\\nLaisse-moi te remercier avec quelques PM ![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
