    {
      "ordinal": 1,
      "label": "s2_sub_041_synchro_01",
      "hash64": "86F82819633C9676",
      "text": "Syyyn... chro !!![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
