    {
      "ordinal": 12,
      "label": "common_1305_friend_05",
      "hash64": "478BA7579489662B",
      "text": "Tu sais, quelque part...\\nJe m’en doutais.[VAR 0x0114(0006)]",
      "flags": 0,
