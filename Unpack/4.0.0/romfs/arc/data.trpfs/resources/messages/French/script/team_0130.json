      "label": "team_0130_cassiopeia_15",
      "hash64": "17FE797934A22F80",
      "text": "Je suis la Big Boss de la Team Star,\\nCassiopée...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
