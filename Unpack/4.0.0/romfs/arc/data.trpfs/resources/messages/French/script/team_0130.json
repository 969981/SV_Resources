          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "team_0130_cassiopeia_14",
      "hash64": "17FE7A7934A23133",
      "text": "... Permets-moi donc de me présenter à nouveau.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
