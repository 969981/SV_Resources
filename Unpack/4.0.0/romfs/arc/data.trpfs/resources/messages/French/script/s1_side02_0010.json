    {
      "ordinal": 1,
      "label": "s1_side02_0010_camera_02",
      "hash64": "7E32FF78B0575C08",
      "text": "Alors comme ça, t’as capturé au moins\\n150 espèces de Pokémon de Septentria ? Stylé ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
