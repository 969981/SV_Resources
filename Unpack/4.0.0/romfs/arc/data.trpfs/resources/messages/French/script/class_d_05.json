      ]
    },
    {
      "ordinal": 24,
      "label": "class_d_05_language_14",
      "hash64": "6D3266ECA3C6060F",
      "text": "Lorsque Pikachu s’exprime de cette façon\\net dit...[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
