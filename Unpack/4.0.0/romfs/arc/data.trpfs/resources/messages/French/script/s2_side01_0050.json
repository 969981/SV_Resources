        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_side01_0050_botan_01",
      "hash64": "8E475FE6A0AFCAA8",
      "text": "Oooh, j’ai la tête qui tourne...\\nQuand est-ce qu’on s’assoit ?[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_side01_0050_friend_01",
      "hash64": "CA7C0810D70061CA",
      "text": "Tu passes tout ton temps à regarder ton portable\\net tu t’plains d’avoir le mal des transports ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0050_botan_02",
      "hash64": "8E4762E6A0AFCFC1",
      "text": "Ce n’est pas de ma faute ! On ne captait rien\\net tout prenait des plombes à charger...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0050_caretaker_01",
      "hash64": "A86DE2BE5C0FF1B2",
      "text": "Bonjour, les enfants ![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
