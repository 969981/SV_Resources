    },
    {
      "ordinal": 1,
      "label": "s2_side01_0050_rival_02",
      "hash64": "6B6AA996E5DDE393",
      "text": "C’est fou ! Ça change vraiment de Paldea ![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
