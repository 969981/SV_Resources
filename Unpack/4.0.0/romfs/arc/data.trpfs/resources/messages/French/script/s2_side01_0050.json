        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side01_0050_caretaker_04",
      "hash64": "A86DDFBE5C0FEC99",
      "text": "[VAR 0xBD06(0000)]Dis-moi, [VAR 0x0100(0000)], c’est la première fois\\nque\\r\\ntes amis\\r\\nviennent\\r\\nà Septentria,\\r\\nje suppose ?[VAR 0x0114(0045)]",
