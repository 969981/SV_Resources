      "hash64": "6B6AAA96E5DDE546",
      "text": "Alors c’est ça, Jaderaude ?\\nOuaaah ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
