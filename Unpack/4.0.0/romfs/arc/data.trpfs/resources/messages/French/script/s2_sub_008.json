      ]
    },
    {
      "ordinal": 34,
      "label": "s2_sub_008_doku_08",
      "hash64": "20C026EA316F3C17",
      "text": "Meloco est sortie tantôt, prétextant vouloir\\nprendre l’air.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "s2_sub_008_fairy_09",
      "hash64": "BB42A63E873D781E",
      "text": "C’est ça, ouais. Elle sèche, c’est sûr !\\nC’est du Meloco tout craché ![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
