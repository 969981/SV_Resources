      "label": "sdc01_0310_gfather_01",
      "hash64": "D7707B5E295BFB0D",
      "text": "[VAR 0x0100(0000)], Roseille...\\nMes enfants, je... je suis désolé...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
