    {
      "ordinal": 36,
      "label": "sdc01_0485_sister_13",
      "hash64": "A3B9E32AC7EB9410",
      "text": "Enfin, c’est pas comme si on allait plus jamais\\nse revoir ![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
