      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0485_bbteacher_02",
      "hash64": "7248949413607152",
      "text": "C’est parfait, tout le monde est là...\\n... ou presque.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
