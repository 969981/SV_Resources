    },
    {
      "ordinal": 51,
      "label": "kizuna_botan_c_kakutou_08",
      "hash64": "BC38C891D22593E6",
      "text": "N’importe qui aurait eu peur à sa place.\\nCe n’est jamais facile de faire le premier pas\\r\\nvers l’inconnu.\\c\\nC’est pour ça que je l’ai accompagnée, mais\\nvisiblement, elle s’en sort très bien toute seule.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
