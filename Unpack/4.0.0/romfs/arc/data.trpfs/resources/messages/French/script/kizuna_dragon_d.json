  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_dragon_d_01",
      "hash64": "2EFA878873A3ED0C",
      "text": "Tiens, [VAR 0x0100(0000)].\\nJe suis heureux de vous voir.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_dragon_d_02",
      "hash64": "2EFA8A8873A3F225",
      "text": "Vous avez le chic pour toujours arriver\\nau moment opportun.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_dragon_d_select_01",
      "hash64": "F7BB75BF89B648DB",
      "text": "Comment ça ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_dragon_d_select_02",
      "hash64": "F7BB76BF89B64A8E",
      "text": "Que se passe-t-il ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_dragon_d_03",
      "hash64": "2EFA898873A3F072",
      "text": "Eh bien...[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_dragon_d_tamer_01",
      "hash64": "E71EA2DABA069B96",
      "text": "Monsieur Hassa.\\nJe suis venue vous chercher.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_dragon_d_04",
      "hash64": "2EFA848873A3E7F3",
      "text": "Je vois...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_dragon_d_tamer_02",
      "hash64": "E71EA1DABA0699E3",
      "text": "Je suis heureuse de voir que vous avez finalement\\npris la décision de diriger notre famille.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_dragon_d_05",
      "hash64": "2EFA838873A3E640",
      "text": "À ce sujet...[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_dragon_d_06",
      "hash64": "2EFA868873A3EB59",
      "text": "Vous avez raison, j’ai effectivement\\npris une décision...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_dragon_d_07",
      "hash64": "2EFA858873A3E9A6",
      "text": "Je vais conserver mon poste d’enseignant\\nau sein de l’académie ![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_dragon_d_tamer_03",
      "hash64": "E71EA0DABA069830",
      "text": "Que... que dites-vous ?! L’avenir de votre\\nfamille vous indiffère-t-il donc à ce point ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_dragon_d_08",
      "hash64": "2EFA908873A3FC57",
      "text": "Ce n’est pas la question ![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_dragon_d_09",
      "hash64": "2EFA8F8873A3FAA4",
      "text": "Regardez donc les œuvres qui décorent la pièce.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_dragon_d_10",
      "hash64": "2EF7828873A1AEB6",
      "text": "Mes jeunes élèves font de leur mieux pour\\ndévelopper leur sensibilité.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_dragon_d_11",
      "hash64": "2EF7838873A1B069",
      "text": "Je ne dis pas que protéger l’héritage de notre\\nancienne famille n’a pas son importance...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_dragon_d_12",
      "hash64": "2EF7808873A1AB50",
      "text": "Néanmoins, je tiens plus que tout à voir germer\\nles talents de demain.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_dragon_d_13",
      "hash64": "2EF7818873A1AD03",
      "text": "Cela me paraît bien plus « fun »...\\nsi vous me pardonnez l’expression.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_dragon_d_tamer_04",
      "hash64": "E71EA7DABA06A415",
      "text": "Je vois que je perds mon temps...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "kizuna_dragon_d_tamer_05",
      "hash64": "E71EA6DABA06A262",
      "text": "Cependant, je ne peux pas nier la hardiesse\\navec laquelle vous défendez votre position.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "kizuna_dragon_d_tamer_06",
      "hash64": "E71EA5DABA06A0AF",
      "text": "Ce tempérament prouve que vous avez hérité\\nde la volonté des dragons...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "kizuna_dragon_d_tamer_07",
      "hash64": "E71EA4DABA069EFC",
      "text": "En tout cas, comptez sur moi pour revenir.\\nJe finirai par vous faire entendre raison !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "kizuna_dragon_d_14",
      "hash64": "2EF7868873A1B582",
      "text": "Mais ne vous gênez pas, vous êtes la bienvenue !\\nSeulement vous comprendrez bien vite qu’en\\r\\ntermes d’obstination, je suis imbattable ![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_dragon_d_15",
      "hash64": "2EF7878873A1B735",
      "text": "Et mentir sur l’état de santé de mon père ne vous\\nmènera à rien. Je vois clair dans votre jeu ![VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_dragon_d_tamer_08",
      "hash64": "E71EABDABA06AAE1",
      "text": "Humph... !\\nNous nous reverrons, soyez-en certain !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "kizuna_dragon_d_16",
      "hash64": "2EF7848873A1B21C",
      "text": "Pardonnez-moi ce piètre spectacle...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_dragon_d_17",
      "hash64": "2EF7858873A1B3CF",
      "text": "En réalité, j’étais sur le point de céder et\\nde retourner auprès de ma famille...[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_dragon_d_18",
      "hash64": "2EF78A8873A1BC4E",
      "text": "[VAR 0xBD06(0000)]Mais c’est en voyant mes chers élèves et\\nen écoutant vos paroles, [VAR 0x0100(0000)],\\r\\nque j’ai trouvé le courage de dire non.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_dragon_d_19",
      "hash64": "2EF78B8873A1BE01",
      "text": "Je vous suis infiniment reconnaissant,\\nc’est à vous tous que je dois tout cela...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_dragon_d_20",
      "hash64": "2EF41C88739ECB8D",
      "text": "Ce présent est peu de chose en comparaison,\\nmais je vous prie de l’accepter malgré tout.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_dragon_d_21",
      "hash64": "2EF41B88739EC9DA",
      "text": "En tout cas, cette histoire m’a permis de\\ncomprendre une chose ![VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_dragon_d_22",
      "hash64": "2EF41A88739EC827",
      "text": "J’aime ce métier d’enseignant plus qu’aucun\\nautre, et continuerai à y mettre tout mon cœur ![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_dragon_d_system_01",
      "hash64": "7BE69C1982F83480",
      "text": "Vous avez réussi à nouer des liens forts avec\\nmonsieur Hassa !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
