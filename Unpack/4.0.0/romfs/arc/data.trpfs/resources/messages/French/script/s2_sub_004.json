    },
    {
      "ordinal": 22,
      "label": "s2_sub_004_dokuboss_09",
      "hash64": "3977866B72C14C13",
      "text": "J’espère que tu m’honoreras à nouveau de\\nta présence. À une prochaine fois, mon ami[VAR 0x1100(00FF,0100)]e ![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
