      "ordinal": 23,
      "label": "sdc01_0120_brother_07",
      "hash64": "BCDEAFB2405C5B07",
      "text": "La Fête des Visages se passe au Septemplion.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
