      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0120_sister_07",
      "hash64": "204EE2B2E8AAADFB",
      "text": "Tu reçois quand même l’honneur de\\nm’affronter dans ma tenue de fête ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
