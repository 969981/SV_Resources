    {
      "ordinal": 34,
      "label": "gym_normal_030_shop_00",
      "hash64": "04CA2005066AAA90",
      "text": "Vous êtes en train de passer l’examen d’Arène,\\nn’est-ce pas ?\\c\\nEst-ce que vous avez réussi à réunir les indices\\nsur notre plat secret ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_normal_030_shop_01",
      "hash64": "04CA2105066AAC43",
      "text": "Alors, que souhaitez-vous commander ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
