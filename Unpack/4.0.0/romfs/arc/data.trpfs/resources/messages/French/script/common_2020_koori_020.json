            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2020_koori_020_koori_14",
      "hash64": "9154025018C5D70C",
      "text": "Fais attention à toi dans la descente.\\nEt n’attrape pas froid ![VAR 0x0114(001A)]",
