          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0089_dragonbb_05",
      "hash64": "29C29305FA754199",
      "text": "En fait, à l’institut, on a un système qui classe\\nles élèves en fonction de leur niveau de combat.\\r\\nÇa s’appelle la [VAR 0xFF00(0006)]Ligue Myrtille[VAR 0xFF00(0000)].[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0089_dragonbb_06",
      "hash64": "29C29005FA753C80",
      "text": "Et dans notre club, on veut être les meilleurs\\nde la Ligue. Du coup, on s’entraîne ensemble ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0089_dragonbb_07",
      "hash64": "29C29105FA753E33",
      "text": "Mais en vrai, c’est surtout une excuse pour\\nse faire plaiz ! Parce qu’ici, on s’en fiche\\r\\nde qui gagne et qui perd.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0089_sister_03",
      "hash64": "CA06882959B07056",
      "text": "Tsss... Les infos sont là, mais y avait peut-être\\nun meilleur moyen de les formuler, non ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0089_dragonbb_08",
      "hash64": "29C29E05FA75544A",
      "text": "Mouais, p’têt’ bien... !\\c\\nEnfin, je dis tout ça, mais c’est plus vraiment\\nla même vibe, en ce moment...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0089_sister_04",
      "hash64": "CA068B2959B0756F",
      "text": "Moi aussi, je fais partie du club, même si\\nje viens pas souvent ici.\\c\\nSinon, euh...\\nAh oui ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0089_sister_05",
      "hash64": "CA068A2959B073BC",
      "text": "Les quatre meilleurs membres de la Ligue Myrtille\\nforment ce qu’on appelle le [VAR 0xFF00(0006)]Conseil 4[VAR 0xFF00(0000)].[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0089_sister_06",
      "hash64": "CA068D2959B078D5",
      "text": "Et figure-toi que tête de dentifrice ici présent\\nen fait partie... Avec la fille qui était avec moi\\r\\nsous le dôme, tout à l’heure.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0089_dragonbb_09",
      "hash64": "29C29F05FA7555FD",
      "text": "Tu te moques de ma coupe, mais en attendant,\\nmoi, au moins, je fais partie du conseil, Roro.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0089_sister_07",
      "hash64": "CA068C2959B07722",
      "text": "C’est parce que j’ai pas le temps de participer\\naux combats de la Ligue. J’ai trop de choses\\r\\nà faire en dehors des cours.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0089_sister_08",
      "hash64": "CA068F2959B07C3B",
      "text": "De toute façon, tout le monde sait déjà que\\nje dépasse largement le niveau du Conseil 4 ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0089_dragonbb_10",
      "hash64": "29C61C05FA78603B",
      "text": "J’avoue, c’est pas faux. Hé hé hé ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0089_dragonbb_11",
      "hash64": "29C61B05FA785E88",
      "text": "Alors, [VAR 0x0100(0000)] ?\\nIl a l’air trop cool, notre club, pas vrai ?[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0089_dragonbb_12",
      "hash64": "29C61E05FA7863A1",
      "text": "Ah, je suis content que ça te plaise ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0089_dragonbb_13",
      "hash64": "29C61D05FA7861EE",
      "text": "Tu dis ça mais au fond de toi, tu le kiffes, hein ?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0089_dragonbb_14",
      "hash64": "29C62005FA786707",
      "text": "Booooon !\\nBah, voilà ! T’es membre temporaire, du coup ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0089_sister_09",
      "hash64": "CA068E2959B07A88",
      "text": "Mais t’es sérieux, là ? Ça existe même pas,\\nles inscriptions temporaires.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc02_0089_dragonbb_15",
      "hash64": "29C61F05FA786554",
      "text": "Bah, on s’en fiche, non ?\\nPas de chichis entre poteaux ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc02_0089_dragonbb_16",
      "hash64": "29C62205FA786A6D",
      "text": "En tout cas, tu peux venir ici et te servir du matos\\nquand tu veux. Fais comme chez toi ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc02_0089_dragonbb_17",
      "hash64": "29C62105FA7868BA",
      "text": "Cet ordi, par exemple !\\nIl est trop pratique ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc02_0089_dragonbb_18",
      "hash64": "29C61405FA7852A3",
      "text": "Il te permet d’utiliser tes PM pour aider les\\nélèves d’autres clubs. En échange, ils viendront\\r\\nte dépanner, ou t’apprendre des trucs cool ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0089_dragonbb_25",
      "hash64": "29BC0F05FA6FF59F",
      "text": "Tu sais quoi ? Tu comprendras en pratiquant.\\nJ’ai un peu la flemme d’expliquer plus.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc02_0089_system_01",
      "hash64": "55A13CED9668E81B",
      "text": "Irido vous donne [VAR 0x0204(0001,0020)] PM !",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
          "code_hex": "0204",
          "args_hex": [
            "0001",
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc02_0089_dragonbb_26",
      "hash64": "29BC1005FA6FF752",
      "text": "Avec ça, tu vas pouvoir demander à Lancelot,\\ndu club de baseball, de te montrer une nouvelle\\r\\nfaçon de lancer tes Poké Balls ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc02_0089_dragonbb_stopper",
      "hash64": "5C70256EC271E689",
      "text": "Bah, tu vas où ?\\nEnvoie des PM à Lancelot sur l’ordi, s’te plaît.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc02_0089_dragonbb_npc",
      "hash64": "0D009F273E33B18D",
      "text": "Essaie d’utiliser tes PM sur l’ordi !\\nTu vas voir, c’est super simple ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc02_0089_sister_npc",
      "hash64": "65C15D443538643A",
      "text": "Je sais que c’est pénible, mais plus tôt tu feras\\nce qu’il demande, plus vite il nous fichera la paix.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc02_0089_dragonbb_27",
      "hash64": "29BC1105FA6FF905",
      "text": "T’as réussi ? Cool !\\nC’est tout simple, t’as vu ?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc02_0089_dragonbb_28",
      "hash64": "29BC1205FA6FFAB8",
      "text": "Pour être honnête... j’étais pas sûr que t’allais\\ny arriver, même si c’est super facile.\\c\\nEn tout cas, bien joué ! Ça m’apprendra\\nà te sous-estimer.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc02_0089_dragonbb_30",
      "hash64": "29BF9005FA7306A9",
      "text": "Et vu que t’as pas tremblé des genoux, prends ça.\\nJe suis quand même vraiment sympa ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc02_0089_dragonbb_31",
      "hash64": "29BF8F05FA7304F6",
      "text": "Oh, et puis je t’offre ça aussi. Porte ces sapes\\net t’auras autant de street cred que moi ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc02_0089_system_02",
      "hash64": "55A13DED9668E9CE",
      "text": "Irido vous donne la [VAR 0xFF00(0008)]Tenue du Club de la Ligue[VAR 0xFF00(0000)] !",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0089_dragonbb_29",
      "hash64": "29BC1305FA6FFC6B",
      "text": "On peut bien se faire des cadeaux, entre potes !\\c\\nEn tout cas, sers-toi de l’ordi quand tu veux.\\nC’est en libre-service ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "sdc02_0089_dragonbb_19",
      "hash64": "29C61305FA7850F0",
      "text": "Et si t’as un petit creux, aujourd’hui, on a\\nplein de friandises ! Vas-y, c’est gratuit ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "sdc02_0089_sister_10",
      "hash64": "CA03212959AD8B7A",
      "text": "Tout est déjà ouvert et à moitié mangé...\\nArrête d’essayer de lui refourguer tes restes.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sdc02_0089_sister_11",
      "hash64": "CA03222959AD8D2D",
      "text": "N’y touche pas. Si ça se trouve, ça fait des\\nsemaines que ces paquets traînent ici.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "sdc02_0089_dragonbb_20",
      "hash64": "29BC0A05FA6FED20",
      "text": "Toutes ces explications, ça m’a donné faim.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "sdc02_0089_dragonbb_21",
      "hash64": "29BC0B05FA6FEED3",
      "text": "Je vais faire un tour du côté de la cafèt’, moi.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "sdc02_0089_dragonbb_22",
      "hash64": "29BC0C05FA6FF086",
      "text": "Si le club te plaît et que tu veux en faire partie\\nofficiellement, rejoins-moi là-bas !\\c\\nRien de tel qu’un « date » pour en discuter.\\nTu vois ce que je veux dire ?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 165,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sdc02_0089_sister_12",
      "hash64": "CA031F2959AD8814",
      "text": "QU-QUOI ?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "sdc02_0089_dragonbb_23",
      "hash64": "29BC0D05FA6FF239",
      "text": "Allez, tarplu ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "sdc02_0089_sister_13",
      "hash64": "CA03202959AD89C7",
      "text": "Mais ?! Pour qui il se prend, sérieux ?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "sdc02_0089_sister_14",
      "hash64": "CA031D2959AD84AE",
      "text": "Un « date » ?! C’est quoi ce plan ?![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "sdc02_0089_select_03",
      "hash64": "BB9D8812C0B5CCFE",
      "text": "Allons, du calme !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "sdc02_0089_select_04",
      "hash64": "BB9D8B12C0B5D217",
      "text": "Un « date », c’est...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 54,
      "label": "sdc02_0089_sister_15",
      "hash64": "CA031E2959AD8661",
      "text": "Je SUIS calme !!! Quoi, ça se voit pas ?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "sdc02_0089_sister_16",
      "hash64": "CA031B2959AD8148",
      "text": "Non, mais c’est pas ce que je voulais dire !\\nJe sais qu’un « date », c’est un rencard !\\r\\nJe suis pas gâteuse, non plus ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "sdc02_0089_sister_17",
      "hash64": "CA031C2959AD82FB",
      "text": "*soupir* Désolée... J’aime vraiment pas\\nl’ambiance, ici.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "sdc02_0089_sister_18",
      "hash64": "CA03192959AD7DE2",
      "text": "Allons plutôt ailleurs.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "sdc02_0089_sister_19",
      "hash64": "CA031A2959AD7F95",
      "text": "Et si on allait dans ta chambre ? Au moins,\\non serait tranquilles.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "sdc02_0089_sister_20",
      "hash64": "C9FF9B2959AA71F1",
      "text": "Quoi, tu sais pas où est ta chambre ? T’inquiète\\npas, tu vas bien finir par la trouver ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
