    },
    {
      "ordinal": 4,
      "label": "gym_kusa_020_receptionist_05",
      "hash64": "01E16B63DBE196D4",
      "text": "Ils se cachent parfois dans des endroits auxquels\\non ne pense pas forcément, comme en hauteur\\r\\nou derrière les bâtiments, par exemple.\\c\\nN’hésitez pas à regarder partout et depuis divers\\npoints de vue afin de couvrir toute la ville !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
