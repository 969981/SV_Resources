          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_kusa_020_receptionist_03",
      "hash64": "01E16963DBE1936E",
      "text": "L’exercice consiste à parcourir Cuencia pour\\ntrouver [VAR 0x0201(0001)] Héliatronc. Ces Pokémon ressemblent\\r\\nà des fleurs en forme de soleil.\\c\\nEmmenez-les ensuite sur la Place Héliatronc\\net vous aurez réussi votre examen !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_kusa_020_receptionist_04",
      "hash64": "01E16C63DBE19887",
      "text": "Vous avez trouvé [VAR 0x0200(0001)] Héliatronc au total.\\nEncore [VAR 0x0201(0002)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
