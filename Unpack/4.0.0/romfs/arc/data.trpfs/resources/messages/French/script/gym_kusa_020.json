      "hash64": "01E15F63DBE18270",
      "text": "Quand vous aurez trouvé 10 Héliatronc,\\nemmenez-les sur la Place Héliatronc !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
