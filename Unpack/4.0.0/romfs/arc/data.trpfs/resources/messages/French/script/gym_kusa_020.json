          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_kusa_020_receptionist_02",
      "hash64": "01E16A63DBE19521",
      "text": "Pour pouvoir affronter Colza, il vous faudra\\nparticiper à la [VAR 0xFF00(0006)]cueillette des Héliatronc[VAR 0xFF00(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
