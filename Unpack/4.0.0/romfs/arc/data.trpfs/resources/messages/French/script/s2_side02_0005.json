        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side02_0005_camera_11",
      "hash64": "469D797C1A8E6773",
      "text": "Ça doit pas être facile d’y accéder, on sent\\nque c’est un lieu pas comme les autres.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
