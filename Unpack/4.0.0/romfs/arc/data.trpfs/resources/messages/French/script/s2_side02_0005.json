      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_side02_0005_select_02",
      "hash64": "44CB1C8CF17EDF8A",
      "text": "C’était trop facile !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_side02_0005_camera_03",
      "hash64": "46A0FB7C1A917A30",
      "text": "C’est bien ! Tu mérites qu’on te félicite ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
