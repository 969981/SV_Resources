    {
      "ordinal": 1,
      "label": "team_0080_nelke_02",
      "hash64": "42B8B60A9AC12980",
      "text": "L’Opération Stardust avance bien.\\nPlus que deux boss...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
