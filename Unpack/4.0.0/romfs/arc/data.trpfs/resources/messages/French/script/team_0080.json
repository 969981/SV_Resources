        }
      ]
    },
    {
      "ordinal": 2,
      "label": "team_0080_nelke_03",
      "hash64": "42B8B70A9AC12B33",
      "text": "Je suis ravi de notre progression. Cette mission\\nm’a permis de comprendre pas mal de choses.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "team_0080_nelke_04",
      "hash64": "42B8BC0A9AC133B2",
      "text": "... À propos, qu’est-ce que tu penses\\nde Cassiopée ?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "team_0080_select_01",
      "hash64": "3089BD2EAC3FD82C",
      "text": "Je ne lui fais pas confiance.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "team_0080_select_02",
      "hash64": "3089C02EAC3FDD45",
      "text": "Sa cause est juste.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "team_0080_select_03",
      "hash64": "3089BF2EAC3FDB92",
      "text": "Son comportement est étrange.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "team_0080_select_04",
      "hash64": "3089BA2EAC3FD313",
      "text": "Je ne sais pas quoi en penser.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "team_0080_nelke_05",
      "hash64": "42B8BD0A9AC13565",
      "text": "Hmmm... Je vois.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
