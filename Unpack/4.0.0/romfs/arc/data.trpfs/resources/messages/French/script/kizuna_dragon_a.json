    },
    {
      "ordinal": 10,
      "label": "kizuna_dragon_a_08b",
      "hash64": "94A7B6BD35E8B678",
      "text": "Cela signifie que vous essayez de travailler\\nsur vos points faibles ?\\c\\nCela demande beaucoup de courage\\net de ténacité, bravo.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
