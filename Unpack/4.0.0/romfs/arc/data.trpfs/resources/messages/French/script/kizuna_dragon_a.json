    {
      "ordinal": 9,
      "label": "kizuna_dragon_a_08a",
      "hash64": "94A7B9BD35E8BB91",
      "text": "Il est toujours plus facile de progresser lorsque\\nl’on fait ce que l’on aime.\\c\\nVoilà certainement d’où vous vient cette force\\nimpressionnante.[VAR 0x0114(0012)]",
      "flags": 4,
