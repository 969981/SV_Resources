    },
    {
      "ordinal": 49,
      "label": "coach_gym_nomal_randomtalk_00",
      "hash64": "36566AE3B87009CC",
      "text": "Je ne me jette pas souvent de fleurs, mais je suis\\nplutôt fier de l’examen que j’ai imaginé pour\\r\\nl’Arène de Mezclamora.\\c\\nJe me suis inspiré du caractère impitoyable\\nde la vie en entreprise.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 1,
          "code_hex": "BE01",
