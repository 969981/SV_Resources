      ]
    },
    {
      "ordinal": 53,
      "label": "coach_gym_nomal_randomtalk_04",
      "hash64": "365666E3B8700300",
      "text": "Comment va le Deusolourdo que je t’ai donné ?\\c\\nTu as dû remarquer qu’il prend le type Vol\\nquand il se Téracristallise, ce qui fait de lui...\\r\\nun « Deuvolourdo ».\\c\\n...\\nPardon...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
