          "offset_units": 81,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 161,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_health_b_15",
      "hash64": "D8FF3679A04C44C4",
      "text": "Mais j’espère que ça ne t’a pas découragé[VAR 0x1100(00FF,0100)]e\\nde revenir me voir ![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
