      "hash64": "D8FBAE79A04927D5",
      "text": "Hello !\\nBienvenue à l’infirmerie ![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
