    {
      "ordinal": 2,
      "label": "coach_bb4kings_fairy_sp01_00",
      "hash64": "86B5C99CF6027322",
      "text": "Quel plaisir de te revoir à l’institut,\\n[VAR 0x0100(0000)] ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
