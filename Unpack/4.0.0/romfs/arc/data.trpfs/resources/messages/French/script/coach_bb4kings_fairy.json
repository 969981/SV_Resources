          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_bb4kings_fairy_sp01_01",
      "hash64": "86B5CA9CF60274D5",
      "text": "Comment s’est déroulée ton excursion à Paldea\\navec Kassis et compagnie ?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_bb4kings_fairy_sp01_select_01",
      "hash64": "7D7A79D5E660C5B4",
      "text": "Comme sur des roulettes !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_bb4kings_fairy_sp01_select_02",
      "hash64": "7D7A7CD5E660CACD",
      "text": "C’était sportif !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_bb4kings_fairy_sp01_02",
      "hash64": "86B5C79CF6026FBC",
      "text": "Ça me fait plaisir de l’entendre ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_bb4kings_fairy_sp01_02b",
      "hash64": "E9520DB60624163A",
      "text": "Je n’en doute pas !\\nÇa a dû être toute une aventure ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_bb4kings_fairy_sp01_03",
      "hash64": "86B5C89CF602716F",
      "text": "Vous deviez explorer le grand cratère\\nde Paldea, c’est bien ça ?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb4kings_fairy_sp01_04",
      "hash64": "86B5C59CF6026C56",
      "text": "Tout de même, quelle audace de te renvoyer à\\nPaldea en plein milieu de ton échange scolaire ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb4kings_fairy_sp01_select_03",
      "hash64": "7D7A7BD5E660C91A",
      "text": "Ça ne m’a pas dérangé[VAR 0x1100(00FF,0100)]e !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb4kings_fairy_sp01_select_04",
      "hash64": "7D7A76D5E660C09B",
      "text": "Un peu, oui...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "coach_bb4kings_fairy_sp01_05",
      "hash64": "86B5C69CF6026E09",
      "text": "Que tu es magnanime ! Si on m’avait fait le même\\ncoup, j’en aurais touché deux mots à la direction.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb4kings_fairy_sp01_05b",
      "hash64": "E94EE7B606219FD1",
      "text": "N’est-ce pas ?!\\nJe n’approuve pas du tout, moi non plus ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb4kings_fairy_sp01_06",
      "hash64": "86B5C39CF60268F0",
      "text": "Cet institut est formidable, mais je ne peux\\nm’empêcher de penser qu’il manque de rigueur\\r\\nsur certains points...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb4kings_fairy_sp01_07",
      "hash64": "86B5C49CF6026AA3",
      "text": "C’est pourquoi il est de notre devoir de faire\\nvaloir notre opinion lorsque nous désapprouvons\\r\\ncertaines pratiques ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_bb4kings_fairy_sp02_00",
      "hash64": "584CCB84E90DCCB5",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)], as-tu un petit moment\\nà m’accorder ?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_bb4kings_fairy_sp02_01",
      "hash64": "584CCA84E90DCB02",
      "text": "J’aimerais t’informer de quelques décisions\\nqui ont été prises pendant ton absence.\\c\\nC’est au sujet du Club de la Ligue.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb4kings_fairy_sp02_02",
      "hash64": "584CC984E90DC94F",
      "text": "Tout d’abord, afin d’éviter toute confusion,\\nnous avons décidé de suspendre temporairement\\r\\nles changements dans le classement des membres\\r\\nde la Ligue.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 156,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb4kings_fairy_sp02_03",
      "hash64": "584CC884E90DC79C",
      "text": "Nous avons aussi modifié le règlement pour que\\nles élèves en échange scolaire puissent obtenir\\r\\nle titre de Maître ou de Maîtresse ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb4kings_fairy_sp02_04",
      "hash64": "584CC784E90DC5E9",
      "text": "En outre, certaines règles mises en place par\\nKassis ont été abolies, car jugées trop strictes.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb4kings_fairy_sp02_05",
      "hash64": "584CC684E90DC436",
      "text": "... Et je crois que c’est l’essentiel ! Nous avons eu\\nbeaucoup à faire pendant ton absence ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_bb4kings_fairy_sp02_select_01",
      "hash64": "0D491132F0304C51",
      "text": "Merci pour tout votre travail !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_bb4kings_fairy_sp02_select_02",
      "hash64": "0D490E32F0304738",
      "text": "Désolé[VAR 0x1100(00FF,0100)]e d’avoir manqué tout ça !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_bb4kings_fairy_sp02_06",
      "hash64": "584CC584E90DC283",
      "text": "Oh non ! Je ne disais pas ça pour que tu te sentes\\nredevable de quoi que ce soit ![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb4kings_fairy_sp02_07",
      "hash64": "584CC484E90DC0D0",
      "text": "Gérer le club est notre responsabilité,\\naprès tout ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb4kings_fairy_sp02_08",
      "hash64": "584CD384E90DDA4D",
      "text": "Même si un certain IRIDO ne fait que dormir\\npendant nos réunions ! Grrr ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb4kings_fairy_sp02_09",
      "hash64": "584CD284E90DD89A",
      "text": "Enfin bref ! Tu sais maintenant tout des derniers\\nrebondissements du Club de la Ligue ![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_fairy_sp03_00",
      "hash64": "AFF8958C858C4FC4",
      "text": "[VAR 0x0100(0000)] !\\nJ’aimerais discuter de quelque chose avec toi...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_fairy_sp03_01",
      "hash64": "AFF8968C858C5177",
      "text": "Comme tu le sais sûrement déjà, quand Kassis\\nétait Maître de la Ligue, l’atmosphère était\\r\\nrelativement tendue...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_bb4kings_fairy_sp03_02",
      "hash64": "AFF8978C858C532A",
      "text": "À cause de ça, nombre de nos membres se sont\\nlassés et ont décidé de quitter le club.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_bb4kings_fairy_sp03_03",
      "hash64": "AFF8988C858C54DD",
      "text": "C’est pourquoi j’aimerais que tu nous aides\\nà décider d’un nouveau slogan pour rendre\\r\\nnotre club plus attractif ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_bb4kings_fairy_sp03_04",
      "hash64": "AFF8918C858C48F8",
      "text": "As-tu des idées ?[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_bb4kings_fairy_sp03_select_01",
      "hash64": "30EE3D64CC124D0E",
      "text": "Apprendre en s’amusant !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "coach_bb4kings_fairy_sp03_select_02",
      "hash64": "30EE3C64CC124B5B",
      "text": "Toujours garder le sourire !",
