      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_battle_d_09",
      "hash64": "5575A3BF491CE6C3",
      "text": "J’ai voulu faire comme elle et apprendre\\nà cuisiner pour prendre soin des autres,\\r\\ndans l’espoir que ça nous rapproche, mais...\\c\\nJe crois que la préparation de Sandwichs\\nn’est vraiment pas mon fort ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
