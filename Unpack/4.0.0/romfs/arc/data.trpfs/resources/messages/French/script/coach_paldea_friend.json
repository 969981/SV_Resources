    },
    {
      "ordinal": 66,
      "label": "coach_paldea_friend_randomtalk_02",
      "hash64": "9EB3DE09A671C6BF",
      "text": "J’me suis régalé la dernière fois que j’suis allé\\nchez toi. Ta mère est un vrai cordon-bleu !\\c\\nLa prochaine fois, j’espère que tu prépareras\\ndes Sandwichs ! J’ai trop envie d’y goûter ![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
