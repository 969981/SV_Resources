            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea_friend_sp01_04b",
      "hash64": "F756EEB6ED4E79D0",
      "text": "Ça alors ! Pareil que moi ! Pas étonnant qu’on\\ns’entende aussi bien !\\c\\nCe cours, il est trop utile si on veut perfectionner\\nla préparation de Sandwichs ![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 155,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_paldea_friend_sp01_05",
      "hash64": "CB523F60EF7A9845",
      "text": "En fait, le proviseur m’a dit que si j’étudiais à\\nl’institut pendant mon séjour, j’aurais des points\\r\\nen plus dans certaines matières ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_paldea_friend_sp01_06",
      "hash64": "CB523C60EF7A932C",
      "text": "Et franchement, ça tombe bien, parce que\\nj’suis un peu limite ! J’vais donc bien bosser ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_paldea_friend_sp02_00",
      "hash64": "C6DAFC4A1C28C239",
      "text": "Salut, [VAR 0x0100(0000)] !\\nDis, j’ai un truc à te demander...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_paldea_friend_sp02_01",
      "hash64": "C6DAFB4A1C28C086",
      "text": "J’ai remarqué que les gens faisaient pas souvent\\nde pique-niques ni de Sandwichs, par ici.\\r\\nC’est pas vraiment leur truc ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_paldea_friend_sp02_select_01",
      "hash64": "0525FB7097BB1AE5",
      "text": "Ah bon ?!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_paldea_friend_sp02_select_02",
      "hash64": "0525F87097BB15CC",
      "text": "Si, pourtant...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_paldea_friend_sp02_02",
      "hash64": "C6DAFA4A1C28BED3",
      "text": "Quoi ? T’as dû préparer un Sandwich très\\npiquant pendant un... comment tu dis ?\\r\\nUn défi du Conseil 4 ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_paldea_friend_sp02_03",
      "hash64": "C6DAF94A1C28BD20",
      "text": "... J’ai dû me faire des idées, alors.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_paldea_friend_sp02_04",
      "hash64": "C6DB004A1C28C905",
      "text": "En fait, l’autre fois, quand j’explorais le dôme,\\nj’me suis arrêté pour préparer un Sandwich.\\c\\nEt tout à coup, j’me suis retrouvé entouré\\nd’élèves de l’institut...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 165,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_paldea_friend_sp02_05",
      "hash64": "C6DAFF4A1C28C752",
      "text": "Ils me regardaient comme s’ils avaient jamais vu\\nun Sandwich de leur vie, j’étais mal à l’aise...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_paldea_friend_sp02_06",
      "hash64": "C6DAFE4A1C28C59F",
      "text": "Et comme je savais plus trop quoi faire, bah,\\nj’leur ai préparé des Sandwichs...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_paldea_friend_sp02_select_03",
      "hash64": "0525F97097BB177F",
      "text": "C’est super !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_paldea_friend_sp02_select_04",
      "hash64": "0525F67097BB1266",
      "text": "C’est gentil !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_paldea_friend_sp02_07",
      "hash64": "C6DAFD4A1C28C3EC",
      "text": "Tu parles ! J’étais « super » stressé, ouais !\\c\\nAh, tu veux dire que c’était super pour eux\\nde manger mes Sandwichs ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea_friend_sp02_07b",
      "hash64": "0EDFF2EDD9444A4A",
      "text": "C’était pas de la gentillesse ! Ils me mettaient\\nla pression, alors j’ai fait le premier truc qui\\r\\nm’est passé par la tête ![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_paldea_friend_sp02_08",
      "hash64": "C6DB044A1C28CFD1",
      "text": "Mais du coup, si c’est courant de manger des\\nSandwichs ici, pourquoi ils ont réagi comme ça ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_paldea_friend_sp02_09",
      "hash64": "C6DB034A1C28CE1E",
      "text": "J’ai l’impression que l’Institut Myrtille a pas fini\\nde me surprendre.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_paldea_friend_sp03_00",
      "hash64": "F2E206507D92D7E8",
      "text": "Ah, [VAR 0x0100(0000)] ! Faut que j’te raconte\\nla suite de mes aventures ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_paldea_friend_sp03_01",
      "hash64": "F2E207507D92D99B",
      "text": "La dernière fois, je t’ai raconté le moment où\\nje m’étais retrouvé encerclé par des élèves.\\r\\nTu te souviens ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_paldea_friend_sp03_02",
      "hash64": "F2E208507D92DB4E",
      "text": "Eh ben, apparemment, ils m’avaient pris pour\\nquelqu’un d’autre ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_paldea_friend_sp03_select_01",
      "hash64": "42657E2BDF84E362",
      "text": "Comment ça ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "coach_paldea_friend_sp03_select_02",
