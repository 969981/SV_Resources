          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_language_c_05",
      "hash64": "19F3444A1E12C3BC",
      "text": "Si même Jacq ne sait pas trop comment\\nl’expliquer...[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_language_c_ecology_03",
      "hash64": "3D325B92640E99DB",
      "text": "J’aurais aimé pouvoir t’aider davantage,\\ndésolé...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_language_c_06",
      "hash64": "19F3474A1E12C8D5",
      "text": "Aucun souci ! Don’t worry ![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_language_c_07",
      "hash64": "19F3464A1E12C722",
      "text": "D’ailleurs, j’ai visionné les enregistrements\\ndes caméras de surveillance de l’académie...[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_language_c_08",
      "hash64": "19F3494A1E12CC3B",
      "text": "Et je sais maintenant comment mon petit Pohm\\ns’est retrouvé ici.\\c\\nApparemment, un autre Pokémon sauvage\\nle pourchassait et il s’est réfugié dans nos locaux.[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 158,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_language_c_09",
      "hash64": "19F3484A1E12CA88",
      "text": "Peut-être que cet évènement l’a traumatisé\\net qu’il n’arrive plus à parler depuis...[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
