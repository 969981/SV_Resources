      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_language_c_04",
      "hash64": "19F3454A1E12C56F",
      "text": "Et pourtant, il ne pousse jamais le moindre cri,\\nc’est étonnant...[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
