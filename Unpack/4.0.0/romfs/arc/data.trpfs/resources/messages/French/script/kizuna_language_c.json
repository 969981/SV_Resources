          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_language_c_ecology_01",
      "hash64": "3D325D92640E9D41",
      "text": "J’ai demandé à madame Mimosa de l’examiner,\\net elle m’a dit qu’il était en parfaite santé.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_language_c_ecology_02",
      "hash64": "3D325A92640E9828",
      "text": "Il n’a aucune blessure, aucune maladie...[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_language_c_poke_02",
      "hash64": "B233D2EF13F66F65",
      "text": "...",
      "flags": 0,
      "text_status": "DECODED",
