      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_language_c_select_02",
      "hash64": "7421E5753FE5FFC2",
      "text": "Il a l’air vraiment... calme.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_language_c_03",
      "hash64": "19F3424A1E12C056",
      "text": "Il va mieux, même s’il semble plutôt réservé.[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
