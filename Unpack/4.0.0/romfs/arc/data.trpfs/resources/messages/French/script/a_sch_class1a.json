      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "a_sch_class1a_ni01",
      "hash64": "6D85DE7704923977",
      "text": "On travaille mieux dans une salle de cours que\\ndans sa chambre.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "a_sch_class1a_ni02",
      "hash64": "6D85DF7704923B2A",
      "text": "Tu trouves pas qu’il y a plus de Pokémon Spectre,\\nla nuit ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "a_sch_class1a_ni03",
      "hash64": "6D85E07704923CDD",
