        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_ecology_d_05",
      "hash64": "652B1A9A765A00BD",
      "text": "Grâce à toi, mes recherches sur les Pokémon\\nvont connaître une avancée prodigieuse ![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
