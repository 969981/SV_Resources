      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_ecology_d_07",
      "hash64": "652B189A7659FD57",
      "text": "À ce stade, on peut dire que la capture de\\nPokémon n’a plus aucun secret pour toi ![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
