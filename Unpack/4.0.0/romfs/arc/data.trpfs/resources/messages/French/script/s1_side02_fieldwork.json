    {
      "ordinal": 28,
      "label": "s1_side02_fieldwork_sazare_pokehint_05",
      "hash64": "28306A55EE01829B",
      "text": "T’as l’œil pour prendre des photos stylées !\\c\\nEt si t’allais faire un tour au nord-ouest ?\\nY a un point d’eau là-bas, donc il devrait aussi\\r\\ny avoir des Pokémon à photographier ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
