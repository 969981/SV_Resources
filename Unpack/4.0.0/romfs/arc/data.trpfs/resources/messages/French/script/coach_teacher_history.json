    },
    {
      "ordinal": 54,
      "label": "coach_teacher_history_randomtalk_00",
      "hash64": "1E5F9A87D3C01CCA",
      "text": "Les trésors du fléau te causent pas trop\\nde soucis ?\\c\\nSi tu veux t’en séparer, tu sais où me trouver ![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
