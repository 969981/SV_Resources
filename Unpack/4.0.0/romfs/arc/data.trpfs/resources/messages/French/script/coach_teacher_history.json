          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_teacher_history_randomtalk_03",
      "hash64": "1E5F9987D3C01B17",
      "text": "Ton [VAR 0x0101(0001)] m’est bien utile !\\c\\nC’est un partenaire de choix, quand il s’agit\\nd’explorer des ruines ![VAR 0x0114(0027)]",
      "flags": 0,
