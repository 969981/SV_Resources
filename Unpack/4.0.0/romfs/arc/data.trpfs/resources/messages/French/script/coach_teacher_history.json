    {
      "ordinal": 52,
      "label": "coach_teacher_history_battleend_win_01_01",
      "hash64": "6950E935D8CC6B76",
      "text": "J’espère que ce cadeau sera pour toi un précieux\\nsouvenir de ta chère prof d’Histoire ![VAR 0x0114(0027)]",
