    },
    {
      "ordinal": 56,
      "label": "coach_teacher_history_randomtalk_02",
      "hash64": "1E5F9887D3C01964",
      "text": "J’admets que le Terra-Dôme est un bijou\\nde technologie...\\c\\nMais personnellement, cette nature étrange\\nqui a aucun vécu, ça me laisse de marbre ![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
