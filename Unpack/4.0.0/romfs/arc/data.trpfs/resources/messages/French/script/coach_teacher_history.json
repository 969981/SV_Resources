    {
      "ordinal": 48,
      "label": "coach_teacher_history_battleend_win_00_02",
      "hash64": "1473B63FE834ACFE",
      "text": "Allez, je vais être sympa et t’offrir un petit\\ncadeau pour te récompenser.[VAR 0x0114(0027)]",
