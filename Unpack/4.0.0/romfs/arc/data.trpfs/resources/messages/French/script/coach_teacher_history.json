      "hash64": "F3ABE80DE7EBE70C",
      "text": "[VAR 0x0100(0000)] ! C’est toi qui m’as appelée ?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
