          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2020_normal_020_normal_02",
      "hash64": "D1F1D81ED872B4A1",
      "text": "J’imagine donc que tu ne dois pas être très\\nimpressionné[VAR 0x1100(00FF,0100)]e... Et si nous commencions ?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2020_normal_020_normal_03",
      "hash64": "D1F1D71ED872B2EE",
      "text": "Cette fois-ci, c’est en tant que Champion\\nque je t’affronte. Je me servirai donc de\\r\\nmon équipe habituelle.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2020_normal_020_normal_04",
      "hash64": "D1F1DA1ED872B807",
      "text": "Mes Pokémon sont de type Normal : ordinaires,\\ncommuns, sans surprise... Bref, tout ce qu’il y a\\r\\nde plus banal.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2020_normal_020_normal_05",
      "hash64": "D1F1D91ED872B654",
      "text": "Ils conviennent parfaitement à quelqu’un\\nqui se fond dans la masse, comme moi.\\c\\nC’est pourquoi je les affectionne tant.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_normal_020_normal_06",
      "hash64": "D1F1DC1ED872BB6D",
      "text": "Pourquoi tout compliquer inutilement ?\\nCela vaut aussi bien pour les êtres humains\\r\\nque pour les Pokémon.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_normal_020_normal_07",
      "hash64": "D1F1DB1ED872B9BA",
      "text": "De nos jours, les gens n’apprécient plus\\nque les choses clinquantes ou excentriques.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_normal_020_normal_08",
      "hash64": "D1F1CE1ED872A3A3",
      "text": "On peut bien sûr apprécier un voyage, mais\\nau fond, il n’y a que chez soi que l’on se sent\\r\\nvraiment à l’aise...[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_normal_020_normal_09",
      "hash64": "D1F1CD1ED872A1F0",
      "text": "Rien ne vaut la simplicité.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_normal_020_normal_10",
      "hash64": "D1EE501ED86F97B2",
      "text": "Je vais devoir prendre des congés pour\\nme remettre d’un tel déluge d’émotions...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_normal_020_normal_11",
      "hash64": "D1EE511ED86F9965",
      "text": "Quoi qu’il en soit...\\nJe pense avoir saisi quelque chose.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2020_normal_020_normal_12",
      "hash64": "D1EE4E1ED86F944C",
      "text": "Je crois comprendre pourquoi on m’a demandé\\nd’utiliser le type Vol au Conseil 4.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2020_normal_020_normal_13",
      "hash64": "D1EE4F1ED86F95FF",
      "text": "Si l’on ne sort pas des sentiers battus, on risque\\nde ne jamais voir certains paysages.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2020_normal_020_normal_14",
      "hash64": "D1EE4C1ED86F90E6",
      "text": "Admirer de temps à autre un talent aussi\\nvertigineux que le tien m’est bénéfique.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2020_normal_020_normal_15",
      "hash64": "D1EE4D1ED86F9299",
      "text": "Ne va pas croire néanmoins que je le fais par\\nplaisir. Je me plie aux ordres de la Cheffe.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_2020_normal_020_normal_16",
      "hash64": "D1EE4A1ED86F8D80",
      "text": "Sur ce, tu me pardonneras, mais on m’a sommé\\nde ne pas faire d’heures supplémentaires.\\c\\nAu revoir.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
