  "entries": [
    {
      "ordinal": 0,
      "label": "common_2020_normal_020_normal_01",
      "hash64": "D1F1D51ED872AF88",
      "text": "Tu m’as déjà affronté lors de ton épreuve\\npratique au Conseil 4...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
