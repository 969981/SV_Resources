          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_c_04_fairybb_02",
      "hash64": "EBBEB87C4A16B63E",
      "text": "Je vais me présenter de nouveau, pour la forme !\\nJe suis Taro du Conseil 4.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_c_04_fairybb_03",
      "hash64": "EBBEB97C4A16B7F1",
      "text": "Je ne m’attendais pas à ce qu’un[VAR 0x1100(00FF,0100)]e élève\\nen échange scolaire vienne m’affronter\\r\\ndans le cadre de la Ligue Myrtille...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_c_04_fairybb_04",
      "hash64": "EBBEBA7C4A16B9A4",
      "text": "Tu sais que je t’aime bien, mais sache que\\nje ne te ferai pas de fleur pour autant ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_c_04_fairybb_05",
      "hash64": "EBBEBB7C4A16BB57",
      "text": "Quoi d’autre... Ah oui ! La plupart de\\nmes Pokémon sont de type Fée.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_c_04_fairybb_06",
      "hash64": "EBBEBC7C4A16BD0A",
      "text": "Ce sont mes préférés ! Ils sont si mignons !\\nSi adorables ! En plus, j’adore le rose ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_c_04_fairybb_07",
      "hash64": "EBBEBD7C4A16BEBD",
      "text": "Leurs faiblesses sont l’Acier et le Poison, car ils\\nn’aiment pas trop tout ce qui est dur ou corrosif...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_c_04_fairybb_08",
      "hash64": "EBBEAE7C4A16A540",
      "text": "Enfin, tu dois déjà savoir tout ça ![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_c_04_fairybb_09",
      "hash64": "EBBEAF7C4A16A6F3",
      "text": "Aujourd’hui, je vais t’affronter avec tout\\nce que j’ai.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_4kings_c_04_fairybb_10",
      "hash64": "EBC23C7C4A19CC61",
      "text": "J’espère sincèrement qu’à l’issue de ce combat,\\ntu comprendras en ton for intérieur que...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_4kings_c_04_fairybb_11",
      "hash64": "EBC23B7C4A19CAAE",
      "text": "Les Pokémon mignons sont les plus redoutables ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_4kings_c_04_fairybb_12",
      "hash64": "EBC23A7C4A19C8FB",
      "text": "[VAR 0x0100(0000)] ! Quel combat ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_4kings_c_04_fairybb_13",
      "hash64": "EBC2397C4A19C748",
      "text": "As-tu vu nos Pokémon en pleine action ?\\nN’étaient-ils pas fabuleux ?![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_4kings_c_04_fairybb_14",
      "hash64": "EBC2407C4A19D32D",
      "text": "Ils étaient vraiment trop mignons !\\nSi bien que j’ai du mal à m’en remettre ![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_4kings_c_04_select_01",
      "hash64": "D00BCFCD2F27B3F8",
      "text": "Oui, ils étaient trop mignons !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_4kings_c_04_select_02",
      "hash64": "D00BD2CD2F27B911",
      "text": "Oui, ils étaient trop cool !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc02_4kings_c_04_select_03",
      "hash64": "D00BD1CD2F27B75E",
      "text": "Toi aussi, tu étais adorable !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc02_4kings_c_04_fairybb_15",
      "hash64": "EBC23F7C4A19D17A",
      "text": "N’est-ce pas ?! J’aurais pu les regarder\\nse dandiner adorablement sur le terrain\\r\\npendant des heures ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_4kings_c_04_fairybb_16",
      "hash64": "EBC23E7C4A19CFC7",
      "text": "Voilà qui est bien hors de propos !\\nJ’ai dit qu’ils étaient « mignons » ! MI-GNONS ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_4kings_c_04_fairybb_17",
      "hash64": "EBC23D7C4A19CE14",
      "text": "Voilà qui est bien hors de propos !\\nOn parle de nos Pokémon, pas de moi ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_4kings_c_04_fairybb_18",
      "hash64": "EBC2347C4A19BEC9",
      "text": "En tout cas, tes Pokémon aussi étaient fort\\nmignons pendant ce combat, [VAR 0x0100(0000)] ![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_4kings_c_04_fairybb_19",
      "hash64": "EBC2337C4A19BD16",
      "text": "Je pense que ce ne serait pas correct de garder\\ntoute cette mignonnerie pour nous...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_4kings_c_04_fairybb_20",
      "hash64": "EBC5C27C4A1CE5EA",
      "text": "Prenons une photo avec les Pokémon ici\\nprésents, pour partager ce moment de bonheur\\r\\navec le monde ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_4kings_c_04_fairybb_21",
      "hash64": "EBC5C37C4A1CE79D",
      "text": "Oh, cette photo est adorable !\\nElle est absolument collector ! Je l’adore ![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_4kings_c_04_fairybb_22",
      "hash64": "EBC5C07C4A1CE284",
      "text": "Laisse-moi aussi te remettre ceci ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_4kings_c_04_fairybb_23",
      "hash64": "EBC5C17C4A1CE437",
      "text": "Tu es vraiment très fort[VAR 0x1100(00FF,0100)]e...\\c\\nMême en combattant avec acharnement,\\nje n’ai pas réussi à prendre le dessus ![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
