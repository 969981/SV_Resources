    {
      "ordinal": 0,
      "label": "sdc02_4kings_c_04_fairybb_01",
      "hash64": "EBBEB77C4A16B48B",
      "text": "Et hop ! Nous y voilà.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
