    {
      "ordinal": 9,
      "label": "sdc01_0100_sister_08",
      "hash64": "6ED1C0A3196FE9B8",
      "text": "Ça y est. Il fait son timide.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
