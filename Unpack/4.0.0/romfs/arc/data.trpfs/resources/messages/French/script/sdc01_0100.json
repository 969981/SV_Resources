          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0100_sister_05",
      "hash64": "6ED1BDA3196FE49F",
      "text": "En tout cas, je peux te dire que t’as fait de l’effet\\nà mon petit frère, Kass, ici présent.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0100_sister_06",
      "hash64": "6ED1BEA3196FE652",
      "text": "Une fois à la maison, il arrêtait pas de parler de\\ntoi. Impossible de le faire changer de disque de\\r\\ntoute la soirée.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
