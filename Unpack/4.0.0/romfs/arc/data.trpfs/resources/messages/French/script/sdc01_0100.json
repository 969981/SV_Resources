        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0100_sister_04",
      "hash64": "6ED1BCA3196FE2EC",
      "text": "Pourquoi venir nous parler, alors ?\\nTu serais pas un peu chelou[VAR 0x1100(00FF,0100)]e sur les bords ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
