          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0100_sister_11",
      "hash64": "6ED53DA31972F3F6",
      "text": "Allez, s’il te plaît !\\nBats-toi contre mon petit frère ![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0100_sister_12",
      "hash64": "6ED53CA31972F243",
      "text": "Pardon ? J’ai un filtre anti-négativité, alors\\nje t’ai pas entendu[VAR 0x1100(00FF,0100)]e.\\c\\nReviens me voir quand t’auras une réponse\\nplus positive à me donner.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
