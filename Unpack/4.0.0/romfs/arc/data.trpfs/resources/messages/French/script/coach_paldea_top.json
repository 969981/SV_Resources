    {
      "ordinal": 24,
      "label": "coach_paldea_top_sp02_04d",
      "hash64": "22016BA3718A964E",
      "text": "Mademoiselle Nérine fait en effet partie\\ndu Conseil 4 de la Ligue Myrtille, il me semble.\\c\\nNous avons déjà Popi, qui utilise des Pokémon\\nAcier. Elles pourraient bien s’entendre.\\c\\nPeut-être qu’une personnalité comme la sienne,\\ncalme et imperturbable, apporterait de nouvelles\\r\\nlumières en matière de stratégie.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
