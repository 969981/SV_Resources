    {
      "ordinal": 23,
      "label": "coach_paldea_top_sp02_04c",
      "hash64": "22016EA3718A9B67",
      "text": "Le jeune Rubépin fait en effet partie du Conseil 4\\nde la Ligue Myrtille, il me semble.\\c\\nNotre Ligue Pokémon ne compte, pour l’instant,\\naucun spécialiste du type Feu...\\c\\nIl pourrait apporter un peu de fraîcheur ![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
