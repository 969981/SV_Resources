    {
      "ordinal": 61,
      "label": "coach_paldea_top_randomtalk_00",
      "hash64": "638FCBE20AE3DFC6",
      "text": "Un club scolaire inspiré de la Ligue Pokémon...\\nQuelle idée fascinante.\\c\\nIl faudrait que je m’entretienne avec monsieur\\nClavel pour mettre cela en place à l’académie.[VAR 0x0114(0011)]",
