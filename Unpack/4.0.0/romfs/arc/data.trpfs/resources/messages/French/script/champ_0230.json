    {
      "ordinal": 5,
      "label": "champ_0230_steel_04",
      "hash64": "B87B01FC22063F59",
      "text": "Allez, je vais te les présenter ![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
