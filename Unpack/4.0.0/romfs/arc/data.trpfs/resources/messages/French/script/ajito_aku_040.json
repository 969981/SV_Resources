          "args_hex": [
            "003E"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "ajito_aku_040_nelke_12",
      "hash64": "1422DAB4A3D3FAC7",
      "text": "[EMPTY 62]",
      "flags": 0,
      "text_status": "DECODED",
