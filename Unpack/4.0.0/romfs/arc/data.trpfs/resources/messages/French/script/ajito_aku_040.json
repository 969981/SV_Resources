          "args_hex": [
            "003E"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "ajito_aku_040_akuboss_25",
      "hash64": "B7B9742A841D3396",
      "text": "J’parle de la personne la plus balèze\\nde la Team Star. The boss parmi les boss.\\c\\nL’équivalent de la Maîtresse en Chef\\npour les Dresseurs, quoi.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "ajito_aku_040_akuboss_26",
      "hash64": "B7B9732A841D31E3",
      "text": "On l’appelle « Big Boss ». La Team Star,\\nc’était son idée, à la base.[VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "ajito_aku_040_nelke_13",
      "hash64": "1422D9B4A3D3F914",
      "text": "Et où est ce fameux « Big Boss » ?[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "ajito_aku_040_akuboss_27",
      "hash64": "B7B9722A841D3030",
      "text": "Ah, si seulement j’le savais !\\nÇa fait bien un an et demi qu’on a plus de news...[VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "ajito_aku_040_nelke_14",
      "hash64": "1422D8B4A3D3F761",
      "text": "[EMPTY 62]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "003E"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "ajito_aku_040_akuboss_28",
      "hash64": "B7B9812A841D49AD",
      "text": "Du coup, on s’est dit que si on continuait\\nà faire vivre la Team Star, notre Big Boss\\r\\nnous rappellerait.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "ajito_aku_040_akuboss_29",
      "hash64": "B7B9802A841D47FA",
      "text": "Mais les profs font tout pour qu’on se sépare,\\net maintenant, y a des guss comme vous qui\\r\\nviennent nous défier...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "ajito_aku_040_nelke_15",
      "hash64": "1422D7B4A3D3F5AE",
      "text": "...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "ajito_aku_040_akuboss_30",
      "hash64": "B7B5F32A841A228C",
      "text": "Si ça se trouve, notre Big Boss nous a vraiment\\nlaissés tomber...\\c\\nNotre organisation était même sur le point\\nd’être dissoute, la dernière fois qu’on a parlé...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 162,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "ajito_aku_040_nelke_16",
      "hash64": "1422D6B4A3D3F3FB",
      "text": "Votre Big Boss, les membres de la Team Star...\\nCe sont des gens importants pour vous ?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "ajito_aku_040_akuboss_31",
      "hash64": "B7B5F42A841A243F",
      "text": "Évidemment ! Sans eux, je sais pas ce que\\nje ferais de ma life.\\c\\nComme diraient les autres à l’académie,\\npour moi, la Team Star...\\r\\nc’est mon plus grand trésor.[VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
