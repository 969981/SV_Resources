      ]
    },
    {
      "ordinal": 7,
      "label": "common_1100_botan_04b",
      "hash64": "46C3DE4F2E3308CB",
      "text": "... Et si Miraidon venait du futur, lui aussi,\\ncomme les autres Pokémon de la Zone Zéro ?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
