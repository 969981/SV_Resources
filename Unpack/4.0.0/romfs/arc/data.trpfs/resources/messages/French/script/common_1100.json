          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_1100_botan_04a",
      "hash64": "46C3DF4F2E330A7E",
      "text": "... Et si Koraidon venait du passé, lui aussi,\\ncomme les autres Pokémon de la Zone Zéro ?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
