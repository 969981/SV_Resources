    {
      "ordinal": 8,
      "label": "common_1100_select_01",
      "hash64": "CF70140E04FD7386",
      "text": "Oui, c’est possible !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "common_1100_select_02",
