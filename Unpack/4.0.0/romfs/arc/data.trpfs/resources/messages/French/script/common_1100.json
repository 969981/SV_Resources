          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_1100_botan_03",
      "hash64": "E8349FF91EB5696A",
      "text": "Je pensais à cette machine temporelle,\\net je me demandais...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
