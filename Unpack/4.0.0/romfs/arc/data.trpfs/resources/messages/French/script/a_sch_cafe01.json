  "entries": [
    {
      "ordinal": 0,
      "label": "a_sch_cafe01_eve03",
      "hash64": "1B951F30F6EA9DD4",
      "text": "Quand Motisma entre dans un four, il devient\\nMotisma Chaleur ! Et il change même de type !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "a_sch_cafe01_eve05",
      "hash64": "1B951D30F6EA9A6E",
      "text": "Il paraît qu’il y a des Pokémon qui se font passer\\npour des fruits !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "a_sch_cafe01_eve06",
      "hash64": "1B951C30F6EA98BB",
      "text": "En mangeant, on gagne de l’Aura Gustative !\\nSi ça s’trouve, ça améliore aussi les notes ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "a_sch_cafe01_eve07",
      "hash64": "1B951B30F6EA9708",
      "text": "J’ai d’jà envie d’me resservir alors que j’ai\\nmême pas encore commencé à manger !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "a_sch_cafe01_eve13",
      "hash64": "1B919F30F6E78E7D",
      "text": "Quand on mange à plusieurs, c’est agréable\\nde déguster un Sandwich qu’on a fait ensemble !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "a_sch_cafe01_eve14",
      "hash64": "1B919830F6E78298",
      "text": "Les Sandwichs aux fruits, c’est délicieux !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "a_sch_cafe01_eve18",
      "hash64": "1B919430F6E77BCC",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "a_sch_cafe01_eve19",
      "hash64": "1B919530F6E77D7F",
      "text": "Dans une autre région, il paraît que ce sont\\nles currys qui font fureur... T’en as déjà mangé ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "a_sch_cafe01_eve20",
      "hash64": "1B9C0E30F6F09F9F",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "a_sch_cafe01_en01",
      "hash64": "8777D1A0A0A0094D",
      "text": "Je ne m’attendais pas à ce qu’il fasse si chaud\\nprès du réfrigérateur !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "a_sch_cafe01_en02",
      "hash64": "8777CEA0A0A00434",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "a_sch_cafe01_en03",
