      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "a_sch_cafe01_en04",
      "hash64": "8777CCA0A0A000CE",
      "text": "La cafétéria est toujours très animée !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "a_sch_cafe01_en05",
      "hash64": "8777CDA0A0A00281",
      "text": "N/A",
      "flags": 0,
