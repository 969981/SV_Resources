      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "a_sch_cafe01_en09",
      "hash64": "8777C9A0A09FFBB5",
      "text": "Quelle riche idée que de prendre le thé avec\\ndes Pokémon !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "a_sch_cafe01_en10",
      "hash64": "877B36A0A0A2EAC3",
      "text": "Prendre le thé à la nuit tombée a aussi un certain\\ncharme.",
      "flags": 0,
      "text_status": "DECODED",
