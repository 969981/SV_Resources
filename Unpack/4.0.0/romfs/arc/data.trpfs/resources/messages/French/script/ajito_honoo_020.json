  "entries": [
    {
      "ordinal": 0,
      "label": "ajito_honoo_020_system_01",
      "hash64": "CB1652CD6932588B",
      "text": "Motiti ♪ Motiti ♪ Motiti ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "ajito_honoo_020_cassiopeia_01",
      "hash64": "86C1998FCFED7A81",
      "text": "... Tu t’es débarrassé du Sbire ? Très bien.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_honoo_020_cassiopeia_02",
      "hash64": "86C1968FCFED7568",
      "text": "Ce repaire, c’est celui de l’équipe Feu de\\nla Team Star...\\r\\nLe Groupe Schedar.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_honoo_020_cassiopeia_03",
      "hash64": "86C1978FCFED771B",
      "text": "Leur boss, c’est Meloco. C’est une touche-à-tout\\nqui règle tous les problèmes de la Team Star.\\r\\nMais ses méthodes sont assez expéditives.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_honoo_020_cassiopeia_04",
      "hash64": "86C19C8FCFED7F9A",
      "text": "Je suppose que notre lettre de défi n’a fait\\nqu’alimenter son agressivité.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_honoo_020_cassiopeia_05",
      "hash64": "86C19D8FCFED814D",
      "text": "En ce moment même, ses Sbires doivent être\\nen train d’essayer de la calmer.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_honoo_020_cassiopeia_06",
      "hash64": "86C19A8FCFED7C34",
      "text": "Si c’est le cas, commence par t’occuper d’eux.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "ajito_honoo_020_cassiopeia_07",
      "hash64": "86C19B8FCFED7DE7",
      "text": "Une fois qu’il n’y aura plus personne pour\\nretenir Meloco, elle se montrera.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_honoo_020_cassiopeia_08",
      "hash64": "86C1908FCFED6B36",
      "text": "[EMPTY 15]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
