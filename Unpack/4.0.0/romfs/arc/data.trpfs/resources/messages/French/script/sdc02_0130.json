    {
      "ordinal": 35,
      "label": "sdc02_0130_reception_05",
      "hash64": "4DD04947739297EE",
      "text": "Navrée pour l’attente !\\nVotre inscription est terminée !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "sdc02_0130_dragonbb_10",
      "hash64": "556BA194434EA784",
      "text": "Ah ! Pile au bon moment ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
