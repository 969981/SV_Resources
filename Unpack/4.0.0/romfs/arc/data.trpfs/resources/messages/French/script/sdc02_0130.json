      ]
    },
    {
      "ordinal": 37,
      "label": "sdc02_0130_reception_06",
      "hash64": "4DD048477392963B",
      "text": "Vous pouvez désormais relever le défi\\nde la Ligue Myrtille, [VAR 0x0100(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
