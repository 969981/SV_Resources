        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0130_reception_10",
      "hash64": "4DCCC847738F86E4",
      "text": "Je vais enregistrer leurs positions\\nsur votre Motismart.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "sdc02_0130_reception_11",
      "hash64": "4DCCC947738F8897",
      "text": "Affronter le Conseil 4 vous coûtera des [VAR 0xFF00(0006)]PM[VAR 0xFF00(0000)].\\nVous pouvez en obtenir en effectuant des\\r\\n[VAR 0xFF00(0006)]activités Myrtille[VAR 0xFF00(0000)].\\c\\nSi vous parvenez à vaincre tous les membres,\\nvous pourrez alors vous mesurer au Maître !",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
