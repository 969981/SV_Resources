      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 44,
      "label": "sdc02_0130_dragonbb_11",
      "hash64": "556BA294434EA937",
