      ]
    },
    {
      "ordinal": 2,
      "label": "common_0190_rival_03",
      "hash64": "EB0E59ADCB0F6EE8",
      "text": "Et tu vois le bâtiment avec la grosse Poké Ball ?\\nC’est notre école ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
