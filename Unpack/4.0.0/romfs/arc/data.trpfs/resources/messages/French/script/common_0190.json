    {
      "ordinal": 1,
      "label": "common_0190_rival_02",
      "hash64": "EB0E5AADCB0F709B",
      "text": "Regarde !\\nLà-bas, c’est Mesaledo ![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
