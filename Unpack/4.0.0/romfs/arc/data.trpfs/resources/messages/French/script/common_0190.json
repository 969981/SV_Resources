    {
      "ordinal": 3,
      "label": "common_0190_rival_04",
      "hash64": "EB0E60ADCB0F7ACD",
      "text": "Et on va être dans la même classe !\\nJ’ai tellement hâte ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
