  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_0000_system_01",
      "hash64": "8041F6D75EEEC498",
      "text": "Motiti ♪ Motiti ♪ Motiti ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_0000_headteacher_01",
      "hash64": "93CFB7D06897C4A1",
      "text": "Allô, m[VAR 0x1100(00FF,0B07)]onsieurademoiselle [VAR 0x0100(0000)] ?\\nC’est monsieur Clavel, à l’appareil.\\r\\nJe ne vous dérange pas, j’espère ?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0B07"
          ]
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
