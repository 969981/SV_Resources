          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0000_select_01",
      "hash64": "D46CCE93A8067D63",
      "text": "Monsieur Clavel !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc02_0000_select_02",
      "hash64": "D46CCF93A8067F16",
      "text": "Pas du tout !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_0000_headteacher_02",
      "hash64": "93CFB4D06897BF88",
      "text": "Le ton de votre voix m’indique que vous vous\\nportez à merveille. Je m’en réjouis ![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0000_headteacher_03",
      "hash64": "93CFB5D06897C13B",
      "text": "Sans transition, j’aimerais entrer dans le vif\\ndu sujet.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0000_headteacher_04",
      "hash64": "93CFBAD06897C9BA",
      "text": "Je vous téléphone pour vous faire part\\nd’une opportunité exceptionnelle ![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0000_headteacher_06",
      "hash64": "93CFB8D06897C654",
      "text": "Je suppose que vous avez entendu parler de\\nl’[VAR 0xFF00(0006)]Institut Myrtille[VAR 0xFF00(0000)] de la région d’Unys ?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0000_select_03",
      "hash64": "D46CD093A80680C9",
      "text": "Oui !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sdc02_0000_select_04",
      "hash64": "D46CD193A806827C",
      "text": "Non, pas du tout...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc02_0000_headteacher_07",
      "hash64": "93CFB9D06897C807",
      "text": "C’est exact, j’ai cru comprendre que vous aviez\\ncôtoyé des personnes de l’institut pendant votre\\r\\nvoyage scolaire.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0000_headteacher_08",
      "hash64": "93CFAED06897B556",
      "text": "Tiens donc ? J’ai pourtant cru comprendre que\\nvous aviez côtoyé des personnes de l’institut\\r\\npendant votre voyage scolaire...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0000_headteacher_09",
      "hash64": "93CFAFD06897B709",
      "text": "Quoi qu’il en soit, figurez-vous que le directeur\\nde l’Institut Myrtille est l’un de mes vieux amis.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0000_headteacher_10",
      "hash64": "93D33CD0689ADC77",
      "text": "Il m’a vivement fait part de son désir de vous\\nfaire participer à un échange scolaire.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0000_headteacher_11",
      "hash64": "93D33BD0689ADAC4",
      "text": "Je pense que vous devriez saisir cette occasion\\nd’explorer une autre région du monde.\\c\\nConsidérez cette offre comme un nouveau défi\\nà relever.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0000_headteacher_12",
      "hash64": "93D33ED0689ADFDD",
      "text": "Cela dit, quelque chose me tarabuste...\\nPourquoi a-t-il insisté pour que ce soit vous ?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0000_headteacher_13",
      "hash64": "93D33DD0689ADE2A",
      "text": "Le plus simple est encore de lui demander\\nen personne.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0000_headteacher_14",
      "hash64": "93D338D0689AD5AB",
      "text": "Je préfère vous prévenir, monsieur Cyano est\\nun personnage quelque peu... saugrenu.\\r\\nMais n’ayez crainte, je serai à vos côtés.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0000_headteacher_15",
      "hash64": "93D337D0689AD3F8",
      "text": "Venez donc dans mon bureau où nous pourrons\\ndiscuter des détails de vive voix.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0000_headteacher_17",
      "hash64": "93D339D0689AD75E",
      "text": "Oh mais, quel sot ! J’oubliais que vous n’aviez\\npas encore terminé votre voyage scolaire.\\r\\nChaque chose en son temps, ceci peut attendre.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0000_headteacher_16",
      "hash64": "93D33AD0689AD911",
      "text": "Sur ce, je raccroche. J’espère ne pas vous avoir\\nretenu[VAR 0x1100(00FF,0100)]e trop longtemps. Prenez soin de vous.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    }
  ]
