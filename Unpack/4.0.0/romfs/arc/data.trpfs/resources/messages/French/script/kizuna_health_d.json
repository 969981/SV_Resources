    {
      "ordinal": 11,
      "label": "kizuna_health_d_10",
      "hash64": "062CE78C86334D09",
      "text": "Du coup, je vais continuer à m’occuper\\nde l’infirmerie pendant un moment.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
