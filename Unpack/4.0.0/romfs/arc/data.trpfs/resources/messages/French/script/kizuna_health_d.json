      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_health_d_05",
      "hash64": "0629668C86303BFF",
      "text": "Merci ! Ça fait du bien de se sentir soutenue ![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
