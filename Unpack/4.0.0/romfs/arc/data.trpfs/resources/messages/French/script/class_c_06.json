          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_c_06_history_20b",
      "hash64": "155C63FE365C3348",
      "text": "Et c’est ainsi que le Livre Violet s’est retrouvé\\nconsidéré comme un ouvrage sur le paranormal,\\r\\net qu’il a fini par prendre la poussière chez\\r\\nles bouquinistes.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
