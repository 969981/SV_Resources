    {
      "ordinal": 45,
      "label": "team_0090_botan_06",
      "hash64": "B3E7E701EEFC00F0",
      "text": "Quelle ironie. Les profs, les élèves... Tous des\\nidiots... Il n’y en a pas un pour rattraper l’autre.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
