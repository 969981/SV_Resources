      "ordinal": 44,
      "label": "team_0090_botan_05",
      "hash64": "B3E7EA01EEFC0609",
      "text": "Ils voulaient juste mettre fin aux harcèlements...\\nmais ils sont devenus les méchants de l’histoire...[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
