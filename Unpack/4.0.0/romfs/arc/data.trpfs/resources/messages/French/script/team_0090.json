    {
      "ordinal": 20,
      "label": "team_0090_cassiopeia_08",
      "hash64": "409CBA6F657A6F5B",
      "text": "Cette opération est un réel succès, et c’est\\nvraiment grâce à toi, [VAR 0x0100(0000)].[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
