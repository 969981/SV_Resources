    },
    {
      "ordinal": 11,
      "label": "gym_ghost_020_select_01",
      "hash64": "DD14BEA998FA3570",
      "text": "Yes ! Let’s go !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_ghost_020_select_02",
      "hash64": "DD14C1A998FA3A89",
      "text": "Pas tout à fait.",
      "flags": 0,
