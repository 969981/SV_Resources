          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_ghost_020_mc_19",
      "hash64": "75CC615A7E86141D",
      "text": "Le show commencera quand tu monteras\\nsur scène !\\c\\nPas question que tu redescendes tant que\\nt’auras pas remporté trois victoires d’affilée !\\c\\nAlors comme on dit dans l’milieu, get ready !\\nPrépare-toi bien ![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
