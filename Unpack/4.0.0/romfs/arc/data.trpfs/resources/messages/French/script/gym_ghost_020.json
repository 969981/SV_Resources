    {
      "ordinal": 7,
      "label": "gym_ghost_020_mc_04",
      "hash64": "75CFE25A7E892527",
      "text": "Si tu mets une bonne raclée à tes adversaires\\nen duo, tu mettras deux fois plus le feu qu’avec\\r\\nun seul Pokémon !\\r\\n... Enfin, figurativement, hein ! Tu m’as capté !\\c\\nLe public va hurler de joie !\\nY aura une ambiance de malade ![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 168,
