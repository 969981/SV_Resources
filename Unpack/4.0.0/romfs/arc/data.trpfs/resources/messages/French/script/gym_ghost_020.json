          "offset_units": 233,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_ghost_020_mc_05",
      "hash64": "75CFE15A7E892374",
      "text": "Quand t’auras chauffé le public, la Championne\\npourra venir sur scène tranquille, et t’auras réussi\\r\\nton exam ![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
