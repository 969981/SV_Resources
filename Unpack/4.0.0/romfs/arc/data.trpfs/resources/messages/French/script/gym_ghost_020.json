      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "gym_ghost_020_system_02",
      "hash64": "A6867DAD00458176",
      "text": "Il y a de l’électricité dans l’air !\\nLe public est en délire !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "gym_ghost_020_mc_26",
      "hash64": "75C8D45A7E82EEAF",
