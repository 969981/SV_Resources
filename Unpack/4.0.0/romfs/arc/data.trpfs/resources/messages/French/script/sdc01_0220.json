    {
      "ordinal": 1,
      "label": "sdc01_0220_brother_01",
      "hash64": "B91453C0B7BAD36A",
      "text": "Oh ! Salut, [VAR 0x0100(0000)] ![VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
