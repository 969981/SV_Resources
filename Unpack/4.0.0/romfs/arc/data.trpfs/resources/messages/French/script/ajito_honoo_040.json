    {
      "ordinal": 16,
      "label": "ajito_honoo_040_kakutouboss_06",
      "hash64": "A93E43F7A966801C",
      "text": "Oui ! L’Opération Star va enfin commencer.[VAR 0x0114(0022)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
