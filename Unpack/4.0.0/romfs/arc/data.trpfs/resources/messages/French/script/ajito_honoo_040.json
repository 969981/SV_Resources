    },
    {
      "ordinal": 12,
      "label": "ajito_honoo_040_kakutouboss_03",
      "hash64": "A93E40F7A9667B03",
      "text": "Les autres filles étaient jalouses de sa beauté et\\nlui faisaient beaucoup de remarques à ce sujet...\\c\\nC’est pour ça qu’elle a décidé de se rebeller et\\nd’adopter une attitude plus... agressive.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
