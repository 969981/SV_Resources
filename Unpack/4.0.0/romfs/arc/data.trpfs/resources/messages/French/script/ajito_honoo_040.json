      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_honoo_040_akuboss_02",
      "hash64": "5091E2E5230900B5",
      "text": "Les responsables du harcèlement ont été\\ndénichés et réunis dans la cour par ses soins.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "ajito_honoo_040_honooboss_06",
      "hash64": "2B3420FF78D419C9",
      "text": "Ça y est... C’est l’moment !\\nJ’suis en feu ! J’vais tout brûler ![VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_honoo_040_honooboss_07",
      "hash64": "2B341FFF78D41816",
      "text": "J’voulais tout brûler... Mais j’me suis juste\\nconsumée. Y reste plus rien.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_honoo_040_honooboss_08",
      "hash64": "2B342AFF78D42AC7",
      "text": "Bon bah, voilà. C’est fini.[VAR 0x0114(001F)]",
