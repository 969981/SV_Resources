    },
    {
      "ordinal": 13,
      "label": "ajito_honoo_040_kakutouboss_04",
      "hash64": "A93E45F7A9668382",
      "text": "Et c’est comme ça qu’elle s’est attiré des ennuis,\\ncomme tu dis...[VAR 0x0114(0022)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
