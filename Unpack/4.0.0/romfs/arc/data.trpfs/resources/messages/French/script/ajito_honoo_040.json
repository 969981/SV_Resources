    },
    {
      "ordinal": 9,
      "label": "ajito_honoo_040_fairyboss_02",
      "hash64": "553BCBF0C90A07A7",
      "text": "Parle pour toi... T’es franchement pas mieux\\nque moi.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
