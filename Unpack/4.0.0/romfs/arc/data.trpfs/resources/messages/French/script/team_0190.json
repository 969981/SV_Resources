      ]
    },
    {
      "ordinal": 12,
      "label": "team_0190_botan_11",
      "hash64": "5712BE0133B37BE5",
      "text": "Grâce à toi, mes amis de la Team Star\\nont été épargnés.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
