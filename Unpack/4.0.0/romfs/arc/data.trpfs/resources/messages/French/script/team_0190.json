      "hash64": "5712B70133B37000",
      "text": "Je m’y connais en technologie et en piratage...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
