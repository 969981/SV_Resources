    {
      "ordinal": 1,
      "label": "team_0190_botan_02",
      "hash64": "5716450133B69721",
      "text": "Quand on a formé la Team Star tous les six,\\nil fallait une phrase choc, et on a choisi celle-ci.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
