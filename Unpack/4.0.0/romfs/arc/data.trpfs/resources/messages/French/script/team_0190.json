      "ordinal": 16,
      "label": "team_0190_botan_15",
      "hash64": "5712BA0133B37519",
      "text": "J’ai une dette envers toi... Si je peux faire\\nquoi que ce soit pour t’aider, dis-le-moi.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
