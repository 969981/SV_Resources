    },
    {
      "ordinal": 15,
      "label": "team_0190_botan_14",
      "hash64": "5712B90133B37366",
      "text": "Et puis...[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
