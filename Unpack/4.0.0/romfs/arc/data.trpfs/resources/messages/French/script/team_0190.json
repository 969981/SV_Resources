      "ordinal": 11,
      "label": "team_0190_botan_10",
      "hash64": "5712BD0133B37A32",
      "text": "M-Merci... infiniment.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
