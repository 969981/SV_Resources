    },
    {
      "ordinal": 13,
      "label": "team_0190_botan_12",
      "hash64": "5712BB0133B376CC",
      "text": "Je ne sais vraiment pas quoi faire pour te montrer\\nma gratitude... donc je t’offre ça.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
