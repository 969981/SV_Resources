      "label": "team_0190_botan_13",
      "hash64": "5712BC0133B3787F",
      "text": "Je pense que ça pourra te servir.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
