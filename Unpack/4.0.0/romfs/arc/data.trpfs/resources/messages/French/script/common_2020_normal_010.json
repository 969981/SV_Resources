    },
    {
      "ordinal": 2,
      "label": "common_2020_normal_010_select_01",
      "hash64": "D91C9440602F3F4A",
      "text": "Je suis ravi[VAR 0x1100(00FF,0100)]e de collaborer avec vous.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
