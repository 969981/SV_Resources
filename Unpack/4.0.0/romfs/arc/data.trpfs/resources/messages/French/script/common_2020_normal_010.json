    },
    {
      "ordinal": 3,
      "label": "common_2020_normal_010_select_02",
      "hash64": "D91C9340602F3D97",
      "text": "Je vous remercie de me recevoir.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_normal_010_normal_03",
      "hash64": "5D19735F176D58ED",
      "text": "Tout le plaisir est pour moi...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
