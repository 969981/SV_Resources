          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_normal_010_normal_04",
      "hash64": "5D196C5F176D4D08",
      "text": "Toutefois... la Cheffe est certes ma supérieure,\\nmais je ne m’attendais pas à ce qu’elle confie\\r\\ncette tâche à un[VAR 0x1100(00FF,0100)]e élève...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
