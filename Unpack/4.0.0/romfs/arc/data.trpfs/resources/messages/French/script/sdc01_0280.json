    },
    {
      "ordinal": 2,
      "label": "sdc01_0280_student1_01",
      "hash64": "088E136CA2287378",
      "text": "Salut, [VAR 0x0100(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
