    {
      "ordinal": 20,
      "label": "champ_0260_ground_02",
      "hash64": "02BFD551255BE2D8",
      "text": "Et c’est reparti...[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
