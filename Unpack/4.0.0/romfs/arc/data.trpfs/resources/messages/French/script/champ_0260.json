      "label": "champ_0260_chairman_16",
      "hash64": "E85BBDBB96232639",
      "text": "Maître[VAR 0x1100(00FF,0300)]sse [VAR 0x0100(0000)]...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
