    },
    {
      "ordinal": 6,
      "label": "s1_sub_015_caretaker_07",
      "hash64": "AA1A4AEB935F663E",
      "text": "Les Adoramis ont beau avoir commis des actes\\nimpardonnables...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
