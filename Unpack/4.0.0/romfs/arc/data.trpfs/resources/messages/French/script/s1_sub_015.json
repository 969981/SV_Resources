      "text": "Oooh... Nom d’une pipe en bois ![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "s1_sub_015_caretaker_29",
      "hash64": "AA13C8EB935A1DAA",
      "text": "Les statuettes sont comme neuves !\\nLa collecte a vraiment porté ses fruits ![VAR 0x0114(0045)]",
