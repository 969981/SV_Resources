          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_015_caretaker_08",
      "hash64": "AA1A45EB935F5DBF",
      "text": "Ça me fend le cœur de voir l’état des statuettes\\nà leur effigie...\\c\\nTu trouves ça triste, toi aussi ?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
