    },
    {
      "ordinal": 9,
      "label": "s1_sub_015_caretaker_10",
      "hash64": "AA1747EB935D2B4E",
      "text": "Vraiment ? Tu as pourtant vu ce qui s’est passé,\\nsi je ne m’abuse.\\c\\nJ’ai du mal à croire que la vision de cet autel\\ndétruit te laisse indifférent[VAR 0x1100(00FF,0100)]e ![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
