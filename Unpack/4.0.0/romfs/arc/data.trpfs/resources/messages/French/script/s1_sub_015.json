          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_015_caretaker_19",
      "hash64": "AA1740EB935D1F69",
      "text": "Reviens quand tu veux !\\nNous atteindrons les 1 000 000 , je le sens ![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_015_caretaker_20",
      "hash64": "AA13C1EB935A11C5",
      "text": "Tu n’as pas assez d’argent pour faire don\\nd’une telle somme...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_sub_015_caretaker_21",
      "hash64": "AA13C0EB935A1012",
      "text": "Quelle générosité ! Merci !\\nVoici un petit cadeau pour la peine.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_sub_015_caretaker_22",
      "hash64": "AA13BFEB935A0E5F",
      "text": "Cela fait un total de [VAR 0x0206(0001,0020)]  ! Nous n’avons\\njamais été aussi près des 1 000 000  ![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
