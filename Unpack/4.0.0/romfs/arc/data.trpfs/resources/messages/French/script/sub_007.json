      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_007_model_08",
      "hash64": "B85952A3158361FA",
      "text": "Oh, dommage...",
