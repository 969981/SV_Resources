    {
      "ordinal": 3,
      "label": "sub_007_model_04a",
      "hash64": "C300FE1D8E1D7AB5",
      "text": "Hmmm... Oh... Je...\\nÇa... Ça alors... ! À ce point ?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_007_model_04b",
      "hash64": "C300FB1D8E1D759C",
      "text": "Hmmm... Oui, je vois...\\nOh... C’est donc ça...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_007_model_05a",
      "hash64": "C303E21D8E1F80F8",
      "text": "[VAR 0x0102(0001)] donne vraiment tout ce qu’il a !\\nTiens, j’ai une jolie récompense pour lui !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
