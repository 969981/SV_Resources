          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_007_model_05b",
      "hash64": "C303E51D8E1F8611",
      "text": "Comment dire... ? Je crois que ton Pokémon\\npourrait faire un peu plus d’efforts !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_007_model_06",
      "hash64": "B85944A315834A30",
      "text": "[VAR 0x0102(0001)] reçoit un Ruban Effort !",
