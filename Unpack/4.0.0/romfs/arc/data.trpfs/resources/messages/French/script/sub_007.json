      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_007_model_03",
      "hash64": "B85949A3158352AF",
      "text": "OK... Voyons si [VAR 0x0102(0001)] fait vraiment\\nde son mieux !",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
