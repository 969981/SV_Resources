      "ordinal": 0,
      "label": "ajito_aku_010_sitappa_a_01",
      "hash64": "EA9DF8A57A95E017",
      "text": "Hep, hep, hep ! Pas si vite ![VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
