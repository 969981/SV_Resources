          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0115_select_07",
      "hash64": "A25339232FC8477F",
      "text": "C’est d’accord !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "team_0115_select_08",
      "hash64": "A2533E232FC84FFE",
      "text": "Vous pouvez compter sur moi !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "team_0115_nelke_32",
      "hash64": "4DAF16DB987FE054",
      "text": "Merci infiniment.\\nJe savais que je pouvais vous faire confiance.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
