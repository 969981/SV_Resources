      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "team_0115_nelke_12",
      "hash64": "4DA88EDB987A8D8E",
      "text": "Je vous l’assure ![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
