    {
      "ordinal": 52,
      "label": "team_0115_nelke_37",
      "hash64": "4DAF13DB987FDB3B",
      "text": "Le Big Boss vous a donné rendez-vous dans\\nla cour, de nuit, n’est-ce pas ?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
