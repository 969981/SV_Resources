          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "team_0115_math_02",
      "hash64": "7499F644469AC616",
      "text": "Plaisir NON partagé ! Qu’est-ce que c’est que\\nce cirque, monsieur Clavel ?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
