        }
      ]
    },
    {
      "ordinal": 44,
      "label": "team_0115_nelke_33",
      "hash64": "4DAF17DB987FE207",
      "text": "Oh, madame Thaïm.\\nQuel plaisir de vous voir ![VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
