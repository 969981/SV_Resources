      ]
    },
    {
      "ordinal": 15,
      "label": "team_0115_nelke_09b",
      "hash64": "7735C4241BF0EE4C",
      "text": "Balivernes ! Mon déguisement était parfait !\\c\\nQuoique... il est vrai que mon jeu d’acteur laissait\\nà désirer par moments, et cela n’a pas échappé\\r\\nà votre attention. Fichtre.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
