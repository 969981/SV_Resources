          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "team_0115_nelke_13",
      "hash64": "4DA88FDB987A8F41",
      "text": "J’ai enregistré à l’avance toutes les conversations\\nsur mon radiocassette.\\c\\nEt grâce à un stratagème dont je vous épargnerai\\nl’explication, je vous ai dupé[VAR 0x1100(00FF,0100)]e ! C’est la vérité ![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
