          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "team_0115_nelke_34",
      "hash64": "4DAF14DB987FDCEE",
      "text": "Il y a méprise, madame. Voyez-vous, il y a\\nune explication tout à fait rationnelle à...[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
