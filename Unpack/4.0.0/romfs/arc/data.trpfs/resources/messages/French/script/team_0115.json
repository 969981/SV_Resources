          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "team_0115_nelke_19",
      "hash64": "4DA885DB987A7E43",
      "text": "Je ne suis pas Cassiopée, c’était un mensonge...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "team_0115_nelke_20",
      "hash64": "4DB27EDB9882C6E3",
      "text": "En revanche, Clove et moi étions bel et bien\\nla même personne. Vous pouvez me croire.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "team_0115_nelke_21",
      "hash64": "4DB27DDB9882C530",
      "text": "J’imagine que vous vous demandez maintenant\\nquelle est la véritable identité de Cassiopée...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "team_0115_nelke_22",
      "hash64": "4DB280DB9882CA49",
      "text": "À dire vrai, j’ai ma petite idée sur la question.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "team_0115_nelke_23",
      "hash64": "4DB27FDB9882C896",
      "text": "C’est d’ailleurs ce qui m’a poussé à venir. Je\\nvoulais vous épargner un affrontement... difficile.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "team_0115_nelke_24",
      "hash64": "4DB282DB9882CDAF",
      "text": "Je ne voulais pas qu’à l’issue de votre combat,\\nla tristesse de Cassiopée devienne votre fardeau.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "team_0115_nelke_25",
      "hash64": "4DB281DB9882CBFC",
      "text": "Cependant, sa décision est prise, et\\ncette dernière est irrévocable.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "team_0115_nelke_26",
      "hash64": "4DB284DB9882D115",
      "text": "Nonobstant, j’avais des doutes sur les capacités\\nd’un[VAR 0x1100(00FF,0100)]e simple élève à relever tel défi.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "team_0115_nelke_27",
      "hash64": "4DB283DB9882CF62",
      "text": "C’est pour cette raison que je vous ai provoqué[VAR 0x1100(00FF,0100)]e\\nen duel. Pour vous tester.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
