          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "team_0115_math_03",
      "hash64": "7499F744469AC7C9",
      "text": "J’ai entendu dire qu’un combat avait lieu au sein\\nmême de l’établissement, et que vois-je ?![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "team_0115_math_04",
      "hash64": "7499F844469AC97C",
      "text": "Le proviseur en personne qui se bat contre un[VAR 0x1100(00FF,0100)]e\\nde nos élèves ! N’avez-vous pas honte ?![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 3,
          "code_hex": "1100",
