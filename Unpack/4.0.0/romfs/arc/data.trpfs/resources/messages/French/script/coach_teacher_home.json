      "ordinal": 24,
      "label": "coach_teacher_home_sp03_02",
      "hash64": "8C60CEB9C30FF808",
      "text": "En plus d’être tout à fait adorable, il dégage\\nune fragrance sucrée tout à fait délicieuse.\\r\\nLes mots peinent à la décrire.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
