      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
