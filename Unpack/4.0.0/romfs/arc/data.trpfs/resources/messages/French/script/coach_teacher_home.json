    {
      "ordinal": 42,
      "label": "coach_teacher_home_trade_02_00",
      "hash64": "B75AB83A7ED6C3C7",
      "text": "Es-tu certain[VAR 0x1100(00FF,0100)]e de vouloir échanger ton\\n[VAR 0x0101(0001)] contre mon Chapotus ?[VAR 0x0114(0029)]",
