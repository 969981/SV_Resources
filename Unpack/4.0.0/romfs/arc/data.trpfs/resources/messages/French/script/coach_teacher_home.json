      "label": "coach_teacher_home_sp02_03",
      "hash64": "35FB07B227A63CB2",
      "text": "Me voilà rassuré ! C’était la première fois\\nque je m’essayais à cet exercice...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
