    },
    {
      "ordinal": 18,
      "label": "coach_teacher_home_sp02_03b",
      "hash64": "5FCAE3B95F795570",
      "text": "Ah oui, tu trouves ?! Elle me plaît beaucoup\\négalement ![VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
