    },
    {
      "ordinal": 61,
      "label": "coach_teacher_home_randomtalk_00",
      "hash64": "F7F652B98B85042B",
      "text": "Mon cours sur les meilleurs en-cas à donner aux\\nPokémon après un combat a beaucoup de succès.\\c\\nTu devrais essayer d’y assister, la prochaine fois ![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
