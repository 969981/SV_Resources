          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "coach_teacher_home_trade_01_02",
      "hash64": "8B53B0341D6CB17E",
      "text": "Toutes les rencontres sont exceptionnelles.\\nQue dirais-tu d’en partager une avec moi\\r\\nau travers d’un échange de Pokémon ?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
