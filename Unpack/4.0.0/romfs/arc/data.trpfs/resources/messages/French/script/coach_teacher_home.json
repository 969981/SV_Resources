          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "coach_teacher_home_trade_01_01",
      "hash64": "8B53AF341D6CAFCB",
      "text": "Toi qui as été par monts et par vaux, tu as dû\\nfaire quantité de belles rencontres.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
