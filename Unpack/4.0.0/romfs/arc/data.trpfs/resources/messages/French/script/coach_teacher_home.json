    },
    {
      "ordinal": 37,
      "label": "coach_teacher_home_trade_01_00",
      "hash64": "8B53AE341D6CAE18",
      "text": "Tu sais, c’est grâce à ton invitation à l’institut que\\nj’ai pu faire sa connaissance.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
