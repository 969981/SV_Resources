      "ordinal": 48,
      "label": "coach_teacher_home_trade_04_00",
      "hash64": "59AEBC0A6433D32D",
      "text": "Veux-tu que nous procédions à notre\\néchange de Pokémon ?[VAR 0x0114(0029)]",
