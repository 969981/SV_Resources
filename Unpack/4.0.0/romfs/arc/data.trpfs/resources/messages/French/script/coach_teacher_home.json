    },
    {
      "ordinal": 36,
      "label": "coach_teacher_home_sp03_09",
      "hash64": "8C60C9B9C30FEF89",
      "text": "J’ai ajusté ma rotation avec précision pour que\\nmon Charmilly prenne exactement l’apparence\\r\\nque je souhaitais pour lui.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
