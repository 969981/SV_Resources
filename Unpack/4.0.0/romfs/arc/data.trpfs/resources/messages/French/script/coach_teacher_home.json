    },
    {
      "ordinal": 25,
      "label": "coach_teacher_home_sp03_03",
      "hash64": "8C60CFB9C30FF9BB",
      "text": "Il faut recourir à une méthode plutôt originale\\npour le faire évoluer. La connais-tu ?[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
