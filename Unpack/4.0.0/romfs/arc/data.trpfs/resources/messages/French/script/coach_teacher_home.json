          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "coach_teacher_home_trade_01_03",
      "hash64": "8B53B1341D6CB331",
      "text": "Je choisis d’envoyer un Chapotus.\\nQu’en est-il de toi ?[VAR 0x0114(0029)]",
