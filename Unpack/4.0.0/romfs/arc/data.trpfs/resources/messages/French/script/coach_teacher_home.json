    },
    {
      "ordinal": 44,
      "label": "coach_teacher_home_trade_02_02",
      "hash64": "B75ABA3A7ED6C72D",
      "text": "Vous ne pouvez pas échanger de Pokémon rares.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "coach_teacher_home_trade_02_03",
      "hash64": "B75AB93A7ED6C57A",
      "text": "Vous ne pouvez pas échanger\\nde Pokémon chromatiques.",
