    {
      "ordinal": 59,
      "label": "coach_teacher_home_battleend_win_01_01",
      "hash64": "D6F633CF37C88F57",
      "text": "Je te suis reconnaissant d’avoir été\\nmon adversaire.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
