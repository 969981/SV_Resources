      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 46,
      "label": "coach_teacher_home_trade_03_00",
      "hash64": "0F06E2421B55E9F6",
      "text": "Il n’est pas convenable de procéder à un échange\\nlorsque tu ne possèdes qu’un seul Pokémon.\\c\\nQue dirais-tu de revenir une fois que tu auras\\nau moins deux Pokémon dans ton équipe ?[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
