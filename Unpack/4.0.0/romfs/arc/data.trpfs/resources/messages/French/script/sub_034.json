          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_034_ecology_07",
      "hash64": "AE5340C3090E04EA",
      "text": "Merci beaucoup pour ton aide ! Je vais t’envoyer\\nun petit quelque chose en remerciement.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sub_034_ecology_08",
      "hash64": "AE5333C3090DEED3",
      "text": "... Oh là là ! Te voilà à peine revenu[VAR 0x1100(00FF,0100)]e de ce raid\\ndangereux que nos capteurs s’affolent à nouveau.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
