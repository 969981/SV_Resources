        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_034_select_02",
      "hash64": "CEC58251382C8031",
      "text": "Ce n’était pas évident, mais c’est réglé !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_034_ecology_03",
      "hash64": "AE533CC3090DFE1E",
      "text": "T-tu t’es battu[VAR 0x1100(00FF,0100)]e contre ce Pokémon ?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
