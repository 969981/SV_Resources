          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sub_034_ecology_09",
      "hash64": "AE5332C3090DED20",
      "text": "Cela signifie qu’à l’avenir, nous verrons peut-être\\nd’autres cristaux noirs, et les raids qui vont avec.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_034_ecology_10",
      "hash64": "AE4FB5C3090AE2E2",
      "text": "Je sais que tu vas n’en faire qu’à ta tête, alors\\nje ne vais pas insister...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
