      ]
    },
    {
      "ordinal": 7,
      "label": "sub_034_ecology_05",
      "hash64": "AE533EC3090E0184",
      "text": "Enfin... Le principal, c’est que tu n’aies rien.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
