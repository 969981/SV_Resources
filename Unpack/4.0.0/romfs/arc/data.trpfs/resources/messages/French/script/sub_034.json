          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_034_ecology_06",
      "hash64": "AE5341C3090E069D",
      "text": "Grâce à toi, nous savons maintenant par quels\\nprincipes les émanations d’énergie Téracristal\\r\\nsont régies.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
