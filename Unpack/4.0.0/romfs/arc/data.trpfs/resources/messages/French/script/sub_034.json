    {
      "ordinal": 3,
      "label": "sub_034_select_01",
      "hash64": "CEC57F51382C7B18",
      "text": "Je suis venu[VAR 0x1100(00FF,0100)]e, j’ai vu, j’ai vaincu !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
