          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0020_friend_02",
      "hash64": "173BEF9E992CE738",
      "text": "Et puis, elle est cool, ta chambre !\\nElle est plus spacieuse que celles du campus ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0020_friend_03",
      "hash64": "173BF09E992CE8EB",
      "text": "Et la déco est... euh...\\nT’aimes bien les trucs mignons, on dirait...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0020_botan_02",
      "hash64": "CA8C00C03806B344",
      "text": "Oh ! Tu as une Nintendo Switch ?\\nTu as quoi, comme jeux ?[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0020_rival_02",
      "hash64": "F20983A16E90FBAA",
      "text": "J’adore ton pouf Rongourmand !\\nIl a l’air tout doux ![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0020_mama_01",
      "hash64": "510DAA57FC29434D",
      "text": "Vous avez encore faim, les enfants ?\\nJe pensais vous préparer un petit goûter ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side01_0020_botan_03",
      "hash64": "CA8C01C03806B4F7",
      "text": "Un goûter ?! Mais c’est génial, ici ![VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0020_friend_04",
      "hash64": "173BF59E992CF16A",
      "text": "Oh, c’est vraiment gentil, madame !\\nMais loin de nous l’idée de nous imploser !\\c\\nEuh, j’veux dire, « imposer » !!!\\nOn veut surtout pas s’imposer !!![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0020_mama_02",
      "hash64": "510DA757FC293E34",
      "text": "Hi hi hi ! Pas la peine d’être aussi formel ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side01_0020_mama_03",
      "hash64": "510DA857FC293FE7",
      "text": "Faites comme chez vous ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side01_0020_friend_05",
      "hash64": "173BF69E992CF31D",
      "text": "O-oui, madame ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side01_0020_mama_04",
      "hash64": "510DA557FC293ACE",
      "text": "À propos, mon cœur, tu as reçu du courrier.[VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_side01_0020_mama_05",
      "hash64": "510DA657FC293C81",
      "text": "C’est de la part d’un certain « Kassis »...\\nTu sais qui c’est ?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side01_0020_mama_06",
      "hash64": "510DA357FC293768",
      "text": "C’est un nouvel ami ? J’espère que j’aurai\\nl’occasion de le rencontrer, lui aussi ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side01_0020_mama_07",
      "hash64": "510DA457FC29391B",
      "text": "Ah bon ? C’est curieux... Peut-être que tu t’en\\nsouviendras en lisant la lettre.[VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side01_0020_mama_08",
      "hash64": "510DA157FC293402",
      "text": "Tiens, la voici.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side01_0020_mama_09",
      "hash64": "510DA257FC2935B5",
      "text": "Sur ce, je vais descendre préparer le goûter.\\nJe vous l’apporte tout de suite ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_side01_0020_rival_03",
      "hash64": "F20984A16E90FD5D",
      "text": "Je vais vous aider ![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_side01_0020_botan_04",
      "hash64": "CA8BFEC03806AFDE",
      "text": "Moi aussi, je viens.\\nJe veux savoir ce qu’on va manger ![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_side01_0020_friend_06",
      "hash64": "173BF39E992CEE04",
      "text": "Elle est vraiment trop gentille, ta maman...\\nT’en as, de la chance...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_side01_0020_friend_07",
      "hash64": "173BF49E992CEFB7",
      "text": "Et du coup, cette lettre ? Tu comptes pas la lire ?[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_side01_0020_system_01",
      "hash64": "3C3D2C22F21CB0A6",
      "text": "Ch[VAR 0x1100(00FF,0302)]erère [VAR 0x0100(0000)],\\n\\nJ’espère que tu vas bien. De mon côté,\\nj’ai demandé à temporairement quitter l’institut\\npour retourner à Jaderaude. Roseille aussi est\\nrevenue au village.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302"
          ]
        },
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_side01_0020_system_02",
      "hash64": "3C3D2B22F21CAEF3",
      "text": "On n’a pas eu l’occasion de se revoir depuis\\nce qu’il s’est passé dans l’abîme.\\nJ’aimerais donc t’inviter à revenir chez moi,\\nà Septentria. J’ai inclus plusieurs billets\\nà cette lettre, pour toi et tes amis de Paldea.\\nRoseille aussi a hâte de te revoir. À plus, Kassis.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "s2_side01_0020_friend_08",
      "hash64": "173BE99E992CDD06",
      "text": "C’est qui, lui ? Un pote à toi ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_side01_0020_select_01",
      "hash64": "4619053020F106E1",
      "text": "C’est un bon ami !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "s2_side01_0020_select_02",
      "hash64": "4619023020F101C8",
      "text": "Un truc du genre...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "s2_side01_0020_friend_09",
      "hash64": "173BEA9E992CDEB9",
      "text": "Ah ouais ?\\nCool...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_side01_0020_friend_10",
      "hash64": "173F779E99300427",
      "text": "Comment ça, « un truc du genre » ?\\n’Fin, pas que ça m’concerne, mais bon...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "s2_side01_0020_rival_04",
      "hash64": "F2097DA16E90F178",
      "text": "[VAR 0x0100(0000)] ! Pepper ! Ce goûter est\\nvraiment GÉ-NIAL ! Vous allez pas en revenir !!![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
