      ]
    },
    {
      "ordinal": 32,
      "label": "s2_side01_0020_rival_05",
      "hash64": "F2097EA16E90F32B",
      "text": "Par contre, on a pas assez de mains pour tout\\napporter, donc descendez, plutôt ! On a FAIM !!![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
