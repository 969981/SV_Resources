          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s2_side01_0020_friend_11",
      "hash64": "173F769E99300274",
      "text": "... Elle a vraiment besoin de hurler comme ça ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "s2_side01_0020_friend_12",
      "hash64": "173F799E9930078D",
      "text": "Enfin, bref... Viens ! On descend ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "s2_side01_0020_botan_05",
      "hash64": "CA8BFFC03806B191",
      "text": "Ouh là là, j’ai vraiment trop mangé...\\nJe vais exploser si j’avale un truc de plus.[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "s2_side01_0020_friend_13",
      "hash64": "173F789E993005DA",
      "text": "Tu pourrais dire merci, quand même ![VAR 0x0114(0006)]",
