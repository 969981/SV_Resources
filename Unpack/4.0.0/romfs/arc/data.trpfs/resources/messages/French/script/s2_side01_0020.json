    {
      "ordinal": 1,
      "label": "s2_side01_0020_friend_01",
      "hash64": "173BF29E992CEC51",
      "text": "Elle cuisine trop bien, en plus ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
