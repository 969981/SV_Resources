      "hash64": "D891B15F415C18BB",
      "text": "Motiti ♪ Motiti ♪ Motiti ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "ajito_doku_020_cassiopeia_01",
      "hash64": "BDF6BAD267EEA991",
      "text": "... Tu as réussi à te débarrasser du garde.\\nParfait.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
