          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_doku_020_cassiopeia_02",
      "hash64": "BDF6B7D267EEA478",
      "text": "Les élèves qui sont réunis dans ce repaire font\\npartie de l’équipe Poison de la Team Star...\\r\\nOn les appelle le Groupe Tsih.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_doku_020_cassiopeia_03",
      "hash64": "BDF6B8D267EEA62B",
      "text": "Le boss du groupe est Erio. Comme il a un don\\npour la couture, c’est lui qui a créé les costumes\\r\\nde la Team Star. Il est aussi un peu... excentrique.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 152,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_doku_020_cassiopeia_04",
      "hash64": "BDF6BDD267EEAEAA",
      "text": "C’est une personne assez imprévisible...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_doku_020_cassiopeia_05",
      "hash64": "BDF6BED267EEB05D",
      "text": "Du coup, difficile de savoir quel stratagème il va\\nadopter face au défi qu’on lui a lancé.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_doku_020_cassiopeia_06",
      "hash64": "BDF6BBD267EEAB44",
      "text": "En attendant qu’il se montre, mets un maximum\\nde Pokémon de garde hors d’état de nuire.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
