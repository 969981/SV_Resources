        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0320_bbteacher_08",
      "hash64": "0793200612F08C59",
      "text": "Il doit entrer en résonance avec\\nton Orbe Téracristal...[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
