    {
      "ordinal": 1,
      "label": "gym_ghost_040_receptionist_00",
      "hash64": "C76E70C6C35914B0",
      "text": "Bienvenue à l’Arène de Frigao,\\n[VAR 0x0100(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
