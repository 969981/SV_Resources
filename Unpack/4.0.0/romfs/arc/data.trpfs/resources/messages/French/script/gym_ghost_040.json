          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_ghost_040_select_01",
      "hash64": "0E65523F48A7AD8E",
      "text": "Combat !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "gym_ghost_040_select_02",
      "hash64": "0E65513F48A7ABDB",
      "text": "Rap battle !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "gym_ghost_040_ghost_08",
      "hash64": "1436A7F9B1C257CC",
      "text": "T’es pas opé pour rapper ? T’inquiète, bébé,\\nj’peux aussi t’mettre une raclée ! Ha ha ha ![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_ghost_040_ghost_09",
      "hash64": "1436A8F9B1C2597F",
      "text": "Ha ha ha ! Tu fais de l’humour, aussi ?\\nExcellent, j’kiffe ton amour du défi ![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_ghost_040_ghost_10",
      "hash64": "143A35F9B1C57EED",
      "text": "... Hein ?\\nTu veux savoir pourquoi j’parle en rimes ?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_ghost_040_ghost_11",
      "hash64": "143A34F9B1C57D3A",
      "text": "C’est du rap, cousin[VAR 0x1100(00FF,0100)]e !\\c\\nC’est des textes faits de mots qui riment et qui\\ns’enchaînent pour exprimer le fond d’ton âme.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_ghost_040_ghost_12",
      "hash64": "143A33F9B1C57B87",
      "text": "J’suis prolixe sur le mix, carrière à la brillance\\nde l’onyx, autant qu’les yeux de Ténéfix.  ♪\\c\\nGenre comme ça. Tu m’suis ?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "gym_ghost_040_ghost_13",
      "hash64": "143A32F9B1C579D4",
      "text": "Bah, de toute façon, t’es un[VAR 0x1100(00FF,0100)]e Dresseu[VAR 0x1100(00FF,0201)]rse, toi !\\nC’est en combat qu’ton âme s’exprime, pas vrai ?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0201"
          ]
        },
        {
          "kind": "control",
          "offset_units": 106,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "gym_ghost_040_ghost_14",
      "hash64": "143A31F9B1C57821",
      "text": "Moi, à la base, j’suis rappeuse, mais\\nles Pokémon Spectre aussi, ça m’connaît ![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "gym_ghost_040_ghost_15",
      "hash64": "143A30F9B1C5766E",
      "text": "Et au cas où t’as pas encore eu l’info :\\nmoi, c’est Laïm, aka l’Esprit Rappeur ![VAR 0x0114(001B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "gym_ghost_040_ghost_16",
      "hash64": "143A2FF9B1C574BB",
      "text": "Alors, t’as peur ? T’as des frayeurs ?♪\\nMême si tu pleures, j’te ferai pas d’fleurs !♪[VAR 0x0114(001B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "gym_ghost_040_ghost_17",
      "hash64": "143A2EF9B1C57308",
      "text": "Ha ha ha ! Pas maaal ! On pouvait ressentir\\nles vibrations d’ton âme jusqu’ici ![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "gym_ghost_040_ghost_18",
      "hash64": "143A2DF9B1C57155",
      "text": "T’as vraiment un talent pur, cousin[VAR 0x1100(00FF,0100)]e !\\nTiens, prends ce Badge, c’est grave mérité ![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "gym_ghost_040_ghost_19",
      "hash64": "143A2CF9B1C56FA2",
      "text": "Et parce que ça m’fait plaisir, j’te file aussi\\nune place VIP pour mon prochain concert ![VAR 0x0114(001B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "gym_ghost_040_ghost_badge",
      "hash64": "0D82A4DAAE6440AF",
      "text": "Ça t’fait [VAR 0x0200(0001)] Badge[VAR 0x1101(0001,0100)]s d’Arène !\\c\\nMaintenant, t’auras aucun mal à capturer\\ndes Pokémon jusqu’au niveau [VAR 0x0201(0002)], et en plus,\\r\\nils t’obéiront ![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0200",
