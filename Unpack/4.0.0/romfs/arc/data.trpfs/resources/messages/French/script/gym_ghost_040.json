    },
    {
      "ordinal": 19,
      "label": "gym_ghost_040_ghost_07",
      "hash64": "1436AEF9B1C263B1",
      "text": "Oh, mais c’est ma première partie ! Lourd !\\nTu veux t’battre ? OK ! Combat ou rap battle ?[VAR 0x0114(001B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
