          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_ghost_040_ghost_04",
      "hash64": "1436ABF9B1C25E98",
      "text": "Attends ! Tu vas où ?!\\nOn a pas fini, frérot !\\c\\nTsss... D’où, « demain, 15 heures » ?\\nIl m’a pourri mon groove...[VAR 0x0114(001B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
