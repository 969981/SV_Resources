    },
    {
      "ordinal": 18,
      "label": "gym_ghost_040_ghost_06",
      "hash64": "1436ADF9B1C261FE",
      "text": "... Hmmm ?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
