          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_history_a_04",
      "hash64": "363F0EB6BA159FCF",
      "text": "Et j’ai une petite question pour toi, justement.\\c\\nQu’est-ce que tu préfères : les choses anciennes,\\nou les choses récentes ?[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
