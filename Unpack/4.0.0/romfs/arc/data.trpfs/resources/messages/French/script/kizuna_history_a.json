          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_history_a_select_01",
      "hash64": "80B561B1C81F442F",
      "text": "Les choses récentes !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_history_a_select_02",
      "hash64": "80B562B1C81F45E2",
      "text": "Les choses anciennes !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_history_a_05",
      "hash64": "363F0DB6BA159E1C",
      "text": "Je vois, t’es du genre à répondre ce genre\\nde choses à ta prof d’Histoire !\\c\\nHé hé, t’es définitivement fascinant[VAR 0x1100(00FF,0100)]e,\\ncomme élève.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
