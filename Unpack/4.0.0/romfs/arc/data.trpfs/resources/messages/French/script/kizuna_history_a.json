      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_history_a_03",
      "hash64": "363F0BB6BA159AB6",
      "text": "La vérité, c’est que... je te trouve assez\\nfascinant[VAR 0x1100(00FF,0100)]e, comme élève.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
