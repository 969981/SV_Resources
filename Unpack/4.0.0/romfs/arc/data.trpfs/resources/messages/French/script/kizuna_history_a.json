          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_history_a_08",
      "hash64": "363F12B6BA15A69B",
      "text": "... Ah ! Ne fais pas attention à moi, je parlais\\ntoute seule.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
