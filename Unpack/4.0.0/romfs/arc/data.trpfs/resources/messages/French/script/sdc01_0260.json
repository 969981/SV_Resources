  "source": "message/dat/French/script/sdc01_0260.dat",
  "paired_tbl": "message/dat/French/script/sdc01_0260.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0260_sister_01",
      "hash64": "202010556D6F7C6C",
      "text": "Mais... c’est horrible ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0260_sister_02",
      "hash64": "202013556D6F8185",
      "text": "J’arrive pas à le croire... Pauvre Ogerpon !\\nOn devrait plutôt appeler ces Adoramis des\\r\\n« Abhorrennemis », en fait ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0260_sister_03",
      "hash64": "202012556D6F7FD2",
      "text": "C’est tout le contraire de ce que dit l’histoire !\\nIl faut vite mettre tout le monde au courant ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0260_gfather_01",
      "hash64": "A90088882A053D61",
      "text": "Reste ici ! Je t’ai dit qu’il ne fallait en parler\\nà personne ![VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0260_sister_04",
      "hash64": "20200D556D6F7753",
      "text": "Mais, papy... ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0260_gfather_05",
      "hash64": "A9008C882A05442D",
      "text": "Les gens du village croient dur comme fer à leur\\nversion de l’histoire.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0260_gfather_06",
      "hash64": "A90089882A053F14",
      "text": "Qu’arrivera-t-il si l’on révèle que leurs Adoramis\\ntant vénérés ne sont pas ceux qu’ils croient ?[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0260_sister_05",
      "hash64": "20200C556D6F75A0",
      "text": "... Ça passera mal ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0260_gfather_07",
      "hash64": "A9008A882A0540C7",
      "text": "Exactement.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0260_gfather_08",
      "hash64": "A9007F882A052E16",
      "text": "Notre ancêtre, le fabricant de masques, a lui\\naussi tenté de révéler toute la vérité...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0260_gfather_09",
      "hash64": "A90080882A052FC9",
      "text": "Mais personne ne l’a écouté.\\nIl fut traité comme un hérétique et persécuté.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0260_sister_06",
      "hash64": "20200F556D6F7AB9",
      "text": "Tss... Plus j’en apprends sur cette histoire,\\nplus ça m’énerve ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0260_gfather_10",
      "hash64": "A9040D882A085537",
      "text": "Par conséquent, notre ancêtre a décidé de se\\ntaire pour protéger sa descendance.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0260_gfather_11",
      "hash64": "A9040C882A085384",
      "text": "Il a choisi d’en faire un secret familial transmis\\nde génération en génération.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0260_sister_07",
      "hash64": "20200E556D6F7906",
      "text": "Je vois...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0260_sister_08",
      "hash64": "202019556D6F8BB7",
      "text": "Est-ce que Kass est au courant de tout ça ?[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0260_gfather_12",
      "hash64": "A9040F882A08589D",
      "text": "Non, je ne lui ai encore rien raconté.\\nPourquoi cette question ?[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0260_sister_09",
      "hash64": "202018556D6F8A04",
      "text": "Je me disais juste que ça expliquerait\\nsa fascination quasi maladive pour le Monstre...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0260_sister_10",
      "hash64": "201C8B556D6C6496",
      "text": "Il lui est aussi arrivé de me faire des petites\\nremarques insolentes, l’air de dire « j’en sais\\r\\nplus sur le Monstre que toi »...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0260_gfather_13",
      "hash64": "A9040E882A0856EA",
      "text": "C’est curieux...\\c\\nMais ton petit frère est un garçon sensible,\\nil a peut-être décelé une partie de la vérité.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0260_gfather_14",
      "hash64": "A90409882A084E6B",
      "text": "Quand le temps sera venu, je lui raconterai aussi\\ntoute l’histoire.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0260_gfather_15",
      "hash64": "A90408882A084CB8",
      "text": "En tout cas, je compte sur vous pour garder\\ntout ceci secret.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0260_sister_11",
      "hash64": "201C8C556D6C6649",
      "text": "Oui, papy.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0260_sister_12",
      "hash64": "201C89556D6C6130",
      "text": "Raison de plus pour ne rien dire à Kass...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0260_gfather_16",
      "hash64": "A9040B882A0851D1",
      "text": "À propos du masque que tu m’as montré...\\nIl me semble que la gemme au niveau du front\\r\\nétait abîmée.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0260_gfather_17",
      "hash64": "A9040A882A08501E",
      "text": "Si tu veux bien me le confier, je pense que\\nje pourrai le réparer.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0260_sister_13",
      "hash64": "201C8A556D6C62E3",
      "text": "Il s’est peut-être abîmé quand il est tombé\\ndans les escaliers...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0260_sister_14",
      "hash64": "201C8F556D6C6B62",
      "text": "En tout cas, ça serait une bonne idée de réparer\\nle masque avant de le rendre à Ogerpon ![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0260_system_01",
      "hash64": "73D359AF4019283F",
      "text": "Vous confiez le Masque Turquoise au grand-père\\nde Roseille et Kassis.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "sdc01_0260_gfather_18",
      "hash64": "A90405882A08479F",
      "text": "Ne t’en fais pas, je vais en prendre soin.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0260_sister_15",
      "hash64": "201C90556D6C6D15",
      "text": "J’ai trop hâte de revoir Ogerpon, mais ça devra\\nattendre la réparation du masque, j’imagine...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0260_sister_16",
      "hash64": "201C8D556D6C67FC",
      "text": "Continuons la course d’orientation pour l’instant.\\c\\nSi on suit sagement le programme, Kass se\\ndoutera de rien.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0260_sister_17",
      "hash64": "201C8E556D6C69AF",
      "text": "D’ailleurs, il faut que tu ailles le rejoindre !\\nJ’imagine qu’il zone quelque part au village.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_0260_sister_18",
      "hash64": "201C93556D6C722E",
      "text": "Mon binôme est le gars le plus barbant du\\nmonde... Il est pas méchant, hein, mais bon...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_0260_gfather_19",
      "hash64": "A90404882A0845EC",
      "text": "L’histoire que je vous ai contée doit rester\\nentre nous. N’en parle à personne !\\c\\nQuant au masque, je vais en prendre soin.\\nIl sera bientôt réparé ![VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    }
  ]
}
