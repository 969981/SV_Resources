          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0095_rival_01",
      "hash64": "C21E4249095E5426",
      "text": "Oui, madame ! [VAR 0x0100(0000)] est entre de\\nbonnes mains, vous pouvez compter sur moi ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0095_mama_03",
      "hash64": "E4F2D6E37D111930",
      "text": "Je suis contente que tu te sois déjà fait\\nune bonne amie ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0095_mama_04",
      "hash64": "E4F2DDE37D112515",
      "text": "J’ai lu le prospectus de l’école tout à l’heure,\\net apparemment, les enseignants y sont tous\\r\\nplus remarquables les uns que les autres !\\c\\nEn plus, tu vas pouvoir profiter de tous les\\néquipements à loisir ! C’est merveilleux ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 229,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0095_mama_05",
      "hash64": "E4F2DCE37D112362",
      "text": "Et avec Menzi à tes côtés, ta rentrée ne peut\\nque bien se passer ! Foi de Maman ![VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0095_mama_09",
      "hash64": "E4F2E0E37D112A2E",
      "text": "J’espère que tu te plairas au campus de l’école.\\nJe ne serai plus là pour m’occuper de toi,\\r\\nalors pense à manger bien équilibré ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0095_mama_06",
      "hash64": "E4F2DBE37D1121AF",
      "text": "Tiens, prends ton casse-croûte et cet argent\\nde poche. Et attention : pas de gaspillage ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0095_mama_10",
      "hash64": "E4EF53E37D0E04C0",
      "text": "Oh, j’oubliais ! Prends aussi ceci ![VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0095_mama_11",
      "hash64": "E4EF54E37D0E0673",
      "text": "Utilise-les pour soigner ton petit partenaire,\\ns’il est blessé ![VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0095_mama_12",
      "hash64": "E4EF55E37D0E0826",
      "text": "M[VAR 0x1100(00FF,0707)]on filsa fille va prendre son envol loin de la maison\\npour la toute première fois ! Que je suis émue ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0707"
          ]
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0095_mama_13",
      "hash64": "E4EF56E37D0E09D9",
      "text": "Tu vas vivre des instants heureux, d’autres moins,\\nmais tous deviendront de précieuses expériences.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0095_mama_07",
      "hash64": "E4F2DAE37D111FFC",
      "text": "Et si tu as besoin d’une pause, n’hésite pas à\\nrentrer à la maison pour te reposer ![VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0095_mama_08",
      "hash64": "E4F2E1E37D112BE1",
      "text": "Sur ce, je vous laisse.\\nFaites bien attention sur la route ![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0095_rival_02",
      "hash64": "C21E4149095E5273",
      "text": "Elle est gentille, ta mère ! Je l’adore ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0095_rival_03",
      "hash64": "C21E4049095E50C0",
      "text": "Mais au fait ! Je devais te montrer comment\\ncapturer des Pokémon ![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0095_rival_04",
      "hash64": "C21E4749095E5CA5",
      "text": "Par ici ![VAR 0x0114(0004)]",
