    {
      "ordinal": 1,
      "label": "common_0095_mama_02",
      "hash64": "E4F2D7E37D111AE3",
      "text": "Alors comme ça, Menzi t’accompagne à l’école ?[VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
