    {
      "ordinal": 18,
      "label": "sub_035_mgirl_17",
      "hash64": "4A5CA861B3DBDCE1",
      "text": "Hésite pas à revenir me voir si la taille\\nde tes Pokémon t’intéresse !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sub_035_mgirl_18",
      "hash64": "4A5CA161B3DBD0FC",
      "text": "Tu savais que parmi les Pokémon de la même\\nespèce, on en trouve des plus ou moins grands ?\\c\\nRegarde mes Pachirisu d’amour !\\nLeur différence de taille saute aux yeux, non ?\\c\\nCrois-moi, il me suffirait d’un coup d’œil pour\\nte dire si tes Pokémon sont grands ou petits.",
      "flags": 0,
      "text_status": "DECODED",
