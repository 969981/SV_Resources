    {
      "ordinal": 24,
      "label": "s1_sub_009_woman_15",
      "hash64": "1F480D05EF317294",
      "text": "Oooh, mais c’est bien sûr !\\nTout est clair à présent.[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
