          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_009_man_02",
      "hash64": "BF03D6FA090C2CDA",
