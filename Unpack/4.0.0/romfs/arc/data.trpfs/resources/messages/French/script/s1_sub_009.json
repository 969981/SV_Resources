          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "s1_sub_009_woman_21",
      "hash64": "1F3DF905EF28FC13",
      "text": "Rien ne saurait exprimer à quel point je te suis\\nreconnaissante, mais...\\c\\nAccepte au moins ce modeste présent.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
