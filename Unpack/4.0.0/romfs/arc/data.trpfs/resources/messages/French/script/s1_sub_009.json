      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s1_sub_009_select_02",
      "hash64": "6AE5BC5DD07C531C",
      "text": "Non.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s1_sub_009_woman_08",
      "hash64": "1F448C05EF2E618A",
      "text": "Plaît-il ?! On boude les grands de ce monde,\\nmais on laisse les gens du peuple accéder à\\r\\ntoutes ces richesses potentielles ?![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_009_woman_09",
      "hash64": "1F448D05EF2E633D",
      "text": "Si ni les influenceurs ni les gens du peuple\\nne peuvent y descendre, qui donc le peut ?!\\c\\nTout cela n’a absolument aucun sens ![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
