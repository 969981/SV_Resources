          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_009_woman_16",
      "hash64": "1F481005EF3177AD",
      "text": "Influenceurs, cols bleus... Nous sommes tous\\nles mêmes.[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_sub_009_woman_17",
      "hash64": "1F480F05EF3175FA",
      "text": "Comment une chose aussi simple a-t-elle pu\\nm’échapper tout ce temps ?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_sub_009_woman_18",
      "hash64": "1F480205EF315FE3",
      "text": "À défaut d’y aller pour m’enrichir, je voudrais\\nplutôt me cacher de honte dans ce grand trou...\\r\\nSi seulement je pouvais y descendre.[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
