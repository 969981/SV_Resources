        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_009_man_05",
      "hash64": "BF03D1FA090C245B",
      "text": "Ouah ! Que tu es habile, Naire !\\c\\nQuand la situation le demande, tu rebondis tout\\nde suite, prête pour un nouveau challenge ![VAR 0x0114(0040)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
