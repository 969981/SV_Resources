          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_009_woman_05",
      "hash64": "1F448105EF2E4ED9",
      "text": "Tu leur as bien dit que c’était la dernière étape\\nde notre voyage, j’espère ?!\\c\\nNon mais, nous refuser quelque chose à nous,\\ninfluenceur et influenceuse de renom... !!![VAR 0x0114(0041)]",
