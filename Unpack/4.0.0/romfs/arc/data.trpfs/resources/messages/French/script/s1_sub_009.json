    {
      "ordinal": 15,
      "label": "s1_sub_009_woman_10",
      "hash64": "1F480A05EF316D7B",
      "text": "Bon, puisque c’est ainsi, nous n’avons plus\\nqu’à faire un combat.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
