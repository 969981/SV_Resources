    },
    {
      "ordinal": 3,
      "label": "coach_bb_sister_sp01_01",
      "hash64": "40971E3BE7B5C196",
      "text": "J’ai profité du retour de Kassis à l’institut pour\\nrevenir, moi aussi.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
