          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_bb_sister_sp01_02",
      "hash64": "40971D3BE7B5BFE3",
      "text": "Donc si tu me croises dans les couloirs, t’as\\nintérêt à venir me dire bonjour, et au trot ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
