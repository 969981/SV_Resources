          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb_sister_sp01_select_01",
      "hash64": "EC5CE56AB223E9B5",
      "text": "Tout ce que tu voudras !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_bb_sister_sp01_select_02",
      "hash64": "EC5CE26AB223E49C",
      "text": "Arf...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_bb_sister_sp01_03",
      "hash64": "40971C3BE7B5BE30",
      "text": "Hmmm, t’es bien aimable, aujourd’hui... C’est\\nlouche. T’as un truc à me demander, ou quoi ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_bb_sister_sp01_03b",
      "hash64": "76834BCAB9D26556",
      "text": "Hé hé, ça va ! Je te taquine ! T’inquiète ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb_sister_sp01_04",
      "hash64": "4097233BE7B5CA15",
      "text": "En tout cas, ça fait bizarre de revenir ici après\\navoir passé du temps à Septentria...\\r\\nIl y a tellement de monde et de bruit...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb_sister_sp01_05",
      "hash64": "4097223BE7B5C862",
      "text": "Ça change de Jaderaude !\\nIl s’y passe jamais rien... et c’est pas plus mal ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb_sister_sp02_00",
      "hash64": "6F6D1D53F5073B96",
      "text": "Dis, [VAR 0x0100(0000)]...\\nJe voudrais m’assurer d’un truc...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb_sister_sp02_01",
      "hash64": "6F6D1E53F5073D49",
      "text": "T’as pas pris de vidéos de moi quand j’étais\\nkibifiée et que je dansais, hein ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb_sister_sp02_select_01",
      "hash64": "FE6373F7F3B19B98",
      "text": "Bien sûr que non !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_bb_sister_sp02_select_02",
      "hash64": "FE6376F7F3B1A0B1",
      "text": "À vrai dire...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_bb_sister_sp02_02",
      "hash64": "6F6D1B53F5073830",
      "text": "Ouf ! S’il restait des preuves de cet « incident »,\\nma réputation s’en remettrait pas...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_bb_sister_sp02_02b",
      "hash64": "5D9DC1A95B44B356",
      "text": "QUOI ?! Tu m’effaces ça de ton Motismart !!!\\nTout de suite !!![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_bb_sister_sp02_03",
      "hash64": "6F6D1C53F50739E3",
      "text": "Je peux pas laisser circuler un dossier pareil\\nsur moi... Ma carrière de célébrité serait fichue\\r\\navant même d’avoir commencé ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb_sister_sp02_04",
      "hash64": "6F6D2153F5074262",
      "text": "D’ailleurs, il venait d’où, ce Pokémon, là...\\nPêchaminus ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb_sister_sp02_05",
      "hash64": "6F6D2253F5074415",
      "text": "Je sais pas toi, mais perso, je trouve qu’il avait\\ndes petits airs d’Adorami...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb_sister_sp02_select_03",
      "hash64": "FE6375F7F3B19EFE",
      "text": "Moi aussi !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "coach_bb_sister_sp02_select_04",
      "hash64": "FE6378F7F3B1A417",
      "text": "Ah bon ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_bb_sister_sp02_06",
      "hash64": "6F6D1F53F5073EFC",
      "text": "Je suis sûre qu’ils sont liés d’une manière ou\\nd’une autre ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_bb_sister_sp02_07",
      "hash64": "6F6D2053F50740AF",
      "text": "J’aimerais bien lui demander directement,\\nmais je sais pas parler aux Pokémon...\\c\\nDonc j’imagine qu’on saura jamais ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_bb_sister_sp03_00",
      "hash64": "6E31F34ECDF9D8E7",
      "text": "Ah, tu viens me dire bonjour ? Ça fait plaisir ![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb_sister_sp03_01",
      "hash64": "6E31F24ECDF9D734",
      "text": "Sinon... comment ça se passe, avec Kass ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb_sister_sp03_select_01",
      "hash64": "10079538DA4A0A53",
      "text": "Ça va super !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_bb_sister_sp03_select_02",
      "hash64": "10079638DA4A0C06",
      "text": "Ça peut aller...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_bb_sister_sp03_02",
      "hash64": "6E31F54ECDF9DC4D",
      "text": "Ah oui ? Tant mieux.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_bb_sister_sp03_02b",
      "hash64": "38C003E7FF9123DD",
      "text": "Ah oui ? Tu sais, en amitié aussi, il y a des hauts\\net des bas.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_bb_sister_sp03_03",
      "hash64": "6E31F44ECDF9DA9A",
      "text": "Il fait beaucoup d’efforts pour regagner la\\nconfiance de tout le monde à l’institut et au club.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_bb_sister_sp03_04",
      "hash64": "6E31EF4ECDF9D21B",
      "text": "Alors, je compte sur toi pour le soutenir...\\nOu au moins, pour rester son ami[VAR 0x1100(00FF,0100)]e.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_bb_sister_sp03_select_03",
      "hash64": "10079738DA4A0DB9",
      "text": "Bien sûr !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "coach_bb_sister_sp03_select_04",
      "hash64": "10079838DA4A0F6C",
      "text": "À tes ordres !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "coach_bb_sister_sp03_05",
      "hash64": "6E31EE4ECDF9D068",
      "text": "Je dis ça, mais au fond, je sais que vous êtes amis\\nmalgré les hauts et les bas.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_bb_sister_sp03_05b",
      "hash64": "38A7F9E7FF7C80FE",
      "text": "Hé hé ! Bon esprit ! De toute façon, il faut\\nm’écouter, parce que j’ai toujours raison.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_bb_sister_sp03_06",
      "hash64": "6E31F14ECDF9D581",
      "text": "Ah là là, regarde-moi... Je suis devenue une vraie\\nsœur poule, à le surprotéger comme ça ![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "coach_bb_sister_sp03_07",
      "hash64": "6E31F04ECDF9D3CE",
      "text": "À partir de maintenant, j’essaierai de lui laisser\\nplus d’espace et d’arrêter d’être sur son dos...\\r\\nMême si ça me coûte un peu ![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
