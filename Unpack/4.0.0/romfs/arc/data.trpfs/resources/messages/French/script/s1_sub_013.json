    {
      "ordinal": 0,
      "label": "s1_sub_013_picnic_01",
      "hash64": "686A77A477DFA3BC",
      "text": "Tiens donc, un[VAR 0x1100(00FF,0100)]e étudiant[VAR 0x1100(00FF,0100)]e venu[VAR 0x1100(00FF,0100)]e de Paldea !\\nJ’ai quelque chose à te demander.\\c\\nTu vois, j’aime fabriquer des sièges pendant\\nmon temps libre.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
