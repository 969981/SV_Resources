      "hash64": "FA7C7C782654504A",
      "text": "Tiens, [VAR 0x0100(0000)]. Comment vas-tu ?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
