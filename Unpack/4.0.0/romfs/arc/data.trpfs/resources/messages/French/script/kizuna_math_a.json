          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_math_a_02",
      "hash64": "FA7C7B7826544E97",
      "text": "Qu’est-ce qui t’amène ici ? Y a-t-il un point\\nde mon cours que tu n’as pas bien compris ?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_math_a_select_04",
      "hash64": "306B2435068E49E2",
      "text": "Oui, je n’ai pas tout compris...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_math_a_select_05",
      "hash64": "306B2535068E4B95",
      "text": "Non, tout était parfaitement clair !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_a_05",
      "hash64": "FA7C78782654497E",
      "text": "C’est normal, ne t’en fais pas. Dans ce cas,\\nessayons de réviser ensemble, d’accord ?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_a_06",
      "hash64": "FA7C7778265447CB",
      "text": "Hi hi, je suis heureuse de l’entendre ! Cependant,\\nquelques révisions ne peuvent pas faire de mal.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_a_07",
      "hash64": "FA7C767826544618",
      "text": "Commençons par un rappel : le type Roche\\nest puissant contre le type Vol.\\c\\nDonc si un Pokémon de type Vol est touché\\npar une capacité de type Roche, quelle est\\r\\nl’influence sur les dégâts infligés ?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 161,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 202,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_a_select_01",
      "hash64": "306B2135068E44C9",
      "text": "Ils restent identiques.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_a_select_02",
      "hash64": "306B1E35068E3FB0",
      "text": "Ils sont multipliés par deux.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_a_select_03",
      "hash64": "306B1F35068E4163",
      "text": "Ils sont multipliés par cent.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_a_08a",
      "hash64": "F5BF9F29212F92CC",
      "text": "Exactement, ils sont multipliés par deux.\\nBien vu ![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_a_08b",
      "hash64": "F5BFA229212F97E5",
      "text": "C’était bien essayé, mais la bonne réponse est :\\nils sont multipliés par deux.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_a_mob_01",
      "hash64": "74F36DAA300E3DF1",
      "text": "Madame Thaïm ! Madame Thaaaïm !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_a_09",
      "hash64": "FA7C7478265442B2",
      "text": "Oh, je reconnais cette voix pleine d’énergie.\\c\\nEn revanche, comme tu le vois, je suis un peu\\noccupée. Peux-tu attendre ton tour ?[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_math_a_mob_02",
      "hash64": "74F36AAA300E38D8",
      "text": "Dites, madame Thaïm, c’est vrai qu’avant,\\nvous étiez Championne d’Arène ?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_a_10",
      "hash64": "FA797778265211F4",
      "text": "C’est tout à fait vrai, oui. Tu sais, je suis\\nplutôt forte en combat ![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_math_a_mob_03",
      "hash64": "74F36BAA300E3A8B",
      "text": "Ouah, trop génial ! Mais pourquoi vous avez\\narrêté, alors ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_math_a_11",
      "hash64": "FA797878265213A7",
      "text": "Hum... Je suis désolée, mais je crois que c’est le\\ngenre de chose que je ne peux dire qu’aux\\r\\nélèves qui sont capables d’attendre leur tour.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_math_a_mob_04",
      "hash64": "74F370AA300E430A",
      "text": "D’accord, madame ! Je vais attendre\\nmon tour, c’est promis !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "kizuna_math_a_12",
      "hash64": "FA7979782652155A",
      "text": "Je te demande pardon pour cette interruption,\\n[VAR 0x0100(0000)].[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_math_a_13",
      "hash64": "FA797A782652170D",
      "text": "Mais surtout, n’hésite pas à revenir me voir,\\nsi tu as la moindre question.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_math_a_system_01",
      "hash64": "253BAD0DFF60085E",
      "text": "Vous êtes devenu[VAR 0x1100(00FF,0100)]e un peu plus proche\\nde madame Thaïm.",
      "flags": 0,
