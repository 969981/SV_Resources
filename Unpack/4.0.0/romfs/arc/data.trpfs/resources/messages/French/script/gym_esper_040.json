      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_esper_040_esper_11",
      "hash64": "A1A7046506F53506",
      "text": "Tu es vraiment exceptionnel[VAR 0x1100(00FF,0200)]le ![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
