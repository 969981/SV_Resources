    {
      "ordinal": 15,
      "label": "gym_esper_040_esper_07",
      "hash64": "A1A3866506F22915",
      "text": "Chez les Pokémon aussi, l’apparence est\\nimportante, vois-tu ?\\c\\nEux aussi ont le droit d’être coquets ![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 1,
