          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_b_01_math_09",
      "hash64": "57E6F715A01D7B33",
      "text": "Comme nous venons de le dire, les capacités\\nde type Eau sont puissantes contre le type Feu.\\c\\nSi on utilise une capacité de type Eau, comme\\nPistolet à O, sur un Pokémon de type Feu,\\r\\ncomment sont modifiés les dégâts ?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 182,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
