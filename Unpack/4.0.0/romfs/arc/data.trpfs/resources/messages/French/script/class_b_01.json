    {
      "ordinal": 2,
      "label": "class_b_01_popup_01",
      "hash64": "1C7DF4F0B24454F1",
      "text": "J’adore ça !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
