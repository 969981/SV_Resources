    {
      "ordinal": 17,
      "label": "class_b_01_math_answer_03",
      "hash64": "1723DA85F3F44AA2",
      "text": "C’est bien ça ! Bravo, [VAR 0x0100(0000)] ![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
