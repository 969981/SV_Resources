          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_b_01_select_01",
      "hash64": "27E4F980E00456F1",
      "text": "Ils sont divisés par deux.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_b_01_select_02",
      "hash64": "27E4F680E00451D8",
      "text": "Ils sont comme d’habitude.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_b_01_select_03",
      "hash64": "27E4F780E004538B",
      "text": "Ils sont doublés.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_b_01_math_answer_01",
      "hash64": "1723D885F3F4473C",
      "text": "Allons bon. C’est l’inverse, voyons.\\c\\nMais moi aussi, je serais probablement en\\ndifficulté si on m’interrogeait sur mes faiblesses.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
