      ]
    },
    {
      "ordinal": 18,
      "label": "class_b_01_math_10",
      "hash64": "57EA8415A020A0A1",
      "text": "Si vous utilisez une capacité dont le type est\\nle point faible de votre adversaire, le résultat\\r\\nsera super efficace et les dégâts seront doublés ![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
