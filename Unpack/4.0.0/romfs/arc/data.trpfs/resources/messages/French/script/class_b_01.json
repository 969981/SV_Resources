          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_b_01_math_04",
      "hash64": "57E70215A01D8DE4",
      "text": "Et c’est très bien comme ça, certains apprécient\\net d’autres moins.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_b_01_math_05",
      "hash64": "57E70315A01D8F97",
      "text": "Quoi qu’il en soit, ne vous en faites pas.\\c\\nJe vais faire tout ce que je peux pour rendre\\nmon cours aussi passionnant que possible.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_b_01_math_06",
      "hash64": "57E70415A01D914A",
      "text": "Mais d’ailleurs, connaissez-vous bien votre table\\ndes affinités de types ?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_b_01_math_07",
      "hash64": "57E70515A01D92FD",
      "text": "Vous savez que le type Plante est fort contre le\\ntype Eau, et l’Eau contre le Feu, n’est-ce pas ?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_b_01_math_08",
      "hash64": "57E6F615A01D7980",
      "text": "J’ai cru comprendre que tu étais doué[VAR 0x1100(00FF,0100)]e\\nen combat Pokémon, [VAR 0x0100(0000)].\\c\\nVoici donc une petite question pour toi.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
