            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_b_01_math_11",
      "hash64": "57EA8315A0209EEE",
      "text": "Par contre, si vous attaquez avec une capacité\\nd’un type face auquel votre adversaire est\\r\\nrésistant, cela ne sera pas très efficace\\r\\net les dégâts seront divisés par deux.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
