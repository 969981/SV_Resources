    },
    {
      "ordinal": 15,
      "label": "atlantis_talk_04_rival_08",
      "hash64": "2F942D21E23C96FF",
      "text": "Tu veux dire qu’on te traite comme une gamine ?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
