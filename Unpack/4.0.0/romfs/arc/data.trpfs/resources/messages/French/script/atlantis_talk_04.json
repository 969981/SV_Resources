          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "atlantis_talk_04_botan_03",
      "hash64": "ECC8A2A044460B5C",
      "text": "C’est dans le top 10 des répliques de gros\\nbourges, ça...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
