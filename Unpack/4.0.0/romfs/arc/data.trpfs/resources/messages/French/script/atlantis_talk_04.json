      "ordinal": 13,
      "label": "atlantis_talk_04_botan_04",
      "hash64": "ECC8A1A0444609A9",
      "text": "Euh...[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
