    },
    {
      "ordinal": 4,
      "label": "atlantis_talk_04_botan_02",
      "hash64": "ECC8A3A044460D0F",
      "text": "Tout le monde le sait, vu comme il est célèbre...\\nEt j’ai fait quelques recherches aussi, j’avoue...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "atlantis_talk_04_friend_02",
      "hash64": "0B6F533EBE970151",
      "text": "Mais alors, t’es une grosse bourge ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
