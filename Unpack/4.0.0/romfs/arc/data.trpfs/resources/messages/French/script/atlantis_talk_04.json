          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "atlantis_talk_04_friend_03",
      "hash64": "0B6F523EBE96FF9E",
      "text": "Attends... T’appelles tes parents « Père »\\net « Mère » ?[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
