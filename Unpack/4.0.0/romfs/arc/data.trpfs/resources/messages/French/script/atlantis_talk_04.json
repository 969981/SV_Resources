      ]
    },
    {
      "ordinal": 8,
      "label": "atlantis_talk_04_rival_05",
      "hash64": "2F943021E23C9C18",
      "text": "Père et Mère se sont pas beaucoup investis dans\\nmon éducation...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
