      "ordinal": 14,
      "label": "atlantis_talk_04_botan_05",
      "hash64": "ECC8A0A0444607F6",
      "text": "Non... Ils sont toujours sur mon dos...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
