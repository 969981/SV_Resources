    },
    {
      "ordinal": 1,
      "label": "atlantis_talk_04_rival_01",
      "hash64": "2F943421E23CA2E4",
      "text": "Hmmm... Ils ont rien de spécial.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
