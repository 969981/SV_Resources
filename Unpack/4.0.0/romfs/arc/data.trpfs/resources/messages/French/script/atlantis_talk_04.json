      ]
    },
    {
      "ordinal": 2,
      "label": "atlantis_talk_04_botan_01",
      "hash64": "ECC8A4A044460EC2",
      "text": "Tu plaisantes ? Ton père est à la tête de\\nla société qui fabrique les Motismart...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "atlantis_talk_04_rival_02",
      "hash64": "2F943721E23CA7FD",
      "text": "C-comment tu sais ça ?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
