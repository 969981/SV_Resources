      "label": "coach_teacher_dragon_sp01_02",
      "hash64": "7FA3DE75249E927E",
      "text": "Je... je suis si ému... bouleversé, à vrai dire ! Je...[VAR 0x0114(0012)]",
      "flags": 0,
