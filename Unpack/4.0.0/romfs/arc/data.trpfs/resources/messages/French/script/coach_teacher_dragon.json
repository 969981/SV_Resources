    {
      "ordinal": 4,
      "label": "coach_teacher_dragon_sp01_01",
      "hash64": "7FA3DD75249E90CB",
      "text": "J’ai l’impression qu’hier encore, vous faisiez\\nvos premiers pas à Paldea... Et voilà que l’on\\r\\nvous confie déjà une mission si importante...[VAR 0x0114(0012)]",
      "flags": 0,
