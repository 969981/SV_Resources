            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side02_0030_camera_04",
      "hash64": "9180AA077DC9A18D",
      "text": "Oh, c’est toi ? Alors ces recherches ? T’as trouv...\\nOh ! Ce Pokémon...[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side02_0030_camera_a1_01",
      "hash64": "69708D0BD9114DBF",
      "text": "C’est Feu-Perçant en chair et en os ! T’as vu\\nla forme de sa tête ? Elle est impressionnante ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side02_0030_camera_a1_02",
      "hash64": "69708E0BD9114F72",
      "text": "Il paraît que ce Pokémon peut faire surgir\\nde la lave des entrailles de la terre\\r\\nd’un simple rugissement ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side02_0030_camera_b1_01",
      "hash64": "BA432C630EB91432",
      "text": "C’est Roc-de-Fer en personne ! Il est balèze,\\ndis donc ! Il a l’air plus solide que... le fer ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side02_0030_camera_b1_02",
      "hash64": "BA432B630EB9127F",
      "text": "Il paraît que quand il accumule de l’énergie dans\\nses cornes, il peut abattre n’importe quoi ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side02_0030_camera_a2_01",
      "hash64": "950B15123A1F67A8",
      "text": "Ça alors, c’est Ire-Foudre ! En chair et en os !\\nVise un peu la longueur de son cou !\\c\\nÇa doit être compliqué de le photographier\\nen entier ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side02_0030_camera_a2_02",
      "hash64": "950B18123A1F6CC1",
      "text": "Il paraît qu’il peut couvrir le ciel de nuages\\net déclencher un orage d’un simple mouvement\\r\\nde cou ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side02_0030_camera_b2_01",
      "hash64": "67C8EC7EC9AD97C5",
      "text": "Incroyable ! C’est Chef-de-Fer en personne !\\nRegarde comme il brille ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side02_0030_camera_b2_02",
      "hash64": "67C8E97EC9AD92AC",
      "text": "Il paraît qu’il peut trancher tout ce qui l’entoure\\nen tirant des rayons d’énergie de ses cornes ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_side02_0030_camera_05",
      "hash64": "9180A9077DC99FDA",
      "text": "Ha ha ! Heureusement que c’est qu’une rumeur !\\nBref, immortalisons cet instant...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side02_0030_camera_06",
      "hash64": "9180A8077DC99E27",
      "text": "Il te reste encore un Pokémon à trouver.\\nJe compte sur toi, [VAR 0x0100(0000)] ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
