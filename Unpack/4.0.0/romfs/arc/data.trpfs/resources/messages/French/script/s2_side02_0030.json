    },
    {
      "ordinal": 5,
      "label": "s2_side02_0030_camera_03s",
      "hash64": "072AE0BABD89A321",
      "text": "T’en as pas besoin ?\\nT’as une bonne mémoire, à ce que je vois ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
