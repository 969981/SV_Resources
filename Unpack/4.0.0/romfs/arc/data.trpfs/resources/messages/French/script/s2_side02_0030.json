          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side02_0030_camera_07",
      "hash64": "9180A7077DC99C74",
      "text": "T’as trouvé les deux Pokémon !\\nT’es vraiment l[VAR 0x1100(00FF,0B0A)]e meilleura meilleure, [VAR 0x0100(0000)] ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0B0A"
          ]
        },
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side02_0030_camera_08",
      "hash64": "91809E077DC98D29",
      "text": "Tu m’as retiré une belle épine du pied.\\c\\nJ’étais tellement intriguée par ces photos que\\nj’arrivais plus à me concentrer sur mon boulot ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side02_0030_camera_09",
      "hash64": "91809D077DC98B76",
      "text": "J’avais rien promis à l’origine, mais t’as bien\\nmérité une jolie récompense !\\r\\nCette fois encore, elle devrait te plaire ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_side02_0030_camera_10",
      "hash64": "917D20077DC68138",
      "text": "Le monde nous réserve encore tant de surprises ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_side02_0030_camera_11",
      "hash64": "917D21077DC682EB",
      "text": "Faut qu’on l’explore tant qu’on est jeunes\\net plein[VAR 0x1100(00FF,0100)]es d’énergie ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_side02_0030_camera_12",
      "hash64": "917D22077DC6849E",
      "text": "Poursuis ton aventure et continue à rencontrer\\nde nouveaux Pokémon, ça me fera plaisir ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_side02_0030_camera_13",
      "hash64": "917D23077DC68651",
      "text": "Sur ce, j’ai du pain sur la planche.\\nAu boulot ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_side02_0030_camera_npc_01",
      "hash64": "A487FFC5BD0B7C06",
      "text": "Maintenant, les appareils photo ont des tonnes\\nde fonctionnalités.\\c\\nTu crois que je devrais apprendre à utiliser\\nles filtres, moi aussi ?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_side02_0030_camera_npc_02",
      "hash64": "A487FEC5BD0B7A53",
      "text": "Hésite pas à dire bonjour à mon Caninos. Il se\\nsouvient de ton odeur et il a l’air de t’apprécier ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_side02_0030_camera_npc_03",
      "hash64": "A487FDC5BD0B78A0",
      "text": "Il est incroyable, ce Terra-Dôme ! On a pas\\nl’impression d’être au milieu de l’océan.\\c\\nEt puis, c’est fou de passer des montagnes\\nenneigées à la plage en quelques secondes !\\c\\nC’est des panoramas qui valent le coup\\nd’être immortalisés ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 175,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 239,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_side02_0030_camera_npc_04",
      "hash64": "A48804C5BD0B8485",
      "text": "Parfois, je regarde avec nostalgie les photos\\nde Lune Vermeille qu’on a prises ensemble.\\c\\nElles sont floues, mais elles me rappellent\\ncette nuit-là. Je les garde toujours sur moi...\\r\\ncomme le plus précieux des trésors ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
