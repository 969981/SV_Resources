    },
    {
      "ordinal": 6,
      "label": "kizuna_ecology_a_06",
      "hash64": "33860970BD20F125",
      "text": "Quand une personne attrape un Pokémon,\\nje reçois les données correspondantes, ce qui\\r\\nme permet d’approfondir mes recherches.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
