          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_ecology_a_07",
      "hash64": "33860870BD20EF72",
      "text": "Donc ça m’aiderait si tu remplissais ton Pokédex\\nen attrapant de nouveaux Pokémon.[VAR 0x0114(002A)]",
