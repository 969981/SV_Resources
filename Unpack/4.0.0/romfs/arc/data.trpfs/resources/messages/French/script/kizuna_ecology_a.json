        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_ecology_a_04",
      "hash64": "33860770BD20EDBF",
      "text": "Au fait ! Est-ce que tu te sers du Pokédex ?[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
