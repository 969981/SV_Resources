      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_ecology_a_05",
      "hash64": "33860670BD20EC0C",
      "text": "Si je demande, c’est parce que... c’est moi qui\\nl’ai mis au point... Hé hé ![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
