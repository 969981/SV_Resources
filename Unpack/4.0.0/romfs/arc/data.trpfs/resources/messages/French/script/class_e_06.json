          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_e_06_battle_04",
      "hash64": "A7EAFCE2D5FF371A",
      "text": "Cela permet aussi de faire le plein d’échantillons\\npour confectionner des CT.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
