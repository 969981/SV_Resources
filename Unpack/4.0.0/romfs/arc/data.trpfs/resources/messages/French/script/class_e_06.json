          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_e_06_battle_05",
      "hash64": "A7EAFDE2D5FF38CD",
      "text": "D’ailleurs, est-ce que vous savez utiliser\\nla Machine à CT ?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
