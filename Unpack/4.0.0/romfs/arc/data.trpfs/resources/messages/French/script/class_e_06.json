        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_e_06_battle_02",
      "hash64": "A7EAF6E2D5FF2CE8",
      "text": "Est-ce que vous avez eu l’occasion de déclencher\\nun combat auto depuis la dernière fois ?[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_e_06_battle_03",
      "hash64": "A7EAF7E2D5FF2E9B",
      "text": "Je vous rappelle que c’est un excellent moyen\\nd’entraîner ses Pokémon ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
