          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_gym_mushi_sp01_02b",
      "hash64": "4CD776C7F07A892C",
      "text": "Hmm, but you don’t seem very surprised to\\nsee me here...\\c\\nOh, wait, don’t tell me—you’re the one who\\ncalled me here, aren’t you?[VAR 0x0114(0016)]",
