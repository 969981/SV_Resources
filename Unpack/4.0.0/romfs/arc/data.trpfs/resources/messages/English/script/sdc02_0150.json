          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0150_brother_05",
      "hash64": "989464B8171F145D",
      "text": "But you seem as strong as ever, thankfully.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0150_brother_06",
      "hash64": "989461B8171F0F44",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)]...go all the way.\\nDon’t\\r\\ngo\\r\\nlosing.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
