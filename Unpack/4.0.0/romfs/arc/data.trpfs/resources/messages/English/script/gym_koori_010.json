      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "gym_koori_010_receptionist_02",
      "hash64": "C2D8CF31076D1BA6",
      "text": "Let me register you as a challenger. Your name is\\n[VAR 0x0100(0000)], yes?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
