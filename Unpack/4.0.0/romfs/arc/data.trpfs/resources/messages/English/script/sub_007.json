  "entries": [
    {
      "ordinal": 0,
      "label": "sub_007_model_01",
      "hash64": "B8594BA315835615",
      "text": "You want to know if your Pokémon have really\\nbeen giving it their best effort?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_007_model_02",
      "hash64": "B85948A3158350FC",
      "text": "Which of your Pokémon’s efforts do you want\\nto check?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_007_model_03",
      "hash64": "B85949A3158352AF",
      "text": "OK! Then I’ll have a look at how much effort\\n[VAR 0x0102(0001)]’s been putting in!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_007_model_04a",
      "hash64": "C300FE1D8E1D7AB5",
      "text": "Hmmm... Uh huh... Oh my...\\nOoh... Wow, that much?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_007_model_04b",
      "hash64": "C300FB1D8E1D759C",
      "text": "Hmmm... I see...\\nAhhh... Oh, yes, OK...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_007_model_05a",
      "hash64": "C303E21D8E1F80F8",
      "text": "Wow, [VAR 0x0102(0001)]...\\c\\nYou’ve really worked hard! Here, I’ll give you\\nsomething to show you’ve put in a lot of effort!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_007_model_05b",
      "hash64": "C303E51D8E1F8611",
      "text": "It looks like it can still give a bit more!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_007_model_06",
      "hash64": "B85944A315834A30",
      "text": "[VAR 0x0102(0001)] got an Effort Ribbon!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_007_model_07",
      "hash64": "B85945A315834BE3",
      "text": "Your Pokémon’s clearly earned that Effort\\nRibbon. It looks great!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_007_model_08",
      "hash64": "B85952A3158361FA",
      "text": "Oh, that’s too bad...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_007_model_09",
      "hash64": "B85953A3158363AD",
      "text": "Pokémon work real hard when they battle.\\c\\nThe more battles they take part in, the more\\ntheir efforts stack up!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
