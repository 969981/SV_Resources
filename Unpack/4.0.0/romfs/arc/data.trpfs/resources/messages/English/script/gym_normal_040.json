      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_normal_040_receptionist_00",
      "hash64": "0EB8253E4E40262A",
      "text": "[VAR 0xBD06(0000)]Ah, [VAR 0x0100(0000)]! Welcome to the\\nTreasure\\r\\nEatery—proud\\r\\nto\\r\\nbe\\r\\nsupporting\\r\\nthe\\r\\nMedali Gym!",
