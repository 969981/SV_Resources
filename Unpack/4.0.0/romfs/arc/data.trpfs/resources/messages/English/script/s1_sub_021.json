          "args_hex": [
            "0037"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_021_gmother_04",
      "hash64": "5B28DDDD088D72C0",
      "text": "Kids... They grow up so fast. Hee hee![VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
