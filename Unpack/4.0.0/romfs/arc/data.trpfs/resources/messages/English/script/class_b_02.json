      "hash64": "372A5B2F0C71F3CA",
      "text": "Hello, everyone. Let’s have a fun class today.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
