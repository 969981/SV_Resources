    {
      "ordinal": 0,
      "label": "sdc01_0480_sister_01",
      "hash64": "17B1F5D2AF61C424",
      "text": "There you are! You took your time![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
