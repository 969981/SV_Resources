  "entries": [
    {
      "ordinal": 0,
      "label": "s2_side01_0080_rival_01",
      "hash64": "D973B03B423F2135",
      "text": "I got some soda![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
