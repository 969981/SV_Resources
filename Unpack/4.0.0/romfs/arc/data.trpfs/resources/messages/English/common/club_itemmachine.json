  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "club_itemmachine_msg_first_00",
      "hash64": "6C76D0975AF7CD8E",
      "text": "Thanks for opting in to set up one of our new\\nItem Printers!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "club_itemmachine_msg_first_01",
      "hash64": "6C76D1975AF7CF41",
      "text": "I’m a member of the Science Club—we\\ndeveloped this device.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "club_itemmachine_msg_first_02",
      "hash64": "6C76CE975AF7CA28",
      "text": "I’ll be right here to help you use it—if it’s not too\\nmuch trouble to have me in your clubroom.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "club_itemmachine_msg_first_03",
      "hash64": "6C76CF975AF7CBDB",
      "text": "So! Straight to it! What is the Item Printer?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "club_itemmachine_msg_first_04",
      "hash64": "6C76D4975AF7D45A",
      "text": "If you put materials dropped by Pokémon into\\nthis printer—along with some BP—you’ll be able\\r\\nto get items in exchange!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "club_itemmachine_msg_first_05",
      "hash64": "6C76D5975AF7D60D",
      "text": "The exact inner workings are our little secret.\\nWe’re in the midst of applying for a patent, see...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "club_itemmachine_msg_first_06",
      "hash64": "6C76D2975AF7D0F4",
      "text": "But all you need to know is that it takes materials\\nand lets you print items—and it’s fantastic!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "club_itemmachine_msg_first_07",
      "hash64": "6C76D3975AF7D2A7",
      "text": "It’s really exciting to see what might come out!\\nAnd it’s so simple to use! With that in mind—",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "club_itemmachine_msg_start_00",
      "hash64": "47D2451C8CF88184",
      "text": "Would you like to print some items with the\\nItem Printer?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "club_itemmachine_con_00_00",
      "hash64": "0863983DD5491E9F",
      "text": "Yes",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "club_itemmachine_con_00_01",
      "hash64": "0863973DD5491CEC",
      "text": "No",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "club_itemmachine_con_00_02",
      "hash64": "08639A3DD5492205",
      "text": "I want to print something!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "club_itemmachine_con_00_03",
      "hash64": "0863993DD5492052",
      "text": "I want to make it better",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "club_itemmachine_con_00_04",
      "hash64": "0863943DD54917D3",
      "text": "I’m good right now",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
