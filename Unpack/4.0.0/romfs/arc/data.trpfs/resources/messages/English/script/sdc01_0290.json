      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0290_sister_14",
      "hash64": "7CAA786767143921",
      "text": "The Crystal Pool’s at the top of Oni Mountain.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0290_sister_15",
      "hash64": "7CAA77676714376E",
      "text": "I’m usually not too keen on outsiders heading\\nup the mountain, but I think we can make an\\r\\nexception for you![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0290_sister_16",
      "hash64": "7CAA7667671435BB",
      "text": "What say you and I go for a hike to find\\nourselves a Crystal Cluster?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0290_gfather_06",
      "hash64": "CCF1158E029B9B79",
      "text": "The Pokémon around the Crystal Pool are strong.\\nYou be careful out there.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0290_student1_01",
      "hash64": "50F732182D96FB45",
      "text": "You already found all three signs?! Me and\\nCarmine only just made it to one!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "sdc01_0290_student2_01",
      "hash64": "A37171FC72A277B2",
      "text": "Is Kieran upset about something? I said hi, but I\\ndon’t think he even noticed me...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "sdc01_0290_student3_01",
      "hash64": "7886FE07BBAF4367",
      "text": "I wish I could spend all my time at the festival!\\nBut I guess I need to work on the assignment...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
