    {
      "ordinal": 3,
      "label": "sub_046_child_f_04",
      "hash64": "AF56260A305FD8B5",
      "text": "Whoa, you’re the best friends ever! I can tell just\\nbeing together gives you warm fuzzies!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_046_child_f_05",
      "hash64": "AF56250A305FD702",
      "text": "Wow, you’re pretty great friends! You sure mean\\na lot to each other.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_046_child_f_06",
      "hash64": "AF56240A305FD54F",
      "text": "You’re good friends, all right! You definitely\\nenjoy each other’s company!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_046_child_f_07",
      "hash64": "AF56230A305FD39C",
      "text": "You’re getting along well...but I’m sure you could\\nget way friendlier!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_046_child_f_08",
      "hash64": "AF562A0A305FDF81",
      "text": "You’re starting to get friendly. I bet you’ll get\\nalong better soon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_046_child_f_09",
      "hash64": "AF56290A305FDDCE",
      "text": "You two seem kinda neutral—like you don’t mind\\neach other. I hope you get closer!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_046_child_f_10",
      "hash64": "AF529C0A305CB860",
      "text": "Are you two just starting to get to know each\\nother? I’m sensing some awkwardness here...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_046_child_f_11",
      "hash64": "AF529D0A305CBA13",
      "text": "Oh my gosh! What happened between you two?!\\nThere’s not even a smidge of friendship here!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_046_child_f_12",
      "hash64": "AF529E0A305CBBC6",
      "text": "I’ve got something for you to commemorate such\\na nice friendship!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
