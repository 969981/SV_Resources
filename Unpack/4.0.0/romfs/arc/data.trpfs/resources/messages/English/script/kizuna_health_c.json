      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_health_c_02",
      "hash64": "D7C06574793B9079",
      "text": "Sorry, were you looking for me? I’ve been away\\nfrom the nurse’s office lately.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_health_c_03",
      "hash64": "D7C06474793B8EC6",
      "text": "Did you need something from me?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_health_c_04a",
      "hash64": "D78388EA003C0BDA",
      "text": "Are your Pokémon hurt? Just a sec...[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_health_c_04b",
      "hash64": "D78387EA003C0A27",
      "text": "Whaaat? But then why’d you come over to talk?\\nOh well, I’ll heal up your Pokémon anyway.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_health_c_05",
      "hash64": "D7C06674793B922C",
      "text": "Here ya go. A little first aid.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_health_c_06",
      "hash64": "D7C06974793B9745",
      "text": "You must really be having an adventure out there,\\njudging from those scrapes and cuts![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_health_c_07",
      "hash64": "D7C06874793B9592",
      "text": "Huh? Oh yeah, I guess it is pretty unusual for me\\nto be out of the nurse’s office like this.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_health_c_08",
      "hash64": "D7C06B74793B9AAB",
      "text": "Hehe. Well...I’m actually doing a bit of studying.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_health_c_09",
      "hash64": "D7C06A74793B98F8",
      "text": "Thought I’d try my best at the health teacher\\ncertification exam one more time.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
