          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0020_cassiopeia_21",
      "hash64": "063183805A933DA1",
      "text": "I went ahead and issued challenges to each base\\nunder your name, [VAR 0x0100(0000)].\\c\\nThey’re basically declarations of war.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 70,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "team_0020_cassiopeia_22",
      "hash64": "063180805A933888",
      "text": "Now all of Team Star knows that we’re looking\\nfor a fight.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "team_0020_nelke_16",
      "hash64": "082787F2E55761C3",
      "text": "So let’s say we defeat all the bosses and they\\nstep down from their roles... What happens next?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "team_0020_cassiopeia_23",
      "hash64": "063181805A933A3B",
      "text": "[EMPTY 66]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "team_0020_cassiopeia_24",
      "hash64": "063186805A9342BA",
      "text": "The rest of the team crumbles with no one left to\\nlead them. That’s what happens.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "team_0020_nelke_17",
      "hash64": "082786F2E5576010",
      "text": "[EMPTY 66]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "team_0020_cassiopeia_25",
      "hash64": "063187805A93446D",
      "text": "It’s a solid plan, but not without wrinkles.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "team_0020_cassiopeia_26",
      "hash64": "063184805A933F54",
      "text": "Each base has a bunch of Pokémon inside to\\nfend off intruders, and the bases themselves are\\r\\na considerable size.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "team_0020_cassiopeia_27",
      "hash64": "063185805A934107",
      "text": "Your garden-variety Trainer would be overrun\\nlong before they’d get anywhere near the boss.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "team_0020_cassiopeia_28",
      "hash64": "06317A805A932E56",
      "text": "That’s why your skills are essential to this\\noperation, [VAR 0x0100(0000)].[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "team_0020_cassiopeia_29",
      "hash64": "06317B805A933009",
      "text": "[EMPTY 66]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "team_0020_cassiopeia_30",
      "hash64": "063508805A965577",
      "text": "[EMPTY 66]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "team_0020_cassiopeia_31",
      "hash64": "063507805A9653C4",
      "text": "Defeat the Pokémon inside the base, and drag\\nthe boss out from where they’re hiding.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "team_0020_cassiopeia_32",
      "hash64": "06350A805A9658DD",
      "text": "First things first, though—you’ll need to deal with\\nany grunts that might be guarding the front gates.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "team_0020_nelke_18",
      "hash64": "082795F2E557798D",
      "text": "And what will you be doing in the meantime?[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "team_0020_cassiopeia_33",
      "hash64": "063509805A96572A",
      "text": "Like I said before, I have a history with Team Star.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "team_0020_cassiopeia_34",
      "hash64": "063504805A964EAB",
      "text": "That means I can’t operate out in the open.\\nI’ll back you up from afar.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "team_0020_nelke_19",
      "hash64": "082794F2E55777DA",
      "text": "All right. And what will my role be?[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "team_0020_cassiopeia_35",
      "hash64": "063503805A964CF8",
      "text": "Sorry, but I don’t trust you completely just yet...\\c\\nFor now, I’d like you to monitor the bases and\\nact as [VAR 0x0100(0000)]’s support.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "team_0020_nelke_20",
      "hash64": "082A93F2E559ABFE",
      "text": "You’re a cautious one, all right... I respect that.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "team_0020_cassiopeia_36",
      "hash64": "063506805A965211",
      "text": "I’ll be in touch again when the plan advances to\\nthe next stage. Good hunting out there.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "team_0020_nelke_21",
      "hash64": "082A94F2E559ADB1",
      "text": "Welp. Go get ’em, [VAR 0x0100(0000)]![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "team_0020_select_05",
      "hash64": "BD6A110E869E6F42",
      "text": "Director Clavell...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 63,
      "label": "team_0020_select_06",
      "hash64": "BD6A100E869E6D8F",
      "text": "You look familiar...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 64,
      "label": "team_0020_nelke_22",
      "hash64": "082A91F2E559A898",
      "text": "I have no idea what you mean. But if anyone asks\\nyou about me, remember this...[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "team_0020_nelke_23",
      "hash64": "082A92F2E559AA4B",
      "text": "I’m Clive, a normal academy student just like you.\\nNothing more, nothing less.[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    }
  ]
