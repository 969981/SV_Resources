  "entries": [
    {
      "ordinal": 0,
      "label": "gym_kusa_010_receptionist_01",
      "hash64": "C20C959C9FC7CFAF",
      "text": "Welcome to the Artazon Gym!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "gym_kusa_010_receptionist_02",
      "hash64": "C20C969C9FC7D162",
      "text": "Let me register you as a challenger. Your name is\\n[VAR 0x0100(0000)], yes?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_kusa_010_receptionist_03",
      "hash64": "C20C979C9FC7D315",
      "text": "Great! Now, in order to face Gym Leader\\nBrassius, you’ll first need to pass the Gym Test.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_kusa_010_receptionist_04",
      "hash64": "C20C909C9FC7C730",
      "text": "Here at the Artazon Gym, that means completing\\na game of [VAR 0xFF00(0006)]Sunflora Hide-and-Seek[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_kusa_010_receptionist_history",
      "hash64": "A60C21835437EBCC",
      "text": "As you may know, Artazon is a city of artists.\\c\\nThe artwork made by the people here is largely\\ninspired by nature and the sun that nurtures it.\\c\\nSince Sunflora embody these concepts, we try to\\ngather them and take good care of them!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_kusa_010_receptionist_05",
      "hash64": "C20C919C9FC7C8E3",
      "text": "Your job today is to find the Sunflora located\\nthroughout Artazon. Remember—these Pokémon\\r\\nlook like sun-shaped flowers!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_kusa_010_receptionist_06",
      "hash64": "C20C929C9FC7CA96",
      "text": "Gather up [VAR 0x0201(0001)] of them and bring them to the\\nSunflora Lawn, and you pass the test.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_kusa_010_receptionist_map",
      "hash64": "830B93225E20E9E2",
      "text": "I’ll register the Sunflora Lawn’s location in your\\nmap app to get you started.\\c\\nWhen you leave the Gym, turn right and you’ll\\nsee two large Sunflora statues—head for those!\\c\\nOnce you’re at the lawn’s entrance, the staffer\\nthere will tell you more about the Gym Test.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 174,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_kusa_010_receptionist_07",
      "hash64": "C20C939C9FC7CC49",
      "text": "Now get out there and have fun!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
