  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_018_woman_01",
      "hash64": "2E13479A8E038F9F",
      "text": "We’re pretty much the most lovey-dovey couple\\never, don’tcha think?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s1_sub_018_man_01",
      "hash64": "A4BEB69B60D0EE99",
      "text": "You bet! There’s probably not a pair on the\\nplanet as perfect together as you and me.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_018_woman_02",
      "hash64": "2E13489A8E039152",
      "text": "Right?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_018_woman_03",
      "hash64": "2E13499A8E039305",
      "text": "Hey, you!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_018_woman_04",
      "hash64": "2E13429A8E038720",
      "text": "We’re wondering if there are any Pokémon\\nthat are lovey-dovey like the two of us.\\r\\nIf you manage to find any, bring ’em here!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_018_man_02",
      "hash64": "A4BEB39B60D0E980",
      "text": "Oh, I’m sure you’ll find one—when Lechonk fly!\\nAhaha!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s1_sub_018_woman_05",
      "hash64": "2E13439A8E0388D3",
      "text": "Did you find some lovey-dovey Pokémon that\\nare always together?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_018_man_03",
      "hash64": "A4BEB49B60D0EB33",
      "text": "See? There’s no way a Pokémon could out-lovey\\nOR out-dovey us! Ahaha!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s1_sub_018_man_04",
      "hash64": "A4BEB99B60D0F3B2",
      "text": "This Pokémon...\\c\\nNope—it’s not even dovey, let alone lovey!\\nAhaha!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_018_man_05",
      "hash64": "A4BEBA9B60D0F565",
      "text": "Wh-what’s this?! A Tandemaus?!\\c\\nThey’re lovey-dovey, they come in pairs, and\\nthey’re always together?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_018_man_06",
      "hash64": "A4BEB79B60D0F04C",
      "text": "Wh-what’s this? A Maushold?!\\c\\nSo lovey-dovey that they ended up with a\\nprecious little bundle of joy?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_018_man_07",
      "hash64": "A4BEB89B60D0F1FF",
      "text": "Wh-what’s this? A Maushold?!\\c\\nSo lovey-dovey that they have two li’l ones?!\\nA happy li’l family?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_018_woman_06",
      "hash64": "2E13449A8E038A86",
      "text": "So there ARE Pokémon out there that are head\\nover heels for each other like we are!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s1_sub_018_woman_07",
      "hash64": "2E13459A8E038C39",
      "text": "Thank you for showing us that Pokémon! How\\nabout we teach you a special pose in return?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s1_sub_018_system_01",
      "hash64": "715C9973D3928E94",
      "text": "You learned the [VAR 0xFF00(0008)]Heart (Right) emote[VAR 0xFF00(0000)] and the\\n[VAR 0xFF00(0008)]Heart (Left) emote [VAR 0xFF00(0000)]from the lovey-dovey couple!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
