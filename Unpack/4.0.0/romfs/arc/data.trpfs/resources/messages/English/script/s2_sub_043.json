  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_043_student_f_01",
      "hash64": "4B26BF5C7600182C",
      "text": "Over and under, over and under...\\nGalarica Twigs go all around...\\c\\nAnd a nice accessory is what we’ve wound!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_sub_043_student_f_02",
      "hash64": "4B26C25C76001D45",
      "text": "I can weave you a Galarica Cuff or a Galarica\\nWreath if you bring me some Galarica Twigs!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_043_select_01",
      "hash64": "DF5476E50DC8F73E",
      "text": "A Galarica Cuff, please!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_043_select_02",
      "hash64": "DF5475E50DC8F58B",
      "text": "A Galarica Wreath, please!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_043_select_03",
      "hash64": "DF5474E50DC8F3D8",
      "text": "Maybe another time",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_043_student_f_03",
      "hash64": "4B26C15C76001B92",
      "text": "Oh, no Galarica accessories for you, huh? Well,\\ncome back whenever you feel like it!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_043_student_f_04",
      "hash64": "4B26BC5C76001313",
      "text": "I’ll need eight Galarica Twigs to make you a\\nGalarica Cuff. Is that OK?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_043_student_f_05",
      "hash64": "4B26BB5C76001160",
      "text": "I’ll need fifteen Galarica Twigs to make you a\\nGalarica Wreath. Is that OK?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_043_student_f_06",
      "hash64": "4B26BE5C76001679",
      "text": "You don’t have enough Galarica Twigs!\\c\\nTry wandering around the Coastal Biome—\\nI’m sure you’ll pick up a few!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_043_student_f_07",
      "hash64": "4B26BD5C760014C6",
      "text": "You got it! I’ll get it woven in no time!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_043_student_f_08",
      "hash64": "4B26C85C76002777",
      "text": "Over, under, around we go...\\nOver, under, watch it grow...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_043_student_f_09",
      "hash64": "4B26C75C760025C4",
      "text": "Here you go! Freshly woven!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_043_student_f_10",
      "hash64": "4B233A5C75FD0056",
      "text": "Try giving that to a Galarian Slowpoke.\\nYou’ll see why!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
