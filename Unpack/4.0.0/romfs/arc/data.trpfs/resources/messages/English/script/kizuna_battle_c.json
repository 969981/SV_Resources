    {
      "ordinal": 1,
      "label": "kizuna_battle_c_01",
      "hash64": "FC40EBA601CBCDE8",
      "text": "C’mon, Miriam! Just try it![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
