      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "team_0030_cassiopeia_09",
      "hash64": "5509445D4D7DF8B2",
      "text": "I took the liberty of adding some new entries to\\nthe range of TMs you can make at TM Machines.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
