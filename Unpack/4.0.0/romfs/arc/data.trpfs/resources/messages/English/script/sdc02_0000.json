      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0000_select_01",
      "hash64": "D46CCE93A8067D63",
      "text": "Hi, Director Clavell!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc02_0000_select_02",
      "hash64": "D46CCF93A8067F16",
      "text": "Yep, that’s me!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_0000_headteacher_02",
      "hash64": "93CFB4D06897BF88",
      "text": "My, my. It certainly does this old heart good to\\nbe greeted with such a lively response![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0000_headteacher_03",
      "hash64": "93CFB5D06897C13B",
      "text": "Now, if I could take but a moment of your time,\\nthere is something we must discuss.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0000_headteacher_04",
      "hash64": "93CFBAD06897C9BA",
      "text": "[VAR 0xBD06(0000)]M[VAR 0x1100(00FF,0305)]asteriss [VAR 0x0100(0000)]...you’re about\\nto\\r\\nbe\\r\\npresented\\r\\nwith\\r\\nan\\r\\nexceptional\\r\\nopportunity.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
