      ]
    },
    {
      "ordinal": 31,
      "label": "ajito_kakutou_040_sitappa_01",
      "hash64": "E7EEF3AC2C217291",
      "text": "Oh, Riri...[VAR 0x0114(003F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "ajito_kakutou_040_nelke_02",
      "hash64": "5C186340FEE61207",
      "text": "This is the Team Star member you battled at the\\ngates earlier. I asked her to come along for a talk.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
