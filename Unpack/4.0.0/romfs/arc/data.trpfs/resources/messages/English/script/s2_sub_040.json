      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_040_teacher_02",
      "hash64": "EB837FC0B45CBCFE",
      "text": "Hope it doesn’t feel too invasive for me to ask...\\nAre you keeping up with your Pokémon battles?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_040_teacher_03",
      "hash64": "EB8380C0B45CBEB1",
      "text": "Here at Blueberry Academy, we try to get the\\nstudents excited to battle each other.\\c\\nWhich means I’ll give you BP for battling the\\nstudents here—the more battles, the more BP!",
      "flags": 0,
      "text_status": "DECODED",
