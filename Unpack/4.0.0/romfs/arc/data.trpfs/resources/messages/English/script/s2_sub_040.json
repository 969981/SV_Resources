    {
      "ordinal": 1,
      "label": "s2_sub_040_teacher_01",
      "hash64": "EB837EC0B45CBB4B",
      "text": "Hey there, exchange student! Your friendly\\nneighborhood guidance counselor here!",
      "flags": 0,
