      "hash64": "F79DE108E752CF5D",
      "text": "[VAR 0xBD06(0000)]Ah, here you are, M[VAR 0x1100(00FF,0305)]asteriss\\n[VAR 0x0100(0000)].[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
