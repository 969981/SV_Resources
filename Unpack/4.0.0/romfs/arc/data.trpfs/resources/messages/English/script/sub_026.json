  "entries": [
    {
      "ordinal": 0,
      "label": "sub_025_sitappa_a_01",
      "hash64": "374EC4ECC983AA5C",
      "text": "Oh, hi. This is a home for Team Star dropouts.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_025_sitappa_a_02",
      "hash64": "374EC7ECC983AF75",
      "text": "... ... ...\\nOperation Starfall? You’ve declared war?\\c\\nThat’s not really any of our business. It’s not like\\nwe talk to the folks in charge.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_025_sitappa_a_03",
      "hash64": "374EC6ECC983ADC2",
      "text": "Anyway, thanks for coming. Haven’t really got\\nmuch to welcome a guest with, but...here.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_025_system_01",
      "hash64": "284BBDA29079A845",
      "text": "You got the [VAR 0xFF00(0008)]Sporty Cap (Star)[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_025_sitappa_a_04",
      "hash64": "374EC1ECC983A543",
      "text": "You can stay and hang here however long you\\nlike. If you need to get going, that’s fine too!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_025_sitappa_a_05",
      "hash64": "374EC0ECC983A390",
      "text": "This is a home for Team Star dropouts.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_025_sitappa_b_01",
      "hash64": "61CCBCE1801AED13",
      "text": "We just got tired of Team Star stuff, y’know?\\nWe’ve even started going to school on the sly.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_025_sitappa_c_01",
      "hash64": "5EDE10DC579B18FE",
      "text": "Nice to meet ya! And when you go, like always...\\nHasta la vistaaarrr! ☆",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_025_sitappa_d_01",
      "hash64": "895C88D10E333535",
      "text": "No one fights here. That’s why it’s such a nice\\nplace—better than school, better than with Team\\r\\nStar, better than home...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    }
  ]
}
