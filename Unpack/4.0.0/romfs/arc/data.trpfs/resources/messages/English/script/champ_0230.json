      "hash64": "6DD6B9F2EFEEE2AA",
      "text": "Are you ready to face Poppy of the Elite Four?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
