    {
      "ordinal": 2,
      "label": "sub_004_01",
      "hash64": "93AEF6B5DB5A8D28",
      "text": "Congratulations on clearing the Cortondo Gym!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_004_02",
      "hash64": "93AEF9B5DB5A9241",
      "text": "Now that you’ve got a badge from Katy, you’re\\nentitled to try a special Olive Roll challenge!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_004_03",
      "hash64": "93AEF8B5DB5A908E",
      "text": "In this version of the Olive Roll, we’ll keep track\\nof how long it takes you to finish.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_004_04",
      "hash64": "93AEFBB5DB5A95A7",
      "text": "And we’ve got lovely prizes for you if you roll\\nyour way to a super-speedy time!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_004_05",
      "hash64": "93AEFAB5DB5A93F4",
      "text": "Ready to try your hand at the special Olive Roll?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_004_chose_1",
      "hash64": "4FB821B325D7CD5D",
      "text": "I’m ready to roll!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_004_chose_2",
      "hash64": "4FB81EB325D7C844",
      "text": "What’s my record time?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_004_chose_3",
      "hash64": "4FB81FB325D7C9F7",
      "text": "I’ll pass, thanks",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_004_chose_1_after",
      "hash64": "2A420F8B49E0B7AC",
      "text": "Great! Put in a wish for a good olive harvest, and\\nroll, roll, roll away!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_004_chose_2_after",
