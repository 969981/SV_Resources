            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_034_ecology_04",
      "hash64": "AE533FC3090E0337",
      "text": "*sigh*\\nI thought I made it clear that it was too risky.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
