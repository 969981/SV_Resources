    {
      "ordinal": 12,
      "label": "common_2020_esper_010_esper_09",
      "hash64": "49A5A762ABD9E527",
      "text": "Oh, wonderful. Let’s head to the battle court.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
