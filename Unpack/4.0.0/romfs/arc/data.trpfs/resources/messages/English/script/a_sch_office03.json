      "label": "a_sch_office03_eve07",
      "hash64": "8F5DA8DBF9785677",
      "text": "I come here to take a breather when I’m feeling\\ndown about stuff from class.\\c\\nNurse Miriam always lets me stay without making\\nme explain or anything. She’s so nice.",
      "flags": 4,
      "text_status": "DECODED",
