      "ordinal": 0,
      "label": "champ_0125_rival_01",
      "hash64": "92913BE50E9401F6",
      "text": "Hey, I heard the good news! Congrats on Gym\\nBadge number six![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
