          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0190_rival_03",
      "hash64": "EB0E59ADCB0F6EE8",
      "text": "And that huge building with the Poké Ball on it\\nis our school![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0190_rival_04",
      "hash64": "EB0E60ADCB0F7ACD",
      "text": "It’s gonna be so great having you in the same\\nclass, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
