          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "legend_0050_friend_05",
      "hash64": "F0522289AF7F34A1",
      "text": "Now then, let’s see... What does the book have\\nto say?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "legend_0050_friend_a",
      "hash64": "5DDA3839FD757831",
      "text": "It says here that the [VAR 0xFF00(0006)]Sweet Herba Mystica[VAR 0xFF00(0000)] is good\\nfor gut health and that it helps aid digestion.\\c\\nSays it’s great for stomachaches, too, or when\\nyou want to stimulate the ol’ appetite![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 195,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "legend_0050_friend_b",
      "hash64": "5DDA3539FD757318",
      "text": "Well, apparently [VAR 0xFF00(0006)]Salty Herba Mystica[VAR 0xFF00(0000)] helps with\\naching hands and feet. Good for neuropathy and\\r\\nnumbness.\\c\\nWhen you’ve got muscle weakness, it supposedly\\nbuilds up strength again![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 191,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "legend_0050_friend_c",
      "hash64": "5DDA3639FD7574CB",
      "text": "[VAR 0xFF00(0006)]Bitter Herba Mystica[VAR 0xFF00(0000)]’s great for your circulation!\\nIt really gets the blood flowing!\\c\\nAnd that warms you right up, nice and toasty,\\neven boosting the immune system!\\c\\n...Or so it says.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
