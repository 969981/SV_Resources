    {
      "ordinal": 8,
      "label": "legend_0050_friend_d",
      "hash64": "5DDA3B39FD757D4A",
      "text": "OK, [VAR 0xFF00(0006)]Sour Herba Mystica[VAR 0xFF00(0000)] is chock-full of nutrients\\nand is great for boosting your overall health!\\c\\nSays here it works wonders whether you’re tired\\nphysically or mentally. Perks you right up![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
