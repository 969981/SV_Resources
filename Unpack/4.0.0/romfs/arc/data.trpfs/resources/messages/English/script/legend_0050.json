    {
      "ordinal": 3,
      "label": "legend_0050_friend_04",
      "hash64": "F0522189AF7F32EE",
      "text": "This shape! This sheen! It looks like it’ll taste\\nhorrible, which means it’s gotta be good for you![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
