          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0120_dragon_04",
      "hash64": "FB5269F69819A53F",
      "text": "[VAR 0xBD06(0000)]Hardly had you sent out [VAR 0x0101(0001)]\\nbefore\\r\\nyou\\r\\nlaunched\\r\\ninto\\r\\nyour strategy![VAR 0x0114(0012)]",
