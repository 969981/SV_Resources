  "entries": [
    {
      "ordinal": 0,
      "label": "sub_006_trainer_01",
      "hash64": "B992376E5778CB1C",
      "text": "I hear you beat Grusha and earned yourself a\\nGym Badge! Way to go!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_006_trainer_02",
      "hash64": "B9923A6E5778D035",
      "text": "Now don’t you worry—you’re still free to enjoy\\nthe snowy slopes here on Glaseado Mountain\\r\\neven now that you’ve beaten the Gym.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_006_trainer_03",
      "hash64": "B992396E5778CE82",
      "text": "Want to try your hand at the Snow Slope Run?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_006_trainer_04",
      "hash64": "B992346E5778C603",
      "text": "Which course will you go for?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_006_trainer_05",
      "hash64": "B992336E5778C450",
      "text": "The Powder Snow Course it is! Have yourself an\\neasy-breezy slide down the mountain!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_006_trainer_06",
      "hash64": "B992366E5778C969",
      "text": "The Blizzard Course! Copy that! Try to keep your\\nfocus sharp all the way down!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_006_trainer_07",
      "hash64": "B992356E5778C7B6",
      "text": "The Sheer Cold Course, eh? Quite a challenge,\\nto be sure! Good luck out there, kid!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_006_trainer_08",
      "hash64": "B992406E5778DA67",
      "text": "You’ll need to ride a Pokémon down one of\\nGlaseado Mountain’s natural snowy slopes...\\r\\nThat’s all there is to it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_006_trainer_09",
      "hash64": "B9923F6E5778D8B4",
      "text": "Choose one of three possible courses and reach\\nits finish line within the target time, and you\\r\\nmight just earn yourself a nice prize!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_006_trainer_10",
      "hash64": "B98EB26E5775B346",
      "text": "Have fun, give it your all, and see if you can\\nkeep beating your personal bests!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_006_trainer_11",
      "hash64": "B98EB36E5775B4F9",
      "text": "Your best times, eh? Let’s see...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_006_trainer_12",
      "hash64": "B98EB06E5775AFE0",
      "text": "That’d be [VAR 0x0201(0000)]:[VAR 0x0201(0001)].[VAR 0x0201(0002)] on the Powder Snow Course.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_006_trainer_13",
      "hash64": "B98EB16E5775B193",
      "text": "As for the Blizzard Course, your best time is\\n[VAR 0x0201(0000)]:[VAR 0x0201(0001)].[VAR 0x0201(0002)]!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_006_trainer_14",
      "hash64": "B98EB66E5775BA12",
      "text": "And for the Sheer Cold Course, your best time is\\n[VAR 0x0201(0000)]:[VAR 0x0201(0001)].[VAR 0x0201(0002)]!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_006_trainer_15",
      "hash64": "B98EB76E5775BBC5",
      "text": "Hmm... You haven’t reached the goal on the\\nPowder Snow Course yet.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sub_006_trainer_16",
      "hash64": "B98EB46E5775B6AC",
      "text": "As for the Blizzard Course, you still need to\\ncomplete that one.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_006_trainer_17",
      "hash64": "B98EB56E5775B85F",
      "text": "And for the Sheer Cold Course? Yeah, you need\\nto reach the goal before you can get a best time!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sub_006_select_01",
      "hash64": "92B072B3A21EFB49",
      "text": "Yeah! I’m ready to go!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sub_006_select_02",
      "hash64": "92B06FB3A21EF630",
      "text": "What are the rules?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sub_006_select_03",
      "hash64": "92B070B3A21EF7E3",
      "text": "What are my best times?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sub_006_select_04",
      "hash64": "92B075B3A21F0062",
      "text": "Never mind",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sub_006_select_05",
      "hash64": "92B076B3A21F0215",
      "text": "Powder Snow Course",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sub_006_select_06",
      "hash64": "92B073B3A21EFCFC",
      "text": "Blizzard Course",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "sub_006_select_07",
      "hash64": "92B074B3A21EFEAF",
      "text": "Sheer Cold Course",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "sub_006_trainer_18",
      "hash64": "B98EBA6E5775C0DE",
      "text": "Well done on your first time completing the\\nPowder Snow Course! Here—this prize is for you!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "sub_006_trainer_24",
      "hash64": "B98B486E5772C951",
      "text": "From now on, you’ll be able to take on the\\nBlizzard Course when you feel up to it!\\c\\nCareful though—it’s pretty tough!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sub_006_trainer_19",
      "hash64": "B98EBB6E5775C291",
      "text": "You completed a full run on the Blizzard Course\\nfor the first time! Now you’re practically a pro!\\r\\nHere—this prize is for you!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sub_006_trainer_25",
      "hash64": "B98B476E5772C79E",
      "text": "From now on, you’ll be able to take on the\\nSheer Cold Course—our toughest slope of all!\\r\\nCome back and give it a go if you dare!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sub_006_trainer_20",
      "hash64": "B98B4C6E5772D01D",
      "text": "You completed the Sheer Cold Course for the\\nfirst time! You’re a snow-slope master now!\\r\\nHere, take this prize. You’ve earned it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sub_006_trainer_21",
      "hash64": "B98B4B6E5772CE6A",
      "text": "Congratulations! You beat your previous best\\ntime with those amazing sliding skills!\\c\\nHere’s your reward for a run well-done!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sub_006_trainer_22",
      "hash64": "B98B4A6E5772CCB7",
      "text": "Nice job reaching the goal safe and sound.\\nCan’t wait to see you do even better next time!\\r\\nFor now, here’s a reward for your fine efforts.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
