    {
      "ordinal": 34,
      "label": "sub_006_trainer_23",
      "hash64": "B98B496E5772CB04",
      "text": "The slopes weren’t your friend that time, eh?\\nYour next try will be better, I’m sure!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "sub_006_trainer_stop",
      "hash64": "00406627BC61950F",
      "text": "Oh? It seems the Pokémon you’ll be riding is\\ncurrently in its battle form.\\c\\nIf you want to take on the Snow Slope Run, your\\nPokémon needs to change into its ride form first.",
      "flags": 4,
      "text_status": "DECODED",
