      "ordinal": 0,
      "label": "s1_side02_0040_camera_01",
      "hash64": "9AD6E015162B20A0",
      "text": "OK, so if we just compile the photos we both\\ntook...[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
