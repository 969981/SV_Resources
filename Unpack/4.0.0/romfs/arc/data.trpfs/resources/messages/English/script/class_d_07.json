      "ordinal": 30,
      "label": "class_d_07_poke_04",
      "hash64": "01CFAE9AF1E7E611",
      "text": "Chaaa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "class_d_07_language_19",
      "hash64": "F783FDD5B9B77D76",
      "text": "When you’re faced with a problem that you can’t\\nhandle alone, find someone to rely on, be it a\\r\\nteacher, your family, your friends—anyone![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
