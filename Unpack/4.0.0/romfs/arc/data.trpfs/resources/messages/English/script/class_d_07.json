          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_07_language_05",
      "hash64": "F78085D5B9B47BB7",
      "text": "Vas-y—go for it, my assistant! Pika pi, Pikachu![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
