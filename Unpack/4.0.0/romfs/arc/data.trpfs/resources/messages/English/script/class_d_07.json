          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_d_07_language_07",
      "hash64": "F78087D5B9B47F1D",
      "text": "For our last listening class...tell everyone how\\nyou’re feeling right now, s’il te plaît![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
