      "hash64": "01CFB19AF1E7EB2A",
      "text": "Pikachu!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_d_07_language_06",
      "hash64": "F78086D5B9B47D6A",
      "text": "Let’s get right to it, my little Pikachu friend![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
