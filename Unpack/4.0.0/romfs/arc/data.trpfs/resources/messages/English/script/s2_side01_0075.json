      "ordinal": 0,
      "label": "s2_side01_0075_rival_01",
      "hash64": "FAEA03AAC76BE4F1",
      "text": "You sure you don’t want to stay with your sister?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
