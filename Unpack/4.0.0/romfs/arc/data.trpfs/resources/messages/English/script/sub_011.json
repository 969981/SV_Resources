    {
      "ordinal": 0,
      "label": "sub_011_takara_cook_00",
      "hash64": "237871EE06E9D2F5",
      "text": "Welcome. They’ll take your order at the front.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_011_takara_cook_01",
      "hash64": "237870EE06E9D142",
      "text": "Hey, it’s you—the student who beat Larry! That\\nwas some fine battling!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_011_takara_cook_02",
      "hash64": "23786FEE06E9CF8F",
      "text": "You’re something, kid. I’ll let you in on a special\\ndish I only make for my favorite customers—\\r\\none that changes a Pokémon’s Tera Type!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_011_takara_cook_03",
      "hash64": "23786EEE06E9CDDC",
      "text": "I just need these special ingredients called Tera\\nShards. Whenever you get your mitts on ’em,\\r\\ncome let me know!\\c\\nSince you’re a first-timer, I’ll give you enough to\\nchange a Pokémon’s Tera Type to Normal!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_011_takara_cook_04",
      "hash64": "23786DEE06E9CC29",
      "text": "Brought me some Tera Shards so I can whip up a\\nTera Type-changing dish?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
