    {
      "ordinal": 23,
      "label": "sub_011_takara_select_02",
      "hash64": "D68D276840CF39A3",
      "text": "How does this work?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "sub_011_takara_select_03",
      "hash64": "D68D266840CF37F0",
      "text": "Not now, thanks",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "sub_011_takara_cook_05",
      "hash64": "23786CEE06E9CA76",
      "text": "I’ll need 50 Tera Shards for the special dish...\\nbut it seems you’re a bit short! Sorry, kid!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "sub_011_takara_cook_06",
      "hash64": "23786BEE06E9C8C3",
      "text": "It works like this: I make a special dish that your\\nPokémon can eat to change its Tera Type!\\c\\nI need 50 Tera Shards to make the dish, though.\\nIt’s up to you to gather ’em for me!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
