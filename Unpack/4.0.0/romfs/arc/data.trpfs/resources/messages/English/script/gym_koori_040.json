      "label": "gym_koori_040_receptionist_00",
      "hash64": "DF57B8C8336F5CE1",
      "text": "[VAR 0xBD06(0000)]Hello, [VAR 0x0100(0000)].\\nWelcome\\r\\nto\\r\\nthe\\r\\nGlaseado Gym.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
