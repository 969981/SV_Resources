      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "t02_09",
      "hash64": "B8FB8FABB6AECF85",
      "text": "My Paralyze Heals were delivered! Oh, lovely!\\nJust what you need to help a paralyzed Pokémon.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "t02_10",
      "hash64": "B8FEFCABB6B1BE93",
      "text": "The Pokémon at the head of your party will\\nalways be the first one sent out in a battle.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "t02_11",
      "hash64": "B8FEFBABB6B1BCE0",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "t02_12",
      "hash64": "B8FEFEABB6B1C1F9",
      "text": "That uniform tells me you’re a student at the\\nacademy, no mistake about it.\\c\\nYou know you can have six Pokémon with you at\\na time, don’t you? No need to skimp!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "t02_13",
      "hash64": "B8FEFDABB6B1C046",
      "text": "I go to school every day and learn lots and lots\\n’bout Pokémon and things!\\c\\nLike, did you already know that every Pokémon\\ncan remember up to four moves at a time?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "t02_14",
      "hash64": "B8FF00ABB6B1C55F",
      "text": "Academy students who live here in Los Platos\\ndon’t bother with the dorms. We commute to\\r\\nschool each day directly from home!\\c\\nThough the hill does make it pretty rough.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "t02_15",
      "hash64": "B8FEFFABB6B1C3AC",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "t02_17",
      "hash64": "B8FF01ABB6B1C712",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "t02_21",
      "hash64": "B8F48BABB6A8AA0B",
      "text": "Have you heard that Pelipper can carry people’s\\nletters and packages in its large bill?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "t02_22",
      "hash64": "B8F48CABB6A8ABBE",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "t02_23",
      "hash64": "B8F48DABB6A8AD71",
      "text": "Off to school now, dear? Careful on the road,\\nand remember to jot things down so you won’t\\r\\nforget what you’ve accomplished!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "t02_24",
      "hash64": "B8F48EABB6A8AF24",
      "text": "This is Los Platos. We’re always happy to serve\\nup a helping of hospitality to anyone passing by.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
