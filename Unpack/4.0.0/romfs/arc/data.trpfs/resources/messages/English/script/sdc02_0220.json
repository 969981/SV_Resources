    {
      "ordinal": 39,
      "label": "sdc02_0220_dragonbb_15",
      "hash64": "41B7DC823CDF24B3",
      "text": "Well, we shouldn’t leave Ms. Briar hanging, or\\nwe’ll never hear the end of it.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
