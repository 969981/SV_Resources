    },
    {
      "ordinal": 38,
      "label": "sdc02_0220_fairybb_10",
      "hash64": "90AD2586A38B5CA8",
      "text": "Drayton! Could you seriously NOT right now!\\nIt’s just not right—and certainly not kind![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
