      "ordinal": 37,
      "label": "sdc02_0220_dragonbb_14",
      "hash64": "41B7DB823CDF2300",
      "text": "“BB League Champion Kieran,” huh? They’re\\ngonna need to update that.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
