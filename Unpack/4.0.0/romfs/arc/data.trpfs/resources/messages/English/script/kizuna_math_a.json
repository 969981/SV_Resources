          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_a_06",
      "hash64": "FA7C7778265447CB",
      "text": "Hahaha. I’m glad to hear it! Then perhaps you\\nwon’t mind a little quiz.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_a_07",
      "hash64": "FA7C767826544618",
      "text": "Flying-type Pokémon are weak to Rock-type\\nmoves.\\c\\nWhen a Rock-type move hits a Flying-type\\nPokémon, what becomes of the move’s damage?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_a_select_01",
      "hash64": "306B2135068E44C9",
      "text": "It stays the same",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_a_select_02",
      "hash64": "306B1E35068E3FB0",
      "text": "It’s doubled",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_a_select_03",
      "hash64": "306B1F35068E4163",
      "text": "It’s multiplied by 100",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_a_08a",
      "hash64": "F5BF9F29212F92CC",
      "text": "Yes, that’s right! The correct answer is that the\\nmove’s damage is doubled.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_a_08b",
      "hash64": "F5BFA229212F97E5",
      "text": "Oh dear. The correct answer is that the move’s\\ndamage is doubled. But I appreciate you trying![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
