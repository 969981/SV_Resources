    {
      "ordinal": 13,
      "label": "kizuna_math_a_09",
      "hash64": "FA7C7478265442B2",
      "text": "Oh, my. I see one of my more energetic students\\nis here to see me. You’ll have to wait your turn,\\r\\ndear! There is only one of me, after all.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
