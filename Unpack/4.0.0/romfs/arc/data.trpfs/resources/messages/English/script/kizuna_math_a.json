    {
      "ordinal": 14,
      "label": "kizuna_math_a_mob_02",
      "hash64": "74F36AAA300E38D8",
      "text": "Um, Ms. Tyme? Is it true that you were a Gym\\nLeader?!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_a_10",
      "hash64": "FA797778265211F4",
      "text": "That is indeed true. I’m quite the strong battler,\\nyou know![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_math_a_mob_03",
      "hash64": "74F36BAA300E3A8B",
      "text": "Wow! That’s so cool! Why’d you quit?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_math_a_11",
      "hash64": "FA797878265213A7",
      "text": "So you want to know, do you? I might be\\npersuaded to tell you if you wait your turn.[VAR 0x0114(0025)]",
