      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_a_05",
      "hash64": "FA7C78782654497E",
      "text": "What were you having trouble with? Let’s have a\\nlittle review here, shall we?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
