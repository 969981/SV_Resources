          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_home_sp01_01",
      "hash64": "08417DABC4CB6C03",
      "text": "I had heard that an extraordinary exchange\\nstudent making a name for themselves here was\\r\\ntasked with gathering talent.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_home_sp01_02",
      "hash64": "08417EABC4CB6DB6",
      "text": "I was curious to see what kind of student could\\nearn such high renown, but well... Now that I\\r\\nfind you here, it all makes sense.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_home_sp01_select_01",
      "hash64": "56C5850AFD03903A",
      "text": "Thank you!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_home_sp01_select_02",
      "hash64": "56C5840AFD038E87",
      "text": "I know, right?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_home_sp01_03",
      "hash64": "08417FABC4CB6F69",
      "text": "Heh... You do not hide your talent, do you? A\\nkey to your success, no doubt.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_home_sp01_03b",
      "hash64": "D2BAFBDF65ADAFB1",
      "text": "Heh... You have a sense of humor about all this,\\ndon’t you? A key to your success, no doubt.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_home_sp01_04",
      "hash64": "084180ABC4CB711C",
      "text": "Seeing a student of mine achieve such great\\nthings brings me joy.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_home_sp01_05",
      "hash64": "084181ABC4CB72CF",
      "text": "I’ll do my best here to try and match your own\\naccomplishments.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_home_sp02_00",
      "hash64": "35FB06B227A63AFF",
      "text": "A word, M[VAR 0x1100(00FF,0305)]asteriss [VAR 0x0100(0000)]?[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0305"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_home_sp02_01",
      "hash64": "35FB05B227A6394C",
      "text": "You see, I recently decided to get a case for my\\nRotom Phone.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_home_sp02_02",
      "hash64": "35FB08B227A63E65",
      "text": "Now, tell me... Did I put it on right?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_home_sp02_select_01",
      "hash64": "3465931329A1841B",
      "text": "Looks good!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_home_sp02_select_02",
      "hash64": "3465941329A185CE",
      "text": "Cute case!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_home_sp02_select_03",
      "hash64": "3465951329A18781",
      "text": "Arven has that case!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_home_sp02_03",
      "hash64": "35FB07B227A63CB2",
      "text": "Thank goodness! This is the very first time I’ve\\nattempted something like this...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_home_sp02_03b",
      "hash64": "5FCAE3B95F795570",
      "text": "Oh! So you think so as well?! I’m also very fond\\nof this case![VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_home_sp02_03c",
      "hash64": "5FCAE4B95F795723",
      "text": "Oh? So we have matching cases now, it seems...\\nThat boy Arven’s got quite good taste.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_home_sp02_04",
      "hash64": "35FB02B227A63433",
      "text": "I searched everywhere to get my hands on it,\\nyou know.\\c\\nAs it turns out, the Flabébé Flower Case is sold\\nonly in Cascarrafa.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_home_sp02_05",
      "hash64": "35FB01B227A63280",
      "text": "I’m quite pleased that I was able to find it in\\nthe end.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_home_sp03_00",
      "hash64": "8C60D0B9C30FFB6E",
      "text": "Allow me to share some good information with\\nyou, M[VAR 0x1100(00FF,0305)]asteriss [VAR 0x0100(0000)].[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0305"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_home_sp03_01",
      "hash64": "8C60D1B9C30FFD21",
      "text": "You can find the Cream Pokémon Milcery in\\nthe Terarium.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_home_sp03_02",
      "hash64": "8C60CEB9C30FF808",
      "text": "Not only is it adorable, but it also emits a\\nsweet fragrance. It’s hard to put into words\\r\\njust how lovely it is...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_home_sp03_03",
      "hash64": "8C60CFB9C30FF9BB",
      "text": "Are you aware of the peculiar way in which one\\ngets Milcery to evolve?[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_home_sp03_select_01",
      "hash64": "A71868C0337C82E0",
      "text": "By spinning around",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_home_sp03_select_02",
      "hash64": "A7186BC0337C87F9",
      "text": "By calling it cute",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_home_sp03_select_03",
      "hash64": "A7186AC0337C8646",
      "text": "By feeding it something sweet",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_home_sp03_04",
      "hash64": "8C60D4B9C310023A",
      "text": "That is indeed correct. Have you by chance tried\\nthis yourself already?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_home_sp03_04b",
      "hash64": "988BCFA67433FB88",
      "text": "Well, yes, telling your Pokémon how cute it is\\nwill put you both in a lovely mood, but it’s\\r\\nnot going to evolve from that.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_home_sp03_04c",
      "hash64": "988BD0A67433FD3B",
      "text": "Oh, that’d be lovely if it evolved by eating a\\ntasty Peanut Butter Sandwich...\\c\\nBut, alas, I don’t think that’s ever happened.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_home_sp03_05",
      "hash64": "8C60D5B9C31003ED",
      "text": "If you want a Milcery to evolve, put it in your\\nparty and spin around a few times.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_teacher_home_sp03_06",
      "hash64": "8C60D2B9C30FFED4",
      "text": "When you do that, its cream gets whisked around\\nand causes it to become a fluffy Alcremie.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_teacher_home_sp03_07",
      "hash64": "8C60D3B9C3100087",
      "text": "But don’t forget to have your Milcery hold onto\\na Sweet item before you attempt this![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_teacher_home_sp03_08",
      "hash64": "8C60C8B9C30FEDD6",
      "text": "And be aware that Alcremie’s form will change\\ndepending on the Sweet it was holding, as well as\\r\\nthe way you spin around.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
