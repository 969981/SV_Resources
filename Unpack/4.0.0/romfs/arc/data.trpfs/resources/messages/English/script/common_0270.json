      ]
    },
    {
      "ordinal": 3,
      "label": "common_0270_head_teacher_03",
      "hash64": "F612F786ADD638BE",
      "text": "That is most wonderful to hear.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
