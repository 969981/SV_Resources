    {
      "ordinal": 2,
      "label": "common_0270_head_teacher_02b",
      "hash64": "F8765FD96304AE49",
      "text": "Have you been enjoying your time here at\\nUva Academy?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
