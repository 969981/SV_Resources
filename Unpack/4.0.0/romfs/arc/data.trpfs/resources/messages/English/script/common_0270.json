      ]
    },
    {
      "ordinal": 4,
      "label": "common_0270_head_teacher_04",
      "hash64": "F612FA86ADD63DD7",
      "text": "I see... Do remember I am always here to lend an\\near should you find yourself struggling in any way.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0270_head_teacher_05",
      "hash64": "F612F986ADD63C24",
      "text": "Now, you may be wondering why we could not\\nhave simply conversed earlier in the cafeteria.\\c\\nBut let me assure you, there is a reason why I\\nasked you to meet me here in my office.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 180,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0270_head_teacher_06",
      "hash64": "F612FC86ADD6413D",
      "text": "It seems that a friend of mine has a rather serious\\nmatter they would like to discuss with you.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0270_head_teacher_07",
      "hash64": "F612FB86ADD63F8A",
      "text": "Ah, no, I’m afraid they aren’t actually here\\nin this room with us. One moment, please.\\r\\nJust allow me to connect us...[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
