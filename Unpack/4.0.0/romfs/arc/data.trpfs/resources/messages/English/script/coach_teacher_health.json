          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_teacher_health_first_01",
      "hash64": "DB9760C44104B9DC",
      "text": "We’re making this place my nurse’s office while\\nI’m here, right?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_health_sp01_00",
      "hash64": "359B4BB7C4E55061",
      "text": "Ah, I knew it! I figured you were the one who\\ncalled me.[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_health_sp01_01",
      "hash64": "359B4AB7C4E54EAE",
      "text": "I was suuuper surprised when I got told this stuff\\nabout a work trip all of a sudden![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_health_sp01_02",
      "hash64": "359B49B7C4E54CFB",
      "text": "Can you believe they’re having me teach my\\nfirst class ever HERE instead of back home?![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_health_sp01_select_01",
      "hash64": "A49B12D57D51AF3D",
      "text": "Just do your best!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_health_sp01_select_02",
      "hash64": "A49B0FD57D51AA24",
      "text": "You’ll do fine!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_health_sp01_03",
      "hash64": "359B48B7C4E54B48",
      "text": "Easy for you to say. You’re not the one\\nteaching the class...[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_health_sp01_03b",
      "hash64": "FC27BA43919EB85E",
      "text": "You sound so sure! Wish I had even half of that\\nkind of confidence...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_health_sp01_04",
      "hash64": "359B4FB7C4E5572D",
      "text": "Oh, what am I saying? You got me over here, so\\nI’ll do my best to make the most of this![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_health_sp01_05",
      "hash64": "359B4EB7C4E5557A",
      "text": "It’ll be the nurse’s office...Blueberry Academy\\nstyle![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_health_sp02_00",
      "hash64": "8ED009D10C36736E",
      "text": "[VAR 0xBD06(0000)]Hey, [VAR 0x0100(0000)]! You won’t\\nbelieve\\r\\nthis...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_health_sp02_01",
      "hash64": "8ED00AD10C367521",
      "text": "I had my first class ever...and I managed to screw\\nup already![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_health_sp02_02",
      "hash64": "8ED007D10C367008",
      "text": "Get this—the actual, like, class? Went perfectly.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_health_sp02_03",
      "hash64": "8ED008D10C3671BB",
      "text": "But then I finished my lesson and realized...I was\\nin the wrong classroom the whole time![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_health_sp02_select_01",
      "hash64": "BFCE805A3DD52AE0",
      "text": "Oof, that’s rough",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_health_sp02_select_02",
      "hash64": "BFCE835A3DD52FF9",
      "text": "Eh, it happens!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_health_sp02_04",
      "hash64": "8ED00DD10C367A3A",
      "text": "I think they were having study hall or something.\\nThen I go marching on in and start teaching\\r\\nhealth lessons! They must’ve thought I was crazy![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_health_sp02_04b",
      "hash64": "E201D237C091E388",
      "text": "What do you mean “it happens”?\\c\\nI know you’re trying to cheer me up, but I’m\\npretty sure that was a first—both for Blueberry\\r\\nAcademy AND [VAR 0x1107(00FF,0206)]NaranjUva Academy...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0206"
          ]
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_health_sp02_05",
      "hash64": "8ED00ED10C367BED",
      "text": "Ugh, no, let’s change the topic! Just thinking\\nabout it makes me want to hide in a hole![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_health_sp02_06",
      "hash64": "8ED00BD10C3676D4",
      "text": "I should just forget about the mess-up and\\nkeep on marching along![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_health_sp03_00",
      "hash64": "386A3FC970CCB2FF",
      "text": "Hey, [VAR 0x0100(0000)]! Guess what?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_health_sp03_01",
      "hash64": "386A3EC970CCB14C",
      "text": "Remember how I went to the wrong classroom\\nand lectured a bunch of random students?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_health_sp03_02",
      "hash64": "386A41C970CCB665",
      "text": "Well, some of those kids came and found me\\n’cause they wanted to ask questions![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_health_sp03_03",
      "hash64": "386A40C970CCB4B2",
      "text": "I thought that teaching the wrong class would\\nforever be a stain on my teaching career...[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_health_sp03_04",
      "hash64": "386A3BC970CCAC33",
      "text": "but it looks like those students got something out\\nof it in the end![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_health_sp03_05",
      "hash64": "386A3AC970CCAA80",
      "text": "I’m like...really, super happy about it![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_health_sp03_select_01",
      "hash64": "4D1BAAAD33FA2C1B",
      "text": "That’s great!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_health_sp03_select_02",
      "hash64": "4D1BABAD33FA2DCE",
      "text": "That’s wild!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_health_sp03_06",
      "hash64": "386A3DC970CCAF99",
      "text": "I know, right?![VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_health_sp03_07",
      "hash64": "386A3CC970CCADE6",
      "text": "Being a teacher really is fun after all... I mean,\\nit’s not a total cakewalk either, but still![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_health_sp03_08",
      "hash64": "386A47C970CCC097",
      "text": "[VAR 0xBD06(0000)]I’m glad I kept at it! Thank you,\\n[VAR 0x0100(0000)]![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_health_trade_01_00",
      "hash64": "8F74B786FF4D1059",
      "text": "Oh, that’s right! Do you have a minute?[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_teacher_health_trade_01_01",
      "hash64": "8F74B686FF4D0EA6",
      "text": "You’re always helping me out, so I wanted to\\nreturn the favor.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_teacher_health_trade_01_02",
      "hash64": "8F74B586FF4D0CF3",
      "text": "Wanna trade with me? We can get to know each\\nother better that way![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_teacher_health_trade_01_03",
      "hash64": "8F74B486FF4D0B40",
      "text": "OK! I’ve got a Mareanie. What about you?[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_teacher_health_trade_01_04",
      "hash64": "8F74BB86FF4D1725",
      "text": "[VAR 0xBD06(0000)][VAR 0x1303(0001,0000)][VAR 0x0101(0001)], huh? I thought you’d pick\\nsomething\\r\\nlike\\r\\nthat!\\c\\nI’ll take good care of it so it can grow big,\\nstrong, and healthy![VAR 0x0114(0028)]",
