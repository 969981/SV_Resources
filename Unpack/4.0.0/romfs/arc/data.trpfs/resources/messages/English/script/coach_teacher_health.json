    {
      "ordinal": 0,
      "label": "coach_teacher_health_first_00",
      "hash64": "DB9761C44104BB8F",
      "text": "Pardon me![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
