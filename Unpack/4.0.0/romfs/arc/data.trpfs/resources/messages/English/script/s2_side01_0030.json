    {
      "ordinal": 2,
      "label": "s2_side01_0030_botan_01",
      "hash64": "BAE39ABD743CDFC2",
      "text": "Oh my GOSH, Dad, would you just drop it?!\\nI told you—friends! I’m going with friends![VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
