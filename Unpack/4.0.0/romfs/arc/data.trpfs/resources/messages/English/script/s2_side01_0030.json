    },
    {
      "ordinal": 10,
      "label": "s2_side01_0030_rival_03",
      "hash64": "FDAF2C3F1233774A",
      "text": "OK! We’ve all got permission, and we’re all here![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
