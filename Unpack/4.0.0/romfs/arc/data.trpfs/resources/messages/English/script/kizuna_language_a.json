      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_language_a_select_01",
      "hash64": "5CD5EE18BF0E6821",
      "text": "I sure did!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_language_a_select_02",
      "hash64": "5CD5EB18BF0E6308",
      "text": "“All the way here”?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_language_a_03",
      "hash64": "96408A3C202A572C",
      "text": "Hahaha! Seems I’ve finally made it into the hearts\\nof my students! That makes me très happy![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
