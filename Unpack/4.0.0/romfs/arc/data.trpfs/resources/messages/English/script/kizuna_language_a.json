      "ordinal": 1,
      "label": "kizuna_language_a_02",
      "hash64": "96408B3C202A58DF",
      "text": "Did you come all the way here to the staff room\\njust to see me?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
