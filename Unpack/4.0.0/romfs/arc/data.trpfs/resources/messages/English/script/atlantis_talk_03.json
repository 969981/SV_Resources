          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "atlantis_talk_03_botan_01",
      "hash64": "9B6E739203216919",
      "text": "You’re real tactless sometimes, Nemona.\\nYou know that?[VAR 0x0114(0008)]",
