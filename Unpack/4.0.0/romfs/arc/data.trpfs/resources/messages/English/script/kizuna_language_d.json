      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_language_d_poke_04",
      "hash64": "9D5A1B4D2E32EECA",
      "text": "Pawmi!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_language_d_12",
      "hash64": "C77C0365D9097B73",
      "text": "Pawmi! It spoke! At last![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_language_d_13",
      "hash64": "C77C0265D90979C0",
      "text": "Even without speaking Pokémon language myself,\\nI know that that reply means “yes”![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
