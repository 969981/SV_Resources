    {
      "ordinal": 8,
      "label": "kizuna_language_d_07",
      "hash64": "C7790665D9074AB5",
      "text": "[VAR 0xBD06(0000)]What do you think, [VAR 0x0100(0000)]?\\nWhere\\r\\ndoes\\r\\nPawmi belong?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
