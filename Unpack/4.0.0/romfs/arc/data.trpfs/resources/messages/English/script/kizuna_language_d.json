    {
      "ordinal": 1,
      "label": "kizuna_language_d_02",
      "hash64": "C7790165D9074236",
      "text": "Pawmi here is as healthy as can be![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
