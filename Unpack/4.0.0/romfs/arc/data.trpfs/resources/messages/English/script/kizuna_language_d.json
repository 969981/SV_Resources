    {
      "ordinal": 9,
      "label": "kizuna_language_d_select_01",
      "hash64": "4C9EA760060359BA",
      "text": "How about here?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_language_d_select_02",
      "hash64": "4C9EA66006035807",
      "text": "With you, Mr. Salvatore!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "kizuna_language_d_08a",
      "hash64": "F9F39B0FC766334B",
      "text": "Here? At the academy?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_language_d_08b",
      "hash64": "F9F39C0FC76634FE",
      "text": "Oh?! I didn’t expect to hear mon nom—my name![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_language_d_09",
      "hash64": "C7790865D9074E1B",
      "text": "So you think it should stay here...with me![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_language_d_10",
      "hash64": "C77C0565D9097ED9",
      "text": "I was so focused on getting it back in good\\nhealth so it could return to the wild that I didn’t\\r\\neven consider that possibility![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_language_d_11",
      "hash64": "C77C0465D9097D26",
      "text": "What do you think about that idea, my little\\nPawmi friend?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
