    {
      "ordinal": 22,
      "label": "kizuna_language_d_system_02",
      "hash64": "652DA48DF72792D4",
      "text": "You received a Meowth from Mr. Salvatore!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
