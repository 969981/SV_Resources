    {
      "ordinal": 10,
      "label": "sdc01_side01_020_brother_09",
      "hash64": "A0255B35E046C95D",
      "text": "Now then, let’s read the sign...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
