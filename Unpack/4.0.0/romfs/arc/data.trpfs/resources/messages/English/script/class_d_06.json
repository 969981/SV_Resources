      ]
    },
    {
      "ordinal": 24,
      "label": "class_d_06_language_16",
      "hash64": "F1C0A298E7E142FC",
      "text": "That’s right—I had my little Pikachu cry as if it\\nwas...crying! Haha! Funny joke, right?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
