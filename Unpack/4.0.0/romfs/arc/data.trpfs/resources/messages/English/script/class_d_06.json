    {
      "ordinal": 23,
      "label": "class_d_06_language_15",
      "hash64": "F1C0A598E7E14815",
      "text": "It’s expressing sadness! Kind of makes you want\\nto cry, doesn’t it?[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
