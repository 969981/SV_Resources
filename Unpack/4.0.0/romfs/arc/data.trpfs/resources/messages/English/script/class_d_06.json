      "ordinal": 30,
      "label": "class_d_06_language_21",
      "hash64": "F1BD3998E7DE5ABA",
      "text": "Of course, this goes for your classmates and\\nothers as well![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
