      "label": "common_2020_koori_010_koori_01",
      "hash64": "3942196C3477C673",
      "text": "Huh? I recognize you...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
