          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2020_koori_010_koori_02",
      "hash64": "39421A6C3477C826",
      "text": "You here to hit the slopes? I don’t recall the snow\\nbeing too good today...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2020_koori_010_select_01",
      "hash64": "45344D99369360EF",
      "text": "I’m here for a battle",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_2020_koori_010_select_02",
      "hash64": "45344E99369362A2",
      "text": "I came to say hi",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_koori_010_koori_03a",
      "hash64": "C31E50DD278BC3A8",
      "text": "Aw, for real...? I’ve got something important to\\nbe dealing with in a bit, y’know...[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_koori_010_koori_03b",
      "hash64": "C31E53DD278BC8C1",
      "text": "What...? OK, now I really don’t understand what\\nyou’re up to.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_koori_010_koori_04",
      "hash64": "39421C6C3477CB8C",
      "text": "Oh, I see... You’re here to cover for Geeta.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_koori_010_koori_05",
      "hash64": "39421D6C3477CD3F",
      "text": "So, your dream came true. You’re Champion\\nRank now. You must be so happy.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_koori_010_koori_06",
      "hash64": "39421E6C3477CEF2",
      "text": "Oh, my bad... That sounded a lot more sarcastic\\nthan I’d intended.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_koori_010_koori_07",
      "hash64": "39421F6C3477D0A5",
      "text": "Don’t get me wrong. I really think it’s amazing.\\nJust... It’s complicated for me—that’s all.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_koori_010_koori_08",
      "hash64": "3942206C3477D258",
      "text": "Anyway, you came to test my skills, right?\\nLet’s just get this over with.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2020_koori_010_koori_retry",
      "hash64": "744796C717C11F82",
      "text": "Are you ready now? Come on, let’s get this over\\nwith.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2020_koori_010_koori_09",
      "hash64": "3942216C3477D40B",
      "text": "Let’s head outside. You’d best hope it’s not\\nsnowing.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2020_koori_010_koori_10",
      "hash64": "39459E6C347ADE49",
      "text": "You came all the way up here just to turn down\\na battle? Man, you’re a character, aren’t you...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
