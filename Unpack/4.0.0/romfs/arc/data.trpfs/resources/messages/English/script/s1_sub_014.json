      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_014_header_14",
      "hash64": "5C4E3AC3E115D386",
      "text": "OK, I hope you enjoy sight-seeing around\\nKitakami with your current settings!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_014_header_06",
      "hash64": "5C51CAC3E118FE0D",
      "text": "OK, your screen borders will use the Paldea\\ntheme!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s1_sub_014_header_07",
      "hash64": "5C51C9C3E118FC5A",
      "text": "[EMPTY 21]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_014_header_12",
      "hash64": "5C4E3CC3E115D6EC",
      "text": "OK, your screen borders will change based on\\nyour current location!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s1_sub_014_select_00",
      "hash64": "FA5357055DDCC748",
      "text": "Set them to match my location!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s1_sub_014_select_06",
      "hash64": "FA535D055DDCD17A",
      "text": "Leave them so they match my location",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s1_sub_014_select_01",
      "hash64": "FA5358055DDCC8FB",
      "text": "Set them back to the old Paldea theme!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
