  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_014_header_01",
      "hash64": "5C51C3C3E118F228",
      "text": "Welcome, dear Paldean student!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s1_sub_014_header_02",
      "hash64": "5C51C6C3E118F741",
      "text": "We provide a special service to visitors here at\\nthe Kitakami Community Center.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_014_header_03",
      "hash64": "5C51C5C3E118F58E",
      "text": "If you’ve opened your Bag and whatnot while\\nyou’ve been here, you might have noticed that\\r\\nthe theme of the upper and lower borders of\\r\\nyour screen in some menus now changes\\r\\ndepending on your location!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 177,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_014_header_09",
      "hash64": "5C51BBC3E118E490",
      "text": "Do you want to change the settings for the upper\\nand lower borders on your menus?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_014_header_04",
