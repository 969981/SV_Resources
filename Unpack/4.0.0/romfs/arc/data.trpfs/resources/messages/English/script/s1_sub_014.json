      "hash64": "5C51C7C3E118F8F4",
      "text": "[EMPTY 21]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
