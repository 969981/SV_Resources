            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "common_2050_answer_05",
      "hash64": "A57660C67A76058D",
      "text": "Larry? I see...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
