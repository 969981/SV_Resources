            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "common_2050_answer_02",
      "hash64": "A57659C67A75F9A8",
      "text": "Brassius? Fascinating.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
