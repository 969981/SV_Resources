            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "common_2050_answer_03",
      "hash64": "A5765AC67A75FB5B",
      "text": "Kofu! Of course.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
