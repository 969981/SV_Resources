    {
      "ordinal": 2,
      "label": "sub_033_ecology_02",
      "hash64": "A5F7084293C6427A",
      "text": "Thanks for taking on all those Tera Raid Battles\\nfor us![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
