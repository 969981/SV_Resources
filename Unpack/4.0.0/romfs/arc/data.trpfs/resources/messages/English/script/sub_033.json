          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_033_ecology_03",
      "hash64": "A5F7094293C6442D",
      "text": "[VAR 0xBD06(0000)]Our investigation is moving along thanks to you,\\n[VAR 0x0100(0000)]—we have some new data.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_033_ecology_04",
      "hash64": "A5F7024293C63848",
      "text": "It seems that Terastal energy is released from\\nthe Great Crater of Paldea from time to time,\\r\\nand that’s having an effect on the crystals.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sub_033_ecology_05",
      "hash64": "A5F7034293C639FB",
      "text": "Tera Raid crystals that get hit by especially strong\\nblasts of this energy are apparently transforming\\r\\ninto [VAR 0xFF00(0006)]black crystals[VAR 0xFF00(0000)].[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 102,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_033_ecology_06",
      "hash64": "A5F7044293C63BAE",
      "text": "The Tera Pokémon found at these black crystals\\nare incredibly powerful...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_033_ecology_07",
      "hash64": "A5F7054293C63D61",
      "text": "So much so that average Trainers wouldn’t stand\\na chance against them.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_033_ecology_08",
      "hash64": "A5F6FE4293C6317C",
      "text": "[VAR 0xBD06(0000)]You’re anything but average, but I’m afraid this is\\ntoo dangerous—even for you,\\r\\n[VAR 0x0100(0000)].[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_033_ecology_09",
      "hash64": "A5F6FF4293C6332F",
      "text": "Even if you find the location of one of these\\nblack crystals on your map app, please do NOT—\\r\\nI repeat—DO NOT take on the Tera Raid there![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sub_033_select_01",
      "hash64": "742C174E87DE7A19",
      "text": "Got it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_033_select_02",
      "hash64": "742C144E87DE7500",
      "text": "I dunno...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_033_ecology_10",
      "hash64": "A5FA8C4293C9589D",
      "text": "Hmmm... You almost seem a little TOO willing to\\nagree.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_033_ecology_11",
      "hash64": "A5FA8B4293C956EA",
      "text": "I mean it! Don’t read into that like there’s some\\nkind of hidden meaning![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_033_ecology_12",
      "hash64": "A5FA8A4293C95537",
      "text": "Sorry for getting you involved in this only to ask\\nyou to step away, but...\\c\\nWhatever you do, do NOT go looking for these\\nblack crystals![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sub_033_ecology_13",
      "hash64": "A5FA894293C95384",
      "text": "I’m counting on you to make the right choice\\nhere![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
