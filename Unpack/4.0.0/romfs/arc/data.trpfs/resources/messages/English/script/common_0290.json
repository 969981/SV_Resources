          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0290_head_teacher_11",
      "hash64": "07EFCAD0D0DB131F",
      "text": "Of course, your Pokémon partners will be there\\nto help you.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
