        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_0290_head_teacher_02",
      "hash64": "07F34DD0D0DE278F",
      "text": "Well then, it’s time that I explained your\\nindependent study assignment.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
