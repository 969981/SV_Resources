    },
    {
      "ordinal": 8,
      "label": "common_0290_head_teacher_09",
      "hash64": "07F356D0D0DE36DA",
      "text": "and get to know the people, too.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
