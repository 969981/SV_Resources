      "ordinal": 7,
      "label": "common_0290_head_teacher_08",
      "hash64": "07F357D0D0DE388D",
      "text": "discover the Pokémon that live here...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
