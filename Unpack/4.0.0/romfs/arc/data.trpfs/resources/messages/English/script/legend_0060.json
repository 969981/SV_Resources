          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "legend_0060_friend_b",
      "hash64": "86796B4619E262DD",
      "text": "Well, apparently [VAR 0xFF00(0006)]Salty Herba Mystica[VAR 0xFF00(0000)] helps with\\naching hands and feet. Good for neuropathy and\\r\\nnumbness.\\c\\nWhen you’ve got muscle weakness, it supposedly\\nbuilds up strength again![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
