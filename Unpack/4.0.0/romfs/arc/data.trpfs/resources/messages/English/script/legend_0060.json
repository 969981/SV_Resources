      "ordinal": 3,
      "label": "legend_0060_friend_04",
      "hash64": "63BD251DFC8F1209",
      "text": "OK! Let’s see what the book has to say...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
