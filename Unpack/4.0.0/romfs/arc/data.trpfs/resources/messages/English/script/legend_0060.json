    {
      "ordinal": 4,
      "label": "legend_0060_friend_a",
      "hash64": "8679684619E25DC4",
      "text": "It says here that the [VAR 0xFF00(0006)]Sweet Herba Mystica[VAR 0xFF00(0000)] is good\\nfor gut health and that it helps aid digestion.\\c\\nSays it’s great for stomachaches, too, or when\\nyou want to stimulate the ol’ appetite![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
