        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_honoo_010_sitappa_02",
      "hash64": "0EBFEFCAF3C69DBE",
      "text": "If you don’t clear out real quick-like, I’ll hafta\\ncome at you in self-defense. You get me?[VAR 0x0114(002F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_honoo_010_select_01",
      "hash64": "F2512E54849FE70F",
      "text": "I’m not turning back!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "ajito_honoo_010_select_02",
      "hash64": "F2512F54849FE8C2",
      "text": "All right, I’ll leave...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "ajito_honoo_010_sitappa_03",
      "hash64": "0EBFF0CAF3C69F71",
      "text": "Right answer, kid. Hasta la vistaaar! ☆[VAR 0x0114(002F)]",
