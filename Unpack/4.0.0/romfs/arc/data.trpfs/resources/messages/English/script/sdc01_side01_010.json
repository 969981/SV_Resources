      ]
    },
    {
      "ordinal": 36,
      "label": "sdc01_side01_010_brother_21",
      "hash64": "F25ACEE6987A1A0E",
      "text": "It’s called Koraidon? And you ride on it, huh...?\\nI’ve never seen another Pokémon like this...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
