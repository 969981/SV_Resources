        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc01_side01_010_brother_22",
      "hash64": "F25ACDE6987A185B",
      "text": "It’s called Miraidon? And you ride on it, huh...?\\nI’ve never seen another Pokémon like this...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
