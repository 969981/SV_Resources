      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "sdc01_side01_010_select_06",
      "hash64": "E2B4A3FA0E7401E3",
      "text": "This is my ride. It’s called [VAR 0x1107(00FF,0202)]KoMiraidon!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
