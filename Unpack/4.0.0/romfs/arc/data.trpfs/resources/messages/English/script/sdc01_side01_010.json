          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_side01_010_brother_17",
      "hash64": "F25DD0E6987C534B",
      "text": "Y’know...I didn’t wanna have to come do this\\nwhole school trip thing, but...well...it might\\r\\nactually be kinda fun...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
