    },
    {
      "ordinal": 29,
      "label": "sdc01_side01_010_brother_18",
      "hash64": "F25DCDE6987C4E32",
      "text": "I get to be out in nature around my hometown...\\nand talk to you, [VAR 0x0100(0000)]...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
