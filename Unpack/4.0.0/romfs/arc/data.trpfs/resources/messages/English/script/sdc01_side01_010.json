    },
    {
      "ordinal": 33,
      "label": "sdc01_side01_010_select_05a",
      "hash64": "ACF84BE68F22BCB5",
      "text": "A “kaiju”? This is Koraidon!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "sdc01_side01_010_select_05b",
      "hash64": "ACF848E68F22B79C",
      "text": "A “kaiju”? This is Miraidon!",
      "flags": 4,
