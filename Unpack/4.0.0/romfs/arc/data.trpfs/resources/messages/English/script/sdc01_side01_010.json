    },
    {
      "ordinal": 30,
      "label": "sdc01_side01_010_brother_19",
      "hash64": "F25DCEE6987C4FE5",
      "text": "H-hey, if you want, maybe we could set up a\\npicnic. Would you like a sandwich—?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
