    {
      "ordinal": 0,
      "label": "sdc01_side01_010_brother_01",
      "hash64": "F2613AE6987F3D40",
      "text": "That’s the first signboard...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
