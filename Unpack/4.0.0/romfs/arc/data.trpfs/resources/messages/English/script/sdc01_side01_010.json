      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "sdc01_side01_010_brother_20",
      "hash64": "F25ACFE6987A1BC1",
      "text": "Gyah! Wh-what is that thing?! Some kinda...kaiju\\nor somethin’?![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
