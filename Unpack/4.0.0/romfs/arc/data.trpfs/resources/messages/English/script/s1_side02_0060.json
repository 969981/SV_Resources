    {
      "ordinal": 17,
      "label": "s1_side02_0060_camera_13",
      "hash64": "4431A4A6423827DD",
      "text": "[VAR 0xBD06(0000)]Well then! Nice to officially meet you,\\n[VAR 0x0100(0000)].[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
