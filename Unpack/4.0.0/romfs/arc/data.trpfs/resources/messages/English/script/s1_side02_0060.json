            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_side02_0060_camera_01",
      "hash64": "443526A6423B3A9A",
      "text": "I’ve been waiting for you to come by, partner![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_side02_0060_camera_02",
      "hash64": "443525A6423B38E7",
      "text": "I managed to develop the photos I took of the\\nBloodmoon Beast![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_side02_0060_select_01",
      "hash64": "75749C56FDB0EFAB",
      "text": "Show me!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_side02_0060_select_02",
      "hash64": "75749D56FDB0F15E",
      "text": "How do they look?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0060_camera_03",
      "hash64": "443524A6423B3734",
      "text": "Oh, well, fact is that once I got them all printed\\nout, I could see that the photos I managed to get\\r\\nare all blurry or cut off or out of focus...[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_side02_0060_camera_04",
      "hash64": "443523A6423B3581",
      "text": "They really aren’t good enough to show anyone—\\nnot even you, partner.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_side02_0060_camera_05",
      "hash64": "443522A6423B33CE",
      "text": "But still...\\c\\nOut of all the photos I’ve ever taken, I think they\\nmay be my favorites.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_side02_0060_camera_06",
      "hash64": "443521A6423B321B",
      "text": "I think I’d gotten too caught up in my own head.\\nWorrying about framing or what judges might say,\\r\\nalways thinking about what I ought to capture...[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_side02_0060_camera_07",
      "hash64": "443520A6423B3068",
      "text": "But just capturing your subjects as they are—\\nthat’s what photos should be![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_side02_0060_camera_08",
      "hash64": "44351FA6423B2EB5",
      "text": "You taught me something important, partner.\\nSo...thanks for that.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_side02_0060_camera_09",
      "hash64": "44351EA6423B2D02",
      "text": "Ah! That’s right! Your name! I never even asked\\nyou your name, partner![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_side02_0060_camera_10",
      "hash64": "4431A1A6423822C4",
      "text": "I know that’s awful of me, after all you did to\\nhelp, but...mind teaching me your name?[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_side02_0060_select_03",
      "hash64": "75749E56FDB0F311",
      "text": "You can call me [VAR 0x0100(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_side02_0060_select_04",
      "hash64": "75749F56FDB0F4C4",
      "text": "...My name is [VAR 0x0100(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_side02_0060_camera_11",
      "hash64": "4431A2A642382477",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)]! A perfect name for a\\ngutsy\\r\\nkid\\r\\nlike you![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
