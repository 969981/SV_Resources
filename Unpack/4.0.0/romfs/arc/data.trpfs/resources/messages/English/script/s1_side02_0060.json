            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_side02_0060_camera_12",
      "hash64": "4431A3A64238262A",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)]! But what’s with\\nthat\\r\\ndark\\r\\nlook?\\r\\nDon’t\\r\\nwant\\r\\nme\\r\\nto\\r\\nknow\\r\\nyour\\r\\nname\\r\\nor\\r\\nsomething?[VAR 0x0114(0046)]",
