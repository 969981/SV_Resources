  "entries": [
    {
      "ordinal": 0,
      "label": "s1_side02_0060_camera_boxfull",
      "hash64": "1C4DAAE9C41D0D4B",
      "text": "Hey, partner! Looks like you’re full up on\\nPokémon, huh? No room in your party or Boxes!\\c\\nLook, I’m trying to keep it a surprise here, but\\ntrust me when I say you’ll want to make some\\r\\nroom in your Boxes, then come talk to me again![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 185,
          "count": 1,
