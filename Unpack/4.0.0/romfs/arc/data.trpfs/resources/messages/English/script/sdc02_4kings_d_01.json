      "ordinal": 5,
      "label": "sdc02_4kings_d_01_clerk_04",
      "hash64": "743802B7EE2567D8",
      "text": "A-are you sure, Drayster? The rules say—",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
