      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 54,
      "label": "sub_001_keeper_09",
      "hash64": "B1C24CED006DC4F2",
      "text": "OK! The Sunflora say they’re all ready for you!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "sub_001_keeper_10",
      "hash64": "B1BF4FED006B9434",
      "text": "There are [VAR 0x0201(0001)] Sunflora left to find in town.",
      "flags": 0,
