    },
    {
      "ordinal": 46,
      "label": "sub_001_keeper_01",
      "hash64": "B1C254ED006DD28A",
      "text": "Congratulations on defeating the Artazon Gym!\\nI must say, the Gym Badge suits you very well.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 47,
      "label": "sub_001_keeper_02",
      "hash64": "B1C253ED006DD0D7",
      "text": "[EMPTY 87]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0057"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sub_001_keeper_03",
      "hash64": "B1C252ED006DCF24",
      "text": "You sure did a great job finding the Sunflora\\naround town during your Gym Test.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 49,
      "label": "sub_001_keeper_04",
      "hash64": "B1C251ED006DCD71",
      "text": "And it’s not just me who thinks that—the Sunflora\\nwere very impressed as well!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 50,
      "label": "sub_001_keeper_05",
      "hash64": "B1C250ED006DCBBE",
      "text": "So would you like to join us a little longer for\\nanother game of Sunflora Hide-and-Seek?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "sub_001_keeper_06",
      "hash64": "B1C24FED006DCA0B",
      "text": "Sunflo-radical! Now the Sunflora will have even\\nmore reason to smile nice and bright!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "sub_001_keeper_07",
      "hash64": "B1C24EED006DC858",
      "text": "I’ll go ahead and ask them to spread themselves\\nout around town!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "sub_001_kimawari_06",
      "hash64": "27112C7578B3DB4C",
