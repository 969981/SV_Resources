    {
      "ordinal": 42,
      "label": "sub_001_kimawari_02",
      "hash64": "2711287578B3D480",
      "text": "You found a Sunflora!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "sub_001_kimawari_03",
      "hash64": "2711297578B3D633",
      "text": "You’ve found [VAR 0x0201(0001)] Sunflora in total! Time to bring\\n[VAR 0x1101(0001,0402)]itthem to the Sunflora Lawn.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
