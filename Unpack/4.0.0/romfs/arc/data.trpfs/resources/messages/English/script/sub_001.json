            "0001",
            "0402"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sub_001_kimawari_04",
      "hash64": "27112E7578B3DEB2",
      "text": "You’ve found all the Sunflora in town! Time to\\nbring them to the Sunflora Lawn.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
