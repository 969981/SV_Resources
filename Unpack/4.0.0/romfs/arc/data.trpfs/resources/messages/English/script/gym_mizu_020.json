          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_mizu_020_receptionist_03",
      "hash64": "5A1F63160267B2A5",
      "text": "[EMPTY 67]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_mizu_020_trainer_01a",
      "hash64": "033215E8AA805C80",
      "text": "What? YOU again?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mizu_020_mizu_26",
      "hash64": "93117A305CF60F00",
      "text": "Vaultin’ Veluza! Where?! Where in the world...?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_mizu_020_mizu_27",
      "hash64": "93117B305CF610B3",
      "text": "Where in the world is my wallet?![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_mizu_020_mizu_28",
      "hash64": "931188305CF626CA",
      "text": "Without my wallet, I won’t be able to get today’s\\nhot item! It’ll get bought up by someone else![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_mizu_020_mizu_29",
      "hash64": "931189305CF6287D",
      "text": "*sniffle*[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mizu_020_trainer_01b",
      "hash64": "033218E8AA806199",
      "text": "Don’t worry, ol’ man Kofu! I’ll run and look for it\\nright now!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_020_trainer_02",
      "hash64": "0B79F51B0482ECC8",
      "text": "Whaddya want? Ol’ man Kofu’s in the middle of\\nsome superduper important ingredient buyin’!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_020_trainer_03",
      "hash64": "0B79F61B0482EE7B",
      "text": "If yer thinkin’ about tryin’ to interrupt him, then\\nI—his best apprentice—will have to stop you!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_020_trainer_04",
      "hash64": "0B79FB1B0482F6FA",
      "text": "So do ya have somethin’ super important to\\nsay to us busy folks, or what?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_020_select_a",
      "hash64": "3ECD48AC469CDCAC",
      "text": "This is super important!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_020_select_b",
      "hash64": "3ECD4BAC469CE1C5",
      "text": "Uh, I guess it’s not that important...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_020_trainer_05",
      "hash64": "0B79FC1B0482F8AD",
      "text": "Don’t bother us with somethin’ unimportant! Run\\nback on home now, y’hear!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_020_trainer_06",
      "hash64": "0B79F91B0482F394",
      "text": "Super important, eh? We’ll see about that!\\nMaybe a battle will shut yer mouth!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_020_trainer_07",
      "hash64": "0B79FA1B0482F547",
      "text": "Dangit! That backfired... And now my wallet’s\\nempty, too!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "gym_mizu_020_mizu_01",
      "hash64": "930AF5305CF0C153",
      "text": "Heya, step right up...and tell me—what’s all the\\nruckus about over here?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_mizu_020_trainer_08",
      "hash64": "0B79EF1B0482E296",
      "text": "O-ol’ man Kofu! Seems this kid’s got somethin’\\nto say to ya.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "gym_mizu_020_mizu_02",
      "hash64": "930AF6305CF0C306",
      "text": "What’s that, now? A customer here for little ol’\\nwalletless, moneyless me? What kin I do for ya?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_mizu_020_select_01",
      "hash64": "54C29DBBFD75281A",
      "text": "I have your wallet!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "gym_mizu_020_select_02",
      "hash64": "54C29CBBFD752667",
      "text": "You forgot this!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "gym_mizu_020_system_01",
      "hash64": "C22350BAFFC104CD",
      "text": "You returned Kofu’s wallet to him!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "gym_mizu_020_mizu_03",
      "hash64": "930AF7305CF0C4B9",
      "text": "Vaultin’ Veluza! My wallet![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_mizu_020_mizu_04",
      "hash64": "930AF8305CF0C66C",
      "text": "Say what, now? My lobby staffer sent ya out here\\nto bring it to me?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_mizu_020_mizu_05",
      "hash64": "930AF9305CF0C81F",
      "text": "Gahaha! That’s a huge help! Thanks for comin’\\nall this way![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_mizu_020_mizu_06",
      "hash64": "930AFA305CF0C9D2",
      "text": "I guess I should apologize for my li’l apprentice,\\ntoo. Hope he didn’t bother ya too much![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "gym_mizu_020_mizu_07",
      "hash64": "930AFB305CF0CB85",
      "text": "There’s somethin’ here at the Porto Marinada\\n[VAR 0xFF00(0006)]auction[VAR 0xFF00(0000)] that we really wanna get our hands on.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "gym_mizu_020_mizu_08",
      "hash64": "930AFC305CF0CD38",
      "text": "So, as you kin imagine, we were both a bit\\nworked up to find I’d forgotten my wallet![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "gym_mizu_020_shop_01",
      "hash64": "4C49FA89878568CE",
      "text": "Ladies and gents! You won’t wanna miss this!\\nHere comes today’s last item!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "gym_mizu_020_mizu_09",
      "hash64": "930AFD305CF0CEEB",
      "text": "Hmmm?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "gym_mizu_020_shop_02",
      "hash64": "4C49F9898785671B",
      "text": "Feast yer eyes on the main event! I have ’ere the\\nlegendary wakame seaweed of the Hoenn region!\\r\\nDo I have any takers?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "gym_mizu_020_mizu_10",
      "hash64": "930E7A305CF3D929",
      "text": "Vaultin’ Veluza![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "gym_mizu_020_mizu_11",
      "hash64": "930E79305CF3D776",
      "text": "I don’ even have to touch it—I can see it’s got the\\nspringy texture of seaweed chock-full o’ nutrients![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "gym_mizu_020_mizu_12",
      "hash64": "930E78305CF3D5C3",
      "text": "An’ just look at it! Look how it catches the light\\nand shines so brilliantly![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_mizu_020_mizu_13",
      "hash64": "930E77305CF3D410",
      "text": "Ohhh, and that rich, fresh aroma of somethin’\\nplucked straight outta the ocean![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "gym_mizu_020_mizu_14",
      "hash64": "930E7E305CF3DFF5",
      "text": "I need to get me some o’ that![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "gym_mizu_020_mizu_15",
      "hash64": "930E7D305CF3DE42",
      "text": "Now listen, kid. If you wanna challenge me at the\\nCascarrafa Gym, you’re gonna need some smarts.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "gym_mizu_020_mizu_16",
      "hash64": "930E7C305CF3DC8F",
      "text": "And this is the perfect place to test ya! Get the\\nwinnin’ bid on that seaweed for this ol’ man![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "gym_mizu_020_select_03",
      "hash64": "54C29BBBFD7524B4",
      "text": "What’s a “winning bid”?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "gym_mizu_020_select_04",
      "hash64": "54C29ABBFD752301",
      "text": "OK! I’ll give it my best shot!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "gym_mizu_020_mizu_17",
      "hash64": "930E7B305CF3DADC",
      "text": "Well, ya see...here at the auction, you gotta\\ncompete with other customers for goods!\\c\\nYou gotta be aware of how much money ya have,\\no’ course, but the person who bids the highest\\r\\nprice gets to buy whatever’s on sale![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 181,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 222,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "gym_mizu_020_mizu_18",
