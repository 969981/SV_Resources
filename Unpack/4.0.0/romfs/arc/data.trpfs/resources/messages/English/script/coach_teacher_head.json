          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "coach_teacher_head_randomtalk_02",
      "hash64": "E7F34E7502756660",
      "text": "If you’re looking for Director Cyrano, I believe I\\nsaw him over by the academy’s entrance.\\c\\nI do hope he’s paying due attention to the\\nacademy’s administrative affairs and not just\\r\\nlounging about all day...[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
