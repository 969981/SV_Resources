    },
    {
      "ordinal": 62,
      "label": "coach_teacher_head_randomtalk_01",
      "hash64": "E7F3517502756B79",
      "text": "I purposefully gave no firm deadline for students\\nto complete their Treasure Hunt.\\c\\nFeel free to continue pursuing your adventures\\nwherever your heart takes you.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
