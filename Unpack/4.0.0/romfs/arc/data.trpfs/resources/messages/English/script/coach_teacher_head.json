    },
    {
      "ordinal": 61,
      "label": "coach_teacher_head_randomtalk_00",
      "hash64": "E7F35075027569C6",
      "text": "Sprigatito, Fuecoco, and Quaxly are all rather\\neasy to care for and raise.\\c\\nThat’s why we chose those three as the partner\\nPokémon to be given to students who enroll in\\r\\nour academy.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
