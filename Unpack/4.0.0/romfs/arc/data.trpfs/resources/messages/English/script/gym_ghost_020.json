    },
    {
      "ordinal": 49,
      "label": "gym_ghost_020_ghost_03",
      "hash64": "38CC8D00F77B221B",
      "text": "Lemme tell ya what I wanna hear—y’all feelin’\\ngood?![VAR 0x0114(001B)]",
