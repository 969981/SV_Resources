    },
    {
      "ordinal": 46,
      "label": "gym_ghost_020_mobs_03",
      "hash64": "FF74B7E15C0EF8DF",
      "text": "Ryme! Ryme! Ryme! Ryme! Ryme! Ryme!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 47,
      "label": "gym_ghost_020_ghost_01",
      "hash64": "38CC8F00F77B2581",
      "text": "What’s all this noise I’m hearin’?![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
