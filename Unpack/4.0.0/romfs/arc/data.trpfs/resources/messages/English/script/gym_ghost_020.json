          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "gym_ghost_020_mobs_04",
      "hash64": "FF74B4E15C0EF3C6",
      "text": "Yeah! We’re feelin’ good! Ryme! Ryme! Ryme!\\nRyme! Woooooo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "gym_ghost_020_ghost_04",
      "hash64": "38CC9200F77B2A9A",
      "text": "Thanks for the killer opener, baby! Now I’ll get\\nthis started for real.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
