        }
      ]
    },
    {
      "ordinal": 45,
      "label": "gym_ghost_020_mc_16",
      "hash64": "75CC525A7E85FAA0",
      "text": "Give it up for the MC of RIP! Ryyyyyyyyyme![VAR 0x0114(003B)]",
