      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "gym_ghost_020_mobs_02",
      "hash64": "FF74B6E15C0EF72C",
      "text": "How lucky! That was a rare sight!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "gym_ghost_020_mc_13",
      "hash64": "75CC575A7E86031F",
      "text": "Thank yooou, [VAR 0x0100(0000)]!\\c\\nCongratulations, you passed the Gym Test! Give\\n’em a round of applause, everybody![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
