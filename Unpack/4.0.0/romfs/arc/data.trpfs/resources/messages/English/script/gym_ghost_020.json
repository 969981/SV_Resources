          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "gym_ghost_020_mc_15",
      "hash64": "75CC555A7E85FFB9",
      "text": "C’mon, everybody—say it with me! This is what\\nyou’ve all been waitin’ for...[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
