      ]
    },
    {
      "ordinal": 43,
      "label": "gym_ghost_020_mc_14",
      "hash64": "75CC545A7E85FE06",
      "text": "I feel a scary-good sense of unity in the crowd!\\nPerfecto! We’re ready to go for the main event![VAR 0x0114(003B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
