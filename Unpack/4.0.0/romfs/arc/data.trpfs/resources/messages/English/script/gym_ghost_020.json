      ]
    },
    {
      "ordinal": 52,
      "label": "gym_ghost_020_mc_17",
      "hash64": "75CC535A7E85FC53",
      "text": "Congrats on the Gym Test! That was sick, yo.\\nThanks![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
