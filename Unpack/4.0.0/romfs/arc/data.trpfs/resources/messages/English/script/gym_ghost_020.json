    },
    {
      "ordinal": 39,
      "label": "gym_ghost_020_system_03",
      "hash64": "A6867EAD00458329",
      "text": "The audience’s excitement has reached a fever\\npitch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "gym_ghost_020_mobs_01",
      "hash64": "FF74B9E15C0EFC45",
      "text": "Whoa! Awesome! That was a great battle!",
