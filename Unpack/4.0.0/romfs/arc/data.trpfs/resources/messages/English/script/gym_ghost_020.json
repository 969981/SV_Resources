    },
    {
      "ordinal": 38,
      "label": "gym_ghost_020_mc_31",
      "hash64": "75C54D5A7E7FD373",
      "text": "Bein’ an MC isn’t my only forte—I can battle too!\\nI’ll sledge ya up real good in a Double Battle![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
