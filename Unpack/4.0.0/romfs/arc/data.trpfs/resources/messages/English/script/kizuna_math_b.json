        {
          "kind": "control",
          "offset_units": 152,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_b_10",
      "hash64": "A8722193E1A7ADB3",
      "text": "Perhaps one of my students is quietly watching\\nme, waiting for a chance to ask me a question?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
