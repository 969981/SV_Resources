          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_b_07",
      "hash64": "A86EB693E1A4C20B",
      "text": "Recently, there have been times when I feel as if\\nI am being watched...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_b_08",
      "hash64": "A86EB393E1A4BCF2",
      "text": "Not by a Pokémon, mind you, but by a person.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_b_09",
      "hash64": "A86EB493E1A4BEA5",
      "text": "I thought it might be a ghost, so I tried asking my\\nsister for help. She said it most likely isn’t one.\\r\\nShe’s good with Ghost-type Pokémon, you know.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 103,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
