      "ordinal": 12,
      "label": "kizuna_math_b_select_03",
      "hash64": "CA217EEB2A79A0B2",
      "text": "That might be it",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_b_select_04",
      "hash64": "CA2179EB2A799833",
      "text": "Hmmm. Maybe?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
