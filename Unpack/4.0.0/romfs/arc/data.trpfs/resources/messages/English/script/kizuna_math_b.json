    {
      "ordinal": 4,
      "label": "kizuna_math_b_select_01",
      "hash64": "CA217CEB2A799D4C",
      "text": "No, I wasn’t",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_b_select_02",
