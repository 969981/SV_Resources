        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_b_06",
      "hash64": "A86EB593E1A4C058",
      "text": "You see... Oh, how should I put this?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
