    {
      "ordinal": 2,
      "label": "kizuna_math_b_03",
      "hash64": "A86EBA93E1A4C8D7",
      "text": "Please forgive me if this is an...odd question.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
