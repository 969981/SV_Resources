      ]
    },
    {
      "ordinal": 33,
      "label": "sdc02_0060_headbb_09",
      "hash64": "A14510385BCF0D63",
      "text": "Now what was it? I’ve plumb forgotten.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
