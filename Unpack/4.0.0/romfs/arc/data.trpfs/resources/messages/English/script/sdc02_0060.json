    {
      "ordinal": 49,
      "label": "sdc02_0060_fairybb_30",
      "hash64": "8265CF3D93881038",
      "text": "Wait, sir, you don’t—[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
