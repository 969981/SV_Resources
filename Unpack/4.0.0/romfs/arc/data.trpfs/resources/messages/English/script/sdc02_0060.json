      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "sdc02_0060_fairybb_23",
      "hash64": "8269523D938B24A8",
      "text": "Oh! It looks like you’re just in time to see a class\\nsession too![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
