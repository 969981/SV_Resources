          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "sdc02_0060_fairybb_29",
      "hash64": "82694C3D938B1A76",
      "text": "So, yup, that settles it! Please find your way to\\nthe class site in the Coastal Biome on your own![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sdc02_0060_headbb_10",
      "hash64": "A1489D385BD232D1",
      "text": "Well, doesn’t seem like I’m needed here.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
