          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "sdc02_0060_fairybb_31",
      "hash64": "8265D03D938811EB",
      "text": "And there he goes...[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
