      ]
    },
    {
      "ordinal": 34,
      "label": "sdc02_0060_headbb_16",
      "hash64": "A1489F385BD23637",
      "text": "Briar put all of it together, so I’m not certain\\nmyself.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
