      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0060_fairybb_24",
      "hash64": "8269593D938B308D",
      "text": "[VAR 0xBD06(0000)]This is too good of a chance to pass up. Won’t\\nyou join us, [VAR 0x0100(0000)]?\\r\\nYou\\r\\ncan\\r\\nget\\r\\nyour\\r\\nfirst\\r\\ntaste\\r\\nof\\r\\nour\\r\\nschool’s\\r\\nclasses.[VAR 0x0114(0049)]",
