    },
    {
      "ordinal": 35,
      "label": "sdc02_0060_fairybb_22",
      "hash64": "8269533D938B265B",
      "text": "That’s...what I thought you might say.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
