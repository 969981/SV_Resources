      ]
    },
    {
      "ordinal": 34,
      "label": "s2_sub_008_doku_08",
      "hash64": "20C026EA316F3C17",
      "text": "Lady Mela declared her wish to stretch her legs\\nminutes afore your arrival.\\c\\nShe departed rather suddenly and has not\\nreturn’d since.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
