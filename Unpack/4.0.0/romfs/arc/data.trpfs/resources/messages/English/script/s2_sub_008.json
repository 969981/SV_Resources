    {
      "ordinal": 33,
      "label": "s2_sub_008_kakutou_10",
      "hash64": "0C96315883EAC863",
      "text": "Hey guys? We seem to have lost Mellie...\\nWhere’d she go?[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
