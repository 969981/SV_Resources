    {
      "ordinal": 0,
      "label": "s2_sub_008_aku_01",
      "hash64": "4368CB59C86522FC",
      "text": "You all set to tutor the other Team Star bosses\\nup to test-bossin’ level?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
