    {
      "ordinal": 15,
      "label": "s2_sub_008_select_02",
      "hash64": "ED56BC93D31EFDC6",
      "text": "It’s your tutor!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s2_sub_008_fairy_02",
      "hash64": "BB429D3E873D68D3",
      "text": "YOU?! What the—? Noooooo no no no, why is\\nthis happening?![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_sub_008_doku_05",
      "hash64": "20C019EA316F2600",
      "text": "Ah. I should have surmis’d as much. The strength\\nof thy spirit precedes thee as ever, good [VAR 0x1100(00FF,0406)]fellowlady.[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 3,
