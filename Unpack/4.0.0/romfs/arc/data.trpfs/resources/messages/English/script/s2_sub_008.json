          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_sub_008_aku_02",
      "hash64": "4368CE59C8652815",
      "text": "Hey, don’t sweat it—we’re not goin’ anywhere.\\nCome on back whenever you’re ready.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_008_aku_03",
      "hash64": "4368CD59C8652662",
      "text": "Music to my ears! Let’s go lay down a killer\\nstudy sesh![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_008_kakutou_01",
      "hash64": "0C92CC5883E7E6ED",
      "text": "Are you free right now to help us with some\\ntutoring, [VAR 0x0100(0000)]?[VAR 0x0114(0022)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_008_kakutou_02",
      "hash64": "0C92C95883E7E1D4",
      "text": "No problem! We’re fine hanging out here for as\\nlong as it takes![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_008_kakutou_03",
      "hash64": "0C92CA5883E7E387",
      "text": "Fantastic! Come on, then—we’ll show you to the\\nclassroom.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_008_aku_04",
      "hash64": "4368C859C8651DE3",
      "text": "’Sup, gang! Studying hard, I hope?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_008_fairy_01",
      "hash64": "BB429E3E873D6A86",
      "text": "Well, we WERE before you and your big mouth\\nshowed up!\\c\\nHere to check we’re not slacking off, are you?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_008_aku_05",
      "hash64": "4368C759C8651C30",
      "text": "Pretty much. Your eyes start glazing over the\\nsecond I’m out the door. Tell me I’m wrong.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_008_doku_01",
      "hash64": "20C01DEA316F2CCC",
      "text": "Ah, Lady Eri clad in her academy uniform...[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_008_doku_02",
      "hash64": "20C020EA316F31E5",
      "text": "I feel mine eyes sharpen and my mind focus\\neach time this vision returns to greet me.[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_sub_008_kakutou_04",
      "hash64": "0C92C75883E7DE6E",
      "text": "If only that focus were helpful for your studies,\\nAtticus... Sorry I keep distracting you.[VAR 0x0114(0022)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_008_doku_03",
      "hash64": "20C01FEA316F3032",
      "text": "Oho? What’s this?! My ninja senses detect the\\npresence of another behind thee, Lady Eri![VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_008_doku_04",
      "hash64": "20C01AEA316F27B3",
      "text": "Come!!! Step forward, knave, that we might see\\nthy face![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_008_select_01",
      "hash64": "ED56BB93D31EFC13",
      "text": "It’s me—[VAR 0x0100(0000)]!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
