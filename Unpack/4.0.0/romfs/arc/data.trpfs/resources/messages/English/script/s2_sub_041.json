  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_041_system_01",
      "hash64": "592C7F97C3E6152F",
      "text": "You received [VAR 0x0204(0001,002C)] BP from Synclaire!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "0204",
          "args_hex": [
            "0001",
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_sub_041_synchro_01",
      "hash64": "86F82819633C9676",
      "text": "Ahhh, the euphoria of synchronization![VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_041_synchro_02",
      "hash64": "86F82719633C94C3",
      "text": "...Oh! Hello there.\\c\\nMy name is Synclaire. I’m quite the outstanding\\nresearcher, you know![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_041_synchro_03",
      "hash64": "86F82619633C9310",
      "text": "Would you like to help me out by participating in\\nan amazing experiment I’m working on?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_041_synchro_04",
      "hash64": "86F82D19633C9EF5",
      "text": "No?! But you’d bear witness to the greatest\\ndiscovery of the century![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_041_synchro_05",
      "hash64": "86F82C19633C9D42",
      "text": "[EMPTY 31]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_041_synchro_add_01",
      "hash64": "A20963AB7E34341A",
      "text": "That’s the spirit! Let’s head over to the test area,\\nthen![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_041_synchro_add_02",
      "hash64": "A20962AB7E343267",
      "text": "You’ll need to have a Pokémon out of its ball for\\nthis experiment.[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_041_synchro_add_03",
      "hash64": "A20961AB7E3430B4",
      "text": "Just let me know once you’re ready![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_041_synchro_add_04",
      "hash64": "A20960AB7E342F01",
      "text": "Are you ready to help me out with this amazing\\nexperiment?[VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_041_synchro_06",
      "hash64": "86F82B19633C9B8F",
      "text": "That’s the spirit! Let’s get this started, then...\\c\\nSynchroooooo...nize![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_sub_041_synchro_07",
      "hash64": "86F82A19633C99DC",
      "text": "Your mind and feelings are now synchronized\\nwith those of your Pokémon![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_041_synchro_08",
      "hash64": "86F83119633CA5C1",
      "text": "Now that you’re all synced up, your Pokémon will\\nmove as directed by your thoughts![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_041_synchro_09",
      "hash64": "86F83019633CA40E",
      "text": "Let’s start with a movement test. There’s a tree\\nin front of your Pokémon—try moving over there![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_041_synchro_10",
      "hash64": "86F4A31963397EA0",
      "text": "Ahhh, yes! You’re so in sync![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_041_synchro_11",
      "hash64": "86F4A41963398053",
      "text": "I was able to get some very useful data from that\\nsession. Thank you so much!\\c\\nHere’s a little something for your trouble.[VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_041_synchro_12",
      "hash64": "86F4A51963398206",
      "text": "You really have a talent for this! Would you mind\\nsticking around for just one more experiment?[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_sub_041_synchro_13",
      "hash64": "86F4A619633983B9",
      "text": "It’d be a bit more work than the last one, but I’ll\\ngive you something REALLY nice afterward![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_sub_041_synchro_14",
      "hash64": "86F4A7196339856C",
      "text": "Are you in the mood to help me out with my\\namazing experiment?[VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_sub_041_synchro_15",
      "hash64": "86F4A8196339871F",
      "text": "No?! But you’d be a pioneer participating in the\\nmost incredible discovery of the century![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_sub_041_synchro_16",
      "hash64": "86F4A919633988D2",
      "text": "OK then, here we go! Synchroooooo...nize![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_sub_041_synchro_17",
      "hash64": "86F4AA1963398A85",
      "text": "Your mind and feelings are synchronized with\\nthose of your Pokémon once again![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_041_synchro_18",
      "hash64": "86F4AB1963398C38",
      "text": "Since this is your second time synchronizing, you\\nshould be able to do all sorts of things![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_sub_041_synchro_19",
      "hash64": "86F4AC1963398DEB",
      "text": "So let’s begin the battle test! Try taking on some\\nof the other Pokémon in the area![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_sub_041_synchro_20",
      "hash64": "86FEB5196341F1BB",
      "text": "Ahhh, yes! You’ve got the best synchronization\\nI’ve ever seen![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_sub_041_synchro_21",
      "hash64": "86FEB4196341F008",
      "text": "I’m sure someone with your talent could put this\\namazing invention to good use![VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_sub_041_synchro_22",
      "hash64": "86FEB7196341F521",
      "text": "It’s still a prototype, so its design may look a\\nlittle...uninspiring.[VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_sub_041_synchro_23",
      "hash64": "86FEB6196341F36E",
      "text": "But you can use it to synchronize whenever you\\nwant! Try it out with lots of different Pokémon![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_sub_041_synchro_24",
      "hash64": "86FEB9196341F887",
      "text": "All right, we’ll pause the experiment for now...\\nCome back when you want to sync up again!\\c\\nHmm... Could this perhaps have put too much\\nstrain on h[VAR 0x1100(00FF,0202)]iser brain...?[VAR 0x0114(004E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0202"
          ]
        },
        {
          "kind": "control",
          "offset_units": 168,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s2_sub_041_synchro_25",
      "hash64": "86FEB8196341F6D4",
      "text": "Have you been using that Synchro Machine I\\ngave you?\\c\\nYou can sync with your Pokémon by pressing the\\nmachine’s L and R Buttons at the same time![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_sub_041_synchro_26",
      "hash64": "86FEBB196341FBED",
      "text": "Thank you for being such a keen synchronizer!\\nI’m putting the data you gathered to great use.\\c\\nHere, let me send you some BP for all your\\ncontributions to science![VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 165,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    }
  ]
