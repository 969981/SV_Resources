    {
      "ordinal": 17,
      "label": "class_e_01_battle_12",
      "hash64": "D91D0F7370DB878C",
      "text": "Physical moves do more damage the higher the\\nPokémon’s [VAR 0xFF00(0006)]Attack[VAR 0xFF00(0000)] stat is![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_e_01_battle_13",
      "hash64": "D91D107370DB893F",
      "text": "And special moves do more damage the higher\\nthe Pokémon’s [VAR 0xFF00(0006)]Sp. Atk[VAR 0xFF00(0000)] stat is![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
