          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_e_01_select_01",
      "hash64": "203A7942D4356DCE",
      "text": "Moves of light and moves of darkness",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_e_01_select_02",
      "hash64": "203A7842D4356C1B",
      "text": "Physical moves and special moves",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_e_01_select_03",
      "hash64": "203A7742D4356A68",
      "text": "Moves you love and moves you hate",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_e_01_battle_answer_01",
      "hash64": "ED6FCB063F1DCCF1",
      "text": "That’s not only wrong—it’s totally out there!\\c\\nAre you OK, new kid?! Or are you just at that\\nage where you’re really into fantasy stuff?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_e_01_battle_answer_02",
      "hash64": "ED6FC8063F1DC7D8",
      "text": "Awesome! You’re just as sharp as I expected, new\\nkid! Looks like you have a handle on the basics![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_e_01_battle_answer_03",
      "hash64": "ED6FC9063F1DC98B",
      "text": "That’s not only wrong—it’s kinda sad!\\c\\nAre you OK, new kid?! Or are you just at that\\nage where you’re really into bittersweet stuff?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
