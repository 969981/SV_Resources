    {
      "ordinal": 20,
      "label": "class_e_01_battle_15",
      "hash64": "D91D0E7370DB85D9",
      "text": "In conclusion![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_e_01_battle_16",
      "hash64": "D91D0B7370DB80C0",
      "text": "Pokémon that are good with [VAR 0xFF00(0006)]physical moves[VAR 0xFF00(0000)]\\nshould raise their [VAR 0xFF00(0006)]Attack[VAR 0xFF00(0000)] stat!\\c\\nAnd Pokémon that are good with [VAR 0xFF00(0006)]special moves[VAR 0xFF00(0000)]\\nshould raise their [VAR 0xFF00(0006)]Sp. Atk[VAR 0xFF00(0000)] stat![VAR 0x0114(0024)]",
