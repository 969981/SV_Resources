        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_e_01_battle_20",
      "hash64": "D91A0B7370D94AE9",
      "text": "We’ll generally meet for my class here in the\\nschoolyard—even for book learning!\\c\\nNothing like a little fresh air to make studying\\nmore fun, am I right?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
