    {
      "ordinal": 16,
      "label": "coach_gym_esper_sp02_02c",
      "hash64": "F7C0B797ACE36397",
      "text": "Perfecto! You got it—I’m a makeup artist!\\c\\nAlong with, of course, modeling on the side.\\nAnd Gym leading on the other side.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
