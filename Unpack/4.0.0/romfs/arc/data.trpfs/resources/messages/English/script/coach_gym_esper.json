          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_esper_sp02_03",
      "hash64": "FC431A675651BEA1",
      "text": "Not many people here know me, but when I tell\\nthem what I do, they perk right up.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_esper_sp02_04",
      "hash64": "FC431B675651C054",
      "text": "As well-known as the name Tulip is in Paldea,\\nhere no one knows me from the next flower.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_esper_sp02_05",
      "hash64": "FC431C675651C207",
      "text": "I’ve got to find a way to tastefully bottle the\\nsecret to my beauty. I’d love it if anyone in the\\r\\nworld could just buy the total package![VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_esper_sp03_00",
      "hash64": "CE890D60F3760F59",
      "text": "Do you remember the promise you made me,\\n[VAR 0x0100(0000)]?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_esper_sp03_01",
      "hash64": "CE890C60F3760DA6",
      "text": "Good on you, holding on to the advice your\\nelders give you![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_esper_sp03_01b",
      "hash64": "68EDCCBDB199640C",
      "text": "Hmmm. I’ll let you off the hook just this once,\\nsince it’s cute that you’re a little forgetful.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_esper_sp03_02",
      "hash64": "CE890B60F3760BF3",
      "text": "When you promised to never fade away, to show\\nme how far your talent can go...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_esper_sp03_03",
      "hash64": "CE890A60F3760A40",
      "text": "I never even dreamed you’d follow through this\\nbeautifully! I’m absolutely shook, darling![VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_gym_esper_sp03_04",
      "hash64": "CE891160F3761625",
