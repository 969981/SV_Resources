      "label": "coach_gym_esper_first_01",
      "hash64": "2D97FCDC3B58BD6E",
      "text": "Did someone order a little of my makeup magic?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
