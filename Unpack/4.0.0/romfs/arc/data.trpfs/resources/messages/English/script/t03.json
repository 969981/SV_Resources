  "entries": [
    {
      "ordinal": 0,
      "label": "t03_01",
      "hash64": "E3798BA06D461908",
      "text": "When your Pokémon are hurt, heal them!\\nWhen you see a shop, buy up supplies!\\c\\nThose habits are the key to happy adventuring.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "t03_03",
      "hash64": "E3798DA06D461C6E",
      "text": "We use this truck to transport the olives we grow.\\c\\nYou wouldn’t believe how busy things get come\\nharvest season!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "t03_14",
      "hash64": "E37602A06D42FA66",
      "text": "Oooh, these sweets they sell at Soapberry!\\nThey’re sooo good—and super popular!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "t03_15",
      "hash64": "E37603A06D42FC19",
      "text": "Our Gym Leader here in Cortondo is the battling\\nbaker herself, Katy!\\c\\nDon’t let her sweet looks fool you into letting\\ndown your guard!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "t03_16",
      "hash64": "E37600A06D42F700",
      "text": "You’ve come to Cortondo right in the middle of\\nour Olive Harvest Festival. The Gym Test here\\r\\nserves as a part of the festival, too!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "t03_17",
      "hash64": "E37601A06D42F8B3",
      "text": "Roll, roll, roll! Ta-da!\\c\\nTarountula wraps itself up in its string to protect\\nitself from attackers, y’know!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "t03_23",
      "hash64": "E372FDA06D40BC10",
      "text": "This is Cortondo. It’s a nice round-sounding\\nname, isn’t it? Like a lovely olive!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "t03_28",
      "hash64": "E37308A06D40CEC1",
      "text": "I’ve heard that Vivillon look different based on\\nwhere they’re from...\\c\\nSo I wonder where these fellows came from?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "t03_39",
      "hash64": "E36F83A06D3DB6EB",
      "text": "From here, you can enjoy a nice cup of tea while\\nwatching the Gym Leader battle challengers.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
