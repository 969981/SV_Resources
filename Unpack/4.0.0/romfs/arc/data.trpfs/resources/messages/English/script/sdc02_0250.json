      "ordinal": 14,
      "label": "sdc02_0250_bbteacher_03",
      "hash64": "703B8B8FDD7C20E4",
      "text": "Oh! You must be that Pokémon that was\\nreportedly first discovered in Area Zero![VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
