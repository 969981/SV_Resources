          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0250_sister_04",
      "hash64": "7EFDE2C60D8009A3",
      "text": "Wait, hold on. Doesn’t the “depths” imply he was\\nas deep as he could get?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
