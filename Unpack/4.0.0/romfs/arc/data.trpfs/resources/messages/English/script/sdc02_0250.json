      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc02_0250_bbteacher_06",
      "hash64": "703B888FDD7C1BCB",
      "text": "Heath mentioned in his writings that he fell from\\nthe depths to someplace even deeper.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
