      "ordinal": 23,
      "label": "sdc02_0250_bbteacher_09",
      "hash64": "703B858FDD7C16B2",
      "text": "If his writings are to be believed, there must be\\nan entire uncharted space below Area Zero...[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
