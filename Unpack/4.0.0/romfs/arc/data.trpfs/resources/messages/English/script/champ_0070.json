          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0070_top_05a",
      "hash64": "712CCDA64BA49717",
      "text": "Just what I hoped to hear. You have a rare talent,\\nespecially for your age.\\c\\nAim high—greater heights are within your reach.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
