          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0070_top_05b",
      "hash64": "712CCEA64BA498CA",
      "text": "Oh my, are you certain? You have a rare talent,\\nespecially for your age.\\c\\nIt’d be a shame for that talent to go to waste.[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
