          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0070_top_07",
      "hash64": "ED5B57300D1EFED2",
      "text": "I am Geeta, chairwoman of the Pokémon League,\\nthe organization that runs these Gyms.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0070_top_08",
      "hash64": "ED5B5A300D1F03EB",
      "text": "As you seem to be collecting Gym Badges,\\nI suspect we’ll meet again down the line.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
