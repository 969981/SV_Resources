    {
      "ordinal": 22,
      "label": "champ_0110_rival_15",
      "hash64": "ABD6094A13479ECB",
      "text": "You’re gonna become a Champion—no doubt\\nabout it, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
