      "ordinal": 14,
      "label": "champ_0110_rival_09",
      "hash64": "ABD9894A134AAE22",
      "text": "Let’s have us another fruitful battle![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
