    {
      "ordinal": 2,
      "label": "champ_0110_chairman_01",
      "hash64": "8710336AB703E937",
      "text": "Yes. You must face the Pokémon League.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
