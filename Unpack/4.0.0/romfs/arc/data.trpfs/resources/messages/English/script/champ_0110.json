        }
      ]
    },
    {
      "ordinal": 17,
      "label": "champ_0110_rival_10",
      "hash64": "ABD60C4A1347A3E4",
      "text": "Now even La Primera thinks you’re one to watch.\\nYou’ve got so much potential![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "champ_0110_rival_11",
      "hash64": "ABD60D4A1347A597",
      "text": "The way you’re going, I better watch my back![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
