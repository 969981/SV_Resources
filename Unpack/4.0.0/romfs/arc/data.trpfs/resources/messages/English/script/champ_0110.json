        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0110_chairman_04",
      "hash64": "87102E6AB703E0B8",
      "text": "Excuse me one moment.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
