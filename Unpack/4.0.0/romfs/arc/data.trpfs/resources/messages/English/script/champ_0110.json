          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0110_rival_03",
      "hash64": "ABD98F4A134AB854",
      "text": "Collecting eight Gym Badges sets you up to\\ntake the Champion Assessment.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0110_rival_04",
      "hash64": "ABD98E4A134AB6A1",
      "text": "If you can face the challenge of the final\\nexaminer and win, you’ll become a Champion![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0110_rival_19",
      "hash64": "ABD6054A134797FF",
      "text": "Just imagine how that moment would feel.\\nTry getting into that Champion mindset![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
