          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "champ_0110_rival_16",
      "hash64": "ABD60A4A1347A07E",
      "text": "The rest of these Gyms? You can take ’em!\\nHundred percent, no problem![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "champ_0110_chairman_08",
      "hash64": "87102A6AB703D9EC",
      "text": "I agree. In fact, you should take this. Consider it\\nan investment in your future.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "champ_0110_chairman_12",
      "hash64": "8713B66AB706FDA7",
      "text": "If a Pokémon uses that move while Terastallized,\\nthe move’s type will change to the Tera Type\\r\\nof the Pokémon.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
