    {
      "ordinal": 3,
      "label": "champ_0110_chairman_02",
      "hash64": "8710346AB703EAEA",
      "text": "It is located to the northwest of Mesagoza.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
