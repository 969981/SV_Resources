    {
      "ordinal": 15,
      "label": "champ_0110_chairman_06",
      "hash64": "8710306AB703E41E",
      "text": "An amazing display of talent, even against one\\nas skilled as Champion Nemona.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
