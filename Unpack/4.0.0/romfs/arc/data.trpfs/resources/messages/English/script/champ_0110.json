      "ordinal": 12,
      "label": "champ_0110_rival_07",
      "hash64": "ABD98B4A134AB188",
      "text": "Well, you should all be in great shape now thanks\\nto La Primera![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
