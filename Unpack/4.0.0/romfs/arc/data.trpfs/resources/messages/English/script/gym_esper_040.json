  "entries": [
    {
      "ordinal": 0,
      "label": "gym_esper_040_receptionist_00",
      "hash64": "1F919632251A1EC8",
      "text": "[VAR 0xBD06(0000)]Welcome to the Alfornada Gym,\\n[VAR 0x0100(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_esper_040_receptionist_01",
      "hash64": "1F919732251A207B",
      "text": "Are you ready to challenge Gym Leader Tulip,\\nthe Bewitching Beautician?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "gym_esper_040_receptionist_02",
      "hash64": "1F919832251A222E",
      "text": "Very well. Allow me to show you to the\\nbattle court.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_esper_040_receptionist_03",
      "hash64": "1F919932251A23E1",
      "text": "Of course. Please feel free to come speak to me\\nwhenever you’re ready.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_esper_040_esper_entry_01",
      "hash64": "EA01E71F5103C776",
      "text": "I suppose you’re right. OK, I’ll get things moving\\nhere on my end.[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_esper_040_esper_entry_02",
      "hash64": "EA01E61F5103C5C3",
      "text": "Let’s keep the tag line simple—\\n“Naturally Beautiful.”[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_esper_040_esper_entry_03",
      "hash64": "EA01E51F5103C410",
      "text": "And order the new eye-shadow color too,\\nwould you?[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_esper_040_esper_entry_04",
      "hash64": "EA01EC1F5103CFF5",
      "text": "Thanks, you’re a doll. Gotta run now. Chat with\\nyou later.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_esper_040_esper_01",
      "hash64": "A1A3806506F21EE3",
      "text": "Hello there.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_esper_040_esper_02",
      "hash64": "A1A3816506F22096",
      "text": "I’m Tulip, the Gym Leader here.\\c\\nThough I must tell you that being a makeup artist\\nis my main line of work.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_esper_040_esper_03",
      "hash64": "A1A3826506F22249",
      "text": "Dendra had nothing but praise for you. She said\\nyou totally slayed out there.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_esper_040_esper_04",
      "hash64": "A1A3836506F223FC",
      "text": "[VAR 0xBD06(0000)]Hehe. I must say, you are a cute challenger,\\n[VAR 0x0100(0000)].[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_esper_040_esper_05",
      "hash64": "A1A3846506F225AF",
      "text": "I’m sure my ESP exercise made you all the more\\nbeautiful. Doesn’t that make you happy?[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_esper_040_esper_06",
      "hash64": "A1A3856506F22762",
      "text": "You keep your Pokémon beautiful and clean as\\nwell. I see you have quite the aesthetic sense.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_esper_040_esper_06b",
      "hash64": "9B02AAAACD784500",
      "text": "[EMPTY 30]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_esper_040_esper_07",
      "hash64": "A1A3866506F22915",
      "text": "Appearance is equally important for both people\\nand Pokémon.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_esper_040_esper_08",
      "hash64": "A1A3876506F22AC8",
      "text": "Makeup is like magic. Anyone can use it to\\nchange their appearance.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_esper_040_esper_09",
      "hash64": "A1A3886506F22C7B",
      "text": "Allow me to put my skills to use to make your\\ncute little Pokémon even more beautiful![VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_esper_040_esper_10",
      "hash64": "A1A7056506F536B9",
      "text": "I lost the battle? And your beauty rivals even my\\nown? I can’t believe it.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_esper_040_esper_11",
      "hash64": "A1A7046506F53506",
      "text": "You are quite splendid. Yes, truly amazing![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_esper_040_esper_12",
      "hash64": "A1A7036506F53353",
      "text": "Perhaps I should take you under my wing before\\nyou make your big break elsewhere...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_esper_040_esper_13",
      "hash64": "A1A7026506F531A0",
      "text": "But I suppose I need to work on myself a little\\nmore first before I run off and do such a thing.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_esper_040_esper_14",
      "hash64": "A1A7096506F53D85",
      "text": "You have earned my Gym Badge. Allow me to\\nstrike one of my best poses to give it to you.\\r\\nCongratulations, [VAR 0x0100(0000)].[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_esper_040_esper_badge",
      "hash64": "4A010119989BC04B",
      "text": "With [VAR 0x0200(0001)] Gym Badge[VAR 0x1101(0001,0100)]s, Pokémon of up to Lv. [VAR 0x0201(0002)]\\nwill be easier to catch and will listen to the\\r\\ncommands you give them.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_esper_040_esper_badge_all",
      "hash64": "AD2165F57B02D8E7",
      "text": "With all 8 Gym Badges, you’ll be able to catch\\nPokémon of any level. They’ll be good Pokémon\\r\\nand listen to your commands, too.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_esper_040_esper_waza",
      "hash64": "799E8E5F8222D3D9",
      "text": "If you train hard, you’ll be able to use this move\\nin a totally perfect way.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_esper_040_esper_17",
      "hash64": "A1A7066506F5386C",
      "text": "Don’t go uploading that selfie we just took to\\nsocial media, OK?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "gym_esper_040_esper_15",
      "hash64": "A1A7086506F53BD2",
      "text": "I think my makeup has run a little with all the\\nmoving and sweating I did during our battle.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "gym_esper_040_esper_16",
      "hash64": "A1A7076506F53A1F",
      "text": "I need to fix it fast before my next appointment.\\nMy schedule is absolutely packed, you know.\\c\\nFarewell, then. You did splendidly today.[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "gym_esper_040_receptionist_04",
      "hash64": "1F919A32251A2594",
      "text": "Congratulations! You’re now certified by the\\nAlfornada Gym!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
