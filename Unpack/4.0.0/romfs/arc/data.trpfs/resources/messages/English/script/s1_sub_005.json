{
  "version": "4.0.0",
  "language": "en",
  "language_raw": "English",
  "source": "message/dat/English/script/s1_sub_005.dat",
  "paired_tbl": "message/dat/English/script/s1_sub_005.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_005_woman_01",
      "hash64": "89A243AD938D9F89",
      "text": "Ooohohoho! Ooohohoho![VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_005_woman_02",
      "hash64": "89A240AD938D9A70",
      "text": "What an utterly dull place! Not a thing worth\\nseeing![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_005_man_01",
      "hash64": "4B73FD52D1B10A3B",
      "text": "It’s just what I wanted! Thank you, Billy![VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_005_man_02",
      "hash64": "4B73FE52D1B10BEE",
      "text": "Wonderful! Nothing brings me more joy than\\nmaking you happy, dearest O’Nare![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_005_woman_03",
      "hash64": "89A241AD938D9C23",
      "text": "Perhaps I should buy up all this land and start\\nsome kind of business here...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_005_woman_04",
      "hash64": "89A246AD938DA4A2",
      "text": "Oh? Why, if it isn’t our dear commoner![VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_005_man_03",
      "hash64": "4B73FF52D1B10DA1",
      "text": "Your eyes do not deceive you—that is indeed our\\ndear commoner![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_005_man_04",
      "hash64": "4B740052D1B10F54",
      "text": "You really have a way of drawing people to you\\nwith your charming personality, dearest O’Nare![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_005_woman_05",
      "hash64": "89A247AD938DA655",
      "text": "Oooohohoho! I won’t say you’re wrong![VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_005_woman_06",
      "hash64": "89A244AD938DA13C",
      "text": "It’s our duty as Glitterati to make the dreams of\\nthe common folk a reality.[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_005_woman_07",
      "hash64": "89A245AD938DA2EF",
      "text": "Or more specifically, to give them fine items.[VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_005_woman_08",
      "hash64": "89A24AAD938DAB6E",
      "text": "Now, do pay attention, dear commoner. You\\nwould do well to search for riches in areas where\\r\\nthere appears to be nothing of value at all...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_005_woman_09",
      "hash64": "89A24BAD938DAD21",
      "text": "Possibilities are as vast as the ocean, no matter\\nwhere you go.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_005_man_05",
      "hash64": "4B740152D1B11107",
      "text": "S-striking! Your words are as pickaxe to rock,\\nloosing nuggets of wisdom from common stone![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_005_woman_10",
      "hash64": "89A5C8AD9390B75F",
      "text": "Come now, Billy! I have a major craving for [VAR 0xFF00(0006)]fruit[VAR 0xFF00(0000)]\\nonly the land of Kitakami can provide.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_005_man_06",
      "hash64": "4B740252D1B112BA",
      "text": "Pfwee! No sooner did we depart than we shall\\nreturn! You really are an exemplary Glitterati,\\r\\nmy dearest O’Nare![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_005_man_07",
      "hash64": "4B740352D1B1146D",
      "text": "Those Kitakami apples make the best apple juice,\\nyou know—I’ll whip some up for you![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_sub_005_secretary_01",
      "hash64": "B1E81E19EE3B0B01",
      "text": "Mr. Billy and Lady O’Nare are somewhere near\\nthe border between the South Province’s Area\\r\\nFive and Area One.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    }
  ]
}
