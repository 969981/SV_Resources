          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0130_reception_10",
      "hash64": "4DCCC847738F86E4",
      "text": "I’ll go ahead and mark their locations in your\\nRotom Phone now!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "sdc02_0130_reception_11",
      "hash64": "4DCCC947738F8897",
      "text": "To challenge the Elite Four, you’ll need [VAR 0xFF00(0006)]BP[VAR 0xFF00(0000)], which\\nyou can earn by doing [VAR 0xFF00(0006)]BBQs[VAR 0xFF00(0000)].\\c\\nThen, if you defeat all the members of the Elite\\nFour, you can challenge the Champion.",
