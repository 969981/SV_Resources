    },
    {
      "ordinal": 34,
      "label": "sdc02_0130_sister_08",
      "hash64": "EFBFCF4C5DEE8AEC",
      "text": "And please...keep an eye on Kiki for me.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
