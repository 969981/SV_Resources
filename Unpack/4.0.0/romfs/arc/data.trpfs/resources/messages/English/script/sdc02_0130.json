      ]
    },
    {
      "ordinal": 32,
      "label": "sdc02_0130_sister_06",
      "hash64": "EFBFD54C5DEE951E",
      "text": "I dunno, I think something fishy’s going on...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
