          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_ecology_d_03",
      "hash64": "652B149A7659F68B",
      "text": "Wow! Pokémon from the mountains! Pokémon\\nfrom the sea! Wait, what?! No way!\\r\\nYou even found Pokémon in a place like this?![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
