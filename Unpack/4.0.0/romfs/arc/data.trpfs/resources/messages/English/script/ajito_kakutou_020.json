          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_kakutou_020_cassiopeia_02",
      "hash64": "781BB9DBBA8A2ECF",
      "text": "That base is run by Team Star’s Fighting crew—\\nthe Caph Squad.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_kakutou_020_cassiopeia_03",
      "hash64": "781BB8DBBA8A2D1C",
      "text": "Their boss, Eri, is a skilled wrestler and coaches\\nthe whole of Team Star in Pokémon battling.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_kakutou_020_cassiopeia_04",
      "hash64": "781BB7DBBA8A2B69",
      "text": "Of all the bosses, she’ll likely be the most alert\\nto hostilities after our declaration of war.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_kakutou_020_cassiopeia_05",
      "hash64": "781BB6DBBA8A29B6",
      "text": "She might try to stop this raid in its tracks by\\nchallenging you to battle before anyone else.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_kakutou_020_select_01",
      "hash64": "27F32B7B4AAD33F3",
      "text": "You’re spot on!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_kakutou_020_select_02",
      "hash64": "27F32C7B4AAD35A6",
      "text": "Yeah, we already met",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "ajito_kakutou_020_cassiopeia_06",
      "hash64": "781BB5DBBA8A2803",
      "text": "I knew it! Tell me what happened![VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_kakutou_020_cassiopeia_07",
      "hash64": "781BB4DBBA8A2650",
      "text": "She...retreated?! We’re talking about the same\\nEri, right?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_kakutou_020_cassiopeia_08",
      "hash64": "781BC3DBBA8A3FCD",
      "text": "Well...it seems there’s nothing for it now but to\\nattack the base head on.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
