          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0010_headteacher_01",
      "hash64": "2F8FD4C3B7EC7BAA",
      "text": "Wait! Wait just a moment, Director Cyrano![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
