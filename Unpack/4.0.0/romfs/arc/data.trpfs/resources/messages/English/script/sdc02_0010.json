          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0010_headbb_08",
      "hash64": "1F17BF3F0FC0296F",
      "text": "Yep! That’s me—Director Cyrano. Er...did I not\\nmention that?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0010_headteacher_07",
      "hash64": "2F8FCEC3B7EC7178",
      "text": "One look at our young friend here makes me\\nsuspect you indeed failed to clarify that point.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0010_headteacher_08",
      "hash64": "2F8FCDC3B7EC6FC5",
      "text": "[VAR 0xBD06(0000)]Speaking of which... Why did you request\\nM[VAR 0x1100(00FF,0305)]asteriss [VAR 0x0100(0000)],\\r\\nspecifically,\\r\\nto\\r\\ntake\\r\\npart\\r\\nin\\r\\nyour\\r\\nexchange\\r\\nprogram?[VAR 0x0114(000A)]",
      "flags": 0,
