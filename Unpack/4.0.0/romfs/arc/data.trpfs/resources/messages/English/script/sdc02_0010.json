    {
      "ordinal": 5,
      "label": "sdc02_0010_headbb_04",
      "hash64": "1F17C33F0FC0303B",
      "text": "Well then. Now that you’re here, let’s get going![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
