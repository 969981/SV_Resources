          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0010_headbb_11",
      "hash64": "1F14423F0FBD1F31",
      "text": "[VAR 0xBD06(0000)]Oh, that’s right! The school trip to Kitakami!\\n[VAR 0x0100(0000)] met some of my\\r\\nstudents\\r\\nthere,\\r\\ndidn’t\\r\\n[VAR 0x1100(00FF,0100)]she?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
