          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0010_headbb_05",
      "hash64": "1F17C23F0FC02E88",
      "text": "Oh, hello there, Velly! You’re as lively as always.\\nDidn’t realize you were here![VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0010_headteacher_02",
      "hash64": "2F8FD3C3B7EC79F7",
      "text": "Of course I’m here! As director of this academy,\\nwhere else would I be?\\c\\nAnd do address me more properly while students\\nare present, would you?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0010_headteacher_03",
      "hash64": "2F8FD2C3B7EC7844",
      "text": "More importantly, what are you doing out here?\\nI thought we had agreed to meet in my office![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0010_headbb_06",
      "hash64": "1F17C53F0FC033A1",
      "text": "Did we? Must’ve slipped my mind![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0010_headbb_07",
      "hash64": "1F17C43F0FC031EE",
      "text": "Anyway, what’s it matter? This is the student,\\nright?[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0010_headteacher_04",
      "hash64": "2F8FD1C3B7EC7691",
      "text": "Well, yes...[VAR 0x1100(00FF,0100)]she is, but...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0010_headteacher_05",
      "hash64": "2F8FD0C3B7EC74DE",
      "text": "[VAR 0xBD06(0000)]Ah, I do apologize, M[VAR 0x1100(00FF,0305)]asteriss\\n[VAR 0x0100(0000)].\\r\\nYou\\r\\nmust\\r\\nbe\\r\\nterribly\\r\\nconfused.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
