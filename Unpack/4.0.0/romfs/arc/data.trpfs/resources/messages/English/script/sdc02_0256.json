      "label": "sdc02_0256_brother_05",
      "hash64": "19669295752A3784",
      "text": "... ... ...\\n... ... ...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
