      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0256_sister_02",
      "hash64": "F7D074A5533A58EB",
      "text": "Wow, Kiki...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
