      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_dragon_a_05",
      "hash64": "8108476CB8537119",
      "text": "So, [VAR 0x0100(0000)]...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
