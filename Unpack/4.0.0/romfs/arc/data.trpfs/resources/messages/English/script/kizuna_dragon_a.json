    },
    {
      "ordinal": 2,
      "label": "kizuna_dragon_a_select_01",
      "hash64": "49093343072DCD84",
      "text": "A little bit, yeah...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_dragon_a_select_02",
      "hash64": "49093643072DD29D",
      "text": "It’s just right for me!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_dragon_a_03",
      "hash64": "8108496CB853747F",
      "text": "Hmm... Perhaps I need to improve how I convey\\nthe material.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
