      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_dragon_a_04",
      "hash64": "8108466CB8536F66",
      "text": "That is certainly good to hear.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
