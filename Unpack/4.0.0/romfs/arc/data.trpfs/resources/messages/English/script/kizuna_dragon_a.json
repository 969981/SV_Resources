          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_dragon_a_06",
      "hash64": "8108446CB8536C00",
      "text": "You chose to take on the Gyms as part of your\\nTreasure Hunt.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
