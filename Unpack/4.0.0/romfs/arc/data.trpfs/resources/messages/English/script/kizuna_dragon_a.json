          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_dragon_a_07",
      "hash64": "8108456CB8536DB3",
      "text": "That must mean you like Pokémon battles. Is that\\ncorrect?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
