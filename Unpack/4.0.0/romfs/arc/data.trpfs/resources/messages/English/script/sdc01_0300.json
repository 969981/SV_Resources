    {
      "ordinal": 5,
      "label": "sdc01_0300_select_01",
      "hash64": "824DAB23CF8D7EF5",
      "text": "Wait, you want ME to jump in?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc01_0300_select_02",
      "hash64": "824DA823CF8D79DC",
      "text": "Jump in? Like, into the pool?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc01_0300_sister_06",
      "hash64": "0E4A11C22ADDB6DC",
      "text": "Well, yeah. I can’t swim. And besides, my clothes\\nwould get soaked if I did it.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0300_sister_07",
      "hash64": "0E4A12C22ADDB88F",
      "text": "You’ve got a real nifty Pokémon to ride on, right?\\nYou’ll be fiiiiiine![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0300_system_01",
      "hash64": "79FA00AB270DABC2",
      "text": "*rumble rumble*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc01_0300_sister_08",
      "hash64": "0E4A17C22ADDC10E",
      "text": "What in the—?! An earthquake?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
