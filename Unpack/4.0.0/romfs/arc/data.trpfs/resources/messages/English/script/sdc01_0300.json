          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0300_sister_05",
      "hash64": "0E4A14C22ADDBBF5",
      "text": "[VAR 0xBD06(0000)]And that’s where you come in,\\n[VAR 0x0100(0000)]!\\r\\nGo on,\\r\\nthen!\\r\\nJump in!\\r\\nDon’t\\r\\nbe\\r\\nscared![VAR 0x0114(0044)]",
      "flags": 0,
