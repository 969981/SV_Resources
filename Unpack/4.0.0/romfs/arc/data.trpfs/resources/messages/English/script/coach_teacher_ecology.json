            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_teacher_ecology_randomtalk_01",
      "hash64": "2B971700F5690DE9",
      "text": "It’s so fun to get to pop around to all these\\ndifferent regions lately.\\c\\nI zone out the whole time we’re flying, and then\\nI’m just there before I know it! Nice and easy![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
