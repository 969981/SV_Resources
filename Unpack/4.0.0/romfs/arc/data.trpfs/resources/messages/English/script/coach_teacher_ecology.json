    {
      "ordinal": 3,
      "label": "coach_teacher_ecology_sp01_01",
      "hash64": "EA40294DD53ADC5A",
      "text": "You’re here as an exchange student, right?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
