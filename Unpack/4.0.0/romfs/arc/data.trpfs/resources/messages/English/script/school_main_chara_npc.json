    },
    {
      "ordinal": 34,
      "label": "school_main_chara_pokelogicalteacher_06",
      "hash64": "0608F6BD7D0DD815",
      "text": "I hope you’ll keep looking for new Pokémon to\\nbefriend here in Paldea![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
