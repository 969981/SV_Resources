      "label": "school_main_chara_pokelogicalteacher_03",
      "hash64": "0608F1BD7D0DCF96",
      "text": "Aim to register 100 Pokémon species in your\\nPokédex! Come tell me when you’re done, OK?[VAR 0x0114(002A)]",
      "flags": 4,
