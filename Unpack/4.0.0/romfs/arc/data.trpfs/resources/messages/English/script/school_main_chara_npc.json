          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "school_main_chara_languageteacher_05",
      "hash64": "05A584A7D5BE13CE",
      "text": "Pawmi’s never been better! How’s that Meowth I\\nentrusted to your care?\\c\\nDoing su-PURR-bly, I hope?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
