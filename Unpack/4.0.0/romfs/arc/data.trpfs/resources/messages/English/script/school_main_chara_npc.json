      "label": "school_main_chara_pokelogicalteacher_02",
      "hash64": "0608F2BD7D0DD149",
      "text": "Aim to register 30 Pokémon species in your\\nPokédex! Come tell me when you’re done, OK?[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
