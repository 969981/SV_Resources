          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "school_main_chara_artteacher_04",
      "hash64": "EC8062D7456EACDE",
      "text": "... ... ...\\n... ... ...\\c\\nOh! I’m so sorry. I was lost in thought.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
