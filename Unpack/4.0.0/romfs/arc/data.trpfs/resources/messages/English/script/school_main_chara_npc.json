    {
      "ordinal": 24,
      "label": "school_main_chara_historyteacher_05",
      "hash64": "E27F458E75633148",
      "text": "How are the treasures of ruin faring?\\c\\nIf you ever find them too much to handle, I will\\ngladly take them off your hands.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
