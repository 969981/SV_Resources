    },
    {
      "ordinal": 23,
      "label": "school_main_chara_historyteacher_04",
      "hash64": "E27F468E756332FB",
      "text": "I do hope you will take on the hunt for the\\ntreasures of ruin if you are so inclined.[VAR 0x0114(0027)]",
