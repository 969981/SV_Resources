          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "school_main_chara_artteacher_01",
      "hash64": "EC8067D7456EB55D",
      "text": "Ah, you must be a new student! It is a pleasure\\nto meet you, indeed![VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
