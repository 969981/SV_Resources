    {
      "ordinal": 32,
      "label": "school_main_chara_pokelogicalteacher_04",
      "hash64": "0608F4BD7D0DD4AF",
      "text": "Aim to register 200 Pokémon species in your\\nPokédex! Come tell me when you’re done, OK?[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "school_main_chara_pokelogicalteacher_05",
      "hash64": "0608F3BD7D0DD2FC",
      "text": "Aim to register 400 Pokémon species in your\\nPokédex!\\c\\nOnce you do, press the [VAR 0xFF00(0006)]X Button[VAR 0xFF00(0000)] in your Pokédex\\napp and you’ll get a nice little completion mark!\\r\\nI’d love if you could show me when you get it.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
