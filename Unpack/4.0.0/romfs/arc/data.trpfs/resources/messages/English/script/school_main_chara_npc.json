    },
    {
      "ordinal": 38,
      "label": "school_main_chara_languageteacher_04",
      "hash64": "05A585A7D5BE1581",
      "text": "Pawmi’s doing great! It’s just a bit of a quiet one![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
