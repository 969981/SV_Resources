        }
      ]
    },
    {
      "ordinal": 41,
      "label": "school_main_chara_artteacher_02",
      "hash64": "EC8064D7456EB044",
      "text": "Challenging the Gyms is important, of course,\\nbut one must not neglect their studies![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "school_main_chara_artteacher_03",
      "hash64": "EC8065D7456EB1F7",
      "text": "What is the true meaning of ”strength,”\\nI wonder?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
