    },
    {
      "ordinal": 1,
      "label": "gym_mushi_040_receptionist_00",
      "hash64": "6C45367949483D43",
      "text": "[VAR 0xBD06(0000)]Welcome to the Cortondo Gym,\\n[VAR 0x0100(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_mushi_040_receptionist_01",
      "hash64": "6C45357949483B90",
      "text": "Are you ready to challenge Gym Leader Katy,\\nthe Sugarbug?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mushi_040_receptionist_02",
      "hash64": "6C453879494840A9",
      "text": "Very well. Allow me to show you to the\\nbattle court.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mushi_040_receptionist_03",
      "hash64": "6C45377949483EF6",
      "text": "Of course. Please feel free to come speak to me\\nwhenever you’re ready.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mushi_040_mushi_entry_01",
      "hash64": "646E2CD7DF034FC2",
      "text": "Eat up, my cute little Vivillon![VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_mushi_040_poke_entry_01",
      "hash64": "65F00449FA87129F",
      "text": "Villooon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_mushi_040_mushi_01",
      "hash64": "873EDBF65FF9575F",
      "text": "Oh? What a lovely Trainer you are.[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mushi_040_mushi_02",
      "hash64": "873EDCF65FF95912",
      "text": "Thank you very much for your skillful olive rolling.\\nIt was quite impressive.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_mushi_040_mushi_03",
      "hash64": "873EDDF65FF95AC5",
      "text": "Oh? Did I forget to introduce myself?\\nForgive me.[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_mushi_040_mushi_04",
      "hash64": "873ED6F65FF94EE0",
      "text": "My name is Katy, and I am the owner here at\\nPatisserie Soapberry.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mushi_040_mushi_05",
      "hash64": "873ED7F65FF95093",
      "text": "Oh? That’s right, I’m not in my shop—I’m on duty\\nas leader of the Cortondo Gym right now![VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_mushi_040_mushi_06",
      "hash64": "873ED8F65FF95246",
      "text": "Forgive me. Ahem. My name is Katy, and I am\\nthe Gym Leader here in Cortondo.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_mushi_040_mushi_07",
      "hash64": "873ED9F65FF953F9",
      "text": "My main line of work is crafting sweets as a\\npastry chef.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_mushi_040_mushi_08",
      "hash64": "873EE2F65FF96344",
      "text": "Little sweets that bring happiness with just one\\nbite, Bug-type Pokémon hiding in foliage...\\r\\nBoth are small and yet very powerful.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_mushi_040_mushi_09",
      "hash64": "873EE3F65FF964F7",
      "text": "Don’t let your guard down unless you would like\\nto find yourself knocked off your feet![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mushi_040_mushi_10",
      "hash64": "874260F65FFC6F35",
      "text": "Your strength rose during our battle like a nice\\nbread in the oven.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_mushi_040_mushi_11",
      "hash64": "87425FF65FFC6D82",
      "text": "I feel that I may need to work on my own\\nstrength as well![VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_mushi_040_mushi_12",
      "hash64": "87425EF65FFC6BCF",
      "text": "Congratulations! You passed! As proof of your\\nvictory against me—the Gym Leader—allow me\\r\\nto present you with this Gym Badge.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_mushi_040_mushi_16",
      "hash64": "87425AF65FFC6503",
      "text": "I hope you’ll enjoy it alongside a heaping serving\\nof some of my deluxe handmade treats![VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_mushi_040_mushi_badge",
      "hash64": "03E0CD0DB4E5B087",
      "text": "With [VAR 0x0200(0001)] Gym Badge[VAR 0x1101(0001,0100)]s in your possession, Pokémon\\nof up to Lv. [VAR 0x0201(0002)] will be easier to catch and will\\r\\nlisten to your commands as well.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_mushi_040_mushi_badge_all",
      "hash64": "7357E0542B75F0CB",
      "text": "With 8 Gym Badges in your possession, you will\\nbe able to catch Pokémon of any level. They will\\r\\nall certainly listen to your commands as well.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_mushi_040_mushi_waza",
      "hash64": "54D7588FA1FEE21D",
      "text": "I see you have quite the appetite as well! How\\nabout a little TM as the frosting on this cake?[VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_mushi_040_mushi_13",
      "hash64": "87425DF65FFC6A1C",
      "text": "Once you’ve found a TM during your travels,\\nyou can then use a TM Machine to make copies\\r\\nof that TM. You did know that, right?[VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_mushi_040_mushi_14",
      "hash64": "87425CF65FFC6869",
      "text": "I wish you luck in your future adventures. May\\nthey be as sweet and lovely as a good dessert.[VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_mushi_040_mushi_15",
      "hash64": "87425BF65FFC66B6",
      "text": "Off you go, then. Until we meet again![VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_mushi_040_receptionist_04",
      "hash64": "6C453A794948440F",
      "text": "Congratulations! You’re now certified by the\\nCortondo Gym!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
