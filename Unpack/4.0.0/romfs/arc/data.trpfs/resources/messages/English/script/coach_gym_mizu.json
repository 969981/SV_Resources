    {
      "ordinal": 52,
      "label": "coach_gym_mizu_randomtalk_00",
      "hash64": "0AC0F19213BEA2D0",
      "text": "I LOVE the colors here at Blueberry Academy!\\nSuch clear blues—just like Cascarrafa![VAR 0x0114(0018)]",
