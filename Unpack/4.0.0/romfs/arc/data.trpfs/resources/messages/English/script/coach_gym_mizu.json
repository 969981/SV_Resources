    },
    {
      "ordinal": 53,
      "label": "coach_gym_mizu_randomtalk_01",
      "hash64": "0AC0F29213BEA483",
      "text": "Didja see those li’l flowers bloomin’ in the\\nTerarium? Such precious things, doin’ their\\r\\nabsolute darndest![VAR 0x0114(0018)]",
