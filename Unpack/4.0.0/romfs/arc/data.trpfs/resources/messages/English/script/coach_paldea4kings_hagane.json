          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_paldea4kings_hagane_sp03_02c",
      "hash64": "74A27709DAB40789",
      "text": "Ohhh! Do I look that grown-up?[VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_paldea4kings_hagane_sp03_03",
      "hash64": "F72088BBC1885D63",
      "text": "I’m nine years old—that’s old enough to go to\\n[VAR 0x1107(00FF,0206)]NaranjUva Academy if I wanted to![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0206"
          ]
        },
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_paldea4kings_hagane_sp03_04",
      "hash64": "F7208DBBC18865E2",
      "text": "But my Pokémon are too strong... I didn’t want\\nto go to school ’cause I was afraid I’d scare the\\r\\nother kids...[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_paldea4kings_hagane_sp03_05",
      "hash64": "F7208EBBC1886795",
      "text": "And then Geeta said I could join the Elite Four...[VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "coach_paldea4kings_hagane_sp03_06",
      "hash64": "F7208BBBC188627C",
      "text": "But then I saw the students here at Bloo-berry\\nAcademy and I realized something![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "coach_paldea4kings_hagane_sp03_07",
      "hash64": "F7208CBBC188642F",
      "text": "I’m not a weird kid! I’m just really good at\\nPokémon battles![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "coach_paldea4kings_hagane_sp03_08",
      "hash64": "F72091BBC1886CAE",
      "text": "So next year I’m gonna be an Elite Four member\\nAND a student![VAR 0x0114(0014)]",
