    {
      "ordinal": 8,
      "label": "coach_paldea4kings_hagane_sp01_03",
      "hash64": "1EB058AB4FA0AC51",
      "text": "This is my first time in another region! I really\\nwanna go play, but...[VAR 0x0114(0014)]",
