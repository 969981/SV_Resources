      "hash64": "AF6085727E6268D3",
      "text": "Yeah, absolutely!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "coach_paldea4kings_hagane_sp02_select_02",
