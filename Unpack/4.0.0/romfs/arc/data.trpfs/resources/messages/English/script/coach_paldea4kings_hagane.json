      "label": "coach_paldea4kings_hagane_sp02_01",
      "hash64": "F5E55EB69A7AFAB4",
      "text": "Schools are such fun places, aren’t they?[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
