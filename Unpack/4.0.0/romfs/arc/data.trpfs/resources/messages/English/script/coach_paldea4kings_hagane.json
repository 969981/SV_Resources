    {
      "ordinal": 7,
      "label": "coach_paldea4kings_hagane_sp01_02",
      "hash64": "1EB057AB4FA0AA9E",
      "text": "Some nice people from the League flew over\\nwith me to make sure I got here OK![VAR 0x0114(0014)]",
