    {
      "ordinal": 15,
      "label": "coach_paldea4kings_hagane_sp02_02",
      "hash64": "F5E561B69A7AFFCD",
      "text": "I’ve never been to school and classes and stuff\\nbefore![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
