    {
      "ordinal": 17,
      "label": "coach_paldea4kings_hagane_sp02_04",
      "hash64": "F5E55BB69A7AF59B",
      "text": "Do you think I’ll ever get to go to school like\\nother kids...?[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
