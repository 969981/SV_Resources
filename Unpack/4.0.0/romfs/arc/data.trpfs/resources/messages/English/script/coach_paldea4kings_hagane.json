            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_paldea4kings_hagane_sp03_02b",
      "hash64": "74A27609DAB405D6",
      "text": "Oh wow! You’re the first person to get it right![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
