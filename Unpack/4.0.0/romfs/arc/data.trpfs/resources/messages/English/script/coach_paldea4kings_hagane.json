    {
      "ordinal": 9,
      "label": "coach_paldea4kings_hagane_sp01_04",
      "hash64": "1EB059AB4FA0AE04",
      "text": "I know I’m here to teach the Bloo-berry people\\nabout Pokémon, so that’s what I’m gonna do![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
