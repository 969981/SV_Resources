    },
    {
      "ordinal": 16,
      "label": "coach_paldea4kings_hagane_sp02_03",
      "hash64": "F5E560B69A7AFE1A",
      "text": "All the classrooms and the teachers! It’s so\\nexciting![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
