    {
      "ordinal": 1,
      "label": "common_2020_denki_010_denki_02",
      "hash64": "8820E0DABE3D3AC2",
      "text": "’Ello, ’ello, hola! Ciao and bonjour! Wait...\\nYou aren’t Geeta![VAR 0x0114(0019)]",
