    },
    {
      "ordinal": 2,
      "label": "common_2020_denki_010_select_01",
      "hash64": "DE6F2CA18338EC46",
      "text": "It’s me, [VAR 0x0100(0000)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
