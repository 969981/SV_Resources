          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_bb4kings_dragon_battleend_lose_00_00",
      "hash64": "3F5056F5910DC656",
      "text": "Heh heh! Don’t mind me, just scooping up a W\\nover here.\\c\\nI get if you’re upset, but don’t go full Kieran on\\nme, OK?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
