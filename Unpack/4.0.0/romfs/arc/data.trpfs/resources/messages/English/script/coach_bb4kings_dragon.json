    {
      "ordinal": 32,
      "label": "coach_bb4kings_dragon_sp03_04b",
      "hash64": "1A16D1952E7DB5C2",
      "text": "Whoof! Didn’t take you for the facetious\\ntype, bud![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
