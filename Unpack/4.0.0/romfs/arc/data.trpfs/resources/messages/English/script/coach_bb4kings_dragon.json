      ]
    },
    {
      "ordinal": 59,
      "label": "coach_bb4kings_dragon_randomtalk_00",
      "hash64": "8E0EAA7E32F9DEC5",
      "text": "You probably think this is a skirt I’ve got on, huh?\\c\\nHeh heh! Not quite! I just tied my cape around\\nmy waist.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "coach_bb4kings_dragon_randomtalk_01",
      "hash64": "8E0EA97E32F9DD12",
      "text": "I’m really not made for learning in classrooms.\\nI’ve gotten held back...three times, I think?\\c\\nBut I get to savor the sweet school life longer\\nthan everyone else. It’s a pretty good deal.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 189,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "coach_bb4kings_dragon_randomtalk_02",
      "hash64": "8E0EA87E32F9DB5F",
      "text": "Man, I love chairs. Don’t you love chairs?\\nWhat lifesavers.\\c\\nI don’t get why everyone doesn’t just sit all the\\ntime. Standing up’s tiring work![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
