        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "coach_bb4kings_dragon_randomtalk_03",
      "hash64": "8E0EA77E32F9D9AC",
      "text": "[VAR 0xBD06(0000)]Your [VAR 0x0101(0001)] and I are getting along\\ngreat!\\c\\nYou can rest easy—I’m giving it all the care one\\nof my buds deserves.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
