    {
      "ordinal": 1,
      "label": "s2_side01_0090_system_02",
      "hash64": "9D4CAB1632AFFE30",
      "text": "You found the remote control for the TV!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_side01_0080_friend_01",
      "hash64": "E9A59ED99AFB3197",
