      "ordinal": 26,
      "label": "s2_side01_0080_botan_06",
      "hash64": "726D2EFC947149FE",
      "text": "We’ll hold down the fort till you get back.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
