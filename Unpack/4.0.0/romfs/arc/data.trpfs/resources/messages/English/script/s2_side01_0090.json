          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_side01_0080_friend_npc",
      "hash64": "7DC3EDC0ED09C0AB",
      "text": "Be careful! It’s already pretty dark outside.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
