      "ordinal": 27,
      "label": "s2_side01_0080_brother_09",
      "hash64": "91D44CA7ABA8F837",
      "text": "Let’s go, [VAR 0x0100(0000)].[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
