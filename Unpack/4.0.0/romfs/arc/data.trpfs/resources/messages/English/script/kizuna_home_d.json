    {
      "ordinal": 1,
      "label": "kizuna_home_d_02",
      "hash64": "CDB47E6DB9FA2EC5",
      "text": "I have discovered the name of the incredibly\\nsweet condiment.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_home_d_03",
      "hash64": "CDB47D6DB9FA2D12",
      "text": "It is called Sweet Herba Mystica![VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_home_d_04",
      "hash64": "CDB4786DB9FA2493",
      "text": "If you should find it during the course of your\\nTreasure Hunt, I would be grateful if you would\\r\\nshare some with me.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
