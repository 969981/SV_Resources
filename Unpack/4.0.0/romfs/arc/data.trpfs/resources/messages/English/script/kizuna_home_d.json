    {
      "ordinal": 21,
      "label": "kizuna_home_d_17",
      "hash64": "CDB0F96DB9F716EF",
      "text": "Thanks to you, I was able to have a most\\ndelectably sweet experience.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_home_d_18",
      "hash64": "CDB0FE6DB9F71F6E",
      "text": "Moreover, I even feel that my narrow-minded\\nviews have broadened ever so slightly.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_home_d_19",
      "hash64": "CDB0FF6DB9F72121",
      "text": "Please accept my heartiest of thanks.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
