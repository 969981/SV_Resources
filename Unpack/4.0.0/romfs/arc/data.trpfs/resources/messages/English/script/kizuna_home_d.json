          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_home_d_05",
      "hash64": "CDB4776DB9FA22E0",
      "text": "[VAR 0xBD06(0000)]M[VAR 0x1100(00FF,0305)]asteriss [VAR 0x0100(0000)]... Have you\\nanything\\r\\nto\\r\\nreport\\r\\nabout\\r\\nthe\\r\\nSweet\\r\\nHerba Mystica?[VAR 0x0114(0029)]",
