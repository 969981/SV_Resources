    },
    {
      "ordinal": 9,
      "label": "sdc02_0260_sister_04",
      "hash64": "7F7F1A4AE087D1B4",
      "text": "What are desks doing down here?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
