          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0260_bbteacher_05",
      "hash64": "292A8CCF8836FB0B",
      "text": "Oh my... Oh my, this is...[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0260_bbteacher_06",
      "hash64": "292A8DCF8836FCBE",
      "text": "This is a report written by the esteemed\\nProfessor Sada![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0260_bbteacher_07",
      "hash64": "292A8ECF8836FE71",
      "text": "This is a report written by the esteemed\\nProfessor Turo![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0260_book_01",
      "hash64": "276671692819938C",
      "text": "A massive cavern exists beneath Area Zero,\\nand there slumbers Terapagos, [VAR 0xFF00(0006)]the hidden[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]treasure of Area Zero[VAR 0xFF00(0000)]. Its body has become\\ncrystal, protecting it from hostile outsiders.\\nIt appears that rousing it will take some time.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0260_book_01b",
      "hash64": "0CA6A3AF23765D6A",
      "text": "In this cavern, I have witnessed the Terastal\\nphenomenon occurring in a way I’ve never seen\\naboveground—Terastallization that appears to\\nhold the power of every known type. I have\\ndubbed this Tera Type the [VAR 0xFF00(0006)]Stellar[VAR 0xFF00(0000)] type for now.\\nCould Terapagos’s influence be at play?",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 206,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 217,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0260_book_02",
      "hash64": "27667469281998A5",
      "text": "A massive cavern exists beneath Area Zero,\\nand there slumbers Terapagos, [VAR 0xFF00(0006)]the hidden[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]treasure of Area Zero[VAR 0xFF00(0000)]. Its body has become\\ncrystal, protecting it from hostile outsiders.\\nIt appears that rousing it will take some time.",
      "flags": 4,
