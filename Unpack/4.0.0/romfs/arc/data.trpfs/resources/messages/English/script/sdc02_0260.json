      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0260_brother_02",
      "hash64": "1FFE0D97D064C1AA",
      "text": "What’s...all this stuff?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
