    },
    {
      "ordinal": 17,
      "label": "sdc01_0440_sister_06",
      "hash64": "33D3E145C3C27DD5",
      "text": "Hey, Kiki...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
