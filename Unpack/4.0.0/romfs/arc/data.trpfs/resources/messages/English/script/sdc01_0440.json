      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0440_brother_02",
      "hash64": "6D6AA32766E12AD7",
      "text": "If it’s not gonna stay here, then I...I wanna...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
