    {
      "ordinal": 15,
      "label": "sdc01_0440_brother_04",
      "hash64": "6D6AA12766E12771",
      "text": "But, [VAR 0x0100(0000)]! Please![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
