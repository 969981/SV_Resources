    },
    {
      "ordinal": 18,
      "label": "sdc01_0440_sister_07",
      "hash64": "33D3E045C3C27C22",
      "text": "I know you really love Ogerpon. I really, honestly\\nunderstand.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0440_sister_08",
      "hash64": "33D3E345C3C2813B",
      "text": "But...you have to think about Ogerpon’s\\nfeelings too.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
