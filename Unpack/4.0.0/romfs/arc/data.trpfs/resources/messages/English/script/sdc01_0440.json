    },
    {
      "ordinal": 12,
      "label": "sdc01_0440_brother_08",
      "hash64": "6D6A9D2766E120A5",
      "text": "I want Ogerpon to come with me![VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
