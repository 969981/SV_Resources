      "label": "sdc01_0440_select_01",
      "hash64": "256ADA2F2AC7CE98",
      "text": "Bye-bye, Ogerpon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_0440_select_02",
