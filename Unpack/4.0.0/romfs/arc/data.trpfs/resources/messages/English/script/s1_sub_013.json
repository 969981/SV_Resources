          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_013_picnic_02",
      "hash64": "686A7AA477DFA8D5",
      "text": "but I’m a bit stuck on what design to use for\\nsome nice picnic chairs.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_013_picnic_03",
      "hash64": "686A79A477DFA722",
      "text": "Could you maybe show me any tablecloths\\nyou’ve got on you?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_013_picnic_15",
      "hash64": "6866F7A477DC9465",
      "text": "Oh, maybe you aren’t all that interested in\\npicnics...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
