      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "s1_sub_013_picnicnpc_01_06",
      "hash64": "35EAFDF903988A80",
      "text": "How’re you feeling? You can take a rest, if you’d\\nlike.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "s1_sub_013_picnicnpc_01_03",
      "hash64": "35EB02F9039892FF",
      "text": "Are you worn out from your adventures?\\nYou’d better take a breather before you go!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
