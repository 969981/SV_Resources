    {
      "ordinal": 6,
      "label": "s1_sub_013_picnic_04",
      "hash64": "686A74A477DF9EA3",
      "text": "Hrrmm, I see! So these are the kinds of designs\\npeople in Paldea like, huh?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_013_picnic_16",
      "hash64": "6866F4A477DC8F4C",
      "text": "I’m going to try making some new chairs using the\\ndesign you showed me!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
