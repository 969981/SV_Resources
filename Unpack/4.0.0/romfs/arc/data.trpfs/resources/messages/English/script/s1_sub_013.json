    {
      "ordinal": 23,
      "label": "s1_sub_013_picnic_18",
      "hash64": "6866FAA477DC997E",
      "text": "Phew! Since you came around I’ve been able to\\nmake so many new chairs that I might just be\\r\\nfresh out of ideas!",
      "flags": 0,
      "text_status": "DECODED",
