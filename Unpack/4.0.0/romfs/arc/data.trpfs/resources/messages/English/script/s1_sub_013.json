      "label": "s2_sub_013_picnic_chair_05",
      "hash64": "8FC824AC036A8E2F",
      "text": "The prototype is complete! I’ll give you these\\nchairs as thanks for showing me that design.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
