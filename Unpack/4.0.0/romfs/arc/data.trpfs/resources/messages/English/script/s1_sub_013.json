      "label": "s1_sub_013_picnic_01",
      "hash64": "686A77A477DFA3BC",
      "text": "Hey, you’re one of those students from Paldea!\\c\\nSee, I happen to make chairs in my free time...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
