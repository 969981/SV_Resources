      "hash64": "35EAFFF903988DE6",
      "text": "Three really does make company! Come by again\\nwhenever you want!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
