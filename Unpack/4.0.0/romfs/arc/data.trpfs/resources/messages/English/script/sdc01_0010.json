    {
      "ordinal": 29,
      "label": "sdc01_0010_ecology_11",
      "hash64": "4FF498C5AFE36F9E",
      "text": "And there we go! All done!\\c\\nNow you can go wild registering all the Pokémon\\nyou find around Kitakami too![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
