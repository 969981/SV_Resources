    {
      "ordinal": 6,
      "label": "sdc01_0010_bbteacher_05",
      "hash64": "D367CE83C7899FD9",
      "text": "Oh, and you even have a Tera Orb![VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
