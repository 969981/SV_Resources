    {
      "ordinal": 2,
      "label": "sdc02_0070_select_01",
      "hash64": "1339D8740A3EC6A0",
      "text": "It was fine!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
