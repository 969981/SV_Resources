            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0070_fairybb_04",
      "hash64": "6A30E7939BD65ECC",
      "text": "*whisper whisper*\\nSay again? I didn’t quite catch that![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0070_teacher_01",
      "hash64": "E7AD0FEE0DEEEFA2",
      "text": "Alola, everybody! Shall we get started?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_0070_teacher_02",
      "hash64": "E7AD0EEE0DEEEDEF",
      "text": "Looks like we have a new face here with us\\ntoday!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc02_0070_teacher_03",
      "hash64": "E7AD0DEE0DEEEC3C",
      "text": "I’m sure you’re all enjoying the tropical clime\\nwe’ve re-created here at the Coastal Biome.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sdc02_0070_teacher_04",
      "hash64": "E7AD0CEE0DEEEA89",
      "text": "But remember—it’s really for the many Pokémon\\nyou’ll find living here, adapted for such weather!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc02_0070_teacher_05",
      "hash64": "E7AD0BEE0DEEE8D6",
      "text": "One such species has even grown exceptionally\\nlarger than it might in other regions, thanks to all\\r\\nthe light it’s exposed to here!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0070_teacher_06",
      "hash64": "E7AD0AEE0DEEE723",
      "text": "That’s right, certain species of Pokémon can have\\ncompletely different appearances depending on\\r\\nthe region! We call this variation a [VAR 0xFF00(0006)]regional form[VAR 0xFF00(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 153,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0070_teacher_07",
      "hash64": "E7AD09EE0DEEE570",
      "text": "And that brings us to today’s task.\\c\\nI’d like each of you to catch one of these\\nPokémon—specifically, an [VAR 0xFF00(0006)]Alolan Form[VAR 0xFF00(0000)] Pokémon!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0070_teacher_08",
      "hash64": "E7AD18EE0DEEFEED",
      "text": "When you’ve got one, come and report to me.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0070_teacher_09",
      "hash64": "E7AD17EE0DEEFD3A",
      "text": "Now, get catching!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_0070_fairybb_05",
      "hash64": "6A30E8939BD6607F",
      "text": "Many of our classes here at Blueberry Academy\\nare practical ones like this.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0070_fairybb_06",
      "hash64": "6A30E9939BD66232",
      "text": "So off you go! Don’t overthink it and just do your\\nbest for this first class![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0070_fairybb_07",
      "hash64": "6A30EA939BD663E5",
      "text": "Do you know what kind of Pokémon it is you’re\\nsupposed to be looking for?\\c\\nI suppose the best-known Alolan form might be\\nAlolan Exeggutor, with its long, long neck![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 166,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0070_mob_01",
      "hash64": "83A86BC65CA24E32",
      "text": "Do you know about the Dugtrio in Alola?\\nThey’ve got these, like, crazy whiskers?!\\r\\nFeels weird to call them that, though.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0070_mob_02",
      "hash64": "83A86AC65CA24C7F",
      "text": "In the tropical Alola region, it’s quite common\\nto greet people by calling out “Alola!”",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc02_0070_mob_03",
      "hash64": "83A869C65CA24ACC",
      "text": "Now, which Pokémon had Alolan forms...? I think\\nI remember a couple...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
