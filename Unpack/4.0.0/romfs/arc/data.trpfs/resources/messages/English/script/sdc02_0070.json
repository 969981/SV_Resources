    },
    {
      "ordinal": 4,
      "label": "sdc02_0070_fairybb_03",
      "hash64": "6A30E6939BD65D19",
      "text": "*whisper whisper*\\nI’m so glad to hear it![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
