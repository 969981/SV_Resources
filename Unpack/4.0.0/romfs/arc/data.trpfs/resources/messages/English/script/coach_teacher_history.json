    {
      "ordinal": 0,
      "label": "coach_teacher_history_first_00",
      "hash64": "F3ABE90DE7EBE8BF",
      "text": "This school... It’s filled with the smell of the new,\\nthe modern.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
