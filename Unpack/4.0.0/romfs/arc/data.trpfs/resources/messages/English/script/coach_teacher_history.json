          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_teacher_history_first_01",
      "hash64": "F3ABE80DE7EBE70C",
      "text": "[VAR 0xBD06(0000)]So, are you the one who called me here,\\n[VAR 0x0100(0000)]?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_history_sp01_00",
      "hash64": "0D384DD6F5849F51",
      "text": "You’ve got some nerve, inviting me to such a\\nmodern structure.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_history_sp01_01",
      "hash64": "0D384CD6F5849D9E",
      "text": "I have absolutely no interest in this place, but I\\ndidn’t want you to lose face—so here I am.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_history_sp01_02",
      "hash64": "0D384BD6F5849BEB",
      "text": "Think of it as a favor from me. Heh heh...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_history_sp01_03",
      "hash64": "0D384AD6F5849A38",
      "text": "I’ll expect you to return the favor at some point.\\nPerhaps by doing as I say when needed.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_history_sp01_select_01",
      "hash64": "57AE81059636D3ED",
      "text": "Oh no...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_history_sp01_select_02",
      "hash64": "57AE7E059636CED4",
      "text": "You got it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_history_sp01_05",
      "hash64": "0D3850D6F584A46A",
      "text": "Heh! You reap what you sow. I suggest you look\\nforward to the harvest![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_history_sp01_05b",
      "hash64": "FB5565433062B998",
      "text": "Hm? You’re more enthusiastic than I expected.\\nWhich suits me just fine. Heh heh...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_history_sp01_04",
      "hash64": "0D3851D6F584A61D",
      "text": "Oh, the things we can accomplish together, my\\ndear puppet...[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_history_sp02_00",
      "hash64": "666D0BF03CD5C25E",
      "text": "Ah, you again. I suppose whatever you’ve done\\nsince we last spoke has become a part of history.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_history_sp02_01",
      "hash64": "666D0CF03CD5C411",
      "text": "Initially I took the long journey here unwillingly,\\nbut...when I think about it, we’re in Unova!\\c\\nThis place is a veritable treasure trove of history![VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 152,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_history_sp02_02",
      "hash64": "666D09F03CD5BEF8",
      "text": "I am practically overflowing with curiosity,\\nespecially regarding those ancient ruins resting at\\r\\nthe bottom of the sea![VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_history_sp02_03",
      "hash64": "666D0AF03CD5C0AB",
      "text": "...And Director Clavell isn’t here to snoop around\\nin my business—another perk of this trip.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_history_sp02_04",
      "hash64": "666D0FF03CD5C92A",
      "text": "Ohohooo! I can’t wait to have a swim with my\\nPokémon and go exploring![VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_history_sp02_select_01",
      "hash64": "2FC3C3870821A010",
      "text": "Sounds like fun!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_history_sp02_select_02",
      "hash64": "2FC3C6870821A529",
      "text": "Be safe out there",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_history_sp02_05",
      "hash64": "666D10F03CD5CADD",
      "text": "Heh heh! Of course it will be fun!\\c\\nThere is no greater treasure than experiencing\\nancient wisdom![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_history_sp02_05b",
      "hash64": "E11E87375F47828D",
      "text": "Heh heh, don’t worry yourself about me.\\c\\nShould I meet my end surrounded by ruins and\\nartifacts...it would be a good way to go.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_history_sp03_00",
      "hash64": "8F3801E4F1FB6D2F",
      "text": "Ah...[VAR 0x0100(0000)]... It’s you...[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_history_sp03_select_01",
      "hash64": "8C4F417AD5A90CCB",
      "text": "What’s up?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_history_sp03_select_02",
      "hash64": "8C4F427AD5A90E7E",
      "text": "Something wrong?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_history_sp03_01",
      "hash64": "8F3800E4F1FB6B7C",
      "text": "Isn’t it obvious? I’m exhausted by the sheer\\nbliss of satisfaction and fulfillment.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_history_sp03_01b",
      "hash64": "5794A3072E3703FA",
      "text": "Heh... No, the exact opposite. So many things\\nare right that I am exhausted from satisfaction.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_history_sp03_02",
      "hash64": "8F3803E4F1FB7095",
      "text": "I took my Lumineon for a swim and visited the\\nfamous Abyssal Ruins here in Unova...[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_history_sp03_03",
      "hash64": "8F3802E4F1FB6EE2",
      "text": "They were...marvelous. Truly amazing.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_history_sp03_04",
      "hash64": "8F37FDE4F1FB6663",
      "text": "Ancient contrivances to thwart intruders! The\\nmysterious text etched onto the walls![VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_history_sp03_05",
      "hash64": "8F37FCE4F1FB64B0",
      "text": "Testing my wits against those of the ancients was\\na truly rewarding experience.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_history_sp03_06",
      "hash64": "8F37FFE4F1FB69C9",
      "text": "But it would be a shame to dash straight to the\\ndepths of the ruins too quickly. I plan on taking\\r\\nmy time with the exploration.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_history_trade_01_00",
      "hash64": "3D5AF8BE8D788069",
      "text": "[VAR 0xBD06(0000)]You know, [VAR 0x0100(0000)]... I\\njust\\r\\nhad\\r\\nan\\r\\namusing idea.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_history_trade_01_01",
      "hash64": "3D5AF7BE8D787EB6",
      "text": "You are a Champion, aren’t you? What say you\\nand I trade Pokémon?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_history_trade_01_02",
      "hash64": "3D5AF6BE8D787D03",
      "text": "Any Pokémon belonging to a Champion is sure\\nto be incredibly useful. So...would you be willing\\r\\nto trade for my Gimmighoul?[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_teacher_history_trade_01_03",
      "hash64": "3D5AF5BE8D787B50",
      "text": "Excellent. Then you should pick which Pokémon\\nyou want to trade. A species good at exploring\\r\\nwould be appreciated.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_teacher_history_trade_01_04",
      "hash64": "3D5AFCBE8D788735",
      "text": "Ah yes. A worthwhile trade.\\c\\nDon’t you worry. I’ll take very good care of your\\n[VAR 0x0101(0001)].[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
