    {
      "ordinal": 0,
      "label": "ajito_honoo_040_honooboss_00",
      "hash64": "2B3422FF78D41D2F",
      "text": "Ugh. Is this really how it’s gonna end? What a\\nhassle...[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
