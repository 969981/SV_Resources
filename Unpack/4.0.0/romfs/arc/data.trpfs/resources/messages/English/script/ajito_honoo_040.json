    },
    {
      "ordinal": 33,
      "label": "ajito_honoo_040_honooboss_15",
      "hash64": "2B30A1FF78D10C25",
      "text": "A Charcadet? Wait...[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
