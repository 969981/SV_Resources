            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "ajito_honoo_040_poke_02",
      "hash64": "C7BCCDDB51166024",
      "text": "Foo-foom!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "ajito_honoo_040_honooboss_16",
      "hash64": "2B309EFF78D1070C",
      "text": "Well, if it ain’t Charlos! What’re you doin’ here?[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
