      ]
    },
    {
      "ordinal": 31,
      "label": "ajito_honoo_040_poke_01",
      "hash64": "C7BCD0DB5116653D",
      "text": "Fwoo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
