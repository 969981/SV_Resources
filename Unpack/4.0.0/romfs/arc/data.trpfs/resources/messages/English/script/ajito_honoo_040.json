      "text": "[EMPTY 64]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "ajito_honoo_040_nelke_04",
      "hash64": "CC8F515F3859BE70",
      "text": "It seems he came to this base looking for you.[VAR 0x0114(001E)]",
      "flags": 4,
