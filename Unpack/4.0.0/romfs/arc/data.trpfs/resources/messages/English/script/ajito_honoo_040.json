          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_honoo_040_system_01",
      "hash64": "9EE80FCAB57DB6D1",
      "text": "About a year and a half ago...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "ajito_honoo_040_honooboss_01",
      "hash64": "2B3421FF78D41B7C",
      "text": "Man, what a hassle... Pulled it off just in time.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_honoo_040_kakutouboss_01",
      "hash64": "A93E42F7A9667E69",
      "text": "Welcome back, Mellie![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_honoo_040_honooboss_02",
      "hash64": "2B3424FF78D42095",
      "text": "I managed to get a buncha Charcadet to evolve.[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_honoo_040_honooboss_03",
      "hash64": "2B3423FF78D41EE2",
      "text": "That oughta be enough to power the Starmobile\\nand finally get that hunka metal rollin’.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_honoo_040_dokuboss_01",
      "hash64": "8CB3ED175179BD66",
      "text": "Glad tidings indeed. Is it not so, Ortega?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "ajito_honoo_040_fairyboss_01",
      "hash64": "553BCCF0C90A095A",
      "text": "I’m just surprised she’s not all hot air...[VAR 0x0114(0020)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_honoo_040_honooboss_04",
      "hash64": "2B341EFF78D41663",
      "text": "Oh, shut it with the snide comments! You can be\\nsuch an annoyin’ twerp, you know that?[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_honoo_040_fairyboss_02",
      "hash64": "553BCBF0C90A07A7",
      "text": "As if you’re any better, Mela...[VAR 0x0114(0020)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_honoo_040_fairyboss_03",
      "hash64": "553BCAF0C90A05F4",
      "text": "Being rude and saying mean things is literally\\nyour whole deal.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_honoo_040_kakutouboss_02",
      "hash64": "A93E3FF7A9667950",
      "text": "That’s not true, Ortie.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_honoo_040_kakutouboss_03",
      "hash64": "A93E40F7A9667B03",
      "text": "The girls at the academy have always been\\njealous of how cute Mellie is. She just puts on\\r\\na surly attitude so they’ll stop picking on her.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_honoo_040_kakutouboss_04",
      "hash64": "A93E45F7A9668382",
      "text": "Although...I guess you’re not wrong to say that\\nher surly attitude is what people know her for...[VAR 0x0114(0022)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "ajito_honoo_040_honooboss_05",
      "hash64": "2B341DFF78D414B0",
      "text": "What?! Come on—not you too, Eri![VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "ajito_honoo_040_akuboss_01",
      "hash64": "5091DFE52308FB9C",
      "text": "How ’bout we leave it at that, folks? It’s almost\\ntime for the big event.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "ajito_honoo_040_kakutouboss_06",
      "hash64": "A93E43F7A966801C",
      "text": "Yes, Operation Star... It’s finally happening.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_honoo_040_dokuboss_02",
      "hash64": "8CB3EC175179BBB3",
      "text": "And the big boss? What, pray, is their plan?[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_honoo_040_akuboss_02",
      "hash64": "5091E2E5230900B5",
      "text": "They already got in touch with all the bullies and\\nasked ’em to head over to the schoolyard.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "ajito_honoo_040_honooboss_06",
      "hash64": "2B3420FF78D419C9",
      "text": "It’s finally time, huh... Man, I’m so stoked!\\nThe thrill’s burnin’ me right up![VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_honoo_040_honooboss_07",
      "hash64": "2B341FFF78D41816",
      "text": "I burned through everythin’ I had...and now I’ve\\nsputtered out.[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_honoo_040_honooboss_08",
      "hash64": "2B342AFF78D42AC7",
      "text": "Guess this is where it ends...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "ajito_honoo_040_honooboss_09",
      "hash64": "2B3429FF78D42914",
      "text": "[VAR 0xBD06(0000)]That [VAR 0x0101(0001)] of yours really let us\\nhave it.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "ajito_honoo_040_honooboss_10",
      "hash64": "2B309CFF78D103A6",
      "text": "Beatin’ me in battle is a huge deal. So here—take\\nthis Star Badge and be proud of yourself![VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "ajito_honoo_040_waza_01",
      "hash64": "CDBA474C243C00C9",
      "text": "While I’m at it, you can have this TM too.\\nNot like I’m gonna use it.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "ajito_honoo_040_honooboss_11",
      "hash64": "2B309DFF78D10559",
      "text": "Lemme make one thing clear—I’m not givin’ these\\nto YOU...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "ajito_honoo_040_honooboss_12",
      "hash64": "2B309AFF78D10040",
      "text": "I’m givin’ them to your [VAR 0x0101(0001)].[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "ajito_honoo_040_honooboss_13",
      "hash64": "2B309BFF78D101F3",
      "text": "You got what you came for. Now leave me alone.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "ajito_honoo_040_nelke_01",
      "hash64": "CC8F565F3859C6EF",
      "text": "You’re Mela from Team Star, right? There’s a\\nPokémon I’d like you to see.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "ajito_honoo_040_honooboss_14",
      "hash64": "2B30A0FF78D10A72",
      "text": "Huh? Who are you s’posed to be?[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
