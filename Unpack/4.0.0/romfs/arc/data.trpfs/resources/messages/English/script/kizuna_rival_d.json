      "label": "kizuna_rival_d_01",
      "hash64": "0E5E1910107B8C89",
      "text": "There you are, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
