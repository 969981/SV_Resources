      "hash64": "E61208A4A4133A8B",
      "text": "Hello hello, everyone. Today is our final exam.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
