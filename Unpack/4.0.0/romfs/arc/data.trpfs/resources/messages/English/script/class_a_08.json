          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_a_08_ecology_03",
      "hash64": "E6120AA4A4133DF1",
      "text": "Take your time, and contemplate each question\\ncarefully.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_a_08_question_01",
      "hash64": "C4460BAE4D4FFF9D",
      "text": "1. How many of the following four methods\\n    make it easier to catch a Pokémon?\\n\\n    ・Inflicting paralysis   ・Using a Poké Toy\\n    ・Feeding it a Berry   ・Surprising it from behind",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_a_08_ansewer_01a",
      "hash64": "1F43BA9C75CDEB85",
      "text": "One",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_a_08_ansewer_01b",
      "hash64": "1F43B79C75CDE66C",
      "text": "Two",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
