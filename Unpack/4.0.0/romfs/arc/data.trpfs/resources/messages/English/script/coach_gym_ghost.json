    {
      "ordinal": 45,
      "label": "coach_gym_ghost_battlestart_01",
      "hash64": "91356E85B215B93A",
      "text": "Kid, you know I’m Double Battlin’ till the end!\\nIf you wanna share the stage with me, you better\\r\\nbring at least two Pokémon!",
