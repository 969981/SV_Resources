      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_ghost_randomtalk_02",
      "hash64": "B11B6379BF8E2E7A",
      "text": "Listen—don’t start nonsense and land yourself\\nin trouble with my sister, Tyme!\\c\\nIf you set her off, she goes OFF. She’s scarier than\\nI am—for real![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
