      "ordinal": 52,
      "label": "coach_gym_ghost_battleend_win_01_01",
      "hash64": "E6BFAF91BAA68E00",
      "text": "Till next time, baby! Hit me up if your spirit’s\\nachin’ for a battle![VAR 0x0114(001B)]",
