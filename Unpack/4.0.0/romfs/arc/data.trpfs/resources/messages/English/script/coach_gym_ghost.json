    },
    {
      "ordinal": 54,
      "label": "coach_gym_ghost_randomtalk_00",
      "hash64": "B11B6179BF8E2B14",
      "text": "You heard my number-one single, “A Visit to My\\nFather”?\\c\\nThe lyrics for that one came to me when I was\\npayin’ respects at my dad’s grave.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
