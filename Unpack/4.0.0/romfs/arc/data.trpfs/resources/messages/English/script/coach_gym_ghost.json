      "label": "coach_gym_ghost_battleend_win_00_00",
      "hash64": "3E6BFA995725EC42",
      "text": "Hah! Great battle—chilling AND thrilling![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
