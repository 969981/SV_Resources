    },
    {
      "ordinal": 47,
      "label": "coach_gym_ghost_battleend_win_00_01",
      "hash64": "3E6BFB995725EDF5",
      "text": "You got me in your corner, baby...in spirit. Not\\nlike I can actually tag in for you, y’know?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
