    {
      "ordinal": 53,
      "label": "coach_gym_ghost_battleend_lose_00_00",
      "hash64": "BC8F890B5D1C6C89",
      "text": "How’d you like my show, baby? Seeing it live hits\\ndifferent, huh? Haha!\\c\\nHit me up whenever you’re ready to step to me\\nagain. A VIP like you gets in free![VAR 0x0114(001B)]",
      "flags": 0,
