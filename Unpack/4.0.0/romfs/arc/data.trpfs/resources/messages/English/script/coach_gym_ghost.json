    {
      "ordinal": 39,
      "label": "coach_gym_ghost_trade_03_00",
      "hash64": "77D40E742CFE9AAD",
      "text": "Hold up—your party’s lookin’ too slim, baby!\\nBring more Pokémon if you finna trade me![VAR 0x0114(001B)]",
