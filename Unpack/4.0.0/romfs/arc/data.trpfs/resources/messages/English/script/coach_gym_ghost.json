    {
      "ordinal": 44,
      "label": "coach_gym_ghost_battlestart_00",
      "hash64": "91356F85B215BAED",
      "text": "Hah! You already know! Let’s go head-to-head\\nand soul-to-soul![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
