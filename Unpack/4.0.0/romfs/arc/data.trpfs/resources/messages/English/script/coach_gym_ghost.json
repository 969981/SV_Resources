    },
    {
      "ordinal": 1,
      "label": "coach_gym_ghost_first_01",
      "hash64": "E2556246BBB7BB2E",
      "text": "Someone here asked for a Ryme feature, huh?\\nTime to show you all how to unleash the spirit![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
