      "ordinal": 51,
      "label": "coach_gym_ghost_battleend_win_01_00",
      "hash64": "E6BFB091BAA68FB3",
      "text": "Your beatdowns hit different! I’ll be feelin’ that\\nall the way to the afterlife![VAR 0x0114(001B)]",
