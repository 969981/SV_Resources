      "ordinal": 55,
      "label": "coach_gym_ghost_randomtalk_01",
      "hash64": "B11B6279BF8E2CC7",
      "text": "That battle court in the entrance here is niiice.\\c\\nIt’s got seats around it and everything. Drop me\\na beat and I could put on a show there.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
