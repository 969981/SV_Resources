    {
      "ordinal": 0,
      "label": "coach_gym_ghost_first_00",
      "hash64": "E2556346BBB7BCE1",
      "text": "You know who it is, baby![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
