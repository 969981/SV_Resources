    {
      "ordinal": 48,
      "label": "coach_gym_ghost_battleend_win_00_02",
      "hash64": "3E6BF8995725E8DC",
      "text": "I’m gonna hook you up with a pair of kicks from\\nmy tour merch. Wear your soul on your soles![VAR 0x0114(001B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
