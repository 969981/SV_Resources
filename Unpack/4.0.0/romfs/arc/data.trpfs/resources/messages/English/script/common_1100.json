    {
      "ordinal": 0,
      "label": "common_1100_rival_01",
      "hash64": "0E61F4BD5903E9FA",
      "text": "Aaand made it to station number three![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
