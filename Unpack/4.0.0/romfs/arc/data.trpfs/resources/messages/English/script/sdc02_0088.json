    },
    {
      "ordinal": 45,
      "label": "sdc02_0088_dragonbb_04",
      "hash64": "5C2CE38CB4CF4B85",
      "text": "C’mon, now. At least introduce me![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
