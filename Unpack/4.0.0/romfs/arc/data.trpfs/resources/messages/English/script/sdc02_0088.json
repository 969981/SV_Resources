    },
    {
      "ordinal": 46,
      "label": "sdc02_0088_sister_19",
      "hash64": "D76E440265DD6D3E",
      "text": "This is Drayton...and he’s the worst.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
