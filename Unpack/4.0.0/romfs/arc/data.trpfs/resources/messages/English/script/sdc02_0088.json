    {
      "ordinal": 4,
      "label": "sdc02_0088_sister_03",
      "hash64": "D76B3A0265DB2669",
      "text": "Hehe... Honesty is the best policy, eh?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
