          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "sdc02_0088_sister_20",
      "hash64": "D771C30265E07AE2",
      "text": "He’s the strongest Trainer at Blueberry Academy.\\nWell, he WAS, at least.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
