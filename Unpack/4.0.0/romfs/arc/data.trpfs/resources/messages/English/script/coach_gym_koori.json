    {
      "ordinal": 57,
      "label": "coach_gym_koori_randomtalk_04",
      "hash64": "EBF1DB29191CA309",
      "text": "How’s that Cetoddle I traded you?\\c\\nHe has a tendency to wander off, so keep an eye\\non him during picnics and stuff.[VAR 0x0114(001A)]",
