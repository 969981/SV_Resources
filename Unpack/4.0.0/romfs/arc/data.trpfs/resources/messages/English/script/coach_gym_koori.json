    },
    {
      "ordinal": 35,
      "label": "coach_gym_koori_trade_02_01",
      "hash64": "15DC0B363F15BA32",
      "text": "You can’t trade Grusha a Pokémon if you aren’t\\nits original Trainer!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "coach_gym_koori_trade_02_02",
      "hash64": "15DC0A363F15B87F",
      "text": "You can’t trade Grusha such a rare Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "coach_gym_koori_trade_02_03",
      "hash64": "15DC09363F15B6CC",
      "text": "You can’t trade Grusha a Shiny Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "coach_gym_koori_trade_03_00",
      "hash64": "EAF1964188228434",
      "text": "Wait... Are you trying to trade away the only\\nPokémon in your party? That’s real uncool...\\c\\nCome back when you have at least two Pokémon\\nwith you.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
