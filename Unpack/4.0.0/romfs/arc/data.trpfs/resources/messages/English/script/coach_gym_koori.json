          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "coach_gym_koori_battlestart_00",
      "hash64": "F97E2A7B7EB088F2",
      "text": "Ugh, so uncool... But I guess dealing with stuff\\nlike this from time to time isn’t too bad.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
