          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_gym_koori_randomtalk_00",
      "hash64": "EBF1DF29191CA9D5",
      "text": "I’m not great with students... I just imagine how\\nthey might have to give up on their dreams in the\\r\\nfuture, and...it makes me feel so bad for ’em.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_gym_koori_randomtalk_01",
      "hash64": "EBF1DE29191CA822",
      "text": "Seems like some people have heard of me all the\\nway over here.\\c\\nThey keep asking me for photos... Taking one\\nwith you was enough for me, though.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_gym_koori_randomtalk_02",
      "hash64": "EBF1DD29191CA66F",
      "text": "The AC is way too strong in here. Aren’t you\\ncold, too?\\c\\nWho do I need to bother to get the heat\\nturned up?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
