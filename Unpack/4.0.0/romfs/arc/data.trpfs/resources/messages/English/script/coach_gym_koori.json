            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_gym_koori_first_01",
      "hash64": "C9ED52AC91ECBE89",
      "text": "The AC’s way too strong in here...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_gym_koori_sp01_00",
      "hash64": "D186977D9003E0F6",
      "text": "So, you’re the one who called me, huh?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_koori_sp01_01",
      "hash64": "D186987D9003E2A9",
      "text": "You DO know this is gonna be a major downer\\nfor the school, right?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_koori_sp01_02",
      "hash64": "D186957D9003DD90",
      "text": "I can’t imagine how having me around is going to\\nbenefit anybody here...[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_koori_sp01_select_01",
      "hash64": "16E2870749937938",
      "text": "That’s not true!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_gym_koori_sp01_select_02",
      "hash64": "16E28A0749937E51",
      "text": "You think...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_gym_koori_sp01_03",
      "hash64": "D186967D9003DF43",
      "text": "...You’re awfully sure about this. Where does that\\nconfidence come from?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_gym_koori_sp01_03b",
      "hash64": "0B90D85BB6942513",
      "text": "Hmph, I figured... You’re not sure about this\\neither, are you?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_gym_koori_sp01_04",
      "hash64": "D1869B7D9003E7C2",
      "text": "Well, I’m here anyway. I’m going to do my job.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_koori_sp01_05",
      "hash64": "D1869C7D9003E975",
      "text": "I am a professional, believe it or not...[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_koori_sp02_00",
      "hash64": "A2B0996582B268A9",
      "text": "You, huh...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_koori_sp02_01",
      "hash64": "A2B0986582B266F6",
      "text": "Have you been to the Polar Biome in the\\nTerarium? That place is pretty impressive.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_koori_sp02_02",
      "hash64": "A2B0976582B26543",
      "text": "The snow’s so soft and powdery... I can’t believe\\nit’s artificial.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_koori_sp02_03",
      "hash64": "A2B0966582B26390",
      "text": "Plenty of straight slopes, and lots of curves too.\\nIt’s perfect for snowboarding.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_gym_koori_sp02_select_01",
      "hash64": "0A146F6F18BACCD5",
      "text": "You’re gonna board?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_gym_koori_sp02_select_02",
      "hash64": "0A146C6F18BAC7BC",
      "text": "Let’s hit the slopes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_gym_koori_sp02_04",
      "hash64": "A2B09D6582B26F75",
      "text": "Oh, no, I didn’t mean it like that...[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_koori_sp02_05",
      "hash64": "A2B09C6582B26DC2",
      "text": "I can’t help but check out the slopes when I see\\nsnowy mountains. Old habits die hard.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_koori_sp02_06",
      "hash64": "A2B09B6582B26C0F",
      "text": "This academy’s something else though, eh?\\nBuilding a mountain like that on school grounds...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_koori_sp03_00",
      "hash64": "4DD3636F921AA518",
      "text": "I just came back from climbing that big mountain\\nin the Polar Biome.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_koori_sp03_01",
      "hash64": "4DD3646F921AA6CB",
      "text": "Cetoddle and the rest were all hyped to be on a\\nmountain other than Glaseado.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_koori_sp03_02",
      "hash64": "4DD3656F921AA87E",
      "text": "I guess it rubbed off on me. I just couldn’t resist\\nand, well...I had a few runs on my board.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_koori_sp03_select_03",
      "hash64": "3172AE49C79029EC",
      "text": "Niiice!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "coach_gym_koori_sp03_select_04",
      "hash64": "3172AD49C7902839",
      "text": "How’d it go?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "coach_gym_koori_sp03_03",
      "hash64": "4DD3666F921AAA31",
      "text": "Oh, the snow was good. Yeah... Real good.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_koori_sp03_04",
      "hash64": "4DD3676F921AABE4",
      "text": "I hadn’t boarded in a long time, so I think I got\\na bit too fired up.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_koori_sp03_05",
      "hash64": "4DD3686F921AAD97",
      "text": "You know, I’d made up my mind that I wouldn’t\\nsnowboard anymore...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_koori_sp03_06",
      "hash64": "4DD3696F921AAF4A",
      "text": "but maybe I can from time to time—just when\\nI’m here.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_koori_trade_01_00",
      "hash64": "C361CA51FA0A3C12",
      "text": "...Yeah, yeah, I’m weak-willed. Sorry.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_koori_trade_01_01",
      "hash64": "C361CB51FA0A3DC5",
      "text": "But if I’m gonna be uncool, I might as well lean\\ninto it. I’ve got another tiresome idea.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_koori_trade_01_02",
      "hash64": "C361C851FA0A38AC",
      "text": "What do you say we trade Pokémon?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_koori_trade_01_03",
      "hash64": "C361C951FA0A3A5F",
      "text": "Oh, you seriously want to? Well, OK.\\c\\nI’ll be trading a Cetoddle. What’ll you pick?[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_gym_koori_trade_01_04",
      "hash64": "C361C651FA0A3546",
      "text": "A [VAR 0x0101(0001)]... Yeah... That’s not bad.\\c\\nIt’d be way uncool if I raised your Pokémon\\npoorly. I’ll make sure to take good care of it.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_gym_koori_trade_02_00",
      "hash64": "15DC0C363F15BBE5",
      "text": "[VAR 0xBD06(0000)]All right. My Cetoddle for your\\n[VAR 0x0101(0001)],\\r\\nthen?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
