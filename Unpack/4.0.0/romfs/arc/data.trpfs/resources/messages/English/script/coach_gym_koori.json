      "hash64": "C9ED51AC91ECBCD6",
      "text": "Brrrrrr... I’m freezing.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
