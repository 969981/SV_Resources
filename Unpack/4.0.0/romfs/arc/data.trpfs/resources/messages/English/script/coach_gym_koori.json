            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "coach_gym_koori_battleend_win_00_01",
      "hash64": "BED50589952D5B4C",
      "text": "But I had fun. I think I learned a little something,\\ntoo.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
