    {
      "ordinal": 45,
      "label": "coach_gym_koori_battleend_win_00_00",
      "hash64": "BED50689952D5CFF",
      "text": "Oof... That’s what I call a sound defeat. The icy\\nbite of reality is harsh as always...[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
