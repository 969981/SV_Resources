          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "coach_gym_koori_talkto_00",
      "hash64": "9EAE8C073B56427B",
      "text": "What’s that look for? Do you want to battle me\\nor something?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
