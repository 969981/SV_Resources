    },
    {
      "ordinal": 39,
      "label": "coach_gym_koori_trade_03_01",
      "hash64": "EAF19741882285E7",
      "text": "...I was just kidding anyway. Don’t worry about it.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
