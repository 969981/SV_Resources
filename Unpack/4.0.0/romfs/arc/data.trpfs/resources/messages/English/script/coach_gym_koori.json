            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_gym_koori_cancel_00",
      "hash64": "283DD088E6A95068",
      "text": "Yep. That’s the right decision.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
