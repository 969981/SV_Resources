    {
      "ordinal": 50,
      "label": "coach_gym_koori_battleend_win_01_00",
      "hash64": "153AD09130971D6E",
      "text": "You really do seem to enjoy defeating me.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
