    },
    {
      "ordinal": 40,
      "label": "coach_gym_koori_trade_04_00",
      "hash64": "1C96886B415B5F1F",
      "text": "In the mood for something uncool? How about\\na Pokémon trade?[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
