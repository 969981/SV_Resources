          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "coach_gym_koori_battleend_lose_00_00",
      "hash64": "3899A1DFB3C87326",
      "text": "Listen, going easy on me’s not gonna make me\\nhappy, even if I do get to win.\\c\\nGo all out next time, OK?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
