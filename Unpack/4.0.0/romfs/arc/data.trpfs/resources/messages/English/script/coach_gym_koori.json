    {
      "ordinal": 51,
      "label": "coach_gym_koori_battleend_win_01_01",
      "hash64": "153AD19130971F21",
      "text": "Well, next time the result will be much cooler...\\nfor me and my team![VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
