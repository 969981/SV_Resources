          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "champ_0240_ground_04",
      "hash64": "7A09EAC76116B8B4",
      "text": "Hassel’s the Elite Four’s last line of defense.\\nI can’t wait to see how you’ll take him on![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "champ_0240_steel_01",
      "hash64": "EE68B9799860F2FF",
      "text": "It’s super amazing you defeated Mr. Larry![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
