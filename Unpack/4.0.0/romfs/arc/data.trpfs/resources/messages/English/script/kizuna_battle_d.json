  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_battle_d_01",
      "hash64": "5575ABBF491CF45B",
      "text": "Osu, new kid! You here to do a little shopping?[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_battle_d_select_01",
      "hash64": "81BF09B554170E22",
      "text": "Yep! I’m here to shop",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "kizuna_battle_d_select_02",
      "hash64": "81BF08B554170C6F",
      "text": "I came to see you",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_battle_d_02a",
      "hash64": "53EAF8093C36BE9D",
      "text": "The school store’s a nice place! They’ve got\\neverything you need right here![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_battle_d_02b",
      "hash64": "53EAF5093C36B984",
      "text": "Hahaha! So you came to see me, did you?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_battle_d_03",
      "hash64": "5575ADBF491CF7C1",
      "text": "I’m here to check out the sandwiches they’ve got\\nfor sale.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_battle_d_04",
      "hash64": "5575AEBF491CF974",
      "text": "The school store’s sandwiches taste great and\\nhave excellent nutritional balance, too![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_battle_d_select_03",
      "hash64": "81BF07B554170ABC",
      "text": "You’re not making your own?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_battle_d_select_04",
      "hash64": "81BF06B554170909",
      "text": "What happened to your intensive training?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_battle_d_05",
      "hash64": "5575AFBF491CFB27",
      "text": "Haha. I guess I’m just not used to it yet. All that\\ntraining kind of wore me out![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_battle_d_06",
      "hash64": "5575B0BF491CFCDA",
      "text": "I achieved my goal, anyway, so I’m going to take\\na break from sandwich making for a bit![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_battle_d_07",
      "hash64": "5575B1BF491CFE8D",
      "text": "Oh, right. I didn’t tell you what my goal was.\\c\\nI wanted to pay Nurse Miriam back for everything\\nshe does for me. It was my way of saying thanks![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_battle_d_08",
      "hash64": "5575A2BF491CE510",
      "text": "She’s so nice and so skilled at what she does.\\nI really look up to her![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_battle_d_09",
      "hash64": "5575A3BF491CE6C3",
      "text": "I wanted to try sandwich making so I could be\\nskilled at doing something for other people, like\\r\\nshe is, but I guess I just wasn’t cut out for it.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_battle_d_10",
      "hash64": "5578B0BF491F32B1",
      "text": "What I am cut out for, though, is being full of\\nenergy! So I decided to focus on that instead![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_battle_d_11",
      "hash64": "5578AFBF491F30FE",
      "text": "Like I said in class, I think people and Pokémon\\nshould make their strong points stronger![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_battle_d_12",
      "hash64": "5578AEBF491F2F4B",
      "text": "You really helped me out, new kid! Take this as\\nmy way of saying thanks.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_battle_d_13",
      "hash64": "5578ADBF491F2D98",
      "text": "All right, then! What should I go with today to\\nget my protein in?[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_battle_d_system_01",
      "hash64": "FDB0D9B2C190B2E5",
      "text": "You formed a close bond with Ms. Dendra!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
