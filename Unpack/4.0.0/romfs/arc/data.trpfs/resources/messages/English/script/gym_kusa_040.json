    {
      "ordinal": 0,
      "label": "gym_kusa_040_receptionist_00",
      "hash64": "E5D7268B429170E5",
      "text": "[VAR 0xBD06(0000)]Welcome to the Artazon Gym,\\n[VAR 0x0100(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
