          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_kusa_040_receptionist_01",
      "hash64": "E5D7258B42916F32",
      "text": "Are you ready to challenge Gym Leader Brassius,\\nthe Verdant Virtuoso?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "gym_kusa_040_receptionist_02",
      "hash64": "E5D7248B42916D7F",
      "text": "Very well. Allow me to show you to the\\nbattle court.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_kusa_040_receptionist_03",
      "hash64": "E5D7238B42916BCC",
      "text": "Of course. Please feel free to come speak to me\\nwhenever you’re ready.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_kusa_040_kusa_entry_01",
      "hash64": "D3E682F755C5BFCA",
      "text": "Greetings, challenger![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_kusa_040_kusa_entry_02",
      "hash64": "D3E681F755C5BE17",
      "text": "Hmph![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_kusa_040_kusa_01",
      "hash64": "C851674498B05DB7",
      "text": "You did well to come this far![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_kusa_040_kusa_15",
      "hash64": "C854E74498B36D0E",
      "text": "I am Brassius—an artist specializing in Grass-type\\nPokémon. I am also the Gym Leader here at the\\r\\nArtazon Gym.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_kusa_040_kusa_02",
      "hash64": "C851684498B05F6A",
      "text": "I was observing your Gym Test from atop the\\nwindmill, you know.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_kusa_040_kusa_03",
      "hash64": "C851694498B0611D",
      "text": "The perception you displayed in finding Sunflora\\nwas truly... Oh, how shall I describe it?[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_kusa_040_kusa_04",
      "hash64": "C851624498B05538",
      "text": "Yes! It was truly avant-garde![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_kusa_040_kusa_05",
      "hash64": "C851634498B056EB",
      "text": "I only pray that you might demonstrate that eye\\nfor beauty in our battle as well.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_kusa_040_kusa_06",
      "hash64": "C851644498B0589E",
      "text": "Enough talk! We must begin creating our\\ncollaborative work of art![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_kusa_040_kusa_07",
      "hash64": "C851654498B05A51",
      "text": "I trust that you are ready? It is time for our\\nmasterpiece to take shape![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_kusa_040_kari_01",
      "hash64": "FEE39416CE8828D4",
      "text": "[EMPTY 27]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_kusa_040_kusa_08",
      "hash64": "C8515E4498B04E6C",
      "text": "Oh! What artistic tactics you employ![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_kusa_040_kusa_09",
      "hash64": "C8515F4498B0501F",
      "text": "The patterns of your moves! The minute details\\nof your Pokémon’s performance! Everything you\\r\\ndid was honed to perfection![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_kusa_040_kusa_10",
      "hash64": "C854EC4498B3758D",
      "text": "Our battle was, in a word, art! Indeed, if we\\ncould not call that a work of artistry, then nothing\\r\\nelse in this world could be labeled as such![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_kusa_040_kusa_11",
      "hash64": "C854EB4498B373DA",
      "text": "If I were to judge your work, I would say it passes\\nmy inspection. Yes—a pass without exception![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_kusa_040_kusa_12",
      "hash64": "C854EA4498B37227",
      "text": "As proof of your artistic prowess, you may have\\nmy Gym Badge! Shall we take a photo as well?[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_kusa_040_kusa_badge",
      "hash64": "D96DC3A9668A77CF",
      "text": "If you possess [VAR 0x0200(0001)] Gym Badge[VAR 0x1101(0001,0100)]s, it will be easier\\nto catch Pokémon of up to Lv. [VAR 0x0201(0002)], and those\\r\\nPokémon should follow your commands as well![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_kusa_040_kusa_badge_all",
      "hash64": "BB17EC96877279A3",
      "text": "If you possess 8 Gym Badges, you will be able\\nto catch Pokémon of any level. And they will\\r\\nmost certainly obey your every command as well![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_kusa_040_kusa_waza",
      "hash64": "F4D3E5CC9B869585",
      "text": "To a fantastic Trainer such as yourself, I would\\nalso like to offer this—a favorite of mine![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_kusa_040_kusa_13",
      "hash64": "C854E94498B37074",
      "text": "Ah! My inspiration is overflowing, as if drawn\\nfrom a bottomless well![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_kusa_040_kusa_14",
      "hash64": "C854E84498B36EC1",
      "text": "I will begin on a new piece at once! You must\\nexcuse me. Farewell![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_kusa_040_receptionist_04",
      "hash64": "E5D7228B42916A19",
      "text": "Congratulations! You’re now certified by the\\nArtazon Gym!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
