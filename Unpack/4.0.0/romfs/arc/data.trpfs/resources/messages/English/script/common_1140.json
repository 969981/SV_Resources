    {
      "ordinal": 10,
      "label": "common_1140_botan_01",
      "hash64": "668DAE89C1A27258",
      "text": "But wait...why does it look like the whole place is\\nbeing swallowed up by crystals?[VAR 0x0114(0008)]",
