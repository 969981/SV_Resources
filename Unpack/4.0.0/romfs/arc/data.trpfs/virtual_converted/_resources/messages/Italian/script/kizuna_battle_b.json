    {
      "ordinal": 2,
      "label": "kizuna_battle_b_select_01",
      "hash64": "0AD49203C0A0F58C",
      "text": "Stavo per dire la stessa cosa!",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_battle_b_select_02",
      "hash64": "0AD49503C0A0FAA5",
      "text": "Che ci fa qui?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_battle_b_03",
      "hash64": "284775AC63350A17",
      "text": "Io? Beh, insomma...[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
