    {
      "ordinal": 7,
      "label": "common_0320_friend_01",
      "hash64": "BC71CF5D2B33EAFF",
      "text": "[VAR 0xBD06(0000)]Hello? This is [VAR 0x0100(0000)]’s\\nphone,\\r\\nright?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
