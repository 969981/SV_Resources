          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_event_tutorial_headbb_14",
      "hash64": "024BFE020AA29044",
      "text": "부실에 있는 PC로\\n초대할 사람이랑 연락해 보렴![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_event_tutorial_system_01",
      "hash64": "A020FDE452B989BB",
      "text": "여비랑 이것저것 챙겨 주는 데\\nBP가 필요하니까 이걸 사용하고.[VAR 0x0114(004B)]",
      "flags": 0,
