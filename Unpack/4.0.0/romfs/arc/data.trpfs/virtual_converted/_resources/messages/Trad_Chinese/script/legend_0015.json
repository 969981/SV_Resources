      "hash64": "2ABC17BB8F9E8665",
      "text": "洛托洛托洛托……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "legend_0015_cassiopeia_01",
      "hash64": "357DB39716622F2B",
      "text": "……[VAR 0x1100(00FF,0101)]你妳是[VAR 0x0100(0000)]，對吧？[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
