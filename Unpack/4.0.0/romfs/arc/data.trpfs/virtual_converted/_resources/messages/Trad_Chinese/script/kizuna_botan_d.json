    {
      "ordinal": 0,
      "label": "kizuna_botan_d_01",
      "hash64": "67612DCF024CCD23",
      "text": "啊，[VAR 0x0100(0000)]～[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
