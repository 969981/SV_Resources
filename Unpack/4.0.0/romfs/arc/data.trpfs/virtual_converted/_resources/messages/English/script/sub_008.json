    {
      "ordinal": 0,
      "label": "sub_008_master_01",
      "hash64": "800BD84176DAD8E9",
      "text": "Hey, I can put any Pokémon that’s Lv. 50 or\\nhigher through Hyper Training, if you’d like!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_008_master_02",
      "hash64": "800BD54176DAD3D0",
      "text": "Whaddya say? Do you want one of your\\nPokémon to go through Hyper Training?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_008_master_03",
      "hash64": "800BD64176DAD583",
      "text": "So, which Pokémon d’you want me to\\nHyper Train?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_008_master_cancel",
      "hash64": "A65424BE9F55C27C",
      "text": "Maybe another time, then...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_008_master_04",
      "hash64": "800BDB4176DADE02",
      "text": "Huh? Sorry, kid, but it looks like you don’t have\\nany Bottle Caps or Gold Bottle Caps.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_008_master_05",
      "hash64": "800BDC4176DADFB5",
      "text": "Your Pokémon can’t withstand Hyper Training\\nunless they’ve reached Lv. 50.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
