    {
      "ordinal": 34,
      "label": "sdc02_0050_headbb_14",
      "hash64": "94C4983947E18656",
      "text": "¡Qué elegancia! Toma, te voy a dar esto también.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
