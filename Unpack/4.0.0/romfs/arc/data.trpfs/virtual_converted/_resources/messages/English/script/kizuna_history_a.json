      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_history_a_05",
      "hash64": "363F0DB6BA159E1C",
      "text": "You would answer “new stuff” to me, your history\\nteacher? Ha! You really are a curious one.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
