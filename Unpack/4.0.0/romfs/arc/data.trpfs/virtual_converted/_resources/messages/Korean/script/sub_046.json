      ]
    },
    {
      "ordinal": 13,
      "label": "sub_046_child_f_13",
      "hash64": "AF529F0A305CBD79",
      "text": "언제든 보여 주러 와~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_046_child_f_14",
      "hash64": "AF52A00A305CBF2C",
      "text": "포켓몬과 함께 있다 보면\\n조금씩 친해지게 돼.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
