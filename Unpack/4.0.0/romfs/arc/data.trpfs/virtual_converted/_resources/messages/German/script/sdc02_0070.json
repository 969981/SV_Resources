      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0070_teacher_01",
      "hash64": "E7AD0FEE0DEEEFA2",
      "text": "Alola zusammen! Beginnen wir unseren heutigen\\nUnterricht.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_0070_teacher_02",
      "hash64": "E7AD0EEE0DEEEDEF",
      "text": "Wie es aussieht, haben wir auch [VAR 0x1100(00FF,090B,0000)]einen neueneine neue\\n[VAR 0x1100(00FF,0907,0000)]SchülerSchülerin in unserer Mitte. Willkommen!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "090B",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0907",
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0070_teacher_03",
      "hash64": "E7AD0DEE0DEEEC3C",
      "text": "Wie ihr vielleicht wisst, ist das Küsten-Areal\\neiner tropischen Insel nachempfunden.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sdc02_0070_teacher_04",
      "hash64": "E7AD0CEE0DEEEA89",
      "text": "Daher leben auch viele Pokémon hier, die sonst\\nin wärmerem Klima beheimatet sind.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc02_0070_teacher_05",
      "hash64": "E7AD0BEE0DEEE8D6",
      "text": "Beispielsweise gibt es da eine Art, die größer\\ngewachsen ist als in vielen anderen Regionen,\\r\\nweil sie besonders viel Licht abbekommen hat.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0070_teacher_06",
      "hash64": "E7AD0AEE0DEEE723",
      "text": "Bei solchen Pokémon-Arten, die in manchen\\nRegionen ein anderes Äußeres aufweisen,\\r\\nsprechen wir von [VAR 0xFF00(0006)]Regionalformen[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0070_teacher_07",
      "hash64": "E7AD09EE0DEEE570",
      "text": "Und das bringt mich zu eurer heutigen Aufgabe.\\c\\nIch möchte, dass ihr eine Regionalform fangt,\\ngenauer gesagt die [VAR 0xFF00(0006)]Alola-Form[VAR 0xFF00(0000)] eines Pokémon!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0070_teacher_08",
      "hash64": "E7AD18EE0DEEFEED",
      "text": "Wenn ihr erfolgreich wart, kommt bitte wieder\\nhierher und zeigt mir euren Fang.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0070_teacher_09",
      "hash64": "E7AD17EE0DEEFD3A",
      "text": "Dann mal auf mit euch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_0070_fairybb_05",
      "hash64": "6A30E8939BD6607F",
      "text": "Wir haben viel praxisorientierten Unterricht hier\\nan der Blaubeer-Akademie.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0070_fairybb_06",
      "hash64": "6A30E9939BD66232",
      "text": "Dann mal viel Erfolg, gib alles bei deiner ersten\\nAufgabe![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0070_fairybb_07",
      "hash64": "6A30EA939BD663E5",
      "text": "Weißt du, nach was für Pokémon du suchen\\nsollst?\\c\\nEin bekanntes Beispiel für die Alola-Form ist ein\\nKokowei mit einem gaaanz langen Hals![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0070_mob_01",
      "hash64": "83A86BC65CA24E32",
      "text": "Hey, wusstest du schon, dass Digdri in Alola\\nHaare haben? Total abgefahren, oder?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc02_0070_mob_02",
      "hash64": "83A86AC65CA24C7F",
      "text": "In der Alola-Region begrüßt man sich mit „Alola“!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc02_0070_mob_03",
      "hash64": "83A869C65CA24ACC",
      "text": "Äh, welche Pokémon haben noch mal eine\\nAlola-Form...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
