  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0190_system_01",
      "hash64": "6AB290F8091551F1",
      "text": "You found the [VAR 0xFF00(0008)]Teal Mask[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
