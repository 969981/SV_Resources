    {
      "ordinal": 5,
      "label": "gym_kusa_010_receptionist_05",
      "hash64": "C20C919C9FC7C8E3",
      "text": "Deine Aufgabe ist es also, Sonnflora in\\nBolardin zu finden.\\c\\nHalte Ausschau nach Pokémon, die wie\\nsonnenförmige Blumen aussehen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
