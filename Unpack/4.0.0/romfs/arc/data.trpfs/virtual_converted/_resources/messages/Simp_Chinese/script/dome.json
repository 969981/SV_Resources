      "label": "dome_center_square_npc_56",
      "hash64": "6FFF393B492DC8D2",
      "text": "在我的后面，\\n有招式学习器掉在地上哦。\\r\\n你捡了吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
