  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_008_woman_01",
      "hash64": "A2E66B60342948D4",
      "text": "Ooohohoho!\\nOoohohohooo![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_008_woman_02",
      "hash64": "A2E66E6034294DED",
      "text": "Eine Welt aus strahlendem Weiß, wohin man nur\\nsieht! Das ist wahrer Luxus.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_008_man_01",
      "hash64": "21F2B91E9A6ED63E",
      "text": "Und dank der Kleidung, die du mir zurechtgelegt\\nhast, spüre ich die Kälte genauso wenig wie die\\r\\nInflation![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_008_woman_03",
      "hash64": "A2E66D6034294C3A",
      "text": "Natürlich hält sie dich warm, schließlich handelt\\nes sich um Markenware aus den feinsten Stoffen.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_008_man_02",
      "hash64": "21F2B81E9A6ED48B",
      "text": "Mir tun die Leute leid, die ohne solche Kleidung\\nauf diesen Berg steigen müssen.[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_008_woman_04",
      "hash64": "A2E66860342943BB",
      "text": "Nanu? Sieh einer an, das Schicksal hat [VAR 0x1100(00FF,0303,0000)]ihnsie\\nwie erwartet erneut zu uns geführt.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_008_man_03",
      "hash64": "21F2B71E9A6ED2D8",
      "text": "Du hast recht! Das Schicksal – oder vielleicht\\ndie Geldnot – hat [VAR 0x1100(00FF,0303,0000)]ihnsie zweifelsohne wieder zu\\r\\nuns geführt![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_008_man_04",
      "hash64": "21F2BE1E9A6EDEBD",
      "text": "Aber sieh nur, wie dünn der Stoff [VAR 0x1100(00FF,0506,0000)]seinerihrer\\nKleidung ist, liebste Onea...[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0506",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_008_woman_05",
      "hash64": "A2E6676034294208",
      "text": "Das sieht wirklich schrecklich dünn aus...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_008_woman_06",
      "hash64": "A2E66A6034294721",
      "text": "Billy, meinst du, der Pöbel ist Kälte gegenüber\\nwiderstandsfähiger als wir?![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_008_man_05",
      "hash64": "21F2BD1E9A6EDD0A",
      "text": "Keine Ahnung... Aber wie es scheint, sind die\\nKleider dieser Menschen so luftig wie die Leere\\r\\nin ihren Geldbörsen.[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_008_man_06",
      "hash64": "21F2BC1E9A6EDB57",
      "text": "Vielleicht ist der Pöbel also wirklich aufgrund\\nseiner Armut an die Kälte gewöhnt?[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_008_woman_07",
      "hash64": "A2E669603429456E",
      "text": "Billy, du...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_008_woman_08",
      "hash64": "A2E6646034293CEF",
      "text": "Du bist ein Genie! Für diese Erkenntnis hast du\\ndir eine besondere Auszeichnung verdient:\\r\\nEine goldene Onea![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_008_man_07",
      "hash64": "21F2BB1E9A6ED9A4",
      "text": "Juchhu! Mein Dank gilt vor allem meinem Geld![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_008_woman_09",
      "hash64": "A2E6636034293B3C",
      "text": "Als VIPs ist es unsere Pflicht, dem Pöbel in der\\nNot die Hand entgegenzustrecken.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_008_woman_10",
      "hash64": "A2E2E660342630FE",
      "text": "Hier, das sollst du haben. Hoffentlich hilft es dir,\\nder Kälte weiterhin so tapfer zu trotzen![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_sub_008_woman_11",
      "hash64": "A2E2E760342632B1",
      "text": "Und lass mich noch ein bisschen meiner Weisheit\\nmit dir teilen...\\c\\n„Eine kalte Hand gehört einem warmen Herzen.“\\nDieses Sprichwort ist absoluter Humbug.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 154,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_sub_008_woman_12",
      "hash64": "A2E2E46034262D98",
      "text": "Merk dir das gut...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_sub_008_man_08",
      "hash64": "21F2B21E9A6ECA59",
      "text": "Liebste Onea, du schaust so weit über den\\nTellerrand, dass selbst deine Weisheiten keinerlei\\r\\nRegeln mehr folgen! Beeindruckend![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_sub_008_woman_13",
      "hash64": "A2E2E56034262F4B",
      "text": "Wie dem auch sei... Billy, unsere kleine Auszeit\\nnähert sich dem Ende.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_008_woman_14",
      "hash64": "A2E2EA60342637CA",
      "text": "Als krönenden Abschluss will ich ins [VAR 0xFF00(0006)]Zentrum[VAR 0xFF00(0000)] von\\nPaldea reisen und dort in die Tiefe hinabstarren![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 106,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_008_man_09",
      "hash64": "21F2B11E9A6EC8A6",
      "text": "Uh, là, là! Selbst auf die außergewöhnlichsten\\nOrte dieser Welt siehst du herab. Du bist einfach\\r\\ndie größte aller Jetsetterinnen![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_sub_008_man_10",
      "hash64": "21EFB41E9A6C97E8",
      "text": "Es ist gut möglich, dass wir den Schlund nicht\\nbetreten dürfen, aber ich werde trotzdem einen\\r\\nAntrag bei der Liga stellen.[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_sub_008_secretary_01",
      "hash64": "6AFA1D9089B75514",
      "text": "Señora Onea und Señor Billy wollten auf einen\\nBerg steigen, der „so hoch ist wie der Profit\\r\\nunserer Firma“. So der Wortlaut.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_008_secretary_02",
      "hash64": "6AFA209089B75A2D",
      "text": "Der einzige große Berg, der mir auf Anhieb\\neinfällt, ist der Montanata...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
