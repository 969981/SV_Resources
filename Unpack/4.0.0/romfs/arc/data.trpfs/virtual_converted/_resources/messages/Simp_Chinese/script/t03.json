{
  "version": "4.0.0",
  "language": "zh-Hans",
  "language_raw": "Simp_Chinese",
  "source": "message/dat/Simp_Chinese/script/t03.dat",
  "paired_tbl": "message/dat/Simp_Chinese/script/t03.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "t03_01",
      "hash64": "E3798BA06D461908",
      "text": "勤帮宝可梦回复体力！\\n看到商店就去买东西！\\r\\n这就是冒险的秘诀！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "t03_03",
      "hash64": "E3798DA06D461C6E",
      "text": "我用这辆卡车\\n运送橄榄。\\r\\n收获期总是忙得不可开交！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "t03_14",
      "hash64": "E37602A06D42FA66",
      "text": "“慕滋”卖的点心！\\n味道很～好，很受欢迎哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "t03_15",
      "hash64": "E37603A06D42FC19",
      "text": "圆模道馆的道馆馆主是\\n擅长对战的甜点师阿枫！\\r\\n可别因为她长得楚楚动人就大意哦。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "t03_16",
      "hash64": "E37600A06D42F700",
      "text": "圆模镇正在\\n庆祝橄榄丰收祭！\\r\\n道馆测验也配合丰收祭做了调整哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "t03_17",
      "hash64": "E37601A06D42F8B3",
      "text": "圆圆滚滚啪啦啦～！\\c\\n团珠蛛会穿着用丝做成的球保护自己，\\n消除来自外敌的威胁哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "t03_23",
      "hash64": "E372FDA06D40BC10",
      "text": "这里是圆模镇。\\n圆模也就是圆形的模子！\\r\\n和橄榄的形状一样呢！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "t03_28",
      "hash64": "E37308A06D40CEC1",
      "text": "据说彩粉蝶的样子\\n会根据栖息地而有所不同。\\c\\n这些家伙是从哪里来的呢？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "t03_39",
      "hash64": "E36F83A06D3DB6EB",
      "text": "在这家店可以一边喝茶，\\n一边观看道馆的对战。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
