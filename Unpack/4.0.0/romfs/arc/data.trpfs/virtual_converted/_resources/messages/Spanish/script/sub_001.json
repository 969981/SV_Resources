    {
      "ordinal": 42,
      "label": "sub_001_kimawari_02",
      "hash64": "2711287578B3D480",
      "text": "¡Has encontrado a un Sunflora!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "sub_001_kimawari_03",
      "hash64": "2711297578B3D633",
      "text": "¡Has encontrado [VAR 0x0201(0001)] Sunflora!\\nLlévalo[VAR 0x1101(0001,0100)]s a la Plaza Sunflora.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sub_001_kimawari_04",
      "hash64": "27112E7578B3DEB2",
      "text": "¡Has encontrado a todos los Sunflora repartidos\\npor Pueblo Altamía! Llévalos a la Plaza Sunflora.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "sub_001_kimawari_05",
      "hash64": "27112F7578B3E065",
      "text": "[EMPTY 87]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0057"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "sub_001_keeper_01",
      "hash64": "B1C254ED006DD28A",
      "text": "¡Enhorabuena por superar el Gimnasio de\\nPueblo Altamía! Cómo brilla la medalla, ¿eh?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 47,
      "label": "sub_001_keeper_02",
      "hash64": "B1C253ED006DD0D7",
      "text": "[EMPTY 87]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0057"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sub_001_keeper_03",
      "hash64": "B1C252ED006DCF24",
      "text": "¡Has hecho un trabajo espléndido reuniendo\\nSunflora en tu examen de gimnasio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 49,
      "label": "sub_001_keeper_04",
      "hash64": "B1C251ED006DCD71",
      "text": "Lo has hecho tan bien que los Sunflora también\\nestán encantados contigo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 50,
      "label": "sub_001_keeper_05",
      "hash64": "B1C250ED006DCBBE",
      "text": "Dime, ¿te gustaría pasar un rato más buscando\\nSunflora?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "sub_001_keeper_06",
      "hash64": "B1C24FED006DCA0B",
      "text": "¡Qué contentos se van a poner! Más que cuando\\ntoman el sol. Van a florecer con una sonrisa.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "sub_001_keeper_07",
      "hash64": "B1C24EED006DC858",
      "text": "Bueno, les voy a pedir que se repartan por todo\\nel pueblo, entonces.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "sub_001_kimawari_06",
      "hash64": "27112C7578B3DB4C",
      "text": "¡Floraaa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 54,
      "label": "sub_001_keeper_09",
      "hash64": "B1C24CED006DC4F2",
      "text": "Vale, ¡eso quiere decir que ya están listos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "sub_001_keeper_10",
      "hash64": "B1BF4FED006B9434",
      "text": "Hay [VAR 0x0201(0001)] Sunflora escondidos en Pueblo Altamía.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "sub_001_keeper_10b",
      "hash64": "73A925B7B6CD0E22",
      "text": "Solo queda un Sunflora escondido en\\nPueblo Altamía.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
