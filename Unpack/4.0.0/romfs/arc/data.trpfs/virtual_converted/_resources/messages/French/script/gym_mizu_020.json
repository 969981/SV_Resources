          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_mizu_020_receptionist_03",
      "hash64": "5A1F63160267B2A5",
      "text": "[EMPTY 67]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_mizu_020_trainer_01a",
      "hash64": "033215E8AA805C80",
      "text": "Qu’est-ce que tu fais encore là, toi ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mizu_020_mizu_26",
      "hash64": "93117A305CF60F00",
      "text": "Oh... ! Non, c’est pas vrai !\\nMais qu’est-ce que j’en ai fait ?![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_mizu_020_mizu_27",
      "hash64": "93117B305CF610B3",
      "text": "Mon portefeuille ! Je l’ai perduuu !!![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_mizu_020_mizu_28",
      "hash64": "931188305CF626CA",
      "text": "Si je trouve pas une solution, tous les articles\\ndu jour vont me passer sous la barbe ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_mizu_020_mizu_29",
      "hash64": "931189305CF6287D",
      "text": "Snif...[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mizu_020_trainer_01b",
      "hash64": "033218E8AA806199",
      "text": "Allons, Chef, pas d’inquiétude ! Je pars de\\nce pas à la recherche de votre portefeuille !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_020_trainer_02",
      "hash64": "0B79F51B0482ECC8",
      "text": "Qu’est-ce qu’il y a ?\\nSi tu veux voir le chef, sache qu’il est occupé, là.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_020_trainer_03",
      "hash64": "0B79F61B0482EE7B",
      "text": "Qui que tu sois, un conseil : nous embête pas ou\\nt’auras affaire à moi.\\c\\nEt j’te préviens, je suis son meilleur apprenti !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_020_trainer_04",
      "hash64": "0B79FB1B0482F6FA",
      "text": "À moins que... t’aies une raison de nous\\ndéranger ? Si oui, elle a intérêt à être bonne...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_020_select_a",
      "hash64": "3ECD48AC469CDCAC",
      "text": "Elle est excellente !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_020_select_b",
      "hash64": "3ECD4BAC469CE1C5",
      "text": "Non, pas vraiment...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_020_trainer_05",
      "hash64": "0B79FC1B0482F8AD",
      "text": "Rentre chez toi, alors !\\nOn a pas de temps à perdre, nous !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_020_trainer_06",
      "hash64": "0B79F91B0482F394",
      "text": "Je vois que t’es du genre borné, comme gamin[VAR 0x1100(00FF,0100)]e.\\nJe vais te remettre les idées en place.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_020_trainer_07",
      "hash64": "0B79FA1B0482F547",
      "text": "T’es... t’es vraiment balèze ! Au final, c’est toi\\nqui m’as donné une bonne leçon...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "gym_mizu_020_mizu_01",
      "hash64": "930AF5305CF0C153",
      "text": "Eh bien alors, c’est quoi ce boucan ?[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_mizu_020_trainer_08",
      "hash64": "0B79EF1B0482E296",
      "text": "Oh ! C-chef Kombu !\\nEh bien, c’est cette personne qui...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "gym_mizu_020_mizu_02",
      "hash64": "930AF6305CF0C306",
      "text": "Hein ? Tu es un[VAR 0x1100(00FF,0100)]e client[VAR 0x1100(00FF,0100)]e du restaurant, c’est ça ?\\c\\nJ’ai des soucis, là. J’ai perdu mon portefeuille...\\nAlors, qu’est-ce que tu veux ?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_mizu_020_select_01",
      "hash64": "54C29DBBFD75281A",
      "text": "Tenez, c’est à vous !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "gym_mizu_020_select_02",
      "hash64": "54C29CBBFD752667",
      "text": "Vous avez oublié quelque chose !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "gym_mizu_020_system_01",
      "hash64": "C22350BAFFC104CD",
      "text": "Vous rendez son portefeuille à Kombu.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "gym_mizu_020_mizu_03",
      "hash64": "930AF7305CF0C4B9",
      "text": "Ça alors ?! Mais c’est mon portefeuille ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_mizu_020_mizu_04",
      "hash64": "930AF8305CF0C66C",
      "text": "Comment ? C’est quelqu’un à la réception\\nde l’Arène qui t’a demandé de me le rapporter ?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_mizu_020_mizu_05",
      "hash64": "930AF9305CF0C81F",
      "text": "Mouah ha ha ! Je te remercie d’avoir fait\\ntout ce chemin pour moi, petit[VAR 0x1100(00FF,0100)]e ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_mizu_020_mizu_06",
      "hash64": "930AFA305CF0C9D2",
      "text": "Oh, et puis, désolé pour mon second,\\nil manque un peu de bonnes manières.[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "gym_mizu_020_mizu_07",
      "hash64": "930AFB305CF0CB85",
      "text": "Il y a certains articles des fameuses [VAR 0xFF00(0006)]enchères[VAR 0xFF00(0000)] de\\nPorto Marinada qu’on voulait acheter à tout prix ![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "gym_mizu_020_mizu_08",
      "hash64": "930AFC305CF0CD38",
      "text": "Alors faut nous comprendre, on était un peu sur\\nles nerfs avec cette histoire de portefeuille...\\c\\nJ’ai pas été chouette non plus, alors en fait,\\nje te demande de nous excuser, tous les deux.[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 192,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "gym_mizu_020_shop_01",
      "hash64": "4C49FA89878568CE",
      "text": "Allons, allons, approchez messieurs-dames !\\nVoici notre tout dernier lot ! À ne pas rater !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "gym_mizu_020_mizu_09",
      "hash64": "930AFD305CF0CEEB",
      "text": "Hmmm... ?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "gym_mizu_020_shop_02",
      "hash64": "4C49F9898785671B",
      "text": "Voici la pièce maîtresse des enchères du jour !\\c\\nEh oui ! Vous ne rêvez pas : ce sont bien\\nles légendaires algues wakamé de Hoenn !\\r\\nAvons-nous un acheteur ou une acheteuse ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "gym_mizu_020_mizu_10",
      "hash64": "930E7A305CF3D929",
      "text": "Nom d’un Hastacuda ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "gym_mizu_020_mizu_11",
      "hash64": "930E79305CF3D776",
      "text": "Un coup d’œil suffit pour savoir que ces algues\\nsouples regorgent de bons nutriments ![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "gym_mizu_020_mizu_12",
      "hash64": "930E78305CF3D5C3",
      "text": "Regarde comment elles reflètent la lumière...\\nOn les croirait lustrées par les vents marins ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_mizu_020_mizu_13",
      "hash64": "930E77305CF3D410",
      "text": "Oh là là, et ce parfum... On sent qu’elles sont\\nfraîches ! On dirait qu’elles ont été remontées\\r\\nà l’instant ![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "gym_mizu_020_mizu_14",
      "hash64": "930E7E305CF3DFF5",
      "text": "Il me faut absolument ces algues !!![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "gym_mizu_020_mizu_15",
      "hash64": "930E7D305CF3DE42",
      "text": "Si tu veux pouvoir me défier à l’Arène, y va\\nfalloir me prouver que t’en as dans le ciboulot.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "gym_mizu_020_mizu_16",
      "hash64": "930E7C305CF3DC8F",
      "text": "Et ces enchères, c’est l’occasion parfaite !\\nEssaie de les remporter pour moi, tu veux ?[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "gym_mizu_020_select_03",
      "hash64": "54C29BBBFD7524B4",
      "text": "Euh, c’est quoi, des enchères ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "gym_mizu_020_select_04",
      "hash64": "54C29ABBFD752301",
      "text": "D’accord, je vais essayer !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "gym_mizu_020_mizu_17",
      "hash64": "930E7B305CF3DADC",
      "text": "Dans des enchères, t’es en compétition contre\\nd’autres clients !\\c\\nEn fonction de l’argent que t’as, tu fais une offre\\nsur un article, et celui qui finit avec l’offre\\r\\nla plus élevée remporte le droit de l’acheter ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 218,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "gym_mizu_020_mizu_18",
      "hash64": "930E82305CF3E6C1",
      "text": "Tu connais déjà les règles des enchères\\nà ton âge ?! J’en perds ma toque ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "gym_mizu_020_mizu_19",
      "hash64": "930E81305CF3E50E",
      "text": "Tiens, voilà de l’argent pour enchérir sans\\nte retenir ! Je compte sur toi pour me rapporter\\r\\nces algues ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "gym_mizu_020_seri_01",
      "hash64": "E9E0F72565D1DA3D",
      "text": "Tout le monde est prêt ?\\nLes enchères vont commencer !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "gym_mizu_020_seri_02",
      "hash64": "E9E0F42565D1D524",
      "text": "Nous avons donc ici de belles algues wakamé\\nde Hoenn ! La mise à prix est à [VAR 0x0205(0001,0020)]  !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
