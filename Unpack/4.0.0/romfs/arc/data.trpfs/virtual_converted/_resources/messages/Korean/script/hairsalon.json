          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 96,
      "label": "hairsalon_win_00_10",
      "hash64": "F68572917F647CE0",
      "text": "그럼, 요금을 받을게.\\n[VAR 0x0206(0000,0000)]원이야!\\r\\n지불은 어떻게 할래?",
      "flags": 0,
