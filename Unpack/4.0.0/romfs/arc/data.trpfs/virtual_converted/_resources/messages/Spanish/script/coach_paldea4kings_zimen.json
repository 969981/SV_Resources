    },
    {
      "ordinal": 2,
      "label": "coach_paldea4kings_zimen_sp01_00",
      "hash64": "743CA50901C57281",
      "text": "No me esperaba que me llamaras tú\\ndirectamente, ¡qué sorpresa![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
