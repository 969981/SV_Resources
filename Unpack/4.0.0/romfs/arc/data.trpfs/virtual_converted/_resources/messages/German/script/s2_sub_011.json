  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_011_girl_01",
      "hash64": "EB85F4E3122FF757",
      "text": "Hallihalola! Ich bin total versessen auf Pokémon\\naus Alola!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_011_girl_02",
      "hash64": "EB85F5E3122FF90A",
      "text": "Ich würd so gern mal einen Blick auf ein Geowaz\\naus Alola werfen!\\c\\nDu hast nicht zufällig ein Exemplar in deinem\\nTeam oder in deinen Boxen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_011_girl_03",
      "hash64": "EB85F6E3122FFABD",
      "text": "Menno... Ob ich wohl jemals ein Alola-Geowaz\\nzu Gesicht bekommen werde?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_011_girl_04",
      "hash64": "EB85EFE3122FEED8",
      "text": "Aber... das ist doch gar kein Geowaz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_011_girl_05",
      "hash64": "EB85F0E3122FF08B",
      "text": "Das ist doch ein stinknormales Geowaz...\\nIch suche nach einem Exemplar aus Alola!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_011_girl_06",
      "hash64": "EB85F1E3122FF23E",
      "text": "Wooooow! Das ist ja tatsächlich ein Geowaz aus\\nder Alola-Region!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_011_girl_07",
      "hash64": "EB85F2E3122FF3F1",
      "text": "Sieh dir nur mal die exotischen Fortsätze über\\nseinem Kopf an! Und erst die imposanten\\r\\nAugenbrauen und der dichte Bart!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_011_girl_08",
      "hash64": "EB85EBE3122FE80C",
      "text": "Geowaz entwickelt sich via Tausch, musst du\\nwissen. Vielleicht findet man deshalb nur ganz\\r\\nselten wilde Exemplare...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_011_girl_09",
      "hash64": "EB85ECE3122FE9BF",
      "text": "Als kleines Dankeschön zeige ich dir eine Pose,\\ndie perfekt zu Alola und diesem Geowaz passt.\\c\\nProbier sie einfach selbst mal aus!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_011_system_01",
      "hash64": "340BF1E47E73D21E",
      "text": "Das Mädchen hat dir die [VAR 0xFF00(0008)]Voltium Z[VAR 0xFF00(0000)]-Pose\\nbeigebracht!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_011_girl_npc",
      "hash64": "392CDFD8F127896B",
      "text": "Bei dieser Pose kommt alles auf den richtigen\\nWinkel der Hände an. Und immer daran denken,\\r\\nlaut und deutlich „Alola“ zu rufen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    }
  ]
}
