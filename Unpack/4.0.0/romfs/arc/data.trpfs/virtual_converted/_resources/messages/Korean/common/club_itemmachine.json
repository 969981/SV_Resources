      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 46,
      "label": "club_itemmachine_msg_01_00",
      "hash64": "48CA435C274C3843",
      "text": "출력된 도구는\\n가방에 넣어 둘게!",
