      "hash64": "DCED0E9906C263F5",
      "text": "焙固道馆的道馆测验是……\\n做[VAR 0xFF00(0006)]体操[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
