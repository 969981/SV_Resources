      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_0340_bbteacher_02",
      "hash64": "27CFD18BC7D5A879",
      "text": "Oh, thank goodness... What a relief...[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
