      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_a_06_ecology_answer_01",
      "hash64": "886153BB6C0A8C32",
      "text": "Sarebbe bello se ce ne fossero tanti, così\\npotremmo studiarli facilmente, ma purtroppo\\r\\nsono mooolto più rari.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
