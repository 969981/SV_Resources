  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_018_woman_01",
      "hash64": "2E13479A8E038F9F",
      "text": "Comment on est trop bien ensemble,\\ntu trouves pas ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s1_sub_018_man_01",
      "hash64": "A4BEB69B60D0EE99",
      "text": "Si, carrément, bébé ! Je suis sûr qu’y a pas plus\\nbeau duo au monde, même parmi les Pokémon !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_018_woman_02",
      "hash64": "2E13489A8E039152",
      "text": "C’est clair !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_018_woman_03",
      "hash64": "2E13499A8E039305",
      "text": "... Hé ! Toi, là...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_018_woman_04",
      "hash64": "2E13429A8E038720",
      "text": "Si tu vois un Pokémon aussi in love que nous,\\nviens nous le montrer !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s1_sub_018_man_02",
      "hash64": "A4BEB39B60D0E980",
      "text": "Mais je pense pas que tu trouveras, parce qu’on\\nest vraiment un couple inséparable ! Ha ha ha !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s1_sub_018_woman_05",
      "hash64": "2E13439A8E0388D3",
      "text": "Alors, t’as trouvé un Pokémon dévoué\\ncœur et âme à son partenaire ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_018_man_03",
      "hash64": "A4BEB49B60D0EB33",
      "text": "Tu vois ! Je t’avais bien dit que ça existait pas !\\nHa ha ha !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s1_sub_018_man_04",
      "hash64": "A4BEB99B60D0F3B2",
      "text": "Ce Pokémon...\\c\\nIl m’a pas l’air particulièrement amoureux !\\nHa ha ha !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_018_man_05",
      "hash64": "A4BEBA9B60D0F565",
      "text": "Qu’est-ce que... Un Compagnol ?!\\c\\nTu dis qu’ils sont toujours par deux, collés\\nl’un à l’autre comme un adorable petit couple ?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_018_man_06",
      "hash64": "A4BEB79B60D0F04C",
      "text": "Qu’est-ce que... Un Famignol ?!\\c\\nIls sont tellement fusionnels... qu’un adorable\\npetit est né de leur amour ?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_018_man_07",
      "hash64": "A4BEB89B60D0F1FF",
      "text": "Qu’est-ce que... Un Famignol ?!\\c\\nAvec deux petits... Une famille entière, soudée\\npar l’amour ? Trop de love, j’étais pas prêt !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_018_woman_06",
      "hash64": "2E13449A8E038A86",
      "text": "Alors ça existe... des Pokémon qui se quittent\\npas une seconde, comme nous !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s1_sub_018_woman_07",
      "hash64": "2E13459A8E038C39",
      "text": "Merci de nous avoir montré ce Pokémon !\\c\\nPour te remercier, on va t’apprendre à envoyer\\ndu love, toi aussi !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_018_system_01",
      "hash64": "715C9973D3928E94",
      "text": "Le couple vous a appris les réactions\\n[VAR 0xFF00(0008)]Cœur en duo (droite) [VAR 0xFF00(0000)]et [VAR 0xFF00(0008)]Cœur en duo (gauche)[VAR 0xFF00(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_018_woman_npc",
      "hash64": "4173059D9564CBB3",
      "text": "Cette réaction est plus sympa à deux.\\nTu devrais l’essayer avec quelqu’un !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s1_sub_018_man_npc",
      "hash64": "89644607171F7931",
      "text": "Êtres humains ou Pokémon, c’est la même :\\ndu love partout, c’est ça qu’on aime !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
