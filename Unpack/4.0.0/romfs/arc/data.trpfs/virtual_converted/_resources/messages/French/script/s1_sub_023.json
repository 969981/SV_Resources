    },
    {
      "ordinal": 2,
      "label": "s1_sub_023_system_01",
      "hash64": "0619F6D37C8882D2",
      "text": "Votre Motismart a été mis à jour !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_023_man_03",
      "hash64": "43C8BB97245D5BBD",
      "text": "Ah, c’est beau, la technologie !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_023_man_04",
      "hash64": "43C8B497245D4FD8",
      "text": "Veux-tu que l’affichage de certaines applications\\ns’adapte à la coque de ton Motismart ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s1_sub_023_select_01",
      "hash64": "75BE813B0D65F0C5",
      "text": "Oui",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s1_sub_023_select_02",
      "hash64": "75BE7E3B0D65EBAC",
      "text": "Non",
      "flags": 0,
