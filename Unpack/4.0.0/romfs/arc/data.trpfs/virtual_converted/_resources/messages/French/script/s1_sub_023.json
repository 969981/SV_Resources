    },
    {
      "ordinal": 1,
      "label": "s1_sub_023_man_02",
      "hash64": "43C8BA97245D5A0A",
      "text": "Oh, tu as un Motismart ! Ça tombe bien,\\nj’ai une super mise à jour pour lui !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
