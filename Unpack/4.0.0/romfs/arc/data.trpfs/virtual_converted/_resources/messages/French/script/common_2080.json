          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2080_rival_02",
      "hash64": "9C0D5C3D3BBC2227",
      "text": "Pour participer au Grand Tournoi de l’Académie,\\nil faut que tu t’inscrives à la réception ![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2080_rival_03",
      "hash64": "9C0D5B3D3BBC2074",
      "text": "Vous pouvez lui expliquer le principe\\ndu tournoi, s’il vous plaît ?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2080_staff_01",
      "hash64": "B6EF1D39889F0EA4",
      "text": "Bien sûr ! Les règles du Grand Tournoi de\\nl’Académie sont simples :\\c\\nIl s’agit d’une suite de combats éliminatoires\\nauxquels peuvent participer élèves et enseignants.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2080_staff_02",
      "hash64": "B6EF2039889F13BD",
      "text": "Les adversaires seront tirés au sort par\\nles organisateurs.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_2080_staff_03",
      "hash64": "B6EF1F39889F120A",
      "text": "Cela signifie que vous saurez qui vous affronterez\\nseulement à votre arrivée sur le terrain.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_2080_staff_04",
      "hash64": "B6EF1A39889F098B",
      "text": "Celui ou celle qui remporte le combat pourra\\npasser au tour suivant.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_2080_staff_05",
      "hash64": "B6EF1939889F07D8",
      "text": "Attention : la défaite est éliminatoire ! Perdre\\nun combat signifiera la fin du tournoi pour vous.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_2080_staff_06",
      "hash64": "B6EF1C39889F0CF1",
      "text": "Pour résumer, les combats se poursuivront\\njusqu’à ce qu’il ne reste qu’une personne en jeu.\\c\\nEt cette personne obtiendra le titre de meilleur\\nDresseur, ou meilleure Dresseuse de l’académie !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2080_rival_04",
      "hash64": "9C0D5A3D3BBC1EC1",
      "text": "Merci pour les explications ![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2080_rival_05",
      "hash64": "9C0D593D3BBC1D0E",
      "text": "On a établi ces règles avec l’aide\\nde monsieur Clavel ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2080_rival_06",
      "hash64": "9C0D583D3BBC1B5B",
      "text": "Pour le moment, vu le nombre de participants,\\ntu peux gagner le tournoi après quatre victoires ![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2080_rival_07",
      "hash64": "9C0D573D3BBC19A8",
      "text": "Mais attention, car les profs qui participent vont\\npas y aller de main morte ! Bonne chance ![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2080_rival_08",
      "hash64": "9C0D563D3BBC17F5",
      "text": "En tout cas, t’as intérêt à gagner ! Oublie pas\\nqu’il y a que moi qu’ai le droit de te battre ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2080_staff_07",
      "hash64": "B6EF1B39889F0B3E",
      "text": "Quand vous serez prêt[VAR 0x1100(00FF,0100)]e, faites-moi signe.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    }
  ]
