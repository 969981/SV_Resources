  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_4kings_b_01_clerk_00",
      "hash64": "6F0523D6EB0928C2",
      "text": "¡Hola! Puedes pasearte por la sede de nuestro\\nequipo del Alto Mando todo lo que quieras.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_b_01_clerk_01",
      "hash64": "6F0524D6EB092A75",
      "text": "¡Bienvenid[VAR 0x1100(00FF,0101)]oa a la Plaza Escarpada, sede del\\nequipo de Nerina del Alto Mando!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_b_01_clerk_02",
      "hash64": "6F0521D6EB09255C",
      "text": "Imagino que vienes a participar en calidad de\\naspirante de la Liga Arándano.\\c\\nA ver, te llamabas... [VAR 0x0100(0000)], ¿verdad?",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_b_01_clerk_03",
      "hash64": "6F0522D6EB09270F",
      "text": "Para afrontar el reto del Alto Mando deberás\\nabonar 50 PA. ¿Quieres hacer el pago ahora?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_b_01_clerk_04",
      "hash64": "6F051FD6EB0921F6",
      "text": "Vaya, parece que no tienes suficientes PA...\\c\\nSigue completando TEA y vuelve cuando hayas\\nreunido unos cuantos puntos más.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_b_01_system_01",
      "hash64": "876FD5B083B0E1A9",
      "text": "¡Has abonado 50 PA!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_b_01_clerk_05",
      "hash64": "6F0520D6EB0923A9",
      "text": "Recibido el pago y todo en regla. ¡Perfecto!\\n¡Muchas gracias por tu contribución!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_b_01_clerk_06",
      "hash64": "6F051DD6EB091E90",
      "text": "Llamando a su excelencia... ¡Nerina!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
