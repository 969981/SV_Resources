    {
      "ordinal": 0,
      "label": "atlantis_talk_03_friend_01a",
      "hash64": "4341E6CA679E6C04",
      "text": "以前为了见我妈\\n而来帕底亚巨坑的时候……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
