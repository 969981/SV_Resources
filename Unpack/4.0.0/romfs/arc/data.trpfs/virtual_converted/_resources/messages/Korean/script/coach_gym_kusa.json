      "ordinal": 42,
      "label": "coach_gym_kusa_trade_04_00",
      "hash64": "71927D95957453C5",
      "text": "포켓몬 교환을 할 결심이 섰나?[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
