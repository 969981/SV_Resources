    {
      "ordinal": 7,
      "label": "kizuna_home_a_06",
      "hash64": "747FB85472A8FE20",
      "text": "家政教室這裡是學生的休憩場所。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
