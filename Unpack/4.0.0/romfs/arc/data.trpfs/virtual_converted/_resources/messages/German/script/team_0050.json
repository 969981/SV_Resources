    {
      "ordinal": 46,
      "label": "team_0050_botan_17",
      "hash64": "B1BDF339D0C31A4E",
      "text": "Hm. Jetzt habe ich ganz schön viel geredet.\\nMeine Kehle ist schon ganz trocken...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
