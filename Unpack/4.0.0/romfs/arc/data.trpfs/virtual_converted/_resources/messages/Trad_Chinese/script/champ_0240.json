        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "champ_0240_fly_14",
      "hash64": "5B0095EB25E87A2B",
      "text": "……八朔一開始說教，\\n是會沒完沒了的呢。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
