    },
    {
      "ordinal": 1,
      "label": "s2_sub_040_teacher_01",
      "hash64": "EB837EC0B45CBB4B",
      "text": "Oh, tu es l’élève en échange scolaire !\\nJe suis conseillère d’orientation.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_040_teacher_02",
      "hash64": "EB837FC0B45CBCFE",
      "text": "Je vais entrer directement dans le vif du sujet :\\nt’adonnes-tu aux combats Pokémon ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_040_teacher_03",
      "hash64": "EB8380C0B45CBEB1",
      "text": "À l’institut, nous encourageons nos élèves\\nà se mesurer les uns aux autres lors de\\r\\ncombats Pokémon.\\c\\nJe t’offrirai donc des PM si tu livres des combats\\ncontre tes camarades sous le dôme.\\r\\nPlus tu en feras et plus tu recevras de PM !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
