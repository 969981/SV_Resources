      "hash64": "7C9CA8CA2AD22CBC",
      "text": "La conseillère d’orientation vous donne\\n[VAR 0x0204(0001,0020)] PM !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
