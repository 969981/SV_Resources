      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "sdc02_0180_announce_02",
      "hash64": "671B71F0D8D8EBC8",
      "text": "A Championship match is about to begin at the\\nbattle court near the entrance to the academy.",
      "flags": 4,
      "text_status": "DECODED",
