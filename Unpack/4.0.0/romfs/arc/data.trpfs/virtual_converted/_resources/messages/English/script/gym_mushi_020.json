    },
    {
      "ordinal": 27,
      "label": "gym_mushi_020_select_01",
      "hash64": "8B7B0826C1D6E9A3",
      "text": "I’ll keep going",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "gym_mushi_020_select_02",
      "hash64": "8B7B0926C1D6EB56",
      "text": "I’d like to quit",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "gym_mushi_020_trainer_19",
      "hash64": "5BE4B32D0541B7D3",
      "text": "If you’re looking for a shortcut, you gotta earn it!\\nYou’re not getting past me easily!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "gym_mushi_020_trainer_21",
      "hash64": "5BEEAB2D0549FEC0",
      "text": "Even the Smoliv can tell how strong you are!\\nThey’ll step aside for you now.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "gym_mushi_020_trainer_20",
      "hash64": "5BEEAC2D054A0073",
      "text": "I got in the way of your olive rolling because I\\nwanted you to see how tough it is to grow olives!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "gym_mushi_020_ui_01",
      "hash64": "0252BBB540E60E61",
      "text": "Give Up",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
