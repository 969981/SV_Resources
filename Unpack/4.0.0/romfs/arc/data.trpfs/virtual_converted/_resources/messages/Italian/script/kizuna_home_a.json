      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_home_a_07",
      "hash64": "747FB95472A8FFD3",
      "text": "Amano tutti passare il tempo a spettegolare\\nmentre fanno merenda.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_home_a_08",
      "hash64": "747FC65472A915EA",
      "text": "E così, visto che recentemente non fanno che\\nparlare di te, [VAR 0x0100(0000)], hai suscitato\\r\\nanche il mio interesse.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
