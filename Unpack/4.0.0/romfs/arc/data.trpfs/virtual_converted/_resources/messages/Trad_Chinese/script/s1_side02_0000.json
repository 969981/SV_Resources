    {
      "ordinal": 1,
      "label": "s1_side02_0000_camera_02",
      "hash64": "EFBD2BB47EB4A78D",
      "text": "……哦，怎麼了怎麼了？\\n我完全沒注意到[VAR 0x1100(00FF,0101)]你妳。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
