          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_c_03_history_12",
      "hash64": "94BDF1C7582397BA",
      "text": "Mal sehen, ob du gut zugehört hast.\\c\\nVor wie vielen Jahren wurde diese Akademie\\ngegründet?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_c_03_select_01",
      "hash64": "7419CCAB22A1E09A",
      "text": "Vor etwa 600 Jahren.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_c_03_select_02",
      "hash64": "7419CBAB22A1DEE7",
      "text": "Vor etwa 700 Jahren.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_c_03_select_03",
      "hash64": "7419CAAB22A1DD34",
      "text": "Vor etwa 800 Jahren.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_c_03_history_answer_01",
      "hash64": "0CF29B46CA4E3EE3",
      "text": "Falsch! Da fehlen noch ganze 200 Jahre.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_c_03_history_answer_02",
      "hash64": "0CF29C46CA4E4096",
      "text": "Falsch! Da fehlen noch ganze 100 Jahre.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_c_03_history_answer_03",
      "hash64": "0CF29D46CA4E4249",
      "text": "Richtig! Da hat sich ja jemand schön brav auf den\\nUnterricht konzentriert. Und ich dachte schon,\\r\\ndu würdest nur so tun, als hörtest du zu.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_c_03_history_13",
      "hash64": "94BDF2C75823996D",
      "text": "Genau genommen wurde die Akademie vor 805\\nJahren erbaut. Sie ist also bereits 805 Jahre alt![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_c_03_history_14",
      "hash64": "94BDEBC758238D88",
      "text": "Schon damals bot sie modernste Einrichtungen\\nund eine überaus fortschrittliche Ausbildung.\\c\\nDeshalb haben die Leute Folgendes gesagt...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_c_03_history_15a",
      "hash64": "E248B0BAC46C95EE",
      "text": "„Diejenigen, die nach Wissen streben, sollen sich\\nan den Orangen Paldeas laben.“[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_c_03_history_15b",
      "hash64": "E248AFBAC46C943B",
      "text": "„Diejenigen, die nach Wissen streben, sollen sich\\nan den Trauben Paldeas laben.“[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_c_03_history_16",
      "hash64": "94BDEDC7582390EE",
      "text": "Diese Redewendung soll sogar über die Grenzen\\nPaldeas hinaus in anderen Regionen bekannt\\r\\ngewesen sein.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_c_03_history_17",
      "hash64": "94BDEEC7582392A1",
      "text": "Nanu? Entweder habe ich zu viel geredet oder\\nmeine Uhr geht zu schnell.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_c_03_history_18",
      "hash64": "94BDE7C7582386BC",
      "text": "Das wäre dann wohl alles für heute.\\c\\nNächstes Mal steht die Zwischenprüfung an,\\nalso seht ja zu, dass ihr euch euer gesamtes\\r\\ngeschichtliches Wissen in Erinnerung ruft.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
