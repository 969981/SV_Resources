    {
      "ordinal": 0,
      "label": "sdc02_0370_bbteacher_01",
      "hash64": "43953386D8BF9EF9",
      "text": "[VAR 0xBD06(0000)]Hey, [VAR 0x0100(0000)]!\\nGlad\\r\\nto\\r\\nsee\\r\\nyou.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
