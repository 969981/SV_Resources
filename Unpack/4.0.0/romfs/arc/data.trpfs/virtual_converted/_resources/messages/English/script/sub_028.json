  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_028_middlef_00",
      "hash64": "D1EDE1F9BC47230F",
      "text": "My, my—I sense great depths to your past.\\nYou must have seen much in lives gone by.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_028_middlef_01",
      "hash64": "D1EDE0F9BC47215C",
      "text": "I can study your Rotom Phone to peer into past\\nlives you’ve lived. I call it Rotometry! Care to try?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_028_middlef_02",
      "hash64": "D1EDE3F9BC472675",
      "text": "Hm, perhaps we’d best leave it alone after all.\\nI can sense your suspicion of me...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_028_middlef_03",
      "hash64": "D1EDE2F9BC4724C2",
      "text": "Ahhh, your past... It drifts before my eyes! I see a\\nlife you once lived in— Oh, where is this...?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_028_select_a",
      "hash64": "35D0BFAD69D0E96D",
      "text": "Kanto?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_028_select_b",
      "hash64": "35D0BCAD69D0E454",
      "text": "Galar?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_028_select_c",
      "hash64": "35D0BDAD69D0E607",
      "text": "Sinnoh?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_028_select_d",
      "hash64": "35D0BAAD69D0E0EE",
      "text": "Hisui?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_028_select_e",
      "hash64": "35D0BBAD69D0E2A1",
      "text": "I’m good, actually...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_028_middlef_04",
      "hash64": "D1EDDDF9BC471C43",
      "text": "Yes, yes! It’s coming into clearer focus! In this\\nprevious life, you once tread the grounds of...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_028_middlef_a",
      "hash64": "036CE3FECEFF3FC2",
      "text": "Kanto! I see you and a beloved Pokémon on an\\nadventure in the Kanto region, urging each other\\r\\nonward with a bold “Let’s go!”",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sub_028_middlef_b",
      "hash64": "036CE2FECEFF3E0F",
      "text": "Galar! I see you facing down enormous\\nchallenges in the Galar region with equally\\r\\nenormous Dynamax Pokémon at your side!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_028_middlef_c",
      "hash64": "036CE1FECEFF3C5C",
      "text": "Sinnoh! I see you digging beneath the surface\\nof the Sinnoh region itself and dazzling crowds\\r\\nin Super Contest Shows!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_028_middlef_d",
      "hash64": "036CE0FECEFF3AA9",
      "text": "Hisui! I see you braving a great adventure in the\\nHisui region, an odd phone gripped in your hand!\\r\\nWait—where is “Hisui”? I’ve never heard of it...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_028_middlef_05",
      "hash64": "D1EDDCF9BC471A90",
      "text": "Allow me to fashion for your Rotom Phone a case\\nthat befits your memories.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sub_028_middlef_06",
      "hash64": "D1EDDFF9BC471FA9",
      "text": "Aaand...there!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_028_middlef_07",
      "hash64": "D1EDDEF9BC471DF6",
      "text": "Your case is finished. Carry it proudly!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sub_028_system_a",
      "hash64": "4AF36B673E33A1D0",
      "text": "You got the [VAR 0xFF00(0008)]Pika-Vee case[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sub_028_system_b",
      "hash64": "4AF36E673E33A6E9",
      "text": "You got the [VAR 0xFF00(0008)]Ball Guy case[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sub_028_system_c",
      "hash64": "4AF36D673E33A536",
      "text": "You got the [VAR 0xFF00(0008)]Pokétch case[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sub_028_system_d",
      "hash64": "4AF370673E33AA4F",
      "text": "You got the [VAR 0xFF00(0008)]Arc Phone case[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sub_028_middlef_08",
      "hash64": "D1EDE9F9BC4730A7",
      "text": "If you wish to plumb your memories for more\\npast lives, come speak to me again.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sub_028_middlef_09",
      "hash64": "D1EDE8F9BC472EF4",
      "text": "Never have I met one who has lived so widely\\nas you! I’m honored to have divined your past.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "sub_028_middlef_10",
      "hash64": "D1EA5BF9BC440986",
      "text": "I hope your Rotom Phone cases serve you well.\\nMay your past lives live on in them.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
