    },
    {
      "ordinal": 4,
      "label": "s2_sub_007_select_01",
      "hash64": "ECD7BCA38AFC5C6E",
      "text": "Who might you be?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
