        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0000_ecology_08",
      "hash64": "5772B1E9CF9E0C1B",
      "text": "더 자세한 건\\n아카데미의 [VAR 0xFF00(0006)]입구 홀[VAR 0xFF00(0000)]에서 설명해 줄게~[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
