    {
      "ordinal": 7,
      "label": "atlantis_talk_01_friend_02",
      "hash64": "FF833FB53EF5EF92",
      "text": "Ja, keine Sorge. Ich war ja schon mal hier...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
