    {
      "ordinal": 3,
      "label": "atlantis_talk_01_rival_02",
      "hash64": "149FDD37010AFBF4",
      "text": "Hm...? Moment, wo ist denn [VAR 0x0101(0001)]?[VAR 0x0114(0004)]",
