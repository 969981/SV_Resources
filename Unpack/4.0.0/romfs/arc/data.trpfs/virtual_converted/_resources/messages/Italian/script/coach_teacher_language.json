    },
    {
      "ordinal": 33,
      "label": "coach_teacher_language_sp03_select_01",
      "hash64": "2BE9B72B1C4ED5FF",
      "text": "Una marea!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "coach_teacher_language_sp03_select_02",
      "hash64": "2BE9B82B1C4ED7B2",
      "text": "Non ancora...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "coach_teacher_language_sp03_05",
      "hash64": "8FDEBA631B1C126C",
      "text": "Una marea? Ma very nice! Mi auguro con tutto\\nil cuore che ogni tuo sogno diventi realtà![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_teacher_language_sp03_05b",
      "hash64": "9388C46710B2ADCA",
      "text": "Non ancora, eh? I see. Alcune persone sono\\npiù veloci di altre, ma non sentirti in ansia.\\c\\nLa fretta è cattiva consigliera, quindi relax!\\nPrenditi tutto il tempo che ti serve![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
