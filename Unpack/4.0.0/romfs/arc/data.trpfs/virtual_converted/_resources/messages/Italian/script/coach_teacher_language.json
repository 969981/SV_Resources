          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_language_sp01_select_01",
      "hash64": "CEF387701EB49091",
      "text": "Certo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_language_sp01_select_02",
      "hash64": "CEF384701EB48B78",
      "text": "Non saprei...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_language_sp01_03",
      "hash64": "0C2C00551D33A5DC",
      "text": "Sono very very happy di sentirtelo dire![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_language_sp01_03b",
      "hash64": "E26A4EA09EC2A1DA",
      "text": "Ah...! Ma come! Nonostante i miei sforzi per\\ninsegnare cose pratiche e facili da ricordare![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_language_sp01_04",
      "hash64": "0C2BFF551D33A429",
      "text": "Beh, carissimi studenti dell’Istituto Mirtillo!\\nLe mie lezioni di lingue sono tutte per voi!\\r\\nImpegnatevi al massimo, alright?![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_language_sp01_05",
      "hash64": "0C2BFE551D33A276",
      "text": "Io farò del mio meglio! E mi aspetto lo stesso da\\nte, [VAR 0x0100(0000)]![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_language_sp02_00",
      "hash64": "3A95016D2A285162",
      "text": "Very very grazie per avermi invitato di nuovo![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_language_sp02_01",
      "hash64": "3A95026D2A285315",
      "text": "Tutto questo travelling da un posto all’altro\\nmi ricorda quando ero young! Che nostalgia![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_language_sp02_select_01",
      "hash64": "D5B856845D611BF4",
      "text": "Nostalgia? Di cosa?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_language_sp02_select_02",
      "hash64": "D5B859845D61210D",
      "text": "Perché? Viaggiava molto?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_language_sp02_02",
      "hash64": "3A94FF6D2A284DFC",
      "text": "Good question, [VAR 0x0100(0000)]!\\nSperavo che me lo chiedessi![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_language_sp02_03",
      "hash64": "3A95006D2A284FAF",
      "text": "Da giovane ho girato il mondo in lungo\\ne anche in largo![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_language_sp02_04",
      "hash64": "3A94FD6D2A284A96",
      "text": "Zaino in spalla, e via! Ho viaggiato per terra\\ne per mare, come un vero Giramondo...\\c\\nMorivo dalla voglia di visitare i luoghi più\\nbeautiful del nostro wonderful pianeta![VAR 0x0114(0026)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 172,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_language_sp02_05",
      "hash64": "3A94FE6D2A284C49",
      "text": "E ora, question time![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_language_sp02_06",
      "hash64": "3A94FB6D2A284730",
      "text": "Secondo te, tra le mille meraviglie che ho potuto\\nammirare, qual è stata la più bella di tutte?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_language_sp02_select_03",
      "hash64": "D5B858845D611F5A",
      "text": "Una montagna!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_language_sp02_select_04",
      "hash64": "D5B853845D6116DB",
      "text": "Il mare!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_language_sp02_select_05",
      "hash64": "D5B852845D611528",
      "text": "Un deserto!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_language_sp02_select_06",
      "hash64": "D5B855845D611A41",
      "text": "Una città!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_language_sp02_07",
      "hash64": "3A94FC6D2A2848E3",
      "text": "Nein! Risposta sbagliata. Forse era una domanda\\nun po’ difficult, lo ammetto...[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_language_sp02_08",
      "hash64": "3A95096D2A285EFA",
      "text": "Lo spettacolo naturale più bello di tutti... è stato\\nil volto di una donna speciale, visto di profilo...![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_language_sp02_09",
      "hash64": "3A950A6D2A2860AD",
      "text": "E quella donna adesso è mia moglie![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_language_sp02_10",
      "hash64": "3A98876D2A2B6AEB",
      "text": "Not bad, eh? Sembra quasi una fairy tale![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_language_sp03_00",
      "hash64": "8FDEB7631B1C0D53",
      "text": "Mi[VAR 0x1100(00FF,0101)]oa carissim[VAR 0x1100(00FF,0101)]oa [VAR 0x0100(0000)]!\\nCome vanno le cose?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_language_sp03_01",
      "hash64": "8FDEB6631B1C0BA0",
      "text": "In questo istituto si danno tutti un sacco da fare![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_language_sp03_02",
      "hash64": "8FDEB9631B1C10B9",
      "text": "Pensa, alcuni vogliono imparare lingue straniere\\nper diventare Allenatori e Allenatrici conosciuti\\r\\nin tutto il mondo![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_language_sp03_03",
      "hash64": "8FDEB8631B1C0F06",
      "text": "Avere una meta da raggiungere fa la differenza.\\nChi sa cosa vuole ha una marcia in più![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_language_sp03_04",
      "hash64": "8FDEBB631B1C141F",
      "text": "[VAR 0xBD06(0000)]E tu, [VAR 0x0100(0000)]? Ne hai di obiettivi\\nper il futuro?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
