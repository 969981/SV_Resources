    {
      "ordinal": 5,
      "label": "sdc02_0070_fairybb_04",
      "hash64": "6A30E7939BD65ECC",
      "text": "Bss, bss... (¿Cómo? No te oigo bien...).[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
