  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_038_man_01",
      "hash64": "04DCA3FBE2124FD0",
      "text": "You would be wise to stay away... I’m a danger to\\nall who approach...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_038_man_02",
      "hash64": "04DCA6FBE21254E9",
      "text": "Leave me be...OK?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_038_man_03",
      "hash64": "04DCA5FBE2125336",
      "text": "... ... ...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_038_man_04",
      "hash64": "04DCA8FBE212584F",
      "text": "Wait... Is it even possible? Are you...are you\\nlike me?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_038_man_05",
      "hash64": "04DCA7FBE212569C",
      "text": "Then you must have heard the call...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_038_man_06",
      "hash64": "04DCAAFBE2125BB5",
      "text": "I see... What has called you here, then...?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_038_select_01",
      "hash64": "2C3001979E4B352C",
      "text": "The light?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_038_select_02",
      "hash64": "2C3004979E4B3A45",
      "text": "The wind?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_038_select_03",
      "hash64": "2C3003979E4B3892",
      "text": "The darkness?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s2_sub_038_select_04",
      "hash64": "2C2FFE979E4B3013",
      "text": "A hunch?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_038_select_05",
      "hash64": "2C2FFD979E4B2E60",
      "text": "I’m not sure...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_038_man_07",
      "hash64": "04DCA9FBE2125A02",
      "text": "Oh. Light, huh... That’s...that’s not really what I’m\\ngoing for...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_038_man_08",
      "hash64": "04DCACFBE2125F1B",
      "text": "Huh? The wind?! I guess that’s pretty cool...\\nThe wind... Yeah, I like the ring of that!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s2_sub_038_man_09",
      "hash64": "04DCABFBE2125D68",
      "text": "Ah, the darkness... Yes, darkness is good...\\nIt quenches the thirst of my pitch-black soul...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s2_sub_038_man_10",
      "hash64": "04D93EFBE20F6E5A",
      "text": "A hunch? That’s no good... Come on, put a little\\neffort into this!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "s2_sub_038_man_11",
      "hash64": "04D93FFBE20F700D",
      "text": "You can feel it, right...? Feel the stirring of the\\npower in your hand there...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s2_sub_038_select_06",
      "hash64": "2C3000979E4B3379",
      "text": "My right hand?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s2_sub_038_select_07",
      "hash64": "2C2FFF979E4B31C6",
      "text": "My left hand?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "s2_sub_038_man_12",
      "hash64": "04D93CFBE20F6AF4",
      "text": "You feel it in your right hand? Uh, that won’t do...\\nThat just won’t do at all...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s2_sub_038_man_13",
      "hash64": "04D93DFBE20F6CA7",
      "text": "Yes! Yes, your left hand! I knew you were like me!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "s2_sub_038_man_14",
      "hash64": "04D93AFBE20F678E",
      "text": "Allow me to teach you, my kindred spirit, the\\nsign of twilight!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "s2_sub_011_system_01",
      "hash64": "340BF1E47E73D21E",
      "text": "You learned the [VAR 0xFF00(0008)]Be Still, My Left Hand! emote[VAR 0xFF00(0000)]\\nfrom the boy!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
