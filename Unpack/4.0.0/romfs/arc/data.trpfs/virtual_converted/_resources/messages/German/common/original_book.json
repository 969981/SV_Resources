        }
      ]
    },
    {
      "ordinal": 36,
      "label": "original_book_title_12_01_A",
      "hash64": "F43324FD792A21BB",
      "text": "– Ein wundersames Pokémon –",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "original_book_honbun_12_01_A",
      "hash64": "36C0F6E8CB473B81",
      "text": "Skizze eines wundersamen Pokémon.\\nDie Zeichnerin des Trupps ließ sich\\nvon der Größe und Brutalität der\\nrätselhaften Pokémon, welche die\\nmittleren und unteren Schichten von\\nZone Null bevölkern, zu dieser\\nausgedachten Darstellung inspirieren.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "original_book_title_12_01_B",
      "hash64": "F43325FD792A236E",
      "text": "– Ein wundersames Pokémon –",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "original_book_honbun_12_01_B",
      "hash64": "36C0F3E8CB473668",
      "text": "Skizze eines wundersamen Pokémon.\\nDie Zeichnerin des Trupps ließ sich\\nvon der Kompaktheit und Grausam-\\nkeit der rätselhaften Pokémon,\\nwelche die mittleren und unteren\\nSchichten von Zone Null bevölkern,\\nzu dieser ausgedachten Darstellung\\ninspirieren.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "original_book_title_13_01",
      "hash64": "43F02FC8DCEEC2E2",
      "text": "– Eine rätselhafte Erinnerung –",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "original_book_honbun_13_01",
      "hash64": "540B055D9803AAAC",
      "text": "Während der Erkundung des tiefsten\\nPunktes verlor ich den Trupp aus den\\nAugen und wurde später bewusstlos\\naufgefunden. Mir war, als hätte ich\\nmit jemandem an einem seltsamen\\nOrt gesprochen. Oder war es nur ein\\nTraum? Die links zu sehenden Notizen\\nin meiner Handschrift trug ich bei mir,\\naber ich erinnere mich an nichts.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "original_book_title_14_01",
      "hash64": "4C527803069DFAF1",
      "text": "– Ein Pok■■n wie ei■ Sch■be? –",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "original_book_honbun_14_01",
      "hash64": "22661533DECAD327",
      "text": "Als i■ mich allein w■erfand, war\\nmir, als h■e ich tie■ im Schl■d ein\\nselts■es Et■s entd■kt. Ich wusste\\n■der, ob es ein Pok■on war, noch,\\nob es übe■upt leb■. Sein■ H■le\\nbestand aus zahl■sen gesch■teten\\nS■secken, die heller f■kelten als\\nEd■stein. In sei■ Gestalt gl■ch\\ndieses Et■s einer Sch■be.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 44,
      "label": "original_book_select_01",
      "hash64": "BCAC21CE9E0042FB",
      "text": "Die Legende vom Schatz",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "original_book_select_02",
      "hash64": "BCAC22CE9E0044AE",
      "text": "Die Monster von Zone Null",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 46,
      "label": "original_book_select_03",
      "hash64": "BCAC23CE9E004661",
      "text": "Der Schlund von Paldea",
      "flags": 0,
      "text_status": "DECODED",
