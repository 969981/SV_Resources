    {
      "ordinal": 3,
      "label": "sdc02_4kings_c_01_clerk_03",
      "hash64": "4B1053ADCBA7E9D4",
      "text": "Die Teilnahmegebühr für die Top-Vier-Challenge\\nbeträgt 50 BP. Ist das in Ordnung für dich?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_c_01_clerk_04",
      "hash64": "4B1052ADCBA7E821",
      "text": "Ich weiß nicht, wie ich das sagen soll, aber...\\nDu hast leider nicht genug BP.\\c\\nWenn du Missionen erledigst, erhältst du dafür\\nBP. Versuch das doch mal!",
      "flags": 0,
