      "hash64": "CB1652CD6932588B",
      "text": "Rotoroto-rotoroto-rotoroto...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "ajito_honoo_020_cassiopeia_01",
      "hash64": "86C1998FCFED7A81",
      "text": "Vedo che sei riuscit[VAR 0x1100(00FF,0101)]oa a liberarti della Recluta.\\nBen fatto.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
