    {
      "ordinal": 1,
      "label": "kizuna_math_b_02",
      "hash64": "A86EB993E1A4C724",
      "text": "…………[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
