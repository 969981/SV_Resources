          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_d_07_yes_01",
      "hash64": "5BC72982841CF29E",
      "text": "Sì!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "class_d_07_yes_02",
      "hash64": "5BC72882841CF0EB",
      "text": "Yes!",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_d_07_language_03",
      "hash64": "F78083D5B9B47851",
      "text": "Vedervi pieni di entusiasmo fino alla fine\\nmi rende super happy![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_d_07_language_04",
      "hash64": "F78084D5B9B47A04",
      "text": "Today continuiamo a concentrarci sull’ascolto![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_07_language_05",
      "hash64": "F78085D5B9B47BB7",
      "text": "Come on, forza, Pikachu! Pika-pika![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_d_07_poke_01",
      "hash64": "01CFB19AF1E7EB2A",
      "text": "Pikachu!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_d_07_language_06",
      "hash64": "F78086D5B9B47D6A",
      "text": "Sentiamo subito l’ultima espressione di questo\\nciclo di lezioni...[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_d_07_language_07",
      "hash64": "F78087D5B9B47F1D",
      "text": "Facci sentire qual è il tuo stato d’animo![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_d_07_poke_02",
      "hash64": "01CFB09AF1E7E977",
      "text": "Chuuu!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_d_07_language_08",
      "hash64": "F78078D5B9B465A0",
      "text": "Che espressione potente! Un sentimento che ci\\ncontagia tutti![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_d_07_language_09",
      "hash64": "F78079D5B9B46753",
      "text": "Secondo voi, che sentimento ha espresso\\nPikachu con questo verso?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_d_07_select_01",
