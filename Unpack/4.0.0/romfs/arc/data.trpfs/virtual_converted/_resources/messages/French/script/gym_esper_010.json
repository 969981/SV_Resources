          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_esper_010_receptionist_05",
      "hash64": "DCED0D9906C26242",
      "text": "C’est une invention de Tully. Elle appelle cela\\nle [VAR 0xFF00(0006)]Fitness Émotion[VAR 0xFF00(0000)] !\\c\\nVous devrez suivre le programme jusqu’au bout\\npour réussir l’épreuve !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
