          ]
        },
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0200_stopper_01",
      "hash64": "BBA4B5AE38E203EB",
      "text": "Vous ne pouvez pas faire marche arrière !",
      "flags": 0,
