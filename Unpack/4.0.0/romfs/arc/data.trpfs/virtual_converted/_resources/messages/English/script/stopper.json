    {
      "ordinal": 6,
      "label": "stopper_common_0095_01",
      "hash64": "ADEDF249B490056F",
      "text": "You haven’t chosen a Pokémon yet! Better go tell\\nthe director which one you want.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "stopper_common_0170_01",
      "hash64": "1AA738F3C7B66831",
