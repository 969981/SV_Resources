      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "stopper_common_0170_02",
      "hash64": "1AA735F3C7B66318",
      "text": "You hear Houndoom barking an awful lot.\\nMaybe you’d better not go in there.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "stopper_common_0170_03",
      "hash64": "1AA736F3C7B664CB",
      "text": "Things look dangerous ahead.\\nBetter not get too close.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "stopper_common_0220_01",
      "hash64": "E0A8E5E3699496F9",
      "text": "Nemona’s waiting for you! Better head toward\\nthe academy!",
      "flags": 0,
