      "label": "stopper_general_01",
      "hash64": "CB04017349BE696B",
      "text": "You can head this way later.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "stopper_general_02",
      "hash64": "CB04027349BE6B1E",
      "text": "You should see what you can find by exploring\\nthe academy!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "stopper_common_0030_01",
      "hash64": "C463F20AE2942618",
      "text": "You’re not quite ready to go to school yet.",
