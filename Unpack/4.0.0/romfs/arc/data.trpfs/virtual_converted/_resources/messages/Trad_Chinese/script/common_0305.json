    {
      "ordinal": 1,
      "label": "common_0305_rival_02",
      "hash64": "7B3D7CADF77F0C43",
      "text": "尋寶！\\n開始了呢～！！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
