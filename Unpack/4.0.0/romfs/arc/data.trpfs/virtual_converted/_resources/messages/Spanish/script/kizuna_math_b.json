            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_b_select_01",
      "hash64": "CA217CEB2A799D4C",
      "text": "No, no era yo",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_b_select_02",
      "hash64": "CA217FEB2A79A265",
      "text": "No, yo acabo de llegar",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_b_05",
      "hash64": "A86EB893E1A4C571",
      "text": "No, claro... Sé que tú no harías algo así. Disculpa.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_b_06",
      "hash64": "A86EB593E1A4C058",
      "text": "Verás, es que últimamente tengo una sensación\\nmuy extraña... Es difícil de explicar.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_b_07",
      "hash64": "A86EB693E1A4C20B",
      "text": "Es como si alguien me estuviera observando.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_b_08",
      "hash64": "A86EB393E1A4BCF2",
      "text": "No un Pokémon, sino una persona, ¿sabes?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_b_09",
      "hash64": "A86EB493E1A4BEA5",
      "text": "Pensé que igual se trataba de un fantasma, así\\nque le pregunté a mi hermana, que sabe mucho\\r\\ndel tema, pero me dijo que era poco probable.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_b_10",
      "hash64": "A8722193E1A7ADB3",
      "text": "Así que no sé. Quizá tengo un alumno tímido que\\nestá esperando el momento justo para acercarse\\r\\ny preguntarme sus dudas.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_b_select_03",
      "hash64": "CA217EEB2A79A0B2",
      "text": "A lo mejor es eso",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_b_select_04",
      "hash64": "CA2179EB2A799833",
      "text": "¿Tú crees?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "kizuna_math_b_11",
      "hash64": "A8722093E1A7AC00",
      "text": "Sea quien sea, me mira con mucha fijación. Si ves\\na alguien observándome, ven a decírmelo, ¿vale?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_b_12",
      "hash64": "A8722393E1A7B119",
      "text": "Que tengo ganas de hacerle yo un par de\\npreguntas bien hechas.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
