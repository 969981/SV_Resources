          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_home_a_09",
      "hash64": "747FC75472A9179D",
      "text": "如果吾辈没有让你不开心的话，\\n再来这里坐坐吧。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
