          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_home_b_02",
      "hash64": "7074FE3D9FB32FBF",
      "text": "자네도 식사하러 왔나?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_home_b_select_01",
      "hash64": "41E2A3C4A8BB79C1",
      "text": "식사하러 왔어요",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_home_b_select_02",
      "hash64": "41E2A0C4A8BB74A8",
      "text": "그냥 들러 봤어요",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_home_b_03a",
      "hash64": "C9F8BCB65D77E337",
      "text": "훗, 많이 먹고\\n몸을 키우도록 해라.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_home_b_03b",
      "hash64": "C9F8BDB65D77E4EA",
      "text": "향긋한 냄새에\\n이끌려 왔나 보군.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_home_b_04",
      "hash64": "7074FC3D9FB32C59",
      "text": "나는...\\n학생식당을 시찰하러 왔다고나 할까?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_home_b_05",
      "hash64": "7074FB3D9FB32AA6",
      "text": "학생들이 평소에 어떤 영양소를\\n섭취하고 있는지 확인하고 있었다.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_home_b_06",
      "hash64": "7074FA3D9FB328F3",
      "text": "식당 메뉴 중에서 특히\\n달콤하고 맛있는\\r\\n땅콩버터 샌드위치가 신경 쓰이더군.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_home_b_07",
      "hash64": "7074F93D9FB32740",
      "text": "그럼, 하나 주문해 볼까...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_home_b_mob_01",
      "hash64": "72BB0B4A3B889909",
      "text": "앗! 사구아로 선생님이다!\\n정말 댄디하고 멋져~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "kizuna_home_b_mob_02",
      "hash64": "72BB084A3B8893F0",
      "text": "선생님도 식당에 오시는구나!\\n에그 샌드위치를 드시려나?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_home_b_mob_03",
      "hash64": "72BB094A3B8895A3",
      "text": "에이~ 사구아로 선생님이라면 당연히\\n매콤~한 어른의 샌드위치지!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_home_b_mob_04",
      "hash64": "72BB0E4A3B889E22",
      "text": "그래! 쿨한 이미지시니까!\\n분명히 어른의 샌드위치를 드실 거야!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "kizuna_home_b_08",
      "hash64": "7075083D9FB340BD",
      "text": "......[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_home_b_09",
      "hash64": "7075073D9FB33F0A",
      "text": "...어, 어른의 샌드위치로\\n하나 부탁하지.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_home_b_select_03",
      "hash64": "41E2A1C4A8BB765B",
      "text": "선생님!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_home_b_select_04",
      "hash64": "41E2A6C4A8BB7EDA",
      "text": "땅콩버터 샌드위치!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_home_b_10",
      "hash64": "7071FA3D9FB0F31C",
      "text": "아, 아아! [VAR 0x0100(0000)],\\n땅콩버터 샌드위치를 추천하는 건가?\\r\\n그렇다면 그걸로 하지.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_home_b_11",
      "hash64": "7071FB3D9FB0F4CF",
      "text": "하마터면 먹지도 못하는\\n매운 걸 주문할 뻔했군...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_home_b_12",
      "hash64": "7071FC3D9FB0F682",
      "text": "[VAR 0x0100(0000)],\\n나를 막아 줘서 고맙다.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_home_b_13",
      "hash64": "7071FD3D9FB0F835",
      "text": "아무래도 내가 댄디하다든지,\\n늠름해 보인다든지, 차가워 보인다든지,\\r\\n쿨하다는 이야기를 많이 들어서 말이다.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_home_b_14",
      "hash64": "7071F63D9FB0EC50",
      "text": "나도 모르게 그들의 환상을\\n깨지 않으려 무리하게 되더군...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_home_b_15",
      "hash64": "7071F73D9FB0EE03",
      "text": "뜻하지 않게 자네에겐\\n내 본성을 보이고 말았다만...\\r\\n둘만의 비밀로 해 다오.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_home_b_system_01",
      "hash64": "1F8785FE16DAD786",
      "text": "사구아로 선생님과\\n조금 더 친해졌다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
