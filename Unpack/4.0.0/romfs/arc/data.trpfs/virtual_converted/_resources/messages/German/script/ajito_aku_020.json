    {
      "ordinal": 1,
      "label": "ajito_aku_020_cassiopeia_01",
      "hash64": "B400CD87B965F759",
      "text": "Du bist die Wache also losgeworden.\\nGut gemacht.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
