    {
      "ordinal": 0,
      "label": "kizuna_friend_a_01",
      "hash64": "189334532AA44C1C",
      "text": "喲，[VAR 0x0100(0000)]！\\n[VAR 0x1100(00FF,0101)]你妳也來吃飯嗎？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
