      ]
    },
    {
      "ordinal": 44,
      "label": "coach_teacher_battle_trade_04_00",
      "hash64": "BE282651A1D37EAC",
      "text": "안녕! 전학생!\\c\\n나와 포켓몬 교환을\\n시작할 마음이 들었니!?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
