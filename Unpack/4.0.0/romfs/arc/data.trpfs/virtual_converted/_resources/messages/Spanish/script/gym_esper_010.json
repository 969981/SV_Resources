        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_esper_010_receptionist_03",
      "hash64": "DCED079906C25810",
      "text": "Si quieres desafiar a la Líder de Gimnasio, Tuli,\\ndebes aprobar primero el examen de gimnasio.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_esper_010_receptionist_04",
      "hash64": "DCED0E9906C263F5",
      "text": "Y el concepto clave del examen es...\\n¡hacer [VAR 0xFF00(0006)]ejercicio[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
