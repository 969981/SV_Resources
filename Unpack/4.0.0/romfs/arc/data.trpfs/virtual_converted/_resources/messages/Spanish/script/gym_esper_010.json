          "offset_units": 57,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_esper_010_receptionist_05",
      "hash64": "DCED0D9906C26242",
      "text": "Para ganarte el aprobado vas a tener que\\nhacer frente al [VAR 0xFF00(0006)]ejercicio emocional[VAR 0xFF00(0000)] diseñado\\r\\npor la propia Tuli.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
