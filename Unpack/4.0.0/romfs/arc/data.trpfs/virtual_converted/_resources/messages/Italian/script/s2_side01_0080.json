    {
      "ordinal": 1,
      "label": "s2_side01_0080_botan_01",
      "hash64": "726D31FC94714F17",
      "text": "Zuccheri! Anidride carbonica! Evvai![VAR 0x0114(0008)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
