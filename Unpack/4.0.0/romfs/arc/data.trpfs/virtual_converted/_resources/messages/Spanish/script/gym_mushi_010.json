    {
      "ordinal": 2,
      "label": "gym_mushi_010_receptionist_01",
      "hash64": "12BB275357DBC9ED",
      "text": "¡Bienvenid[VAR 0x1100(00FF,0101)]oa al Gimnasio de Pueblo Pirotín!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
