          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_mushi_010_receptionist_02",
      "hash64": "12BB245357DBC4D4",
      "text": "A ver, que apunte tu nombre en el registro de\\ncontrincantes...\\c\\n¡Hecho! Ya estás inscrit[VAR 0x1100(00FF,0101)]oa, [VAR 0x0100(0000)].",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
