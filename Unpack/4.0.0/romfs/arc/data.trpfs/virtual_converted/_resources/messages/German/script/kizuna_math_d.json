          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_math_d_02",
      "hash64": "2C21F1A1DF8E09CE",
      "text": "Ich bin gerade dabei, dem Mädchen aufzulauern,\\ndas mich die ganze Zeit über beobachtet hat.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_math_d_select_01",
      "hash64": "9D49A5E8910AAAE2",
      "text": "Sie lauern dem Mädchen auf?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_math_d_select_02",
      "hash64": "9D49A4E8910AA92F",
      "text": "Aber warum?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_d_03",
      "hash64": "2C21F2A1DF8E0B81",
      "text": "Es kann ja nicht ewig so weitergehen, dass ich\\nmich ständig beobachtet fühle.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_d_04",
      "hash64": "2C21F3A1DF8E0D34",
      "text": "Und ich habe mir das Gesicht in der Mensa\\ngut eingeprägt, damit ich die Person zur Rede\\r\\nstellen kann![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_d_05",
      "hash64": "2C21F4A1DF8E0EE7",
      "text": "Aha![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_d_06",
      "hash64": "2C21F5A1DF8E109A",
      "text": "Du da! Du bist doch die, die mich in letzter Zeit\\nständig beobachtet, nicht wahr?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_d_woman_01",
      "hash64": "EB672704C6358444",
      "text": "S-Señora Quendella?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_d_woman_02",
      "hash64": "EB672A04C635895D",
      "text": "Oje... Sie haben mich also bemerkt...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_d_07",
      "hash64": "2C21F6A1DF8E124D",
      "text": "Kein Wunder, wenn du rund um die Uhr in meine\\nRichtung starrst. Also dann, her mit der Frage!\\c\\nDarum geht es doch, oder? Du willst mich etwas\\nfragen.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 151,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_d_woman_03",
      "hash64": "EB672904C63587AA",
      "text": "J-Ja, das stimmt...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_d_woman_04",
      "hash64": "EB672404C6357F2B",
      "text": "Äh, also... Ich bin ein großer Fan von Ihnen,\\nund zwar schon seit Sie als Arenaleiterin aktiv\\r\\nwaren. Gesteins-Attacken sind einfach so cool!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_d_08",
      "hash64": "2C21E7A1DF8DF8D0",
      "text": "Ach, ist das so?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_math_d_woman_05",
      "hash64": "EB672304C6357D78",
      "text": "Aber dann haben Sie sich vor anderthalb Jahren\\nals Arenaleiterin zurückgezogen... Warum?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_d_09",
      "hash64": "2C21E8A1DF8DFA83",
      "text": "Das ist alles, was du wissen wolltest?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_math_d_woman_06",
      "hash64": "EB672604C6358291",
      "text": "Na ja, es gab nie eine offizielle Stellungnahme\\ndazu...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_math_d_woman_07",
      "hash64": "EB672504C63580DE",
      "text": "Und unter den Schülern heißt es, dass Sie\\nFragen danach immer aus dem Weg gehen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_math_d_woman_08",
      "hash64": "EB672004C635785F",
      "text": "Es kam mir unhöflich vor, weiter nachzubohren,\\ndeshalb konnte ich nie den Mut fassen, auf Sie\\r\\nzuzugehen und Sie selbst zu fragen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_math_d_10",
      "hash64": "2C24F5A1DF904671",
      "text": "Daher auch der angespannte Blick.\\nJetzt wird mir alles klar...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_math_d_woman_09",
      "hash64": "EB671F04C63576AC",
      "text": "Ähm, welcher angespannte Blick?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "kizuna_math_d_11",
      "hash64": "2C24F4A1DF9044BE",
      "text": "Ach, nicht so wichtig.\\c\\nMeinen Posten als Arenaleiterin habe ich an den\\nNagel gehängt, weil ich mich auf meine Tätigkeit\\r\\nals Lehrerin konzentrieren wollte.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 160,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_math_d_12",
      "hash64": "2C24F3A1DF90430B",
      "text": "Es ist nicht so, als hätte es mir keinen Spaß mehr\\ngemacht...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_math_d_13",
      "hash64": "2C24F2A1DF904158",
      "text": "Ganz im Gegenteil: Wenn ich darüber rede,\\nwerde ich immer ganz wehmütig.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_math_d_14",
      "hash64": "2C24F9A1DF904D3D",
      "text": "Deswegen bin ich den Fragen der Schüler\\nbisher auch aus dem Weg gegangen.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_math_d_woman_10",
      "hash64": "EB63A204C6326C6E",
      "text": "Verstehe...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "kizuna_math_d_woman_11",
      "hash64": "EB63A304C6326E21",
      "text": "Und wollen Sie nicht irgendwann in die Arena\\nzurückkehren?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "kizuna_math_d_15",
      "hash64": "2C24F8A1DF904B8A",
      "text": "Nein, das habe ich nicht vor.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_math_d_16",
      "hash64": "2C24F7A1DF9049D7",
      "text": "Meine Schwester füllt die Rolle gerade\\nhervorragend aus.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_math_d_17",
      "hash64": "2C24F6A1DF904824",
      "text": "Und mir macht meine Arbeit als Lehrerin ohnehin\\nam meisten Spaß.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_math_d_18",
      "hash64": "2C24EDA1DF9038D9",
      "text": "Es wäre wunderbar, wenn du mir die Chance\\ngeben würdest, dich als Lehrerin genauso zu\\r\\nbeeindrucken wie als Arenaleiterin![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_math_d_woman_12",
      "hash64": "EB63A004C6326908",
      "text": "Okay, das kann ich verstehen. Auch wenn ich\\ntrotzdem ein bisschen traurig darüber bin,\\r\\ndass ich Sie nicht mehr in der Arena sehen werde!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_math_d_woman_13",
      "hash64": "EB63A104C6326ABB",
      "text": "Danke, dass Sie meine Frage beantwortet\\nhaben, Señora Quendella!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "kizuna_math_d_19",
      "hash64": "2C24ECA1DF903726",
      "text": "Damit wäre diese Angelegenheit geklärt![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "kizuna_math_d_20",
      "hash64": "2C287BA1DF935FFA",
      "text": "Puh, war ich vielleicht nervös! Ich musste mir\\nrichtig Mühe geben, cool zu bleiben.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_math_d_21",
      "hash64": "2C287CA1DF9361AD",
      "text": "Anfangs war ich schon ein wenig eingeschüchtert,\\nals ich ständig diese angespannten Blicke in\\r\\nmeinem Nacken gespürt habe...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "kizuna_math_d_22",
      "hash64": "2C2879A1DF935C94",
      "text": "Doch dank deiner Hilfe weiß ich nun, dass es\\nsich dabei um einen meiner größten Fans\\r\\ngehandelt hat![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "kizuna_math_d_23",
      "hash64": "2C287AA1DF935E47",
      "text": "Danke, dass du immer für mich da bist, wenn ich\\nUnterstützung brauche, [VAR 0x0100(0000)]![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
