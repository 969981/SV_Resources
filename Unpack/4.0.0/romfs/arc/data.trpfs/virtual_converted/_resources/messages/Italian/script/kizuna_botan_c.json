          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "kizuna_botan_c_mobs_02",
      "hash64": "B969FBA4B7C05FC3",
      "text": "Ehi, come ti chiami? Sarà un piacere averti\\nfra noi!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "kizuna_botan_c_mobs_03",
      "hash64": "B969FAA4B7C05E10",
      "text": "Quegli stivali sono spaziali!\\nFammeli guardare da vicino!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "kizuna_botan_c_hono_17",
      "hash64": "32C6B5E2DE9EB8E2",
      "text": "M-Mi chiamo Pruna...\\nEhm... Gli stivali li ha fatti un mio amico otaku.\\r\\nForti, vero?[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "kizuna_botan_c_11",
      "hash64": "0E9609B5BB5598CD",
      "text": "Dunque la storia dell’irruzione era un malinteso...\\nBeh, meglio così.\\c\\nE Prunetta diventerà un membro del club\\ndi arte, eh?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
