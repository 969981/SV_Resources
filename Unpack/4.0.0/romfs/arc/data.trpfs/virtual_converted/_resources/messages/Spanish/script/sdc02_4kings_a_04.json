            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_a_04_firebb_04",
      "hash64": "12D4F65DCDC65F15",
      "text": "¡¡Aaarg!! ¡Me hierve la sangre con tanto secretito\\ny tanto callarse las cosas![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_04_firebb_05",
      "hash64": "12D4F55DCDC65D62",
      "text": "¡Hay que ir al grano! ¡Si se quiere decir algo,\\nse dice y punto! ¡Sin rodeos![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_04_firebb_06",
      "hash64": "12D4F45DCDC65BAF",
      "text": "A mí es que las sutilezas no se me dan nada bien,\\npor si no lo habías notado.[VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_04_firebb_07",
      "hash64": "12D4F35DCDC659FC",
      "text": "Yo combato porque me apetece combatir.\\nYa está. ¡Así de simple![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_a_04_firebb_08",
      "hash64": "12D4FA5DCDC665E1",
      "text": "Soy Denis, representante del Alto Mando en el\\nÁrea Árida, y...[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_a_04_firebb_09",
      "hash64": "12D4F95DCDC6642E",
      "text": "¡Voy a ganar porque me apetece![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_4kings_a_04_firebb_19",
      "hash64": "12D1755DCDC34E0B",
      "text": "[VAR 0xBD06(0000)]¡Qué pasada de combate, [VAR 0x0100(0000)]!\\n¡Ha estado flama![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_4kings_a_04_firebb_10",
      "hash64": "12D16C5DCDC33EC0",
      "text": "¿Sabes en qué se parecen la cocina y los\\ncombates?\\c\\nEn que son fáciles de entender. Por eso me\\ngustan tanto.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_4kings_a_04_firebb_11",
      "hash64": "12D16D5DCDC34073",
      "text": "Los combates se ganan o se pierden, y si a un\\nplato le echas picante, pues pica. Simple, ¿no?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_4kings_a_04_firebb_12",
      "hash64": "12D16E5DCDC34226",
      "text": "Aunque, últimamente, el Club de la Liga se me\\nestá atragantando... ¡Todo son complicaciones![VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_4kings_a_04_firebb_13",
      "hash64": "12D16F5DCDC343D9",
      "text": "Ojalá volviera a ser todo como antes, cuando las\\nactividades que montaba el club eran divertidas.[VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_4kings_a_04_firebb_14",
      "hash64": "12D1705DCDC3458C",
      "text": "Perdón por el jarro de agua fría. Has demostrado\\ntener una gran fuerza, [VAR 0x0100(0000)].[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_4kings_a_04_firebb_15",
      "hash64": "12D1715DCDC3473F",
      "text": "¡Es hora de sacar esa pasión que llevas dentro\\ny aliñarla con una buena dosis de entusiasmo![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_4kings_a_04_firebb_16",
      "hash64": "12D1725DCDC348F2",
      "text": "Y ahora te haré entrega de una de mis mejores\\nrecetas para el éxito. ¡Te la has ganado![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_4kings_a_04_firebb_17",
      "hash64": "12D1735DCDC34AA5",
      "text": "Yo seguiré con mis fogones, a lo mío.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_4kings_a_04_firebb_18",
      "hash64": "12D1745DCDC34C58",
      "text": "[VAR 0xBD06(0000)]¡Pero tú sigue arrasando en la Liga Arándano,\\n[VAR 0x0100(0000)]![VAR 0x0114(0047)]",
      "flags": 0,
