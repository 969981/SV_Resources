  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "class_c_02_history_01",
      "hash64": "0B5BC4DC27AF5B6F",
      "text": "Hallo! Heute seid ihr einen Tag älter als gestern,\\naber mal sehen, ob ihr auch schlauer seid.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_c_02_history_02",
      "hash64": "0B5BC5DC27AF5D22",
      "text": "Wir werden uns auch heute wieder mit den\\nfaszinierenden Rätseln der Geschichte befassen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_c_02_history_03",
      "hash64": "0B5BC6DC27AF5ED5",
      "text": "Vor etwa 2000 Jahren kam diese Region unter\\ndie Herrschaft des Paldeanischen Imperiums.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_c_02_history_04",
      "hash64": "0B5BBFDC27AF52F0",
      "text": "Es heißt, der Kaiser von Paldea sei ein rigoroser\\nDiktator gewesen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_c_02_history_05",
      "hash64": "0B5BC0DC27AF54A3",
      "text": "Zudem glaubte er wohl fest an die Legende vom\\nSchatz auf dem Grund von Zone Null.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_c_02_history_06",
      "hash64": "0B5BC1DC27AF5656",
      "text": "Die Menschheit war damals natürlich noch nicht\\nso fortgeschritten wie heute.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_c_02_history_07",
      "hash64": "0B5BC2DC27AF5809",
      "text": "Ob Legenden, Zauberei oder Wesen jenseits\\nunseres Vorstellungsvermögens... Die Leute\\r\\nneigten dazu, an alles Mögliche zu glauben.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_c_02_history_08",
      "hash64": "0B5BCBDC27AF6754",
      "text": "Um sich gegen angrenzende Länder behaupten\\nzu können, schickte der Kaiser eine Vielzahl von\\r\\nLeuten auf die Suche nach dem Schatz von\\r\\nZone Null.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_c_02_history_09",
      "hash64": "0B5BCCDC27AF6907",
      "text": "Hm, du schaust wieder drein, als wolltest du mir\\neine Frage beantworten, [VAR 0x0100(0000)].[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_c_02_history_10",
      "hash64": "0B5F49DC27B27345",
      "text": "Wie lange ist es her, dass diese Region unter die\\nHerrschaft des Paldeanischen Imperiums kam?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_c_02_select_01",
      "hash64": "E404E8CA4DC38D9D",
      "text": "Etwa 1000 Jahre.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_c_02_select_02",
      "hash64": "E404E5CA4DC38884",
      "text": "Etwa 2000 Jahre.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_c_02_select_03",
      "hash64": "E404E6CA4DC38A37",
      "text": "Etwa 3000 Jahre.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_c_02_history_answer_01",
      "hash64": "CA80F3D881E34998",
      "text": "Das ist falsch. Vor 1000 Jahren war das\\nImperium bereits im Begriff, sich aufzulösen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_c_02_history_answer_02",
      "hash64": "CA80F6D881E34EB1",
      "text": "Richtig! Du bist wohl [VAR 0x1100(00FF,1111,0000)]ein ganz Schlauereine ganz Schlaue...\\nZumindest passt du im Unterricht gut auf.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1111",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_c_02_history_answer_03",
      "hash64": "CA80F5D881E34CFE",
      "text": "Das ist falsch. Vor 3000 Jahren existierte das\\nImperium noch nicht einmal![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_c_02_history_11",
      "hash64": "0B5F48DC27B27192",
      "text": "Vor etwa 2000 Jahren brach eine bedeutende\\nÄra an... Das große Entdeckungszeitalter.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_c_02_history_12",
      "hash64": "0B5F47DC27B26FDF",
      "text": "Doch keiner der Abenteurer, die vom Kaiser\\nausgesandt wurden, hat den tiefsten Punkt von\\r\\nZone Null je erreicht.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_c_02_history_13",
      "hash64": "0B5F46DC27B26E2C",
      "text": "War die harte Reise zu viel für sie? Oder sind sie\\neiner unbekannten Kreatur zum Opfer gefallen?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_c_02_history_14",
      "hash64": "0B5F45DC27B26C79",
      "text": "So viel ist sicher, die immensen Schwierigkeiten\\ndieser Entdecker haben definitiv zu den Mysterien\\r\\nrund um den großen Schlund beigetragen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_c_02_history_15",
      "hash64": "0B5F44DC27B26AC6",
      "text": "Hach! Was würde ich nicht dafür geben,\\nZone Null in ihrem damals noch unberührten\\r\\nZustand zu erkunden![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_c_02_history_16",
      "hash64": "0B5F43DC27B26913",
      "text": "Meine einzige Hoffnung ist wohl, dass möglichst\\nbald eine Zeitmaschine erfunden wird![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_c_02_history_17",
      "hash64": "0B5F42DC27B26760",
      "text": "Nanu? Entweder habe ich zu viel geredet oder\\nmeine Uhr geht zu schnell.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_c_02_history_18",
      "hash64": "0B5F51DC27B280DD",
      "text": "Das wäre alles für heute. Nächste Stunde werden\\nwir noch mehr historische Mysterien enträtseln.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    }
  ]
}
