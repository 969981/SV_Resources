          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0070_fairybb_02",
      "hash64": "6A30E5939BD65B66",
      "text": "嘀嘀咕咕……？（没迷路吧？）[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0070_select_01",
      "hash64": "1339D8740A3EC6A0",
      "text": "没有！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc02_0070_select_02",
      "hash64": "1339DB740A3ECBB9",
      "text": "嘀嘀咕咕……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_0070_fairybb_03",
      "hash64": "6A30E6939BD65D19",
      "text": "嘀嘀咕！（太好了！）[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0070_fairybb_04",
      "hash64": "6A30E7939BD65ECC",
      "text": "……嘀咕咕？（……你说什么？）[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0070_teacher_01",
      "hash64": "E7AD0FEE0DEEEFA2",
      "text": "各位同学，阿罗拉！\\n那我们开始上课吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_0070_teacher_02",
      "hash64": "E7AD0EEE0DEEEDEF",
      "text": "好像也有人\\n是第一次来上课！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc02_0070_teacher_03",
      "hash64": "E7AD0DEE0DEEEC3C",
      "text": "这个海岸区\\n通过人工重现出了\\r\\n南国海岛般的环境。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0070_teacher_04",
      "hash64": "E7AD0CEE0DEEEA89",
      "text": "而且，\\n这里生活着许多\\r\\n适应温暖气候的宝可梦。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0070_teacher_05",
      "hash64": "E7AD0BEE0DEEE8D6",
      "text": "其中也有宝可梦受到\\n超过通常环境的大量光照，\\r\\n而长得比其他地区更大！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0070_teacher_06",
      "hash64": "E7AD0AEE0DEEE723",
      "text": "没错！同一种宝可梦在其他地区\\n样子不同，这就是[VAR 0xFF00(0006)]地区形态[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0070_teacher_07",
      "hash64": "E7AD09EE0DEEE570",
      "text": "那么，大家来实际捕捉一下\\n地区形态为[VAR 0xFF00(0006)]阿罗拉的样子[VAR 0xFF00(0000)]的宝可梦吧！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0070_teacher_08",
      "hash64": "E7AD18EE0DEEFEED",
      "text": "捉到以后\\n记得要给我看一下哦。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0070_teacher_09",
      "hash64": "E7AD17EE0DEEFD3A",
      "text": "那么，课题正式开始！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_0070_fairybb_05",
      "hash64": "6A30E8939BD6607F",
      "text": "蓝莓学园有很多\\n通过实践来学习的课程。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0070_fairybb_06",
      "hash64": "6A30E9939BD66232",
      "text": "那么，第一堂课！\\n好好加油吧！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0070_fairybb_07",
      "hash64": "6A30EA939BD663E5",
      "text": "你知道该捉怎样的宝可梦吗？\\c\\n比如长得好～长的椰蛋树，\\n可以说是阿罗拉的样子中的经典！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0070_mob_01",
      "hash64": "83A86BC65CA24E32",
      "text": "哟，你知道吗？\\n阿罗拉的三地鼠\\r\\n长着……那大概是胡须？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0070_mob_02",
      "hash64": "83A86AC65CA24C7F",
      "text": "在南国海岛阿罗拉地区，\\n打招呼时会说“阿罗拉”哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc02_0070_mob_03",
      "hash64": "83A869C65CA24ACC",
      "text": "哪只宝可梦\\n是阿罗拉的样子来着？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
