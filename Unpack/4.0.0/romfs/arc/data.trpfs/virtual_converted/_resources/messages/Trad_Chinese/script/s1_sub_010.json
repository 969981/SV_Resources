    {
      "ordinal": 1,
      "label": "s1_sub_010_ecology_02",
      "hash64": "77F2E574C0CC2908",
      "text": "[VAR 0x1100(00FF,0101)]你妳在北上鄉捉到了……\\n[VAR 0x0202(0001)]種寶可夢！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
