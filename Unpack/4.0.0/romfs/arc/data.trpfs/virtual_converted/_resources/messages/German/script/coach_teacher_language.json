      "hash64": "0C2C03551D33AAF5",
      "text": "[VAR 0xBD06(0000)]Oh! Hallo, [VAR 0x0100(0000)]! Long time\\nno see,\\r\\nlange\\r\\nist\\r\\nes her![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
