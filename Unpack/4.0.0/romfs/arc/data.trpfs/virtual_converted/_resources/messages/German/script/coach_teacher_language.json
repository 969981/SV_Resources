      "label": "coach_teacher_language_randomtalk_01",
      "hash64": "B01600B72F24CBC1",
      "text": "Während ich auf Dienstreise bin, kümmern sich\\ndie Schüler aus meinem Kurs ganz lieb um Pamo.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
