    },
    {
      "ordinal": 63,
      "label": "coach_teacher_language_randomtalk_00",
      "hash64": "B015FFB72F24CA0E",
      "text": "Manche Schüler an unserer Akademie haben mich\\n„Schwallbatore“ genannt, aber... was soll das\\r\\nüberhaupt bedeuten?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
