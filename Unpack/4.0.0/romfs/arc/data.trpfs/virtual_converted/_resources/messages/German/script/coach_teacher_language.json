      ]
    },
    {
      "ordinal": 41,
      "label": "coach_teacher_language_trade_01_02",
      "hash64": "BD448BB5AE365BC7",
      "text": "In diesem Sinne, wie wäre es mit einem\\nPokémon-Tausch? Oui ou non?![VAR 0x0114(0026)]",
