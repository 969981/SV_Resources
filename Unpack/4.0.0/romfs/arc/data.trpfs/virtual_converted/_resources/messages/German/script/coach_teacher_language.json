          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "coach_teacher_language_sp03_07",
      "hash64": "8FDEBC631B1C15D2",
      "text": "Das Leben hat viel zu bieten! Genau wie ich![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
