  "language_raw": "German",
  "source": "message/dat/German/script/class_g_07.dat",
  "paired_tbl": "message/dat/German/script/class_g_07.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "class_g_07_home_01",
      "hash64": "C719B32A85A17CD3",
      "text": "Packt eure Handys weg, wir beginnen jetzt\\nmit der letzten Unterrichtseinheit.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_g_07_home_02",
      "hash64": "C719B42A85A17E86",
      "text": "Ich musste feststellen, dass sich mein Unterricht\\nbisher größtenteils um Ernährung gedreht hat.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_g_07_home_03",
      "hash64": "C719B52A85A18039",
      "text": "Diese Unterrichtseinheit würde ich daher gern\\nnutzen, um mit euch über Kleidung zu sprechen.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_g_07_home_04",
      "hash64": "C719B62A85A181EC",
      "text": "Wie ihr sicher wisst, ist es an unserer Akademie\\nTradition, den Schülerinnen und Schülern ihre\\r\\nFreiheiten zu lassen.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_g_07_home_05",
      "hash64": "C719B72A85A1839F",
      "text": "Um dem vielfältigen Klima Paldeas Rechnung\\nzu tragen, stellen wir euch für jede Jahreszeit\\r\\neine passende Uniform bereit.\\c\\nEuch ist es aber selbst überlassen, welche davon\\nihr wann tragt.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 191,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_g_07_home_06",
      "hash64": "C719B82A85A18552",
      "text": "Im Rahmen eurer Aufnahme an der Akademie\\nmüsstet ihr vier verschiedene Sets an Oberteilen\\r\\nund Beinbekleidung für die jeweiligen\\r\\nJahreszeiten erhalten haben.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 162,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_g_07_home_07",
      "hash64": "C719B92A85A18705",
      "text": "Falls euch das noch nicht bewusst war, solltet ihr\\nmal einen Blick in euren Kleiderschrank werfen.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_g_07_home_08",
      "hash64": "C719BA2A85A188B8",
      "text": "Solange ihr eine dieser Uniformen tragt, dürft ihr\\nden Rest eures Erscheinungsbildes frei wählen.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_g_07_home_09",
      "hash64": "C719BB2A85A18A6B",
      "text": "Vielleicht möchtet ihr ja einen Hut tragen?\\nOder eure Frisur verändern?\\c\\nDiese Entscheidungen sind allein euch überlassen.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_g_07_home_10",
      "hash64": "C71D382A85A494A9",
      "text": "In meiner Jugendzeit war das noch anders.\\c\\nSeñor Salvatore hätte damals mit seiner\\nHaarpracht gegen die Schulregeln verstoßen.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_g_07_home_11",
      "hash64": "C71D372A85A492F6",
      "text": "Wo wir gerade dabei sind...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_g_07_home_12",
      "hash64": "C71D362A85A49143",
      "text": "Abgesehen von eurer Kleidung gibt es da noch\\netwas anderes Putziges, das ihr nur zu gern euren\\r\\nVorlieben anpasst. Wer weiß, was ich meine?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_g_07_select_01",
      "hash64": "11BD2B040E261532",
      "text": "Meinen Tisch im Klassenzimmer?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_g_07_select_02",
      "hash64": "11BD2A040E26137F",
      "text": "Mein Zimmer an der Akademie?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_g_07_select_03",
      "hash64": "11BD29040E2611CC",
      "text": "Mein Smart-Rotom?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_g_07_home_answer_01",
      "hash64": "F71E5FAC71D8F254",
      "text": "Aber dein Tisch unterscheidet sich doch\\nüberhaupt nicht von den anderen hier!\\c\\nNein, ich meine dieses kleine, putzige Ding,\\ndas ihr immer mit euch führt...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 157,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_g_07_home_answer_02",
      "hash64": "F71E62AC71D8F76D",
      "text": "Was ihr mit euren Zimmern anstellt, will ich\\ngar nicht wissen!\\c\\nNein, ich meine dieses kleine, putzige Ding,\\ndas ihr immer mit euch führt...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_g_07_home_answer_03",
      "hash64": "F71E61AC71D8F5BA",
      "text": "Das ist korrekt! Dieses putzige Etwas meinte ich.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_g_07_home_13",
      "hash64": "C71D352A85A48F90",
      "text": "Das Smart-Rotom! Es fasziniert mich wirklich\\nungemein.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_g_07_home_14",
      "hash64": "C71D3C2A85A49B75",
      "text": "Oh, wie interessant! In einem Laden namens\\nBotoBeutel kann man also Hüllen dafür erwerben![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_g_07_home_15",
      "hash64": "C71D3B2A85A499C2",
      "text": "Vielen Dank für diese nützliche Information.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_g_07_home_16",
      "hash64": "C71D3A2A85A4980F",
      "text": "Ich werde gleich morgen dort vorbeischauen\\nund eine Hülle kaufen, die meinem Geschmack\\r\\nentspricht.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_g_07_home_17",
      "hash64": "C71D392A85A4965C",
      "text": "Verzeihung, ich bin etwas abgeschweift.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_g_07_home_18",
      "hash64": "C71D402A85A4A241",
      "text": "Zum Abschluss des Hauswirtschaftskurses möchte\\nich euch noch etwas mit auf den Weg geben.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_g_07_home_19",
      "hash64": "C71D3F2A85A4A08E",
      "text": "Im Gegensatz zu anderen Kursen wie Mathematik\\nwirken sich die Prüfungsergebnisse dieses Kurses\\r\\nweniger stark auf eure Zukunft aus.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_g_07_home_20",
      "hash64": "C7203E2A85A6D4B2",
      "text": "Aber ob es nun darum geht, Essen zuzubereiten,\\neure Pokémon zu waschen oder die richtige\\r\\nKleidung am Morgen auszuwählen...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_g_07_home_21",
      "hash64": "C7203F2A85A6D665",
      "text": "Ich würde mich geehrt fühlen, wenn meine\\nLektionen euer Leben in irgendeiner Weise\\r\\nbereichern können.\\c\\nZumindest hat Señor Sinius mir diese Sichtweise\\nnahegelegt.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_g_07_home_22",
      "hash64": "C7203C2A85A6D14C",
      "text": "Ich danke euch allen herzlich, dass ihr meinem\\nUnterricht bis zum Schluss beigewohnt habt.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_g_07_home_23",
      "hash64": "C7203D2A85A6D2FF",
      "text": "Damit wäre der Unterricht beendet.\\nGebt euer Bestes bei der Abschlussprüfung.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    }
  ]
}
