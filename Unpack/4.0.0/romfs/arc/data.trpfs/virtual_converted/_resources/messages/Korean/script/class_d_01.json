          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_d_01_language_08",
      "hash64": "B8671C2596184726",
      "text": "여러 언어를 합쳐서\\n헬로봉주르니하오안녕~!이라고 인사하는\\r\\n스트리머도 있다더라고![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_d_01_language_09",
      "hash64": "B8671D25961848D9",
      "text": "세계에는 많은 나라가 있고,\\n나라마다 다양한 언어가 있어![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_d_01_language_10",
      "hash64": "B86AAA25961B6E47",
      "text": "그라시아스! 메르시! 셰셰! 당케쉔! 땡큐!\\n이게 전부 같은 의미란다!\\r\\n무슨 뜻인지 아는 사람?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
