      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "ajito_fairy_020_cassiopeia_01",
      "hash64": "32422C00E4F946BF",
      "text": "Du scheinst die Wache losgeworden zu sein. Gut.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_fairy_020_cassiopeia_02",
      "hash64": "32422D00E4F94872",
      "text": "Das ist das Versteck der Rukbat-Bande, die aus\\nden Feen-Mitgliedern von Team Star besteht.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_fairy_020_cassiopeia_03",
      "hash64": "32422E00E4F94A25",
      "text": "Der Boss, Otis, ist Team Stars Mechaniker.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_fairy_020_cassiopeia_04",
      "hash64": "32422700E4F93E40",
      "text": "Er mag der jüngste der Bosse sein, aber er hat es\\nganz schön in sich. Du solltest ihn keinesfalls\\r\\nunterschätzen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_fairy_020_cassiopeia_05",
      "hash64": "32422800E4F93FF3",
      "text": "Außerdem ist er eher der herrische Typ, der\\nanderen aus dem Hintergrund Befehle erteilt,\\r\\nohne sich selbst aktiv am Kampf zu beteiligen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_fairy_020_cassiopeia_06",
      "hash64": "32422900E4F941A6",
      "text": "Allerdings neigt er dazu, sich schnell aufzuregen...\\nSobald er wütend genug ist, wird er sich sicher\\r\\nzeigen, um dich eigenhändig zu beseitigen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "ajito_fairy_020_cassiopeia_07",
      "hash64": "32422A00E4F94359",
      "text": "Vorerst bleibt dir nichts anderes übrig, als seine\\nganzen Rüpel zu besiegen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_fairy_020_cassiopeia_08",
      "hash64": "32423300E4F952A4",
      "text": "Halte dem Ansturm hartnäckig stand, bis Otis\\nauftaucht, okay?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_fairy_020_cassiopeia_09",
      "hash64": "32423400E4F95457",
      "text": "[EMPTY 16]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
