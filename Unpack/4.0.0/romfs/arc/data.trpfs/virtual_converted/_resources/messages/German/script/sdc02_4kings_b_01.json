      "label": "sdc02_4kings_b_01_system_01",
      "hash64": "876FD5B083B0E1A9",
      "text": "Du überträgst 50 BP!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_b_01_clerk_05",
      "hash64": "6F0520D6EB0923A9",
      "text": "Vielen Dank! Hiermit bestätige ich deine\\nTeilnahme an der Top-Vier-Challenge.",
