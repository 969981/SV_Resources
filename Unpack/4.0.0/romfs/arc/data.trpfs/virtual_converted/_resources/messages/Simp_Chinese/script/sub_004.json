        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_004_03",
      "hash64": "93AEF8B5DB5A908E",
      "text": "特别的滚橄榄\\n会记录通关时间。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_004_04",
      "hash64": "93AEFBB5DB5A95A7",
      "text": "只要你能达成厉害的纪录，\\n我会送出精美的礼物。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_004_05",
      "hash64": "93AEFAB5DB5A93F4",
      "text": "要挑战\\n特别的滚橄榄吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
