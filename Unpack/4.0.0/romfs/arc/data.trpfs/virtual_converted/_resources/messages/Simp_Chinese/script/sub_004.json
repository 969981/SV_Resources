      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_004_02",
      "hash64": "93AEF9B5DB5A9241",
      "text": "[VAR 0x0100(0000)]，\\n你已经获得了阿枫的徽章，\\r\\n那就可以挑战特别的滚橄榄啦！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
