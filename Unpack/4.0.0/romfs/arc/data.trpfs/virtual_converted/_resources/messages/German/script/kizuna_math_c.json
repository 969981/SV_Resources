      "hash64": "D2ED3088983CE1A8",
      "text": "[VAR 0x0100(0000)]?! Hast du mich erschreckt![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
