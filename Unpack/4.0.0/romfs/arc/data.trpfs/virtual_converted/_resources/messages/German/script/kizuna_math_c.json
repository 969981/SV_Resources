          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_math_c_select_01",
      "hash64": "8BC7207E364EB1D7",
      "text": "Sind Sie zum Essen hier?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "kizuna_math_c_select_02",
      "hash64": "8BC7217E364EB38A",
      "text": "Hatten Sie vor, etwas zu kochen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_math_c_02",
      "hash64": "D2ED3388983CE6C1",
      "text": "Nein, nein! Nichts dergleichen.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_c_03",
      "hash64": "D2ED3288983CE50E",
      "text": "Als ich vorhin durch die Eingangshalle\\ngelaufen bin...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_c_04",
      "hash64": "D2ED3588983CEA27",
      "text": "...habe ich wieder diesen angespannten Blick in\\nmeinem Nacken gespürt![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_c_05",
      "hash64": "D2ED3488983CE874",
      "text": "Also bin ich schnurstracks in die Mensa.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_c_06",
      "hash64": "D2ED3788983CED8D",
      "text": "Hier gibt es nämlich nur eine Tür, durch die\\nman hinein- oder hinauskommt.\\c\\nWenn mein heimlicher Beobachter mir folgt,\\nkann ich also sehen, um wen es sich handelt![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 165,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_c_07",
      "hash64": "D2ED3688983CEBDA",
      "text": "Aha! Da kommt jemand![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_c_woman_01",
      "hash64": "F42347F9AB47717F",
      "text": "Hm? Komisch, ich dachte, sie wäre hier\\nreingegangen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_c_woman_02",
      "hash64": "F42348F9AB477332",
      "text": "Dann kann ich sie heute schon wieder nicht\\nfragen... *seufz*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_c_08",
      "hash64": "D2ED2988983CD5C3",
      "text": "Ich glaube, dieses Mädchen habe ich schon\\nöfter gesehen...?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_c_09",
      "hash64": "D2ED2888983CD410",
      "text": "Sie sieht mir nach einer Schülerin aus, aber ich\\nhabe irgendwie das Gefühl, dass ihre Frage nichts\\r\\nmit meinem Unterricht zu tun hat.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_c_10",
      "hash64": "D2E9AB889839C9D2",
      "text": "Wenn ich sie das nächste Mal treffe,\\nspreche ich sie darauf an![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_math_c_11",
      "hash64": "D2E9AC889839CB85",
      "text": "Danke, dass du mir Gesellschaft geleistet hast.\\nSo ganz allein war ich doch ein bisschen nervös.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_c_system_01",
      "hash64": "14795A4C3BC6A7F4",
      "text": "Du hast Señora Quendellas Vertrauen gewonnen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
