        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0060_rival_08",
      "hash64": "04D43C0480935C65",
      "text": "哎～不過，這真是一場\\n收穫多多的精彩對戰。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
