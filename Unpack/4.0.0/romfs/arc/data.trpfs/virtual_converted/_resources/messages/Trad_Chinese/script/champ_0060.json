    {
      "ordinal": 4,
      "label": "champ_0060_rival_05",
      "hash64": "04D43F048093617E",
      "text": "那麼，請多指教囉。\\n[VAR 0x0100(0000)]。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
