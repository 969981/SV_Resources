      "hash64": "04D43B0480935AB2",
      "text": "其實我恨不得現在就再打一場！\\n但畢竟我是冠軍，\\r\\n我會體諒對手，忍下來的……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
