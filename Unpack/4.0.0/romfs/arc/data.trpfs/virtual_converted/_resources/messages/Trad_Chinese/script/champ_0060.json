      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0060_rival_07b",
      "hash64": "C80228A67A69894E",
      "text": "抱歉！我派出太多\\n強過頭的寶可夢了。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
