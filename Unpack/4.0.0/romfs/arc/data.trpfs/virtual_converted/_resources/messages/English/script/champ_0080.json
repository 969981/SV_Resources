  "entries": [
    {
      "ordinal": 0,
      "label": "champ_0080_dragon_01",
      "hash64": "0B870AB70EFDD96D",
      "text": "Well, now! [VAR 0x0100(0000)]![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "champ_0080_dragon_02",
      "hash64": "0B8707B70EFDD454",
      "text": "You appear to be progressing well on your\\nGym circuit.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0080_ground_01",
      "hash64": "964B979853F50DFD",
      "text": "What’s this now? Is this that kid I’ve been hearing\\nso much about?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0080_ground_02",
      "hash64": "964B949853F508E4",
      "text": "Hey, kiddo! I heard you’re, like, way too good\\nat battling! Yeah?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0080_select_01",
      "hash64": "2A34295819C78B50",
      "text": "Yeah!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "champ_0080_select_02",
      "hash64": "2A342C5819C79069",
      "text": "Not THAT good...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "champ_0080_ground_03a",
      "hash64": "577A27D6A961A002",
      "text": "Nahaha! You got some spirit, big shot![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0080_ground_03b",
      "hash64": "577A26D6A9619E4F",
      "text": "Pah! You can’t fool me that easily. No need to\\nplay humble, you hear?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0080_dragon_03",
      "hash64": "0B8708B70EFDD607",
      "text": "This young lady would be Rika.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0080_ground_04",
      "hash64": "964B929853F5057E",
      "text": "That’s me! Rika here, at your service.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0080_ground_05",
      "hash64": "964B939853F50731",
      "text": "And hey, I know I’m pretty, but no need to get\\nintimidated or anything.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0080_dragon_04",
      "hash64": "0B8705B70EFDD0EE",
      "text": "She is a little...farcical, shall we say. But like\\nmyself, she is a member of the Elite Four.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0080_ground_06",
      "hash64": "964B909853F50218",
      "text": "What? I wasn’t tryin’ to be funny...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0080_ground_07",
      "hash64": "964B919853F503CB",
      "text": "Aaanyway... Hmm.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0080_ground_08",
      "hash64": "964B8E9853F4FEB2",
      "text": "Tell you something, kiddo—you look fun.\\nLike, interesting. At a glance, anyway.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "champ_0080_dragon_05",
      "hash64": "0B8706B70EFDD2A1",
      "text": "Naturally. [VAR 0x1100(00FF,0201)]HShe is one of our academy’s esteemed\\nstudents.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0201"
          ]
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "champ_0080_ground_09",
      "hash64": "964B8F9853F50065",
      "text": "Oooh, haha. Yeah, that checks out.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "champ_0080_ground_10",
      "hash64": "964EFC9853F7EF73",
      "text": "But the battles you’ll face at these Gyms really\\nratchet up the farther you go.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "champ_0080_dragon_06",
      "hash64": "0B8703B70EFDCD88",
      "text": "Indeed. Your average Trainer abandons the\\nchallenge at roughly this very point.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "champ_0080_ground_11",
      "hash64": "964EFB9853F7EDC0",
      "text": "But not you, right, kiddo?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "champ_0080_ground_12",
      "hash64": "964EFE9853F7F2D9",
      "text": "See you when you hit the Champion Assessment.\\nYou show these Gyms what you’ve got![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "champ_0080_dragon_07",
      "hash64": "0B8704B70EFDCF3B",
      "text": "Best of fortunes to you.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    }
  ]
