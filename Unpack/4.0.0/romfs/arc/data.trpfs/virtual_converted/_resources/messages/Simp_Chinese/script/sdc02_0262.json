      "ordinal": 0,
      "label": "sdc02_0262_sister_01",
      "hash64": "B1E159F3B9D044E1",
      "text": "这是什么？\\n是结晶构成的……好像花一样。\\r\\n路都被挡住了……[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
