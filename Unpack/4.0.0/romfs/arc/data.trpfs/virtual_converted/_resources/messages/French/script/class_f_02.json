        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_f_02_dragon_08",
      "hash64": "29270E35F9FB2A72",
      "text": "Normalement, monsieur Griknot\\nest de type Dragon.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_f_02_dragon_09",
      "hash64": "29270F35F9FB2C25",
      "text": "Pourtant, grâce à la Force Téracristal, il est\\ndésormais d’un autre type.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_f_02_dragon_10",
      "hash64": "292A7C35F9FE1B33",
      "text": "Voyez-vous ce magnifique motif floral qui\\nchatoie au-dessus de sa tête ?\\c\\nÀ votre avis, à quel type renvoie-t-il ?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_f_02_select_01",
      "hash64": "8C2CA3F12D1C7600",
      "text": "Plante.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
