  "entries": [
    {
      "ordinal": 0,
      "label": "gym_mizu_010_mizu_01",
      "hash64": "C38DF125E6D2FF90",
      "text": "Vaultin’ Veluza! I’m late! I’m late![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_mizu_010_receptionist_01",
      "hash64": "7C6C59D62A6DB258",
      "text": "Ah... Kofu! Wait!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "gym_mizu_010_receptionist_02",
      "hash64": "7C6C5CD62A6DB771",
      "text": "Ahhh, he got away. How am I supposed to\\nreturn this to him now...?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mizu_010_receptionist_03",
      "hash64": "7C6C5BD62A6DB5BE",
      "text": "Oh, hey! You’re here as a Gym challenger, right?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mizu_010_select_01",
      "hash64": "D3677BC9BEA50865",
      "text": "Yep!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mizu_010_select_02",
      "hash64": "D36778C9BEA5034C",
      "text": "Uh...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_mizu_010_receptionist_04a",
      "hash64": "D9DFDBEA18744342",
      "text": "I knew it! Of course you are!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_mizu_010_receptionist_04b",
      "hash64": "D9DFDAEA1874418F",
      "text": "You can’t fool me. You’re definitely a challenger!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_mizu_010_receptionist_05",
      "hash64": "7C6C5DD62A6DB924",
      "text": "That big man that just left is Kofu, leader\\nof the Cascarrafa Gym.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_010_receptionist_06",
      "hash64": "7C6C60D62A6DBE3D",
      "text": "He has a bit of a childlike side to him, and today\\nhe’s run off to the market without his wallet.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_010_receptionist_07",
      "hash64": "7C6C5FD62A6DBC8A",
      "text": "He’ll be in big trouble without it...\\c\\nThat’s where you come in, kind Gym challenger!\\nCould you please take Kofu’s wallet to him?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_010_receptionist_08a",
      "hash64": "D9B6D3EA18513096",
      "text": "Ohhh! You are too kind! I’d give you a Gym\\nBadge right now if I could!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_010_receptionist_08b",
      "hash64": "D9B6D2EA18512EE3",
      "text": "I’m sorry, but it’s impossible to challenge our\\nGym without Kofu here. I can’t exactly leave my\\r\\npost here at the lobby, either, so...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_010_receptionist_09",
      "hash64": "7C6C51D62A6DA4C0",
      "text": "Here’s his wallet! I’m counting on you!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_010_receptionist_10",
      "hash64": "7C6954D62A6B7402",
      "text": "This can be your Gym Test here. If you do this for\\nme, you pass!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_010_receptionist_11",
      "hash64": "7C6955D62A6B75B5",
      "text": "Kofu’s headed to [VAR 0xFF00(0006)]Porto Marinada[VAR 0xFF00(0000)]. It’s on the\\nother side of the desert to the west.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_010_receptionist_12",
      "hash64": "7C6952D62A6B709C",
      "text": "Be careful, though. There are many dangerous\\nPokémon in the desert!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
