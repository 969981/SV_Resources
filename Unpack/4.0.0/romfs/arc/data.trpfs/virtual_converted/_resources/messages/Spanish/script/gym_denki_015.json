            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_denki_015_denki_01",
      "hash64": "E12A2F57CA10E111",
      "text": "¿Todos listos? ¡Pues empezamooos![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_denki_015_denki_02",
      "hash64": "E12A2C57CA10DBF8",
      "text": "¡Dejaos atrapar por mi Electrotela!\\c\\n¿Quién soy yo? ¿Pues quién voy a ser?\\n¡Yo misma, la gran Gym Líder e-Nigma!\\c\\n¡Holichiwa, electrolitos míos![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_denki_015_select_01",
      "hash64": "09252C6E0C8AF7B4",
      "text": "¿Tú eres la Líder de Gimnasio?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_denki_015_select_02",
      "hash64": "09252F6E0C8AFCCD",
      "text": "¡Holichiwa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_denki_015_denki_03a",
      "hash64": "AB88D62C5AA8DE3E",
      "text": "¡Encantada! Me llamo e-Nigma y soy la líder de\\neste gimnasio, aunque donde triunfo de verdad\\r\\nes en internet, creando contenido.\\c\\nHashtag streamer-amada-por-todos.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_denki_015_denki_03b",
      "hash64": "AB88D52C5AA8DC8B",
      "text": "Veo que dominas la jerga e-Nigmática, ¿eh?\\n¡No me digas que estás suscrit[VAR 0x1100(00FF,0101)]oa a mi canal![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_denki_015_denki_03",
      "hash64": "E12A2D57CA10DDAB",
      "text": "Siento que te tengas que enterar así, tan de\\nsopetón... ¡pero estamos en vivo y en directo!\\c\\nO sea, que nos están viendo desde todos los\\nrincones del mundo.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 158,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_denki_015_denki_04",
      "hash64": "E12A3257CA10E62A",
      "text": "Gracitillas por venir al Gimnasio de Ciudad\\nLeudal a retarme, querid[VAR 0x1100(00FF,0101)]oa aspirante.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_denki_015_denki_05",
      "hash64": "E12A3357CA10E7DD",
      "text": "Me hace mucha ilu, ¿eh? Pero una diva taaan\\nfamosa como yo siempre está muy ocupada.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_denki_015_denki_06",
      "hash64": "E12A3057CA10E2C4",
      "text": "Por eso solo hago colaboraciones con gente que\\ntenga potencial para hacer virales mis dir... esto...\\r\\n¡con gente que se tome las cosas en serio! ¡Eso![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 152,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_denki_015_denki_07",
      "hash64": "E12A3157CA10E477",
      "text": "Si quieres hacer la combatición contra mí, te\\ntoca currártelo para ganarte a mis seguidores.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_denki_015_denki_08",
      "hash64": "E12A2657CA10D1C6",
      "text": "¡Así me gusta, con desparpajo!\\c\\n¿Quieres que te cuente de qué va todo esto?\\nPues...[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_denki_015_denki_20",
      "hash64": "E1232257CA0AAC4C",
      "text": "¡Que pase el señor Mengano Calleja![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_denki_015_head_teacher_01",
      "hash64": "3DA8B550A77FB5A5",
      "text": "Vaya, vaya, qué grata sorpresa encontrarte aquí,\\n[VAR 0x0100(0000)].[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_denki_015_denki_09",
      "hash64": "E12A2757CA10D379",
      "text": "OMG! ¡No me digas que os conocéis de algo!\\nMenudo giro argumental, electrolitos.[VAR 0x0114(0019)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_denki_015_denki_17",
      "hash64": "E12DB157CA13F3CE",
      "text": "No sé ni cómo se llama, si os soy sincera.\\c\\nMe lo he encontrado por la calle y me ha molado\\nsu estilo, así que lo he invitado a participar hoy.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_denki_015_head_teacher_02",
      "hash64": "3DA8B250A77FB08C",
      "text": "Ja, ja, se me van a subir los colores...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_denki_015_denki_18",
      "hash64": "E12DAC57CA13EB4F",
      "text": "Bueno, volviendo a lo del examen y todo eso...\\c\\n¡¡Espero que te guste jugar al escondite!![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_denki_015_denki_10",
      "hash64": "E12DB457CA13F8E7",
      "text": "Don Mengano se va a esconder por ahí,\\ny tendrás que buscarlo usando las cámaras de\\r\\nseguridad que hay por toda la ciudad.\\c\\nPara aprobar el examen tendrás que encontrarlo\\ntres veces, ¿okis? ¿A que suena fácil?[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 212,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_denki_015_denki_11",
      "hash64": "E12DB357CA13F734",
      "text": "Creo que voy a llamarlo: \"Mengano Calleja:\\nSu escondite más secreto\".[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_denki_015_denki_12",
      "hash64": "E12DB657CA13FC4D",
      "text": "Hmm... Igual suena un poco engañoso...\\n¿Y si la lío parda y me acribillan a no me gusta?[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_denki_015_denki_13",
      "hash64": "E12DB557CA13FA9A",
      "text": "¡Bah, qué más da! Yo le doy el pistoletazo de\\nsalida a don Mengano y... ¡a esconderse toca![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_denki_015_head_teacher_03",
      "hash64": "3DA8B350A77FB23F",
      "text": "Con todo lo que la Liga Pokémon ha hecho por\\nla academia, no me queda otra alternativa más\\r\\nque seguirle la corriente.\\c\\nTen piedad de tu pobre director.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
