          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0310_botan_07",
      "hash64": "269F26F805458080",
      "text": "I’ll just go ahead and add the bases’ locations to\\nyour phone for you.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
