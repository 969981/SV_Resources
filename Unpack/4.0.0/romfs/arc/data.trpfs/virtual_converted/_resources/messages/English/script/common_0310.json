    {
      "ordinal": 19,
      "label": "common_0310_botan_08",
      "hash64": "269F35F8054599FD",
      "text": "Good luck with those bosses. I’ll hook you up\\nwith some nice rewards every time you beat one.[VAR 0x0114(0009)]",
