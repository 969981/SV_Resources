          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_home_b_system_01",
      "hash64": "1F8785FE16DAD786",
      "text": "和薩瓦羅老師\\n變得更要好了一點！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
