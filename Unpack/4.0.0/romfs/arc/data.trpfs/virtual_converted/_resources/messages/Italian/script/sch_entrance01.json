      "ordinal": 39,
      "label": "sch_entrance01_boy_10",
      "hash64": "EB305BE6A2406AD6",
      "text": "C’è una ragazza di nome Penny nel corso di studi\\nscientifici che è un vero genio, e ne capisce\\r\\nanche un sacco di macchinari...\\c\\nHo sentito che è tornata a scuola da poco.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
