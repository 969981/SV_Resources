          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_side01_010_brother_16",
      "hash64": "F25DCFE6987C5198",
      "text": "미, 미안.\\n그러려던 건 아닌데...\\r\\n아무튼... 다음에... 응...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
