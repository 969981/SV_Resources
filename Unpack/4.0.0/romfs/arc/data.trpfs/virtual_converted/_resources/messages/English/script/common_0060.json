    {
      "ordinal": 16,
      "label": "common_0060_mama_01",
      "hash64": "3C5488FF337D9E1E",
      "text": "What a mannerly fellow that director of yours is![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
