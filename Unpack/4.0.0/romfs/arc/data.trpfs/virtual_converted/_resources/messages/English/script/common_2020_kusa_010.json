          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_kusa_010_kusa_04",
      "hash64": "5570C2F19675A016",
      "text": "Each time I recall our artistic battle, I’ve found\\nmyself wishing to face you once again...[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_kusa_010_kusa_05",
      "hash64": "5570C3F19675A1C9",
      "text": "I am so very glad that you are here! Praise\\nMother Nature![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_kusa_010_kusa_06",
      "hash64": "5570C0F196759CB0",
      "text": "I had planned to meet with the Top Champion\\ntoday, but I have just now canceled that plan!\\r\\nShall we instead talk of art together?[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_kusa_010_kusa_07",
      "hash64": "5570C1F196759E63",
      "text": "What? You came in the Top Champion’s stead?\\nWell, I cannot be bothered by that.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_kusa_010_kusa_08",
      "hash64": "5570CEF19675B47A",
      "text": "I don’t care what the reason is—if we can make\\na masterpiece together once more, then fine![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
