      ]
    },
    {
      "ordinal": 27,
      "label": "team_0070_cassiopeia_13",
      "hash64": "54BACAE74487B281",
      "text": "但只要所有老大都引退的话，\\n真老大应该就会登场。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
