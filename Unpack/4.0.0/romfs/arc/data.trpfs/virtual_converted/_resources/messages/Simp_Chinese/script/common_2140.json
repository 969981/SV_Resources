          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_2140_mobs_01",
      "hash64": "CBD019B9795376A0",
      "text": "哦哦哦哦！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
