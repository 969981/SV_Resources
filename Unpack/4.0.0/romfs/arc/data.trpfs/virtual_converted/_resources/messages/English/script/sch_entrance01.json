    {
      "ordinal": 62,
      "label": "sch_entrance01_girl_06",
      "hash64": "A478D4916FCE5155",
      "text": "The school is so mysterious at night! You meet\\ncompletely different people than during the day!\\c\\nDid you know that outside towns, different\\nPokémon come out at night too?",
