    },
    {
      "ordinal": 19,
      "label": "ajito_aku_010_sitappa_b_07",
      "hash64": "C01FE6B0C3FE7132",
      "text": "......[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
