  "entries": [
    {
      "ordinal": 0,
      "label": "common_0170_rival_01",
      "hash64": "3BFE1643B39D10D4",
      "text": "굉장한 몸놀림이네!\\n엄청난 위기였는데 말이야![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
