  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_dragon_d_01",
      "hash64": "2EFA878873A3ED0C",
      "text": "這不是[VAR 0x0100(0000)]同學嗎？[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
