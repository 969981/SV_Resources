      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_ecology_a_03b",
      "hash64": "ADA24F915EEB850C",
      "text": "No te preocupes, que eso seguro que cambia\\ndentro de nada, ya verás.\\c\\nSi tienes algún problema o necesitas consejos,\\nno dudes en venir a hablar conmigo.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
