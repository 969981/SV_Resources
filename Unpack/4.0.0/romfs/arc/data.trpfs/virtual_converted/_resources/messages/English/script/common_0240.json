          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0240_teacher_01",
      "hash64": "2494B95635570CC8",
      "text": "We have some exciting news this morning. Who\\nwants to hear it?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0240_student_07",
      "hash64": "EF85C997133C4B51",
      "text": "Oooh oooh! Me! I want to hear the news!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_0240_teacher_02",
      "hash64": "2494BC56355711E1",
      "text": "I suppose I should have told you sooner, but\\nwe have a new little friend joining our happy\\r\\nhomeroom as of today.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0240_student_01",
      "hash64": "EF85CB97133C4EB7",
      "text": "*whisper whisper whisper*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0240_student_02",
      "hash64": "EF85CC97133C506A",
      "text": "I wonder what they’ll be like?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_0240_teacher_03",
      "hash64": "2494BB563557102E",
      "text": "All right! You can come on in![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0240_teacher_04",
      "hash64": "2494BE5635571547",
      "text": "Could I trouble you for a few words introducing\\nyourself?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0240_select_01",
      "hash64": "8B4D15CBB8D748BA",
      "text": "Sure! I’m [VAR 0x0100(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0240_select_02",
      "hash64": "8B4D14CBB8D74707",
      "text": "Right. I’m [VAR 0x0100(0000)]...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0240_student_03a",
      "hash64": "3CAED3B5AF8028B4",
      "text": "Did you hear that? [VAR 0x1100(00FF,0201)]HShe seems super friendly\\nand fun!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0201"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0240_student_03b",
      "hash64": "3CAED6B5AF802DCD",
      "text": "So calm and collected! [VAR 0x1100(00FF,0201)]HShe’s pretty cool!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0201"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0240_teacher_05",
      "hash64": "2494BD5635571394",
      "text": "Looks like everyone’s eager to get to know you,\\n[VAR 0x0100(0000)].[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0240_teacher_06",
      "hash64": "2494C056355718AD",
      "text": "All right, then. Who wants to be the first to ask\\nour new friend a question?[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
