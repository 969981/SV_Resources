      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "class_f_06_select_03",
      "hash64": "C2970FC33ECF494A",
      "text": "꼬리",
      "flags": 0,
