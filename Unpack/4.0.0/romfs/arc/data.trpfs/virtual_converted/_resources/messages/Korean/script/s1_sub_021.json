    {
      "ordinal": 2,
      "label": "s1_sub_021_gmother_02",
      "hash64": "5B28E3DD088D7CF2",
      "text": "시유도 카지도\\n이제는 맞지 않아서 말이다.[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
