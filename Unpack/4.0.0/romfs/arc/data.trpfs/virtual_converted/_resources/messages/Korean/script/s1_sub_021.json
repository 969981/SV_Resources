    {
      "ordinal": 4,
      "label": "s1_sub_021_gmother_04",
      "hash64": "5B28DDDD088D72C0",
      "text": "후후, 아이들의 성장은\\n정말 빠르단 말이지.[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
