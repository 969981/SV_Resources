    {
      "ordinal": 9,
      "label": "s2_side02_0030_camera_b1_01",
      "hash64": "BA432C630EB91432",
      "text": "Un autentico Massoferreo!\\nCom’è... massiccio![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
