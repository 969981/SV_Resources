      "ordinal": 13,
      "label": "s2_side02_0030_camera_b2_01",
      "hash64": "67C8EC7EC9AD97C5",
      "text": "Un Capoferreo in... ferro e ossa!\\nCom’è... lucido![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
