  "entries": [
    {
      "ordinal": 0,
      "label": "class_g_08_math_01",
      "hash64": "D651E6C1B9BC6BD9",
      "text": "지금이야말로 그간 제군들이\\n배운 것들을 시험할 때다![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
