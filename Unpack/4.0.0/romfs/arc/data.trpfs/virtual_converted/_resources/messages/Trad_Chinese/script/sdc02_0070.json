      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0070_fairybb_02",
      "hash64": "6A30E5939BD65B66",
      "text": "窸窸窣窣……？（[VAR 0x1100(00FF,0101)]你妳沒有迷路吧？）[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0070_select_01",
      "hash64": "1339D8740A3EC6A0",
      "text": "沒有！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc02_0070_select_02",
      "hash64": "1339DB740A3ECBB9",
      "text": "窸窸窣窣……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_0070_fairybb_03",
      "hash64": "6A30E6939BD65D19",
      "text": "窸窣！（太好了！）[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0070_fairybb_04",
      "hash64": "6A30E7939BD65ECC",
      "text": "……窸窣？（……[VAR 0x1100(00FF,0101)]你妳說什麼？）[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0070_teacher_01",
      "hash64": "E7AD0FEE0DEEEFA2",
      "text": "各位同學，阿羅拉！\\n我們這就開始上課吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_0070_teacher_02",
      "hash64": "E7AD0EEE0DEEEDEF",
      "text": "看來今天有\\n第一次參加的同學呢！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc02_0070_teacher_03",
      "hash64": "E7AD0DEE0DEEEC3C",
      "text": "這個海岸區，\\n透過人工重現出了\\r\\n像南國島嶼一般的環境。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0070_teacher_04",
      "hash64": "E7AD0CEE0DEEEA89",
      "text": "同時，這裡棲息著許多\\n適應了這種溫暖氣候的寶可夢。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc02_0070_teacher_05",
      "hash64": "E7AD0BEE0DEEE8D6",
      "text": "當中也有寶可夢因為受到\\n比一般環境還要多的光照，\\r\\n所以長得比其他地區的同類還要大喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0070_teacher_06",
      "hash64": "E7AD0AEE0DEEE723",
      "text": "沒錯！相同的寶可夢在不同地區的\\n樣子長得不同，這就是[VAR 0xFF00(0006)]地區形態[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0070_teacher_07",
      "hash64": "E7AD09EE0DEEE570",
      "text": "那麼，大家實際去捉捉看\\n地區形態是[VAR 0xFF00(0006)]阿羅拉的樣子[VAR 0xFF00(0000)]的寶可夢吧！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0070_teacher_08",
      "hash64": "E7AD18EE0DEEFEED",
      "text": "捉到之後記得\\n要來給我看看喔。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0070_teacher_09",
      "hash64": "E7AD17EE0DEEFD3A",
      "text": "那麼，課堂開始！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_0070_fairybb_05",
      "hash64": "6A30E8939BD6607F",
      "text": "藍莓學園有很多\\n需要實際去嘗試看看的課程。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0070_fairybb_06",
      "hash64": "6A30E9939BD66232",
      "text": "那麼那麼，\\n[VAR 0x1100(00FF,0101)]你妳的第一堂課要好好加油咯！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0070_fairybb_07",
      "hash64": "6A30EA939BD663E5",
      "text": "[VAR 0x1100(00FF,0101)]你妳知道該去找什麼寶可夢嗎？\\c\\n比如說成長得好～長的椰蛋樹，\\n就是經典的阿羅拉的樣子的寶可夢！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0070_mob_01",
      "hash64": "83A86BC65CA24E32",
      "text": "嘿，[VAR 0x1100(00FF,0101)]你妳知道嗎？\\n阿羅拉的三地鼠，\\r\\n是會長著……鬍鬚？的喔！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0070_mob_02",
      "hash64": "83A86AC65CA24C7F",
      "text": "在南國島嶼組成的阿羅拉地區，\\n大家會說「阿羅拉」來打招呼喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc02_0070_mob_03",
      "hash64": "83A869C65CA24ACC",
      "text": "哪一隻寶可夢是\\n阿羅拉的樣子來著？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
