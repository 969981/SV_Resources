      "ordinal": 0,
      "label": "sdc01_0150_shop_01",
      "hash64": "105B35B2987AB446",
      "text": "Qui veut participer à la Chasse aux Monstres ?\\nVous deux ! Vous voulez essayer ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc01_0150_shop_02",
      "hash64": "105B34B2987AB293",
      "text": "Tiens ? Tu fais partie du groupe d’élèves\\nde Paldea, si je ne m’abuse ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sdc01_0150_shop_03",
      "hash64": "105B33B2987AB0E0",
      "text": "Dans ce cas, garde ton argent ! C’est cadeau !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc01_0150_brother_01",
      "hash64": "E1226AC8663731E0",
