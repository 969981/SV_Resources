      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "ajito_kakutou_020_cassiopeia_01",
      "hash64": "781BBADBBA8A3082",
      "text": "Sei riuscit[VAR 0x1100(00FF,0101)]oa a eludere la sorveglianza?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
