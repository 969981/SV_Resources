            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_kakutou_020_cassiopeia_02",
      "hash64": "781BB9DBBA8A2ECF",
      "text": "Questa base è occupata dalla Banda Caph,\\nla Divisione Lotta del Team Star.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_kakutou_020_cassiopeia_03",
      "hash64": "781BB8DBBA8A2D1C",
      "text": "Nespera, la capobanda, è un’esperta di lotta\\nlibera che fa da maestra a tutti gli altri.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_kakutou_020_cassiopeia_04",
      "hash64": "781BB7DBBA8A2B69",
      "text": "Credo sia la più attenta a eventuali ostilità\\ncontro il Team Star.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_kakutou_020_cassiopeia_05",
      "hash64": "781BB6DBBA8A29B6",
      "text": "È possibile che fronteggi gli intrusi attaccando\\nper prima, con l’obiettivo di schiacciarli subito.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_kakutou_020_select_01",
      "hash64": "27F32B7B4AAD33F3",
      "text": "È quello che ha fatto!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_kakutou_020_select_02",
      "hash64": "27F32C7B4AAD35A6",
      "text": "L’abbiamo già incontrata!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "ajito_kakutou_020_cassiopeia_06",
      "hash64": "781BB5DBBA8A2803",
      "text": "Lo sapevo...! Com’è andata?![VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_kakutou_020_cassiopeia_07",
      "hash64": "781BB4DBBA8A2650",
      "text": "Nespi è scappata...?! Possibile..?![VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_kakutou_020_cassiopeia_08",
      "hash64": "781BC3DBBA8A3FCD",
      "text": "In questo caso non si può fare altro che\\nconquistare la base con un attacco frontale.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
