    },
    {
      "ordinal": 1,
      "label": "champ_0128_rival_02",
      "hash64": "A5DB927965336262",
      "text": "對戰場是這種感覺啊～！\\n原來如此！這要多注意一下！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
