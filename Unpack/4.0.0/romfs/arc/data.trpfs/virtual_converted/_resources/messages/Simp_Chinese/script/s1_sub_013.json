    {
      "ordinal": 38,
      "label": "s2_sub_013_picnic_chair_02",
      "hash64": "8FC821AC036A8916",
      "text": "噢噢，这是根据名为蓝莓学园的\\n设施来设计的吗……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "s2_sub_013_picnic_chair_03",
