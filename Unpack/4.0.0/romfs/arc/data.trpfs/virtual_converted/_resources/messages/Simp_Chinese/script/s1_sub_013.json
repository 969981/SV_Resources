          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_sub_013_picnic_19",
      "hash64": "6866FBA477DC9B31",
      "text": "我打算去野餐，\\n暂时悠闲地生活一阵。\\r\\n这段时间多谢你陪我啦。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
