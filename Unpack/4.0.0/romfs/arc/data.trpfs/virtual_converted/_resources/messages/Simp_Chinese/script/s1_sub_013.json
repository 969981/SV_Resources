      "label": "s1_sub_013_system_01_s",
      "hash64": "041EEC65DA2D69D3",
      "text": "[VAR 0x0100(0000)]给叔叔\\n看了桌巾！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
