          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb4kings_honoo_sp02_select_01",
      "hash64": "9364298E4642F873",
      "text": "¡Mucho!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_bb4kings_honoo_sp02_select_02",
      "hash64": "93642A8E4642FA26",
      "text": "Lo normal",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb4kings_honoo_sp02_01",
      "hash64": "EE5436582F6D2814",
      "text": "¿A que sí? ¡Ya lo sabía yo! Para ti mi reto fue pan\\ncomido, literalmente.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_bb4kings_honoo_sp02_01b",
      "hash64": "6640CDD8967BC082",
      "text": "¿Síii? Pues te digo yo que en mi reto te supiste\\nmanejar muy bien para gustarte \"lo normal\".[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb4kings_honoo_sp02_02",
      "hash64": "EE5439582F6D2D2D",
      "text": "¡A mí, por descontado, me encanta! ¡Veo una\\nsartén y se me va la olla![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb4kings_honoo_sp02_03",
      "hash64": "EE5438582F6D2B7A",
      "text": "Mi hogar es la cocina, tal cual. Mi familia tiene\\nun restaurante, y yo pienso heredar el negocio.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb4kings_honoo_sp02_04",
      "hash64": "EE5433582F6D22FB",
      "text": "Si me apunté a la academia fue únicamente\\nporque me invitó el director en persona.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb4kings_honoo_sp02_05",
      "hash64": "EE5432582F6D2148",
      "text": "Pero, luego, al ver cómo Cass y Levi lo daban\\ntodo en la arena...[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_bb4kings_honoo_sp02_06",
      "hash64": "EE5435582F6D2661",
      "text": "¡Su ardor y su pasión eran tan contagiosos que\\nme sorprendí, la verdad![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_bb4kings_honoo_sp02_07",
      "hash64": "EE5434582F6D24AE",
      "text": "Me di cuenta de que los combates Pokémon son\\nalgo muy grande si logran encender así a la peña.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_bb4kings_honoo_sp02_08",
      "hash64": "EE542F582F6D1C2F",
      "text": "¡Y me dieron ganas a mí también de echar toda\\nla carne en el asador![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb4kings_honoo_sp03_00",
      "hash64": "4600615FCBEC4FF6",
      "text": "¡Escucha, [VAR 0x0100(0000)]![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb4kings_honoo_sp03_01",
      "hash64": "4600625FCBEC51A9",
      "text": "¡No sé qué ha pasado, pero parece que al final\\nvoy a conservar mi puesto en el Alto Mandooo![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb4kings_honoo_sp03_select_01",
      "hash64": "23BA9267B1786E38",
      "text": "¡Me alegro!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_honoo_sp03_select_02",
      "hash64": "23BA9567B1787351",
      "text": "¿Y eso?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_honoo_sp03_02",
      "hash64": "46005F5FCBEC4C90",
      "text": "Sí, yo también... supongo. ¡Pero sigo sin entender\\nel motivo![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_bb4kings_honoo_sp03_02b",
      "hash64": "DEEF01C78286BF36",
      "text": "Ya me gustaría a mí saberlo. Estoy igual de\\nsorprendido que tú.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_bb4kings_honoo_sp03_03",
      "hash64": "4600605FCBEC4E43",
      "text": "Por lo visto, Cass piensa tomarse un descanso,\\ny, entre una cosa y otra...[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_bb4kings_honoo_sp03_04",
      "hash64": "4600655FCBEC56C2",
      "text": "Al final, se ha decidido suspender de momento\\nla clasificación, o algo así... ¡Yo qué sé![VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_bb4kings_honoo_sp03_05",
      "hash64": "4600665FCBEC5875",
      "text": "Aroa ha intentado explicármelo antes, pero me\\nha entrado por un oído y me ha salido por otro.\\r\\n¡No me acuerdo ni de la mitad![VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_bb4kings_honoo_sp03_06",
      "hash64": "4600635FCBEC535C",
      "text": "Pero bueno, ¡yo desde luego no voy a quejarme!\\c\\nA cada miembro del Alto Mando se le asigna una\\nplaza del Biodomo, lo que a mí me viene genial...[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
