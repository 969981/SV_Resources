    {
      "ordinal": 2,
      "label": "s2_side02_0000_camera_02",
      "hash64": "9042752F47698CE8",
      "text": "嘿～你不是助手……不对，\\n你不是[VAR 0x0100(0000)]吗？[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
