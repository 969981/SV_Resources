          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_side02_0000_camera_19",
      "hash64": "9045742F476BC10C",
      "text": "啊！说起照片，\\n我掌握了一个[VAR 0xFF00(0006)]劲爆的消息[VAR 0xFF00(0000)]！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s2_side02_0000_camera_20",
      "hash64": "903B6B2F47635D3C",
      "text": "……要是把这消息告诉你，\\n感觉你马上就会跑到什么地方去。[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_side02_0000_camera_21",
      "hash64": "903B6C2F47635EEF",
      "text": "对了！你在这个巨蛋中\\n多多捕捉宝可梦吧！\\r\\n我会悄悄给你拍照的！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
