          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_math_b_04",
      "hash64": "A86EB793E1A4C3BE",
      "text": "Könnte es sein, dass du mich beobachtet hast?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
