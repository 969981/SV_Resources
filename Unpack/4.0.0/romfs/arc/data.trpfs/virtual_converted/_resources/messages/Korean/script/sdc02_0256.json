      "label": "sdc02_0256_sister_04",
      "hash64": "F7D07AA5533A631D",
      "text": "저쪽에서\\n뭔가 마구 뒤지고 있어.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
