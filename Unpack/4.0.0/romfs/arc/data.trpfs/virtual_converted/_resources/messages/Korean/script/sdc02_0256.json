      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0256_bbteacher_03",
      "hash64": "C08F446A8DDEA1DA",
      "text": "그렇구나! 이게 그거란 말이지...!![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
