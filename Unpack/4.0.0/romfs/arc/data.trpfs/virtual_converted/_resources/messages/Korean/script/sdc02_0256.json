    {
      "ordinal": 8,
      "label": "sdc02_0256_sister_05",
      "hash64": "F7D079A5533A616A",
      "text": "흐응~?\\n제법 윤리적인데?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
