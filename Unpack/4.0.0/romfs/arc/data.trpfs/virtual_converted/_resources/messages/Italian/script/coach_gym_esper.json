    {
      "ordinal": 18,
      "label": "coach_gym_esper_sp02_04",
      "hash64": "FC431B675651C054",
      "text": "A Paldea sono una celebrità, ma all’estero non\\nsono per nulla conosciuta. Pazzurdo, no?[VAR 0x0114(001C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
