        }
      ]
    },
    {
      "ordinal": 23,
      "label": "atlantis_talk_05_friend_12",
      "hash64": "6C5D8831BFB6F8C3",
      "text": "...[VAR 0x0100(0000)],\\n미리 말해 주지 않아서 미안해.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
