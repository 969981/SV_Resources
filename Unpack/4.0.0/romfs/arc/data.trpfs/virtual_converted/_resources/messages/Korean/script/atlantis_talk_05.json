      "label": "atlantis_talk_05_rival_02",
      "hash64": "169E9D8064C84F50",
      "text": "[VAR 0x0100(0000)]!\\n당장 [VAR 0x0101(0001)][VAR 0x1900(0006)]랑 승부하게 해 줘![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
