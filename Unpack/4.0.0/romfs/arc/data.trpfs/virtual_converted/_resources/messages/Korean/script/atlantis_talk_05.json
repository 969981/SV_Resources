          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "atlantis_talk_05_friend_13",
      "hash64": "6C5D8731BFB6F710",
      "text": "너, 너희들...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
