    },
    {
      "ordinal": 7,
      "label": "gym_kusa_020_kusapoke_01",
      "hash64": "F9094E7956873DEE",
      "text": "앗! 해루미가 있다!\\c\\n...해루미는 [VAR 0x0100(0000)][VAR 0x1900(0002)]\\n따라오게 되었다!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
