      "label": "sub_028_system_d",
      "hash64": "4AF370673E33AA4F",
      "text": "[VAR 0x0100(0000)]获得了\\n[VAR 0xFF00(0008)]阿尔宙斯手机壳[VAR 0xFF00(0000)]！",
      "flags": 0,
