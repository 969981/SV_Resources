{
  "version": "4.0.0",
  "language": "it",
  "language_raw": "Italian",
  "source": "message/dat/Italian/script/t04.dat",
  "paired_tbl": "message/dat/Italian/script/t04.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "t04_01",
      "hash64": "916BCBBC289694FB",
      "text": "Benvenut[VAR 0x1100(00FF,0101)]oa a Los Tazones, città dei fiori e\\ndell’arte!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "t04_09",
      "hash64": "916BC3BC28968763",
      "text": "Guarda che espressione tormentata ha Sunflora!\\nChissà cosa avrà voluto esprimere l’artista...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "t04_12",
      "hash64": "916F4EBC2899A96B",
      "text": "Avevo appuntamento con la mia ragazza davanti\\nalla scultura strana! Non capisco perché non sia\\r\\nancora arrivata!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "t04_26",
      "hash64": "9172D0BC289CBC28",
      "text": "Avevo appuntamento con il mio ragazzo davanti\\nalla scultura strana, ma questa città è strapiena\\r\\ndi sculture strane!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "t04_31",
      "hash64": "91763BBC289FA7D0",
      "text": "Prova a completare il famoso percorso labirintico\\ndi Loz Tazones!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "t04_36",
      "hash64": "917642BC289FB3B5",
      "text": "Quando arriva la primavera, arrivano anche\\ni Sunkern trasportati dal vento.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "t04_58",
      "hash64": "917CD0BC28A510AD",
      "text": "Dunque, l’opera si sviluppa concettualmente\\nriproducendo accentuazioni contrastive...\\r\\nNon che tu possa capirlo se non te ne intendi.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "t04_64",
      "hash64": "918052BC28A8236A",
      "text": "Sono venuta per vedere questa famosa opera!\\nIl senso un po’ mi sfugge, ma mi piace!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "t04_65",
      "hash64": "918053BC28A8251D",
      "text": "Un altro vicolo cieco... Uffi, mi sono persa!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "t04_69",
      "hash64": "918047BC28A810B9",
      "text": "Caspita, sei riuscit[VAR 0x1100(00FF,0101)]oa ad arrivare fin qui!\\c\\nSiccome non ce la fa mai nessuno, uso questo\\nposto come base segreta!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "t04_74",
      "hash64": "9183D0BC28AB2F5B",
      "text": "Se sei stanc[VAR 0x1100(00FF,0101)]oa, prova a fermarti per un momento.\\nPotresti anche fare delle nuove scoperte.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "t04_76",
      "hash64": "9183D2BC28AB32C1",
      "text": "Non ci posso credere che i Sunkern si evolvono\\nin Sunflora! Che cosa strana, l’evoluzione!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "t04_105",
      "hash64": "B9D313B8FD20C76C",
      "text": "Bello il mio Cyclizar, eh? Viaggiamo insieme\\nin lungo e in largo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "t04_115",
      "hash64": "B9CFA7B8FD1DDA11",
      "text": "Questa dev’essere l’opera di Brassius! Però\\nlo stile mi sembra un po’ diverso dal solito...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "t04_118",
      "hash64": "B9CFA2B8FD1DD192",
      "text": "Io adoro i posti alti! Dicono che fuori città\\nci sono delle torri d’osservazione altissime!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
