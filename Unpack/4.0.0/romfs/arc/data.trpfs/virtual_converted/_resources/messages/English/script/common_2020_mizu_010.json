    {
      "ordinal": 11,
      "label": "common_2020_mizu_010_mizu_09",
      "hash64": "23B360EDDFA1A8E7",
      "text": "That’s what I like to hear! Right this way![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
