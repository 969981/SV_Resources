    {
      "ordinal": 6,
      "label": "s1_sub_014_header_14",
      "hash64": "5C4E3AC3E115D386",
      "text": "那麼就維持現在的設定了。\\n請繼續享受在北上觀光的時光。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_014_header_06",
      "hash64": "5C51CAC3E118FE0D",
      "text": "我幫[VAR 0x1100(00FF,0101)]你妳設定成\\n帕底亞色了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
