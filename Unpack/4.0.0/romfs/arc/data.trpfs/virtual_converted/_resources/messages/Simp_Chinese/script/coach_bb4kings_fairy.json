      "ordinal": 33,
      "label": "coach_bb4kings_fairy_sp03_select_01",
      "hash64": "30EE3D64CC124D0E",
      "text": "边享乐边努力！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "coach_bb4kings_fairy_sp03_select_02",
      "hash64": "30EE3C64CC124B5B",
      "text": "开朗有活力！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "coach_bb4kings_fairy_sp03_select_03",
      "hash64": "30EE3B64CC1249A8",
      "text": "安全第一！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "coach_bb4kings_fairy_sp03_05",
      "hash64": "AFF8928C858C4AAB",
      "text": "“边享乐边努力”……\\n嗯！我觉得很好！[VAR 0x0114(0049)]",
      "flags": 0,
