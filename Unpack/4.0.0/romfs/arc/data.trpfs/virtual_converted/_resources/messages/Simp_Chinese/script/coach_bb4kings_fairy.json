    },
    {
      "ordinal": 3,
      "label": "coach_bb4kings_fairy_sp01_01",
      "hash64": "86B5CA9CF60274D5",
      "text": "和乌栗他们一起去的\\n校外活动，你感觉怎么样？[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
