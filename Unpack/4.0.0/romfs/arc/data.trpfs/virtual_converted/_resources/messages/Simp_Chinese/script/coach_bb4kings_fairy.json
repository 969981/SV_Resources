          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_bb4kings_fairy_sp02_01",
      "hash64": "584CCA84E90DCB02",
      "text": "我来汇报一下[VAR 0x0100(0000)]你\\n外出期间联盟社的情况吧。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb4kings_fairy_sp02_02",
      "hash64": "584CC984E90DC94F",
      "text": "首先……为了防止混乱，\\n现在暂停了\\r\\n蓝莓联盟的排名变动！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb4kings_fairy_sp02_03",
      "hash64": "584CC884E90DC79C",
      "text": "还正式追加了留学生\\n也可以成为冠军的规则！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb4kings_fairy_sp02_04",
      "hash64": "584CC784E90DC5E9",
      "text": "被乌栗改掉的社规中太严格的部分，\\n我们重新考虑并把这部分改了回去！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb4kings_fairy_sp02_05",
      "hash64": "584CC684E90DC436",
      "text": "……还有很多！\\n我们做了很多事哦！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_bb4kings_fairy_sp02_select_01",
      "hash64": "0D491132F0304C51",
      "text": "谢谢！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_bb4kings_fairy_sp02_select_02",
      "hash64": "0D490E32F0304738",
      "text": "辛苦了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "coach_bb4kings_fairy_sp02_06",
      "hash64": "584CC584E90DC283",
      "text": "……啊！抱歉！\\n可能听起来像是强行让你感谢一样。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb4kings_fairy_sp02_07",
      "hash64": "584CC484E90DC0D0",
      "text": "[VAR 0x0100(0000)]你不要在意！\\n因为这是我们的责任……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb4kings_fairy_sp02_08",
      "hash64": "584CD384E90DDA4D",
      "text": "……但杜若还是老样子，\\n在开会的时候睡、着、了！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb4kings_fairy_sp02_09",
      "hash64": "584CD284E90DD89A",
      "text": "……就是这些！\\n联盟社的近况汇报完毕～！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_fairy_sp03_00",
      "hash64": "AFF8958C858C4FC4",
      "text": "[VAR 0x0100(0000)]，\\n方便说话吗？[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_fairy_sp03_01",
      "hash64": "AFF8968C858C5177",
      "text": "之前乌栗当冠军的时候，\\n社里的气氛非常沉重……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_bb4kings_fairy_sp03_02",
      "hash64": "AFF8978C858C532A",
      "text": "甚至有人因为\\n受不了而离开社团。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_bb4kings_fairy_sp03_03",
      "hash64": "AFF8988C858C54DD",
      "text": "……所以！我想\\n让[VAR 0x0100(0000)]你\\r\\n决定联盟社今后的方针！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_bb4kings_fairy_sp03_04",
      "hash64": "AFF8918C858C48F8",
      "text": "你有什么好的方针吗？[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
