  "entries": [
    {
      "ordinal": 0,
      "label": "sub_046_child_f_01",
      "hash64": "AF56210A305FD036",
      "text": "Mi fai vedere quanto vai d’accordo con i tuoi\\nPokémon?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_046_child_f_02",
      "hash64": "AF56200A305FCE83",
      "text": "Quale Pokémon vuoi farmi vedere per controllare\\nquanto siete amici?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_046_child_f_03",
      "hash64": "AF561F0A305FCCD0",
      "text": "Allora, [VAR 0x0100(0000)]... Vediamo quanto vai\\nd’accordo con [VAR 0x0102(0001)].",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_046_child_f_04",
      "hash64": "AF56260A305FD8B5",
      "text": "Che bello! Siete amici del cuore! Siete felicissimi\\nquando siete insieme!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_046_child_f_05",
      "hash64": "AF56250A305FD702",
      "text": "Siete inseparabili! Vi volete proprio bene, eh?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_046_child_f_06",
      "hash64": "AF56240A305FD54F",
      "text": "Oooh! Siete davvero ottimi amici! Vi divertite\\ntanto insieme!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_046_child_f_07",
      "hash64": "AF56230A305FD39C",
      "text": "La vostra è una bella amicizia! Ma secondo me\\npotete diventare ancora più amici!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_046_child_f_08",
      "hash64": "AF562A0A305FDF81",
      "text": "Cominciate ad andare d’accordo! Vedrai\\nche farete amicizia presto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_046_child_f_09",
      "hash64": "AF56290A305FDDCE",
      "text": "Siete... normali. Dai, potete fare di più!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_046_child_f_10",
      "hash64": "AF529C0A305CB860",
      "text": "Vi siete appena incontrati, vero? Il tuo Pokémon\\nnon sembra molto contento di stare vicino a te...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_046_child_f_11",
      "hash64": "AF529D0A305CBA13",
      "text": "Altro che amici... Che è successo?!\\nNon andate per niente d’accordo...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_046_child_f_12",
      "hash64": "AF529E0A305CBBC6",
      "text": "Tieni, è un regalino per festeggiare la vostra\\namicizia!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_046_system_01",
      "hash64": "4DBAA28FEF755C82",
      "text": "[VAR 0x0102(0001)] ha ricevuto il Fiocco Amicizia!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_046_child_f_13",
      "hash64": "AF529F0A305CBD79",
      "text": "Torna quando vuoi!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_046_child_f_14",
      "hash64": "AF52A00A305CBF2C",
      "text": "Stando insieme ai Pokémon, piano piano\\nsi diventa grandi amici!",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
