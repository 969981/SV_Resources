  "entries": [
    {
      "ordinal": 0,
      "label": "club_itemmachine_msg_first_00",
      "hash64": "6C76D0975AF7CD8E",
      "text": "Grazie per aver installato uno Stampastrumenti.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "club_itemmachine_msg_first_01",
      "hash64": "6C76D1975AF7CF41",
      "text": "Io faccio parte del club di scienze che\\nl’ha inventato.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "club_itemmachine_msg_first_02",
      "hash64": "6C76CE975AF7CA28",
      "text": "Mi sono permessa di venire qui al club\\nper assistervi nel suo utilizzo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "club_itemmachine_msg_first_03",
      "hash64": "6C76CF975AF7CBDB",
      "text": "Innanzitutto, le basi! Che cos’è\\nuno Stampastrumenti?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "club_itemmachine_msg_first_04",
      "hash64": "6C76D4975AF7D45A",
      "text": "È un dispositivo grazie al quale puoi convertire\\nmateriali di Pokémon e PM in strumenti!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "club_itemmachine_msg_first_05",
      "hash64": "6C76D5975AF7D60D",
      "text": "I dettagli di come funziona sono top-secret!\\c\\nSai, la procedura per il brevetto è ancora\\nin corso...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "club_itemmachine_msg_first_06",
      "hash64": "6C76D2975AF7D0F4",
      "text": "Ti basti sapere che inserendo dei materiali\\nin questo incredibile dispositivo si possono\\r\\nstampare degli strumenti!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "club_itemmachine_msg_first_07",
      "hash64": "6C76D3975AF7D2A7",
      "text": "Nulla di complicato, quindi. E il prodotto finale\\nsarà una sorpresa! Emozionante, no? Detto ciò...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "club_itemmachine_msg_start_00",
      "hash64": "47D2451C8CF88184",
      "text": "Vuoi stampare uno strumento?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
