      "hash64": "6AB290F8091551F1",
      "text": "[VAR 0x0100(0000)]\\n撿到了[VAR 0xFF00(0008)]碧草面具[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
