  "entries": [
    {
      "ordinal": 0,
      "label": "gym_normal_020_receptionist_01",
      "hash64": "8DA4593E928F4587",
      "text": "Benvenut[VAR 0x1100(00FF,0101)]oa alla Palestra di Mesturia!\\c\\nVuoi che ti spieghi di nuovo come funziona\\nl’Esame della Palestra?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_normal_020_receptionist_02",
      "hash64": "8DA45A3E928F473A",
      "text": "L’Esame della Palestra di Mesturia è...\\n[VAR 0xFF00(0006)]ordinare un menu segreto[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_normal_020_receptionist_03",
      "hash64": "8DA45B3E928F48ED",
      "text": "Per essere promoss[VAR 0x1100(00FF,0101)]oa, dovrai ordinare il menu\\nsegreto di un famoso ristorante della città:\\r\\nl’[VAR 0xFF00(0006)]Oro in Bocca[VAR 0xFF00(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_normal_020_receptionist_04",
      "hash64": "8DA4543E928F3D08",
      "text": "Ci sono altri tre sfidanti in giro per la città,\\noltre a te.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_normal_020_receptionist_05",
      "hash64": "8DA4553E928F3EBB",
      "text": "Ciascun partecipante conosce un indizio diverso\\nsul menu segreto.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_normal_020_receptionist_06",
      "hash64": "8DA4563E928F406E",
      "text": "Gli sfidanti dovranno lottare tra di loro e chi\\nperde dovrà rivelare il proprio indizio a chi vince.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_normal_020_receptionist_07",
      "hash64": "8DA4573E928F4221",
      "text": "Basandosi sugli indizi ottenuti, bisognerà poi\\nandare all’Oro in Bocca e ordinare i piatti\\r\\ndel menu segreto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_normal_020_receptionist_08",
      "hash64": "8DA4503E928F363C",
      "text": "Solo il primo sfidante che riuscirà a ordinare\\nsarà promosso.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_normal_020_receptionist_09",
      "hash64": "8DA4513E928F37EF",
      "text": "Allora, [VAR 0x0100(0000)], il tuo indizio è...\\n[VAR 0xFF00(0006)]ai clienti abituali piace così[VAR 0xFF00(0000)]!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_normal_020_receptionist_10",
      "hash64": "8DA7DE3E92925D5D",
      "text": "Chiedi a qualche cliente abituale dell’Oro in\\nBocca, potresti scoprire qualcosa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_normal_020_normal_01",
      "hash64": "AE31BE5429DB5DDF",
      "text": "Gnam gnam...\\nMunch munch...[VAR 0x0114(0038)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0038"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_normal_020_select_01",
      "hash64": "B588972BCEF95112",
      "text": "Lei è un cliente abituale...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_normal_020_select_02",
      "hash64": "B588962BCEF94F5F",
      "text": "Conosce il menu segreto?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "gym_normal_020_normal_02a",
      "hash64": "D9E80F031FC409E9",
      "text": "Sì, direi di sì... Vengo spesso qui.[VAR 0x0114(0038)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0038"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_normal_020_normal_03a",
      "hash64": "D9EAF3031FC6102C",
      "text": "Ti stai cimentando nell’Esame della Palestra?[VAR 0x0114(0038)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0038"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_normal_020_normal_02b",
      "hash64": "D9E80C031FC404D0",
      "text": "Quello che sto mangiando ora fa parte del menu\\nstandard...[VAR 0x0114(0038)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0038"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_normal_020_normal_04",
      "hash64": "AE31B95429DB5560",
      "text": "Ti svelo un segreto: una spruzzata di [VAR 0xFF00(0006)]limone[VAR 0xFF00(0000)]\\nrende qualsiasi piatto straordinario![VAR 0x0114(0038)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0038"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_normal_020_normal_05",
      "hash64": "AE31BA5429DB5713",
      "text": "Spremere del [VAR 0xFF00(0006)]limone [VAR 0xFF00(0000)]su qualsiasi piatto gli dona\\nuna punta di acidulo che lo rende più buono.\\c\\nMa forse questo è un valore aggiunto che\\ncapirai solo una volta cresciut[VAR 0x1100(00FF,0101)]oa.[VAR 0x0114(0038)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
