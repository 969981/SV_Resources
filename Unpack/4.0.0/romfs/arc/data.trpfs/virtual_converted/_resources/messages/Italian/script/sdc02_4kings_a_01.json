          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_a_01_clerk_03",
      "hash64": "D29BDA253506E52E",
      "text": "Puoi partecipare alla Prova del Superquattro\\nin cambio di 50 PM! Ce li hai?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_01_clerk_04",
      "hash64": "D29BDD253506EA47",
      "text": "Ah, sembra che tu non abbia abbastanza PM...\\nPuoi ottenerli con le Ricreattività, sai?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_01_system_01",
      "hash64": "62E99FF70BADB89A",
      "text": "Hai inviato 50 PM!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_01_clerk_05",
      "hash64": "D29BDC253506E894",
      "text": "Ricevuti, grazie mille!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_a_01_clerk_06",
      "hash64": "D29BDF253506EDAD",
      "text": "Piros, c’è un ordine per te!",
