      "hash64": "292A8CCF8836FB0B",
      "text": "C’est... C-c’est...[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
