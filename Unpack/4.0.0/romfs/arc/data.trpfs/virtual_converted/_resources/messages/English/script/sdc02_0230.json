    {
      "ordinal": 29,
      "label": "sdc02_0230_chairman_04",
      "hash64": "7A9A996FC1DE8304",
      "text": "Ah, of course. You must be participating in the\\nstudent exchange program.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0230_dragonbb_03",
      "hash64": "907627C937B45B55",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)] just got crowned our\\nnew\\r\\nBB\\r\\nLeague\\r\\nChampion, too.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
