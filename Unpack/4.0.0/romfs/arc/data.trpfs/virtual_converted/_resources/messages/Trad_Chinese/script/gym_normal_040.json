        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_normal_040_gym_receptionist_01",
      "hash64": "E493BA44D381D951",
      "text": "[VAR 0x0100(0000)]，\\n歡迎光臨錦匯道館。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_normal_040_gym_receptionist_02",
      "hash64": "E493B744D381D438",
      "text": "如果[VAR 0x1100(00FF,0101)]你妳想挑戰道館館主青木，\\n請向寶食堂的店員說一聲。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_normal_040_receptionist_00",
      "hash64": "0EB8253E4E40262A",
      "text": "[VAR 0x0100(0000)]，\\n歡迎光臨錦匯道館後援店，寶食堂！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_normal_040_receptionist_01",
      "hash64": "0EB8263E4E4027DD",
      "text": "[VAR 0x1100(00FF,0101)]你妳要挑戰超凡脫俗上班族……\\n道館館主青木嗎？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_normal_040_receptionist_02",
      "hash64": "0EB8233E4E4022C4",
      "text": "那麼，請站上對戰場。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_normal_040_receptionist_03",
      "hash64": "0EB8243E4E402477",
      "text": "等[VAR 0x1100(00FF,0101)]你妳準備好後，\\n請隨時告訴我一聲。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_normal_040_receptionist_05",
      "hash64": "0EB8223E4E402111",
      "text": "青木～！\\n上場囉～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_normal_040_normal_01",
      "hash64": "E4ECB2AC02E1AAE5",
      "text": "[VAR 0x1100(00FF,0101)]你妳好。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_normal_040_normal_02",
      "hash64": "E4ECAFAC02E1A5CC",
      "text": "我就是派駐在錦匯道館的\\n道館館主，青木。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_normal_040_normal_03",
      "hash64": "E4ECB0AC02E1A77F",
      "text": "道館測驗，\\n辛苦[VAR 0x1100(00FF,0101)]你妳了。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_normal_040_normal_04",
      "hash64": "E4ECADAC02E1A266",
      "text": "嗯……這家店除了烤飯糰，\\n其他的東西也很好吃。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_normal_040_normal_05",
      "hash64": "E4ECAEAC02E1A419",
      "text": "一直閒聊的話，\\n我會被上司罵的。\\r\\n我們開始對戰吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_normal_040_normal_06",
      "hash64": "E4ECABAC02E19F00",
      "text": "[VAR 0x1100(00FF,0101)]你妳好，我是青木。\\n請多指教。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_normal_040_normal_07",
      "hash64": "E4ECACAC02E1A0B3",
      "text": "真是非比尋常的實力。\\n讓我一不留神就沒表情了。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_normal_040_normal_08",
      "hash64": "E4ECB9AC02E1B6CA",
      "text": "我打輸了，\\n因此我會把徽章交給[VAR 0x1100(00FF,0101)]你妳。不過……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_normal_040_normal_09",
      "hash64": "E4ECBAAC02E1B87D",
      "text": "……經過這麼一戰，我餓了。\\n[VAR 0x1100(00FF,0101)]你妳要不要一起吃頓飯？[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_normal_040_normal_badge",
      "hash64": "3B461CE2FFA60749",
      "text": "有[VAR 0x0200(0001)]個道館徽章的話，\\n等級[VAR 0x0201(0002)]以下的寶可夢\\r\\n會比較容易捕捉……而且會乖乖聽話。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_normal_040_normal_badge_all",
      "hash64": "36909BBFC4BE01F9",
      "text": "擁有８個道館徽章的話，\\n不論什麼寶可夢都能捕捉，\\r\\n而且牠們不會違背[VAR 0x1100(00FF,0101)]你妳的指示。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_normal_040_normal_10",
      "hash64": "E4F037AC02E4C2BB",
      "text": "……這裡的料理味道很夠，\\n很好吃呢。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_normal_040_normal_waza",
      "hash64": "8A8AE8E413551DA3",
      "text": "像[VAR 0x1100(00FF,0101)]你妳這樣活力十足的孩子\\n大概不需要，不過這個也給[VAR 0x1100(00FF,0101)]你妳吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_normal_040_normal_11",
      "hash64": "E4F036AC02E4C108",
      "text": "這餐就由我買單了。\\n好歹我也是個大人……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_normal_040_normal_12",
      "hash64": "E4F039AC02E4C621",
      "text": "那麼，失陪了。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_normal_040_receptionist_04",
      "hash64": "0EB8213E4E401F5E",
      "text": "恭喜！\\n[VAR 0x1100(00FF,0101)]你妳在錦匯道館及格了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_normal_040_normal_npc",
      "hash64": "81F01A478E5F110D",
      "text": "嚼啊嚼……\\n吃啊吃……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    }
  ]
}
