    {
      "ordinal": 16,
      "label": "class_d_01_language_11",
      "hash64": "B86AA925961B6C94",
      "text": "Gracias！Merci！ありがとう！\\n這些全都是「謝謝」的意思！\\r\\nThank you是個大提示，對不對！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
