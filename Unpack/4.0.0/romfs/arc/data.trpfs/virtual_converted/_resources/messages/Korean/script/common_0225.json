    {
      "ordinal": 0,
      "label": "common_0225_sitappa_a_01",
      "hash64": "37B17B2F7B042CC3",
      "text": "너도 스타단에 들어오면\\n별처럼 빛날 수 있다니까!?[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
