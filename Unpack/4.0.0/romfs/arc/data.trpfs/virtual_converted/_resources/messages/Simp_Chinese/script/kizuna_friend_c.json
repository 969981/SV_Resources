          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_friend_c_14a",
      "hash64": "AF08935FE33A296F",
      "text": "在造出时光机之前的书里\\n提到了古代的宝可梦，\\r\\n这不合理吧……？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
