    },
    {
      "ordinal": 8,
      "label": "s2_sub_040_teacher_05a",
      "hash64": "8D39A372799E6E82",
      "text": "Mal sehen... Im Savannen-Areal hast du gegen\\n[VAR 0x0201(0003)] Schüler gewonnen!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
