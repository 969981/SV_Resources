    },
    {
      "ordinal": 26,
      "label": "s2_sub_040_teacher_17",
      "hash64": "EB8704C0B45FD4D4",
      "text": "Ich hoffe, du wirst auch in Zukunft mit Freude\\nPokémon-Kämpfen nachgehen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
