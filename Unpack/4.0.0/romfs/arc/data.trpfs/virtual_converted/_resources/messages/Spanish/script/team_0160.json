          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "team_0160_botan_01",
      "hash64": "1B1193CD8DCB5C15",
      "text": "¿Eh?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "team_0160_head_teacher_04",
      "hash64": "402128BBE39C5133",
      "text": "Jamás me perdonaré un fracaso pedagógico de\\nsemejante calibre... como que me llamo Clavel.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "team_0160_botan_02",
      "hash64": "1B1190CD8DCB56FC",
      "text": "Pero... ¿qué dice?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "team_0160_head_teacher_05",
      "hash64": "402127BBE39C4F80",
      "text": "Tus compañeros me han explicado los motivos\\nque te empujaron a fundar el Team Star, junto\\r\\nal porqué de vuestros actos.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "team_0160_head_teacher_06",
      "hash64": "40212ABBE39C5499",
      "text": "Cuando pienso en la armonía que atestiguaba\\ndesde que asumí la dirección de la academia...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "team_0160_head_teacher_07",
      "hash64": "402129BBE39C52E6",
      "text": "Estaba cimentada en vuestra tristeza, vuestra\\nrabia y, sobre todo... vuestro coraje.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "team_0160_head_teacher_08",
      "hash64": "402134BBE39C6597",
      "text": "Por fin he abierto los ojos, de modo que...\\nme retracto de mis palabras.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "team_0160_head_teacher_09",
      "hash64": "402133BBE39C63E4",
      "text": "La orden que os di de disolver el Team Star, así\\ncomo la amenaza de expulsar a todo aquel que\\r\\nno la obedeciera... ¡quedan anuladas ipso facto![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "team_0160_aku_03",
      "hash64": "29452FD7AEE338EC",
      "text": "O sea, ¿que podemos...?[VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "team_0160_head_teacher_10",
      "hash64": "401E26BBE39A17F6",
      "text": "¡Exacto! El Team Star puede seguir existiendo,\\nsi así lo deseáis.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "team_0160_kakutou_03",
      "hash64": "515BA91EB832E9C9",
      "text": "¡Yujuuu! ¡Entonces podremos estar todos juntos!\\n¡¿No es genial, Noa?![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "team_0160_doku_03",
      "hash64": "1D9A2EE70425B524",
      "text": "¡Mi corazón se hincha de júbilo![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "team_0160_botan_03",
      "hash64": "1B1191CD8DCB58AF",
      "text": "P-pero... si os he traicionado...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "team_0160_fairy_01",
      "hash64": "DD5A953A638C2898",
      "text": "¿Lo dices por la Operación Stardust esa?\\nEl director ya nos lo ha explicado, tranquila.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "team_0160_aku_01",
      "hash64": "294531D7AEE33C52",
      "text": "Has hecho todo esto por nuestro bien, para que\\nno nos echaran a patadas de la academia, ¿o no?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "team_0160_honoo_01",
      "hash64": "B14C1DB3E42C7C1A",
      "text": "Porque sabías de sobra que pasaríamos del tema\\nsi alguien nos pidiera acabar con la pandilla.[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "team_0160_doku_01",
      "hash64": "1D9A30E70425B88A",
      "text": "La zozobra que turbaba a vuesa merced por\\nnuestro sino iba allende lo imaginable...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "team_0160_kakutou_01",
      "hash64": "515BA71EB832E663",
      "text": "Siento mucho haberte preocupado tanto,\\naunque, gracias a ti, no nos ha pasado nada.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "team_0160_botan_04",
      "hash64": "1B118ECD8DCB5396",
      "text": "¡Aun así, no...![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "team_0160_head_teacher_11",
      "hash64": "401E27BBE39A19A9",
      "text": "Ejem. Volviendo al tema que nos ocupa...[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "team_0160_head_teacher_12",
      "hash64": "401E24BBE39A1490",
      "text": "Como ya he dicho, la orden que os di de disolver\\nel Team Star queda anulada oficialmente.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "team_0160_head_teacher_13",
      "hash64": "401E25BBE39A1643",
      "text": "No obstante, mucho me temo que no puedo dar\\ncarpetazo a todo este asunto así como así.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "team_0160_head_teacher_14",
      "hash64": "401E2ABBE39A1EC2",
      "text": "¡Habéis faltado a clase de manera sistemática y\\nhabéis modificado vuestros uniformes escolares\\r\\nhasta el punto de resultar irreconocibles![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "team_0160_head_teacher_26",
      "hash64": "401ABABBE3972A9B",
      "text": "¡Habéis sustraído mobiliario y materiales de la\\nacademia y los habéis utilizado sin autorización![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "team_0160_head_teacher_27",
      "hash64": "401AB9BBE39728E8",
      "text": "Habéis personalizado vuestras Pokémonturas,\\n¡además de conducirlas con absoluta temeridad![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "team_0160_head_teacher_28",
      "hash64": "401AB8BBE3972735",
      "text": "¡Y otras tantas infracciones que merecen una\\nsanción acorde a su gravedad![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "team_0160_head_teacher_15",
      "hash64": "401E2BBBE39A2075",
      "text": "De modo que, como castigo, deberéis llevar a\\ncabo labores de voluntariado.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "team_0160_botan_05",
      "hash64": "1B118FCD8DCB5549",
      "text": "Esto...\\c\\n¿Voluntariado?[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "team_0160_head_teacher_16",
      "hash64": "401E28BBE39A1B5C",
      "text": "Eso he dicho. A partir de ahora, el Team Star se\\nencargará de la coordinación y gestión del CES.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "team_0160_botan_06",
      "hash64": "1B118CCD8DCB5030",
      "text": "¿Ce, e, ese? ¿De dónde vienen esas siglas?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "team_0160_head_teacher_17",
      "hash64": "401E29BBE39A1D0F",
      "text": "De \"Centro de Entrenamiento Star\".[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "team_0160_head_teacher_18",
      "hash64": "401E2EBBE39A258E",
      "text": "La nueva instalación que fundarán la academia\\ny la prestigiosa Liga Pokémon, con el fin de\\r\\ncultivar el talento de los Entrenadores.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
