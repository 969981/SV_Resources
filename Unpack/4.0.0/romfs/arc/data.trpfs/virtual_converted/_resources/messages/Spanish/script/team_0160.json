      ]
    },
    {
      "ordinal": 1,
      "label": "team_0160_head_teacher_02",
      "hash64": "40212EBBE39C5B65",
      "text": "Quiero aprovechar la ocasión para dirigirme al\\nTeam Star en representación de la academia.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "team_0160_head_teacher_03",
      "hash64": "40212DBBE39C59B2",
      "text": "Lamento profundamente todo lo sucedido.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
