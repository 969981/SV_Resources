  "entries": [
    {
      "ordinal": 0,
      "label": "sub_046_child_f_01",
      "hash64": "AF56210A305FD036",
      "text": "Dis, tu veux bien me montrer à quel point\\nt’es proche de t[VAR 0x1101(00FD,0202)]ones Pokémon ?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0202"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sub_046_child_f_02",
      "hash64": "AF56200A305FCE83",
      "text": "C’est quel Pokémon que tu veux me montrer ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_046_child_f_03",
      "hash64": "AF561F0A305FCCD0",
      "text": "D’accord !\\nJe vais te dire si vous êtes meilleurs amis ou pas...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_046_child_f_04",
      "hash64": "AF56260A305FD8B5",
      "text": "Ouah, c’est génial ! Vous êtes vraiment\\nles meilleurs amis du monde !\\c\\nVous avez trop de chance de vous être trouvés !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_046_child_f_05",
      "hash64": "AF56250A305FD702",
      "text": "Vous êtes vraiment super proches !\\nVous comptez beaucoup l’un pour l’autre !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_046_child_f_06",
      "hash64": "AF56240A305FD54F",
      "text": "Vous êtes bons copains !\\nVous devez bien vous amuser, tous les deux !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_046_child_f_07",
      "hash64": "AF56230A305FD39C",
      "text": "Vous vous entendez bien, je crois !\\nMais vous pouvez devenir encore plus copains !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_046_child_f_08",
      "hash64": "AF562A0A305FDF81",
      "text": "Vous vous entendez pas trop mal !\\nMais vous pouvez faire mieux !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_046_child_f_09",
      "hash64": "AF56290A305FDDCE",
      "text": "Vous êtes pas encore vraiment copains, je crois...\\nJ’espère que vous allez vous rapprocher !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_046_child_f_10",
      "hash64": "AF529C0A305CB860",
      "text": "Vous venez de vous rencontrer, non ?\\nÇa se voit que vous êtes pas encore copains...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_046_child_f_11",
      "hash64": "AF529D0A305CBA13",
      "text": "Houla ! Vous vous êtes disputés ou quoi ?\\nVous êtes vraiment pas copains...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_046_child_f_12",
      "hash64": "AF529E0A305CBBC6",
      "text": "Tiens, je vais te donner quelque chose ! Avec ça,\\ntout le monde verra que vous êtes meilleurs amis !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_046_system_01",
      "hash64": "4DBAA28FEF755C82",
      "text": "[VAR 0x0102(0001)] reçoit le Ruban Affection !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_046_child_f_13",
      "hash64": "AF529F0A305CBD79",
      "text": "Reviens me voir quand tu veux !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_046_child_f_14",
      "hash64": "AF52A00A305CBF2C",
      "text": "Coucou ! Tu sais que plus tu passes de temps avec\\nun Pokémon, plus tu peux devenir ami[VAR 0x1100(00FF,0100)]e avec lui ?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
