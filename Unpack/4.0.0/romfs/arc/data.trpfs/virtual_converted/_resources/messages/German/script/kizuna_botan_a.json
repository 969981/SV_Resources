  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_botan_a_01",
      "hash64": "3628B9A5496FE732",
      "text": "H-Huch...! [VAR 0x0100(0000)]?![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_botan_a_02",
      "hash64": "3628B8A5496FE57F",
      "text": "Du verrätst mich noch! Los, versteck dich![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_botan_a_03",
      "hash64": "3628B7A5496FE3CC",
      "text": "Puh, das war knapp...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_botan_a_select_01",
      "hash64": "20DD942EF5E4E181",
      "text": "Was machst du hier?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_botan_a_select_02",
      "hash64": "20DD912EF5E4DC68",
      "text": "Stimmt was nicht?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_botan_a_04",
      "hash64": "3628B6A5496FE219",
      "text": "Oh, ich bin nur... Ähm, weißt du...\\c\\nAch, warum soll ich dir jetzt noch was vormachen.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_botan_a_05",
      "hash64": "3628B5A5496FE066",
      "text": "Da drüben.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_botan_a_06",
      "hash64": "3628B4A5496FDEB3",
      "text": "Jetzt ist dir klar, was ich hier mache, oder?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_botan_a_select_03",
      "hash64": "20DD922EF5E4DE1B",
      "text": "Ähm, nein?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_botan_a_select_04",
      "hash64": "20DD972EF5E4E69A",
      "text": "Das musst du mir erklären.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_botan_a_07",
      "hash64": "3628B3A5496FDD00",
      "text": "Oh, sorry. Du hast mich so erschreckt, dass ich\\nnoch immer nicht ganz klar denken kann.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_botan_a_08",
      "hash64": "3628C2A5496FF67D",
      "text": "Die Sache ist die: Team Stars Mitglieder kommen\\nseit einer Weile wieder zur Akademie...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_botan_a_09",
      "hash64": "3628C1A5496FF4CA",
      "text": "Ich mache mir etwas Sorgen um sie und wollte\\nsichergehen, dass sie sich gut eingefügt haben.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_botan_a_aku_01",
      "hash64": "65304FA143DF53AA",
      "text": "Irgendwie fühl ich mich immer noch wie ein\\nAußenseiter... Geht’s dir auch so?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_botan_a_fairy_01",
      "hash64": "1D3B2C79154455C0",
      "text": "Na, was hast du denn erwartet?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_botan_a_fairy_02",
      "hash64": "1D3B2F7915445AD9",
      "text": "Das Missverständnis mit den Lehrern mag aus der\\nWelt geschafft sein, gut und schön.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_botan_a_fairy_03",
      "hash64": "1D3B2E7915445926",
      "text": "Aber das heißt nicht, dass die anderen Schüler\\nuns plötzlich mit offenen Armen empfangen.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_botan_a_aku_02",
      "hash64": "65304EA143DF51F7",
      "text": "Stimmt. Schätze, da bleibt uns nichts anderes\\nübrig als ein radikaler Kurswechsel![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_botan_a_10",
      "hash64": "3625B4A5496DA8DC",
      "text": "Ein „Kurswechsel“...? Was meint er damit?\\c\\nWollen sie vielleicht die übertriebenen Uniformen\\nloswerden, um weniger einschüchternd zu wirken?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_botan_a_11",
      "hash64": "3625B5A5496DAA8F",
      "text": "Ach, Mensch... Die zwei geben sich solche Mühe,\\num endlich an der Akademie dazuzugehören...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_botan_a_fairy_04",
      "hash64": "1D3B317915445E3F",
      "text": "An was für einen Kurswechsel hast du gedacht?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_botan_a_aku_03",
      "hash64": "65304DA143DF5044",
      "text": "Hm? Tja, mal sehen...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_botan_a_aku_04",
      "hash64": "65304CA143DF4E91",
      "text": "Hey, wie wär’s, wenn wir alle unüberhörbar laut\\nbegrüßen? So kapiert jeder, wie nett wir sind![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_botan_a_fairy_05",
      "hash64": "1D3B307915445C8C",
      "text": "Hä? Nie und nimmer, das ist mega-uncool.\\nDa hab ich echt gar keinen Bock drauf...[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_botan_a_12",
      "hash64": "3625B6A5496DAC42",
      "text": "Ähm... Das klingt mir nicht gerade nach der\\nbesten Idee...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_botan_a_aku_05",
      "hash64": "65304BA143DF4CDE",
      "text": "Nein, pass auf, Otis...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_botan_a_aku_06",
      "hash64": "65304AA143DF4B2B",
      "text": "Denk doch zum Beispiel mal an Ettas Konzerte![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_botan_a_aku_07",
      "hash64": "653049A143DF4978",
      "text": "Sie beginnt ihre Auftritte auch oft mit lauten\\nRufen, um das Publikum so richtig anzuheizen![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_botan_a_fairy_06",
      "hash64": "1D3B3379154461A5",
      "text": "Klar, bei einem Konzert ist das auch angebracht,\\naber... wir sind hier an der Akademie. Da liegen\\r\\nWelten dazwischen![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_botan_a_aku_08",
      "hash64": "653048A143DF47C5",
      "text": "Du willst also lieber für immer ein Außenseiter\\nbleiben, ja? Versteh ich das richtig?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_botan_a_fairy_07",
      "hash64": "1D3B327915445FF2",
      "text": "N-Nein, natürlich nicht...[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_botan_a_aku_09",
      "hash64": "653047A143DF4612",
      "text": "Na also. Was bleibt uns dann anderes übrig,\\nals mit unserer Stimme auf uns aufmerksam zu\\r\\nmachen? Einen Versuch ist’s allemal wert.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_botan_a_aku_10",
      "hash64": "652CCAA143DC3BD4",
      "text": "HALLOOOO LEUTEEE!\\nSCHÖN, DASS IHR ALLE DA SEEEEID![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "kizuna_botan_a_fairy_08",
      "hash64": "1D3B35791544650B",
      "text": "Boah, Pinio, das kannst du doch nicht machen!\\nAaaah, wie peinlich...[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "kizuna_botan_a_aku_11",
      "hash64": "652CCBA143DC3D87",
      "text": "SEID IHR ALLE GUT DRAUF??\\nNa los, Otis, mach mit![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_botan_a_fairy_09",
      "hash64": "1D3B347915446358",
      "text": "Alter, es reicht! Kannst du nicht irgendwo\\nrumbrüllen, wo’s weniger peinlich ist?![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "kizuna_botan_a_aku_12",
      "hash64": "652CCCA143DC3F3A",
      "text": "HABT ’NEN HYPER-KRASSEN TAG, LEUTE,\\nLASST ES KRACHEN!\\r\\nOtis, du bist dran![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
