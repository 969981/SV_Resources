      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_home_c_02",
      "hash64": "9C0F8C4400C153DA",
      "text": "Necesito pedirte un favor... ¿Puedo contar\\ncontigo?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
