  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_battle_b_01",
      "hash64": "284777AC63350D7D",
      "text": "嘿呀！转学生！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_battle_b_02",
      "hash64": "284774AC63350864",
      "text": "在家政教室遇到你\\n真是稀奇！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_battle_b_select_01",
      "hash64": "0AD49203C0A0F58C",
      "text": "彼此彼此！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_battle_b_select_02",
      "hash64": "0AD49503C0A0FAA5",
      "text": "老师在做什么呢？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_battle_b_03",
      "hash64": "284775AC63350A17",
      "text": "这个嘛，\\n我啊……[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_battle_b_home_01",
      "hash64": "C24E4165848128B1",
      "text": "听说她在进行\\n制作三明治的特训。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_battle_b_04",
      "hash64": "284772AC633504FE",
      "text": "啊啊，被戳穿了……[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_battle_b_home_02",
      "hash64": "C24E3E6584812398",
      "text": "真是失敬。\\n原来你一直在保密？[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_battle_b_05",
      "hash64": "284773AC633506B1",
      "text": "倒也不是那样……\\n可是公开说自己在进行特训，\\r\\n也有些怪没面子的。[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_battle_b_home_03",
      "hash64": "C24E3F658481254B",
      "text": "明白了。\\n以后吾辈会注意的。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_battle_b_06",
      "hash64": "284770AC63350198",
      "text": "既然已经被人知道了，那也没办法！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_battle_b_07",
      "hash64": "284771AC6335034B",
      "text": "就让[VAR 0x0100(0000)]你也来\\n陪我特训吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_battle_b_08",
      "hash64": "28476EAC6334FE32",
      "text": "这是我经过特训做出来的三明治，\\n你吃吃看吧！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_battle_b_system_02",
      "hash64": "CAA82B9D3C055D9A",
      "text": "凰檗老师的三明治又干又硬，\\n气味也很刺鼻，\\r\\n吃起来没有任何味道……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_battle_b_09",
      "hash64": "28476FAC6334FFE5",
      "text": "我做的夹满生火腿、煎培根和\\n辣香肠的三明治，味道怎么样？[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_battle_b_select_03",
      "hash64": "0AD49403C0A0F8F2",
      "text": "搭配太不均衡……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "kizuna_battle_b_select_04",
      "hash64": "0AD48F03C0A0F073",
      "text": "多来点蔬菜……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_battle_b_10",
      "hash64": "284ADCAC6337EEF3",
      "text": "什么！食材有问题吗！？[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_battle_b_11",
      "hash64": "284ADBAC6337ED40",
      "text": "能帮助增肌的食材，\\n反而把三明治的味道彻底破坏了啊……[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_battle_b_home_04",
      "hash64": "C24E446584812DCA",
      "text": "首先是黄油，\\n用黄油试试看……[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_battle_b_home_05",
      "hash64": "C24E456584812F7D",
      "text": "黄油可以防止食材的水分\\n把面包弄得湿乎乎的，\\r\\n而且有助于提升风味。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_battle_b_12",
      "hash64": "284ADEAC6337F259",
      "text": "黄油！原来如此！\\n感谢指导！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_battle_b_13",
      "hash64": "284ADDAC6337F0A6",
      "text": "可是为什么刚才在制作的时候，\\n你没有教给我呢？[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_battle_b_home_06",
      "hash64": "C24E426584812A64",
      "text": "这个嘛，是因为……\\n在吾辈看来凰檗老师你\\r\\n只像是在厨房胡闹，\\r\\n还没有开始制作料理……[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_battle_b_14",
      "hash64": "284AE0AC6337F5BF",
      "text": "…………[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_battle_b_15",
      "hash64": "284ADFAC6337F40C",
      "text": "总之！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_battle_b_16",
      "hash64": "284AE2AC6337F925",
      "text": "多亏了你和萨瓦罗老师，\\n我快要找到感觉了！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_battle_b_17",
      "hash64": "284AE1AC6337F772",
      "text": "感谢你们的建议！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_battle_b_system_01",
      "hash64": "CAA82A9D3C055BE7",
      "text": "与凰檗老师的关系\\n又变好了一些！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
