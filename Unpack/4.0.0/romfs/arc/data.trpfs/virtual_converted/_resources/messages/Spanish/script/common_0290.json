    {
      "ordinal": 0,
      "label": "common_0290_head_teacher_01",
      "hash64": "07F34ED0D0DE2942",
      "text": "Gracias a todos por venir.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
