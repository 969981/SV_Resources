          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc02_0230_chairman_07",
      "hash64": "7A9A9C6FC1DE881D",
      "text": "Madame Bria, me permettez-vous de poursuivre\\nvos explications ?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc02_0230_bbteacher_16",
      "hash64": "FA3034C9DB9C0654",
      "text": "Bien sûr, je vous en prie.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc02_0230_chairman_08",
      "hash64": "7A9A8D6FC1DE6EA0",
      "text": "Pardonnez-moi, je ne me suis pas présentée.\\nMon nom est Alisma. Je suis la présidente\\r\\nde la Ligue Pokémon de Paldea.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc02_0230_chairman_09",
      "hash64": "7A9A8E6FC1DE7053",
      "text": "Il y a un peu plus de dix ans, notre Ligue a offert\\nson soutien à des recherches dans la Zone Zéro,\\r\\nsituée dans le cratère au centre de notre région.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 152,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc02_0230_chairman_10",
      "hash64": "7A9E1B6FC1E195C1",
      "text": "Les recherches sont aujourd’hui terminées, mais\\nnous continuons d’assurer la gestion du cratère.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc02_0230_chairman_11",
      "hash64": "7A9E1A6FC1E1940E",
      "text": "La Zone Zéro est un endroit teinté de mystères\\nqui recèle de nombreux dangers...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc02_0230_chairman_12",
      "hash64": "7A9E196FC1E1925B",
      "text": "Aujourd’hui, il est formellement interdit\\nde s’y rendre ou d’y faire des recherches...\\r\\nDu moins, en temps normal...[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc02_0230_chairman_13",
      "hash64": "7A9E186FC1E190A8",
      "text": "Mais la situation actuelle est différente.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0230_chairman_14",
      "hash64": "7A9E1F6FC1E19C8D",
      "text": "Depuis peu, des Pokémon violents menacent\\nde s’échapper de la Zone Zéro.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "sdc02_0230_chairman_15",
      "hash64": "7A9E1E6FC1E19ADA",
      "text": "Nous pensons qu’il faut à nouveau y envoyer\\nune équipe de recherche le plus vite possible.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "sdc02_0230_chairman_16",
      "hash64": "7A9E1D6FC1E19927",
      "text": "Cela dit, nous peinons à trouver le temps et\\nles ressources nécessaires au sein de notre Ligue\\r\\nPokémon pour mener à bien cette mission.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sdc02_0230_chairman_17",
      "hash64": "7A9E1C6FC1E19774",
      "text": "C’est donc pour cette raison que je me suis\\ntournée vers madame Bria...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "sdc02_0230_bbteacher_17",
      "hash64": "FA3035C9DB9C0807",
      "text": "Depuis le temps que j’envoyais des demandes\\nd’autorisation pour y mener des recherches,\\r\\nj’étais la candidate tout indiquée.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "sdc02_0230_chairman_18",
      "hash64": "7A9E136FC1E18829",
      "text": "Je dois avouer que c’est une position\\nembarrassante pour la Ligue...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "sdc02_0230_chairman_19",
      "hash64": "7A9E126FC1E18676",
      "text": "Mais l’Institut Myrtille compte en son sein de\\nnombreux experts et expertes en Pokémon.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "sdc02_0230_chairman_20",
      "hash64": "7AA1216FC1E3D5CA",
      "text": "Et Maître[VAR 0x1100(00FF,0300)]sse [VAR 0x0100(0000)]...\\nCela me soulagerait grandement si tu pouvais\\r\\naussi prendre part à cette expédition.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0300"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 70,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "sdc02_0230_bbteacher_18",
      "hash64": "FA302AC9DB9BF556",
      "text": "Bien entendu, ta présence n’est pas obligatoire,\\nmais tu nous serais d’une grande aide.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "sdc02_0230_bbteacher_19",
      "hash64": "FA302BC9DB9BF709",
      "text": "Alors, que dis-tu de partir tous ensemble\\nen expédition dans la Zone Zéro ?[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "sdc02_0230_select_05",
      "hash64": "93842D741EF6945E",
      "text": "J’en suis !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "sdc02_0230_select_06",
      "hash64": "93842C741EF692AB",
      "text": "C’est facultatif, c’est ça ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "sdc02_0230_chairman_21",
      "hash64": "7AA1226FC1E3D77D",
      "text": "Merci ! Je savais que je pouvais compter sur toi,\\nMaître[VAR 0x1100(00FF,0300)]sse [VAR 0x0100(0000)] ![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0300"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "sdc02_0230_chairman_22",
      "hash64": "7AA11F6FC1E3D264",
      "text": "Oui, c’est facultatif, mais j’espérais une réponse\\npositive puisque tu t’es déjà rendu[VAR 0x1100(00FF,0100)]e là-bas.\\r\\nJe compte sur toi pour me rendre ce service.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "sdc02_0230_sister_04",
      "hash64": "645DEC9FA07ED84D",
      "text": "Quant à moi, j’y vais, c’est sûr.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "sdc02_0230_bbteacher_20",
      "hash64": "FA2CACC9DB98E965",
      "text": "Merci Roseille, ta présence et ton aide sont\\ntoujours très appréciées.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "sdc02_0230_dragonbb_04",
      "hash64": "907620C937B44F70",
      "text": "Ah désolé, mais ça sera sans moi.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "sdc02_0230_dragonbb_05",
      "hash64": "907621C937B45123",
      "text": "J’ai pas que ça à faire : y a le club à gérer,\\net puis, j’ai aqua-Ponyta ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "sdc02_0230_sister_05",
      "hash64": "645DEB9FA07ED69A",
      "text": "... Ou autrement dit, t’as la flemme d’y aller.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "sdc02_0230_dragonbb_06",
      "hash64": "907622C937B452D6",
      "text": "Hé hé, on peut rien te cacher.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "sdc02_0230_dragonbb_07",
      "hash64": "907623C937B45489",
      "text": "Et si on demandait plutôt à notre ex-Maître\\nce qu’il en pense ?[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "sdc02_0230_brother_03",
      "hash64": "179B38E7C9CE370E",
      "text": "... Je vais y aller.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "sdc02_0230_brother_04",
      "hash64": "179B3BE7C9CE3C27",
      "text": "S’il y a un Pokémon légendaire... j’veux l’trouver,\\net l’attraper... Cette fois, ça sera la bonne...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "sdc02_0230_dragonbb_08",
      "hash64": "90762CC937B463D4",
      "text": "Tiens, tiens, tiens... Quelle surprise ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "sdc02_0230_bbteacher_21",
      "hash64": "FA2CABC9DB98E7B2",
      "text": "Très bien, alors c’est décidé !\\n[VAR 0x0100(0000)], Roseille, Kassis et moi-même\\r\\nmènerons donc cette expédition.\\c\\nDommage pour Irido, mais nous devrons\\nfaire sans lui ![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
