      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_dragon_b_08",
      "hash64": "268D94536FED9E1D",
      "text": "[VAR 0x0100(0000)]同學，\\n很高興能和[VAR 0x1100(00FF,0101)]你妳聊上幾句。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
