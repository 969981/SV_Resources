          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_teacher_home_battleend_win_00_00",
      "hash64": "2C3FE8C528BC4995",
      "text": "吾辈自认已经\\n进行了充分的锻炼……[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_teacher_home_battleend_win_00_01",
      "hash64": "2C3FE7C528BC47E2",
      "text": "冠军确实厉害，\\n你的进步之大，非同凡响啊。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_teacher_home_battleend_win_00_02",
      "hash64": "2C3FE6C528BC462F",
      "text": "对战之后，想必你也累了吧？\\n吾辈把这个给你。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_teacher_home_battleend_win_00_03",
      "hash64": "2C3FE5C528BC447C",
      "text": "吃了酸酸的东西，\\n就能消除疲劳哦。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_teacher_home_reward_00",
      "hash64": "095CDF3343A172CD",
      "text": "[EMPTY 66]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_teacher_home_battleend_win_01_00",
      "hash64": "D6F632CF37C88DA4",
      "text": "无论进行多少次，\\n和你的对战依然很甜美啊。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_teacher_home_battleend_win_01_01",
      "hash64": "D6F633CF37C88F57",
      "text": "[VAR 0x0100(0000)]，\\n谢谢你和吾辈对战。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "coach_teacher_home_battleend_lose_00_00",
      "hash64": "83F9DA1698AEA078",
      "text": "这可不像你啊。\\n或许是不够集中吧？\\c\\n你要照顾好自己的身体，\\n还要好好犒劳宝可梦啊。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "coach_teacher_home_randomtalk_00",
      "hash64": "F7F652B98B85042B",
      "text": "吾辈有个备受好评的课，\\n内容是介绍战斗后给宝可梦吃的健康料理。\\r\\n下次你也来听听吧？[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "coach_teacher_home_randomtalk_01",
      "hash64": "F7F651B98B850278",
      "text": "在生态巨蛋\\n也会下雨啊。\\c\\n看来野餐中突然下雨这种事\\n在巨蛋没什么不同呀。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "coach_teacher_home_randomtalk_02",
      "hash64": "F7F654B98B850791",
      "text": "你喝过这里的食堂\\n卖的学园奶昔了吗？\\c\\n它甜到让吾辈的舌头发麻，\\n只要喝了就会不由自主地笑容满面。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "coach_teacher_home_randomtalk_03",
      "hash64": "F7F653B98B8505DE",
      "text": "[VAR 0x0100(0000)]你的[VAR 0x0101(0001)]\\n身上的光泽很饱满。\\c\\n你之前是不是很注意\\n给它提供营养均衡的餐食？[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "coach_teacher_home_randomtalk_04",
      "hash64": "F7F656B98B850AF7",
      "text": "吾辈交换给你的\\n提布莉姆还好吗？\\c\\n它的可爱应该是无出其右的。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
