      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_dragon_b_09",
      "hash64": "268D93536FED9C6A",
      "text": "Something important has come up, so I must\\nexcuse myself now.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_dragon_b_system_01",
      "hash64": "D6E8E0D3CC7A7026",
      "text": "You became even closer with Mr. Hassel!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_dragon_b_10",
      "hash64": "268A06536FEA76FC",
      "text": "Let us discuss this matter elsewhere. Come...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
