      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side01_0080_brother_04",
      "hash64": "91D43FA7ABA8E220",
      "text": "Eh... N-no lo había pensado...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side01_0080_botan_03",
      "hash64": "726D33FC9471527D",
      "text": "¡Venga, todos a buscarlo! Y nos echamos unas\\npartidillas a algún juego en la pantalla grande.\\r\\n¿Qué me decís?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
