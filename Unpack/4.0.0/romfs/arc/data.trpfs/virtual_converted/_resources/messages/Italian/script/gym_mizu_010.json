      "hash64": "C38DF125E6D2FF90",
      "text": "Blublub! Sono in ritardo, in ritardissimo![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
