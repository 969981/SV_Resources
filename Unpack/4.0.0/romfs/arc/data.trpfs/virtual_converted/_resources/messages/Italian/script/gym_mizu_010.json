          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_mizu_010_receptionist_01",
      "hash64": "7C6C59D62A6DB258",
      "text": "Ah! Signor Algaro, aspettiii!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "gym_mizu_010_receptionist_02",
      "hash64": "7C6C5CD62A6DB771",
      "text": "Andato... Ma si è dimenticato una cosa\\nimportante...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mizu_010_receptionist_03",
      "hash64": "7C6C5BD62A6DB5BE",
      "text": "Per caso sei qui per l’Esame della Palestra?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mizu_010_select_01",
      "hash64": "D3677BC9BEA50865",
      "text": "Sì!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mizu_010_select_02",
      "hash64": "D36778C9BEA5034C",
      "text": "Ehm, veramente...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_mizu_010_receptionist_04a",
      "hash64": "D9DFDBEA18744342",
      "text": "Me lo immaginavo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_mizu_010_receptionist_04b",
      "hash64": "D9DFDAEA1874418F",
      "text": "Non dire così, so che sei qui per quello!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_mizu_010_receptionist_05",
      "hash64": "7C6C5DD62A6DB924",
      "text": "L’uomo grande e grosso di poco fa era Algaro,\\nil Capopalestra di Garrafopoli.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_010_receptionist_06",
      "hash64": "7C6C60D62A6DBE3D",
      "text": "È sempre un po’ fra le nuvole. Pensa che è\\nandato al mercato per fare la spesa ma...\\r\\nha dimenticato qui il suo portafogli.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_010_receptionist_07",
      "hash64": "7C6C5FD62A6DBC8A",
      "text": "Di sicuro andrà nel panico quando se ne\\naccorgerà...\\c\\nTu hai un’aria così simpatica e gentile! Visto che\\nsei qui per l’esame, gli porteresti tu il portafogli?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_010_receptionist_08a",
      "hash64": "D9B6D3EA18513096",
      "text": "Ah, come sei altruista! Mi viene quasi voglia\\ndi darti una medaglia qui e ora!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_010_receptionist_08b",
      "hash64": "D9B6D2EA18512EE3",
      "text": "Mi dispiace, ma senza Algaro non puoi sostenere\\nl’esame, e io non mi posso allontanare\\r\\ndall’entrata, perciò...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_010_receptionist_09",
      "hash64": "7C6C51D62A6DA4C0",
      "text": "Ecco qua! Mi affido a te: portaglielo,\\nmi raccomando!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_010_receptionist_10",
      "hash64": "7C6954D62A6B7402",
      "text": "Se lo farai, considererò superato l’Esame\\ndella Palestra in via eccezionale!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_010_receptionist_11",
      "hash64": "7C6955D62A6B75B5",
      "text": "Algaro era diretto a [VAR 0xFF00(0006)]Marinada[VAR 0xFF00(0000)], oltre il deserto\\noccidentale!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_010_receptionist_12",
      "hash64": "7C6952D62A6B709C",
      "text": "Quel deserto è pieno di Pokémon pericolosi,\\nperciò fai attenzione, eh!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
