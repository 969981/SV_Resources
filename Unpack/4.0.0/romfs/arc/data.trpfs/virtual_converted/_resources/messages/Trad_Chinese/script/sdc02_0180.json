          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc02_0180_reception_npc",
      "hash64": "828CA632ED24C72F",
      "text": "恭喜[VAR 0x1100(00FF,0101)]你妳就任\\n藍莓聯盟冠軍！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
