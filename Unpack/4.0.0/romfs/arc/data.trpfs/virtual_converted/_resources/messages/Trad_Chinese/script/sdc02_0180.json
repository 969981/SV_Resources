    {
      "ordinal": 1,
      "label": "sdc02_0180_dragonbb_02",
      "hash64": "6A5BB9E1902FAFCC",
      "text": "藍莓聯盟的官方對戰\\n也是從這裡申請。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
