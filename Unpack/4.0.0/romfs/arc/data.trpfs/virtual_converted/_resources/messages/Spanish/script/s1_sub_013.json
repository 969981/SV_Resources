      "hash64": "35EB02F9039892FF",
      "text": "Supongo que estarás cansad[VAR 0x1100(00FF,0101)]oa de tus aventuras.\\n¿Por qué no paras a descansar?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
