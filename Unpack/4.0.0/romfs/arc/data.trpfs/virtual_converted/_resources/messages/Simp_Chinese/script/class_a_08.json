      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_a_08_question_02",
      "hash64": "C44608AE4D4FFA84",
      "text": "２　只能通过捕捉或交换，\\n　　才能遇见新的宝可梦。\\n\\n・正确\\n・不正确",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
