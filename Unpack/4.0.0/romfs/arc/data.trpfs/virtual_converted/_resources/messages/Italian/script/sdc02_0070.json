            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0070_teacher_01",
      "hash64": "E7AD0FEE0DEEEFA2",
      "text": "Alola, ragazzi! Siete pronti per la lezione?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_0070_teacher_02",
      "hash64": "E7AD0EEE0DEEEDEF",
      "text": "A quanto pare oggi abbiamo con noi una faccia\\nnuova.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc02_0070_teacher_03",
      "hash64": "E7AD0DEE0DEEEC3C",
      "text": "Dunque, qui nel Settore Costa è stato ricreato\\nartificialmente un ambiente simile a quello\\r\\ndi un arcipelago tropicale.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0070_teacher_04",
      "hash64": "E7AD0CEE0DEEEA89",
      "text": "Perciò ospita una gran varietà di Pokémon\\nabituati a vivere in questo tipo di clima.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc02_0070_teacher_05",
      "hash64": "E7AD0BEE0DEEE8D6",
      "text": "Ve ne sono alcuni che crescono molto più\\nche in altre regioni grazie alla straordinaria\\r\\nquantità di luce che ricevono.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0070_teacher_06",
      "hash64": "E7AD0AEE0DEEE723",
      "text": "Ebbene sì, sto parlando di vere e proprie [VAR 0xFF00(0006)]forme[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]regionali[VAR 0xFF00(0000)], ossia l’insieme di caratteristiche che\\r\\nuna specie può adottare in regioni diverse.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0070_teacher_07",
      "hash64": "E7AD09EE0DEEE570",
      "text": "Il vostro compito di oggi è catturare\\nuna forma regionale!\\c\\nNello specifico, vorrei che catturaste\\nun Pokémon nella sua [VAR 0xFF00(0006)]Forma di Alola[VAR 0xFF00(0000)]!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0070_teacher_08",
      "hash64": "E7AD18EE0DEEFEED",
      "text": "Una volta catturato, venite a mostrarmelo.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0070_teacher_09",
      "hash64": "E7AD17EE0DEEFD3A",
      "text": "Forza, andate!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_0070_fairybb_05",
      "hash64": "6A30E8939BD6607F",
      "text": "Molte delle lezioni dell’Istituto Mirtillo\\nprevedono prove pratiche come questa.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0070_fairybb_06",
      "hash64": "6A30E9939BD66232",
      "text": "Bene bene, è ora di mettersi all’opera![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0070_fairybb_07",
      "hash64": "6A30EA939BD663E5",
      "text": "Hai capito quali Pokémon devi cercare?\\c\\nL’Exeggutor di Alola, con il suo collo lunghissimo,\\nè un esempio perfetto di Forma di Alola![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0070_mob_01",
      "hash64": "83A86BC65CA24E32",
      "text": "Di’ un po’, hai presente Dugtrio? Ricordati che\\nquello di Alola ha delle bizzarre chiome dorate!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc02_0070_mob_02",
      "hash64": "83A86AC65CA24C7F",
      "text": "Nell’arcipelago tropicale di Alola ci si saluta\\ncomunemente dicendo \"alola\"!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc02_0070_mob_03",
      "hash64": "83A869C65CA24ACC",
      "text": "Aspetta, quali erano i Pokémon con una Forma\\ndi Alola...?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
