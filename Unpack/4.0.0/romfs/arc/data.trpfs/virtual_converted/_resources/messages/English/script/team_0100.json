      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "team_0100_cassiopeia_01",
      "hash64": "BB40B1EA9F220216",
      "text": "I see you’re almost at the fifth base...[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "team_0100_cassiopeia_02",
      "hash64": "BB40B0EA9F220063",
      "text": "Holed up inside there is Team Star’s last\\nremaining squad.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "team_0100_cassiopeia_03",
      "hash64": "BB40AFEA9F21FEB0",
      "text": "You’ve fought well to make it this far.\\nThank you, [VAR 0x0100(0000)].[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
