          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "team_0100_nelke_01",
      "hash64": "04928F82C7D56768",
      "text": "[VAR 0x0100(0000)]! Cassiopeia![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "team_0100_cassiopeia_04",
      "hash64": "BB40B6EA9F220A95",
      "text": "So you made it as well, Clive.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "team_0100_nelke_02",
      "hash64": "04929282C7D56C81",
      "text": "Of course—it’s the last base! I wouldn’t want to\\nmiss out on the action![VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "team_0100_cassiopeia_05",
      "hash64": "BB40B5EA9F2208E2",
      "text": "Clive...I owe you my thanks. Your help has been\\ninvaluable to the operation.\\c\\nI’m sorry I was so wary of you at first...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "team_0100_nelke_03",
      "hash64": "04929182C7D56ACE",
      "text": "Well...that’s all water under the bridge.\\c\\nWhen we’re finished with this base, will that be\\nthe end of Operation Starfall, then?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "team_0100_cassiopeia_06",
      "hash64": "BB40B4EA9F22072F",
      "text": "Not quite. We’ll still need to handle Team Star’s\\nsecret mastermind last of all.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "team_0100_nelke_04",
      "hash64": "04929482C7D56FE7",
      "text": "Do we have any leads on how to find them?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "team_0100_cassiopeia_07",
      "hash64": "BB40B3EA9F22057C",
      "text": "I’m hoping they’ll come out into the open once\\nall the squad bosses have stepped down.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "team_0100_nelke_05",
      "hash64": "04929382C7D56E34",
      "text": "I see...[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "team_0100_cassiopeia_08",
      "hash64": "BB40BAEA9F221161",
      "text": "We’ve come so far. Only a few more steps left...\\nDon’t let me down, either of you.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "team_0100_nelke_06",
      "hash64": "04929682C7D5734D",
      "text": "Cassiopeia’s hung up? All right.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "team_0100_nelke_07",
      "hash64": "04929582C7D5719A",
      "text": "[VAR 0xBD06(0000)]Thanks to you, [VAR 0x0100(0000)], I’ve\\nslowly\\r\\nbut\\r\\nsurely\\r\\ncome\\r\\nto\\r\\nunderstand Team Star.[VAR 0x0114(001E)]",
