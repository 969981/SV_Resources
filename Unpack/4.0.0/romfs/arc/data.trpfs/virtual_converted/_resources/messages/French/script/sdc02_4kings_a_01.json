  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_4kings_a_01_clerk_00",
      "hash64": "D29BD9253506E37B",
      "text": "N’hésite pas à explorer la zone à ta guise !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_a_01_clerk_01",
      "hash64": "D29BD8253506E1C8",
      "text": "Bienvenue au Poste Savane, le domaine du\\nchef Rubépin et de son équipe !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_a_01_clerk_02",
      "hash64": "D29BDB253506E6E1",
      "text": "Tu souhaites donc faire tes preuves face à la\\nLigue Myrtille ?\\c\\nEt tu t’appelles... [VAR 0x0100(0000)], c’est ça ?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_a_01_clerk_03",
      "hash64": "D29BDA253506E52E",
      "text": "Il te faudra 50 PM pour participer à ce défi\\ndu Conseil 4.\\r\\nTu veux procéder au paiement ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_01_clerk_04",
      "hash64": "D29BDD253506EA47",
      "text": "... On dirait que tu n’as pas suffisamment de PM.\\nParticipe à des activités Myrtille pour en obtenir !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_01_system_01",
      "hash64": "62E99FF70BADB89A",
      "text": "Vous avez envoyé 50 PM.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_01_clerk_05",
      "hash64": "D29BDC253506E894",
      "text": "Merci beaucoup ! Je confirme la bonne réception\\nde tes Points Myrtille.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_a_01_clerk_06",
      "hash64": "D29BDF253506EDAD",
      "text": "Chef ! On a une commande !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_a_01_firebb_01",
      "hash64": "29AE20143A61CBD9",
