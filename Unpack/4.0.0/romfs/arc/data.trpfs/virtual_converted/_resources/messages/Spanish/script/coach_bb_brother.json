            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_bb_brother_sp01_02",
      "hash64": "CD0657629AEB76DF",
      "text": "Bueno, todos menos Levi, que cuando me ve se\\nle escapa una sonrisita burlona...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb_brother_sp01_03",
      "hash64": "CD0656629AEB752C",
      "text": "Pero, al menos, he podido pedirle perdón a él\\ntambién por cómo me comporté...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_bb_brother_sp01_select_01",
      "hash64": "7B95975FE6DF1221",
      "text": "¡Me alegro por ti!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_bb_brother_sp01_select_02",
      "hash64": "7B95945FE6DF0D08",
      "text": "¿Ya os lleváis mejor?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_bb_brother_sp01_04",
      "hash64": "CD0655629AEB7379",
      "text": "Sí, yo también... Te debo una, [VAR 0x0100(0000)].[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb_brother_sp01_04b",
      "hash64": "4D36318D3E1496E1",
      "text": "A ver, tanto como eso...\\c\\nYo creo que aún queda, pero... pondré de mi\\nparte... para arreglar las cosas.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb_brother_sp01_05",
      "hash64": "CD0654629AEB71C6",
      "text": "Bueno, te dejo. ¡Debo ponerme las pilas en clase\\npara compensar el tiempo que he estado fuera![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb_brother_sp02_00",
      "hash64": "2781177BE3515FF2",
      "text": "Quería darte las gracias por haber ido a verme\\na Noroteo con tus amigos.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb_brother_sp02_01",
      "hash64": "2781187BE35161A5",
      "text": "Llevaba un buen tiempo encerrado en casa y\\ncomiéndome la cabeza por lo que había pasado.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb_brother_sp02_02",
      "hash64": "2781157BE3515C8C",
      "text": "Así que vuestra visita me salvó, literalmente...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb_brother_sp02_03",
      "hash64": "2781167BE3515E3F",
      "text": "También es verdad que pasaron cosas raras,\\npero...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb_brother_sp02_select_03",
      "hash64": "A9DD7FFF7C8F6BAA",
      "text": "¿Te refieres a lo de Corin?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb_brother_sp02_select_04",
      "hash64": "A9DD7AFF7C8F632B",
      "text": "¿Te refieres a la mochisteria?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_bb_brother_sp02_05",
      "hash64": "2781147BE3515AD9",
      "text": "Sí, pero mejor no sacar el tema delante de ella.\\n¡Si no, la pobre se sulfura![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb_brother_sp02_05b",
      "hash64": "71B08983433D2BC1",
      "text": "¡Sí! Ahora lo recuerdas y te ríes, pero en aquel\\nmomento no nos hizo ninguna gracia.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb_brother_sp02_06",
      "hash64": "2781117BE35155C0",
      "text": "¿Sabes qué? Después de darle muchas vueltas,\\nal fin he tomado una decisión.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb_brother_sp02_07",
      "hash64": "2781127BE3515773",
      "text": "Pero, si no te importa, mejor me lo guardo para\\nla próxima vez que hablemos.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb_brother_sp03_00",
      "hash64": "50B90D7098D3DCA3",
      "text": "[VAR 0xBD06(0000)]¡[VAR 0x0100(0000)]! Tengo algo que confesarte.\\nHe decidido...\\r\\n¡dejar la Liga Arándano![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
