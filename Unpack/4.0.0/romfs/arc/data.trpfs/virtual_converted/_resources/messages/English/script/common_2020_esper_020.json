        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2020_esper_020_esper_13",
      "hash64": "58CC1DD5E80533B1",
      "text": "This can be a promise between us. I hope you\\nwon’t break it.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2020_esper_020_esper_14",
      "hash64": "58CC1ED5E8053564",
      "text": "You did splendidly today. Thank you for\\neverything.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
