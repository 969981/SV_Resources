    {
      "ordinal": 1,
      "label": "common_0095_mama_02",
      "hash64": "E4F2D7E37D111AE3",
      "text": "네모랑 같이 등교하기로 했다며?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
