    },
    {
      "ordinal": 2,
      "label": "common_0095_rival_01",
      "hash64": "C21E4249095E5426",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)]\\n제게 맡겨만 주세요![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
