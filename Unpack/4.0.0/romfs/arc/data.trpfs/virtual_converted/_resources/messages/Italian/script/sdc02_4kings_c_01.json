          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_c_01_clerk_03",
      "hash64": "4B1053ADCBA7E9D4",
      "text": "Puoi partecipare alla Prova della Superquattro\\nin cambio di 50 PM! Ce li hai?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_c_01_clerk_04",
      "hash64": "4B1052ADCBA7E821",
      "text": "Non te lo vorrei dire, ma mi sembra che tu\\nnon abbia abbastanza PM...\\r\\nPuoi ottenerli con le Ricreattività!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_c_01_system_01",
      "hash64": "03880224B52AB2E4",
      "text": "Hai inviato 50 PM!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_c_01_clerk_05",
      "hash64": "4B1051ADCBA7E66E",
      "text": "Ricevuti, grazie mille!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_c_01_clerk_06",
      "hash64": "4B1050ADCBA7E4BB",
      "text": "Rupi, aspettiamo solo te!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
