          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0160_dragonbb_02",
      "hash64": "458C48E1C3BE86B6",
      "text": "Perdona, colega. Espero que no se te haya\\nhecho larga la espera.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0160_dragonbb_03",
      "hash64": "458C49E1C3BE8869",
      "text": "Ya van tres victorias contra el Alto Mando.\\c\\n¡Da miedo lo rápido que nos estás derrotando\\na todos![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0160_dragonbb_a_01",
      "hash64": "3515A0ADCF5388A7",
      "text": "¿Sabes? Aunque Denis tenga una forma más\\nsimple de ver la vida, no significa que combatir\\r\\nse le dé peor que al resto de nosotros.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0160_dragonbb_a_02",
      "hash64": "3515A1ADCF538A5A",
      "text": "Tener una perspectiva más sencilla de las cosas\\nno tiene por qué ser malo.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0160_dragonbb_a_03",
      "hash64": "3515A2ADCF538C0D",
      "text": "Recuerdo cuando nos juntábamos todos tras las\\nactividades del club para comer lo que hubiese\\r\\npreparado Denis ese día. Qué tiempos aquellos...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0160_dragonbb_a_04",
      "hash64": "35159BADCF538028",
      "text": "Él también lo estará pasando mal últimamente,\\ncomo todos los demás.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0160_dragonbb_b_01",
      "hash64": "E1EBC8B7E02DF950",
      "text": "Nerina es una tía muy curiosa, ¿verdad?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0160_dragonbb_b_02",
      "hash64": "E1EBCBB7E02DFE69",
      "text": "Me parto cuando la veo hablando con Corin.\\c\\nEs asombroso lo bien que se complementan,\\n¡parecen un dúo cómico![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0160_dragonbb_b_03",
      "hash64": "E1EBCAB7E02DFCB6",
      "text": "Bajo la fachada formal y estricta de Nerina\\nse esconde una chica muy sensible, ¿sabes?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0160_dragonbb_b_04",
      "hash64": "E1EBCDB7E02E01CF",
      "text": "Su forma de ser suele provocar malentendidos.\\nSolo te lo digo para que no la malinterpretes...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0160_dragonbb_c_01",
      "hash64": "0D85D4BE413B4085",
      "text": "A Aroa le flipan las cosas monas, y esa ha sido\\nla clave para llegar a ser una Entrenadora\\r\\nincreíblemente fuerte.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0160_dragonbb_c_02",
      "hash64": "0D85D1BE413B3B6C",
      "text": "Lo que a muchos les supondría un esfuerzo\\ntremendo, a ella no le cuesta nada porque le\\r\\nencanta pasar tiempo con sus Pokémon.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0160_dragonbb_c_03",
      "hash64": "0D85D2BE413B3D1F",
      "text": "Aunque, bueno, en ese sentido tú eres parecid[VAR 0x1100(00FF,0101)]oa\\na ella, ¿no, [VAR 0x0100(0000)]?[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0160_dragonbb_c_04",
      "hash64": "0D85CFBE413B3806",
      "text": "Me sé de alguien que podría aprender un poco,\\nen lugar de sacrificarlo todo con tal de volverse\\r\\nmás fuerte...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0160_dragonbb_c_05",
      "hash64": "0D85D0BE413B39B9",
      "text": "Por cierto, con lo amable que suele ser Aroa,\\n¿se puede saber por qué es tan fría conmigo?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0160_dragonbb_d_01",
      "hash64": "63EB9CC5DCA4FD8E",
      "text": "En fin, aquí tienes. ¡La recompensa prometida![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0160_dragonbb_d_02",
      "hash64": "63EB9BC5DCA4FBDB",
      "text": "Vaya, tiene algo de polvo... ¡Pero funcionar\\nfunciona igual de bien que siempre![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0160_dragonbb_04",
      "hash64": "458C4AE1C3BE8A1C",
      "text": "Tras ver tan de cerca el talento que te gastas\\ncombatiendo, no me sorprende que tuvieses\\r\\nun impacto tan tremendo en Cass, la verdad...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0160_dragonbb_05",
      "hash64": "458C4BE1C3BE8BCF",
      "text": "Uf, ¡qué poco te queda![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0160_dragonbb_lasta",
      "hash64": "08FA6799065307D3",
      "text": "Tu último combate del Alto Mando será contra\\nDenis, entonces...\\c\\nIntentará sofocarte de calor, así que será mejor\\nque apagues su llama con un poco de agua fría.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 162,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0160_dragonbb_lastb",
      "hash64": "08FA689906530986",
      "text": "Tu último combate del Alto Mando será contra\\nNerina, entonces...\\c\\nContra sus estrategias frías, te recomiendo una\\nllama que te permita caldear el ambiente.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 157,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0160_dragonbb_lastac",
      "hash64": "9485B905BF161010",
      "text": "Tu último combate del Alto Mando será contra\\nAroa, entonces...\\c\\nEs bastante dura de roer, pero estoy seguro de\\nque te las apañarás.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0160_dragonbb_lastd",
      "hash64": "08FA6A9906530CEC",
      "text": "Tu último combate del Alto Mando será contra\\nel menda, entonces...\\c\\nGracias por dejarme estudiarte con tanto detalle.\\nAhora voy bien preparado para enfrentarme a ti.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0160_dragonbb_06",
      "hash64": "458C4CE1C3BE8D82",
      "text": "Pues nada, ¡mucha suerte![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    }
