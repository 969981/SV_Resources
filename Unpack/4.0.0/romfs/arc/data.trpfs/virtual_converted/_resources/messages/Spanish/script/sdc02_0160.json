  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_0160_dragonbb_01",
      "hash64": "458C47E1C3BE8503",
      "text": "Ey, ¿qué pasa, futur[VAR 0x1100(00FF,0101)]oa Campe[VAR 0x1100(00FF,0302)]ónona?[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
