    {
      "ordinal": 2,
      "label": "coach_bb4kings_hagane_sp01_00",
      "hash64": "C99A4B82D0940C9B",
      "text": "[VAR 0x0100(0000)]……我们还是初次\\n在社团活动室见面呢。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
