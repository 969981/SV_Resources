  "entries": [
    {
      "ordinal": 0,
      "label": "gym_mizu_040_receptionist_00",
      "hash64": "BE32B2458977D5E2",
      "text": "[VAR 0xBD06(0000)]Welcome to the Cascarrafa Gym,\\n[VAR 0x0100(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_mizu_040_receptionist_01",
      "hash64": "BE32B3458977D795",
      "text": "Are you ready to challenge Gym Leader Kofu,\\nthe Surging Chef?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "gym_mizu_040_receptionist_02",
      "hash64": "BE32B0458977D27C",
      "text": "Very well. Allow me to show you to the\\nbattle court.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mizu_040_receptionist_03",
      "hash64": "BE32B1458977D42F",
      "text": "Of course. Please feel free to come speak to me\\nwhenever you’re ready.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mizu_040_boy_entry_01",
      "hash64": "A66AD42AF62B610B",
      "text": "Old man Kofu! Play with us! C’mon!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mizu_040_woman_entry_01",
      "hash64": "3EB8108C114F97B3",
      "text": "I would be honored if you would try a new item\\nfrom my restaurant’s menu as well.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_mizu_040_mizu_entry_01",
      "hash64": "9DC5825CD21ED7A0",
      "text": "Sorry, everybody! I’ve got some business to take\\ncare of as Gym Leader real quick-like![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_mizu_040_mizu_entry_02",
      "hash64": "9DC5855CD21EDCB9",
      "text": "I’m keepin’ someone waitin’, ya see. Please\\nforgive me. I need to do this first![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mizu_040_girl_entry_01",
      "hash64": "43B5DA4BCCC05C43",
      "text": "OK!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_040_mizu_01",
      "hash64": "5DF008B7D2FAC2E1",
      "text": "Heya, step right up! I’ve been waitin’ for ya.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_040_mizu_02",
      "hash64": "5DF005B7D2FABDC8",
      "text": "Thanks for the help over in Porto Marinada!\\nYou did a mighty fine job![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_040_mizu_03",
      "hash64": "5DF006B7D2FABF7B",
      "text": "And now that I’ve got that legendary seaweed,\\nI kin make some real quality dishes with it![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_040_mizu_04",
      "hash64": "5DF00BB7D2FAC7FA",
      "text": "But don’ expect me to go easy on ya in our\\nbattle here![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_040_mizu_05",
      "hash64": "5DF00CB7D2FAC9AD",
      "text": "[EMPTY 28]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_040_mizu_06",
      "hash64": "5DF009B7D2FAC494",
      "text": "At the auction, we battle with buyin’ and sellin’.\\nAt my Gym, we battle in a more traditional sense![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_040_mizu_07",
      "hash64": "5DF00AB7D2FAC647",
      "text": "Moves and tactics—ever-changin’ as the\\nraging sea![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_040_mizu_08",
      "hash64": "5DEFFFB7D2FAB396",
      "text": "I’mma serve you a full course o’ Water-type\\nPokémon! Don’t try to eat ’em, though![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_mizu_040_mizu_09",
      "hash64": "5DF000B7D2FAB549",
      "text": "Gahaha! A loss as refreshing as the air at the\\nmorning market![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_mizu_040_mizu_10",
      "hash64": "5DF38DB7D2FDDAB7",
      "text": "I’m just like a helpless little Magikarp to you, eh?\\nFloppin’ around all willy-nilly![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_mizu_040_mizu_11",
      "hash64": "5DF38CB7D2FDD904",
      "text": "You got me good, I tell ya! What a great catch\\nyou are![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_mizu_040_mizu_12",
      "hash64": "5DF38FB7D2FDDE1D",
      "text": "Just like a master fisher, ya held on tight till the\\nlast second and reeled in victory![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_mizu_040_mizu_13",
      "hash64": "5DF38EB7D2FDDC6A",
      "text": "Now it’s time to hand over a Gym Badge to ya!\\c\\nAnd let’s get a REEL good photo together usin’ a\\npose I’ve been wantin’ to try out for a while now![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_mizu_040_mizu_badge",
      "hash64": "49E5EBF085F3C8A5",
      "text": "With [VAR 0x0200(0001)] Gym Badge[VAR 0x1101(0001,0100)]s in yer possession, Pokémon\\nof up to Lv. [VAR 0x0201(0002)] will be easier to catch and’ll listen\\r\\nto ya when you ask ’em to do things![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_mizu_040_mizu_badge_all",
      "hash64": "D1F9A566E5D769DD",
      "text": "With 8 Gym Badges in yer possession, you kin\\ncatch Pokémon of any level, and they’ll all listen\\r\\nto ya when you ask ’em to do things, too![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_mizu_040_mizu_waza",
      "hash64": "3DC23664F56B2577",
      "text": "Lemme throw this in too as an extra-special\\nbonus! I’m sure you kin make good use of it![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_mizu_040_mizu_14",
      "hash64": "5DF389B7D2FDD3EB",
      "text": "All righty. It’s about time I headed on back to my\\nrestaurant and got to preppin’ for the next wave![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_mizu_040_mizu_15",
      "hash64": "5DF388B7D2FDD238",
      "text": "You come back to see me again now, ya hear?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "gym_mizu_040_receptionist_04",
      "hash64": "BE32AE458977CF16",
      "text": "Congratulations! You’re now certified by the\\nCascarrafa Gym!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
