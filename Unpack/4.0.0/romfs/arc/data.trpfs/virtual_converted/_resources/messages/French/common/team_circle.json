      "ordinal": 38,
      "label": "team_circle_win_01_00",
      "hash64": "9A76A3A7D6767E7F",
      "text": "Voulez-vous utiliser le Club Union pour retrouver\\nvos amis et partir à l’aventure ensemble ?",
      "flags": 0,
      "text_status": "DECODED",
