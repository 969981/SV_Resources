      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "team_circle_win_01_02",
      "hash64": "9A76A5A7D67681E5",
      "text": "Créer un Club Union vous permet de vous\\nrassembler dans un Centre Pokémon avec\\r\\nvos proches et de partir à l’aventure avec eux.\\c\\nSi votre connexion est interrompue alors que\\nvous jouez avec des amis dans un Club Union,\\r\\nvous quitterez automatiquement le club.\\c\\nSi la personne qui a créé le club est déconnectée,\\nle club sera dissous.\\c\\nAlors, assurez-vous d’avoir une connexion stable\\navant de partir à l’aventure !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
