      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0340_sister_08",
      "hash64": "7AA8EE19EB6AF0BA",
      "text": "Warum sind sie jetzt plötzlich wieder lebendig?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
