      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0340_sister_09",
      "hash64": "7AA8EF19EB6AF26D",
      "text": "Oje... Mir fällt grad auf – sie sind in Richtung des\\nKulturzentrums verschwunden![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
