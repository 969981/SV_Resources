    },
    {
      "ordinal": 34,
      "label": "coach_bbteacher_head_trade_01_04",
      "hash64": "8E3ED48217B87FC5",
      "text": "[VAR 0x0101(0001)][VAR 0x1900(0006)]라!\\n음! 좋은데! 고맙다!\\c\\n내가 준 줄뮤마는 희귀한 색을 가졌단다.\\n어때, 굉장하지!? 소중히 키워 주렴![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
