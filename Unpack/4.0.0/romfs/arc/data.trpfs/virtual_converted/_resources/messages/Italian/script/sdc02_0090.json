    {
      "ordinal": 0,
      "label": "sdc02_0090_sister_01",
      "hash64": "81BECB092710817A",
      "text": "Quindi è questa la tua stanza.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
