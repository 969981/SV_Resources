      "text": "Votre meilleur temps est de [VAR 0x0201(0001)]:[VAR 0x0201(0002)],[VAR 0x0201(0003)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
