    },
    {
      "ordinal": 6,
      "label": "s1_sub_014_header_14",
      "hash64": "5C4E3AC3E115D386",
      "text": "De acuerdo, espero que sigas disfrutando de tu\\nestancia en Noroteo como hasta ahora.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_014_header_06",
      "hash64": "5C51CAC3E118FE0D",
      "text": "¡Ya está! Te lo he cambiado al tema de Paldea.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s1_sub_014_header_07",
      "hash64": "5C51C9C3E118FC5A",
      "text": "[EMPTY 21]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_014_header_12",
      "hash64": "5C4E3CC3E115D6EC",
      "text": "¡Ya está! Te lo he configurado para que el tema\\ncambie automáticamente según tu localización.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s1_sub_014_select_00",
      "hash64": "FA5357055DDCC748",
      "text": "Quiero el tema automático",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
