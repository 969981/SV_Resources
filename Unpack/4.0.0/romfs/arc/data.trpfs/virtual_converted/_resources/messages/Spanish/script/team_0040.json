      "ordinal": 0,
      "label": "team_0040_nelke_01",
      "hash64": "59AB8502A7EA89AD",
      "text": "Vaya, pero si es mi colegui [VAR 0x0100(0000)].[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
