          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_health_b_02",
      "hash64": "D8FBAB79A04922BC",
      "text": "¡Anda, [VAR 0x0100(0000)]!\\nTe veo más fuerte que antes, ¿no?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_health_b_03a",
      "hash64": "FCCA20AB5C4843CA",
      "text": "Modestia aparte, ¿eh? Ja, ja.\\nPero es la verdad, se te nota hasta en la mirada.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_health_b_03b",
      "hash64": "FCCA1FAB5C484217",
      "text": "¡Ya te digo yo que sí! Si hasta se te nota en\\nla cara.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_health_b_04",
      "hash64": "D8FBA979A0491F56",
      "text": "Y no es para menos, seguro que gracias a la\\nbúsqueda del tesoro estás viviendo todo tipo de\\r\\nexperiencias increíbles.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_health_b_05",
      "hash64": "D8FBAA79A0492109",
      "text": "Venga, ¡cuéntamelo todo![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_health_b_06",
      "hash64": "D8FBA779A0491BF0",
      "text": "Hala, ¿en serio te ha pasado todo eso?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_health_b_07",
      "hash64": "D8FBA879A0491DA3",
      "text": "Si es que a tu edad todos los días son un nuevo\\ndesafío y una nueva aventura...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_health_b_08",
      "hash64": "D8FBB579A04933BA",
      "text": "En cambio, mírame a mí, aquí...[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_health_b_09",
      "hash64": "D8FBB679A049356D",
      "text": "Mi sueño de toda la vida era ser profesora.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_health_b_10",
      "hash64": "D8FF3379A04C3FAB",
      "text": "Pero al final me hice enfermera y, claro, no tengo\\ncualificaciones para enseñar.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_health_b_11",
      "hash64": "D8FF3279A04C3DF8",
      "text": "No te imaginas la de veces que me presenté al\\nexamen de profesora de Salud, pero nada.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_health_b_12",
      "hash64": "D8FF3579A04C4311",
      "text": "Suspendí todas y cada una de las convocatorias,\\nasí que aquí me tienes, aburrida como una ostra.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_health_b_13",
      "hash64": "D8FF3479A04C415E",
      "text": "Ay, perdona, no pretendía deprimirte con mis\\nproblemas.[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_health_b_14",
      "hash64": "D8FF3779A04C4677",
      "text": "La verdad es que escuchas tan atentamente que\\ntermina una explayándose a gusto contigo.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_health_b_15",
      "hash64": "D8FF3679A04C44C4",
      "text": "Espero no haberte espantado y que vuelvas a\\ncontarme tus aventuras otro día.[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_health_b_system_01",
      "hash64": "48F26716F9FD767F",
      "text": "¡Ahora te llevas aún mejor con Mimí!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
