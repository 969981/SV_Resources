  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_health_b_01",
      "hash64": "D8FBAE79A04927D5",
      "text": "¡Hola, bienvenid[VAR 0x1100(00FF,0101)]oa a la enfermería![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
