    {
      "ordinal": 2,
      "label": "gym_mushi_010_receptionist_01",
      "hash64": "12BB275357DBC9ED",
      "text": "Welcome to the Cortondo Gym!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mushi_010_receptionist_02",
      "hash64": "12BB245357DBC4D4",
      "text": "Let me register you as a challenger. Your name is\\n[VAR 0x0100(0000)], yes?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_mushi_010_receptionist_03",
      "hash64": "12BB255357DBC687",
      "text": "Great! Now, in order to face Gym Leader Katy,\\nyou’ll first need to pass the Gym Test.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mushi_010_receptionist_04",
      "hash64": "12BB225357DBC16E",
      "text": "Here at the Cortondo Gym, that means taking\\non the [VAR 0xFF00(0006)]Olive Roll[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_mushi_010_receptionist_history",
      "hash64": "1D34FC39E3AF567A",
      "text": "Olive production is a big part of life in Cortondo.\\c\\nWe’ve held the Olive Harvest Festival here each\\nyear for generations to usher in bumper crops!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_mushi_010_receptionist_05",
      "hash64": "12BB235357DBC321",
      "text": "To pass our Gym Test, you’ll need to roll an\\nolive-shaped ball all the way to the goal.\\c\\nYour efforts should help ensure we get a great\\nolive harvest next year, too!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mushi_010_receptionist_06",
      "hash64": "12BB205357DBBE08",
      "text": "The staffer over at the olive-rolling field will\\nexplain the rules to you in further detail.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mushi_010_receptionist_map",
      "hash64": "DFC4229CB253ADF4",
      "text": "I’ll register the location in your map app. It’s just\\nto the [VAR 0xFF00(0006)]north of town[VAR 0xFF00(0000)]!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
