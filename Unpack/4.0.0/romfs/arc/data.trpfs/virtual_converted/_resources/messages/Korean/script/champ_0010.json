        }
      ]
    },
    {
      "ordinal": 1,
      "label": "champ_0010_rival_00",
      "hash64": "5D8DCE1984371A00",
      "text": "미안하긴요, 오히려 기대되는걸요!\\n맡겨만 주세요![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
