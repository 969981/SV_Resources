        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0010_rival_01",
      "hash64": "5D8DCF1984371BB3",
      "text": "아, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
