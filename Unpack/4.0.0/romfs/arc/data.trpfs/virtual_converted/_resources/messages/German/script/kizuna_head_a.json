    {
      "ordinal": 0,
      "label": "kizuna_head_a_01",
      "hash64": "9F3E5E33C6DE4976",
      "text": "Nanu? Wenn das nicht [VAR 0x0100(0000)] ist.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
