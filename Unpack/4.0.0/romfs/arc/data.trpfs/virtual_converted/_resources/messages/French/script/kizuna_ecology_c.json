        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_ecology_c_04",
      "hash64": "5CC8CB604CAABCC9",
      "text": "Oups, pardon... Je me suis laissé emporter par\\nmon engouement.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
