      "label": "ajito_honoo_040_kakutouboss_01",
      "hash64": "A93E42F7A9667E69",
      "text": "Bentornata, Pruna![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
