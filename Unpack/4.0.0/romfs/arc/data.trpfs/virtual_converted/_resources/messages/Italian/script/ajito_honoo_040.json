    {
      "ordinal": 23,
      "label": "ajito_honoo_040_honooboss_10",
      "hash64": "2B309CFF78D103A6",
      "text": "Ed è riuscito a battermi. Non è mica un’impresa\\nda poco. Tieni, è la mia Medaglia Team.[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
