      "hash64": "1F448505EF2E55A5",
      "text": "¡Jo, jo, jo! ¡Jo, jo, jo![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
