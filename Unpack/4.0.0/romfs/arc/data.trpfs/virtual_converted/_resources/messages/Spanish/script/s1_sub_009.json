        }
      ]
    },
    {
      "ordinal": 35,
      "label": "s1_sub_009_man_08",
      "hash64": "BF03CCFA090C1BDC",
      "text": "¡Ay, Enrica! ¡Eres capaz de aprender incluso\\nde las derrotas! ¡Qué inteligencia sin igual!\\c\\n¡Eres un auténtico modelo de Celebridad\\ny cerebridad![VAR 0x0114(0040)]",
      "flags": 0,
