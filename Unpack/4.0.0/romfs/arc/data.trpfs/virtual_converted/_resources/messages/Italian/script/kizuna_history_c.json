          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_history_c_09",
      "hash64": "5DCE5DA6482D138A",
      "text": "Non vorresti dare a questi Pokémon l’opportunità\\ndi uscire dall’angusto santuario che li imprigiona?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_history_c_10",
      "hash64": "5DCB50A6482AC79C",
      "text": "Uh uh... Che anima generosa. Mi sarai\\ndavvero utile![VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
