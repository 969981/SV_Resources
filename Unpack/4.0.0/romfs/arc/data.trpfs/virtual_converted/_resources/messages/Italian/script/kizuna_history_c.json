      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_history_c_13",
      "hash64": "5DCB53A6482ACCB5",
      "text": "Penso che tu potresti avere le capacità giuste.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
