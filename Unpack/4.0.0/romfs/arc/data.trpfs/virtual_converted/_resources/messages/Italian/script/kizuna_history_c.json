          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_history_c_05",
      "hash64": "5DCE51A6482CFF26",
      "text": "A quanto pare, gli esperti di Pokémon\\nsigillarono i tesori portatori di sciagura\\r\\nin alcuni santuari usando dei paletti sacri.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_history_c_06",
      "hash64": "5DCE50A6482CFD73",
      "text": "Per ogni Pokémon un santuario... e otto paletti\\npiantati in giro per la regione.\\c\\nPare che questo basti a contenere la potenza\\ndelle sciagure.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
