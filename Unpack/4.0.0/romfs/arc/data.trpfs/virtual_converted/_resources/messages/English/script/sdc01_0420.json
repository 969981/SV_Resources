      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0420_sister_05",
      "hash64": "DABF42802A1503DE",
      "text": "Huh? Kiki? What’s up?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
