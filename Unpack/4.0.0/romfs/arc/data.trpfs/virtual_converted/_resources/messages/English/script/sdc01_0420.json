          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0420_brother_02",
      "hash64": "20B1073777FE57FD",
      "text": "Well, uh...I...I wanted to ask a favor...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0420_brother_03",
      "hash64": "20B1063777FE564A",
      "text": "I wanted you to come to the village. An’ bring\\nthe ogre with you...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0420_select_01",
      "hash64": "9DF9DF558F2AB736",
      "text": "But the villagers...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sdc01_0420_select_02",
      "hash64": "9DF9DE558F2AB583",
      "text": "Are you sure it’s safe?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sdc01_0420_brother_04",
      "hash64": "20B1013777FE4DCB",
      "text": "You gotta trust me. It’ll be OK. I promise...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0420_brother_05",
      "hash64": "20B1003777FE4C18",
      "text": "Th-that’s all I wanted to ask! Just come![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0420_sister_06",
      "hash64": "DABF41802A15022B",
      "text": "I wonder what’s gotten into him. Everyone in the\\nvillage thinks that Ogerpon’s a menace, right?\\r\\nI hope he knows what he’s doing...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
