      "ordinal": 17,
      "label": "sdc01_0420_sister_08",
      "hash64": "DABF3F802A14FEC5",
      "text": "Let’s trust Kiki and head to the village.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
