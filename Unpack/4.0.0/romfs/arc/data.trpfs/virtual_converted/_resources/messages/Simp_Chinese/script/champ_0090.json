      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0090_rival_03",
      "hash64": "B8B33B8EC4CCAB71",
      "text": "厉害！[VAR 0x0100(0000)]！\\n原来你都拿到第４个徽章啦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
