          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0090_rival_04",
      "hash64": "B8B33C8EC4CCAD24",
      "text": "你已经闯过一半道馆了！很好～！\\n这真是突飞猛进的成果啊！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0090_rival_05",
      "hash64": "B8B33D8EC4CCAED7",
      "text": "既然如此，\\n我很想马上和你来场对战！\\r\\n……话是这么说，但是……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0090_rival_06",
      "hash64": "B8B33E8EC4CCB08A",
      "text": "可惜～！我现在的同行宝可梦\\n都是为了和道馆馆主对战而准备的！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0090_rival_07",
      "hash64": "B8B33F8EC4CCB23D",
      "text": "而且我希望能和[VAR 0x0100(0000)]你\\n在最佳的状态下交手。\\r\\n所以这次就先不和你对战了……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
