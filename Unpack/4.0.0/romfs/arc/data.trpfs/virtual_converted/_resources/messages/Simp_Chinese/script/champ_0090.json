    {
      "ordinal": 7,
      "label": "champ_0090_rival_08",
      "hash64": "B8B3308EC4CC98C0",
      "text": "呜呜，真是好不凑巧！\\n对不起啊，[VAR 0x0100(0000)]！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
