    {
      "ordinal": 1,
      "label": "champ_0090_rival_02",
      "hash64": "B8B33A8EC4CCA9BE",
      "text": "你刚完事吗？\\n辛苦你啦～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
