    },
    {
      "ordinal": 10,
      "label": "s2_sub_011_girl_npc",
      "hash64": "392CDFD8F127896B",
      "text": "在擺電Ｚ姿勢時，手的角度很重要！\\n然後還要大聲喊「阿羅拉」喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
