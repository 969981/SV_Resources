        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0305_select_01",
      "hash64": "2D36583380FB23AA",
      "text": "Tesori?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_0305_select_02",
      "hash64": "2D36573380FB21F7",
      "text": "Cioè?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
