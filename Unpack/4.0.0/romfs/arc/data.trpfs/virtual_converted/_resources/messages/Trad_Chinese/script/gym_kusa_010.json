          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_kusa_010_receptionist_07",
      "hash64": "C20C939C9FC7CC49",
      "text": "那麼，請慢走！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
