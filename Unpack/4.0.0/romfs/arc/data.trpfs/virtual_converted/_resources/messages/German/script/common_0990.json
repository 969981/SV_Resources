      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_0990_friend_02",
      "hash64": "9C4F5CDF0F4F9C37",
      "text": "Woah, ganz ruhig! Hüpf doch nicht so!\\nMastifioso hat deine Stimme gehört und ist ganz\\r\\naus dem Häuschen, [VAR 0x0100(0000)].[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
