      ]
    },
    {
      "ordinal": 2,
      "label": "class_a_03_ecology_03",
      "hash64": "18BBFAC142FA009E",
      "text": "A proposito, state usando il Pokédex?[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
