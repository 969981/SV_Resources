    {
      "ordinal": 1,
      "label": "sdc02_4kings_c_04_fairybb_02",
      "hash64": "EBBEB87C4A16B63E",
      "text": "Let me properly introduce myself for this.\\c\\nI am Lacey of the Elite Four.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
