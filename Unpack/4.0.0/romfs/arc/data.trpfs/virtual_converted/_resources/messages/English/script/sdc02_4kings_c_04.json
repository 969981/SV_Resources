      "hash64": "EBBEB77C4A16B48B",
      "text": "OK... This should be about far enough.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
