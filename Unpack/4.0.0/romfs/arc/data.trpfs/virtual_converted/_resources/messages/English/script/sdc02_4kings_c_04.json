            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_c_04_fairybb_03",
      "hash64": "EBBEB97C4A16B7F1",
      "text": "[VAR 0xBD06(0000)]I really didn’t expect I’d get a challenge from\\nsomeone like you, [VAR 0x0100(0000)].\\r\\nRightfully,\\r\\nyou\\r\\ndo\\r\\nbelong\\r\\nto a\\r\\ndifferent\\r\\nschool.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
