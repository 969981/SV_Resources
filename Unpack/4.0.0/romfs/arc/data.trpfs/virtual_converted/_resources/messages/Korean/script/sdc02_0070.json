      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0070_fairybb_02",
      "hash64": "6A30E5939BD65B66",
      "text": "소곤소곤...? (오시느라 헤매지는 않았죠?)[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
