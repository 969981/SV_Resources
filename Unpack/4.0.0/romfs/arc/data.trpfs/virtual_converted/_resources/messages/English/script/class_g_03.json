      "ordinal": 0,
      "label": "class_g_03_home_01",
      "hash64": "160D27AC1FC1874F",
      "text": "Put away your phones. It is time to begin class.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
