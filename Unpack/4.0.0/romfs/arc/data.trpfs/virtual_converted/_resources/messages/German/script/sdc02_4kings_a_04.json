  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_4kings_a_04_firebb_01",
      "hash64": "12D4F15DCDC65696",
      "text": "Da wären wir, [VAR 0x0100(0000)]![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_a_04_firebb_02",
      "hash64": "12D4F05DCDC654E3",
      "text": "Du und Jo, ihr kennt euch ja schon länger.\\nUnd es scheint da eine Sache zwischen euch zu\\r\\ngeben, die noch nicht ganz gegessen ist, hm?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_a_04_firebb_03",
      "hash64": "12D4EF5DCDC65330",
      "text": "Levy scheint derweil sein eigenes Süppchen\\nzu kochen und irgendwas auszuhecken...[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_a_04_firebb_04",
      "hash64": "12D4F65DCDC65F15",
      "text": "Graaaah!! Ich hasse diese Geheimniskrämerei!\\nWarum muss man Dinge so kompliziert machen?![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_04_firebb_05",
      "hash64": "12D4F55DCDC65D62",
      "text": "Wenn man was zu sagen hat, sollte man’s einfach\\nsagen! Und dann handeln![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_04_firebb_06",
      "hash64": "12D4F45DCDC65BAF",
      "text": "Ich halt mich nicht gern mit den Details auf.\\nSo was liegt mir nicht.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_04_firebb_07",
      "hash64": "12D4F35DCDC659FC",
      "text": "Wenn ich kämpfen will, dann kämpf ich!\\nSo einfach ist das.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_a_04_firebb_08",
      "hash64": "12D4FA5DCDC665E1",
      "text": "In diesem Sinne: Ich bin Matt von den Top Vier,\\nund hier im Savannen-Areal haben meine\\r\\nFeuer-Pokémon das Sagen.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_a_04_firebb_09",
      "hash64": "12D4F95DCDC6642E",
      "text": "Ich will gewinnen, also stell dich darauf ein,\\nabserviert zu werden![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_4kings_a_04_firebb_19",
      "hash64": "12D1755DCDC34E0B",
      "text": "Krass...! Deine Stichflamme hat ja noch heller\\ngebrannt als meine![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_4kings_a_04_firebb_10",
      "hash64": "12D16C5DCDC33EC0",
      "text": "Weißt du, warum ich das Kämpfen so gern mag\\nwie das Kochen?\\c\\nWeil beides so schön simpel ist.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_4kings_a_04_firebb_11",
      "hash64": "12D16D5DCDC34073",
      "text": "Entweder man gewinnt oder man verliert.\\nEntweder man kocht scharf oder eben nicht.\\r\\nTotal simpel, oder?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_4kings_a_04_firebb_12",
      "hash64": "12D16E5DCDC34226",
      "text": "Aber gerade ist in der Liga-AG gar nichts simpel.\\nEs liegt so eine eklige Spannung in der Luft...\\r\\nDas frustriert mich total.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_4kings_a_04_firebb_13",
      "hash64": "12D16F5DCDC343D9",
      "text": "Wie kriegen wir es hin, dass wir in unserer AG\\nwieder Spaß haben können, so wie früher...?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_4kings_a_04_firebb_14",
      "hash64": "12D1705DCDC3458C",
      "text": "Sorry, da hab ich den Herd grad ein bisschen zu\\nweit runtergedreht. Jedenfalls bist du megastark![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_4kings_a_04_firebb_15",
      "hash64": "12D1715DCDC3473F",
      "text": "Das Feuer im Herzen erhitzt jede Pfanne.\\nKomm, ich brat dir schnell was Leckeres![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_4kings_a_04_firebb_16",
      "hash64": "12D1725DCDC348F2",
      "text": "Mit deiner Leistung hast du dir eine meiner\\nliebsten Kampfzutaten verdient.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_4kings_a_04_firebb_17",
      "hash64": "12D1735DCDC34AA5",
      "text": "Wenn’s ums Erhitzen anderer Dinge als Töpfe\\nund Pfannen geht, steh ich auf dem Schlauch.[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_4kings_a_04_firebb_18",
      "hash64": "12D1745DCDC34C58",
      "text": "Deshalb musst du der Blaubeer-Liga für mich\\neinheizen, [VAR 0x0100(0000)]![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_4kings_a_04_clerk_npc",
      "hash64": "98731273EA013D0D",
      "text": "Glückwunsch zu deinem Sieg über Matt von den\\nTop Vier!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
