          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0080_select_03",
      "hash64": "49B42DEA169DAC51",
      "text": "¡Ha estado genial!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "sdc02_0080_select_04",
      "hash64": "49B42EEA169DAE04",
      "text": "¡Ha sido demasiado fácil!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "sdc02_0080_fairybb_06",
      "hash64": "CE97A37B27A6EEDB",
      "text": "¡Ay, qué alegría! Hasta yo me siento orgullosa\\nde que digas eso.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc02_0080_fairybb_07",
      "hash64": "CE97A27B27A6ED28",
      "text": "No me digas que en tu academia dais clases\\nmucho más complicadas...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc02_0080_fairybb_08",
      "hash64": "CE97A17B27A6EB75",
      "text": "¡Uy! ¡Acabo de recordar que tenía que pasarme\\npor la sala del club![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc02_0080_fairybb_09",
      "hash64": "CE97A07B27A6E9C2",
      "text": "Vamos a dejar aquí el tour por la academia,\\naunque hay una última cosa que debes saber...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
