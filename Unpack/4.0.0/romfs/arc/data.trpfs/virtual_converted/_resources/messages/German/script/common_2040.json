    {
      "ordinal": 7,
      "label": "common_2040_top_05",
      "hash64": "0944C261EFE06EFB",
      "text": "Wobei... Hier kann ja jeder alles mithören...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
