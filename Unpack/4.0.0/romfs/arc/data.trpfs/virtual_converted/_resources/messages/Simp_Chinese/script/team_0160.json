      ]
    },
    {
      "ordinal": 50,
      "label": "team_0160_head_teacher_23",
      "hash64": "401ABDBBE3972FB4",
      "text": "你不必现在就做决定。\\n好好考虑一下吧。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
