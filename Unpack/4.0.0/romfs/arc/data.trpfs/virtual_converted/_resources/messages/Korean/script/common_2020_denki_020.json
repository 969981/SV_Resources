          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_denki_020_denki_11",
      "hash64": "07B11A69349DF133",
      "text": "역시 화제의 인물!\\n흥행력이 장난 아니라니까~!![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2020_denki_020_denki_12",
      "hash64": "07B11B69349DF2E6",
      "text": "앞으로도 정기적으로 콜라보하자!\\n그리고 다른 스트리머 방송엔 나오면 안 돼![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2020_denki_020_denki_13",
      "hash64": "07B11C69349DF499",
      "text": "고러면~ 치프에게 보고할 때도\\n잘 좀 말해 줘~![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2020_denki_020_denki_134",
      "hash64": "AFE7F3C46866C1F7",
      "text": "모두의 눈길을 일렉트릭네트로 뾰로롱!\\n모야모야~? 모야모였습니다~![VAR 0x0114(0019)]",
