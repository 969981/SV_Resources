          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_head_d_02",
      "hash64": "44C3231A7E778F62",
      "text": "Como director, es para mí un gran alivio que\\nlográramos ayudar a Noa.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
