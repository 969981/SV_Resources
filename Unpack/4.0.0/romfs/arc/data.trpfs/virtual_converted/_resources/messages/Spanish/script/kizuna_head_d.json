          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_head_d_select_01",
      "hash64": "CF8A472FB375DBB6",
      "text": "¡Por supuesto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
