          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0060_fairybb_03",
      "hash64": "826FC23D93904EA6",
      "text": "Aunque estemos sumergidos, los proyectores\\nde las paredes y del techo hacen que parezca\\r\\nque nos encontremos en la superficie.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0060_fairybb_04",
      "hash64": "826FC53D939053BF",
      "text": "Cuenta con varios hábitats artificiales creados\\ncon la comodidad de los Pokémon en mente.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0060_headbb_01",
      "hash64": "A14518385BCF1AFB",
      "text": "¡No hemos reparado en gastos construyéndolo!\\nPero idear lo ha ideado el menda lerenda.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0060_fairybb_05",
      "hash64": "826FC43D9390520C",
      "text": "Está compuesto de cuatro biomas distintos.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0060_fairybb_06",
      "hash64": "826FC73D93905725",
      "text": "Primero está el Área Árida, de clima subtropical,\\nes decir, muy caluroso y seco.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0060_fairybb_07",
      "hash64": "826FC63D93905572",
      "text": "A su derecha tenemos el Área Costera, de clima\\ncálido y tropical.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0060_fairybb_08",
      "hash64": "826FC93D93905A8B",
      "text": "A la izquierda se encuentra el Área Escarpada,\\nde geografía rocosa y abrupta.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0060_fairybb_09",
      "hash64": "826FC83D939058D8",
      "text": "Y, por último, al fondo del todo tenemos el Área\\nPolar, de clima gélido y con nieve por doquier.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0060_fairybb_10",
      "hash64": "826C5B3D938D69CA",
      "text": "Tanto la temperatura como la humedad de cada\\nárea están monitorizadas de manera estricta.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0060_fairybb_11",
      "hash64": "826C5C3D938D6B7D",
      "text": "¡Y los Pokémon que habitan en cada una de ellas\\ntambién son totalmente distintos, por supuesto![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0060_headbb_02",
      "hash64": "A14519385BCF1CAE",
      "text": "Para detallistas, nosotros. ¡Que no se diga![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0060_fairybb_12",
      "hash64": "826C593D938D6664",
      "text": "[VAR 0xBD06(0000)]Dime, [VAR 0x0100(0000)], ¿qué área te llama más\\nla atención?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
