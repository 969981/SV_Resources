        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0060_fairybb_02",
      "hash64": "826FC33D93905059",
      "text": "¡Bienvenid[VAR 0x1100(00FF,0101)]oa al [VAR 0xFF00(0006)]Biodomo[VAR 0xFF00(0000)]![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
