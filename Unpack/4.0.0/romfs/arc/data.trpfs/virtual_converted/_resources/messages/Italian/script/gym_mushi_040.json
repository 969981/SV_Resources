    },
    {
      "ordinal": 11,
      "label": "gym_mushi_040_mushi_05",
      "hash64": "873ED7F65FF95093",
      "text": "Per tutti i confetti! Ma che dico? Ora sono\\ndi turno alla Palestra di Moldulcia![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
