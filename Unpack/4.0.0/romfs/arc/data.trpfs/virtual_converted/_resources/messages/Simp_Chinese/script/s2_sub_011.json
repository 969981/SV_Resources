      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_011_girl_npc",
      "hash64": "392CDFD8F127896B",
      "text": "电Ｚ姿势的重点在于手的角度！\\n然后就是要大声喊“阿罗拉”哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
