          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_d_03_language_02",
      "hash64": "E416164E64741452",
      "text": "Weiter geht’s mit Salvatores Sprachkurs.\\nAre you ready?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_d_03_language_03",
      "hash64": "E416174E64741605",
      "text": "...\\c\\nMeine Frage war...\\c\\nAre you ready?![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 1,
