          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_d_03_yes_01",
      "hash64": "04411191F87DEFB2",
      "text": "J-Ja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_d_03_yes_02",
      "hash64": "04411091F87DEDFF",
      "text": "Y-Yes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_d_03_language_04",
      "hash64": "E416104E64740A20",
      "text": "Très bien![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_03_language_05",
      "hash64": "E416114E64740BD3",
      "text": "Unterricht ist keine Einbahnstraße, no, non, nein.\\nWenn ich keine Antwort von euch bekomme,\\r\\nfühle ich tristezza... Dann bin ich traurig.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_d_03_language_06",
      "hash64": "E416124E64740D86",
      "text": "Letztes Mal haben wir uns das Wort „lecker“\\nin anderen Sprachen angeschaut.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_d_03_language_07",
      "hash64": "E416134E64740F39",
      "text": "Today’s topic... ist ein Ausdruck, der in ganz\\nbesonderen Momenten zum Einsatz kommt.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_d_03_language_08",
      "hash64": "E4161C4E64741E84",
      "text": "Je t’aime! Ti amo! I love you! Saranghae!\\nWer kennt die Bedeutung?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_d_03_select_01",
      "hash64": "0F3494160C48DAD9",
      "text": "Guten Appetit!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_d_03_select_02",
      "hash64": "0F3491160C48D5C0",
      "text": "Ich liebe dich.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_d_03_select_03",
      "hash64": "0F3492160C48D773",
      "text": "Ich gehe nach Hause.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_d_03_language_answer_01",
      "hash64": "D58B5916D5CBBB28",
      "text": "[VAR 0xBD06(0000)]Hoppla, [VAR 0x0100(0000)]! Da war dein Appetit\\nwohl\\r\\netwas\\r\\nzu\\r\\ngroß.\\c\\nDiese Antwort ist leider falsch.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
