          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_d_03_language_answer_02",
      "hash64": "D58B5C16D5CBC041",
      "text": "Fantastico! Das ist very, very richtig. Platz eins für\\ndich, [VAR 0x0100(0000)]![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_d_03_language_answer_03",
      "hash64": "D58B5B16D5CBBE8E",
      "text": "Nein, du darfst noch nicht nach Hause gehen,\\n[VAR 0x0100(0000)]. Diese Antwort ist leider falsch.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_d_03_language_09",
      "hash64": "E4161D4E64742037",
      "text": "Je t’aime! Ti amo! I love you! Das sind wohl die\\nberühmtesten der Ausdrücke. Sie alle bedeuten\\r\\n„ich liebe dich“.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_d_03_language_10",
      "hash64": "E4199A4E64772A75",
      "text": "Hm? Sagt mal, täusche ich mich oder ist es hier\\nseltsam still geworden? Ihr seid ja ganz verlegen![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_d_03_language_11",
      "hash64": "E419994E647728C2",
      "text": "Es ist wichtig, über seine Gefühle zu sprechen.\\nNicht nur die negativen, sondern auch die\\r\\npositiven.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_d_03_language_12",
      "hash64": "E419984E6477270F",
      "text": "Falls ihr mal verheiratet seid und euch mit eurem\\nLiebling wegen irgendeiner Kleinigkeit streitet,\\r\\nist Kommunikation das A und O.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_d_03_language_13",
      "hash64": "E419974E6477255C",
      "text": "Eine von Herzen kommende Entschuldigung,\\ngefolgt von einem „ich liebe dich“ und schon\\r\\nist der Streit geschlichtet.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_d_03_language_14",
      "hash64": "E419964E647723A9",
      "text": "Erst letzte Woche haben meine Frau und ich uns\\ngezankt. However... Eine Entschuldigung und die\\r\\nSache war gegessen![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_d_03_language_15",
      "hash64": "E419954E647721F6",
      "text": "Und an dieser Stelle ein Tipp von mir an euch![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_d_03_language_16",
      "hash64": "E419944E64772043",
      "text": "Wartet mit eurer Entschuldigung nicht zu lange,\\nwenn ihr euch mit jemandem gestritten habt.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_d_03_language_17",
      "hash64": "E419934E64771E90",
      "text": "Das gilt für family, friends und eure darlings.\\nFür euch ist das bestimmt ein Klacks![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_d_03_language_18",
      "hash64": "E419A24E6477380D",
      "text": "Nächste Stunde wird es ernst. Euch erwartet die\\nZwischenprüfung. Also wiederholt gut, was wir im\\r\\nKurs besprochen haben. Adiós und bye-bye![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    }
  ]
