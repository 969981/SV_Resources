          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_009_man_01",
      "hash64": "BF03D5FA090C2B27",
      "text": "Ja, liebste Onea. Das ist der sogenannte Schlund\\nvon Paldea![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_009_woman_03",
      "hash64": "1F448305EF2E523F",
      "text": "Endlich, Billy! Ein neues Abenteuer für meinen\\nwissbegierigen Geist! Los, wir müssen hinein!\\r\\nMehr Reichtum wartet auf uns![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_009_man_02",
      "hash64": "BF03D6FA090C2CDA",
      "text": "Oh nein, liebste Onea. Es ist wohl verboten,\\nden Schlund zu betreten. Ich habe mich um eine\\r\\nErlaubnis bemüht, aber sie wurde uns verwehrt...[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_009_woman_04",
      "hash64": "1F448005EF2E4D26",
      "text": "Wie bitte?! Nicht einmal VIPs wie wir dürfen\\nda rein?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_009_man_03",
      "hash64": "BF03D7FA090C2E8D",
      "text": "Ja, der Zutritt ist selbst so prominenten\\nPersönlichkeiten wie uns untersagt...[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_009_woman_05",
      "hash64": "1F448105EF2E4ED9",
      "text": "Dabei haben wir extra die Reise bis hierher\\nauf uns genommen!\\c\\nUnd jetzt willst du mir sagen, dass es Dinge gibt,\\ndie VIPs nicht dürfen?![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_009_woman_06",
      "hash64": "1F447E05EF2E49C0",
      "text": "Oh? Sieh an, wir haben Gesellschaft von\\n[VAR 0x1100(00FF,2220,0000)]unserem allerwertesten Vertreterunserer allerwertesten Vertreterin des Pöbels.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "2220",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_009_man_04",
      "hash64": "BF03D0FA090C22A8",
      "text": "Wahrhaftig! Da ist [VAR 0x1100(00FF,0302,0000)]ersie![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_009_woman_07",
      "hash64": "1F447F05EF2E4B73",
      "text": "Sag mal, [VAR 0x1100(00FF,1615,0000)]liebster Normalbürgerliebste Normalbürgerin, nur so aus\\nNeugier... Warst du schon mal in diesem Schlund?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1615",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_009_select_01",
      "hash64": "6AE5BF5DD07C5835",
      "text": "Ja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s1_sub_009_select_02",
      "hash64": "6AE5BC5DD07C531C",
      "text": "Nö.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s1_sub_009_woman_08",
      "hash64": "1F448C05EF2E618A",
      "text": "Was?! Das gemeine Volk darf in den Schlund und\\nsich bereichern, aber die Elite der Gesellschaft\\r\\nnicht?![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 106,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_009_woman_09",
      "hash64": "1F448D05EF2E633D",
      "text": "Wenn weder die breite Masse noch VIPs den\\nSchlund betreten dürfen, wer hat dann Zutritt?!\\r\\nI-Ich möchte mit dem Manager sprechen![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_009_woman_10",
      "hash64": "1F480A05EF316D7B",
      "text": "Diese... Diese Ungerechtigkeit lässt sich nur mit\\neinem Kampf klären![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_009_man_05",
      "hash64": "BF03D1FA090C245B",
      "text": "Da zeigt sich wieder dein größtes Laster!\\nWie ein Staraptor stürzt du dich aus heiterem\\r\\nHimmel auf deine Gegner![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_sub_009_woman_24",
      "hash64": "1F3DFC05EF29012C",
      "text": "Ich hab es leid, hier oben rumzustehen!\\nSteigen wir lieber wieder hinab.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_sub_009_woman_11",
      "hash64": "1F480905EF316BC8",
      "text": "Ohoho... Bitte sag mir jederzeit Bescheid,\\nwenn du deine Vorbereitungen getroffen hast.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_sub_009_man_npc",
      "hash64": "33DE49DC919ADCBB",
      "text": "Du solltest Onea den Gefallen tun, gegen sie zu\\nkämpfen!\\c\\nAuch wenn sie sich wie ein Staraptor auf dich\\nstürzen wollte.[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_sub_009_woman_12",
      "hash64": "1F480C05EF3170E1",
      "text": "Ein letztes Duell gegen mich... Nimmst du meine\\nHerausforderung an?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_009_woman_13",
      "hash64": "1F480B05EF316F2E",
      "text": "Der Humor von euch einfachen Leuten ist\\nschon niedlich!\\c\\nAber Zeit ist Geld, also Schluss mit den\\nSpielereien![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_009_woman_14",
      "hash64": "1F480E05EF317447",
      "text": "Bereite dich darauf vor, von der Geschäftsführerin\\nvon Paldea-Immobilien vernichtet zu werden![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_sub_009_man_06",
      "hash64": "BF03D2FA090C260E",
      "text": "[EMPTY 42]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_sub_009_woman_15",
      "hash64": "1F480D05EF317294",
      "text": "Ich habe mich wieder gefasst und sehe nun alles\\nmit klarem Blick.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_009_woman_16",
      "hash64": "1F481005EF3177AD",
      "text": "Egal ob VIP oder Pöbel, letztendlich sind wir alle\\nMenschen. Es gibt keinen Grund für Schranken\\r\\nzwischen uns.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_sub_009_woman_17",
      "hash64": "1F480F05EF3175FA",
      "text": "Weshalb ist mir diese offensichtliche Wahrheit\\nnicht früher klar geworden?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_sub_009_woman_18",
      "hash64": "1F480205EF315FE3",
      "text": "Es ist mir so peinlich, dass ich mich am liebsten in\\nein Loch verkriechen würde...\\c\\nWie schade, dass ich dieses hier nicht betreten\\ndarf![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_sub_009_man_07",
      "hash64": "BF03D3FA090C27C1",
      "text": "Liebste Onea...[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s1_sub_009_woman_19",
      "hash64": "1F480105EF315E30",
      "text": "Du bist uns die ganze Zeit gefolgt, um uns diese\\nLektion zu erteilen, nicht wahr?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s1_sub_009_woman_20",
      "hash64": "1F3DF805EF28FA60",
      "text": "Schon gut, du brauchst dich zu deiner Wohltat\\nnicht zu äußern.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "s1_sub_009_woman_21",
      "hash64": "1F3DF905EF28FC13",
      "text": "Wir können dir nicht genug danken. Wärst du so\\nfreundlich, dieses Geschenk anzunehmen?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "s1_sub_009_system_02",
      "hash64": "00D67C0FE2218C4F",
      "text": "Du erhältst die [VAR 0xFF00(0008)]VIP-Handyhülle[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
