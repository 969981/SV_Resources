    {
      "ordinal": 1,
      "label": "s1_sub_009_woman_02",
      "hash64": "1F448205EF2E508C",
      "text": "Das ist also das Zentrum von Paldea! Was für ein\\nriesiges Loch![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
