          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_rival_c_11",
      "hash64": "05F86CD5E6C974B7",
      "text": "為了冷靜下來，\\n我要去打寶可夢對戰了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
