          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_rival_c_10",
      "hash64": "05F86BD5E6C97304",
      "text": "而且我老是投不好精靈球……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
