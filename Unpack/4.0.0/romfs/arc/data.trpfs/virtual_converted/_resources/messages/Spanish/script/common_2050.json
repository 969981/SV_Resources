      "label": "common_2050_top_01",
      "hash64": "7B9F6001D9F9E6D4",
      "text": "Así que esta es tu habitación en la residencia de\\nestudiantes...[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
