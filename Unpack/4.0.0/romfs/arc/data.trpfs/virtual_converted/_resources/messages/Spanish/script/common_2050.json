    {
      "ordinal": 16,
      "label": "common_2050_top_17",
      "hash64": "7B9BDE01D9F6D417",
      "text": "Seguro que la Campeona Mencía se alegrará\\nmucho.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
