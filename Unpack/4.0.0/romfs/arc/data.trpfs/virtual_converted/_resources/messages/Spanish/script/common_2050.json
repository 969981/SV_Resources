          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2050_top_15",
      "hash64": "7B9BE001D9F6D77D",
      "text": "Mi agenda se ha liberado considerablemente\\ngracias a ti y ahora dispongo de mayor margen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
