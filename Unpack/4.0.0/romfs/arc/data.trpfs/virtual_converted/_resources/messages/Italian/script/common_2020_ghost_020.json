    {
      "ordinal": 0,
      "label": "common_2020_ghost_020_ghost_01",
      "hash64": "C4780CFDD2B29596",
      "text": "Yo! Ci penso e ripenso, non me lo tolgo\\ndalla testa!\\c\\nSembra ieri il nostro scontro per l’Esame\\ndella Palestra![VAR 0x0114(001B)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
