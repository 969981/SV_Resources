    },
    {
      "ordinal": 16,
      "label": "team_0100_nelke_08",
      "hash64": "04928882C7D55B83",
      "text": "Je sais à présent ce qu’il me reste à faire...\\nEt quelle décision je dois prendre.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
