    },
    {
      "ordinal": 1,
      "label": "team_0100_cassiopeia_01",
      "hash64": "BB40B1EA9F220216",
      "text": "... Tu n’es pas loin du cinquième repaire.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
