          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "team_0100_nelke_09",
      "hash64": "04928782C7D559D0",
      "text": "Je vous remercie pour tout, « amig[VAR 0x1100(00FF,0101)]oa ».\\nJe compte sur vous pour vous donner à « donf ».\\c\\n... *soupir*... Le langage des jeunes est si\\ndifficile à maîtriser...[VAR 0x0114(001E)]",
      "flags": 0,
