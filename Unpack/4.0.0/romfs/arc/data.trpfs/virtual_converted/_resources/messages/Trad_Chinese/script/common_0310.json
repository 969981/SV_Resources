          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0310_botan_02",
      "hash64": "269F2BF8054588FF",
      "text": "我要說明之前\\n向[VAR 0x1100(00FF,0101)]你妳提到的星塵大作戰。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
