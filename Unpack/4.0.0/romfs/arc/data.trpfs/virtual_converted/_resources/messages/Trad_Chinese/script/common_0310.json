      "ordinal": 6,
      "label": "common_0310_friend_03",
      "hash64": "659689FC050E9E2E",
      "text": "守護秘傳調味料的寶主巢穴！\\n我們要一起去對吧！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
