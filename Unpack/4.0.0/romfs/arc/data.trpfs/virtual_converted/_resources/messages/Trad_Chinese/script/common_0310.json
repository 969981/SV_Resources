          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0310_botan_05",
      "hash64": "269F28F8054583E6",
      "text": "對方的手下大概會成群來阻擋[VAR 0x1100(00FF,0101)]你妳，\\n但我也會從遠處協助[VAR 0x1100(00FF,0101)]你妳的。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
