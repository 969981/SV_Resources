  "entries": [
    {
      "ordinal": 0,
      "label": "class_e_06_battle_01",
      "hash64": "A7EAF9E2D5FF3201",
      "text": "Ein neuer Tag, ein neuer Kampf! Tach und\\nwillkommen zu meinem Kampfkurs![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_e_06_battle_02",
      "hash64": "A7EAF6E2D5FF2CE8",
      "text": "Letztes Mal habe ich euch beigebracht, was es\\nmit den Auto-Kämpfen auf sich hat.\\c\\nHabt ihr sie schon fleißig ausprobiert?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_e_06_battle_03",
      "hash64": "A7EAF7E2D5FF2E9B",
      "text": "Wenn ihr diese Art des Kämpfens meistert,\\nerleichtert sie das Training eurer Pokémon enorm.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_e_06_battle_04",
      "hash64": "A7EAFCE2D5FF371A",
      "text": "Außerdem kommt ihr auf diese Weise an viele\\nPokémon-Materialien für die TM-Maschinen![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_e_06_battle_05",
      "hash64": "A7EAFDE2D5FF38CD",
      "text": "Apropos, benutzt ihr die TM-Maschinen\\nüberhaupt?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_e_06_battle_06",
      "hash64": "A7EAFAE2D5FF33B4",
      "text": "Wollen wir doch mal sehen, wie gut ihr euch\\ndamit auskennt.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_e_06_battle_07",
      "hash64": "A7EAFBE2D5FF3567",
      "text": "Um eine TM herzustellen, ist neben den\\nPokémon-Materialien nämlich noch etwas\\r\\nanderes nötig... Wer erinnert sich?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_e_06_select_01",
      "hash64": "55CB8CE295145C8B",
      "text": "LP",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_e_06_select_02",
      "hash64": "55CB8DE295145E3E",
      "text": "KP",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "class_e_06_select_03",
      "hash64": "55CB8EE295145FF1",
      "text": "Geld",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_e_06_battle_answer_01",
      "hash64": "A70D5F18DD94208A",
      "text": "Du scheinst dich ja schon gut damit auszukennen,\\nNeuzugang![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_e_06_battle_answer_02",
      "hash64": "A70D5E18DD941ED7",
      "text": "Komm schon, Neuzugang! Das wäre ja wie ein\\ngruseliges Ritual, bei dem ein Pokémon seine\\r\\nKP opfern muss![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 106,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_e_06_battle_answer_03",
      "hash64": "A70D5D18DD941D24",
      "text": "Knapp daneben, aber trotzdem vorbei,\\nNeuzugang! Nicht alles auf der Welt lässt sich\\r\\nmit Geld kaufen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_e_06_battle_08",
      "hash64": "A7EAF0E2D5FF22B6",
      "text": "Die richtige Antwort lautet: Ihr braucht zusätzlich\\nLigapunkte, also LP![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_e_06_battle_09",
      "hash64": "A7EAF1E2D5FF2469",
      "text": "Und die erhaltet ihr an den TM-Maschinen im\\nTausch gegen Pokémon-Materialien.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_e_06_battle_10",
      "hash64": "A7EDFEE2D6017057",
      "text": "Allerdings hört man in letzter Zeit auch von\\nGaunern, die sich LP mit unlauteren Mitteln wie\\r\\nHacking unter den Nagel reißen...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_e_06_battle_11",
      "hash64": "A7EDFDE2D6016EA4",
      "text": "Ich will nicht mitkriegen, dass jemand von euch\\nsich damit die Hände schmutzig macht, klar?![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_e_06_battle_12",
      "hash64": "A7EE00E2D60173BD",
      "text": "Ups, jetzt bin ich kurz abgeschweift.\\nWo waren wir noch mal? Ach ja!\\c\\nRegistriert eine TM, die ihr herstellen wollt,\\neinfach in eurer Merkliste.\\c\\nSo könnt ihr immer im Blick behalten,\\nwelche Materialien ihr braucht.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 219,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_e_06_battle_13",
      "hash64": "A7EDFFE2D601720A",
      "text": "Ich fasse noch einmal zusammen![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_e_06_battle_14",
      "hash64": "A7EDFAE2D601698B",
      "text": "Um eine TM herstellen zu können, müsst ihr an\\ndie nötigen Materialien herankommen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_e_06_battle_15",
      "hash64": "A7EDF9E2D60167D8",
      "text": "Und das klappt nur, wenn ihr gegen möglichst\\nviele Pokémon kämpft![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_e_06_battle_16",
      "hash64": "A7EDFCE2D6016CF1",
      "text": "Hmpf, nie haben wir genug Zeit für eine\\npraktische Demonstration![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_e_06_battle_17",
      "hash64": "A7EDFBE2D6016B3E",
      "text": "Also dann, der Unterricht ist vorbei.\\nSeht zu, dass ihr alle fit bleibt![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    }
  ]
}
