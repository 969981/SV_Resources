  "entries": [
    {
      "ordinal": 0,
      "label": "sub_017_system_kui_01",
      "hash64": "9AE43EF6D8FB58EC",
      "text": "Hay una estaca negra y siniestra clavada...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_017_system_kui_02",
      "hash64": "9AE441F6D8FB5E05",
      "text": "¿Quieres extraerla?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_017_system_kui_03",
      "hash64": "9AE440F6D8FB5C52",
      "text": "¡Al intentar extraerla, se ha deshecho en\\npedazos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_017_system_kui_04",
      "hash64": "9AE43BF6D8FB53D3",
      "text": "Chiii...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_017_system_kui_05",
      "hash64": "9AE43AF6D8FB5220",
      "text": "Te ha parecido oír una voz misteriosa en la\\ndirección del santuario...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_017_system_release_01",
      "hash64": "7540343DC23ACBCA",
      "text": "Se oye un sonido distante proveniente del\\ninterior del santuario...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_017_system_release_02",
      "hash64": "7540333DC23ACA17",
      "text": "¿Quieres tocar el santuario?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_017_system_release_03",
      "hash64": "7540323DC23AC864",
      "text": "Clin, clin, clin...\\n¡¡Clin, clin, clin, clin!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_017_system_release_07",
      "hash64": "75402E3DC23AC198",
      "text": "¡¡¡Clooonc!!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_017_system_release_04",
      "hash64": "7540313DC23AC6B1",
      "text": "¡¡Yuuu!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_017_system_release_05",
      "hash64": "7540303DC23AC4FE",
      "text": "¡Chi-Yu ha quedado sellado en el santuario\\nde nuevo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_017_system_release_06",
      "hash64": "75402F3DC23AC34B",
      "text": "Parece que la puerta del santuario no podrá\\nabrirse durante un tiempo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_017_system_hokora_01",
      "hash64": "81FC49FF6742A6ED",
      "text": "Hay una inscripción tallada en la entrada al\\nsantuario, apenas legible...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_017_system_hokora_02",
      "hash64": "81FC46FF6742A1D4",
      "text": "\"Aquí residen sellados los Abalorios de la\\nDebacle\".",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_017_system_hokora_03",
      "hash64": "81FC47FF6742A387",
      "text": "\"El sello que retenía a los Abalorios de la\\nDebacle ha sido destruido\".",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
