          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_002_follower_03",
      "hash64": "B85D8FDEF16F5CED",
      "text": "Vuoi tentare un Volo contro il tempo?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_002_follower_04",
      "hash64": "B85D88DEF16F5108",
      "text": "Che livello vuoi affrontare?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_002_follower_05",
      "hash64": "B85D89DEF16F52BB",
      "text": "Principiante? Va bene. Buon divertimento!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_002_follower_06",
      "hash64": "B85D8ADEF16F546E",
      "text": "Intermedio? Va bene. Fai del tuo meglio!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_002_follower_07",
      "hash64": "B85D8BDEF16F5621",
      "text": "Avanzato? Va bene. Metticela tutta!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_002_follower_19",
      "hash64": "B86109DEF1726212",
      "text": "Estremo? Va bene. Non mollare mai!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_002_follower_08",
      "hash64": "B85D84DEF16F4A3C",
      "text": "Dovrai completare un percorso aereo nel\\nBioterarium volando in groppa a un Pokémon.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s2_sub_002_follower_09",
      "hash64": "B85D85DEF16F4BEF",
      "text": "Per passare la prova, devi tagliare il traguardo\\nentro il limite di tempo stabilito.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_002_follower_10",
      "hash64": "B86112DEF172715D",
      "text": "Se passi attraverso gli anelli di Magnemite,\\nguadagnerai del tempo extra.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_002_follower_11",
      "hash64": "B86111DEF1726FAA",
      "text": "Metticela tutta e arriva al traguardo nel minor\\ntempo possibile!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
