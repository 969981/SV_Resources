      "label": "kizuna_ecology_c_06",
      "hash64": "5CC8C9604CAAB963",
      "text": "Here, take these. Consider it my way of saying\\nthanks.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
