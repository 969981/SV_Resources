          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "coach_teacher_language_sp03_07",
      "hash64": "8FDEBC631B1C15D2",
      "text": "Si hay algo que he aprendido con todas mis\\nexperiencias es que en esta vida hay de todo.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "coach_teacher_language_trade_01_00",
      "hash64": "BD448DB5AE365F2D",
      "text": "No es necesario complicarse más de la cuenta:\\nlas cosas más simples son aquellas en las que\\r\\nsiempre podemos confiar. Trust me!\\c\\nPor ejemplo, en la forma en la que interactuamos\\ne intercambiamos vivencias con los demás, es\\r\\nnecesario mantener siempre una actitud flexible.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 226,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 278,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "coach_teacher_language_trade_01_01",
      "hash64": "BD448CB5AE365D7A",
      "text": "Por lo tanto, my dear friend, ¿qué me dices si\\nponemos en práctica este concepto tan básico?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
