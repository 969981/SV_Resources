    },
    {
      "ordinal": 36,
      "label": "coach_teacher_language_sp03_05b",
      "hash64": "9388C46710B2ADCA",
      "text": "Oh, ¿aún no has dado con algo que te inspire?\\nBueno, don't worry.\\c\\nHoy en día, el mundo se mueve a un ritmo\\nvertiginoso. Pero recuerda que no hay prisa;\\r\\nlas cosas llegarán a su debido tiempo.[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
