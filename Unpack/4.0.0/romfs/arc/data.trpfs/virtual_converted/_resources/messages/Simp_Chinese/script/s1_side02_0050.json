        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_side02_0050_camera_03",
      "hash64": "3708F37640AE46B7",
      "text": "好的！在起雾之前，\\n我们就在帐篷里等着吧。[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
