      "label": "s1_side02_0050_camera_04",
      "hash64": "3708F07640AE419E",
      "text": "起雾了！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
