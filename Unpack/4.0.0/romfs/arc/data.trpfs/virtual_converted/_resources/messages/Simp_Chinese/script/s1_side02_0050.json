          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0050_camera_06",
      "hash64": "3708EE7640AE3E38",
      "text": "要是发生了什么意外，\\n就请助手你来当我的保镖咯。[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
