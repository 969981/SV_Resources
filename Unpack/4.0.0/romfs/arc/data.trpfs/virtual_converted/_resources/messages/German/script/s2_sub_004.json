      "hash64": "3977866B72C14C13",
      "text": "Freut euch jetzt schon auf meine nächste Auktion![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
