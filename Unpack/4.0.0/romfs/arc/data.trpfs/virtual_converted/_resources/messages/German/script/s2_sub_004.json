      "ordinal": 24,
      "label": "s2_sub_004_dokuboss_last_02",
      "hash64": "3B6059639E916627",
      "text": "Oh, welch frohe Kunde! Ich bin begeistert![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
