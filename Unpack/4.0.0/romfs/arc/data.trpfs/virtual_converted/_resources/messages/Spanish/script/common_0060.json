    {
      "ordinal": 12,
      "label": "common_0060_head_teacher_03",
      "hash64": "0FF6CBF97A03F9D5",
      "text": "Mira tú por dónde... ¡Parece que has suscitado su\\ncuriosidad![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
