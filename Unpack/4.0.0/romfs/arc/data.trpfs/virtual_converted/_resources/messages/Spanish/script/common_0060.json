            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "common_0060_mama_06",
      "hash64": "3C548BFF337DA337",
      "text": "A ver qué pone en las instrucciones...\\n\"¡Si te pierdes, pulsa el [VAR 0xFF00(0006)]botón Y[VAR 0xFF00(0000)]!\".\\c\\nParece que con eso puedes abrir el mapa...\\nSeguro que te resulta muy útil.\\c\\nCuidadito con perderlo o que se te caiga, ¿eh?[VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
