  "entries": [
    {
      "ordinal": 0,
      "label": "t08_01",
      "hash64": "55B19358443CF0E7",
      "text": "Neveria è la città della neve ed è nota anche\\nper le sue commemorazioni dei defunti.\\c\\nPerò ultimamente è famosa anche per i suoi\\nconcerti.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "t08_02",
      "hash64": "55B19458443CF29A",
      "text": "Come fiocca la neve! E com’è fioca la luce\\ndelle candele! Ogni giorno sembra una festa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "t08_06",
      "hash64": "55B19058443CEBCE",
      "text": "Lo slalom sulla neve è all’ultima moda!\\nPuoi provarlo sulla Sierra Napada, sai?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "t08_08",
      "hash64": "55B18A58443CE19C",
      "text": "Gli Snorunt sono carinissimi, vero?\\nSoltanto gli esemplari femmina possono\\r\\nevolversi in Froslass.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "t08_20",
      "hash64": "55B7FE5844421266",
      "text": "Anche oggi si gela... Meglio scaldarsi mangiando\\nqualcosa di piccante!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "t08_22",
      "hash64": "55B7FC5844420F00",
      "text": "Sai quali sono i panini migliori in assoluto?\\nQuelli che hanno \"master\" nel nome!\\c\\nPeccato che nessuno conosca la ricetta...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "t08_23",
      "hash64": "55B7FD58444210B3",
      "text": "Quando si mangia fuori sembra tutto più buono\\ndel solito!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "t08_26",
      "hash64": "55B80058444215CC",
      "text": "Un anno e mezzo fa la Capopalestra Thyma\\nsi è ritirata e sua sorella minore Lima ha preso\\r\\nil suo posto.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "t08_28",
      "hash64": "55B8065844421FFE",
      "text": "Sei mai stat[VAR 0x1100(00FF,0101)]oa a un concerto di Lima?\\nTi fa tremare fino nell’anima!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "t08_29",
      "hash64": "55B80758444221B1",
      "text": "Il palco viola si illumina quando ci sono gli Esami\\ndella Palestra. È bellissimo!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
