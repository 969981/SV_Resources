      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "coach_paldea_botan_sp02_select_02",
      "hash64": "99D9B8F252E45FC6",
      "text": "Qu’est-ce que tu as découvert ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "coach_paldea_botan_sp02_01",
      "hash64": "3C250C1F2F973FF4",
      "text": "Ah oui ? C’est si évident que ça ?\\nBon... Je te le dis quand même.[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
