          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_paldea_botan_sp02_01b",
      "hash64": "CA332EFDDE010BE2",
      "text": "Tu ne vas pas en croire tes oreilles...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
