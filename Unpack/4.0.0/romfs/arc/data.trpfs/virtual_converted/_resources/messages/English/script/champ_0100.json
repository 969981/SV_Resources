    {
      "ordinal": 2,
      "label": "champ_0100_chairman_03",
      "hash64": "257ACA2918242628",
      "text": "It seems she meant you. I’d guessed as much.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
