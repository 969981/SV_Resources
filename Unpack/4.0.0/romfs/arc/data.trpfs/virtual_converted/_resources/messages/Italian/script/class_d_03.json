          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_d_03_language_07",
      "hash64": "E416134E64740F39",
      "text": "In today’s class, parleremo di un’espressione\\nche deve essere usata al momento giusto![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_d_03_language_08",
      "hash64": "E4161C4E64741E84",
      "text": "Ich liebe dich! Je t’aime! I love you! ¡Te amo!\\nChi mi sa dire cosa significa?[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_d_03_select_01",
      "hash64": "0F3494160C48DAD9",
      "text": "Buon appetito!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_d_03_select_02",
      "hash64": "0F3491160C48D5C0",
      "text": "Ti amo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_d_03_select_03",
      "hash64": "0F3492160C48D773",
      "text": "Devo andare!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_d_03_language_answer_01",
      "hash64": "D58B5916D5CBBB28",
      "text": "Ma no, [VAR 0x0100(0000)]!\\nSe ti metti a mangiare, perdi l’occasione!\\r\\nRisposta sbagliata![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
