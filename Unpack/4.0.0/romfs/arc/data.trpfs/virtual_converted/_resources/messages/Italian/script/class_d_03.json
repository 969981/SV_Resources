          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_03_language_05",
      "hash64": "E416114E64740BD3",
      "text": "Una lesson non può essere a senso unico!\\nNo, non, nein! Altrimenti è too sad...\\r\\ntroppo triste![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
