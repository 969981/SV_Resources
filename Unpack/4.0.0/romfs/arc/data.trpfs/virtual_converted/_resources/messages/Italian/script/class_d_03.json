      ]
    },
    {
      "ordinal": 14,
      "label": "class_d_03_language_answer_02",
      "hash64": "D58B5C16D5CBC041",
      "text": "Eccellente, [VAR 0x0100(0000)]!\\nRisposta very very esatta! Sei [VAR 0x1100(00FF,0202)]illa numero uno![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0202"
          ]
        },
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_d_03_language_answer_03",
      "hash64": "D58B5B16D5CBBE8E",
      "text": "Ma no, [VAR 0x0100(0000)]!\\nNon è quello il momento di andarsene! Anzi!\\r\\nMi dispiace, risposta sbagliata![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
