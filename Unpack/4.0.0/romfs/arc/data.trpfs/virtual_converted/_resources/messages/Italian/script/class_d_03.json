    {
      "ordinal": 0,
      "label": "class_d_03_language_01",
      "hash64": "E416154E6474129F",
      "text": "Miei carissimi studenti! Vi vedo tutti in forma![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
