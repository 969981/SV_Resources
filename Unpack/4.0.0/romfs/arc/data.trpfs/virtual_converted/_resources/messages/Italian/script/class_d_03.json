      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_d_03_language_04",
      "hash64": "E416104E64740A20",
      "text": "Very good![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
