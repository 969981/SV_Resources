      "ordinal": 51,
      "label": "team_0115_nelke_36",
      "hash64": "4DAF12DB987FD988",
      "text": "¡Ejem![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
