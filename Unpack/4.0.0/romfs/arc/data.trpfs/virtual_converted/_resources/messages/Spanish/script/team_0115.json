          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0115_nelke_31",
      "hash64": "4DAF19DB987FE56D",
      "text": "¡Derrota a Casiopea! ¡Vence a la autoridad\\nsuprema del Team Star![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0115_select_07",
      "hash64": "A25339232FC8477F",
      "text": "¡De acuerdo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "team_0115_select_08",
      "hash64": "A2533E232FC84FFE",
      "text": "¡Cuente conmigo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "team_0115_nelke_32",
      "hash64": "4DAF16DB987FE054",
      "text": "Te lo agradezco de corazón. En tus manos lo\\ndejo, entonces.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "team_0115_math_01",
      "hash64": "7499F544469AC463",
      "text": "¡Alto ahí! ¡Os he pescado con las manos en la\\nmasa![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "team_0115_nelke_33",
      "hash64": "4DAF17DB987FE207",
      "text": "Oh, ¿doña Mila? ¿A qué debo tan grata...?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "team_0115_math_02",
      "hash64": "7499F644469AC616",
      "text": "¡No finja sorpresa conmigo![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "team_0115_math_03",
      "hash64": "7499F744469AC7C9",
      "text": "Me han informado de que alguien estaba\\nechando un combate dentro del recinto escolar,\\r\\n¡¿y qué es lo que me encuentro cuando llego?![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "team_0115_math_04",
      "hash64": "7499F844469AC97C",
      "text": "¡Al director de la institución, nada menos,\\ncombatiendo contra un[VAR 0x1100(00FF,0101)]oa de nuestr[VAR 0x1100(00FF,0101)]oas alumn[VAR 0x1100(00FF,0101)]oas!\\c\\n¿Pero es que ha perdido usted el juicio?\\n¡Debería caérsele la cara de vergüenza![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
