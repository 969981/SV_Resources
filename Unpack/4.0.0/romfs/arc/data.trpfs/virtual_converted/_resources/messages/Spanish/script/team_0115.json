          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "team_0115_nelke_39",
      "hash64": "4DAF11DB987FD7D5",
      "text": "No, por favor, eso no... Tenga piedad...[VAR 0x0114(000A)]",
