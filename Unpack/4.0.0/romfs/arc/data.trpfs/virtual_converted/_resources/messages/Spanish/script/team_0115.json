      ]
    },
    {
      "ordinal": 50,
      "label": "team_0115_nelke_35",
      "hash64": "4DAF15DB987FDEA1",
      "text": "¡O-oiga, no se...![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
