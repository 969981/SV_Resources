  "entries": [
    {
      "ordinal": 0,
      "label": "class_f_07_dragon_01",
      "hash64": "689D1FC798109B46",
      "text": "Willkommen zur heutigen Stunde.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_f_07_dragon_02",
      "hash64": "689D1EC798109993",
      "text": "Die Zeit vergeht wirklich wie im Flug![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_f_07_dragon_03",
      "hash64": "689D1DC7981097E0",
      "text": "Auch unsere gemeinsame Zeit saust nur so\\nvorbei... Dies ist bereits unsere letzte Stunde.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_f_07_dragon_04",
      "hash64": "689D24C79810A3C5",
      "text": "Was ich euch heute beibringen werde, mag auf\\nden ersten Blick wenig mit Kunst zu tun haben...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_f_07_dragon_05",
      "hash64": "689D23C79810A212",
      "text": "Jedoch lässt sich nicht so leicht definieren,\\nwas als Kunst zählt und was nicht.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_f_07_dragon_06",
      "hash64": "689D22C79810A05F",
      "text": "Macht euch darüber also erst mal keine\\nGedanken.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_f_07_dragon_07",
      "hash64": "689D21C798109EAC",
      "text": "Heute werdet ihr etwas über Bänder und Zeichen\\nlernen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_f_07_dragon_08",
      "hash64": "689D28C79810AA91",
      "text": "Sowohl Bänder als auch Zeichen sind wie\\nAuszeichnungen für Pokémon.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_f_07_dragon_09",
      "hash64": "689D27C79810A8DE",
      "text": "Wenn ein Pokémon besonders gute Arbeit leistet\\noder besondere Erfahrungen sammelt...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_f_07_dragon_10",
      "hash64": "68999AC7980D8370",
      "text": "Dann kann es als Anerkennung dafür ein Band\\nerhalten.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_f_07_dragon_11",
      "hash64": "68999BC7980D8523",
      "text": "Ein Pokémon, mit dem du besonders eng\\nbefreundet bist, kann zum Beispiel ein\\r\\nZutraulichkeitsband erhalten.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_f_07_dragon_12",
      "hash64": "68999CC7980D86D6",
      "text": "In Garrafosa City gibt es jemanden, der diese\\nBänder verteilt.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_f_07_dragon_13",
      "hash64": "68999DC7980D8889",
      "text": "Bei Zeichen sieht das Ganze etwas anders aus.\\c\\nSie sind bereits an Pokémon zu finden, wenn man\\nihnen zum ersten Mal begegnet.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_f_07_dragon_14",
      "hash64": "68999EC7980D8A3C",
      "text": "Das Raufbold-Zeichen und das Elan-Zeichen\\netwa zeugen vom Wesen eines Pokémon.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_f_07_dragon_15",
      "hash64": "68999FC7980D8BEF",
      "text": "Ob ihr einem Pokémon mit einem Zeichen\\nbegegnet, ist reine Glückssache.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_f_07_dragon_16",
      "hash64": "6899A0C7980D8DA2",
      "text": "Ihr könnt euch also sehr glücklich schätzen,\\nwenn ihr ein Pokémon mit einem Zeichen fangt.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_f_07_dragon_17",
      "hash64": "6899A1C7980D8F55",
      "text": "Und wisst ihr, was ihr mit Pokémon, die Bänder\\noder Zeichen haben, machen könnt?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_f_07_select_01",
      "hash64": "C0657641DF5250AF",
      "text": "Man kann ihre Bänder tauschen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_f_07_select_02",
      "hash64": "C0657741DF525262",
      "text": "Man kann mit ihnen angeben!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "class_f_07_select_03",
      "hash64": "C0657841DF525415",
      "text": "Man kann ihnen einen Titel geben!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "class_f_07_dragon_answer_01",
      "hash64": "EF6D7BA03A2EB6C7",
      "text": "Ah, leider könnt ihr Bänder und Zeichen nicht\\ntauschen oder an andere Pokémon weitergeben.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_f_07_dragon_answer_02",
      "hash64": "EF6D7CA03A2EB87A",
      "text": "In der Tat könnt ihr mit ihnen etwas prahlen. Aber\\ndamit allein solltet ihr euch nicht zufriedengeben![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_f_07_dragon_answer_03",
      "hash64": "EF6D7DA03A2EBA2D",
      "text": "Richtig! Du bist gut informiert, [VAR 0x0100(0000)].[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_f_07_dragon_18",
      "hash64": "6899A2C7980D9108",
      "text": "Pokémon mit Bändern oder Zeichen...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_f_07_dragon_19",
      "hash64": "6899A3C7980D92BB",
      "text": "...können mit einem Titel in den Kampf geschickt\\nwerden![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_f_07_dragon_20",
      "hash64": "68A3ACC79815F68B",
      "text": "Angenommen, ihr habt ein Kaumalat mit einem\\nZutraulichkeitsband.\\c\\nDann könntet ihr es zum Beispiel so in den Kampf\\nschicken: „Los, Herzensfreund Kaumalat!“[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 157,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_f_07_dragon_21",
      "hash64": "68A3ABC79815F4D8",
      "text": "Wie ich bereits sagte, findet man Zeichen in der\\nRegel an Pokémon, wenn man ihnen begegnet.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_f_07_dragon_22",
      "hash64": "68A3AEC79815F9F1",
      "text": "Es scheint allerdings, dass Pokémon in letzter Zeit\\nauch durch ihre Leistungen bestimmte Zeichen\\r\\nerhalten können.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_f_07_dragon_23",
      "hash64": "68A3ADC79815F83E",
      "text": "Das Gourmet-Zeichen, das Aufsammler-Zeichen,\\ndas Partner-Zeichen... und unzählige mehr![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_f_07_dragon_24",
      "hash64": "68A3B0C79815FD57",
      "text": "Der Name eines Zeichens ist oft ein guter erster\\nAnhaltspunkt, um herauszufinden, wofür es steht.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "class_f_07_dragon_25",
      "hash64": "68A3AFC79815FBA4",
      "text": "Damit endet unsere letzte Stunde![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "class_f_07_dragon_26",
      "hash64": "68A3B2C7981600BD",
      "text": "Als Nächstes steht die Abschlussprüfung an.\\c\\nBitte wiederholt das Material gut, damit ihr auch\\nalle beim ersten Versuch besteht.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    }
  ]
}
