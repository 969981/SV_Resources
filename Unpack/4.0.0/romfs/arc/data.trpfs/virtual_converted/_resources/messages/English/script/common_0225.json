          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0225_sitappa_b_01",
      "hash64": "0EE6033AC5DDA50C",
      "text": "Seriously, what’s with you? Don’t you wanna\\nburn bright with awesome friends like us?[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0225_botan_02",
      "hash64": "4C08219FF9AD0D82",
      "text": "...Not really.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0225_sitappa_a_02",
      "hash64": "37B17C2F7B042E76",
      "text": "Look—we’ve got a quota we’re supposed to fill\\nfor new members, so just sign up already![VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0225_botanl_02",
      "hash64": "1575D05F6C1DC3F8",
      "text": "Um... I’d rather not...[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0225_select_01",
      "hash64": "761BE9D65A99502B",
      "text": "Help her out",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_0225_select_02",
      "hash64": "761BEAD65A9951DE",
      "text": "Walk away",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_0225_sitappa_b_02",
      "hash64": "0EE6063AC5DDAA25",
      "text": "Huh? You want in on this, too?[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0225_sitappa_b_03",
      "hash64": "0EE6053AC5DDA872",
      "text": "If you’re here to sign up, we’ll get to you next!\\nWe’ve nearly got this one in the bag![VAR 0x0114(002E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0225_sitappa_a_03",
      "hash64": "37B17D2F7B043029",
      "text": "We’re Team Star, kid. We burn so bright, it hurts\\nto look at us! But you knew that, right?[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0225_sitappa_a_04",
      "hash64": "37B17E2F7B0431DC",
      "text": "So you know exactly who you’re messing with,\\nand you’re still coming at us with that attitude?\\c\\nYou’re scary, kid. If you joined Team Star, you’d\\nbe looking down from the top in no time![VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 188,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0225_sitappa_a_05",
      "hash64": "37B17F2F7B04338F",
      "text": "Ugh, another ignorant little nobody...\\c\\nHere I’m finally part of Team Star, and still I get\\nno respect? I gotta work my way up the ranks...[VAR 0x0114(002D)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0225_sitappa_b_04",
      "hash64": "0EE6003AC5DD9FF3",
      "text": "Hey—we can’t just let something like this slide!\\c\\nThe honor of our team’s on the line, so we’ve got\\nno real choice but to battle, yeah?[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0225_sitappa_a_06",
      "hash64": "37B1802F7B043542",
      "text": "That’s true! You keep watch on that little four-\\neyes over there![VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0225_sitappa_a_07",
      "hash64": "37B1812F7B0436F5",
      "text": "I’ll make sure this fresh-faced nobody ends up\\nseeing stars![VAR 0x0114(002D)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0225_sitappa_a_08",
      "hash64": "37B1822F7B0438A8",
      "text": "Urk, why’s a nobody like you so good at battling,\\nanyway? That’s just not right...[VAR 0x0114(002D)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0225_sitappa_b_05",
      "hash64": "0EE5FF3AC5DD9E40",
      "text": "No way, [VAR 0x1100(00FF,0100)]she beat you?![VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0225_sitappa_b_06",
      "hash64": "0EE6023AC5DDA359",
      "text": "Does that mean I gotta battle this kid now since\\nI’m higher up Team Star’s ranks?![VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_0225_rival_01",
      "hash64": "B93CAA1B985943ED",
      "text": "Pero bueno! What do you think you’re doing?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0225_sitappa_a_09",
      "hash64": "37B1832F7B043A5B",
      "text": "Ugh! It’s that student council dweeb![VAR 0x0114(002D)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "common_0225_sitappa_b_07",
      "hash64": "0EE6013AC5DDA1A6",
      "text": "She’s gonna report us if we don’t book it...[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "common_0225_rival_02",
      "hash64": "B93CA71B98593ED4",
      "text": "I can’t believe you, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "common_0225_rival_03",
      "hash64": "B93CA81B98594087",
      "text": "You don’t have to go find randos to battle! You’ll\\nhave all the battles you’ll ever need...with me![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "common_0225_select_03",
      "hash64": "761BEBD65A995391",
      "text": "That’s really not what happened...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "common_0225_select_04",
      "hash64": "761BECD65A995544",
      "text": "It was those Team Star punks...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "common_0225_rival_04",
      "hash64": "B93CA51B98593B6E",
      "text": "Wait—THEY picked a fight with YOU? Wow, I\\nread that way wrong! Sorry![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "common_0225_rival_05",
      "hash64": "B93CA61B98593D21",
      "text": "I get it now. You two have got Team Star written\\nall over you for sure!\\c\\nI bet you were trying to pressure people into\\nsigning up again, weren’t you?[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 151,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "common_0225_sitappa_b_08",
      "hash64": "0EE60C3AC5DDB457",
      "text": "Ah, hi. We weren’t...not doing that.[VAR 0x0114(002E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "common_0225_rival_06",
      "hash64": "B93CA31B98593808",
      "text": "Well, that explains it.\\c\\nAs head of the student council, stopping this\\ntype of nonsense would normally be MY job...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "common_0225_rival_07",
      "hash64": "B93CA41B985939BB",
      "text": "But this is also the perfect chance for you to try\\nmy amazing and ultra-rare gift to you![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "common_0225_rival_19",
      "hash64": "B940161B985C3148",
      "text": "With this Tera Orb, you can [VAR 0xFF00(0006)]Terastallize[VAR 0xFF00(0000)] your\\nPokémon during battle![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "common_0225_rival_20",
      "hash64": "B9361D1B9853E8A8",
      "text": "Let’s see. After it Terastallizes, I’m pretty sure\\nyour [VAR 0x0101(0001)] will beee...[VAR 0x1302(0002,0000)][VAR 0x0103(0002)] type![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 73,
          "count": 3,
          "code_hex": "1302",
          "args_hex": [
            "0002",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0103",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "common_0225_rival_08",
      "hash64": "B93CA11B985934A2",
      "text": "Normally you’ve gotta take special classes to be\\nable to get one of these Tera Orbs, but I put in\\r\\na good word for you![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "common_0225_rival_09",
      "hash64": "B93CA21B98593655",
      "text": "Now, time to give it a whirl! You’ll learn to use it\\nfaster in battle than if I just explain it to you![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
