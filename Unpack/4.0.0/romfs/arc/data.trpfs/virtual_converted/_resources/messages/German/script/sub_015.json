  "entries": [
    {
      "ordinal": 0,
      "label": "sub_015_system_kui_01",
      "hash64": "CBD71E33F4417D1E",
      "text": "Hier steckt ein unheilvoll anmutender schwarzer\\nPfahl im Boden...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_015_system_kui_02",
      "hash64": "CBD71D33F4417B6B",
      "text": "Möchtest du ihn herausziehen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_015_system_kui_03",
      "hash64": "CBD71C33F44179B8",
      "text": "Als du den Pfahl aus dem Boden ziehst,\\nzerfällt er und löst sich in Luft auf!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_015_system_kui_04",
      "hash64": "CBD72333F441859D",
      "text": "Baaa...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_015_system_kui_05",
      "hash64": "CBD72233F44183EA",
      "text": "Aus Richtung des Schreins ertönt ein seltsamer\\nRuf...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_015_system_release_01",
      "hash64": "2F7176EB24844F78",
      "text": "Leise Geräusche dringen aus dem Inneren des\\nSchreins hervor...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_015_system_release_02",
      "hash64": "2F7179EB24845491",
      "text": "Möchtest du den Schrein berühren?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_015_system_release_03",
      "hash64": "2F7178EB248452DE",
      "text": "*ratter* *ratter*\\n*rumpel* *rumpel*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_015_system_release_07",
      "hash64": "2F717CEB248459AA",
      "text": "*RUMMS*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_015_system_release_04",
      "hash64": "2F717BEB248457F7",
      "text": "Bao! Bao!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_015_system_release_05",
      "hash64": "2F717AEB24845644",
      "text": "Baojian wurde erneut im Schrein versiegelt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_015_system_release_06",
      "hash64": "2F717DEB24845B5D",
      "text": "Offenbar wird es etwas dauern, bis sich das Tor\\ndes Schreins wieder öffnet.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_015_system_hokora_01",
      "hash64": "375C3504754E3827",
      "text": "Auf dem Schrein ist etwas kaum Leserliches\\neingraviert...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_015_system_hokora_02",
      "hash64": "375C3604754E39DA",
      "text": "AN DIESEM ORT WURDE DAS\\nUNHEILSSCHWERT VERSIEGELT.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_015_system_hokora_03",
      "hash64": "375C3704754E3B8D",
      "text": "DAS SIEGEL DES UNHEILSSCHWERTS WURDE\\nGEBROCHEN.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
