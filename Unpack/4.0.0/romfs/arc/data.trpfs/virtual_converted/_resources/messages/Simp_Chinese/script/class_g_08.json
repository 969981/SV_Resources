      ]
    },
    {
      "ordinal": 1,
      "label": "class_g_08_math_02",
      "hash64": "D651E3C1B9BC66C0",
      "text": "趁着抱佛脚恶补的东西还没忘光，\\n赶快开始考试好了。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
