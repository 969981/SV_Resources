          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_g_08_question_01",
      "hash64": "400AF5B61D2C06F3",
      "text": "１　以下哪种食力会更容易\\n　　遇到异色宝可梦？\\n\\n・闪耀力　・遭遇力\\n・捕获力",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "class_g_08_ansewer_01a",
      "hash64": "E6F26225A506E7B7",
      "text": "闪耀力",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_g_08_ansewer_01b",
      "hash64": "E6F26325A506E96A",
      "text": "遭遇力",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_g_08_ansewer_01c",
      "hash64": "E6F26425A506EB1D",
      "text": "捕获力",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "class_g_08_question_02",
      "hash64": "400AF6B61D2C08A6",
      "text": "２　以下哪个不是蛋蛋力的效果？\\n\\n・蛋会孵得更快\\n・更容易孵出强大的宝可梦\\n・更容易发现蛋",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "class_g_08_ansewer_02a",
      "hash64": "E6FC5225A50F210C",
      "text": "蛋会孵得更快",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_g_08_ansewer_02b",
      "hash64": "E6FC5525A50F2625",
      "text": "更容易孵出强大的宝可梦",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "class_g_08_ansewer_02c",
      "hash64": "E6FC5425A50F2472",
      "text": "更容易发现蛋",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_g_08_question_03",
      "hash64": "400AF7B61D2C0A59",
      "text": "３　为了提升食力的效果，\\n　　很容易做到，且很重要的事是？\\n\\n・多多烹调　　・在家烹调\\n・大家一起烹调",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_g_08_ansewer_03a",
      "hash64": "E6F86E25A50B67C9",
      "text": "多多烹调",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_g_08_ansewer_03b",
      "hash64": "E6F86B25A50B62B0",
      "text": "在家烹调",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_g_08_ansewer_03c",
      "hash64": "E6F86C25A50B6463",
      "text": "大家一起烹调",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_g_08_question_04",
      "hash64": "400AF8B61D2C0C0C",
      "text": "４　当可爱的宝可梦变得脏兮兮时，\\n　　应该采取的行动是？\\n\\n・宝可梦洗澡澡　・宝可梦急冲冲\\n・宝可梦许愿愿",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_g_08_ansewer_04a",
      "hash64": "E6E76E25A4FCF496",
      "text": "宝可梦洗澡澡",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "class_g_08_ansewer_04b",
      "hash64": "E6E76D25A4FCF2E3",
      "text": "宝可梦急冲冲",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_g_08_ansewer_04c",
      "hash64": "E6E76C25A4FCF130",
      "text": "宝可梦许愿愿",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_g_08_question_05",
      "hash64": "400AF9B61D2C0DBF",
      "text": "５　本题出自学院校规。\\n　　制服的上装和下装\\n　　应该配合季节换穿吗？\\n\\n・应该　・都可以",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "class_g_08_ansewer_05a",
      "hash64": "E6E44A25A4FA8193",
      "text": "应该",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "class_g_08_ansewer_05b",
      "hash64": "E6E44B25A4FA8346",
      "text": "都可以",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "class_g_08_math_03",
      "hash64": "D651E4C1B9BC6873",
      "text": "答题时间到此结束。\\n请停笔。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_g_08_math_04",
      "hash64": "D651E9C1B9BC70F2",
      "text": "……诸位当中有人让吾辈\\n学到了手机洛托姆换装的事，\\r\\n所以吾辈就让试题稍微容易了一点。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_g_08_math_05",
      "hash64": "D651EAC1B9BC72A5",
      "text": "各位为了不补考，\\n都发挥出全部实力了吧。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_g_08_math_06",
      "hash64": "D651E7C1B9BC6D8C",
      "text": "请到前台问过\\n自己的分数后再回家。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
