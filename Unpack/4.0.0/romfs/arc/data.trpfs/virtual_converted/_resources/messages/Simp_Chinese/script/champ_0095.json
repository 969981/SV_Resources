        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0095_rival_03",
      "hash64": "FEF122A04EC9A80C",
      "text": "上次没能和你对战，\\n对不起啊。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
