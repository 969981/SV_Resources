    {
      "ordinal": 1,
      "label": "champ_0095_rival_02",
      "hash64": "FEF123A04EC9A9BF",
      "text": "我看见你走进道馆了，\\n于是就跑着追了过来！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
