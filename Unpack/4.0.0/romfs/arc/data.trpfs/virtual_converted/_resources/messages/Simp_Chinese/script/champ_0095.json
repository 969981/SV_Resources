      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0095_rival_07",
      "hash64": "FEF11EA04EC9A140",
      "text": "陪我一小会儿就好啦！\\n我只上３只宝可梦！这样总行了吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0095_rival_08",
      "hash64": "FEF12DA04EC9BABD",
      "text": "我要配合[VAR 0x0100(0000)]你现在的实力，\\n用刚刚好的宝可梦来对战～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
