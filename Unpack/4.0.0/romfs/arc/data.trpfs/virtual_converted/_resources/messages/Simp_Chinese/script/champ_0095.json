      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "champ_0095_rival_06",
      "hash64": "FEF11FA04EC9A2F3",
      "text": "太好了！能和[VAR 0x0100(0000)]你对战，\\n我真是太高兴啦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
