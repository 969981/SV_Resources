          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_039_steel_03",
      "hash64": "794C3AF237DE3122",
      "text": "[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳成為冠軍後，\\n烏栗他就不再參加排行榜了。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_039_steel_04",
      "hash64": "794C35F237DE28A3",
      "text": "雖然有點寂寞，\\n但並非從此見不到他。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_039_steel_05",
      "hash64": "794C34F237DE26F0",
      "text": "比起這個，納莉我……\\n很高興他變回了以前的他。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_039_steel_06",
      "hash64": "794C37F237DE2C09",
      "text": "納莉我實在太高興了，\\n一失神就調合了大量的藥丸。\\r\\n就是挑戰時用來飛行的那種。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_039_steel_12",
      "hash64": "7948B1F237DB1280",
      "text": "[VAR 0x1100(00FF,0101)]你妳想飛的時候，\\n請適量地給啊嘎嘶牠吃吧。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_039_legend_01",
      "hash64": "0D2282BD495E0C0C",
      "text": "嘎～嘶。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_039_legend_02",
      "hash64": "0D2285BD495E1125",
      "text": "呼嚕呼嚕！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s2_sub_039_steel_13",
      "hash64": "7948B2F237DB1433",
      "text": "呃，剛才……？\\n該怎麼說？不行。\\r\\n一口氣吃那麼多的話……[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_039_legend_03",
      "hash64": "0D2284BD495E0F72",
      "text": "啊嗄～嘶！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_039_system_01",
      "hash64": "1EA3E8AF2CA275D4",
      "text": "[VAR 0x0101(0001)]\\n學會了坐騎招式：飛行！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_039_steel_07",
      "hash64": "794C36F237DE2A56",
      "text": "牠好像……\\n能力增強了。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_039_steel_08",
      "hash64": "794C41F237DE3D07",
      "text": "估計牠是變得\\n隨時都可以飛行了？\\r\\n嗯，這樣也無妨……[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_039_steel_09",
      "hash64": "794C40F237DE3B54",
      "text": "納莉我為飛翔計時賽\\n新設計了超級賽道，\\r\\n如果[VAR 0x1100(00FF,0101)]你妳對飛行技巧有自信的話，歡迎嘗試。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_039_steel_10",
      "hash64": "7948B3F237DB15E6",
      "text": "只要完成飛翔計時賽的高級賽道，\\n就可以挑戰超級賽道。\\c\\n如果[VAR 0x1100(00FF,0101)]你妳對飛行技巧有自信的話，歡迎嘗試。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_039_steel_11",
      "hash64": "7948B4F237DB1799",
      "text": "……時間到。再見。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
