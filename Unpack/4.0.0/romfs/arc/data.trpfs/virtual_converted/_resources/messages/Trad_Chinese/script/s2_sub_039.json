    {
      "ordinal": 1,
      "label": "s2_sub_039_steel_02",
      "hash64": "794C3BF237DE32D5",
      "text": "聯盟社的事……還有烏栗的事，\\n我很感謝[VAR 0x1100(00FF,0101)]你妳。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
