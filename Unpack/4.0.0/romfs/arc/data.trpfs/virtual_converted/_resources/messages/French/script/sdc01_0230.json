{
  "version": "4.0.0",
  "language": "fr",
  "language_raw": "French",
  "source": "message/dat/French/script/sdc01_0230.dat",
  "paired_tbl": "message/dat/French/script/sdc01_0230.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0230_gfather_01",
      "hash64": "B61F513772593802",
      "text": "C’est une histoire un peu longue.\\nEs-tu prêt[VAR 0x1100(00FF,0100)]e à l’écouter ?[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0230_gfather_02",
      "hash64": "B61F50377259364F",
      "text": "Préviens-moi quand tu te seras décidé[VAR 0x1100(00FF,0100)]e.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0230_gfather_03",
      "hash64": "B61F4F377259349C",
      "text": "Cette histoire, transmise oralement au sein de\\nnotre famille, m’a été racontée par mon père.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0230_gfather_04",
      "hash64": "B61F4E37725932E9",
      "text": "Elle dévoile la vérité sur le Monstre... Une vérité\\nqui ne doit pas être révélée au reste du village.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0230_gfather_05",
      "hash64": "B61F4D3772593136",
      "text": "Vous ne devez donc en parler à personne !\\nC’est bien clair ?[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0230_sister_01",
      "hash64": "58DB3930F6695A99",
      "text": "Oui...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0230_history_01",
      "hash64": "487E69A94330FA57",
      "text": "Il y a fort longtemps, un homme et un monstre\\nvenus d’un pays lointain arrivèrent à Septentria.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0230_history_02",
      "hash64": "487E6AA94330FC0A",
      "text": "L’apparence inhabituelle de ces inconnus effraya\\nles gens du village...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0230_history_03",
      "hash64": "487E6BA94330FDBD",
      "text": "Ces derniers décidèrent donc d’en interdire\\nl’accès à l’Homme et au Monstre.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0230_history_04",
      "hash64": "487E64A94330F1D8",
      "text": "Les deux visiteurs furent attristés de constater\\nqu’ils n’étaient pas les bienvenus.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0230_history_05",
      "hash64": "487E65A94330F38B",
      "text": "Leur compagnie mutuelle suffisant à leur bonheur,\\nils s’installèrent dans une grotte de montagne.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0230_history_06",
      "hash64": "487E66A94330F53E",
      "text": "Seule une personne éprouva de la compassion\\npour eux : un fabricant de masques.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0230_history_07",
      "hash64": "487E67A94330F6F1",
      "text": "Celui-ci confectionna plusieurs masques\\npour l’Homme et le Monstre.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0230_history_08",
      "hash64": "487E60A94330EB0C",
      "text": "Ces chefs-d’œuvre étaient sertis de gemmes\\nque l’Homme avait rapportées de sa terre natale.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0230_history_09",
      "hash64": "487E61A94330ECBF",
      "text": "En portant ces masques, l’Homme et le Monstre\\npurent cacher leur visage et se mêler aux autres.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0230_history_10",
      "hash64": "4881EEA94334122D",
      "text": "Ils étaient tous deux comblés et très touchés\\npar la gentillesse de l’artisan.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0230_history_11",
      "hash64": "4881EDA94334107A",
      "text": "C’est ainsi qu’ils participèrent aux fêtes\\ndu village, dissimulés sous leurs masques.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0230_history_12",
      "hash64": "4881ECA943340EC7",
      "text": "Ils acquirent une certaine notoriété grâce à\\nleurs masques, qui suscitaient l’admiration.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0230_history_13",
      "hash64": "4881EBA943340D14",
      "text": "Leur renommée dépassa même les frontières\\nde la région.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0230_history_14",
      "hash64": "4881EAA943340B61",
      "text": "Mais la rumeur de l’existence de telles\\nœuvres d’art attisa aussi la convoitise...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0230_history_15",
      "hash64": "4881E9A9433409AE",
      "text": "Une bande de Pokémon avides fit ainsi irruption\\nà Septentria.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0230_history_16",
      "hash64": "4881E8A9433407FB",
      "text": "Ceux-ci se faufilèrent dans le repaire\\nde l’Homme et du Monstre...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0230_history_17",
      "hash64": "4881E7A943340648",
      "text": "Ils tentèrent de s’emparer des masques\\nqui y étaient précieusement conservés.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0230_history_18",
      "hash64": "4881E6A943340495",
      "text": "L’Homme, qui les prit sur le fait, parvint tant\\nbien que mal à protéger l’un des masques.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0230_history_19",
      "hash64": "4881E5A9433402E2",
      "text": "Mais hélas, à bout de force, il ne put empêcher\\nles Pokémon de s’emparer des trois autres...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0230_history_20",
      "hash64": "488554A94336F556",
      "text": "Peu de temps après, le Monstre revint dans\\nla grotte...[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0230_history_21",
      "hash64": "488555A94336F709",
      "text": "Il n’y trouva qu’un masque turquoise, et des\\ntraces indiquant qu’un affrontement avait eu lieu.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0230_history_22",
      "hash64": "488552A94336F1F0",
      "text": "Certainement inquiet pour son ami, le Monstre\\nrevêtit le masque et descendit de la montagne.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0230_history_23",
      "hash64": "488553A94336F3A3",
      "text": "Il vit les vils Pokémon parader avec leur butin\\net il les attaqua, aveuglé par la colère.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0230_history_24",
      "hash64": "488558A94336FC22",
      "text": "Au village, personne ne savait ce qu’il s’était\\nréellement passé dans la montagne.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0230_history_25",
      "hash64": "488559A94336FDD5",
      "text": "Mais tout le monde prit peur devant la fureur\\ndu Monstre.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0230_history_26",
      "hash64": "488556A94336F8BC",
      "text": "On crut à tort que les trois Pokémon avaient\\ncombattu le Monstre pour protéger le village.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0230_history_27",
      "hash64": "488557A94336FA6F",
      "text": "Le trio fut renommé « les Adoramis », et on leur\\noffrit une sépulture en signe de gratitude.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_0230_history_28",
      "hash64": "48855CA9433702EE",
      "text": "Blessé et accablé par la tristesse, le Monstre\\nretourna seul dans sa grotte.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_0230_history_29",
      "hash64": "48855DA9433704A1",
      "text": "[EMPTY 35]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0023"
          ]
        }
      ]
    }
  ]
}
