    {
      "ordinal": 21,
      "label": "sub_002_trainer_23",
      "hash64": "6223FEC782EB8CC0",
      "text": "Bei dir, Neuzugang, kann ich mich auch ein\\nbisschen ins Zeug legen. Immerhin möchte ich,\\r\\ndass du dir hohe Ziele steckst![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
