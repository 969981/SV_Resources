    {
      "ordinal": 26,
      "label": "sub_002_trainer_27",
      "hash64": "622402C782EB938C",
      "text": "Bei dir, Neuzugang, kann ich mich auch noch\\netwas mehr ins Zeug legen. Immerhin möchte ich,\\r\\ndass du es noch weiter nach oben schaffst![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
