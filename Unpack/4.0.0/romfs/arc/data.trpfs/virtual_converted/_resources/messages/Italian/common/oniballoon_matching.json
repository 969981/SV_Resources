      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "oniballoon_matching_msg_01_02",
      "hash64": "48AFF97594F6B96F",
      "text": "Vuoi giocare con questi partecipanti?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "oniballoon_matching_msg_02_00",
      "hash64": "7719798DA1EC3CC2",
      "text": "Vuoi sciogliere la squadra?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "oniballoon_matching_msg_03_00",
      "hash64": "1F6D2F86056CE033",
      "text": "Non tutti i partecipanti sono pronti.\\nAttendi un po’ e riprova.",
