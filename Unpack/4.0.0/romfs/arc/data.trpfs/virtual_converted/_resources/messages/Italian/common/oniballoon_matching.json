      "text": "Sì",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "oniballoon_matching_con_00_01",
      "hash64": "79E59B9EB0672DF2",
      "text": "No",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "oniballoon_entrynpc_01",
      "hash64": "4B3DD23D885F6D3A",
      "text": "Benvenut[VAR 0x1100(00FF,0101)]oa! Che ne dici di giocare alla caccia\\nall’orco?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "oniballoon_entrynpc_02",
      "hash64": "4B3DD13D885F6B87",
      "text": "Allora si comincia! Buona caccia!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "oniballoon_entrynpc_03",
      "hash64": "4B3DD03D885F69D4",
      "text": "Ci si vede alla prossima!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "oniballoon_entrynpc_04",
      "hash64": "4B3DCF3D885F6821",
      "text": "Hai completato la modalità facile! Brav[VAR 0x1100(00FF,0101)]oa!\\c\\nDato che è la prima volta, meriti un premio\\nper festeggiare!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "oniballoon_entrynpc_05",
      "hash64": "4B3DCE3D885F666E",
      "text": "Direi che un[VAR 0x1100(00FF,0101)]oa come te ce la farebbe\\ntranquillamente anche con la modalità normale!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "oniballoon_entrynpc_06",
      "hash64": "4B3DCD3D885F64BB",
      "text": "Hai completato la modalità normale! Brav[VAR 0x1100(00FF,0101)]oa!\\c\\nDato che è la prima volta, meriti un premio\\nper festeggiare!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
