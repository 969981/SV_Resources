          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_side01_0110_brother_02",
      "hash64": "D866F7954CC0E4D4",
      "text": "¡¿Qué estáis haciendo aquí?! ¡¿Corin está bien?!\\nY... y... ¡¿habéis visto pasar a una chica?![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_side01_0110_gfather_02",
      "hash64": "1897B67FB586965F",
      "text": "Pero bueno, ¿a qué vienen esos aspavientos?[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0110_gfather_03",
      "hash64": "1897B57FB58694AC",
      "text": "Tu hermana está en su cuarto, durmiendo como\\nun tronco. Quizá rendida después de tanto baile.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0110_brother_03",
      "hash64": "D866F8954CC0E687",
      "text": "Uf, menos mal.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0110_gfather_04",
      "hash64": "1897B47FB58692F9",
      "text": "Mientras descansa, hemos venido a comprarle\\nunos fideos de esos que tanto le gustan.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0110_gfather_05",
      "hash64": "1897B37FB5869146",
      "text": "A ver si eso la reconforta y nos vuelve a ser la\\nde antes.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0110_brother_04",
      "hash64": "D866F5954CC0E16E",
      "text": "Ya veo... Sí, seguro que le sentarán bien.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side01_0110_gfather_06",
      "hash64": "1897B27FB5868F93",
      "text": "Por cierto... ¿Qué decías de si habíamos visto\\npasar a alguien?[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0110_brother_05",
      "hash64": "D866F6954CC0E321",
      "text": "Ah... ¡Sí, es verdad! Es que en la villa está\\npasando algo muy raro...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0110_brother_06",
      "hash64": "D866F3954CC0DE08",
      "text": "Y una chica que había venido de Paldea se ha\\nesfumado de repente.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
