    {
      "ordinal": 2,
      "label": "gym_esper_010_receptionist_03",
      "hash64": "DCED079906C25810",
      "text": "Great! Now, in order to face Gym Leader Tulip,\\nyou’ll first need to pass the Gym Test.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
