    {
      "ordinal": 0,
      "label": "champ_0150_rival_01",
      "hash64": "7BBAD89943FDFD56",
      "text": "[VAR 0x0100(0000)]！[VAR 0x0101(0001)]！\\n恭喜！我好高興啊！棒極了！！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
