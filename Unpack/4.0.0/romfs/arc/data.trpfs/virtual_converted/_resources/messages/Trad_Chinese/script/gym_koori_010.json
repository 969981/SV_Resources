    {
      "ordinal": 2,
      "label": "gym_koori_010_receptionist_03",
      "hash64": "C2D8D031076D1D59",
      "text": "想和本道館的館主古魯夏對戰，\\n就必須先通過道館測驗。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_koori_010_receptionist_04",
      "hash64": "C2D8D131076D1F0C",
      "text": "霜抹山道館的道館測驗是……\\n[VAR 0xFF00(0006)]滑雪山[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
