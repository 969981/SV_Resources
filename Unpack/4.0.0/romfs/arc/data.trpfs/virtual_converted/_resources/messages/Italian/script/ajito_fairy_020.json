      "hash64": "41A183A20EE70831",
      "text": "Rotoroto-rotoroto-rotoroto...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "ajito_fairy_020_cassiopeia_01",
      "hash64": "32422C00E4F946BF",
      "text": "Sei riuscit[VAR 0x1100(00FF,0101)]oa a eludere la sorveglianza?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
