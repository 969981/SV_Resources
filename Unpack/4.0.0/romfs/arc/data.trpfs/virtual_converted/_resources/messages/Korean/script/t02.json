          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "t02_03",
      "hash64": "B8FB95ABB6AED9B7",
      "text": "꿀꺽꿀꺽...\\n아~ 시원해!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "t02_04",
      "hash64": "B8FB92ABB6AED49E",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "t02_07",
      "hash64": "B8FB91ABB6AED2EB",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "t02_08",
      "hash64": "B8FB8EABB6AECDD2",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "t02_09",
      "hash64": "B8FB8FABB6AECF85",
      "text": "마비치료제가 도착했단다!\\n포켓몬의 마비 상태를 치료해 주는 도구지!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "t02_10",
      "hash64": "B8FEFCABB6B1BE93",
      "text": "배틀에 먼저 내보내는 건\\n지닌 포켓몬의 선두에 있는 포켓몬이야.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "t02_11",
      "hash64": "B8FEFBABB6B1BCE0",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "t02_12",
      "hash64": "B8FEFEABB6B1C1F9",
      "text": "그 교복을 보니 학생인가 보구나?\\c\\n포켓몬은 6마리까지 지닐 수 있으니까\\n최대한 많이 데리고 다니도록 하렴.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "t02_13",
      "hash64": "B8FEFDABB6B1C046",
      "text": "나는 학교에서\\n포켓몬에 대해 공부하고 있어!\\c\\n포켓몬은 기술을\\n4개까지 배울 수 있대~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "t02_14",
      "hash64": "B8FF00ABB6B1C55F",
      "text": "플라토마을에 사는 학생들은\\n기숙사가 아니라 집에서 통학하고 있어!\\r\\n언덕길 때문에 힘들긴 하지만...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "t02_15",
      "hash64": "B8FEFFABB6B1C3AC",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "t02_17",
      "hash64": "B8FF01ABB6B1C712",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "t02_21",
      "hash64": "B8F48BABB6A8AA0B",
      "text": "패리퍼는 소포나 편지를\\n부리에 넣고 운반한대!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "t02_22",
      "hash64": "B8F48CABB6A8ABBE",
      "text": "N/A",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "t02_23",
      "hash64": "B8F48DABB6A8AD71",
      "text": "학교에 가니?\\c\\n조심히 다녀오렴!\\n리포트 틈틈이 쓰는 거 잊지 말고!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "t02_24",
      "hash64": "B8F48EABB6A8AF24",
      "text": "여기는 플라토마을.\\n가볍게 들를 수 있는 평온한 마을이지.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
