    {
      "ordinal": 4,
      "label": "t02_01",
      "hash64": "B8FB97ABB6AEDD1D",
      "text": "포켓몬센터는\\n친구와 약속 장소로 참 좋단다~",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "t02_02",
      "hash64": "B8FB94ABB6AED804",
      "text": "[EMPTY 22]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
