          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_004_dokuboss_09",
      "hash64": "3977866B72C14C13",
      "text": "Spero di poter contare sul tuo supporto anche\\nnelle aste venture.[VAR 0x0114(0023)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_sub_004_dokuboss_last_01",
      "hash64": "3B605A639E9167DA",
      "text": "Poffarbacco! Con questo hai fatto tuo financo\\nl’ultimo articolo della mia collezione![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_sub_004_dokuboss_last_02",
      "hash64": "3B6059639E916627",
      "text": "Il mio cuore trabocca di gratitudine!\\nChe gaudio immenso![VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
