    },
    {
      "ordinal": 4,
      "label": "champ_0140_rival_05",
      "hash64": "64AB6EAB5FD63085",
      "text": "A proposito, potrei proprio venire con lei\\na fare il tifo per te![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
