        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0140_rival_04",
      "hash64": "64AB6DAB5FD62ED2",
      "text": "Del resto, persino la Supercampionessa\\nè interessata al tuo percorso![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
