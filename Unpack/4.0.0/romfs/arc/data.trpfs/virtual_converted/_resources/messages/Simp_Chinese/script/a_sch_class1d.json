    {
      "ordinal": 7,
      "label": "a_sch_class1d_ni01",
      "hash64": "5501833A02E03C8A",
      "text": "两手都有喵喵！\\n被喜欢的宝可梦围住的感觉，\\r\\n太、幸、福、了……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
