  "entries": [
    {
      "ordinal": 0,
      "label": "sub_016_system_kui_01",
      "hash64": "4C38F1CE9AE28A93",
      "text": "Conficcato nel terreno c’è un paletto nero\\ndall’aria sinistra...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_016_system_kui_02",
      "hash64": "4C38F2CE9AE28C46",
      "text": "Vuoi estrarre il paletto?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_016_system_kui_03",
      "hash64": "4C38F3CE9AE28DF9",
      "text": "Appena l’hai estratto, il paletto si è\\nsgretolato ed è scomparso!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_016_system_kui_04",
      "hash64": "4C38F4CE9AE28FAC",
      "text": "Chieeen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_016_system_kui_05",
      "hash64": "4C38F5CE9AE2915F",
      "text": "Si è sentito uno strano verso provenire dal\\nsantuario...!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_016_system_release_01",
      "hash64": "0D38A4AA29FEC449",
      "text": "Dal santuario proviene un debole suono...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_016_system_release_02",
      "hash64": "0D38A1AA29FEBF30",
      "text": "Vuoi toccare il santuario?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_016_system_release_03",
      "hash64": "0D38A2AA29FEC0E3",
      "text": "Rattle rattle...\\nRATTLE RATTLE RATTLE RATTLE...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_016_system_release_07",
      "hash64": "0D38A6AA29FEC7AF",
      "text": "CLANG!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_016_system_release_04",
      "hash64": "0D38A7AA29FEC962",
      "text": "Woooo!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_016_system_release_05",
      "hash64": "0D38A8AA29FECB15",
      "text": "Wo-Chien è stato nuovamente sigillato\\nnel santuario!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_016_system_release_06",
      "hash64": "0D38A5AA29FEC5FC",
      "text": "Sembra che le porte del santuario non si\\napriranno per un po’.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_016_system_hokora_01",
      "hash64": "5E2F0FED1EB3D91C",
      "text": "Sull’entrata del santuario c’è un’incisione\\nappena visibile...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_016_system_hokora_02",
      "hash64": "5E2F12ED1EB3DE35",
      "text": "\"QUI SONO RINCHIUSE LE TAVOLETTE DI\\nLEGNO PORTATRICI DI SCIAGURA\"",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_016_system_hokora_03",
      "hash64": "5E2F11ED1EB3DC82",
      "text": "\"IL SIGILLO DELLE TAVOLETTE NEFASTE\\nÈ STATO SPEZZATO\"",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
