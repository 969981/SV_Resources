      ]
    },
    {
      "ordinal": 1,
      "label": "legend_0010_friend_02",
      "hash64": "48998F65A9C2CF90",
      "text": "Weißt du noch, wer ich bin?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "legend_0010_select_01",
      "hash64": "4404085C47A20589",
      "text": "Der vom Leuchtturm!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "legend_0010_select_02",
      "hash64": "4404055C47A20070",
      "text": "Kennen wir uns...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "legend_0010_friend_02a",
      "hash64": "1FBE9ABF76075683",
      "text": "Ganz genau. Dein Erinnerungsvermögen kann sich\\nsehen lassen![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "legend_0010_friend_02b",
      "hash64": "1FBE9BBF76075836",
      "text": "Echt jetzt?! Ich hab dir doch den Pokéball von\\n[VAR 0x0101(0001)] gegeben!\\c\\nHatte ich mich da etwa gar nicht vorgestellt...?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "legend_0010_friend_03",
      "hash64": "48999065A9C2D143",
      "text": "Ich heiße Pepper![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "legend_0010_friend_04",
      "hash64": "48999565A9C2D9C2",
      "text": "Du brauchst dich nicht vorzustellen. Dein Name\\nist [VAR 0x0100(0000)], stimmt’s?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "legend_0010_friend_05",
      "hash64": "48999665A9C2DB75",
      "text": "Die ganze Akademie redet über dich, weil du\\nzusammen mit der Schulsprecherin hier\\r\\naufgekreuzt bist.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "legend_0010_friend_06",
      "hash64": "48999365A9C2D65C",
      "text": "Normalerweise setze ich keinen Fuß in die\\nAkademie. Aber ich hab extra eine Ausnahme\\r\\ngemacht, um dich kleine Berühmtheit zu treffen![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "legend_0010_friend_07",
      "hash64": "48999465A9C2D80F",
      "text": "Ich hätte da nämlich eine Bitte...\\c\\nKönntest du mir deine Stärke leihen, um meine\\nTräume Wirklichkeit werden zu lassen?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "legend_0010_select_03",
      "hash64": "4404065C47A20223",
      "text": "Klar doch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "legend_0010_select_04",
      "hash64": "44040B5C47A20AA2",
      "text": "Wovon redest du?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "legend_0010_friend_08",
      "hash64": "48999965A9C2E08E",
      "text": "Ich hab doch noch gar nicht gesagt, worum es\\ngeht! Bist du immer so [VAR 0x1100(00FF,0E0B,0000)]ein Jasagereine Jasagerin?![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0E0B",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "legend_0010_friend_09",
      "hash64": "48999A65A9C2E241",
      "text": "Hehe! Da hab ich dich neugierig gemacht, was?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "legend_0010_friend_10",
      "hash64": "489C9765A9C512FF",
      "text": "Das wird dich jetzt vielleicht überraschen,\\naber ich liebe Picknicks! Und in der Küche\\r\\nstell ich mich auch nicht schlecht an.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "legend_0010_friend_11",
      "hash64": "489C9665A9C5114C",
      "text": "Ich recherchiere im Moment Gerichte,\\ndie Pokémon wieder gesund machen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "legend_0010_friend_12",
      "hash64": "489C9965A9C51665",
      "text": "Letztens habe ich in einem Buch ein Kapitel\\nüber Gewürze gelesen, die einen ganz flott fit\\r\\nmachen sollen, wenn man sie zu sich nimmt.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "legend_0010_friend_13",
      "hash64": "489C9865A9C514B2",
      "text": "Sie werden Geheimgewürze genannt![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "legend_0010_friend_14",
      "hash64": "489C9365A9C50C33",
      "text": "Von diesen Geheimgewürzen soll es insgesamt\\nfünf verschiedene Arten geben.\\c\\nMan braucht nur an dem Gewürzpulver zu lecken\\nund schwupp! Der Körper erhält Nährstoffe!\\r\\nDer Kreislauf kommt in Schwung!\\r\\nDer Alterungsprozess wird verlangsamt!\\r\\nUnd das Immunsystem wird gestärkt![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 166,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 201,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 243,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 281,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "legend_0010_friend_15",
      "hash64": "489C9265A9C50A80",
      "text": "Angeblich soll es diese Gewürze nur hier in\\nPaldea geben. Und sie sind superselten![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "legend_0010_friend_16",
      "hash64": "489C9565A9C50F99",
      "text": "Aber die Geheimgewürze werden wohl von\\nsogenannten Herrscher-Pokémon bewacht.\\c\\nDeshalb bekommt man sie nicht so leicht in die\\nFinger![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "legend_0010_friend_24",
      "hash64": "4892A165A9BCCF78",
      "text": "Ich könnte mir vorstellen, dass diese\\nHerrscher-Pokémon ungefähr... so aussehen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "legend_0010_friend_17",
      "hash64": "489C9465A9C50DE6",
      "text": "Ich würd die Gewürze ja gerne selbst beschaffen,\\naber Pokémon-Kämpfe sind nicht meine Stärke...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "legend_0010_friend_18",
      "hash64": "489C9F65A9C52097",
      "text": "Freunde mit starken Pokémon hab ich auch\\nkeine...\\c\\nUnd die Schulsprecherin will ich nicht um Hilfe\\nbitten.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "legend_0010_friend_19",
      "hash64": "489C9E65A9C51EE4",
      "text": "Aber du scheinst [VAR 0x1100(00FF,1412,0000)]ein guter Kandidateine gute Kandidatin zu sein.\\nDeshalb wollte ich dich fragen, ob du mir dabei\\r\\nhelfen würdest![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1412",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "legend_0010_friend_20",
      "hash64": "4892A565A9BCD644",
      "text": "Halt! Moment! Du musst mir nicht jetzt sofort\\nantworten.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "legend_0010_friend_23",
      "hash64": "4892A865A9BCDB5D",
      "text": "Lass mich einfach schon mal die Orte auf deiner\\nKarten-App markieren, an denen sich die\\r\\nHerrscher-Pokémon vermutlich rumtreiben.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "legend_0010_friend_21",
      "hash64": "4892A665A9BCD7F7",
      "text": "Die genauen Details erzähl ich dir später.\\nAber hier, nimm das als kleines Dankeschön\\r\\ndafür, dass du mir zugehört hast.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "legend_0010_friend_22",
      "hash64": "4892A765A9BCD9AA",
      "text": "Also dann... Denk schon mal drüber nach![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    }
  ]
}
