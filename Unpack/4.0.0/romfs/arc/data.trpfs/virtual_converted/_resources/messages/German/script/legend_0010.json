    {
      "ordinal": 0,
      "label": "legend_0010_friend_01",
      "hash64": "48999265A9C2D4A9",
      "text": "Oh! So trifft man sich wieder![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
