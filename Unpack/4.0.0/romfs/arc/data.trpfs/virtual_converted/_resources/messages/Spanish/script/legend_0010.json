    {
      "ordinal": 1,
      "label": "legend_0010_friend_02",
      "hash64": "48998F65A9C2CF90",
      "text": "¿Te acuerdas de mí?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
