      "label": "sdc02_0258_bbteacher_01",
      "hash64": "4CAEEDCA3BF8EF62",
      "text": "啊啊，真是太厲害了！\\n電梯不斷地在往下降！！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
