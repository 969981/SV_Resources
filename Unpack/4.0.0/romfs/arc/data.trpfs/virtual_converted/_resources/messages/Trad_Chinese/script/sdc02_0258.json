          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0258_sister_01",
      "hash64": "0432A286AD73E344",
      "text": "……畢竟這是電梯嘛。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
