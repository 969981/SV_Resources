    {
      "ordinal": 6,
      "label": "sdc01_0010_bbteacher_05",
      "hash64": "D367CE83C7899FD9",
      "text": "오! 테라스탈오브도 가지고 있구나![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
