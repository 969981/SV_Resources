          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_normal_040_normal_05",
      "hash64": "E4ECAEAC02E1A419",
      "text": "Cependant, je crains que ma patronne ne\\nse fâche, si nous bavardons trop longtemps.\\c\\nPassons donc au combat, si tu le veux bien.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
