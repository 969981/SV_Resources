          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_normal_040_normal_04",
      "hash64": "E4ECADAC02E1A266",
      "text": "Et... euh... Sache qu’outre les boulettes de riz\\ngrillées, les plats sont généralement assez bons\\r\\nici, alors n’hésite pas à essayer autre chose.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
