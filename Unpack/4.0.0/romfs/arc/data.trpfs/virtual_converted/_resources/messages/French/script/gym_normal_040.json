    {
      "ordinal": 9,
      "label": "gym_normal_040_normal_02",
      "hash64": "E4ECAFAC02E1A5CC",
      "text": "Je suis Okuba, le Champion de l’Arène\\nde Mezclamora.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_normal_040_normal_03",
      "hash64": "E4ECB0AC02E1A77F",
      "text": "Bravo pour ta réussite à l’examen d’Arène.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
