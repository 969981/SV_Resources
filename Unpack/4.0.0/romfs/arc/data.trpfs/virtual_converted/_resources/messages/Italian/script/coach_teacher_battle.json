          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_battle_sp02_00",
      "hash64": "8D37EC72C2EDB86E",
      "text": "Novellin[VAR 0x1100(00FF,0101)]oa! Lo sai che il Bioterarium è davvero\\nuna forza?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_battle_sp02_01",
      "hash64": "8D37ED72C2EDBA21",
      "text": "È praticamente il corrispettivo del campo\\nsportivo che abbiamo all’accademia.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_battle_sp02_02",
      "hash64": "8D37EA72C2EDB508",
      "text": "È spazioso e aperto! Dev’essere un piacere farci\\nuna bella corsetta![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_battle_sp02_03",
      "hash64": "8D37EB72C2EDB6BB",
      "text": "Come prossima lezione stavo appunto\\nprogrammando un esercizio pratico: un giro\\r\\ndi corsa di tutto il Bioterarium. Che te ne pare?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
