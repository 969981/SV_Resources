    },
    {
      "ordinal": 12,
      "label": "coach_teacher_battle_sp01_05",
      "hash64": "340331597B9C9A7A",
      "text": "Ad ogni modo, lascia fare alla sanguigna Dendra![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
