          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_battle_sp02_select_01",
      "hash64": "37A1D076C23731E0",
      "text": "Bello!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_battle_sp02_select_02",
      "hash64": "37A1D376C23736F9",
      "text": "Forse è un po’ troppo...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_battle_sp02_04",
      "hash64": "8D37F072C2EDBF3A",
      "text": "Già! Ad allenare le gambe non si sbaglia mai![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_battle_sp02_04b",
      "hash64": "E3CCEB0139FC2288",
      "text": "Dici che esagero? Sarà per questa smania che ho\\ndi farmi una corsa lì dentro.\\c\\nPazienza... Allora facciamo solo mezzo giro, dai![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_battle_sp02_05",
      "hash64": "8D37F172C2EDC0ED",
      "text": "Inutile dire che voglio vedere partecipare\\nanche te![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
