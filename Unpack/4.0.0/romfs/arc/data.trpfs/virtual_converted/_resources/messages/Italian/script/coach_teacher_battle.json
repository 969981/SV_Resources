      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_battle_sp01_04b",
      "hash64": "FE0ADD0D0B1D9A3D",
      "text": "Eh certo! Vuoi affidarti alle mie conoscenze\\nsul campo!\\c\\nDopotutto questo istituto si focalizza sulle lotte![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
