          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_battle_sp01_04c",
      "hash64": "FE0ADC0D0B1D988A",
      "text": "Cosa vorrebbe dire? Tutto bene, novellin[VAR 0x1100(00FF,0101)]oa?!\\nCos’è, uno scherzo di voi giovani?![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
