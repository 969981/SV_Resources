      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_battle_sp03_03",
      "hash64": "36D2236B2783F9B2",
      "text": "D’altronde, la specializzazione nella lotta offre\\nsbocchi nella Lega Pokémon, nel corpo\\r\\ndei Ranger o come Allenatori professionisti![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
