        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_kakutou_010_nelke_06",
      "hash64": "94C02D31DE6429AC",
      "text": "Ich hab diese Schülerin angesprochen, da sie\\naussah, als gehöre sie zu Team Star.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_kakutou_010_nelke_07",
      "hash64": "94C02E31DE642B5F",
      "text": "Dann hat sie mich plötzlich angegriffen, und ja...\\nDer Kampf ist seit eben vorbei.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_kakutou_010_sitappa_00",
      "hash64": "4178C2401BDFB539",
      "text": "Rioba! Dachte ich mir doch, dass ich dich hier\\nfinden würde.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
