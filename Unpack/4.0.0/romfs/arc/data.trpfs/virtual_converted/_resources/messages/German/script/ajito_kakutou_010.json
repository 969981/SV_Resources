          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "ajito_kakutou_010_sitappa_01",
      "hash64": "4178C1401BDFB386",
      "text": "Alles in Ordnung mit dir, bist du verletzt?[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_kakutou_010_kakutouboss_06",
      "hash64": "4B28827826B0D7FE",
      "text": "Mir geht’s gut, keine Sorge! Aber bring du dich\\nbesser in Sicherheit![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_kakutou_010_sitappa_02",
      "hash64": "4178C0401BDFB1D3",
      "text": "Nix da, ich übernehm jetzt! Geh du zurück ins\\nVersteck, Rioba![VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "ajito_kakutou_010_kakutouboss_07",
      "hash64": "4B28837826B0D9B1",
      "text": "Nein, das kann ich doch nicht einfach auf dich\\nabwälzen![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_kakutou_010_sitappa_03",
      "hash64": "4178BF401BDFB020",
      "text": "Rioba, es reicht![VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_kakutou_010_kakutouboss_08",
      "hash64": "4B287C7826B0CDCC",
      "text": "Bis unser Big Boss zurückkommt, muss ich euch\\nMitglieder der Caph-Bande beschützen...\\r\\nebenso wie alle anderen in Team Star.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "ajito_kakutou_010_sitappa_04",
      "hash64": "4178C6401BDFBC05",
      "text": "Und genau deshalb solltest du dich jetzt ausruhen\\ngehen und neue Energie tanken![VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "ajito_kakutou_010_kakutouboss_09",
      "hash64": "4B287D7826B0CF7F",
      "text": "Als Boss kann ich mir das aber nicht leisten...[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "ajito_kakutou_010_sitappa_05",
      "hash64": "4178C5401BDFBA52",
      "text": "Rioba, ich bitte dich! Hör auf mich, wir sind doch\\nFreunde![VAR 0x0114(003F)]",
