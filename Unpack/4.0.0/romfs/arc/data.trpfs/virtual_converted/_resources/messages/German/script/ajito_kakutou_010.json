      "ordinal": 15,
      "label": "ajito_kakutou_010_kakutouboss_05",
      "hash64": "4B28817826B0D64B",
      "text": "Mispa...![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
