          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "team_0170_head_teacher_02",
      "hash64": "F79DDE08E752CA44",
      "text": "Ich habe dich hergebeten, um dir für deine\\nArbeit bei der Sache mit Team Star zu danken.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "team_0170_head_teacher_03",
      "hash64": "F79DDF08E752CBF7",
      "text": "Wenn du nicht gewesen wärst, hätte ich den\\nMitgliedern von Team Star eine ungerechte\\r\\nStrafe auferlegt.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "team_0170_head_teacher_04",
      "hash64": "F79DDC08E752C6DE",
      "text": "Ich danke dir also vielmals.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "team_0170_system_01",
      "hash64": "C13FF0396378E547",
      "text": "*klopf* *klopf* *klopf*",
