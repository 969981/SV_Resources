            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_doku_010_select_03",
      "hash64": "D6C2708EEA434A25",
      "text": "Jepp, [VAR 0x1100(00FF,0303,0000)]derdas bin ich.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "ajito_doku_010_select_04",
      "hash64": "D6C2698EEA433E40",
      "text": "Das ist ein Überfall!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "ajito_doku_010_student_05",
      "hash64": "8FC7CA649BB09638",
      "text": "Ich wusste es!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "ajito_doku_010_sitappa_07",
      "hash64": "FE3FECE5CC9BE88D",
      "text": "Ernsthaft jetzt? Au Backe, das ist gar nicht gut![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_doku_010_sitappa_08",
      "hash64": "FE3FDDE5CC9BCF10",
      "text": "Wir haben die ganze Nacht Videospiele gezockt.\\nDie anderen schlafen alle noch...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_doku_010_student_06",
      "hash64": "8FC7CD649BB09B51",
      "text": "Keine Sorge, ich werde mich um den Störenfried\\nhier kümmern. Geh du die anderen aufwecken!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "ajito_doku_010_sitappa_09",
      "hash64": "FE3FDEE5CC9BD0C3",
      "text": "Hä? Warum würdest du das tun?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_doku_010_student_07",
      "hash64": "8FC7CC649BB0999E",
      "text": "Wenn das Versteck ohne jegliche Verteidigung\\ndasteht, steckt schließlich auch Meister Shugi in\\r\\nSchwierigkeiten!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_doku_010_student_08",
      "hash64": "8FC7C7649BB0911F",
      "text": "Ich schulde Meister Shugi mein Leben.\\nUns verbindet das Band der Kameradschaft!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "ajito_doku_010_student_09",
      "hash64": "8FC7C6649BB08F6C",
      "text": "In Krisenzeiten müssen wir allen Widrigkeiten\\ntrotzen, um einander unter die Arme zu greifen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "ajito_doku_010_sitappa_10",
      "hash64": "FE42EBE5CC9E1CB1",
      "text": "Ich hab keinen Schimmer, wovon du da sprichst,\\naber okay. Danke für deine Hilfe![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "ajito_doku_010_student_10",
      "hash64": "8FC449649BAD852E",
      "text": "Du bist [VAR 0x1100(00FF,1A19,0000)]ein gemeiner Schurke, dereine gemeine Schurkin, die es auf meinen\\nKameraden abgesehen hat. Ich werde mich dir\\r\\nmit all meiner Kraft in den Weg stellen!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1A19",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "ajito_doku_010_select_05",
      "hash64": "D6C26A8EEA433FF3",
      "text": "Kämpfen wir!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "ajito_doku_010_select_06",
      "hash64": "D6C26B8EEA4341A6",
      "text": "Äh, gerade nicht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "ajito_doku_010_student_11",
      "hash64": "8FC44A649BAD86E1",
      "text": "Weise ist jener, der die Gefahr meidet.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "ajito_doku_010_student_12",
      "hash64": "8FC447649BAD81C8",
      "text": "Hiyaaaaaa!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "ajito_doku_010_student_13",
      "hash64": "8FC448649BAD837B",
      "text": "Meister Shugi... Verzeiht mir...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "ajito_doku_010_nelke_01",
      "hash64": "5F2032885202D340",
      "text": "[VAR 0x0100(0000)], ist alles in Ordnung?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "ajito_doku_010_nelke_02",
      "hash64": "5F2035885202D859",
      "text": "Ich hab Schmiere gestanden, als plötzlich dieser\\nLärm hier losging.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "ajito_doku_010_nelke_03",
      "hash64": "5F2034885202D6A6",
      "text": "Ich wollte schauen, was vor sich geht, also bin ich\\ndirekt hergekommen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_doku_010_student_14",
      "hash64": "8FC44D649BAD8BFA",
      "text": "Oje! Da kommt auch noch Verstärkung!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "ajito_doku_010_nelke_04",
      "hash64": "5F2037885202DBBF",
      "text": "Ist das... ein Schüler der Akademie? Er sieht mir\\nnicht wie ein Mitglied von Team Star aus...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "ajito_doku_010_student_15",
      "hash64": "8FC44E649BAD8DAD",
      "text": "Wohl wahr, Team Star gehöre ich nicht an.\\nAber Meister Shugi bin ich zutiefst verbunden!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "ajito_doku_010_student_16",
      "hash64": "8FC44B649BAD8894",
      "text": "Ich muss ihn treffen! Koste es, was es wolle!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "ajito_doku_010_nelke_05",
      "hash64": "5F2036885202DA0C",
      "text": "Er scheint seine Gründe zu haben...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "ajito_doku_010_nelke_06",
      "hash64": "5F2039885202DF25",
      "text": "Ich werde mich kurz mit ihm unterhalten.\\c\\nKümmere du dich bitte in der Zwischenzeit um\\ndas Versteck, [VAR 0x0100(0000)].[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "ajito_doku_010_nelke_07",
      "hash64": "5F2038885202DD72",
      "text": "Hey, Brudi! Lass uns doch woanders kurz\\nplaudern, hm?\\c\\nKeine Sorge, es geht um nichts Schlimmes.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
