  "entries": [
    {
      "ordinal": 0,
      "label": "ajito_doku_010_sitappa_01",
      "hash64": "FE3FE6E5CC9BDE5B",
      "text": "Vergiss es einfach und geh nach Hause, okay?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_doku_010_student_01",
      "hash64": "8FC7CE649BB09D04",
      "text": "Nein! Ich will Meister Shugi treffen, den Boss der\\nGift-Mitglieder!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "ajito_doku_010_sitappa_02",
      "hash64": "FE3FE7E5CC9BE00E",
      "text": "Aber genau der hat mir gesagt, dass ich nur\\nMitglieder von Team Star durchlassen soll![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_doku_010_student_02",
      "hash64": "8FC7D1649BB0A21D",
      "text": "Und ich sage dir, dass ich zu ihm gehen werde!\\nIch muss unbedingt mit Meister Shugi sprechen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "ajito_doku_010_sitappa_03",
      "hash64": "FE3FE8E5CC9BE1C1",
      "text": "Boah, jetzt lass mich endlich in Ruhe!\\nDu nervst echt übelst...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_doku_010_system_01",
      "hash64": "C90A82F2B8B9430C",
      "text": "Das sieht nach einer Auseinandersetzung aus.\\nWas möchtest du tun?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "ajito_doku_010_select_01",
      "hash64": "D6C26E8EEA4346BF",
      "text": "Etwas sagen",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_doku_010_select_02",
      "hash64": "D6C26F8EEA434872",
      "text": "Näher rangehen",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "ajito_doku_010_student_03",
      "hash64": "8FC7D0649BB0A06A",
      "text": "Hm?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "ajito_doku_010_sitappa_04",
      "hash64": "FE3FE9E5CC9BE374",
      "text": "Och nee, nicht noch so ein Clown...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_doku_010_sitappa_05",
      "hash64": "FE3FEAE5CC9BE527",
      "text": "Als neues Mitglied bei Team Star bekommt man\\necht nur die Drecksarbeit ab...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_doku_010_student_04",
      "hash64": "8FC7CB649BB097EB",
      "text": "[VAR 0xBD06(0000)]Moment mal... Ist das nicht [VAR 0x1100(00FF,0506,0000)]dieserdiese\\n[VAR 0x0100(0000)]?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
