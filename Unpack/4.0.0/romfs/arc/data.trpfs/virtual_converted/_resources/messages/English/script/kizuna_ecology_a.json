    },
    {
      "ordinal": 5,
      "label": "kizuna_ecology_a_05",
      "hash64": "33860670BD20EC0C",
      "text": "I’m, uh, hehe...I’m the one who made it,\\nyou know.[VAR 0x0114(002A)]",
