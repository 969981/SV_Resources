    },
    {
      "ordinal": 6,
      "label": "kizuna_ecology_a_06",
      "hash64": "33860970BD20F125",
      "text": "Every time someone using the app catches a\\nPokémon, that data gets sent to me.\\c\\nIt’s really helping with my Pokémon research![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
