    {
      "ordinal": 0,
      "label": "atlantis_talk_05_rival_01a",
      "hash64": "37DEC22B4066C998",
      "text": "So Koraidon’s an ancient Pokémon...\\nNo wonder no one’s seen it before![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
