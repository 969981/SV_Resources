            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_kusa_010_kusa_07",
      "hash64": "5570C1F196759E63",
      "text": "¿Cómo? ¿Has venido en representación de la\\nSupercampeona? ¡Tanto monta, monta tanto![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
