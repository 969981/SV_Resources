    },
    {
      "ordinal": 6,
      "label": "common_2020_kusa_010_kusa_05",
      "hash64": "5570C3F19675A1C9",
      "text": "Y los hados me sonríen, pues aquí te hallas.\\n¡Dichosa sea la madre naturaleza![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
