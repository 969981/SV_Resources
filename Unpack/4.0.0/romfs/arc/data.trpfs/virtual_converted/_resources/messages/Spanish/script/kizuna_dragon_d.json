  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_dragon_d_01",
      "hash64": "2EFA878873A3ED0C",
      "text": "Oh. Hola, [VAR 0x0100(0000)].[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_dragon_d_02",
      "hash64": "2EFA8A8873A3F225",
      "text": "Apareces en el momento más oportuno, para no\\nperder la costumbre.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_dragon_d_select_01",
      "hash64": "F7BB75BF89B648DB",
      "text": "¿Oportuno por qué?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_dragon_d_select_02",
      "hash64": "F7BB76BF89B64A8E",
      "text": "¿Ha pasado algo?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_dragon_d_03",
      "hash64": "2EFA898873A3F072",
      "text": "A decir verdad...[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_dragon_d_tamer_01",
      "hash64": "E71EA2DABA069B96",
      "text": "Don Hesperio, vengo por lo convenido.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_dragon_d_04",
      "hash64": "2EFA848873A3E7F3",
      "text": "Hete aquí.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_dragon_d_tamer_02",
      "hash64": "E71EA1DABA0699E3",
      "text": "Entiendo que por fin ha resuelto ejercer\\nplenamente como patriarca del clan.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_dragon_d_05",
      "hash64": "2EFA838873A3E640",
      "text": "Así es.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_dragon_d_06",
      "hash64": "2EFA868873A3EB59",
      "text": "He tomado mi decisión.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_dragon_d_07",
      "hash64": "2EFA858873A3E9A6",
      "text": "¡La de no abandonar la docencia en esta\\nacademia![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_dragon_d_tamer_03",
      "hash64": "E71EA0DABA069830",
      "text": "¡Pero qué dice! ¿Es que le trae sin cuidado el\\nfuturo de su propia familia?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_dragon_d_08",
      "hash64": "2EFA908873A3FC57",
      "text": "¡Hay algo que me incumbe aún más![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_dragon_d_09",
      "hash64": "2EFA8F8873A3FAA4",
      "text": "Presta atención a las obras de arte expuestas en\\nesta aula.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_dragon_d_10",
      "hash64": "2EF7828873A1AEB6",
      "text": "Observa el entusiasmo con el que los alumnos\\nestán desarrollando su sensibilidad artística.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_dragon_d_11",
      "hash64": "2EF7838873A1B069",
      "text": "No niego la importancia de salvaguardar la\\nintegridad de nuestro ilustre abolengo.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_dragon_d_12",
      "hash64": "2EF7808873A1AB50",
      "text": "Pero yo prefiero volver la mirada al futuro y ser\\ntestigo de la floración de estos jóvenes talentos.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_dragon_d_13",
      "hash64": "2EF7818873A1AD03",
      "text": "Francamente, se me antoja mucho más\\ninteresante.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_dragon_d_tamer_04",
      "hash64": "E71EA7DABA06A415",
      "text": "Lo que dice no tiene sentido alguno...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "kizuna_dragon_d_tamer_05",
      "hash64": "E71EA6DABA06A262",
      "text": "Usted ha sido siempre de carácter firme y audaz.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "kizuna_dragon_d_tamer_06",
      "hash64": "E71EA5DABA06A0AF",
      "text": "Lo que lo convierte en el paladín idóneo de la\\nvoluntad del dragón.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "kizuna_dragon_d_tamer_07",
      "hash64": "E71EA4DABA069EFC",
      "text": "No pienso rendirme tan fácilmente. Le insistiré\\nlas veces que haga falta.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "kizuna_dragon_d_14",
      "hash64": "2EF7868873A1B582",
      "text": "¡Como gustes! Comprobarás que, en lo que a\\nobstinación se refiere, no tengo rival.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_dragon_d_15",
      "hash64": "2EF7878873A1B735",
      "text": "Nada me hará cambiar de parecer. Y mucho\\nmenos un ladino embuste como el que urdiste\\r\\nsobre la salud de mi padre.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_dragon_d_tamer_08",
      "hash64": "E71EABDABA06AAE1",
      "text": "...\\c\\nBah. ¡Adiós!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_dragon_d_16",
      "hash64": "2EF7848873A1B21C",
      "text": "Ay, lamento que hayas tenido que presenciar tan\\ndeplorable espectáculo.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_dragon_d_17",
      "hash64": "2EF7858873A1B3CF",
      "text": "He estado a un paso de presentar mi dimisión\\ny regresar a mi aldea natal.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_dragon_d_18",
      "hash64": "2EF78A8873A1BC4E",
      "text": "Pero, gracias a mis alumnos y a tus palabras,\\nhe hallado el coraje para rehusar.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_dragon_d_19",
      "hash64": "2EF78B8873A1BE01",
      "text": "Jamás podré daros las gracias como os merecéis.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_dragon_d_20",
      "hash64": "2EF41C88739ECB8D",
      "text": "Acepta esto, aunque palidezca frente a lo que\\nhas hecho por mí.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_dragon_d_21",
      "hash64": "2EF41B88739EC9DA",
      "text": "Y en adelante, un servidor...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_dragon_d_22",
      "hash64": "2EF41A88739EC827",
      "text": "¡Retomará su vocación docente con renovada\\npasión![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_dragon_d_system_01",
      "hash64": "7BE69C1982F83480",
      "text": "¡Te has ganado la amistad de Hesperio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
