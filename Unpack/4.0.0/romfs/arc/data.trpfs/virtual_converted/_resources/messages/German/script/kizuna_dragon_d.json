          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_dragon_d_02",
      "hash64": "2EFA8A8873A3F225",
      "text": "Du hast wohl ein Talent dafür, immer zum\\nentscheidenden Zeitpunkt hier aufzutauchen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_dragon_d_select_01",
      "hash64": "F7BB75BF89B648DB",
      "text": "Zum entscheidenden Zeitpunkt?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_dragon_d_select_02",
      "hash64": "F7BB76BF89B64A8E",
      "text": "Ist was passiert?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_dragon_d_03",
      "hash64": "2EFA898873A3F072",
      "text": "Weißt du...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_dragon_d_tamer_01",
      "hash64": "E71EA2DABA069B96",
      "text": "Sinius. Ich bin hier, um dich abzuholen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_dragon_d_04",
      "hash64": "2EFA848873A3E7F3",
      "text": "Ah, da bist du ja.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_dragon_d_tamer_02",
      "hash64": "E71EA1DABA0699E3",
      "text": "Du hast dich also entschlossen, die Nachfolge\\nals Familienoberhaupt anzutreten. Sehr schön.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_dragon_d_05",
      "hash64": "2EFA838873A3E640",
      "text": "Nun...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_dragon_d_06",
      "hash64": "2EFA868873A3EB59",
      "text": "Ich habe in der Tat eine Entscheidung getroffen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_dragon_d_07",
      "hash64": "2EFA858873A3E9A6",
      "text": "Und zwar habe ich entschieden, weiterhin an\\ndieser Akademie zu unterrichten![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_dragon_d_tamer_03",
      "hash64": "E71EA0DABA069830",
      "text": "W-Wie bitte? Du lässt unsere Familie einfach so\\nim Stich?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_dragon_d_08",
      "hash64": "2EFA908873A3FC57",
      "text": "Meine Prioritäten liegen eben woanders.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_dragon_d_09",
      "hash64": "2EFA8F8873A3FAA4",
      "text": "Schau dir bitte die Kunstwerke in diesem\\nRaum an.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_dragon_d_10",
      "hash64": "2EF7828873A1AEB6",
      "text": "Die Kinder hier entwickeln ihre Kreativität und\\nihren Sinn für Ästhetik mit unglaublichem Elan.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_dragon_d_11",
      "hash64": "2EF7838873A1B069",
      "text": "Zweifelsohne ist es wichtig, unsere uralte Familie\\nzu beschützen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_dragon_d_12",
      "hash64": "2EF7808873A1AB50",
      "text": "Aber ich wünsche mir nichts sehnlicher, als diese\\njungen Talente aufblühen zu sehen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_dragon_d_13",
      "hash64": "2EF7818873A1AD03",
      "text": "Ich muss offen gestehen, dass mir dies erheblich\\nmehr Freude bereiten würde.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_dragon_d_tamer_04",
      "hash64": "E71EA7DABA06A415",
      "text": "Das ist lächerlich.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "kizuna_dragon_d_tamer_05",
      "hash64": "E71EA6DABA06A262",
      "text": "Aber genau diese Verwegenheit zeichnet dich\\naus, Sinius.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "kizuna_dragon_d_tamer_06",
      "hash64": "E71EA5DABA06A0AF",
      "text": "Sie beweist, dass du in der Tat würdig bist,\\nden Willen der Drachen weiterzuführen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "kizuna_dragon_d_tamer_07",
      "hash64": "E71EA4DABA069EFC",
      "text": "Ich habe nicht vor aufzugeben. Ich werde immer\\nwieder versuchen, dich zu überzeugen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "kizuna_dragon_d_14",
      "hash64": "2EF7868873A1B582",
      "text": "Meinetwegen. Versuche es ruhig!\\c\\nDu wirst schon bald feststellen, dass ich dich\\nin Sachen Hartnäckigkeit übertreffen werde.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_dragon_d_15",
      "hash64": "2EF7878873A1B735",
      "text": "Außerdem war die Krankheit meines Vaters doch\\nnur eine Lüge, die du erfunden hast, um mich zu\\r\\nüberzeugen, nicht wahr?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_dragon_d_tamer_08",
      "hash64": "E71EABDABA06AAE1",
      "text": "Hmpf! Wir sehen uns.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "kizuna_dragon_d_16",
      "hash64": "2EF7848873A1B21C",
      "text": "Ich muss mich für dieses peinliche Spektakel\\nentschuldigen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_dragon_d_17",
      "hash64": "2EF7858873A1B3CF",
      "text": "Ich war wirklich kurz davor, mich von meiner\\nPosition als Lehrer zu verabschieden und nach\\r\\nHause zurückzukehren...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_dragon_d_18",
      "hash64": "2EF78A8873A1BC4E",
      "text": "[VAR 0xBD06(0000)]Aber meine Schüler und ganz besonders deine\\nlieben Worte, [VAR 0x0100(0000)], haben mir den\\r\\nMut\\r\\nverliehen,\\r\\nNein\\r\\nzu sagen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_dragon_d_19",
      "hash64": "2EF78B8873A1BE01",
      "text": "Dafür bin ich euch jungen Leuten unendlich\\ndankbar.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_dragon_d_20",
      "hash64": "2EF41C88739ECB8D",
      "text": "Ich möchte, dass du das hier nimmst, auch wenn\\nes nicht annähernd das ganze Ausmaß meiner\\r\\nDankbarkeit auszudrücken vermag.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_dragon_d_21",
      "hash64": "2EF41B88739EC9DA",
      "text": "Nun gut. Somit ist es offiziell![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_dragon_d_22",
      "hash64": "2EF41A88739EC827",
      "text": "Ich werde meine Berufung als Lehrer fortsetzen![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_dragon_d_system_01",
      "hash64": "7BE69C1982F83480",
      "text": "Señor Sinius und du versteht euch nun prächtig!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
