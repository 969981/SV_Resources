      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_doku_020_cassiopeia_08",
      "hash64": "BDF6B1D267EE9A46",
      "text": "[VAR 0x1100(00FF,0101)]你妳準備好的話，\\n就去敲響鑼來展開大作戰！\\r\\n到策星小隊踢館吧。[VAR 0x0114(0009)]",
      "flags": 0,
