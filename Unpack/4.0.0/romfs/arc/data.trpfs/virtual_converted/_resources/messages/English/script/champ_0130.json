      "label": "champ_0130_ground_08",
      "hash64": "DE1124169634C18E",
      "text": "I know it’s hard to believe, but this tiny little one\\nis indeed one of the Elite Four.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
