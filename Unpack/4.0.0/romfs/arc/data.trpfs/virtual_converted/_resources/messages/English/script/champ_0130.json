      "ordinal": 11,
      "label": "champ_0130_steel_05",
      "hash64": "85D779A5DFE500E9",
      "text": "I’m one of the Elite Four! So I’m more amazing![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
