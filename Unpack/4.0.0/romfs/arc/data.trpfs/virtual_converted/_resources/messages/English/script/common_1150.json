    {
      "ordinal": 1,
      "label": "common_1150_system_01",
      "hash64": "E23063E5465E273C",
      "text": "Open the gate to the Zero Lab?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "common_1150_system_02",
      "hash64": "E23066E5465E2C55",
      "text": "You decided to press the button and open—",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_1150_friend_01",
      "hash64": "3AC2B0431CDDD763",
      "text": "Hold it![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
