            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "team_0190_botan_18",
      "hash64": "5712C50133B387CA",
      "text": "Be seeing you, then. Hasta la vistar! ☆[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
