    {
      "ordinal": 1,
      "label": "common_0170_rival_18",
      "hash64": "3BFA8943B399EB66",
      "text": "Uah! Che succede? Tutto bene?![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
