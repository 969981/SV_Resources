      ]
    },
    {
      "ordinal": 33,
      "label": "sdc02_0089_dragonbb_stopper",
      "hash64": "5C70256EC271E689",
      "text": "[VAR 0x1100(00FF,0101)]你妳要去哪？\\n試著用電腦發送ＢＰ吧。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
