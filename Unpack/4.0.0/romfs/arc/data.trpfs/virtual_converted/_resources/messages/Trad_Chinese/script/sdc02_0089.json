      "ordinal": 59,
      "label": "sdc02_0089_sister_20",
      "hash64": "C9FF9B2959AA71F1",
      "text": "[VAR 0x1100(00FF,0101)]你妳不知道房間在哪？\\n憑感覺走就會知道了。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
