    {
      "ordinal": 35,
      "label": "sdc02_0089_sister_npc",
      "hash64": "65C15D443538643A",
      "text": "看～來杜若開始一頭熱了。\\n雖然很麻煩，[VAR 0x1100(00FF,0101)]你妳就配合他一下吧。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
