          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_health_sp01_01",
      "hash64": "359B4AB7C4E54EAE",
      "text": "갑자기 출장을 가라고 해서\\n얼마나 깜짝 놀랐다구![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_health_sp01_02",
      "hash64": "359B49B7C4E54CFB",
      "text": "게다가 우리 아카데미가 아니라\\n여기서 첫 수업을 하게 되다니~[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_health_sp01_select_01",
      "hash64": "A49B12D57D51AF3D",
      "text": "힘내세요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_health_sp01_select_02",
      "hash64": "A49B0FD57D51AA24",
      "text": "괜찮을 거예요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_health_sp01_03",
      "hash64": "359B48B7C4E54B48",
      "text": "너, 남 일이라고 정말...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_health_sp01_03b",
      "hash64": "FC27BA43919EB85E",
      "text": "뭐야, 그 자신감은!?\\n내 쪽이 더 필요한 것 같은데...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_health_sp01_04",
      "hash64": "359B4FB7C4E5572D",
      "text": "그래도 뭐, 네 덕분에 모처럼 얻은 기회니까\\n열심히 해 봐야겠지![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_health_sp01_05",
      "hash64": "359B4EB7C4E5557A",
      "text": "좋아! 출장 특집 미모사의 보건실을\\n제대로 보여 주겠어![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_health_sp02_00",
      "hash64": "8ED009D10C36736E",
      "text": "아~! [VAR 0x0100(0000)]!\\n내 이야기 좀 들어 봐~![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_health_sp02_01",
      "hash64": "8ED00AD10C367521",
      "text": "나, 첫 수업부터 제대로 사고 쳤어...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_health_sp02_02",
      "hash64": "8ED007D10C367008",
      "text": "그게, 수업 자체는 제대로 했거든?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_health_sp02_03",
      "hash64": "8ED008D10C3671BB",
      "text": "근데 교실을 헷갈려서\\n엉뚱한 반에서 해 버렸지 뭐야!![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_health_sp02_select_01",
      "hash64": "BFCE805A3DD52AE0",
      "text": "그거 큰일이네요",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_health_sp02_select_02",
      "hash64": "BFCE835A3DD52FF9",
      "text": "그럴 때도 있죠 뭐!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_health_sp02_04",
      "hash64": "8ED00DD10C367A3A",
      "text": "덕분에 자습 중인 교실에 갑자기 들어와서\\n보건 수업을 시작하는\\r\\n수상한 사람이 되어 버렸어...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_health_sp02_04b",
      "hash64": "E201D237C091E388",
      "text": "아니... 보통 없지 않아?\\n위로해 주려는 마음은 기쁘지만\\r\\n우리 아카데미에서도 유례없는 일이잖아...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_health_sp02_05",
      "hash64": "8ED00ED10C367BED",
      "text": "아~ 이 이야기는 그만할래!\\n생각만 해도 부끄러워 죽겠어![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_health_sp02_06",
      "hash64": "8ED00BD10C3676D4",
      "text": "안 좋은 일은 빨리 털어 버리고\\n다음을 준비해야겠어![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_health_sp03_00",
      "hash64": "386A3FC970CCB2FF",
      "text": "[VAR 0x0100(0000)]!\\n내 이야기 좀 들어 봐~![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_health_sp03_01",
      "hash64": "386A3EC970CCB14C",
      "text": "내가 전에 엉뚱한 교실에서\\n수업을 했다고 했잖아.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_health_sp03_02",
      "hash64": "386A41C970CCB665",
      "text": "그 반 아이들 여럿이\\n나한테 질문을 하러 찾아온 거 있지![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_health_sp03_03",
      "hash64": "386A40C970CCB4B2",
      "text": "나에게 있어서 교실을 헷갈린 사건은\\n잊어버리고 싶은 흑역사였는데...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_health_sp03_04",
      "hash64": "386A3BC970CCAC33",
      "text": "그 애들에게는\\n허튼 일이 아니었다고 생각하니까[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_health_sp03_05",
      "hash64": "386A3AC970CCAA80",
      "text": "뭐랄까...\\n대박 기뻤어![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_health_sp03_select_01",
      "hash64": "4D1BAAAD33FA2C1B",
      "text": "잘됐네요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_health_sp03_select_02",
      "hash64": "4D1BABAD33FA2DCE",
      "text": "대박이네요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_health_sp03_06",
      "hash64": "386A3DC970CCAF99",
      "text": "정말 그렇다니까![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_health_sp03_07",
      "hash64": "386A3CC970CCADE6",
      "text": "교사 일은 역시 즐거운 것 같아!\\n물론, 힘들 때도 있지만.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_health_sp03_08",
      "hash64": "386A47C970CCC097",
      "text": "꿈을 포기하지 않아서 정말 다행이야.\\n[VAR 0x0100(0000)]... 고마워![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_health_trade_01_00",
      "hash64": "8F74B786FF4D1059",
      "text": "맞다! 아직 시간 괜찮아?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_teacher_health_trade_01_01",
      "hash64": "8F74B686FF4D0EA6",
      "text": "너한테 매번 도움만 받아서\\n뭔가 보답이 하고 싶은데...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_teacher_health_trade_01_02",
      "hash64": "8F74B586FF4D0CF3",
      "text": "포켓몬 교환으로\\n좀 더 가까워져 보는 건 어때?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
