    {
      "ordinal": 1,
      "label": "coach_teacher_health_first_01",
      "hash64": "DB9760C44104B9DC",
      "text": "여기가 미모사의 새로운 보건실?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
