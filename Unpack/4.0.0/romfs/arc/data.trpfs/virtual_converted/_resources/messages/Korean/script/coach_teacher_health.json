    },
    {
      "ordinal": 2,
      "label": "coach_teacher_health_sp01_00",
      "hash64": "359B4BB7C4E55061",
      "text": "아, 역시 네가 초대한 거구나~[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
