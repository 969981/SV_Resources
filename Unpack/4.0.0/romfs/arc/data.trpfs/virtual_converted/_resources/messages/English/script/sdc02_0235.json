    {
      "ordinal": 28,
      "label": "sdc02_0235_ground_13",
      "hash64": "D97660BDBDC27357",
      "text": "What is that, anyway—a TM or something?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
