            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0235_ground_01",
      "hash64": "D979C6BDBDC55680",
      "text": "Hiya, kiddo! Rika’s here, too—at your service![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0235_ground_02",
      "hash64": "D979C9BDBDC55B99",
      "text": "Not gonna lie, I never dreamed we’d be running\\ninto you![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0235_chairman_02",
      "hash64": "2C6DB5047B65BEE1",
      "text": "I see that you are putting your skills to good use\\nand living up to your title as a Paldea Champion\\r\\neven while abroad.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0235_select_01",
      "hash64": "ABB7C9C24ACDCE91",
      "text": "I’m doing my best!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_0235_select_02",
      "hash64": "ABB7C6C24ACDC978",
      "text": "That’s what Champions do!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_0235_chairman_03",
      "hash64": "2C6DB4047B65BD2E",
      "text": "Ha... Indeed. I would expect nothing less from\\na talented Trainer such as yourself.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0235_ground_04",
      "hash64": "D979CBBDBDC55EFF",
      "text": "Yeah, definitely got talent. Lotsa talent...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0235_ground_05",
      "hash64": "D979CABDBDC55D4C",
      "text": "But not enough to get you off the hook![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0235_ground_06",
      "hash64": "D979CDBDBDC56265",
      "text": "You went into the Great Crater without the\\nLeague’s permission, didn’t you?![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0235_ground_07",
      "hash64": "D979CCBDBDC560B2",
      "text": "Don’t think you’re not gonna get a scolding for\\nthat![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0235_select_03",
      "hash64": "ABB7C7C24ACDCB2B",
      "text": "I’m really sorry...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc02_0235_select_04",
      "hash64": "ABB7CCC24ACDD3AA",
      "text": "That’s what Champions...do?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0235_ground_08",
      "hash64": "D979CFBDBDC565CB",
      "text": "Oh sure, NOW you’re sorry—I practically fell out\\nof my seat when I heard about where you’d been![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0235_ground_09",
      "hash64": "D979CEBDBDC56418",
      "text": "What’s that got to do with anything?! You can’t\\njust go breaking rules willy-nilly![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0235_chairman_04",
      "hash64": "2C6DB7047B65C247",
      "text": "Calm down, Rika. No harm came to h[VAR 0x1100(00FF,0202)]imer, after all.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0202"
          ]
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0235_chairman_05",
      "hash64": "2C6DB6047B65C094",
      "text": "[VAR 0xBD06(0000)]And besides, we have good reason to believe\\nthat all of Paldea would have been at risk if\\r\\nChampion [VAR 0x0100(0000)] here\\r\\nhadn’t\\r\\nventured\\r\\ninto\\r\\nArea\\r\\nZero.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
