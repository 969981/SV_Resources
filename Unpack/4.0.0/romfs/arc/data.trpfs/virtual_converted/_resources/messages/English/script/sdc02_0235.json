    {
      "ordinal": 1,
      "label": "sdc02_0235_chairman_01",
      "hash64": "2C6DB2047B65B9C8",
      "text": "[VAR 0xBD06(0000)]It has been a while, Champion\\n[VAR 0x0100(0000)].[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
