        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_006_trainer_13",
      "hash64": "B98EB16E5775B193",
      "text": "눈보라 코스!\\n[VAR 0x0201(0000)]:[VAR 0x0201(0001)].[VAR 0x0201(0002)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
