        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_006_trainer_14",
      "hash64": "B98EB66E5775BA12",
      "text": "절대영도 코스!\\n[VAR 0x0201(0000)]:[VAR 0x0201(0001)].[VAR 0x0201(0002)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
