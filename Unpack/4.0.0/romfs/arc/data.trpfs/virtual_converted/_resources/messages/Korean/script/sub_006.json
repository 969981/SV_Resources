    {
      "ordinal": 34,
      "label": "sub_006_trainer_23",
      "hash64": "B98B496E5772CB04",
      "text": "이번에는 아쉬웠네.\\n다음에 또 도전해 줘!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
