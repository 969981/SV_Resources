          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_006_trainer_15",
      "hash64": "B98EB76E5775BBC5",
      "text": "눈싸라기 코스는...\\n아직 골인한 적이 없구나.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sub_006_trainer_16",
      "hash64": "B98EB46E5775B6AC",
      "text": "눈보라 코스는...\\n아직 골인한 적이 없구나.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_006_trainer_17",
      "hash64": "B98EB56E5775B85F",
      "text": "절대영도 코스는...\\n아직 골인한 적이 없구나.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sub_006_select_01",
      "hash64": "92B072B3A21EFB49",
      "text": "도전한다",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sub_006_select_02",
      "hash64": "92B06FB3A21EF630",
      "text": "설명을 듣는다",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sub_006_select_03",
      "hash64": "92B070B3A21EF7E3",
      "text": "최고 기록을 확인한다",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sub_006_select_04",
      "hash64": "92B075B3A21F0062",
      "text": "그만둔다",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sub_006_select_05",
      "hash64": "92B076B3A21F0215",
      "text": "눈싸라기 코스",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sub_006_select_06",
      "hash64": "92B073B3A21EFCFC",
      "text": "눈보라 코스",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "sub_006_select_07",
      "hash64": "92B074B3A21EFEAF",
      "text": "절대영도 코스",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "sub_006_trainer_18",
      "hash64": "B98EBA6E5775C0DE",
      "text": "눈싸라기 코스에서 처음 골인했구나! 축하해!\\n기념 선물로 이걸 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "sub_006_trainer_24",
      "hash64": "B98B486E5772C951",
      "text": "다음부터는 상당히 어려운\\n눈보라 코스에 도전할 수 있어!\\r\\n자신 있으면 꼭 활강해 보렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sub_006_trainer_19",
      "hash64": "B98EBB6E5775C291",
      "text": "눈보라 코스에서 처음 골인했구나! 축하해!\\n이제 어엿한 활강 선수라고 할 수 있겠어!\\r\\n기념 선물로 이걸 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sub_006_trainer_25",
      "hash64": "B98B476E5772C79E",
      "text": "다음부터는 최고 난이도인\\n절대영도 코스에 도전할 수 있어!\\r\\n각오가 되었다면 꼭 활강해 보렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sub_006_trainer_20",
      "hash64": "B98B4C6E5772D01D",
      "text": "절대영도 코스에서 처음 골인했구나! 축하해!\\n이제 너는 훌륭한 설산 마스터가 된 거야!\\r\\n기념 선물로 이걸 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sub_006_trainer_21",
      "hash64": "B98B4B6E5772CE6A",
      "text": "최고 기록 경신을 축하해!\\n멋진 활강이었어!\\r\\n기념품을 받아 줘.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sub_006_trainer_22",
      "hash64": "B98B4A6E5772CCB7",
      "text": "골인 축하해!\\n기념품을 받아 줘.\\r\\n다음엔 더 높은 목표를 노려 보자!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
