    {
      "ordinal": 8,
      "label": "a_sch_room03_ni02",
      "hash64": "788188171F202D2A",
      "text": "这孩子很胆小，\\n所以没什么力量，\\r\\n但却很灵敏哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
