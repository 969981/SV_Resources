  "entries": [
    {
      "ordinal": 0,
      "label": "coach_event_tutorial_headbb_01",
      "hash64": "024F7F020AA5A14E",
      "text": "¡Mira tú qué bien! ¡Llegas en el momento justo,\\n[VAR 0x0100(0000)]![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
