            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_event_tutorial_headbb_02",
      "hash64": "024F7E020AA59F9B",
      "text": "¡Me he enterado del notición! Te has convertido\\nen [VAR 0x1100(00FF,0202)]ella Campe[VAR 0x1100(00FF,0302)]ónona de la Liga Arándano, ¿eh?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0202"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302"
          ]
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_event_tutorial_headbb_03",
      "hash64": "024F7D020AA59DE8",
      "text": "¡Vaya hacha estás hech[VAR 0x1100(00FF,0101)]oa, valga la redundancia!\\n¡Y cómo me alegro de que hayas venido, oye![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_event_tutorial_headbb_04",
      "hash64": "024F84020AA5A9CD",
      "text": "Ya ha pasado un tiempecillo desde tu llegada.\\c\\nDime, ¿lo estás pasando bien en la Academia\\nArándano?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_event_tutorial_select_01",
      "hash64": "FF16CF5FB1524138",
      "text": "¡Sí!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_event_tutorial_select_02",
      "hash64": "FF16D25FB1524651",
      "text": "Más o menos",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_event_tutorial_headbb_05",
      "hash64": "024F83020AA5A81A",
      "text": "¡Chachi! ¡O incluso chachi piruli![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_event_tutorial_headbb_06",
      "hash64": "024F82020AA5A667",
      "text": "¿Ah, sí? Pero tirando sobre todo hacia el más,\\n¿verdad? Je, je...[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_event_tutorial_headbb_07",
      "hash64": "024F81020AA5A4B4",
      "text": "Pues te buscaba porque quería pedirte un favor\\nde los grandes.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_event_tutorial_headbb_08",
      "hash64": "024F78020AA59569",
      "text": "El caso es que tu aparición ha llenado toda la\\nAcademia Arándano de vida y actividad.[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_event_tutorial_headbb_09",
      "hash64": "024F77020AA593B6",
      "text": "¡Y pensando en ello tuve un momento eureka!\\c\\nMe dije: \"Uy, anda que no estaría bien traer a\\n[VAR 0xFF00(0006)]invitados especiales [VAR 0xFF00(0000)]de Paldea a dar charlas\".[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_event_tutorial_headbb_10",
      "hash64": "024BFA020AA28978",
      "text": "Y a ti te veo pinta de sociable. Debes de tener\\nun buen número de amiguetes, ¿verdad?[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_event_tutorial_headbb_11",
      "hash64": "024BFB020AA28B2B",
      "text": "Pues si en tu círculo de amistades se encuentran\\nEntrenadores fuertes como... yo qué sé, Líderes\\r\\nde Gimnasio o profesores...\\c\\n¡Me gustaría que los invitases a la academia![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 176,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_event_tutorial_select_03",
      "hash64": "FF16D15FB152449E",
      "text": "¡Déjelo en mis manos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_event_tutorial_select_04",
      "hash64": "FF16D45FB15249B7",
      "text": "Hmm...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_event_tutorial_headbb_12",
      "hash64": "024BFC020AA28CDE",
      "text": "¡Una respuesta de Campe[VAR 0x1100(00FF,0302)]ónona! Sabía que podía\\ncontar contigo.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_event_tutorial_headbb_13",
      "hash64": "024BFD020AA28E91",
      "text": "Je, je. Ya estás pensando a quién invitar, ¿eh?\\n¡Una respuesta de Campe[VAR 0x1100(00FF,0302)]ónona![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302"
          ]
        },
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_event_tutorial_headbb_14",
      "hash64": "024BFE020AA29044",
      "text": "Puedes utilizar este ordenador para ponerte en\\ncontacto con la gente y enviar las invitaciones.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_event_tutorial_system_01",
      "hash64": "A020FDE452B989BB",
      "text": "Habrá que sufragar sus gastos de viaje y demás,\\nasí que hacen falta PA. Aquí tienes unos cuantos.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_event_tutorial_headbb_15",
      "hash64": "024BFF020AA291F7",
      "text": "Mirtilo te ha transferido 200 PA.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "coach_event_tutorial_headbb_16",
      "hash64": "024C00020AA293AA",
      "text": "Los invitados especiales que traigas usarán la sala\\ndurante los ratos de espera en su jornada lectiva.\\c\\n¡Aprovecha la ocasión para socializar con ellos y\\nestrechar lazos![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 102,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 172,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_event_tutorial_headbb_17",
      "hash64": "024C01020AA2955D",
      "text": "Pues hale, en tus manos y tu don de gentes\\nlo dejo, entonces.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
