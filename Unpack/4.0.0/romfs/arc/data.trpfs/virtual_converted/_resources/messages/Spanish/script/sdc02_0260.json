      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0260_bbteacher_09",
      "hash64": "292A88CF8836F43F",
      "text": "¡Espléndido! ¡Qué gran descubrimiento! ¡Y pensar\\nque Eriad no dejó nada escrito acerca de esto![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
