          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0260_sister_06",
      "hash64": "7F7F1C4AE087D51A",
      "text": "Vayamos con cuidado...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc02_0260_bbteacher_npc",
      "hash64": "FEEC52A57F1E60EB",
      "text": "A la vuelta, no pienso dejar ni uno solo de esos\\ndocumentos sin leer.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
