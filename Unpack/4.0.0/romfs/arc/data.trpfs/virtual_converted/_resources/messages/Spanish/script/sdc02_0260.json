      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0260_brother_04",
      "hash64": "1FFE0797D064B778",
      "text": "¡Venga, sigamos avanzando![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0260_bbteacher_11",
      "hash64": "292E14CF883A17FA",
      "text": "Me encantaría seguir leyendo, pero sí... tienes\\nrazón. ¡Será mejor que sigamos![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0260_bbteacher_12",
      "hash64": "292E13CF883A1647",
      "text": "No hay nada mejor que observar la verdad de\\nprimera mano.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
