  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "class_a_02_ecology_01_old_00",
      "hash64": "75A030D90C5F91DC",
      "text": "Wie geht’s, wie steht’s? Lasst uns auch heute\\nwieder etwas Neues lernen![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_a_02_ecology_02_old_00",
      "hash64": "48291636FE03F357",
      "text": "In unserer letzten Stunde habe ich euch erklärt,\\nwie ihr eure Pokémon mit der ZR-Taste aus ihrem\\r\\nPokéball lassen könnt.\\c\\nWie sieht’s aus, konntet ihr alle das Gelernte\\nschon ausprobieren?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 192,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_a_02_ecology_03",
      "hash64": "056101908DD0AEFF",
      "text": "Bei einem gemeinsamen Spaziergang kommt der\\nindividuelle Charakter eines Pokémon erst so\\r\\nrichtig zum Vorschein. Süß, nicht wahr?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_a_02_ecology_04",
      "hash64": "0560FE908DD0A9E6",
      "text": "Wenn ihr jedoch Zeit mit eurem ganzen Team\\nverbringen wollt, empfehle ich dafür ein Picknick![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_a_02_ecology_05",
      "hash64": "0560FF908DD0AB99",
      "text": "Gemeinsam den Tisch decken, Sandwiches essen\\nund zusammen spielen...\\c\\nPicknicks sind ein Heidenspaß![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_a_02_ecology_06",
      "hash64": "0560FC908DD0A680",
      "text": "Wie man gutes Essen zubereitet, kann euch mit\\nSicherheit Señor Saguaro zeigen![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_a_02_ecology_07",
      "hash64": "0560FD908DD0A833",
      "text": "Wenn man ein Picknick macht, findet man\\naußerdem ab und zu etwas in dem Korb, der\\r\\nneben dem Tisch steht...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_a_02_ecology_08",
      "hash64": "05610A908DD0BE4A",
      "text": "Und zwar etwas echt Wichtiges![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_a_02_ecology_09",
      "hash64": "05610B908DD0BFFD",
      "text": "Ich gebe euch einen Hinweis: Pokémon werden\\ndaraus geboren. Na, weiß jemand, was es ist?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_a_02_select_01",
      "hash64": "3A32B96E379E9D53",
      "text": "Eine Box!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_a_02_select_02",
      "hash64": "3A32BA6E379E9F06",
      "text": "Ein Pokéball!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_a_02_select_03",
      "hash64": "3A32BB6E379EA0B9",
      "text": "Ein Ei!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_a_02_ecology_answer_01",
      "hash64": "3571AB7985C94A06",
      "text": "[VAR 0xBD06(0000)]Oh? Du denkst, ich spreche von einer Box,\\n[VAR 0x0100(0000)]?\\c\\nWir können Pokémon zwar in Boxen ablegen,\\naber sie werden nicht aus ihnen geboren![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_a_02_ecology_answer_02",
      "hash64": "3571AA7985C94853",
      "text": "Oh? Du denkst, ich spreche von einem Pokéball,\\n[VAR 0x0100(0000)]?\\c\\nBisher gab es noch nie einen Fall, in dem ein\\nPokémon aus einem Pokéball geboren wurde.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_a_02_ecology_answer_03",
      "hash64": "3571A97985C946A0",
      "text": "Sehr schön. Damit liegt ihr alle richtig![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_a_02_ecology_10",
      "hash64": "056488908DD3CA3B",
      "text": "Ich spreche natürlich von einem Pokémon-Ei![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_a_02_ecology_11",
      "hash64": "056487908DD3C888",
      "text": "Es ist nicht genau bekannt, wo die Eier so\\nplötzlich herkommen.\\c\\nWahrscheinlich werden sie von den Pokémon,\\ndie beim Picknick dabei sind, ganz unbemerkt\\r\\nin den Korb gelegt.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 154,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 177,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_a_02_ecology_12",
      "hash64": "05648A908DD3CDA1",
      "text": "Sobald ihr ein Ei habt, müsst ihr nur damit\\nherumlaufen, um es zu wärmen. Nach einer\\r\\nWeile schlüpft dann ein Pokémon daraus![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_a_02_ecology_13",
      "hash64": "056489908DD3CBEE",
      "text": "Leider werden Eier in Boxen nicht aufgewärmt,\\nalso nehmt sie zum Ausbrüten in euer Team auf.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_a_02_ecology_14",
      "hash64": "05648C908DD3D107",
      "text": "Oh, eine Sache noch. Eine ziemlich wichtige\\nSache sogar.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_a_02_ecology_15",
      "hash64": "05648B908DD3CF54",
      "text": "Pokémon vertrauen uns ihre Eier an, weil sie sich\\nauf uns verlassen.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_a_02_ecology_16",
      "hash64": "05648E908DD3D46D",
      "text": "Es liegt also an euch, die Fürsorge für sie zu\\nübernehmen!\\c\\nIch erwarte daher, dass ihr euch dieser Aufgabe\\nverantwortungsbewusst stellt.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_a_02_ecology_17",
      "hash64": "05648D908DD3D2BA",
      "text": "Ah, da unterbricht die Klingel meinen Unterricht\\ngerade bei so einem wichtigen Thema!\\c\\nGut, ich freue mich auf unsere nächste Stunde.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
