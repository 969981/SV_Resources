      "ordinal": 22,
      "label": "sdc02_0110_brother_04",
      "hash64": "21AFF274C274B796",
      "text": "그러니까 나한테 지는 거 아니겠어?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
