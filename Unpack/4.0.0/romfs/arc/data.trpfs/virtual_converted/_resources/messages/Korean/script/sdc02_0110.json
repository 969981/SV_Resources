    },
    {
      "ordinal": 19,
      "label": "sdc02_0110_dragonbb_13",
      "hash64": "23AA6A9E05CCB407",
      "text": "그러니 식당으로 부른 것 아니겠어?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0110_brother_02",
      "hash64": "21AFF474C274BAFC",
      "text": "...시시하긴.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
