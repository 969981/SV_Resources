      ]
    },
    {
      "ordinal": 39,
      "label": "sdc02_0110_fairybb_04",
      "hash64": "99B2012E37E9DECF",
      "text": "그, 그래, 맞아![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
