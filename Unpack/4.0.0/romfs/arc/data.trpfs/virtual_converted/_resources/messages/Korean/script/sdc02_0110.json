        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc02_0110_steelbb_01",
      "hash64": "F58399E85D3AC3BE",
      "text": "...다른 학교 학생이 블루베리그에\\n참가한 전례는 없음.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
