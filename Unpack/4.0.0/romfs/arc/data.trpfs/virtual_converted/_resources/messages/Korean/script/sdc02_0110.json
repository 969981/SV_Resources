    {
      "ordinal": 37,
      "label": "sdc02_0110_fairybb_03",
      "hash64": "99B1FE2E37E9D9B6",
      "text": "그게 무슨...!?[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
