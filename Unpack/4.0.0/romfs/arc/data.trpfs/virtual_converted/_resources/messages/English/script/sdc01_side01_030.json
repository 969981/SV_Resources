  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_side01_030_brother_01",
      "hash64": "2C5EE0F8ACDFF912",
      "text": "These are the Paradise Barrens. Pretty lonely\\nplace, huh?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_side01_030_brother_02",
      "hash64": "2C5EDFF8ACDFF75F",
      "text": "According to the old legends, the ogre used to\\nbe seen around here lots.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_side01_030_brother_03",
      "hash64": "2C5EDEF8ACDFF5AC",
      "text": "Hey, before we check out the sign...could you...\\nbattle me...?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_side01_030_select_01",
      "hash64": "08A96501DBB565C0",
      "text": "Let’s do it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_side01_030_select_02",
      "hash64": "08A96801DBB56AD9",
      "text": "I dunno...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc01_side01_030_brother_04",
      "hash64": "2C5EDDF8ACDFF3F9",
      "text": "’K, let me heal up our Pokémon.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_side01_030_brother_05",
      "hash64": "2C5EDCF8ACDFF246",
      "text": "I promise I’ll heal up your Pokémon and all, so\\nplease, [VAR 0x0100(0000)]?[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_side01_030_brother_06",
      "hash64": "2C5EDBF8ACDFF093",
      "text": "This time...I’ll win![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_side01_030_brother_07",
      "hash64": "2C5EDAF8ACDFEEE0",
      "text": "I lost...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_side01_030_brother_08",
      "hash64": "2C5EE9F8ACE0085D",
      "text": "It’s because I’m weak... That’s why I...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_side01_030_brother_09",
      "hash64": "2C5EE8F8ACE006AA",
      "text": "We should go check out the sign... Come on, let’s\\nget this over with.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_side01_030_system_01",
      "hash64": "E9094D2B1A6E9F13",
      "text": "If you see a shadowy figure approaching you\\noutside the village at twilight, be wary.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sdc01_side01_030_system_02",
      "hash64": "E9094E2B1A6EA0C6",
      "text": "Don a mask at once, and hide your face.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc01_side01_030_system_03",
      "hash64": "E9094F2B1A6EA279",
      "text": "Do so, and whether the shadow is man or monster,\\nyou will pass each other by as fellow mask wearers.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc01_side01_030_system_04",
      "hash64": "E909502B1A6EA42C",
      "text": "If you should meet the shadow when you have no\\nmask in hand, then pray that it is only a man.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc01_side01_030_system_05",
      "hash64": "E909512B1A6EA5DF",
      "text": "If it is, you will live to see another day, and you\\nwill remember to never forget your mask again.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc01_side01_030_system_06",
      "hash64": "E909522B1A6EA792",
      "text": "But if it is the ogre, you will meet your end, as do\\nall humans whose faces are seen by it.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc01_side01_030_system_07",
      "hash64": "E909532B1A6EA945",
      "text": "Once it sees your face, your soul will be forfeit.\\nAnd you shall never return to the village.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sdc01_side01_030_brother_18",
      "hash64": "2C5B63F8ACDCEED4",
      "text": "In the old days, everyone carried masks wherever\\nthey went. And...the one who made those masks\\r\\nwas actually my great-great-great-grandpa’s\\r\\ngreat-great-great-grandpa...or something.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 186,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_side01_030_brother_19",
      "hash64": "2C5B64F8ACDCF087",
      "text": "That’s amazing!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc01_side01_030_brother_20",
      "hash64": "2C656DF8ACE55457",
      "text": "So the stories are true?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sdc01_side01_030_brother_21",
      "hash64": "2C656CF8ACE552A4",
      "text": "I mean, I don’t think any of that stuff about the\\nogre stealing souls is true or anything, but...\\r\\nit is true that our family used to make masks.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_side01_030_brother_22",
      "hash64": "2C656FF8ACE557BD",
      "text": "Our family...has a long line of mask makers.\\nEven my gramps can make ’em.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_side01_030_brother_23",
      "hash64": "2C656EF8ACE5560A",
      "text": "I even heard that the reason we hold the Festival\\nof Masks is ’cause our ancestors came up with\\r\\nthe idea.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_side01_030_brother_10",
      "hash64": "2C5B5BF8ACDCE13C",
      "text": "But I don’t really like what they wrote on this\\nsign here...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_side01_030_brother_24",
      "hash64": "2C6569F8ACE54D8B",
      "text": "Just because the ogre seemed sorta scary,\\neveryone got all afraid of it and drove it away\\r\\nfrom the village...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_side01_030_brother_11",
      "hash64": "2C5B5CF8ACDCE2EF",
      "text": "But I’m pretty sure the ogre must’ve been lonely\\non its own.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_side01_030_brother_25",
      "hash64": "2C6568F8ACE54BD8",
      "text": "Left all alone like that... Treated like some kind\\nof outcast...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_side01_030_select_05",
      "hash64": "08A96901DBB56C8C",
      "text": "You’re right",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "sdc01_side01_030_select_06",
      "hash64": "08A96C01DBB571A5",
      "text": "Sorry...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "sdc01_side01_030_brother_12",
      "hash64": "2C5B5DF8ACDCE4A2",
      "text": "You think so too...huh, [VAR 0x0100(0000)]?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_side01_030_brother_13",
      "hash64": "2C5B5EF8ACDCE655",
      "text": "...For what?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_side01_030_brother_14",
      "hash64": "2C5B57F8ACDCDA70",
      "text": "Wanna take that last photo?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_side01_030_brother_15",
      "hash64": "2C5B58F8ACDCDC23",
      "text": "Well, we’re all done with our assignment now.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_side01_030_brother_16",
      "hash64": "2C5B59F8ACDCDDD6",
      "text": "But I’ve gotta get stronger with my Pokémon...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc01_side01_030_brother_17",
      "hash64": "2C5B5AF8ACDCDF89",
      "text": "...I’m gonna head home.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    }
  ]
