      "text": "[VAR 0x0100(0000)]你\\n带了什么点心呀～？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
