    {
      "ordinal": 18,
      "label": "sub_035_mgirl_17",
      "hash64": "4A5CA861B3DBDCE1",
      "text": "Come ask me anytime you want to know about\\nyour Pokémon’s size!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sub_035_mgirl_18",
      "hash64": "4A5CA161B3DBD0FC",
      "text": "Hey! Did you know Pokémon of the same species\\ncan come in all sorts of sizes?\\c\\nTake my Pachirisu. It’s easy to see the difference\\nbetween ’em, right?\\c\\nMe, I’ve got a sharp eye. I can tell the exact size\\nof a Pokémon just by looking at it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
