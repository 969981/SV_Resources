  "entries": [
    {
      "ordinal": 0,
      "label": "sub_035_mgirl_01",
      "hash64": "4A602E61B3DEF66A",
      "text": "Want me to judge just how big or small your\\nPokémon are?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_035_mgirl_02",
      "hash64": "4A602D61B3DEF4B7",
      "text": "Which Pokémon would you like me to check?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_035_mgirl_03",
      "hash64": "4A602C61B3DEF304",
      "text": "[VAR 0x0102(0001)], eh? Let’s see here...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0102",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_035_mgirl_04",
      "hash64": "4A602B61B3DEF151",
      "text": "Now THIS is a BIG Pokémon! Wow, you almost\\nnever see one this huge!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_035_mgirl_05",
      "hash64": "4A602A61B3DEEF9E",
      "text": "[VAR 0xBD06(0000)]This might just be the world’s biggest\\n[VAR 0x0101(0001)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sub_035_mgirl_06",
      "hash64": "4A602961B3DEEDEB",
      "text": "This is a serious big’un! Feels comforting to have\\nsuch a bulky, reliable buddy around, doesn’t it?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_035_mgirl_07",
      "hash64": "4A602861B3DEEC38",
      "text": "This one seems a good sight bigger than average!\\nIt’s quite a specimen—take good care of it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_035_mgirl_08",
      "hash64": "4A602761B3DEEA85",
      "text": "This one seems a little bit bigger than average!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_035_mgirl_09",
      "hash64": "4A602661B3DEE8D2",
      "text": "Look at that: a perfectly average-sized specimen!\\nIt’s the gold standard for normality. Amazing!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_035_mgirl_10",
      "hash64": "4A5CA961B3DBDE94",
      "text": "This one seems a little bit smaller than average!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_035_mgirl_11",
      "hash64": "4A5CAA61B3DBE047",
      "text": "This one seems a good sight smaller than average!\\nIt’s quite a specimen—take good care of it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_035_mgirl_12",
      "hash64": "4A5CAB61B3DBE1FA",
      "text": "This is truly a little one! A pint-sized powerhouse\\nof a [VAR 0x0101(0001)]. What a charmer!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_035_mgirl_13",
      "hash64": "4A5CAC61B3DBE3AD",
      "text": "Now THIS is a tiny Pokémon! Wow, you almost\\nnever see one this little!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_035_mgirl_14",
      "hash64": "4A5CA561B3DBD7C8",
      "text": "[VAR 0xBD06(0000)]This might just be the world’s smallest\\n[VAR 0x0101(0001)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
