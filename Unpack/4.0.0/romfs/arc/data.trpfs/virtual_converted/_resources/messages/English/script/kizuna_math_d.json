  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_math_d_01",
      "hash64": "2C21F0A1DF8E081B",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)]! Help me keep an eye\\nout,\\r\\nwould you?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_math_d_02",
      "hash64": "2C21F1A1DF8E09CE",
      "text": "I’ve set up a little ambush here for that girl who\\nkeeps watching me! She’ll be here any second![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_math_d_select_01",
      "hash64": "9D49A5E8910AAAE2",
      "text": "An ambush?!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_math_d_select_02",
      "hash64": "9D49A4E8910AA92F",
      "text": "Why?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_d_03",
      "hash64": "2C21F2A1DF8E0B81",
      "text": "Well, you see, it’s not very pleasant knowing\\nshe’s just staring at me all the time.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_d_04",
      "hash64": "2C21F3A1DF8E0D34",
      "text": "And now I know what she looks like after seeing\\nher in the cafeteria![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_d_05",
      "hash64": "2C21F4A1DF8E0EE7",
      "text": "Ah![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_d_06",
      "hash64": "2C21F5A1DF8E109A",
      "text": "It’s you, isn’t it?! You’re the one who’s been\\nsecretly watching me recently![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_d_woman_01",
      "hash64": "EB672704C6358444",
      "text": "T-Tyme?! How’d you know I—",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_d_woman_02",
      "hash64": "EB672A04C635895D",
      "text": "I guess you must have noticed me... I-I’m so sorry!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_d_07",
      "hash64": "2C21F6A1DF8E124D",
      "text": "Well, of course I noticed—you were watching me\\npractically all day every day, after all!\\c\\nI assume there’s something you want to ask me?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_d_woman_03",
      "hash64": "EB672904C63587AA",
      "text": "Y-yes...I do.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_d_woman_04",
      "hash64": "EB672404C6357F2B",
      "text": "I’ve been a huge fan of yours since your time as\\na Gym Leader! And I love Rock-type moves so\\r\\nvery much!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_d_08",
      "hash64": "2C21E7A1DF8DF8D0",
      "text": "Oh, my...[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_math_d_woman_05",
      "hash64": "EB672304C6357D78",
      "text": "But you just suddenly retired from your post as\\nGym Leader a year and a half ago...\\c\\nWhy did you quit?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_d_09",
      "hash64": "2C21E8A1DF8DFA83",
      "text": "My goodness... Is that all you wanted to ask?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_math_d_woman_06",
      "hash64": "EB672604C6358291",
      "text": "Yes. Your reason for retiring was never\\nmade public...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_math_d_woman_07",
      "hash64": "EB672504C63580DE",
      "text": "but it’s well known among the students here that\\nyou just avoid the question any time it’s asked.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_math_d_woman_08",
      "hash64": "EB672004C635785F",
      "text": "I thought it would be rude to ask you a question\\nthat you don’t want to answer...so I just couldn’t\\r\\nfind the courage to ask.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_math_d_10",
      "hash64": "2C24F5A1DF904671",
      "text": "So that’s why your gaze felt so very intense. I see.\\nForgive me.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_math_d_woman_09",
      "hash64": "EB671F04C63576AC",
      "text": "So very...intense?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "kizuna_math_d_11",
      "hash64": "2C24F4A1DF9044BE",
      "text": "Ah, never mind that. As for the reason I quit my\\njob as Gym Leader, I simply wanted to focus\\r\\nmore on my job as a teacher.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_math_d_12",
      "hash64": "2C24F3A1DF90430B",
      "text": "It’s not that I disliked being a Gym Leader or\\nanything of that sort.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_math_d_13",
      "hash64": "2C24F2A1DF904158",
      "text": "Quite the contrary—talking about the Gym fills\\nme with feelings of nostalgia and sadness.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_math_d_14",
      "hash64": "2C24F9A1DF904D3D",
      "text": "That’s why I always avoid answering the question\\nwhen students ask.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_math_d_woman_10",
      "hash64": "EB63A204C6326C6E",
      "text": "Oh. I see...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "kizuna_math_d_woman_11",
      "hash64": "EB63A304C6326E21",
      "text": "Do you have any plans of becoming a Gym\\nLeader again?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "kizuna_math_d_15",
      "hash64": "2C24F8A1DF904B8A",
      "text": "No, I’m afraid I don’t plan to do so.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_math_d_16",
      "hash64": "2C24F7A1DF9049D7",
      "text": "My sister is doing a splendid job as Gym Leader\\nin my stead.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_math_d_17",
      "hash64": "2C24F6A1DF904824",
      "text": "I personally find being a teacher most enjoyable\\nthese days.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_math_d_18",
      "hash64": "2C24EDA1DF9038D9",
      "text": "But since I am, in fact, your teacher...I would\\nappreciate it if you would call me “Ms. Tyme,”\\r\\nas students do, and not just “Tyme.”[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_math_d_woman_12",
      "hash64": "EB63A004C6326908",
      "text": "OK. I’m sad to hear that, but I understand!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "kizuna_math_d_woman_13",
      "hash64": "EB63A104C6326ABB",
      "text": "Thank you so much, Ms. Tyme!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "kizuna_math_d_19",
      "hash64": "2C24ECA1DF903726",
      "text": "Well, I suppose that solves the mystery![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "kizuna_math_d_20",
      "hash64": "2C287BA1DF935FFA",
      "text": "Ahhh, that made me so nervous! I said so many\\nthings to try to sound cool![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_math_d_21",
      "hash64": "2C287CA1DF9361AD",
      "text": "I was certainly a little scared when I felt that girl’s\\nintense gaze on me.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "kizuna_math_d_22",
      "hash64": "2C2879A1DF935C94",
      "text": "But having you here with me allowed me to do\\nwhat needed to be done to face what turned out\\r\\nto be one of my biggest fans.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "kizuna_math_d_23",
      "hash64": "2C287AA1DF935E47",
      "text": "I must thank you for always showing up at just the\\nright time, [VAR 0x0100(0000)].[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "kizuna_math_d_24",
      "hash64": "2C2877A1DF93592E",
      "text": "Allow me to show you my appreciation a little.\\nI hope these help on your adventure.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "kizuna_math_d_system_01",
      "hash64": "13D34B6D971897A5",
      "text": "You formed a close bond with Ms. Tyme!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
