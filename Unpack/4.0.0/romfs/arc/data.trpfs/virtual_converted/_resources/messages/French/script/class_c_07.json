          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "class_c_07_history_21",
      "hash64": "1E255AEDD0C8E3B8",
      "text": "Il paraît que le proviseur, monsieur Clavel, faisait\\npartie de l’équipe qui a travaillé sur ce projet.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
