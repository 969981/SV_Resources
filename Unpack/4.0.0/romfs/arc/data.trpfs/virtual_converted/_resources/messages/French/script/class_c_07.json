      ]
    },
    {
      "ordinal": 31,
      "label": "class_c_07_history_20",
      "hash64": "1E255BEDD0C8E56B",
      "text": "Cela lui a permis de développer la technologie\\ndes Orbes Téracristal avec son équipe.\\c\\nCette nouvelle technologie a ensuite été\\ntransmise à la Ligue Pokémon et à l’académie.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
