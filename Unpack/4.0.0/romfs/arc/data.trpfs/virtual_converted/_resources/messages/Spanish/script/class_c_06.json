    {
      "ordinal": 21,
      "label": "class_c_06_history_15b",
      "hash64": "0C511AFE3121BF38",
      "text": "Lo tituló [VAR 0xFF00(0006)]Libro Púrpura[VAR 0xFF00(0000)] a secas, si no me falla\\nla memoria.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
