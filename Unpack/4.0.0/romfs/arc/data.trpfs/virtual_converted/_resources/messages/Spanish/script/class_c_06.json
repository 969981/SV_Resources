          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_c_06_history_16",
      "hash64": "2C90ADE7475275D7",
      "text": "El Área Cero estaba en boca de todos por aquel\\nentonces, así que, como os podréis imaginar...[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_c_06_history_17a",
      "hash64": "0C4A11FE311B913F",
      "text": "¡El Libro Escarlata se vendió como churros!\\nHabía un ejemplar en cada hogar, prácticamente.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_c_06_history_17b",
      "hash64": "0C4A12FE311B92F2",
      "text": "¡El Libro Púrpura se vendió como churros!\\nHabía un ejemplar en cada hogar, prácticamente.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_c_06_history_18",
      "hash64": "2C90A3E7475264D9",
      "text": "Peeero las descripciones y las imágenes que\\ncontenía eran a cuál más disparatada...\\r\\nFicción pura y dura, vamos.\\c\\nLos lectores se lo debieron de tomar muy mal,\\nporque comenzaron a tildar de fraude a Eriad.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 209,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_c_06_history_19",
      "hash64": "2C90A2E747526326",
      "text": "De hecho, llegaron incluso a poner en duda que\\nla Brigada de Exploración Cero hubiera logrado\\r\\nponer el pie en lo más profundo del Área Cero.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_c_06_history_20a",
      "hash64": "155C66FE365C3861",
      "text": "El Libro Escarlata causó tal decepción que\\nterminó inundando las librerías de segunda mano\\r\\ny pasó a ser considerado un libro esotérico más.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
