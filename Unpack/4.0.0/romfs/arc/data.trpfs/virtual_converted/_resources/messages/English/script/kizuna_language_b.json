        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_language_b_05",
      "hash64": "F0BB485568903CD9",
      "text": "You don’t?! Ahhh! What should I do? What\\nshould I do?!\\c\\nWaouh! Hold on—I had exactly one Potion in\\nmy pocket![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
