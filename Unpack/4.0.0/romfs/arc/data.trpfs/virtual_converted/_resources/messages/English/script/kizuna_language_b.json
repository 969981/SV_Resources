      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_language_b_select_02",
      "hash64": "8B1DD7B854BEC35D",
      "text": "Just stay calm",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_language_b_04",
      "hash64": "F0BB475568903B26",
      "text": "Oh, right! I could use a Potion! Do you have any\\non you, [VAR 0x0100(0000)]?[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
