      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0050_rival_11",
      "hash64": "973A45AB0669B07A",
      "text": "Sehr gut, dann lass uns nicht lange fackeln![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
