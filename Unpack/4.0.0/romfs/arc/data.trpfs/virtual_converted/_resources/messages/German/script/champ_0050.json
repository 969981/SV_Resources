    },
    {
      "ordinal": 2,
      "label": "champ_0050_rival_02",
      "hash64": "9736C2AB06669C0A",
      "text": "Na, sammelst du auch schön fleißig Orden?\\nBei welcher Arena bist du gerade?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
