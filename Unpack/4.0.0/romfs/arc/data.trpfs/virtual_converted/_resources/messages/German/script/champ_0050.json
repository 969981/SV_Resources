            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0050_select_01",
      "hash64": "BD9535F089C0AA41",
      "text": "Lass uns loslegen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "champ_0050_select_02",
      "hash64": "BD9532F089C0A528",
      "text": "Lieber nicht...",
      "flags": 0,
