  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0020_bbteacher_01",
      "hash64": "0821B05AC6B633BC",
      "text": "[VAR 0xBD06(0000)]Are you ready to set out for Kitakami,\\n[VAR 0x0100(0000)]?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0020_bbteacher_02",
      "hash64": "0821B35AC6B638D5",
      "text": "You’ll be able to come back to Paldea whenever\\nyou want, so don’t worry too much, OK?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0020_bbteacher_03",
      "hash64": "0821B25AC6B63722",
      "text": "Great! We’ll set out together as a group once the\\nother students arrive.\\c\\nI hear you were all chosen for this trip by lottery,\\nso this may be the first time you meet![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 168,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0020_bbteacher_04",
      "hash64": "0821AD5AC6B62EA3",
      "text": "I know my role is to chaperone you kids around,\\nbut I fully intend to have some fun of my own\\r\\nwhile I’m at it—just so you’re aware![VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0020_bbteacher_05",
      "hash64": "0821AC5AC6B62CF0",
      "text": "By the way...\\c\\nDo you know of the Scarlet Book?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0020_bbteacher_06",
      "hash64": "0821AF5AC6B63209",
      "text": "By the way...\\c\\nDo you know of the Violet Book?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0020_select_01",
      "hash64": "D05D8F35FD616BF2",
      "text": "I know it",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc01_0020_select_02",
      "hash64": "D05D8E35FD616A3F",
      "text": "Never heard of it",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc01_0020_bbteacher_07",
      "hash64": "0821AE5AC6B63056",
      "text": "As you should. It was the most influential book\\nof the century on the subject of the paranormal.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0020_bbteacher_08",
      "hash64": "0821B95AC6B64307",
      "text": "Really? Well, that’s unexpected. I’m quite sure\\nat least one copy was donated to this school.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0020_bbteacher_09",
      "hash64": "0821B85AC6B64154",
      "text": "The author of the [VAR 0x1107(00FF,0304)]ScarViolet Book, Heath, was in\\nfact an ancestor of mine.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0304"
          ]
        },
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0020_bbteacher_10",
      "hash64": "081E2B5AC6B31BE6",
      "text": "I even have his original manuscript.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0020_bbteacher_11",
      "hash64": "081E2C5AC6B31D99",
      "text": "Look here—these are the pages that were\\nblacked out and made illegible in the published\\r\\nversion of the book.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0020_bbteacher_12",
      "hash64": "081E295AC6B31880",
      "text": "The Pokémon depicted on these pages is\\ncalled [VAR 0xFF00(0006)]Terapagos[VAR 0xFF00(0000)].[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0020_bbteacher_13",
      "hash64": "081E2A5AC6B31A33",
      "text": "It’s a mysterious Pokémon that Heath allegedly\\nencountered when he delved even further into\\r\\nthe depths of Area Zero...\\c\\nNot that the general public believed him.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 166,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0020_bbteacher_14",
      "hash64": "081E2F5AC6B322B2",
      "text": "It’s my dream to find Terapagos and prove that\\nHeath’s records were all true.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0020_bbteacher_15",
      "hash64": "081E305AC6B32465",
      "text": "Though I haven’t yet been able to secure\\npermission to enter Area Zero, unfortunately...[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0020_bbteacher_16",
      "hash64": "081E2D5AC6B31F4C",
      "text": "But that’s fine! It’ll all be fine. All I need to do\\nnow is focus on the work that’s in front of me.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0020_student1_01",
      "hash64": "A97DD108C793D8D8",
      "text": "Ms. Briar! We’re ready to go!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc01_0020_bbteacher_17",
      "hash64": "081E2E5AC6B320FF",
      "text": "Looks like the gang’s all here.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0020_bbteacher_18",
      "hash64": "081E335AC6B3297E",
      "text": "All right, everyone! To the land of Kitakami![VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    }
  ]
}
