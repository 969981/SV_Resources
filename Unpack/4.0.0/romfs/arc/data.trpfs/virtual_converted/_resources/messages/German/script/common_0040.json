        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0040_head_teacher_11",
      "hash64": "08712E5945777B74",
      "text": "Mein Name ist Clavel. Ich bin der Direktor der\\nTrauben-Akademie.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0040_mama_01",
      "hash64": "CEBAA8BB4FF1BD84",
      "text": "Na, so was! Das ist ja der Direktor\\nhöchstpersönlich![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0040_head_teacher_06",
      "hash64": "086DAB5945746704",
      "text": "Nun, immerhin bin ich für die Unzulänglichkeiten\\nder Akademie verantwortlich.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0040_head_teacher_07",
      "hash64": "086DAC59457468B7",
      "text": "Das hier sind die Unterlagen, die [VAR 0x1100(00FF,0C08,0000)]Ihr SohnIhre Tochter für\\ndie Einschreibung benötigt.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0C08",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0040_mama_02",
      "hash64": "CEBAABBB4FF1C29D",
      "text": "Oh, das wäre wirklich nicht nötig gewesen![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
