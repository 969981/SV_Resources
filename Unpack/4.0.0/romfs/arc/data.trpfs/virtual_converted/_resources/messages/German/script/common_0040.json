        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0040_head_teacher_04",
      "hash64": "086DAD5945746A6A",
      "text": "Oh... Aber ich habe mich ja noch gar nicht\\nvorgestellt![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0040_head_teacher_05",
      "hash64": "086DAE5945746C1D",
      "text": "Mein Name ist Clavel. Ich bin der Direktor der\\nOrangen-Akademie.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
