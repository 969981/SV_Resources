    {
      "ordinal": 14,
      "label": "common_0040_mama_06",
      "hash64": "CEBAA7BB4FF1BBD1",
      "text": "Señor Direktor, wenn Sie vielleicht Platz nehmen\\nwollen...?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
