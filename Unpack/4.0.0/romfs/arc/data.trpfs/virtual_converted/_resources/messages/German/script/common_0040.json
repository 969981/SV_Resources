          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0040_head_teacher_09",
      "hash64": "086DA259457457B9",
      "text": "Gut, dann nehme ich Ihre Einladung dankend an.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
