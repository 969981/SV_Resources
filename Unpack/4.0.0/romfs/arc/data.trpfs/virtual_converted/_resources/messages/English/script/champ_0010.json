      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0010_rival_01",
      "hash64": "5D8DCF1984371BB3",
      "text": "Oh, [VAR 0x0100(0000)]! Hey![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
