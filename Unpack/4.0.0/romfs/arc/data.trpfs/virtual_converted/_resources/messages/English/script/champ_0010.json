            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0010_select_03",
      "hash64": "3009FF203298CE9F",
      "text": "Who was that?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "champ_0010_select_04",
      "hash64": "3009FC203298C986",
      "text": "She looked awesome!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "champ_0010_rival_16a",
      "hash64": "382BDB5BAEEAB34A",
      "text": "Piqued your interest, huh? That lady is...\\nWell, they call her La Primera!\\c\\nShe’s strong, she can do pretty much anything,\\nshe’s got cool practically coming out her ears...\\c\\nShe’s basically everything I wanna be—or that\\nany Pokémon Trainer would wanna be, really![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 174,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 267,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0010_rival_16b",
      "hash64": "382BDA5BAEEAB197",
      "text": "Good eye! She sure is! That lady is... Well, they\\ncall her La Primera!\\c\\nShe’s strong, she can do pretty much anything,\\nshe’s got cool practically coming out her ears...\\c\\nShe’s basically everything I wanna be—or that\\nany Pokémon Trainer would wanna be, really![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 170,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 263,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0010_rival_17",
      "hash64": "5D915519843A353C",
      "text": "Oh! Which reminds me! Remember in homeroom\\nwhen I asked what your dream is?[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0010_rival_02a",
      "hash64": "2F15A25BA9A652E5",
      "text": "Now, I know you said you’re all about completing\\nthe Pokédex! But hear me out...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0010_rival_02b",
      "hash64": "2F159F5BA9A64DCC",
      "text": "Well, since your heart’s already set on becoming\\na really strong Trainer...I’ve got an idea for you![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0010_rival_02c",
      "hash64": "2F15A05BA9A64F7F",
      "text": "If you’re still trying to decide what it is you’re\\nlooking for...I’ve got an idea for you![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0010_rival_03",
      "hash64": "5D8DD11984371F19",
      "text": "You should try to reach [VAR 0xFF00(0006)]Champion Rank[VAR 0xFF00(0000)] like me![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0010_slect_01",
      "hash64": "EE507076B7697910",
      "text": "Yeah, I will!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "champ_0010_slect_02",
      "hash64": "EE507376B7697E29",
      "text": "I don’t know...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "champ_0010_rival_04a",
      "hash64": "2F1CAE5BA9AC85F7",
      "text": "Oh wow! Hang on, though—I’ve got a whole spiel\\nI wanna give you. Here goes...[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "champ_0010_rival_04b",
      "hash64": "2F1CAF5BA9AC87AA",
      "text": "Aww, but talent like yours deserves to be used!\\nHear me out...[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "champ_0010_rival_05",
      "hash64": "5D8DD3198437227F",
      "text": "The Trainers who reach Champion Rank are the\\nones who raise their Pokémon really strong.\\c\\nThey’re pro-tier battlers. Their moves keep\\ncrowds absolutely on the edge of their seats![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 181,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "champ_0010_rival_06",
      "hash64": "5D8DD41984372432",
      "text": "You have to prove yourself to the Pokémon\\nLeague to officially get the title of Champion.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "champ_0010_rival_07",
      "hash64": "5D8DD519843725E5",
      "text": "And to do that, you have to do more than just\\ntake classes here.\\c\\nYou’ve got to take on eight Pokémon Gyms and\\nwin so you can collect their Gym Badges![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 153,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "champ_0010_rival_08",
      "hash64": "5D8DD61984372798",
      "text": "Once you’ve done all that, all that’s left is a\\nspecial test—the Champion Assessment.[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "champ_0010_rival_09",
      "hash64": "5D8DD7198437294B",
      "text": "And once you pass THAT, then at long last you’ll\\nbe a Champion![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "champ_0010_rival_10",
      "hash64": "5D915419843A3389",
      "text": "It’s every Pokémon Trainer’s dream! The coolest\\ntitle anyone could ever hope to get!\\c\\nNot to brag or anything![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "champ_0010_rival_11",
      "hash64": "5D915319843A31D6",
      "text": "I reached Champion Rank during our last\\nTreasure Hunt, you know![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "champ_0010_rival_16",
      "hash64": "5D915619843A36EF",
      "text": "Oh, the Treasure Hunt is a special independent\\nstudy thing we’ve got here. Should happen soon!\\c\\nOur last one started not long after the beginning\\nof this school year![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 168,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "champ_0010_rival_12",
      "hash64": "5D915219843A3023",
      "text": "It’s great! You get to leave school to go have an\\nadventure and learn however you want![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "champ_0010_rival_13",
      "hash64": "5D915119843A2E70",
      "text": "I guess you could say my journey to becoming\\na Champion was the treasure I found...maybe?\\r\\nI dunno yet if that’s the answer I’m looking for...[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "champ_0010_rival_14",
      "hash64": "5D915819843A3A55",
      "text": "Anyway, I’ve got a feeling I’d be able to get even\\nstronger if you and I were both working at it...[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "champ_0010_rival_18",
      "hash64": "5D915C19843A4121",
      "text": "Lemme go ahead and save the Gyms’ locations in\\nyour map app in case you decide to go for it![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "champ_0010_rival_15",
      "hash64": "5D915719843A38A2",
      "text": "Give it some thought![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    }
  ]
