    {
      "ordinal": 0,
      "label": "champ_0010_chairman_01",
      "hash64": "B2E98FB3584CEBAC",
      "text": "Very well, Champion Nemona. I trust you to\\nhandle this in my stead.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
