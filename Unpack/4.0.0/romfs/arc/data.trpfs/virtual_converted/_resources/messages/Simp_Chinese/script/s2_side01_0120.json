          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0120_botan_02",
      "hash64": "A1878B61CCCF4C31",
      "text": "当时……有什么东西在。\\n奇怪的……圆圆的东西！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side01_0120_friend_05",
      "hash64": "74E9E65E9C052E0E",
      "text": "在哪里啊……你不会是\\n害怕到出现幻觉了吧？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0120_botan_03",
      "hash64": "A1878A61CCCF4A7E",
      "text": "不是，真的有东西在！！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
