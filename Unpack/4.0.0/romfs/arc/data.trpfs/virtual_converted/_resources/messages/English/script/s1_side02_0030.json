    {
      "ordinal": 4,
      "label": "s1_side02_0030_camera_03",
      "hash64": "714375C201AC2F89",
      "text": "Yes, look at you, you clever thing! Lovely![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
