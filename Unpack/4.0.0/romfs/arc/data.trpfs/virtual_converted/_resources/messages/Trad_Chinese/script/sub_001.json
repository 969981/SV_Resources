      "hash64": "B1C24EED006DC858",
      "text": "那麼，我就請向日花怪們\\n散到鎮上去囉！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
