          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0380_npc_key_02",
      "hash64": "0D51968EED9566B7",
      "text": "Have you seen Okidogi of the Loyal Three?\\nThat purple scarf it wears is so lovely!\\c\\nI saw it wandering around in the barrens!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0380_npc_key_03",
      "hash64": "0D51958EED956504",
      "text": "I thought someone had collapsed, so I went to\\ncheck on them, but it was just Munkidori taking\\r\\na nap! It can be so peaceful around that pond\\r\\nout there. What an ideal place for a snooze!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0380_system_02",
      "hash64": "12B9CEF5C1892D17",
      "text": "You got a clue to the Loyal Three’s whereabouts!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_0380_system_03",
      "hash64": "12B9CDF5C1892B64",
      "text": "You got a second clue to the Loyal Three’s\\nwhereabouts!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc01_0380_system_01",
      "hash64": "12B9CFF5C1892ECA",
      "text": "You got clues to all of the Loyal Three’s\\nwhereabouts! Time to compare notes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc01_0380_sister_01",
      "hash64": "3CE52BD6CB165B21",
      "text": "We need to gather every scrap of info we can\\nget about any sightings of the Lousy Three!\\r\\nLet’s meet up once we’re done![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
