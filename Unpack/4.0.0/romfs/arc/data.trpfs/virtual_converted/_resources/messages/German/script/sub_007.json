      ]
    },
    {
      "ordinal": 6,
      "label": "sub_007_model_05b",
      "hash64": "C303E51D8E1F8611",
      "text": "Es könnte sich noch ein klitzekleines bisschen\\nmehr anstrengen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_007_model_06",
      "hash64": "B85944A315834A30",
      "text": "[VAR 0x0102(0001)] hat ein Fleißband erhalten!",
