      "hash64": "B85945A315834BE3",
      "text": "Das Fleißband steht deinem Pokémon ganz\\nausgezeichnet!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
