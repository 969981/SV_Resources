    },
    {
      "ordinal": 18,
      "label": "gym_mizu_040_mizu_10",
      "hash64": "5DF38DB7D2FDDAB7",
      "text": "Ante ti, me siento cual Magikarp observando a\\nun Pidgeotto desde su charca.[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
