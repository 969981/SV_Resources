    },
    {
      "ordinal": 19,
      "label": "gym_mizu_040_mizu_11",
      "hash64": "5DF38CB7D2FDD904",
      "text": "Al final he sido yo quien ha caído en tu red.\\n¡Eres todo un pez gordo, ya lo sabía yo![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
