          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_esper_040_esper_badge_all",
      "hash64": "AD2165F57B02D8E7",
      "text": "Da du nun acht Arenaorden besitzt, kannst du\\nalle Pokémon fangen und sie werden brav auf\\r\\ndich hören.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_esper_040_esper_waza",
      "hash64": "799E8E5F8222D3D9",
      "text": "Wenn du hart trainierst, wirst du diese Attacke\\nperfekt ausführen können.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_esper_040_esper_17",
      "hash64": "A1A7066506F5386C",
      "text": "Ach, und eine Sache noch: Teile bitte keine\\nSelfies, die du mit mir gemacht hast, in deinen\\r\\nsozialen Medien. Versprich es![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "gym_esper_040_esper_15",
      "hash64": "A1A7086506F53BD2",
      "text": "Durch diesen schweißtreibenden Kampf ist mein\\nMake-up jetzt bestimmt ganz verschmiert...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "gym_esper_040_esper_16",
      "hash64": "A1A7076506F53A1F",
      "text": "Das muss ich so schnell wie möglich in Ordnung\\nbringen, gleich steht schon der nächste Termin an.\\c\\nDu hast heute gut gekämpft.\\nBis zum nächsten Mal![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
