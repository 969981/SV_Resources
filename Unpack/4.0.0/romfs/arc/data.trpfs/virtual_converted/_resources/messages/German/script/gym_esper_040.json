          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_esper_040_receptionist_01",
      "hash64": "1F919732251A207B",
      "text": "Möchtest du Arenaleiterin Tulia, das magische\\nMake-up-Wunder, herausfordern?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "gym_esper_040_receptionist_02",
      "hash64": "1F919832251A222E",
      "text": "Dann bringe ich dich jetzt zum Kampfplatz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_esper_040_receptionist_03",
      "hash64": "1F919932251A23E1",
      "text": "Sag einfach Bescheid, sobald du bereit bist!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_esper_040_esper_entry_01",
      "hash64": "EA01E71F5103C776",
      "text": "Verstehe... Okay. Dann werde ich alles in Gang\\nsetzen.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_esper_040_esper_entry_02",
      "hash64": "EA01E61F5103C5C3",
      "text": "Der Slogan sollte kurz und knackig sein.\\nEtwas Einfaches wie „Natürlich schön“.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_esper_040_esper_entry_03",
      "hash64": "EA01E51F5103C410",
      "text": "Oh, und denk bitte dran, die neue\\nLidschattenfarbe zu bestellen![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_esper_040_esper_entry_04",
      "hash64": "EA01EC1F5103CFF5",
      "text": "Danke! Ich muss jetzt auflegen, wir hören uns\\nspäter![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_esper_040_esper_01",
      "hash64": "A1A3806506F21EE3",
      "text": "Hallo! Sei gegrüßt![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_esper_040_esper_02",
      "hash64": "A1A3816506F22096",
      "text": "Ich bin Arenaleiterin Tulia. In erster Linie arbeite\\nich aber als Make-up-Artist![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_esper_040_esper_03",
      "hash64": "A1A3826506F22249",
      "text": "Amura hat dich in den höchsten Tönen gelobt.\\nSie meinte, dass du eine grandiose Figur\\r\\nabgegeben hättest![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_esper_040_esper_04",
      "hash64": "A1A3836506F223FC",
      "text": "Hihi... Ich muss schon sagen, du bist [VAR 0x1100(00FF,0403,0000)]eineine ziemlich\\n[VAR 0x1100(00FF,1819,0000)]niedlicher Herausfordererniedliche Herausforderin, [VAR 0x0100(0000)]![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0403",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1819",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_esper_040_esper_05",
      "hash64": "A1A3846506F225AF",
      "text": "Meine Gefühlsgymnastik scheint deine innere\\nSchönheit zum Vorschein gebracht zu haben.\\r\\nDu strahlst ja richtig![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_esper_040_esper_06",
      "hash64": "A1A3856506F22762",
      "text": "Und wie ich sehe, legst du auch Wert auf das\\nErscheinungsbild deine[VAR 0x1101(00FD,0101)]sr Pokémon.\\c\\nDu hast ein Auge für Ästhetik![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_esper_040_esper_06b",
      "hash64": "9B02AAAACD784500",
      "text": "[EMPTY 30]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_esper_040_esper_07",
      "hash64": "A1A3866506F22915",
      "text": "Ein gepflegtes Äußeres ist nicht nur wichtig für\\nMenschen, sondern auch für Pokémon.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_esper_040_esper_08",
      "hash64": "A1A3876506F22AC8",
      "text": "Mit Make-up kann jeder selbst bestimmen,\\nwas für einen Eindruck er erwecken möchte.\\r\\nEs ist wie Zauberei![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_esper_040_esper_09",
      "hash64": "A1A3886506F22C7B",
      "text": "Lass mich mein Können beweisen und dein[VAR 0x1101(00FD,0100)]e\\nsüße[VAR 0x1101(00FD,0101)]sn Pokémon noch viel schöner machen![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_esper_040_esper_10",
      "hash64": "A1A7056506F536B9",
      "text": "Ich habe verloren... Und nicht nur das, sogar\\ndeine Schönheit war meiner ebenbürtig...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_esper_040_esper_11",
      "hash64": "A1A7046506F53506",
      "text": "Du bist wirklich klasse! Einfach Spitzenklasse![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_esper_040_esper_12",
      "hash64": "A1A7036506F53353",
      "text": "Vielleicht sollte ich dich unter meine Fittiche\\nnehmen, bevor du anderswo groß rauskommst...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_esper_040_esper_13",
      "hash64": "A1A7026506F531A0",
      "text": "Aber zuvor muss ich wohl erst mal an meinen\\neigenen Fähigkeiten feilen.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_esper_040_esper_14",
      "hash64": "A1A7096506F53D85",
      "text": "Wie auch immer... Herzlichen Glückwunsch,\\n[VAR 0x0100(0000)]!\\c\\nLass mich dir deinen Arenaorden in einer ganz\\nbesonderen Pose überreichen.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_esper_040_esper_badge",
      "hash64": "4A010119989BC04B",
      "text": "Da du nun [VAR 0x0200(0001)] Arenaorden besitzt, lassen sich\\nPokémon bis Level [VAR 0x0201(0002)] leichter fangen und\\r\\ngehorchen auch deinen Befehlen.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
