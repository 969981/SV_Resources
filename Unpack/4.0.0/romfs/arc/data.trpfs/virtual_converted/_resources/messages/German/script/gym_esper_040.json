      "hash64": "1F919632251A1EC8",
      "text": "[VAR 0xBD06(0000)]Willkommen in der Arena von Asarilla,\\n[VAR 0x0100(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
