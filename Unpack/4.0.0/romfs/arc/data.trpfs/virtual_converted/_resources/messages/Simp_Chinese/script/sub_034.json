      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_034_ecology_01",
      "hash64": "AE533AC3090DFAB8",
      "text": "[VAR 0x0100(0000)]！我是吉尼亚！！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
