          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_head_c_05",
      "hash64": "76682E4437B094C8",
      "text": "最近的年轻人觉得\\n怎样的男生发型比较帅，\\r\\n你知道吗？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
