      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_head_c_06b",
      "hash64": "E3A539EAA114D999",
      "text": "飞机头！果然是这样！！\\n虽说如此，好像几乎看不到\\r\\n留飞机头的男生……[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
