          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_head_c_04",
      "hash64": "76682F4437B0967B",
      "text": "对了，又有一件事\\n想听听你的意见。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
