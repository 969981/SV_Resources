      "ordinal": 9,
      "label": "sdc01_0270_sister_01",
      "hash64": "6BF99B9C344CF7C5",
      "text": "我会随便搞一搞的，\\n你也要加油哦。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
