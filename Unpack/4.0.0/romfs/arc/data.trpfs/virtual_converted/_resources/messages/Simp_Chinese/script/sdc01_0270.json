      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0270_brother_04",
      "hash64": "93F20DEBBB14F792",
      "text": "介……介绍牌！\\n最后一个有点远。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
