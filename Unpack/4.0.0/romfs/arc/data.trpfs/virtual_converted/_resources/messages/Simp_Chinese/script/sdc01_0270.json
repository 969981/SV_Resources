    {
      "ordinal": 8,
      "label": "sdc01_0270_brother_06",
      "hash64": "93F20BEBBB14F42C",
      "text": "为什么？…………骗子。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
