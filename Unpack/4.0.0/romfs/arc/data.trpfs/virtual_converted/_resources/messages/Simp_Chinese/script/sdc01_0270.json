    {
      "ordinal": 1,
      "label": "sdc01_0270_brother_02",
      "hash64": "93F207EBBB14ED60",
      "text": "我想……问你！\\n刚才你和我姐……\\r\\n都说了些什么……呀？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
