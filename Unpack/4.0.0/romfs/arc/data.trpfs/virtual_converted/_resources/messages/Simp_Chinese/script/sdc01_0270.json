    },
    {
      "ordinal": 7,
      "label": "sdc01_0270_brother_05",
      "hash64": "93F20EEBBB14F945",
      "text": "那啥，我们走吧。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
