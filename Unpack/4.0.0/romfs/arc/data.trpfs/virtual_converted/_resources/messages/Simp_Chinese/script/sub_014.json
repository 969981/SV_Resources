{
  "version": "4.0.0",
  "language": "zh-Hans",
  "language_raw": "Simp_Chinese",
  "source": "message/dat/Simp_Chinese/script/sub_014.dat",
  "paired_tbl": "message/dat/Simp_Chinese/script/sub_014.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_014_system_kui_01",
      "hash64": "1A7B3A8AE0ECFF5D",
      "text": "这里埋着漆黑且\\n充满不祥气息的桩子……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_014_system_kui_02",
      "hash64": "1A7B378AE0ECFA44",
      "text": "要把桩子拔出来吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_014_system_kui_03",
      "hash64": "1A7B388AE0ECFBF7",
      "text": "桩子被拔出后，\\n崩裂成碎屑消失了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_014_system_kui_04",
      "hash64": "1A7B358AE0ECF6DE",
      "text": "咕……叮……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_014_system_kui_05",
      "hash64": "1A7B368AE0ECF891",
      "text": "从祠的方向传来了\\n神秘的声音……！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_014_system_release_01",
      "hash64": "A5872331365DB1CF",
      "text": "祠里传出\\n微弱的声音……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_014_system_release_02",
      "hash64": "A5872431365DB382",
      "text": "要触摸祠吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_014_system_release_03",
      "hash64": "A5872531365DB535",
      "text": "咔嗒咔嗒　咔嗒咔嗒……\\n喀哒喀哒喀哒　喀哒喀哒！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_014_system_release_07",
      "hash64": "A5872131365DAE69",
      "text": "嘎哒～！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_014_system_release_04",
      "hash64": "A5871E31365DA950",
      "text": "咕叮叮！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_014_system_release_05",
      "hash64": "A5871F31365DAB03",
      "text": "古鼎鹿被再次\\n封印在祠里了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_014_system_release_06",
      "hash64": "A5872031365DACB6",
      "text": "看起来祠的门\\n暂时不会打开了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_014_system_hokora_01",
      "hash64": "FB3D6C305BC176A6",
      "text": "祠里刻着\\n模糊的文字……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_014_system_hokora_02",
      "hash64": "FB3D6B305BC174F3",
      "text": "灾祸之鼎封印于此",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_014_system_hokora_03",
      "hash64": "FB3D6A305BC17340",
      "text": "灾祸之鼎封印已解",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
