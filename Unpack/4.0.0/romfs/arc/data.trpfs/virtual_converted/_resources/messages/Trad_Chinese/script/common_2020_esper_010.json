          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_esper_010_esper_07",
      "hash64": "49A59D62ABD9D429",
      "text": "對手是[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳的話，\\n莉普我就能無拘無束地展現實力了。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
