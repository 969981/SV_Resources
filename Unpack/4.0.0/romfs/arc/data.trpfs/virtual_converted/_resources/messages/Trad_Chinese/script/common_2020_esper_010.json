    },
    {
      "ordinal": 6,
      "label": "common_2020_esper_010_esper_04",
      "hash64": "49A59A62ABD9CF10",
      "text": "哦……[VAR 0x0100(0000)]，\\n[VAR 0x1100(00FF,0101)]你妳是也慈的代理人呀？[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
