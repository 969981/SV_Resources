      "hash64": "2E948E3A4B50B1D3",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)]\\n[VAR 0xFF00(0008)]다양한 식재료[VAR 0xFF00(0000)]를 손에 넣었다!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
