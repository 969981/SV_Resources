          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sub_043_picnicnpc_07_02",
      "hash64": "E85BB7E7389DCC4E",
      "text": "스시는 보통\\n빵이 아니라 밥에 얹어서 먹잖아?\\c\\n...다시 말해, 스시를 빵에 얹으면\\n두 배로 맛있다는 거지!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sub_043_picnicnpc_07_06",
      "hash64": "E85BBBE7389DD31A",
      "text": "호수에서 만난 것도 인연인데\\n잠깐 쉬다 갈래?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "sub_043_picnicnpc_07_03",
      "hash64": "E85BB8E7389DCE01",
      "text": "호숫가에서 피크닉이라니,\\n멋지지 않니!? 잠깐 쉬다 갈래?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "sub_043_picnicnpc_07_04",
      "hash64": "E85BB9E7389DCFB4",
      "text": "어째서 호숫가에 있으면\\n이렇게 기분이 좋은 걸까?\\r\\n호수 덕분에 완전히 힐링된 것 같지 않아?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "sub_043_picnicnpc_07_05",
      "hash64": "E85BBAE7389DD167",
      "text": "호수를 느끼고 싶으면\\n언제든지 말을 걸어 줘!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
