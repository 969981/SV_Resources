          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sub_043_picnicnpc_system_02",
      "hash64": "2E948F3A4B50B386",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)] 다양한 식재료를\\n[VAR 0xFF00(0008)]피크닉[VAR 0xFF00(0000)] 포켓에 넣었다.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "1900",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_043_picnicnpc_01_01",
      "hash64": "64A882D93AB48EBD",
      "text": "아까 식재료를 너무 많이 사 버려서 말이야.\\n너한테도 조금 나눠 줄까?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_043_picnicnpc_01_02",
      "hash64": "64A87FD93AB489A4",
      "text": "피크닉 하면\\n역시 샌드위치지!\\r\\n내가 준 식재료로 만들어 보렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_043_picnicnpc_01_06",
      "hash64": "64A87BD93AB482D8",
      "text": "그건 그렇고, 내가 연 피크닉에서\\n포켓몬이랑 쉬다 가지 않을래?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_043_picnicnpc_01_03",
      "hash64": "64A880D93AB48B57",
      "text": "내 피크닉에 잘 왔어.\\n포켓몬이랑 쉬다 가지 않을래?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_043_picnicnpc_01_04",
      "hash64": "64A87DD93AB4863E",
      "text": "너도 포켓몬도\\n기운이 넘치는구나!\\r\\n언제든지 쉬러 오렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_043_picnicnpc_01_05",
      "hash64": "64A87ED93AB487F1",
      "text": "지쳤을 때 너무 무리하면 안 좋으니까\\n언제든지 쉬러 오렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_043_picnicnpc_02_01",
      "hash64": "B6B642BD7F6412CA",
      "text": "가방에 식재료를 너무 많이 넣었나 봐!\\n너한테도 나눠 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_043_picnicnpc_02_02",
      "hash64": "B6B641BD7F641117",
      "text": "밖에서 먹는 샌드위치는 최고라구!\\n너도 내가 나눠 준 걸로 만들어 봐!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_043_picnicnpc_02_06",
      "hash64": "B6B63DBD7F640A4B",
      "text": "괜찮다면 나랑 같이 피크닉하면서\\n잠깐 쉬는 건 어때?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_043_picnicnpc_02_03",
      "hash64": "B6B640BD7F640F64",
      "text": "나랑 같이 피크닉하면서\\n잠깐 쉬는 건 어때?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_043_picnicnpc_02_04",
      "hash64": "B6B63FBD7F640DB1",
      "text": "너도 포켓몬도\\n기운이 넘치는 것 같네!\\r\\n언제든지 놀러 와!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_043_picnicnpc_02_05",
      "hash64": "B6B63EBD7F640BFE",
      "text": "사양하지 않아도 되는데~\\n언제든지 놀러 와!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_043_picnicnpc_03_01",
      "hash64": "638C6EC7903E8A3F",
      "text": "여기는 테이블시티와\\n보울마을의 가운데 지점이야!\\c\\n샌드위치를 먹고\\n다시 힘내서 모험해야지~!\\c\\n...너도 힘내라는 뜻으로\\n식재료를 나눠 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sub_043_picnicnpc_03_02",
      "hash64": "638C6FC7903E8BF2",
      "text": "그러고 보니, 이 주변에 움직이는 암벽이\\n있다고 들었는데, 진짜일까?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_043_picnicnpc_03_06",
      "hash64": "638C6BC7903E8526",
      "text": "벽이 움직여도 놀라지 않게\\n잠깐 쉬다 가지 않을래?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sub_043_picnicnpc_03_03",
      "hash64": "638C70C7903E8DA5",
      "text": "힘이 조금 떨어졌니?\\n잠깐 쉬다 가지 않을래?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sub_043_picnicnpc_03_04",
      "hash64": "638C69C7903E81C0",
      "text": "사람이든 포켓몬이든\\n힘을 내려면 휴식도 필요해!\\r\\n힘들면 언제든지 오도록 해!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sub_043_picnicnpc_03_05",
      "hash64": "638C6AC7903E8373",
      "text": "그렇구나!\\n너무 무리하지 않게 조심해~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sub_043_picnicnpc_04_01",
      "hash64": "937E7EF1480603A4",
      "text": "언덕길이 생각보다\\n가팔라서 지쳤어...\\c\\n이럴 때는 식사하면서\\n몸과 마음을 리프레시하는 게 최고지!\\c\\n식재료를 나눠 줄 테니까\\n너도 리프레시하도록 하렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sub_043_picnicnpc_04_02",
      "hash64": "937E81F1480608BD",
      "text": "배가 고프면\\n힘을 내야 할 때 낼 수 없으니까!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sub_043_picnicnpc_04_06",
      "hash64": "937E7DF1480601F1",
      "text": "이렇게 만난 것도 인연인데\\n겸사겸사 리프레시하고 갈래?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "sub_043_picnicnpc_04_03",
      "hash64": "937E80F14806070A",
      "text": "너도 언덕길을 오르느라 지쳤니?\\n잠깐 리프레시하고 갈래?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "sub_043_picnicnpc_04_04",
      "hash64": "937E7BF14805FE8B",
      "text": "맛있는 식사로 리프레시!!\\n곤란할 때는 서로 도와야지!\\r\\n또 힘들어지면 언제든지 말을 걸어 줘!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sub_043_picnicnpc_04_05",
      "hash64": "937E7AF14805FCD8",
      "text": "역시 젊은 애는 다르구나!\\n아~ 부러워라~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "sub_043_picnicnpc_05_01",
      "hash64": "C0CBEAF7AA858279",
      "text": "멋진 경치를 보면서 먹는 샌드위치는\\n그 맛이 정말 각별하단다!\\c\\n우리의 만남을 기념하는 뜻으로 선물을 주마!\\n너도 여행을 맛보도록 하려무나!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sub_043_picnicnpc_05_02",
      "hash64": "C0CBE7F7AA857D60",
      "text": "샌드위치를 먹으면\\n식사 파워가 마구 솟아나서\\r\\n여행이 즐거워진단다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sub_043_picnicnpc_05_06",
      "hash64": "C0CBEBF7AA85842C",
      "text": "겸사겸사 여기서 잠깐\\n쉬다 가지 않을래?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "sub_043_picnicnpc_05_03",
      "hash64": "C0CBE8F7AA857F13",
      "text": "가끔은 발걸음을 멈추고\\n경치를 구경하며 쉬어 보는 게 어떠냐?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "sub_043_picnicnpc_05_04",
      "hash64": "C0CBEDF7AA858792",
      "text": "열심히 하는 것도 중요하지만\\n가끔은 발걸음을 멈춰 보렴!\\r\\n그래야만 볼 수 있는 경치도 있는 법이란다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sub_043_picnicnpc_05_05",
      "hash64": "C0CBEEF7AA858945",
      "text": "치열하게 사는 게 나쁜 건 아니지!\\n혹시 발걸음을 멈추고 싶어지거든\\r\\n언제든지 오려무나!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sub_043_picnicnpc_06_01",
      "hash64": "BC54AAE0D733B186",
      "text": "마리네이드 시장에서\\n식재료를 싼값에 샀어!!\\c\\n다 먹기에는 좀 많은 거 같으니까\\n너한테도 나눠 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sub_043_picnicnpc_06_02",
      "hash64": "BC54A9E0D733AFD3",
      "text": "친구와 요리할 때\\n다양한 식재료를 가져가면\\c\\n특이한 샌드위치를 만들 수 있어서\\n재미있지 않니?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sub_043_picnicnpc_06_06",
      "hash64": "BC54ADE0D733B69F",
      "text": "...그렇지! 이 주변은 길이 험하니까\\n잠깐 쉬다 가도록 하렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "sub_043_picnicnpc_06_03",
      "hash64": "BC54A8E0D733AE20",
      "text": "여기서부터는 북쪽으로 가든 남쪽으로 가든\\n모두 험하니까, 잠깐 쉬다 가도록 하렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "sub_043_picnicnpc_06_04",
      "hash64": "BC54AFE0D733BA05",
      "text": "푹 쉬었지?\\n그럼 모험 잘 다녀오렴~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "sub_043_picnicnpc_06_05",
      "hash64": "BC54AEE0D733B852",
      "text": "서쪽에 있는 마리네이드마을에 가는 거니?\\n내가 괜한 참견을 했나 보구나~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "sub_043_picnicnpc_07_01",
      "hash64": "E85BB6E7389DCA9B",
      "text": "오야 호수에서 특이한 포켓몬을 보고\\n영감이 떠올랐어!\\c\\n부디 이 혼신을 담은 레시피로\\n샌드위치를 만들어 줘!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sub_043_picnicnpc_addrecipe_01",
      "hash64": "62CED2584FF6130B",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)] [VAR 0xFF00(0006)]스시 스타일 샌드위치[VAR 0xFF00(0000)]를\\n만들 수 있게 되었다!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
