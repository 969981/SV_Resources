          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
