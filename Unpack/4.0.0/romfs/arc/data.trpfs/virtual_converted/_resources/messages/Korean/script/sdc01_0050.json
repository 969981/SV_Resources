    {
      "ordinal": 0,
      "label": "sdc01_0050_brother_01",
      "hash64": "6A1E75D8B21FCBD1",
      "text": "누나!\\n저기 봐! 저기![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
