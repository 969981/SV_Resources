    {
      "ordinal": 0,
      "label": "common_2020_denki_020_denki_01",
      "hash64": "07B49E6934A10756",
      "text": "’Ello, ’ello, hola! Ciao and bonjour! Welcome to\\nthe Iono Zone! It’s me, Iono![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
