      "ordinal": 58,
      "label": "ajito_honoo_040_honooboss_27",
      "hash64": "2B2D2FFF78CE1498",
      "text": "实际上用它对付的\\n第一个对手还是你们呢。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
