          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_honoo_040_system_01",
      "hash64": "9EE80FCAB57DB6D1",
      "text": "１年零几个月前……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "ajito_honoo_040_honooboss_01",
      "hash64": "2B3421FF78D41B7C",
      "text": "……哎呀呀，赶上了啊。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_honoo_040_kakutouboss_01",
      "hash64": "A93E42F7A9667E69",
      "text": "梅洛，欢迎你回来！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_honoo_040_honooboss_02",
      "hash64": "2B3424FF78D42095",
      "text": "……我让几只炭小侍\\n完成了进化。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_honoo_040_honooboss_03",
      "hash64": "2B3423FF78D41EE2",
      "text": "这下大概可以解决动力不足的问题了吧。\\n天星队车应该也能动了。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_honoo_040_dokuboss_01",
      "hash64": "8CB3ED175179BD66",
      "text": "妙哉，奥尔迪加大人。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "ajito_honoo_040_fairyboss_01",
      "hash64": "553BCCF0C90A095A",
      "text": "我还以为你光说不练呢……[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_honoo_040_honooboss_04",
      "hash64": "2B341EFF78D41663",
      "text": "闭嘴！你总是多一句不该说的话！\\n你这一点真的很烦人！[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_honoo_040_fairyboss_02",
      "hash64": "553BCBF0C90A07A7",
      "text": "梅洛可你不是也和我差不多吗……[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_honoo_040_fairyboss_03",
      "hash64": "553BCAF0C90A05F4",
      "text": "你说话难听，态度又差，\\n所以才会让人看不顺眼，不是吗？[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_honoo_040_kakutouboss_02",
      "hash64": "A93E3FF7A9667950",
      "text": "不是这样的哦，奥尔。[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_honoo_040_kakutouboss_03",
      "hash64": "A93E40F7A9667B03",
      "text": "梅洛是个可爱的女孩，\\n这让她招来了其他女孩的嫉恨，\\r\\n所以才故意把话说得很难听。[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_honoo_040_kakutouboss_04",
      "hash64": "A93E45F7A9668382",
      "text": "嗯……所以这么做的结果\\n就是会让人看不顺眼啊。[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "ajito_honoo_040_honooboss_05",
      "hash64": "2B341DFF78D414B0",
      "text": "哎哎！\\n枇琶姐，你饶了我吧！[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "ajito_honoo_040_akuboss_01",
      "hash64": "5091DFE52308FB9C",
      "text": "差不多到此为止吧。\\n时间快到了。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "ajito_honoo_040_kakutouboss_06",
      "hash64": "A93E43F7A966801C",
      "text": "终于要开始了啊，天星大作战……[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_honoo_040_dokuboss_02",
      "hash64": "8CB3EC175179BBB3",
      "text": "话说，真老大作何打算？[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_honoo_040_akuboss_02",
      "hash64": "5091E2E5230900B5",
      "text": "这个啊，真老大说已经把那些\\n爱霸凌人的学生都叫到操场去了。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "ajito_honoo_040_honooboss_06",
      "hash64": "2B3420FF78D419C9",
      "text": "终于要开始了啊……！\\n燃起来了……我燃起来了！[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_honoo_040_honooboss_07",
      "hash64": "2B341FFF78D41816",
      "text": "燃啊燃，燃啊燃……\\n结果燃烧殆尽了啊。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_honoo_040_honooboss_08",
      "hash64": "2B342AFF78D42AC7",
      "text": "……到此为止了啊。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "ajito_honoo_040_honooboss_09",
      "hash64": "2B3429FF78D42914",
      "text": "你的[VAR 0x0101(0001)]\\n真是气势十足啊。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "ajito_honoo_040_honooboss_10",
      "hash64": "2B309CFF78D103A6",
      "text": "你打赢了我！\\n挺起胸膛地把团队徽章拿去吧！[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "ajito_honoo_040_waza_01",
      "hash64": "CDBA474C243C00C9",
      "text": "爱怎样就怎样吧。\\n招式学习器也拿去好了。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "ajito_honoo_040_honooboss_11",
      "hash64": "2B309DFF78D10559",
      "text": "你可别误会。\\n我给的不是你。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "ajito_honoo_040_honooboss_12",
      "hash64": "2B309AFF78D10040",
      "text": "我给的是[VAR 0x0101(0001)]哦……[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "ajito_honoo_040_honooboss_13",
      "hash64": "2B309BFF78D101F3",
      "text": "……你没事了吧？\\n让我一个人呆着吧。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "ajito_honoo_040_nelke_01",
      "hash64": "CC8F565F3859C6EF",
      "text": "天星队的梅洛可，\\n我希望你能见一只宝可梦。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "ajito_honoo_040_honooboss_14",
      "hash64": "2B30A0FF78D10A72",
      "text": "……你谁啊？[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "ajito_honoo_040_nelke_02",
      "hash64": "CC8F575F3859C8A2",
      "text": "[EMPTY 64]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
