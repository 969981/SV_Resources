    },
    {
      "ordinal": 43,
      "label": "ajito_honoo_040_honooboss_20",
      "hash64": "2B2D36FF78CE207D",
      "text": "只要看看它的火焰摇曳的样子，\\n想猜出它在想什么就不是难事。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
