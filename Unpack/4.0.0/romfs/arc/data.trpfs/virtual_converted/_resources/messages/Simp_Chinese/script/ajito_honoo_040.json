          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_honoo_040_honooboss_15",
      "hash64": "2B30A1FF78D10C25",
      "text": "炭小侍？\\n不对， 你是……[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "ajito_honoo_040_poke_02",
      "hash64": "C7BCCDDB51166024",
      "text": "炭炭！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "ajito_honoo_040_honooboss_16",
      "hash64": "2B309EFF78D1070C",
      "text": "你是炭次郎吗……\\n为什么你会……[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
