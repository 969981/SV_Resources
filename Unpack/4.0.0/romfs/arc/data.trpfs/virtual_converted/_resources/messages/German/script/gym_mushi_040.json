          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_mushi_040_receptionist_01",
      "hash64": "6C45357949483B90",
      "text": "Möchtest du Arenaleiterin Ronah, die honigsüße\\nKäferkönigin, herausfordern?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mushi_040_receptionist_02",
      "hash64": "6C453879494840A9",
      "text": "Dann bringe ich dich jetzt zum Kampfplatz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mushi_040_receptionist_03",
      "hash64": "6C45377949483EF6",
      "text": "Sag einfach Bescheid, sobald du bereit bist!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mushi_040_mushi_entry_01",
      "hash64": "646E2CD7DF034FC2",
      "text": "Iss schön auf, mein liebes kleines Vivillon...[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_mushi_040_poke_entry_01",
      "hash64": "65F00449FA87129F",
      "text": "Vivillon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_mushi_040_mushi_01",
      "hash64": "873EDBF65FF9575F",
      "text": "Na, wen haben wir denn da? Du bist aber [VAR 0x1100(00FF,0403,0000)]eineine\\n[VAR 0x1100(00FF,1514,0000)]entzückender Trainerentzückende Trainerin![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0403",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1514",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mushi_040_mushi_02",
      "hash64": "873EDCF65FF95912",
      "text": "Vielen Dank für deine Hingabe beim\\nOlivenrollen![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_mushi_040_mushi_03",
      "hash64": "873EDDF65FF95AC5",
      "text": "Oh, ich habe mich noch gar nicht vorgestellt,\\noder?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_mushi_040_mushi_04",
      "hash64": "873ED6F65FF94EE0",
      "text": "Ich bin Ronah, die Inhaberin der\\nKonditorei Mukorossi.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mushi_040_mushi_05",
      "hash64": "873ED7F65FF95093",
      "text": "Ach, Moment! Wir sind ja hier auf dem\\nKampfplatz der Moldrid-Arena.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_mushi_040_mushi_06",
      "hash64": "873ED8F65FF95246",
      "text": "Verzeihung. Ich bin Ronah, die Arenaleiterin hier![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_mushi_040_mushi_07",
      "hash64": "873ED9F65FF953F9",
      "text": "Wenn ich nicht meinen Pflichten in dieser Arena\\nnachgehe, arbeite ich als Konditorin und kreiere\\r\\nsüße Leckereien.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_mushi_040_mushi_08",
      "hash64": "873EE2F65FF96344",
      "text": "Was haben Süßigkeiten, die dich mit einem\\nBissen glücklich machen, und Käfer-Pokémon,\\r\\ndie sich in Pflanzen verstecken, gemeinsam?\\c\\nBeide mögen klein sein, können aber einen\\nbleibenden Eindruck hinterlassen![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 211,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_mushi_040_mushi_09",
      "hash64": "873EE3F65FF964F7",
      "text": "Bleib standhaft, sonst hauen wir dich aus den\\nSocken![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mushi_040_mushi_10",
      "hash64": "874260F65FFC6F35",
      "text": "Sogar während des Kampfes wächst deine\\nKraft wie ein guter Hefeteig![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_mushi_040_mushi_11",
      "hash64": "87425FF65FFC6D82",
      "text": "Ich selbst muss mich wohl noch weiterentwickeln...[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_mushi_040_mushi_12",
      "hash64": "87425EF65FFC6BCF",
      "text": "Meinen allersüßesten Glückwunsch,\\ndu hast gewonnen!\\c\\nIch überreiche dir diesen Arenaorden als Zeichen\\ndafür, dass du mich besiegt hast.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_mushi_040_mushi_16",
      "hash64": "87425AF65FFC6503",
      "text": "Hier, gönn dir ruhig auch diese selbst gebackene\\nLeckerei à la Ronah.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_mushi_040_mushi_badge",
      "hash64": "03E0CD0DB4E5B087",
      "text": "Wenn du [VAR 0x0200(0001)] Arenaorden hast, lassen sich Pokémon\\nbis Level [VAR 0x0201(0002)] leichter fangen und gehorchen dir.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_mushi_040_mushi_badge_all",
      "hash64": "7357E0542B75F0CB",
      "text": "Wenn du acht Arenaorden hast, kannst du alle\\nPokémon fangen und sie gehorchen dir, ohne zu\\r\\nzögern![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_mushi_040_mushi_waza",
      "hash64": "54D7588FA1FEE21D",
      "text": "Hihi, die Leckerei scheint dir ja gut geschmeckt zu\\nhaben. Möchtest du zum Nachtisch noch eine TM?[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_mushi_040_mushi_13",
      "hash64": "87425DF65FFC6A1C",
      "text": "Wusstest du, dass du mit einer TM-Maschine\\nmehr von den TMs herstellen kannst, die du\\r\\nwährend deines Abenteuers erhalten hast?[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_mushi_040_mushi_14",
      "hash64": "87425CF65FFC6869",
      "text": "Möge dir eine honigsüße Zukunft bevorstehen![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_mushi_040_mushi_15",
      "hash64": "87425BF65FFC66B6",
      "text": "Hoffentlich sehen wir uns mal wieder![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_mushi_040_receptionist_04",
      "hash64": "6C453A794948440F",
      "text": "Glückwunsch zu deinem Sieg in der Arena von\\nMoldrid!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
