          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_history_d_02",
      "hash64": "66311AE071DD1268",
      "text": "Geh der Sache doch mal nach, wenn du Lust hast![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_history_d_03",
      "hash64": "66311BE071DD141B",
      "text": "Hm... Sieht nicht so aus, als hättest du neue\\nErkenntnisse zu den Schätzen des Unheils\\r\\ngewonnen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_history_d_04a",
      "hash64": "8297D8617AB83E81",
      "text": "Oh! Du hast Dinglu, das Gefäß des Unheils,\\ngefangen?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_history_d_04b",
      "hash64": "8297D5617AB83968",
      "text": "Oh! Du hast Baojian, das Schwert des Unheils,\\ngefangen?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_history_d_04c",
      "hash64": "8297D6617AB83B1B",
      "text": "Oh! Du hast Chongjian, die Holztafeln des\\nUnheils, gefangen?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_history_d_04d",
      "hash64": "8297DB617AB8439A",
      "text": "Oh! Du hast Yuyu, die Juwelen des Unheils,\\ngefangen?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_history_d_05",
      "hash64": "663121E071DD1E4D",
      "text": "Unfassbar! Ich glaub’s ja nicht, wie faszinierend!\\nIch krieg mich vor lauter Neugier kaum noch ein![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_history_d_06a",
      "hash64": "8290CC617AB20B6F",
      "text": "Wenn ich mir Form und Größe des Gefäßes so\\nansehe, kann ich mir kaum vorstellen, dass es sich\\r\\ndabei um einen Alltagsgegenstand handelte.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_history_d_07a",
      "hash64": "8293B0617AB411B2",
      "text": "Vielleicht war es ein Kunstobjekt? Oder diente es\\nals ritueller Gegenstand, mit dem einer Gottheit\\r\\ngehuldigt wurde?![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_history_d_08a",
      "hash64": "826ED0617A952BD5",
      "text": "Mich beschleicht das Gefühl, hinter den Hörnern\\nund dem an Augen erinnernden Muster könnte\\r\\nsich ein tieferer Sinn verbergen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_history_d_09a",
      "hash64": "8271B4617A973218",
      "text": "Ob es wohl möglich ist, dass die Gottheit,\\nder gehuldigt wurde, aussah wie dieses Gefäß?![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_history_d_06b",
      "hash64": "8290CD617AB20D22",
      "text": "Griff und Klinge des Schwertes stellen also den\\nlinken und rechten Fangzahn des Pokémon dar![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_history_d_07b",
      "hash64": "8293AF617AB40FFF",
      "text": "Da fragt man sich doch, ob es erst zerbrach,\\nals es sich in ein Pokémon verwandelte...\\c\\nOder war das Schwert womöglich schon immer\\nentzwei?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_history_d_08b",
      "hash64": "826ECD617A9526BC",
      "text": "Nein... Der König wird wohl kaum ein kaputtes\\nSchwert gekauft haben.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_history_d_09b",
      "hash64": "8271B7617A973731",
      "text": "Oder könnte es gerade eben Zweck dieser Waffe\\ngewesen sein, sie in diesem entzweiten Zustand\\r\\nzu verwenden?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_history_d_06c",
      "hash64": "8290CE617AB20ED5",
      "text": "Ich habe noch nie zuvor derart viele miteinander\\nverbundene Holztafeln gesehen. Das muss ja ein\\r\\nwahres Epos gewesen sein![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_history_d_07c",
      "hash64": "8293AE617AB40E4C",
      "text": "Bei den meisten Ausgrabungen werden allenfalls\\nTafeln freigelegt, auf denen sich Kritzeleien oder\\r\\neinfache Botschaften finden lassen.\\c\\nAuch bei ihnen handelt es sich natürlich um\\nwertvolle Zeugen ihrer Zeit! Aber das hier...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 229,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_history_d_08c",
      "hash64": "826ECE617A95286F",
      "text": "Lesen kann ich sie nicht, aber so umfangreich\\nkann eigentlich nur eine Erzählung sein.\\c\\nOder sind es die Worte eines Fluchs?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_history_d_09c",
      "hash64": "8271B6617A97357E",
      "text": "Zu dumm, dass die Schriftzeichen verblasst sind!\\c\\nImmerhin haben diese Tafeln einst die Neugier\\neines Königs entfacht... Was mag nur auf ihnen\\r\\ngestanden haben?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 164,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_history_d_06d",
      "hash64": "8290C7617AB202F0",
      "text": "Juwelen wie diese galten als heilig und wurden\\ndaher vor allem während Ritualen getragen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_history_d_07d",
      "hash64": "8293AD617AB40C99",
      "text": "Üblicherweise trug man ein einzelnes Juwel um\\nden Hals, aber Yuyu scheint vier davon zu haben.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_history_d_08d",
      "hash64": "826ECB617A952356",
      "text": "Vielleicht trug man sie ja in Paaren, etwa an den\\nOhren oder Handgelenken...\\c\\nOder wurden die Rituale möglicherweise stets\\nzu viert ausgeführt...?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_history_d_09d",
      "hash64": "8271B9617A973A97",
      "text": "Was in aller Welt könnte dazu geführt haben,\\ndass Juwelen, die eigentlich dem Schutz vor\\r\\nUnheil dienten, es letztlich heraufbeschworen?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_history_d_10",
      "hash64": "663422E071DF55D7",
      "text": "Tja, die Sache bleibt weiterhin rätselhaft, aber...\\nHach! Mein Wissensdurst wird langsam gestillt![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_history_d_11",
      "hash64": "663421E071DF5424",
      "text": "Nanu, hast du etwa noch mehr zu berichten?\\nSchieß los![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_history_d_12",
      "hash64": "663424E071DF593D",
      "text": "Deinetwegen konnte ich mir endlich ein eigenes\\nBild machen. Ich danke dir, [VAR 0x0100(0000)]![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_history_d_13",
      "hash64": "663423E071DF578A",
      "text": "Sag mir doch bitte Bescheid, falls du noch\\nweitere Schätze des Unheils finden solltest.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_history_d_14",
      "hash64": "66341EE071DF4F0B",
      "text": "Sagenhaft! Damit hast du mir tatsächlich über\\nalle Schätze des Unheils Bericht erstattet.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_history_d_15",
      "hash64": "66341DE071DF4D58",
      "text": "Ich hätte niemals damit gerechnet, dass du mir\\neine so immense Hilfe sein würdest.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
