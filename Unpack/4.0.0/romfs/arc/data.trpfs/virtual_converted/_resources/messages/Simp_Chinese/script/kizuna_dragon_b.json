          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_dragon_b_02",
      "hash64": "268D8A536FED8D1F",
      "text": "小生有时候会来操场。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_dragon_b_03",
      "hash64": "268D89536FED8B6C",
      "text": "孩子们充满活力的样子，\\n真好啊。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_dragon_b_select_01",
      "hash64": "E0C4B9E0FB4EC661",
      "text": "是这样吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_dragon_b_select_02",
      "hash64": "E0C4B6E0FB4EC148",
      "text": "我也觉得……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_dragon_b_04a",
      "hash64": "70087DC730A13A08",
      "text": "是的，只是看着，\\n小生也能获得活力。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_dragon_b_04b",
      "hash64": "700880C730A13F21",
      "text": "唔？不知为何，\\n你的想法很成熟……\\r\\n你也是孩子中的一员呢。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_dragon_b_tamer_01",
      "hash64": "0E3DFA9305CD80EC",
      "text": "八朔大人，\\n可以借一步说话吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_dragon_b_05",
      "hash64": "268D87536FED8806",
      "text": "你……\\n为什么会来这里？[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_dragon_b_06",
      "hash64": "268D86536FED8653",
      "text": "小生明明叮嘱过那么多次\\n不要来学校。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_dragon_b_tamer_02",
      "hash64": "0E3DFD9305CD8605",
      "text": "因为对我们而言，\\n没有什么比世族更重要。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "kizuna_dragon_b_07",
      "hash64": "268D85536FED84A0",
      "text": "…………[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_dragon_b_08",
      "hash64": "268D94536FED9E1D",
      "text": "能和[VAR 0x0100(0000)]你聊天，\\n小生很是高兴。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_dragon_b_09",
      "hash64": "268D93536FED9C6A",
      "text": "小生有重要的事要办，\\n就先失陪了。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_dragon_b_system_01",
      "hash64": "D6E8E0D3CC7A7026",
      "text": "与八朔老师的关系\\n又变好了一些！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_dragon_b_10",
      "hash64": "268A06536FEA76FC",
      "text": "我们换个地方说话吧。\\n……跟小生过来。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    }
