      "hash64": "268D8B536FED8ED2",
      "text": "[VAR 0x0100(0000)]，你好啊。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
