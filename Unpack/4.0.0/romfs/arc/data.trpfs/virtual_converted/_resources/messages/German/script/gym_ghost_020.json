          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_ghost_020_receptionist_02",
      "hash64": "3C9F1986B3D99C68",
      "text": "Deine Aufgabe wird es sein, die heutige [VAR 0xFF00(0006)]Show zu[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]eröffnen[VAR 0xFF00(0000)].\\c\\nDas Vorprogramm liegt ganz in deiner Hand!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_ghost_020_receptionist_03",
      "hash64": "3C9F1A86B3D99E1B",
      "text": "Im Klartext heißt das: Begeistere das Publikum\\nmit spannenden Pokémon-Kämpfen, bevor das\\r\\nKonzert der Arenaleiterin anfängt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_ghost_020_receptionist_04",
      "hash64": "3C9F1F86B3D9A69A",
      "text": "Sprich einfach mit dem MC vor der Bühne,\\num die Arenaprüfung zu beginnen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_ghost_020_mc_01",
      "hash64": "75CFDD5A7E891CA8",
      "text": "Na, wenn das mal nicht unser heutiges\\nVorprogramm ist!\\c\\nMan nennt mich MC Reppa! Und das hinter mir\\nist unsere Bühne![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_ghost_020_mc_02",
      "hash64": "75CFE05A7E8921C1",
      "text": "Also... Du wirst für uns ein paar Doppelkämpfe\\naustragen. Das heißt, du trittst mit zwei Pokémon\\r\\ngleichzeitig an. Klar so weit?[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_ghost_020_mc_03",
      "hash64": "75CFDF5A7E89200E",
      "text": "[EMPTY 55]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
