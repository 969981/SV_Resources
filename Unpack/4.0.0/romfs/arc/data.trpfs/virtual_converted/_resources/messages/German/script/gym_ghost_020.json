          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_ghost_020_mc_05",
      "hash64": "75CFE15A7E892374",
      "text": "Wenn du die Stimmung ordentlich angeheizt hast,\\nkommt die Arenaleiterin für ihren großen Auftritt\\r\\nauf die Bühne!\\c\\nDann weißt du, dass du die Prüfung bestanden\\nhast, yeah![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 175,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_ghost_020_mc_19",
      "hash64": "75CC615A7E86141D",
      "text": "Sobald du die Bühne betrittst, beginnt die Show!\\c\\nDenk dran, dass du keinen Abgang machen\\nkannst, bevor du drei Kämpfe hintereinander\\r\\ngewonnen hast.[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 153,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_ghost_020_mc_06",
      "hash64": "75CFE45A7E89288D",
      "text": "Also, wie sieht’s aus? Bist du bereit, bei deiner\\nArenaprüfung ’ne mega Show hinzulegen?[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_ghost_020_select_01",
      "hash64": "DD14BEA998FA3570",
      "text": "Es kann losgehen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_ghost_020_select_02",
      "hash64": "DD14C1A998FA3A89",
      "text": "Noch nicht.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "gym_ghost_020_select_03",
      "hash64": "DD14C0A998FA38D6",
      "text": "Erklär mir das bitte noch mal.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_ghost_020_mc_no_double",
      "hash64": "3CE24182F9EB5218",
      "text": "Yo! Du brauchst mindestens zwei kampffähige\\nPokémon, um an der Arenaprüfung teilzunehmen.[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
