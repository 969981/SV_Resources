        }
      ]
    },
    {
      "ordinal": 65,
      "label": "coach_paldea_friend_randomtalk_01",
      "hash64": "9EB3DF09A671C872",
      "text": "北上鄉的\\n花瓣冰淇淋好好吃啊。\\c\\n這裡的食堂的話，\\n學園披薩也挺不錯的！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
