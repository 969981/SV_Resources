    {
      "ordinal": 63,
      "label": "coach_paldea_friend_battleend_lose_00_00",
      "hash64": "E3B8F1400D3B35B6",
      "text": "哦哦！我走運湊巧打贏了！\\n這就是所謂「人有失足，斑斑馬有失蹄」嗎？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
