      "ordinal": 45,
      "label": "legend_0050_mastiff_04",
      "hash64": "451819484C6623B0",
      "text": "獒呜……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 46,
      "label": "legend_0050_friend_22",
      "hash64": "F04B9B89AF79E38E",
      "text": "没关系！你放心吧！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "legend_0050_friend_23",
      "hash64": "F04B9C89AF79E541",
      "text": "我和[VAR 0x0100(0000)]\\n一定会让你恢复活力的！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
