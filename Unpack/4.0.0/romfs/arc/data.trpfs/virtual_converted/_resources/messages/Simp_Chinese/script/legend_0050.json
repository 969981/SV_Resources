          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "legend_0050_friend_24",
      "hash64": "F04B9D89AF79E6F4",
      "text": "剩下的１种调味料，\\n一定是最厉害的！[VAR 0x0114(0006)]",
