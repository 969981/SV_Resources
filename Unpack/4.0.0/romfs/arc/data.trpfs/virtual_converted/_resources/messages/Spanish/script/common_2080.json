          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2080_rival_02",
      "hash64": "9C0D5C3D3BBC2227",
      "text": "Para participar en la Gran Pugna Académica,\\nhabla antes con este empleado para inscribirte.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2080_rival_03",
      "hash64": "9C0D5B3D3BBC2074",
      "text": "Ya que estamos, ¿podrías explicarnos cuáles son\\nlas reglas del torneo, por favor?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2080_staff_01",
      "hash64": "B6EF1D39889F0EA4",
      "text": "En la Gran Pugna Académica pueden participar\\ntanto el profesorado como el alumnado.\\c\\nLos emparejamientos son aleatorios y tan solo\\nprogresarán quienes salgan victoriosos.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2080_staff_02",
      "hash64": "B6EF2039889F13BD",
      "text": "El sorteo que realiza el organizador determinará\\nlos enfrentamientos del cuadro de eliminatorias.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_2080_staff_03",
      "hash64": "B6EF1F39889F120A",
      "text": "Eso sí, hasta que no entres en la arena de\\ncombate, no sabrás quién será tu contrincante.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_2080_staff_04",
      "hash64": "B6EF1A39889F098B",
      "text": "Quien se alce con la victoria avanzará a la\\nsiguiente ronda.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_2080_staff_05",
      "hash64": "B6EF1939889F07D8",
      "text": "Pero una sola derrota supondrá automáticamente\\ntu eliminación y no podrás seguir combatiendo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_2080_staff_06",
      "hash64": "B6EF1C39889F0CF1",
      "text": "En definitiva: quien encadene una victoria tras\\notra y llegue hasta el final se convertirá en el\\r\\nEntrenador más fuerte de la academia.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2080_rival_04",
      "hash64": "9C0D5A3D3BBC1EC1",
      "text": "¡Muchas gracias por la explicación tan detallada![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2080_rival_05",
      "hash64": "9C0D593D3BBC1D0E",
      "text": "¿Sabías que las reglas las acordamos el director\\nClavel y yo?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2080_rival_06",
      "hash64": "9C0D583D3BBC1B5B",
      "text": "Si tenemos en cuenta las personas inscritas,\\nyo diría que deberías ganar cuatro combates\\r\\nsi quieres cantar victoria.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2080_rival_07",
      "hash64": "9C0D573D3BBC19A8",
      "text": "Quizá tengas que enfrentarte a profesores,\\n¡así que más te vale darlo todo![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2080_rival_08",
      "hash64": "9C0D563D3BBC17F5",
      "text": "¡La única persona que puede vencerte debo ser\\nyo![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2080_staff_07",
      "hash64": "B6EF1B39889F0B3E",
      "text": "Cuando quieras inscribirte en el torneo,\\nven a hablar conmigo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
