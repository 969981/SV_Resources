      "hash64": "9C0D5D3D3BBC23DA",
      "text": "Ey, [VAR 0x0100(0000)].[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
