    },
    {
      "ordinal": 8,
      "label": "common_0225_sitappa_b_02",
      "hash64": "0EE6063AC5DDAA25",
      "text": "Hä? Willst du was von Team Star?![VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
