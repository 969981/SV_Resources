          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0225_sitappa_b_03",
      "hash64": "0EE6053AC5DDA872",
      "text": "Wenn du bei uns mitmachen willst, dann komm\\nspäter wieder! Wir unterhalten uns hier gerade![VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0225_sitappa_a_03",
      "hash64": "37B17D2F7B043029",
      "text": "Wir sind von Team Star, wo jeder nach den\\nSternen greifen kann.\\c\\nDu hast bestimmt schon von uns gehört![VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0225_sitappa_a_04",
      "hash64": "37B17E2F7B0431DC",
      "text": "Wieso spielst du dich dann so auf?\\nHmpf...\\c\\nJemand wie du wäre bei Team Star wahrscheinlich\\nim Nullkommanichts an der Spitze. Alle hätten\\r\\nAngst vor dir. Trotzdem...[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 169,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0225_sitappa_a_05",
      "hash64": "37B17F2F7B04338F",
      "text": "Urgh, was ist denn mit dir verkehrt...? Jetzt bin\\nich Team Star schon beigetreten und muss mich\\r\\ntrotzdem behandeln lassen wie der letzte Dreck.[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0225_sitappa_b_04",
      "hash64": "0EE6003AC5DD9FF3",
      "text": "Es kann nicht angehen, dass [VAR 0x1100(00FF,0303,0000)]derdie uns nicht ernst\\nnimmt. Wenn wir das einfach auf uns sitzen lassen,\\r\\nist Team Stars Ruf gleich im Eimer.\\c\\nDa bleibt uns keine andere Wahl:\\nWir müssen kämpfen!![VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 203,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0225_sitappa_a_06",
      "hash64": "37B1802F7B043542",
      "text": "Recht hast du! Behalt du das Brillengesicht da\\ndrüben im Auge![VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0225_sitappa_a_07",
      "hash64": "37B1812F7B0436F5",
      "text": "Ich kümmere mich so lange um [VAR 0x1100(00FF,0809,0000)]den Neuendie Neue hier.\\n[VAR 0x1100(00FF,0303,0000)]DerDie wird gleich Sterne sehen![VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0809",
            "0000"
          ]
        },
        {
          "kind": "control",
