          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "common_0225_rival_03",
      "hash64": "B93CA81B98594087",
      "text": "Fängst hier einfach an, mit wildfremden Leuten\\nzu kämpfen... Dafür bin ich doch da![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "common_0225_select_03",
      "hash64": "761BEBD65A995391",
      "text": "Das ist ein Missverständnis...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "common_0225_select_04",
      "hash64": "761BECD65A995544",
      "text": "Aber Team Star...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "common_0225_rival_04",
      "hash64": "B93CA51B98593B6E",
      "text": "Was?! Oh, sorry! Dann muss ich was falsch\\nverstanden haben![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "common_0225_rival_05",
      "hash64": "B93CA61B98593D21",
      "text": "Stimmt, jetzt wo ich genau hinsehe...\\nDas sind doch welche von Team Star!\\c\\nVersucht ihr schon wieder, Leute dazu zu\\nzwingen, eurem Team beizutreten?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "common_0225_sitappa_b_08",
      "hash64": "0EE60C3AC5DDB457",
      "text": "Urgh... Möglicherweise war das nicht... nicht\\nder Fall...[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "common_0225_rival_06",
      "hash64": "B93CA31B98593808",
      "text": "Aha, so ist das! Als Schulsprecherin wäre es ja\\neigentlich MEINE Aufgabe, diesen Aufruhr gleich\\r\\nzu unterbinden...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "common_0225_rival_07",
      "hash64": "B93CA41B985939BB",
      "text": "Aber wenn du eh schon dabei bist, überlass ich\\ndie Lösung des Problems dir, [VAR 0x0100(0000)]!\\c\\nUnd zwar mit diesem super-mega-ultra-geheimen\\nItem![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
