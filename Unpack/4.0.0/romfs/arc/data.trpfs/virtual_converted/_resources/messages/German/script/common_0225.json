          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0225_sitappa_a_08",
      "hash64": "37B1822F7B0438A8",
      "text": "Was war das denn?! Warum ist [VAR 0x1100(00FF,0303,0000)]derdie so stark?[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0225_sitappa_b_05",
      "hash64": "0EE5FF3AC5DD9E40",
      "text": "Was?! Du hast meine Kollegin plattgemacht?![VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0225_sitappa_b_06",
      "hash64": "0EE6023AC5DDA359",
      "text": "Dann muss wohl ich dir zeigen, wo der Hammer\\nhängt. Ich bin schon länger bei Team Star, also\\r\\nmach dich auf was gefasst![VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_0225_rival_01",
      "hash64": "B93CAA1B985943ED",
      "text": "Hey, ihr da! Was soll das werden?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0225_sitappa_a_09",
      "hash64": "37B1832F7B043A5B",
      "text": "Urks, die Schulsprecherin...[VAR 0x0114(002D)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002D"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "common_0225_sitappa_b_07",
      "hash64": "0EE6013AC5DDA1A6",
      "text": "Die hat uns ja gerade noch gefehlt...[VAR 0x0114(002E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002E"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "common_0225_rival_02",
      "hash64": "B93CA71B98593ED4",
      "text": "Hör mal, das geht so nicht, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
