        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_c_06_history_12",
      "hash64": "2C90A9E747526F0B",
      "text": "Vediamo se eri attent[VAR 0x1100(00FF,0101)]oa...\\c\\nCome si chiama il gruppo che si dice sia riuscito\\na esplorare le profondità dell’Area Zero, che\\r\\nsarebbe la parte interna della voragine?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
