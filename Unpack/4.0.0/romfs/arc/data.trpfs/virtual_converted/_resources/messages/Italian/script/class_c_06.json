    {
      "ordinal": 29,
      "label": "class_c_06_history_21",
      "hash64": "2C9432E747558DAD",
      "text": "Potete trovarlo sugli scaffali nell’atrio, al piano\\nterra.\\c\\nSe vi interessa, vi consiglio di darci un’occhiata![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 1,
          "code_hex": "BE01",
