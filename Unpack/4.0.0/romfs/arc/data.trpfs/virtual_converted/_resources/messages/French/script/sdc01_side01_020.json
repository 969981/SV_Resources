          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_side01_020_brother_18",
      "hash64": "A028D035E049C603",
      "text": "Heureusement que t’es là pour t’en occuper...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
