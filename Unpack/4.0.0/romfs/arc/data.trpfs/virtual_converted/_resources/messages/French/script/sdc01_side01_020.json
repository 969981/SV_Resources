    },
    {
      "ordinal": 39,
      "label": "sdc01_side01_020_brother_40",
      "hash64": "A032CA35E0521056",
      "text": "T-trop bien !\\nJ’avais vraiment envie qu’on y aille... ensemble ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
