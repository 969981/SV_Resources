          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_side01_020_brother_37",
      "hash64": "A021CD35E043A23C",
      "text": "Bon, allons voir la pancarte suivante...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc01_side01_020_brother_38",
      "hash64": "A021D435E043AE21",
      "text": "Oh... au fait, cette montagne, c’est celle\\noù vit l’Monstre, d’après la légende.\\c\\nPour y aller, suffit de monter par-là.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
