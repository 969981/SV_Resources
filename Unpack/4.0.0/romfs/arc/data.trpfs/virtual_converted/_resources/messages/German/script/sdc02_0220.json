    },
    {
      "ordinal": 6,
      "label": "sdc02_0220_dragonbb_07",
      "hash64": "41BB5E823CE23770",
      "text": "Gewinnen zu wollen ist gut. Jeder gewinnt gern.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
