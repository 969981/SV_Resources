      "hash64": "726D31FC94714F17",
      "text": "[VAR 0x0100(0000)]도\\n게임하고 싶지!? 그치!?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
