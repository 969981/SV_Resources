      "label": "s2_side01_0080_brother_03",
      "hash64": "91D446A7ABA8EE05",
      "text": "그런 거야?\\n그럼 네모는 어디 간 거지...?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
