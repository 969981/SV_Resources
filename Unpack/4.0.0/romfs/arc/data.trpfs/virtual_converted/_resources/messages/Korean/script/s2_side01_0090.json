          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0080_botan_02",
      "hash64": "726D32FC947150CA",
      "text": "아니, 안 들어갔어.\\n내가 쭉 거기만 찾고 있었거든.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0080_brother_02",
      "hash64": "91D445A7ABA8EC52",
      "text": "안쪽 방에도 온 적 없어.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
