          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_g_08_question_01",
      "hash64": "400AF5B61D2C06F3",
      "text": "１　更容易遇見異色寶可夢的\\n　　食力是哪一個？\\n\\n・閃耀力　・遭遇力\\n・捕獲力",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "class_g_08_ansewer_01a",
      "hash64": "E6F26225A506E7B7",
      "text": "閃耀力",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_g_08_ansewer_01b",
      "hash64": "E6F26325A506E96A",
      "text": "遭遇力",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_g_08_ansewer_01c",
      "hash64": "E6F26425A506EB1D",
      "text": "捕獲力",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "class_g_08_question_02",
      "hash64": "400AF6B61D2C08A6",
      "text": "２　蛋蛋力的效果中，下列何者不正確？\\n\\n・蛋孵化的速度會更快\\n・更容易誕生強大的寶可夢\\n・更容易發現蛋",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "class_g_08_ansewer_02a",
      "hash64": "E6FC5225A50F210C",
      "text": "蛋孵化的速度會更快",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_g_08_ansewer_02b",
      "hash64": "E6FC5525A50F2625",
      "text": "更容易誕生強大的寶可夢",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "class_g_08_ansewer_02c",
      "hash64": "E6FC5425A50F2472",
      "text": "更容易發現蛋",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_g_08_question_03",
      "hash64": "400AF7B61D2C0A59",
      "text": "３　想要提升食力的效果時，\\n　　能夠簡單達成的重要方法是什麼？\\n\\n・多多做料理　　・在家做料理\\n・大家一起做料理",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_g_08_ansewer_03a",
      "hash64": "E6F86E25A50B67C9",
      "text": "多多做料理",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_g_08_ansewer_03b",
      "hash64": "E6F86B25A50B62B0",
      "text": "在家做料理",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_g_08_ansewer_03c",
      "hash64": "E6F86C25A50B6463",
      "text": "大家一起做料理",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_g_08_question_04",
      "hash64": "400AF8B61D2C0C0C",
      "text": "４　心愛又可愛的寶可夢身體變髒時，\\n　　該採取什麼行動？\\n\\n・寶可夢洗澡澡　・寶可夢衝快快\\n・寶可夢玩水水",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_g_08_ansewer_04a",
      "hash64": "E6E76E25A4FCF496",
      "text": "寶可夢洗澡澡",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "class_g_08_ansewer_04b",
      "hash64": "E6E76D25A4FCF2E3",
      "text": "寶可夢衝快快",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_g_08_ansewer_04c",
      "hash64": "E6E76C25A4FCF130",
      "text": "寶可夢玩水水",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_g_08_question_05",
      "hash64": "400AF9B61D2C0DBF",
      "text": "５　此為有關學院校規的問題。\\n　　制服的上裝、下裝必須要\\n　　配合季節更換嗎？\\n\\n・要配合季節更換　・換不換都可以",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "class_g_08_ansewer_05a",
      "hash64": "E6E44A25A4FA8193",
      "text": "要配合季節更換",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "class_g_08_ansewer_05b",
      "hash64": "E6E44B25A4FA8346",
      "text": "換不換都可以",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "class_g_08_math_03",
      "hash64": "D651E4C1B9BC6873",
      "text": "作答時間到。\\n諸位停手吧。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_g_08_math_04",
      "hash64": "D651E9C1B9BC70F2",
      "text": "……因為諸位教我如何\\n更換手機洛托姆的外殼，\\r\\n我一時心軟就把考題難度稍微降低了。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_g_08_math_05",
      "hash64": "D651EAC1B9BC72A5",
      "text": "相信諸位都發揮了實力，\\n不會需要補考才是。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
