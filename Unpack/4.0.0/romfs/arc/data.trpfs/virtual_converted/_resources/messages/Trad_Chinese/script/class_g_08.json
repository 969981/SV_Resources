      ]
    },
    {
      "ordinal": 1,
      "label": "class_g_08_math_02",
      "hash64": "D651E3C1B9BC66C0",
      "text": "趁著昨晚惡補的東西還在腦子裡，\\n我們趕緊開始考試吧。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
