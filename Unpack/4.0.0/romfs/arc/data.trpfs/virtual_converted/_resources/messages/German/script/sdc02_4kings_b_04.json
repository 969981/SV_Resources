      "ordinal": 11,
      "label": "sdc02_4kings_a_04_steelbb_08",
      "hash64": "7B2CD1B0CD4D3284",
      "text": "Daher hoffe ich, ihm helfen zu können.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
