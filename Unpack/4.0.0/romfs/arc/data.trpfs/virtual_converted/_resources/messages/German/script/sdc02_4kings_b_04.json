    {
      "ordinal": 10,
      "label": "sdc02_4kings_a_04_steelbb_07",
      "hash64": "7B2CC8B0CD4D2339",
      "text": "Doch er hat sich verändert und das bereitet mir\\nSorgen.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
