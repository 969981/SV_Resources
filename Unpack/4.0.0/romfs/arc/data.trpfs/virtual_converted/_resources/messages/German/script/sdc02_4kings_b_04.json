      "label": "sdc02_4kings_a_04_steelbb_06",
      "hash64": "7B2CC7B0CD4D2186",
      "text": "Ich betrachte Hanas Bruder als einen Freund.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
