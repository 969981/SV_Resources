          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "ajito_fairy_040_fairyboss_10",
      "hash64": "17200A6E92DD75C2",
      "text": "뭐야 진짜...[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "ajito_fairy_040_fairyboss_11",
      "hash64": "17200B6E92DD7775",
      "text": "젠장! 진 건 분하긴 하지만,\\n너를 인정하지 않을 수 없겠어![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "ajito_fairy_040_fairyboss_12",
      "hash64": "1720086E92DD725C",
      "text": "진 사람은 보스의 자리에서 내려온다.\\n규칙을 어기는 건\\r\\n단을 배신하는 거니까...[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "ajito_fairy_040_fairyboss_13",
      "hash64": "1720096E92DD740F",
      "text": "어쩔 수 없지, 이걸 줄게.\\n영광으로 생각하라고!![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "ajito_fairy_040_waza_01",
      "hash64": "8E9DCAEFA9B69BD3",
      "text": "그냥 돌려보낼 순 없지...\\n내 애장품도 가져가도록 해.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_fairy_040_fairyboss_14",
      "hash64": "1720066E92DD6EF6",
      "text": "네가 무지무지하게\\n짜증 나는 녀석이라는 건 알아 둬![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "ajito_fairy_040_fairyboss_15",
      "hash64": "1720076E92DD70A9",
      "text": "그렇지만, 무지무지하게 강한 것도 인정해!\\n나의 스타모빌도 부숴 버리고 말이야![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
