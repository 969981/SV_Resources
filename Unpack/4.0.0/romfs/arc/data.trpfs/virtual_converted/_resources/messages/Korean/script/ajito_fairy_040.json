      "ordinal": 25,
      "label": "ajito_fairy_040_fairyboss_08",
      "hash64": "1723086E92DFA833",
      "text": "...... ......[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
