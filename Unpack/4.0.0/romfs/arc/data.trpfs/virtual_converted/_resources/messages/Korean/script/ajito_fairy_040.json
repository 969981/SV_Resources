    {
      "ordinal": 37,
      "label": "ajito_fairy_040_fairyboss_17",
      "hash64": "1720056E92DD6D43",
      "text": "피아노 레슨 시간이구나.\\n데리러 와 준 거야?[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
