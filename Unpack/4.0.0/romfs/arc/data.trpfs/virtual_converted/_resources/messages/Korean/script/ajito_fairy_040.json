          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "ajito_fairy_040_fairyboss_18",
      "hash64": "1720126E92DD835A",
      "text": "이제 보스에서도 은퇴했으니까,\\n슬슬 집에 들어가도록 할게...[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "ajito_fairy_040_jentle_02",
      "hash64": "474975A54A121611",
      "text": "...그게 아니라, 도련님께\\n소개해 드릴 분이 있습니다.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
