      "ordinal": 24,
      "label": "ajito_fairy_040_kakutouboss_03",
      "hash64": "FE3348FC171342C9",
      "text": "멜리!![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
