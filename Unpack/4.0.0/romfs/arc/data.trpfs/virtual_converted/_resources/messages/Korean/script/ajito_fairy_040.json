    },
    {
      "ordinal": 26,
      "label": "ajito_fairy_040_akuboss_04",
      "hash64": "13AF177C3C1E31C5",
      "text": "멜로코가 입이 좀 거칠긴 하지만\\n나쁜 뜻이 있어서 저러는 건 아니야.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "ajito_fairy_040_fairyboss_09",
      "hash64": "1723076E92DFA680",
      "text": "...나도 알아.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
