      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_history_a_07",
      "hash64": "363F0FB6BA15A182",
      "text": "이 아이라면 언젠가\\n나에게 유익한 존재가...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
