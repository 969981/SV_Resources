          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_004_dokuboss_first_02",
      "hash64": "F50D294DF406AB79",
      "text": "唔！？\\nYou是[VAR 0x0100(0000)]大人啊！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_004_dokuboss_first_03",
      "hash64": "F50D284DF406A9C6",
      "text": "在学习会上\\n承蒙You的照顾了。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_004_select_01",
      "hash64": "30C1E78E12BDA29F",
      "text": "你在干什么？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_004_select_02",
      "hash64": "30C1E88E12BDA452",
      "text": "什么是特别的服饰？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_004_dokuboss_first_04",
      "hash64": "F50D2B4DF406AEDF",
      "text": "哦哦，不愧是You，\\n眼力实在是high耶。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_004_dokuboss_first_05",
      "hash64": "F50D2A4DF406AD2C",
      "text": "吾秋明于梦中得到天启，\\n创造出了原创的服饰……[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_004_dokuboss_first_06",
      "hash64": "F50D2D4DF406B245",
      "text": "之后获得此渍沁市场的许可，\\n便前来进行贩售了。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_004_dokuboss_first_07",
      "hash64": "F50D2C4DF406B092",
      "text": "市场规定需以拍卖方式贩售。\\n因此若希望购买，请在拍卖中胜出。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_sub_004_dokuboss_pop_01",
      "hash64": "A90C316878EAA173",
      "text": "[VAR 0x01C0(0009)]，\\n要购买否～？　▶",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "01C0",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_004_dokuboss_00",
      "hash64": "39778D6B72C157F8",
      "text": "名为[VAR 0x01C1(0001)]的\\n吾之原创服饰！\\r\\n底价[VAR 0x0205(0003,0000)]！是否要参加拍卖……？[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "01C1",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_004_dokuboss_01",
      "hash64": "39778E6B72C159AB",
      "text": "明白了！让吾等\\n共同奔向战场吧！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_004_dokuboss_02",
      "hash64": "39778F6B72C15B5E",
      "text": "吾熬夜手工缝制的\\n[VAR 0x01C1(0001)]！\\r\\n底价[VAR 0x0205(0003,0000)]，往高拍耶！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "01C1",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_004_dokuboss_03",
      "hash64": "3977906B72C15D11",
      "text": "现在的价格是[VAR 0x0205(0003,0000)]！\\n还有其他人想出价吗！？[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_004_dokuboss_04",
      "hash64": "3977916B72C15EC4",
      "text": "[VAR 0x0100(0000)]大人\\n出价[VAR 0x0205(0003,0000)]！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_sub_004_dokuboss_05",
      "hash64": "3977926B72C16077",
      "text": "那边的You\\n以[VAR 0x0205(0003,0000)]竞拍成功！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_sub_004_dokuboss_10",
      "hash64": "397B136B72C47181",
      "text": "帷幕在此落下！\\n[VAR 0x0100(0000)]大人成功拍下了商品！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_sub_004_dokuboss_06",
      "hash64": "3977936B72C1622A",
      "text": "成交价为[VAR 0x0205(0003,0000)]！\\n来……收下商品吧！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "0205",
          "args_hex": [
            "0003",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_sub_004_dokuboss_07",
      "hash64": "3977946B72C163DD",
      "text": "……哎呀，请稍等。\\nYou的money不够呀。\\r\\n请重整旗鼓，重新再来。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_sub_004_dokuboss_08",
      "hash64": "3977856B72C14A60",
      "text": "You居然买下了吾的服饰，\\n真是感激不尽。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_004_dokuboss_09",
      "hash64": "3977866B72C14C13",
      "text": "敬请期待下次拍卖。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_sub_004_dokuboss_last_01",
      "hash64": "3B605A639E9167DA",
      "text": "唔唔！算上You刚刚买下的，\\n吾的服饰就都由\\r\\n[VAR 0x0100(0000)]大人You买下了！？[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_sub_004_dokuboss_last_02",
      "hash64": "3B6059639E916627",
      "text": "太值得庆贺了！\\n吾不胜感激啊啊啊！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_sub_004_dokuboss_last_03",
      "hash64": "3B6058639E916474",
      "text": "为表感激之意，吾就将宅之道的\\n基本动作传授给You吧。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_sub_004_system_01",
      "hash64": "75858643B50679EC",
      "text": "[VAR 0x0100(0000)]从秋明那里\\n学会了[VAR 0xFF00(0008)]荧光棒动作[VAR 0xFF00(0000)]！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
