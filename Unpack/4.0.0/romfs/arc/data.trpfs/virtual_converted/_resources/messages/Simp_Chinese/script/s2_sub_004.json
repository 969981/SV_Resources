          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_sub_004_dokuboss_last_04",
      "hash64": "3B6057639E9162C1",
      "text": "那么，秋明总店，\\n就此打烊！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_sub_004_dokuboss_last_05",
      "hash64": "3B6056639E91610E",
      "text": "……去无踪也！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
