    {
      "ordinal": 2,
      "label": "s2_sub_004_dokuboss_first_01",
      "hash64": "F50D264DF406A660",
      "text": "有特别的服饰！\\n要来看看否～？[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
