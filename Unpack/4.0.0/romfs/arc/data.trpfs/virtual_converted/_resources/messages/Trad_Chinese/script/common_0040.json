  "entries": [
    {
      "ordinal": 0,
      "label": "common_0040_head_teacher_01",
      "hash64": "086DAA5945746551",
      "text": "打擾了。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
