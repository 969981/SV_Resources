          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_013_coin_back_02",
      "hash64": "0B50A3A43766A20B",
      "text": "我在打扫的时候\\n捡到了遗失的硬币。\\r\\n说不定是你的，拿着吧。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
