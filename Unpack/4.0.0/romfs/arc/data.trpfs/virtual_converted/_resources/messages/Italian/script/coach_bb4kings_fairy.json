      "label": "coach_bb4kings_fairy_sp03_05",
      "hash64": "AFF8928C858C4AAB",
      "text": "Divertimento e impegno... Sì, mi piace![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
