      "ordinal": 33,
      "label": "coach_bb4kings_fairy_sp03_select_01",
      "hash64": "30EE3D64CC124D0E",
      "text": "Divertimento e impegno!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "coach_bb4kings_fairy_sp03_select_02",
      "hash64": "30EE3C64CC124B5B",
      "text": "Allegria ed energia!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "coach_bb4kings_fairy_sp03_select_03",
      "hash64": "30EE3B64CC1249A8",
      "text": "Sicurezza innanzitutto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
