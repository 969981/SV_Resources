    },
    {
      "ordinal": 1,
      "label": "s1_sub_014_header_02",
      "hash64": "5C51C6C3E118F741",
      "text": "Qui al circolo comunale di Nordivia ci occupiamo\\ndi sostenere il turismo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_014_header_03",
      "hash64": "5C51C5C3E118F58E",
      "text": "Hai mai notato che la cornice di certe schermate,\\ncome ad esempio la Borsa, cambia tema\\r\\nautomaticamente a seconda del luogo in cui\\r\\nti trovi?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_014_header_09",
      "hash64": "5C51BBC3E118E490",
      "text": "Vuoi cambiare il tema della cornice delle\\nschermate?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
