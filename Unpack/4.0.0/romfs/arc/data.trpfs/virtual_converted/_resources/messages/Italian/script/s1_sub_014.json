      "hash64": "5C51C3C3E118F228",
      "text": "Benvenut[VAR 0x1100(00FF,0101)]oa, studente[VAR 0x1100(00FF,0300)]ssa di Paldea!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
