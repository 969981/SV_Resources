    {
      "ordinal": 6,
      "label": "s1_sub_014_header_14",
      "hash64": "5C4E3AC3E115D386",
      "text": "Allora te lo lascio così com’è! Continua pure\\na goderti la tua visita a Nordivia!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_014_header_06",
      "hash64": "5C51CAC3E118FE0D",
      "text": "Ecco, ti ho impostato il tema di Paldea.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
