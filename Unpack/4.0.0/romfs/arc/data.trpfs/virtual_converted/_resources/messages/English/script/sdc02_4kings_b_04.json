    {
      "ordinal": 20,
      "label": "sdc02_4kings_a_04_steelbb_15",
      "hash64": "7B304AB0CD5035F6",
      "text": "All right, then.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_4kings_a_04_steelbb_16",
      "hash64": "7B3049B0CD503443",
      "text": "Time for a photo. We must ensure that your\\nvictory here is properly commemorated.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_4kings_a_04_steelbb_17",
      "hash64": "7B3048B0CD503290",
      "text": "I will give you this TM, too. It contains a favorite\\nmove of mine.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
