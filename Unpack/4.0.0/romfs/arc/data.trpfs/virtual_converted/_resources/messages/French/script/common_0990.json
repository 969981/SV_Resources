          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0990_friend_11",
      "hash64": "9C4BD9DF0F4C87C7",
      "text": "Et traîne pas, OK ?[VAR 0x0114(0006)]",
