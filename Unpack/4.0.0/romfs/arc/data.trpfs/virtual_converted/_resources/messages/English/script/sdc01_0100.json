    },
    {
      "ordinal": 39,
      "label": "sdc01_0100_brother_11",
      "hash64": "02D30802D300B672",
      "text": "U-um...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
