      ]
    },
    {
      "ordinal": 40,
      "label": "sdc01_0100_brother_12",
      "hash64": "02D30702D300B4BF",
      "text": "So it looks like...we should probably start with\\nthe signboard at...[VAR 0xFF00(0006)]Loyalty Plaza[VAR 0xFF00(0000)]...\\c\\nThat’s out past the apple orchards on the west\\nside of the village...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
