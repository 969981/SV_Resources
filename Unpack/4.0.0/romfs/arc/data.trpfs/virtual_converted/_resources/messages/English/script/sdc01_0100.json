    },
    {
      "ordinal": 34,
      "label": "sdc01_0100_caretaker_01",
      "hash64": "CE25A9AB5F9159B9",
      "text": "Looks like you’ve all paired up![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
