          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc01_0100_caretaker_03",
      "hash64": "CE25A7AB5F915653",
      "text": "Now then, off you go to do some exploring![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc01_0100_caretaker_05",
      "hash64": "CE25ADAB5F916085",
      "text": "Oh, and if you find yourself in need of any\\nPotions or Poké Balls or the like...[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
