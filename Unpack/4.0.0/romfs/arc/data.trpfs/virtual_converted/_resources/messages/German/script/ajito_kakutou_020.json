    },
    {
      "ordinal": 1,
      "label": "ajito_kakutou_020_cassiopeia_01",
      "hash64": "781BBADBBA8A3082",
      "text": "Sehr gut, du hast die Wache also bezwungen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
