          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_kakutou_020_cassiopeia_02",
      "hash64": "781BB9DBBA8A2ECF",
      "text": "Das ist das Versteck der Kampf-Mitglieder von\\nTeam Star, der Caph-Bande.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_kakutou_020_cassiopeia_03",
      "hash64": "781BB8DBBA8A2D1C",
      "text": "Rioba, ihr Boss, ist Wrestlerin und unterrichtet\\ndie anderen Mitglieder im Kämpfen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_kakutou_020_cassiopeia_04",
      "hash64": "781BB7DBBA8A2B69",
      "text": "Unsere Kampfansage an Team Star wird sie am\\nmeisten in Alarmbereitschaft versetzt haben.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_kakutou_020_cassiopeia_05",
      "hash64": "781BB6DBBA8A29B6",
      "text": "Es ist gut möglich, dass sie an vorderster Front\\nmitkämpft, um einen Eindringling wie dich\\r\\nschnellstmöglich auszuschalten.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_kakutou_020_select_01",
      "hash64": "27F32B7B4AAD33F3",
      "text": "Genau das hat sie getan!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_kakutou_020_select_02",
      "hash64": "27F32C7B4AAD35A6",
      "text": "Ich bin ihr schon begegnet.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "ajito_kakutou_020_cassiopeia_06",
      "hash64": "781BB5DBBA8A2803",
      "text": "Ich wusste es! Wie lief’s?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_kakutou_020_cassiopeia_07",
      "hash64": "781BB4DBBA8A2650",
      "text": "Rioba ist geflohen...? Ernsthaft?![VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_kakutou_020_cassiopeia_08",
      "hash64": "781BC3DBBA8A3FCD",
      "text": "Nun... Dann bleibt dir nichts anderes übrig, als\\ndas Versteck mit einem Frontalangriff zu erobern.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_kakutou_020_cassiopeia_09",
