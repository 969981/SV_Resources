    {
      "ordinal": 6,
      "label": "kizuna_health_d_05",
      "hash64": "0629668C86303BFF",
      "text": "Thank you so much![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
