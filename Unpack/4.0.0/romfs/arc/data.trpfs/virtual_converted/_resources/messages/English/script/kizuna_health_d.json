      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_health_d_09",
      "hash64": "06296A8C863042CB",
      "text": "Buuut they tell me there’s no room to add new\\nclasses this year![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
