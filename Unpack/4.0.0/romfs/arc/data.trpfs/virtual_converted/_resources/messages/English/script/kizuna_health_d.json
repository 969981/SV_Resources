            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_health_d_10",
      "hash64": "062CE78C86334D09",
      "text": "So I guess I’ll keep being Nurse Miriam for a bit![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
