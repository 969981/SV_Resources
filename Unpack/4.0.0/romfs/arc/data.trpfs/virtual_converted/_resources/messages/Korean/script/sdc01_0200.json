    {
      "ordinal": 5,
      "label": "sdc01_0200_student1_01",
      "hash64": "3F18ACBE5B08EB80",
      "text": "오늘이야말로 시유랑 같이\\n두근두근 오리엔티어링을...!",
      "flags": 0,
      "text_status": "DECODED",
