    },
    {
      "ordinal": 3,
      "label": "kizuna_rival_b_mob_02",
      "hash64": "A1B060AE8A2F96F5",
      "text": "哦～哈哈……\\n對戰還是下次再說好了……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_rival_b_03",
      "hash64": "3202DEDC483670F5",
