      "label": "kizuna_rival_b_01",
      "hash64": "3202DCDC48366D8F",
      "text": "那我們現在去操場對戰吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
