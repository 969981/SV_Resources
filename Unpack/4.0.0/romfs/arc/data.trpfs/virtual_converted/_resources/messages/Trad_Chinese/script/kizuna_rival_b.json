    {
      "ordinal": 5,
      "label": "kizuna_rival_b_select_01",
      "hash64": "CBE4CFE5C5918856",
      "text": "剛剛的人是誰？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_rival_b_select_02",
      "hash64": "CBE4CEE5C59186A3",
      "text": "那是妳的朋友？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_rival_b_04",
      "hash64": "3202D7DC48366510",
      "text": "不是，我不認識他！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_rival_b_05",
      "hash64": "3202D8DC483666C3",
      "text": "我剛剛在吃三明治的時候，\\n聽到有人說「我的寶可夢很強喔！」，\\r\\n所以我就邀他一起打對戰！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
