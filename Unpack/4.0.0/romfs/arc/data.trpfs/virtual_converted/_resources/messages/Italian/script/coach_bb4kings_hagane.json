    {
      "ordinal": 14,
      "label": "coach_bb4kings_hagane_sp02_01",
      "hash64": "F484C277878745FF",
      "text": "In che circostanze hai conosciuto Riben?[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
