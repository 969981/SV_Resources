    },
    {
      "ordinal": 9,
      "label": "coach_bb4kings_hagane_sp01_05",
      "hash64": "C99A4E82D09411B4",
      "text": "Il Signor Gwaaah è dotato di una costituzione\\nparticolarmente robusta.\\c\\nProbabilmente è per questo che non gli hanno\\ncausato effetti nocivi.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
