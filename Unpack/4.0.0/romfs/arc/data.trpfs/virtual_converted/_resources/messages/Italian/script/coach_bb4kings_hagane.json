      ]
    },
    {
      "ordinal": 33,
      "label": "coach_bb4kings_hagane_sp03_08",
      "hash64": "F1298F725EAB6DA5",
      "text": "Mh...[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
