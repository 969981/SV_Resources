          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb4kings_hagane_sp02_select_01",
      "hash64": "D2A78799FC4F6886",
      "text": "Durante il viaggio di studio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb4kings_hagane_sp02_select_02",
      "hash64": "D2A78699FC4F66D3",
      "text": "Abbiamo fatto coppia",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_bb4kings_hagane_sp02_02",
      "hash64": "F484C377878747B2",
      "text": "Allora è stato quello l’evento scatenante...\\c\\nIn effetti, ricordo che era tornato a Nordivia\\nprima che cambiasse carattere.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb4kings_hagane_sp02_02b",
      "hash64": "04DFF41B4ADF0670",
      "text": "Co-Coppia?!\\n... C-Chiedo scusa per la mia reazione.\\c\\nIntendi dire che avete svolto in coppia i compiti\\nassegnati durante il viaggio di studio.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb4kings_hagane_sp02_03",
      "hash64": "F484C47787874965",
      "text": "Riben prova per te una forte adorazione...\\nMi chiedevo quale fosse la motivazione.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb4kings_hagane_sp02_04",
      "hash64": "F484BD7787873D80",
      "text": "... A quanto pare il problema non sta nelle\\nmodalità del vostro incontro.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb4kings_hagane_sp02_05",
      "hash64": "F484BE7787873F33",
      "text": "Ti ho chiesto tutto ciò che volevo chiederti.\\nMolte grazie.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
