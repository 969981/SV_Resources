    {
      "ordinal": 6,
      "label": "champ_0020_rival_06",
      "hash64": "1B73CECFD3FC0DBF",
      "text": "要想和道馆馆主对战，\\n就需要先完成一种叫做\\r\\n道馆测验的课题！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
