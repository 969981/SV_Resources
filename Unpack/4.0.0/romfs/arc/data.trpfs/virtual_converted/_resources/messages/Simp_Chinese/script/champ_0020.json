          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0020_rival_07",
      "hash64": "1B73CDCFD3FC0C0C",
      "text": "每个道馆的内容都不一样，\\n你去问一下前台的人吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0020_rival_11",
      "hash64": "1B70C7CFD3F9CC03",
      "text": "这些先给你了！\\n使用时就当是我在帮你吧。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
