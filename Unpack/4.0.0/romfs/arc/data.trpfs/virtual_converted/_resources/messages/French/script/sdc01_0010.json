    {
      "ordinal": 14,
      "label": "sdc01_0010_bbteacher_09",
      "hash64": "D367DA83C789B43D",
      "text": "Où en étais-je ? Ah oui. Je suis madame Bria.\\nJ’enseigne à l’Institut Myrtille.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
