      "ordinal": 15,
      "label": "sdc01_0010_ecology_05",
      "hash64": "4FF118C5AFE06047",
      "text": "C’est une école située dans la région d’Unys.\\nMadame Bria y occupe le poste de responsable\\r\\npédagogique.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
