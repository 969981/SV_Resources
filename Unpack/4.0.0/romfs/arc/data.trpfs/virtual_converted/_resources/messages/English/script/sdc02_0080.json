    {
      "ordinal": 20,
      "label": "sdc02_0080_select_01",
      "hash64": "49B42BEA169DA8EB",
      "text": "I was really motivated!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sdc02_0080_select_02",
      "hash64": "49B42CEA169DAA9E",
      "text": "It was a walk in the park!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sdc02_0080_fairybb_02",
      "hash64": "CE97A77B27A6F5A7",
      "text": "So battling isn’t your only talent, then—you’ve\\ngot a knack for catching Pokémon too![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0080_fairybb_03",
      "hash64": "CE97A67B27A6F3F4",
      "text": "It’s easy to see how high level the students must\\nbe at Naranja Academy![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0080_fairybb_04",
      "hash64": "CE97A57B27A6F241",
      "text": "It’s easy to see how high level the students must\\nbe at Uva Academy![VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0080_teacher_20",
      "hash64": "EE5FBE1F07FC7F96",
      "text": "All right, everyone! Gather round!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "sdc02_0080_teacher_21",
      "hash64": "EE5FBF1F07FC8149",
      "text": "We’re all out of time for today, so that’ll have to\\nbe it for this class session.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "sdc02_0080_teacher_22",
      "hash64": "EE5FBC1F07FC7C30",
      "text": "If you didn’t manage to catch a Pokémon in time,\\nthat’ll be your homework to complete before our\\r\\nnext session. Class dismissed!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc02_0080_mob_01",
      "hash64": "9A95444F99F3B847",
      "text": "Maaan, really? Guess I’m stuck with homework.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "sdc02_0080_fairybb_05",
      "hash64": "CE97A47B27A6F08E",
