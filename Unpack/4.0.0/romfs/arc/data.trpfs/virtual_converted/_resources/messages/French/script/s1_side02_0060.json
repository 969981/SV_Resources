          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_side02_0060_camera_01",
      "hash64": "443526A6423B3A9A",
      "text": "Je t’attendais ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_side02_0060_camera_02",
      "hash64": "443525A6423B38E7",
      "text": "J’ai développé les photos de Lune Vermeille ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_side02_0060_select_01",
      "hash64": "75749C56FDB0EFAB",
      "text": "Je peux les voir ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_side02_0060_select_02",
      "hash64": "75749D56FDB0F15E",
      "text": "Alors, ça donne quoi ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0060_camera_03",
      "hash64": "443524A6423B3734",
      "text": "Elles sont pas terribles...\\nSoit Lune Vermeille est flou, soit il sort du cadre,\\r\\nsoit la focale est mal réglée.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_side02_0060_camera_04",
      "hash64": "443523A6423B3581",
      "text": "Je peux vraiment pas te laisser voir ce massacre.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_side02_0060_camera_05",
      "hash64": "443522A6423B33CE",
      "text": "... Mais tu sais quoi ?\\c\\nJ’adore ces photos.\\nC’est les meilleures de ma carrière.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_side02_0060_camera_06",
      "hash64": "443521A6423B321B",
      "text": "Je crois que je me suis trop pris la tête.\\c\\nJ’étais trop obnubilée par la théorie, j’ai trop\\ncherché à plaire aux jurys de concours...\\c\\nJe savais plus vraiment ce que je voulais prendre\\nen photo, en fin de compte.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 217,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_side02_0060_camera_07",
      "hash64": "443520A6423B3068",
      "text": "Alors qu’il suffit d’appuyer sur un bouton\\npour capturer un instant de vie ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_side02_0060_camera_08",
      "hash64": "44351FA6423B2EB5",
      "text": "Tu étais censé[VAR 0x1100(00FF,0100)]e être mon assistant[VAR 0x1100(00FF,0100)]e, mais tu t’es\\nsurpassé[VAR 0x1100(00FF,0100)]e... Tu m’as carrément ouvert les yeux !\\r\\nMerci du fond du cœur.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 68,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_side02_0060_camera_09",
      "hash64": "44351EA6423B2D02",
      "text": "Oh, mais j’y pense ! J’ai complètement oublié\\nde te demander ton nom ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_side02_0060_camera_10",
      "hash64": "4431A1A6423822C4",
      "text": "C’est pas trop tôt, tu me diras !\\nAlors, comment tu t’appelles ?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_side02_0060_select_03",
      "hash64": "75749E56FDB0F311",
      "text": "Je m’appelle [VAR 0x0100(0000)] !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_side02_0060_select_04",
      "hash64": "75749F56FDB0F4C4",
      "text": "[VAR 0x0100(0000)]...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_side02_0060_camera_11",
      "hash64": "4431A2A642382477",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)] ! C’est un nom qui va bien\\nà quelqu’un\\r\\nd’aussi\\r\\nsympa\\r\\nque toi ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_side02_0060_camera_12",
      "hash64": "4431A3A64238262A",
      "text": "[VAR 0x0100(0000)] !\\nEh ben, qu’est-ce qui t’arrive ?\\r\\nT’as honte de ton nom ?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_0060_camera_13",
      "hash64": "4431A4A6423827DD",
      "text": "Ça a été un plaisir de faire ta connaissance !\\nTu le sais déjà, mais moi, c’est Lithia...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_side02_0060_camera_14",
      "hash64": "44319DA642381BF8",
      "text": "Et maintenant, je peux le dire haut et fort : je suis\\nphotographe et j’adore prendre des photos ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_side02_0060_camera_15",
      "hash64": "44319EA642381DAB",
      "text": "Eh oui, dorénavant, j’affirmerai sans gêne\\nce que j’aime dans la vie ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_side02_0060_camera_16",
      "hash64": "44319FA642381F5E",
      "text": "Oups ! J’ai failli oublier le plus important ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_side02_0060_camera_17",
      "hash64": "4431A0A642382111",
      "text": "Je voulais te remercier comme il se doit,\\nalors je me suis creusé la tête pour te trouver\\r\\nune belle récompense ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_side02_0060_camera_18",
      "hash64": "443199A64238152C",
      "text": "Et en plus de ça... mon Caninos a un petit frère\\nqui aime bien se battre.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_side02_0060_camera_19",
      "hash64": "44319AA6423816DF",
      "text": "Je pense qu’il serait bien content de te suivre\\net de s’entraîner à tes côtés.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_side02_0060_system_01",
      "hash64": "FB7A90977AC48E50",
      "text": "Lithia vous confie un Caninos !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "s1_side02_0060_camera_20",
      "hash64": "443B93A642405F7F",
      "text": "Prends bien soin de lui, OK ?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_side02_0060_camera_21",
      "hash64": "443B92A642405DCC",
      "text": "... Bon ! J’ai accompli ce que j’étais venue faire\\nici. Il est temps pour moi de partir ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_side02_0060_camera_22",
      "hash64": "443B95A6424062E5",
      "text": "C’est pas facile, mais il faut se dire adieu.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_side02_0060_camera_23",
      "hash64": "443B94A642406132",
      "text": "Mais grâce à nos Caninos, on a ce lien qui nous\\nunit, maintenant ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s1_side02_0060_camera_24",
      "hash64": "443B8FA6424058B3",
      "text": "Occupe-toi bien du tien et, qui sait, peut-être\\nqu’on se croisera à nouveau, un jour.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s1_side02_0060_select_05",
      "hash64": "7574A056FDB0F677",
      "text": "Oui, on se reverra !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "s1_side02_0060_select_06",
      "hash64": "7574A156FDB0F82A",
      "text": "J’entraînerai Caninos comme il se doit !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "s1_side02_0060_camera_25",
      "hash64": "443B8EA642405700",
      "text": "Merci pour tout !\\nJ’ai hâte de vous revoir, toi et ton Caninos ![VAR 0x0114(0046)]",
