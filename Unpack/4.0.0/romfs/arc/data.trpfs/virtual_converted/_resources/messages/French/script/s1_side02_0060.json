  "entries": [
    {
      "ordinal": 0,
      "label": "s1_side02_0060_camera_boxfull",
      "hash64": "1C4DAAE9C41D0D4B",
      "text": "Ah ! Voilà enfin mon assistant[VAR 0x1100(00FF,0100)]e !\\c\\nTiens, on dirait que t’as plus de place\\nni dans ton équipe ni dans tes Boîtes...\\c\\nJe te conseille d’en faire, parce que\\nj’ai une belle surprise pour toi ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 1,
          "code_hex": "BE01",
