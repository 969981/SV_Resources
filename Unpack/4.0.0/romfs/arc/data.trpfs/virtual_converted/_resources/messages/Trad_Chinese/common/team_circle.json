    {
      "ordinal": 38,
      "label": "team_circle_win_01_00",
      "hash64": "9A76A3A7D6767E7F",
      "text": "要以聯盟集友圈\\n和朋友一起冒險嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
