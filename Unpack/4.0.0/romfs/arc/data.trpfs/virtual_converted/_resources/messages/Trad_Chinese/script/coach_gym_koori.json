    },
    {
      "ordinal": 1,
      "label": "coach_gym_koori_first_01",
      "hash64": "C9ED52AC91ECBE89",
      "text": "這裡的冷氣也開得太冷了吧。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
