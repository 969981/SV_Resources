          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_gym_koori_sp01_00",
      "hash64": "D186977D9003E0F6",
      "text": "原來是[VAR 0x1100(00FF,0101)]你妳叫我來的？[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_koori_sp01_01",
      "hash64": "D186987D9003E2A9",
      "text": "……知道嗎？\\n[VAR 0x1100(00FF,0101)]你妳這樣做很冷欸。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_koori_sp01_02",
      "hash64": "D186957D9003DD90",
      "text": "我不覺得把我叫來\\n對這學園有什麼好處。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_koori_sp01_select_01",
      "hash64": "16E2870749937938",
      "text": "沒那回事！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_gym_koori_sp01_select_02",
      "hash64": "16E28A0749937E51",
      "text": "嗯……？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_gym_koori_sp01_03",
      "hash64": "D186967D9003DF43",
      "text": "……說得真肯定啊。\\n[VAR 0x1100(00FF,0101)]你妳那份自信究竟是從哪裡來的？[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_gym_koori_sp01_03b",
      "hash64": "0B90D85BB6942513",
      "text": "看吧……\\n[VAR 0x1100(00FF,0101)]你妳也沒有自信對吧？[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_gym_koori_sp01_04",
      "hash64": "D1869B7D9003E7C2",
      "text": "但是既然來了，\\n我還是會好好工作的。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_koori_sp01_05",
      "hash64": "D1869C7D9003E975",
      "text": "畢竟……\\n我也是專業的。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_koori_sp02_00",
      "hash64": "A2B0996582B268A9",
      "text": "……是[VAR 0x1100(00FF,0101)]你妳啊。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_koori_sp02_01",
      "hash64": "A2B0986582B266F6",
      "text": "[VAR 0x1100(00FF,0101)]你妳去過生態巨蛋的極地區嗎？\\n那裡真的很厲害。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_koori_sp02_02",
      "hash64": "A2B0976582B26543",
      "text": "那裡的雪鬆軟得簡直像是天然的一樣，\\n讓人難以相信那是人工雪。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_koori_sp02_03",
      "hash64": "A2B0966582B26390",
      "text": "直線道和彎道都很充實，\\n很適合單板滑雪。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_gym_koori_sp02_select_01",
      "hash64": "0A146F6F18BACCD5",
      "text": "你要滑雪嗎！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_gym_koori_sp02_select_02",
      "hash64": "0A146C6F18BAC7BC",
      "text": "去滑雪吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_gym_koori_sp02_04",
      "hash64": "A2B09D6582B26F75",
      "text": "……啊，我不是這個意思。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_koori_sp02_05",
      "hash64": "A2B09C6582B26DC2",
      "text": "我只是改不掉只要看到雪山\\n就會去觀察它的習慣而已。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_koori_sp02_06",
      "hash64": "A2B09B6582B26C0F",
      "text": "在校園裡造出那樣的山……\\n這裡真是個不得了的地方。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_koori_sp03_00",
      "hash64": "4DD3636F921AA518",
      "text": "剛剛我去爬了極地區的雪山。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_koori_sp03_01",
      "hash64": "4DD3646F921AA6CB",
      "text": "到了不是霜抹山的雪山，\\n讓走鯨牠們又高興又興奮。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_koori_sp03_02",
      "hash64": "4DD3656F921AA87E",
      "text": "看著牠們的樣子，我也……\\n稍微……站上滑雪板滑了一下。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_koori_sp03_select_03",
      "hash64": "3172AE49C79029EC",
      "text": "很好呀！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "coach_gym_koori_sp03_select_04",
      "hash64": "3172AD49C7902839",
      "text": "感覺如何？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "coach_gym_koori_sp03_03",
      "hash64": "4DD3666F921AAA31",
      "text": "呃，雪的狀態是很好。\\n嗯……很好。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_koori_sp03_04",
      "hash64": "4DD3676F921AABE4",
      "text": "好久沒有滑雪，\\n連我都覺得自己太熱衷了。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_koori_sp03_05",
      "hash64": "4DD3686F921AAD97",
      "text": "其實我本來打算\\n不再站上滑雪板了……[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_koori_sp03_06",
      "hash64": "4DD3696F921AAF4A",
      "text": "但僅限在我來這裡的期間的話，\\n解禁一下應該也沒關係吧。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_koori_trade_01_00",
      "hash64": "C361CA51FA0A3C12",
      "text": "……抱歉啦，\\n我的意志力就是這麼薄弱。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_koori_trade_01_01",
      "hash64": "C361CB51FA0A3DC5",
      "text": "既然已經這麼冷了，\\n我們來做些更會冷場的事吧。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_koori_trade_01_02",
      "hash64": "C361C851FA0A38AC",
      "text": "[VAR 0x1100(00FF,0101)]你妳要不要和我\\n交換寶可夢看看？[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_koori_trade_01_03",
      "hash64": "C361C951FA0A3A5F",
      "text": "真的要交換啊？\\n那我就用走鯨來交換吧，\\r\\n[VAR 0x1100(00FF,0101)]你妳呢？[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_gym_koori_trade_01_04",
      "hash64": "C361C651FA0A3546",
      "text": "[VAR 0x0101(0001)]是嗎，\\n嗯……不錯。\\c\\n既然是[VAR 0x1100(00FF,0101)]你妳託付給我的寶可夢，\\n我會好好培育，不會讓牠冷掉的。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
