          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_a_07_ecology_07",
      "hash64": "8C1245CA4CA117D6",
      "text": "E infine la Forma Cavalcatura, che adotta per\\nfarvi salire in groppa, gonfiando la coda e\\r\\nla sacca giugulare.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
