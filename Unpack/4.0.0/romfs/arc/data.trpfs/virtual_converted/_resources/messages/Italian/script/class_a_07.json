      "hash64": "8C1247CA4CA11B3C",
      "text": "Salve, ragazzi! Forza, diamo inizio alla lezione![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
