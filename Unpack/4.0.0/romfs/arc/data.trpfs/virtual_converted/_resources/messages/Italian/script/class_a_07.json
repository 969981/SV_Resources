          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_a_07_ecology_06",
      "hash64": "8C1246CA4CA11989",
      "text": "La Forma Base, in cui cammina a quattro zampe,\\ne la Forma Lotta, che assume quando si regge\\r\\nsu due zampe per lottare...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
