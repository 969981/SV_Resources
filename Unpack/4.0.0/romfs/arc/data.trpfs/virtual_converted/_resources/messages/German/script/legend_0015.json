            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "legend_0015_cassiopeia_02",
      "hash64": "357DB497166230DE",
      "text": "Du erhältst diesen Anruf, weil ich dein Handy\\ngehackt habe.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "legend_0015_select_01",
      "hash64": "AECA47BE2224E1A2",
      "text": "Wer ist da?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "legend_0015_select_02",
      "hash64": "AECA46BE2224DFEF",
      "text": "Gehackt?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "legend_0015_cassiopeia_03",
      "hash64": "357DB59716623291",
      "text": "Das heißt, dass ich vorübergehend die Kontrolle\\nüber dein Telefon übernommen habe...[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "legend_0015_cassiopeia_04",
      "hash64": "357DB69716623444",
      "text": "Mein Name ist Cassiopeia.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "legend_0015_cassiopeia_05",
      "hash64": "357DB797166235F7",
      "text": "Ich weiß, wer du bist... [VAR 0x1100(00FF,1613,0000)]Ein Pokémon-TrainerEine Pokémon-Trainerin\\nmit viel Potenzial.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1613",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "legend_0015_cassiopeia_06",
      "hash64": "357DB897166237AA",
      "text": "Dieses Potenzial habe ich erkannt und möchte\\ndich daher um etwas bitten.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "legend_0015_cassiopeia_07",
      "hash64": "357DB9971662395D",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)]... Du kennst doch sicher\\nTeam Star?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "legend_0015_cassiopeia_14",
      "hash64": "35813C9716654DCD",
      "text": "Man soll nicht lügen. Ich weiß, dass du ihnen\\nschon einmal begegnet bist.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "legend_0015_cassiopeia_15",
      "hash64": "35813B9716654C1A",
      "text": "Dann ist die Sache schnell erklärt...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "legend_0015_cassiopeia_08",
      "hash64": "357DAA9716621FE0",
      "text": "Team Star wurde von Schülern der Akademie\\ngegründet, die auf die schiefe Bahn geraten sind.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "legend_0015_cassiopeia_09",
      "hash64": "357DAB9716622193",
      "text": "Sie verbreiten Unruhe an der Akademie und\\nmachen nichts als Ärger.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "legend_0015_cassiopeia_10",
      "hash64": "3581389716654701",
      "text": "Dieses Verhalten kann ich nicht weiter dulden...![VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "legend_0015_cassiopeia_11",
      "hash64": "358137971665454E",
      "text": "Mein Ziel ist es, Team Star aufzulösen und in\\nSternenstaub zu verwandeln.\\c\\nDer Name dieses Unterfangens lautet\\nOperation Stardust.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "legend_0015_cassiopeia_12",
      "hash64": "358136971665439B",
      "text": "Für diesen Plan benötige ich Verbündete...\\c\\nDenkst du nicht auch, dass du [VAR 0x1100(00FF,0303,0000)]derdie Richtige dafür\\nwärst?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 76,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "legend_0015_cassiopeia_13",
      "hash64": "35813597166541E8",
      "text": "Du musst dich jetzt noch nicht entscheiden...\\nMehr Informationen erhältst du später.\\c\\nDas war vorerst alles. Bis zum nächsten Mal.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
