    {
      "ordinal": 17,
      "label": "s2_side01_0000_friend_11",
      "hash64": "A8535B8B63CDC252",
      "text": "Bref, c’est décidé ![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side01_0000_friend_12",
      "hash64": "A8535A8B63CDC09F",
      "text": "T’habites à Cuchalaga, c’est ça ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side01_0000_friend_13",
      "hash64": "A853598B63CDBEEC",
      "text": "J’y fonce tout de suite !\\nJe t’attends devant chez toi ![VAR 0x0114(0006)]",
      "flags": 0,
