    {
      "ordinal": 8,
      "label": "sub_013_coin_back_01",
      "hash64": "0B50A4A43766A3BE",
      "text": "Ultimamente trovo spesso delle monete\\nper terra. Cos’è, la gente ne ha così tante\\r\\nche non sa più dove metterle?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_013_coin_back_02",
      "hash64": "0B50A3A43766A20B",
      "text": "Stavo pulendo e ho trovato una moneta\\nper terra. Credo sia tua, quindi tieni!",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_013_coin_back_03",
      "hash64": "0B50A2A43766A058",
      "text": "Stavo pulendo e ho trovato delle monete\\nper terra. Credo siano tue, quindi tieni!",
      "flags": 8,
