          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0110_rival_06",
      "hash64": "ABD98C4A134AB33B",
      "text": "미안~! 빨리 싸우고 싶어서 그만!\\n내가 배려가 부족했어...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0110_rival_07",
      "hash64": "ABD98B4A134AB188",
      "text": "그래도 치프 덕분에\\n준비는 완벽해졌네![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0110_rival_08",
      "hash64": "ABD98A4A134AAFD5",
      "text": "자, 그럼 마음을 가다듬고...\\n[VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0110_rival_09",
      "hash64": "ABD9894A134AAE22",
      "text": "이번에도 알차게 승부해 보자![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
