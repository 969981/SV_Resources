          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0110_rival_04",
      "hash64": "ABD98E4A134AB6A1",
      "text": "거기서 최강의 시험관과 싸워서 이기면\\n챔피언이 될 수 있어![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
