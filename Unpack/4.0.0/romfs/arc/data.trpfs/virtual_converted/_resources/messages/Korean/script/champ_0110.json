    {
      "ordinal": 3,
      "label": "champ_0110_chairman_02",
      "hash64": "8710346AB703EAEA",
      "text": "테이블시티 북서쪽에 자리하고 있죠.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
