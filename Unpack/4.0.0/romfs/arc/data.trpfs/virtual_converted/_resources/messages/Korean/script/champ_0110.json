          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0110_chairman_05",
      "hash64": "87102F6AB703E26B",
      "text": "[VAR 0x0100(0000)] 님의 포켓몬,\\n조금 지친 상태인 것 같은데요?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
