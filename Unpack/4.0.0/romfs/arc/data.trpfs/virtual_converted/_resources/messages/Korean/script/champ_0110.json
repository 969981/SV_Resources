    },
    {
      "ordinal": 5,
      "label": "champ_0110_rival_03",
      "hash64": "ABD98F4A134AB854",
      "text": "체육관 배지 8개를 손에 넣으면\\n시험을 치를 수 있는데...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
