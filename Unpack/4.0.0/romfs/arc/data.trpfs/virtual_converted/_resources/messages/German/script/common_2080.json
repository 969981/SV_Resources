  "paired_tbl": "message/dat/German/script/common_2080.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "common_2080_rival_01",
      "hash64": "9C0D5D3D3BBC23DA",
      "text": "Da bist du ja endlich![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2080_rival_02",
      "hash64": "9C0D5C3D3BBC2227",
      "text": "Um am Großen Akademieturnier teilnehmen zu\\nkönnen, musst du dich hier bei dem Turnierhelfer\\r\\nanmelden.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2080_rival_03",
      "hash64": "9C0D5B3D3BBC2074",
      "text": "Wären Sie bitte so gut, [VAR 0x1100(00FF,0F0D,0000)]meinem Freundmeiner Freundin die\\nTurnierregeln zu erklären?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0F0D",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2080_staff_01",
      "hash64": "B6EF1D39889F0EA4",
      "text": "Selbstverständlich! Zuallererst solltest du wissen,\\ndass beim Großen Akademieturnier Lehrer und\\r\\nSchüler gleichermaßen teilnehmen dürfen.\\c\\nSämtliche Teilnehmer werden einander nach dem\\nZufallsprinzip zugeteilt und nur die Sieger der\\r\\neinzelnen Kämpfe verbleiben im Wettbewerb.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 236,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2080_staff_02",
      "hash64": "B6EF2039889F13BD",
      "text": "Die Match-Paare werden per Losziehung durch\\ndie Turnierleitung festgelegt.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_2080_staff_03",
      "hash64": "B6EF1F39889F120A",
      "text": "Bis man sich auf dem Kampfplatz Auge in Auge\\ngegenübersteht, weiß also niemand, mit wem er\\r\\nes zu tun bekommt.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2080_staff_04",
      "hash64": "B6EF1A39889F098B",
      "text": "Wer als Sieger aus dem Kampf hervorgeht,\\nden erwartet schon das nächste Kräftemessen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_2080_staff_05",
      "hash64": "B6EF1939889F07D8",
      "text": "Für den Verlierer hingegen endet das Turnier\\nbereits nach einer einzigen Niederlage.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_2080_staff_06",
      "hash64": "B6EF1C39889F0CF1",
      "text": "Mit anderen Worten: Wer Kampf um Kampf\\ngewinnt und bis zuletzt übrig bleibt, ist der\\r\\noder die Allerstärkste der Akademie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2080_rival_04",
      "hash64": "9C0D5A3D3BBC1EC1",
      "text": "Vielen Dank für die Erklärung![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2080_rival_05",
      "hash64": "9C0D593D3BBC1D0E",
      "text": "Die Regeln habe ich zusammen mit Direktor\\nClavel festgelegt.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2080_rival_06",
      "hash64": "9C0D583D3BBC1B5B",
      "text": "Bei der aktuellen Teilnehmerzahl sollten etwa vier\\nSiege ausreichen, um das Turnier zu gewinnen.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2080_rival_07",
      "hash64": "9C0D573D3BBC19A8",
      "text": "Denk daran, dass auch Lehrer teilnehmen.\\nDie haben es echt drauf, also sieh dich vor![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2080_rival_08",
      "hash64": "9C0D563D3BBC17F5",
      "text": "Und wehe, du machst sie nicht fertig!\\nNur ich darf dich besiegen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2080_staff_07",
      "hash64": "B6EF1B39889F0B3E",
      "text": "Sprich einfach mit mir, wenn du so weit bist.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
