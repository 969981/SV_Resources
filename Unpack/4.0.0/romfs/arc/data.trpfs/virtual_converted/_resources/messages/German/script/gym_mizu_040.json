          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_mizu_040_mizu_15",
      "hash64": "5DF388B7D2FDD238",
      "text": "Bitte beehre uns doch bald wieder! Ich würde\\nmich freuen![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
