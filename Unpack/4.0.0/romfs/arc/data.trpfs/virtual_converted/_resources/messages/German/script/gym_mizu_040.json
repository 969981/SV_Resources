          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_mizu_040_receptionist_01",
      "hash64": "BE32B3458977D795",
      "text": "Möchtest du Arenaleiter Kombu, den Koch,\\nder hohe Wellen schlägt, herausfordern?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "gym_mizu_040_receptionist_02",
      "hash64": "BE32B0458977D27C",
      "text": "Dann bringe ich dich jetzt zum Kampfplatz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mizu_040_receptionist_03",
      "hash64": "BE32B1458977D42F",
      "text": "Sag einfach Bescheid, sobald du bereit bist!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mizu_040_boy_entry_01",
      "hash64": "A66AD42AF62B610B",
      "text": "Kombuuu! Komm, spiel mit mir!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mizu_040_woman_entry_01",
      "hash64": "3EB8108C114F97B3",
      "text": "Dürfte ich Sie darum bitten, die neuen Gerichte\\nin unserem Restaurant zu kosten?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_mizu_040_mizu_entry_01",
      "hash64": "9DC5825CD21ED7A0",
      "text": "Tut mir leid, ihr Lieben, aber die\\nArenaleiterpflichten rufen![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_mizu_040_mizu_entry_02",
      "hash64": "9DC5855CD21EDCB9",
      "text": "Es wartet schon jemand auf mich. Würdet ihr\\neuch noch ein wenig gedulden?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mizu_040_girl_entry_01",
      "hash64": "43B5DA4BCCC05C43",
      "text": "Na guuut!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_040_mizu_01",
      "hash64": "5DF008B7D2FAC2E1",
      "text": "Ah, du bist es! Heeereinspaziert![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_040_mizu_02",
      "hash64": "5DF005B7D2FABDC8",
      "text": "Danke für deine Hilfe in Puerto Marinedo![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_040_mizu_03",
      "hash64": "5DF006B7D2FABF7B",
      "text": "Dank deines Auktionstalents kann ich jetzt das\\nultimative Seegras-Menü auf die Beine stellen![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_040_mizu_04",
      "hash64": "5DF00BB7D2FAC7FA",
      "text": "Aber glaub ja nicht, dass ich mich deshalb im\\nKampf zurücknehmen werde![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_040_mizu_05",
      "hash64": "5DF00CB7D2FAC9AD",
      "text": "[EMPTY 28]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_040_mizu_06",
      "hash64": "5DF009B7D2FAC494",
      "text": "Auf dem Markt kämpft man mit Geld, in der\\nArena geht es etwas handfester zu![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_040_mizu_07",
      "hash64": "5DF00AB7D2FAC647",
      "text": "Doch bei beidem zählen Angriff und Rückzug,\\ngenauso wie die Wogen des Meeres![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_040_mizu_08",
      "hash64": "5DEFFFB7D2FAB396",
      "text": "Ich serviere dir nun ein Drei-Gänge-Menü,\\ngespickt mit Wasser-Pokémon! Mach dich bereit![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_mizu_040_mizu_09",
      "hash64": "5DF000B7D2FAB549",
      "text": "Bwahaha! Das war ja mal eine Niederlage,\\ngenauso erfrischend wie die morgendliche\\r\\nMeeresbrise.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_mizu_040_mizu_10",
      "hash64": "5DF38DB7D2FDDAB7",
      "text": "Für dich war ich wohl nichts weiter als ein hilflos\\nzappelndes Karpador, was?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_mizu_040_mizu_11",
      "hash64": "5DF38CB7D2FDD904",
      "text": "Da kann man nichts machen, das Netz ist\\neingeholt! Was für ein Fang![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_mizu_040_mizu_12",
      "hash64": "5DF38FB7D2FDDE1D",
      "text": "Du hast nicht lockergelassen und dir vollkommen\\nfurchtlos den Sieg geangelt![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_mizu_040_mizu_13",
      "hash64": "5DF38EB7D2FDDC6A",
      "text": "Halten wir den Moment deines Triumphs doch auf\\neinem Foto fest! Die Pose wollte ich schon lange\\r\\nmal ausprobieren![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_mizu_040_mizu_badge",
      "hash64": "49E5EBF085F3C8A5",
      "text": "Mit [VAR 0x0200(0001)] Arenaorden kannst du Pokémon bis\\nLevel [VAR 0x0201(0002)] leichter fangen und sie gehorchen\\r\\ndir aufs Wort.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
