    {
      "ordinal": 25,
      "label": "gym_mizu_040_mizu_14",
      "hash64": "5DF389B7D2FDD3EB",
      "text": "So, jetzt muss ich mich aber langsam um die\\nVorbereitungen im Restaurant kümmern.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
