      "label": "gym_mizu_040_receptionist_00",
      "hash64": "BE32B2458977D5E2",
      "text": "[VAR 0xBD06(0000)]Willkommen in der Arena von Garrafosa City,\\n[VAR 0x0100(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
