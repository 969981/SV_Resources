          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "team_0020_cassiopeia_30",
      "hash64": "063508805A965577",
      "text": "[EMPTY 66]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "team_0020_cassiopeia_31",
      "hash64": "063507805A9653C4",
      "text": "아지트 안의 포켓몬을 쓰러뜨리고\\n보스를 끌어내리도록 해라.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "team_0020_cassiopeia_32",
      "hash64": "06350A805A9658DD",
      "text": "...우선 아지트에 들어가야 하니\\n게이트 앞의 경비들을 정리하도록.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "team_0020_nelke_18",
      "hash64": "082795F2E557798D",
      "text": "너는 어쩔 셈이지?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "team_0020_cassiopeia_33",
      "hash64": "063509805A96572A",
      "text": "...조금 전에 말했다시피\\n나는 스타단의 관계자였다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "team_0020_cassiopeia_34",
      "hash64": "063504805A964EAB",
      "text": "앞장서서 행동할 수 없으니...\\n멀리서 지원하도록 하겠다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "team_0020_nelke_19",
      "hash64": "082794F2E55777DA",
      "text": "나는 뭘 하면 되지?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "team_0020_cassiopeia_35",
      "hash64": "063503805A964CF8",
      "text": "미안하지만 나는 아직 너를\\n완전히 신뢰할 수 없다...\\c\\n그러니 아지트 주변 감시와\\n[VAR 0x0100(0000)]의 서포트를 부탁하겠다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "team_0020_nelke_20",
      "hash64": "082A93F2E559ABFE",
      "text": "...신중한 타입이군, 나쁘지 않지.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "team_0020_cassiopeia_36",
      "hash64": "063506805A965211",
      "text": "작전이 진전되면 다시 연락하겠다.\\n그럼, 건투를 빌겠다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "team_0020_nelke_21",
      "hash64": "082A94F2E559ADB1",
      "text": "...자, 그럼.\\n열심히 해 봐, [VAR 0x0100(0000)].[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "team_0020_select_05",
      "hash64": "BD6A110E869E6F42",
      "text": "교장 선생님...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 63,
      "label": "team_0020_select_06",
      "hash64": "BD6A100E869E6D8F",
      "text": "혹시...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 64,
      "label": "team_0020_nelke_22",
      "hash64": "082A91F2E559A898",
      "text": "어이쿠, 내 정체에 관한 건\\n함구해 줬으면 좋겠어.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "team_0020_nelke_23",
      "hash64": "082A92F2E559AA4B",
      "text": "지금의 나는 네르케...\\n그렇게만 알아 줘.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    }
  ]
