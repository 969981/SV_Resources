            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_dragon_trade_01_04",
      "hash64": "FBEC3DA0F7DAE35C",
      "text": "[VAR 0x0101(0001)][VAR 0x1900(0006)]라...\\n[VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양다운 선택이네요.\\c\\n소중히 키우도록 하겠습니다.[VAR 0x0114(0012)]",
