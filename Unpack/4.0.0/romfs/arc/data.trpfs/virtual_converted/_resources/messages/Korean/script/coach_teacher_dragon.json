    },
    {
      "ordinal": 1,
      "label": "coach_teacher_dragon_first_00b",
      "hash64": "8003CB3C6CB784C2",
      "text": "그레이프 아카데미의 미술 담당이자...\\n포켓몬리그 사천왕 팔자크입니다.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
