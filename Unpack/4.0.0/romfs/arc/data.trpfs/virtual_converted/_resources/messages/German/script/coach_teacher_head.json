      ]
    },
    {
      "ordinal": 1,
      "label": "coach_teacher_head_first_01",
      "hash64": "7AEC149832B803B0",
      "text": "Mein Name ist Clavel. Ich bin der Direktor\\nder Orangen-Akademie.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_head_first_01b",
      "hash64": "972AD09E2EAE7DD6",
      "text": "Mein Name ist Clavel. Ich bin der Direktor\\nder Trauben-Akademie.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_head_sp01_00",
      "hash64": "F2D94A14D3A25ADD",
      "text": "Direktor Cyano hat mich über deine Aktivitäten\\nhier unterrichtet.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_head_sp01_01",
      "hash64": "F2D94914D3A2592A",
      "text": "Du bist in einer AG die Nummer Eins geworden?\\c\\nUnd du gehst auch noch fleißig außerschulischen\\nAktivitäten nach?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_head_sp01_02",
      "hash64": "F2D94814D3A25777",
      "text": "Als dein Direktor erfüllt mich das mit Stolz.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_head_sp01_03",
      "hash64": "F2D94714D3A255C4",
      "text": "Wie laufen die Dinge für dich an der\\nBlaubeer-Akademie?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_head_sp01_select_01",
      "hash64": "1BE69E4EC3A02AE9",
      "text": "Wunderbar!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_head_sp01_select_02",
      "hash64": "1BE69B4EC3A025D0",
      "text": "Na ja...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_head_sp01_04",
      "hash64": "F2D94614D3A25411",
      "text": "Es freut mich ungemein, das zu hören.\\c\\nIch bin froh, dass du dich bereit erklärt hast\\nherzukommen.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_head_sp01_04b",
      "hash64": "498688639CD57F69",
      "text": "Setzt dir etwas zu?\\c\\nVergiss nicht, dass du bei Problemen jederzeit\\nnach Hause zurückkehren kannst.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_head_sp01_05",
      "hash64": "F2D94514D3A2525E",
      "text": "Ich werde eine Weile als Mentor hier sein.\\nDu kannst mich immer gern ansprechen.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_head_sp02_00",
      "hash64": "4C0E082E1AF37DEA",
      "text": "[VAR 0xBD06(0000)]Sag mal, [VAR 0x0100(0000)]. Gibt es hier\\nan\\r\\nder\\r\\nAkademie\\r\\netwas,\\r\\nwas\\r\\ndir\\r\\nProbleme\\r\\nbereitet?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
