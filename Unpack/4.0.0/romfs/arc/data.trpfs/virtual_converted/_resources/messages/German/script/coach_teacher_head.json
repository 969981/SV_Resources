      "label": "coach_teacher_head_first_00",
      "hash64": "7AEC159832B80563",
      "text": "Darf ich eintreten?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
