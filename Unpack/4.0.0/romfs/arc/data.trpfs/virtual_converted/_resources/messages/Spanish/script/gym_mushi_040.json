    },
    {
      "ordinal": 2,
      "label": "gym_mushi_040_receptionist_01",
      "hash64": "6C45357949483B90",
      "text": "¿Quieres enfrentarte a la Líder de Gimnasio\\nAraceli, la Tejedora de Dulces?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mushi_040_receptionist_02",
      "hash64": "6C453879494840A9",
      "text": "Muy bien, permíteme acompañarte a la arena de\\ncombate.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mushi_040_receptionist_03",
      "hash64": "6C45377949483EF6",
      "text": "Avísame cuando estés list[VAR 0x1100(00FF,0101)]oa, no hay prisa.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_mushi_040_mushi_entry_01",
      "hash64": "646E2CD7DF034FC2",
      "text": "Come todo lo que quieras, Vivilloncín.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
