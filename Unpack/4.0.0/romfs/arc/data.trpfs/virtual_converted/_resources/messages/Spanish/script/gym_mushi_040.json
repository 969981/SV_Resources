          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_mushi_040_poke_entry_01",
      "hash64": "65F00449FA87129F",
      "text": "¡Vi, vi!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_mushi_040_mushi_01",
      "hash64": "873EDBF65FF9575F",
      "text": "Oooh... ¡Hay que ver qué Entrenador[VAR 0x1100(00FF,0100)]a más\\nmaravillos[VAR 0x1100(00FF,0101)]oa![VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mushi_040_mushi_02",
      "hash64": "873EDCF65FF95912",
      "text": "Gracias por llevar la aceitunilla a su sitio por ese\\nrecorrido tan tortuoso.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_mushi_040_mushi_03",
      "hash64": "873EDDF65FF95AC5",
      "text": "¡Ay! Se me ha olvidado presentarme, ¿no?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_mushi_040_mushi_04",
      "hash64": "873ED6F65FF94EE0",
      "text": "Soy Araceli, dueña de la confitería Pastelarañas.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mushi_040_mushi_05",
      "hash64": "873ED7F65FF95093",
      "text": "Uy, perdona, ¡si estamos en la arena!\\nA ver, que vuelvo a empezar...[VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_mushi_040_mushi_06",
      "hash64": "873ED8F65FF95246",
      "text": "¡Soy Araceli, Líder de Gimnasio en este\\npueblecito tan acogedor![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_mushi_040_mushi_07",
      "hash64": "873ED9F65FF953F9",
      "text": "También soy pastelera y me paso el día\\npreparando dulces.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_mushi_040_mushi_08",
      "hash64": "873EE2F65FF96344",
      "text": "Los Pokémon insecto, que se esconden entre la\\nmaleza, y los dulces, que provocan esa sensación\\r\\nde felicidad en cuanto te los llevas a la boca,\\r\\ntienen algo en común: ¡son pequeños pero\\r\\nencierran un enorme poder![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 189,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 219,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_mushi_040_mushi_09",
      "hash64": "873EE3F65FF964F7",
      "text": "Así que no bajes la guardia... ¡o puede que te\\nquedes atrapad[VAR 0x1100(00FF,0101)]oa en la tela de araña![VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mushi_040_mushi_10",
      "hash64": "874260F65FFC6F35",
      "text": "Incluso en medio del combate, tu fuerza ha ido\\ncreciendo como pan en el horno.[VAR 0x0114(0016)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
