            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_side01_010_select_03",
      "hash64": "E2B4A6FA0E7406FC",
      "text": "Ähm, danke?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "sdc01_side01_010_select_04",
      "hash64": "E2B4A5FA0E740549",
      "text": "Willst du auch mal?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "sdc01_side01_010_brother_15",
      "hash64": "F25DD2E6987C56B1",
      "text": "S-Sorry, ich wollte nicht aufdringlich sein...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_side01_010_brother_16",
      "hash64": "F25DCFE6987C5198",
      "text": "S-Sorry, so war das nicht gemeint! Aber...\\nÄh, nächstes Mal... vielleicht.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
