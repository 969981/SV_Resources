          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_side01_010_brother_18",
      "hash64": "F25DCDE6987C4E32",
      "text": "Wenigstens kann ich hier im Dorf die Natur\\ngenießen... und reden... zumindest mit dir.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
