    {
      "ordinal": 18,
      "label": "sdc02_0250_select_04",
      "hash64": "B826D4645B764C2B",
      "text": "¿Más allá del Laboratorio Cero?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sdc02_0250_bbteacher_06",
      "hash64": "703B888FDD7C1BCB",
      "text": "Según relata en sus memorias, cuando Eriad se\\nencontraba en la parte más profunda, recaló en\\r\\notro lugar a una profundidad incluso mayor.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
