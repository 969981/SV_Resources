    },
    {
      "ordinal": 22,
      "label": "sdc02_0250_bbteacher_08",
      "hash64": "703B868FDD7C1865",
      "text": "Sin embargo, también afirma que fue incapaz de\\nrecordar el camino que lo condujo hasta allí.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
