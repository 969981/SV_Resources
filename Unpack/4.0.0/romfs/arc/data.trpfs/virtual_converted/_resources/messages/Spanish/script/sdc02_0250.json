      "ordinal": 21,
      "label": "sdc02_0250_bbteacher_07",
      "hash64": "703B878FDD7C1A18",
      "text": "Qué curioso, ¿no?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
