      "ordinal": 23,
      "label": "sdc02_0250_bbteacher_09",
      "hash64": "703B858FDD7C16B2",
      "text": "Si nos fiamos de Eriad, debería haber un lugar\\nprácticamente inexplorado bajo el Área Cero.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
