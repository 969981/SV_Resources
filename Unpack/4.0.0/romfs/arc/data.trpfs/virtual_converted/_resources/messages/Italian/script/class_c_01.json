          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_c_01_history_02",
      "hash64": "293FAE0CFE6036A9",
      "text": "Io sono Morasia, e sono qui per inculcare in\\nquelle vostre testoline un po’ di conoscenza\\r\\ndei tempi antichi.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_c_01_history_03",
      "hash64": "293FAD0CFE6034F6",
      "text": "La storia è straordinaria... addirittura magnifica...\\c\\nI momenti vissuti dai nostri antenati hanno\\nportato al presente in cui oggi noi viviamo...![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_c_01_history_04",
      "hash64": "293FB00CFE603A0F",
      "text": "Oggi vi parlerò di una voragine misteriosa,\\nil luogo più inesplorato di Paldea.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_c_01_history_05",
      "hash64": "293FAF0CFE60385C",
      "text": "Come già saprete, al centro della regione\\nsi trova un’enorme cavità chiamata\\r\\n\"Voragine di Paldea\".[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_c_01_history_06",
      "hash64": "293FB20CFE603D75",
      "text": "La sua parte interna prende il nome di\\n\"Area Zero\" e, tramite l’analisi dei suoi strati\\r\\ngeologici, si è giunti a ipotizzare che risalga\\r\\na oltre un milione di anni fa.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 172,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_c_01_history_07",
      "hash64": "293FB10CFE603BC2",
      "text": "Si credeva, inoltre, che sul fondo di questa\\nvoragine avvolta nel mistero si nascondesse\\r\\nda tempi immemorabili [VAR 0xFF00(0006)]una certa cosa[VAR 0xFF00(0000)].[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_c_01_history_08",
      "hash64": "293FB40CFE6040DB",
      "text": "[VAR 0x0100(0000)], visto che hai avuto la sfortuna\\ndi incrociare il mio sguardo, eccoti una domanda.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
