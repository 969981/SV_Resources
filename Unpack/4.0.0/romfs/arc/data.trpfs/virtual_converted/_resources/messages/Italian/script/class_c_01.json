          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_c_01_history_09",
      "hash64": "293FB30CFE603F28",
      "text": "Cosa si credeva riposasse nelle profondità della\\nVoragine di Paldea, all’interno dell’Area Zero?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
