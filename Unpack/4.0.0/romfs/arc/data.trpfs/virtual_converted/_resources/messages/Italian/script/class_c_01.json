    {
      "ordinal": 0,
      "label": "class_c_01_history_01",
      "hash64": "293FAB0CFE603190",
      "text": "Ooh? Vedo delle facce nuove fra di voi.[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
