    {
      "ordinal": 1,
      "label": "sdc02_4kings_d_04_dragonbb_02",
      "hash64": "0A40D99D4A89486F",
      "text": "[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳對戰的樣子……[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
