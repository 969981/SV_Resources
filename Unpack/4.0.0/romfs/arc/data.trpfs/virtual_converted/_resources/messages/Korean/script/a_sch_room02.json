      "label": "a_sch_room02_ni04",
      "hash64": "F9971A6B036FEA8D",
      "text": "플라베베는 다양한 색이 있지만\\n나는 빨간 플라베베가 좋아!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
