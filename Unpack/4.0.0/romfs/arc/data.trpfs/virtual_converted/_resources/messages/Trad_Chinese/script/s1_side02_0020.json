    {
      "ordinal": 0,
      "label": "s1_side02_0020_camera_01",
      "hash64": "91148EA99DBDF52E",
      "text": "同學！\\n[VAR 0x1100(00FF,0101)]你妳要來讓我拍照……不對！\\r\\n要來讓我見識[VAR 0x1100(00FF,0101)]你妳的實力了嗎？[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
