        }
      ]
    },
    {
      "ordinal": 5,
      "label": "a_sch_office03_ni01",
      "hash64": "5CB3DF5C0B29144A",
      "text": "Los estudiantes llaman cariñosamente \"Mimuchi\"\\na la enfermera Mimí a sus espaldas.\\c\\nUn día se me ocurrió llamarla así y la mirada que\\nme lanzó me dejó temblando.",
      "flags": 0,
      "text_status": "DECODED",
