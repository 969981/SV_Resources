      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_g_04_ansewer_01c",
      "hash64": "9189F77CF99A8D31",
      "text": "스피드가 오른다",
      "flags": 0,
      "text_status": "DECODED",
