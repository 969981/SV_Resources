      "text": "……但是，\\n[VAR 0x1100(00FF,0101)]你妳可不一樣吧？[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
