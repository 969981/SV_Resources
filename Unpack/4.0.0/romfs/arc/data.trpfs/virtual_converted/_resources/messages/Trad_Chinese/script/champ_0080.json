      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0080_dragon_04",
      "hash64": "0B8705B70EFDD0EE",
      "text": "雖然這位女士有點愛胡鬧，\\n但她與小生相同，是四天王之一呢。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
