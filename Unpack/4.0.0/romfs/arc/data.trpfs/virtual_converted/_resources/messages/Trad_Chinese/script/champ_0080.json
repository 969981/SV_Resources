    {
      "ordinal": 10,
      "label": "champ_0080_ground_05",
      "hash64": "964B939853F50731",
      "text": "別因為我是個美女\\n就怕我喲。[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
