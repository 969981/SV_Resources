      "label": "legend_0020_select_03",
      "hash64": "3539ECB8805E87D8",
      "text": "没关系！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "legend_0020_select_04",
      "hash64": "3539F3B8805E93BD",
      "text": "好伤心……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "legend_0020_friend_14a",
      "hash64": "F5DD15F12F1B05AF",
      "text": "啊～！真是的！怎么搞得\\n好像只有我是坏人一样！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "legend_0020_friend_14b",
      "hash64": "F5DD16F12F1B0762",
      "text": "啊～！真是的！\\n我知道了，知道了啦！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
