      "ordinal": 12,
      "label": "legend_0020_friend_07",
      "hash64": "5E78499F7376D164",
      "text": "好嘞！看我大展厨艺，\\n烹饪一番吧！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
