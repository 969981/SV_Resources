        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0310_sister_04",
      "hash64": "37C466E08A07965F",
      "text": "你跟他说了\\n鬼的事情！？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
