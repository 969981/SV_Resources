      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0310_gfather_02",
      "hash64": "D770785E295BF5F4",
      "text": "鬼的面具……[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
