          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0310_gfather_03",
      "hash64": "D770795E295BF7A7",
      "text": "让乌栗……\\n给拿走了。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
