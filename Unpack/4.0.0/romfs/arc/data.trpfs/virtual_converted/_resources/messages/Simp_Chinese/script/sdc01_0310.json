          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0310_sister_03",
      "hash64": "37C463E08A079146",
      "text": "为什么是阿栗！？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
