    {
      "ordinal": 8,
      "label": "sdc01_0210_sister_07",
      "hash64": "0E6C3B1207302479",
      "text": "我爺爺他很了解\\n村子的歷史，\\r\\n我們找他商量看看昨天的事吧。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
