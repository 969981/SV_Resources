  "entries": [
    {
      "ordinal": 0,
      "label": "club_itemmachine_msg_first_00",
      "hash64": "6C76D0975AF7CD8E",
      "text": "Vielen Dank, dass du dich dazu bereit erklärt\\nhast, den Itemdrucker zu testen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "club_itemmachine_msg_first_01",
      "hash64": "6C76D1975AF7CF41",
      "text": "Ich bin ein Mitglied der Wissenschafts-AG, auf\\nderen Konto die Entwicklung dieses Geräts geht.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "club_itemmachine_msg_first_02",
      "hash64": "6C76CE975AF7CA28",
      "text": "Und weil alles noch neu ist, bin ich gekommen,\\num die Bedienung des Druckers zu erklären.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "club_itemmachine_msg_first_03",
      "hash64": "6C76CF975AF7CBDB",
      "text": "Gut, dann will ich dir gleich mal zeigen,\\nwas es mit dieser Maschine auf sich hat.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "club_itemmachine_msg_first_04",
      "hash64": "6C76D4975AF7D45A",
      "text": "Man gibt einfach einige Pokémon-Materialien\\nhinein sowie ein paar BP und erhält dafür Items.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "club_itemmachine_msg_first_05",
      "hash64": "6C76D5975AF7D60D",
      "text": "Die exakte Mechanik dahinter unterliegt jedoch\\nstrikter Geheimhaltung. Wir sind nämlich gerade\\r\\ndabei, ein Patent darauf anzumelden...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "club_itemmachine_msg_first_06",
      "hash64": "6C76D2975AF7D0F4",
      "text": "Doch das muss dich nicht weiter interessieren.\\c\\nEntscheidend ist, dass du Pokémon-Materialien in\\ndieses Gerät gibst, um Items drucken zu können.\\r\\nFantastisch, oder?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "club_itemmachine_msg_first_07",
      "hash64": "6C76D3975AF7D2A7",
      "text": "Es ist wirklich kinderleicht! Und aufregend!\\nIch bin jedes Mal total gespannt, welches Item\\r\\nam Ende wohl rauskommt! In diesem Sinne...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "club_itemmachine_msg_start_00",
      "hash64": "47D2451C8CF88184",
