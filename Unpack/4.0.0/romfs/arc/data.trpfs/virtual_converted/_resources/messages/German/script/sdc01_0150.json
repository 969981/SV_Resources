          "args_hex": [
            "0001",
            "202F"
          ]
        },
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0150_brother_02",
      "hash64": "E1226DC8663736F9",
      "text": "Du schaffst das, [VAR 0x0100(0000)]![VAR 0x0114(0043)]",
