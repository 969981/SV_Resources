          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_side02_fieldwork_sazare_pokehint_04",
      "hash64": "28306955EE0180E8",
      "text": "真不愧是助手[VAR 0x1100(00FF,0101)]你妳呢～！\\c\\n在附近的洞窟裡也許也有寶可夢！\\n[VAR 0x1100(00FF,0101)]你妳的話一定可以輕鬆把牠們拍下來吧！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
