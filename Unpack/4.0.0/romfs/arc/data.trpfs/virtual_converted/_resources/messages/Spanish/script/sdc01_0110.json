        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0110_brother_10",
      "hash64": "EDA34903CD2162F6",
      "text": "¿Qué más te da, eh? ¿Y tú? ¿Qué haces aquí?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_0110_sister_04",
      "hash64": "0F0880773724E9F9",
      "text": "Ah, sí. Abuela, no encuentro mi máscara por\\nninguna parte.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
