    },
    {
      "ordinal": 37,
      "label": "sdc01_0110_brother_11",
      "hash64": "EDA34A03CD2164A9",
      "text": "¡E-espera! ¡Serás fullera![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc01_0110_gfather_07",
      "hash64": "A482EBB30424FEF5",
      "text": "Espero que no te importe demasiado todo el\\nbarullo, [VAR 0x0100(0000)]. Siempre están así.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
