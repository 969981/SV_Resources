          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc01_0110_gfather_08",
      "hash64": "A482ECB3042500A8",
      "text": "Mis nietos son para darles de comer aparte,\\npero es lo que hay... Tú ármate de paciencia.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc01_0110_gmother_12",
      "hash64": "24BE959E9306FEBC",
      "text": "Recuerdo guardar las máscaras en el cobertizo,\\ny eran tres, si no me equivoco.\\c\\nHay para todos, así que no os peleéis.[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
