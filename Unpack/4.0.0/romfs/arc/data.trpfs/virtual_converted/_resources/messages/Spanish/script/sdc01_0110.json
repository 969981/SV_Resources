      ]
    },
    {
      "ordinal": 35,
      "label": "sdc01_0110_gfather_06",
      "hash64": "A482EAB30424FD42",
      "text": "No debería tener la llave echada, así que podéis\\nir los tres a mirar.[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
