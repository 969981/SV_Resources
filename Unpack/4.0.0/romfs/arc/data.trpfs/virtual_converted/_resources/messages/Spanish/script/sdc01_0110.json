      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0110_sister_03",
      "hash64": "0F0881773724EBAC",
      "text": "Uy... ¿No me digas?[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
