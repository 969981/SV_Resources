          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_0110_gmother_11",
      "hash64": "24BE989E930703D5",
      "text": "Las máscaras... Creo que las guardé en el\\ncobertizo tras el festival del año pasado.[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
