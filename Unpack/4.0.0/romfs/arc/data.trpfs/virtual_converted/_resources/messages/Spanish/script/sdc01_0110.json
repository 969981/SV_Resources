    },
    {
      "ordinal": 30,
      "label": "sdc01_0110_brother_09",
      "hash64": "EDA65603CD23AEE4",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)] y yo vamos a ir juntos al\\nFestival de Máscaras.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
