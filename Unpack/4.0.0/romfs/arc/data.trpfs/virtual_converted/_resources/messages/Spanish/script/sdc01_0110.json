          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc01_0110_sister_05",
      "hash64": "0F087F773724E846",
      "text": "¡Vale! Vamos al cobertizo. ¡Tonto el último![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
