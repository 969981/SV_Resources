          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_kakutou_010_kakutouboss_03",
      "hash64": "4B28877826B0E07D",
      "text": "Qué atrevida es la ignorancia.\\c\\nNo quiero arriesgarme a que nadie más salga\\nherido. Punto.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
