        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_kakutou_010_nelke_02",
      "hash64": "94C02931DE6422E0",
      "text": "Lo que no me queda claro es qué hace la jefa en\\npersona vigilando la entrada.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_kakutou_010_nelke_03",
      "hash64": "94C02A31DE642493",
      "text": "¿No te fías de tus Reclutas o qué pasa?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
