      ]
    },
    {
      "ordinal": 37,
      "label": "sdc02_0080_fairybb_15",
      "hash64": "CE94207B27A3DA6B",
      "text": "블루레크는 돔 안에서 활동 중일 때\\n아카데미에서 내리는 미션이에요.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
