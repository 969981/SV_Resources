    {
      "ordinal": 41,
      "label": "sdc02_0080_fairybb_11",
      "hash64": "CE94247B27A3E137",
      "text": "BP는 [VAR 0xFF00(0006)]식당[VAR 0xFF00(0000)]이나 [VAR 0xFF00(0006)]매점[VAR 0xFF00(0000)]에서\\n돈 대신 쓸 수 있어요!\\r\\n그리고 [VAR 0xFF00(0006)]부활동[VAR 0xFF00(0000)]을 할 때도요...[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
