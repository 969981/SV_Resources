          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc02_0080_fairybb_16",
      "hash64": "CE94217B27A3DC1E",
      "text": "맡기기 배틀을 하거나\\n특정 포켓몬을 잡는 등,\\r\\n다양한 미션에 도전할 수 있어요![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc02_0080_fairybb_17",
      "hash64": "CE94227B27A3DDD1",
      "text": "언제 어디서 어떤 미션이 나올지는\\n누구도 예측할 수 없지만요.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc02_0080_fairybb_18",
      "hash64": "CE941B7B27A3D1EC",
      "text": "미션을 클리어할 때마다 아카데미 내 통화인\\n[VAR 0xFF00(0006)]BP(블루베리포인트)[VAR 0xFF00(0000)]를 받을 수 있어요![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
