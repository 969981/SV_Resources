      ]
    },
    {
      "ordinal": 43,
      "label": "sdc02_0080_fairybb_13",
      "hash64": "CE94267B27A3E49D",
      "text": "...끝이에요!\\n급하게 설명해서 죄송해요.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
