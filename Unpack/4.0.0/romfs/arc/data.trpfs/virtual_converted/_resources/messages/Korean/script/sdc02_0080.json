    {
      "ordinal": 42,
      "label": "sdc02_0080_fairybb_12",
      "hash64": "CE94257B27A3E2EA",
      "text": "아무튼, 블루레크를 하면서\\nBP를 많이 모아 보세요![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
