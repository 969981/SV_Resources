      "ordinal": 0,
      "label": "a_sch_office03_eve01",
      "hash64": "8F5DA6DBF9785311",
      "text": "只要盯著寶可夢的眼睛，\\n我就能知道牠在想什麼。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
