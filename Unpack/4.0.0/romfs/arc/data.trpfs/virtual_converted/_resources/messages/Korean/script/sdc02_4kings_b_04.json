      "ordinal": 11,
      "label": "sdc02_4kings_a_04_steelbb_08",
      "hash64": "7B2CD1B0CD4D3284",
      "text": "그리고 가능하다면\\n네리네는 그를 구원하고 싶습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
