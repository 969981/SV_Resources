          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc02_0050_fairybb_21",
      "hash64": "17FDD7564E4BB60F",
      "text": "那么，怀着全新的心情，\\n接下来就去学园里面看看吧。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
