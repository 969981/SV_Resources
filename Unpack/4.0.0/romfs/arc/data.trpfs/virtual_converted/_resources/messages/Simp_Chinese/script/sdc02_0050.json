        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc02_0050_fairybb_22",
      "hash64": "17FDD8564E4BB7C2",
      "text": "在学园内移动时，\\n可以从那边的闸门选择目的地。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
