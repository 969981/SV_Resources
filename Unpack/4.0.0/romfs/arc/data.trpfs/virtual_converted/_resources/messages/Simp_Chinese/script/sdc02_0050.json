    {
      "ordinal": 35,
      "label": "sdc02_0050_headbb_15",
      "hash64": "94C4993947E18809",
      "text": "在帕底亚的时装店或美容院\\n会有更多选择哦～[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
