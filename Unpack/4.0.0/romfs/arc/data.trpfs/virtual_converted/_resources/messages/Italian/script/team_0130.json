      ]
    },
    {
      "ordinal": 4,
      "label": "team_0130_cassiopeia_05",
      "hash64": "17FB7D7934A00075",
      "text": "Poi ti ho tenut[VAR 0x1100(00FF,0101)]oa d’occhio fingendomi parte\\ndella squadra rifornimenti.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
