    },
    {
      "ordinal": 15,
      "label": "team_0130_cassiopeia_12",
      "hash64": "17FE807934A23B65",
      "text": "Proprio così. Avrei un compito da assegnare\\nanche a te, Garoff.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
