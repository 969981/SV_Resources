    },
    {
      "ordinal": 6,
      "label": "team_0130_cassiopeia_07",
      "hash64": "17FB7B79349FFD0F",
      "text": "Ma allo stesso tempo, una parte di me vuole\\nche il Team Star continui a esistere.\\c\\nQuindi non ho intenzione di farmi battere tanto\\nfacilmente![VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
