    {
      "ordinal": 1,
      "label": "team_0130_cassiopeia_02",
      "hash64": "17FB7679349FF490",
      "text": "Eccoti svelata la vera identità dell’Arcicapo...\\nNonché di Cassiopea.[VAR 0x0114(0009)]",
