    },
    {
      "ordinal": 5,
      "label": "team_0130_cassiopeia_06",
      "hash64": "17FB7A79349FFB5C",
      "text": "Tutte le tue fatiche sono servite ad arrivare fino\\na qui. Se mi sconfiggi, il Team Star avrà chiuso\\r\\ndefinitivamente.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
