      "ordinal": 42,
      "label": "ajito_doku_040_dokuboss_19",
      "hash64": "7EE6455EC924E16B",
      "text": "[EMPTY 61]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
