    },
    {
      "ordinal": 54,
      "label": "ajito_doku_040_dokuboss_24",
      "hash64": "7EF0525EC92D4C07",
      "text": "I owe you a great debt.[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "ajito_doku_040_nelke_03",
      "hash64": "BD2F1E2F0598E5E5",
      "text": "It seems we’re one step closer to the truth behind\\nTeam Star’s truancy—and the bullying at the\\r\\nacademy. But more importantly...[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "ajito_doku_040_nelke_04",
      "hash64": "BD2F172F0598DA00",
      "text": "I can’t believe I had no idea about these issues\\nthe students are struggling with...\\c\\nThey have friendships they hold dear and reasons\\nfor acting as they do. I just couldn’t see it.[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 183,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "ajito_doku_040_nelke_05",
      "hash64": "BD2F182F0598DBB3",
      "text": "It’s shameful how oblivious I’ve been.[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
