    },
    {
      "ordinal": 2,
      "label": "kizuna_botan_b_select_01",
      "hash64": "9C6184E6696213A4",
      "text": "我知道了",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_botan_b_select_02",
      "hash64": "9C6187E6696218BD",
      "text": "躡手躡腳……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_botan_b_03",
      "hash64": "E3AE77C10464675F",
      "text": "窸窸窣窣……（謝謝[VAR 0x1100(00FF,0101)]你妳。）[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
