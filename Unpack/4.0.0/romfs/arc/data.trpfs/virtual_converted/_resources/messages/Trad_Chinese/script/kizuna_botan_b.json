            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_botan_b_doku_01",
      "hash64": "56D19D9ADF00CBC7",
      "text": "唔唔唔唔唔唔……[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_botan_b_doku_02",
      "hash64": "56D19E9ADF00CD7A",
      "text": "本校的販賣部，商品真是齊全……[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_botan_b_doku_03",
      "hash64": "56D19F9ADF00CF2D",
      "text": "老實說，在下過去太小看販賣部了。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_botan_b_04",
      "hash64": "E3AE74C104646246",
      "text": "……秋明他好像很感動。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_botan_b_05",
      "hash64": "E3AE75C1046463F9",
      "text": "看起來不會被他發現，\\n我們就正常地說話吧。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_botan_b_06",
      "hash64": "E3AE72C104645EE0",
      "text": "就某種意思來說，天星隊成員裡\\n人家最擔心的可能就是秋明了……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_botan_b_doku_04",
      "hash64": "56D1989ADF00C348",
      "text": "……那個，店員閣下。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_botan_b_doku_05",
      "hash64": "56D1999ADF00C4FB",
      "text": "在下想要購買\\n本日發售並且限定５套的\\r\\n忍者角色扮演套裝……[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_botan_b_shop_01",
      "hash64": "CEB99516CE53ECD8",
      "text": "我看看喔，\\n忍者角色扮演套裝……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "kizuna_botan_b_shop_02",
      "hash64": "CEB99816CE53F1F1",
      "text": "……真抱歉。\\n剛剛有客人一口氣買了２套，\\r\\n結果全部都賣光了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_botan_b_doku_06",
      "hash64": "56D19A9ADF00C6AE",
      "text": "什麼……！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_botan_b_doku_07",
      "hash64": "56D19B9ADF00C861",
      "text": "如果買不到那個套裝，\\n在下……在下就……！！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_botan_b_doku_08",
      "hash64": "56D1949ADF00BC7C",
      "text": "行！\\n在下就去找出剛剛那個客人！！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_botan_b_doku_09",
      "hash64": "56D1959ADF00BE2F",
      "text": "看在下用眼力，\\n然後下跪求那個客人把東西讓給在下！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_botan_b_07",
      "hash64": "E3AE73C104646093",
      "text": "哇！哇！\\n秋明意外地很清爽嘛！！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_botan_b_08",
      "hash64": "E3AE80C1046476AA",
      "text": "不、不對，比起那個，\\n下跪的話會引起不必要的注目……\\r\\n人家還是去阻止秋明比較好，對吧？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_botan_b_select_03",
      "hash64": "9C6186E66962170A",
      "text": "去阻止吧",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "kizuna_botan_b_select_04",
      "hash64": "9C6181E669620E8B",
      "text": "看看狀況",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "kizuna_botan_b_09a",
      "hash64": "45FEB6FA76B84DF4",
      "text": "就、就這麼辦……！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_botan_b_09b",
      "hash64": "45FEB9FA76B8530D",
      "text": "可、可是……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_botan_b_student_01",
      "hash64": "CFF667CFE19942AD",
      "text": "啊，秋明閣下～\\n你在這裡啊！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "kizuna_botan_b_doku_10",
      "hash64": "56D5229ADF03E39D",
      "text": "同胞！！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_botan_b_doku_11",
      "hash64": "56D5219ADF03E1EA",
      "text": "同、同胞，在下必須道歉……[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_botan_b_doku_12",
      "hash64": "56D5209ADF03E037",
      "text": "在下……和同胞你約定好的\\n扮忍者遊戲的服裝……[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_botan_b_student_02",
      "hash64": "CFF664CFE1993D94",
      "text": "啊，那個服裝我買了２套喔～",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "kizuna_botan_b_doku_13",
      "hash64": "56D51F9ADF03DE84",
      "text": "……欸？[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_botan_b_student_03",
      "hash64": "CFF665CFE1993F47",
      "text": "剛剛我來販賣部瞧瞧，\\n正好那套服裝到貨了，\\r\\n我就把秋明閣下和我的份給買好了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_botan_b_student_04",
      "hash64": "CFF662CFE1993A2E",
      "text": "那套服裝很受歡迎，\\n能買到真是太好了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "kizuna_botan_b_student_05",
      "hash64": "CFF663CFE1993BE1",
      "text": "我們趕快去外面\\n玩扮忍者遊戲吧～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "kizuna_botan_b_doku_14",
      "hash64": "56D51E9ADF03DCD1",
      "text": "……竟然是這麼一回事啊！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_botan_b_doku_15",
      "hash64": "56D51D9ADF03DB1E",
      "text": "那麼，在下去房間裡\\n把在下的手裡劍拿來。\\r\\n我們射手裡劍來玩。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "kizuna_botan_b_student_06",
      "hash64": "CFF660CFE19936C8",
      "text": "哇！太棒了～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "kizuna_botan_b_doku_16",
      "hash64": "56D51C9ADF03D96B",
      "text": "靠在下的裁縫技巧，\\n還能把服裝改造成\\r\\n充滿猛毒要素的外觀喔！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "kizuna_botan_b_student_07",
      "hash64": "CFF661CFE199387B",
      "text": "嗯～\\n那倒是不太需要。",
