          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0020_friend_04",
      "hash64": "173BF59E992CF16A",
      "text": "D-Das ist wirklich nicht nötig! Wir wollen Ihnen\\nnicht noch mehr Beistände umreiten, äh...\\r\\nUmstände bereiten![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
