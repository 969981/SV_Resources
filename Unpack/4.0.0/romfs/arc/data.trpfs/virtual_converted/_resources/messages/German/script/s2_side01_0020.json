      "ordinal": 23,
      "label": "s2_side01_0020_friend_07",
      "hash64": "173BF49E992CEFB7",
      "text": "Ach ja, der Brief. Willst du ihn nicht lesen?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
