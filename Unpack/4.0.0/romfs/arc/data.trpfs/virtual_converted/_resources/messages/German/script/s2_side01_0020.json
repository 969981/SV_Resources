          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_side01_0020_mama_05",
      "hash64": "510DA657FC293C81",
      "text": "Von jemandem namens „Jo“...\\nSagt dir der Name etwas?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side01_0020_mama_06",
      "hash64": "510DA357FC293768",
      "text": "Wie schön, dass du so viele Freunde hast![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side01_0020_mama_07",
      "hash64": "510DA457FC29391B",
      "text": "Nicht? Hm... Na, vielleicht hilft es deinem\\nGedächtnis ja auf die Sprünge, wenn du den\\r\\nBrief liest.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
