          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0020_mama_02",
      "hash64": "510DA757FC293E34",
      "text": "Haha, darum musst du dir nun wirklich keine\\nSorgen machen.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side01_0020_mama_03",
      "hash64": "510DA857FC293FE7",
      "text": "Ihr würdet mir nur Umstände bereiten, wenn ihr\\neuch nicht wie zu Hause fühlen würdet![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side01_0020_friend_05",
      "hash64": "173BF69E992CF31D",
      "text": "N-Na gut...![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
