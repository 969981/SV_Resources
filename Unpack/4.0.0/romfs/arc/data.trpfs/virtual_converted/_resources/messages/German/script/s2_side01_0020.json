          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side01_0020_mama_08",
      "hash64": "510DA157FC293402",
      "text": "Hier, bitte.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side01_0020_mama_09",
      "hash64": "510DA257FC2935B5",
      "text": "Dann geh ich mal ein paar leckere Snacks\\nfür euch vorbereiten. Hihi![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_side01_0020_rival_03",
      "hash64": "F20984A16E90FD5D",
      "text": "Warten Sie, ich helfe Ihnen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
