      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0020_friend_03",
      "hash64": "173BF09E992CE8EB",
      "text": "Nur die Einrichtung ist vielleicht etwas zu niedlich\\nfür meinen Geschmack...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
