      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side01_0020_mama_04",
      "hash64": "510DA557FC293ACE",
      "text": "Da fällt mir ein... Es ist ein Brief für dich\\ngekommen, [VAR 0x0100(0000)].[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
