          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0020_mama_01",
      "hash64": "510DAA57FC29434D",
      "text": "Seid ihr denn auch alle satt geworden?\\nIch könnte euch noch ein paar Snacks bringen![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
