      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_dragon_b_04a",
      "hash64": "70087DC730A13A08",
      "text": "Sì, mi basta osservarvi per trovare nuovo slancio\\na mia volta.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
