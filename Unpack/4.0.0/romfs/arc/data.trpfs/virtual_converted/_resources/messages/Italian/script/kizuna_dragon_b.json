    {
      "ordinal": 1,
      "label": "kizuna_dragon_b_02",
      "hash64": "268D8A536FED8D1F",
      "text": "A volte mi capita di venire qui al campo sportivo.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
