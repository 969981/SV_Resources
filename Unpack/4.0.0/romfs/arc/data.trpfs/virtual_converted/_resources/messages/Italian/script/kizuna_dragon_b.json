    {
      "ordinal": 3,
      "label": "kizuna_dragon_b_select_01",
      "hash64": "E0C4B9E0FB4EC661",
      "text": "Ah sì?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
