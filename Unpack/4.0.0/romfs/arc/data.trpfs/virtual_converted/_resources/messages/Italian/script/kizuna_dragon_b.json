          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_dragon_b_04b",
      "hash64": "700880C730A13F21",
      "text": "Mh? Curioso che ti trovi già d’accordo con me...\\nGuarda che sei ancora giovane come loro![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_dragon_b_tamer_01",
      "hash64": "0E3DFA9305CD80EC",
      "text": "Signor Oranzio, potrei parlarle un momento?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_dragon_b_05",
      "hash64": "268D87536FED8806",
      "text": "Tu...! Cosa ci fai qui?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_dragon_b_06",
      "hash64": "268D86536FED8653",
      "text": "Mi era sembrato di averti detto chiaramente\\ndi non venire a scuola.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
