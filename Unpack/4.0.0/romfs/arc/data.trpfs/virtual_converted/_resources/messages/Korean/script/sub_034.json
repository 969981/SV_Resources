            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_034_ecology_02",
      "hash64": "AE533DC3090DFFD1",
      "text": "방금 검은 결정의\\n테라스탈 반응이 사라졌는데,\\r\\n혹시 뭔가 아는 거 없니!?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_034_select_01",
      "hash64": "CEC57F51382C7B18",
      "text": "제가 이겼어요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_034_select_02",
      "hash64": "CEC58251382C8031",
      "text": "큰일 날 뻔했어요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_034_ecology_03",
      "hash64": "AE533CC3090DFE1E",
      "text": "뭐어!? 그 포켓몬이랑 싸운 거야!?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_034_ecology_04",
      "hash64": "AE533FC3090E0337",
      "text": "하아... 위험하다고\\n그렇게나 말했는데...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_034_ecology_05",
      "hash64": "AE533EC3090E0184",
      "text": "그래도 [VAR 0x0100(0000)][VAR 0x1900(0003)]\\n무사하다니까 정말 다행이야~[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "1900",
          "args_hex": [
            "0003"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_034_ecology_06",
      "hash64": "AE5341C3090E069D",
      "text": "덕분에 테라스탈 에너지가 방출될 때의\\n법칙성도 알 수 있을 것 같아.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_034_ecology_07",
      "hash64": "AE5340C3090E04EA",
      "text": "조사해 줘서 고마워~\\n도움을 준 사례를 보내 줄게~[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sub_034_ecology_08",
      "hash64": "AE5333C3090DEED3",
      "text": "그건 그렇고... 방출되는 에너지가\\n점점 많아지고 있는 걸 보아하니,[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sub_034_ecology_09",
      "hash64": "AE5332C3090DED20",
      "text": "앞으로도 검은 결정의\\n테라 레이드가 발견될지도 모르겠어.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_034_ecology_10",
      "hash64": "AE4FB5C3090AE2E2",
      "text": "내가 아무리 말려도\\n[VAR 0x0100(0000)][VAR 0x1900(0001)] 듣지 않을 테니까\\r\\n강하게 막진 않을 거지만...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "1900",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_034_ecology_11",
      "hash64": "AE4FB6C3090AE495",
      "text": "앞으로는 되도록\\n조심해 줬으면 좋겠어.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_034_ecology_12",
      "hash64": "AE4FB3C3090ADF7C",
      "text": "아, 클라벨 선생님한테 들키면\\n성원숭보다 무섭게 화내실 테니까,\\r\\n이 일은 우리 둘만의 비밀로 하자...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
