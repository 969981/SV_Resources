      "hash64": "1A427FAD0C68812D",
      "text": "洛托洛托洛托洛托……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_0990_friend_01",
      "hash64": "9C4F5DDF0F4F9DEA",
      "text": "哟！是我，派帕！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
