          ]
        }
      ]
    },
    {
      "ordinal": 69,
      "label": "sdc02_0230_bbteacher_23",
      "hash64": "FA2CA9C9DB98E44C",
      "text": "我期盼已久的第零區調查，\\n即將要實現了……！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
