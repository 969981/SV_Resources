      ]
    },
    {
      "ordinal": 66,
      "label": "sdc02_0230_chairman_23",
      "hash64": "7AA1206FC1E3D417",
      "text": "感謝各位的鼎力相助。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
