    },
    {
      "ordinal": 68,
      "label": "sdc02_0230_bbteacher_22",
      "hash64": "FA2CAAC9DB98E5FF",
      "text": "請交給我們吧，也慈。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
