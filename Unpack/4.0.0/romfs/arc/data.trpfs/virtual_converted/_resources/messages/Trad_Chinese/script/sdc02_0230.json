    },
    {
      "ordinal": 67,
      "label": "sdc02_0230_chairman_24",
      "hash64": "7AA11D6FC1E3CEFE",
      "text": "期待大家能帶著\\n豐碩的成果回來。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
