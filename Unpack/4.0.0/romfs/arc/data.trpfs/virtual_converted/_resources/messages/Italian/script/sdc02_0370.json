  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_0370_bbteacher_01",
      "hash64": "43953386D8BF9EF9",
      "text": "Eccoti, [VAR 0x0100(0000)]! Ben arrivat[VAR 0x1100(00FF,0101)]oa![VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
