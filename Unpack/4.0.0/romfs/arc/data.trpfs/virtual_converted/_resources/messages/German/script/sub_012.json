  "entries": [
    {
      "ordinal": 0,
      "label": "common_2090_staff_01",
      "hash64": "C4F4EF63999FC327",
      "text": "Möchtest du dich zum Großen Akademieturnier\\nanmelden?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_2090_staff_02",
      "hash64": "C4F4F063999FC4DA",
      "text": "[VAR 0xBD06(0000)]Du bist [VAR 0x0100(0000)] und hast den\\nChamp-Rang\\r\\ninne,\\r\\nkorrekt?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2090_staff_03",
      "hash64": "C4F4F163999FC68D",
      "text": "So, deine Anmeldung ist hiermit abgeschlossen.\\nBegib dich nun bitte zum Austragungsort.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_012_announce_00",
      "hash64": "835D61A437E8925A",
      "text": "Auf ein Neues heiße ich alle Zuschauer herzlich\\nbeim Großen Akademieturnier willkommen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_012_announce_01",
      "hash64": "835D62A437E8940D",
      "text": "Und da ich niemanden auf die Folter spannen\\nmöchte, kommen wir gleich zum ersten Kampf!\\r\\nWen wird das Los zusammenführen...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sub_012_announce_02",
      "hash64": "835D5FA437E88EF4",
      "text": "Weiter geht es mit Runde 2. Welche Trainer\\ntreten diesmal gegeneinander an...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_012_announce_03",
      "hash64": "835D60A437E890A7",
      "text": "Für unsere vier verbleibenden Teilnehmer wird es\\nnun Zeit für Runde 3!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_012_announce_04",
      "hash64": "835D5DA437E88B8E",
      "text": "Damit erwartet uns endlich das große Finale\\ndieses Turniers!\\c\\nMal sehen, welche beiden Kontrahenten um den\\ngroßen Sieg kämpfen werden!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_012_announce_intro_00",
      "hash64": "97756563206B2279",
      "text": "Champ [VAR 0x0100(0000)] gegen...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_012_announce_intro_01",
      "hash64": "97756463206B20C6",
      "text": "...Pepper, die kochende Legende aus der 2-G!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_012_announce_intro_02",
      "hash64": "97756363206B1F13",
      "text": "...Cosima, die Star-Hackerin aus der 1-D!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_012_announce_intro_03",
      "hash64": "97756263206B1D60",
      "text": "...Señora Amura, unsere heißblütige Lehrerin des\\nKampfkurses!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_012_announce_intro_04",
      "hash64": "97756963206B2945",
      "text": "...Señora Quendella, unsere Mathelehrerin mit\\nexponentieller Siegeschance!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_012_announce_intro_05",
      "hash64": "97756863206B2792",
      "text": "...Señora Moira, unsere Geschichtslehrerin mit\\neinem Faible für die Antike!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_012_announce_intro_06",
      "hash64": "97756763206B25DF",
      "text": "...Señora Mimi, Sanitäterin und gute Seele\\nunserer Akademie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sub_012_announce_intro_07",
      "hash64": "97756663206B242C",
      "text": "...Señor Saguaro, unseren Hauswirtschaftslehrer\\nmit der harten Schale, aber weichem Kern!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_012_announce_intro_08",
      "hash64": "97756D63206B3011",
      "text": "...Señor Jim, unseren tiefenentspannten Lehrer\\nfür Biologie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sub_012_announce_intro_09",
      "hash64": "97756C63206B2E5E",
      "text": "...Señor Salvatore, unseren Fremdsprachenlehrer\\nund wandelndes Wörterbuch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "sub_012_announce_intro_10",
      "hash64": "9771DF63206808F0",
      "text": "...Champ Nemila, die stärkste Schulsprecherin\\nin der Geschichte der Akademie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "sub_012_announce_intro_11",
      "hash64": "9771E06320680AA3",
      "text": "...Direktor Clavel, einen Mann formvollendeter\\nGalanterie und Direktor unserer Akademie!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sub_012_announce_intro_12",
      "hash64": "9771E16320680C56",
      "text": "...Señor Sinius, unseren Kunstlehrer und\\nfauchenden Drachen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sub_012_announce_intro_13",
      "hash64": "9771E26320680E09",
      "text": "...Señora Sagaria, Vorstandsvorsitzende der\\nAkademie und Top-Champ in einer Person!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sub_012_chara_01_01",
      "hash64": "EB3B7AECC59255DD",
      "text": "Och nö! Warum ausgerechnet du?! Egal!\\nNur wer wagt, gewinnt. Das ist meine Chance![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sub_012_chara_01_02",
      "hash64": "EB3B77ECC59250C4",
      "text": "Grmpf. Ich hatte aber auch echt Pech,\\nausgerechnet dich zugelost zu bekommen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sub_012_chara_02_01",
      "hash64": "9206BAD37E412F6A",
      "text": "Meine Evoli machen nicht einmal vor dir Halt,\\n[VAR 0x0100(0000)]...![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sub_012_chara_02_02",
      "hash64": "9206B9D37E412DB7",
      "text": "Du bist einfach irre stark, [VAR 0x0100(0000)]...\\nAber weißt du, was? Ich bin megastolz auf dich![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sub_012_chara_03_01",
      "hash64": "E86C66DB19AABCDF",
      "text": "Mach dich auf was gefasst, Neuzugang!\\nDas wird ein Kampf der Giganten![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sub_012_chara_03_02",
      "hash64": "E86C67DB19AABE92",
      "text": "Ich geb’s ja nur ungern zu, aber ich habe\\nverloren... Viel Erfolg beim nächsten Kampf![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sub_012_chara_04_01",
      "hash64": "1A117704D2E3CAC4",
      "text": "[VAR 0xBD06(0000)]Oh! Du bist es, [VAR 0x0100(0000)]! Lass uns nach\\neinem\\r\\nfairen,\\r\\nkurzweiligen\\r\\nKampf\\r\\nstreben![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
