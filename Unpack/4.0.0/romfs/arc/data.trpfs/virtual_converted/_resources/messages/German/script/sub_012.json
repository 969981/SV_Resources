            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sub_012_chara_04_02",
      "hash64": "1A117A04D2E3CFDD",
      "text": "Ach, ich hätte zu gerne in meiner Glanzzeit gegen\\ndich gekämpft. Nur weiter so, du schaffst das![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sub_012_chara_05_01",
      "hash64": "EF2663101BEF8699",
      "text": "Ich kann es kaum noch erwarten, das Geheimnis\\ndeines geballten Talents zu entschlüsseln.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sub_012_chara_05_02",
      "hash64": "EF2660101BEF8180",
      "text": "Geschichte wird von den Siegern geschrieben.\\nUnd so tauche ich in die Vergangenheit ab und\\r\\nüberlasse dir den Thron der Zukunft.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sub_012_chara_06_01",
      "hash64": "95F1A2F6D49E6026",
      "text": "„Gute Seele“, echt jetzt? Puh, wie peinlich...!\\nAber sei’s drum. Das wird ein himmlischer Kampf![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sub_012_chara_06_02",
      "hash64": "95F1A1F6D49E5E73",
      "text": "Wenn du dir wehtust, flick ich dich schon wieder\\nzusammen. Gib also weiterhin hundert Prozent![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sub_012_chara_07_01",
      "hash64": "C3ABAEFD377A0DBB",
      "text": "[VAR 0x1100(00FF,1515,0000)]Einen besseren GegnerEine bessere Gegnerin könnte ich mir gar nicht\\nwünschen. Bist du bereit für eine Kostprobe\\r\\nmeines Könnens?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1515",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sub_012_chara_07_02",
      "hash64": "C3ABAFFD377A0F6E",
      "text": "Deine Stärke hat mich auf den Boden der\\nTatsachen zurückgeholt. Du führst den Titel\\r\\neines Champs zurecht![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sub_012_chara_08_01",
      "hash64": "34C79EA363FADA50",
      "text": "Es ist mir eine Ehre, gegen dich zu kämpfen.\\nDeshalb verdienst du auch nicht weniger als\\r\\nmeinen vollen Einsatz![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sub_012_chara_08_02",
      "hash64": "34C7A1A363FADF69",
      "text": "Genau so macht man das! Tu mir einen Gefallen\\nund lass deine Siegessträhne ja nicht abreißen![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
