  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_011_girl_01",
      "hash64": "EB85F4E3122FF757",
      "text": "Alola, friend! I’m a big fan of Pokémon from the\\nAlola region!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_011_girl_02",
      "hash64": "EB85F5E3122FF90A",
      "text": "Do you have an Alolan Golem in your party\\nor Boxes? If so, I’d sure love to see it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_011_girl_03",
      "hash64": "EB85F6E3122FFABD",
      "text": "I just can’t seem to find an Alolan Golem...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_011_girl_04",
      "hash64": "EB85EFE3122FEED8",
      "text": "That...that’s not a Golem at all!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_011_girl_05",
      "hash64": "EB85F0E3122FF08B",
      "text": "That’s a Golem, yes, but...it’s a regular one!\\nWhat I’m looking for is an ALOLAN Golem!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_011_girl_06",
      "hash64": "EB85F1E3122FF23E",
      "text": "Why, that...that’s an Alolan Golem!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_011_girl_07",
      "hash64": "EB85F2E3122FF3F1",
      "text": "Just look at those curious protrusions above its\\nhead! And its handsome eyebrows—its full beard!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_011_girl_08",
      "hash64": "EB85EBE3122FE80C",
      "text": "It evolves when it’s traded, you know. I suppose\\nthat’s why it’s not often found in the wild...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_011_girl_09",
      "hash64": "EB85ECE3122FE9BF",
      "text": "As thanks, let me teach you a pose that’s just\\nperfect to show your love for Alolan Golem!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s2_sub_011_system_01",
      "hash64": "340BF1E47E73D21E",
      "text": "You learned the [VAR 0xFF00(0008)]Electrium Z emote[VAR 0xFF00(0000)] from the girl!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_011_girl_npc",
      "hash64": "392CDFD8F127896B",
      "text": "The hand positions are KEY for the pose I taught\\nyou. And you gotta say “Alola” nice and loud!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
