      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "a_sch_shop01_eve08",
      "hash64": "56B8F2C8C1F12130",
      "text": "Oh là là, ces pains sentent trop bon... !\\nJe peux pas résister, je vais en prendre un !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "a_sch_shop01_eve09",
      "hash64": "56B8F3C8C1F122E3",
      "text": "T’aimes le pain, toi ?\\nMoi, je préfère les boulettes de riz !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
