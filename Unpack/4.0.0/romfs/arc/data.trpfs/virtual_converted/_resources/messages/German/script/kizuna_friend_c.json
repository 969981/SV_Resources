      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_friend_c_06",
      "hash64": "40228342B8BBBFD7",
      "text": "Ich hab zum ersten Mal einen richtigen Blick auf\\ndie Seiten geworfen, die nichts mit den\\r\\nGeheimgewürzen zu tun haben.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
