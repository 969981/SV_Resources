          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_friend_c_07",
      "hash64": "40228242B8BBBE24",
      "text": "Kommt mir zwar alles ziemlich an den Haaren\\nherbeigezogen vor, aber unterhaltsam ist es\\r\\nallemal!\\c\\nUnd dank der vielen Bilder nicht so schnarchig\\nwie andere Bücher...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 170,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_friend_c_08",
      "hash64": "40227942B8BBAED9",
      "text": "Hier, sieh dir mal diese Seite an![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_friend_c_09",
      "hash64": "40227842B8BBAD26",
      "text": "Die Schrift hier ist total verschwommen und\\nman kann kaum was entziffern...\\c\\nUnd jetzt halt dich fest: Genau diese Seite hier\\nist auch in den anderen Exemplaren unlesbar!\\c\\nVoll seltsam, oder?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 172,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 195,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
