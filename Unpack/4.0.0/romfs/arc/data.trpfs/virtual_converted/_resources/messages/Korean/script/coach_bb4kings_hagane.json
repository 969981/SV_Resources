    },
    {
      "ordinal": 3,
      "label": "coach_bb4kings_hagane_sp01_01",
      "hash64": "C99A4A82D0940AE8",
      "text": "...... ......\\n...... ......[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
