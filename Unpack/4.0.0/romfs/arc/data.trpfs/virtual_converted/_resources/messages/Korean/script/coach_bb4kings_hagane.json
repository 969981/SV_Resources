          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_bb4kings_hagane_sp01_02",
      "hash64": "C99A4D82D0941001",
      "text": "아갸아스 님은\\n그 뒤로 괜찮으신가요?[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb4kings_hagane_sp01_select_01",
      "hash64": "C3836108EE7B8717",
      "text": "엄청 멀쩡해요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_bb4kings_hagane_sp01_select_02",
      "hash64": "C3836208EE7B88CA",
      "text": "실컷 날았어요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_bb4kings_hagane_sp01_03",
      "hash64": "C99A4C82D0940E4E",
      "text": "그렇다면 다행이네요.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_bb4kings_hagane_sp01_04",
      "hash64": "C99A4F82D0941367",
      "text": "그렇게나 많은 환약을\\n한꺼번에 드셔서 걱정했습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb4kings_hagane_sp01_05",
      "hash64": "C99A4E82D09411B4",
      "text": "아갸아스 님이 튼튼하신 덕에\\n아무렇지도 않은 거겠죠.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb4kings_hagane_sp01_06",
      "hash64": "C99A5182D09416CD",
      "text": "다른 포켓몬에게 실험하는 건\\n조금 위험할 것 같네요.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb4kings_hagane_sp01_07",
      "hash64": "C99A5082D094151A",
      "text": "참고로, 공중날기 타임어택은 보통\\n무장조를 타고 진행하고 있습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb4kings_hagane_sp01_08",
      "hash64": "C99A4382D093FF03",
      "text": "전해 드릴 말은 이상입니다.\\n대화를 종료하도록 하죠.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb4kings_hagane_sp02_00",
      "hash64": "F484C1778787444C",
      "text": "[VAR 0x0100(0000)]에게 질문이 있습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb4kings_hagane_sp02_01",
      "hash64": "F484C277878745FF",
      "text": "카지와는 어떻게 만나게 되신 거죠?[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb4kings_hagane_sp02_select_01",
      "hash64": "D2A78799FC4F6886",
      "text": "자연 학교에서 만났어요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb4kings_hagane_sp02_select_02",
      "hash64": "D2A78699FC4F66D3",
      "text": "짝을 이뤘어요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_bb4kings_hagane_sp02_02",
      "hash64": "F484C377878747B2",
      "text": "그런 이벤트가 있었군요...\\c\\n확실히, 모습이 바뀌기 전에\\n북신에 다녀왔었네요.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb4kings_hagane_sp02_02b",
      "hash64": "04DFF41B4ADF0670",
      "text": "짜, 짝을 이뤘다...!?\\n...아, 실례했습니다.\\c\\n자연 학교의 과제를\\n2인조로 수행하셨다는 거군요.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb4kings_hagane_sp02_03",
      "hash64": "F484C47787874965",
      "text": "카지가 어째서 [VAR 0x0100(0000)]에 대해\\n그렇게나 격하게 반응하는지...\\r\\n네리네는 그 이유가 궁금했습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb4kings_hagane_sp02_04",
      "hash64": "F484BD7787873D80",
      "text": "...만남에 문제가 있었던 것은\\n아닌 것 같네요.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb4kings_hagane_sp02_05",
      "hash64": "F484BE7787873F33",
      "text": "질문하고 싶은 것은 이상입니다.\\n감사합니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_bb4kings_hagane_sp03_00",
      "hash64": "F12997725EAB7B3D",
      "text": "[VAR 0x0100(0000)]...\\n상담을 드리고 싶은 것이 있습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_bb4kings_hagane_sp03_01",
      "hash64": "F12996725EAB798A",
      "text": "네리네...\\n요즘 이상함을 느낍니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_bb4kings_hagane_sp03_02",
      "hash64": "F12995725EAB77D7",
      "text": "가끔씩 가슴이 답답하고\\n식욕도 부진합니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb4kings_hagane_sp03_03",
      "hash64": "F12994725EAB7624",
      "text": "보건실에서 진찰을 받아도\\n아무런 이상이 없다고 하고...[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb4kings_hagane_sp03_04",
      "hash64": "F12993725EAB7471",
      "text": "네리네의 몸에\\n뭔가가 일어나려는 걸까요?[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb4kings_hagane_sp03_select_01",
      "hash64": "56E9BF2FE7EA6109",
      "text": "짐작 가는 건 없어요?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_hagane_sp03_select_02",
      "hash64": "56E9BC2FE7EA5BF0",
      "text": "어떨 때 그러는데요?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_hagane_sp03_05",
      "hash64": "F12992725EAB72BE",
      "text": "짐작 가는 건 전혀 없습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_bb4kings_hagane_sp03_05b",
      "hash64": "7516B456DD542BD4",
      "text": "규칙성은 전혀 없습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_bb4kings_hagane_sp03_06",
      "hash64": "F12991725EAB710B",
      "text": "굳이 말하자면...\\n카지에 대해 생각할 때마다\\r\\n증상이 발생하는 것 같은데...[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_bb4kings_hagane_sp03_07",
      "hash64": "F12990725EAB6F58",
      "text": "인과 관계는\\n전혀 없을 거라 생각하고 있습니다.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_bb4kings_hagane_sp03_08",
      "hash64": "F1298F725EAB6DA5",
      "text": "...휴.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
