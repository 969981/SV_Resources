    },
    {
      "ordinal": 1,
      "label": "coach_gym_mizu_first_01",
      "hash64": "7E7F64259EA67512",
      "text": "Wer hat den alten Kombu, den Koch, der hohe\\nWellen schlägt, herbestellt?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_gym_mizu_sp01_00",
      "hash64": "333148F874699013",
      "text": "Mein lieber Scholli! Dich kenn ich doch![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_mizu_sp01_01",
      "hash64": "333147F874698E60",
      "text": "Stimmt es, dass du Mentoren einladen darfst,\\nobwohl du selbst noch [VAR 0x1100(00FF,0907,0000)]SchülerSchülerin bist?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0907",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_mizu_sp01_02",
      "hash64": "33314AF874699379",
      "text": "Du bist wirklich ein außergewöhnliches Kind![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_mizu_sp01_select_01",
      "hash64": "6CA96FE2386E07BF",
      "text": "Ja, das bin ich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_gym_mizu_sp01_select_02",
      "hash64": "6CA970E2386E0972",
      "text": "Das ist übertrieben...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_gym_mizu_sp01_03",
      "hash64": "333149F8746991C6",
      "text": "Bwahaha! Selbstbewusstsein hast du auch noch!\\nWas für ein toller Fang du doch bist![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_gym_mizu_sp01_03b",
      "hash64": "6652552DCF6279AC",
      "text": "Bwahaha! Bloß keine falsche Bescheidenheit!\\nDu solltest zu deinen tollen Leistungen stehen![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_gym_mizu_sp01_04",
      "hash64": "33314CF8746996DF",
      "text": "Ich danke dir von Herzen, dass du mir die\\nGelegenheit zu diesem Ausflug gegeben hast![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_mizu_sp01_05",
      "hash64": "33314BF87469952C",
      "text": "Auch ein alter Mann wie ich kann hier noch was\\nlernen, genau wie ihr Schüler![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_mizu_sp02_00",
      "hash64": "5DAF5EED2B0105C4",
      "text": "Dieser Ort ist von einer malerischen\\nMeereslandschaft umgeben.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_mizu_sp02_01",
      "hash64": "5DAF5FED2B010777",
      "text": "Bei dieser herrlichen Meeresbrise sind sowohl ich\\nals auch meine Pokémon bester Laune![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_mizu_sp02_02",
      "hash64": "5DAF60ED2B01092A",
      "text": "Aber auf der Speisekarte der hiesigen Mensa\\nstehen gar keine Meeresfrüchte...[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_mizu_sp02_03",
      "hash64": "5DAF61ED2B010ADD",
      "text": "Sich täglich den Bauch mit frischen Köstlichkeiten\\naus dem Meer vollschlagen...\\r\\nWäre das für die Schüler nicht der Kracher?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_gym_mizu_sp02_select_01",
      "hash64": "DCDC33941635FF0E",
      "text": "Das wäre super!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_gym_mizu_sp02_select_02",
      "hash64": "DCDC32941635FD5B",
      "text": "Ich weiß ja nicht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_gym_mizu_sp02_04",
      "hash64": "5DAF5AED2B00FEF8",
      "text": "Du ziehst mit mir an einem Strang, großartig!\\nWart nur ab, was der alte Kombu alles erreicht![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_mizu_sp02_04b",
      "hash64": "31F61B0012B09FAE",
      "text": "Wo wir uns schon mitten im Meer befinden,\\nsollten wir das doch auch kulinarisch ausnutzen,\\r\\nmeinst du nicht?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_mizu_sp02_05",
      "hash64": "5DAF5BED2B0100AB",
      "text": "Wartet ab, liebe Schüler! Das Gewässer wird zur\\nKantine! Kombus Edelkombüse steht zu Diensten![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_mizu_sp03_00",
      "hash64": "060394E58E8282B5",
      "text": "Hallöchen! Ich habe wunderbare Neuigkeiten![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_mizu_sp03_01",
      "hash64": "060393E58E828102",
      "text": "Die Mensa der Blaubeer-Akademie und Kombus\\nEdelkombüse gehen eine Kooperation ein![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_mizu_sp03_select_01",
      "hash64": "B93707623A53FE51",
      "text": "Das klingt toll!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_gym_mizu_sp03_select_02",
      "hash64": "B93704623A53F938",
      "text": "Ich freu mich drauf!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "coach_gym_mizu_sp03_02",
      "hash64": "060392E58E827F4F",
      "text": "Da die Sache gerade erst beschlossen wurde,\\nwird es noch eine Weile dauern, bis wir offiziell\\r\\nden Betrieb aufnehmen.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_gym_mizu_sp03_03",
      "hash64": "060391E58E827D9C",
      "text": "Zuerst muss ich noch meinen berühmten Eintopf\\nder Kostbarkeiten überarbeiten und an die\\r\\nGaumen der hiesigen Schüler anpassen.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_mizu_sp03_04",
      "hash64": "060390E58E827BE9",
      "text": "Selbstverständlich möchte ich, dass Kinder in\\nihrer Wachstumsphase möglichst gut essen![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_mizu_sp03_05",
      "hash64": "06038FE58E827A36",
      "text": "Auf diese Weise werde ich ihnen auch wertvolles\\nWissen rund um Ernährung vermitteln.[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_mizu_trade_01_00",
      "hash64": "DE6D182A49C40B17",
      "text": "Dank deiner Einladung an diese Akademie\\nkann auch ich mein eigenes Wissen erweitern.\\c\\nEin volles Netz an tollen Erfahrungen![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_mizu_trade_01_01",
      "hash64": "DE6D172A49C40964",
      "text": "Bwahaha! Dafür bin ich dir wirklich dankbar![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_mizu_trade_01_02",
      "hash64": "DE6D1A2A49C40E7D",
      "text": "Wie wär’s, wenn wir als Trainer dem natürlichen\\nFluss der Dinge folgen und Pokémon tauschen?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_mizu_trade_01_03",
      "hash64": "DE6D192A49C40CCA",
      "text": "Ich würde dir mein Agiluza überlassen!\\nWie sieht es mit dir aus?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_mizu_trade_01_04",
      "hash64": "DE6D142A49C4044B",
      "text": "[VAR 0xBD06(0000)][VAR 0x0101(0001)] sprüht ja nur so vor Energie!\\nWas\\r\\nfür\\r\\nein\\r\\nFang!\\c\\nIch werde mich liebevoll um diesen Goldschatz\\nkümmern![VAR 0x0114(0018)]",
