          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sub_002_trainer_02",
      "hash64": "622B0FC782F1C851",
      "text": "Dovrei imparare da te e mettere anima e corpo\\nper sconfiggere Tulipa anch’io![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_002_trainer_03",
      "hash64": "622B0EC782F1C69E",
      "text": "Osu! Vogliamo allenarci insieme con l’Esercizio\\ndelle emozioni?[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_002_trainer_04",
      "hash64": "622B11C782F1CBB7",
      "text": "Che tipo di allenamento ti va di fare?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_002_trainer_05",
      "hash64": "622B10C782F1CA04",
      "text": "Che livello di allenamento avevi in mente?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sub_002_trainer_06",
      "hash64": "622B13C782F1CF1D",
      "text": "Va bene, vada per un esercizio leggero, allora.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_002_trainer_07",
      "hash64": "622B12C782F1CD6A",
      "text": "Ok! Andiamo con un esercizio medio, allora![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_002_trainer_08",
      "hash64": "622B05C782F1B753",
      "text": "Ottimo! Diamoci da fare con un esercizio intenso![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_002_trainer_09",
      "hash64": "622B04C782F1B5A0",
      "text": "Ci sto! Iniziamo allora un bell’allenamento\\ndi fuoco![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_002_trainer_10",
      "hash64": "622787C782EEAB62",
      "text": "È la prima volta che provi l’esercizio\\na eliminazione, no?\\c\\nAl primo errore, l’allenamento terminerà...\\nPerciò cerca di restare concentrat[VAR 0x1100(00FF,0101)]oa![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
