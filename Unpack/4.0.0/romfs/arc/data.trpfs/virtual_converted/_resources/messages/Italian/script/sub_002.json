    {
      "ordinal": 0,
      "label": "sub_002_trainer_01",
      "hash64": "622B0CC782F1C338",
      "text": "Ehi, novellin[VAR 0x1100(00FF,0101)]oa! Ho sentito che hai vinto contro\\nTulipa, complimenti per la medaglia!\\c\\nVisto che è sempre stata brava in tutto,\\nuna sconfitta ogni tanto le fa solo bene![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
