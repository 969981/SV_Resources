        }
      ]
    },
    {
      "ordinal": 5,
      "label": "a_sch_office03_ni01",
      "hash64": "5CB3DF5C0B29144A",
      "text": "Les élèves ont surnommé madame Mimosa\\n« Mimi ».\\c\\nQuand j’ai essayé de l’appeler comme ça, moi,\\nelle m’a regardé d’un drôle d’air...",
      "flags": 0,
