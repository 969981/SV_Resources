    },
    {
      "ordinal": 4,
      "label": "a_sch_office03_eve07",
      "hash64": "8F5DA8DBF9785677",
      "text": "Quand ça va pas trop en cours, j’aime bien venir\\nici pour me reposer un peu.\\c\\nMadame Mimosa est vraiment trop gentille,\\nelle me pose jamais de question.",
      "flags": 0,
      "text_status": "DECODED",
