          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_health_b_08",
      "hash64": "D8FBB579A04933BA",
      "text": "Io invece...[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
