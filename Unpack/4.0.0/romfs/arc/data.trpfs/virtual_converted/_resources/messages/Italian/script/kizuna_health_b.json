      "ordinal": 11,
      "label": "kizuna_health_b_11",
      "hash64": "D8FF3279A04C3DF8",
      "text": "Non sono mai riuscita a passare l’esame per\\ndiventare docente...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
