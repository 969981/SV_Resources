    {
      "ordinal": 6,
      "label": "kizuna_health_b_06",
      "hash64": "D8FBA779A0491BF0",
      "text": "Ma dai, sul serio? Affascinante![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
