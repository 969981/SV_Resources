            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "legend_0090_friend_02",
      "hash64": "B872D5F0CBF54408",
      "text": "這裡就是那傢伙的研究所……\\n小時候我常常到這裡來玩。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "legend_0090_friend_03",
      "hash64": "B872D6F0CBF545BB",
      "text": "那傢伙把我們叫來這裡，\\n到底有什麼事？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "legend_0090_friend_04",
      "hash64": "B872DBF0CBF54E3A",
      "text": "我現在就去開門……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "legend_0090_friend_05",
      "hash64": "B872DCF0CBF54FED",
      "text": "……大家口中的天才般的寶可夢博士。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "legend_0090_friend_06a",
      "hash64": "6073092A91CDF18F",
      "text": "……說的就是我媽。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "legend_0090_friend_06b",
      "hash64": "60730A2A91CDF342",
      "text": "……說的就是我爸。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "legend_0090_friend_07",
      "hash64": "B872DAF0CBF54C87",
      "text": "但對身為小孩的我來說，\\n實在糟透了。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "legend_0090_friend_08",
      "hash64": "B872CFF0CBF539D6",
      "text": "[VAR 0x1107(00FF,0101)]她他總是滿腦子都是工作，\\n根本就不會回家來。\\r\\n我也沒有任何[VAR 0x1107(00FF,0101)]她他陪我玩的記憶。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
