      ]
    },
    {
      "ordinal": 9,
      "label": "legend_0090_friend_09",
      "hash64": "B872D0F0CBF53B89",
      "text": "只有獒教父\\n牠總是陪在我的身邊。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
