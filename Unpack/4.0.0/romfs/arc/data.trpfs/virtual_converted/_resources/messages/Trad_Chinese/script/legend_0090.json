          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "legend_0090_friend_10",
      "hash64": "B8765DF0CBF860F7",
      "text": "打開了……我們進去吧。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
