      "ordinal": 11,
      "label": "legend_0090_friend_11",
      "hash64": "B8765CF0CBF85F44",
      "text": "就讓我們速戰速決。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
