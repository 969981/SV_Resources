      "ordinal": 0,
      "label": "legend_0090_friend_01",
      "hash64": "B872D8F0CBF54921",
      "text": "可惡，我竟然比[VAR 0x1100(00FF,0101)]你妳晚到！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
