  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_017_man_01",
      "hash64": "C22C7AA9C24788E6",
      "text": "Yo, mon vieux.\\n[VAR 0x1101(00FD,1814)]Il a l’air fort, tonY z’ont l’air forts, tes Pokémon.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "1814"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_017_man_02",
      "hash64": "C22C79A9C2478733",
      "text": "Yo, ma vieille.\\n[VAR 0x1101(00FD,1814)]Il a l’air fort, tonY z’ont l’air forts, tes Pokémon.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "1814"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_017_man_03",
      "hash64": "C22C78A9C2478580",
      "text": "P’têt’ même assez pour vaincre\\nle clan des Visages du Monstre.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_017_select_01",
      "hash64": "F6C6711E164DEA1A",
      "text": "Le clan des Visages du Monstre ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_017_select_02",
      "hash64": "F6C6701E164DE867",
      "text": "Qui ça ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s1_sub_017_man_04",
      "hash64": "C22C7FA9C2479165",
      "text": "C’est une bande de Dresseurs et de Dresseuses\\nhyper balèzes qui portent des masques à l’effigie\\r\\ndu Monstre. Y zonent souvent hors du village.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_017_man_05",
      "hash64": "C22C7EA9C2478FB2",
      "text": "Leur dada, c’est les combats Pokémon, surtout\\ncontre des adversaires bien costauds.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_017_man_06",
      "hash64": "C22C7DA9C2478DFF",
      "text": "À c’qui paraît, le clan est composé de sept\\nmembres.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s1_sub_017_man_07",
      "hash64": "C22C7CA9C2478C4C",
      "text": "Si tu veux les affronter, j’te conseille d’y réfléchir\\nà deux fois. C’est pas l’genre à faire dans\\r\\nla dentelle, si tu vois c’que j’veux dire.\\c\\nMais pour chaque membre que tu vaincras,\\nj’te donnerai un truc qui claque, d’accord ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_017_man_08",
      "hash64": "C22C83A9C2479831",
      "text": "Y paraît qu’t’as réussi à battre un des Visages\\ndu Monstre. Comme promis, prends ça.\\r\\nTu devrais kiffer !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_017_man_09",
      "hash64": "C22C82A9C247967E",
      "text": "Y paraît qu’t’as réussi à battre plusieurs Visages\\ndu Monstre. Comme promis, prends tout ça.\\r\\nTu devrais kiffer !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_017_man_10",
      "hash64": "C22975A9C2454A90",
      "text": "Y t’reste une personne du clan à vaincre...\\nTu veux un indice pour la trouver ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s1_sub_017_man_11",
      "hash64": "C22976A9C2454C43",
      "text": "Y t’reste [VAR 0x0200(0001)] membre[VAR 0x1101(0001,0100)]s du clan à vaincre...\\nTu veux un indice pour en trouver un ?",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_017_hint_01",
      "hash64": "36833974D91DF465",
      "text": "« Suis le chemin bleu depuis le Mont Strueux.\\nTu me trouveras dans un bosquet de bambous. »",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s1_sub_017_hint_02",
      "hash64": "36833674D91DEF4C",
      "text": "« À l’endroit où tu me trouveras, une corne\\nmonstrueuse est visible au loin. »",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "s1_sub_017_hint_03",
      "hash64": "36833774D91DF0FF",
      "text": "« Tu me trouveras dans une brèche, près du lieu\\noù de l’eau s’écoule de la bouche du Monstre. »",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s1_sub_017_hint_04",
      "hash64": "36833474D91DEBE6",
      "text": "« Tu me trouveras au bord de l’étang, là où\\nil faut choisir entre l’infernal et la quiétude. »",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s1_sub_017_hint_05",
      "hash64": "36833574D91DED99",
      "text": "« Tu me trouveras dans une friche où se dressent\\ndes monolithes, là où la souffrance n’existe pas. »",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "s1_sub_017_hint_06",
      "hash64": "36833274D91DE880",
      "text": "« Tu me trouveras perché sur la corne\\nla plus courte du Monstre. »",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s1_sub_017_hint_07",
      "hash64": "36833374D91DEA33",
      "text": "« Tu me trouveras en chutant dans une cavité\\nà proximité du lac qui ne connaît pas la nuit. »",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "s1_sub_017_man_12",
      "hash64": "C22977A9C2454DF6",
      "text": "On dirait qu’t’as réussi... T’as vaincu tous\\nles membres du clan des Visages du Monstre.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "s1_sub_017_man_13",
      "hash64": "C22978A9C2454FA9",
      "text": "Maintenant, j’peux t’montrer ma véritable force...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "s1_sub_017_man_14",
      "hash64": "C22979A9C245515C",
      "text": "Ta-da !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "s1_sub_017_man_15",
      "hash64": "C2297AA9C245530F",
      "text": "Membre caché des Visages du Monstre, telle\\nest mon identité. Ma puissance est inégalée...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "s1_sub_017_man_16",
      "hash64": "C2297BA9C24554C2",
      "text": "L’heure du dernier combat a sonné.\\nViens à moi quand tu seras prêt[VAR 0x1100(00FF,0100)]e à m’affronter.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_017_man_17",
      "hash64": "C2297CA9C2455675",
      "text": "Es-tu fin prêt[VAR 0x1100(00FF,0100)]e pour ce dernier combat ?\\nTon adversaire, ce sera moi.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_sub_017_man_18",
      "hash64": "C2297DA9C2455828",
      "text": "... Reviens me voir lorsque cela sera le cas.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "s1_sub_017_man_30",
      "hash64": "C23001A9C24AA422",
      "text": "Vers un endroit plus idoine, faisons quelques pas.\\nSans attendre, suis-moi.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "s1_sub_017_man_19",
      "hash64": "C2297EA9C24559DB",
      "text": "Mon nom est Muramasa. Du clan des Visages\\ndu Monstre, secrètement, je suis le membre.\\c\\nEn garde ! Je vais te pourfendre !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s1_sub_017_man_20",
      "hash64": "C23387A9C24DBDAB",
      "text": "Ha ha ha ! Tu es parvenu[VAR 0x1100(00FF,0100)]e à triompher de moi !\\nQue l’on célèbre ton exploit !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s1_sub_017_man_21",
      "hash64": "C23386A9C24DBBF8",
      "text": "...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "s1_sub_017_man_22",
      "hash64": "C23389A9C24DC111",
      "text": "... J’t’ai bien eu[VAR 0x1100(00FF,0100)]e, à causer comme ça, hein !\\nBien ouèj, en tout cas !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "s1_sub_017_man_23",
      "hash64": "C23388A9C24DBF5E",
      "text": "Au nom des Visages du Monstre, j’te remercie\\nd’avoir participé à notre évènement spécial !\\c\\nOn a organisé ça pour qu’les mômes fassent\\ndu sport et qu’y voient qu’les combats Pokémon,\\r\\nc’est sympa !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 184,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s1_sub_017_man_24",
      "hash64": "C2338BA9C24DC477",
      "text": "On fait ça tous les ans pendant la période\\nde la Fête des Visages, mais...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "s1_sub_017_man_25",
      "hash64": "C2338AA9C24DC2C4",
      "text": "L’équipe a tendance à s’prendre un peu trop au\\njeu, avec les rimes et tout... Et du coup, y a pas\\r\\nbeaucoup d’enfants qui arrivent jusqu’au bout.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "s1_sub_017_man_26",
      "hash64": "C2338DA9C24DC7DD",
      "text": "J’crois qu’t’es l[VAR 0x1100(00FF,0101)]ea premi[VAR 0x1100(00FF,0302)]erère à m’battre, d’ailleurs !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "s1_sub_017_man_27",
      "hash64": "C2338CA9C24DC62A",
      "text": "Du coup, bah, félicitations !\\nComme promis, voilà ton prix !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "s1_sub_017_man_28",
      "hash64": "C2337FA9C24DB013",
      "text": "Avec sa nature luxuriante, Septentria est l’endroit\\nidéal pour développer ses capacités.\\r\\nFaut en profiter !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "s1_sub_017_man_29",
      "hash64": "C2337EA9C24DAE60",
      "text": "Te revoici, redoutable enfant !\\nEs-tu venu[VAR 0x1100(00FF,0100)]e me saluer poliment ?\\r\\nComme c’est plaisant !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    }
  ]
}
