            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_bb_brother_sp03_select_01",
      "hash64": "92E18DBC67B6A80F",
      "text": "Mais pourquoi ?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_bb_brother_sp03_select_02",
      "hash64": "92E18EBC67B6A9C2",
      "text": "Tu en as eu marre ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "coach_bb_brother_sp03_01",
      "hash64": "50B90C7098D3DAF0",
      "text": "C’est ni de ta faute ni de celle de la Ligue...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb_brother_sp03_02",
      "hash64": "50B90F7098D3E009",
      "text": "J’ai juste réalisé que... à force de vouloir devenir\\naussi fort que toi, j’ai oublié d’prendre du plaisir\\r\\nà faire des combats. Alors que c’est la base.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 105,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 154,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb_brother_sp03_03",
      "hash64": "50B90E7098D3DE56",
      "text": "J’pense que j’ai besoin d’faire une pause\\npour me retrouver un peu.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb_brother_sp03_04",
      "hash64": "50B9117098D3E36F",
      "text": "J’voudrais retrouver des relations plus saines\\net sincères avec mes amis et mes Pokémon.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_bb_brother_sp03_select_03",
      "hash64": "92E18FBC67B6AB75",
      "text": "C’est une raison formidable !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_bb_brother_sp03_select_04",
      "hash64": "92E188BC67B69F90",
      "text": "Je te soutiens à fond !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "coach_bb_brother_sp03_05",
      "hash64": "50B9107098D3E1BC",
      "text": "Hé hé ! Merci ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_bb_brother_sp03_06",
      "hash64": "50B9137098D3E6D5",
      "text": "En plus, c’est cool, parce que le Conseil 4 va\\npouvoir rester comme il est. C’qui est rassurant\\r\\npour Rubépin, qui pourra garder sa place.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_bb_brother_sp03_07",
      "hash64": "50B9127098D3E522",
      "text": "Mais ça veut pas dire qu’tu peux baisser\\nta garde, [VAR 0x0100(0000)] ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_bb_brother_sp03_08",
      "hash64": "50B9157098D3EA3B",
      "text": "J’viendrai récupérer le titre de Maître\\ndès qu’j’aurai réglé mes problèmes perso,\\r\\ndonc tiens-toi prêt[VAR 0x1100(00FF,0100)]e ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_bb_brother_sp03_select_05",
