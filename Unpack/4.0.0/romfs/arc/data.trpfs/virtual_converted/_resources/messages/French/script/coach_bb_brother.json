          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb_brother_sp01_03",
      "hash64": "CD0656629AEB752C",
      "text": "Faut dire... j’ai vraiment fait n’importe quoi.\\nJ’me suis excusé auprès de tout le monde,\\r\\nmais bon...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_bb_brother_sp01_select_01",
      "hash64": "7B95975FE6DF1221",
      "text": "Tant mieux !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_bb_brother_sp01_select_02",
      "hash64": "7B95945FE6DF0D08",
      "text": "Tout est bien qui finit bien !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_bb_brother_sp01_04",
      "hash64": "CD0655629AEB7379",
      "text": "Oui, vraiment ! Encore merci pour tout c’que\\nt’as fait, [VAR 0x0100(0000)] ![VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb_brother_sp01_04b",
      "hash64": "4D36318D3E1496E1",
      "text": "Mouais... Il va sûrement falloir un peu de temps\\npour que tout l’monde me pardonne réellement...\\c\\nMais... oui... j’vais continuer de tout faire pour\\nque ça s’passe bien...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 173,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb_brother_sp01_05",
      "hash64": "CD0654629AEB71C6",
      "text": "Faudra aussi rattraper les cours que j’ai ratés\\nquand on était à Jaderaude... J’vais tout donner ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb_brother_sp02_00",
      "hash64": "2781177BE3515FF2",
      "text": "C’était vraiment cool de vous avoir à Septentria,\\ntoi et tes potes ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb_brother_sp02_01",
      "hash64": "2781187BE35161A5",
      "text": "Avant votre arrivée, j’passais mon temps à me\\nmorfondre. J’pensais à tout l’mal que j’avais fait.\\r\\nFranchement, j’étais au fond du trou.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb_brother_sp02_02",
      "hash64": "2781157BE3515C8C",
      "text": "Mais ça m’a fait beaucoup d’bien de passer\\ndu temps avec vous.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb_brother_sp02_03",
      "hash64": "2781167BE3515E3F",
      "text": "Même si c’était un peu plus mouvementé\\nque prévu...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb_brother_sp02_select_03",
      "hash64": "A9DD7FFF7C8F6BAA",
      "text": "Oui, pauvre Roseille...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb_brother_sp02_select_04",
      "hash64": "A9DD7AFF7C8F632B",
      "text": "Tout le village « kibi kibifié »...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_bb_brother_sp02_05",
      "hash64": "2781147BE3515AD9",
      "text": "C’est clair... Par contre, j’crois qu’elle a honte de\\ntout ça, donc évite d’y faire allusion devant elle...\\r\\nsi tu veux pas la mettre en rogne ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 107,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb_brother_sp02_05b",
      "hash64": "71B08983433D2BC1",
      "text": "Ouais, c’était dingue ! On en rit maintenant,\\nmais sur le coup, j’ai eu grave peur ![VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb_brother_sp02_06",
      "hash64": "2781117BE35155C0",
      "text": "Au fait... après beaucoup d’hésitations... j’ai pris\\nune décision.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb_brother_sp02_07",
      "hash64": "2781127BE3515773",
      "text": "J’suis pas encore prêt à en parler, mais...\\nquand j’le serai, tu seras l[VAR 0x1100(00FF,0101)]ea premi[VAR 0x1100(00FF,0302)]erère à le savoir ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 85,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302"
          ]
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb_brother_sp03_00",
      "hash64": "50B90D7098D3DCA3",
      "text": "[VAR 0x0100(0000)] ! Faut que j’te parle d’un truc !\\c\\nJ’ai décidé... de quitter la Ligue Myrtille !\\nPour de bon ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
