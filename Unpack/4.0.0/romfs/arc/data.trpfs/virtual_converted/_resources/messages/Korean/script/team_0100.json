      ]
    },
    {
      "ordinal": 2,
      "label": "team_0100_cassiopeia_02",
      "hash64": "BB40B0EA9F220063",
      "text": "그 앞에 마지막 팀이 있다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
