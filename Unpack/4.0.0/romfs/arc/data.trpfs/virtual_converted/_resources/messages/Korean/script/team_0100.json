          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "team_0100_cassiopeia_03",
      "hash64": "BB40AFEA9F21FEB0",
      "text": "지금까지 잘 싸워 줬다.\\n[VAR 0x0100(0000)], 고맙다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
