    },
    {
      "ordinal": 4,
      "label": "team_0100_nelke_01",
      "hash64": "04928F82C7D56768",
      "text": "[VAR 0x0100(0000)]!\\n카시오페아![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
