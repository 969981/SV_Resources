      "label": "team_0100_nelke_01",
      "hash64": "04928F82C7D56768",
      "text": "[VAR 0x0100(0000)]! Cassiopeia![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
