    {
      "ordinal": 27,
      "label": "sub_006_trainer_25",
      "hash64": "B98B476E5772C79E",
      "text": "Vous avez maintenant accès à la plus difficile\\ndes trois pistes, la piste Glaciation !\\c\\nVous avez intérêt à bien vous préparer, si vous\\nvoulez essayer de la descendre !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
