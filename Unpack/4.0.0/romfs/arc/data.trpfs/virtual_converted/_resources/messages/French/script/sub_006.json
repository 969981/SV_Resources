      ]
    },
    {
      "ordinal": 29,
      "label": "sub_006_trainer_21",
      "hash64": "B98B4B6E5772CE6A",
      "text": "Vous avez réussi à améliorer votre temps,\\nfélicitations !\\c\\nRien d’étonnant, vu que vous glissez comme\\nun[VAR 0x1100(00FF,0100)]e pro. Voilà votre récompense !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
