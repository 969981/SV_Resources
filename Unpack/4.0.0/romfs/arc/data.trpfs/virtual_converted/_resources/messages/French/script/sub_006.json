          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sub_006_trainer_20",
      "hash64": "B98B4C6E5772D01D",
      "text": "Bravo, vous avez terminé la piste Glaciation pour\\nla première fois ! Vous êtes l[VAR 0x1100(00FF,0705)]e roia reine de la glisse !\\c\\nVoilà votre récompense !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0705"
