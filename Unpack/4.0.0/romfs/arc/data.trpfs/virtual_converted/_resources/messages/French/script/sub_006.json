          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_006_trainer_03",
      "hash64": "B992396E5778CE82",
      "text": "Est-ce que vous voulez faire un peu de glisse ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_006_trainer_04",
      "hash64": "B992346E5778C603",
      "text": "Quelle piste voulez-vous dévaler ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_006_trainer_05",
      "hash64": "B992336E5778C450",
      "text": "La piste Poudreuse ?\\nParfait, « à la cool », alors ! Bonne glisse !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_006_trainer_06",
      "hash64": "B992366E5778C969",
      "text": "La piste Blizzard ?\\nParfait, mais soyez prudent[VAR 0x1100(00FF,0100)]e, tout de même !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_006_trainer_07",
      "hash64": "B992356E5778C7B6",
      "text": "La piste Glaciation ? Je vois que vous n’avez peur\\nde rien ! J’espère que vous êtes bien entraîné[VAR 0x1100(00FF,0100)]e !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_006_trainer_08",
      "hash64": "B992406E5778DA67",
      "text": "Tout ce que vous avez à faire, c’est vous lancer\\navec votre Poké Monture sur la belle neige bien\\r\\nfraîche du Mont Nappé !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_006_trainer_09",
      "hash64": "B9923F6E5778D8B4",
      "text": "Vous avez le choix entre trois pistes différentes !\\c\\nEt si vous arrivez à les dévaler dans le temps\\nimparti, vous aurez droit à une récompense.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_006_trainer_10",
      "hash64": "B98EB26E5775B346",
      "text": "Alors profitez bien de la neige et donnez-vous\\nà fond pour pulvériser vos propres records !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_006_trainer_11",
      "hash64": "B98EB36E5775B4F9",
      "text": "Vous voulez connaître vos meilleurs temps ?\\nVoyons voir...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
