    {
      "ordinal": 7,
      "label": "s2_sub_002_follower_19",
      "hash64": "B86109DEF1726212",
      "text": "The super-hard course it is! I hope you’re ready\\nfor a challenge!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_002_follower_08",
      "hash64": "B85D84DEF16F4A3C",
      "text": "In this game, you’ll ride a flying Pokémon through\\nan aerial course we’ve set up around the dome.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s2_sub_002_follower_09",
      "hash64": "B85D85DEF16F4BEF",
      "text": "If you make it to the goal within the time limit,\\nthen you pass.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
