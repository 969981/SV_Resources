    {
      "ordinal": 0,
      "label": "kizuna_home_b_01",
      "hash64": "7074FF3D9FB33172",
      "text": "好久不见啊，\\n１－Ａ班的[VAR 0x0100(0000)]。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
