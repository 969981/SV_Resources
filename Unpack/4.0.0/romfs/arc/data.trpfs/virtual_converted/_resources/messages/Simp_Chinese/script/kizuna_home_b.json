          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_home_b_02",
      "hash64": "7074FE3D9FB32FBF",
      "text": "你也是来吃饭的吗？[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_home_b_select_01",
      "hash64": "41E2A3C4A8BB79C1",
      "text": "我来吃饭",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_home_b_select_02",
      "hash64": "41E2A0C4A8BB74A8",
      "text": "我在闲逛",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_home_b_03a",
      "hash64": "C9F8BCB65D77E337",
      "text": "嗯，多吃点，\\n好好长身体就对了。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_home_b_03b",
      "hash64": "C9F8BDB65D77E4EA",
      "text": "你是被好闻的味道\\n吸引过来的吧。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_home_b_04",
      "hash64": "7074FC3D9FB32C59",
      "text": "吾辈算是来学生食堂……\\n视察的吧。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_home_b_05",
      "hash64": "7074FB3D9FB32AA6",
      "text": "确认一下学生们\\n平时吃的营养元素。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_home_b_06",
      "hash64": "7074FA3D9FB328F3",
      "text": "食堂的菜品当中，\\n吾辈比较在意的是\\r\\n香甜美味的花生酱三明治。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_home_b_07",
      "hash64": "7074F93D9FB32740",
      "text": "那么让吾辈来\\n点一个吧……[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_home_b_mob_01",
      "hash64": "72BB0B4A3B889909",
      "text": "啊，是萨瓦罗老师！\\n他好有风度啊，太帅了～",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "kizuna_home_b_mob_02",
      "hash64": "72BB084A3B8893F0",
      "text": "原来老师也会来食堂呀，\\n他会选蛋三明治吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_home_b_mob_03",
      "hash64": "72BB094A3B8895A3",
      "text": "不会吧～萨瓦罗老师的话，\\n绝对会选辣辣～的成熟滋味三明治！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_home_b_mob_04",
      "hash64": "72BB0E4A3B889E22",
      "text": "对哦～酷酷的感觉～！\\n一定是成熟滋味三明治才对～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "kizuna_home_b_08",
      "hash64": "7075083D9FB340BD",
      "text": "…………[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_home_b_09",
      "hash64": "7075073D9FB33F0A",
      "text": "……可以给吾辈一个\\n成熟滋味三明治吗？[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_home_b_select_03",
      "hash64": "41E2A1C4A8BB765B",
      "text": "老师！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_home_b_select_04",
      "hash64": "41E2A6C4A8BB7EDA",
      "text": "花生酱三明治！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_home_b_10",
      "hash64": "7071FA3D9FB0F31C",
      "text": "啊，哦哦，[VAR 0x0100(0000)]你\\n推荐花生酱三明治吗？\\r\\n那吾辈还是来一个你推荐的吧。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_home_b_11",
      "hash64": "7071FB3D9FB0F4CF",
      "text": "差点就下意识地点了\\n自己不擅长的辣味……[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_home_b_12",
      "hash64": "7071FC3D9FB0F682",
      "text": "[VAR 0x0100(0000)]，\\n感谢你阻止吾辈。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_home_b_13",
      "hash64": "7071FD3D9FB0F835",
      "text": "吾辈似乎总是容易被人夸赞\\n有风度啊，身材好啊，\\r\\n酷酷的啊，成熟啊什么的。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_home_b_14",
      "hash64": "7071F63D9FB0EC50",
      "text": "为了不破坏别人对吾辈的幻想，\\n其实吾辈有时会刻意表演。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_home_b_15",
      "hash64": "7071F73D9FB0EE03",
      "text": "好像不知不觉中\\n让你看到了吾辈的本性啊……\\r\\n你可要好好保密哦。[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_home_b_system_01",
      "hash64": "1F8785FE16DAD786",
      "text": "与萨瓦罗老师的关系\\n又变好了一些！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
