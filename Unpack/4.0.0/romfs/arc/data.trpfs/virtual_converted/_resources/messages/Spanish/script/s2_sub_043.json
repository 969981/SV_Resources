  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_043_student_f_01",
      "hash64": "4B26BF5C7600182C",
      "text": "¿Sabías que con las Ramas de Galanuez se\\npueden hacer unos complementos muy cuquis?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_043_student_f_02",
      "hash64": "4B26C25C76001D45",
      "text": "Si me das Ramas de Galanuez, trenzaré para ti\\nun brazal o una corona preciosos.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s2_sub_043_select_01",
      "hash64": "DF5476E50DC8F73E",
      "text": "Quiero un Brazal Galanuez",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_043_select_02",
      "hash64": "DF5475E50DC8F58B",
      "text": "Quiero una Corona Galanuez",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_043_select_03",
      "hash64": "DF5474E50DC8F3D8",
      "text": "En otra ocasión",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_043_student_f_03",
      "hash64": "4B26C15C76001B92",
      "text": "¿Ahora no quieres? Pues nada, otra vez será.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_043_student_f_04",
      "hash64": "4B26BC5C76001313",
      "text": "Para trenzarte un brazal necesito que me des\\n8 Ramas de Galanuez. ¿Te parece bien?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_043_student_f_05",
      "hash64": "4B26BB5C76001160",
      "text": "Para trenzarte una corona necesito que me des\\n15 Ramas de Galanuez. ¿Te parece bien?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_043_student_f_06",
      "hash64": "4B26BE5C76001679",
      "text": "¡No tienes suficientes Ramas de Galanuez!\\c\\nDate una vuelta por el Área Costera y seguro\\nque encuentras unas cuantas.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_043_student_f_07",
      "hash64": "4B26BD5C760014C6",
      "text": "¡Estupendo! ¡Déjalo en mis manos!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_043_student_f_08",
      "hash64": "4B26C85C76002777",
      "text": "Teje que te teje... Trenza que te trenza...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_043_student_f_09",
      "hash64": "4B26C75C760025C4",
      "text": "¡Aquí tienes tu complemento, como recién salido\\ndel horno!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_043_student_f_10",
      "hash64": "4B233A5C75FD0056",
      "text": "¡Es ideal para los Slowpoke de Galar!\\n¡Les queda de maravilla!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
