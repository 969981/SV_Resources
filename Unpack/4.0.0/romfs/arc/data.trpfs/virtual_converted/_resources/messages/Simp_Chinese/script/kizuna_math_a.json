            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_a_mob_01",
      "hash64": "74F36DAA300E3DF1",
      "text": "泰姆老师～！\\n泰姆老师～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_a_09",
      "hash64": "FA7C7478265442B2",
      "text": "哎呀，真是充满活力的声音。\\n我们按顺序来哦，\\r\\n毕竟泰姆老师只有一个嘛。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_math_a_mob_02",
      "hash64": "74F36AAA300E38D8",
      "text": "泰姆老师，\\n你以前真的是道馆馆主吗～！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_a_10",
      "hash64": "FA797778265211F4",
      "text": "是真的哦～\\n老师我可是很强的！[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_math_a_mob_03",
      "hash64": "74F36BAA300E3A8B",
      "text": "太厉害了～！\\n可是后来为什么不当了呢～？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_math_a_11",
      "hash64": "FA797878265213A7",
      "text": "那是因为啊……\\n我只告诉遵守秩序的好孩子哦～？[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
