      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_math_a_mob_04",
      "hash64": "74F370AA300E430A",
      "text": "我能遵守！\\n那么我等着老师的回答哦～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
