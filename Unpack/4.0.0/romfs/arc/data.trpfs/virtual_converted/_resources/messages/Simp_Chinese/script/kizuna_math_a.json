    {
      "ordinal": 1,
      "label": "kizuna_math_a_02",
      "hash64": "FA7C7B7826544E97",
      "text": "你是想问\\n关于上课内容的问题吗？[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
