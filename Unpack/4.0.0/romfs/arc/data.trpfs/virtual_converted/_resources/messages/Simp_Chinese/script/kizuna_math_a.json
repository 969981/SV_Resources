          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_math_a_select_04",
      "hash64": "306B2435068E49E2",
      "text": "我来问问题！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_math_a_select_05",
      "hash64": "306B2535068E4B95",
      "text": "我全都学会了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_a_05",
      "hash64": "FA7C78782654497E",
      "text": "你觉得哪里比较难？\\n来和老师一起学习吧！[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_a_06",
      "hash64": "FA7C7778265447CB",
      "text": "呵呵呵，听到你说全都学会了，\\n我很高兴哦。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_a_07",
      "hash64": "FA7C767826544618",
      "text": "那么，如果用岩石属性招式攻击\\n不擅长对付它的飞行属性宝可梦，\\r\\n伤害会变为几倍呢？[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
