    {
      "ordinal": 1,
      "label": "sdc02_0150_dragonbb_02",
      "hash64": "AA753846E407CA45",
      "text": "抱歉，抱歉，\\n讓[VAR 0x1100(00FF,0101)]你妳等了一下。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
