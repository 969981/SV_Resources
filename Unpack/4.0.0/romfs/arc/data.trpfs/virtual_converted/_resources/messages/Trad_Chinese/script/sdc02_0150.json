    {
      "ordinal": 19,
      "label": "sdc02_0150_brother_02",
      "hash64": "98945DB8171F0878",
      "text": "[VAR 0x0100(0000)]。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
