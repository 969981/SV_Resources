          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0150_dragonbb_03",
      "hash64": "AA753746E407C892",
      "text": "[VAR 0x1100(00FF,0101)]你妳已經打敗\\n第２個四天王了啊。\\r\\n……得天獨厚喔。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
