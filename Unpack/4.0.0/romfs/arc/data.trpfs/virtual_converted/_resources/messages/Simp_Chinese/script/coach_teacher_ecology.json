      "ordinal": 24,
      "label": "coach_teacher_ecology_sp03_01",
      "hash64": "C0FD5D5E45B0FFB8",
      "text": "我也把蓝莓图鉴\\n加进图鉴App了～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
