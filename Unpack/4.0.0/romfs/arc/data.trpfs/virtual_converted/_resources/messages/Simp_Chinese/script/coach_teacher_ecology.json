          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_teacher_ecology_randomtalk_00",
      "hash64": "2B971600F5690C36",
      "text": "生态巨蛋真是\\n非～常有意思～\\c\\n有好多在帕底亚\\n见不到的宝可梦啊～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_teacher_ecology_randomtalk_01",
      "hash64": "2B971700F5690DE9",
      "text": "最近我能在各个地区来往，\\n真的很开心～\\c\\n移动时只要发一会儿呆，\\n就立刻能到目的地，轻松得很～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_teacher_ecology_randomtalk_02",
      "hash64": "2B971400F56908D0",
      "text": "我竟然穿着凉鞋\\n就来了别人的学校～\\c\\n要是被克拉韦尔校长看到，\\n我可能又要挨骂了～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "coach_teacher_ecology_randomtalk_03",
      "hash64": "2B971500F5690A83",
      "text": "[VAR 0x0100(0000)]的[VAR 0x0101(0001)]\\n是非～常有个性的宝可梦～！\\r\\n我很期待它的成长～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
