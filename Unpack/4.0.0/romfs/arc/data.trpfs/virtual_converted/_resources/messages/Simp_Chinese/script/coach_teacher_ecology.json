            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_ecology_sp03_select_01",
      "hash64": "D8E8EB0E6DFAC9A7",
      "text": "太好了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_ecology_sp03_select_02",
      "hash64": "D8E8EC0E6DFACB5A",
      "text": "我们一样了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_ecology_sp03_02",
      "hash64": "C0FD605E45B104D1",
      "text": "是的～！而且蓝色的设计\\n也很帅气～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_ecology_sp03_02b",
      "hash64": "9F8F73306BCAFC29",
      "text": "嘻嘻……\\n我们变一样了～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_ecology_sp03_03",
      "hash64": "C0FD5F5E45B1031E",
      "text": "我想完成图鉴，\\n于是就在生态巨蛋里到处逛，\\r\\n真是非～常令我激动啊～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_ecology_sp03_04",
      "hash64": "C0FD625E45B10837",
      "text": "值得关注的是巨蛋的设计！\\n想出来的人实在是太厉害了～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_ecology_sp03_05",
      "hash64": "C0FD615E45B10684",
      "text": "各种各样的宝可梦\\n都舒舒服服地生活在这里。[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_ecology_sp03_06",
      "hash64": "C0FD645E45B10B9D",
      "text": "如果不是足够了解宝可梦的生态，\\n是做不出这样的设计的～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
