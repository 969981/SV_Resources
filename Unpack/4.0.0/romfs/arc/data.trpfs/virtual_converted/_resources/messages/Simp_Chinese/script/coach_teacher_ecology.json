      "ordinal": 55,
      "label": "coach_teacher_ecology_battleend_win_01_01",
      "hash64": "88F0E1EE2844B4BA",
      "text": "如果你还愿意的话，\\n就随时来找我吧～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
