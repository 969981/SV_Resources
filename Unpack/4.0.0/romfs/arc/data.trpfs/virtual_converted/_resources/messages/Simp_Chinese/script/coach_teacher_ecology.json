    {
      "ordinal": 4,
      "label": "coach_teacher_ecology_sp01_02",
      "hash64": "EA40284DD53ADAA7",
      "text": "我身为你的班主任！\\n也来这里看看你过得如何～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
