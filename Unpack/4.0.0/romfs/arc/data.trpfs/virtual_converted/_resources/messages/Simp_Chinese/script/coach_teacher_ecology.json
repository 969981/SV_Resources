      "text": "交朋友！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_ecology_sp01_04",
      "hash64": "EA40264DD53AD741",
      "text": "冠军级就是不一样～！\\c\\n看来你即使在对战强校也会发挥实力，\\n我好高兴～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
