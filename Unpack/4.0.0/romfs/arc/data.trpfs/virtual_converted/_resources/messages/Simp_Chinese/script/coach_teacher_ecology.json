      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "coach_teacher_ecology_trade_02_02",
      "hash64": "2E2A712D1E5DBD5C",
      "text": "无法使用稀有宝可梦\\n进行交换。",
      "flags": 0,
      "text_status": "DECODED",
