      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "coach_teacher_ecology_trade_03_00",
      "hash64": "D67E292581DE6433",
      "text": "同行宝可梦只有１只的话，\\n是无法交换的哦～\\c\\n等你带着２只以上的宝可梦，\\n我们再来交换吧～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
