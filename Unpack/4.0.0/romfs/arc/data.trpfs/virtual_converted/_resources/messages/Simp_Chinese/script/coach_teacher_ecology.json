    },
    {
      "ordinal": 35,
      "label": "coach_teacher_ecology_trade_01_02",
      "hash64": "FFC0F31511683D6F",
      "text": "机会难得，\\n你要不要和我交换宝可梦呢～？[VAR 0x0114(002A)]",
