      ]
    },
    {
      "ordinal": 36,
      "label": "coach_teacher_ecology_trade_01_03",
      "hash64": "FFC0F21511683BBC",
      "text": "我好高兴啊～\\n那我就选溶食兽咯～\\r\\n[VAR 0x0100(0000)]，你呢～？[VAR 0x0114(002A)]",
