    },
    {
      "ordinal": 19,
      "label": "sdc01_0130_sister_08",
      "hash64": "05DB9C9DE4B5104F",
      "text": "¿Pero qué te has creído? ¡Si alguien se sabe aquí\\nlas historias de Noroteo, esa soy yo!\\c\\n¡A mí nadie tiene que darme lecciones, y menos\\nun renacuajo, así que a callar![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
