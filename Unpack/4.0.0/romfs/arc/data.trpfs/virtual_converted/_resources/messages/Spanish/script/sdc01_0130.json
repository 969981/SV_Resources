      "hash64": "05D81C9DE4B200F8",
      "text": "¡Eso es espíritu de fiesta, claro que sí![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
