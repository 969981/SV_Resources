      "label": "gym_ghost_010_receptionist_01",
      "hash64": "566276775F56375E",
      "text": "프리지체육관에 오신 것을 환영합니다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
