          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_ghost_010_receptionist_04",
      "hash64": "56627B775F563FDD",
      "text": "프리지체육관의 체육관 테스트 과제는...\\n[VAR 0xFF00(0006)]오프닝 액트[VAR 0xFF00(0000)]!\\r\\n...흔히 말하는 바람잡이입니다!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_ghost_010_receptionist_05",
      "hash64": "56627A775F563E2A",
      "text": "체육관 관장의 라이브가 시작되기 전에\\n스테이지 위에서 포켓몬 승부!\\r\\n뜨거운 승부로 관객들을 흥분시켜 주세요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_ghost_010_receptionist_06",
      "hash64": "566279775F563C77",
      "text": "라이브 회장에 있는 MC와 이야기하면\\n체육관 테스트를 시작하실 수 있습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_ghost_010_receptionist_07",
      "hash64": "566278775F563AC4",
      "text": "그럼, 다녀오세요!",
      "flags": 0,
      "text_status": "DECODED",
