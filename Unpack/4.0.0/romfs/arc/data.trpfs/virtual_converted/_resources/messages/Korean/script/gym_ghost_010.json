    },
    {
      "ordinal": 2,
      "label": "gym_ghost_010_receptionist_03",
      "hash64": "566274775F5633F8",
      "text": "이곳의 체육관 관장 라임 님과\\n승부하려면 체육관 테스트를\\r\\n클리어해야 합니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
