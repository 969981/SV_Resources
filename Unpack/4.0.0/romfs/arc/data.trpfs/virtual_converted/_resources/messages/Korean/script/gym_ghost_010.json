      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "gym_ghost_010_receptionist_02",
      "hash64": "566275775F5635AB",
      "text": "도전자의 이름을\\n등록하겠습니다...\\r\\n[VAR 0x0100(0000)] 님이시군요!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
