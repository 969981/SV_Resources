          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_013_picnic_02",
      "hash64": "686A7AA477DFA8D5",
      "text": "그런데 요즘, 피크닉에서 쓰기 좋은\\n의자 디자인에 대해 고민이 많아서 말인데,",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_sub_013_picnic_03",
      "hash64": "686A79A477DFA722",
      "text": "괜찮다면 네가 가지고 있는\\n테이블보를 좀 보여 줄 수 있겠니?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_013_picnic_15",
      "hash64": "6866F7A477DC9465",
      "text": "혹시 피크닉에는\\n별로 관심이 없니...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
