          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_c_05_history_12",
      "hash64": "B66D9C80485F5DF0",
      "text": "Weißt du, was die zu den Schätzen gehörenden\\nTafeln eigentlich darstellen?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_c_05_select_01",
      "hash64": "E88A268926C1CF24",
      "text": "Schrifttafeln aus Holz.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_c_05_select_02",
      "hash64": "E88A298926C1D43D",
      "text": "Tische.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "class_c_05_select_03",
      "hash64": "E88A288926C1D28A",
      "text": "Etwas Essbares.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_c_05_history_answer_01",
      "hash64": "4CAB7604AC3B14BD",
      "text": "Richtig! Du lernst wohl jeden Tag fleißig, was?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_c_05_history_answer_02",
      "hash64": "4CAB7304AC3B0FA4",
      "text": "Falsch! Man bezeichnet zwar große Esstische\\nmanchmal auch als „Tafel“, aber wie soll denn\\r\\nein Händler mehrere Tische getragen haben?![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_c_05_history_answer_03",
      "hash64": "4CAB7404AC3B1157",
      "text": "Falsch! Da hast du wohl an Tafeln Schokolade\\ngedacht, was? Vielleicht solltest du vor der\\r\\nnächsten Unterrichtsstunde etwas essen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_c_05_history_13",
      "hash64": "B66D9D80485F5FA3",
      "text": "Holztafeln wie diese wurden in der Antike im\\nOsten verwendet, um darauf zu schreiben.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_c_05_history_14",
      "hash64": "B66DA280485F6822",
      "text": "Wie ihr sicher wisst, wurden sie aber mit der\\nVerbreitung von Papier immer seltener genutzt.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_c_05_history_15",
      "hash64": "B66DA380485F69D5",
      "text": "In den Augen des Königs müssen diese selten\\ngewordenen Holztafeln unglaublich wertvoll\\r\\ngewesen sein.\\c\\nVielleicht stand sogar etwas Besonderes darauf\\ngeschrieben.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 166,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_c_05_history_16",
      "hash64": "B66DA080485F64BC",
      "text": "Der König hatte die Schätze an sich gebracht,\\ndoch noch in derselben Nacht geschah es...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_c_05_history_17",
      "hash64": "B66DA180485F666F",
      "text": "Man sagt, ein fürchterliches Unheil sei über sein\\nSchloss hereingebrochen und habe es noch vor\\r\\ndem Morgengrauen in Schutt und Asche gelegt.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_c_05_history_18",
      "hash64": "B66DA680485F6EEE",
      "text": "Die Geschichte geht zwar eigentlich noch weiter,\\naber ich scheine für heute schon genug geredet\\r\\nzu haben...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_c_05_history_19",
      "hash64": "B66DA780485F70A1",
      "text": "Wer sich für die Fortsetzung interessiert, kann\\nmich gerne außerhalb des Unterrichts aufsuchen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    }
  ]
