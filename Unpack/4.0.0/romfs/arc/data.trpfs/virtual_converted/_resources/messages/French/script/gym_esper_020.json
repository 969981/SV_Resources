          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_esper_020_trainer_11",
      "hash64": "392E4725B7800D52",
      "text": "Tu dois commencer à fatiguer, mais il va falloir\\nt’accrocher ! On va entamer la deuxième partie\\r\\ndu programme Fitness Émotion ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_esper_020_trainer_12",
      "hash64": "392E4625B7800B9F",
      "text": "Un surplus d’émotions ! La sueur qui coule sur\\nton front ! Voilà le gage de ta performance ![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_esper_020_trainer_28",
      "hash64": "3931C625B7831AF6",
      "text": "C’était parfait ! C’est à se demander si j’ai encore\\ndes choses à t’apprendre ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
