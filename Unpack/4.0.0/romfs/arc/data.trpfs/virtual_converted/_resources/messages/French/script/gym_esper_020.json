        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_esper_020_trainer_14",
      "hash64": "392E4425B7800839",
      "text": "Et quel succès ! Félicitations ![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_esper_020_trainer_15",
      "hash64": "392E4325B7800686",
      "text": "Mais l’examen n’est pas terminé tant que tu n’as\\npas annoncé tes résultats à la réception !\\c\\nFonce, c’est la dernière ligne droite ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
