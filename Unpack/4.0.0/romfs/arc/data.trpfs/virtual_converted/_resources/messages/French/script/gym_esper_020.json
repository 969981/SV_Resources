    },
    {
      "ordinal": 22,
      "label": "gym_esper_020_battle_b_01",
      "hash64": "D4DF63147BD9742D",
      "text": "Mon objectif est de développer ma musculature !\\nT’aurais pas une astuce ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "gym_esper_020_trainer_13",
      "hash64": "392E4525B78009EC",
      "text": "Beau travail ! Tu es venu[VAR 0x1100(00FF,0100)]e à bout du programme\\nFitness Émotion ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
