          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "team_0100_nelke_08",
      "hash64": "04928882C7D55B83",
      "text": "Por fin tengo claro cómo enfocar la situación,\\ny cuál es la decisión correcta que he de tomar.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "team_0100_nelke_09",
      "hash64": "04928782C7D559D0",
      "text": "Mil gracias, [VAR 0x0100(0000)]. ¡Molas macísimo!\\nPero ten mogollón de cuidadín, ¿eh?\\c\\n...\\c\\nNo termino de dominar vuestra jerga juvenil...\\nCreo que debería seguir practicando.[VAR 0x0114(001E)]",
