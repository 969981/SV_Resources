          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "team_0100_cassiopeia_04",
      "hash64": "BB40B6EA9F220A95",
      "text": "¿Cael? No esperaba que vinieras.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "team_0100_nelke_02",
      "hash64": "04929282C7D56C81",
      "text": "¿Y perderme la juerga? ¡Ni hablar del peluquín!\\nQue es ya la última base, ojo al dato.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "team_0100_cassiopeia_05",
      "hash64": "BB40B5EA9F2208E2",
      "text": "Déjame aprovechar el momento para darte las\\ngracias, Cael. Has sido de gran ayuda, a pesar\\r\\ndel recelo que mostré cuando nos conocimos.\\c\\nEspero que sepas perdonarme.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 169,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "team_0100_nelke_03",
      "hash64": "04929182C7D56ACE",
      "text": "Tranqui, no hace falta que te martirices.\\c\\nSi lo he entendido bien, la Operación Stardust\\nconcluirá cuando nos hayamos ocupado de esta\\r\\nbase de aquí, ¿no?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 158,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "team_0100_cassiopeia_06",
      "hash64": "BB40B4EA9F22072F",
      "text": "Por desgracia, no. Faltaría derrotar a la autoridad\\nsuprema, el auténtico cerebro del Team Star.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "team_0100_nelke_04",
      "hash64": "04929482C7D56FE7",
      "text": "¿Y dónde está? ¿Tienes algún indicio?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "team_0100_cassiopeia_07",
      "hash64": "BB40B3EA9F22057C",
      "text": "Algo me dice que se dejará ver cuando todos\\nlos jefes hayan caído.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "team_0100_nelke_05",
      "hash64": "04929382C7D56E34",
      "text": "Interesante...[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "team_0100_cassiopeia_08",
      "hash64": "BB40BAEA9F221161",
      "text": "Estamos a un paso de alcanzar nuestro objetivo.\\nCuento con vosotros.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "team_0100_nelke_06",
      "hash64": "04929682C7D5734D",
      "text": "Ha colgado, ¿verdad? ¿Ya no nos escucha?\\nEjem...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "team_0100_nelke_07",
      "hash64": "04929582C7D5719A",
      "text": "Gracias a ti, ahora comprendo un poquito\\nmejor al Team Star, [VAR 0x0100(0000)].[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
