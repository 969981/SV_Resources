        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_1150_legend_01",
      "hash64": "5C40BB519F335B54",
      "text": "啊嘎……？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
