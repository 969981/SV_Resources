    {
      "ordinal": 3,
      "label": "common_1150_friend_01",
      "hash64": "3AC2B0431CDDD763",
      "text": "等一下～！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
