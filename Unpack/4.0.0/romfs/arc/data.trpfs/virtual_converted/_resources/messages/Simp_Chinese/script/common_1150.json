    {
      "ordinal": 1,
      "label": "common_1150_system_01",
      "hash64": "E23063E5465E273C",
      "text": "要打开零区研究所的闸口吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "common_1150_system_02",
      "hash64": "E23066E5465E2C55",
      "text": "[VAR 0x0100(0000)]\\n把零区研究所的闸口……",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
