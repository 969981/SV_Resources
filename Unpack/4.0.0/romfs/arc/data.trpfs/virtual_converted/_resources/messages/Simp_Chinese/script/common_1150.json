          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_1150_rival_04",
      "hash64": "CFFCCA6151605212",
      "text": "[VAR 0x0100(0000)]！\\n把[VAR 0x0101(0001)]派出来！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
