    },
    {
      "ordinal": 13,
      "label": "common_1150_rival_05",
      "hash64": "CFFCCB61516053C5",
      "text": "你就放心好了！\\n就算[VAR 0x0101(0001)]不能战斗，\\r\\n我也会保护大家的！好吗？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
