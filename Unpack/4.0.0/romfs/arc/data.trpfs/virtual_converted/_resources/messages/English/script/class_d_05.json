          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_d_05_language_02",
      "hash64": "6D2EFAECA3C318B4",
      "text": "We’re halfway there! And now, time for another\\nlesson! Êtes-vous prêts—are you ready?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
