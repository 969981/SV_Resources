      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "class_d_05_language_15",
      "hash64": "6D3265ECA3C6045C",
      "text": "It’s using its angry voice![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_d_05_language_16",
      "hash64": "6D3268ECA3C60975",
      "text": "That’s right—I had my little Pikachu friend here\\npretend to be angry for us![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_d_05_language_17",
      "hash64": "6D3267ECA3C607C2",
      "text": "Don’t you think he did a great job? Give Pikachu\\na round of applause, everyone![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
