          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "class_d_05_language_23",
      "hash64": "6D27F3ECA3BCEE21",
      "text": "And now, apropos of nothing, let me give you\\nall one of my wise words of advice![VAR 0x0114(0026)]",
