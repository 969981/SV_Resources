      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "class_d_05_language_18",
      "hash64": "6D326AECA3C60CDB",
      "text": "The same Pokémon can even communicate its\\nfeelings in many different ways![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "class_d_05_language_19",
      "hash64": "6D3269ECA3C60B28",
      "text": "Their voices change depending on their mood\\nand physical condition.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "class_d_05_language_20",
      "hash64": "6D27F0ECA3BCE908",
      "text": "Try listening more carefully to Pokémon—you\\nmight gain a deeper understanding of them![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "class_d_05_language_21",
      "hash64": "6D27F1ECA3BCEABB",
      "text": "That having been said, Pokémon are quite\\nmysterious creatures![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "class_d_05_language_22",
      "hash64": "6D27F2ECA3BCEC6E",
      "text": "Some actually don’t communicate with words at\\nall, but instead use things like electromagnetic\\r\\nor ultrasonic waves—some even use telepathy![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
