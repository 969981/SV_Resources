    {
      "ordinal": 0,
      "label": "class_d_05_language_01",
      "hash64": "6D2EFDECA3C31DCD",
      "text": "How did you like the midterm exam? You all did\\nreally great![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
