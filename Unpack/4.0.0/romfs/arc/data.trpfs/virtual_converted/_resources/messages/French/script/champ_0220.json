    {
      "ordinal": 4,
      "label": "champ_0220_ground_02",
      "hash64": "D97FDD4188CF2B74",
      "text": "C’est moi qu’ouvre les hostilités ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
