      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0220_ground_05",
      "hash64": "D97FDC4188CF29C1",
      "text": "Mais en vrai, j’ai bien kiffé le combat ![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
