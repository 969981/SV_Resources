    {
      "ordinal": 1,
      "label": "common_0990_friend_01",
      "hash64": "9C4F5DDF0F4F9DEA",
      "text": "Yo! Arven here![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
