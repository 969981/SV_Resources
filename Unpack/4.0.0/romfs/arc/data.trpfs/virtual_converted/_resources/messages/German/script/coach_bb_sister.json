    {
      "ordinal": 36,
      "label": "coach_bb_sister_sp03_06",
      "hash64": "6E31F14ECDF9D581",
      "text": "*seufz* Vielleicht bin ich auch überfürsorglich...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
