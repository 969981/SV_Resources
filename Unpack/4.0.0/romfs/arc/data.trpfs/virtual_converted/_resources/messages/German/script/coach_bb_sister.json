          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb_sister_sp01_select_01",
      "hash64": "EC5CE56AB223E9B5",
      "text": "Jawoll!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_bb_sister_sp01_select_02",
      "hash64": "EC5CE26AB223E49C",
      "text": "Äh...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_bb_sister_sp01_03",
      "hash64": "40971C3BE7B5BE30",
      "text": "Nanu? Du bist ja so folgsam. Hast du was\\nKomisches gegessen oder so?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_bb_sister_sp01_03b",
      "hash64": "76834BCAB9D26556",
      "text": "Hehehe! Ich wünschte, du könntest gerade dein\\neigenes Gesicht sehen. Zu komisch![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb_sister_sp01_04",
      "hash64": "4097233BE7B5CA15",
      "text": "Hach ja, nachdem ich eine Weile in Kitakami war,\\nkommt mir die Akademie jetzt total überfüllt vor.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb_sister_sp01_05",
      "hash64": "4097223BE7B5C862",
      "text": "In Midoriya ist überhaupt nichts los.\\nAber genau das mag ich daran.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb_sister_sp02_00",
      "hash64": "6F6D1D53F5073B96",
      "text": "Sag mal, [VAR 0x0100(0000)]...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
