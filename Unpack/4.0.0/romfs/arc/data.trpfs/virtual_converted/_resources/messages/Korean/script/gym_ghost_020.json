            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_ghost_020_boy_01",
      "hash64": "8DEC4E6B5ECC8FBA",
      "text": "더블배틀... 1+1...\\n정답이 뭔지 너는 알아?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
