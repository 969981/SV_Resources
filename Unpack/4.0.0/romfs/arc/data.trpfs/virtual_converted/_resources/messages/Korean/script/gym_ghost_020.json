            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_ghost_020_mc_30",
      "hash64": "75C54C5A7E7FD1C0",
      "text": "산들바람을 부르는 소년 퍼포머~\\n우~탄![VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
