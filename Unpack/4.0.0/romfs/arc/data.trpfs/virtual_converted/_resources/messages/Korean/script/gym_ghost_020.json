          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_ghost_020_mc_21",
      "hash64": "75C8D15A7E82E996",
      "text": "도전자 [VAR 0x0100(0000)][VAR 0x1900(0004)]\\n가장 처음 승부할 상대는...[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
