            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0000_ecology_04",
      "hash64": "5772ADE9CF9E054F",
      "text": "[VAR 0xBD06(0000)]And would you believe it,\\n[VAR 0x0100(0000)]?\\r\\nYour\\r\\nname\\r\\nwas\\r\\none\\r\\nof\\r\\nthe\\r\\nones\\r\\nchosen\\r\\nto\\r\\nattend![VAR 0x0114(002A)]",
