    },
    {
      "ordinal": 8,
      "label": "sdc01_0000_ecology_07",
      "hash64": "5772AEE9CF9E0702",
      "text": "It’s a long trip to get to this year’s destination,\\nso we can’t send too many students this time.\\c\\nYou really are a lucky one, getting selected as\\none of the participants![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
