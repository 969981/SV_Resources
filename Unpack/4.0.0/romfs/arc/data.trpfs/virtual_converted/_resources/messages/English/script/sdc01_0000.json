      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc01_0000_select_02",
      "hash64": "DE435AC74FC0C3A9",
      "text": "What is it?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_0000_ecology_02",
      "hash64": "5772ABE9CF9E01E9",
      "text": "Sorry to bother you while you’re probably out\\nsearching for some nice treasure...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
