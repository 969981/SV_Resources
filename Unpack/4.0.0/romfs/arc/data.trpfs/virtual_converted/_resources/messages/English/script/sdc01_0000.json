          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0000_ecology_03",
      "hash64": "5772AAE9CF9E0036",
      "text": "You see, we have a school trip every year around\\nthis time.\\c\\nIt’s a special collaboration between our academy\\nand another school.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
