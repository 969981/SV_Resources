      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "legend_0050_friend_15",
      "hash64": "F0558E89AF8221FC",
      "text": "마음의 상처... 트라우마라고 하던가?\\n책에서 읽었거든.[VAR 0x0114(0006)]",
      "flags": 0,
