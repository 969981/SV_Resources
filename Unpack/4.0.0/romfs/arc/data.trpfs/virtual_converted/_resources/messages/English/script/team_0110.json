    },
    {
      "ordinal": 44,
      "label": "team_0110_cassiopeia_20",
      "hash64": "ED11E5614AF8B6FA",
      "text": "Then I’ll see you both there.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
