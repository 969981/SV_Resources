      ]
    },
    {
      "ordinal": 45,
      "label": "team_0110_nelke_04",
      "hash64": "AAF266C21941D70C",
      "text": "So Cassiopeia was the big boss of Team Star this\\nwhole time... I scarcely thought it possible.\\c\\nBut with this revelation, I just might have an\\ninkling as to their true identity...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
