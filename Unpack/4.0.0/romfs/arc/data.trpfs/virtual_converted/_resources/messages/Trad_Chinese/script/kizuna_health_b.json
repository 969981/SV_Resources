          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_health_b_06",
      "hash64": "D8FBA779A0491BF0",
      "text": "哦～\\n[VAR 0x1100(00FF,0101)]你妳在做那麼有趣的事啊～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
