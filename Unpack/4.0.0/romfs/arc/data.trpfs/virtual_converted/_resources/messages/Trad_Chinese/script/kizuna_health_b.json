          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_health_b_03b",
      "hash64": "FCCA1FAB5C484217",
      "text": "不對～\\n[VAR 0x1100(00FF,0101)]你妳的神情果真有些變了。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
