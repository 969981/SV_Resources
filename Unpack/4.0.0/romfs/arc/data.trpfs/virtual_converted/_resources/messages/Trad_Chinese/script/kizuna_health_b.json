        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_health_b_03a",
      "hash64": "FCCA20AB5C4843CA",
      "text": "哦～自己誇自己不會臉紅呀～？\\n不過，[VAR 0x1100(00FF,0101)]你妳的神情真的變了。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
