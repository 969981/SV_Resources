          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_health_b_05",
      "hash64": "D8FBAA79A0492109",
      "text": "[VAR 0x1100(00FF,0101)]你妳在做什麼樣的事，\\n說給我聽聽吧。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
