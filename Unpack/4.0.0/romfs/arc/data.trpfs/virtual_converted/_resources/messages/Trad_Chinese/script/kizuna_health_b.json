          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_health_b_04",
      "hash64": "D8FBA979A0491F56",
      "text": "我想那一定是因為\\n[VAR 0x1100(00FF,0101)]你妳在尋寶時獲得很多不同的體驗～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
