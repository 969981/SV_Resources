    {
      "ordinal": 16,
      "label": "school_main_chara_battleteacher_01",
      "hash64": "FCF05F98B306ACEA",
      "text": "嘿呀！轉學生！\\n肌肉很可靠喔！肌肉！[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
