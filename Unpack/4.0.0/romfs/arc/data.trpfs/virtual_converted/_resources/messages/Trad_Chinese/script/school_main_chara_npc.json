      "ordinal": 22,
      "label": "school_main_chara_historyteacher_03",
      "hash64": "E27F4B8E75633B7A",
      "text": "我正在調查那個童話故事。\\n等我後續的消息吧。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
