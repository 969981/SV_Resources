    {
      "ordinal": 26,
      "label": "school_main_chara_healthteacher_02",
      "hash64": "AD66429216327D8B",
      "text": "這不是[VAR 0x0100(0000)]嗎？\\n不要勉強自己，好好休息吧～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
