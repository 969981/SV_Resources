    {
      "ordinal": 15,
      "label": "school_main_chara_headteacher_02",
      "hash64": "F190BFE6B5D96C7F",
      "text": "[VAR 0x0100(0000)]同學來到本校，\\n我真的非常高興。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
