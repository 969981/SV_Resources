      ]
    },
    {
      "ordinal": 23,
      "label": "school_main_chara_historyteacher_04",
      "hash64": "E27F468E756332FB",
      "text": "尋找災禍之寶這件事……\\n[VAR 0x1100(00FF,0101)]你妳要是有興趣了，就幫忙調查一下吧。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
