          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "school_main_chara_pokelogicalteacher_02",
      "hash64": "0608F2BD7D0DD149",
      "text": "目標是登錄３０種寶可夢\\n到寶可夢圖鑑～！\\r\\n完成之後記得告訴我喔～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
