      "ordinal": 25,
      "label": "school_main_chara_healthteacher_01",
      "hash64": "AD66439216327F3E",
      "text": "[VAR 0x1100(00FF,0101)]你妳如果累了，\\n在醫務室休息一下如何呢？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
