  "entries": [
    {
      "ordinal": 0,
      "label": "champ_0045_dragon_01",
      "hash64": "7ADAD7B0E91C4F52",
      "text": "당신이 소문으로만 듣던\\n[VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양... 맞나요?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
