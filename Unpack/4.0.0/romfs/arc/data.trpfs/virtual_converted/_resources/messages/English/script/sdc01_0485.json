    },
    {
      "ordinal": 38,
      "label": "sdc01_0485_sister_15",
      "hash64": "A3B9E92AC7EB9E42",
      "text": "Oh, I almost forgot—I still need to get packed\\nand everything![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
