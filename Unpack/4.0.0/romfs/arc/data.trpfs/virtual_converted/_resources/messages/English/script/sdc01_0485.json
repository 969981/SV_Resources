      ]
    },
    {
      "ordinal": 42,
      "label": "sdc01_0485_bbteacher_10",
      "hash64": "724C189413638775",
      "text": "Anyway, that about wraps up this school trip![VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
