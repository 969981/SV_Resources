      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_b_06_select_03",
      "hash64": "669BEE9254F0F216",
      "text": "Dipende",
      "flags": 0,
