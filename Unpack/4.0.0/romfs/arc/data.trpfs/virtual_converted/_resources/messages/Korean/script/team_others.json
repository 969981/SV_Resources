      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "team_others_intercom_08",
      "hash64": "2185B53A87918D65",
      "text": "스타단의 보스에게\\n다시 도전하겠습니까?",
