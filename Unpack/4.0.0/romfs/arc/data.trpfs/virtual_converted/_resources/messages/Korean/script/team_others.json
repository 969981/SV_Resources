      ]
    },
    {
      "ordinal": 2,
      "label": "team_others_intercom_03",
      "hash64": "2185BA3A879195E4",
      "text": "선두부터 세 번째까지의 포켓몬으로\\nSTC에서 훈련하겠습니까?",
      "flags": 0,
