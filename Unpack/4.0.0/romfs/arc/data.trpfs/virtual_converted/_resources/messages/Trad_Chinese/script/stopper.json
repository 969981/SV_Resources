    {
      "ordinal": 0,
      "label": "stopper_general_01",
      "hash64": "CB04017349BE696B",
      "text": "還是等之後\\n再往這個方向去吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "stopper_general_02",
      "hash64": "CB04027349BE6B1E",
      "text": "現在在學校裡探險看看吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "stopper_common_0030_01",
      "hash64": "C463F20AE2942618",
      "text": "看來還沒完成去學校的準備。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
