    {
      "ordinal": 6,
      "label": "stopper_common_0095_01",
      "hash64": "ADEDF249B490056F",
      "text": "還沒選好寶可夢！\\n……去回覆校長吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "stopper_common_0170_01",
      "hash64": "1AA738F3C7B66831",
      "text": "加嚕加嚕！加嚕！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "stopper_common_0170_02",
      "hash64": "1AA735F3C7B66318",
