      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_b_05_math_answer_01",
      "hash64": "8B8E0E71C2F5CEC0",
      "text": "Ah ja, hier kommt man leicht durcheinander.\\c\\nIm Falle von Kraftschub wäre deine Antwort\\nrichtig gewesen.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 1,
