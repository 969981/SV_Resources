      ]
    },
    {
      "ordinal": 16,
      "label": "class_b_05_math_answer_02",
      "hash64": "8B8E1171C2F5D3D9",
      "text": "[VAR 0xBD06(0000)]Einwandfrei, [VAR 0x0100(0000)]! Dabei war die\\nFrage\\r\\nalles\\r\\nandere\\r\\nals\\r\\nleicht![VAR 0x0114(0025)]",
