          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_b_05_math_21",
      "hash64": "33F0C87A35CAB139",
      "text": "Der heutige Unterricht hatte es ganz schön\\nin sich.\\c\\nBitte geht den Schulstoff zu Hause noch einmal\\ndurch, um euer Wissen „drastisch“ zu steigern.\\c\\nAlso dann, bis zum nächsten Mal![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
