        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0045_dragon_04",
      "hash64": "7ADAD4B0E91C4A39",
      "text": "Mi nombre es Hesperio. Soy miembro del Alto\\nMando de la Liga Pokémon y también imparto\\r\\nla asignatura de Arte en la academia.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
