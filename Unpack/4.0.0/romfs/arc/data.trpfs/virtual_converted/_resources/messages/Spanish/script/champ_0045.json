          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0045_select_01",
      "hash64": "2E5C21729333EC2B",
      "text": "Quiero hacerme más fuerte",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "champ_0045_select_02",
      "hash64": "2E5C22729333EDDE",
      "text": "Me lo ha propuesto una amiga",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "champ_0045_select_03",
      "hash64": "2E5C23729333EF91",
      "text": "Quiero encontrar un tesoro",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "champ_0045_select_04",
      "hash64": "2E5C24729333F144",
      "text": "Nada en concreto",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "champ_0045_dragon_06",
      "hash64": "7ADAD2B0E91C46D3",
      "text": "Agradezco que me hayas respondido.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0045_dragon_07",
      "hash64": "7ADAD1B0E91C4520",
      "text": "En realidad, no existe una única respuesta\\ncorrecta. Como bien reza el dicho, \"todos los\\r\\ncaminos llevan al foso de Paldea\".[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
