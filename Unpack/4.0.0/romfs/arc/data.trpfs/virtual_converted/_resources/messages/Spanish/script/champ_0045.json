          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0045_dragon_05",
      "hash64": "7ADAD3B0E91C4886",
      "text": "Permíteme que te haga una pregunta...\\c\\n¿Qué te impulsa a reunir las Medallas de\\nGimnasio y alcanzar el rango de Campe[VAR 0x1100(00FF,0302)]ónona?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 3,
