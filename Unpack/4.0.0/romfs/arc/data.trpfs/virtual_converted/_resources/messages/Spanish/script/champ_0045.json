          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0045_dragon_08",
      "hash64": "7ADAE0B0E91C5E9D",
      "text": "¿Sabes? Tu amiga Mencía es la Campeona más\\njoven de la historia de la región.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0045_dragon_09",
      "hash64": "7ADADFB0E91C5CEA",
      "text": "¿Quién sabe? Tal vez tú también albergues el\\nmismo potencial.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0045_dragon_10",
      "hash64": "7AD752B0E919377C",
      "text": "Seguir la estela de los Campeones implica\\nenfrentarse tarde o temprano a un servidor.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0045_dragon_11",
      "hash64": "7AD753B0E919392F",
      "text": "Te aconsejo que entrenes con seriedad desde\\neste momento si no quieres tener que lamentar\\r\\ntu derrota más adelante.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
