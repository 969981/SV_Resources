      ]
    },
    {
      "ordinal": 1,
      "label": "class_d_06_language_02",
      "hash64": "F1C42898E7E45C85",
      "text": "C’est l’heure de votre cours préféré : le cours\\nde langues ! Are you ready ?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
