        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_d_06_yes_01",
      "hash64": "78D14F97ED7B12A7",
      "text": "Oui !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "class_d_06_yes_02",
      "hash64": "78D15097ED7B145A",
      "text": "Yes !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_d_06_language_03",
      "hash64": "F1C42798E7E45AD2",
      "text": "Ah, ça me fait plaisir ! Je n’ai plus l’impression\\nde faire un monologue en cours, maintenant.\\r\\nJe vous remercie ![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
