          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_d_06_language_04",
      "hash64": "F1C42298E7E45253",
      "text": "Today... On va continuer à travailler notre\\noreille ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_06_language_05",
      "hash64": "F1C42198E7E450A0",
      "text": "Come on, Pikachu ! C’est à toi ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_d_06_poke_01",
      "hash64": "0864E03253BE2119",
      "text": "Pikachu !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_d_06_language_06",
      "hash64": "F1C42498E7E455B9",
      "text": "Dans le cours précédent, on a vu qu’un même\\nPokémon utilisait différentes intonations\\r\\nselon ce qu’il voulait exprimer.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_d_06_language_07",
      "hash64": "F1C42398E7E45406",
      "text": "Eh bien, aujourd’hui, on va approfondir le sujet\\ndu langage des Pokémon ![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_d_06_language_08",
      "hash64": "F1C42E98E7E466B7",
      "text": "Please, Pikachu ! C’est à toi ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_d_06_poke_02",
      "hash64": "0864DD3253BE1C00",
      "text": "Pikaaa...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_d_06_language_09",
      "hash64": "F1C42D98E7E46504",
      "text": "Quelle intonation sombre, vous ne trouvez pas ?\\nEt sa voix semble plus grave que la dernière fois.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_d_06_language_10",
      "hash64": "F1C0A098E7E13F96",
      "text": "Alors, à votre avis, quelle est l’émotion que\\nPikachu a essayé de nous communiquer ?[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_d_06_select_01",
      "hash64": "29BE3AD9736DC272",
      "text": "La joie.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_d_06_select_02",
      "hash64": "29BE39D9736DC0BF",
      "text": "La tristesse.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "class_d_06_select_03",
      "hash64": "29BE38D9736DBF0C",
      "text": "La surprise.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_d_06_select_04",
      "hash64": "29BE37D9736DBD59",
      "text": "Tu peux répéter, Pikachu ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_d_06_language_answer_01",
      "hash64": "A5B86F79282F62FD",
      "text": "Désolé, [VAR 0x0100(0000)], mais je crois qu’on\\nest assez loin de la joie, là.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_d_06_language_answer_02",
      "hash64": "A5B86C79282F5DE4",
      "text": "That’s correct ! Tout juste !\\nTu m’impressionnes ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_d_06_language_answer_03",
      "hash64": "A5B86D79282F5F97",
      "text": "Désolé, [VAR 0x0100(0000)], mais ce n’est pas ça.\\c\\nÀ part peut-être si, à cause de la surprise, il a\\nfait tomber une Baie bien juteuse.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_d_06_language_14",
      "hash64": "F1C0A498E7E14662",
      "text": "Lorsque Pikachu s’exprime de cette façon\\net dit...[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_d_06_poke_03",
      "hash64": "0864DE3253BE1DB3",
      "text": "Pikaaa...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "class_d_06_language_15",
      "hash64": "F1C0A598E7E14815",
      "text": "C’est pour exprimer la tristesse ! On a presque\\nenvie de pleurer en entendant ça, non ?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_d_06_language_16",
      "hash64": "F1C0A298E7E142FC",
      "text": "Mais rassurez-vous, il n’est pas vraiment triste.\\nJe lui ai encore demandé de faire semblant...\\r\\nQuel acteur, n’est-ce pas ?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_d_06_language_17",
      "hash64": "F1C0A398E7E144AF",
      "text": "Encore une fois, merci d’applaudir\\nchaleureusement sa prestation admirable ![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_d_06_popup_01",
      "hash64": "E5F5735549382D14",
      "text": "*clap* *clap* *clap*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "class_d_06_language_18",
      "hash64": "F1C0A898E7E14D2E",
      "text": "Bon, je pense que vous avez l’habitude\\nmaintenant... Voici le conseil salvateur de Salvio ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_d_06_language_19",
      "hash64": "F1C0A998E7E14EE1",
      "text": "Si jamais votre Pokémon exprime sa tristesse,\\nsoyez gentils avec lui et occupez-vous-en avec\\r\\nencore plus d’attention que d’habitude.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_d_06_language_20",
      "hash64": "F1BD3A98E7DE5C6D",
      "text": "Mais je sais que pour vous, c’est une évidence !\\nVous le feriez sans vous poser de question ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "class_d_06_language_21",
      "hash64": "F1BD3998E7DE5ABA",
      "text": "Bien sûr, ce conseil ne se limite pas qu’aux\\nPokémon !\\c\\nCela vaut également pour vos camarades\\nde classe... et pour quiconque d’ailleurs ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "class_d_06_language_22",
      "hash64": "F1BD3898E7DE5907",
      "text": "Vous savez... C’est important de nous soutenir\\nles uns les autres quand ça ne va pas ! Prenons\\r\\nsoin des gens qui nous entourent.\\c\\nEt surtout, sachez bien que rien ne me fait plus\\nplaisir que de vous voir sourire, les enfants ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 231,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "class_d_06_language_23",
      "hash64": "F1BD3798E7DE5754",
      "text": "Notre prochain cours sera aussi le dernier !\\nJe compte sur vous pour qu’on termine\\r\\nen beauté ! Adiós ! Bye bye ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
