    {
      "ordinal": 3,
      "label": "msg_common_report_01",
      "hash64": "73CA9D838F1094B9",
      "text": "Vuoi salvare il gioco?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "msg_common_report_02",
      "hash64": "73CA9A838F108FA0",
      "text": "Salvataggio in corso.\\nNon spegnere la console.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "msg_common_report_03",
      "hash64": "73CA9B838F109153",
      "text": "Hai salvato il gioco.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "msg_common_report_04",
      "hash64": "73CAA0838F1099D2",
      "text": "Esiste già un salvataggio e non puoi crearne\\nun altro.\\c\\nConsulta il manuale di istruzioni per ulteriori\\ninformazioni.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
