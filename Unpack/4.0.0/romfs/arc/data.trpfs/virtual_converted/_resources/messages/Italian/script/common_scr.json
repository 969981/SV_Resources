          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "msg_common_report_05",
      "hash64": "73CAA1838F109B85",
      "text": "Il salvataggio non è riuscito.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
