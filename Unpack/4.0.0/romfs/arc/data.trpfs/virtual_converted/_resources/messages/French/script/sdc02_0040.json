    {
      "ordinal": 0,
      "label": "sdc02_0040_headbb_01",
      "hash64": "912432F43F80D285",
      "text": "Ta-daaa ! Nous y sommes ![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
