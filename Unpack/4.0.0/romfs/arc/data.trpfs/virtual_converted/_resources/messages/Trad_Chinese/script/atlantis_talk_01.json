    {
      "ordinal": 2,
      "label": "atlantis_talk_01_rival_01",
      "hash64": "149FE037010B010D",
      "text": "通常是進不來的嘛～[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
