      ]
    },
    {
      "ordinal": 3,
      "label": "atlantis_talk_01_rival_02",
      "hash64": "149FDD37010AFBF4",
      "text": "咦……？\\n話說，[VAR 0x0101(0001)]呢？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
