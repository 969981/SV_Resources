    {
      "ordinal": 1,
      "label": "atlantis_talk_01_botan_02",
      "hash64": "3D7ABF7875EFD3A2",
      "text": "比在課本的插畫看到的\\n還要厲害……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
