          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "atlantis_talk_01_friend_04",
      "hash64": "FF8339B53EF5E560",
      "text": "囉唆耶……\\n妳這傢伙，別得寸進尺啊。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "atlantis_talk_01_botan_05",
      "hash64": "3D7ABA7875EFCB23",
      "text": "啥？別叫我傢伙。\\n你在生什麼氣呀？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "atlantis_talk_01_rival_04",
      "hash64": "149FDB37010AF88E",
      "text": "唉～難得的大冒險，\\n大家開心點嘛！[VAR 0x0114(0004)]",
