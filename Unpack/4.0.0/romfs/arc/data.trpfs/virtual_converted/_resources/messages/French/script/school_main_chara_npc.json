          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "school_main_chara_pokelogicalteacher_04",
      "hash64": "0608F4BD7D0DD4AF",
      "text": "Essaie d’enregistrer au moins 200 espèces\\nde Pokémon dans ton Pokédex !\\c\\nReviens me voir, quand tu auras réussi ![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
