          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "school_main_chara_pokelogicalteacher_05",
      "hash64": "0608F3BD7D0DD2FC",
      "text": "Complète ton Pokédex en y enregistrant\\n400 espèces !\\c\\nQuand tu auras réussi, ouvre l’application et\\nappuie sur le [VAR 0xFF00(0006)]bouton X[VAR 0xFF00(0000)] pour obtenir la marque\\r\\nd’achèvement du Pokédex, puis montre-la-moi ![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
