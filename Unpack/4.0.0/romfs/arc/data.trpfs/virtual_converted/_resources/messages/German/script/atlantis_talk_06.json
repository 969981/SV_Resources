  "entries": [
    {
      "ordinal": 0,
      "label": "atlantis_talk_06_rival_01",
      "hash64": "A26ABDCFE7B6F242",
      "text": "[VAR 0x0101(0001)] ist also mit der Zeitmaschine in die\\nheutige Zeit gereist...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
