          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "atlantis_talk_06_rival_02",
      "hash64": "A26ABCCFE7B6F08F",
      "text": "Und dann hat es eine Weile in Zone Null mit de[VAR 0x1107(00FF,0101)]rm\\nProfessor[VAR 0x1107(00FF,0002)]in und einem anderen Exemplar gelebt?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0002"
          ]
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "atlantis_talk_06_botan_01",
      "hash64": "DBB816BCF28A672C",
      "text": "So scheint es gewesen zu sein.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "atlantis_talk_06_rival_03",
      "hash64": "A26ABBCFE7B6EEDC",
      "text": "Wenn das so ist, dann ist das hier ja quasi\\n[VAR 0x0101(0001)]s zweite Heimat![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "atlantis_talk_06_botan_02",
      "hash64": "DBB819BCF28A6C45",
      "text": "Dieser Ort sollte ihm zumindest vertraut sein.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "atlantis_talk_06_rival_04",
      "hash64": "A26ABACFE7B6ED29",
      "text": "Wie schön! Hier kann es sich dann bestimmt\\nordentlich entspannen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "atlantis_talk_06_friend_01",
      "hash64": "10E89254D8D7EFAE",
      "text": "Hm... Also vorhin war es das genaue Gegenteil\\nvon entspannt.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "atlantis_talk_06_friend_02",
      "hash64": "10E89154D8D7EDFB",
      "text": "Und es macht grad auch keine Anstalten,\\naus seinem Pokéball zu kommen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "atlantis_talk_06_rival_05",
      "hash64": "A26AB9CFE7B6EB76",
      "text": "Meinst du? Ich dachte, es hätte vorhin nur\\nHöhenangst gehabt oder so...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "atlantis_talk_06_friend_03",
      "hash64": "10E89054D8D7EC48",
      "text": "Höhenangst? Wie kommst du denn darauf?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "atlantis_talk_06_botan_03",
      "hash64": "DBB818BCF28A6A92",
      "text": "...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "atlantis_talk_06_botan_04",
      "hash64": "DBB813BCF28A6213",
      "text": "Also so wie [VAR 0x0101(0001)] vorhin reagiert hat, muss\\nes schlimme Erinnerungen an diesen Ort haben...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "atlantis_talk_06_botan_05",
      "hash64": "DBB812BCF28A6060",
      "text": "Solche Erinnerungen können schon ausreichen,\\num einen komplett lahmzulegen.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "atlantis_talk_06_botan_06",
      "hash64": "DBB815BCF28A6579",
      "text": "Ich kenne das von damals... als ich in meiner alten\\nKlasse immer so isoliert war...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "atlantis_talk_06_botan_07",
      "hash64": "DBB814BCF28A63C6",
      "text": "Allein beim Gedanken an die Schule wollte ich\\nmich auch am liebsten nur verstecken...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "atlantis_talk_06_rival_06",
      "hash64": "A26AB8CFE7B6E9C3",
      "text": "Cosima...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "atlantis_talk_06_friend_04",
      "hash64": "10E89754D8D7F82D",
      "text": "Hm... Vielleicht wurde es hier in Zone Null ja\\nvon etwas verletzt, genau wie Mastifioso.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "atlantis_talk_06_botan_08",
      "hash64": "DBB81FBCF28A7677",
      "text": "Wer weiß... Jedenfalls kann es gerade auch nicht\\nseine Kampfform annehmen, oder?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "atlantis_talk_06_botan_09",
      "hash64": "DBB81EBCF28A74C4",
      "text": "Gut möglich also.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "atlantis_talk_06_rival_07",
      "hash64": "A26AB7CFE7B6E810",
      "text": "Oh nein, das wäre ja furchtbar! Wenn das stimmt,\\nmüssen wir einen Weg finden, es aufzuheitern![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "atlantis_talk_06_rival_08",
      "hash64": "A26AC6CFE7B7018D",
      "text": "Und das sage ich natürlich nicht nur, weil ich\\nunbedingt gegen [VAR 0x0101(0001)] kämpfen will![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "atlantis_talk_06_botan_10",
      "hash64": "DBB491BCF2874F56",
      "text": "Das hast du jetzt gesagt, nicht wir...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "atlantis_talk_06_friend_05",
      "hash64": "10E89654D8D7F67A",
      "text": "Nemila, ich muss zugeben, du bist ganz schön...\\neinzigartig.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
