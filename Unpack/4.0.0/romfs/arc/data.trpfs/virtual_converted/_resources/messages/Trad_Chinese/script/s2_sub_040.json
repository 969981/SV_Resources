      "hash64": "7C9CA8CA2AD22CBC",
      "text": "[VAR 0x0100(0000)]從老師那裡\\n得到了[VAR 0x0204(0001,0000)]ＢＰ！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
