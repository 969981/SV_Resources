    },
    {
      "ordinal": 18,
      "label": "s2_sub_040_teacher_12a",
      "hash64": "9637D4727ECE2F6E",
      "text": "不會吧……同學！\\c\\n看來[VAR 0x1100(00FF,0101)]你妳已經打贏草原區的\\n所有學生了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
