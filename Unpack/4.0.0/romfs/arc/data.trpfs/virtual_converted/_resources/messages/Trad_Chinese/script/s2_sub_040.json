        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_040_teacher_04b",
      "hash64": "8D358072799A4A32",
      "text": "首先，[VAR 0x1100(00FF,0101)]你妳就試著在峽谷區這裡\\n打贏[VAR 0x0201(0002)]個學生吧！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
