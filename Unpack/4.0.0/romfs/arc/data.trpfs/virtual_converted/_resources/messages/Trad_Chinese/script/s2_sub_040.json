        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_040_teacher_07",
      "hash64": "EB8384C0B45CC57D",
      "text": "[VAR 0x1100(00FF,0101)]你妳很努力呢！\\n積極找人對戰，真是了不起！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_040_teacher_08",
      "hash64": "EB8375C0B45CAC00",
      "text": "我就送[VAR 0x1100(00FF,0101)]你妳ＢＰ\\n當作努力獎吧！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_040_teacher_09",
      "hash64": "EB8376C0B45CADB3",
      "text": "再另外送給[VAR 0x1100(00FF,0101)]你妳一個獎品！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_040_teacher_10",
      "hash64": "EB8703C0B45FD321",
      "text": "下一個目標……\\n是要打贏[VAR 0x0201(0002)]個學生。\\r\\n但[VAR 0x1100(00FF,0101)]你妳已經達成了啊！？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
