    },
    {
      "ordinal": 20,
      "label": "s2_sub_040_teacher_12c",
      "hash64": "9637D2727ECE2C08",
      "text": "不會吧……同學！\\c\\n看來[VAR 0x1100(00FF,0101)]你妳已經打贏海岸區的\\n所有學生了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
