          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_sub_040_teacher_11",
      "hash64": "EB8702C0B45FD16E",
      "text": "[VAR 0x1100(00FF,0101)]你妳盡情去對戰之後，\\n再來找我領獎品吧！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
