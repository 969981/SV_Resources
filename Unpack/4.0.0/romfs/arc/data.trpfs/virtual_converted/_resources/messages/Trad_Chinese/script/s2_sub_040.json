    },
    {
      "ordinal": 19,
      "label": "s2_sub_040_teacher_12b",
      "hash64": "9637D3727ECE2DBB",
      "text": "不會吧……同學！\\c\\n看來[VAR 0x1100(00FF,0101)]你妳已經打贏峽谷區的\\n所有學生了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
