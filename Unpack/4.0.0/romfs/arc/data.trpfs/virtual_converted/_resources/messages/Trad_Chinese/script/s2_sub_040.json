    {
      "ordinal": 12,
      "label": "s2_sub_040_teacher_06",
      "hash64": "EB8383C0B45CC3CA",
      "text": "等[VAR 0x1100(00FF,0101)]你妳總共打贏了[VAR 0x0201(0002)]個學生以後，\\n再來找我吧！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
