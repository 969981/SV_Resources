          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_sub_040_teacher_17",
      "hash64": "EB8704C0B45FD4D4",
      "text": "今後也要開開心心地\\n享受寶可夢對戰喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "s2_sub_040_teacher_npca",
      "hash64": "3FBD3BE45404A48A",
      "text": "[VAR 0x1100(00FF,0101)]你妳居然在草原區的寶可夢對戰\\n打贏了所有學生！太厲害了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
