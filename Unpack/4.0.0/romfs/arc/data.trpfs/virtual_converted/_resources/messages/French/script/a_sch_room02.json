    {
      "ordinal": 2,
      "label": "a_sch_room02_eve03",
      "hash64": "5ED855C6313F1247",
      "text": "Y a des gens qui dessinent tellement bien\\nque leurs œuvres ressemblent à des photos !\\c\\nMais bon, autant se servir directement de\\nson Appareil photo dans ce cas-là, non ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
