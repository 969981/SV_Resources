          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "a_sch_room02_eve04",
      "hash64": "5ED852C6313F0D2E",
      "text": "Dans le dessin, il y a une certaine finesse\\nqu’on ne retrouve pas dans les photos !\\r\\n... Mais l’inverse est aussi vrai !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "a_sch_room02_eve05",
      "hash64": "5ED853C6313F0EE1",
      "text": "Cette sculpture est si belle qu’elle fait sûrement\\npâlir de jalousie les Pokémon !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
