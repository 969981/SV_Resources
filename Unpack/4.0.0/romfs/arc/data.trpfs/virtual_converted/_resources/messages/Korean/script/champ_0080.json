      "hash64": "0B870AB70EFDD96D",
      "text": "오, 이거 [VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양 아니십니까.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
