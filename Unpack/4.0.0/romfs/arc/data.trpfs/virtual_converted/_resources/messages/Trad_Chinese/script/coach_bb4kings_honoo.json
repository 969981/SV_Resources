        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_bb4kings_honoo_sp01_02",
      "hash64": "C24D2F51CE03177E",
      "text": "烏栗從北上回來之後\\n連一次都沒有輸過，\\r\\n但[VAR 0x1100(00FF,0101)]你妳竟然把他打得落花流水！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb4kings_honoo_sp01_03",
      "hash64": "C24D3051CE031931",
      "text": "難怪[VAR 0x1100(00FF,0101)]你妳會在藍莓聯盟\\n大火熊熊地秒竄上去！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_bb4kings_honoo_sp01_04",
      "hash64": "C24D3151CE031AE4",
      "text": "還有！\\n[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳成了冠軍之後，\\r\\n烏栗就降為四天王……[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_bb4kings_honoo_sp01_05",
      "hash64": "C24D3251CE031C97",
      "text": "這麼一來，傷心呀……\\n四天王裡最弱的我就會被擠出去了！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_bb4kings_honoo_sp01_select_01",
      "hash64": "3E4ABBAA2F752252",
      "text": "這樣啊！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_bb4kings_honoo_sp01_select_02",
      "hash64": "3E4ABAAA2F75209F",
      "text": "對不起喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "coach_bb4kings_honoo_sp01_06",
      "hash64": "C24D3351CE031E4A",
      "text": "唉～我真的很難過呢～！\\n但規則就是規則，沒辦法！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb4kings_honoo_sp01_07",
      "hash64": "C24D3451CE031FFD",
      "text": "而且聯盟社的氣氛\\n也變回以前那樣了。\\r\\n對我來說，這更讓我開心！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb4kings_honoo_sp01_08",
      "hash64": "C24D2551CE030680",
      "text": "這都是[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳的功勞！\\n我一直想跟[VAR 0x1100(00FF,0101)]你妳直接開火明說！\\r\\n謝啦！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
