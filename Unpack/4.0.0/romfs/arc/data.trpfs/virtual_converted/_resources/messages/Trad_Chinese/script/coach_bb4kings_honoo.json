    {
      "ordinal": 3,
      "label": "coach_bb4kings_honoo_sp01_01",
      "hash64": "C24D2E51CE0315CB",
      "text": "[VAR 0x1100(00FF,0101)]你妳和烏栗的對戰！\\n跟大火一樣熱爆啦！！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
