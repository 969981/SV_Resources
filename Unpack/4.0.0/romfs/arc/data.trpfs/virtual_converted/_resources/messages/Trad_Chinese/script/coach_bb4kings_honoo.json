          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb4kings_honoo_sp03_select_01",
      "hash64": "23BA9267B1786E38",
      "text": "太好了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_honoo_sp03_select_02",
      "hash64": "23BA9567B1787351",
      "text": "為什麼？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_honoo_sp03_02",
      "hash64": "46005F5FCBEC4C90",
      "text": "嗯，太好了……嗎！？\\n我也搞不太清楚！[VAR 0x0114(0047)]",
