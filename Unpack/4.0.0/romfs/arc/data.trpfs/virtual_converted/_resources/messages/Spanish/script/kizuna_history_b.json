      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_history_b_14",
      "hash64": "896BE2ACA93D5E31",
      "text": "He buscado información en todas partes:\\nregistros históricos de catástrofes, diarios\\r\\npersonales de la época...\\c\\nY todo apunta a que estamos ante algo más que\\nuna simple fábula.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
