    {
      "ordinal": 1,
      "label": "kizuna_history_b_02",
      "hash64": "8968E2ACA93B285A",
      "text": "No me digas que estás aquí para escuchar el\\nfinal de la fábula...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
