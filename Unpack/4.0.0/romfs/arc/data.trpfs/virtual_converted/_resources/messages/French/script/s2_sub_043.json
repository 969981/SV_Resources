  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_043_student_f_01",
      "hash64": "4B26BF5C7600182C",
      "text": "Si tu as des Branches Galanoa...\\nEh bien, devine quoi...\\r\\nUn accessoire tressé à la main tu recevras !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_sub_043_student_f_02",
      "hash64": "4B26C25C76001D45",
      "text": "Pour un Bracelet Galanoa ou une Couronne\\nGalanoa, tout ce qu’il me faudra, ce sont\\r\\nquelques Branches Galanoa !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_043_select_01",
      "hash64": "DF5476E50DC8F73E",
      "text": "Je voudrais un Bracelet Galanoa.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_043_select_02",
      "hash64": "DF5475E50DC8F58B",
      "text": "Je voudrais une Couronne Galanoa.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_sub_043_select_03",
      "hash64": "DF5474E50DC8F3D8",
      "text": "Je reviendrai plus tard.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "s2_sub_043_student_f_03",
      "hash64": "4B26C15C76001B92",
      "text": "Pour l’instant, ça ne t’intéresse pas, c’est ça ?\\nMais tu reviendras, n’est-ce pas ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_sub_043_student_f_04",
      "hash64": "4B26BC5C76001313",
      "text": "Pour un Bracelet Galanoa, il me faut\\nhuit Branches Galanoa. Ça te va ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_043_student_f_05",
      "hash64": "4B26BB5C76001160",
      "text": "Pour une Couronne Galanoa, il me faut\\nquinze Branches Galanoa. Ça te va ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_043_student_f_06",
      "hash64": "4B26BE5C76001679",
      "text": "Tu n’as pas assez de Branches Galanoa !\\c\\nPromène-toi dans la Zone Côtière,\\net tu en trouveras !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_043_student_f_07",
      "hash64": "4B26BD5C760014C6",
      "text": "On y va ! Tu verras, ça va être extra !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s2_sub_043_student_f_08",
      "hash64": "4B26C85C76002777",
      "text": "Tressi, tressa, j’aime les Galanoa ! ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s2_sub_043_student_f_09",
      "hash64": "4B26C75C760025C4",
      "text": "Et voilà !\\nUn accessoire tout beau pour toi !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "s2_sub_043_student_f_10",
      "hash64": "4B233A5C75FD0056",
      "text": "Donne ça à un Ramoloss de Galar... et tu verras !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
