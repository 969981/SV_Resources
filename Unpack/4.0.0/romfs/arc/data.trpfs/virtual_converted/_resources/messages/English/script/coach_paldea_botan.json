    {
      "ordinal": 55,
      "label": "coach_paldea_botan_randomtalk_00",
      "hash64": "7ADCE7A95190B243",
      "text": "The Terarium sure is something else. It’s easy to\\nforget you’re actually indoors when the dome\\r\\nlooks just like the sky.\\c\\nHow do they do that anyway?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
