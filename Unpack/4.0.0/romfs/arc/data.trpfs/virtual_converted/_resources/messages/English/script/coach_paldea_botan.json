    },
    {
      "ordinal": 56,
      "label": "coach_paldea_botan_randomtalk_01",
      "hash64": "7ADCE6A95190B090",
      "text": "You know how Squawkabilly are used to ferry the\\nFlying Taxis around back in Paldea?\\c\\nWell, where I’m from we use Corviknight—and in\\nthe Terarium, it’s yet another different Pokémon![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
