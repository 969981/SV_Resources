      "hash64": "07BA7B400EAD5D34",
      "text": "Hey there, [VAR 0x0100(0000)].[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
