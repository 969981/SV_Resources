    },
    {
      "ordinal": 57,
      "label": "coach_paldea_botan_randomtalk_02",
      "hash64": "7ADCE9A95190B5A9",
      "text": "Thanks again for inviting me to visit all these\\nplaces with you.\\c\\nIt’s not the easiest thing for a former shut-in like\\nme to do, but...I always end up having fun.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
