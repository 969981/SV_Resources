    },
    {
      "ordinal": 39,
      "label": "coach_teacher_language_trade_01_00",
      "hash64": "BD448DB5AE365F2D",
      "text": "무엇을 하게 되든\\n다른 사람과의 교류는 평생 따라올 테니\\r\\n그 부분에 유연해지도록 하렴![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
