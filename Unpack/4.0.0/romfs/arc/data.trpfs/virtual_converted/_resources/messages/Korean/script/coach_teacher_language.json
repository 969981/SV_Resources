    {
      "ordinal": 45,
      "label": "coach_teacher_language_trade_02_01",
      "hash64": "16794CCEF58783ED",
      "text": "어버이가 자신이 아닌 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
