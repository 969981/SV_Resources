      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_language_sp01_select_02",
      "hash64": "CEF384701EB48B78",
      "text": "글쎄요...?",
      "flags": 0,
      "text_status": "DECODED",
