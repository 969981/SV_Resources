    },
    {
      "ordinal": 40,
      "label": "coach_teacher_language_trade_01_01",
      "hash64": "BD448CB5AE365D7A",
      "text": "그러려면 이 세이지와 좀 더\\n많이 교류해 보는 것도 좋겠어![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
