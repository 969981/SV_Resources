    },
    {
      "ordinal": 29,
      "label": "coach_teacher_language_sp03_01",
      "hash64": "8FDEB6631B1C0BA0",
      "text": "이 아카데미의 Students는\\n공부에 아주 열성적이던데![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
