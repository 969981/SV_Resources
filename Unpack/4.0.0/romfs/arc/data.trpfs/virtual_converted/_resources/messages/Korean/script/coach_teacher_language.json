          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_language_sp03_00",
      "hash64": "8FDEB7631B1C0D53",
      "text": "나의 친애하는 [VAR 0x0100(0000)]!\\n잘 지내고 있니?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
