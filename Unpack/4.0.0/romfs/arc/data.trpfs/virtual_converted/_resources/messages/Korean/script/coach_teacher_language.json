      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_language_sp02_07",
      "hash64": "3A94FC6D2A2848E3",
      "text": "Oh~ 노노~ [VAR 0x0100(0000)]!\\n질문이 살짝 어려웠나?[VAR 0x0114(0026)]",
