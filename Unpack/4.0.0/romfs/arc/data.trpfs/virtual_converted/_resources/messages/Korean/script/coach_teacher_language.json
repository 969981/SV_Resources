      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 46,
      "label": "coach_teacher_language_trade_02_02",
      "hash64": "167949CEF5877ED4",
      "text": "희귀한 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
