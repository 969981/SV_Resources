    {
      "ordinal": 11,
      "label": "common_1305_rival_03",
      "hash64": "5BB1AAD73F701A2F",
      "text": "派帕，你還好嗎？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
