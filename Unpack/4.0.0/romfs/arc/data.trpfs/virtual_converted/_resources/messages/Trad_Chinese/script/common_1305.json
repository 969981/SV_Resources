          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_1305_friend_07",
      "hash64": "478BA95794896991",
      "text": "雖然[VAR 0x1107(00FF,0101)]她他是假的，但那心意卻是真的……\\n所以，我啊……總覺得……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0101"
