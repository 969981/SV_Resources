          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_1305_friend_08",
      "hash64": "478BA25794895DAC",
      "text": "抱歉……我也不知道。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
