      "hash64": "67C044C4FD7D238D",
      "text": "但她一定正在古代\\n開心地冒險吧。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
