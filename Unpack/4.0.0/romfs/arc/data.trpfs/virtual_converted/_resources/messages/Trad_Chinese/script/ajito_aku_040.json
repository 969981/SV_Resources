        }
      ]
    },
    {
      "ordinal": 24,
      "label": "ajito_aku_040_select_01",
      "hash64": "36FB30E5FE02D53E",
      "text": "是的",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "ajito_aku_040_select_02",
      "hash64": "36FB2FE5FE02D38B",
      "text": "不是",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "ajito_aku_040_akuboss_14",
      "hash64": "B7BD032A84205C6A",
      "text": "哦……\\n[VAR 0x1100(00FF,0101)]你妳到學院上學，覺得快樂嗎？[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "ajito_aku_040_select_03",
      "hash64": "36FB2EE5FE02D1D8",
      "text": "很快樂",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "ajito_aku_040_select_04",
      "hash64": "36FB35E5FE02DDBD",
      "text": "不快樂",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "ajito_aku_040_akuboss_15",
      "hash64": "B7BD042A84205E1D",
      "text": "哦～這樣啊……[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "ajito_aku_040_nelke_01",
      "hash64": "141F57B4A3D0E657",
      "text": "你就是皮拿嗎？[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "ajito_aku_040_akuboss_16",
      "hash64": "B7BD012A84205904",
      "text": "髮型酷炫的不速之客？\\n以寶可夢的招式來說，就像是惡意追擊？[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "ajito_aku_040_nelke_02",
      "hash64": "141F58B4A3D0E80A",
      "text": "我想和你稍微談談。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_aku_040_akuboss_17",
      "hash64": "B7BD022A84205AB7",
      "text": "……總覺得怪麻煩的。\\n但反正我閒下來了，ＯＫ喔。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
