      "label": "ajito_aku_040_akuboss_01",
      "hash64": "B7C0842A84236D74",
      "text": "嗯，差不多就這樣吧……[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
