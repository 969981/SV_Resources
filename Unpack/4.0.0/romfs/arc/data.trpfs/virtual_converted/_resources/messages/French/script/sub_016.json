      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_016_system_release_06",
      "hash64": "0D38A5AA29FEC5FC",
      "text": "On dirait que le sanctuaire ne s’ouvrira plus\\npendant quelque temps...",
      "flags": 4,
