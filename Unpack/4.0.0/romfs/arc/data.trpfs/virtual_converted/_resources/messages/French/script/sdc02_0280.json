          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
