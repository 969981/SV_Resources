          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0280_brother_10",
      "hash64": "0E3301867BED411B",
      "text": "Tu pouvais pas l[VAR 0x1100(00FF,0101)]ea blairer au début, mais il t’a\\nfallu quoi... deux secondes pour l[VAR 0x1100(00FF,0101)]ea kiffer ?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
