          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0280_brother_07",
      "hash64": "0E2F76867BEA1F13",
      "text": "Tu perds jamais tes combats ! Tu peux aller où tu\\nveux ! Tu t’fais des potes en claquant des doigts ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0280_brother_08",
      "hash64": "0E2F83867BEA352A",
      "text": "Même Ogerpon a préféré te suivre, alors que\\nj’rêvais d’être son ami depuis tout petit... ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0280_sister_04",
      "hash64": "A7F74527883304FA",
      "text": "Mais tu fais toujours de ton mieux, Kass !\\nC’est ça, qui compte ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0280_brother_09",
      "hash64": "0E2F84867BEA36DD",
      "text": "Commence même pas, Roseille !\\nToi aussi, tu fais partie du problème ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
