          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0280_brother_02",
      "hash64": "0E2F79867BEA242C",
      "text": "Ce joyau...\\nC’est ça, le trésor enfoui... ?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
