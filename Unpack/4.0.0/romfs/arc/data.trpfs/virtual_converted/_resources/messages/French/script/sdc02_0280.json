    },
    {
      "ordinal": 7,
      "label": "sdc02_0280_brother_04",
      "hash64": "0E2F77867BEA20C6",
      "text": "J’pourrai enfin gagner contre [VAR 0x0100(0000)] !!![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
