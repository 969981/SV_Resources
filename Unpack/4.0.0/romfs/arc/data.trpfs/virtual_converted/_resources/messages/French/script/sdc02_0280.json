          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0280_sister_03",
      "hash64": "A7F740278832FC7B",
      "text": "Kass ! Me dis pas que t’es encore bloqué\\nlà-dessus ?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
