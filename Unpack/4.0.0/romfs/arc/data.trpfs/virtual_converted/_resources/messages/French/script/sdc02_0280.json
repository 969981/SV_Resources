          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0280_brother_03",
      "hash64": "0E2F7A867BEA25DF",
      "text": "Si je capture le trésor enfoui d’la Zone Zéro...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
