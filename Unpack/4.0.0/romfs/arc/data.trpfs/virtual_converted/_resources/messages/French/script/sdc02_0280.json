    },
    {
      "ordinal": 1,
      "label": "sdc02_0280_sister_02",
      "hash64": "A7F73F278832FAC8",
      "text": "L’atmosphère ici est complètement différente...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
