      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0280_brother_06",
      "hash64": "0E2F75867BEA1D60",
      "text": "[VAR 0x0100(0000)]... Tout ce que je ressens quand\\nje te vois... c’est d’la pure jalousie ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
