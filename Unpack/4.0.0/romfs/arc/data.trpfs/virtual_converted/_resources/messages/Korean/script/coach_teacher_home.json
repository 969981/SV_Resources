    {
      "ordinal": 54,
      "label": "coach_teacher_home_battleend_win_00_01",
      "hash64": "2C3FE7C528BC47E2",
      "text": "과연, 챔피언.\\n성장하는 폭의 차원이 다르군.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
