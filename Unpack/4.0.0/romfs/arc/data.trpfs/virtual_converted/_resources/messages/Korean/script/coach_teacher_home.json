          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_home_sp01_00",
      "hash64": "08417CABC4CB6A50",
      "text": "[VAR 0x0100(0000)], 역시 자네였군.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_home_sp01_01",
      "hash64": "08417DABC4CB6C03",
      "text": "유학지에서 좋은 성적을 기록해서\\n인재를 불러 모으는 일을 맡게 된\\r\\n대단한 학생이 있다고 들었거든.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_home_sp01_02",
      "hash64": "08417EABC4CB6DB6",
      "text": "어떤 대단한 인물인가 했는데\\n그 정체가 자네라면 납득이 가는군.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_home_sp01_select_01",
      "hash64": "56C5850AFD03903A",
      "text": "감사합니다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_home_sp01_select_02",
      "hash64": "56C5840AFD038E87",
      "text": "그렇죠?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_home_sp01_03",
      "hash64": "08417FABC4CB6F69",
      "text": "훗... 그 솔직함이\\n성공의 비결인 건가?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_home_sp01_03b",
      "hash64": "D2BAFBDF65ADAFB1",
      "text": "훗... 그 장난기가\\n성공의 비결인 건가?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_home_sp01_04",
      "hash64": "084180ABC4CB711C",
      "text": "제자가 대성한 모습을 보는 건\\n나에게도 매우 기쁜 일이다.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_home_sp01_05",
      "hash64": "084181ABC4CB72CF",
      "text": "자네에게 지지 않도록\\n나도 이 아카데미에서 최선을 다하마.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_home_sp02_00",
      "hash64": "35FB06B227A63AFF",
      "text": "[VAR 0x0100(0000)], 잠깐 괜찮나?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_home_sp02_01",
      "hash64": "35FB05B227A6394C",
      "text": "나도 스마트폰 커버를 사서\\n장착해 봤는데...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_home_sp02_02",
      "hash64": "35FB08B227A63E65",
      "text": "이렇게 장착하는 게 맞나?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_home_sp02_select_01",
      "hash64": "3465931329A1841B",
      "text": "맞아요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_home_sp02_select_02",
      "hash64": "3465941329A185CE",
      "text": "귀엽네요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_home_sp02_select_03",
      "hash64": "3465951329A18781",
      "text": "페퍼랑 똑같은 거네요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_home_sp02_03",
      "hash64": "35FB07B227A63CB2",
      "text": "그렇다면 다행이군!\\n이런 걸 해 보는 게 처음이라...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_home_sp02_03b",
      "hash64": "5FCAE3B95F795570",
      "text": "호오! 그래!?\\n자네도 그렇게 생각하나!?\\r\\n정말이지, 내 마음에 쏙 드는 케이스야![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_home_sp02_03c",
      "hash64": "5FCAE4B95F795723",
      "text": "호오? 페퍼 청년과 같은 케이스라고?\\n그 친구도 참 보는 눈이 있는걸![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_home_sp02_04",
      "hash64": "35FB02B227A63433",
      "text": "이 꽃무늬 커버를 사기 위해\\n온 상점을 돌아다녔는데\\r\\n알고 보니, 카라프시티에서만 파는 것이더군.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_home_sp02_05",
      "hash64": "35FB01B227A63280",
      "text": "그래도, 좋은 물건을 손에 넣어서\\n아주 만족하고 있다.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_home_sp03_00",
      "hash64": "8C60D0B9C30FFB6E",
      "text": "[VAR 0x0100(0000)], 자네 그거 아나?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_home_sp03_01",
      "hash64": "8C60D1B9C30FFD21",
      "text": "테라리움 돔에 마빌크라는\\n크림포켓몬이 있더군.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_home_sp03_02",
      "hash64": "8C60CEB9C30FF808",
      "text": "사랑스러운 모습을 하고 있는 건 물론이고\\n몸에서 나오는 달콤~한 향기가\\r\\n이루 말할 수 없을 정도로 매력적이었지...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_home_sp03_03",
      "hash64": "8C60CFB9C30FF9BB",
      "text": "자네는 마빌크의\\n독특한 진화 방법에 대해 알고 있나?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_home_sp03_select_01",
      "hash64": "A71868C0337C82E0",
      "text": "빙글빙글 돌기",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_home_sp03_select_02",
      "hash64": "A7186BC0337C87F9",
      "text": "귀엽다고 칭찬하기",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_home_sp03_select_03",
      "hash64": "A7186AC0337C8646",
      "text": "달콤한 것을 먹이기",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_home_sp03_04",
      "hash64": "8C60D4B9C310023A",
      "text": "훌륭한 답변이군, [VAR 0x0100(0000)].\\n이미 시도해 본 건가?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_home_sp03_04b",
      "hash64": "988BCFA67433FB88",
      "text": "“옳지, 옳지! 아이구 귀여워라~”하고\\n칭찬해 주면 서로 흐뭇해지긴 하겠다만,\\r\\n그런다고 진화하지는 않는다.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_home_sp03_04c",
      "hash64": "988BD0A67433FD3B",
      "text": "음~! 함께 땅콩버터 샌드위치를 먹으면\\n맛있어서 진화~!\\r\\n...같은 일은 일어나지 않는다![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_home_sp03_05",
      "hash64": "8C60D5B9C31003ED",
      "text": "마빌크를 마휘핑으로 진화시킬 거라면\\n지닌 포켓몬에 넣고\\r\\n빙글빙글 돌아 보는 거다![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_teacher_home_sp03_06",
      "hash64": "8C60D2B9C30FFED4",
      "text": "그리하면 크림이 섞이면서\\n폭신폭신한 마휘핑이 될 거다.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
