    },
    {
      "ordinal": 56,
      "label": "coach_teacher_home_battleend_win_00_03",
      "hash64": "2C3FE5C528BC447C",
      "text": "새콤한 것을 먹으면\\n피로가 회복될 거다.[VAR 0x0114(0029)]",
