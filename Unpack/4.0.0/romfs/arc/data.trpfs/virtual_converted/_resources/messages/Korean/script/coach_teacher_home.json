          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "coach_teacher_home_trade_02_01",
      "hash64": "B75AB73A7ED6C214",
      "text": "어버이가 자신이 아닌 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 44,
      "label": "coach_teacher_home_trade_02_02",
      "hash64": "B75ABA3A7ED6C72D",
      "text": "희귀한 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "coach_teacher_home_trade_02_03",
      "hash64": "B75AB93A7ED6C57A",
      "text": "색이 다른 포켓몬은\\n교환할 수 없습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 46,
      "label": "coach_teacher_home_trade_03_00",
      "hash64": "0F06E2421B55E9F6",
      "text": "...지닌 포켓몬이 1마리뿐이면\\n교환을 할 수 없네.\\c\\n2마리 이상을 데려온 뒤에\\n다시 하지 않겠나?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
