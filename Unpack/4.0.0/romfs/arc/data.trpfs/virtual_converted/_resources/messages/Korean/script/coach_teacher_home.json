      ]
    },
    {
      "ordinal": 51,
      "label": "coach_teacher_home_battlestart_00",
      "hash64": "6D8C5A8016A23818",
      "text": "기꺼이 상대해 주지.\\n나의 실력을 보여 주마![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
