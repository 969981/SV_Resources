    {
      "ordinal": 55,
      "label": "coach_teacher_home_battleend_win_00_02",
      "hash64": "2C3FE6C528BC462F",
      "text": "승부를 해서 많이 지쳤을 테니\\n이것을 주마.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
