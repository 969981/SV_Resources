      "ordinal": 49,
      "label": "coach_teacher_home_talkto_00",
      "hash64": "9336FEEFF4648D81",
      "text": "우리 챔피언께서\\n승부를 원하는 건가?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
