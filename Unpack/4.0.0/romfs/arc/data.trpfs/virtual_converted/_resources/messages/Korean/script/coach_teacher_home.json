    {
      "ordinal": 0,
      "label": "coach_teacher_home_first_00",
      "hash64": "EBABC513F7C8498C",
      "text": "팔데아의 아카데미에서 왔다.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
