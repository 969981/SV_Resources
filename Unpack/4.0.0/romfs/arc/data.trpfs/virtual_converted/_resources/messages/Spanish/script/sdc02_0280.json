    {
      "ordinal": 21,
      "label": "sdc02_0280_bbteacher_03",
      "hash64": "274105330CE8260F",
      "text": "¡Sí, debe de ser ese cristal! ¡No me cabe duda![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
