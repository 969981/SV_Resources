    },
    {
      "ordinal": 2,
      "label": "sdc02_0280_brother_01",
      "hash64": "0E2F7C867BEA2945",
      "text": "El tesoro oculto... ¡¿Dónde está?![VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
