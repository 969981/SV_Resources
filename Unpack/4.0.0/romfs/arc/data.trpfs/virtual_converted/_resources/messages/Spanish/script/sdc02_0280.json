          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0280_bbteacher_01",
      "hash64": "274107330CE82975",
      "text": "¡Allí, Cass! ¡Hay algo en los cristales del fondo![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0280_brother_02",
      "hash64": "0E2F79867BEA242C",
      "text": "¿Este cristal es... el tesoro oculto?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
