          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0280_sister_03",
      "hash64": "A7F740278832FC7B",
      "text": "Hay que ver, enano. ¿Aún sigues con esa\\ncantinela?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0280_brother_05",
      "hash64": "0E2F78867BEA2279",
      "text": "¡No te metas en esto, Corin![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0280_brother_06",
      "hash64": "0E2F75867BEA1D60",
      "text": "¿No lo ves? Lo único que siento cuando tengo\\ndelante a [VAR 0x0100(0000)]... ¡es envidia![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0280_brother_07",
      "hash64": "0E2F76867BEA1F13",
      "text": "¡Es un hacha en los combates! ¡Puede ir adonde\\nle dé la gana! ¡¡Y todos quieren ser sus amigos!![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0280_brother_08",
      "hash64": "0E2F83867BEA352A",
      "text": "¡Hasta Ogerpon prefirió irse con [VAR 0x1100(00FF,0402)]élella antes que\\nconmigo, y eso que yo llevaba queriendo ser su\\r\\namigo desde que era pequeño![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0402"
          ]
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0280_sister_04",
      "hash64": "A7F74527883304FA",
      "text": "Pero, enano... Tú hiciste todo lo que pudiste.\\n¡No tienes por qué avergonzarte![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0280_brother_09",
      "hash64": "0E2F84867BEA36DD",
      "text": "¡Mejor cállate, que tú tampoco te salvas![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0280_brother_10",
      "hash64": "0E3301867BED411B",
      "text": "¡Al principio no l[VAR 0x1100(00FF,0101)]oa tragabas, ¿te acuerdas?!\\nY un día, de pronto... ¡Enga, amiguit[VAR 0x1100(00FF,0101)]oas del alma![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
