      "ordinal": 32,
      "label": "msg_ui_btlteam_top_error_15",
      "hash64": "FC034A2C3F5F7E37",
      "text": "可以租用\\n其他人的隊伍。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "msg_ui_btlteam_top_error_16",
      "hash64": "FC034B2C3F5F7FEA",
      "text": "正在等待連線……\\n請稍候片刻。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "msg_ui_btlteam_top_error_17",
      "hash64": "FC034C2C3F5F819D",
      "text": "無法使用租用隊伍。\\c",
