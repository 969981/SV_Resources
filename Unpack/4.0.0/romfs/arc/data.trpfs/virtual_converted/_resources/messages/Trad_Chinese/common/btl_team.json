        }
      ]
    },
    {
      "ordinal": 14,
      "label": "msg_ui_btlteam_top_decision_01",
      "hash64": "C99652D65E273E62",
      "text": "登錄到大賽後，\\n對戰隊伍將會被鎖定。\\c\\n鎖定後，將無法移動和交換\\n對戰隊伍中的寶可夢，\\r\\n或是替換持有物。\\c\\n確定要登錄\\n[VAR 0x01BF(0000)]嗎？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
