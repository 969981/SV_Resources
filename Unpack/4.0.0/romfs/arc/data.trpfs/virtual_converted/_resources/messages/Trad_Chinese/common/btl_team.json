    {
      "ordinal": 13,
      "label": "msg_ui_btlteam_top_decision_00",
      "hash64": "C99653D65E274015",
      "text": "確定要用[VAR 0x01BF(0000)]嗎？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
