          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "msg_ui_btlteam_top_error_18",
      "hash64": "FC033D2C3F5F6820",
      "text": "隊伍中有寶可夢\\n沒有對戰規則標記。\\c",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "msg_ui_btlteam_top_error_19",
      "hash64": "FC033E2C3F5F69D3",
      "text": "太晶屬性是星晶的寶可夢\\n無法參加對戰。\\c",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
