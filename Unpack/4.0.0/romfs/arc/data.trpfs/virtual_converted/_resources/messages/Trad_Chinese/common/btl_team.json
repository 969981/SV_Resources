      "ordinal": 31,
      "label": "msg_ui_btlteam_top_error_14",
      "hash64": "FC03492C3F5F7C84",
      "text": "這支對戰隊伍沒有問題。\\c",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
