    },
    {
      "ordinal": 2,
      "label": "gym_denki_015_denki_01",
      "hash64": "E12A2F57CA10E111",
      "text": "Yeaaah ![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
