    {
      "ordinal": 0,
      "label": "gym_denki_015_receptionist_01",
      "hash64": "6D0B8D6CEA518AD5",
      "text": "Les modalités de l’examen vous paraîtront plus\\nclaires quand vous y serez.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "gym_denki_015_denki_00",
      "hash64": "E12A2E57CA10DF5E",
      "text": "Et voici l’moment que vous attendiez tous !\\nC’est l’heure deeeees...\\r\\nMachins de Mashynn !!![VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
