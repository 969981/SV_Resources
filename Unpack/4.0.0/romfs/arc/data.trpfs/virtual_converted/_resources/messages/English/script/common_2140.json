      ]
    },
    {
      "ordinal": 4,
      "label": "common_2140_top_02",
      "hash64": "9A17D86E1A2F5757",
      "text": "I had a feeling I would meet you in the finals.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2140_top_03",
      "hash64": "9A17D76E1A2F55A4",
      "text": "Honed strength against honed strength...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
