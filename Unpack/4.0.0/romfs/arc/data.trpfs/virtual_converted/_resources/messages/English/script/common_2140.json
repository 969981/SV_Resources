          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2140_announce_02",
      "hash64": "8D4FA48FFBF47771",
      "text": "It’s Champion [VAR 0x0100(0000)] up against...",
