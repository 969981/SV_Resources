      "label": "common_2140_top_01",
      "hash64": "9A17D96E1A2F590A",
      "text": "Good day, Champion [VAR 0x0100(0000)].[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
