    {
      "ordinal": 2,
      "label": "common_2140_announce_03",
      "hash64": "8D4FA38FFBF475BE",
      "text": "a special guest joining our tournament, the Top\\nChampion, Geeta!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
