          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2140_top_04",
      "hash64": "9A17D66E1A2F53F1",
      "text": "Such a clash is what captures the crowd...and\\nmakes their hearts race.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2140_top_05",
      "hash64": "9A17D56E1A2F523E",
      "text": "This is extremely close to what I would call my\\nideal world.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2140_top_06",
      "hash64": "9A17D46E1A2F508B",
      "text": "As the chairperson for both the Pokémon League\\nand the academy...[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2140_top_07",
      "hash64": "9A17D36E1A2F4ED8",
      "text": "I find this situation to be incredibly satisfying.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
