      "ordinal": 0,
      "label": "common_2140_announce_01",
      "hash64": "8D4FA18FFBF47258",
      "text": "There’s one last match in this tournament, ladies\\nand gentlemen...\\c\\nAllow me to introduce the two Trainers who’ll\\nbe facing off to finally determine who’s strongest\\r\\nin the academy!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
