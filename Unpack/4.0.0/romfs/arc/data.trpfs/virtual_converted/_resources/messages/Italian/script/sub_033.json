      ]
    },
    {
      "ordinal": 10,
      "label": "sub_033_select_01",
      "hash64": "742C174E87DE7A19",
      "text": "Assolutamente!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_033_select_02",
      "hash64": "742C144E87DE7500",
      "text": "Mah, non saprei...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_033_ecology_10",
      "hash64": "A5FA8C4293C9589D",
      "text": "Mmmh... Mi sembri fin troppo arrendevole.\\nSpero che tu mi stia dicendo la verità...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_033_ecology_11",
      "hash64": "A5FA8B4293C956EA",
      "text": "Guarda che dico sul serio! Non ti sto chiedendo\\ndi leggere tra le righe: fa’ come ti dico![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_033_ecology_12",
      "hash64": "A5FA8A4293C95537",
      "text": "Mi dispiace averti chiesto una mano per poi dirti\\ndi tenerti alla larga, ma è troppo pericoloso...\\r\\nMi raccomando: stai alla larga dai cristalli neri![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
