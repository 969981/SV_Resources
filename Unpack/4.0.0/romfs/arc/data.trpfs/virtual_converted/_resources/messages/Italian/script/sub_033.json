          "offset_units": 152,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sub_033_ecology_13",
      "hash64": "A5FA894293C95384",
      "text": "Beh, allora conto su di te![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
