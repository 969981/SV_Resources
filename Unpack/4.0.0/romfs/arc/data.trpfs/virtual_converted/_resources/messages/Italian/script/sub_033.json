            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_033_ecology_06",
      "hash64": "A5F7044293C63BAE",
      "text": "I Pokémon Teracristal che si incontrano in quei\\nraid sono straordinariamente potenti...[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_033_ecology_07",
      "hash64": "A5F7054293C63D61",
      "text": "Un Allenatore qualunque non avrebbe alcuna\\nsperanza.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
