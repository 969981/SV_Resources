          "offset_units": 127,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
