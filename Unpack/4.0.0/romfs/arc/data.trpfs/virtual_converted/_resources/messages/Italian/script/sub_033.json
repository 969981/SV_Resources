          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_033_ecology_08",
      "hash64": "A5F6FE4293C6317C",
      "text": "So che tu sei fatt[VAR 0x1100(00FF,0101)]oa di una stoffa diversa, ma\\npotrebbe essere pericoloso anche per te...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
