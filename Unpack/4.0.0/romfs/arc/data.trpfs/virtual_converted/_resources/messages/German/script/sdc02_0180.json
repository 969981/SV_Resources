        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0180_dragonbb_03",
      "hash64": "6A5BBAE1902FB17F",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)]... Du und Jo habt\\neuch\\r\\ndoch\\r\\nangeblich\\r\\ngut\\r\\nverstanden, stimmt’s?[VAR 0x0114(004A)]",
      "flags": 0,
