    },
    {
      "ordinal": 2,
      "label": "sdc02_0180_reception_01",
      "hash64": "B94DB1F7E154384B",
      "text": "Dein Name war [VAR 0x0100(0000)], richtig?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0180_reception_02",
      "hash64": "B94DB2F7E15439FE",
      "text": "Okay, ich kümmere mich um die Anmeldung\\nfür deinen Kampf gegen den Champ.\\r\\nBitte warte einen Augenblick...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
