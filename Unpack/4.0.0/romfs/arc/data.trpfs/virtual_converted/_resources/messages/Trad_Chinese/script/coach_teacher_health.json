      "label": "coach_teacher_health_sp02_02",
      "hash64": "8ED007D10C367008",
      "text": "上課的過程\\n一切都很順利喔？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
