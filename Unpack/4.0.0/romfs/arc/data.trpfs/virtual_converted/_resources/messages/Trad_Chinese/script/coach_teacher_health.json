          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_health_sp02_05",
      "hash64": "8ED00ED10C367BED",
      "text": "啊～我不想再說這個了！\\n想起來就覺得丟臉！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_health_sp02_06",
      "hash64": "8ED00BD10C3676D4",
      "text": "討厭的事就忘了吧，\\n只要記住下次別再犯就是了！[VAR 0x0114(0028)]",
