      "label": "coach_teacher_health_sp02_04b",
      "hash64": "E201D237C091E388",
      "text": "不……怎麼可能？\\n有人安慰我，我是很開心，\\r\\n但在學院也不會發生這種事吧？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
