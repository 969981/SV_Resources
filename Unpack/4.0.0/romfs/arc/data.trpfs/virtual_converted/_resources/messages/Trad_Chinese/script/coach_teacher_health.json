    },
    {
      "ordinal": 24,
      "label": "coach_teacher_health_sp03_03",
      "hash64": "386A40C970CCB4B2",
      "text": "雖然對我來說，弄錯班級這件事\\n是不堪回首的黑歷史……[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
