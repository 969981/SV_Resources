      ]
    },
    {
      "ordinal": 1,
      "label": "class_g_03_home_02",
      "hash64": "160D28AC1FC18902",
      "text": "El otro día hablamos sobre métodos para\\nrestaurar la salud del equipo.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
