          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_g_03_home_04",
      "hash64": "160D22AC1FC17ED0",
      "text": "Cuando un Pokémon pierde todos sus PS,\\nse debilita y no puede seguir combatiendo.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_g_03_home_05",
      "hash64": "160D23AC1FC18083",
      "text": "¿Pero qué le ocurre cuando se queda sin PP?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_g_03_select_01",
      "hash64": "DB0694D3DE259316",
      "text": "No puede usar movimientos",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "class_g_03_select_02",
      "hash64": "DB0693D3DE259163",
      "text": "Deja de obedecer a su Entrenador",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "class_g_03_select_03",
      "hash64": "DB0692D3DE258FB0",
      "text": "Se le reducen todas las características",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_g_03_home_answer_01",
      "hash64": "8EEEDB593E4FB2B8",
      "text": "¡Correcto! Muy bien.\\c\\nSuena a que hablas por experiencia propia,\\n[VAR 0x0100(0000)].[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_g_03_home_answer_02",
      "hash64": "8EEEDE593E4FB7D1",
      "text": "Eso sería peligroso, sí, pero no es correcto.\\c\\nLo que determina si un Pokémon te obedece o\\nno son las Medallas de Gimnasio que tengas.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_g_03_home_answer_03",
      "hash64": "8EEEDD593E4FB61E",
      "text": "Eso sería peligroso, sí, pero no es correcto.\\c\\nPor mucho que se llamen Puntos de Poder, no\\ntienen ese poder concreto.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_g_03_home_06",
      "hash64": "160D24AC1FC18236",
      "text": "Cuando un Pokémon se queda sin PP, no puede\\nseguir usando movimientos.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_g_03_home_07",
      "hash64": "160D25AC1FC183E9",
      "text": "Cada movimiento tiene asignado un número de\\nPP concreto, así que es mejor ir variando su uso.\\c\\nDe esta forma, se reparte la pérdida de PP y se\\nminimiza el riesgo de agotarlos.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 177,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_g_03_home_08",
      "hash64": "160D2EAC1FC19334",
      "text": "Una vez que un Pokémon ha agotado los PP de\\ntodos sus movimientos, la única opción que le\\r\\nqueda es usar Forcejeo.\\c\\nEsta técnica, sin embargo, también daña al\\nusuario.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 171,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_g_03_home_09",
      "hash64": "160D2FAC1FC194E7",
      "text": "Para evitar este tipo de situaciones, lo mejor es\\nvisitar un Centro Pokémon.\\c\\nAllí, vuestro equipo recuperará la totalidad tanto\\nde sus PS como de sus PP.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 156,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_g_03_home_10",
      "hash64": "16102CAC1FC3C5A5",
      "text": "También existen objetos que permiten recuperar\\nPP, como el Éter o el Éter Máximo.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_g_03_home_11",
      "hash64": "16102BAC1FC3C3F2",
      "text": "Pero no los venden en las tiendas, así que no\\nuséis a la ligera los que vayáis encontrando.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_g_03_home_12",
      "hash64": "16102AAC1FC3C23F",
      "text": "Cuanto más potente es un movimiento, menos\\nPP tiene asignados.\\c\\nSi los empleáis sin ton ni son, los agotaréis en un\\nperiquete. Por lo tanto, es importante usar los\\r\\nmovimientos de forma equilibrada.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 165,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 202,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_g_03_home_13",
      "hash64": "161029AC1FC3C08C",
      "text": "Como veis, los PS no son lo único que debéis\\ntener en cuenta al emprender aventuras con\\r\\nvuestros Pokémon.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_g_03_home_14",
      "hash64": "161028AC1FC3BED9",
      "text": "Espero que prosigáis con la búsqueda del tesoro\\nhaciendo todo lo posible para que vuestros\\r\\ncompañeros puedan dar lo mejor de sí.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_g_03_home_15",
      "hash64": "161027AC1FC3BD26",
      "text": "La clase ha terminado por hoy.\\c\\nEl próximo día toca examen, así que no olvidéis\\nrepasar bien el temario.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
