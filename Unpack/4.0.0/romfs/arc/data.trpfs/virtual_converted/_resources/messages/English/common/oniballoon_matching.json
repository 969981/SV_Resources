      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "oniballoon_matching_msg_02_00",
      "hash64": "7719798DA1EC3CC2",
      "text": "Do you want to disband the team?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "oniballoon_matching_msg_03_00",
      "hash64": "1F6D2F86056CE033",
      "text": "One or more members of your team are not\\nready yet. Please wait a bit before departing.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
