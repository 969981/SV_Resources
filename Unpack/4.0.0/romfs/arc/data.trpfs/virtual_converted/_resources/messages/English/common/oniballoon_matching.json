      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "oniballoon_matching_con_00_01",
      "hash64": "79E59B9EB0672DF2",
      "text": "No",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "oniballoon_entrynpc_01",
      "hash64": "4B3DD23D885F6D3A",
      "text": "Welcome! You here for some Ogre Oustin’?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "oniballoon_entrynpc_02",
      "hash64": "4B3DD13D885F6B87",
      "text": "Let’s get you on out there so you can start oustin’\\nsome ogres!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "oniballoon_entrynpc_03",
      "hash64": "4B3DD03D885F69D4",
      "text": "Come on back any time, ya hear?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "oniballoon_entrynpc_04",
      "hash64": "4B3DCF3D885F6821",
      "text": "Congrats on gettin’ through all the easy stages!\\nTake these to commemorate your first time\\r\\nclearin’ that difficulty level!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "oniballoon_entrynpc_05",
      "hash64": "4B3DCE3D885F666E",
      "text": "You did a mighty fine job out there. I bet you’ll\\nbe able to handle the normal stages now!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "oniballoon_entrynpc_06",
      "hash64": "4B3DCD3D885F64BB",
      "text": "Congrats on gettin’ through all the normal stages!\\nTake these to commemorate your first time\\r\\nclearin’ that difficulty level!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "oniballoon_entrynpc_07",
      "hash64": "4B3DCC3D885F6308",
      "text": "You did a mighty fine job out there. I bet you’ll\\nbe able to handle the hard stages now!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 47,
      "label": "oniballoon_entrynpc_08",
      "hash64": "4B3DCB3D885F6155",
      "text": "Congrats on getting through all the hard stages!\\nDefinitely doesn’t happen every day!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 48,
      "label": "oniballoon_entrynpc_08_2",
      "hash64": "925FF7862C6613A4",
      "text": "I reckon you might be the right Trainer to handle\\nthat Pokémon...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 49,
      "label": "oniballoon_entrynpc_08_3",
      "hash64": "925FF8862C661557",
      "text": "Every time we started Ogre Oustin’, it’d draw\\nin a Munchlax from ’round here...and boy, it\\r\\nhad quite an appetite!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "oniballoon_entrynpc_08_4",
      "hash64": "925FF5862C66103E",
      "text": "Matter o’ fact, the game would get a whole\\nlot harder while it was around...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "oniballoon_entrynpc_08_5",
      "hash64": "925FF6862C6611F1",
      "text": "So yeah, I was thinkin’ you should take it\\nwith you!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "oniballoon_entrynpc_08_6",
      "hash64": "925FF3862C660CD8",
      "text": "You got a Munchlax from the lady!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "oniballoon_entrynpc_09",
      "hash64": "4B3DCA3D885F5FA2",
      "text": "Uh-oh! Your Boxes are full, huh? Why don’t you\\ncome on back after doing a little housekeepin’?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 54,
      "label": "oniballoon_entrynpc_10",
      "hash64": "4B3A4D3D885C5564",
      "text": "I’ll have a go",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "oniballoon_entrynpc_11",
      "hash64": "4B3A4E3D885C5717",
      "text": "About that Munchlax...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 56,
      "label": "oniballoon_entrynpc_12",
      "hash64": "4B3A4F3D885C58CA",
      "text": "Oh yeah, the Munchlax! Here ya go—for real,\\nthis time!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 57,
