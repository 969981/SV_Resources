          "args_hex": [
            "000B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_1060_hakase_02b",
      "hash64": "C97ABA94F4068ABB",
      "text": "这个设施建于８７年前，\\n是为了调查第零区所设的中继站。[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
