    },
    {
      "ordinal": 4,
      "label": "common_1060_hakase_02a",
      "hash64": "C97ABB94F4068C6E",
      "text": "这个设施建于８７年前，\\n是为了调查第零区所设的中继站。[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
