      ]
    },
    {
      "ordinal": 7,
      "label": "common_1060_rival_03",
      "hash64": "9E29F25EEB9281C3",
      "text": "要是我们都累了，\\n似乎也能在这儿休息一下呢！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
