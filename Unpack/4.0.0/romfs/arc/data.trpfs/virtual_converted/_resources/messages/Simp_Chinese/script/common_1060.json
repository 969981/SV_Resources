      ]
    },
    {
      "ordinal": 1,
      "label": "common_1060_botan_01",
      "hash64": "CBDD8A2957AE6963",
      "text": "……然而看起来\\n一点都不老旧。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
