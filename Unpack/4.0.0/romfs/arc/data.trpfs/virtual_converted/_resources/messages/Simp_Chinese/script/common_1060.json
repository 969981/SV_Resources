          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_1060_hakase_01a",
      "hash64": "C97DA394F408997D",
      "text": "你们似乎已经顺利抵达\\n第１个观测站了啊。[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000B"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_1060_hakase_01b",
      "hash64": "C97DA094F4089464",
      "text": "你们似乎已经顺利抵达\\n第１个观测站了啊。[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
