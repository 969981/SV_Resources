      ]
    },
    {
      "ordinal": 36,
      "label": "team_0110_cassiopeia_13",
      "hash64": "ED0E5C614AF59858",
      "text": "就是本人。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
