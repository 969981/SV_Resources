      ]
    },
    {
      "ordinal": 45,
      "label": "team_0110_nelke_04",
      "hash64": "AAF266C21941D70C",
      "text": "本来我觉得这不太可能，\\n但没想到仙后竟然是真老大……\\r\\n而且，仙后的真实身份恐怕是……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
