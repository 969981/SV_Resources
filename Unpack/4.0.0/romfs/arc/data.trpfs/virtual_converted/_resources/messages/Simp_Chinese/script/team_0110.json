          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "team_0110_cassiopeia_15",
      "hash64": "ED0E62614AF5A28A",
      "text": "我原本也不想一直瞒着你们，\\n但总是没机会说出来。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0110_cassiopeia_16",
      "hash64": "ED0E61614AF5A0D7",
      "text": "组建天星队的人是我。\\n所有队员都曾是我的伙伴，\\r\\n也曾是我无可取代的宝物。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0110_cassiopeia_17",
      "hash64": "ED0E60614AF59F24",
      "text": "但是现在的天星队\\n只会为大家带来不幸……[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "team_0110_cassiopeia_18",
      "hash64": "ED0E57614AF58FD9",
      "text": "所以我才想按照规矩\\n解散天星队，好让大家死心。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
