    {
      "ordinal": 20,
      "label": "schoolmap_2_1",
      "hash64": "60396BBCAB779DC0",
      "text": "オレンジアカデミーの玄関\\n受付から　授業を　受けることが　できる",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "schoolmap_2_18",
      "hash64": "F93009975C416C68",
      "text": "グレープアカデミーの玄関\\n受付から　授業を　受けることが　できる",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "schoolmap_2_2",
      "hash64": "60396EBCAB77A2D9",
      "text": "[VAR 0x0100(0000)]の部屋\\n学校にある　もうひとつの　自分の部屋",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
