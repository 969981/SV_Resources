          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "schoolmap_2_3",
      "hash64": "60396DBCAB77A126",
      "text": "ネモの部屋\\nきちんと　整理整とん　されている",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "schoolmap_2_4",
      "hash64": "603970BCAB77A63F",
      "text": "ペパーの部屋\\nおいしそうな　料理の匂いが　する",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "schoolmap_2_5",
      "hash64": "60396FBCAB77A48C",
      "text": "ボタンの部屋\\n機械がいっぱいで　ちょっと　うす暗い",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "schoolmap_2_6",
      "hash64": "603972BCAB77A9A5",
      "text": "[VAR 0x0100(0000)]と　ネモの教室\\n総合コース　ジニア先生が　担任",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "schoolmap_2_7",
      "hash64": "603971BCAB77A7F2",
      "text": "ひとつうえの　２年生の教室\\n文科系コース　セイジ先生が　担任",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "schoolmap_2_19",
      "hash64": "F9300A975C416E1B",
      "text": "ペパーの教室\\n文科系コース　セイジ先生が　担任",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "schoolmap_2_8",
      "hash64": "603974BCAB77AD0B",
      "text": "別のクラスの教室\\n理科系コース　タイム先生が　担任",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "schoolmap_2_20",
      "hash64": "F93A13975C49D1EB",
      "text": "ボタンの教室\\n理科系コース　タイム先生が　担任",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "schoolmap_2_9",
      "hash64": "603973BCAB77AB58",
      "text": "校長先生の部屋\\nクラベル先生の机や　研究機材が　ある",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "schoolmap_2_10",
      "hash64": "F93001975C415ED0",
      "text": "先生たちの部屋\\nいろんな　先生たちに　会える",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "schoolmap_2_11",
      "hash64": "F93002975C416083",
      "text": "体調が悪い　生徒が　休みにくる\\nミモザ先生目的の　生徒も　多いとか",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "schoolmap_2_12",
      "hash64": "F93003975C416236",
      "text": "日用品や　道具まで　なんでも　そろう\\nパンは　ふしぎと　いつでも　焼きたて",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "schoolmap_2_13",
      "hash64": "F93004975C4163E9",
      "text": "家庭科の授業で　使われる　教室\\nピカピカの食器や　調理道具が　ならぶ",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "schoolmap_2_14",
      "hash64": "F93005975C41659C",
      "text": "生物の授業で　使われる　教室\\n顕微鏡など　実験の道具が　たくさん",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "schoolmap_2_15",
      "hash64": "F93006975C41674F",
      "text": "美術の授業で　使われる　教室\\n生徒たちの作品が　展示されている",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "schoolmap_2_16",
      "hash64": "F93007975C416902",
      "text": "食堂のおばちゃんの　手作り料理は\\n毎日　おいしくて　栄養満点",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "schoolmap_2_17",
      "hash64": "F93008975C416AB5",
      "text": "バトル学の授業で　使われる　中庭\\n運動したり　ひと休みできる　いこいの場所",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
