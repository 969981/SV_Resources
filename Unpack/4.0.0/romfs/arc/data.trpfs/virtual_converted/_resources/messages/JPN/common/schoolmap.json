      "hash64": "565E54BCA58C2F6B",
      "text": "ゼイユの教室\\nブライア先生が　担任",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "schoolmap_5_4",
      "hash64": "565E59BCA58C37EA",
      "text": "日用品や　道具まで　なんでも　そろう\\nＢＰでしか　支払えないので　注意",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
