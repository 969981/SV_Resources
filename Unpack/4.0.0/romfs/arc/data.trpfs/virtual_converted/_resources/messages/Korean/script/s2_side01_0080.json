          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0080_brother_03",
      "hash64": "91D446A7ABA8EE05",
      "text": "관리인 아저씨가 리모컨을 숨겨 둬서\\n저것밖에 못 봐...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0080_friend_03",
      "hash64": "E9A5A0D99AFB34FD",
      "text": "그럼, 리모컨을 찾아서\\n다 같이 영화 보자![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side01_0080_friend_04",
      "hash64": "E9A599D99AFB2918",
      "text": "숨겨 놨다고 해도 마을 회관\\n어딘가에는 있지 않겠어!?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side01_0080_brother_04",
      "hash64": "91D43FA7ABA8E220",
      "text": "그, 그런 거...\\n여태까지 생각조차 못 했어.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side01_0080_botan_03",
      "hash64": "726D33FC9471527D",
      "text": "찾아 보자!\\n그리고 난 큰 화면으로 게임하는 거에 한 표![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
