      "ordinal": 22,
      "label": "s2_side01_0080_friend_07",
      "hash64": "E9A59CD99AFB2E31",
      "text": "앗! 카지!\\n치사하게 먼저 출발하다니![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
