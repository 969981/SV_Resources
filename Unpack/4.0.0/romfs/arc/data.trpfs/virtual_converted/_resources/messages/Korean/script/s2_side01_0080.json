      ]
    },
    {
      "ordinal": 2,
      "label": "s2_side01_0080_brother_01",
      "hash64": "91D444A7ABA8EA9F",
      "text": "도천상점은 잘 찾아갔어?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
