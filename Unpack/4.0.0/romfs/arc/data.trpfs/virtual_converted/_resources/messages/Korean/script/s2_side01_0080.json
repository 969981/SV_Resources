      "ordinal": 23,
      "label": "s2_side01_0080_botan_npc",
      "hash64": "5F00722ED0BDE12B",
      "text": "아무리 그래도\\n화장실 안에 있진 않겠지?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
