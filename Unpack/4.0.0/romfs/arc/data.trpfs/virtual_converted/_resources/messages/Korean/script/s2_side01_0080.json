      "ordinal": 15,
      "label": "s2_side01_0080_rival_05",
      "hash64": "D973AC3B423F1A69",
      "text": "보물찾기 같고 재밌겠다!\\n흩어져서 찾아 보자![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
