          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0220_ground_10",
      "hash64": "D983454188D21203",
      "text": "Yeah, I did... [VAR 0x1100(00FF,0201)]HShe’s no pushover, let me tell you![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
