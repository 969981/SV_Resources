    {
      "ordinal": 3,
      "label": "champ_0220_ground_01",
      "hash64": "D97FE04188CF308D",
      "text": "Now then, let’s get this started, eh?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
