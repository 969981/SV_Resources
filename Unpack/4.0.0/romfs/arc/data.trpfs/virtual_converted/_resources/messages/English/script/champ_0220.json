      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0220_steel_01",
      "hash64": "9293552F48E4D169",
      "text": "Cooomiiing![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
