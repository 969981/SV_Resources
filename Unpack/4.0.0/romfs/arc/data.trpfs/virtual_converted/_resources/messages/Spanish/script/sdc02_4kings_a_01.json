    },
    {
      "ordinal": 9,
      "label": "sdc02_4kings_a_01_firebb_02",
      "hash64": "29AE1D143A61C6C0",
      "text": "¡Anda, yo a ti te vi en el comedor! Te llamabas\\n[VAR 0x0100(0000)], ¿verdad?\\c\\n¡Qué bien! ¡Este promete ser un encuentro tan\\nardiente como memorable![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
