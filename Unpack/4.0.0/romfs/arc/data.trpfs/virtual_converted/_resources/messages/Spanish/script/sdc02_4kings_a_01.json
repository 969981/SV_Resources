  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_4kings_a_01_clerk_00",
      "hash64": "D29BD9253506E37B",
      "text": "¡Hola! Puedes pasearte por la sede de nuestro\\nequipo del Alto Mando todo lo que quieras.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_a_01_clerk_01",
      "hash64": "D29BD8253506E1C8",
      "text": "¡Bienvenid[VAR 0x1100(00FF,0101)]oa a la Plaza Árida, sede del equipo de\\nDenis del Alto Mando!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_a_01_clerk_02",
      "hash64": "D29BDB253506E6E1",
      "text": "Imagino que vienes a participar en calidad de\\naspirante de la Liga Arándano.\\c\\nA ver, te llamabas... [VAR 0x0100(0000)], ¿verdad?",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_a_01_clerk_03",
      "hash64": "D29BDA253506E52E",
      "text": "Para afrontar el reto del Alto Mando deberás\\nabonar 50 PA. ¿Quieres hacer el pago ahora?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_01_clerk_04",
      "hash64": "D29BDD253506EA47",
      "text": "Uy, me parece que no tienes suficientes PA...\\c\\nSigue completando TEA y vuelve cuando hayas\\nreunido unos cuantos puntos más.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_01_system_01",
      "hash64": "62E99FF70BADB89A",
      "text": "¡Has abonado 50 PA!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_01_clerk_05",
      "hash64": "D29BDC253506E894",
      "text": "Recibido el pago y todo en regla. ¡Perfecto!\\n¡Muchas gracias por tu contribución!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_a_01_clerk_06",
      "hash64": "D29BDF253506EDAD",
      "text": "¡Denis, tenemos un pedido!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_a_01_firebb_01",
      "hash64": "29AE20143A61CBD9",
      "text": "¡Oído cocina![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
