    },
    {
      "ordinal": 10,
      "label": "sdc02_4kings_a_01_firebb_03",
      "hash64": "29AE1E143A61C873",
      "text": "Pero no será aquí. ¡Sígueme![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
