    {
      "ordinal": 0,
      "label": "kizuna_language_c_01",
      "hash64": "19F3404A1E12BCF0",
      "text": "Oh! My dear [VAR 0x0100(0000)]![VAR 0x0114(0026)]",
      "flags": 4,
