          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_b_03_math_answer_02",
      "hash64": "367A6E7BC753DABF",
      "text": "Risposta esatta! Bravissim[VAR 0x1100(00FF,0101)]oa, [VAR 0x0100(0000)]![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_b_03_math_answer_03",
      "hash64": "367A6D7BC753D90C",
      "text": "Uh uh uh, sarebbe bello! Purtroppo però la\\nprobabilità effettiva è più bassa.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_b_03_math_09",
      "hash64": "C4A6788980CF3771",
      "text": "Volendo essere precisi precisi, la probabilità\\ndi mandare a segno un brutto colpo è di\\r\\n1 su 24... cioè il 4,17%.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_b_03_math_10",
      "hash64": "C4A9F58980D241AF",
      "text": "Ma ci sono anche mosse, come ad esempio\\nOmbrartigli o Pietrataglio, che hanno una\\r\\nprobabilità più elevata, del 12% circa![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_b_03_math_11",
      "hash64": "C4A9F48980D23FFC",
      "text": "Se poi usate la mossa Focalenergia o\\nlo strumento Supercolpo...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_b_03_math_12",
      "hash64": "C4A9F78980D24515",
      "text": "Potreste aumentare la probabilità di un brutto\\ncolpo di due gradi, ovvero fino al 50%![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_b_03_math_13",
      "hash64": "C4A9F68980D24362",
      "text": "I brutti colpi possono fare la differenza.\\nIn meglio se li mettete a segno...\\r\\nIn peggio se li subite![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
