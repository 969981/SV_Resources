          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_f_03_dragon_03",
      "hash64": "BA140D3BD444D01C",
      "text": "Señora Amura hat mir aufgetragen, euch noch\\nmehr Kampfwissen zu vermitteln.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
