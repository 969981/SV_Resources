          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_f_03_dragon_08",
      "hash64": "BA14183BD444E2CD",
      "text": "Dieser Terakristall erinnert an eine Schneeflocke.\\nSeht euch diese schönen Verästelungen an![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
