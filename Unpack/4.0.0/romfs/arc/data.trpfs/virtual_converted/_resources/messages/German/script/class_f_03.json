      "hash64": "71F13E9D9AB60FC1",
      "text": "Kaumalaaat!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_f_03_dragon_07",
      "hash64": "BA14093BD444C950",
      "text": "Das letzte Mal haben wir einen Terakristall vom\\nTyp Pflanze gesehen.\\c\\nDiesmal hat er jedoch ein anderes Aussehen,\\nnicht wahr?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
