    },
    {
      "ordinal": 4,
      "label": "class_f_03_poke_01",
      "hash64": "71F13B9D9AB60AA8",
      "text": "Kaumalat!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_f_03_dragon_05",
      "hash64": "BA140B3BD444CCB6",
      "text": "Bitte heißt Kaumalat auch diesmal wieder\\nherzlich willkommen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
