        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_f_03_dragon_04",
      "hash64": "BA140C3BD444CE69",
      "text": "Darum werden wir uns auch heute erneut mit der\\nTerakristallisierung befassen.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
