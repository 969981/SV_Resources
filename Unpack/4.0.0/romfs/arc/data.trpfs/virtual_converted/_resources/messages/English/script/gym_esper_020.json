    {
      "ordinal": 36,
      "label": "gym_esper_020_trainer_23",
      "hash64": "3931CD25B78326DB",
      "text": "Yo, new kid! Are you ready to try the Gym Test\\nagain starting from a Pokémon battle?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
