        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_kusa_020_receptionist_03",
      "hash64": "01E16963DBE1936E",
      "text": "Find [VAR 0x0201(0001)] of the sunflower-shaped Pokémon\\nSunflora throughout Artazon, then bring them\\r\\nto the Sunflora Lawn to pass the test.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_kusa_020_receptionist_04",
      "hash64": "01E16C63DBE19887",
      "text": "You’ve gathered [VAR 0x0200(0001)] of them so far, so that means\\nyou have [VAR 0x0201(0002)] left to find.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0200",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_kusa_020_receptionist_05",
      "hash64": "01E16B63DBE196D4",
      "text": "They may be hidden away up high or in other\\nunexpected places, like around the backs of\\r\\nbuildings. Make sure to look all around!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_kusa_020_receptionist_09",
      "hash64": "01E15F63DBE18270",
      "text": "Once you’ve gathered 10 Sunflora, please bring\\nthem over to the Sunflora Lawn!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
