    {
      "ordinal": 0,
      "label": "gym_kusa_020_receptionist_01",
      "hash64": "01E16763DBE19008",
      "text": "Welcome to the Artazon Gym! Would you like\\nme to explain the rules of the Gym Test again?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "gym_kusa_020_receptionist_02",
      "hash64": "01E16A63DBE19521",
      "text": "The Gym Test here is [VAR 0xFF00(0006)]Sunflora Hide-and-Seek[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
