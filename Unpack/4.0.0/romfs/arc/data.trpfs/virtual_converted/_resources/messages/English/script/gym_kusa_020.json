    {
      "ordinal": 18,
      "label": "gym_kusa_020_keeper_01",
      "hash64": "3530CCAE0E1378E7",
      "text": "Hi there! I look after the Artazon Gym’s Sunflora.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "gym_kusa_020_keeper_06",
      "hash64": "3530C9AE0E1373CE",
      "text": "I hope you’re ready, challenger. It’s time for a\\ngame of Sunflora Hide-and-Seek!\\c\\nI’ll go ahead and ask the Sunflora to spread\\nthemselves out around town!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_kusa_020_keeper_07",
      "hash64": "3530CAAE0E137581",
      "text": "Flooora!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "gym_kusa_020_keeper_09",
      "hash64": "3530C4AE0E136B4F",
      "text": "Sounds like the Sunflora are ready for you!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "gym_kusa_020_keeper_10",
      "hash64": "3533D1AE0E15B73D",
      "text": "With that, your Gym Test has now begun!\\c\\nOnce you’ve found [VAR 0x0201(0001)] Sunflora, please bring\\nthem back here to the Sunflora Lawn.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_kusa_020_keeper_11",
      "hash64": "3533D0AE0E15B58A",
      "text": "That’s all from me, now! Good luck out there!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "gym_kusa_020_keeper_02",
      "hash64": "3530CDAE0E137A9A",
      "text": "It looks like you have [VAR 0x0201(0001)] Sunflora with you\\nright now.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_kusa_020_keeper_03",
      "hash64": "3530CEAE0E137C4D",
      "text": "Once you’ve found [VAR 0x0201(0002)] of them, please bring\\nthem back here!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_kusa_020_keeper_04",
      "hash64": "3530C7AE0E137068",
      "text": "Well done on finding all these Sunflora! You pass\\nthe Gym Test with flying colors.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "gym_kusa_020_keeper_05",
      "hash64": "3530C8AE0E13721B",
      "text": "Now, please head back to the lobby at the\\nArtazon Gym to report your result.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "gym_kusa_020_receptionist_06",
      "hash64": "01E16E63DBE19BED",
      "text": "Would you like to take on the Gym Test again\\nand seek out some Sunflora?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "gym_kusa_020_receptionist_07",
      "hash64": "01E16D63DBE19A3A",
      "text": "Just like before, please find [VAR 0x0201(0001)] Sunflora and\\nbring them back here to the Sunflora Lawn.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "gym_kusa_020_receptionist_08",
      "hash64": "01E16063DBE18423",
      "text": "Good luck out there!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "gym_kusa_020_kusapoke_10",
      "hash64": "F905C97956842618",
      "text": "If you leave Artazon, you’ll have to start Sunflora\\nHide-and-Seek all over again next time.\\r\\nDo you still want to leave the town?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "gym_kusa_020_kusapoke_11",
      "hash64": "F905CA79568427CB",
      "text": "You quit the Gym Test!\\c\\nIf you want to try again, go to the Sunflora Lawn.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "gym_kusa_020_kusapoke_12",
      "hash64": "F905CB795684297E",
      "text": "Are you sure you want to give up and quit\\nplaying Sunflora Hide-and-Seek?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
