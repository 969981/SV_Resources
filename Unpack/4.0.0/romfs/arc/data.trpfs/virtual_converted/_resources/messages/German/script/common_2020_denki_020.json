        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_denki_020_denki_07",
      "hash64": "07B4A06934A10ABC",
      "text": "Okay! Lassen wir unsere Zuschauer nicht mehr\\nwarten... Zeit für unseren Fight![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
