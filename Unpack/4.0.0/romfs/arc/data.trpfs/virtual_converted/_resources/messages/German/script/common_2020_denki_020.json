          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_denki_020_denki_08",
      "hash64": "07B4A76934A116A1",
      "text": "Ihr werdet nicht glauben, wie sehr sich\\nArenaleiterin Enigmara ins Zeug legt![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_denki_020_denki_09",
      "hash64": "07B4A66934A114EE",
      "text": "Ich bin schon etwas enttäuscht, verloren zu\\nhaben... Aber...[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_denki_020_denki_10",
      "hash64": "07B11969349DEF80",
      "text": "Die Zuschauerzahlen von EnigmaTV explodieren\\ngerade!\\c\\nAaah, was gibt es Schöneres... Ich könnte weinen\\nvor Glück![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
