          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0300_head_teacher_02",
      "hash64": "817FFE1AF3FCB6BD",
      "text": "不知道大家有沒有\\n把我的叮嚀聽進去？\\c\\n……有這麼一群活力充沛的學生，\\n我即使有一百二十個心也不敢放心呢。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0300_man_b_01",
      "hash64": "AEE0017188589A58",
      "text": "被說想做什麼都沒問題，\\n反而是個大難題啊。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0300_man_c_01",
      "hash64": "84620D7CD1C15E6D",
      "text": "終於讓我等到尋寶了！\\n我要用花了零用錢買的相機\\r\\n拍下最棒的照片！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0300_man_d_01",
      "hash64": "B1AF75833440D676",
      "text": "對我而言，\\n尋寶就是尋找寶可夢！\\r\\n我要把圖鑑填得滿滿的啦～",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0300_woman_b_01",
      "hash64": "51356B66502B327E",
      "text": "到底要去哪裡呢～？\\n真希望有人能幫我決定……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "common_0300_woman_c_01",
      "hash64": "5424176B78AB0693",
      "text": "我要去各種地方\\n野餐個夠～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
