  "entries": [
    {
      "ordinal": 0,
      "label": "common_0300_man_a_01",
      "hash64": "57343969EBDA1AAF",
      "text": "太棒啦～！\\n是寬曠的狂野世界！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_0300_woman_a_01",
      "hash64": "55ACAB7D237D0371",
      "text": "載我出發吧！\\n摩托蜥～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "common_0300_head_teacher_01",
      "hash64": "817FFB1AF3FCB1A4",
      "text": "各位，一路小心喔～！\\n帕底亞巨坑裡面很危險，\\r\\n校規是禁止大家進去那裡的喔～！[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
