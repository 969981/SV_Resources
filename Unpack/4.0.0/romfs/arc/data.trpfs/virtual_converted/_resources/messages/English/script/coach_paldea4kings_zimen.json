          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_paldea4kings_zimen_sp01_select_01",
      "hash64": "D4717B8263D1451D",
      "text": "Exactly!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "coach_paldea4kings_zimen_sp01_select_02",
      "hash64": "D471788263D14004",
      "text": "I guess...?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea4kings_zimen_sp01_03",
      "hash64": "743CA20901C56D68",
      "text": "Nice! It’s good to be honest! I don’t mind the\\nattention, either.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_paldea4kings_zimen_sp01_03b",
      "hash64": "48745F4E027847FE",
      "text": "You guess?! C’mon, be a bit more enthusiastic\\nfor me![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea4kings_zimen_sp01_04",
      "hash64": "743CA90901C5794D",
      "text": "Anyway, let’s get down to business—you want me\\nto bring some liveliness to the academy, right?[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea4kings_zimen_sp01_05",
      "hash64": "743CA80901C5779A",
      "text": "Nobody’s better at livening up a place than ol’\\nRika! You just leave this to me![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_paldea4kings_zimen_sp02_00",
      "hash64": "78B3E31FD517400E",
      "text": "Last time I was here, I was basically babysittin’\\nthe boss.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_paldea4kings_zimen_sp02_01",
      "hash64": "78B3E41FD51741C1",
      "text": "She may seem all professional and perfectly put\\ntogether, but she can be super absent-minded\\r\\nsometimes. Someone’s gotta look after her.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_paldea4kings_zimen_sp02_select_01",
      "hash64": "416A704DF61BF9C0",
      "text": "I wouldn’t have guessed!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "coach_paldea4kings_zimen_sp02_select_02",
      "hash64": "416A734DF61BFED9",
      "text": "You make a good team!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_paldea4kings_zimen_sp02_02",
      "hash64": "78B3E11FD5173CA8",
      "text": "It’s true! Even that Indigo Disk thing—the boss\\ncompletely spaced on giving it to Briar![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_paldea4kings_zimen_sp02_02b",
      "hash64": "30E45317167C4B3E",
      "text": "You got that right! I mean, it figures—we’ve been\\nworking together a long time.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_paldea4kings_zimen_sp02_03",
      "hash64": "78B3E21FD5173E5B",
      "text": "But yeah, she definitely needs a hand. I’ve\\neven caught her—more than once—showing up\\r\\nto work with Glimmet tangled up in her hair.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_paldea4kings_zimen_sp02_04",
      "hash64": "78B3E71FD51746DA",
      "text": "Oh, uh...don’t tell the boss I told you that, yeah?\\nShe’d give me the scolding of a lifetime...[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_paldea4kings_zimen_sp02_05",
      "hash64": "78B3E81FD517488D",
      "text": "Let’s keep it between you an’ me, OK?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_paldea4kings_zimen_sp03_00",
      "hash64": "770B991AADACD51F",
      "text": "It’s fun teaching the students here, but I’ll be\\nhonest—all the thinking’s tiring sometimes![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_paldea4kings_zimen_sp03_01",
      "hash64": "770B981AADACD36C",
      "text": "I gotta switch to, like, my professional mode,\\ny’know? It’s exhausting.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_paldea4kings_zimen_sp03_02",
      "hash64": "770B9B1AADACD885",
      "text": "Slap on those glasses to look all sharp and\\neverything. They’re just for show, to be honest.\\r\\nI don’t need ’em to see.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_paldea4kings_zimen_sp03_03",
      "hash64": "770B9A1AADACD6D2",
      "text": "You saw me in professional mode, right? For the\\ninterview thing?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_paldea4kings_zimen_sp03_04",
      "hash64": "770B951AADACCE53",
      "text": "Which do you prefer? Professional-mode Rika, or\\nRika as-is?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea4kings_zimen_sp03_select_01",
      "hash64": "6813464A803E76FB",
      "text": "Rika as-is!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "coach_paldea4kings_zimen_sp03_select_02",
      "hash64": "6813474A803E78AE",
      "text": "Professional-mode Rika!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "coach_paldea4kings_zimen_sp03_05",
      "hash64": "770B941AADACCCA0",
      "text": "Oooh, that so? Then when I’m around you, I’ll\\nloosen up as much as I can and just be myself![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_paldea4kings_zimen_sp03_05b",
      "hash64": "F5796B551C9FEDA6",
      "text": "Oooh, is that so?!\\c\\nIn that case, perhaps you’d prefer I interact with\\nyou in a more polite, refined manner?\\c\\nHeh! Gotcha.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_paldea4kings_zimen_sp03_06",
      "hash64": "770B971AADACD1B9",
      "text": "Anyhoo, I’ll keep what you said in mind![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_paldea4kings_zimen_trade_01_00",
      "hash64": "535B9E15484E2CB9",
      "text": "Hey—we’re talkin’ an awful lot these days, aren’t\\nwe?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_paldea4kings_zimen_trade_01_01",
      "hash64": "535B9D15484E2B06",
      "text": "I feel like we’re gettin’ to know each other pretty\\nwell. Why don’t we do something to celebrate?[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_paldea4kings_zimen_trade_01_02",
      "hash64": "535B9C15484E2953",
      "text": "Oh, I know! Why don’t we trade Pokémon?[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_paldea4kings_zimen_trade_01_03",
      "hash64": "535B9B15484E27A0",
      "text": "Great! That settles it, then. Now, ol’ Rika’s gonna\\nput up a Wooper to trade! Whatcha got for me?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_paldea4kings_zimen_trade_01_04",
      "hash64": "535BA215484E3385",
      "text": "[VAR 0xBD06(0000)]I like [VAR 0x0101(0001)]—I like it a lot! I’ll take\\ngood\\r\\ncare\\r\\nof\\r\\nit,\\r\\npromise!\\c\\nYou’d better mark today on your calendar—it’s a\\nspecial day when you get to trade with ol’ Rika![VAR 0x0114(0013)]",
      "flags": 0,
