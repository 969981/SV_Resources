    {
      "ordinal": 3,
      "label": "coach_paldea4kings_zimen_sp01_01",
      "hash64": "743CA40901C570CE",
      "text": "Just couldn’t get enough of ol’ Rika, eh?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
