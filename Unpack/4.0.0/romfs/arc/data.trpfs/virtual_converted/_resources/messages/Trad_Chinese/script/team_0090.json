      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "team_0090_cassiopeia_11",
      "hash64": "40994D6F6577804D",
      "text": "不論如何，真是可靠的朋友。\\n就好像以前的大家一樣……[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
