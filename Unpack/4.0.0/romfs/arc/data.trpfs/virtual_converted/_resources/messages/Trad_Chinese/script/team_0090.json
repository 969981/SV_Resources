          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0090_botan_01",
      "hash64": "B3E7EE01EEFC0CD5",
      "text": "呃、呃，人家來了……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0090_legend_01",
      "hash64": "90AB9FDEF2103B16",
      "text": "啊嗄嘶！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "team_0090_botan_02",
      "hash64": "B3E7EB01EEFC07BC",
      "text": "嗚哇哇！\\n你不要出來！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "team_0090_botan_03",
      "hash64": "B3E7EC01EEFC096F",
      "text": "啊啊啊～……！！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "team_0090_botan_04",
      "hash64": "B3E7E901EEFC0456",
      "text": "……哦～\\n天星隊曾經有過那些事啊。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "team_0090_botan_05",
      "hash64": "B3E7EA01EEFC0609",
      "text": "他們明明想撲滅霸凌，\\n結果自己卻成了大家害怕的對象……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "team_0090_botan_06",
      "hash64": "B3E7E701EEFC00F0",
      "text": "真是太搞笑了。\\n老師和學生通通都是笨蛋。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "team_0090_botan_07",
      "hash64": "B3E7E801EEFC02A3",
      "text": "當大家正在被霸凌的時候，\\n要是有其他任何一個人察覺到……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "team_0090_botan_08",
      "hash64": "B3E7F501EEFC18BA",
      "text": "應該馬上就會明白\\n天星隊才不是壞蛋……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "team_0090_botan_09",
      "hash64": "B3E7F601EEFC1A6D",
      "text": "在那樣通通都是笨蛋的學校裡，\\n就算去奮戰，\\r\\n大家也只會吃虧而已……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "team_0090_botan_10",
      "hash64": "B3EB7301EEFF24AB",
      "text": "那個創建什麼天星隊\\n叫做真老大的人，\\r\\n一定也是個無可救藥的大笨蛋。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "team_0090_select_05",
      "hash64": "200589D705811EC5",
      "text": "沒那回事",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "team_0090_select_06",
      "hash64": "200586D7058119AC",
      "text": "是嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "team_0090_botan_11",
      "hash64": "B3EB7201EEFF22F8",
      "text": "…………一定是的。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
