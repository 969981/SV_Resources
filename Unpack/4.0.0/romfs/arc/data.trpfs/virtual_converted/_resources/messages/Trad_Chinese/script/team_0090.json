      "label": "team_0090_cassiopeia_16",
      "hash64": "4099466F65777468",
      "text": "害怕天星隊的他們，\\n一個接一個地退學了。[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
