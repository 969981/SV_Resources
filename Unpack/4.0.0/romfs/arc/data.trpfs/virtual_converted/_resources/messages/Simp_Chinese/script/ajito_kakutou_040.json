    },
    {
      "ordinal": 41,
      "label": "ajito_kakutou_040_nelke_07",
      "hash64": "5C185E40FEE60988",
      "text": "[EMPTY 68]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
