          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_c_07_history_02",
      "hash64": "1E1E4DEDD0C2AEF3",
      "text": "雖然今天是最後一堂課，\\n但讓我們繼續一起解開\\r\\n歷史的美妙之處吧。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_c_07_history_03",
      "hash64": "1E1E4CEDD0C2AD40",
      "text": "上一堂課我講了２００年前的\\n第零區觀測隊的事。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_c_07_history_04",
      "hash64": "1E1E53EDD0C2B925",
      "text": "啊啊……我教的內容\\n越來越靠近現代了……[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_c_07_history_05",
      "hash64": "1E1E52EDD0C2B772",
      "text": "歷史課的缺點就是\\n課堂內容一堂一堂邁向未來。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_c_07_history_06",
      "hash64": "1E1E51EDD0C2B5BF",
      "text": "乾脆從現代開始，\\n一路回溯時間到過去，\\r\\n這是不是比較浪漫啊！？[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_c_07_select_a",
      "hash64": "2A85FB8B4ED96C98",
      "text": "是比較浪漫！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "class_c_07_select_b",
      "hash64": "2A85FE8B4ED971B1",
      "text": "那會很難懂……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_c_07_history_07a",
      "hash64": "F037F119BAD89537",
      "text": "[VAR 0x0100(0000)]，[VAR 0x1100(00FF,0101)]你妳懂我啊！\\c\\n不過，要是沒有照著課程綱要走，\\n就會激怒校長，這也是事實。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_c_07_history_07b",
      "hash64": "F037F219BAD896EA",
      "text": "的確……像是因為先有某件事，\\n於是後來發生另一件事，\\r\\n這類前因後果可能會變得比較難懂。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_c_07_history_08",
      "hash64": "1E1E57EDD0C2BFF1",
      "text": "唉，沒辦法……\\n我們將歷史的時針往未來轉動。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_c_07_history_09",
      "hash64": "1E1E56EDD0C2BE3E",
      "text": "最後一堂課，就讓我傳授\\n太晶的歷史給你們吧。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_c_07_history_10",
      "hash64": "1E1B49EDD0C07250",
      "text": "太晶珠原本是從\\n第零區誕生的技術。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_c_07_history_11",
      "hash64": "1E1B4AEDD0C07403",
      "text": "在一般認為觀測隊已經到過了最深處之後，\\n人們依舊持續在探索第零區……[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_c_07_history_12",
      "hash64": "1E1B4BEDD0C075B6",
      "text": "於是在大約１４０年前，有人發現了\\n全身籠罩在神秘光芒中的寶可夢。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_c_07_history_13",
      "hash64": "1E1B4CEDD0C07769",
      "text": "你們想必已經猜到了。\\n那就是太晶化的寶可夢。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_c_07_history_14",
      "hash64": "1E1B4DEDD0C0791C",
      "text": "雖然人們將這些寶可夢從第零區帶了回來，\\n但牠們卻失去了身體的光芒。\\r\\n太晶化現象也長年是謎團籠罩。直到……[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_c_07_history_15",
      "hash64": "1E1B4EEDD0C07ACF",
      "text": "１０年前……這根本就是近代了。\\n某個你們也知道的人\\r\\n解明了太晶化的原理。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_c_07_history_16",
      "hash64": "1E1B4FEDD0C07C82",
      "text": "……那麼，請這時不幸與我\\n對上眼的[VAR 0x0100(0000)]來回答。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_c_07_history_17",
      "hash64": "1E1B50EDD0C07E35",
      "text": "解開太晶化原理的\\n知名博士……叫什麼名字？[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_c_07_select_01",
      "hash64": "1C2A1AB6FC5D12FE",
      "text": "海哲博士",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
