          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "class_c_07_history_19b",
      "hash64": "E8EFE319B71CDA1B",
      "text": "他發現了原來是存在於\\n第零區的閃耀結晶的能量……\\r\\n導致了寶可夢太晶化。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
