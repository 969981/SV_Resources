          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_c_07_history_18a",
      "hash64": "E8EBC019B718B5CB",
      "text": "大約１０年前，是一位名為奧琳的博士\\n解開了太晶化現象的原理。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_c_07_history_18b",
      "hash64": "E8EBC119B718B77E",
      "text": "大約１０年前，是一位名為弗圖的博士\\n解開了太晶化現象的原理。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_c_07_history_19a",
      "hash64": "E8EFE419B71CDBCE",
      "text": "她發現了原來是存在於\\n第零區的閃耀結晶的能量……\\r\\n導致了寶可夢太晶化。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
