        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0060_rival_06",
      "hash64": "04D43E0480935FCB",
      "text": "Der Kampf ist das Ziel![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
