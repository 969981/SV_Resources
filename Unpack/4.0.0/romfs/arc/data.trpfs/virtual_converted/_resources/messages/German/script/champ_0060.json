          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0060_rival_07a",
      "hash64": "C80227A67A69879B",
      "text": "Waaas? Du hast doch erst zwei Arenaorden!\\nWarum bist du dann schon so stark?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0060_rival_07b",
      "hash64": "C80228A67A69894E",
      "text": "Sorry! Da hab ich wohl Pokémon gewählt,\\ndie ein bisschen zu stark waren.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0060_rival_08",
      "hash64": "04D43C0480935C65",
      "text": "Das war doch mal ein guter Kampf! Ich hatte\\neinen Riesenspaß![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
