          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0060_rival_15",
      "hash64": "04D13B04809124DB",
      "text": "Hier, ein kleines Dankeschön![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0060_rival_09",
      "hash64": "04D43B0480935AB2",
      "text": "Am liebsten würde ich jetzt sofort noch mal\\ngegen dich antreten!\\c\\nAber als Champ sollte man auf seine Gegner\\nRücksicht nehmen, also lassen wir das lieber...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
