        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0060_rival_05",
      "hash64": "04D43F048093617E",
      "text": "Also dann, los geht’s![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
