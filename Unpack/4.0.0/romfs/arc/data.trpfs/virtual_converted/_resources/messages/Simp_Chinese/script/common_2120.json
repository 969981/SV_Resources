    {
      "ordinal": 2,
      "label": "common_2120_announce_03",
      "hash64": "53A1D4DB4C626694",
      "text": "……生物老师吉尼亚！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_2120_ecology_01",
      "hash64": "A4672421809FDAA5",
      "text": "[VAR 0x0100(0000)]，\\n你好呀～你好。[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
