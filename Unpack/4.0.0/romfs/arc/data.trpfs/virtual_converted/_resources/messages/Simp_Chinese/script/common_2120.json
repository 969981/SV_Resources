      "hash64": "53A1D6DB4C6269FA",
      "text": "接下来是第二轮比赛！\\n令人在意的对决是……！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_2120_announce_02",
      "hash64": "53A1D5DB4C626847",
      "text": "冠军[VAR 0x0100(0000)]ＶＳ……",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
