          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_2120_ecology_11",
      "hash64": "A46AA82180A2F0C8",
      "text": "不是吧？\\n校长生气了？[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
