          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "champ_0010_rival_07",
      "hash64": "5D8DD519843725E5",
      "text": "想要晉升冠軍級，\\n只靠上課是不夠的。\\c\\n必須在８個寶可夢道館都打贏，\\n收集道館徽章喔！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
