    },
    {
      "ordinal": 21,
      "label": "champ_0010_rival_08",
      "hash64": "5D8DD61984372798",
      "text": "這麼一來，就能挑戰特別的測驗……\\n冠軍測驗。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
