          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "champ_0010_rival_10",
      "hash64": "5D915419843A3389",
      "text": "那是所有寶可夢訓練家的夢想！\\n是很～厲害的頭銜呢～！\\r\\n……哎，自己這樣說自己，好害羞啊。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
