      "hash64": "5D915319843A31D6",
      "text": "我是在上次尋寶時\\n成為冠軍級的喔！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
