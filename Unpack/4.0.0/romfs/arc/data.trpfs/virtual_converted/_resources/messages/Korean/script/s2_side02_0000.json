    },
    {
      "ordinal": 26,
      "label": "s2_side02_0000_camera_17",
      "hash64": "90457A2F476BCB3E",
      "text": "뭐, 아직 수습 기간이긴 하지만...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
