      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s2_side02_0000_camera_11",
      "hash64": "90457C2F476BCEA4",
      "text": "너에게 맡긴 가디!\\n그 애는 잘 지내고 있니?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
