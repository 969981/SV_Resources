      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "s2_side02_0000_camera_15",
      "hash64": "9045782F476BC7D8",
      "text": "후후후~!\\n굉장하지! 굉장하지![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
