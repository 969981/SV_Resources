    },
    {
      "ordinal": 14,
      "label": "s2_side02_0000_camera_09",
      "hash64": "9042702F47698469",
      "text": "오! 너에게 맡긴 가디!\\n같이 모험해 줬구나![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
