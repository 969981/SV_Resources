    {
      "ordinal": 10,
      "label": "s2_side02_0000_camera_06",
      "hash64": "9042792F476993B4",
      "text": "오! 너에게 맡긴 가디!\\n윈디가 됐구나![VAR 0x0114(0046)]",
      "flags": 0,
