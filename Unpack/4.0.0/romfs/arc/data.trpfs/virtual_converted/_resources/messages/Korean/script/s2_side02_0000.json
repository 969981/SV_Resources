    {
      "ordinal": 11,
      "label": "s2_side02_0000_camera_07",
      "hash64": "90427A2F47699567",
      "text": "굉장해 굉장해!\\n역시 윈디야! 듬직해 보이는걸![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
