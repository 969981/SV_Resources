          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_battle_c_01",
      "hash64": "FC40EBA601CBCDE8",
      "text": "제발요! 이렇게 부탁할게요![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_battle_c_select_01",
      "hash64": "83926C2C80255817",
      "text": "운향 선생님!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_battle_c_select_02",
      "hash64": "83926D2C802559CA",
      "text": "무슨 일이에요?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_battle_c_02",
      "hash64": "FC40EEA601CBD301",
      "text": "오! 전학생!\\n마침 잘 왔어![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_battle_c_03",
      "hash64": "FC40EDA601CBD14E",
      "text": "미모사 선생님이\\n내가 만든 샌드위치를 안 먹겠다지 뭐야![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_battle_c_health_02",
      "hash64": "1441AA1DBE3359C8",
      "text": "당연히 안 먹지!\\n나는 배 아프고 싶지 않다구![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_battle_c_04",
      "hash64": "FC40F0A601CBD667",
      "text": "그럴 리가 없잖아요![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_battle_c_health_03",
      "hash64": "1441AB1DBE335B7B",
      "text": "없기는! 전에 네가 만든\\n고기에 고기를 끼워 넣은 샌드위치?\\r\\n그거 먹고 하루 종일 고생했단 말이야![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_battle_c_05",
      "hash64": "FC40EFA601CBD4B4",
      "text": "그, 그때는 저도 아직 미숙할 때라...\\n젊은 날의 실수 같은 거라고 할까...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_battle_c_health_04",
      "hash64": "1441B01DBE3363FA",
      "text": "지난달 일이라구! 지난달![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_battle_c_06",
      "hash64": "FC40F2A601CBD9CD",
      "text": "...아무튼 이런 상황이라\\n이러지도 저러지도 못하고 있어.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_battle_c_07",
      "hash64": "FC40F1A601CBD81A",
      "text": "기껏 샌드위치 만들기\\n특훈까지 했는데... 슬프네...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_battle_c_health_05",
      "hash64": "1441B11DBE3365AD",
      "text": "특훈이란 걸 했었구나?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_battle_c_select_03",
      "hash64": "83926E2C80255B7D",
      "text": "열심히 하셨어요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_battle_c_select_04",
      "hash64": "8392672C80254F98",
      "text": "한번 드셔 보세요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "kizuna_battle_c_health_06",
      "hash64": "1441AE1DBE336094",
      "text": "하아...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_battle_c_health_07",
      "hash64": "1441AF1DBE336247",
      "text": "귀여운 학생이 이렇게까지 부탁한다면\\n어쩔 수 없지...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_battle_c_health_08",
      "hash64": "1441A41DBE334F96",
      "text": "먹어 볼 테니까 이리 줘 봐.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_battle_c_08",
      "hash64": "FC40E4A601CBC203",
      "text": "고마워요!\\n자, 여기...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_battle_c_health_09",
      "hash64": "1441A51DBE335149",
      "text": "우물 우물 우물...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_battle_c_health_10",
      "hash64": "1445321DBE3676B7",
      "text": "조금 맛이 강하긴 하지만...\\n그럭저럭... 먹을 만한데?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_battle_c_09",
      "hash64": "FC40E3A601CBC050",
      "text": "만세!\\n특훈한 보람이 있었어![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_battle_c_10",
      "hash64": "FC3D66A601C8B612",
      "text": "존경하는 미모사 선생님이\\n맛있게 드셔 주셔서 다행이야![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_battle_c_system_01",
      "hash64": "FEFC464555D2C634",
      "text": "운향 선생님이\\n나를 신뢰하는 게 느껴진다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "kizuna_battle_c_11",
      "hash64": "FC3D67A601C8B7C5",
      "text": "고마워요, 미모사 선생님!\\n그리고 전학생도![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_battle_c_health_11",
      "hash64": "1445311DBE367504",
      "text": "못 말려, 진짜!\\n대체 뭐였던 거야...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_battle_c_health_12",
      "hash64": "1445341DBE367A1D",
      "text": "운향 선생님, 다치는 일이 많아서\\n자주 보건실에 오곤 하는데\\r\\n항상 저런 식이란 말이지~[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
