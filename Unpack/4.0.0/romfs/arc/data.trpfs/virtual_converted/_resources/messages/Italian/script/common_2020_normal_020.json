        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_2020_normal_020_normal_02",
      "hash64": "D1F1D81ED872B4A1",
      "text": "Perciò non credo che questa sia un’occasione\\nparticolarmente emozionante per te.\\r\\nProcediamo.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 95,
