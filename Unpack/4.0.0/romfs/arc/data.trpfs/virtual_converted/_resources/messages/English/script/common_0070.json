    {
      "ordinal": 4,
      "label": "common_0070_rival_02",
      "hash64": "FA14B18685E997C8",
      "text": "So you’re that kid who moved in up the road![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
