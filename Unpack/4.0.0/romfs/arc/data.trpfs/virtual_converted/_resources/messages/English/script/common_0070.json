    },
    {
      "ordinal": 5,
      "label": "common_0070_rival_03",
      "hash64": "FA14B28685E9997B",
      "text": "I’ve been dying to find out more about you![VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
