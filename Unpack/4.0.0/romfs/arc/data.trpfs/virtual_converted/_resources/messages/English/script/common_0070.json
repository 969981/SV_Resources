    {
      "ordinal": 9,
      "label": "common_0070_rival_05a",
      "hash64": "DAD958958C0153A4",
      "text": "Love that enthusiasm! We’re gonna get along\\njust fine![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
