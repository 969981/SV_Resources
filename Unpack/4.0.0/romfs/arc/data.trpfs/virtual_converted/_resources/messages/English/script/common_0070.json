    {
      "ordinal": 1,
      "label": "common_0070_head_teacher_01",
      "hash64": "FC1844C97563E466",
      "text": "I must say, I wasn’t expecting to see you here\\nquite so soon.[VAR 0x0114(000A)]",
      "flags": 4,
