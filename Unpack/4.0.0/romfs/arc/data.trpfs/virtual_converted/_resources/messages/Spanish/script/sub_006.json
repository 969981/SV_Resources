    {
      "ordinal": 14,
      "label": "sub_006_trainer_15",
      "hash64": "B98EB76E5775BBC5",
      "text": "Aún no has completado la pista Nieve Polvo.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
