    {
      "ordinal": 34,
      "label": "sub_006_trainer_23",
      "hash64": "B98B496E5772CB04",
      "text": "¡Días malos los tenemos todos! No te preocupes\\ny vuelve al eslalon gigante cuando te apetezca.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "sub_006_trainer_stop",
      "hash64": "00406627BC61950F",
      "text": "Vaya, me temo que no puedes participar con la\\nPokémontura en su Forma Combate.\\c\\n¡Haz que cambie a la Forma Montura si quieres\\nbajar por nuestras pistas!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
