    {
      "ordinal": 3,
      "label": "champ_0060_rival_04",
      "hash64": "04D4400480936331",
      "text": "I think it’s time I started introducing you to some\\nof my harder hitters![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
