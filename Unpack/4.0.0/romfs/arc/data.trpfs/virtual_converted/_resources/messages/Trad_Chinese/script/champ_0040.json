      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0040_rival_03",
      "hash64": "0FD8FC3FDB3FBCAA",
      "text": "我沒有埋伏在這裡等著和[VAR 0x1100(00FF,0101)]你妳對戰喔。\\n……才不是那麼一回事喔！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
