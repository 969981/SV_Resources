      "hash64": "E989D6AEA7381A5A",
      "text": "[VAR 0x0100(0000)]，\\n校内最强的宝座就先让给你了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
