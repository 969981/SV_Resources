    {
      "ordinal": 7,
      "label": "common_2160_rival_06",
      "hash64": "E989D4AEA73816F4",
      "text": "想参赛的时候\\n就去找工作人员报名吧。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
