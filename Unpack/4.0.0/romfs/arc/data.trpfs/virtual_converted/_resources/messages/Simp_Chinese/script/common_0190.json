    {
      "ordinal": 1,
      "label": "common_0190_rival_02",
      "hash64": "EB0E5AADCB0F709B",
      "text": "[VAR 0x0100(0000)]！你看！\\n那就是桌台市！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
