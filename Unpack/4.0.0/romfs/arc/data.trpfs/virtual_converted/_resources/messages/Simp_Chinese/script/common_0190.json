          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0190_rival_04",
      "hash64": "EB0E60ADCB0F7ACD",
      "text": "我现在就超～期待\\n能和[VAR 0x0100(0000)]你一起学习了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
