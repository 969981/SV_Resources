      "hash64": "CB8DA603F8645EEF",
      "text": "学习……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0190_rival_05a",
      "hash64": "78E60F500B4B6C01",
      "text": "要的就是你这股劲头！\\n我们要好好学习，\\r\\n多多对战哦！[VAR 0x0114(0004)]",
