      ]
    },
    {
      "ordinal": 2,
      "label": "common_0190_rival_03",
      "hash64": "EB0E59ADCB0F6EE8",
      "text": "那个上面有颗球的大楼\\n就是我们的学校哦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
