      ]
    },
    {
      "ordinal": 8,
      "label": "common_0190_rival_01",
      "hash64": "EB0E5BADCB0F724E",
      "text": "从灯塔看到的景色超～美吧～？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
