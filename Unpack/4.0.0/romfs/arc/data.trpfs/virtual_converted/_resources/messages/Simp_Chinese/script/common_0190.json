      ]
    },
    {
      "ordinal": 9,
      "label": "common_0190_rival_08",
      "hash64": "EB0E54ADCB0F6669",
      "text": "放眼望去尽是山！\\n草丛！森林！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
