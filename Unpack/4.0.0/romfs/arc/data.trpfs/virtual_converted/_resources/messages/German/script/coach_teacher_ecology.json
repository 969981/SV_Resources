          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "coach_teacher_ecology_randomtalk_04",
      "hash64": "2B971A00F5691302",
      "text": "Das Schluppuck, das ich dir gegeben habe,\\nist sehr unterhaltsam!\\c\\nEs hat die Fähigkeit Völlerei und frisst getragene\\nBeeren frühzeitig.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
