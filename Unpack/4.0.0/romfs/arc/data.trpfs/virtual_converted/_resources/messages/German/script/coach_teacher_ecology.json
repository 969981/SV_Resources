          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_teacher_ecology_randomtalk_00",
      "hash64": "2B971600F5690C36",
      "text": "Die Tera-Kuppel ist wirklich superinteressant!\\c\\nDort gibt es lauter Pokémon, die man in Paldea\\nnicht zu Gesicht bekommt![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_teacher_ecology_randomtalk_01",
      "hash64": "2B971700F5690DE9",
      "text": "In letzter Zeit habe ich mehrere Regionen bereist.\\nDas hat Spaß gemacht!\\c\\nAuf der Hin- und Rückreise schweife ich mit den\\nGedanken einfach ab, da vergeht die Zeit wie im\\r\\nFlug. So ist Reisen überhaupt nicht anstrengend![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 171,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 223,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_teacher_ecology_randomtalk_02",
      "hash64": "2B971400F56908D0",
      "text": "Ich bin in Sandalen an einer anderen Akademie\\naufgekreuzt.\\c\\nWenn mich Direktor Clavel so sehen würde,\\nbekäme ich bestimmt wieder was zu hören.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "coach_teacher_ecology_randomtalk_03",
      "hash64": "2B971500F5690A83",
      "text": "Dein [VAR 0x0101(0001)] ist sehr individuell!\\nIch bin gespannt, wie es sich macht.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0101",
