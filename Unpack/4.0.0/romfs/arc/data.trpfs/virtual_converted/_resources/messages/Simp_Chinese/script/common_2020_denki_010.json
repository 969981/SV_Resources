          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2020_denki_010_denki_09",
      "hash64": "8820E7DABE3D46A7",
      "text": "很～好！那我们就\\n前往对战场咯～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2020_denki_010_denki_10",
      "hash64": "8823E4DABE3F7765",
      "text": "我会提前通知观众的。\\n等你想对战时就告诉我吧～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
