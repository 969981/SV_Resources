          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2020_denki_010_select_01",
      "hash64": "DE6F2CA18338EC46",
      "text": "我是[VAR 0x0100(0000)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2020_denki_010_select_02",
      "hash64": "DE6F2BA18338EA93",
      "text": "我替首席来的",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_denki_010_denki_03",
      "hash64": "8820E1DABE3D3C75",
      "text": "咦？[VAR 0x0100(0000)]你是\\n新的冠军，替首席来的！？[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_denki_010_denki_04",
      "hash64": "8820DADABE3D3090",
      "text": "前不久你这只麻麻小鱼还在参加道馆测验，\\n现在一跃而起变麻麻鳗鱼王了～！？厉害！！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_denki_010_denki_05",
      "hash64": "8820DBDABE3D3243",
      "text": "咦～？也就是说，\\n如果现在和[VAR 0x0100(0000)]合演的话，\\r\\n我的人气也会更加爆棚……？\\r\\n嘿嘿……嘻嘻嘻！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_denki_010_denki_06",
      "hash64": "8820DCDABE3D33F6",
      "text": "好，我知道了！\\nOKOK，是酱紫的剧情啊～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_denki_010_denki_07",
      "hash64": "8820DDDABE3D35A9",
      "text": "让代替首席来视察的你！\\n见识一下我奇树的真本事吧！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_denki_010_denki_08",
      "hash64": "8820E6DABE3D44F4",
      "text": "那奇好～我们就赶快\\n来场动真格的对战吧～！？[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_denki_010_denki_retry",
      "hash64": "5A092D5262686886",
      "text": "[VAR 0x0100(0000)]！\\n你现在想和我来场动真格的对战啦～！？[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
