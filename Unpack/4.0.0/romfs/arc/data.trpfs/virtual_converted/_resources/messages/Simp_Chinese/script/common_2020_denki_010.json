    },
    {
      "ordinal": 1,
      "label": "common_2020_denki_010_denki_02",
      "hash64": "8820E0DABE3D3AC2",
      "text": "早中晚上好哈啰～……\\n等等，你不是也慈啊！？[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
