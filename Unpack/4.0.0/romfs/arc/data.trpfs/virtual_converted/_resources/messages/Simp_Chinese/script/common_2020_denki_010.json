    {
      "ordinal": 0,
      "label": "common_2020_denki_010_denki_01",
      "hash64": "8820DFDABE3D390F",
      "text": "用电网捕获首席的眼球！\\n谁来奇述？奇树来了！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
