    },
    {
      "ordinal": 3,
      "label": "kizuna_ecology_a_03b",
      "hash64": "ADA24F915EEB850C",
      "text": "틀림없이 이제부터\\n즐거워질 거야~\\r\\n무슨 일 생기면 같이 고민해 보자~[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
