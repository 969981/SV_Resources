        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_ecology_a_04",
      "hash64": "33860770BD20EDBF",
      "text": "그렇지! 포켓몬 도감 앱은\\n잘 사용하고 있니~?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
