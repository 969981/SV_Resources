          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_010_ecology_03",
      "hash64": "77F2E674C0CC2ABB",
      "text": "Il viaggio di studio è appena iniziato.\\c\\nApprofitta della tua permanenza a Nordivia per\\nincontrare frotte di Pokémon che vivono solo qui![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_010_ecology_04",
      "hash64": "77F2EB74C0CC333A",
      "text": "In climi diversi, si trovano ovviamente Pokémon\\ndiversi.\\c\\nA Nordivia l’estate è molto umida, per questo\\nqui ci sono molti Pokémon che amano l’umidità.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 152,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_010_ecology_05",
      "hash64": "77F2EC74C0CC34ED",
      "text": "Pare che sulla cima del Monte Orco ci siano punti\\nin cui i gas vulcanici fuoriescono dalla terra!\\c\\nSembra che i Pokémon che amano i gas ci si\\ntrovino benissimo...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 164,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_010_ecology_05_02",
      "hash64": "CC6D265DB8C2E240",
      "text": "Tu però è meglio se non li inali a pieni polmoni.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_010_ecology_06",
      "hash64": "77F2E974C0CC2FD4",
      "text": "Wow! Manca poco al completamento del\\nPokédex di Nordivia!\\c\\nAncora un piccolo sforzo e ci sei! Prova a\\ncontrollare l’habitat dei Pokémon nel Pokédex\\r\\no ad affrontare i raid nelle grotte dei cristalli.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 203,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_010_ecology_07",
      "hash64": "77F2EA74C0CC3187",
      "text": "Non mi dire... Hai registrato tutte le specie\\ndi Pokémon![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_010_ecology_08",
      "hash64": "77F2DF74C0CC1ED6",
      "text": "Evviva, evviva! Hai completato il Pokédex\\ndi Nordivia!\\c\\nFenomenale, davvero fenomenale![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_010_ecology_09",
      "hash64": "77F2E074C0CC2089",
      "text": "Grazie a te, le mie ricerche sui Pokémon\\ndi Nordivia possono dirsi praticamente concluse![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_010_ecology_10",
      "hash64": "77F66D74C0CF45F7",
      "text": "Vorrei darti qualcosa per sdebitarmi, ma non ho\\nniente con me...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_010_ecology_11",
      "hash64": "77F66C74C0CF4444",
      "text": "Ci sono![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_010_ecology_25",
      "hash64": "77EC5874C0C6CDC3",
      "text": "Ti regalo questo souvenir in edizione limitata\\nche ho comprato al Centro Nordivia![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_010_ecology_12",
      "hash64": "77F66F74C0CF495D",
      "text": "E poi... Puoi darmi un attimo lo Smart Rotom?[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_010_ecology_13",
      "hash64": "77F66E74C0CF47AA",
      "text": "In onore della tua impresa, voglio aggiornare\\nla tua App Pokédex con la funzione per vedere\\r\\ni diplomi, aggiunta dal Preside Clavel.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_010_ecology_14",
      "hash64": "77F66974C0CF3F2B",
      "text": "Include anche un messaggio dall’azienda\\nche certifica il completamento del Pokédex.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_010_ecology_15",
      "hash64": "77F66874C0CF3D78",
      "text": "Anche se hai completato il Pokédex, il tuo\\nviaggio di studio ha ancora tanto da darti![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_sub_010_ecology_16",
      "hash64": "77F66B74C0CF4291",
      "text": "Continua a incontrare più Pokémon del posto\\nche puoi, durante la tua permanenza a Nordivia.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_sub_010_ecology_17",
      "hash64": "77F66A74C0CF40DE",
      "text": "Oggi c’è un tempo magnifico. Si prospetta\\nuna giornata fresca e soleggiata.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_sub_010_ecology_18",
      "hash64": "77F66574C0CF385F",
      "text": "L’estate di Nordivia è molto umida.\\nSotto il camice sono fradicio.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_sub_010_ecology_19",
      "hash64": "77F66474C0CF36AC",
      "text": "Che belli, i tramonti di Nordivia! Hanno colori\\npiù tenui di quelli di Paldea.\\c\\nChe sia dovuto a un diverso indice di rifrazione\\ndella luce?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_010_ecology_20",
      "hash64": "77EC5B74C0C6D2DC",
      "text": "Ti dai da fare fino a tardi, vedo. Ogni tanto,\\nperò, fermati a guardare il cielo!\\c\\nLe stelle si vedono benissimo perché in paese\\nnon c’è molta luce artificiale.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 162,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_010_ecology_21",
      "hash64": "77EC5C74C0C6D48F",
      "text": "La giornata è iniziata con una bella pioggerella.\\c\\nI Pokémon che amano l’acqua saranno felicissimi.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_sub_010_ecology_22",
      "hash64": "77EC5D74C0C6D642",
      "text": "L’estate a Nordivia è pazzesca, c’è un’afa\\nasfissiante anche quando piove.\\c\\nUn clima del genere deve avere un’influenza\\nenorme anche sull’ecosistema.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 151,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_sub_010_ecology_23",
      "hash64": "77EC5E74C0C6D7F5",
      "text": "Toh, un acquazzone serale.\\c\\nFai attenzione, mi raccomando. È un attimo\\nraffreddarsi, quando si è bagnati.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_010_ecology_24",
      "hash64": "77EC5774C0C6CC10",
      "text": "Di notte c’è poca visibilità, e in più il terreno\\nè fangoso per via della pioggia.\\r\\nForse è meglio se non ti allontani troppo.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_sub_010_ecology_stop",
      "hash64": "476DB22077BD9036",
      "text": "Punta a completare il Pokédex di Nordivia\\nregistrando 200 specie!\\c\\nQuando ce l’avrai fatta, premi il [VAR 0xFF00(0006)]pulsante X[VAR 0xFF00(0000)]\\ndall’App Pokédex per aggiungere il simbolo\\r\\nche attesta il completamento del Pokédex\\r\\ne vieni a farmelo vedere![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
