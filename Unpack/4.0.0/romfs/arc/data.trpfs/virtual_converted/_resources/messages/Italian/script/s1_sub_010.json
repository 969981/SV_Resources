    {
      "ordinal": 1,
      "label": "s1_sub_010_ecology_02",
      "hash64": "77F2E574C0CC2908",
      "text": "A Nordivia hai catturato... [VAR 0x0202(0001)] specie\\ndi Pokémon locali![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0202",
          "args_hex": [
            "0001"
          ]
        },
        {
