    },
    {
      "ordinal": 10,
      "label": "sdc02_4kings_a_04_steelbb_07",
      "hash64": "7B2CC8B0CD4D2339",
      "text": "現在的他和以前不同。\\n……納莉我也感到擔憂。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
