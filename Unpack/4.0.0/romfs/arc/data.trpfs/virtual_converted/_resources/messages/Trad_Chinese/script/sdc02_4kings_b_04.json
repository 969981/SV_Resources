    },
    {
      "ordinal": 12,
      "label": "sdc02_4kings_a_04_steelbb_09",
      "hash64": "7B2CD2B0CD4D3437",
      "text": "因此，\\n納莉我不允許自己失敗。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
