      "ordinal": 8,
      "label": "sdc02_4kings_a_04_steelbb_05",
      "hash64": "7B2CC6B0CD4D1FD3",
      "text": "無解……啊。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
