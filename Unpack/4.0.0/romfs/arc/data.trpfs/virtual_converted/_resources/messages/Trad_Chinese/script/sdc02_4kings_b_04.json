    },
    {
      "ordinal": 11,
      "label": "sdc02_4kings_a_04_steelbb_08",
      "hash64": "7B2CD1B0CD4D3284",
      "text": "並且，可能的話，\\n納莉我希望拯救他。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
