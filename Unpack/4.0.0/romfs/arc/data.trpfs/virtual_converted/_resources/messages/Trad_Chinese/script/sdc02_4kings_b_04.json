      "hash64": "7B304EB0CD503CC2",
      "text": "寶可夢有多強，\\n就代表心意有多強。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
