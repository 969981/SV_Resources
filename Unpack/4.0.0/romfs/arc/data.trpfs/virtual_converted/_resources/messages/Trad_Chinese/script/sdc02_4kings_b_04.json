      "hash64": "7B2CC5B0CD4D1E20",
      "text": "好對手……啊。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
