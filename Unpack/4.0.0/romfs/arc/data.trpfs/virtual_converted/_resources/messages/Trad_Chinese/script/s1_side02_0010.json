      "text": "沒興趣……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s1_side02_0010_camera_08",
      "hash64": "7E32F978B05751D6",
      "text": "[VAR 0x1100(00FF,0101)]你妳這種遇到什麼事\\n都想湊個熱鬧的精神很讚喔！\\r\\n那就讓我來說明一下吧。[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
