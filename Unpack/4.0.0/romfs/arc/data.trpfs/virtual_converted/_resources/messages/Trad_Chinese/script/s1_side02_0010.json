          "kind": "control",
          "offset_units": 23,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_side02_0010_camera_15",
      "hash64": "7E368278B05A7078",
      "text": "要是[VAR 0x1100(00FF,0101)]你妳有興趣的話，\\n我想請[VAR 0x1100(00FF,0101)]你妳先讓我看看[VAR 0x1100(00FF,0101)]你妳有多強！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
