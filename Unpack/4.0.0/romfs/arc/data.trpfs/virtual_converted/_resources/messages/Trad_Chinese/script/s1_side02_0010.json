      ]
    },
    {
      "ordinal": 2,
      "label": "s1_side02_0010_select_01",
      "hash64": "EFEB4D443AB14FA8",
      "text": "沒錯！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_side02_0010_select_02",
      "hash64": "EFEB50443AB154C1",
      "text": "也還好啦……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_side02_0010_camera_03",
      "hash64": "7E330078B0575DBB",
      "text": "厲害，真厲害！\\n年輕人[VAR 0x1100(00FF,0101)]你妳真了不起！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0010_camera_04",
      "hash64": "7E330578B057663A",
      "text": "啊哈哈！\\n年輕人啊～[VAR 0x1100(00FF,0101)]你妳可以更有自信點喔！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_side02_0010_camera_05",
      "hash64": "7E330678B05767ED",
      "text": "感覺[VAR 0x1100(00FF,0101)]你妳已經比我這個先來北上鄉的人\\n更熟悉這裡的寶可夢了！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
