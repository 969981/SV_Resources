    },
    {
      "ordinal": 10,
      "label": "kizuna_dragon_b_tamer_02",
      "hash64": "0E3DFD9305CD8605",
      "text": "저희는 무엇보다\\n일족을 우선시하니까요.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
