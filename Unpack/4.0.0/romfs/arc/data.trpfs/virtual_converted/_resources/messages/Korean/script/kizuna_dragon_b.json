          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_dragon_b_06",
      "hash64": "268D86536FED8653",
      "text": "학교에는 오지 말라고\\n그렇게나 말씀드렸잖습니까.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
