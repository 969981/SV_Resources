      ]
    },
    {
      "ordinal": 2,
      "label": "common_2020_kusa_020_kusa_03",
      "hash64": "9A4E4EC60C312844",
      "text": "Tu te souviens sûrement de mon entrée en scène !\\c\\nSi je bondis du haut de ce moulin sous les yeux\\nébahis des prétendants à mon Badge, c’est pour\\r\\najouter de la tension dramatique à nos combats.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
