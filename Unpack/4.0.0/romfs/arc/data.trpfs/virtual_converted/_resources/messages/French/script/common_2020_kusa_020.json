          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_2020_kusa_020_select_01",
      "hash64": "84589E7D23A65B06",
      "text": "Je vois !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_kusa_020_select_02",
      "hash64": "84589D7D23A65953",
      "text": "Je vois...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_2020_kusa_020_kusa_04",
      "hash64": "9A4E4DC60C312691",
      "text": "Je savais que tu comprendrais !\\nHa ha ha ![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_kusa_020_kusa_05",
      "hash64": "9A4E4CC60C3124DE",
      "text": "Cela dit, je pense pouvoir épargner mes pauvres\\npieds, aujourd’hui. Ce combat à lui seul s’annonce\\r\\ncomme ma plus belle œuvre à ce jour,\\r\\nmême sans le frisson d’un tel plongeon ![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 182,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_kusa_020_kusa_06",
      "hash64": "9A4E4BC60C31232B",
      "text": "Après tout, notre art s’exprime à notre place.\\nDès lors, les mots sont inutiles.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_kusa_020_kusa_07",
      "hash64": "9A4E4AC60C312178",
      "text": "Allons, es-tu prêt[VAR 0x1100(00FF,0100)]e ?\\nC’est l’heure de notre... œuvre collaborative ![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_kusa_020_kusa_08",
      "hash64": "9A4E49C60C311FC5",
      "text": "Quel combat créatif ! Les couleurs fusaient\\net se transformaient dans un dégradé sublime ![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_kusa_020_kusa_09",
      "hash64": "9A4E48C60C311E12",
      "text": "Un déchaînement furieux, mais empreint\\nd’une grâce infinie ! Mes félicitations pour\\r\\nla création de cet ineffable contraste ![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2020_kusa_020_kusa_10",
      "hash64": "9A4ACBC60C2E13D4",
      "text": "Se battre contre toi est un vrai plaisir... Ça me\\nrappelle quand je débutais en tant qu’artiste...[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2020_kusa_020_kusa_11",
      "hash64": "9A4ACCC60C2E1587",
      "text": "Ah, mais j’y pense. Ta présence ici avait trait\\nà l’inspection de mon Arène pour la Maîtresse\\r\\nen Chef, il me semble.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_2020_kusa_020_kusa_12",
      "hash64": "9A4ACDC60C2E173A",
      "text": "Je n’ai que peu d’intérêt pour ces choses-là.\\nFais-lui le rapport que tu voudras.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_2020_kusa_020_kusa_13",
      "hash64": "9A4ACEC60C2E18ED",
      "text": "Aaah ! L’inspiration m’est venue et ne me quitte\\nplus... Je la perçois de toutes parts... ![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_2020_kusa_020_kusa_14",
      "hash64": "9A4AC7C60C2E0D08",
      "text": "Je dois m’atteler à ma prochaine œuvre, donc\\nsi tu veux bien m’excuser... Au revoir ![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
