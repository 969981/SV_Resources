    },
    {
      "ordinal": 43,
      "label": "gym_mizu_020_mizu_19",
      "hash64": "930E81305CF3E50E",
      "text": "这是用来拍卖的经费！\\n要多动脑筋，把它拍下来啊！[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
