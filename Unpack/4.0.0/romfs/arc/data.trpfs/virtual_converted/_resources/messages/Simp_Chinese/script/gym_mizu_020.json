      "ordinal": 60,
      "label": "gym_mizu_020_mizu_20",
      "hash64": "931180305CF61932",
      "text": "你让大人都甘拜下风了！\\n哦～！真是太了不起啦！[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
