    },
    {
      "ordinal": 42,
      "label": "gym_mizu_020_mizu_18",
      "hash64": "930E82305CF3E6C1",
      "text": "啊、哈、哈！你小小年纪\\n却知道什么是拍卖吗！？\\r\\n好强的孩子啊！[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
