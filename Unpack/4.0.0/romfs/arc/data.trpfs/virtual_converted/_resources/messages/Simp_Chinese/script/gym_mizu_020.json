    {
      "ordinal": 59,
      "label": "gym_mizu_020_seri_04b",
      "hash64": "3B0D518C038798D4",
      "text": "好！[VAR 0x0205(0001,0000)]！\\n是那位小姐拍下的！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
