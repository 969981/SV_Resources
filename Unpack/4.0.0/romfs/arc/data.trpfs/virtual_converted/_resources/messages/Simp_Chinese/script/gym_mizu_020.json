      "hash64": "C2234DBAFFC0FFB4",
      "text": "[VAR 0x0100(0000)]把传说的裙带菜\\n交给了海岱。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
