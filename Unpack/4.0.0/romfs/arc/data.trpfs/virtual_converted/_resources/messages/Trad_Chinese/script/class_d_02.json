    {
      "ordinal": 15,
      "label": "class_d_02_language_08",
      "hash64": "F15ABFCD7B82E40B",
      "text": "要是在市場或餐廳\\n用當地的語言說聲「好吃」，\\r\\n店裡的人也會開心地笑一個！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
