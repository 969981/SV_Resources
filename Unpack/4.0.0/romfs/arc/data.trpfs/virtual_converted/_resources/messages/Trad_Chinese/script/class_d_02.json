      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_d_02_select_03",
      "hash64": "30B8D43961E44CF0",
      "text": "救救我",
      "flags": 0,
