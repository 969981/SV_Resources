    {
      "ordinal": 14,
      "label": "class_d_02_language_07",
      "hash64": "F15ABCCD7B82DEF2",
      "text": "Delicious！おいしい！Buono！\\n這些全都是「好吃」的意思！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
