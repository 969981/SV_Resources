          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_02_language_05",
      "hash64": "F15ABACD7B82DB8C",
      "text": "Today，讓我們用一個在海外說了\\n會令人很高興的字當主題，\\r\\n來一堂賽吉的語言課吧！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
