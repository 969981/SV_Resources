          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_d_02_language_09",
      "hash64": "F15ABECD7B82E258",
      "text": "然後要溝通時就會\\n極度極～度地順利喔！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
