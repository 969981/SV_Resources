      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_d_02_language_answer_01",
      "hash64": "DE6A8E54C60CCA99",
      "text": "噢，super duper正確答案！\\n真不愧是[VAR 0x0100(0000)]！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
