    {
      "ordinal": 1,
      "label": "coach_bb_brother_first_01",
      "hash64": "F30AFA70D5D81B18",
      "text": "[EMPTY 67]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
