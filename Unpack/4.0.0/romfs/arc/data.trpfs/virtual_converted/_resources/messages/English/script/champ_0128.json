        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0128_rival_06b",
      "hash64": "076F0C46F6453F9C",
      "text": "That’s a W for me! You battled real well, though![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
