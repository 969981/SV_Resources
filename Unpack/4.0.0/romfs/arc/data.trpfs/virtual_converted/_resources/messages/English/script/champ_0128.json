        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0128_rival_07",
      "hash64": "A5DB8F7965335D49",
      "text": "I think that should be enough of a warm-up![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
