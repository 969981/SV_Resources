    {
      "ordinal": 5,
      "label": "champ_0128_rival_06a",
      "hash64": "076F0F46F64544B5",
      "text": "That’s an L for me! Man, you’ve gotten so good![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
