          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_fairy_010_jentle_02",
      "hash64": "F21FF300C8F58CB8",
      "text": "Until then, please give him my regards.[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "ajito_fairy_010_sitappa_01",
      "hash64": "C28BA22AC279F395",
      "text": "Y-yes, Mr. Harrington![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_fairy_010_jentle_03",
      "hash64": "F21FF400C8F58E6B",
      "text": "Hm?[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_fairy_010_jentle_04",
      "hash64": "F21FF900C8F596EA",
      "text": "And who might you be, young [VAR 0x1100(00FF,0403)]manlady? A friend of\\nthe young master, perhaps?[VAR 0x0114(003C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0403"
          ]
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_fairy_010_select_01",
      "hash64": "39F812E04BEE9F91",
      "text": "“Young master”?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "ajito_fairy_010_select_02",
      "hash64": "39F80FE04BEE9A78",
      "text": "Errr... I’m not sure!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_fairy_010_jentle_05",
      "hash64": "F21FFA00C8F5989D",
      "text": "Ah. I see...[VAR 0x0114(003C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_fairy_010_jentle_06",
      "hash64": "F21FF700C8F59384",
      "text": "Since you seem unaware, I must inform you that\\nthis is the base of Team Star’s Fairy crew—the\\r\\nRuchbah Squad led by young Master Ortega.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_fairy_010_sitappa_02",
      "hash64": "C28B9F2AC279EE7C",
      "text": "Um, Mr. Harrington? I don’t think we’re supposed\\nto be giving out that information...[VAR 0x0114(002F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_fairy_010_jentle_07",
      "hash64": "F21FF800C8F59537",
      "text": "No? Then please accept my apologies.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_fairy_010_jentle_08",
      "hash64": "F21FED00C8F58286",
      "text": "Do you have any idea as to who this young [VAR 0x1100(00FF,0403)]manlady\\nmight be?[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0403"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_fairy_010_sitappa_03",
      "hash64": "C28BA02AC279F02F",
      "text": "[VAR 0x1100(00FF,0201)]HShe’s no friend of ours. Y’know, I think [VAR 0x1100(00FF,0100)]she might\\nbe here to try and take us on![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0201"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_fairy_010_jentle_09",
      "hash64": "F21FEE00C8F58439",
      "text": "Understood. In that case...I take it you’re an\\nadversary of the young master?[VAR 0x0114(003C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "ajito_fairy_010_select_03",
      "hash64": "39F810E04BEE9C2B",
      "text": "Yup, that’s right!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "ajito_fairy_010_select_04",
      "hash64": "39F815E04BEEA4AA",
      "text": "I...guess that follows?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "ajito_fairy_010_jentle_10",
      "hash64": "F2237B00C8F8A9A7",
      "text": "Is that so. Well then, that leaves me with one last\\nthing to ask you...[VAR 0x0114(003C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_fairy_010_sitappa_04",
      "hash64": "C28B9D2AC279EB16",
      "text": "Huh?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_fairy_010_jentle_11",
      "hash64": "F2237A00C8F8A7F4",
      "text": "Would you be so kind as to indulge me in a\\nquick battle?[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "ajito_fairy_010_jentle_12",
      "hash64": "F2237D00C8F8AD0D",
      "text": "Ah, yes, I suppose you must need to prepare.\\nI will wait until you have your affairs in order.[VAR 0x0114(003C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_fairy_010_jentle_13",
      "hash64": "F2237C00C8F8AB5A",
      "text": "Splendid. Then let us begin.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_fairy_010_jentle_14",
      "hash64": "F2237700C8F8A2DB",
      "text": "An outstanding performance.[VAR 0x0114(003C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "ajito_fairy_010_jentle_15",
      "hash64": "F2237600C8F8A128",
      "text": "However. Be aware that young Master Ortega’s\\nbattle prowess far surpasses my paltry skills.\\r\\nYou would do well to take care.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "ajito_fairy_010_jentle_16",
      "hash64": "F2237900C8F8A641",
      "text": "Now, if you’ll excuse me.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "ajito_fairy_010_sitappa_05",
      "hash64": "C28B9E2AC279ECC9",
      "text": "H-hasta la vistar... ☆[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "ajito_fairy_010_sitappa_06",
      "hash64": "C28B9B2AC279E7B0",
      "text": "That gentlemanly guy used to be the director of\\nthe academy...I think? Least, that’s what I heard.\\c\\nNow he’s, like, tutoring the boss or something.\\nHe shows up here sometimes to take the boss\\r\\nto his lessons...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 193,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 214,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "ajito_fairy_010_sitappa_07",
      "hash64": "C28B9C2AC279E963",
      "text": "Hang on—why am I explaining this to you?![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "ajito_fairy_010_sitappa_08",
      "hash64": "C28BA92AC279FF7A",
      "text": "There’s no doubting you’re here to make trouble,\\nso I gotta go let everyone know![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "ajito_fairy_010_sitappa_09",
      "hash64": "C28BAA2AC27A012D",
      "text": "Hasta la vistaaar! ☆[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
