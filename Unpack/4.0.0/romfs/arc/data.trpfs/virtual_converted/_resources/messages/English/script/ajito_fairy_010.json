    {
      "ordinal": 0,
      "label": "ajito_fairy_010_jentle_01",
      "hash64": "F21FF600C8F591D1",
      "text": "I will return later when it is time for the young\\nmaster’s piano lesson.[VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
