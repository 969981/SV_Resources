        }
      ]
    },
    {
      "ordinal": 17,
      "label": "school_main_chara_battleteacher_02",
      "hash64": "FCF05E98B306AB37",
      "text": "Tach, Neuzugang! Wie sieht’s aus?\\nTrainierst du auch fleißig?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
