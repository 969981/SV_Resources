    },
    {
      "ordinal": 16,
      "label": "school_main_chara_battleteacher_01",
      "hash64": "FCF05F98B306ACEA",
      "text": "Tach, Neuzugang! Muskeln sind schon eine\\nstarke Sache, findest du nicht auch?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
