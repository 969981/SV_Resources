    },
    {
      "ordinal": 1,
      "label": "coach_teacher_battle_first_01",
      "hash64": "DD62798DBA6EF8DC",
      "text": "C’est moi, madame Élige, l’impétueuse ! J’espère\\nque tout le monde est prêt à se laisser submerger\\r\\npar la combativité ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
