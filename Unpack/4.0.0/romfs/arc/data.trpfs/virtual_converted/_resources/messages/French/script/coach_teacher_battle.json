          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_battle_sp01_00",
      "hash64": "34032E597B9C9561",
      "text": "Yo ! Ça va, l[VAR 0x1100(00FF,0A09)]e nouveaua nouvelle ? J’ai reçu ton invitation ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0A09"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_battle_sp01_01",
      "hash64": "34032D597B9C93AE",
      "text": "C’est très stimulant d’être sur un nouveau lieu\\nde travail ! Je ne tiens plus en place ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_battle_sp01_02",
      "hash64": "34032C597B9C91FB",
      "text": "Bon, j’imagine que tu ne m’as pas appelée\\nsans raison.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_battle_sp01_03",
      "hash64": "34032B597B9C9048",
      "text": "Qu’est-ce que tu attends de moi ?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_battle_sp01_select_01",
      "hash64": "1C6E62F201B3B63D",
      "text": "De l’impétuosité !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_battle_sp01_select_02",
      "hash64": "1C6E5FF201B3B124",
      "text": "Que vous transmettiez votre savoir !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_battle_sp01_select_03",
      "hash64": "1C6E60F201B3B2D7",
      "text": "Votre présence suffit !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_battle_sp01_04",
      "hash64": "340332597B9C9C2D",
      "text": "Pas besoin de me le dire deux fois !\\nMon ardeur va enflammer l’Institut Myrtille ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_battle_sp01_04b",
      "hash64": "FE0ADD0D0B1D9A3D",
      "text": "Compte sur moi ! Je m’attendais à ce qu’on exige\\ndes connaissances approfondies en combat.\\c\\nPas étonnant venant d’une école qui accorde\\nune telle importance à cette discipline ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 179,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_battle_sp01_04c",
      "hash64": "FE0ADC0D0B1D988A",
      "text": "Je ne m’attendais pas à ça ! Mais, moi aussi,\\nça me fait plaisir de te voir, l[VAR 0x1100(00FF,0A09)]e nouveaua nouvelle.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0A09"
          ]
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_battle_sp01_05",
      "hash64": "340331597B9C9A7A",
      "text": "En tout cas, fais-moi confiance. Je donnerai tout\\nce que j’ai pour vous transmettre ma vigueur ![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_battle_sp01_06",
      "hash64": "340330597B9C98C7",
      "text": "Vous êtes en bonnes mains avec moi ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_battle_sp02_00",
      "hash64": "8D37EC72C2EDB86E",
      "text": "Yo, l[VAR 0x1100(00FF,0A09)]e nouveaua nouvelle !\\nTu ne trouves pas le Terra-Dôme génial ?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0A09"
          ]
        },
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_battle_sp02_01",
      "hash64": "8D37ED72C2EDBA21",
      "text": "En fait, cet endroit est l’équivalent de la cour\\nde l’académie, je pense ![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_battle_sp02_02",
      "hash64": "8D37EA72C2EDB508",
      "text": "Sauf qu’on y ressent un plus grand sentiment\\nde liberté !\\r\\nFaire un jogging ici doit être vraiment grisant ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_battle_sp02_03",
      "hash64": "8D37EB72C2EDB6BB",
      "text": "D’ailleurs, je me disais que je proposerais bien\\naux élèves de faire le tour du dôme en courant\\r\\ndans mon prochain cours de travaux pratiques.\\r\\nTu en penses quoi ?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_battle_sp02_select_01",
      "hash64": "37A1D076C23731E0",
      "text": "C’est une bonne idée !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_battle_sp02_select_02",
      "hash64": "37A1D376C23736F9",
      "text": "Euh... C’est beaucoup leur demander, non ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_battle_sp02_04",
      "hash64": "8D37F072C2EDBF3A",
      "text": "C’est décidé, alors ! Il n’y a que du positif\\nà faire de l’exercice, après tout ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_battle_sp02_04b",
      "hash64": "E3CCEB0139FC2288",
      "text": "Ah, tu trouves que c’est un peu exagéré ?\\c\\nC’est vrai, je me suis laissé emporter par mon\\nenvie de me dépenser... Ils n’ont qu’à faire\\r\\nle tour de la moitié du dôme seulement, alors ![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 187,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_battle_sp02_05",
      "hash64": "8D37F172C2EDC0ED",
      "text": "Je t’invite évidemment à te joindre à nous !\\nCe sera une bonne expérience ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_battle_sp03_00",
      "hash64": "36D2226B2783F7FF",
      "text": "Les élèves de cette école débordent\\nde motivation ! Ça fait plaisir à voir ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_battle_sp03_01",
      "hash64": "36D2216B2783F64C",
      "text": "Je ne m’attendais pas à ce que tout ce petit\\nmonde soit si attentif pendant mon cours ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_battle_sp03_02",
      "hash64": "36D2246B2783FB65",
      "text": "Mais finalement, c’est assez logique.\\nLes matières liées aux combats Pokémon ont\\r\\nd’énormes coefficients, ici, si j’ai bien compris.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_battle_sp03_03",
      "hash64": "36D2236B2783F9B2",
      "text": "Devenir Dresseur ou Dresseuse pro est tout à fait\\nà la portée de ces élèves !\\c\\nVu leur niveau, ils pourraient très bien travailler\\nà la Ligue ou en tant que Pokémon Rangers.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 175,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_battle_sp03_select_01",
      "hash64": "C4EEFAC9B85C331B",
      "text": "Ça fait rêver !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_battle_sp03_select_02",
      "hash64": "C4EEFBC9B85C34CE",
      "text": "C’est vrai ?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_battle_sp03_04",
      "hash64": "36D21E6B2783F133",
      "text": "Et bien sûr, il leur est aussi possible de devenir\\nprofesseur de combat, comme moi ![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_battle_sp03_04b",
      "hash64": "AAFB011425330CA3",
      "text": "Ne me dis pas que c’est la première fois\\nqu’on te parle de vos futures carrières !\\c\\nDevenir Maître[VAR 0x1100(00FF,0300)]sse n’était donc pas lié\\nà un projet professionnel particulier ?!\\c\\nÇa en dit long sur l’amour inconditionnel\\nque tu portes aux Pokémon ![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0300"
          ]
        },
        {
          "kind": "control",
          "offset_units": 170,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 243,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_battle_sp03_05",
      "hash64": "36D21D6B2783EF80",
      "text": "En bref, que ce soit dans l’art du combat ou dans\\nun autre domaine, n’oublie pas que si tu étudies\\r\\navec ardeur, rien n’est impossible ![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_battle_sp03_06",
      "hash64": "36D2206B2783F499",
      "text": "On ne perd jamais son temps à travailler\\nsur soi-même, alors donne-t’en à cœur joie ![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
