          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "atlantis_talk_05_rival_01b",
      "hash64": "37DEC52B4066CEB1",
      "text": "Miraidon ist ein Pokémon aus der Zukunft...\\nKein Wunder, dass niemand es je gesehen hat![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "atlantis_talk_05_rival_02",
      "hash64": "169E9D8064C84F50",
      "text": "Hey, [VAR 0x0100(0000)]! Ich muss einfach gegen\\n[VAR 0x0101(0001)] antreten! Am besten sofort![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "atlantis_talk_05_botan_01",
      "hash64": "83B6F385AE7EA1A3",
      "text": "Ich glaube, es hat momentan nicht das geringste\\nInteresse daran, aus seinem Pokéball zu kommen.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "atlantis_talk_05_rival_03",
      "hash64": "169E9E8064C85103",
      "text": "Oh... Stimmt ja.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "atlantis_talk_05_friend_01a",
      "hash64": "D0DB0588BEACC0F6",
      "text": "Ich hör auch zum ersten Mal, dass es aus der\\nVergangenheit kommt...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "atlantis_talk_05_friend_01b",
      "hash64": "D0DB0488BEACBF43",
      "text": "Ich hör auch zum ersten Mal, dass es aus der\\nZukunft kommt...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "atlantis_talk_05_friend_02a",
      "hash64": "D0DEED88BEB08105",
      "text": "Für mich war es einfach nur ein Ding, das meine\\nMutter plötzlich mit nach Hause gebracht hat.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "atlantis_talk_05_friend_02b",
      "hash64": "D0DEEA88BEB07BEC",
      "text": "Für mich war es einfach nur ein Ding, das mein\\nVater plötzlich mit nach Hause gebracht hat.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "atlantis_talk_05_friend_03",
      "hash64": "6C5A0731BFB3E7B9",
      "text": "Wir haben damals eine Zeit lang zusammen im\\nLeuchtturm-Labor gelebt.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "atlantis_talk_05_friend_04",
      "hash64": "6C5A0831BFB3E96C",
      "text": "Ich musste versprechen, seine Existenz geheim zu\\nhalten. Und ich sollte mich um es kümmern...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "atlantis_talk_05_rival_04",
      "hash64": "169EA38064C85982",
      "text": "Das erklärt, warum du so viel über es weißt![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "atlantis_talk_05_friend_05",
      "hash64": "6C5A0931BFB3EB1F",
      "text": "Jepp... Aber eines Tages hat sich [VAR 0x0101(0001)]\\nplötzlich auf ein wildes Pokémon gestürzt.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "atlantis_talk_05_friend_06",
      "hash64": "6C5A0A31BFB3ECD2",
      "text": "Die Leute in der Gegend hätten es beinahe\\ngesehen...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "atlantis_talk_05_friend_07a",
      "hash64": "D0EFE988BEBEED6C",
      "text": "Kurze Zeit später ist meine Mutter mit ihm zurück\\nnach Zone Null gegangen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "atlantis_talk_05_friend_07b",
      "hash64": "D0EFEC88BEBEF285",
      "text": "Kurze Zeit später ist mein Vater mit ihm zurück\\nnach Zone Null gegangen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "atlantis_talk_05_botan_05",
      "hash64": "83B6F785AE7EA86F",
      "text": "Verständlich... Schließlich ist es ein Pokémon aus\\neinem anderen Zeitalter.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "atlantis_talk_05_friend_08",
      "hash64": "6C5A0C31BFB3F038",
      "text": "Genau. Wenn das rauskäme, gäbe es einen\\nriesigen Aufruhr.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "atlantis_talk_05_friend_09a",
      "hash64": "D0F5F588BEC36D7E",
      "text": "Danach hab ich meine Mutter nicht mehr gesehen.\\nUnd Koraidon auch nicht... bis vor Kurzem.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "atlantis_talk_05_friend_09b",
      "hash64": "D0F5F488BEC36BCB",
      "text": "Danach hab ich meinen Vater nicht mehr gesehen.\\nUnd Miraidon auch nicht... bis vor Kurzem.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "atlantis_talk_05_friend_09",
      "hash64": "6C5A0D31BFB3F1EB",
      "text": "So im Nachhinein klingt es irgendwie kindisch,\\naber...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "atlantis_talk_05_friend_10",
      "hash64": "6C5D8A31BFB6FC29",
      "text": "Damals glaubte ich, es hätte mir meine[VAR 0x1107(00FF,0404)] Mutn Vater\\ngestohlen... Das war ein schreckliches Gefühl.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0404"
          ]
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "atlantis_talk_05_friend_11",
      "hash64": "6C5D8931BFB6FA76",
      "text": "Ich hab [VAR 0x0101(0001)] richtig gehasst und wollte\\nnicht mal über es reden.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "atlantis_talk_05_friend_12",
      "hash64": "6C5D8831BFB6F8C3",
      "text": "Tut mir leid, [VAR 0x0100(0000)]... Ich hätte früher\\netwas sagen sollen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "atlantis_talk_05_rival_10",
      "hash64": "16A1A58064CA92BF",
      "text": "Ja, hättest du! Wie konntest du so was Krasses\\nnur für dich behalten?![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "atlantis_talk_05_botan_06",
      "hash64": "83B6F885AE7EAA22",
      "text": "Du hättest ja zumindest etwas sagen können,\\nbevor wir hier aufgeschlagen sind...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "atlantis_talk_05_friend_13",
      "hash64": "6C5D8731BFB6F710",
      "text": "H-Hey, ein bisschen Mitgefühl wär auch\\nschön gewesen...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
