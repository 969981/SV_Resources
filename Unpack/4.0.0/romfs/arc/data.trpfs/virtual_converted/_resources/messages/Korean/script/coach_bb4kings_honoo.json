    },
    {
      "ordinal": 13,
      "label": "coach_bb4kings_honoo_sp02_00",
      "hash64": "EE5437582F6D29C7",
      "text": "[VAR 0x0100(0000)]!\\n[VAR 0x0100(0000)][VAR 0x1900(0001)] 요리 좋아해!?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
