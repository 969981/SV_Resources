    {
      "ordinal": 3,
      "label": "coach_bb4kings_honoo_sp01_01",
      "hash64": "C24D2E51CE0315CB",
      "text": "카지와의 승부!\\n아주 강불로 타올랐었어!![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
