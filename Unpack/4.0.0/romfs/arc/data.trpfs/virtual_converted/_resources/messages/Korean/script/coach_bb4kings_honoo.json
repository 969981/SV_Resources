          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_bb4kings_honoo_sp01_02",
      "hash64": "C24D2F51CE03177E",
      "text": "북신에서 돌아온 뒤로\\n패배를 모르던 카지에게\\r\\n완벽하게 승리하다니![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb4kings_honoo_sp01_03",
      "hash64": "C24D3051CE031931",
      "text": "블루베리그를 순식간에\\n활활 타오르게 할 만한 승부였다니까![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_bb4kings_honoo_sp01_04",
      "hash64": "C24D3151CE031AE4",
      "text": "그런데!\\n[VAR 0x0100(0000)][VAR 0x1900(0003)] 챔피언이 됐으니\\r\\n카지는 사천왕으로 내려올 거고...[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "1900",
          "args_hex": [
            "0003"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_bb4kings_honoo_sp01_05",
      "hash64": "C24D3251CE031C97",
      "text": "그렇게 되면 사천왕 중 최약체인 나는\\n아쉽게도 자리를 내줘야 하는 거야![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_bb4kings_honoo_sp01_select_01",
      "hash64": "3E4ABBAA2F752252",
      "text": "그렇구나!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_bb4kings_honoo_sp01_select_02",
      "hash64": "3E4ABAAA2F75209F",
      "text": "미안!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "coach_bb4kings_honoo_sp01_06",
      "hash64": "C24D3351CE031E4A",
      "text": "이야~ 진짜 곤란하게 됐다니까!\\n그렇지만, 룰이니까 어쩔 수 없지![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb4kings_honoo_sp01_07",
      "hash64": "C24D3451CE031FFD",
      "text": "그래도, 리그부가\\n예전 같은 분위기를 되찾은 것 같아서\\r\\n개인적으로는 지금이 더 좋아![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb4kings_honoo_sp01_08",
      "hash64": "C24D2551CE030680",
      "text": "이게 다 [VAR 0x0100(0000)] 덕분이야!\\n직화로 전해 주고 싶었어!\\r\\n고마워![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
