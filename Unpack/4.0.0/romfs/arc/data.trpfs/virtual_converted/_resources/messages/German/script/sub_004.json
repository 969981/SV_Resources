    {
      "ordinal": 2,
      "label": "sub_004_01",
      "hash64": "93AEF6B5DB5A8D28",
      "text": "Herzlichen Glückwunsch zu deinem Sieg\\nüber Ronah!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_004_02",
      "hash64": "93AEF9B5DB5A9241",
      "text": "Jetzt, wo du den Arenaorden von Ronah hast,\\nkannst du dich beim Olivenrollen an einer\\r\\nbesonderen Herausforderung versuchen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_004_03",
      "hash64": "93AEF8B5DB5A908E",
      "text": "Bei dieser speziellen Art des Olivenrollens wird\\nnämlich deine Zeit gemessen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_004_04",
      "hash64": "93AEFBB5DB5A95A7",
      "text": "Wenn du es schaffst, eine Spitzenzeit zu erzielen,\\nerhältst du ein tolles Geschenk.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_004_05",
      "hash64": "93AEFAB5DB5A93F4",
      "text": "Möchtest du dich der speziellen Herausforderung\\nbeim Olivenrollen stellen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_004_chose_1",
