      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_math_a_select_05",
      "hash64": "306B2535068E4B95",
      "text": "Nein, hab alles verstanden!",
      "flags": 0,
      "text_status": "DECODED",
