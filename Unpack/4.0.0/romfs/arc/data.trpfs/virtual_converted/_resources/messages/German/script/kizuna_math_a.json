          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_a_07",
      "hash64": "FA7C767826544618",
      "text": "Flug-Pokémon haben eine Schwäche\\ngegenüber dem Typ Gestein.\\c\\nWas passiert also mit dem Schaden einer\\nGesteins-Attacke, die ein Flug-Pokémon trifft?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
