      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_math_a_mob_04",
      "hash64": "74F370AA300E430A",
      "text": "Äh, ja! Dann warte ich! Das kann ich nämlich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
