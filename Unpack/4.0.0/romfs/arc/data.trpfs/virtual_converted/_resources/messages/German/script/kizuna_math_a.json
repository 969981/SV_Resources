      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_a_09",
      "hash64": "FA7C7478265442B2",
      "text": "Da ist aber jemand energiegeladen! Doch du\\nmusst warten, bis du an der Reihe bist.\\r\\nIch kann mich schließlich nicht zweiteilen![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
