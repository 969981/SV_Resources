          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_a_select_01",
      "hash64": "306B2135068E44C9",
      "text": "Er bleibt gleich.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_a_select_02",
      "hash64": "306B1E35068E3FB0",
      "text": "Er wird verdoppelt.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_a_select_03",
      "hash64": "306B1F35068E4163",
      "text": "Er wird verhundertfacht.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_a_08a",
      "hash64": "F5BF9F29212F92CC",
      "text": "Ganz genau! Der Schaden wird verdoppelt.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
