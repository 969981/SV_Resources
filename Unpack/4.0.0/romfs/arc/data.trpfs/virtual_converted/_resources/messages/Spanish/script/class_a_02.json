          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_a_02_ecology_02_old_00",
      "hash64": "48291636FE03F357",
      "text": "En la lección anterior os expliqué cómo lanzar la\\nPoké Ball con el botón ZR. ¿Lo habéis probado?[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_a_02_ecology_03",
      "hash64": "056101908DD0AEFF",
      "text": "Si sacáis a los Pokémon a pasear con vosotros,\\n¡veréis que tienen una gran personalidad!\\c\\nSi es que son todo un amor...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_a_02_ecology_04",
      "hash64": "0560FE908DD0A9E6",
      "text": "Lo ideal para pasar un buen rato con todos los\\nPokémon del equipo es hacer un pícnic.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_a_02_ecology_05",
      "hash64": "0560FF908DD0AB99",
      "text": "No hay nada como jugar con ellos, sentarse\\njuntos y preparar unos ricos bocadillos...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_a_02_ecology_06",
      "hash64": "0560FC908DD0A680",
      "text": "Por cierto, si queréis saber cómo hacer que os\\nqueden buenísimos, prestad atención en la clase\\r\\nde Hugo. Ahí lo dejo.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_a_02_ecology_07",
      "hash64": "0560FD908DD0A833",
      "text": "Dicho esto, cuando montéis un pícnic, a veces\\nencontraréis algo en la Cesta junto a la mesa.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_a_02_ecology_08",
      "hash64": "05610A908DD0BE4A",
      "text": "Algo muy pero que muy importante...[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_a_02_ecology_09",
      "hash64": "05610B908DD0BFFD",
      "text": "Me refiero a esa cosa de la que nacen los\\nPokémon... ¿Alguien sabe a qué me refiero?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_a_02_select_01",
      "hash64": "3A32B96E379E9D53",
      "text": "A las cajas",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_a_02_select_02",
      "hash64": "3A32BA6E379E9F06",
      "text": "A las Poké Balls",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_a_02_select_03",
      "hash64": "3A32BB6E379EA0B9",
      "text": "A los Huevos",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_a_02_ecology_answer_01",
      "hash64": "3571AB7985C94A06",
      "text": "Si no me falla la memoria, tú eres [VAR 0x1100(00FF,0202)]ella chic[VAR 0x1100(00FF,0101)]oa nuev[VAR 0x1100(00FF,0101)]oa.\\n[VAR 0x0100(0000)], ¿no?\\c\\nLos Pokémon se pueden guardar en las cajas,\\npero no nacen de ellas.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
