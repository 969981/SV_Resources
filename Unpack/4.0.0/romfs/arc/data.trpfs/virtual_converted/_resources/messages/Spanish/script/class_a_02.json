      "ordinal": 0,
      "label": "class_a_02_ecology_01_old_00",
      "hash64": "75A030D90C5F91DC",
      "text": "Hola, claseee. ¡Es hora de darle duro al estudio![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
