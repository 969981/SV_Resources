    {
      "ordinal": 10,
      "label": "class_d_07_poke_02",
      "hash64": "01CFB09AF1E7E977",
      "text": "Chuuu!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_d_07_language_08",
      "hash64": "F78078D5B9B465A0",
      "text": "Ach, da schwappen die Emotionen ja beinahe auf\\nuns über![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
