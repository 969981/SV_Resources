      "hash64": "F78081D5B9B474EB",
      "text": "Hallo, meine lieben Kursteilnehmer! Geht es euch\\nallen gut?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
