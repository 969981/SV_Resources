    {
      "ordinal": 16,
      "label": "class_d_07_select_04",
      "hash64": "9CDF92736583E476",
      "text": "Kannst du das wiederholen, Pikachu?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_d_07_language_answer_01",
      "hash64": "2EFDD0FDDC43E69C",
