    {
      "ordinal": 20,
      "label": "class_d_07_language_10",
      "hash64": "F78406D5B9B78CC1",
      "text": "Hört euch seinen Ruf noch einmal genau an.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
