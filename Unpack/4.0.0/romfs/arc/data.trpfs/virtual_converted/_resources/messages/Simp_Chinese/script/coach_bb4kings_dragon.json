            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_bb4kings_dragon_reward_00",
      "hash64": "B9F96A0C22417733",
      "text": "[VAR 0x0100(0000)]从杜若那里\\n获得了[VAR 0xFF00(0008)]运动服套装（黑×金）[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
