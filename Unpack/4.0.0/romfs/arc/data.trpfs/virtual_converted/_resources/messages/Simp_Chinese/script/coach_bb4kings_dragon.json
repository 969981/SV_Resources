          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "coach_bb4kings_dragon_talkto_00",
      "hash64": "B9FCE9D079D8516B",
      "text": "嘿，[VAR 0x1100(00FF,0101)]哥姐们，\\n要和我对战吗？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
