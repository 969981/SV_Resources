      "hash64": "0DC137C9AC11B066",
      "text": "嗨～冠军。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
