    },
    {
      "ordinal": 3,
      "label": "coach_bb4kings_dragon_sp01_01",
      "hash64": "0DC138C9AC11B219",
      "text": "蓝莓联盟\\n辛苦咯。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
