    },
    {
      "ordinal": 52,
      "label": "coach_bb4kings_dragon_battleend_win_00_01",
      "hash64": "78D9E6A76068001C",
      "text": "为了表达平时对你的感谢！\\n我有件礼物要送给你～[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
