          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_bb4kings_dragon_battleend_win_00_02",
      "hash64": "78D9E9A760680535",
      "text": "在衣柜里放得都吃灰了。\\n你收下它吧～[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_bb4kings_dragon_battleend_win_00_03",
      "hash64": "78D9E8A760680382",
      "text": "嘿嘿嘿，\\n上衣和我的一样哦～\\r\\n这就叫穿成一对儿啊！[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
