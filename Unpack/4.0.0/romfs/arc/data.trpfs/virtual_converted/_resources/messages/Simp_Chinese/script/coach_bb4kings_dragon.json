            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_bb4kings_dragon_battleend_win_01_00",
      "hash64": "4E5B71B2A9CFE8FE",
      "text": "你的实力又～提高了，\\n不愧是我的[VAR 0x1100(00FF,0101)]哥姐们！[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
