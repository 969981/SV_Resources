          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "coach_bb4kings_dragon_trade_04_00",
      "hash64": "1AB13EC5614EFDEF",
      "text": "你愿意配合了！？\\n那好～我们来交换宝可梦吧～！[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
