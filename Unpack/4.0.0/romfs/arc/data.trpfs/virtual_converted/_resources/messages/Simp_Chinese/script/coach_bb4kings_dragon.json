          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "coach_bb4kings_dragon_cancel_00",
      "hash64": "FE6E4021D9852C18",
      "text": "拒绝也不是坏事啊。\\n啥时候都拼尽全力是会累的。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "coach_bb4kings_dragon_battlestart_00",
      "hash64": "E7FDEDCFAD2EFC02",
      "text": "那好～\\n差不多去对战场吧。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_bb4kings_dragon_battlestart_01",
      "hash64": "E7FDEECFAD2EFDB5",
      "text": "哎呀，[VAR 0x1100(00FF,0101)]哥姐们！\\n我想和你打的是双打对战，\\r\\n再多带一只宝可梦来吧～[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
