    },
    {
      "ordinal": 40,
      "label": "coach_bb4kings_dragon_trade_02_00",
      "hash64": "931382940D093475",
      "text": "[VAR 0x1100(00FF,0101)]哥姐们你要用[VAR 0x0101(0001)]\\n来交换我的铝钢龙，对吧？[VAR 0x0114(004A)]",
