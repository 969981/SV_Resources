          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_bb4kings_dragon_battleend_win_01_01",
      "hash64": "4E5B72B2A9CFEAB1",
      "text": "如果不经常和\\n[VAR 0x0100(0000)]你过招的话，\\r\\n我都变得不能发泄压力了。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_bb4kings_dragon_battleend_lose_00_00",
      "hash64": "3F5056F5910DC656",
      "text": "嘿嘿嘿！\\n捡漏赢了一把。\\c\\n你就算觉得输了不甘心，\\n也别像乌栗那样走极端哦。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_bb4kings_dragon_randomtalk_00",
      "hash64": "8E0EAA7E32F9DEC5",
      "text": "你肯定以为我腰上的\\n是裙子吧～？\\c\\n不是的～嘿嘿嘿～！\\n其实是围着斗篷哦。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "coach_bb4kings_dragon_randomtalk_01",
      "hash64": "8E0EA97E32F9DD12",
      "text": "我啊，不太擅长理论课～\\n留了大概……３次级？\\c\\n我比其他的家伙享受了\\n更长的学园生活，赚到了～[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "coach_bb4kings_dragon_randomtalk_02",
      "hash64": "8E0EA87E32F9DB5F",
      "text": "椅子真是个好东西，\\n我爱死椅子了。\\c\\n明明站着很累，\\n为啥大家都要站着呢？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "coach_bb4kings_dragon_randomtalk_03",
      "hash64": "8E0EA77E32F9D9AC",
      "text": "我和[VAR 0x1100(00FF,0101)]哥姐们你的[VAR 0x0101(0001)]\\n相处得很好～\\c\\n我会像对[VAR 0x0100(0000)]你一样\\n疼爱它的，你就放心吧～[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "coach_bb4kings_dragon_randomtalk_04",
      "hash64": "8E0EA67E32F9D7F9",
