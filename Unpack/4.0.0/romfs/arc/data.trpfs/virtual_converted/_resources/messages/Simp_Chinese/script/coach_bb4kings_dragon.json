    },
    {
      "ordinal": 42,
      "label": "coach_bb4kings_dragon_trade_02_02",
      "hash64": "931380940D09310F",
      "text": "无法使用稀有宝可梦\\n进行交换。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "coach_bb4kings_dragon_trade_02_03",
      "hash64": "93137F940D092F5C",
      "text": "无法使用异色宝可梦\\n进行交换。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 44,
      "label": "coach_bb4kings_dragon_trade_03_00",
      "hash64": "EABF4C9BA987B784",
      "text": "啊～[VAR 0x1100(00FF,0101)]哥姐们你现在不会\\n只有１只同行的宝可梦吧？\\c\\n要是没有２只以上，\\n就没法交换哦。[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
