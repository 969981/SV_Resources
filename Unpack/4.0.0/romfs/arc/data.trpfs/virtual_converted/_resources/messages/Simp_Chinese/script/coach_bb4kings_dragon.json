      ]
    },
    {
      "ordinal": 45,
      "label": "coach_bb4kings_dragon_trade_03_01",
      "hash64": "EABF4D9BA987B937",
      "text": "别说这种话啊～\\n好不好！？配合一下嘛！[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
