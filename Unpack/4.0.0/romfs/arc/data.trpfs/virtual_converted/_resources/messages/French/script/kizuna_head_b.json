            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_head_b_03",
      "hash64": "CE145C4BD42FC1C3",
      "text": "À propos, j’ai une question à vous poser...[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_head_b_04",
      "hash64": "CE14614BD42FCA42",
      "text": "Parmi le personnel de notre chère académie,\\nsur qui se porte votre préférence ?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
