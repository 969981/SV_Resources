          "offset_units": 68,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_gym_ghost_trade_01_04",
      "hash64": "FB86C6822AE703D7",
      "text": "Krass, unser Tausch war echt der reinste Spaß! ♪\\nMit meinem neuen Buddy geb ich richtig Gas! ♪\\c\\nIm Doppelkampf wird ihn keiner stoppen, ♪\\nich trainier ihn so gut, bis alle andern floppen. ♪[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
