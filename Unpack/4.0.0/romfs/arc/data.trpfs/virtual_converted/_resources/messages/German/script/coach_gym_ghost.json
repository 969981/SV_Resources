    {
      "ordinal": 56,
      "label": "coach_gym_ghost_randomtalk_02",
      "hash64": "B11B6379BF8E2E7A",
      "text": "Bring meine Schwester Quendella auf keinen Fall\\nauf die Palme!\\c\\nWenn sie ausflippt, kann sie gruseliger drauf sein\\nals ich![VAR 0x0114(001B)]",
      "flags": 0,
