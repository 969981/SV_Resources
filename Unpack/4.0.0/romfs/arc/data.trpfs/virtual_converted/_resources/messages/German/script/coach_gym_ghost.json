    {
      "ordinal": 1,
      "label": "coach_gym_ghost_first_01",
      "hash64": "E2556246BBB7BB2E",
      "text": "Hier braucht wohl jemand ’n bisschen Nachhilfe\\nin Sachen Kämpfe mit Seele, hm?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
