            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_ghost_sp01_01",
      "hash64": "94C17C7A84111304",
      "text": "Auf der ganzen Welt wissen Homies, wer ich bin:\\nEtta, die Rapperin mit Rhythmus in der Seele![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_ghost_sp01_02",
      "hash64": "94C17F7A8411181D",
      "text": "Du hast krass Nerven, mich herzubestellen.\\nHahaha![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_ghost_sp01_03",
      "hash64": "94C17E7A8411166A",
      "text": "Aber yo, wenn ein Champ selbst mich so feiert,\\nkann ich doch nich’ ablehnen![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_gym_ghost_sp01_04",
      "hash64": "94C1797A84110DEB",
      "text": "Also werd ich diesen Blaubeer-Kiddies mal ’ne\\nLektion in Sachen Rap mit Seele hinschmettern.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_gym_ghost_sp01_select_01",
      "hash64": "901D6A3D4A970823",
      "text": "Yeah, spitze!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_gym_ghost_sp01_select_02",
      "hash64": "901D6B3D4A9709D6",
      "text": "Es geht hier leider nicht um Rap...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_gym_ghost_sp01_05",
      "hash64": "94C1787A84110C38",
      "text": "Du bringst die richtigen Vibes! Ich zeig natürlich\\nauch, wie man im Kampf voll abgeht![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_ghost_sp01_05b",
      "hash64": "D5CC122E68F7FCEE",
      "text": "Hahaha, dir kann man echt nix vormachen!\\nSchon klar, ich bin zum Kämpfen hier.\\r\\nMeine fetten Beats gibt’s sowieso gratis dazu![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_ghost_sp02_00",
      "hash64": "3E5BB372E8A75448",
      "text": "Bei den Blaubeeren hier is’ doch gerade der\\nDoppelkampf voll im Trend, oder?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_ghost_sp02_01",
      "hash64": "3E5BB472E8A755FB",
      "text": "Ich steh auf Doppelkämpfe, weil man dabei sein\\nHirn anstrengen muss. Die sind eben deep.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_ghost_sp02_02",
      "hash64": "3E5BB572E8A757AE",
      "text": "Wenn die Attacken von zwei Pokémon in ’nem\\nMash-up richtig harmonieren... Das hat Swag.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_ghost_sp02_select_01",
      "hash64": "50FA35A9A0FBE382",
      "text": "Finde ich auch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_gym_ghost_sp02_select_02",
      "hash64": "50FA34A9A0FBE1CF",
      "text": "Ja, fühl ich voll.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_gym_ghost_sp02_03",
      "hash64": "3E5BB672E8A75961",
      "text": "Hahaha! Hast du’s echt gecheckt?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_ghost_sp02_03b",
      "hash64": "9D300841545C4019",
      "text": "Hahaha! Du checkst es also![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_ghost_sp02_04",
      "hash64": "3E5BB772E8A75B14",
      "text": "Wenn der Hype um Doppelkämpfe wächst,\\nkann ich auch mein Ding besser durchziehen![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_ghost_sp02_05",
      "hash64": "3E5BB872E8A75CC7",
      "text": "Ich werd dir und den Blaubeer-Kiddies zeigen,\\nwie man eine irre Doppelkampf-Taktik rockt.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_ghost_sp03_00",
      "hash64": "6726A9679DCCFF19",
      "text": "[VAR 0x0100(0000)]! Ey, wart mal![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_ghost_sp03_01",
      "hash64": "6726A8679DCCFD66",
      "text": "Ich weiß es echt zu schätzen, dass du mich zu\\nden Blaubeeren hier eingeladen hast.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_ghost_sp03_02",
      "hash64": "6726A7679DCCFBB3",
      "text": "Von so vielen Kiddies umgeben zu sein gibt mir\\necht Power. Bei so viel Seele geh ich voll ab![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_ghost_sp03_03",
      "hash64": "6726A6679DCCFA00",
      "text": "Was is’ los? Bist du etwa überrascht, dass ich mit\\nKindern voll gut klarkomme?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_ghost_sp03_select_01",
      "hash64": "C6693166A7261C05",
      "text": "Ja, irgendwie schon.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "coach_gym_ghost_sp03_select_02",
      "hash64": "C6692E66A72616EC",
      "text": "Nein, im Gegenteil.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "coach_gym_ghost_sp03_04",
      "hash64": "6726AD679DCD05E5",
      "text": "Hahaha! Das hör ich oft! Das liegt bestimmt an\\nmeinem coolen Vibe.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_ghost_sp03_04b",
      "hash64": "13BE2E1123606465",
      "text": "Hahaha! Denkste, ich seh aus wie ’ne süße,\\nliebe Omi, oder was?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_ghost_sp03_05",
      "hash64": "6726AC679DCD0432",
      "text": "Tja, früher konnte ich Kinder nicht so gut ab,\\naber seit ich Enkel hab, bin ich voll der Softie\\r\\ngeworden.[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_ghost_sp03_06",
      "hash64": "6726AB679DCD027F",
      "text": "Ihr Kiddies hier seid ungefähr im gleichen Alter\\nwie sie. Und wenn ich seh, was ihr so abliefert,\\r\\nkrieg ich ganz feuchte Augen![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_ghost_trade_01_00",
      "hash64": "FB86C2822AE6FD0B",
      "text": "Hahaha! Ich bin nicht so der Typ für traurige\\nBlues-Vibes![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_ghost_trade_01_01",
      "hash64": "FB86C1822AE6FB58",
      "text": "Yo, lass uns was Cooles machen, um die Mood\\n’n bisschen zu heben![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_ghost_trade_01_02",
      "hash64": "FB86C4822AE70071",
      "text": "Hey, Champ [VAR 0x0100(0000)]!\\nWie wär’s mit ’nem Pokémon-Tausch?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001B"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_gym_ghost_trade_01_03",
      "hash64": "FB86C3822AE6FEBE",
      "text": "[VAR 0xBD06(0000)]Ich biete mein Gruff an, aka DJ G-Rave.\\nWie sieht’s bei dir aus,\\r\\n[VAR 0x0100(0000)]?[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
