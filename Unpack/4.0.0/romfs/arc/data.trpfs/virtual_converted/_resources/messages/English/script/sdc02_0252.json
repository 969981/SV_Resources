      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0252_select_04",
      "hash64": "39BCACABE351FC9D",
      "text": "We gotta disable the lock!",
      "flags": 0,
