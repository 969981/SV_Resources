    },
    {
      "ordinal": 17,
      "label": "sdc02_0252_bbteacher_06",
      "hash64": "6CA0E14B0F44D43D",
      "text": "Well then, can we count on you to unlock the\\ngate, [VAR 0x0100(0000)]?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
