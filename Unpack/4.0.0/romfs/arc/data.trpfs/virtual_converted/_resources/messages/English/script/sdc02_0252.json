      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sdc02_0252_brother_03",
      "hash64": "DDDCA95853B39E12",
      "text": "Wowzers, this feels like a spy movie or\\nsomethin’... Way cool...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
