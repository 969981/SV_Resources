          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0252_brother_04",
      "hash64": "DDDCA45853B39593",
      "text": "What? I didn’t say anything.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
