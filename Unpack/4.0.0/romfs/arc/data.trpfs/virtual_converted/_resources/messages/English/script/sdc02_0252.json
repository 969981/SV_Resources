          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0252_sister_05",
      "hash64": "09E183BFBA114D26",
      "text": "The “Zero Lab,” huh... If it were up to me,\\nI would’ve named this place the “Crystal Lab.”[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
