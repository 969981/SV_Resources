      "ordinal": 19,
      "label": "sdc01_0340_people_01",
      "hash64": "81CB9DC526030050",
      "text": "¡Los compatrones han resucitado!\\n¡Si no lo veo, no lo creo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
