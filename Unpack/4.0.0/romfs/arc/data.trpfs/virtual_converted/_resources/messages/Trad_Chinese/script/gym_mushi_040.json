          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_mushi_040_mushi_waza",
      "hash64": "54D7588FA1FEE21D",
      "text": "[VAR 0x1100(00FF,0101)]你妳吃東西的模樣讓我看得好過癮。\\n順便收下招式學習器當甜點如何～？[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_mushi_040_mushi_13",
      "hash64": "87425DF65FFC6A1C",
      "text": "在冒險途中獲得的招式學習器\\n之後可以在招式學習器機製作呢～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_mushi_040_mushi_14",
      "hash64": "87425CF65FFC6869",
      "text": "祝[VAR 0x1100(00FF,0101)]你妳今後前進的道路\\n一路甜蜜又順口唷～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 1,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_mushi_040_mushi_15",
      "hash64": "87425BF65FFC66B6",
      "text": "那麼，\\n我們後會有期～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_mushi_040_receptionist_04",
      "hash64": "6C453A794948440F",
      "text": "恭喜！\\n[VAR 0x1100(00FF,0101)]你妳在圓模道館及格了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
