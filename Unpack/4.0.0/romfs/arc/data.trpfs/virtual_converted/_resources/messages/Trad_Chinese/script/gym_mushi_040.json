      ]
    },
    {
      "ordinal": 21,
      "label": "gym_mushi_040_mushi_badge_all",
      "hash64": "7357E0542B75F0CB",
      "text": "如果[VAR 0x1100(00FF,0101)]你妳擁有了８個道館徽章，\\n那麼不論什麼寶可夢都能捕捉了。\\r\\n而且牠們都會好好地聽話唷～[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
