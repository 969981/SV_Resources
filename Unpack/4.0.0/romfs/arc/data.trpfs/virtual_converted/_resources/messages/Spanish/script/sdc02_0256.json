          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0256_brother_01",
      "hash64": "19668E95752A30B8",
      "text": "¡Eso te pasa por correr sin mirar por dónde vas![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
