    {
      "ordinal": 0,
      "label": "sdc02_0256_sister_01",
      "hash64": "F7D075A5533A5A9E",
      "text": "¡Esto está demasiado oscuro! ¡Vaya golpe me he\\ndado en la cabeza![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
