    },
    {
      "ordinal": 5,
      "label": "common_2020_normal_010_normal_04",
      "hash64": "5D196C5F176D4D08",
      "text": "首席是我的上司，\\n但想不到她連學生都這樣使喚……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
