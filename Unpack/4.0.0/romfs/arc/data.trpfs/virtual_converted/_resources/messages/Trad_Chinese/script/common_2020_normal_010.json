          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_normal_010_normal_05",
      "hash64": "5D196D5F176D4EBB",
      "text": "原來如此？[VAR 0x1100(00FF,0101)]你妳希望能邀請首席\\n參加學校的大賽，所以當了她的幫手……[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
