      "label": "common_2020_normal_010_normal_09",
      "hash64": "5D19695F176D47EF",
      "text": "那麼，我們去食堂吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
