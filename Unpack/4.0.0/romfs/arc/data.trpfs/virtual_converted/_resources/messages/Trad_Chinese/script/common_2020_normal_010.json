    },
    {
      "ordinal": 10,
      "label": "common_2020_normal_010_normal_retry",
      "hash64": "3F87283E5A69AFBE",
      "text": "我們把麻煩的工作\\n速速解決掉吧。[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
