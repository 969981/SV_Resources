    },
    {
      "ordinal": 1,
      "label": "sdc02_0260_bbteacher_02",
      "hash64": "292A91CF8837038A",
      "text": "哦哦哦哦哦哦哦哦！！！！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
