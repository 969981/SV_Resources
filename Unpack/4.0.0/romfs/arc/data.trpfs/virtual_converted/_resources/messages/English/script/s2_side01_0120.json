          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0120_brother_02",
      "hash64": "F9277BADA6D1FCA1",
      "text": "“Weird thing”? What’re you talking about?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
