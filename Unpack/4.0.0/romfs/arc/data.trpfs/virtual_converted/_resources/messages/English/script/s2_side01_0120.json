    {
      "ordinal": 2,
      "label": "s2_side01_0120_select_01",
      "hash64": "CBCBDA5F41F65C0A",
      "text": "What happened?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_side01_0120_select_02",
      "hash64": "CBCBD95F41F65A57",
      "text": "You’re both OK?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0120_friend_02",
      "hash64": "74E9E95E9C053327",
      "text": "Ah...yeah... Sorry about hanging up on you like\\nthat. Probably gave you the wrong impression.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0120_friend_03",
      "hash64": "74E9E85E9C053174",
      "text": "It was all Penny’s fault.\\c\\nShe went into full panic mode and ran smack into\\nme. With her head. So I dropped my phone.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
