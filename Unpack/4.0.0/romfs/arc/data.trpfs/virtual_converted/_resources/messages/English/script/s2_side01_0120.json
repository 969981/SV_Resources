          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side01_0120_brother_03",
      "hash64": "F9277AADA6D1FAEE",
      "text": "I think I might have figured out why everyone is\\nacting so strange.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
