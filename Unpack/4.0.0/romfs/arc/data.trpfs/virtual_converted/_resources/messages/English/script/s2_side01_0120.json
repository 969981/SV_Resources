          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0120_botan_02",
      "hash64": "A1878B61CCCF4C31",
      "text": "It was, like, round and little...and WEIRD![VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side01_0120_friend_05",
      "hash64": "74E9E65E9C052E0E",
      "text": "And just where is this little hallucination of yours?\\nYou sure you weren’t just seeing stuff?[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0120_botan_03",
      "hash64": "A1878A61CCCF4A7E",
      "text": "It was real!!! I really I saw it![VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0120_friend_06",
      "hash64": "74E9E55E9C052C5B",
      "text": "Sure you did...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
