  "entries": [
    {
      "ordinal": 0,
      "label": "s2_sub_011_girl_01",
      "hash64": "EB85F4E3122FF757",
      "text": "Alola !\\nMoi, je suis fan des Pokémon d’Alola !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_011_girl_02",
      "hash64": "EB85F5E3122FF90A",
      "text": "J’adorerais voir un Grolem d’Alola !\\nT’en aurais un à me montrer dans ton équipe\\r\\nou tes Boîtes, par hasard ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_011_girl_03",
      "hash64": "EB85F6E3122FFABD",
      "text": "J’ai beau chercher partout, il y a personne pour\\nme montrer un Grolem de cette région...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_011_girl_04",
      "hash64": "EB85EFE3122FEED8",
      "text": "Mais...\\c\\nC’est pas du tout un Grolem !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_011_girl_05",
      "hash64": "EB85F0E3122FF08B",
      "text": "Mais...\\c\\nC’est un Grolem tout ce qu’il y a de plus banal !\\nMoi, c’est un Grolem d’Alola que j’aimerais voir !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_011_girl_06",
      "hash64": "EB85F1E3122FF23E",
      "text": "Mais...\\c\\nC-c’est un Grolem d’Alola ! Un vrai de vrai !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_011_girl_07",
      "hash64": "EB85F2E3122FF3F1",
      "text": "Sa tête lui donne un look exotique du tonnerre !\\nEt ses sourcils et sa barbe, trop classe !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_sub_011_girl_08",
      "hash64": "EB85EBE3122FE80C",
      "text": "Il évolue après un échange, alors c’est pour ça\\nqu’on en trouve pas souvent à l’état sauvage.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s2_sub_011_girl_09",
      "hash64": "EB85ECE3122FE9BF",
      "text": "Pour te remercier, je vais t’apprendre quelque\\nchose de typique de la région d’Alola !\\c\\nJ’imagine trop un Grolem prendre la pose\\ncomme ça, en plus !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_011_system_01",
      "hash64": "340BF1E47E73D21E",
      "text": "La jeune fille vous a appris la réaction\\n[VAR 0xFF00(0008)]Voltazélite[VAR 0xFF00(0000)] !",
      "flags": 0,
