      "hash64": "9C6181E669620E8B",
      "text": "Restons plutôt en retrait...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
