          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_botan_b_doku_11",
      "hash64": "56D5219ADF03E1EA",
      "text": "Je... je dois te présenter mes excuses...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
