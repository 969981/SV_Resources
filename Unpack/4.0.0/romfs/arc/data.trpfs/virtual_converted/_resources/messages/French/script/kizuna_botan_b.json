          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_botan_b_doku_12",
      "hash64": "56D5209ADF03E037",
      "text": "Le shinobi shôzoku... La tenue de ninja que\\nje t’ai promise... Je n’ai pas réussi à l’obtenir...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_botan_b_student_02",
      "hash64": "CFF664CFE1993D94",
      "text": "Ah, ça ? Ben en fait, je viens d’en acheter deux !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "kizuna_botan_b_doku_13",
      "hash64": "56D51F9ADF03DE84",
      "text": "... Plaît-il ?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_botan_b_student_03",
      "hash64": "CFF665CFE1993F47",
      "text": "J’étais à la boutique tout à l’heure,\\net ils venaient tout juste de les recevoir.\\c\\nDu coup, j’en ai pris deux ! Un pour moi,\\net un pour vous, sensei !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "kizuna_botan_b_student_04",
      "hash64": "CFF662CFE1993A2E",
      "text": "Heureusement que je suis arrivé à temps pour\\nles acheter. Tout le monde se les arrache !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "kizuna_botan_b_student_05",
      "hash64": "CFF663CFE1993BE1",
      "text": "Allez, sensei ! Allons plutôt dehors pour pratiquer\\nnos techniques secrètes de ninja !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "kizuna_botan_b_doku_14",
      "hash64": "56D51E9ADF03DCD1",
      "text": "... Je... je ne sais que dire...\\nCette révélation est un ineffable soulagement ![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_botan_b_doku_15",
      "hash64": "56D51D9ADF03DB1E",
      "text": "Très bien. Permets-moi d’aller chercher\\nmes shurikens dans mon logis.\\c\\nJe t’enseignerai l’art de les lancer comme\\nun ninja ![VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "kizuna_botan_b_student_06",
      "hash64": "CFF660CFE19936C8",
      "text": "Youpi ! J’ai trop hâte !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "kizuna_botan_b_doku_16",
      "hash64": "56D51C9ADF03D96B",
      "text": "Si tu le souhaites, camarade, je peux donner\\nà ton costume le même aspect empoisonné\\r\\net dégoulinant que le mien. Qu’en dis-tu ?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "kizuna_botan_b_student_07",
      "hash64": "CFF661CFE199387B",
      "text": "Euuuh... Je pense que ça ira pour moi...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "kizuna_botan_b_doku_17",
      "hash64": "56D51B9ADF03D7B8",
      "text": "Ha ha ha ! Tu refuses l’offre de ton sensei ?\\nCertains parleraient d’impudence ![VAR 0x0114(0023)]",
