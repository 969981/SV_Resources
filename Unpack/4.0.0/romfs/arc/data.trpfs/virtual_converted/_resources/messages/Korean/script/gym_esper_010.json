    },
    {
      "ordinal": 1,
      "label": "gym_esper_010_receptionist_02",
      "hash64": "DCED089906C259C3",
      "text": "도전자의 이름을\\n등록하겠습니다...\\r\\n[VAR 0x0100(0000)] 님이시군요!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
