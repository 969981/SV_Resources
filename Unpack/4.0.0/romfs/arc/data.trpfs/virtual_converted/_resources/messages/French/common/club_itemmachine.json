  "entries": [
    {
      "ordinal": 0,
      "label": "club_itemmachine_msg_first_00",
      "hash64": "6C76D0975AF7CD8E",
      "text": "Merci d’avoir fait appel à nous pour l’installation\\nde cette Imprimante à objets !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "club_itemmachine_msg_first_01",
      "hash64": "6C76D1975AF7CF41",
      "text": "Je fais partie du club de sciences. C’est nous\\nqui avons mis au point cette machine.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "club_itemmachine_msg_first_02",
      "hash64": "6C76CE975AF7CA28",
      "text": "Je suis là pour aider les membres de ton club\\nà l’utiliser correctement.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "club_itemmachine_msg_first_03",
      "hash64": "6C76CF975AF7CBDB",
      "text": "Bref, l’Imprimante à objets ! À quoi sert-elle ?\\nQuels sont ses enjeux ? Tu vas tout savoir !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "club_itemmachine_msg_first_04",
      "hash64": "6C76D4975AF7D45A",
      "text": "C’est une machine qui transforme les échantillons\\nde Pokémon en objets, moyennant quelques PM !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "club_itemmachine_msg_first_05",
      "hash64": "6C76D5975AF7D60D",
      "text": "Nous gardons secrets les détails du procédé de\\ntransformation. Nous n’avons pas encore obtenu\\r\\nle brevet, tu comprends...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "club_itemmachine_msg_first_06",
      "hash64": "6C76D2975AF7D0F4",
      "text": "Tout ce que tu as besoin de savoir, c’est que\\ncette merveille technologique peut imprimer des\\r\\nobjets, à condition d’y insérer des échantillons !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "club_itemmachine_msg_first_07",
      "hash64": "6C76D3975AF7D2A7",
      "text": "Ce qui est excitant, c’est qu’on ne sait jamais\\nce qui va être imprimé !\\c\\nAlors, qu’en penses-tu ? Facile, n’est-ce pas ?\\nD’ailleurs...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "club_itemmachine_msg_start_00",
      "hash64": "47D2451C8CF88184",
      "text": "Veux-tu utiliser l’Imprimante à objets ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "club_itemmachine_con_00_00",
      "hash64": "0863983DD5491E9F",
      "text": "Oui",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "club_itemmachine_con_00_01",
      "hash64": "0863973DD5491CEC",
      "text": "Non",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "club_itemmachine_con_00_02",
      "hash64": "08639A3DD5492205",
      "text": "Oui !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "club_itemmachine_con_00_03",
      "hash64": "0863993DD5492052",
      "text": "Je voudrais améliorer l’imprimante.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "club_itemmachine_con_00_04",
      "hash64": "0863943DD54917D3",
      "text": "Pas pour l’instant.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
