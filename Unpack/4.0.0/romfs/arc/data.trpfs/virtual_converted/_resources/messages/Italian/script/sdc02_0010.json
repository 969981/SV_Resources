          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0010_headbb_09",
      "hash64": "1F17BE3F0FC027BC",
      "text": "Ottima domanda, Velly!\\nÈ presto detto...[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
