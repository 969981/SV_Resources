    },
    {
      "ordinal": 13,
      "label": "sdc02_0010_headteacher_05",
      "hash64": "2F8FD0C3B7EC74DE",
      "text": "Piuttosto, mi perdoni, [VAR 0x0100(0000)].\\nLe devo delle spiegazioni.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
