    },
    {
      "ordinal": 17,
      "label": "sdc02_0010_headteacher_08",
      "hash64": "2F8FCDC3B7EC6FC5",
      "text": "A proposito... Come mai ha scelto proprio\\n[VAR 0x0100(0000)] per il programma di scambio?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
