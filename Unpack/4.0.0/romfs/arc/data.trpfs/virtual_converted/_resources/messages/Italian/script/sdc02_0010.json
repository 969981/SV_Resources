          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0010_headbb_15",
      "hash64": "1F14463F0FBD25FD",
      "text": "E ora che ti ho incontrat[VAR 0x1100(00FF,0101)]oa di persona, devo dire\\nche... hai fatto un’ottima impressione pure a me![VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0010_headteacher_09",
      "hash64": "2F8FCCC3B7EC6E12",
      "text": "Oooh! Quindi è anche lei della mia stessa\\nopinione, Preside Bluebert![VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc02_0010_headbb_16",
      "hash64": "1F14433F0FBD20E4",
      "text": "Vorrei invitarti a studiare nella mia scuola per un\\nperiodo. Sono certo che porteresti una ventata\\r\\nd’aria fresca![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
