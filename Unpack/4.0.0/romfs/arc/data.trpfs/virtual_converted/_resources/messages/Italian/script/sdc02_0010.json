    },
    {
      "ordinal": 8,
      "label": "sdc02_0010_headteacher_02",
      "hash64": "2F8FD3C3B7EC79F7",
      "text": "Ci mancherebbe altro! Come capirà, la mia\\npresenza è d’obbligo.\\c\\nInoltre, preferirei che non mi chiamasse così\\ndavanti agli studenti...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
