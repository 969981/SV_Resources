          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0010_headbb_10",
      "hash64": "1F14413F0FBD1D7E",
      "text": "Uhm... Qual era il motivo...?[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0010_headbb_11",
      "hash64": "1F14423F0FBD1F31",
      "text": "Ah sì! Il viaggio di studio a Nordivia! È lì che\\nha conosciuto una nostra studentessa, giusto?[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0010_headbb_12",
      "hash64": "1F143F3F0FBD1A18",
      "text": "Si chiama Rubra, se non sbaglio.\\nEcco! È lei che mi ha parlato bene di te.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc02_0010_headbb_13",
      "hash64": "1F14403F0FBD1BCB",
      "text": "Ah sì! Una delle mie fonti mi aveva parlato di\\nun[VAR 0x1100(00FF,0908)] ragazzoa ragazza molto interessante...[VAR 0x0114(004B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0908"
          ]
