        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004B"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc02_0010_headbb_14",
      "hash64": "1F14453F0FBD244A",
      "text": "Poco fa ho anche provato a chiedere in giro\\nagli studenti e in effetti molti dicono che sei\\r\\nun[VAR 0x1100(00FF,0605)] tipoa tipa speciale.[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
