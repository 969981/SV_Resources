          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0010_headteacher_03",
      "hash64": "2F8FD2C3B7EC7844",
      "text": "Ad ogni modo, non eravamo d’accordo che\\nci saremmo visti nel mio ufficio?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
