      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0235_ground_06",
      "hash64": "D979CDBDBDC56265",
      "text": "¡Te metiste en el foso sin permiso ni gaitas![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
