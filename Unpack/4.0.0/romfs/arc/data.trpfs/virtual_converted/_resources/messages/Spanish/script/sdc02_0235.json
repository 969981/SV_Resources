          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0235_select_01",
      "hash64": "ABB7C9C24ACDCE91",
      "text": "¡Hago lo que puedo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_0235_select_02",
      "hash64": "ABB7C6C24ACDC978",
      "text": "¡Como buen[VAR 0x1100(00FF,0100)]a Campe[VAR 0x1100(00FF,0302)]ónona!",
