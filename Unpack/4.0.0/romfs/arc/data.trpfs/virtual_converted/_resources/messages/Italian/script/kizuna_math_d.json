          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_math_d_select_01",
      "hash64": "9D49A5E8910AAAE2",
      "text": "Un agguato?!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "kizuna_math_d_select_02",
      "hash64": "9D49A4E8910AA92F",
      "text": "Perché?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_d_03",
      "hash64": "2C21F2A1DF8E0B81",
      "text": "Mi mette a disagio continuare a sentirmi\\nosservata senza sapere perché...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_d_04",
      "hash64": "2C21F3A1DF8E0D34",
      "text": "E adesso che l’ho vista in mensa sono in grado\\ndi riconoscerla.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_d_05",
      "hash64": "2C21F4A1DF8E0EE7",
      "text": "Ah![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_d_06",
      "hash64": "2C21F5A1DF8E109A",
      "text": "Sei tu, non è vero? La persona che ultimamente\\nnon fa che osservarmi![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_d_woman_01",
      "hash64": "EB672704C6358444",
      "text": "Si-Signora Thyma?!\\nCome ha fatto a capirlo...?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_d_woman_02",
      "hash64": "EB672A04C635895D",
      "text": "Mi... Mi scusi! Allora se n’era accorta?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_d_07",
      "hash64": "2C21F6A1DF8E124D",
      "text": "Certo, mi fissavi in continuazione! Immagino che\\ntu abbia qualcosa da chiedermi, giusto?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_d_woman_03",
      "hash64": "EB672904C63587AA",
      "text": "Beh... sì.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_d_woman_04",
      "hash64": "EB672404C6357F2B",
      "text": "Sono una sua grandissima fan fin da quando\\nera una Capopalestra! Sa, adoro le mosse\\r\\ndi tipo Roccia!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_d_08",
      "hash64": "2C21E7A1DF8DF8D0",
      "text": "Oh, ma davvero?[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_math_d_woman_05",
      "hash64": "EB672304C6357D78",
      "text": "Però un anno e mezzo fa lei si è ritirata\\nall’improvviso... Come mai ha deciso di smettere?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_d_09",
      "hash64": "2C21E8A1DF8DFA83",
      "text": "Ma come, tutto qui quello che volevi chiedermi?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_math_d_woman_06",
      "hash64": "EB672604C6358291",
      "text": "Il motivo del suo ritiro non è mai stato reso noto\\nufficialmente...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_math_d_woman_07",
      "hash64": "EB672504C63580DE",
      "text": "E tra gli studenti gira voce che lei eluda sempre\\nquesta domanda...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_math_d_woman_08",
      "hash64": "EB672004C635785F",
      "text": "Temevo di essere indiscreta a chiederle qualcosa\\ndi cui non voleva parlare... perciò non riuscivo\\r\\na trovare il coraggio.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_math_d_10",
      "hash64": "2C24F5A1DF904671",
      "text": "Ecco il perché di quegli sguardi intensi...\\nMi dispiace.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_math_d_woman_09",
      "hash64": "EB671F04C63576AC",
      "text": "Eh? Intensi?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "kizuna_math_d_11",
      "hash64": "2C24F4A1DF9044BE",
      "text": "No, niente... Comunque ho deciso di ritirarmi\\nperché volevo concentrarmi sul mio lavoro\\r\\ndi insegnante.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_math_d_12",
      "hash64": "2C24F3A1DF90430B",
      "text": "Ma non è che non mi piacesse fare\\nla Capopalestra...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_math_d_13",
      "hash64": "2C24F2A1DF904158",
      "text": "Parlare della palestra mi riempie di nostalgia\\ne di malinconia.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "kizuna_math_d_14",
      "hash64": "2C24F9A1DF904D3D",
      "text": "Per questo ho finito per eludere le domande\\ndegli studenti.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_math_d_woman_10",
      "hash64": "EB63A204C6326C6E",
      "text": "Oh, capisco...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "kizuna_math_d_woman_11",
      "hash64": "EB63A304C6326E21",
      "text": "Non tornerà più a fare la Capopalestra?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "kizuna_math_d_15",
      "hash64": "2C24F8A1DF904B8A",
      "text": "No... non credo proprio.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_math_d_16",
      "hash64": "2C24F7A1DF9049D7",
      "text": "Mia sorella sta facendo un ottimo lavoro come\\nCapopalestra al posto mio.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_math_d_17",
      "hash64": "2C24F6A1DF904824",
      "text": "Insegnare è la cosa che mi dà più soddisfazione\\nin questo momento.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "kizuna_math_d_18",
      "hash64": "2C24EDA1DF9038D9",
      "text": "Quindi mi faresti davvero felice se invece di\\n\"signora\" mi chiamassi \"professoressa\".[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "kizuna_math_d_woman_12",
      "hash64": "EB63A004C6326908",
      "text": "Va bene. È un vero peccato... ma capisco!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "kizuna_math_d_woman_13",
      "hash64": "EB63A104C6326ABB",
      "text": "Grazie, professoressa Thyma!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "kizuna_math_d_19",
      "hash64": "2C24ECA1DF903726",
      "text": "E con questo il mistero è risolto![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "kizuna_math_d_20",
      "hash64": "2C287BA1DF935FFA",
      "text": "Aaah, ero così tesa! Spero di non essere\\nsembrata troppo a disagio![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "kizuna_math_d_21",
      "hash64": "2C287CA1DF9361AD",
      "text": "Quando ho iniziato a notare quegli sguardi\\nintensi, un po’ mi sono spaventata...[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "kizuna_math_d_22",
      "hash64": "2C2879A1DF935C94",
      "text": "Ma grazie al tuo sostegno sono riuscita ad avere\\nuno scambio sincero con una mia affezionata fan.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "kizuna_math_d_23",
      "hash64": "2C287AA1DF935E47",
      "text": "[VAR 0xBD06(0000)]Grazie [VAR 0x0100(0000)], capiti sempre\\nal momento giusto![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "kizuna_math_d_24",
      "hash64": "2C2877A1DF93592E",
      "text": "Per ringraziarti voglio farti un regalino!\\nSpero ti sia utile nelle tue avventure.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "kizuna_math_d_system_01",
      "hash64": "13D34B6D971897A5",
      "text": "Tu e la professoressa Thyma avete fatto amicizia!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
