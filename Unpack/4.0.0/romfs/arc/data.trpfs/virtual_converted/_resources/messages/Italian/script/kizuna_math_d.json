      "hash64": "2C21F0A1DF8E081B",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)]! Ho proprio bisogno del tuo\\nsupporto morale![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
