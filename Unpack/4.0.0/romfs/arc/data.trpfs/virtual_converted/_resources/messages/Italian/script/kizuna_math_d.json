          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_math_d_02",
      "hash64": "2C21F1A1DF8E09CE",
      "text": "Sto per tendere un agguato alla mia misteriosa\\nosservatrice![VAR 0x0114(0025)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
