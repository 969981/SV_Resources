          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "team_0115_nelke_18",
      "hash64": "4DA884DB987A7C90",
      "text": "죄송합니다...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
