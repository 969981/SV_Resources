        }
      ]
    },
    {
      "ordinal": 44,
      "label": "team_0115_nelke_33",
      "hash64": "4DAF17DB987FE207",
      "text": "어라? 타임 선생님 아니십니까.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
