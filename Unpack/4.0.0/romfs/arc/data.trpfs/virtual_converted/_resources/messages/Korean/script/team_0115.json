          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0115_nelke_31",
      "hash64": "4DAF19DB987FE56D",
      "text": "스타단의 진 보스,\\n카시오페아를 이겨 주십시오![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0115_select_07",
      "hash64": "A25339232FC8477F",
      "text": "네!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "team_0115_select_08",
      "hash64": "A2533E232FC84FFE",
      "text": "맡겨 주세요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "team_0115_nelke_32",
      "hash64": "4DAF16DB987FE054",
      "text": "감사합니다.\\n그럼, 부탁드리겠습니다...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
