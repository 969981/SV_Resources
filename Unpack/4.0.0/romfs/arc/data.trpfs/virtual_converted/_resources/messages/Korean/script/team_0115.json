          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "team_0115_nelke_28",
      "hash64": "4DB286DB9882D47B",
      "text": "이긴 쪽이 카시오페아를\\n멈추는 일을 맡아야 한다는 생각으로요...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "team_0115_nelke_29",
      "hash64": "4DB285DB9882D2C8",
      "text": "당신의 그 실력과 상냥함이라면\\n그 아이를 구원할 수 있을 겁니다.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "team_0115_nelke_30",
      "hash64": "4DAF18DB987FE3BA",
      "text": "교사로서 부끄럽지만\\n부탁드리겠습니다.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
