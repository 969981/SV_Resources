      ]
    },
    {
      "ordinal": 9,
      "label": "team_0115_nelke_07a",
      "hash64": "7757C3241C0DD2FF",
      "text": "네르케는 사실\\n오렌지 아카데미의 교장인...[VAR 0x0114(000A)]",
      "flags": 0,
