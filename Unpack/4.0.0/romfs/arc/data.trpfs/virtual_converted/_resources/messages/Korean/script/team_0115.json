          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "team_0115_math_02",
      "hash64": "7499F644469AC616",
      "text": "어라? 하고\\n평온하게 이야기하실 때인가요!?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
