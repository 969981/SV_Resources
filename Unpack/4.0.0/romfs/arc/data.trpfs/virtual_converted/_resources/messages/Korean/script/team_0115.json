          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "team_0115_math_01",
      "hash64": "7499F544469AC463",
      "text": "거기 지금 뭣들 하는 겁니까![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
