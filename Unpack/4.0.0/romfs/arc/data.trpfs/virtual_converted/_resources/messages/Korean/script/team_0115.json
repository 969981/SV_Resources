          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "team_0115_nelke_34",
      "hash64": "4DAF14DB987FDCEE",
      "text": "아니, 그게...\\n여기에는 슬픈 사연이...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
