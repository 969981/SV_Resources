          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "team_0115_nelke_27",
      "hash64": "4DB283DB9882CF62",
      "text": "그래서 당신에게\\n승부를 건 것입니다.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
