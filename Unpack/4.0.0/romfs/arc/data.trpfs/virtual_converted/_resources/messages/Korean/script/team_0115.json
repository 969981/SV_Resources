          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "team_0115_math_03",
      "hash64": "7499F744469AC7C9",
      "text": "교내에서 배틀을 하고 있다고 해서\\n와 봤더니!![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "team_0115_math_04",
      "hash64": "7499F844469AC97C",
      "text": "교장이라는 분이\\n학생에게 무슨 짓을 하고 계신 거죠!?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
