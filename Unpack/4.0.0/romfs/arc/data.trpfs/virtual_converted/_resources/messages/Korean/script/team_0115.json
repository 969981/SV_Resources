      ]
    },
    {
      "ordinal": 21,
      "label": "team_0115_nelke_13",
      "hash64": "4DA88FDB987A8F41",
      "text": "카시오페아와의 통화도\\n사전에 녹음한 음성을 그...\\r\\n이렇게 저렇게 한 것입니다![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
