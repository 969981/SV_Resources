            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "team_0115_math_05",
      "hash64": "7499F944469ACB2F",
      "text": "사연이고 사랑동이고\\n변명은 듣고 싶지 않습니다![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
