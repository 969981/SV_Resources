          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "ajito_kakutou_040_sitappa_13",
      "hash64": "E7F279AC2C248C1A",
      "text": "Que resulté ser yo.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "ajito_kakutou_040_nelke_13",
      "hash64": "5C14E240FEE300FD",
      "text": "[EMPTY 68]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "ajito_kakutou_040_sitappa_14",
      "hash64": "E7F274AC2C24839B",
      "text": "La verdad es que me lo tenía bien merecido por\\nestúpida, pero Erin me ayudó.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "ajito_kakutou_040_sitappa_15",
      "hash64": "E7F273AC2C2481E8",
      "text": "Me dijo que entendía lo difícil que era sentirse\\ndesplazada, y me invitó al Team Star.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "ajito_kakutou_040_nelke_14",
      "hash64": "5C14DB40FEE2F518",
      "text": "¿Después de todo lo que le habías hecho?\\nChapó por ella.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "ajito_kakutou_040_sitappa_16",
      "hash64": "E7F276AC2C248701",
      "text": "Sí, es una persona increíble. Y yo he disfrutado\\nde cada día que he sido miembro del Team Star.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "ajito_kakutou_040_nelke_15",
      "hash64": "5C14DC40FEE2F6CB",
      "text": "Yo había oído que era el Team Star el que se\\ndedicaba a acosar a los demás alumnos...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "ajito_kakutou_040_sitappa_17",
      "hash64": "E7F275AC2C24854E",
      "text": "¿Y, tras escuchar esta historia, sigues pensando\\nque eso es cierto?[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "ajito_kakutou_040_nelke_16",
      "hash64": "5C14DD40FEE2F87E",
      "text": "Pues no lo sé...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 66,
      "label": "ajito_kakutou_040_sitappa_18",
      "hash64": "E7F270AC2C247CCF",
      "text": "Soy la persona que soy ahora mismo gracias a\\nErin y al Team Star.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 67,
      "label": "ajito_kakutou_040_sitappa_19",
      "hash64": "E7F26FAC2C247B1C",
      "text": "Son nuestro más preciado tesoro...\\nNo nos lo arrebatéis.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
