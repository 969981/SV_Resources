          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "ajito_kakutou_040_dokuboss_03",
      "hash64": "C6B009A0BF8256B3",
      "text": "Nosotros entrenamos por turnos, mas vuestra\\nempresa no conoce descanso, mi señora...\\c\\nLa duda sobre vuestra salud deja a mi alma\\natribulada y llena de congoja.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
