    {
      "ordinal": 12,
      "label": "ajito_kakutou_040_fairyboss_02",
      "hash64": "15A232192EB8F1C2",
      "text": "Una cosa sí voy a decir... Llevamos cuatro horas\\nseguidas entrenando y yo ya no puedo más.[VAR 0x0114(0020)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_kakutou_040_kakutouboss_04",
      "hash64": "8A4BA02B26465D7B",
      "text": "¡Ay, lo siento! Tienes razón, ¡tomaos un descanso![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
