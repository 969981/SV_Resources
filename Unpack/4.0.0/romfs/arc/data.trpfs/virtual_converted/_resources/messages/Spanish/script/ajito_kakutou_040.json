    {
      "ordinal": 14,
      "label": "ajito_kakutou_040_kakutouboss_05",
      "hash64": "8A4B9F2B26465BC8",
      "text": "Mientras tanto, yo voy a salir a correr un rato.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
