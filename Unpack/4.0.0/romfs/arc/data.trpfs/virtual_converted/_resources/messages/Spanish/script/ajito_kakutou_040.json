    },
    {
      "ordinal": 56,
      "label": "ajito_kakutou_040_sitappa_12",
      "hash64": "E7F27AAC2C248DCD",
      "text": "Y bueno, como hacen los niños con los juguetes,\\ncuando los abusones se cansaron de ella,\\r\\ncambiaron de objetivo.[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
