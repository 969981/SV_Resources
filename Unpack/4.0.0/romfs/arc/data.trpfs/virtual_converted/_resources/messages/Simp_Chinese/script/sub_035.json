    {
      "ordinal": 17,
      "label": "sub_035_system_02",
      "hash64": "C6E9E95F3C949961",
      "text": "[VAR 0x0102(0001)]获得了\\n小不点之证！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
