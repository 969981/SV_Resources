      ]
    },
    {
      "ordinal": 16,
      "label": "sub_035_system_01",
      "hash64": "C6E9E65F3C949448",
      "text": "[VAR 0x0102(0001)]获得了\\n大个子之证！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
