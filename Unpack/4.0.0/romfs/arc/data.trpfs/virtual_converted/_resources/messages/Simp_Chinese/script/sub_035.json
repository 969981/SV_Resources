          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_035_mgirl_15",
      "hash64": "4A5CA661B3DBD97B",
      "text": "谢谢你让我看到\\n这么大的宝可梦。\\r\\n我来给它戴上证章哦。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sub_035_mgirl_16",
      "hash64": "4A5CA761B3DBDB2E",
      "text": "谢谢你让我看到\\n这么小的宝可梦。\\r\\n我来给它戴上证章哦。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
