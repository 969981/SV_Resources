          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_side02_0060_system_01",
      "hash64": "FB7A90977AC48E50",
      "text": "[VAR 0x0100(0000)]受沙儷\\n託付了一隻卡蒂狗！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_side02_0060_camera_20",
      "hash64": "443B93A642405F7F",
      "text": "要把牠培養得很～強很強喔！[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_side02_0060_camera_21",
      "hash64": "443B92A642405DCC",
      "text": "……好了！我的目的也達到了，\\n差不多該走啦。[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_side02_0060_camera_22",
      "hash64": "443B95A6424062E5",
      "text": "雖然捨不得，\\n但我們該說再見了。[VAR 0x0114(0046)]",
