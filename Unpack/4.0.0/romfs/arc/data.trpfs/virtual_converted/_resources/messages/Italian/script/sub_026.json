          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_025_sitappa_a_03",
      "hash64": "374EC6ECC983ADC2",
      "text": "Non posso offrirti chissà che accoglienza,\\nquindi... Toh! Ti faccio un regalo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_025_system_01",
      "hash64": "284BBDA29079A845",
      "text": "Hai ottenuto il [VAR 0xFF00(0008)]cappellino sportivo (Star)[VAR 0xFF00(0000)]!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_025_sitappa_a_04",
      "hash64": "374EC1ECC983A543",
      "text": "Puoi stare qui quanto ti pare, e puoi levare\\nle tende quando ti fa comodo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_025_sitappa_a_05",
      "hash64": "374EC0ECC983A390",
      "text": "Questo è un punto di ritrovo per i reietti\\ndel Team Star.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_025_sitappa_b_01",
      "hash64": "61CCBCE1801AED13",
      "text": "Siamo stanchi di stare dietro al Team Star, tutto\\nqui. Di nascosto andiamo pure a scuola.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_025_sitappa_c_01",
      "hash64": "5EDE10DC579B18FE",
      "text": "Sempre in gamba, eh! Astra la vista!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_025_sitappa_d_01",
      "hash64": "895C88D10E333535",
      "text": "Qui nessuno si mette a litigare, perciò mi trovo\\nbene.\\c\\nÈ tutta un’altra storia rispetto a stare a scuola\\no con quelli del Team Star... o a casa mia.",
      "flags": 0,
