    },
    {
      "ordinal": 1,
      "label": "sub_025_sitappa_a_02",
      "hash64": "374EC7ECC983AF75",
      "text": "Operazione Stardust? Dichiarazione di guerra?\\nMa di che parli?\\c\\nNoi qui non siamo in contatto con la gente\\ndel quartier generale.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
