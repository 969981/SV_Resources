          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_c_01_history_09",
      "hash64": "293FB30CFE603F28",
      "text": "Was soll angeblich auf dem Grund von Zone Null\\nim Schlund von Paldea liegen?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_c_01_select_01",
      "hash64": "50FDDD95E00E4240",
      "text": "Ein Schatz.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_c_01_select_02",
      "hash64": "50FDE095E00E4759",
      "text": "Ein Relaxo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_c_01_select_03",
      "hash64": "50FDDF95E00E45A6",
      "text": "Ein Pokémon-Center.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_c_01_history_answer_01",
      "hash64": "4FAD04F0C0143E09",
      "text": "Sieh einer an, das ist richtig.\\c\\nDa war wohl jemand clever genug, sich gründlich\\nauf den Unterricht vorzubereiten.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_c_01_history_answer_02",
      "hash64": "4FAD01F0C01438F0",
      "text": "Falsch! Netter Versuch, aber du hast dich wohl\\ndurch das Wort „liegen“ in die Irre führen lassen.\\r\\nDie richtige Antwort lautet: ein Schatz.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_c_01_history_answer_03",
      "hash64": "4FAD02F0C0143AA3",
      "text": "Falsch! Interessante Idee, aber dann wäre es\\nwohl ein OOPArt, ein Out-of-Place-Artefakt.\\r\\nAlso ein Artefakt, das fehl am Platz ist.\\c\\nDie richtige Antwort lautet: ein Schatz.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 177,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_c_01_history_10",
      "hash64": "293C460CFE5D501A",
      "text": "Es wird vermutet, dass sich auf dem Grund des\\nSchlunds ein Schatz befindet, der wertvoller ist\\r\\nals alles andere auf dieser Welt.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_c_01_history_11",
      "hash64": "293C470CFE5D51CD",
      "text": "Inzwischen wurde dort jedoch ein Labor errichtet.\\nDas mag für einige den Reiz einer Schatzsuche\\r\\nzunichte machen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_c_01_history_12",
      "hash64": "293C440CFE5D4CB4",
      "text": "Oh, und damit das klar ist... Das Betreten des\\nSchlunds von Paldea und von Zone Null ist für\\r\\nUnbefugte strengstens verboten.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_c_01_history_13",
      "hash64": "293C450CFE5D4E67",
      "text": "Also an alle, die meinen, jetzt Schatzsucher\\nspielen zu müssen... Denkt nicht mal dran,\\r\\nauch nur einen Fuß in dieses Gebiet zu setzen.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_c_01_history_14",
      "hash64": "293C420CFE5D494E",
      "text": "Wenn das möglich wäre, hätte ich es schließlich\\nselbst schon lange erkundet![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_c_01_history_15",
      "hash64": "293C430CFE5D4B01",
      "text": "Nanu? Entweder habe ich zu viel geredet oder\\nmeine Uhr geht zu schnell.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_c_01_history_16",
      "hash64": "293C400CFE5D45E8",
      "text": "Das wäre alles für heute. Nächste Stunde werden\\nwir noch mehr historische Mysterien enträtseln.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
