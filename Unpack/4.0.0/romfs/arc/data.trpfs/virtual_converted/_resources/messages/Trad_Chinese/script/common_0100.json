      ]
    },
    {
      "ordinal": 18,
      "label": "common_0100_rival_20c",
      "hash64": "3742C764270977D5",
      "text": "哇！好棒！太棒了！\\n想不到[VAR 0x1100(00FF,0101)]你妳一次就成功了！！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
