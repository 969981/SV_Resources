    },
    {
      "ordinal": 21,
      "label": "common_0100_rival_21d",
      "hash64": "3745A664270B7599",
      "text": "野生的寶可夢有時候會透過\\n了解訓練家有多強，來認同那個訓練家。\\r\\n所以努力對戰，然後投出球吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
