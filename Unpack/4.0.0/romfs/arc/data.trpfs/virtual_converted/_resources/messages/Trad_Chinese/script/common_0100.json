      "ordinal": 25,
      "label": "common_0100_rival_14",
      "hash64": "52924B3E0601C223",
      "text": "一邊往那座燈塔去吧！\\n從那上面可以看到我們的學校呢！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
