            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "common_0100_rival_10",
      "hash64": "52924F3E0601C8EF",
      "text": "要是寶可夢累了，\\n我可以幫忙回復！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
