    {
      "ordinal": 14,
      "label": "common_0100_rival_20a",
      "hash64": "3742C5642709746F",
      "text": "果然厲害！打倒寶可夢的話，\\n[VAR 0x0101(0001)]就會成長變強喔！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
