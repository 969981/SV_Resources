      "ordinal": 23,
      "label": "common_0100_rival_08",
      "hash64": "528ED13E05FEBCFE",
      "text": "先讓寶可夢變弱，再投球！\\n要好好記住這一點喔！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
