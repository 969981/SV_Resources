          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0100_rival_20b",
      "hash64": "3742C66427097622",
      "text": "沒錯！面對打不贏的對手，\\n乾脆逃跑也是一種戰術！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0100_rival_21b",
      "hash64": "3745A864270B78FF",
      "text": "要是己方比較強的話，\\n可以用精靈球去捕捉對手。\\r\\n下次就試試看吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
