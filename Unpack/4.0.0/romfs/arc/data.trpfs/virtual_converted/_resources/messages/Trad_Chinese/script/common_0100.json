          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "common_0100_rival_07",
      "hash64": "528ECC3E05FEB47F",
      "text": "捕捉寶可夢時，有時還是會失敗的。\\n[VAR 0x1100(00FF,0101)]你妳還是再多帶一點球吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
