      ]
    },
    {
      "ordinal": 25,
      "label": "ajito_fairy_010_sitappa_06",
      "hash64": "C28B9B2AC279E7B0",
      "text": "Dieser Gentleman war mal der Direktor der\\nAkademie... glaube ich zumindest?\\c\\nUnd jetzt gibt er dem Boss Nachhilfe... oder so?\\nJedenfalls kommt er manchmal her, um den Boss\\r\\nzum Unterricht abzuholen.[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 173,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 202,
