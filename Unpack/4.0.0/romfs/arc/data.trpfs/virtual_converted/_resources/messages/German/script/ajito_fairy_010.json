      ]
    },
    {
      "ordinal": 23,
      "label": "ajito_fairy_010_jentle_16",
      "hash64": "F2237900C8F8A641",
      "text": "Wenn man mich jetzt entschuldigen würde.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
