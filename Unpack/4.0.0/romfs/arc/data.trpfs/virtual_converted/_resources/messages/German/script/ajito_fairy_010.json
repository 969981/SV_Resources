      "ordinal": 14,
      "label": "ajito_fairy_010_select_03",
      "hash64": "39F810E04BEE9C2B",
      "text": "So ist es!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "ajito_fairy_010_select_04",
      "hash64": "39F815E04BEEA4AA",
      "text": "Ähm. Kann sein?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "ajito_fairy_010_jentle_10",
      "hash64": "F2237B00C8F8A9A7",
      "text": "Verstehe. Wenn das so ist...[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
