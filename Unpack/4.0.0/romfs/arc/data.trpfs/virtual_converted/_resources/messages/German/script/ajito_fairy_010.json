        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_fairy_010_select_01",
      "hash64": "39F812E04BEE9F91",
      "text": "Welches... „jungen Herrn“...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "ajito_fairy_010_select_02",
      "hash64": "39F80FE04BEE9A78",
      "text": "Ähm... Keine Ahnung.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_fairy_010_jentle_05",
      "hash64": "F21FFA00C8F5989D",
      "text": "Ah, schau an.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_fairy_010_jentle_06",
      "hash64": "F21FF700C8F59384",
      "text": "Du scheinst ja gar nicht zu wissen, dass dies das\\nVersteck der Rukbat-Bande ist!\\c\\nHierbei handelt es sich um die vom jungen Herrn\\nOtis angeführten Feen-Mitglieder von Team Star.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 179,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_fairy_010_sitappa_02",
      "hash64": "C28B9F2AC279EE7C",
      "text": "Ähm, i-ich glaube nicht, dass wir diese\\nInformationen einfach so preisgeben sollten...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_fairy_010_jentle_07",
      "hash64": "F21FF800C8F59537",
      "text": "Oh, natürlich. Ich bitte um Verzeihung.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_fairy_010_jentle_08",
      "hash64": "F21FED00C8F58286",
      "text": "Weißt du vielleicht, wer unser Gast hier ist?[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_fairy_010_sitappa_03",
      "hash64": "C28BA02AC279F02F",
      "text": "Vermutlich ein Feind von uns![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_fairy_010_jentle_09",
      "hash64": "F21FEE00C8F58439",
      "text": "Verstehe... Du bist dem jungen Herrn also\\nfeindlich gesinnt?[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
