          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003C"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_fairy_010_sitappa_04",
      "hash64": "C28B9D2AC279EB16",
      "text": "Hä...?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
