          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_kusa_020_keeper_06",
      "hash64": "3530C9AE0E1373CE",
      "text": "Chiedo subito ai Sunflora di sparpagliarsi, allora!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "gym_kusa_020_keeper_07",
      "hash64": "3530CAAE0E137581",
      "text": "Flooora!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "gym_kusa_020_keeper_09",
      "hash64": "3530C4AE0E136B4F",
      "text": "Dicono che sono pronti!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "gym_kusa_020_keeper_10",
      "hash64": "3533D1AE0E15B73D",
      "text": "Diamo inizio all’esame!\\c\\nQuando avrai raccolto [VAR 0x0201(0001)] Sunflora, portali\\nin Piazza Sunflora, mi raccomando.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
