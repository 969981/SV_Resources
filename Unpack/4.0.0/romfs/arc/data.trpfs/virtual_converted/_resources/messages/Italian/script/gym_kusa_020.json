    },
    {
      "ordinal": 3,
      "label": "gym_kusa_020_receptionist_04",
      "hash64": "01E16C63DBE19887",
      "text": "Al momento hai raccolto [VAR 0x0200(0001)] Sunflora, quindi\\nte ne [VAR 0x1105(0002,0705,0007)]mancamancanomancano [VAR 0x0201(0002)]!",
