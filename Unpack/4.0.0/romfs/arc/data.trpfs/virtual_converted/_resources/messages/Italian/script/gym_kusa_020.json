    {
      "ordinal": 18,
      "label": "gym_kusa_020_keeper_01",
      "hash64": "3530CCAE0E1378E7",
      "text": "Ciao! Io mi prendo cura dei Sunflora locali.\\c\\nImmagino che tu sia qui per affrontare l’Esame\\ndella Palestra.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
