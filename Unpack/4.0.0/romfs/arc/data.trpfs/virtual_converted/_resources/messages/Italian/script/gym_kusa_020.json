      "label": "gym_kusa_020_keeper_04",
      "hash64": "3530C7AE0E137068",
      "text": "Grazie per aver trovato tutti questi Sunflora!\\nHai superato l’Esame della Palestra!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "gym_kusa_020_keeper_05",
      "hash64": "3530C8AE0E13721B",
      "text": "Vai pure a comunicare l’esito dell’esame\\nallo staff della Palestra di Los Tazones!",
