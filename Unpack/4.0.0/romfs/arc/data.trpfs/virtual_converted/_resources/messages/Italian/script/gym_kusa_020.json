    },
    {
      "ordinal": 2,
      "label": "gym_kusa_020_receptionist_03",
      "hash64": "01E16963DBE1936E",
      "text": "Il tuo obiettivo è raccogliere [VAR 0x0201(0001)] esemplar[VAR 0x1101(0001,0101)]ei di\\nSunflora, il Pokémon floreale che ricorda il sole.\\c\\nLi troverai sparsi per Los Tazones. Portali\\nin Piazza Sunflora e avrai superato l’esame!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
