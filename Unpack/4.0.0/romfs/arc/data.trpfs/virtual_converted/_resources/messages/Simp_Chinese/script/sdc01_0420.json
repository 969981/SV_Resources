    {
      "ordinal": 1,
      "label": "sdc01_0420_sister_02",
      "hash64": "DABF45802A1508F7",
      "text": "太棒了！\\n终于夺回最后的面具了！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
