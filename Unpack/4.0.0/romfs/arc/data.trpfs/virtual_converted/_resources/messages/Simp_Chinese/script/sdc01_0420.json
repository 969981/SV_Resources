      "ordinal": 5,
      "label": "sdc01_0420_sister_04",
      "hash64": "DABF43802A150591",
      "text": "真是……\\n真～是太好了！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
