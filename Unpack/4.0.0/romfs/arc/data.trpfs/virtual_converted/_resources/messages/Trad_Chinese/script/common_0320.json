    {
      "ordinal": 4,
      "label": "common_0320_rival_04",
      "hash64": "BA4141DC052E932E",
      "text": "從那邊的話，\\n距離圓模鎮很近！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
