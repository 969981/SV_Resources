      ]
    },
    {
      "ordinal": 9,
      "label": "common_0320_friend_03",
      "hash64": "BC71D15D2B33EE65",
      "text": "[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳\\n是從學校的東邊出發是吧！[VAR 0x0114(0006)]",
