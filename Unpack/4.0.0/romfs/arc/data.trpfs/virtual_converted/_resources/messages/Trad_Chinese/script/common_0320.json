    {
      "ordinal": 7,
      "label": "common_0320_friend_01",
      "hash64": "BC71CF5D2B33EAFF",
      "text": "喂？這是[VAR 0x0100(0000)]的\\n手機洛托姆，沒錯吧？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
