    {
      "ordinal": 1,
      "label": "kizuna_history_d_02",
      "hash64": "66311AE071DD1268",
      "text": "[VAR 0x1100(00FF,0101)]你妳要是有興趣了，就幫忙調查一下吧。[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
