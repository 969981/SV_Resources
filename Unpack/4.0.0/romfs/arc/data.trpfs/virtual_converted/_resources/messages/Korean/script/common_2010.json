            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 67,
      "label": "common_2010_top_17",
      "hash64": "5E4DC977DE73C603",
      "text": "다들 치프가 올 거라 생각하고\\n준비하고 있을 테니까\\r\\n지난번과는 차원이 다르게 강할 거예요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
