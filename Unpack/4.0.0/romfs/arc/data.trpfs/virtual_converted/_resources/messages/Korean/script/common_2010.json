          ]
        }
      ]
    },
    {
      "ordinal": 66,
      "label": "common_2010_top_16",
      "hash64": "5E4DC877DE73C450",
      "text": "새로운 챔피언을 선보일\\n좋은 기회가 되겠네요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
