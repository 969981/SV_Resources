    {
      "ordinal": 0,
      "label": "common_2010_friend_01",
      "hash64": "CA1E3453EEE10F47",
      "text": "오! 주인공이 납셨군![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
