      "hash64": "5E4DD777DE73DDCD",
      "text": "협력해 주셔서 고마워요...![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
