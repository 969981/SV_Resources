      ]
    },
    {
      "ordinal": 72,
      "label": "common_2010_botan_06",
      "hash64": "6EF9FE85647018CE",
      "text": "하... 하하... 할게요...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
