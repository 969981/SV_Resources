          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "common_2010_top_15",
      "hash64": "5E4DCB77DE73C969",
      "text": "제가 고른 인재들이니까\\n별일은 없을 테니\\r\\n형식적인 일이라고 생각하시면 될 거예요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
