    {
      "ordinal": 70,
      "label": "common_2010_botan_05",
      "hash64": "6EF9FD856470171B",
      "text": "어... 저요?\\n오늘부터 밀린 애니 달려야 되는데...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
