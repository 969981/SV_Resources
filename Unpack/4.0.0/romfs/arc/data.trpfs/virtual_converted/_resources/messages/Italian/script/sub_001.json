    },
    {
      "ordinal": 46,
      "label": "sub_001_keeper_01",
      "hash64": "B1C254ED006DD28A",
      "text": "Complimenti per la vittoria in palestra!\\nLa tua medaglia brilla come il sole!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 47,
      "label": "sub_001_keeper_02",
      "hash64": "B1C253ED006DD0D7",
