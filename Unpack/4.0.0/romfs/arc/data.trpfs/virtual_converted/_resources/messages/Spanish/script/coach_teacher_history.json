    {
      "ordinal": 54,
      "label": "coach_teacher_history_randomtalk_00",
      "hash64": "1E5F9A87D3C01CCA",
      "text": "¿Te las apañas bien con los tesoros funestos?\\nSi no los necesitas, ya sabes a quién dárselos.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
