    {
      "ordinal": 9,
      "label": "coach_teacher_history_sp01_05b",
      "hash64": "FB5565433062B998",
      "text": "Vaya, vaya, qué modosit[VAR 0x1100(00FF,0101)]oa de repente, ¿no?\\nJu, ju, ju. Bueno, mejor para mí.[VAR 0x0114(0027)]",
