    {
      "ordinal": 18,
      "label": "coach_teacher_history_sp02_05",
      "hash64": "666D10F03CD5CADD",
      "text": "¡Ju, ju, ju! ¡Dime algo que no sepa ya!\\c\\n¡Cualquier cosa que estimule mi curiosidad\\narqueológica es un tesoro que no cambiaría\\r\\npor nada en el mundo![VAR 0x0114(0027)]",
