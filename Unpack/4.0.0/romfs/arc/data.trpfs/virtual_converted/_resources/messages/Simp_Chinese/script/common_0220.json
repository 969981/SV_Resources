          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0220_rival_04",
      "hash64": "F8853908C42AC02B",
      "text": "[VAR 0x0100(0000)]，你对哪个感兴趣？[VAR 0x0114(0004)]",
