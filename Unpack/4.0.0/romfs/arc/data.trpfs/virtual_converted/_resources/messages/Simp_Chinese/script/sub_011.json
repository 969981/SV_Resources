    {
      "ordinal": 32,
      "label": "sub_011_takara_cook_12",
      "hash64": "2374EDEE06E6BCD2",
      "text": "如果还想转换的话，\\n就带太晶碎块过来吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
