      "hash64": "2374ECEE06E6BB1F",
      "text": "[VAR 0x0102(0002)]的太晶属性\\n转换为[VAR 0x0103(0003)]属性了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
