    {
      "ordinal": 33,
      "label": "sub_011_egg",
      "hash64": "421F16C0B65F4C4E",
      "text": "蛋必须先孵出来才行！\\n……比起转换，要先从头开始哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
