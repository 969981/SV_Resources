          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_math_a_13",
      "hash64": "FA797A782652170D",
      "text": "다음에도 언제든지\\n질문하러 오렴![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
