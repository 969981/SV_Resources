          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_a_mob_01",
      "hash64": "74F36DAA300E3DF1",
      "text": "타임 선생님~!\\n타임 선생님~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_a_09",
      "hash64": "FA7C7478265442B2",
      "text": "어머, 씩씩하기도 해라.\\n그렇지만 순서는 지켜야지?\\r\\n타임 선생님은 한 사람이잖니.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_math_a_mob_02",
      "hash64": "74F36AAA300E38D8",
      "text": "타임 선생님!\\n전에 체육관 관장이었다는 거, 진짜예요~!?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "kizuna_math_a_10",
      "hash64": "FA797778265211F4",
      "text": "정말이지 그럼~\\n선생님이 좀 강하거든![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_math_a_mob_03",
      "hash64": "74F36BAA300E3A8B",
      "text": "굉장하다~!\\n근데, 왜 그만두신 거예요~?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "kizuna_math_a_11",
      "hash64": "FA797878265213A7",
      "text": "그건 말이지, 순서를 잘 지키는\\n착한 아이한테만 가르쳐 줄 수 있는데?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_math_a_mob_04",
      "hash64": "74F370AA300E430A",
      "text": "저, 잘 지켜요!\\n기다리고 있을게요~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "kizuna_math_a_12",
      "hash64": "FA7979782652155A",
      "text": "[VAR 0x0100(0000)],\\n이야기 중이었는데 미안해.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
