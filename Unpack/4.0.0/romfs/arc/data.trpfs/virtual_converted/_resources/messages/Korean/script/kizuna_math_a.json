    },
    {
      "ordinal": 10,
      "label": "kizuna_math_a_08a",
      "hash64": "F5BF9F29212F92CC",
      "text": "딩동댕, 정답이야!\\n2배가 되지?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
