        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_a_06",
      "hash64": "FA7C7778265447CB",
      "text": "후후후,\\n정답이라니 기쁘네![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
