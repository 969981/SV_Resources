    },
    {
      "ordinal": 3,
      "label": "kizuna_math_a_select_05",
      "hash64": "306B2535068E4B95",
      "text": "정답이에요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_a_05",
      "hash64": "FA7C78782654497E",
      "text": "어디가 어려웠는데?\\n선생님이랑 같이 공부해 보자![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
