        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_a_08b",
      "hash64": "F5BFA229212F97E5",
      "text": "정답은 2배였지만...\\n[VAR 0x0100(0000)]의 발상도 훌륭하다고 봐.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
