    {
      "ordinal": 17,
      "label": "champ_0270_rival_10",
      "hash64": "0D4599CEA0DE3635",
      "text": "Jetzt, wo wir [VAR 0x1100(00FF,0A07,0000)]RivalenRivalinnen sind, können wir nach\\nHerzenslust kämpfen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0A07",
