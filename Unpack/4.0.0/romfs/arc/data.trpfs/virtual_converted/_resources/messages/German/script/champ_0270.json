      ]
    },
    {
      "ordinal": 18,
      "label": "champ_0270_rival_11",
      "hash64": "0D4598CEA0DE3482",
      "text": "Lass uns gleich damit anfangen! Ich werde dir\\nzeigen, wozu ich fähig bin, wenn ich Ernst mache![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "champ_0270_chairman_01",
      "hash64": "02FA670BAA6F82D0",
      "text": "Ich bitte noch um etwas Geduld, Champ Nemila.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
