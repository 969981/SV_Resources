    {
      "ordinal": 16,
      "label": "champ_0270_rival_09",
      "hash64": "0D421CCEA0DB2BF7",
      "text": "JUHUUUU! Jawoll![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
