          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "champ_0240_fly_13",
      "hash64": "5B009AEB25E882AA",
      "text": "...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
