          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "champ_0240_steel_01",
      "hash64": "EE68B9799860F2FF",
      "text": "¡Has ganado al señor Lau! ¡Eres mi ídolo![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
