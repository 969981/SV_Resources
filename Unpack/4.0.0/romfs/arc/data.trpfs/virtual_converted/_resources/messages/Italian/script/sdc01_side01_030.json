            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_side01_030_brother_23",
      "hash64": "2C656EF8ACE5560A",
      "text": "Pure la Festa delle maschere sembra essere\\nnata grazie a un mio antenato.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
