      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc01_side01_030_brother_20",
      "hash64": "2C656DF8ACE55457",
      "text": "Quindi è una storia vera?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sdc01_side01_030_brother_21",
      "hash64": "2C656CF8ACE552A4",
      "text": "Alla parte in cui l’orco ruba le anime non è che\\nci credo, ma i miei antenati costruivano\\r\\nmaschere per davvero.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
