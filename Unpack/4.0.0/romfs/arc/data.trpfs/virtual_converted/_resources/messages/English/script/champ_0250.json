    {
      "ordinal": 17,
      "label": "champ_0250_dragon_11",
      "hash64": "6EDF9EE937D5F5F7",
      "text": "So whad ib I do?! I’b jusd—jusd so oberwhelmed![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "champ_0250_ground_03",
      "hash64": "89A40F74A5D9B3AC",
      "text": "Guess I’ve got to do the talking...\\c\\nAnyway, your result for the Elite Test of the\\nChampion Assessment is...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "champ_0250_ground_04",
      "hash64": "89A40E74A5D9B1F9",
      "text": "a pass! No doubt about it![VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "champ_0250_steel_03",
      "hash64": "A9A7E58A84824296",
      "text": "Yeeeaaah! You’re tougher than steel![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
