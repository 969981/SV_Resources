          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "champ_0250_fly_02",
      "hash64": "CFB08A71330A1303",
      "text": "Yep.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "champ_0250_dragon_12",
      "hash64": "6EDF9FE937D5F7AA",
      "text": "Y-you did so BEAUDIFULLY![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "champ_0250_ground_05",
      "hash64": "89A40D74A5D9B046",
      "text": "Congratulations![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "champ_0250_ground_06",
      "hash64": "89A40C74A5D9AE93",
      "text": "I’d say you’re good to go, but...there’s actually\\njust a wee bit more to the Champion Assessment.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "champ_0250_ground_07",
      "hash64": "89A40B74A5D9ACE0",
      "text": "This’ll be your final trial.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "champ_0250_ground_08",
      "hash64": "89A41A74A5D9C65D",
      "text": "See the door back there?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "champ_0250_ground_09",
      "hash64": "89A41974A5D9C4AA",
      "text": "Our fearless commander—the final opponent\\nyou’ll face for your test—is waiting beyond it.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "champ_0250_ground_10",
      "hash64": "89A08C74A5D69F3C",
      "text": "Her skills are so amazing, she was able to\\nstrong-arm all of us into joining the Elite Four.\\c\\nYou won’t find a mightier Champion.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "champ_0250_ground_11",
      "hash64": "89A08D74A5D6A0EF",
      "text": "Though I think you’ll do fine, kiddo! You beat\\nme, after all![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "champ_0250_ground_14",
      "hash64": "89A08874A5D69870",
      "text": "I’ll patch up your team—on the house—so don’t\\nlose, you hear?[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "champ_0250_steel_04a",
      "hash64": "CA97F15F2960030A",
      "text": "I really love your Pokémon, miss![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "champ_0250_steel_04b",
      "hash64": "CA97F05F29600157",
      "text": "I really love your Pokémon, mister![VAR 0x0114(0014)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
