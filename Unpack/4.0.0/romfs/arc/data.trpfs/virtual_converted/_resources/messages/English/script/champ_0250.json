      "label": "champ_0250_fly_03",
      "hash64": "CFB08971330A1150",
      "text": "Well, uh, good lu—[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
