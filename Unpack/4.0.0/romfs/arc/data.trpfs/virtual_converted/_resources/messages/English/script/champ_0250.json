      ]
    },
    {
      "ordinal": 33,
      "label": "champ_0250_steel_05",
      "hash64": "A9A7E78A848245FC",
      "text": "So I’ll cheer for you as hard as I can![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
