      "ordinal": 35,
      "label": "champ_0250_dragon_13",
      "hash64": "6EDFA0E937D5F95D",
      "text": "Even a baby dragon can breathe fire![VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
