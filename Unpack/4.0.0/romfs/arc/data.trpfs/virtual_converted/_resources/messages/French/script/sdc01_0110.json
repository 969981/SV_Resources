    {
      "ordinal": 34,
      "label": "sdc01_0110_gmother_11",
      "hash64": "24BE989E930703D5",
      "text": "Hmmm... Je suis sûre d’avoir rangé les masques\\ndans le cabanon, l’année dernière.[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
