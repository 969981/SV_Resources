    },
    {
      "ordinal": 33,
      "label": "sdc01_0110_sister_04",
      "hash64": "0F0880773724E9F9",
      "text": "Ah oui ! Mamie, je trouve mon masque nulle part.\\nTu sais où il est ?[VAR 0x0114(0044)]",
