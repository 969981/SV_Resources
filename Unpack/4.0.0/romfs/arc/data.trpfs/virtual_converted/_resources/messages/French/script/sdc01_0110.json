    {
      "ordinal": 35,
      "label": "sdc01_0110_gfather_06",
      "hash64": "A482EAB30424FD42",
      "text": "Il n’est pas fermé à clé, vous pouvez donc aller\\nles chercher vous-mêmes.[VAR 0x0114(0030)]",
