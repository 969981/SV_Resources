    {
      "ordinal": 31,
      "label": "sdc01_0110_sister_03",
      "hash64": "0F0881773724EBAC",
      "text": "Oh ? Vraiment ?\\nC’est le grand amour, entre vous deux, dis donc.[VAR 0x0114(0044)]",
