    },
    {
      "ordinal": 36,
      "label": "sdc01_0110_sister_05",
      "hash64": "0F087F773724E846",
      "text": "Allez ! On fait la course jusqu’au cabanon !\\nLe dernier arrivé est un Poussifeu mouillé ![VAR 0x0114(0044)]",
