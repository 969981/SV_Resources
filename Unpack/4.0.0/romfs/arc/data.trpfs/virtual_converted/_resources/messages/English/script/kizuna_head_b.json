    },
    {
      "ordinal": 19,
      "label": "kizuna_head_b_05_07",
      "hash64": "7D2D1C7D9693D307",
      "text": "Oho. Mr. Saguaro from home economics class,\\nyou say?\\c\\nYes, he is a fine teacher. A most calm and\\ncollected fellow.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
