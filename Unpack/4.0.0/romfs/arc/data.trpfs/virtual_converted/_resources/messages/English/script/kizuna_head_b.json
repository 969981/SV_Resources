          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_head_b_05_08",
      "hash64": "7D2D117D9693C056",
      "text": "Oho. Nurse Miriam, you say?\\c\\nYes, she is a fine practitioner of medicine. A most\\nkind and gentle soul.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
