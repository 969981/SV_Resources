          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_head_b_04",
      "hash64": "CE14614BD42FCA42",
      "text": "I understand you have joined a variety of classes\\nduring your time here at the academy.\\c\\nBut, if I may ask, which of our faculty members\\nhas made the most favorable impression on you?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
