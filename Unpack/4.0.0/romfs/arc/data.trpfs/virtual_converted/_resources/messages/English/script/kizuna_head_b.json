      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_head_b_05_02",
      "hash64": "7D2D177D9693CA88",
      "text": "Oho. Ms. Tyme from math class, you say?\\c\\nYes, she is a fine teacher. A most warm and\\npeaceable woman.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
