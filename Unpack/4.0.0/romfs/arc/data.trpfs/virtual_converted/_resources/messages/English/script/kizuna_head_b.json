        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_head_b_03",
      "hash64": "CE145C4BD42FC1C3",
      "text": "Speaking of which, there is something I would\\nvery much like to ask you...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
