          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_friend_b_head_01a",
      "hash64": "2E7B1A64DB913737",
      "text": "When Sada was a student at this academy, I was\\nstill a mere researcher myself.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
