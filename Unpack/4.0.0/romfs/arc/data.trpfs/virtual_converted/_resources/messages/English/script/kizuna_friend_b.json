    },
    {
      "ordinal": 12,
      "label": "kizuna_friend_b_head_03",
      "hash64": "E65A9A3BABC28D72",
      "text": "Ho! So you’ve finally noticed, have you?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
