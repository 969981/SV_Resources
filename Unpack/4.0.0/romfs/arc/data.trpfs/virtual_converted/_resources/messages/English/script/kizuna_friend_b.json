    {
      "ordinal": 13,
      "label": "kizuna_friend_b_head_04a",
      "hash64": "2E702664DB874416",
      "text": "This room was once your mother’s research lab.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
