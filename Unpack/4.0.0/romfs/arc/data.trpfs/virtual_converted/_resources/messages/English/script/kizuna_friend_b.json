      "ordinal": 1,
      "label": "kizuna_friend_b_02",
      "hash64": "EC8C2D4CC93A3B86",
      "text": "Take a look at this![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
