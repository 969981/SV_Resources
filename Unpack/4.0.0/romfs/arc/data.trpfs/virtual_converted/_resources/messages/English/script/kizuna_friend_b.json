      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_friend_b_04",
      "hash64": "EC8C2F4CC93A3EEC",
      "text": "Hehe, that’s what Director Clavell here told me.\\nHe’s been helping me out.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
