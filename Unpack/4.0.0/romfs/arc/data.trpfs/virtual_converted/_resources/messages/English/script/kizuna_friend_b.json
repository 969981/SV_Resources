    {
      "ordinal": 9,
      "label": "kizuna_friend_b_05a",
      "hash64": "2C771079EDFC6F9A",
      "text": "So she really was always amazing...right from the\\nstart, huh?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
