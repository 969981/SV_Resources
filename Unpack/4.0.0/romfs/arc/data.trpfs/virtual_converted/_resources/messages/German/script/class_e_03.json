    {
      "ordinal": 0,
      "label": "class_e_03_battle_01",
      "hash64": "60E84D9A515A901A",
      "text": "Ein neuer Tag, ein neuer Kampf! Tach und\\nwillkommen zu meinem Kampfkurs![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
