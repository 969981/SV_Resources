          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_health_b_07",
      "hash64": "D8FBA879A0491DA3",
      "text": "I sure am jealous of you kids. You get to try out\\nnew things every single day.[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
