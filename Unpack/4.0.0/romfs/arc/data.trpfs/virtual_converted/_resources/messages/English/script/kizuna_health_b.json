          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_health_b_14",
      "hash64": "D8FF3779A04C4677",
      "text": "But you’re just such a good listener! I find myself\\ntelling you all kinds of stuff.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
