          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_health_b_09",
      "hash64": "D8FBB679A049356D",
      "text": "I actually wanted to become a teacher.[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_health_b_10",
      "hash64": "D8FF3379A04C3FAB",
      "text": "I’m just the school nurse, y’know? I can’t teach\\nclasses or anything like that.[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_health_b_11",
      "hash64": "D8FF3279A04C3DF8",
      "text": "I couldn’t pass the certification exam to become\\nan actual health teacher.[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_health_b_12",
      "hash64": "D8FF3579A04C4311",
      "text": "I took it so many times, but no luck. So here I\\nam...stuck forever in the nurse’s office.[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_health_b_13",
      "hash64": "D8FF3479A04C415E",
      "text": "Oh, uh...sorry. I guess this isn’t a very fun thing to\\ntalk about.[VAR 0x0114(0028)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
