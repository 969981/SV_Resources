    {
      "ordinal": 25,
      "label": "ajito_kakutou_040_kakutouboss_13",
      "hash64": "8A481D2B2643490B",
      "text": "Aber während unseres Kampfes wurde mir klar,\\ndass du kein schlechter Mensch bist.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
