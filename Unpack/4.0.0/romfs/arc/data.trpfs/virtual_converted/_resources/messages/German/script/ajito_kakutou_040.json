        }
      ]
    },
    {
      "ordinal": 4,
      "label": "ajito_kakutou_040_akuboss_02",
      "hash64": "A36B9664C593AC70",
      "text": "Wir haben dich schließlich darum gebeten, das\\nTraining wie einen echten Kampf zu behandeln.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_kakutou_040_kakutouboss_02",
      "hash64": "8A4BA62B264667AD",
      "text": "Aber...[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
