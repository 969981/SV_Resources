    },
    {
      "ordinal": 3,
      "label": "ajito_kakutou_040_akuboss_01",
      "hash64": "A36B9964C593B189",
      "text": "Ach, mach dir keinen Kopf.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
