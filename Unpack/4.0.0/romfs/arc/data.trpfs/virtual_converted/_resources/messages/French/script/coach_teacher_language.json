    },
    {
      "ordinal": 39,
      "label": "coach_teacher_language_trade_01_00",
      "hash64": "BD448DB5AE365F2D",
      "text": "Ce dont je suis certain, en revanche, c’est que\\nles relations humaines sont à la base de tout.\\c\\nIl est impossible de vivre sans échanger avec\\nautrui, alors soyons ouverts aux autres ![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
