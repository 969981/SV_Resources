    },
    {
      "ordinal": 40,
      "label": "coach_teacher_language_trade_01_01",
      "hash64": "BD448CB5AE365D7A",
      "text": "Je pense d’ailleurs que nous devrions échanger\\ndavantage, toi et moi ![VAR 0x0114(0026)]",
