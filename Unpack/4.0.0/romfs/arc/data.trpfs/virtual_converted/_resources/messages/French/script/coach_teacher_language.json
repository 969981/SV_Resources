      ]
    },
    {
      "ordinal": 41,
      "label": "coach_teacher_language_trade_01_02",
      "hash64": "BD448BB5AE365BC7",
      "text": "Dans cet esprit, je te propose de faire\\nun échange de Pokémon ! Yes or no ?[VAR 0x0114(0026)]",
