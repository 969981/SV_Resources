    {
      "ordinal": 5,
      "label": "common_2020_koori_010_koori_03b",
      "hash64": "C31E53DD278BC8C1",
      "text": "으음...?\\n무슨 뜻인지 전혀 모르겠는데...[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
