    },
    {
      "ordinal": 7,
      "label": "common_2020_koori_010_koori_05",
      "hash64": "39421D6C3477CD3F",
      "text": "챔피언 랭크가 되다니,\\n꿈을 이룬 것 같아서 잘~됐네.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
