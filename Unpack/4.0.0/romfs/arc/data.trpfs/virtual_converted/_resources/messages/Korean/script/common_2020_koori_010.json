    },
    {
      "ordinal": 8,
      "label": "common_2020_koori_010_koori_06",
      "hash64": "39421E6C3477CEF2",
      "text": "...이런, 미안.\\n내가 생각해도 빈정대는 것처럼 들리는걸.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
