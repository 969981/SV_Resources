    },
    {
      "ordinal": 61,
      "label": "coach_bb4kings_honoo_randomtalk_02",
      "hash64": "73934771A505C049",
      "text": "超辣大神是\\n掌管辛辣的神明，超厉害！\\r\\n是我想出来的！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
