          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_b_06_math_19",
      "hash64": "4C74EE4AA1DED7BB",
      "text": "Die Surfer-Hydropumpe-Debatte wird seit jeher\\nheiß geführt.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_b_06_math_20",
      "hash64": "4C7EF74AA1E73B8B",
      "text": "Ich persönlich bevorzuge ja den Typ Gestein,\\ndaher beschäftigt mich eher die Frage\\r\\n„Steinhagel oder Steinkante“.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_b_06_math_21",
      "hash64": "4C7EF64AA1E739D8",
      "text": "Darüber könnte ich mich endlos auslassen...\\nOh, da ertönt schon wieder die Klingel!\\c\\nZu schade, das Thema müssen wir wohl auf\\nwann anders verschieben.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 152,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_b_06_math_22",
      "hash64": "4C7EF94AA1E73EF1",
      "text": "Mit der nächsten Stunde haben wir bereits das\\nEnde meines Kurses erreicht.\\c\\nLasst uns alle weiterhin 100 % geben![VAR 0x0114(0025)]",
