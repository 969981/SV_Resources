        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_b_06_math_16",
      "hash64": "4C74EB4AA1DED2A2",
      "text": "Für welche der Attacken würdet ihr euch also\\nentscheiden?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
