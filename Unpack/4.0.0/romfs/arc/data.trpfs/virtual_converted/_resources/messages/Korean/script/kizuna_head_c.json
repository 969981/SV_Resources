      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_head_c_07",
      "hash64": "7668304437B0982E",
      "text": "혹시 리젠트는\\n살짝 촌스러운 머리인가요...?\\r\\n역시 가발을 바꾸는 게 좋으려나...?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
