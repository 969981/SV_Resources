      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_head_c_04",
      "hash64": "76682F4437B0967B",
      "text": "그건 그렇고,\\n또 의견을 듣고 싶은 것이 있습니다.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
