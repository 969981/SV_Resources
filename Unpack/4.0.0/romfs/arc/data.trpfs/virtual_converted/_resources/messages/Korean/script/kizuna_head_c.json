      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_head_c_03",
      "hash64": "7668344437B09EFA",
      "text": "...후후후.\\n글쎄, 누구일까요?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
