      ]
    },
    {
      "ordinal": 8,
      "label": "class_d_02_select_01",
      "hash64": "30B8D63961E45056",
      "text": "Lecker!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "class_d_02_select_02",
      "hash64": "30B8D53961E44EA3",
      "text": "Entschuldigung.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "class_d_02_select_03",
      "hash64": "30B8D43961E44CF0",
      "text": "Hilfe!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_d_02_language_answer_01",
      "hash64": "DE6A8E54C60CCA99",
      "text": "Wooow! Molto, molto richtig! Du hast es drauf,\\n[VAR 0x0100(0000)]![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
