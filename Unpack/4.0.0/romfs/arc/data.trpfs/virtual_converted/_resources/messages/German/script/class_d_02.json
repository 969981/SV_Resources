          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_d_02_yes_01",
      "hash64": "2B2E9612F207D51B",
      "text": "Ja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "class_d_02_yes_02",
      "hash64": "2B2E9712F207D6CE",
      "text": "Yes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_d_02_language_03",
      "hash64": "F15AB8CD7B82D826",
      "text": "Muy bien![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
