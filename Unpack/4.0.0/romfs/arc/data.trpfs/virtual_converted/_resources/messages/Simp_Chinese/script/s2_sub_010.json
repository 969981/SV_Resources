      "hash64": "5055D90A700B24B7",
      "text": "咦～？[VAR 0x0100(0000)]，\\n你来这儿做什么呀？[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
