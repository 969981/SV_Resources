          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_b_06_math_answer_02",
      "hash64": "9038391829CEBF7A",
      "text": "¡Qué arrojo, [VAR 0x0100(0000)]!\\nQuien no arriesga no gana, qué duda cabe.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_b_06_math_answer_03",
      "hash64": "90383A1829CEC12D",
      "text": "¡Muy sagaz! Conviene barajar varias estrategias\\nantes de tomar decisiones.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_b_06_math_17",
      "hash64": "4C74EC4AA1DED455",
      "text": "La verdad es que esta pregunta no tiene ninguna\\nrespuesta más adecuada que las demás.\\c\\nComo Entrenadores, sois libres de usar el\\nmovimiento que más os guste.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 159,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_b_06_math_18",
      "hash64": "4C74ED4AA1DED608",
      "text": "Cosas como los PP de un movimiento y a cuántos\\noponentes afecta son factores objetivos, pero\\r\\nno son lo que determina si es mejor que otros.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_b_06_math_19",
      "hash64": "4C74EE4AA1DED7BB",
      "text": "Aun así, preguntas como la que os he hecho dan\\nlugar a mucho debate.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_b_06_math_20",
      "hash64": "4C7EF74AA1E73B8B",
      "text": "Yo soy más aficionada al tipo Roca, así que, en\\nvez de Surf e Hidrobomba, preferiría comparar\\r\\nAvalancha y Roca Afilada.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_b_06_math_21",
      "hash64": "4C7EF64AA1E739D8",
      "text": "En fin... Acaba de sonar el timbre, así que ya no\\nhay tiempo de darle más vueltas al tema.[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
