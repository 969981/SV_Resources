  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_028_middlef_00",
      "hash64": "D1EDE1F9BC47230F",
      "text": "Oh... Percepisco una grande profondità nel tuo\\npassato. Devi aver visto molto in vite precedenti.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_028_middlef_01",
      "hash64": "D1EDE0F9BC47215C",
      "text": "Posso sbirciare nelle tue vite passate studiando\\nil tuo Smart Rotom, grazie a una cosa chiamata\\r\\nRotometria! Vuoi provare?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_028_middlef_02",
      "hash64": "D1EDE3F9BC472675",
      "text": "Mmh, forse è meglio di no...\\nTanto la visione non è chiara...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_028_middlef_03",
      "hash64": "D1EDE2F9BC4724C2",
      "text": "Il tuo passato mi scorre davanti agli occhi! Vedo\\nche una volta vivevi a... Dov’è questo posto...?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_028_select_a",
      "hash64": "35D0BFAD69D0E96D",
      "text": "Kanto?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_028_select_b",
      "hash64": "35D0BCAD69D0E454",
      "text": "Galar?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_028_select_c",
      "hash64": "35D0BDAD69D0E607",
      "text": "Sinnoh?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_028_select_d",
      "hash64": "35D0BAAD69D0E0EE",
      "text": "Hisui?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_028_select_e",
      "hash64": "35D0BBAD69D0E2A1",
      "text": "Dovrei andare...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_028_middlef_04",
      "hash64": "D1EDDDF9BC471C43",
      "text": "Ah, sì! Sta diventando più chiaro... In questa vita\\nprecedente vivevi a...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_028_middlef_a",
      "hash64": "036CE3FECEFF3FC2",
      "text": "Sì, dev’essere così! Viaggiavi per Kanto a fianco\\ndel tuo fidato Pokémon al grido di \"Let’s go\"!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_028_middlef_b",
      "hash64": "036CE2FECEFF3E0F",
      "text": "Galar! Ti vedo affrontare enormi sfide nella\\nregione di Galar al fianco di Pokémon\\r\\ndynamaxizzati altrettanto enormi!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_028_middlef_c",
      "hash64": "036CE1FECEFF3C5C",
      "text": "Sinnoh! Ti vedo scavare sotto la superficie della\\nregione di Sinnoh e incantare il pubblico delle\\r\\nSuper Gare!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sub_028_middlef_d",
      "hash64": "036CE0FECEFF3AA9",
      "text": "Hisui! Ti vedo affrontare grandi avventure nella\\nregione di Hisui impugnando un misterioso\\r\\nsmartphone! Ma dov’è Hisui?! Mai sentita...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sub_028_middlef_05",
      "hash64": "D1EDDCF9BC471A90",
      "text": "Creerò per te una cover per lo smartphone\\nsulla base dei tuoi ricordi.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "sub_028_middlef_06",
      "hash64": "D1EDDFF9BC471FA9",
      "text": "E... voilà!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sub_028_middlef_07",
      "hash64": "D1EDDEF9BC471DF6",
      "text": "La tua cover è pronta. Portala con orgoglio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sub_028_system_a",
      "hash64": "4AF36B673E33A1D0",
