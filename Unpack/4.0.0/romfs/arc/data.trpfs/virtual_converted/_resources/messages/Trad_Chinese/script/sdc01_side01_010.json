      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "sdc01_side01_010_select_06",
      "hash64": "E2B4A3FA0E7401E3",
      "text": "坐騎寶可夢",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
