      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_history_c_03",
      "hash64": "5DCE53A6482D028C",
      "text": "Es gibt sie wirklich![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
