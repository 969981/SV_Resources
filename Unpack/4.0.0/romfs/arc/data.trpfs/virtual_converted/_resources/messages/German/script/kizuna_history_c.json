          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_history_c_05",
      "hash64": "5DCE51A6482CFF26",
      "text": "Die Pokémon-Bändiger benutzten anscheinend\\ngeweihte Pfähle, um die Schätze des Unheils in\\r\\nSchreinen zu versiegeln.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_history_c_06",
      "hash64": "5DCE50A6482CFD73",
      "text": "Jedes Pokémon wurde dabei in seinem eigenen\\nSchrein versiegelt.\\c\\nIn der Umgebung eines jeden Schreines halten\\nnun acht in den Boden getriebene Pfähle die\\r\\ndunklen Kräfte in Schach.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 155,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 184,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_history_c_07",
      "hash64": "5DCE4FA6482CFBC0",
      "text": "Würde man also alle Pfähle nahe einem Schrein\\nentfernen...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_history_c_08",
      "hash64": "5DCE5EA6482D153D",
      "text": "Dann könnte man die als Schätze des Unheils\\nbezeichneten Pokémon freilassen![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
