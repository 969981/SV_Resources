          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_history_c_09",
      "hash64": "5DCE5DA6482D138A",
      "text": "[VAR 0xBD06(0000)]Und, [VAR 0x0100(0000)]? Bekommst du da nicht\\nLust,\\r\\ndiesen\\r\\narmen\\r\\neingesperrten\\r\\nPokémon\\r\\ndie\\r\\nFreiheit\\r\\nzu\\r\\nschenken?[VAR 0x0114(0027)]",
