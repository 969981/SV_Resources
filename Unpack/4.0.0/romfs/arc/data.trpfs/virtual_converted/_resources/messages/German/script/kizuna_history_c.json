        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_history_c_15",
      "hash64": "5DCB4DA6482AC283",
      "text": "Ich würde meiner Abenteuerlust ja gerne selber\\nfrönen, aber wenn ich den Unterricht noch öfter\\r\\nsausen lasse...\\r\\nDer Direktor ist schon misstrauisch genug.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
