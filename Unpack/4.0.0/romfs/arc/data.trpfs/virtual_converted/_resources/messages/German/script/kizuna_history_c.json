          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_history_c_13",
      "hash64": "5DCB53A6482ACCB5",
      "text": "Jemand mit deinen Fähigkeiten sollte dazu also\\ngewiss in der Lage sein.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
