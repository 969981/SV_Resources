    },
    {
      "ordinal": 50,
      "label": "coach_gym_koori_battleend_win_01_00",
      "hash64": "153AD09130971D6E",
      "text": "感觉你真的好喜欢\\n把我打败啊。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
