          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "coach_gym_koori_trade_03_01",
      "hash64": "EAF19741882285E7",
      "text": "……我也只是开玩笑而已，别在意。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "coach_gym_koori_trade_04_00",
      "hash64": "1C96886B415B5F1F",
      "text": "要来做尴冷的事吗？\\n例如和我交换宝可梦之类的。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "coach_gym_koori_talkto_00",
      "hash64": "9EAE8C073B56427B",
      "text": "你的那个表情……\\n是想和我对战吗？[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_gym_koori_cancel_00",
      "hash64": "283DD088E6A95068",
      "text": "你放弃是个正确的选择。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
