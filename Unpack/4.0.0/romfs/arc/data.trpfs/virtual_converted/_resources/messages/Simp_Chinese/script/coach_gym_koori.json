    },
    {
      "ordinal": 43,
      "label": "coach_gym_koori_battlestart_00",
      "hash64": "F97E2A7B7EB088F2",
      "text": "好尴冷的回答……\\n但偶尔这样也不坏。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
