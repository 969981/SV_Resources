    {
      "ordinal": 6,
      "label": "kizuna_head_d_select_02",
      "hash64": "CF8A462FB375DA03",
      "text": "이미 친구예요!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_head_d_06",
      "hash64": "44C31F1A7E778896",
      "text": "...당신이 전학을 와서\\n얼마나 다행인지 모르겠습니다.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
