      "label": "kizuna_head_d_01",
      "hash64": "44C3221A7E778DAF",
      "text": "스타더스트 대작전에서는\\n정말 수고 많으셨습니다.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
