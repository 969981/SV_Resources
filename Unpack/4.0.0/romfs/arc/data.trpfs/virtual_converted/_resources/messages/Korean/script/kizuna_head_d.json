    },
    {
      "ordinal": 8,
      "label": "kizuna_head_d_07",
      "hash64": "44C3201A7E778A49",
      "text": "이건 교장이 드리는 상입니다.\\n사양하지 말고 받아 주시지요.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
