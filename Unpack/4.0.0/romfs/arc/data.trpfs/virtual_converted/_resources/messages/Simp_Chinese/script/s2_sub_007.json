    {
      "ordinal": 0,
      "label": "s2_sub_007_aku_01",
      "hash64": "BBF28BAC09D8D5AF",
      "text": "[VAR 0x0100(0000)]！[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
