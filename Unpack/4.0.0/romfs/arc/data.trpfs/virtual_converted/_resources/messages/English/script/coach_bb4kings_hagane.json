            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb4kings_hagane_sp01_select_01",
      "hash64": "C3836108EE7B8717",
      "text": "Nah, it’s doing great!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_bb4kings_hagane_sp01_select_02",
      "hash64": "C3836208EE7B88CA",
      "text": "We’ve been flying a lot!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_bb4kings_hagane_sp01_03",
      "hash64": "C99A4C82D0940E4E",
      "text": "That is a relief.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_bb4kings_hagane_sp01_04",
      "hash64": "C99A4F82D0941367",
      "text": "Seeing it consume such a quantity of that\\nsupplement caused me some concern.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb4kings_hagane_sp01_05",
      "hash64": "C99A4E82D09411B4",
      "text": "Perhaps Agias’s sturdy constitution has shielded it\\nfrom any ill effects.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb4kings_hagane_sp01_06",
      "hash64": "C99A5182D09416CD",
      "text": "I suspect it would be dangerous to let any other\\nPokémon eat as much of the supplement.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb4kings_hagane_sp01_07",
      "hash64": "C99A5082D094151A",
      "text": "Since I usually ride my Skarmory for the Flying\\nTime Trial, I have not had the opportunity to test\\r\\nsuch matters myself.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb4kings_hagane_sp01_08",
      "hash64": "C99A4382D093FF03",
      "text": "I have nothing else to report. Let us conclude this\\nconversation.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb4kings_hagane_sp02_00",
      "hash64": "F484C1778787444C",
      "text": "I have a question, [VAR 0x0100(0000)].[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb4kings_hagane_sp02_01",
      "hash64": "F484C277878745FF",
      "text": "How was it that you and Kieran first met?[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb4kings_hagane_sp02_select_01",
      "hash64": "D2A78799FC4F6886",
      "text": "On a school trip!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb4kings_hagane_sp02_select_02",
      "hash64": "D2A78699FC4F66D3",
      "text": "We paired up!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_bb4kings_hagane_sp02_02",
      "hash64": "F484C377878747B2",
      "text": "So it was a trip that started it all?\\c\\nI do recall that Kieran and Carmine returned to\\nKitakami shortly before Kieran’s...change.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb4kings_hagane_sp02_02b",
      "hash64": "04DFF41B4ADF0670",
      "text": "P-paired?!\\c\\n...Ahem. Pardon me.\\c\\nI understand now that you mean you undertook\\nyour school trip activities as a pair.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb4kings_hagane_sp02_03",
      "hash64": "F484C47787874965",
      "text": "I have been wondering why your presence\\nprovoked such intense reactions from Kieran.[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb4kings_hagane_sp02_04",
      "hash64": "F484BD7787873D80",
      "text": "Based on what you’ve said, I doubt that the\\ncircumstances of your meeting were the cause.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb4kings_hagane_sp02_05",
      "hash64": "F484BE7787873F33",
      "text": "My question is answered. Thank you.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_bb4kings_hagane_sp03_00",
      "hash64": "F12997725EAB7B3D",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)], I would like to\\nconsult\\r\\nyou\\r\\non\\r\\nsomething.[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
