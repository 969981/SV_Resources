    {
      "ordinal": 4,
      "label": "coach_bb4kings_hagane_sp01_02",
      "hash64": "C99A4D82D0941001",
      "text": "I hope your Agias hasn’t suffered any...\\naftereffects from the other day?[VAR 0x0114(0048)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
