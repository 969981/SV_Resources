    {
      "ordinal": 6,
      "label": "s2_side02_0030_camera_04",
      "hash64": "9180AA077DC9A18D",
      "text": "Nanu, ist das etwa...? Du hast eines der Pokémon\\nauf den Fotos echt gefunden?![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
