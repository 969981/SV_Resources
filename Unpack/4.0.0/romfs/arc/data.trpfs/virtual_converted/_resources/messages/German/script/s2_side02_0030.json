            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side02_0030_camera_07",
      "hash64": "9180A7077DC99C74",
      "text": "Du hast sie beide gefunden! Was anderes habe\\nich aber auch nicht von dir erwartet.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side02_0030_camera_08",
      "hash64": "91809E077DC98D29",
      "text": "Wenn ich ehrlich bin, haben mich die seltsamen\\nFotos so beschäftigt, dass ich mich gar nicht\\r\\nrichtig auf meine Arbeit konzentrieren konnte...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side02_0030_camera_09",
      "hash64": "91809D077DC98B76",
      "text": "Wir hatten zwar nichts abgemacht, aber ich\\nmöchte mich trotzdem bei dir dafür bedanken,\\r\\ndass ich die Sache jetzt ruhen lassen kann.\\c\\nHier, ich bin wie üblich sehr großzügig![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 178,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_side02_0030_camera_10",
      "hash64": "917D20077DC68138",
      "text": "Hach, die Welt steckt immer noch voller\\nGeheimnisse...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_side02_0030_camera_11",
      "hash64": "917D21077DC682EB",
      "text": "Aber wenn man erst mal erwachsen ist, kann man\\nihnen nicht mehr so hinterherjagen wie früher.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_side02_0030_camera_12",
      "hash64": "917D22077DC6849E",
      "text": "Deshalb musst du dir deine Abenteuerlust\\nbewahren, so lange du kannst.\\c\\nGeh da raus und entdecke noch viel mehr\\nunbekannte Pokémon! Tu’s für mich, okay?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 154,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_side02_0030_camera_13",
      "hash64": "917D23077DC68651",
      "text": "So... Jetzt aber genug davon! Zeit, wieder an die\\nArbeit zu gehen.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_side02_0030_camera_npc_01",
      "hash64": "A487FFC5BD0B7C06",
      "text": "In letzter Zeit sind einige neue Funktionen für die\\nKamera-App erschienen.\\c\\nVielleicht sollte ich mich als Fotografin auch\\nmit Filtern und so auskennen, damit ich den\\r\\nTrends nicht total hinterherhinke...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 168,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 208,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_side02_0030_camera_npc_02",
      "hash64": "A487FEC5BD0B7A53",
      "text": "Sprich doch hin und wieder auch mit Fukano.\\nEs scheint sich an dich zu erinnern und freut sich\\r\\nsicher über die Aufmerksamkeit![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_side02_0030_camera_npc_03",
      "hash64": "A487FDC5BD0B78A0",
      "text": "Schon beeindruckend, diese Tera-Kuppel!\\nKaum zu glauben, dass sie sich unter Wasser\\r\\nbefindet.\\c\\nVerschneite Berge sind nur einen Mauzi-Sprung\\nvon tropischen Stränden entfernt.\\c\\nSo viele verschiedene Motive für Fotos...\\nDer Traum aller Fotografen![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 179,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 252,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_side02_0030_camera_npc_04",
      "hash64": "A48804C5BD0B8485",
      "text": "Die Fotos von Blutmond, die ich mit dir gemacht\\nhabe, sind zwar allesamt verschwommen,\\r\\naber ich liebe sie trotzdem.\\c\\nSie sind mein allergrößter Schatz.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
