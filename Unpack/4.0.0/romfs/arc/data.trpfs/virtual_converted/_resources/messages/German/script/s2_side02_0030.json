          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side02_0030_camera_06",
      "hash64": "9180A8077DC99E27",
      "text": "[VAR 0xBD06(0000)]Damit fehlt nur noch ein weiteres Pokémon.\\nLass bald wieder von dir hören,\\r\\n[VAR 0x0100(0000)]![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
