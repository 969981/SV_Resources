      "ordinal": 10,
      "label": "sdc01_0420_select_01",
      "hash64": "9DF9DF558F2AB736",
      "text": "但是村子裡……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sdc01_0420_select_02",
      "hash64": "9DF9DE558F2AB583",
      "text": "沒問題嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sdc01_0420_brother_04",
      "hash64": "20B1013777FE4DCB",
      "text": "相信我。\\n一定……沒問題的。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
