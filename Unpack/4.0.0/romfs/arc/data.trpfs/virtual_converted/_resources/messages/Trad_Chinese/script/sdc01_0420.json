      "ordinal": 17,
      "label": "sdc01_0420_sister_08",
      "hash64": "DABF3F802A14FEC5",
      "text": "我們就相信阿栗，\\n先去村裡看看再說吧。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
