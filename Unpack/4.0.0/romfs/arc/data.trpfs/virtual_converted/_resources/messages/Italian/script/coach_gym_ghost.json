    },
    {
      "ordinal": 55,
      "label": "coach_gym_ghost_randomtalk_01",
      "hash64": "B11B6279BF8E2CC7",
      "text": "Bella l’arena che c’è all’entrata della scuola!\\c\\nCon tutti i posti a sedere che ha intorno, ci si può\\nfare anche un live da sballo![VAR 0x0114(001B)]",
      "flags": 0,
