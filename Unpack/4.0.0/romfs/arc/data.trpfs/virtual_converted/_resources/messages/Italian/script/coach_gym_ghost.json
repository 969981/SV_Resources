    {
      "ordinal": 56,
      "label": "coach_gym_ghost_randomtalk_02",
      "hash64": "B11B6379BF8E2E7A",
      "text": "Vedi di comportarti bene con mia sorella Thyma.\\nQuando perde le staffe, fa più paura di me![VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
