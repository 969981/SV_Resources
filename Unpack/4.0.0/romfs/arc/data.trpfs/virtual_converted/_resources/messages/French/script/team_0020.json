    },
    {
      "ordinal": 1,
      "label": "team_0020_cassiopeia_01",
      "hash64": "062AF7805A8DE40F",
      "text": "... C’est Cassiopée.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
