    },
    {
      "ordinal": 1,
      "label": "champ_0010_rival_00",
      "hash64": "5D8DCE1984371A00",
      "text": "放～心地交给我吧！\\n我反而还很期待呢！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
