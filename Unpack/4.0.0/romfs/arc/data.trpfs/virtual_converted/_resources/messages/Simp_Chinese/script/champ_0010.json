        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0010_select_03",
      "hash64": "3009FF203298CE9F",
      "text": "刚才那个人是？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "champ_0010_select_04",
      "hash64": "3009FC203298C986",
      "text": "看起来是个很厉害的人……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "champ_0010_rival_16a",
      "hash64": "382BDB5BAEEAB34A",
      "text": "[VAR 0x0100(0000)]你也对她很好奇是吧？\\n大家都称她为首席。\\c\\n她又强、又厉害、又帅气，\\n是我的目标……\\c\\n不，只要是宝可梦训练家，\\n没人不崇拜她～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
