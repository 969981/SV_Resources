    },
    {
      "ordinal": 53,
      "label": "ajito_aku_040_nelke_13",
      "hash64": "1422D9B4A3D3F914",
      "text": "Und wo ist denn dieser Big Boss gerade?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
