          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_aku_040_akuboss_11",
      "hash64": "B7BD002A84205751",
      "text": "*seufz* So endet unsere Party, was...?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
