      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "ajito_aku_040_akuboss_15",
      "hash64": "B7BD042A84205E1D",
      "text": "Wirklich? Hmmm...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
