    {
      "ordinal": 44,
      "label": "ajito_aku_040_nelke_08",
      "hash64": "141F4EB4A3D0D70C",
      "text": "Danke, yo! Voll, äh, swag von dir!\\c\\n*räusper* Dann komme ich gleich zur Sache.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
