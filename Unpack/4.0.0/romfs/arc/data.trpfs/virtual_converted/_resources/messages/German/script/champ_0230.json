        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0230_steel_04",
      "hash64": "B87B01FC22063F59",
      "text": "Kommt raus, meine Lieben![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
