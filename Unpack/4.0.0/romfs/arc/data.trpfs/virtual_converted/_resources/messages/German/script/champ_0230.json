      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0230_ground_03",
      "hash64": "82F885171B541E6A",
      "text": "Die Hälfte der Top Vier haste bereits besiegt,\\naber lass jetzt bloß nicht nach![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
