    },
    {
      "ordinal": 11,
      "label": "champ_0230_fly_01",
      "hash64": "5F43BC022090A288",
      "text": "Hallo. Ich bin’s, Aoki.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
