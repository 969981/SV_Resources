          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0230_steel_07",
      "hash64": "B87AFEFC22063A40",
      "text": "Aokiiii, du bist dran![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
