          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0230_steel_05",
      "hash64": "B87B00FC22063DA6",
      "text": "Buhuhuhuuu! Dabei wollte ich mich doch an dir\\nrächen, Cay![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0230_ground_01",
      "hash64": "82F883171B541B04",
      "text": "Ähm... Ich hoffe doch mal stark, du wolltest dich\\nnicht „an mir rächen“, sondern „mich rächen“...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0230_ground_02",
      "hash64": "82F886171B54201D",
      "text": "Na ja, Schwamm drüber, Poppy.\\c\\nDa du verloren hast, sollten wir jetzt so langsam\\nmal den Dritten im Bunde rufen, oder?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0230_steel_06",
      "hash64": "B87AFFFC22063BF3",
      "text": "Oh, stimmt ja! *schnief*\\nIch musste ihn schon lange nicht mehr rufen![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
