    {
      "ordinal": 3,
      "label": "champ_0230_steel_02",
      "hash64": "B87B03FC220642BF",
      "text": "Meine Pokémon sind nämlich alle hart wie Stahl![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
