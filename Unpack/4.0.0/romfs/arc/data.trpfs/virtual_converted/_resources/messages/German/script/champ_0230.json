      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0230_steel_03",
      "hash64": "B87B02FC2206410C",
      "text": "Deine schwachen Attacken machen ihnen gar\\nnix aus, du wirst schon sehen![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
