    },
    {
      "ordinal": 14,
      "label": "gym_normal_040_normal_07",
      "hash64": "E4ECACAC02E1A0B3",
      "text": "Hai proprio una competenza notevole.\\nSono sopraffatto dallo stupore.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
