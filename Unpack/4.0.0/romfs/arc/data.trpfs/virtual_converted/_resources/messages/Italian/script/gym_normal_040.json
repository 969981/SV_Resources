    },
    {
      "ordinal": 4,
      "label": "gym_normal_040_receptionist_01",
      "hash64": "0EB8263E4E4027DD",
      "text": "Vuoi sfidare il Capopalestra Ubaldo,\\nl’impiegato stra-ordinario?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_normal_040_receptionist_02",
      "hash64": "0EB8233E4E4022C4",
      "text": "In tal caso, entra pure nell’arena.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_normal_040_receptionist_03",
      "hash64": "0EB8243E4E402477",
      "text": "Va bene, fammi sapere quando sei pront[VAR 0x1100(00FF,0101)]oa.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 3,
