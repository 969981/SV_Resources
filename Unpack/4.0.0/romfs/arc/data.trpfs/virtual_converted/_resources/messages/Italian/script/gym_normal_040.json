        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_normal_040_receptionist_05",
      "hash64": "0EB8223E4E402111",
      "text": "Signor Ubaldooo! Tocca a lei!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_normal_040_normal_01",
      "hash64": "E4ECB2AC02E1AAE5",
      "text": "Salve.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
