      "ordinal": 19,
      "label": "s2_side01_0080_brother_04",
      "hash64": "91D43FA7ABA8E220",
      "text": "¿A lo mejor ha ido al bazar a comprar algo más?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
