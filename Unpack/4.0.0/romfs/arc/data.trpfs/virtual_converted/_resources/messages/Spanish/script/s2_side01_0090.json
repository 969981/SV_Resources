      "ordinal": 21,
      "label": "s2_side01_0080_brother_06",
      "hash64": "91D441A7ABA8E586",
      "text": "Enga, [VAR 0x0100(0000)], ¡vamos a buscarla![VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
