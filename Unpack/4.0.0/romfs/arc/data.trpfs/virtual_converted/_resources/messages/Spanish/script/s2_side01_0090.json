      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0080_botan_03",
      "hash64": "726D33FC9471527D",
      "text": "Qué raro, no contesta al móvil tampoco.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
