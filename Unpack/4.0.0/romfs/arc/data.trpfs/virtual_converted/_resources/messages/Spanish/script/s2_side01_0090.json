    },
    {
      "ordinal": 11,
      "label": "s2_side01_0080_friend_05",
      "hash64": "E9A59AD99AFB2ACB",
      "text": "¿Ya la estás llamando? ¡Qué rapidez![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
