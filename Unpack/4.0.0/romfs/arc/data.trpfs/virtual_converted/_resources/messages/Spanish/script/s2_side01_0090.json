    {
      "ordinal": 8,
      "label": "s2_side01_0080_friend_03",
      "hash64": "E9A5A0D99AFB34FD",
      "text": "No será que...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
