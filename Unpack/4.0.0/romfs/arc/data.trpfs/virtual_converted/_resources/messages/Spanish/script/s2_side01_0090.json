    {
      "ordinal": 9,
      "label": "s2_side01_0080_friend_04",
      "hash64": "E9A599D99AFB2918",
      "text": "¡Se ha escondido y nos quiere dar un susto![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
