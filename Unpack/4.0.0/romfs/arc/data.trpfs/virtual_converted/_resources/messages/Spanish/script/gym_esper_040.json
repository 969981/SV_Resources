            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_esper_040_esper_06b",
      "hash64": "9B02AAAACD784500",
      "text": "[EMPTY 30]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
