          "kind": "control",
          "offset_units": 36,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
