      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_home_a_select_02",
      "hash64": "ED40C0D0719274FD",
      "text": "¿Tanto hablan?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_home_a_04",
      "hash64": "747FBA5472A90186",
      "text": "He oído de todo. Que si eres un portento en\\ncombate, que si tienes un equipo formidable...\\c\\nEres la comidilla de la academia, chic[VAR 0x1100(00FF,0101)]oa.[VAR 0x0114(0029)]",
      "flags": 0,
