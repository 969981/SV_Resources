      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_home_a_05",
      "hash64": "747FBB5472A90339",
      "text": "Entiendo que pueda suponerte un engorro,\\npero sí, estás en boca de todos.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
