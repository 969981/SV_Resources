      "label": "kizuna_head_d_select_02",
      "hash64": "CF8A462FB375DA03",
      "text": "Siamo già amic[VAR 0x1100(00FF,0201)]ihe per la pelle!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
