      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_head_d_03",
      "hash64": "44C3241A7E779115",
      "text": "E so per certo che Penny stessa le è\\nestremamente riconoscente.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_head_d_04",
      "hash64": "44C31D1A7E778530",
      "text": "Sono conscio di non essere nella posizione\\ndi poter avanzare ulteriori richieste...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_head_d_05",
      "hash64": "44C31E1A7E7786E3",
      "text": "Ma sarei oltremodo felice se potesse continuare\\na offrire la sua amicizia alla signorina Penny.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_head_d_select_01",
      "hash64": "CF8A472FB375DBB6",
      "text": "Certamente!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
