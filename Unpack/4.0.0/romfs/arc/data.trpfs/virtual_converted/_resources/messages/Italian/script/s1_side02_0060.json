    {
      "ordinal": 1,
      "label": "s1_side02_0060_camera_01",
      "hash64": "443526A6423B3A9A",
      "text": "Ti stavo aspettando, assistente![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
