          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_side02_0060_camera_17",
      "hash64": "4431A0A642382111",
      "text": "Con tutto quello che hai fatto per me, ti sei\\nmeritat[VAR 0x1100(00FF,0101)]oa una ricompensa speciale![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
