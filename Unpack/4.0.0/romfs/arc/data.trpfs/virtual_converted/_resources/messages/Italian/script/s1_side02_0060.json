      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_0060_camera_13",
      "hash64": "4431A4A6423827DD",
      "text": "Comunque, lascia che mi presenti di nuovo:\\nio sono Litha...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_side02_0060_camera_14",
      "hash64": "44319DA642381BF8",
      "text": "... una fotografa con un’enorme passione per\\nla fotografia![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
