      "label": "sdc01_0220_gfather_01",
      "hash64": "E4E928D4E46D5F5D",
      "text": "早啊，[VAR 0x0100(0000)]。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
