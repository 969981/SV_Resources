          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0220_brother_01",
      "hash64": "B91453C0B7BAD36A",
      "text": "[VAR 0x0100(0000)]！早上好～[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0220_sister_01",
      "hash64": "3BFDE75713F5A850",
      "text": "啧，他竟然起来了。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0220_brother_02",
      "hash64": "B91452C0B7BAD1B7",
      "text": "要去找最后一个介绍牌吗～？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0220_sister_02",
      "hash64": "3BFDEA5713F5AD69",
      "text": "阿栗，\\n你给我一边去！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0220_sister_04",
      "hash64": "3BFDEC5713F5B0CF",
      "text": "[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]他她\\n是来找我的！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0220_brother_03",
      "hash64": "B91451C0B7BAD004",
      "text": "什么嘛……你好贪。\\n都让姐姐你一个人占了。\\r\\n……笨蛋。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0220_sister_05",
      "hash64": "3BFDEB5713F5AF1C",
      "text": "你说什么～！？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0220_brother_04",
      "hash64": "B91450C0B7BACE51",
      "text": "哼！[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0220_sister_06",
      "hash64": "3BFDEE5713F5B435",
      "text": "怎么回事啊！\\n小小阿栗竟敢和我顶嘴。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0220_gfather_02",
      "hash64": "E4E925D4E46D5A44",
      "text": "行了，丹瑜，\\n对乌栗好一点。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0220_sister_07",
      "hash64": "3BFDED5713F5B282",
      "text": "够好了吧？\\n我都还没动手呢。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0220_gfather_03",
      "hash64": "E4E926D4E46D5BF7",
      "text": "…………[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0220_sister_08",
      "hash64": "3BFDF05713F5B79B",
      "text": "比起这种事，[VAR 0x0100(0000)]！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0220_sister_09",
      "hash64": "3BFDEF5713F5B5E8",
      "text": "那个！\\n快给我爷爷看一下那个！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0220_gfather_04",
      "hash64": "E4E923D4E46D56DE",
      "text": "唔，这是……？[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0220_sister_10",
      "hash64": "3BFA825713F2C6DA",
      "text": "你在搞啥？不对！\\n我是说昨天捡到的那个啊！那！个！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0220_gfather_05",
      "hash64": "E4E924D4E46D5891",
      "text": "这、这难道是……[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0220_gfather_06",
      "hash64": "E4E921D4E46D5378",
      "text": "鬼的面具！？\\n这是从哪里捡到的！？[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0220_sister_11",
      "hash64": "3BFA835713F2C88D",
      "text": "我们遇到了鬼！\\n就在昨天参加掩面祭的时候！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0220_sister_12",
      "hash64": "3BFA805713F2C374",
      "text": "我很温柔地跟它搭话，\\n但是它掉下了这个面具……没错吧？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0220_gfather_07",
      "hash64": "E4E922D4E46D552B",
      "text": "没想到现在\\n也会有鬼驾临庆典……[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0220_sister_13",
      "hash64": "3BFA815713F2C527",
      "text": "什么？有这种说法吗？\\n鬼不是会袭击村子的坏蛋吗？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0220_gfather_08",
      "hash64": "E4E91FD4E46D5012",
      "text": "……丹瑜，\\n看来也是时候告诉你了。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0220_gfather_09",
      "hash64": "E4E920D4E46D51C5",
      "text": "真正的历史……是相反的。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0220_sister_14",
      "hash64": "3BFA7E5713F2C00E",
      "text": "相反……？什么意思！？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0220_gfather_10",
      "hash64": "E4EC8DD4E47040D3",
      "text": "既然[VAR 0x0100(0000)]你也遇见了鬼……\\n不，应该尊称它为[VAR 0xFF00(0006)]厄诡椪[VAR 0xFF00(0000)]，\\r\\n那就一起讲给你听吧。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0220_gfather_11",
      "hash64": "E4EC8CD4E4703F20",
      "text": "让我来告诉你们，\\n我们家族代代相传的真正历史……[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0220_sister_15",
      "hash64": "3BFA7F5713F2C1C1",
      "text": "厄诡椪！？\\n历史相反是什么意思！？\\r\\n快听听是怎么回事吧！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    }
  ]
}
