  "entries": [
    {
      "ordinal": 0,
      "label": "t03_01",
      "hash64": "E3798BA06D461908",
      "text": "Non dimenticare mai di rimettere in sesto la tua\\nsquadra! E quando vedi un negozio, approfittane\\r\\nper fare acquisti!\\c\\nQuesto è il segreto per un’avventura perfetta!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "t03_03",
      "hash64": "E3798DA06D461C6E",
      "text": "Usiamo questo veicolo per trasportare le olive.\\nNel periodo della raccolta c’è un gran daffare!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "t03_14",
      "hash64": "E37602A06D42FA66",
      "text": "I dolci che vendono da Dolce Sapindo sono\\ndeliziosi! Sapessi come vanno a ruba!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "t03_15",
      "hash64": "E37603A06D42FC19",
      "text": "La Capopalestra di Moldulcia è Aceria,\\nla pasticciera più agguerrita che ci sia!\\r\\nNon farti ingannare dal suo aspetto grazioso!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "t03_16",
      "hash64": "E37600A06D42F700",
      "text": "Qui a Moldulcia siamo nel bel mezzo della Festa\\ndelle olive!\\c\\nAnche l’Esame della Palestra fa parte dei\\nfesteggiamenti!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "t03_17",
      "hash64": "E37601A06D42F8B3",
      "text": "Gira, gira e... oplà!\\c\\nSai perché Tarountula si avvolge in un gomitolo\\ndi filo? Per proteggersi dai nemici!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "t03_23",
      "hash64": "E372FDA06D40BC10",
      "text": "Moldulcia... Non trovi che questo nome abbia\\nun suono dolce? Proprio come il sapore delle\\r\\nsue olive!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "t03_28",
      "hash64": "E37308A06D40CEC1",
      "text": "Ho sentito dire che i Vivillon cambiano aspetto\\na seconda del luogo di origine.\\c\\nChissà da dove vengono questi qui?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "t03_39",
      "hash64": "E36F83A06D3DB6EB",
      "text": "Da questo locale si possono godere le sfide\\ndell’arena mentre si sorseggia un tè.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
