          "args_hex": [
            "0003"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sub_011_takara_cook_09",
      "hash64": "237878EE06E9DEDA",
      "text": "인생을 바꿀 요리를\\n만들어 줄 테니 기대하렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "sub_011_takara_cook_10",
      "hash64": "2374EBEE06E6B96C",
      "text": "[VAR 0x0102(0002)]의 테라스탈타입은\\n이미 [VAR 0x0103(0003)]타입이야!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
