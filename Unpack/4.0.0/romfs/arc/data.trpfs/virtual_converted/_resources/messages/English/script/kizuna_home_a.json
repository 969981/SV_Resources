      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_home_a_06",
      "hash64": "747FB85472A8FE20",
      "text": "The home economics classroom is something of a\\nplace of rest for the academy’s students, you see.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
