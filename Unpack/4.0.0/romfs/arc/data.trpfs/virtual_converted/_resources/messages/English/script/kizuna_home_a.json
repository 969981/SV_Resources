        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_home_a_07",
      "hash64": "747FB95472A8FFD3",
      "text": "Here, they delight in sharing the latest gossip and\\nthe like while enjoying a light snack.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
