      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_home_a_05",
      "hash64": "747FBB5472A90339",
      "text": "You are quite the object of everyone’s interest—\\nthough I imagine that may be a bother for you.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
