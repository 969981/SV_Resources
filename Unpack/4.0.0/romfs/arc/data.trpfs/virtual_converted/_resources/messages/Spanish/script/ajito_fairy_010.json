    {
      "ordinal": 19,
      "label": "ajito_fairy_010_jentle_12",
      "hash64": "F2237D00C8F8AD0D",
      "text": "No hay prisa. Si necesitas preparar a tu equipo,\\nesperaré.[VAR 0x0114(003C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
