    },
    {
      "ordinal": 25,
      "label": "ajito_fairy_010_sitappa_06",
      "hash64": "C28B9B2AC279E7B0",
      "text": "Ese hombre tan... caballeroso es el exdirector de\\nla academia. Bueno, o eso creo, vamos.\\c\\nY ahora es el... ¿profe del jefe? Como que le da\\nclases particulares y tal... o algo así he oído.\\c\\nA veces también viene a recogerle para las clases\\nesas... si no me equivoco.[VAR 0x0114(002F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
