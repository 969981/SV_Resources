      "ordinal": 26,
      "label": "ajito_fairy_010_sitappa_07",
      "hash64": "C28B9C2AC279E963",
      "text": "¡Bah, olvídalo! Quién me manda contarte todo\\nesto.[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
