      "hash64": "ADA754E7112C2091",
      "text": "喂～！\\n这边！这边！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
