  "entries": [
    {
      "ordinal": 0,
      "label": "coach_teacher_dragon_first_00",
      "hash64": "83057B573CDDB354",
      "text": "Greetings. I am Hassel, the art teacher at Naranja\\nAcademy—as well as a member of the Elite Four.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
