          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_teacher_dragon_first_00b",
      "hash64": "8003CB3C6CB784C2",
      "text": "Greetings. I am Hassel, the art teacher at Uva\\nAcademy—as well as a member of the Elite Four.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_dragon_first_01",
      "hash64": "83057C573CDDB507",
      "text": "It is such a pleasure to be able to meet all the\\nfine students at Blueberry Academy.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_dragon_sp01_00",
      "hash64": "7FA3DC75249E8F18",
      "text": "[VAR 0xBD06(0000)]Ah, young [VAR 0x0100(0000)]. So you are\\nthe\\r\\none\\r\\nwho\\r\\ninvited\\r\\nme here.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_dragon_sp01_01",
      "hash64": "7FA3DD75249E90CB",
      "text": "To think that in the brief time since I last saw you,\\nyou’d gain such an important role at this school...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_dragon_sp01_02",
      "hash64": "7FA3DE75249E927E",
      "text": "It-it’s so surprising! And I’m so habby for you...\\nI...I just...[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_dragon_sp01_select_01",
      "hash64": "A58E6E02325D5B52",
      "text": "Please don’t cry",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_dragon_sp01_select_02",
      "hash64": "A58E6D02325D599F",
      "text": "Uh, Mr. Hassel?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_dragon_sp01_03",
      "hash64": "7FA3DF75249E9431",
      "text": "...I’m very close to tears, but I’ll do my best to\\nhold it in for now.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_dragon_sp01_04",
      "hash64": "7FA3E075249E95E4",
      "text": "I don’t want to scare the other students here,\\nafter all![VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_dragon_sp02_00",
      "hash64": "ABAAE67B8608A4C7",
      "text": "I can’t express how pleased I am to have this\\nopportunity to teach at another school.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_dragon_sp02_01",
      "hash64": "ABAAE57B8608A314",
      "text": "Although I wonder... What does this academy\\nneed of me? Am I here in my capacity as an art\\r\\ninstructor or as a member of the Elite Four?[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_dragon_sp02_select_01",
      "hash64": "FAA7DBE6492B3173",
      "text": "An art instructor!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_dragon_sp02_select_02",
      "hash64": "FAA7DCE6492B3326",
      "text": "An Elite Four member!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_dragon_sp02_02",
      "hash64": "ABAAE87B8608A82D",
      "text": "I would hope so, but the students’ reaction to\\nmy last art lecture seemed...lukewarm.\\r\\nPerhaps it was my imagination, though.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_dragon_sp02_02b",
      "hash64": "BC1158E4C0B5FE3D",
      "text": "Ah, I should have known!\\c\\nThat would explain the lukewarm reaction I got\\nwhen I held an art lecture...[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_dragon_sp02_03",
      "hash64": "ABAAE77B8608A67A",
      "text": "You know, I have heard that Blueberry Academy\\nplaces a strong emphasis on the study and\\r\\npractice of Pokémon battles.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_dragon_sp02_04",
      "hash64": "ABAAE27B86089DFB",
      "text": "I think that for my next lecture, I will invite\\nProfessor Gible and do something a little bit\\r\\nmore hands-on. Thank you for your input![VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_dragon_sp03_00",
      "hash64": "035710832287CAF6",
      "text": "I’ve been told that the students here at Blueberry\\nAcademy voluntarily take active roles in various\\r\\ncommittees—and even help run the school![VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_dragon_sp03_01",
      "hash64": "035711832287CCA9",
      "text": "I suppose it’s fitting that a new school like this\\none would also be so boldly experimental.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_dragon_sp03_02",
      "hash64": "03570E832287C790",
      "text": "I admit, though, that I personally have my doubts\\nabout saddling students with such responsibility.\\c\\nIt seems a rather great burden to place on them\\nwhen they are still so young...[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 182,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_dragon_sp03_select_01",
      "hash64": "8AFE44BFB460A738",
      "text": "How’s that?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_dragon_sp03_select_02",
      "hash64": "8AFE47BFB460AC51",
      "text": "Go on...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_dragon_sp03_03",
      "hash64": "03570F832287C943",
      "text": "Well, youth is the only period of life in which one\\nmay indulge in play without a care in the world.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_dragon_sp03_04",
      "hash64": "035714832287D1C2",
      "text": "In that sense, I worry about you too, you know.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_dragon_trade_01_00",
      "hash64": "FBEC39A0F7DADC90",
      "text": "Please do take care not to overburden yourself\\nwith the expectations of others.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_dragon_trade_01_01",
      "hash64": "FBEC3AA0F7DADE43",
      "text": "Ah, but I do apologize... As I get older, I seem\\nmore prone to offering unsolicited advice.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_dragon_trade_01_02",
      "hash64": "FBEC3BA0F7DADFF6",
      "text": "Now, how about we make things more cheerful—\\nwith a Pokémon trade, perhaps?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_dragon_trade_01_03",
      "hash64": "FBEC3CA0F7DAE1A9",
      "text": "Thank you kindly for humoring me. Now, I would\\nlike to offer up a fine specimen of an Arctibax.\\r\\nHow about you, [VAR 0x0100(0000)]?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_dragon_trade_01_04",
      "hash64": "FBEC3DA0F7DAE35C",
      "text": "[VAR 0xBD06(0000)][VAR 0x0101(0001)] is a fitting Pokémon indeed.\\nI\\r\\nwould\\r\\nexpect\\r\\nno less from you.\\c\\nI will be sure to take very good care of it.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
