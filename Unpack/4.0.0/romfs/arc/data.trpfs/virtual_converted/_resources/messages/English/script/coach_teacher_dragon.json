    },
    {
      "ordinal": 30,
      "label": "coach_teacher_dragon_trade_02_00",
      "hash64": "D320C3AC42B4583F",
      "text": "[VAR 0xBD06(0000)]You’re willing to trade your [VAR 0x0101(0001)] for\\nmy\\r\\nArctibax,\\r\\nthen?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
