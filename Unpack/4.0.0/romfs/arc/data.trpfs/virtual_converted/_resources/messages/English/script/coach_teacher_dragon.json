            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_dragon_trade_02_01",
      "hash64": "D320C2AC42B4568C",
      "text": "You can’t trade Mr. Hassel a Pokémon if you\\naren’t its original Trainer!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
