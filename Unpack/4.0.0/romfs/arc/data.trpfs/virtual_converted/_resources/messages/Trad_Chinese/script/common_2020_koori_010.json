            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_2020_koori_010_select_01",
      "hash64": "45344D99369360EF",
      "text": "我是來對戰的",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_2020_koori_010_select_02",
      "hash64": "45344E99369362A2",
      "text": "我是來見你的",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_koori_010_koori_03a",
      "hash64": "C31E50DD278BC3A8",
      "text": "嗚，可以不要嗎……\\n我接下來有重要的約定呢。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2020_koori_010_koori_03b",
      "hash64": "C31E53DD278BC8C1",
      "text": "嗯……我完全不懂[VAR 0x1100(00FF,0101)]你妳的意思。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2020_koori_010_koori_04",
      "hash64": "39421C6C3477CB8C",
      "text": "……原來如此。\\n[VAR 0x1100(00FF,0101)]你妳是代替也慈來的啊。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2020_koori_010_koori_05",
      "hash64": "39421D6C3477CD3F",
      "text": "看來[VAR 0x1100(00FF,0101)]你妳晉升到冠軍級，實現夢想了。\\n挺不錯的嘛。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2020_koori_010_koori_06",
      "hash64": "39421E6C3477CEF2",
      "text": "……唉，抱歉。\\n這話聽起來像是話中有刺。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2020_koori_010_koori_07",
      "hash64": "39421F6C3477D0A5",
      "text": "我真的覺得那是件很厲害的事。\\n不過就我而言……有點複雜。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_2020_koori_010_koori_08",
      "hash64": "3942206C3477D258",
      "text": "[VAR 0x1100(00FF,0101)]你妳是來視察實力的吧？\\n我們速戰速決吧。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
