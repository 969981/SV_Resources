      ]
    },
    {
      "ordinal": 1,
      "label": "common_2020_koori_010_koori_02",
      "hash64": "39421A6C3477C826",
      "text": "來滑雪山的？\\n今天的雪質有那麼好嗎……？[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
