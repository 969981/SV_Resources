          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2020_koori_010_koori_retry",
      "hash64": "744796C717C11F82",
      "text": "[VAR 0x1100(00FF,0101)]你妳拿出幹勁了嗎？\\n那麼就趕緊結束這件事吧。[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
