      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_math_sp01_00",
      "hash64": "4FFAB60DD7961919",
      "text": "哎呀，[VAR 0x0100(0000)]。\\n[VAR 0x1100(00FF,0101)]你妳的消息我時有耳聞喔。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
