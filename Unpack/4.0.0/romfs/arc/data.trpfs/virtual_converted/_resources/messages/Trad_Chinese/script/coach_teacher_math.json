          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_math_sp01_02",
      "hash64": "4FFAB40DD79615B3",
      "text": "[VAR 0x1100(00FF,0101)]你妳真是不折不扣地優秀。\\n老師我以[VAR 0x1100(00FF,0101)]你妳為榮。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
