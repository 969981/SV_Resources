    },
    {
      "ordinal": 61,
      "label": "coach_teacher_math_randomtalk_01",
      "hash64": "9D1D3AB110CD73D5",
      "text": "藍莓學園有一種叫做\\nＢＰ的貨幣，對吧？\\r\\n似乎可以用來出數學題目呢。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
