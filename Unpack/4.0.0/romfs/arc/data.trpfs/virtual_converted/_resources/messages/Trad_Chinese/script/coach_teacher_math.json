    },
    {
      "ordinal": 62,
      "label": "coach_teacher_math_randomtalk_02",
      "hash64": "9D1D37B110CD6EBC",
      "text": "剛剛有人把我誤認成我妹妹，\\n要求我幫他簽名。\\c\\n我覺得我和萊姆\\n長得一點都不像啊……[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
