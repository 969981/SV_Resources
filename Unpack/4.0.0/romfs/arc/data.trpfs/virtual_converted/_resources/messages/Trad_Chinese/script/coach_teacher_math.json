    },
    {
      "ordinal": 1,
      "label": "coach_teacher_math_first_01",
      "hash64": "7FD969B20A9E0FB4",
      "text": "我是泰姆老師。\\n讓我們快快樂樂學數學吧。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
