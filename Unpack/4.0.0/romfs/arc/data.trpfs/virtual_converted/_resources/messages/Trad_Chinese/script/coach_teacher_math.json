    },
    {
      "ordinal": 60,
      "label": "coach_teacher_math_randomtalk_00",
      "hash64": "9D1D39B110CD7222",
      "text": "如果我在藍莓學園\\n教授岩石屬性的厲害之處，\\r\\n將來使用岩石屬性的訓練家會變多嗎？[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
