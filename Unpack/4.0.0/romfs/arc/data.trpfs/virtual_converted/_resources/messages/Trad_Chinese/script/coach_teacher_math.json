          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_math_sp01_select_01",
      "hash64": "0560A4FB7B835A05",
      "text": "泰姆老師！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_math_sp01_select_02",
      "hash64": "0560A1FB7B8354EC",
      "text": "我會照三餐呼叫的！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_math_sp01_04",
      "hash64": "4FFABA0DD7961FE5",
      "text": "哎呀？現在就要叫我了嗎？\\n呵呵呵，[VAR 0x1100(00FF,0101)]你妳真是個有趣的孩子。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_math_sp01_04b",
      "hash64": "7D29AC8554179265",
      "text": "哎呀，好猛烈的攻勢。\\n泰姆老師我的心都怦咚怦咚跳了。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_math_sp01_05",
      "hash64": "4FFAB90DD7961E32",
      "text": "我知道[VAR 0x1100(00FF,0101)]你妳又是社團活動又是冒險的，\\n是個大忙人，但偶爾也別忘了學數學喔。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_math_sp02_00",
      "hash64": "A92F74271EE73C26",
      "text": "我就開門見山地給[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳\\n出個複習題吧？[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_math_sp02_01",
      "hash64": "A92F75271EE73DD9",
      "text": "一般來說，寶可夢的招式\\n擊中要害的機率是多少？[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
