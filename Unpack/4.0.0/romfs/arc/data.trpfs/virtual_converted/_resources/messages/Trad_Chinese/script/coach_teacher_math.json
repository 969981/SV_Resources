          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_math_sp01_01",
      "hash64": "4FFAB50DD7961766",
      "text": "聽說[VAR 0x1100(00FF,0101)]你妳在學園以冠軍的身分，\\n在各方面都很努力呢。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
