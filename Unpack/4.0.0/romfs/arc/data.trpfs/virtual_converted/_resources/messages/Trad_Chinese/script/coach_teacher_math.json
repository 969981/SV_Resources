          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_math_sp01_03",
      "hash64": "4FFAB30DD7961400",
      "text": "泰姆老師我隨時都歡迎\\n[VAR 0x1100(00FF,0101)]你妳呼叫我來這裡喔。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
