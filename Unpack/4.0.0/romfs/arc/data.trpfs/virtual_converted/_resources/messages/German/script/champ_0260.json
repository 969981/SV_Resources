    {
      "ordinal": 25,
      "label": "champ_0260_chairman_18",
      "hash64": "E85BC7BB96233737",
      "text": "Komm, ich begleite dich noch zum Ausgang.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
