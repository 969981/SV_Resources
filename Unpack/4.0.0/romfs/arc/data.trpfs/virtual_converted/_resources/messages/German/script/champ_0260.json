  "entries": [
    {
      "ordinal": 0,
      "label": "champ_0260_stopper_01",
      "hash64": "CDAA7F23946301ED",
      "text": "Du kannst nicht mehr umkehren.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "champ_0260_system_01",
      "hash64": "9E275C92DC34CA97",
      "text": "Möchtest du die letzte Herausforderung dieser\\nChamp-Prüfung in Angriff nehmen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "champ_0260_chairman_01",
      "hash64": "E8583ABB962011C9",
      "text": "Willkommen, [VAR 0x0100(0000)]![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0260_chairman_02",
      "hash64": "E85837BB96200CB0",
      "text": "Es ist mir eine Freude, dich hier an der Spitze der\\nPokémon-Liga zu treffen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0260_chairman_03",
      "hash64": "E85838BB96200E63",
      "text": "Bei der letzten Prüfung handelt es sich um\\neinen Kampf gegen mich, den Top-Champ.\\c\\nBesiegst du mich, hast du bestanden.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0260_chairman_04",
      "hash64": "E8583DBB962016E2",
      "text": "Doch ehe wir mit dem Kampf beginnen,\\nmöchte ich mich bei dir entschuldigen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0260_chairman_05",
      "hash64": "E8583EBB96201895",
      "text": "Als Liga-Präsidentin habe ich nämlich eine sehr\\nunangemessene Eigenart...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0260_chairman_06",
      "hash64": "E8583BBB9620137C",
      "text": "Wenn es um Pokémon-Kämpfe geht, bin ich nicht\\neinmal zu den kleinsten Zugeständnissen bereit.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0260_chairman_07",
      "hash64": "E8583CBB9620152F",
      "text": "Das könnte auch der Grund dafür sein, weshalb in\\nletzter Zeit niemand die Prüfung bestanden hat...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0260_chairman_08",
      "hash64": "E85841BB96201DAE",
      "text": "Aber wer weiß, vielleicht bist du ja imstande,\\neine ähnlich grandiose Leistung hinzulegen wie\\r\\nChamp Nemila damals.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0260_chairman_09",
      "hash64": "E85842BB96201F61",
      "text": "Doch nun genug der Worte. Bist du bereit?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0260_chairman_10",
      "hash64": "E85BBFBB9623299F",
      "text": "Dann bin ich einmal so frei und prüfe dein Talent\\nauf Herz und Nieren![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0260_chairman_11",
      "hash64": "E85BBEBB962327EC",
      "text": "Welch beeindruckende Abfolge von Attacken,\\nwelch atemberaubende Kraft...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0260_chairman_12",
      "hash64": "E85BC1BB96232D05",
      "text": "Wer hätte gedacht, dass Paldea abermals [VAR 0x1100(00FF,0405,0000)]eineneine\\n[VAR 0x1100(00FF,1A19,0000)]solch großartigen Trainersolch großartige Trainerin hervorbringen würde![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0405",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1A19",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0260_chairman_13",
      "hash64": "E85BC0BB96232B52",
      "text": "Herzlichen Glückwunsch, [VAR 0x0100(0000)]!\\nOder besser gesagt, Champ [VAR 0x0100(0000)]![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
