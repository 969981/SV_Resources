    {
      "ordinal": 19,
      "label": "champ_0260_dragon_01",
      "hash64": "070EEC45DBEA75B9",
      "text": "Das ist wirklich... *schnief*... ausgezeichnet!\\nIch habe einen Kloß im Hals vor Rührung...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
