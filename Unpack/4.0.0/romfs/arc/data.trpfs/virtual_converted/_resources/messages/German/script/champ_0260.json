      ]
    },
    {
      "ordinal": 16,
      "label": "champ_0260_steel_01a",
      "hash64": "4281B21F1F61DC74",
      "text": "Wow, wie toll! Du hast es echt geschafft![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
