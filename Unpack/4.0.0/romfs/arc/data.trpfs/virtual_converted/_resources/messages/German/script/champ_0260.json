          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "champ_0260_chairman_14",
      "hash64": "E85BBBBB962322D3",
      "text": "Ihr Pokémon-Trainer seid der Schatz der\\nPaldea-Region...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "champ_0260_chairman_15",
      "hash64": "E85BBABB96232120",
      "text": "Und Champs sind die Juwelen in diesem Schatz,\\ndie heller strahlen als alles andere![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
