    {
      "ordinal": 0,
      "label": "sdc01_0020_bbteacher_01",
      "hash64": "0821B05AC6B633BC",
      "text": "[VAR 0xBD06(0000)]¿Lo tienes todo listo para partir hacia Noroteo,\\n[VAR 0x0100(0000)]?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
