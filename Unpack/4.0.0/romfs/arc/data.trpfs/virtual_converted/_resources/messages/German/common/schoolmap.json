    {
      "ordinal": 20,
      "label": "schoolmap_2_1",
      "hash64": "60396BBCAB779DC0",
      "text": "Der Eingang der Orangen-Akademie. Am Empfang kannst\\ndu dich zu den verschiedenen Kursen anmelden.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "schoolmap_2_18",
      "hash64": "F93009975C416C68",
      "text": "Der Eingang der Trauben-Akademie. Am Empfang kannst\\ndu dich zu den verschiedenen Kursen anmelden.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "schoolmap_2_2",
      "hash64": "60396EBCAB77A2D9",
      "text": "Dein Zimmer. Es ist wie ein zweites Zuhause für dich.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "schoolmap_2_3",
      "hash64": "60396DBCAB77A126",
      "text": "Nemilas Zimmer. Es ist ordentlich und sauber.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "schoolmap_2_4",
      "hash64": "603970BCAB77A63F",
      "text": "Peppers Zimmer. Es duftet nach köstlichem Essen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "schoolmap_2_5",
      "hash64": "60396FBCAB77A48C",
      "text": "Cosimas Zimmer. Es ist etwas düster und voller\\nelektronischer Geräte.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "schoolmap_2_6",
      "hash64": "603972BCAB77A9A5",
      "text": "Das Klassenzimmer von Nemila und dir, für Schüler des\\nuniversellen Zweiges. Klassenlehrer: Señor Jim.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "schoolmap_2_7",
      "hash64": "603971BCAB77A7F2",
      "text": "Das Klassenzimmer für Schüler im zweiten Jahr des geistes-\\nwissenschaftlichen Zweiges. Klassenlehrer: Señor Salvatore.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "schoolmap_2_19",
      "hash64": "F9300A975C416E1B",
      "text": "Peppers Klassenzimmer, für Schüler des geisteswissen-\\nschaftlichen Zweiges. Klassenlehrer: Señor Salvatore.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "schoolmap_2_8",
      "hash64": "603974BCAB77AD0B",
      "text": "Das Klassenzimmer für Schüler des naturwissenschaftlichen\\nZweiges. Klassenlehrerin: Señora Quendella.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "schoolmap_2_20",
      "hash64": "F93A13975C49D1EB",
      "text": "Cosimas Klassenzimmer, für Schüler des naturwissenschaft-\\nlichen Zweiges. Klassenlehrerin: Señora Quendella.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "schoolmap_2_9",
      "hash64": "603973BCAB77AB58",
      "text": "Das Büro des Direktors. Hier befinden sich der Schreibtisch\\nund die Forschungsgeräte von Direktor Clavel.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "schoolmap_2_10",
      "hash64": "F93001975C415ED0",
      "text": "Das Lehrerzimmer. Hier kannst du verschiedene Lehrer\\nantreffen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "schoolmap_2_11",
      "hash64": "F93002975C416083",
      "text": "Schüler, die sich unwohl fühlen, können sich hier ausruhen.\\nViele kommen aber nur, um Señora Mimi zu besuchen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "schoolmap_2_12",
      "hash64": "F93003975C416236",
      "text": "Hier gibt es Waren für den täglichen Bedarf, Items und\\nmehr. Irgendwie ist das Brot stets frisch gebacken.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "schoolmap_2_13",
      "hash64": "F93004975C4163E9",
      "text": "Hier findet der Hauswirtschaftskurs statt. Ein Raum voller\\nKochutensilien und blitzblankem Geschirr.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "schoolmap_2_14",
      "hash64": "F93005975C41659C",
      "text": "Ein Raum, der mit Mikroskopen und zahlreichen anderen\\nGeräten für Experimente im Biologiekurs ausgestattet ist.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "schoolmap_2_15",
      "hash64": "F93006975C41674F",
      "text": "Der Raum für den Kunstkurs, in dem von Schülern\\ngeschaffene Kunstwerke ausgestellt werden.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "schoolmap_2_16",
      "hash64": "F93007975C416902",
      "text": "Die nette Dame, die in der Mensa arbeitet, kocht jeden\\nTag leckere, nahrhafte Gerichte.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "schoolmap_2_17",
      "hash64": "F93008975C416AB5",
      "text": "Hier findet der Kampfkurs statt. Dieser Innenhof eignet\\nsich sowohl für Sport als auch ein Päuschen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "schoolmap_3_0",
      "hash64": "6788A3BCAF39BEE8",
      "text": "Zurück",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
