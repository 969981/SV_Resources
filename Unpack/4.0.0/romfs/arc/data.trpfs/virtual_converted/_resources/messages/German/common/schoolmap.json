      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "schoolmap_5_0",
      "hash64": "565E55BCA58C311E",
      "text": "Der Eingangsbereich der Blaubeer-Akademie.\\nIn seiner Mitte befindet sich ein Kampfplatz.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "schoolmap_5_1",
      "hash64": "565E56BCA58C32D1",
      "text": "Ein Naturpark unter Wasser, in dessen vier Arealen man\\nauf Entdeckung gehen und Pokémon studieren kann.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "schoolmap_5_2",
      "hash64": "565E53BCA58C2DB8",
      "text": "Jos Klassenzimmer. Hier versammeln sich außerdem\\ndie Schüler nach dem Unterricht.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 54,
      "label": "schoolmap_5_3",
      "hash64": "565E54BCA58C2F6B",
      "text": "Hanas Klassenzimmer. Ms Brianna ist hier die zuständige\\nKlassenlehrerin.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "schoolmap_5_4",
      "hash64": "565E59BCA58C37EA",
      "text": "Hier kann man im Tausch gegen BP nützliche Items und\\npraktische Alltagsgegenstände erwerben.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 56,
      "label": "schoolmap_5_5",
      "hash64": "565E5ABCA58C399D",
      "text": "Die selbstgekochten Mahlzeiten der Köchin sind\\nreichhaltig und in jedem Fall magenfüllend.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 57,
      "label": "schoolmap_5_6",
      "hash64": "565E57BCA58C3484",
      "text": "Dieses Zimmer ist dein eigenes kleines Reich fernab der\\nHeimat.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 58,
      "label": "schoolmap_5_7",
      "hash64": "565E58BCA58C3637",
      "text": "Hanas Zimmer. Es ist mit vielen kleinen Gegenständen\\ndekoriert, die ihren Geschmack widerspiegeln.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 59,
      "label": "schoolmap_5_8",
      "hash64": "565E4DBCA58C2386",
      "text": "Jos Zimmer. Man findet hier viele Beweise für seine harte\\nArbeit und Beharrlichkeit.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 60,
