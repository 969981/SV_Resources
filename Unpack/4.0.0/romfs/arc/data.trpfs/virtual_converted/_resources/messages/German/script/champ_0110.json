      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0110_rival_06",
      "hash64": "ABD98C4A134AB33B",
      "text": "Oh, sorry! Ich war schon so bereit für den Kampf,\\ndass ich gar nicht daran gedacht hab...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0110_rival_07",
      "hash64": "ABD98B4A134AB188",
      "text": "Aber Dank des Top-Champs [VAR 0x1101(00FD,0A08)]ist deinsind deine Pokémon\\njetzt wieder topfit![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0A08"
          ]
        },
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0110_rival_08",
      "hash64": "ABD98A4A134AAFD5",
      "text": "So, versetz dich noch mal in die Situation von\\neben zurück, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0110_rival_09",
      "hash64": "ABD9894A134AAE22",
      "text": "Und los geht’s! Der Kampf ist das Ziel![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "champ_0110_chairman_06",
      "hash64": "8710306AB703E41E",
      "text": "Gegen jemanden wie Champ Nemila einen solch\\nbeachtlichen Kampf hinzulegen, zeugt von Talent.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "champ_0110_chairman_07",
      "hash64": "8710316AB703E5D1",
      "text": "Es war mir eine Freude, solch einem herrlichen\\nKampf beiwohnen zu dürfen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "champ_0110_rival_10",
      "hash64": "ABD60C4A1347A3E4",
      "text": "Wie krass! Sogar der Top-Champ erkennt dein\\nPotenzial an![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "champ_0110_rival_11",
      "hash64": "ABD60D4A1347A597",
      "text": "Du hältst mich wirklich auf Trab, so schnell,\\nwie du stärker wirst![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "champ_0110_rival_12",
      "hash64": "ABD60E4A1347A74A",
      "text": "Bist du vielleicht nervös geworden, weil der\\nTop-Champ zugeschaut hat?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "champ_0110_rival_13",
      "hash64": "ABD60F4A1347A8FD",
      "text": "Mach dir nichts draus. Den Kampf magst du zwar\\nverloren haben, aber der Zusammenhalt zwischen\\r\\ndir und deine[VAR 0x1101(00FD,0101)]mn Pokémon war deutlich zu spüren.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "champ_0110_rival_14",
      "hash64": "ABD6084A13479D18",
      "text": "Weißt du... Eines war mir schon klar, als wir uns\\ndas erste Mal begegnet sind...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "champ_0110_rival_15",
      "hash64": "ABD6094A13479ECB",
      "text": "Eines Tages wirst du den Champ-Rang erreichen,\\n[VAR 0x0100(0000)]. Da bin ich mir sicher.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "champ_0110_rival_16",
      "hash64": "ABD60A4A1347A07E",
      "text": "Die übrigen Arenen wirst du ohne Probleme\\nbewältigen, du schaffst das![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "champ_0110_chairman_08",
      "hash64": "87102A6AB703D9EC",
      "text": "Das denke ich auch. Hier, das soll dir gehören.\\nBetrachte es als Investition in deine Zukunft.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "champ_0110_chairman_12",
      "hash64": "8713B66AB706FDA7",
      "text": "Wenn ein terakristallisiertes Pokémon diese\\nAttacke einsetzt, passt sich ihr Typ dem Tera-Typ\\r\\ndes Pokémon an.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "champ_0110_rival_17",
      "hash64": "ABD60B4A1347A231",
      "text": "Irgendwann werden wir zwei uns den besten\\nKampf aller Zeiten liefern, das weiß ich einfach![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "champ_0110_rival_18",
      "hash64": "ABD6044A1347964C",
      "text": "Ich werde noch viel, viiiiiel mehr trainieren,\\num richtig darauf vorbereitet zu sein![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "champ_0110_chairman_09",
      "hash64": "87102B6AB703DB9F",
      "text": "Ich frage mich, ob sie gerade aus Freundschaft\\ngesprochen hat, um dich zu unterstützen, oder\\r\\nweil sie sich Großes von dir erhofft?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "champ_0110_chairman_10",
      "hash64": "8713B86AB707010D",
      "text": "Nein... Ich glaube, das war keine bloße Hoffnung.\\nSie hat aus fester Überzeugung gesprochen.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "champ_0110_chairman_11",
      "hash64": "8713B76AB706FF5A",
      "text": "Komm, ich führe dich wieder zurück zur Arena.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    }
  ]
}
