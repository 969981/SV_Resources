  "entries": [
    {
      "ordinal": 0,
      "label": "champ_0110_rival_01",
      "hash64": "ABD9914A134ABBBA",
      "text": "Also, noch mal für dich zum Mitschreiben.\\c\\nDu klapperst die verschiedenen Arenen ab\\nund erkämpfst dir ihre Orden.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "champ_0110_rival_02",
      "hash64": "ABD9904A134ABA07",
      "text": "Wenn du das geschafft hast, kannst du gegen die\\nallerstärksten Pokémon-Trainer antreten![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0110_chairman_01",
      "hash64": "8710336AB703E937",
      "text": "So ist es. Und zwar in der Pokémon-Liga.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0110_chairman_02",
      "hash64": "8710346AB703EAEA",
      "text": "Sie befindet sich nordwestlich von Mesalona City.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0110_chairman_03",
      "hash64": "8710356AB703EC9D",
      "text": "In der Pokémon-Liga wird würdigen Trainern der\\nhöchste aller Titel verliehen: der des Champs.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0110_rival_03",
      "hash64": "ABD98F4A134AB854",
      "text": "Sobald du acht Arenaorden beisammenhast,\\nkannst du eine Prüfung ablegen, die es in sich hat.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0110_rival_04",
      "hash64": "ABD98E4A134AB6A1",
      "text": "Schaffst du es schließlich, selbst den stärksten\\nPrüfer zu besiegen, wirst du zum Champ ernannt![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0110_rival_19",
      "hash64": "ABD6054A134797FF",
      "text": "Stell dir nur mal vor, wie sich das für dich\\nanfühlen würde...\\c\\nDer Moment, in dem du zum Champ wirst![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0110_rival_05",
      "hash64": "ABD98D4A134AB4EE",
      "text": "Du hast dein Ziel, die Bühne aller Bühnen vor\\nAugen... Und jetzt beginnt der Kam--[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0110_chairman_04",
      "hash64": "87102E6AB703E0B8",
      "text": "Oh? Nicht so schnell.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0110_chairman_05",
      "hash64": "87102F6AB703E26B",
      "text": "[VAR 0xBD06(0000)]D[VAR 0x1101(00FD,0202)]asie Pokémon von [VAR 0x0100(0000)] schein[VAR 0x1101(00FD,0201)]ten\\nnoch\\r\\netwas\\r\\nerschöpft zu sein.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
