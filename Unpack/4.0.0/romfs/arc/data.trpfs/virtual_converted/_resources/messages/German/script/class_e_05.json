  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "class_e_05_battle_01",
      "hash64": "5EED0D6A18CAE4A4",
      "text": "Ein neuer Tag, ein neuer Kampf! Tach und\\nwillkommen zu meinem Kampfkurs![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_e_05_battle_02",
      "hash64": "5EED106A18CAE9BD",
      "text": "Bei der Zwischenprüfung scheint sich jeder von\\neuch gut geschlagen zu haben. Sehr schön![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_e_05_battle_03",
      "hash64": "5EED0F6A18CAE80A",
      "text": "Ab heute beginnt die zweite Hälfte des\\nSemesters. Bewahrt euch euren Kampfgeist![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_e_05_battle_04",
      "hash64": "5EED0A6A18CADF8B",
      "text": "Dann wollen wir mal! Schickt ihr alle fleißig eure\\nPokémon mit der R-Taste los?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_e_05_battle_05",
      "hash64": "5EED096A18CADDD8",
      "text": "Wenn ihr das macht, läuft euer Pokémon in die\\nRichtung, in die ihr blickt.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_e_05_battle_06",
      "hash64": "5EED0C6A18CAE2F1",
      "text": "So kann es für euch entfernte Items aufsammeln!\\nEine echt praktische Sache.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_e_05_battle_07",
      "hash64": "5EED0B6A18CAE13E",
      "text": "Und wenn sich in der Richtung ein wildes\\nPokémon herumtreibt, wird euer Pokémon sofort\\r\\nden Kampf gegen es aufnehmen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_e_05_battle_08",
      "hash64": "5EED066A18CAD8BF",
      "text": "Diese Kämpfe bezeichnet man als Auto-Kämpfe.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_e_05_battle_09",
      "hash64": "5EED056A18CAD70C",
      "text": "Hier ist der Name Programm.\\c\\nDer Trainer gibt seinem Pokémon keine Befehle,\\nsondern es kämpft automatisch.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_e_05_battle_10",
      "hash64": "5EEA086A18C8A64E",
      "text": "Ein Sieg bringt sogar dieselbe Anzahl an\\nErfahrungspunkten ein wie ein regulärer Kampf![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_e_05_battle_11",
      "hash64": "5EEA096A18C8A801",
      "text": "Setzt man diese Technik geschickt ein, kann man\\nsein Team also sehr effektiv trainieren.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_e_05_battle_12",
      "hash64": "5EEA066A18C8A2E8",
      "text": "Steigt ein Pokémon während eines Auto-Kampfes\\nim Level auf, erlernt es allerdings keine neuen\\r\\nAttacken und entwickelt sich auch nicht.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_e_05_battle_13",
      "hash64": "5EEA076A18C8A49B",
      "text": "Und sollte es den Kampf verlieren, kehrt es mit\\neiner minimalen Anzahl an KP zurück. Ihr solltet\\r\\nes dann zügig wieder aufpäppeln.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_e_05_battle_14",
      "hash64": "5EEA0C6A18C8AD1A",
      "text": "Jetzt hab ich euch mit ziemlich vielen Infos\\nberieselt... Gibt es irgendwelche Fragen?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_e_05_select_01",
      "hash64": "8C797B09D4DE44AA",
      "text": "Kann man Auto-Kämpfe unterbrechen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_e_05_select_02",
      "hash64": "8C797A09D4DE42F7",
      "text": "Kann man die Pokémon fangen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "class_e_05_select_03",
      "hash64": "8C797909D4DE4144",
      "text": "Ich habe keine Fragen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_e_05_battle_answer_01",
      "hash64": "476C1EE7B64FE445",
      "text": "Ein Auto-Kampf kann nicht unterbrochen werden.\\nSobald er einmal losgeht, müsst ihr warten, bis er\\r\\nvorbei ist!\\c\\nIhr könnt allerdings euer Pokémon zurückrufen,\\nehe der Auto-Kampf anfängt. Dafür müsst ihr\\r\\neinfach die ZR-Taste drücken![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 206,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 239,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_e_05_battle_answer_02",
      "hash64": "476C1BE7B64FDF2C",
      "text": "Wenn ihr eurem Pokémon alles überlasst,\\nwird es kämpfen, bis sein Gegner besiegt ist.\\c\\nSolltet ihr das wilde Pokémon fangen wollen,\\nmüsst ihr selbst das Ruder in die Hand nehmen![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 180,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_e_05_battle_answer_03",
      "hash64": "476C1CE7B64FE0DF",
      "text": "Mhm, mhm! Ihr seid wirklich erstklassige Schüler.\\nIch freue mich schon zu sehen, wie weit ihr es mal\\r\\nbringen werdet![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_e_05_battle_15",
      "hash64": "5EEA0D6A18C8AECD",
      "text": "Vergesst nicht, dass eure Pokémon immer alles\\nfür euch geben werden, auch in Auto-Kämpfen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_e_05_battle_16",
      "hash64": "5EEA0A6A18C8A9B4",
      "text": "Behaltet sie stets gut im Auge. Wenn ihr bemerkt,\\ndass sie verlieren, solltet ihr sie zurückrufen.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_e_05_battle_17",
      "hash64": "5EEA0B6A18C8AB67",
      "text": "Das versteht sich zwar von selbst, aber Pokémon\\nmit niedrigen KP sind sehr erschöpft.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_e_05_battle_18",
      "hash64": "5EEA006A18C898B6",
      "text": "Überlegt euch also gut, ob ihr sie in diesem\\nZustand in einen Auto-Kampf schicken wollt.\\r\\nVerlangt ihnen nicht zu viel ab![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_e_05_battle_19",
      "hash64": "5EEA016A18C89A69",
      "text": "Ich fasse noch einmal zusammen![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_e_05_battle_20",
      "hash64": "5EE6826A18C58CC5",
      "text": "Auto-Kämpfe basieren auf dem gegenseitigen\\nVertrauen zwischen Trainer und Pokémon.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_e_05_battle_21",
      "hash64": "5EE6816A18C58B12",
      "text": "Achtet daher stets auf den Zustand eurer\\nSchützlinge und setzt diese Art des Kämpfens\\r\\nklug ein![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_e_05_battle_22",
      "hash64": "5EE6806A18C5895F",
      "text": "Hmm, das wird wohl wieder nichts mit der\\npraktischen Demonstration.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_e_05_battle_23",
      "hash64": "5EE67F6A18C587AC",
      "text": "Also dann, der Unterricht ist vorbei.\\nSeht zu, dass ihr alle fit bleibt![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    }
  ]
}
