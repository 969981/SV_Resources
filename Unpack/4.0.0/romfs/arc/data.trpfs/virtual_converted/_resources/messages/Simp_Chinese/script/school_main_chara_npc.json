      ]
    },
    {
      "ordinal": 40,
      "label": "school_main_chara_artteacher_01",
      "hash64": "EC8067D7456EB55D",
      "text": "你是新来的学生吧？\\n请多指教是也。[VAR 0x0114(0012)]",
