    },
    {
      "ordinal": 38,
      "label": "school_main_chara_languageteacher_04",
      "hash64": "05A585A7D5BE1581",
      "text": "布拨它很有精神！\\n只是稍微有点安静罢了！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
