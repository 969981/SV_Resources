  "entries": [
    {
      "ordinal": 0,
      "label": "ajito_doku_010_sitappa_01",
      "hash64": "FE3FE6E5CC9BDE5B",
      "text": "Do me a favor and go home already, will ya?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "ajito_doku_010_student_01",
      "hash64": "8FC7CE649BB09D04",
      "text": "NO! I wanna see the boss of the Navi Squad!\\nTake me to Don Atticus!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "ajito_doku_010_sitappa_02",
      "hash64": "FE3FE7E5CC9BE00E",
      "text": "Like I said, kid, the boss told me not to let any\\noutsiders past these gates! That includes you![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "ajito_doku_010_student_02",
      "hash64": "8FC7D1649BB0A21D",
      "text": "I don’t care! I’m not leaving till you let me talk to\\nDon Atticus!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "ajito_doku_010_sitappa_03",
      "hash64": "FE3FE8E5CC9BE1C1",
      "text": "Gimme a break, you little doofus...[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_doku_010_system_01",
      "hash64": "C90A82F2B8B9430C",
      "text": "The people over there seem to be arguing about\\nsomething... What do you want to do?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "ajito_doku_010_select_01",
      "hash64": "D6C26E8EEA4346BF",
      "text": "Go say hello",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "ajito_doku_010_select_02",
      "hash64": "D6C26F8EEA434872",
      "text": "Get a little closer",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "ajito_doku_010_student_03",
      "hash64": "8FC7D0649BB0A06A",
      "text": "Huh?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "ajito_doku_010_sitappa_04",
      "hash64": "FE3FE9E5CC9BE374",
      "text": "Oh great. Here comes another rando to ruin\\nmy day.[VAR 0x0114(002F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_doku_010_sitappa_05",
      "hash64": "FE3FEAE5CC9BE527",
      "text": "I didn’t think grunt work for Team Star newbies\\nwould be this much of a chore...[VAR 0x0114(002F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_doku_010_student_04",
      "hash64": "8FC7CB649BB097EB",
      "text": "Hold on, Mr. Grunt! I think this [VAR 0x1100(00FF,0403)]boygirl might\\nbe [VAR 0x0100(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0403"
          ]
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_doku_010_sitappa_06",
      "hash64": "FE3FEBE5CC9BE6DA",
      "text": "[VAR 0xBD06(0000)]Wait...[VAR 0x0100(0000)]? That kid\\nwho\\r\\npicked\\r\\na\\r\\nfight\\r\\nwith\\r\\nTeam Star?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
