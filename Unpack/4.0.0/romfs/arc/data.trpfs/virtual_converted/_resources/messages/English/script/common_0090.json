    {
      "ordinal": 27,
      "label": "common_0090_rival_15",
      "hash64": "DE914374D9A2570E",
      "text": "The Pokédex will automatically register any\\nPokémon you catch.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
