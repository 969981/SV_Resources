    {
      "ordinal": 32,
      "label": "common_0090_head_teacher_08",
      "hash64": "F3A817A8F421466F",
      "text": "Yet no matter how much the times may change,\\nthe wonder of meeting new Pokémon never does.\\r\\nThat is a truly timeless pleasure.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
