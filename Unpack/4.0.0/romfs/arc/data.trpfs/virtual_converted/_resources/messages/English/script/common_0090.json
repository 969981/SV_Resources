        }
      ]
    },
    {
      "ordinal": 30,
      "label": "common_0090_rival_17",
      "hash64": "DE914174D9A253A8",
      "text": "Oof! Filling out a Pokédex by hand? I can’t even\\nimagine how much work that would take![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
