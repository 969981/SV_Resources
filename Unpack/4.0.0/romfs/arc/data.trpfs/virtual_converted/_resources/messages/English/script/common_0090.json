    {
      "ordinal": 29,
      "label": "common_0090_head_teacher_06",
      "hash64": "F3A81DA8F42150A1",
      "text": "Back in my day, we used ordinary paper and\\nhandwritten notes to compile our Pokédexes.\\r\\nIt’s quite the age we live in now.[VAR 0x0114(000A)]",
