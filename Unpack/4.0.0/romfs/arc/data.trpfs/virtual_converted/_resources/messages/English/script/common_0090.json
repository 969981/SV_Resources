    {
      "ordinal": 28,
      "label": "common_0090_rival_16",
      "hash64": "DE914274D9A2555B",
      "text": "It’s a must-have for Pokémon Trainers!\\c\\nIt’s a super handy app! Our homeroom teacher,\\nMr. Jacq, actually made it himself![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
