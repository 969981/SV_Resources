      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 51,
      "label": "schoolmap_5_0",
      "hash64": "565E55BCA58C311E",
      "text": "L’entrée de l’Institut Myrtille.\\nUn terrain de combat se trouve au centre de celle-ci.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 52,
      "label": "schoolmap_5_1",
      "hash64": "565E56BCA58C32D1",
      "text": "Un parc sous-marin divisé en quatre zones\\nqu’on peut explorer pour étudier les Pokémon.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 53,
      "label": "schoolmap_5_2",
      "hash64": "565E53BCA58C2DB8",
      "text": "C’est la salle de classe de Kassis.\\nElle sert également de salle commune.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 54,
      "label": "schoolmap_5_3",
      "hash64": "565E54BCA58C2F6B",
      "text": "C’est la salle de classe de Roseille.\\nMadame Bria est la professeure principale.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 55,
      "label": "schoolmap_5_4",
      "hash64": "565E59BCA58C37EA",
      "text": "Une boutique qui vend toutes sortes d’objets.\\nOn ne peut y payer qu’avec des PM.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 56,
      "label": "schoolmap_5_5",
      "hash64": "565E5ABCA58C399D",
      "text": "Chaque jour, les cuisinières de la cafétéria préparent\\ndes repas copieux et bien nourrissants.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 57,
      "label": "schoolmap_5_6",
      "hash64": "565E57BCA58C3484",
      "text": "C’est votre chambre à l’institut.\\nUn espace rien qu’à vous !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 58,
      "label": "schoolmap_5_7",
      "hash64": "565E58BCA58C3637",
      "text": "C’est la chambre de Roseille.\\nLa décoration reflète bien sa personnalité.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 59,
      "label": "schoolmap_5_8",
      "hash64": "565E4DBCA58C2386",
      "text": "C’est la chambre de Kassis. Il consacre visiblement\\nbeaucoup de temps à son entraînement.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 60,
      "label": "schoolmap_5_9",
      "hash64": "565E4EBCA58C2539",
