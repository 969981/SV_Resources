    },
    {
      "ordinal": 15,
      "label": "s1_sub_018_woman_npc",
      "hash64": "4173059D9564CBB3",
      "text": "Prueba a usarlos para formar un corazón\\ncon alguien.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "s1_sub_018_man_npc",
      "hash64": "89644607171F7931",
      "text": "¡Amor para todos! ¡Personas y Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
