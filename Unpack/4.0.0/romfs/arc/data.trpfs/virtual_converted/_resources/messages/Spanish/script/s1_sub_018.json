  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "s1_sub_018_woman_01",
      "hash64": "2E13479A8E038F9F",
      "text": "Oye, chiqui, ¿no te parece que somos la pareja\\nmás cuqui que existe?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s1_sub_018_man_01",
      "hash64": "A4BEB69B60D0EE99",
      "text": "¡Ya lo creo, pichurri!\\c\\nDudo que exista otra pareja tan unida como\\nnosotros, ¡ni siquiera en el mundo Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_018_woman_02",
      "hash64": "2E13489A8E039152",
      "text": "¡Seguro que nooo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_018_woman_03",
      "hash64": "2E13499A8E039305",
      "text": "¡Oye, tú!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_018_woman_04",
      "hash64": "2E13429A8E038720",
      "text": "Si por lo que sea encuentras a una parejita de\\nPokémon que parezca estar tan enamoradita\\r\\ncomo mi chiqui y yo, ¿te importaría traerla aquí?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_018_man_02",
      "hash64": "A4BEB39B60D0E980",
      "text": "¡Me apuesto lo que sea a que no existe!\\n¡Ja, ja, ja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s1_sub_018_woman_05",
      "hash64": "2E13439A8E0388D3",
      "text": "¿Has encontrado a una parejita de Pokémon\\ntan inseparable y tierna como nosotros?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s1_sub_018_man_03",
      "hash64": "A4BEB49B60D0EB33",
      "text": "¡Pues claro que no! ¡Nadie se quiere más que\\nmi pichurri y yo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "s1_sub_018_man_04",
      "hash64": "A4BEB99B60D0F3B2",
      "text": "¿Dónde ves que ese Pokémon esté enamorado?\\n¡Ja, ja, ja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s1_sub_018_man_05",
      "hash64": "A4BEBA9B60D0F565",
      "text": "¿Qué es esto? ¡¿Un Tandemaus?!\\c\\n¡¿Dices que siempre van en parejita y que no\\nhay forma de separarlos?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_018_man_06",
      "hash64": "A4BEB79B60D0F04C",
      "text": "¿Qué es esto? ¡¿Un Maushold?!\\c\\n¡Mira, pichurri! ¡Se quieren tanto que han tenido\\nun bebito redondito!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_018_man_07",
      "hash64": "A4BEB89B60D0F1FF",
      "text": "¿Qué es esto? ¡¿Un Maushold?!\\c\\n¡Se quieren tanto que han tenido dos bebos!\\n¡Eso sí que es una familia feliz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_018_woman_06",
      "hash64": "2E13449A8E038A86",
      "text": "Vaya... Así que sí existen Pokémon que se\\nquieren tanto como mi chiqui y yo...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "s1_sub_018_woman_07",
      "hash64": "2E13459A8E038C39",
      "text": "Te vamos a enseñar unos gestos muy románticos\\npor haberte tomado la molestia.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s1_sub_018_system_01",
      "hash64": "715C9973D3928E94",
      "text": "¡La parejita te ha enseñado los gestos\\n[VAR 0xFF00(0008)]Corazón izquierda[VAR 0xFF00(0000)] y [VAR 0xFF00(0008)]Corazón derecha[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
