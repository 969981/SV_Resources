          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0000_select_01",
      "hash64": "D46CCE93A8067D63",
      "text": "Preside Clavel!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc02_0000_select_02",
      "hash64": "D46CCF93A8067F16",
      "text": "Nessun disturbo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_0000_headteacher_02",
      "hash64": "93CFB4D06897BF88",
      "text": "Oh, la sento pimpante! Mi fa piacere.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0000_headteacher_03",
      "hash64": "93CFB5D06897C13B",
      "text": "Se non le dispiace, vado direttamente al dunque.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0000_headteacher_04",
      "hash64": "93CFBAD06897C9BA",
      "text": "La sto chiamando perché si è presentata una\\nsplendida opportunità per lei.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0000_headteacher_06",
      "hash64": "93CFB8D06897C654",
      "text": "Lei conosce l’[VAR 0xFF00(0006)]Istituto Mirtillo [VAR 0xFF00(0000)]di Unima,\\ndico bene?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0000_select_03",
      "hash64": "D46CD093A80680C9",
      "text": "Certamente!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sdc02_0000_select_04",
      "hash64": "D46CD193A806827C",
      "text": "Mai sentito",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc02_0000_headteacher_07",
      "hash64": "93CFB9D06897C807",
      "text": "Per l’appunto. Mi è stato riferito che durante\\nil suo viaggio di studio ha incontrato\\r\\ndegli studenti di quell’istituto.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0000_headteacher_08",
      "hash64": "93CFAED06897B556",
      "text": "Non capisco. Mi è stato riferito che durante\\nil suo viaggio di studio ha incontrato\\r\\ndegli studenti di quell’istituto.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0000_headteacher_09",
      "hash64": "93CFAFD06897B709",
      "text": "Un mio amico di lunga data riveste il ruolo\\ndi Preside dell’Istituto Mirtillo.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0000_headteacher_10",
      "hash64": "93D33CD0689ADC77",
      "text": "Pare che gradirebbe molto che lei prendesse\\nparte al programma di scambio con la sua scuola.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0000_headteacher_11",
      "hash64": "93D33BD0689ADAC4",
      "text": "Personalmente, ritengo sia un’ottima occasione\\nper vedere quanto è vasto il mondo.\\c\\nDel resto, l’importante nella vita è mettersi\\ncostantemente alla prova.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 157,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0000_headteacher_12",
      "hash64": "93D33ED0689ADFDD",
      "text": "Tuttavia, non mi è chiaro il motivo per cui abbia\\nespressamente indicato lei, [VAR 0x0100(0000)]...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0000_headteacher_13",
      "hash64": "93D33DD0689ADE2A",
      "text": "La invito comunque a incontrare il mio amico\\nper avere maggiori dettagli.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0000_headteacher_14",
      "hash64": "93D338D0689AD5AB",
      "text": "È un personaggio alquanto eccentrico, ma non\\nsi preoccupi, ci sarò anch’io con lei.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0000_headteacher_15",
      "hash64": "93D337D0689AD3F8",
      "text": "Appena ne avrà l’occasione, la prego di passare\\nin presidenza per farmi sapere la sua opinione\\r\\nal riguardo.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0000_headteacher_17",
      "hash64": "93D339D0689AD75E",
      "text": "Ah! Chiaramente se è ancora pres[VAR 0x1100(00FF,0101)]oa dal suo\\nviaggio di studio, si senta liber[VAR 0x1100(00FF,0101)]oa di concentrarsi\\r\\nsu quello.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0000_headteacher_16",
      "hash64": "93D33AD0689AD911",
      "text": "Con questo la saluto. La ringrazio per avermi\\ndedicato un po’ del suo prezioso tempo.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
