    {
      "ordinal": 0,
      "label": "sdc02_0000_system_01",
      "hash64": "8041F6D75EEEC498",
      "text": "Rotoroto-rotoroto-rotoroto...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_0000_headteacher_01",
      "hash64": "93CFB7D06897C4A1",
      "text": "Pronto, [VAR 0x0100(0000)], parla Clavel.\\nSpero di non disturbarla.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
