        }
      ]
    },
    {
      "ordinal": 80,
      "label": "legend_0030_friend_44",
      "hash64": "1CE99E99E999A45C",
      "text": "Mais oui !\\nOh, j’suis tellement content ![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
