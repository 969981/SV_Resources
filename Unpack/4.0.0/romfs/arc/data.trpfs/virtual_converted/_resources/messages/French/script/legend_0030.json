        }
      ]
    },
    {
      "ordinal": 85,
      "label": "legend_0030_friend_48",
      "hash64": "1CE9A299E999AB28",
      "text": "Tout ça, c’est grâce aux bienfaits de ces épices !\\nÇa fait aucun doute ![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
