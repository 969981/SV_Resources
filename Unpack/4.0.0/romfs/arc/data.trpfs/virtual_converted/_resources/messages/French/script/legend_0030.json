    {
      "ordinal": 84,
      "label": "legend_0030_friend_47",
      "hash64": "1CE9A199E999A975",
      "text": "Oh... ! Ha ha ha ha ! Regarde, ses yeux sont si\\npetits qu’on a du mal à voir s’ils sont ouverts ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
