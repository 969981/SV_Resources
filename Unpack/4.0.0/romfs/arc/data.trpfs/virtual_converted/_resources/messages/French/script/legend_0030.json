      "tokens": []
    },
    {
      "ordinal": 79,
      "label": "legend_0030_friend_43",
      "hash64": "1CE99D99E999A2A9",
      "text": "Dogrino ! T-t-tes yeux !\\nT’as retrouvé la vue ?![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
