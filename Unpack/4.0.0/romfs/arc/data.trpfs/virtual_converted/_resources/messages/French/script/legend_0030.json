          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 86,
      "label": "legend_0030_friend_49",
      "hash64": "1CE9A399E999ACDB",
      "text": "En tout cas, c’est décidé. J’vais tout faire pour\\nsoigner Dogrino jusqu’à ce qu’il retrouve\\r\\nla santé ![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
