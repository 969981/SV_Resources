          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_a_05_ecology_04",
      "hash64": "87E3640EF89B14E1",
      "text": "Bueno, aún nos queda la mitad del temario de\\neste año, así que manos a la obra.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_a_05_ecology_05",
      "hash64": "87E3630EF89B132E",
      "text": "Al fin y al cabo, nosotros también tenemos que\\nhacer evolucionar nuestros conocimientos,\\r\\nal igual que los Pokémon.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
