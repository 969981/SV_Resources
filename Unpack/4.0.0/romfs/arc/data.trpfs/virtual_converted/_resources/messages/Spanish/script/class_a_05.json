    {
      "ordinal": 24,
      "label": "class_a_05_ecology_19",
      "hash64": "87DFDB0EF897F63F",
      "text": "Por cierto, los requisitos para la evolución\\ndifieren según el Pokémon.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
