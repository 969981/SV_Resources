          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_a_05_ecology_06",
      "hash64": "87E3620EF89B117B",
      "text": "Y hablando de evolución... Ese es precisamente\\nel tema de hoy.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_a_05_ecology_07",
      "hash64": "87E3610EF89B0FC8",
      "text": "Hoy vais a aprender todo lo habido y por haber\\nacerca de tan grandioso fenómeno.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_a_05_ecology_08",
      "hash64": "87E3600EF89B0E15",
      "text": "Gracias a los combates que libran y tras subir de\\nnivel, los Pokémon aprenden nuevos movimientos\\r\\ny se hacen más fuertes.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
