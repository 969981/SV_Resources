          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_a_05_ecology_03",
      "hash64": "87E3650EF89B1694",
      "text": "Y gracias también por responder a mi pregunta\\nacerca de la Pokédex.\\c\\nTendré en cuenta vuestros comentarios.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
