      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_side02_0035_camera_11",
      "hash64": "32EA7B80138D673D",
      "text": "Elle identifie les signaux émis par les Pokémon\\net permet de filtrer ceux qui nous intéressent pas.\\c\\nUne fois qu’on aura écarté les données des\\nPokémon alentour, le radar ne détectera plus\\r\\nqu’un seul signal : celui de Lune Vermeille ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
