          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_side02_0035_camera_05",
      "hash64": "32EDE38013904DCC",
      "text": "Les êtres humains le voient pas souvent,\\nparce qu’il se montre presque jamais.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
