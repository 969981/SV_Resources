      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_0035_camera_15",
      "hash64": "32EA7780138D6071",
      "text": "J’ai chiné cet appareil dans une brocante.\\c\\nJ’ai pas capté tout ce que dit la notice,\\nmais bon... s’il sert à chercher des Pokémon,\\r\\nil devrait faire l’affaire ![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
