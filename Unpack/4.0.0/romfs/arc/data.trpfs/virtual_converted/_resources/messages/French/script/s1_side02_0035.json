          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_side02_0035_camera_03",
      "hash64": "32EDE18013904A66",
      "text": "En tout cas, elle nous servira de base pendant\\nnos recherches sur Lune Vermeille ![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
