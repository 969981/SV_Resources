    },
    {
      "ordinal": 2,
      "label": "s2_side01_0030_botan_01",
      "hash64": "BAE39ABD743CDFC2",
      "text": "Mais puisque je te dis que j’y vais avec mes amis ![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
