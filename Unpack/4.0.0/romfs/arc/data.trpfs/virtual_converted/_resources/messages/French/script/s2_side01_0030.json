          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0030_botan_03",
      "hash64": "BAE398BD743CDC5C",
      "text": "Je ne suis plus ta « petite Pania », et...\\n... Oh, et puis zut ! Tu es lourd, à la fin ![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0030_botan_04",
      "hash64": "BAE397BD743CDAA9",
      "text": "Pfff... Ce qu’il peut être fatigant...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0030_friend_02",
      "hash64": "3A1086D73EFC2451",
      "text": "Ton père t’autorise à partir, finalement ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0030_botan_05",
      "hash64": "BAE396BD743CD8F6",
      "text": "Ouais, mais je me suis pris une mégadose de\\n« ma petite Pania », c’était franchement pénible.[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0030_friend_03",
      "hash64": "3A1085D73EFC229E",
      "text": "Faut l’comprendre ! C’est parce que ton papa\\ndoit avoir la mégatrouille pour sa fille ![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side01_0030_botan_06",
      "hash64": "BAE395BD743CD743",
      "text": "Euh oui... Tu as raison.\\nJ’y suis peut-être allée un peu fort...[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0030_rival_03",
      "hash64": "FDAF2C3F1233774A",
      "text": "Au moins, t’as obtenu sa permission,\\nc’est le plus important ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
