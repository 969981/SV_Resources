          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0320_friend_01",
      "hash64": "BC71CF5D2B33EAFF",
      "text": "여보세요?\\n[VAR 0x0100(0000)]의 스마트로토무 맞지?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0320_friend_02",
      "hash64": "BC71D05D2B33ECB2",
      "text": "나야, 페퍼!\\n제대로 출발했는지 걱정돼서 말이야.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0320_friend_03",
      "hash64": "BC71D15D2B33EE65",
      "text": "학교 동쪽에서 출발하기로 한 거구나![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0320_friend_04",
      "hash64": "BC71CA5D2B33E280",
      "text": "그쪽이라면 암벽의 주인이 산다는\\n암석 지대와 가까울 거야.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0320_friend_05",
      "hash64": "BC71CB5D2B33E433",
      "text": "녀석은 바위처럼 벽에 달라붙어서\\n먹이를 노린다고 해![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0320_friend_06",
      "hash64": "BC71CC5D2B33E5E6",
      "text": "주인을 찾는 데 집중하다\\n절벽에서 떨어지지 않게 조심해!\\c\\n만약 그런 일이 있으면 지도 앱으로\\n공중날기택시를 부르도록 하고.\\c\\n암석 지대가 많아서\\n천연의 미로처럼 되어 있으니까\\r\\n헤매지 않게 조심하고 열심히 찾아 보자!\\r\\n주인을 발견하면 연락 부탁해![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
