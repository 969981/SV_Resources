          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_0320_rival_06",
      "hash64": "BA413FDC052E8FC8",
      "text": "[VAR 0x0100(0000)] 너라면 이길 수 있을 거야!\\n그럼, 파이팅! 또 연락할게~![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
