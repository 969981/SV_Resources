    {
      "ordinal": 3,
      "label": "common_0320_rival_03",
      "hash64": "BA4144DC052E9847",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)] 학교 서쪽에서\\n출발하기로 했구나![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
