        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side02_0005_camera_07",
      "hash64": "46A0FF7C1A9180FC",
      "text": "Hier, schau dir mal diese Fotos an.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
