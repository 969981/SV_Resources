    {
      "ordinal": 1,
      "label": "s2_side02_0005_camera_02",
      "hash64": "46A0FC7C1A917BE3",
      "text": "Aber hallo! Du hast echt 200 Pokémon-Arten in\\nder Tera-Kuppel gefangen? Hut ab![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
