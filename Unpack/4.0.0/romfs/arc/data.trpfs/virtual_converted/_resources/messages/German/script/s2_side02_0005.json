      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side02_0005_camera_09",
      "hash64": "46A1057C1A918B2E",
      "text": "Der Ort auf den Fotos soll sich irgendwo in\\nPaldea befinden. Warst du schon mal dort?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
