          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side02_0005_camera_05",
      "hash64": "46A1017C1A918462",
      "text": "Wahrscheinlich kennst du dich schon viel besser\\nmit den Pokémon in der Kuppel aus als ich.\\r\\nObwohl ich zuerst hier war![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side02_0005_camera_06",
      "hash64": "46A1007C1A9182AF",
      "text": "Also dann, ich hatte es dir ja versprochen...\\nBist du bereit für meine [VAR 0xFF00(0006)]brandheißen Infos[VAR 0xFF00(0000)]?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
