        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_side02_0005_select_01",
      "hash64": "44CB1B8CF17EDDD7",
      "text": "Ich hab mir Mühe gegeben!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_side02_0005_select_02",
      "hash64": "44CB1C8CF17EDF8A",
      "text": "Das war ein Klacks!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s2_side02_0005_camera_03",
      "hash64": "46A0FB7C1A917A30",
      "text": "Ja, das sieht man. Gut gemacht! Ihr jungen Leute\\nsteckt einfach voller Energie.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
