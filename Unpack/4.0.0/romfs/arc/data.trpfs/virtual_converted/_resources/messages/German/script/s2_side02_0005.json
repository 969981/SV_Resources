          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side02_0005_camera_10",
      "hash64": "469D787C1A8E65C0",
      "text": "Oha! Ist er etwa so bekannt? Dahin würde\\nich auch gerne mal einen Abstecher wagen![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
