    {
      "ordinal": 1,
      "label": "sdc02_4kings_b_01_clerk_01",
      "hash64": "6F0524D6EB092A75",
      "text": "这里是峡谷广场，\\n四天王纳莉的小队欢迎你来！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_b_01_clerk_02",
      "hash64": "6F0521D6EB09255C",
      "text": "你是蓝莓联盟的挑战者\\n……[VAR 0x0100(0000)]，没错吧？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
