    {
      "ordinal": 3,
      "label": "sdc02_4kings_b_01_clerk_03",
      "hash64": "6F0522D6EB09270F",
      "text": "参加四天王挑战\\n需要支付５０ＢＰ！\\r\\n你愿意支付吗？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
