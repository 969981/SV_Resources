    {
      "ordinal": 4,
      "label": "sdc02_4kings_b_01_clerk_04",
      "hash64": "6F051FD6EB0921F6",
      "text": "天哪，\\n你的ＢＰ好像不够啊……\\r\\n参加蓝乐活来获得ＢＰ吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
