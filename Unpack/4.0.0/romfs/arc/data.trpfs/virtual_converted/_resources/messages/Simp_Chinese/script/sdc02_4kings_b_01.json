    {
      "ordinal": 5,
      "label": "sdc02_4kings_b_01_system_01",
      "hash64": "876FD5B083B0E1A9",
      "text": "[VAR 0x0100(0000)]支付了\\n５０ＢＰ！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
