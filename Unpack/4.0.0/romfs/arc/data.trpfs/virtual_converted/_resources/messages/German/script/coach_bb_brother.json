            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb_brother_sp03_03",
      "hash64": "50B90E7098D3DE56",
      "text": "Deshalb werd ich mich erst mal etwas\\nzurückziehen, um... zu mir selbst zu finden.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb_brother_sp03_04",
      "hash64": "50B9117098D3E36F",
      "text": "Ich möchte lernen, offener und ehrlicher mit\\nmeinen Freunden und Pokémon umzugehen.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
