          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb_brother_sp02_02",
      "hash64": "2781157BE3515C8C",
      "text": "Euer Besuch hat mir geholfen, dieses negative\\nGedankenkarussell zu stoppen.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb_brother_sp02_03",
      "hash64": "2781167BE3515E3F",
      "text": "Auch wenn dann ja leider diese andere\\nseltsame Sache passieren musste...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_bb_brother_sp02_select_03",
      "hash64": "A9DD7FFF7C8F6BAA",
      "text": "Du meinst das mit Hana?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb_brother_sp02_select_04",
      "hash64": "A9DD7AFF7C8F632B",
      "text": "Mo-mo?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_bb_brother_sp02_05",
      "hash64": "2781147BE3515AD9",
      "text": "Genau! Hana macht sich immer noch einen Kopf\\ndeswegen und ist nicht gut darauf zu sprechen.\\r\\nAlso sprich das Thema bloß nicht an![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
