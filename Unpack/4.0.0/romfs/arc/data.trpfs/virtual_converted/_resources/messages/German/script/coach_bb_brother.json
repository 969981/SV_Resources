    },
    {
      "ordinal": 31,
      "label": "coach_bb_brother_sp03_06",
      "hash64": "50B9137098D3E6D5",
      "text": "Abgesehen von meiner Position hat sich\\nbei den Top Vier aber nichts geändert.\\c\\nMatt ist total erleichtert, dass er nicht\\nrausgeflogen ist.[VAR 0x0114(0043)]",
