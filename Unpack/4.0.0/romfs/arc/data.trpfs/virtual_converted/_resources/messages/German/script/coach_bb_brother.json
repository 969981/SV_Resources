          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb_brother_sp02_05b",
      "hash64": "71B08983433D2BC1",
      "text": "Genau! Jetzt kann ich zwar darüber lachen,\\naber, puh... zu der Zeit hatte ich echt Angst.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
