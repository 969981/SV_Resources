      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_bb_brother_sp03_select_02",
      "hash64": "92E18EBC67B6A9C2",
      "text": "Hat es dir nicht mehr gefallen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "coach_bb_brother_sp03_01",
      "hash64": "50B90C7098D3DAF0",
      "text": "Ah, das ist nicht deine Schuld oder so, und es ist\\nauch nicht so, dass es mir nicht mehr gefallen hat.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
