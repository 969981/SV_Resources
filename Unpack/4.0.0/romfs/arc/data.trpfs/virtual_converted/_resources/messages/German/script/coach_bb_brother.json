    },
    {
      "ordinal": 28,
      "label": "coach_bb_brother_sp03_select_03",
      "hash64": "92E18FBC67B6AB75",
      "text": "Das ist ein guter Vorsatz!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_bb_brother_sp03_select_04",
      "hash64": "92E188BC67B69F90",
      "text": "Ich feuer dich dabei an!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "coach_bb_brother_sp03_05",
      "hash64": "50B9107098D3E1BC",
      "text": "Hehe... Danke![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
