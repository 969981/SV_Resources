          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_bb_brother_sp01_02",
      "hash64": "CD0657629AEB76DF",
      "text": "Okay, alle außer Levy, der sich ein blödes\\nGrinsen nicht verkneifen konnte...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_bb_brother_sp01_03",
      "hash64": "CD0656629AEB752C",
      "text": "Aber ich hab mich ordentlich bei ihm für mein\\nVerhalten entschuldigt.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_bb_brother_sp01_select_01",
      "hash64": "7B95975FE6DF1221",
      "text": "Das freut mich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_bb_brother_sp01_select_02",
      "hash64": "7B95945FE6DF0D08",
      "text": "Ihr versteht euch also gut?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_bb_brother_sp01_04",
      "hash64": "CD0655629AEB7379",
      "text": "Ja, mich auch! Das hab ich nur dir zu verdanken.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_bb_brother_sp01_04b",
      "hash64": "4D36318D3E1496E1",
      "text": "Jein. Also wir sind jetzt nicht dicke Buddys,\\naber... ich werd mir mehr Mühe geben.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_bb_brother_sp01_05",
      "hash64": "CD0654629AEB71C6",
      "text": "Jetzt muss ich allerdings erst mal etwas büffeln,\\num meinen Rückstand aufzuholen...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_bb_brother_sp02_00",
      "hash64": "2781177BE3515FF2",
      "text": "Danke, dass du Pepper und die anderen\\nmit nach Kitakami gebracht hast.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_bb_brother_sp02_01",
      "hash64": "2781187BE35161A5",
      "text": "Bevor ihr kamt, konnte ich nichts anderes tun,\\nals ununterbrochen über alles nachzudenken,\\r\\nwas passiert ist... Das war ganz schön hart.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
