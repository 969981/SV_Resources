          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb_brother_sp03_02",
      "hash64": "50B90F7098D3E009",
      "text": "Aber... Bis jetzt ging es mir nur darum,\\nso stark wie du zu werden...\\c\\nIch hatte total vergessen, dass Pokémon-Kämpfe\\nauch Spaß machen sollten.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
