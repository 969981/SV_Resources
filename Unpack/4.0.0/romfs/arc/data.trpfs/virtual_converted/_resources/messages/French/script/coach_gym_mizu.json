          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_mizu_sp03_04",
      "hash64": "060390E58E827BE9",
      "text": "Les jeunes en pleine croissance doivent\\nbien manger ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_mizu_sp03_05",
      "hash64": "06038FE58E827A36",
      "text": "Si j’atteins cet objectif, on pourra dire que j’aurai\\ncontribué à leur éducation... par la gastronomie ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_mizu_trade_01_00",
      "hash64": "DE6D182A49C40B17",
      "text": "Tu m’as donné l’opportunité de faire plaisir\\naux élèves et d’apprendre d’eux ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_mizu_trade_01_01",
      "hash64": "DE6D172A49C40964",
      "text": "Mouah ha ha !\\nMerci encore, t’as élargi mes horizons ![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_mizu_trade_01_02",
      "hash64": "DE6D1A2A49C40E7D",
      "text": "Et si on surfait sur cette vague d’enthousiasme\\nen faisant un échange de Pokémon ?[VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_mizu_trade_01_03",
      "hash64": "DE6D192A49C40CCA",
      "text": "Mouah ha ha, à la bonne heure !\\nJe vais me départir d’un Délestin !\\r\\nEt toi, tu vas me confier quel Pokémon ?[VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0018"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_mizu_trade_01_04",
      "hash64": "DE6D142A49C4044B",
      "text": "Ouah ! Ton [VAR 0x0101(0001)] déborde d’énergie !\\nC’est pas du menu fretin, ça !\\c\\nJe vais le prendre sous ma nageoire,\\net il frétillera de bonheur, foi de Kombu ![VAR 0x0114(0018)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
