      "label": "sdc02_0254_system_01",
      "hash64": "A8A6F5EA807AAAB3",
      "text": "Open the gate to the Zero Lab?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_0254_system_02",
      "hash64": "A8A6F6EA807AAC66",
      "text": "You know what you need to do... Better press it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sdc02_0254_system_03",
      "hash64": "A8A6F7EA807AAE19",
      "text": "ACCESS REVOKED DUE TO PROLONGED\\nINACTIVITY. ENTRANCE LOCKED.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc02_0254_sister_01",
      "hash64": "B59D7DDD3BCB7818",
      "text": "What’s the matter? Something wrong with it?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
