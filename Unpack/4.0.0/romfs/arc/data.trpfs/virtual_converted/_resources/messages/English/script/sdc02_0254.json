      "label": "sdc02_0254_brother_01",
      "hash64": "1395092E5B93D9B2",
      "text": "Huh?! It’s talking![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
