    {
      "ordinal": 17,
      "label": "sdc02_0254_bbteacher_04",
      "hash64": "4E2F8B64BCE0D7D5",
      "text": "Oh? Geeta gave you a mysterious item before\\nwe departed, did she? You think that’s it?[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
