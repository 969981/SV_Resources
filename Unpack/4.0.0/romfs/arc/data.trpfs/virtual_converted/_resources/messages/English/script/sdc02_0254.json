      "ordinal": 16,
      "label": "sdc02_0254_bbteacher_03",
      "hash64": "4E2F8464BCE0CBF0",
      "text": "“Indigo Disk”... What could it mean by that?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
