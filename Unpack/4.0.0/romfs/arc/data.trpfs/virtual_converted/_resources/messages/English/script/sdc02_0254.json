          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0254_bbteacher_01",
      "hash64": "4E2F8664BCE0CF56",
      "text": "It opened before though, right? Is there some\\nextra step we’re missing?[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0254_select_01",
      "hash64": "C9FA8DC14333DF60",
      "text": "There were four locks before, and...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_0254_select_02",
      "hash64": "C9FA90C14333E479",
      "text": "The professor was in the lab, and...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc02_0254_bbteacher_02",
      "hash64": "4E2F8564BCE0CDA3",
      "text": "I see... So last time, you went through a series of\\nsteps to unlock the gate, and the professor was\\r\\nalso there to guide you from the inside...[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
