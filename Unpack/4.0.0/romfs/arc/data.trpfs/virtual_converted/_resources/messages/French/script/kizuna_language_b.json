      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_language_b_05",
      "hash64": "F0BB485568903CD9",
      "text": "Tu n’en as pas ?\\nOh non ! Qu’est-ce qu’on va faire ?!\\c\\nOh, mais... J’en ai une dans ma poche !\\nQuel soulagement ![VAR 0x0114(0026)]",
      "flags": 0,
