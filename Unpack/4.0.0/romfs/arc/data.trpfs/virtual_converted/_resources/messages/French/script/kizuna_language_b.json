    {
      "ordinal": 4,
      "label": "kizuna_language_b_select_02",
      "hash64": "8B1DD7B854BEC35D",
      "text": "Essayez de rester calme, monsieur.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_language_b_04",
      "hash64": "F0BB475568903B26",
      "text": "Mais bien sûr ! Il faut lui donner une Potion !\\nEst-ce que tu en aurais une ?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
