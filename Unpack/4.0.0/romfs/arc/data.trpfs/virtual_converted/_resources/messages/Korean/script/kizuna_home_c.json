    },
    {
      "ordinal": 8,
      "label": "kizuna_home_c_07",
      "hash64": "9C0F894400C14EC1",
      "text": "대놓고 내가 움직이자니\\n사람들의 환상을 깰 것 같고...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
