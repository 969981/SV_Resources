      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_home_c_08",
      "hash64": "9C0F824400C142DC",
      "text": "물론, 사례는 할 테니\\n한번 생각해 주겠나?[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
