    },
    {
      "ordinal": 3,
      "label": "kizuna_home_c_select_02",
      "hash64": "1B8CB9547CEA430B",
      "text": "어떤 건데요?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "kizuna_home_c_03",
      "hash64": "9C0F8D4400C1558D",
      "text": "사실 큰 소리로 말하기\\n조금 힘든 일이다만...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
