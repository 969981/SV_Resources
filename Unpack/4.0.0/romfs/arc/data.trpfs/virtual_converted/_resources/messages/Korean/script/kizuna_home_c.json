          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_home_c_06",
      "hash64": "9C0F884400C14D0E",
      "text": "내가 단것이라면 사족을 못 쓴다는 건\\n자네만 아는 사실이라\\r\\n부탁할 사람이 자네밖에 없어서...[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
