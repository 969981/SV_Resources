    },
    {
      "ordinal": 5,
      "label": "common_2020_normal_010_normal_04",
      "hash64": "5D196C5F176D4D08",
      "text": "La Primera IS my boss, so I have to do as she\\nsays...but now she’s ordering students around?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
