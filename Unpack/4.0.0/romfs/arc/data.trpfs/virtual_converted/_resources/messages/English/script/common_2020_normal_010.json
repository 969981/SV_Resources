      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "common_2020_normal_010_normal_03",
      "hash64": "5D19735F176D58ED",
      "text": "Oh, of course, it’s no problem.[VAR 0x0114(0015)]",
