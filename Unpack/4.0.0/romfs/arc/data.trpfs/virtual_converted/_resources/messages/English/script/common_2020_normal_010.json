    },
    {
      "ordinal": 6,
      "label": "common_2020_normal_010_normal_05",
      "hash64": "5D196D5F176D4EBB",
      "text": "I see... So you’re helping the boss free up some\\ntime to enter a tournament at the academy?[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
