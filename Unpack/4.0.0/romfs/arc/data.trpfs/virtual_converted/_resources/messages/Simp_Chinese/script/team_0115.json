        }
      ]
    },
    {
      "ordinal": 38,
      "label": "team_0115_nelke_30",
      "hash64": "4DAF18DB987FE3BA",
      "text": "现在我要拜托你一件事，\\n是作为老师本应感到愧疚的请求。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0115_nelke_31",
      "hash64": "4DAF19DB987FE56D",
      "text": "请你战胜\\n天星队的真老大，仙后！[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0115_select_07",
      "hash64": "A25339232FC8477F",
      "text": "我知道了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "team_0115_select_08",
      "hash64": "A2533E232FC84FFE",
      "text": "交给我吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "team_0115_nelke_32",
      "hash64": "4DAF16DB987FE054",
      "text": "谢谢你。\\n那就拜托你了……[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
