          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "team_0115_math_02",
      "hash64": "7499F644469AC616",
      "text": "哎呀什么啊！[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "team_0115_math_03",
      "hash64": "7499F744469AC7C9",
      "text": "我听说有人在学校里决斗，\\n所以跑过来看看！！[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "team_0115_math_04",
      "hash64": "7499F844469AC97C",
      "text": "没想到竟然是校长本人，\\n你在对学生做什么呢！？[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "team_0115_nelke_34",
      "hash64": "4DAF14DB987FDCEE",
      "text": "不是的，其实……\\n这里面有一些令人悲伤的缘故……[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "team_0115_math_05",
      "hash64": "7499F944469ACB2F",
      "text": "缘菇也好哎呀球菇也好都不行！[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "team_0115_nelke_35",
      "hash64": "4DAF15DB987FDEA1",
      "text": "哎、哎呀球菇……！？[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
