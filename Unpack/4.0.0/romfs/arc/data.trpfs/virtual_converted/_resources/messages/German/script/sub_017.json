  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_017_system_kui_01",
      "hash64": "9AE43EF6D8FB58EC",
      "text": "Hier steckt ein unheilvoll anmutender schwarzer\\nPfahl im Boden...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_017_system_kui_02",
      "hash64": "9AE441F6D8FB5E05",
      "text": "Möchtest du ihn herausziehen?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_017_system_kui_03",
      "hash64": "9AE440F6D8FB5C52",
      "text": "Als du den Pfahl aus dem Boden ziehst,\\nzerfällt er und löst sich in Luft auf!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_017_system_kui_04",
      "hash64": "9AE43BF6D8FB53D3",
      "text": "Yuuu...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_017_system_kui_05",
      "hash64": "9AE43AF6D8FB5220",
      "text": "Aus Richtung des Schreins ertönt ein seltsamer\\nRuf...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_017_system_release_01",
      "hash64": "7540343DC23ACBCA",
      "text": "Leise Geräusche dringen aus dem Inneren des\\nSchreins hervor...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_017_system_release_02",
      "hash64": "7540333DC23ACA17",
      "text": "Möchtest du den Schrein berühren?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_017_system_release_03",
      "hash64": "7540323DC23AC864",
      "text": "*ratter* *ratter*\\n*rumpel* *rumpel*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_017_system_release_07",
      "hash64": "75402E3DC23AC198",
      "text": "*RUMMS*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_017_system_release_04",
      "hash64": "7540313DC23AC6B1",
      "text": "Yu!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_017_system_release_05",
      "hash64": "7540303DC23AC4FE",
      "text": "Yuyu wurde erneut im Schrein versiegelt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_017_system_release_06",
      "hash64": "75402F3DC23AC34B",
      "text": "Offenbar wird es etwas dauern, bis sich das Tor\\ndes Schreins wieder öffnet.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_017_system_hokora_01",
      "hash64": "81FC49FF6742A6ED",
      "text": "Auf dem Schrein ist etwas kaum Leserliches\\neingraviert...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_017_system_hokora_02",
      "hash64": "81FC46FF6742A1D4",
      "text": "AN DIESEM ORT WURDEN DIE\\nUNHEILSJUWELEN VERSIEGELT.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_017_system_hokora_03",
      "hash64": "81FC47FF6742A387",
      "text": "DAS SIEGEL DER UNHEILSJUWELEN WURDE\\nGEBROCHEN.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
