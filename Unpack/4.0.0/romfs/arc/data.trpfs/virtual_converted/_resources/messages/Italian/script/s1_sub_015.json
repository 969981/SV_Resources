          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_015_caretaker_12",
      "hash64": "AA1745EB935D27E8",
      "text": "Quindi, sto facendo una raccolta fondi\\nper restaurarle.\\r\\nL’ho chiamata [VAR 0xFF00(0006)]colletta della benevolenza[VAR 0xFF00(0000)]![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
