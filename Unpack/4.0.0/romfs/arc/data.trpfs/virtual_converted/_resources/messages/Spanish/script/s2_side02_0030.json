    {
      "ordinal": 6,
      "label": "s2_side02_0030_camera_04",
      "hash64": "9180AA077DC9A18D",
      "text": "¿Eh? ¡No me digas que has capturado a alguno\\nde los Pokémon de las fotos![VAR 0x0114(0046)]",
