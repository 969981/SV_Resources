    {
      "ordinal": 7,
      "label": "s2_side02_0030_camera_a1_01",
      "hash64": "69708D0BD9114DBF",
      "text": "¡Se trata del auténtico Flamariete, no cabe duda!\\c\\nEsa especie de cornamenta que adorna su\\ncabeza es asombrosa.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
