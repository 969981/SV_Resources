            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side02_0030_camera_a1_02",
      "hash64": "69708E0BD9114F72",
      "text": "Según los rumores, ¡basta con un solo rugido\\nsuyo para que el magma brote a la superficie\\r\\na borbotones![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
