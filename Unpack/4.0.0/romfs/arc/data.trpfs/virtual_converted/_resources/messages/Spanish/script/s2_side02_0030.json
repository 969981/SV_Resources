          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side02_0030_camera_b1_01",
      "hash64": "BA432C630EB91432",
      "text": "¡Se trata del auténtico Ferromole, está clarísimo!\\n¡Menuda bestia parda![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side02_0030_camera_b1_02",
      "hash64": "BA432B630EB9127F",
      "text": "Dicen los rumores que puede concentrar energía\\nen las astas de la cabeza y demoler cualquier\\r\\ncosa con ellas. ¿Será cierto?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side02_0030_camera_a2_01",
      "hash64": "950B15123A1F67A8",
      "text": "¡Se trata del auténtico Electrofuria, estoy segura!\\c\\n¡Tiene un cuello taaan largo! Buscar el encuadre\\nperfecto no parece tarea fácil.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side02_0030_camera_a2_02",
      "hash64": "950B18123A1F6CC1",
      "text": "Se rumorea que es capaz de cubrir el cielo de\\nnubarrones negros y desatar una tormenta\\r\\neléctrica con tan solo menear el cuello.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side02_0030_camera_b2_01",
      "hash64": "67C8EC7EC9AD97C5",
      "text": "¡Se trata del auténtico Ferrotesta, claramente!\\n¡Qué pasada cómo brilla![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side02_0030_camera_b2_02",
      "hash64": "67C8E97EC9AD92AC",
      "text": "Según se rumorea, por los cuernos puede lanzar\\nunos rayos de luz que lo cortan todo.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_side02_0030_camera_05",
      "hash64": "9180A9077DC99FDA",
      "text": "¡Ja, ja, ja! Menos mal que los rumores siempre\\nlo exageran todo, ¿no? Si no, qué mal rollo...\\c\\nY ahora, si me lo permites, voy a sacar unas\\nfotillos para recordar este momento...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 180,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side02_0030_camera_06",
      "hash64": "9180A8077DC99E27",
      "text": "Si existe uno, es muy posible que el otro también\\nande por ahí, ¿no?\\c\\n¡Cuento contigo para llegar al fondo del asunto,\\n[VAR 0x0100(0000)]![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side02_0030_camera_07",
      "hash64": "9180A7077DC99C74",
      "text": "¡Has dado con los dos! Eres [VAR 0x1100(00FF,0202)]ella mejor soci[VAR 0x1100(00FF,0101)]oa de\\nla historia, [VAR 0x0100(0000)].[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0202"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side02_0030_camera_08",
      "hash64": "91809E077DC98D29",
      "text": "La verdad es que me has sacado de una buena...\\c\\nEstaba dándoles tantas vueltas a esas fotos\\nque no podía concentrarme en el trabajo.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side02_0030_camera_09",
      "hash64": "91809D077DC98B76",
      "text": "No te había prometido nada, así que ¡sorpresa!\\c\\nTe regalo esto por haberme ayudado a quitarme\\nel tema de la cabeza.\\c\\nEs una cosita que no se ve todos los días,\\n¡no te quejarás![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 180,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_side02_0030_camera_10",
      "hash64": "917D20077DC68138",
      "text": "El mundo está repleto de misterios que aguardan\\nser descubiertos, ¡cada vez lo tengo más claro![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_side02_0030_camera_11",
      "hash64": "917D21077DC682EB",
      "text": "A tu edad me habría encantado ir de un lado\\npara otro a explorar, pero ahora ya no me veo\\r\\ncon tantas energías.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_side02_0030_camera_12",
      "hash64": "917D22077DC6849E",
      "text": "Así que espero que seas capaz de viajar y\\ndescubrir por mí muchos Pokémon nuevos.\\c\\n¡Sal ahí y cómete el mundo, [VAR 0x0100(0000)]![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_side02_0030_camera_13",
      "hash64": "917D23077DC68651",
      "text": "En fin, supongo que toca volver al trabajo.\\nYa no hay más excusas.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_side02_0030_camera_npc_01",
      "hash64": "A487FFC5BD0B7C06",
      "text": "¡Hace poco actualizaron la aplicación cámara\\ny le añadieron funciones nuevas!\\c\\nQuizá debería empezar a usar filtros en mi\\ntrabajo para darle un toque más especial...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_side02_0030_camera_npc_02",
      "hash64": "A487FEC5BD0B7A53",
      "text": "Parece que mi Growlithe ha memorizado tu olor\\ny se ha encariñado bastante contigo.\\c\\nNo te olvides de saludarlo a él también de vez\\nen cuando, ¡seguro que se alegra![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 166,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_side02_0030_camera_npc_03",
      "hash64": "A487FDC5BD0B78A0",
      "text": "Cuesta creer que el Biodomo esté sumergido\\nbajo el océano... ¡Es un concepto maravilloso!\\c\\nY el hecho de poder caminar de una montaña\\nnevada a una playa tropical en cuestión de un\\r\\npar de minutos me parece increíble...\\c\\n¡Este lugar es el sueño de todo fotógrafo![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
