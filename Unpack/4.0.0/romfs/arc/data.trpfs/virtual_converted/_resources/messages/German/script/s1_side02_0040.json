          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_side02_0040_camera_07",
      "hash64": "9AD6E615162B2AD2",
      "text": "Worauf achtest du, wenn du Fotos machst?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
