      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "s1_side02_0040_select_03",
      "hash64": "C1929DDC3341796B",
      "text": "Auf nichts Besonderes",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "s1_side02_0040_camera_08",
      "hash64": "9AD6E915162B2FEB",
      "text": "Die Realität abzubilden...\\c\\nDu fotografierst also Pokémon einfach in ihrem\\nnatürlichen Lebensraum, ohne Ausschmückungen.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
