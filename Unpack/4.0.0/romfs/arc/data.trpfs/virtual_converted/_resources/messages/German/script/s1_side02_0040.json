          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_side02_0040_select_01",
      "hash64": "C1929FDC33417CD1",
      "text": "Die Realität abzubilden",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "s1_side02_0040_select_02",
      "hash64": "C1929CDC334177B8",
      "text": "Das Pokémon gut in Szene zu setzen",
