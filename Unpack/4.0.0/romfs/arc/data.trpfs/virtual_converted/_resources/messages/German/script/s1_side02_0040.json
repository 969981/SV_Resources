            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_side02_0040_camera_11",
      "hash64": "9AD37C15162840DD",
      "text": "Weißt du... Ich stecke gerade in einem kreativen\\nTief.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_side02_0040_camera_12",
      "hash64": "9AD3791516283BC4",
      "text": "Egal, was ich tue... Nichts läuft so, wie ich es will.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_side02_0040_camera_13",
      "hash64": "9AD37A1516283D77",
      "text": "Dabei wurde ich immer als Fotografie-Genie\\ngefeiert, als ich klein war.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_0040_camera_14",
      "hash64": "9AD377151628385E",
      "text": "Aber seit einigen Jahren fehlt meinen Fotos\\neinfach das gewisse Etwas.\\c\\nSie erhalten keinerlei Anerkennung, von Preisen\\nganz zu schweigen.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_side02_0040_camera_15",
      "hash64": "9AD3781516283A11",
      "text": "Das geht jetzt schon so lange so...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_side02_0040_camera_16",
      "hash64": "9AD37515162834F8",
      "text": "Mittlerweile weiß ich gar nicht mehr, warum ich\\nüberhaupt noch Fotos mache.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_side02_0040_dog_02",
      "hash64": "AD952531E61B7654",
      "text": "Fuka...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "s1_side02_0040_camera_17",
      "hash64": "9AD37615162836AB",
      "text": "Aber als mir das Gerücht über Blutmond\\nzu Ohren kam...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_side02_0040_camera_18",
      "hash64": "9AD3731516283192",
      "text": "Da dachte ich, vielleicht verändert sich ja etwas\\nin mir, wenn ich so ein beeindruckendes Pokémon\\r\\nfotografiere.\\c\\nAlso hab ich alles stehen und liegen lassen und\\nbin hergekommen.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 182,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_side02_0040_select_04",
      "hash64": "C192A2DC334181EA",
      "text": "Nicht aufgeben, Sie schaffen das!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "s1_side02_0040_select_05",
      "hash64": "C192A3DC3341839D",
      "text": "Wie doof für Sie.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "s1_side02_0040_camera_19",
      "hash64": "9AD3741516283345",
      "text": "Danke, Partner. Tut mir leid, dass ich dir hier\\nwas vorgeheult hab.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_side02_0040_camera_20",
      "hash64": "9ACFF515162525A1",
      "text": "Doof, sagst du? Das ist zu gut, ahahaha!\\c\\nMit der Kamera bist du definitiv gewandter\\nals mit Worten, so viel steht fest. Ahaha![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_side02_0040_system_01",
      "hash64": "95437766AA44E316",
      "text": "Tüdelüüü, tüdelüdelüüü! Tüdelüdelüdelüüü!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "s1_side02_0040_camera_21",
      "hash64": "9ACFF415162523EE",
      "text": "Ah, wie’s aussieht, sind die Daten fertig\\nanalysiert. Aber... diese Melodie dazu...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s1_side02_0040_camera_22",
      "hash64": "9ACFF3151625223B",
      "text": "Die klang genauso wie meine Waschmaschine,\\nwenn sie fertig ist...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s1_side02_0040_camera_23",
      "hash64": "9ACFF21516252088",
      "text": "Ahahaha! Das ist ja ein Ding! Haben sie die\\nMelodie etwa einfach wiederverwendet?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "s1_side02_0040_camera_24",
      "hash64": "9ACFF91516252C6D",
      "text": "Okaaay, mal sehen...\\c\\nEs gibt nur ein Signal, das sich nicht mit den\\nDaten deckt, die wir im Wald gesammelt haben.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "s1_side02_0040_camera_25",
      "hash64": "9ACFF81516252ABA",
      "text": "Das muss Blutmond sein. Endlich wissen wir,\\nwo es sich aufhält![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s1_side02_0040_camera_26",
      "hash64": "9ACFF71516252907",
      "text": "Hehe! Durch das Gespräch mit dir fühle ich mich\\nirgendwie weniger angespannt. So... befreit.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "s1_side02_0040_camera_28",
      "hash64": "9ACFED1516251809",
      "text": "Wenn’s dir recht ist, würde ich direkt zu Blutmond\\ngehen. Bist du bereit, Partner?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "s1_side02_0040_camera_29",
      "hash64": "9ACFEC1516251656",
      "text": "Endlich ist es so weit! Auf geht’s![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "s1_side02_0040_camera_30",
      "hash64": "9ACC6F1516220C18",
      "text": "Oh? Ich glaube, deine Pokémon-Boxen sind voll.\\nSchaff sicherheitshalber mal etwas Platz.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
