    },
    {
      "ordinal": 3,
      "label": "gym_koori_010_receptionist_04",
      "hash64": "C2D8D131076D1F0C",
      "text": "나페산체육관의 체육관 테스트 과제는...\\n[VAR 0xFF00(0006)]설산 활강하기[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
