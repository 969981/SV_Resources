    {
      "ordinal": 2,
      "label": "gym_koori_010_receptionist_03",
      "hash64": "C2D8D031076D1D59",
      "text": "이곳의 체육관 관장 그루샤 님과\\n승부하려면 체육관 테스트를\\r\\n클리어해야 합니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
