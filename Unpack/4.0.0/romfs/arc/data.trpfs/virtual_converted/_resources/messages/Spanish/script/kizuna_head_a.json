          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_head_a_system",
      "hash64": "FF183FB623C60AA0",
      "text": "¡Ahora te llevas un poco mejor con Clavel!",
      "flags": 0,
