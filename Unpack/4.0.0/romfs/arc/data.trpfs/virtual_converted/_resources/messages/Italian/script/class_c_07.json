          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_c_07_history_07b",
      "hash64": "F037F219BAD896EA",
      "text": "Non hai tutti i torti... Partendo dalla fine\\nfaticheremmo a seguire il filo conduttore\\r\\nche lega le azioni alle loro conseguenze.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
