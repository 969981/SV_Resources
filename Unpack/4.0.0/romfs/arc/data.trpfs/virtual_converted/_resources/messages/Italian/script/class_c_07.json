          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_c_07_history_04",
      "hash64": "1E1E53EDD0C2B925",
      "text": "In fondo non era poi così tanto tempo fa...\\nCi stiamo avvicinando al presente.[VAR 0x0114(0027)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_c_07_history_05",
      "hash64": "1E1E52EDD0C2B772",
      "text": "Non apprezzo affatto che nell’insegnare la storia\\nci si debba muovere verso il futuro.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_c_07_history_06",
      "hash64": "1E1E51EDD0C2B5BF",
      "text": "Non sarebbe più affascinante invece il percorso\\ninverso?\\c\\nOvvero, partire dal presente per poi addentrarci\\na poco a poco tra le nebbie del passato?![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_c_07_select_a",
      "hash64": "2A85FB8B4ED96C98",
      "text": "Assolutamente sì!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "class_c_07_select_b",
      "hash64": "2A85FE8B4ED971B1",
      "text": "Sarebbe difficile da seguire...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "class_c_07_history_07a",
      "hash64": "F037F119BAD89537",
      "text": "Tu sì che mi capisci, [VAR 0x0100(0000)]! Purtroppo,\\nperò, mi tocca obbedire alle linee guida ufficiali.\\r\\nAltrimenti chi lo sente il nostro caro Preside?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
