    },
    {
      "ordinal": 2,
      "label": "sdc02_0140_dragonbb_03",
      "hash64": "955F3F3F66301923",
      "text": "T’as remporté ta première victoire contre\\nle Conseil 4 !\\c\\nÇa commence plutôt bien pour toi ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
