            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0140_dragonbb_a_04",
      "hash64": "68673ABEAB87592A",
      "text": "Le connaissant, ça doit aussi le préoccuper,\\ntout ça...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
