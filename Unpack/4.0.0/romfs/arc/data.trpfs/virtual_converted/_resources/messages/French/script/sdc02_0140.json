    },
    {
      "ordinal": 4,
      "label": "sdc02_0140_dragonbb_a_02",
      "hash64": "686734BEAB874EF8",
      "text": "C’est bien de pas se prendre la tête, moi je dis ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0140_dragonbb_a_03",
      "hash64": "686735BEAB8750AB",
      "text": "Avant, on se retrouvait tous ensemble après\\nnos activités de club, et Rubépin nous préparait\\r\\nde bons petits plats. C’était trop cool...[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
