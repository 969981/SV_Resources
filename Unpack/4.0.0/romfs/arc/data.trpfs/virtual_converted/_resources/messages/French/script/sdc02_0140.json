          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0140_dragonbb_b_03",
      "hash64": "0F3275A564362A38",
      "text": "Elle peut avoir l’air froide et rigide, comme ça...\\nmais en fait, elle est hyper sensible.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0140_dragonbb_b_04",
      "hash64": "0F327CA56436361D",
      "text": "C’est pas toujours facile de la cerner, mais\\ncrois-moi, ça vaut le coup d’essayer.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
