      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0140_dragonbb_04",
      "hash64": "955F443F663021A2",
      "text": "Heureusement que t’es là. Tu vas pouvoir nous\\naider à faire redescendre Kassis sur terre.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
