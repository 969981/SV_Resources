    },
    {
      "ordinal": 3,
      "label": "sdc02_0140_dragonbb_a_01",
      "hash64": "686737BEAB875411",
      "text": "Rubépin, c’est un gars simple, il s’encombre pas\\ndes détails. Mais il est loin d’être faible.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
