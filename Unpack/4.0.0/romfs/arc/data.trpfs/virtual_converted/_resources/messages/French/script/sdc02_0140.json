          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0140_dragonbb_b_01",
      "hash64": "0F3277A564362D9E",
      "text": "Franchement, tu la trouves pas trop cool,\\nNérine ?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0140_dragonbb_b_02",
      "hash64": "0F3276A564362BEB",
      "text": "Tu devrais la voir discuter avec Roseille !\\nC’est des barres ! Je me demande vraiment\\r\\ncomment elles font pour se comprendre ! Ha ha ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
