    {
      "ordinal": 1,
      "label": "sdc02_0140_dragonbb_02",
      "hash64": "955F3E3F66301770",
      "text": "Yo !\\nDésolé... Je t’ai pas trop fait poireauter ?[VAR 0x0114(004A)]",
      "flags": 0,
