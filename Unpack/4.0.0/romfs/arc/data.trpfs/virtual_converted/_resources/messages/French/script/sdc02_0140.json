      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0140_dragonbb_d_02",
      "hash64": "36C22694F24E4479",
      "text": "J’espère que t’es pas allergique à la poussière,\\npar contre.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
