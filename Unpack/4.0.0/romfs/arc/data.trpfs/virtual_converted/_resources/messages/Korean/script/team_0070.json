      ]
    },
    {
      "ordinal": 36,
      "label": "team_0070_botan_04",
      "hash64": "29E67690A8C5E2DC",
      "text": "아아아으...!![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
