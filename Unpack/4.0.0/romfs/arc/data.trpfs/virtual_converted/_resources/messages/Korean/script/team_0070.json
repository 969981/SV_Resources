    },
    {
      "ordinal": 38,
      "label": "team_0070_botan_06",
      "hash64": "29E67890A8C5E642",
      "text": "스타단의 창시자이자\\n만악의 근원...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
