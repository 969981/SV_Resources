    {
      "ordinal": 37,
      "label": "team_0070_botan_05",
      "hash64": "29E67790A8C5E48F",
      "text": "흑막의 존재...\\n나도 카시오페아한테서 들었어.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
