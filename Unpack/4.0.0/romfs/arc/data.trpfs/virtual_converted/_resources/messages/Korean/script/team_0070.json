      ]
    },
    {
      "ordinal": 39,
      "label": "team_0070_botan_07",
      "hash64": "29E67990A8C5E7F5",
      "text": "녀석을 쓰러뜨리지 않으면\\n나의 소중한 보물을 잃어버리고 말 거야...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
