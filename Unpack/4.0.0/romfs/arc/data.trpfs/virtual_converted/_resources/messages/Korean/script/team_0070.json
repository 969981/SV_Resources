      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "team_0070_botan_03",
      "hash64": "29E67590A8C5E129",
      "text": "으아아!\\n너한테는 안 물어봤어![VAR 0x0114(0008)]",
