      "hash64": "0E6C3D12073027DF",
      "text": "[VAR 0x0100(0000)]!\\n기다리고 있었다구!\\r\\n약속 같은 건 한 적 없지만![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
