    {
      "ordinal": 2,
      "label": "sdc01_0190_sister_01",
      "hash64": "41F0C26CE512CEBA",
      "text": "Hm, ich frag mich, wer dieses Kind war...\\nUnd wo kam es her?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
