          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0190_brother_02",
      "hash64": "4C91083525EBFACD",
      "text": "Was steht ihr denn hier so rum?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0190_select_03",
      "hash64": "CC1E19A6B4AF5C20",
      "text": "Wir haben den Oni getroffen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc01_0190_select_04",
      "hash64": "CC1E20A6B4AF6805",
      "text": "Der Oni war hier!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc01_0190_sister_07",
      "hash64": "41F0BC6CE512C488",
      "text": "LA, LA, LAAAA!! Hier ist ja wirklich GAR NICHTS\\nlos, lass uns zurück zum Fest gehen![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0190_brother_03",
      "hash64": "4C91073525EBF91A",
      "text": "Hm, was? Dank dir hab ich kein Wort\\nverstanden, Hana![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0190_sister_08",
      "hash64": "41F0BB6CE512C2D5",
      "text": "Nichts! [VAR 0x1100(00FF,0302,0000)]ErSie hat nichts Wichtiges gesagt,\\nwie immer! Alles gut![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302",
            "0000"
          ]
