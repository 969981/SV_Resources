      "label": "sdc01_0190_brother_01",
      "hash64": "4C91053525EBF5B4",
      "text": "[VAR 0x0100(0000)]! Hana![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
