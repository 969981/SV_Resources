          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0190_brother_04",
      "hash64": "4C91023525EBF09B",
      "text": "Aha...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0190_brother_05",
      "hash64": "4C91013525EBEEE8",
      "text": "Ah, versteh schon. Ihr habt euch bestimmt über\\nmich lustig gemacht...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0190_brother_06",
      "hash64": "4C91043525EBF401",
      "text": "Ich geh zurück zum Fest...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0190_sister_09",
      "hash64": "41F0BA6CE512C122",
      "text": "Puh, das war knapp.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0190_sister_10",
      "hash64": "41ED3D6CE50FB6E4",
      "text": "Mann, jag mir doch nicht so ’nen Schrecken ein!\\nFast hättest du dich total verplappert.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0190_sister_11",
      "hash64": "41ED3E6CE50FB897",
      "text": "Jo ist absolut vernarrt in den Oni, so richtig.\\nTotal verrückt nach ihm.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0190_sister_12",
      "hash64": "41ED3F6CE50FBA4A",
      "text": "Wenn er wüsste, dass wir ihn getroffen haben\\nund er nicht... Ich weiß nicht. Da würde er sich\\r\\nbestimmt ausgeschlossen fühlen.\\c\\nOder meinst du, ich mach mir zu viele Sorgen?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 177,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0190_sister_13",
      "hash64": "41ED406CE50FBBFD",
      "text": "Außerdem will ich nicht, dass er dem Oni um\\ndiese Uhrzeit noch auf den Berg hinterherläuft...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0190_sister_14",
      "hash64": "41ED396CE50FB018",
      "text": "Aber egal, jetzt haben wir uns eh schon fürs\\nLügen entschieden.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0190_sister_15",
      "hash64": "41ED3A6CE50FB1CB",
      "text": "Behalt das alles für dich, okay?\\nDas ist unser kleines Geheimnis.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0190_sister_16",
      "hash64": "41ED3B6CE50FB37E",
      "text": "Und zeig Jo bloß nicht die Maske!\\nZumindest fürs Erste.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0190_sister_17",
      "hash64": "41ED3C6CE50FB531",
      "text": "Hehehe... Das Maskenfest ist der Knaller!\\nUnd es ist überhaaaupt nichts Ungewöhnliches\\r\\npassiert, hab ich recht?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
