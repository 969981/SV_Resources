      "ordinal": 31,
      "label": "common_1010_rival_08a",
      "hash64": "3279C99D90CAA2BA",
      "text": "咦？奥琳博士！？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
