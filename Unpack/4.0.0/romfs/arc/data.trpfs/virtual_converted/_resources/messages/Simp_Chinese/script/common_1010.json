      ]
    },
    {
      "ordinal": 30,
      "label": "common_1010_friend_09b",
      "hash64": "3777CA9BB99ACFE6",
      "text": "呃……\\n他是我爸，\\r\\n……大概是。[VAR 0x0114(0006)]",
