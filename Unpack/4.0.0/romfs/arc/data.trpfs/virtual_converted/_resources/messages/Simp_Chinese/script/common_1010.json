    {
      "ordinal": 26,
      "label": "common_1010_hakase_03a",
      "hash64": "E83AC8B75942B682",
      "text": "看来你已经为我\\n召集到优秀的伙伴了啊。[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
