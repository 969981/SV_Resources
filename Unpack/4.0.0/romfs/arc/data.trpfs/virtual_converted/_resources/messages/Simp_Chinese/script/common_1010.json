          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "common_1010_friend_09a",
      "hash64": "3777C99BB99ACE33",
      "text": "呃……\\n她是我妈，\\r\\n……大概是。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
