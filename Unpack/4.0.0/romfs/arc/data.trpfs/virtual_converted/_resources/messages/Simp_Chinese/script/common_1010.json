    },
    {
      "ordinal": 32,
      "label": "common_1010_rival_08b",
      "hash64": "3279C89D90CAA107",
      "text": "咦？弗图博士！？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
