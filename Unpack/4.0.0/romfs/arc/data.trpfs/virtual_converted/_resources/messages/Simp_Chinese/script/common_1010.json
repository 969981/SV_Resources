      ]
    },
    {
      "ordinal": 27,
      "label": "common_1010_hakase_03b",
      "hash64": "E83AC7B75942B4CF",
      "text": "看来你已经为我\\n召集到优秀的伙伴了啊。[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
