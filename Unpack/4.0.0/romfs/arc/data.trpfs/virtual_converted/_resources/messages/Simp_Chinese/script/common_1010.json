    {
      "ordinal": 28,
      "label": "common_1010_botan_07",
      "hash64": "36AD1A9F80D933D0",
      "text": "嗯？这是哪位？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
