          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0230_bbteacher_06",
      "hash64": "FA33B6C9DB9F1911",
      "text": "네가 블루베리그에서\\n선전하고 있다는 건 들었어.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0230_bbteacher_07",
      "hash64": "FA33B5C9DB9F175E",
      "text": "그런데 설마 챔피언까지 되다니\\n정말 놀라운걸!\\r\\n그야말로 눈부신 업적이야![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
