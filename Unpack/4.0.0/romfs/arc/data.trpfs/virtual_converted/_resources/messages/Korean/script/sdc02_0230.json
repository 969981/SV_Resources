    },
    {
      "ordinal": 21,
      "label": "sdc02_0230_bbteacher_14",
      "hash64": "FA3036C9DB9C09BA",
      "text": "[VAR 0xFF00(0006)]테라파고스[VAR 0xFF00(0000)]를 찾아 볼 생각이야![VAR 0x0114(0042)]",
