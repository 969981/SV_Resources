    },
    {
      "ordinal": 1,
      "label": "sdc02_0230_bbteacher_01",
      "hash64": "FA33B7C9DB9F1AC4",
      "text": "다들 모였구나.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
