          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0230_bbteacher_05",
      "hash64": "FA33B3C9DB9F13F8",
      "text": "그건 그렇고, [VAR 0x0100(0000)]![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
