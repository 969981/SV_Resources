      "ordinal": 31,
      "label": "sdc02_0230_chairman_05",
      "hash64": "7A9A9A6FC1DE84B7",
      "text": "과연 보기 드문 젊은 재능...\\n훌륭하네요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
