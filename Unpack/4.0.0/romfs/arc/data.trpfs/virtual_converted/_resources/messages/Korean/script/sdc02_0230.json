    },
    {
      "ordinal": 23,
      "label": "sdc02_0230_chairman_01",
      "hash64": "7A9A966FC1DE7DEB",
      "text": "꽤나 흥미로운 이야기네요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
