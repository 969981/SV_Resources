      "ordinal": 26,
      "label": "sdc02_0230_select_03",
      "hash64": "93842F741EF697C4",
      "text": "치프!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
