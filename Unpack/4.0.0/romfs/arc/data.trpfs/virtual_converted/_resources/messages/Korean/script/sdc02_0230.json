          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0230_bbteacher_08",
      "hash64": "FA33B0C9DB9F0EDF",
      "text": "...미안.\\n내가 배려가 좀 부족했네.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
