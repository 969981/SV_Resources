    {
      "ordinal": 0,
      "label": "kizuna_history_c_01",
      "hash64": "5DCE55A6482D05F2",
      "text": "[VAR 0x0100(0000)]!\\n때가 되었어![VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
