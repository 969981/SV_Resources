    {
      "ordinal": 20,
      "label": "schoolmap_2_1",
      "hash64": "60396BBCAB779DC0",
      "text": "The entrance to Naranja Academy. You can check in at the\\nfront desk to take a class.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "schoolmap_2_18",
      "hash64": "F93009975C416C68",
      "text": "The entrance to Uva Academy. You can check in at the\\nfront desk to take a class.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "schoolmap_2_2",
      "hash64": "60396EBCAB77A2D9",
      "text": "Your dorm room. A nice space of your own away\\nfrom home.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "schoolmap_2_3",
      "hash64": "60396DBCAB77A126",
      "text": "Nemona’s dorm room. It’s very tidy.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "schoolmap_2_4",
      "hash64": "603970BCAB77A63F",
      "text": "Arven’s dorm room. Delicious cooking smells waft from it.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "schoolmap_2_5",
      "hash64": "60396FBCAB77A48C",
      "text": "Penny’s dorm room. It’s got lots of computer gear, and the\\nlight is a bit dim.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "schoolmap_2_6",
      "hash64": "603972BCAB77A9A5",
      "text": "Your and Nemona’s classroom, for students in the general\\nstudies track. Mr. Jacq is the homeroom teacher.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "schoolmap_2_7",
      "hash64": "603971BCAB77A7F2",
      "text": "A classroom for second-year students in the humanities\\ntrack. Mr. Salvatore is the homeroom teacher.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "schoolmap_2_19",
      "hash64": "F9300A975C416E1B",
      "text": "Arven’s classroom, for students in the humanities track.\\nMr. Salvatore is the homeroom teacher.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "schoolmap_2_8",
      "hash64": "603974BCAB77AD0B",
      "text": "A classroom for students in the STEM track. Ms. Tyme is the\\nhomeroom teacher.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "schoolmap_2_20",
      "hash64": "F93A13975C49D1EB",
      "text": "Penny’s classroom, for students in the STEM track.\\nMs. Tyme is the homeroom teacher.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "schoolmap_2_9",
      "hash64": "603973BCAB77AB58",
      "text": "Director Clavell’s office. His desk and research equipment\\ncan be found here.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "schoolmap_2_10",
      "hash64": "F93001975C415ED0",
      "text": "A room for the faculty. You’re likely to run into various\\nteachers here.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "schoolmap_2_11",
      "hash64": "F93002975C416083",
      "text": "Where students go if they’re under the weather—though\\nmany of them may just want to talk to Nurse Miriam.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "schoolmap_2_12",
      "hash64": "F93003975C416236",
      "text": "Sells items for your adventures, daily necessities, and more.\\nSomehow its bread is always fresh-baked.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "schoolmap_2_13",
      "hash64": "F93004975C4163E9",
      "text": "A room stocked with sparkly-clean tableware and kitchen\\ntools used for home economics class.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "schoolmap_2_14",
      "hash64": "F93005975C41659C",
      "text": "A room equipped with microscopes and many other tools\\nfor running experiments in biology class.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "schoolmap_2_15",
      "hash64": "F93006975C41674F",
      "text": "A room that proudly displays artwork made here by the\\nstudents taking art class.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "schoolmap_2_16",
      "hash64": "F93007975C416902",
      "text": "The kind ladies working in the cafeteria make delicious,\\nnutritious fare every day.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "schoolmap_2_17",
      "hash64": "F93008975C416AB5",
      "text": "A courtyard sometimes used for battle studies class. It’s a\\ncalming place suited to exercising or relaxing.",
