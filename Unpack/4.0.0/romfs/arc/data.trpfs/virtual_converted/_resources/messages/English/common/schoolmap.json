      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 56,
      "label": "schoolmap_5_5",
      "hash64": "565E5ABCA58C399D",
      "text": "The kind ladies working in the cafeteria make heaping\\nhelpings. There’s no way you’ll walk away hungry.",
