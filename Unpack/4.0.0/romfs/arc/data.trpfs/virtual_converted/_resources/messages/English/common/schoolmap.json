    {
      "ordinal": 55,
      "label": "schoolmap_5_4",
      "hash64": "565E59BCA58C37EA",
      "text": "Sells items for your adventures, daily necessities, and more.\\nOnly BP is accepted here, so make sure you’ve got some!",
