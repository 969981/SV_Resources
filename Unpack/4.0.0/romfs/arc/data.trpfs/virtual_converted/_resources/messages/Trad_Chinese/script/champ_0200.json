    },
    {
      "ordinal": 6,
      "label": "champ_0200_ground_06",
      "hash64": "31D7DF1AA830898E",
      "text": "來！切換一下心情，\\n往下一輪測驗去吧。[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
