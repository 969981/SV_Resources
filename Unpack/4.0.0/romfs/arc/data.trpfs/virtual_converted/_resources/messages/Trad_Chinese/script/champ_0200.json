      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0200_ground_07",
      "hash64": "31D7E01AA8308B41",
      "text": "第二輪測驗是\\n與四天王的寶可夢對戰……[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
