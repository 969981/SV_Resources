      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0200_ground_09",
      "hash64": "31D7DA1AA830810F",
      "text": "[VAR 0x1100(00FF,0101)]你妳可別吐槽說\\n這名字太～直白了喲。[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
