          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0200_ground_12",
      "hash64": "31DAE51AA832C997",
      "text": "실기 테스트에 도전할 준비가 되었으면\\n안쪽에 있는 방으로 들어가도록 해.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
