    {
      "ordinal": 2,
      "label": "champ_0200_ground_03",
      "hash64": "31D7E41AA830920D",
      "text": "축하해, [VAR 0x0100(0000)].[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
