    {
      "ordinal": 1,
      "label": "champ_0200_ground_02",
      "hash64": "31D7E31AA830905A",
      "text": "이걸로 질문은 모두 끝이야.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
