      ]
    },
    {
      "ordinal": 4,
      "label": "common_0270_head_teacher_04",
      "hash64": "F612FA86ADD63DD7",
      "text": "……有事的話，\\n隨時都可以找我商量喔。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
