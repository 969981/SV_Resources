{
  "version": "4.0.0",
  "language": "zh-Hant",
  "language_raw": "Trad_Chinese",
  "source": "message/dat/Trad_Chinese/script/sub_016.dat",
  "paired_tbl": "message/dat/Trad_Chinese/script/sub_016.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sub_016_system_kui_01",
      "hash64": "4C38F1CE9AE28A93",
      "text": "這裡埋著漆黑且\\n散發不祥氣息的樁柱……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sub_016_system_kui_02",
      "hash64": "4C38F2CE9AE28C46",
      "text": "要拔出樁柱嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_016_system_kui_03",
      "hash64": "4C38F3CE9AE28DF9",
      "text": "拔出樁柱後，\\n樁柱開始崩裂然後消失了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_016_system_kui_04",
      "hash64": "4C38F4CE9AE28FAC",
      "text": "咕……唏……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_016_system_kui_05",
      "hash64": "4C38F5CE9AE2915F",
      "text": "從祠堂的方向\\n傳來了謎樣的聲音……！？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_016_system_release_01",
      "hash64": "0D38A4AA29FEC449",
      "text": "從祠堂裡傳出了\\n微弱的聲響……！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_016_system_release_02",
      "hash64": "0D38A1AA29FEBF30",
      "text": "要觸摸祠堂嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_016_system_release_03",
      "hash64": "0D38A2AA29FEC0E3",
      "text": "喀噠喀噠喀噠喀噠……\\n嘎噠嘎噠……嘎噠嘎噠！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_016_system_release_07",
      "hash64": "0D38A6AA29FEC7AF",
      "text": "嘎噠～！！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sub_016_system_release_04",
      "hash64": "0D38A7AA29FEC962",
      "text": "咕嘰唏嚕嘶。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sub_016_system_release_05",
      "hash64": "0D38A8AA29FECB15",
      "text": "古簡蝸\\n再次被封印到祠堂中了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "sub_016_system_release_06",
      "hash64": "0D38A5AA29FEC5FC",
      "text": "祠堂的門看來\\n暫時不會打開了。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sub_016_system_hokora_01",
      "hash64": "5E2F0FED1EB3D91C",
      "text": "祠堂上刻著模糊的文字……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sub_016_system_hokora_02",
      "hash64": "5E2F12ED1EB3DE35",
      "text": "災禍之簡封印於此",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sub_016_system_hokora_03",
      "hash64": "5E2F11ED1EB3DC82",
      "text": "災禍之簡封印已解",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
