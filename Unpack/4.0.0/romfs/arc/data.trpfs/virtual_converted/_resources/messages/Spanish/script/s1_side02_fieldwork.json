    {
      "ordinal": 36,
      "label": "s1_side02_fieldwork_sazare_poke_02",
      "hash64": "AA2CC38F9F94CE29",
      "text": "Continuemos investigando. ¡Tengo toda mi fe\\npuesta en ti![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
