    {
      "ordinal": 29,
      "label": "s1_side02_fieldwork_sazare_pokehint_06",
      "hash64": "28306B55EE01844E",
      "text": "¡Has hecho un buen trabajo con este material!\\c\\nAh, por cierto, antes me he tropezado con algo\\nen una zona bastante rocosa. Ándate con ojo,\\r\\nno te vayas a caer tú también.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
