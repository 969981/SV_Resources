          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "s1_side02_fieldwork_sazare_pokehint_10",
      "hash64": "28337355EE03C7BD",
      "text": "¡Bien hecho, soci[VAR 0x1100(00FF,0101)]oa! Tu material tiene un encanto\\nespecial.\\c\\nPor cierto, antes he oído un ruido como de\\nun trueno procedente de la zona noreste...\\c\\n¿Se trataría de un Pokémon de tipo Eléctrico?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
