    {
      "ordinal": 32,
      "label": "s1_side02_fieldwork_sazare_pokehint_09",
      "hash64": "28306655EE017BCF",
      "text": "¡Logras capturar a los Pokémon de forma muy\\nnatural!\\c\\nDudo que tengas problemas con los que rondan\\npor las copas de los árboles en busca de comida.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
