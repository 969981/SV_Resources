    },
    {
      "ordinal": 30,
      "label": "s1_side02_fieldwork_sazare_pokehint_07",
      "hash64": "28306C55EE018601",
      "text": "Tú ya tienes experiencia sacando fotos, ¿no?\\c\\nUna cosilla: los Pokémon más cautelosos huirán\\nsi te acercas demasiado. Aunque, bueno, seguro\\r\\nque eso ya lo sabías, ¿verdad?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
