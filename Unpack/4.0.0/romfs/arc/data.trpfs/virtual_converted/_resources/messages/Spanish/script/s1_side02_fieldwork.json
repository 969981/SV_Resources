            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "s1_side02_fieldwork_sazare_camera_02",
      "hash64": "4080A467AF6F7AAF",
      "text": "¡Je, je! ¿Salgo bien? No saldré con una cara\\nmuy rara o algo, ¿no?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
