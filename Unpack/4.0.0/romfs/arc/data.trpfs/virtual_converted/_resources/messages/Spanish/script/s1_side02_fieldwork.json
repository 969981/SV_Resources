    },
    {
      "ordinal": 31,
      "label": "s1_side02_fieldwork_sazare_pokehint_08",
      "hash64": "28306555EE017A1C",
      "text": "¡Vamos a juntar fotos de Pokémon de lo más\\nvariados!\\c\\nLos Pokémon de tipo Fantasma se vuelven\\ninvisibles, así que tendrás que ser rápid[VAR 0x1100(00FF,0101)]oa\\r\\napretando el disparador.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
