    },
    {
      "ordinal": 42,
      "label": "s1_side02_fieldwork_sazare_pokemiss_05",
      "hash64": "F2ED798CBD3DE02C",
      "text": "Hmm... Vaya, por algún motivo, parece que el\\nPokéscopio no puede analizar bien esta foto.\\c\\n¿Quizá se deba a que el Pokémon se ha asustado\\ny está intentando huir?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
