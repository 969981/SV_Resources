          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "champ_0250_ground_10",
      "hash64": "89A08C74A5D69F3C",
      "text": "사천왕을 자신의 실력으로 그러모은\\n챔피언 랭크 최강의 트레이너지.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
