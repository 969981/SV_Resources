        }
      ]
    },
    {
      "ordinal": 15,
      "label": "champ_0250_steel_02",
      "hash64": "A9A7E68A84824449",
      "text": "팔자크 아저씨, 울지 마세요!\\n착하다~ 착하다~[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
