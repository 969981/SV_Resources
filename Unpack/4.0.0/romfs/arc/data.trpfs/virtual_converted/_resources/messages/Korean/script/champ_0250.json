          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "champ_0250_ground_09",
      "hash64": "89A41974A5D9C4AA",
      "text": "우리의 슈퍼 총대장...\\n최종 테스트의 시험관이\\r\\n안에서 기다리고 있을 거야.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
