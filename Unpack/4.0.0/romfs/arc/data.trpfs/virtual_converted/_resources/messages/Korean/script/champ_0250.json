      ]
    },
    {
      "ordinal": 18,
      "label": "champ_0250_ground_03",
      "hash64": "89A40F74A5D9B3AC",
      "text": "...대신 진행할게.\\n챔피언 테스트 제2시험\\r\\n실기 테스트는...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
