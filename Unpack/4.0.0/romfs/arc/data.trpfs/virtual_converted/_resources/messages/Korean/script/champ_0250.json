      "ordinal": 10,
      "label": "champ_0250_steel_01",
      "hash64": "A9A7E38A84823F30",
      "text": "우와아~!![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
