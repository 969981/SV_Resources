      "label": "champ_0250_dragon_09",
      "hash64": "6EE31AE937D8FE82",
      "text": "저... 너무 감격했습니다...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
