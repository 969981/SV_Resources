      "ordinal": 32,
      "label": "champ_0250_steel_04b",
      "hash64": "CA97F05F29600157",
      "text": "뽀삐,\\n오빠네 포켓몬 좋아해요![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
