      "ordinal": 23,
      "label": "champ_0250_ground_05",
      "hash64": "89A40D74A5D9B046",
      "text": "축하해![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
