          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "champ_0250_ground_11",
      "hash64": "89A08D74A5D6A0EF",
      "text": "뭐! 이 칠리 님을 이긴 너라면\\n문제없이 이길 테지만 말이야![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "champ_0250_ground_14",
      "hash64": "89A08874A5D69870",
      "text": "...서비스해 줄 테니까\\n지면 안 돼![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
