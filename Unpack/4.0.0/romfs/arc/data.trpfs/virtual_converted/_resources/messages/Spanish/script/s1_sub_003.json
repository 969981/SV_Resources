          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_003_man_01",
      "hash64": "F2AB8B2F8DFAEDE5",
      "text": "¡Qué idea tan estupendérrima, Enrica!\\c\\nEstaremos en el campo, ¡pero se nota que fluye\\nla sangre de urbanita por tus venas![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_003_woman_03",
      "hash64": "C9E4B45455269571",
      "text": "¡Ricardo! O sea, ¡gracias por decirme esa verdad\\ntan grande![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_003_man_02",
      "hash64": "F2AB882F8DFAE8CC",
      "text": "Ay, tanto dinero y tan poco tiempo...\\n¿En qué te apetece derrocharlo hoy?[VAR 0x0114(0040)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_003_woman_04",
      "hash64": "C9E4B55455269724",
      "text": "Déjame que piense...[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_003_woman_05",
      "hash64": "C9E4B654552698D7",
      "text": "Ay, Ricardo... ¡Est[VAR 0x1100(00FF,0101)]ea plebey[VAR 0x1100(00FF,0101)]oa nos está mirando![VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
