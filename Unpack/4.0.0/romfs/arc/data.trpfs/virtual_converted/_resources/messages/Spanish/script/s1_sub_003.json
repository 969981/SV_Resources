        },
        {
          "kind": "control",
          "offset_units": 79,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 92,
          "count": 3,
          "code_hex": "1100",
