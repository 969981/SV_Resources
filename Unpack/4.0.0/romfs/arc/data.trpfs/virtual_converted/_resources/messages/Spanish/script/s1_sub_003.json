        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_003_man_04",
      "hash64": "F2AB862F8DFAE566",
      "text": "¡Ay, es verdad! ¡Se ve a la legua que pertenece\\na un estrato social superbajo![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_003_woman_06",
      "hash64": "C9E4B75455269A8A",
      "text": "Un[VAR 0x1100(00FF,0100)]a plebey[VAR 0x1100(00FF,0101)]oa en vivo y en directo... ¡Ay, madre![VAR 0x0114(0041)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
