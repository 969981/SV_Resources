          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_003_woman_13",
      "hash64": "C9E834545529A4C8",
      "text": "¿Quieres desafiarme e intentar ganar una\\nsuperfortuna?[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_003_woman_14",
      "hash64": "C9E83B545529B0AD",
      "text": "Sentir cómo alguien inferior a ti logra sacarte de\\nquicio puede resultar hasta interesante a veces...\\c\\nPero mi tiempo es precioso, o sea, ¡te lo juro\\npor la cobertura de mi móvil! ¡Así que aligera![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 101,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 199,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_sub_003_woman_15",
      "hash64": "C9E83A545529AEFA",
      "text": "¡Yo, la presidenta de Inmobiliaria Paldea, contra\\nun[VAR 0x1100(00FF,0100)]a representante del pueblo raso!\\c\\n¡Y más raso quedará todavía con lo que voy\\na arrasar![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_sub_003_man_08",
      "hash64": "F2AB922F8DFAF9CA",
      "text": "¡Tú puedes, Enrica! ¡Fiu, fiuuu![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_003_woman_16",
      "hash64": "C9E839545529AD47",
      "text": "¡Soberbio! ¡Eres un[VAR 0x1100(00FF,0100)]a plebey[VAR 0x1100(00FF,0101)]oa fuera de lo común![VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_sub_003_man_09",
      "hash64": "F2AB932F8DFAFB7D",
      "text": "¡No te lo tomes a pecho, Enrica! ¡Aun cuando\\npierdes, estás divina![VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0040"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_sub_003_woman_17",
      "hash64": "C9E838545529AB94",
      "text": "¿Sabes una cosa, plebey[VAR 0x1100(00FF,0101)]oa? La clave del dinero\\nestá en saber gastarlo bien.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0041"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_sub_003_woman_18",
      "hash64": "C9E82F5455299C49",
      "text": "Quiero que inviertas esa recompensa en algo\\nde provecho... En algo que te facilite la vida.[VAR 0x0114(0041)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
