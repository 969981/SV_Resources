    {
      "ordinal": 7,
      "label": "s1_sub_003_man_03",
      "hash64": "F2AB892F8DFAEA7F",
      "text": "¿Eh? ¿Un[VAR 0x1100(00FF,0100)]a plebey[VAR 0x1100(00FF,0101)]oa?[VAR 0x0114(0040)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
