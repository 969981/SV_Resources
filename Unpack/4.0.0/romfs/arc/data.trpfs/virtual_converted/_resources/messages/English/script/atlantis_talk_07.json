      ]
    },
    {
      "ordinal": 4,
      "label": "atlantis_talk_07_botan_03",
      "hash64": "163D48759661A127",
      "text": "You need to go see a doctor! That’s just not right.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "atlantis_talk_07_friend_01",
      "hash64": "2BB341A24BD1FFA1",
      "text": "Say, I’m pretty sure that call was really—[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
