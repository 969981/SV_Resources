        }
      ]
    },
    {
      "ordinal": 2,
      "label": "atlantis_talk_07_botan_02",
      "hash64": "163D477596619F74",
      "text": "What? That got you...jazzed?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
