      ]
    },
    {
      "ordinal": 1,
      "label": "atlantis_talk_07_rival_01",
      "hash64": "3A8E3089D5001307",
      "text": "Maybe it was just a little dramatic flair to get us\\nall jazzed for more adventuring![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
