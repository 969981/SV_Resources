      ]
    },
    {
      "ordinal": 3,
      "label": "atlantis_talk_07_rival_02",
      "hash64": "3A8E3189D50014BA",
      "text": "Yeah! Maybe even big-time jazzed![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
