          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "atlantis_talk_07_friend_02",
      "hash64": "2BB33EA24BD1FA88",
      "text": "Uh...never mind. It’s nothing.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
