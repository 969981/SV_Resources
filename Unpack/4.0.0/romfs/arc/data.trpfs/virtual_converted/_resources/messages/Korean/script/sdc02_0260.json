    },
    {
      "ordinal": 9,
      "label": "sdc02_0260_sister_04",
      "hash64": "7F7F1A4AE087D1B4",
      "text": "어째서 이런 곳에 책상이!?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
