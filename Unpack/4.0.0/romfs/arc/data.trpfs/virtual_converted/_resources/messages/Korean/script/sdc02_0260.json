        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0260_sister_03",
      "hash64": "7F7F194AE087D001",
      "text": "이제 무슨 일이 일어나도\\n놀라지 않을 자신 있어.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
