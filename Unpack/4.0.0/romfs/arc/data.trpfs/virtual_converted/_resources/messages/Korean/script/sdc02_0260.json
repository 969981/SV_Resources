      "label": "sdc02_0260_bbteacher_07",
      "hash64": "292A8ECF8836FE71",
      "text": "그 유명한\\n투로박사의 리포트잖아!![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
