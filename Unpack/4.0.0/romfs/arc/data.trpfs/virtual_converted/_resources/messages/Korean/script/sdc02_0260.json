    },
    {
      "ordinal": 10,
      "label": "sdc02_0260_bbteacher_05",
      "hash64": "292A8CCF8836FB0B",
      "text": "오오... 이, 이건...[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
