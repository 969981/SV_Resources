          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0260_bbteacher_06",
      "hash64": "292A8DCF8836FCBE",
      "text": "그 유명한\\n올림박사의 리포트잖아!![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
