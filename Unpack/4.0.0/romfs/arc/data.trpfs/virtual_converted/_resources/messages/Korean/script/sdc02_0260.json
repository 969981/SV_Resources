      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0260_sister_02",
      "hash64": "7F7F184AE087CE4E",
      "text": "우와...\\n에리어 제로만으로도 충격이었는데...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
