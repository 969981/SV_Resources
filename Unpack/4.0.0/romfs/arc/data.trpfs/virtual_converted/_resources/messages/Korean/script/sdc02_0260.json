    },
    {
      "ordinal": 6,
      "label": "sdc02_0260_brother_01",
      "hash64": "1FFE0C97D064BFF7",
      "text": "저, 저기...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
