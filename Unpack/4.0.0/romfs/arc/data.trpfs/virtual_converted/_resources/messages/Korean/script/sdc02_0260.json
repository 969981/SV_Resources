            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0260_book_02b",
      "hash64": "0CB095AF237E9A25",
      "text": "테라파고스의 영향인지\\n대공동 내부에는 지상에서 본 적 없는\\n테라스탈 현상이 일어나고 있다.\\n모든 타입이 깃든 테라스탈...\\n필자는 그러한 테라스탈타입을 임시로\\n[VAR 0xFF00(0006)]스텔라[VAR 0xFF00(0000)]라고 칭하고자 한다.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
