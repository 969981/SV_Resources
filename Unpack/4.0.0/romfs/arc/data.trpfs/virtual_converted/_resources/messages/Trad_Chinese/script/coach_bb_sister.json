    {
      "ordinal": 2,
      "label": "coach_bb_sister_sp01_00",
      "hash64": "40971F3BE7B5C349",
      "text": "[VAR 0x1100(00FF,0101)]你妳竟然會來跟我問好，\\n看來是變機靈了？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
