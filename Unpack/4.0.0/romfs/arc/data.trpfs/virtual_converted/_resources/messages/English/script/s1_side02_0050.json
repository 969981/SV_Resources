          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "s1_side02_0050_camera_30",
      "hash64": "37056E7640AB2EE1",
      "text": "I couldn’t have done this without you, partner.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "s1_side02_0050_camera_31",
      "hash64": "37056D7640AB2D2E",
      "text": "Because of you, I finally feel like I have some\\nphotos here that I want to keep forever...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "s1_side02_0050_camera_32",
      "hash64": "37056C7640AB2B7B",
      "text": "It’s been ages since I’ve felt this way. Seriously.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "s1_side02_0050_camera_33",
      "hash64": "37056B7640AB29C8",
      "text": "And now that I’m all motivated, it’s time to ride\\nthis feeling and seize the day!\\c\\nI’m heading back to the village this instant to get\\nthese photos developed![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
