  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "gym_mizu_010_mizu_01",
      "hash64": "C38DF125E6D2FF90",
      "text": "Oh là là... !\\nVite, vite ! Je suis en retard ![VAR 0x0114(002C)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "gym_mizu_010_receptionist_01",
      "hash64": "7C6C59D62A6DB258",
      "text": "M... Monsieur Kombu !\\nAttendez, s’il vous plaît !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "gym_mizu_010_receptionist_02",
      "hash64": "7C6C5CD62A6DB771",
      "text": "Oh... Il est déjà parti...\\nQuel étourdi, il a oublié quelque chose...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_mizu_010_receptionist_03",
      "hash64": "7C6C5BD62A6DB5BE",
      "text": "Seriez-vous ici pour essayer de relever le défi\\nde l’Arène ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_mizu_010_select_01",
      "hash64": "D3677BC9BEA50865",
      "text": "Oui !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_mizu_010_select_02",
      "hash64": "D36778C9BEA5034C",
      "text": "Hum...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "gym_mizu_010_receptionist_04a",
      "hash64": "D9DFDBEA18744342",
      "text": "Je le savais !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "gym_mizu_010_receptionist_04b",
      "hash64": "D9DFDAEA1874418F",
      "text": "Vous avez beau hésiter, je sens bien que\\nvous voulez vous mesurer à l’Arène !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_mizu_010_receptionist_05",
      "hash64": "7C6C5DD62A6DB924",
      "text": "Figurez-vous que le grand gaillard que vous avez\\nvu sortir en trombe est notre Champion, Kombu.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_mizu_010_receptionist_06",
      "hash64": "7C6C60D62A6DBE3D",
      "text": "Il est plutôt du genre impulsif, et il a oublié son\\nportefeuille alors qu’il se rendait au marché.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_mizu_010_receptionist_07",
      "hash64": "7C6C5FD62A6DBC8A",
      "text": "Il sera bien embêté sans lui, quand il sera arrivé\\nà destination...\\c\\nPuisque vous avez l’air si sympathique,\\npourriez-vous lui rapporter son portefeuille ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_mizu_010_receptionist_08a",
      "hash64": "D9B6D3EA18513096",
      "text": "Merci beaucoup ! Vous êtes si gentil[VAR 0x1100(00FF,0200)]le que j’ai\\nenvie de vous donner le Badge tout de suite !",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0200"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "gym_mizu_010_receptionist_08b",
      "hash64": "D9B6D2EA18512EE3",
      "text": "Pardonnez-moi, mais vous ne pourrez pas défier\\nle Champion de l’Arène s’il n’est pas là.\\c\\nEt comme vous pouvez l’imaginer, je ne peux\\npas quitter mon poste...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_mizu_010_receptionist_09",
      "hash64": "7C6C51D62A6DA4C0",
      "text": "Je vous confie donc son portefeuille.\\nJe compte sur vous !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_mizu_010_receptionist_10",
      "hash64": "7C6954D62A6B7402",
      "text": "Exceptionnellement, je validerai votre examen\\nd’Arène si vous le rapportez à Kombu !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_mizu_010_receptionist_11",
      "hash64": "7C6955D62A6B75B5",
      "text": "Il s’est dirigé vers [VAR 0xFF00(0006)]Porto Marinada[VAR 0xFF00(0000)], de l’autre\\ncôté du désert situé à l’ouest.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_mizu_010_receptionist_12",
      "hash64": "7C6952D62A6B709C",
      "text": "Faites bien attention, car le désert est peuplé\\nde Pokémon particulièrement féroces !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
