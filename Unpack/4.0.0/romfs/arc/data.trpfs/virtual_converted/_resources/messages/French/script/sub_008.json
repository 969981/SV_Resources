    {
      "ordinal": 1,
      "label": "sub_008_master_02",
      "hash64": "800BD54176DAD3D0",
      "text": "Veux-tu soumettre un Pokémon de ton équipe\\nà l’Entraînement Ultime ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "sub_008_master_03",
      "hash64": "800BD64176DAD583",
      "text": "Et donc, quel Pokémon souhaites-tu me confier ?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_008_master_cancel",
      "hash64": "A65424BE9F55C27C",
      "text": "Aucun souci, j’attendrai ton retour.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_008_master_04",
      "hash64": "800BDB4176DADE02",
      "text": "Comment ? Tu n’as ni Capsules d’Or\\nni Capsules d’Argent... ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_008_master_05",
      "hash64": "800BDC4176DADFB5",
      "text": "Fais-moi confiance. Seuls les Pokémon ayant\\natteint au moins le niveau 50 sont capables\\r\\nde supporter mon Entraînement Ultime.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
