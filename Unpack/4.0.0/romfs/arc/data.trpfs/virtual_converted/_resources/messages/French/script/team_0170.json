      ]
    },
    {
      "ordinal": 2,
      "label": "team_0170_head_teacher_03",
      "hash64": "F79DDF08E752CBF7",
      "text": "Sans vous, j’aurais certainement infligé\\nune sanction injuste à ces élèves.[VAR 0x0114(000A)]",
      "flags": 0,
