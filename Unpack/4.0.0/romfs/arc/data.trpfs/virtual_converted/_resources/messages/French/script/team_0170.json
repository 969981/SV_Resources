    {
      "ordinal": 7,
      "label": "team_0170_head_teacher_06",
      "hash64": "F79DDA08E752C378",
      "text": "Entrez, je vous en prie.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
