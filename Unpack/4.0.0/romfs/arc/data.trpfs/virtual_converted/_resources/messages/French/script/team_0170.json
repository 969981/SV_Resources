    {
      "ordinal": 1,
      "label": "team_0170_head_teacher_02",
      "hash64": "F79DDE08E752CA44",
      "text": "Je souhaite vous remercier pour toute votre aide\\nconcernant l’affaire Team Star.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
