    },
    {
      "ordinal": 8,
      "label": "team_0170_botan_00",
      "hash64": "3F6F3F75BFB9FBAD",
      "text": "...\\nMonsieur le proviseur...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
