    },
    {
      "ordinal": 9,
      "label": "team_0170_botan_02",
      "hash64": "3F6F3D75BFB9F847",
      "text": "C’est à propos des CES...\\nJ’aimerais vraiment... euh...\\r\\n... y participer avec les autres...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
