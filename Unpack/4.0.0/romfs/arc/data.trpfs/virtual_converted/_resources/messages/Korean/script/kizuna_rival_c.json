      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_rival_c_04",
      "hash64": "05FBEDD5E6CC85C1",
      "text": "입구 홀에서 다시 만나서\\n승부하자고 했더니, 안 하겠다는 거 있지![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
