        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_rival_c_select_01",
      "hash64": "AA608DC26FF612D9",
      "text": "져도 즐거워",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_rival_c_select_02",
      "hash64": "AA608AC26FF60DC0",
      "text": "그래도 이기는 게 좋잖아",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "kizuna_rival_c_07a",
      "hash64": "F790D2772D7ED58B",
      "text": "너도 그렇지!? 패배에서도\\n얻을 수 있는 게 있잖아!\\r\\n...물론, 분하긴 하지만![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
