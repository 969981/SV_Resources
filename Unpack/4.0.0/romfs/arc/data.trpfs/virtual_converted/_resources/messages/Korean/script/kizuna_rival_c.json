          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_rival_c_06",
      "hash64": "05FBEBD5E6CC825B",
      "text": "포켓몬 승부는\\n져도 즐거운 거 아니야!?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
