      "ordinal": 12,
      "label": "kizuna_rival_c_10",
      "hash64": "05F86BD5E6C97304",
      "text": "그리고 나,\\n볼도 잘 못 던지기도 하고...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
