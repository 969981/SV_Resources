          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "common_0185_friend_12",
      "hash64": "E04ACCB2BFBFA620",
      "text": "哼！就让我来测试一下\\n你够不够格来照顾[VAR 0x0101(0001)]吧！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
