          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0185_friend_15",
      "hash64": "E04AD3B2BFBFB205",
      "text": "[VAR 0x0101(0001)]可不是\\n一般的训练家\\r\\n能驾驭得了的宝可梦。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
