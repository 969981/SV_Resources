          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "common_0185_friend_14",
      "hash64": "E04AD2B2BFBFB052",
      "text": "……你还真是不走运啊。\\n如果你没有打赢我的实力，\\r\\n你的前景会很令人担忧哦。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
