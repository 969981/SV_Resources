      "ordinal": 25,
      "label": "common_0185_friend_18",
      "hash64": "E04AD6B2BFBFB71E",
      "text": "这郁闷的心情……\\n我要把它抛到脑后！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "common_0185_rival_14",
      "hash64": "0987EB400C64BC1E",
      "text": "[VAR 0x0100(0000)]，干得漂亮！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
