          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0185_friend_02",
      "hash64": "E04E56B2BFC2C675",
      "text": "我说的不是你们。[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0185_rival_01",
      "hash64": "098B54400C67A460",
      "text": "我记得你是\\n文科班的……派帕？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
