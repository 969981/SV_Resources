    {
      "ordinal": 1,
      "label": "common_0185_friend_01",
      "hash64": "E04E53B2BFC2C15C",
      "text": "怎么会在这里！？[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
