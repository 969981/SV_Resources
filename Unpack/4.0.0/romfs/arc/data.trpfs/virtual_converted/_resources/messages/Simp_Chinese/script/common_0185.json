      ]
    },
    {
      "ordinal": 21,
      "label": "common_0185_rival_16",
      "hash64": "0987E9400C64B8B8",
      "text": "那它是什么样的宝可梦？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
