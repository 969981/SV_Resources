    {
      "ordinal": 19,
      "label": "class_g_02_home_14",
      "hash64": "897DDA0884E34246",
      "text": "A differenza degli strumenti acquistabili nei\\nnegozi, se date una bacca a un Pokémon, questo\\r\\npuò decidere autonomamente quando mangiarla\\r\\ndurante la lotta.[VAR 0x0114(0029)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 1,
