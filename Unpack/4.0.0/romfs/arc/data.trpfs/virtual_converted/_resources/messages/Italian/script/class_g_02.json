        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_g_02_home_16",
      "hash64": "897DD80884E33EE0",
      "text": "Comunque, mi raccomando, quando non sapete\\ncome rimettere in sesto un Pokémon, cercate\\r\\nqualcosa che luccica nei dintorni.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
