      ]
    },
    {
      "ordinal": 6,
      "label": "class_g_02_home_07",
      "hash64": "8981690884E66B1A",
      "text": "Le Pozioni fanno recuperare 20 PS, le\\nSuperpozioni 60 e le Iperpozioni 120.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
