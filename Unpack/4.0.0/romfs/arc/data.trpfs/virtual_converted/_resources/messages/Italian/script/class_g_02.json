          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_g_02_home_12",
      "hash64": "897DDC0884E345AC",
      "text": "Se nei dintorni vedete qualcosa che luccica,\\nè un oggetto caduto che potete raccogliere!\\c\\nPotreste trovare degli strumenti curativi, come\\nad esempio una Pozione o una Baccarancia.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 181,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_g_02_home_13",
      "hash64": "897DDD0884E3475F",
      "text": "Potete premere il [VAR 0xFF00(0006)]pulsante R per mandare[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]un Pokémon[VAR 0xFF00(0000)] a raccoglierlo![VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
