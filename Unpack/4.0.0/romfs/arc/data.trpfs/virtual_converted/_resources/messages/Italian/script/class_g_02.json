    {
      "ordinal": 20,
      "label": "class_g_02_home_15",
      "hash64": "897DDB0884E343F9",
      "text": "Può essere interessante lasciare al Pokémon\\nla libertà di scegliere quando usarla.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
