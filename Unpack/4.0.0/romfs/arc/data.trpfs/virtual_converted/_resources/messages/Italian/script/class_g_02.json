          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_g_02_home_answer_02",
      "hash64": "824B9B2A383E0AB8",
      "text": "Certo, un insegnante nelle vicinanze potrebbe\\nesservi d’aiuto...\\c\\nPerò non dovete dare per scontato che ci sia\\nsempre un adulto pronto ad aiutarvi.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
