    {
      "ordinal": 14,
      "label": "class_g_02_home_answer_01",
      "hash64": "824B9E2A383E0FD1",
      "text": "Come ho appena detto, se non avete ingredienti\\nnon potete cucinare, quindi la presenza\\r\\ndi un laghetto non vi aiuterà.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
