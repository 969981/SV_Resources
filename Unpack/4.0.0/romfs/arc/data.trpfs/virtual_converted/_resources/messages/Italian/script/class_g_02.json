          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_g_02_home_answer_03",
      "hash64": "824B9C2A383E0C6B",
      "text": "Risposta impeccabile. Vedo che te ne intendi\\ndi tecniche di sopravvivenza.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
