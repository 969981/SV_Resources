          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_g_02_home_04",
      "hash64": "8981680884E66967",
      "text": "C’è anche da dire che non sono l’ideale durante\\nla lotta, in cui non è possibile cucinare, o se\\r\\nsi è di fretta.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
