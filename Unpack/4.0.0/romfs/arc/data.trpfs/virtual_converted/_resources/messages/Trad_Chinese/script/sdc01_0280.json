      "hash64": "9A47009BB4E2CD15",
      "text": "今天要休息了嗎？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
