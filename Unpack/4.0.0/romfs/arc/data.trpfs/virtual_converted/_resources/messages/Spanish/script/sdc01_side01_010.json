      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_side01_010_brother_04",
      "hash64": "F2613FE6987F45BF",
      "text": "Bueno, ya que estamos, ¿le echamos un vistazo?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
