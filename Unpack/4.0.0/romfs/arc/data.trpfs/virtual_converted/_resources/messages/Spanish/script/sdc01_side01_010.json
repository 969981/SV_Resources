      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc01_side01_010_brother_07",
      "hash64": "F26140E6987F4772",
      "text": "[VAR 0xBD06(0000)]¡Ofú! ¡Sabía que tú me entenderías,\\n[VAR 0x0100(0000)]!\\c\\nFíjate que el tío les plantó cara a los tres a\\nla vez, él solito... ¡Eso sí que es tener valor![VAR 0x0114(0043)]",
