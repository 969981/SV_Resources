    {
      "ordinal": 2,
      "label": "sdc01_side01_010_brother_03",
      "hash64": "F2613CE6987F40A6",
      "text": "Yo... ya te había dicho que nos veríamos aquí...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
