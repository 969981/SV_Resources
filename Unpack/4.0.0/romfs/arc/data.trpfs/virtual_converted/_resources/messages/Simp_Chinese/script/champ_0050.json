      "hash64": "9B3A1829F7E00806",
      "text": "洛托洛托洛托洛托……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "champ_0050_rival_01",
      "hash64": "9736C1AB06669A57",
      "text": "喂喂，[VAR 0x0100(0000)]？\\n是我，是我！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
