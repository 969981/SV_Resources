{
  "version": "4.0.0",
  "language": "zh-Hans",
  "language_raw": "Simp_Chinese",
  "source": "message/dat/Simp_Chinese/script/t08.dat",
  "paired_tbl": "message/dat/Simp_Chinese/script/t08.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "t08_01",
      "hash64": "55B19358443CF0E7",
      "text": "冰柜镇是\\n白雪与镇魂的城镇！\\r\\n最近演出会场也很有名哦。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "t08_02",
      "hash64": "55B19458443CF29A",
      "text": "雪花飘飘！\\n烛光摇摇！\\c\\n每天都像过节一样吧？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "t08_06",
      "hash64": "55B19058443CEBCE",
      "text": "现在流行的是雪山速滑！\\n在霜抹山可以尝试挑战哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "t08_08",
      "hash64": "55B18A58443CE19C",
      "text": "雪童子很可爱吧？\\n只有雌性的雪童子\\r\\n才有可能进化成雪妖女。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "t08_20",
      "hash64": "55B7FE5844421266",
      "text": "今天也好冷啊……\\n吃些辣的东西暖暖身子吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "t08_22",
      "hash64": "55B7FC5844420F00",
      "text": "你知道究极的三明治是什么吗？\\n名字里有“大师”二字，\\r\\n至于食谱则一概不详……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "t08_23",
      "hash64": "55B7FD58444210B3",
      "text": "在外面吃，\\n感觉比平时更好吃～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "t08_26",
      "hash64": "55B80058444215CC",
      "text": "１年半前，\\n道馆馆主泰姆引退后，\\r\\n她的妹妹莱姆接了她的班。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "t08_28",
      "hash64": "55B8065844421FFE",
      "text": "你去现场听过莱姆的演唱会吗？\\n她会让你的灵魂颤抖的！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "t08_29",
      "hash64": "55B80758444221B1",
      "text": "在道馆测验时，紫色的舞台会发光，\\n漂亮极了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
