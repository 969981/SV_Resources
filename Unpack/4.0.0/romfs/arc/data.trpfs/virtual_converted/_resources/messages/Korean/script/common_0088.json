      ]
    },
    {
      "ordinal": 5,
      "label": "common_0088_rival_05",
      "hash64": "58658ECA2580E6C0",
      "text": "교장 선생님!\\n저도 한 마리 골라도 돼요?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
