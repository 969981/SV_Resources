    {
      "ordinal": 20,
      "label": "common_0088_head_teacher_03",
      "hash64": "84EF37F70151DCA7",
      "text": "네모 양은 포켓몬 승부를\\n지나칠 정도로 좋아한단 말이죠.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
