      ]
    },
    {
      "ordinal": 21,
      "label": "common_0088_head_teacher_04",
      "hash64": "84EF34F70151D78E",
      "text": "포켓몬과 유대를 다질 수 있으니\\n승부해 보시는 건 어떠신지요.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
