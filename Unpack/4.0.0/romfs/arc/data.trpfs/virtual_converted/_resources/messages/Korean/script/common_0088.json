      ]
    },
    {
      "ordinal": 6,
      "label": "common_0088_head_teacher_07",
      "hash64": "84EF33F70151D5DB",
      "text": "어라? 네모 양은\\n입학할 때 포켓몬을...\\r\\n받지 않았었나요?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
