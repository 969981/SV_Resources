    {
      "ordinal": 18,
      "label": "common_0088_rival_03",
      "hash64": "586594CA2580F0F2",
      "text": "포켓몬도 정했으니까\\n빨리 나랑 승부하자![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
