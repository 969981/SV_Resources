        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0088_rival_06",
      "hash64": "586591CA2580EBD9",
      "text": "네! 그때는 따로\\n키우고 싶은 포켓몬이 있었거든요![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
