    {
      "ordinal": 9,
      "label": "common_0088_head_teacher_08",
      "hash64": "84EF30F70151D0C2",
      "text": "정말이지, 훌륭한 마음가짐이군요.[VAR 0x0114(000A)]",
      "flags": 0,
