          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_1150_rival_02",
      "hash64": "CFFCC461516047E0",
      "text": "的確，如果是在海灣洞穴時的\\n[VAR 0x0101(0001)]，那就太可靠了！\\r\\n我想看牠那勇猛的戰鬥！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
