        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_1150_friend_03",
      "hash64": "3AC2B2431CDDDAC9",
      "text": "那傢伙其實是很強的。\\c\\n牠還吃了秘傳調味料，\\n遇上關鍵時刻牠就會戰鬥了！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
