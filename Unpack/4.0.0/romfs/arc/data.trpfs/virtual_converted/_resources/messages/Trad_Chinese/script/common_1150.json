    {
      "ordinal": 4,
      "label": "common_1150_rival_01",
      "hash64": "CFFCC76151604CF9",
      "text": "呃～什麼？\\n事情正要精彩呢……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
