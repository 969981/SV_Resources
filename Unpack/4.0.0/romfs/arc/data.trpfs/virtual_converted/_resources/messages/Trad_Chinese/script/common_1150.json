          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_1150_friend_02",
      "hash64": "3AC2B1431CDDD916",
      "text": "如果會有嚇人的寶可夢跑出來，\\n讓[VAR 0x0101(0001)]也在場，\\r\\n會不會比較好？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
