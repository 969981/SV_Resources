          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_1150_friend_04",
      "hash64": "3AC2B3431CDDDC7C",
      "text": "而且，第零區是那傢伙\\n生活了一陣子的地方……\\c\\n把牠從球放出來的話，\\n說不定牠的家族會來找到牠？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
