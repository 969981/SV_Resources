    },
    {
      "ordinal": 7,
      "label": "common_1150_botan_01",
      "hash64": "9CE68E3B0CAF32D3",
      "text": "呃～可是……\\n自從來到第零區後，\\r\\n牠就不喜歡讓人騎……\\r\\n而且牠不是沒辦法變成對戰形態嗎？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
