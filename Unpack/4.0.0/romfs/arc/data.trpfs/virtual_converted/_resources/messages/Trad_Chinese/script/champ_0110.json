      "ordinal": 16,
      "label": "champ_0110_chairman_07",
      "hash64": "8710316AB703E5D1",
      "text": "真是一場出色的對戰。\\n我看得很盡興。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
