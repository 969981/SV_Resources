      "hash64": "8713B76AB706FF5A",
      "text": "我送[VAR 0x1100(00FF,0101)]你妳回到剛才的道館。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
