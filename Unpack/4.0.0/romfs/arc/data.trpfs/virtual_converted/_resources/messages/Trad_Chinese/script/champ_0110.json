      "ordinal": 15,
      "label": "champ_0110_chairman_06",
      "hash64": "8710306AB703E41E",
      "text": "與冠軍妮莫交手，\\n卻能有這樣的表現……[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
