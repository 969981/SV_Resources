      "label": "champ_0110_rival_18",
      "hash64": "ABD6044A1347964C",
      "text": "我會更加更～加努力的～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
