      "text": "剩下的道館[VAR 0x1100(00FF,0101)]你妳也絕～對沒問題的！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
