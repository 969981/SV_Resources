          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0110_chairman_03",
      "hash64": "8710356AB703EC9D",
      "text": "寶可夢聯盟……是具有最強稱號的訓練家，\\n也就是冠軍級的訓練家\\r\\n全新誕生的地方……[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0110_rival_03",
      "hash64": "ABD98F4A134AB854",
      "text": "只要收集到８個道館徽章，\\n就有資格參加測驗……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0110_rival_04",
      "hash64": "ABD98E4A134AB6A1",
      "text": "與最強的考官對戰而且獲勝的話，\\n就能成為冠軍了喔！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0110_rival_19",
      "hash64": "ABD6054A134797FF",
      "text": "想像一下到時候的心情，\\n然後現在就來模擬訓練吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0110_rival_05",
      "hash64": "ABD98D4A134AB4EE",
      "text": "目標是最高峰的舞台，\\n讓我們一決勝……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0110_chairman_04",
      "hash64": "87102E6AB703E0B8",
      "text": "嗯？請稍候。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0110_chairman_05",
      "hash64": "87102F6AB703E26B",
      "text": "[VAR 0x0100(0000)]的寶可夢\\n看起來有點疲憊呢。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
