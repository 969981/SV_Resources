      "label": "champ_0110_rival_12",
      "hash64": "ABD60E4A1347A74A",
      "text": "在首席的面前對戰，\\n讓[VAR 0x1100(00FF,0101)]你妳有點緊張嗎？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 3,
