          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0110_rival_06",
      "hash64": "ABD98C4A134AB33B",
      "text": "對不起～！我一心想要快點開打，\\n沒有顧慮到這點……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0110_rival_07",
      "hash64": "ABD98B4A134AB188",
      "text": "多虧了首席，\\n現在一切就緒囉！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
