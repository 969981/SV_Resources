          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "champ_0110_rival_10",
      "hash64": "ABD60C4A1347A3E4",
      "text": "連首席都認同的潛力！\\n[VAR 0x1100(00FF,0101)]你妳太厲害了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
