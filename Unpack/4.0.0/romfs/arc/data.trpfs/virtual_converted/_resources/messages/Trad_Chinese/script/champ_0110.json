      "ordinal": 24,
      "label": "champ_0110_chairman_08",
      "hash64": "87102A6AB703D9EC",
      "text": "我也這麼認為。\\n這是我對未來的投資，\\r\\n請[VAR 0x1100(00FF,0101)]你妳收下吧。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
