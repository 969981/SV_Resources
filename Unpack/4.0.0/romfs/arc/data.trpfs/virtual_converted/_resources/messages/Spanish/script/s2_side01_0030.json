        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0030_botan_03",
      "hash64": "BAE398BD743CDC5C",
      "text": "¿De qué te ríes? ¡Ya no soy una niña!\\n¡Y deja de llamarlo \"tour aventuroso\", por favor![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0030_botan_04",
      "hash64": "BAE397BD743CDAA9",
      "text": "No hay quien lo aguante...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
