        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side01_0030_botan_06",
      "hash64": "BAE395BD743CD743",
      "text": "Ya, también es verdad...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
