    },
    {
      "ordinal": 3,
      "label": "s2_side01_0030_botan_02",
      "hash64": "BAE399BD743CDE0F",
      "text": "¡Que síii, no te preocupes![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
