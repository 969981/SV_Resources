        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0030_friend_02",
      "hash64": "3A1086D73EFC2451",
      "text": "Entonces, ¿te ha dado permiso tu papaíto?[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0030_botan_05",
      "hash64": "BAE396BD743CD8F6",
      "text": "Sí, pero he tenido suficiente charla paternal\\npara un mes.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0030_friend_03",
      "hash64": "3A1085D73EFC229E",
      "text": "¡Mejor mucha que poca![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
