  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_history_d_01",
      "hash64": "66311DE071DD1781",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)] ! Alors, t’as trouvé les trésors\\ndu fléau ?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
