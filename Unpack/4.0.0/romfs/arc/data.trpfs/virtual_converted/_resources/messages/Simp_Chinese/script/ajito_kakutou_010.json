    {
      "ordinal": 17,
      "label": "ajito_kakutou_010_kakutouboss_06",
      "hash64": "4B28827826B0D7FE",
      "text": "放心，我没事……！\\n田中，你快到安全的地方去！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
