    {
      "ordinal": 2,
      "label": "ajito_kakutou_010_nelke_01",
      "hash64": "94C02C31DE6427F9",
      "text": "彼此彼此……\\n你叫枇琶，没错吧？\\r\\n你的招式真是千锤百炼。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
