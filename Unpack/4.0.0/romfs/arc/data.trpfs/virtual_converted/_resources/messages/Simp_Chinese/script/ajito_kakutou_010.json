    },
    {
      "ordinal": 3,
      "label": "ajito_kakutou_010_nelke_02",
      "hash64": "94C02931DE6422E0",
      "text": "不过，想不到老大\\n会亲自来看门……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
