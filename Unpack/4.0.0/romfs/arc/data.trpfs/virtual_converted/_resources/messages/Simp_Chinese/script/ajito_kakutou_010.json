          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_kakutou_010_kakutouboss_08",
      "hash64": "4B287C7826B0CDCC",
      "text": "在真老大回来之前……\\n我要保护格斗帮班王良一小队……\\r\\n保护天星队才行……[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
