    },
    {
      "ordinal": 11,
      "label": "ajito_kakutou_010_nelke_06",
      "hash64": "94C02D31DE6429AC",
      "text": "这里有个像是队员的学生，\\n所以我和她搭了下话……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
