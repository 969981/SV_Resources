          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "ajito_kakutou_010_kakutouboss_12",
      "hash64": "4B2C087826B3F187",
      "text": "今……今天星苦了～！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
