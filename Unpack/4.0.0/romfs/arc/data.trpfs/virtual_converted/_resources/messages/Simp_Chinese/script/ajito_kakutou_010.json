      "ordinal": 19,
      "label": "ajito_kakutou_010_kakutouboss_07",
      "hash64": "4B28837826B0D9B1",
      "text": "……我不撤……我不能撤！[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
