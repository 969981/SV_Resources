      "ordinal": 18,
      "label": "ajito_kakutou_010_sitappa_02",
      "hash64": "4178C0401BDFB1D3",
      "text": "这里交给我了！\\n枇琶你快回基地吧！[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
