      "ordinal": 20,
      "label": "ajito_kakutou_010_sitappa_03",
      "hash64": "4178BF401BDFB020",
      "text": "枇琶！\\n到此为止吧！[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
