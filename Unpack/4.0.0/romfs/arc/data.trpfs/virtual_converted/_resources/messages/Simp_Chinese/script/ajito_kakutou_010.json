      "ordinal": 32,
      "label": "ajito_kakutou_010_sitappa_09",
      "hash64": "4178C9401BDFC11E",
      "text": "接下来让我来对付你们！\\n两个人一起放马过来吧！[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
