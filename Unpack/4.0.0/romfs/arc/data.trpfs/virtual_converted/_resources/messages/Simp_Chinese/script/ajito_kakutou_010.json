      "ordinal": 22,
      "label": "ajito_kakutou_010_sitappa_04",
      "hash64": "4178C6401BDFBC05",
      "text": "那你更应该回去\\n稍微休息一下了！[VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
