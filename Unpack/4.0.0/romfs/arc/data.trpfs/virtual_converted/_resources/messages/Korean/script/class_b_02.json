      ]
    },
    {
      "ordinal": 13,
      "label": "class_b_02_math_answer_03",
      "hash64": "17CDFB682443B829",
      "text": "참 잘했어요!\\n역시 [VAR 0x0100(0000)][VAR 0x1900(0006)]구나![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
