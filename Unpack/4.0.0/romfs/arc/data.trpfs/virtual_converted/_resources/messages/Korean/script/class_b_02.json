    },
    {
      "ordinal": 12,
      "label": "class_b_02_math_answer_02",
      "hash64": "17CDFA682443B676",
      "text": "[VAR 0x0100(0000)]한테 조금 미안한걸?\\n선생님이 조금 짓궂었나?[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
