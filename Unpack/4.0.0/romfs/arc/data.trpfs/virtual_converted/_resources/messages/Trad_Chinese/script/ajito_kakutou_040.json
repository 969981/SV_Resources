          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "ajito_kakutou_040_waza_01",
      "hash64": "12E1133143212C92",
      "text": "這個招式就像是我的信念一樣，\\n也希望[VAR 0x1100(00FF,0101)]你妳能好好運用。[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
