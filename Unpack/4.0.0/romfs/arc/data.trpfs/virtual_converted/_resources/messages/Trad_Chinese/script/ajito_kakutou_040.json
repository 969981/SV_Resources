      "ordinal": 30,
      "label": "ajito_kakutou_040_nelke_01",
      "hash64": "5C186440FEE613BA",
      "text": "……看來結束了啊，[VAR 0x0100(0000)]。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
