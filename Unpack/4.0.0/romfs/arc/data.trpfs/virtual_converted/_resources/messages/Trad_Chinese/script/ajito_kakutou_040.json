          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "ajito_kakutou_040_kakutouboss_11",
      "hash64": "8A481F2B26434C71",
      "text": "……………………\\n……………………[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
