    {
      "ordinal": 34,
      "label": "s2_sub_010_head_11",
      "hash64": "15B2F8B8135AB905",
      "text": "Monsieur Cyano ?\\nM’entendez-vous... ?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
