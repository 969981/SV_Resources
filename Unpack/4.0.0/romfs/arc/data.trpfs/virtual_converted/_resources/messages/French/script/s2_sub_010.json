      ]
    },
    {
      "ordinal": 40,
      "label": "s2_sub_010_headbb_23",
      "hash64": "11213B69A27F0044",
      "text": "Bonjour, [VAR 0x0100(0000)] !\\nDécidément... il pleut encore...\\c\\nJ’ai songé à faire poser une toiture au-dessus\\nde l’entrée, mais j’ai finalement abandonné\\r\\nl’idée, car il y a des Pokémon qui aiment l’eau ![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
