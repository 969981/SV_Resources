      ]
    },
    {
      "ordinal": 41,
      "label": "s2_sub_010_headbb_24",
      "hash64": "11213A69A27EFE91",
      "text": "Quel dommage ! Ce soir, on ne verra pas\\nle soleil couchant...\\c\\nMais j’irai peut-être admirer celui du ciel\\nartificiel du Terra-Dôme, à la place...[VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
