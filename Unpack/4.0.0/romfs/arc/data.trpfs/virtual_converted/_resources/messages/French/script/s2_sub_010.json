      ]
    },
    {
      "ordinal": 37,
      "label": "s2_sub_010_headbb_20",
      "hash64": "11213E69A27F055D",
      "text": "Cet endroit est parfait pour admirer le soleil\\ncouchant. N’ai-je pas raison ?\\c\\nRien que pour ça, je ne regrette pas d’avoir fait\\nbâtir cet institut au milieu de l’océan ![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
