    {
      "ordinal": 36,
      "label": "s2_sub_010_headbb_19",
      "hash64": "1124AD69A281F7D1",
      "text": "Bonjour, [VAR 0x0100(0000)] !\\nComment se passe ton échange scolaire ?\\c\\nProfite de ce séjour pour capturer plein\\nde Pokémon et pour faire des activités Myrtille ![VAR 0x0114(004B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
