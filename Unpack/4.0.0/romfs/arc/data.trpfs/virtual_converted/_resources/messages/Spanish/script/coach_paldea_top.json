          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_paldea_top_sp02_04c",
      "hash64": "22016EA3718A9B67",
      "text": "Ah, Denis, uno de los miembros del Alto Mando\\nde la Liga Arándano, ¿verdad?\\c\\nLa Liga Pokémon de Paldea carece de un experto\\nen Pokémon de tipo Fuego, así que su presencia\\r\\nsupondría todo un soplo de aire fresco.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
