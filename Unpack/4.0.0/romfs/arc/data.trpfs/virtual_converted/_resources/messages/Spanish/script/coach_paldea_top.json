        {
          "kind": "control",
          "offset_units": 215,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea_top_sp02_04d",
      "hash64": "22016BA3718A964E",
      "text": "Ah, Nerina, una miembro del Alto Mando de la\\nLiga Arándano, ¿verdad?\\c\\nPodría llevarse bien con Pola, por su condición\\nde experta en Pokémon de tipo Acero.\\c\\nSu carácter sereno y su capacidad para desplegar\\ncomplejas estrategias podrían ser un revulsivo\\r\\nque haga brillar aún más a Paldea.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 156,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 255,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 293,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_paldea_top_sp02_04e",
      "hash64": "22016CA3718A9801",
      "text": "Ah, Aroa, una miembro del Alto Mando de la\\nLiga Arándano, ¿verdad?\\c\\nSu padre es Líder de Gimnasio aquí en Teselia,\\nsi no me equivoco.\\c\\nY en la Liga Pokémon de Paldea carecemos de\\nun experto en Pokémon de tipo Hada, así que\\r\\nsin duda me gustaría abordar la cuestión.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
