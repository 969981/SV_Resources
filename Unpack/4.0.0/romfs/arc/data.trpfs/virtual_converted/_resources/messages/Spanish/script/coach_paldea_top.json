            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_paldea_top_sp02_04b",
      "hash64": "22016DA3718A99B4",
      "text": "Corin, una de las integrantes de la expedición\\nde investigación al foso, ¿verdad?\\c\\nAunque ya acumulaba abundante experiencia\\ngracias a sus viajes extracurriculares con Brie...\\c\\nSi la amistad que os une es tan estrecha, estimo\\nque estaría dispuesta a venir a Paldea.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
