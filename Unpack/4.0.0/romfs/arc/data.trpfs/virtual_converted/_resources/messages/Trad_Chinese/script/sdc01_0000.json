          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0000_ecology_07",
      "hash64": "5772AEE9CF9E0702",
      "text": "因為那個地方很遠，\\n這次還特別縮減了參加人數。\\r\\n能參加的機率真的很低呢～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
