      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0000_ecology_03",
      "hash64": "5772AAE9CF9E0036",
      "text": "其實呢，每年這個時期，\\n學院都會和其他學校\\r\\n聯合舉辦夏令營……[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
