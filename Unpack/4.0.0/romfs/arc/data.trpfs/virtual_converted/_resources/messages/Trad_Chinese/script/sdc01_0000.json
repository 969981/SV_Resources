      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0000_ecology_04",
      "hash64": "5772ADE9CF9E054F",
      "text": "聽、聽好囉！[VAR 0x0100(0000)]\\n[VAR 0x1100(00FF,0101)]你妳被選為參加的學生了！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
