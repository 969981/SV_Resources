          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0130_dragonbb_08",
      "hash64": "556F1F944351B375",
      "text": "妳聽，[VAR 0x1100(00FF,0101)]他她都說是了！\\n人既然活在這個世上呀～\\r\\n當然想做些驚天動地的事囉！[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
