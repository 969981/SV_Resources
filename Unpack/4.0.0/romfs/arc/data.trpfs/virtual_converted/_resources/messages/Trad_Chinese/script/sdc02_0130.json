          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc02_0130_dragonbb_07",
      "hash64": "556F20944351B528",
      "text": "對吧？[VAR 0x0100(0000)]！？[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
