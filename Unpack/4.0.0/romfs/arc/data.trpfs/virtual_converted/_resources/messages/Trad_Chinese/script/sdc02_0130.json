      "text": "是我同意[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]他她\\n報名藍莓聯盟的。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
