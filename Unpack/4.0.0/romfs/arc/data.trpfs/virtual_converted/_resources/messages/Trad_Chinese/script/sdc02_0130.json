    },
    {
      "ordinal": 24,
      "label": "sdc02_0130_sister_03",
      "hash64": "EFBFDA4C5DEE9D9D",
      "text": "[VAR 0x0100(0000)]，抱歉！\\n阿栗讓人感覺不太舒服吧？[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
