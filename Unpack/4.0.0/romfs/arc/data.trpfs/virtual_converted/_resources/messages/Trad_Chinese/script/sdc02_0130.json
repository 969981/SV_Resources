          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0130_brother_06",
      "hash64": "DDAF615FD7DF3B42",
      "text": "我不允許[VAR 0x1100(00FF,0101)]你妳在\\n和我對戰之前輸掉。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
