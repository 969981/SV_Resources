  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0090_bbteacher_01",
      "hash64": "12AE6F419826A67D",
      "text": "Morning, everyone! Did you sleep well?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0090_bbteacher_02",
      "hash64": "12AE6C419826A164",
      "text": "Starting today, you’ll be joined by our two\\nstudents from Blueberry Academy.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0090_bbteacher_03",
      "hash64": "12AE6D419826A317",
      "text": "Go on, kids! Time to introduce yourselves.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0090_sister_01",
      "hash64": "4496B518E49CBCF9",
      "text": "Hi! I’m Carmine![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0090_sister_02",
      "hash64": "4496B218E49CB7E0",
      "text": "It’s a pleasure to meet all you outsiders—I mean,\\nvisitors from Paldea! Hee hee![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0090_brother_01",
      "hash64": "94B84D049862969D",
      "text": "I-I’m...Kieran...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0090_caretaker_01",
      "hash64": "B1C8AA68D0909FB7",
      "text": "Carmine and Kieran actually grew up here, so ask\\nthem for help if you need anything.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0090_caretaker_02",
      "hash64": "B1C8AB68D090A16A",
      "text": "And you two had better be of real help, you\\nhear me?[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0090_sister_03",
      "hash64": "4496B318E49CB993",
      "text": "Aye-aye.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0090_brother_02",
      "hash64": "94B84A0498629184",
      "text": "R-right...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0090_caretaker_03",
      "hash64": "B1C8AC68D090A31D",
      "text": "Now that that’s settled... Why don’t I tell you all\\na bit about what we have planned for you?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0090_caretaker_04",
      "hash64": "B1C8A568D0909738",
      "text": "This school trip of yours will be an exercise in\\norienteering![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0090_caretaker_05",
      "hash64": "B1C8A668D09098EB",
      "text": "First, we’ll have you split into pairs. Then each\\npair will be tasked with finding [VAR 0xFF00(0006)]three signboards[VAR 0xFF00(0000)]\\r\\nlocated around the land of Kitakami.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0090_caretaker_06",
      "hash64": "B1C8A768D0909A9E",
      "text": "On each signboard, you’ll find snippets of an\\nold folktale passed down here in Kitakami.\\r\\nRead them all and learn a bit about our home.[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0090_caretaker_07",
      "hash64": "B1C8A868D0909C51",
      "text": "To prove you’ve completed the task, we ask that\\neach pair take a snapshot together in front of\\r\\nthese signboards with their phone or camera.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0090_caretaker_08",
      "hash64": "B1C8A168D090906C",
      "text": "Take a photo together in front of each of the\\nthree signboards to complete your mission![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0090_caretaker_09",
      "hash64": "B1C8A268D090921F",
      "text": "It’s a self-guided tour of Kitakami! Learn all\\nabout its rich history![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0090_caretaker_10",
      "hash64": "B1CC2F68D093B78D",
      "text": "Much more fun than sitting around and listening\\nto me ramble on and on, eh?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0090_bbteacher_04",
      "hash64": "12AE6A4198269DFE",
      "text": "Wonderful! What an innovative idea for a group\\nactivity![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0090_caretaker_11",
      "hash64": "B1CC2E68D093B5DA",
      "text": "Oh, and I’ve got a gift for each of you as well![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0090_caretaker_12",
      "hash64": "B1CC2D68D093B427",
      "text": "I hear these things’re all the rage in the big cities.\\nUse them when you take those photos![VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0090_caretaker_14",
      "hash64": "B1CC2B68D093B0C1",
      "text": "I’ll even teach you a rad pose I came up with all\\non my own.[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0090_system_01",
      "hash64": "DDE13EB68F388552",
      "text": "You learned the [VAR 0xFF00(0008)]Eureka emote[VAR 0xFF00(0000)] from the\\ncaretaker!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0090_bbteacher_05",
      "hash64": "12AE6B4198269FB1",
      "text": "Ah, yes. Real...rad...[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0090_bbteacher_06",
      "hash64": "12AE684198269A98",
      "text": "Remember that one of the goals of this trip is to\\ndeepen the ties between our two schools.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0090_bbteacher_07",
      "hash64": "12AE694198269C4B",
      "text": "It seems like having someone who knows the\\narea well would be a big help. That being said...[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0090_bbteacher_08",
      "hash64": "12AE664198269732",
      "text": "Let’s try to maximize the number of interschool\\npairs, OK? Time to mingle![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0090_caretaker_13",
      "hash64": "B1CC2C68D093B274",
      "text": "Be sure to tell me if Carmine or Kieran cause\\nyou any trouble during your stay.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0090_student1_01",
      "hash64": "6364CD10CA6CB763",
      "text": "[VAR 0xBD06(0000)]We’ve got four students from [VAR 0x1107(00FF,0206)]NaranjUva Academy\\nand\\r\\nonly two from Blueberry...\\c\\nSo that means at least one pair will be made up\\nof just kids from our school, right?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 3,
          "code_hex": "1107",
          "args_hex": [
            "00FF",
            "0206"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0090_student2_01",
      "hash64": "8F6BD5172BD6C9AC",
      "text": "That girl, Carmine... I’m not sure I trust that\\ncheery greeting from her.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "sdc01_0090_student3_01",
      "hash64": "3A8F21213B3FE301",
      "text": "What?! I don’t want to have to pair up with\\nsomeone I don’t even know!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "sdc01_0090_brother_03",
      "hash64": "94B84B0498629337",
      "text": "Aw man...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0090_stopper_01",
      "hash64": "3DD6A55A136A6852",
      "text": "Try talking to the other kids! It’s time to make\\nsome new friends!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
}
