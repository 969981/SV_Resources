      "ordinal": 7,
      "label": "sdc02_0268_sister_04",
      "hash64": "311419C6F0C16EBC",
      "text": "搞得我和宝可梦\\n都筋疲力尽了！[VAR 0x0114(0044)]",
      "flags": 0,
