      "ordinal": 6,
      "label": "sdc02_0268_sister_03",
      "hash64": "311418C6F0C16D09",
      "text": "提前跟你说清楚，\\n你不在的时候我们也战斗了哦。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
