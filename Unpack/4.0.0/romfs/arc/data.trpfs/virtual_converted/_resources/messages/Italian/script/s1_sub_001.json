      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_sub_001_select_02",
      "hash64": "1D7146A7871682F4",
      "text": "Cosa ci fa qui?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "s1_sub_001_ecology_02",
      "hash64": "45295B139DA136BE",
      "text": "Eheheh... Sono venuto a Nordivia per vedere\\ncome te la stai cavando! Dopotutto, sono\\r\\nil tuo referente.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
