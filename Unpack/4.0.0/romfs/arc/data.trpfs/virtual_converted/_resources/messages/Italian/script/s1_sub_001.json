          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_001_ecology_18",
      "hash64": "452CD7139DA43F49",
      "text": "Però è stato trovato davvero durante un picnic![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
