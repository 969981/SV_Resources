      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "s1_sub_001_select_04",
      "hash64": "1D7144A787167F8E",
      "text": "Ce l’ha messo lei?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "s1_sub_001_ecology_16",
      "hash64": "452CE1139DA45047",
      "text": "Eheheh... In realtà l’ho portato io.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
