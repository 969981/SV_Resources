    },
    {
      "ordinal": 23,
      "label": "s1_sub_001_ecology_19",
      "hash64": "452CD6139DA43D96",
      "text": "Se gli Allenatori non possono tenere le Uova\\nche trovano nei Cestini, le donano all’accademia\\r\\ne noi ce ne prendiamo cura...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
