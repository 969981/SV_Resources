      "label": "s1_sub_001_ecology_14",
      "hash64": "452CE3139DA453AD",
      "text": "È un Uovo di Pokémon![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
