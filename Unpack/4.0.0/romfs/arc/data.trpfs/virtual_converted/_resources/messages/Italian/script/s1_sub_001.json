      ]
    },
    {
      "ordinal": 29,
      "label": "s1_sub_001_ecology_24",
      "hash64": "453061139DA75F9E",
      "text": "Il Pokédex di Nordivia si riempirà man mano che\\ncatturerai i Pokémon di questa zona.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
