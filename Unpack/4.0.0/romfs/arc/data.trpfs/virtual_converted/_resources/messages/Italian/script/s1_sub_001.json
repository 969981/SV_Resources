            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_sub_001_ecology_23",
      "hash64": "453064139DA764B7",
      "text": "Ad ogni modo, stai continuando a usare anche\\nqui l’App Pokédex?[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
