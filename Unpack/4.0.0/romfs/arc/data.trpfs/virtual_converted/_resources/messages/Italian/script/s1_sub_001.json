      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_001_ecology_21",
      "hash64": "453066139DA7681D",
      "text": "E insomma, [VAR 0x0100(0000)], tieni! È per te![VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
