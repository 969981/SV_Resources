          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_001_ecology_03",
      "hash64": "45295C139DA13871",
      "text": "Una volta arrivato, ne ho ovviamente\\napprofittato per fare delle ricerche\\r\\nsui Pokémon del luog...[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
