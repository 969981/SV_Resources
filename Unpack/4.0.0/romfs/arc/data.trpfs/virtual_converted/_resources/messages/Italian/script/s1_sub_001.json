          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_001_ecology_17",
      "hash64": "452CE0139DA44E94",
      "text": "Eheheh... Hai già capito tutto, vedo.[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
