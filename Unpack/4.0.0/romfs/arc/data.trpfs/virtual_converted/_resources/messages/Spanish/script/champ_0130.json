    {
      "ordinal": 1,
      "label": "champ_0130_ground_02",
      "hash64": "DE111A169634B090",
      "text": "No tienes piedad alguna con los gimnasios, ¿eh?\\n¡Lo estás petando, colega![VAR 0x0114(0013)]",
