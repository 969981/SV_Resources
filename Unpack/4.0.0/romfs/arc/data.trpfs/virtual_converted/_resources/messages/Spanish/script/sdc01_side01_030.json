    },
    {
      "ordinal": 2,
      "label": "sdc01_side01_030_brother_03",
      "hash64": "2C5EDEF8ACDFF5AC",
      "text": "Oye... ¿Q-qué tal si, antes de leer el cartel,\\nechamos un combate?[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
