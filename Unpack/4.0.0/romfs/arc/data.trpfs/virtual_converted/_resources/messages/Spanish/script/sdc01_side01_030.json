          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_side01_030_select_01",
      "hash64": "08A96501DBB565C0",
      "text": "¡Vale!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc01_side01_030_select_02",
      "hash64": "08A96801DBB56AD9",
      "text": "No sé...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc01_side01_030_brother_04",
      "hash64": "2C5EDDF8ACDFF3F9",
      "text": "Guay, deja que cure primero a tu[VAR 0x1101(00FD,0100)]s Pokémon.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_side01_030_brother_05",
      "hash64": "2C5EDCF8ACDFF246",
      "text": "Tranquil[VAR 0x1100(00FF,0101)]oa, que antes curaré a tu[VAR 0x1101(00FD,0100)]s Pokémon.\\n¿Qué me dices?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "00FD",
            "0100"
          ]
        },
        {
