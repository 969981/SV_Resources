    },
    {
      "ordinal": 7,
      "label": "sdc01_side01_030_brother_06",
      "hash64": "2C5EDBF8ACDFF093",
      "text": "¡Esta vez... te ganaré![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
