      ]
    },
    {
      "ordinal": 35,
      "label": "common_0090_head_teacher_11",
      "hash64": "F3A49AA8F41E3C31",
      "text": "그럼, 저는 네모 양의 가족분들과\\n이야기를 나누어야 하니...[VAR 0x0114(000A)]",
      "flags": 0,
