      "label": "s2_side01_0080_select_01",
      "hash64": "3E37776C340B85F3",
      "text": "Je suis d’accord !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "s2_side01_0080_select_02",
      "hash64": "3E37786C340B87A6",
