          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_side01_0080_brother_01",
      "hash64": "91D444A7ABA8EA9F",
      "text": "T’as trouvé la boutique facilement ?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_side01_0080_rival_02",
      "hash64": "D973AD3B423F1C1C",
      "text": "Oh bah oui, elle est juste à côté !\\nC’était facile ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0080_rival_03",
      "hash64": "D973AE3B423F1DCF",
      "text": "Mais il y avait personne, alors j’ai laissé\\nl’argent sur le comptoir. Ça ira ?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0080_brother_02",
      "hash64": "91D445A7ABA8EC52",
      "text": "Oui, c’est pas un problème. Tout l’monde fait\\nça quand madame Delapêche s’absente.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0080_friend_01",
      "hash64": "E9A59ED99AFB3197",
      "text": "Ah bon ? Personne ferait ça à Paldea...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0080_botan_02",
      "hash64": "726D32FC947150CA",
      "text": "Menzi, qu’est-ce que tu as autour de la bouche ?\\nTu as mangé quelque chose en cachette ?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side01_0080_rival_04",
      "hash64": "D973AB3B423F18B6",
      "text": "Oui, j’ai pris un mochi. Y avait marqué\\n« Servez-vous », donc j’en ai profité.[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side01_0080_friend_02",
      "hash64": "E9A59FD99AFB334A",
      "text": "Kassis ! On peut pas regarder un film\\nsur cette télé ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side01_0080_brother_03",
      "hash64": "91D446A7ABA8EE05",
      "text": "Ah... L’intendant a caché la télécommande.\\nDu coup, on peut pas changer d’chaîne...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0080_friend_03",
      "hash64": "E9A5A0D99AFB34FD",
      "text": "Cherchons-la, alors ! J’en ai marre de voir\\nla vidéo de promo du village en boucle ![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side01_0080_friend_04",
      "hash64": "E9A599D99AFB2918",
      "text": "J’imagine qu’elle doit se trouver quelque part\\ndans le centre culturel, non ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side01_0080_brother_04",
      "hash64": "91D43FA7ABA8E220",
      "text": "C’est... c’est vrai qu’on peut faire ça...\\nJ’y avais jamais pensé...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side01_0080_botan_03",
      "hash64": "726D33FC9471527D",
      "text": "Oui, trouvons cette télécommande ! Profitons\\nde cet écran géant pour jouer aux jeux vidéo ![VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_side01_0080_rival_05",
      "hash64": "D973AC3B423F1A69",
      "text": "Une chasse au trésor ? Génial ! Séparons-nous,\\non aura plus de chances de la trouver ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
