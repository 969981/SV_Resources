          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "team_0020_nelke_19",
      "hash64": "082794F2E55777DA",
      "text": "¿Y yo? ¿Cómo puedo echaros un cable?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "team_0020_cassiopeia_35",
      "hash64": "063503805A964CF8",
      "text": "No te ofendas, pero no termino de fiarme de ti.\\c\\nDe momento, encárgate de sondear las bases y,\\nsi [VAR 0x0100(0000)] necesita ayuda, préstasela.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
