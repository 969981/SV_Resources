          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "team_0020_cassiopeia_26",
      "hash64": "063184805A933F54",
      "text": "Sus bases no son pequeñas, que digamos, y\\nencima tienen Pokémon patrullando la zona\\r\\nen busca de intrusos.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
