          "offset_units": 130,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "team_0020_cassiopeia_22",
      "hash64": "063180805A933888",
      "text": "Vamos, que hemos mostrado a las claras nuestra\\nintención de buscar bronca.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "team_0020_nelke_16",
      "hash64": "082787F2E55761C3",
      "text": "Si crujimos a los jefes y logramos que dimitan...\\n¿pasará lo que creo que pasará?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
