    {
      "ordinal": 46,
      "label": "team_0020_cassiopeia_25",
      "hash64": "063187805A93446D",
      "text": "Pero el problema viene aquí...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
