          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "team_0020_cassiopeia_33",
      "hash64": "063509805A96572A",
      "text": "El Team Star y yo colaboramos en el pasado,\\ncomo ya he dicho antes.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "team_0020_cassiopeia_34",
      "hash64": "063504805A964EAB",
      "text": "Por ese motivo no puedo dejar que me vean.\\nPrefiero ser el cerebro en la sombra.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
