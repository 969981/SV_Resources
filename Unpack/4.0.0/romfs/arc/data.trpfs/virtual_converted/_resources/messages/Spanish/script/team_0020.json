      ]
    },
    {
      "ordinal": 44,
      "label": "team_0020_cassiopeia_24",
      "hash64": "063186805A9342BA",
      "text": "Un escuadrón sin jefe es como un títere sin\\ncuerdas.\\c\\nSin nadie a la cabeza, es cuestión de tiempo\\nque el Team Star se desmorone y desaparezca.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
