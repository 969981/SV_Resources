      ]
    },
    {
      "ordinal": 54,
      "label": "team_0020_nelke_18",
      "hash64": "082795F2E557798D",
      "text": "¿Y tú no vas a hacer nada?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
