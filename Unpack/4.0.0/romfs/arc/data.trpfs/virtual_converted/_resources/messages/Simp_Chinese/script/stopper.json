      "ordinal": 17,
      "label": "stopper_common_1300_01",
      "hash64": "BA179E5583835271",
      "text": "电梯门紧闭着……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "stopper_common_1180_01",
      "hash64": "59D8EDE234F9E96B",
      "text": "操作下方的面板，\\n打开零区研究所的闸口吧。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
