            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "stopper_common_0088_01",
      "hash64": "ECCF9E54E76ADA81",
      "text": "哦？妮莫同学正在海滩\\n着急地等着你哦。[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "stopper_common_0095_01",
      "hash64": "ADEDF249B490056F",
      "text": "你还没有选择宝可梦！\\n……去告诉校长吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "stopper_common_0170_01",
      "hash64": "1AA738F3C7B66831",
      "text": "加噜加噜！加噜！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "stopper_common_0170_02",
      "hash64": "1AA735F3C7B66318",
      "text": "黑鲁加们正在吠叫。\\n……还是不要进去了吧。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "stopper_common_0170_03",
      "hash64": "1AA736F3C7B664CB",
      "text": "前方危险，\\n还是不要靠近了……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "stopper_common_0220_01",
      "hash64": "E0A8E5E3699496F9",
      "text": "妮莫正在等你呢！\\n前往学校吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "stopper_legend_0110_01",
      "hash64": "B4EB790148952C4F",
      "text": "……咦？\\n门是锁着的！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "stopper_dan_ajito_00",
      "hash64": "98CD61823F2547F1",
