      ]
    },
    {
      "ordinal": 14,
      "label": "stopper_dan_ajito_02",
      "hash64": "98CD5F823F25448B",
      "text": "请敲响入口处的锣，\\n堂堂正正地打进来吧！[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
