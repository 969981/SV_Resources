  "entries": [
    {
      "ordinal": 0,
      "label": "stopper_general_01",
      "hash64": "CB04017349BE696B",
      "text": "这个方向\\n还是等之后再去吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "stopper_general_02",
      "hash64": "CB04027349BE6B1E",
      "text": "现在先试着\\n在学校里探险看看吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "stopper_common_0030_01",
      "hash64": "C463F20AE2942618",
      "text": "去学校的准备\\n似乎还没做好。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "stopper_common_0060_01",
      "hash64": "70939D9739950D67",
      "text": "和宝可梦们一起\\n去对面的房子吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "stopper_common_0070_01",
      "hash64": "818C7E69674F1B44",
      "text": "[VAR 0x0100(0000)]！\\n你要选择宝可梦呀！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
