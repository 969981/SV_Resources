    {
      "ordinal": 19,
      "label": "stopper_common_0130_01",
      "hash64": "D762C5524C148B7D",
      "text": "倒在地上的宝可梦\\n让人好在意……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "stopper_gym_stopper_01",
      "hash64": "3C471CB7DEB9F172",
