      "hash64": "0390DAB4896C949E",
      "text": "[VAR 0x0100(0000)]！\\n路很窄，[VAR 0x1100(00FF,0101)]你妳還好嗎？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
