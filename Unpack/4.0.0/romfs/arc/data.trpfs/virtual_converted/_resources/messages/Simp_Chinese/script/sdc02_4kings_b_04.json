          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_a_04_steelbb_20",
      "hash64": "7B3355B0CD527E7E",
      "text": "[VAR 0x0100(0000)]你\\n是怎样看待乌栗的？[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_a_04_select_01",
      "hash64": "06E73F3E9526535E",
      "text": "他是朋友",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_04_select_02",
      "hash64": "06E73E3E952651AB",
      "text": "他是劲敌",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_04_select_03",
      "hash64": "06E73D3E95264FF8",
      "text": "不知道",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_04_steelbb_03",
      "hash64": "7B2CCCB0CD4D2A05",
      "text": "是朋友……啊。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_a_04_steelbb_04",
      "hash64": "7B2CC5B0CD4D1E20",
      "text": "是劲敌……啊。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_a_04_steelbb_05",
      "hash64": "7B2CC6B0CD4D1FD3",
      "text": "不知道……啊。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_4kings_a_04_steelbb_06",
      "hash64": "7B2CC7B0CD4D2186",
      "text": "对纳莉我来说，\\n他是我友人丹瑜的仁弟。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_4kings_a_04_steelbb_07",
      "hash64": "7B2CC8B0CD4D2339",
      "text": "现在他和以前不同了。\\n……纳莉我也很担忧。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_4kings_a_04_steelbb_08",
      "hash64": "7B2CD1B0CD4D3284",
      "text": "并且，可能的话，\\n纳莉我想拯救他。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_4kings_a_04_steelbb_09",
      "hash64": "7B2CD2B0CD4D3437",
      "text": "因此，\\n我不容有失。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_4kings_a_04_steelbb_10",
      "hash64": "7B304FB0CD503E75",
      "text": "……开始战斗。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_4kings_a_04_steelbb_11",
      "hash64": "7B304EB0CD503CC2",
      "text": "宝可梦有多强，\\n就表示心意有多强。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_4kings_a_04_steelbb_12",
      "hash64": "7B304DB0CD503B0F",
      "text": "[VAR 0x0100(0000)]你为乌栗着想的心意，\\n要更胜纳莉我一筹啊。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
