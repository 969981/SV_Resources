      "ordinal": 23,
      "label": "sdc02_4kings_a_04_steelbb_18",
      "hash64": "7B3057B0CD504C0D",
      "text": "我想拯救乌栗的心意，\\n……就托付给[VAR 0x0100(0000)]你了。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
