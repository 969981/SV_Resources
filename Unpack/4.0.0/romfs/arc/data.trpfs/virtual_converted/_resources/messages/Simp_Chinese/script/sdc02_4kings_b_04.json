    {
      "ordinal": 19,
      "label": "sdc02_4kings_a_04_steelbb_14",
      "hash64": "7B304BB0CD5037A9",
      "text": "[VAR 0x0100(0000)]……你很善良。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
