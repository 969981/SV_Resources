    {
      "ordinal": 1,
      "label": "sdc02_4kings_a_04_steelbb_02",
      "hash64": "7B2CCBB0CD4D2852",
      "text": "……纳莉我有件事\\n之前就想问你。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
