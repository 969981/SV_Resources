          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc01_0100_caretaker_02",
      "hash64": "CE25A6AB5F9154A0",
      "text": "Dann registriere ich jetzt die Standorte der\\nInfotafeln auf eurem Smart-Rotom.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
