      "ordinal": 44,
      "label": "sdc01_0100_student1_02",
      "hash64": "F5FB6936E5760F18",
      "text": "Auf gute Zusammenarbeit, Hana!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "sdc01_0100_student2_01",
      "hash64": "48092C1B2A25983E",
      "text": "Ich konnte den Kleinen nicht sich selbst\\nüberlassen, also hab ich mich mit ihm\\r\\nzusammengetan.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE00",
