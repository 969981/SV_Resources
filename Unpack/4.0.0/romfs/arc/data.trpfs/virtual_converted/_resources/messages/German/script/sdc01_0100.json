      ]
    },
    {
      "ordinal": 40,
      "label": "sdc01_0100_brother_12",
      "hash64": "02D30702D300B4BF",
      "text": "A-Am besten fangen wir mit der Infotafel\\nauf dem [VAR 0xFF00(0006)]Gefährten-Platz[VAR 0xFF00(0000)] an...\\c\\nDer liegt westlich vom Dorf, hinter der\\nApfelplantage.[VAR 0x0114(0043)]",
