          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc01_0100_caretaker_03",
      "hash64": "CE25A7AB5F915653",
      "text": "Und los geht’s! Möge der Orientierungslauf\\nbeginnen![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
