    {
      "ordinal": 43,
      "label": "sdc01_0100_caretaker_04",
      "hash64": "CE25ACAB5F915ED2",
      "text": "Willkommen beim Kitakami-Kulturzentrum!\\nSieh dich in Ruhe um.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
