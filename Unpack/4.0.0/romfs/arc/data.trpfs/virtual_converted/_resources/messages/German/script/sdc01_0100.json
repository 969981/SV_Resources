        }
      ]
    },
    {
      "ordinal": 37,
      "label": "sdc01_0100_caretaker_05",
      "hash64": "CE25ADAB5F916085",
      "text": "Oh, falls jemand übrigens Tränke, Pokébälle oder\\nandere Items benötigt...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc01_0100_caretaker_06",
      "hash64": "CE25AAAB5F915B6C",
      "text": "Das gibt es alles bei Momos Gemischtwaren\\ndort drüben![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
