  "paired_tbl": "message/dat/German/script/sdc01_0100.tbl",
  "matching": "TRAILING_MAX_SENTINEL",
  "entries": [
    {
      "ordinal": 0,
      "label": "sdc01_0100_sister_01",
      "hash64": "6ED1B9A3196FDDD3",
      "text": "Dein Name war [VAR 0x0100(0000)], oder?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0100_sister_02",
      "hash64": "6ED1BAA3196FDF86",
      "text": "Lass mich raten – du bist hier, um dich aus Mitleid\\nmit uns armen „Außenseitern“ auszutauschen?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0100_sister_03",
      "hash64": "6ED1BBA3196FE139",
      "text": "Wie nobel von dir! Ich bin ja so was von gerührt,\\nwas würden wir nur ohne dich tun![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0100_sister_04",
      "hash64": "6ED1BCA3196FE2EC",
      "text": "Warum sprichst du uns dann an? Du bist ein\\nbisschen merkwürdig, kann das sein?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0100_sister_05",
      "hash64": "6ED1BDA3196FE49F",
      "text": "Mein kleiner Bruder ist jedenfalls ganz besessen\\nvon dir.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0100_sister_06",
      "hash64": "6ED1BEA3196FE652",
      "text": "Zu Hause hat er nonstop von dir geredet.\\nDas geht mir echt auf den Senkel.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0100_brother_01",
      "hash64": "02D00402D2FE79CF",
      "text": "Spinnst du? Warum erzählst du [VAR 0x1100(00FF,0303,0000)]ihmihr das?![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0100_sister_07",
      "hash64": "6ED1BFA3196FE805",
      "text": "Pass auf, wie du mit mir redest, Freundchen!\\nIch tu dir hier ’nen Gefallen, klar?! Alleine\\r\\nwürdest du deinen Mund eh nicht aufkriegen![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0100_brother_02",
      "hash64": "02D00502D2FE7B82",
      "text": "Hmpf...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0100_sister_08",
      "hash64": "6ED1C0A3196FE9B8",
      "text": "Hach ja, das ist ihm jetzt wieder schrecklich\\npeinlich.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0100_sister_09",
      "hash64": "6ED1C1A3196FEB6B",
      "text": "Wie du unschwer erkennen kannst, gehört mit\\nanderen zu reden nicht gerade zu seinen Stärken.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0100_sister_10",
      "hash64": "6ED53EA31972F5A9",
      "text": "Von sich aus würde er es wahrscheinlich nie\\nüber die Lippen kriegen, also sag ich’s:\\c\\nEr würde gerne gegen dich kämpfen.\\nTust du ihm den Gefallen?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 148,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0100_sister_11",
      "hash64": "6ED53DA31972F3F6",
      "text": "Komm schon, bitte kämpf gegen meinen Bruder![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0100_sister_12",
      "hash64": "6ED53CA31972F243",
      "text": "Hm? Was hast du gesagt? Ich kann dich leider\\nnicht hören.\\c\\nSprich mich noch mal an, wenn du bereit bist,\\n„Ja“ zu sagen.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0100_sister_13",
      "hash64": "6ED53BA31972F090",
      "text": "Na, so was! Du bist netter, als ich dachte.\\nDa wird er sich freuen.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0100_sister_14",
      "hash64": "6ED542A31972FC75",
      "text": "[VAR 0xBD06(0000)]Hey, Jo! [VAR 0x0100(0000)] hat\\nzugestimmt,\\r\\ngegen dich\\r\\nzu kämpfen![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0100_brother_03",
      "hash64": "02D00602D2FE7D35",
      "text": "Was?![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0100_brother_04",
      "hash64": "02CFFF02D2FE7150",
      "text": "Echt jetzt? I-Ist das wirklich okay?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0100_sister_15",
      "hash64": "6ED541A31972FAC2",
      "text": "Ja, du hast richtig gehört![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0100_sister_16",
      "hash64": "6ED540A31972F90F",
      "text": "Dann nehmt mal eure Plätze ein. Ihr anderen,\\nmacht ein bisschen Platz, hopp, hopp![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0100_brother_05",
      "hash64": "02D00002D2FE7303",
      "text": "I-Ich werd mein Bestes geben![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0100_student1_01",
      "hash64": "F5FB6C36E5761431",
      "text": "Das war ein toller Kampf!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sdc01_0100_bbteacher_01",
      "hash64": "0F1D3B6D4E12391F",
      "text": "Ein schönes Freundschaftsmatch! Ihr Kinder wisst\\neben, wie man sich schnell kennenlernt.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0100_brother_06",
      "hash64": "02D00102D2FE74B6",
      "text": "[VAR 0xBD06(0000)]Wusst ich’s doch! Du bist echt stark,\\n[VAR 0x0100(0000)]![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0100_brother_07",
      "hash64": "02D00202D2FE7669",
      "text": "Wow, was ein Kampf! Aber mir ist klar, dass du\\nnoch stärker bist, wenn du richtig Ernst machst.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0100_sister_17",
      "hash64": "6ED53FA31972F75C",
      "text": "Jo ist fast genauso stark wie ich.\\nDu hast echt was drauf.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0100_brother_08",
      "hash64": "02D00B02D2FE85B4",
      "text": "Mmh...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0100_sister_18",
      "hash64": "6ED546A319730341",
      "text": "Wir sollen diesen Orientierungslauf zu zweit\\nerledigen, oder?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0100_sister_19",
      "hash64": "6ED545A31973018E",
      "text": "Mach das doch zusammen mit Jo![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0100_brother_09",
      "hash64": "02D00C02D2FE8767",
      "text": "Was?! N-Nicht doch...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0100_sister_20",
      "hash64": "6ED844A3197535B2",
      "text": "Warum denn nicht? Wir zwei sollen das ja nicht\\nzusammen machen.\\c\\nWillst du dich lieber mit einem von den anderen\\nFremden zusammentun?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0100_brother_10",
      "hash64": "02D30902D300B825",
      "text": "Ähm... Nein, a-aber...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0100_sister_21",
      "hash64": "6ED845A319753765",
      "text": "Na bitte. Er steht sich mit seiner Schüchternheit\\nmal wieder nur selbst im Weg.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_0100_sister_22",
      "hash64": "6ED842A31975324C",
      "text": "Ich schließ mich mit jemand anderem zusammen.\\nKümmer dich gut um meinen Bruder.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
