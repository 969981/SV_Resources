      "ordinal": 29,
      "label": "s2_sub_007_kakutou_09",
      "hash64": "F9A044A118EEFB16",
      "text": "Und ich kann nur Nachhilfe im Sportunterricht\\nanbieten...[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
