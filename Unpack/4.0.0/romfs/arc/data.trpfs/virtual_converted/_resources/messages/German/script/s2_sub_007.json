    },
    {
      "ordinal": 26,
      "label": "s2_sub_007_kakutou_08",
      "hash64": "F9A045A118EEFCC9",
      "text": "Aber... das hat nichts gebracht.[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
