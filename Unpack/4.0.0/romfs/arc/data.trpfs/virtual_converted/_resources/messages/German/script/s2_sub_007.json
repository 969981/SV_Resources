      "ordinal": 21,
      "label": "s2_sub_007_aku_12",
      "hash64": "BBF60EAC09DBEA1F",
      "text": "Also, es geht um die anderen Bosse von\\nTeam Star...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
