      "ordinal": 28,
      "label": "s2_sub_007_aku_17",
      "hash64": "BBF609AC09DBE1A0",
      "text": "Ich kapier nicht, was daran so schwer sein soll...[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
