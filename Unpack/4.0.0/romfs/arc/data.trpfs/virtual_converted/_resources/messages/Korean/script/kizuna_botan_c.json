      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_botan_c_05",
      "hash64": "0E9971B5BB587F5C",
      "text": "아직 무서워하는 사람들도 있으니까\\n그냥 헛소문일 거라고 생각하지만...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
