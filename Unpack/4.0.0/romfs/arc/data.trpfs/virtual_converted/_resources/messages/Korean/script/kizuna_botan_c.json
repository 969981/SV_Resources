    },
    {
      "ordinal": 31,
      "label": "kizuna_botan_c_hono_10",
      "hash64": "32C6B0E2DE9EB063",
      "text": "이 옷이랑 부츠,\\n전부 친구가 만들어 준 건데...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
