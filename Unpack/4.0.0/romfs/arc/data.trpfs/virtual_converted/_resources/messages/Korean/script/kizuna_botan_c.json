      "ordinal": 23,
      "label": "kizuna_botan_c_hono_06",
      "hash64": "32C344E2DE9BC308",
      "text": "미, 미안, 비파 언니...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
