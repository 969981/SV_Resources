          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "kizuna_botan_c_17",
      "hash64": "0E9603B5BB558E9B",
      "text": "나도...\\n수고하셨스타~[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
