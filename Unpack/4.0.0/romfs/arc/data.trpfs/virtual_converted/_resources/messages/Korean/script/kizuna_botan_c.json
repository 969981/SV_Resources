    {
      "ordinal": 11,
      "label": "kizuna_botan_c_hono_02",
      "hash64": "32C348E2DE9BC9D4",
      "text": "어이...\\n너, 미술부 부원이냐?[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
