    },
    {
      "ordinal": 9,
      "label": "kizuna_botan_c_07",
      "hash64": "0E9973B5BB5882C2",
      "text": "지, 진짜로 왔잖아!?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
