      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_botan_c_student_06",
      "hash64": "FAD62953CBFFD561",
      "text": "아, 그게 아니라,\\n부원이 되시려는 이유를 듣고 싶어서요...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "kizuna_botan_c_hono_09",
      "hash64": "32C343E2DE9BC155",
      "text": "이유 말이지...[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
