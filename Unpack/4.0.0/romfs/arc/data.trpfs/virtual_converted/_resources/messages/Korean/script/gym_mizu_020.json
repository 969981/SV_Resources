      "label": "gym_mizu_020_system_02",
      "hash64": "C2234DBAFFC0FFB4",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)] 곤포에게\\n전설의 미역을 건넸다!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
