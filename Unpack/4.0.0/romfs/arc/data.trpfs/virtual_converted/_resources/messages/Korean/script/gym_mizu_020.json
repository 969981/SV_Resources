    {
      "ordinal": 44,
      "label": "gym_mizu_020_seri_01",
      "hash64": "E9E0F72565D1DA3D",
      "text": "자, 그럼 시작합니다~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
