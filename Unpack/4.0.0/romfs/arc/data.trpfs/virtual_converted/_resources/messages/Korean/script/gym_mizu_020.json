      ]
    },
    {
      "ordinal": 38,
      "label": "gym_mizu_020_mizu_16",
      "hash64": "930E7C305CF3DC8F",
      "text": "이번이 그걸 시험할 좋은 기회다!\\n나 대신 경매에서 저걸 낙찰받아 보거라![VAR 0x0114(0018)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
