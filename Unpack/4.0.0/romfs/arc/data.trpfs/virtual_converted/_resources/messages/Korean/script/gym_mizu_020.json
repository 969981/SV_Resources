    {
      "ordinal": 59,
      "label": "gym_mizu_020_seri_04b",
      "hash64": "3B0D518C038798D4",
      "text": "예~! [VAR 0x0205(0001,0000)]원!\\n거기 계신 숙녀분께 낙찰되었습니다~!",
      "flags": 0,
