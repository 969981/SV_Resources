    {
      "ordinal": 1,
      "label": "common_0310_rival_02",
      "hash64": "F9E34EBA49837D0D",
      "text": "之前帮你添加的道馆的位置！\\n试着把它设定为目的地吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
