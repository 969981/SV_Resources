          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0310_friend_01",
      "hash64": "659687FC050E9AC8",
      "text": "学生会长妮莫！\\n你居然偷跑，太卑鄙了！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0310_rival_03",
      "hash64": "F9E34DBA49837B5A",
      "text": "哇！派帕！？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0310_rival_04",
      "hash64": "F9E348BA498372DB",
      "text": "谁偷跑了？你别说得那么难听！\\n我只是建议[VAR 0x1100(00FF,0101)]他她去道馆而已！\\c\\n[VAR 0x0100(0000)]接下来要做什么，\\n毕竟还是要由[VAR 0x1100(00FF,0101)]他她自己来决定嘛！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
