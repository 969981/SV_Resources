          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0310_friend_02",
      "hash64": "65968AFC050E9FE1",
      "text": "[VAR 0x0100(0000)]要和我\\n一起去寻找宝主宝可梦，\\r\\n然后把调味料搞到手。\\r\\n[VAR 0x1100(00FF,0101)]他她才没空当冠军呢。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
