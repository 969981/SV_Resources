      "ordinal": 29,
      "label": "class_d_06_language_20",
      "hash64": "F1BD3A98E7DE5C6D",
      "text": "Aber das versteht sich ja von selbst und sollte für\\neuch keine Herausforderung darstellen![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
