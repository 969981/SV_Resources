    {
      "ordinal": 28,
      "label": "class_d_06_language_19",
      "hash64": "F1C0A998E7E14EE1",
      "text": "Wenn euer Pokémon traurige Laute von sich gibt,\\nsolltet ihr besonders lieb zu ihm sein.[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
