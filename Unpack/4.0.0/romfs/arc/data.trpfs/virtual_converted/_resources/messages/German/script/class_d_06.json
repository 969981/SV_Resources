      "hash64": "F1C0A898E7E14D2E",
      "text": "Und an dieser Stelle ein Tipp von mir an euch![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
