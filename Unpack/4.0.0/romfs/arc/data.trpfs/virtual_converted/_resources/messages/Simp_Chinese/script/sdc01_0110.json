      ]
    },
    {
      "ordinal": 37,
      "label": "sdc01_0110_brother_11",
      "hash64": "EDA34A03CD2164A9",
      "text": "姐姐！你耍赖！[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
