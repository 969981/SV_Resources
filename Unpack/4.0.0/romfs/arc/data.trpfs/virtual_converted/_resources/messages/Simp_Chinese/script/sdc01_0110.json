          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "sdc01_0110_gfather_08",
      "hash64": "A482ECB3042500A8",
      "text": "我孙子和孙女，\\n就麻烦你多关照了。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "sdc01_0110_gmother_12",
      "hash64": "24BE959E9306FEBC",
      "text": "面具放在旁边的仓库里，\\n我记得……有３个才对。\\r\\n你们要互相谦让哦。[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
