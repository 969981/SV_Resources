          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc01_0110_gfather_06",
      "hash64": "A482EAB30424FD42",
      "text": "那里的门没锁，\\n你们一起去拿吧。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc01_0110_sister_05",
      "hash64": "0F087F773724E846",
      "text": "好嘞！是在旁边的仓库吧！\\n先到先得～！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
