      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc01_0110_brother_03",
      "hash64": "EDA65003CD23A4B2",
      "text": "啊！？是、是这样吗！？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
