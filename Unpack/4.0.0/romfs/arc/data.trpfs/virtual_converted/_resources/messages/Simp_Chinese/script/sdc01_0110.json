        }
      ]
    },
    {
      "ordinal": 38,
      "label": "sdc01_0110_gfather_07",
      "hash64": "A482EBB30424FEF5",
      "text": "[VAR 0x0100(0000)]……\\n他们太吵闹，让你见笑了。[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
