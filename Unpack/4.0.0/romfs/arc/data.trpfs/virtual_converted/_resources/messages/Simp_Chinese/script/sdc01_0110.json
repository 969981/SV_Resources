      "label": "sdc01_0110_gmother_11",
      "hash64": "24BE989E930703D5",
      "text": "面具啊～应该是去年\\n放到旁边的仓库里了。[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
