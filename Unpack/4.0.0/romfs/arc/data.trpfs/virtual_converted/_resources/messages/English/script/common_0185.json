      ]
    },
    {
      "ordinal": 4,
      "label": "common_0185_rival_02a",
      "hash64": "9F6E59D5142453C8",
      "text": "And aren’t you the son of that Pokémon\\nresearcher—Professor Sada?[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
