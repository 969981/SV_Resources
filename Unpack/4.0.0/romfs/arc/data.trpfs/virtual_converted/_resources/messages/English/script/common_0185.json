      "label": "common_0185_rival_02b",
      "hash64": "9F6E5CD5142458E1",
      "text": "And aren’t you the son of that Pokémon\\nresearcher—Professor Turo?[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
