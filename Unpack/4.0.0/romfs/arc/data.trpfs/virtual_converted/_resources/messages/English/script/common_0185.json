    {
      "ordinal": 3,
      "label": "common_0185_rival_01",
      "hash64": "098B54400C67A460",
      "text": "Wait, I know you... Aren’t you Arven?\\nYou’re enrolled in the humanities track, right?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
