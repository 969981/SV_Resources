          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "class_e_05_battle_02",
      "hash64": "5EED106A18CAE9BD",
      "text": "Tengo que felicitaros a todos por lo bien que\\nhabéis afrontado el examen parcial.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_e_05_battle_03",
      "hash64": "5EED0F6A18CAE80A",
      "text": "¡Con la lección de hoy comienza el segundo\\nasalto de esta asignatura!\\c\\nOs quiero ver a todos al pie del cañón.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_e_05_battle_04",
      "hash64": "5EED0A6A18CADF8B",
      "text": "¿Habéis usado alguna vez el botón R para pedir\\nayuda a vuestro Pokémon con ciertas tareas?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_e_05_battle_05",
      "hash64": "5EED096A18CADDD8",
      "text": "Pulsarlo os permitirá enviarlo a explorar en la\\ndirección en la que miráis.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_e_05_battle_06",
      "hash64": "5EED0C6A18CAE2F1",
      "text": "¿Que queréis recoger un objeto lejano sin ir\\nhasta él? ¡Para eso está el botón R![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_e_05_battle_07",
      "hash64": "5EED0B6A18CAE13E",
      "text": "Si enviáis a vuestro Pokémon contra un Pokémon\\nsalvaje, ¡se pondrán a combatir en el acto![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_e_05_battle_08",
      "hash64": "5EED066A18CAD8BF",
      "text": "Esa clase de combates se denomina \"combates\\nlibres\".[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_e_05_battle_09",
      "hash64": "5EED056A18CAD70C",
      "text": "Como su nombre indica, son combates en los\\ncuales los Pokémon actúan por su cuenta,\\r\\n¡sin necesidad de que les deis instrucciones![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_e_05_battle_10",
      "hash64": "5EEA086A18C8A64E",
      "text": "Por supuesto, al vencer recibirán puntos de\\nexperiencia, como siempre.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_e_05_battle_11",
      "hash64": "5EEA096A18C8A801",
      "text": "Aprovechad bien los combates libres y podréis\\nentrenar a vuestro equipo de forma eficiente.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_e_05_battle_12",
      "hash64": "5EEA066A18C8A2E8",
      "text": "Eso sí, tened en cuenta que, si un Pokémon sube\\nde nivel durante un combate libre, no aprenderá\\r\\nel movimiento que le correspondería por subir a\\r\\nese nivel ni tampoco evolucionará.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 184,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_e_05_battle_13",
      "hash64": "5EEA076A18C8A49B",
      "text": "Por último, recordad que, si un Pokémon pierde\\nun combate libre, volverá a vosotros con muy\\r\\npocos PS y tendréis que curarlo cuanto antes.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_e_05_battle_14",
      "hash64": "5EEA0C6A18C8AD1A",
      "text": "Bueno, creo que con eso he cubierto todo lo\\nbásico. ¿Alguna pregunta?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_e_05_select_01",
      "hash64": "8C797B09D4DE44AA",
      "text": "¿Se puede cancelar un combate libre?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "class_e_05_select_02",
      "hash64": "8C797A09D4DE42F7",
      "text": "¿Se puede usar para atrapar Pokémon?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "class_e_05_select_03",
      "hash64": "8C797909D4DE4144",
      "text": "Lo tengo todo claro",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_e_05_battle_answer_01",
      "hash64": "476C1EE7B64FE445",
      "text": "¡Buena pregunta! Una vez que un combate libre\\nha comenzado, no se puede cancelar.\\c\\nAunque podéis cancelarlo antes de que empiece\\npulsando el botón ZR mientras vuestro Pokémon\\r\\nse está desplazando.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 176,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 200,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "class_e_05_battle_answer_02",
      "hash64": "476C1BE7B64FDF2C",
      "text": "En los combates libres, vuestro Pokémon se\\ncentrará en derrotar al rival.\\c\\nSi lo que queréis es atrapar un Pokémon, tendréis\\nque darle instrucciones a vuestro equipo.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 168,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "class_e_05_battle_answer_03",
      "hash64": "476C1CE7B64FE0DF",
      "text": "¡Muy bien! Si es que sois una clase buenísima.\\n¡Tengo ganas de ver qué os depara el futuro![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "class_e_05_battle_15",
      "hash64": "5EEA0D6A18C8AECD",
      "text": "Nunca olvidéis que, durante los combates libres,\\nlos Pokémon lo dan todo por vosotros.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_e_05_battle_16",
      "hash64": "5EEA0A6A18C8A9B4",
      "text": "Si veis que lo están pasando mal, es vuestra\\nresponsabilidad como Entrenadores retirarlos\\r\\ndel combate.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_e_05_battle_17",
      "hash64": "5EEA0B6A18C8AB67",
      "text": "Y sobra decirlo, pero... un Pokémon con los\\nPS bajos no está en condiciones de combatir.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_e_05_battle_18",
      "hash64": "5EEA006A18C898B6",
      "text": "Tenedlos en consideración, pues no apreciarán\\nque los enviéis a un combate libre en ese estado.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_e_05_battle_19",
      "hash64": "5EEA016A18C89A69",
      "text": "¡Resumiendo![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_e_05_battle_20",
      "hash64": "5EE6826A18C58CC5",
      "text": "Los combates libres se basan en la confianza\\nentre Entrenadores y Pokémon.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_e_05_battle_21",
      "hash64": "5EE6816A18C58B12",
      "text": "Debéis usarlos con responsabilidad y no dejar de\\nvelar nunca por vuestros Pokémon.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_e_05_battle_22",
      "hash64": "5EE6806A18C5895F",
      "text": "¡Grr! ¡Se me ha vuelto a echar el tiempo encima!\\nPues os quedáis sin clase práctica ya, lo siento.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_e_05_battle_23",
      "hash64": "5EE67F6A18C587AC",
      "text": "¡Os dejo libres! ¡Pasad un buen día![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    }
  ]
