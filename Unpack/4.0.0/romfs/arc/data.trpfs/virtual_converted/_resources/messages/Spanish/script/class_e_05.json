    {
      "ordinal": 0,
      "label": "class_e_05_battle_01",
      "hash64": "5EED0D6A18CAE4A4",
      "text": "¡Ey, hola de nuevo! ¡Espero que estéis con ganas\\nde otra clase de Combate![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
