      ]
    },
    {
      "ordinal": 54,
      "label": "common_1100_hakase_03a",
      "hash64": "CD633E5E4751A1A4",
      "text": "我託付給[VAR 0x0100(0000)]的\\n故勒頓……[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
