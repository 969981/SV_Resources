          "args_hex": [
            "000B"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "common_1100_hakase_03b",
      "hash64": "CD63415E4751A6BD",
      "text": "我託付給[VAR 0x0100(0000)]的\\n密勒頓……[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
