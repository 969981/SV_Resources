          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000E"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "common_1100_hakase_04a",
      "hash64": "CD4B365E473D022B",
      "text": "是我在研究時光機的過程中，\\n第一次從古代傳送過來的寶可夢。[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000B"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "common_1100_hakase_04b",
      "hash64": "CD4B375E473D03DE",
      "text": "是我在研究時光機的過程中，\\n第一次從未來傳送過來的寶可夢。[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000E"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "common_1100_friend_15",
      "hash64": "841CA8A6909A481F",
      "text": "果然是這樣……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "common_1100_hakase_05a",
      "hash64": "CD4E5A5E473F752E",
      "text": "分析牠的基因數據\\n以及行為模式後，可知……[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000B"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "common_1100_hakase_05b",
      "hash64": "CD4E595E473F737B",
      "text": "分析牠的基因數據\\n以及行為模式後，可知……[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000E"
          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "common_1100_hakase_06a",
      "hash64": "CD52425E4743353D",
      "text": "牠是一般的坐騎寶可夢\\n摩托蜥在古代的樣子。\\r\\n……這是目前已經能確定的事。[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000B"
          ]
        }
      ]
    },
    {
      "ordinal": 62,
      "label": "common_1100_hakase_06b",
      "hash64": "CD523F5E47433024",
      "text": "牠是一般的坐騎寶可夢\\n摩托蜥在未來的樣子。\\r\\n……這是目前已經能確定的事。[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000E"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "common_1100_botan_09",
      "hash64": "E83495F91EB5586C",
      "text": "這麼說來，\\n的確有點像？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "common_1100_hakase_07a",
      "hash64": "CD55265E47453B80",
      "text": "其他也有許多寶可夢\\n超越時空來到現代。[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000B"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "common_1100_hakase_07b",
      "hash64": "CD55295E47454099",
      "text": "其他也有許多寶可夢\\n超越時空來到現代。[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000E"
          ]
        }
      ]
    },
    {
      "ordinal": 66,
      "label": "common_1100_hakase_08a",
      "hash64": "CD3D5E5E473108C7",
      "text": "但是，[VAR 0x0101(0001)]的種族\\n一共只成功傳送了２隻過來。[VAR 0x0114(000B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000B"
          ]
        }
      ]
    },
    {
      "ordinal": 67,
      "label": "common_1100_hakase_08b",
      "hash64": "CD3D5F5E47310A7A",
      "text": "但是，[VAR 0x0101(0001)]的種族\\n一共只成功傳送了２隻過來。[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000E"
          ]
        }
      ]
    },
    {
      "ordinal": 68,
      "label": "common_1100_friend_16",
      "hash64": "841CA9A6909A49D2",
      "text": "啥？也就是說那傢伙\\n……還有一隻同種族的！？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 69,
      "label": "common_1100_rival_15",
      "hash64": "0E5E6CBD5900CD0B",
      "text": "牠們會不會是來自同家族的！？\\n另１隻說不定正在第零區的哪裡\\r\\n等著[VAR 0x0101(0001)]呢！？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 70,
      "label": "common_1100_botan_10",
      "hash64": "E83118F91EB24E2E",
      "text": "感動的重逢……？[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 71,
      "label": "common_1100_rival_16",
      "hash64": "0E5E6DBD5900CEBE",
      "text": "嗯！要是能幫那孩子\\n找到家族，讓牠們重逢，\\r\\n那一定一定是件幸福的事！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 72,
      "label": "common_1100_friend_18",
      "hash64": "841CABA6909A4D38",
      "text": "家族啊。\\n嗯……蠻不錯的。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 73,
