    },
    {
      "ordinal": 52,
      "label": "common_1100_hakase_02b",
      "hash64": "CD5F575E474DE348",
      "text": "……接下來，\\n就由我來回答吧。[VAR 0x0114(000E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
