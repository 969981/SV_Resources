      "ordinal": 53,
      "label": "common_1100_rival_14",
      "hash64": "0E5E6BBD5900CB58",
      "text": "博士！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
