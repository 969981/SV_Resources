    {
      "ordinal": 25,
      "label": "kizuna_friend_d_19",
      "hash64": "141EF43C5754B100",
      "text": "Und damit ist meine Selbstfindungsphase\\nabgeschlossen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
