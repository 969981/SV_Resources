    {
      "ordinal": 2,
      "label": "kizuna_friend_d_03",
      "hash64": "141BF63C57527E8F",
      "text": "Boah, Mensch! Erschreck mich doch nich’ so!\\nIch war voll konzentriert...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
