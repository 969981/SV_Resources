    },
    {
      "ordinal": 7,
      "label": "kizuna_friend_d_select_02",
      "hash64": "2DAEA269789498AD",
      "text": "Ordentlicher als gedacht![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
