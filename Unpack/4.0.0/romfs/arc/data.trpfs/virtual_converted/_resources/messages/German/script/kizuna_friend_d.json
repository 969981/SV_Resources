          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_friend_d_04",
      "hash64": "141BF33C57527976",
      "text": "Hehe, sieht man nicht oft, ne?\\nWie ich konzentriert büffel.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_friend_d_05",
      "hash64": "141BF43C57527B29",
      "text": "Aber ich wollte sowieso grad Schluss machen.\\nLass uns woanders hingehen![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_friend_d_06",
      "hash64": "141BF13C57527610",
      "text": "Na, was sagst du? Hier wohnen Mastifioso\\nund ich.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
