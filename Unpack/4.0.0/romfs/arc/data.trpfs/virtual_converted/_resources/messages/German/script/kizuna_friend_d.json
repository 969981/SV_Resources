          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_friend_d_20",
      "hash64": "1414EB3C574C4D30",
      "text": "So, und jetzt hab ich einen Traum zu\\nverwirklichen![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_friend_d_21",
      "hash64": "1414EC3C574C4EE3",
      "text": "Was dich aber nicht davon abhalten soll, hier bei\\nuns vorbeizuschauen, wann immer du willst![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_friend_d_22",
      "hash64": "1414ED3C574C5096",
      "text": "Mastifioso würde sich bestimmt auch über\\neinen Besuch von dir freuen![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
