      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_friend_d_07a",
      "hash64": "7DF43E8861214846",
      "text": "Hehe, so sieht’s aus!\\c\\n...\\c\\nMoment, wie meinst du das?![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_friend_d_07b",
      "hash64": "7DF43D8861214693",
      "text": "Wie hast du dir meine Bude denn vorgestellt?!\\nMastifioso haart ganz schön, da muss ich jeden\\r\\nTag sauber machen.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_friend_d_08",
      "hash64": "141BFF3C57528DDA",
      "text": "Aber ja, du fragst dich sicher, warum ich im\\nKlassenzimmer am Lernen war...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_friend_d_09a",
      "hash64": "7E245288614A8E04",
      "text": "Ich hab neulich seit Langem mal wieder über die\\nGeheimgewürze im Karmesinbuch gelesen...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_friend_d_09b",
      "hash64": "7E245588614A931D",
      "text": "Ich hab neulich seit Langem mal wieder über die\\nGeheimgewürze im Purpurbuch gelesen...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_friend_d_10",
      "hash64": "141EFD3C5754C04B",
      "text": "Da musste ich an die Zeit denken, in der es\\nMastifioso gar nicht gut ging.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_friend_d_11",
      "hash64": "141EFC3C5754BE98",
      "text": "Das war damals echt hart für mich.\\nDieses schreckliche Gefühl der Hilflosigkeit...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_friend_d_12",
      "hash64": "141EFF3C5754C3B1",
      "text": "Ich hatte echt Glück, dich zu treffen und mit dir\\ndie Geheimgewürze auftreiben zu können.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_friend_d_13",
      "hash64": "141EFE3C5754C1FE",
      "text": "Aber da draußen gibt’s bestimmt noch andere\\nLeute, deren Pokémon es nicht gut geht und die\\r\\nweniger Glück haben.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
