  "entries": [
    {
      "ordinal": 0,
      "label": "sdc02_0000_system_01",
      "hash64": "8041F6D75EEEC498",
      "text": "*brrring-rrring*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "sdc02_0000_headteacher_01",
      "hash64": "93CFB7D06897C4A1",
      "text": "Hallo, [VAR 0x0100(0000)]. Hier spricht Clavel.\\c\\nHättest du gerade etwas Zeit oder kommt mein\\nAnruf ungelegen?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0000_select_01",
      "hash64": "D46CCE93A8067D63",
      "text": "Hallihallo, Direktor Clavel!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sdc02_0000_select_02",
      "hash64": "D46CCF93A8067F16",
      "text": "Ja, ich hab reichlich Zeit!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sdc02_0000_headteacher_02",
      "hash64": "93CFB4D06897BF88",
      "text": "Ohoho, du wirkst aber gut gelaunt.\\nDas freut mich![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0000_headteacher_03",
      "hash64": "93CFB5D06897C13B",
      "text": "Ich möchte dich nicht zu lange aufhalten,\\ndaher komme ich gleich zur Sache.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0000_headteacher_04",
      "hash64": "93CFBAD06897C9BA",
      "text": "Ich rufe an, weil ich dir ein besonderes Angebot\\nunterbreiten möchte.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0000_headteacher_06",
      "hash64": "93CFB8D06897C654",
      "text": "Ist dir die [VAR 0xFF00(0006)]Blaubeer-Akademie[VAR 0xFF00(0000)] in der\\nEinall-Region ein Begriff?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0000_select_03",
      "hash64": "D46CD093A80680C9",
      "text": "Ja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "sdc02_0000_select_04",
      "hash64": "D46CD193A806827C",
      "text": "Noch nie gehört...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc02_0000_headteacher_07",
      "hash64": "93CFB9D06897C807",
      "text": "Richtig, du hast dich ja zusammen mit Schülern\\nder Akademie auf eine Exkursion begeben.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0000_headteacher_08",
      "hash64": "93CFAED06897B556",
      "text": "Nanu? Mir war zu Ohren gekommen, dass du dich\\nmit Schülern der Akademie auf eine Exkursion\\r\\nbegeben hast...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0000_headteacher_09",
      "hash64": "93CFAFD06897B709",
      "text": "Der Direktor besagter Blaubeer-Akademie ist\\njedenfalls ein alter Freund von mir.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0000_headteacher_10",
      "hash64": "93D33CD0689ADC77",
      "text": "Er möchte dich dort als [VAR 0x1100(00FF,1210,0000)]AustauschschülerAustauschschülerin\\nwillkommen heißen.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1210",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0000_headteacher_11",
      "hash64": "93D33BD0689ADAC4",
      "text": "Ich denke, das wäre eine grandiose Gelegenheit,\\ndeinen Horizont zu erweitern und mehr über\\r\\ndie Welt zu erfahren.\\c\\nBetrachte es als eine Herausforderung,\\nan der du noch weiter wachsen kannst![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 195,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0000_headteacher_12",
      "hash64": "93D33ED0689ADFDD",
      "text": "Allerdings frage ich mich schon, warum er gerade\\ndich dazu auserkoren hat...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0000_headteacher_13",
      "hash64": "93D33DD0689ADE2A",
      "text": "Ich würde vorschlagen, dass du dich zumindest\\nmal mit ihm triffst und ihn nach seinen\\r\\nBeweggründen fragst.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0000_headteacher_14",
      "hash64": "93D338D0689AD5AB",
      "text": "Er ist recht... exzentrisch, aber mach dir keine\\nSorgen. Ich werde auch vor Ort sein.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0000_headteacher_15",
      "hash64": "93D337D0689AD3F8",
      "text": "Bitte komm in mein Büro, wenn du eine\\nEntscheidung getroffen hast. Dann können\\r\\nwir alles Weitere besprechen.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0000_headteacher_17",
      "hash64": "93D339D0689AD75E",
      "text": "Oh! Aber konzentriere dich ruhig erst mal auf\\ndeine Exkursion. Diese Angelegenheit kann\\r\\nauch noch etwas warten.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc02_0000_headteacher_16",
      "hash64": "93D33AD0689AD911",
      "text": "Nun denn... Ich will dich nicht weiter stören,\\ndu hast sicher viel zu tun.\\c\\nGib weiterhin gut auf dich acht.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    }
  ]
}
