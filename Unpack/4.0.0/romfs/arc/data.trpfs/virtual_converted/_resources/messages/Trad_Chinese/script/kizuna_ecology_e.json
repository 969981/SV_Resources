    {
      "ordinal": 0,
      "label": "kizuna_ecology_e_01",
      "hash64": "39248A9414F0BA5C",
      "text": "啊，[VAR 0x0100(0000)]。\\n[VAR 0x1100(00FF,0101)]你妳好啊～[VAR 0x1100(00FF,0101)]你妳好！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
