      "label": "gym_kusa_020_kusapoke_01",
      "hash64": "F9094E7956873DEE",
      "text": "啊，找到向日花怪了！\\c\\n……向日花怪会跟着\\n[VAR 0x0100(0000)]走了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
