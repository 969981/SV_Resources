    },
    {
      "ordinal": 4,
      "label": "gym_kusa_020_receptionist_05",
      "hash64": "01E16B63DBE196D4",
      "text": "它们会待在高处或是建筑物后面等\\n让人意想不到的地方。\\r\\n尝试从多个角度去找它们吧。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_kusa_020_receptionist_09",
      "hash64": "01E15F63DBE18270",
      "text": "如果你收集了１０只向日花怪，\\n就把它们带到向日花怪广场吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
