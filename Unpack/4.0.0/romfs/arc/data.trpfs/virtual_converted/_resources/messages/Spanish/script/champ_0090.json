          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "champ_0090_rival_02",
      "hash64": "B8B33A8EC4CCA9BE",
      "text": "¿Acabas de conseguir otra medalla?\\n¡Enhorabuena![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "champ_0090_rival_03",
      "hash64": "B8B33B8EC4CCAB71",
      "text": "A ver cuántas tienes... ¡Hala, pero si es la cuarta!\\nVaya ritmo llevas, ¿no?[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0090_rival_04",
      "hash64": "B8B33C8EC4CCAD24",
      "text": "Has conseguido reunir la mitad de las medallas.\\n¡Qué bien! Tu esfuerzo está dando sus frutos.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0090_rival_05",
      "hash64": "B8B33D8EC4CCAED7",
      "text": "Te puedes imaginar que me encantaría retarte\\na un combate ahora mismo, peeero...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0090_rival_06",
      "hash64": "B8B33E8EC4CCB08A",
      "text": "Resulta que el equipo que tengo ahora mismo\\nestá pensado para afrontar este gimnasio en\\r\\nconcreto... ¡Ya es mala suerte![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0090_rival_07",
      "hash64": "B8B33F8EC4CCB23D",
      "text": "Prefiero que echemos un combate otro día en\\ncondiciones más ideales, si no te importa.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0090_rival_08",
      "hash64": "B8B3308EC4CC98C0",
      "text": "Menudo chasco, en serio... Pero bueno, la vida\\nes así. La próxima vez no te libras, ¿eh?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0090_rival_09",
      "hash64": "B8B3318EC4CC9A73",
      "text": "¡Mil perdones! ¡Hasta luego![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
