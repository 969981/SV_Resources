      "ordinal": 16,
      "label": "s2_side01_0060_botan_04",
      "hash64": "8ED4DC1301A4218A",
      "text": "앗, 진짜!?\\n나도 그 마음 잘 알아![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
