      "ordinal": 17,
      "label": "s2_side01_0060_friend_03",
      "hash64": "D4D6F46B0ECED34F",
      "text": "아앗! 모란, 이 배신자![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
