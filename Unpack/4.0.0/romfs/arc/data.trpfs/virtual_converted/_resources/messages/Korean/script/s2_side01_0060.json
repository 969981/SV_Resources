          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side01_0060_botan_03",
      "hash64": "8ED4D71301A4190B",
      "text": "다짜고짜 서열 정리?[VAR 0x0114(0008)]",
