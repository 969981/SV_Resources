    },
    {
      "ordinal": 12,
      "label": "s2_side01_0060_friend_02",
      "hash64": "D4D6F36B0ECED19C",
      "text": "내 이름은 페퍼.\\n[VAR 0x0100(0000)]의 가장 친한 친구지![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
