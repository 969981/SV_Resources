      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side01_0060_botan_02",
      "hash64": "8ED4D61301A41758",
      "text": "나는 모란.\\n친해지는 건 천천히 하자.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
