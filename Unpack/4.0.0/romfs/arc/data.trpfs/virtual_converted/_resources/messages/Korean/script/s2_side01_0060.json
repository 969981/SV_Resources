      "ordinal": 18,
      "label": "s2_side01_0060_friend_04",
      "hash64": "D4D6F16B0ECECE36",
      "text": "방금 친해지는 건\\n천천히 하자고 하지 않았냐?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
