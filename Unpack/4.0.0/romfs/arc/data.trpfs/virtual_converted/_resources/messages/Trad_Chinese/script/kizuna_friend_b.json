    {
      "ordinal": 1,
      "label": "kizuna_friend_b_02",
      "hash64": "EC8C2D4CC93A3B86",
      "text": "[VAR 0x1100(00FF,0101)]你妳看看這個！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
