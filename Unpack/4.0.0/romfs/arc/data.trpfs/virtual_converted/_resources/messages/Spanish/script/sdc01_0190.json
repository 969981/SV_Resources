      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc01_0190_select_04",
      "hash64": "CC1E20A6B4AF6805",
      "text": "Te has perdido al o...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc01_0190_sister_07",
      "hash64": "41F0BC6CE512C488",
      "text": "¡Ooo a lo mejor no era nada! ¡Eso es!\\n♪¡La, la, la!♪[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
