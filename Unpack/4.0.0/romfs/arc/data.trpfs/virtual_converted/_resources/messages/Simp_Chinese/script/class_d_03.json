      "ordinal": 23,
      "label": "class_d_03_language_16",
      "hash64": "E419944E64772043",
      "text": "吵架时best的解决方式\\n就是尽早道歉！[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
