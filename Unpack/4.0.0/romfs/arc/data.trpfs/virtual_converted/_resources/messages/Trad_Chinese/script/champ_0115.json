      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "champ_0115_ecology_03a",
      "hash64": "DE054D390646C078",
      "text": "哦哦～真帥氣。\\n[VAR 0x1100(00FF,0101)]你妳的目標很明確呢～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
