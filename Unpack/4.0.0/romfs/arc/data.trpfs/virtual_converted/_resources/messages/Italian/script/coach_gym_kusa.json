    },
    {
      "ordinal": 59,
      "label": "coach_gym_kusa_randomtalk_04",
      "hash64": "1FDB021F72B4CF6F",
      "text": "Come sta il Sunflora che ti ho affidato?\\nRigoglioso come sempre?\\c\\nRicorda di non fargli mancare mai luce\\nsolare e acqua.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
