    {
      "ordinal": 51,
      "label": "coach_gym_kusa_reward_00",
      "hash64": "B18D4AC0CF981C95",
      "text": "Hai ricevuto la [VAR 0xFF00(0008)]Cover Sunflora arreso [VAR 0xFF00(0000)]da Brassius!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
