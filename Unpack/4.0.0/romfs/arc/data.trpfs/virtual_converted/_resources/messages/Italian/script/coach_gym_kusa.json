    },
    {
      "ordinal": 52,
      "label": "coach_gym_kusa_battleend_win_01_00",
      "hash64": "AE478101CDB0DAAC",
      "text": "Aaahahahah! La mia sconfitta è stata\\nun autentico capolavoro!\\c\\nOra che mi hai reso concime, è giusto\\nche tu riceva questo pegno.[VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
