    {
      "ordinal": 0,
      "label": "kizuna_battle_d_01",
      "hash64": "5575ABBF491CF45B",
      "text": "嘿呀！轉學生！\\n[VAR 0x1100(00FF,0101)]你妳來買東西嗎！？[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
