    {
      "ordinal": 0,
      "label": "common_0310_rival_01",
      "hash64": "F9E34BBA498377F4",
      "text": "스마트로토무의 지도 앱을 사용하면\\n직접 목적지를 설정할 수 있어![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
