    {
      "ordinal": 10,
      "label": "common_0310_system_01",
      "hash64": "9D8B2787FDF22CEF",
      "text": "로토로토로토로토...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "common_0310_friend_05",
      "hash64": "65968BFC050EA194",
      "text": "응? [VAR 0x0100(0000)],\\n네 전화 아니야?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
