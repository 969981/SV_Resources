          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0310_friend_02",
      "hash64": "65968AFC050E9FE1",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)]\\n나와 같이 주인 포켓몬을 찾아서\\r\\n스파이스를 손에 넣어야 하니까\\r\\n챔피언이 될 여유 따윈 없다고.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
