      ]
    },
    {
      "ordinal": 6,
      "label": "common_0310_friend_03",
      "hash64": "659689FC050E9E2E",
      "text": "비전스파이스를 지키는 주인의 거처에\\n같이 가 줄 거지!?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
