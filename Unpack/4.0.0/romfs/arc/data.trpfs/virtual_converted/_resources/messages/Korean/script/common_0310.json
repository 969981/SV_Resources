            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "common_0310_friend_06",
      "hash64": "65968EFC050EA6AD",
      "text": "그래, 맞아!\\n이 녀석은 나와 같이\\r\\n굉장한 식재료를 찾으러 가야 한다고![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
