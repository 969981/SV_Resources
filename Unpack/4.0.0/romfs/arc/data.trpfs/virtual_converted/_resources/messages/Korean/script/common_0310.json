    {
      "ordinal": 27,
      "label": "common_0310_rival_10",
      "hash64": "F9DFC6BA4980601E",
      "text": "자! 이야기는 이쯤 하고!\\n모험을 시작해 볼까![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
