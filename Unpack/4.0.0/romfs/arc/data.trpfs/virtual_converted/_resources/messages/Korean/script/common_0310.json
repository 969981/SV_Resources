          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "common_0310_botan_09",
      "hash64": "269F34F80545984A",
      "text": "...결정하는 것은 [VAR 0x0100(0000)]의\\n몫이라고 하지 않았나? 네모, 그리고 페퍼.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
