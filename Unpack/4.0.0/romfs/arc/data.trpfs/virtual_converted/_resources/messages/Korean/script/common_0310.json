          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0310_friend_01",
      "hash64": "659687FC050E9AC8",
      "text": "학생회장 네모!\\n비겁하게 선수를 치다니![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0310_rival_03",
      "hash64": "F9E34DBA49837B5A",
      "text": "우와아! 페퍼!?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0310_rival_04",
      "hash64": "F9E348BA498372DB",
      "text": "선수를 치다니, 나를 나쁜 사람으로 만드네!\\n나는 그냥 체육관을 추천했을 뿐이야!\\c\\n무엇을 할지 결정하는 건\\n[VAR 0x0100(0000)] 본인 몫이라구![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
