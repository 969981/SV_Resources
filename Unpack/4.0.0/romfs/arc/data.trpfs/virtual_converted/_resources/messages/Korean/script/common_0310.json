      ]
    },
    {
      "ordinal": 1,
      "label": "common_0310_rival_02",
      "hash64": "F9E34EBA49837D0D",
      "text": "지난번에 등록해 준 체육관이 있는 장소를\\n목적지로 설정해 보는 건 어때?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
