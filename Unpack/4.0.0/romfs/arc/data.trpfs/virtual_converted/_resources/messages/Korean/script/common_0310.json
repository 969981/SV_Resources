          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0310_friend_04",
      "hash64": "65968CFC050EA347",
      "text": "흥! 나도 권유만 했을 뿐이야.\\n결정하는 건 [VAR 0x0100(0000)] 몫 아니었어?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
