          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0310_botan_01",
      "hash64": "269F2CF805458AB2",
      "text": "안녕하신가, [VAR 0x0100(0000)].\\n카시오페아다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0310_botan_02",
      "hash64": "269F2BF8054588FF",
      "text": "지난번에 말했던\\n스타더스트 대작전에 대해 설명해 주겠다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0310_botan_03",
      "hash64": "269F2AF80545874C",
      "text": "스타단에는 전부 5개의 팀이 있고\\n아지트도 각각 나눠져 있다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0310_botan_04",
      "hash64": "269F29F805458599",
      "text": "너는 각각의 아지트에 가서\\n각 팀의 보스 5명을 쓰러뜨리면 된다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0310_botan_05",
      "hash64": "269F28F8054583E6",
      "text": "조무래기 군단이 방해해 오겠지만\\n나도 멀리서 지원할 테니 안심해라.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0310_botan_06",
      "hash64": "269F27F805458233",
      "text": "보스들은 각 팀의 이름에 해당하는\\n타입의 포켓몬 전문가...\\r\\n하지만 너라면 문제없을 거다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0310_botan_07",
      "hash64": "269F26F805458080",
      "text": "그럼, 작전을 수행할 수 있게\\n아지트의 위치를 등록해 주겠다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_0310_botan_08",
      "hash64": "269F35F8054599FD",
      "text": "보스를 쓰러뜨릴 때마다\\n보수는 두둑하게 지급하도록 하지.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0310_rival_07",
      "hash64": "F9E349BA4983748E",
      "text": "갑자기 너는 누구야!?\\n스타단은 불량하고 위험하잖아!\\r\\n[VAR 0x0100(0000)][VAR 0x1900(0006)]랑 엮으려 하지 말라고![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
