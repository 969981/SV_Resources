    },
    {
      "ordinal": 3,
      "label": "coach_gym_denki_sp01_01",
      "hash64": "8F15F8F6083A7C00",
      "text": "“道馆馆主奇树！\\n 潜入传闻中的学园！”[VAR 0x0114(0019)]",
