          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_gym_denki_randomtalk_01",
      "hash64": "B34D926F0D34F223",
      "text": "我的粉丝有很多是学生，\\n所以在蓝莓也有很～多人认识我！\\c\\n到海的另一边也招人爱，不愧是我！\\n电电★直播主～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
