    },
    {
      "ordinal": 4,
      "label": "coach_gym_denki_sp01_02",
      "hash64": "8F15FBF6083A8119",
      "text": "……我正在努力\\n构思制作这样的视频哦！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
