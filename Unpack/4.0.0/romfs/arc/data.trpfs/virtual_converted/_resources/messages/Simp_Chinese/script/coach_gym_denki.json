        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_denki_sp01_03",
      "hash64": "8F15FAF6083A7F66",
      "text": "[VAR 0x0100(0000)]～\\n学园里有什么做视频的题材吗～？[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
