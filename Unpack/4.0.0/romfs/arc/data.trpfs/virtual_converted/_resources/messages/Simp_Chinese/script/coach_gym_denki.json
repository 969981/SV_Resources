          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_denki_randomtalk_02",
      "hash64": "B34D936F0D34F3D6",
      "text": "早中晚上好哈啰～\\n这句话里混着各种问候哦，你知道吗？\\c\\n这是随时随地都能使用的问候语！\\n是我想出来的哦～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_gym_denki_randomtalk_03",
      "hash64": "B34D946F0D34F589",
      "text": "你给我的[VAR 0x0101(0001)]\\n我培育得很精心哦！\\c\\n说不定它将来会成为\\n奇树奇述直播的招牌宝可梦～！[VAR 0x0114(0019)]",
