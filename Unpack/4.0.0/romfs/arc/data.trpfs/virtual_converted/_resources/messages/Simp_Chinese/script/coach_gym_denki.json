          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_denki_sp01_06",
      "hash64": "8F15FFF6083A87E5",
      "text": "那奇好～\\n我要马上准备制作视频咯！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_denki_sp02_00",
      "hash64": "B9940FEABED1F364",
      "text": "啊！[VAR 0x0100(0000)]！\\n早中晚上好哈啰～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_gym_denki_sp02_01",
      "hash64": "B99410EABED1F517",
      "text": "前阵子我用你提供的题材\\n制作了视频……[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_gym_denki_sp02_02",
      "hash64": "B99411EABED1F6CA",
      "text": "内容就是讲生态巨蛋，\\n爆红了哦～！\\c\\n我头上的小磁怪在电气石岩窟中\\n失控的那一段是精华片段哦！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_denki_sp02_02b",
      "hash64": "289119E23EC61F78",
      "text": "内容就是讲蓝莓联盟，\\n反响不错哦～！\\c\\n看到学生们努力的样子，\\n大伙果然都很容易投入感情啊！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_denki_sp02_02c",
      "hash64": "28911AE23EC6212B",
      "text": "校长的登场\\n让观看人数神速飙升！！\\c\\n那个人到底是何方神圣！？\\n他不是外行吧！？\\c\\n我差点就连个性都输给他了，\\n世界上真的有怪物啊……[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_denki_sp02_03",
      "hash64": "B99412EABED1F87D",
      "text": "学园也对我的视频表示很赞，\\n还说“是个很棒的宣传”！\\r\\n嘻、嘻嘻……[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_denki_sp02_04",
      "hash64": "B9940BEABED1EC98",
      "text": "我会继续\\n在蓝莓寻找题材的。[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_denki_sp02_05",
      "hash64": "B9940CEABED1EE4B",
      "text": "如果你有什么好题材，\\n就只告诉我一人吧～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_denki_sp03_00",
      "hash64": "B858C5E597C45A55",
      "text": "[VAR 0x0100(0000)]！\\n我都知道哦～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_denki_sp03_01",
      "hash64": "B858C4E597C458A2",
      "text": "你一直都遵守着\\n我们的约定！\\r\\n不上其他直播主的视频！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_denki_sp03_02",
      "hash64": "B858C3E597C456EF",
      "text": "你年轻可爱，还是冠军，\\n明明特征如此极端，\\r\\n却还能让人这么感激你……！！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_gym_denki_sp03_03",
      "hash64": "B858C2E597C4553C",
      "text": "我说[VAR 0x0100(0000)]，你是打算\\n今后也只和我合演吗……！？[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_denki_sp03_select_01",
      "hash64": "A8DC749BDE133331",
      "text": "是的",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_gym_denki_sp03_select_02",
      "hash64": "A8DC719BDE132E18",
      "text": "不是",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_gym_denki_sp03_04",
      "hash64": "B858C1E597C45389",
      "text": "不得了！你认真的吗！？\\n啊～我幸福得要升天了～！！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_denki_sp03_04b",
      "hash64": "03256420E29A9851",
      "text": "不！我看得出来哦！\\n虽然你嘴上这么说……\\c\\n但内心还是只想\\n和奇树我合演的对吧！？[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_denki_trade_01_00",
      "hash64": "47716A55F4999F77",
      "text": "那奇好～\\n快来办相关合同的手续吧！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_denki_trade_01_01",
      "hash64": "47716955F4999DC4",
      "text": "……哎呀！合同用的纸！\\n我忘了带来～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_denki_trade_01_02",
      "hash64": "47716C55F499A2DD",
      "text": "总之我们先来交换宝可梦，\\n就当这是暂定的合同吧！？[VAR 0x0114(0019)]",
