    {
      "ordinal": 2,
      "label": "common_2090_staff_03",
      "hash64": "C4F4F163999FC68D",
      "text": "OK, you’re all registered as a contestant. Please\\nhead down to the battle court.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_012_announce_00",
      "hash64": "835D61A437E8925A",
      "text": "Welcome, one and all, to another thrilling\\nAcademy Ace Tournament!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "sub_012_announce_01",
      "hash64": "835D62A437E8940D",
      "text": "Let’s get right to it and kick off the first round!\\nWho will the fates pair up today?!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_012_announce_02",
      "hash64": "835D5FA437E88EF4",
      "text": "Next up is the second round! I’m sure you’re\\nready to hear the matchup, so let’s get to it!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_012_announce_03",
      "hash64": "835D60A437E890A7",
      "text": "Finally, only four Trainers remain! Time for our\\ncontestants to face their third matches, everyone!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_012_announce_04",
      "hash64": "835D5DA437E88B8E",
      "text": "There’s one last match in this tournament, ladies\\nand gentlemen.\\c\\nThese two Trainers will be facing off to finally\\ndetermine who’s the strongest in the academy!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
