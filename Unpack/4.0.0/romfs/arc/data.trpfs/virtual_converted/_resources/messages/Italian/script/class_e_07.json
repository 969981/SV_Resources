    },
    {
      "ordinal": 13,
      "label": "class_e_07_battle_14",
      "hash64": "83C9B3680E1EC92C",
      "text": "Anche lottando con queste regole potrete avere\\npiù Pokémon o strumenti uguali.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
