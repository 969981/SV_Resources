            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_4kings_a_04_firebb_02",
      "hash64": "12D4F05DCDC654E3",
      "text": "[VAR 0x1100(00FF,0101)]你妳和烏栗之間\\n好像有些恩恩怨怨。[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_4kings_a_04_firebb_03",
      "hash64": "12D4EF5DCDC65330",
      "text": "杜若學長好像\\n也在盤算著什麼……[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_a_04_firebb_04",
      "hash64": "12D4F65DCDC65F15",
      "text": "這～些～事！\\n真的是有夠煩人的！！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_a_04_firebb_05",
      "hash64": "12D4F55DCDC65D62",
      "text": "有事的話，\\n就想說就說！想做就做！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_4kings_a_04_firebb_06",
      "hash64": "12D4F45DCDC65BAF",
      "text": "我就是不擅長去想那些\\n芝麻蒜皮的小事！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_a_04_firebb_07",
      "hash64": "12D4F35DCDC659FC",
      "text": "想對戰就對戰！\\n那樣不就好了嘛！！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_4kings_a_04_firebb_08",
      "hash64": "12D4FA5DCDC665E1",
      "text": "草原區，\\n火之四天王赤松！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_4kings_a_04_firebb_09",
      "hash64": "12D4F95DCDC6642E",
      "text": "我想贏，\\n所以讓我來打敗[VAR 0x1100(00FF,0101)]你妳吧！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_4kings_a_04_firebb_19",
      "hash64": "12D1755DCDC34E0B",
      "text": "好強～！讓我燃起大火了～！\\n[VAR 0x0100(0000)]，[VAR 0x1100(00FF,0101)]你妳真厲害！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_4kings_a_04_firebb_10",
      "hash64": "12D16C5DCDC33EC0",
      "text": "我啊！喜歡對戰和料理！\\n因為這兩件事情都簡單明瞭！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_4kings_a_04_firebb_11",
      "hash64": "12D16D5DCDC34073",
      "text": "對戰要麼輸，要麼贏！\\n料理要麼辣，要麼不辣！\\r\\n……很簡單吧？[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_4kings_a_04_firebb_12",
      "hash64": "12D16E5DCDC34226",
      "text": "但是現在的聯盟社，\\n不知為何就是讓人不自在，\\r\\n非常……複雜！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_4kings_a_04_firebb_13",
      "hash64": "12D16F5DCDC343D9",
      "text": "該怎麼辦才能回到\\n像以前那樣開心的社團活動呢……[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_4kings_a_04_firebb_14",
      "hash64": "12D1705DCDC3458C",
      "text": "我一不小心就變小火了，\\n但是[VAR 0x0100(0000)]！[VAR 0x1100(00FF,0101)]你妳真強！！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_4kings_a_04_firebb_15",
      "hash64": "12D1715DCDC3473F",
      "text": "將熊熊燃燒的熱情注入平底鍋！\\n連我火熱的心情也一起嚐嚐吧！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_4kings_a_04_firebb_16",
      "hash64": "12D1725DCDC348F2",
      "text": "我珍藏的這個食譜，\\n就交給[VAR 0x1100(00FF,0101)]你妳保管了。[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_4kings_a_04_firebb_17",
      "hash64": "12D1735DCDC34AA5",
      "text": "料理以外的火候，\\n我通通不懂～！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_4kings_a_04_firebb_18",
      "hash64": "12D1745DCDC34C58",
      "text": "所以呢，[VAR 0x0100(0000)]！\\n[VAR 0x1100(00FF,0101)]你妳要在藍莓聯盟燃燒啊！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 10,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_4kings_a_04_clerk_npc",
      "hash64": "98731273EA013D0D",
      "text": "恭喜[VAR 0x1100(00FF,0101)]你妳戰勝\\n四天王赤松！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
