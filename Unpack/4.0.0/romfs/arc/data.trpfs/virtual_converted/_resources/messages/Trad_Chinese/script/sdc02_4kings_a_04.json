      "label": "sdc02_4kings_a_04_firebb_01",
      "hash64": "12D4F15DCDC65696",
      "text": "那麼……[VAR 0x0100(0000)]！[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
