          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0010_bbteacher_05",
      "hash64": "D367CE83C7899FD9",
      "text": "哦哦，你有太晶珠啊！[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0010_bbteacher_06",
      "hash64": "D367CB83C7899AC0",
      "text": "不愧是资源丰富的\\n帕底亚地区的学校……\\r\\n不，应该是因为你特别优秀吧？[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0010_bbteacher_07",
      "hash64": "D367CC83C7899C73",
      "text": "哎呀，抱歉。\\n应该先自我介绍的，我是……[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0010_ecology_01",
      "hash64": "4FF114C5AFE0597B",
      "text": "白蕾雅老师～！\\n我迟到了，不好意思～！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0010_ecology_02",
      "hash64": "4FF115C5AFE05B2E",
      "text": "啊！[VAR 0x0100(0000)]，\\n你刚入学没多久就能参加夏令营，\\r\\n真是好幸运啊～！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0010_ecology_03",
      "hash64": "4FF116C5AFE05CE1",
      "text": "真好啊……\\n我也好想去啊～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0010_bbteacher_08",
      "hash64": "D367D983C789B28A",
      "text": "……咳咳！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0010_ecology_04",
      "hash64": "4FF117C5AFE05E94",
      "text": "啊，白蕾雅老师。\\n真是抱歉～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0010_bbteacher_09",
      "hash64": "D367DA83C789B43D",
      "text": "吉尼亚老师已经介绍过了，\\n我就是白蕾雅。\\r\\n在蓝莓学园当老师。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0010_ecology_05",
      "hash64": "4FF118C5AFE06047",
      "text": "那个学校在合众地区，\\n她可是那里的教务主任哦～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0010_bbteacher_10",
      "hash64": "D36B5783C78CBE7B",
      "text": "今年是蓝莓学园\\n负责带领学生，\\r\\n所以我来迎接[VAR 0x0100(0000)]你了。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0010_bbteacher_11",
      "hash64": "D36B5683C78CBCC8",
      "text": "北上乡以田园风光而闻名！\\n虽然有些土气，但是个奇妙的地方哦。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0010_bbteacher_12",
      "hash64": "D36B5983C78CC1E1",
      "text": "在那里检测出了和帕底亚地区的\\n太晶化现象相同的能量！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0010_bbteacher_13",
      "hash64": "D36B5883C78CC02E",
      "text": "我在担任领队的同时，\\n也很期待能顺便进行调查。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0010_bbteacher_14",
      "hash64": "D36B5B83C78CC547",
      "text": "希望今后也能让我\\n好好调查一下帕底亚巨坑的内部呀。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0010_ecology_06",
      "hash64": "4FF119C5AFE061FA",
      "text": "那里嘛，那个……\\n如果宝可梦联盟和克拉韦尔校长\\r\\n不批准的话，这事可不好说……[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0010_bbteacher_15",
      "hash64": "D36B5A83C78CC394",
      "text": "我当然知道。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0010_bbteacher_16",
      "hash64": "D36B5D83C78CC8AD",
      "text": "我已经申请了这件事，\\n很期待令人满意的答复哦。[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0010_ecology_07",
      "hash64": "4FF11AC5AFE063AD",
      "text": "唔嗯嗯嗯……[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0010_ecology_08",
      "hash64": "4FF10BC5AFE04A30",
      "text": "……啊！[VAR 0x0100(0000)]，\\n把你一个人晾在一边，真是不好意思～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0010_ecology_09",
      "hash64": "4FF10CC5AFE04BE3",
      "text": "总之～夏令营能把\\n寻宝的舞台拓展到帕底亚外部，\\r\\n是个千载难逢的机会～！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0010_ecology_10",
      "hash64": "4FF499C5AFE37151",
      "text": "我来帮你更新图鉴App，\\n能拿出你的手机洛托姆吗～？[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0010_system_01",
      "hash64": "306BFFA8711B1C1A",
      "text": "[VAR 0xFF00(0006)]北上图鉴[VAR 0xFF00(0000)]被添加到\\n[VAR 0x0100(0000)]的宝可梦图鉴里了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0010_ecology_11",
      "hash64": "4FF498C5AFE36F9E",
      "text": "好～成功咯！\\c\\n这样你也能随心所欲地添加\\n北上的宝可梦了～！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0010_ecology_12",
      "hash64": "4FF497C5AFE36DEB",
      "text": "已经获得你家长的同意了，\\n请尽情享受夏令营吧～！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0010_bbteacher_17",
      "hash64": "D36B5C83C78CC6FA",
      "text": "哈哈……吉尼亚真是\\n简单易懂，惹人喜爱呢！[VAR 0x0114(0042)]",
