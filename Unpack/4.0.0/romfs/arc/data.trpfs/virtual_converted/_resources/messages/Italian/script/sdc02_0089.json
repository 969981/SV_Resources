          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc02_0089_dragonbb_14",
      "hash64": "29C62005FA786707",
      "text": "Ouff! Quindi direi che possiamo dichiarare\\nterminato il periodo di prova![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0089_sister_09",
      "hash64": "CA068E2959B07A88",
      "text": "\"Periodo di prova\"? Chi ti dice che vuole\\niscriversi?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc02_0089_dragonbb_15",
      "hash64": "29C61F05FA786554",
      "text": "Certo che vuole iscriversi! Per quanto riguarda\\nil vecchio Aris, ormai siamo compagni di club!\\r\\nIn periodo di prova, chiaramente.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
