          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0089_dragonbb_25",
      "hash64": "29BC0F05FA6FF59F",
      "text": "... Ma che spiego a fare? Meglio la pratica.\\nProva un po’.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
