    },
    {
      "ordinal": 22,
      "label": "sdc02_0089_dragonbb_12",
      "hash64": "29C61E05FA7863A1",
      "text": "Una reazione promettente! Proprio quello\\nche speravo.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
