          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc02_0089_dragonbb_17",
      "hash64": "29C62105FA7868BA",
      "text": "Ah, quel computer ti tornerà utile.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
