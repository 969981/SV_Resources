          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc02_0089_dragonbb_16",
      "hash64": "29C62205FA786A6D",
      "text": "Puoi venire qui quando preferisci, e tutta\\nl’attrezzatura nella stanza è a tua disposizione.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
