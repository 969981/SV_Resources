    },
    {
      "ordinal": 15,
      "label": "coach_gym_esper_sp02_02b",
      "hash64": "F7C0B697ACE361E4",
      "text": "不對不對喲，[VAR 0x0100(0000)]。\\n那是某個奇怪藝術家的頭銜。\\c\\n莉普我是個彩妝藝術家！\\n[VAR 0x1100(00FF,0101)]你妳要好好記住。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
