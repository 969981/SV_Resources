    },
    {
      "ordinal": 5,
      "label": "coach_gym_esper_sp01_03",
      "hash64": "52A8E26EF1BB7BAA",
      "text": "莉普我的課程……對學生們來說\\n有點刺激，沒關係嗎？[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
