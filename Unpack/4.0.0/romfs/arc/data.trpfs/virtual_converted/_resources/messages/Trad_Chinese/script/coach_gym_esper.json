    {
      "ordinal": 21,
      "label": "coach_gym_esper_sp03_01",
      "hash64": "CE890C60F3760DA6",
      "text": "[VAR 0x1100(00FF,0101)]你妳能記住來自長輩的建議，\\n真了不起呀。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
