    },
    {
      "ordinal": 6,
      "label": "coach_gym_esper_sp01_04",
      "hash64": "52A8DD6EF1BB732B",
      "text": "如果出了什麼事，\\n[VAR 0x1100(00FF,0101)]你妳會負起責任的對吧？[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
