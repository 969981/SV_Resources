          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_esper_sp03_02",
      "hash64": "CE890B60F3760BF3",
      "text": "要讓自己的才能發揮到極致，\\n不斷發光發熱的約定……[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_esper_sp03_03",
      "hash64": "CE890A60F3760A40",
      "text": "看來完全不用擔心！\\n反倒是……嗯呵！\\r\\n莉普我甚至有點吃驚呢。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
