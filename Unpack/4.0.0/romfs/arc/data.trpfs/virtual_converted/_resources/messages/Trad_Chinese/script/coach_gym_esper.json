      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_gym_esper_sp02_02",
      "hash64": "FC4319675651BCEE",
      "text": "不對不對喲，[VAR 0x0100(0000)]。\\n雖說莉普我當起空服員也很適合就是了。\\c\\n莉普我是個彩妝藝術家！\\n[VAR 0x1100(00FF,0101)]你妳要好好記住。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
