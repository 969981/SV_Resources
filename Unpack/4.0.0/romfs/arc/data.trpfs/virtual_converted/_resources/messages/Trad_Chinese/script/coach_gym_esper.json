    },
    {
      "ordinal": 56,
      "label": "coach_gym_esper_randomtalk_03",
      "hash64": "EDF6111629A1CE6D",
      "text": "[VAR 0x0101(0001)]是一塊\\n非常好的料子，\\r\\n我會把牠培養得美美的喔。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
