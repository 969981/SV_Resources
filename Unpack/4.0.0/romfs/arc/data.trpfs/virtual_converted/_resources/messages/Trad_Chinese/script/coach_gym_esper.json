    {
      "ordinal": 54,
      "label": "coach_gym_esper_randomtalk_01",
      "hash64": "EDF60F1629A1CB07",
      "text": "凰檗她有好好地\\n在當老師嗎？\\r\\n她從以前就老是粗心大意的。[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
