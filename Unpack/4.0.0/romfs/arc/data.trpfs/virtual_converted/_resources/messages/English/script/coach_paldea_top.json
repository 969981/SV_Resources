            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_paldea_top_sp03_select_01",
      "hash64": "5E2EA328C53D1177",
      "text": "I’m staying in Paldea",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "coach_paldea_top_sp03_select_02",
      "hash64": "5E2EA428C53D132A",
      "text": "Unova’s not bad...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "coach_paldea_top_sp03_03",
      "hash64": "39451FFFAE9CE4EE",
      "text": "Ah, that is a relief to hear. I hope you’ll continue\\nto be an inspiration to the people of our region.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_paldea_top_sp03_03b",
      "hash64": "ED59EB75B49859E4",
      "text": "I will, of course, respect your decision...\\c\\nBut personally, I very much hope you will stay in\\nPaldea and be an inspiration to the people there.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_paldea_top_sp03_04",
      "hash64": "394522FFAE9CEA07",
      "text": "You are a guiding light that shines upon all of\\nPaldea, after all...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "coach_paldea_top_trade_01_00",
      "hash64": "22F2B6CE6722ADC5",
      "text": "[VAR 0xBD06(0000)]I have a proposition for you, Champion\\n[VAR 0x0100(0000)].[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "coach_paldea_top_trade_01_01",
      "hash64": "22F2B5CE6722AC12",
      "text": "I want to demonstrate to you just how much I\\ndepend on your presence.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "coach_paldea_top_trade_01_02",
      "hash64": "22F2B4CE6722AA5F",
      "text": "Perhaps a Pokémon trade between the two of us\\nwould help?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "coach_paldea_top_trade_01_03",
      "hash64": "22F2B3CE6722A8AC",
      "text": "I will be trading a Glimmet I caught in Area Zero.\\c\\nI hope through this trade you can somehow show\\nme what you truly feel.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "coach_paldea_top_trade_01_04",
      "hash64": "22F2B2CE6722A6F9",
      "text": "Thank you for trading with me.\\c\\nI am very curious to see how you raised this\\n[VAR 0x0101(0001)] of yours...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_paldea_top_trade_02_00",
      "hash64": "7D6D74E7AF889372",
      "text": "[VAR 0xBD06(0000)]You will trade your [VAR 0x0101(0001)]\\nfor\\r\\nmy\\r\\nGlimmet, then?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
