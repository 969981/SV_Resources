    },
    {
      "ordinal": 49,
      "label": "coach_paldea_top_talkto_00",
      "hash64": "789813F4A675EFFC",
      "text": "If you have a moment, would you care to battle\\nme, Champion [VAR 0x0100(0000)]?[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_paldea_top_cancel_00",
      "hash64": "19606B697556FAFF",
      "text": "Ah, that’s unfortunate. I am ready for a match\\nwhenever the mood strikes you.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "coach_paldea_top_battlestart_00",
      "hash64": "6BF39CD56CB0CC47",
      "text": "Wonderful! Let us make our way over to the\\nacademy’s entrance, then.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "coach_teacher_history_battlestart_01",
      "hash64": "648B50A4A41DB2E0",
      "text": "[EMPTY 66]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
