    },
    {
      "ordinal": 12,
      "label": "coach_paldea_top_sp02_01",
      "hash64": "0EC72A0AF805A59D",
      "text": "I was just musing about potentially recruiting new\\ntalent...[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
