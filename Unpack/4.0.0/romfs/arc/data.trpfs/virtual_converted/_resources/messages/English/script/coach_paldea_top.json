          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_paldea_top_sp02_05",
      "hash64": "0EC7260AF8059ED1",
      "text": "I had gathered information using my own sources,\\nof course...[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
