          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_paldea_top_sp02_02",
      "hash64": "0EC7270AF805A084",
      "text": "I would very much appreciate your input.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_paldea_top_sp02_03",
      "hash64": "0EC7280AF805A237",
      "text": "Could you perhaps recommend a Trainer from\\nBlueberry Academy whose talent you felt to be\\r\\nnoteworthy?[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
