    },
    {
      "ordinal": 43,
      "label": "coach_paldea_top_trade_02_01",
      "hash64": "7D6D75E7AF889525",
      "text": "You can’t trade Geeta a Pokémon if you aren’t\\nits original Trainer!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 44,
      "label": "coach_paldea_top_trade_02_02",
      "hash64": "7D6D72E7AF88900C",
      "text": "You can’t trade Geeta such a rare Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 45,
      "label": "coach_paldea_top_trade_02_03",
      "hash64": "7D6D73E7AF8891BF",
      "text": "You can’t trade Geeta a Shiny Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 46,
      "label": "coach_paldea_top_trade_03_00",
      "hash64": "A6A56ADC650B1023",
      "text": "Ah, but you seem to only have one Pokémon\\nwith you.\\c\\nPlease come back to me once you have at least\\ntwo Pokémon on your team.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "coach_paldea_top_trade_03_01",
      "hash64": "A6A569DC650B0E70",
      "text": "I understand. You need to think carefully about\\nwhich Pokémon to trade with me. I eagerly await\\r\\nyour decision.[VAR 0x0114(0011)]",
