          ]
        }
      ]
    },
    {
      "ordinal": 61,
      "label": "ajito_honoo_040_nelke_13",
      "hash64": "CC92D85F385CD9AC",
      "text": "天星大作戰？\\n而不是星塵大作戰？\\r\\n不，我第一次聽到這個名稱……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
