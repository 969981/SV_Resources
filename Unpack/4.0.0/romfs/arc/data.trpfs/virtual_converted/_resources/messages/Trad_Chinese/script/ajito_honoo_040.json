        }
      ]
    },
    {
      "ordinal": 59,
      "label": "ajito_honoo_040_nelke_12",
      "hash64": "CC92D95F385CDB5F",
      "text": "第一個……？\\n以前打架的時候……？[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
