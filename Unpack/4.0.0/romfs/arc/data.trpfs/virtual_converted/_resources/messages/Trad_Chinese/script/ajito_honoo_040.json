      "ordinal": 57,
      "label": "ajito_honoo_040_honooboss_26",
      "hash64": "2B2D30FF78CE164B",
      "text": "天星隊車……\\n那是以前為了打架而製造的。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
