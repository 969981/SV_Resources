    {
      "ordinal": 60,
      "label": "ajito_honoo_040_honooboss_28",
      "hash64": "2B2D2EFF78CE12E5",
      "text": "你知道天星大作戰嗎？[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
