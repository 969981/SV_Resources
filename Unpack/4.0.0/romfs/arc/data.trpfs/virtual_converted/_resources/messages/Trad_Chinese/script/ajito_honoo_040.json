            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "ajito_honoo_040_honooboss_27",
      "hash64": "2B2D2FFF78CE1498",
      "text": "但實際上用它對付的第一個對手，\\n就是你們。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
