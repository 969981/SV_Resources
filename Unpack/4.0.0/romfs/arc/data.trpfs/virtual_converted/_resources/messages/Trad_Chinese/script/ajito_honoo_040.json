    {
      "ordinal": 0,
      "label": "ajito_honoo_040_honooboss_00",
      "hash64": "2B3422FF78D41D2F",
      "text": "真是的，就這樣結束了？\\n……哎呀。[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
