          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "team_0160_aku_02",
      "hash64": "294530D7AEE33A9F",
      "text": "我們幾個討論過，\\n要是天星隊和學校\\r\\n兩邊都能兼顧就好了。[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
