    {
      "ordinal": 3,
      "label": "sub_006_trainer_04",
      "hash64": "B992346E5778C603",
      "text": "[VAR 0x1100(00FF,0101)]你妳想挑戰哪一個賽道呢？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
