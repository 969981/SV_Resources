          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_006_trainer_05",
      "hash64": "B992336E5778C450",
      "text": "細雪賽道啊！\\n悠閒地慢慢滑吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_006_trainer_06",
      "hash64": "B992366E5778C969",
      "text": "暴風雪賽道啊！\\n要穩紮穩打地滑喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_006_trainer_07",
      "hash64": "B992356E5778C7B6",
      "text": "絕對零度賽道啊！\\n[VAR 0x1100(00FF,0101)]你妳做好覺悟再去滑吧！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_006_trainer_08",
      "hash64": "B992406E5778DA67",
      "text": "騎著坐騎寶可夢從霜抹山的\\n大自然賽道滑下山！\\r\\n……就是這樣而已！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_006_trainer_09",
      "hash64": "B9923F6E5778D8B4",
      "text": "可以選擇的賽道共有３種！\\n在目標時間以內抵達終點的話，\\r\\n就能獲得參加獎喔。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_006_trainer_10",
      "hash64": "B98EB26E5775B346",
      "text": "以刷新個人最佳紀錄為目標，\\n全力去滑吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
