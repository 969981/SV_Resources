      "ordinal": 29,
      "label": "ajito_kakutou_010_kakutouboss_11",
      "hash64": "4B2C097826B3F33A",
      "text": "Fine...I’ll go.\\c\\nI’m sorry, Carmen![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
