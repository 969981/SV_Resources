    },
    {
      "ordinal": 10,
      "label": "ajito_kakutou_010_nelke_05",
      "hash64": "94C03031DE642EC5",
      "text": "[VAR 0x0100(0000)]! There you are![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
