          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "ajito_kakutou_010_kakutouboss_12",
      "hash64": "4B2C087826B3F187",
      "text": "H-hasta la vistar! ☆[VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "ajito_kakutou_010_sitappa_09",
      "hash64": "4178C9401BDFC11E",
      "text": "I’m your opponent now, you two! Come on—I’ll\\ntake you both down![VAR 0x0114(003F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003F"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_kakutou_010_nelke_10",
      "hash64": "94C3B131DE673FCF",
      "text": "Hey, [VAR 0x0100(0000)]...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "ajito_kakutou_010_nelke_11",
      "hash64": "94C3B031DE673E1C",
      "text": "My Pokémon and I are actually running on empty\\nafter that last battle.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "ajito_kakutou_010_nelke_12",
      "hash64": "94C3B331DE674335",
      "text": "Sorry to spring this on you, but do you think you\\ncould handle this grunt alone?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "ajito_kakutou_010_nelke_13",
      "hash64": "94C3B231DE674182",
      "text": "Come on, don’t be like that! It’s not like you to\\nhang me out to dry...[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
