        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "ajito_kakutou_010_sitappa_08",
      "hash64": "4178CA401BDFC2D1",
      "text": "Hey, that’s no way to sign off! Let me hear a\\n“hasta la vistar!” from you, nice and loud![VAR 0x0114(003F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
