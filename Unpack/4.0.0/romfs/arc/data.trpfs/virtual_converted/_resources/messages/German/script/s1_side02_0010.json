          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_side02_0010_camera_16",
      "hash64": "7E368578B05A7591",
      "text": "Wenn wir zusammenarbeiten, muss ich schließlich\\nwissen, was du so draufhast.\\c\\nAußerdem will ich ein paar Action-Shots von dir\\nmachen![VAR 0x0114(0046)]",
