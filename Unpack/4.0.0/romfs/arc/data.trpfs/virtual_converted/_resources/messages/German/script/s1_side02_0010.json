        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_side02_0010_camera_11",
      "hash64": "7E368678B05A7744",
      "text": "Aber so sehr ich auch suche, ich kann es einfach\\nnicht finden![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
