    {
      "ordinal": 13,
      "label": "s1_side02_0010_camera_10",
      "hash64": "7E368778B05A78F7",
      "text": "Ich bin nach Kitakami gekommen, um ein\\nbestimmtes Pokémon zu fotografieren.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
