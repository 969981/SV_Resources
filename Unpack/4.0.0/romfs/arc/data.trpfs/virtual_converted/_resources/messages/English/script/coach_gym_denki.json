          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_denki_sp02_03",
      "hash64": "B99412EABED1F87D",
      "text": "Some Academy-ish types even sent me a\\nthank-you for the good PR! Nyohoho.[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_denki_sp02_04",
      "hash64": "B9940BEABED1EC98",
      "text": "That was such a smash hit, Imma stick around this\\nBlueberry place lookin’ for more stuff to stream![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
