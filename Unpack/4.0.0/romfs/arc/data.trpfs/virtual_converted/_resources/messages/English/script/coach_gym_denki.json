          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_denki_sp03_04b",
      "hash64": "03256420E29A9851",
      "text": "Nope, nuh-uh, you can’t pull the Mareep wool\\nover my eyeballs!\\c\\nIn your heartiest of hearts you’ll always be part\\nof the Iono Zone faithful, right? Right?![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
