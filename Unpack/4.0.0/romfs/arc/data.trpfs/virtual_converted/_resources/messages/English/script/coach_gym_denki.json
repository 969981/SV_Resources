    {
      "ordinal": 12,
      "label": "coach_gym_denki_sp01_05",
      "hash64": "8F15FCF6083A82CC",
      "text": "I’ll do some diggin’, then. Thanks for the tip,\\nfriendo![VAR 0x0114(0019)]",
