    },
    {
      "ordinal": 24,
      "label": "coach_gym_denki_sp03_02",
      "hash64": "B858C3E597C456EF",
      "text": "You’re a young, fresh-faced Champion! Any\\nchannel you collabed with would rake in the\\r\\nviews...but you stayed a loyal Iono Zoner![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
