      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_denki_sp01_04c",
      "hash64": "5CE2A50FFB6E7B94",
      "text": "The...director? Like, the boss-man guy?\\nYou sure? Sounds kinda bori— uh, risky!\\c\\nIf I bring on a snoozer guest, that’d be a\\nreal Top 10 Iono Betrayals moment...[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
