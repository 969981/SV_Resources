    {
      "ordinal": 23,
      "label": "coach_gym_denki_sp03_01",
      "hash64": "B858C4E597C458A2",
      "text": "I knooow...that you kept your promise to not go\\ncollabin’ with other channels! What a friendo![VAR 0x0114(0019)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
