    },
    {
      "ordinal": 18,
      "label": "coach_gym_denki_sp02_02c",
      "hash64": "28911AE23EC6212B",
      "text": "The moment Mister Director-guy came on stream,\\nmy viewer count went WHOOSH! To the moon!!!\\c\\nWhere’d that guy even come from?! No way was\\nthat his first time on a stream!\\c\\nHe was so magnetic he even stole MY thunder!\\nWho gets more eyeballs than me?! I ’unno![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
