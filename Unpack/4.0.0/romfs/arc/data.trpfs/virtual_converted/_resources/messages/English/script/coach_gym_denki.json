    {
      "ordinal": 17,
      "label": "coach_gym_denki_sp02_02b",
      "hash64": "289119E23EC61F78",
      "text": "Chat went nutso for my live BB League coverage!\\nSeein’ students do their bestest really hit all my\\r\\nviewer friendos right in the feels![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
