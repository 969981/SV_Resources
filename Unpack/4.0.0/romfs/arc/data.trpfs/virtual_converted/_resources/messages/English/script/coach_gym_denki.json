      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_gym_denki_sp03_select_02",
      "hash64": "A8DC719BDE132E18",
      "text": "I might branch out",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_gym_denki_sp03_04",
      "hash64": "B858C1E597C45389",
      "text": "Woo! Hot diggity dang! Ah, man, I’m so jazzed,\\nI’m on cloud ten again! No, cloud eleven![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
