      "ordinal": 25,
      "label": "coach_gym_denki_sp03_03",
      "hash64": "B858C2E597C4553C",
      "text": "Dares I asks? Are you...gonna keep on collabing\\nexclusively with me?![VAR 0x0114(0019)]",
