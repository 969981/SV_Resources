    {
      "ordinal": 9,
      "label": "coach_gym_denki_sp01_04",
      "hash64": "8F15FDF6083A847F",
      "text": "They built an underwater dome here?! With four\\nwhole biomes?! THAT’S hot stuff![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
