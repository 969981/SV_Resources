      "label": "coach_bb4kings_fairy_sp01_04",
      "hash64": "86B5C59CF6026C56",
      "text": "[VAR 0x1100(00FF,0101)]你妳才剛來留學，\\n就馬上讓[VAR 0x1100(00FF,0101)]你妳回帕底亞去……\\r\\n是不是有點過分呀？[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
