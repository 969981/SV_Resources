          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb4kings_fairy_sp02_07",
      "hash64": "584CC484E90DC0D0",
      "text": "[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳不用在意！\\n畢竟這是我們的責任……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
