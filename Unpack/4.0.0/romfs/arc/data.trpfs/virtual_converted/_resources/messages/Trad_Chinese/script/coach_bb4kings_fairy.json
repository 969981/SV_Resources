    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_fairy_sp03_01",
      "hash64": "AFF8968C858C5177",
      "text": "烏栗他是冠軍的時候，\\n聯盟社的氣氛很沉重……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
