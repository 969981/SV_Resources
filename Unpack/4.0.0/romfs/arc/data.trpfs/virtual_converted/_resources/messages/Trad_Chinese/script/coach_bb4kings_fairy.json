    },
    {
      "ordinal": 8,
      "label": "coach_bb4kings_fairy_sp01_03",
      "hash64": "86B5C89CF602716F",
      "text": "你們是在帕底亞地區的\\n那個巨大的坑洞做調查，對吧？[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
