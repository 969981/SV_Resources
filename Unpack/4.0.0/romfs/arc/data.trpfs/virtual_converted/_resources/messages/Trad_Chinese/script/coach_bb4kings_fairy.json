      "ordinal": 21,
      "label": "coach_bb4kings_fairy_sp02_05",
      "hash64": "584CC684E90DC436",
      "text": "……諸如此類！\\n我們做了很多事喔！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
