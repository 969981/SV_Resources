      "hash64": "584CD284E90DD89A",
      "text": "……以上！\\n聯盟社的近況報告完畢～！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
