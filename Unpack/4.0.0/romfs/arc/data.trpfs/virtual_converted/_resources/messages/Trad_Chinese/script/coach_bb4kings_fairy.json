      "label": "coach_bb4kings_fairy_sp03_00",
      "hash64": "AFF8958C858C4FC4",
      "text": "[VAR 0x0100(0000)]！\\n現在可以聊聊嗎？[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
