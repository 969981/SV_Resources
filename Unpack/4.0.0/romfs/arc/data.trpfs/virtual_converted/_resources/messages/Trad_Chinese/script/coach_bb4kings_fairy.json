          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb4kings_fairy_sp01_06",
      "hash64": "86B5C39CF60268F0",
      "text": "這個學園太自由了，\\n所以會出現那種狀況……[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
