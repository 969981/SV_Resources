          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_bb4kings_fairy_sp01_05b",
      "hash64": "E94EE7B606219FD1",
      "text": "就是就是！\\n我覺得那是不好的！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
