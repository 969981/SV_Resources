      "ordinal": 22,
      "label": "coach_bb4kings_fairy_sp02_select_01",
      "hash64": "0D491132F0304C51",
      "text": "謝謝！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
