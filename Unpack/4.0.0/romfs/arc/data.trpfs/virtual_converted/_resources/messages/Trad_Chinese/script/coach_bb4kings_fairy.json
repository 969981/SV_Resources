      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_bb4kings_fairy_sp01_02",
      "hash64": "86B5C79CF6026FBC",
      "text": "只要有[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳在的話，\\n應該就是小事一樁吧！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
