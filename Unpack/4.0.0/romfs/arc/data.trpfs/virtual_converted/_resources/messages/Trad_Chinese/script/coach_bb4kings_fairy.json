          "args_hex": [
            "0049"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb4kings_fairy_sp02_04",
      "hash64": "584CC784E90DC5E9",
      "text": "我們重新確認了烏栗他更改的聯盟社社規，\\n把改得太嚴格的部分都恢復原狀了！[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
