    {
      "ordinal": 7,
      "label": "coach_bb4kings_fairy_sp01_02b",
      "hash64": "E9520DB60624163A",
      "text": "我想也是！\\n真的辛苦了。[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
