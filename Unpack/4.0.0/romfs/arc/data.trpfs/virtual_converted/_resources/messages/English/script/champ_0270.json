          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 162,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "champ_0270_rival_20",
      "hash64": "0D489FCEA0E0763E",
      "text": "Well, I know what treasure I got out of all this:\\nI found a true rival—someone who can stand up\\r\\nto me at my full capabilities.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "champ_0270_rival_21",
      "hash64": "0D48A0CEA0E077F1",
      "text": "That’s right—I mean you! I’m so glad I got to\\nmeet you, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
