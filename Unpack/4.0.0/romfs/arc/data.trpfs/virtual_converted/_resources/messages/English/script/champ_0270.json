    },
    {
      "ordinal": 2,
      "label": "champ_0270_rival_no_01",
      "hash64": "5254D5B6CD6685EF",
      "text": "Ha, you’ve got jokes! But seriously—you did\\nbecome a Champion, right?[VAR 0x0114(0004)]",
