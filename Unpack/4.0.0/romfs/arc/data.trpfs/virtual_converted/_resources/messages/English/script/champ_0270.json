    },
    {
      "ordinal": 4,
      "label": "champ_0270_rival_no_03",
      "hash64": "5254D7B6CD668955",
      "text": "OK, wait! You DID become a Champion, though,\\ndidn’t you?![VAR 0x0114(0004)]",
