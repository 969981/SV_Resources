          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "champ_0270_rival_17",
      "hash64": "0D4592CEA0DE2A50",
      "text": "Special meaning, huh? Hmm... Let me see...\\nAnywhere leap to mind, [VAR 0x0100(0000)]?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
