      ]
    },
    {
      "ordinal": 31,
      "label": "champ_0270_select_a",
      "hash64": "58F210F41C7F9425",
      "text": "Out behind your house",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
