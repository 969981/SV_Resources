          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "champ_0270_rival_22",
      "hash64": "0D489DCEA0E072D8",
      "text": "Anyway, that being said...[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "champ_0270_rival_23",
      "hash64": "0D489ECEA0E0748B",
      "text": "I’ll be waiting for you at the battle court in\\nMesagoza’s central plaza! See ya there![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "champ_0270_chairman_06",
      "hash64": "02FA6E0BAA6F8EB5",
      "text": "The respect you two share is palpable. Even a bit\\nenviable, to be honest.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "champ_0270_chairman_07",
      "hash64": "02FA6D0BAA6F8D02",
      "text": "I am known as La Primera—but even when facing\\nme in the final test of her Champion Assessment,\\r\\nChampion Nemona didn’t reveal her full might.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "champ_0270_chairman_08",
      "hash64": "02FA700BAA6F921B",
      "text": "In you, I suspect she has found someone she can\\nbattle without holding anything back.[VAR 0x0114(0011)]",
