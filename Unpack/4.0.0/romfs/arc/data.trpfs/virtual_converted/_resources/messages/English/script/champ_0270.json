    {
      "ordinal": 12,
      "label": "champ_0270_rival_no_05",
      "hash64": "5254D1B6CD667F23",
      "text": "Oops! Couldn’t hear you! I’ll say it again: let’s\\nyou and me be best rivals for life![VAR 0x0114(0004)]",
