    {
      "ordinal": 4,
      "label": "a_sch_office03_eve07",
      "hash64": "8F5DA8DBF9785677",
      "text": "Wenn es im Unterricht mal nicht so toll läuft,\\nkomme ich her, um mich zu entspannen.\\c\\nSeñora Mimi lässt mich auch in Ruhe und stellt\\nkeine blöden Fragen. Sie ist sooo nett!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
