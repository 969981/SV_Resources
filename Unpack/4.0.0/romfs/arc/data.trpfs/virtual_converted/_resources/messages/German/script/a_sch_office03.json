          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "a_sch_office03_ni01",
      "hash64": "5CB3DF5C0B29144A",
      "text": "Señora Mimi wird von den Schülern wegen ihrer\\nfürsorglichen Art auch liebevoll „Mama Mimi“\\r\\ngenannt.\\c\\nIch hab das auch mal versucht, aber sie hat mir\\nbloß einen ziemlich finsteren Blick zugeworfen...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
