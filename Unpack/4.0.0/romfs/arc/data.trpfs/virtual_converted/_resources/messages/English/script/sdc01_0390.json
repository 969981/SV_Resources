      "ordinal": 17,
      "label": "sdc01_0390_brother_03",
      "hash64": "DDA118F3F149306C",
      "text": "I’m...I’m not goin’.[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0390_sister_11",
      "hash64": "CCC8421E99C38995",
      "text": "What? You’re part of the team! You need to\\ncome along![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
