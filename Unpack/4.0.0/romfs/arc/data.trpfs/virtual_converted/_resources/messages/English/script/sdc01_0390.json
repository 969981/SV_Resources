      "ordinal": 21,
      "label": "sdc01_0390_brother_06",
      "hash64": "DDA115F3F1492B53",
      "text": "Sorry![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
