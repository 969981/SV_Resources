    {
      "ordinal": 3,
      "label": "sdc01_0390_sister_02",
      "hash64": "CCCBC91E99C6A4D1",
      "text": "All right! Let’s combine the info we’ve gathered![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
