      "ordinal": 16,
      "label": "sdc01_0390_sister_10",
      "hash64": "CCC8411E99C387E2",
      "text": "We can do this![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
