      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0390_brother_02",
      "hash64": "DDA119F3F149321F",
      "text": "OK, well, here’s what I heard...[VAR 0x0114(0043)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
