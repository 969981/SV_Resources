    {
      "ordinal": 2,
      "label": "gym_denki_010_receptionist_01",
      "hash64": "D3D284EC17F4C2B2",
      "text": "Welcome to the Levincia Gym!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_denki_010_receptionist_02",
      "hash64": "D3D283EC17F4C0FF",
      "text": "Let me register you as a challenger. Your name is\\n[VAR 0x0100(0000)], yes?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_denki_010_receptionist_03",
      "hash64": "D3D282EC17F4BF4C",
      "text": "Great! Now, in order to face Gym Leader Iono,\\nyou’ll first need to pass the Gym Test.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_denki_010_receptionist_04",
      "hash64": "D3D281EC17F4BD99",
      "text": "Here at the Levincia Gym, that means [VAR 0xFF00(0006)]starring in[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]one of Iono’s streams[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
