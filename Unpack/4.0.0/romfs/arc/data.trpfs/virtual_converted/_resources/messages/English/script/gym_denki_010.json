    },
    {
      "ordinal": 6,
      "label": "gym_denki_010_receptionist_05",
      "hash64": "D3D280EC17F4BBE6",
      "text": "Iono’s a streamer as well as a Gym Leader, so\\nwe want you to dazzle her audience with your\\r\\nskills and rack up those subscriptions!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
