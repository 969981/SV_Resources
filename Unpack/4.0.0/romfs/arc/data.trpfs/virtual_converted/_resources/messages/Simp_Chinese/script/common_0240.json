      "label": "common_0240_teacher_05",
      "hash64": "2494BD5635571394",
      "text": "看来大家都对[VAR 0x0100(0000)]\\n很感兴趣啊。[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
