    {
      "ordinal": 11,
      "label": "common_0240_student_03a",
      "hash64": "3CAED3B5AF8028B4",
      "text": "嚷嚷……\\n是个很活泼的同学啊。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "common_0240_student_03b",
      "hash64": "3CAED6B5AF802DCD",
      "text": "嚷嚷……\\n感觉很酷很有型啊。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
