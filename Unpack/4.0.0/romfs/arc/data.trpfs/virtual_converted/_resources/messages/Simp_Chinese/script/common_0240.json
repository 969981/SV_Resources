      "tokens": []
    },
    {
      "ordinal": 37,
      "label": "common_0240_rival_03a",
      "hash64": "E984D588FCA21B13",
      "text": "正好我也帮你装上图鉴App了。\\n看来你很喜欢收集啊！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
