      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "common_0240_student_m_03",
      "hash64": "3A163A71A3F1D375",
      "text": "哇！是这样啊！\\n我也和你一样哦～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
