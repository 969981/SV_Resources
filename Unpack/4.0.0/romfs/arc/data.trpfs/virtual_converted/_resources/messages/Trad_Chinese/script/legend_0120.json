      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "legend_0120_friend_01",
      "hash64": "128CFD72A6CCFEF5",
      "text": "好！[VAR 0x0100(0000)]！\\n[VAR 0x1100(00FF,0101)]你妳做好對戰的準備了嗎？[VAR 0x0114(0006)]",
