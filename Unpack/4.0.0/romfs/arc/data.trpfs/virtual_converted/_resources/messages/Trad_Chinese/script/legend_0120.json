          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "legend_0120_friend_03",
      "hash64": "128CFB72A6CCFB8F",
      "text": "很好！\\n獒教父你也準備好了吧！？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
