          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "legend_0120_friend_15",
      "hash64": "12900572A6CF4264",
      "text": "第零區不只寶可夢很強大，\\n還有一大堆莫名其妙的裝置。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "legend_0120_friend_16",
      "hash64": "12900872A6CF477D",
      "text": "我想至少還需要兩個人……\\n要是有[VAR 0xFF00(0006)]擁有冠軍級實力的傢伙[VAR 0xFF00(0000)]，\\r\\n跟[VAR 0xFF00(0006)]擅長機械的傢伙[VAR 0xFF00(0000)]加入我們就好了。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
