    {
      "ordinal": 2,
      "label": "legend_0120_friend_02",
      "hash64": "128CFA72A6CCF9DC",
      "text": "[VAR 0x1100(00FF,0101)]你妳來叫我卻一派想溜走？\\n我感覺像是吃了閉門羹耶！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
