    {
      "ordinal": 75,
      "label": "legend_0030_friend_41",
      "hash64": "1CE99B99E9999F43",
      "text": "¡Mabosstiff es prueba de que es cierto!\\c\\nAntes de comerse la primera especia, tenía las\\npatas heladas. Y mira ahora, ¡están calentitas![VAR 0x0114(0006)]",
