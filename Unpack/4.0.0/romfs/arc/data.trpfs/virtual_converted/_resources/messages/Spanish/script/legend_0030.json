    {
      "ordinal": 74,
      "label": "legend_0030_friend_40",
      "hash64": "1CE99A99E9999D90",
      "text": "Según el libro, ¡quien ingiera las cinco especias\\nse curará de cualquier herida o enfermedad![VAR 0x0114(0006)]",
