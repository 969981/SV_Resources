    {
      "ordinal": 9,
      "label": "champ_0130_ground_06",
      "hash64": "DE111E169634B75C",
      "text": "Hm, ich frage mich, wer von euch beiden wohl\\nstärker ist...[VAR 0x0114(0013)]",
