      "ordinal": 11,
      "label": "champ_0130_steel_05",
      "hash64": "85D779A5DFE500E9",
      "text": "Ich bin von den Top Vier, also bin ich bestimmt\\nviel besser, jawohl...![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
