      "hash64": "D96E4BF4CEC7BFA9",
      "text": "[VAR 0x0100(0000)]，你做好\\n启程前往第零区的准备了吗？[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
