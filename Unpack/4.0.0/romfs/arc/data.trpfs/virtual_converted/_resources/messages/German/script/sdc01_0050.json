      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0050_sister_01",
      "hash64": "02AC435163FB721D",
      "text": "Hey, du bist von dieser Akademie in der\\nPaldea-Region, oder?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0050_brother_02",
      "hash64": "6A1E72D8B21FC6B8",
      "text": "Wie cool...[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0050_sister_02",
      "hash64": "02AC405163FB6D04",
      "text": "Sei still, Jo.[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0050_sister_03",
      "hash64": "02AC415163FB6EB7",
      "text": "Ich bin Hana.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0050_sister_04",
      "hash64": "02AC3E5163FB699E",
      "text": "[VAR 0x1100(00FF,0B0D,0000)]Einen FremdenEine Fremde wie dich lass ich nicht einfach so\\nnach Midoriya spazieren, nichts da![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0B0D",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0050_sister_05",
      "hash64": "02AC3F5163FB6B51",
      "text": "Wenn du trotzdem unbedingt ins Dorf willst,\\nmüssen wir das wohl in einem Kampf regeln.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0050_brother_03",
      "hash64": "6A1E73D8B21FC86B",
      "text": "H-Hana... Komm schon, du willst doch einfach\\nnur kämpfen, das ist nicht fair...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0050_sister_06",
      "hash64": "02AC3C5163FB6638",
      "text": "Halt die Klappe![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0050_sister_07",
      "hash64": "02AC3D5163FB67EB",
      "text": "Beachte meinen kleinen Bruder einfach nicht.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0050_brother_04",
      "hash64": "6A1E78D8B21FD0EA",
      "text": "Menno...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0050_sister_08",
      "hash64": "02AC3A5163FB62D2",
      "text": "Also dann, mach dich bereit.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0050_sister_09",
      "hash64": "02AC3B5163FB6485",
      "text": "Ich werd schon meinen Spaß mit dir haben![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0050_brother_05",
      "hash64": "6A1E79D8B21FD29D",
      "text": "Woah, abgefahren! Du hast echt meine\\nSchwester besiegt?![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0050_brother_06",
      "hash64": "6A1E76D8B21FCD84",
      "text": "Woah, abgefahren! Du bist ja fast so stark wie\\nmeine Schwester![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0050_sister_10",
      "hash64": "02AFA85163FE5393",
      "text": "Gaaah... Mist! Wie konnte ich nur verlieren?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0050_sister_15",
      "hash64": "02AFAB5163FE58AC",
      "text": "Hm... Ich hätte nicht gedacht, dass du es so weit\\ngegen mich bringen würdest.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0050_sister_11",
      "hash64": "02AFA75163FE51E0",
      "text": "Sagen wir einfach, du hast meine Prüfung\\nbestanden. Gerade so.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0050_sister_12",
      "hash64": "02AFAA5163FE56F9",
      "text": "Nun ja, jetzt bleibt mir wohl nichts anderes übrig,\\nals dich ins Dorf zu lassen.\\c\\nAber ich hab hier das Sagen, klar?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0050_caretaker_01",
      "hash64": "359CC8D23590536B",
      "text": "He! Was geht hier vor?![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0050_sister_13",
      "hash64": "02AFA95163FE5546",
      "text": "Pfff, na toll...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0050_sister_14",
      "hash64": "02AFAC5163FE5A5F",
      "text": "Komm, Jo. Zeit zu gehen.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0050_brother_07",
      "hash64": "6A1E77D8B21FCF37",
      "text": "Ähm, a-aber...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0050_brother_08",
      "hash64": "6A1E6CD8B21FBC86",
      "text": "Hana, warte auf mich![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0050_caretaker_02",
      "hash64": "359CC9D23590551E",
      "text": "Ah, hallo! Du bist [VAR 0x1100(00FF,0E0B,0000)]ein Schülereine Schülerin von der\\nAkademie in Paldea, hab ich recht?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0E0B",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0050_caretaker_03",
      "hash64": "359CCAD2359056D1",
      "text": "Ich bin der Verwalter diverser Einrichtungen im\\nDorf und zudem dafür zuständig, dass ihr euren\\r\\nAufenthalt hier voll und ganz genießen könnt.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0050_caretaker_04",
      "hash64": "359CCBD235905884",
      "text": "Ich hoffe, die zwei Kinder von eben waren\\nnett zu dir?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0050_caretaker_05",
      "hash64": "359CCCD235905A37",
      "text": "*seufz* Diese beiden stiften immer wieder\\nUnruhe, vor allem Hana...\\c\\nTut mir leid, falls sie dir Ärger bereitet haben.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 120,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0050_caretaker_06",
      "hash64": "359CCDD235905BEA",
      "text": "Was sagst du da?! An der Bushaltestelle wartet\\nein kranker Schüler auf Hilfe?[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0050_caretaker_07",
      "hash64": "359CCED235905D9D",
      "text": "Ich werde sofort nach dem Rechten sehen![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0050_caretaker_08",
      "hash64": "359CBFD235904420",
      "text": "Geh du ruhig schon mal vor zum Gemeindehaus.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0050_caretaker_09",
      "hash64": "359CC0D2359045D3",
      "text": "Bis gleich![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0050_caretaker_10",
      "hash64": "35A04DD235936B41",
      "text": "Der Weg zum Dorf ist recht uneben. Es gibt leider\\nviele, denen auf der Fahrt hierher übel wird.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "sdc01_0050_bbteacher_01",
      "hash64": "38ECAFAAB23BC7E1",
      "text": "Eine derartige Reisekrankheit tritt auf, wenn das\\nGleichgewichtsorgan im Ohr durch Schütteln\\r\\ndurcheinandergebracht wird.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_0050_stopper_01",
      "hash64": "5321E0503929D496",
      "text": "Geh zum Gemeindehaus!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
