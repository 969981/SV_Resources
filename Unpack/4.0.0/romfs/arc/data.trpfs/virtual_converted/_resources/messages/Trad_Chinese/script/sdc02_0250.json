    {
      "ordinal": 0,
      "label": "sdc02_0250_bbteacher_01",
      "hash64": "703B8D8FDD7C244A",
      "text": "這裡是……這裡就是……[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
