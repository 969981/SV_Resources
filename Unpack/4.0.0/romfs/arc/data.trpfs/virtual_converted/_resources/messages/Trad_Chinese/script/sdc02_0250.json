      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0250_brother_04",
      "hash64": "D18259A8173687D5",
      "text": "夥伴……[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
