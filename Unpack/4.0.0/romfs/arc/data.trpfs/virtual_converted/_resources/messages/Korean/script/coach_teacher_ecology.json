        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_ecology_sp01_04c",
      "hash64": "45D8384152FB8EC6",
      "text": "와우~ 새로운 친구는\\n잔뜩 만들었니~?\\c\\n나중에 선생님한테도 소개시켜 줘~![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
