        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_ecology_sp01_05",
      "hash64": "EA40254DD53AD58E",
      "text": "이번에는 자연 학교와 다르게\\n혼자서 유학하는 거라\\r\\n많이 걱정했었는데...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
