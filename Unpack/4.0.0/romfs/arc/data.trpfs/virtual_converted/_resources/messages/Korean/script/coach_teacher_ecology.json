    },
    {
      "ordinal": 10,
      "label": "coach_teacher_ecology_sp01_04b",
      "hash64": "45D8394152FB9079",
      "text": "와우~\\n그거 정말 기쁜 소식인걸~\\c\\n이곳에서도 마구마구 볼을 던지며\\n열심히 하고 있구나![VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
