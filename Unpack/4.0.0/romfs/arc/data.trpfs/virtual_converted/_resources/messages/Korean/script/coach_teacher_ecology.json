    {
      "ordinal": 24,
      "label": "coach_teacher_ecology_sp03_01",
      "hash64": "C0FD5D5E45B0FFB8",
      "text": "나도 블루베리도감을\\n앱에 설치해 봤어~[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
