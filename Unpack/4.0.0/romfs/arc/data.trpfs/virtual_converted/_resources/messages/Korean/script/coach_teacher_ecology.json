      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_ecology_sp02_select_02",
      "hash64": "5727ADE8EA18AC35",
      "text": "보실래요?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_ecology_sp02_01",
      "hash64": "EEB76964A88CAD4D",
      "text": "와우~! 이거, 내가 만든 도감 앱을\\n개량한 거잖아!?[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
