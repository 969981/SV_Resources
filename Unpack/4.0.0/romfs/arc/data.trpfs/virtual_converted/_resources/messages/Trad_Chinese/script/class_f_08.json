          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_f_08_dragon_04",
      "hash64": "F4463FAB39E671F8",
      "text": "感謝各位選修了一整期的美術課。\\n小生感激不盡。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_f_08_dragon_05",
      "hash64": "F44640AB39E673AB",
      "text": "與各位同學一起學習的這時光，\\n是小生寶貴的證章。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_f_08_dragon_06",
      "hash64": "F44641AB39E6755E",
      "text": "小生由衷祝福各位同學，\\n在這美麗的世界\\r\\n前程似錦、萬事如意。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_f_08_dragon_07",
      "hash64": "F44642AB39E67711",
      "text": "那麼，各位辛苦了。\\n成績會由櫃台職員通知你們。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
