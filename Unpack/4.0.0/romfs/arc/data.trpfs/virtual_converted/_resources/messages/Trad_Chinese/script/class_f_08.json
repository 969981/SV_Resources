      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_f_08_question_05",
      "hash64": "348866EF5E8C33B2",
      "text": "５　寶可夢的證章全都是在\\n　　相遇時就已經有的。\\n　　無法在相遇後再戴上。\\n\\n・正確　・不正確",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "class_f_08_ansewer_05a",
      "hash64": "4D2B6AC537FF6FF6",
      "text": "正確",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "class_f_08_ansewer_05b",
      "hash64": "4D2B69C537FF6E43",
      "text": "不正確",
