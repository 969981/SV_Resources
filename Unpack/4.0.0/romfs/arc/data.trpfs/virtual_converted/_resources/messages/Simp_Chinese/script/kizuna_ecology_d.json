      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_ecology_d_04",
      "hash64": "652B199A7659FF0A",
      "text": "……不好意思，\\n我有点兴奋过头了～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
