    {
      "ordinal": 1,
      "label": "kizuna_ecology_d_02",
      "hash64": "652B139A7659F4D8",
      "text": "宝可梦图鉴的２００种宝可梦！\\n你收集到了啊！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
