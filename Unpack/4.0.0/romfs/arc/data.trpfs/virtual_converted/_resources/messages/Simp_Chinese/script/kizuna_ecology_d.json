      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_ecology_d_03",
      "hash64": "652B149A7659F68B",
      "text": "哇～哇～！\\n有山里的宝可梦，还有大海里的宝可梦！\\r\\n啊，连这种地方都有宝可梦！！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
