      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_ecology_d_07",
      "hash64": "652B189A7659FD57",
      "text": "[VAR 0x0100(0000)]，\\n你真是捕捉宝可梦的专家！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
