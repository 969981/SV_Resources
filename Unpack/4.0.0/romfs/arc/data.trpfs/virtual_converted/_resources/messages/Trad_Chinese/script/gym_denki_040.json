      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_denki_040_select_03",
      "hash64": "7367AB6BF5A9C904",
      "text": "我很不安",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "gym_denki_040_denki_04a",
      "hash64": "E847044310E52647",
      "text": "好喔！謝謝～！\\n我最～愛這種直率的回答了！[VAR 0x0114(0019)]",
