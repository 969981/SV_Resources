      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "gym_denki_040_comment_07",
      "hash64": "AD281BF84BC32F97",
      "text": "兩邊都很強喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "gym_denki_040_denki_09",
      "hash64": "CA092D8CCE9ABFFB",
      "text": "雖然很不甘心，但是我輸了！\\n各位看官，謝謝你們幫我加油喔～！[VAR 0x0114(0019)]",
