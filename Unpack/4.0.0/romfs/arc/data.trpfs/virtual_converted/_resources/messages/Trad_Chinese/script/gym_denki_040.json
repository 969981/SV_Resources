      "ordinal": 23,
      "label": "gym_denki_040_denki_06",
      "hash64": "CA092A8CCE9ABAE2",
      "text": "各位看官都說等不及囉！\\n……啊，電電王，謝謝贊助～！[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
