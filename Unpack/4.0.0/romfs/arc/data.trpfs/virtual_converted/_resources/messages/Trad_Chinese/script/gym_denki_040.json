        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_denki_040_denki_07",
      "hash64": "CA092B8CCE9ABC95",
      "text": "那奇好，差不多該開始囉！\\n來看看挑戰者的實力有多奇吧～！？[VAR 0x0114(0019)]",
      "flags": 0,
