    },
    {
      "ordinal": 20,
      "label": "team_0090_cassiopeia_08",
      "hash64": "409CBA6F657A6F5B",
      "text": "The operation’s been a huge success thanks to\\nyou, [VAR 0x0100(0000)].[VAR 0x0114(0009)]",
