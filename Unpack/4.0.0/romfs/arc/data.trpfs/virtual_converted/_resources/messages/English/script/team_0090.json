    },
    {
      "ordinal": 11,
      "label": "team_0090_cassiopeia_04d",
      "hash64": "44B2EA496F004751",
      "text": "Now that there’s no boss to lead them, the rest\\nof the Schedar Squad shouldn’t last long.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
