    },
    {
      "ordinal": 9,
      "label": "team_0090_cassiopeia_04b",
      "hash64": "44B2EC496F004AB7",
      "text": "Now that its boss has been taken down, the Navi\\nSquad’s days are numbered.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
