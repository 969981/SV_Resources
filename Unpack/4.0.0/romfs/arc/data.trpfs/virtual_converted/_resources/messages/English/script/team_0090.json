    {
      "ordinal": 44,
      "label": "team_0090_botan_05",
      "hash64": "B3E7EA01EEFC0609",
      "text": "They just wanted the bullies to go away, but then\\nthey became the bad guys in everyone’s eyes...[VAR 0x0114(0008)]",
