        }
      ]
    },
    {
      "ordinal": 10,
      "label": "team_0090_cassiopeia_04c",
      "hash64": "44B2EB496F004904",
      "text": "With its boss no longer around, the Ruchbah\\nSquad is as good as finished.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
