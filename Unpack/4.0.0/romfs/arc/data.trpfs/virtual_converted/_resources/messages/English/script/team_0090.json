    },
    {
      "ordinal": 12,
      "label": "team_0090_cassiopeia_04e",
      "hash64": "44B2E9496F00459E",
      "text": "Without its boss, the Caph Squad should be a\\nhair’s breadth from disbanding.[VAR 0x0114(0009)]",
      "flags": 0,
