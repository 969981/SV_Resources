          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "team_0090_cassiopeia_09",
      "hash64": "409CB96F657A6DA8",
      "text": "And Clive has also performed admirably as\\nyour support.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "team_0090_cassiopeia_10",
      "hash64": "40994C6F65777E9A",
      "text": "I remember him saying that you’re acquaintances.\\nHave you known each other long?[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "team_0090_select_01",
      "hash64": "200585D7058117F9",
      "text": "Yeah, for a while now",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "team_0090_select_02",
      "hash64": "200582D7058112E0",
      "text": "No, not all that long",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "team_0090_cassiopeia_11",
      "hash64": "40994D6F6577804D",
      "text": "Well, he’s clearly a reliable friend. He almost\\nreminds me of the gang back in the day...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "team_0090_select_03",
      "hash64": "200583D705811493",
      "text": "Back in what day?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "team_0090_select_04",
      "hash64": "200588D705811D12",
      "text": "Which gang?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "team_0090_cassiopeia_12",
      "hash64": "40994A6F65777B34",
      "text": "...As you know, Team Star was formed by a group\\nof students who were being bullied at school.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "team_0090_cassiopeia_13",
      "hash64": "40994B6F65777CE7",
      "text": "Shortly after forming the team, these students—\\nnone other than the squad bosses themselves—\\r\\nconfronted their bullies head on.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "team_0090_cassiopeia_14",
      "hash64": "4099486F657777CE",
      "text": "The outcome was a resounding victory for\\nTeam Star...\\c\\nThough you could hardly call it a contest.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "team_0090_cassiopeia_15",
      "hash64": "4099496F65777981",
      "text": "The bullies didn’t even put up a fight. They all\\nbolted from battle the first chance they got.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "team_0090_cassiopeia_16",
      "hash64": "4099466F65777468",
      "text": "Scared spitless of Team Star, the bullies then\\ndropped out of school, one after another...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "team_0090_cassiopeia_17",
      "hash64": "4099476F6577761B",
      "text": "And Team Star ended up the villains of the story.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "team_0090_cassiopeia_19",
      "hash64": "4099456F657772B5",
      "text": "...But that’s neither here nor there. Forget I\\nmentioned it.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "team_0090_cassiopeia_20",
      "hash64": "4095C66F65746511",
      "text": "Now, about your reward. I’ll transfer some LP\\nover to your phone, as promised.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
