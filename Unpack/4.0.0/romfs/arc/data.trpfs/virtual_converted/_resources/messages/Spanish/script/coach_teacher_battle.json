          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_battle_sp02_00",
      "hash64": "8D37EC72C2EDB86E",
      "text": "¡Novatill[VAR 0x1100(00FF,0101)]oa! Cómo mola el Biodomo, ¿eh?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_battle_sp02_01",
      "hash64": "8D37ED72C2EDBA21",
      "text": "Me recuerda un poco al área recreativa de\\nnuestra academia.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_battle_sp02_02",
      "hash64": "8D37EA72C2EDB508",
      "text": "¡Nada como un lugar abierto en el que poder\\ncorretear de aquí para allá![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_battle_sp02_03",
      "hash64": "8D37EB72C2EDB6BB",
      "text": "Estoy pensando en cambiar las charlas por algo\\nde entrenamiento...\\c\\n¿Qué te parecería que hiciese a los alumnos dar\\nuna vuelta corriendo al Biodomo?[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_battle_sp02_select_01",
      "hash64": "37A1D076C23731E0",
      "text": "¡Qué buena idea!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_battle_sp02_select_02",
      "hash64": "37A1D376C23736F9",
      "text": "Uf, no sé yo...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_battle_sp02_04",
      "hash64": "8D37F072C2EDBF3A",
      "text": "¿A que sí? Entrenar el tren inferior solo trae\\ncosas buenas, te lo digo yo.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_battle_sp02_04b",
      "hash64": "E3CCEB0139FC2288",
      "text": "¿Te parece demasiado? Con lo que me gusta a\\nmí correr... Supongo que con media vuelta vale.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_battle_sp02_05",
      "hash64": "8D37F172C2EDC0ED",
      "text": "Por supuesto, estás más que invitad[VAR 0x1100(00FF,0101)]oa, ¡que sé\\nque también te van estas cosas![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_battle_sp03_00",
      "hash64": "36D2226B2783F7FF",
      "text": "¡Da gusto enseñar a los alumnos de esta\\nacademia, oye![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_battle_sp03_01",
      "hash64": "36D2216B2783F64C",
      "text": "Estoy impresionada por todo el empeño que le\\nponen a las asignaturas sobre combates.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_battle_sp03_02",
      "hash64": "36D2246B2783FB65",
      "text": "Además, me han contado que las notas de esas\\nclases tienen mucho peso en la evaluación final.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_battle_sp03_03",
      "hash64": "36D2236B2783F9B2",
      "text": "Al fin y al cabo, es un campo de estudio con\\nmuchas salidas: miembro de la Liga Pokémon,\\r\\nRanger, Entrenador profesional...[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_battle_sp03_select_01",
      "hash64": "C4EEFAC9B85C331B",
      "text": "¡Cuántas posibilidades!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_battle_sp03_select_02",
      "hash64": "C4EEFBC9B85C34CE",
      "text": "¿En serio?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_battle_sp03_04",
      "hash64": "36D21E6B2783F133",
      "text": "¡Ya ves! Y, por supuesto, otra salida es dedicarse\\na la docencia, ¡como yo![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_battle_sp03_04b",
      "hash64": "AAFB011425330CA3",
      "text": "¡No me digas que nunca te habían hablado\\nde esto!\\c\\nSí que te deben de gustar los Pokémon si has\\nllegado a hacerte Campe[VAR 0x1100(00FF,0302)]ónona sin saberlo.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0302"
          ]
        },
        {
          "kind": "control",
          "offset_units": 144,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_battle_sp03_05",
      "hash64": "36D21D6B2783EF80",
      "text": "Sea como sea, tienes que empeñarte en todos\\nlos ámbitos.\\c\\nSi lo haces, ¡se te abrirán infinidad de puertas\\nde cara al futuro![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_battle_sp03_06",
      "hash64": "36D2206B2783F499",
      "text": "Tú sigue mis consejos y verás como no te\\narrepientes, novatill[VAR 0x1100(00FF,0101)]oa.[VAR 0x0114(0024)]",
