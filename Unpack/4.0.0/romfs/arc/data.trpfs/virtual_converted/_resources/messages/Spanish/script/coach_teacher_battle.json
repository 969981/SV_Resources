    },
    {
      "ordinal": 12,
      "label": "coach_teacher_battle_sp01_05",
      "hash64": "340331597B9C9A7A",
      "text": "Bueno, sea lo que sea, ¡déjalo en mis manos![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_battle_sp01_06",
      "hash64": "340330597B9C98C7",
      "text": "¡Puede que no sean tan grandes como las de mi\\nHariyama, pero te aseguro que puedo con todo![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
