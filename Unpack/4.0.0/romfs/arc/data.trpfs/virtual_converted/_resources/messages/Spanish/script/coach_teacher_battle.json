    },
    {
      "ordinal": 33,
      "label": "coach_teacher_battle_trade_01_00",
      "hash64": "6BAD646D5CC72559",
      "text": "¡Vaya chapa te acabo de echar![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
