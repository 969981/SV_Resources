    {
      "ordinal": 26,
      "label": "sdc02_0170_brother_03",
      "hash64": "74710696DFA78565",
      "text": "Mira quién fue a hablar...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
