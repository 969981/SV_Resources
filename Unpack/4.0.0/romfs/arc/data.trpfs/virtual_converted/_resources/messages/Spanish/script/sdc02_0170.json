      ]
    },
    {
      "ordinal": 29,
      "label": "sdc02_0170_brother_05",
      "hash64": "74710096DFA77B33",
      "text": "Que eso lo digas tú...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
