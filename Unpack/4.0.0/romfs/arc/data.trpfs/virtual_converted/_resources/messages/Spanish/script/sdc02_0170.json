    },
    {
      "ordinal": 15,
      "label": "sdc02_0170_dragonbb_c_05",
      "hash64": "D5A8986B5D71773C",
      "text": "Por cierto, con lo amable que suele ser Aroa,\\n¿se puede saber por qué es tan fría conmigo?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
