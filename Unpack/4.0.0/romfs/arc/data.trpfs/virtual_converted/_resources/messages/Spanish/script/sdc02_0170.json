          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0170_dragonbb_c_04",
      "hash64": "D5A8996B5D7178EF",
      "text": "Me sé de alguien que podría aprender un poco,\\nen lugar de sacrificarlo todo con tal de volverse\\r\\nmás fuerte...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
