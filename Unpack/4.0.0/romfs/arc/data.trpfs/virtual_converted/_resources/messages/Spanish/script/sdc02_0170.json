    {
      "ordinal": 1,
      "label": "sdc02_0170_dragonbb_02",
      "hash64": "33EEE1F1D25A2753",
      "text": "Perdona, colega. Espero que no se te haya\\nhecho larga la espera.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
