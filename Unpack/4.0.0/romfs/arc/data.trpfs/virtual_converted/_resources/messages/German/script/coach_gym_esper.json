    },
    {
      "ordinal": 53,
      "label": "coach_gym_esper_randomtalk_00",
      "hash64": "EDF60E1629A1C954",
      "text": "Ich bin zwar sehr beschäftigt, aber wenn du mich\\nrufst, komme ich natürlich umgehend vorbei.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
