          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_esper_randomtalk_03",
      "hash64": "EDF6111629A1CE6D",
      "text": "[VAR 0xBD06(0000)][VAR 0x0101(0001)] hat viel Potenzial. Ich werde es\\nwunderhübsch\\r\\ngroßziehen.[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
