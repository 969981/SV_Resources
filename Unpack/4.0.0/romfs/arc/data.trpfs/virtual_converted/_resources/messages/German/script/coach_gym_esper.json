    },
    {
      "ordinal": 57,
      "label": "coach_gym_esper_randomtalk_04",
      "hash64": "EDF60A1629A1C288",
      "text": "Wie geht es meinem Flattutu?\\c\\nIst es nicht einfach fantastisch, stark und immer\\nfür eine Überraschung gut?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
