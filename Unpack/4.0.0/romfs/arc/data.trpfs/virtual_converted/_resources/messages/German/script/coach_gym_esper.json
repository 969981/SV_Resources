    },
    {
      "ordinal": 52,
      "label": "coach_gym_esper_battleend_lose_00_00",
      "hash64": "9DBA5066B6FFF7C9",
      "text": "Sowohl im Kampf als auch in Sachen Schönheit\\nbin ich die klare Siegerin.\\c\\nAber lass dich davon nicht einschüchtern.\\nKrone richten und weitermachen![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
