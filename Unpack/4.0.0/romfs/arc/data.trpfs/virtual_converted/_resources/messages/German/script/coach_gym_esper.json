      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "coach_gym_esper_trade_03_00",
      "hash64": "32B16CE20F2D76ED",
      "text": "Mit nur einem Pokémon im Team kannst du\\nkeinen Tausch durchführen.\\c\\nWenn du zwei Pokémon dabeigehabt hättest,\\nwäre es kein Problem gewesen...[VAR 0x0114(001C)]",
