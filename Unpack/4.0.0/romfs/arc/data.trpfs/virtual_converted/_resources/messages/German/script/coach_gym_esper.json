    {
      "ordinal": 46,
      "label": "coach_gym_esper_battleend_win_00_01",
      "hash64": "331C8763F6947235",
      "text": "Ich freue mich, dass du unser Versprechen\\ngehalten hast.[VAR 0x0114(001C)]",
