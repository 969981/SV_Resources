          "code_hex": "0114",
          "args_hex": [
            "001C"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_gym_esper_randomtalk_02",
      "hash64": "EDF6101629A1CCBA",
      "text": "Es ist nicht vorteilhaft, immer in der gleichen Pose\\nzu verharren.\\c\\nWas man dagegen tun kann, fragst du?\\nHihi, Gefühlsgymnastik natürlich![VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
