    },
    {
      "ordinal": 1,
      "label": "coach_gym_esper_first_01",
      "hash64": "2D97FCDC3B58BD6E",
      "text": "Wer möchte sich diesmal von meiner Magie\\nverzaubern lassen?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
