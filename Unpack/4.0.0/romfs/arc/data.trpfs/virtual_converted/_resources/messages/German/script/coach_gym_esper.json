    },
    {
      "ordinal": 2,
      "label": "coach_gym_esper_sp01_00",
      "hash64": "52A8E16EF1BB79F7",
      "text": "[VAR 0xBD06(0000)]Ach, [VAR 0x0100(0000)]! Wie schön.\\nLang\\r\\nist\\r\\nes\\r\\nher,\\r\\nnicht wahr?[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
