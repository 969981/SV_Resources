      ]
    },
    {
      "ordinal": 54,
      "label": "coach_gym_esper_randomtalk_01",
      "hash64": "EDF60F1629A1CB07",
      "text": "Sag mal, macht Amura denn ihren Lehrerjob auch\\ngewissenhaft? Sie ist nämlich schon immer etwas\\r\\nunachtsam gewesen...[VAR 0x0114(001C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
