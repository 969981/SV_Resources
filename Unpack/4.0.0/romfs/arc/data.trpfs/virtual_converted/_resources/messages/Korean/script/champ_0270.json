      "ordinal": 28,
      "label": "champ_0270_rival_16",
      "hash64": "0D4593CEA0DE2C03",
      "text": "그럼, 포켓몬리그의\\n배틀코트를 빌려주세요![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
