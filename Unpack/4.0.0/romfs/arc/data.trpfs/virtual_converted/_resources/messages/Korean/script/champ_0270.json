    },
    {
      "ordinal": 12,
      "label": "champ_0270_rival_no_05",
      "hash64": "5254D1B6CD667F23",
      "text": "응!? 뭐라고? 잘 안 들렸어!\\n나의 라이벌이 되어 줘![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
