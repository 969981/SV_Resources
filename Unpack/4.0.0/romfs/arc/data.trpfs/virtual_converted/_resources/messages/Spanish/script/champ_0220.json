          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0220_ground_03",
      "hash64": "D97FDE4188CF2D27",
      "text": "Me caes genial, así que te lo voy a poner...\\n¡chungo no, lo siguiente![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0220_ground_04",
      "hash64": "D97FDB4188CF280E",
      "text": "¡Tenía todas las de perder! ¡Menudo tongo![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0220_ground_05",
      "hash64": "D97FDC4188CF29C1",
      "text": "Habré perdido, pero me he dado el gustazo con\\nun combate de los que hacen afición.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0220_ground_06",
      "hash64": "D97FD94188CF24A8",
      "text": "Los aspirantes capaces de superar la prueba de\\naptitud son cuatro Sprigatito mal contados.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0220_ground_07",
      "hash64": "D97FDA4188CF265B",
      "text": "Pero, oye, ¿quién sabe? Tal vez tú te conviertas\\nen un[VAR 0x1100(00FF,0101)]oa de ellos, [VAR 0x0100(0000)].[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0220_ground_08",
      "hash64": "D97FD74188CF2142",
      "text": "Aunque yo que tú no cantaría victoria, porque tu\\nsegunda rival te las va a hacer pasar canutas.[VAR 0x0114(0013)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0220_ground_09",
      "hash64": "D97FD84188CF22F5",
      "text": "¡Ya hemos terminado, renacuaja! ¡Te toca a ti![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
