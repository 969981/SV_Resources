      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0220_steel_02",
      "hash64": "9293522F48E4CC50",
      "text": "¡¿Pero has perdido, Caye?![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
