          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "champ_0220_ground_10",
      "hash64": "D983454188D21203",
      "text": "Cosas que pasan... ¡Si es que tiene una fuerza de\\naquí a mañana![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "champ_0220_ground_11",
      "hash64": "D983444188D21050",
      "text": "Voy a quedarme a ver el combate, así que hazle\\npagar muy cara mi derrota, ¿vale?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "champ_0220_steel_03",
      "hash64": "9293532F48E4CE03",
      "text": "¡Te lo prometo![VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "champ_0220_ground_12",
      "hash64": "D983474188D21569",
      "text": "No me perdería el resto de tu prueba por nada\\ndel mundo. Demuéstrame lo que vales.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
