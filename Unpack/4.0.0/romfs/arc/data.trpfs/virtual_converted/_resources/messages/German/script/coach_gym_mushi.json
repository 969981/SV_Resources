      "hash64": "460FABA24F6D7ADC",
      "text": "Ich bin Ronah, die Inhaberin der Konditorei\\nMukorossi.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
