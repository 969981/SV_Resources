          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_gym_mushi_trade_01_00",
      "hash64": "26172FE1E4E94C08",
      "text": "Ich bin total glücklich, dass ich dank dir neuen\\nKäfer-Pokémon begegnen konnte.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_gym_mushi_trade_01_01",
