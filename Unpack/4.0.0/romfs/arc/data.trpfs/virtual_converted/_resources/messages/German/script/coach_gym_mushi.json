      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "coach_gym_mushi_sp02_04",
      "hash64": "C6F9AC8C0A673AC3",
      "text": "Meinst du wirklich? Das ist aber doch kein\\nKäfer-Pokémon, oder?\\c\\nSein Ruf klang ein bisschen wie „Watt, watt!“...\\nDenkst du nicht, es war vielleicht Wattzapf?[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 160,
