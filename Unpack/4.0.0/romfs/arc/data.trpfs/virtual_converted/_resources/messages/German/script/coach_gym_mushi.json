            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_mushi_sp02_01",
      "hash64": "C6F9AF8C0A673FDC",
      "text": "Vor Kurzem bin ich ganz unbeschwert durch die\\nTera-Kuppel spaziert.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_mushi_sp02_02",
      "hash64": "C6F9B28C0A6744F5",
      "text": "Da hatte ich eine wundervolle Begegnung mit\\neinem niedlichen Käfer-Pokémon![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_mushi_sp02_03",
      "hash64": "C6F9B18C0A674342",
      "text": "Es war klein und süß und außerdem noch vom\\nTyp Elektro. Kennst du zufällig seinen Namen?[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
