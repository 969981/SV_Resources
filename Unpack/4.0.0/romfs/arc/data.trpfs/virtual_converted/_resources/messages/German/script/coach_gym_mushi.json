    },
    {
      "ordinal": 31,
      "label": "coach_gym_mushi_sp03_04",
      "hash64": "F3003E926BD0848A",
      "text": "Aranestro ist vom Typ Wasser und lebt an den\\nUfern verschiedener Gewässer.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
