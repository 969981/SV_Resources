          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_mushi_sp02_04b",
      "hash64": "817AD2F5AD689F93",
      "text": "Ja, ich glaube, das war es! Der Name würde auch\\nzu seinem Ruf passen.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_mushi_sp02_05",
      "hash64": "C6F9AB8C0A673910",
      "text": "Und es ist wohl ein Käfer-Pokémon, das in Paldea\\nnicht heimisch ist. Interessant![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_mushi_sp02_06",
      "hash64": "C6F9AE8C0A673E29",
      "text": "Ich bin direkt inspiriert, eine neue Süßigkeit zu\\nkreieren, die an Wattzapf erinnert![VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0016"
          ]
        }
      ]
    },
