      ]
    },
    {
      "ordinal": 60,
      "label": "coach_gym_mushi_randomtalk_03",
      "hash64": "F7614DF83219026E",
      "text": "[VAR 0xBD06(0000)]Dein [VAR 0x0101(0001)] hat einen sehr gesunden\\nAppetit!\\c\\nEs scheint ziemlichen Gefallen an meinen\\nKreationen gefunden zu haben.[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
