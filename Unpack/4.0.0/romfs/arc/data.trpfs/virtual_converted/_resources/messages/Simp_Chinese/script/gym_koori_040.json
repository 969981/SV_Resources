  "entries": [
    {
      "ordinal": 0,
      "label": "gym_koori_040_kari_message_01",
      "hash64": "62D27FC9E8F5173C",
      "text": "[EMPTY 33]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
