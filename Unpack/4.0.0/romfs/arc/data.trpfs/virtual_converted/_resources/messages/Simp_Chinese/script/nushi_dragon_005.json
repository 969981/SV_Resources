      "label": "nushi_dragon_0005_friend_02",
      "hash64": "C33E4085F4442A7E",
      "text": "听说伪龙宝主\\n就在这片湖的某处。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
