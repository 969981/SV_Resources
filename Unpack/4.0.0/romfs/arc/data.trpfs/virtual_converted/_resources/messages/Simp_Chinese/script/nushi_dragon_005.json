    {
      "ordinal": 3,
      "label": "nushi_dragon_0005_friend_03",
      "hash64": "C33E4185F4442C31",
      "text": "但是，从来没有任何人\\n见过它的样貌。[VAR 0x0114(0006)]",
      "flags": 0,
