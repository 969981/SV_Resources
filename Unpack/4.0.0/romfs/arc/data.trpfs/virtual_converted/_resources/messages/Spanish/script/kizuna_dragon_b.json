      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_dragon_b_03",
      "hash64": "268D89536FED8B6C",
      "text": "La energía que desbordáis los jóvenes es\\ncontagiosa.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
