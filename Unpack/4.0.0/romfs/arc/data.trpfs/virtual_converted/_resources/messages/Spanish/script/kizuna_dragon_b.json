      "hash64": "D6E8E0D3CC7A7026",
      "text": "¡Ahora te llevas aún mejor con Hesperio!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
