    {
      "ordinal": 20,
      "label": "sch_entrance01_boy_05",
      "hash64": "EB33DCE6A2437BE0",
      "text": "这里的人们，\\n大家都～是来学习的啊～",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sch_entrance01_boy_06",
      "hash64": "EB33DFE6A24380F9",
      "text": "你修读理科课程，\\n还是文科课程？\\r\\n要是喜欢宝可梦的话，是综合课程？",
