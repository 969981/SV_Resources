    {
      "ordinal": 11,
      "label": "sch_entrance01_boy_03",
      "hash64": "EB33E2E6A2438612",
      "text": "我虽然擅长宝可梦对战，\\n但是对学习却很发愁～\\r\\n……教教我怎么应试学习吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
