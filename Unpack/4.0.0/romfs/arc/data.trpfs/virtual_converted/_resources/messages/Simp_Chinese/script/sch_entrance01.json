    {
      "ordinal": 67,
      "label": "sch_entrance01_man_05",
      "hash64": "4A9BB6FB162BB26E",
      "text": "我和派帕同班，\\n从去年开始他好像有些辛苦，\\r\\n我也能懂他的心情。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
