    {
      "ordinal": 14,
      "label": "sch_entrance01_girl_04",
      "hash64": "A478D2916FCE4DEF",
      "text": "记载了秘传调味料的书……\\n是放在哪里来着？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
