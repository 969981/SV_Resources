        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sch_entrance01_boy_04",
      "hash64": "EB33DDE6A2437D93",
      "text": "我虽然擅长学习，\\n但是在宝可梦对战上还差得很远！\\r\\n……教教我宝可梦对战吧！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
