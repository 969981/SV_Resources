    {
      "ordinal": 58,
      "label": "sch_entrance01_boy_08",
      "hash64": "EB33E9E6A24391F7",
      "text": "听说长期带着宝可梦一起走，\\n有些宝可梦会因此进化呢。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
