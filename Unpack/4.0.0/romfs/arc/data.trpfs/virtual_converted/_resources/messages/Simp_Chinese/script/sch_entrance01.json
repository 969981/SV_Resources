      "label": "sch_entrance01_poke_33",
      "hash64": "01B78309590C7BD8",
      "text": "[EMPTY 76]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "004C"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "sch_entrance01_man_04",
      "hash64": "4A9BB7FB162BB421",
      "text": "能在著名博士的母校学习，\\n我感到十分荣幸。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
