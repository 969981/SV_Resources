      "tokens": []
    },
    {
      "ordinal": 43,
      "label": "s1_side02_0050_camera_26",
      "hash64": "3701EE7640A81F8A",
      "text": "휴... 어쩌지.\\n아직도 가슴이 막 떨려.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
