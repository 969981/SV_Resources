          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "s1_side02_0050_camera_34",
      "hash64": "3705727640AB35AD",
      "text": "세류 집안의 가훈은\\n“시간은 소중하다!”\\r\\n타임 이즈 머니니까 말이야![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
