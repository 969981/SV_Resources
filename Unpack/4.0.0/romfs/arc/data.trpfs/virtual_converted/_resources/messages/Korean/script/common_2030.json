      "hash64": "3F593A2EFD6311FE",
      "text": "로토로토로토로토...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "common_2030_top_01",
      "hash64": "ED8F5C9444F2119E",
      "text": "여보세요.\\n챔피언 [VAR 0x0100(0000)] 번호 맞나요?[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
