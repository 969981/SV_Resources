          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_gym_kusa_sp01_00",
      "hash64": "E49EDFBA7377DED8",
      "text": "[VAR 0x0100(0000)]，\\n感谢阁下的邀请！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_kusa_sp01_01",
      "hash64": "E49EE0BA7377E08B",
      "text": "我刚好完成了新作，\\n于是也当是放松一下就速速赶来了……[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_kusa_sp01_02",
      "hash64": "E49EE1BA7377E23E",
      "text": "看来即使地区不同，青春期的小朋友们\\n在生态上也没什么变化啊。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_kusa_sp01_03",
      "hash64": "E49EE2BA7377E3F1",
      "text": "但是那个巨蛋！！！！\\c\\n将不同环境调和在一起的样子\\n实在太能激发人的创作欲望了！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_gym_kusa_sp01_select_01",
      "hash64": "A0B376FEFB2B9812",
      "text": "太好了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_gym_kusa_sp01_select_02",
      "hash64": "A0B375FEFB2B965F",
      "text": "调和？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_gym_kusa_sp01_05",
      "hash64": "E49EE4BA7377E757",
      "text": "没想到我开心时，\\n阁下也会开心，太巧了！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_gym_kusa_sp01_05b",
      "hash64": "F1E5DDD234BDDF0F",
      "text": "所谓调和！指的就是艺术性地\\n将不同的东西混合在一起！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_kusa_sp01_04",
      "hash64": "E49EE3BA7377E5A4",
      "text": "我还想骑到那个吊在\\n巨蛋圆顶的神秘物体上！\\r\\n想在那俯瞰巨蛋的全景！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_kusa_sp02_00",
      "hash64": "BA20E9C5BCE09F87",
      "text": "话说，[VAR 0x0100(0000)]！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_kusa_sp02_01",
      "hash64": "BA20E8C5BCE09DD4",
      "text": "在合众有位著名的艺术家，\\n阁下知道吗？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_kusa_sp02_select_01",
      "hash64": "78872684BFFF3133",
      "text": "知道！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_gym_kusa_sp02_select_02",
      "hash64": "78872784BFFF32E6",
      "text": "不知道",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_gym_kusa_sp02_05",
      "hash64": "BA20E4C5BCE09708",
      "text": "哦哦，阁下真博学！\\n虽然我猜阁下也知道……[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_gym_kusa_sp02_05b",
      "hash64": "267C25FFF1A1491E",
      "text": "是吗？\\n不知道的话，那我就告诉阁下吧！！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_kusa_sp02_02",
      "hash64": "BA20EBC5BCE0A2ED",
      "text": "那家伙能以虫宝可梦为主题\\n画出奥妙无穷的画作。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_kusa_sp02_03",
      "hash64": "BA20EAC5BCE0A13A",
      "text": "将一个属性升华成艺术……\\n此感性与我相似，令我很在意。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_kusa_sp02_04",
      "hash64": "BA20E5C5BCE098BB",
      "text": "据说那个人的工作室在飞云市，\\n回程时我就顺便到那里看看吧。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_kusa_sp03_00",
      "hash64": "11CD13CD595FC5B6",
      "text": "以前跟阁下说过的\\n那个在飞云市的艺术家！\\r\\n我去了趟那家伙的工作室，然后发现……[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_kusa_sp03_01",
      "hash64": "11CD14CD595FC769",
      "text": "堪称前卫艺术！！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_kusa_sp03_02",
      "hash64": "11CD11CD595FC250",
      "text": "那些像是团珠蛛吐出的\\n丝一样的物体\\r\\n还兼备了电梯的功能！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_kusa_sp03_03",
      "hash64": "11CD12CD595FC403",
      "text": "当我沉浸在愉悦里，\\n上下了好几次电梯后！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_kusa_sp03_05",
      "hash64": "11CD18CD595FCE35",
      "text": "渐渐地我的身体被丝缠绕，\\n最后竟化为了茧！！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_gym_kusa_sp03_06",
      "hash64": "11CD15CD595FC91C",
      "text": "没错……当回过神来时，\\n我自身就成为了\\r\\n丝的艺术……棒极了！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_kusa_sp03_select_01",
      "hash64": "EB651E4CF38C48F8",
      "text": "真不错呀！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_gym_kusa_sp03_select_02",
      "hash64": "EB65214CF38C4E11",
      "text": "怎么回事？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_gym_kusa_sp03_07",
      "hash64": "11CD16CD595FCACF",
      "text": "[VAR 0x0100(0000)]阁下也有共鸣啊！\\n将来阁下就来到我身边\\r\\n当我的弟子吧！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_kusa_sp03_07b",
      "hash64": "9F486BEEDDC563F7",
      "text": "[VAR 0x0100(0000)]阁下居然不明白……\\n难道那个体验\\r\\n并非作者有意为之？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_kusa_sp03_04",
      "hash64": "11CD17CD595FCC82",
      "text": "说起来，在那个工作室里\\n完全没有挂着画作。\\r\\n那真的是工作室吗……？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_kusa_trade_01_00",
      "hash64": "A2CAEFBF4E513650",
      "text": "哈～哈、哈、哈！也好！！\\n和[VAR 0x0100(0000)]阁下的对话，\\r\\n真是让人快活不知时日过！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_gym_kusa_trade_01_01",
      "hash64": "A2CAF0BF4E513803",
      "text": "想必阁下也有\\n相同的感受吧！\\r\\n所以我在此提案……[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
