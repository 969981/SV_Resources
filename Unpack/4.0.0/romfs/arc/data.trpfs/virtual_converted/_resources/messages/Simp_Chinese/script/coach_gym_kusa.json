          "code_hex": "BDFF",
          "args_hex": [
            "003D"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "coach_gym_kusa_battleend_win_00_00",
      "hash64": "57E1D6FA3247509D",
      "text": "哈～哈、哈、哈！\\n阁下拿下了充满艺术性的胜利啊！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "coach_gym_kusa_battleend_win_00_01",
      "hash64": "57E1D5FA32474EEA",
      "text": "和阁下共同创作真是不同凡响！\\n我的感性都得到精雕细琢了！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "coach_gym_kusa_battleend_win_00_02",
      "hash64": "57E1D4FA32474D37",
      "text": "……这是谢礼。\\c\\n是会在我下次个展发售的商品，\\n让我抢先送给阁下吧。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_gym_kusa_battleend_win_00_03",
      "hash64": "57E1D3FA32474B84",
      "text": "这个商品花了多达半年时间来监修，\\n品质非常理想！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "coach_gym_kusa_reward_00",
      "hash64": "B18D4AC0CF981C95",
      "text": "[VAR 0x0100(0000)]从寇沙那里\\n获得了[VAR 0xFF00(0008)]随他去手机壳[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "coach_gym_kusa_battleend_win_01_00",
      "hash64": "AE478101CDB0DAAC",
      "text": "哈～哈、哈、哈！\\n我输得充满了艺术性！\\c\\n在把我当作养分的同时，\\n把这个也拿去吧！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_gym_kusa_battleend_win_01_01",
      "hash64": "AE478201CDB0DC5F",
      "text": "灵感在不停地涌上来……\\n让我暂时沉浸在余韵当中吧！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_gym_kusa_battleend_lose_00_00",
      "hash64": "A0955EEA7006A9B0",
      "text": "这次成为养分的是阁下啊！\\c\\n有时战败也能\\n成为艺术的肥料！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_gym_kusa_randomtalk_00",
      "hash64": "1FDAFE1F72B4C8A3",
      "text": "蓝莓学园这所学校的\\n设计真是非常好，\\r\\n真想知道设计师的名字是什么。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_kusa_randomtalk_01",
      "hash64": "1FDAFD1F72B4C6F0",
      "text": "对战和艺术\\n都不会只有开心事。\\c\\n即便如此，也不要放弃。\\n要是放弃了挣扎，便会就此枯萎。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_gym_kusa_randomtalk_02",
      "hash64": "1FDB001F72B4CC09",
      "text": "在学院，阿朔的课想上多少次\\n就能上多少次，对吧？\\c\\n阁下要意识到这是件幸事，\\n并走好今后的人生路。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_gym_kusa_randomtalk_03",
      "hash64": "1FDAFF1F72B4CA56",
      "text": "阁下托付给我的[VAR 0x0101(0001)]\\n堪称前卫艺术！甚至让我\\r\\n想在今后制作它的雕塑。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_gym_kusa_randomtalk_04",
      "hash64": "1FDB021F72B4CF6F",
      "text": "我托付给阁下的\\n向日花怪过得还好吗？\\c\\n阁下一定要给予它\\n充足的阳光与水分哦。[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 60,
      "label": "coach_gym_kusa_randomtalk_sp",
      "hash64": "20AACC1F7365C2E8",
      "text": "前阵子首席冠军\\n悄悄告诉我了。\\c\\n她说阁下最喜欢的\\n道馆馆主是我！！\\c\\n要是我符合[VAR 0x0100(0000)]阁下前卫的审美，\\n那我可是得偿所愿了！！\\c\\n下次让我们以“感谢”为主题\\n再次进行共同创作吧！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
