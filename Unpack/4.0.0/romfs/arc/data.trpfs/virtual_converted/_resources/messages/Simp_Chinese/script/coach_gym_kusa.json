            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_gym_kusa_trade_01_02",
      "hash64": "A2CAF1BF4E5139B6",
      "text": "阁下要来和我进行一次\\n充满艺术性的宝可梦交换吗？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_gym_kusa_trade_01_03",
      "hash64": "A2CAF2BF4E513B69",
      "text": "Yes！[VAR 0x0100(0000)]前卫！\\n我就用向日花怪和阁下换吧！\\r\\n阁下会选择什么宝可梦呢！？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_gym_kusa_trade_01_04",
      "hash64": "A2CAF3BF4E513D1C",
      "text": "居然是[VAR 0x0101(0001)]，真有意思！\\n我的灵感如泉涌！\\r\\n感谢阁下的审美力！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_gym_kusa_trade_02_00",
      "hash64": "D08479C5B12C06FF",
      "text": "阁下要用[VAR 0x0101(0001)]\\n来换我的向日花怪，没错吧？[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
