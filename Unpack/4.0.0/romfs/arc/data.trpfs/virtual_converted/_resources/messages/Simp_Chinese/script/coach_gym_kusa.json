    {
      "ordinal": 1,
      "label": "coach_gym_kusa_first_01",
      "hash64": "3F634500417BF2C7",
      "text": "这室内的设计！\\n堪称前卫艺术！[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
