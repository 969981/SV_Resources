      "ordinal": 42,
      "label": "ajito_kakutou_040_sitappa_03",
      "hash64": "E7EEF1AC2C216F2B",
      "text": "De quoi tu voulais parler ?[VAR 0x0114(003F)]",
      "flags": 0,
