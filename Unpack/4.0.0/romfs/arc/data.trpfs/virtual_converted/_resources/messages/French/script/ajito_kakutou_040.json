    },
    {
      "ordinal": 44,
      "label": "ajito_kakutou_040_nelke_09",
      "hash64": "5C185C40FEE60622",
      "text": "Tu peux nous dire pourquoi ?[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
