      "label": "ajito_kakutou_040_nelke_16",
      "hash64": "5C14DD40FEE2F87E",
      "text": "Eh bien...\\nC’est-à-dire que...[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
