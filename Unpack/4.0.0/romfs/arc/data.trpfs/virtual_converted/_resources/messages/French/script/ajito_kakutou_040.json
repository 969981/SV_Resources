      "ordinal": 49,
      "label": "ajito_kakutou_040_sitappa_07",
      "hash64": "E7EEF5AC2C2175F7",
      "text": "Elle est belle, forte en sport, et en plus,\\nc’est une Dresseuse talentueuse.[VAR 0x0114(003F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
