      "ordinal": 64,
      "label": "ajito_kakutou_040_sitappa_17",
      "hash64": "E7F275AC2C24854E",
      "text": "Et tu crois toujours ces rumeurs, après ce que\\nje viens de te raconter ?[VAR 0x0114(003F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
