      "label": "ajito_kakutou_040_nelke_11",
      "hash64": "5C14E040FEE2FD97",
      "text": "Et c’est pour ça que tu as commencé\\nà t’en prendre à elle ?[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
