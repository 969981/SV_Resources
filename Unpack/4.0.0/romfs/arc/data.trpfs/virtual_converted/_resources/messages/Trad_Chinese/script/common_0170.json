    {
      "ordinal": 10,
      "label": "common_0170_rival_16",
      "hash64": "3BFA9343B399FC64",
      "text": "招式學習器只要用過１次\\n就會消失，要注意喔。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
