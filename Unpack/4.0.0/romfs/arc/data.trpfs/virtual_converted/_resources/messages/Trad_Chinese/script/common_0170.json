    {
      "ordinal": 8,
      "label": "common_0170_rival_06",
      "hash64": "3BFE1543B39D0F21",
      "text": "為了以防萬一，\\n我們交換一下聯絡方式吧！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
