      "label": "common_0170_select_01",
      "hash64": "2E344D741B9C5604",
      "text": "妳覺得呢？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
