      ]
    },
    {
      "ordinal": 9,
      "label": "common_0170_rival_15",
      "hash64": "3BFA9643B39A017D",
      "text": "還有就是能對抗強大寶可夢的招式！\\n用來學習招式的這個道具也送給[VAR 0x1100(00FF,0101)]你妳！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
