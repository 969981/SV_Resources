    {
      "ordinal": 2,
      "label": "champ_0200_ground_03",
      "hash64": "31D7E41AA830920D",
      "text": "[VAR 0xBD06(0000)]And let me be the first to congratulate you,\\n[VAR 0x0100(0000)]...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
