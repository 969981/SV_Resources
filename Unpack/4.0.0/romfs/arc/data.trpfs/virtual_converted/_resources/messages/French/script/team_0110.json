          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0110_cassiopeia_17",
      "hash64": "ED0E60614AF59F24",
      "text": "Mais la Team Star actuelle n’est que source\\nde malheur pour tout le monde...\\r\\nY compris ses membres.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 102,
          "count": 2,
