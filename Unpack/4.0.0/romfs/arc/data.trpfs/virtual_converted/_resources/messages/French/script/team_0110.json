    },
    {
      "ordinal": 39,
      "label": "team_0110_cassiopeia_16",
      "hash64": "ED0E61614AF5A0D7",
      "text": "C’est moi qui ai formé la Team Star, et tous\\nses membres sont mes camarades.\\c\\nCe sont des personnes qui me sont chères,\\net leur amitié est un trésor à mes yeux.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
