        }
      ]
    },
    {
      "ordinal": 41,
      "label": "team_0110_cassiopeia_18",
      "hash64": "ED0E57614AF58FD9",
      "text": "C’est pour ça que je veux y mettre fin.\\c\\nEt pour convaincre mes camarades de partir,\\nje me suis servie de notre code d’honneur.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
