    },
    {
      "ordinal": 38,
      "label": "team_0110_cassiopeia_15",
      "hash64": "ED0E62614AF5A28A",
      "text": "J’ai longtemps hésité à vous le dire, sans trouver\\nle moment opportun.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
