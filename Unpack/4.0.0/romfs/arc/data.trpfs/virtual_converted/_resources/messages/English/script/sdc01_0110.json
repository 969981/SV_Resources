      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0110_brother_05",
      "hash64": "EDA64A03CD239A80",
      "text": "Y...yeah! This is [VAR 0x0100(0000)].[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
