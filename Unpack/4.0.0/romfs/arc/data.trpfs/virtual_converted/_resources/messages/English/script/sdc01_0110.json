      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0110_brother_10",
      "hash64": "EDA34903CD2162F6",
      "text": "What’s it matter anyway! What’re YOU doin’\\nback here?![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
