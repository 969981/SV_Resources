      "label": "sdc01_0110_gmother_08",
      "hash64": "24C2159E930A0E13",
      "text": "There we are. All done![VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
