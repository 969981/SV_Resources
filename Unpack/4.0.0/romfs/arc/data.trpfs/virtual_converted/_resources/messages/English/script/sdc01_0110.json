      "ordinal": 4,
      "label": "sdc01_0110_select_01",
      "hash64": "3CA12DB2C0383B3E",
      "text": "I sure am!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc01_0110_select_02",
      "hash64": "3CA12CB2C038398B",
      "text": "I’d say so",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc01_0110_brother_03",
      "hash64": "EDA65003CD23A4B2",
      "text": "What?! R-really?! We’re friends?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
