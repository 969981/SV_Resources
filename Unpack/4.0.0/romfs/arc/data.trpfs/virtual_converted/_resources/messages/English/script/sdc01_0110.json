      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0110_brother_06",
      "hash64": "EDA64D03CD239F99",
      "text": "[VAR 0x0100(0000)], this is my grandma.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0110_gmother_02",
      "hash64": "24C21F9E930A1F11",
      "text": "Well, fancy that! A friend of Kieran’s! We’re\\ndelighted to have you, [VAR 0x0100(0000)].[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0037"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0110_gfather_04",
      "hash64": "A482E8B30424F9DC",
      "text": "Oh, my, is it really already sundown?[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0110_gmother_03",
      "hash64": "24C21E9E930A1D5E",
      "text": "Goodness me, I’d nearly forgotten. The Festival\\nof Masks starts tonight, doesn’t it?[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0037"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0110_gmother_04",
      "hash64": "24C2219E930A2277",
      "text": "Come now, Kieran. You too, [VAR 0x0100(0000)].[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0037"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0110_gmother_05",
      "hash64": "24C2209E930A20C4",
      "text": "I’ll get out some jinbei for you both so you can\\ngo to the festival all gussied up.[VAR 0x0114(0037)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0037"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0110_brother_07",
      "hash64": "EDA64C03CD239DE6",
      "text": "Hear that? We get to dress up in jinbei! Yay![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
