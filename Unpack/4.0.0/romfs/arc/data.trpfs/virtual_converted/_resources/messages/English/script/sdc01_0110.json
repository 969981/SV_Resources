    },
    {
      "ordinal": 33,
      "label": "sdc01_0110_sister_04",
      "hash64": "0F0880773724E9F9",
      "text": "Oh, right. Gran, I couldn’t find my mask for the\\nfestival.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
