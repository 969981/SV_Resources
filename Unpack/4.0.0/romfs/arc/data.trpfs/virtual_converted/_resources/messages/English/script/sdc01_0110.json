      "ordinal": 27,
      "label": "sdc01_0110_gmother_10",
      "hash64": "24BE979E93070222",
      "text": "Having that card should open up all sorts of new\\nlooks for you at the big-city shops and salons.[VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
