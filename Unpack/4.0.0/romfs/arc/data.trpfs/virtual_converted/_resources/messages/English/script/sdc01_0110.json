      "ordinal": 21,
      "label": "sdc01_0110_gmother_07",
      "hash64": "24C2229E930A242A",
      "text": "Now, now, don’t go running off just yet—we have\\nto do up your hair, too![VAR 0x0114(0037)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
