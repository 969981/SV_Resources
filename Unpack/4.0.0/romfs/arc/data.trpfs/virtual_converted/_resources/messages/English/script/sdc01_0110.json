    },
    {
      "ordinal": 8,
      "label": "sdc01_0110_gfather_03",
      "hash64": "A482E7B30424F829",
      "text": "[VAR 0xBD06(0000)]Thank you for befriending our Kieran here,\\n[VAR 0x0100(0000)].[VAR 0x0114(0030)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
