      "ordinal": 9,
      "label": "sdc01_0110_gmother_01",
      "hash64": "24C21C9E930A19F8",
      "text": "Oh? Kieran’s made a friend?[VAR 0x0114(0037)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
