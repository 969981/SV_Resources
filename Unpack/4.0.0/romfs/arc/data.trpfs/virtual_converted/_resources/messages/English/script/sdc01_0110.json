      ]
    },
    {
      "ordinal": 37,
      "label": "sdc01_0110_brother_11",
      "hash64": "EDA34A03CD2164A9",
      "text": "Wait—Sis! You’re such a cheater![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
