      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0110_brother_04",
      "hash64": "EDA64B03CD239C33",
      "text": "F-friends... I feel all tingly and funny hearing\\nthat... Ehehe...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
