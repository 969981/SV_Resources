    {
      "ordinal": 3,
      "label": "sdc01_0110_gfather_02",
      "hash64": "A482E6B30424F676",
      "text": "Oho! So this is a new friend of yours, eh, Kieran?[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
