          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "sdc01_0110_gmother_11",
      "hash64": "24BE989E930703D5",
      "text": "Oh, the masks? They should be in the shed.\\nI put them there after last year’s festival.[VAR 0x0114(0037)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0037"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "sdc01_0110_gfather_06",
      "hash64": "A482EAB30424FD42",
      "text": "It shouldn’t be locked, so you three can go have\\na rummage and see what you find.[VAR 0x0114(0030)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0030"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "sdc01_0110_sister_05",
      "hash64": "0F087F773724E846",
      "text": "All right! To the shed! First one there wins![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
