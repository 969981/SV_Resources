    {
      "ordinal": 12,
      "label": "sdc02_0160_dragonbb_c_02",
      "hash64": "0D85D1BE413B3B6C",
      "text": "Elle les adore tellement que pour elle,\\nles entraîner, c’est une partie de plaisir ![VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
