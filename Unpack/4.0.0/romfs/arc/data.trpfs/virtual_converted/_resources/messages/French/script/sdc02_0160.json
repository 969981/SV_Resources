    {
      "ordinal": 11,
      "label": "sdc02_0160_dragonbb_c_01",
      "hash64": "0D85D4BE413B4085",
      "text": "Taro est une bête de combat ! Elle tire sa force\\nde son amour des Pokémon mignons.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
