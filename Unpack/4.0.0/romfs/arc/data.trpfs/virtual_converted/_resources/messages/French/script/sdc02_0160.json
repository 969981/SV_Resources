    },
    {
      "ordinal": 4,
      "label": "sdc02_0160_dragonbb_a_02",
      "hash64": "3515A1ADCF538A5A",
      "text": "C’est bien de pas se prendre la tête, moi je dis ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0160_dragonbb_a_03",
      "hash64": "3515A2ADCF538C0D",
      "text": "Avant, on se retrouvait tous ensemble après\\nnos activités de club, et Rubépin nous préparait\\r\\nde bons petits plats. C’était trop cool...[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
