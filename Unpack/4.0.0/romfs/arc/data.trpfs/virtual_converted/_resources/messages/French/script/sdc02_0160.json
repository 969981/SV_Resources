    },
    {
      "ordinal": 10,
      "label": "sdc02_0160_dragonbb_b_04",
      "hash64": "E1EBCDB7E02E01CF",
      "text": "C’est pas toujours facile de la cerner, mais\\ncrois-moi, ça vaut le coup d’essayer.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
