    {
      "ordinal": 3,
      "label": "sdc02_0160_dragonbb_a_01",
      "hash64": "3515A0ADCF5388A7",
      "text": "Rubépin, c’est un gars simple, il s’encombre pas\\ndes détails. Mais il est loin d’être faible.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
