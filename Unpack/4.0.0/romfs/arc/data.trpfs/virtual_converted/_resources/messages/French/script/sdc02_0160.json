    },
    {
      "ordinal": 9,
      "label": "sdc02_0160_dragonbb_b_03",
      "hash64": "E1EBCAB7E02DFCB6",
      "text": "Elle peut avoir l’air froide et rigide, comme ça...\\nmais en fait, elle est hyper sensible.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
