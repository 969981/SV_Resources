      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "s2_side01_0020_rival_15",
      "hash64": "F20D02A16E94094E",
      "text": "Guess I better at least tell the housekeeper\\nover at my place I’ll be away for a while.[VAR 0x0114(0004)]",
