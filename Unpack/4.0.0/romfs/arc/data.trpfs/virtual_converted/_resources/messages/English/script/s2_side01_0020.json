      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 47,
      "label": "s2_side01_0020_select_04",
      "hash64": "4619083020F10BFA",
      "text": "We should go together!",
