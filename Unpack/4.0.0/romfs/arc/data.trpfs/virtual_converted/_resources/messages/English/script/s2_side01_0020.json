    {
      "ordinal": 23,
      "label": "s2_side01_0020_friend_07",
      "hash64": "173BF49E992CEFB7",
      "text": "Oh, but what about that letter? Aren’t you gonna\\nat least open it up?[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
