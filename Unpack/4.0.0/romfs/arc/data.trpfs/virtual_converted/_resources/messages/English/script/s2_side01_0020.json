      ]
    },
    {
      "ordinal": 24,
      "label": "s2_side01_0020_system_01",
      "hash64": "3C3D2C22F21CB0A6",
      "text": "Dear [VAR 0x0100(0000)],\\n\\nHow are you doing lately? I took a leave from\\nschool, so I’m back in Mossui Town for a while.\\nMy sis came back with me, too.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_side01_0020_system_02",
      "hash64": "3C3D2B22F21CAEF3",
      "text": "I know we didn’t get much chance to talk after\\neverything that happened in the underdepths. I’d\\nreally like to catch up. Think you could swing a\\nvisit to Kitakami? Carmine would love to see you,\\nI’m sure—maybe you could bring your friends\\nfrom Paldea, too. I included plenty of tickets.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 26,
      "label": "s2_side01_0020_friend_08",
      "hash64": "173BE99E992CDD06",
      "text": "Who’s this Kieran guy? Some new...friend or\\nsomething?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_side01_0020_select_01",
      "hash64": "4619053020F106E1",
      "text": "Yeah, just a friend",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "s2_side01_0020_select_02",
      "hash64": "4619023020F101C8",
      "text": "Yeah, he’s...a friend",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "s2_side01_0020_friend_09",
      "hash64": "173BEA9E992CDEB9",
      "text": "Yeah? I mean...guess that’s good for you and all.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
