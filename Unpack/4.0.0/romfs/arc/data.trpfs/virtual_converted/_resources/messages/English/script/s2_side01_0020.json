      "ordinal": 68,
      "label": "s2_side01_0020_mama_11",
      "hash64": "51110E57FC2C2310",
      "text": "Oh, did Nemona and the others leave already?[VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
