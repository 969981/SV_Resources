    {
      "ordinal": 15,
      "label": "s2_side01_0020_mama_05",
      "hash64": "510DA657FC293C81",
      "text": "It’s from...“Kieran.” Do you know a Kieran?[VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side01_0020_mama_06",
      "hash64": "510DA357FC293768",
      "text": "My word, you’ve been making plenty of friends![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side01_0020_mama_07",
      "hash64": "510DA457FC29391B",
      "text": "Really? Well, that’s odd... Still, it WAS addressed\\nto you, so I suppose I shouldn’t read it.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side01_0020_mama_08",
      "hash64": "510DA157FC293402",
      "text": "Here you are.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side01_0020_mama_09",
      "hash64": "510DA257FC2935B5",
      "text": "I’ll bring those sweets up in just a few. I hope\\nyou’ll all enjoy them![VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_side01_0020_rival_03",
      "hash64": "F20984A16E90FD5D",
      "text": "I’ll come help![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
