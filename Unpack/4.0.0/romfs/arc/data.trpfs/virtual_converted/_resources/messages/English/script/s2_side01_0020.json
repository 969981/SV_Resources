          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "s2_side01_0020_rival_09",
      "hash64": "F2097AA16E90EC5F",
      "text": "Are you serious?! We’re DEFINITELY going\\nwith you![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "s2_side01_0020_rival_10",
      "hash64": "F20D07A16E9411CD",
      "text": "This Kieran kid was Champion of a super elite\\nbattle academy, right?! I’ve got to meet him![VAR 0x0114(0004)]",
