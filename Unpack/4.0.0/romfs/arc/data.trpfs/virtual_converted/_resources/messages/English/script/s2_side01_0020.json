      "ordinal": 58,
      "label": "s2_side01_0020_rival_13",
      "hash64": "F20D04A16E940CB4",
      "text": "You bet we do![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
