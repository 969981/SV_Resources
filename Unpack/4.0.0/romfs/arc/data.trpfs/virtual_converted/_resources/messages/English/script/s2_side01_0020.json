          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "s2_side01_0020_friend_19",
      "hash64": "173F6E9E992FF4DC",
      "text": "Oh. Uhhh...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "s2_side01_0020_rival_08",
      "hash64": "F20979A16E90EAAC",
      "text": "Did we miss something? Something good?!\\nSpill it![VAR 0x0114(0004)]",
