      "ordinal": 60,
      "label": "s2_side01_0020_botan_12",
      "hash64": "CA8F6AC038099D39",
      "text": "It’s kind of...scary and exciting at the same time.[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
