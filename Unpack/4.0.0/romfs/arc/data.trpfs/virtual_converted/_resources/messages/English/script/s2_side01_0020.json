        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_side01_0020_friend_02",
      "hash64": "173BEF9E992CE738",
      "text": "And look at this huge room! Doesn’t make you\\nfeel all boxed in like the dorm rooms do.[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0020_friend_03",
      "hash64": "173BF09E992CE8EB",
      "text": "It’s super cute, seriously... Almost too much for\\nme to take![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0020_botan_02",
      "hash64": "CA8C00C03806B344",
      "text": "Oooh, it’s a Nintendo Switch! You HAVE to tell\\nme what games you’ve got on this thing![VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0020_rival_02",
      "hash64": "F20983A16E90FBAA",
      "text": "I love this Skwovet plush! This fluff’s to die for![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
