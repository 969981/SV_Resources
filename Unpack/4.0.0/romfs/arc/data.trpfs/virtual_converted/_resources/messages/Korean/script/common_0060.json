          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_0060_poke_a_01",
      "hash64": "48BC6D79381FC421",
      "text": "하냐아~",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0060_head_teacher_08",
      "hash64": "0FF6D0F97A040254",
      "text": "불꽃악어포켓몬 뜨아거.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
