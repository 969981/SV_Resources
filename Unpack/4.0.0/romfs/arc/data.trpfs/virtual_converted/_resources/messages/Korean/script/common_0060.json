          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0060_poke_c_01",
      "hash64": "C49D196B39DB3303",
      "text": "꽈악뿌루!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "common_0060_head_teacher_10",
      "hash64": "0FFA4EF97A070E45",
      "text": "다들 사람을 잘 따르는지라\\n제게서 떨어지는 법이 없답니다.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0060_head_teacher_11",
      "hash64": "0FFA4DF97A070C92",
      "text": "...어라?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0060_head_teacher_03",
      "hash64": "0FF6CBF97A03F9D5",
      "text": "흐음... 이 교장보다도 [VAR 0x0100(0000)] [VAR 0x1100(00FF,0101)]군양이\\n더 신경 쓰이는 모양이군요.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0060_head_teacher_04",
      "hash64": "0FF6C4F97A03EDF0",
      "text": "선택하는 것을 지켜보고 싶지만\\n슬슬 다음 집에도 가 봐야겠네요...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0060_head_teacher_05",
      "hash64": "0FF6C5F97A03EFA3",
      "text": "저는 저쪽에 있는 집에 가 있을 테니\\n신중히 생각해 보시고\\r\\n결정되시면 제게 알려 주세요.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0060_head_teacher_06",
      "hash64": "0FF6C6F97A03F156",
      "text": "그럼, 잠시 후에 뵙죠.\\n...실례했습니다.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0060_mama_01",
      "hash64": "3C5488FF337D9E1E",
      "text": "정말 정중하신\\n교장 선생님이구나.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0060_mama_02",
      "hash64": "3C5487FF337D9C6B",
      "text": "그나저나 다들 멋있는데...\\n한 마리만 골라야 하는 거지?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0060_mama_03",
      "hash64": "3C5486FF337D9AB8",
      "text": "모처럼 온 기회인데\\n이 아이들이랑 같이 다니면서\\r\\n한번 살펴보는 건 어떠니?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_0060_mama_04",
      "hash64": "3C548DFF337DA69D",
      "text": "포켓몬에 대해\\n많이 알 수 있을 거야.[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0060_mama_05",
      "hash64": "3C548CFF337DA4EA",
      "text": "그리고 이건...\\n엄마가 주는 입학 선물이야!\\r\\n외출할 때 꼭 가지고 다니렴![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "common_0060_mama_06",
      "hash64": "3C548BFF337DA337",
      "text": "새 스마트폰이야!\\n설명서를 읽어 줄게!\\c\\n“길을 잃었다면 [VAR 0xFF00(0006)]Y 버튼[VAR 0xFF00(0000)]!”\\n이러면 간단하게 지도를 볼 수 있대.\\r\\n소중히 다루렴![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "common_0060_mama_07",
      "hash64": "3C548AFF337DA184",
      "text": "그럼, 잘 다녀와![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
