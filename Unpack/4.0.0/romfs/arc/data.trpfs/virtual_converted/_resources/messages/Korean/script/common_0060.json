      ]
    },
    {
      "ordinal": 7,
      "label": "common_0060_poke_b_01",
      "hash64": "EF87AD5FF0CE9DAE",
      "text": "따거어~",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "common_0060_head_teacher_09",
      "hash64": "0FF6D1F97A040407",
      "text": "꼬마오리포켓몬 꾸왁스.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
