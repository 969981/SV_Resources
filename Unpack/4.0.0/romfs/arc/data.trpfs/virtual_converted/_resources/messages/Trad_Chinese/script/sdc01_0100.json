      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0100_sister_16",
      "hash64": "6ED540A31972F90F",
      "text": "那麼，各就各位吧。\\n大家也讓個地方出來。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
