      "ordinal": 17,
      "label": "sdc01_0100_brother_04",
      "hash64": "02CFFF02D2FE7150",
      "text": "哇、哇咧老天哦。\\n……可、可以嗎！？[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
