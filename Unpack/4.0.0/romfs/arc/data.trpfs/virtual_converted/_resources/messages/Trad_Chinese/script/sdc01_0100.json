          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0100_sister_12",
      "hash64": "6ED53CA31972F243",
      "text": "什麼？我完全聽不到……\\c\\n[VAR 0x1100(00FF,0101)]你妳要是想答應了，\\n再來跟我說一聲吧。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
