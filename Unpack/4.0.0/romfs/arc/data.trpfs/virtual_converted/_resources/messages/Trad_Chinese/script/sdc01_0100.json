          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 3,
