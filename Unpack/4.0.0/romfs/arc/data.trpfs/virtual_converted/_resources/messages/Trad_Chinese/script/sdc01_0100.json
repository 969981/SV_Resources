      "ordinal": 26,
      "label": "sdc01_0100_brother_08",
      "hash64": "02D00B02D2FE85B4",
      "text": "…………唔。[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
