    {
      "ordinal": 2,
      "label": "sdc01_0100_sister_03",
      "hash64": "6ED1BBA3196FE139",
      "text": "竟然主動來搭話，\\n我還真是佩服、佩服。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
