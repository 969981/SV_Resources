      "ordinal": 20,
      "label": "sdc01_0100_brother_05",
      "hash64": "02D00002D2FE7303",
      "text": "我……要拼沖天！[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
