      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0100_brother_02",
      "hash64": "02D00502D2FE7B82",
      "text": "唔唔……[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
