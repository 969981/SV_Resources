          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0100_brother_01",
      "hash64": "02D00402D2FE79CF",
      "text": "笨蛋！姐～！\\n妳怎麼說出來了！！[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0100_sister_07",
      "hash64": "6ED1BFA3196FE805",
      "text": "誰是笨蛋啊！\\n小心我修理你！[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
