        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0100_student1_01",
      "hash64": "F5FB6C36E5761431",
      "text": "打得漂亮～！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sdc01_0100_bbteacher_01",
      "hash64": "0F1D3B6D4E12391F",
      "text": "交流戰打得不錯！\\n這就是青春啊！[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0100_brother_06",
      "hash64": "02D00102D2FE74B6",
      "text": "……果然哇咧老天哦！\\n太強了！[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳太強了！[VAR 0x0114(0043)]",
