          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0100_sister_10",
      "hash64": "6ED53EA31972F5A9",
      "text": "我想反正他自己也說不出口，\\n[VAR 0x1100(00FF,0101)]你妳就和我弟弟打場對戰吧。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
