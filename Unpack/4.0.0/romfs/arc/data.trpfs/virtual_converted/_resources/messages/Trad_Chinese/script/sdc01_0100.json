          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0100_sister_06",
      "hash64": "6ED1BEA3196FE652",
      "text": "在家也一直提[VAR 0x1100(00FF,0101)]你妳的事，\\n真是吵死了……[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
