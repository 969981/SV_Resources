    {
      "ordinal": 25,
      "label": "sdc01_0100_sister_17",
      "hash64": "6ED53FA31972F75C",
      "text": "阿栗的實力只差我一點，\\n[VAR 0x1100(00FF,0101)]你妳挺有兩下子的嘛。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
