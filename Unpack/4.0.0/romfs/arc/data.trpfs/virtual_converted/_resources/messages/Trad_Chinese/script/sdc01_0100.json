      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0100_sister_05",
      "hash64": "6ED1BDA3196FE49F",
      "text": "對了，從昨天阿栗他就……\\n我弟弟他就對[VAR 0x1100(00FF,0101)]你妳著迷得不得了呢。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
