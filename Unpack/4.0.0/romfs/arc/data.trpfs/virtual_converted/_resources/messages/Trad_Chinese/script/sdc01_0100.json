      "ordinal": 28,
      "label": "sdc01_0100_sister_19",
      "hash64": "6ED545A31973018E",
      "text": "我說[VAR 0x1100(00FF,0101)]你妳啊，\\n就和阿栗一組吧。[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
