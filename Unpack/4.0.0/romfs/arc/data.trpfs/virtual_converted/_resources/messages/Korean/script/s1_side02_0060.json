        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_side02_0060_select_04",
      "hash64": "75749F56FDB0F4C4",
      "text": "[VAR 0x0100(0000)]...",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
