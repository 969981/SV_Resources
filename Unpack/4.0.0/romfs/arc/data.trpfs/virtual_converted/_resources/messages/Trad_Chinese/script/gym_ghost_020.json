      ]
    },
    {
      "ordinal": 43,
      "label": "gym_ghost_020_mc_14",
      "hash64": "75CC545A7E85FE06",
      "text": "讓我背脊發涼的一體感！\\n呼喚主角登場的準備完～美就緒啦！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
