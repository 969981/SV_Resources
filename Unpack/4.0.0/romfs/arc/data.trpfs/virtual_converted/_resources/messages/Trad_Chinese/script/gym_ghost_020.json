    },
    {
      "ordinal": 18,
      "label": "gym_ghost_020_mc_21",
      "hash64": "75C8D15A7E82E996",
      "text": "首先前來阻擋挑戰者[VAR 0x0100(0000)]\\n的對手是……[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
