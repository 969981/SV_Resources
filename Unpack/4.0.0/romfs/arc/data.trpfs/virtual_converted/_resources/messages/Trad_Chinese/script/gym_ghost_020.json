          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "gym_ghost_020_mobs_03",
      "hash64": "FF74B7E15C0EF8DF",
      "text": "萊姆！萊姆！萊姆！\\n萊姆！萊姆！萊姆！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
