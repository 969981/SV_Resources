          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "gym_ghost_020_mc_18",
      "hash64": "75CC605A7E86126A",
      "text": "接下來暫時都是萊姆的演出時段，\\n[VAR 0x1100(00FF,0101)]你妳先去道館櫃台報告結果吧。[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
