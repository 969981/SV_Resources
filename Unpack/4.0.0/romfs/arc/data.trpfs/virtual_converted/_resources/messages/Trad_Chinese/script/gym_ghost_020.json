          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_ghost_020_mc_30",
      "hash64": "75C54C5A7E7FD1C0",
      "text": "呼喚微風的少年藝人，\\n幽漾！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
