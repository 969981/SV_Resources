      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "gym_ghost_020_mc_no_double",
      "hash64": "3CE24182F9EB5218",
      "text": "唉呀呀！這道館測驗\\n得要有至少２隻能對戰的寶可夢喔！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
