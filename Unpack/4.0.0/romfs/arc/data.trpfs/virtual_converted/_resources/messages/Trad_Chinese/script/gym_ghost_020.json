          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "gym_ghost_020_mc_31",
      "hash64": "75C54D5A7E7FD373",
      "text": "主持與寶可夢都是我的拿手絕活！\\n看我雙管齊下，把[VAR 0x1100(00FF,0101)]你妳耍得團團轉！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
