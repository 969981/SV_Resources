    },
    {
      "ordinal": 29,
      "label": "gym_ghost_020_mc_23",
      "hash64": "75C8CF5A7E82E630",
      "text": "Come on！保持這個氣勢，\\n繼續轟動全場吧！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
