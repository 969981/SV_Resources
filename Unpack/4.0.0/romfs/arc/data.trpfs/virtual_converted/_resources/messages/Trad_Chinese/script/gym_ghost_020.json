      "ordinal": 48,
      "label": "gym_ghost_020_ghost_02",
      "hash64": "38CC8C00F77B2068",
      "text": "你們……[VAR 0x0114(001B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
