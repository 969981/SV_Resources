    },
    {
      "ordinal": 30,
      "label": "gym_ghost_020_mc_24",
      "hash64": "75C8D65A7E82F215",
      "text": "進入下一場對戰！\\n這次的對手是……[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
