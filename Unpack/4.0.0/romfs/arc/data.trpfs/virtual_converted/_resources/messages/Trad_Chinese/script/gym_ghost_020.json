          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "gym_ghost_020_mc_27",
      "hash64": "75C8D35A7E82ECFC",
      "text": "這真是天外飛來的驚喜！\\n想不到[VAR 0x0100(0000)]會表現得如此勁爆！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "gym_ghost_020_mc_28",
      "hash64": "75C8DA5A7E82F8E1",
      "text": "接下來就是壓軸的第３人啦。\\n最後的對手是……[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "gym_ghost_020_mc_29",
      "hash64": "75C8D95A7E82F72E",
      "text": "我！ＭＣ卡蒙！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
