          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_ghost_020_mc_cancel",
      "hash64": "356C8E8436519EE5",
      "text": "這可是個責任重大的工作！\\n[VAR 0x1100(00FF,0101)]你妳要仔細做好準備啊！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_ghost_020_mc_07",
      "hash64": "75CFE35A7E8926DA",
      "text": "那就不做預演，直接正式開始囉！\\n上台去吧！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
