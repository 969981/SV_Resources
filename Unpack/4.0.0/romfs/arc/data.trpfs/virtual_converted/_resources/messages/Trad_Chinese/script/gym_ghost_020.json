    {
      "ordinal": 52,
      "label": "gym_ghost_020_mc_17",
      "hash64": "75CC535A7E85FC53",
      "text": "道館測驗辛苦了。\\n[VAR 0x1100(00FF,0101)]你妳的表現真的是超棒的。謝謝。[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
