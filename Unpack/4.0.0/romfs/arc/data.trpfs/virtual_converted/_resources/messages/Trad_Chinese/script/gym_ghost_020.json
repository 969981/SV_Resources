          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "gym_ghost_020_system_03",
      "hash64": "A6867EAD00458329",
      "text": "觀眾的熱情達到最高潮了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "gym_ghost_020_mobs_01",
      "hash64": "FF74B9E15C0EFC45",
      "text": "哇～！哇～！\\n好驚人的對戰啊！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "gym_ghost_020_mobs_02",
      "hash64": "FF74B6E15C0EF72C",
      "text": "太難得了！\\n這種對戰很少見呢！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "gym_ghost_020_mc_13",
      "hash64": "75CC575A7E86031F",
      "text": "謝謝啦～[VAR 0x0100(0000)]！\\n[VAR 0x1100(00FF,0101)]你妳的道館測驗及格了！恭喜！\\r\\n大家請給[VAR 0x1100(00FF,0101)]他她熱烈的掌聲～！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
