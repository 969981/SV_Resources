          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 44,
      "label": "gym_ghost_020_mc_15",
      "hash64": "75CC555A7E85FFB9",
      "text": "那麼，請各位一起呼喊吧！\\n我們今天的主角……[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 45,
      "label": "gym_ghost_020_mc_16",
      "hash64": "75CC525A7E85FAA0",
      "text": "Come on！\\n深情靈魂饒舌樂……萊～～姆！！[VAR 0x0114(003B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
