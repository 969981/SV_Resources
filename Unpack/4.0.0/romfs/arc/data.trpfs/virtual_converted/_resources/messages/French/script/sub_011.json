          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_011_takara_cook_03",
      "hash64": "23786EEE06E9CDDC",
      "text": "Pour ça, il va me falloir des Téra-Éclats,\\nalors n’hésite pas à venir me voir si tu en as !\\c\\nAllez, comme c’est ta première fois, je t’offre\\nde quoi transformer le type Téracristal\\r\\nd’un Pokémon en type Normal !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 182,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_011_takara_cook_04",
      "hash64": "23786DEE06E9CC29",
      "text": "Tu veux que je te prépare un plat qui permet de\\nchanger le type Téracristal d’un de tes Pokémon ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
