      ]
    },
    {
      "ordinal": 1,
      "label": "class_f_07_dragon_02",
      "hash64": "689D1EC798109993",
      "text": "Ah, come vola il tempo![VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
