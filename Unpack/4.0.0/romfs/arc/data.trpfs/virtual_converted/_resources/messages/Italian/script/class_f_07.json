          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_f_07_dragon_03",
      "hash64": "689D1DC7981097E0",
      "text": "Ebbene sì, siamo purtroppo arrivati all’ultima\\nlezione del corso.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_f_07_dragon_04",
      "hash64": "689D24C79810A3C5",
      "text": "L’argomento di oggi potrebbe allontanarsi\\nun po’ dall’educazione artistica.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "class_f_07_dragon_05",
      "hash64": "689D23C79810A212",
      "text": "D’altronde, nell’arte non esistono prescrizioni![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_f_07_dragon_06",
      "hash64": "689D22C79810A05F",
      "text": "Quindi mi permetterò di parlarvene senza troppe\\nremore.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_f_07_dragon_07",
      "hash64": "689D21C798109EAC",
      "text": "Vorrei che ricordaste due cose!\\nI fiocchi e gli emblemi![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_f_07_dragon_08",
      "hash64": "689D28C79810AA91",
      "text": "Sia fiocchi che emblemi descrivono un Pokémon.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_f_07_dragon_09",
      "hash64": "689D27C79810A8DE",
      "text": "I fiocchi sono un riconoscimento per i risultati\\nconseguiti dai Pokémon.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_f_07_dragon_10",
      "hash64": "68999AC7980D8370",
      "text": "Si mettono a un Pokémon quando si è impegnato\\nparticolarmente e ha accumulato esperienza.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_f_07_dragon_11",
      "hash64": "68999BC7980D8523",
      "text": "Per farvi un esempio, se un Pokémon ha stretto\\nun profondo legame con il suo Allenatore,\\r\\nsi può fregiare del Fiocco Amicizia.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_f_07_dragon_12",
      "hash64": "68999CC7980D86D6",
      "text": "La persona che conferisce il Fiocco Amicizia\\nsi trova a Garrafopoli.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "class_f_07_dragon_13",
      "hash64": "68999DC7980D8889",
      "text": "Diverso, invece, è il caso degli emblemi.\\c\\nIn linea generale, i Pokémon ce li hanno già\\nnel momento in cui li incontriamo.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "class_f_07_dragon_14",
      "hash64": "68999EC7980D8A3C",
      "text": "Esprimono le loro caratteristiche, come nel caso\\ndell’Emblema Monello o dell’Emblema Vitalità.[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_f_07_dragon_15",
      "hash64": "68999FC7980D8BEF",
      "text": "La possibilità di incontrare un Pokémon\\ncon un emblema dipende solo dal caso![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "class_f_07_dragon_16",
      "hash64": "6899A0C7980D8DA2",
      "text": "Catturare un Pokémon che ha un emblema\\nè una vera fortuna.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "class_f_07_dragon_17",
      "hash64": "6899A1C7980D8F55",
      "text": "Ma non è tutto! I Pokémon con fiocchi o emblemi\\nci danno la possibilità di fare un’altra cosa.\\c\\nChi sa dirmi quale?[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "class_f_07_select_01",
      "hash64": "C0657641DF5250AF",
      "text": "Scambiare i fiocchi",
      "flags": 8,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_f_07_select_02",
      "hash64": "C0657741DF525262",
      "text": "Vantarci",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "class_f_07_select_03",
      "hash64": "C0657841DF525415",
      "text": "Dargli un nomignolo",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "class_f_07_dragon_answer_01",
      "hash64": "EF6D7BA03A2EB6C7",
      "text": "Mi dispiace, ma i fiocchi o gli emblemi non\\nsi possono cedere o scambiare...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "class_f_07_dragon_answer_02",
      "hash64": "EF6D7CA03A2EB87A",
      "text": "Puoi vantartene senza alcun dubbio, ma possono\\nriservare anche qualche altra soddisfazione![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "class_f_07_dragon_answer_03",
      "hash64": "EF6D7DA03A2EBA2D",
      "text": "[VAR 0xBD06(0000)]Complimenti, [VAR 0x0100(0000)]! Preparatissim[VAR 0x1100(00FF,0101)]oa\\ncome sempre![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BD06",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "class_f_07_dragon_18",
      "hash64": "6899A2C7980D9108",
      "text": "Dovete sapere infatti un’altra cosa sui Pokémon\\nche hanno dei fiocchi o degli emblemi...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "class_f_07_dragon_19",
      "hash64": "6899A3C7980D92BB",
      "text": "Possono essere chiamati con un nomignolo\\na scelta al momento di mandarli in campo.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "class_f_07_dragon_20",
      "hash64": "68A3ACC79815F68B",
      "text": "Per esempio, se ne avessimo uno con il Fiocco\\nAmicizia potremmo dire:\\r\\n\"Avanti, Gible fedele partner!\"[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "class_f_07_dragon_21",
      "hash64": "68A3ABC79815F4D8",
      "text": "Tra l’altro, poco fa vi ho spiegato che nella\\nmaggior parte dei casi i Pokémon hanno già\\r\\ngli emblemi quando li si incontra...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "class_f_07_dragon_22",
      "hash64": "68A3AEC79815F9F1",
      "text": "Ma sembra che di recente alcuni di essi possano\\nessere acquisiti con l’impegno in certi ambiti.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "class_f_07_dragon_23",
      "hash64": "68A3ADC79815F83E",
      "text": "Ad esempio l’Emblema Gourmet, l’Emblema\\nPigliatutto o l’Emblema Compagno Fidato...[VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_f_07_dragon_24",
      "hash64": "68A3B0C79815FD57",
      "text": "Potrebbe essere interessante fare qualche ricerca\\nsu questi emblemi basandosi sui loro nomi.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "class_f_07_dragon_25",
      "hash64": "68A3AFC79815FBA4",
      "text": "E con questo termina la nostra ultima lezione![VAR 0x0114(0012)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "class_f_07_dragon_26",
      "hash64": "68A3B2C7981600BD",
      "text": "Ci attende solo l’esame finale.\\c\\nMi raccomando, ripassate bene se volete\\nsuperarlo al primo colpo![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
