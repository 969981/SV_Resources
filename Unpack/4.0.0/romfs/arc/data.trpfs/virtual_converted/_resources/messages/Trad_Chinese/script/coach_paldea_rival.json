    {
      "ordinal": 2,
      "label": "coach_paldea_rival_sp01_00",
      "hash64": "38E7FF6224AD0CEA",
      "text": "藍莓學園和學院\\n真的完全不一樣呢！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
