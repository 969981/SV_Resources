    {
      "ordinal": 3,
      "label": "coach_paldea_rival_sp01_01",
      "hash64": "38E8006224AD0E9D",
      "text": "我稍微參觀了一下生態巨蛋，\\n真不敢相信那竟然是在海裡！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
