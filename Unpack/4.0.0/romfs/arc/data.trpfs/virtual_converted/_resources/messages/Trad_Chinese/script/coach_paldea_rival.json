      "hash64": "3C8568E6B4C9FE6C",
      "text": "太好了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea_rival_sp01_select_02",
      "hash64": "3C856BE6B4CA0385",
      "text": "要適可而止喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_paldea_rival_sp01_03",
      "hash64": "38E7FE6224AD0B37",
      "text": "嗯！事情辦完之後，\\n我要去找遍這裡的人，和他們一個個對戰！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
