    },
    {
      "ordinal": 4,
      "label": "s2_side01_0000_friend_02",
      "hash64": "A84FD88B63CAADE2",
      "text": "Mi è giunta voce delle tue grandi avventure! Un\\nviaggio di studio, eh? Che storia! Com’è andata?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_side01_0000_select_01",
      "hash64": "BF719182D239233B",
      "text": "È stato bellissimo!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "s2_side01_0000_select_02",
      "hash64": "BF719282D23924EE",
      "text": "Mah, non mi lamento...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "s2_side01_0000_friend_03",
      "hash64": "A84FD98B63CAAF95",
      "text": "Ah, beat[VAR 0x1100(00FF,0101)]oa te! Avrei voluto venire anch’io![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
