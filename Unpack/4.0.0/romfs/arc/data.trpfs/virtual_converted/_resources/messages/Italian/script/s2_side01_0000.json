      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side01_0000_friend_11",
      "hash64": "A8535B8B63CDC252",
      "text": "Beh, allora è deciso![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
