    },
    {
      "ordinal": 13,
      "label": "s2_side01_0000_select_03",
      "hash64": "BF719382D23926A1",
      "text": "Vieni pure!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "s2_side01_0000_select_04",
      "hash64": "BF719482D2392854",
      "text": "Perché? Che succede?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "s2_side01_0000_friend_09",
      "hash64": "A84FDF8B63CAB9C7",
      "text": "Davvero?! Grande! Era proprio quello\\nche speravo di sentire![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
