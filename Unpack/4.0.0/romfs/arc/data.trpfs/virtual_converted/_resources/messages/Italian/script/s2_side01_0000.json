        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side01_0000_friend_12",
      "hash64": "A8535A8B63CDC09F",
      "text": "Tu abiti a... Dosilla, giusto?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
