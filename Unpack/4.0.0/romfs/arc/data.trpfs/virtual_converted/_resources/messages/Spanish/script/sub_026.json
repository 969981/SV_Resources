  "entries": [
    {
      "ordinal": 0,
      "label": "sub_025_sitappa_a_01",
      "hash64": "374EC4ECC983AA5C",
      "text": "Bienvenid[VAR 0x1100(00FF,0101)]oa a la guarida de las estrellas rebeldes\\ndel Team Star. Somos desertores, ¡y con orgullo!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sub_025_sitappa_a_02",
      "hash64": "374EC7ECC983AF75",
      "text": "Lo de la Operación Stardust, las declaraciones\\nde guerra... ¡Todo eso nos la trae al fresco!\\c\\nPasamos de los rollos de los jefes, y ellos\\nde los nuestros.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sub_025_sitappa_a_03",
      "hash64": "374EC6ECC983ADC2",
      "text": "Te invitaría a tomar algo, pero no tenemos gran\\ncosa. Si quieres, llévate esto.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "sub_025_system_01",
      "hash64": "284BBDA29079A845",
      "text": "Has obtenido una [VAR 0xFF00(0008)]Gorra deportiva (Team Star)[VAR 0xFF00(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_025_sitappa_a_04",
      "hash64": "374EC1ECC983A543",
      "text": "Puedes quedarte aquí el tiempo que quieras y,\\ncuando quieras irte, pues libre eres también.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_025_sitappa_a_05",
      "hash64": "374EC0ECC983A390",
      "text": "Esta es la guarida de las estrellas rebeldes del\\nTeam Star. Somos desertores, ¡y con orgullo!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_025_sitappa_b_01",
      "hash64": "61CCBCE1801AED13",
      "text": "Estamos hartos de armar jaleo con la pandilla...\\nHasta hemos vuelto a ir a clase a escondidas.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_025_sitappa_c_01",
      "hash64": "5EDE10DC579B18FE",
      "text": "¡Astro la vista! ¡Que vaya bien el día!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sub_025_sitappa_d_01",
      "hash64": "895C88D10E333535",
      "text": "Aquí no hay peleas. Se está más a gusto que en\\nla academia, que en pandilla con el Team Star y\\r\\nque en nuestras casas.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    }
  ]
}
