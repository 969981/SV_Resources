    {
      "ordinal": 1,
      "label": "common_2050_top_02",
      "hash64": "7B9F6301D9F9EBED",
      "text": "Questo è il luogo in cui hai coltivato quel talento\\nnaturale che ti ha portat[VAR 0x1100(00FF,0101)]oa al successo![VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
