          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "champ_0200_ground_05a",
      "hash64": "E256214BCA76A10E",
      "text": "Mica me ricordo quann’è stata l’urtima vorta che\\nquarcuno l’ha superata alla prima botta.\\r\\nSe nun me sbajo era stata Nemi.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
