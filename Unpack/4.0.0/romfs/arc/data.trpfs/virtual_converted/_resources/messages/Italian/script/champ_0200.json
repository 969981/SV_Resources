          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0200_ground_05b",
      "hash64": "E256204BCA769F5B",
      "text": "Nun me spiego perché c’hai messo così tanto\\na ingranà, però vabbè...[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0200_ground_06",
      "hash64": "31D7DF1AA830898E",
      "text": "Daje su, mo la potemo fà finita de profumà\\ni Stunky e passamo a le cose serie, che dici?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "champ_0200_ground_07",
      "hash64": "31D7E01AA8308B41",
      "text": "’A seconda prova se chiama sfida coi\\nSuperquattro.\\r\\nProva un po’ a indovinà de che se tratta...?[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "champ_0200_ground_08",
      "hash64": "31D7D91AA8307F5C",
      "text": "Too dico io: è ’na prova pratica de lotta\\ncontro noantri Superquattro.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0200_ground_09",
      "hash64": "31D7DA1AA830810F",
      "text": "’O so, nun è er nome più fantasioso der monno.[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0200_ground_10",
      "hash64": "31DAE71AA832CCFD",
      "text": "Comunque occhio che t’aspettano quattro lotte\\nuna appresso all’artra contro li mejo Allenatori\\r\\nche ce stanno![VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
