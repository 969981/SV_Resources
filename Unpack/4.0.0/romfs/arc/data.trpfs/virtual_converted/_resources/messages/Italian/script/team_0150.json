      ]
    },
    {
      "ordinal": 25,
      "label": "team_0150_nelke_14",
      "hash64": "8E9C792DDE1C2271",
      "text": "Così come Cassiopea era in realtà Penny,\\nGaroff era in realtà Clavel.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
