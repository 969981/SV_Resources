      ]
    },
    {
      "ordinal": 3,
      "label": "team_0150_nelke_02",
      "hash64": "8E99792DDE19EC9A",
      "text": "Attenda un att... Cioè, aspetta un secondo!\\nVolevo chiarire una cosa.[VAR 0x0114(001E)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
