    {
      "ordinal": 17,
      "label": "team_0150_botan_09",
      "hash64": "D934E0368E4D8EA4",
      "text": "... il mio tesoro più prezioso.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
