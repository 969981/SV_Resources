    },
    {
      "ordinal": 18,
      "label": "team_0150_nelke_10",
      "hash64": "8E9C7D2DDE1C293D",
      "text": "Splendido. Ritengo di aver compreso appieno\\nla situazione, cara Penny.[VAR 0x0114(001E)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "team_0150_botan_10",
      "hash64": "D931D3368E4B42B6",
      "text": "... Eh?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
