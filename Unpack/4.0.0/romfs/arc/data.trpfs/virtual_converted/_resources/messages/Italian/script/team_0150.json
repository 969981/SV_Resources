      ]
    },
    {
      "ordinal": 2,
      "label": "team_0150_botan_02",
      "hash64": "D934DB368E4D8625",
      "text": "Per me e il Team Star ormai è la fi...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
