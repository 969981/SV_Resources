      ]
    },
    {
      "ordinal": 4,
      "label": "team_0150_botan_03",
      "hash64": "D934DA368E4D8472",
      "text": "Cosa?[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
