      "ordinal": 24,
      "label": "team_0150_botan_12",
      "hash64": "D931D1368E4B3F50",
      "text": "Pre... Preside?![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
