          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "team_0150_botan_13",
      "hash64": "D931D2368E4B4103",
      "text": "Ma... perché?![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
