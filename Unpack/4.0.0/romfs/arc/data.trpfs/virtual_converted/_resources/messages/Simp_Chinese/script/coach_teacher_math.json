    {
      "ordinal": 0,
      "label": "coach_teacher_math_first_00",
      "hash64": "7FD96AB20A9E1167",
      "text": "蓝莓学园的各位，\\n很高兴认识大家。[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
