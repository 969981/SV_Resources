    },
    {
      "ordinal": 24,
      "label": "coach_paldea_top_sp02_04d",
      "hash64": "22016BA3718A964E",
      "text": "Erin, una Superquattro della Lega Mirtillo!\\c\\nEssendo un’esperta del tipo Acciaio, suppongo\\nche andrebbe d’accordo con Verina.\\c\\nLe strategie che riesce a escogitare grazie al\\nsuo sangue freddo potrebbero portare lustro\\r\\na Paldea.[VAR 0x0114(0011)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 127,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
