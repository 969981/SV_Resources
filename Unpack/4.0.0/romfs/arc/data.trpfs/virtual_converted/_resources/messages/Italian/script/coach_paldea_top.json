    {
      "ordinal": 21,
      "label": "coach_paldea_top_sp02_04",
      "hash64": "0EC7250AF8059D1E",
      "text": "Riben, ovvero l’ex Campione della Lega Mirtillo!\\c\\nÈ un Allenatore talentuoso che si è avventurato\\npersino nella Voragine di Paldea...\\c\\nConsiderato il profondo legame di amicizia che\\nvi lega, forse accetterebbe di venire a Paldea.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 1,
          "code_hex": "BE01",
