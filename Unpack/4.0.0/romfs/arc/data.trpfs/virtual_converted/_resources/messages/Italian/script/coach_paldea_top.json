          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_paldea_top_sp02_04c",
      "hash64": "22016EA3718A9B67",
      "text": "Piros... Il Superquattro della Lega Mirtillo.\\c\\nNella Lega Pokémon manca un esperto\\ndel tipo Fuoco.\\r\\nPotrebbe portare una ventata di freschezza.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
