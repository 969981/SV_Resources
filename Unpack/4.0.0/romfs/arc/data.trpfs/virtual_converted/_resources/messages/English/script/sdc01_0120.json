    {
      "ordinal": 2,
      "label": "sdc01_0120_sister_02",
      "hash64": "204EE5B2E8AAB314",
      "text": "Tch! Just rolling up like you own the place.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
