        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0120_sister_03",
      "hash64": "204EE6B2E8AAB4C7",
      "text": "Well, it looks like there’re only two masks in the\\nshed.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
