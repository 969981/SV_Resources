        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0120_select_01",
      "hash64": "4B6B4756877BB589",
      "text": "Seriously?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sdc01_0120_select_02",
      "hash64": "4B6B4456877BB070",
      "text": "That’s fine...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "sdc01_0120_sister_06",
      "hash64": "204EE1B2E8AAAC48",
      "text": "C’mon now, don’t look so glum![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
