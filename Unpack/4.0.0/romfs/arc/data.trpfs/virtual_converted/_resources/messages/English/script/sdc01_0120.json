          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0120_sister_09",
      "hash64": "204EE0B2E8AAAA95",
      "text": "...Oh well! It’s not like beating me was gonna\\ncause another mask to magically appear.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
