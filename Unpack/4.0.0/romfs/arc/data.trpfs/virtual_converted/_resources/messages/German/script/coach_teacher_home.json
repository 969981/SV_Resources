      "ordinal": 27,
      "label": "coach_teacher_home_sp03_select_02",
      "hash64": "A7186BC0337C87F9",
      "text": "Man muss ihm sagen, wie putzig es ist.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
