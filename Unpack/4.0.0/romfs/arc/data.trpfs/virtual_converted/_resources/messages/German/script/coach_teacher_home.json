      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_home_sp03_04",
      "hash64": "8C60D4B9C310023A",
      "text": "Das ist korrekt, [VAR 0x0100(0000)]!\\c\\nHast du es schon mal selbst ausprobiert?[VAR 0x0114(0029)]",
