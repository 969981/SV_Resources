    },
    {
      "ordinal": 25,
      "label": "coach_teacher_home_sp03_03",
      "hash64": "8C60CFB9C30FF9BB",
      "text": "Kennst du die ungewöhnliche Methode, die für\\nHokumils Entwicklung notwendig ist?[VAR 0x0114(0029)]",
