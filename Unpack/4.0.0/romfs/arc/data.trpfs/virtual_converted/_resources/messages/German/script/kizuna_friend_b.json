    },
    {
      "ordinal": 5,
      "label": "kizuna_friend_b_head_01a",
      "hash64": "2E7B1A64DB913737",
      "text": "Als Antiqua hier studierte, war ich noch ein\\nForscher.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
