      "hash64": "592C7F97C3E6152F",
      "text": "[VAR 0x0100(0000)]从同步米那里\\n获得了[VAR 0x0204(0001,0000)]ＢＰ！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
