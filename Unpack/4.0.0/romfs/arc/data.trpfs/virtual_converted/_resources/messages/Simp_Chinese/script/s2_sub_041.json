            "0001",
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s2_sub_041_synchro_01",
      "hash64": "86F82819633C9676",
      "text": "唔唔～嗯，同步咯～！[VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002C"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s2_sub_041_synchro_02",
      "hash64": "86F82719633C94C3",
      "text": "……啊！\\n我是个厉害的研究员，\\r\\n名字叫做同步米！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s2_sub_041_synchro_03",
      "hash64": "86F82619633C9310",
      "text": "你愿意协助我为厉害的实验\\n提供反馈信息吗？[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s2_sub_041_synchro_04",
      "hash64": "86F82D19633C9EF5",
      "text": "世纪大发现……\\n你可是有机会目睹它的啊！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s2_sub_041_synchro_05",
      "hash64": "86F82C19633C9D42",
      "text": "[EMPTY 31]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s2_sub_041_synchro_add_01",
      "hash64": "A20963AB7E34341A",
      "text": "这样就对了！\\n我们去做实验的地方吧！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_sub_041_synchro_add_02",
      "hash64": "A20962AB7E343267",
      "text": "接下来我们要做的实验\\n必须带着宝可梦一起走才可以。[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_sub_041_synchro_add_03",
      "hash64": "A20961AB7E3430B4",
      "text": "你做好准备后，\\n跟我说一声吧！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_sub_041_synchro_add_04",
      "hash64": "A20960AB7E342F01",
      "text": "你能协助我为厉害的实验\\n提供反馈信息吗？[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_sub_041_synchro_06",
      "hash64": "86F82B19633C9B8F",
      "text": "这样就对了！\\n那么，立马开始吧……\\r\\n同步同步咯～！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_sub_041_synchro_07",
      "hash64": "86F82A19633C99DC",
      "text": "你和宝可梦的心情\\n现在已经同步了！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_sub_041_synchro_08",
      "hash64": "86F83119633CA5C1",
      "text": "因为是同步的，所以你怎么想，\\n宝可梦就会怎么动！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_sub_041_synchro_09",
      "hash64": "86F83019633CA40E",
      "text": "那么，我们就从步行测试开始吧！\\n试着走到对面的树那里！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_sub_041_synchro_10",
      "hash64": "86F4A31963397EA0",
      "text": "唔唔～嗯！\\n你的同步性非～常不错！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_sub_041_synchro_11",
      "hash64": "86F4A41963398053",
      "text": "我收集到很好的数据了，谢谢你！\\n这是……一点薄礼！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_sub_041_synchro_12",
      "hash64": "86F4A51963398206",
      "text": "你真的非常有天分，\\n所以就再陪我做１次实验吧！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_sub_041_synchro_13",
      "hash64": "86F4A619633983B9",
      "text": "下一个实验会有点辛苦，\\n所以我要送你的不是薄礼，而是厉害的东西！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_sub_041_synchro_14",
      "hash64": "86F4A7196339856C",
      "text": "你终于愿意协助我为厉害的实验\\n提供反馈信息了？[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_sub_041_synchro_15",
      "hash64": "86F4A8196339871F",
      "text": "世纪大、大发现……\\n你可是有机会成为先驱者的啊！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_sub_041_synchro_16",
      "hash64": "86F4A919633988D2",
      "text": "那我们开始吧～！\\n同步同步咯～！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_sub_041_synchro_17",
      "hash64": "86F4AA1963398A85",
      "text": "你和宝可梦的心情\\n现已再度同步了！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_sub_041_synchro_18",
      "hash64": "86F4AB1963398C38",
      "text": "你已经是第２次同步了，\\n应该能做出各种各样的行动咯！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_sub_041_synchro_19",
      "hash64": "86F4AC1963398DEB",
      "text": "那么战斗测试开始！\\n就以这个状态试着和宝可梦对战吧！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_sub_041_synchro_20",
      "hash64": "86FEB5196341F1BB",
      "text": "唔唔～嗯！\\n你的同步性已经登峰造极了！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_sub_041_synchro_21",
      "hash64": "86FEB4196341F008",
      "text": "既然你是这么棒的人才，\\n那我也能把这个厉害的东西交给你了。[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_sub_041_synchro_22",
      "hash64": "86FEB7196341F521",
      "text": "因为还是试制品，所以外观上\\n还有点……那个……[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s2_sub_041_synchro_23",
      "hash64": "86FEB6196341F36E",
      "text": "使用这个，随时随地都能同步！！\\n去和各种宝可梦试试看吧！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s2_sub_041_synchro_24",
      "hash64": "86FEB9196341F887",
      "text": "实验中断了……\\n等你想同步时再来找我吧。\\r\\n是不是对脑部的负担太重了啊……[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s2_sub_041_synchro_25",
      "hash64": "86FEB8196341F6D4",
      "text": "你平时在用同步器吗？\\c\\n在机器上按Ｌ键的同时\\n按Ｒ键就能同步啦！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004E"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s2_sub_041_synchro_26",
      "hash64": "86FEBB196341FBED",
      "text": "谢谢你总是帮我同步！\\n从你那边传来的数据非常有用！\\r\\n我就送你ＢＰ当做谢礼吧！[VAR 0x0114(004E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
