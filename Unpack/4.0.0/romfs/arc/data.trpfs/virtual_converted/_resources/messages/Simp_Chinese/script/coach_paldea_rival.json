          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_paldea_rival_first_01",
      "hash64": "A531A4C1857B4665",
      "text": "蓝莓学园！\\n好厉害啊～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_paldea_rival_sp01_00",
      "hash64": "38E7FF6224AD0CEA",
      "text": "这蓝莓学园，\\n和学院完全不一样！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_paldea_rival_sp01_01",
      "hash64": "38E8006224AD0E9D",
      "text": "我去参观了一下生态巨蛋，\\n真不敢相信那是在海里的！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_paldea_rival_sp01_02",
      "hash64": "38E7FD6224AD0984",
      "text": "而根据学园的方针，\\n宝可梦对战似乎也很被重视。\\r\\n也就是说……想对战多少场都行！？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_paldea_rival_sp01_select_01",
      "hash64": "3C8568E6B4C9FE6C",
      "text": "太好了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_paldea_rival_sp01_select_02",
      "hash64": "3C856BE6B4CA0385",
      "text": "要适可而止哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_paldea_rival_sp01_03",
      "hash64": "38E7FE6224AD0B37",
      "text": "嗯！等做完要做的事，\\n我一定要跟这里的人逐个对战！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea_rival_sp01_03b",
      "hash64": "5F4095C4520A416F",
      "text": "对不起，你说得对！\\n我还要跟[VAR 0x0100(0000)]你对战，\\r\\n所以得留下余力才行，对吧？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_paldea_rival_sp01_04",
      "hash64": "38E7FB6224AD061E",
      "text": "[VAR 0x0100(0000)]！\\n谢谢你把我叫来！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_paldea_rival_sp02_00",
      "hash64": "DFB34148DD5BE9DD",
      "text": "我去生态巨蛋逛了一下，\\n发现那里有很多没见过的宝可梦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_paldea_rival_sp02_01",
      "hash64": "DFB34048DD5BE82A",
      "text": "就跟在北上那时一样，\\n观察不认识的宝可梦\\r\\n在大自然中生活，真的很有趣～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_paldea_rival_sp02_02",
      "hash64": "DFB33F48DD5BE677",
      "text": "和在教科书上看的感觉\\n完全不一样！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_paldea_rival_sp02_select_01",
      "hash64": "F1D997FD29AB7FE9",
      "text": "感觉很真实！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_paldea_rival_sp02_select_02",
      "hash64": "F1D994FD29AB7AD0",
      "text": "感觉很新鲜！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_paldea_rival_sp02_03",
      "hash64": "DFB33E48DD5BE4C4",
      "text": "没错没错！就是那感觉！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_paldea_rival_sp02_04",
      "hash64": "DFB33D48DD5BE311",
      "text": "话说这让我想起来帕底亚的宝可梦\\n一开始也让我觉得很新鲜！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_paldea_rival_sp02_05",
      "hash64": "DFB33C48DD5BE15E",
      "text": "我呀，是在７岁时\\n搬到帕底亚的。[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_paldea_rival_sp02_06",
      "hash64": "DFB33B48DD5BDFAB",
      "text": "当时还没接触宝可梦对战，\\n我都把那种感觉给忘了～[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_paldea_rival_sp02_07",
      "hash64": "DFB33A48DD5BDDF8",
      "text": "还真的是勿忘初心啊！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_paldea_rival_sp03_00",
      "hash64": "3618EB5078C573EC",
      "text": "嘿，[VAR 0x0100(0000)]！\\n你知道什么是蓝莓联盟吗？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_paldea_rival_sp03_select_01",
      "hash64": "6EEFD91B8165C766",
      "text": "知道哦！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "coach_paldea_rival_sp03_select_02",
      "hash64": "6EEFD81B8165C5B3",
      "text": "你在说什么……？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "coach_paldea_rival_sp03_01",
      "hash64": "3618EC5078C5759F",
      "text": "你果然知道！\\n为什么没有马上告诉我呀～！？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_paldea_rival_sp03_01b",
      "hash64": "B1CF89BD37877CE7",
      "text": "你是瞒不了我的！\\n我已经查得一清二楚了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_paldea_rival_sp03_02",
      "hash64": "3618ED5078C57752",
      "text": "而且大家还说\\n蓝莓联盟的冠军是[VAR 0x0100(0000)]你！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_paldea_rival_sp03_select_03",
      "hash64": "6EEFD71B8165C400",
      "text": "我的确是！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_paldea_rival_sp03_select_04",
      "hash64": "6EEFDE1B8165CFE5",
      "text": "你在说什么……？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_paldea_rival_sp03_03",
      "hash64": "3618EE5078C57905",
      "text": "我就说嘛！你果然是冠军！\\n这些事你要快点告诉我呀～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_paldea_rival_sp03_03b",
      "hash64": "B1D659BD378D4A05",
      "text": "你是瞒不过去的！\\n要是你不承认，我还有证人哦～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_paldea_rival_sp03_04",
      "hash64": "3618E75078C56D20",
      "text": "虽然我很想马上就跟\\n蓝莓联盟的冠军对战……[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_paldea_rival_sp03_05",
      "hash64": "3618E85078C56ED3",
      "text": "但劲敌在各种地方大显身手，\\n这一点更～让我高兴～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_paldea_rival_sp03_06",
      "hash64": "3618E95078C57086",
      "text": "嗯～所以……\\n以后也请你多多指教哦！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_paldea_rival_trade_01_00",
      "hash64": "54F628899E5038A6",
      "text": "……感觉说着说着就正经起来了！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_paldea_rival_trade_01_01",
      "hash64": "54F629899E503A59",
      "text": "话说我们虽然\\n对战过很多次，\\r\\n但还没试过进行交换呢！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_paldea_rival_trade_01_02",
      "hash64": "54F626899E503540",
      "text": "要不就趁这个机会\\n来进行宝可梦交换吧！？[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_paldea_rival_trade_01_03",
      "hash64": "54F627899E5036F3",
      "text": "太好了！真让人高兴！\\n我就用肯泰罗来跟你换吧～！\\r\\n[VAR 0x0100(0000)]，你会选哪个孩子呢？[VAR 0x0114(0004)]",
