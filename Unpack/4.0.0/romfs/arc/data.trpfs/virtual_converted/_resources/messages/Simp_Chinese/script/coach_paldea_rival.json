    },
    {
      "ordinal": 58,
      "label": "coach_paldea_rival_randomtalk_01",
      "hash64": "61B1A9DF47B07156",
      "text": "虽然发生了不少事，\\n但在北上乡真的过得很快乐！\\r\\n好想再和大家一起去旅行啊～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
