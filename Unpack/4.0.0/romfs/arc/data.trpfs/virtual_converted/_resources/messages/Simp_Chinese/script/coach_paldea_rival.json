    {
      "ordinal": 0,
      "label": "coach_paldea_rival_first_00",
      "hash64": "A531A3C1857B44B2",
      "text": "锵锵锵磅～！！\\n[VAR 0x0100(0000)]！我来咯～！[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
