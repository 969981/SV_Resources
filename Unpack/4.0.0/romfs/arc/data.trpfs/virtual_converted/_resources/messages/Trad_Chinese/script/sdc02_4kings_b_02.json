      "hash64": "CCD57CCEDD8CD3DD",
      "text": "呼嚕呼嚕。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
