          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_4kings_b_02_nerine_01",
      "hash64": "044D89FE8780F5A4",
      "text": "四天王挑戰\\n從這個地方開始。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
