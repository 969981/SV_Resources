        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_4kings_b_02_nerine_02",
      "hash64": "044D8CFE8780FABD",
      "text": "納莉我構思的挑戰是\\n……[VAR 0xFF00(0006)]飛翔計時賽[VAR 0xFF00(0000)]。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
