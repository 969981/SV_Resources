      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_4kings_b_02_nerine_25",
      "hash64": "0446F9FE877B9546",
      "text": "啊嘎嘶，\\n請吃這個。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
