          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc02_4kings_b_02_nerine_09",
      "hash64": "044D81FE8780E80C",
      "text": "[VAR 0x1100(00FF,0101)]你妳完美地遵守了時間，\\n是一趟讓人看了舒暢的飛行。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
