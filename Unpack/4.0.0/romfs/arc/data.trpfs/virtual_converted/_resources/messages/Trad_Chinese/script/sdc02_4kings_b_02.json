    {
      "ordinal": 1,
      "label": "sdc02_4kings_b_02_nerine_21",
      "hash64": "0446FDFE877B9C12",
      "text": "納莉我原本反對，\\n但學園認可的事，就是規則。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
