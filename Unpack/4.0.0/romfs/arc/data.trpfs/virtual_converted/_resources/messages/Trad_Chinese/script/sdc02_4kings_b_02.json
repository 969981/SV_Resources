      "hash64": "CCD579CEDD8CCEC4",
      "text": "啊嘎嘶。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc02_4kings_b_02_nerine_24",
      "hash64": "0446FAFE877B96F9",
      "text": "……太好了，看來是隻\\n付出努力就能飛的寶可夢。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
