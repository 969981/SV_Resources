      "label": "sdc02_4kings_b_02_nerine_14",
      "hash64": "044A88FE877EBE1A",
      "text": "但是不知為何，\\n納莉我……開始煩惱了。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
