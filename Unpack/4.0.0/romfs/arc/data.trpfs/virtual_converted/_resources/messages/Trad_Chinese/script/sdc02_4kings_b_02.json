      "hash64": "044A83FE877EB59B",
      "text": "[VAR 0x1100(00FF,0101)]你妳又挑戰失敗了……[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
