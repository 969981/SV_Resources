      "ordinal": 14,
      "label": "sdc02_4kings_b_02_nerine_23",
      "hash64": "0446FBFE877B98AC",
      "text": "請派出同行的坐騎寶可夢。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
