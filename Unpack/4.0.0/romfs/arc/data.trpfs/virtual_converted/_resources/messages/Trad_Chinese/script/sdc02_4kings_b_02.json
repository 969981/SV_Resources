    {
      "ordinal": 13,
      "label": "sdc02_4kings_b_02_nerine_08",
      "hash64": "044D82FE8780E9BF",
      "text": "了解。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
