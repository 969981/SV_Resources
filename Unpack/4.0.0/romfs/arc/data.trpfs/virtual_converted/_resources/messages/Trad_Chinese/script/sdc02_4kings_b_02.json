      "hash64": "044A82FE877EB3E8",
      "text": "若希望重新挑戰，\\n請再次來訪。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
