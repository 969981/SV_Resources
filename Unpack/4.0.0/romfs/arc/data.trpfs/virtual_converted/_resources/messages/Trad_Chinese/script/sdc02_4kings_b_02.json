        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc02_4kings_b_02_nerine_10",
      "hash64": "044A84FE877EB74E",
      "text": "因此，在此宣布[VAR 0x1100(00FF,0101)]你妳的四天王挑戰及格。\\n嗯，恭喜[VAR 0x1100(00FF,0101)]你妳。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
