      "hash64": "CCD57BCEDD8CD22A",
      "text": "啊嗄～嘶！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "sdc02_4kings_b_02_system_01",
      "hash64": "4DB9FEED184A976C",
      "text": "故勒頓\\n充滿了力量！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "sdc02_4kings_b_02_system_02",
      "hash64": "4DBA01ED184A9C85",
      "text": "密勒頓\\n充滿了力量！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sdc02_4kings_b_02_nerine_26",
      "hash64": "0446F8FE877B9393",
      "text": "這是自然生長在巨蛋中的\\n神奇葉子……[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
