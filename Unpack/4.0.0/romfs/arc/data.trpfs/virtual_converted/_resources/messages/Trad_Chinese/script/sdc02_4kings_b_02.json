          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0048"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_4kings_b_02_nerine_04",
      "hash64": "044D86FE8780F08B",
      "text": "在限制時間內抵達終點，\\n就算及格。[VAR 0x0114(0048)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
