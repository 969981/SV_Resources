            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_teacher_health_battleend_win_00_02",
      "hash64": "EE551166C4DFD06E",
      "text": "既然你战胜了我，\\n那我就教你个上相的姿势吧。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "coach_teacher_health_battleend_win_00_03",
      "hash64": "EE551266C4DFD221",
      "text": "虽然我觉得这个姿势\\n勉强还算不上土……\\r\\n但用了以后，后果自负哦～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
