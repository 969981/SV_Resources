    },
    {
      "ordinal": 39,
      "label": "coach_teacher_health_trade_02_02",
      "hash64": "E8A973A0469E3000",
      "text": "无法使用稀有宝可梦\\n进行交换。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
