      ]
    },
    {
      "ordinal": 42,
      "label": "coach_teacher_health_trade_03_01",
      "hash64": "13948A94FD927944",
      "text": "咦～你是认真的？\\n你拒绝我，可是要吃亏的哦～！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
