    },
    {
      "ordinal": 43,
      "label": "coach_teacher_health_trade_04_00",
      "hash64": "E1EF796B445969AC",
      "text": "你想和我交换宝可梦，\\n来拉近彼此的距离了吗～？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
