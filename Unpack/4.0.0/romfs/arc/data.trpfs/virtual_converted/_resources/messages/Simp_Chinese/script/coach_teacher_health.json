    {
      "ordinal": 54,
      "label": "coach_teacher_health_battleend_win_01_01",
      "hash64": "C09B046062042126",
      "text": "太拼命可是会受伤的，\\n不要太勉强自己哦～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
