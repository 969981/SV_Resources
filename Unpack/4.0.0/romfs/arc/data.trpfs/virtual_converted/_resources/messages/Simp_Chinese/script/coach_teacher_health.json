          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_teacher_health_randomtalk_00",
      "hash64": "D5F669A548795B9A",
      "text": "你用过\\n放在巨蛋的回复机吗？\\c\\n可以自己操作来回复哦～\\n真令我感到怀念啊～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_teacher_health_randomtalk_01",
      "hash64": "D5F66AA548795D4D",
      "text": "这个学园不是没有医务室吗？\\c\\n那大家想偷懒的时候\\n都去哪里啊？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_teacher_health_randomtalk_02",
      "hash64": "D5F667A548795834",
      "text": "我备课备得\\n相～当地辛苦啊……\\c\\n学院的老师们\\n都驾轻就熟，好厉害啊～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 59,
      "label": "coach_teacher_health_randomtalk_03",
      "hash64": "D5F668A5487959E7",
      "text": "你的[VAR 0x0101(0001)]精力太过充沛，\\n甚至让我感到头痛！\\r\\n真是和某人一模一样。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
