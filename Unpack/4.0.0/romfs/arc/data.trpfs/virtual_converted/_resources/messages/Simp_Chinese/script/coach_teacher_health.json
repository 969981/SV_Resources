    {
      "ordinal": 48,
      "label": "coach_teacher_health_battleend_win_00_00",
      "hash64": "EE550F66C4DFCD08",
      "text": "小孩子总～是全力以赴，\\n真是不得了啊……[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
