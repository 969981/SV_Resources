    {
      "ordinal": 38,
      "label": "coach_teacher_health_trade_02_01",
      "hash64": "E8A976A0469E3519",
      "text": "无法使用初训家不是自己的\\n宝可梦进行交换。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
