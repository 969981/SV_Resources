          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_teacher_health_first_01",
      "hash64": "DB9760C44104B9DC",
      "text": "这里就是新的\\n米莫莎的医务室吗？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_teacher_health_sp01_00",
      "hash64": "359B4BB7C4E55061",
      "text": "啊，我就知道\\n是你叫我来的～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_teacher_health_sp01_01",
      "hash64": "359B4AB7C4E54EAE",
      "text": "突然被叫来出差，\\n真是让我超～惊讶。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_teacher_health_sp01_02",
      "hash64": "359B49B7C4E54CFB",
      "text": "而且我是在这边被安排教第一堂课，\\n竟然抢在学院前面了呢～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_teacher_health_sp01_select_01",
      "hash64": "A49B12D57D51AF3D",
      "text": "加油！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "coach_teacher_health_sp01_select_02",
      "hash64": "A49B0FD57D51AA24",
      "text": "没问题的",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_teacher_health_sp01_03",
      "hash64": "359B48B7C4E54B48",
      "text": "瞧你这事不关己的态度……[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_teacher_health_sp01_03b",
      "hash64": "FC27BA43919EB85E",
      "text": "你那份自信是从哪来的呀！？\\n需要自信的人是我啊……[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_teacher_health_sp01_04",
      "hash64": "359B4FB7C4E5572D",
      "text": "不过，\\n难得你给我这个机会……[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_teacher_health_sp01_05",
      "hash64": "359B4EB7C4E5557A",
      "text": "米莫莎的医务室，出差版！\\n就让我大显身手吧！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_teacher_health_sp02_00",
      "hash64": "8ED009D10C36736E",
      "text": "啊～！[VAR 0x0100(0000)]！\\n你听我说呀～！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_teacher_health_sp02_01",
      "hash64": "8ED00AD10C367521",
      "text": "我把我的第一堂课给搞砸了……[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_teacher_health_sp02_02",
      "hash64": "8ED007D10C367008",
      "text": "这堂课本身啊，\\n上得还是很顺利的哦！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_teacher_health_sp02_03",
      "hash64": "8ED008D10C3671BB",
      "text": "但是我弄错了教室，\\n跑到另一个班教了一堂课～！！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_teacher_health_sp02_select_01",
      "hash64": "BFCE805A3DD52AE0",
      "text": "那可真惨",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_teacher_health_sp02_select_02",
      "hash64": "BFCE835A3DD52FF9",
      "text": "这种事难免的！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "coach_teacher_health_sp02_04",
      "hash64": "8ED00DD10C367A3A",
      "text": "走进正在自习的班里，\\n然后擅自上起了健康教育课。\\r\\n我变成这样的可疑人物了～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_teacher_health_sp02_04b",
      "hash64": "E201D237C091E388",
      "text": "不……这不行吧？\\n你安慰我，我很开心。\\r\\n但这种事即使在学院也说不过去吧？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_teacher_health_sp02_05",
      "hash64": "8ED00ED10C367BED",
      "text": "啊～这事不提了，不提了！\\n我一想起来就觉得丢脸！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_teacher_health_sp02_06",
      "hash64": "8ED00BD10C3676D4",
      "text": "要忘记讨厌的事，\\n吃一堑长一智！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_teacher_health_sp03_00",
      "hash64": "386A3FC970CCB2FF",
      "text": "喂！[VAR 0x0100(0000)]！\\n你听我说～！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_teacher_health_sp03_01",
      "hash64": "386A3EC970CCB14C",
      "text": "我之前不是在其他班里\\n上了一堂课吗？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_teacher_health_sp03_02",
      "hash64": "386A41C970CCB665",
      "text": "结果那班里有几个学生\\n来向我提问了！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_teacher_health_sp03_03",
      "hash64": "386A40C970CCB4B2",
      "text": "对我来说，弄错班级\\n是我想要忘记的黑历史。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_teacher_health_sp03_04",
      "hash64": "386A3BC970CCAC33",
      "text": "但是对于那些孩子来说，\\n并不是毫无意义的。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_teacher_health_sp03_05",
      "hash64": "386A3AC970CCAA80",
      "text": "我感觉……\\n开心得不得了～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_teacher_health_sp03_select_01",
      "hash64": "4D1BAAAD33FA2C1B",
      "text": "太好了！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_teacher_health_sp03_select_02",
      "hash64": "4D1BABAD33FA2DCE",
      "text": "真不得了啊！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_teacher_health_sp03_06",
      "hash64": "386A3DC970CCAF99",
      "text": "对吧～确实很好！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_teacher_health_sp03_07",
      "hash64": "386A3CC970CCADE6",
      "text": "当老师果然很开心呀。\\n当然有时也会很辛苦就是了。[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_teacher_health_sp03_08",
      "hash64": "386A47C970CCC097",
      "text": "幸亏我没有放弃梦想。\\n[VAR 0x0100(0000)]……谢谢你！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "coach_teacher_health_trade_01_00",
      "hash64": "8F74B786FF4D1059",
      "text": "对～了！\\n你还有时间吗～？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "coach_teacher_health_trade_01_01",
      "hash64": "8F74B686FF4D0EA6",
      "text": "因为你总是很照顾我……[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_teacher_health_trade_01_02",
      "hash64": "8F74B586FF4D0CF3",
      "text": "所以我们就来交换宝可梦，\\n拉近彼此的距离吧～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "coach_teacher_health_trade_01_03",
      "hash64": "8F74B486FF4D0B40",
      "text": "OK～\\n我会选好坏星，\\r\\n你要选哪只宝可梦呢？[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "coach_teacher_health_trade_01_04",
      "hash64": "8F74BB86FF4D1725",
      "text": "[VAR 0x0101(0001)]啊，不错嘛。\\n超～有你的风格。\\c\\n既然是我来负责照料，\\n那就一定会让它健康茁壮地成长！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0101",
