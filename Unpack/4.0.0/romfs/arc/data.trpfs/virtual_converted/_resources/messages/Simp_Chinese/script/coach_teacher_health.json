            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "coach_teacher_health_battleend_win_00_01",
      "hash64": "EE551066C4DFCEBB",
      "text": "尤其是你，也太厉害了，\\n稍～微手下留情一点嘛！[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
