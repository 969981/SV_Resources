        }
      ]
    },
    {
      "ordinal": 52,
      "label": "coach_teacher_health_reward_00",
      "hash64": "E4897947145B5CDC",
      "text": "[VAR 0x0100(0000)]从米莫莎老师那里\\n学会了[VAR 0xFF00(0008)]额头比耶动作[VAR 0xFF00(0000)]！",
