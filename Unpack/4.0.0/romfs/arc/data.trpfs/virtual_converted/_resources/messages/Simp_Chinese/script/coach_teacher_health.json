    },
    {
      "ordinal": 55,
      "label": "coach_teacher_health_battleend_lose_00_00",
      "hash64": "590108A84AAA015B",
      "text": "咦？你终～于\\n学会手下留情了吗？\\c\\n你或许也稍微\\n长大一点了呢～[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
