          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0280_bbteacher_01",
      "hash64": "4E67221DF8A82D5C",
      "text": "Some student pairs haven’t finished the\\norienteering assignment yet.\\c\\nIn the meantime, why not do some exploring?\\nEnjoy Kitakami to your heart’s content![VAR 0x0114(0042)]",
