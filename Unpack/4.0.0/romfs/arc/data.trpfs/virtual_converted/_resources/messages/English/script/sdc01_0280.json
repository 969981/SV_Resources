        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0280_student2_01",
      "hash64": "0752CB677B1ADDCF",
      "text": "The caretaker showed us some really cool masks\\nyesterday!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc01_0280_student3_01",
      "hash64": "31D0DF5C31B2501A",
      "text": "You’re already done with the assignment?!\\nWow, that was fast!\\c\\nThe girl I’m paired with is taking it slow for me—\\nshe’s making sure I don’t overexert myself.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
