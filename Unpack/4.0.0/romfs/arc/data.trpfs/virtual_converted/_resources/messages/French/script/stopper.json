    {
      "ordinal": 17,
      "label": "stopper_common_1300_01",
      "hash64": "BA179E5583835271",
      "text": "La porte de l’ascenseur est bien fermée.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "stopper_common_1180_01",
      "hash64": "59D8EDE234F9E96B",
      "text": "Essayez d’utiliser le panneau du bas pour ouvrir\\nla porte du Laboratoire Zéro.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "stopper_common_0130_01",
      "hash64": "D762C5524C148B7D",
      "text": "Vous devriez peut-être aider ce Pokémon\\nà bout de forces...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "stopper_gym_stopper_01",
      "hash64": "3C471CB7DEB9F172",
      "text": "L’examen n’est pas encore terminé. Mieux vaut\\nne pas entrer dans l’Arène pour le moment.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
