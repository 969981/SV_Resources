  "entries": [
    {
      "ordinal": 0,
      "label": "stopper_general_01",
      "hash64": "CB04017349BE696B",
      "text": "Il est encore trop tôt pour aller par là.\\nRevenez plus tard !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "stopper_general_02",
      "hash64": "CB04027349BE6B1E",
      "text": "Vous devriez explorer l’académie !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "stopper_common_0030_01",
      "hash64": "C463F20AE2942618",
      "text": "Vous n’êtes pas encore prêt[VAR 0x1100(00FF,0100)]e pour aller à l’école.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "stopper_common_0060_01",
      "hash64": "70939D9739950D67",
      "text": "Vous devriez vous rendre dans la maison voisine\\navec ces trois Pokémon.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "stopper_common_0070_01",
      "hash64": "818C7E69674F1B44",
      "text": "Attends, [VAR 0x0100(0000)] !\\nFaut que tu choisisses un Pokémon ![VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "stopper_common_0088_01",
      "hash64": "ECCF9E54E76ADA81",
      "text": "Il me semble que mademoiselle Menzi\\nvous attend à la plage.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "stopper_common_0095_01",
      "hash64": "ADEDF249B490056F",
      "text": "Vous n’avez pas encore choisi de Pokémon. Allez\\nvoir le proviseur pour lui indiquer votre choix.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "stopper_common_0170_01",
      "hash64": "1AA738F3C7B66831",
      "text": "Démo, démo ! Démooo !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "stopper_common_0170_02",
      "hash64": "1AA735F3C7B66318",
      "text": "À en juger par les aboiements de ces Démolosse,\\nvous feriez mieux de ne pas essayer d’entrer.",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "stopper_common_0170_03",
      "hash64": "1AA736F3C7B664CB",
      "text": "Ça a l’air dangereux, par là.\\nMieux vaut ne pas s’approcher.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "stopper_common_0220_01",
      "hash64": "E0A8E5E3699496F9",
      "text": "Menzi vous attend !\\nVous devriez vous rendre à l’académie !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "stopper_legend_0110_01",
      "hash64": "B4EB790148952C4F",
      "text": "Tiens ? La porte est fermée à clé !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "stopper_dan_ajito_00",
      "hash64": "98CD61823F2547F1",
      "text": "*bzzzt*\\n*crac* *crac*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "stopper_dan_ajito_01",
      "hash64": "98CD60823F25463E",
      "text": "Hé, t’as vraiment cru que tu pouvais taper\\nl’incruste dans notre repaire comme ça ?[VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
