            "002F"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "stopper_dan_ajito_02",
      "hash64": "98CD5F823F25448B",
      "text": "Si tu veux rentrer, va falloir sonner le gong\\nà l’entrée et essayer de nous battre ![VAR 0x0114(002F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
