          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_head_d_03",
      "hash64": "44C3241A7E779115",
      "text": "Sachez d’ailleurs qu’elle éprouve pour vous\\nune grande gratitude.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_head_d_04",
      "hash64": "44C31D1A7E778530",
      "text": "Loin de moi l’idée de vous forcer la main, mais\\nj’aurais toutefois un service à vous demander...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_head_d_05",
      "hash64": "44C31E1A7E7786E3",
      "text": "Accepteriez-vous de vous lier d’amitié avec\\nmademoiselle Pania ?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
