      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_head_d_select_01",
      "hash64": "CF8A472FB375DBB6",
      "text": "Bien sûr !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_head_d_select_02",
      "hash64": "CF8A462FB375DA03",
      "text": "On est déjà ami[VAR 0x1100(00FF,0100)]es !",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
