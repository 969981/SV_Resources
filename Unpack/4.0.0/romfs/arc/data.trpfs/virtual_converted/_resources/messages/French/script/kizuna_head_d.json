        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_head_d_02",
      "hash64": "44C3231A7E778F62",
      "text": "Je suis soulagé de savoir qu’un avenir prometteur\\nse dessine pour mademoiselle Pania.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
