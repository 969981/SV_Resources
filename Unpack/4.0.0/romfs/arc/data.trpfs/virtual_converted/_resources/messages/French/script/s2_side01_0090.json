    },
    {
      "ordinal": 12,
      "label": "s2_side01_0080_friend_06",
      "hash64": "E9A59BD99AFB2C7E",
      "text": "Mais en vrai, c’est bizarre... Si elle était dans\\nle centre, on devrait entendre sa sonnerie, non ?[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
