        }
      ]
    },
    {
      "ordinal": 31,
      "label": "gym_denki_040_denki_11",
      "hash64": "CA0CA98CCE9DC886",
      "text": "체육관 배지를 증정하겠습니다~![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
