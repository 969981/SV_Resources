    },
    {
      "ordinal": 11,
      "label": "gym_denki_040_denki_03",
      "hash64": "CA09278CCE9AB5C9",
      "text": "자~ 그러면 그러면 [VAR 0x0100(0000)]~?\\n오늘의 각오는~ 모야모야~?[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
