          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "gym_denki_040_receptionist_01",
      "hash64": "B007F4FD752B232F",
      "text": "일렉트리컬★스트리머...\\n체육관 관장 모야모에게 도전하시겠습니까?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_denki_040_receptionist_02",
      "hash64": "B007F5FD752B24E2",
      "text": "그럼, 배틀코트로 안내하겠습니다.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "gym_denki_040_receptionist_03",
      "hash64": "B007F6FD752B2695",
      "text": "준비가 되시면\\n제게 말을 걸어 주세요.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_denki_040_denki_entry_01",
      "hash64": "1A3546A783219EF6",
      "text": "여러분~!\\n준비됐나요~?[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_denki_040_denki_01",
      "hash64": "CA09258CCE9AB263",
      "text": "당신의 눈길을 일렉트릭네트로 뾰로롱!\\n모야모야~? 모야모예용~!\\r\\n헬로봉주르니하오안녕~![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_denki_040_comment_00",
      "hash64": "AD2818F84BC32A7E",
      "text": "헬로봉주르니하오안녕~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_denki_040_denki_15",
      "hash64": "CA0CAD8CCE9DCF52",
