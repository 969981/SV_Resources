    {
      "ordinal": 1,
      "label": "gym_denki_040_receptionist_00",
      "hash64": "B007F3FD752B217C",
      "text": "[VAR 0x0100(0000)] 님\\n누룩스체육관에 오신 것을 환영합니다!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
