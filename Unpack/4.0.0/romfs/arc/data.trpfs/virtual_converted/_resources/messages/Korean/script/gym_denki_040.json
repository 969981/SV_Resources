      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "gym_denki_040_denki_10",
      "hash64": "CA0CAA8CCE9DCA39",
      "text": "...자~ 이렇게 해서!\\n인기 만점인 모야모 님을 이긴\\r\\n[VAR 0x0100(0000)]에게~[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
