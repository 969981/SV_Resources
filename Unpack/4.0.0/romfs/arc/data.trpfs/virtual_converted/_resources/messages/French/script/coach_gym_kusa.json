    },
    {
      "ordinal": 53,
      "label": "coach_gym_kusa_battleend_win_01_01",
      "hash64": "AE478201CDB0DC5F",
      "text": "L’inspiration m’est venue et ne me quitte plus...\\nLaisse-moi profiter de cet état de grâce ![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
