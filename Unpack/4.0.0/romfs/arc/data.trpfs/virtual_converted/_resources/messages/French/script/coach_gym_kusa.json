    {
      "ordinal": 1,
      "label": "coach_gym_kusa_first_01",
      "hash64": "3F634500417BF2C7",
      "text": "Et le design de cette pièce...\\nQuel avant-gardisme ![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
