      ]
    },
    {
      "ordinal": 41,
      "label": "coach_gym_kusa_trade_03_01",
      "hash64": "26EA44CD4C95C921",
      "text": "Tu as raison, ce n’est pas une décision à prendre\\nà la légère. Après tout, la vie de nos Pokémon\\r\\nen sera transformée du tout au tout ![VAR 0x0114(0017)]",
