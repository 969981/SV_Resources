    {
      "ordinal": 50,
      "label": "coach_gym_kusa_battleend_win_00_03",
      "hash64": "57E1D3FA32474B84",
      "text": "Il m’a fallu six mois pour arriver à ce résultat,\\nmais je pense qu’il est satisfaisant ![VAR 0x0114(0017)]",
