    {
      "ordinal": 54,
      "label": "coach_gym_kusa_battleend_lose_00_00",
      "hash64": "A0955EEA7006A9B0",
      "text": "Cette fois, c’est toi qui as fini en engrais !\\c\\nNe t’inquiète pas, la défaite devient parfois\\nle terreau de notre art ![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
