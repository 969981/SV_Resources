          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_kusa_sp03_07b",
      "hash64": "9F486BEEDDC563F7",
      "text": "Quoi ? Ne saisis-tu donc pas l’intensité\\nd’une telle expérience ? Aurais-tu perdu\\r\\nle fil de la discussion, peut-être ?[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_kusa_sp03_04",
      "hash64": "11CD17CD595FCC82",
      "text": "Toujours est-il que, ce jour-là, pas la moindre\\npeinture n’était exposée ! On aurait presque\\r\\npu croire que ce n’était pas... un atelier.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
