    {
      "ordinal": 48,
      "label": "coach_gym_kusa_battleend_win_00_01",
      "hash64": "57E1D5FA32474EEA",
      "text": "Créer avec toi est une expérience incroyable !\\c\\nRien de tel pour développer une nouvelle\\nsensibilité artistique ![VAR 0x0114(0017)]",
