    },
    {
      "ordinal": 38,
      "label": "coach_gym_kusa_trade_02_02",
      "hash64": "D0847BC5B12C0A65",
      "text": "Vous ne pouvez pas échanger de Pokémon rares.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "coach_gym_kusa_trade_02_03",
      "hash64": "D0847AC5B12C08B2",
      "text": "Vous ne pouvez pas échanger\\nde Pokémon chromatiques.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "coach_gym_kusa_trade_03_00",
      "hash64": "26EA43CD4C95C76E",
      "text": "As-tu perdu l’esprit ?! Tu ne peux pas échanger\\nde Pokémon si tu n’en as qu’un dans ton équipe !\\c\\nReviens avec au moins deux Pokémon,\\net nous pourrons procéder à un échange ![VAR 0x0114(0017)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
