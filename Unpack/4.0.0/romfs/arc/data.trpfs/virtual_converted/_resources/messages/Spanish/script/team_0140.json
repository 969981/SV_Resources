    {
      "ordinal": 0,
      "label": "team_0140_cassiopeia_00",
      "hash64": "418BAE3474F80595",
      "text": "Se acabó, chicos...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
