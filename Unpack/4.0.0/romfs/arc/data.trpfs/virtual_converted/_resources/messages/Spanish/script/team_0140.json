          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "team_0140_cassiopeia_01",
      "hash64": "418BAD3474F803E2",
      "text": "Nuestro trabajo ha terminado, chicos.\\nSe acabó.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "team_0140_akuboss_01",
      "hash64": "91A7AE3026A4C36F",
      "text": "¿Se acabó? ¿Cómo que \"se acabó\"? No estarás\\nhablando de disolver el Team Star, ¿no?[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "team_0140_cassiopeia_02",
      "hash64": "418BAC3474F8022F",
      "text": "La Operación Star se nos ha ido de las manos.\\nLa broma ha ido demasiado lejos.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "team_0140_honooboss_01",
      "hash64": "934D2E0669D4A7EB",
      "text": "A ver, es verdad que al final se montó una buena\\nbulla cuando reunimos a todos los abusones en\\r\\nel área recreativa para darles su merecido...[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "team_0140_kakutouboss_01",
      "hash64": "D56B8A961FF81062",
      "text": "¡Pero si no tuvimos ni que pelearnos con ellos!\\n¡No hemos hecho nada malo![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "team_0140_dokuboss_01",
      "hash64": "073576795B5C61BF",
      "text": "Nos ceñimos a comunicarles nuestra intención\\nde poner fin a su tiranía si porfiaban en acosar\\r\\na sus semejantes, voto a tal.\\c\\nNo fue necesario mancillar su honor en una\\nbelicosa contienda.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 192,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "team_0140_fairyboss_01",
      "hash64": "6B377E0DEA0D2B99",
      "text": "¡Exacto! ¡No les llegamos a tocar ni un solo pelo!\\nCuando nos vieron vestidos con estas pintas, se\\r\\necharon a llorar y a pedirnos perdón de rodillas.\\c\\nNi siquiera sacaron a sus Pokémon a combatir,\\n¡solo se quedaron ahí temblando![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 151,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 233,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "team_0140_cassiopeia_03",
      "hash64": "418BAB3474F8007C",
      "text": "No le quitéis hierro al asunto, que lo que hicimos\\nsigue siendo algo muy serio.\\c\\n¿Acaso pensáis que nos iremos de rositas tras el\\nrevuelo que se montó cuando huyeron de allí?[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 176,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "team_0140_akuboss_02",
      "hash64": "91A7AF3026A4C522",
      "text": "Igual sí que nos pasamos un pelín de la raya,\\nahora que lo dices.[VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "team_0140_cassiopeia_04",
      "hash64": "418BAA3474F7FEC9",
      "text": "Tranquilos, que ya pagaré yo los platos rotos.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "team_0140_honooboss_02",
      "hash64": "934D2F0669D4A99E",
      "text": "¿Pero qué dices, colega?[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "team_0140_cassiopeia_05",
      "hash64": "418BA93474F7FD16",
      "text": "Fui yo quien tuvo la idea de fundar el Team Star.\\nSoy yo quien os ha metido en todo este lío.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "team_0140_cassiopeia_06",
      "hash64": "418BA83474F7FB63",
      "text": "Así que seré yo quien asuma la responsabilidad.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "team_0140_dokuboss_02",
      "hash64": "073577795B5C6372",
      "text": "Pero, vuesa supremidad...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "team_0140_cassiopeia_07",
      "hash64": "418BA73474F7F9B0",
      "text": "El acoso escolar es ya cosa del pasado, así que\\npodéis volver a clase sin preocuparos.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "team_0140_honooboss_03",
      "hash64": "934D300669D4AB51",
      "text": "¿Y tú qué?[VAR 0x0114(001F)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 10,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "team_0140_cassiopeia_08",
      "hash64": "418BB63474F8132D",
      "text": "Yo... me temo que no puedo volver.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "team_0140_akuboss_03",
      "hash64": "91A7B03026A4C6D5",
      "text": "¿Y qué te lo impide? Sin abusones, ya no tiene\\nsentido que no salgas de tu cuarto.[VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "team_0140_cassiopeia_09",
      "hash64": "418BB53474F8117A",
      "text": "Quiero daros las gracias, chicos. De verdad.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "team_0140_cassiopeia_10",
      "hash64": "4188283474F4EC0C",
      "text": "Gracias por haberos portado tan bien conmigo,\\naunque ni siquiera nos conozcamos en persona.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "team_0140_kakutouboss_02",
      "hash64": "D56B89961FF80EAF",
      "text": "¿Por qué me suena esto como a despedida?\\n¡No tiene gracia, supremita! ¡Déjalo ya![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "team_0140_cassiopeia_11",
      "hash64": "4188293474F4EDBF",
      "text": "Lo siento, pero el deber me llama...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "team_0140_dokuboss_03",
      "hash64": "073578795B5C6525",
      "text": "Vuesa merced... ¿a qué os referís?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "team_0140_cassiopeia_12",
      "hash64": "41882A3474F4EF72",
      "text": "...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "team_0140_fairyboss_02",
      "hash64": "6B377B0DEA0D2680",
      "text": "¡Suprema! ¡¿Qué pasa?! ¡Puedes contárnoslo![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "team_0140_cassiopeia_13",
      "hash64": "41882B3474F4F125",
      "text": "Hasta siempre, chicos. Gracias por todo.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    }
  ]
