          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_dragon_c_02",
      "hash64": "FD55985EBA6B173A",
      "text": "這不是[VAR 0x0100(0000)]同學嗎？[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_dragon_c_03",
      "hash64": "FD55995EBA6B18ED",
      "text": "剛剛小生在想事情，\\n結果沒注意到[VAR 0x1100(00FF,0101)]你妳。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_dragon_c_04",
      "hash64": "FD55925EBA6B0D08",
      "text": "先前在操場的時候，\\n真是失禮了是也……[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_dragon_c_select_01",
      "hash64": "919C6BF04B41CC5E",
      "text": "我一點都不在意",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "kizuna_dragon_c_select_02",
      "hash64": "919C6AF04B41CAAB",
      "text": "是什麼事來著？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_dragon_c_05a",
      "hash64": "E37843F6C3EA3C6E",
      "text": "哈哈……[VAR 0x1100(00FF,0101)]你妳的應對真是成熟。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_dragon_c_05b",
      "hash64": "E37842F6C3EA3ABB",
      "text": "就是和[VAR 0x1100(00FF,0101)]你妳在說話的時候，\\n小生突然離開的那件事。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_dragon_c_06",
      "hash64": "FD55945EBA6B106E",
      "text": "那時來找小生的那位女性馴龍師，\\n是小生的親戚。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_dragon_c_08",
      "hash64": "FD558E5EBA6B063C",
      "text": "小生的一族，\\n是龍寶可夢的行家。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_dragon_c_09",
      "hash64": "FD558F5EBA6B07EF",
      "text": "小生從小便受到培養，\\n為的就是成為率領一族的領袖。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_dragon_c_10",
      "hash64": "FD591C5EBA6E2D5D",
      "text": "但是，過去處於反抗期的八朔少年……[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_dragon_c_11",
      "hash64": "FD591B5EBA6E2BAA",
      "text": "「我要靠音樂闖出一片天！」\\n……小生就此飛奔出了家門。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_dragon_c_12",
      "hash64": "FD591A5EBA6E29F7",
      "text": "歷經轉折，小生成了美術老師……\\n同時成為了聯盟的四天王。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_dragon_c_13",
      "hash64": "FD59195EBA6E2844",
      "text": "上次和[VAR 0x1100(00FF,0101)]你妳分開之後，\\n那位親戚告訴小生，\\r\\n要小生辭去教職，繼承領袖一職。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_dragon_c_14",
      "hash64": "FD59185EBA6E2691",
      "text": "據說現在的領袖……\\n也就是小生的父親，\\r\\n他的身體狀況似乎不太樂觀。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_dragon_c_15",
      "hash64": "FD59175EBA6E24DE",
      "text": "真是抱歉。\\n竟然向自己的學生吐苦水，\\r\\n小生身為教師真是失職了。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_dragon_c_select_03",
      "hash64": "919C69F04B41C8F8",
      "text": "沒那回事！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "kizuna_dragon_c_select_04",
      "hash64": "919C70F04B41D4DD",
      "text": "不要辭職！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "kizuna_dragon_c_16",
      "hash64": "FD59165EBA6E232B",
      "text": "[VAR 0x0100(0000)]同學……\\n[VAR 0x1100(00FF,0101)]你妳的一句話拯救了小生。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_dragon_c_17",
      "hash64": "FD59155EBA6E2178",
      "text": "真心地感謝[VAR 0x1100(00FF,0101)]你妳是也。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_dragon_c_system_01",
      "hash64": "1BAB1A2334485759",
      "text": "感受到了\\n八朔老師的信賴！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    }
  ]
