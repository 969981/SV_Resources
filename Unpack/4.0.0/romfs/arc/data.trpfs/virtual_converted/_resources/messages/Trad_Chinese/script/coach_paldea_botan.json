      "ordinal": 1,
      "label": "coach_paldea_botan_first_01",
      "hash64": "07BA7C400EAD5EE7",
      "text": "這裡就是社辦？\\n人家來踢館囉。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
