    {
      "ordinal": 2,
      "label": "coach_paldea_botan_sp01_00",
      "hash64": "0E6B0318CCBB9778",
      "text": "藍莓學園真厲害。\\n到這種地方留學真酷。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
