      "hash64": "3C250D1F2F9741A7",
      "text": "[VAR 0x0100(0000)]，[VAR 0x1100(00FF,0101)]你妳知道嗎！？\\n藍莓學園太厲害了！[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
