          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_paldea_botan_sp01_01",
      "hash64": "0E6B0418CCBB992B",
      "text": "話說這個房間……\\n有好多不認識的人，\\r\\n總覺得讓人喘不過氣……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
