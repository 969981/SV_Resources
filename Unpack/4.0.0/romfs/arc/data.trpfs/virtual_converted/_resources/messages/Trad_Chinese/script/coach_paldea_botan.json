          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_paldea_botan_sp01_03",
      "hash64": "0E6B0618CCBB9C91",
      "text": "算了，就當作是復健，\\n稍微……努力一下好了……[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "coach_paldea_botan_sp01_04",
      "hash64": "0E6B0718CCBB9E44",
      "text": "不過[VAR 0x1100(00FF,0101)]你妳別讓人家\\n在陌生的地方一個人待太久喔。[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
