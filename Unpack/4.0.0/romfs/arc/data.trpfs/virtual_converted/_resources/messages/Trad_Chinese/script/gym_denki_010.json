    },
    {
      "ordinal": 4,
      "label": "gym_denki_010_receptionist_03",
      "hash64": "D3D282EC17F4BF4C",
      "text": "想和本道館的館主奇樹對戰，\\n就必須先通過道館測驗。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_denki_010_receptionist_04",
      "hash64": "D3D281EC17F4BD99",
      "text": "釀光道館的道館測驗是\\n[VAR 0xFF00(0006)]參加奇樹的節目[VAR 0xFF00(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
