    {
      "ordinal": 2,
      "label": "gym_denki_010_receptionist_01",
      "hash64": "D3D284EC17F4C2B2",
      "text": "歡迎光臨釀光道館！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "gym_denki_010_receptionist_02",
      "hash64": "D3D283EC17F4C0FF",
      "text": "請讓我登記\\n挑戰者的名字……\\r\\n[VAR 0x1100(00FF,0101)]你妳是[VAR 0x0100(0000)]，對吧！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
