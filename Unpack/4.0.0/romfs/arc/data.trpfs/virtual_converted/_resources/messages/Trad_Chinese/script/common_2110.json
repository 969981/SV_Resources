          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_2110_friend_08",
      "hash64": "FF7D9F2F20C08F4B",
      "text": "變得更麻更辣的新口味派帕！\\n[VAR 0x1100(00FF,0101)]你妳就品嚐品嚐吧！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
