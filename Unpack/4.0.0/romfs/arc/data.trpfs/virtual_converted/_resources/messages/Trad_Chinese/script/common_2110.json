          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_2110_friend_02",
      "hash64": "FF7D992F20C08519",
      "text": "[VAR 0x0100(0000)]！\\n看到我有參賽，[VAR 0x1100(00FF,0101)]你妳是不是嚇一大跳啊！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
