          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "common_2110_friend_03b",
      "hash64": "E2EC9C14A71E9FCC",
      "text": "啥？[VAR 0x1100(00FF,0101)]你妳早知道了？\\n真不愧是我的好朋友啊……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
