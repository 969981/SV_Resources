          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_2110_friend_04",
      "hash64": "FF7D9B2F20C0887F",
      "text": "我在第零區徹底體會到了\\n自己的實力還不夠……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_2110_friend_05",
      "hash64": "FF7D9A2F20C086CC",
      "text": "所以我和獒教父牠們躲起來\\n狠狠地特訓了一番！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_2110_friend_06",
      "hash64": "FF7D9D2F20C08BE5",
      "text": "要是今後發生了什麼事，\\n到時我希望能再次和[VAR 0x1100(00FF,0101)]你妳並肩作戰。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
