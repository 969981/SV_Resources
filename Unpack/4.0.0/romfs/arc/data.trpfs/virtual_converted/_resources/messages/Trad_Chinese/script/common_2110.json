    {
      "ordinal": 2,
      "label": "common_2110_announce_03",
      "hash64": "1F70B47B0779903F",
      "text": "……２－Ｇ的派帕！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "common_2110_friend_01",
      "hash64": "FF7D962F20C08000",
      "text": "我們頭銜的差距真是\\n令人笑掉大牙派呢……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
