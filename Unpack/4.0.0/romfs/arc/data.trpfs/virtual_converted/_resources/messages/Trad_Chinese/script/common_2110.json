          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "common_2110_friend_03a",
      "hash64": "E2EC9F14A71EA4E5",
      "text": "嘿嘿！\\n我就是想看[VAR 0x1100(00FF,0101)]你妳這個反應！[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
