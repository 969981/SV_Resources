      ]
    },
    {
      "ordinal": 13,
      "label": "common_2110_mobs_01",
      "hash64": "2D42C46ACEC44DC1",
      "text": "咻～咻～！\\n博士的兒子，你打得不賴喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "common_2110_mobs_02",
      "hash64": "2D42C16ACEC448A8",
      "text": "才第一戰就好激烈啊！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "common_2110_friend_09",
      "hash64": "FF7D9E2F20C08D98",
      "text": "冠軍的力量真強啊～！\\n雖然不甘心，但是[VAR 0x1100(00FF,0101)]你妳真是讓我驕傲。[VAR 0x0114(0006)]",
      "flags": 0,
