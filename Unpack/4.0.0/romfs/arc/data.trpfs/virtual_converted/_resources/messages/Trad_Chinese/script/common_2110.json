    {
      "ordinal": 12,
      "label": "common_2110_announce_04",
      "hash64": "1F70B17B07798B26",
      "text": "第一回合，獲勝的是……\\n冠軍[VAR 0x0100(0000)]！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
