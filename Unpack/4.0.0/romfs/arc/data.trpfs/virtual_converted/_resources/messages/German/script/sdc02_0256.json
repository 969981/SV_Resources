          "kind": "control",
          "offset_units": 111,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0256_sister_05",
      "hash64": "F7D079A5533A616A",
      "text": "Das ist überraschend rücksichtsvoll von dir...\\nAber du hast wahrscheinlich recht.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0256_sister_06",
      "hash64": "F7D078A5533A5FB7",
      "text": "Ms Brianna, hier ist ein Fahrstuhl! Damit können\\nwir weiter runterfahren! Da wollten Sie hin, oder?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0256_bbteacher_01",
      "hash64": "C08F426A8DDE9E74",
      "text": "Ah, ja! Runter klingt gut![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0256_bbteacher_02",
      "hash64": "C08F456A8DDEA38D",
      "text": "Oh! Ist das der Fahrstuhl, mit dem du damals\\ndiesen rätselhaften Raum erreicht hast?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0256_select_01",
      "hash64": "79A7AA0C0CBAECBA",
      "text": "Ja!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "sdc02_0256_select_02",
      "hash64": "79A7A90C0CBAEB07",
      "text": "Äh, kann sein...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "sdc02_0256_bbteacher_03",
      "hash64": "C08F446A8DDEA1DA",
      "text": "Verstehe. Wie aufregend![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0256_bbteacher_04",
      "hash64": "C08F3F6A8DDE995B",
      "text": "Hast du plötzlich Gedächtnislücken?\\nIst das etwa ein Effekt von Zone Null?![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0256_bbteacher_05",
      "hash64": "C08F3E6A8DDE97A8",
      "text": "Na dann, nichts wie los nach unten![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
