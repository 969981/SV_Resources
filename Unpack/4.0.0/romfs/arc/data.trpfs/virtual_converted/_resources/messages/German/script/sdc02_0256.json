      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0256_sister_03",
      "hash64": "F7D073A5533A5738",
      "text": "Dir scheint’s langsam wirklich besser\\nzu gehen, hm?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
