        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0256_brother_03",
      "hash64": "19669095752A341E",
      "text": "Wo ist eigentlich Ms Brianna?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0256_sister_04",
      "hash64": "F7D07AA5533A631D",
      "text": "Die stöbert da drüben rum.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0256_brother_04",
      "hash64": "19669395752A3937",
      "text": "Sind das nicht private Fotos und Dokumente\\nvon irgendwem?\\c\\nIch halt’s nicht für richtig, darin rumzuwühlen...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
