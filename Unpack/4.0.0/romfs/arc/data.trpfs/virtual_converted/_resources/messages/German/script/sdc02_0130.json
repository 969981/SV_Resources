    {
      "ordinal": 37,
      "label": "sdc02_0130_reception_06",
      "hash64": "4DD048477392963B",
      "text": "[VAR 0x0100(0000)] kann jetzt in der Blaubeer-Liga\\nantreten.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
