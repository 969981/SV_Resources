    },
    {
      "ordinal": 35,
      "label": "sdc02_0130_reception_05",
      "hash64": "4DD04947739297EE",
      "text": "Danke für deine Geduld! Du bist jetzt offiziell\\nangemeldet.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
