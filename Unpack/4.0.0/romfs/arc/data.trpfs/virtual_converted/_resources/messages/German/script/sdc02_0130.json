      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "sdc02_0130_dragonbb_03",
      "hash64": "556F24944351BBF4",
      "text": "Ooh, da hast du uns aber aus der Patsche\\ngeholfen. Hätt ich nich’ von dir erwartet.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
