      "label": "sdc02_0130_sister_06",
      "hash64": "EFBFD54C5DEE951E",
      "text": "Hm... Irgendwie trau ich der ganzen Sache nicht.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
