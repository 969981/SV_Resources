          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "sdc02_0130_reception_10",
      "hash64": "4DCCC847738F86E4",
      "text": "Ich werde ihre Standorte auf deinem\\nSmart-Rotom registrieren.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 42,
      "label": "sdc02_0130_reception_11",
      "hash64": "4DCCC947738F8897",
      "text": "Um die Top Vier herauszufordern, brauchst du [VAR 0xFF00(0006)]BP[VAR 0xFF00(0000)].\\nDie erhältst du, indem du [VAR 0xFF00(0006)]Missionen[VAR 0xFF00(0000)] erledigst.\\c\\nSobald du alle Mitglieder der Top Vier besiegt\\nhast, kannst du gegen den Champ antreten.",
