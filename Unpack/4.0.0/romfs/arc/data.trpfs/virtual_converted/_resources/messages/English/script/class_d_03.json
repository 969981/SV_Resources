          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "class_d_03_yes_01",
      "hash64": "04411191F87DEFB2",
      "text": "Y-yes!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 4,
      "label": "class_d_03_yes_02",
      "hash64": "04411091F87DEDFF",
      "text": "O-oui!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "class_d_03_language_04",
      "hash64": "E416104E64740A20",
      "text": "Très bien! Very good![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_03_language_05",
      "hash64": "E416114E64740BD3",
      "text": "My lessons are not a one-way street! Non non!\\nI am très triste when no one speaks up!\\r\\nVery sad, that is![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_d_03_language_06",
      "hash64": "E416124E64740D86",
      "text": "In our last class, I believe I taught you all how to\\nsay “delicious” in other languages, right?[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_d_03_language_07",
      "hash64": "E416134E64740F39",
      "text": "In le cours d’aujourd’hui—today’s class—we will\\nlearn about a very special phrase that you can\\r\\nput to use when the time is juuust right![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_d_03_language_08",
      "hash64": "E4161C4E64741E84",
      "text": "Ai shiteiru! Je t’aime! Te amo! Ich liebe dich!\\nDoes anyone know what these phrases mean?[VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_d_03_select_01",
      "hash64": "0F3494160C48DAD9",
      "text": "Time to eat",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "class_d_03_select_02",
      "hash64": "0F3491160C48D5C0",
      "text": "I love you",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "class_d_03_select_03",
      "hash64": "0F3492160C48D773",
      "text": "I’m going home",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "class_d_03_language_answer_01",
      "hash64": "D58B5916D5CBBB28",
      "text": "Oh, [VAR 0x0100(0000)]!\\c\\nNon non! We can’t have you eating anyone!\\nThat’s a mauvaise réponse—a wrong answer![VAR 0x0114(0026)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "class_d_03_language_answer_02",
      "hash64": "D58B5C16D5CBC041",
      "text": "[VAR 0xBD06(0000)]Fantastique, [VAR 0x0100(0000)]! Correct!\\nYou\\r\\ndeserve\\r\\na\\r\\nmédaille\\r\\nd’or—a\\r\\ngold medal![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
