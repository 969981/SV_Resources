          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "class_d_03_language_03",
      "hash64": "E416174E64741605",
      "text": "... ... ...\\n... ... ...\\r\\nAhem. Êtes-vous prêts—are you ready?![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
