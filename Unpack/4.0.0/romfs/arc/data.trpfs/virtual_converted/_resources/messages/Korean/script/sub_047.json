    {
      "ordinal": 3,
      "label": "sub_047_picnicnpc_addrecipe_02",
      "hash64": "137D7E3A756A2C1A",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)] 새로운 마스터 레벨의\\n샌드위치를 만들 수 있게 되었다!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
