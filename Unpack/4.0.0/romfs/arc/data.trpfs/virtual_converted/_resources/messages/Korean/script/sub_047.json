            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_047_picnicnpc_01_03",
      "hash64": "BCFAFA19AC13B22B",
      "text": "기가 막히게 맛있으니까\\n꼭 한번 만들어 보렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_047_picnicnpc_01_04",
      "hash64": "BCFAFF19AC13BAAA",
      "text": "다음에 또\\n새로운 레시피가 떠오르면 가르쳐 줄게!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sub_047_picnicnpc_02_01",
      "hash64": "63C63C0064C28F1E",
      "text": "...아아, 너구나!\\n새로운 레시피가 떠올랐어!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "sub_047_picnicnpc_03_01",
      "hash64": "B9BEE807FFCF4AB3",
      "text": "...아아, 너구나!\\c\\n지금 고안하고 있는 레시피에는\\n희귀한 조미료가 필요해.\\c\\n비전 어쩌고 하는\\n다섯 종류의 스파이스야...\\c\\n한 번이라도 볼 수만 있다면\\n새로운 레시피가 떠오를 텐데...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_047_picnicnpc_03_02",
      "hash64": "B9BEE907FFCF4C66",
      "text": "비전 어쩌고는\\n다섯 종류의 스파이스야...\\c\\n한 번이라도 볼 수만 있다면\\n새로운 레시피가 떠오를 텐데...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_047_picnicnpc_03_03",
      "hash64": "B9BEEA07FFCF4E19",
      "text": "네가 가지고 있는 그, 그건!\\n비전 어쩌고 아니야!?\\r\\n으으... 아, 아아...\\r\\n머릿속에서 레시피가 떠오른다~!?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sub_047_picnicnpc_03_04",
      "hash64": "B9BEEB07FFCF4FCC",
      "text": "하아... 하아...\\n엄청난 레시피를 만들었어!\\r\\n그야말로 최고의 샌드위치야...!\\r\\n꼭 한번 만들어 보렴...!!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sub_047_picnicnpc_03_05",
      "hash64": "B9BEEC07FFCF517F",
      "text": "네 덕분에 마스터 레벨의 샌드위치를\\n모두 구현해 낼 수 있었어!\\c\\n나의 꿈을 지원해 줘서\\n정말 고마워!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sub_047_picnicnpc_03_06",
      "hash64": "B9BEED07FFCF5332",
      "text": "세상에는 아직 아무도 모르는\\n맛있는 샌드위치가 존재할 거야!\\c\\n너도 새로운 레시피가 떠오르거든\\n많은 사람들에게 가르쳐 주렴!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
