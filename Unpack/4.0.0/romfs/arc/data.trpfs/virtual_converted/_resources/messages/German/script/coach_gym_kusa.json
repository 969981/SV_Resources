          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_gym_kusa_randomtalk_00",
      "hash64": "1FDAFE1F72B4C8A3",
      "text": "Das Design des Schulgebäudes dieser Akademie\\nist wirklich atemberaubend!\\c\\nWenn ich nur wüsste, aus wessen Feder die\\nEntwürfe hierzu stammen![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_kusa_randomtalk_01",
      "hash64": "1FDAFD1F72B4C6F0",
      "text": "Weißt du, in Kunst und Kampf ist nicht alles eitel\\nSonnenschein. Man muss auch durch ein Tal der\\r\\nTränen.\\c\\nAber die Devise lautet „niemals aufgeben“.\\nDenn wer nicht kämpft, der hat schon verloren![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 107,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 200,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_gym_kusa_randomtalk_02",
      "hash64": "1FDB001F72B4CC09",
      "text": "An unserer Akademie kannst du Señor Sinius’\\nUnterricht so oft belegen, wie du magst, oder?\\c\\nDa kannst du dich wirklich glücklich schätzen,\\ndas wird dir im weiteren Leben noch sehr viel\\r\\nbringen![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 186,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 198,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_gym_kusa_randomtalk_03",
      "hash64": "1FDAFF1F72B4CA56",
      "text": "[VAR 0xBD06(0000)]Das [VAR 0x0101(0001)], das ich von dir erhalten\\nhabe,\\r\\nist der\\r\\nInbegriff der Avantgarde!\\c\\nDas schreit geradezu danach, eine Skulptur von\\nihm anzufertigen![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
