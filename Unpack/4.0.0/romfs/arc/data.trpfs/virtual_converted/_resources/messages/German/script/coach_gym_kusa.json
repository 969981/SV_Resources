            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_gym_kusa_battleend_lose_00_00",
      "hash64": "A0955EEA7006A9B0",
      "text": "Diesmal lieferst du den Nährstoff für meine\\nPokémon, doch sorge dich nicht:\\c\\nDenn aus dem bitteren Mulch der Niederlage\\ntreibt die Muse der Schönheit ihre kostbarsten\\r\\nSprösslinge![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 168,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 184,
          "count": 2,
