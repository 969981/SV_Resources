          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_kusa_sp01_01",
      "hash64": "E49EE0BA7377E08B",
      "text": "Sie kam wie gerufen, denn ich hatte gerade die\\nArbeit an meinem jüngsten Werk beendet und\\r\\nmein kreativer Geist dürstete nach einer Pause.\\c\\nSo bin ich flugs hergeeilt.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 171,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_kusa_sp01_02",
      "hash64": "E49EE1BA7377E23E",
      "text": "Jugendliche sind schon sonderbare Geschöpfe...\\c\\nEgal, wo auf der Welt man ihnen begegnet,\\nin Verhalten und Lebensweise unterscheiden sie\\r\\nsich kaum voneinander![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 164,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_kusa_sp01_03",
      "hash64": "E49EE2BA7377E3F1",
      "text": "Doch diese Tera-Kuppel!!\\c\\nGleich einer Vermählung unterschiedlicher\\nGebiete verleiht sie meinem Schaffensdrang\\r\\nneue Inspiration![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_gym_kusa_sp01_select_01",
      "hash64": "A0B376FEFB2B9812",
      "text": "Das freut mich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "coach_gym_kusa_sp01_select_02",
      "hash64": "A0B375FEFB2B965F",
      "text": "Vermählung...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_gym_kusa_sp01_05",
      "hash64": "E49EE4BA7377E757",
      "text": "Welch Glück, dass der Musenkuss, der mir das\\nHerz frohlocken lässt, auch dich freudig stimmt![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "coach_gym_kusa_sp01_05b",
      "hash64": "F1E5DDD234BDDF0F",
      "text": "Ja, wie wenn sich zwei unterschiedliche Dinge\\nvor dem Altar der schönen Künste auf artistische\\r\\nWeise das Jawort geben![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_kusa_sp01_04",
      "hash64": "E49EE3BA7377E5A4",
      "text": "Nur zu gerne würde ich auf jenes geheimnisvolle\\nObjekt steigen, das von der Kuppeldecke hängt.\\c\\nWas für ein Anblick sich mir wohl von dort oben\\nbieten würde...[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 161,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_kusa_sp02_00",
      "hash64": "BA20E9C5BCE09F87",
      "text": "Ach übrigens, [VAR 0x0100(0000)]![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_kusa_sp02_01",
      "hash64": "BA20E8C5BCE09DD4",
      "text": "In Einall gibt es einen berühmten Künstler.\\nHast du eine Ahnung, wen ich meine?[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_kusa_sp02_select_01",
      "hash64": "78872684BFFF3133",
      "text": "Aber klar doch!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 14,
      "label": "coach_gym_kusa_sp02_select_02",
      "hash64": "78872784BFFF32E6",
      "text": "Leider nicht...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_gym_kusa_sp02_05",
      "hash64": "BA20E4C5BCE09708",
      "text": "Du bist echt ein wandelndes Lexikon, wenn es\\num Kunst und Ästhetik geht![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_gym_kusa_sp02_05b",
      "hash64": "267C25FFF1A1491E",
      "text": "Verstehe. Na, dann spitz mal schön die Ohren![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_kusa_sp02_02",
      "hash64": "BA20EBC5BCE0A2ED",
      "text": "Dieser talentierte Künstler, den ich meine, kreiert\\nGemälde mit viel Pathos und Tiefgang, die stets\\r\\nKäfer-Pokémon zum Gegenstand haben.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_kusa_sp02_03",
      "hash64": "BA20EAC5BCE0A13A",
      "text": "Die Erhöhung eines Typs zum ästhetischen Ideal,\\ndie Verwandlung des Physischen ins Ätherische...\\c\\nEine verwandte Seele, die mich nicht loslässt![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 146,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_kusa_sp02_04",
      "hash64": "BA20E5C5BCE098BB",
      "text": "Vielleicht statte ich auf dem Heimweg seinem\\nAtelier in Stratos City einen Besuch ab.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_kusa_sp03_00",
      "hash64": "11CD13CD595FC5B6",
      "text": "Erinnerst du dich noch an den Künstler aus\\nStratos City, von dem ich neulich sprach?\\c\\nNun, ich hab in seinem Atelier vorbeigeschaut![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_kusa_sp03_01",
      "hash64": "11CD14CD595FC769",
      "text": "Dieser Ort ist wahrlich der Inbegriff der\\nAvantgarde, sag ich dir![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_kusa_sp03_02",
      "hash64": "11CD11CD595FC250",
      "text": "Kunstobjekte, die an Tarundels Spinnenfäden\\nerinnern, fungieren dort als Aufzüge!\\r\\nIst das zu fassen?![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_kusa_sp03_03",
      "hash64": "11CD12CD595FC403",
      "text": "Ganz in Euphorie verfallen fuhr ich auf dieser\\nVorrichtung unzählige Male auf und ab![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_kusa_sp03_05",
      "hash64": "11CD18CD595FCE35",
      "text": "Doch dann geschah es: Der Faden muss sich\\nverheddert haben und schwupp!\\r\\nHilflos wie ein Kokon baumelte ich in der Luft![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 122,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_gym_kusa_sp03_06",
      "hash64": "11CD15CD595FC91C",
      "text": "Mit einem Mal wurde mir klar, dass ich selbst Teil\\njener Fadenkunst-Installation geworden war!\\r\\nEine ästhetische Metaebene![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_kusa_sp03_select_01",
      "hash64": "EB651E4CF38C48F8",
      "text": "Großartig!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "coach_gym_kusa_sp03_select_02",
      "hash64": "EB65214CF38C4E11",
      "text": "Ich versteh nur Bahnhof...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_gym_kusa_sp03_07",
      "hash64": "11CD16CD595FCACF",
      "text": "Du verlierst nie den roten Faden im Wirrwarr\\nmeiner kreativen Gedankengänge!\\r\\nDu solltest bei mir in die Lehre gehen![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 119,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_kusa_sp03_07b",
      "hash64": "9F486BEEDDC563F7",
      "text": "Hm, wenn das alles für dich keinen Sinn ergibt,\\ndann war mein Erlebnis vielleicht doch eher purer\\r\\nZufall und nicht so vom Künstler beabsichtigt...?[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 150,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_gym_kusa_sp03_04",
      "hash64": "11CD17CD595FCC82",
      "text": "Noch etwas... In seinem Atelier hing kein einziges\\nGemälde an den Wänden. Seltsam, oder?\\c\\nSo langsam frag ich mich, ob das überhaupt ein\\nAtelier war...[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 153,
          "count": 2,
          "code_hex": "0114",
