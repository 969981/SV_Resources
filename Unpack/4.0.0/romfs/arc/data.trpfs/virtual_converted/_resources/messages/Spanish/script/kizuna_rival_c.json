    {
      "ordinal": 2,
      "label": "kizuna_rival_c_03",
      "hash64": "05FBEED5E6CC8774",
      "text": "¿Te acuerdas de aquel chico al que reté en el\\ncomedor el otro día?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
