    },
    {
      "ordinal": 10,
      "label": "kizuna_rival_c_08",
      "hash64": "05FBE9D5E6CC7EF5",
      "text": "Hmm... Los combates Pokémon son mucho más\\ncomplejos de lo que parecen...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
