      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_rival_c_06",
      "hash64": "05FBEBD5E6CC825B",
      "text": "Con lo divertidos que son todos los combates...\\n¡Ganes o pierdas, el resultado es lo de menos![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
