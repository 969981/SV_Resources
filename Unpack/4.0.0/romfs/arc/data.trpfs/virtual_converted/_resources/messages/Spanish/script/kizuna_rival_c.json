          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_rival_c_09",
      "hash64": "05FBE8D5E6CC7D42",
      "text": "Y no sabes cómo me molesta que la gente me\\nllame \"genio\" y cosas por el estilo.\\c\\n¡Es como si dieran por hecho que no he tenido\\nni que esforzarme para llegar tan lejos![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
