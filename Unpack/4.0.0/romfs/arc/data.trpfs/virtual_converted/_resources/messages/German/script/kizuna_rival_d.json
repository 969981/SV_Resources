  "entries": [
    {
      "ordinal": 0,
      "label": "kizuna_rival_d_01",
      "hash64": "0E5E1910107B8C89",
      "text": "Da bist du ja, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "kizuna_rival_d_02",
      "hash64": "0E5E1610107B8770",
      "text": "Ich hab mir schon gedacht, dass du irgendwann\\nim Klassenzimmer aufkreuzen würdest.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_rival_d_03",
      "hash64": "0E5E1710107B8923",
      "text": "Sieht aus, als hätte ich tatsächlich recht behalten![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "kizuna_rival_d_04",
      "hash64": "0E5E1C10107B91A2",
      "text": "Aber was stehen wir noch hier rum? Komm mit\\nauf mein Zimmer und lass uns dort plaudern![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_rival_d_05",
      "hash64": "0E5E1D10107B9355",
      "text": "Tadaaa! Willkommen in der Villa Nemila![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_rival_d_system_01",
      "hash64": "AF6D3B6F3486B35B",
      "text": "Wow, wie ordentlich!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "kizuna_rival_d_system_02",
      "hash64": "AF6D3C6F3486B50E",
      "text": "Man sieht gleich, wer hier wohnt!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "kizuna_rival_d_06",
      "hash64": "0E5E1A10107B8E3C",
      "text": "Hm, wo du das so sagst... Ich war ja schon mal in\\ndeinem Zimmer...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_rival_d_07",
      "hash64": "0E5E1B10107B8FEF",
      "text": "Aber du bist jetzt zum ersten Mal in meinen\\nvier Wänden, stimmt’s? Verrückt![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_rival_d_08",
      "hash64": "0E5E2010107B986E",
      "text": "Also ja... Du fragst dich sicher, worüber ich mit\\ndir reden wollte, [VAR 0x0100(0000)]...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_rival_d_09",
      "hash64": "0E5E2110107B9A21",
      "text": "Du weißt doch, wie vernarrt ich ins\\nKämpfen bin, ne?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "kizuna_rival_d_system_03",
      "hash64": "AF6D3D6F3486B6C1",
      "text": "Na sicher!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "kizuna_rival_d_system_04",
      "hash64": "AF6D3E6F3486B874",
      "text": "Ist ja nicht zu übersehen!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "kizuna_rival_d_10",
      "hash64": "0E619E10107EA45F",
      "text": "Gut. Jedenfalls... Wenn ich etwas so richtig mag,\\ndann stürze ich mich voll und ganz hinein.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "kizuna_rival_d_11",
      "hash64": "0E619D10107EA2AC",
      "text": "So hab ich das auch mit dem Kämpfen gemacht...\\nUnd irgendwann bin ich dann Champ geworden.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "kizuna_rival_d_12",
      "hash64": "0E61A010107EA7C5",
      "text": "Ich versteh schon, dass mein Werdegang eher die\\nAusnahme ist... und dass es nicht jedem so leicht\\r\\nfällt wie mir.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 115,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "kizuna_rival_d_13",
      "hash64": "0E619F10107EA612",
      "text": "Aber ständig hat man mir gesagt, dass ich nur\\ndurch mein Talent so weit gekommen sei oder\\r\\nweil ich anders aufgewachsen bin.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "kizuna_rival_d_14",
      "hash64": "0E619A10107E9D93",
      "text": "Und auf einmal hab ich gespürt, wie mich eine\\nArt unsichtbare Wand von anderen trennte.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "kizuna_rival_d_15",
      "hash64": "0E619910107E9BE0",
      "text": "Damals hab ich dann auch angefangen, mich in\\nKämpfen gegen Freunde zurückzuhalten.\\r\\nIch wollte halt, dass auch sie Spaß dabei haben.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "kizuna_rival_d_16",
      "hash64": "0E619C10107EA0F9",
      "text": "Aber keine Sorge, das mach ich jetzt nicht mehr.\\nIch gebe absolut alles, was in mir steckt![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "kizuna_rival_d_17",
      "hash64": "0E619B10107E9F46",
      "text": "Vor allem, wenn ich es mit einem Gegner zu tun\\nhabe, der mich selbst dann fertig macht, wenn ich\\r\\nVollgas gebe![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "kizuna_rival_d_18",
      "hash64": "0E61A610107EB1F7",
      "text": "Ich wünsche mir deshalb nur eine einzige Sache\\nvon dir, [VAR 0x0100(0000)].[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "kizuna_rival_d_19",
      "hash64": "0E61A510107EB044",
      "text": "Bleib für immer [VAR 0x1100(00FF,1B1A,0000)]mein gleichwertiger Rivalemeine gleichwertige Rivalin, ja?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "1B1A",
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 80,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "kizuna_rival_d_system_05",
      "hash64": "AF6D3F6F3486BA27",
      "text": "Für immer und ewig!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "kizuna_rival_d_system_06",
      "hash64": "AF6D406F3486BBDA",
      "text": "Klaro, wir sind schließlich [VAR 0x1100(00FF,0B07,0000)]FreundeFreundinnen!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0B07",
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "kizuna_rival_d_20",
      "hash64": "0E572C1010758E24",
      "text": "Hehehe...\\nGroßartig, [VAR 0x0100(0000)]. Tausend Dank![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "kizuna_rival_d_21",
      "hash64": "0E572D1010758FD7",
      "text": "Oje, das ist doch etwas persönlich geworden,\\npeinlich, peinlich...[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "kizuna_rival_d_22",
      "hash64": "0E572E101075918A",
      "text": "Aber hey! Da wir nun wirklich auf gleicher\\nAugenhöhe sind, sollte ich dich auch häufiger\\r\\nin mein Zimmer einladen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "kizuna_rival_d_23",
      "hash64": "0E572F101075933D",
      "text": "Besuch mich also bitte in meiner Villa Nemila,\\nwann immer du möchtest![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "kizuna_rival_d_24",
      "hash64": "0E57281010758758",
      "text": "Ach, und bereite dich besser gut aufs nächste\\nGroße Akademieturnier vor. Denn diesmal zeig\\r\\nich dir, was ’ne Harke ist![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    }
  ]
