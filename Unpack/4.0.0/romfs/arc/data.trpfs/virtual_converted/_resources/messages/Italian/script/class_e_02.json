          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_e_02_battle_07",
      "hash64": "70CABA58714A4443",
      "text": "E queste lotte si chiamano Raid Teracristal![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
