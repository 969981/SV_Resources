          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "class_e_02_battle_09",
      "hash64": "70CAC858714A5C0D",
      "text": "State bene in guardia, perché spesso agiscono\\nin maniera diversa dagli esemplari normali.[VAR 0x0114(0024)]",
      "flags": 8,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "class_e_02_battle_10",
      "hash64": "70CDC558714C8CCB",
      "text": "Ma nei Raid Teracristal anche gli Allenatori hanno\\nun asso nella manica, un’azione tutta speciale:\\r\\nl’[VAR 0xFF00(0006)]incitamento[VAR 0xFF00(0000)]![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
