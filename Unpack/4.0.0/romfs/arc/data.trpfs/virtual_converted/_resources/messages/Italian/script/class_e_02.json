      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "class_e_02_select_03",
      "hash64": "01A34512FE4FC0E5",
      "text": "Onda curativa esplosiva!",
      "flags": 4,
      "text_status": "DECODED",
