    },
    {
      "ordinal": 3,
      "label": "class_e_02_battle_04",
      "hash64": "70CABB58714A45F6",
      "text": "Quando siete in giro qua e là fuori dalla scuola,\\ndi sicuro vi capiterà di vedere dei grossi [VAR 0xFF00(0006)]cristalli[VAR 0xFF00(0000)]\\r\\nche brillano di una luce intensa.[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 106,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 110,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
