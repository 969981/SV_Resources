          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "class_e_02_battle_11",
      "hash64": "70CDC458714C8B18",
      "text": "Ci sono tre tipi di incitamento...[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
