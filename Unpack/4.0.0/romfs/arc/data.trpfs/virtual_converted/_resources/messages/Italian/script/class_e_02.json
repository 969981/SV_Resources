          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "class_e_02_battle_12",
      "hash64": "70CDC758714C9031",
      "text": "Il primo è \"[VAR 0xFF00(0006)]Forza, forza![VAR 0xFF00(0000)]\", che permette di\\naumentare l’Attacco e l’Attacco Speciale\\r\\ndi tutti gli alleati.[VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
