          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_e_02_battle_08",
      "hash64": "70CAC758714A5A5A",
      "text": "I Pokémon Teracristal che affronterete in quei\\nraid... sono davvero potentissimi![VAR 0x0114(0024)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
