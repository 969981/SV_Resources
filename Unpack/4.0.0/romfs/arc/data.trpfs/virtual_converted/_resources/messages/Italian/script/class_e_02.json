      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "class_e_02_battle_answer_01",
      "hash64": "FCAF0805E9FC6FF6",
      "text": "Brav[VAR 0x1100(00FF,0101)]oa, novellin[VAR 0x1100(00FF,0101)]oa! Risposta esatta! Magari la\\nprossima lezione ce la puoi fare tu, che ne dici?[VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
