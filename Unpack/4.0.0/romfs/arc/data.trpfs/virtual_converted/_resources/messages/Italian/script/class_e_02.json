      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0024"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_e_02_battle_06",
      "hash64": "70CAB958714A4290",
      "text": "Provate a esaminarli per dare il via a un Raid\\nTeracristal assieme ad altri tre Allenatori.\\r\\nL’ideale per lottare fianco a fianco con gli amici![VAR 0x0114(0024)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
