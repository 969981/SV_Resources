      "text": "Tu trouves ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "sdc01_side01_010_brother_07",
      "hash64": "F26140E6987F4772",
      "text": "J’savais qu’tu serais d’accord !\\c\\nIl a affronté trois adversaires en même temps,\\net tout seul ! C’est ouf ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
