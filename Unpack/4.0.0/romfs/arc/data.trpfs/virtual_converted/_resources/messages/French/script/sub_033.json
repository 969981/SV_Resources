    {
      "ordinal": 6,
      "label": "sub_033_ecology_06",
      "hash64": "A5F7044293C63BAE",
      "text": "Le Pokémon Téracristal qui s’y trouve est\\nextrêmement puissant...[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_033_ecology_07",
      "hash64": "A5F7054293C63D61",
      "text": "La plupart des Dresseurs et des Dresseuses\\nne feraient pas le poids face à lui.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
