          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sub_033_ecology_08",
      "hash64": "A5F6FE4293C6317C",
      "text": "Il est si redoutable que même pour toi,\\nil présenterait un danger.\\r\\nEt pourtant, je sais à quel point tu es fort[VAR 0x1100(00FF,0100)]e...[VAR 0x0114(002A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
