          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sub_033_ecology_03",
      "hash64": "A5F7094293C6442D",
      "text": "Ton aide précieuse nous a permis d’effectuer\\ndes analyses.[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
