        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0070_botan_07",
      "hash64": "29E67990A8C5E7F5",
      "text": "If we don’t take them down, I’ll lose what I\\ntreasure most in the world.[VAR 0x0114(0008)]",
