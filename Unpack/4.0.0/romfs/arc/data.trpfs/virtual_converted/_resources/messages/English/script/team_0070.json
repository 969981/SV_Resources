    },
    {
      "ordinal": 40,
      "label": "team_0070_select_03",
      "hash64": "C5B8E79DED5EA3C5",
      "text": "What do you mean?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 41,
      "label": "team_0070_select_04",
      "hash64": "C5B8E09DED5E97E0",
      "text": "You’ll lose your treasure?",
