      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "team_0070_cassiopeia_10",
      "hash64": "54BAC7E74487AD68",
      "text": "Who knows? They control the five squad bosses\\nfrom the shadows... That’s all anyone can say.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "team_0070_cassiopeia_11",
      "hash64": "54BAC8E74487AF1B",
      "text": "If we defeat this person and get them to declare\\nthe team disbanded, that’ll be it for Team Star.[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "team_0070_cassiopeia_12",
      "hash64": "54BAC9E74487B0CE",
      "text": "Since the big boss never set up their own base\\nand keeps their identity hidden, I take it they’re\\r\\nnot one for the spotlight.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
