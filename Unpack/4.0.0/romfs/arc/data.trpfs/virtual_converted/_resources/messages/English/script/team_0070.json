    },
    {
      "ordinal": 10,
      "label": "team_0070_cassiopeia_04c",
      "hash64": "888009F9766A3BBA",
      "text": "With its boss no longer around, the Ruchbah\\nSquad is as good as finished.[VAR 0x0114(0009)]",
