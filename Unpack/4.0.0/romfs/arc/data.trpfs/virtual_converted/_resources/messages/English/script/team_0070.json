    },
    {
      "ordinal": 43,
      "label": "team_0070_botan_09",
      "hash64": "29E67B90A8C5EB5B",
      "text": "Um...that’s right! You need your reward!\\nHere—take it before I forget.[VAR 0x0114(0008)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
