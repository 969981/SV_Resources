    {
      "ordinal": 20,
      "label": "team_0070_cassiopeia_08",
      "hash64": "54BDC5E74489DFD9",
      "text": "This seems like a good time to let you know what\\nwe’re ultimately aiming to achieve.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
