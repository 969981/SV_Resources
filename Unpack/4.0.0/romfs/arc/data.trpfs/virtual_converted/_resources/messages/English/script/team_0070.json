      "label": "team_0070_system_03",
      "hash64": "C53528E84E76DF12",
      "text": "You can now make more kinds of TMs using the\\nTM Machine!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "team_0070_cassiopeia_14",
