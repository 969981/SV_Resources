    {
      "ordinal": 9,
      "label": "team_0070_cassiopeia_04b",
      "hash64": "88800AF9766A3D6D",
      "text": "Now that its boss has been taken down, the Navi\\nSquad’s days are numbered.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
