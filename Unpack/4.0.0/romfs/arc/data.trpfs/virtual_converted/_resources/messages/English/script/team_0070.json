    {
      "ordinal": 19,
      "label": "team_0070_cassiopeia_07",
      "hash64": "54BDCEE74489EF24",
      "text": "So, Operation Starfall. You’ve taken down all but\\ntwo bases, so it’s fair to say it’s going well.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
