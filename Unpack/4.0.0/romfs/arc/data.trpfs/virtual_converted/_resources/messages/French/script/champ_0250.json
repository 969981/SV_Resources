      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "champ_0250_dragon_01",
      "hash64": "6EE322E937D90C1A",
      "text": "J’étais certain qu’un jour ou l’autre, vous finiriez\\npar arriver jusqu’ici.[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
