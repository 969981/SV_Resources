          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0250_dragon_06",
      "hash64": "6EE31DE937D9039B",
      "text": "Car il est de mon devoir de tout faire\\npour vous vaincre ![VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
