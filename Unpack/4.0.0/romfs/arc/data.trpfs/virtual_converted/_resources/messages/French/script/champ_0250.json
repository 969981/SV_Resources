          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0012"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "champ_0250_dragon_05",
      "hash64": "6EE31EE937D9054E",
      "text": "Cependant, il me faut oublier ce rôle,\\nle temps de notre affrontement...[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
