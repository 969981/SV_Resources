    },
    {
      "ordinal": 46,
      "label": "sdc02_0110_fairybb_06",
      "hash64": "99B2032E37E9E235",
      "text": "I...I’m sorry, but considering the rules, it’s a no\\nfrom me.[VAR 0x0114(0049)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
