    },
    {
      "ordinal": 44,
      "label": "sdc02_0110_dragonbb_22",
      "hash64": "23A6E39E05C998CB",
      "text": "I think we should vote on it.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
