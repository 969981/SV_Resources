    },
    {
      "ordinal": 45,
      "label": "sdc02_0110_dragonbb_23",
      "hash64": "23A6E29E05C99718",
      "text": "I’m a yes, obviously. How ’bout you, Lacey?[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
