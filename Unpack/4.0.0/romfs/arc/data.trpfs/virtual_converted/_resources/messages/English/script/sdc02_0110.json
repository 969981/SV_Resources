      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0110_dragonbb_02",
      "hash64": "23ADD39E05CF9C49",
      "text": "No need to stand there. Grab a seat.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
