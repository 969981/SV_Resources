      "ordinal": 62,
      "label": "sdc02_0110_dragonbb_28",
      "hash64": "23A6DD9E05C98E99",
      "text": "Guess you’ll be joining the BB League, huh?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
