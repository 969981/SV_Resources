        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc02_0110_brother_07",
      "hash64": "21AFF174C274B5E3",
      "text": "For real?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
