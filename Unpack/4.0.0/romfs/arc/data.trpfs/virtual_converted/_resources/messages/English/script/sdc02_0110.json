      "ordinal": 61,
      "label": "sdc02_0110_dragonbb_27",
      "hash64": "23A6E69E05C99DE4",
      "text": "Sorry, [VAR 0x0100(0000)]...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
