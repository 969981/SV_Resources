      "ordinal": 66,
      "label": "sdc02_0110_dragonbb_32",
      "hash64": "23A3E19E05C75F8E",
      "text": "Meet me at the reception desk in the school’s\\nentrance area![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
