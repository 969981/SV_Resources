      "ordinal": 60,
      "label": "sdc02_0110_fairybb_09",
      "hash64": "99B2042E37E9E3E8",
      "text": "Drayton! Manipulating people to get what you\\nwant—it’s just not right![VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0049"
          ]
        }
      ]
    },
