          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "sdc02_0110_dragonbb_30",
      "hash64": "23A3DF9E05C75C28",
      "text": "Don’t worry, I’ll be right behind you. Every step\\nof the way.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 65,
      "label": "sdc02_0110_dragonbb_31",
      "hash64": "23A3E09E05C75DDB",
      "text": "But now that the decision’s been made, we better\\nget you officially signed up.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
