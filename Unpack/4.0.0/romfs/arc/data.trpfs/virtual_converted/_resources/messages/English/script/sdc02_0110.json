          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc02_0110_fairybb_01",
      "hash64": "99B1FC2E37E9D650",
      "text": "Yes, it’s true.[VAR 0x0114(0049)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
