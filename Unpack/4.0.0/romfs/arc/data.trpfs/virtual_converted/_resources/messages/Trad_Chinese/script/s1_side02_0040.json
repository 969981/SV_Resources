      "label": "s1_side02_0040_camera_01",
      "hash64": "9AD6E015162B20A0",
      "text": "把[VAR 0x1100(00FF,0101)]你妳拍的照片跟\\n我拍的照片合起來……[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
