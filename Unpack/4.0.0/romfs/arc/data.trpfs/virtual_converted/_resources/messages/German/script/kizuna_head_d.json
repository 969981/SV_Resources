      "hash64": "44C3221A7E778DAF",
      "text": "Vielen Dank für deine Hilfe bei der Operation\\nStardust.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
