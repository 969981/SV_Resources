      "label": "s2_side02_0005_camera_01",
      "hash64": "46A0FD7C1A917D96",
      "text": "Hey, [VAR 0x0100(0000)]! Don’t tell me...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
