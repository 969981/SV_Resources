    {
      "ordinal": 11,
      "label": "s2_side02_0005_camera_08",
      "hash64": "46A1067C1A918CE1",
      "text": "Totally unknown Pokémon in totally unknown\\nplaces! If they’re real, it’d be a huge deal![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
