          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side02_0005_camera_10",
      "hash64": "469D787C1A8E65C0",
      "text": "Wow! Are they famous spots? I want to visit\\nthem![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side02_0005_camera_11",
      "hash64": "469D797C1A8E6773",
      "text": "So they aren’t somewhere you can easily reach,\\nthen? Wow, these spots must be really special.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_side02_0005_camera_12",
      "hash64": "469D7A7C1A8E6926",
      "text": "Of course, you know how it is these days, right?\\nThese photos could totally be fakes.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side02_0005_camera_13",
      "hash64": "469D7B7C1A8E6AD9",
      "text": "But if you want to know for sure, maybe you\\ncould go try to search these Pokémon out![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side02_0005_camera_14",
      "hash64": "469D7C7C1A8E6C8C",
      "text": "I can show you the photos again anytime you\\nlike. Just give me a shout.[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side02_0005_camera_15",
      "hash64": "469D7D7C1A8E6E3F",
      "text": "[VAR 0xBD06(0000)]And find me something good,\\n[VAR 0x0100(0000)]!\\r\\nI’ve\\r\\ngot\\r\\nfaith\\r\\nin\\r\\nyour\\r\\nsurvey\\r\\nskills![VAR 0x0114(0046)]",
