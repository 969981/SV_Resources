    },
    {
      "ordinal": 12,
      "label": "s2_side02_0005_camera_09",
      "hash64": "46A1057C1A918B2E",
      "text": "Apparently these places are in Paldea... You have\\nany idea where, [VAR 0x0100(0000)]?[VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
