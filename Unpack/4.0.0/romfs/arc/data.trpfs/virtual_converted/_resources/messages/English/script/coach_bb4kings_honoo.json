            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_bb4kings_honoo_sp02_select_01",
      "hash64": "9364298E4642F873",
      "text": "I love it!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 15,
      "label": "coach_bb4kings_honoo_sp02_select_02",
      "hash64": "93642A8E4642FA26",
      "text": "Not really",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "coach_bb4kings_honoo_sp02_01",
      "hash64": "EE5436582F6D2814",
      "text": "You like it that much, eh? Nice!\\c\\nGuess that explains how you made that\\nsuper-spicy sandwich so easily![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 105,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_bb4kings_honoo_sp02_01b",
      "hash64": "6640CDD8967BC082",
      "text": "Really?!\\c\\nYou’re not that into cooking and you still\\nmanaged to whip up a super-spicy sandwich?![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_bb4kings_honoo_sp02_02",
      "hash64": "EE5439582F6D2D2D",
      "text": "Me, I just love cooking! Guess one look at my\\nfrying pan gives that away, huh?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_bb4kings_honoo_sp02_03",
      "hash64": "EE5438582F6D2B7A",
      "text": "My parents run a little restaurant, y’see. Once I\\nfinish school, I wanna take over the business![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_bb4kings_honoo_sp02_04",
      "hash64": "EE5433582F6D22FB",
      "text": "Heck, the only reason I’m in this academy is\\n’cause the director recruited me![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_bb4kings_honoo_sp02_05",
      "hash64": "EE5432582F6D2148",
      "text": "So during this whole drama, watching Kieran\\nand Drayton kinda shocked me...[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_bb4kings_honoo_sp02_06",
      "hash64": "EE5435582F6D2661",
      "text": "They really went blazing hot in their battles,\\ndidn’t they? Enough to burn you![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_bb4kings_honoo_sp02_07",
      "hash64": "EE5434582F6D24AE",
      "text": "I never thought I’d see anyone get so fired up for\\nPokémon battles, but I guess I was wrong![VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_bb4kings_honoo_sp02_08",
      "hash64": "EE542F582F6D1C2F",
      "text": "Made me think maybe I should turn up the heat\\na little bit myself, y’know?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_bb4kings_honoo_sp03_00",
      "hash64": "4600615FCBEC4FF6",
      "text": "Hey, [VAR 0x0100(0000)]! Listen to this![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_bb4kings_honoo_sp03_01",
      "hash64": "4600625FCBEC51A9",
      "text": "Turns out I get to stay in the Elite Four![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_bb4kings_honoo_sp03_select_01",
      "hash64": "23BA9267B1786E38",
      "text": "That’s great!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "coach_bb4kings_honoo_sp03_select_02",
      "hash64": "23BA9567B1787351",
      "text": "How come?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "coach_bb4kings_honoo_sp03_02",
      "hash64": "46005F5FCBEC4C90",
      "text": "Yeah, good news! ...I guess?[VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "coach_bb4kings_honoo_sp03_02b",
      "hash64": "DEEF01C78286BF36",
      "text": "That’s a great question! I’m not sure myself![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0047"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_bb4kings_honoo_sp03_03",
      "hash64": "4600605FCBEC4E43",
      "text": "I was told something about Kieran going on a\\nbreak from school and stuff...[VAR 0x0114(0047)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
