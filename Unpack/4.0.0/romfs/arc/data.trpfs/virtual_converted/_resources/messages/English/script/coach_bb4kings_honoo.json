    {
      "ordinal": 13,
      "label": "coach_bb4kings_honoo_sp02_00",
      "hash64": "EE5437582F6D29C7",
      "text": "[VAR 0xBD06(0000)]Hey, [VAR 0x0100(0000)]! D’you like\\ncooking?![VAR 0x0114(0047)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
