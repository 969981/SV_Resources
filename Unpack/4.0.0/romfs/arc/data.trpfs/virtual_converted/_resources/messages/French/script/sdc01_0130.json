      "label": "sdc01_0130_brother_03",
      "hash64": "D4DE25C737F60E08",
      "text": "Hé hé hé...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
