          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0130_brother_02",
      "hash64": "D4DE26C737F60FBB",
      "text": "F-fais pas attention à ce qu’elle dit,\\n[VAR 0x0100(0000)]...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
