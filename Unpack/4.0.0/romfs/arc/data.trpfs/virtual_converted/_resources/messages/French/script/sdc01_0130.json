    },
    {
      "ordinal": 9,
      "label": "sdc01_0130_brother_07",
      "hash64": "D4DE29C737F614D4",
      "text": "Roseille, tu me marches sur le pied ![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
