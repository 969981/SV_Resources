    },
    {
      "ordinal": 12,
      "label": "sdc01_0130_sister_12",
      "hash64": "05D81C9DE4B200F8",
      "text": "Pas mal ! Tu sais faire la fête, toi ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
