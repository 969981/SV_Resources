    },
    {
      "ordinal": 8,
      "label": "sdc01_0130_sister_13",
      "hash64": "05D81D9DE4B202AB",
      "text": "Approchez-vous, tous les deux.[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
