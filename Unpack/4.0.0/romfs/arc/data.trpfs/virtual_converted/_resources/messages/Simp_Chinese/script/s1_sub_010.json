    {
      "ordinal": 0,
      "label": "s1_sub_010_ecology_01",
      "hash64": "77F2E874C0CC2E21",
      "text": "你好呀～你好！[VAR 0x0100(0000)]！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
