          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_sub_010_ecology_02",
      "hash64": "77F2E574C0CC2908",
      "text": "[VAR 0x0100(0000)]你在北上乡\\n捉到的宝可梦有……[VAR 0x0202(0001)]种！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0202",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "s1_sub_010_ecology_03",
      "hash64": "77F2E674C0CC2ABB",
      "text": "夏令营才刚刚开始！\\c\\n你就去多～见见\\n只有北上才有的宝可梦吧～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 9,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "s1_sub_010_ecology_04",
      "hash64": "77F2EB74C0CC333A",
      "text": "气候不同，栖息的宝可梦\\n也当然会有所不同～\\c\\n北上的夏天湿度很高，\\n所以会有喜欢湿答答的宝可梦哦～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_sub_010_ecology_05",
      "hash64": "77F2EC74C0CC34ED",
      "text": "听说在鬼山的高处\\n会有火山气体从地面冒出来！\\c\\n喜欢气体的宝可梦\\n待在那里倒是应该会很舒服……[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_010_ecology_05_02",
      "hash64": "CC6D265DB8C2E240",
      "text": "但是[VAR 0x0100(0000)]，\\n你要小心别吸进太多气体哦～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 2,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_sub_010_ecology_06",
      "hash64": "77F2E974C0CC2FD4",
      "text": "哇～！\\n你的北上图鉴几乎快填满了～！\\c\\n你可以在图鉴上确认宝可梦的栖息地，\\n或是去结晶洞窟挑战团体战等等。\\c\\n离完成就只差一点了，\\n[VAR 0x0100(0000)]，好好加油吧～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_010_ecology_07",
      "hash64": "77F2EA74C0CC3187",
      "text": "莫非这里有……\\n全部种类了吗～！？[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_sub_010_ecology_08",
      "hash64": "77F2DF74C0CC1ED6",
      "text": "哇～哇～！\\n北上图鉴完成了～！\\r\\n太厉害了～真的太厉害了～！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_sub_010_ecology_09",
      "hash64": "77F2E074C0CC2089",
      "text": "多亏了[VAR 0x0100(0000)]你，\\n北上乡的宝可梦调查\\r\\n取得了前所未有的进展～！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_010_ecology_10",
      "hash64": "77F66D74C0CF45F7",
      "text": "我很想送些什么给你当作庆祝，\\n但我身上的钱不太够……[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_010_ecology_11",
      "hash64": "77F66C74C0CF4444",
      "text": "……对了！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_sub_010_ecology_25",
      "hash64": "77EC5874C0C6CDC3",
      "text": "就把我在北上中心\\n买到的限定土特产送给你吧！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_sub_010_ecology_12",
      "hash64": "77F66F74C0CF495D",
      "text": "还有，\\n可以请你拿出手机洛托姆吗～？[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_010_ecology_13",
      "hash64": "77F66E74C0CF47AA",
      "text": "克拉韦尔校长帮我\\n在图鉴App增加了奖状功能，\\r\\n让我来为[VAR 0x0100(0000)]你庆祝一下吧～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_sub_010_ecology_14",
      "hash64": "77F66974C0CF3F2B",
      "text": "认证宝可梦图鉴的企业\\n也发来了消息～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_sub_010_ecology_15",
      "hash64": "77F66874C0CF3D78",
      "text": "虽说图鉴已经完成了，\\n但夏令营才刚刚开始。[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_sub_010_ecology_16",
      "hash64": "77F66B74C0CF4291",
      "text": "今后你也要和\\n许～多北上的宝可梦相遇哦～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_sub_010_ecology_17",
      "hash64": "77F66A74C0CF40DE",
      "text": "今天天气真好啊～\\n神清气爽的一天就此开始～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_sub_010_ecology_18",
      "hash64": "77F66574C0CF385F",
      "text": "北上的夏天真是闷热啊～\\n我的白色工作袍里边都湿透了～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_sub_010_ecology_19",
      "hash64": "77F66474C0CF36AC",
      "text": "北上的晚霞\\n色调比帕底亚要淡，真是漂亮～\\r\\n是因为光的折射率有所不同吗～？[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_sub_010_ecology_20",
      "hash64": "77EC5B74C0C6D2DC",
      "text": "虽然你很努力地忙到这么晚，\\n但偶尔也抬头看看天空吧！\\c\\n镇里的光源很少，所以天上的星星\\n都能看得一清二楚哦～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_sub_010_ecology_21",
      "hash64": "77EC5C74C0C6D48F",
      "text": "今天是由雨水开启的一天～\\c\\n喜欢下雨的宝可梦\\n说不定会非常高兴吧～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_sub_010_ecology_22",
      "hash64": "77EC5D74C0C6D642",
      "text": "北上的夏天就算下雨也很闷，\\n这气候真是不得了。\\c\\n这种气候似乎也会对生态系统产生影响～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_sub_010_ecology_23",
      "hash64": "77EC5E74C0C6D7F5",
      "text": "下午的雷阵雨下得好大呀～\\c\\n如果放着湿漉漉的身体不管，\\n体温就会下降，要小心啊～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_sub_010_ecology_24",
      "hash64": "77EC5774C0C6CC10",
      "text": "晚上不仅视线不好，\\n路面还因为下雨而变得很泥泞，\\r\\n所以你不要去太远的地方啊～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_sub_010_ecology_stop",
      "hash64": "476DB22077BD9036",
      "text": "目标是称霸北上图鉴！\\n一共２００种～！\\c\\n完成后在图鉴App按[VAR 0xFF00(0006)]Ｘ键[VAR 0xFF00(0000)]，\\n加上完成图鉴的标记，\\r\\n拿来给我看一下吧～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 33,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
