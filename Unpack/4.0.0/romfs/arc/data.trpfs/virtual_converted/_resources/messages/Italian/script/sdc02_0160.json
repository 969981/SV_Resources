      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0160_dragonbb_b_01",
      "hash64": "E1EBC8B7E02DF950",
      "text": "Erin è una tipa interessante, vero?[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
