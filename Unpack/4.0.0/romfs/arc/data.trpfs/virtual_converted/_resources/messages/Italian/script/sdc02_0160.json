    {
      "ordinal": 12,
      "label": "sdc02_0160_dragonbb_c_02",
      "hash64": "0D85D1BE413B3B6C",
      "text": "Le piacciono così tanto che allenarli non le costa\\nalcuna fatica. Però ci si impegna, eh! Che storia.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
