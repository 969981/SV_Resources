    {
      "ordinal": 1,
      "label": "sdc02_0160_dragonbb_02",
      "hash64": "458C48E1C3BE86B6",
      "text": "’Naggia, ci ho messo un sacco. Scusa.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
