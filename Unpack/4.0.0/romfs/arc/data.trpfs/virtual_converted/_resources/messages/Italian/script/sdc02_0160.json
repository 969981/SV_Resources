      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0160_dragonbb_b_02",
      "hash64": "E1EBCBB7E02DFE69",
      "text": "Se la senti parlare con Rubra, poi, è uno spasso.\\c\\nPer qualche motivo, quelle due si capiscono\\nal volo. Buffo, non trovi?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
