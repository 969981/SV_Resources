      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0160_dragonbb_b_03",
      "hash64": "E1EBCAB7E02DFCB6",
      "text": "È una tipa seria e rigorosa... ma anche\\nmolto sensibile.[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0160_dragonbb_b_04",
      "hash64": "E1EBCDB7E02E01CF",
      "text": "È facile fraintenderla, ma tu cerca di fare\\nuno sforzo, [VAR 0x0100(0000)].[VAR 0x0114(004A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
