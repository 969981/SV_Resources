    {
      "ordinal": 11,
      "label": "kizuna_dragon_a_10",
      "hash64": "810BD06CB8568FBB",
      "text": "抱歉突然问起\\n如此奇怪的问题。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
