    {
      "ordinal": 7,
      "label": "kizuna_dragon_a_06",
      "hash64": "8108446CB8536C00",
      "text": "作为寻宝的一环，\\n你正在挑选道馆，对吗？[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
