      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_dragon_a_07",
      "hash64": "8108456CB8536DB3",
      "text": "你一定很喜欢\\n宝可梦对战吧？[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
