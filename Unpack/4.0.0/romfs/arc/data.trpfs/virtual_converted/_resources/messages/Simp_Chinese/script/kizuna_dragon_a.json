    },
    {
      "ordinal": 9,
      "label": "kizuna_dragon_a_08a",
      "hash64": "94A7B9BD35E8BB91",
      "text": "兴趣是最好的老师，\\n所以，你一定很强吧。[VAR 0x0114(0012)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
