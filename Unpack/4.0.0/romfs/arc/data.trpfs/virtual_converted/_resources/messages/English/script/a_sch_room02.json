          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "a_sch_room02_eve05",
      "hash64": "5ED853C6313F0EE1",
      "text": "What a fine sculpture... Even Pokémon must be\\nenvious of its beauty!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
