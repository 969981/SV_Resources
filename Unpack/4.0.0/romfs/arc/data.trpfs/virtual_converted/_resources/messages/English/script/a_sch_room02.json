      "hash64": "5ED857C6313F15AD",
      "text": "I tried washing my Muk at a picnic, and it seemed\\nto hate it! Por queeé?!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
