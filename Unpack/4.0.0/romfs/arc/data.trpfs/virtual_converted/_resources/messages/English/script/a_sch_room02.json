          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "a_sch_room02_eve04",
      "hash64": "5ED852C6313F0D2E",
      "text": "A great drawing or painting can show off some\\namazing techniques that no photo could!\\c\\nAnd vice versa—a great photo can do things a\\ndrawing or painting can’t!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
