          "code_hex": "0114",
          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "kizuna_math_c_09",
      "hash64": "D2ED2888983CD410",
      "text": "She seems to be a student here, but I get the\\nfeeling that her question is not about her studies.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
