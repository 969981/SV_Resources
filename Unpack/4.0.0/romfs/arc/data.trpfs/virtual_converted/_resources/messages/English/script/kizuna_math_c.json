    {
      "ordinal": 14,
      "label": "kizuna_math_c_11",
      "hash64": "D2E9AC889839CB85",
      "text": "It could have been a little scary being here on my\\nown. I’m glad you were here with me.[VAR 0x0114(0025)]",
      "flags": 4,
