          "args_hex": [
            "0025"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "kizuna_math_c_10",
      "hash64": "D2E9AB889839C9D2",
      "text": "Next time I see her, maybe I’ll go start up a\\nconversation myself![VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
