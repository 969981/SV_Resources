      ]
    },
    {
      "ordinal": 4,
      "label": "kizuna_math_c_03",
      "hash64": "D2ED3288983CE50E",
      "text": "I was just walking around the entrance hall...[VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
