        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_math_c_woman_01",
      "hash64": "F42347F9AB47717F",
      "text": "Huh? That’s weird...I thought I saw her come\\nin here.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "kizuna_math_c_woman_02",
      "hash64": "F42348F9AB477332",
      "text": "I guess I won’t be able to ask my question today,\\neither...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "kizuna_math_c_08",
      "hash64": "D2ED2988983CD5C3",
      "text": "That girl...I feel like I’ve seen her several times\\nbefore.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
