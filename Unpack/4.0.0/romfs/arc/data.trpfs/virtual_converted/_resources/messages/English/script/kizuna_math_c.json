        }
      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_math_c_05",
      "hash64": "D2ED3488983CE874",
      "text": "So I quickly ducked into the cafeteria here.[VAR 0x0114(0025)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
