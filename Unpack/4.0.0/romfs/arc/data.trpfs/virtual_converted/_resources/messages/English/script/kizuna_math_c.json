      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_math_c_06",
      "hash64": "D2ED3788983CED8D",
      "text": "Our cafeteria has only one entrance, so I thought\\nI might be able to discover the identity of the\\r\\nperson watching me if they followed me in here![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
