      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_math_c_07",
      "hash64": "D2ED3688983CEBDA",
      "text": "Ah! Someone’s come just now![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
