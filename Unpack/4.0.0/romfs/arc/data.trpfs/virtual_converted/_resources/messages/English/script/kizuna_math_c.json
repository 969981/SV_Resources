      ]
    },
    {
      "ordinal": 5,
      "label": "kizuna_math_c_04",
      "hash64": "D2ED3588983CEA27",
      "text": "and I felt that intense gaze that I told you\\nabout before![VAR 0x0114(0025)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
