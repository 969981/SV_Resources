    },
    {
      "ordinal": 2,
      "label": "sdc01_0480_sister_03",
      "hash64": "17B1F7D2AF61C78A",
      "text": "Maintenant que notre unité spéciale\\n« S.O.S. Masques Volés » a rempli sa mission,\\r\\nj’imagine qu’on peut fermer boutique.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
