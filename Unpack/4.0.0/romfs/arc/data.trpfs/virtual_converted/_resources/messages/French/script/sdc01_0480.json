          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0480_sister_04",
      "hash64": "17B1F2D2AF61BF0B",
      "text": "Quant à Kass... Il refuse de sortir de sa chambre\\ndepuis qu’il est rentré.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0480_select_01",
      "hash64": "208FF08D9FE482EC",
      "text": "Oh non...",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sdc01_0480_select_02",
      "hash64": "208FF38D9FE48805",
      "text": "Je vois...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "sdc01_0480_sister_05",
      "hash64": "17B1F1D2AF61BD58",
      "text": "Ouais...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0480_sister_06",
      "hash64": "17B1F4D2AF61C271",
      "text": "Mais t’as pas à te sentir responsable de\\nquoi que ce soit, [VAR 0x0100(0000)] !\\c\\nC’est moi qui ai insisté pour lui cacher ce qu’on\\nsavait au sujet d’Ogerpon, après tout...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 159,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0480_sister_07",
      "hash64": "17B1F3D2AF61C0BE",
      "text": "Et puis, on dirait pas comme ça, mais Kass aussi\\na sa fierté, et je pense qu’elle a été mise à mal ![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 100,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0480_sister_08",
      "hash64": "17B1EED2AF61B83F",
      "text": "Enfin, bref... Comment va Ogerpon ?[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0480_sister_09",
      "hash64": "17B1EDD2AF61B68C",
      "text": "Je t’avoue que je me suis beaucoup attachée\\nà lui, après toutes ces péripéties...\\c\\nBon, j’en suis pas au niveau de Kass, mais\\nquand même ! Et du coup...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 154,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0480_sister_10",
      "hash64": "17AEF0D2AF5F85CE",
      "text": "J’aimerais bien faire un combat contre toi\\net Ogerpon. Tu veux bien ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0480_sister_11",
      "hash64": "17AEF1D2AF5F8781",
      "text": "Bah alors ! T’es encore fâché[VAR 0x1100(00FF,0100)]e parce que je t’ai\\nfait des misères à ton arrivée au village ?\\c\\nAllez, accepte le combat ! Ça nous fera un bon\\nsouvenir, en plus ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 167,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0480_sister_12",
      "hash64": "17AEEED2AF5F8268",
      "text": "Je savais que tu dirais oui ! C’est vraiment tout\\ntoi d’accepter n’importe quoi sans broncher !\\c\\nDis-moi quand tu seras prêt[VAR 0x1100(00FF,0100)]e ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 126,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0480_sister_29",
      "hash64": "17AB71D2AF5C782A",
      "text": "Ah, Ogerpon est avec toi ! Si j’ai bien compris,\\nson style de combat change en fonction de\\r\\nson masque... Celui qu’il porte te convient ?[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0480_sister_30",
      "hash64": "17A7E4D2AF5952BC",
      "text": "Mais Ogerpon est même pas avec toi !\\nRamène-le d’abord, et on verra ensuite ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0480_sister_31",
      "hash64": "17A7E5D2AF59546F",
      "text": "Pardon ? Ogerpon n’est pas dans ton équipe\\nni dans tes Boîtes PC...\\c\\nC’est ton choix, j’imagine...\\nTu veux quand même te battre ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc01_0480_sister_32",
      "hash64": "17A7E6D2AF595622",
      "text": "Reviens me voir quand tu voudras faire\\nun combat.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0480_sister_13",
      "hash64": "17AEEFD2AF5F841B",
      "text": "En place, alors ![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0480_sister_14",
      "hash64": "17AEF4D2AF5F8C9A",
      "text": "Raaah, j’ai la haine ! Mais c’est loin de me\\nsurprendre, venant de toi.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0480_sister_15",
      "hash64": "17AEF5D2AF5F8E4D",
      "text": "Vous vous entendez vraiment bien, Ogerpon\\net toi... J’en suis presque jalouse ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0480_sister_33",
      "hash64": "17A7E7D2AF5957D5",
      "text": "Même si au fond, c’était contre Ogerpon que\\nje voulais me battre... Mais bon, tant pis, hein.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "sdc01_0480_ogre_01",
      "hash64": "AAE0A16A70165E5D",
      "text": "Mopooon !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "sdc01_0480_sister_16",
      "hash64": "17AEF2D2AF5F8934",
      "text": "Sinon, euh... Il faut que je te dise un truc...\\nC’est un peu délicat, mais...\\r\\nEn fait, je vais bientôt...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0480_system_01",
      "hash64": "DFD413767C8D29C7",
      "text": "Motiti ♪ Motiti ♪ Motiti ♪",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "sdc01_0480_bbteacher_01",
      "hash64": "A3032A72F30EB242",
      "text": "Allô, [VAR 0x0100(0000)] ?\\nC’est madame Bria ! Quel plaisir de te parler ![VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0480_bbteacher_02",
      "hash64": "A3032972F30EB08F",
      "text": "J’ai appris ce matin que tous les binômes\\navaient terminé la course d’orientation ![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc01_0480_bbteacher_03",
      "hash64": "A3032872F30EAEDC",
      "text": "L’intendant nous a demandé de tous nous réunir\\nau centre culturel. Je crois qu’il a quelque chose\\r\\nà nous dire.[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 113,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0480_sister_25",
      "hash64": "17AB65D2AF5C63C6",
      "text": "D’accord, madame ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0480_bbteacher_04",
      "hash64": "A3032772F30EAD29",
      "text": "Oh, Roseille est avec toi ? C’est parfait !\\nJe cherchais justement à la joindre, elle aussi.[VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "sdc01_0480_bbteacher_05",
      "hash64": "A3032672F30EAB76",
      "text": "Les enfants sont vraiment formidables !\\c\\nVous arrivez à vous lier d’amitié en moins\\nde temps qu’il n’en faut pour le dire ![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "sdc01_0480_bbteacher_06",
      "hash64": "A3032572F30EA9C3",
      "text": "Sur ce, rendez-vous au centre culturel !\\nNe traînez pas, c’est d’accord ?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "sdc01_0480_sister_26",
      "hash64": "17AB64D2AF5C6213",
      "text": "Elle a raison. Et dire qu’on venait juste de devenir\\nami[VAR 0x1100(00FF,0100)]es... Je suis dég...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0100"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
