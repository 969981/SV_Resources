    {
      "ordinal": 11,
      "label": "common_2050_top_12",
      "hash64": "7B9BD901D9F6CB98",
      "text": "我想問的就是這些了。\\n……謝謝[VAR 0x1100(00FF,0101)]你妳。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
