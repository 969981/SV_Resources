        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_2050_top_13",
      "hash64": "7B9BDA01D9F6CD4B",
      "text": "冠軍[VAR 0x0100(0000)][VAR 0x1100(00FF,0101)]你妳的觀點\\n十分耐人尋味。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
