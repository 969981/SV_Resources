      "label": "common_2050_top_02",
      "hash64": "7B9F6301D9F9EBED",
      "text": "[VAR 0x1100(00FF,0101)]你妳就是在這裡培養出\\n冠軍的素質的嗎？[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
