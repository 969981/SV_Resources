      "ordinal": 17,
      "label": "common_2050_top_18",
      "hash64": "7B9BD301D9F6C166",
      "text": "那麼，我就不多打擾了。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
