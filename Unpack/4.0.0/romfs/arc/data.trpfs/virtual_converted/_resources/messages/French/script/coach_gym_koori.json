    {
      "ordinal": 45,
      "label": "coach_gym_koori_battleend_win_00_00",
      "hash64": "BED50689952D5CFF",
      "text": "Quelle défaite écrasante...\\nLa réalité est aussi cruelle qu’une avalanche.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
