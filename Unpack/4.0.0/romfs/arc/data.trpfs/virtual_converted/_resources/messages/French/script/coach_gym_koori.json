          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_gym_koori_randomtalk_00",
      "hash64": "EBF1DF29191CA9D5",
      "text": "Je ne suis pas doué avec les élèves... Quand\\nje pense aux désillusions auxquelles ils vont\\r\\ndevoir faire face dans la vie, ça me refroidit.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 141,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_gym_koori_randomtalk_01",
      "hash64": "EBF1DE29191CA822",
      "text": "Apparemment, je suis un peu connu dans le coin\\naussi... On me demande même des selfies...\\c\\nMais franchement, celui que j’avais pris avec toi\\nme suffisait amplement. C’est pas trop mon truc.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 191,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_gym_koori_randomtalk_02",
      "hash64": "EBF1DD29191CA66F",
      "text": "Tu trouves pas que la clim est trop forte, ici ?\\nÀ qui je dois demander pour la baisser ?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_gym_koori_randomtalk_03",
      "hash64": "EBF1DC29191CA4BC",
      "text": "Ton [VAR 0x0101(0001)] est vraiment pas mal !\\nIl s’entend très bien avec mes autres Pokémon.\\c\\n... On peut dire qu’il a tout de suite su briser\\nla glace avec ma propre équipe.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 78,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 162,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_gym_koori_randomtalk_04",
      "hash64": "EBF1DB29191CA309",
      "text": "Comment ça se passe avec le Piétacé que je t’ai\\ndonné ?\\c\\nIl a tendance à disparaître dès qu’on a le dos\\ntourné. Fais attention pendant tes pique-niques.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 154,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_gym_koori_randomtalk_sp",
      "hash64": "EB1BA52918668C5E",
      "text": "Au fait... je discutais avec Alisma il y a peu,\\net j’ai appris quelque chose.\\c\\nApparemment, tu lui as dit que j’étais ton\\nChampion d’Arène préféré.\\c\\nMais je ne comprends vraiment pas pourquoi...\\nJe n’ai absolument rien fait pour.\\c\\nAu début, je trouvais même ça gênant pour toi,\\nmais... je te remercie quand même.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
