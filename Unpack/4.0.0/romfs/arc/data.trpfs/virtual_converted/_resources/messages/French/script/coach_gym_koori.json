            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "coach_gym_koori_battleend_win_00_02",
      "hash64": "BED50889952D6065",
      "text": "Tiens, prends ça pour ta victoire.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
