          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "coach_gym_koori_talkto_00",
      "hash64": "9EAE8C073B56427B",
      "text": "Pourquoi tu me regardes comme ça... ? Attends...\\nTu veux te battre contre moi ?[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001A"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "coach_gym_koori_cancel_00",
      "hash64": "283DD088E6A95068",
      "text": "Je préfère ça.[VAR 0x0114(001A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
