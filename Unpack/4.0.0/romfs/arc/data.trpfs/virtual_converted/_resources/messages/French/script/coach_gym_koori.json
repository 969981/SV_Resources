    {
      "ordinal": 50,
      "label": "coach_gym_koori_battleend_win_01_00",
      "hash64": "153AD09130971D6E",
      "text": "Il faut croire que tu aimes me voir perdre.[VAR 0x0114(001A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
