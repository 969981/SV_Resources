    {
      "ordinal": 44,
      "label": "ajito_doku_040_dokuboss_20",
      "hash64": "7EF04E5EC92D453B",
      "text": "吾等实际上并未见过真老大。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
