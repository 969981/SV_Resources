        }
      ]
    },
    {
      "ordinal": 57,
      "label": "ajito_doku_040_nelke_05",
      "hash64": "BD2F182F0598DBB3",
      "text": "我却丝毫没能察觉到这些事，\\n实在羞愧。[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
