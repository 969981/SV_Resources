      "label": "ajito_doku_040_student_11",
      "hash64": "E666FFEF86A5674E",
      "text": "[EMPTY 61]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
