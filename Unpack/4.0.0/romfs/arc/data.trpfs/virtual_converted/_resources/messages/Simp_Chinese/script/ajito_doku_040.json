        }
      ]
    },
    {
      "ordinal": 46,
      "label": "ajito_doku_040_dokuboss_21",
      "hash64": "7EF04D5EC92D4388",
      "text": "据其本人的说法，真老大一直窝在家中……\\n听说和吾等一样，此事源于霸凌……[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
