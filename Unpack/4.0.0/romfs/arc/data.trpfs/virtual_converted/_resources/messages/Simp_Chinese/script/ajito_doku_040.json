      "ordinal": 54,
      "label": "ajito_doku_040_dokuboss_24",
      "hash64": "7EF0525EC92D4C07",
      "text": "……不胜感激。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
