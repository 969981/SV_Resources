          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "ajito_doku_040_nelke_03",
      "hash64": "BD2F1E2F0598E5E5",
      "text": "霸凌……不上学……\\n距离真相又近了一步啊。\\r\\n不，比起这种事……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
