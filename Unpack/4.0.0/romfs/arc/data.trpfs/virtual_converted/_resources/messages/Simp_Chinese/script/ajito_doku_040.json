          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "ajito_doku_040_student_12",
      "hash64": "E666FEEF86A5659B",
      "text": "好可怜……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 48,
      "label": "ajito_doku_040_dokuboss_22",
      "hash64": "7EF0505EC92D48A1",
      "text": "虽然其真名与样貌都不为人知，\\n但不会改变吾等是一伙的事实。\\c\\n吾等要做的只是在基地\\n等待真老大的Come back！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "ajito_doku_040_student_13",
      "hash64": "E666FDEF86A563E8",
      "text": "所以秋明你才不去上学啊……",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 50,
      "label": "ajito_doku_040_student_14",
      "hash64": "E66704EF86A56FCD",
      "text": "……不过不要忘记！\\n秋明你除了天星队之外，\\r\\n还有我这个同胞！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "ajito_doku_040_dokuboss_23",
      "hash64": "7EF04F5EC92D46EE",
      "text": "同胞……[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
