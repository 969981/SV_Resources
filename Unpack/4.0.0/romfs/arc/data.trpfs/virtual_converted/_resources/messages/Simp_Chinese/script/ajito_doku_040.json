    },
    {
      "ordinal": 40,
      "label": "ajito_doku_040_dokuboss_18",
      "hash64": "7EE6445EC924DFB8",
      "text": "在真老大回归之前，\\n吾等只能持续守护基地，别无他选！[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
