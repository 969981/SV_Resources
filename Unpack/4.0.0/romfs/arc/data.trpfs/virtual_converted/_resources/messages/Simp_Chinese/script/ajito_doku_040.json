          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "ajito_doku_040_nelke_04",
      "hash64": "BD2F172F0598DA00",
      "text": "学生们面对的问题……\\n行动的理由……\\r\\n以及重要的牵绊……[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
