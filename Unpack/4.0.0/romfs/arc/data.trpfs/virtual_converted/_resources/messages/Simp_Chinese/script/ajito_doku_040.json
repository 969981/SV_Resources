          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "ajito_doku_040_student_09",
      "hash64": "E66373EF86A24393",
      "text": "让你们如此信赖的真老大\\n到底是什么人？[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
