      "label": "ajito_doku_040_dokuboss_26",
      "hash64": "7EF0545EC92D4F6D",
      "text": "……看来这可能是错的啊。[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
