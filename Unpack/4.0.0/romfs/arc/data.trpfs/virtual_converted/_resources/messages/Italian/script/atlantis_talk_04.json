    },
    {
      "ordinal": 20,
      "label": "atlantis_talk_04_rival_09",
      "hash64": "2F942C21E23C954C",
      "text": "Ehmmm... Tua madre invece è un tesoro,\\nvero [VAR 0x0100(0000)]?[VAR 0x0114(0004)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
