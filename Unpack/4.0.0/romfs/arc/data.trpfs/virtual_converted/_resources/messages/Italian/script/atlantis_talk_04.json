      "ordinal": 21,
      "label": "atlantis_talk_04_friend_05",
      "hash64": "0B6F543EBE970304",
      "text": "Ah, la conosci?[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
