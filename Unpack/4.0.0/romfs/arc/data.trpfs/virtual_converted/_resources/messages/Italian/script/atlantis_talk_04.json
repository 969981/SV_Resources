    {
      "ordinal": 0,
      "label": "atlantis_talk_04_friend_01",
      "hash64": "0B6F503EBE96FC38",
      "text": "I tuoi genitori invece come sono, Nemi?[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
