    {
      "ordinal": 5,
      "label": "sdc02_0085_sister_05",
      "hash64": "3A15467B04EB5700",
      "text": "Bref, qu’est-ce qu’on attend pour se voir ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
