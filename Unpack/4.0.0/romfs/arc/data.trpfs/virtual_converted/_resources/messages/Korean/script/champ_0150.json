      ]
    },
    {
      "ordinal": 16,
      "label": "champ_0150_chairman_10",
      "hash64": "C70C2AE1402044A1",
      "text": "저도 기대하고 있어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
