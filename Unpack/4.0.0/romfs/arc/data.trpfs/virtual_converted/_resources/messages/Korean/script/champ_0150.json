      ]
    },
    {
      "ordinal": 3,
      "label": "champ_0150_rival_07",
      "hash64": "7BBADA9943FE00BC",
      "text": "정말이야! 모든 체육관 제패!\\n고생 많았어~![VAR 0x0114(0004)]",
      "flags": 0,
