    },
    {
      "ordinal": 5,
      "label": "champ_0150_chairman_02",
      "hash64": "C708A6E1401D2E7E",
      "text": "맞아요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
