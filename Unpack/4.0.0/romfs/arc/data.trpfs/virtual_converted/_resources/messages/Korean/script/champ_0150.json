      ]
    },
    {
      "ordinal": 6,
      "label": "champ_0150_chairman_03",
      "hash64": "C708A7E1401D3031",
      "text": "체육관 배지 8개를\\n모두 모은 지금...[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
