    },
    {
      "ordinal": 2,
      "label": "champ_0150_chairman_01",
      "hash64": "C708A5E1401D2CCB",
      "text": "역시 [VAR 0x0100(0000)] 님이시네요.\\n눈부시게 멋진 시합이었어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
