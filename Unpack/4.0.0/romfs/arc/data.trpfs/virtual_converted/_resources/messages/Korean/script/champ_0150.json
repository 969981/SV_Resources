    },
    {
      "ordinal": 12,
      "label": "champ_0150_rival_06",
      "hash64": "7BBADB9943FE026F",
      "text": "그럼 힘내, [VAR 0x0100(0000)]!\\n나도 열심히 할 테니까!![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
