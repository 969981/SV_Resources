    },
    {
      "ordinal": 7,
      "label": "champ_0150_chairman_04",
      "hash64": "C708A8E1401D31E4",
      "text": "당신은 포켓몬리그에\\n도전할 자격을 얻으셨어요.[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
