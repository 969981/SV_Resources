      ]
    },
    {
      "ordinal": 10,
      "label": "champ_0150_rival_04",
      "hash64": "7BBADD9943FE05D5",
      "text": "빨리 챔피언이 돼서\\n챔피언끼리 승부하자! 응?[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
