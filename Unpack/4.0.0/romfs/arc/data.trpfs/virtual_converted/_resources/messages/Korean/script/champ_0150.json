          "kind": "control",
          "offset_units": 12,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0011"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "champ_0150_chairman_11",
      "hash64": "C70C29E1402042EE",
      "text": "그럼, 다음에는\\n테이블시티 북서쪽에 있는\\r\\n포켓몬리그에서 만나도록 해요.[VAR 0x0114(0011)]",
      "flags": 0,
