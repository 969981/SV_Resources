    {
      "ordinal": 2,
      "label": "legend_0020_friend_03",
      "hash64": "5E78459F7376CA98",
      "text": "This is one of the Herba Mystica! It’s exactly how\\nit looked in the book![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
