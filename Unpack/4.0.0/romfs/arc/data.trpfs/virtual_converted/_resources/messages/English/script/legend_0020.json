      "label": "legend_0020_legend_02",
      "hash64": "BD518E63D056F728",
      "text": "Grrrrrr...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "legend_0020_system_02",
      "hash64": "C9F0BC14F884A6A0",
      "text": "[VAR 0xBD06(0000)]Do you want to give your sandwich\\nto [VAR 0x0101(0001)]?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
