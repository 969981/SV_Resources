        }
      ]
    },
    {
      "ordinal": 26,
      "label": "legend_0020_legend_04",
      "hash64": "BD519463D057015A",
      "text": "*chomp chomp* *snarf* *chomp*",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "legend_0020_friend_12",
      "hash64": "5E75449F7374930E",
      "text": "Hey! I went through all the trouble of making\\nthat for you, and you just give it away?![VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "legend_0020_friend_13",
      "hash64": "5E75459F737494C1",
      "text": "I hope you realize that’s all there was, so now\\nthere’s none left for you...[VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "legend_0020_select_03",
      "hash64": "3539ECB8805E87D8",
      "text": "That’s totally fine!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "legend_0020_select_04",
      "hash64": "3539F3B8805E93BD",
      "text": "Wait, really...?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "legend_0020_friend_14a",
      "hash64": "F5DD15F12F1B05AF",
      "text": "Aw, come on! Now you’re making me feel like\\nI’m the selfish jerk here![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "legend_0020_friend_14b",
      "hash64": "F5DD16F12F1B0762",
      "text": "All right, all right! Don’t look at me like that![VAR 0x0114(0006)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
