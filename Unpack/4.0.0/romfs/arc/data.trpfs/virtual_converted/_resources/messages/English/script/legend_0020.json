          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "legend_0020_system_01",
      "hash64": "C9F0BF14F884ABB9",
      "text": "[VAR 0xBD06(0000)]You and Arven found the\\n[VAR 0xFF00(0008)][VAR 0x0109(0001)][VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
