      ]
    },
    {
      "ordinal": 22,
      "label": "legend_0020_select_01",
      "hash64": "3539EEB8805E8B3E",
      "text": "Here you go!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "legend_0020_select_02",
      "hash64": "3539EDB8805E898B",
      "text": "This is mine...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "legend_0020_legend_03",
      "hash64": "BD518F63D056F8DB",
      "text": "Giaaawn...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 25,
      "label": "legend_0020_system_03",
      "hash64": "C9F0BD14F884A853",
      "text": "[VAR 0xBD06(0000)]Maybe you want to give your sandwich to\\n[VAR 0x0101(0001)]\\r\\nafter all?",
      "flags": 0,
