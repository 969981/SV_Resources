          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "common_0210_rival_02",
      "hash64": "38E36667BE56E564",
      "text": "Das hier ist ein Pokémon-Center![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "common_0210_rival_03",
      "hash64": "38E36767BE56E717",
      "text": "Hier gibt es einige nützliche Dienste für\\nPokémon-Trainer.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0210_rival_04",
      "hash64": "38E36467BE56E1FE",
      "text": "Aber Sie können das sicher besser und genauer\\nerklären als ich.[VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "common_0210_pokecen_01",
      "hash64": "AD11B217AFBB942A",
      "text": "Mit Vergnügen! Willkommen beim\\nPokémon-Center!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "common_0210_pokecen_02",
      "hash64": "AD11B117AFBB9277",
      "text": "Ich kümmere mich darum, deine Pokémon wieder\\nfit zu machen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0210_pokecen_03",
      "hash64": "AD11B017AFBB90C4",
      "text": "An diesem Schalter hast du Zugriff auf die\\nTM-Maschine!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 7,
      "label": "common_0210_pokecen_04",
      "hash64": "AD11AF17AFBB8F11",
      "text": "Hier kannst du Technische Maschinen – kurz TMs –\\nherstellen.\\c\\nTMs werden verwendet, um deinen Pokémon\\nAttacken beizubringen.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "common_0210_pokecen_05",
      "hash64": "AD11AE17AFBB8D5E",
      "text": "Um eine TM herzustellen, benötigst du [VAR 0xFF00(0006)]LP[VAR 0xFF00(0000)]\\nsowie von Pokémon hinterlassene [VAR 0xFF00(0006)]Materialien[VAR 0xFF00(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 96,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0210_rival_10",
      "hash64": "38E6CE67BE59CBF3",
      "text": "LP sind meganützlich! Die kannst du an dieser\\nMaschine oder eben auch in Läden ausgeben.\\c\\nIch hab ’ne ganze Menge davon. Hier, ich geb\\ndir welche ab![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 151,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0210_rival_11",
      "hash64": "38E6CD67BE59CA40",
      "text": "Uuund die sind auch für dich![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0210_system_01",
      "hash64": "F7614DBDC1C939C0",
      "text": "Du erhältst einen Haufen [VAR 0xFF00(0008)]Pokémon-Materialien[VAR 0xFF00(0000)]\\nvon Nemila!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0008"
          ]
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0210_pokecen_06",
      "hash64": "AD11AD17AFBB8BAB",
      "text": "Direkt neben mir befindet sich der\\nPokémon-Supermarkt.\\c\\nDort kannst du alle möglichen Items erwerben,\\nzum Beispiel Pokébälle zum Fangen von Pokémon\\r\\noder auch Tränke.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 54,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
