        {
          "kind": "control",
          "offset_units": 149,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0210_shop_01",
      "hash64": "7B9566714708511F",
      "text": "Als Bezahlung für deine Einkäufe werden auch\\n[VAR 0xFF00(0006)]Ligapunkte[VAR 0xFF00(0000)], kurz [VAR 0xFF00(0006)]LP[VAR 0xFF00(0000)], akzeptiert.\\r\\n1 LP entspricht 1 .",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
