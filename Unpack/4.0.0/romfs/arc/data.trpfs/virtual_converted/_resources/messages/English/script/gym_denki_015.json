  "entries": [
    {
      "ordinal": 0,
      "label": "gym_denki_015_receptionist_01",
      "hash64": "6D0B8D6CEA518AD5",
      "text": "You’ll see what the Gym Test is all about once\\nyou go outside.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "gym_denki_015_denki_00",
      "hash64": "E12A2E57CA10DF5E",
      "text": "Ladies aaand gentlemens! It’s time for the\\nIono Zone![VAR 0x0114(002C)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
