          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "gym_denki_015_denki_09",
      "hash64": "E12A2757CA10D379",
      "text": "Say whaaat?! D’you guys know each other\\nor somethin’?[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 53,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "gym_denki_015_denki_17",
      "hash64": "E12DB157CA13F3CE",
      "text": "This here dude had a real aura about him when\\nhe was walkin’ down the street, so I snatched him\\r\\nup for my dealio here![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 121,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "gym_denki_015_head_teacher_02",
      "hash64": "3DA8B250A77FB08C",
      "text": "You are, er, too kind. Ha ha ha...[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "gym_denki_015_denki_18",
      "hash64": "E12DAC57CA13EB4F",
      "text": "Well anywho, [VAR 0x0100(0000)]!\\c\\nSince you’re today’s challenger, I’mma have you\\nplay hide-and-seek with Mr. Walksabout here![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 114,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_denki_015_denki_10",
      "hash64": "E12DB457CA13F8E7",
      "text": "Look for the good gentleman using the street\\nsurveillance cameras! Find ’im three times, and\\r\\nyou can consider this Gym Test passed![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_denki_015_denki_11",
      "hash64": "E12DB357CA13F734",
      "text": "We need a better name for this challenge,\\nthough! I’ll call it...\\c\\n“Where in Levincia Is Mr. Walksabout?”![VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_denki_015_denki_12",
      "hash64": "E12DB657CA13FC4D",
      "text": "Y’think that title’s safe? There’s nothing iffy\\nabout it or anything, right?[VAR 0x0114(0019)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "gym_denki_015_denki_13",
      "hash64": "E12DB557CA13FA9A",
      "text": "Eh, whatevs! I ’unno ’bout you, but I’m ready to\\ngo! Get ready to hide, Mr. Walksabout![VAR 0x0114(0019)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0019"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "gym_denki_015_head_teacher_03",
      "hash64": "3DA8B350A77FB23F",
      "text": "I feel that I owe the Pokémon League for many\\na past favor, so I am more than happy to help.\\c\\nDo bear with me as I try my best in my\\nallocated role.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
