          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "common_0190_rival_04",
      "hash64": "EB0E60ADCB0F7ACD",
      "text": "Ich freu mich schon total darauf, mit dir in einer\\nKlasse zu sein, [VAR 0x0100(0000)]![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
