      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 6,
      "label": "common_0190_rival_05a",
      "hash64": "78E60F500B4B6C01",
      "text": "Das wollte ich hören! Wir werden so viel lernen,\\nund so viel gegeneinander kämpfen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
