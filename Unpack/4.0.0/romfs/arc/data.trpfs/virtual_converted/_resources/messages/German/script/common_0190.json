        }
      ]
    },
    {
      "ordinal": 10,
      "label": "common_0190_rival_09",
      "hash64": "EB0E53ADCB0F64B6",
      "text": "Und in dieser herrlichen Natur leben SO viele\\nPokémon, die nur darauf warten, dir zu\\r\\nbegegnen![VAR 0x0114(0004)]",
