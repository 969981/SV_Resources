    {
      "ordinal": 2,
      "label": "common_0190_rival_03",
      "hash64": "EB0E59ADCB0F6EE8",
      "text": "Das große Gebäude mit dem Pokéball drauf\\nist die Akademie.[VAR 0x0114(0004)]",
