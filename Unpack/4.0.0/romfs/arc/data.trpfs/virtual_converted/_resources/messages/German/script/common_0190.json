          "args_hex": [
            "0004"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "common_0190_rival_08",
      "hash64": "EB0E54ADCB0F6669",
      "text": "Berge, saftig grüne Wiesen und dichte Wälder,\\nso weit das Auge reicht![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
