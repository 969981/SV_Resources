        }
      ]
    },
    {
      "ordinal": 7,
      "label": "common_0190_rival_05b",
      "hash64": "78E60C500B4B66E8",
      "text": "Hey, das ist die Gelegenheit, noch mehr über\\nPokémon-Kämpfe zu lernen![VAR 0x0114(0004)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
