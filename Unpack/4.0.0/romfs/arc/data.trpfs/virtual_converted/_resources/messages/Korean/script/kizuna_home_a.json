          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "kizuna_home_a_06",
      "hash64": "747FB85472A8FE20",
      "text": "이 가정실은\\n학생들의 쉼터 같은 곳이라,[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_home_a_07",
      "hash64": "747FB95472A8FFD3",
      "text": "다 같이 간식을 즐기면서\\n이야기꽃을 피우는 곳이기도 하지.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0029"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_home_a_08",
      "hash64": "747FC65472A915EA",
      "text": "자네가 요즘 워낙\\n화제의 중심이다 보니까\\r\\n나까지 흥미가 생기더군.[VAR 0x0114(0029)]",
