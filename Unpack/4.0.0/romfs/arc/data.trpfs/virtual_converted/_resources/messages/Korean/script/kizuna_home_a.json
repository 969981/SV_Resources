      ]
    },
    {
      "ordinal": 6,
      "label": "kizuna_home_a_05",
      "hash64": "747FBB5472A90339",
      "text": "당사자로서 조금 성가실 수도 있겠다만,\\n다들 그만큼 자네에게 관심이 많다는 거다.[VAR 0x0114(0029)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
