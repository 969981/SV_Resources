    {
      "ordinal": 42,
      "label": "coach_gym_nomal_battleend_win_00_01",
      "hash64": "5154FD629BEDA55D",
      "text": "You just keep getting stronger, don’t you?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
