    },
    {
      "ordinal": 43,
      "label": "coach_gym_nomal_battleend_win_00_02",
      "hash64": "5154FA629BEDA044",
      "text": "I imagine you worked up a sweat. Here, take\\nthese.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
