    {
      "ordinal": 47,
      "label": "coach_gym_nomal_battleend_win_01_01",
      "hash64": "254DF15C3A838C48",
      "text": "Now then, if you’ll excuse me...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
