    {
      "ordinal": 32,
      "label": "coach_gym_nomal_trade_02_02",
      "hash64": "20A14687C9DCFA1A",
      "text": "You can’t trade Larry such a rare Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 33,
      "label": "coach_gym_nomal_trade_02_03",
      "hash64": "20A14787C9DCFBCD",
      "text": "You can’t trade Larry a Shiny Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 34,
      "label": "coach_gym_nomal_trade_03_00",
      "hash64": "4B8BBA7C80D02E65",
      "text": "Ah, but no. I don’t think trading is a good idea if\\nyou’ve only got one Pokémon in your party...\\c\\nBetter to cut risks and trade when you have at\\nleast two.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
