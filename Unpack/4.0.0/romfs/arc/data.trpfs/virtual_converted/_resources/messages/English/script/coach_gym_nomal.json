  "entries": [
    {
      "ordinal": 0,
      "label": "coach_gym_nomal_first_00",
      "hash64": "42D22D0900D22469",
      "text": "Hello. I’m here on behalf of the Paldea region’s\\nPokémon League.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "coach_gym_nomal_first_01",
      "hash64": "42D22C0900D222B6",
      "text": "It’s a pleasure to be doing business with you.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "coach_gym_nomal_sp01_00",
      "hash64": "F68097F619D1735F",
      "text": "...Oh. It’s you.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 16,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "coach_gym_nomal_sp01_01",
      "hash64": "F68096F619D171AC",
      "text": "Calling me all the way out to another region...\\nIs a certain chairwoman rubbing off on you?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "coach_gym_nomal_sp01_02",
      "hash64": "F68099F619D176C5",
      "text": "Actually, don’t worry about it. To be honest,\\nI don’t mind these little business trips.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "coach_gym_nomal_sp01_03",
      "hash64": "F68098F619D17512",
      "text": "I know I’m here for work, but I may as well enjoy\\nmyself while I’m at it.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "coach_gym_nomal_sp01_04",
      "hash64": "F68093F619D16C93",
      "text": "Speaking of which, I’ve heard that Unova has two\\nparticularly famous dishes—Berry sandwiches and\\r\\nCasteliacones. Which one appeals to you more?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "coach_gym_nomal_sp01_select_01",
      "hash64": "508901898B20563B",
      "text": "Berry sandwiches",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "coach_gym_nomal_sp01_select_02",
      "hash64": "508902898B2057EE",
      "text": "Casteliacones",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "coach_gym_nomal_sp01_05",
      "hash64": "F68092F619D16AE0",
      "text": "Ah, I see. It figures you would be more interested\\nin the sandwiches.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "coach_gym_nomal_sp01_05b",
      "hash64": "ADE43A2DDED7FAE6",
      "text": "Ah, I see. I suppose you must have a sweet tooth.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "coach_gym_nomal_sp01_06",
      "hash64": "F68095F619D16FF9",
      "text": "Well, thanks for the input...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 29,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "coach_gym_nomal_sp01_07",
      "hash64": "F68094F619D16E46",
      "text": "Once I’m done with my lecture, I’ll step out and\\neat my fill.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 61,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "coach_gym_nomal_sp02_00",
      "hash64": "CA798DEFB8675DB0",
      "text": "Oh. You again.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "coach_gym_nomal_sp02_01",
      "hash64": "CA798EEFB8675F63",
      "text": "I tried out those Berry sandwiches we discussed.\\c\\nThey were pretty good, actually—a nice change\\nof pace from the usual Paldean sandwiches.\\c\\nStaraptor kept pecking at mine, though... I guess\\nthe Berries used in the sandwich filling must’ve\\r\\nbeen to its liking.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 140,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 242,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 265,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "coach_gym_nomal_sp02_01b",
      "hash64": "73ECE25657A66EB3",
      "text": "I tried out those Casteliacones we discussed.\\nThey were far more satisfying than I’d expected.\\c\\nThe texture was nice and fluffy, but the flavor was\\nso rich—almost decadent.\\c\\nThe Nacli Salt Ice Cream from Sugar-N-Ice back\\nin Paldea is hard to beat, but Casteliacones\\r\\ndefinitely come close, since they contain only\\r\\nthe finest ingredients...[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 174,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 269,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 319,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 348,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "coach_gym_nomal_sp02_02",
      "hash64": "CA798FEFB8676116",
      "text": "I’m sorry. I didn’t mean to go on like that.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "coach_gym_nomal_sp02_03",
      "hash64": "CA7990EFB86762C9",
      "text": "It’s just that the best part of traveling is trying out\\nall the local dishes, if you ask me.\\c\\nThe topic tends to make me talkative.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "coach_gym_nomal_sp02_04",
      "hash64": "CA7991EFB867647C",
      "text": "There’s something special about having nice,\\nfamiliar rice balls once you’re back home, too...[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "coach_gym_nomal_sp03_00",
      "hash64": "F3B1A3E46DEA10C1",
      "text": "By the way...\\c\\nHave you had a chance to visit the cafeteria here\\nat Blueberry Academy?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "coach_gym_nomal_sp03_01",
      "hash64": "F3B1A2E46DEA0F0E",
      "text": "It’s pretty nice, isn’t it?[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "coach_gym_nomal_sp03_01b",
      "hash64": "00E73626C4B83484",
      "text": "Is that so...? Well, it’s pretty nice.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "coach_gym_nomal_sp03_02",
      "hash64": "F3B1A1E46DEA0D5B",
      "text": "They season the food with a heavy hand—which\\nthe students here prefer, I suppose. But the sheer\\r\\nquantity is what’s truly noteworthy.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 135,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "coach_gym_nomal_sp03_03",
      "hash64": "F3B1A0E46DEA0BA8",
      "text": "The mountain of fries you get when you order the\\nAcademy Fries nearly made me dance.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "coach_gym_nomal_sp03_04",
      "hash64": "F3B1A7E46DEA178D",
      "text": "If you haven’t tried it for yourself, I would\\ndefinitely recommend it.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "coach_gym_nomal_trade_01_00",
      "hash64": "23FC6E8CF2B8BFC3",
      "text": "You know, I didn’t expect you to pay so much\\nattention to my ramblings.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "coach_gym_nomal_trade_01_01",
      "hash64": "23FC6D8CF2B8BE10",
      "text": "You really are a strange one, aren’t you.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "coach_gym_nomal_trade_01_02",
      "hash64": "23FC708CF2B8C329",
      "text": "Well, that suits me just fine. Maybe you’d even\\nbe interested in trading Pokémon with me?[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "coach_gym_nomal_trade_01_03",
      "hash64": "23FC6F8CF2B8C176",
      "text": "I’ll be putting up a Dudunsparce, but you can\\ntrade whatever Pokémon you feel like.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "coach_gym_nomal_trade_01_04",
      "hash64": "23FC728CF2B8C68F",
      "text": "[VAR 0xBD06(0000)][VAR 0x1303(0001,0000)][VAR 0x0101(0001)]... Interesting. This will be\\nfun\\r\\nto\\r\\nraise.\\r\\nThank you for the trade.[VAR 0x0114(0015)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
