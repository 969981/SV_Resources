    {
      "ordinal": 53,
      "label": "coach_gym_nomal_randomtalk_04",
      "hash64": "365666E3B8700300",
      "text": "How’s the Dudunsparce I traded you?\\c\\nHis Tera Type is Flying, so I suppose you could\\ncall him a “Dudunspairce”...\\c\\n... ... ...\\c\\n...Ahem.[VAR 0x0114(0015)]",
