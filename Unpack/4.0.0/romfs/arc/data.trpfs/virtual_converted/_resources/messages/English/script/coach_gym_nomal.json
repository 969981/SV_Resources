    {
      "ordinal": 36,
      "label": "coach_gym_nomal_trade_04_00",
      "hash64": "53EE80B6AA803C8E",
      "text": "Are you interested in resuming our trade talk?[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
