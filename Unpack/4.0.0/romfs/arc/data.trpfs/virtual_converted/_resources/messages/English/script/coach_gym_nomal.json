          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "coach_gym_nomal_randomtalk_00",
      "hash64": "36566AE3B87009CC",
      "text": "I admit, I think I did a good job coming up with\\nMedali’s Gym Test.\\c\\nHaving the challengers battle each other is a\\ngreat way to whittle down their numbers.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 157,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_gym_nomal_randomtalk_01",
      "hash64": "36566BE3B8700B7F",
      "text": "I hope La Primera isn’t giving you too much\\ntrouble.\\c\\nTake it from me—you need to say no to her if you\\ndon’t want to do something. Otherwise you’ll run\\r\\nyourself into the ground.[VAR 0x0114(0015)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 153,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 182,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0015"
