          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0310_botan_02",
      "hash64": "269F2BF8054588FF",
      "text": "Ich gebe dir jetzt mehr Informationen zur\\nOperation Stardust durch.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0310_botan_03",
      "hash64": "269F2AF80545874C",
      "text": "Team Star besteht aus fünf einzelnen Banden.\\nJede davon hat ihr eigenes Versteck.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0310_botan_04",
      "hash64": "269F29F805458599",
      "text": "Deine Aufgabe ist es, die fünf Bosse dieser\\nBanden zu besiegen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0310_botan_05",
      "hash64": "269F28F8054583E6",
      "text": "Wahrscheinlich werden sich dir Truppen von\\nRüpeln in den Weg stellen, aber du hast auch\\r\\nmeine Unterstützung. Aus sicherer Entfernung.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 136,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0310_botan_06",
      "hash64": "269F27F805458233",
      "text": "Die Bandenmitglieder bezeichnen sich alle mit\\ndem jeweiligen Pokémon-Typ, den ihr Boss\\r\\neinsetzt. Vielleicht hilft dir diese Information.\\c\\nIch habe vollstes Vertrauen in dich und dein\\nKönnen.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 139,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 195,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0310_botan_07",
      "hash64": "269F26F805458080",
      "text": "Lass mich außerdem die Orte, an denen du die\\neinzelnen Verstecke findest, auf deiner Karte\\r\\nmarkieren.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 104,
          "count": 2,
