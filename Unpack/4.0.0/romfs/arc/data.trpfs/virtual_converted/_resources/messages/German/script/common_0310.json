    {
      "ordinal": 12,
      "label": "common_0310_botan_01",
      "hash64": "269F2CF805458AB2",
      "text": "Hallo, [VAR 0x0100(0000)]. Cassiopeia hier.[VAR 0x0114(0009)]",
