          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_0310_botan_08",
      "hash64": "269F35F8054599FD",
      "text": "Für jeden Boss, den du besiegst, wartet eine\\ngroßzügige Belohnung auf dich.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0310_rival_07",
      "hash64": "F9E349BA4983748E",
      "text": "Hä? Wer bist du denn jetzt plötzlich?!\\c\\nTeam Star macht nichts als Ärger und seine\\nMitglieder sind schlicht und einfach gefährlich!\\c\\n[VAR 0x0100(0000)] sollte sich da am besten\\nvollkommen raushalten![VAR 0x0114(0004)]",
