          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "gym_normal_010_receptionist_12",
      "hash64": "FE3287D32F253964",
      "text": "Chiedi a qualche cliente abituale dell’Oro in\\nBocca, potresti scoprire qualcosa!",
