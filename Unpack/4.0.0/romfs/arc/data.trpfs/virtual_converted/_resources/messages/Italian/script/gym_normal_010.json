    {
      "ordinal": 2,
      "label": "gym_normal_010_receptionist_01",
      "hash64": "FE35EED32F281E40",
      "text": "Benvenut[VAR 0x1100(00FF,0101)]oa alla Palestra di Mesturia!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "gym_normal_010_receptionist_02",
      "hash64": "FE35F1D32F282359",
      "text": "Lascia che inserisca il tuo nome nel registro\\ndegli sfidanti...\\c\\nTi chiami [VAR 0x0100(0000)], giusto?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 77,
