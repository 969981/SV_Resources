          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "gym_normal_010_receptionist_03",
      "hash64": "FE35F0D32F2821A6",
      "text": "Per affrontare il Capopalestra Ubaldo dovrai\\nsuperare l’Esame della Palestra.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "gym_normal_010_receptionist_04",
      "hash64": "FE35F3D32F2826BF",
      "text": "E l’Esame della Palestra di Mesturia è...\\n[VAR 0xFF00(0006)]ordinare un menu segreto[VAR 0xFF00(0000)]!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_normal_010_receptionist_05",
      "hash64": "FE35F2D32F28250C",
      "text": "Per essere promoss[VAR 0x1100(00FF,0101)]oa, dovrai ordinare il menu\\nsegreto di un famoso ristorante della città:\\r\\nl’[VAR 0xFF00(0006)]Oro in Bocca[VAR 0xFF00(0000)].",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 95,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 117,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_normal_010_receptionist_06",
      "hash64": "FE35F5D32F282A25",
      "text": "Ci sono altri tre sfidanti in giro per la città,\\noltre a te.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 8,
      "label": "gym_normal_010_receptionist_07",
      "hash64": "FE35F4D32F282872",
      "text": "Ciascun partecipante conosce un indizio diverso\\nsul menu segreto.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 9,
      "label": "gym_normal_010_receptionist_08",
      "hash64": "FE35F7D32F282D8B",
      "text": "Gli sfidanti dovranno lottare tra di loro e chi\\nperde dovrà rivelare il proprio indizio a chi vince.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 10,
      "label": "gym_normal_010_receptionist_09",
      "hash64": "FE35F6D32F282BD8",
      "text": "Basandosi sugli indizi ottenuti, bisognerà poi\\nandare all’Oro in Bocca e ordinare i piatti\\r\\ndel menu segreto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "gym_normal_010_receptionist_10",
      "hash64": "FE3289D32F253CCA",
      "text": "Solo il primo sfidante che riuscirà a ordinare\\nsarà promosso.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_normal_010_receptionist_11",
      "hash64": "FE328AD32F253E7D",
      "text": "Allora, [VAR 0x0100(0000)], il tuo indizio è...\\n[VAR 0xFF00(0006)]ai clienti abituali piace così[VAR 0xFF00(0000)]!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
