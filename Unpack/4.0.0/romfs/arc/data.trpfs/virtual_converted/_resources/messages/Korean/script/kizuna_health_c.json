      "label": "kizuna_health_c_12",
      "hash64": "D7BCFB747938A684",
      "text": "그러니까...\\n조금은 고맙다고 해야 하나...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
