      "hash64": "D7BCFE747938AB9D",
      "text": "...아주 조금은\\n영향이 있었을지도 모르지만![VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
