            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "kizuna_health_c_03",
      "hash64": "D7C06474793B8EC6",
      "text": "내게 볼일 있니?[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
