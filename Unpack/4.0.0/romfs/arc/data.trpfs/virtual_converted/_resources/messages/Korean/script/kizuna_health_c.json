    {
      "ordinal": 1,
      "label": "kizuna_health_c_02",
      "hash64": "D7C06574793B9079",
      "text": "미안, 잠깐 보건실을 비울 일이 있어서~[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
