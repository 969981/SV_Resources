      ]
    },
    {
      "ordinal": 8,
      "label": "kizuna_health_c_08",
      "hash64": "D7C06B74793B9AAB",
      "text": "아하하, 그게~\\n잠깐 공부하고 있었거든.[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "kizuna_health_c_09",
      "hash64": "D7C06A74793B98F8",
      "text": "한 번 더 보건 교사 시험에\\n도전해 볼까 해서 말이야...[VAR 0x0114(0028)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0028"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "kizuna_health_c_select_01",
      "hash64": "304EA00F209B76BF",
      "text": "굉장해요!",
      "flags": 0,
      "text_status": "DECODED",
