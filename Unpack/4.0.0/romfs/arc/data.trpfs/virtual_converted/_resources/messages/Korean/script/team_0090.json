      "ordinal": 33,
      "label": "team_0090_cassiopeia_17",
      "hash64": "4099476F6577761B",
      "text": "그 때문에 단원들은 주위로부터\\n나쁜 인상을 받게 되었다.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
