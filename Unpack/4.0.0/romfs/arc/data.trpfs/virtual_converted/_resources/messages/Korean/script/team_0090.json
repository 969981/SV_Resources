          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "team_0090_cassiopeia_16",
      "hash64": "4099466F65777468",
      "text": "그들은 스타단을 두려워한 나머지\\n차례차례 학교를 그만두었고...[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
