    },
    {
      "ordinal": 2,
      "label": "common_2020_mushi_020_mushi_03",
      "hash64": "83DEAD0936B4C5CC",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0001)]\\n우리 체육관이 몇 번째였어~?[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
