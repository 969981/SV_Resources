    },
    {
      "ordinal": 3,
      "label": "common_2020_mushi_020_mushi_04",
      "hash64": "83DEAC0936B4C419",
      "text": "세르클체육관이 학교에서 가까워서 그런지\\n첫 번째 체육관으로 고르는 트레이너가\\r\\n많이 있거든~[VAR 0x0114(0016)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
