      "ordinal": 15,
      "label": "s1_sub_001_ecology_13",
      "hash64": "452CDC139DA447C8",
      "text": "鏘鏘鏘鏘～！[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
