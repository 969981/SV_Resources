      ]
    },
    {
      "ordinal": 5,
      "label": "s1_sub_001_ecology_03",
      "hash64": "45295C139DA13871",
      "text": "然後我還順便在調查\\n北上的寶可夢……[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
