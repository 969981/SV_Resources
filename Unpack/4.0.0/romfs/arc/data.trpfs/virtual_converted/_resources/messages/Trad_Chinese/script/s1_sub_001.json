          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_sub_001_ecology_08",
      "hash64": "452951139DA125C0",
      "text": "來，三明治也給[VAR 0x1100(00FF,0101)]你妳～\\n請享用吧～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
