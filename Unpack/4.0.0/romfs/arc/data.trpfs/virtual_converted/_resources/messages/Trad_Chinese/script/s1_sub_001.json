          "args_hex": [
            "002A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_sub_001_ecology_05",
      "hash64": "45295E139DA13BD7",
      "text": "我太過專注在調查，\\n完全忘記要去找[VAR 0x1100(00FF,0101)]你妳了～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 17,
          "count": 3,
