      ]
    },
    {
      "ordinal": 11,
      "label": "s1_sub_001_ecology_09",
      "hash64": "452952139DA12773",
      "text": "……雖然形狀很奇怪，\\n但我保證它一定好吃喔～[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
