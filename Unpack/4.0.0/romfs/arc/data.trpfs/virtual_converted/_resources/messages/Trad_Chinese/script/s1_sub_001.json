          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_sub_001_ecology_12",
      "hash64": "452CDD139DA4497B",
      "text": "……哦？\\n是不是有什麼在野餐籃裡面？[VAR 0x0114(002A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002A"
