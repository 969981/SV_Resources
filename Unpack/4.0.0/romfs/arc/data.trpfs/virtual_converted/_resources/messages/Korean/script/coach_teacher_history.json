  "entries": [
    {
      "ordinal": 0,
      "label": "coach_teacher_history_first_00",
      "hash64": "F3ABE90DE7EBE8BF",
      "text": "이 건물...\\n새로운 것의 냄새가 물씬 풍기는군...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
