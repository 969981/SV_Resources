          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_teacher_history_trade_01_04",
      "hash64": "3D5AFCBE8D788735",
      "text": "흠, 만족스러운 교환이었어.\\c\\n너의 [VAR 0x0101(0001)]...\\n내가 실컷 귀여워해 줄게.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
