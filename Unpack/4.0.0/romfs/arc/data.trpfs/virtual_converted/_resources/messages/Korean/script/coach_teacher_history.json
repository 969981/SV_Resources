          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "coach_teacher_history_battleend_win_00_01",
      "hash64": "1473B53FE834AB4B",
      "text": "이 강함... 이용할 수만 있다면\\n언젠가 이런저런 유적이나 무덤들을\\r\\n원하는 만큼 조사할 수 있을지도...!?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 48,
      "label": "coach_teacher_history_battleend_win_00_02",
      "hash64": "1473B63FE834ACFE",
      "text": "좋아...\\n어울려 준 보답을 주겠어.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 49,
      "label": "coach_teacher_history_battleend_win_00_03",
      "hash64": "1473B73FE834AEB1",
      "text": "매우 가치가 높은 거니까\\n매일 밤, 이 레포르 선생님에게\\r\\n감사를 올리며 감상하라고.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 50,
      "label": "coach_teacher_history_reward_00",
      "hash64": "129A8A4084F2402C",
      "text": "[EMPTY 59]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
