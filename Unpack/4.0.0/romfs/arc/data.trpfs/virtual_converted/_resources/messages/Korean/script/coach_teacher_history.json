          "code_hex": "BDFF",
          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 46,
      "label": "coach_teacher_history_battleend_win_00_00",
      "hash64": "1473B43FE834A998",
      "text": "...꽤나 강한걸?\\n여태까지 걸어온 길이 왕도였던 모양이야.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
