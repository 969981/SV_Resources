          "args_hex": [
            "003B"
          ]
        }
      ]
    },
    {
      "ordinal": 51,
      "label": "coach_teacher_history_battleend_win_01_00",
      "hash64": "6950EA35D8CC6D29",
      "text": "크크큭, 너의 그 강함,\\n역시 유용해 보여...\\c\\n이번에도 뇌물...이 아니라\\n보답을 주겠어.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 52,
      "label": "coach_teacher_history_battleend_win_01_01",
      "hash64": "6950E935D8CC6B76",
      "text": "이 레포르 선생님과 쌓아 올린 역사가\\n무엇과도 바꿀 수 없는 보물이 되면 좋겠군.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 53,
      "label": "coach_teacher_history_battleend_lose_00_00",
      "hash64": "DED7809B5C71604B",
      "text": "힘을 가지고 있어도 교만에 빠지면\\n허를 찔려서 패배한다...\\c\\n역사적인 역전극을\\n몸소 재현하고 싶었던 거야?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 54,
      "label": "coach_teacher_history_randomtalk_00",
      "hash64": "1E5F9A87D3C01CCA",
      "text": "재앙의 보물들은 잘 다루고 있어?\\c\\n놓아주고 싶어지거든\\n언제든 말만 하라고.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 44,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 55,
      "label": "coach_teacher_history_randomtalk_01",
      "hash64": "1E5F9B87D3C01E7D",
      "text": "너, 팔데아의 대공에\\n들어갔었다던데, 진짜야?\\c\\n그게 사실이라면 자료 수집을 위해\\n며칠간 신병을 확보해야겠군...[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 56,
      "label": "coach_teacher_history_randomtalk_02",
      "hash64": "1E5F9887D3C01964",
      "text": "테라리움 돔은 확실히\\n대단한 기술력의 산물이야...\\c\\n하지만, 역사가 없는 왜곡된 자연이라\\n개인적으로는 흥미가 안 생기더군.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 57,
      "label": "coach_teacher_history_randomtalk_03",
      "hash64": "1E5F9987D3C01B17",
      "text": "네가 준 [VAR 0x0101(0001)][VAR 0x1900(0001)]\\n꽤나 유용한 녀석이야.\\r\\n유적 조사에 많은 도움이 되고 있다고.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 2,
          "code_hex": "0101",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 9,
          "count": 2,
          "code_hex": "1900",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 51,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0027"
          ]
        }
      ]
    },
    {
      "ordinal": 58,
      "label": "coach_teacher_history_randomtalk_04",
      "hash64": "1E5F9687D3C015FE",
      "text": "나는 오래된 물건을 모으는 게\\n취미인데 말이야.\\c\\n너에게 준 모으령이\\n오래된 동전을 계속 탐내서 곤란했었어.[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
