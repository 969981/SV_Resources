    {
      "ordinal": 35,
      "label": "coach_teacher_history_trade_02_00",
      "hash64": "6C30F6D69AC9F8B6",
      "text": "너의 [VAR 0x0101(0001)][VAR 0x1900(0004)]\\n내 모으령을 교환하는 거지?[VAR 0x0114(0027)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
