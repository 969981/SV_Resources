        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0300_sister_03",
      "hash64": "0E4A0EC22ADDB1C3",
      "text": "Les rochers dans l’eau brillent de mille feux !\\nC’est super mystérieux, tu trouves pas ?\\c\\nD’ailleurs, y a une rumeur comme quoi\\non pourrait rencontrer les âmes des morts, ici...[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
