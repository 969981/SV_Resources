      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "sdc01_0300_sister_09",
      "hash64": "0E4A18C22ADDC2C1",
      "text": "Fiou... J’étais pas prête à ce qu’il débarque\\ncomme ça ![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
