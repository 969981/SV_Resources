          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "sdc01_0300_sister_16",
      "hash64": "0E4D13C22ADFF019",
      "text": "... Mais qu’est-ce que vous faites ici, au juste ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0300_bbteacher_05",
      "hash64": "5F88B8BD7C65CDC1",
      "text": "De petites recherches. J’étais très intéressée par\\nles propriétés de l’eau du Lac Cristallin, vois-tu ?[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0300_bbteacher_06",
      "hash64": "5F88B5BD7C65C8A8",
      "text": "Et je dois avouer que je ne suis pas déçue\\ndu résultat ![VAR 0x0114(0042)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0300_bbteacher_07",
      "hash64": "5F88B6BD7C65CA5B",
      "text": "J’ignore pourquoi, mais la longueur d’onde\\némise par cette eau est identique à celle de\\r\\nl’énergie Téracristal ![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
