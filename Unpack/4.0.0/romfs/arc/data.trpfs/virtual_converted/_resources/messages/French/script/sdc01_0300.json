    },
    {
      "ordinal": 15,
      "label": "sdc01_0300_sister_12",
      "hash64": "0E4D17C22ADFF6E5",
      "text": "Hé, regarde ! Ce serait pas... ?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
