          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s2_side02_0030_camera_a1_01",
      "hash64": "69708D0BD9114DBF",
      "text": "진짜 꿰뚫는화염이잖아!\\n...머리 형태가 굉장한걸![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s2_side02_0030_camera_a1_02",
      "hash64": "69708E0BD9114F72",
      "text": "소문에 의하면 그 아이가 울부짖기만 해도\\n대지에서 마그마가 솟아난대![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s2_side02_0030_camera_b1_01",
      "hash64": "BA432C630EB91432",
      "text": "진짜 무쇠암석이잖아!\\n다...... 단단해 보이는걸!![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s2_side02_0030_camera_b1_02",
      "hash64": "BA432B630EB9127F",
      "text": "소문에 의하면 그 아이는 에너지를 모은\\n머리로 무엇이든 쓰러뜨릴 수 있대![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s2_side02_0030_camera_a2_01",
      "hash64": "950B15123A1F67A8",
      "text": "진짜 날뛰는우레잖아!\\n목이... 목이 엄청난걸!\\r\\n사진에 담아내기 힘들 것 같아!![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s2_side02_0030_camera_a2_02",
      "hash64": "950B18123A1F6CC1",
      "text": "소문에 의하면 그 아이가 목을 휘두르면\\n먹구름이 하늘을 뒤덮고 벼락이 마구 친대![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s2_side02_0030_camera_b2_01",
      "hash64": "67C8EC7EC9AD97C5",
      "text": "진짜 무쇠감투잖아!\\n굉장해... 엄청 반들반들해![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s2_side02_0030_camera_b2_02",
      "hash64": "67C8E97EC9AD92AC",
      "text": "소문에 의하면 그 아이는 머리의 뿔에서\\n빔을 발사해서 무엇이든 베어 버릴 수 있대![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s2_side02_0030_camera_05",
      "hash64": "9180A9077DC99FDA",
      "text": "아하하! 사실이라면 정말 큰일이겠는걸!\\n일단 사진을 한 장...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s2_side02_0030_camera_06",
      "hash64": "9180A8077DC99E27",
      "text": "나머지 한 마리도 있을지도 모르겠어!\\n다음 소식도 기대하고 있을게![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s2_side02_0030_camera_07",
      "hash64": "9180A7077DC99C74",
      "text": "두 마리 모두 발견했구나!\\n역시 [VAR 0x0100(0000)][VAR 0x1900(0001)] 대단하다니까![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 2,
          "code_hex": "1900",
          "args_hex": [
            "0001"
          ]
        },
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s2_side02_0030_camera_08",
      "hash64": "91809E077DC98D29",
      "text": "사실 이 수수께끼의 사진이 신경 쓰여서\\n일에 집중이 안 되고 있었는데\\r\\n덕분에 마음이 편해졌어.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s2_side02_0030_camera_09",
      "hash64": "91809D077DC98B76",
      "text": "약속한 적은 없지만\\n마음을 편하게 해 준 보답이야!\\r\\n이번에도 나름 신경 써서 준비했다구![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s2_side02_0030_camera_10",
      "hash64": "917D20077DC68138",
      "text": "정말이지 세상에는 아직\\n모르는 일이 많은 것 같아.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s2_side02_0030_camera_11",
      "hash64": "917D21077DC682EB",
      "text": "어른이 되면 어릴 때처럼\\n전력으로 달릴 수 없게 되니까[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s2_side02_0030_camera_12",
      "hash64": "917D22077DC6849E",
      "text": "[VAR 0x0100(0000)][VAR 0x1900(0003)] 내 몫까지\\n본 적 없는 포켓몬을 찾아서\\r\\n모험을 즐겨 줬으면 좋겠어.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 4,
          "count": 2,
          "code_hex": "1900",
          "args_hex": [
            "0003"
          ]
        },
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s2_side02_0030_camera_13",
      "hash64": "917D23077DC68651",
      "text": "...자, 그럼!\\n이제 다시 일을 시작해 볼까![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s2_side02_0030_camera_npc_01",
      "hash64": "A487FFC5BD0B7C06",
      "text": "요즘 카메라 앱의 기능이\\n많이 늘어난 것 같지 않아!?\\c\\n사진가니까 필터 같은 걸\\n능숙하게 쓸 수 있어야 좀 멋지려나?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s2_side02_0030_camera_npc_02",
      "hash64": "A487FEC5BD0B7A53",
      "text": "가끔은 가디한테도\\n말을 걸어 줘.\\c\\n너의 냄새를 기억할 정도로\\n마음에 들어 하는 모양이니까 말이야![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 18,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 57,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s2_side02_0030_camera_npc_03",
      "hash64": "A487FDC5BD0B78A0",
      "text": "테라리움 돔은 굉장해!\\n바닷속에 있다는 게 믿어지지 않을 정도야.\\c\\n설산에서 조금만 걸어가면 열대 지역이라니\\n사진 소재로 넘쳐 난다니까![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 36,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 78,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
