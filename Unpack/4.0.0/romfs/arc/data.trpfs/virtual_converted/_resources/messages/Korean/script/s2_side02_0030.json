      ]
    },
    {
      "ordinal": 6,
      "label": "s2_side02_0030_camera_04",
      "hash64": "9180AA077DC9A18D",
      "text": "어라? [VAR 0x0100(0000)],\\n그 포켓몬은... 사진 속의 그...!?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 4,
