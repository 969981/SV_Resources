    {
      "ordinal": 3,
      "label": "sub_047_picnicnpc_addrecipe_02",
      "hash64": "137D7E3A756A2C1A",
      "text": "[VAR 0x0100(0000)]\\n可以製作新的大師等級三明治了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
