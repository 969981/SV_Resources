        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sub_047_picnicnpc_01_03",
      "hash64": "BCFAFA19AC13B22B",
      "text": "這可是好吃到下巴都要掉下來，\\n記得做做看喔！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 5,
      "label": "sub_047_picnicnpc_01_04",
      "hash64": "BCFAFF19AC13BAAA",
      "text": "我要是想到了新食譜，\\n再跟[VAR 0x1100(00FF,0101)]你妳分享啊！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 13,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sub_047_picnicnpc_02_01",
      "hash64": "63C63C0064C28F1E",
      "text": "……哦，是[VAR 0x1100(00FF,0101)]你妳啊！\\n我想到新食譜囉！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sub_047_picnicnpc_03_01",
      "hash64": "B9BEE807FFCF4AB3",
      "text": "……哦，是[VAR 0x1100(00FF,0101)]你妳啊！\\c\\n我正在研發的食譜，\\n需要很稀有的調味料。\\c\\n那些調味料叫秘傳什麼的，\\n總共有５種……\\c\\n要是我能至少看到那些調味料一眼，\\n或許就能靈光一閃想出新食譜了。",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 5,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
