          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sub_047_picnicnpc_03_03",
      "hash64": "B9BEEA07FFCF4E19",
      "text": "[VAR 0x1100(00FF,0101)]你妳拿著的那、那個是！\\n不就是秘傳什麼的嗎！？\\r\\n嗚嗚……啊、啊啊……\\r\\n食譜浮現在我腦海了！？",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
