    },
    {
      "ordinal": 2,
      "label": "sub_047_picnicnpc_addrecipe_01",
      "hash64": "137D7D3A756A2A67",
      "text": "[VAR 0x0100(0000)]\\n可以製作新的三明治了！",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
