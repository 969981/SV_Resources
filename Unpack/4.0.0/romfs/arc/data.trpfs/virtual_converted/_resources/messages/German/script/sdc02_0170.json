      ]
    },
    {
      "ordinal": 25,
      "label": "sdc02_0170_dragonbb_14",
      "hash64": "33EB61F1D25717FC",
      "text": "Du bist ja richtig versessen auf [VAR 0x0100(0000)].[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
