          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc02_0170_dragonbb_02",
      "hash64": "33EEE1F1D25A2753",
      "text": "Sorry, dass du warten musstest. Da bin ich wieder.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc02_0170_dragonbb_03",
      "hash64": "33EEE0F1D25A25A0",
      "text": "Das war’s! Du hast die Top Vier der\\nBlaubeer-Liga besiegt![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0170_dragonbb_a_01",
      "hash64": "51F5E05D5F890E12",
      "text": "Matt is’ nich’ gerade schwach.\\nNur etwas einfach gestrickt.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0170_dragonbb_a_02",
      "hash64": "51F5DF5D5F890C5F",
      "text": "Aber das mag ich an ihm.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0170_dragonbb_a_03",
      "hash64": "51F5DE5D5F890AAC",
      "text": "Nach der AG saßen wir früher immer zusammen\\nund haben seine Kochkreationen verputzt.\\r\\nDas waren noch Zeiten...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 112,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0170_dragonbb_a_04",
      "hash64": "51F5DD5D5F8908F9",
      "text": "Selbst ihm scheint die momentane Situation\\nzu schaffen zu machen.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0170_dragonbb_b_01",
      "hash64": "AC70A076A7EEF725",
      "text": "Erin hinterlässt ’nen bleibenden Eindruck, was?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc02_0170_dragonbb_b_02",
      "hash64": "AC709D76A7EEF20C",
      "text": "Sie und Hana scheinen sich überraschend gut\\nzu verstehen.\\c\\nDen beiden beim Quatschen zuzusehen,\\nhat echten Unterhaltungswert, hehe![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 57,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 133,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0170_dragonbb_b_03",
      "hash64": "AC709E76A7EEF3BF",
      "text": "Erin kommt immer so ernst und spießig rüber,\\ndabei is’ sie in Wirklichkeit sehr sensibel.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc02_0170_dragonbb_b_04",
      "hash64": "AC709B76A7EEEEA6",
      "text": "Sie wird schnell missverstanden, aber du weißt ja\\njetz’, was Sache is’, [VAR 0x0100(0000)].[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 77,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc02_0170_dragonbb_c_01",
      "hash64": "D5A8946B5D717070",
      "text": "Tara liebt einfach alles, was niedlich aussieht,\\nund gerade das scheint der Grund dafür zu sein,\\r\\ndass ihre Pokémon so stark sind.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 96,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 132,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0170_dragonbb_c_02",
      "hash64": "D5A8976B5D717589",
      "text": "Sie is’ so vernarrt in ihr Team, dass sich das\\nTraining für sie gar nich’ wie Arbeit anfühlt.\\r\\nSchon krass.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0170_dragonbb_c_03",
      "hash64": "D5A8966B5D7173D6",
      "text": "Aber das scheint bei dir ja ähnlich zu sein, oder?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0170_dragonbb_c_04",
      "hash64": "D5A8996B5D7178EF",
      "text": "Davon sollte sich ein gewisser Jemand, der sich\\nund andere opfert, nur um stärker zu werden,\\r\\nmal eine Scheibe abschneiden![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 92,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc02_0170_dragonbb_c_05",
      "hash64": "D5A8986B5D71773C",
      "text": "Is’ dir übrigens aufgefallen, dass Tara zu allen\\nhöflich is’, nur nich’ zu mir? Frag mich, warum...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc02_0170_dragonbb_d_01",
      "hash64": "832E54871865F403",
      "text": "Dafür kriegste natürlich auch die versprochene\\nBelohnung. Hier![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "sdc02_0170_dragonbb_d_02",
      "hash64": "832E55871865F5B6",
      "text": "Das bisschen Staub stört dich doch nich’, oder?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc02_0170_dragonbb_04",
      "hash64": "33EEE7F1D25A3185",
      "text": "Du hast dich echt in kürzester Zeit in der\\nBlaubeer-Liga nach oben katapultiert.\\r\\nBin mächtig beeindruckt![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 80,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 108,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc02_0170_dragonbb_05",
      "hash64": "33EEE6F1D25A2FD2",
      "text": "Jetzt musst du’s auch bis zur Spitze durchziehen,\\noder, [VAR 0x1100(00FF,0403,0000)]BroGirl?[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
