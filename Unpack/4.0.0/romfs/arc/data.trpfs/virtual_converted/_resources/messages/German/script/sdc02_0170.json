      ]
    },
    {
      "ordinal": 33,
      "label": "sdc02_0170_brother_09",
      "hash64": "74710C96DFA78F97",
      "text": "Ich warte oben auf dich.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
