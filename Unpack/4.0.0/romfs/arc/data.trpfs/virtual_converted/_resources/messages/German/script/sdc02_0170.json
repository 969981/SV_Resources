    {
      "ordinal": 22,
      "label": "sdc02_0170_brother_01",
      "hash64": "74710496DFA781FF",
      "text": "Na endlich. Ich warte schon ewig.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 33,
