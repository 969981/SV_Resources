          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "sdc02_0170_brother_04",
      "hash64": "7470FF96DFA77980",
      "text": "So fleißig, wie du [VAR 0x1100(00FF,0303,0000)]ihnsie unterstützt.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 4,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0303",
