      ]
    },
    {
      "ordinal": 29,
      "label": "sdc02_0170_brother_05",
      "hash64": "74710096DFA77B33",
      "text": "Von wegen...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
