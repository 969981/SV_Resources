    {
      "ordinal": 0,
      "label": "sdc02_0170_dragonbb_01",
      "hash64": "33EEE2F1D25A2906",
      "text": "Yo, zukünftiger Champ![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
