    },
    {
      "ordinal": 34,
      "label": "sdc02_0170_dragonbb_16",
      "hash64": "33EB63F1D2571B62",
      "text": "Endlich ist es so weit. Ich bin gespannt![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
