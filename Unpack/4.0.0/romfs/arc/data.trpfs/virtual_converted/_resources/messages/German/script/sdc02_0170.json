      "ordinal": 24,
      "label": "sdc02_0170_dragonbb_13",
      "hash64": "33EB60F1D2571649",
      "text": "Sag mal, Jo...[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
