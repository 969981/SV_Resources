          "args_hex": [
            "004A"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc02_0170_dragonbb_07",
      "hash64": "33EEE4F1D25A2C6C",
      "text": "...darf den aktuellen Champ, Jo, herausfordern![VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
