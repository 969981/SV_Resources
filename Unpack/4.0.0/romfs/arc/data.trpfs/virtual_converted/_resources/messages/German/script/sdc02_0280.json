      "hash64": "A7F742278832FFE1",
      "text": "Was ist das denn für ein seltsamer Ort...?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
