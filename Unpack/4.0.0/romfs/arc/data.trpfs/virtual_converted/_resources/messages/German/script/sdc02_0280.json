      ]
    },
    {
      "ordinal": 9,
      "label": "sdc02_0280_brother_05",
      "hash64": "0E2F78867BEA2279",
      "text": "Halt dich da raus, Hana![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
