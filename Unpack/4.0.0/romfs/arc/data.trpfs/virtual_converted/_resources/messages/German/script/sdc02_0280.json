    },
    {
      "ordinal": 2,
      "label": "sdc02_0280_brother_01",
      "hash64": "0E2F7C867BEA2945",
      "text": "Der Schatz... Wo ist er?![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc02_0280_bbteacher_01",
      "hash64": "274107330CE82975",
      "text": "Jo, schau mal! Da hinten bei den Säulen ist etwas![VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc02_0280_brother_02",
      "hash64": "0E2F79867BEA242C",
      "text": "Dieser Stein soll der Schatz sein...?[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 37,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc02_0280_bbteacher_02",
      "hash64": "274104330CE8245C",
      "text": "Lass mich das überprüfen. Einen Moment...[VAR 0x0114(0042)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0042"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc02_0280_brother_03",
      "hash64": "0E2F7A867BEA25DF",
      "text": "Wenn ich an den Schatz von Zone Null komme...[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc02_0280_brother_04",
      "hash64": "0E2F77867BEA20C6",
      "text": "...bin ich dir endlich mal in einer Sache voraus,\\n[VAR 0x0100(0000)]![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
