      "label": "sdc02_0280_brother_13",
      "hash64": "0E3302867BED42CE",
      "text": "Mir bleibt nur noch... das hier![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
