      ]
    },
    {
      "ordinal": 13,
      "label": "sdc02_0280_sister_04",
      "hash64": "A7F74527883304FA",
      "text": "Aber du hast dich doch auch super\\ngeschlagen, Jo![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
