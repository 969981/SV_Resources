    {
      "ordinal": 17,
      "label": "sdc02_0280_brother_11",
      "hash64": "0E3300867BED3F68",
      "text": "Und ich... Ich hab nichts.[VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
