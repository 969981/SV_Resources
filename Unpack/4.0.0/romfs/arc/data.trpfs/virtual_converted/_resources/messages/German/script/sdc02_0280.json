          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc02_0280_brother_08",
      "hash64": "0E2F83867BEA352A",
      "text": "Selbst Ogerpon, das ich schon lang vor dir\\nmochte, hat sich für dich entschieden...![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0043"
          ]
