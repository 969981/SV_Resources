      ]
    },
    {
      "ordinal": 14,
      "label": "sdc02_0280_brother_09",
      "hash64": "0E2F84867BEA36DD",
      "text": "Selbst du, Hana![VAR 0x0114(0043)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
