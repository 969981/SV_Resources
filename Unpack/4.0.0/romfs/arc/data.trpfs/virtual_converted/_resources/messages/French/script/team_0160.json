      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 49,
      "label": "team_0160_botan_10",
      "hash64": "1B1518CD8DCE73EB",
      "text": "Mais... Euh...\\nC’est-à-dire que...[VAR 0x0114(0008)]",
