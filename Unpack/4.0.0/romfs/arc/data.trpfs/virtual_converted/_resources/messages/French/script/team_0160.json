          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 37,
      "label": "team_0160_head_teacher_21",
      "hash64": "401ABFBBE397331A",
      "text": "Vous continuerez donc vos activités, mais\\nvos repaires seront transformés en Centres\\r\\nd’Entraînement Star dont vous aurez la charge.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
