    },
    {
      "ordinal": 2,
      "label": "team_0160_head_teacher_03",
      "hash64": "40212DBBE39C59B2",
      "text": "Mes plus sincères excuses.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
