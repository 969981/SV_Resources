          ]
        }
      ]
    },
    {
      "ordinal": 38,
      "label": "team_0160_head_teacher_22",
      "hash64": "401ABEBBE3973167",
      "text": "Avez-vous des questions concernant ce que\\nje viens de vous exposer ?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 68,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 39,
      "label": "team_0160_botan_07",
      "hash64": "1B118DCD8DCB51E3",
      "text": "Non, au contraire, ça a l’air cool...\\nEt tout le monde y gagne.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 40,
      "label": "team_0160_fairy_02",
      "hash64": "DD5A983A638C2DB1",
      "text": "Ça peut paraître bizarre qu’on te demande ça,\\nmais... Pania, joins-toi à nous ![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
