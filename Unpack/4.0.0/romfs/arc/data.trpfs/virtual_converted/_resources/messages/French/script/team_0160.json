    {
      "ordinal": 36,
      "label": "team_0160_head_teacher_20",
      "hash64": "401AC0BBE39734CD",
      "text": "J’ai été stupéfié par les méthodes de défense\\nuniques et atypiques de la Team Star ![VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
