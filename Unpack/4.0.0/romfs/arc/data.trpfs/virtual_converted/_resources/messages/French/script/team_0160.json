          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "team_0160_doku_02",
      "hash64": "1D9A2FE70425B6D7",
      "text": "Fais-nous honneur de ta présence...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "team_0160_kakutou_02",
      "hash64": "515BA81EB832E816",
      "text": "Et viens à l’école avec nous ! Si tu as des ennuis,\\non sera là pour te protéger ![VAR 0x0114(0022)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 43,
      "label": "team_0160_aku_02",
      "hash64": "294530D7AEE33A9F",
      "text": "On se disait justement que ce serait le top de\\npouvoir aller à l’école ET rester membres de\\r\\nla Team Star. Donc c’est carrément parfait ![VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
