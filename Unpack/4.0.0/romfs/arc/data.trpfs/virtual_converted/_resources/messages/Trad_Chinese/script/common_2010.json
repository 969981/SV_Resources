      "label": "common_2010_friend_01",
      "hash64": "CA1E3453EEE10F47",
      "text": "哦！主角登場了？[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
