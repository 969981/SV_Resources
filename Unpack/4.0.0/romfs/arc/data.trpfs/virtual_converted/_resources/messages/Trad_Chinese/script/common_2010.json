      ]
    },
    {
      "ordinal": 69,
      "label": "common_2010_top_18",
      "hash64": "5E4DD677DE73DC1A",
      "text": "那麼，我去解決別的工作……\\n和牡丹一起思考如何改善\\r\\nＬＰ系統的脆弱性吧。[VAR 0x0114(0011)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
