    {
      "ordinal": 18,
      "label": "gym_kusa_020_keeper_01",
      "hash64": "3530CCAE0E1378E7",
      "text": "Soy Marisol, la cuidadora de los Sunflora de este\\ngimnasio.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "gym_kusa_020_keeper_06",
      "hash64": "3530C9AE0E1373CE",
      "text": "Bueno, les voy a pedir a nuestros soletes que se\\nescondan por todo el pueblo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 20,
      "label": "gym_kusa_020_keeper_07",
      "hash64": "3530CAAE0E137581",
      "text": "¡Sun, suuun!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 21,
      "label": "gym_kusa_020_keeper_09",
      "hash64": "3530C4AE0E136B4F",
      "text": "¡Eso quiere decir que ya se han escondido!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "gym_kusa_020_keeper_10",
      "hash64": "3533D1AE0E15B73D",
      "text": "¡Que comience el examen!\\c\\nCuando hayas reunido [VAR 0x0201(0001)] Sunflora, tráemelos\\naquí, a la Plaza Sunflora.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
