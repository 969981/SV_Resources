      "hash64": "01E16C63DBE19887",
      "text": "Por ahora has encontrado [VAR 0x0200(0001)], así que aún te\\nqueda[VAR 0x1101(0002,0100)]n [VAR 0x0201(0002)] por hallar.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
