          "args_hex": [
            "0001"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "gym_kusa_020_keeper_03",
      "hash64": "3530CEAE0E137C4D",
      "text": "Cuando hayas encontrado [VAR 0x0201(0002)], tráelos a esta\\nplaza.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 24,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0002"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "gym_kusa_020_keeper_04",
      "hash64": "3530C7AE0E137068",
      "text": "¡Enhorabuena por reunir a todos los Sunflora!\\nHas aprobado el examen de gimnasio.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "gym_kusa_020_keeper_05",
      "hash64": "3530C8AE0E13721B",
      "text": "Pásate por la recepción del Gimnasio de Pueblo\\nAltamía para hacérselo saber a la encargada.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "gym_kusa_020_receptionist_06",
      "hash64": "01E16E63DBE19BED",
      "text": "¿Quieres presentarte al examen de gimnasio de\\nnuevo? La recolección de Sunflora, ya sabes.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "gym_kusa_020_receptionist_07",
      "hash64": "01E16D63DBE19A3A",
      "text": "Dicho y hecho: reúne a [VAR 0x0201(0001)] Sunflora y tráelo[VAR 0x1101(0001,0100)]s a\\nesta plaza.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0201",
          "args_hex": [
            "0001"
