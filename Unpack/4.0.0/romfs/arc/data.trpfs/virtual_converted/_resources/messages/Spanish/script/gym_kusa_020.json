    {
      "ordinal": 23,
      "label": "gym_kusa_020_keeper_11",
      "hash64": "3533D0AE0E15B58A",
      "text": "Hala, ¡adelante! ¡A pasarlo bien!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "gym_kusa_020_keeper_02",
      "hash64": "3530CDAE0E137A9A",
      "text": "Por ahora te acompaña[VAR 0x1101(0001,0100)]n... ¡[VAR 0x0201(0001)] Sunflora!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 21,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
