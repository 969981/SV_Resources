    {
      "ordinal": 4,
      "label": "gym_kusa_020_receptionist_05",
      "hash64": "01E16B63DBE196D4",
      "text": "Algunos se encuentran en lugares insospechados,\\ncomo en la parte trasera de los edificios o en lo\\r\\nalto, así que no dejes ni un rincón sin peinar.",
      "flags": 4,
      "text_status": "DECODED",
