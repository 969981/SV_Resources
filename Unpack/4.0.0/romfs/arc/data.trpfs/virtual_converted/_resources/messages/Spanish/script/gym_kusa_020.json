    },
    {
      "ordinal": 2,
      "label": "gym_kusa_020_receptionist_03",
      "hash64": "01E16963DBE1936E",
      "text": "Explora Pueblo Altamía hasta dar con\\n[VAR 0x0201(0001)] Sunflora, los Pokémon flor con forma de sol.\\c\\nPásate por la Plaza Sunflora cuando los reúnas\\npara aprobar el examen de gimnasio.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
