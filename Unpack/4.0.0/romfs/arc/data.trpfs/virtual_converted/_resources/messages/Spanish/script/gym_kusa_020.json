          "offset_units": 45,
          "count": 3,
          "code_hex": "1101",
          "args_hex": [
            "0001",
            "0100"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "gym_kusa_020_receptionist_08",
      "hash64": "01E16063DBE18423",
      "text": "¡Que tengas suerte!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "gym_kusa_020_kusapoke_10",
      "hash64": "F905C97956842618",
      "text": "Si sales del pueblo, abandonarás el examen y\\ndeberás empezar de cero la recolección.\\c\\n¿Quieres irte de todas formas?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "gym_kusa_020_kusapoke_11",
      "hash64": "F905CA79568427CB",
      "text": "¡Has abandonado el examen de gimnasio!\\c\\nCuando quieras intentarlo de nuevo, vente a la\\nPlaza Sunflora.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
