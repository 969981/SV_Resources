      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "team_0060_select_02",
      "hash64": "FE4583CC0003A8C7",
      "text": "Ah, Leval!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "team_0060_nelke_02",
      "hash64": "FD96731F923FB0DE",
      "text": "Ich bin gerade als Leval hier, bitte vergiss das\\nnicht.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 55,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "team_0060_nelke_03",
      "hash64": "FD96741F923FB291",
      "text": "Genau! Dein mentales Anpassungsvermögen ist\\nwirklich allererste Sahne.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "team_0060_nelke_04",
      "hash64": "FD96751F923FB444",
      "text": "Lass uns die Gelegenheit nutzen, um unser\\nGespräch von neulich fortzusetzen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 76,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "team_0060_nelke_05",
      "hash64": "FD96761F923FB5F7",
      "text": "Wie erwähnt, habe ich mich Operation Stardust\\nangeschlossen, um der Sache mit Team Star und\\r\\nden Rätseln, die sie umgeben, nachzugehen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "team_0060_nelke_06",
      "hash64": "FD96771F923FB7AA",
      "text": "Vor allem sorgt es mich, dass die Mitglieder von\\nTeam Star nicht mehr in die Akademie kommen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "team_0060_nelke_07",
      "hash64": "FD96781F923FB95D",
      "text": "Ich verfolge dasselbe Ziel wie Cassiopeia:\\ndie Auflösung des Teams.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 67,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "team_0060_nelke_08",
      "hash64": "FD96691F923F9FE0",
      "text": "Seit ich Teil von Operation Stardust wurde,\\nbin ich Team Star schon nähergekommen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 82,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "team_0060_nelke_09",
      "hash64": "FD966A1F923FA193",
      "text": "Mir ist auch einiges klar geworden, nachdem ich\\nmich mit einigen Mitgliedern unterhalten habe.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "team_0060_nelke_10",
      "hash64": "FD99F71F9242C701",
      "text": "Aber ich brauche noch mehr Informationen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "team_0060_nelke_11",
      "hash64": "FD99F61F9242C54E",
      "text": "Dafür möchte ich auch mit Mitgliedern der\\nübrigen Banden sprechen.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "team_0060_nelke_12",
      "hash64": "FD99F51F9242C39B",
      "text": "Wenn du dich ins nächste Versteck stürzt,\\nkannst du also voll auf mich zählen. Bis dann![VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    }
