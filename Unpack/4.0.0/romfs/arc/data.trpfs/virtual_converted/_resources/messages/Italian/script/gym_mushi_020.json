    {
      "ordinal": 27,
      "label": "gym_mushi_020_select_01",
      "hash64": "8B7B0826C1D6E9A3",
      "text": "Voglio continuare!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 28,
      "label": "gym_mushi_020_select_02",
      "hash64": "8B7B0926C1D6EB56",
      "text": "Sì, voglio ritirarmi",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 29,
      "label": "gym_mushi_020_trainer_19",
      "hash64": "5BE4B32D0541B7D3",
      "text": "Se cerchi una scorciatoia, te la devi guadagnare!\\nNon ti lascerò proseguire tanto facilmente.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "gym_mushi_020_trainer_21",
      "hash64": "5BEEAB2D0549FEC0",
      "text": "Di fronte alla tua forza persino gli Smoliv si fanno\\nda parte!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "gym_mushi_020_trainer_20",
      "hash64": "5BEEAC2D054A0073",
      "text": "Ti ho ostacolato con una lotta per farti capire\\nquanto è faticoso coltivare le olive!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
