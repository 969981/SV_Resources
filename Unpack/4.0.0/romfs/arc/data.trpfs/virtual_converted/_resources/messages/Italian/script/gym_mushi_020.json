    {
      "ordinal": 4,
      "label": "gym_mushi_020_receptionist_01",
      "hash64": "1EEACFED15ABF95A",
      "text": "Benvenut[VAR 0x1100(00FF,0101)]oa alla Palestra di Moldulcia!\\c\\nVuoi che ti spieghi di nuovo come funziona\\nl’Esame della Palestra?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 43,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "gym_mushi_020_receptionist_02",
      "hash64": "1EEACEED15ABF7A7",
      "text": "L’Esame della Palestra di Moldulcia è la [VAR 0xFF00(0006)]ruzzolata[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]dell’oliva[VAR 0xFF00(0000)]!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "gym_mushi_020_receptionist_03",
      "hash64": "1EEACDED15ABF5F4",
      "text": "Per superarlo devi far rotolare una palla a forma\\ndi oliva fino al traguardo.\\c\\nSe ci riesci, vedrai quante olive l’anno prossimo!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "gym_mushi_020_receptionist_04",
      "hash64": "1EEACCED15ABF441",
      "text": "La ruzzolata dell’oliva si svolge nella parte [VAR 0xFF00(0006)]nord[VAR 0xFF00(0000)]\\n[VAR 0xFF00(0006)]della città[VAR 0xFF00(0000)]!\\c\\nQuando sarai sul luogo d’esame, fatti pure\\nspiegare tutte le regole dallo staff.",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 46,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 54,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 79,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "gym_mushi_020_trainer_01",
      "hash64": "5BE83F2D0544DB8E",
      "text": "Benvenut[VAR 0x1100(00FF,0101)]oa al nostro campo! Qui si svolgerà\\nla ruzzolata dell’oliva!",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "gym_mushi_020_trainer_02",
      "hash64": "5BE83E2D0544D9DB",
      "text": "Questo Esame della Palestra sarà una prova\\ndi forza!\\c\\nDovrai far rotolare un’enorme oliva colpendola\\ncon tutto il corpo.",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "gym_mushi_020_trainer_03",
      "hash64": "5BE83D2D0544D828",
      "text": "Se riuscirai a superare gli ostacoli e a far entrare\\nl’oliva nel cesto al traguardo, passerai l’esame!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 11,
      "label": "gym_mushi_020_trainer_04",
      "hash64": "5BE8442D0544E40D",
      "text": "Allora, vuoi cimentarti nella ruzzolata dell’oliva?",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 12,
      "label": "gym_mushi_020_trainer_05",
      "hash64": "5BE8432D0544E25A",
      "text": "Perfetto! Mi raccomando: mentre fai rotolare\\nl’oliva, desidera ardentemente un buon raccolto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 13,
      "label": "gym_mushi_020_trainer_06",
      "hash64": "5BE8422D0544E0A7",
      "text": "Ho capito... Torna da me quando sei pront[VAR 0x1100(00FF,0101)]oa.",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "gym_mushi_020_trainer_07",
      "hash64": "5BE8412D0544DEF4",
      "text": "Benvenut[VAR 0x1100(00FF,0101)]oa! Vuoi affrontare la ruzzolata\\ndell’oliva, ossia il nostro Esame della Palestra?",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "gym_mushi_020_trainer_08",
      "hash64": "5BE8382D0544CFA9",
      "text": "Non ti lascerò passare per questa scorciatoia\\nfinché non mi avrai sconfitto!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 16,
      "label": "gym_mushi_020_trainer_09",
      "hash64": "5BE8372D0544CDF6",
      "text": "Vediamo se riuscirai ad aggirare una muraglia\\ndi Smoliv!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "gym_mushi_020_trainer_10",
      "hash64": "5BE4BA2D0541C3B8",
      "text": "Forza, Smoliv, aprite la strada!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 18,
      "label": "gym_mushi_020_trainer_11",
      "hash64": "5BE4BB2D0541C56B",
      "text": "Se la spingi mentre sei in groppa a un Pokémon,\\nl’oliva rotolerà più facilmente!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 19,
      "label": "gym_mushi_020_trainer_12",
      "hash64": "5BE4BC2D0541C71E",
      "text": "Ottimo, [VAR 0x0100(0000)]! Grazie a te avremo\\ndi sicuro un gran raccolto anche l’anno prossimo!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 8,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "gym_mushi_020_trainer_13",
      "hash64": "5BE4BD2D0541C8D1",
      "text": "Hai superato l’Esame della Palestra!\\nSei stat[VAR 0x1100(00FF,0101)]oa promoss[VAR 0x1100(00FF,0101)]oa, complimenti!",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 60,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "gym_mushi_020_trainer_14",
      "hash64": "5BE4BE2D0541CA84",
      "text": "Vai a riferire l’esito dell’esame allo staff\\nall’entrata della palestra.\\c\\nE buona fortuna contro la Capopalestra!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "gym_mushi_020_trainer_15",
      "hash64": "5BE4BF2D0541CC37",
      "text": "Vuoi abbandonare la ruzzolata dell’oliva?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "gym_mushi_020_trainer_16",
      "hash64": "5BE4C02D0541CDEA",
      "text": "Vuoi davvero ritirarti?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
