    },
    {
      "ordinal": 8,
      "label": "champ_0130_steel_03",
      "hash64": "85D77BA5DFE5044F",
      "text": "波、波琵我覺得\\n我的寶可夢也很強呢……[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
