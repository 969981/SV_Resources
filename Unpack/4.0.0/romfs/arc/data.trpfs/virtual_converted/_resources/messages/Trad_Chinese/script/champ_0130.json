      "label": "champ_0130_ground_10",
      "hash64": "DE1422169636F3FF",
      "text": "也算是為了波琵，\\n[VAR 0x1100(00FF,0101)]你妳可要好好加油啊。[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
