          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "champ_0130_steel_05",
      "hash64": "85D779A5DFE500E9",
      "text": "波琵我是四天王，\\n所以我比較厲害……！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "champ_0130_ground_07",
      "hash64": "DE111F169634B90F",
      "text": "啊哈哈！妳太～可愛了！[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "champ_0130_ground_08",
      "hash64": "DE1124169634C18E",
      "text": "這孩子雖然是個小不點，\\n但可是四天王喲。[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0013"
