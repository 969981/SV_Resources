      "label": "champ_0130_steel_07a",
      "hash64": "521E30DB721B6706",
      "text": "真想快點讓大哥哥看看\\n波琵我的寶可夢！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
