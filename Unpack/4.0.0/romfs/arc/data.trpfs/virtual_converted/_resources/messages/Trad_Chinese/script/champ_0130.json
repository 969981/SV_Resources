          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "champ_0130_ground_06",
      "hash64": "DE111E169634B75C",
      "text": "不知道[VAR 0x1100(00FF,0101)]你妳們誰會比較強喲……？[VAR 0x0114(0013)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
