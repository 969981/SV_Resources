    },
    {
      "ordinal": 10,
      "label": "champ_0130_steel_04",
      "hash64": "85D778A5DFE4FF36",
      "text": "嗯～我說呀！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
