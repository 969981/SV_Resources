      "ordinal": 14,
      "label": "champ_0130_steel_06",
      "hash64": "85D776A5DFE4FBD0",
      "text": "正～是這樣！[VAR 0x0114(0014)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0014"
