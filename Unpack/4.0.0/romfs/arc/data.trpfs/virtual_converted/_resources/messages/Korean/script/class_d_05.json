          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "class_d_05_popup_01",
      "hash64": "B80FB7BCCDBC3AF3",
      "text": "짝짝짝짝~",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 30,
      "label": "class_d_05_language_18",
      "hash64": "6D326AECA3C60CDB",
      "text": "같은 포켓몬이라도\\n다양한 말을 한다는 것. 이제 알겠지?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "class_d_05_language_19",
      "hash64": "6D3269ECA3C60B28",
      "text": "기분이나 상태에 따라\\n포켓몬의 소리가 달라지니까,[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "class_d_05_language_20",
      "hash64": "6D27F0ECA3BCE908",
      "text": "Lesson이 끝나면 주의 깊게 들어 보렴!\\n포켓몬에 대해 더 많이 알 수 있을 거야![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 48,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "class_d_05_language_21",
      "hash64": "6D27F1ECA3BCEABB",
      "text": "But, 포켓몬은\\n신기하고 신기한 생명체![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "class_d_05_language_22",
      "hash64": "6D27F2ECA3BCEC6E",
      "text": "개중에는 언어가 아니라\\n초음파나 전자파, 텔레파시 등으로\\r\\n의사소통을 하는 존재도 있단다![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 31,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 35,
      "label": "class_d_05_language_23",
      "hash64": "6D27F3ECA3BCEE21",
      "text": "갑작스럽지만 여기서 세이지 선생님의\\n원 포인트 어드바이스![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 32,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 36,
      "label": "class_d_05_language_24",
      "hash64": "6D27F4ECA3BCEFD4",
      "text": "피크닉이나 포켓몬 워시 중에\\n포켓몬에게 너무 많이 장난치면\\r\\n방금처럼 화낼 수 있으니 조심하렴![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
