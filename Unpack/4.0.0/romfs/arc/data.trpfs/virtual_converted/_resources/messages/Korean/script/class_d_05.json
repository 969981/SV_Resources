          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "class_d_05_language_04",
      "hash64": "6D2EF8ECA3C3154E",
      "text": "전반기 Lesson에서는 세이지 선생님과\\n다양한 나라의 말에 대해 공부했었지?[VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 43,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "class_d_05_language_05",
      "hash64": "6D2EF9ECA3C31701",
      "text": "후반기는 살짝 다른 Lesson이 될 거야!\\n리스닝 형식으로 할 거거든![VAR 0x0114(0026)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0026"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "class_d_05_language_06",
      "hash64": "6D2EF6ECA3C311E8",
      "text": "Come on! 피, 피카츄~![VAR 0x0114(0026)]",
