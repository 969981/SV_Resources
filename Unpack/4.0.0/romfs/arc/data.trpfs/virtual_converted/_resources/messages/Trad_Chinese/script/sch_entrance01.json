    {
      "ordinal": 9,
      "label": "sch_entrance01_girl_03",
      "hash64": "A478CF916FCE48D6",
      "text": "是入口也是圖書館，\\n真是嶄新的設計～",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
