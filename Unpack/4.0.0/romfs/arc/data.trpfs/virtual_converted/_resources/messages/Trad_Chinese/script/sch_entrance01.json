    {
      "ordinal": 58,
      "label": "sch_entrance01_boy_08",
      "hash64": "EB33E9E6A24391F7",
      "text": "聽說只要一直帶著一起走，\\n也有寶可夢會因此進化喔。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
