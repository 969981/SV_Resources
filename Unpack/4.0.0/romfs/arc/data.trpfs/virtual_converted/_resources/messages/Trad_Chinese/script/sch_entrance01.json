      ]
    },
    {
      "ordinal": 62,
      "label": "sch_entrance01_girl_06",
      "hash64": "A478D4916FCE5155",
      "text": "晚上的學校很不可思議！\\n出沒的人和白天的時候不一樣喔。\\c\\n城鎮外頭也是如此，\\n白天和晚上分別能遇到不同的寶可夢。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 27,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 63,
      "label": "sch_entrance01_poke_33",
      "hash64": "01B78309590C7BD8",
      "text": "[EMPTY 76]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "004C"
          ]
        }
      ]
    },
    {
      "ordinal": 64,
      "label": "sch_entrance01_man_04",
      "hash64": "4A9BB7FB162BB421",
      "text": "能在知名博士的母校讀書，\\n真是光榮。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
