    {
      "ordinal": 5,
      "label": "sch_entrance01_girl_02",
      "hash64": "A478D0916FCE4A89",
      "text": "《OH！超自然文化》真是本怪雜誌！\\n內容謊言連篇！",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
