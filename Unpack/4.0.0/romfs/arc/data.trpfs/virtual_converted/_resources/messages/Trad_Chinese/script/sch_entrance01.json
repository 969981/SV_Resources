    {
      "ordinal": 14,
      "label": "sch_entrance01_girl_04",
      "hash64": "A478D2916FCE4DEF",
      "text": "記載了秘傳調味料的書……\\n是放在哪裡啊？",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
