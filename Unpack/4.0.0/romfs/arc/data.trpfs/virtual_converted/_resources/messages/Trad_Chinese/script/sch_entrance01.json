      "text": "[EMPTY 76]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "004C"
          ]
        }
      ]
    },
    {
      "ordinal": 66,
      "label": "sch_entrance01_poke_35",
      "hash64": "01B78909590C860A",
      "text": "[EMPTY 76]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
