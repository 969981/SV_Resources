      ]
    },
    {
      "ordinal": 67,
      "label": "sch_entrance01_man_05",
      "hash64": "4A9BB6FB162BB26E",
      "text": "我和派帕同班，\\n從去年開始他好像滿辛苦的。\\r\\n我也能懂他的心情。",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
