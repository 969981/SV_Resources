        }
      ]
    },
    {
      "ordinal": 16,
      "label": "team_0140_honooboss_03",
      "hash64": "934D300669D4AB51",
      "text": "Et toi ? Tu vas faire quoi ?[VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
