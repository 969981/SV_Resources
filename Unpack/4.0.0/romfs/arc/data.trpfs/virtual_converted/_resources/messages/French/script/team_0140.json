          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "team_0140_cassiopeia_08",
      "hash64": "418BB63474F8132D",
      "text": "Moi... Je ne peux pas y retourner.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 34,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "team_0140_akuboss_03",
      "hash64": "91A7B03026A4C6D5",
      "text": "Mais pourquoi ? T’as plus besoin de rester\\nenfermée dans ta chambre ![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "team_0140_cassiopeia_09",
      "hash64": "418BB53474F8117A",
      "text": "Pardonnez-moi... Tout ce que je peux vous dire,\\nc’est merci. Merci de m’avoir épaulée.[VAR 0x0114(0009)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "team_0140_cassiopeia_10",
      "hash64": "4188283474F4EC0C",
      "text": "On ne s’est jamais vus IRL, et pourtant\\nvous avez tous été si gentils avec moi...[VAR 0x0114(0009)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0009"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "team_0140_kakutouboss_02",
      "hash64": "D56B89961FF80EAF",
      "text": "Big Boss ! Arrête de parler comme ça !\\nOn dirait que tu nous fais tes adieux ![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
