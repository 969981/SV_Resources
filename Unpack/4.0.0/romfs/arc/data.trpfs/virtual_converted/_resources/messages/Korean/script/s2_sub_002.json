    },
    {
      "ordinal": 2,
      "label": "s2_sub_002_follower_03",
      "hash64": "B85D8FDEF16F5CED",
      "text": "공중날기 타임어택에\\n도전하실 건가요?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s2_sub_002_follower_04",
      "hash64": "B85D88DEF16F5108",
      "text": "어느 코스에\\n도전하실 건가요?",
