      "label": "s2_sub_002_follower_01",
      "hash64": "B85D8DDEF16F5987",
      "text": "네리네 님에게 승리하신 것을\\n축하드립니다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
