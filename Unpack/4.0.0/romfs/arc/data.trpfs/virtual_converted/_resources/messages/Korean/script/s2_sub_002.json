      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_002_follower_02",
      "hash64": "B85D8EDEF16F5B3A",
      "text": "이곳에서는 블루베리그와 상관없이\\n공중날기 타임어택에\\r\\n자유롭게 도전하실 수 있습니다!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 28,
