      "text": "특급 코스군요!\\n만반의 준비를 하시고 다녀오세요~!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
