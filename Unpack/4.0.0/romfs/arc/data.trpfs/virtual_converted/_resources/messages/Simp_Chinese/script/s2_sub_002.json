      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 1,
      "label": "s2_sub_002_follower_02",
      "hash64": "B85D8EDEF16F5B3A",
      "text": "与蓝莓联盟无关，\\n在这里你可以不限次数地\\r\\n挑战飞翔计时赛哦！",
      "flags": 0,
      "text_status": "DECODED",
