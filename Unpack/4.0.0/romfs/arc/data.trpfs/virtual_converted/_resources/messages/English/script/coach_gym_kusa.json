      ]
    },
    {
      "ordinal": 2,
      "label": "coach_gym_kusa_sp01_00",
      "hash64": "E49EDFBA7377DED8",
      "text": "[VAR 0xBD06(0000)][VAR 0x0100(0000)], I thank you for\\ninviting\\r\\nme\\r\\nto\\r\\nthis\\r\\nplace.[VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
