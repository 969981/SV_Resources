          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "coach_gym_kusa_trade_01_03",
      "hash64": "A2CAF2BF4E513B69",
      "text": "Very good, [VAR 0x0100(0000)]-garde!\\c\\nI will offer up one of my Sunflora! How will you\\nmeet such a challenge?![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 11,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 22,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
