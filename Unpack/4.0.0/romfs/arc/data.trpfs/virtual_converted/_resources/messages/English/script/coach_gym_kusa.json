          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0017"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "coach_gym_kusa_trade_01_00",
      "hash64": "A2CAEFBF4E513650",
