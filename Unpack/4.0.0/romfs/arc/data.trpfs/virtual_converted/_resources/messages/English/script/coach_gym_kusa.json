    },
    {
      "ordinal": 37,
      "label": "coach_gym_kusa_trade_02_01",
      "hash64": "D08478C5B12C054C",
      "text": "You can’t trade Brassius a Pokémon if you\\naren’t its original Trainer!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 38,
      "label": "coach_gym_kusa_trade_02_02",
      "hash64": "D0847BC5B12C0A65",
      "text": "You can’t trade Brassius such a rare Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 39,
      "label": "coach_gym_kusa_trade_02_03",
      "hash64": "D0847AC5B12C08B2",
      "text": "You can’t trade Brassius a Shiny Pokémon!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 40,
      "label": "coach_gym_kusa_trade_03_00",
      "hash64": "26EA43CD4C95C76E",
      "text": "Wait, no! Have you taken leave of your senses?!\\nYou can’t trade with only a single Pokémon!\\c\\nBe certain you have at least two Pokémon in your\\nparty if you wish to make our exchange![VAR 0x0114(0017)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
