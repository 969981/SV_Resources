      "ordinal": 22,
      "label": "atlantis_talk_02_botan_07",
      "hash64": "CF7D544C27E1F7AA",
      "text": "Haha... Ich geb dir gleich „ganz okay“![VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
