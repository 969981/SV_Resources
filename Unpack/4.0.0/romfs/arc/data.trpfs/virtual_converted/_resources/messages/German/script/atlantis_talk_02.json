          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "atlantis_talk_02_friend_04a",
      "hash64": "BE3545B9DAC773C0",
      "text": "Ich hab das immer damit abgetan, dass ich stolz\\ndarauf bin, so eine coole Mutter zu haben.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "atlantis_talk_02_friend_04b",
      "hash64": "BE3548B9DAC778D9",
      "text": "Ich hab das immer damit abgetan, dass ich stolz\\ndarauf bin, so einen coolen Vater zu haben.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
