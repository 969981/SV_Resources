          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "atlantis_talk_02_botan_05",
      "hash64": "CF7D524C27E1F444",
      "text": "Hör zu, es tut mir leid wegen vorhin.\\nWas ich gesagt hab, ging zu weit...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "atlantis_talk_02_friend_10",
      "hash64": "72C514ABAEB04A64",
      "text": "Kein Ding. Ich war schließlich auch nicht allzu nett\\nzu dir. Sorry... äh...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "atlantis_talk_02_botan_06",
      "hash64": "CF7D554C27E1F95D",
      "text": "Cosima. Ich heiße Cosima.[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0008"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "atlantis_talk_02_friend_11",
      "hash64": "72C515ABAEB04C17",
      "text": "Weißt du, Cosima... Vielleicht bist du doch\\nganz okay.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
