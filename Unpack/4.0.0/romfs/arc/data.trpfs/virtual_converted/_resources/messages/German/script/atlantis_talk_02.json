          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "atlantis_talk_02_friend_03b",
      "hash64": "BE386EB9DAC9EF42",
      "text": "Er mag mein Vater sein, aber eigentlich ist er\\nwie ein Fremder für mich.[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
