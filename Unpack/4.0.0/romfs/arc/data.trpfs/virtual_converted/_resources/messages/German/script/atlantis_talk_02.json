          "args_hex": [
            "0006"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "atlantis_talk_02_friend_09",
      "hash64": "72C891ABAEB354A2",
      "text": "Wie auch immer. Familie des Jahres, yay...[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
