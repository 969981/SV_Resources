    },
    {
      "ordinal": 17,
      "label": "atlantis_talk_02_botan_04",
      "hash64": "CF7D534C27E1F5F7",
      "text": "Jede Familie ist eben anders...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
