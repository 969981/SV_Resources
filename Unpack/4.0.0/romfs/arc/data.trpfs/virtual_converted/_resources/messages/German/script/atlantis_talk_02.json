    },
    {
      "ordinal": 16,
      "label": "atlantis_talk_02_botan_03",
      "hash64": "CF7D504C27E1F0DE",
      "text": "Also, ähm...[VAR 0x0114(0008)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
