            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "sdc01_0350_sister_01",
      "hash64": "AE04A130EA7201FC",
      "text": "Senti, per caso quei tre sono passati per di qua?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 49,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 2,
      "label": "sdc01_0350_caretaker_02",
      "hash64": "CCBC469464ECF941",
      "text": "Quei... tre...? Che mi tocca sentire!\\nSono i beniamici! Un po’ di rispetto![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 3,
      "label": "sdc01_0350_sister_02",
      "hash64": "AE04A430EA720715",
      "text": "Chi se ne importa! Non ho tempo da perdere\\ncon queste sciocchezze![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "sdc01_0350_caretaker_03",
      "hash64": "CCBC459464ECF78E",
      "text": "Sempre la solita, Rubra...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "sdc01_0350_caretaker_04",
      "hash64": "CCBC489464ECFCA7",
      "text": "In ogni caso... Ebbene sì!\\c\\nI beniamici ci hanno onorato con la loro presenza\\nproprio nel nostro centro! Che sorpresa, eh?[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 124,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "sdc01_0350_caretaker_05",
      "hash64": "CCBC479464ECFAF4",
      "text": "Sembravano molto interessati alle maschere\\nbrillanti che custodiamo qui...[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "sdc01_0350_caretaker_06",
      "hash64": "CCBC4A9464ED000D",
      "text": "E quindi non abbiamo esitato a offrirgliele!\\nCi mancherebbe, dico bene?[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 71,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "sdc01_0350_sister_03",
      "hash64": "AE04A330EA720562",
      "text": "Che?! Gliele avete date?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 25,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "sdc01_0350_caretaker_07",
      "hash64": "CCBC499464ECFE5A",
      "text": "Certo! Sembravano anche molto affamati...\\nHanno divorato in un batter d’occhio tutti i nostri\\r\\npiccantissimi mochi di Nordivia![VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 129,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "sdc01_0350_sister_04",
      "hash64": "AE049E30EA71FCE3",
      "text": "Gli avete persino servito da mangiare?![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "sdc01_0350_person_01",
      "hash64": "5772BA2E93A27FE3",
      "text": "I mochi di Nordivia sono pieni zeppi di sostanze\\naltamente nutritive! Scommetto che i tre\\r\\nbeniamici ora si sentono molto più grandi e forti!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "sdc01_0350_sister_05",
      "hash64": "AE049D30EA71FB30",
      "text": "Se sapessero che quei tre ladruncoli hanno\\nrubato le maschere a Ogerpon...\\c\\nChe rabbia non poter dire come stanno\\nrealmente le cose![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 74,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "sdc01_0350_sister_06",
      "hash64": "AE04A030EA720049",
      "text": "Comunque... dove se ne sono andati?[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 35,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "sdc01_0350_caretaker_08",
      "hash64": "CCBC3C9464ECE843",
      "text": "Li ho visti avviarsi verso il Monte Orco.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "sdc01_0350_caretaker_09",
      "hash64": "CCBC3B9464ECE690",
      "text": "Credo proprio che siano andati all’Antro\\ndel Terrore a dare una bella lezione a quel\\r\\nterribile orco che si nasconde al suo interno.[VAR 0x0114(0045)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 134,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "sdc01_0350_caretaker_10",
      "hash64": "CCB8BE9464E9DC52",
      "text": "Oh, come faremmo senza i nostri beneamati\\nbeniamici? Ah ah ah!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 17,
      "label": "sdc01_0350_sister_07",
      "hash64": "AE049F30EA71FE96",
      "text": "Ma che ti ridi! Guarda che non c’è proprio nulla\\ndi divertente![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 63,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "sdc01_0350_sister_08",
      "hash64": "AE04AA30EA721147",
      "text": "Se la storia del nonno è vera... quei tre vogliono\\nsicuramente vendicarsi di Ogerpon.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "sdc01_0350_sister_09",
      "hash64": "AE04A930EA720F94",
      "text": "E se Ogerpon trae davvero la sua forza dalla\\nmaschera...[VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 56,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "sdc01_0350_sister_10",
      "hash64": "AE011C30EA6EEA26",
      "text": "Come potrà difendersi, adesso che non ce l’ha?\\nNon avrà speranze contro quei tre.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "sdc01_0350_select_01",
      "hash64": "CAA525969695A084",
      "text": "Andiamo ad aiutarlo!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 22,
      "label": "sdc01_0350_select_02",
      "hash64": "CAA528969695A59D",
      "text": "Restituiamogli la maschera!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 23,
      "label": "sdc01_0350_sister_11",
      "hash64": "AE011D30EA6EEBD9",
      "text": "Vedo che siamo d’accordo. Però credo sia\\nmeglio che ci separiamo.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 65,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "sdc01_0350_sister_12",
      "hash64": "AE011A30EA6EE6C0",
      "text": "Tu vai nell’Antro del Terrore e fai il possibile\\nper proteggere Ogerpon.[VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 72,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "sdc01_0350_sister_13",
      "hash64": "AE011B30EA6EE873",
      "text": "Io invece torno a casa e cerco di aggiustare\\nla maschera. Dammi tutto il necessario, su![VAR 0x0114(0044)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "sdc01_0350_system_01",
      "hash64": "DC64F7DF66445A4F",
      "text": "Hai dato la Maschera Turchese e il Pezzo\\ndi cristallo a Rubra!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "sdc01_0350_sister_14",
      "hash64": "AE012030EA6EF0F2",
      "text": "Grazie![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 7,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "sdc01_0350_sister_15",
      "hash64": "AE012130EA6EF2A5",
      "text": "Ti raggiungo appena riesco a ripararla. Intanto,\\ntu corri da Ogerpon, svelt[VAR 0x1100(00FF,0101)]oa![VAR 0x0114(0044)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 75,
          "count": 3,
          "code_hex": "1100",
          "args_hex": [
            "00FF",
            "0101"
          ]
        },
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0044"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "sdc01_0350_caretaker_11",
      "hash64": "CCB8BF9464E9DE05",
      "text": "I tre beniamici si sono avviati verso il Monte\\nOrco.[VAR 0x0114(0045)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0045"
          ]
        }
      ]
    }
  ]
}
