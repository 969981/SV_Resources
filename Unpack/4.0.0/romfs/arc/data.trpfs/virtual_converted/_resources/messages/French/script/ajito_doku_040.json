          ]
        }
      ]
    },
    {
      "ordinal": 47,
      "label": "ajito_doku_040_student_12",
      "hash64": "E666FEEF86A5659B",
      "text": "C’est terrible...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 48,
      "label": "ajito_doku_040_dokuboss_22",
      "hash64": "7EF0505EC92D48A1",
      "text": "Nous ne connaissons ni son nom ni son\\napparence, mais nous considérons malgré\\r\\ntout cette personne comme des nôtres.\\c\\nC’est pourquoi nous attendons son retour\\ndans nos repaires avec impatience.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
