          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "ajito_doku_040_kakutouboss_01",
      "hash64": "4918872BA1141559",
      "text": "Mon uniforme est exactement comme je l’avais\\nimaginé. Merci beaucoup ![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "ajito_doku_040_dokuboss_03",
      "hash64": "7EE9BF5EC927E690",
      "text": "Idole du public\\nImpératrice de l’enfer\\r\\nNèflie l’invincible.\\c\\nQue ce haïku, tout comme cet habit,\\nfasse honneur à ton image.[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 38,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 128,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "ajito_doku_040_akuboss_01",
      "hash64": "36523EDB08117B0C",
      "text": "Grâce à toi, on a tous un look de badass !\\nMerci, Erio ! T’es un as ![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 69,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "ajito_doku_040_akuboss_02",
      "hash64": "365241DB08118025",
      "text": "Vous en imposez de ouf, toutes les deux !\\c\\nMaintenant, plus personne va oser vous chercher\\ndes ennuis, c’est sûr ![VAR 0x0114(0021)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 116,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "ajito_doku_040_fairyboss_01",
      "hash64": "0E1DF61F5DCB6AEA",
      "text": "Je félicite rarement les gens, mais là,\\nc’est vraiment du travail de pro.[VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 73,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "ajito_doku_040_fairyboss_02",
      "hash64": "0E1DF51F5DCB6937",
      "text": "Quand je pense à tous ceux qui t’ont harcelé\\njuste parce que t’es fan de ninja et de poésie\\r\\nclassique... Quelle bande d’idiots ![VAR 0x0114(0020)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 131,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0020"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "ajito_doku_040_dokuboss_04",
      "hash64": "7EE9C65EC927F275",
      "text": "La voie du ninja est un sentier parsemé de\\nronces, inaccessible au commun des mortels.\\c\\nEt la bave du Cradopaud n’atteint pas\\nle blanc Lestombaile.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 86,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 149,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "ajito_doku_040_honooboss_02",
      "hash64": "3FEE669A2D553E25",
      "text": "Ouah, c’est profond c’que tu dis !\\nMême si j’ai pas tout pigé...\\r\\nMais t’as raison de pas t’laisser faire ![VAR 0x0114(001F)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 64,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 109,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001F"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "ajito_doku_040_kakutouboss_02",
      "hash64": "4918842BA1141040",
      "text": "Tu as bien raison de t’affirmer, Erio !\\nMoi, je te trouve super tel que tu es ![VAR 0x0114(0022)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 79,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0022"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "ajito_doku_040_akuboss_03",
      "hash64": "365240DB08117E72",
      "text": "OK ! Fini la tchatche. Maintenant, faut s’entraîner.\\nOn doit se tenir prêts pour l’Opération Star ![VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 99,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "ajito_doku_040_akuboss_04",
      "hash64": "36523BDB081175F3",
      "text": "On est les boss. On se doit d’être les plus forts.\\c\\nDe quoi on aura l’air, si on est plus nuls que\\nles autres membres de notre groupe ?[VAR 0x0114(0021)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 50,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 137,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0021"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "ajito_doku_040_dokuboss_05",
      "hash64": "7EE9C55EC927F0C2",
      "text": "Absolument.\\nEntraînons-nous corps et âme ![VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 42,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "ajito_doku_040_dokuboss_06",
      "hash64": "7EE9C45EC927EF0F",
      "text": "Je me suis lancé corps et âme dans\\ncette bataille...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "ajito_doku_040_dokuboss_07",
      "hash64": "7EE9C35EC927ED5C",
      "text": "Mais la défaite était mon destin...\\nEt je dois à présent respecter le code d’honneur.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "ajito_doku_040_dokuboss_08",
      "hash64": "7EE9CA5EC927F941",
      "text": "Prends ceci...\\nTu es digne de le porter.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 40,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "ajito_doku_040_waza_01",
      "hash64": "D28430A2470ED9B9",
      "text": "Et voici une technique qui répond aux canons\\nde mon nindô.[VAR 0x0114(0023)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 58,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "ajito_doku_040_dokuboss_09",
      "hash64": "7EE9C95EC927F78E",
      "text": "Tu t’appelles [VAR 0x0100(0000)], n’est-ce point ?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 14,
          "count": 2,
          "code_hex": "0100",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 36,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "ajito_doku_040_dokuboss_10",
      "hash64": "7EE63C5EC924D220",
      "text": "Ta victoire n’évoque en moi ni rancune ni douleur.\\nMon âme est en paix et j’accepte ma défaite.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "ajito_doku_040_student_01",
      "hash64": "E6637BEF86A2512B",
      "text": "Erio-sensei !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 24,
      "label": "ajito_doku_040_dokuboss_11",
      "hash64": "7EE63D5EC924D3D3",
      "text": "Mais... c’est toi ?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 19,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "ajito_doku_040_nelke_01",
      "hash64": "BD2F1C2F0598E27F",
      "text": "Ce petit gars voulait absolument te voir.\\nIl a quelque chose d’important à te dire.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 83,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "001E"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "ajito_doku_040_student_02",
      "hash64": "E6637CEF86A252DE",
      "text": "Erio-sensei, écoutez-moi, s’il vous plaît !\\nÇa sera pas long, je vous l’assure !",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 27,
      "label": "ajito_doku_040_dokuboss_12",
      "hash64": "7EE63E5EC924D586",
      "text": "[EMPTY 61]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "003D"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "ajito_doku_040_nelke_02",
      "hash64": "BD2F1D2F0598E432",
      "text": "[EMPTY 61]",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 0,
          "count": 2,
          "code_hex": "BDFF",
          "args_hex": [
            "003D"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "ajito_doku_040_dokuboss_13",
      "hash64": "7EE63F5EC924D739",
      "text": "Pourquoi es-tu ici ?[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 20,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "ajito_doku_040_student_03",
      "hash64": "E6637DEF86A25491",
      "text": "Je suis venu pour vous aider, sensei !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 31,
      "label": "ajito_doku_040_student_04",
      "hash64": "E6637EEF86A25644",
      "text": "Si vous continuez à pas venir à l’académie,\\non va vous renvoyer, vous savez ?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 32,
      "label": "ajito_doku_040_dokuboss_14",
      "hash64": "7EE6405EC924D8EC",
      "text": "...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 3,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0023"
          ]
        }
      ]
    },
    {
      "ordinal": 33,
      "label": "ajito_doku_040_student_05",
      "hash64": "E6637FEF86A257F7",
      "text": "Mais c’est trop injuste...\\c\\nC’est grâce à la Team Star que moi et mes\\ncopains, on peut de nouveau aller à l’école !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        }
      ]
    },
    {
      "ordinal": 34,
      "label": "ajito_doku_040_student_06",
      "hash64": "E66380EF86A259AA",
      "text": "Sans cette opération, on aurait encore trop peur\\nde nos harceleurs pour y mettre les pieds !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 35,
      "label": "ajito_doku_040_student_07",
      "hash64": "E66381EF86A25B5D",
      "text": "Vous êtes notre héros ! Et je refuse que des gens\\ncomme vous se fassent renvoyer de l’académie !",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 36,
      "label": "ajito_doku_040_dokuboss_15",
      "hash64": "7EE6415EC924DA9F",
      "text": "Pardonne-moi...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 15,
          "count": 2,
