    {
      "ordinal": 46,
      "label": "ajito_doku_040_dokuboss_21",
      "hash64": "7EF04D5EC92D4388",
      "text": "De son propre aveu, notre Big Boss ne sort pas\\nde son logis par peur des interactions sociales.\\c\\nEt, tout comme nous, les harcèlements sont\\nà l’origine de sa situation.[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
