    },
    {
      "ordinal": 4,
      "label": "ajito_doku_040_dokuboss_02",
      "hash64": "7EE9C05EC927E843",
      "text": "La capacité Nitrocharge fut mon inspiration...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
