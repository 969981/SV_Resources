      ]
    },
    {
      "ordinal": 56,
      "label": "ajito_doku_040_nelke_04",
      "hash64": "BD2F172F0598DA00",
      "text": "J’ai du mal à croire que j’ai pu être si aveugle\\naux problèmes des élèves de l’académie...\\c\\nCes jeunes gens ont tissé de puissants liens\\nd’amitié en partageant leur peine, et c’est\\r\\ncette même peine qui motive leurs actions.[VAR 0x0114(001E)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
