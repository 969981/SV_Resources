    },
    {
      "ordinal": 38,
      "label": "ajito_doku_040_dokuboss_16",
      "hash64": "7EE6425EC924DC52",
      "text": "Pas depuis ce jour...[VAR 0x0114(0023)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
