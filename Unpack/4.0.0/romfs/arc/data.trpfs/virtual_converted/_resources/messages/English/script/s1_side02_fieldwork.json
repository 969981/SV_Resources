    {
      "ordinal": 33,
      "label": "s1_side02_fieldwork_sazare_pokehint_10",
      "hash64": "28337355EE03C7BD",
      "text": "Just what I’ve come to expect of my partner!\\nYour photos really showcase your good taste!\\c\\nOh, and did you hear that sound coming from the\\nnortheast? Like thunder or something? I wonder\\r\\nif it could be Electric-type Pokémon...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 89,
          "count": 1,
          "code_hex": "BE01",
