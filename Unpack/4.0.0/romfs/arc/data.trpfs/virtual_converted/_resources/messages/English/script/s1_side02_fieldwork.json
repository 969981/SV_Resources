    },
    {
      "ordinal": 34,
      "label": "s1_side02_fieldwork_sazare_pokehint_11",
      "hash64": "28337255EE03C60A",
      "text": "The composition! The motifs! I think your skills\\nare wasted here in the backwater, helping me.\\c\\nOh, but before you abandon me...have you\\nbeen up around the water in the northwest?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
