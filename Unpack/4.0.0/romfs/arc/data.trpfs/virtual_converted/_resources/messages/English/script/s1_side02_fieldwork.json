  "entries": [
    {
      "ordinal": 0,
      "label": "s1_side02_fieldwork_sazare_01",
      "hash64": "F616E2094F612834",
      "text": "Ready to go photograph some Pokémon and\\nsurvey the forest for me?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
