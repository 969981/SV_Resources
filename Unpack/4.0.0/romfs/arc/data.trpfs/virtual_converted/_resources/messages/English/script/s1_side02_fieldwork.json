      "label": "s1_side02_fieldwork_stop_02",
      "hash64": "421AF4F3799279F9",
      "text": "Okay, let’s call it! We’re all done for tonight!",
      "flags": 4,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
