          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 41,
      "label": "s1_side02_fieldwork_sazare_pokemiss_04",
      "hash64": "F2ED7A8CBD3DE1DF",
      "text": "Hmm... Yeah, I don’t think the machine can get\\nmuch from images so small. Can’t you get closer?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 42,
      "label": "s1_side02_fieldwork_sazare_pokemiss_05",
      "hash64": "F2ED798CBD3DE02C",
      "text": "Hmm... Looks like the machine can’t use your\\nphoto data.\\c\\nI guess it’s too hard to get a clear reading when\\na Pokémon is in the process of running away?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
