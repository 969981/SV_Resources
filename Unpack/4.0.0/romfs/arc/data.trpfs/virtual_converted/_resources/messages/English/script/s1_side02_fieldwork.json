          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 1,
      "label": "s1_side02_fieldwork_select_01",
      "hash64": "2CEBE680396E0930",
      "text": "Reporting for survey duty!",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 2,
      "label": "s1_side02_fieldwork_select_02",
      "hash64": "2CEBE980396E0E49",
      "text": "Maybe another time...",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
    {
      "ordinal": 3,
      "label": "s1_side02_fieldwork_sazare_02",
      "hash64": "F616E5094F612D4D",
      "text": "Then let’s hang in the tent until the weather gets\\nnice and foggy.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 66,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 4,
      "label": "s1_side02_fieldwork_sazare_03",
      "hash64": "F616E4094F612B9A",
      "text": "Looks like this is about as good as it’s gonna get.\\nAll right, partner! Get out there and survey![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 5,
      "label": "s1_side02_fieldwork_sazare_poke_01",
      "hash64": "AA2CC08F9F94C910",
      "text": "Took a new photo? Lemme see...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 30,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 6,
      "label": "s1_side02_fieldwork_sazare_pokeget_01",
      "hash64": "3BDDBC0B859F461C",
      "text": "That’s the Imitation Pokémon, Sudowoodo! It’s\\nreal easy to mistake it for a tree in this fog.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 7,
      "label": "s1_side02_fieldwork_sazare_pokeget_02",
      "hash64": "3BDDBF0B859F4B35",
      "text": "The Candle Pokémon, Litwick! Seeing those little\\nlights floating in the dark is otherworldly, huh?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 8,
      "label": "s1_side02_fieldwork_sazare_pokeget_03",
      "hash64": "3BDDBE0B859F4982",
      "text": "The Calm Pokémon, Hatenna, huh? Must feel\\nright at home in a quiet forest like this.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 9,
      "label": "s1_side02_fieldwork_sazare_pokeget_04",
      "hash64": "3BDDB90B859F4103",
      "text": "It’s the Rock Pokémon, Geodude! You’ve gotta\\nbe careful, or you might trip over this fella![VAR 0x0114(0046)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 10,
      "label": "s1_side02_fieldwork_sazare_pokeget_05",
      "hash64": "3BDDB80B859F3F50",
      "text": "That’s the Toxic Lizard Pokémon, Salandit, right?\\nSneaking up on some prey in the dark, maybe?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "s1_side02_fieldwork_sazare_pokeget_06",
      "hash64": "3BDDBB0B859F4469",
      "text": "The Stag Beetle Pokémon, Vikavolt! Those huge\\njaws it has make for a real killer photo![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "s1_side02_fieldwork_sazare_pokeget_07",
      "hash64": "3BDDBA0B859F42B6",
      "text": "The Firefly Pokémon, Illumise! Word has it that it\\ngets along real well with Volbeat.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 85,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "s1_side02_fieldwork_sazare_pokeget_08",
      "hash64": "3BDDC50B859F5567",
      "text": "That’s the Acorn Pokémon, Seedot...right?! Pretty\\neasy to mistake it for a Berry or something![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "s1_side02_fieldwork_sazare_pokeget_09",
      "hash64": "3BDDC40B859F53B4",
      "text": "That’s the String Spit Pokémon, Spinarak! Do you\\nthink it’s trying to spin up a new web in the trees?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 101,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "s1_side02_fieldwork_sazare_pokeget_10",
      "hash64": "3BDA370B859C2E46",
      "text": "The Cheeky Pokémon, Skwovet! What would you\\nbet it’s looking for food from up in the trees?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 91,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "s1_side02_fieldwork_sazare_pokeget_11",
      "hash64": "3BDA380B859C2FF9",
      "text": "The Water Weed Pokémon, Lotad! Now that’s\\nthe good life, just floating around like that...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "s1_side02_fieldwork_sazare_pokeget_12",
      "hash64": "3BDA350B859C2AE0",
      "text": "The EleFish Pokémon, Tynamo! You’ve got a real\\nknack for this, spotting something so tiny![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "s1_side02_fieldwork_sazare_pokeget_13",
      "hash64": "3BDA360B859C2C93",
      "text": "The Firefly Pokémon, Volbeat, huh? I heard it can\\ndraw shapes using the light on its rear end![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 94,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "s1_side02_fieldwork_sazare_pokeget_14",
      "hash64": "3BDA3B0B859C3512",
      "text": "The Requiem Pokémon, Duskull... It makes quite\\nthe impression on a dark night like this![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 88,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "s1_side02_fieldwork_sazare_pokeget_15",
      "hash64": "3BDA3C0B859C36C5",
      "text": "The Owl Pokémon, Hoothoot! I’ve always wanted\\nto get a shot of it switching the foot it stands on.[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 98,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "s1_side02_fieldwork_sazare_pokeget_16",
      "hash64": "3BDA390B859C31AC",
      "text": "You got both the Firefly Pokémon, Volbeat and\\nIllumise! They look so good together. Great shot![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 95,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "s1_side02_fieldwork_sazare_pokeget_17",
      "hash64": "3BDA3A0B859C335F",
      "text": "The Firefly Pokémon, Illumise! I bet that Volbeat\\nshowed up just to be with it, huh?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 23,
      "label": "s1_side02_fieldwork_sazare_pokeget_18",
      "hash64": "3BDA3F0B859C3BDE",
      "text": "The Firefly Pokémon, Volbeat! I bet that Illumise\\nshowed up just to be with it, huh?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 24,
      "label": "s1_side02_fieldwork_sazare_pokehint_01",
      "hash64": "28306E55EE018967",
      "text": "This is great! I knew you were the right person\\nfor the job![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 60,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 25,
      "label": "s1_side02_fieldwork_sazare_pokehint_02",
      "hash64": "28306F55EE018B1A",
      "text": "You really do take great photos, partner!\\c\\nHave you tried turning your eyes upward, too?\\nThere may be Pokémon lurking up in the trees...[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 41,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 138,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 26,
      "label": "s1_side02_fieldwork_sazare_pokehint_03",
      "hash64": "28307055EE018CCD",
      "text": "You have a real eye for photography, partner!\\c\\nI bet you could even get great shots of Pokémon\\nthat refuse to sit still and always wander around![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 147,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 27,
      "label": "s1_side02_fieldwork_sazare_pokehint_04",
      "hash64": "28306955EE0180E8",
      "text": "That’s my partner for you!\\c\\nYou know, I bet there could be Pokémon in caves\\nnearby too. You could probably snap some shots![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 26,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 125,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 28,
      "label": "s1_side02_fieldwork_sazare_pokehint_05",
      "hash64": "28306A55EE01829B",
      "text": "You’ve got a real knack for this sort of thing!\\c\\nI bet getting those Pokémon that hang near the\\nwater in the northwest part of the forest would\\r\\nbe a walk in the park for someone like you![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 47,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 192,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 29,
      "label": "s1_side02_fieldwork_sazare_pokehint_06",
      "hash64": "28306B55EE01844E",
      "text": "Nice... You’ve done some real fine work here!\\c\\nOh, one tip from me? Watch your footing when\\nyou get to that area with all the rocks—I tripped\\r\\nand nearly faceplanted in the dark![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 45,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 143,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 182,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 30,
      "label": "s1_side02_fieldwork_sazare_pokehint_07",
      "hash64": "28306C55EE018601",
      "text": "So it looks like you’ve got a real good handle on\\nhow to take photos by now, huh?\\c\\nI bet you even know that some Pokémon are so\\nwary they’ll run if you get too close! You’ve gotta\\r\\nbe careful if you wanna catch them on film![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 181,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 228,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 31,
      "label": "s1_side02_fieldwork_sazare_pokehint_08",
      "hash64": "28306555EE017A1C",
      "text": "You are getting all kinds of different Pokémon\\nin your photos!\\c\\nIt can be tricky—like with Ghost-type Pokémon!\\nSnapping a photo of one before it disappears\\r\\nrequires a quick shutter finger![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 62,
          "count": 1,
          "code_hex": "BE01",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 157,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 193,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "0046"
          ]
        }
      ]
    },
    {
      "ordinal": 32,
      "label": "s1_side02_fieldwork_sazare_pokehint_09",
      "hash64": "28306655EE017BCF",
      "text": "Mm-hmm! You’re getting real practiced at\\ncatching Pokémon out and about their daily lives.\\c\\nI’d guess you could even catch Pokémon up in\\nthe trees searching for their next meal![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
