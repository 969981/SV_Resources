      ]
    },
    {
      "ordinal": 38,
      "label": "s1_side02_fieldwork_sazare_pokemiss_01",
      "hash64": "F2ED758CBD3DD960",
      "text": "Huh...? Wait, this picture doesn’t contain a single\\nPokémon, does it?![VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 70,
