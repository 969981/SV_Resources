      "hash64": "421AF1F3799274E0",
      "text": "Do you want to end your survey early?",
      "flags": 0,
      "text_status": "DECODED",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": []
    },
