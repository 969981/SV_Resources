    {
      "ordinal": 53,
      "label": "s1_side02_fieldwork_sazare_talk_01",
      "hash64": "2CE0B73D259EFFA9",
      "text": "How’s the survey coming along, partner?[VAR 0x0114(0046)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 39,
