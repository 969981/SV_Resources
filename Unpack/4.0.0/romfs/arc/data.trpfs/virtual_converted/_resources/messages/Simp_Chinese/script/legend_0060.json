      "ordinal": 27,
      "label": "legend_0070_friend_02",
      "hash64": "57B1721CCCF5997E",
      "text": "你一定会恢复得超级棒的。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 12,
          "count": 2,
