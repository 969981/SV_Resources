      "ordinal": 29,
      "label": "legend_0070_friend_04",
      "hash64": "57B1741CCCF59CE4",
      "text": "我们要像以前一样……[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
