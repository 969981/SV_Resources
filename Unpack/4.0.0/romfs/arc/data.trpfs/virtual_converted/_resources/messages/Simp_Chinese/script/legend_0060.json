      "ordinal": 26,
      "label": "legend_0070_friend_01",
      "hash64": "57B1711CCCF597CB",
      "text": "獒教父，我现在就拿给你吃。[VAR 0x0114(0006)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
