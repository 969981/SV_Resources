    {
      "ordinal": 1,
      "label": "sdc02_0180_dragonbb_02",
      "hash64": "6A5BB9E1902FAFCC",
      "text": "블루베리그 공식 시합도\\n여기에서 신청하면 돼.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
