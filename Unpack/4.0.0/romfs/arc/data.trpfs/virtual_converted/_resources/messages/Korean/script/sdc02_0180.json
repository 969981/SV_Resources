    },
    {
      "ordinal": 21,
      "label": "sdc02_0180_dragonbb_14",
      "hash64": "6A5F45E19032D387",
      "text": "다른 사천왕 녀석들과\\n함께 응원할 테니까.[VAR 0x0114(004A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 23,
          "count": 2,
