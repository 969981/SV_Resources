            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 11,
      "label": "common_0060_head_teacher_11",
      "hash64": "0FFA4DF97A070C92",
      "text": "Oh...?[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 6,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 12,
      "label": "common_0060_head_teacher_03",
      "hash64": "0FF6CBF97A03F9D5",
      "text": "Che sorpresa! Pare che siano più interessati a lei\\nche a questo vecchio Preside, eh?[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 84,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 13,
      "label": "common_0060_head_teacher_04",
      "hash64": "0FF6C4F97A03EDF0",
      "text": "Sono molto curioso di sapere quale sarà la sua\\nscelta, ma per il momento devo andare...\\r\\nUn’altra studentessa mi attende.[VAR 0x0114(000A)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 123,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 14,
      "label": "common_0060_head_teacher_05",
      "hash64": "0FF6C5F97A03EFA3",
      "text": "Io sarò in quella casa laggiù. Ci pensi bene,\\ne quando avrà fatto la sua scelta venga a\\r\\nriferirmelo.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 87,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 103,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 15,
      "label": "common_0060_head_teacher_06",
      "hash64": "0FF6C6F97A03F156",
      "text": "E adesso, vogliate scusarmi.\\nI miei omaggi, signora.[VAR 0x0114(000A)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 52,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "000A"
          ]
        }
      ]
    },
    {
      "ordinal": 16,
      "label": "common_0060_mama_01",
      "hash64": "3C5488FF337D9E1E",
      "text": "Non ho mai incontrato una persona così educata\\ncome il tuo Preside! Che modi raffinati...![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 90,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 17,
      "label": "common_0060_mama_02",
      "hash64": "3C5487FF337D9C6B",
      "text": "E questi Pokémon sono tutti e tre dei tesori...\\nCome si fa a sceglierne uno solo?[VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 81,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 18,
      "label": "common_0060_mama_03",
      "hash64": "3C5486FF337D9AB8",
      "text": "Dato che il Preside è stato così gentile da darti\\nun po’ di tempo, che ne dici di farti una bella\\r\\npasseggiata con loro, per conoscerli meglio?[VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 97,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 145,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 19,
      "label": "common_0060_mama_04",
      "hash64": "3C548DFF337DA69D",
      "text": "Vedrai, è il metodo migliore per saperne di più\\nsu di loro![VAR 0x0114(002B)]",
      "flags": 0,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 59,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 20,
      "label": "common_0060_mama_05",
      "hash64": "3C548CFF337DA4EA",
      "text": "Ah, prima che tu vada... Tieni, eccoti un piccolo\\nregalo per festeggiare il tuo primo giorno!\\r\\nPortalo con te quando vai in giro, d’accordo?[VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 93,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 142,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 21,
      "label": "common_0060_mama_06",
      "hash64": "3C548BFF337DA337",
      "text": "È uno smartphone nuovo di zecca! Vediamo cosa\\ndice il manuale d’istruzioni...\\c\\n\"Se ti perdi, premi il [VAR 0xFF00(0006)]pulsante Y[VAR 0xFF00(0000)]!\"\\nMa pensa! Oggigiorno gli smartphone hanno\\r\\npersino una mappa... Mica male![VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
      "label_encoding_status": "UTF8",
      "label_raw_hex": null,
      "tokens": [
        {
          "kind": "control",
          "offset_units": 77,
          "count": 1,
