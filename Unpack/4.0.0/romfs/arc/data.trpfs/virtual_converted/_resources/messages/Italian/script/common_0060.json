          "args_hex": [
            "0006"
          ]
        },
        {
          "kind": "control",
          "offset_units": 118,
          "count": 2,
          "code_hex": "FF00",
          "args_hex": [
            "0000"
          ]
        },
        {
          "kind": "control",
          "offset_units": 166,
          "count": 1,
          "code_hex": "BE00",
          "args_hex": []
        },
        {
          "kind": "control",
          "offset_units": 201,
          "count": 2,
          "code_hex": "0114",
          "args_hex": [
            "002B"
          ]
        }
      ]
    },
    {
      "ordinal": 22,
      "label": "common_0060_mama_07",
      "hash64": "3C548AFF337DA184",
      "text": "E ora vai, su! Buona passeggiata![VAR 0x0114(002B)]",
      "flags": 4,
      "text_status": "CONTROL_PARTIAL",
