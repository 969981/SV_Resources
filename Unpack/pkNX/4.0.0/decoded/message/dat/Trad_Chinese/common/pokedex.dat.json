  "\u9084\u5DEE\u4E00\u9EDE\u5C31\u80FD\u5B8C\u6210\\n\u5317\u4E0A\u5716\u9451\u4E86\uFF01\\c\\n\u76F8\u4FE1[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u4E00\u5B9A\u80FD\u5920\u5B8C\u6210\u7684\uFF01\\c",
  "\u5317\u4E0A\u5716\u9451\u5B8C\u6210\u4E86\uFF01\\c\\n\u7531\u8877\u5730\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u70BA\u9047\u5230\u6240\u6709\u5BF6\u53EF\u5922\\n\u800C\u4ED8\u51FA\u7684\u52AA\u529B\u8868\u793A\u795D\u8CC0\u3002\\c\\n\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C[VAR 0100(0000)]\uFF01\\c",
  "\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5B8C\u6210\u5317\u4E0A\u5716\u9451\uFF01",
  "\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5B8C\u6210\u85CD\u8393\u5716\u9451\uFF01",
  "\u85CD\u8393\u5716\u9451",
  "\u606D\u559C\uFF01\\n\u73FE\u5728\u85CD\u8393\u5716\u9451\u4E00\u5171\u6709[VAR 0202(0000)]\u672C\u4E86\uFF01\\c\\n\u70BA\u4E86\u8868\u793A\u795D\u8CC0\uFF0C\\n\u8D08\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3[VAR 0202(0002)]\u500B[VAR 0109(0001)]\uFF01\\c",
  "\u606D\u559C\uFF01\\n\u73FE\u5728\u85CD\u8393\u5716\u9451\u4E00\u5171\u6709[VAR 0202(0000)]\u672C\u4E86\uFF01\\c\\n\u70BA\u4E86\u8868\u793A\u795D\u8CC0\uFF0C\\n\u8D08\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3[VAR 0202(0002)]\u500B[VAR 0109(0001)]\uFF01\\c",
  "\u592A\u3001\u592A\u53B2\u5BB3\u4E86\uFF01\\n\u85CD\u8393\u5716\u9451\u5B8C\u6210\u4E86\uFF01\\c\\n\u9019\u4EE3\u8868[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u5DF2\u7D93\u9047\u898B\u4E86\u85CD\u8393\u5B78\u5712\\r\\n\u6240\u6709\u7684\u5BF6\u53EF\u5922\u4E86\uFF01\\c\\n\u9019\u5834[VAR 1100(00FF,0101)]\u4F60\u59B3\u89AA\u81EA\u7528\u96D9\u817F\u8D70\u904D\u5404\u8655\u7684\u5192\u96AA\uFF0C\\n\u5C07\u6703\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7121\u53EF\u53D6\u4EE3\u7684\u5BF6\u7269\u2026\u2026\\c\\n\u70BA\u4E86\u8868\u63DA[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u9019\u4EFD\u69AE\u8000\u2026\u2026\\c\\n\u8ACB\u5230\u85CD\u8393\u5B78\u5712\u7684\u5165\u53E3\\n\u627E\u5E2D\u85CD\u5427\uFF01\\c",
  "\u5728\u751F\u614B\u5DE8\u86CB\u5230\u8655\u8D70\u8D70\uFF0C\\n\u5C0B\u627E\u5BF6\u53EF\u5922\u5427\uFF01\\c\\n\u5BF6\u53EF\u5922\u6703\u5728\uFF14\u500B\u5340\u57DF\u88E1\\n\u5404\u5F0F\u5404\u6A23\u7684\u5730\u65B9\u51FA\u73FE\u5594\uFF01\\c",
  "\u751F\u614B\u5DE8\u86CB\u7684\u5929\u7A7A\\n\u6703\u96A8\u8457\u73FE\u5BE6\u7684\u6642\u9593\u800C\u8B8A\u5316\uFF01\\c\\n\u5373\u4F7F\u662F\u540C\u500B\u5730\u65B9\uFF0C\u5728\u4E0D\u540C\u6642\u6BB5\\n\u51FA\u73FE\u7684\u5BF6\u53EF\u5922\u4E5F\u6703\u6709\u8B8A\u5316\u5594\uFF01\\c",
  "\u9084\u5DEE\u4E00\u9EDE\u5C31\u80FD\u5B8C\u6210\\n\u85CD\u8393\u5716\u9451\u4E86\uFF01\\c\\n\u76F8\u4FE1[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u4E00\u5B9A\u80FD\u5920\u5B8C\u6210\u7684\uFF01\\c",
  "\u85CD\u8393\u5716\u9451\u5B8C\u6210\u4E86\uFF01\\c\\n\u7531\u8877\u5730\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u70BA\u9047\u5230\u6240\u6709\u5BF6\u53EF\u5922\\n\u800C\u4ED8\u51FA\u7684\u52AA\u529B\u8868\u793A\u795D\u8CC0\u3002\\c\\n\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C[VAR 0100(0000)]\uFF01\\c"
]
