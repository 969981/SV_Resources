  "\u8981\u5BEB\u5165\u7D00\u9304\uFF0C\u4E26\u7528[VAR 0204(0001,0000)]\uFF22\uFF30\\n\u5217\u5370[VAR 0201(0002)]\u6B21\u55CE\uFF1F",
  "\u90A3\u500B\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u6389\u843D\u7269\u597D\u50CF\u4E0D\u5920\u5594\uFF01",
  "\u90A3\u500B\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\uFF22\uFF30\u597D\u50CF\u4E0D\u5920\u5594\uFF01",
  "\u6B63\u5728\u5BEB\u5165\u7D00\u9304\u2026\u2026\\n\u8ACB\u7A0D\u5019\u7247\u523B\u3002",
  "\u9053\u5177\u5217\u5370\u51FA\u4F86\u4E86\uFF01\\n\u6211\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u653E\u9032\u5305\u5305\u5427\uFF01",
  "\u9053\u5177\u5217\u5370\u51FA\u4F86\u4E86\uFF01\\n\u6211\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u653E\u9032\u5305\u5305\u5427\uFF01",
  "\u8036\uFF0C\u771F\u5E78\u904B\uFF01\\n\u9053\u5177\uFF12\u500D\u6A5F\u6703\u958B\u59CB\u4E86\u5537\uFF5E\uFF01",
  "\u5929\u3001\u5929\u3001\u5929\u554A\uFF01\\n\u7A00\u6709\u7CBE\u9748\u7403\u6A5F\u6703\u958B\u59CB\u4E86\u5537\uFF5E\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u6536\u56DE\u6389\u843D\u7269\uFF0C\\n\u4E0D\u5217\u5370\u4E86\u55CE\uFF1F",
  "\u591A\u8667\u6709[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u5217\u5370\u4E86\u9019\u9EBC\u591A\u6B21\uFF0C\\c\\n\u6211\u4F3C\u4E4E\u53EF\u4EE5\\n\u6539\u826F\u5217\u5370\u6A5F\u7684\u6027\u80FD\u4E86\uFF01",
  "\u591A\u8667\u6709[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u5217\u5370\u4E86\u9019\u9EBC\u591A\u6B21\uFF0C\\c\\n\u6211\u4F3C\u4E4E\u53EF\u4EE5\u518D\u9032\u4E00\u6B65\\n\u6539\u826F\u5217\u5370\u6A5F\u7684\u6027\u80FD\u4E86\uFF01",
  "\u591A\u8667\u6709[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u5217\u5370\u4E86\u9019\u9EBC\u591A\u6B21\uFF0C\\c\\n\u6211\u4F3C\u4E4E\u53EF\u4EE5\u5C07\u5217\u5370\u6A5F\u7684\u6027\u80FD\\n\u6539\u826F\u5230\u6700\u7D42\u968E\u6BB5\u4E86\uFF01",
  "\u8981\u6539\u826F\u5217\u5370\u6A5F\u7684\u6027\u80FD\uFF0C\\n\u9700\u8981[VAR 0204(0001,0000)]\uFF22\uFF30\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u78BA\u5B9A\u8981\u9032\u884C\u6539\u826F\u55CE\uFF1F",
  "\u8981\u6539\u826F\u662F\u5427\u3002\u6536\u5230\uFF01\\n\u90A3\u6211\u7ACB\u523B\u52D5\u624B\uFF01",
  "\u2026\u2026\u563F\u55B2\uFF01\u563F\u54BB\uFF01\uFF01",
  "\u547C\u2026\u2026\u6539\u826F\u5B8C\u7562\uFF01\\c\\n\u5217\u5370\u6642\u6240\u9700\u7684\u6389\u843D\u7269\\n\u548C\uFF22\uFF30\u8B8A\u5C11\u4E86\u5537\uFF01\\c\\n\u6211\u9084\u8FFD\u52A0\u4E86\u80FD\u5217\u5370\u51FA\uFF12\u500D\u9053\u5177\u7684\\n[VAR FF00(0006)]\u9053\u5177\uFF12\u500D\u6A5F\u6703[VAR FF00(0000)]\u5537\uFF01\\c\\n\u96D6\u7136\u548C\u6027\u80FD\u6C92\u6709\u95DC\u4FC2\uFF0C\\n\u4F46\u5916\u89C0\u4E5F\u6539\u6210\u8D85\u7D1A\u7684\u6A23\u5B50\u4E86\u5537\uFF01\\r\\n\u6240\u4EE5\uFF0C\u8B93\u6211\u7E7C\u7E8C\u554F[VAR 1100(00FF,0101)]\u4F60\u59B3\u2026\u2026",
  "\u547C\u2026\u2026\u7B2C\uFF12\u968E\u6BB5\u6539\u826F\u5B8C\u7562\uFF01\\c\\n\u5217\u5370\u6642\u6240\u9700\u7684\u6389\u843D\u7269\\n\u548C\uFF22\uFF30\u8B8A\u5C11\u4E86\u5537\uFF01\\c\\n\u6211\u9084\u8FFD\u52A0\u4E86[VAR FF00(0006)]\u7A00\u6709\u7CBE\u9748\u7403\u6A5F\u6703[VAR FF00(0000)]\u5537\uFF01\\n\u8AAA\u4E0D\u5B9A\u6703\u5217\u5370\u51FA\u5C11\u898B\u7684\u7CBE\u9748\u7403\u5462\uFF01\uFF1F\\c\\n\u96D6\u7136\u548C\u6027\u80FD\u6C92\u6709\u95DC\u4FC2\uFF0C\\n\u4F46\u5916\u89C0\u4E5F\u6539\u6210\u9AD8\u7D1A\u7684\u6A23\u5B50\u4E86\u5537\uFF01\\r\\n\u6240\u4EE5\uFF0C\u8B93\u6211\u7E7C\u7E8C\u554F[VAR 1100(00FF,0101)]\u4F60\u59B3\u2026\u2026",
  "\u547C\u2026\u2026\u6700\u7D42\u6539\u826F\u5B8C\u7562\uFF01\\c\\n\u73FE\u5728\u53EF\u4EE5\u4E00\u6B21\u5217\u5370\u51FA\\n\u597D\u5E7E\u500B\u9053\u5177\u4E86\u5537\uFF01\\c\\n\u800C\u4E14\u9084\u80FD\u5217\u5370\u51FA\\n\u661F\u6676\u592A\u6676\u788E\u584A\u4E86\u5537\uFF01\\c\\n\u96D6\u7136\u548C\u6027\u80FD\u6C92\u6709\u95DC\u4FC2\uFF0C\\n\u4F46\u5916\u89C0\u4E5F\u6539\u6210\u5927\u5E2B\u7684\u6A23\u5B50\u4E86\u5537\uFF01\\c\\n\u771F\u7684\u5F88\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u5354\u52A9\u6211\u5011\u7684\u7814\u7A76\uFF01\\r\\n\u6240\u4EE5\uFF0C\u8B93\u6211\u7E7C\u7E8C\u554F[VAR 1100(00FF,0101)]\u4F60\u59B3\u2026\u2026",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8A66\u7528\u5217\u5370\u6A5F\u7684\u6B21\u6578\\n\u9084\u4E0D\u5920\u8B93\u6211\u5011\u6539\u826F\u5B83\u7684\u6027\u80FD\u5462\u2026\u2026",
  "\u5217\u5370\u6A5F\u7684\u6027\u80FD\\n\u5DF2\u7D93\u6539\u826F\u5230\u6975\u81F4\u4E86\u5537\uFF01",
  "\u6211\u5011\u6B63\u5728\u7814\u7A76\u5982\u4F55\\n\u5C07\u5217\u5370\u6A5F\u7684\u6027\u80FD\u6539\u826F\u5F97\u66F4\u597D\u5537\uFF01"
]
