[
  "\u6700\u5F8C\u4E00\u5802\u8AB2\u4E5F\u8981\u6D3B\u529B\u6EFF\u5206\uFF01\\n\u563F\u5440\uFF01\u7D2E\u7D2E\u5BE6\u5BE6\u5283\u4E0B\u53E5\u9EDE\u5427\uFF01[VAR 0114(0024)]",
  "\u5404\u4F4D\u540C\u5B78\u7684\u77E5\u8B58\\n\u5DF2\u7D93\u5341\u5206\u5F37\u5927\u4E86\uFF01[VAR 0114(0024)]",
  "\u6211\u5E7E\u4E4E\u5DF2\u7D93\u6C92\u6709\\n\u53EF\u4EE5\u6559\u4F60\u5011\u7684\u4E8B\u60C5\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u4F46\u70BA\u4E86\u4EE5\u66F4\u9AD8\u7684\u5883\u754C\u70BA\u76EE\u6A19\uFF01[VAR 0114(0024)]",
  "\u4ECA\u5929\u5C31\u8ACB\u5404\u4F4D\u8A18\u4F4F\\n\u9023\u7DDA\u5C0D\u6230\u7684\u898F\u5247\u5427\uFF01[VAR 0114(0024)]",
  "\u9023\u7DDA\u5C0D\u6230\u6642\uFF0C\u82E5\u662F\uFF12\u500B\u4EBA\\n\u5C31\u53EF\u4EE5\u9032\u884C\u55AE\u6253\u5C0D\u6230\u6216\u96D9\u6253\u5C0D\u6230\uFF01[VAR 0114(0024)]",
  "\u5982\u679C\u805A\u96C6\u4E86\uFF14\u500B\u670B\u53CB\uFF0C\\n\u5C31\u53EF\u4EE5\u9032\u884C\u591A\u4EBA\u5C0D\u6230\u5594\uFF01[VAR 0114(0024)]",
  "\u5728\u6821\u5916\u7814\u7A76\u4E2D\u7684\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\\n\u6D3E\u4E0A\u5834\u7684\u5BF6\u53EF\u5922\u7684\u6578\u91CF\u6216\u5BE6\u529B\\r\\n\u90FD\u6C92\u6709\u53D7\u5230\u9650\u5236\uFF0C\u5C0D\u5427\uFF01[VAR 0114(0024)]",
  "\u4F46\u9023\u7DDA\u5C0D\u6230\u6642\uFF0C\\n\u662F\u6703\u6709\u5E7E\u500B\u898F\u5B9A\u7684\uFF01[VAR 0114(0024)]",
  "\u9996\u5148\u662F\u7B49\u7D1A\u8ABF\u6574\uFF01[VAR 0114(0024)]",
  "\u4F8B\u5982\u5728[VAR FF00(0006)]\u7121\u9650\u5236[VAR FF00(0000)]\u7684\u898F\u5247\u4E2D\uFF0C\\n\u5BF6\u53EF\u5922\u7684\u7B49\u7D1A\u6703\u7DAD\u6301\u73FE\u72C0\uFF01\\r\\n\u6709\u591A\u96BB\u76F8\u540C\u7684\u540C\u884C\u5BF6\u53EF\u5922\uFF0C\\r\\n\u6216\u662F\u651C\u5E36\u8457\u76F8\u540C\u6301\u6709\u7269\uFF0C\u4E5F\u90FD\uFF2F\uFF2B\uFF01[VAR 0114(0024)]",
  "\u800C[VAR FF00(0006)]\u666E\u901A\u898F\u5247[VAR FF00(0000)]\uFF0C\\n\u5247\u662F\u4E0D\u8AD6\u591A\u5F37\u7684\u5BF6\u53EF\u5922\\r\\n\u90FD\u6703\u88AB\u8ABF\u6574\u6210\u7B49\u7D1A\uFF15\uFF10\u4F86\u4E00\u6C7A\u9AD8\u4E0B\uFF01[VAR 0114(0024)]",
  "\u5373\u4F7F\u662F\u7B49\u7D1A\u4E0D\u9AD8\u7684\u5BF6\u53EF\u5922\\n\u4E5F\u80FD\u767C\u63EE\u6210\u9577\u4E4B\u5F8C\u7684\u529B\u91CF\uFF01[VAR 0114(0024)]",
  "\u5728\u9019\u500B\u898F\u5247\u88E1\u8981\u7528\u76F8\u540C\u7684\u5BF6\u53EF\u5922\u6216\\n\u8B93\u7260\u5011\u651C\u5E36\u76F8\u540C\u7684\u6301\u6709\u7269\uFF0C\u4E5F\u662F\uFF2F\uFF2B\u7684\uFF01[VAR 0114(0024)]",
  "\u53EA\u8981\u5B78\u6703\u4E86\u62DB\u5F0F\uFF0C\u5373\u4F7F\u7B49\u7D1A\u6C92\u6709\u63D0\u5347\\n\u4E5F\u80FD\u8B93\u5BF6\u53EF\u5922\u5927\u5C55\u8EAB\u624B\u3002\\r\\n\u9019\u5C31\u662F\u666E\u901A\u898F\u5247\u7684\u512A\u9EDE\uFF01[VAR 0114(0024)]",
  "\u6700\u5F8C\u662F[VAR FF00(0006)]\u53D7\u9650\u898F\u5247[VAR FF00(0000)]\u3002\u5728\u9019\u500B\u898F\u5247\u4E2D\uFF0C\\n\u7B49\u7D1A\uFF15\uFF10\u4EE5\u4E0A\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u6703\u88AB\u7D71\u4E00\u8ABF\u6574\u70BA\u7B49\u7D1A\uFF15\uFF10\uFF01[VAR 0114(0024)]",
  "\u53D7\u9650\u898F\u5247\uFF0C\\n\u662F\u6230\u8853\u6027\u6700\u9AD8\u7684\u898F\u5247\uFF01[VAR 0114(0024)]",
  "\u5728\u9019\u500B\u898F\u5247\u4E2D\\n\u7981\u6B62\u4F7F\u7528\u591A\u96BB\u76F8\u540C\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u4E5F\u7981\u6B62\u8B93\u5BF6\u53EF\u5922\u651C\u5E36\u76F8\u540C\u7684\u6301\u6709\u7269\uFF01[VAR 0114(0024)]",
  "\u4F86\uFF0C\u62BD\u8003\u6642\u9593\u5230\u4E86\uFF01[VAR 0114(0024)]",
  "\u666E\u901A\u898F\u5247\u8207\u53D7\u9650\u898F\u5247\u2026\u2026\\n\u523B\u610F\u8981\u4F7F\u7528\u7B49\u7D1A\u8F03\u4F4E\u7684\u5BF6\u53EF\u5922\u5C0D\u6230\u6642\uFF0C\\r\\n\u8A72\u9078\u64C7\u54EA\u4E00\u7A2E\u898F\u5247\u6BD4\u8F03\u597D\u5462\uFF1F[VAR 0114(0024)]",
  "\u666E\u901A\u898F\u5247",
  "\u53D7\u9650\u898F\u5247",
  "\u771F\u53EF\u60DC\uFF01\u5728\u666E\u901A\u898F\u5247\u4E2D\uFF0C\\n\u5373\u4F7F\u5BF6\u53EF\u5922\u7684\u7B49\u7D1A\u4E0D\u9AD8\uFF0C\\r\\n\u4E5F\u6703\u88AB\u7D71\u4E00\u8ABF\u6574\u70BA\u7B49\u7D1A\uFF15\uFF10\u5462\uFF01[VAR 0114(0024)]",
  "\u4E0D\u6127\u662F\u8F49\u5B78\u751F\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u4ED4\u7D30\u5728\u807D\u8AB2\u5594\uFF01[VAR 0114(0024)]",
  "\u57FA\u65BC\u6230\u8853\u8003\u91CF\uFF0C\\n\u523B\u610F\u8981\u8B93\u7B49\u7D1A\uFF15\u7684\u5BF6\u53EF\u5922\u4E0A\u5834\u6642\uFF0C\\r\\n\u6700\u4F73\u9078\u64C7\u5C31\u662F\u7528\u53D7\u9650\u898F\u5247\u53BB\u5C0D\u6230\uFF01[VAR 0114(0024)]",
  "\u7576\u7136\uFF0C\u4EE5\u7121\u9650\u5236\u898F\u5247\u5C0D\u6230\u6642\uFF0C\\n\u4E0D\u8AD6\u662F\u5BF6\u53EF\u5922\u3001\u7B49\u7D1A\u6216\u6301\u6709\u7269\uFF0C\\r\\n\u90FD\u53EF\u4EE5\u96A8\u5FC3\u6240\u6B32\u5730\u7D44\u5408\uFF01[VAR 0114(0024)]",
  "\u5982\u679C\u662F\u8981\u548C\u670B\u53CB\u81EA\u7531\u5730\u5C0D\u6230\u7684\u8A71\uFF0C\\n\u9019\u500B\u898F\u5247\u662F\u518D\u9069\u5408\u4E0D\u904E\u4E86\uFF01[VAR 0114(0024)]",
  "\u7D50\u8AD6\uFF01\uFF01[VAR 0114(0024)]",
  "\u7B49\u7D1A\u4E00\u5F8B\uFF15\uFF10\u7684\u662F\u666E\u901A\u898F\u5247\uFF0C\\n\u7B49\u7D1A\u4E0D\u9AD8\u4E5F\u884C\u5F97\u901A\u7684\u662F\u53D7\u9650\u898F\u5247\uFF01[VAR 0114(0024)]",
  "\u8207\u670B\u53CB\u4E00\u8D77\u6253\u51FA\\n\u8B93\u5FC3\u96C0\u8E8D\u4E0D\u5DF2\u7684\u706B\u71B1\u5C0D\u6230\u5427\uFF01[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u539F\u672C\u6253\u7B97\u8B93\u5404\u4F4D\u89AA\u8EAB\u9AD4\u9A57\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u6642\u9593\u5DF2\u7D93\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u4E0B\u4E00\u5802\u8AB2\u8981\u8003\u671F\u672B\u8003\u56C9\uFF01\\n\u7784\u6E96\uFF11\uFF10\uFF10\u5206\uFF01\u563F\u5440\uFF01\u563F\u5440\uFF01[VAR 0114(0024)]"
]
