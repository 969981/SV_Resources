[
  "\u55E8\uFF0C\u540C\u5B78\u5011\uFF0C\\n\u4F60\u5011\u53C8\u6BD4\u6628\u5929\u53E4\u8001\u4E00\u5929\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u4E5F\u8B93\u6211\u5011\u4E00\u8D77\u89E3\u958B\\n\u6B77\u53F2\u7684\u7F8E\u5999\u4E4B\u8655\u5427\u3002[VAR 0114(0027)]",
  "\u5728\u524D\u534A\u6BB5\u7684\u8AB2\u5802\u4E2D\u6211\u5011\u63D0\u5230\u4E86\\n\u5E15\u5E95\u4E9E\u5DE8\u5751\u4EE5\u53CA\u5B83\u7684\u5167\u90E8\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u7B2C\u96F6\u5340\uFF0C\u4F60\u5011\u90FD\u9084\u8A18\u5F97\u5427\u3002[VAR 0114(0027)]",
  "\u8B93\u7687\u5E1D\u4EE5\u53CA\u8A31\u591A\u4EBA\\n\u70BA\u4E4B\u760B\u72C2\u7684\u795E\u79D8\u5DE8\u5751\u2026\u2026[VAR 0114(0027)]",
  "\u64DA\u8AAA\u5728\u8DDD\u4ECA\uFF12\uFF10\uFF10\u5E74\u524D\uFF0C\\n\u7D42\u65BC\u6709\u4EBA\u62B5\u9054\u4E86\u90A3\u5730\u65B9\u7684\u6700\u6DF1\u8655\u3002[VAR 0114(0027)]",
  "\u5B8C\u6210\u9019\u9805\u5049\u696D\u7684\u662F\\n\u88AB\u7A31\u70BA\u7B2C\u96F6\u5340\u89C0\u6E2C\u968A\u7684\u968A\u4F0D\u3002[VAR 0114(0027)]",
  "\u89C0\u6E2C\u968A\u7684\u968A\u54E1\u6709\\n\u64C5\u9577\u5C0D\u6230\u7684\u4EBA\uFF0C\\r\\n\u4E5F\u6709\u77E5\u8B58\u8C50\u5BCC\u7684\u4EBA\u2026\u2026[VAR 0114(0027)]",
  "\u64DA\u8AAA\u662F\u53EC\u96C6\u4E86\u5E15\u5E95\u4E9E\\n\u624D\u83EF\u6D0B\u6EA2\u7684\u4EBA\u5011\u6240\u7D44\u6210\u7684\u3002[VAR 0114(0027)]",
  "\u968A\u54E1\u4E4B\u4E2D\uFF0C\\n\u6709\u500B\u7CBE\u901A\u535A\u7269\u5B78\u7684\u4F5C\u5BB6\uFF0C\\r\\n\u540D\u5B57\u53EB\u505A[VAR FF00(0006)]\u6D77\u54F2[VAR FF00(0000)]\u3002[VAR 0114(0027)]",
  "\u5F9E\u7B2C\u96F6\u5340\u56DE\u4F86\u4E4B\u5F8C\uFF0C\\n\u4ED6\u767C\u63EE\u4E86\u81EA\u5DF1\u7684\u6587\u5B78\u624D\u83EF\uFF0C\\r\\n\u64B0\u5BEB\u4E26\u4E14\u51FA\u7248\u4E86\u63A2\u96AA\u8A18\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u9EBC\uFF0C\u8ACB\u9019\u6642\u4E0D\u5E78\u8207\u6211\\n\u5C0D\u4E0A\u773C\u7684[VAR 0100(0000)]\u4F86\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u8B93\u6211\u8003\u8003[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u6C92\u6709\u5728\u807D\u8AB2\u3002\\n\u7B2C\u4E00\u652F\u62B5\u9054\u5DE8\u5751\u7684\u5167\u90E8\uFF0C\u4E5F\u5C31\u662F\\r\\n\u7B2C\u96F6\u5340\u6700\u6DF1\u8655\u7684\u968A\u4F0D\u7684\u540D\u7A31\u662F\uFF1F[VAR 0114(0027)]",
  "\u7B2C\u96F6\u5340\u5192\u96AA\u5718",
  "\u7B2C\u96F6\u5340\u89C0\u6E2C\u968A",
  "\u7B2C\u96F6\u5340\u8ABF\u67E5\u968A",
  "\u2026\u2026\u932F\u8AA4\uFF01\\n\u96E3\u9053[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u5C0D\u5192\u96AA\u4E00\u8A5E\\r\\n\u5FC3\u982D\u5C0F\u9E7F\u4E82\u649E\u55CE\u2026\u2026[VAR 0114(0027)]",
  "\u2026\u2026\u6B63\u78BA\u7B54\u6848\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u9023\u6211\u8F15\u8F15\u5E36\u904E\u7684\u5167\u5BB9\u90FD\u8A18\u4F4F\u4E86\uFF0C\\r\\n\u771F\u662F\u500B\u8070\u660E\u7684\u50A2\u4F19\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u932F\u8AA4\uFF01\\n\u96D6\u7136\u8ABF\u67E5\u548C\u89C0\u6E2C\uFF0C\\r\\n\u505A\u7684\u4E8B\u60C5\u8AAA\u7A7F\u4E86\u90FD\u4E00\u6A23\u5C31\u662F\u4E86\uFF01[VAR 0114(0027)]",
  "\u807D\u597D\u4E86\uFF01\u6B63\u78BA\u7684\u540D\u7A31\u662F\\n\u7B2C\u96F6\u5340\u89C0\u6E2C\u968A\uFF01[VAR 0114(0027)]",
  "\u89C0\u6E2C\u968A\u968A\u54E1\u6D77\u54F2\u6240\u5BEB\u7684\u63A2\u96AA\u8A18\uFF0C\\n\u73FE\u5728\u4E5F\u80FD\u5728\u66F8\u5E97\u7B49\u5730\u65B9\u898B\u5230\u3002[VAR 0114(0027)]",
  "\u5370\u8C61\u4E2D\uFF0C\\n\u66F8\u540D\u597D\u50CF\u662F\u53EB[VAR FF00(0006)]\u300A\u6731\u4E4B\u66F8\u300B[VAR FF00(0000)]\u3002[VAR 0114(0027)]",
  "\u5370\u8C61\u4E2D\uFF0C\\n\u66F8\u540D\u597D\u50CF\u662F\u53EB[VAR FF00(0006)]\u300A\u7D2B\u4E4B\u66F8\u300B[VAR FF00(0000)]\u3002[VAR 0114(0027)]",
  "\u7576\u6642\u5168\u5E15\u5E95\u4E9E\u90FD\u9677\u5165\u4E86\\n\u4E00\u80A1\u7B2C\u96F6\u5340\u71B1\u6F6E\u3002[VAR 0114(0027)]",
  "\u300A\u6731\u4E4B\u66F8\u300B\u66A2\u92B7\u5F97\u4E0D\u5F97\u4E86\uFF0C\\n\u53EF\u8AAA\u662F\u5230\u4E86\u4EBA\u624B\u4E00\u672C\u7684\u7A0B\u5EA6\u3002[VAR 0114(0027)]",
  "\u300A\u7D2B\u4E4B\u66F8\u300B\u66A2\u92B7\u5F97\u4E0D\u5F97\u4E86\uFF0C\\n\u53EF\u8AAA\u662F\u5230\u4E86\u4EBA\u624B\u4E00\u672C\u7684\u7A0B\u5EA6\u3002[VAR 0114(0027)]",
  "\u4F46\u5167\u5BB9\u537B\u5145\u6EFF\u4E86\u96E3\u4EE5\u7F6E\u4FE1\u7684\u63CF\u8FF0\uFF0C\\n\u8352\u8B2C\u900F\u9802\u7684\u63D2\u5716\uFF0C\u7C21\u76F4\u5C31\u662F\u7121\u7A3D\u4E4B\u8AC7\u2026\u2026\\r\\n\u65BC\u662F\u4E16\u4EBA\u7A31\u6D77\u54F2\u662F\u500B\u5927\u9A19\u5B50\u3002[VAR 0114(0027)]",
  "\u9023\u89C0\u6E2C\u968A\u662F\u5426\u771F\u7684\u62B5\u9054\u4E86\u6700\u6DF1\u8655\uFF0C\\n\u4E5F\u8B8A\u5F97\u4E0D\u6E05\u4E0D\u695A\u3002[VAR 0114(0027)]",
  "\u300A\u6731\u4E4B\u66F8\u300B\u5C31\u9019\u6A23\u88AB\u7576\u4F5C\u662F\u602A\u529B\u4E82\u795E\u7684\u66F8\uFF0C\\n\u4F54\u64DA\u4E86\u4E8C\u624B\u66F8\u5E97\u7684\u66F8\u67B6\u3002[VAR 0114(0027)]",
  "\u300A\u7D2B\u4E4B\u66F8\u300B\u5C31\u9019\u6A23\u88AB\u7576\u4F5C\u662F\u602A\u529B\u4E82\u795E\u7684\u66F8\uFF0C\\n\u4F54\u64DA\u4E86\u4E8C\u624B\u66F8\u5E97\u7684\u66F8\u67B6\u3002[VAR 0114(0027)]",
  "\u5165\u53E3\uFF11\u6A13\u7684\u66F8\u67B6\u4E0A\u4E5F\u6709\uFF0C\\n\u6709\u8208\u8DA3\u7684\u4EBA\u53EF\u4EE5\u53BB\u7FFB\u4E00\u7FFB\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u54CE\u5440\uFF1F\u6211\u592A\u591A\u8A71\u4E86\uFF0C\\n\u6642\u9418\u5DF2\u7D93\u8D70\u904E\u982D\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u7684\u8AB2\u5C31\u5230\u6B64\u70BA\u6B62\u3002\\n\u6211\u5011\u4E0B\u6B21\u4E5F\u7E7C\u7E8C\u89E3\u958B\u6B77\u53F2\u4E4B\u8B0E\u5427\u3002[VAR 0114(0027)]"
]
