[
  "\u9019\u88E1\u662F\u7FE0\u7DA0\u93AE\uFF0C\\n\u4EE5\u5927\u81EA\u7136\u548C\u860B\u679C\u51FA\u540D\u5594\u3002",
  "\u807D\u8AAA[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u5F9E\u6D77\u5916\u4F86\u9019\u88E1\u53C3\u52A0\\n\u590F\u4EE4\u71DF\u7684\u554A\uFF1F\u96E3\u602A\u6211\u6C92\u770B\u904E[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01",
  "\u4F86\u5F97\u53CA\u6E96\u5099\u55CE\uFF1F\\n\u5728\u6176\u5178\u8981\u8CE3\u7684\u6771\u897F\uFF0C\u9072\u9072\u6C92\u51FA\u8CA8\u5462\u2026\u2026",
  "\u6700\u8FD1\u6211\u554A\uFF0C\\n\u6BCF\u5929\u90FD\u5728\u5BB6\u7DF4\u7FD2\u505A\u7092\u9EB5\u5594\u3002",
  "\u6843\u6FA4\u5546\u5E97\u5F88\u65B9\u4FBF\u6EF4\u5537\uFF01\\n\u9053\u5177\u5C31\u4E0D\u7528\u8AAA\u4E86\uFF01\\c\\n\u9023\u90A3\u9593\u5E97\u7684\u8001\u5976\u5976\u81EA\u5DF1\u7E54\u7684\\n\u6696\u6696\u896A\uFF0C\u4E5F\u90FD\u80FD\u8CB7\u5230\u5594\u3002",
  "\u5F9E\u9019\u524D\u9762\u4E0A\u53BB\u5C31\u662F\u5317\u4E0A\u4E2D\u5FC3\u4E86\uFF01\\n\u5C71\u8DEF\u9084\u633A\u9577\u7684\uFF0C\u8981\u52A0\u6CB9\u5594\uFF01",
  "\u868A\u9999\u874C\u86AA\u7684\u809A\u5B50\uFF01\\n\u770B\u8457\u770B\u8457\u6211\u773C\u775B\u5C31\u82B1\u4E86\uFF5E\uFF01",
  "\u4E39\u745C\u8DDF\u70CF\u6817\u4ED6\u5011\u90FD\u662F\u53BB\u5230\u4E86\\n\u6D77\u5916\u7684\u5B78\u5712\u8B80\u66F8\u5462\u3002",
  "\u90A3\u5C0D\u5E38\u60F9\u4E8B\u7684\u59CA\u5F1F\uFF0C\\n\u6211\u807D\u8AAA\u4ED6\u5011\u56DE\u4F86\u5566\uFF1F",
  "\u7530\u88E1\u9762\u7684\u7A3B\u5B50\u6210\u719F\u5F8C\uFF0C\\n\u5C31\u80FD\u812B\u7A40\u7CBE\u88FD\u6210\u5927\u7C73\u2026\u2026\u767D\u7C73\u5594\uFF01",
  "\u628A\u7C73\u98EF\u593E\u5728\u4E09\u660E\u6CBB\u88E1\uFF01\uFF1F\\n\u5728\u5317\u4E0A\u6C92\u807D\u904E\u9019\u7A2E\u5403\u6CD5\u5462\u3002",
  "\u9019\u6751\u5B50\u4EC0\u9EBC\u4E5F\u6C92\u6709\u5427\uFF1F\\n\u5C31\u662F\u9019\u9EDE\u624D\u597D\u5440\u3002",
  "\u9019\u88E1\u662F\u7FE0\u7DA0\u93AE\u3002\\n\u63A9\u9762\u796D\u5F88\u6709\u540D\u5594\uFF01",
  "\u9752\u5E74\u5718\u9AD4\u7684\u5927\u5BB6\u90FD\u5728\u7092\u71B1\u796D\u5178\u7684\u6C23\u6C1B\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u597D\u597D\u4EAB\u53D7\u5427\uFF01",
  "\u6211\u5728\u5317\u4E0A\u4E2D\u5FC3\\n\u770B\u5230\u5BF6\u4F34\u4E86\uFF01\uFF01\\r\\n\u7260\u5011\u5403\u4E86\u597D\u591A\u5317\u4E0A\u7CEC\uFF01\uFF01",
  "\u6211\u807D\u8AAA\u6709\u500B\u5B69\u5B50\\n\u8DDF\u5384\u9B3C\u692A\u8B8A\u5F97\u5F88\u8981\u597D\uFF01\\r\\n\u2026\u2026\u96E3\u4E0D\u6210\u662F\u70CF\u6817\uFF1F",
  "\u6211\u559C\u6B61\u5920\u8B9A\u72D7\uFF01\\n\u7260\u90A3\u7DA0\u8272\u5BE6\u5728\u6709\u5920\u9177\uFF5E\uFF01",
  "\u5920\u8B9A\u72D7\u7684\u672C\u5C0A\uFF01\\n\u7260\u6C92\u6709\u9762\u5177\u90A3\u9EBC\u7DA0\u5594\uFF01\uFF01",
  "\u5384\u9B3C\u692A\u672C\u5C0A\u548C\u9762\u5177\\n\u90FD\u662F\u7DA0\u8272\u7684\uFF0C\u5BE6\u5728\u6709\u5920\u9177\uFF01",
  "\u6C34\u679C\u7CD6\u6524\u7684\u7CD6\u860B\u679C\uFF01\\c\\n\u90A3\u662F\u7528\u860B\u679C\u4E4B\u4E18\u73FE\u6458\u7684\u860B\u679C\\n\u6574\u9846\u4E0B\u53BB\u505A\u7684\u5594\uFF01",
  "\u300C\u63A9\u9762\u300D\u4E5F\u6709\u7528\u9762\u5177\u906E\u81C9\u7684\u610F\u601D\uFF0C\\n\u6240\u4EE5\u63A9\u9762\u796D\u624D\u6703\u6234\u9762\u5177\u55CE\uFF1F",
  "\u9EBB\u5409\u9EBB\u5409\uFF01",
  "\u9EBB\u3001\u9EBB\u5409\u3001\u9EBB\u3001\u9EBB\u5409\u3002",
  "\u9EBB\u5409\u9EBB\u5409\u2026\u2026\\n\u9EBB\u2026\u2026\u5409\u2026\u2026"
]
