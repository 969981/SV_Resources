[
  "[VAR 0100(0000)]\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u5728\u9019\u88E1\u770B\u8457\u5427\uFF01[VAR 0114(0025)]",
  "\u6211\u6B63\u6E96\u5099\u8981\u57CB\u4F0F\u7B49\u8457\\n\u90A3\u9053\u8996\u7DDA\u7684\u4E3B\u4EBA\u51FA\u73FE\uFF01[VAR 0114(0025)]",
  "\u57CB\u4F0F\uFF01\uFF1F",
  "\u70BA\u4EC0\u9EBC\uFF01\uFF1F",
  "\u7E3D\u662F\u53EA\u611F\u53D7\u5230\u8996\u7DDA\uFF0C\\n\u9084\u662F\u6703\u8B93\u6211\u5FCD\u4E0D\u4F4F\u53BB\u5728\u610F\u3002[VAR 0114(0025)]",
  "\u800C\u4E14\u6211\u5728\u98DF\u5802\u8A18\u4F4F\u5979\u7684\u81C9\u4E86\uFF01[VAR 0114(0025)]",
  "\u2026\u2026\u554A\uFF01[VAR 0114(0025)]",
  "\u5C31\u662F\u59B3\u5427\uFF01\\n\u6700\u8FD1\u4E00\u76F4\u76EF\u8457\u6211\u770B\u7684\u90A3\u500B\u4EBA\uFF01[VAR 0114(0025)]",
  "\u6CF0\u3001\u6CF0\u59C6\u5973\u58EB\uFF01\uFF1F\\n\u59B3\u600E\u9EBC\u6703\u77E5\u9053\u2026\u2026\uFF01\uFF1F",
  "\u5C0D\u3001\u5C0D\u4E0D\u8D77\uFF01\\n\u539F\u4F86\u59B3\u5DF2\u7D93\u767C\u73FE\u4E86\u3002",
  "\u7562\u7ADF\u59B3\u4E00\u5929\u5230\u665A\u770B\u8457\u6211\u5440\uFF01\\n\u59B3\u662F\u4E0D\u662F\u6709\u4EC0\u9EBC\u4E8B\u60F3\u554F\u6211\u5462\uFF1F[VAR 0114(0025)]",
  "\u662F\u3001\u662F\u7684\u2026\u2026",
  "\u6CF0\u59C6\u5973\u58EB\u59B3\u64D4\u4EFB\u9053\u9928\u9928\u4E3B\u7684\u6642\u5019\uFF0C\\n\u5F9E\u90A3\u6642\u5019\u958B\u59CB\u6211\u5C31\u4E00\u76F4\u662F\u59B3\u7684\u7C89\u7D72\uFF01\\r\\n\u6211\u6700\u559C\u6B61\u5CA9\u77F3\u5C6C\u6027\u62DB\u5F0F\u4E86\uFF01\uFF01",
  "\u54CE\u5440\u3002[VAR 0114(0025)]",
  "\u53EF\u662F\uFF0C\\n\uFF11\u5E74\u534A\u524D\u59B3\u7A81\u7136\u5F15\u9000\u2026\u2026\\r\\n\u59B3\u70BA\u4EC0\u9EBC\u8FAD\u53BB\u9928\u4E3B\u5462\uFF1F",
  "\u2026\u2026\u6211\u7684\u5929\u5440\u3002\\n\u59B3\u662F\u60F3\u554F\u9019\u4EF6\u4E8B\u60C5\u5440\u3002[VAR 0114(0025)]",
  "\u6CF0\u59C6\u5973\u58EB\u59B3\u5F15\u9000\u7684\u7406\u7531\uFF0C\\n\u4E0D\u4F46\u6C92\u6709\u516C\u958B\u767C\u8868\u2026\u2026",
  "\u5728\u5B78\u751F\u4E4B\u9593\u4E5F\u50B3\u805E\u8AAA\u5373\u4F7F\u554F\u59B3\u9019\u500B\u554F\u984C\uFF0C\\n\u4E5F\u53EA\u662F\u88AB\u542B\u7CCA\u5730\u5E36\u4E86\u904E\u53BB\u800C\u5DF2\u2026\u2026",
  "\u554F\u4E86\u6CF0\u59C6\u5973\u58EB\u59B3\u4E0D\u60F3\u8AAA\u7684\u4E8B\u60C5\uFF0C\\n\u6216\u8A31\u662F\u4E00\u4EF6\u5F88\u6C92\u79AE\u8C8C\u7684\u4E8B\u60C5\u2026\u2026\\r\\n\u6240\u4EE5\u6211\u4E00\u76F4\u63D0\u4E0D\u8D77\u52C7\u6C23\u958B\u53E3\u2026\u2026",
  "\u6240\u4EE5\u59B3\u624D\u4E00\u76F4\u7528\u706B\u71B1\u7684\u8996\u7DDA\u770B\u8457\u6211\u2026\u2026\\n\u6211\u5BE6\u5728\u592A\u62B1\u6B49\u4E86\u3002[VAR 0114(0025)]",
  "\u54A6\uFF1F\u706B\u71B1\u2026\u2026\uFF1F",
  "\u554A\uFF0C\u4E0D\u7528\u5728\u610F\u2026\u2026\\n\u6211\u8FAD\u53BB\u9928\u4E3B\u7684\u7406\u7531\uFF0C\\r\\n\u662F\u56E0\u70BA\u6211\u60F3\u66F4\u5C08\u5FC3\u5728\u8001\u5E2B\u9019\u4EFD\u5DE5\u4F5C\u4E0A\u5594\u3002[VAR 0114(0025)]",
  "\u6211\u4E26\u4E0D\u662F\u56E0\u70BA\u53AD\u5026\u4E86\u7576\u9053\u9928\u9928\u4E3B\uFF0C\\n\u624D\u5378\u4E0B\u9019\u500B\u8077\u8CAC\u7684\u2026\u2026[VAR 0114(0025)]",
  "\u63D0\u5230\u9053\u9928\u7684\u4E8B\uFF0C\\n\u6211\u7E3D\u662F\u5FCD\u4E0D\u4F4F\u611F\u89BA\u53C8\u61F7\u5FF5\u53C8\u5BC2\u5BDE\u3002[VAR 0114(0025)]",
  "\u6240\u4EE5\u6211\u624D\u6703\u907F\u958B\u56DE\u7B54\u5B78\u751F\u9019\u500B\u554F\u984C\u3002[VAR 0114(0025)]",
  "\u539F\u4F86\u662F\u9019\u6A23\u2026\u2026",
  "\u59B3\u6C92\u6709\u6253\u7B97\\n\u56DE\u53BB\u7576\u9053\u9928\u9928\u4E3B\u55CE\uFF1F",
  "\u55EF\u2026\u2026\u6211\u6C92\u6709\u9019\u500B\u6253\u7B97\u3002[VAR 0114(0025)]",
  "\u73FE\u5728\u7531\u6211\u59B9\u59B9\u64D4\u4EFB\u9053\u9928\u9928\u4E3B\uFF0C\\n\u800C\u4E14\u5979\u975E\u5E38\u5730\u7A31\u8077\u3002[VAR 0114(0025)]",
  "\u6211\u9019\u500B\u59D0\u59D0\uFF0C\\n\u73FE\u5728\u8001\u5E2B\u9019\u500B\u8EAB\u5206\u662F\u6700\u5FEB\u6A02\u7684\u4E86\u3002[VAR 0114(0025)]",
  "\u6240\u4EE5\u5462\uFF0C\u5982\u679C\u59B3\u9858\u610F\u4E0D\u53EB\u6211\u6CF0\u59C6\u5973\u58EB\uFF0C\\n\u800C\u53EB\u6211\u6CF0\u59C6\u8001\u5E2B\u7684\u8A71\uFF0C\\r\\n\u8001\u5E2B\u6211\u6703\u975E\u5E38\u958B\u5FC3\u7684\u5594\u3002[VAR 0114(0025)]",
  "\u55EF\uFF0C\u96D6\u7136\u5F88\u907A\u61BE\u2026\u2026\\n\u4F46\u662F\u6211\u660E\u767D\u4E86\uFF01",
  "\u8B1D\u8B1D\u59B3\uFF01\\n\u6CF0\u59C6\u8001\u5E2B\uFF01",
  "\u9019\u9EBC\u4E00\u4F86\uFF0C\u9019\u4EF6\u4E8B\u5C31\u544A\u4E00\u6BB5\u843D\u4E86\u3002[VAR 0114(0025)]",
  "\u547C\uFF5E\u771F\u53EB\u6211\u7DCA\u5F35\u4E86\uFF01\\n\u6211\u7ADF\u7136\u8AAA\u4E86\u90A3\u9EBC\u591A\u807D\u8D77\u4F86\u5F88\u5E25\u6C23\u7684\u8A71\uFF01[VAR 0114(0025)]",
  "\u6CE8\u610F\u5230\u706B\u71B1\u7684\u8996\u7DDA\u7684\u6642\u5019\uFF0C\\n\u6211\u662F\u6709\u4E9B\u5BB3\u6015\u2026\u2026[VAR 0114(0025)]",
  "\u4F46\u56E0\u70BA\u6709[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\uFF0C\\n\u6211\u624D\u80FD\u548C\u90A3\u500B\u652F\u6301\u6211\u7684\u5B69\u5B50\u5766\u8AA0\u4EE5\u5C0D\u3002[VAR 0114(0025)]",
  "[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u7E3D\uFF5E\u662F\u5728\u6700\u4F73\u6642\u6A5F\u51FA\u73FE\uFF0C\\n\u771F\u662F\u592A\u611F\u8B1D\u4E86\u3002[VAR 0114(0025)]",
  "\u9019\u662F\u8001\u5E2B\u6211\u7684\u4E00\u9EDE\u5FC3\u610F\u3002\\n\u5E0C\u671B\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u5192\u96AA\u7684\u6642\u5019\u80FD\u6D3E\u4E0A\u7528\u5834\u3002[VAR 0114(0025)]",
  "\u548C\u6CF0\u59C6\u8001\u5E2B\u4E4B\u9593\u7684\\n\u727D\u7D46\u840C\u82BD\u4E86\uFF01"
]
