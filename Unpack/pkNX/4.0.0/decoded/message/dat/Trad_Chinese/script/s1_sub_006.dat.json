[
  "\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01\\n\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01[VAR 0114(0041)]",
  "\u6BC5\u842C\uFF0C\u4F60\u770B\uFF0C\u5475\uFF01\\n\u771F\u662F\u6F02\u4EAE\u7684\u76C6\u683D\uFF01[VAR 0114(0041)]",
  "\u99A5\u597D\uFF01\\n\u9019\u662F\u679C\u5712\u5594\uFF01\\r\\n\u5728\u59B3\u773C\u4E2D\u53EF\u80FD\u770B\u8D77\u4F86\u50CF\u76C6\u683D\u5C31\u662F\u4E86\uFF01[VAR 0114(0040)]",
  "\u4E0D\u662F\u5427\u2026\u2026\uFF1F\\n\u9019\u662F\u679C\u6A39\u7684\u8FB2\u5712\uFF01\uFF1F\\r\\n\u7ADF\u7136\u5982\u6B64\u6A38\u5BE6\u542B\u84C4\uFF01\uFF01[VAR 0114(0041)]",
  "\u6BC5\u842C\uFF01\\n\u8B1D\u8B1D\u4F60\u7CFE\u6B63\u6211\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u5C0F\u4E8B\u4E00\u4EF6\uFF01\\n\u5EB6\u6C11\u7684\u751F\u614B\u9084\u6709\u5F88\u591A\u8B0E\u5718\u7684\uFF01[VAR 0114(0040)]",
  "\u54E6\uFF5E\u5EB6\u6C11\uFF01\\n\u4ED6\u5011\u662F\u591A\u9EBC\u4E0D\u53EF\u601D\u8B70\u7684\u5B58\u5728\u2026\u2026\\r\\n\u7E3D\u662F\u8B93\u6211\u7684\u5FC3\u5152\u64B2\u901A\u64B2\u901A\u5730\u8DF3\uFF01\uFF01[VAR 0114(0041)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\u4E00\u8AAA\u5EB6\u6C11\uFF0C\\n\u90A3\u4F4D\u6211\u5011\u719F\u6089\u7684\u5EB6\u6C11\u5C31\u5230\uFF01[VAR 0114(0041)]",
  "\u771F\u7684\u8036\uFF5E\u90A3\u80AF\u5B9A\u5C31\u662F\\n\u90A3\u4F4D\u6211\u5011\u719F\u6089\u7684\u5EB6\u6C11\u4E86\uFF01[VAR 0114(0040)]",
  "\u6211\u60F3\u8981\u66F4\u4E86\u89E3\u5EB6\u6C11\uFF01\\n\u6211\u60F3\u62C9\u8FD1\u548C\u5EB6\u6C11\u7684\u8DDD\u96E2\uFF0C\u5475\uFF01\uFF01[VAR 0114(0041)]",
  "\u2026\u2026\u6240\u4EE5\u5462\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u518D\u548C\u6211\u4F86\u4E00\u5834\u6C7A\u9B25\u55CE\uFF1F[VAR 0114(0041)]",
  "\u51FA\u2026\u2026\u51FA\u73FE\u4E86\uFF01\\n\u99A5\u597D\u7684\u8208\u8DA3\uFF01\\r\\n\u900F\u904E\u5C0D\u6230\u4F86\u4E86\u89E3\u5C0D\u65B9\uFF5E\uFF01[VAR 0114(0040)]",
  "\u5475\u5475\u5475\u2026\u2026\u5982\u679C\u505A\u597D\u89BA\u609F\u4E86\uFF0C\\n\u5C31\u7531\u5EB6\u6C11\u7684[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u9080\u7D04\u6211\u5427\u3002[VAR 0114(0041)]",
  "\u80FD\u548C\u540D\u6D41\u6C7A\u9B25\u53EF\u662F\u5343\u91D1\u96E3\u8CB7\u7684\u6A5F\u6703\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5FEB\u53BB\u548C\u99A5\u597D\u642D\u8A71\u5427\uFF01[VAR 0114(0040)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u9858\u610F\u63A5\u53D7\\n\u548C\u6211\u7684\u6C7A\u9B25\u55CE\uFF1F\u5475\uFF01[VAR 0114(0041)]",
  "\u2026\u2026\u5076\u723E\u88AB\u5EB6\u6C11\u64FA\u5F04\u7684\u611F\u89BA\uFF0C\\n\u9084\u4E0D\u932F\u561B\uFF0C\u5475\u3002\\c\\n\u540D\u6D41\u7684\u6642\u9593\u662F\u5F88\u5BF6\u8CB4\u7684\uFF0C\u5475\uFF01\\n\u6211\u5011\u5C31\u7ACB\u523B\u4F86\u6253\u5427\uFF0C\u54E6\u5475\u5475\u5475\uFF01\uFF01[VAR 0114(0041)]",
  "\u5E15\u5E95\u4E9E\u4E0D\u52D5\u7522\u793E\u9577\uFF0C\u99A5\u597D\uFF01\\n\u770B\u6211\u628A\u5EB6\u6C11\u6253\u5230\u843D\u82B1\u6D41\u6C34\uFF0C\u54E6\u5475\u5475\u5475\uFF01[VAR 0114(0041)]",
  "\u55B2\uFF5E\u55B2\uFF5E\uFF01\\n\u52A0\u6CB9\u554A\uFF0C\u99A5\u597D\uFF01[VAR 0114(0040)]",
  "\u6211\u53C8\u8F38\u4E86\uFF0C\u5475\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7A76\u7ADF\u662F\u4F55\u65B9\u795E\u8056\uFF0C\u5475\uFF01[VAR 0114(0041)]",
  "\u6211\u8AAA\uFF0C\u6BC5\u842C\uFF01\\n\u6BCF\u4F4D\u5EB6\u6C11\u90FD\u5F88\u6703\u6253\u5BF6\u53EF\u5922\u5C0D\u6230\u55CE\uFF01\uFF1F\\r\\n\u9084\u662F\u9019\u4F4D\u5EB6\u6C11\u662F\u500B\u7279\u5225\u4EBA\u7269\uFF01\uFF1F[VAR 0114(0041)]",
  "\u99A5\u597D\uFF0C\u6211\u60F3[VAR 1100(00FF,0101)]\u4ED6\u5979\u4E00\u5B9A\u662F\\n\u6975\u5C11\u6578\u6DF1\u53D7\u4E0A\u5929\u7737\u9867\u2026\u2026[VAR 0114(0040)]",
  "\u64C1\u6709\u98E2\u9913\u7CBE\u795E\u7684\u5EB6\u6C11\uFF01\uFF01[VAR 0114(0040)]",
  "\u98E2\u9913\u7CBE\u795E\uFF01\uFF1F\u540D\u6D41\u4E00\u8F29\u5B50\\n\u90FD\u4E0D\u53EF\u80FD\u64C1\u6709\u7684\u90A3\u500B\u7CBE\u795E\u2026\u2026\uFF01\uFF1F[VAR 0114(0041)]",
  "\u96E3\u602A\u6211\u8D0F\u4E0D\u4E86\u3002\u6211\u73FE\u5728\u7D42\u65BC\\n\u6E05\u695A\u5F97\u6BD4\u4E38\u5B50\u73CD\u73E0\u9084\u660E\u767D\u2026\u2026[VAR 0114(0041)]",
  "\u2026\u2026\u63D0\u5230\u73CD\u73E0\uFF0C\\n\u6211\u5C31\u60F3\u53BB\u6C34\u908A\u4E86\uFF0C\u5475\uFF01[VAR 0114(0041)]",
  "\u597D\u4E86\uFF0C\u6BC5\u842C\uFF01\\n\u6211\u73FE\u5728\u60F3\u99AC\u4E0A\u53BB\u5E15\u5E95\u4E9E\uFF0C\\r\\n\u770B\u6700[VAR FF00(0006)]\u5EE3\u5927\u7684\u6C34\u908A[VAR FF00(0000)]\uFF01[VAR 0114(0041)]",
  "\u55B2\uFF5E\uFF01\\n\u59B3\u7684\u597D\u5947\u5FC3\u7E3D\u662F\u7A81\u7136\u7206\u767C\uFF01\\r\\n\u99A5\u597D\u59B3\u771F\u662F\u540D\u6D41\u7684\u5178\u7BC4\uFF01[VAR 0114(0040)]",
  "\u6211\u5011\u53BB\u6E56\u7554\u7684\u5C0F\u5CF6\u597D\u597D\u653E\u9B06\uFF0C\\n\u6D88\u9664\u6C7A\u9B25\u5F8C\u7684\u75B2\u52DE\u5427\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u842C\u5148\u751F\\n\u5728\u5317\u4E0A\u9109\u9019\u88E1\\r\\n\u524D\u53BB\u89C0\u8CDE\u6C34\u679C\u5712\u4E86\u3002"
]
