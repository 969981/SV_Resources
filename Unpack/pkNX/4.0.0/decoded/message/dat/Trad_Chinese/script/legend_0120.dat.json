[
  "\u7352\u6C6A\uFF01",
  "\u597D\uFF01[VAR 0100(0000)]\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u505A\u597D\u5C0D\u6230\u7684\u6E96\u5099\u4E86\u55CE\uFF1F[VAR 0114(0006)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u53EB\u6211\u537B\u4E00\u6D3E\u60F3\u6E9C\u8D70\uFF1F\\n\u6211\u611F\u89BA\u50CF\u662F\u5403\u4E86\u9589\u9580\u7FB9\u8036\uFF01[VAR 0114(0006)]",
  "\u5F88\u597D\uFF01\\n\u7352\u6559\u7236\u4F60\u4E5F\u6E96\u5099\u597D\u4E86\u5427\uFF01\uFF1F[VAR 0114(0006)]",
  "\u7352\u547C\uFF01\uFF01\u54C7\u547C\uFF01\uFF01",
  "\u7352\u6559\u7236\u7260\u4E5F\u8AAA\u96A8\u6642\u80FD\u4E0A\uFF01[VAR 0114(0006)]",
  "\u548C\u7352\u6559\u7236\u4E00\u8D77\uFF01\uFF1F",
  "\u4E0D\u8981\u7DCA\u55CE\uFF01\uFF1F",
  "\u55EF\uFF5E\\n\u6211\u4E5F\u660E\u767D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u64D4\u5FC3\u2026\u2026[VAR 0114(0006)]",
  "\u4F46\u9019\u50A2\u4F19\u73FE\u5728\u662F\u500B\u6D3B\u529B\u5145\u6C9B\u6D3E\uFF0C\\n\u8B93\u4EBA\u4E0D\u89BA\u5F97\u7260\u5176\u5BE6\u662F\u5927\u75C5\u521D\u7652\u3002[VAR 0114(0006)]",
  "\u7260\u4E00\u76F4\u7352\u547C\u7352\u547C\u5730\u53EB\uFF0C\\n\u5435\u8457\u8AAA\u8D95\u5FEB\u8B93\u7260\u8DDF[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6230\u3002[VAR 0114(0006)]",
  "\u9019\u9EBC\u8AAA\u8D77\u4F86\uFF0C\\n\u7260\u5F9E\u4EE5\u524D\u5C31\u975E\u5E38\u559C\u6B61\u5C0D\u6230\u3002\\r\\n\u2026\u2026\u96D6\u7136\u8001\u8F38\u7D66\u5B78\u751F\u6703\u9577\u5C31\u662F\u4E86\u3002[VAR 0114(0006)]",
  "\u7E3D\u4E4B\u5462\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u9700\u8981\u64D4\u5FC3\uFF01[VAR 0114(0006)]",
  "\u56E0\u70BA\u8ABF\u5473\u6599\u800C\u91CD\u7372\u65B0\u751F\u7684\u6211\u5011\uFF0C\\n\u6709\u591A\u9EBC\u5E36\u52C1\uFF01[VAR 0114(0006)]",
  "\u9019\u756A\u6ECB\u5473[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u597D\uFF5E\u597D\u54C1\u5690\u5427\uFF01[VAR 0114(0006)]",
  "\u53EF\u60E1\u2026\u2026\u9019\u5C31\u662F\u6253\u904D\\n\u5BF6\u4E3B\u5BF6\u53EF\u5922\u7684\u5BE6\u529B\u554A\uFF5E\uFF01[VAR 0114(0006)]",
  "\u8AAA\u8D77\u4F86\uFF0C\u53EA\u6709\u6211\u53BB\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u5FD9\u7684\u8A71\uFF0C\\n\u611F\u89BA\u9084\u662F\u4E0D\u5920\u53EF\u9760\uFF01[VAR 0114(0006)]",
  "\u7B2C\u96F6\u5340\u4E0D\u53EA\u5BF6\u53EF\u5922\u5F88\u5F37\u5927\uFF0C\\n\u9084\u6709\u4E00\u5927\u5806\u83AB\u540D\u5176\u5999\u7684\u88DD\u7F6E\u3002[VAR 0114(0006)]",
  "\u6211\u60F3\u81F3\u5C11\u9084\u9700\u8981\u5169\u500B\u4EBA\u2026\u2026\\n\u8981\u662F\u6709[VAR FF00(0006)]\u64C1\u6709\u51A0\u8ECD\u7D1A\u5BE6\u529B\u7684\u50A2\u4F19[VAR FF00(0000)]\uFF0C\\r\\n\u8DDF[VAR FF00(0006)]\u64C5\u9577\u6A5F\u68B0\u7684\u50A2\u4F19[VAR FF00(0000)]\u52A0\u5165\u6211\u5011\u5C31\u597D\u4E86\u3002[VAR 0114(0006)]",
  "\u59AE\u83AB\uFF01",
  "\u7261\u4E39\uFF01",
  "\u59AE\u83AB\u2026\u2026\uFF1F",
  "\u7261\u4E39\u2026\u2026\uFF1F",
  "\u539F\u4F86\u5982\u6B64\uFF0C\u5B78\u751F\u6703\u9577\u554A\uFF01\\c\\n\u7684\u78BA\uFF0C\u5982\u679C\u662F\u90A3\u50A2\u4F19\u7684\u8A71\uFF0C\\n\u4E0D\u8AD6\u591A\u5F37\u5927\u7684\u5BF6\u53EF\u5922\u8972\u64CA\u904E\u4F86\uFF0C\\r\\n\u4E5F\u4E0D\u6703\u662F\u5979\u7684\u5C0D\u624B\uFF01[VAR 0114(0006)]",
  "\u5929\u661F\u968A\u7684\u771F\u8001\u5927\uFF0C\\n\u5929\u624D\u99ED\u5BA2\u7684\u7261\u4E39\uFF1F\\r\\n\u7684\u78BA\uFF0C\u90A3\u50A2\u4F19\u7684\u8A71\u662F\u6700\u4F73\u4EBA\u9078\u6C92\u932F\u3002\\c\\n\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u4EC0\u9EBC\u6642\u5019\u4EA4\u4E86\u500B\\n\u9019\u9EBC\u9A5A\u4EBA\u7684\u670B\u53CB\u554A\u2026\u2026\uFF01\uFF1F[VAR 0114(0006)]",
  "\u5B78\u751F\u6703\u9577\u554A\u2026\u2026\\c\\n\u5979\u7684\u78BA\u662F\u6700\u4F73\u4EBA\u9078\uFF0C\\n\u4F46\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u6210\u70BA\u51A0\u8ECD\u4E4B\u524D\uFF0C\\r\\n\u611F\u89BA\u662F\u4E0D\u53EF\u80FD\u6253\u52D5\u5979\u7684\u3002[VAR 0114(0006)]",
  "\u54E6\uFF5E\u539F\u4F86\u6709\u9019\u865F\u4EBA\u7269\u5B58\u5728\u554A\uFF1F\\c\\n\u4F46\u5982\u679C\u4E0D\u627E\u500B\u6A5F\u6703\u8CE3\u4EBA\u60C5\u8DDF\u5979\u6253\u597D\u4EA4\u9053\uFF0C\\n\u4E0D\u89BA\u5F97\u5979\u4E0D\u53EF\u80FD\u6703\u5E6B\u5FD9\u55CE\uFF1F[VAR 0114(0006)]",
  "\u7E3D\u4E4B\uFF01\u7B49\u4EBA\u9078\u90FD\u627E\u9F4A\u4E86\uFF0C\\n\u6211\u5011\u518D\u4E92\u76F8\u806F\u7D61\u5427\uFF01[VAR 0114(0006)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u662F\u77E5\u9053\u6709\u53EF\u80FD\u6210\u70BA\u5925\u4F34\u7684\u50A2\u4F19\uFF0C\\n\u5C31\u5E6B\u5FD9\u5148\u53BB\u554F\u554F\u770B\u5427\uFF01[VAR 0114(0006)]",
  "\u54E6\u54E6\uFF01\uFF1F\u641E\u4EC0\u9EBC\u554A\uFF01\\n\u6709\u53EF\u80FD\u6210\u70BA\u5925\u4F34\u7684\u50A2\u4F19\u5011\\r\\n\u597D\u50CF\u90FD\u6E4A\u9F4A\u4E86\u561B\uFF01[VAR 0114(0006)]",
  "\u6211\u6703\u8DDF\u90A3\u4E9B\u50A2\u4F19\u5011\u806F\u7D61\u7684\u3002\\c\\n\u6211\u5011\u5C31\u5728\u5DE8\u5751\u9644\u8FD1\u90A3\u500B\u53EB\\n\u96F6\u5340\u9598\u53E3\u7684\u8A2D\u65BD\u78B0\u982D\u5427\uFF01\\c\\n\u4F4D\u7F6E\u8CC7\u8A0A\u6211\u99AC\u4E0A\u50B3\u904E\u53BB\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5FEB\u904E\u4F86\uFF01[VAR 0114(0006)]"
]
