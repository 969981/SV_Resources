[
  "\u9019\u4E0D\u662F\uFF11\uFF0D\uFF21\u7684[VAR 0100(0000)]\u55CE\uFF1F[VAR 0114(0027)]",
  "\u6211\u5728\u8AB2\u5802\u4E0A\u8AAA\u7684\u90A3\u500B\u7AE5\u8A71\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u96E3\u9053\u4E0D\u60F3\u77E5\u9053\u5F8C\u7E8C\u55CE\uFF1F[VAR 0114(0027)]",
  "\u5475\u5475\u5475\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u80AF\u4E0A\u9264\u6211\u5012\u662F\u7701\u4E8B\u4E86\u3002[VAR 0114(0027)]",
  "\u5225\u8AAA\u8B0A\u4E86\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u81C9\u4E0A\u53EF\u5BEB\u8457\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u8981\u6EFF\u8DB3\u6C42\u77E5\u7684\u597D\u5947\u5FC3\u5462\u3002[VAR 0114(0027)]",
  "\u9F0E\u3001\u528D\u3001\u7C21\u3001\u7389\u3002\\n\u4EE5\u4E0A\uFF14\u7A2E\u5BF6\u7269\u90FD\u5230\u624B\u7684\u570B\u738B\uFF0C\\r\\n\u4ED6\u7684\u57CE\u5821\u4E4B\u6240\u4EE5\u6BC0\u58DE\u7684\u7406\u7531\u2026\u2026[VAR 0114(0027)]",
  "\u90A3\u500B\u771F\u76F8\u5C31\u662F\uFF0C\\n\u5176\u5BE6\u5BF6\u7269\u662F\u5BF6\u53EF\u5922\u3002[VAR 0114(0027)]",
  "\uFF14\u96BB\u5BF6\u53EF\u5922\u4F5C\u70BA\u5BF6\u7269\\n\u5728\u8A31\u591A\u4EBA\u624B\u4E2D\u8F3E\u8F49\uFF0C\\r\\n\u4EBA\u5011\u7684\u617E\u671B\u548C\u8A5B\u5492\u9010\u6F38\u5BC4\u9644\u5728\u7260\u5011\u8EAB\u4E0A\u2026\u2026[VAR 0114(0027)]",
  "\u7531\u65BC\u53D7\u5230\u570B\u738B\u7684\u617E\u671B\u4FB5\u8755\uFF0C\\n\u7260\u5011\u7D42\u65BC\u5316\u70BA\u707D\u798D\uFF0C\u958B\u59CB\u5927\u9B27\u4E86\u8D77\u4F86\u3002[VAR 0114(0027)]",
  "\u570B\u738B\u70BA\u4E86\u5B88\u8B77\u81EA\u5DF1\u7684\u570B\u5BB6\uFF0C\\n\u559A\u4F86\u9060\u8FD1\u99B3\u540D\u7684\u5BF6\u53EF\u5922\u99B4\u5316\u5E2B\uFF0C\\r\\n\u7D93\u6B77\u6FC0\u70C8\u7684\u6230\u9B25\u5F8C\uFF0C\u7E3D\u7B97\u5E73\u5B9A\u4E86\u707D\u798D\u3002[VAR 0114(0027)]",
  "\u64DA\u8AAA\uFF0C\u800C\u5F8C\u9019\uFF14\u96BB\u5BF6\u53EF\u5922\\n\u5C31\u88AB\u5C01\u5370\u5728\u5E15\u5E95\u4E9E\u7684\u67D0\u8655\u3002[VAR 0114(0027)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u89BA\u5F97\u2026\u2026\\n\u9019\u500B\u6545\u4E8B\u662F\u865B\u69CB\u7684\u55CE\uFF1F[VAR 0114(0027)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7ADF\u7136\u610F\u5916\u5730\u4E00\u9EDE\u90FD\u4E0D\u6D6A\u6F2B\uFF01\uFF01[VAR 0114(0027)]",
  "\u5475\u5475\u2026\u2026[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F88\u654F\u92B3\u561B\u3002[VAR 0114(0027)]",
  "\u6B77\u53F2\u6027\u7684\u707D\u5BB3\u7D00\u9304\u548C\u500B\u4EBA\u7684\u65E5\u8A18\u2026\u2026\\n\u6211\u8B80\u4E86\u5404\u5F0F\u5404\u6A23\u7684\u8CC7\u6599\uFF0C\\r\\n\u767C\u73FE\u6709\u5F88\u591A\u4E8B\u5BE6\u80FD\u8B49\u660E\u9019\u500B\u6545\u4E8B\u7684\u771F\u5BE6\u6027\u3002[VAR 0114(0027)]",
  "\u5982\u679C\u6211\u80FD\u78BA\u5B9A\u9019\u500B\u6545\u4E8B\u662F\u771F\u7684\uFF0C\\n\u5230\u6642\u5019\u4E5F\u6703\u544A\u8A34[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u3002[VAR 0114(0027)]",
  "\u548C\u857E\u8377\u8001\u5E2B\\n\u8B8A\u5F97\u66F4\u8981\u597D\u4E86\u4E00\u9EDE\uFF01"
]
