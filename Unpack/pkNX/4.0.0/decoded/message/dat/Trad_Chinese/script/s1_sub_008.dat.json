[
  "\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01\\n\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01[VAR 0114(0041)]",
  "\u4E00\u671B\u7121\u969B\u7684\u9280\u767D\u4E16\u754C\uFF0C\\n\u771F\u662F\u592A\u6709\u60C5\u8ABF\u4E86\uFF0C\u5475\uFF01[VAR 0114(0041)]",
  "\u5C31\u662F\u5440\uFF01\u800C\u4E14\u53EA\u8981\u7A7F\u4E0A\\n\u99A5\u597D\u59B3\u6E96\u5099\u7684\u9019\u4EF6\u8863\u670D\uFF0C\\r\\n\u5BD2\u51B7\u4E00\u9EDE\u90FD\u4E0D\u7B97\u4EC0\u9EBC\uFF0C\u5F88\u6696\u548C\u5594\uFF01[VAR 0114(0040)]",
  "\u56E0\u70BA\u90A3\u662F\u7528\u4E86\u6700\u9AD8\u7D1A\u7684\u5E03\u6599\u505A\u7684\\n\u6700\u9AD8\u7D1A\u7684\u540D\u724C\u8CA8\u5440\uFF0C\u5475\uFF01[VAR 0114(0041)]",
  "\u90FD\u8B93\u6211\u89BA\u5F97\u6C92\u7A7F\u9019\u4EF6\u8863\u670D\\n\u5C31\u4F86\u767B\u5C71\u7684\u4EBA\u5F88\u53EF\u6190\u4E86\u3002[VAR 0114(0040)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\\n\u56FA\u5B9A\u767B\u5834\u7684\u90A3\u4F4D\u5EB6\u6C11\uFF01[VAR 0114(0041)]",
  "\u771F\u7684\u8036\uFF5E\u90A3\u80AF\u5B9A\u5C31\u662F\\n\u90A3\u4F4D\u6703\u56FA\u5B9A\u767B\u5834\u7684\u5EB6\u6C11\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\uFF0C\u59B3\u770B\uFF01\\n\u5EB6\u6C11\u7684\u8863\u670D\u8584\u6210\u90A3\u6A23\uFF01[VAR 0114(0040)]",
  "\u54CE\u3001\u54CE\u5440\uFF01\\n\u597D\u55AE\uFF5E\u8584\u7684\u5E03\u6599\u5440\uFF01[VAR 0114(0041)]",
  "\u6211\u8AAA\uFF0C\u6BC5\u842C\uFF01\\n\u5EB6\u6C11\u662F\u4E0D\u6015\u51B7\u55CE\uFF1F[VAR 0114(0041)]",
  "\u6211\u4E0D\u77E5\u9053\u2026\u2026\u96D6\u7136\u4E0D\u77E5\u9053\uFF0C\\n\u4F46\u807D\u8AAA\u5EB6\u6C11\u5011\u6703\u7528\u300C\u8CA7\u5BD2\u300D\\r\\n\u4F86\u5F62\u5BB9\u6C92\u6709\u9322\u7684\u72C0\u614B\u5594\u3002[VAR 0114(0040)]",
  "\u6240\u4EE5\u6216\u8A31\u4ED6\u5011\\n\u5DF2\u7D93\u7FD2\u6163\u5BD2\u51B7\u4E86\uFF1F[VAR 0114(0040)]",
  "\u6BC5\u842C\uFF0C\u4F60\u2026\u2026[VAR 0114(0041)]",
  "\u771F\u662F\u535A\u5B78\u591A\u805E\uFF01\\n\u6211\u8981\u9812\u767C\u91D1\u99A5\u597D\u734E\u7D66\u4F60\uFF01[VAR 0114(0041)]",
  "\u592A\u68D2\u4E86\uFF5E\uFF01[VAR 0114(0040)]",
  "\u5C0D\u56F0\u5883\u4E2D\u7684\u5EB6\u6C11\u4F38\u51FA\u63F4\u624B\\n\u6B63\u662F\u6211\u5011\u540D\u6D41\u7684\u8077\u8CAC\u2026\u2026[VAR 0114(0041)]",
  "\u9019\u500B\u6771\u897F\u9001\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u52AA\u529B\u5728\u5BD2\u51B7\u4E2D\u6490\u904E\u53BB\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u5EB6\u6C11\u554A\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u807D\u597D\u4E86\u3002\\c\\n\u96D9\u624B\u51B0\u51B7\u7684\u4EBA\u6709\u706B\u71B1\u5FC3\u8178\uFF01\\n\u9019\u500B\u8AAA\u6CD5\u6839\u672C\u5C31\u662F\u8FF7\u4FE1\uFF0C\u5475\uFF01\uFF01[VAR 0114(0041)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7D55\u5C0D\u4E0D\u80FD\\n\u5FD8\u4E86\u9019\u4E00\u9EDE\uFF0C\u5475\u2026\u2026[VAR 0114(0041)]",
  "\u771F\u4E0D\u6127\u662F\u99A5\u597D\uFF01\\n\u91D1\u8A00\u8D8A\u4F86\u8D8A\u96A8\u4FBF\u4E86\uFF01[VAR 0114(0040)]",
  "\u597D\u4E86\uFF0C\u6BC5\u842C\uFF01\\n\u6211\u5011\u7684\u5047\u671F\u4E5F\u5230\u5C3E\u8072\u4E86\u2026\u2026[VAR 0114(0041)]",
  "\u4F5C\u70BA\u6700\u5F8C\u7684\u6536\u5C3E\uFF0C\\n\u6211\u60F3\u53BB\u4FEF\u77B0\\r\\n\u5E15\u5E95\u4E9E\u5730\u5340\u7684[VAR FF00(0006)]\u6B63\u4E2D\u592E[VAR FF00(0000)]\uFF01[VAR 0114(0041)]",
  "\u55B2\uFF5E\uFF01\\n\u518D\u58EF\u89C0\u7684\u5730\u65B9\u4E5F\u8981\u5C45\u9AD8\u81E8\u4E0B\uFF01\\r\\n\u99A5\u597D\u59B3\u771F\u662F\u540D\u6D41\u7684\u5178\u7BC4\uFF01[VAR 0114(0040)]",
  "\u96D6\u7136\u6211\u5011\u53EF\u80FD\u9032\u4E0D\u53BB\u5DE8\u5751\uFF0C\\n\u4F46\u6211\u9084\u662F\u5148\u8DDF\u806F\u76DF\u7533\u8ACB\u770B\u770B\u5594\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u842C\u5148\u751F\\n\u524D\u5F80\u8DDF\u672C\u516C\u53F8\u4E00\u6A23\u6F54\u767D\u7684\u5C71\\r\\n\u767B\u5C71\u53BB\u4E86\u3002",
  "\u2026\u2026\u59D1\u4E14\u4E0D\u8AD6\u672C\u516C\u53F8\u7A76\u7ADF\u662F\u5426\u6F54\u767D\uFF0C\\n\u82E5\u63D0\u5230\u96EA\u767D\u7684\u5C71\uFF0C\u971C\u62B9\u5C71\u662F\u5341\u5206\u51FA\u540D\u3002"
]
