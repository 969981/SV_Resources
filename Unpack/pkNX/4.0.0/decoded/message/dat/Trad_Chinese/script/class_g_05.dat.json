[
  "\u8AF8\u4F4D\u540C\u5B78\uFF0C\u5C07\u624B\u6A5F\u6536\u8D77\u4F86\u5427\u3002\\n\u6211\u5011\u8981\u958B\u59CB\u4E0A\u8AB2\u4E86\u3002[VAR 0114(0029)]",
  "\u671F\u4E2D\u8003\u96D6\u7136\u6709\u4E9B\u540C\u5B78\\n\u88DC\u8003\u4E86\u8A31\u591A\u6B21\uFF0C\\r\\n\u4E0D\u904E\u5927\u81F4\u4E0A\u90FD\u53CA\u683C\u4E86\u3002\u606D\u559C\u3002[VAR 0114(0029)]",
  "\u770B\u4F86\u751F\u5B58\u6240\u5FC5\u9808\u7684\u77E5\u8B58\u8207\u6280\u80FD\\n\u78BA\u5BE6\u6709\u5728\u8AF8\u4F4D\u4E2D\u7D2E\u6839\uFF0C\\r\\n\u6211\u611F\u5230\u975E\u5E38\u69AE\u5E78\u3002[VAR 0114(0029)]",
  "\u671F\u76FC\u8AF8\u4F4D\u5728\u5F8C\u534A\u6BB5\u7684\u8AB2\u5802\u4E2D\uFF0C\\n\u4E5F\u80FD\u7D2E\u7D2E\u5BE6\u5BE6\u5730\u78E8\u7DF4\u751F\u5B58\u672C\u9818\u3002[VAR 0114(0029)]",
  "\u63A5\u4E0B\u4F86\uFF0C\u6709\u90E8\u5206\u540C\u5B78\u63D0\u51FA\u4E86\\n\u95DC\u65BC\u98DF\u529B\u7684\u554F\u984C\u3002[VAR 0114(0029)]",
  "\u5176\u4E2D\u4E00\u4F4D\u63D0\u554F\u8005\u662F\\n\u611B\u505A\u6599\u7406\u7684\u7537\u540C\u5B78\u3002[VAR 0114(0029)]",
  "\u64DA\u8AAA\u4ED6\u7E3D\u662F\\n\u7368\u81EA\u4E00\u4EBA\u5728\u7814\u7A76\u6599\u7406\u3002[VAR 0114(0029)]",
  "\u96D6\u7136\u4ED6\u5341\u5206\u8B1B\u7A76\u98DF\u6750\uFF0C\\n\u65E5\u4EE5\u7E7C\u591C\u5730\u7814\u7A76\u8ABF\u7406\u65B9\u5F0F\u2026\u2026[VAR 0114(0029)]",
  "\u4F46\u537B\u5F88\u96E3\u6709\u6548\u5730\u63D0\u5347\u98DF\u529B\u7684\u6548\u679C\u3002\\n\u9019\u8B93\u4ED6\u5F88\u50B7\u8166\u7B4B\u3002[VAR 0114(0029)]",
  "\u90A3\u9EBC\uFF0C\u8A66\u554F\u671F\u4E2D\u8003\u6210\u7E3E\u512A\u79C0\u7684\\n[VAR 0100(0000)]\u540C\u5B78\u3002[VAR 0114(0029)]",
  "\u82E5\u60F3\u8981\u63D0\u5347\u98DF\u529B\u7684\u6548\u679C\uFF0C\\n\u6D3E\u2026\u2026\u9019\u4F4D\u7537\u540C\u5B78\u8A72\u600E\u9EBC\u8FA6\u5462\uFF1F[VAR 0114(0029)]",
  "\u591A\u591A\u505A\u6599\u7406",
  "\u5927\u5BB6\u4E00\u8D77\u505A\u6599\u7406",
  "\u6D3E\u5E15\uFF1F",
  "\u6599\u7406\u7684\u4E16\u754C\u975E\u5E38\u6DF1\u5967\u2026\u2026\\n\u5373\u4F7F\u4E00\u80A1\u8166\u5730\u7D2F\u7A4D\u6B21\u6578\uFF0C\\r\\n\u4ED8\u51FA\u7684\u52AA\u529B\u4E5F\u672A\u5FC5\u80FD\u63DB\u53D6\u6536\u7A6B\u3002[VAR 0114(0029)]",
  "\u7B54\u5F97\u597D\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5341\u5206\u4E86\u89E3\u4F55\u8B02\u6599\u7406\u5462\u3002[VAR 0114(0029)]",
  "\u5443\u2026\u2026\u9019\u4F4D\u611B\u505A\u6599\u7406\u7684\u7537\u540C\u5B78\u662F\u8AB0\uFF0C\\n\u90A3\u662F\u500B\u79D8\u5BC6\u2026\u2026\\r\\n\u53EF\u80FD\u6703\u662F\u6D3E\u5E15\u540C\u5B78\uFF0C\\r\\n\u4E5F\u53EF\u80FD\u4E0D\u662F\u2026\u2026\uFF01[VAR 0114(0029)]",
  "\u82E5\u8981\u63D0\u5347\u98DF\u529B\u7684\u6548\u679C\uFF0C\\n\u4E09\u660E\u6CBB\u4E2D\u5C31\u5FC5\u9808\u593E\u8457\\r\\n\u8A31\u591A\u7684\u98DF\u6750\u3002[VAR 0114(0029)]",
  "\u5373\u4F7F\u5C0D\uFF11\u500B\u4EBA\u4F86\u8AAA\u96E3\u6613\u5EA6\u5F88\u9AD8\uFF0C\\n\u6709\u591A\u500B\u4EBA\u4E00\u8D77\u505A\u7684\u8A71\uFF0C\\r\\n\u80FD\u5920\u6599\u7406\u7684\u9EB5\u5305\u4E5F\u5C31\u6703\u76F8\u5C0D\u5730\u8B8A\u5927\u3002[VAR 0114(0029)]",
  "\u5982\u6B64\u4E00\u4F86\uFF0C\u5C31\u80FD\u5920\u5F88\u5BB9\u6613\u5730\\n\u5C07\u98DF\u6750\u653E\u9032\u88E1\u9762\u4E86\u3002[VAR 0114(0029)]",
  "\u63DB\u53E5\u8A71\u8AAA\uFF0C\u5C31\u662F\u80FD\u5920\u7372\u5F97\\n\u6548\u679C\u9AD8\u7684\u98DF\u529B\u3002[VAR 0114(0029)]",
  "\u9019\u4EF6\u4E8B\u7684\u6559\u8A13\u5C31\u662F\uFF0C\\n\u9047\u4E0A\u56F0\u96E3\u6642\u4E0D\u8981\uFF11\u500B\u4EBA\u947D\u725B\u89D2\u5C16\uFF0C\\r\\n\u627E\u4EBA\u4E00\u8D77\u89E3\u6C7A\u554F\u984C\uFF0C\u4E5F\u662F\u6709\u6548\u7684\u65B9\u6CD5\u3002[VAR 0114(0029)]",
  "\u6211\u76F8\u4FE1\u6D3E\u5E15\u540C\u5B78\u4ECA\u5F8C\u80AF\u5B9A\u6703\\n\u8207\u670B\u53CB\u4E00\u8D77\u505A\u6599\u7406\u5427\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u81F3\u65BC\u9019\u4F4D\u7537\u540C\u5B78\u662F\u8AB0\uFF0C\\n\u9019\u662F\u6D89\u53CA\u500B\u4EBA\u96B1\u79C1\u7684\u554F\u984C\uFF0C\\r\\n\u56E0\u6B64\u8AF8\u4F4D\u5C31\u5225\u8FFD\u554F\u4E86\u3002\u660E\u767D\u5427\uFF1F[VAR 0114(0029)]",
  "\u672C\u5802\u8AB2\u5230\u6B64\u7D50\u675F\u3002\\n\u6055\u6211\u5931\u966A\u4E86\u3002[VAR 0114(0029)]"
]
