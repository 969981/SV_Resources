[
  "\u5927\u5BB6\u597D\u554A\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u5011\u958B\u59CB\u4E0A\u8AB2\u5427\uFF5E[VAR 0114(002A)]",
  "\u4E0B\u6B21\u662F\u671F\u672B\u8003\uFF0C\\n\u6240\u4EE5\u4ECA\u5929\u662F\u6700\u5F8C\u4E00\u5802\u8AB2\u5594\u3002[VAR 0114(002A)]",
  "\u6700\u5F8C\u4E00\u5802\u8AB2\u7684\u4E3B\u984C\u662F\u2026\u2026\\n\u93D8\u93D8\u93D8\u93D8\uFF5E\uFF01\u5BF6\u53EF\u5922\u7684[VAR FF00(0006)]\u5F62\u614B[VAR FF00(0000)]\u3002\\r\\n\u5927\u5BB6\u5C31\u7576\u4F5C\u662F\u5BF6\u53EF\u5922\u7684\u5916\u578B\u5427\u3002[VAR 0114(002A)]",
  "\u5BF6\u53EF\u5922\u7684\u540C\u4E00\u500B\u9AD4\\n\u5728\u67D0\u7A2E\u689D\u4EF6\u4E0B\u6539\u8B8A\u5F62\u614B\uFF0C\\r\\n\u9019\u5C31\u53EB\u505A[VAR FF00(0006)]\u5F62\u614B\u8B8A\u5316[VAR FF00(0000)]\u5594\uFF5E[VAR 0114(002A)]",
  "\u4F8B\u5982\u5728\u5E15\u5E95\u4E9E\u4E00\u822C\u88AB\u7576\u4F5C\\n\u5750\u9A0E\u5BF6\u53EF\u5922\u7684\u6469\u6258\u8725\uFF0C\\r\\n\u7260\u4E00\u5171\u5C31\u6709\uFF13\u7A2E\u5F62\u614B\u3002[VAR 0114(002A)]",
  "\u5E73\u5E38\u662F\u7528\u56DB\u8173\u6B65\u884C\u7684\u539F\u751F\u5F62\u614B\uFF0C\\n\u6230\u9B25\u6642\u6703\u8B8A\u6210\u7528\u96D9\u8173\u7AD9\u7ACB\u7684\u5C0D\u6230\u5F62\u614B\u3002[VAR 0114(002A)]",
  "\u6700\u5F8C\uFF0C\u7576\u7260\u8981\u8F09\u5927\u5BB6\u6642\\n\u5C31\u6703\u81A8\u8D77\u5589\u56CA\u548C\u5C3E\u5DF4\uFF0C\\r\\n\u8B8A\u6210\u5750\u9A0E\u5F62\u614B\uFF0C\u5C0D\u5427\uFF5E[VAR 0114(002A)]",
  "\u53E6\u5916\uFF0C\u4EE5\u5927\u5BB6\u719F\u6089\u7684\u6771\u897F\u4F86\u8AAA\uFF0C\\n\u5C31\u662F\u5927\u5BB6\u6240\u64C1\u6709\u7684\u6A5F\u68B0\u2026\u2026[VAR 0114(002A)]",
  "\u50CF\u662F\u6709\u4E9B\u624B\u6A5F\u88E1\uFF0C\\n\u4E5F\u6703\u6709\u67D0\u7A2E\u5BF6\u53EF\u5922\u5728\u88E1\u9762\u5594\uFF5E[VAR 0114(002A)]",
  "\u4F86\uFF0C\u8ACB\u554F\u5927\u5BB6\uFF0C\\n\u5728\u624B\u6A5F\u88E1\u7684\u7A76\u7ADF\u662F\u4EC0\u9EBC\u5BF6\u53EF\u5922\u5462\uFF1F[VAR 0114(002A)]",
  "\u6D1B\u6258\u59C6",
  "\u76AE\u5361\u4E18",
  "\u8D6B\u62C9\u514B\u7F85\u65AF",
  "[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6A5F\u68B0\u548C\\n\u5BF6\u53EF\u5922\u90FD\u5F88\u719F\u6089\u5462\uFF5E[VAR 0114(002A)]",
  "\u7684\u78BA\uFF0C\u5982\u679C\u624B\u6A5F\u88E1\u6709\u96BB\\n\u76AE\u5361\u4E18\u5C31\u592A\u53EF\u611B\u4E86\u3002\\r\\n\u8AAA\u4E0D\u5B9A\u9084\u6703\u8B93\u4EBA\u60F3\u591A\u8D70\u4E9B\u8DEF\uFF1F\\r\\n\u2026\u2026\u4F46\u53EF\u60DC\u7B54\u6848\u4E0D\u662F\u7260\u5462\uFF5E\uFF01[VAR 0114(002A)]",
  "[VAR 0100(0000)]\uFF0C\u771F\u6709[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\uFF01\\n\u8D6B\u62C9\u514B\u7F85\u65AF\u7684\u78BA\u662F\u80FD\u5B78\u6703\u4FEE\u9577\u4E4B\u89D2\uFF0C\\r\\n\u7528\u5C16\u5C16\u7684\u89D2\u523A\u9032\u5C0D\u8C61\u88E1\u3002\\r\\n\u2026\u2026\u4F46\u53EF\u60DC\u7B54\u6848\u4E0D\u662F\u7260\u5462\uFF5E\uFF01[VAR 0114(002A)]",
  "\u7E3D\u4E4B\uFF0C\u5927\u5BB6\u7684\u624B\u6A5F\u6709\\n\u6D1B\u6258\u59C6\u5728\u88E1\u9762\uFF0C\\r\\n\u7260\u6703\u5354\u52A9\u5927\u5BB6\u5404\u7A2E\u4E8B\u5594\uFF5E[VAR 0114(002A)]",
  "\u624B\u6A5F\u6D1B\u6258\u59C6\u7684\u6D1B\u6258\u59C6\u5F88\u7279\u5225\uFF0C\\n\u7260\u4E0D\u6703\u9032\u5230\u5225\u7684\u96FB\u5668\u88E1\u9762\u53BB\u3002[VAR 0114(002A)]",
  "\u4F46\u4E00\u822C\u7684\u6D1B\u6258\u59C6\u6703\u85C9\u7531\\n\u9032\u5165\u6D17\u8863\u6A5F\u6216\u5FAE\u6CE2\u7210\uFF0C\\r\\n\u800C\u6539\u8B8A\u81EA\u5DF1\u7684\u5F62\u614B\u5594\uFF5E[VAR 0114(002A)]",
  "\u4E0D\u904E\uFF0C\u6D1B\u6258\u59C6\u7B97\u662F\u4E00\u7A2E\u4F8B\u5916\u3002\\n\u4E00\u822C\u4F86\u8AAA\uFF0C\u9084\u662F\u4EE5\u900F\u904E\u6301\u6709\u7269\u6216\u9053\u5177\\r\\n\u4F86\u6539\u8B8A\u5F62\u614B\u7684\u5BF6\u53EF\u5922\u5360\u5927\u591A\u6578\u3002[VAR 0114(002A)]",
  "\u4F8B\u5982\u7D66\u82B1\u821E\u9CE5\u82B1\u871C\u7684\u8A71\uFF0C\\n\u7260\u5C31\u53EF\u4EE5\u8B8A\u5316\u6210\uFF14\u7A2E\u4E0D\u540C\u7684\u5F62\u614B\u3002[VAR 0114(002A)]",
  "\u6709\u4E9B\u5BF6\u53EF\u5922\u5728\u6539\u8B8A\u5F62\u614B\u5F8C\uFF0C\\n\u9023\u5C6C\u6027\u6216\u62DB\u5F0F\u90FD\u6703\u8DDF\u8457\u6539\u8B8A\u5594\uFF5E[VAR 0114(002A)]",
  "\u5F62\u614B\u8B8A\u5316\u8207\u9032\u5316\u4E0D\u540C\uFF0C\\n\u5BF6\u53EF\u5922\u53EF\u4EE5\u56DE\u5230\u539F\u672C\u7684\u6A23\u5B50\u3002\\c\\n\u800C\u4E14\u4E0D\u540C\u65BC\u7570\u8272\uFF0C\\n\u662F\u6703\u767C\u751F\u5728\u540C\u4E00\u500B\u9AD4\u7684\u73FE\u8C61\u3002[VAR 0114(002A)]",
  "\u5F62\u614B\u8B8A\u5316\u2026\u2026\\n\u771F\u662F\u6DF1\u5967\u7684\u73FE\u8C61\u5462\uFF5E[VAR 0114(002A)]",
  "\u5E0C\u671B\u5927\u5BB6\u80FD\u5411\u5BF6\u53EF\u5922\u770B\u9F4A\u2026\u2026\\n\u9019\u9EBC\u8AAA\u96D6\u7136\u6709\u9EDE\u602A\u3002[VAR 0114(002A)]",
  "\u4F46\u6211\u5E0C\u671B\u5927\u5BB6\u4E5F\u80FD\u5728\u9019\u6240\u5B78\u6821\\n\u597D\u597D\u5B78\u7FD2\uFF0C\u76E1\u60C5\u73A9\u800D\u2026\u2026[VAR 0114(002A)]",
  "\u5F62\u614B\u8B8A\u5316\uFF01\u627E\u5230\u65B0\u7684\u81EA\u5DF1\uFF01\\n\u9019\u6A23\u6211\u5C31\u6703\u5F88\u9AD8\u8208\u7684\uFF5E\\r\\n\u2026\u2026\u5C31\u7576\u662F\u6211\u5728\u958B\u73A9\u7B11\u5427\uFF01[VAR 0114(002A)]",
  "\u554A\u554A\uFF01\u6211\u5FD8\u8A18\u8AAA\u4E86\uFF01[VAR 0114(002A)]",
  "\u4F9D\u5730\u5340\u800C\u4E0D\u540C\u7684\u5730\u5340\u5F62\u614B\\n\u548C\u4E00\u822C\u7684\u6A23\u5B50\u4E0D\u540C\uFF0C\\r\\n\u90A3\u662F\u4E0D\u6703\u6539\u8B8A\u7684\u5148\u5929\u6027\u2026\u2026[VAR 0114(002A)]",
  "\u2026\u2026\u54CE\u5440\u5440\uFF0C\u4E0B\u8AB2\u9418\u97FF\u4E86\u3002[VAR 0114(002A)]",
  "\u5230\u6700\u5F8C\u4E00\u5802\u8AB2\u90FD\u662F\u9019\u6A23\u5B50\uFF0C\\n\u771F\u662F\u62B1\u6B49\u3002\\c\\n\u6BCF\u5802\u8AB2\u6211\u90FD\u4E0A\u5F97\u5F88\u958B\u5FC3\u5594\u3002\\n\u671F\u672B\u8003\u8ACB\u52A0\u6CB9\uFF5E[VAR 0114(002A)]"
]
