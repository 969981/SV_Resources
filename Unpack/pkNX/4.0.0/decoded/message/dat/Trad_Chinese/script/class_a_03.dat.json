[
  "\u5927\u5BB6\u597D\u554A\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u5011\u958B\u59CB\u4E0A\u8AB2\u5427\uFF5E[VAR 0114(002A)]",
  "\u4E0A\u4E00\u5802\u8AB2\u6211\u5011\\n\u63D0\u5230\u4E86\u86CB\u7684\u5BF6\u8CB4\u3002[VAR 0114(002A)]",
  "\u554A\uFF0C\u5C0D\u4E86\uFF0C\u8ACB\u554F\u5927\u5BB6\\n\u6709\u5728\u4F7F\u7528\u5BF6\u53EF\u5922\u5716\u9451\u55CE\uFF1F[VAR 0114(002A)]",
  "\u5F9E\u86CB\u88E1\u5B75\u51FA\u4F86\u7684\u5BF6\u53EF\u5922\\n\u4E5F\u6703\u597D\uFF5E\u597D\u5730\u88AB\u767B\u9304\u5728\u5BF6\u53EF\u5922\u5716\u9451\u88E1\u3002\\r\\n\u5927\u5BB6\u53EF\u4EE5\u653E\u5FC3\u5594\uFF5E[VAR 0114(002A)]",
  "\u563F\u563F\u2026\u2026\u5176\u5BE6\u554A\uFF0C\\n\u5BF6\u53EF\u5922\u5716\u9451App\u662F\u6211\u505A\u7684\u6771\u897F\u3002[VAR 0114(002A)]",
  "\u96D6\u7136\u90A3\u662F\u5F88\uFF5E\u4E45\u4EE5\u524D\uFF0C\\n\u8DDD\u96E2\u6211\u5230\u9019\u6240\u5B78\u6821\u4EFB\u6559\u6709\u6BB5\u6642\u9593\u2026\u2026[VAR 0114(002A)]",
  "\u4F46\u6211\u66FE\u7D93\u662F\u500B\u7814\u7A76\u54E1\u3002[VAR 0114(002A)]",
  "\u90A3\u6642\u5019\u514B\u62C9\u97CB\u723E\u6821\u9577\\n\u4E5F\u9084\u4E0D\u662F\u5B78\u6821\u7684\u8001\u5E2B\uFF0C\\r\\n\u6211\u5011\u5169\u500B\u90FD\u5728\u540C\u4E00\u500B\u8A2D\u65BD\u505A\u7814\u7A76\u3002[VAR 0114(002A)]",
  "\u90A3\u6642\u6211\u5011\u6BCF\u5929\u4E00\u8D77\u7814\u7A76\u5BF6\u53EF\u5922\uFF0C\\n\u597D\u5FEB\u6A02\u554A\u2026\u2026\\r\\n\u96D6\u7136\u6211\u7E3D\u662F\u5728\u6328\u7F75\u3002[VAR 0114(002A)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\u6211\u600E\u9EBC\u6703\u8AAA\u8D77\u9019\u500B\uFF1F\\n\u6211\u4E0D\u662F\u5728\u8B1B\u5716\u9451\u7684\u4E8B\u55CE\uFF5E[VAR 0114(002A)]",
  "\u2026\u2026\u5C0D\u4E86\uFF0C\u4ECA\u5929\u9019\u5802\u8AB2\u662F\u8981\u6559\u5927\u5BB6\\n\u95DC\u65BC\u6355\u6349\u5BF6\u53EF\u5922\u7684\u77E5\u8B58\u5594\u3002[VAR 0114(002A)]",
  "\u6B63\u5982\u5927\u5BB6\u6240\u77E5\u9053\u7684\uFF0C\\n\u5982\u679C\u60F3\u8981\u6355\u6349\u5BF6\u53EF\u5922\uFF0C\\r\\n\u9996\u5148\u662F\u8981\u524A\u6E1B\u5C0D\u65B9\u7684\u9AD4\u529B\u5C0D\u5427\uFF5E[VAR 0114(002A)]",
  "\u90A3\u9EBC\uFF0C\u5927\u5BB6\u77E5\u4E0D\u77E5\u9053\u9664\u4E86\u524A\u6E1B\\n\u5BF6\u53EF\u5922\u7684\u9AD4\u529B\u4E4B\u5916\uFF0C\u9084\u6709\u5176\u4ED6\u80FD\u5920\\r\\n\u5728\u5C0D\u6230\u4E2D\u8F03\u5BB9\u6613\u6355\u6349\u5BF6\u53EF\u5922\u7684\u6280\u5DE7\uFF1F[VAR 0114(002A)]",
  "\u7D66\u7260\u6A39\u679C",
  "\u8B93\u7260\u9677\u5165\u7570\u5E38\u72C0\u614B",
  "\u8B93\u7260\u898B\u8B58\u529B\u91CF\u7684\u5DEE\u8DDD",
  "\u54CE\u5440\u5440\uFF5E\uFF1F\u90A3\u662F\u4E0D\u662F\\n\u5176\u4ED6\u5730\u5340\u7684\u65B9\u6CD5\u5462\uFF5E\uFF1F\\c\\n\u5728\u5E15\u5E95\u4E9E\u7684\u8A8D\u77E5\\n\u6709\u90A3\uFF5E\u9EBC\u4E00\u9EDE\u4E0D\u540C\u5594\u2026\u2026[VAR 0114(002A)]",
  "\u54C7\uFF5E[VAR 0100(0000)]\uFF01\\n\u597D\u53B2\u5BB3\uFF01\u6B63\u78BA\u7B54\u6848\uFF01[VAR 0114(002A)]",
  "\u54C7\u5594\uFF5E[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u60F3\u6CD5\u5F88\u72C2\u91CE\u5462\u2026\u2026\\c\\n\u6D3E\u51FA\u5F37\u5927\u7684\u5BF6\u53EF\u5922\uFF0C\u7684\u78BA\u662F\\n\u80FD\u8B93\u5C0D\u6230\u9032\u884C\u5F97\u6BD4\u8F03\u6709\u5229\u6C92\u932F\u5566\u3002[VAR 0114(002A)]",
  "\u8A00\u6B78\u6B63\u50B3\uFF0C\u8B93\u5BF6\u53EF\u5922\u9677\u5165\u7570\u5E38\u72C0\u614B\uFF0C\\n\u5C31\u6703\u6BD4\u8F03\u5BB9\u6613\u6355\u6349\u7260\u5594\uFF5E[VAR 0114(002A)]",
  "\u5C24\u5176\u662F\u7761\u7720\u72C0\u614B\uFF0C\\n\u80FD\u5920\u8B93\u6355\u7372\u7387\u6975\uFF5E\u5927\u5E45\u5730\u63D0\u9AD8\uFF01[VAR 0114(002A)]",
  "\u53EA\u8981\u6709\u50AC\u7720\u7C89\u3001\u50AC\u7720\u8853\u9019\u985E\\n\u80FD\u5920\u8B93\u5C0D\u65B9\u7761\u8457\u7684\u62DB\u5F0F\uFF0C\\r\\n\u5C31\u80FD\u767B\u9304\u8A31\u591A\u5BF6\u53EF\u5922\u5230\u5716\u9451\u88E1\u4E86\uFF5E\uFF01[VAR 0114(002A)]",
  "\u6B64\u5916\uFF0C\u60F3\u8981\u63D0\u5347\u6355\u7372\u7387\u7684\u8A71\uFF0C\\n\u4E5F\u53EF\u4EE5\u91DD\u5C0D\u5BF6\u53EF\u5922\u9078\u64C7\u9069\u5408\u7260\u7684\u7403\u3002[VAR 0114(002A)]",
  "\u6216\u662F\u900F\u904E\u5403\u6771\u897F\u7372\u5F97\u6355\u7372\u529B\uFF0C\\n\u53E6\u5916\u4E5F\u53EF\u4EE5\u5F9E\u5BF6\u53EF\u5922\u7684\u80CC\u5F8C\u5C55\u958B\u5C0D\u6230\u3002[VAR 0114(002A)]",
  "\u5982\u679C\u5728\u6355\u6349\u5BF6\u53EF\u5922\u6642\u611F\u5230\u78B0\u58C1\u7684\u8A71\uFF0C\\n\u53EF\u4EE5\u53BB\u95D6\u9053\u9928\u6536\u96C6\u9053\u9928\u5FBD\u7AE0\u3002[VAR 0114(002A)]",
  "\u63D0\u5347\u81EA\u5DF1\u80FD\u6355\u6349\u7684\u5BF6\u53EF\u5922\u7684\u7B49\u7D1A\uFF0C\\n\u9019\u4E5F\u662F\u5F88\u91CD\u8981\u7684\u5594\uFF5E[VAR 0114(002A)]",
  "\u7576\u5BF6\u53EF\u5922\u5716\u9451\u586B\u5F97\u5DEE\u4E0D\u591A\u6642\uFF0C\u8ACB\u52D9\u5FC5\uFF01\\n\u62FF\u4F86\u7D66\u5409\u5C3C\u4E9E\u8001\u5E2B\u6211\u770B\u770B\u5427\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u5929\u6211\u4E5F\u6559\u8AB2\u6559\u5F97\u5F88\u958B\u5FC3\u3002\\n\u4E0B\u4E00\u5802\u8AB2\u6703\u8003\u8A66\u5594\uFF5E[VAR 0114(002A)]"
]
