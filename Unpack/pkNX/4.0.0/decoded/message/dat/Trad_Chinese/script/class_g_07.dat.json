[
  "\u8AF8\u4F4D\u540C\u5B78\uFF0C\u5C07\u624B\u6A5F\u6536\u8D77\u4F86\u5427\u3002\\n\u6211\u5011\u8981\u958B\u59CB\u9019\u5B78\u671F\u7684\u6700\u5F8C\u4E00\u5802\u8AB2\u4E86\u3002[VAR 0114(0029)]",
  "\u56DE\u982D\u4E00\u60F3\uFF0C\u8AB2\u5802\u4E0A\u8AC7\u5230\u7684\u76E1\u662F\\n\u8863\u3001\u98DF\u3001\u4F4F\u4E2D\u95DC\u65BC\u300C\u98DF\u300D\u7684\u90E8\u5206\u554A\u3002[VAR 0114(0029)]",
  "\u96D6\u7136\u6709\u9EDE\u70BA\u6642\u5DF2\u665A\uFF0C\\n\u4F46\u8B93\u6211\u4F86\u8B1B\u4E00\u4E0B\u95DC\u65BC\u300C\u8863\u300D\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u670D\u88DD\u7684\u90E8\u5206\u5427\u3002[VAR 0114(0029)]",
  "\u8AF8\u4F4D\u540C\u5B78\u60F3\u5FC5\u90FD\u77E5\u9053\uFF0C\\n\u672C\u6821\u7684\u6821\u98A8\u6975\u70BA\u81EA\u7531\u3002[VAR 0114(0029)]",
  "\u96D6\u7136\u6821\u65B9\u914D\u5408\u5E15\u5E95\u4E9E\u591A\u6A23\u5316\u7684\u6C23\u5019\\n\u6E96\u5099\u4E86\u5404\u7A2E\u5B63\u7BC0\u7684\u5236\u670D\uFF0C\\r\\n\u4F46\u5B78\u751F\u611B\u5728\u4EC0\u9EBC\u6642\u5019\u7A7F\u4EC0\u9EBC\u5236\u670D\u90FD\u53EF\u4EE5\u3002[VAR 0114(0029)]",
  "\u5728\u8AF8\u4F4D\u5165\u5B78\u6642\u61C9\u8A72\u6709\u9818\u5230\\n\u9069\u5408\u5728\u6625\u3001\u590F\u3001\u79CB\u3001\u51AC\u7A7F\u7684\\r\\n\u4E0A\u88DD\u8207\u4E0B\u88DD\u5171\uFF14\u5957\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u82E5\u662F\u6709\u540C\u5B78\u6C92\u6CE8\u610F\u5230\uFF0C\\n\u8ACB\u8A18\u5F97\u53BB\u78BA\u8A8D\u81EA\u5DF1\u7684\u8863\u6AE5\u3002[VAR 0114(0029)]",
  "\u53EA\u8981\u6709\u7A7F\u8457\u5236\u670D\uFF0C\\n\u5305\u5305\u5C31\u4E0D\u9650\u65BC\u4F7F\u7528\u5B78\u6821\u6307\u5B9A\u7684\u6771\u897F\u3002[VAR 0114(0029)]",
  "\u5E3D\u5B50\u7684\u7A2E\u985E\uFF0C\u662F\u5426\u8981\u6234\u5E3D\u5B50\uFF0C\\n\u751A\u81F3\u662F\u9AEE\u578B\u8981\u5982\u4F55\uFF0C\u90FD\u53EF\u4EE5\u81EA\u7531\u9078\u64C7\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u8CFD\u5409\u8001\u5E2B\u7684\u9AEE\u578B\\n\u8981\u662F\u5728\u6211\u5E74\u8F15\u7684\u6642\u5019\uFF0C\\r\\n\u5927\u6982\u6703\u88AB\u8996\u70BA\u9055\u53CD\u6821\u898F\u5427\u3002[VAR 0114(0029)]",
  "\u9019\u5C31\u8B93\u6211\u60F3\u8D77\u4E86\u2026\u2026[VAR 0114(0029)]",
  "\u5728\u670D\u88DD\u4E4B\u5916\uFF0C\u8AF8\u4F4D\u6642\u5E38\u6703\u96A8\u5FC3\u60C5\\n\u63DB\u4F86\u63DB\u53BB\u7684\u90A3\u500B\u53EF\u611B\u6771\u897F\u2026\u2026\\r\\n\u90A3\u7A76\u7ADF\u662F\u8981\u600E\u9EBC\u5F04\uFF1F[VAR 0114(0029)]",
  "\u6559\u5BA4\u7684\u684C\u5B50\uFF1F",
  "\u5BBF\u820D\u7684\u623F\u9593\uFF1F",
  "\u624B\u6A5F\u6D1B\u6258\u59C6\uFF1F",
  "\u4E0D\uFF0C\u4E0D\u662F\u2026\u2026\\n\u662F\u66F4\u5C0F\u3001\u66F4\u53EF\u611B\u7684\u90A3\u500B\u2026\u2026\\r\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u684C\u5B50\u7C21\u76F4\u5C31\u662F\\r\\n\u5E73\u51E1\u666E\u901A\u5230\u4E86\u6975\u9EDE\u554A\uFF01[VAR 0114(0029)]",
  "\u4E0D\uFF0C\u4E0D\u662F\u2026\u2026\\n\u662F\u66F4\u5C0F\u3001\u66F4\u53EF\u611B\u7684\u90A3\u500B\u2026\u2026\\r\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\u8981\u662F\u6211\u77E5\u9053\u8AF8\u4F4D\u7684\\r\\n\u623F\u9593\u662F\u600E\u9EBC\u6A23\uFF0C\u90A3\u6703\u662F\u500B\u5927\u554F\u984C\u554A\u3002[VAR 0114(0029)]",
  "\u7B54\u5F97\u597D\uFF01\u5C31\u662F\u90A3\u500B\u53EF\u611B\u7684\u6771\u897F\uFF01\\n\u6211\u597D\u5947\u5F97\u4E0D\u5F97\u4E86\uFF01\uFF01[VAR 0114(0029)]",
  "\u6C92\u932F\u2026\u2026\u5C31\u662F\u624B\u6A5F\u6D1B\u6258\u59C6\uFF01[VAR 0114(0029)]",
  "\u2026\u2026\u539F\u4F86\u5982\u6B64\uFF0C\u771F\u662F\u8010\u4EBA\u5C0B\u5473\uFF01\\n\u5728\u7A31\u70BA\u4FE1\u4F7F\u9CE5\u5305\u5305\u7684\u5546\u5E97\\r\\n\u53EF\u4EE5\u8CFC\u8CB7\u624B\u6A5F\u6D1B\u6258\u59C6\u7684\u5916\u6BBC\u662F\u5427\uFF01[VAR 0114(0029)]",
  "\u611F\u8B1D\u8AF8\u4F4D\u6709\u7528\u7684\u8CC7\u8A0A\u2026\u2026[VAR 0114(0029)]",
  "\u660E\u5929\u6211\u5C31\u8D95\u7DCA\u53BB\u8CB7\u500B\\n\u81EA\u5DF1\u559C\u6B61\u7684\u53EF\u611B\u624B\u6A5F\u6BBC\u5427\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u804A\u5929\u804A\u904E\u982D\u4E86\u3002[VAR 0114(0029)]",
  "\u597D\u4E86\uFF0C\u8207\u6211\u4E00\u8D77\u5B78\u7FD2\u5BB6\u653F\u8AB2\\n\u9019\u9580\u751F\u5B58\u6280\u8853\u7684\u8AF8\u4F4D\u540C\u5B78\u3002\\r\\n\u6700\u5F8C\u6211\u6709\u4E00\u4EF6\u4E8B\u8981\u8AAA\u3002[VAR 0114(0029)]",
  "\u6211\u7684\u5B78\u554F\u4E26\u4E0D\u662F\u4EC0\u9EBC\u4E86\u4E0D\u8D77\u7684\u6771\u897F\uFF0C\\n\u4E0D\u540C\u65BC\u6578\u5B78\u7B49\u79D1\u76EE\uFF0C\u8003\u8A66\u7684\u5206\u6578\\r\\n\u4E5F\u4E0D\u6703\u5F71\u97FF\u8AF8\u4F4D\u7684\u524D\u9014\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u4F46\u82E5\u80FD\u5728\u8AF8\u4F4D\u505A\u6599\u7406\u6642\uFF0C\\n\u7167\u9867\u5BF6\u53EF\u5922\u6642\uFF0C\\r\\n\u65E9\u4E0A\u8D77\u5E8A\u9078\u64C7\u670D\u88DD\u6642\u2026\u2026[VAR 0114(0029)]",
  "\u6210\u70BA\u7A0D\u5FAE\u8C50\u5BCC\u8AF8\u4F4D\u4EBA\u751F\u7684\u6F64\u6ED1\u5291\uFF0C\\n\u6211\u9019\u500B\u5BB6\u653F\u8001\u5E2B\u5C31\u8207\u6709\u69AE\u7109\u4E86\u3002\\r\\n\u2026\u2026\u96D6\u7136\u6211\u9019\u662F\u5B78\u4E86\u516B\u6714\u8001\u5E2B\u7684\u8A71\u3002[VAR 0114(0029)]",
  "\u611F\u8B1D\u8AF8\u4F4D\u9078\u4FEE\\n\u6211\u9019\u5802\u8AB2\u5230\u6700\u5F8C\u3002[VAR 0114(0029)]",
  "\u672C\u5802\u8AB2\u5230\u6B64\u7D50\u675F\u3002\\n\u795D\u8AF8\u4F4D\u671F\u672B\u8003\u4E00\u5207\u9806\u5229\u3002[VAR 0114(0029)]"
]
