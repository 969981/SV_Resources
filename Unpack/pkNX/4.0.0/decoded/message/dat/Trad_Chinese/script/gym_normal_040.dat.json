  "[VAR 0100(0000)]\uFF0C\\n\u6B61\u8FCE\u5149\u81E8\u9326\u532F\u9053\u9928\u5F8C\u63F4\u5E97\uFF0C\u5BF6\u98DF\u5802\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u6311\u6230\u8D85\u51E1\u812B\u4FD7\u4E0A\u73ED\u65CF\u2026\u2026\\n\u9053\u9928\u9928\u4E3B\u9752\u6728\u55CE\uFF1F",
  "\u90A3\u9EBC\uFF0C\u8ACB\u7AD9\u4E0A\u5C0D\u6230\u5834\u3002",
  "\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u6E96\u5099\u597D\u5F8C\uFF0C\\n\u8ACB\u96A8\u6642\u544A\u8A34\u6211\u4E00\u8072\u3002",
  "\u9752\u6728\uFF5E\uFF01\\n\u4E0A\u5834\u56C9\uFF5E\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u3002[VAR 0114(002C)]",
  "\u6211\u5C31\u662F\u6D3E\u99D0\u5728\u9326\u532F\u9053\u9928\u7684\\n\u9053\u9928\u9928\u4E3B\uFF0C\u9752\u6728\u3002[VAR 0114(0015)]",
  "\u9053\u9928\u6E2C\u9A57\uFF0C\\n\u8F9B\u82E6[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\u3002[VAR 0114(0015)]",
  "\u55EF\u2026\u2026\u9019\u5BB6\u5E97\u9664\u4E86\u70E4\u98EF\u7CF0\uFF0C\\n\u5176\u4ED6\u7684\u6771\u897F\u4E5F\u5F88\u597D\u5403\u3002[VAR 0114(0015)]",
  "\u4E00\u76F4\u9592\u804A\u7684\u8A71\uFF0C\\n\u6211\u6703\u88AB\u4E0A\u53F8\u7F75\u7684\u3002\\r\\n\u6211\u5011\u958B\u59CB\u5C0D\u6230\u5427\u3002[VAR 0114(0015)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\uFF0C\u6211\u662F\u9752\u6728\u3002\\n\u8ACB\u591A\u6307\u6559\u3002[VAR 0114(0015)]",
  "\u771F\u662F\u975E\u6BD4\u5C0B\u5E38\u7684\u5BE6\u529B\u3002\\n\u8B93\u6211\u4E00\u4E0D\u7559\u795E\u5C31\u6C92\u8868\u60C5\u4E86\u3002[VAR 0114(0015)]",
  "\u6211\u6253\u8F38\u4E86\uFF0C\\n\u56E0\u6B64\u6211\u6703\u628A\u5FBD\u7AE0\u4EA4\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002\u4E0D\u904E\u2026\u2026[VAR 0114(0015)]",
  "\u2026\u2026\u7D93\u904E\u9019\u9EBC\u4E00\u6230\uFF0C\u6211\u9913\u4E86\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u4E0D\u8981\u4E00\u8D77\u5403\u9813\u98EF\uFF1F[VAR 0114(0015)]",
  "\u6709[VAR 0200(0001)]\u500B\u9053\u9928\u5FBD\u7AE0\u7684\u8A71\uFF0C\\n\u7B49\u7D1A[VAR 0201(0002)]\u4EE5\u4E0B\u7684\u5BF6\u53EF\u5922\\r\\n\u6703\u6BD4\u8F03\u5BB9\u6613\u6355\u6349\u2026\u2026\u800C\u4E14\u6703\u4E56\u4E56\u807D\u8A71\u3002[VAR 0114(0015)]",
  "\u64C1\u6709\uFF18\u500B\u9053\u9928\u5FBD\u7AE0\u7684\u8A71\uFF0C\\n\u4E0D\u8AD6\u4EC0\u9EBC\u5BF6\u53EF\u5922\u90FD\u80FD\u6355\u6349\uFF0C\\r\\n\u800C\u4E14\u7260\u5011\u4E0D\u6703\u9055\u80CC[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u6307\u793A\u3002[VAR 0114(0015)]",
  "\u2026\u2026\u9019\u88E1\u7684\u6599\u7406\u5473\u9053\u5F88\u5920\uFF0C\\n\u5F88\u597D\u5403\u5462\u3002[VAR 0114(0015)]",
  "\u50CF[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u6A23\u6D3B\u529B\u5341\u8DB3\u7684\u5B69\u5B50\\n\u5927\u6982\u4E0D\u9700\u8981\uFF0C\u4E0D\u904E\u9019\u500B\u4E5F\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\u3002[VAR 0114(0015)]",
  "\u9019\u9910\u5C31\u7531\u6211\u8CB7\u55AE\u4E86\u3002\\n\u597D\u6B79\u6211\u4E5F\u662F\u500B\u5927\u4EBA\u2026\u2026[VAR 0114(0015)]",
  "\u90A3\u9EBC\uFF0C\u5931\u966A\u4E86\u3002[VAR 0114(0015)]",
  "\u606D\u559C\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u9326\u532F\u9053\u9928\u53CA\u683C\u4E86\uFF01",
  "\u56BC\u554A\u56BC\u2026\u2026\\n\u5403\u554A\u5403\u2026\u2026[VAR 0114(0015)]"
