[
  "\u55E8\uFF5E\u963F\u7F85\u62C9\uFF01\\n\u6211\u8D85\u559C\u6B61\u963F\u7F85\u62C9\u7684\u5BF6\u53EF\u5922\u7684\u5462\uFF01",
  "\u6211\u597D\u60F3\u770B\u4E00\u773C\\n\u963F\u7F85\u62C9\u7684\u6A23\u5B50\u7684\u9686\u9686\u5CA9\uFF0C\\r\\n\u7260\u662F\u5426\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u540C\u884C\u5BF6\u53EF\u5922\u6216\u76D2\u5B50\u88E1\u5462\uFF1F",
  "\u5C31\u53EA\u6709\u9686\u9686\u5CA9\uFF0C\\n\u6211\u600E\u9EBC\u627E\u5C31\u662F\u627E\u4E0D\u5230\u2026\u2026",
  "\u90A3\u96BB\u5BF6\u53EF\u5922\u2026\u2026\\n\u9023\u9686\u9686\u5CA9\u90FD\u4E0D\u662F\u5462\uFF01",
  "\u90A3\u96BB\u5BF6\u53EF\u5922\u2026\u2026\\n\u662F\u666E\u901A\u7684\u9686\u9686\u5CA9\u5594\uFF01\uFF01\\r\\n\u6211\u60F3\u770B\u7684\u662F\uFF01\u963F\u7F85\u62C9\u7684\u6A23\u5B50\uFF01\uFF01",
  "\u90A3\u96BB\u5BF6\u53EF\u5922\u2026\u2026\\n\u662F\u963F\u7F85\u62C9\u7684\u6A23\u5B50\u7684\u9686\u9686\u5CA9\uFF01\uFF01",
  "\u982D\u4E0A\u7206\uFF5E\u5F97\u8D85\u6709\u7570\u570B\u60C5\u8ABF\uFF01\\n\u7709\u6BDB\u8DDF\u9B0D\u5B50\u4E5F\u662F\u5A01\u98A8\u51DC\u51DC\u5462\uFF5E\uFF01",
  "\u2026\u2026\u7260\u662F\u900F\u904E\u9023\u7DDA\u4EA4\u63DB\u4F86\u9032\u5316\uFF0C\\n\u6240\u4EE5\u624D\u5F88\u96E3\u627E\u5230\u91CE\u751F\u7684\u5427\u3002",
  "\u5728\u611F\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u540C\u6642\uFF0C\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u64FA\u64FA\u770B\\n\u9019\u500B\u65E2\u963F\u7F85\u62C9\u53C8\u9686\u9686\u5CA9\u7684\u8868\u60C5\u5427\uFF01",
  "[VAR 0100(0000)]\u5F9E\u5973\u5B69\u90A3\u88E1\\n\u5B78\u6703\u4E86[VAR FF00(0008)]\u96FB\uFF3A\u8868\u60C5[VAR FF00(0000)]\uFF01",
  "\u5728\u64FA\u96FB\uFF3A\u59FF\u52E2\u6642\uFF0C\u624B\u7684\u89D2\u5EA6\u5F88\u91CD\u8981\uFF01\\n\u7136\u5F8C\u9084\u8981\u5927\u8072\u558A\u300C\u963F\u7F85\u62C9\u300D\u5594\uFF01"
]
