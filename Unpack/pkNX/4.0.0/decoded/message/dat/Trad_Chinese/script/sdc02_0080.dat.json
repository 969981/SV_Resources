[
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u6349\u5230\u963F\u7F85\u62C9\u7684\u6A23\u5B50\u7684\\n\u5BF6\u53EF\u5922\u4E86\u55CE\uFF1F",
  "\u61F7\u8457\u963F\u7F85\u62C9\u7684\u5FC3\u60C5\\n\u56DB\u8655\u8D70\u8D70\u5427\uFF01",
  "\u2026\u2026\u5F88\u53EF\u60DC\uFF0C\u90A3\u96BB\u5BF6\u53EF\u5922\\n\u4E26\u4E0D\u662F\u963F\u7F85\u62C9\u7684\u6A23\u5B50\u3002",
  "\u54E6\u54E6\uFF01\u6C92\u932F\uFF01\\n\u90A3\u96BB[VAR 0101(0001)]\u662F\u963F\u7F85\u62C9\u7684\u6A23\u5B50\uFF01",
  "\u7260\u662F\u6703\u7528\u96C6\u4E2D\u4E86\u7CBE\u795E\u529B\u91CF\u7684\u5C3E\u5DF4\uFF0C\\n\u50CF\u6ED1\u884C\u822C\u5730\u79FB\u52D5\u7684\u5BF6\u53EF\u5922\u3002\\r\\n\u7260\u9084\u88AB\u7A31\u70BA\u9678\u5730\u885D\u6D6A\u624B\u5462\uFF01",
  "\u9019\u5BF6\u53EF\u5922\u6703\u64FA\u52D5\\n\u982D\u4E0A\u9577\u51FA\u4F86\u7684\u91D1\u5C6C\u6750\u8CEA\u7684\u9B0D\u9B1A\uFF0C\\r\\n\u85C9\u6B64\u8DDF\u5925\u4F34\u9032\u884C\u4EA4\u6D41\u5462\uFF01",
  "\u7260\u90A3\u9583\u8457\u91D1\u5149\u7684\u9B0D\u9B1A\u662F\\n\u9748\u654F\u5EA6\u6975\u9AD8\u7684\u611F\u61C9\u5668\uFF0C\\r\\n\u5C31\u9023\u6578\u516C\u91CC\u5916\u7684\u8072\u97F3\u4E5F\u80FD\u611F\u61C9\u5230\uFF01",
  "\u6027\u60C5\u5584\u8B8A\u3001\u4EFB\u6027\u3001\u7F3A\u4E4F\u8010\u6027\uFF01\\n\u9019\u5BF6\u53EF\u5922\u5F88\u53D7\u90A3\u4E9B\u6BD4\u8D77\u88AB\u5225\u4EBA\u7167\u9867\uFF0C\\r\\n\u66F4\u559C\u6B61\u53BB\u7167\u9867\u5225\u4EBA\u7684\u8A13\u7DF4\u5BB6\u6B61\u8FCE\uFF01",
  "\u9019\u5BF6\u53EF\u5922\u64C1\u6709\u512A\u79C0\u7684\u9AD4\u80FD\u3002\\n\u5713\u5713\u7684\u81C9\u5B54\u548C\u5149\u6ED1\u7684\u6BDB\u9AEE\uFF0C\\r\\n\u8B93\u7260\u5728\u963F\u7F85\u62C9\u5730\u5340\u5927\u53D7\u6B61\u8FCE\uFF01",
  "\u70BA\u4E86\u89E3\u6C7A\u5783\u573E\u554F\u984C\\n\u800C\u88AB\u5E36\u5230\u963F\u7F85\u62C9\u7684\u81ED\u6CE5\uFF0C\\r\\n\u4E0D\u77E5\u4E0D\u89BA\u4E2D\u5C31\u8B8A\u6210\u9019\u500B\u6A23\u5B50\u4E86\uFF01",
  "\u7260\u90A3\u770B\u8D77\u4F86\u50CF\u7259\u9F52\u548C\u722A\u5B50\u7684\u6771\u897F\\n\u662F\u6BD2\u7D20\u7D50\u6676\uFF0C\u4E00\u65E6\u78B0\u5230\u5C31\u6703\u4E2D\u6BD2\u3002\\r\\n\u6240\u4EE5\u9760\u8FD1\u9019\u7A2E\u5BF6\u53EF\u5922\u662F\u5F88\u5371\u96AA\u7684\uFF01",
  "\u9019\u5BF6\u53EF\u5922\u56E0\u70BA\u662F\u60A0\u60A0\u5730\u6210\u9577\uFF0C\\n\u6240\u4EE5\u8B8A\u5F97\u4E0D\u518D\u9700\u8981\u7CBE\u795E\u529B\u91CF\uFF0C\\r\\n\u9F8D\u4E4B\u529B\u4E5F\u89BA\u9192\u4E86\u5462\uFF01",
  "\u9019\u5BF6\u53EF\u5922\u6703\u5674\u51FA\u96F6\u4E0B\uFF15\uFF10\u5EA6\u7684\u51B7\u6C23\uFF0C\\n\u6709\u6642\u4EBA\u5011\u6703\u7528\u7260\u904E\u53BB\u7684\u540D\u5B57\\r\\n\u300C\u51F1\u6B50\u51F1\u6B50\u300D\u4F86\u7A31\u547C\u7260\u5462\uFF01",
  "\u9019\u5BF6\u53EF\u5922\u751F\u6D3B\u5728\u88AB\u51B0\u96EA\u5C01\u9589\u7684\u6DF1\u5C71\u4E2D\uFF0C\\n\u80FD\u5F9E\u9AD4\u6BDB\u4E2D\u751F\u51FA\u51B0\u7C92\u3002\\r\\n\u4EBA\u5011\u66FE\u7D93\u656C\u4EF0\u7260\u70BA\u795E\u7684\u5316\u8EAB\u5462\uFF01",
  "\u9019\u5BF6\u53EF\u5922\u4F4F\u5728\u51B0\u5929\u96EA\u5730\u7684\u5C71\u5CB3\u5730\u5E36\uFF0C\\n\u64C1\u6709\u92FC\u9435\u822C\u5805\u786C\u7684\u51B0\u6676\u80CC\u810A\\r\\n\u548C\u67D4\u8EDF\u7684\u809A\u5B50\u5462\uFF01",
  "\u70BA\u4E86\u5C07\u96EA\u64A5\u958B\uFF0C\\n\u7260\u7684\u722A\u5B50\u7279\u5225\u767C\u9054\uFF0C\u9577\u5F97\u7C97\u58EF\u800C\u5C16\u92B3\uFF0C\\r\\n\u662F\u80FD\u5728\u96EA\u539F\u4E0A\u9AD8\u901F\u79FB\u52D5\u7684\u5BF6\u53EF\u5922\u5462\uFF01",
  "\u9019\u5BF6\u53EF\u5922\u7684\u8EAB\u9AD4\u662F\u5E36\u6709\u78C1\u529B\u7684\u77F3\u982D\uFF01\\n\u5728\u78C1\u529B\u7279\u5225\u5F37\u7684\u90E8\u5206\\r\\n\u9644\u8457\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u9435\u7802\u5594\uFF01",
  "\u7260\u53D7\u5230\u611B\u5403\u7684\u77F3\u982D\u5F71\u97FF\uFF0C\\n\u5168\u8EAB\u90FD\u5E36\u8457\u96FB\uFF0C\\r\\n\u662F\u6027\u683C\u975E\u5E38\u597D\u9B25\u7684\u5BF6\u53EF\u5922\u5462\uFF01",
  "\u9019\u5BF6\u53EF\u5922\u7684\u500B\u6027\u9811\u56FA\u4E14\u96E3\u76F8\u8655\uFF01\\n\u7260\u5FC3\u60C5\u4E0D\u597D\u7684\u6642\u5019\u6703\u653E\u96FB\uFF0C\\r\\n\u4E26\u767C\u51FA\u50CF\u96F7\u9CF4\u822C\u7684\u543C\u53EB\u8072\u5462\uFF01",
  "\u4EC0\u9EBC\uFF01\uFF1F[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5DF2\u7D93\u6349\u5230\u4E86\u55CE\uFF1F[VAR 0114(0049)]",
  "\u6211\u62FC\u547D\u6349\u7684\uFF01",
  "\u5C0F\u4E8B\u4E00\u6A01\uFF01",
  "\u539F\u4F86[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u53EA\u64C5\u9577\u5C0D\u6230\uFF0C\\n\u9023\u6355\u6349\u5BF6\u53EF\u5922\u4E5F\u5F88\u62FF\u624B\u2026\u2026[VAR 0114(0049)]",
  "\u6A58\u5B50\u5B78\u9662\u7684\\n\u6C34\u6E96\u4E4B\u9AD8\u53EF\u898B\u4E00\u6591\u3002[VAR 0114(0049)]",
  "\u8461\u8404\u5B78\u9662\u7684\\n\u6C34\u6E96\u4E4B\u9AD8\u53EF\u898B\u4E00\u6591\u3002[VAR 0114(0049)]",
  "\u597D\u7684\uFF0C\\n\u90A3\u9EBC\u5927\u5BB6\u8ACB\u96C6\u5408\uFF5E\uFF01",
  "\u6642\u9593\u5230\u4E86\uFF0C\\n\u9019\u5802\u8AB2\u5C31\u5230\u6B64\u70BA\u6B62\uFF01",
  "\u9084\u6C92\u6349\u5230\u7684\u4EBA\u5C31\u7576\u4F5C\u662F\u529F\u8AB2\uFF0C\\n\u8981\u5728\u4E0B\u6B21\u4E0A\u8AB2\u524D\u6349\u5230\u5594\uFF01\\r\\n\u90A3\u9EBC\uFF0C\u89E3\u6563\uFF01",
  "\u547F\uFF5E\u6211\u5F97\u505A\u529F\u8AB2\u5566\uFF5E",
  "[VAR 0100(0000)]\uFF0C\\n\u5728\u85CD\u8393\u5B78\u5712\u4E0A\u8AB2\u6709\u4EC0\u9EBC\u611F\u60F3\u5462\uFF1F[VAR 0114(0049)]",
  "\u5F88\u597D\u73A9\uFF01",
  "\u5F88\u7C21\u55AE\uFF01",
  "\u54C7\uFF0C\u592A\u597D\u4E86\uFF01\\n\u9023\u6211\u4E5F\u8DDF\u8457\u9AD8\u8208\u8D77\u4F86\u4E86\u3002[VAR 0114(0049)]",
  "\u770B\u4F86\u5B78\u9662\u6559\u7684\u662F\\n\u66F4\u9AD8\u96E3\u5EA6\u7684\u8AB2\u7A0B\u5440\u2026\u2026\uFF01[VAR 0114(0049)]",
  "\u554A\uFF01\\n\u6211\u5F97\u8981\u53BB\u793E\u8FA6\u9732\u500B\u81C9\u7684\uFF01[VAR 0114(0049)]",
  "\u5B78\u5712\u7684\u4ECB\u7D39\u5C31\u8981\u5230\u6B64\u7D50\u675F\u4E86\uFF0C\\n\u4F46\u6700\u5F8C\u9019\u4EF6\u4E8B\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u5B9A\u8981\u807D\uFF01[VAR 0114(0049)]",
  "\u5728\u9019\u500B\u5B78\u5712\uFF0C\\n[VAR FF00(0006)]\u85CD\u8393\u5EB7\u6A02\u6D3B\u52D5[VAR FF00(0000)]\u76F8\u7576\u76DB\u884C\uFF0C\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u53EF\u4EE5\u7C21\u7A31\u5B83\u70BA[VAR FF00(0006)]\u85CD\u6A02\u6D3B[VAR FF00(0000)]\uFF01[VAR 0114(0049)]",
  "\u5728\u5DE8\u86CB\u88E1\u6D3B\u52D5\u6642\uFF0C\u6703\u6536\u5230\u4F86\u81EA\u5B78\u5712\u7684\u4EFB\u52D9\u3002\\n\u90A3\u4E9B\u4EFB\u52D9\u5C31\u662F\u6240\u8B02\u7684\u85CD\u6A02\u6D3B\u3002[VAR 0114(0049)]",
  "\u6BD4\u5982\u8AAA\uFF0C\u4F86\u5834\u81EA\u4E3B\u5C0D\u6230\u5427\uFF5E\\n\u6216\u662F\u6355\u6349\u7279\u5B9A\u7684\u5BF6\u53EF\u5922\u5427\uFF5E\\r\\n\u7E3D\u4E4B\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u6703\u6536\u5230\u5404\u5F0F\u5404\u6A23\u7684\u4EFB\u52D9\uFF01[VAR 0114(0049)]",
  "\u6703\u5728\u4F55\u6642\u3001\u4F55\u5730\u6536\u5230\u4EC0\u9EBC\u6A23\u7684\u4EFB\u52D9\uFF0C\\n\u4EFB\u8AB0\u90FD\u9810\u60F3\u4E0D\u5230\u3002[VAR 0114(0049)]",
  "\u6BCF\u6B21\u5B8C\u6210\u4EFB\u52D9\uFF0C\u5C31\u80FD\u7372\u5F97\\n\u5B78\u5712\u5C08\u7528\u7684\u8CA8\u5E63\uFF0C[VAR FF00(0006)]\uFF22\uFF30\uFF08\u85CD\u8393\u9EDE\u6578\uFF09[VAR FF00(0000)]\uFF01[VAR 0114(0049)]",
  "\uFF22\uFF30\u53EF\u4EE5\u5728[VAR FF00(0006)]\u98DF\u5802[VAR FF00(0000)]\u548C[VAR FF00(0006)]\u8CA9\u8CE3\u90E8[VAR FF00(0000)]\\n\u7576\u4F5C\u9322\u4F86\u4F7F\u7528\uFF01\\r\\n\u9084\u6709\u4EE5\u5F8C\u5728[VAR FF00(0006)]\u793E\u5718[VAR FF00(0000)]\u4E5F\u2026\u2026[VAR 0114(0049)]",
  "\u7E3D\u4E4B\u6211\u5927\u529B\u63A8\u85A6\u85CD\u6A02\u6D3B\uFF01\\n\u53C3\u52A0\u85CD\u6A02\u6D3B\uFF0C\u8A66\u8457\u53BB\u6536\u96C6\uFF22\uFF30\u5427\uFF01[VAR 0114(0049)]",
  "\u2026\u2026\u6211\u8981\u8AAA\u7684\u5C31\u662F\u9019\u4E9B\u4E86\uFF01\\n\u5306\u5306\u5FD9\u5FD9\u5730\u771F\u662F\u62B1\u6B49\u3002[VAR 0114(0049)]",
  "\u90A3\u9EBC\u6211\u5C31\u5148\u8D70\u4E86\uFF01\\n\u8ACB\u597D\u597D\u4EAB\u53D7\u5B78\u5712\u751F\u6D3B\u5594\uFF01[VAR 0114(0049)]",
  "\u82E5\u8981\u9032\u5165\\n\u5F8C\u7E8C\u7684\u5287\u60C5\uFF0C\\c\\n\u5FC5\u9808\u5B8C\u6210\u672C\u7BC7\u4E3B\u7DDA\u5287\u60C5\u53CA\\n\u300A\u96F6\u4E4B\u79D8\u5BF6\u300B\u300C\u524D\u7BC7\uFF1A\u78A7\u4E4B\u5047\u9762\u300D\u3002\\c\\n\u5B8C\u6210\u5728[VAR FF00(0006)]\u5E15\u5E95\u4E9E\u5730\u5340[VAR FF00(0000)]\u548C[VAR FF00(0006)]\u5317\u4E0A\u9109[VAR FF00(0000)]\\n\u5C1A\u672A\u7D50\u675F\u7684\u65C5\u7A0B\u5427\uFF01"
