[
  "\u5404\u4F4D\u540C\u5B78\u5E78\u6703\u4E86\uFF0C\\n\u6211\u662F\u6578\u5B78\u8001\u5E2B\uFF0C\u6CF0\u59C6\u3002[VAR 0114(0025)]",
  "\u8B93\u6211\u958B\u9580\u898B\u5C71\u554F\u500B\u554F\u984C\u3002\\n\u50CF\u662F\u6578\u5B57\u3001\u8A08\u7B97\u9019\u4E9B\u6771\u897F\uFF0C\\r\\n\u5927\u5BB6\u9084\u559C\u6B61\u55CE\uFF1F[VAR 0114(0025)]",
  "\u559C\u6B61\uFF5E\uFF01",
  "\u9084\u597D\u2026\u2026",
  "\u55EF\uFF5E",
  "\u54CE\u5440\uFF0C\u5475\u5475\u5475\uFF0C\\n\u8B1D\u8B1D\u5927\u5BB6\u7684\u56DE\u7B54\u3002[VAR 0114(0025)]",
  "\u6709\u4EBA\u559C\u6B61\uFF0C\u6709\u4EBA\u4E0D\u90A3\u9EBC\u62FF\u624B\uFF0C\\n\u73ED\u4E0A\u6709\u5404\u7A2E\u540C\u5B78\uFF0C\u9019\u5F88\u68D2\u5462\u3002[VAR 0114(0025)]",
  "\u4E0D\u904E\uFF0C\u4E0D\u7BA1\u4F60\u662F\u54EA\u7A2E\u4EBA\uFF0C\u90FD\u53EF\u4EE5\u653E\u5FC3\u5594\u3002\\c\\n\u548C\u8001\u5E2B\u4E00\u8D77\\n\u5FEB\u5FEB\u6A02\u6A02\u5B78\u6578\u5B78\u5427\uFF5E\uFF01[VAR 0114(0025)]",
  "\u5C0D\u4E86\uFF0C\u5927\u5BB6\u5C0D\u5BF6\u53EF\u5922\u7684\\n\u5C6C\u6027\u76F8\u524B\u95DC\u4FC2\u90FD\u638C\u63E1\u6E05\u695A\u4E86\u55CE\uFF1F[VAR 0114(0025)]",
  "\u8349\u524B\u6C34\uFF0C\u6C34\u524B\u706B\uFF0C\\n\u5C0D\u4E0D\u5C0D\uFF1F[VAR 0114(0025)]",
  "\u770B\u8D77\u4F86\u5C0D\u5BF6\u53EF\u5922\u5F88\u62FF\u624B\u7684[VAR 0100(0000)]\uFF0C\\n\u8001\u5E2B\u5E0C\u671B[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u544A\u8A34\u6211\u3002[VAR 0114(0025)]",
  "\u5C0D\u706B\u5C6C\u6027\u5BF6\u53EF\u5922\u4F7F\u7528\\n\u80FD\u5920\u524B\u706B\u7684\u6C34\u5C6C\u6027\u62DB\u5F0F\uFF0C\u6C34\u69CD\uFF0C\\r\\n\u7D66\u4E88\u5C0D\u624B\u7684\u50B7\u5BB3\u6703\u5982\u4F55\u5462\uFF1F[VAR 0114(0025)]",
  "\u8B8A\u4E00\u534A",
  "\u4E0D\u8B8A",
  "\u8B8A\uFF12\u500D",
  "\u54CE\u5440\uFF0C\u9019\u662F\u9006\u5411\u601D\u7DAD\u5462\uFF01\\n\u4F46\u5982\u679C\u662F\u8001\u5E2B\u6211\u88AB\u8A0E\u53AD\u7684\u6771\u897F\u7838\u5230\u4E86\uFF0C\\r\\n\u5927\u6982\u6703\u89BA\u5F97\u6709\u9EDE\u96E3\u53D7\u5594\uFF1F[VAR 0114(0025)]",
  "[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u5F88\u6703\u5FCD\u8010\u5462\u3002\\n\u4F46\u5982\u679C\u662F\u8001\u5E2B\u6211\u88AB\u8A0E\u53AD\u7684\u6771\u897F\u7838\u5230\u4E86\uFF0C\\r\\n\u5927\u6982\u6703\u89BA\u5F97\u6709\u9EDE\u96E3\u53D7\u5594\uFF1F[VAR 0114(0025)]",
  "\u6C92\u932F\uFF0C\u5F88\u597D\u5594\uFF01\\n\u4E0D\u6127\u662F[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01[VAR 0114(0025)]",
  "\u5982\u679C\u4F7F\u51FA\u7684\u62DB\u5F0F\u5C6C\u6027\u662F\u5C0D\u624B\u7684\u5F31\u9EDE\uFF0C\\n\u90A3\u5C31\u662F\u6548\u679C\u7D55\u4F73\uFF01\\r\\n\u7D66\u4E88\u7684\u50B7\u5BB3\u6703\u8B8A\uFF12\u500D\u3002[VAR 0114(0025)]",
  "\u53CD\u4E4B\uFF0C\u5982\u679C\u7528\u4E86\u5C0D\u624B\u64C5\u9577\u7684\u5C6C\u6027\uFF0C\\n\u90A3\u5C31\u662F\u6548\u679C\u4E0D\u597D\u2026\u2026\\r\\n\u7D66\u4E88\u7684\u50B7\u5BB3\u6703\u6E1B\u534A\u3002[VAR 0114(0025)]",
  "\u5475\u5475\u5475\uFF01\u96D6\u7136\u9019\u6A23\u50CF\u662F\u5728\u4E0A\u5C0D\u6230\u5B78\uFF0C\\n\u8B93\u6211\u6709\u9EDE\u5C0D\u4E0D\u8D77\u51F0\u6A97\u8001\u5E2B\uFF0C\\r\\n\u4F46\u5982\u679C\u62FF\u5BF6\u53EF\u5922\u5C0D\u6230\u7576\u4F8B\u5B50\u7684\u8A71\uFF0C[VAR 0114(0025)]",
  "\u5373\u4F7F\u662F\u4E0D\u90A3\u9EBC\u559C\u6B61\u7684\u6578\u5B78\\n\u4E5F\u53EF\u4EE5\u5FEB\u5FEB\u6A02\u6A02\u5927\u5BB6\u4E00\u8D77\u5B78\u5462\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C\u662F\u4E0B\u8AB2\u9418\uFF1F\\n\u9019\u9EBC\u5FEB\u5C31\u7D50\u675F\u4E86\u3002\u771F\u662F\u53EF\u60DC\u2026\u2026[VAR 0114(0025)]",
  "\u6211\u5F88\u671F\u5F85\u4E0B\u6B21\u4E5F\u80FD\u548C\u5927\u5BB6\\n\u4E00\u8D77\u5B78\u6578\u5B78\u5594\u3002[VAR 0114(0025)]"
]
