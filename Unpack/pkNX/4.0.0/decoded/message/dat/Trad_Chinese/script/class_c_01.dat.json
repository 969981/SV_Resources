[
  "\u2026\u2026\u54CE\u5440\uFF1F\\n\u770B\u4F86\u6709\u521D\u6B21\u898B\u9762\u7684\u5B78\u751F\u5462\u3002[VAR 0114(002C)]",
  "\u6211\u662F\u857E\u8377\uFF0C\\n\u5C07\u53E4\u8001\u7684\u5B78\u8853\u50B3\u6388\u7D66\u4F60\u5011\u7684\u4EBA\u3002[VAR 0114(0027)]",
  "\u6B77\u53F2\u5F88\u5999\u2026\u2026\u975E\u5E38\u7F8E\u5999\u2026\u2026\\n\u524D\u4EBA\u5011\u65E5\u7A4D\u6708\u7D2F\u7684\u6642\u9593\uFF0C\\r\\n\u7DBF\u5EF6\u5230\u6211\u5011\u6240\u751F\u6D3B\u7684\u73FE\u5728\u2026\u2026\uFF01[VAR 0114(0027)]",
  "\u4ECA\u5929\u4F60\u5011\u5C31\u4E56\u4E56\u5F9E\u6211\u9019\u88E1\u5B78\u7FD2\\n\u5E15\u5E95\u4E9E\u5730\u5340\u6700\u4E0D\u70BA\u4EBA\u77E5\u7684\u5834\u6240\uFF0C\\r\\n\u795E\u79D8\u5DE8\u5751\u7684\u4E8B\u5427\u3002[VAR 0114(0027)]",
  "\u6B63\u5982\u5404\u4F4D\u6240\u77E5\uFF0C\\n\u5E15\u5E95\u4E9E\u7684\u4E2D\u592E\u5B58\u5728\u8457\u5DE8\u5927\u7684\u7A7A\u6D1E\uFF0C\\r\\n\u300C\u5E15\u5E95\u4E9E\u5DE8\u5751\u300D\u3002[VAR 0114(0027)]",
  "\u5DE8\u5751\u4E2D\u7684\u5340\u57DF\u88AB\u7A31\u70BA\u300C\u7B2C\u96F6\u5340\u300D\uFF0C\\n\u900F\u904E\u7814\u7A76\u5206\u6790\u5176\u5730\u5C64\u8207\u6210\u5206\uFF0C\\r\\n\u76EE\u524D\u5DF2\u77E5\u90A3\u88E1\u5F9E\uFF11\uFF10\uFF10\u842C\u5E74\u4EE5\u524D\u5C31\u5B58\u5728\u4E86\u3002[VAR 0114(0027)]",
  "\u81EA\u53E4\u4EBA\u5011\u76F8\u4FE1\u5728\u90A3\u795E\u79D8\u7121\u6BD4\u7684\\n\u5DE8\u5751\u5E95\uFF0C\u6C89\u7761\u8457[VAR FF00(0006)]\u67D0\u7A2E\u6771\u897F[VAR FF00(0000)]\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u9EBC\uFF0C\u8ACB\u9019\u6642\u4E0D\u5E78\u8207\u6211\\n\u5C0D\u4E0A\u773C\u7684[VAR 0100(0000)]\u4F86\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u662F\u4EC0\u9EBC\u6771\u897F\u88AB\u4EBA\u5011\u8A8D\u70BA\\n\u6C89\u7761\u5728\u5E15\u5E95\u4E9E\u5DE8\u5751\u5167\u90E8\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u7B2C\u96F6\u5340\u7684\u6700\u6DF1\u8655\u5462\uFF1F[VAR 0114(0027)]",
  "\u8CA1\u5BF6",
  "\u5361\u6BD4\u7378",
  "\u5BF6\u53EF\u5922\u4E2D\u5FC3",
  "\u5475\uFF0C\u6B63\u78BA\u7B54\u6848\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u6709\u9EDE\u5C0F\u8070\u660E\u5462\u3002\\r\\n\u662F\u5728\u8AB2\u524D\u597D\u597D\u9810\u7FD2\u904E\u4E86\u662F\u5427\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u932F\u8AA4\uFF01\u96D6\u7136\u662F\u500B\u53EF\u611B\u7684\u7B54\u6848\uFF0C\\n\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u88AB\u6C89\u7761\u9019\u500B\u8A5E\u7D66\u8AA4\u5C0E\u4E86\u55CE\uFF1F\\r\\n\u6B63\u78BA\u7B54\u6848\u662F\u8CA1\u5BF6\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u932F\u8AA4\uFF01\u96D6\u7136\u662F\u500B\u633A\u6709\u610F\u601D\u7684\u7B54\u6848\uFF0C\\n\u4F46\u90A3\u8981\u662F\u771F\u7684\uFF0C\u53EF\u5C31\u662F\u500B\u6642\u7A7A\u932F\u4E82\u7684\u907A\u8DE1\u4E86\u3002\\r\\n\u6B63\u78BA\u7B54\u6848\u662F\u8CA1\u5BF6\u3002[VAR 0114(0027)]",
  "\u6C92\u932F\uFF01\u4EBA\u5011\u81EA\u53E4\u76F8\u4FE1\\n\u6C89\u7761\u5728\u5DE8\u5751\u6700\u6DF1\u8655\u7684\u662F\\r\\n\u50F9\u503C\u9AD8\u65BC\u4E16\u4E0A\u6240\u6709\u6771\u897F\u7684\u8CA1\u5BF6\uFF01[VAR 0114(0027)]",
  "\u4E0D\u904E\u73FE\u5728\u90A3\u88E1\u84CB\u4E86\u500B\u7814\u7A76\u6240\uFF0C\\n\u5DF2\u7D93\u6BEB\u7121\u6D6A\u6F2B\u53EF\u8A00\u4E86\u2026\u2026[VAR 0114(0027)]",
  "\u2026\u2026\u554A\uFF0C\u6211\u9084\u662F\u8AAA\u4E00\u8072\uFF0C\\n\u5E15\u5E95\u4E9E\u5DE8\u5751\u4EE5\u53CA\u7B2C\u96F6\u5340\\r\\n\u9664\u4E86\u76F8\u95DC\u4EBA\u54E1\u4E4B\u5916\u662F\u7981\u6B62\u9032\u5165\u7684\u3002[VAR 0114(0027)]",
  "\u5C0B\u5BF6\u56C9\uFF01\u55B2\u5475\uFF5E\uFF01\\c\\n\u2026\u2026\u4F60\u5011\u53EF\u5225\u7528\u9019\u7A2E\\n\u8352\u5510\u80E1\u9B27\u7684\u614B\u5EA6\u8E0F\u5165\u7981\u5340\u3002[VAR 0114(0027)]",
  "\u8981\u662F\u53EF\u4EE5\u7684\u8A71\uFF0C\u6211\u6BD4\u8AB0\u90FD\u66F4\u60F3\\n\u4E00\u6E9C\u7159\u885D\u53BB\u8ABF\u67E5\u554A\u2026\u2026\uFF01\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u54CE\u5440\uFF1F\u6211\u592A\u591A\u8A71\u4E86\uFF0C\\n\u6642\u9418\u5DF2\u7D93\u8D70\u904E\u982D\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u7684\u8AB2\u5C31\u5230\u6B64\u70BA\u6B62\u3002\\n\u6211\u5011\u4E0B\u6B21\u4E5F\u7E7C\u7E8C\u89E3\u958B\u6B77\u53F2\u4E4B\u8B0E\u5427\u3002[VAR 0114(0027)]"
]
