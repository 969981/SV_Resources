[
  "\u6B61\u8FCE\u4F86\u5230\u63A1\u6398\u4E4B\u93AE\u2015\u2015\u7A74\u624E\u93AE\u3002\\n\u9019\u88E1\u6709\u8A31\u591A\u52E4\u596E\u5DE5\u4F5C\u7684\u4EBA\u3002",
  "\u5728\u90FD\u6703\u89C0\u5149\u7576\u7136\u5F88\u597D\u73A9\uFF0C\\n\u4F46\u50CF\u9019\u6A23\u6A38\u5BE6\u7684\u57CE\u93AE\u4E5F\u662F\u5225\u6709\u98A8\u60C5\u554A\uFF5E",
  "\u6240\u8B02\u7684\u7A74\u624E\u5C31\u662F\u6316\u6D1E\u7684\u610F\u601D\u3002\\c\\n\u5982\u540C\u93AE\u540D\u4E00\u6A23\uFF0C\\n\u591A\u6578\u7684\u5C45\u6C11\u90FD\u4EE5\u63A1\u6398\u7DAD\u751F\u3002",
  "\u6905\u5B50\u7684\u53EF\u8CB4\u4E4B\u8655\u2026\u2026\uFF01\\n\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u9577\u5927\u4E86\u5C31\u6703\u660E\u767D\u7684\u3002",
  "\u6211\u5728\u63A1\u6398\u5834\u770B\u5230\u4E86\\n\u5927\u5F97\u50CF\u5EA7\u5C71\u7684\u5BF6\u53EF\u5922\u5594\uFF01",
  "\u6211\u4E5F\u770B\u5230\u4E86\u50CF\u689D\u6CB3\u5DDD\u4E00\u6A23\\n\u9577\u9577\u7684\u5BF6\u53EF\u5922\uFF01",
  "\u5C0F\u5C0F\u8C61\u662F\u5730\u9762\u5C6C\u6027\uFF01\\n\u96FB\u5C6C\u6027\u62FF\u7260\u6C92\u8F4D\uFF0C\u6BD2\u5C6C\u6027\u4E5F\u4E0D\u662F\u7260\u7684\u5C0D\u624B\uFF01\\r\\n\u2026\u2026\u4F46\u4E0D\u8981\u5C0D\u7260\u6F51\u6C34\u5594\u3002",
  "\u4E0B\u73ED\u56DE\u5BB6\u7684\u8DEF\u4E0A\uFF0C\\n\u6211\u6703\u548C\u5925\u4F34\u5728\u90A3\u500B\u5C0D\u6230\u5834\u6253\u5BF6\u53EF\u5922\u5C0D\u6230\u3002",
  "\u56E0\u70BA\u6709\u5927\u70AD\u8ECA\u5728\uFF0C\\n\u6211\u624D\u80FD\u52AA\u529B\u5DE5\u4F5C\u3002\\c\\n\u2026\u2026\u7260\u4E0D\u53EA\u5728\u8CBB\u529B\u7684\u5DE5\u4F5C\u4E0A\u5E6B\u6211\uFF0C\\n\u540C\u6642\u7260\u4E5F\u662F\u6211\u7684\u7CBE\u795E\u652F\u67F1\u3002",
  "\u6211\u5728\u93AE\u5916\u5FEB\u8981\u5012\u4E0B\u7684\u6642\u5019\uFF0C\\n\u662F\u4E00\u4F4D\u91CE\u751F\u7684\u5BF6\u53EF\u5922\u4E2D\u5FC3\\r\\n\u5927\u59D0\u59D0\u6551\u4E86\u6211\u3002",
  "\u6012\u9E1A\u54E5\u5E6B\u5FD9\u8F09\u9001\u7684\u7A7A\u4E2D\u4E4B\u65C5\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E73\u6642\u6709\u5728\u4F7F\u7528\u98DB\u7FD4\u8A08\u7A0B\u8ECA\u55CE\uFF1F\\c\\n\u53EA\u8981[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F9E\u5730\u5716App\u53EB\u8ECA\uFF0C\\n\u4E0D\u8AD6\u54EA\u88E1\u6211\u5011\u90FD\u6703\u98DB\u5954\u524D\u5F80\u3002"
]
