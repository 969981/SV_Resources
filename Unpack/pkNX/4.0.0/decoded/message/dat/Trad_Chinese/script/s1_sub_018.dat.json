[
  "\u6211\u5011\u5440\uFF0C\\n\u662F\u4E00\u5C0D\u6700\u6069\u611B\u7684\u60C5\u4FB6\u5C0D\u5427\uFF5E\uFF1F",
  "\u662F\u554A\uFF01\u50CF\u6211\u5011\u9019\u6A23\\n\u7121\u8AD6\u4F55\u6642\u90FD\u5728\u4E00\u8D77\u7684\u60C5\u4FB6\uFF0C\\r\\n\u5C31\u7B97\u5728\u5BF6\u53EF\u5922\u754C\u4E5F\u4E0D\u5B58\u5728\u5427\uFF01",
  "\u5C31\u662F\u8AAA\u5440\uFF01",
  "\u2026\u2026\u90A3\u908A\u90A3\u4F4D\uFF01",
  "\u8981\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u627E\u5230\u4E86\\n\u50CF\u6211\u5011\u9019\u6A23\u6069\u611B\u7684\u5BF6\u53EF\u5922\uFF01\\r\\n\u5C31\u5E36\u4F86\u7D66\u6211\u5011\u770B\u770B\u5427\uFF01",
  "\u6211\u731C\u662F\u627E\u4E0D\u5230\u5566\uFF01\\n\u554A\u54C8\u54C8\uFF5E\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u627E\u5230\u4E86\u7121\u8AD6\u4F55\u6642\u90FD\u5728\u4E00\u8D77\u7684\\n\u6069\u611B\u5BF6\u53EF\u5922\u4E86\u55CE\uFF1F",
  "\u4E0D\u53EF\u80FD\u627E\u5F97\u5230\u5427\uFF01\\n\u554A\u54C8\u54C8\uFF5E\uFF01",
  "\u9019\u5BF6\u53EF\u5922\u2026\u2026\\n\u770B\u8D77\u4F86\u4E0D\u50CF\u662F\u5F88\u6069\u611B\u7684\u6A23\u5B50\u5427\uFF01\\r\\n\u554A\u54C8\u54C8\uFF5E\uFF01",
  "\u4EC0\u3001\u4EC0\u9EBC\uFF1F\u4E00\u5C0D\u9F20\uFF01\uFF1F\\c\\n\u7121\u8AD6\u4F55\u6642\u90FD\u5728\u4E00\u8D77\u7684\u89AA\u5BC6\u4F34\u4FB6\uFF0C\\n\u5169\u96BB\u4E00\u7D44\u800C\u4E14\u9084\u5F88\u6069\u611B\uFF01\uFF1F",
  "\u4EC0\u3001\u4EC0\u9EBC\uFF1F\u4E00\u5BB6\u9F20\uFF01\uFF1F\\c\\n\u56E0\u70BA\u592A\u904E\u6069\u611B\uFF0C\\n\u9023\u5BF6\u8C9D\u5B69\u5B50\u90FD\u751F\u51FA\u4F86\u4E86\uFF01\uFF1F",
  "\u4EC0\u3001\u4EC0\u9EBC\uFF1F\u4E00\u5BB6\u9F20\uFF01\uFF1F\\c\\n\u6069\u611B\u5230\u751F\u4E86\uFF12\u500B\u5B69\u5B50\uFF01\uFF1F\\n\u611F\u60C5\u597D\u5230\u90FD\u4E00\u5BB6\u5718\u5713\u4E86\uFF01\uFF1F",
  "\u6C92\u60F3\u5230\u2026\u2026\u5BF6\u53EF\u5922\u754C\u4E5F\u6709\\n\u50CF\u6211\u5011\u9019\u9EBC\u6069\u611B\u7684\u60C5\u4FB6\u5462\uFF01",
  "\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E36\u4F86\u7D66\u6211\u5011\u770B\u3002\\n\u4F5C\u70BA\u8B1D\u79AE\uFF0C\u6211\u4F86\u6559[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u500B\u52D5\u4F5C\u3002",
  "[VAR 0100(0000)]\u5F9E\u60C5\u4FB6\u90A3\u88E1\\n\u5B78\u6703\u4E86[VAR FF00(0008)]\u611B\u5FC3\uFF08\u53F3\uFF09\u8868\u60C5[VAR FF00(0000)]\u548C\\r\\n[VAR FF00(0008)]\u611B\u5FC3\uFF08\u5DE6\uFF09\u8868\u60C5[VAR FF00(0000)]\uFF01",
  "\u76F8\u89AA\u76F8\u611B\u7684\u52D5\u4F5C\u2026\u2026\\n\u627E\u500B\u4EBA\u4E00\u8D77\u8A66\u8A66\u770B\u5427\u3002",
  "\u4E0D\u7BA1\u662F\u4EBA\u985E\u9084\u662F\u5BF6\u53EF\u5922\\n\u90FD\u662F\u611B\u60C5\u6EFF\u6EFF\u5462\u3002"
]
