[
  "\u4ECA\u5929\u4E5F\u8981\u6D3B\u529B\u6EFF\u5206\u5B78\u5C0D\u6230\u5B78\uFF01\\n\u563F\u5440\uFF01\u958B\u59CB\u56C9\uFF01[VAR 0114(0024)]",
  "\u5404\u4F4D\u5728\u671F\u4E2D\u8003\u90FD\u6253\u4E86\u4E00\u5834\\n\u6F02\u4EAE\u7684\u5C0D\u6230\u5594\uFF01\u563F\u5440\uFF01[VAR 0114(0024)]",
  "\u5F9E\u4ECA\u5929\u8D77\u5C31\u662F\u9019\u9580\u8AB2\u7684\u5F8C\u534A\u6BB5\u4E86\uFF01\\n\u8B93\u6211\u5011\u62FF\u51FA\u5E79\u52C1\u8A8D\u771F\u5B78\u7FD2\u5427\uFF01[VAR 0114(0024)]",
  "\u5404\u4F4D\u6709\u5728\u4F7F\u7528\u300C\uFF32\u9375Let\u0027s Go\u300D\u55CE\uFF01\uFF1F[VAR 0114(0024)]",
  "\u9019\u80FD\u8B93\u5BF6\u53EF\u5922\\n\u5F80\u524D\u65B9Let\u0027s Go\uFF01[VAR 0114(0024)]",
  "\u8B93\u7260\u5E6B\u5FD9\u64BF\u8D77\u6389\u5728\u9060\u8655\u7684\u9053\u5177\uFF01\\n\u662F\u500B\u975E\u5E38\u65B9\u4FBF\u7684\u53E3\u8A23\uFF01[VAR 0114(0024)]",
  "\u8981\u662FLet\u0027s Go\u524D\u5F80\u7684\u5730\u65B9\\n\u6709\u91CE\u751F\u5BF6\u53EF\u5922\u7684\u8A71\uFF0C\\r\\n\u6D3E\u53BB\u7684\u5BF6\u53EF\u5922\u5C31\u6703\u76F4\u63A5\u5C55\u958B\u6230\u9B25\uFF01[VAR 0114(0024)]",
  "\u800C\u6211\u5011\u7A31\u9019\u6A23\u7684\u5C0D\u6230\u70BA\\n\u81EA\u4E3B\u5C0D\u6230\uFF01\uFF01[VAR 0114(0024)]",
  "\u6B63\u5982\u5176\u540D\uFF0C\\n\u8A13\u7DF4\u5BB6\u4E0D\u7528\u6307\u63EE\u5BF6\u53EF\u5922\uFF0C\\r\\n\u800C\u662F\u8B93\u5BF6\u53EF\u5922\u81EA\u5DF1\u53BB\u5C0D\u6230\uFF01[VAR 0114(0024)]",
  "\u5982\u679C\u6253\u8D0F\u4E86\uFF0C\u5BF6\u53EF\u5922\u5C31\u80FD\\n\u50CF\u5E73\u6642\u90A3\u6A23\u7372\u5F97\u7D93\u9A57\u503C\uFF01[VAR 0114(0024)]",
  "\u719F\u7DF4\u904B\u7528\u81EA\u4E3B\u5C0D\u6230\u7684\u8A71\uFF0C\\n\u5C31\u80FD\u6709\u6548\u7387\u5730\u935B\u934A\u540C\u884C\u5BF6\u53EF\u5922\uFF01[VAR 0114(0024)]",
  "\u4F46\u662F\u5BF6\u53EF\u5922\u5373\u4F7F\u5728\u81EA\u4E3B\u5C0D\u6230\u6642\\n\u7B49\u7D1A\u63D0\u5347\u4E86\uFF0C\u7260\u4E5F\u4E0D\u6703\u5B78\u6703\u65B0\u62DB\u5F0F\uFF0C\\r\\n\u4E5F\u4E0D\u6703\u9032\u5316\u3002\u9019\u9EDE\u8981\u6CE8\u610F\uFF01[VAR 0114(0024)]",
  "\u6B64\u5916\uFF0C\u5BF6\u53EF\u5922\u8981\u662F\u5728\u81EA\u4E3B\u5C0D\u6230\u6642\u6253\u8F38\u4E86\uFF0C\\n\u7260\u5C31\u6703\u7528\u50C5\u5269\u7684\u9AD4\u529B\u56DE\u5230\u8A13\u7DF4\u5BB6\u8EAB\u65C1\u3002\\r\\n\u9019\u6642\u5343\u842C\u8981\u8FC5\u901F\u5E6B\u7260\u56DE\u5FA9\u9AD4\u529B\uFF01[VAR 0114(0024)]",
  "\u6211\u5927\u81F4\u90FD\u8AAA\u5B8C\u4E86\u3002\\n\u5230\u6B64\u70BA\u6B62\uFF0C\u6709\u4EC0\u9EBC\u554F\u984C\u55CE\uFF1F[VAR 0114(0024)]",
  "\u600E\u9EBC\u4E2D\u65B7\u81EA\u4E3B\u5C0D\u6230\uFF1F",
  "\u53EF\u4EE5\u6355\u6349\u5BF6\u53EF\u5922\u55CE\uFF1F",
  "\u6C92\u4EC0\u9EBC\u554F\u984C",
  "\u4E00\u65E6\u958B\u59CB\u81EA\u4E3B\u5C0D\u6230\u5F8C\uFF0C\\n\u5728\u5206\u51FA\u52DD\u8CA0\u4E4B\u524D\u662F\u7121\u6CD5\u4E2D\u65B7\u7684\uFF01\\c\\n\u4F46\u5982\u679C\u662F\u5728\u81EA\u4E3B\u5C0D\u6230\u958B\u59CB\u4E4B\u524D\uFF0C\\n\u5BF6\u53EF\u5922\u9084\u5728\u79FB\u52D5\u7684\u671F\u9593\uFF0C\\r\\n\u5C31\u80FD\u7528\u300C\uFF3A\uFF32\u9375\u6295\u7403\uFF01\u300D\u4E2D\u65B7\u81EA\u4E3B\u5C0D\u6230\u5594\uFF01[VAR 0114(0024)]",
  "\u81EA\u4E3B\u5C0D\u6230\u6642\u5982\u679C\u4E0D\u53BB\u7406\u6703\u7260\uFF0C\\n\u5BF6\u53EF\u5922\u5C31\u6703\u5C07\u5C0D\u65B9\u6253\u5012\uFF01\\c\\n\u5982\u679C\u60F3\u6355\u6349\u5C0D\u624B\u7684\u8A71\uFF0C\\n\u662F\u5FC5\u9808\u81EA\u5DF1\u6307\u63EE\u5BF6\u53EF\u5922\u53BB\u6230\u9B25\u7684\uFF01[VAR 0114(0024)]",
  "\u55EF\uFF01\u5404\u4F4D\u540C\u5B78\u90FD\u5F88\u512A\u79C0\u5462\uFF01\\n\u8B93\u6211\u975E\u5E38\u671F\u5F85\u4F60\u5011\u7684\u672A\u4F86\uFF01[VAR 0114(0024)]",
  "\u5373\u4F7F\u662F\u5728\u81EA\u4E3B\u5C0D\u6230\u6642\uFF0C\\n\u5BF6\u53EF\u5922\u4E5F\u662F\u6703\u4F7F\u76E1\u5168\u529B\\r\\n\u70BA\u81EA\u5DF1\u7684\u8A13\u7DF4\u5BB6\u6230\u9B25\uFF01[VAR 0114(0024)]",
  "\u8A18\u5F97\u8981\u9069\u6642\u5730\u770B\u4E00\u4E0B\u7260\u7684\u72C0\u6CC1\uFF0C\\n\u8981\u662F\u7260\u5FEB\u8981\u8F38\u6389\u7684\u8A71\uFF0C\\r\\n\u5C31\u8D95\u7DCA\u4E0B\u4EE4\u64A4\u9000\u5427\uFF01[VAR 0114(0024)]",
  "\u96D6\u7136\u4E0D\u7528\u6211\u591A\u8AAA\uFF0C\u4F46\u5BF6\u53EF\u5922\\n\u5728\uFF28\uFF30\u5269\u4E0B\u8F03\u5C11\u6642\u662F\u5F88\u75B2\u618A\u7684\uFF01[VAR 0114(0024)]",
  "\u9019\u6642\u7260\u6703\u6392\u65A5\u81EA\u4E3B\u5C0D\u6230\uFF0C\\n\u5404\u4F4D\u53EF\u4E0D\u8981\u592A\u52C9\u5F37\u7260\u554A\uFF01[VAR 0114(0024)]",
  "\u7D50\u8AD6\uFF01\uFF01[VAR 0114(0024)]",
  "\u81EA\u4E3B\u5C0D\u6230\u662F\u5EFA\u7ACB\u5728\\n\u5C0D\u5F7C\u6B64\u7684\u4FE1\u8CF4\u95DC\u4FC2\u4E0A\uFF01[VAR 0114(0024)]",
  "\u8981\u597D\u597D\u6D3B\u7528\uFF0C\\n\u5225\u8B93\u81EA\u5DF1\u7684\u5BF6\u53EF\u5922\u5931\u671B\u4E86\uFF01[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u539F\u672C\u6253\u7B97\u8B93\u5404\u4F4D\u89AA\u8EAB\u9AD4\u9A57\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u6642\u9593\u5DF2\u7D93\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u90A3\u9EBC\uFF0C\u5C31\u6B64\u89E3\u6563\uFF01\\n\u795D\u5404\u4F4D\u4ECA\u5929\u4E5F\u6D3B\u529B\u6EFF\u5206\uFF01[VAR 0114(0024)]"
]
