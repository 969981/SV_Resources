  "\uFF2C\uFF30\u53EF\u4EE5\u5728\u62DB\u5F0F\u5B78\u7FD2\u5668\u6A5F\\n\u7528\u5BF6\u53EF\u5922\u7684\u6389\u843D\u7269\u514C\u63DB\u5230\u5594\uFF01[VAR 0114(0024)]",
