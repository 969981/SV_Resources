[
  "\u5C0F\u751F\u662F\u516B\u6714\uFF0C\u8ACB\u591A\u6307\u6559\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u54CE\u5440\u54CE\u5440\uFF0C\\n\u4E0A\u6B21\u771F\u662F\u4E0D\u597D\u610F\u601D\u3002[VAR 0114(0012)]",
  "\u5C0F\u751F\u611F\u52D5\u5F97\u568E\u5555\u5927\u54ED\uFF0C\\n\u771F\u662F\u8B93\u5404\u4F4D\u540C\u5B78\u898B\u7B11\u4E86\u3002[VAR 0114(0012)]",
  "\u90A3\u4E4B\u5F8C\u5C0F\u751F\u53EF\u662F\u88AB\u6CF0\u59C6\u8001\u5E2B\\n\u72E0\u72E0\u5730\u7F75\u4E86\u4E00\u9813\u5462\u2026\u2026[VAR 0114(0012)]",
  "\u4F86\uFF0C\u8B93\u6211\u5011\u91CD\u65B0\u6253\u8D77\u7CBE\u795E\uFF0C\\n\u9032\u5165\u4ECA\u5929\u7684\u8AB2\u7A0B\u5427\u3002[VAR 0114(0012)]",
  "\u5404\u4F4D\u540C\u5B78\u662F\u5426\u807D\u904E\\n\u5E15\u5E95\u4E9E\u5341\u666F\u5462\uFF1F[VAR 0114(0012)]",
  "\u6B63\u5982\u5176\u540D\uFF0C\u662F\u5E15\u5E95\u4E9E\u5730\u5340\\n\u88AB\u6311\u9078\u51FA\u4F86\u7684\uFF11\uFF10\u8655\u7F8E\u9E97\u666F\u9EDE\u3002[VAR 0114(0012)]",
  "\u5176\u4E2D\u53EF\u4EE5\u8F15\u9B06\u9020\u8A2A\u7684\\n\u5C31\u5C6C[VAR FF00(0006)]\u6A44\u6B16\u5927\u8FB2\u5712[VAR FF00(0000)]\u5427\u3002[VAR 0114(0012)]",
  "\u5728\u524D\u5F80\u5713\u6A21\u93AE\u8DEF\u4E0A\u7684\u4E18\u9675\u5730\\n\u53EF\u4EE5\u671B\u898B\u7684\u907C\u95CA\u6A44\u6B16\u5712\uFF0C\\r\\n\u5C31\u662F\u6A44\u6B16\u5927\u8FB2\u5712\u4E86\u3002[VAR 0114(0012)]",
  "\u88AB\u9078\u4E0A\u7684\u7011\u5E03\u6709\uFF12\u8655\u3002\\n\u4E5F\u5C31\u662F[VAR FF00(0006)]\u4E82\u64CA\u7011\u5E03[VAR FF00(0000)]\uFF0C\\r\\n\u4EE5\u53CA[VAR FF00(0006)]\u5927\u934B\u5927\u7011\u5E03[VAR FF00(0000)]\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u5728\u9019\u500B\u5730\u5340\u6D77\u62D4\u6700\u9AD8\u7684\\n\u971C\u62B9\u5C71\u5C71\u9802\u662F[VAR FF00(0006)]\u5E15\u5E95\u4E9E\u6700\u9AD8\u5CF0[VAR FF00(0000)]\u3002[VAR 0114(0012)]",
  "\u540C\u6A23\u5728\u971C\u62B9\u5C71\u9084\u6709\u8655\u61F8\u5D16\\n\u662F\u53D6\u540D\u81EA\u61F8\u5D16\u7684\u5F62\u72C0\u3002[VAR 0114(0012)]",
  "\u90A3\u9EBC\uFF0C\u73FE\u5728\u5C31\u4F86\u554F\u554F\u5404\u4F4D\u540C\u5B78\u5427\uFF01[VAR 0114(0012)]",
  "\u9019\u984C\u7684\u7B54\u6848\u662F\u8EAB\u9AD4\u7684\u67D0\u500B\u90E8\u4F4D\u3002\\n\u8ACB\u554F\u4F4D\u65BC\u971C\u62B9\u5C71\u7684\u4E09\u5C94\u61F8\u5D16\uFF0C\\r\\n\u9019\u500B\u666F\u9EDE\u7684\u540D\u5B57\u662F\u971C\u62B9\u4E4B\u2026\u2026\uFF1F[VAR 0114(0012)]",
  "\u624B",
  "\u8033\u6735",
  "\u5C3E\u5DF4",
  "[VAR 0100(0000)]\u540C\u5B78\uFF01\\n\u771F\u662F\u512A\u79C0\u7684\u60F3\u50CF\u529B\uFF01[VAR 0114(0012)]",
  "\u4E09\u5C94\u7684\u8033\u6735\u2026\u2026\\n\u5982\u679C\u662F\u95DC\u65BC\u5BF6\u53EF\u5922\u7684\u5409\u5229\u86CB\uFF0C\\r\\n\u8AAA\u4E0D\u5B9A\u5C31\u7B54\u5C0D\u4E86\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u4E09\u5C94\u7684\u5C3E\u5DF4\u2026\u2026\\n\u5982\u679C\u662F\u95DC\u65BC\u5BF6\u53EF\u5922\u7684\u80AF\u6CF0\u7F85\uFF0C\\r\\n\u8AAA\u4E0D\u5B9A\u5C31\u7B54\u5C0D\u4E86\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u971C\u62B9\u5C71\u6709\u8655\u88AB\u7A31\u70BA[VAR FF00(0006)]\u971C\u62B9\u4E4B\u624B[VAR FF00(0000)]\u7684\\n\u4E09\u5C94\u61F8\u5D16\u3002[VAR 0114(0012)]",
  "\u4F46\u8AAA\u90A3\u624B\u6307\u7684\u5F62\u72C0\u5BE6\u5728\u662F\\n\u592A\u7C97\u53C8\u592A\u77ED\uFF0C\u9019\u666F\u9EDE\u6BD4\u55BB\u7684\\r\\n\u5927\u6982\u662F\u67D0\u7A2E\u5BF6\u53EF\u5922\u7684\u624B\u5427\u3002[VAR 0114(0012)]",
  "\u6B64\u5916\uFF0C\u5F9E\u6771\u7B2C\uFF13\u5340\u7684\u9AD8\u5C71\u5730\u5E36\\n\u53EF\u4EE5\u5C07\u91C0\u5149\u5E02\u7684\u591C\u666F\u76E1\u6536\u773C\u5E95\u3002[VAR 0114(0012)]",
  "\u5F9E\u90A3\u88E1\u770B\u898B\u7684\u666F\u8272\u88AB\u7A31\u70BA\\n[VAR FF00(0006)]\u767E\u842C\u4F0F\u7279\u591C\u666F[VAR FF00(0000)]\u5462\u3002[VAR 0114(0012)]",
  "\u64DA\u8AAA\u90A3\u88E1\u662F\u71B1\u6200\u60C5\u4FB6\u7684\\n\u8D85\u4EBA\u6C23\u666F\u9EDE\u3002[VAR 0114(0012)]",
  "\u5957\u53E5\u5E74\u8F15\u4EBA\u7684\u8A71\u5C31\u662F\\n\u80FD\u62CD\u51FA\u7DB2\u7F8E\u7167\u2026\u2026\u5427\u3002[VAR 0114(0012)]",
  "\u2026\u2026\u96D6\u7136\u865F\u7A31\u662F\u5341\u5927\u666F\u9EDE\uFF0C\\n\u4F46\u4E16\u754C\u4E0A\u5B58\u5728\u8457\u8A31\u591A\u8B93\u4EBA\u5728\u5BE6\u969B\u9020\u8A2A\u5F8C\\r\\n\u537B\u611F\u5230\u5F88\u5931\u671B\u7684\u89C0\u5149\u666F\u9EDE\u3002[VAR 0114(0012)]",
  "\u5C0F\u751F\u4E0D\u662F\u8981\u963B\u6B62\u5404\u4F4D\u524D\u5F80\uFF0C\\n\u53EA\u662F\u5E0C\u671B\u540C\u5B78\u5011\u4E0D\u8981\u62B1\u8457\u904E\u5927\u7684\u671F\u5F85\u3002[VAR 0114(0012)]",
  "\u91CD\u8981\u7684\u662F\u89AA\u81EA\u524D\u5F80\u7576\u5730\uFF0C\\n\u89AA\u773C\u78BA\u8A8D\u4E8B\u5BE6\u3002[VAR 0114(0012)]",
  "\u9AD4\u9A57\u4E00\u4E0B\u5931\u671B\u53C8\u6709\u4EC0\u9EBC\u95DC\u4FC2\u3002\\n\u2026\u2026\u656C\u8ACB\u8B93\u81EA\u5DF1\u88AB\u9A19\u4E00\u9A19\u5427\u3002[VAR 0114(0012)]",
  "\u4ECA\u5929\u7684\u8AB2\u5C31\u5230\u6B64\u7D50\u675F\uFF01\\n\u611F\u8B1D\u5404\u4F4D\uFF01[VAR 0114(0012)]"
]
