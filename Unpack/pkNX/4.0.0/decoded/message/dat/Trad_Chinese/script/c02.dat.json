[
  "\u591A\u8667\u6709\u6469\u6258\u8725\uFF0C\\n\u6211\u5011\u624D\u80FD\u8D8A\u904E\u70D8\u70D8\u6C99\u6F20\u554A\uFF01",
  "\u5F97\u7528\u5BF6\u53EF\u5922\u6D17\u6FA1\u6FA1\\n\u597D\u597D\u5E6B\u7260\u628A\u6C99\u5B50\u6E05\u4E7E\u6DE8\u624D\u662F\u5462\u3002",
  "\u6211\u5E0C\u671B\u7260\u4E00\u76F4\u90FD\u662F\u746A\u529B\u9732\uFF0C\\n\u6240\u4EE5\u7576\u7260\u5FEB\u8981\u9032\u5316\u6642\u2026\u2026\\c\\n\u6211\u5C31\u6703\u7528\u300C\uFF22\u9375\u53D6\u6D88\u9032\u5316\uFF01\u300D\\n\u9019\u500B\u5E78\u904B\u5492\u8A9E\u5594\u3002",
  "\u73BB\u74F6\u5E02\u7684\u5C0D\u6230\u5834\\n\u8207\u6CB3\u5DDD\u662F\u76F8\u9023\u7684\u5462\uFF01",
  "\u60F3\u5230\u4E0A\u9762\u53BB\u7684\u8A71\uFF0C\\n\u5C31\u5728\u5347\u964D\u6A5F\u524D\u9762\u7B49\u8457\u5427\u3002",
  "\u518D\u5F80\u524D\u53BB\u6CB3\u6C34\u5C31\u8981\u8B8A\u6DF1\u56C9\uFF01\\n\u8981\u662F\u6703\u7528\u885D\u6D6A\u7684\u8A71\uFF0C\u5C31\u53EF\u4EE5\u653E\u5FC3\u4E86\u3002",
  "\u6F2C\u6C81\u93AE\u4F4D\u65BC\u6C99\u6F20\u7684\u53E6\u4E00\u7AEF\uFF01\\n\u5982\u679C\u6253\u7B97\u53BB\u90A3\u88E1\u7684\u8A71\uFF0C\u5343\u842C\u8981\u597D\u597D\u6E96\u5099\u3002",
  "\u6709\u7A2E\u5E36\u8457\u786C\u5E63\u7684\u5C0F\u5BF6\u53EF\u5922\uFF01\\n\u6211\u4E00\u9760\u8FD1\u4E4B\u5F8C\uFF0C\u7260\u5C31\u6389\u4E0B\u786C\u5E63\\r\\n\u7136\u5F8C\u6D88\u5931\u4E0D\u898B\u4E86\uFF01\u90A3\u662F\u4EC0\u9EBC\u554A\uFF01\uFF1F",
  "\u8981\u4E0D\u8981\u5E6B\u5728\u5BB6\u88E1\u7B49\u8457\u7684\u5BF6\u53EF\u5922\\n\u8CB7\u4E9B\u4EC0\u9EBC\u56DE\u53BB\u5462\uFF5E\uFF1F",
  "\u6211\u559C\u6B61\u7684\u98DF\u7269\\n\u548C\u5BF6\u53EF\u5922\u559C\u6B61\u7684\u98DF\u7269\uFF0C\\r\\n\u70BA\u4EC0\u9EBC\u6709\u9EDE\u4E0D\u4E00\u6A23\u5462\uFF5E\uFF1F",
  "\u9019\u5EA7\u57CE\u5E02\u7684\u7246\u58C1\u5C31\u50CF\u662F\u7011\u5E03\u8036\uFF01\\n\u7528\u4F86\u7DF4\u7FD2\u6500\u7011\u662F\u518D\u9069\u5408\u4E0D\u904E\u4E86\uFF01",
  "\u6211\u662F\u5F9E\u7A74\u624E\u93AE\u4F86\u7684\uFF0C\\n\u6240\u4EE5\u9019\u88E1\u7684\u6C34\u91CF\u771F\u662F\u8B93\u6211\u5687\u4E86\u4E00\u5927\u8DF3\uFF01\\r\\n\u7562\u7ADF\u5728\u90A3\u908A\uFF0C\u6C34\u662F\u5F88\u73CD\u8CB4\u7684\u554A\u3002",
  "\u746A\u529B\u9732\u662F\u6C34\u5C6C\u6027\uFF01\\n\u6240\u4EE5\u7260\u679C\u7136\u662F\u5F88\u559C\u6B61\u6C34\u5594\uFF01",
  "\u50B7\u8166\u7B4B\u4E0D\u77E5\u9053\u8A72\u5403\u4EC0\u9EBC\u6642\uFF0C\\n\u4E0D\u77E5\u4E0D\u89BA\u5C31\u6703\u5230\u4F86\u4F86\u4F86\u8ED2\u9019\u5152\u5462\u3002",
  "\u9019\u88E1\u662F\u8B93\u5750\u9A0E\u5BF6\u53EF\u5922\\n\u7A0D\u5FAE\u4F11\u606F\u7684\u5730\u65B9\u3002\\c\\n\u9A0E\u8457\u7260\u5011\u6771\u5954\u897F\u8DD1\u4E4B\u5F8C\uFF0C\\n\u4E5F\u8981\u597D\u597D\u8868\u9054\u611F\u8B1D\u4E4B\u610F\u624D\u662F\u3002",
  "\u73BB\u74F6\u5E02\u662F\u500B\u6C34\u9109\u6FA4\u570B\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\u4E86\u5C31\u77E5\u9053\u56C9\uFF5E\uFF01",
  "\u9019\u5EA7\u57CE\u5E02\u88E1\u7684\u9910\u5EF3\\n\u8A55\u50F9\u5F88\u9AD8\u5462\uFF01\\c\\n\u56E0\u70BA\u7528\u7684\u5E7E\u4E4E\u90FD\u662F\u6F2C\u6C81\u93AE\u7522\u7684\\n\u65B0\u9BAE\u7D20\u6750\u554A\uFF01",
  "\u6211\u8981\u8D81\u8457\u5E74\u8F15\u5230\u8655\u53BB\u65C5\u884C\uFF0C\\n\u62CD\u5F88\uFF5E\u591A\u7167\u7247\u3002\\c\\n\u7136\u5F8C\u7B49\u6211\u8B8A\u6210\u8001\u5976\u5976\u6642\uFF0C\\n\u6211\u8981\u770B\u8457\u90A3\u4E9B\u7167\u7247\u56DE\u60F3\u9019\u4E00\u5207\u3002",
  "\u9019\u5730\u65B9\u6709\u540D\u7684\u5E97\u662F\\n\u6D77\u5CB1\u4FF1\u6A02\u90E8\u554A\uFF5E",
  "\u6211\u60F3\u53BB\u4E0A\u9762\u90A3\u5BB6\u4E09\u660E\u6CBB\u5E97\u5566\uFF5E",
  "\u6211\u5BE6\u5728\u5F88\u4E0D\u6703\u770B\u5730\u5716\u3002\\n\u2026\u2026\u5317\u908A\u662F\u54EA\u908A\u5440\uFF1F",
  "\u5730\u5716App\u4E0A\u7DA0\u8272\u7684\u65B9\u4F4D\u5C31\u662F\u5317\u908A\u5594\u3002\\n\u5982\u679C\u6703\u8FF7\u8DEF\u7684\u8A71\uFF0C\u4F55\u4E0D\u628A\u5730\u5716\u56FA\u5B9A\u5462\uFF1F",
  "\u73BB\u74F6\u662F\u914D\u5408\u61F8\u5D16\u5EFA\u9020\u7684\u57CE\u5E02\uFF01\\n\u6240\u4EE5\u5E02\u5167\u662F\u4E00\u5C64\u4E00\u5C64\u5594\u3002",
  "\u54CE\u5440\uFF5E\u771F\u662F\u5927\u8CB7\u7279\u8CB7\u4E86\u4E00\u756A\uFF01\\n\u63A5\u4E0B\u4F86\u8981\u53BB\u54EA\u88E1\uFF1F",
  "\u518D\u4F86\u5C31\u662F\u53BB\u6F2C\u6C81\u93AE\u7684\u5E02\u5834\\n\u5F9E\u7B2C\u4E00\u6524\u8CB7\u5230\u6700\u5F8C\u4E00\u6524\uFF01",
  "\u9019\u88E1\u662F\u6C34\u9109\u6FA4\u570B\u73BB\u74F6\uFF5E\u266A\\n\u4EC0\u9EBC\u662F\u73BB\u74F6\uFF5E\u5C31\u662F\u88DD\u6C34\u7684\u73BB\u7483\u74F6\uFF5E\u266A",
  "\u5728\u5EFA\u8A2D\u5347\u964D\u6A5F\u4E4B\u524D\uFF0C\\n\u807D\u8AAA\u5728\u57CE\u88E1\u4E0A\u4E0A\u4E0B\u4E0B\u79FB\u52D5\\r\\n\u90FD\u662F\u9760\u5750\u9A0E\u5BF6\u53EF\u5922\u5462\uFF01\u597D\u8F9B\u82E6\u554A\uFF01",
  "\u807D\u8AAA\u53EA\u6709\u512A\u79C0\u7684\u4EBA\u624D\u80FD\u64C1\u6709\\n\u80FD\u8B93\u5BF6\u53EF\u5922\u592A\u6676\u5316\u7684\u592A\u6676\u73E0\u5462\u3002",
  "\u64DA\u8AAA\u5BF6\u53EF\u5922\u53EA\u6709\u5728\\n\u5E15\u5E95\u4E9E\u5730\u5340\u624D\u6703\u592A\u6676\u5316\u3002\\r\\n\u9019\u7A76\u7ADF\u662F\u70BA\u4EC0\u9EBC\u5462\uFF1F",
  "\u5728\u90A3\u4E00\u822C\u4EBA\u4E0D\u80FD\u9032\u53BB\u7684\\n\u5E15\u5E95\u4E9E\u5DE8\u5751\u88E1\uFF0C\\r\\n\u6703\u6709\u4EC0\u9EBC\u6A23\u7684\u5BF6\u53EF\u5922\u5462\uFF1F",
  "\u6B61\u8FCE\u5149\u81E8\u6D77\u5CB1\u4FF1\u6A02\u90E8\uFF01\\n\u9019\u88E1\u662F\u9053\u9928\u9928\u4E3B\u6D77\u5CB1\u7684\u5E97\u5594\uFF01",
  "\u73BB\u74F6\u5E02\u7F8E\u9E97\u7684\u8857\u666F\\n\u662F\u5F88\u53D7\u6B61\u8FCE\u7684\u62CD\u7167\u666F\u9EDE\u5462\u3002",
  "\u6211\u5011\u660E\u5E74\u958B\u59CB\u5C31\u8981\u4E0A\u5B78\u4E86\u8036\uFF01\\n\u4E0D\u77E5\u9053\u80FD\u4E0D\u80FD\u4EA4\u5230\u5F88\u591A\u670B\u53CB\uFF1F",
  "\u6211\u597D\u671F\u5F85\u5BBF\u820D\u751F\u6D3B\u5594\uFF01\u4F4F\u5BBF\u820D\u7684\u8A71\uFF0C\\n\u5728\u7761\u89BA\u524D\u5403\u9EDE\u5FC3\u4E5F\u4E0D\u6703\u6328\u7F75\uFF0C\u5C0D\u4E0D\u5C0D\uFF1F",
  "\u5728\u628A\u6574\u5EA7\u57CE\u5E02\u7684\u8272\u8ABF\u6539\u6210\u85CD\u8272\u4E4B\u5F8C\uFF0C\\n\u9019\u88E1\u5C31\u589E\u52A0\u4E86\u4E0D\u5C11\u89C0\u5149\u5BA2\u3002\\c\\n\u807D\u8AAA\u9019\u500B\u9EDE\u5B50\u662F\u5E7E\u5E74\u524D\\n\u7531\u6D77\u5CB1\u5148\u751F\u63D0\u51FA\u4F86\u7684\u5594\u3002",
  "\u4E00\u5403\u9806\u53E3\u4E8C\u5403\u4E0A\u766E\uFF0C\u4E09\u660E\u6CBB\u5C31\u5403\u593E\u98FD\u5821\u266A\\n\u4F86\u8CB7\u4E00\u4EFD\u4E09\u660E\u6CBB\u5427\uFF5E\uFF1F",
  "\u73BB\u74F6\u9053\u9928\u7684\u9053\u9928\u6E2C\u9A57\\n\u975E\uFF5E\u5E38\u96E3\u5462\u3002",
  "\u6D77\u5CB1\u5148\u751F\u662F\u9019\u5EA7\u57CE\u5E02\u7684\u62DB\u724C\u5594\uFF01\\n\u4ED6\u7E3D\u662F\u53C8\u958B\u6717\u53C8\u9AD4\u8CBC\uFF0C\u800C\u4E14\\r\\n\u7576\u4ED6\u5728\u7576\u9053\u9928\u9928\u4E3B\u6642\u7C21\u76F4\u5E25\u7206\u4E86\u5462\uFF01",
  "\u96D6\u7136\u5728\u5730\u5F62\u8D77\u4F0F\u6FC0\u70C8\u7684\\n\u5E15\u5E95\u4E9E\u6C92\u8FA6\u6CD5\u505A\u5230\uFF0C\\r\\n\u4F46\u6211\u771F\u60F3\u8A66\u8A66\u9A0E\u8173\u8E0F\u8ECA\u65C5\u884C\u3002",
  "\u807D\u8AAA\u5728\u5176\u4ED6\u5730\u5340\u6709\u6469\u6258\u8725\u4E4B\u5916\u7684\\n\u5750\u9A0E\u5BF6\u53EF\u5922\u3002\u4E0D\u77E5\u9053\u662F\u771F\u662F\u5047\uFF5E\uFF1F",
  "\u9019\u500B\u6708\u6211\u5F88\u52AA\u529B\u2026\u2026\\n\u6240\u4EE5\u53EF\u4EE5\u8CB7\u500B\u9AD8\u7D1A\u5305\u5305\u5427\uFF01",
  "\u63DB\u500B\u9AEE\u578B\uFF0C\u5FC3\u60C5\u7165\u7136\u4E00\u65B0\uFF01\\n\u4F60\u8AAA\u5462\uFF1F\u662F\u4E0D\u662F\u5F88\u53EF\u611B\uFF1F",
  "\u5443\u2026\u2026\\n\u59B3\u662F\u526A\u4E86\u700F\u6D77\u55CE\uFF1F"
]
