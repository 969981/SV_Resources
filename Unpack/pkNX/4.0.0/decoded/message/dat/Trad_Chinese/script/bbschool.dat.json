[
  "\u6B61\u8FCE\u4F86\u5230\u85CD\u8393\u5B78\u5712\uFF01\\c\\n\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u7B2C\u4E00\u6B21\u642D\u4E58\u5730\u4E0B\u9435\u548C\u6D77\u4E2D\u96FB\u68AF\\n\u4E0A\u5B78\u7684\u8A71\uFF0C\u90A3[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u5B9A\u5F88\u5403\u9A5A\u5427\uFF1F",
  "\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\u65B0\u51A0\u8ECD\uFF01\\n\u5C45\u7136\u80FD\u6253\u8D0F\u70CF\u6817\uFF0C\u53B2\u5BB3\u5594\u3002",
  "\u81EA\u5F9E[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u4E86\u4EE5\u5F8C\uFF0C\\n\u5B78\u5712\u5C31\u8B8A\u71B1\u9B27\u4E86\u5462\u3002",
  "\u4E0B\u4E00\u5802\u8AB2\u662F\u5728\\n\u54EA\u500B\u5340\u57DF\u4E0A\u4F86\u8457\uFF1F",
  "\u6211\u53BB\u6975\u5730\u5340\u7684\u6642\u5019\\n\u8981\u662F\u4E0D\u7A7F\u539A\u4E00\u9EDE\uFF0C\u5C31\u6703\u611F\u5192\u3002",
  "\u5927\u5BB6\u8AAA\u7684\u7559\u5B78\u751F\u5C31\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u55CE\uFF1F\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\u8D77\u4F86\u4E00\u9EDE\u90FD\u4E0D\u5F37\u554A\u3002",
  "\u5728\u6211\u5011\u5B78\u5712\u5440\uFF0C\u8981\u662F\u5BF6\u53EF\u5922\u4E0D\u5920\u5F37\uFF0C\\n\u662F\u5F88\u96E3\u6DF7\u4E0B\u53BB\u7684\u5594\u3002",
  "\u771F\u662F\u4EBA\u4E0D\u53EF\u8C8C\u76F8\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u5BE6\u529B\u5F88\u5F37\u5462\u3002",
  "\u9023\u675C\u82E5\u90FD\u7518\u62DC\u4E0B\u98A8\u7684\u70CF\u6817\uFF0C\\n\u5C45\u7136\u6703\u6253\u8F38\u2026\u2026",
  "\u6211\u4E5F\u60F3\u50CF[VAR 1100(00FF,0101)]\u4F60\u59B3\u90A3\u6A23\\n\u8B8A\u5F97\u66F4\u5F37\u3002",
  "\u5728\u5E15\u5E95\u4E9E\u6709\u5F88\u591A\\n\u50CF[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u9EBC\u5F37\u7684\u4EBA\uFF0C\u5C0D\u5427\u3002",
  "\u7CBE\u9748\u7403\u771F\u662F\\n\u6709\u518D\u591A\u90FD\u4E0D\u5920\u7528\u5462\uFF01",
  "\u4F60\u5C31\u53BB\u85CD\u6A02\u6D3B\u6536\u96C6\uFF22\uFF30\uFF0C\\n\u7136\u5F8C\u8CB7\u4E9B\u597D\u7403\u561B\u3002",
  "\u5165\u53E3\u7684\u5C0D\u6230\u5834\u662F\u7528\u4F86\u8209\u884C\\n\u85CD\u8393\u806F\u76DF\u7684\u5B98\u65B9\u5C0D\u6230\u7684\uFF01\\c\\n\u89C0\u773E\u5E2D\u5728\u51A0\u8ECD\u6230\u6642\\n\u6703\u585E\u6EFF\u4E86\u89C0\u773E\u5594\uFF01",
  "\u6211\u770B\u4E86[VAR 1100(00FF,0101)]\u4F60\u59B3\u548C\u7D2B\u7AFD\u5152\u7684\u5C0D\u6230\u5594\uFF01\\n\u6709\u6211\u5F9E\u4F86\u6C92\u898B\u904E\u7684\u5BF6\u53EF\u5922\u5462\uFF5E\uFF01",
  "\u51A0\u8ECD\u6230\u592A\u7CBE\u5F69\u4E86\uFF01\\n\u70CF\u6817\u6703\u964D\u70BA\u56DB\u5929\u738B\u55CE\uFF1F",
  "\u6211\u770B\u4E86[VAR 1100(00FF,0101)]\u4F60\u59B3\u548C\u70CF\u6817\u7684\u5C0D\u6230\uFF01\\n\u70CF\u6817\u4ED6\u2026\u2026\u770B\u8D77\u4F86\u5F88\u96E3\u904E\u5462\u3002",
  "\u6211\u4E5F\u8981\u628A\u6210\u70BA\u51A0\u8ECD\u7576\u505A\u76EE\u6A19\uFF0C\\n\u66F4\u52A0\u52AA\u529B\u3002",
  "\u6211\u770B[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C0D\u6230\uFF0C\u770B\u8457\u770B\u8457\u554A\uFF0C\\n\u5C31\u8B8A\u6210[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u7C89\u7D72\u4E86\uFF01",
  "\u5728\u85CD\u8393\u5B78\u5712\uFF0C\\n\u96D9\u6253\u5C0D\u6230\u662F\u4E3B\u6D41\u3002\\c\\n\u2026\u2026\u5927\u6982\u662F\u56E0\u70BA\u96D9\u6253\u80FD\u6709\\n\u66F4\u591A\u5143\u5316\u7684\u6230\u8853\u5427\uFF1F",
  "\u8A66\u8457\u5230\u8349\u539F\u5340\\n\u6355\u6349\u7368\u89D2\u7280\u725B\u5427\uFF01",
  "\u5CA9\u77F3\u5C6C\u6027\u7814\u7A76\u2161\u597D\u96E3\uFF0C\\n\u6211\u5C31\u662F\u641E\u4E0D\u61C2\u2026\u2026",
  "\u6B63\u96FB\u62CD\u62CD\u7684\u7279\u6027\u662F\u6B63\u96FB\uFF01\\c\\n\u7260\u548C\u8CA0\u96FB\u62CD\u62CD\u5728\u4E00\u8D77\u6642\uFF0C\\n\u7279\u653B\u5C31\u6703\u8B8A\u5F37\u5594\uFF01",
  "\u5C6C\u6027\u76F8\u524B\u8B93\u6211\u982D\u660F\u8166\u8139\uFF0C\\n\u6240\u4EE5\u5728\u5C0D\u6230\u6642\u6703\u5FCD\u4E0D\u4F4F\u770B\u7B46\u8A18\u3002",
  "\u5BD2\u51B7\u6642\u82B1\u8349\u6703\u67AF\u840E\uFF0C\\n\u6240\u4EE5\u51B0\u5C6C\u6027\u524B\u8349\u5C6C\u6027\uFF01\\c\\n\u53EA\u8981\u50CF\u9019\u6A23\u767C\u63EE\u60F3\u50CF\u529B\uFF0C\\n\u5C31\u6703\u6BD4\u8F03\u5BB9\u6613\u8A18\u4F4F\u5C6C\u6027\u76F8\u524B\u56C9\uFF01",
  "\u9019\u9593\u6559\u5BA4\u4F4D\u65BC\u6D77\u4E2D\uFF01\\c\\n\u56E0\u6B64\u6703\u4F7F\u7528\u87A2\u5E55\u986F\u793A\u5929\u7A7A\\n\u4F86\u6E1B\u8F15\u5C01\u9589\u611F\u3002",
  "\u73FE\u5BE6\u4E16\u754C\u5982\u679C\u662F\u665A\u4E0A\uFF0C\\n\u5DE8\u86CB\u88E1\u9762\u4E5F\u6703\u662F\u4E00\u7247\u591C\u7A7A\u3002\\r\\n\u5929\u8272\u662F\u548C\u6642\u9593\u540C\u6B65\u7684\u5594\u3002",
  "\u4E39\u745C\u5979\u5440\uFF0C\u96D6\u7136\u5F88\u4EFB\u6027\uFF0C\\n\u4F46\u6211\u5C31\u662F\u6C92\u8FA6\u6CD5\u53BB\u8A0E\u53AD\u5979\u5462\uFF5E",
  "\u6211\u5011\u73ED\u4E0A\u6709\\n\u5B78\u751F\u6703\u9577\u7D0D\u8389\uFF0C\\r\\n\u9084\u6709\u9B27\u4E8B\u5973\u5B69\u4E39\u745C\u5594\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u5728\u540C\u4E00\u500B\u5730\u65B9\u4E00\u76F4\u8F49\u5708\u5708\uFF0C\\n\u5C31\u80FD\u54BB\uFF5E\u5730\u53B2\u5BB3\u8F49\u8D77\u4F86\u55CE\uFF1F",
  "\u5DE8\u86CB\u88E1\u9762\u6709\u4E00\u7247\\n\u7E3D\u662F\u8D77\u8457\u98A8\u7684\u8349\u539F\u5594\u3002\\r\\n\u5728\u90A3\u88E1\u8F49\u5708\u5708\u61C9\u8A72\u6703\u5F88\u6709\u8DA3\u5427\u3002",
  "\u6709\u4E00\u6B21\u6211\u8D70\u5728\u8349\u539F\u6642\uFF0C\\n\u5FFD\u7136\u611F\u89BA\u5230\u6709\u98A8\u5439\u4F86\uFF0C\\r\\n\u7136\u5F8C\u9084\u807D\u5230\u4E86\u795E\u79D8\u7684\u6B4C\u8072\u5462\u3002",
  "\u6211\u5C07\u4F86\u60F3\u8981\u5728\\n\u53CB\u597D\u5546\u5E97\u5DE5\u4F5C\uFF0C\\r\\n\u6240\u4EE5\u6B63\u5728\u8ABF\u67E5\u7576\u7D05\u7684\u9053\u5177\u5594\u3002",
  "\u5C31\u7B97\u6C92\u6709\u5BF6\u53EF\u5922\u7684\u6389\u843D\u7269\uFF0C\\n\u53EA\u8981\u6709\uFF22\uFF30\uFF0C\\r\\n\u5C31\u80FD\u8CB7\u5230\u62DB\u5F0F\u5B78\u7FD2\u5668\uFF0C\u771F\u65B9\u4FBF\uFF01",
  "\u5BF6\u53EF\u5922\u7684\u62DB\u5F0F\u300C\u5E6B\u52A9\u300D\uFF01\\n\u5728\u96D9\u6253\u5C0D\u6230\u80FD\u5927\u653E\u7570\u5F69\u5594\uFF01",
  "\u7403\u548C\u50B7\u85E5\u53EF\u4EE5\u5728\\n\u5DE8\u86CB\u88E1\u9762\u7684\u81EA\u52D5\u8CA9\u8CE3\u6A5F\u8CFC\u8CB7\u5594\u3002",
  "\u8907\u5408\u91D1\u5C6C\u53EF\u4EE5\u7528\u5728\\n\u54EA\u7A2E\u5BF6\u53EF\u5922\u4E0A\u5462\uFF1F\\r\\n\u50CF\u91D1\u5C6C\u4E00\u6A23\u7684\u5BF6\u53EF\u5922\u55CE\uFF1F",
  "\u98DF\u5802\u7684\u9910\u9EDE\u96D6\u7136\u53E3\u5473\u6709\u9EDE\u91CD\uFF0C\\n\u4F46\u98DF\u529B\u6703\u5C0D\u5168\u5C6C\u6027\u90FD\u6709\u6548\u3002\\r\\n\u8981\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\uFF22\uFF30\uFF0C\u5C31\u9EDE\u4F86\u5403\u5403\u770B\u5427\u3002",
  "\u8981\u91CE\u9910\u7684\u8A71\uFF0C\\n\u7576\u7136\u8981\u9078\u5CFD\u8C37\u5340\uFF01\\r\\n\u800C\u4E14\u90A3\u88E1\u9084\u662F\u7D0D\u8389\u5C0F\u59D0\u7684\u5730\u76E4\uFF01",
  "\u8981\u5403\u4E09\u660E\u6CBB\u7684\u8A71\uFF0C\\n\u80AF\u5B9A\u5C31\u662F\u5230\u6D77\u5CB8\u5340\uFF01\\r\\n\u800C\u4E14\u90A3\u88E1\u9084\u6709\u7D2B\u7AFD\u5152\u7684\u5EE3\u5834\uFF01",
  "\u8981\u548C\u56DB\u5929\u738B\u5C0D\u6230\uFF0C\\n\u5F97\u8981\u5148\u5B8C\u6210\u56DB\u5929\u738B\u6311\u6230\u624D\u884C\u3002",
  "\u6211\u6709\u61FC\u9AD8\u75C7\uFF0C\u8981\u6211\u53BB\u7D0D\u8389\u7684\u6311\u6230\uFF0C\\n\u6839\u672C\u662F\u9580\u5152\u90FD\u6C92\u6709\u554A\uFF5E",
  "\u56DB\u5929\u738B\u88E1\u9762\uFF0C\u6211\u559C\u6B61\u675C\u82E5\uFF01\\n\u4ED6\u770B\u8D77\u4F86\u6C92\u4EC0\u9EBC\u5E79\u52C1\uFF0C\u4F46\u537B\u5F88\u5F37\u5594\uFF01",
  "\u56DB\u5929\u738B\u7684\u8D64\u677E\u6709\u9EDE\u7CCA\u5857\uFF0C\\n\u597D\u53EF\u611B\uFF5E",
  "\u597D\u51B7\u597D\u51B7\u2026\u2026\\n\u6975\u5730\u5340\u8B93\u6211\u5168\u8EAB\u90FD\u51B7\u5431\u5431\u7684\u3002\\r\\n\u6211\u8981\u5403\u62AB\u85A9\u4F86\u6696\u548C\u4E00\u4E0B\u3002",
  "\u98DF\u5802\u83DC\u55AE\u4E0A\u7684\u6771\u897F\\n\u5168\u90FD\u662F\u5E2D\u85CD\u6821\u9577\u611B\u5403\u7684\u5594\uFF01\\c\\n\u96D6\u7136\u770B\u8D77\u4F86\u71DF\u990A\u5F88\u4E0D\u5747\u8861\uFF0C\\n\u4F46\u98DF\u529B\u53EF\u4E0D\u662F\u84CB\u7684\uFF01",
  "\u6211\u7684\u7121\u754F\u5C0F\u5B50\uFF0C\\n\u5F88\u559C\u6B61\u8DD1\u6B65\u6A5F\u5594\uFF01",
  "\u6211\u5440\uFF0C\u6703\u8DDF\u76AE\u5361\u4E18\\n\u4E00\u8D77\u5728\u85CD\u8393\u806F\u76DF\u52A0\u6CB9\u7684\uFF01",
  "\u793E\u8FA6\u91D1\u5149\u9583\u9583\u7684\uFF01\\n\u55B5\u55B5\u5F88\u9AD8\u8208\u5462\uFF01",
  "\u55B5\u55B5\u8C4E\u8D77\u722A\u5B50\uFF0C\\n\u4E00\u526F\u8822\u8822\u6B32\u52D5\u7684\u6A23\u5B50\uFF01",
  "\u5E7B\u5F69\u88DD\u98FE\u7684\u793E\u8FA6\uFF01\\n\u7D2B\u7AFD\u5152\u61C9\u8A72\u6703\u559C\u6B61\u3002",
  "\u9019\u623F\u9593\u8DDF\u91D1\u5C6C\u602A\u2026\u2026\\n\u611F\u89BA\u597D\u642D\u5462\uFF01",
  "\u9019\u9593\u793E\u8FA6\u597D\u9177\u5594\uFF01\\n\u7F8E\u8853\u793E\u771F\u53B2\u5BB3\uFF01",
  "\u90A3\u3001\u90A3\u500B\u8A72\u4E0D\u6703\u662F\\n\u96FB\u5F71\u88E1\u9762\u7684\u795E\u79D8\u5713\u76E4\u5427\uFF01\uFF1F",
  "\u9019\u500B\u623F\u9593\u88E1\u6709\u597D\u591A\u770B\u8D77\u4F86\\n\u559C\u6B61\u6316\u6771\u897F\u7684\u5BF6\u53EF\u5922\u2026\u2026",
  "\u6591\u6591\u99AC\u5728\u9ED1\u767D\u7684\u623F\u9593\u88E1\uFF0C\\n\u5E7E\u4E4E\u8981\u770B\u4E0D\u5230\u4E86\uFF0C\u597D\u53EF\u611B\u5594\uFF5E\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u55CE\uFF1F\u76D4\u7532\u9CE5\u7684\u5F31\u9EDE\u5F88\u5C11\uFF0C\\n\u4E0D\u592A\u597D\u5C0D\u4ED8\u5594\u3002",
  "\u793E\u8FA6\u88E1\u5145\u6EFF\u4E86\u81EA\u7136\u7684\u6C23\u606F\uFF01\\n\u8349\u5BF6\u53EF\u5922\u770B\u8D77\u4F86\u4E5F\u5F88\u9AD8\u8208\uFF01",
  "\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u628A\u793E\u8FA6\u7684\u4E3B\u984C\\n\u67D3\u6210\u6697\u9ED1\u3002\\r\\n\u9670\u9670\u6697\u6697\u7684\uFF0C\u6211\u597D\u611B\u2026\u2026"
]
