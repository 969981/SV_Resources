  "\u540C\u6642\uFF0C\u9019\u88E1\u68F2\u606F\u8457\u8A31\u591A\\n\u9069\u61C9\u4E86\u9019\u7A2E\u6EAB\u6696\u6C23\u5019\u7684\u5BF6\u53EF\u5922\u3002",
  "\u7576\u4E2D\u4E5F\u6709\u5BF6\u53EF\u5922\u56E0\u70BA\u53D7\u5230\\n\u6BD4\u4E00\u822C\u74B0\u5883\u9084\u8981\u591A\u7684\u5149\u7167\uFF0C\\r\\n\u6240\u4EE5\u9577\u5F97\u6BD4\u5176\u4ED6\u5730\u5340\u7684\u540C\u985E\u9084\u8981\u5927\u5594\uFF01",
  "\u6C92\u932F\uFF01\u76F8\u540C\u7684\u5BF6\u53EF\u5922\u5728\u4E0D\u540C\u5730\u5340\u7684\\n\u6A23\u5B50\u9577\u5F97\u4E0D\u540C\uFF0C\u9019\u5C31\u662F[VAR FF00(0006)]\u5730\u5340\u5F62\u614B[VAR FF00(0000)]\uFF01",
