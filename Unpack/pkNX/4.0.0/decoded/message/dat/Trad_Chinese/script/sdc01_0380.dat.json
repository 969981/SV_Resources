[
  "\u5409\u96C9\u96DE\u771F\u7684\\n\u80FD\u5728\u7A7A\u4E2D\u98DB\u5462\uFF01\\r\\n\u7260\u54BB\uFF5E\u5730\u98DB\u904E\u9B3C\u5C71\u4E86\uFF01",
  "\u5BF6\u4F34\u5920\u8B9A\u72D7\uFF01\\n\u7D2B\u8272\u7684\u570D\u5DFE\u771F\u6F02\u4EAE\uFF01\\r\\n\u6211\u770B\u5230\u7260\u5728\u8352\u5730\u6563\u6B65\u5462\uFF01",
  "\u6211\u4EE5\u70BA\u6709\u4EBA\u5012\u5728\u90A3\u88E1\uFF0C\\n\u7D50\u679C\u539F\u4F86\u662F\u9858\u589E\u733F\u5728\u7761\u5348\u89BA\uFF01\\c\\n\u6C60\u5858\u7684\u5468\u570D\u7684\u78BA\u662F\\n\u8EBA\u8D77\u4F86\u5F88\u8212\u670D\u7684\u597D\u5730\u65B9\u554A\u3002",
  "\u7372\u5F97\u4E86\u7B2C\uFF11\u500B\\n\u95DC\u65BC\u5BF6\u4F34\u7684\u6D88\u606F\uFF01",
  "\u7372\u5F97\u4E86\u7B2C\uFF12\u500B\\n\u95DC\u65BC\u5BF6\u4F34\u7684\u6D88\u606F\uFF01",
  "\u8490\u96C6\u5230\\n\u5BF6\u4F34\u5011\u7684\u6D88\u606F\u4E86\uFF01\\r\\n\u53BB\u548C\u4E39\u745C\u4ED6\u5011\u6703\u5408\u5427\uFF01",
  "\u6211\u5011\u8981\u628A\u5BF6\u4F34\u7684\u76EE\u64CA\u6D88\u606F\\n\u4E00\u500B\u4E0D\u6F0F\u5730\u8490\u96C6\u8D77\u4F86\uFF01\\r\\n\u8490\u96C6\u5230\u4E86\u5C31\u4F86\u6703\u5408\u5427\uFF01[VAR 0114(0044)]",
  "\u5C31\u7B97\u5C0D\u65B9\u662F\u6751\u5B50\u88E1\u7684\u4EBA\uFF0C\\n\u8981\u6211\u53BB\u642D\u8A71\u6211\u9084\u662F\u6703\u5BB3\u7F9E\u2026\u2026[VAR 0114(0043)]"
]
