[
  "[VAR 0100(0000)]\uFF0C\\n\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u904E\u4F86\uFF01[VAR 0114(0042)]",
  "\u9020\u8A2A\u96F6\u4E4B\u5927\u7A7A\u6D1E\u7684\u75B2\u52DE\uFF0C\\n\u90FD\u6062\u5FA9\u4E86\u55CE\uFF1F[VAR 0114(0042)]",
  "\u771F\u4E0D\u6127\u662F\u5E74\u8F15\u4EBA\uFF01\\n\u6211\u554A\uFF0C\u5C31\u7B97\u904E\u4E86\u597D\u5E7E\u5929\uFF0C\\r\\n\u90FD\u9084\u89BA\u5F97\u7D2F\u5462\uFF01[VAR 0114(0042)]",
  "\u54CE\u5440\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u9EBC\u5E74\u8F15\uFF0C\u771F\u662F\u610F\u5916\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u61C9\u8A72\u9084\u6C92\u5230\u9700\u8981\u5169\u5929\\r\\n\u624D\u6703\u611F\u5230\u808C\u8089\u75E0\u75DB\u7684\u5E74\u7D00\u624D\u662F\u554A\uFF01\uFF1F[VAR 0114(0042)]",
  "\u5C0D\u4E86\uFF0C\u6211\u70BA\u4E86\u628A\u5728\u5927\u7A7A\u6D1E\\n\u505A\u7684\u8ABF\u67E5\u6574\u7406\u6210\u66F8\uFF0C\\r\\n\u56DE\u4F86\u4E4B\u5F8C\u5C31\u4E00\u76F4\u4E0D\u7720\u4E0D\u4F11\u5730\u5728\u5BEB\u4F5C\u3002[VAR 0114(0042)]",
  "\u7576\u7136\u6211\u5F97\u5230\u4E86\u4E5F\u6148\u7684\u8A31\u53EF\uFF0C\\n\u5177\u9AD4\u7684\u4E8B\u4EF6\u548C\u4EBA\u540D\u7B49\u7B49\u7684\u90E8\u5206\\r\\n\u90FD\u96B1\u779E\u4F4F\u4E86\uFF0C\u6240\u4EE5\u653E\u5FC3\u5427\u3002[VAR 0114(0042)]",
  "\u9019\u662F\u525B\u525B\u6536\u5230\u7684\u6A23\u66F8\u3002[VAR 0114(0042)]",
  "\u5728\u96F6\u4E4B\u5927\u7A7A\u6D1E\u7684\u6642\u5019\uFF0C\\n\u771F\u7684\u662F\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u6DFB\u9EBB\u7169\u4E86\u3002[VAR 0114(0042)]",
  "\u96D6\u7136\u9019\u8AAA\u4E0D\u4E0A\u662F\u9053\u6B49\uFF0C\\n\u4F46\u6211\u5E0C\u671B[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u6536\u4E0B\u5B83\u3002[VAR 0114(0042)]",
  "\u8A71\u8AAA\u56DE\u4F86\uFF0C[VAR 0100(0000)]\uFF0C\\n\u53EF\u4EE5\u7D66\u6211\u770B\u770B[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u592A\u6676\u73E0\u55CE\uFF1F[VAR 0114(0042)]",
  "\u679C\u7136\u2026\u2026\u548C\u70CF\u6817\u3001\u4E39\u745C\u7684\\n\u592A\u6676\u73E0\u5448\u73FE\u540C\u6A23\u7684\u53CD\u61C9\u5462\u3002[VAR 0114(0042)]",
  "\u9019\u53EF\u80FD\u662F\u56E0\u70BA\u5728\u5927\u7A7A\u6D1E\\n\u76F4\u63A5\u63A5\u89F8\u5230\u4E86\u592A\u6A02\u5DF4\u6208\u65AF\u7684\u80FD\u91CF\u3002[VAR 0114(0042)]",
  "\u70CF\u6817\u4ED6\u5011\u662F\u8AAA\uFF0C\u5F9E\u5927\u7A7A\u6D1E\u56DE\u4F86\u5F8C\\n\u4ED6\u5011\u5006\u5373\u4F7F\u4E0D\u5E6B\u592A\u6676\u73E0\u84C4\u80FD\uFF0C\\r\\n\u4E5F\u80FD\u9032\u884C\u592A\u6676\u5316\u4E86\u3002[VAR 0114(0042)]",
  "\u2026\u2026\u53E6\u5916\uFF01\u6211\u9084\u6709\u4E00\u4EF6\\n\u548C\u5927\u7A7A\u6D1E\u6709\u95DC\u7684\u4E8B\u8981\u8DDF[VAR 1100(00FF,0101)]\u4F60\u59B3\u5206\u4EAB\u3002[VAR 0114(0042)]",
  "\u5C31\u662F\u61F8\u639B\u5728\u751F\u614B\u5DE8\u86CB\\n\u5713\u9802\u4E0A\u7684\u751F\u614B\u6838\uFF01[VAR 0114(0042)]",
  "\u4EE5\u524D\u90FD\u662F\u7531\u6211\u628A\u5E15\u5E95\u4E9E\u7684\u571F\u58E4\\n\u6216\u6676\u5149\u6C60\u7684\u6C34\uFF0C\u4E0D\u6642\u5730\u6CE8\u5165\u751F\u614B\u6838\u88E1\u9762\u3002[VAR 0114(0042)]",
  "\u85C9\u6B64\u624D\u80FD\u5728\u5B78\u5712\u88E1\\n\u7A69\u5B9A\u5730\u4F7F\u7528\u592A\u6676\u7684\u529B\u91CF\u3002\\r\\n\u4F46\u60F3\u4E0D\u5230\u2026\u2026[VAR 0114(0042)]",
  "\u524D\u5E7E\u5929\u6211\u653E\u4E86\u5728\u5927\u7A7A\u6D1E\u63A1\u96C6\u7684\u7D50\u6676\u9032\u53BB\u5F8C\uFF0C\\n\u6838\u5FC3\u7684\u6027\u8CEA\u767C\u751F\u4E86\u8B8A\u5316\u3002[VAR 0114(0042)]",
  "\u5DE8\u86CB\u88E1\u958B\u59CB\u6703\u51FA\u73FE\\n\u9583\u8000\u8457\u8679\u8272\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u4E5F\u5C31\u662F\u592A\u6676\u5C6C\u6027\uFF1A\u661F\u6676\u7684\u5BF6\u53EF\u5922\u4E86\uFF01[VAR 0114(0042)]",
  "\u9019\u6703\u8B93\u6211\u7684\u592A\u6676\u7814\u7A76\u9032\u5C55\u795E\u901F\uFF0C\\n\u66F4\u52A0\u9583\u8000\u7121\u6BD4\uFF01[VAR 0114(0042)]",
  "\u7136\u5F8C\u2026\u2026\u5C0D\u4E86\uFF0C\\n\u5728\u7A7F\u5802\u5927\u5EF3\u90A3\u88E1\\c\\n\u6709\u500B\u7A7F\u9ED1\u897F\u88DD\u7684\u5927\u53D4\u5728\u627E[VAR 1100(00FF,0101)]\u4F60\u59B3\u5594\u3002[VAR 0114(0042)]",
  "\u6211\u60F3\u544A\u8A34[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5C31\u662F\u9019\u4E9B\u4E86\uFF01\\n\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u82B1\u6642\u9593\u807D\u6211\u5206\u4EAB\uFF01[VAR 0114(0042)]",
  "\u63A5\u4E0B\u4F86\u6211\u8981\u53BB\u51FA\u7248\u793E\uFF0C\\n\u5C31\u5148\u5931\u966A\u4E86\u3002\\c\\n\u5E0C\u671B[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0B\u6B21\u80FD\u8B93\u6211\\n\u4ED4\u7D30\u5730\u89C0\u5BDF\u592A\u6A02\u5DF4\u6208\u65AF\u3002[VAR 0114(0042)]"
]
