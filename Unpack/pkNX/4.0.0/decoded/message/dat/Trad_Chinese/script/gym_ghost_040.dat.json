  "\u807D\u6211\u7684RAP\uFF0C\u9053\u9928\u9928\u4E3B\u266A\\n\u6211\u662F\u500BTOP\uFF0C\u6253\u5DE5\u4E0D\u82E6\u266A",
  "\u549A\u549A\u9686\u549A\u93D8\u93D8\u2026\u2026\\n\u549A\u549A\u9686\u549A\u93D8\u2026\u2026",
  "\u6253\u5DE5\u4E0D\u75DB\u82E6\uFF1F\u266A\\nRHYME\u537B\u99AC\u99AC\u864E\u864E\u266A\\r\\n\u6557\u8005\u4E56\u4E56\u6536\u62FE\u5305\u88B1\u56DE\u5BB6\u54ED\u54ED\u266A[VAR 0114(001B)]",
  "\u6211\u662F\u840A\u59C6\u266A\u4E0D\u662F\u4EC0\u9EBC\u8056\u6BCD\u266A\\n\u4F60\u8AAA\u6211\u9177\uFF1F\u83AB\u602A\u6211\u50CF\u500B\u70B8\u85E5\u5EAB\u266A[VAR 0114(001B)]",
  "\u83DC\u9CE5\u8D85\u905C\uFF0C\u5FEB\u5F9E\u767D\u65E5\u5922\u88E1\u6E05\u9192\u266A\\n\u5584\u54C9\u5584\u54C9\uFF01\u9760\u9952\u820C\u6551\u4F60\u4E00\u547D\u266AHEY\uFF01[VAR 0114(001B)]",
  "\u549A\u549A\u9686\u549A\u93D8\u93D8\u2026\u2026\\n\u549A\u549A\u9686\u549A\u93D8\u2026\u2026",
  "\u5B8C\u6557\u3001\u6158\u6557\uFF0C\u8AAABYE-BYE\uFF01\\n\u96EA\u6065\uFF0C\u4E0D\u9072\uFF0C\u6EF4\u6C34\u7A7F\u77F3\uFF5E\uFF01",
  "\u7AD9\u4F4F\uFF01\u7BC0\u594F\u9084\u6C92\u505C\u554A\uFF01\\c\\n\u5509\u2026\u2026\u4EC0\u9EBC\u6EF4\u6C34\u7A7F\u77F3\uFF01\\n\u4F60\u9019\u9EBC\u96A8\u6027\u4F7F\u52C1\uFF0C\u771F\u662F\u6383\u4E86\u6211\u7684\u8208\uFF01[VAR 0114(001B)]",
  "\u4E00\u79D2\u653E\u68C4\uFF0C\u771F\u662F\u6D29\u6C23\uFF01\\n\u6709\u5FD7\u6C23\u7684\u5C0D\u624B\u7A76\u7ADF\u8DD1\u5230\u54EA\u53BB\uFF01[VAR 0114(001B)]",
  "\u2026\u2026\u55EF\uFF1F[VAR 0114(001B)]",
  "\u4E0B\u4E00\u500B\u5C0D\u624B\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u55CE\uFF1F\u958B\u5834\u7684\u5BF6\u8C9D\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u9053\u9928\u5C0D\u6230\uFF0C\u9084\u662F\u8981\u9952\u820C\u5C0D\u6230\uFF1F[VAR 0114(001B)]",
  "\u9053\u9928\u5C0D\u6230\uFF01",
  "\u9952\u820C\u5C0D\u6230\uFF01",
  "\u7576\u7136\u4E0D\u662F\u9952\u820C\uFF0C\\n\u4E0D\u7136\u6211\u6703\u6B3A\u4EBA\u592A\u751A\uFF01HAHAHA\uFF01[VAR 0114(001B)]",
  "HAHA\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u56DE\u7B54\uFF0C\\n\u771F\u662F\u73A9\u7B11\u958B\u5F97\u6211\u7709\u958B\u773C\u7B11\uFF01[VAR 0114(001B)]",
  "\u2026\u2026\u55EF\uFF1F[VAR 1100(00FF,0101)]\u4F60\u59B3\u89BA\u5F97\u6211\u8AAA\u8A71\u7684\u65B9\u5F0F\\n\u807D\u8D77\u4F86\u5F88\u4E0D\u53EF\u601D\u8B70\uFF1F[VAR 0114(001B)]",
  "\u9019\u53EB\u505A\u9952\u820C\uFF01\\c\\n\u4E58\u8457\u7BC0\u594F\u5531\u51FA\u62BC\u97FB\u7684\u5B57\u8A5E\uFF0C\\n\u4EA4\u7E54\u51FA\u4E00\u7A2E\u5145\u6EFF\u9748\u9B42\u7684\u6B4C\u8A5E\u3002[VAR 0114(001B)]",
  "\u52FE\u9B42\u773C\uFF0C\u597D\u5012\u6963\uFF0C\u51FA\u9580\u7ACB\u523B\u9047\u6253\u96F7\u266A\\n\u9583\u4EAE\u4EAE\uFF0C\u958B\u4E86\u80C3\uFF0C\u53EA\u597D\u660E\u5929\u518D\u6E1B\u80A5\u266A\\r\\n\u2026\u2026\u5927\u6982\u5C31\u662F\u9019\u6A23\uFF01\u611F\u89BA\u5230\u4E86\u55CE\uFF1F[VAR 0114(001B)]",
  "\u54CE\uFF0C\u4E0D\u904E[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u500B\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\uFF01\\n\u5C31\u7528\u5C0D\u6230\u79C0\u51FA[VAR 1100(00FF,0101)]\u4F60\u59B3\u90A3\u80A1\u6FC0\u6602\u7684\u52C1\u5152\u5427\uFF01[VAR 0114(001B)]",
  "\u96D6\u7136\u6211\u7684\u672C\u884C\u662F\u500B\u9952\u820C\u6B4C\u624B\uFF0C\\n\u4E0D\u904E\u8B93\u6211\u7528\u8D77\u5E7D\u9748\u5BF6\u53EF\u5922\uFF0C\\r\\n\u662F\u5E7E\u4E4E\u6C92\u4EBA\u80FD\u8D0F\u904E\u6211\u7684\u5594\u3002[VAR 0114(001B)]",
  "\u6211\u662F\u840A\u59C6\uFF01\\n\u4EBA\u3001\u7A31\u3001\u6211\uFF0C\u6DF1\u60C5\u9748\u9B42\u9952\u820C\u6A02\uFF01[VAR 0114(001B)]",
  "\u8B93\u6211\u5011\u4F7F\u51FA\u52C1\u4F86\u5171\u9CF4\uFF01\\nSOUL\uFF01LIFE\uFF01\u5C0D\u6230\u5C31\u662F\u8981FEEL\uFF01\uFF01[VAR 0114(001B)]",
  "HAHAHA\uFF01\u597D\u554A\uFF01\\n\u6211\u611F\u53D7\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E36\u52C1\u7684\u9748\u9B42\u5566\uFF01[VAR 0114(001B)]",
  "\u7ADF\u7136\u80FD\u8B93\u6211\u5606\u51FA\u4E00\u53E3\u6C23\uFF0C\u771F\u662F\u6709\u9AA8\u6C23\uFF01\\n\u54FC\uFF01\u9019\u9053\u9928\u5FBD\u7AE0[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u62FF\u53BB\u5427\uFF01[VAR 0114(001B)]",
  "\u8981\u4E0D\u8981\u9806\u4FBF\u6536\u4E0B\u80FD\u5728\\n\u6F14\u5531\u6703\u8CB4\u8CD3\u5E2D\u807D\u6211\u5531\u6B4C\u7684\u6B0A\u5229\u5440\uFF1F[VAR 0114(001B)]",
  "\u53EA\u8981\u6709[VAR 0200(0001)]\u500B\u9053\u9928\u5FBD\u7AE0\uFF0C\\n\u5C31\u6BD4\u8F03\u5BB9\u6613\u6349\u5230\u7B49\u7D1A[VAR 0201(0002)]\u4EE5\u4E0B\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u800C\u4E14\u7260\u5011\u90FD\u6703\u807D\u8A71\u5594\uFF01[VAR 0114(001B)]",
  "\u53EA\u8981\u6709\uFF18\u500B\u9053\u9928\u5FBD\u7AE0\uFF0C\\n\u4E0D\u7BA1\u4EC0\u9EBC\u5BF6\u53EF\u5922\u90FD\u80FD\u6349\u5230\uFF0C\\r\\n\u800C\u4E14\u7260\u5011\u90FD\u6703\u8001\u5BE6\u5730\u807D\u8A71\u5594\uFF01[VAR 0114(001B)]",
  "\u9952\u820C\u5C0D\u6230\u8B93\u6211\u8208\u596E\uFF0C\u9AD8\u8208\u898B\u5230\u597D\u5929\u5206\uFF01\\n\u4F86\uFF0C\u6211\u518D\u53E6\u5916\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u500B\u79AE\u7269\u5427\uFF01[VAR 0114(001B)]",
  "\u6211\u9084\u6C92\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u807D\u500B\u5920\u5462\uFF01\\n\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E8B\u60C5\u8FA6\u5B8C\u5F8C\uFF0C\u518D\u4F86\u9019\u5152\u4E00\u8D9F\u5427\uFF01\\r\\n\u4E0B\u6B21\u6211\u5011\u4E5F\u53EF\u4EE5\u4F86\u5834\u9952\u820C\u5C0D\u6230\uFF01[VAR 0114(001B)]",
