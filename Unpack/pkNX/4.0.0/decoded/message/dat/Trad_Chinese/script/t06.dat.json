[
  "\u9019\u88E1\u662F\u9326\u532F\u93AE\u3002\\n\u770B\u8D77\u4F86\u62C9\u62C9\u96DC\u96DC\u7684\u5427\uFF1F\\r\\n\u771F\u662F\u93AE\u5982\u5176\u540D\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u904E\u5BF6\u98DF\u5802\u4E86\u55CE\uFF1F\\n\u807D\u8AAA\u9053\u9928\u9928\u4E3B\u662F\u90A3\u88E1\u7684\u5E38\u5BA2\uFF01",
  "\u6211\u5011\u7684\u6599\u7406\u662F\u5E15\u5E95\u4E9E\u7B2C\u4E00\u7F8E\u5473\uFF01\\n\u6B61\u8FCE\u4F86\u5690\u5690\u770B\uFF01",
  "\u6B61\u8FCE\u5149\u81E8\u9802\u65B0\u9BAE\u9910\u5EF3\uFF01\\n\u6599\u7406\u5BCC\u542B\u7926\u7269\u8CEA\u5594\uFF5E",
  "\u6211\u60F3[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\\n\u61C9\u8A72\u5F88\u60F3\u5728\u672C\u5E97\u7528\u9910\u5594\u3002",
  "\u6211\u807D\u8AAA\u5F88\u8CB4\u7684\u9910\u5EF3\\n\u6703\u6709\u670D\u88DD\u898F\u5B9A\u3002\\r\\n\u5230\u5E95\u6703\u6709\u4EC0\u9EBC\u6A23\u7684\u898F\u5B9A\u5462\u2026\u2026\uFF1F",
  "\u6211\u8981\u5B58\u96F6\u7528\u9322\uFF0C\\n\u8B93\u5BF6\u53EF\u5922\u5403\u597D\u5403\u7684\u6771\u897F\uFF5E",
  "\u8FA3\uFF5E\u4E4E\u4E4E\u7684\u6599\u7406\u662F\u672C\u5E97\u7684\u62FF\u624B\u83DC\uFF01\\n\u4F86\u5594\uFF5E\u4F86\u5594\uFF5E\u5FEB\u4F86\u5690\u5690\uFF01",
  "\u73FE\u5728\u4E0D\u7528\u9810\u7D04\\n\u4E5F\u80FD\u5728\u672C\u5E97\u7528\u9910\u3002",
  "\u6709\u500B\u597D\u5927\u7684\u9580\u64CB\u8457\uFF0C\\n\u6C92\u8FA6\u6CD5\u5230\u5E15\u5E95\u4E9E\u5DE8\u5751\u53BB\u3002",
  "\u807D\u8AAA\u9580\u7684\u5F8C\u65B9\u6709\u500B\u53EB\u96F6\u5340\u9598\u53E3\u7684\u8A2D\u65BD\uFF0C\\n\u90A3\u88E1\u7981\u6B62\u4EFB\u4F55\u4EBA\u9032\u5165\u3002",
  "\u9326\u532F\u93AE\u77E5\u540D\u7684\\n\u5BF6\u98DF\u5802\u5C31\u5728\u9019\u88E1\uFF5E\uFF01\\c\\n\u5982\u679C\u6B63\u5728\u53C3\u52A0\u9053\u9928\u6E2C\u9A57\uFF0C\\n\u6211\u5011\u9084\u63D0\u4F9B\u79D8\u5BC6\u83DC\u55AE\u5594\uFF5E\uFF01",
  "\u6211\u807D\u8AAA\u5BF6\u98DF\u5802\u53EF\u4EE5\u5E6B\u5FD9\\n\u6539\u8B8A\u5BF6\u53EF\u5922\u7684\u592A\u6676\u5C6C\u6027\uFF0C\\r\\n\u4F46\u4E3B\u5EDA\u7406\u90FD\u4E0D\u7406\u6211\u2026\u2026",
  "\u4F86\u500B\u4E09\u660E\u6CBB\u5982\u4F55\u5440\uFF1F\\n\u4E0D\u7BA1\u809A\u5B50\u9913\u4E0D\u9913\u90FD\u6B61\u8FCE\u5594\uFF5E\uFF01",
  "\u5728\u722C\u971C\u62B9\u5C71\u4E4B\u524D\uFF0C\\n\u6211\u6703\u4F86\u9326\u532F\u93AE\u7684\u5546\u5E97\u8857\u7528\u9910\uFF0C\\r\\n\u597D\u589E\u5F37\u9AD4\u529B\u3002",
  "\u9019\u500B\u57CE\u93AE\u662F\u5E15\u5E95\u4E9E\u7684\u4EA4\u901A\u8981\u885D\u3002\\c\\n\u56E0\u70BA\u6709\u5F88\u591A\u5F9E\u5916\u5730\u4F86\u8A2A\u7684\u4EBA\uFF0C\\n\u81EA\u7136\u800C\u7136\u5730\u9910\u98F2\u5E97\u5C31\u8D8A\u4F86\u8D8A\u591A\u4E86\u3002",
  "\u6211\u7684\u85CF\u98FD\u6817\u9F20\u6700\u8FD1\\n\u8B8A\u5F97\u8D8A\u4F86\u8D8A\u5927\u96BB\u2026\u2026\\r\\n\u6216\u8A31\u6211\u8A72\u642C\u5230\u6BD4\u8F03\u5927\u7684\u623F\u5B50\uFF1F",
  "\u971C\u62B9\u5C71\u7684\u8DEF\u9014\u5341\u5206\u96AA\u5CFB\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5982\u679C\u8981\u53BB\uFF0C\u8981\u505A\u597D\u6E96\u5099\u624D\u884C\u3002",
  "\u9019\u500B\u57CE\u93AE\u88E1\u6C92\u6709\u5C0D\u6230\u5834\u3002\\n\u4E0D\u66C9\u5F97\u5728\u54EA\u88E1\u548C\u9053\u9928\u9928\u4E3B\u5C0D\u6230\u5462\uFF1F",
  "\u5728\u5F88\u4E45\u5F88\u4E45\u4EE5\u524D\u6A13\u68AF\u4E0B\u9762\u662F\u500B\u5287\u5834\uFF0C\\n\u5728\u90A3\u88E1\u53EF\u4EE5\u89C0\u8CDE\u5230\u821E\u53F0\u5287\u6216\u6F14\u5531\u6703\u3002",
  "\u5E74\u8F15\u4EBA\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u5B78\u751F\u55CE\uFF1F\\n\u770B\u4F86\u73FE\u5728\u662F\u6821\u5916\u7814\u7A76\u7684\u5B63\u7BC0\u3002"
]
