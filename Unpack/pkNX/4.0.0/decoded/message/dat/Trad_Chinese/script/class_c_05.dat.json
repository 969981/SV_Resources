[
  "\u55E8\uFF0C\u540C\u5B78\u5011\uFF0C\\n\u4F60\u5011\u53C8\u6BD4\u6628\u5929\u53E4\u8001\u4E00\u5929\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u4E5F\u8B93\u6211\u5011\u4E00\u8D77\u89E3\u958B\\n\u6B77\u53F2\u7684\u7F8E\u5999\u4E4B\u8655\u2026\u2026\u6211\u539F\u672C\u662F\u9019\u9EBC\u6253\u7B97\u3002\\r\\n\u4F46\u525B\u8003\u5B8C\u8A66\uFF0C\u5404\u4F4D\u73FE\u5728\u662F\u4E00\u526F\u7A7A\u6BBC\u5427\u3002[VAR 0114(0027)]",
  "\u4E7E\u8106\u5076\u723E\u63DB\u500B\u53E3\u5473\uFF0C\\n\u9001\u4F60\u5011\u4E00\u6BB5\u5FEB\u6A02\u7684\u6642\u9593\u597D\u4E86\u3002[VAR 0114(0027)]",
  "\u8B93\u6211\u4F86\u8B1B\u500B\u6D41\u50B3\u5728\u5E15\u5E95\u4E9E\u7684\\n\u597D\uFF5E\u4E45\u597D\u4E45\u4EE5\u524D\u7684\u7AE5\u8A71\u6545\u4E8B\u5427\u3002[VAR 0114(0027)]",
  "\u5F9E\u524D\u5F9E\u524D\u5728\u67D0\u500B\u5730\u65B9\uFF0C\\n\u6709\u4E00\u500B\u5F88\u559C\u6B61\u6536\u96C6\u5BF6\u7269\u7684\u570B\u738B\u3002[VAR 0114(0027)]",
  "\u570B\u738B\u6700\u559C\u6B61\u7570\u570B\u7684\u5BF6\u7269\u4E86\u3002\\c\\n\u65BC\u662F\u6709\u4E00\u5929\uFF0C\u807D\u5230\u9019\u50B3\u805E\u7684\u5546\u4EBA\\n\u9060\u81EA\u6771\u65B9\u7684\u570B\u5BB6\u524D\u4F86\u62DC\u8A2A\u570B\u738B\u3002[VAR 0114(0027)]",
  "\u5546\u4EBA\u62FF\u51FA\u4E86\uFF14\u500B\u5BF6\u7269\uFF0C\\n\u9673\u5217\u5728\u570B\u738B\u7684\u9762\u524D\u3002[VAR 0114(0027)]",
  "\u9019\u4E9B\u5BF6\u7269\u5206\u5225\u662F\\n\u9F0E\u2026\u2026\u528D\u2026\u2026\\r\\n\u7C21\u2026\u2026\u7389\u2026\u2026[VAR 0114(0027)]",
  "\u898B\u5230\u9019\u4E9B\u7A00\u6709\u7684\u5BF6\u7269\uFF0C\\n\u570B\u738B\u9AD8\u8208\u5F97\u8DF3\u4E86\u8D77\u4F86\uFF0C[VAR 0114(0027)]",
  "\u4E26\u4E14\u8CDC\u7D66\u5546\u4EBA\u8A31\u591A\u7684\u91D1\u5E63\uFF0C\\n\u8ACB\u4ED6\u8B93\u51FA\u4E86\u9019\uFF14\u500B\u5BF6\u7269\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u9EBC\uFF0C\u8ACB\u9019\u6642\u4E0D\u5E78\u8207\u6211\\n\u5C0D\u4E0A\u773C\u7684[VAR 0100(0000)]\u4F86\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u5BF6\u7269\u4E2D\u7684\u300C\u7C21\u300D\uFF0C\\n\u662F\u4EC0\u9EBC\u6A23\u7684\u6771\u897F\u55CE\uFF1F[VAR 0114(0027)]",
  "\u6728\u677F",
  "\u6A02\u8B5C",
  "\u8F15\u98DF",
  "\u2026\u2026\u6B63\u78BA\u7B54\u6848\uFF01\\n\u770B\u4F86[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E73\u6642\u5C31\u6709\u5728\u63A2\u7A76\u77E5\u8B58\u5462\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u932F\u8AA4\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u5E0C\u671B\u6211\u5410\u69FD\u8AAA\\r\\n\u90A3\u662F\u300C\u7C21\u8B5C\u300D\u55CE\uFF1F[VAR 0114(0027)]",
  "\u2026\u2026\u932F\u8AA4\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u5E0C\u671B\u6211\u5410\u69FD\u8AAA\\r\\n\u90A3\u662F\u300C\u7C21\u9910\u300D\u55CE\uFF1F[VAR 0114(0027)]",
  "\u6240\u8B02\u300C\u7C21\u300D\uFF0C\u662F\u53E4\u4EE3\u7684\u6771\u65B9\u570B\u5BB6\\n\u7528\u4F86\u66F8\u5BEB\u6587\u5B57\u7684\u6728\u677F\u3002\\r\\n\u2026\u2026\u4E5F\u53EF\u7A31\u70BA\u300C\u6728\u7C21\u300D\u3002[VAR 0114(0027)]",
  "\u5982\u5404\u4F4D\u6240\u77E5\uFF0C\\n\u96A8\u8457\u7D19\u5F35\u7684\u666E\u53CA\uFF0C\\r\\n\u6728\u7C21\u6F38\u6F38\u5C31\u4E0D\u518D\u88AB\u4F7F\u7528\u4E86\u3002[VAR 0114(0027)]",
  "\u7528\u4F86\u4EE3\u66FF\u7D19\u5F35\u7684\u6728\u677F\u7ADF\u7136\u6703\u662F\u500B\u5BF6\uFF0C\\n\u8981\u4E0D\u662F\u90A3\u6771\u897F\u770B\u8D77\u4F86\u7279\u5225\u6C23\u6D3E\uFF0C\\r\\n\u5C31\u662F\u4E0A\u9762\u5BEB\u8457\u6975\u70BA\u73CD\u8CB4\u7684\u6559\u8AA8\u5427\u3002[VAR 0114(0027)]",
  "\u5728\u570B\u738B\u64C1\u6709\u4E86\u5BF6\u7269\u7684\\n\u90A3\u500B\u665A\u4E0A\u2026\u2026[VAR 0114(0027)]",
  "\u64DA\u8AAA\u6709\u707D\u798D\u81E8\u5230\u570B\u738B\u7684\u57CE\u5821\uFF0C\\n\u65BC\u662F\u5728\u4E00\u591C\u4E4B\u9593\uFF0C\u4E00\u5207\u90FD\u6BC0\u58DE\u4E86\u3002[VAR 0114(0027)]",
  "\u96D6\u7136\u6211\u9084\u6C92\u6709\u8AAA\u5B8C\uFF0C\\n\u4F46\u6642\u9418\u5DF2\u7D93\u8D70\u904E\u982D\u4E86\u3002[VAR 0114(0027)]",
  "\u60F3\u77E5\u9053\u6545\u4E8B\u5F8C\u7E8C\u7684\u4EBA\uFF0C\\n\u5C31\u5728\u8AB2\u5F8C\u6642\u9593\u79C1\u4E0B\u4F86\u627E\u6211\u5427\u3002[VAR 0114(0027)]"
]
