[
  "\u563F\u5440\uFF01\u8F49\u5B78\u751F\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u8CB7\u6771\u897F\u55CE\uFF01\uFF1F[VAR 0114(0024)]",
  "\u6211\u4F86\u8CB7\u6771\u897F",
  "\u6211\u4F86\u627E\u8001\u5E2B\u59B3",
  "\u8CA9\u8CE3\u90E8\u662F\u500B\u597D\u5730\u65B9\uFF01\\n\u8981\u4EC0\u9EBC\u6709\u4EC0\u9EBC\uFF01[VAR 0114(0024)]",
  "\u54C8\u54C8\u54C8\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7279\u5730\u4F86\u627E\u6211\u554A\uFF01[VAR 0114(0024)]",
  "\u6211\u6B63\u5728\u8A55\u9078\u4E09\u660E\u6CBB\uFF01[VAR 0114(0024)]",
  "\u8CA9\u8CE3\u90E8\u7684\u4E09\u660E\u6CBB\u71DF\u990A\u5747\u8861\u53C8\u597D\u5403\uFF0C\\n\u7121\u53EF\u6311\u5254\uFF01[VAR 0114(0024)]",
  "\u4E0D\u89AA\u624B\u505A\u55CE\uFF1F",
  "\u7279\u8A13\u5462\uFF1F",
  "\u54C8\u54C8\u54C8\uFF01\\n\u505A\u90A3\u4E9B\u4E0D\u7FD2\u6163\u7684\u7279\u8A13\u8B93\u6211\u6709\u9EDE\u7D2F\u4E86\uFF01[VAR 0114(0024)]",
  "\u6211\u5DF2\u7D93\u9054\u6210\u76EE\u6A19\u4E86\uFF0C\\n\u6240\u4EE5\u6599\u7406\u66AB\u6642\u4F11\u606F\u4E00\u6BB5\u6642\u9593\uFF01[VAR 0114(0024)]",
  "\u2026\u2026\u554A\uFF0C\u6211\u6240\u8B02\u7684\u76EE\u6A19\uFF0C\\n\u5C31\u662F\u5831\u7B54\u7C73\u83AB\u838E\u8001\u5E2B\uFF0C\\r\\n\u56E0\u70BA\u6211\u7E3D\u662F\u53D7\u5979\u7684\u7167\u9867\u3002[VAR 0114(0024)]",
  "\u5979\u4EBA\u4E0D\u4F46\u6EAB\u67D4\uFF0C\u624B\u53C8\u5DE7\uFF0C\\n\u662F\u6211\u61A7\u61AC\u7684\u5C0D\u8C61\uFF01[VAR 0114(0024)]",
  "\u70BA\u4E86\u548C\u5979\u8B8A\u5F97\u66F4\u89AA\u8FD1\uFF0C\\n\u6211\u624D\u6709\u6A23\u5B78\u6A23\u5730\u52AA\u529B\u78E8\u7DF4\u6599\u7406\u7684\u624B\u8155\u2026\u2026\\r\\n\u4F46\u4EBA\u679C\u7136\u9084\u662F\u5404\u6709\u6240\u9577\uFF01[VAR 0114(0024)]",
  "\u6D3B\u529B\u5145\u6C9B\u5C31\u662F\u6211\u7684\u512A\u9EDE\uFF01\\n\u6211\u6C7A\u5B9A\u8981\u5C08\u6CE8\u767C\u5C55\u9019\u4E00\u9EDE\u4E86\uFF01[VAR 0114(0024)]",
  "\u6211\u5728\u4E0A\u8AB2\u6642\u4E5F\u8AAA\u4E86\u4E0D\u662F\u55CE\uFF1F\\n\u2026\u2026\u4E0D\u8AD6\u662F\u4EBA\u985E\u6216\u5BF6\u53EF\u5922\u90FD\u4E00\u6A23\uFF0C\\r\\n\u8981\u5E6B\u4ED6\u597D\u597D\u767C\u5C55\u9577\u8655\u624D\u662F\uFF01[VAR 0114(0024)]",
  "\u6211\u4E5F\u53D7\u8F49\u5B78\u751F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7167\u9867\u4E86\uFF01\\n\u6536\u4E0B\u6211\u7684\u5FC3\u610F\u5427\uFF01[VAR 0114(0024)]",
  "\u597D\uFF0C\u4ECA\u5929\u6211\u8981\u600E\u9EBC\u4F86\\n\u88DC\u5145\u86CB\u767D\u8CEA\u597D\u5462\uFF01\uFF1F[VAR 0114(0024)]",
  "\u548C\u51F0\u6A97\u8001\u5E2B\u4E4B\u9593\u7684\\n\u727D\u7D46\u840C\u82BD\u4E86\uFF01"
