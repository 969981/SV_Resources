[
  "\u9019\u88E1\u662F\u6DF1\u7F3D\u93AE\u3002\\n\u662F\u5145\u6EFF\u82B1\u8349\u8207\u85DD\u8853\u7684\u57CE\u93AE\uFF01",
  "\u5411\u65E5\u82B1\u602A\u7684\u8868\u60C5\u770B\u8D77\u4F86\u597D\u60C6\u60B5\uFF01\\n\u4F5C\u8005\u662F\u5728\u4EC0\u9EBC\u6A23\u7684\u5FC3\u60C5\u4E0B\u5275\u4F5C\u7684\u5462\uFF1F",
  "\u6211\u548C\u5973\u53CB\u7D04\u5728\\n\u5947\u602A\u7684\u64FA\u8A2D\u524D\u9762\u6703\u5408\uFF01\\r\\n\u4F46\u662F\u5979\u4E00\u76F4\u9084\u6C92\u51FA\u73FE\uFF01",
  "\u6211\u548C\u7537\u53CB\u7D04\u5728\\n\u5947\u602A\u7684\u64FA\u8A2D\u524D\u9762\u6703\u5408\uFF0C\\r\\n\u4F46\u9019\u500B\u57CE\u93AE\u5947\u602A\u7684\u64FA\u8A2D\u5BE6\u5728\u592A\u591A\u4E86\u3002",
  "\u6DF1\u7F3D\u77E5\u540D\u666F\u9EDE\u2015\u2015\u8FF7\u5BAE\u904A\u6232\u5834\uFF01\\n\u5FEB\u4F86\u6311\u6230\u770B\u770B\u5594\u3002",
  "\u5230\u4E86\u6625\u5929\u7684\u6642\u5019\uFF0C\\n\u5411\u65E5\u7A2E\u5B50\u5C31\u6703\u4E58\u98A8\u98DB\u4F86\u3002",
  "\u54CE\u5440\uFF5E\\n\u9019\u500B\u4F5C\u54C1\u7684\u6982\u5FF5\u662F\u5F37\u8ABF\u5C0D\u6BD4\u554A\u3002\\r\\n\u6211\u60F3\u5916\u884C\u4EBA\u4E00\u5B9A\u770B\u4E0D\u51FA\u4F86\u5427\u3002",
  "\u6211\u662F\u4F86\u6B23\u8CDE\u9019\u500B\u77E5\u540D\u4F5C\u54C1\u7684\uFF01\\n\u96D6\u7136\u6211\u770B\u4E0D\u51FA\u500B\u6240\u4EE5\u7136\uFF0C\u4F46\u771F\u53B2\u5BB3\u554A\uFF01",
  "\u53C8\u662F\u4E00\u689D\u6B7B\u8DEF\u2026\u2026\\n\u55DA\uFF0C\u6211\u8FF7\u8DEF\u4E86\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7ADF\u7136\u80FD\u4F86\u5230\u9019\u88E1\uFF0C\\n\u7B97\u662F\u6709\u672C\u4E8B\uFF01\\c\\n\u6C92\u6709\u4EFB\u4F55\u4EBA\u80FD\u5230\u5F97\u4E86\u9019\u500B\u5730\u65B9\uFF0C\\n\u6240\u4EE5\u6211\u628A\u9019\u88E1\u7576\u4F5C\u79D8\u5BC6\u57FA\u5730\uFF01",
  "\u8981\u662F\u7D2F\u4E86\uFF0C\\n\u5C31\u7A0D\u5FAE\u505C\u4E0B\u8173\u6B65\u770B\u770B\u2026\u2026\\r\\n\u5982\u6B64\u4E00\u4F86\uFF0C\u4E5F\u6703\u6709\u4E00\u4E9B\u65B0\u7684\u767C\u73FE\u5427\u3002",
  "\u6211\u771F\u4E0D\u6562\u76F8\u4FE1\u5411\u65E5\u7A2E\u5B50\u9032\u5316\u4E4B\u5F8C\uFF0C\\n\u7ADF\u7136\u6703\u8B8A\u6210\u5411\u65E5\u82B1\u602A\u3002\\r\\n\u9032\u5316\u771F\u662F\u592A\uFF5E\u795E\u5947\u4E86\uFF01",
  "\u6211\u7684\u5750\u9A0E\u5BF6\u53EF\u5922\u5F88\u9177\u5427\uFF5E\uFF01\\c\\n\u6211\u6B63\u548C\u9019\u50A2\u4F19\u4E00\u8D77\u5230\\n\u5F88\u591A\u4E0D\u540C\u7684\u5730\u65B9\u65C5\u884C\u3002",
  "\u9019\u5C31\u662F\u5BC7\u6C99\u5927\u5E2B\u7684\u4F5C\u54C1\u554A\uFF01\\n\u4F46\u98A8\u683C\u4F3C\u4E4E\u6709\u4E9B\u4E0D\u592A\u4E00\u6A23\u2026\u2026",
  "\u6211\u6700\u559C\u6B61\u9AD8\u9AD8\u7684\u5730\u65B9\u4E86\uFF5E\uFF01\\c\\n\u807D\u8AAA\u93AE\u5916\u6709\u500B\u53EB\u505A\u77AD\u671B\u53F0\u7684\u5730\u65B9\uFF0C\\n\u90A3\u88E1\u5C31\u50CF\u662F\u5EA7\u9AD8\u5854\u4E00\u6A23\u5594\uFF01"
]
