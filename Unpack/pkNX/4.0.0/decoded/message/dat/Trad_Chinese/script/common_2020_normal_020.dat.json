[
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u548C\u6211\u5728\u56DB\u5929\u738B\u6230\u2026\u2026\\n\u5728\u6280\u80FD\u6E2C\u9A57\u6642\uFF0C\u5DF2\u7D93\u5C0D\u6230\u904E\u4E86\u3002[VAR 0114(0015)]",
  "\u9019\u6B21\u4EA4\u624B\u5927\u6982\u4E5F\u4E0D\u6703\u6709\u4EC0\u9EBC\\n\u4EE4[VAR 1100(00FF,0101)]\u4F60\u59B3\u7279\u5225\u611F\u6168\u7684\u3002\\r\\n\u4E0D\u904E\uFF0C\u5C31\u8ACB\u591A\u6307\u6559\u4E86\u3002[VAR 0114(0015)]",
  "\u9019\u6B21\u6211\u662F\u4F5C\u70BA\u9053\u9928\u9928\u4E3B\u5C0D\u6230\uFF0C\\n\u56E0\u6B64\u5C31\u8B93\u6211\u4F7F\u7528\u5E73\u6642\u7684\u5BF6\u53EF\u5922\u5427\u3002[VAR 0114(0015)]",
  "\u4E00\u822C\u5C6C\u6027\u2026\u2026\\n\u666E\u901A\u2026\u2026\u5C0B\u5E38\u2026\u2026\\r\\n\u5E73\u51E1\u2026\u2026\u6C92\u7279\u8272\u2026\u2026[VAR 0114(0015)]",
  "\u548C\u6211\u9019\u500B\u6C92\u500B\u6027\u7684\u4EBA\u5F88\u642D\uFF0C\\n\u8B93\u6211\u5C0D\u7260\u5011\u7279\u5225\u6709\u611F\u60C5\u3002[VAR 0114(0015)]",
  "\u4E0D\u8AD6\u662F\u4EBA\u985E\u6216\u662F\u5BF6\u53EF\u5922\uFF0C\\n\u90FD\u8A72\u66F4\u7C21\u55AE\u6613\u61C2\u5C31\u597D\u3002[VAR 0114(0015)]",
  "\u9019\u4E16\u754C\u4F3C\u4E4E\u662F\u8981\u641E\u602A\u624D\u7CBE\u5F69\uFF0C\\n\u8981\u65B0\u7A4E\u3001\u4E0D\u5C0B\u5E38\u624D\u80FD\u7372\u5F97\u8A55\u50F9\u3002[VAR 0114(0015)]",
  "\u4F46\u6BD4\u8D77\u6B61\u6A02\u7684\u65C5\u904A\u5730\uFF0C\u56DE\u5230\u4E86\\n\u81EA\u5DF1\u5BB6\u4E0D\u624D\u662F\u6700\u4EE4\u4EBA\u653E\u9B06\u7684\u55CE\uFF1F[VAR 0114(0015)]",
  "\u6C92\u932F\uFF0C\u7C21\u55AE\u5E73\u51E1\u624D\u662F\u6700\u5F37\u7684\u3002[VAR 0114(0015)]",
  "\u5C0D\u65BC\u6211\u9019\u500B\u5E73\u51E1\u4EBA\u4F86\u8AAA\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E36\u4F86\u7684\u523A\u6FC0\u592A\u5927\u4E86\u3002[VAR 0114(0015)]",
  "\u2026\u2026\u4F46\u6211\u597D\u50CF\u6709\u9EDE\u61C2\u4E86\u3002[VAR 0114(0015)]",
  "\u70BA\u4EC0\u9EBC\u6703\u8981\u6211\u5728\u64D4\u4EFB\u56DB\u5929\u738B\u6642\\n\u4F7F\u7528\u98DB\u884C\u5C6C\u6027\u3002[VAR 0114(0015)]",
  "\u5982\u679C\u5149\u662F\u8D70\u5728\u5E73\u5766\u7684\u8DEF\u4E0A\uFF0C\\n\u662F\u7121\u6CD5\u767C\u73FE\u67D0\u4E9B\u98A8\u666F\u7684\u2026\u2026[VAR 0114(0015)]",
  "\u5076\u723E\u4E5F\u5FC5\u9808\u62AC\u982D\u4EF0\u671B\u4E00\u4E0B\\n\u50CF[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u6A23\u9AD8\u98DB\u9060\u7FD4\u7684\u624D\u80FD\u3002[VAR 0114(0015)]",
  "\u7D14\u7CB9\u662F\u8AAA\uFF0C\u5982\u679C\u662F\u696D\u52D9\u6240\u9700\u6211\u5C31\u6703\u505A\u3002\\n\u4F46\u6211\u53EF\u4E0D\u6703\u7D66\u81EA\u5DF1\u627E\u9EBB\u7169\u3002[VAR 0114(0015)]",
  "\u4ECA\u5929\u662F\u6211\u7D55\u5C0D\u4E0D\u52A0\u73ED\u7684\u65E5\u5B50\u3002\\n\u5C31\u6B64\u5931\u966A\u4E86\u3002[VAR 0114(0015)]"
]
