[
  "\u71C8\u5854\u4E0A\u9762\u771F\u662F\u5B89\u975C\u3002\\n\u53EB\u505A\u96FB\u6D77\u71D5\u7684\u5BF6\u53EF\u5922\\r\\n\u6709\u6642\u5019\u4E5F\u6703\u4F86\u9019\u88E1\u4F11\u606F\u5594\u3002",
  "\u6211\u5728\u901A\u5F80\u9019\u88E1\u7684\u5761\u9053\u4E0A\u770B\u5230\u4E86\u6D1B\u6258\u59C6\uFF01\\n\u662F\u6C92\u6709\u9032\u5230\u624B\u6A5F\u88E1\u53BB\u7684\u55AE\u7D14\u7684\u6D1B\u6258\u59C6\u5594\uFF01",
  "\u6700\u5148\u9032\u7684\u57CE\u93AE\u7ADF\u7136\\n\u5F8C\u65B9\u5C31\u548C\u5927\u81EA\u7136\u76F8\u9023\u8457\uFF01\\r\\n\u771F\u662F\u8B93\u6211\u9019\u500B\u767B\u5C71\u5973\u5B69\u7684\u5FC3\u96C0\u8E8D\u4E0D\u5DF2\u554A\u3002",
  "\u5F9E\u4E0A\u9762\u770B\u904E\u53BB\u7684\u8A71\uFF0C\\n\u5E02\u5834\u4E5F\u6703\u8B8A\u5F97\u90A3\u9EBC\u5C0F\u554A\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u662F\u7A7F\u904E\u4E86\\n\u70D8\u70D8\u6C99\u6F20\u4F86\u7684\u55CE\uFF1F\\r\\n\u6709\u6C92\u6709\u770B\u5230\u5947\u602A\u7684\u5BF6\u53EF\u5922\uFF1F",
  "\u8981\u56DE\u73BB\u74F6\u5E02\u7684\u8A71\uFF0C\\n\u679C\u7136\u9084\u662F\u642D\u98DB\u7FD4\u8A08\u7A0B\u8ECA\u597D\u4E86\u3002",
  "\u6211\u5728\u62CD\u8CE3\u6703\u4E0A\u82B1\u4E86\u4E00\u5927\u7B46\u9322\u2026\u2026\\n\u6D77\u98A8\u8B93\u6211\u7684\u773C\u775B\u6709\u9EDE\u9178\u9178\u7684\uFF01",
  "\u5C0F\u5C0F\u7684\u72D7\u4ED4\u8EDF\u7DBF\u7DBF\u7684\uFF01\\n\u55EF\uFF5E\uFF01\u90A3\u5C31\u662F\u72D7\u4ED4\u5305\uFF01"
]
