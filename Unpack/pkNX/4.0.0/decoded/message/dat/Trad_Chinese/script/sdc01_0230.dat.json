[
  "\u9019\u8AAA\u4F86\u8A71\u9577\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u78BA\u5B9A\u8981\u807D\u55CE\uFF1F[VAR 0114(0030)]",
  "\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u807D\u7684\u6642\u5019\uFF0C\\n\u518D\u4F86\u544A\u8A34\u6211\u5427\u3002[VAR 0114(0030)]",
