  "\u563F\u563F\uFF0C\u7518\u62DC\u4E0B\u98A8\uFF5E\\n\u5BE6\u5728\u662F\u6253\u4E0D\u8D0F[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u5462\uFF5E[VAR 0114(002A)]",
