[
  "\u2026\u2026\u90A3\u96BB\u5BF6\u53EF\u5922\u597D\u50CF\\n\u4E0D\u6EFF\u8DB3\u4EA4\u63DB\u7684\u689D\u4EF6\uFF01",
  "\u807D\u8AAA\u53EB\u82B1\u84D3\u84D3\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u6BCF\u4E00\u96BB\u82B1\u7684\u984F\u8272\u90FD\u4E0D\u4E00\u6A23\uFF01\\c\\n\u4E0D\u7BA1\u662F\u4EC0\u9EBC\u984F\u8272\u7684\u82B1\u84D3\u84D3\u90FD\u597D\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u4E0D\u8981\u548C\u6211\u7684\u96EA\u541E\u87F2\u4EA4\u63DB\uFF1F",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u7528\u90A3\u96BB\u82B1\u84D3\u84D3\u8DDF\u6211\u4EA4\u63DB\u55CE\uFF1F",
  "\u54CE\u5440\uFF5E\u592A\u53EF\u60DC\u4E86\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u662F\u6539\u8B8A\u5FC3\u610F\u4E86\uFF0C\u518D\u62DC\u8A17\u56C9\uFF01",
  "\u54C7\uFF0C\u597D\u5C0F\u554A\u2026\u2026\uFF01\u8D85\u53EF\u611B\u7684\u2026\u2026\uFF01\\n\u554A\uFF0C\u7260\u9084\u5750\u5728\u82B1\u4E0A\u9762\u2026\u2026\u55EF\uFF01\\c\\n\u2026\u2026\u547C\uFF01\u96EA\u541E\u87F2\u7684\u53EF\u611B\u7A0B\u5EA6\u4E5F\u4E0D\u8F38\u82B1\u84D3\u84D3\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u597D\u597D\u73CD\u60DC\u7260\u5594\u3002",
  "\u82B1\u84D3\u84D3\u771F\u662F\u592A\u53EF\u611B\u4E86\u2026\u2026\uFF01\\c\\n\u6211\u53BB\u628A\u5404\u7A2E\u984F\u8272\u7684\u82B1\u84D3\u84D3\\n\u90FD\u7D66\u6349\u8D77\u4F86\u597D\u4E86\uFF01",
  "\u5BF6\u53EF\u5922\u53EA\u6709\uFF11\u96BB\u7684\u8A71\uFF0C\\n\u662F\u4E0D\u80FD\u4EA4\u63DB\u7684\uFF01\\c\\n\u6709\uFF12\u96BB\u4EE5\u4E0A\u540C\u884C\u5BF6\u53EF\u5922\u7684\u8A71\uFF0C\\n\u518D\u9EBB\u7169[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF01",
  "\u5C0F\u7531\u5409",
  "\u5F7C\u52A0\u592A\u6717",
  "\u807D\u8AAA\u5E15\u5E95\u4E9E\u7684\u70CF\u6CE2\u6709\u6BD2\uFF0C\\n\u90A3\u662F\u771F\u7684\u55CE\uFF1F\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u7684\u8A71\uFF0C\u8DDF\u6211\u5728\u5176\u4ED6\u5730\u5340\\n\u6349\u5230\u7684\u85CD\u8272\u7684\u70CF\u6CE2\u4EA4\u63DB\u5427\uFF01",
  "\u54C7\uFF0C\u90A3\u96BB\u70CF\u6CE2\u7684\u984F\u8272\u597D\u6DF1\u554A\u2026\u2026\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u7528\u90A3\u96BB\u70CF\u6CE2\u8DDF\u6211\u4EA4\u63DB\u55CE\uFF1F",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5982\u679C\u60F3\u4F86\u4E00\u5834\u70CF\u6CE2\u548C\u70CF\u6CE2\u7684\u4EA4\u63DB\u6703\uFF0C\\n\u5C31\u4F86\u627E\u6211\u5594\uFF01",
  "\u7260\u771F\u7684\u662F\u6BD2\u5C6C\u6027\u7684\uFF01\\n\u6709\u6BD2\u7684\u70CF\u6CE2\u597D\u53EF\u611B\uFF5E\uFF01\\c\\n\u85CD\u8272\u7684\u70CF\u6CE2\u7576\u7136\u4E5F\u5F88\u68D2\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u597D\uFF5E\u597D\u5730\u7167\u9867\u7260\u5594\uFF01",
  "\u662F\u5E15\u5E95\u4E9E\u7684\u6A23\u5B50\u7684\u70CF\u6CE2\uFF01\\n\u7260\u773C\u775B\u9589\u8457\u7684\u6642\u5019\u6703\u5F80\u4E0B\u5782\uFF0C\u597D\u53EF\u611B\u5594\uFF5E\uFF01\\c\\n\u5373\u4F7F\u662F\u76F8\u540C\u7684\u5BF6\u53EF\u5922\uFF0C\u6309\u7167\u5730\u5340\u7260\u7684\\n\u6A23\u5B50\u6216\u5C6C\u6027\u6703\u4E0D\u4E00\u6A23\uFF0C\u771F\u7684\u5F88\u6709\u8DA3\u5462\uFF01",
  "\u54A6\uFF1F\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EA\u6709\uFF11\u96BB\u5BF6\u53EF\u5922\u5440\uFF1F\\c\\n\u8981\u4EA4\u63DB\u7684\u8A71\uFF0C\\n\u898F\u5B9A\u540C\u884C\u7684\u5BF6\u53EF\u5922\u4E00\u5B9A\u8981\u6709\uFF12\u96BB\u4EE5\u4E0A\u5594\uFF01",
  "\u771F\u84BC",
  "\u5F69\u7F8E",
  "\u6211\u6C92\u6709\u6703\u300C\u5750\u9A0E\u62DB\u5F0F\uFF1A\u885D\u6D6A\u300D\u7684\u5B69\u5B50\uFF0C\\n\u6240\u4EE5\u898B\u4E0D\u5230\u6D77\u88E1\u7684\u5BF6\u53EF\u5922\uFF5E\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u662F\u6709\u556A\u5693\u6D77\u81BD\u7684\u8A71\uFF0C\\n\u8DDF\u6211\u7684\u9B3C\u65AF\u901A\u4EA4\u63DB\u5427\uFF5E",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u7528\u90A3\u96BB\u556A\u5693\u6D77\u81BD\u8DDF\u6211\u4EA4\u63DB\u55CE\uFF1F",
  "\u5475\u5475\u5475\u2026\u2026[VAR 1100(00FF,0101)]\u4F60\u59B3\u6539\u8B8A\u5FC3\u610F\u4E86\u55CE\uFF5E\uFF1F\\n\u6709\u6642\u5019\u4EBA\u751F\u662F\u9700\u8981\u4E00\u4E9B\u5927\u81BD\u7684\u6C7A\u5B9A\u7684\u3002",
  "\u54CE\u5440\uFF5E\u667A\u7F8E\uFF5E\\n\u4F60\u9032\u5316\u6210\u803F\u9B3C\u4E86\u5440\uFF5E\uFF01\uFF1F\\c\\n\u807D\u8AAA\u6709\u5BF6\u53EF\u5922\u5728\u4EA4\u63DB\u4E4B\u5F8C\u5C31\u6703\u9032\u5316\uFF5E\\n\u539F\u4F86\u9019\u662F\u771F\u7684\u5440\uFF5E",
  "\u6211\u7684\u667A\u7F8E\u7260\u904E\u5F97\u9084\u597D\u55CE\uFF1F\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u556A\u5693\u6D77\u81BD\u53EF\u662F\\n\u556A\u5693\u556A\u5693\u5730\u5F88\u6709\u6D3B\u529B\u5462\uFF5E",
  "\u53EA\u6709\uFF11\u96BB\u5BF6\u53EF\u5922\u7684\u8A71\uFF0C\\n\u662F\u4E0D\u80FD\u4EA4\u63DB\u7684\u5594\uFF5E\uFF01\\c\\n\u5475\u5475\u5475\u2026\u2026\\n\u540C\u884C\u7684\u5BF6\u53EF\u5922\u6709\uFF12\u96BB\u4EE5\u4E0A\u6642\u518D\u62DC\u8A17\u56C9\uFF5E\uFF01",
