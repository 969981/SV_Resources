  "\u5C0D\u4E86\uFF0C\\n\u6211\u5DEE\u9EDE\u5FD8\u4E86\u9084\u6709\u5236\u670D\u5462\uFF01\\r\\n\u63DB\u4E0A\u5236\u670D\uFF0C\u5C55\u73FE\u6E3E\u8EAB\u85CD\u8393\u5473\u5427\uFF01[VAR 0114(004B)]",
