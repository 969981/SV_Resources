  "\u597D\u6709\u578B\u554A\uFF5E\uFF01\\n\u9019\u500B\u4E5F\u9806\u4FBF\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\u3002[VAR 0114(004B)]",
  "\u5728\u5E15\u5E95\u4E9E\u7684\u6642\u88DD\u5E97\u548C\u7F8E\u5BB9\u9662\u88E1\\n\u53EF\u4EE5\u9078\u64C7\u7684\u9078\u9805\u6703\u8B8A\u591A\u5594\uFF5E[VAR 0114(004B)]",
  "\u90A3\u9EBC\uFF0C\u61F7\u8457\u5168\u65B0\u7684\u5FC3\u60C5\uFF0C\\n\u63A5\u4E0B\u4F86\u6211\u5011\u5230\u5B78\u5712\u88E1\u770B\u770B\u54AF\u3002[VAR 0114(0049)]",
  "\u8981\u5728\u5B78\u5712\u88E1\u79FB\u52D5\u7684\u6642\u5019\uFF0C\\n\u53EF\u4EE5\u5F9E\u90A3\u908A\u7684\u9598\u9580\u9078\u64C7\u76EE\u7684\u5730\u3002[VAR 0114(0049)]",
  "\u8B93\u6211\u4F86\u4ECB\u7D39\u85CD\u8393\u5B78\u5712\\n\u7368\u6B65\u5168\u4E16\u754C\u7684[VAR FF00(0006)]\u751F\u614B\u5DE8\u86CB[VAR FF00(0000)]\u5427\uFF01[VAR 0114(0049)]",
  "\u63A5\u4E0B\u4F86\u5C31\u5F9E\u9598\u9580\u524D\u5F80\\n[VAR FF00(0006)]\u751F\u614B\u5DE8\u86CB[VAR FF00(0000)]\u5427\uFF01[VAR 0114(0049)]",
  "\u54CE\u5440\uFF5E[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u5F37\u554A\uFF5E\\n\u9F8D\u982D\u5730\u9F20\u5176\u5BE6\u901F\u5EA6\u610F\u5916\u5730\u5FEB\uFF0C\\r\\n\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u61C9\u4ED8\u5F97\u5F88\u597D\u5462\u3002[VAR 0114(004B)]"
