[
  "\u9019\u88E1\u5C31\u662F\u85CD\u8393\u5B78\u5712\u7684\u5165\u53E3\uFF0C\\n\u7A7F\u5802\u5927\u5EF3\u3002[VAR 0114(0049)]",
  "\u85CD\u8393\u5B78\u5712\u7279\u5225\u6CE8\u91CD\\n\u5BF6\u53EF\u5922\u5C0D\u6230\u3002[VAR 0114(0049)]",
  "\u773C\u524D\u7684\u9019\u7247\u4E2D\u592E\u5C0D\u6230\u5834\\n\u6703\u7528\u4F86\u8209\u8FA6\u5B78\u5712\u7684\u5B98\u65B9\u6230\u7B49\uFF0C\\r\\n\u4F46\u5728\u6C92\u6709\u8CFD\u4E8B\u7684\u6642\u5019\u53EF\u4EE5\u81EA\u7531\u4F7F\u7528\u3002[VAR 0114(0049)]",
  "\u6211\u76F8\u4FE1\u9019\u88E1\u6BD4\u8D77\u5176\u4ED6\u7684\u5B78\u6821\uFF0C\\n\u4E00\u5B9A\u6709\u66F4\u591A\u7684\u6A5F\u6703\u8B93\u5BF6\u53EF\u5922\u5C0D\u6230\uFF01[VAR 0114(0049)]",
  "\u6C92\u932F\u6C92\u932F\uFF01\u5C31\u662F\u9019\u6A23\uFF5E[VAR 0114(004B)]",
  "\u5E2D\u85CD\u6821\u9577\u5728\u65C1\u908A\uFF0C\\n\u8B93\u6211\u6709\u9EDE\u2026\u2026\u7D81\u624B\u7D81\u8173\u7684\u5462\u3002[VAR 0114(0049)]",
  "\u6D77\u98A8\u5439\u8D77\u4F86\u5F88\u8212\u670D\uFF0C\\n\u6240\u4EE5\u6C92\u6709\u5C0D\u6230\u7684\u6642\u5019\uFF0C\\r\\n\u89C0\u773E\u5E2D\u5C31\u6210\u4E86\u5B78\u751F\u5011\u4F11\u606F\u7684\u5730\u65B9\u3002[VAR 0114(0049)]",
  "\u9084\u6709\u9084\u6709\uFF0C\\n\u672C\u6821\u6709\u4E00\u500B\u9A5A\u4EBA\u7684\u7279\u9EDE\u2026\u2026[VAR 0114(0049)]",
  "\u5C31\u662F\u9019\u88E1\u6709\u6703\u592A\u6676\u5316\u7684\\n\u91CE\u751F\u5BF6\u53EF\u5922\uFF01[VAR 0114(0049)]",
  "\u4EC0\u9EBC\uFF01",
  "\u662F\u55CE\u2026\u2026",
  "\u554A\uFF0C\u9019\u5728\u5E15\u5E95\u4E9E\\n\u662F\u7A00\u9B06\u5E73\u5E38\u7684\u4E8B\uFF0C\u662F\u5427\u3002[VAR 0114(0049)]",
  "\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u88AB\u767C\u73FE\u7684\u73FE\u8C61\uFF0C\\n\u592A\u6676\u5316\u2026\u2026[VAR 0114(004B)]",
  "\u5728\u592A\u6676\u73E0\u8A95\u751F\u4E4B\u5F8C\uFF0C\\n\u9019\u500B\u5B78\u5712\u767C\u660E\u4E86\\r\\n\u80FD\u5920\u63A7\u5236\u592A\u6676\u6A5F\u5236\u7684\u6280\u8853\u5594\uFF5E[VAR 0114(004B)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u5B9A\u5F88\u597D\u5947\\n\u90A3\u662F\u600E\u9EBC\u8FA6\u5230\u7684\u5427\uFF5E\uFF1F[VAR 0114(004B)]",
  "\u6821\u9577\uFF01\u95DC\u65BC\u90A3\u90E8\u5206\uFF0C\\n\u7B49\u4E0B\u53BB\u4E4B\u5F8C\u518D\u8AAA\u660E\u6703\u6BD4\u8F03\u597D\u61C2\uFF0C\\r\\n\u6240\u4EE5\u8ACB\u4F60\u7A0D\u5F8C\u518D\u8AAA\u5427\uFF01[VAR 0114(0049)]",
  "\u59B3\u8003\u616E\u5F97\u771F\u662F\u5468\u5230\u554A\uFF5E[VAR 0114(004B)]",
  "\u5C0D\u4E86\uFF0C\u6211\u60F3\u5230\u4E00\u500B\u597D\u4E3B\u610F\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5011\u5006\uFF5E\u6253\u5834\u5C0D\u6230\u5427\uFF5E\uFF01[VAR 0114(004B)]",
  "\u4EC0\u9EBC\uFF1F\u73FE\u5728\u55CE\uFF01\uFF1F[VAR 0114(0049)]",
  "\u55EF\uFF0C\u6211\u4E5F\u60F3\u770B\u770B\\n[VAR 0100(0000)]\u7684\u5BE6\u529B\u3002[VAR 0114(004B)]",
  "\u7D2B\u7AFD\u5152\u5979\u554A\uFF5E\u662F\u806F\u76DF\u793E\u7684\u56DB\u5929\u738B\uFF0C\\n\u6211\u76F8\u4FE1[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u5B9A\u6703\u6709\u6536\u7A6B\u7684\u3002\\r\\n\u800C\u4E14\u5979\u7684\u7236\u89AA\u9084\u662F\u5408\u773E\u7684\u9053\u9928\u9928\u4E3B\u5462\uFF5E[VAR 0114(004B)]",
  "\u554A\uFF0C\u64C5\u81EA\u6D29\u9732\\n\u6211\u7684\u500B\u4EBA\u8CC7\u6599\u2026\u2026[VAR 0114(0049)]",
  "\u6211\u89BA\u5F97\u90A3\u662F\u4E0D\u597D\u7684\uFF01[VAR 0114(0049)]",
  "\u6211\u6703\u5728\u982D\u7B49\u5E2D\u89C0\u8CDE\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5011\u5006\u7684\u5C0D\u6230\u7684\uFF5E[VAR 0114(004B)]",
  "\u62B1\u6B49\u2026\u2026\u5E2D\u85CD\u6821\u9577\u4ED6\u554A\uFF0C\\n\u8A71\u53EA\u8981\u8AAA\u51FA\u53E3\uFF0C\u5C31\u807D\u4E0D\u9032\u4EFB\u4F55\u610F\u898B\u4E86\u3002[VAR 0114(0049)]",
  "\u2026\u2026\u8A71\u96D6\u5982\u6B64\uFF0C\\n\u6211\u4E5F\u6709\u9EDE\u8208\u596E\u5462\uFF01[VAR 0114(0049)]",
  "\u5728\u85CD\u8393\u5B78\u5712\uFF0C\\n\u96D9\u6253\u5C0D\u6230\u662F\u4E3B\u6D41\uFF01\\r\\n\u9019\u5834\u4EA4\u6D41\u5C0D\u6230\uFF0C\u4E00\u8D77\u52A0\u6CB9\u54AF\uFF01[VAR 0114(0049)]",
  "\u597D\u53B2\u5BB3\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u6709\u5169\u4E0B\u5B50\u3002\\n\u592A\u6676\u5316\u7684\u7528\u6CD5\u597D\u9053\u5730\uFF01\\r\\n\u592A\u8B93\u6211\u4F69\u670D\u4E86\uFF01[VAR 0114(0049)]",
  "\u597D\u53B2\u5BB3\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u6709\u5169\u4E0B\u5B50\u3002\\n\u4E0D\u904E\uFF0C\u6211\u539F\u672C\u4E5F\u5F88\u60F3\u898B\u8B58\u4E00\u4E0B\u2026\u2026\\r\\n\u592A\u6676\u5316\u7684\u9053\u5730\u7528\u6CD5\u7684\u3002[VAR 0114(0049)]",
  "\u592A\u597D\u4E86\uFF0C\u6211\u8D0F\u4E86\u3002\\n\u2026\u2026\u771F\u662F\u4E00\u5834\u767D\u71B1\u5316\u7684\u5C0D\u6230\u5462\uFF01[VAR 0114(0049)]",
  "\u85CD\u8393\u5B78\u5712\u6700\u8FD1\u624D\u958B\u59CB\\n\u767C\u653E\u592A\u6676\u73E0\u7D66\u5B78\u751F\uFF0C\\r\\n\u6211\u5E0C\u671B[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u5206\u4EAB\u4F7F\u7528\u65B9\u6CD5\u7684\u8A23\u7AC5\u3002[VAR 0114(0049)]",
