[
  "\u5C0F\u751F\u662F\u8CA0\u8CAC\u7F8E\u8853\u7684\u516B\u6714\u3002\\n\u8ACB\u591A\u6307\u6559\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u2026\u2026\u8AAA\u5230\u4F55\u8B02\u7F8E\u8853\uFF01[VAR 0114(0012)]",
  "\u5728\u5EA7\u5927\u591A\u6578\u7684\u4EBA\u5728\u7562\u696D\u5F8C\uFF0C\\n\u5927\u6982\u90FD\u6703\u5C07\u9019\u5802\u8AB2\u6240\u6559\u7684\u77E5\u8B58\\r\\n\u5FD8\u5F97\u7CBE\u5149\u5427\uFF01[VAR 0114(0012)]",
  "\u7562\u7ADF\u5728\u8003\u8A66\u6216\u6C42\u8077\u6642\uFF0C\\n\u662F\u4E0D\u6703\u8981\u6C42\u7F8E\u8853\u77E5\u8B58\u6216\u7F8E\u611F\u7684\u3002[VAR 0114(0012)]",
  "\u9019\u9EBC\u8AAA\u4F86\uFF0C\u5C0F\u751F\u9019\u5802\u8AB2\\n\u9664\u4E86\u6D6A\u8CBB\u6642\u9593\u4E4B\u5916\u6BEB\u7121\u610F\u7FA9\u55CE\uFF1F[VAR 0114(0012)]",
  "\u2026\u2026\u4E00\u5B9A\u4E0D\u662F\u3002\\n\u5C0F\u751F\u5E0C\u671B\u4E0D\u662F\u3002[VAR 0114(0012)]",
  "\u5404\u4F4D\u540C\u5B78\u8ACB\u601D\u8003\u4E00\u4E0B\uFF0C\\n\u300C\u7F8E\u9E97\u300D\u8207\u300C\u4E0D\u7F8E\u9E97\u300D\u7684\u5DEE\u5225\\r\\n\u7A76\u7ADF\u5728\u54EA\u88E1\u5462\uFF1F[VAR 0114(0012)]",
  "\u984F\u8272\u8207\u5F62\u72C0",
  "\u56E0\u4EBA\u800C\u7570",
  "\u4E0D\u77E5\u9053",
  "\u55EF\uFF0C\u539F\u4F86\u5982\u6B64\u2026\u2026\\n[VAR 0100(0000)]\u540C\u5B78\u9019\u9EBC\u8A8D\u70BA\u662F\u5427\u3002[VAR 0114(0012)]",
  "\u4E0D\uFF0C\u5225\u5728\u610F\uFF0C\\n\u9019\u4E26\u6C92\u6709\u6B63\u78BA\u7B54\u6848\u7684\u3002\\r\\n\u91CD\u8981\u7684\u662F\u8981\u5404\u4F4D\u53BB\u601D\u8003\u3002[VAR 0114(0012)]",
  "\u4F8B\u5982\u70BA\u4EC0\u9EBC\u770B\u5230\u8DEF\u65C1\u7DBB\u653E\u7684\u82B1\u6735\u6642\uFF0C\\n\u6703\u611F\u5230\u5B83\u5F88\u7F8E\u9E97\u3002[VAR 0114(0012)]",
  "\u5929\u7A7A\u7684\u85CD\u8207\u5927\u6D77\u7684\u85CD\uFF0C\u5DEE\u5225\u5728\u54EA\u88E1\uFF1F\\n\u70BA\u4EC0\u9EBC\u6A39\u6728\u6703\u96A8\u5B63\u7BC0\u8B8A\u63DB\u8272\u5F69\uFF1F\\r\\n\u6DF1\u7F3D\u93AE\u98A8\u8ECA\u7684\u8F49\u52D5\u2026\u2026\\r\\n\u73BB\u74F6\u5E02\u6C34\u6D41\u7684\u51B7\u51BD\u2026\u2026[VAR 0114(0012)]",
  "\u85C9\u7531\u601D\u8003\uFF0C\u6211\u5011\u80FD\u5920\u66F4\u9BAE\u660E\u3001\u66F4\u6DF1\u523B\u5730\\n\u53BB\u611F\u53D7\u5B58\u5728\u65BC\u8EAB\u65C1\u7684\u6240\u6709\u4E8B\u7269\u3002[VAR 0114(0012)]",
  "\u90A3\u4E00\u5B9A\u80FD\u5920\u5728\u5404\u4F4D\u8B80\u66F8\u8B80\u7D2F\u6642\uFF0C\\n\u6216\u5728\u5DE5\u4F5C\u9047\u4E0A\u96E3\u95DC\u6642\u2026\u2026[VAR 0114(0012)]",
  "\u6210\u70BA\u5F9E\u80CC\u5F8C\u8F15\u8F15\\n\u9F13\u52F5\u5404\u4F4D\u7684\u4E00\u80A1\u52A9\u529B\u3002[VAR 0114(0012)]",
  "\u2026\u2026\u4ECA\u5929\u7684\u5167\u5BB9\u6709\u9EDE\u6DF1\u5967\uFF0C\\n\u5404\u4F4D\u807D\u4E0D\u61C2\u4E5F\u6C92\u6709\u95DC\u4FC2\u7684\u3002[VAR 0114(0012)]",
  "\u7E3D\u4E4B\uFF0C\u4F55\u8B02\u7F8E\u8853\uFF01\\n\u4EBA\u751F\u53EF\u4EE5\u6C92\u6709\u5B83\uFF0C\u4F46\u662F\\r\\n\u6709\u5B83\u76F8\u4F34\u80AF\u5B9A\u6703\u66F4\u8C50\u5BCC\u5FEB\u6A02\uFF01[VAR 0114(0012)]",
  "\u8981\u662F\u7F8E\u8853\u80FD\u5920\u70BA\u5404\u4F4D\u7684\u751F\u6D3B\\n\u589E\u6DFB\u4E00\u4E9B\u8272\u5F69\uFF0C\u5C0F\u751F\u6703\u611F\u5230\u5F88\u559C\u6085\u7684\u3002[VAR 0114(0012)]",
  "\u4E0B\u4E00\u5802\u8AB2\u8D77\uFF0C\u5C31\u8B93\u6211\u5011\u66F4\u5BE6\u969B\u5730\\n\u53BB\u63A5\u89F8\u4F55\u8B02\u7F8E\u9E97\u5427\uFF01\u4E0B\u8AB2\uFF01[VAR 0114(0012)]"
]
