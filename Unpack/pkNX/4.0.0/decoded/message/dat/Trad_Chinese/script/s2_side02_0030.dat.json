  "\u50B3\u8AAA\u90A3\u5B69\u5B50\u53EA\u8981\u7529\u4E00\u4E0B\u8116\u5B50\uFF0C\\n\u5929\u7A7A\u5C31\u6703\u70CF\u96F2\u5BC6\u5E03\uFF0C\u843D\u96F7\u4E0D\u65B7\uFF01[VAR 0114(0046)]",
  "\u662F\u771F\u6B63\u7684\u9435\u982D\u6BBC\uFF01\\n\u9084\u771F\u662F\u2026\u2026\u5149\u4EAE\u5F97\u4E0D\u5F97\u4E86\u554A\uFF01[VAR 0114(0046)]",
