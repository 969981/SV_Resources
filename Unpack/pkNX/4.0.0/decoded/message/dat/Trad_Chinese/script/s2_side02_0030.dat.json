  "\u7260\u5011\u4F3C\u4E4E\u5C31\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u7684\u67D0\u500B\u5730\u65B9\u5462\uFF01\\n\u6211\u671F\u5F85[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8ABF\u67E5\u7D50\u679C\u5594\uFF01[VAR 0114(0046)]",
  "\u4E0D\u7528\u770B\u7167\u7247\u4E5F\u6C92\u554F\u984C\uFF1F\\n[VAR 0100(0000)]\uFF0C\u771F\u4E0D\u6127\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u5462\uFF5E\uFF01[VAR 0114(0046)]",
  "\u4E0D\u7528\u770B\u7167\u7247\u4E5F\u6C92\u554F\u984C\uFF1F\\n[VAR 0100(0000)]\uFF0C\u771F\u4E0D\u6127\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u5462\uFF5E\uFF01[VAR 0114(0046)]",
  "\u54A6\uFF1F[VAR 0100(0000)]\uFF0C\\n\u90A3\u96BB\u5BF6\u53EF\u5922\u662F\u2026\u2026\u90A3\u5F35\u7167\u7247\u88E1\u7684\uFF01\uFF1F[VAR 0114(0046)]",
