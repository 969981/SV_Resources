  "\u54CE\u5440\uFF5E\u4E16\u754C\u4E0A\u9084\u6709\u5F88\u591A\\n\u6211\u5011\u4E0D\u77E5\u9053\u7684\u4E8B\u7269\u5462\u3002[VAR 0114(0046)]",
