[
  "\u2026\u2026\u55DA\u55DA\uFF0C\u597D\u51B7\u3002[VAR 0114(001A)]",
  "\u9019\u88E1\u7684\u51B7\u6C23\u4E5F\u958B\u5F97\u592A\u51B7\u4E86\u5427\u3002[VAR 0114(001A)]",
  "\u539F\u4F86\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EB\u6211\u4F86\u7684\uFF1F[VAR 0114(001A)]",
