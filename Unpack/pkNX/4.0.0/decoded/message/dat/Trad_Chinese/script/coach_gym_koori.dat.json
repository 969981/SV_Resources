  "\u5F88\u597D\u5440\uFF01",
  "\u611F\u89BA\u5982\u4F55\uFF1F",
  "\u5443\uFF0C\u96EA\u7684\u72C0\u614B\u662F\u5F88\u597D\u3002\\n\u55EF\u2026\u2026\u5F88\u597D\u3002[VAR 0114(001A)]",
  "\u597D\u4E45\u6C92\u6709\u6ED1\u96EA\uFF0C\\n\u9023\u6211\u90FD\u89BA\u5F97\u81EA\u5DF1\u592A\u71B1\u8877\u4E86\u3002[VAR 0114(001A)]",
  "\u5176\u5BE6\u6211\u672C\u4F86\u6253\u7B97\\n\u4E0D\u518D\u7AD9\u4E0A\u6ED1\u96EA\u677F\u4E86\u2026\u2026[VAR 0114(001A)]",
  "\u4F46\u50C5\u9650\u5728\u6211\u4F86\u9019\u88E1\u7684\u671F\u9593\u7684\u8A71\uFF0C\\n\u89E3\u7981\u4E00\u4E0B\u61C9\u8A72\u4E5F\u6C92\u95DC\u4FC2\u5427\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u62B1\u6B49\u5566\uFF0C\\n\u6211\u7684\u610F\u5FD7\u529B\u5C31\u662F\u9019\u9EBC\u8584\u5F31\u3002[VAR 0114(001A)]",
  "\u65E2\u7136\u5DF2\u7D93\u9019\u9EBC\u51B7\u4E86\uFF0C\\n\u6211\u5011\u4F86\u505A\u4E9B\u66F4\u6703\u51B7\u5834\u7684\u4E8B\u5427\u3002[VAR 0114(001A)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u4E0D\u8981\u548C\u6211\\n\u4EA4\u63DB\u5BF6\u53EF\u5922\u770B\u770B\uFF1F[VAR 0114(001A)]",
  "\u771F\u7684\u8981\u4EA4\u63DB\u554A\uFF1F\\n\u90A3\u6211\u5C31\u7528\u8D70\u9BE8\u4F86\u4EA4\u63DB\u5427\uFF0C\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5462\uFF1F[VAR 0114(001A)]",
  "[VAR 0101(0001)]\u662F\u55CE\uFF0C\\n\u55EF\u2026\u2026\u4E0D\u932F\u3002\\c\\n\u65E2\u7136\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u8A17\u4ED8\u7D66\u6211\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u6211\u6703\u597D\u597D\u57F9\u80B2\uFF0C\u4E0D\u6703\u8B93\u7260\u51B7\u6389\u7684\u3002[VAR 0114(001A)]",
  "\u90A3\u5C31\u7528[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684[VAR 0101(0001)]\\n\u548C\u6211\u7684\u8D70\u9BE8\u4EA4\u63DB\u56C9\u3002[VAR 0114(001A)]",
  "\u521D\u8A13\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
  "\u7A00\u6709\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
  "\u7570\u8272\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
  "\u53EA\u6709\uFF11\u96BB\u5BF6\u53EF\u5922\u4E5F\u592A\u51B7\u4E86\uFF0C\\n\u9019\u6A23\u4E0D\u80FD\u4EA4\u63DB\u3002\\c\\n\u81F3\u5C11\u4E5F\u8981\u5E36\uFF12\u96BB\u4EE5\u4E0A\u7684\\n\u5BF6\u53EF\u5922\u540C\u884C\u624D\u53EF\u4EE5\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u53EA\u662F\u958B\u500B\u73A9\u7B11\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5225\u5728\u610F\u3002[VAR 0114(001A)]",
  "\u8981\u4E0D\u8981\u505A\u4E9B\u6703\u51B7\u5834\u7684\u4E8B\uFF1F\\n\u50CF\u662F\u548C\u6211\u4EA4\u63DB\u5BF6\u53EF\u5922\u4E4B\u985E\u7684\u3002[VAR 0114(001A)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u90A3\u526F\u8868\u60C5\u2026\u2026\\n\u662F\u60F3\u548C\u6211\u5C0D\u6230\u55CE\uFF1F[VAR 0114(001A)]",
  "\u653E\u68C4\u662F\u6B63\u78BA\u7684\u9078\u64C7\u3002[VAR 0114(001A)]",
  "\u597D\u51B7\u7684\u56DE\u7B54\u2026\u2026\\n\u4F46\u5076\u723E\u9019\u6A23\u4E5F\u884C\u5427\u3002[VAR 0114(001A)]",
  "[~ 59]",
  "\u2026\u2026\u5FB9\u5E95\u8F38\u4E86\u3002\\n\u73FE\u5BE6\u771F\u662F\u51B7\u9177\u5462\u3002[VAR 0114(001A)]",
  "\u4F46\u662F\u6211\u5F88\u958B\u5FC3\uFF0C\\n\u4E5F\u7B97\u662F\u7372\u5F97\u4E86\u4E9B\u6771\u897F\u3002[VAR 0114(001A)]",
  "\u9019\u662F\u6557\u8005\u9001\u7D66\u52DD\u8005\u7684\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u62FF\u53BB\u5427\u3002[VAR 0114(001A)]",
  "\u5982\u679C\u4E0D\u9700\u8981\u7684\u8A71\u5C31\u4E1F\u6389\u5427\u3002[VAR 0114(001A)]",
  "[~ 59]",
  "\u770B\u4F86[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u7684\\n\u5F88\u559C\u6B61\u6253\u6557\u6211\u5462\u3002[VAR 0114(001A)]",
  "\u4E0B\u6B21\u518D\u6230\u7684\u6642\u5019\uFF0C\\n\u6211\u4E0D\u6703\u4EA4\u51FA\u51B0\u51B7\u7684\u6210\u7E3E\u55AE\u7684\u3002[VAR 0114(001A)]",
  "\u5C31\u7B97\u6253\u8D0F\u653E\u6C34\u7684[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\\n\u6211\u4E5F\u4E00\u9EDE\u90FD\u9AD8\u8208\u4E0D\u8D77\u4F86\u3002\\r\\n\u4E0B\u6B21[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u8981\u62FF\u51FA\u771F\u672C\u4E8B\u4F86\u3002[VAR 0114(001A)]",
  "\u6211\u4E0D\u64C5\u9577\u8DDF\u5B78\u751F\u76F8\u8655\u2026\u2026\\n\u60F3\u5230\u4ED6\u5011\u5C07\u4F86\u53EF\u80FD\u6703\u906D\u9047\u632B\u6298\uFF0C\\r\\n\u6211\u5C31\u4E0D\u5FCD\u5FC3\u76F4\u8996\u4ED6\u5011\u3002[VAR 0114(001A)]",
  "\u6211\u5728\u9019\u88E1\u4E5F\u7B97\u662F\\n\u5C0F\u6709\u540D\u6C23\u7684\u6A23\u5B50\u3002\\c\\n\u7E8F\u8457\u6211\u62CD\u96D9\u4EBA\u5408\u7167\u7684\u4EBA\\n\u6709[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u500B\u5C31\u5F88\u5920\u4E86\u3002[VAR 0114(001A)]",
  "\u9019\u88E1\u7684\u7A7A\u8ABF\\n\u679C\u7136\u9084\u662F\u592A\u51B7\u4E86\u5427\uFF1F\\r\\n\u6211\u8A72\u53BB\u627E\u8AB0\u624D\u80FD\u8ABF\u9AD8\u6EAB\u5EA6\uFF1F[VAR 0114(001A)]",
  "[VAR 0101(0001)]\u7684\u72C0\u6CC1\u5F88\u597D\uFF0C\\n\u548C\u6211\u7684\u5BF6\u53EF\u5922\u76F8\u8655\u5F97\u5F88\u878D\u6D3D\u3002\\r\\n\u2026\u2026\u73FE\u5728\u770B\u4F86\u53EF\u6C92\u6709\u51B7\u5834\u5594\u3002[VAR 0114(001A)]",
  "\u4EA4\u63DB\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\\n\u8D70\u9BE8\u904E\u5F97\u600E\u9EBC\u6A23\uFF1F\\c\\n\u7260\u7E3D\u662F\u559C\u6B61\u96A8\u4FBF\u4E82\u8DD1\uFF0C\\n\u5728\u91CE\u9910\u7684\u6642\u5019\u8981\u5C0F\u5FC3\u770B\u597D\u7260\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u9019\u9EBC\u8AAA\u4F86\uFF0C\\n\u4E5F\u6148\u8DDF\u6211\u8AAA\u4E86\u4E00\u4EF6\u5F88\u51B7\u7684\u4E8B\u3002\\c\\n\u807D\u8AAA[VAR 1100(00FF,0101)]\u4F60\u59B3\u8DDF\u5979\u8AAA\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6700\u559C\u6B61\u7684\u9053\u9928\u9928\u4E3B\u662F\u6211\u3002\\c\\n\u96D6\u7136\u6211\u771F\u7684\u662F\u5B8C\u5168\u7121\u6CD5\u7406\u89E3\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u600E\u9EBC\u5F97\u51FA\u90A3\u7A2E\u7B54\u6848\u7684\u2026\u2026\\c\\n\u4F46\u6211\u9084\u662F\u6536\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5FC3\u610F\u4E86\u2026\u2026\\n\u59D1\u4E14\u8DDF[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u8072\u8B1D\u8B1D\u3002[VAR 0114(001A)]"
]
