  "\u6211\u53EA\u662F\u6539\u4E0D\u6389\u53EA\u8981\u770B\u5230\u96EA\u5C71\\n\u5C31\u6703\u53BB\u89C0\u5BDF\u5B83\u7684\u7FD2\u6163\u800C\u5DF2\u3002[VAR 0114(001A)]",
  "\u5728\u6821\u5712\u88E1\u9020\u51FA\u90A3\u6A23\u7684\u5C71\u2026\u2026\\n\u9019\u88E1\u771F\u662F\u500B\u4E0D\u5F97\u4E86\u7684\u5730\u65B9\u3002[VAR 0114(001A)]",
  "\u525B\u525B\u6211\u53BB\u722C\u4E86\u6975\u5730\u5340\u7684\u96EA\u5C71\u3002[VAR 0114(001A)]",
  "\u5230\u4E86\u4E0D\u662F\u971C\u62B9\u5C71\u7684\u96EA\u5C71\uFF0C\\n\u8B93\u8D70\u9BE8\u7260\u5011\u53C8\u9AD8\u8208\u53C8\u8208\u596E\u3002[VAR 0114(001A)]",
