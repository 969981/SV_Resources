  "\u6C92\u90A3\u56DE\u4E8B\uFF01",
  "\u55EF\u2026\u2026\uFF1F",
  "\u2026\u2026\u8AAA\u5F97\u771F\u80AF\u5B9A\u554A\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u90A3\u4EFD\u81EA\u4FE1\u7A76\u7ADF\u662F\u5F9E\u54EA\u88E1\u4F86\u7684\uFF1F[VAR 0114(001A)]",
  "\u770B\u5427\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u6C92\u6709\u81EA\u4FE1\u5C0D\u5427\uFF1F[VAR 0114(001A)]",
  "\u4F46\u662F\u65E2\u7136\u4F86\u4E86\uFF0C\\n\u6211\u9084\u662F\u6703\u597D\u597D\u5DE5\u4F5C\u7684\u3002[VAR 0114(001A)]",
  "\u7562\u7ADF\u2026\u2026\\n\u6211\u4E5F\u662F\u5C08\u696D\u7684\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u554A\u3002[VAR 0114(001A)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u904E\u751F\u614B\u5DE8\u86CB\u7684\u6975\u5730\u5340\u55CE\uFF1F\\n\u90A3\u88E1\u771F\u7684\u5F88\u53B2\u5BB3\u3002[VAR 0114(001A)]",
  "\u90A3\u88E1\u7684\u96EA\u9B06\u8EDF\u5F97\u7C21\u76F4\u50CF\u662F\u5929\u7136\u7684\u4E00\u6A23\uFF0C\\n\u8B93\u4EBA\u96E3\u4EE5\u76F8\u4FE1\u90A3\u662F\u4EBA\u5DE5\u96EA\u3002[VAR 0114(001A)]",
  "\u76F4\u7DDA\u9053\u548C\u5F4E\u9053\u90FD\u5F88\u5145\u5BE6\uFF0C\\n\u5F88\u9069\u5408\u55AE\u677F\u6ED1\u96EA\u3002[VAR 0114(001A)]",
