[
  "\u54E6\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u8A72\u4E0D\u6703\u5C31\u662F\\n\u50B3\u805E\u4E2D\u7684\u90A3\u500B\u4EBA\u5427\uFF1F",
  "\u5F9E\u5E15\u5E95\u4E9E\u4F86\u9019\u88E1\u7559\u5B78\u7684\\n[VAR 0100(0000)]\uFF01\u6211\u6C92\u731C\u932F\u5427\uFF1F",
  "\u731C\u5C0D\u4E86\uFF01",
  "\u4F60\u662F\u8AB0\uFF1F",
  "\u6211\u662F\u9EDE\u5FC3\u5927\u53D4\u3002",
  "\u5927\u53D4\u6211\u554A\uFF0C\\n\u5C31\u662F\u559C\u6B61\u52AA\u529B\u7684\u5B78\u751F\u3002",
  "\u7279\u5225\u662F\u6709\u52AA\u529B\u5728\u85CD\u6A02\u6D3B\u7684\u4EBA\uFF0C\\n\u6211\u90FD\u6703\u9001\u9EDE\u5FC3\u4F86\u734E\u52F5\u4ED6\u5011\u5594\u3002",
  "\u9EDE\u5FC3\u662F\u6211\u914D\u5408\u5BF6\u53EF\u5922\u7684\u559C\u597D\\n\u624B\u5DE5\u88FD\u4F5C\u7684\u7279\u88FD\u54C1\uFF01",
  "\u53EA\u8981\u5E36\u5728\u8EAB\u4E0A\uFF0C\u6216\u8A31\u5C31\u6703\u5728\u54EA\u88E1\u9047\u898B\\n\u5F88\u4E0D\u5F97\u4E86\u7684\u5BF6\u53EF\u5922\u5594\uFF1F",
  "\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u52AA\u529B\u53C3\u52A0\u4E86\u5F88\u591A\u85CD\u6A02\u6D3B\uFF0C\\n\u8A18\u5F97\u4F86\u544A\u8A34\u6211\u554A\u3002",
  "\u6211\u4F86\u770B\u770B[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u85CD\u6A02\u6D3B\u7684\u72C0\u6CC1\u2026\u2026",
  "\u54CE\u5440\uFF0C\u597D\u53B2\u5BB3\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5B8C\u6210\u96C6\u53CB\u5708\u4EFB\u52D9\u5566\uFF01",
  "\u54CE\u5440\uFF0C\u597D\u53B2\u5BB3\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5B8C\u6210[VAR 0202(0001)]\u6B21\u96C6\u53CB\u5708\u4EFB\u52D9\u4E86\u5462\uFF01",
  "\u54CE\u5537\uFF0C\u597D\u53B2\u5BB3\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5B8C\u6210[VAR 0202(0001)]\u6B21\u85CD\u6A02\u6D3B\u7684\u4EFB\u52D9\u4E86\u5462\uFF01",
  "\u770B\u4F86\u8981\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u734E\u52F5\u2026\u2026\\n\u73FE\u5728\u9084\u70BA\u6642\u904E\u65E9\u554A\u3002",
  "\u53EA\u8981\u518D\u5B8C\u6210[VAR 0202(0002)]\u6B21\u85CD\u6A02\u6D3B\u7684\u4EFB\u52D9\uFF0C\\n\u6216\u662F[VAR 0202(0003)]\u6B21\u96C6\u53CB\u5708\u4EFB\u52D9\uFF0C\\r\\n\u6211\u5C31\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u9EDE\u5FC3\u5427\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5DF2\u7D93\u5F88\u52AA\u529B\u5728\u5B8C\u6210\u85CD\u6A02\u6D3B\u7684\u4EFB\u52D9\u4E86\uFF0C\\n\u6240\u4EE5\u53EA\u8981\u518D\u5B8C\u6210[VAR 0202(0003)]\u6B21\u96C6\u53CB\u5708\u4EFB\u52D9\uFF0C\\r\\n\u6211\u5C31\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u9EDE\u5FC3\u5594\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5DF2\u7D93\u5F88\u52AA\u529B\u5728\u5B8C\u6210\u96C6\u53CB\u5708\u4EFB\u52D9\u4E86\uFF0C\\n\u6240\u4EE5\u53EA\u8981\u518D\u5B8C\u6210[VAR 0202(0002)]\u6B21\u85CD\u6A02\u6D3B\u7684\u4EFB\u52D9\uFF0C\\r\\n\u6211\u5C31\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u9EDE\u5FC3\u5594\u3002",
  "\u8AAA\u5230\u96C6\u53CB\u5708\u4EFB\u52D9\uFF0C\\n\u597D\u50CF\u662F\u5728\u806F\u76DF\u96C6\u53CB\u5708\u548C\u670B\u53CB\\r\\n\u5E38\u5E38\u4E00\u8D77\u85CD\u6A02\u6D3B\u7684\u8A71\uFF0C\u5C31\u6703\u958B\u59CB\u4E86\u5594\u3002",
  "\u9084\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u518D\u807D\u4E00\u6B21\u95DC\u65BC\\n\u7A00\u6709\u7684\u5BF6\u53EF\u5922\u7684\u6545\u4E8B\u5462\uFF1F",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u807D\u54EA\u96BB\u5BF6\u53EF\u5922\u7684\u6545\u4E8B\u5462\uFF1F\\n\u8981\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u7260\u7684\u9EDE\u5FC3\uFF0C\u5C31\u7D66\u6211\u770B\u770B\u5427\u3002",
  "\u90A3\u4E0D\u662F\u6211\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\\n\u9EDE\u5FC3\u5427\u2026\u2026",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u78BA\u5B9A\u4E0D\u807D\u6211\u8B1B\u6545\u4E8B\u55CE\uFF1F\\n\u8DDF\u6211\u6C92\u4EC0\u9EBC\u597D\u5BA2\u6C23\u7684\u5594\uFF1F",
  "\u770B[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u9EBC\u52AA\u529B\uFF0C\\n\u6211\u5C31\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u5BF6\u53EF\u5922\u7684\u9EDE\u5FC3\u5427\u3002",
  "\u90A3\u662F[VAR 0109(0004)]\uFF01",
  "[VAR 0101(0005)]\u554A\uFF0C\\n\u662F\u4E00\u7A2E\u76F8\uFF5E\u7576\u7A00\u6709\uFF0C\\r\\n\u975E\u5E38\u96E3\u5F97\u4E00\u898B\u7684\u5BF6\u53EF\u5922\u5594\uFF1F",
  "\u8AAA\u5230\u6025\u51CD\u9CE5\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u5728\u5E15\u5E95\u4E9E\u7684\u96EA\u5C71\u767C\u73FE\u4E86\u500B\u5F88\u68D2\u7684\u6C60\u5B50\uFF0C\\n\u65BC\u662F\u5C31\u8DF3\u9032\u90A3\u51B0\u6C34\u88E1\u53BB\u6E38\u6CF3\u5440\u3002",
  "\u7D50\u679C\u554A\uFF0C\u5F9E\u7011\u5E03\u90A3\u908A\u5FFD\u7136\\n\u98DB\u4E0B\u4F86\u4E86\u4E00\u96BB\u6025\u51CD\u9CE5\uFF0C\\r\\n\u5728\u6211\u7684\u982D\u4E0A\u5531\u8457\u6B4C\u98DB\u4F86\u98DB\u53BB\uFF01",
  "\u6211\u9AD8\u8208\u5F97\u548C\u6025\u51CD\u9CE5\u4E00\u8D77\u5531\u8D77\u6B4C\u4F86\uFF0C\\n\u5373\u4F7F\u592A\u967D\u4E0B\u5C71\u4E86\u6211\u5011\u4E5F\u9084\u5531\u500B\u4E0D\u505C\u5594\uFF1F\\r\\n\u7B49\u6211\u56DE\u904E\u795E\u4F86\u6642\uFF0C\u592A\u967D\u5DF2\u7D93\u53C8\u4E0A\u5C71\u4E86\u3002",
  "\u8AAA\u5230\u9583\u96FB\u9CE5\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u6B21\u6211\u722C\u4E0A\u4E86\u5E15\u5E95\u4E9E\u5730\u5340\u7684\u4E00\u5EA7\u71C8\u5854\uFF0C\\n\u671B\u8457\u9060\u65B9\u7684\u57CE\u93AE\u3002",
  "\u7D50\u679C\u554A\uFF0C\u5929\u4E0A\u5FFD\u7136\u6DC5\u701D\u5629\u5566\u5730\u4E0B\u8D77\u96E8\u4F86\uFF01\\n\u6211\u60F3\u9019\u4E0B\u5B50\u4E0D\u5999\u4E86\uFF0C\\r\\n\u6B63\u6E96\u5099\u5F9E\u71C8\u5854\u4E0B\u53BB\u3002",
  "\u5C31\u5728\u90A3\u6642\uFF01\u96A8\u8457\u96F7\u5149\u9583\u720D\uFF0C\\n\u9583\u96FB\u9CE5\u54BB\u5730\u731B\u5F80\u6211\u9019\u908A\u98DB\u4E86\u904E\u4F86\uFF01\\r\\n\u7260\u5F9E\u6211\u8EAB\u65C1\u7D93\u904E\uFF0C\u7136\u5F8C\u5C31\u98DB\u8D70\u4E86\u3002",
  "\u8AAA\u5230\u706B\u7130\u9CE5\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u53BB\u4E86\u5E15\u5E95\u4E9E\u7684\u897F\u90E8\uFF0C\\n\u5728\u90A3\u88E1\u6500\u5CA9\u3002",
  "\u90A3\u5929\u7684\u5929\u6C23\u5FFD\u7136\u4E00\u8B8A\uFF0C\u522E\u8D77\u4E86\u6C99\u66B4\uFF01\\n\u5C31\u5728\u6211\u88AB\u5F04\u5F97\u6EFF\u5634\u90FD\u662F\u6C99\uFF0C\\r\\n\u96E3\uFF5E\u53D7\u5F97\u60F3\u8981\u653E\u68C4\u6500\u5CA9\u7684\u90A3\u4E00\u523B\u2026\u2026",
  "\u706B\u7130\u9CE5\u51FA\u73FE\u4E86\uFF01\u7260\u7684\u5149\u8292\u8000\u773C\u5F97\\n\u8B93\u6211\u5728\u6C99\u66B4\u4E2D\u4E5F\u80FD\u770B\u898B\u7260\u3002\\r\\n\u6211\u731C\u7260\u61C9\u8A72\u662F\u60F3\u9F13\u52F5\u6211\u5427\uFF1F\\r\\n\u4E5F\u591A\u8667\u4E86\u7260\uFF0C\u6211\u624D\u6210\u529F\u5730\u6500\u4E0A\u4E86\u61F8\u5D16\u3002",
  "\u8AAA\u5230\u96F7\u516C\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u5176\u5BE6\u66FE\u7D93\u548C\u96F7\u516C\\n\u4E00\u8D77\u722C\u904E\u5C71\u5594\u3002",
  "\u56E0\u70BA\u96F7\u516C\u7684\u901F\u5EA6\u975E\u5E38\u5FEB\uFF0C\\n\u4E00\u4E0B\u5C31\u54BB\u7830\u7830\u5730\u9818\u5148\u5728\u6211\u7684\u524D\u9762\u4E86\u3002\\c\\n\u65BC\u662F\u6211\u544A\u8A34\u81EA\u5DF1\u8981\u52A0\u628A\u52C1\u554A\uFF5E\\n\u7136\u5F8C\u62FC\u547D\u5730\u8FFD\u8D95\u8457\u96F7\u516C\u3002",
  "\u6700\u5F8C\u6211\u671B\u898B\u4E86\u5317\u908A\u5927\u5730\u90A3\u7247\\n\u5F88\uFF5E\u58EF\u89C0\u7684\u6C99\u6F20\u7F8E\u666F\u5594\u3002\\r\\n\u800C\u4E14\u7576\u6642\u96F7\u516C\u5C31\u5728\u6211\u7684\u65C1\u908A\u5462\u3002",
  "\u8AAA\u5230\u708E\u5E1D\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u6B63\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u5192\u96AA\uFF0C\\n\u7D50\u679C\u5C31\u78B0\u5DE7\u9047\u5230\u904E\u7260\u5462\u3002",
  "\u90A3\u662F\u4E00\u5EA7\u7926\u5C71\uFF0C\u5730\u9762\u88AB\u6316\u5F97\\n\u5230\u8655\u90FD\u662F\u5751\u5751\u6D1E\u6D1E\u7684\u3002\\c\\n\u4F46\u662F\uFF0C\u518D\u5927\u7684\u5751\u6D1E\u708E\u5E1D\u4E5F\u90FD\u662F\\n\u549A\u6B6A\uFF5E\u5730\u4E00\u8DF3\u5C31\u8DF3\u904E\u53BB\u4E86\uFF01",
  "\u65BC\u662F\u6211\u4E5F\u4E0D\u80FD\u8F38\u7D66\u708E\u5E1D\uFF0C\\n\u62FC\u4E86\u547D\u5730\u8DDF\u4E0A\u7260\u7684\u8173\u6B65\uFF0C\\r\\n\u6700\u5F8C\u6211\u548C\u7260\u4E26\u80A9\u6B23\u8CDE\u4E86\u5927\u6D77\u5594\u3002",
  "\u8AAA\u5230\u6C34\u541B\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u5929\u5728\u5E15\u5E95\u4E9E\u7684\u4E00\u8655\u5F88\u6709\u540D\u7684\u6E56\uFF0C\\n\u770B\u5230\u4E86\u6C34\u541B\u5462\u3002",
  "\u56E0\u70BA\u4E0D\u77E5\u9053\u6211\u548C\u6C34\u541B\\n\u6703\u662F\u8AB0\u80FD\u6BD4\u8F03\u5FEB\u6E38\u5230\u5CB8\u908A\uFF0C\\r\\n\u6240\u4EE5\u6211\u5011\u5C31\u8AAA\u597D\u8981\u6BD4\u8CFD\u3002",
  "\u6211\u558A\u4E86\u4E00\u8072\u300C\u9810\u5099\uFF5E\u8D77\uFF01\u300D\u5C31\u958B\u59CB\u6E38\u4E86\uFF0C\\n\u4F46\u6C34\u541B\u662F\u5728\u6C34\u4E0A\u8DD1\uFF0C\u901F\u5EA6\u5FEB\u5F97\u5F88\u554A\u3002\\r\\n\u6211\u53EF\u662F\u500B\u4EBA\u985E\uFF0C\u7528\u4EF0\u5F0F\u5728\u548C\u7260\u6BD4\u5594\uFF1F\\c\\n\u96D6\u7136\u90A3\u662F\u4E00\u5834\u7CBE\u5F69\u7684\u6BD4\u8CFD\uFF0C\\n\u4F46\u6211\u4EE5\u4E9B\u5FAE\u7684\u5DEE\u8DDD\u8F38\u7D66\u7260\u4E86\u3002",
  "\u8AAA\u5230\u6D1B\u5947\u4E9E\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u7528\u4EF0\u5F0F\u5728\u5E15\u5E95\u4E9E\u7F8E\u9E97\u7684\u5927\u6D77\\n\u6E38\u554A\u6E38\u5730\uFF0C\u60F3\u8981\u53BB\u4E0B\u4E00\u8655\u76EE\u7684\u5730\u3002",
  "\u7531\u65BC\u90A3\u7247\u6D77\u7684\u6C34\u6EAB\u7279\uFF5E\u5225\u5730\u51B0\uFF0C\\n\u7A0D\u5FAE\u6E38\u4E86\u4E00\u6703\u5152\u6211\u5C31\u89BA\u5F97\u6E3E\u8EAB\u767C\u51B7\u3002\\c\\n\u53EA\u597D\u5168\u8EAB\u6296\u500B\u4E0D\u505C\u5730\u767B\u4E0A\u4E86\\n\u9644\u8FD1\u7684\u5C0F\u5CF6\u3002",
  "\u7D50\u679C\u554A\uFF0C\u9644\u8FD1\u51FA\u73FE\u4E86\u5DE8\u5927\u7684\u6F29\u6E26\uFF0C\\n\u6D1B\u5947\u4E9E\u5F9E\u6D77\u88E1\u5629\u554A\u5730\u885D\u4E86\u51FA\u4F86\uFF01\\c\\n\u9019\u7C21\u76F4\u8B93\u6211\u76EE\u77AA\u53E3\u5446\uFF0C\\n\u9AD8\u8208\u5F97\u90FD\u5FD8\u4E86\u5168\u8EAB\u6709\u591A\u51B7\u4E86\u3002",
  "\u8AAA\u5230\u9CF3\u738B\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u90A3\u6642\u7684\u6211\uFF0C\u55EF\u2026\u2026\\n\u9084\u53EA\u662F\u500B\u65B0\u624B\u8A13\u7DF4\u5BB6\u3002",
  "\u5E15\u5E95\u4E9E\u5730\u5340\u7684\u897F\u5357\u90E8\u6709\u5EA7\u7011\u5E03\uFF0C\\n\u70BA\u4E86\u8B93\u5BF6\u53EF\u5922\u8B8A\u5F37\uFF0C\\r\\n\u6211\u5728\u90A3\u9644\u8FD1\u901A\u5BB5\u8A13\u7DF4\u3002\u5C31\u5728\u90A3\u6642\uFF01",
  "\u9CF3\u738B\u9583\u4EAE\u4EAE\u5730\u767C\u8457\u5149\uFF0C\\n\u5728\u4E0A\u7A7A\u51FA\u73FE\u4E86\uFF01\\c\\n\u6211\u731C\u9CF3\u738B\u4E00\u5B9A\u662F\\n\u4F86\u70BA\u6211\u52A0\u6CB9\u7684\u5427\u3002",
  "\u8AAA\u5230\u62C9\u5E1D\u4E9E\u65AF\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6B63\u5728\u5E15\u5E95\u4E9E\u5357\u908A\u7684\u6D77\u88E1\\n\u4EF0\u8457\u6E38\u554A\u6E38\u3002",
  "\u6211\u6E38\u4E86\u4E00\u9663\u5B50\u4E4B\u5F8C\\n\u5BE6\u5728\u662F\u6709\u9EDE\u7D2F\u4E86\uFF0C\\c\\n\u6240\u4EE5\u5C31\u56DE\u5230\u9678\u5730\u4E0A\uFF0C\\n\u5728\u5CA9\u77F3\u7684\u9670\u5F71\u8655\u4F11\u606F\u3002",
  "\u7D50\u679C\u5DE7\u4E8B\u5C31\u9019\uFF5E\u9EBC\u767C\u751F\u4E86\uFF01\\n\u62C9\u5E1D\u4E9E\u65AF\u6B63\u54BB\u5695\u5695\u5730\u5728\u90A3\u88E1\u3002\\c\\n\u7260\u8207\u6211\u5C0D\u5230\u773C\uFF0C\u671D\u8457\u6211\u7B11\u4E86\u7B11\u4E4B\u5F8C\uFF0C\\n\u5C31\u4E0D\u77E5\u9053\u98DB\u5230\u54EA\u88E1\u53BB\u4E86\u3002",
  "\u8AAA\u5230\u62C9\u5E1D\u6B50\u65AF\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u5728\u5E15\u5E95\u4E9E\u7684\u6771\u5317\u90E8\\n\u78B0\u5DE7\u9047\u898B\u4E86\u7260\u3002",
  "\u96D6\u7136\u6211\u5011\u8A9E\u8A00\u4E0D\u901A\uFF0C\\n\u4F46\u6211\u96B1\u7D04\u89BA\u5F97\u7260\u662F\u5728\u53EB\u6211\u8DDF\u4E0A\u53BB\u3002\\c\\n\u65BC\u662F\u6211\u5C31\u8FFD\u8457\u98DB\u8D70\u7684\u62C9\u5E1D\u6B50\u65AF\uFF0C\\n\u6500\u4E0A\u4E86\u6709\u8A31\u591A\u5C16\u77F3\u7684\u5CA9\u58C1\u3002",
  "\u7D50\u679C\u4E00\u56DE\u904E\u795E\u4F86\uFF0C\u6211\u767C\u73FE\u81EA\u5DF1\\n\u4F86\u5230\u4E86\u56DB\u5468\u90FD\u88AB\u5C71\u5D16\u5305\u570D\u7684\u6C60\u5858\u5462\u3002\\r\\n\u90A3\u88E1\u80AF\u5B9A\u662F\u500B\u79D8\u5BC6\u7684\u5730\u65B9\u5427\u3002",
  "\u8AAA\u5230\u84CB\u6B50\u5361\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u6B63\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u5192\u96AA\uFF0C\\n\u7D50\u679C\u770B\u5230\u6D77\u88E1\u6709\u5947\u602A\u7684\u77F3\u982D\u3002",
  "\u6211\u5FFD\u7136\u60F3\u8D77\u4F86\u2026\u2026\\n\u554A\uFF0C\u9019\u5C31\u662F\u90A3\u500B\u5F88\u6709\u540D\uFF0C\\r\\n\u53EF\u4EE5\u8B93\u4EBA\u53D7\u5230\u4FDD\u4F51\u7684\u77F3\u982D\uFF01\\c\\n\u65E2\u7136\u4EBA\u90FD\u5230\u4E86\u90A3\u88E1\uFF0C\\n\u5C31\u9589\u4E0A\u773C\u775B\u8A31\u4E86\u500B\u9858\u56C9\u3002",
  "\u904E\u4E86\u4E00\u6703\u5152\u6211\u5F35\u958B\u773C\u775B\uFF0C\\n\u60F3\u4E0D\u5230\u77F3\u982D\u524D\u9762\u5C45\u7136\uFF01\\c\\n\u8F5F\u9686\uFF01\u5730\u51FA\u73FE\u4E86\u84CB\u6B50\u5361\uFF01\\n\u628A\u6211\u5687\u4E86\u597D\u4E00\u5927\u8DF3\u5462\uFF01",
  "\u8AAA\u5230\u56FA\u62C9\u591A\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u5192\u96AA\u7684\u904E\u7A0B\u4E2D\\n\u898B\u904E\u56FA\u62C9\u591A\u5462\u3002",
  "\u5728\u67D0\u500B\u93AE\u7684\u4E0B\u9762\u6709\u500B\u5DE8\u5927\u7684\u7A7A\u6D1E\u5427\uFF1F\\n\u90A3\u500B\u93AE\u53EB\u4EC0\u9EBC\u540D\u5B57\u4F86\u8457\u2026\u2026\\c\\n\u7E3D\u4E4B\uFF0C\u6211\u5C31\u662F\u5728\u90A3\u88E1\u7784\u5230\u7260\u7684\u5566\u3002",
  "\u6211\u4E00\u770B\u300C\u554A\uFF0C\u662F\u96BB\u56FA\u62C9\u591A\u300D\uFF0C\\n\u7136\u5F8C\u5C31\u5F88\u6709\u7CBE\u795E\u5730\u8A66\u8457\u548C\u7260\u6253\u62DB\u547C\u3002\\r\\n\u7562\u7ADF\u7260\u53EF\u662F\u5927\u9678\u5BF6\u53EF\u5922\u561B\u3002\\r\\n\u7D50\u679C\u554A\uFF0C\u7260\u5C31\u79C0\u51FA\u4E86\u7260\u7684\u5927\u722A\u5B50\u8B93\u6211\u770B\u5462\u3002",
  "\u8AAA\u5230\u70C8\u7A7A\u5750\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u5728\u5E15\u5E95\u4E9E\u563F\u563F\u543C\u5730\u722C\u8457\\n\u4E00\u9762\u5F88\uFF5E\u9661\u5CED\u7684\u61F8\u5D16\u3002",
  "\u6211\u6210\u529F\u653B\u4E0A\u9802\u7AEF\u6642\u770B\u5230\u7684\u666F\u8272\uFF0C\\n\u54CE\u5440\uFF0C\u771F\u662F\u582A\u7A31\u4E00\u7D55\u3002\\c\\n\u5F80\u4E0B\u4E00\u770B\uFF0C\\n\u6211\u7684\u8996\u7DDA\u7BC4\u570D\u88E1\u5168\u90FD\u662F\u767D\u96F2\uFF01\\r\\n\u90A3\u771F\u662F\u500B\u5947\u7279\u7684\u5730\u65B9\u5462\uFF5E",
  "\u7D50\u679C\u554A\uFF0C\u70C8\u7A7A\u5750\u54BB\uFF5E\u7830\u5730\\n\u885D\u7834\u96F2\u5C64\u98DB\u4E86\u51FA\u4F86\uFF01\\r\\n\u90A3\u5834\u9762\u554A\uFF5E\u771F\u7684\u662F\u592A\u9A5A\u4EBA\u4E86\u3002",
  "\u8AAA\u5230\u52FE\u5E15\u8DEF\u7FC1\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u6B63\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u5192\u96AA\uFF0C\\n\u7D50\u679C\u52FE\u5E15\u8DEF\u7FC1\u5C31\u500F\u5730\u5F9E\u61F8\u5D16\u8DF3\u4E86\u4E0B\u4F86\u3002",
  "\u6211\u554A\u55B2\u5582\uFF5E\u5730\u53EB\u51FA\u8072\u4F86\uFF0C\\n\u5687\u5F97\u5446\u4F4F\u4E86\u597D\u4E00\u6703\u5152\u3002\\c\\n\u4F46\u53EF\u80FD\u662F\u6211\u7684\u8868\u60C5\u5F88\u6709\u8DA3\u5427\uFF1F\\n\u52FE\u5E15\u8DEF\u7FC1\u7260\u6162\u6162\u5730\u8D70\u4E86\u8D77\u4F86\uFF0C\\c\\n\u5E36\u8457\u6211\u5230\u4E86\u9644\u8FD1\u4E00\u5EA7\\n\u5F88\u6709\u540D\u7684\u7011\u5E03\u3002",
  "\u6211\u548C\u52FE\u5E15\u8DEF\u7FC1\u9053\u8B1D\u4E4B\u5F8C\uFF0C\\n\u7260\u5C31\u7A7F\u904E\u7AF9\u6797\u8DD1\u6389\u4E86\u3002",
  "\u8AAA\u5230\u4EE3\u62C9\u57FA\u7FC1\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u5929\u6211\u4E00\u5982\u5F80\u5E38\u5730\\n\u4EAB\u53D7\u8457\u6500\u5CA9\u7684\u6642\u5149\u3002",
  "\u6211\u722C\u5230\u76F8\u7576\u9AD8\u7684\u5730\u65B9\u5F8C\u56DE\u982D\u4E00\u770B\uFF0C\\n\u6B63\uFF5E\u597D\u53EF\u4EE5\u5728\u5357\u65B9\u9060\u8655\u770B\u5230\\r\\n\u8B8A\u5F97\u5C0F\u5C0F\u7684\u5713\u6A21\u93AE\u3002\\c\\n\u5728\u6211\u770B\u5F97\u53EF\u51FA\u795E\u6642\uFF0C\u7A81\u7136\u554A\uFF0C\\n\u4EE3\u62C9\u57FA\u7FC1\u5C31\u5728\u6211\u65C1\u908A\u5750\u4E0B\u4E86\uFF01",
  "\u56E0\u70BA\u7260\u770B\u8D77\u4F86\u5F88\u9592\uFF0C\\n\u6240\u4EE5\u6211\u5011\u5C31\u4E00\u8D77\u5403\u4E86\u9EDE\u5FC3\u5594\u3002",
  "\u8AAA\u5230\u7562\u529B\u5409\u7FC1\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u6B63\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u5192\u96AA\uFF0C\\n\u7D50\u679C\u78B0\u5230\u7562\u529B\u5409\u7FC1\u5728\u6A39\u852D\u4E0B\u4F11\u606F\u3002",
  "\u800C\u4E14\u90A3\u68F5\u6A39\u4E0A\u9084\u6709\u8457\\n\u8AAA\u4E0D\u4E0A\u4F86\u7684\u5947\u7279\u82B1\u7D0B\u5594\uFF1F\\c\\n\u65BC\u662F\u6211\u4E00\u4E0B\u770B\u6A39\uFF0C\u4E00\u4E0B\u770B\u7562\u529B\u5409\u7FC1\uFF0C\\n\u5C31\u9019\u9EBC\u6A02\u5728\u5176\u4E2D\u4E86\u597D\u4E00\u9663\u5B50\u3002",
  "\u7D50\u679C\u554A\uFF0C\u7562\u529B\u5409\u7FC1\u7260\u4E5F\u4E00\u81C9\\n\u4E0D\u53EF\u601D\u8B70\u5730\u76EF\u8457\u6211\u770B\u5594\uFF1F\\c\\n\u65BC\u662F\u6211\u5C31\u8DDF\u7260\u8AAA\u4E86\u6211\u5192\u96AA\u7684\u6545\u4E8B\uFF0C\\n\u7260\u4F3C\u4E4E\u807D\u5F97\u6D25\u6D25\u6709\u5473\u5462\u3002",
  "\u8AAA\u5230\u840A\u5E0C\u62C9\u59C6\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u66FE\u7D93\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u7684\u67D0\u500B\u5C0F\u93AE\u9644\u8FD1\\n\u770B\u5230\u904E\u840A\u5E0C\u62C9\u59C6\u5594\u3002",
  "\u90A3\u662F\u4E00\u500B\u6709\u5F88\u591A\u5DE5\u4EBA\u7684\u5C0F\u93AE\u3002\\c\\n\u7576\u6642\u6211\u7AD9\u5728\u9AD8\u8655\u7684\u5CA9\u77F3\u5730\uFF0C\\n\u4E00\u76F4\u89C0\u671B\u8457\u4ED6\u5011\u52AA\u529B\u5DE5\u4F5C\u7684\u6A21\u6A23\u3002",
  "\u5728\u6211\u60F3\u8457\u300C\u4ED6\u5011\u771F\u52AA\u529B\u554A\uFF5E\u300D\u7684\u90A3\u6642\uFF0C\\n\u5FFD\u7136\u611F\u53D7\u5230\u80CC\u5F8C\u6709\u4E00\u80A1\u6C23\u606F\u3002\\c\\n\u6211\u56DE\u904E\u982D\u4E00\u770B\uFF0C\\n\u7ADF\u7136\u662F\u840A\u5E0C\u62C9\u59C6\u7AD9\u5728\u90A3\u88E1\uFF01\\c\\n\u6216\u8A31\u840A\u5E0C\u62C9\u59C6\u7260\u4E5F\u5F88\u559C\u6B61\\n\u52AA\u529B\u5DE5\u4F5C\u7684\u5DE5\u4EBA\u5011\u5462\uFF5E",
  "\u8AAA\u5230\u6377\u514B\u7F85\u59C6\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u6B63\u6253\u7B97\u5F9E\u684C\u53F0\u5E02\\n\u4E00\u8DEF\u8D70\u5230\u6DF1\u7F3D\u93AE\u3002",
  "\u7D50\u679C\u554A\uFF0C\u8D70\u8457\u8D70\u8457\u5C31\u770B\u5230\u6709\u500B\u5DE8\u5927\u7684\u9ED1\u5F71\\n\u5728\u6771\u908A\u7684\u5929\u7A7A\u54BB\u554A\u54BB\u554A\u5730\u98DB\uFF01\\c\\n\u6211\u4E00\u908A\u60F3\u8457\u300C\u90A3\u662F\u5565\uFF01\uFF1F\u300D\\n\u4E00\u908A\u722C\u4E0A\u4E86\u9AD8\u8655\u4E00\u770B\uFF0C\u539F\u4F86\u662F\u6377\u514B\u7F85\u59C6\uFF01",
  "\u6211\u5687\u5F97\u767C\u695E\uFF0C\u5446\u5446\u5730\u76EF\u8457\u5929\u7A7A\u770B\uFF0C\\n\u7136\u5F8C\u6377\u514B\u7F85\u59C6\u5C31\u964D\u843D\u5230\u4E86\u6211\u8EAB\u908A\u5462\u3002\\c\\n\u6211\u5011\u5006\u76EF\u8457\u5F7C\u6B64\u770B\u4E86\u597D\u4E00\u9663\u5B50\uFF0C\\n\u54CE\u5440\uFF5E\u6377\u514B\u7F85\u59C6\u771F\u7684\u597D\u5E25\u5462\uFF5E",
  "\u8AAA\u5230\u914B\u96F7\u59C6\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u6B63\u5728\u722C\u96EA\u5C71\uFF0C\\n\u537B\u9047\u4E0A\u4E86\u731B\u70C8\u7684\u66B4\u98A8\u96EA\u3002\\r\\n\u6211\u60F3\u8457\u300C\u9019\u771F\u6298\u78E8\u4EBA\u554A\u300D\uFF0C\u5C31\u9032\u4E86\u4E00\u500B\u6D1E\u7A74\u3002",
  "\u90A3\u500B\u6D1E\u7A9F\u5462\uFF5E\u975E\u5E38\u5730\u5927\uFF0C\\n\u7C21\u76F4\u5C31\u50CF\u500B\u8FF7\u5BAE\u4E00\u6A23\uFF01\\c\\n\u7576\u6211\u6574\u500B\u4EBA\u8208\u81F4\u4E0A\u4F86\uFF0C\\n\u5728\u88E1\u9762\u63A2\u96AA\u5F97\u6B63\u958B\u5FC3\u6642\uFF0C\\r\\n\u7A81\u7136\u6709\u9762\u51B0\u7246\u958B\u59CB\u52D5\u4E86\u8D77\u4F86\u5594\uFF1F",
  "\u6211\u60F3\u8457\u300C\u54CE\u5440\u5440\uFF01\uFF1F\u300D\uFF0C\\n\u77AA\u5927\u773C\u775B\u4ED4\u7D30\u4E00\u770B\uFF0C\\r\\n\u767C\u73FE\u539F\u4F86\u90A3\u662F\u914B\u96F7\u59C6\uFF01\u5F88\u9A5A\u4EBA\u5427\uFF1F",
  "\u8AAA\u5230\u7D22\u723E\u8FE6\u96F7\u6B50\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u66FE\u7D93\u53BB\u5E15\u5E95\u4E9E\u5730\u5340\uFF0C\\n\u60F3\u770B\u770B\u5BF6\u53EF\u5922\u806F\u76DF\u3002",
  "\u7576\u6211\u5728\u5916\u9762\u770B\u8457\u7684\u6642\u5019\uFF0C\\n\u6709\u500B\u5DE5\u4F5C\u4EBA\u54E1\u6CE8\u610F\u5230\u6211\uFF0C\u9084\u8B93\u6211\u9032\u53BB\u88E1\u9762\u3002\\c\\n\u4E0D\u53EA\u9019\u6A23\uFF0C\u90A3\u500B\u4EBA\u9084\u5E36\u6211\u53BB\u53C3\u89C0\\n\u6709\u756B\u8457\u806F\u76DF\u6A19\u8A8C\u7684\u89C0\u666F\u6A13\u5C64\u5462\u3002\\c\\n\u6B63\u7576\u6211\u5F9E\u90A3\u88E1\u671B\u8457\u5B78\u6821\u90A3\u908A\u7684\u98A8\u666F\u6642\uFF0C\\n\u7A81\u7136\u6709\u500B\u9F90\u5927\u7684\u8EAB\u5F71\u5F9E\u6211\u773C\u524D\u6A6B\u7A7F\u800C\u904E\uFF01",
  "\u6C92\u60F3\u5230\u90A3\u5C45\u7136\u662F\u7D22\u723E\u8FE6\u96F7\u6B50\uFF01\\c\\n\u96D6\u7136\u7260\u4E00\u77AC\u9593\u5C31\u8DD1\u8D70\u4E86\uFF0C\u6C92\u80FD\u548C\u7260\u6253\u62DB\u547C\uFF0C\\n\u4F46\u7260\u771F\u7684\u597D\u5E25\u5462\uFF5E",
  "\u8AAA\u5230\u9732\u5948\u96C5\u62C9\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u7684\u6D77\u7058\\n\u770B\u8457\u5915\u967D\u767C\u5446\u3002",
  "\u770B\u8457\u592A\u967D\uFF0C\u771F\u7684\u6703\u8B93\u4EBA\\n\u6DF1\u6DF1\u610F\u8B58\u5230\u81EA\u5DF1\u6709\u591A\u6E3A\u5C0F\u5462\u3002\\c\\n\u6B63\u7576\u6211\u7684\u60C5\u7DD2\\n\u8B8A\u5F97\u6709\u9EDE\u611F\u50B7\u6642\u2026\u2026\\c\\n\u660E\u660E\u592A\u967D\u9084\u6C92\u6709\u5B8C\u5168\u4E0B\u5C71\uFF0C\\n\u537B\u6709\u4E00\u9264\u5DE8\u5927\u7684\u65B0\u6708\\r\\n\u5F9E\u6211\u773C\u524D\u54BB\u556A\u556A\u5730\u6A6B\u7A7F\u800C\u904E\uFF01",
  "\u7531\u65BC\u4E8B\u60C5\u767C\u751F\u5F97\u592A\u5FEB\uFF0C\\n\u7576\u6642\u6211\u6C92\u641E\u6E05\u695A\u72C0\u6CC1\u3002\\c\\n\u4F46\u90A3\u9053\u5F71\u5B50\u4E00\u5B9A\u5C31\u662F\u9732\u5948\u96C5\u62C9\uFF0C\\n\u7D55\u5C0D\u4E0D\u6703\u932F\u7684\u3002",
  "\u8AAA\u5230\u5948\u514B\u6D1B\u8332\u746A\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u7684\u7011\u5E03\u4FEE\u884C\uFF0C\\n\u7D50\u679C\u767C\u73FE\u5948\u514B\u6D1B\u8332\u746A\u7260\u6B63\u5F9E\u9AD8\u8655\\r\\n\u7528\u53EF\u6015\u7684\u773C\u795E\u77AA\u8457\u6211\uFF01",
  "\u6211\u60F3\u8AAA\u4E0D\u80FD\u88AB\u7260\u770B\u6241\uFF0C\\n\u65BC\u662F\u5C31\u300C\u559D\u554A\uFF01\uFF01\u300D\u5730\u5927\u558A\u4E86\u4E00\u8072\uFF0C\\r\\n\u7136\u5F8C\u5948\u514B\u6D1B\u8332\u746A\u5C31\u7ACB\u523B\u9003\u8D70\u4E86\u3002",
  "\u53EF\u80FD\u662F\u88AB\u6211\u7684\u97F3\u91CF\u5687\u5230\u4E86\u5427\uFF0C\\n\u5728\u90A3\u9644\u8FD1\u7684\u840C\u82BD\u9E7F\u5011\\r\\n\u4E5F\u90FD\u7D1B\u7D1B\u9003\u8D70\u4E86\u5462\uFF5E\u54C8\u54C8\u54C8\u54C8\u54C8\u3002",
  "\u8AAA\u5230\u718A\u5F92\u5F1F\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6709\u4E00\u6B21\u6211\u6B63\u5728\u5E15\u5E95\u4E9E\u5730\u5340\u5192\u96AA\uFF0C\\n\u7D50\u679C\u767C\u73FE\u4E86\u718A\u5F92\u5F1F\u6B63\u5728\u4FEE\u884C\u5462\uFF01\\c\\n\u6211\u4E0A\u524D\u642D\u8A71\u8AAA\u300C\u54CE\u5440\uFF0C\u4F60\u5728\u4FEE\u884C\u55CE\uFF1F\u300D\uFF0C\\n\u7D50\u679C\u9019\u4E00\u554F\u5C45\u7136\u8B93\u6211\u5011\u610F\u6C23\u76F8\u6295\u5462\uFF01",
  "\u6211\u5011\u4E00\u8D77\u935B\u934A\u8EAB\u9AD4\u597D\u4E00\u9663\u5B50\u5F8C\uFF0C\\n\u5FFD\u7136\u718A\u5F92\u5F1F\u626D\u626D\u634F\u634F\u4E86\u8D77\u4F86\u3002",
  "\u7136\u5F8C\u5C31\u628A\u9577\u5728\u65C1\u908A\u7684\u7AF9\u7B4D\\n\u62D4\u51FA\u4F86\u9001\u7D66\u4E86\u6211\u5462\uFF5E",
  "\u8AAA\u5230\u96EA\u66B4\u99AC\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6211\u51FA\u65BC\u8208\u8DA3\uFF0C\\n\u5C31\u53BB\u722C\u4E86\u5E15\u5E95\u4E9E\u7684\u96EA\u5C71\u3002",
  "\u6211\u5728\u7A4D\u96EA\u7684\u8DEF\u4E0A\u8D70\u4E86\u53C8\u8D70\uFF0C\\n\u6B63\u7576\u6211\u89BA\u5F97\u61C9\u8A72\u5FEB\u8981\u62B5\u9054\u5C71\u9802\u7684\u90A3\u6642\uFF0C\\r\\n\u6211\u767C\u73FE\u4E86\u4E00\u9593\u5012\u584C\u7684\u623F\u5B50\u3002\\c\\n\u56E0\u70BA\u7246\u58C1\u9084\u5F88\u7A69\u56FA\uFF0C\\n\u6211\u6253\u7B97\u5728\u90A3\u88E1\u6B47\u6B47\u8173\uFF0C\u5C31\u5F80\u88E1\u9762\u77A7\u4E86\u4E00\u77A7\u3002",
  "\u7D50\u679C\u554A\uFF0C\u6C92\u60F3\u5230\u90A3\u88E1\u5DF2\u7D93\u6709\u4E86\u5148\u5BA2\uFF01\\n\u6F54\u767D\u5982\u96EA\u7684\u5BF6\u53EF\u5922\u2026\u2026\\c\\n\u96EA\u66B4\u99AC\u6B63\u5728\u88E1\u9762\u7761\u89BA\uFF01\\n\u54CE\u5440\uFF5E\u90A3\u666F\u8C61\u771F\u8B93\u6211\u76EE\u77AA\u53E3\u5446\u5462\uFF5E",
  "\u8AAA\u5230\u9748\u5E7D\u99AC\u2026\u2026\\n\u6211\u5E74\u8F15\u7684\u6642\u5019\u554A\uFF1F\\c\\n\u6211\u51FA\u65BC\u8208\u8DA3\uFF0C\\n\u5C31\u53BB\u722C\u4E86\u5E15\u5E95\u4E9E\u7684\u5C71\u3002",
  "\u6211\u6162\uFF5E\u60A0\u60A0\u5730\\n\u8D70\u5728\u8349\u6728\u53E2\u751F\u7684\u767B\u5C71\u9053\uFF0C\\c\\n\u5728\u90A3\u9014\u4E2D\u767C\u73FE\u4E86\u4E00\u8655\u722C\u6EFF\u4E86\u85E4\u8513\u7684\u5EE2\u589F\u3002\\n\u6211\u6253\u7B97\u5728\u90A3\u88E1\u6B47\u6B47\u8173\uFF0C\u5C31\u5F80\u88E1\u9762\u77A7\u4E86\u4E00\u77A7\u3002",
  "\u7D50\u679C\u554A\uFF0C\u6C92\u60F3\u5230\u5F9E\u5EE2\u589F\u88E1\u9762\\n\u6709\u96BB\u9ED1\u5F71\u822C\u7684\u5BF6\u53EF\u5922\u2026\u2026\\c\\n\u9748\u5E7D\u99AC\u7A81\u7136\u63A2\u51FA\u982D\u4F86\uFF0C\\n\u628A\u6211\u5687\u4E86\u597D\u4E00\u5927\u8DF3\u5462\uFF5E\uFF01",
  "\u53EA\u8981\u628A\u9EDE\u5FC3\u5E36\u5728\u8EAB\u4E0A\uFF0C\\n\u8AAA\u4E0D\u5B9A[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u53EF\u4EE5\u9047\u898B\u7260\u5594\uFF5E",
  "\u8981\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u898B\u5230\u4E86[VAR 0101(0005)]\uFF0C\\n\u8A18\u5F97\u4EE3\u6211\u5411\u7260\u554F\u597D\u554A\u3002",
  "\u2026\u2026\u54CE\u5440\u5440\uFF1F\\c\\n\u628A\u525B\u624D\u90A3\u500B\u9EDE\u5FC3\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4EE5\u5F8C\uFF0C\\n\u6211\u624B\u908A\u5C31\u6C92\u6709\u9EDE\u5FC3\u4E86\u5462\u3002",
  "\u9019\u90FD\u8981\u591A\u8667[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u52AA\u529B\u5B8C\u6210\u4E86\u5F88\u591A\u85CD\u6A02\u6D3B\u5462\uFF5E",
  "\u96D6\u7136\u6211\u5DF2\u7D93\u6C92\u6709\u9EDE\u5FC3\u53EF\u4EE5\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF0C\\n\u4F46\u5076\u723E\u2026\u2026\u4F86\u807D\u807D\u6211\u8AAA\u6545\u4E8B\u5427\u3002",
  "[VAR 0100(0000)]\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u518D\u807D\u4E00\u6B21\u95DC\u65BC\u5BF6\u53EF\u5922\u7684\u6545\u4E8B\u55CE\uFF1F",
  "\u5927\u53D4\u6211\u55CE\uFF1F\u9664\u4E86\u5E15\u5E95\u4E9E\u5730\u5340\u4E4B\u5916\uFF0C\\n\u6211\u4E5F\u5728\u5F88\u591A\u5730\u5340\u65C5\u884C\u904E\u5594\u3002\\c\\n\u6211\u5728\u5404\u5F0F\u5404\u6A23\u7684\u5730\u65B9\\n\u5403\u904E\u5404\u5F0F\u5404\u6A23\u7684\u6771\u897F\u5462\uFF5E",
  "\u5927\u53D4\u6211\u55CE\uFF1F\u6211\u4EE5\u524D\u554A\uFF0C\\n\u6253\u8D77\u5BF6\u53EF\u5922\u5C0D\u6230\u4F86\u4E5F\u662F\u633A\u5F37\u7684\u5594\uFF1F\\c\\n\u7576\u6642\u6211\u548C\u642D\u6A94\u7684\u963F\u67CF\u602A\\n\u5728\u8001\u5BB6\u4E00\u5E36\u53EF\u662F\u6240\u5411\u7121\u6575\u5462\uFF5E",
  "[VAR 0100(0000)]\uFF0C\\n\u770B\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u6211\u597D\u958B\u5FC3\u554A\u3002\\c\\n\u958B\u5FC3\u5F97\u6211\u5FCD\u4E0D\u4F4F\\n\u90FD\u60F3\u5531\u6B4C\u5566\uFF5E\\r\\n\u5660\uFF5E\u5566\u5566\u5566\u5566\u5566\uFF0C\u5566\u5566\uFF5E",
  "\u8AAA\u5230\u6211\u505A\u7684\u9EDE\u5FC3\uFF0C\\n\u7528\u7684\u6750\u6599\u5176\u5BE6\u5F88\u666E\u901A\u3002\\c\\n\u4F46\u662F\uFF0C\u6211\u505A\u7684\u6642\u5019\u6703\u60F3\u50CF\\n\u5BF6\u53EF\u5922\u5403\u9EDE\u5FC3\u5403\u5F97\u5F88\u958B\u5FC3\u7684\u6A23\u5B50\uFF0C\\r\\n\u6240\u4EE5\u4E00\u5B9A\u662F\u975E\uFF5E\u5E38\u597D\u5403\u5462\uFF5E",
  "\u96D6\u7136\u6211\u4E0D\u61C2\u5BF6\u53EF\u5922\u7684\u8A9E\u8A00\uFF0C\\n\u4F46\u6211\u53EA\u8981\u770B\u7260\u5011\u7684\u773C\u775B\uFF0C\\r\\n\u5C31\u5927\u81F4\u731C\u5F97\u51FA\u7260\u5011\u5728\u60F3\u4EC0\u9EBC\uFF0C\u771F\u795E\u5947\u5462\uFF5E\\c\\n\u54C8\u54C8\u54C8\u54C8\u54C8\uFF0C\\n[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u9019\u9EBC\u89BA\u5F97\u5427\uFF1F"
]
