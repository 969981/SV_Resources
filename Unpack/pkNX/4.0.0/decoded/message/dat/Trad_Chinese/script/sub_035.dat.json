[
  "\u6211\u8AAA\u5440\uFF0C\u6211\u4F86\u544A\u8A34[VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u5BF6\u53EF\u5922\u7684\u5C3A\u5BF8\u5982\u4F55\u5462\uFF1F",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u77E5\u9053\u54EA\u4E00\u96BB\\n\u5BF6\u53EF\u5922\u7684\u5C3A\u5BF8\u5462\uFF1F",
  "\u55EF\uFF0C\u6211\u770B\u770B\u5594\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684[VAR 0102(0001)]\u2026\u2026",
  "\u771F\u662F\u96BBBIG\u5BF6\u53EF\u5922\uFF01\uFF01\uFF01\uFF01\\c\\n\u5BE6\u5728\u662F\u5F88\u5C11\u6709\u6A5F\u6703\u80FD\u770B\u5230\\n\u9019\u9EBC\u5927\u96BB\u7684\u5BF6\u53EF\u5922\u5462\uFF01",
  "\u7260\u4E00\u5B9A\u662F\u5168\u4E16\u754C\u6700\u5927\u96BB\u7684\\n[VAR 0101(0001)]\uFF01",
  "\u54CE\u5440\uFF01\u7260\u5F88\u5927\u96BB\u5462\uFF01\\n\u8B93\u4EBA\u53EF\u4EE5\u653E\u5FC3\u5730\u6574\u500B\u9760\u4E0A\u53BB\uFF0C\\r\\n\u5B89\u5FC3\u611F\u8D85\u7FA4\uFF01",
  "\u5475\u5475\uFF01\u770B\u4F86\u7260\u6BD4\u4E00\u822C\u7684\u5B69\u5B50\\n\u9084\u4F86\u5F97\u5927\u96BB\u5F88\u591A\u5462\uFF01\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u597D\u597D\u73CD\u60DC\u7260\u9019\u500B\u7279\u8272\u5594\uFF01",
  "\u7260\u4F3C\u4E4E\u6BD4\u4E00\u822C\u7684\u5B69\u5B50\\n\u9084\u7A0D\u5FAE\u4F86\u5F97\u5927\u96BB\u4E00\u9EDE\uFF01",
  "\u6A19\u6E96\u4E2D\u7684\u6A19\u6E96\uFF01\\n\u7260\u5C6C\u65BC\u5E73\u5747\u7684\u5C3A\u5BF8\uFF0C\\r\\n\u5145\u6EFF\u8457\u6B63\u7D71\u738B\u9053\u7684\u9B45\u529B\u5462\u3002",
  "\u7260\u4F3C\u4E4E\u6BD4\u4E00\u822C\u7684\u5B69\u5B50\\n\u9084\u7A0D\u5FAE\u4F86\u5F97\u5C0F\u96BB\u4E00\u9EDE\uFF01",
  "\u5475\u5475\uFF01\u770B\u4F86\u7260\u6BD4\u4E00\u822C\u7684\u5B69\u5B50\\n\u9084\u4F86\u5F97\u5C0F\u96BB\u5F88\u591A\uFF01\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u597D\u597D\u73CD\u60DC\u7260\u9019\u500B\u7279\u8272\u5594\uFF01",
  "\u54CE\u5440\uFF01\u7260\u5F88\u5C0F\u96BB\u5462\uFF01\\n[VAR 0101(0001)]\u754C\u4E2D\u7684\u8FF7\u4F60\u5076\u50CF\uFF01\\r\\n\u53EF\u611B\u6EFF\u5206\uFF01",
  "\u771F\u662F\u96BBsmall\u5BF6\u53EF\u5922\uFF01\uFF01\uFF01\uFF01\\c\\n\u5BE6\u5728\u662F\u5F88\u5C11\u6709\u6A5F\u6703\u80FD\u770B\u5230\\n\u9019\u9EBC\u5C0F\u96BB\u7684\u5BF6\u53EF\u5922\u5462\uFF01",
  "\u7260\u4E00\u5B9A\u662F\u5168\u4E16\u754C\u6700\u5C0F\u96BB\u7684\\n[VAR 0101(0001)]\uFF01",
  "\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u8B93\u6211\u770B\u5230\\n\u9019\u9EBC\u5927\u96BB\u7684\u5BF6\u53EF\u5922\u3002\\r\\n\u6211\u4F86\u5E6B\u7260\u6234\u4E0A\u8B49\u7AE0\u3002",
  "\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u8B93\u6211\u770B\u5230\\n\u9019\u9EBC\u5C0F\u96BB\u7684\u5BF6\u53EF\u5922\u3002\\r\\n\u6211\u4F86\u5E6B\u7260\u6234\u4E0A\u8B49\u7AE0\u3002",
  "[VAR 0102(0001)]\\n\u7372\u5F97\u4E86\u5927\u500B\u5B50\u4E4B\u8B49\uFF01",
  "[VAR 0102(0001)]\\n\u7372\u5F97\u4E86\u5C0F\u4E0D\u9EDE\u4E4B\u8B49\uFF01",
  "\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u77E5\u9053\u5BF6\u53EF\u5922\u7684\u5C3A\u5BF8\uFF0C\\n\u96A8\u6642\u4F86\u627E\u6211\u5594\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u55CE\uFF1F\u5373\u4F7F\u662F\u76F8\u540C\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u7576\u4E2D\u4E5F\u6703\u6709\u5927\u500B\u5B50\u548C\u5C0F\u500B\u5B50\u7684\u4E0D\u540C\u3002\\c\\n\u53EA\u8981\u6BD4\u8F03\u770B\u770B\u6211\u7684\u5E15\u5947\u5229\u8332\u5011\uFF0C\\n\u76F8\u4FE1\u5C31\u4E00\u76EE\u77AD\u7136\u4E86\uFF01\\c\\n\u6211\u53EA\u8981\u4E00\u770B\uFF0C\\n\u5C31\u80FD\u975E\uFF5E\u5E38\u7CBE\u78BA\u5730\u77E5\u9053\u5BF6\u53EF\u5922\u7684\u5927\u5C0F\u5594\uFF01",
  "[~ 21]"
