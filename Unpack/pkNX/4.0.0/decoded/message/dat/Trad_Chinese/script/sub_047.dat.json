[
  "\u628A\u6750\u6599\u50CF\u9019\u6A23\u7528\u2026\u2026\\n\u518D\u628A\u8ABF\u5473\u6599\u2026\u2026",
  "\u2026\u2026\u554A\uFF0C\u62B1\u6B49\uFF01\\n\u6211\u525B\u525B\u5728\u60F3\u4E8B\u60C5\uFF01\\c\\n\u6211\u6B63\u5728\u7814\u7A76\u4E09\u660E\u6CBB\u7684\u98DF\u8B5C\u3002\\c\\n\u6211\u7684\u5922\u60F3\u5C31\u662F\u7E3D\u6709\u4E00\u5929\u8981\u767C\u660E\u51FA\\n\u88AB\u8B7D\u70BA\u5927\u5E2B\u7B49\u7D1A\u7684\u6975\u81F4\u98DF\u8B5C\uFF01\\c\\n\u53EF\u4EE5\u7684\u8A71\uFF0C\\n\u8B93\u6211\u4E5F\u8DDF[VAR 1100(00FF,0101)]\u4F60\u59B3\u5206\u4EAB\u4E09\u660E\u6CBB\u7684\u98DF\u8B5C\u5427\uFF01",
  "[VAR 0100(0000)]\\n\u53EF\u4EE5\u88FD\u4F5C\u65B0\u7684\u4E09\u660E\u6CBB\u4E86\uFF01",
  "[VAR 0100(0000)]\\n\u53EF\u4EE5\u88FD\u4F5C\u65B0\u7684\u5927\u5E2B\u7B49\u7D1A\u4E09\u660E\u6CBB\u4E86\uFF01",
  "\u9019\u53EF\u662F\u597D\u5403\u5230\u4E0B\u5DF4\u90FD\u8981\u6389\u4E0B\u4F86\uFF0C\\n\u8A18\u5F97\u505A\u505A\u770B\u5594\uFF01",
  "\u6211\u8981\u662F\u60F3\u5230\u4E86\u65B0\u98DF\u8B5C\uFF0C\\n\u518D\u8DDF[VAR 1100(00FF,0101)]\u4F60\u59B3\u5206\u4EAB\u554A\uFF01",
  "\u2026\u2026\u54E6\uFF0C\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u554A\uFF01\\n\u6211\u60F3\u5230\u65B0\u98DF\u8B5C\u56C9\uFF01",
  "\u2026\u2026\u54E6\uFF0C\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u554A\uFF01\\c\\n\u6211\u6B63\u5728\u7814\u767C\u7684\u98DF\u8B5C\uFF0C\\n\u9700\u8981\u5F88\u7A00\u6709\u7684\u8ABF\u5473\u6599\u3002\\c\\n\u90A3\u4E9B\u8ABF\u5473\u6599\u53EB\u79D8\u50B3\u4EC0\u9EBC\u7684\uFF0C\\n\u7E3D\u5171\u6709\uFF15\u7A2E\u2026\u2026\\c\\n\u8981\u662F\u6211\u80FD\u81F3\u5C11\u770B\u5230\u90A3\u4E9B\u8ABF\u5473\u6599\u4E00\u773C\uFF0C\\n\u6216\u8A31\u5C31\u80FD\u9748\u5149\u4E00\u9583\u60F3\u51FA\u65B0\u98DF\u8B5C\u4E86\u3002",
  "\u90A3\u4E9B\u8ABF\u5473\u6599\u53EB\u79D8\u50B3\u4EC0\u9EBC\u7684\uFF0C\\n\u7E3D\u5171\u6709\uFF15\u7A2E\u2026\u2026\\c\\n\u8981\u662F\u6211\u80FD\u81F3\u5C11\u770B\u5230\u90A3\u4E9B\u8ABF\u5473\u6599\u4E00\u773C\uFF0C\\n\u6216\u8A31\u5C31\u80FD\u9748\u5149\u4E00\u9583\u60F3\u51FA\u65B0\u98DF\u8B5C\u4E86\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u62FF\u8457\u7684\u90A3\u3001\u90A3\u500B\u662F\uFF01\\n\u4E0D\u5C31\u662F\u79D8\u50B3\u4EC0\u9EBC\u7684\u55CE\uFF01\uFF1F\\r\\n\u55DA\u55DA\u2026\u2026\u554A\u3001\u554A\u554A\u2026\u2026\\r\\n\u98DF\u8B5C\u6D6E\u73FE\u5728\u6211\u8166\u6D77\u4E86\uFF01\uFF1F",
  "\u547C\u3001\u547C\u2026\u2026\\n\u6211\u767C\u660E\u51FA\u9A5A\u4EBA\u7684\u98DF\u8B5C\u4E86\uFF01\\r\\n\u9019\u6B63\u662F\u6975\u81F4\u7684\u4E09\u660E\u6CBB\u2026\u2026\uFF01\\r\\n\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u5B9A\u8981\u505A\u505A\u770B\u2026\u2026\uFF01\uFF01",
  "\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u798F\uFF0C\\n\u5927\u5E2B\u7B49\u7D1A\u7684\u4E09\u660E\u6CBB\u90FD\u6210\u5F62\u5316\u70BA\u73FE\u5BE6\u4E86\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u80CC\u5F8C\u652F\u6301\u6211\u7684\u5922\u60F3\uFF0C\\n\u771F\u7684\u592A\u611F\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF01",
  "\u9019\u500B\u4E16\u754C\u4E0A\u4E00\u5B9A\u5B58\u5728\u8457\\n\u9084\u6C92\u6709\u4EFB\u4F55\u4EBA\u767C\u73FE\u7684\u7F8E\u5473\u4E09\u660E\u6CBB\uFF01\\c\\n\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u5230\u4E86\u65B0\u98DF\u8B5C\uFF0C\\n\u5225\u5FD8\u4E86\u8981\u548C\u8A31\u591A\u4EBA\u5206\u4EAB\u554A\uFF01"
]
