[
  "\u96D6\u7136\u820A\u4E86\u4E00\u9EDE\uFF0C\\n\u4F46\u9019\u500B\u5E33\u7BF7\u5F88\u4E0D\u932F\u5427\uFF01[VAR 0114(0046)]",
  "\u9019\u662F\u6211\u7238\u4E0D\u7528\u4E86\u7684\u6771\u897F\uFF0C\\n\u6211\u64C5\u81EA\u62FF\u4F86\u7528\u4E86\u3002[VAR 0114(0046)]",
  "\u9019\u88E1\u5C31\u662F\u6211\u5011\\n\u8ABF\u67E5\u8D6B\u6708\u7684\u64DA\u9EDE\u56C9\uFF5E\uFF01[VAR 0114(0046)]",
  "\u5495\u547C\uFF5E\uFF01",
  "\u807D\u8AAA\u8D6B\u6708\u6BD4\u5176\u4ED6\u7684\u5BF6\u53EF\u5922\\n\u8981\u4F86\u5F97\u8B39\u614E\u5F97\u591A\u3002[VAR 0114(0046)]",
  "\u6240\u4EE5\u7260\u5E7E\u4E4E\u4E0D\u6703\u5728\\n\u4EBA\u985E\u9762\u524D\u73FE\u8EAB\u3002[VAR 0114(0046)]",
  "\u4E5F\u56E0\u6B64\u6211\u5011\u5F97\u8981\\n\u8173\u8E0F\u5BE6\u5730\u53BB\u4ED4\u7D30\u8ABF\u67E5\u624D\u884C\uFF01[VAR 0114(0046)]",
  "\u63A5\u4E0B\u4F86\uFF0C\\n\u6211\u60F3\u8ACB\u52A9\u624B[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E6B\u5FD9\u7684\u5C31\u662F\\r\\n[VAR FF00(0006)]\u62CD\u651D\u5BF6\u53EF\u5922\u7684\u7167\u7247[VAR FF00(0000)]\uFF01[VAR 0114(0046)]",
  "\u6211\u60F3\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u62CD\u651D\u4E26\u8ABF\u67E5\u5728\u6709\u9727\u7684\u591C\u665A\\n\u51FA\u73FE\u5728\u9019\u4E00\u5E36\u7684\u5BF6\u53EF\u5922\u3002[VAR 0114(0046)]",
  "\u53EA\u8981[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E6B\u5404\u7A2E\u5BF6\u53EF\u5922\\n\u62CD\u4E0B\u8A31\u591A\u7684\u7167\u7247\uFF01[VAR 0114(0046)]",
  "\u518D\u628A\u90A3\u4E9B\u8CC7\u6599\u767B\u9304\u5230\\n\u5BF6\u53EF\u5922\u641C\u5C0B\u6A5F\u88E1\uFF01[VAR 0114(0046)]",
  "\u5176\u4ED6\u5BF6\u53EF\u5922\u7684\u53CD\u61C9\\n\u5C31\u6703\u6F38\u6F38\u88AB\u5254\u9664\u2026\u2026\\c\\n\u9019\u6A23\u4E00\u4F86\uFF0C\u6700\u5F8C\u6211\u5011\u5C31\u80FD\u9396\u5B9A\\n\u8D6B\u6708\u6240\u5728\u7684\u5730\u65B9\u5566\uFF01[VAR 0114(0046)]",
  "\u4E0D\u6127\u662F\u59B3\uFF01",
  "\u807D\u4E0D\u61C2\uFF01",
  "\u4EC0\u9EBC\uFF01\uFF1F\\n\u5149\u9760\u525B\u525B\u7684\u8AAA\u660E\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u61C2\u4E86\uFF01\uFF1F[VAR 0114(0046)]",
  "\u6211\u53EA\u662F\u628A\u4E8C\u624B\u5546\u54C1\u5E97\u7D66\u6211\u7684\\n\u8AAA\u660E\u66F8\u62FF\u4F86\u5538\u800C\u5DF2\u3002\\r\\n\u5176\u5BE6\u6211\u4E0D\u592A\u61C2\u9019\u6771\u897F\u7684\u539F\u7406\u662F\u4EC0\u9EBC\u3002[VAR 0114(0046)]",
  "\u2026\u2026\u5C0D\u5427\uFF01\\n\u807D\u4E0D\u61C2\u5C0D\u5427\uFF01[VAR 0114(0046)]",
  "\u5176\u5BE6\u6211\u4E5F\u4E0D\u592A\u61C2\u3002\\n\u4F46\u4E8C\u624B\u5546\u54C1\u5E97\u7D66\u6211\u7684\u8AAA\u660E\u66F8\u4E0A\\r\\n\u5C31\u662F\u9019\u9EBC\u5BEB\u7684\u3002\\r\\n\u6240\u4EE5\u4E00\u5B9A\u4E0D\u6703\u6709\u554F\u984C\u5427\uFF1F[VAR 0114(0046)]",
  "\u6211\u5DF2\u7D93\u8ABF\u67E5\u5230\\n\u9019\u4E00\u5E36\u5728\u6709\u9727\u7684\u591C\u665A\\r\\n\u6703\u6709\u6578\u5341\u7A2E\u5BF6\u53EF\u5922\u51FA\u73FE\u3002[VAR 0114(0046)]",
  "\u6211\u5011\u5006\u5C31\u5206\u982D\u884C\u52D5\u3002\\n\u6211\u60F3\u8ACB\u52A9\u624B[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E6B\u5FD9\u62CD\u4E0B\\r\\n[VAR FF00(0006)]\uFF11\uFF10\u7A2E[VAR FF00(0000)]\u5DE6\u53F3\u7684\u5BF6\u53EF\u5922\u7684\u7167\u7247\u3002[VAR 0114(0046)]",
  "\u8B93\u6211\u5011\u5408\u529B\u8ABF\u67E5\uFF0C\\n\u627E\u51FA\u8D6B\u6708\u6240\u5728\u7684\u5730\u65B9\u5427\uFF01[VAR 0114(0046)]",
  "\u554A\uFF0C\u8A18\u5F97\u628A\u5BF6\u53EF\u5922\\n\u62CD\u5F97\u5927\u4E00\u9EDE\u5594\u3002\\c\\n\u9084\u6709\u5225\u9A0E\u4E0A\u5750\u9A0E\u5BF6\u53EF\u5922\uFF0C\\n\u5426\u5247\u62CD\u651D\u5C0D\u8C61\u6703\u9003\u8D70\u7684\uFF01[VAR 0114(0046)]",
  "\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u6E96\u5099\u597D\u4E86\u5C31\u8DDF\u6211\u8AAA\u4E00\u8072\u5427\uFF0C\\n\u6211\u5011\u53EF\u4EE5\u5728\u5E33\u7BF7\u7B49\u5230[VAR FF00(0006)]\u6709\u9727\u7684\u591C\u665A[VAR FF00(0000)]\u3002[VAR 0114(0046)]"
