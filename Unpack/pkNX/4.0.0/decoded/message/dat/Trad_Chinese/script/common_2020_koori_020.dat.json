[
  "\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u800C\u8A00\uFF0C\u9019\u771F\u662F\u5E78\u904B\u7684\u5929\u6C23\u3002\\n\u662F\u96EA\u5C71\u60F3\u5C55\u73FE\u6EAB\u67D4\u7684\u4E00\u9762\u55CE\uFF1F[VAR 0114(001A)]",
  "\u9019\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u800C\u8A00\u771F\u662F\u5012\u6963\u900F\u9802\u3002\\n\u770B\u4F86\u96EA\u5C71\u662F\u7AD9\u5728\u6211\u9019\u4E00\u908A\u7684\u3002[VAR 0114(001A)]",
  "\u4E00\u5E74\u7576\u4E2D\u6703\u6709\u5E7E\u6B21\\n\u50CF\u9019\u6A23\u7684\u806F\u76DF\u8996\u5BDF\u3002[VAR 0114(001A)]",
  "\u8981\u662F\u5728\u9019\u6E2C\u9A57\u4E2D\u7121\u6CD5\u767C\u63EE\u7A31\u8077\u7684\u5BE6\u529B\uFF0C\\n\u5C31\u6703\u88AB\u64A4\u4E0B\u9053\u9928\u9928\u4E3B\u7684\u8077\u4F4D\u3002[VAR 0114(001A)]",
  "\u2026\u2026\u96D6\u7136\u4E5F\u6148\u8AAA\\n\u9019\u53EA\u662F\u5F62\u5F0F\u4E0A\u7684\u4F8B\u884C\u516C\u4E8B\u2026\u2026[VAR 0114(001A)]",
  "\u8981\u662F\u5728\u8EAB\u70BA\u55AE\u677F\u6ED1\u96EA\u9078\u624B\u7684\u5922\u60F3\u7834\u788E\u5F8C\uFF0C\\n\u9023\u5269\u4E0B\u7684\u624D\u80FD\u4E5F\u90FD\u88AB\u5426\u5B9A\u7684\u8A71\uFF0C\\r\\n\u90A3\u6211\u9084\u80FD\u5269\u4E0B\u4EC0\u9EBC\uFF1F[VAR 0114(001A)]",
  "\u96D6\u7136\u6211\u8AAA\u4E86\u4E9B\u51B7\u98BC\u98BC\u7684\u8A71\uFF0C\\n\u4E0D\u904E\u2026\u2026\u5176\u5BE6\u4E8B\u60C5\u6C92\u90A3\u9EBC\u8907\u96DC\u3002[VAR 0114(001A)]",
  "\u6211\u53EA\u8981\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u51B7\u5230\u5FB9\u9AA8\uFF0C\\n\u51CD\u5230\u9AD4\u7121\u5B8C\u819A\u5C31\u662F\u4E86\u3002[VAR 0114(001A)]",
  "\u4E5F\u6148\u4E5F\u771F\u662F\u58DE\u5FC3\u3002\\n\u7ADF\u7136\u6D3E\u4E86\u4E00\u500B\u6211\u7D55\u5C0D\u6253\u4E0D\u8D0F\u7684\u5C0D\u624B\u4F86\u3002[VAR 0114(001A)]",
  "\u4F46\u6211\u4E26\u4E0D\u5F8C\u6094\u3002\\n\u6211\u81EA\u8A8D\u662F\u4F7F\u76E1\u4E86\u6240\u6709\u5BE6\u529B\u3002[VAR 0114(001A)]",
  "\u6211\u5168\u5FC3\u5168\u529B\u5C0D\u6297[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\u4E26\u4E14\u8F38\u4E86\u2026\u2026\\n\u9019\u8B93\u6211\u611F\u5230\u4E0D\u7518\u5FC3\u3002[VAR 0114(001A)]",
  "\u8B93\u6211\u60F3\u8981\u518D\u66F4\u8A8D\u771F\u9EDE\\n\u4F86\u64D4\u4EFB\u9053\u9928\u9928\u4E3B\u3002[VAR 0114(001A)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u518D\u6B21\u9EDE\u71C3\u4E86\\n\u6211\u90A3\u51B7\u537B\u5DF2\u4E45\u7684\u71B1\u60C5\u3002\\r\\n\u2026\u2026\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C[VAR 0100(0000)]\u3002[VAR 0114(001A)]",
  "\u4E0B\u6B21\u5C0D\u6230\u6642\uFF0C\u6211\u4E0D\u6703\u8F38\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u3002[VAR 0114(001A)]",
  "\u4E0B\u96EA\u5C71\u6642\u591A\u5C0F\u5FC3\uFF0C\\n\u5225\u611F\u5192\u4E86\u3002[VAR 0114(001A)]"
]
