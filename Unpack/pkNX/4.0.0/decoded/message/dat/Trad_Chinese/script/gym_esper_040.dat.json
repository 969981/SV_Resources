  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u68D2\u2026\u2026\uFF01\\n\u975E\u5E38\u5730\uFF0C\u55EF\uFF0C\u9802\u7D1A\u68D2\u2026\u2026\uFF01[VAR 0114(001C)]",
  "\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u54EA\u5929\u6210\u70BA\u5927\u4EBA\u7269\u4E4B\u524D\uFF0C\\n\u4E5F\u8A31\u8389\u666E\u6211\u8A72\u628A[VAR 1100(00FF,0101)]\u4F60\u59B3\u7D66\u79C1\u85CF\u8D77\u4F86\uFF1F[VAR 0114(001C)]",
  "\u2026\u2026\u4F46\u662F\u8389\u666E\u6211\u73FE\u5728\u5F97\\n\u91CD\u65B0\u7422\u78E8\u7422\u78E8\u81EA\u5DF1\u624D\u662F\u3002[VAR 0114(001C)]",
  "[VAR 0100(0000)]\uFF0C\u606D\u559C\u3002\\n\u7576\u4F5C\u734E\u52F5\u7684\u9053\u9928\u5FBD\u7AE0\uFF0C\\r\\n\u5C31\u8B93\u6211\u7528\u9019\u500B\u58D3\u7BB1\u59FF\u52E2\u4EA4\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\u3002[VAR 0114(001C)]",
  "\u5982\u679C\u6709[VAR 0200(0001)]\u500B\u9053\u9928\u5FBD\u7AE0\uFF0C\\n\u5C31\u6703\u6BD4\u8F03\u5BB9\u6613\u6355\u6349\u7B49\u7D1A[VAR 0201(0002)]\u4EE5\u4E0B\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u800C\u4E14\u7260\u5011\u90FD\u6703\u4E56\u5DE7\u5730\u807D\u8A71\u5462\u3002[VAR 0114(001C)]",
  "\u8981\u662F\u6709\uFF18\u500B\u9053\u9928\u5FBD\u7AE0\u7684\u8A71\uFF0C\\n\u4E0D\u8AD6\u4EC0\u9EBC\u5BF6\u53EF\u5922\u90FD\u80FD\u6349\u5230\u624B\uFF0C\\r\\n\u800C\u4E14\u7260\u5011\u90FD\u6703\u4E56\uFF5E\u5DE7\u5730\u807D\u8A71\u5462\u3002[VAR 0114(001C)]",
  "\u53EA\u8981\u597D\u597D\u935B\u934A\u9AD4\u5E79\uFF0C\\n\u9019\u500B\u62DB\u5F0F\u4E5F\u80FD\u7528\u5F97\u5F97\u5FC3\u61C9\u624B\u7684\u3002[VAR 0114(001C)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u548C\u8389\u666E\u6211\u7684\u96D9\u4EBA\u7167\uFF0C\\n\u5343\u842C\u4E0D\u53EF\u4EE5\u653E\u4E0A\u7DB2\u8DEF\u55B2\u3002[VAR 0114(001C)]",
  "\u2026\u2026\u53C8\u662F\u6D41\u6C57\u53C8\u662F\u4EC0\u9EBC\u7684\uFF0C\\n\u8B93\u6211\u6709\u9EDE\u6389\u599D\u4E86\u5462\u3002[VAR 0114(001C)]",
