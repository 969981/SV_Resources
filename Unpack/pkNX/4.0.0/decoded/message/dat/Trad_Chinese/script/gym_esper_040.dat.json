[
  "[VAR 0100(0000)]\uFF0C\\n\u6B61\u8FCE\u5149\u81E8\u7119\u56FA\u9053\u9928\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u6311\u6230\u8D85\u80FD\u9B54\u6CD5\u5E7B\u599D\u5E2B\u2026\u2026\\n\u9053\u9928\u9928\u4E3B\u8389\u666E\u55CE\uFF1F",
  "\u90A3\u9EBC\uFF0C\u8ACB\u8B93\u6211\u5E36[VAR 1100(00FF,0101)]\u4F60\u59B3\u524D\u5F80\u5C0D\u6230\u5834\u3002",
  "\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u6E96\u5099\u597D\u5F8C\uFF0C\\n\u8ACB\u96A8\u6642\u544A\u8A34\u6211\u4E00\u8072\u3002",
  "\u9019\u6A23\u55CE\u2026\u2026\u6211\u77E5\u9053\u4E86\u3002\\n\u7531\u6211\u9019\u908A\u9032\u884C\u5427\u3002[VAR 0114(002C)]",
  "\u5EE3\u544A\u8A5E\u5C31\u7528\u6613\u61C2\u7684\\n\u300C\u81EA\u7136\uFF0C\u5E36\u4F86\u7F8E\u9E97\u300D\u3002[VAR 0114(002C)]",
  "\u65B0\u984F\u8272\u7684\u773C\u5F71\\n\u4E5F\u62DC\u8A17\u4F60\u4E0B\u55AE\u560D\u3002[VAR 0114(002C)]",
  "\u2026\u2026\u54EA\u88E1\uFF0C\u8B1D\u8B1D\u4F60\u5594\u3002\\n\u90A3\u9EBC\uFF0C\u518D\u806F\u7D61\uFF5E[VAR 0114(002C)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u554A\uFF5E[VAR 0114(002C)]",
  "\u6211\u662F\u9053\u9928\u9928\u4E3B\u8389\u666E\u3002\\c\\n\u4F46\u5176\u5BE6\u5F69\u599D\u85DD\u8853\u5BB6\\n\u624D\u662F\u6211\u7684\u672C\u884C\u3002[VAR 0114(001C)]",
  "\u51F0\u6A97\u5979\u6709\u8A87\u734E[VAR 1100(00FF,0101)]\u4F60\u59B3\u55B2\u3002\\n\u5979\u8AAA[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F88\u9739\u9742\u5462\u3002[VAR 0114(001C)]",
  "\u55EF\u5475\u5475\u2026\u2026[VAR 0100(0000)]\u3002\\n\u53EF\u611B\u7684\u6311\u6230\u8005\u3002[VAR 0114(001C)]",
  "\u8389\u666E\u6211\u63A8\u51FA\u7684\u9AD4\u64CD\u8B93\u4F60\u5011\u8B8A\u5F97\u66F4\u7F8E\uFF0C\\n\u4F60\u5011\u4E00\u5B9A\u5F88\u9AD8\u8208\u5427\uFF1F[VAR 0114(001C)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u628A\u5BF6\u53EF\u5922\u7684\u5916\u8868\\n\u4E5F\u6574\u7406\u5F97\u4E7E\u4E7E\u6DE8\u6DE8\u3002\\r\\n\u2026\u2026[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F88\u6709\u7F8E\u89C0\u610F\u8B58\u55B2\u3002[VAR 0114(001C)]",
  "[~ 30]",
  "\u4E0D\u8AD6\u662F\u4EBA\u985E\u6216\u5BF6\u53EF\u5922\uFF0C\\n\u5100\u5BB9\u6253\u626E\u90FD\u662F\u5F88\u91CD\u8981\u7684\u5462\u3002[VAR 0114(001C)]",
  "\u80FD\u8B93\u4EFB\u4F55\u4EBA\u90FD\u6416\u8EAB\u4E00\u8B8A\u7684\u9B54\u8853\u3002\\n\u2026\u2026\u90A3\u5C31\u662F\u5316\u599D\u3002\\r\\n\u2026\u2026\u90A3\u5C31\u662F\u5F69\u599D\u3002[VAR 0114(001C)]",
  "\u8B93\u8389\u666E\u6211\u7684\u62DB\u5F0F\u628A[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\\n\u8B8A\u5F97\u66F4\uFF5E\u7F8E\u9E97\u5427\uFF01\uFF01[VAR 0114(001C)]",
