[
  "\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01\\n\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01[VAR 0114(0041)]",
  "\u6BC5\u842C\uFF0C\u4F60\u770B\uFF01\\n\u9019\u88E1\u6709\u500B\u6C34\u7AAA\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u99A5\u597D\uFF0C\u9019\u662F\u4E00\u5EA7\u6E56\uFF01\\n\u5B83\u662F\u5E15\u5E95\u4E9E\u6700\u5927\u7684\u6E56\uFF01\\r\\n\u5927\u540D\u9F0E\u9F0E\u7684\u5927\u934B\u6E56\uFF01[VAR 0114(0040)]",
  "\u9019\u3001\u9019\u662F\u4E00\u5EA7\u6E56\uFF01\uFF1F\\n\u5C31\u7B97\u6211\u9000\u8B93\u4E00\u767E\u6B65\u597D\u4E86\uFF0C\u9019\u4E0D\u662F\u6C60\u5858\uFF01\uFF1F[VAR 0114(0041)]",
  "\u6211\u8AAA\uFF0C\u6BC5\u842C\u2026\u2026\\n\u6C60\u5858\u548C\u6E56\u6CCA\u662F\u54EA\u88E1\u4E0D\u4E00\u6A23\uFF1F\u5475\u3002[VAR 0114(0041)]",
  "\u6211\u4E0D\u77E5\u9053\uFF0C\u99A5\u597D\u2026\u2026\\n\u6211\u5011\u540D\u6D41\u7684\u50F9\u503C\u6A19\u6E96\uFF0C\\r\\n\u6BD4\u4E00\u822C\u4EBA\u9084\u4F86\u5F97\u4E0D\u5728\u610F\u9019\u7A2E\u6E3A\u5C0F\u4E8B\u7269\u2026\u2026[VAR 0114(0040)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\\n\u662F\u90A3\u4F4D\u6BCF\u6B21\u90FD\u6703\u898B\u5230\u7684\u5EB6\u6C11\uFF01[VAR 0114(0041)]",
  "\u771F\u7684\u8036\uFF5E\u90A3\u80AF\u5B9A\u5C31\u662F\u90A3\u4F4D\\n\u6211\u5011\u6BCF\u6B21\u90FD\u6703\u898B\u5230\u7684\u5EB6\u6C11\u4E86\uFF01[VAR 0114(0040)]",
  "\u6211\u8AAA\u5440\uFF0C\u9019\u4F4D\u5EB6\u6C11\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u6C60\u5858\u548C\u6E56\u6CCA\u54EA\u88E1\u4E0D\u4E00\u6A23\u55CE\uFF1F\u5475\u3002[VAR 0114(0041)]",
  "\u5927\u5C0F\uFF1F",
  "\u6DF1\u6DFA\uFF1F",
  "\u539F\u4F86\u5982\u6B64\uFF0C\u771F\u4E0D\u6127\u662F\u5EB6\u6C11\uFF01\\n\u679C\u7136\u77E5\u9053\u5F88\u591A\u4E00\u822C\u77E5\u8B58\uFF01[VAR 0114(0041)]",
  "\u4EE5\u79AE\u9084\u79AE\\n\u6B63\u662F\u6211\u5011\u540D\u6D41\u7684\u8077\u8CAC\u2026\u2026[VAR 0114(0041)]",
  "\u4E5F\u5C31\u662F\u8AAA\uFF0C\\n\u9019\u500B\u6771\u897F\u5C31\u9001\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u5EB6\u6C11\u554A\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u807D\u597D\u4E86\u3002\\n\u6240\u8B02\u7684\u5E78\u798F\uFF0C\u5C31\u50CF\u662F\u5728\u6C34\u908A\u4E00\u6A23\u2026\u2026[VAR 0114(0041)]",
  "\u7A76\u7ADF\u662F\u6C34\u7AAA\u3001\u6C60\u5858\u9084\u662F\u6E56\u6CCA\uFF0C\\n\u53D6\u6C7A\u65BC\u81EA\u8EAB\u7684\u60F3\u6CD5\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u771F\u4E0D\u6127\u662F\u99A5\u597D\uFF01\\n[VAR 1100(00FF,0101)]\u4ED6\u5979\u525B\u525B\u6559\u59B3\u7684\u77E5\u8B58\uFF0C\\r\\n\u59B3\u99AC\u4E0A\u5C31\u79C0\u7D66\u672C\u4EBA\u807D\uFF01[VAR 0114(0040)]",
  "\u597D\u4E86\uFF0C\u6BC5\u842C\uFF01\\n\u6211\u60F3\u53BB\u722C\u722C\u770B\u50CF\u6211\u516C\u53F8\u4E00\u6A23\\r\\n[VAR FF00(0006)]\u6F54\u767D\u7684\u5C71[VAR FF00(0000)]\u3002[VAR 0114(0041)]",
  "\u55B2\uFF5E\uFF01\u5E15\u5E95\u4E9E\u4E0D\u52D5\u7522\\n\u8AAA\u8D77\u4F86\u4E5F\u7B97\u662F\u500B\u6F54\u767D\u7684\u597D\u4F01\u696D\u561B\uFF01\\r\\n\u99A5\u597D\u59B3\u771F\u662F\u540D\u6D41\u7684\u5178\u7BC4\uFF01[VAR 0114(0040)]",
  "\u6211\u5011\u5728\u96EA\u5C71\u4E00\u908A\u6B23\u8CDE\u51B0\u5C6C\u6027\u5BF6\u53EF\u5922\uFF0C\\n\u4E00\u908A\u54C1\u5690\u51B0\u6DC7\u6DCB\u5427\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u842C\u5148\u751F\\n\u524D\u5F80\u5E15\u5E95\u4E9E\u4E2D\u5EE3\u5927\u7684\u6C34\u908A\u4E86\u3002",
  "\u5EE3\u5927\u7684\u6C34\u908A\u6307\u7684\u662F\u2026\u2026\\n\u6CB3\u5DDD\uFF1F\u6C60\u5858\uFF1F\\r\\n\u96E3\u9053\u8AAA\u662F\u6E56\u6CCA\uFF1F"
]
