[
  "\u5C45\u6C11\u6703\u9928\u662F\u5730\u5340\u5C45\u6C11\\n\u805A\u5728\u4E00\u8D77\u5B78\u7FD2\u3001\u4EA4\u6D41\uFF0C\\r\\n\u4EE5\u53CA\u4F11\u606F\u7684\u5730\u65B9\u5594\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u904E\u6176\u5178\u4E86\u55CE\uFF1F\\n\u6176\u5178\u9084\u6703\u8209\u8FA6\u4E00\u9663\u5B50\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u73A9\u500B\u958B\u5FC3\u5594\u3002",
  "\u6211\u807D\u5230\u5BF6\u4F34\u5EE3\u5834\u90A3\u88E1\\n\u50B3\u4F86\u4E86\u597D\u5927\u7684\u8072\u97FF\u2026\u2026\\r\\n\u4F46\u6211\u5011\u53C8\u6C92\u6709\u8A08\u5283\u8981\u653E\u7159\u706B\u554A\u3002",
  "\u6211\u842C\u842C\u6C92\u60F3\u5230\u5384\u9B3C\u692A\\n\u7ADF\u7136\u9577\u5F97\u90A3\u9EBC\u53EF\u611B\uFF01\\c\\n\u2026\u2026\u4E5F\u8A31\u6211\u8A72\u53BB\u627E\u7BA1\u7406\u54E1\u5546\u91CF\u4E00\u4E0B\uFF0C\\n\u770B\u53EF\u4E0D\u53EF\u4EE5\u505A\u4E9B\u5384\u9B3C\u692A\u7684\u5468\u908A\u5546\u54C1\uFF1F",
  "\u8AAA\u5230\u5E15\u5E95\u4E9E\u5730\u5340\uFF0C\\n\u90A3\u88E1\u6709\u9593\u5F88\u5927\u7684\u5B78\u6821\u5427\uFF01",
  "\u8AAA\u5230\u6176\u5178\uFF0C\u600E\u9EBC\u80FD\u6C92\u6709\u5228\u51B0\uFF01\\c\\n\u6211\u63A8\u85A6[VAR 1100(00FF,0101)]\u4F60\u59B3\u5403\u85CD\u8272\u963F\u7F85\u62C9\u53E3\u5473\u5594\u3002\\n\u2026\u2026\u820C\u982D\u6703\u8B8A\u85CD\u5C31\u662F\u4E86\uFF01",
  "\u6211\u7E3D\u89BA\u5F97\u5916\u9762\u9B27\u54C4\u54C4\u7684\uFF0C\\n\u96E3\u4E0D\u6210\u662F\u5BF6\u4F34\u5FA9\u6D3B\u4E86\uFF1F\\r\\n\u2026\u2026\u624D\uFF5E\u602A\u5462\uFF0C\u8AAA\u7B11\u800C\u5DF2\uFF0C\u5475\u5475\u5475\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u898B\u5230\u5384\u9B3C\u692A\u4E86\u55CE\uFF01\uFF1F\\c\\n\u6211\u731C\u660E\u5E74\u7684\u6176\u5178\u554A\uFF0C\\n\u9B3C\u9762\u5177\u4E00\u5B9A\u6703\u5927\u53D7\u6B61\u8FCE\uFF01"
]
