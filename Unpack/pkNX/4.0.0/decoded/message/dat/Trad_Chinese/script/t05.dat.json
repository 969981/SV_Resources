[
  "\u6211\u548C\u6469\u6258\u8725\u7A7F\u904E\u6C99\u6F20\u5230\u9019\u88E1\u4F86\uFF0C\\n\u771F\u662F\u7D2F\u58DE\u4E86\uFF5E\uFF01\\c\\n\u4E0D\u8AD6\u662F\u4EBA\u9084\u662F\u5BF6\u53EF\u5922\uFF0C\\n\u90FD\u5F97\u597D\u597D\u4F11\u606F\u624D\u884C\u3002",
  "\u9019\u88E1\u662F\u6F2C\u6C81\u93AE\u3002\\n\u77E5\u540D\u7684\u5E02\u5834\u975E\u5E38\u71B1\u9B27\uFF01",
  "\u8D70\u904E\u8DEF\u904E\u4E0D\u8981\u932F\u904E\uFF01\\n\u65B0\u9BAE\u597D\u8CA8\u901A\u901A\u6709\uFF01",
  "\u6F2C\u6C81\u5C31\u662F\u7528\u6AB8\u6AAC\u6C41\u6216\u918B\\n\u4F86\u9183\u6F2C\u8089\u6216\u9B5A\u7684\u8ABF\u7406\u65B9\u6CD5\uFF01",
  "\u9019\u500B\u57CE\u93AE\u7684\u98DF\u7269\\n\u975E\uFF5E\u5E38\u5730\u597D\u5403\uFF01\\c\\n\u7D20\u6750\u65B0\u9BAE\u5F97\u6D3B\u8E66\u4E82\u8DF3\uFF01\\n\u5C31\u50CF\u6211\u4E00\u6A23\u5594\uFF5E\uFF01",
  "\u9019\u500B\u5E02\u5834\u88E1\u9762\u6709\u5C0D\u6230\u5834\uFF01\\c\\n\u9019\u500B\u5730\u65B9\u7981\u6B62\u5435\u67B6\uFF01\\n\u4E00\u5207\u90FD\u7528\u5BF6\u53EF\u5922\u5C0D\u6230\u4F86\u88C1\u5B9A\u3002",
  "\u807D\u8AAA\u5728\u6211\u51FA\u751F\u4EE5\u524D\uFF0C\\n\u9019\u500B\u5E02\u5834\u7E3D\u662F\u4E0D\u65B7\u767C\u751F\u53E3\u89D2\uFF01\\c\\n\u73FE\u5728\u4E0D\u4F46\u89C0\u5149\u5BA2\u8B8A\u591A\u4E86\uFF0C\\n\u5C0F\u5B69\u5B50\u4E5F\u80FD\u653E\u5FC3\u5730\u5230\u9019\u88E1\u4F86\u3002",
  "\u9019\u4F4D\u540C\u5B78\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u8981\u53C3\u52A0\u62CD\u8CE3\u6703\u55CE\uFF1F\\c\\n\u8981\u5C0F\u5FC3\u4E0D\u8981\u558A\u5230\u592A\u9AD8\u7684\u50F9\u683C\uFF0C\\n\u6700\u5F8C\u8B8A\u6210\u7AAE\u5149\u86CB\u554A\uFF01",
  "\u5230\u4E86\u591C\u665A\uFF0C\\n\u5E7D\u9748\u5BF6\u53EF\u5922\u5C31\u6703\u51FA\u73FE\u5728\u57CE\u93AE\u7684\u7A7A\u4E2D\u3002\\r\\n\u2026\u2026\u5230\u5E95\u662F\u70BA\u4EC0\u9EBC\u5462\uFF1F",
  "\u5F9E\u6D77\u4E0A\u5439\u4F86\u7684\u6D77\u98A8\\n\u771F\u7684\u597D\u8212\u670D\u5594\uFF5E\uFF01\\c\\n\u4F46\u92FC\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\u6703\u88AB\u9E7D\u9183\uFF0C\\n\u6216\u8A31\u7260\u5011\u4E0D\u592A\u559C\u6B61\uFF1F",
  "\u5750\u9A0E\u5BF6\u53EF\u5922\u975E\u5E38\u53EF\u9760\uFF01\\c\\n\u5076\u723E\u63DB\u6211\u4F86\u80CC\u7260\u597D\u4E86\uFF01\\n\u554A\u54C8\u54C8\uFF01",
  "\u53C8\u662F\u50B3\u55AE\uFF01\\c\\n\u628A\u50B3\u55AE\u63C9\u6210\u4E00\u5718\\n\u4F86\u8DDF\u5BF6\u53EF\u5922\u73A9\u597D\u4E86\u2026\u2026",
  "\u9019\u500B\u56DB\u89D2\u5F62\u7684\u6771\u897F\u662F\u8CA8\u6AC3\u5594\u3002\\c\\n\u6211\u5011\u6703\u628A\u8A31\u591A\u7684\u8CA8\u7269\u585E\u9032\u8CA8\u6AC3\u88E1\uFF0C\\n\u518D\u904B\u9001\u5230\u5927\u6D77\u7684\u53E6\u4E00\u7AEF\u3002",
  "\u8981\u53BB\u9059\u9060\u7684\u5730\u5340\u6642\uFF0C\u5C31\u642D\u8239\u79FB\u52D5\uFF01\\n\u56E0\u70BA\u9760\u5750\u9A0E\u5BF6\u53EF\u5922\u7684\u8A71\uFF0C\u6703\u7D2F\u58DE\u7684\u3002",
  "\u4E4B\u524D\u6211\u6E38\u5230\u5C0D\u9762\u7684\u5CA9\u77F3\u5340\u6642\uFF0C\\n\u770B\u5230\u5CA9\u77F3\u5340\u7684\u4E0A\u9762\u597D\u50CF\u6709\u4EC0\u9EBC\u6771\u897F\u2026\u2026\uFF01\\c\\n\u4E0D\u904E\u4E0D\u722C\u4E0A\u61F8\u5D16\u7684\u8A71\uFF0C\\n\u6050\u6015\u662F\u62FF\u4E0D\u5230\u7684\u2026\u2026",
  "\u54C7\uFF5E\u7528\u81C9\u90E8\u93E4\u7A7A\u677F\\n\u53EF\u4EE5\u62CD\u51FA\u5F88\u6709\u8DA3\u7684\u7167\u7247\u8036\uFF01",
  "\u90A3\u500B\uFF0C\u6211\u77E5\u9053\u662F\u6CE2\u666E\u6D77\u8C5A\u6C92\u932F\uFF0C\\n\u4F46\u808C\u8089\u7D50\u5BE6\u7684\u90A3\u500B\u662F\u2026\u2026\uFF1F\\r\\n\u6709\u9019\u7A2E\u5BF6\u53EF\u5922\u55CE\u2026\u2026\uFF1F",
  "\u5927\u96FB\u6D77\u71D5\u5728\u6D77\u9762\u4E0A\u98DB\u7FD4\u7684\u6A23\u5B50\uFF0C\\n\u771F\u7684\u5F88\u4E0A\u76F8\u5462\uFF5E\\c\\n\u90A3\u4E9B\u5B69\u5B50\u6709\u6642\u5019\u6703\u5728\\n\u57CE\u93AE\u5F8C\u65B9\u7684\u6D77\u7058\u4F11\u606F\u5594\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u53BB\u904E\u73BB\u74F6\u5E02\u7684\\n\u6D77\u5CB1\u4FF1\u6A02\u90E8\u5403\u98EF\u55CE\uFF1F\\c\\n\u807D\u8AAA\u90A3\u88E1\u7528\u7684\u662F\\n\u6F2C\u6C81\u93AE\u7684\u65B0\u9BAE\u98DF\u6750\u5594\uFF01",
  "\u73BB\u74F6\u9053\u9928\u7684\u6D77\u5CB1\\n\u6709\u6642\u5019\u6703\u4F86\u9019\u500B\u5E02\u5834\uFF01\\c\\n\u4ED6\u8981\u662F\u5728\u62CD\u8CE3\u6703\u88E1\u5F97\u6A19\uFF0C\\n\u5C31\u6703\u958B\u5FC3\u5F97\u624B\u821E\u8DB3\u8E48\u7684\u3002",
  "\u6211\u5E74\u8F15\u7684\u6642\u5019\uFF0C\\n\u53C8\u662F\u53C3\u52A0\u62CD\u8CE3\u53C8\u662F\u611B\u5435\u67B6\uFF0C\\r\\n\u5404\u7A2E\u4E0D\u5B89\u5206\u7684\u4E8B\u901A\u901A\u5C11\u4E0D\u4E86\u6211\u7684\u4EFD\u3002",
  "\u9019\u500B\u6D77\u7058\u5F88\u68D2\u537B\u6C92\u4EC0\u9EBC\u4EBA\u77E5\u9053\uFF01\\n\u5927\u5BB6\u90FD\u88AB\u5E02\u5834\u7D66\u5438\u5F15\u53BB\u4E86\u3002"
]
