[
  "\u5404\u4F4D\u540C\u5B78\u5927\u5BB6\u597D\uFF0C\\n\u8B93\u6211\u5011\u5FEB\u5FEB\u6A02\u6A02\u5B78\u6578\u5B78\u5427\u3002[VAR 0114(0025)]",
  "\u5927\u5BB6\u5728\u4E0A\u4E00\u5802\u8AB2\u4E4B\u5F8C\uFF0C\\n\u6709\u5927\uFF5E\u5E45\u8907\u7FD2\u55CE\uFF1F[VAR 0114(0025)]",
  "\u53C8\u662F\u4E58\u6CD5\uFF0C\u53C8\u662F\u767E\u5206\u6BD4\u7684\uFF0C\\n\u7684\u78BA\u662F\u6709\u90A3\u9EBC\u4E00\u9EDE\u8F9B\u82E6\u5462\u3002[VAR 0114(0025)]",
  "\u90A3\u9EBC\uFF0C\u6211\u5011\u4ECA\u5929\u4E5F\u7E7C\u7E8C\u4F7F\u7528\u767E\u5206\u6BD4\\n\u4E86\u89E3\u4E00\u4E9B\u6A5F\u7387\u7684\u4E8B\u5427\u3002[VAR 0114(0025)]",
  "\u96D6\u7136\u807D\u8D77\u4F86\u5F88\u96E3\uFF0C\\n\u4F46\u5176\u5BE6\u5927\u5BB6\u90FD\u5DF2\u7D93\u719F\u7DF4\u5730\\r\\n\u5728\u4F7F\u7528\u6A5F\u7387\u4E86\u5462\u3002[VAR 0114(0025)]",
  "\u6BCF\u500B\u5BF6\u53EF\u5922\u7684\u62DB\u5F0F\u90FD\u5206\u5225\u6709\u8457\\n\u53EB\u505A\u300C\u547D\u4E2D\u300D\u7684\u6A5F\u7387\u3002\\r\\n\u5B83\u4EE3\u8868\u8457\u62DB\u5F0F\u6703\u4E0D\u6703\u597D\u597D\u64CA\u4E2D\u5C0D\u624B\u3002[VAR 0114(0025)]",
  "\u649E\u64CA\u7684\u547D\u4E2D\u662F\uFF11\uFF10\uFF10\uFF01\\n\u9019\u8868\u793A\uFF11\uFF10\uFF10\uFF05\uFF0C\u4E5F\u5C31\u662F\u8AAA\\r\\n\u4F7F\u51FA\uFF11\uFF10\uFF10\u6B21\u62DB\u5F0F\uFF0C\uFF11\uFF10\uFF10\u6B21\u90FD\u6703\u547D\u4E2D\u3002[VAR 0114(0025)]",
  "\u8B93\u5C0D\u624B\u9677\u5165\u7761\u7720\u72C0\u614B\u7684\u50AC\u7720\u8853\uFF0C\\n\u547D\u4E2D\u662F\uFF16\uFF10\uFF01[VAR 0114(0025)]",
  "\u9019\u8868\u793A\uFF16\uFF10\uFF05\uFF0C\u4E5F\u5C31\u662F\u8AAA\\n\uFF11\uFF10\uFF10\u6B21\u4E2D\u6703\u547D\u4E2D\uFF16\uFF10\u6B21\u2026\u2026\\r\\n\u53CD\u904E\u4F86\u8AAA\uFF0C\u5C31\u662F\u6703\u6709\uFF14\uFF10\u6B21\u6703\u5931\u6557\u3002[VAR 0114(0025)]",
  "\u4E00\u822C\u4F86\u8AAA\uFF0C\u7279\u5225\u5F37\u5927\u7684\u62DB\u5F0F\\n\u5F80\u5F80\u64C1\u6709\u8F03\u4F4E\u7684\u547D\u4E2D\u3002[VAR 0114(0025)]",
  "\u8981\u7528\u4E00\u5B9A\u6703\u547D\u4E2D\u7684\u62DB\u5F0F\u7A69\u7D2E\u7A69\u6253\uFF0C\\n\u9084\u662F\u7528\u4E0D\u4E00\u5B9A\u547D\u4E2D\uFF0C\u4F46\u537B\u5F37\u5927\u7684\u62DB\u5F0F\u2026\u2026[VAR 0114(0025)]",
  "\u5149\u662F\u601D\u8003\u8981\u4F7F\u7528\u4EC0\u9EBC\u62DB\u5F0F\uFF0C\\n\u5404\u4F4D\u540C\u5B78\u5C31\u5DF2\u7D93\u662F\u5728\u5B78\u7FD2\u6A5F\u7387\u4E86\u5462\uFF5E\uFF01[VAR 0114(0025)]",
  "\u8AAA\u5230\u547D\u4E2D\uFF0C\u5E38\u88AB\u63D0\u5230\u7684\\n\u4E5F\u8A31\u5C31\u662F\u885D\u6D6A\u548C\u6C34\u70AE\u4E86\uFF1F[VAR 0114(0025)]",
  "\u885D\u6D6A\u7684\u547D\u4E2D\u662F\uFF11\uFF10\uFF10\uFF0C\\n\u6240\u4EE5\u4E00\u5B9A\u80FD\u7D66\u4E88\u5A01\u529B\uFF19\uFF10\u7684\u50B7\u5BB3\u3002[VAR 0114(0025)]",
  "\u6C34\u70AE\u7684\u547D\u4E2D\u96D6\u7136\u662F\uFF18\uFF10\uFF0C\\n\u4F46\u80FD\u5920\u671F\u5F85\u5A01\u529B\u9AD8\u9054\uFF11\uFF11\uFF10\u7684\u50B7\u5BB3\uFF01[VAR 0114(0025)]",
  "\u885D\u6D6A\u8207\u6C34\u70AE\uFF0C\\n\u5404\u4F4D\u540C\u5B78\u60F3\u9078\u64C7\u54EA\u500B\u62DB\u5F0F\u5462\uFF1F[VAR 0114(0025)]",
  "\u885D\u6D6A",
  "\u6C34\u70AE",
  "\u770B\u60C5\u6CC1",
  "\u54CE\u5440\uFF0C[VAR 0100(0000)]\uFF0C\\n\u539F\u4F86[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u8E0F\u5BE6\u7684\u7A69\u7D2E\u7A69\u6253\u6D3E\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C[VAR 0100(0000)]\uFF0C\\n\u539F\u4F86[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u6D6A\u6F2B\u7684\u653E\u624B\u4E00\u640F\u6D3E\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6B63\u5728\u601D\u8003\u5404\u7A2E\u72C0\u6CC1\u662F\u5427\uFF1F[VAR 0114(0025)]",
  "\u96D6\u7136\u8001\u5E2B\u6211\u5FCD\u4E0D\u4F4F\u554F\u4E86\u5927\u5BB6\uFF0C\\n\u4F46\u9019\u5176\u5BE6\u6C92\u6709\u6B63\u78BA\u7B54\u6848\uFF01\\r\\n\u4F7F\u7528\u81EA\u5DF1\u60F3\u7528\u7684\u62DB\u5F0F\u5C31\u5C0D\u56C9\uFF5E[VAR 0114(0025)]",
  "\u9019\u4E0D\u540C\u65BC\u62DB\u5F0F\u7684\uFF30\uFF30\uFF0C\\n\u6216\u662F\u62DB\u5F0F\u80FD\u5426\u547D\u4E2D\u591A\u500B\u5C0D\u8C61\uFF0C\\r\\n\u4E26\u6C92\u6709\u9078\u54EA\u908A\u6703\u6BD4\u8F03\u597D\u7684\u6B63\u78BA\u7B54\u6848\u5594\u3002[VAR 0114(0025)]",
  "\u9019\u500B\u885D\u6D6A\u6C34\u70AE\u554F\u984C\u662F\\n\u5F9E\u4EE5\u524D\u5C31\u5E38\u88AB\u8B70\u8AD6\u7684\u8A71\u984C\u3002[VAR 0114(0025)]",
  "\u5C31\u8001\u5E2B\u6211\u500B\u4EBA\u800C\u8A00\uFF0C\u5728\u5CA9\u77F3\u5C6C\u6027\u4E2D\\n\u8981\u9078\u64C7\u5CA9\u5D29\u9084\u662F\u5C16\u77F3\u653B\u64CA\u2026\u2026[VAR 0114(0025)]",
  "\u9019\u624D\u662F\u6211\u66F4\u60F3\u8207\u5927\u5BB6\\n\u5927\u524C\u524C\u5730\u8C6A\u9081\u8A0E\u8AD6\u7684\u554F\u984C\u5462\u3002\\r\\n\u54CE\u5440\uFF0C\u662F\u4E0B\u8AB2\u9418\u3002\u771F\u662F\u53EF\u60DC\u2026\u2026[VAR 0114(0025)]",
  "\u4E0B\u6B21\u662F\u5F8C\u534A\u6BB5\u7684\u6700\u5F8C\u4E00\u5802\u8AB2\uFF01\\n\u8B93\u6211\u5011\u4EE5\uFF11\uFF10\uFF10\uFF05\u7684\u529B\u91CF\u898B\u9762\u5427\u3002[VAR 0114(0025)]"
]
