[
  "\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01\\n\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01[VAR 0114(0041)]",
  "\u9019\u5C31\u662F\u50B3\u805E\u4E2D\u7684\\n\u5E15\u5E95\u4E9E\u5341\u666F\u4E4B\u4E00\u2026\u2026[VAR 0114(0041)]",
  "\u6C92\u932F\uFF0C\u99A5\u597D\uFF01\\n\u9019\u6B63\u662F\u4E82\u64CA\u7011\u5E03\uFF01[VAR 0114(0040)]",
  "\u9019\u7011\u5E03\u6BD4\u6211\u60F3\u50CF\u4E2D\u7684\\n\u9084\u8981\u5BD2\u9178\u5462\u2026\u2026\u5475\u3002[VAR 0114(0041)]",
  "\u4F46\u5C31\u7B97\u5BD2\u9178\uFF0C\\n\u6211\u9084\u662F\u80FD\u611F\u53D7\u5230\u8CA0\u96E2\u5B50\uFF0C\u5475\uFF01[VAR 0114(0041)]",
  "\u771F\u4E0D\u6127\u662F\u99A5\u597D\uFF01\\n\u662F\u4E00\u4F4D\u7121\u8AD6\u4F55\u6642\u90FD\u6B63\u9762\u7A4D\u6975\u7684\u6DD1\u5973\uFF01[VAR 0114(0040)]",
  "\u7A7A\u6C23\u4E2D\u4E0D\u53EA\u6709\u8CA0\u96E2\u5B50\uFF0C\\n\u6211\u9084\u611F\u53D7\u5230\u4E86\u540D\u6D41\u96E2\u5B50\uFF01[VAR 0114(0040)]",
  "\u59B3\u7C21\u76F4\u5C31\u662F\u500B\u7642\u7652\u7CFB\u540D\u6D41\uFF01\\n\u55B2\uFF5E\u55B2\uFF5E\uFF01[VAR 0114(0040)]",
  "\u6BC5\u842C\uFF01\\n\u8B1D\u8B1D\u4F60\u6558\u8FF0\u4E86\u4E00\u500B\u4E8B\u5BE6\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u54CE\u5440\u2026\u2026\uFF1F\\n\u662F\u4E0A\u6B21\u90A3\u4F4D\u5EB6\u6C11\uFF01[VAR 0114(0041)]",
  "\u771F\u7684\u8036\uFF5E\\n\u90A3\u80AF\u5B9A\u5C31\u662F\u4E0A\u6B21\u90A3\u4F4D\u5EB6\u6C11\uFF01[VAR 0114(0040)]",
  "\u662F\u5076\u7136\uFF1F\u9084\u662F\u547D\u904B\uFF1F\\n\u4EA6\u6216\u662F\u88AB\u540D\u6D41\u96E2\u5B50\u7D66\u5438\u5F15\u800C\u4F86\u7684\u5462\uFF1F[VAR 0114(0040)]",
  "\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01\\n\u6211\u61C2\uFF01\u6211\u61C2\uFF01[VAR 0114(0041)]",
  "\u70BA\u8001\u767E\u59D3\u5011\u5E36\u4F86\u5922\u60F3\uFF0C\\n\u6B63\u662F\u6211\u5011\u540D\u6D41\u7684\u8077\u8CAC\u2026\u2026[VAR 0114(0041)]",
  "\u4E5F\u5C31\u662F\u8AAA\uFF0C\\n\u9019\u500B\u6771\u897F\u5C31\u9001\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u5EB6\u6C11\u554A\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u807D\u597D\u4E86\u3002\\n\u6240\u8B02\u7684\u9322\uFF0C\u5C31\u50CF\u662F\u8CA0\u96E2\u5B50\u4E00\u6A23\u3002[VAR 0114(0041)]",
  "\u88AB\u74B0\u7E5E\u8457\u7684\u6642\u5019\uFF0C\\n\u5B83\u80FD\u5E36\u4F86\u5B89\u5B9A\u8207\u5B89\u5FC3\uFF0C\u5475\u2026\u2026[VAR 0114(0041)]",
  "\u4F46\u5982\u6B64\u4E00\u4F86\uFF0C\u5C31\u7121\u6CD5\u9AD4\u6703\\n\u7576\u4E0B\u611F\u53D7\u7684\u5E78\u798F\u7A76\u7ADF\u662F\u771F\u662F\u5047\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u597D\u2026\u2026\u597D\u6DF1\u5967\uFF01\\n\u5C0D\u5C0F\u670B\u53CB\u4F86\u8AAA\u592A\u6DF1\u5967\u4E86\uFF0C\u99A5\u597D\uFF01[VAR 0114(0040)]",
  "\u597D\u4E86\uFF0C\u6BC5\u842C\uFF01\\n\u6211\u60F3\u53BB\u8DDF\u77E5\u540D\u666F\u9EDE\u5B8C\u5168\\r\\n\u6CBE\u4E0D\u4E0A\u908A\u7684[VAR FF00(0006)]\u504F\u50FB\u7684\u5730\u65B9[VAR FF00(0000)]\uFF0C\u5475\uFF01[VAR 0114(0041)]",
  "\u55B2\uFF5E\uFF01\\n\u53BB\u4E86\u592A\u591A\u77E5\u540D\u666F\u9EDE\uFF0C\u53BB\u5230\u81A9\u4E86\uFF01\\r\\n\u99A5\u597D\u59B3\u771F\u662F\u540D\u6D41\u7684\u5178\u7BC4\uFF01[VAR 0114(0040)]",
  "\u5357\u7B2C\uFF15\u5340\u548C\u5357\u7B2C\uFF11\u5340\u7684\\n\u908A\u754C\u6709\u500B\u597D\u5730\u65B9\u5594\uFF01[VAR 0114(0040)]",
  "\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u842C\u5148\u751F\\n\u524D\u5F80\u5E15\u5E95\u4E9E\u5730\u5340\u7684\u5317\u7B2C\uFF12\u5340\\r\\n\u6B23\u8CDE\u77E5\u540D\u7684\u7011\u5E03\u4E86\u3002"
