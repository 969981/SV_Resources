[
  "\u8EAB\u70BA\u5BF6\u53EF\u5922\u8A13\u7DF4\u5BB6\uFF01\\n\u6211\u771F\u56AE\u5F80\u300C\u6700\u5F37\u300D\u9019\u5169\u500B\u5B57\u554A\uFF01",
  "\u771F\u5E0C\u671B\u54EA\u5929\u80FD\u770B\u770B\\n\u64C1\u6709\u6700\u5F37\u4E4B\u8B49\u7684\u5BF6\u53EF\u5922\u554A\uFF01",
  "\u4E0D\u662F\u96A8\u96A8\u4FBF\u4FBF\u5728\u54EA\u88E1\u90FD\u770B\u5F97\u5230\uFF0C\\n\u6240\u4EE5\u624D\u53EB\u505A\u6700\u5F37\u554A\uFF01",
  "\u90A3\u96BB\u5BF6\u53EF\u5922\u2026\u2026\\n\u4E26\u6C92\u6709\u6700\u5F37\u4E4B\u8B49\u554A\uFF01",
  "\u90A3\u96BB\u5BF6\u53EF\u5922\u2026\u2026\\n\u662F\u6700\u5F37\u7684[VAR 0101(0001)]\u554A\uFF01\uFF1F",
  "\u54E6\u54E6\u54E6\u2026\u2026\u597D\u53B2\u5BB3\u554A\uFF5E\uFF01\\n\u771F\u662F\u6211\u7684\u5076\u50CF\u554A\uFF5E\uFF01",
  "\u70BA\u4E86\u7B54\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\u6211\u5C31\u6559[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u500B\\n\u4F3D\u52D2\u723E\u5730\u5340\u6B63\u6D41\u884C\u7684\u6700\u5F37\u8868\u60C5\u5427\uFF01",
  "[VAR 0100(0000)]\u5F9E\u7537\u5B69\u90A3\u88E1\\n\u5B78\u6703\u4E86[VAR FF00(0008)]\u5674\u706B\u9F8D\u59FF\u52E2\u8868\u60C5[VAR FF00(0000)]\uFF01",
  "\u5674\u706B\u9F8D\u59FF\u52E2\u53EF\u662F\\n\u4F3D\u52D2\u723E\u5730\u5340\u51A0\u8ECD\u7684\\r\\n\u6700\u5F37\u7684\u62DB\u724C\u59FF\u52E2\u554A\uFF01"
