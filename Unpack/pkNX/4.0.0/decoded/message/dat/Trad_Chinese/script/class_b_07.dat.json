[
  "\u5404\u4F4D\u540C\u5B78\u5927\u5BB6\u597D\uFF0C\u4ECA\u5929\u4E5F\\n\u8B93\u6211\u5011\u5FEB\u5FEB\u6A02\u6A02\u5B78\u6578\u5B78\u5427\u3002[VAR 0114(0025)]",
  "\u4E0A\u4E00\u5802\u8AB2\u6211\u5011\u5229\u7528\u62DB\u5F0F\u7684\u547D\u4E2D\\n\u5B78\u4E86\u6709\u95DC\u6A5F\u7387\u7684\u4E8B\u3002[VAR 0114(0025)]",
  "\u6A5F\u7387\u5F88\u6709\u8DA3\uFF0C\u64DA\u8AAA\u5982\u679C\uFF11\u500B\u73ED\u7D1A\u6709\\n\uFF14\uFF10\u500B\u5B78\u751F\uFF0C\u90A3\u9EBC\u6709\uFF19\uFF10\uFF05\u7684\u6A5F\u7387\\r\\n\u73ED\u4E0A\u6703\u6709\uFF11\u7D44\u751F\u65E5\u4E00\u6A23\u7684\u540C\u5B78\u5594\u3002[VAR 0114(0025)]",
  "\uFF11\u5E74\u660E\u660E\u6709\uFF13\uFF10\uFF10\u591A\u5929\u5462\u3002\\n\u9019\u662F\u4E0D\u662F\u5F88\u4E0D\u53EF\u601D\u8B70\uFF1F[VAR 0114(0025)]",
  "\u8A00\u6B78\u6B63\u50B3\uFF0C\u81F3\u4ECA\u5404\u4F4D\u540C\u5B78\u5DF2\u7D93\u5B78\u4E86\\n\u5C6C\u6027\u76F8\u524B\u3001\u64CA\u4E2D\u8981\u5BB3\u2026\u2026[VAR 0114(0025)]",
  "\u4EE5\u53CA\u80FD\u529B\u63D0\u5347\u4E4B\u985E\u7684\\n\u50B7\u5BB3\u8A08\u7B97\u65B9\u5F0F\uFF0C\u5C0D\u5427\u3002[VAR 0114(0025)]",
  "\u9019\u4E9B\u5168\u90E8\u90FD\u6703\u76F8\u4E58\u8D77\u4F86\uFF0C\\n\u53BB\u524A\u6E1B\u5C0D\u65B9\u7684\u9AD4\u529B\u3002[VAR 0114(0025)]",
  "\u4F46\u662F\uFF0C\u5176\u5BE6\u6709\u500B\u6BD4\u9019\u4E9B\\n\u90FD\u9084\u8981\u7C21\u55AE\u7684\u65B9\u6CD5\uFF0C\\r\\n\u53EF\u4EE5\u63D0\u5347\u62DB\u5F0F\u7D66\u4E88\u7684\u50B7\u5BB3\u5594\u3002[VAR 0114(0025)]",
  "\u90A3\u5C31\u662F\uFF0C\u4F7F\u7528\u8207\u5BF6\u53EF\u5922\u7684\u5C6C\u6027\\n\u76F8\u540C\u5C6C\u6027\u7684\u62DB\u5F0F\uFF01[VAR 0114(0025)]",
  "\u7576\u5CA9\u77F3\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\u4F7F\u7528\\n\u5CA9\u77F3\u5C6C\u6027\u7684\u62DB\u5F0F\uFF0C\u4F8B\u5982\u5C16\u77F3\u653B\u64CA\uFF0C\\r\\n\u5A01\u529B\u5C31\u6703\u5F9E\uFF11\uFF10\uFF10\u8B8A\u6210\uFF11.\uFF15\u500D\u7684\uFF11\uFF15\uFF10\u5462\u3002[VAR 0114(0025)]",
  "\u96D6\u7136\u5F88\u985E\u4F3C\uFF0C\u4F46\u5730\u9762\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\\n\u5373\u4F7F\u4F7F\u7528\u4E86\u5C16\u77F3\u653B\u64CA\uFF0C\\r\\n\u5A01\u529B\u4E5F\u53EA\u6703\u7DAD\u6301\uFF11\uFF10\uFF10\u4E0D\u8B8A\u3002[VAR 0114(0025)]",
  "\u9019\u500B\u6578\u5B57\u6700\u5F8C\u9084\u8981\u518D\u4E58\u4E0A\\n\u6548\u679C\u7D55\u4F73\u6216\u64CA\u4E2D\u8981\u5BB3\u7684\u6548\u679C\uFF0C\\r\\n\u6240\u4EE5\u5343\u842C\u4E0D\u80FD\u5C0F\u770B\u9019\u500B\u6578\u5B57\u5594\u3002[VAR 0114(0025)]",
  "\u90A3\u9EBC\uFF0C\u8B93\u6211\u7528\u9019\u500B\u554F\u984C\\n\u770B\u770B\u5927\u5BB6\u6709\u6C92\u6709\u807D\u61C2\u5427\u3002[VAR 0114(0025)]",
  "\u4F7F\u7528\u5A01\u529B\uFF11\uFF10\uFF10\u4E14\u5C6C\u6027\u4E00\u81F4\u7684\u62DB\u5F0F\uFF0C\\n\u4E14\u9019\u500B\u5C6C\u6027\u6B63\u597D\u662F\u5C0D\u65B9\u7684\u5F31\u9EDE\u6642\uFF0C\\r\\n\u62DB\u5F0F\u7684\u5A01\u529B\u6703\u662F\uFF1F[VAR 0114(0025)]",
  "\uFF11\uFF15\uFF10",
  "\uFF12\uFF10\uFF10",
  "\uFF13\uFF10\uFF10",
  "\u55EF\uFF5E\u53EF\u60DC\uFF01\\n\u5982\u679C\u662F\uFF11\uFF15\uFF10\uFF0C\u5C31\u53EA\u6709\u4E58\u4E0A\u4E86\\r\\n\u5C6C\u6027\u4E00\u81F4\u9020\u6210\u7684\uFF11.\uFF15\u500D\u6548\u679C\u5594\u3002[VAR 0114(0025)]",
  "\u55EF\uFF5E\u53EF\u60DC\uFF01\\n\u5982\u679C\u662F\uFF12\uFF10\uFF10\uFF0C\u5C31\u53EA\u6709\u4E58\u4E0A\u4E86\\r\\n\u5F31\u9EDE\u9020\u6210\u7684\uFF12\u500D\u6548\u679C\u5594\u3002[VAR 0114(0025)]",
  "\u5FC3\u7B97\u53EF\u4E0D\u5BB9\u6613\u5462\uFF01\\n[VAR 0100(0000)]\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u68D2\u554A\uFF01[VAR 0114(0025)]",
  "\u5A01\u529B\uFF11\uFF10\uFF10\u7684\u62DB\u5F0F\u4E58\u4E0A\\n\u5C6C\u6027\u4E00\u81F4\u7684\uFF11.\uFF15\u500D\u6548\u679C\uFF0C\\r\\n\u5A01\u529B\u5C31\u662F\uFF11\uFF15\uFF10\uFF01[VAR 0114(0025)]",
  "\uFF11\uFF15\uFF10\u518D\u4E58\u4EE5\u5F31\u9EDE\uFF12\u500D\u7684\u6548\u679C\uFF0C\\n\u5C31\u80FD\u5F97\u5230\uFF13\uFF10\uFF10\uFF01[VAR 0114(0025)]",
  "\u54C7\uFF01\u7ADF\u7136\u6703\u8B8A\u6210\\n\u539F\u672C\u5A01\u529B\u7684\uFF13\u500D\u5594\uFF01[VAR 0114(0025)]",
  "\u800C\u4E14\uFF0C\u5982\u679C\u5BF6\u53EF\u5922\u6210\u70BA\u4E86\\n\u8207\u539F\u672C\u5C6C\u6027\u76F8\u540C\u7684\u592A\u6676\u5C6C\u6027\u7684\u8A71\uFF0C\\r\\n\u5C6C\u6027\u4E00\u81F4\u6642\u7684\u5A01\u529B\u5C31\u4E0D\u662F\uFF11.\uFF15\u500D\uFF0C\\r\\n\u800C\u662F\u6703\u8B8A\u6210\uFF12\u500D\u5462\uFF01[VAR 0114(0025)]",
  "\u7576\u7136\uFF0C\u80FD\u4F7F\u7528\u4E0D\u540C\u5C6C\u6027\u7684\u5404\u7A2E\u62DB\u5F0F\uFF0C\\n\u4E5F\u662F\u5F88\u53B2\u5BB3\u7684\u4E8B\u60C5\u3002\\r\\n\u9019\u53EF\u4EE5\u8B93\u5C0D\u624B\u5927\u5403\u4E00\u9A5A\u5462\u3002[VAR 0114(0025)]",
  "\u4F46\u662F\uFF0C\u4E0D\u8AD6\u662F\u4EBA\u6216\u662F\u5BF6\u53EF\u5922\u2026\u2026[VAR 0114(0025)]",
  "\u8AAA\u5230\u5E95\u90FD\u662F\u5728\u62FF\u51FA\u81EA\u5DF1\u7684\u672C\u8272\u6642\uFF0C\\n\u624D\u662F\u6700\u80FD\u767C\u63EE\u5BE6\u529B\u7684\u3002[VAR 0114(0025)]",
  "\u8981\u662F\u5404\u4F4D\u540C\u5B78\u80FD\u8A18\u4F4F\u9019\u4E00\u9EDE\uFF0C\\n\u8001\u5E2B\u6211\u6703\u5F88\u9AD8\u8208\u5594\u3002[VAR 0114(0025)]",
  "\u2026\u2026\u9019\u662F\u500B\u5F88\u57FA\u672C\u7684\u4E8B\u60C5\u3002\\n\u8981\u662F\u5927\u5BB6\u65E9\u5C31\u77E5\u9053\u4E86\uFF0C\u90A3\u5C31\u62B1\u6B49\u56C9\u3002[VAR 0114(0025)]",
  "\u6700\u5F8C\u4E00\u5802\u8AB2\\n\u4E5F\u662F\u8F49\u773C\u9593\u5C31\u7D50\u675F\u4E86\u3002[VAR 0114(0025)]",
  "\u5927\u5BB6\u9019\u9EBC\u7A4D\u6975\u5730\u5B78\u6578\u5B78\uFF0C\\n\u8001\u5E2B\u6211\u6559\u8AB2\u6559\u5F97\u5F88\u958B\u5FC3\u5462\u3002[VAR 0114(0025)]",
  "\u4E0B\u6B21\u662F\u5FEB\u5FEB\u6A02\u6A02\u7684\u671F\u672B\u8003\uFF01\\n\u5927\u5BB6\u5728\u8003\u8A66\u524D\u8981\u597D\u597D\u8907\u7FD2\u5594\u3002[VAR 0114(0025)]"
]
