  "\u62B1\u6B49\uFF01\u6211\u6D3E\u51FA\u592A\u591A\\n\u5F37\u904E\u982D\u7684\u5BF6\u53EF\u5922\u4E86\u3002[VAR 0114(0004)]",
  "\u54CE\uFF5E\u4E0D\u904E\uFF0C\u9019\u771F\u662F\u4E00\u5834\\n\u6536\u7A6B\u591A\u591A\u7684\u7CBE\u5F69\u5C0D\u6230\u3002[VAR 0114(0004)]",
  "\u9019\u662F\u6211\u7684\u5FC3\u610F\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u6536\u4E0B\u5427\u3002\\n\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u548C\u6211\u5C0D\u6230\uFF01[VAR 0114(0004)]",
  "\u5176\u5BE6\u6211\u6068\u4E0D\u5F97\u73FE\u5728\u5C31\u518D\u6253\u4E00\u5834\uFF01\\n\u4F46\u7562\u7ADF\u6211\u662F\u51A0\u8ECD\uFF0C\\r\\n\u6211\u6703\u9AD4\u8AD2\u5C0D\u624B\uFF0C\u5FCD\u4E0B\u4F86\u7684\u2026\u2026[VAR 0114(0004)]",
  "\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u6536\u96C6\u5230\u66F4\u591A\u5FBD\u7AE0\uFF0C\\n\u6211\u5011\u53C8\u5728\u9053\u9928\u78B0\u9762\u6642\uFF0C\u5C31\u518D\u6230\u4E00\u5834\u5427\uFF01[VAR 0114(0004)]",
  "\u2026\u2026[VAR 0100(0000)]\u3002[VAR 0114(0004)]",
  "\u8981\u662F[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u8B8A\u5F97\u66F4\u5F37\uFF0C\\r\\n\u66F4\u5F37\uFF0C\\r\\n\u66F4\uFF5E\uFF5E\u5F37\u2026\u2026[VAR 0114(0004)]",
  "\u7136\u5F8C\u6211\u5011\u53EF\u4EE5\u4E00\u6230\u518D\u6230\uFF0C\\n\u53C8\uFF5E\u518D\u6230\u7684\u8A71\u2026\u2026\u6211\u6703\u8D85\u9AD8\u8208\u7684\uFF01[VAR 0114(0004)]",
  "\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u966A\u6211\u5C0D\u6230\uFF01\\n\u9053\u9928\u6E2C\u9A57\u8981\u52A0\u6CB9\u5594\uFF01[VAR 0114(0004)]"
