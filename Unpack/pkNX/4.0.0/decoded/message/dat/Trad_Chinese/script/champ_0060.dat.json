[
  "\u53BB\u9053\u9928\u4E4B\u524D\uFF0C\\n\u6700\u597D\u5148\u5230\u7576\u5730\u7684\u5C0D\u6230\u5834\u8D70\u4E00\u8D9F\uFF0C[VAR 0114(0004)]",
  "\u4E8B\u5148\u4E86\u89E3\u4E00\u4E0B\u5834\u5730\u7684\\n\u4F4D\u7F6E\u3001\u6750\u8CEA\u4E4B\u985E\u7684\u3002\\r\\n\u9019\u4E9B\u8AAA\u4E0D\u5B9A\u6703\u5F71\u97FF\u6230\u5C40\u5594\uFF01[VAR 0114(0004)]",
  "\u2026\u2026\u53EA\u8981\u770B[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u81C9\uFF0C\\n\u6211\u5C31\u80FD\u77E5\u9053\uFF01\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53C8\u8B8A\u5F97\u66F4\u5F37\u4E86\u3002[VAR 0114(0004)]",
  "\u6211\u4E5F\u6D3E\u4E9B\u6BD4\u8F03\u5F37\u52E2\u7684\\n\u6210\u54E1\u4E0A\u5834\u5427\uFF01[VAR 0114(0004)]",
  "\u90A3\u9EBC\uFF0C\u8ACB\u591A\u6307\u6559\u56C9\u3002\\n[VAR 0100(0000)]\u3002[VAR 0114(0004)]",
  "\u6211\u5011\u8B93\u9019\u5834\u5C0D\u6230\u6536\u7A6B\u591A\u591A\u5427\uFF01[VAR 0114(0004)]",
