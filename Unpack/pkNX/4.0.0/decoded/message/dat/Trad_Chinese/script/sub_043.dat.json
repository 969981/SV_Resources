[
  "[VAR 0100(0000)]\\n\u7372\u5F97\u4E86[VAR FF00(0008)]\u5404\u5F0F\u5404\u6A23\u7684\u98DF\u6750[VAR FF00(0000)]\uFF01",
  "[VAR 0100(0000)]\u628A\u5404\u5F0F\u5404\u6A23\u7684\u98DF\u6750\\n\u653E\u5165\u4E86[VAR FF00(0008)]\u91CE\u9910[VAR FF00(0000)]\u53E3\u888B\u3002",
  "\u6211\u525B\u525B\u8CB7\u592A\u591A\u98DF\u6750\u4E86\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u4E0D\u80FD\u6536\u4E0B\u4E00\u4E9B\u5462\uFF1F",
  "\u8AAA\u5230\u91CE\u9910\uFF0C\\n\u7576\u7136\u5C11\u4E0D\u4E86\u4E09\u660E\u6CBB\uFF01\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7528\u6211\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u98DF\u6750\u505A\u505A\u770B\u5427\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u9806\u4FBF\u53C3\u52A0\u6211\u7684\u91CE\u9910\uFF0C\\n\u548C\u5BF6\u53EF\u5922\u4E00\u8D77\u4F11\u606F\u4E00\u4E0B\u55CE\uFF1F",
  "\u6B61\u8FCE\u52A0\u5165\u6211\u7684\u91CE\u9910\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u548C\u5BF6\u53EF\u5922\u4E00\u8D77\u4F11\u606F\u4E00\u4E0B\u55CE\uFF1F",
  "\u770B\u4F86[VAR 1100(00FF,0101)]\u4F60\u59B3\u548C\u5BF6\u53EF\u5922\u90FD\u6D3B\u529B\u5341\u8DB3\u4E86\uFF01\\n\u6B61\u8FCE\u96A8\u6642\u4F86\u9019\u88E1\u4F11\u606F\u3002",
  "\u8981\u662F\u7D2F\u4E86\uFF0C\u53EF\u4E0D\u80FD\u52C9\u5F37\u554A\u3002\\n\u6B61\u8FCE\u96A8\u6642\u4F86\u9019\u88E1\u4F11\u606F\u3002",
  "\u6211\u7684\u5305\u5305\u88E1\u585E\u592A\u591A\u98DF\u6750\u4E86\uFF01\\n\u5206\u4E00\u4E9B\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u5594\uFF01",
  "\u5728\u6236\u5916\u5403\u7684\u4E09\u660E\u6CBB\u6700\u68D2\u4E86\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7528\u6211\u5206\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u98DF\u6750\u505A\u505A\u770B\u5427\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u548C\u6211\u4E00\u8D77\u91CE\u9910\uFF0C\\n\u7A0D\u5FAE\u4F11\u606F\u4E00\u4E0B\u600E\u9EBC\u6A23\uFF1F",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u548C\u6211\u4E00\u8D77\u91CE\u9910\uFF0C\\n\u7A0D\u5FAE\u4F11\u606F\u4E00\u4E0B\u55CE\uFF1F",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u548C\u5BF6\u53EF\u5922\\n\u90FD\u8B8A\u5F97\u5F88\u6709\u6D3B\u529B\u4E86\u5462\uFF01\\r\\n\u96A8\u6642\u518D\u4F86\u73A9\u5594\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u7528\u8DDF\u6211\u5BA2\u6C23\u5440\uFF5E\\n\u96A8\u6642\u518D\u4F86\u73A9\u5594\uFF01",
  "\u9019\u88E1\u5C31\u5728\u684C\u53F0\u5E02\u548C\u6DF1\u7F3D\u93AE\u7684\u6B63\u4E2D\u592E\u4E00\u5E36\uFF01\\c\\n\u5403\u4E86\u4E09\u660E\u6CBB\u4E4B\u5F8C\uFF0C\\n\u6211\u8981\u7E7C\u7E8C\u52AA\u529B\u5C55\u958B\u5192\u96AA\u56C9\uFF5E\uFF01\\c\\n\u2026\u2026\u70BA\u4E86\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u80FD\u7E7C\u7E8C\u52AA\u529B\uFF0C\\n\u6211\u5C31\u628A\u98DF\u6750\u5206\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\uFF01",
  "\u5C0D\u4E86\uFF0C\u6211\u807D\u8AAA\u4E4B\u524D\u9019\u4E00\u5E36\u7684\u5CA9\u58C1\u6703\u52D5\uFF0C\\n\u4E0D\u66C9\u5F97\u662F\u771F\u662F\u5047\uFF5E\uFF1F",
  "\u5C31\u7B97\u5CA9\u58C1\u79FB\u52D5\uFF0C\u70BA\u4E86\u5230\u6642\u5019\u4E0D\u6703\u5687\u58DE\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u4F11\u606F\u4E00\u4E0B\u518D\u8D70\u5427\uFF01",
  "\u6C92\u529B\u6C23\u52AA\u529B\u4E86\uFF1F\\n\u7A0D\u5FAE\u4F11\u606F\u4E00\u4E0B\u518D\u8D70\u5427\uFF01",
  "\u4E0D\u8AD6\u662F\u4EBA\u9084\u662F\u5BF6\u53EF\u5922\uFF0C\\n\u4F11\u606F\u662F\u70BA\u4E86\u8D70\u66F4\u9577\u9060\u7684\u8DEF\uFF01\\r\\n\u8981\u662F\u7D2F\u4E86\uFF0C\u8A18\u5F97\u518D\u4F86\u9019\u88E1\u554A\uFF01",
  "\u9019\u6A23\u554A\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u8981\u592A\u62FC\u547D\u4E86\uFF01",
  "\u5761\u9053\u6BD4\u60F3\u50CF\u4E2D\u4F86\u5F97\u9661\uFF0C\\n\u722C\u5F97\u6211\u5598\u5401\u5401\u7684\u2026\u2026\\c\\n\u9019\u7A2E\u6642\u5019\u5462\uFF0C\\n\u5C31\u8981\u5403\u6771\u897F\u4F86\u8B93\u8EAB\u5FC3\u9748\u653E\u9B06\uFF01\\c\\n\u6211\u5206\u4E00\u4E9B\u98DF\u6750\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u597D\u597D\u653E\u9B06\u4E00\u4E0B\u5427\uFF01",
  "\u8981\u662F\u809A\u5B50\u9913\u5F97\u5495\u5495\u53EB\uFF0C\\n\u80FD\u52AA\u529B\u7684\u4E8B\u4E5F\u52AA\u529B\u4E0D\u4E0B\u53BB\u7684\uFF01",
  "\u51FA\u9580\u9760\u670B\u53CB\uFF0C\u8655\u4E16\u9760\u4EBA\u60C5\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u9806\u4FBF\u5728\u9019\u88E1\u653E\u9B06\u4E00\u4E0B\u55CE\uFF1F",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u722C\u5761\u722C\u5230\u7D2F\u4E86\u55CE\uFF1F\\n\u653E\u9B06\u4E00\u4E0B\u770B\u770B\u5982\u4F55\uFF1F",
  "\u60F3\u653E\u9B06\u6642\u5C31\u9760\u7F8E\u5473\u6599\u7406\uFF01\uFF01\\n\u6709\u56F0\u64FE\u6642\u5C31\u8981\u4E92\u76F8\u5E6B\u52A9\uFF01\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5982\u679C\u7D2F\u4E86\uFF0C\u5C31\u4F86\u627E\u6211\u5427\u3002",
  "\u771F\u4E0D\u6127\u662F\u5E74\u8F15\u4EBA\uFF01\\n\u5509\uFF5E\u6211\u597D\u7FA8\u6155\u5594\uFF5E\uFF01",
  "\u4E00\u908A\u6B23\u8CDE\u7F8E\u666F\u4E00\u908A\u54C1\u5690\u7684\u4E09\u660E\u6CBB\uFF0C\\n\u5225\u6709\u4E00\u756A\u6ECB\u5473\u54C8\u54C8\uFF01\\c\\n\u9019\u500B\u9001\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u7D00\u5FF5\u6211\u5011\u76F8\u9047\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u8981\u4ED4\u7D30\u54C1\u5690\u65C5\u884C\u7684\u6ECB\u5473\u554A\uFF01\uFF01",
  "\u5403\u4E86\u4E09\u660E\u6CBB\u4E4B\u5F8C\\n\u98DF\u529B\u6703\u4E00\u6E67\u800C\u51FA\uFF0C\\r\\n\u65C5\u9014\u6703\u66F4\u958B\u5FC3\u54C8\u54C8\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u9806\u4FBF\u5728\u9019\u88E1\u505C\u4E0B\u8173\u6B65\uFF0C\\n\u4F11\u606F\u4E00\u4E0B\u518D\u8D70\u55CE\uFF1F",
  "\u5076\u723E\u505C\u4E0B\u8173\u6B65\u6B23\u8CDE\u6B23\u8CDE\u98A8\u666F\uFF0C\\n\u4F11\u606F\u4E00\u4E0B\u5982\u4F55\u5462\uFF1F",
  "\u52AA\u529B\u5411\u524D\u885D\u5F88\u91CD\u8981\uFF0C\\n\u4F46\u5076\u723E\u4E0D\u59A8\u505C\u4E0B\u8173\u6B65\u770B\u770B\uFF01\\r\\n\u5982\u6B64\u4E00\u4F86\uFF0C\u4E5F\u80FD\u770B\u5230\u4E0D\u540C\u7684\u98A8\u666F\u54C8\u54C8\uFF01",
  "\u5306\u5FD9\u8D95\u8DEF\u4E5F\u662F\u4E00\u7A2E\u9078\u64C7\uFF01\\n\u4F46\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u505C\u4E0B\u8173\u6B65\uFF0C\\r\\n\u96A8\u6642\u4F86\u627E\u6211\u3002",
  "\u6211\u5728\u6F2C\u6C81\u5E02\u5834\u7528\\n\u5F88\u512A\u60E0\u7684\u50F9\u683C\u8CB7\u5230\u4E86\u98DF\u6750\uFF01\uFF01\\c\\n\u4F46\u56E0\u70BA\u6211\u5403\u4E0D\u5B8C\uFF0C\\n\u9019\u4E9B\u5C31for you\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\uFF01",
  "\u548C\u670B\u53CB\u4E00\u8D77\u505A\u6599\u7406\u7684\u6642\u5019\uFF0C\\n\u5E36\u5404\u5F0F\u5404\u6A23\u7684\u98DF\u6750\u53BB\uFF0C\\c\\n\u80FD\u505A\u51FA\u5343\u5947\u767E\u602A\u7684\u4E09\u660E\u6CBB\uFF0C\\n\u5F88\u597D\u73A9\u5462\uFF5E\uFF01",
  "\u2026\u2026\u5C0D\u4E86\uFF01\\n\u9019\u4E00\u5E36\u8DEF\u9014\u96AA\u5CFB\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u4F11\u606F\u4E00\u4E0B\u5427\uFF5E\uFF01",
  "\u5F9E\u9019\u88E1\u4E0D\u7BA1\u5F80\u5317\u5F80\u5357\uFF0C\u4E00\u8DEF\u4E0A\u90FD\u5F88\u96AA\u5CFB\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u51FA\u767C\u7684\u8A71\u5148\u4F11\u606F\u4E00\u4E0B\u5427\uFF5E\uFF01",
  "\u7CBE\u795E\u90FD\u6062\u5FA9\u4E86\u5427\uFF01\\n\u5192\u96AA\u9014\u4E2D\u4E00\u8DEF\u5C0F\u5FC3\uFF5E\uFF01",
  "\u5982\u679C[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u53BB\u897F\u908A\u7684\u6F2C\u6C81\u93AE\uFF0C\\n\u90A3\u53EF\u80FD\u6211\u7684\u64D4\u5FC3\u662F\u591A\u9918\u7684\u4E86\uFF5E\uFF01",
  "\u6211\u5728\u5927\u934B\u6E56\u770B\u5230\u5947\u602A\u7684\\n\u5BF6\u53EF\u5922\u4E4B\u5F8C\u5C31\u9748\u5149\u4E00\u9583\uFF01\\c\\n\u9019\u662F\u6211\u4F7F\u51FA\u6E3E\u8EAB\u89E3\u6578\u60F3\u5230\u7684\u4E09\u660E\u6CBB\u98DF\u8B5C\uFF0C\\n\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u5B9A\u8981\u505A\u505A\u770B\uFF01",
  "[VAR 0100(0000)]\\n\u53EF\u4EE5\u88FD\u4F5C[VAR FF00(0006)]\u58FD\u53F8\u98A8\u5473\u4E09\u660E\u6CBB[VAR FF00(0000)]\u4E86\uFF01",
  "\u4E00\u822C\u4F86\u8AAA\uFF0C\u58FD\u53F8\u7528\u7684\u4E0D\u662F\u9EB5\u5305\uFF0C\\n\u800C\u662F\u628A\u98DF\u6750\u653E\u5728\u7C73\u98EF\u4E0A\u4F86\u5403\u7684\u3002\\c\\n\u2026\u2026\u63DB\u53E5\u8A71\u8AAA\u628A\u58FD\u53F8\u653E\u5728\u9EB5\u5305\u4E0A\u7684\u8A71\uFF0C\\n\u7F8E\u5473\u4E5F\u6703\u8B8A\uFF12\u500D\uFF01",
  "\u6211\u5011\u5728\u6E56\u908A\u76F8\u9047\u4E5F\u662F\u4E00\u7A2E\u7DE3\u4EFD\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u5728\u9019\u88E1\u6B47\u53E3\u6C23\u518D\u8D70\u5427\uFF01",
  "\u5728\u6E56\u7554\u91CE\u9910\uFF01\u5F88\u68D2\u5427\uFF1F\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u5728\u9019\u88E1\u6B47\u53E3\u6C23\u518D\u8D70\u55CE\uFF1F",
  "\u6E56\u7554\u9019\u500B\u5730\u65B9\\n\u70BA\u4EC0\u9EBC\u6703\u9019\u9EBC\u8212\u670D\u5462\uFF1F\\r\\n\u591A\u8667\u5982\u6B64\uFF0C\u8B93\u6211\u6574\u500B\u4EBA\u90FD\u653E\u9B06\u4E86\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u662F\u60F3\u611F\u53D7\u4E00\u4E0B\u6E56\u7554\u7684\u6C23\u606F\uFF0C\\n\u96A8\u6642\u4F86\u8DDF\u6211\u8AAA\u5594\u3002"
]
