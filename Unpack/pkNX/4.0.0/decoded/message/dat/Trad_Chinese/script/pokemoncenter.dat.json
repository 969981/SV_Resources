  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\uFF5E\\n\u9019\u88E1\u662F\u5BF6\u53EF\u5922\u4E2D\u5FC3\u3002\\c\\n\u8981\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u75B2\u618A\u7684\u5BF6\u53EF\u5922\u4F11\u606F\u4E00\u4E0B\u55CE\uFF5E\uFF1F",
  "\u4ECA\u5929\u4E5F\u8F9B\u82E6\u4E86\uFF5E\\n\u9019\u88E1\u662F\u5BF6\u53EF\u5922\u4E2D\u5FC3\u3002\\c\\n\u8981\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u52AA\u529B\u7684\u5BF6\u53EF\u5922\u4F11\u606F\u4E00\u4E0B\u55CE\uFF5E\uFF1F",
  "\u597D\u7684\uFF5E\\n\u8ACB\u5C07\u5BF6\u53EF\u5922\u4EA4\u7D66\u6211\u5427\uFF5E",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4EA4\u7D66\u6211\u5011\u7684[VAR 0101(0000)]\\n\u5DF2\u7D93\u6062\u5FA9\u6D3B\u529B\u56C9\uFF5E",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4EA4\u7D66\u6211\u5011\u7684[VAR 0101(0000)]\u7260\u5011\\n\u5168\u90E8\u90FD\u6062\u5FA9\u6D3B\u529B\u56C9\uFF5E",
  "\u6B61\u8FCE\u4E0B\u6B21\u518D\u4F86\uFF5E",
  "\u90A3\u500B\u53EB\u592A\u6676\u73E0\u7684\\n\u4E5F\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u84C4\u80FD\u597D\u4E86\uFF5E",
  "\u5148\u4F86\u5E6B\u5BF6\u53EF\u5922\u56DE\u5FA9\u6D3B\u529B\u5427\uFF5E",
  "\u5BF6\u53EF\u5922\u7684\u9AD4\u529B\u2026\u2026\\n\u4E5F\u5C31\u662F\uFF28\uFF30\u8B8A\u5C11\u4E86\u7684\u8A71\uFF0C\\r\\n\u8981\u7A4D\u6975\u5730\u5E6B\u7260\u5011\u56DE\u5FA9\u624D\u884C\u5594\uFF5E\\c\\n\u5230\u96DC\u8CA8\u5E97\u4E4B\u985E\u7684\u5730\u65B9\\n\u8CB7\u4E00\u5806\u50B7\u85E5\u4E4B\u985E\u7684\u4F86\u5099\u7528\u4E5F\u884C\u5594\uFF5E",
  "\u554A\uFF5E\u592A\u597D\u4E86\uFF01\\n\u5927\u5BB6\u90FD\u6062\u5FA9\u6D3B\u529B\u56C9\uFF5E\\r\\n\u4EE5\u5F8C\u771F\u7684\u8981\u591A\u5C0F\u5FC3\u5594\uFF5E",
  "\u54CE\u5440\uFF0C\u8DDD\u96E2\u592A\u8FD1\u4E86\u5566\uFF5E\\c\\n\u8981\u59D4\u8A17\u6211\u5011\u5E6B\u5BF6\u53EF\u5922\u56DE\u5FA9\u7684\u8A71\uFF0C\\n\u8ACB\u5F9E\u6AC3\u53F0\u5C0D\u9762\u627E\u6211\u8AAA\u8A71\u5594\uFF5E",
  "\u2026\u2026\u5BA2\u4EBA\u554A\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u4F86\u6211\u9019\u88E1\u597D\u5E7E\u6B21\u4E86\uFF0C\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u9019\u500B\u55CE\uFF5E\uFF1F",
  "\u8857\u982D\u5DF7\u5C3E\u554A\uFF5E\\n\u6B63\u6D41\u884C\u628A\u5169\u624B\u6BD4\u8036\u7684\u624B\u52E2\\r\\n\u5012\u904E\u4F86\u64FA\u7684\u52D5\u4F5C\u5594\uFF5E",
  "[VAR 0100(0000)]\u5F9E\u5927\u59D0\u59D0\u90A3\u88E1\\n\u5B78\u6703\u4E86[VAR FF00(0008)]\u5012\u8457\u6BD4\u8036\u8868\u60C5[VAR FF00(0000)]\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5FC3\u60C5\u55E8\u7684\u6642\u5019\\n\u53EF\u4EE5\u8A66\u8A66\u770B\u5594\uFF5E",
  "\u2026\u2026\u5BA2\u4EBA\u554A\uFF0C\\n\u770B[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u9EBC\u5E38\u4F86\u6211\u9019\u88E1\uFF0C\\r\\n\u6211\u4F86\u544A\u8A34[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u4EF6\u597D\u4E8B\u5427\uFF5E",
  "\u7528\u76F8\u6A5FApp\u81EA\u62CD\u7684\u6642\u5019\u554A\uFF5E\\n\u53EA\u8981\u653E\u500B\u7CBE\u9748\u7403\u5728\u81C9\u7684\u65C1\u908A\uFF0C\\r\\n\u5C31\u80FD\u8B93\u81C9\u986F\u5F97\u6BD4\u8F03\u5C0F\uFF0C\u6211\u8D85\u63A8\u7684\u5594\uFF5E",
  "[VAR 0100(0000)]\u5F9E\u5927\u59D0\u59D0\u90A3\u88E1\\n\u5B78\u6703\u4E86[VAR FF00(0008)]\u4F34\u8457\u7CBE\u9748\u7403\u8868\u60C5[VAR FF00(0000)]\uFF01",
  "\u8981\u662F\u9047\u5230\u81C9\u6D6E\u816B\u4E4B\u985E\u7684\u72C0\u6CC1\uFF0C\\n\u53EF\u4EE5\u8A66\u8A66\u770B\u5594\uFF5E",
  "\u5C0D\u4E86\u2026\u2026\\n\u6211\u6709\u65B0\u7684\u4E8B\u60F3\u8981\u544A\u8A34\u60A8\uFF01",
  "\u900F\u904E\u76EE\u524D\u70BA\u6B62\\n\u6211\u6240\u544A\u8A34\u60A8\u7684\u60C5\u5831\u2026\u2026\\c\\n\u73FE\u5728[VAR 0100(0000)]\u60A8\u5DF2\u7D93\u771F\u7684\\n\u638C\u63E1\u4E86\u6240\u6709\u5192\u96AA\u6642\u9700\u8981\u7684\u77E5\u8B58\uFF01\\c\\n\u8A18\u5F97\u5076\u723E\u91CD\u65B0\u95B1\u8B80\u4E00\u4E0B\u63A2\u96AA\u5FC3\u5F97\uFF0C\\n\u76E1\u60C5\u4EAB\u53D7\u5192\u96AA\u5427\uFF01",
  "\u8981\u8B93\u5BF6\u53EF\u5922\u4F11\u606F\u4E00\u4E0B\u55CE\uFF1F",
  "[VAR 0101(0000)]\\n\u6062\u5FA9\u6D3B\u529B\u4E86\uFF01",
  "[VAR 0101(0000)]\u7260\u5011\\n\u6062\u5FA9\u6D3B\u529B\u4E86\uFF01",
  "\u592A\u6676\u73E0\u4F3C\u4E4E\u4E5F\u84C4\u80FD\u597D\u4E86\uFF01",
  "\u54C7\u54C7\uFF0C\u6C92\u4E8B\u5427\uFF1F\\n\u5F97\u5E6B\u5BF6\u53EF\u5922\u56DE\u5FA9\u624D\u884C\uFF01",
  "\u5BF6\u53EF\u5922\u7684\u9AD4\u529B\\n\u8981\u7A4D\u6975\u5730\u5E6B\u7260\u5011\u56DE\u5FA9\u624D\u884C\u5594\uFF01\\c\\n\u5230\u81EA\u52D5\u8CA9\u8CE3\u6A5F\\n\u591A\u8CB7\u4E9B\u50B7\u85E5\u4F86\u5099\u7528\u5427\uFF01",
  "\u5BF6\u53EF\u5922\u5011\u597D\u50CF\u90FD\u6062\u5FA9\u6D3B\u529B\u4E86\uFF01\\c\\n\u90A3\u9EBC\u5C31\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u7E7C\u7E8C\u52AA\u529B\u5192\u96AA\u5427\uFF01",
  "\u53EA\u8981\u4F7F\u7528\u65C1\u908A\u7684\u6A5F\u5668\uFF0C\\n\u5C31\u53EF\u4EE5\u81EA\u5DF1\u5E6B\u81EA\u5DF1\u7684\u5BF6\u53EF\u5922\u56DE\u5FA9\u5594\uFF01",
  "\u53D6\u6D88",
  "\u6751\u5B50\u88E1\u7684\u6C23\u6C1B\\n\u662F\u4E0D\u662F\u6709\u9EDE\u5947\u602A\u554A\u2026\u2026\uFF1F\\c\\n\u7B97\u4E86\u4E0D\u7BA1\u4E86\uFF0C\\n\u8981\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u4F11\u606F\u4E00\u4E0B\u55CE\uFF1F"
]
