[
  "\u55E8\uFF0C\u540C\u5B78\u5011\uFF0C\\n\u4F60\u5011\u53C8\u6BD4\u6628\u5929\u53E4\u8001\u4E00\u5929\u4E86\u3002[VAR 0114(0027)]",
  "\u96D6\u7136\u4ECA\u5929\u662F\u6700\u5F8C\u4E00\u5802\u8AB2\uFF0C\\n\u4F46\u8B93\u6211\u5011\u7E7C\u7E8C\u4E00\u8D77\u89E3\u958B\\r\\n\u6B77\u53F2\u7684\u7F8E\u5999\u4E4B\u8655\u5427\u3002[VAR 0114(0027)]",
  "\u4E0A\u4E00\u5802\u8AB2\u6211\u8B1B\u4E86\uFF12\uFF10\uFF10\u5E74\u524D\u7684\\n\u7B2C\u96F6\u5340\u89C0\u6E2C\u968A\u7684\u4E8B\u3002[VAR 0114(0027)]",
  "\u554A\u554A\u2026\u2026\u6211\u6559\u7684\u5167\u5BB9\\n\u8D8A\u4F86\u8D8A\u9760\u8FD1\u73FE\u4EE3\u4E86\u2026\u2026[VAR 0114(0027)]",
  "\u6B77\u53F2\u8AB2\u7684\u7F3A\u9EDE\u5C31\u662F\\n\u8AB2\u5802\u5167\u5BB9\u4E00\u5802\u4E00\u5802\u9081\u5411\u672A\u4F86\u3002[VAR 0114(0027)]",
  "\u4E7E\u8106\u5F9E\u73FE\u4EE3\u958B\u59CB\uFF0C\\n\u4E00\u8DEF\u56DE\u6EAF\u6642\u9593\u5230\u904E\u53BB\uFF0C\\r\\n\u9019\u662F\u4E0D\u662F\u6BD4\u8F03\u6D6A\u6F2B\u554A\uFF01\uFF1F[VAR 0114(0027)]",
  "\u662F\u6BD4\u8F03\u6D6A\u6F2B\uFF01",
  "\u90A3\u6703\u5F88\u96E3\u61C2\u2026\u2026",
  "[VAR 0100(0000)]\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u61C2\u6211\u554A\uFF01\\c\\n\u4E0D\u904E\uFF0C\u8981\u662F\u6C92\u6709\u7167\u8457\u8AB2\u7A0B\u7DB1\u8981\u8D70\uFF0C\\n\u5C31\u6703\u6FC0\u6012\u6821\u9577\uFF0C\u9019\u4E5F\u662F\u4E8B\u5BE6\u3002[VAR 0114(0027)]",
  "\u7684\u78BA\u2026\u2026\u50CF\u662F\u56E0\u70BA\u5148\u6709\u67D0\u4EF6\u4E8B\uFF0C\\n\u65BC\u662F\u5F8C\u4F86\u767C\u751F\u53E6\u4E00\u4EF6\u4E8B\uFF0C\\r\\n\u9019\u985E\u524D\u56E0\u5F8C\u679C\u53EF\u80FD\u6703\u8B8A\u5F97\u6BD4\u8F03\u96E3\u61C2\u3002[VAR 0114(0027)]",
  "\u5509\uFF0C\u6C92\u8FA6\u6CD5\u2026\u2026\\n\u6211\u5011\u5C07\u6B77\u53F2\u7684\u6642\u91DD\u5F80\u672A\u4F86\u8F49\u52D5\u3002[VAR 0114(0027)]",
  "\u6700\u5F8C\u4E00\u5802\u8AB2\uFF0C\u5C31\u8B93\u6211\u50B3\u6388\\n\u592A\u6676\u7684\u6B77\u53F2\u7D66\u4F60\u5011\u5427\u3002[VAR 0114(0027)]",
  "\u592A\u6676\u73E0\u539F\u672C\u662F\u5F9E\\n\u7B2C\u96F6\u5340\u8A95\u751F\u7684\u6280\u8853\u3002[VAR 0114(0027)]",
  "\u5728\u4E00\u822C\u8A8D\u70BA\u89C0\u6E2C\u968A\u5DF2\u7D93\u5230\u904E\u4E86\u6700\u6DF1\u8655\u4E4B\u5F8C\uFF0C\\n\u4EBA\u5011\u4F9D\u820A\u6301\u7E8C\u5728\u63A2\u7D22\u7B2C\u96F6\u5340\u2026\u2026[VAR 0114(0027)]",
  "\u65BC\u662F\u5728\u5927\u7D04\uFF11\uFF14\uFF10\u5E74\u524D\uFF0C\u6709\u4EBA\u767C\u73FE\u4E86\\n\u5168\u8EAB\u7C60\u7F69\u5728\u795E\u79D8\u5149\u8292\u4E2D\u7684\u5BF6\u53EF\u5922\u3002[VAR 0114(0027)]",
  "\u4F60\u5011\u60F3\u5FC5\u5DF2\u7D93\u731C\u5230\u4E86\u3002\\n\u90A3\u5C31\u662F\u592A\u6676\u5316\u7684\u5BF6\u53EF\u5922\u3002[VAR 0114(0027)]",
  "\u96D6\u7136\u4EBA\u5011\u5C07\u9019\u4E9B\u5BF6\u53EF\u5922\u5F9E\u7B2C\u96F6\u5340\u5E36\u4E86\u56DE\u4F86\uFF0C\\n\u4F46\u7260\u5011\u537B\u5931\u53BB\u4E86\u8EAB\u9AD4\u7684\u5149\u8292\u3002\\r\\n\u592A\u6676\u5316\u73FE\u8C61\u4E5F\u9577\u5E74\u662F\u8B0E\u5718\u7C60\u7F69\u3002\u76F4\u5230\u2026\u2026[VAR 0114(0027)]",
  "\uFF11\uFF10\u5E74\u524D\u2026\u2026\u9019\u6839\u672C\u5C31\u662F\u8FD1\u4EE3\u4E86\u3002\\n\u67D0\u500B\u4F60\u5011\u4E5F\u77E5\u9053\u7684\u4EBA\\r\\n\u89E3\u660E\u4E86\u592A\u6676\u5316\u7684\u539F\u7406\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u9EBC\uFF0C\u8ACB\u9019\u6642\u4E0D\u5E78\u8207\u6211\\n\u5C0D\u4E0A\u773C\u7684[VAR 0100(0000)]\u4F86\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u89E3\u958B\u592A\u6676\u5316\u539F\u7406\u7684\\n\u77E5\u540D\u535A\u58EB\u2026\u2026\u53EB\u4EC0\u9EBC\u540D\u5B57\uFF1F[VAR 0114(0027)]",
  "\u6D77\u54F2\u535A\u58EB",
  "\u5967\u7433\u535A\u58EB",
  "\u5F17\u5716\u535A\u58EB",
  "\u514B\u62C9\u97CB\u723E\u535A\u58EB",
  "\u2026\u2026\u932F\u8AA4\uFF01\\n\u6D77\u54F2\u662F\u63A2\u96AA\u8A18\u7684\u4F5C\u8005\u3002\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u628A\u9019\u5802\u8AB2\u548C\u4E0A\u4E00\u5802\u8AB2\u641E\u6DF7\u4E86\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u6B63\u78BA\u7B54\u6848\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u624D\u525B\u8F49\u5B78\u4F86\u5C31\u77E5\u9053\u9019\u4EF6\u4E8B\uFF0C\\r\\n\u771F\u662F\u71B1\u5FC3\u5411\u5B78\u554A\u3002[VAR 0114(0027)]",
  "\u932F\u8AA4\u2026\u2026\u4E0D\uFF0C\u5C31\u67D0\u7A2E\u89D2\u5EA6\u4F86\u8AAA\uFF0C\\n\u4E5F\u7B97\u662F\u6B63\u78BA\u7B54\u6848\u2026\u2026\uFF1F[VAR 0114(0027)]",
  "\u5927\u7D04\uFF11\uFF10\u5E74\u524D\uFF0C\u662F\u4E00\u4F4D\u540D\u70BA\u5967\u7433\u7684\u535A\u58EB\\n\u89E3\u958B\u4E86\u592A\u6676\u5316\u73FE\u8C61\u7684\u539F\u7406\u3002[VAR 0114(0027)]",
  "\u5927\u7D04\uFF11\uFF10\u5E74\u524D\uFF0C\u662F\u4E00\u4F4D\u540D\u70BA\u5F17\u5716\u7684\u535A\u58EB\\n\u89E3\u958B\u4E86\u592A\u6676\u5316\u73FE\u8C61\u7684\u539F\u7406\u3002[VAR 0114(0027)]",
  "\u5979\u767C\u73FE\u4E86\u539F\u4F86\u662F\u5B58\u5728\u65BC\\n\u7B2C\u96F6\u5340\u7684\u9583\u8000\u7D50\u6676\u7684\u80FD\u91CF\u2026\u2026\\r\\n\u5C0E\u81F4\u4E86\u5BF6\u53EF\u5922\u592A\u6676\u5316\u3002[VAR 0114(0027)]",
  "\u4ED6\u767C\u73FE\u4E86\u539F\u4F86\u662F\u5B58\u5728\u65BC\\n\u7B2C\u96F6\u5340\u7684\u9583\u8000\u7D50\u6676\u7684\u80FD\u91CF\u2026\u2026\\r\\n\u5C0E\u81F4\u4E86\u5BF6\u53EF\u5922\u592A\u6676\u5316\u3002[VAR 0114(0027)]",
  "\u65BC\u662F[VAR 1107(00FF,0101)]\u5979\u4ED6\u767C\u660E\u4E86\u592A\u6676\u73E0\uFF0C\\n\u4E26\u4E14\u5C07\u9019\u9805\u6280\u8853\u4ED8\u8AF8\u5BE6\u7528\uFF0C\\r\\n\u63D0\u4F9B\u7D66\u4E86\u5BF6\u53EF\u5922\u806F\u76DF\u4EE5\u53CA\u5B78\u6821\u7B49\u8655\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u807D\u8AAA\u514B\u62C9\u97CB\u723E\u6821\u9577\\n\u4E5F\u66FE\u5728\u540C\u4E00\u500B\u5718\u968A\u4E2D\u9032\u884C\u7814\u7A76\u3002[VAR 0114(0027)]",
  "\u8A8D\u8B58\u7684\u4EBA\u4E00\u767B\u5834\uFF0C\\n\u5C31\u9813\u6642\u6C92\u4EC0\u9EBC\u6D6A\u6F2B\u4E4B\u8655\u4E86\u2026\u2026\\r\\n\u8FD1\u4EE3\u53F2\u679C\u7136\u5F88\u7121\u8DA3\u3002[VAR 0114(0027)]",
  "\u6211\u7684\u6B77\u53F2\u8AB2\u5230\u6B64\u7D50\u675F\u3002\\n\u4E0B\u6B21\u5C31\u662F\u671F\u672B\u8003\u4E86\u3002\\r\\n\u5404\u81EA\u597D\u597D\u559A\u9192\u53E4\u8001\u7684\u77E5\u8B58\u5427\u3002[VAR 0114(0027)]"
]
