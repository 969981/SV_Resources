[
  "\u8AF8\u4F4D\u540C\u5B78\uFF0C\u5C07\u624B\u6A5F\u6536\u8D77\u4F86\u5427\u3002\\n\u6211\u5011\u8981\u958B\u59CB\u4E0A\u8AB2\u4E86\u3002[VAR 0114(0029)]",
  "\u4E0A\u4E00\u5802\u8AB2\u6211\u8B1B\u89E3\u4E86\\n\u91CE\u9910\u6642\u7684\u6599\u7406\u6709\u4EC0\u9EBC\u6548\u679C\u3002[VAR 0114(0029)]",
  "\u900F\u904E\u6599\u7406\u80FD\u5920\u7372\u5F97\u98DF\u529B\uFF0C\\n\u4E5F\u53EF\u4EE5\u8B93\u6240\u6709\u7684\u540C\u884C\u5BF6\u53EF\u5922\u56DE\u5FA9\u6D3B\u529B\uFF0C\\r\\n\u662F\u975E\u5E38\u65B9\u4FBF\u7684\u6CBB\u7642\u624B\u6CD5\u3002[VAR 0114(0029)]",
  "\u4E0D\u904E\uFF0C\u60F3\u7576\u7136\u8033\uFF0C\\n\u9019\u5728\u7121\u6CD5\u505A\u6599\u7406\u7684\u6230\u9B25\u4E2D\uFF0C\\r\\n\u4EE5\u53CA\u6025\u8457\u8981\u56DE\u5FA9\u6642\u4E26\u4E0D\u5408\u9069\u3002[VAR 0114(0029)]",
  "\u5728\u90A3\u6A23\u7684\u60C5\u6CC1\u4E0B\u8A72\u4F7F\u7528\u7684\u662F\\n\u80FD\u5920\u5728\u53CB\u597D\u5546\u5E97\u53CA\u8CA9\u8CE3\u90E8\u8CFC\u8CB7\u7684\\r\\n[VAR FF00(0006)]\u50B7\u85E5[VAR FF00(0000)]\u7B49\u56DE\u5FA9\u7528\u7684\u9053\u5177\u3002[VAR 0114(0029)]",
  "\u56DE\u5FA9\u7528\u7684\u9053\u5177\u6703\u7ACB\u5373\u751F\u6548\uFF0C\\n\u5728\u80FD\u5920\u6253\u958B\u5305\u5305\u6642\u96A8\u6642\u90FD\u80FD\u4F7F\u7528\uFF0C\\r\\n\u7576\u7136\uFF0C\u9053\u5177\u5728\u4F7F\u7528\u4E00\u6B21\u5F8C\u5C31\u6703\u6D88\u5931\u5C31\u662F\u4E86\u3002[VAR 0114(0029)]",
  "\u50B7\u85E5\u7684\u56DE\u5FA9\u91CF\u662F\uFF12\uFF10\uFF0C\\n\u597D\u50B7\u85E5\u662F\uFF16\uFF10\uFF0C\\r\\n\u53B2\u5BB3\u50B7\u85E5\u662F\uFF11\uFF12\uFF10\u2026\u2026[VAR 0114(0029)]",
  "\u8D8A\u6602\u8CB4\u7684\u6771\u897F\uFF0C\u56DE\u5FA9\u91CF\u4E5F\u5C31\u8D8A\u5927\u3002\\n\u5EFA\u8B70\u8AF8\u4F4D\u8207\u9322\u5305\u5546\u91CF\uFF0C\u76E1\u91CF\u5132\u5099\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u4E0D\u904E\uFF0C\u65C5\u884C\u5728\u5916\uFF0C\\n\u7E3D\u662F\u6703\u767C\u751F\u51FA\u4E4E\u9810\u6599\u7684\u72C0\u6CC1\u3002[VAR 0114(0029)]",
  "\u60F3\u50CF\u4E00\u4E0B\u5427\u2026\u2026\\n\u5BF6\u53EF\u5922\u53D7\u4E86\u50B7\uFF0C\u624B\u908A\u537B\u6C92\u50B7\u85E5\uFF0C\\r\\n\u4E09\u660E\u6CBB\u7684\u98DF\u6750\u4E5F\u7528\u76E1\u4E86\uFF0C\\r\\n\u9644\u8FD1\u4E5F\u4E0D\u898B\u5BF6\u53EF\u5922\u4E2D\u5FC3\u7684\u5F71\u5B50\u3002[VAR 0114(0029)]",
  "\u8A66\u554F[VAR 0100(0000)]\u540C\u5B78\uFF0C\\n\u5728\u6C92\u6709\u56DE\u5FA9\u65B9\u6CD5\u7684\u5371\u6A5F\u72C0\u6CC1\u4E0B\uFF0C\\r\\n\u61C9\u8A72\u5728\u56DB\u5468\u5C0B\u627E\u4EC0\u9EBC\uFF1F[VAR 0114(0029)]",
  "\u6709\u6C34\u7684\u5730\u65B9",
  "\u5B78\u6821\u8001\u5E2B",
  "\u6389\u5728\u5730\u4E0A\u7684\u6771\u897F",
  "\u6B63\u5982\u525B\u624D\u6240\u8AAA\uFF0C\\n\u5373\u4F7F\u6709\u6C34\u4E5F\u6C92\u6709\u98DF\u6750\uFF0C\\r\\n\u56E0\u6B64\u524D\u63D0\u662F\u7121\u6CD5\u505A\u6599\u7406\u2026\u2026[VAR 0114(0029)]",
  "\u2026\u2026\u7576\u7136\uFF0C\u8981\u662F\u6B63\u597D\u5728\u9644\u8FD1\u7684\u8A71\uFF0C\\n\u8001\u5E2B\u5011\u662F\u6703\u4F38\u624B\u5354\u52A9\u8AF8\u4F4D\u7684\u3002\\c\\n\u4F46\u5225\u4EE5\u70BA\u96A8\u6642\u96A8\u5730\u90FD\u80FD\u9047\u898B\\n\u9858\u610F\u51FA\u4E00\u81C2\u4E4B\u529B\u7684\u5927\u4EBA\u2026\u2026[VAR 0114(0029)]",
  "[VAR 0100(0000)]\u540C\u5B78\uFF0C\u7B54\u5F97\u597D\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u8C50\u5BCC\u7684\u91CE\u5916\u6C42\u751F\u77E5\u8B58\u5462\u3002[VAR 0114(0029)]",
  "\u53EA\u8981\u770B\u5230\u56DB\u5468\u6709\u4EC0\u9EBC\u5728\u9583\u9583\u767C\u5149\uFF0C\\n\u90A3\u5C31\u662F\u6709\u6771\u897F\u6389\u5728\u5730\u4E0A\uFF01\\c\\n\u8AAA\u4E0D\u5B9A\u80FD\u64BF\u5230\u6A59\u6A59\u679C\u6216\u50B7\u85E5\u9019\u4E9B\\n\u80FD\u7528\u4F86\u56DE\u5FA9\u7684\u9053\u5177\u3002[VAR 0114(0029)]",
  "\u4E5F\u53EF\u4EE5\u4F7F\u7528\u300C[VAR FF00(0006)]\uFF32\u9375Let\u0027s Go[VAR FF00(0000)]\u300D\\n\u6D3E\u5BF6\u53EF\u5922\u53BB\u64BF\u56DE\u4F86\u5462\u3002[VAR 0114(0029)]",
  "\u6A39\u679C\u4E0D\u540C\u65BC\u5546\u5E97\u8CB7\u4F86\u7684\u9053\u5177\uFF0C\\n\u53EA\u8981\u8B93\u5BF6\u53EF\u5922\u651C\u5E36\uFF0C\u5728\u5C0D\u6230\u4E2D\\r\\n\u5BF6\u53EF\u5922\u5C31\u6703\u81EA\u5DF1\u5224\u65B7\u4E26\u4E14\u98DF\u7528\u5B83\u3002[VAR 0114(0029)]",
  "\u4EA4\u7D66\u5BF6\u53EF\u5922\u53BB\u5224\u65B7\u4F7F\u7528\u6642\u6A5F\uFF0C\\n\u4E5F\u662F\u5225\u6709\u4E00\u756A\u98A8\u8DA3\u554A\u3002[VAR 0114(0029)]",
  "\u7E3D\u4E4B\uFF0C\u8017\u76E1\u4E86\u624B\u908A\u7684\u56DE\u5FA9\u65B9\u6CD5\u6642\uFF0C\\n\u5C31\u5728\u56DB\u5468\u627E\u4E00\u4E0B\u9583\u9583\u767C\u5149\u7684\u6771\u897F\u3002[VAR 0114(0029)]",
  "\u82E5\u662F\u9023\u6A39\u679C\u90FD\u627E\u4E0D\u5230\uFF0C\\n\u4E5F\u6709\u5176\u4ED6\u7684\u56DE\u5FA9\u65B9\u6CD5\u2026\u2026\\r\\n\u4F46\u770B\u4F86\u4E0B\u8AB2\u9418\u4F86\u963B\u6B62\u6211\u4E86\u3002[VAR 0114(0029)]",
  "\u672C\u5802\u8AB2\u5230\u6B64\u7D50\u675F\u3002\\n\u6055\u6211\u5931\u966A\u4E86\u3002[VAR 0114(0029)]"
]
