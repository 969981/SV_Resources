  "\u5404\u4F4D\uFF0C\u4E00\u8DEF\u5C0F\u5FC3\u5594\uFF5E\uFF01\\n\u5E15\u5E95\u4E9E\u5DE8\u5751\u88E1\u9762\u5F88\u5371\u96AA\uFF0C\\r\\n\u6821\u898F\u662F\u7981\u6B62\u5927\u5BB6\u9032\u53BB\u90A3\u88E1\u7684\u5594\uFF5E\uFF01[VAR 0114(000A)]",
  "[VAR 0100(0000)]\uFF01\u6211\u5011\u8D70\u5427\uFF5E\uFF01[VAR 0114(0004)]",
  "\u4E0D\u77E5\u9053\u5927\u5BB6\u6709\u6C92\u6709\\n\u628A\u6211\u7684\u53EE\u5680\u807D\u9032\u53BB\uFF1F\\c\\n\u2026\u2026\u6709\u9019\u9EBC\u4E00\u7FA4\u6D3B\u529B\u5145\u6C9B\u7684\u5B78\u751F\uFF0C\\n\u6211\u5373\u4F7F\u6709\u4E00\u767E\u4E8C\u5341\u500B\u5FC3\u4E5F\u4E0D\u6562\u653E\u5FC3\u5462\u3002[VAR 0114(000A)]",
  "\u88AB\u8AAA\u60F3\u505A\u4EC0\u9EBC\u90FD\u6C92\u554F\u984C\uFF0C\\n\u53CD\u800C\u662F\u500B\u5927\u96E3\u984C\u554A\u3002",
  "\u7D42\u65BC\u8B93\u6211\u7B49\u5230\u5C0B\u5BF6\u4E86\uFF01\\n\u6211\u8981\u7528\u82B1\u4E86\u96F6\u7528\u9322\u8CB7\u7684\u76F8\u6A5F\\r\\n\u62CD\u4E0B\u6700\u68D2\u7684\u7167\u7247\uFF01",
  "\u5C0D\u6211\u800C\u8A00\uFF0C\\n\u5C0B\u5BF6\u5C31\u662F\u5C0B\u627E\u5BF6\u53EF\u5922\uFF01\\r\\n\u6211\u8981\u628A\u5716\u9451\u586B\u5F97\u6EFF\u6EFF\u7684\u5566\uFF5E",
