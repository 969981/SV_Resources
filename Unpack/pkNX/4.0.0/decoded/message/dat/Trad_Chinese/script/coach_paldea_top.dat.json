  "\u6211\u4E5F\u66FE\u7D93\u53BB\u904E\\n\u96F6\u5340\u7814\u7A76\u6240\u5E7E\u6B21\u3002\\c\\n\u4F46\u6211\u5F9E\u672A\u60F3\u5230\u904E\\n\u8981\u5C07\u85CD\u4E4B\u5149\u789F\u653E\u9032\u5165\u53E3\u7684\u9762\u677F\u88E1\u3002\\c\\n\u5475\u5475\u2026\u2026[VAR 1100(00FF,0101)]\u4F60\u59B3\u679C\u7136\u662F\u500B\\n\u80FD\u8F15\u6613\u8D85\u51FA\u6211\u60F3\u50CF\u7684\u4EBA\u3002[VAR 0114(0011)]",
  "\u85CD\u8393\u5B78\u5712\u5165\u53E3\u7684\u8A2D\u8A08\\n\u7CBE\u7F8E\u800C\u53C8\u5145\u6EFF\u4E86\u7368\u5275\u6027\u3002\\c\\n\u7576\u7136\uFF0C\u6211\u8A8D\u70BA\u5B78\u9662\u7684\u5165\u53E3\\n\u4E5F\u6BEB\u4E0D\u905C\u8272\u3002[VAR 0114(0011)]",
  "\u51A0\u8ECD[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u4EA4\u63DB\u7D66\u6211\u7684[VAR 0101(0001)]\u2026\u2026\\c\\n\u7260\u548C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F88\u50CF\uFF0C\\n\u64C1\u6709\u5341\u5206\u4E86\u4E0D\u8D77\u7684\u624D\u80FD\u3002[VAR 0114(0011)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u5728\u57F9\u990A\\n\u6211\u4EA4\u63DB\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u6676\u5149\u82BD\u55CE\uFF1F\\c\\n\u90A3\u5B69\u5B50\u7684\u529B\u91CF\\n\u60F3\u5FC5\u6703\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u6240\u5E6B\u52A9\u624D\u662F\u3002[VAR 0114(0011)]"
