[
  "\u55E8\uFF0C\u540C\u5B78\u5011\uFF0C\\n\u4F60\u5011\u53C8\u6BD4\u6628\u5929\u53E4\u8001\u4E00\u5929\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u4E5F\u8B93\u6211\u5011\u4E00\u8D77\u89E3\u958B\\n\u6B77\u53F2\u7684\u7F8E\u5999\u4E4B\u8655\u5427\u3002[VAR 0114(0027)]",
  "\u5927\u7D04\uFF12\uFF10\uFF10\uFF10\u5E74\u524D\uFF0C\\n\u9019\u500B\u5730\u5340\u958B\u59CB\u7531\u5E15\u5E95\u4E9E\u5E1D\u570B\u7D71\u6CBB\u3002[VAR 0114(0027)]",
  "\u64DA\u8AAA\u5E15\u5E95\u4E9E\u7684\u7687\u5E1D\u662F\u500B\\n\u6975\u70BA\u7368\u88C1\u7684\u4EBA\uFF0C[VAR 0114(0027)]",
  "\u800C\u4E14\u4ED6\u71B1\u5207\u76F8\u4FE1\u8457\u6709\u8CA1\u5BF6\\n\u6C89\u7761\u5728\u7B2C\u96F6\u5340\u6DF1\u8655\u7684\u50B3\u8AAA\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u53E4\u4EE3\u7684\u4EBA\u4E26\u6C92\u6709\\n\u50CF\u73FE\u5728\u9019\u6A23\u9032\u6B65\u7684\u6587\u660E\u3002[VAR 0114(0027)]",
  "\u56E0\u6B64\u4ED6\u5011\u66F4\u5BB9\u6613\u76F8\u4FE1\\n\u4E0D\u53EF\u601D\u8B70\u7684\u50B3\u8AAA\u3001\u5492\u8A9E\u2026\u2026\\r\\n\u7B49\u7B49\u8D85\u8D8A\u4EBA\u985E\u60F3\u50CF\u7684\u5B58\u5728\u3002[VAR 0114(0027)]",
  "\u70BA\u4E86\u7372\u5F97\u5C0D\u6297\u9130\u570B\u7684\u529B\u91CF\uFF0C\\n\u7687\u5E1D\u6D3E\u51FA\u4E86\u8A31\u8A31\u591A\u591A\u7684\u4EBA\\r\\n\u524D\u53BB\u7B2C\u96F6\u5340\u63A2\u7D22\u8CA1\u5BF6\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u9EBC\uFF0C\u8ACB\u9019\u6642\u4E0D\u5E78\u8207\u6211\\n\u5C0D\u4E0A\u773C\u7684[VAR 0100(0000)]\u4F86\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u5E15\u5E95\u4E9E\u5E1D\u570B\u958B\u59CB\u7D71\u6CBB\u9019\u7247\u571F\u5730\uFF0C\\n\u662F\u5728\u5927\u7D04\u5E7E\u5E74\u524D\u7684\u4E8B\u60C5\uFF1F[VAR 0114(0027)]",
  "\u5927\u7D04\uFF11\uFF10\uFF10\uFF10\u5E74\u524D",
  "\u5927\u7D04\uFF12\uFF10\uFF10\uFF10\u5E74\u524D",
  "\u5927\u7D04\uFF13\uFF10\uFF10\uFF10\u5E74\u524D",
  "\u2026\u2026\u932F\u8AA4\uFF01\\n\u8981\u662F\uFF11\uFF10\uFF10\uFF10\u5E74\u524D\u7684\u8A71\uFF0C\\r\\n\u5E1D\u570B\u5DF2\u7D93\u5FEB\u8981\u74E6\u89E3\u4E86\u5462\uFF01\uFF1F[VAR 0114(0027)]",
  "\u5475\uFF0C\u6B63\u78BA\u7B54\u6848\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u6709\u9EDE\u5C0F\u8070\u660E\u5462\u3002\\r\\n\u770B\u4F86\u662F\u6709\u597D\u597D\u807D\u8AB2\u662F\u5427\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u932F\u8AA4\uFF01\\n\u5728\u9059\u9060\u7684\uFF13\uFF10\uFF10\uFF10\u5E74\u524D\uFF0C\\r\\n\u5E1D\u570B\u5C1A\u672A\u5B58\u5728\u5462\uFF01\uFF1F[VAR 0114(0027)]",
  "\u2026\u2026\u6C92\u932F\uFF0C\u5927\u7D04\u5F9E\uFF12\uFF10\uFF10\uFF10\u5E74\u524D\u8D77\uFF0C\\n\u6F2B\u9577\u7684\u5927\u63A2\u7D22\u6642\u4EE3\u63ED\u958B\u4E86\u5E8F\u5E55\u3002[VAR 0114(0027)]",
  "\u4F46\u64DA\u8AAA\u5728\u7576\u6642\u7531\u5E1D\u570B\\n\u6D3E\u51FA\u53BB\u7684\u5192\u96AA\u5BB6\uFF0C\\r\\n\u6C92\u6709\u4EFB\u4F55\u4EBA\u80FD\u62B5\u9054\u6700\u6DF1\u8655\u3002[VAR 0114(0027)]",
  "\u4E0D\u77E5\u662F\u56E0\u70BA\u8DEF\u9014\u56B4\u5CFB\uFF0C\\n\u9084\u662F\u906D\u9047\u4E86\u672A\u77E5\u7684\u5B58\u5728\u2026\u2026[VAR 0114(0027)]",
  "\u7E3D\u4E4B\uFF0C\u96E3\u5EA6\u904E\u9AD8\u7684\u5927\u63A2\u7D22\\n\u60F3\u5FC5\u662F\u70BA\u63D0\u5347\u5DE8\u5751\u7684\u795E\u79D8\u6027\\r\\n\u505A\u4E86\u76F8\u7576\u5927\u7684\u8CA2\u737B\u3002[VAR 0114(0027)]",
  "\u554A\u554A\u2026\u2026\uFF01\u6211\u4E5F\u597D\u60F3\u53BB\u63A2\u7D22\u7576\u6642\u90A3\\n\u5C1A\u672A\u88AB\u6574\u7406\u7684\u7B2C\u96F6\u5340\u2026\u2026\uFF01\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u6211\u53EA\u80FD\u671F\u671B\\n\u6642\u5149\u6A5F\u8FC5\u901F\u5730\u88AB\u958B\u767C\u4E86\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u54CE\u5440\uFF1F\u6211\u592A\u591A\u8A71\u4E86\uFF0C\\n\u6642\u9418\u5DF2\u7D93\u8D70\u904E\u982D\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u7684\u8AB2\u5C31\u5230\u6B64\u70BA\u6B62\u3002\\n\u6211\u5011\u4E0B\u6B21\u4E5F\u7E7C\u7E8C\u89E3\u958B\u6B77\u53F2\u4E4B\u8B0E\u5427\u3002[VAR 0114(0027)]"
