[
  "\u81EA\u5F9E[VAR 1100(00FF,0101)]\u4F60\u59B3\u5E6B\u6211\u6A19\u4E0B\u6D77\u5E36\u4E4B\u5F8C\uFF0C\\n\u6211\u9019\u5152\u7684\u6D77\u5E36\u6599\u7406\u662F\u4EBA\u6C23\u7206\u8868\u554A\uFF01[VAR 0114(0018)]",
  "\u90A3\u6642\u771F\u662F\u591A\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u554A\uFF01\\n\u771F\u4E0D\u6127\u662F\u7576\u51A0\u8ECD\u7684\u6599\uFF01[VAR 0114(0018)]",
  "\u54CE\u5440\uFF0C\u5E79\u9019\u884C\u5DE5\u4F5C\\n\u771F\u662F\u80FD\u9047\u898B\u5404\u5F0F\u5404\u6A23\u7684\u4EBA\u554A\u3002[VAR 0114(0018)]",
  "\u6709\u4EBA\u50CF[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u6A23\u4E00\u80A1\u52C1\u5730\\n\u50CF\u6D2A\u6D41\u822C\u4E0D\u65B7\u524D\u9032\uFF0C\\r\\n\u4E5F\u6709\u4EBA\u505C\u6EEF\u4E0D\u524D\uFF0C\u5316\u70BA\u4E00\u6F6D\u6C34\u3002[VAR 0114(0018)]",
  "\u4E0A\u4E86\u5E74\u7D00\u7684\u5927\u4EBA\\n\u5F80\u5F80\u6703\u504F\u5411\u7576\u5F8C\u8005\uFF0C\\r\\n\u4F46\u5C0D\u6211\u4F86\u8AAA\u90A3\u6709\u9EDE\u5152\u7121\u804A\u3002[VAR 0114(0018)]",
  "\u2026\u2026\u6C34\u6D41\u6210\u6CB3\uFF0C\u532F\u5165\u5927\u6D77\uFF0C\\n\u63A8\u5347\u6210\u96F2\uFF0C\u518D\u6B21\u70BA\u96E8\u3002[VAR 0114(0018)]",
  "\u5343\u8B8A\u842C\u5316\u7684\u9A5A\u6FE4\u6D77\u5473\u6599\u7406\u4EBA\u6D77\u5CB1\uFF01\\n\u9019\u5C31\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u89AA\u8EAB\u6E2C\u6E2C\u6FC0\u6D41\u7684\u529B\u9053\uFF01[VAR 0114(0018)]",
  "\u9023\u9996\u5E2D\u90FD\u8A8D\u540C\u7684\u90A3\u6C23\u9B44\uFF01\\n\u679C\u771F\u662F\u5927\u8C50\u6536\u554A\uFF0C\u5927\u8C50\u6536\uFF01[VAR 0114(0018)]",
  "\u904E\u65BC\u731B\u70C8\u7684\u6C34\u6D41\u4E0D\u8AD6\u662F\u597D\u662F\u58DE\\n\u90FD\u6703\u5C07\u5468\u570D\u6372\u5165\u6025\u6E4D\u4E2D\uFF0C\\r\\n\u5E36\u4F86\u5DE8\u5927\u7684\u5F71\u97FF\uFF01[VAR 0114(0018)]",
  "\u5373\u4FBF\u5982\u6B64\u4ECD\u9858\u610F\u76F8\u4F34\u5728\u5074\u7684\u670B\u53CB\uFF0C\\n\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u800C\u8A00\u662F\u5F88\u5BF6\u8CB4\u7684\u5B58\u5728\u554A\u3002[VAR 0114(0018)]",
  "\u88AB\u5E74\u8F15\u7684\u529B\u91CF\u7D66\u885D\u649E\u5F8C\uFF0C\\n\u5927\u53D4\u6211\u7684\u5E79\u52C1\u50CF\u662F\u5C71\u6D2A\u7206\u767C\u5566\uFF01[VAR 0114(0018)]",
  "\u5E6B\u6211\u8F49\u544A\u4E5F\u6148\u59D1\u5A18\u5427\uFF01\\n\u6D77\u5CB1\u6703\u6709\u66F4\u6FC0\u70C8\u9A5A\u4EBA\u7684\u8F49\u8B8A\u2026\u2026\uFF01[VAR 0114(0018)]",
  "\u62DC\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u56C9\uFF0C\u5E74\u8F15\u4EBA\uFF01\\n\u6211\u671F\u5F85[VAR 1100(00FF,0101)]\u4F60\u59B3\u518D\u6B21\u5149\u81E8\u554A\uFF01[VAR 0114(0018)]"
]
