[
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u554A\uFF5E[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\uFF01[VAR 0100(0000)]\uFF01[VAR 0114(002A)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u5317\u4E0A\u9109\u6349\u5230\u4E86\u2026\u2026\\n[VAR 0202(0001)]\u7A2E\u5BF6\u53EF\u5922\uFF01[VAR 0114(002A)]",
  "\u590F\u4EE4\u71DF\u624D\u525B\u958B\u59CB\u800C\u5DF2\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u53BB\u548C\u8A31\uFF5E\u591A\\n\u53EA\u68F2\u606F\u5728\u5317\u4E0A\u7684\u5BF6\u53EF\u5922\u76F8\u9047\u5594\uFF5E[VAR 0114(002A)]",
  "\u82E5\u6C23\u5019\u4E0D\u540C\uFF0C\u68F2\u606F\u7684\u5BF6\u53EF\u5922\\n\u7576\uFF5E\u7136\u4E5F\u6703\u4E0D\u540C\u3002\\c\\n\u5317\u4E0A\u7684\u590F\u5929\u6FD5\u5EA6\u5F88\u9AD8\uFF0C\\n\u6240\u4EE5\u9019\u88E1\u6703\u6709\u559C\u6B61\u6FD5\u7B54\u7B54\u7684\u5BF6\u53EF\u5922\u5594\uFF5E[VAR 0114(002A)]",
  "\u807D\u8AAA\u9B3C\u5C71\u7684\u9AD8\u8655\\n\u6703\u6709\u706B\u5C71\u6C23\u9AD4\u5F9E\u5730\u9762\u5192\u51FA\u4F86\uFF01\\c\\n\u559C\u6B61\u6C23\u9AD4\u7684\u5BF6\u53EF\u5922\\n\u5F85\u5728\u90A3\u88E1\u61C9\u8A72\u5F88\u8212\u670D\u2026\u2026[VAR 0114(002A)]",
  "\u4E0D\u904E\uFF0C[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u5C0F\u5FC3\\n\u5225\u5438\u9032\u592A\u591A\u6C23\u9AD4\u5594\uFF5E[VAR 0114(002A)]",
  "\u54C7\uFF5E\uFF01\u5317\u4E0A\u5716\u9451\u5E7E\u4E4E\u8981\\n\u88AB[VAR 1100(00FF,0101)]\u4F60\u59B3\u586B\u6EFF\u4E86\u5462\uFF5E\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u4EE5\u7528\u5716\u9451\u78BA\u8A8D\u68F2\u606F\u5730\uFF0C\\n\u4E5F\u53EF\u4EE5\u5230\u7D50\u6676\u6D1E\u7A9F\u6311\u6230\u5718\u9AD4\u6230\u2026\u2026\\c\\n\u7E3D\u4E4B\uFF0C\u8DDD\u96E2\u5B8C\u6210\u5C31\u53EA\u5DEE\u4E00\u9EDE\u4E86\uFF0C\\n[VAR 0100(0000)]\uFF0C\u597D\u597D\u52A0\u6CB9\u5594\uFF5E[VAR 0114(002A)]",
  "\u9019\u8A72\u4E0D\u6703\u662F\u2026\u2026\\n\u5168\u7A2E\u985E\u90FD\u96C6\u9F4A\u4E86\uFF5E\uFF01\uFF1F[VAR 0114(002A)]",
  "\u54C7\uFF5E\u54C7\uFF5E\uFF01\\n\u5317\u4E0A\u5716\u9451\u5B8C\u6210\u4E86\uFF01\\r\\n\u592A\u53B2\u5BB3\u4E86\uFF5E\u771F\u7684\u662F\u592A\u53B2\u5BB3\u4E86\uFF5E\uFF01[VAR 0114(002A)]",
  "\u591A\u8667\u4E86\u6709[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5E6B\u5FD9\uFF0C\\n\u5317\u4E0A\u9109\u7684\u5BF6\u53EF\u5922\u8ABF\u67E5\\r\\n\u6709\u4E86\u524D\u6240\u672A\u6709\u7684\u9032\u5C55\uFF5E\uFF01[VAR 0114(002A)]",
  "\u6211\u60F3\u9001\u4E9B\u4EC0\u9EBC\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7576\u6176\u795D\uFF0C\\n\u4F46\u6211\u8EAB\u4E0A\u7684\u9322\u4E0D\u662F\u5F88\u5920\u2026\u2026[VAR 0114(002A)]",
  "\u2026\u2026\u6211\u60F3\u5230\u4E86\uFF01[VAR 0114(002A)]",
  "\u5C31\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u6211\u5728\u5317\u4E0A\u4E2D\u5FC3\u8CB7\u7684\u7279\u7522\u5427\u3002\\n\u9019\u53EF\u662F\u7576\u5730\u9650\u5B9A\u7684\u5594\uFF01[VAR 0114(002A)]",
  "\u9084\u6709\uFF0C\u53EF\u4EE5\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u62FF\u51FA\\n\u624B\u6A5F\u6D1B\u6258\u59C6\u4F86\u55CE\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u6211\u7528\u514B\u62C9\u97CB\u723E\u6821\u9577\u5E6B\u6211\u5728\\n\u5716\u9451App\u88E1\u8FFD\u52A0\u7684\u734E\u72C0\u529F\u80FD\uFF0C\\r\\n\u4F86\u70BA[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u6176\u795D\u4E00\u4E0B\u5427\uFF5E[VAR 0114(002A)]",
  "\u8A8D\u8B49\u5BF6\u53EF\u5922\u5716\u9451\u7684\u4F01\u696D\uFF0C\\n\u4E5F\u50B3\u4E86\u8A0A\u606F\u904E\u4F86\u5462\u3002[VAR 0114(002A)]",
  "\u96D6\u8AAA\u5716\u9451\u5DF2\u7D93\u5B8C\u6210\u4E86\uFF0C\\n\u4F46\u590F\u4EE4\u71DF\u624D\u525B\u958B\u59CB\u3002[VAR 0114(002A)]",
  "\u4ECA\u5F8C[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u8981\u548C\u8A31\uFF5E\u591A\\n\u5317\u4E0A\u7684\u5BF6\u53EF\u5922\u76F8\u9047\u5594\u3002[VAR 0114(002A)]",
  "\u4ECA\u5929\u5929\u6C23\u771F\u597D\u5462\uFF5E\\n\u795E\u6E05\u6C23\u723D\u7684\u4E00\u5929\u958B\u59CB\u56C9\uFF5E[VAR 0114(002A)]",
  "\u5317\u4E0A\u7684\u590F\u5929\u771F\u662F\u60B6\u71B1\u5462\uFF5E\\n\u6211\u7684\u767D\u888D\u88E1\u90FD\u6FD5\u900F\u4E86\u3002[VAR 0114(002A)]",
  "\u5317\u4E0A\u5915\u967D\u7684\u984F\u8272\u6BD4\u5E15\u5E95\u4E9E\u7684\\n\u4F86\u5F97\u6DE1\uFF0C\u771F\u662F\u6F02\u4EAE\u5462\uFF5E\\r\\n\u662F\u56E0\u70BA\u5149\u7684\u6298\u5C04\u7387\u4E0D\u540C\u55CE\uFF1F[VAR 0114(002A)]",
  "\u96D6\u7136[VAR 1100(00FF,0101)]\u4F60\u59B3\u7E3D\u662F\u5FD9\u5230\u9019\u9EBC\u665A\uFF0C\\n\u4F46\u5076\u723E\u62AC\u982D\u770B\u770B\u5929\u7A7A\u5427\uFF01\\c\\n\u9019\u88E1\u5C11\u6709\u93AE\u4E0A\u7684\u71C8\u5149\uFF0C\\n\u6240\u4EE5\u5929\u4E0A\u7684\u661F\u661F\u90FD\u80FD\u770B\u5F97\u4E00\u6E05\u4E8C\u695A\u5594\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u5929\u662F\u7531\u96E8\u6C34\u8FCE\u4F86\u4E86\u4E00\u5929\u7684\u958B\u59CB\u3002\\c\\n\u559C\u6B61\u4E0B\u96E8\u7684\u5BF6\u53EF\u5922\\n\u8AAA\u4E0D\u5B9A\u662F\u9AD8\u8208\u5F97\u4E0D\u5F97\u4E86\u5594\uFF5E[VAR 0114(002A)]",
  "\u5317\u4E0A\u7684\u590F\u5929\u5C31\u7B97\u4E0B\u96E8\u4E5F\u5F88\u60B6\uFF0C\\n\u771F\u662F\u9A5A\u4EBA\u7684\u6C23\u5019\u554A\uFF5E\\c\\n\u9019\u7A2E\u6C23\u5019\u4F3C\u4E4E\u6703\u5C0D\u751F\u614B\u7CFB\\n\u4E5F\u9020\u6210\u5F71\u97FF\u5462\uFF5E[VAR 0114(002A)]",
  "\u6211\u5011\u88AB\u5348\u5F8C\u96F7\u9663\u96E8\u6CE2\u53CA\u4E86\u5462\uFF5E\\c\\n\u5982\u679C\u653E\u8457\u6FD5\u6389\u7684\u8EAB\u5B50\u4E0D\u7BA1\uFF0C\\n\u53EF\u662F\u6703\u5931\u6EAB\u7684\uFF0C\u8981\u5C0F\u5FC3\u554A\uFF5E[VAR 0114(002A)]",
  "\u665A\u4E0A\u4E0D\u53EA\u8996\u7DDA\u4E0D\u597D\uFF0C\\n\u8DEF\u9762\u9084\u6703\u56E0\u70BA\u4E0B\u96E8\u800C\u6EFF\u662F\u6CE5\u6FD8\uFF0C\\r\\n\u6240\u4EE5\u5225\u53BB\u592A\u9060\u7684\u5730\u65B9\u5594\uFF5E[VAR 0114(002A)]",
  "\u76EE\u6A19\u662F\u767B\u9304\uFF12\uFF10\uFF10\u7A2E\u5BF6\u53EF\u5922\\n\u5230\u5317\u4E0A\u5716\u9451\uFF5E\uFF01\\c\\n\u5B8C\u6210\u4E4B\u5F8C\u5728\u5716\u9451App\u88E1\u6309\u4E0B[VAR FF00(0006)]\uFF38\u9375[VAR FF00(0000)]\uFF0C\\n\u6A19\u4E0A\u5B8C\u6210\u5716\u9451\u7684\u6A19\u8A18\u4E4B\u5F8C\u4F86\u7D66\u6211\u770B\u5427\uFF5E[VAR 0114(002A)]"
]
