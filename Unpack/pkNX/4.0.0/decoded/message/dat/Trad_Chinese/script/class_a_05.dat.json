[
  "\u5927\u5BB6\u597D\u554A\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u5011\u958B\u59CB\u4E0A\u8AB2\u5427\uFF5E[VAR 0114(002A)]",
  "\u671F\u4E2D\u8003\uFF0C\u5927\u5BB6\u90FD\u8868\u73FE\u5F97\\n\u975E\u5E38\u512A\u79C0\u5594\u3002[VAR 0114(002A)]",
  "\u4E5F\u8981\u611F\u8B1D\u5927\u5BB6\u5C0D\u5BF6\u53EF\u5922\u5716\u9451\u7684\u611F\u60F3\u3002\\n\u6211\u6703\u4F5C\u70BA\u4ECA\u5F8C\u7684\u53C3\u8003\u7684\uFF5E[VAR 0114(002A)]",
  "\u597D\u4E86\uFF0C\u5F9E\u4ECA\u5929\u8D77\\n\u5C31\u662F\u9019\u9580\u8AB2\u7684\u5F8C\u534A\u90E8\u5206\u56C9\u3002[VAR 0114(002A)]",
  "\u8B93\u6211\u5011\u7684\u77E5\u8B58\u4E5F\u50CF\u5BF6\u53EF\u5922\u90A3\u6A23\\n\u4E0D\u65B7\u5730\u9032\u5316\u5427\uFF5E\uFF01[VAR 0114(002A)]",
  "\u6C92\u932F\uFF0C\u9032\u5316\u2026\u2026\\n\u563F\u563F\uFF0C\u5C31\u662F\u9032\u5316\u3002[VAR 0114(002A)]",
  "\u4ECA\u5929\u6211\u5011\u8981\u5B78\u7FD2\\n\u95DC\u65BC\u5BF6\u53EF\u5922\u9032\u5316\u7684\u4E8B\u5594\uFF5E[VAR 0114(002A)]",
  "\u8B93\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\\n\u6F38\u6F38\u63D0\u5347\u7B49\u7D1A\u4E4B\u5F8C\uFF0C\\r\\n\u7260\u5C31\u6703\u5B78\u6703\u62DB\u5F0F\uFF0C\u4E26\u4E14\u8B8A\u5F37\u3002[VAR 0114(002A)]",
  "\u7576\u5BF6\u53EF\u5922\u7684\u7B49\u7D1A\\n\u9054\u5230\u67D0\u500B\u7A0B\u5EA6\u4E4B\u5F8C\u2026\u2026[VAR 0114(002A)]",
  "\u7260\u7684\u5916\u89C0\u5C31\u6703\u6539\u8B8A\uFF0C\\n\u80FD\u529B\u4E5F\u6703\u6709\u5F88\uFF5E\u5927\u7684\u63D0\u5347\u3002[VAR 0114(002A)]",
  "\u9019\u5C31\u662F\u5BF6\u53EF\u5922\u7684\u9032\u5316\uFF01[VAR 0114(002A)]",
  "\u5BF6\u53EF\u5922\u4E00\u65E6\u9032\u5316\u5F8C\\n\u5C31\u6703\u8B8A\u5F97\u5F88\u5F37\uFF0C\\r\\n\u6703\u6210\u70BA\u5C0D\u6230\u6642\u5F88\u53EF\u9760\u7684\u5925\u4F34\u5594\u3002[VAR 0114(002A)]",
  "\u2026\u2026\u4F46\u662F\uFF01\u4E0D\u60F3\u8B93\u5BF6\u53EF\u5922\u9032\u5316\uFF0C\\n\u5E0C\u671B\u53EF\u4EE5\u7DAD\u6301\u7260\u4E00\u76F4\u4EE5\u4F86\u7684\u6A23\u5B50\uFF0C\\r\\n\u7E7C\u7E8C\u75BC\u611B\u7260\u3002\u4E5F\u662F\u6709\u9019\u6A23\u7684\u4EBA\u7684\u3002[VAR 0114(002A)]",
  "\u82E5\u662F\u9019\u6A23\uFF0C\u53EF\u4EE5\u5728\u5BF6\u53EF\u5922\u958B\u59CB\u9032\u5316\u6642\\n\u4E0D\u614C\u4E0D\u5FD9\u5730\u4F7F\u7528\u9019\u500B\u53E3\u8A23\u3002[VAR 0114(002A)]",
  "\u5927\u5BB6\u4E00\u8D77\u56DE\u7B54\u5427\u3002\\n\u4EC0\u9EBC\u9375\u53D6\u6D88\u9032\u5316\u5462\u2026\u2026\u4E00\u3001\u4E8C\uFF5E\u4E09\uFF01[VAR 0114(002A)]",
  "\uFF21\u9375\uFF01",
  "\uFF22\u9375\uFF01",
  "\uFF23\u9375\uFF01",
  "\u2026\u2026\u5509\u5440\u5440\uFF1F\\n\u53EA\u6709[VAR 0100(0000)]\u56DE\u7B54\u5F97\u4E0D\u4E00\u6A23\u5462\u3002\\c\\n\uFF21\u9375\u6BD4\u8F03\u50CF\u662FOK\u5566\uFF5E\\n\u6216\u662F\u6C7A\u5B9A\u56C9\uFF5E\u7684\u611F\u89BA\u5462\u3002[VAR 0114(002A)]",
  "Best\u7684\uFF22\uFF0C\u6700\u68D2\u7684\uFF22\uFF01\\n\u5927\u5BB6\u90FD\u7B54\u5C0D\u4E86\uFF01[VAR 0114(002A)]",
  "\u2026\u2026\u54CE\u5440\u5440\uFF1F\\n\u53EA\u6709[VAR 0100(0000)]\u7B54\u5F97\u4E0D\u4E00\u6A23\u5462\u3002\\c\\n\uFF23\u9375\u2026\u2026\u9019\u500B\u5B57\u5947\u5999\u5730\u8B93\u6211\u6709\u7A2E\\n\u5F88\u61F7\u5FF5\u7684\u611F\u89BA\u5462\uFF5E[VAR 0114(002A)]",
  "\u597D\u7684\uFF0C\u9019\u500B\u53E3\u8A23\u5C31\u662F\\n\u300C\uFF22\u9375\u53D6\u6D88\u9032\u5316\uFF01\u300D\u3002[VAR 0114(002A)]",
  "\u53EA\u8981\u662F\u5728\u9032\u5316\u958B\u59CB\u5F8C\u7ACB\u523B\u4F7F\u7528\u5B83\uFF0C\\n\u5C31\u80FD\u8B93\u5BF6\u53EF\u5922\u5916\u89C0\u7684\u6539\u8B8A\u505C\u4E0B\u4F86\uFF5E[VAR 0114(002A)]",
  "\u8B93\u5BF6\u53EF\u5922\u651C\u5E36\u53EB\u505A\\n\u4E0D\u8B8A\u4E4B\u77F3\u7684\u9053\u5177\uFF0C\\r\\n\u4E5F\u53EF\u4EE5\u963B\u6B62\u9032\u5316\u5594\uFF5E[VAR 0114(002A)]",
  "\u5C0D\u4E86\uFF0C\u9032\u5316\u7684\u689D\u4EF6\\n\u6703\u96A8\u5BF6\u53EF\u5922\u800C\u5404\u6709\u4E0D\u540C\u3002[VAR 0114(002A)]",
  "\u6709\u9700\u8981\u4F7F\u7528\u706B\u4E4B\u77F3\u3001\u96F7\u4E4B\u77F3\u7B49\u9053\u5177\\n\u624D\u6703\u9032\u5316\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u4E5F\u6709\u5FC5\u9808\u5B78\u6703\u7279\u5B9A\u62DB\u5F0F\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u4E5F\u6709\u7684\u5FC5\u9808\u6253\u5012\u7279\u5B9A\u5BF6\u53EF\u5922\u624D\u6703\u9032\u5316\u3002[VAR 0114(002A)]",
  "\u4F8B\u5982\u8B93\u706B\u7206\u7334\u9032\u5316\u6210\u68C4\u4E16\u7334\u7684\u65B9\u6CD5\uFF0C\\n\u66F4\u662F\u7279\u5225\u5F97\u4E0D\u5F97\u4E86\u2026\u2026[VAR 0114(002A)]",
  "\u5F97\u8B93\u67D0\u500B\u62DB\u5F0F\u2026\u2026[VAR 0114(002A)]",
  "\u2026\u2026\u4E0D\u597D\u610F\u601D\uFF0C\\n\u6B63\u597D\u5230\u4E86\u4E0B\u8AB2\u6642\u9593\u4E86\u5462\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u5929\u5C31\u5230\u6B64\u70BA\u6B62\u5427\u3002\\n\u4E0B\u8AB2\u56C9\uFF5E[VAR 0114(002A)]"
]
