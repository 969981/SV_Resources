  "\u9996\u5148\u6211\u6703\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C07\u5411\u65E5\u82B1\u602A\u5EE3\u5834\u7684\u4F4D\u7F6E\\n\u767B\u9304\u5230\u5730\u5716\u4E0A\u3002\\c\\n\u7D30\u7BC0\u5C31\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u53BB\u554F\\n\u5728\u90A3\u88E1\u7684\u5DE5\u4F5C\u4EBA\u54E1\u5427\u3002\\c\\n\u8D70\u51FA\u9053\u9928\u5F8C\u7ACB\u523B\u53F3\u8F49\uFF01\\n\u5F80\u5F88\u5927\u7684\u5411\u65E5\u82B1\u602A\u88DD\u98FE\u8D70\u5C31\u5C0D\u4E86\uFF01",
