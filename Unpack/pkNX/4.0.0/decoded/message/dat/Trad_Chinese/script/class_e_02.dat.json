[
  "\u4ECA\u5929\u4E5F\u8981\u6D3B\u529B\u6EFF\u5206\u5B78\u5C0D\u6230\u5B78\uFF01\\n\u563F\u5440\uFF01\u958B\u59CB\u56C9\uFF01[VAR 0114(0024)]",
  "\u5404\u4F4D\u662F\u5426\u5F88\u559C\u6B61\u6821\u5916\u7814\u7A76\uFF0C\\n\u4E5F\u5C31\u662F\u6240\u8B02\u7684\u5C0B\u5BF6\u5462\uFF01\uFF1F[VAR 0114(0024)]",
  "\u4EE5\u9053\u9928\u70BA\u76EE\u7684\u5730\uFF01\u7A7F\u8D8A\u91CE\u5730\uFF01\\n\u8207\u642D\u6A94\u5BF6\u53EF\u5922\u4E00\u8D77\u5954\u8DD1\uFF01\\r\\n\u6709\u5927\u5192\u96AA\u5728\u7B49\u8457\u5404\u4F4D\uFF0C\u5C0D\u5427\uFF01[VAR 0114(0024)]",
  "\u800C\u7576\u5404\u4F4D\u5728\u6821\u5916\u884C\u52D5\u6642\uFF0C\\n\u662F\u4E0D\u662F\u5E38\u5E38\u6703\u767C\u73FE\u5DE8\u5927\u9583\u8000\u7684[VAR FF00(0006)]\u7D50\u6676[VAR FF00(0000)]\u554A\uFF01[VAR 0114(0024)]",
  "\u90A3\u7D50\u6676\u662F\u5F9E\u5730\u4E2D\u6EF2\u51FA\u7684\\n\u592A\u6676\u80FD\u91CF\u7684\u5DE8\u584A\uFF01[VAR 0114(0024)]",
  "\u4E00\u65E6\u8ABF\u67E5\u7D50\u6676\u5F8C\uFF0C\\n\u5C31\u5F97\u548C\u670B\u53CB\u6216\u5176\u4ED6\u4EBA\uFF14\u4EBA\u4E00\u7D44\uFF0C\\r\\n\u8207\u592A\u6676\u5BF6\u53EF\u5922\u5C55\u958B\u5C0D\u6230\uFF01[VAR 0114(0024)]",
  "\u9019\u6A23\u7684\u5C0D\u6230\u7A31\u70BA\\n\u592A\u6676\u5718\u9AD4\u6230\uFF01\uFF01[VAR 0114(0024)]",
  "\u5728\u592A\u6676\u5718\u9AD4\u6230\u8981\u9762\u5C0D\u7684\\n\u592A\u6676\u5BF6\u53EF\u5922\u662F\u500B\u5F37\u6575\uFF01[VAR 0114(0024)]",
  "\u7260\u6709\u6642\u5019\u6703\u6709\u8207\u4E00\u822C\u5BF6\u53EF\u5922\\n\u4E0D\u540C\u7684\u884C\u52D5\uFF0C\u5343\u842C\u4E0D\u53EF\u5927\u610F\uFF01[VAR 0114(0024)]",
  "\u4E0D\u904E\uFF0C\u5728\u592A\u6676\u5718\u9AD4\u6230\u4E2D\\n\u8A13\u7DF4\u5BB6\u4E5F\u53EF\u4EE5\u63A1\u53D6\u7279\u6B8A\u7684\u884C\u52D5\uFF0C\\r\\n\u90A3\u5C31\u662F\u300C[VAR FF00(0006)]\u8072\u63F4[VAR FF00(0000)]\u300D\uFF01[VAR 0114(0024)]",
  "\u8072\u63F4\u6709\uFF13\u7A2E\uFF01[VAR 0114(0024)]",
  "[VAR FF00(0006)]\u885D\u885D\u731B\u653B[VAR FF00(0000)]\u53EF\u4EE5\\n\u63D0\u5347\u6211\u65B9\u5168\u9AD4\u7684\u653B\u64CA\u8207\u7279\u653B\u3002[VAR 0114(0024)]",
  "[VAR FF00(0006)]\u5805\u5805\u56FA\u5B88[VAR FF00(0000)]\u53EF\u4EE5\\n\u63D0\u5347\u6211\u65B9\u5168\u9AD4\u7684\u9632\u79A6\u8207\u7279\u9632\u3002[VAR 0114(0024)]",
  "\u800C\u7B2C\uFF13\u7A2E\u662F\u2026\u2026\\n\u8B93\u6211\u4F86\u554F\u554F\u5404\u4F4D\u5427\uFF01[VAR 0114(0024)]",
  "\u80FD\u5920\u56DE\u5FA9\u6211\u65B9\u5168\u9AD4\u9AD4\u529B\u7684\u8072\u63F4\\n\u53EB\u4EC0\u9EBC\u540D\u5B57\u5462\uFF01\uFF1F[VAR 0114(0024)]",
  "\u5566\u5566\u7642\u7652",
  "\u731B\u731B\u6F86\u50B7\u85E5",
  "\u7206\u88C2\u56DE\u5FA9\u6CE2",
  "\u6B63\u78BA\u7B54\u6848\uFF01\\n\u8F49\u5B78\u751F[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u5C0D\u6230\u5B78\u7684\u5927\u5E2B\u554A\uFF01[VAR 0114(0024)]",
  "\u731B\u731B\u6F86\u50B7\u85E5\u2026\u2026\uFF01\uFF1F\\n\u9019\u8207\u5176\u8AAA\u662F\u8072\u63F4\uFF0C\u4E0D\u5982\u8AAA\u662F\\r\\n\u5F37\u5236\u6027\u7684\u91AB\u7642\u884C\u70BA\u554A\u2026\u2026\uFF01[VAR 0114(0024)]",
  "\u7206\u88C2\u56DE\u5FA9\u6CE2\u2026\u2026\uFF01\uFF1F\\n\u76F8\u7576\u6709\u7126\u9999\u5473\u5462\u3002\\r\\n\u8981\u662F\u771F\u6709\u9019\u6A23\u7684\u62DB\u5F0F\uFF0C\u6211\u771F\u60F3\u7528\u770B\u770B\uFF01[VAR 0114(0024)]",
  "\u7B2C\uFF13\u7A2E\u662F[VAR FF00(0006)]\u5566\u5566\u7642\u7652[VAR FF00(0000)]\uFF01\\n\u5B83\u80FD\u56DE\u5FA9\u9AD4\u529B\uFF0C\\r\\n\u9084\u80FD\u6CBB\u7652\u7570\u5E38\u72C0\u614B\uFF0C\u975E\u5E38\u512A\u79C0\uFF01[VAR 0114(0024)]",
  "\u5728\uFF11\u5834\u592A\u6676\u5718\u9AD4\u6230\u4E2D\uFF0C\\n\u6700\u591A\u53EF\u4EE5\u9032\u884C\uFF13\u6B21\u8072\u63F4\u5594\uFF01[VAR 0114(0024)]",
  "\u9806\u5E36\u4E00\u63D0\uFF0C\\n\u4F7F\u7528\u8072\u63F4\u6703\u6D88\u8017\u81EA\u5DF1\u7684\u56DE\u5408\uFF0C\\r\\n\u5BF6\u53EF\u5922\u5728\u90A3\u4E00\u56DE\u5408\u7121\u6CD5\u51FA\u62DB\u5594\uFF01[VAR 0114(0024)]",
  "\u7D50\u8AD6\uFF01\uFF01[VAR 0114(0024)]",
  "\u786C\u7684\u4E0D\u884C\uFF0C\u5C31\u4F86\u8EDF\u7684\uFF01\\n\u8981\u662F\u518D\u4E0D\u884C\uFF0C\u5C31\u7528\u8072\u63F4\u5427\uFF01[VAR 0114(0024)]",
  "\u900F\u904E\u652F\u63F4\u5925\u4F34\uFF0C\\n\u8AAA\u4E0D\u5B9A\u80FD\u958B\u95E2\u53E6\u4E00\u689D\u8DEF\u5594\uFF01[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u539F\u672C\u6253\u7B97\u8B93\u5404\u4F4D\u89AA\u8EAB\u9AD4\u9A57\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u6642\u9593\u5DF2\u7D93\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u90A3\u9EBC\uFF0C\u5C31\u6B64\u89E3\u6563\uFF01\\n\u795D\u5404\u4F4D\u4ECA\u5929\u4E5F\u6D3B\u529B\u6EFF\u5206\uFF01[VAR 0114(0024)]"
]
