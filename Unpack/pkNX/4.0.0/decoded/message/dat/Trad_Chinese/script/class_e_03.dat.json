  "\u5982\u679C\u80FD\u6301\u7E8C\u7D66\u4E88\u50B7\u5BB3\uFF0C\\n\u5C31\u80FD\u7834\u58DE\u592A\u6676\u8B77\u76FE\uFF0C\\r\\n\u9032\u800C\u4F7F\u5C0D\u624B\u5931\u53BB\u5E73\u8861\u5462\uFF01[VAR 0114(0024)]",
  "\u6240\u4EE5\u5728\u592A\u6676\u5718\u9AD4\u6230\u4E2D\\n\u4F7F\u7528\u592A\u6676\u5316\u7684\u6642\u6A5F\u4E5F\u975E\u5E38\u91CD\u8981\u3002[VAR 0114(0024)]",
  "\u7D50\u8AD6\uFF01\uFF01[VAR 0114(0024)]",
  "\u6B63\u5982\u4FD7\u8A71\u8AAA\u4EE5\u773C\u9084\u773C\uFF01\\n\u5C0D\u4ED8\u592A\u6676\u5316\uFF0C\u5C31\u8981\u7528\u592A\u6676\u5316\uFF01[VAR 0114(0024)]",
  "\u8ACB\u5404\u4F4D\u52D9\u5FC5\u8207\u5925\u4F34\u597D\u597D\u914D\u5408\uFF0C\\n\u64CA\u7834\u5C0D\u624B\u7684\u592A\u6676\u8B77\u76FE\u3002[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u6211\u539F\u672C\u6253\u7B97\u8B93\u5404\u4F4D\u89AA\u8EAB\u9AD4\u9A57\u7684\uFF0C\\n\u60F3\u4E0D\u5230\u6642\u9593\u5DF2\u7D93\u5230\u4E86\u2026\u2026[VAR 0114(0024)]",
  "\u4E0B\u4E00\u5802\u8AB2\u8981\u8003\u671F\u4E2D\u8003\u56C9\uFF01\\n\u7784\u6E96\uFF11\uFF10\uFF10\u5206\uFF01\u563F\u5440\uFF01\u563F\u5440\uFF01[VAR 0114(0024)]"
