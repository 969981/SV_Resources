  "\u975C\u975C\u9589\u4E0A\u773C\u775B",
  "\u6253\u96FB\u8A71\u56DE\u5BB6",
  "\u592A\u6676\u5316\u5F8C\u53BB\u653B\u64CA",
  "\u5582\u5582\u5582\uFF0C\u5225\u9019\u9EBC\u4E56\u4E56\u5730\\n\u8A8D\u547D\u63A5\u53D7\u6700\u5F8C\u4E00\u523B\u554A\uFF01\\r\\n\u596E\u529B\u6399\u624E\u61C9\u8A72\u5C31\u6703\u6709\u7A81\u7834\u7684\uFF01[VAR 0114(0024)]",
  "\u5582\u5582\u5582\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u767C\u73FE\u6700\u5F8C\u4E00\u523B\u8FD1\u4E86\uFF0C\\n\u6240\u4EE5\u60F3\u548C\u5BB6\u4EBA\u8AAA\u8A71\u55CE\uFF01\uFF1F\\r\\n\u596E\u529B\u6399\u624E\u61C9\u8A72\u5C31\u6703\u6709\u7A81\u7834\u7684\uFF01[VAR 0114(0024)]",
  "\u6B63\u78BA\u7B54\u6848\uFF01\u8F49\u5B78\u751F[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\\n\u592A\u6676\u5718\u9AD4\u6230\u7684\u5927\u5E2B\u554A\uFF01[VAR 0114(0024)]",
