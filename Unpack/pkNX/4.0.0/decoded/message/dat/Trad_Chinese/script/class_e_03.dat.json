[
  "\u4ECA\u5929\u4E5F\u8981\u6D3B\u529B\u6EFF\u5206\u5B78\u5C0D\u6230\u5B78\uFF01\\n\u563F\u5440\uFF01\u958B\u59CB\u56C9\uFF01[VAR 0114(0024)]",
  "\u4E0A\u4E00\u5802\u8AB2\u6240\u6559\u7684\u592A\u6676\u5718\u9AD4\u6230\uFF01\\n\u5404\u4F4D\u6709\u53BB\u6311\u6230\u55CE\uFF01\uFF1F[VAR 0114(0024)]",
  "\u592A\u6676\u5BF6\u53EF\u5922\u662F\u500B\u5F37\u6575\uFF01\\n\u8981\u662F\u9047\u4E0A\u9AD8\u96E3\u5EA6\u7684\u5C0D\u624B\uFF0C\\r\\n\u7260\u9084\u6703\u63A1\u53D6\u5F88\u68D8\u624B\u7684\u884C\u52D5\u2026\u2026[VAR 0114(0024)]",
