[
  "\u5B78\u9662\u88E1\u8D85\u51FA\u540D\u7684\u5730\u7344\u6A13\u68AF\uFF01\\n\u722C\u8D77\u4F86\u5F88\u7D2F\u4EBA\u5C0D\u5427\uFF01",
  "\u684C\u53F0\u5E02\u662F\u5B78\u6821\u8207\u6587\u5316\u7684\u57CE\u93AE\uFF01\\n\u9019\u5730\u65B9\u5C31\u50CF\u684C\u5B50\u4E00\u6A23\u5BEC\u5EE3\u3002",
  "\u5B78\u6821\u88E1\u6709\u5404\u5F0F\u5404\u6A23\u7684\\n\u4EBA\u548C\u5BF6\u53EF\u5922\u5594\uFF01\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u662F\u5404\u5F0F\u5404\u6A23\u7684\u5176\u4E2D\u4E4B\u4E00\uFF01",
  "\u5929\u661F\u968A\u7684\u4EBA\u611F\u89BA\u6709\u9EDE\u53EF\u6015\u5462\uFF5E",
  "\u807D\u8AAA\u5929\u661F\u968A\u7684\u4EBA\u6BCF\u5929\u665A\u4E0A\\n\u90FD\u6703\u9A0E\u8457\u5947\u602A\u7684\u8ECA\u98C6\u4F86\u98C6\u53BB\u7684\u3002",
  "\u5728\u5B78\u9662\u88E1\u5B78\u751F\u5011\u53EF\u4EE5\u9078\\n\u81EA\u5DF1\u559C\u6B61\u7684\u8AB2\u4F86\u4E0A\uFF0C\u5C0D\u5427\uFF1F\\r\\n\u6700\u8FD1\u7684\u5B78\u6821\u9084\u771F\u662F\u4E0D\u4E00\u6A23\u554A\uFF5E",
  "\u5582\uFF1F\u672C\u6821\u7684\u5B78\u751F\u5927\u5BB6\u90FD\u662F\u597D\u5B69\u5B50\uFF0C\\n\u771F\u7684\u662F\u5E6B\u4E86\u5927\u5FD9\u3002",
  "\u771F\u4E0D\u6127\u662F\u5E15\u5E95\u4E9E\u6700\u5927\u7684\u90FD\u5E02\uFF01\\n\u6211\u5B8C\u5168\u8FF7\u8DEF\u5566\uFF01",
  "\u5730\u5716\u4E0A\u7DA0\u8272\u6307\u7684\u662F\u5317\u65B9\u5594\u3002\\c\\n\u8A66\u8A66\u770B\u6309\u58D3\uFF32\u64CD\u63A7\u6416\u687F\uFF0C\\n\u628A\u5317\u65B9\u56FA\u5B9A\u6210\u671D\u4E0A\u5982\u4F55\uFF1F",
  "\u5BF6\u53EF\u5922\u806F\u76DF\u5C31\u5728\\n\u96A7\u9053\u7684\u53E6\u4E00\u982D\u3002\\c\\n\u5728\u90A3\u88E1\u53EF\u4EE5\u63A5\u53D7\u70BA\u4E86\\n\u6210\u70BA\u51A0\u8ECD\u7D1A\u7684\u6E2C\u9A57\uFF0C\u5C0D\u5427\uFF1F",
  "\u6211\u53BB\u5BF6\u53EF\u5922\u806F\u76DF\\n\u63A5\u53D7\u4E86\u9762\u8A66\u6E2C\u9A57\uFF01\\r\\n\u9762\u8A66\u5B98\u2026\u2026\u8D85\u53EF\u6015\u7684\u5566\uFF5E",
  "\u57CE\u93AE\u7684\u5916\u9762\u6709\u5F88\u591A\\n\u6C92\u770B\u904E\u7684\u5BF6\u53EF\u5922\u5462\uFF5E",
  "\u8D85\u7D1A\u6A21\u7279\u5152\uFF0C\u8389\u666E\uFF01\\n\u807D\u8AAA\u5979\u548C\u5B78\u6821\u88E1\u7684\\r\\n\u67D0\u500B\u8001\u5E2B\u662F\u5152\u6642\u73A9\u4F34\u5594\uFF01",
  "\u524D\u65B9\u7684\u5CA9\u5C71\u932F\u7D9C\u8907\u96DC\uFF01\\n\u90A3\u88E1\u5F88\u5BB9\u6613\u8FF7\u8DEF\uFF0C\u8981\u5C0F\u5FC3\u554A\u3002\\c\\n\u7A7F\u904E\u5CA9\u5C71\u4E4B\u5F8C\uFF0C\\n\u5C31\u662F\u85DD\u8853\u7684\u57CE\u93AE\uFF0C\u6DF1\u7F3D\u93AE\u5594\u3002",
  "\u662F\u77E5\u540D\u7684\u535A\u58EB\u89E3\u660E\u4E86\\n\u5BF6\u53EF\u5922\u7684\u592A\u6676\u5316\u73FE\u8C61\uFF0C\u5C0D\u5427\uFF1F",
  "\u807D\u8AAA\u90A3\u4F4D\u535A\u58EB\u2026\u2026\\n\u5728\u5E15\u5E95\u4E9E\u5DE8\u5751\u505A\u5F88\u9A5A\u4EBA\u7684\u7814\u7A76\u3002",
  "\u7761\u5F97\u98FD\uFF5E\u98FD\u7684\u8A71\uFF0C\\n\u5C31\u6703\u5230\u80FD\u53BB\u4E0A\u5B78\u7684\u90A3\u5929\u56C9\u3002",
  "\u6211\u4E5F\u60F3\u5FEB\u9EDE\\n\u5230\u5B78\u9662\uFF5E\u4E0A\u8AB2\uFF5E\uFF01",
  "\u6642\u9593\u6703\u6D41\u901D\u2026\u2026\\n\u5929\u6C23\u6703\u8B8A\u5316\u2026\u2026\\c\\n\u807D\u8AAA\u91CE\u751F\u5BF6\u53EF\u5922\u7684\u884C\u52D5\\n\u6703\u96A8\u8457\u6642\u9593\u548C\u5929\u6C23\u6539\u8B8A\u3002",
  "\u597D\u5927\u7684\u6C34\u6C60\uFF5E\uFF01\\c\\n\u597D\u60F3\u50CF\u9BC9\u9B5A\u738B\u4E00\u6A23\\n\u5728\u6C34\u9762\u4E0A\u6F02\u554A\u6F02\u7684\u3002",
  "\u5B78\u6821\u7684\u8001\u5E2B\u7E3D\u6703\u88AB\\n\u53D6\u4E00\u4E9B\u5947\u602A\u7684\u7DBD\u865F\u3002\\c\\n\u6BD4\u5982\u8AAA\u300C\u963F\u6714\u300D\u5566\uFF5E\u300C\u8CFD\u5409\u5144\u300D\u5566\uFF5E\u4E4B\u985E\u7684\uFF0C\\n\u5B78\u751F\u5011\u5728\u804A\u5929\u7684\u6642\u5019\u6211\u807D\u5230\u4E86\u3002",
  "\u6839\u64DA\u4E0D\u540C\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u4E5F\u6703\u6709\u5404\u81EA\u7121\u6CD5\u5B78\u6703\u7684\u62DB\u5F0F\u5462\u3002",
  "\u6211\u60F3\u8981\u592A\u6676\u73E0\uFF0C\\n\u4F46\u662F\u6210\u7E3E\u4E0D\u5920\u597D\u2026\u2026",
  "\u53EA\u6709\u512A\u79C0\u7684\u5B78\u751F\\n\u624D\u80FD\u62FF\u5230\u592A\u6676\u73E0\u5594\u3002\\r\\n\u56E0\u70BA\u5B83\u7684\u529B\u91CF\u5BE6\u5728\u592A\u5F37\u4E86\u3002",
  "\u9019\u88E1\u662F\u684C\u53F0\u5E02\uFF0C\\n\u662F\u5E15\u5E95\u4E9E\u6700\u5927\u7684\u57CE\u93AE\uFF01",
  "\u85A9\u54E5\u7684\u5BB6\u653F\u8AB2\u975E\u5E38\u6709\u7528\u5594\uFF5E\uFF01",
  "\u857E\u8377\u8001\u5E2B\u7684\u6B77\u53F2\u8AB2\u8D85\u6709\u8DA3\u7684\uFF5E\uFF01",
  "\u4ECA\u5929\u8981\u53BB\u54EA\u4E00\u9593\\n\u4E09\u660E\u6CBB\u5E97\u5403\u6771\u897F\u597D\u5462\uFF1F",
  "\u5C31\u7B97\u662F\u540C\u6A23\u7684\u5E97\uFF0C\u5728\u4E0D\u540C\u7684\u5730\u65B9\\n\u8CA9\u8CE3\u7684\u5546\u54C1\u4E5F\u6703\u6709\u5FAE\u5999\u7684\u4E0D\u540C\u3002",
  "\u5728\u5E02\u8857\u4E0A\u7684\u5BF6\u53EF\u5922\\n\u901A\u5E38\u90FD\u662F\u5225\u4EBA\u7684\u5925\u4F34\uFF0C\\r\\n\u6240\u4EE5\u4E0D\u80FD\u4E82\u6349\u5594\u3002",
  "\u6211\u7684\u5BF6\u53EF\u5922\u5C0D\u8072\u97F3\u5F88\u654F\u611F\uFF01",
  "\u5373\u4F7F\u662F\u76F8\u540C\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u6027\u683C\u3001\u7279\u6027\u548C\u5BE6\u529B\u4E5F\u4E0D\u76E1\u76F8\u540C\u3002",
  "\u5E15\u5E95\u4E9E\u7684\u96E8\u65E2\u4E0D\u51B0\u51B7\u4E5F\u4E0D\u6703\u4E0B\u4E0D\u505C\uFF0C\\n\u6240\u4EE5\u6211\u90FD\u4E0D\u6490\u5098\u7684\u3002",
  "\u6211\u5152\u5B50\u597D\u50CF\u52A0\u5165\u4E86\u5929\u661F\u968A\u5594\uFF5E\\n\u90A3\u61C9\u8A72\u662F\u5F88\u5FEB\u6A02\u7684\u793E\u5718\u5427\uFF5E",
  "\u4E2D\u592E\u5EE3\u5834\u7684\u5C0D\u6230\u5834\uFF01\\c\\n\u56E0\u70BA\u6703\u53D7\u5230\u5927\u5BB6\u77DA\u76EE\uFF0C\\n\u6C92\u81EA\u4FE1\u7684\u8A71\u6839\u672C\u4E0D\u6562\u7528\u90A3\u500B\u5730\u65B9\u5462\u3002",
  "\u807D\u8AAA\u5176\u4ED6\u7684\u5730\u5340\uFF0C\\n\u51A0\u8ECD\u53EA\u6709\uFF11\u500B\u4EBA\uFF01\\c\\n\u5728\u5E15\u5E95\u4E9E\u7684\u8A71\u51A0\u8ECD\u7D1A\u6709\u597D\u5E7E\u500B\u4EBA\uFF0C\\n\u5F88\u53B2\u5BB3\u5427\uFF01",
  "\u6211\u4E0D\u559C\u6B61\u4E0A\u7DB2\u8CB7\u6771\u897F\u2026\u2026\\n\u9084\u662F\u770B\u904E\u5BE6\u969B\u7684\u5546\u54C1\u4E4B\u5F8C\u518D\u8CB7\u624D\u5B89\u5FC3\u3002",
  "\u59B3\u77E5\u9053\u55CE\uFF1F\\n\u6700\u591A\u53EF\u4EE5\u5E36\uFF16\u96BB\u5BF6\u53EF\u5922\u4E00\u8D77\u540C\u884C\u5594\uFF01",
  "\u6C92\u8FA6\u6CD5\u5E36\u4E0A\u7684\u5BF6\u53EF\u5922\\n\u6703\u88AB\u9001\u5230\u76D2\u5B50\u88E1\uFF0C\u5C0D\u5427\uFF1F",
  "\u5230\u8655\u64BF\u5BF6\u53EF\u5922\u7684\u6389\u843D\u7269\uFF0C\\n\u518D\u7528\u4EA4\u63DB\u4F86\u7684\uFF2C\uFF30\u652F\u4ED8\u2026\u2026\\r\\n\u9019\u9EBC\u4E00\u4F86\u5C31\u7B97\u6C92\u6709\u9322\uFF0C\u4E5F\u80FD\u8CB7\u60F3\u8981\u7684\u6771\u897F\uFF01",
  "\u684C\u53F0\u5E02\u662F\u5B78\u554F\u4E4B\u57CE\uFF5E\u266A\\n\u5B78\u9662\u662F\u6211\u7684\u6BCD\u6821\uFF5E\u5566\u5566\u5566\uFF5E\u266A",
  "\u5B78\u6821\u5165\u53E3\u5927\u5EF3\u66F8\u67B6\u4E0A\u7684\u90A3\u4E9B\u66F8\uFF0C\\n\u901A\u901A\u90FD\u80FD\u81EA\u7531\u95B1\u8B80\uFF01\\r\\n\u5C0D\u559C\u6B61\u770B\u66F8\u7684\u4EBA\u4F86\u8AAA\uFF0C\u5BE6\u5728\u662F\u592A\u5E78\u798F\u4E86\uFF5E",
  "\u6211\u662F\u5B78\u9662\u7684\u7562\u696D\u751F\uFF01\\n\u73FE\u5728\u9084\u6709\u90A3\u500B\u53EB\u5C0B\u5BF6\u7684\u6D3B\u52D5\u55CE\uFF1F",
  "\u5B78\u9662\u6C92\u6709\u5E74\u9F61\u9650\u5236\uFF01\\n\u807D\u8AAA\u8001\u5976\u5976\u4E5F\u80FD\u5165\u5B78\uFF01\\r\\n\u2026\u2026\u6211\u4E5F\u56DE\u5B78\u9662\u53BB\u91CD\u8B80\u597D\u4E86\uFF1F",
  "\u524D\u9762\u662F\u897F\u9580\u3002\\n\u8981\u53BB\u5713\u6A21\u93AE\u7684\u8A71\u5C31\u8D70\u897F\u9580\uFF01",
  "\u897F\u9580\u5728\u90A3\u908A\u7684\u90A3\u689D\u8DEF\u4E0A\uFF01\\n\u8981\u5F9E\u7F50\u982D\u5E97\u7684\u65C1\u908A\u7D93\u904E\u3002",
  "\u524D\u9762\u662F\u689D\u6B7B\u8DEF\uFF01\\n\u90A3\u88E1\u53EA\u6709\u4E5D\u516B\u9152\u5427\u5594\uFF01",
  "\u4F86\u505A\u6821\u5916\u7814\u7A76\u7684\u6E96\u5099\u597D\u4E86\uFF01\\n\u4FE1\u4F7F\u9CE5\u5305\u5305\u5728\u54EA\u88E1\u4F86\u8457\uFF1F",
  "\u4FE1\u4F7F\u9CE5\u5305\u5305\u6709\u5E7E\u9593\u5E97\u92EA\uFF0C\\n\u5F80\u5357\u8D70\u7684\u8A71\u5F88\u5FEB\u5C31\u80FD\u770B\u5230\u4E86\u3002",
  "\u53EA\u8981\u770B\u5F97\u898B\u5BF6\u53EF\u5922\u4E2D\u5FC3\uFF0C\u6211\u5C31\u89BA\u5F97\u653E\u5FC3\u3002\\n\u2026\u2026\u90A3\u88E1\u64AD\u653E\u7684\u97F3\u6A02\u4E5F\u5F88\u68D2\u3002",
  "\u53EA\u8981\u662F\u53BB\u904E\uFF11\u6B21\u7684\u5BF6\u53EF\u5922\u4E2D\u5FC3\uFF0C\\n\u642D\u98DB\u7FD4\u8A08\u7A0B\u8ECA\u5C31\u80FD\u7ACB\u523B\u524D\u5F80\u5594\u3002",
  "\u57CE\u93AE\u548C\u57CE\u5E02\u6709\u4EC0\u9EBC\u4E0D\u4E00\u6A23\u2026\u2026\\n\u5927\u5C0F\u55CE\uFF1F",
  "\u5728\u5E15\u5E95\u4E9E\u5730\u5340\uFF0C\\n\u53EB\u300C\uFF5E\u5E02\u300D\u7684\u5730\u65B9\u6709\uFF13\u500B\uFF01\\r\\n\u5176\u4E2D\uFF11\u500B\u5C31\u662F\u9019\u88E1\uFF0C\u684C\u53F0\u5E02\u3002",
  "\u6211\u807D\u8AAA\u9019\u9644\u8FD1\u6709\u4EBA\\n\u5728\u8CE3\u5F88\u7A00\u6709\u7684\u4E09\u660E\u6CBB\u2026\u2026\\r\\n\u4E0D\u66C9\u5F97\u5728\u54EA\u88E1\u5462\uFF1F",
  "\u4E09\u660E\u6CBB\u597D\u597D\u5403\uFF5E\uFF01\\n\u6211\u6BCF\u5929\u90FD\u60F3\u5403\uFF5E\uFF01",
  "\u5475\u5475\u5475\uFF01\\n\u4E0B\u6B21\u8981\u4E0D\u8981\u4E00\u8D77\u505A\u6599\u7406\u5440\uFF1F",
  "\u5317\u908A\u4F4F\u5B85\u5340\u6797\u7ACB\uFF01\\c\\n\u807D\u8AAA\u5982\u679C\u662F\u4F4F\u5728\u684C\u53F0\u5E02\u7684\u5B78\u751F\uFF0C\\n\u60F3\u4F4F\u5B78\u751F\u5BBF\u820D\u662F\u6703\u88AB\u5B78\u6821\u7D66\u62D2\u7D55\u7684\u3002",
  "\u5149\u662F\u770B\u5230\u5225\u4EBA\u5E36\u8457\u5BF6\u53EF\u5922\u4E00\u8D77\u8D70\uFF0C\\n\u6211\u5C31\u89BA\u5F97\u597D\u7642\u7652\u5594\u3002",
  "\u4E09\u660E\u6CBB\u771F\u597D\u5403\uFF01\\n\u5C24\u5176\u9019\u9593\u5E97\u7684\u4E09\u660E\u6CBB\u66F4\u662F\u597D\u5403\u597D\u5403\uFF01",
  "\u5728\u4FE1\u4F7F\u9CE5\u5305\u5305\u8CB7\u624B\u6A5F\u6BBC\u7684\u8A71\uFF0C\\n\u5C31\u80FD\u6539\u8B8A\u624B\u6A5F\u6D1B\u6258\u59C6\u7684\u5916\u89C0\uFF01\\r\\n\u55EF\uFF5E\u8981\u9078\u54EA\u4E00\u500B\u597D\u5462\u2026\u2026\u771F\u7169\u60F1\uFF01",
  "\u6709\u4E00\u5929\u7B49\u6211\u6349\u5230\u5BF6\u53EF\u5922\uFF0C\\n\u6211\u8981\u6210\u70BA\u51A0\u8ECD\u7D1A\uFF5E\uFF01",
  "\u5B78\u6821\u88E1\u73FE\u5728\u6D41\u884C\u661F\u578B\u7684\u592A\u967D\u773C\u93E1\u55CE\uFF1F\\n\u6211\u770B\u5230\u6709\u96C6\u5718\u6234\u8457\u90A3\u7A2E\u773C\u93E1\u5462\u3002",
  "\u5C0D\u6230\u5834\u7684\u984F\u8272\u6216\u5916\u89C0\\n\u6703\u96A8\u57CE\u93AE\u800C\u6709\u4E0D\u540C\u5594\u3002",
  "\u5BF6\u53EF\u5922\u4E2D\u5FC3\u7684\u59D0\u59D0\u5728\u5E6B\u5FD9\u56DE\u5FA9\u7684\u6642\u5019\uFF0C\\n\u90FD\u6703\u544A\u8A34\u6211\u4E00\u4E9B\u5C0F\u77E5\u8B58\u3002\\r\\n\u2026\u2026\u53EA\u6709\u6211\u64C1\u6709\u9019\u7A2E\u7279\u5225\u5F85\u9047\u55CE\uFF01\uFF1F",
  "\u6211\u8B93\u5E15\u5947\u5229\u8332\u651C\u5E36\\n\u6211\u5728\u4FE1\u4F7F\u9CE5\u5305\u5305\u8CB7\u7684\u9053\u5177\uFF01\\c\\n\u6309\u7167\u651C\u5E36\u7684\u9053\u5177\uFF0C\\n\u53EF\u662F\u6703\u6709\u5404\u5F0F\u5404\u6A23\u7684\u52A0\u5F37\u6548\u679C\uFF01",
  "\u5148\u5236\u4E4B\u722A\uFF01\u8B93\u5BF6\u53EF\u5922\u651C\u5E36\u7684\u8A71\uFF0C\\n\u6709\u6642\u5019\u6703\u6709\u8B93\u4EBA\u958B\u5FC3\u7684\u4E8B\u767C\u751F\u5594\uFF01\\r\\n\u90A3\u908A\u90A3\u9593\u7D05\u8272\u7684\u5546\u5E97\u6709\u5728\u8CE3\uFF01",
  "\u5F9E\u897F\u9580\u51FA\u53BB\u4E00\uFF5E\u76F4\u8D70\u7684\u8A71\uFF0C\\n\u5C31\u80FD\u8D70\u5230\u5713\u6A21\u93AE\uFF01\\r\\n\u73FE\u5728\u6B63\u597D\u662F\u8C50\u6536\u796D\u7684\u6642\u671F\u5462\u3002",
  "\u9752\u9285\u9418\u597D\u6709\u9B45\u529B\u2026\u2026\\c\\n\u6709\u6642\u5019\u6211\u6703\u9032\u53BB\u9418\u88E1\u9762\uFF0C\\n\u5F88\u795E\u5947\u5730\u4E00\u9032\u53BB\u5C31\u89BA\u5F97\u5167\u5FC3\u5E73\u975C\u3002",
  "\u6211\u8FF7\u8DEF\u4E86\u3002\\n\u9084\u662F\u770B\u770B\u5730\u5716App\u597D\u4E86\u3002",
  "\u5403\u4E86\u9019\u88E1\u7684\u6599\u7406\uFF0C\\n\u5C31\u6703\u5145\u6EFF\u86CB\u86CB\u529B\u5594\u3002\\c\\n\u5728\u91CE\u9910\u6642\u5C31\u6703\u66F4\u5BB9\u6613\u627E\u5230\u5BF6\u53EF\u5922\u7684\u86CB\u3002",
  "\u5BF6\u53EF\u5922\u7684\u6389\u843D\u7269\u5728\u62DB\u5F0F\u5B78\u7FD2\u5668\u6A5F\\n\u53EF\u4EE5\u4EA4\u63DB\u6210\uFF2C\uFF30\u5594\u3002",
  "\u6700\u8FD1\u7684\u6A5F\u5668\u52D5\u4E0D\u52D5\u5C31\u6703\u8AAA\u8A71\uFF01\\n\u62DB\u5F0F\u5B78\u7FD2\u5668\u6A5F\u4E5F\u6703\u767C\u51FA\u8072\u97F3\u5462\u3002",
  "\u5E15\u5947\u5229\u8332\u7684\u7279\u6027\u662F\u9003\u8DD1\uFF01\\n\u7260\u5F88\u64C5\u9577\u5F9E\u91CE\u751F\u5BF6\u53EF\u5922\u7684\u624B\u4E2D\u9003\u8D70\uFF01",
  "\u6700\u8FD1\u7684\u81EA\u52D5\u8CA9\u8CE3\u6A5F\\n\u7528\uFF2C\uFF30\u4E5F\u80FD\u8CB7\u98F2\u6599\u5462\u3002",
  "\u5B78\u6821\u7684\u6A13\u68AF\u5BE6\u5728\u592A\u9577\u4E86\uFF0C\\n\u6240\u4EE5\u6709\u300C\u5730\u7344\u6A13\u68AF\u300D\u9019\u500B\u7A31\u865F\u3002\\r\\n\u4E0A\u4E0B\u5B78\u7684\u5B78\u751F\u5011\u7684\u78BA\u5F88\u8F9B\u82E6\u3002",
  "\u91CE\u751F\u5BF6\u53EF\u5922\u5728\u7761\u89BA\u6642\u5C31\u662F\u6A5F\u6703\uFF01\\n\u53EF\u4EE5\u51FA\u5176\u4E0D\u610F\u5730\u5148\u767C\u5236\u4EBA\uFF01",
  "\u770B\u5230\u5BF6\u53EF\u5922\u5728\u7761\u89BA\u7684\u6A21\u6A23\uFF0C\\n\u6211\u5C31\u6703\u5FCD\u4E0D\u4F4F\u62CD\u7167\u62CD\u5230\u505C\u4E0D\u4E0B\u4F86\u3002",
  "\u65B0\u4EFB\u6821\u9577\u662F\u514B\u62C9\u97CB\u723E\u5C0D\u5427\uFF1F\\n\u6211\u8A18\u5F97\u4ED6\u662F\u5728\uFF11\u5E74\u534A\u524D\u5C31\u4EFB\u7684\u3002",
  "\u5B78\u751F\u6703\u9577\u59AE\u83AB\u662F\u500B\u597D\u5B69\u5B50\u3002\\n\u6211\u5011\u64E6\u8EAB\u800C\u904E\u6642\uFF0C\u5979\u7E3D\u662F\u6703\u5411\u6211\u6253\u62DB\u547C\u3002",
  "\u8981\u662F\u9047\u5230\u4E86\u512A\u7F8E\u7684\u666F\u8272\uFF0C\\n\u5225\u5FD8\u4E86\u7528\u76F8\u6A5FApp\u62CD\u4E0B\u7167\u7247\u5427\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u559C\u6B61\u5728\u5C4B\u9802\u4E0A\\n\u4F11\u606F\u767C\u5446\u55CE\uFF1F\\r\\n\u4E0D\u904E\u8981\u5C0F\u5FC3\u5225\u6389\u4E0B\u53BB\u4E86\u3002",
  "\u9019\u9593\u5E97\u6709\u5728\u8CE3\u984F\u8272\u4E0D\u540C\u7684\\n\u5B78\u6821\u6307\u5B9A\u7684\u5305\u5305\u554A\u3002\\r\\n\u8981\u9078\u54EA\u500B\u984F\u8272\u597D\u5462\uFF5E\uFF1F",
  "\u6211\u8981\u53BB\u7F8E\u9AEE\u6C99\u9F8D\u63DB\u500B\u9AEE\u578B\uFF0C\\n\u4F60\u5728\u9019\u9644\u8FD1\u6253\u767C\u6642\u9593\u5427\uFF5E",
  "\u6709\u4E9B\u9AEE\u578B\u7684\u540D\u5B57\u807D\u8D77\u4F86\\n\u5C31\u50CF\u5BF6\u53EF\u5922\u7684\u62DB\u5F0F\u4E00\u6A23\u3002\\r\\n\u6BD4\u5982\u8AAA\u65C1\u5206\u6216\u662F\u4F4E\u76E4\u9AEE\u4E4B\u985E\u7684\u2026\u2026",
  "\u6211\u5230\u773C\u93E1\u9109\u8CB7\u526F\u773C\u93E1\uFF0C\\n\u8A66\u8A66\u770B\u4EBA\u751F\u7B2C\u4E00\u6B21\u6234\u773C\u93E1\u7684\u9020\u578B\u597D\u4E86\uFF01",
  "\u6211\u60F3\u6234\u9802\u6642\u5C1A\u7684\u5E3D\u5B50\uFF01\\n\u4F46\u53C8\u60F3\u79C0\u51FA\u6211\u7684\u9AEE\u578B\uFF01\\r\\n\u2026\u2026\u7E3D\u4E4B\u9084\u662F\u5148\u9032\u5E97\u88E1\u518D\u7169\u60F1\u5427\u3002",
  "\u5BB9\u6613\u624B\u8173\u51B0\u51B7\u7684\u8A71\uFF0C\u9078\u539A\u896A\u5B50\u5C31\u5C0D\u4E86\uFF01\\n\u9019\u9593\u5E97\u6709\u5404\u5F0F\u5404\u6A23\u7684\u6B3E\u5F0F\u5594\u3002",
  "\u6709\u6C34\u679C\u9084\u6709\u852C\u83DC\u2026\u2026\\n\u9023\u7C73\u98EF\u90FD\u6709\uFF01\uFF1F\\c\\n\u6211\u8981\u5728\u7F50\u982D\u738B\u5927\u8CB7\u7279\u8CB7\u98DF\u6750\uFF0C\\n\u72C2\u505A\u4E09\u660E\u6CBB\u4E86\uFF01"
]
