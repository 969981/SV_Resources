[
  "\u64CD\u5834\u5F88\u5BEC\uFF0C\u6240\u4EE5\u5C31\u7B97\u653E\u5927\u96BB\u7684\\n\u5BF6\u53EF\u5922\u51FA\u4F86\u4E5F\u6C92\u554F\u984C\u5462\uFF01",
  "\u76EF\u8457\u66B4\u9BC9\u9F8D\u7684\u81C9\u770B\uFF0C\\n\u5C31\u6703\u88AB\u7260\u7684\u5A01\u5687\u964D\u4F4E\u653B\u64CA\u8036\u3002",
  "\u807D\u8AAA\u71B1\u5E36\u9F8D\u5C31\u662F\u592A\u559C\u6B61\u6C34\u679C\u4E86\uFF0C\\n\u7D50\u679C\u5F9E\u8116\u5B50\u9577\u51FA\u4E86\u6C34\u679C\u4F86\u8036\uFF01\\r\\n\u2026\u2026\u600E\u9EBC\u6703\u6709\u9019\u7A2E\u4E8B\uFF01\uFF1F",
  "\u98DF\u5802\u7684\u6599\u7406\u5C31\u662F\u7528\u9019\u7247\u7530\u5730\\n\u51FA\u7522\u7684\u98DF\u6750\u88FD\u4F5C\u7684\u5594\u3002",
  "\u63A5\u4E0B\u4F86\u8A72\u57F9\u80B2\u4EC0\u9EBC\u597D\u5462\uFF1F\\n\u57F9\u80B2\u8FB2\u4F5C\u7269\u548C\u5BF6\u53EF\u5922\uFF0C\u90FD\u6709\u4E00\u6A23\u7684\u7169\u60F1\u5462\u3002",
  "\u6469\u6258\u8725\u76AE\u819A\u6ED1\u4EAE\u6ED1\u4EAE\u7684\uFF0C\u597D\u53EF\u611B\uFF01\\n\u8B80\u66F8\u7684\u75B2\u52DE\u90FD\u6D88\u5931\u4E86\uFF5E",
  "\u63D0\u4F9B\u6469\u6258\u8725\u7642\u7652\u6CD5\uFF01\\n\u60F3\u770B\u591A\u4E45\u5C31\u770B\u591A\u4E45\uFF0C\u96A8[VAR 1100(00FF,0101)]\u4F60\u59B3\u559C\u6B61\u5594\u3002",
  "\u6211\u548C\u6CE5\u9A62\u4ED4\u8DD1\u4E86\u4E00\u5834\u99AC\u62C9\u677E\uFF01\\n\u7260\u7684\u6301\u4E45\u529B\u592A\u9A5A\u4EBA\u4E86\uFF01",
  "\u6211\u6B63\u8981\u548C\u670B\u53CB\\n\u6253\u4E00\u5834\u5BF6\u53EF\u5922\u5C0D\u6230\u5462\uFF01",
  "\u670B\u53CB\u4E4B\u9593\u5F7C\u6B64\u90FD\u77E5\u9053\u5C0D\u65B9\u6709\u54EA\u4E9B\u672C\u9818\uFF0C\\n\u6240\u4EE5\u63A8\u6E2C\u5C0D\u624B\u7684\u884C\u52D5\u7279\u5225\u91CD\u8981\u3002",
  "\u83AB\u540D\u5176\u5999\u5C31\u662F\u7761\u4E0D\u8457\uFF0C\\n\u6240\u4EE5\u6211\u6B63\u5728\u6821\u5712\u88E1\u6563\u6B65\u3002",
  "\u4E4B\u524D\u59AE\u83AB\u5979\u5728\u64CD\u5834\u9023\u8D0F\u4E86\\n\uFF13\uFF10\u5834\u5BF6\u53EF\u5922\u5C0D\u6230\u8036\uFF01\\r\\n\u771F\u4E0D\u6127\u662F\u51A0\u8ECD\u7D1A\uFF01",
  "\u59AE\u83AB\u662F\u5B78\u751F\u6703\u6703\u9577\uFF0C\\n\u4E5F\u662F\u500B\u51A0\u8ECD\uFF0C\u6210\u7E3E\u53C8\u512A\u79C0\uFF01\\r\\n\u5979\u6709\u6C92\u6709\u4E0D\u62FF\u624B\u7684\u4E8B\u554A\uFF1F",
  "\u70BA\u4E86\u4E0D\u8981\u5728\u9053\u9928\u7DCA\u5F35\uFF0C\\n\u6211\u6B63\u770B\u8457\u5C0D\u6230\u5834\u5728\u8166\u6D77\u88E1\u6A21\u64EC\u5C0D\u6230\uFF01",
  "\u70BA\u4E86\u8B93\u7260\u5F9E\u9BC9\u9B5A\u738B\u9032\u5316\u6210\u66B4\u9BC9\u9F8D\uFF0C\\n\u771F\u662F\u8CBB\u4E86\u6211\u4E00\u756A\u529F\u592B\u5462\u3002",
  "\u803F\u9B3C\u9023\u7761\u8457\u6642\u90FD\u5E36\u8457\u7B11\u5BB9\uFF0C\\n\u5BE6\u5728\u662F\u592A\u592A\u592A\uFF5E\u4EE4\u4EBA\u559C\u611B\u4E86\u3002",
  "\u5076\u723E\u6703\u6709\u9AEE\u578B\u5947\u602A\u7684\u5B78\u751F\\n\u5F9E\u6821\u9577\u5BA4\u8D70\u51FA\u4F86\u5594\u3002"
]
