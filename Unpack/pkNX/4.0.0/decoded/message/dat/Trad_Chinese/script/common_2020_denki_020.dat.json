[
  "\u5947\u6A39\u5947\u8FF0\u76F4\u64AD\u7684\u5404\u4F4D\u770B\u5B98\uFF01\\n\u65E9\u5348\u665A\u5B89\u54C8\u56C9Ciao\uFF01\u662F\u6211\u5947\u6A39\u5594\uFF01[VAR 0114(0019)]",
  "\u4ECA\u5929\u7684\u4F86\u8CD3\u662F\u71B1\u9A30\u9A30\u525B\u51FA\u7210\u7684\u65B0\u51A0\u8ECD\uFF0C\\n[VAR 0100(0000)]\uFF5E\uFF01[VAR 0114(0019)]",
  "\u6211\u8AAA[VAR 0100(0000)]\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u9928\u4E3B\u5708\u88E1\\n\u4E5F\u662F\u500B\u7206\u7D05\u7684\u8A71\u984C\u7126\u9EDE\u5594\uFF5E\uFF1F[VAR 0114(0019)]",
  "\u73FE\u5728\u4E00\u60F3\uFF0C\u770B\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u9053\u9928\u6E2C\u9A57\u7684\u8868\u73FE\u6642\uFF0C\\n\u6211\u5C31\u5DF2\u7D93\u611F\u5230\u8D85\u7D1A\u9165\u9EBB\u9165\u9EBB\u7684\u4E86\uFF5E[VAR 0114(0019)]",
  "\u9019\u6B21\u7684\u76F4\u64AD\u5230\u5E95\u6703\u7206\u7D05\u5230\u4EC0\u9EBC\u7A0B\u5EA6\u5462\uFF1F\\n\u6211\u5DF2\u7D93\u958B\u59CB\u671F\u5F85\u770B\u5230\u6578\u5B57\u56C9\uFF5E\uFF01[VAR 0114(0019)]",
  "\u90A3\u5947\u597D\uFF5E\u76F4\u64AD\u7684\u93E1\u982D\\n\u5C31\u62C9\u5230\u5DEE\u4E0D\u591A\u9019\u9EBC\u9060\u2026\u2026[VAR 0114(0019)]",
  "\u5404\u4F4D\u770B\u5B98\uFF0C\u8B93\u5927\u5BB6\u4E45\u7B49\u4E86\uFF01\\n\u5DEE\u4E0D\u591A\u8981\u958B\u59CB\u5C0D\u6230\u56C9\uFF01[VAR 0114(0019)]",
  "\u9053\u9928\u9928\u4E3B\u5947\u6A39\u6211\uFF01\\n\u8981\u62FF\u51FA\u96E3\u5F97\u4E00\u898B\u7684\u771F\u672C\u4E8B\u4E86\uFF01[VAR 0114(0019)]",
  "\u5509\u5440\u5440\uFF0C\u96D6\u7136\u6253\u8F38\u4E86\u5C0D\u6230\\n\u662F\u6703\u8B93\u6211\u89BA\u5F97\u4E0D\u7518\u5FC3\u5566\uFF0C\u4F46\u662F\u2026\u2026\uFF1F[VAR 0114(0019)]",
  "\u9019\u6B21\u7684\u5947\u6A39\u5947\u8FF0\u76F4\u64AD\\n\u89C0\u773E\u6578\u4E00\u8DEF\u98C6\u5347\uFF01\\r\\n\u554A\u554A\uFF5E\u592A\u5E78\u798F\u4E86\uFF01\u6211\u90FD\u8981\u5347\u5929\u5566\uFF5E\uFF01\uFF01[VAR 0114(0019)]",
  "\u679C\u7136\u7576\u7D05\u4EBA\u7269\u7684\\n\u5438\u775B\u5EA6\u5C31\u662F\u4E0D\u4E00\u6A23\uFF5E\uFF01\uFF01[VAR 0114(0019)]",
  "\u4EE5\u5F8C\u4E5F\u8981\u548C\u6211\u5B9A\u671F\u5408\u4F5C\u5594\uFF01\u9084\u6709\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u5225\u53BB\u4E0A\u5176\u4ED6\u76F4\u64AD\u4E3B\u7684\u7BC0\u76EE\u5594\uFF01[VAR 0114(0019)]",
  "\u90A3\u5947\u597D\uFF5E\u4EE3\u6211\u5411\u9996\u5E2D\u554F\u597D\uFF01\\n\u5831\u544A\u6642\u8981\u5E6B\u6211\u5305\u88DD\u4E00\u4E0B\u5594\uFF5E\uFF01[VAR 0114(0019)]",
  "\u5438\u775B\u96FB\u7DB2\u6355\u6349\u4F60\u7684\u773C\u775B\uFF01\\n\u4EE5\u4E0A\u662F\u8AB0\u5728\u5947\u8FF0\uFF1F\u662F\u6211\u5947\u6A39\u70BA\u60A8\u64AD\u653E\uFF5E\uFF01[VAR 0114(0019)]"
]
