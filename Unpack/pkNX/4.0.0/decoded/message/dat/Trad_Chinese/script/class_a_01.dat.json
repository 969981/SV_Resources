[
  "\u5927\u5BB6\u597D\u554A\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u662F\u8CA0\u8CAC\u6559\u751F\u7269\u7684\u5409\u5C3C\u4E9E\u3002[VAR 0114(002A)]",
  "\u5728\u6211\u7684\u8AB2\u5802\u4E0A\uFF0C\\n\u5927\u5BB6\u53EF\u4EE5\u4E00\u8D77\u5B78\u7FD2\u95DC\u65BC\\r\\n\u6211\u6700\u559C\u6B61\u7684\u5BF6\u53EF\u5922\u7684\u4E8B\u5594\u3002[VAR 0114(002A)]",
  "\u8981\u662F\u5927\u5BB6\u80FD\u5920\u900F\u904E\u6211\u7684\u8AB2\\n\u66F4\u559C\u6B61\u5BF6\u53EF\u5922\uFF0C\u6211\u6703\u5F88\u9AD8\u8208\u7684\uFF5E[VAR 0114(002A)]",
  "\u4ECA\u5929\uFF0C\u6211\u5C31\u4F86\u6559\u5927\u5BB6\u53EF\u4EE5\\n\u66F4\u6DF1\u5165\u4E86\u89E3\u5BF6\u53EF\u5922\u7684\u65B9\u6CD5\u5427\uFF5E[VAR 0114(002A)]",
  "\u5982\u679C\u5927\u5BB6\u60F3\u548C\u81EA\u5DF1\u7684\u5BF6\u53EF\u5922\\n\u8B8A\u5F97\u66F4\u76F8\u89AA\u76F8\u611B\u2026\u2026[VAR 0114(002A)]",
  "\u5C31\u628A\u7260\u5F9E\u7403\u88E1\u653E\u51FA\u4F86\\n\u4E00\u8D77\u8D70\u8D70\u5427\uFF5E[VAR 0114(002A)]",
  "\u53E3\u8A23\u662F\u300C[VAR FF00(0006)]\uFF3A\uFF32\u9375[VAR FF00(0000)]\u6295\u7403\uFF01\u300D\\c\\n\u5BF6\u53EF\u5922\u6703\u5F9E\u5F8C\u9762\u8DDF\u4E0A\u4F86\uFF0C\\n\u5F88\uFF5E\u53EF\u611B\u7684\u5594\u3002[VAR 0114(002A)]",
  "\u5411\u8DDF\u4F86\u7684\u5BF6\u53EF\u5922\u642D\u8A71\uFF0C\\n\u7260\u5C31\u6703\u6709\u6240\u56DE\u61C9\u5594\u3002\u8ACB\u8A66\u8A66\u770B\uFF5E\\r\\n\u8AAA\u4E0D\u5B9A\u53EF\u4EE5\u66F4\u4E86\u89E3\u5BF6\u53EF\u5922\u7684\u4E8B\u5462\u3002[VAR 0114(002A)]",
  "\u2026\u2026\u4E0D\u904E\uFF01\u6709\u4E9B\u5730\u65B9\u662F\\n\u4E0D\u80FD\u5E36\u8457\u5BF6\u53EF\u5922\u4E00\u8D77\u8D70\u7684\u3002\\r\\n\u6709\u8AB0\u77E5\u9053\u90A3\u662F\u54EA\u88E1\u55CE\uFF1F[VAR 0114(002A)]",
  "\u6C34\u908A",
  "\u5BA4\u5167",
  "\u8349\u53E2\u88E1",
  "\u96D6\u7136\u6709\u4E9B\u5BF6\u53EF\u5922\u4E0D\u559C\u6B61\u6C34\uFF0C\\n\u4F46\u4E5F\u6709\u5BF6\u53EF\u5922\u5C08\u7528\u7684\u5C0F\u8247\uFF0C\\r\\n\u6240\u4EE5\u4E0D\u7528\u64D4\u5FC3\uFF0C\u5118\u7BA1\u5E36\u7260\u5011\u5728\u6C34\u908A\u8D70\u5427\uFF5E[VAR 0114(002A)]",
  "\u54C7\uFF5E\u6B63\u78BA\u7B54\u6848\uFF01\\n[VAR 0100(0000)]\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u9810\u7FD2\u5F97\u5F88\u597D\u5594\u3002[VAR 0114(002A)]",
  "\u5BF6\u53EF\u5922\u6700\u611B\u8349\u53E2\u4E86\uFF01\\n\u8349\u53E2\u53CD\u800C\u662F\u8D70\u9032\u53BB\u5B8C\u5168\u6C92\u554F\u984C\u5594\u3002[VAR 0114(002A)]",
  "\u4E0D\u80FD\u5E36\u8457\u5BF6\u53EF\u5922\u8D70\u7684\u5730\u65B9\uFF0C\\n\u539F\u4F86\u662F\u5BA4\u5167\uFF5E[VAR 0114(002A)]",
  "\u6709\u4E9B\u5BF6\u53EF\u5922\u5728\u5BA4\u5167\u8D70\u4F86\u8D70\u53BB\u6642\\n\u5F88\u53EF\u80FD\u6703\u5F04\u58DE\u7246\u58C1\u6216\u684C\u5B50\u7B49\uFF0C\\r\\n\u6240\u4EE5\u4E0D\u8AD6\u4EC0\u9EBC\u5BF6\u53EF\u5922\uFF0C\u90FD\u7981\u6B62\u5728\u5BA4\u5167\u5E36\u8457\u8D70\u3002[VAR 0114(002A)]",
  "\u56E0\u6B64\uFF0C\u5927\u5BB6\u8981\u653E\u5BF6\u53EF\u5922\u51FA\u4F86\u6642\uFF0C\\n\u539F\u5247\u4E0A\u8ACB\u5728\u6236\u5916\uFF5E\\r\\n\u96D6\u7136\u5076\u723E\u6703\u5728\u6559\u5BA4\u88E1\u898B\u5230\u7260\u5011\u5C31\u662F\u4E86\u2026\u2026[VAR 0114(002A)]",
  "\u5192\u96AA\u6642\u548C\u5BF6\u53EF\u5922\u4E00\u8D77\u8D70\uFF0C\\n\u5C31\u80FD\u548C\u7260\u8B8A\u5F97\u66F4\uFF5E\u89AA\u5BC6\u3002[VAR 0114(002A)]",
  "\u554A\uFF01\u80FD\u5920\u5E36\u8457\u4E00\u8D77\u8D70\u7684\u662F\\n\u6392\u5728\u968A\u4F0D\u6700\u524D\u9762\u7684\u5BF6\u53EF\u5922\u5594\uFF5E[VAR 0114(002A)]",
  "\u53E3\u8A23\u662F\u300C[VAR FF00(0006)]\uFF3A\uFF32\u9375[VAR FF00(0000)]\u6295\u7403\uFF01\u300D\u3002\\n\u5C0D\u8457\u91CE\u751F\u7684\u5BF6\u53EF\u5922\u6295\u51FA\u53BB\u6642\uFF0C\\r\\n\u6703\u76F4\u63A5\u9032\u5165\u6230\u9B25\u5594\u3002[VAR 0114(002A)]",
  "\u90A3\u9EBC\uFF0C\u4ECA\u5929\u5C31\u5230\u6B64\u70BA\u6B62\u3002\\n\u4E0B\u8AB2\u56C9\uFF5E[VAR 0114(002A)]"
]
