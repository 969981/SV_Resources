[
  "\u9019\u88E1\u662F\u5929\u661F\u968A\u4E2D\\n\u908A\u7DE3\u4EFD\u5B50\u7684\u5BB6\u3002",
  "\u661F\u5875\uFF1F\u5BA3\u6230\uFF1F\\n\u2026\u2026\u6211\u5011\u4EC0\u9EBC\u90FD\u4E0D\u77E5\u9053\u554A\u3002\\r\\n\u6211\u5011\u4E0D\u548C\u7E3D\u90E8\u7684\u4EBA\u806F\u7D61\u7684\u3002",
  "\u96D6\u7136\u6211\u6C92\u8FA6\u6CD5\u62DB\u5F85[VAR 1100(00FF,0101)]\u4F60\u59B3\u4EC0\u9EBC\u2026\u2026\\n\u9019\u500B\u5C31\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\u3002",
  "[VAR 0100(0000)]\\n\u7372\u5F97\u4E86[VAR FF00(0008)]\u904B\u52D5\u5E3D\uFF08\u661F\u661F\uFF09[VAR FF00(0000)]\uFF01",
  "\u4E0D\u8AD6[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u60F3\u4E00\u76F4\u5F85\u5728\u9019\u88E1\uFF0C\\n\u9084\u662F\u60F3\u56DE\u53BB\u90FD\u96A8\u4FBF[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002",
  "\u9019\u88E1\u662F\u5929\u661F\u968A\u4E2D\\n\u908A\u7DE3\u4EFD\u5B50\u7684\u5BB6\u3002",
  "\u6211\u5011\u53EA\u662F\u53AD\u5026\u4E86\u5929\u661F\u968A\u7684\u6D3B\u52D5\uFF0C\\n\u5E73\u6642\u4E5F\u6084\u6084\u5730\u6709\u53BB\u4E0A\u5B78\u5594\u3002",
  "\u4ECA\u5929\u4E5F\u8981\u5145\u6EFF\u6D3B\u529B\u5730\u8AAA\uFF0C\\n\u4ECA\u5929\u661F\u82E6\u4E86\uFF5E\uFF01",
  "\u9019\u88E1\u8AB0\u4E5F\u4E0D\u6703\u8D77\u722D\u57F7\uFF0C\\n\u6240\u4EE5\u5F85\u8D77\u4F86\u5F88\u8212\u670D\uFF5E\\r\\n\u6BD4\u8D77\u5B78\u6821\u3001\u5929\u661F\u968A\u6216\u5BB6\u88E1\uFF0C\u9019\u88E1\u6700\u81EA\u5728\u3002"
