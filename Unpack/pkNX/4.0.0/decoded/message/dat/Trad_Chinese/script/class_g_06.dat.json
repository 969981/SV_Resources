  "\u6B77\u7D93\u591A\u5834\u6230\u9B25\uFF01\uFF01\\n\u63A5\u62DB\uFF01\u53D7\u50B7\uFF01\uFF01[VAR 0114(0029)]",
  "\u6B77\u7D93\u98A8\u5439\u96E8\u6253\uFF01\uFF01\\n\u6CBE\u4E0A\u6CE5\uFF01\u6CBE\u4E0A\u6C99\uFF01\uFF01[VAR 0114(0029)]",
  "\u7260\u5C31\u9019\u6A23\u8B8A\u5F97\u6E3E\u8EAB\u9AD2\u9AD2\u7684\u4E86\uFF01\uFF01[VAR 0114(0029)]",
  "\u6211\u898B\u5230\u8A31\u591A\u8A13\u7DF4\u5BB6\u6BEB\u4E0D\u5728\u4E4E\\n\u5FC3\u611B\u53EF\u611B\u7684\u5BF6\u53EF\u5922\u9AD2\u516E\u516E\u7684\uFF0C\\r\\n\u5C31\u9019\u6A23\u5E36\u8457\u7260\u56DB\u8655\u8D70\u3002\\r\\n\u2026\u2026\u5BE6\u5728\u53EF\u60B2\u554A\u3002[VAR 0114(0029)]",
  "\u90A3\u9EBC\uFF0C\u8A66\u554F\u7121\u6CD5\u539F\u8AD2\u9019\u7A2E\u53EF\u6065\u884C\u70BA\u7684\\n[VAR 0100(0000)]\u540C\u5B78\u3002[VAR 0114(0029)]",
  "\u5BF6\u53EF\u5922\u8B8A\u9AD2\u6642\uFF0C\\n\u8A72\u600E\u9EBC\u8FA6\u5462\uFF1F[VAR 0114(0029)]",
  "\u5E6B\u7260\u6D17\u6FA1",
  "\u6478\u6478\u7260\u7684\u982D",
  "\u653E\u7F6E\u4E0D\u7BA1",
  "\u7B54\u5F97\u597D\uFF01\u6211\u78BA\u4FE1\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8A71\uFF0C\\n\u4E00\u5B9A\u6703\u5982\u6B64\u56DE\u7B54\u3002[VAR 0114(0029)]",
  "\u55EF\u55EF\uFF01\u8981\u662F\u6478\u6478\u7260\u7684\u982D\uFF0C\u5C0D\u7260\u8AAA\u8072\u4F60\u597D\u68D2\uFF0C\\n\u7684\u78BA\u662F\u80FD\u5F7C\u6B64\u90FD\u7709\u958B\u773C\u7B11\u3002\u4F46\u662F\uFF01\\r\\n\u9AD2\u6C61\u4E26\u4E0D\u6703\u56E0\u6B64\u800C\u6D88\u5931\uFF01[VAR 0114(0029)]",
  "\u96D6\u8AAA\u96E8\u6C34\u548C\u6CE5\u5DF4\u7684\u6C61\u57A2\\n\u7684\u78BA\u662F\u6703\u96A8\u8457\u6642\u9593\u800C\u9000\u53BB\u2026\u2026\\r\\n\u4F46\u60F3\u4E0D\u5230\u9019\u500B\u7B54\u6848\u6703\u51FA\u81EA[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u53E3\u3002[VAR 0114(0029)]",
  "\u9AD2\u4E86\u5C31\u6D17\uFF01\\n\u9019\u662F\u4E16\u754C\u7684\u5E38\u8B58\u554A\u3002[VAR 0114(0029)]",
  "\u5728\u91CE\u9910\u6642\uFF0C\\n\u53EA\u8981\u9760\u8FD1\u540C\u884C\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u5C31\u80FD\u5920\u9032\u884C\u5404\u7A2E\u52D5\u4F5C\u3002[VAR 0114(0029)]",
  "\u5176\u4E2D\u4E4B\u4E00\u5C31\u662F\\n\u5BF6\u53EF\u5922\u6D17\u6FA1\u6FA1\uFF01\\r\\n\u2026\u2026\u4E5F\u5C31\u662F\u5E6B\u7260\u6D17\u6FA1\uFF01[VAR 0114(0029)]",
  "\u9996\u5148\u4E00\u908A\u5E6B\u6D77\u7DBF\u63C9\u51FA\u6CE1\u6CE1\uFF0C\\n\u4E00\u908A\u7528\u6D77\u7DBF\u8F15\u8F15\u5730\u3001\u4ED4\u7D30\u5730\\r\\n\u6413\u6D17\u5BF6\u53EF\u5922\u7684\u8EAB\u9AD4\u3002[VAR 0114(0029)]",
  "\u7576\u5BF6\u53EF\u5922\u6E3E\u8EAB\u90FD\u662F\u6CE1\u6CE1\u5F8C\u2026\u2026[VAR 0114(0029)]",
  "\u5C31\u9032\u5165\u6700\u7D42\u968E\u6BB5\u5E6B\u7260\u6C96\u6FA1\uFF0C\\n\u5C07\u5305\u8986\u8457\u9AD2\u6C61\u7684\u6CE1\u6CE1\u6C96\u5F97\u4E7E\u6DE8\u6E9C\u6E9C\uFF01[VAR 0114(0029)]",
  "\u9019\u9EBC\u4E00\u4F86\uFF0C\u5BF6\u53EF\u5922\u5C31\u6703\u518D\u6B21\u7DBB\u653E\\n\u50CF\u592A\u6676\u90A3\u6A23\u8000\u773C\u7684\u5149\u5F69\u4E86\u3002[VAR 0114(0029)]",
