  "\u7136\u800C\uFF0C\u6709\u4E9B\u5BF6\u53EF\u5922\u6703\u6709\\n\u4E0D\u559C\u6B61\u88AB\u6413\u6D17\u7684\u90E8\u4F4D\uFF0C\\r\\n\u6216\u662F\u4E0D\u559C\u6B61\u88AB\u6C34\u5F04\u6FD5\u7684\u5730\u65B9\uFF0C\\r\\n\u8981\u7279\u5225\u7559\u610F\u4E00\u4E0B\u3002[VAR 0114(0029)]",
  "\u6B64\u5916\uFF0C\u6700\u91CD\u8981\u7684\u662F\\n\u4E5F\u6709\u559C\u6B61\u9AD2\u516E\u516E\u7684\u5BF6\u53EF\u5922\u3002[VAR 0114(0029)]",
  "\u96D6\u7136\u9019\u9EBC\u8AAA\u6709\u9EDE\u77DB\u76FE\uFF0C\\n\u4F46\u4E26\u975E\u53EA\u6709\u5E6B\u5BF6\u53EF\u5922\u6D17\u6FA1\u624D\u662F\u9AD4\u8CBC\u7260\u3002\\r\\n\u9084\u8ACB\u8AF8\u4F4D\u540C\u5B78\u9298\u8A18\u5728\u5FC3\u3002[VAR 0114(0029)]",
  "\u672C\u5802\u8AB2\u5230\u6B64\u7D50\u675F\u3002\\n\u6055\u6211\u5931\u966A\u4E86\u3002[VAR 0114(0029)]"
