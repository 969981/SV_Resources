  "\u771F\u4E0D\u7518\u5FC3\u2026\u2026\uFF01\\n\u6211\u53C8\u5FB9\u5E95\u88AB\u6253\u6557\u4E86\u2026\u2026\uFF01[VAR 0114(0024)]",
