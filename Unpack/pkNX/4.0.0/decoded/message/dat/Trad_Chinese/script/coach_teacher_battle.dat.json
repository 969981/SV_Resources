  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u9078[VAR 0101(0001)]\u554A\uFF01\\n\u7260\u5F88\u6709\u563F\u5440\u7684\u5473\u9053\uFF0C\u771F\u68D2\uFF01\\c\\n\u6211\u6703\u6BCF\u5929\u548C\u7260\u4E00\u8D77\u935B\u934A\uFF0C\\n\u8B93\u7260\u5F37\u5230\u7834\u8868\uFF01[VAR 0114(0024)]",
  "\u90A3\u9EBC\u8F49\u5B78\u751F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684[VAR 0101(0001)]\\n\u5C31\u548C\u6211\u7684\u746A\u6C99\u90A3\u4EA4\u63DB\u56C9\uFF01[VAR 0114(0024)]",
  "\u521D\u8A13\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
  "\u7A00\u6709\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
