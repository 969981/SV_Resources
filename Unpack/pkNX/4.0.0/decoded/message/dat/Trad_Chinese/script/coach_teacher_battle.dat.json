  "\u563F\u5440\uFF01\u8F49\u5B78\u751F\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u7B97\u8981\u548C\u6211\u4EA4\u63DB\u5BF6\u53EF\u5922\u4E86\u55CE\uFF01\uFF1F[VAR 0114(0024)]",
  "\u563F\u5440\uFF01\u8F49\u5B78\u751F\uFF01\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u5728\u9080\u6211\u5BF6\u53EF\u5922\u5C0D\u6230\u55CE\uFF01\uFF1F[VAR 0114(0024)]",
  "\u5514\u5514\uFF01\u4E0D\u662F\u554A\u2026\u2026\\n\u8981\u5C0D\u6230\u7684\u8A71\uFF0C\u6211\u96A8\u6642\u5949\u966A\uFF01[VAR 0114(0024)]",
  "\u6211\u6C92\u6709\u7406\u7531\u62D2\u7D55\uFF01\\n\u6211\u5011\u7528\u8DD1\u7684\u53BB\u5C0D\u6230\u5834\u5427\uFF01[VAR 0114(0024)]",
