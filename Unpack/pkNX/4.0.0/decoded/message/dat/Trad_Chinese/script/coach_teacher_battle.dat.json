  "\u2026\u2026\u6709\u7A2E\u50CF\u662F\\n\u5728\u5C0D[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u6559\u7684\u611F\u89BA\u5462\uFF01[VAR 0114(0024)]",
