  "\u807D\u8AAA\u9019\u500B\u5B78\u5712\u7684\u8AB2\u7A0B\uFF0C\\n\u8D8A\u662F\u8207\u5C0D\u6230\u6709\u95DC\u9023\uFF0C\\r\\n\u6210\u7E3E\u7684\u914D\u5206\u6BD4\u4F8B\u5C31\u8D8A\u9AD8\u5462\uFF01[VAR 0114(0024)]",
  "\u7562\u7ADF\u5982\u679C\u64C5\u9577\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\\n\u90A3\u8981\u7576\u806F\u76DF\u8077\u54E1\u3001\u52A0\u5165\u5DE1\u8B77\u54E1\u90E8\u968A\\r\\n\u6216\u8981\u6210\u70BA\u5C08\u696D\u7684\u8A13\u7DF4\u5BB6\uFF0C\u90FD\u662F\u6709\u5E0C\u671B\u7684\uFF01[VAR 0114(0024)]",
  "\u6EFF\u6EFF\u7684\u5922\u60F3\u5462\uFF01",
