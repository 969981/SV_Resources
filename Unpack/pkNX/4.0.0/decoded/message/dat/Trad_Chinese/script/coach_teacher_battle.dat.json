  "\u5728\u5C0D\u6230\u9032\u884C\u6642\uFF0C\\n\u4E5F\u662F\u80FD\u935B\u934A\u8EAB\u9AD4\u7684\uFF01\\c\\n\u4E0B\u6B21\u5C0D\u6230\u6642\u770B\u770B\u6211\u7684\u52D5\u4F5C\u5427\uFF01\\n\u6211\u5C31\u662F\u9760\u90A3\u500B\u4F86\u63D0\u5347\u5FC3\u80BA\u529F\u80FD\u7684\uFF01[VAR 0114(0024)]",
  "\u8F49\u5B78\u751F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684[VAR 0101(0001)]\\n\u4ECA\u5929\u4E5F\u662F\u6D3B\u529B\u6EFF\u5206\uFF01\\c\\n\u6211\u505A\u7684\u4E09\u660E\u6CBB\u7260\u4E5F\u90FD\\n\u5403\u5F97\u6D25\u6D25\u6709\u5473\u5594\uFF01[VAR 0114(0024)]",
