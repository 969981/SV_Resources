  "\u679C\u7136\u662F\u505A\u904E\u982D\u4E86\u55CE\uFF1F\\n\u770B\u4F86\u53EA\u662F\u6211\u81EA\u5DF1\u60F3\u53BB\u8DD1\u554A\uFF01\\c\\n\u771F\u6C92\u8FA6\u6CD5\u2026\u2026\u90A3\u5C31\u6E1B\u6210\u534A\u5708\u5427\uFF01[VAR 0114(0024)]",
  "\u7576\u7136\u6211\u4E5F\u6703\u8981[VAR 1100(00FF,0101)]\u4F60\u59B3\\n\u4E00\u8D77\u4F86\u9AD4\u9A57\u7684\uFF01[VAR 0114(0024)]",
  "\u9019\u500B\u5B78\u5712\u7684\u5B78\u751F\u5011\uFF0C\\n\u500B\u500B\u90FD\u6EFF\u662F\u5E79\u52C1\u554A\uFF01[VAR 0114(0024)]",
