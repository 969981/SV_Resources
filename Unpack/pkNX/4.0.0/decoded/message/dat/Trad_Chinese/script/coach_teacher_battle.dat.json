  "\u4ECA\u5929\u7684\u5C0D\u6230\u4E5F\u68D2\u6975\u4E86\uFF01\\n\u8F49\u5B78\u751F\uFF01\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01[VAR 0114(0024)]",
