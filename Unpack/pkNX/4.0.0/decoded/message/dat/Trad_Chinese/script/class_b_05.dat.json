[
  "\u5404\u4F4D\u540C\u5B78\u5927\u5BB6\u597D\uFF0C\\n\u671F\u4E2D\u8003\u8F9B\u82E6\u4E86\u3002[VAR 0114(0025)]",
  "\u4E0D\u8AD6\u662F\u6EFF\u5206\u7684\u4EBA\uFF0C\u9084\u662F\u4F4E\u7A7A\u98DB\u904E\u7684\u4EBA\uFF0C\\n\u5927\u5BB6\u90FD\u975E\u5E38\u52AA\u529B\u5462\u3002[VAR 0114(0025)]",
  "\u5168\u73ED\u540C\u5B78\u90FD\u53CA\u683C\u4E86\uFF0C\\n\u8001\u5E2B\u6211\u958B\u5FC3\u6975\u4E86\u3002[VAR 0114(0025)]",
  "\u9019\u8868\u793A\u5404\u4F4D\u540C\u5B78\u90FD\\n\u6F38\u6F38\u559C\u6B61\u4E0A\u6578\u5B57\u4E86\uFF0C\u5C0D\u4E0D\u5C0D\uFF1F[VAR 0114(0025)]",
  "\u5269\u4E0B\u7684\u5E7E\u5802\u8AB2\u4E5F\u8981\u4E00\u8D77\u52A0\u6CB9\uFF0C\\n\u5927\uFF5E\u5E45\u589E\u52A0\u77E5\u8B58\u5594\uFF01[VAR 0114(0025)]",
  "\u8AAA\u5230\u5927\uFF5E\u5E45\uFF01\\n\u2026\u2026\u6C92\u932F\uFF01\\r\\n\u5C31\u6703\u60F3\u5230\u5BF6\u53EF\u5922\u7684\u80FD\u529B\u63D0\u5347\uFF01[VAR 0114(0025)]",
  "\u5728\u6230\u9B25\u4E2D\uFF0C\u5BF6\u53EF\u5922\u7684\u80FD\u529B\\n\u6709\u6642\u6703\u63D0\u9AD8\uFF0C\u6709\u6642\u6703\u964D\u4F4E\u5C0D\u5427\u3002[VAR 0114(0025)]",
  "\u4F8B\u5982\uFF0C\u7576\u5BF6\u53EF\u5922\u4F7F\u7528\\n\u53EB\u505A\u81EA\u6211\u6FC0\u52F5\u7684\u62DB\u5F0F\u6642\uFF0C\\r\\n\u7260\u7684\u653B\u64CA\u8207\u7279\u653B\u5C31\u6703\u63D0\u9AD8\uFF11\u500B\u7B49\u7D1A\u3002[VAR 0114(0025)]",
  "\u653B\u64CA\u6216\u7279\u653B\\n\u6BCF\u63D0\u9AD8\uFF11\u500B\u7B49\u7D1A\uFF0C\\r\\n\u7D66\u4E88\u7684\u50B7\u5BB3\u5C31\u6703\u63D0\u9AD8\uFF15\uFF10\uFF05\u5462\u3002[VAR 0114(0025)]",
  "\u53EA\u8981\u518D\u6B21\u4F7F\u7528\u81EA\u6211\u6FC0\u52F5\uFF0C\\n\u5C31\u7B49\u65BC\u662F\u63D0\u9AD8\u4E86\uFF12\u500B\u7B49\u7D1A\uFF0C\\r\\n\u9019\u6642\u5019\u50B7\u5BB3\u5C31\u6703\u6BD4\u539F\u5148\u63D0\u9AD8\uFF11\uFF10\uFF10\uFF05\uFF0C\\r\\n\u4E5F\u5C31\u662F\u8AAA\u653B\u64CA\uFF11\u6B21\u53EF\u4EE5\u7D66\u4E88\uFF12\u6B21\u4EFD\u7684\u50B7\u5BB3\u3002[VAR 0114(0025)]",
  "\u53EB\u505A\u528D\u821E\u7684\u62DB\u5F0F\\n\u53EF\u4EE5\u8B93\u653B\u64CA\u63D0\u9AD8\uFF12\u500B\u7B49\u7D1A\uFF0C\\r\\n\u6240\u4EE5\u53EA\u8981\u7528\uFF11\u6B21\uFF0C\u5C31\u53EF\u4EE5\u8B93\u50B7\u5BB3\u8B8A\uFF12\u500D\u5594\uFF01[VAR 0114(0025)]",
  "\u90A3\u9EBC\uFF0C\u5982\u679C\u4F7F\u7528\uFF12\u6B21\u528D\u821E\uFF0C\\n\u653B\u64CA\u5C31\u6703\u63D0\u9AD8\uFF14\u500B\u7B49\u7D1A\u3002\\r\\n\u9019\u6642\u5019\u62DB\u5F0F\u7684\u50B7\u5BB3\u6703\u8B8A\u6210\u5E7E\u500D\u5462\uFF1F[VAR 0114(0025)]",
  "\uFF12\u500D",
  "\uFF13\u500D",
  "\uFF14\u500D",
  "\u6211\u77E5\u9053\uFF0C\u9019\u662F\u500B\u5BB9\u6613\u51FA\u932F\u7684\u5730\u65B9\u5462\u3002\\n\u5982\u679C\u662F\u81EA\u6211\u6FC0\u52F5\u7684\u8A71\uFF0C\\r\\n\u50B7\u5BB3\u8B8A\uFF12\u500D\u5C31\u662F\u6B63\u78BA\u7B54\u6848\uFF0C\u4F46\u2026\u2026[VAR 0114(0025)]",
  "\u9019\u662F\u500B\u96E3\u984C\u5462\uFF01\u771F\u53B2\u5BB3\uFF01\\n\u4E0D\u6127\u662F[VAR 0100(0000)]\uFF01[VAR 0114(0025)]",
  "\u6211\u77E5\u9053\uFF0C\u9019\u662F\u500B\u5BB9\u6613\u51FA\u932F\u7684\u5730\u65B9\u5462\u3002\\n\u95DC\u9375\u5728\u65BC\uFF0C\u63D0\u9AD8\uFF14\u500B\u7B49\u7D1A\\r\\n\u4E26\u4E0D\u7B49\u65BC\u50B7\u5BB3\u8B8A\uFF14\u500D\u5594\u3002[VAR 0114(0025)]",
  "\u56E0\u70BA\u6BCF\u63D0\u9AD8\uFF11\u500B\u7B49\u7D1A\uFF0C\\n\u50B7\u5BB3\u5C31\u6703\u589E\u52A0\uFF15\uFF10\uFF05\u2026\u2026[VAR 0114(0025)]",
  "\uFF14\u500B\u7B49\u7D1A\u5C31\u662F\uFF14\u00D7\uFF15\uFF10\uFF05\uFF0C\\n\u56E0\u6B64\u6703\u589E\u52A0\uFF12\uFF10\uFF10\uFF05\u5594\u3002[VAR 0114(0025)]",
  "\u7531\u65BC\u539F\u672C\u5C31\u6703\u7D66\u4E88\uFF11\uFF10\uFF10\uFF05\u7684\u50B7\u5BB3\uFF0C\\n\u518D\u52A0\u4E0A\uFF12\uFF10\uFF10\uFF05\u5C31\u6703\u8B8A\u6210\uFF13\uFF10\uFF10\uFF05\u2026\u2026[VAR 0114(0025)]",
  "\u6240\u4EE5\uFF0C\u4E0B\u6B21\u4F7F\u7528\u7684\u62DB\u5F0F\\n\u5C07\u80FD\u5920\u7D66\u4E88\uFF13\u500D\u7684\u50B7\u5BB3\u3002[VAR 0114(0025)]",
  "\u9664\u4E86\u525B\u624D\u7684\u8A08\u7B97\u7D50\u679C\u4E4B\u5916\uFF0C\u9084\u8981\u52A0\u4E0A\\n\u5C6C\u6027\u76F8\u524B\u3001\u64CA\u4E2D\u8981\u5BB3\u6642\u7684\u4E58\u6CD5\u7D50\u679C\u3002\\r\\n\u6240\u4EE5\u5C0D\u65BC\u4E9B\u5FAE\u7684\u63D0\u5347\uFF0C\u4E5F\u4E0D\u80FD\u6389\u4EE5\u8F15\u5FC3\u5462\u3002[VAR 0114(0025)]",
  "\u9806\u5E36\u4E00\u63D0\uFF0C\\n\u300C\u80FD\u529B\u63D0\u9AD8\u4E86\u300D\u8868\u793A\uFF11\u500B\u7B49\u7D1A\uFF0C\\r\\n\u300C\u5927\u5E45\u63D0\u9AD8\u4E86\u300D\u8868\u793A\uFF12\u500B\u7B49\u7D1A\uFF0C\\r\\n\u300C\u6975\u5927\u5E45\u63D0\u9AD8\u4E86\u300D\u8868\u793A\uFF13\u500B\u7B49\u7D1A\u7684\\r\\n\u80FD\u529B\u63D0\u5347\u5594\u3002[VAR 0114(0025)]",
  "\u900F\u904E\u53EA\u80FD\u5728\u5C0D\u6230\u4E2D\u4F7F\u7528\u7684\\n\u529B\u91CF\u5F37\u5316\u6216\u7279\u653B\u5F37\u5316\uFF0C\\r\\n\u4E5F\u80FD\u5C07\u80FD\u529B\u7B49\u7D1A\u5927\u5E45\u63D0\u9AD8\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C\u662F\u4E0B\u8AB2\u9418\uFF1F\\n\u9019\u9EBC\u5FEB\u5C31\u7D50\u675F\u4E86\u3002\u771F\u662F\u53EF\u60DC\u2026\u2026[VAR 0114(0025)]",
  "\u9019\u6B21\u7684\u5167\u5BB9\u6BD4\u8F03\u96E3\uFF0C\\n\u8A18\u5F97\u8981\u5927\uFF5E\u5E45\u8907\u7FD2\u5594\u3002\\r\\n\u90A3\u9EBC\uFF0C\u6211\u5011\u4E0B\u6B21\u518D\u898B\u3002[VAR 0114(0025)]"
]
