[
  "\u51B0\u6AC3\u93AE\u662F\\n\u767D\u96EA\u8207\u93AE\u9B42\u7684\u57CE\u93AE\uFF01\\r\\n\u6700\u8FD1\u6F14\u5531\u6703\u6703\u5834\u4E5F\u5F88\u6709\u540D\u5594\u3002",
  "\u96EA\u82B1\u98C4\u98C4\uFF01\\n\u71ED\u5149\u6416\u6416\uFF01\\c\\n\u6BCF\u5929\u90FD\u50CF\u904E\u7BC0\u65E5\u4E00\u6A23\u5427\uFF01",
  "\u6ED1\u96EA\u5C71\u5C31\u662F\u73FE\u5728\u6700\u6F6E\u7684\u5A1B\u6A02\uFF01\\n\u5728\u971C\u62B9\u5C71\u53EF\u4EE5\u6311\u6230\u5594\uFF01",
  "\u96EA\u7AE5\u5B50\u5F88\u53EF\u611B\u5427\uFF01\\n\u53EA\u6709\u96CC\u6027\u7684\u96EA\u7AE5\u5B50\\r\\n\u624D\u6709\u53EF\u80FD\u9032\u5316\u6210\u96EA\u5996\u5973\u3002",
  "\u4ECA\u5929\u4E5F\u597D\u51B7\u554A\u2026\u2026\\n\u5403\u4E00\u4E9B\u8FA3\u7684\u6599\u7406\u4F86\u6696\u6696\u8EAB\u9AD4\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u7A76\u6975\u7684\u4E09\u660E\u6CBB\u55CE\uFF1F\\n\u90A3\u500B\u4E09\u660E\u6CBB\u7684\u540D\u7A31\u88E1\u6709\u300C\u5927\u5E2B\u300D\u5169\u500B\u5B57\uFF0C\\r\\n\u81F3\u65BC\u98DF\u8B5C\u5247\u4E00\u5207\u4E0D\u8A73\u2026\u2026",
  "\u5728\u5916\u9762\u5403\u7684\u8A71\uFF0C\\n\u611F\u89BA\u6BD4\u5E73\u5E38\u66F4\u597D\u5403\uFF5E\uFF01",
  "\uFF11\u5E74\u534A\u524D\uFF0C\\n\u9053\u9928\u9928\u4E3B\u7684\u6CF0\u59C6\u5F15\u9000\uFF0C\\r\\n\u7531\u5979\u7684\u59B9\u59B9\u840A\u59C6\u63A5\u68D2\u4E86\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\u904E\u840A\u59C6\u7684\u6F14\u5531\u6703\u55CE\uFF1F\\n\u807D\u4E86\u9748\u9B42\u53EF\u6703\u611F\u52D5\u5230\u986B\u6296\u5594\uFF01",
  "\u9053\u9928\u6E2C\u9A57\u7684\u6642\u5019\u7D2B\u8272\u7684\u821E\u53F0\u6703\u767C\u5149\uFF0C\\n\u5F88\u6F02\u4EAE\u5594\uFF5E\uFF01"
]
