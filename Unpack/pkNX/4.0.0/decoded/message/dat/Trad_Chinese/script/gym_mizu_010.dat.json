[
  "\u5443\u554A\uFF5E\uFF01\\n\u9072\u5230\u5566\uFF0C\u9072\u5230\u5566\uFF5E\uFF01[VAR 0114(002C)]",
  "\u554A\uFF5E\uFF01\u6D77\u5CB1\uFF01\\n\u8ACB\u7B49\u7B49\u554A\uFF5E\uFF01",
  "\u5509\uFF5E\u8D70\u6389\u4E86\u3002\\n\u4F60\u6709\u6771\u897F\u5FD8\u8A18\u5E36\u8D70\u554A\u2026\u2026",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8A72\u4E0D\u6703\u662F\u8981\u4F86\u9053\u9928\u7684\\n\u6311\u6230\u8005\u5427\uFF1F",
  "\u662F\uFF01",
  "\u5443\u2026\u2026",
  "\u679C\u7136\uFF01\u6211\u5C31\u77E5\u9053\uFF01",
  "\u96D6\u7136\u5634\u4E0A\u662F\u9019\u6A23\u8AAA\uFF0C\\n\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E00\u5B9A\u662F\u6311\u6230\u8005\u5566\uFF01",
  "\u525B\u624D\u90A3\u500B\u584A\u982D\u5F88\u5927\u7684\u53D4\u53D4\u662F\\n\u73BB\u74F6\u9053\u9928\u7684\u9928\u4E3B\u6D77\u5CB1\u3002",
  "\u4ED6\u9019\u500B\u4EBA\u554A\uFF0C\u6709\u9EDE\u6DD8\u6C23\uFF0C\\n\u660E\u660E\u662F\u8981\u53BB\u5E02\u5834\u63A1\u8CFC\uFF0C\\r\\n\u537B\u5FD8\u4E86\u5E36\u9322\u5305\u5462\u3002",
  "\u6D77\u5CB1\u4ED6\u73FE\u5728\u4E00\u5B9A\u5728\u50B7\u8166\u7B4B\u2026\u2026\\c\\n\u9019\u4F4D\u597D\u5FC3\u7684\u6311\u6230\u8005\uFF01\\n\u53EF\u4EE5\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u628A\u9322\u5305\u9001\u53BB\u7D66\u4ED6\u55CE\uFF01\uFF1F",
  "\u54CE\u5440\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u500B\u5927\u597D\u4EBA\uFF01\\n\u8B93\u6211\u60F3\u73FE\u5728\u5C31\u628A\u9053\u9928\u5FBD\u7AE0\\r\\n\u7576\u5834\u9001[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\u5462\uFF01",
  "\u5F88\u62B1\u6B49\uFF0C\u4F46\u8981\u662F\u6D77\u5CB1\u4ED6\u4E0D\u5728\\n\u5C31\u7121\u6CD5\u9032\u884C\u9053\u9928\u6311\u6230\u4E86\uFF0C\\r\\n\u800C\u4E14\u6211\u53C8\u4E0D\u80FD\u96E2\u958B\u6AC3\u53F0\uFF0C\u6240\u4EE5\u2026\u2026",
  "\u4F86\uFF0C\u9019\u5C31\u4EA4\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF01",
  "\u9019\u662F\u7279\u4F8B\uFF0C\u4F46\u53EA\u8981[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C07\u5B83\u4EA4\u7D66\u6D77\u5CB1\uFF0C\\n\u6211\u5C31\u6703\u7576\u4F5C[VAR 1100(00FF,0101)]\u4F60\u59B3\u901A\u904E\u4E86\u9053\u9928\u6E2C\u9A57\uFF01",
  "\u6D77\u5CB1\u4ED6\u5F80[VAR FF00(0006)]\u6F2C\u6C81\u93AE[VAR FF00(0000)]\u53BB\u4E86\uFF0C\\n\u90A3\u88E1\u5F97\u7A7F\u904E\u897F\u908A\u7684\u6C99\u6F20\u624D\u80FD\u5230\u9054\uFF01",
  "\u6C99\u6F20\u6709\u8A31\u591A\u5371\u96AA\u7684\u5BF6\u53EF\u5922\u3002\\n\u4E00\u8DEF\u7576\u5FC3\u5594\uFF5E\uFF01"
]
