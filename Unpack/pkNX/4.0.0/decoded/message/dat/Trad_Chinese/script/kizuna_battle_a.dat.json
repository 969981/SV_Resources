  "\u602A\u4E0D\u5F97\u6211\u53EF\u4EE5\\n\u5F9E[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u773C\u88E1\u611F\u53D7\u5230\u9B25\u5FD7\uFF01[VAR 0114(0024)]",
