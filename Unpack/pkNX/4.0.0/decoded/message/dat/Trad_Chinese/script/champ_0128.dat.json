[
  "\u93D8\u93D8\u93D8\u78C5\uFF5E\uFF5E\uFF01\uFF01\\n\u6211\u5011\u5728\u9019\u88E1\u5C0D\u6230\u5427\uFF5E\uFF01[VAR 0114(0004)]",
