  "\u5979\u770B\u8D77\u4F86\u61C9\u8A72\u662F\u9019\u88E1\u7684\u5B78\u751F\uFF0C\\n\u4F46\u4F3C\u4E4E\u4E0D\u662F\u8981\u554F\u8DDF\u8AB2\u7A0B\u6709\u95DC\u7684\u554F\u984C\u2026\u2026\uFF1F[VAR 0114(0025)]",
  "\u4E0B\u6B21\u6211\u770B\u5230\u5979\u7684\u8A71\uFF0C\\n\u5C31\u7531\u6211\u5411\u5979\u642D\u8A71\uFF01[VAR 0114(0025)]",
  "\u4E00\u500B\u4EBA\u7684\u8A71\u5BE6\u5728\u6709\u4E9B\u5BB3\u6015\uFF0C\\n\u8B1D\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u966A\u8457\u8001\u5E2B\u3002[VAR 0114(0025)]",
