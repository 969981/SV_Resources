  "[VAR 0100(0000)]\uFF01\uFF1F\\n\u547C\uFF0C\u6211\u5687\u4E86\u4E00\u8DF3\u3002[VAR 0114(0025)]",
  "\u8001\u5E2B\u5728\u5403\u98EF\u55CE\uFF1F",
  "\u8001\u5E2B\u5728\u505A\u6599\u7406\u55CE\uFF1F",
  "\u4E0D\u662F\uFF0C\u4E0D\u662F\u3002\\n\u4E0D\u662F\u90A3\u6A23\u7684\uFF5E\uFF01[VAR 0114(0025)]",
  "\u525B\u525B\u6211\u8D70\u5728\u5165\u53E3\u8655\u7684\u6642\u5019\u2026\u2026[VAR 0114(0025)]",
  "\u6211\u611F\u53D7\u5230\u4E86\u6211\u4E4B\u524D\u63D0\u904E\u7684\\n\u90A3\u9053\u706B\u71B1\u7684\u8996\u7DDA\uFF01[VAR 0114(0025)]",
  "\u6240\u4EE5\u6211\u7ACB\u523B\u8DD1\u5230\u4E86\\n\u5C31\u5728\u9644\u8FD1\u7684\u98DF\u5802\u4F86\u3002[VAR 0114(0025)]",
  "\u9019\u88E1\u7684\u8A71\uFF0C\u51FA\u5165\u53E3\u53EA\u6709\u4E00\u500B\uFF0C\\n\u6211\u60F3\u5982\u679C\u8996\u7DDA\u7684\u4E3B\u4EBA\u8FFD\u4E86\u4E0A\u4F86\uFF0C\\r\\n\u5C31\u80FD\u77E5\u9053\u7A76\u7ADF\u662F\u8AB0\u4E86\uFF01[VAR 0114(0025)]",
  "\u554A\uFF01\u6709\u4EBA\u4F86\u4E86\uFF01[VAR 0114(0025)]",
