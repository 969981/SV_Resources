[
  "\u8AF8\u4F4D\u540C\u5B78\uFF0C\u5C07\u624B\u6A5F\u6536\u8D77\u4F86\u5427\u3002\\n\u6211\u5011\u8981\u958B\u59CB\u4E0A\u8AB2\u4E86\u3002[VAR 0114(0029)]",
  "\u4E0A\u4E00\u5802\u8AB2\u6211\u8B1B\u89E3\u4E86\\n\u5982\u4F55\u56DE\u5FA9\uFF28\uFF30\uFF0C\u4E0D\u904E\u2026\u2026[VAR 0114(0029)]",
  "\u5728\u4E0B\u8AB2\u5F8C\u6709\u90E8\u5206\u540C\u5B78\\n\u554F\u4E86\u6211\u95DC\u65BC[VAR FF00(0006)]\uFF30\uFF30[VAR FF00(0000)]\u7684\u554F\u984C\u3002[VAR 0114(0029)]",
  "\u5931\u53BB\u6240\u6709\u7684\uFF28\uFF30\u5C31\u6703\u9677\u5165\u7015\u6B7B\uFF01\\n\u9019\u6642\u7684\u5BF6\u53EF\u5922\u5C07\u7121\u6CD5\u6230\u9B25\u3002[VAR 0114(0029)]",
  "\u90A3\u9EBC\uFF0C\u7576\u8017\u76E1\u6240\u6709\u7684\uFF30\uFF30\u6642\uFF0C\\n\u5BF6\u53EF\u5922\u6703\u600E\u9EBC\u6A23\u5462\uFF1F[VAR 0114(0029)]",
  "\u7121\u6CD5\u4F7F\u51FA\u62DB\u5F0F",
  "\u8B8A\u5F97\u4E0D\u807D\u8A71",
  "\u6240\u6709\u7684\u80FD\u529B\u90FD\u6703\u964D\u4F4E",
  "[VAR 0100(0000)]\u540C\u5B78\uFF0C\u7B54\u5F97\u597D\u3002\\n\u662F\u56E0\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u89AA\u8EAB\u9AD4\u9A57\u904E\u4E86\u55CE\uFF1F[VAR 0114(0029)]",
  "\u90A3\u7684\u78BA\u662F\u500B\u5371\u96AA\u7684\u72C0\u614B\uFF0C\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u7B54\u932F\u4E86\u3002\\c\\n\u2026\u2026\u5BF6\u53EF\u5922\u662F\u5426\u807D\u8A71\uFF0C\\n\u53D6\u6C7A\u65BC\u9053\u9928\u5FBD\u7AE0\u7684\u6578\u91CF\u3002[VAR 0114(0029)]",
  "\u90A3\u7684\u78BA\u662F\u500B\u5371\u96AA\u7684\u72C0\u614B\uFF0C\u4F46[VAR 1100(00FF,0101)]\u4F60\u59B3\u7B54\u932F\u4E86\u3002\\c\\n\uFF30\uFF30\u9019\u6771\u897F\\n\u8207\u90A3\u4E9B\u80FD\u529B\u662F\u6C92\u6709\u95DC\u4FC2\u7684\u3002[VAR 0114(0029)]",
  "\u8017\u76E1\uFF30\uFF30\u5F8C\uFF0C\\n\u5BF6\u53EF\u5922\u5C31\u7121\u6CD5\u4F7F\u51FA\u62DB\u5F0F\u3002[VAR 0114(0029)]",
  "\u6BCF\u500B\u62DB\u5F0F\u90FD\u6709\u5404\u81EA\u7684\uFF30\uFF30\uFF0C\\n\u56E0\u6B64\u907F\u514D\u7E3D\u662F\u4F7F\u7528\u540C\u4E00\u500B\u62DB\u5F0F\uFF0C\\r\\n\u5206\u6563\u6D88\u8017\u7684\uFF30\uFF30\uFF0C\u5C31\u4E0D\u6703\u90A3\u9EBC\u5FEB\u8017\u76E1\u3002[VAR 0114(0029)]",
  "\u7576\u6240\u6709\u62DB\u5F0F\u7684\uFF30\uFF30\u90FD\u8017\u76E1\u5F8C\uFF0C\\n\u5C31\u53EA\u80FD\u4F7F\u51FA\u53EB\u505A\u6399\u624E\u7684\u884C\u52D5\u3002\\r\\n\u6399\u624E\u6703\u8B93\u81EA\u5DF1\u4E5F\u53D7\u5230\u50B7\u5BB3\u3002[VAR 0114(0029)]",
  "\u70BA\u4E86\u907F\u514D\u9677\u5165\u90A3\u6A23\u7684\u72C0\u6CC1\uFF0C\uFF30\uFF30\u4E5F\u8981\\n\u50CF\uFF28\uFF30\u90A3\u6A23\u52E4\u5230\u5BF6\u53EF\u5922\u4E2D\u5FC3\u56DE\u5FA9\u3002[VAR 0114(0029)]",
  "\u6B64\u5916\uFF0C\u4E5F\u6709\u53EF\u4EE5\u56DE\u5FA9\uFF30\uFF30\u7684\u9053\u5177\uFF0C\\n\u4F8B\u5982\uFF30\uFF30\u55AE\u9805\u5C0F\u88DC\u5291\u3001\uFF30\uFF30\u55AE\u9805\u5168\u88DC\u5291\u3002\\r\\n\u7279\u5FB5\u5C31\u662F\u9053\u5177\u7684\u540D\u5B57\u88E1\u6709\uFF30\uFF30\u4E00\u8A5E\u3002[VAR 0114(0029)]",
  "\u4E0D\u904E\u9019\u985E\u9053\u5177\u662F\u5546\u5E97\u88E1\u8CB7\u4E0D\u5230\u7684\u3002\\n\u8981\u662F\u767C\u73FE\u4E86\u5B83\u5011\uFF0C\u8A18\u5F97\u8981\u73CD\u60DC\u8457\u4F7F\u7528\u3002[VAR 0114(0029)]",
  "\u8D8A\u5F37\u7684\u62DB\u5F0F\uFF0C\u6700\u5927\uFF30\uFF30\u5C31\u8D8A\u5C11\u3002\\n\u80E1\u4E82\u4F7F\u7528\u7684\u8A71\uFF0C\u5F88\u5FEB\u5C31\u6703\u67AF\u7AED\u7684\u3002\\r\\n\u56E0\u6B64\u62DB\u5F0F\u7684\u5206\u914D\u6703\u8B8A\u5F97\u683C\u5916\u91CD\u8981\u3002[VAR 0114(0029)]",
  "\u8207\u5BF6\u53EF\u5922\u5192\u96AA\u6642\uFF0C\\n\u8A72\u6CE8\u610F\u7684\u4E0D\u53EA\u662F\uFF28\uFF30\u3002[VAR 0114(0029)]",
  "\u671F\u5F85\u8AF8\u4F4D\u540C\u5B78\u5728\u9032\u884C\u5C0B\u5BF6\u6642\uFF0C\\n\u80FD\u5920\u591A\u591A\u95DC\u5FC3\u81EA\u5DF1\u7684\u540C\u4F34\uFF0C\\r\\n\u8B93\u7260\u5011\u80FD\u5920\u6709\u6700\u4F73\u7684\u8868\u73FE\u3002[VAR 0114(0029)]",
  "\u672C\u5802\u8AB2\u5230\u6B64\u7D50\u675F\u3002\\n\u4E0B\u6B21\u662F\u8003\u8A66\uFF0C\\r\\n\u8AF8\u4F4D\u52D9\u5FC5\u8981\u597D\u597D\u8907\u7FD2\u3002[VAR 0114(0029)]"
]
