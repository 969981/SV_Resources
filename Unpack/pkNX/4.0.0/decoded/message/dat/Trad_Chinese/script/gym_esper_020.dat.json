  "\u55EF\uFF01\u8981\u505A\u597D\u6E96\u5099\u624D\u884C\uFF01\\n\u4E00\u5207\u5C31\u7DD2\u6642\uFF0C\u5C31\u544A\u8A34\u6211\u4E00\u8072\u5427\u3002[VAR 0114(0024)]",
  "\u55EF\uFF01\u52D5\u4F5C\u5F88\u9748\u6D3B\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u500B\u8F49\u5B78\u751F\u548C\u5BF6\u53EF\u5922\u90FD\u5F88\u8000\u773C\u5462\uFF01[VAR 0114(0024)]",
  "\u592A\uFF5E\u68D2\u4E86\uFF01\u68D2\u900F\u9802\u4E86\uFF01\\n\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u90A3\u5B8C\u7F8E\u7684\u8868\u9054\u80FD\u529B\u9001\u4E0A\u5927\u5927\u7684\u5FAE\u7B11\uFF01[VAR 0114(0024)]",
  "\u8EAB\u9AD4\u6696\u548C\u8D77\u4F86\u4E86\uFF0C\\n\u63A5\u8457\u5C31\u7528\u5BF6\u53EF\u5922\u5C0D\u6230\uFF0C\u8B93\u808C\u8089\u52D5\u8D77\u4F86\uFF01[VAR 0114(0024)]",
  "\u7528\u6BD4\u5E73\u5E38\u5C0D\u6230\u6642\u9084\u8981\u5927\u7684\u52D5\u4F5C\uFF01\\n\u5851\u9020\u51FA\u7406\u60F3\u7684BODY\u5427\uFF01",
