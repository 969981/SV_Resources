  "\u6B61\u8FCE\u5149\u81E8\u7119\u56FA\u9053\u9928\uFF01\\n\u8981\u518D\u807D\u4E00\u6B21\u9053\u9928\u6E2C\u9A57\u7684\u8AAA\u660E\u55CE\uFF1F",
  "\u7119\u56FA\u9053\u9928\u7684\u9053\u9928\u6E2C\u9A57\u662F\\n[VAR FF00(0006)]\u505A\u9AD4\u64CD[VAR FF00(0000)]\uFF01",
  "\u53EA\u8981\u628A\u9053\u9928\u9928\u4E3B\u8389\u666E\u89AA\u81EA\\n\u767C\u660E\u7684[VAR FF00(0006)]\u559C\u6012\u9A5A\u6A02\u9AD4\u64CD[VAR FF00(0000)]\\r\\n\u5F9E\u982D\u5230\u5C3E\u505A\u5B8C\uFF0C\u5C31\u53CA\u683C\u4E86\uFF01",
  "\u8A73\u7D30\u898F\u5247\u6703\u5728\u9AD4\u64CD\u6703\u5834\\n\u7531\u8EAB\u7A7F\u9ED1\u8272\u904B\u52D5\u670D\u7684\u5973\u6027\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u660E\u3002\\r\\n\u8ACB\u5728\u8D70\u51FA\u9053\u9928\u5F8C\u5F80\u5DE6\u624B\u908A\u53BB\uFF0C\u5C31\u80FD\u5230\u6703\u5834\u4E86\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u554A\uFF0C\u8F49\u5B78\u751F\uFF01\uFF01\\n\u6B61\u8FCE\u4F86\u5230\u559C\u6012\u9A5A\u6A02\u9AD4\u64CD\u6703\u5834\uFF01[VAR 0114(0024)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u4E0D\u662F\u60F3\u77E5\u9053\\n\u70BA\u4EC0\u9EBC\u5C0D\u6230\u8AB2\u7684\u51F0\u6A97\u8001\u5E2B\\r\\n\u6703\u5728\u9053\u9928\u7576\u6559\u7DF4\uFF1F[VAR 0114(0024)]",
  "\u2026\u2026\u9053\u9928\u9928\u4E3B\u8389\u666E\u548C\u6211\\n\u662F\u5F9E\u5C0F\u5C31\u8A8D\u8B58\u7684\u670B\u53CB\u3002[VAR 0114(0024)]",
  "\u6211\u5011\u8AAA\u597D\u6253\u8F38\u7684\u4EBA\u8981\\n\u807D\u8D0F\u7684\u4EBA\u7684\u8A71\uFF0C\\r\\n\u7136\u5F8C\u5BF6\u53EF\u5922\u5C0D\u6230\u7684\u7D50\u679C\uFF0C\u5C31\u662F\u2026\u2026[VAR 0114(0024)]",
  "\u2026\u2026\u54CE\uFF01\u53CD\u6B63\u4E5F\u80FD\u935B\u934A\u8EAB\u9AD4\uFF0C\\n\u6240\u4EE5\u6211\u5C31\u5728\u6C92\u8AB2\u7684\u6642\u5019\u4F86\u5E6B\u5FD9\u56C9\u3002[VAR 0114(0024)]",
  "\u9AD4\u64CD\u7684\u898F\u5247\u5F88\u7C21\u55AE\uFF01\\n\u6211\u6703\u5148\u505A\u793A\u7BC4\uFF0C\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6A21\u4EFF\u6211\u7684\u52D5\u4F5C\u5C31\u662F\u4E86\uFF01[VAR 0114(0024)]",
  "\u90A3\u9EBC\uFF0C\u8981\u958B\u59CB\u9053\u9928\u6E2C\u9A57\u4E86\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8EAB\u5FC3\u90FD\u6E96\u5099\u597D\u4E86\u55CE\uFF01\uFF1F[VAR 0114(0024)]",
