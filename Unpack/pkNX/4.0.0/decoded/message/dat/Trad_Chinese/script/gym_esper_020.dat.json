  "\u96D6\u7136\u6709\u9EDE\u7D2F\u4E86\uFF0C\u4F46\u518D\u52A0\u9EDE\u6CB9\uFF01\\n\u9032\u5165\u9AD4\u64CD\u7684\u5F8C\u534A\u6BB5\u56C9\uFF01[VAR 0114(0024)]",
  "\u63EE\u7051\u7684\u6C57\u6C34\uFF01\u5954\u653E\u7684\u60C5\u611F\uFF01\\n\u771F\u662F\u4E00\u6BB5\u975E\u5E38\u6709\u770B\u982D\u7684\u9AD4\u64CD\uFF01[VAR 0114(0024)]",
