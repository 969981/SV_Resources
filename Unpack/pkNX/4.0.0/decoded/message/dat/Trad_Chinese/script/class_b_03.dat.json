[
  "\u5404\u4F4D\u540C\u5B78\u5927\u5BB6\u597D\uFF0C\\n\u8B93\u6211\u5011\u5FEB\u5FEB\u6A02\u6A02\u5B78\u6578\u5B78\u5427\u3002[VAR 0114(0025)]",
  "\u4E0D\u77E5\u9053\u5927\u5BB6\\n\u559C\u4E0D\u559C\u6B61\u5360\u535C\u5462\uFF1F[VAR 0114(0025)]",
  "\u5982\u679C\u5728\u6668\u9593\u65B0\u805E\u7684\u5360\u535C\u55AE\u5143\\n\u770B\u5230\u7576\u5929\u904B\u52E2\u5F88\u4E0D\u932F\uFF0C\\r\\n\u5FC3\u60C5\u4E5F\u6703\u83AB\u540D\u5730\u8F15\u5FEB\u8D77\u4F86\u5427\uFF1F[VAR 0114(0025)]",
  "\u4ECA\u5929\uFF0C\u6211\u5011\u5C31\u7528\u95DC\u65BC\u904B\u6C23\u7684\u984C\u76EE\uFF0C\\n\u4E00\u8D77\u5B78\u4E9B\u6578\u5B57\u7684\u4E8B\u5427\uFF01[VAR 0114(0025)]",
  "\u5728\u5BF6\u53EF\u5922\u5C0D\u6230\u6642\uFF0C\\n\u5076\u723E\u6703\u767C\u751F\u2026\u2026\u64CA\u4E2D\u4E86\u8981\u5BB3\uFF01\\r\\n\u5927\u5BB6\u61C9\u8A72\u90FD\u6709\u898B\u904E\uFF0C\u5C0D\u4E0D\u5C0D\uFF1F[VAR 0114(0025)]",
  "\u5982\u679C\u62DB\u5F0F\u64CA\u4E2D\u4E86\u8981\u5BB3\uFF0C\\n\u7D66\u4E88\u7684\u50B7\u5BB3\u5C31\u6703\u6BD4\u5E73\u5E38\u9084\u8981\u591A\u4E00\u534A\uFF0C\\r\\n\u4E5F\u5C31\u662F\u6703\u8B8A\u6210\uFF11.\uFF15\u500D\u5462\u3002[VAR 0114(0025)]",
  "\u4EC0\u9EBC\u6642\u5019\u6703\u64CA\u4E2D\u8981\u5BB3\uFF0C\u6216\u662F\u88AB\u64CA\u4E2D\u8981\u5BB3\uFF0C\\n\u9019\u5B8C\u5168\u662F\u904B\u6C23\u2026\u2026\u770B\u8AB0\u6BD4\u8F03\u5E78\u904B\u3002\\r\\n\u4F46\u5C31\u662F\u5B83\uFF0C\u6703\u5728\u5C0D\u6230\u4E2D\u6380\u8D77\u6CE2\u703E\u3002[VAR 0114(0025)]",
  "\u90A3\u9EBC\uFF0C\u6709\u6C92\u6709\u4EBA\u77E5\u9053\\n\u64CA\u4E2D\u8981\u5BB3\u7684\u6A5F\u7387\u662F\u591A\u5C11\u5462\uFF1F[VAR 0114(0025)]",
  "\u5927\u7D04\uFF11\uFF05\uFF08\uFF11\uFF10\uFF10\u6B21\u4E2D\u6709\uFF11\u6B21\uFF09",
  "\u5927\u7D04\uFF14\uFF05\uFF08\uFF11\uFF10\uFF10\u6B21\u4E2D\u6709\uFF14\u6B21\uFF09",
  "\u5927\u7D04\uFF11\uFF12\uFF05\uFF08\uFF11\uFF10\uFF10\u6B21\u4E2D\u6709\uFF11\uFF12\u6B21\uFF09",
  "\u5475\u5475\u5475\uFF0C[VAR 0100(0000)]\uFF0C\\n\u64CA\u4E2D\u8981\u5BB3\u6BD4[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u7684\u9084\u8981\u5BB9\u6613\u4E00\u4E9B\u5594\u3002[VAR 0114(0025)]",
  "\u6C92\u932F\uFF0C\u5F88\u597D\u5594\uFF01\\n\u4E0D\u6127\u662F[VAR 0100(0000)]\uFF01[VAR 0114(0025)]",
  "\u5475\u5475\u5475\uFF0C[VAR 0100(0000)]\uFF0C\\n\u90A3\u4E5F\u5BE6\u5728\u662F\u6709\u592A\u591A\u8981\u5BB3\u4E86\u3002[VAR 0114(0025)]",
  "\u64CA\u4E2D\u8981\u5BB3\u7684\u6A5F\u7387\\n\u6B63\u78BA\u4F86\u8AAA\u662F\uFF12\uFF14\u5206\u4E4B\uFF11\u2026\u2026\\r\\n\u64DA\u8AAA\u662F\uFF14.\uFF11\uFF17\uFF05\u3002[VAR 0114(0025)]",
  "\u4E5F\u6709\u4E9B\u62DB\u5F0F\u6BD4\u8F03\u5BB9\u6613\u64CA\u4E2D\u8981\u5BB3\uFF0C\\n\u4F8B\u5982\u662F\u5C16\u77F3\u653B\u64CA\u6216\u6697\u5F71\u722A\u7684\u8A71\uFF0C\\r\\n\u5C31\u6709\u5927\u7D04\uFF11\uFF12\uFF05\u7684\u6A5F\u7387\u80FD\u64CA\u4E2D\u8981\u5BB3\uFF01[VAR 0114(0025)]",
  "\u5982\u679C\u4F7F\u7528\u53EB\u505A\u805A\u6C23\u7684\u62DB\u5F0F\uFF0C\\n\u6216\u662F\u53EB\u505A\u8981\u5BB3\u653B\u64CA\u7684\u9053\u5177\uFF0C[VAR 0114(0025)]",
  "\u64CA\u4E2D\u8981\u5BB3\u7684\u6A5F\u7387\u5C31\u6703\u63D0\u5347\uFF12\u500B\u7B49\u7D1A\uFF0C\\n\u8B8A\u6210\u6709\uFF15\uFF10\uFF05\u7684\u6A5F\u7387\u53EF\u4EE5\u64CA\u4E2D\u8981\u5BB3\u3002[VAR 0114(0025)]",
  "\u64CA\u4E2D\u8981\u5BB3\uFF0C\u6B61\u6B61\u559C\u559C\uFF0C\\n\u88AB\u64CA\u4E2D\u8981\u5BB3\uFF0C\u54ED\u54ED\u557C\u557C\u3002[VAR 0114(0025)]",
  "\u5BF6\u53EF\u5922\u5C0D\u6230\u4E2D\u96B1\u85CF\u7684\u6A5F\u7387\u6578\u5B78\uFF0C\\n\u5176\u5BE6\u6BD4\u5927\u5BB6\u60F3\u50CF\u7684\u9084\u8981\u591A\u5594\u3002[VAR 0114(0025)]",
  "\u8981\u662F\u80FD\u900F\u904E\u8A08\u7B97\u4F86\u7372\u5F97\u597D\u904B\u7684\u8A71\uFF0C\\n\u4E5F\u8A31\u5C31\u80FD\u62D3\u5BEC\u6230\u8853\u7684\u9078\u9805\u5594\u3002[VAR 0114(0025)]",
  "\u54CE\u5440\uFF0C\u662F\u4E0B\u8AB2\u9418\uFF1F\\n\u9019\u9EBC\u5FEB\u5C31\u7D50\u675F\u4E86\u3002\u771F\u662F\u53EF\u60DC\u2026\u2026[VAR 0114(0025)]",
  "\u4E0B\u6B21\u662F\u5FEB\u5FEB\u6A02\u6A02\u7684\u671F\u4E2D\u8003\uFF01\\n\u5927\u5BB6\u656C\u8ACB\u671F\u5F85\u5594\u3002[VAR 0114(0025)]"
]
