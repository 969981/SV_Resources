[
  "\u6B61\u8FCE\u4F86\u5230\u7119\u56FA\u93AE\u3002\\n\u9019\u88E1\u662F\u661F\u661F\u8207\u9676\u74F7\u5668\u7684\u57CE\u93AE\u3002",
  "\u6211\u7684\u5BB6\u65CF\u4EE3\u4EE3\u90FD\u662F\u9676\u5668\u5DE5\u5320\u5537\uFF01",
  "\u6C34\u91CF\u597D\u5C11\u2026\u2026\\c\\n\u5982\u679C\u6C34\u50CF\u6C34\u70AE\u4E00\u6A23\u5674\u51FA\u4F86\uFF0C\\n\u90A3\u8A72\u6709\u591A\u597D\u73A9\u5440\u3002",
  "\u597D\u5927\u7684\u76E4\u5B50\uFF5E\uFF01\\n\u9019\u662F\u5E7E\u4EBA\u4EFD\u7684\u4E09\u660E\u6CBB\u5462\uFF5E\uFF1F",
  "\u7119\u56FA\u93AE\u7684\u9910\u5177\u5728\u5E15\u5E95\u4E9E\\n\u4E5F\u662F\u975E\u5E38\u53D7\u6B61\u8FCE\u7684\u5DE5\u85DD\u54C1\u5594\u3002",
  "\u9676\u5668\u662F\u5F9E\u571F\u7AAF\u8A95\u751F\u7684\uFF01\\c\\n\u628A\u6210\u5F62\u7684\u9ECF\u571F\u653E\u9032\u7AAF\u88E1\uFF0C\\n\u82B1\u4E0A\u597D\u5E7E\u5929\u6162\u6162\u71D2\u7D50\u800C\u6210\u3002",
  "\u9019\u500B\u57CE\u93AE\u7684\u5C0D\u6230\u5834\uFF0C\\n\u904E\u53BB\u662F\u4F5C\u70BA\u5929\u6587\u53F0\u5EFA\u9020\u800C\u6210\u7684\u5594\u3002",
  "\u722C\u4E0A\u524D\u65B9\u7684\u90A3\u689D\u5761\u9053\u4E4B\u5F8C\uFF0C\\n\u53EF\u4EE5\u770B\u5230\u50CF\u8336\u4E00\u6A23\u7684\u5BF6\u53EF\u5922\u5594\u3002",
  "\u5230\u7119\u56FA\u93AE\u7684\u4E00\u8DEF\u4E0A\uFF0C\\n\u662F\u4E0D\u662F\u628A[VAR 1100(00FF,0101)]\u4F60\u59B3\u7D66\u6298\u9A30\u58DE\u4E86\uFF1F\\c\\n\u4E0D\u904E\u53EA\u8981\u4F86\u904E\uFF11\u6B21\uFF0C\\n\u4E0B\u6B21\u5C31\u80FD\u642D\u98DB\u7FD4\u8A08\u7A0B\u8ECA\u4F86\u4E86\u3002",
  "\u7119\u56FA\u93AE\u7684\u4EA4\u901A\u5F88\u4E0D\u65B9\u4FBF\uFF01\\n\u6469\u6258\u8725\u662F\u4E0D\u53EF\u6216\u7F3A\u7684\u597D\u5925\u4F34\u3002",
  "\u6211\u70BA\u4E86\u9053\u9928\u9928\u4E3B\u8389\u666E\u4F86\u5230\u9019\u88E1\uFF0C\\n\u4F46\u662F\u9019\u88E1\u7684\u76E4\u5B50\u4E5F\u597D\u53EF\u611B\u5594\uFF5E\uFF01",
  "\u5728\u5929\u6587\u53F0\u4E0A\u5BF6\u53EF\u5922\u7684\u756B\uFF0C\\n\u7C21\u7C21\u55AE\u55AE\u7684\u5F88\u53EF\u611B\u5427\u3002\\r\\n\u90A3\u500B\u53EB\u50CF\u7D20\u756B\uFF0C\u5C0D\u4E0D\u5C0D\uFF1F"
]
