  "\u8389\u666E\u6211\u96D6\u7136\u5F88\u5FD9\uFF0C\\n\u4F46\u53EA\u8981\u662F[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u53EB\u6211\uFF0C\\r\\n\u6211\u96A8\u6642\u90FD\u6703\u5FEB\u5FEB\u8D95\u4F86\u7684\u55B2\u3002[VAR 0114(001C)]",
  "\u51F0\u6A97\u5979\u6709\u597D\u597D\u5730\\n\u5728\u7576\u8001\u5E2B\u55CE\uFF1F\\r\\n\u5979\u5F9E\u4EE5\u524D\u5C31\u8001\u662F\u7C97\u5FC3\u5927\u610F\u7684\u3002[VAR 0114(001C)]",
  "\u4E00\u76F4\u7DAD\u6301\u540C\u6A23\u7684\u59FF\u52E2\u4E0D\u8B8A\\n\u53EF\u662F\u5F88\u4E0D\u597D\u7684\u3002\\c\\n\u9019\u7A2E\u6642\u5019\u8A72\u600E\u9EBC\u8FA6\u5462\uFF1F\\n\u55EF\u5475\uFF01\u7576\u7136\u662F\u505A\u559C\u6012\u9A5A\u6A02\u9AD4\u64CD\u3002[VAR 0114(001C)]",
  "[VAR 0101(0001)]\u662F\u4E00\u584A\\n\u975E\u5E38\u597D\u7684\u6599\u5B50\uFF0C\\r\\n\u6211\u6703\u628A\u7260\u57F9\u990A\u5F97\u7F8E\u7F8E\u7684\u5594\u3002[VAR 0114(001C)]",
  "\u8389\u666E\u6211\u7684\u98C4\u98C4\u96DB\\n\u72C0\u6CC1\u600E\u9EBC\u6A23\u5462\uFF1F\\c\\n\u662F\u4E0D\u662F\u4E00\u584A\u9739\u9742\u53C8\u5F37\u5927\uFF0C\\n\u8B93\u4EBA\u5927\u5403\u4E00\u9A5A\u7684\u597D\u6599\u5B50\u5440\uFF01[VAR 0114(001C)]",
  "[VAR 0100(0000)]\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u2026\u2026\\n\u5728\u9078\u64C7\u6700\u559C\u6B61\u7684\u9053\u9928\u9928\u4E3B\u6642\uFF0C\\r\\n\u539F\u4F86[VAR 1100(00FF,0101)]\u4F60\u59B3\u9078\u4E86\u8389\u666E\u6211\u5440\u3002\\c\\n\u662F\u90A3\u500B\u4EBA\u2026\u2026\\n\u4E5F\u6148\u5979\u544A\u8A34\u6211\u7684\u3002\\c\\n\u660E\u660E\u53EA\u8981[VAR 1100(00FF,0101)]\u4F60\u59B3\u8DDF\u6211\u8AAA\u4E00\u8072\uFF0C\\n\u6211\u99AC\u4E0A\u5C31\u6703\u53BB\u88AB\u5708\u7C89\u7684\u8AAA\u2026\u2026\\c\\n\u8389\u666E\u6211\u4E5F\u975E\u5E38\u4E2D\u610F[VAR 1100(00FF,0101)]\u4F60\u59B3\u55B2\uFF01\\n\u55EF\u5475\u2026\u2026\uFF01\u6211\u5011\u771F\u662F\u5169\u60C5\u76F8\u6085\u5462\u3002[VAR 0114(001C)]"
