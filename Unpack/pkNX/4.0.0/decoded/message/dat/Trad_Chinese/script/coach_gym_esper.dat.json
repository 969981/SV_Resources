  "\u62DC\u8A17\u59B3\u4E86\uFF01",
  "\u600E\u9EBC\u8FA6\u597D\u5462\u2026\u2026\uFF1F",
  "\u55EF\u5475\uFF01\\n\u9019\u6B21\u5C31\u5148\u4E0D\u807D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u56DE\u7B54\u4E86\u3002[VAR 0114(001C)]",
