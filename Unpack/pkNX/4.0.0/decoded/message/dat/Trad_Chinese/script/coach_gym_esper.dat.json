  "\u90A3\u6771\u897F\u662F\u5F88\u9739\u9742\u7684\u5594\u3002\\n\u56DE\u79AE\u5C31\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u4EE5\u5F8C\u51FA\u4EBA\u982D\u5730\u4E86\u518D\u7D66\u6211\u5427\u3002[VAR 0114(001C)]",
  "[~ 59]",
  "\u5728\u7F8E\u9E97\u4E0A\u6211\u5011\u662F\u5E73\u624B\u55B2\u3002\\n\u4F86\uFF0C\u9019\u662F\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u4E00\u9EDE\u5C0F\u6771\u897F\u3002[VAR 0114(001C)]",
  "\u55EF\u5475\uFF0C[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u518D\u4F86\u7576\u6211\u7684\u5C0D\u624B\u5594\u3002[VAR 0114(001C)]",
