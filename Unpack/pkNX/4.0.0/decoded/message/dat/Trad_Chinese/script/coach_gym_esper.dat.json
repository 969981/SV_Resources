  "\u55EF\u5475\u5475\uFF01 \u9019\u624D\u5C0D\u561B\u3002\\n\u8389\u666E\u6211\u9019\u908A\u8981\u9001\u51FA\u98C4\u98C4\u96DB\uFF0C\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u9078\u54EA\u500B\u5B69\u5B50\u5462\uFF1F[VAR 0114(001C)]",
