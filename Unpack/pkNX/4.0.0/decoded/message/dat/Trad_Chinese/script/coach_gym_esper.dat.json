  "\u90A3\u5C31\u7528[VAR 0100(0000)]\u7684[VAR 0101(0001)]\\n\u4F86\u4EA4\u63DB\u8389\u666E\u6211\u7684\u98C4\u98C4\u96DB\u56C9\uFF1F[VAR 0114(001C)]",
