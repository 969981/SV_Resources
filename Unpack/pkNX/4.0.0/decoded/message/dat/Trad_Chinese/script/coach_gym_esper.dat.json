  "\u70BA\u4E86\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u8981\u5FD8\u8A18\u2026\u2026\\n\u8981\u4E0D\u8981\u548C\u8389\u666E\u6211\u88FD\u9020\u4E00\u4E9B\u56DE\u61B6\u5440\uFF1F[VAR 0114(001C)]",
