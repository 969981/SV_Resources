  "\u4E0D\u5C0D\u4E0D\u5C0D\u55B2\uFF0C[VAR 0100(0000)]\u3002\\n\u96D6\u8AAA\u8389\u666E\u6211\u7576\u8D77\u7A7A\u670D\u54E1\u4E5F\u5F88\u9069\u5408\u5C31\u662F\u4E86\u3002\\c\\n\u8389\u666E\u6211\u662F\u500B\u5F69\u599D\u85DD\u8853\u5BB6\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u597D\u597D\u8A18\u4F4F\u3002[VAR 0114(001C)]",
  "\u4E0D\u5C0D\u4E0D\u5C0D\u55B2\uFF0C[VAR 0100(0000)]\u3002\\n\u90A3\u662F\u67D0\u500B\u5947\u602A\u85DD\u8853\u5BB6\u7684\u982D\u929C\u3002\\c\\n\u8389\u666E\u6211\u662F\u500B\u5F69\u599D\u85DD\u8853\u5BB6\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u597D\u597D\u8A18\u4F4F\u3002[VAR 0114(001C)]",
  "\u5B8C\u7F8E\u7684\u7B54\u6848\uFF01\\n\u8389\u666E\u6211\u662F\u500B\u5F69\u599D\u85DD\u8853\u5BB6\uFF01\\c\\n\u96D6\u8AAA\u9084\u517C\u4EFB\u6A21\u7279\u5152\u548C\\n\u9053\u9928\u9928\u4E3B\u5C31\u662F\u4E86\u3002[VAR 0114(001C)]",
  "\u9019\u908A\u6709\u5F88\u591A\u4EBA\u4E0D\u8A8D\u8B58\u8389\u666E\u6211\uFF0C\\n\u5728\u544A\u8A34\u4ED6\u5011\u8389\u666E\u6211\u7684\u5DE5\u4F5C\u4E4B\u5F8C\uFF0C\\r\\n\u5927\u5BB6\u90FD\u975E\uFF5E\u5E38\u611F\u8208\u8DA3\u3002[VAR 0114(001C)]",
  "\u8389\u666E\u6211\u5728\u5E15\u5E95\u4E9E\u7B97\u662F\u500B\u77E5\u540D\u4EBA\u58EB\uFF0C\\n\u4F46\u5728\u6D77\u5916\u4E5F\u53EA\u662F\u500B\u666E\u901A\u4EBA\u5462\u3002[VAR 0114(001C)]",
  "\u65E2\u7136\u5982\u6B64\uFF0C\u6211\u53EF\u8981\u8D81\u9019\u500B\u6A5F\u6703\u8B93\u5168\u4E16\u754C\\n\u5B8C\u7F8E\u77E5\u9053\u8389\u666E\u6211\u7684\u7F8E\u9E97\u79D8\u8A23\u624D\u884C\uFF01[VAR 0114(001C)]",
