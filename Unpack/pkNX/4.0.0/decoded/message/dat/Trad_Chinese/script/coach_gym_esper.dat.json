  "\u7A00\u6709\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
  "\u7570\u8272\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
  "\u2026\u2026\u4E0D\u884C\u4E0D\u884C\u55B2\uFF0C\\n\u53EA\u6709\uFF11\u96BB\u540C\u884C\u5BF6\u53EF\u5922\u662F\u4E0D\u53EF\u4EE5\u4EA4\u63DB\u7684\u3002\\c\\n\u8981\u662F\u540C\u884C\u5BF6\u53EF\u5922\u6709\u500B\uFF12\u96BB\u7684\u8A71\uFF0C\\n\u90A3\u9084\u597D\u8AAA\u2026\u2026[VAR 0114(001C)]",
  "\u8ACB\u5728\u8389\u666E\u6211\u6539\u8B8A\u5FC3\u610F\u524D\u518D\u4F86\u3002\\n\u62DC\u8A17\u560D\u3002[VAR 0114(001C)]",
  "\u55EF\u5475\uFF01\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F88\u4E45\u4E86\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u548C\u8389\u666E\u6211\u4EA4\u63DB\u98C4\u98C4\u96DB\u4E86\u5427\uFF1F[VAR 0114(001C)]",
