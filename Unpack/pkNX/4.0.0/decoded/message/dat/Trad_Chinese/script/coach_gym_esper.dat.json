  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u8A18\u4F4F\u4F86\u81EA\u9577\u8F29\u7684\u5EFA\u8B70\uFF0C\\n\u771F\u4E86\u4E0D\u8D77\u5440\u3002[VAR 0114(001C)]",
  "\u96D6\u7136\u9019\u7A2E\u5047\u88DD\u7CCA\u5857\u7684\u89D2\u8272\u4E5F\u5F88\u53EF\u611B\u2026\u2026\\n\u4F46\u50C5\u9650\u73FE\u5728\u9019\u6A23\u5594\uFF1F[VAR 0114(001C)]",
  "\u8981\u8B93\u81EA\u5DF1\u7684\u624D\u80FD\u767C\u63EE\u5230\u6975\u81F4\uFF0C\\n\u4E0D\u65B7\u767C\u5149\u767C\u71B1\u7684\u7D04\u5B9A\u2026\u2026[VAR 0114(001C)]",
  "\u770B\u4F86\u5B8C\u5168\u4E0D\u7528\u64D4\u5FC3\uFF01\\n\u53CD\u5012\u662F\u2026\u2026\u55EF\u5475\uFF01\\r\\n\u8389\u666E\u6211\u751A\u81F3\u6709\u9EDE\u5403\u9A5A\u5462\u3002[VAR 0114(001C)]",
