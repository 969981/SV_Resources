  "\u600E\u9EBC\u4E86\uFF0C[VAR 0100(0000)]\uFF1F\\n\u96E3\u9053\u662F\u60F3\u548C\u6211\u5C0D\u6230\u55CE\uFF1F[VAR 0114(0028)]",
  "\u4E00\u526F\u60F3\u6253\u7684\u6A23\u5B50\uFF0C\u7D50\u679C\u4E0D\u6253\u554A\uFF01\\n\u597D\u5427\uFF5E\u6211\u6C92\u5DEE\u3002[VAR 0114(0028)]",
  "\u597D\u5440\uFF5E\u53CD\u6B63\u6211\u4E5F\u6709\u7A7A\u3002\\n\u5C31\u8B93\u6211\u966A\u966A[VAR 1100(00FF,0101)]\u4F60\u59B3\u5427\u3002[VAR 0114(0028)]",
  "[~ 61]",
  "\u5C0F\u5B69\u5B50\u7E3D\u662F\u5168\u529B\u4EE5\u8D74\uFF0C\\n\u771F\u662F\u4E0D\uFF5E\u5F97\u4E86\u5440\u2026\u2026[VAR 0114(0028)]",
  "\u800C\u4E14[VAR 1100(00FF,0101)]\u4F60\u59B3\u53C8\u7279\u5225\u5730\u5F37\uFF0C\\n\u61C9\u8A72\u8981\u591A\u653E\u9EDE\u6C34\u7684\u5440\uFF5E\uFF01[VAR 0114(0028)]",
