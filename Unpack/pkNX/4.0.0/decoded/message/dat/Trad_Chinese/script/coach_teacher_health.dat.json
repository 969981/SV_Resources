  "\u96D6\u7136\u9019\u61C9\u8A72\u52C9\u52C9\u5F37\u5F37\\n\u9084\u4E0D\u7B97\u4FD7\u6C23\u2026\u2026\\r\\n\u4F46\u5F8C\u679C\u8ACB\u81EA\u884C\u8CA0\u8CAC\u56C9\uFF5E[VAR 0114(0028)]",
  "[VAR 0100(0000)]\u5F9E\u7C73\u83AB\u838E\u8001\u5E2B\u90A3\u88E1\\n\u5B78\u6703\u4E86[VAR FF00(0008)]\u984D\u982D\u6BD4\u8036\u8868\u60C5[VAR FF00(0000)]\uFF01",
