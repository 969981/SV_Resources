  "\u5C0D\u4E86\uFF5E\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u9084\u6709\u6642\u9593\u55CE\uFF1F[VAR 0114(0028)]",
  "\u56E0\u70BA\u6211\u7E3D\u662F\u53D7\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u7167\u9867\u2026\u2026[VAR 0114(0028)]",
