  "\u6B38\uFF5E\u8B1B\u771F\u7684\u55CE\uFF1F\\n\u62D2\u7D55\u6211\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EF\u662F\u6703\u5403\u8667\u7684\u5594\uFF5E\uFF1F[VAR 0114(0028)]",
