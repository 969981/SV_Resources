  "\u4E0D\u2026\u2026\u600E\u9EBC\u53EF\u80FD\uFF1F\\n\u6709\u4EBA\u5B89\u6170\u6211\uFF0C\u6211\u662F\u5F88\u958B\u5FC3\uFF0C\\r\\n\u4F46\u5728\u5B78\u9662\u4E5F\u4E0D\u6703\u767C\u751F\u9019\u7A2E\u4E8B\u5427\uFF1F[VAR 0114(0028)]",
