  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7528\u904E\u5DE8\u86CB\u88E1\u7684\u56DE\u5FA9\u6A5F\u55CE\uFF1F\\c\\n\u90A3\u6771\u897F\u597D\u50CF\u53EF\u4EE5\u81EA\u5DF1\u64CD\u4F5C\u4F86\u56DE\u5FA9\u9AD4\u529B\u5462\uFF5E\\n\u7E3D\u89BA\u5F97\u597D\u61F7\u5FF5\u5440\uFF5E[VAR 0114(0028)]",
  "\u9019\u500B\u5B78\u5712\u662F\u4E0D\u662F\u6C92\u6709\u91AB\u52D9\u5BA4\uFF1F\\c\\n\u90A3\u5927\u5BB6\u60F3\u8E7A\u8AB2\u7684\u6642\u5019\uFF0C\\n\u90FD\u6703\u53BB\u54EA\u88E1\u5440\uFF1F[VAR 0114(0028)]",
  "\u5099\u8AB2\u771F\u662F\\n\u633A\uFF5E\u8F9B\u82E6\u7684\u8036\u2026\u2026\\c\\n\u5B78\u9662\u7684\u5404\u4F4D\u8001\u5E2B\u5011\\n\u90FD\u80FD\u4E0D\u53EB\u82E6\u5C31\u5B8C\u6210\uFF0C\u771F\u662F\u53B2\u5BB3\uFF5E[VAR 0114(0028)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684[VAR 0101(0001)]\u6D3B\u529B\u592A\u5145\u6C9B\u4E86\uFF0C\\n\u8B93\u6211\u5E7E\u4E4E\u62DB\u67B6\u4E0D\u4F4F\uFF01\\r\\n\u8B1B\u771F\u7684\uFF0C\u548C\u67D0\u4EBA\u4E00\u6A21\u4E00\u6A23\u3002[VAR 0114(0028)]",
  "\u6211\u7684\u597D\u58DE\u661F\u5F88\u68D2\u5427\uFF1F\\n\u800C\u4E14\u7260\u7684\u7279\u6027\u9084\u5F88\u7F55\u898B\u5462\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u597D\u597D\u5730\u57F9\u80B2\u7260\uFF0C\\n\u8B93\u7260\u53EF\u4EE5\u4E0A\u53F0\u8868\u6F14\u5594\uFF5E[VAR 0114(0028)]"
