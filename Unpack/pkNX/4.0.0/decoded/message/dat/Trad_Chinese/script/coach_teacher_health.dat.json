  "\u554A\uFF5E\uFF01[VAR 0100(0000)]\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u807D\u6211\u8AAA\u597D\u4E0D\u597D\uFF5E\uFF01[VAR 0114(0028)]",
