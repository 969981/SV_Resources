[
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u4E86\uFF0C[VAR 0100(0000)]\u3002[VAR 0114(0004)]",
  "\u60F3\u8981\u53C3\u52A0\u6821\u5712\u6700\u5F37\u5927\u8CFD\u7684\u8A71\uFF0C\\n\u5FC5\u9808\u8981\u5411\u5DE5\u4F5C\u4EBA\u54E1\u7533\u8ACB\u53C3\u8CFD\uFF01[VAR 0114(0004)]",
  "\u90A3\u9EBC\uFF0C\u5C31\u9EBB\u7169\u4F60\\n\u8AAA\u660E\u5927\u8CFD\u898F\u5247\u4E86\uFF01[VAR 0114(0004)]",
  "\u6821\u5712\u6700\u5F37\u5927\u8CFD\u898F\u5B9A\\n\u4E0D\u8AD6\u662F\u5B78\u751F\u6216\u8001\u5E2B\u90FD\u80FD\u5920\u53C3\u8CFD\u3002\\r\\n\u662F\u52DD\u8005\u6649\u7D1A\u5F0F\u7684\u96A8\u6A5F\u5C0D\u6230\uFF01",
  "\u6BD4\u8CFD\u7684\u5C0D\u624B\u6703\u7531\u71DF\u904B\u7D44\\n\u900F\u904E\u62BD\u7C64\u6C7A\u5B9A\uFF0C\u56E0\u6B64\u2026\u2026",
  "\u76F4\u5230\u5728\u5C0D\u6230\u5834\u4E0A\u9762\u5C0D\u9762\u4E4B\u524D\uFF0C\\n\u7121\u6CD5\u5F97\u77E5\u81EA\u5DF1\u7684\u5C0D\u624B\u6703\u662F\u8AB0\uFF01",
  "\u7372\u52DD\u7684\u4EBA\u53EF\u4EE5\u7E7C\u7E8C\u4E0B\u4E00\u5834\u5C0D\u6230\u3002",
  "\u4F46\u53EA\u8981\u8F38\u4E00\u5834\u5C31\u7B97\u51FA\u5C40\uFF0C\\n\u7121\u6CD5\u7E7C\u7E8C\u53C3\u52A0\u4E4B\u5F8C\u7684\u5C0D\u6230\u3002",
  "\u4E5F\u5C31\u662F\u8AAA\uFF0C\u5728\u5C0D\u6230\u4E2D\u9023\u6230\u9023\u52DD\uFF0C\\n\u76F4\u5230\u6210\u70BA\u6700\u5F8C\u552F\u4E00\u5269\u4E0B\u7684\u4E00\u500B\u4EBA\uFF0C\\r\\n\u90A3\u500B\u4EBA\u5C31\u662F\u6821\u5712\u6700\u5F37\u7684\u8A13\u7DF4\u5BB6\uFF01",
  "\u8B1D\u8B1D\u4F60\uFF01[VAR 0114(0004)]",
  "\u9019\u662F\u6211\u548C\u514B\u62C9\u97CB\u723E\u6821\u9577\\n\u5546\u91CF\u51FA\u4F86\u7684\u5927\u8CFD\u898F\u5247\u5594\uFF01[VAR 0114(0004)]",
  "\u4EE5\u76EE\u524D\u53C3\u8CFD\u7684\u4EBA\u6578\u4F86\u8AAA\uFF0C\\n\u5927\u6982\u8D0F\u500B\uFF14\u5834\u5DE6\u53F3\u5C31\u80FD\u62FF\u4E0B\u512A\u52DD\u4E86\uFF01[VAR 0114(0004)]",
  "\u8001\u5E2B\u5011\u5404\u500B\u4E5F\u90FD\u662F\u9AD8\u624B\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u52A0\u6CB9\u5594\uFF01[VAR 0114(0004)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u53EF\u4EE5\u8F38\u7D66\u6211\u4EE5\u5916\u7684\u4EBA\u5594\uFF5E\uFF01[VAR 0114(0004)]",
  "\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u6E96\u5099\u597D\u5F8C\uFF0C\\n\u8ACB\u544A\u8A34\u6211\u4E00\u8072\u3002"
]
