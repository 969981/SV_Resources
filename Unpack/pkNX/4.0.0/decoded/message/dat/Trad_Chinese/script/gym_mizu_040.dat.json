  "[~ 28]",
  "\u8A0E\u50F9\u9084\u50F9\uFF0C\u5E02\u5834\u8981\u6BD4\u50F9\uFF0C\\n\u51FA\u62DB\u63A5\u62DB\uFF0C\u9053\u9928\u8981\u904E\u62DB\u3002[VAR 0114(0018)]",
