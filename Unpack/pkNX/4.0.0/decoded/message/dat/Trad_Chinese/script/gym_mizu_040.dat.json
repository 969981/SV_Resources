  "\u53EA\u8981\u6709[VAR 0200(0001)]\u500B\u9053\u9928\u5FBD\u7AE0\uFF0C\\n\u7B49\u7D1A[VAR 0201(0002)]\u4EE5\u4E0B\u7684\u5BF6\u53EF\u5922\u5C31\u6703\\r\\n\u6BD4\u8F03\u5BB9\u6613\u6349\u5230\uFF0C\u800C\u4E14\u4E5F\u6703\u807D\u8A71\uFF01[VAR 0114(0018)]",
  "\u53EA\u8981\u6709\uFF18\u500B\u9053\u9928\u5FBD\u7AE0\uFF0C\\n\u4E0D\u8AD6\u4EC0\u9EBC\u5BF6\u53EF\u5922\u90FD\u80FD\u6349\u5230\uFF0C\\r\\n\u4E5F\u90FD\u6703\u807D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8A71\uFF01[VAR 0114(0018)]",
  "\u82E5\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\u4E00\u5B9A\u80FD\u5F97\u5FC3\u61C9\u624B\u5730\u7528\u9019\u500B\u62DB\u5F0F\uFF01\\n\u4F86\uFF01\u8DF3\u6A13\u5927\u62CD\u8CE3\u56C9\uFF01\u628A\u9019\u4E5F\u62FF\u53BB\u5427\uFF01[VAR 0114(0018)]",
