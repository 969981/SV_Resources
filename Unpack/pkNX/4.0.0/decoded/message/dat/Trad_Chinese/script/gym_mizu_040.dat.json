  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u754F\u7AF6\u722D\u5730\u91E3\u8D77\u4E86\u52DD\u5229\uFF01\\n\u5BE6\u5728\u4F69\u670D\uFF01\u4F69\u670D\uFF01[VAR 0114(0018)]",
