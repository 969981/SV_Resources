  "\u8A17[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u798F\uFF0C\u6211\u597D\u50CF\u80FD\\n\u505A\u51FA\u7A76\u6975\u7684\u6D77\u5E36\u6599\u7406\u56C9\uFF01[VAR 0114(0018)]",
