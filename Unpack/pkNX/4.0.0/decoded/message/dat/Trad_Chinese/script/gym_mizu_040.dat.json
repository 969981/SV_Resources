  "\u6C34\u5C6C\u6027\u5BF6\u53EF\u5922\u7684\u6D77\u5473\u5BB4\u5E2D\uFF01\\n\u4F86\uFF01\u9019\u5C31\u4F86\u98FD\u5690\u4E00\u9813\u5427\uFF01[VAR 0114(0018)]",
  "\u54C7\u3001\u54C8\u3001\u54C8\uFF01\u8F38\u5F97\u771F\u662F\u8212\u723D\uFF01\\n\u5C31\u50CF\u662F\u4F86\u5230\u4E86\u6E05\u6668\u7684\u5E02\u5834\u554A\uFF01[VAR 0114(0018)]",
