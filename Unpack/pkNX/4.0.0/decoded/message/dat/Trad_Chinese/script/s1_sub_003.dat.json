[
  "\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01\\n\u54E6\uFF5E\u5475\u5475\u5475\u5475\uFF01[VAR 0114(002C)]",
  "\u55EF\uFF5E\u8CA0\u96E2\u5B50\uFF01\\n\u6211\u771F\u60F3\u628A\u5317\u4E0A\u7684\u7A7A\u6C23\u901A\u901A\u8CB7\u4E0B\u4F86\uFF0C\u5475\uFF01[VAR 0114(002C)]",
  "\u771F\u4E0D\u6127\u662F\u99A5\u597D\uFF01\\n\u5C31\u7B97\u4F86\u5230\u9109\u4E0B\uFF0C\u60F3\u6CD5\u9084\u662F\u5982\u6B64\u90FD\u6703\u6642\u5C1A\uFF01[VAR 0114(002C)]",
  "\u6BC5\u842C\uFF01\\n\u8B1D\u8B1D\u4F60\u6558\u8FF0\u4E86\u4E00\u500B\u4E8B\u5BE6\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u99A5\u597D\uFF01\\n\u4ECA\u5929\u6211\u5011\u8981\u600E\u9EBC\u6A23\\r\\n\u4F86\u63EE\u970D\u6642\u9593\u548C\u91D1\u9322\u5462\uFF01\uFF1F[VAR 0114(0040)]",
  "\u9019\u500B\u561B\u2026\u2026\u5475\u3002[VAR 0114(0041)]",
  "\u6211\u8AAA\uFF0C\u6BC5\u842C\u2026\u2026\\n\u6709\u5EB6\u6C11\u5728\u770B\u6211\u5011\u2026\u2026[VAR 0114(0041)]",
  "\u4EC0\u9EBC\uFF01\u59B3\u8AAA\u5EB6\u6C11\uFF1F[VAR 0114(0040)]",
  "\u771F\u7684\u8036\uFF5E\\n\u90A3\u80AF\u5B9A\u5C31\u662F\u5982\u5047\u5305\u63DB\u7684\u5EB6\u6C11\uFF01[VAR 0114(0040)]",
  "\u5EB6\u6C11\u2026\u2026\uFF01\\n\u6D3B\u3001\u6D3B\u751F\u751F\u7684\u5EB6\u6C11\u2026\u2026\uFF01[VAR 0114(0041)]",
  "\u600E\u3001\u600E\u9EBC\u8FA6\uFF1F\u6BC5\u842C\uFF01\\n\u8ACB[VAR 1100(00FF,0101)]\u4ED6\u5979\u8DDF\u6211\u63E1\u624B\u7684\u8A71\uFF0C\u6703\u5F88\u6C92\u79AE\u8C8C\u55CE\uFF01\uFF1F\\r\\n\u9084\u662F\u6211\u53EF\u4EE5\u8DDF[VAR 1100(00FF,0101)]\u4ED6\u5979\u8981\u7C3D\u540D\u55CE\uFF01\uFF1F[VAR 0114(0041)]",
  "\u51B7\u975C\u4E00\u9EDE\uFF0C\u99A5\u597D\uFF01\\n\u5EB6\u6C11\u662F\u4E0D\u6703\u9003\u8D70\u7684\uFF01[VAR 0114(0040)]",
  "\u62B1\u3001\u62B1\u6B49\u3002\\n\u56E0\u70BA\u5EB6\u6C11\u5BE6\u5728\u662F\u592A\u5C11\u898B\u4E86\u2026\u2026[VAR 0114(0041)]",
  "\u6211\u61C2\u2026\u2026\\n\u7562\u7ADF\u99A5\u597D\u59B3\u662F\u4E0D\u52D5\u7522\u516C\u53F8\u2026\u2026\\r\\n\u5E15\u5E95\u4E9E\u4E0D\u52D5\u7522\u7684\u793E\u9577\u5440\u3002[VAR 0114(0040)]",
  "\u90A3\u908A\u90A3\u4F4D\u5EB6\u6C11\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\uFF1F[VAR 0114(0041)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u548C\u6211\u4F86\u4E00\u5834\\n\u5BF6\u53EF\u5922\u7684\u6C7A\u9B25\u55CE\uFF1F\u5475\u3002[VAR 0114(0041)]",
  "\u8981\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u80FD\u8D0F\u904E\u6211\uFF0C\\n\u6211\u5C31\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u5343\u842C\u8CA1\u5BCC\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u51FA\u2026\u2026\u51FA\u73FE\u4E86\uFF01\\n\u99A5\u597D\u7684\u8208\u8DA3\uFF01[VAR 0114(0040)]",
  "\u63D0\u4F9B\u6A5F\u6703\u7D66\u5EB6\u6C11\uFF5E\uFF01[VAR 0114(0040)]",
  "\u5475\u5475\u5475\u2026\u2026\u5982\u679C\u505A\u597D\u89BA\u609F\u4E86\uFF0C\\n\u5C31\u7531\u5EB6\u6C11\u7684[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u9080\u7D04\u6211\u5427\u3002[VAR 0114(0041)]",
  "\u8981\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u60F3\u8981\u64C1\u6709\u5343\u842C\u8CA1\u5BCC\uFF0C\\n\u5C31\u767C\u63EE\u5EB6\u6C11\u672C\u8272\uFF0C\u8DDF\u99A5\u597D\u642D\u8A71\u5427\uFF01[VAR 0114(0040)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u548C\u6211\u4F86\u4E00\u5834\\n\u8CED\u4E0A\u5343\u842C\u8CA1\u5BCC\u7684\u6C7A\u9B25\u55CE\uFF1F[VAR 0114(0041)]",
  "\u2026\u2026\u5076\u723E\u88AB\u5EB6\u6C11\u64FA\u5F04\u7684\u611F\u89BA\uFF0C\\n\u9084\u4E0D\u932F\u561B\uFF0C\u5475\u3002\\c\\n\u540D\u6D41\u7684\u6642\u9593\u662F\u5F88\u5BF6\u8CB4\u7684\uFF0C\u5475\uFF01\\n\u6211\u5011\u5C31\u7ACB\u523B\u4F86\u6253\u5427\uFF0C\u54E6\u5475\u5475\u5475\uFF01\uFF01[VAR 0114(0041)]",
  "\u5E15\u5E95\u4E9E\u4E0D\u52D5\u7522\u793E\u9577\uFF0C\u99A5\u597D\uFF01\\n\u770B\u6211\u628A\u5EB6\u6C11\u6253\u5230\u843D\u82B1\u6D41\u6C34\uFF0C\u54E6\u5475\u5475\u5475\uFF01[VAR 0114(0041)]",
  "\u55B2\uFF5E\u55B2\uFF5E\uFF01\\n\u52A0\u6CB9\u554A\uFF0C\u99A5\u597D\uFF01[VAR 0114(0040)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u592A\u53B2\u5BB3\u4E86\uFF0C\u5475\uFF01\\n\u771F\u662F\u4E00\u4F4D\u51FA\u8272\u7684\u5EB6\u6C11\uFF01[VAR 0114(0041)]",
  "\u55B2\uFF5E\u55B2\uFF5E\uFF01\\n\u99A5\u597D\u59B3\u5C31\u7B97\u8F38\u4E86\uFF0C\u9084\u662F\u5F88\u53EF\u611B\u5594\uFF01[VAR 0114(0040)]",
  "\u5EB6\u6C11\u554A\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u807D\u597D\u4E86\u3002\\n\u9322\u9019\u500B\u6771\u897F\uFF0C\u91CD\u8981\u7684\u662F\u600E\u9EBC\u7528\u5B83\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u525B\u525B\u7684\u734E\u91D1\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u7528\u5728\u5C0D\u4EBA\u751F\u6709\u610F\u7FA9\u7684\u4E8B\u7269\u4E0A\u2026\u2026\\r\\n\u5C31\u7576\u4F5C\u81EA\u6211\u6295\u8CC7\uFF0C\u597D\u597D\u904B\u7528\u5427\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u9019\u9EBC\u4E00\u4F86\uFF0C\u5C31\u7B97\u9322\u672C\u8EAB\u7528\u5B8C\u4E86\uFF0C\\n\u5B83\u4E5F\u6703\u8B8A\u6210\u8CA1\u7522\uFF0C\u7E7C\u7E8C\u91D1\u5149\u9583\u8000\u7684\uFF0C\u5475\u3002[VAR 0114(0041)]",
  "\u597D\u4E86\uFF0C\u6BC5\u842C\uFF01\\n\u6211\u73FE\u5728\u60F3\u99AC\u4E0A\u53BB\u770B\\r\\n\u5E15\u5E95\u4E9E\u7684[VAR FF00(0006)]\u90A3\u5EA7\u7011\u5E03[VAR FF00(0000)]\uFF0C\u5475\uFF01[VAR 0114(0041)]",
  "\u55B2\uFF5E\uFF01\\n\u624D\u525B\u4F86\u5230\u5317\u4E0A\u5C31\u8981\u56DE\u53BB\uFF01\\r\\n\u99A5\u597D\u59B3\u771F\u662F\u540D\u6D41\u7684\u5178\u7BC4\uFF01[VAR 0114(0040)]",
  "\u5509\uFF0C\u99A5\u597D\u5C0F\u59D0\u548C\u6BC5\u842C\u5148\u751F\u2026\u2026\\n\u4F60\u5011\u5F80\u54EA\u88E1\u53BB\u4E86\u5462\uFF1F",
  "\u300C\u6211\u8981\u53BB\u53EF\u4EE5\u4E00\u671B\\n\u512A\u7F8E\u7530\u5712\u98A8\u666F\u7684\u5730\u65B9\uFF0C\u5475\uFF01\u300D\\c\\n\u2026\u2026\u99A5\u597D\u5C0F\u59D0\u662F\u9019\u9EBC\u8AAA\uFF0C\\n\u4F46\u90A3\u7A76\u7ADF\u662F\u4EC0\u9EBC\u5730\u65B9\uFF1F"
]
