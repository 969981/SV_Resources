[
  "\u597D\u61F7\u5FF5\u5537\uFF5E\\n[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u6EFE\u6A44\u6B16\u7684\u6A21\u6A23\u3002[VAR 0114(0016)]",
  "\u90A3\u6C23\u52E2\u7C21\u76F4\u5C31\u50CF\u662F\\n\u592A\u6676\u5316\u6210\u4E86\u683C\u9B25\u5C6C\u6027\u4E00\u822C\u5537\uFF5E[VAR 0114(0016)]",
  "\u5C0D[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u8AAA\uFF0C\\n\u6211\u9019\u88E1\u662F\u7B2C\u5E7E\u500B\u9053\u9928\u5462\uFF5E\uFF1F[VAR 0114(0016)]",
  "\u5713\u6A21\u9053\u9928\u8DDD\u96E2\u5B78\u6821\u5F88\u8FD1\uFF0C\\n\u6240\u4EE5\u6709\u5F88\u591A\u8A13\u7DF4\u5BB6\u6703\u6311\u9078\u9019\u88E1\\r\\n\u7576\u4F5C\u7B2C\u4E00\u500B\u6311\u6230\u7684\u9053\u9928\u5462\uFF5E[VAR 0114(0016)]",
  "\u6240\u4EE5\u9996\u5E2D\u5E0C\u671B\u6211\u5728\u5C0D\u6230\u51FA\u624B\u6642\\n\u8981\u50CF\u9EDE\u5FC3\u90A3\u6A23\u751C\uFF5E\u6ECB\u6ECB\u7684\uFF5E[VAR 0114(0016)]",
  "\u53EF\u662F\u8B93\u6211\u7684\u87F2\u5152\u5011\u7E3D\u662F\u5403\u6557\u4ED7\uFF0C\\n\u5BE6\u5728\u592A\u53EF\u6190\u4E86\u2026\u2026[VAR 0114(0016)]",
  "\u5475\u5475\u5475\uFF0C\u9047\u4E0A\u9019\u6A23\u7684\u6A5F\u6703\\n\u5C31\u80FD\u62FF\u51FA\u5168\u529B\uFF0C\u8B93\u6211\u597D\u9AD8\u6602\u5440\uFF5E[VAR 0114(0016)]",
  "\u6211\u6703\u8B93[VAR 1100(00FF,0101)]\u4F60\u59B3\u9AD4\u7121\u5B8C\u819A\u5730\\n\u88AB\u6253\u8DB4\u5728\u5730\u4E0A\u7684\u5537\uFF5E\uFF01[VAR 0114(0016)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8EAB\u624B\u4E00\u9EDE\u90FD\u4E0D\u4E9E\u65BC\u9996\u5E2D\uFF0C\\n\u611F\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u6B3E\u5F85\uFF5E[VAR 0114(0016)]",
  "\u554A\uFF5E\uFF01\u4F7F\u52C1\u5168\u529B\u5C0D\u6230\uFF0C\\n\u7136\u5F8C\u88AB\u6253\u6557\uFF0C\u9019\u611F\u89BA\u771F\u66A2\u5FEB\uFF5E\uFF01[VAR 0114(0016)]",
  "\u5C0D\u6230\u6642\u4E0B\u624B\u592A\uFF5E\u751C\u7684\u8A71\uFF0C\\n\u4E5F\u8A31\u5C0D\u6575\u6211\u5F7C\u6B64\u90FD\u4E0D\u597D\u5462\uFF5E[VAR 0114(0016)]",
  "\u6211\u7684\u6599\u7406\u5E2B\u5085\u6D77\u5CB1\u4E5F\u8AAA\u904E\\n\u8981\u6211\u66F4\u81EA\u5728\u5C55\u73FE\u81EA\u5DF1\uFF5E[VAR 0114(0016)]",
  "\u4EE5\u5F8C\u6211\u8981\u7A0D\u5FAE\u66F4\u81EA\u5728\u505A\u81EA\u5DF1\u2026\u2026\\n\u6211\u4E00\u5B9A\u6703\u8A66\u8A66\u7684\uFF01[VAR 0114(0016)]",
  "\u8981\u662F\u88AB\u5927\u5BB6\u8AAA\u9053\u9928\u96E3\u5EA6\u63D0\u5347\u4E86\uFF0C\\n\u90A3\u6211\u5C31\u85C9\u53E3\u8AAA\u662F\u6539\u6210\u82E6\u5473\u8DEF\u7DDA\u4E86\u5427\uFF5E[VAR 0114(0016)]",
  "\u90A3\u9EBC\uFF0C\\n\u6211\u5011\u5F8C\u6703\u6709\u671F\uFF5E[VAR 0114(0016)]"
]
