[
  "\u554A\u54C8\uFF01\u775C\u5927\u773C\u775B\u770B\u770B\u5427\uFF01\\n\u6975\u5730\u5EE3\u5834\u7684\u5C0D\u6230\u5834\uFF5E\uFF01[VAR 0114(004A)]",
  "\u2026\u2026\u4E0D\u904E\uFF0C\u9019\u88E1\u9664\u4E86\u7279\u5225\u51B7\u4EE5\u5916\uFF0C\\n\u548C\u5176\u4ED6\u5EE3\u5834\u4E5F\u6C92\u5565\u4E0D\u4E00\u6A23\uFF01[VAR 0114(004A)]",
  "\u6211\u96D6\u7136\u662F\u99B4\u9F8D\u5E2B\uFF0C\\n\u4F46\u6211\u633A\u559C\u6B61\u5BD2\u51B7\u7684\u3002[VAR 0114(004A)]",
  "\u54CE\u5440\uFF0C\u8A71\u8AAA\u56DE\u4F86\uFF0C\u6B7B\u9EE8\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u4F86\u53C3\u52A0\u56DB\u5929\u738B\u6311\u6230\u7684\u561B\u3002[VAR 0114(004A)]",
  "\u6211\u9019\u88E1\u7684\u6311\u6230\u662F\\n[VAR FF00(0006)]\u5DE8\u86CB\u9650\u5B9A\u5C0D\u6230[VAR FF00(0000)]\uFF01[VAR 0114(004A)]",
  "\u898F\u5247\u5F88\u7C21\u55AE\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EA\u8981\u6253\u8D0F\u806F\u76DF\u793E\u7684\uFF13\u500B\u5B78\u5F1F\u5B78\u59B9\u5011\uFF0C\\r\\n\u5C31\u641E\u5B9A\u6311\u6230\u4E86\uFF01[VAR 0114(004A)]",
  "\u53EA\u662F\uFF0C\u6B63\u5982\u5176\u540D\uFF5E\uFF01\\n\u4E0A\u5834\u5C0D\u6230\u7684\u5BF6\u53EF\u5922\u5440\uFF5E\u5F97\u7B26\u5408\u689D\u4EF6\uFF01[VAR 0114(004A)]",
  "\u7B2C\u4E00\uFF01\u5FC5\u9808\u662F\\n[VAR FF00(0006)]\u5728\u751F\u614B\u5DE8\u86CB\u6349\u5230[VAR FF00(0000)]\u7684\u91CE\u751F\u5BF6\u53EF\u5922\uFF01[VAR 0114(004A)]",
  "\u7B2C\u4E8C\uFF01\\n\u5FC5\u9808\u662F[VAR FF00(0006)]\u81EA\u5DF1\u6349\u5230[VAR FF00(0000)]\u7684\u5BF6\u53EF\u5922\uFF01[VAR 0114(004A)]",
  "\u53EA\u8981\u540C\u884C\u7684\u968A\u4F0D\u4E2D\u6709\u4E0D\u7B26\u5408\\n\u689D\u4EF6\u7684\u5BF6\u53EF\u5922\uFF0C\u5C31\u4E0D\u80FD\u6311\u6230\u56C9\u3002[VAR 0114(004A)]",
  "\u96D6\u7136\u9019\u53EF\u80FD\u6709\u4E9B\u9EBB\u7169\uFF0C\\n\u4F46\u8981\u662F\u8F15\u8F15\u9B06\u9B06\u9760[VAR 1100(00FF,0101)]\u4F60\u59B3\u624B\u982D\u7684\u5B58\u6B3E\\r\\n\u4E00\u4E0A\u5834\u5C31\u6253\u8D0F\uFF0C\u4E5F\u6C92\u4EC0\u9EBC\u610F\u601D\u561B\uFF01[VAR 0114(004A)]",
  "\u7576\u7136\u5C0D\u624B\u4E5F\u6703\u7528\u76F8\u540C\u7684\u689D\u4EF6\u52AA\u529B\u61C9\u6230\uFF0C\\n\u6240\u4EE5[VAR 1100(00FF,0101)]\u4F60\u59B3\u5C31\u914D\u5408\u4E00\u4E0B\u5427\u3002[VAR 0114(004A)]",
  "\u90A3\u597D\uFF0C\u6B7B\u9EE8\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u958B\u59CB\u56DB\u5929\u738B\u6311\u6230\u4E86\u55CE\uFF01\uFF1F[VAR 0114(004A)]",
  "\u8981\uFF01",
  "\u807D\u8AAA\u660E",
  "\u4E0B\u6B21\u518D\u8AAA",
  "\u55EF\uFF01\u90A3\u597D\uFF0C\\n\u5B78\u5F1F\u5B78\u59B9\u5011\uFF5E\u51FA\u4F86\u5427\uFF5E\uFF01[VAR 0114(004A)]",
  "\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u8ACB\u591A\u6307\u6559\uFF01\\n\u591A\u591A\u95DC\u7167\u5594\uFF5E\uFF01\u3000\u3000\u3000\u3000\u3000\u9EBB\u7169\u4E86\u5537\uFF01[VAR 0114(004D)]",
  "\u6211\u7684\u6311\u6230\uFF0C\\n\u5B97\u65E8\u5C31\u662F\u60A0\uFF5E\u60A0\u54C9\u54C9\u3002[VAR 0114(004A)]",
  "\u60F3\u7ACB\u523B\u958B\u59CB\u5C0D\u6230\\n\u4E5F\u6C92\u554F\u984C\uFF01[VAR 0114(004A)]",
  "\u60F3\u5728\u5DE8\u86CB\u7E5E\u7E5E\uFF0C\\n\u6349\u6349\u5BF6\u53EF\u5922\u4E5F\u884C\uFF01[VAR 0114(004A)]",
  "\u90A3\u597D\uFF0C\u8F15\u9B06\u4F86\u5427\uFF01\\n\u5927\u5BB6\u90FD\u597D\u597D\u52A0\u6CB9\u554A\uFF5E[VAR 0114(004A)]",
  "\u60F3\u7ACB\u523B\u958B\u59CB\u5C0D\u6230\u4E5F\u884C\uFF0C\\n\u60F3\u8F49\u63DB\u5FC3\u60C5\u53BB\u5225\u8655\u6643\u6643\u4E5F\u884C\uFF01\\r\\n\u60A0\uFF5E\u60A0\u54C9\u54C9\u5730\u597D\u597D\u52A0\u6CB9\u554A\uFF5E[VAR 0114(004A)]",
  "\u6211\u6700\u559C\u6B61\u8336\u8272\u7684\u5BF6\u53EF\u5922\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u548C\u6211\u5C0D\u6230\u55CE\uFF1F",
  "\u54CE\u5440\uFF5E[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\\n\u597D\u50CF\u4E0D\u7B26\u5408\u689D\u4EF6\uFF01\\c\\n\u8981\u5728\u751F\u614B\u5DE8\u86CB\uFF01\u81EA\u5DF1\u6349\u5230\u7684\u5BF6\u53EF\u5922\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EA\u80FD\u5E36\u9019\u7A2E\u5BF6\u53EF\u5922\u4F86\u5594\u3002",
  "\u54C7\u5594\uFF5E\uFF01\u591A\u591A\u95DC\u7167\u5594\uFF5E\uFF01",
  "\u5269\u4E0B\u7684\u5C0D\u6230\u4E5F\u597D\u597D\u52AA\u529B\u5427\uFF01\\n\u6211\u6703\u9001\u676F\u8336\u5E6B[VAR 1100(00FF,0101)]\u4F60\u59B3\u52A0\u6CB9\u7684\uFF01",
  "\u6211\u662F\u500B\u51B7\u9177\u7684\u5973\u4EBA\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u505A\u597D\u2026\u2026\u986B\u6296\u7684\u6E96\u5099\u4E86\u55CE\uFF1F",
  "\u54A6\uFF1F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\\n\u597D\u50CF\u4E0D\u7B26\u5408\u689D\u4EF6\u8036\u3002\\c\\n\u5728\u751F\u614B\u5DE8\u86CB\uFF01\u81EA\u5DF1\u6349\u5230\u7684\u5BF6\u53EF\u5922\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EA\u80FD\u5E36\u9019\u7A2E\u5BF6\u53EF\u5922\u4F86\u5594\u3002",
  "\u5475\u5475\u2026\u2026\u8ACB\u591A\u6307\u6559\uFF01",
  "\u5225\u8F38\u7D66\u5BD2\u51B7\uFF0C\u597D\u597D\u52AA\u529B\u5427\u3002\\n\u6211\u6703\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u9001\u4E0A\u51B7\u51B0\u51B0\u7684\u8072\u63F4\u7684\u2026\u2026",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u77E5\u9053\u5947\u6A39\u9019\u500B\u76F4\u64AD\u4E3B\u55CE\uFF1F\\n\u6211\u6703\u7528\u548C\u5979\u4E00\u6A23\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\u5C0D\u6230\u5594\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u597D\u50CF\\n\u4E0D\u7B26\u5408\u689D\u4EF6\u5537\uFF1F\\c\\n\u5728\u751F\u614B\u5DE8\u86CB\uFF01\u81EA\u5DF1\u6349\u5230\u7684\u5BF6\u53EF\u5922\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u53EA\u80FD\u5E36\u9019\u7A2E\u5BF6\u53EF\u5922\u4F86\u554A\uFF01",
  "\u5288\u54E9\uFF0C\u556A\u5566\uFF0C\u9EBB\u7169\u4E86\u5537\uFF01",
  "\u7E7C\u7E8C\u52A0\u6CB9\u5594\uFF01\\n\u6211\u6703\u95DC\u6CE8[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u9165\u9165\u9EBB\u9EBB\u5C0D\u6230\u7684\uFF01",
  "\u5443\uFF0C\u52A0\u4E0A\u525B\u624D\u7684\u5C31\u662F\u4E00\u3001\u4E8C\u3001\u4E09\u2026\u2026[VAR 0114(004A)]",
  "\u54E6\uFF01\u4E0D\u77E5\u4E0D\u89BA\u5730\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5DF2\u7D93\u6253\u8D0F\u6240\u6709\u4EBA\u5566\uFF01[VAR 0114(004A)]",
  "\u4E5F\u5C31\u662F\u8AAA\uFF01\\n\u56DB\u5929\u738B\u6311\u6230\u7D50\u675F\u5566\uFF01[VAR 0114(004A)]",
  "\u90A3\u597D\uFF0C\u5404\u4F4D\u806F\u76DF\u793E\u793E\u54E1\uFF0C\\n\u64A4\u9000\u5427\uFF01\u5FEB\u5FEB\u5FEB\uFF5E\uFF01[VAR 0114(004A)]",
  "\u3000\u3000\u3000\u3000\u3000\u3000\u518D\u898B\uFF01\\n\u8F9B\u82E6\u4E86\uFF5E\uFF01\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u62DC\u62DC\uFF5E\uFF01[VAR 0114(004D)]",
  "\u9019\u4E9B\u50A2\u4F19\u5011\u771F\u662F\u8001\u5BE6\u53C8\u53EF\u611B\u3002[VAR 0114(004A)]",
  "\u56DB\u5929\u738B\u6311\u6230\u8981\u52A0\u6CB9\u5594\uFF01"
