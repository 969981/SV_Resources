[
  "\u5C0F\u751F\u662F\u516B\u6714\uFF0C\u8ACB\u591A\u6307\u6559\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u5149\u9670\u4F3C\u7BAD\uFF01[VAR 0114(0012)]",
  "\u6642\u9593\u6D41\u901D\u5F97\u771F\u5FEB\uFF0C\\n\u9019\u5DF2\u7D93\u662F\u5F8C\u534A\u6BB5\u7684\u6700\u5F8C\u4E00\u5802\u8AB2\u4E86\u3002[VAR 0114(0012)]",
  "\u4ECA\u5929\u5C0F\u751F\u8981\u544A\u8A34\u5404\u4F4D\u7684\\n\u53EF\u80FD\u8207\u7F8E\u8853\u6709\u90A3\u9EBC\u4E00\u9EDE\u8DDD\u96E2\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u4F46\u85DD\u8853\u5B8C\u5168\u6C92\u6709\\n\u7D55\u5C0D\u5FC5\u9808\u5982\u4F55\u7684\u9650\u5236\uFF01[VAR 0114(0012)]",
  "\u6240\u4EE5\u5C0F\u751F\u5C31\u4E0D\u5728\u4E4E\u5730\\n\u7E7C\u7E8C\u8AAA\u4E0B\u53BB\u4E86\u3002[VAR 0114(0012)]",
  "\u5E0C\u671B\u5404\u4F4D\u8A18\u4E0B\u7684\u662F\u9019\uFF12\u9EDE\uFF01\\n\u734E\u7AE0\uFF01\u2026\u2026\u4EE5\u53CA\u8B49\u7AE0\uFF01[VAR 0114(0012)]",
  "\u4E0D\u8AD6\u662F\u734E\u7AE0\u6216\u662F\u8B49\u7AE0\uFF0C\\n\u90FD\u50CF\u662F\u63CF\u8FF0\u90A3\u96BB\u5BF6\u53EF\u5922\u7684\u4E00\u7A2E\u7A31\u865F\u3002[VAR 0114(0012)]",
  "\u734E\u7AE0\u662F\u7576\u5BF6\u53EF\u5922\u52AA\u529B\u9054\u6210\u67D0\u4EF6\u4E8B\uFF0C\\n\u6216\u662F\u7D2F\u7A4D\u67D0\u7A2E\u7D93\u9A57\u6642\u2026\u2026[VAR 0114(0012)]",
  "\u70BA\u4E86\u7D00\u5FF5\u7260\u6240\u9054\u5230\u7684\u6210\u679C\\n\u800C\u6234\u5728\u8EAB\u4E0A\u7684\u6771\u897F\u3002[VAR 0114(0012)]",
  "\u4F8B\u5982\u7576\u5BF6\u53EF\u5922\u8207\u8A13\u7DF4\u5BB6\\n\u8B8A\u5F97\u89AA\u5BC6\u5230\u4E86\u6975\u9EDE\u6642\uFF0C\\r\\n\u7260\u5C31\u80FD\u6234\u4E0A\u597D\u53CB\u734E\u7AE0\u3002[VAR 0114(0012)]",
  "\u597D\u53CB\u734E\u7AE0\u7684\u8A8D\u8B49\u4EBA\\n\u5C31\u5728\u73BB\u74F6\u5E02\u3002[VAR 0114(0012)]",
  "\u53E6\u4E00\u65B9\u9762\uFF0C\u5927\u90E8\u5206\u7684\u8B49\u7AE0\\n\u662F\u5BF6\u53EF\u5922\u5728\u9047\u898B\u8A13\u7DF4\u5BB6\u6642\\r\\n\u5C31\u5DF2\u7D93\u6234\u8457\u7684\u6771\u897F\u3002[VAR 0114(0012)]",
  "\u4F8B\u5982\u6DD8\u6C23\u4E4B\u8B49\uFF0C\\n\u6216\u662F\u6D3B\u529B\u4E4B\u8B49\u7B49\u7B49\uFF0C\\r\\n\u8B49\u7AE0\u5448\u73FE\u51FA\u4E86\u5BF6\u53EF\u5922\u7684\u6027\u60C5\u3002[VAR 0114(0012)]",
  "\u80FD\u5426\u9047\u898B\u6234\u8457\u8B49\u7AE0\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u9019\u5B8C\u5168\u662F\u8981\u9760\u904B\u6C23\uFF01[VAR 0114(0012)]",
  "\u5982\u679C\u80FD\u6355\u6349\u5230\u6234\u8457\u8B49\u7AE0\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u90A3\u662F\u975E\u5E38\u5E78\u904B\u7684\u5594\u3002[VAR 0114(0012)]",
  "\u6B64\u5916\uFF0C\u9084\u6709\u4EE4\u4EBA\u958B\u5FC3\u7684\u5C0F\u6A02\u8DA3\uFF01\\n\u6709\u6234\u8457\u734E\u7AE0\u6216\u8B49\u7AE0\u7684\u5BF6\u53EF\u5922\u7684\u8A71\uFF0C\\r\\n\u9084\u53EF\u4EE5\u505A\u4EC0\u9EBC\u5462\uFF1F\u6709\u4EBA\u77E5\u9053\u55CE\uFF1F[VAR 0114(0012)]",
  "\u4EA4\u63DB\u734E\u7AE0",
  "\u5411\u4EBA\u70AB\u8000",
  "\u6539\u8B8A\u7A31\u547C",
  "\u2026\u2026\u5F88\u53EF\u60DC\uFF0C\u4F46\u734E\u7AE0\u6216\u8B49\u7AE0\\n\u4E0D\u80FD\u9001\u7D66\u5225\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u4E5F\u4E0D\u80FD\u4EA4\u63DB\u3002[VAR 0114(0012)]",
  "\u53EF\u4EE5\u5411\u4EBA\u70AB\u8000\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u7684\u5B8C\u5168\u6C92\u932F\uFF01\\r\\n\u4F46\u53EF\u5225\u9019\u6A23\u6EFF\u8DB3\u4E86\u5594\uFF01[VAR 0114(0012)]",
  "\u771F\u4E0D\u6127\u662F[VAR 0100(0000)]\u540C\u5B78\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u975E\u5E38\u535A\u5B78\u5462\u3002[VAR 0114(0012)]",
  "\u6234\u8457\u734E\u7AE0\u6216\u8B49\u7AE0\u7684\u5BF6\u53EF\u5922\uFF01[VAR 0114(0012)]",
