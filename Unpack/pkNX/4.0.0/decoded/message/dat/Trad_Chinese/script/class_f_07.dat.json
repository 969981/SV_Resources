  "\u5C07\u8B49\u7AE0\u7684\u540D\u5B57\u7576\u4F5C\u7DDA\u7D22\u53BB\u8ABF\u67E5\uFF0C\\n\u8AAA\u4E0D\u5B9A\u4E5F\u53E6\u6709\u4E00\u756A\u98A8\u8DA3\u5462\u3002[VAR 0114(0012)]",
  "\u6700\u5F8C\u4E00\u5802\u8AB2\u4E5F\u5C31\u6B64\u7D50\u675F\u4E86\uFF01[VAR 0114(0012)]",
