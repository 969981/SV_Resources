  "\u5982\u679C\u6234\u8457\u597D\u53CB\u734E\u7AE0\u7684\u8A71\uFF0C\\n\u5C31\u662F\u300C\u4E0A\u5427\uFF01\u646F\u53CB\u5713\u9678\u9BCA\uFF01\u300D\u5462\uFF01\\r\\n\u2026\u2026\u5927\u6982\u5C31\u662F\u9019\u500B\u6A23\u5B50\u3002[VAR 0114(0012)]",
  "\u6B64\u5916\uFF0C\u525B\u624D\u5C0F\u751F\u8AAA\u5230\u5927\u90E8\u5206\u7684\u8B49\u7AE0\\n\u662F\u5BF6\u53EF\u5922\u5728\u9047\u898B\u8A13\u7DF4\u5BB6\u6642\\r\\n\u5C31\u5DF2\u7D93\u6234\u8457\u7684\u6771\u897F\u3002[VAR 0114(0012)]",
  "\u4F46\u6700\u8FD1\u4F3C\u4E4E\u6709\u4E9B\u8B49\u7AE0\u662F\\n\u53EA\u8981\u4ED8\u51FA\u4E00\u5B9A\u7684\u52AA\u529B\u5C31\u80FD\u7372\u5F97\u7684\u3002[VAR 0114(0012)]",
