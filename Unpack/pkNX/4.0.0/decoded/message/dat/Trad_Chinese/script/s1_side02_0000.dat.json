[
  "[~ 18]",
  "\u2026\u2026\u54E6\uFF0C\u600E\u9EBC\u4E86\u600E\u9EBC\u4E86\uFF1F\\n\u6211\u5B8C\u5168\u6C92\u6CE8\u610F\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002[VAR 0114(002C)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u2026\u2026\\n\u55EF\uFF0C\u5C0D\u4E86\u3002\\r\\n\u6211\u4E00\u5B9A\u731C\u5F97\u51FA\u4F86\uFF01[VAR 0114(002C)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u5F9E\u5E15\u5E95\u4E9E\u4F86\u9019\u88E1\\n\u53C3\u52A0\u590F\u4EE4\u71DF\u7684\u540C\u5B78\uFF01[VAR 0114(002C)]",
  "\u731C\u5C0D\u4E86\uFF01",
  "\u59B3\u600E\u9EBC\u6703\u77E5\u9053\uFF1F",
  "\u5475\u5475\u5475\uFF5E\uFF01\\n\u7562\u7ADF\u6751\u5B50\u5C31\u9019\u9EBC\u5C0F\u4E00\u500B\uFF0C\\r\\n\u5F88\u591A\u6D88\u606F\u81EA\u7136\u800C\u7136\u5C31\u6703\u50B3\u5230\u8033\u6735\u88E1\u5566\u3002[VAR 0114(002C)]",
  "\u6211\u53EB\u6C99\u5137\u3002\\n\u662F\u500B\u6709\u9EDE\u5152\u559C\u6B61\u73A9\u76F8\u6A5F\u7684\u65C5\u4EBA\u3002[VAR 0114(0046)]",
  "\u9019\u662F\u6211\u7684\u642D\u6A94\u5361\u8482\u72D7\u3002\\n\u7260\u982D\u4E0A\u7684\u89D2\u5F88\u53EF\u611B\u5C0D\u5427\uFF1F[VAR 0114(0046)]",
  "\u5495\u547C\uFF01",
  "\u96D6\u7136\u4E00\u898B\u9762\u5C31\u8AAA\u9019\u500B\u6709\u9EDE\u4E0D\u597D\u610F\u601D\uFF0C\\n\u4F46\u80FD\u4E0D\u80FD\u8ACB[VAR 1100(00FF,0101)]\u4F60\u59B3\u8B93\u6211\u62CD\u5F35\u7167\u554A\uFF1F[VAR 0114(0046)]",
  "\u540C\u5B78\u554A\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u9EBC\u4E56\u5DE7\u8B93\u4EBA\u5F88\u64D4\u5FC3\u6B38\u3002\\r\\n\u4E0D\u53EF\u4EE5\u9019\u9EBC\u96A8\u4FBF\u5C31\u76F8\u4FE1\u4E0D\u8A8D\u8B58\u7684\u4EBA\u5594\u3002[VAR 0114(0046)]",
  "\u4F46\u7167\u9084\u662F\u8981\u62CD\u7684\u5566\u3002[VAR 0114(0046)]",
  "\u5C0D\u7B2C\u4E00\u6B21\u898B\u9762\u7684\u4EBA\\n\u4FDD\u6301\u9069\u7576\u7684\u8B66\u6212\uFF01\\r\\n\u540C\u5B78[VAR 1100(00FF,0101)]\u4F60\u59B3\u5F88\u61C2\u4E8B\u5594\uFF01[VAR 0114(0046)]",
  "\u611F\u89BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u9019\u500B\u4EBA\\n\u5F88\u7279\u5225\u53C8\u5F88\u6709\u8DA3\u5462\u3002[VAR 0114(0046)]",
  "\u6211\u66AB\u6642\u6703\u628A\u9019\u500B\u6751\u5B50\\n\u7576\u6210\u64DA\u9EDE\u4F86\u6D3B\u52D5\u3002[VAR 0114(0046)]",
  "\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u628A\u8A72\u505A\u7684\u4E8B\u60C5\u505A\u5B8C\u4E86\uFF0C\\n\u53EF\u8981\u518D\u4F86\u627E\u6211\u5594\u3002\\c\\n\u8B6C\u5982\u6536\u96C6\u5B8C\uFF11\uFF15\uFF10\u96BB\\n\u5317\u4E0A\u5716\u9451\u7684\u5BF6\u53EF\u5922\u4E4B\u985E\u7684\uFF01[VAR 0114(0046)]",
  "\u540C\u5B78\u554A\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u61C9\u8A72\\n\u9084\u6709\u4E8B\u60C5\u8A72\u53BB\u505A\u5427\uFF1F\\c\\n\u8B6C\u5982\u6536\u96C6\u5B8C\uFF11\uFF15\uFF10\u96BB\\n\u5317\u4E0A\u5716\u9451\u7684\u5BF6\u53EF\u5922\u4E4B\u985E\u7684\uFF01\\r\\n\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u5B8C\u6210\u4E86\u518D\u4F86\u627E\u6211\u5427\u3002\\c\\n\u6642\u9593\u53EF\u662F\u5F88\u5BF6\u8CB4\u7684\u5594\uFF5E\uFF1F\\n\u7562\u7ADFtime is money\u561B\uFF01[VAR 0114(0046)]"
]
