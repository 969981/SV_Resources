  "\u6240\u4EE5\uFF0C\u5982\u679C\u5927\u5BB6\u80FD\u5C0D\u5B75\u86CB\u8CA0\u8CAC\u4EFB\uFF01\\n\u5409\u5C3C\u4E9E\u8001\u5E2B\u6211\u6703\u5F88\u9AD8\u8208\u7684\uFF5E[VAR 0114(002A)]",
  "\u6211\u8AAA\u4E86\u5F88\u91CD\u8981\u7684\u4E8B\u60C5\uFF0C\\n\u7D50\u679C\u7ADF\u7136\u548C\u9418\u8072\u91CD\u758A\u4E86\u3002\\r\\n\u2026\u2026\u671F\u5F85\u548C\u5927\u5BB6\u4E0B\u4E00\u5802\u8AB2\u898B\u5594\uFF5E[VAR 0114(002A)]",
