[
  "\u5927\u5BB6\u597D\u554A\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u5011\u958B\u59CB\u4E0A\u8AB2\u5427\uFF5E[VAR 0114(002A)]",
  "\u4E0A\u4E00\u5802\u8AB2\u6559\u7684\\n\u300C\uFF3A\uFF32\u9375\u6295\u7403\uFF01\u300D\uFF0C\\r\\n\u5927\u5BB6\u6709\u6C92\u6709\u8A66\u8A66\u770B\u5440\uFF5E\uFF1F[VAR 0114(002A)]",
  "\u548C\u5BF6\u53EF\u5922\u4E00\u8D77\u8D70\u5C31\u80FD\u767C\u73FE\\n\u7260\u5011\u8C50\u5BCC\u7684\u500B\u6027\uFF0C\u5F88\u53EF\u611B\u5462\u3002[VAR 0114(002A)]",
  "\u60F3\u8981\u548C\u6BCF\u4E00\u96BB\u540C\u884C\u5BF6\u53EF\u5922\\n\u90FD\u4E92\u52D5\u7684\u6642\u5019\uFF0C\\r\\n\u91CE\u9910\u4E5F\u662F\u500B\u503C\u5F97\u63A8\u85A6\u7684\u65B9\u6CD5\u5594\u3002[VAR 0114(002A)]",
  "\u53EF\u4EE5\u5927\u5BB6\u570D\u8457\u684C\u5B50\u4E00\u8D77\u505A\u4E09\u660E\u6CBB\uFF0C\\n\u4E5F\u53EF\u4EE5\u548C\u5BF6\u53EF\u5922\u73A9\u3002\\r\\n\u7C21\u76F4\u662F\u6A02\u8DA3\u4E00\u7C6E\u7B50\u3002[VAR 0114(002A)]",
  "\u95DC\u65BC\u6599\u7406\u7684\u4E8B\uFF0C\u53EF\u4EE5\u5728\\n\u85A9\u74E6\u7F85\u8001\u5E2B\u7684\u8AB2\u5802\u5B78\u5230\u5594\uFF5E[VAR 0114(002A)]",
  "\u9084\u6709\uFF0C\u91CE\u9910\u6642\\n\u5076\uFF5E\u723E\u6703\u5F9E\u653E\u5728\u684C\u5B50\u65C1\u7684\\r\\n\u91CE\u9910\u7C43\u88E1\u9762\u2026\u2026[VAR 0114(002A)]",
  "\u767C\u73FE\u5F88\uFF5E\u91CD\u8981\u7684\u90A3\u500B\u5462\uFF01[VAR 0114(002A)]",
  "\u5C31\u662F\u6703\u8A95\u751F\u51FA\u5BF6\u53EF\u5922\u7684\u91CD\u8981\u7684\u90A3\u500B\uFF01\\n\u5927\u5BB6\u4E00\u8D77\u56DE\u7B54\u5427\u2026\u2026\u4E00\u3001\u4E8C\uFF5E\u4E09\uFF01[VAR 0114(002A)]",
  "\u76D2\u5B50\uFF01",
  "\u7CBE\u9748\u7403\uFF01",
  "\u86CB\uFF01",
  "\u2026\u2026\u54CE\u5440\u5440\uFF1F\\n\u53EA\u6709[VAR 0100(0000)]\u8AAA\u662F\u76D2\u5B50\u55CE\uFF1F\\c\\n\u76D2\u5B50\u662F\u7528\u4F86\u5BC4\u653E\u5BF6\u53EF\u5922\u7684\u3002\\n\u548C\u7260\u5011\u8A95\u751F\u7684\u6771\u897F\u4E0D\u592A\u4E00\u6A23\u5594\uFF1F[VAR 0114(002A)]",
  "\u2026\u2026\u54CE\u5440\u5440\uFF1F\\n\u53EA\u6709[VAR 0100(0000)]\u8AAA\u662F\u7CBE\u9748\u7403\u55CE\uFF1F\\c\\n\u76EE\u524D\u9084\u6C92\u6709\u4EBA\u78BA\u8A8D\u5230\\n\u5F9E\u7403\u8A95\u751F\u7684\u5BF6\u53EF\u5922\u5462\uFF5E[VAR 0114(002A)]",
  "\u592A\u597D\u4E86\uFF5E\uFF01\\n\u5927\u5BB6\u90FD\u7B54\u5C0D\u4E86\uFF01[VAR 0114(002A)]",
  "\u6C92\u932F\uFF0C\u91CD\u8981\u7684\u90A3\u500B\\n\u5C31\u662F\u5BF6\u53EF\u5922\u7684\u86CB\u5594\uFF5E[VAR 0114(002A)]",
  "\u96D6\u7136\u4E0D\u77E5\u9053\u86CB\u662F\u5F9E\u54EA\u88E1\u4F86\u7684\uFF0C\\n\u4F46\u5927\u6982\u662F\u91CE\u9910\u6642\u5728\u5834\u7684\u5BF6\u53EF\u5922\\r\\n\u5077\u5077\u653E\u9032\u91CE\u9910\u7C43\u88E1\u7684\u5427\uFF5E[VAR 0114(002A)]",
  "\u900F\u904E\u8D70\u8DEF\u5C31\u80FD\u7DAD\u6301\u5B75\u86CB\u7684\u6EAB\u5EA6\uFF0C\\n\u4E45\u800C\u4E45\u4E4B\u5C31\u6703\u5B75\u51FA\u5BF6\u53EF\u5922\u4F86\u5594\u3002[VAR 0114(002A)]",
  "\u76D2\u5B50\u88E1\u7684\u6EAB\u5EA6\u4E0D\u5920\u8B93\u86CB\u5B75\u5316\uFF0C\\n\u8A18\u5F97\u8981\u628A\u5B83\u653E\u5728\u540C\u884C\u7684\u968A\u4F0D\u88E1\u8D70\u8DEF\u5594\uFF5E[VAR 0114(002A)]",
  "\u2026\u2026\u6709\u4EF6\u5F88\uFF5E\u91CD\u8981\u7684\u4E8B\u60C5\\n\u6211\u4E00\u5B9A\u8981\u544A\u8A34\u5927\u5BB6\u3002[VAR 0114(002A)]",
