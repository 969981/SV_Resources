[
  "\u80FD\u8B93\u6211\u770B\u770B[VAR 1100(00FF,0101)]\u4F60\u59B3\u548C\\n\u5BF6\u53EF\u5922\u6709\u591A\u53CB\u597D\u55CE\uFF1F",
