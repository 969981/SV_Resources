  "\u4F60\u5011\u662F\u600E\u9EBC\u56DE\u4E8B\uFF01\uFF1F\\n\u7ADF\u7136\u4E00\u9EDE\u90FD\u4E0D\u53CB\u597D\u8036\u2026\u2026",
  "\u4F5C\u70BA\u53CB\u597D\u7684\u8B49\u660E\uFF01\\n\u6211\u7D66\u7260\u500B\u597D\u6771\u897F\uFF01",
  "[VAR 0102(0001)]\\n\u7372\u5F97\u4E86\u597D\u53CB\u734E\u7AE0\uFF01",
