  "\u9326\u532F\u9053\u9928\u7684\\n\u9053\u9928\u6E2C\u9A57\u662F\u2026\u2026\\r\\n[VAR FF00(0006)]\u9EDE\u4E00\u9053\u79D8\u5BC6\u83DC\u55AE[VAR FF00(0000)]\uFF01",
  "\u53CA\u683C\u689D\u4EF6\u662F\u5728\u9326\u532F\u93AE\u7684\\n\u8D85\u4EBA\u6C23\u9910\u9928[VAR FF00(0006)]\u5BF6\u98DF\u5802[VAR FF00(0000)]\uFF0C\\r\\n\u9EDE\u51FA\u4ED6\u5011\u7684\u79D8\u5BC6\u83DC\u55AE\u3002",
  "\u76EE\u524D\u9664\u4E86[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E4B\u5916\uFF0C\\n\u5728\u9019\u500B\u93AE\u4E0A\u9084\u6709\uFF13\u4F4D\\r\\n\u9053\u9928\u6E2C\u9A57\u7684\u6311\u6230\u8005\u3002",
