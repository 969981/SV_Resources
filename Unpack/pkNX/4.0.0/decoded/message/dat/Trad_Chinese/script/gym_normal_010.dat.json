  "\u6B61\u8FCE\u5149\u81E8\u9326\u532F\u9053\u9928\uFF01",
  "\u8ACB\u8B93\u6211\u767B\u8A18\\n\u6311\u6230\u8005\u7684\u540D\u5B57\u2026\u2026\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F[VAR 0100(0000)]\uFF0C\u5C0D\u5427\uFF01",
