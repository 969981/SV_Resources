[
  "\u5927\u5BB6\u597D\u554A\uFF5E\u5927\u5BB6\u597D\u3002\\n\u6211\u5011\u958B\u59CB\u4E0A\u8AB2\u5427\uFF5E[VAR 0114(002A)]",
  "\u5C0D\u4E86\uFF0C\u671F\u4E2D\u8003\u90A3\u984C\\n\u5077\u5077\u8ACB\u5927\u5BB6\u586B\u5BEB\u7684\u610F\u898B\u8ABF\u67E5\u2026\u2026[VAR 0114(002A)]",
  "\u4E0D\u77E5\u600E\u9EBC\u5730\u88AB\u514B\u62C9\u97CB\u723E\u6821\u9577\u767C\u73FE\u4E86\uFF0C\\n\u65BC\u662F\u6211\u5C31\u6328\u7F75\u4E86\uFF5E[VAR 0114(002A)]",
  "\u6821\u9577\u8AAA\u4ED6\u4E00\u770B\u6211\u7684\u81C9\u8272\uFF0C\\n\u5C31\u77E5\u9053\u6211\u6709\u4E8B\u60C5\u779E\u8457\u4ED6\u3002[VAR 0114(002A)]",
  "\u6211\u7684\u81C9\u8272\u771F\u7684\\n\u548C\u5E73\u5E38\u5DEE\u90A3\u9EBC\u591A\u55CE\u2026\u2026\uFF1F[VAR 0114(002A)]",
  "\u81C9\u8272\u2026\u2026\u9AD4\u8272\u2026\u2026\\n\u6C92\u932F\uFF0C\u4ECA\u5929\u6211\u8981\u6559\u7684\u662F\\r\\n\u5BF6\u53EF\u5922\u7684\u9AD4\u8272\u3002[VAR 0114(002A)]",
  "\u5BF6\u53EF\u5922\u4E2D\u6709\u4E9B\u7A2E\u985E\\n\u6703\u4F9D\u7167\u6027\u5225\u3001\u500B\u9AD4\u4E0D\u540C\uFF0C\\r\\n\u800C\u6709\u4E0D\u540C\u7684\u9AD4\u8272\u6216\u82B1\u7D0B\u3002[VAR 0114(002A)]",
  "\u5728\u6975\u70BA\u7F55\u898B\u7684\u60C5\u6CC1\u4E0B\uFF0C\\n\u5BF6\u53EF\u5922\u6703\u8A95\u751F\u51FA\u64C1\u6709\u8A31\u591A\\r\\n\u8207\u5176\u4ED6\u500B\u9AD4\u4E0D\u540C\u8272\u7D20\u7684\u500B\u9AD4\uFF5E[VAR 0114(002A)]",
  "\u9019\u5C31\u662F\u88AB\u7A31\u70BA[VAR FF00(0006)]\u7570\u8272[VAR FF00(0000)]\u7684\u5BF6\u53EF\u5922\u3002[VAR 0114(002A)]",
  "\u80FD\u9047\u898B\u7260\u5011\u662F\u4E00\u4EF6\\n\u975E\u5E38\u7A00\u6709\u7684\u9AD4\u9A57\u5594\uFF5E[VAR 0114(002A)]",
  "\u90A3\u9EBC\uFF0C\u7570\u8272\u5BF6\u53EF\u5922\\n\u5B58\u5728\u7684\u6A5F\u7387\u662F\u591A\u5C11\u5462\uFF1F\\r\\n\u6709\u6C92\u6709\u4EBA\u77E5\u9053\u5440\uFF5E\uFF1F[VAR 0114(002A)]",
  "\uFF14\uFF10\u5206\u4E4B\uFF11",
  "\uFF14\uFF10\uFF10\u5206\u4E4B\uFF11",
  "\uFF14\uFF10\uFF10\uFF10\u5206\u4E4B\uFF11",
  "\u8981\u662F\uFF14\uFF10\u96BB\u88E1\u6709\u500B\uFF11\u96BB\uFF0C\\n\u6211\u5C31\u80FD\u70BA\u7814\u7A76\u7684\u9032\u5C55\u62CD\u624B\u6B61\u547C\u56C9\u3002\\r\\n\u4F46\u5176\u5BE6\u7260\u5011\u66F4\uFF5E\u7A00\u6709\u5594\u3002[VAR 0114(002A)]",
  "\u54E6\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u633A\u654F\u92B3\u7684\u5462\uFF5E\\n\uFF14\uFF10\uFF10\u96BB\u88E1\u6709\uFF11\u96BB\u4E5F\u5F88\u8CB4\u91CD\u4E86\uFF0C\\r\\n\u4F46\u5176\u5BE6\u7260\u5011\u9084\u8981\u518D\u66F4\u7A00\u6709\u4E00\u4E9B\u3002[VAR 0114(002A)]",
  "\u54C7\uFF01\u6B63\u78BA\u7B54\u6848\uFF01\\n[VAR 0100(0000)][VAR 1100(00FF,0101)]\u4F60\u59B3\u5C07\u4F86\u8AAA\u4E0D\u5B9A\\r\\n\u80FD\u7576\u4E0A\u5BF6\u53EF\u5922\u535A\u58EB\u5594\uFF5E[VAR 0114(002A)]",
  "\u9A5A\u4EBA\u5427\uFF01\u51FA\u73FE\u7570\u8272\u5BF6\u53EF\u5922\u7684\\n\u6A5F\u7387\u662F\uFF14\uFF10\uFF10\uFF10\u5206\u4E4B\uFF11\u5462\uFF01[VAR 0114(002A)]",
  "\u4E0D\u8AD6\u662F\u91CE\u751F\u7684\u5BF6\u53EF\u5922\uFF0C\\n\u9084\u662F\u5F9E\u86CB\u88E1\u5B75\u51FA\u4F86\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u9019\u500B\u6A5F\u7387\u90FD\u662F\u4E00\u6A23\u7684\u5594\uFF5E[VAR 0114(002A)]",
  "\u4E0D\u904E\uFF0C\u5982\u679C\u662F\u5169\u96BB\u5728\u4E0D\u540C\u8A9E\u8A00\u7684\\n\u5730\u5340\u9577\u5927\u7684\u5BF6\u53EF\u5922\u4E4B\u9593\u6709\u4E86\u86CB\u3002[VAR 0114(002A)]",
  "\u5F9E\u9019\u9846\u86CB\u5B75\u51FA\u7570\u8272\u5BF6\u53EF\u5922\u7684\u6A5F\u7387\\n\u5C31\u6703\u6BD4\u4E00\u822C\u9084\u8981\u9AD8\u3002[VAR 0114(002A)]",
  "\u4F46\u81F3\u4ECA\u6211\u5011\u9084\u7121\u6CD5\u89E3\u91CB\\n\u70BA\u4EC0\u9EBC\u6703\u9019\u6A23\u5C31\u662F\u4E86\uFF5E[VAR 0114(002A)]",
  "\u6B64\u5916\uFF0C\u4E0D\u77E5\u9053\u662F\u771F\u662F\u5047\uFF0C\\n\u64DA\u8AAA\u9084\u6709\u7A2E\u8B77\u7B26\uFF0C\u53EA\u8981\u5E36\u5728\u8EAB\u4E0A\\r\\n\u5C31\u6703\u66F4\u5BB9\u6613\u9047\u898B\u7570\u8272\u7684\u5BF6\u53EF\u5922\u2026\u2026[VAR 0114(002A)]",
  "\u96D6\u7136\u5F88\u4E0D\u79D1\u5B78\uFF0C\u4F46\u8981\u662F\\n\u771F\u7684\u6709\u9019\u7A2E\u6771\u897F\u4E5F\u5F88\u6709\u8DA3\u5462\uFF5E[VAR 0114(002A)]",
  "\u2026\u2026\u554A\uFF0C\u4E0B\u8AB2\u9418\u97FF\u4E86\u3002[VAR 0114(002A)]",
  "\u4ECA\u5929\u5C31\u5230\u6B64\u70BA\u6B62\u3002\\n\u4E0B\u8AB2\u56C9\uFF5E[VAR 0114(002A)]"
]
