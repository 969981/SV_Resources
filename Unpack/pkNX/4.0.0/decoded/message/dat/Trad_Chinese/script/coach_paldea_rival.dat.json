  "\u592A\u597D\u4E86\uFF01\u5C31\u9019\u9EBC\u6C7A\u5B9A\u4E86\uFF01\\n\u6211\u5011\u4F86\u6253\u4E00\u5834\u6536\u7A6B\u591A\u591A\u7684\u5C0D\u6230\u5427\uFF01[VAR 0114(0004)]",
  "[~ 62]",
  "\u9019\u6B21\u662F\u6211\u8F38\u4E86\uFF01\\n\u554A\uFF5E\u6253\u5F97\u771F\u958B\u5FC3\uFF01[VAR 0114(0004)]",
