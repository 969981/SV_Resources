  "\u96D6\u7136\u6211\u5F88\u60F3\u7ACB\u523B\u5C31\u548C\\n\u85CD\u8393\u806F\u76DF\u7684\u51A0\u8ECD\u6253\u4E00\u5834\uFF0C\u4F46\u662F\u2026\u2026[VAR 0114(0004)]",
  "\u66F4\u91CD\u8981\u7684\u662F\uFF0C\u770B\u5230\u6211\u7684\u52C1\u6575\u5728\u5404\u5730\\n\u5927\u986F\u8EAB\u624B\uFF0C\u6211\u771F\u7684\u597D\u9AD8\u8208\u5594\uFF5E\uFF01[VAR 0114(0004)]",
