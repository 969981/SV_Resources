  "\u521D\u8A13\u5BB6\u4E0D\u662F\u81EA\u5DF1\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
  "\u7A00\u6709\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
  "\u7570\u8272\u7684\u5BF6\u53EF\u5922\\n\u7121\u6CD5\u7528\u4F86\u4EA4\u63DB\u3002",
  "\u53EA\u6709\uFF11\u96BB\u5BF6\u53EF\u5922\u7684\u8A71\uFF0C\\n\u4EA4\u63DB\u4E4B\u5F8C\u6703\u6709\u9EDE\u5371\u96AA\u5462\uFF01\\c\\n\u6211\u60F3\u9084\u662F\u5728\u540C\u884C\u5BF6\u53EF\u5922\u6709\\n\uFF12\u96BB\u4EE5\u4E0A\u7684\u6642\u5019\u518D\u4EA4\u63DB\u6BD4\u8F03\u597D\uFF01[VAR 0114(0004)]",
