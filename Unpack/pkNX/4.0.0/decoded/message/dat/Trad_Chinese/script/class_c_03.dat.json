[
  "\u55E8\uFF0C\u540C\u5B78\u5011\uFF0C\\n\u4F60\u5011\u53C8\u6BD4\u6628\u5929\u53E4\u8001\u4E00\u5929\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u4E5F\u8B93\u6211\u5011\u4E00\u8D77\u89E3\u958B\\n\u6B77\u53F2\u7684\u7F8E\u5999\u4E4B\u8655\u5427\u3002[VAR 0114(0027)]",
  "\u5982\u540C\u6211\u5728\u4E0A\u4E00\u5802\u8AB2\u6240\u6559\u7684\uFF0C\\n\u5927\u7D04\u5F9E\uFF12\uFF10\uFF10\uFF10\u5E74\u524D\u8D77\uFF0C\\r\\n\u7B2C\u96F6\u5340\u6F2B\u9577\u7684\u5927\u63A2\u7D22\u6642\u4EE3\u958B\u59CB\u4E86\uFF01[VAR 0114(0027)]",
  "\u5927\u63A2\u7D22\u6301\u7E8C\u4E86\u5927\u7D04\uFF11\uFF10\uFF10\uFF10\u5E74\u7684\u6642\u9593\uFF0C\\n\u4F46\u537B\u6C92\u6709\u4EFB\u4F55\u4EBA\u80FD\u5920\u62B5\u9054\\r\\n\u7B2C\u96F6\u5340\u7684\u6700\u6DF1\u8655\u3002[VAR 0114(0027)]",
  "\u7531\u65BC\u9577\u6642\u9593\u50BE\u6CE8\\n\u4EBA\u529B\u3001\u8CA1\u529B\u5728\u63A2\u7D22\u7B2C\u96F6\u5340\uFF0C\\r\\n\u5E15\u5E95\u4E9E\u5E1D\u570B\u9010\u6F38\u5931\u53BB\u4E86\u529B\u91CF\u3002[VAR 0114(0027)]",
  "\u5728\u904E\u4E86\uFF12\uFF10\uFF10\u5E74\u5F8C\u2026\u2026\\n\u4E5F\u5C31\u662F\u8DDD\u4ECA\uFF18\uFF10\uFF10\u5E74\u524D\u3002\\c\\n\u5E1D\u570B\u8207\u5468\u908A\u7684\u570B\u5BB6\u7D71\u5408\u5728\u4E00\u8D77\uFF0C\\n\u6210\u70BA\u4E86\u4ECA\u65E5\u7684\u5E15\u5E95\u4E9E\u3002[VAR 0114(0027)]",
  "\u554A\uFF0C\u5C0D\u4E86\u5C0D\u4E86\uFF0C\\n\u4F60\u5011\u5C31\u8B80\u7684\u9019\u6240\u5B78\u6821\uFF0C\\r\\n\u64DA\u8AAA\u4E5F\u662F\u5728\u90A3\u6642\u671F\u6240\u5275\u5EFA\u7684\u3002[VAR 0114(0027)]",
  "\u96D6\u7136\u9019\u68DF\u6821\u820D\u6B77\u7D93\u4E86\u5404\u7A2E\u7DAD\u4FEE\uFF0C\\n\u4F46\u4ECD\u7136\u7DAD\u6301\u8457\u5275\u5EFA\u6642\u7684\u539F\u8C8C\uFF0C\\r\\n\u81F3\u4ECA\u6301\u7E8C\u70BA\u5927\u5BB6\u6240\u7528\u3002[VAR 0114(0027)]",
  "\u80FD\u5920\u611F\u53D7\u5230\u6B77\u53F2\u7684\u5EFA\u7BC9\u7269\u2026\u2026\\n\u554A\u554A\u2026\u2026\u53E4\u8001\u771F\u662F\u7F8E\u5999\u554A\uFF01\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u4E0D\u904E\uFF0C\u90A3\u500B\u6700\u8FD1\u5B8C\u6210\u7684\\n\u7CBE\u9748\u7403\u90E8\u5206\u8B93\u6211\u975E\u5E38\u4E0D\u6EFF\u5C31\u662F\u4E86\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u90A3\u9EBC\uFF0C\u8ACB\u9019\u6642\u4E0D\u5E78\u8207\u6211\\n\u5C0D\u4E0A\u773C\u7684[VAR 0100(0000)]\u4F86\u56DE\u7B54\u3002[VAR 0114(0027)]",
  "\u4E0D\u77E5\u9053[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u6C92\u6709\u597D\u597D\u807D\u8AB2\uFF1F\\n\u8ACB\u554F\u9019\u6240\u5B78\u6821\u662F\u5728\u5927\u7D04\u5E7E\u5E74\u524D\\r\\n\u88AB\u5275\u5EFA\u7684\u5462\uFF1F[VAR 0114(0027)]",
  "\u5927\u7D04\uFF16\uFF10\uFF10\u5E74\u524D",
  "\u5927\u7D04\uFF17\uFF10\uFF10\u5E74\u524D",
  "\u5927\u7D04\uFF18\uFF10\uFF10\u5E74\u524D",
  "\u2026\u2026\u932F\u8AA4\uFF01\\n\u8DB3\u8DB3\u5C11\u4E86\uFF12\uFF10\uFF10\u5E74\u4EFD\u7684\u53E4\u8001\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u932F\u8AA4\uFF01\\n\u8DB3\u8DB3\u5C11\u4E86\uFF11\uFF10\uFF10\u5E74\u4EFD\u7684\u53E4\u8001\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u6B63\u78BA\u7B54\u6848\uFF01\\n\u771F\u662F\u4E86\u4E0D\u8D77\u7684\u6CE8\u610F\u529B\u3002\\r\\n\u770B\u4F86[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u662F\u5047\u88DD\u5728\u807D\u8AB2\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u6B63\u78BA\u4F86\u8AAA\uFF0C\\n\u9019\u6240\u5B78\u6821\u662F\u5728\uFF18\uFF10\uFF15\u5E74\u524D\u5275\u5EFA\u3002\\r\\n\u4E5F\u5C31\u662F\u8AAA\u5B83\u5DF2\u7D93\u8FCE\u63A5\uFF18\uFF10\uFF15\u9031\u5E74\u4E86\u3002[VAR 0114(0027)]",
  "\u7576\u6642\u5728\u9019\u88E1\u80FD\u4F7F\u7528\u6700\u65B0\u7A4E\u7684\u8A2D\u5099\uFF0C\\n\u63A5\u53D7\u6700\u5148\u9032\u7684\u6559\u80B2\uFF0C\u56E0\u6B64\u6709\u6B64\u4E00\u8AAA\u2026\u2026[VAR 0114(0027)]",
  "\u300C\u6B32\u7AAE\u667A\u6167\uFF0C\u5148\u98DF\u6A58\u5B50\u300D\u3002[VAR 0114(0027)]",
  "\u300C\u6B32\u7AAE\u667A\u6167\uFF0C\u5148\u98DF\u8461\u8404\u300D\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u64DA\u8AAA\u9019\u53E5\u8A71\u751A\u81F3\\n\u6D41\u50B3\u5230\u4E86\u5E15\u5E95\u4E9E\u4E4B\u5916\u7684\u5730\u5340\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u54CE\u5440\uFF1F\u6211\u592A\u591A\u8A71\u4E86\uFF0C\\n\u6642\u9418\u5DF2\u7D93\u8D70\u904E\u982D\u4E86\u3002[VAR 0114(0027)]",
  "\u4ECA\u5929\u7684\u8AB2\u5C31\u5230\u6B64\u70BA\u6B62\u3002\\n\u4E0B\u6B21\u5C31\u662F\u671F\u4E2D\u8003\u4E86\u3002\\r\\n\u5404\u81EA\u597D\u597D\u559A\u9192\u53E4\u8001\u7684\u77E5\u8B58\u5427\u3002[VAR 0114(0027)]"
