[
  "\u5C0F\u751F\u662F\u516B\u6714\uFF0C\u8ACB\u591A\u6307\u6559\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u611F\u8B1D\u5927\u5BB6\u5C0D\u4E0A\u4E00\u5802\\n\u592A\u6676\u5316\u8AB2\u7A0B\u7684\u597D\u8A55\u3002[VAR 0114(0012)]",
  "\u51F0\u6A97\u8001\u5E2B\u4E5F\u5E0C\u671B\u9019\u5802\u8AB2\u80FD\\n\u7D66\u540C\u5B78\u5011\u5E36\u4F86\u66F4\u591A\u7684\u5C0D\u6230\u77E5\u8B58\uFF01\\r\\n\u2026\u2026\u9019\u662F\u5979\u89AA\u81EA\u62DC\u8A17\u5C0F\u751F\u7684\u3002[VAR 0114(0012)]",
  "\u56E0\u6B64\uFF0C\u7F8E\u8853\u8001\u5E2B\u516B\u6714\u6211\uFF0C\\n\u4ECA\u5929\u4E5F\u8981\u7E7C\u7E8C\u8B1B\u592A\u6676\u5316\u7684\u4E8B\u56C9\u3002[VAR 0114(0012)]",
  "\u5713\u5713\u5695\u3002",
  "\u7576\u7136\uFF0C\u5713\u9678\u9BCA\u524D\u8F29\u4E5F\u5728\u3002[VAR 0114(0012)]",
  "\u5713\u9678\u9BCA\u524D\u8F29\uFF0C\u8ACB\u592A\u6676\u5316\uFF01[VAR 0114(0012)]",
  "\u5713\u5660\uFF5E\uFF01",
  "\u54CE\u5440\uFF1F\\n\u4E0A\u6B21\u662F\u8349\u5C6C\u6027\u7684\u592A\u6676\uFF0C\\r\\n\u4F46\u9019\u6B21\u5F62\u72C0\u4E0D\u540C\u4E86\u662F\u4E5F\u3002[VAR 0114(0012)]",
  "\u9019\u592A\u6676\u5BF6\u77F3\u770B\u8D77\u4F86\u5C31\u50CF\u662F\u96EA\u82B1\uFF0C\\n\u6A39\u679D\u72C0\u7684\u9020\u578B\u771F\u662F\u7F8E\u554A\u3002[VAR 0114(0012)]",
  "\u9760\u8FD1\u6642\u53EF\u4EE5\u611F\u53D7\u5230\\n\u6DBC\u6DBC\u7684\u5BD2\u6C23\u5462\u3002[VAR 0114(0012)]",
  "\u4F86\uFF0C\u8ACB\u554F\u9019\u662F\u4EC0\u9EBC\u592A\u6676\u5C6C\u6027\u5462\uFF1F[VAR 0114(0012)]",
  "\u6C34\u5C6C\u6027",
  "\u51B0\u5C6C\u6027",
  "\u5E7D\u9748\u5C6C\u6027",
  "[VAR 0100(0000)]\u540C\u5B78\uFF0C\u771F\u53EF\u60DC\uFF01\\n\u9019\u662F\u6C34\u6539\u8B8A\u72C0\u614B\u5F8C\u7684\u5C6C\u6027\u5594\u3002[VAR 0114(0012)]",
  "[VAR 0100(0000)]\u540C\u5B78\uFF01\\n\u4E00\u767E\u5206\u6EFF\u5206\uFF01[VAR 0114(0012)]",
  "[VAR 0100(0000)]\u540C\u5B78\uFF0C\u771F\u53EF\u60DC\uFF01\\n\u7684\u78BA\u90FD\u6703\u8B93\u4EBA\u6DBC\u6DBC\u7684\u662F\u4E5F\uFF01[VAR 0114(0012)]",
  "\u7B54\u6848\u63ED\u66C9\u3002\u5713\u9678\u9BCA\u524D\u8F29\u7684\u982D\u4E0A\\n\u4E4B\u6240\u4EE5\u6703\u9583\u8000\u8457\u96EA\u82B1\u7D50\u6676\uFF0C\\r\\n\u662F\u56E0\u70BA\u7260\u8B8A\u6210\u4E86\u51B0\u5C6C\u6027\u3002[VAR 0114(0012)]",
  "\u7531\u65BC\u5713\u9678\u9BCA\u524D\u8F29\u73FE\u5728\u662F\u51B0\u5C6C\u6027\u2026\u2026[VAR 0114(0012)]",
  "\u5E73\u6642\u6703\u5C0D\u7260\u9020\u6210\uFF14\u500D\u50B7\u5BB3\u7684\u51B0\u5C6C\u6027\u62DB\u5F0F\uFF0C\\n\u73FE\u5728\u5C0D\u7260\u6703\u662F\u6548\u679C\u4E0D\u597D\u7684\u5462\u3002[VAR 0114(0012)]",
  "\u5C0D\u4E86\uFF0C\u8AAA\u5230\u96EA\u82B1\u7D50\u6676\uFF0C\\n\u96D6\u7136\u5B83\u6709\u5F88\u591A\u7A2E\u5F62\u72C0\uFF0C\\r\\n\u4F46\u5E7E\u4E4E\u90FD\u53EF\u4EE5\u88AB\u6B78\u985E\u70BA\u516D\u89D2\u5F62\u3002[VAR 0114(0012)]",
  "\u4E26\u6C92\u6709\u4EBA\u8A2D\u4E0B\u898F\u5B9A\uFF0C\u4F46\u96EA\u82B1\u537B\u6703\\n\u4EE5\u540C\u6A23\u7684\u5F62\u72C0\u5728\u51AC\u5929\u7FE9\u7FE9\u843D\u4E0B\u3002[VAR 0114(0012)]",
  "\u5404\u4F4D\u540C\u5B78\u662F\u4E0D\u662F\u4E5F\u80FD\\n\u611F\u53D7\u5230\u5927\u81EA\u7136\u7684\u795E\u79D8\u5462\uFF1F[VAR 0114(0012)]",
  "\u2026\u2026\u54B3\u54B3\uFF01\\c\\n\u96D6\u7136\u6C92\u4EC0\u9EBC\u95DC\u9023\u6027\uFF0C\\n\u4F46\u5409\u5C3C\u4E9E\u8001\u5E2B\u7684\u773C\u93E1\u4E5F\u662F\u516D\u89D2\u5F62\u7684\u5462\u3002[VAR 0114(0012)]",
  "\u53E6\u5916\uFF0C\u5DEE\u9EDE\u5FD8\u8A18\u544A\u8A34\u5404\u4F4D\u4E86\u3002\\n\u5982\u679C\u60F3\u6539\u8B8A\u5BF6\u53EF\u5922\u7684\u592A\u6676\u5C6C\u6027\uFF0C\\r\\n\u53EF\u4EE5\u5230\u9326\u532F\u93AE\u7684[VAR FF00(0006)]\u5BF6\u98DF\u5802[VAR FF00(0000)]\u8B8A\u66F4\u3002[VAR 0114(0012)]",
  "\u98DF\u5802\u7684\u5927\u5EDA\u662F\u500B\u96E3\u641E\u7684\u4EBA\uFF0C\\n\u5F97\u8981\u5148\u7372\u5F97\u5979\u7684\u597D\u611F\u624D\u884C\u662F\u4E5F\u2026\u2026[VAR 0114(0012)]",
  "\u597D\u4E86\uFF0C\\n\u4E0B\u4E00\u5802\u8AB2\u8981\u8003\u671F\u4E2D\u8003\u5594\uFF01\\r\\n\u4E5F\u8B1D\u8B1D\u4F60\u4E86\uFF0C\u5713\u9678\u9BCA\u524D\u8F29\u3002[VAR 0114(0012)]",
  "\u9583\u5695\u2026\u2026"
]
