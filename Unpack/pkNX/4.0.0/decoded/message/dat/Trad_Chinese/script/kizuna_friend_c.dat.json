[
  "\u54E6\uFF0C\u51A0\u8ECD\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u770B\u66F8\u5B78\u7FD2\u55CE\uFF1F[VAR 0114(0006)]",
  "\u7B97\u662F\u5427",
  "\u6211\u53EA\u662F\u8DEF\u904E",
  "\u5582\u5582\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E0D\u8981\u9023\u8166\u888B\u74DC\u90FD\u8B8A\u4E00\u7B49\u4E00\u7684\u554A\uFF5E[VAR 0114(0006)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u7528\u5165\u53E3\u7684\u6A13\u68AF\u935B\u934A\u8173\u529B\u55CE\uFF1F[VAR 0114(0006)]",
  "\u2026\u2026\u55EF\uFF1F\\n\u54E6\uFF0C\u6211\u7684\u8A71\uFF0C\u5C31\u662F\u90A3\u500B\u554A\u3002\\r\\n\u6B63\u5728\u7E7C\u7E8C\u5C0B\u627E\u81EA\u6211\u3002[VAR 0114(0006)]",
  "\u6211\u5728\u5165\u53E3\u7684\u66F8\u6AC3\u4E0A\\n\u6771\u7FFB\u897F\u627E\u6211\u5ABD\u7684\u7814\u7A76\u7B46\u8A18\uFF0C\\r\\n\u7D50\u679C\u767C\u73FE\u4E86\u9019\u672C\u66F8\u3002[VAR 0114(0006)]",
  "\u6211\u5728\u5165\u53E3\u7684\u66F8\u6AC3\u4E0A\\n\u6771\u7FFB\u897F\u627E\u6211\u7238\u7684\u7814\u7A76\u7B46\u8A18\uFF0C\\r\\n\u7D50\u679C\u767C\u73FE\u4E86\u9019\u672C\u66F8\u3002[VAR 0114(0006)]",
  "\u9019\u662F\u71C8\u5854\u7684\u7814\u7A76\u6240\u88E1\u4E5F\u653E\u4E86\u4E00\u672C\uFF0C\\n\u5C0D\u6211\u5ABD\u4F86\u8AAA\u5F88\u91CD\u8981\u7684\u66F8\u2026\u2026\\r\\n\u53EB\u4EC0\u9EBC\u6731\u4E4B\u66F8\u4F86\u8457\u7684\uFF1F[VAR 0114(0006)]",
  "\u9019\u662F\u71C8\u5854\u7684\u7814\u7A76\u6240\u88E1\u4E5F\u653E\u4E86\u4E00\u672C\uFF0C\\n\u5C0D\u6211\u7238\u4F86\u8AAA\u5F88\u91CD\u8981\u7684\u66F8\u2026\u2026\\r\\n\u53EB\u4EC0\u9EBC\u7D2B\u4E4B\u66F8\u4F86\u8457\u7684\uFF1F[VAR 0114(0006)]",
  "\u6211\u7B2C\u4E00\u6B21\u8A8D\u771F\u8B80\u4E86\u79D8\u50B3\u8ABF\u5473\u6599\\n\u4EE5\u5916\u7684\u5167\u5BB9\uFF0C\u8D85\u52C1\u7206\u7684\uFF01[VAR 0114(0006)]",
  "\u96D6\u7136\u5167\u5BB9\u5F88\u53EF\u7591\uFF0C\u4F46\u975E\u5E38\u6709\u8DA3\uFF01\\n\u800C\u4E14\u9084\u6709\u63D2\u5716\uFF0C\u8B80\u8D77\u4F86\u5F88\u8F15\u9B06\uFF01[VAR 0114(0006)]",
  "\u4F86\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u770B\u770B\u9019\u88E1\uFF01[VAR 0114(0006)]",
  "\u9019\u4E00\u9801\u5728\u6BCF\u4E00\u672C\u88E1\u982D\uFF0C\\n\u6587\u5B57\u90FD\u6A21\u7CCA\u4E0D\u6E05\u5230\u8B80\u4E0D\u4E86\u3002\\r\\n\u611F\u89BA\u5167\u5BB9\u4E00\u5B9A\u5F88\u4E0D\u5999\u3002[VAR 0114(0006)]",
  "\u96D6\u7136\u9019\u672C\u66F8\u76E1\u5BEB\u4E9B\u7834\u5929\u8352\u7684\u5167\u5BB9\uFF0C\\n\u4F46\u79D8\u50B3\u8ABF\u5473\u6599\u4E5F\u5BE6\u969B\u5B58\u5728\u2026\u2026\\c\\n\u52A0\u4E0A\u6211\u5011\u5728\u7B2C\u96F6\u5340\u7684\u7D93\u6B77\uFF0C\\n\u5BE6\u5728\u4E0D\u80FD\u65B7\u5B9A\u9019\u672C\u66F8\u90FD\u5728\u80E1\u8AAA\u516B\u9053\u554A\uFF5E[VAR 0114(0006)]",
  "\u8AAA\u8D77\u4F86\uFF0C\u6216\u8A31\u6211\u5ABD\u6B63\u662F\u8B80\u4E86\u9019\u672C\u66F8\uFF0C\\n\u624D\u6210\u70BA\u7814\u7A76\u8005\u7684\u3002[VAR 0114(0006)]",
  "\u8AAA\u8D77\u4F86\uFF0C\u6216\u8A31\u6211\u7238\u6B63\u662F\u8B80\u4E86\u9019\u672C\u66F8\uFF0C\\n\u624D\u6210\u70BA\u7814\u7A76\u8005\u7684\u3002[VAR 0114(0006)]",
  "[VAR 1107(00FF,0101)]\u5979\u4ED6\u4E00\u5B9A\u662F\u88AB\u9019\u672C\u66F8\u88E1\u9762\\n\u63D0\u5230\u7684\u53E4\u4EE3\u7684\u5BF6\u53EF\u5922\u7D66\u5438\u5F15\uFF0C\\r\\n\u624D\u60F3\u89AA\u773C\u770B\u770B\u90A3\u96BB\u5BF6\u53EF\u5922\u5427\u3002[VAR 0114(0006)]",
  "[VAR 1107(00FF,0101)]\u5979\u4ED6\u4E00\u5B9A\u662F\u88AB\u9019\u672C\u66F8\u88E1\u9762\\n\u63D0\u5230\u7684\u672A\u4F86\u7684\u5BF6\u53EF\u5922\u7D66\u5438\u5F15\uFF0C\\r\\n\u624D\u60F3\u89AA\u773C\u770B\u770B\u90A3\u96BB\u5BF6\u53EF\u5922\u5427\u3002[VAR 0114(0006)]",
  "\u54A6\uFF1F\\n\u4F46\u662F\u53E4\u4EE3\u7684\u5BF6\u53EF\u5922\u7260\u6703\u51FA\u73FE\u5728\u9019\u88E1\uFF0C\\r\\n\u662F\u56E0\u70BA\u6211\u5ABD\u5979\u6253\u9020\u4E86\u6642\u5149\u6A5F\u561B\uFF1F[VAR 0114(0006)]",
  "\u54A6\uFF1F\\n\u4F46\u662F\u672A\u4F86\u7684\u5BF6\u53EF\u5922\u7260\u6703\u51FA\u73FE\u5728\u9019\u88E1\uFF0C\\r\\n\u662F\u56E0\u70BA\u6211\u7238\u4ED6\u6253\u9020\u4E86\u6642\u5149\u6A5F\u561B\uFF1F[VAR 0114(0006)]",
  "\u5728\u6642\u5149\u6A5F\u5B8C\u6210\u4EE5\u524D\u5C31\u5B58\u5728\u7684\u9019\u672C\u66F8\u88E1\uFF0C\\n\u63D0\u5230\u4E86\u53E4\u4EE3\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u4E0D\u5408\u9053\u7406\u5427\u2026\u2026\uFF1F[VAR 0114(0006)]",
  "\u5728\u6642\u5149\u6A5F\u5B8C\u6210\u4EE5\u524D\u5C31\u5B58\u5728\u7684\u9019\u672C\u66F8\u88E1\uFF0C\\n\u63D0\u5230\u4E86\u672A\u4F86\u7684\u5BF6\u53EF\u5922\uFF0C\\r\\n\u4E0D\u5408\u9053\u7406\u5427\u2026\u2026\uFF1F[VAR 0114(0006)]",
  "\u2026\u2026\u2026\u2026[VAR 0114(0006)]",
  "\u55EF\uFF0C\u5C31\u662F\u9019\u7A2E\u5730\u65B9\\n\u8B93\u9019\u672C\u66F8\u770B\u8D77\u4F86\u5F88\u53EF\u7591\uFF01[VAR 0114(0006)]",
  "\u53EF\u4EE5\u8AAA\u6211\u5ABD\u592A\u53B2\u5BB3\u4E86\uFF01\u5373\u4F7F\u5167\u5BB9\u80E1\u8AAA\u516B\u9053\uFF0C\\n\u4ECD\u7136\u5805\u4FE1\u800C\u4E14\u628A\u5B83\u5316\u70BA\u73FE\u5BE6\uFF01[VAR 0114(0006)]",
  "\u53EF\u4EE5\u8AAA\u6211\u7238\u592A\u53B2\u5BB3\u4E86\uFF01\u5373\u4F7F\u5167\u5BB9\u80E1\u8AAA\u516B\u9053\uFF0C\\n\u4ECD\u7136\u5805\u4FE1\u800C\u4E14\u628A\u5B83\u5316\u70BA\u73FE\u5BE6\uFF01[VAR 0114(0006)]",
  "\u6211\u8981\u597D\u597D\u6548\u4EFF\uFF0C\u597D\u597D\u52AA\u529B\uFF01[VAR 0114(0006)]",
