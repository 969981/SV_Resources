[
  "\u2026\u2026\u770B\u4F86\u662F\u4E00\u7FA4\u6709\u6D3B\u529B\u7684\u5B69\u5B50\u5011\u3002[VAR 0114(002C)]",
  "\u6211\u4E43\u85A9\u74E6\u7F85\u3002\\c\\n\u5728\u9019\u5802\u8AB2\u4E2D\uFF0C\u8AF8\u4F4D\u540C\u5B78\u5C07\u5B78\u7FD2\\n\u751F\u5B58\u6240\u5FC5\u9808\u7684\u77E5\u8B58\u8207\u6280\u80FD\u3002[VAR 0114(0029)]",
  "\u8AF8\u4F4D\u4E2D\u6709\u8A31\u591A\u4EBA\u662F\u96E2\u9109\u80CC\u4E95\uFF0C\\n\u7368\u81EA\u5728\u5BBF\u820D\u751F\u6D3B\u7684\u3002[VAR 0114(0029)]",
  "\u671F\u5F85\u85C9\u7531\u6211\u6240\u50B3\u6388\u7684\u77E5\u8B58\uFF0C\\n\u8AF8\u4F4D\u7684\u8863\u3001\u98DF\u3001\u4F4F\u90FD\u80FD\\r\\n\u63D0\u5347\u5230\u66F4\u597D\u7684\u5883\u754C\u3002[VAR 0114(0029)]",
  "\u7576\u524D\u8AF8\u4F4D\u6240\u5728\u610F\u7684\\n\u60F3\u5FC5\u662F\u300C\u98DF\u300D\u5427\u3002[VAR 0114(0029)]",
  "\u5728\u91CE\u9910\u6642\u5403\u4E0B\u4E09\u660E\u6CBB\uFF0C\\n\u5C31\u6703\u7372\u5F97\u88AB\u7A31\u70BA[VAR FF00(0006)]\u98DF\u529B[VAR FF00(0000)]\u7684\u6771\u897F\u3002\\r\\n\u5B83\u80FD\u5E36\u4F86\u5404\u5F0F\u5404\u6A23\u7684\u6548\u679C\u3002[VAR 0114(0029)]",
  "\u9664\u4E86\u56DE\u5FA9\u9AD4\u529B\u4E4B\u5916\uFF0C\\n\u4F8B\u5982\u66F4\u5BB9\u6613\u6355\u6349\u5BF6\u53EF\u5922\uFF0C\\r\\n\u80FD\u7372\u5F97\u66F4\u591A\u7D93\u9A57\u503C\u4E4B\u985E\u7684\u3002[VAR 0114(0029)]",
  "\u82E5\u662F\u80FD\u505A\u51FA\u7F8E\u5473\u7684\u4E09\u660E\u6CBB\uFF0C\\n\u6548\u679C\u5C31\u6703\u66F4\u9032\u4E00\u6B65\u63D0\u5347\u3002[VAR 0114(0029)]",
  "\u800C\u82E5\u662F\u60F3\u7372\u5F97\u66F4\u6709\u7528\u7684\u98DF\u529B\uFF0C\\n\u5728\u505A\u6599\u7406\u6642\u5C31\u5F97\u6CE8\u610F\\r\\n\u67D0\u500B\u975E\u5E38\u91CD\u8981\u7684\u95DC\u9375\u2026\u2026[VAR 0114(0029)]",
  "\u90A3\u9EBC\uFF0C\u8A66\u554F[VAR 0100(0000)]\u540C\u5B78\uFF0C\\n\u70BA\u4E86\u7372\u5F97\u66F4\u5F37\u5927\u7684\u98DF\u529B\uFF0C\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6703\u6CE8\u610F\u4EC0\u9EBC\u5462\uFF1F[VAR 0114(0029)]",
  "\u6750\u6599\u8207\u8ABF\u5473\u6599",
  "\u505A\u6599\u7406\u7684\u901F\u5EA6",
  "\u653E\u5165\u611B\u60C5",
  "[VAR 0100(0000)]\u540C\u5B78\uFF0C\u7B54\u5F97\u597D\u3002\\n\u662F\u56E0\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u5BB6\u6642\u6703\u5E6B\u5FD9\u505A\u6599\u7406\uFF0C\\r\\n\u6240\u4EE5\u65E9\u5DF2\u7D93\u77E5\u9053\u4E86\u55CE\uFF1F[VAR 0114(0029)]",
  "\u2026\u2026\u90A3\u662F\u932F\u8AA4\u7684\u7B54\u6848\u3002\\n\u6211\u671F\u671B[VAR 1100(00FF,0101)]\u4F60\u59B3\u8207\u5176\u91CD\u8996\u901F\u5EA6\uFF0C\\r\\n\u4E0D\u5982\u91CD\u8996\u7D30\u81A9\u7A0B\u5EA6\u3002[VAR 0114(0029)]",
  "\u5475\u2026\u2026\uFF01\u771F\u662F\u6709\u8DA3\u7684\u7B54\u6848\u3002\\n\u96D6\u7136\u4E0D\u662F\u6211\u6240\u8981\u7684\u7B54\u6848\u2026\u2026\\r\\n\u4F46\u5C31\u67D0\u7A2E\u610F\u7FA9\u4E0A\u4F86\u8AAA\uFF0C\u662F\u6B63\u78BA\u7684\u3002[VAR 0114(0029)]",
  "\u70BA\u4E86\u7372\u5F97\u66F4\u5F37\u5927\u7684\u98DF\u529B\uFF0C\\n\u6750\u6599\u8207\u8ABF\u5473\u6599\u2026\u2026\\r\\n\u4E5F\u5C31\u662F\u6240\u8B02\u7684\u98DF\u6750\u5341\u5206\u91CD\u8981\u3002[VAR 0114(0029)]",
  "\u4F8B\u5982\u591A\u4F7F\u7528\u4E00\u4E9B\u751C\u5473\u5F37\u7684\u98DF\u6750\uFF0C\\n\u5C31\u66F4\u5BB9\u6613\u7372\u5F97\u86CB\u86CB\u529B\u2026\u2026[VAR 0114(0029)]",
  "\u591A\u4F7F\u7528\u4E00\u4E9B\u82E6\u5473\u5F37\u7684\u98DF\u6750\uFF0C\\n\u5C31\u66F4\u5BB9\u6613\u7372\u5F97\u6389\u7269\u529B\u3002\u8AF8\u5982\u6B64\u985E\u3002[VAR 0114(0029)]",
  "\u91DD\u5C0D\u5E0C\u671B\u7372\u5F97\u7684\u6548\u679C\\n\u53BB\u88FD\u4F5C\u4E09\u660E\u6CBB\uFF0C\\r\\n\u5C31\u80FD\u66F4\u4EAB\u53D7\u505A\u6599\u7406\u7684\u6A02\u8DA3\u3002\\c\\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\u5728\u9910\u5EF3\u7528\u9910\\n\u4E5F\u662F\u80FD\u7372\u5F97\u98DF\u529B\u7684\u3002[VAR 0114(0029)]",
  "\u2026\u2026\u82E5\u662F\u8AF8\u4F4D\u80FD\u5920\u7FD2\u5F97\u77E5\u8B58\uFF0C\\n\u66F4\u6DF1\u5165\u7406\u89E3\u5BB6\u653F\u8AB2\uFF0C\\r\\n\u5C0D\u6211\u4F86\u8AAA\u4E5F\u662F\u5341\u5206\u53EF\u559C\u7684\u3002[VAR 0114(0029)]",
  "\u672C\u5802\u8AB2\u5230\u6B64\u7D50\u675F\u3002\\n\u6055\u6211\u5931\u966A\u4E86\u3002[VAR 0114(0029)]"
]
