[
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u91C0\u5149\u5E02\u73A9\u5F97\u9084\u958B\u5FC3\u55CE\uFF1F\\n\u9019\u88E1\u662F\u5145\u6EFF\u9AD8\u79D1\u6280\u548C\u5546\u696D\u4EA4\u6613\u7684\u57CE\u5E02\u5594\uFF01",
  "\u5F9E\u9019\u88E1\u5F80\u5317\u5C31\u662F\u4E3B\u8857\u9053\uFF01\\c\\n\u88AB\u96FB\u5B50\u544A\u793A\u677F\u570D\u7E5E\u7684\u9053\u8DEF\\n\u662F\u91C0\u5149\u9019\u88E1\u7279\u6709\u7684\u666F\u8272\u5594\u3002",
  "\u896A\u5B50\u6700\u91CD\u8981\u7684\u5C31\u662F\u8981\u8212\u670D\uFF01\\n\u7562\u7ADF\u9019\u662F\u6642\u5E38\u7A7F\u5728\u8EAB\u4E0A\u7684\u6771\u897F\u554A\u3002",
  "\u5305\u5305\u6700\u91CD\u8981\u7684\u5C31\u662F\u8981\u6642\u9AE6\uFF01\\n\u80FD\u6536\u7D0D\u591A\u5C11\u6771\u897F\u662F\u5176\u6B21\u5594\u3002",
  "\u9019\u88E1\u5C31\u662F\u5947\u6A39\u7684\u9053\u9928\u2026\u2026\\n\u7E3D\u662F\u5728\u76F4\u64AD\u4E0A\u770B\u5230\u7684\u5730\u65B9\u3002\u8D85\uFF5E\u611F\u52D5\u554A\uFF5E\uFF01",
  "\u4F60\u6709\u6C92\u6709\u770B\u4E0A\u6B21\u7684\u5947\u6A39\u5947\u8FF0\u76F4\u64AD\uFF1F\\n\u5979\u548C\u8389\u666E\u5408\u4F5C\u7684\u90A3\u4E00\u96C6\u597D\u68D2\u5594\uFF01",
  "\u5947\u6A39\u771F\u7684\u597D\u53EF\u611B\uFF0C\u5C0D\u4E0D\u5C0D\uFF5E\uFF01\\n\u5979\u61C9\u8A72\u662F\u76EE\u524D\u6700\u7D05\u7684\u76F4\u64AD\u4E3B\u5427\u3002",
  "\u5728\u57CE\u93AE\u88E1\u6709\u4E9B\u81EA\u7136\u7684\u7DA0\u610F\uFF0C\\n\u5C31\u80FD\u8B93\u6211\u9019\u6B77\u7D93\u6EC4\u6851\u7684\u5FC3\u88AB\u7642\u7652\u5462\u3002",
  "\u4F4F\u5728\u91C0\u5149\u5E02\uFF0C\\n\u6BCF\u5929\u611F\u5B98\u90FD\u6703\u5927\u53D7\u523A\u6FC0\u662F\u5427\u3002",
  "\u597D\u7684\uFF0C\u9AD8\u7D1A\u7403\u662F\u5427\uFF01\\c\\n\u5B83\u6BD4\u8D85\u7D1A\u7403\u9084\u8981\u53B2\u5BB3\uFF0C\\n\u6211\u5C31\u5148\u4E0B\u55AE\u8A02\u500B\uFF13\uFF10\uFF10\u500B\u5427\uFF01",
  "\u6211\u9577\u5927\u4EE5\u5F8C\uFF0C\\n\u4E5F\u8981\u7576\u7DB2\uFF5E\u7D05\uFF5E\uFF01",
  "\u4E16\u754C\u4E0A\u6709\\n\u5404\u5F0F\u5404\u6A23\u7684\u5DE5\u4F5C\u5594\uFF5E\uFF01",
  "\u6211\u539F\u672C\u8981\u505A\u4E09\u660E\u6CBB\u7684\uFF0C\\n\u7D50\u679C\u7ADF\u7136\u624B\u982D\u6C92\u6709\u7C64\u5B50\u2026\u2026\uFF01\\r\\n\u9019\u985E\u8017\u6750\u8981\u591A\u8CB7\u4E00\u4E9B\u6BD4\u8F03\u597D\u5594\u3002",
  "\u6211\u60F3\u5403\u9326\u532F\u93AE\u5BF6\u98DF\u5802\u7684\u6599\u7406\uFF0C\\n\u53C8\u89BA\u5F97\u73BB\u74F6\u5E02\u7684\u6D77\u5CB1\u4FF1\u6A02\u90E8\u4E5F\u4E0D\u932F\u2026\u2026\\r\\n\u6211\u5011\u4E7E\u8106\u53EB\u98DB\u7FD4\u8A08\u7A0B\u8ECA\u5427\uFF1F",
  "\u6211\u5F85\u6703\u8981\u53BB\u6349\u5BF6\u53EF\u5922\uFF0C\\n\u6240\u4EE5\u60F3\u5403\u4E9B\u80FD\u63D0\u5347\u6355\u7372\u529B\u7684\u6599\u7406\uFF5E",
  "\u6709\u5BF6\u53EF\u5922\u5728\u6D77\u4E0A\u98DB\u3002\\n\u6293\u597D\u6642\u6A5F\u2026\u2026\u6309\u5FEB\u9580\uFF01",
  "\u9019\u4E0B\u9762\u6709\u8239\u5594\uFF01\\n\u6211\u597D\u60F3\u5230\u6D77\u5E95\u53BB\u770B\u770B\u5594\uFF5E",
  "\u91C0\u5149\u5E02\u8655\u8655\u90FD\u6709\u76E3\u8996\u5668\uFF0C\\n\u6CBB\u5B89\u7DAD\u6301\u5F97\u76F8\u7576\u597D\uFF01\\c\\n\u807D\u8AAA\u5728\u91C0\u5149\u9053\u9928\u7684\u9053\u9928\u6E2C\u9A57\u4E2D\\n\u6703\u7528\u4E0A\u9019\u4E9B\u76E3\u8996\u5668\u62CD\u5230\u7684\u5F71\u50CF\u5462\u3002",
  "\u5728\u7119\u56FA\u93AE\u9AD4\u9A57\u505A\u9676\u5668\uFF01\\n\u4E0B\u500B\u4F01\u5283\u6848\u5C31\u63A8\u9019\u500B\u5427\uFF01",
  "\u7DB2\u8DEF\u76F4\u64AD\u4E5F\u5F88\u597D\u5566\uFF0C\\n\u4F46\u6211\u5C31\u662F\u60F3\u8981\u5728\u73FE\u5834\u770B\u5BF6\u53EF\u5922\u5C0D\u6230\uFF01",
  "\u840A\u59C6\u5728\u7DB2\u8DEF\u4E0A\u767C\u8868\u65B0\u6B4C\u4E86\uFF01\\n\u5F97\u5FEB\u4F86\u807D\u807D\u554A\uFF01",
  "\u8389\u666E\u63A8\u51FA\u7684\u9650\u5B9A\u7248\u5316\u599D\u54C1\uFF0C\\n\u6BCF\u4E00\u6B3E\u90FD\u597D\u68D2\uFF01\u597D\u96E3\u6C7A\u5B9A\u5594\uFF5E\uFF01",
  "\u9019\u9AD8\u6A13\u672A\u514D\u4E5F\u592A\u9AD8\u4E86\uFF01\\n\u770B\u8457\u770B\u8457\u6211\u8116\u5B50\u90FD\u9178\u4E86\u3002",
  "\u807D\u8AAA\u9019\uFF15\u68DF\u90FD\u662F\\n\u5E15\u5E95\u4E9E\u4E0D\u52D5\u7522\u7684\u5927\u6A13\u5594\u3002",
  "\u9019\u5EA7\u57CE\u5E02\u88E1\u7684\u96FB\u529B\u90FD\u662F\u7531\u53EB\u505A\\n\u5149\u86AA\u4ED4\u7684\u5BF6\u53EF\u5922\u5E6B\u5FD9\u767C\u96FB\u7684\u5594\uFF01",
  "\u6211\u6700\u63A8\u7684\u5076\u50CF\uFF01\u767B\u4E0A\u4E86\u96FB\u5B50\u544A\u793A\u677F\uFF01\\n\u6211\u6700\u63A8\u7684\u5076\u50CF\uFF01\u5076\u723E\u6703\u51FA\u73FE\uFF01\\r\\n\u554A\u554A\u2026\u2026\u6211\u7684\u5BC7\u6C99\u2026\u2026\uFF01\uFF01",
  "\u64C1\u6709\u904E\u4E00\u6B21\u7684\u62DB\u5F0F\u5B78\u7FD2\u5668\uFF0C\\n\u5C31\u80FD\u7528\u62DB\u5F0F\u5B78\u7FD2\u5668\u6A5F\u88FD\u4F5C\u5462\u3002",
  "\u8981\u662F\u6709\u6703\u885D\u6D6A\u7684\u5750\u9A0E\u5BF6\u53EF\u5922\uFF0C\\n\u5C31\u7B97\u662F\u8DF3\u9032\u6D77\u88E1\u4E5F\u6C92\u554F\u984C\u5594\u3002",
  "\u9019\u88E1\u4EE5\u524D\u662F\u7528\u8239\u53BB\\n\u642C\u904B\u7926\u5C71\u7926\u77F3\u7684\u6E2F\u93AE\u3002\\c\\n\u60F3\u4E0D\u5230\u73FE\u5728\u7ADF\u7136\u6703\u8B8A\u6210\\n\u9019\uFF5E\u6A23\u7684\u5546\u696D\u57CE\u5E02\u5462\u3002",
  "\u91C0\u5149\u5E02\u7684\u91C0\u5149\u662F\u628A\u6771\u897F\u91C0\u500B\u7CBE\u5149\uFF1F\\n\u9084\u662F\u91C0\u5230\u767C\u5149\uFF1F\\c\\n\u65E2\u7136\u6709\u767E\u842C\u4F0F\u7279\u591C\u666F\uFF0C\\n\u90A3\u61C9\u8A72\u5C31\u662F\u91C0\u5230\u767C\u5149\u56C9\uFF1F",
  "\u4E0D\u662F\u6709\u500B\u51FA\u540D\u7684\u535A\u58EB\u55CE\uFF1F\\n[VAR 1107(00FF,0101)]\u5979\u4ED6\u6700\u8FD1\u597D\u50CF\u90FD\u6C92\u51FA\u73FE\u5728\u5A92\u9AD4\u4E0A\u8036\u3002",
  "\u5C0F\u5319\u93AE\u9644\u8FD1\u6709\u500B\u71C8\u5854\uFF0C\\n\u807D\u8AAA\u90A3\u88E1\u7684\uFF11\u6A13\u662F\u500B\u7814\u7A76\u6240\u5594\u3002",
  "\u63DB\u500B\u5916\u89C0\uFF0C\\n\u5FC3\u60C5\u4E5F\u6703\u6539\u8B8A\uFF01\\c\\n\u9078\u64C7\u7A7F\u4EC0\u9EBC\u6A23\u7684\u8863\u670D\uFF0C\\n\u4E5F\u6703\u5F71\u97FF\uFF11\u5929\u7684\u5404\u7A2E\u4E8B\u60C5\uFF0C\u5C0D\u5427\uFF01",
  "\u50B7\u85E5\u3001\u98DF\u6750\uFF0C\\n\u9084\u6709\u7CBE\u9748\u7403\uFF01\\r\\n\u6709\u6C92\u6709\u6F0F\u8CB7\u4E86\u4EC0\u9EBC\u5462\uFF1F",
  "\u5230\u6642\u5019\u5C31\u7528\u98DB\u7FD4\u8A08\u7A0B\u8ECA\\n\u8F15\u8F15\u9B06\u9B06\u76F4\u98DB\u53CB\u597D\u5546\u5E97\u5427\u3002",
  "[~ 44]",
  "\u5947\u6A39\u5979\u5F9E\u597D\u5E7E\u5E74\u524D\\n\u5C31\u5728\u505A\u7DB2\u8DEF\u76F4\u64AD\u5462\u3002\\r\\n\u2026\u2026\u5979\u5230\u5E95\u662F\u5E7E\u6B72\u5440\uFF1F",
  "\u9019\u96BB\u52D2\u514B\u8C93\u7684\u6BDB\u8272\\n\u662F\u4E0D\u662F\u8D85\u5E25\u7684\u554A\uFF5E\uFF01\\c\\n\u6BCF\u6B21\u5C0D\u6230\u5F8C\uFF0C\\n\u6211\u90FD\u6703\u99AC\u4E0A\u5E6B\u7260\u5BF6\u53EF\u5922\u6D17\u6FA1\u6FA1\u5462\u3002",
  "\u6709\u4E00\u5929\u6211\u8981\u8B8A\u6210\u6709\u9322\u4EBA\uFF0C\\n\u7136\u5F8C\u8AAA\u300C\u5F9E\u9019\u88E1\u5230\u9019\u88E1\u6211\u5168\u90FD\u8981\uFF01\u300D\\r\\n\u2026\u2026\u9019\u662F\u6211\u7684\u5922\u60F3\u5594\uFF5E\uFF01",
  "\u6211\u56BC\u3001\u6211\u56BC\u3001\u6211\u56BC\u56BC\u3002\\c\\n\u5728\u91C0\u5149\u9053\u9928\u9032\u884C\u7684\u6311\u6230\uFF0C\\n\u90FD\u6703\u88AB\u7DB2\u8DEF\u76F4\u64AD\u5594\u3002",
  "\u6211\u559D\u3001\u6211\u559D\u3001\u6211\u559D\u559D\u3002\\c\\n\u4E0D\u4E45\u524D\u7684\u9053\u9928\u76F4\u64AD\u88E1\u6709\u500B\u53EB\u59AE\u83AB\u7684\u4EBA\uFF0C\\n\u5979\u7684\u5BF6\u53EF\u5922\u597D\u53B2\u5BB3\u5594\uFF01",
  "\u807D\u8AAA\u5B78\u9662\u88E1\u6709\u5F88\u591A\u66F8\u5594\uFF01\\c\\n\u7B49\u6211\u5165\u5B78\u4EE5\u5F8C\uFF0C\\n\u6211\u8981\u8B80\u904D\u300AOH\uFF01\u8D85\u81EA\u7136\u6587\u5316\u300B\uFF01",
  "\u5F9E\u9019\u524D\u9762\u7684\u71C8\u5854\\n\u53EF\u4EE5\u628A\u91C0\u5149\u5E02\u76E1\u6536\u773C\u5E95\u5594\u3002",
  "\u96D6\u7136\u6211\u4E5F\u5F88\u559C\u6B61\u98A8\u666F\u7167\uFF0C\\n\u4F46\u7559\u5728\u6211\u8166\u6D77\u88E1\u7684\u7E3D\u662F\u90A3\u4E9B\\r\\n\u6709\u62CD\u5230\u4EBA\u6216\u5BF6\u53EF\u5922\u7684\u7167\u7247\u5462\u3002"
]
