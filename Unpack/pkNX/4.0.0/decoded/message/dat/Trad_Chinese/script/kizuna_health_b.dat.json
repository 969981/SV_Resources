[
  "\u6B61\u8FCE\u4F86\u5230\u7C73\u83AB\u838E\u7684\u91AB\u52D9\u5BA4\uFF5E[VAR 0114(0028)]",
  "\u54A6\uFF1F[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u662F\u4E0D\u662F\u8B8A\u5F97\u66F4\u6210\u719F\u5065\u58EF\u4E86\u4E00\u9EDE\uFF1F[VAR 0114(0028)]",
  "\u54E6\uFF5E\u81EA\u5DF1\u8A87\u81EA\u5DF1\u4E0D\u6703\u81C9\u7D05\u5440\uFF5E\uFF1F\\n\u4E0D\u904E\uFF0C[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u795E\u60C5\u771F\u7684\u8B8A\u4E86\u3002[VAR 0114(0028)]",
  "\u4E0D\u5C0D\uFF5E\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u795E\u60C5\u679C\u771F\u6709\u4E9B\u8B8A\u4E86\u3002[VAR 0114(0028)]",
  "\u6211\u60F3\u90A3\u4E00\u5B9A\u662F\u56E0\u70BA\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u5C0B\u5BF6\u6642\u7372\u5F97\u5F88\u591A\u4E0D\u540C\u7684\u9AD4\u9A57\uFF5E[VAR 0114(0028)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u505A\u4EC0\u9EBC\u6A23\u7684\u4E8B\uFF0C\\n\u8AAA\u7D66\u6211\u807D\u807D\u5427\u3002[VAR 0114(0028)]",
  "\u54E6\uFF5E\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5728\u505A\u90A3\u9EBC\u6709\u8DA3\u7684\u4E8B\u554A\uFF5E[VAR 0114(0028)]",
  "\u5C0F\u5B69\u5B50\u771F\u662F\u53B2\u5BB3\uFF5E\u2026\u2026\\n\u6BCF\u5929\u90FD\u5728\u6311\u6230\u65B0\u4E8B\u7269\u3002[VAR 0114(0028)]",
  "\u76F8\u8F03\u4E4B\u4E0B\u2026\u2026[VAR 0114(0028)]",
  "\u2026\u2026\u6211\u4EE5\u524D\u7684\u5922\u60F3\u662F\\n\u6210\u70BA\u5B78\u6821\u7684\u8001\u5E2B\uFF5E[VAR 0114(0028)]",
  "\u554A\uFF0C\u73FE\u5728\u6211\u662F\u5B78\u6821\u7684\u8B77\u7406\u5E2B\uFF0C\\n\u6C92\u8FA6\u6CD5\u6559\u8AB2\u7684\u3002[VAR 0114(0028)]",
  "\u5065\u6559\u6559\u5E2B\u7684\u8003\u8A66\uFF0C\\n\u6211\u4E00\u76F4\u8003\u4E0D\u904E\uFF5E[VAR 0114(0028)]",
  "\u4E0D\u8AD6\u6311\u6230\u5E7E\u6B21\u90FD\u5931\u6557\uFF0C\\n\u7D50\u679C\u6211\u5C31\u5728\u91AB\u52D9\u5BA4\u88E1\u5F97\u904E\u4E14\u904E\u4E86\u3002[VAR 0114(0028)]",
  "\u554A\uFF0C\u5C0D\u4E0D\u8D77\u3002\\n\u7ADF\u7136\u8DDF[VAR 1100(00FF,0101)]\u4F60\u59B3\u8AAA\u9019\u9EBC\u6C89\u91CD\u7684\u8A71\u3002[VAR 0114(0028)]",
  "\u56E0\u70BA[VAR 1100(00FF,0101)]\u4F60\u59B3\u5BE6\u5728\u592A\u64C5\u9577\u807D\u5225\u4EBA\u8AAA\u8A71\u4E86\uFF0C\\n\u8B93\u4EBA\u5FCD\u4E0D\u4F4F\u6703\u4E00\u76F4\u8AAA\u3002[VAR 0114(0028)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5225\u56E0\u70BA\u9019\u6A23\u5C31\u5ACC\u68C4\uFF0C\\n\u8981\u518D\u4F86\u627E\u6211\u5594\u3002[VAR 0114(0028)]",
  "\u548C\u7C73\u83AB\u838E\u8001\u5E2B\\n\u8B8A\u5F97\u66F4\u8981\u597D\u4E86\u4E00\u9EDE\uFF01"
]
