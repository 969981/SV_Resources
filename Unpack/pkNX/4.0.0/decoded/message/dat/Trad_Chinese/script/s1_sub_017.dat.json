[
  "\u563F\uFF0C\u9019\u4F4D\u5144\u5F1F\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u770B\u8D77\u4F86\u633A\u5F37\u7684\u561B\u3002",
  "\u563F\uFF0C\u9019\u4F4D\u5C0F\u59D0\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u5BF6\u53EF\u5922\u770B\u8D77\u4F86\u633A\u5F37\u7684\u561B\u3002",
  "\u5982\u679C\u662F[VAR 1100(00FF,0101)]\u4F60\u59B3\u7684\u8A71\uFF0C\\n\u4E5F\u8A31\u80FD\u6253\u5012\u5317\u4E0A\u9B3C\u9762\u7D44\u5594\u3002",
  "\u5317\u4E0A\u9B3C\u9762\u7D44\uFF1F",
  "\u90A3\u662F\u4E9B\u4EC0\u9EBC\u4EBA\u554A\uFF1F",
  "\u5317\u4E0A\u9B3C\u9762\u7D44\u6703\u5728\\n\u6751\u5B50\u7684\u5916\u9762\u51FA\u6C92\uFF0C\\r\\n\u662F\u4E00\u7FA4\u6234\u8457\u9B3C\u9762\u5177\u7684\u53B2\u5BB3\u8A13\u7DF4\u5BB6\u3002",
  "\u90A3\u4E9B\u50A2\u4F19\u6700\u559C\u6B61\u53B2\u5BB3\u7684\u5B69\u5B50\uFF0C\\n\u4E00\u5FC3\u60F3\u8457\u8981\u8DDF\u4EBA\u4E00\u6C7A\u52DD\u8CA0\u3002",
  "\u807D\u8AAA\u5317\u4E0A\u9B3C\u9762\u7D44\\n\u4E00\u5171\u6709\uFF17\u500B\u4EBA\u2026\u2026",
  "\u8981\u662F\u60F3\u8DDF\u4ED6\u5011\u5C0D\u6230\u7684\u8A71\u8981\u5C0F\u5FC3\uFF0C\\n\u4ED6\u5011\u53EF\u4E0D\u662F\u4EC0\u9EBC\u597D\u5C0D\u4ED8\u7684\u50A2\u4F19\u3002\\c\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6BCF\u8D0F\u904E\u4ED6\u5011\u4E4B\u4E2D\u7684\u4E00\u500B\u4EBA\uFF0C\\n\u6211\u5C31\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u6771\u897F\u3002",
  "\u6211\u807D\u5230\u98A8\u8072\u4E86\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u8D0F\u9B3C\u9762\u7D44\u4E86\u662F\u5427\u3002\\r\\n\u6309\u7167\u7D04\u5B9A\uFF0C\u6211\u8981\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u6771\u897F\u3002",
  "\u6211\u807D\u5230\u98A8\u8072\u4E86\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6253\u8D0F\u9B3C\u9762\u7D44\u4E86\u662F\u5427\u3002\\r\\n\u6309\u7167\u7D04\u5B9A\uFF0C\u6211\u8981\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u6771\u897F\u3002",
  "\u9B3C\u9762\u7D44\u53EA\u5269\u4E0B\uFF11\u500B\u4EBA\u4E86\u2026\u2026\\n\u9700\u8981\u63D0\u793A[VAR 1100(00FF,0101)]\u4F60\u59B3\u8A72\u53BB\u54EA\u88E1\u627E\u4EBA\u55CE\uFF1F",
  "\u9B3C\u9762\u7D44\u9084\u5269[VAR 0200(0001)]\u500B\u4EBA\u2026\u2026\\n\u9700\u8981\u63D0\u793A[VAR 1100(00FF,0101)]\u4F60\u59B3\u8A72\u53BB\u54EA\u88E1\u627E\u4EBA\u55CE\uFF1F",
  "\u81EA\u9B3C\u5C71\u51FA\uFF0C\u9752\u4E4B\u65B9\u4F4D\u3002\\n\u8EAB\u81E8\u7AF9\u6797\uFF0C\u5373\u53EF\u898B\u543E\u3002",
  "\u6975\u76EE\u9060\u773A\uFF0C\u53EF\u898B\u9B3C\u89D2\u3002\\n\u7ACB\u8DB3\u4E4B\u8655\uFF0C\u5373\u53EF\u898B\u543E\u3002",
  "\u6EFE\u6EFE\u6D41\u6C34\uFF0C\u51FA\u81EA\u9B3C\u53E3\u3002\\n\u6C34\u908A\u72F9\u7E2B\uFF0C\u5373\u53EF\u898B\u543E\u3002",
  "\u53EF\u5165\u5730\u7344\uFF0C\u4EA6\u901A\u6A02\u571F\u3002\\n\u6C60\u6C34\u4E4B\u7554\uFF0C\u5373\u53EF\u898B\u543E\u3002",
  "\u7121\u82E6\u4E4B\u5730\uFF0C\u5947\u5CA9\u5D99\u5CCB\u3002\\n\u8352\u91CE\u4E4B\u4E2D\uFF0C\u5373\u53EF\u898B\u543E\u3002",
  "\u9B3C\u751F\u96D9\u89D2\uFF0C\u4E00\u9577\u4E00\u77ED\u3002\\n\u767B\u5176\u77ED\u8005\uFF0C\u5373\u53EF\u898B\u543E\u3002",
  "\u4E0D\u591C\u4E4B\u6C60\uFF0C\u6C34\u7554\u4E4B\u7A74\u3002\\n\u843D\u5165\u7A74\u4E2D\uFF0C\u5373\u53EF\u898B\u543E\u3002",
  "\u770B\u4F86\u2026\u2026[VAR 1100(00FF,0101)]\u4F60\u59B3\u5DF2\u7D93\u628A\u9B3C\u9762\u7D44\\n\u4E00\u500B\u4E0D\u5269\u5730\u6253\u5012\u5566\u3002",
  "\u65E2\u7136[VAR 1100(00FF,0101)]\u4F60\u59B3\u5982\u6B64\u4E4B\u5F37\uFF0C\\n\u770B\u4F86\u6211\u53EF\u4EE5\u5B89\u5FC3\u62FF\u51FA\u771F\u672C\u4E8B\u4E86\u2026\u2026",
  "\u559D\uFF01\uFF01",
  "\u543E\u4EBA\u4E43\u662F\\n\u5317\u4E0A\u9B3C\u9762\u79D8\u7D44\u552F\u4E00\u4E4B\u4EBA\u2026\u2026",
  "\u6700\u5F8C\u7684\u4E00\u6230\u5373\u5C07\u958B\u59CB\u3002\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u82E5\u662F\u6E96\u5099\u597D\u4E86\uFF0C\\r\\n\u5118\u7BA1\u524D\u4F86\u544A\u77E5\u3002",
  "\u8207\u543E\u4EBA\u7684\u6700\u5F8C\u4E00\u6230\u2026\u2026\\n\u662F\u5426\u5DF2\u6E96\u5099\u7121\u7919\uFF1F",
  "\u2026\u2026\u90A3\u4FBF\u7B49[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u4E86\u518D\u4F86\u3002",
  "\u8B93\u6211\u5011\u524D\u5F80\u5408\u9069\u7684\u5730\u65B9\u3002\\n\u2026\u2026\u8DDF\u543E\u4EBA\u4F86\u3002",
  "\u5317\u4E0A\u9B3C\u9762\u79D8\u7D44\uFF0C\u6751\u6B63\uFF01\\n\u8ACB\u6C42\u4E00\u6230\u2026\u2026\u63A5\u62DB\u5427\uFF01",
  "\u54C8\u54C8\u54C8\uFF01\\n\u6C92\u60F3\u5230[VAR 1100(00FF,0101)]\u4F60\u59B3\u9023\u543E\u4EBA\u90FD\u80FD\u6230\u52DD\uFF01\\r\\n\u90A3\u4EFD\u5BE6\u529B\u503C\u5F97\u7A31\u8B9A\uFF01",
  "\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\\n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026",
  "\u2026\u2026\u958B\u73A9\u7B11\u7684\uFF01\\n\u8F9B\u82E6[VAR 1100(00FF,0101)]\u4F60\u59B3\u5566\uFF01",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u525B\u525B\u53C3\u52A0\u7684\u662F\u9B3C\u9762\u7D44\u6D3B\u52D5\uFF01\\n\u662F\u70BA\u4E86\u935B\u934A\u5B69\u5B50\u5011\u7684\u8170\u817F\uFF0C\\r\\n\u540C\u6642\u6559\u5C0E\u4ED6\u5011\u5C0D\u6230\u7684\u6A02\u8DA3\u6240\u8FA6\u7684\u3002",
  "\u96D6\u7136\u6BCF\u9022\u63A9\u9762\u796D\u7684\u6642\u671F\\n\u90FD\u6703\u8FA6\u9019\u6D3B\u52D5\u2026\u2026",
  "\u4F46\u5DE5\u4F5C\u4EBA\u54E1\u592A\u904E\u8A8D\u771F\u4E86\uFF0C\\n\u4EE5\u81F4\u65BC\u5F9E\u4F86\u6C92\u6709\u5B69\u5B50\u80FD\u904E\u95DC\uFF01",
  "\u80FD\u5920\u9023\u6211\u90FD\u6253\u5012\u7684\u4EBA\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u5927\u6982\u662F\u7B2C\u4E00\u500B\u5427\uFF01",
  "\u6240\u4EE5\u8AAA\uFF0C\u606D\u559C[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E86\uFF01\\n\u8B93\u6211\u9001\u734E\u54C1\u7D66[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF01\uFF01",
  "\u5F80\u5F8C[VAR 1100(00FF,0101)]\u4F60\u59B3\u4E5F\u8981\u5728\u5317\u4E0A\u9109\u7684\u5927\u81EA\u7136\u88E1\u982D\\n\u628A\u81EA\u5DF1\u57F9\u80B2\u5F97\u66F4\u52A0\u5F37\u5927\u554A\uFF01",
  "\u54E6\u54E6\uFF0C\u5F37\u5927\u7684\u5B69\u5B50\u554A\uFF01\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u4F86\u898B\u543E\u4EBA\u4E00\u9762\u55CE\uFF01\\r\\n\u54C8\u54C8\u54C8\uFF0C\u5BE6\u5728\u4EE4\u4EBA\u6109\u5FEB\u3002"
]
