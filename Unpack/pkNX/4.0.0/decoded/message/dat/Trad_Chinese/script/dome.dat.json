[
  "\u7D2B\u7AFD\u5B78\u59D0\u6703\u5F88\u89AA\u5207\u5730\\n\u6559\u6211\u5BF6\u53EF\u5922\u7684\u4E8B\u5594\u3002",
  "\u7D2B\u7AFD\u5152\u5979\u5440\uFF0C\u6BCF\u5929\u90FD\u6703\u7528\\n\u5BF6\u53EF\u5922\u6D17\u6FA1\u6FA1\uFF13\u6B21\u5594\u3002\\r\\n\u6240\u4EE5\u5979\u7684\u5BF6\u53EF\u5922\u7E3D\u662F\u5F88\u4E7E\u6DE8\u3002",
  "\u4E0D\u7BA1\u9F8D\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\u518D\u600E\u9EBC\u5F37\uFF0C\\n\u5728\u5996\u7CBE\u7684\u529B\u91CF\u524D\u90FD\u662F\u4E0D\u582A\u4E00\u64CA\uFF01",
  "\u96D6\u7136\u5C31\u5C6C\u6027\u800C\u8A00\u662F\u4F54\u4E0A\u98A8\uFF0C\\n\u4F46\u807D\u8AAA\u7D2B\u7AFD\u5152\u5F9E\u4F86\u6C92\u6709\\r\\n\u6253\u8D0F\u904E\u675C\u82E5\u5462\u3002",
  "\u6D77\u5CB8\u5340\u7684\u9B45\u529B\u5728\u65BC\u6D77\uFF01\\n\u9019\u88E1\u7528\u7684\u53EF\u662F\u5982\u5047\u5305\u63DB\u7684\u6D77\u6C34\u5594\u3002",
  "\u5DE8\u86CB\u7684\u4F11\u606F\u7AD9\\n\u6709\u81EA\u52D5\u8CA9\u8CE3\u6A5F\u5462\uFF01\\r\\n\u5728\u90A3\u88E1\u53EF\u4EE5\u8CB7\u5230\u5404\u5F0F\u5404\u6A23\u7684\u7403\u5594\uFF01",
  "\u7528\u6F5B\u6C34\u7403\u6703\u6BD4\u8F03\u5BB9\u6613\u6349\u5230\\n\u5728\u6C34\u4E2D\u6E38\u7684\u5BF6\u53EF\u5922\u5594\u3002",
  "\u5806\u8457\u65B9\u584A\u7684\u5730\u65B9\uFF0C\\n\u5C0F\u7684\u53EB\u505A\u4F11\u606F\u7AD9\uFF01\\r\\n\u5927\u7684\u53EB\u505A\u5EE3\u5834\u5594\uFF01",
  "\u8D64\u677E\u7684\u6599\u7406\u5F88\u53B2\u5BB3\u5594\uFF01\\n\u4ED6\u6703\u7528\u9D28\u5634\u708E\u7378\u7684\u706B\u53BB\u70E4\u98DF\u6750\u5462\uFF01",
  "\u706B\u5C6C\u6027\u7684\u5BF6\u53EF\u5922\\n\u4E0D\u6703\u9677\u5165\u707C\u50B7\u72C0\u614B\uFF01\\r\\n\u77E5\u9053\u9019\u9EDE\u4FBF\u80FD\u548C\u5176\u4ED6\u4EBA\u62C9\u958B\u5DEE\u8DDD\uFF01",
  "\u8349\u539F\u5340\u6709\u6591\u6591\u99AC\uFF0C\\n\u6240\u4EE5\u8D85\u68D2\u7684\uFF01\\c\\n\u53EA\u8981\u8DE8\u5230\u4E0D\u540C\u7684\u5340\u57DF\uFF0C\\n\u53EF\u4EE5\u9047\u898B\u7684\u5BF6\u53EF\u5922\u5C31\u6703\u6539\u8B8A\u5594\uFF01",
  "\u56DB\u5929\u738B\u6230\u6703\u5728\u5404\u500B\u5EE3\u5834\u7684\\n\u5C0D\u6230\u5834\u8209\u884C\u5594\uFF01",
  "\u5728\u85CD\u8393\u806F\u76DF\u8981\u662F\u6392\u540D\u4E0D\u5920\u9AD8\uFF0C\\n\u5C31\u7B97\u60F3\u8981\u6311\u6230\u56DB\u5929\u738B\uFF0C\u4E5F\u90FD\u6C92\u8FA6\u6CD5\u5462\u3002",
  "\u5927\u984E\u87FB\u9032\u5316\u4EE5\u5F8C\uFF0C\\n\u5C31\u6703\u589E\u52A0\u9F8D\u5C6C\u6027\u554A\uFF5E\\r\\n\u70BA\u4EC0\u9EBC\uFF1F\u597D\u4E0D\u53EF\u601D\u8B70\u5594\uFF5E",
  "\u7528\u56DE\u5FA9\u6A5F\u7684\u6642\u5019\uFF0C\\n\u5982\u679C\u5F8C\u9762\u6709\u4EBA\u5C31\u6703\u5F88\u7DCA\u5F35\u5462\u2026\u2026\uFF01",
  "\u7D0D\u8389\u5C0F\u59D0\u53C8\u9177\u53C8\u51FA\u8272\uFF01\\n\u5979\u662F\u5B78\u751F\u6703\u9577\uFF0C\u9084\u662F\u56DB\u5929\u738B\u5462\uFF01",
  "\u5CFD\u8C37\u5340\u6709\u6BD4\u8F03\u591A\\n\u7C97\u7377\u7684\u5BF6\u53EF\u5922\uFF01\\c\\n\u56DB\u5929\u738B\u7D0D\u8389\u4E5F\u6703\\n\u6D3E\u51FA\u92FC\u5C6C\u6027\u5BF6\u53EF\u5922\u5594\uFF01",
  "\u53EB\u505A\u76D4\u7532\u9CE5\u7684\u5BF6\u53EF\u5922\\n\u5F31\u9EDE\u5F88\u5C11\uFF0C\u5F88\u96E3\u5C0D\u4ED8\u5462\uFF01\\c\\n\u5728\u751F\u614B\u5DE8\u86CB\u7260\u9084\u6703\u662F\\n\u98DB\u7FD4\u8A08\u7A0B\u8ECA\uFF0C\u771F\u662F\u592A\u6D3B\u8E8D\u5566\uFF01",
  "\u5728\u67D0\u500B\u5730\u5340\u4F3C\u4E4E\u5B58\u5728\u8457\\n\u92FC\u93A7\u9D09\u7684\u5929\u6575\u3002\\c\\n\u90A3\u4E00\u5B9A\u662F\u9577\u5F97\u5F88\u53EF\u6015\u7684\\n\u5BF6\u53EF\u5922\u5427\uFF01",
  "\u5C31\u662F\u56E0\u70BA\u559C\u6B61\u92FC\u93A7\u9D09\uFF0C\\n\u6211\u624D\u6703\u548C\u4ED6\u8B8A\u5F97\u8981\u597D\u7684\u5594\uFF01",
  "\u7528\u5587\u53ED\u5544\u9CE5\u53BB\u6311\u6230\u98DB\u7FD4\u8A08\u6642\u8CFD\uFF0C\\n\u8AAA\u8D77\u4F86\u5BE6\u5728\u662F\u592A\u7121\u8B00\u4E86\u662F\u5427\u3002",
  "\u9019\u88E1\u662F\u96FB\u6C23\u77F3\u5CA9\u7A9F\uFF01\\n\u4E00\u5E36\u96FB\u5C31\u6703\u8B93\u4EBA\u9165\u9165\u9EBB\u9EBB\u7684\uFF01",
  "\u675C\u82E5\u4ED6\u662F\uFF12\u5E74\u7D1A\u2026\u2026\\n\u5947\u602A\uFF1F\\c\\n\u6211\u600E\u9EBC\u8A18\u5F97\u4ED6\u53BB\u5E74\u548C\u524D\u5E74\\n\u4E5F\u662F\uFF12\u5E74\u7D1A\u554A\u2026\u2026",
  "\u6975\u5730\u5340\u68F2\u606F\u8457\u5F88\u591A\\n\u5F88\u8010\u5BD2\u7684\u5BF6\u53EF\u5922\u5594\u3002\\r\\n\u51B0\u5C6C\u6027\u5360\u7684\u6BD4\u4F8B\u4F3C\u4E4E\u591A\u4E00\u4E9B\u4E9B\uFF01",
  "\u9019\u524D\u9762\u662F\u5CFD\u8C37\u5340\uFF01\\n\u5CA9\u77F3\u8868\u9762\u51F9\u51F9\u51F8\u51F8\u7684\uFF0C\\r\\n\u6240\u4EE5\u5EFA\u8B70[VAR 1100(00FF,0101)]\u4F60\u59B3\u9A0E\u4E0A\u5750\u9A0E\u5BF6\u53EF\u5922\u5594\u3002",
  "\u807D\u8AAA\u53EA\u8981\u548C\u5927\u5BB6\u4E00\u8D77\u85CD\u6A02\u6D3B\uFF0C\\n\u5831\u916C\u5C31\u6703\u8B8A\u591A\uFF01\\r\\n\u53EF\u662F\u6211\u6C92\u6709\u670B\u53CB\u53EF\u4EE5\u4E00\u8D77\u53C3\u52A0\u2026\u2026",
  "\u9019\u88E1\u662F\u4E2D\u5FC3\u5EE3\u5834\uFF01\\n\uFF14\u500B\u5340\u57DF\u4EA4\u6703\u7684\u5730\u65B9\uFF01",
  "\u59B3\u4E0D\u89BA\u5F97\u6700\u8FD1\u806F\u76DF\u793E\u7684\u6C23\u6C1B\\n\u6709\u9EDE\u5DEE\u55CE\u2026\u2026",
  "\u81EA\u5F9E\u51A0\u8ECD\u5F9E\u675C\u82E5\\n\u8B8A\u6210\u70CF\u6817\u4E4B\u5F8C\u2026\u2026\\r\\n\u793E\u5718\u6D3B\u52D5\u5C31\u4E0D\u597D\u73A9\u4E86\u3002",
  "\u96D6\u7136\u9019\u9EBC\u8AAA\u4E0D\u592A\u597D\uFF0C\\n\u4F46\u6211\u65E9\u5C31\u5E0C\u671B\u70CF\u6817\u5225\u7576\u51A0\u8ECD\u4E86\u3002\\r\\n\u6240\u4EE5\u6211\u5F88\u9AD8\u8208\u3002",
  "\u807D\u8AAA\u65B0\u7684\u51A0\u8ECD\\n\u4E0D\u662F\u9019\u500B\u5B78\u5712\u7684\u4EBA\u5462\uFF01",
  "\u53EF\u4EE5\u958B\u958B\u5FC3\u5FC3\u5C0D\u6230\u7684\\n\u806F\u76DF\u793E\u56DE\u4F86\u4E86\uFF01",
  "\u5982\u679C\u662F\u73FE\u5728\u7684\u793E\u5718\uFF0C\\n\u6211\u5C31\u6709\u52D5\u529B\u52A0\u6CB9\u4E86\uFF01\\r\\n\u76EE\u6A19\u662F\u7576\u4E0A\u56DB\u5929\u738B\u4E4B\u985E\u7684\uFF01",
  "\u5DE8\u86CB\u88E1\u65B9\u584A\u6703\\n\u653E\u5C04\u51FA\u7D05\u5916\u7DDA\u548C\u7D2B\u5916\u7DDA\uFF01\\c\\n\u2026\u2026\u64DA\u8AAA\u90A3\u6703\u4FC3\u9032\\n\u5BF6\u53EF\u5922\u548C\u690D\u7269\u7684\u6210\u9577\uFF01",
  "\u90A3\u908A\u662F\u6975\u5730\u5340\uFF01\\c\\n\u90A3\u88E1\u6709\u4EBA\u5DE5\u91CD\u73FE\u7684\u51B0\u5C71\uFF0C\\n\u6240\u4EE5\u5F88\u51B7\u5594\uFF5E\uFF1F",
  "\u548C\u5718\u9AD4\u6230\u6709\u95DC\u7684\u4EFB\u52D9\u53EA\u8981\u548C\u5927\u5BB6\\n\u4E00\u8D77\u6311\u6230\uFF0C\u5C31\u80FD\u8F15\u9B06\u5B8C\u6210\u8036\uFF01",
  "\u6211\u8981\u548C\u6211\u54E5\u54E5\u4E00\u8D77\\n\u85CD\u6A02\u6D3B\u5594\uFF5E\uFF01",
  "\uFF11\u5E74\u7D1A\u90A3\u500B\u53EB\u505A\u70CF\u6817\u7684\u4EBA\uFF0C\\n\u6574\u500B\u4EBA\u7684\u6C23\u6C1B\u7A81\u7136\u5C31\u8B8A\u4E86\u5462\u3002",
  "\u51A0\u8ECD\u6230\u592A\u7CBE\u5F69\u4E86\u3002\\n\u70CF\u6817\u60F3\u5FC5\u662F\u76F8\u7576\u4E0D\u7518\u5FC3\u5427\u3002",
  "\u807D\u8AAA\u70CF\u6817\u4ED6\u4F11\u5B78\u4E86\u3002\\n\u5E0C\u671B\u4ED6\u80FD\u5FEB\u9EDE\u6253\u8D77\u7CBE\u795E\u3002",
  "\u53EA\u6709\u512A\u79C0\u7684\u5B78\u751F\uFF01\\n\u624D\u9818\u5230\u4E86\u592A\u6676\u73E0\u3002\\r\\n\u2026\u2026\u64DA\u8AAA\u662F\u6750\u6599\u5F88\u8CB4\u91CD\uFF01",
  "\u592A\u6676\u5316\u771F\u662F\u6DF1\u5967\uFF01\\n\u6709\u6642\u9084\u6703\u5C0E\u81F4\u5F31\u9EDE\u8B8A\u591A\u5462\uFF01",
  "\u90A3\u908A\u662F\u6D77\u5CB8\u5340\uFF01\\n\u6709\u82B1\u6709\u6D77\uFF0C\u5F77\u5F7F\u8EAB\u8655\u963F\u7F85\u62C9\uFF01\uFF1F",
  "\u54A6\uFF1F\u96E3\u4E0D\u6210\u2026\u2026\\n\u65B9\u584A\u7684\u984F\u8272\u6703\u6839\u64DA\u5340\u57DF\u800C\u6709\u4E0D\u540C\uFF1F",
  "\u6211\u8EAB\u5F8C\u6709\u62DB\u5F0F\u5B78\u7FD2\u5668\\n\u6389\u5728\u5730\u4E0A\u5594\u3002\\r\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u64BF\u8D77\u4F86\u4E86\u6C92\uFF1F",
  "\u806F\u76DF\u793E\u7684\u5B69\u5B50\u5011\u4E4B\u9593\\n\u4EBA\u969B\u95DC\u4FC2\u4E0D\u592A\u597D\uFF1F\\r\\n\u8EAB\u70BA\u8001\u5E2B\uFF0C\u6211\u4E0D\u80FD\u7F6E\u4E4B\u4E0D\u7406\u3002",
  "\u806F\u76DF\u793E\u7684\u5B69\u5B50\u5011\\n\u4F3C\u4E4E\u7A69\u5B9A\u4E0B\u4F86\u4E86\u3002\\r\\n\u8EAB\u70BA\u8001\u5E2B\uFF0C\u6211\u4EC0\u9EBC\u90FD\u6C92\u5E6B\u5230\u3002",
  "\u806F\u76DF\u793E\u7684\u5B69\u5B50\u5011\\n\u53C8\u50CF\u4EE5\u524D\u90A3\u6A23\u7DBB\u653E\u7B11\u5BB9\u4E86\u3002\\r\\n\u8EAB\u70BA\u8001\u5E2B\uFF0C\u6211\u60F3\u7E7C\u7E8C\u5B88\u8B77\u4ED6\u5011\u3002",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u6709\u6311\u6230\u904E\\n\u98DB\u7FD4\u8A08\u6642\u8CFD\u55CE\uFF1F\\c\\n\u4E09\u5408\u4E00\u78C1\u602A\u5011\\n\u6703\u5728\u8CFD\u9053\u5E6B\u5FD9\u5594\u3002"
]
