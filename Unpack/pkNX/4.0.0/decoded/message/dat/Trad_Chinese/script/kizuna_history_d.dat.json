[
  "[VAR 0100(0000)]\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u627E\u5230\u707D\u798D\u4E4B\u5BF6\u4E86\u55CE\uFF1F[VAR 0114(0027)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u8981\u662F\u6709\u8208\u8DA3\u4E86\uFF0C\u5C31\u5E6B\u5FD9\u8ABF\u67E5\u4E00\u4E0B\u5427\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u770B\u4F86[VAR 1100(00FF,0101)]\u4F60\u59B3\u6C92\u6709\u95DC\u65BC\\n\u707D\u798D\u4E4B\u5BF6\u7684\u65B0\u5831\u544A\u3002[VAR 0114(0027)]",
  "\u54C7\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u6349\u5230\u4E86\\n\u707D\u798D\u4E4B\u9F0E\u7684\u53E4\u9F0E\u9E7F\u554A\uFF01\uFF01[VAR 0114(0027)]",
  "\u54C7\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u6349\u5230\u4E86\\n\u707D\u798D\u4E4B\u528D\u7684\u53E4\u528D\u8C79\u554A\uFF01\uFF01[VAR 0114(0027)]",
  "\u54C7\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u6349\u5230\u4E86\\n\u707D\u798D\u4E4B\u7C21\u7684\u53E4\u7C21\u8778\u554A\uFF01\uFF01[VAR 0114(0027)]",
  "\u54C7\uFF01[VAR 1100(00FF,0101)]\u4F60\u59B3\u6349\u5230\u4E86\\n\u707D\u798D\u4E4B\u7389\u7684\u53E4\u7389\u9B5A\u554A\uFF01\uFF01[VAR 0114(0027)]",
  "\u55B2\u5475\uFF01\u8457\u5BE6\u6709\u610F\u601D\uFF01\\n\u6211\u7684\u597D\u5947\u5FC3\u6D36\u6E67\u800C\u4E0A\uFF01\uFF01[VAR 0114(0027)]",
  "\u5F9E\u5F62\u72C0\u548C\u5927\u5C0F\u4F86\u770B\uFF0C\\n\u9019\u500B\u9F0E\u61C9\u8A72\u4E0D\u662F\u65E5\u7528\u54C1\uFF01[VAR 0114(0027)]",
  "\u85DD\u8853\u54C1\u2026\u2026\\n\u6216\u8005\u662F\u904E\u53BB\u7528\u4F86\\r\\n\u796D\u7940\u795E\u660E\u7684\u796D\u5668\uFF01\uFF01[VAR 0114(0027)]",
  "\u4E0A\u9762\u9577\u8457\u89D2\uFF0C\u9084\u6709\u4EE5\u773C\u775B\u70BA\u9020\u578B\u7684\u8A2D\u8A08\uFF0C\\n\u7E3D\u89BA\u5F97\u9019\u4F3C\u4E4E\u6709\u4E9B\u4EC0\u9EBC\u610F\u5716\u3002[VAR 0114(0027)]",
  "\u6709\u6C92\u6709\u53EF\u80FD\u53D7\u5230\u4FE1\u4EF0\u7684\u795E\u660E\\n\u672C\u8EAB\u5C31\u662F\u9F0E\u7684\u5F62\u72C0\uFF01\uFF1F[VAR 0114(0027)]",
  "\u539F\u4F86\u5DE6\u53F3\u7684\u7259\u9F52\u5206\u5225\u662F\u7531\\n\u528D\u67C4\u548C\u528D\u8EAB\u7684\u90E8\u5206\u69CB\u6210\u7684\uFF01[VAR 0114(0027)]",
  "\u4E0D\u77E5\u9053\u662F\u5728\u6210\u70BA\u5BF6\u53EF\u5922\u6642\u6298\u65B7\u7684\uFF0C\\n\u9084\u662F\u4E00\u958B\u59CB\u5C31\u2026\u2026\uFF1F[VAR 0114(0027)]",
  "\u4E0D\u5C0D\uFF0C\u7B49\u7B49\uFF0C\\n\u570B\u738B\u600E\u9EBC\u53EF\u80FD\u6703\u53BB\u8CB7\u4E00\u628A\u6298\u65B7\u7684\u528D\u3002[VAR 0114(0027)]",
  "\u6216\u8A31\u4E5F\u6709\u53EF\u80FD\u662F\u5728\u6298\u65B7\u7684\u72C0\u614B\u4E0B\\n\u4F7F\u7528\u7684\u6B66\u5668\u2026\u2026\uFF01\uFF1F[VAR 0114(0027)]",
  "\u9019\u9EBC\u591A\u7684\u6728\u7C21\u9023\u5728\u4E00\u8D77\uFF0C\\n\u8C48\u4E0D\u662F\u4E00\u500B\u9577\u7BC7\u9245\u4F5C\u55CE\uFF01\uFF1F[VAR 0114(0027)]",
  "\u96D6\u7136\u51FA\u571F\u7684\u6728\u7C21\u5927\u591A\u90FD\u662F\\n\u5857\u9D09\u548C\u55AE\u7D14\u7684\u7B46\u8A18\u800C\u5DF2\u2026\u2026\\r\\n\u4F46\u9019\u4E9B\u4ECD\u662F\u80FD\u4E00\u7ABA\u7576\u6642\u60C5\u6CC1\u7684\u73CD\u8CB4\u7269\u54C1\uFF01[VAR 0114(0027)]",
  "\u6211\u6C92\u8FA6\u6CD5\u89E3\u8B80\uFF0C\u4F46\u9019\u500B\u9577\u5EA6\u61C9\u8A72\u662F\u500B\u6545\u4E8B\uFF1F\\n\u53C8\u6216\u8005\u662F\u8A5B\u5492\u7684\u5492\u6587\uFF1F[VAR 0114(0027)]",
  "\u771F\u53EF\u60DC\u6587\u5B57\u5DF2\u7D93\u8B8A\u5F97\u6A21\u7CCA\u4E0D\u6E05\u4E86\uFF01\\n\u5F15\u8D77\u570B\u738B\u8208\u8DA3\u7684\u6728\u7C21\uFF01\\r\\n\u90A3\u4E0A\u9762\u7A76\u7ADF\u5BEB\u4E86\u4EC0\u9EBC\u6A23\u7684\u6587\u7AE0\u2026\u2026\uFF1F[VAR 0114(0027)]",
  "\u52FE\u7389\u56E0\u70BA\u5341\u5206\u795E\u8056\uFF0C\\n\u904E\u53BB\u5728\u796D\u7940\u6642\u6703\u88AB\u4F69\u6234\u5728\u8EAB\u4E0A\u3002[VAR 0114(0027)]",
  "\u901A\u5E38\u6703\u50CF\u540A\u589C\u4E00\u822C\uFF0C\\n\u5C07\uFF11\u500B\u52FE\u7389\u639B\u5728\u8116\u5B50\u4E0A\uFF0C\\r\\n\u4F46\u53E4\u7389\u9B5A\u8EAB\u4E0A\u6709\u8457\u591A\u9054\uFF14\u500B\u52FE\u7389\u3002[VAR 0114(0027)]",
  "\u90A3\u662F\u4E00\u7A2E\u88DD\u98FE\u54C1\uFF0C\\n\u7528\u4F86\u88DD\u98FE\u8033\u6735\u6216\u624B\u8155\u7B49\u7B49\u6210\u96D9\u7684\u90E8\u4F4D\uFF1F\\r\\n\u53C8\u6216\u8005\u796D\u7940\u662F\u7531\uFF14\u500B\u4EBA\u4F86\u9032\u884C\u2026\u2026\uFF1F[VAR 0114(0027)]",
  "\u904E\u53BB\u88AB\u7528\u4F86\u9A45\u90AA\u7684\u52FE\u7389\\n\u6703\u88AB\u7A31\u70BA\u707D\u798D\uFF0C\\r\\n\u9019\u904E\u7A0B\u7A76\u7ADF\u767C\u751F\u4E86\u4EC0\u9EBC\u4E8B\u2026\u2026[VAR 0114(0027)]",
  "\u8B0E\u5718\u8D8A\u4F86\u8D8A\u6DF1\u3002\\n\u554A\u554A\uFF5E\u6211\u7684\u6C42\u77E5\u617E\u671B\u8D8A\u4F86\u8D8A\u611F\u5230\u6EFF\u8DB3\u2026\u2026\uFF01[VAR 0114(0027)]",
  "\u55EF\uFF1F\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u597D\u50CF\u9084\u6709\u80FD\u5831\u544A\u7684\u8ABF\u67E5\u7D50\u679C\uFF1F[VAR 0114(0027)]",
  "[VAR 0100(0000)]\uFF0C\u611F\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002\\n\u771F\u7684\u662F\u767E\u805E\u4E0D\u5982\u4E00\u898B\u3002[VAR 0114(0027)]",
  "[VAR 1100(00FF,0101)]\u4F60\u59B3\u5982\u679C\u627E\u5230\u4E86\u5176\u4ED6\u7684\u707D\u798D\u4E4B\u5BF6\uFF0C\\n\u518D\u4F86\u5411\u6211\u5831\u544A\u5427\u3002[VAR 0114(0027)]",
  "\u2026\u2026\u771F\u662F\u9A5A\u4EBA\u3002\u9019\u9EBC\u4E00\u4F86\uFF0C\\n\u707D\u798D\u4E4B\u5BF6\u7684\u6240\u6709\u8ABF\u67E5\u5831\u544A\u90FD\u7D50\u675F\u4E86\u3002[VAR 0114(0027)]",
  "\u6211\u771F\u6C92\u60F3\u5230\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u6703\u5E6B\u5FD9\u8ABF\u67E5\u5230\u6700\u5F8C\u3002[VAR 0114(0027)]",
  "[VAR 0100(0000)]\uFF0C\u611F\u8B1D[VAR 1100(00FF,0101)]\u4F60\u59B3\u3002[VAR 0114(0027)]",
  "\u6211\u539F\u672C\u60F3\u9760\u81EA\u5DF1\u7684\u96D9\u624B\\n\u53BB\u8ABF\u67E5\u707D\u798D\u4E4B\u5BF6\uFF0C\\r\\n\u8B93\u5B83\u5011\u6210\u70BA\u81EA\u5DF1\u7684\u8CA1\u7522\u2026\u2026[VAR 0114(0027)]",
  "\u4F46\u6B63\u56E0\u70BA\u662F\u6BEB\u7121\u96DC\u5FF5\u7684[VAR 1100(00FF,0101)]\u4F60\u59B3\uFF0C\\n\u624D\u6709\u8FA6\u6CD5\u5B8C\u6210\u9019\u500B\u8ABF\u67E5\u3002[VAR 0114(0027)]",
  "\u6211\u5922\u5BD0\u4EE5\u6C42\u7684\u5BF6\u7269\\n\u5C31\u5148\u5BC4\u653E\u5728[VAR 1100(00FF,0101)]\u4F60\u59B3\u90A3\u88E1\u5427\u3002[VAR 0114(0027)]",
  "\u9019\u6771\u897F\u4EE3\u8868\u6211\u7684\u611F\u8B1D\uFF0C\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u62FF\u53BB\u5427\u3002[VAR 0114(0027)]",
  "\u5475\u5475\u5475\uFF0C[VAR 0100(0000)]\u2026\u2026\\n[VAR 1100(00FF,0101)]\u4F60\u59B3\u771F\u662F\u6709\u610F\u601D\u3002\\r\\n\u6211\u8981\u628A[VAR 1100(00FF,0101)]\u4F60\u59B3\u5217\u5165\u89C0\u5BDF\u540D\u55AE\u4E2D\u3002[VAR 0114(0027)]",
  "\u548C\u857E\u8377\u8001\u5E2B\u4E4B\u9593\u7684\\n\u727D\u7D46\u840C\u82BD\u4E86\uFF01"
