  "\uD658\uC0C1\uC758 \uD3EC\uCF13\uBAAC \uC0C1\uC0C1\uB3C4",
  "\uC2A4\uCF00\uCE58 \uB2F4\uB2F9 \uAD00\uCE21\uB300\uC6D0\uC774 \uADF8\uB9B0\\n\uD658\uC0C1\uC758 \uD3EC\uCF13\uBAAC.\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uC911\uCE35\uBD80 \uC774\uD6C4\uC5D0\\n\uC11C\uC2DD\uD558\uB294 \uC218\uC218\uAED8\uB07C\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uC740\\n\uB108\uBB34\uB098\uB3C4 \uD06C\uACE0 \uD749\uD3EC\uD588\uB2E4.\\n\uADF8\uB4E4\uC758 \uD2B9\uC9D5\uC744 \uD1A0\uB300\uB85C\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0 \uD658\uC0C1\uC758 \uD3EC\uCF13\uBAAC\uC774\\n\uC788\uB2E4\uBA74 \uC5B4\uB5BB\uAC8C \uC0DD\uACBC\uC744\uC9C0\uB97C\\n\uC0C1\uC0C1\uD558\uBA70 \uADF8\uB838\uB2E4\uACE0 \uD55C\uB2E4.",
  "\uD658\uC0C1\uC758 \uD3EC\uCF13\uBAAC \uC0C1\uC0C1\uB3C4",
  "\uC2A4\uCF00\uCE58 \uB2F4\uB2F9 \uAD00\uCE21\uB300\uC6D0\uC774 \uADF8\uB9B0\\n\uD658\uC0C1\uC758 \uD3EC\uCF13\uBAAC.\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uC911\uCE35\uBD80 \uC774\uD6C4\uC5D0\\n\uC11C\uC2DD\uD558\uB294 \uC218\uC218\uAED8\uB07C\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uC740\\n\uC791\uC73C\uBA74\uC11C\uB3C4 \uC794\uC778\uD588\uB2E4.\\n\uADF8\uB4E4\uC758 \uD2B9\uC9D5\uC744 \uD1A0\uB300\uB85C\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0 \uD658\uC0C1\uC758 \uD3EC\uCF13\uBAAC\uC774\\n\uC788\uB2E4\uBA74 \uC5B4\uB5BB\uAC8C \uC0DD\uACBC\uC744\uC9C0\uB97C\\n\uC0C1\uC0C1\uD558\uBA70 \uADF8\uB838\uB2E4\uACE0 \uD55C\uB2E4.",
  "\uC54C \uC218 \uC5C6\uB294 \uAE30\uC5B5",
  "\uD544\uC790 \uD5E4\uB354\uB294 \uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC758\\n\uCD5C\uC2EC\uBD80\uC5D0\uC11C \uB300\uC5F4\uC744 \uC774\uD0C8\uD574\\n\uC77C\uC2DC\uC801\uC73C\uB85C \uC870\uB09C\uC744 \uB2F9\uD588\uB2E4\uAC00\\n\uC4F0\uB7EC\uC9C4 \uCC44 \uBC1C\uACAC\uB41C \uC801\uC774 \uC788\uB2E4.\\n\uADF8\uB54C \uAFBC \uAFC8\uC778\uC9C0\uB294 \uBAA8\uB974\uACA0\uC73C\uB098,\\n\uBCF8 \uC801 \uC5C6\uB294 \uC7A5\uC18C\uC5D0\uC11C \uB204\uAD70\uAC00\uC640\\n\uB300\uD654\uD55C \uAC83 \uAC19\uC740 \uAE30\uC5B5\uC774 \uC788\uB2E4.\\n\uC88C\uCE21\uC740 \uBC1C\uACAC \uB2F9\uC2DC \uC950\uACE0 \uC788\uB358 \uBA54\uBAA8.\\n\uD544\uC801\uC740 \uB0B4 \uAC83\uC774\uB098, \uAE30\uC5B5\uC774 \uC5C6\uB2E4.",
  "\u25A0\uBC18 \uD3EC\u25A0\uBAAC?",
  "\uAD00\uCE21\u25A0\uC6D0\uACFC \uB5A8\uC5B4\uC84C\uC744 \uB54C\\n\uB300\uACF5 \uAE4A\u25A0 \uACF3\uC5D0\uC11C \uC2E0\u25A0\uD55C\\n\uBB3C\uCCB4\u25A0 \uBCF4\u25A0\uB358 \uAC83 \u25A0\uB2E4.\\n\u25A0\uCF13\uBAAC\uC778\uC9C0 \uC0B4\u25A0 \uC788\u25A0\uC9C0\uC870\u25A0\uB3C4\\n\uC54C \u25A0 \u25A0\uB294 \uC218\u25A0\u25A0\uB07C\uC758 \u25A0\uC7AC...\\n\uC678\u25A0\uC740 \uC721\u25A0\uD615\uC774 \uB2E4\uCE35\u25A0\uC73C\uB85C\\n\uACB9\u25A0\uC9C4 \uAD6C\u25A0\uB85C \uB418\uC5B4 \uC788\uC5C8\uC73C\uBA70,\\n\uBCF4\u25A0\uBCF4\uB2E4 \uBE5B\u25A0\uACE0 \uC788\uC5C8\uB2E4.\\n\uADF8 \uD615\u25A0\uB294 \u25A0\uCE58 \uC6D0\u25A0 \uAC19\uC558\uB2E4.",
