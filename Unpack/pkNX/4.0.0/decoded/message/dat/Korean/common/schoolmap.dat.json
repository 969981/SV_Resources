  "[~ 61]",
  "\uC624\uB80C\uC9C0 \uC544\uCE74\uB370\uBBF8\uC758 \uD604\uAD00.\\n\uC811\uC218\uCC98\uB97C \uD1B5\uD574 \uC218\uC5C5\uC744 \uB4E4\uC744 \uC218 \uC788\uB2E4.",
  "\uADF8\uB808\uC774\uD504 \uC544\uCE74\uB370\uBBF8\uC758 \uD604\uAD00.\\n\uC811\uC218\uCC98\uB97C \uD1B5\uD574 \uC218\uC5C5\uC744 \uB4E4\uC744 \uC218 \uC788\uB2E4.",
  "[VAR 0100(0000)]\uC758 \uBC29.\\n\uD559\uAD50\uC5D0 \uC788\uB294 \uB610 \uD558\uB098\uC758 \uC790\uC2E0\uC758 \uBC29.",
  "\uB124\uBAA8\uC758 \uBC29.\\n\uAE54\uB054\uD558\uAC8C \uC815\uB9AC \uC815\uB3C8\uC774 \uB418\uC5B4 \uC788\uB2E4.",
  "\uD398\uD37C\uC758 \uBC29.\\n\uB9DB\uC788\uC744 \uAC83 \uAC19\uC740 \uC694\uB9AC \uB0C4\uC0C8\uAC00 \uB09C\uB2E4.",
  "\uBAA8\uB780\uC758 \uBC29.\\n\uAE30\uACC4\uB85C \uAC00\uB4DD\uD558\uBA70, \uC0B4\uC9DD \uC5B4\uB461\uB2E4.",
  "[VAR 0100(0000)][VAR 1900(0004)] \uB124\uBAA8\uC758 \uAD50\uC2E4.\\n\uC885\uD569 \uCF54\uC2A4 \uD559\uAE09\uC774\uBA70, \uC9C0\uB2C8\uC5B4 \uC120\uC0DD\uB2D8\uC774 \uB2F4\uC784\uC774\uB2E4.",
  "\uD55C \uD559\uB144 \uC704\uC778 2\uD559\uB144 \uAD50\uC2E4.\\n\uBB38\uACFC \uCF54\uC2A4 \uD559\uAE09\uC774\uBA70, \uC138\uC774\uC9C0 \uC120\uC0DD\uB2D8\uC774 \uB2F4\uC784\uC774\uB2E4.",
  "\uD398\uD37C\uC758 \uAD50\uC2E4.\\n\uBB38\uACFC \uCF54\uC2A4 \uD559\uAE09\uC774\uBA70, \uC138\uC774\uC9C0 \uC120\uC0DD\uB2D8\uC774 \uB2F4\uC784\uC774\uB2E4.",
  "\uB2E4\uB978 \uBC18 \uAD50\uC2E4.\\n\uC774\uACFC \uCF54\uC2A4 \uD559\uAE09\uC774\uBA70, \uD0C0\uC784 \uC120\uC0DD\uB2D8\uC774 \uB2F4\uC784\uC774\uB2E4.",
  "\uBAA8\uB780\uC758 \uAD50\uC2E4.\\n\uC774\uACFC \uCF54\uC2A4 \uD559\uAE09\uC774\uBA70, \uD0C0\uC784 \uC120\uC0DD\uB2D8\uC774 \uB2F4\uC784\uC774\uB2E4.",
  "\uAD50\uC7A5 \uC120\uC0DD\uB2D8\uC758 \uBC29.\\n\uD074\uB77C\uBCA8 \uC120\uC0DD\uB2D8\uC758 \uCC45\uC0C1\uACFC \uC5F0\uAD6C \uAE30\uC790\uC7AC\uAC00 \uC788\uB2E4.",
  "\uC120\uC0DD\uB2D8\uB4E4\uC758 \uBC29.\\n\uC5EC\uB7EC \uC120\uC0DD\uB2D8\uB4E4\uC744 \uB9CC\uB0A0 \uC218 \uC788\uB2E4.",
  "\uBAB8 \uC0C1\uD0DC\uAC00 \uC88B\uC9C0 \uC54A\uC740 \uD559\uC0DD\uC774 \uC26C\uB7EC \uAC00\uB294 \uACF3.\\n\uBBF8\uBAA8\uC0AC \uC120\uC0DD\uB2D8\uC744 \uBCF4\uB7EC \uAC00\uB294 \uD559\uC0DD\uB3C4 \uB9CE\uB2E4\uB294 \uAC83 \uAC19\uB2E4.",
  "\uC77C\uC0C1 \uC6A9\uD488\uBD80\uD130 \uB3C4\uAD6C\uAE4C\uC9C0 \uBB34\uC5C7\uC774\uB4E0 \uAC16\uCDB0\uC838 \uC788\uB2E4.\\n\uC2E0\uAE30\uD558\uAC8C\uB3C4 \uC5B8\uC81C\uB098 \uAC13 \uAD6C\uC6B4 \uBE75\uC774 \uC788\uB2E4.",
  "\uAC00\uC815 \uC218\uC5C5\uC5D0 \uC0AC\uC6A9\uB418\uB294 \uAD50\uC2E4.\\n\uBC18\uC9DD\uBC18\uC9DD\uD55C \uC2DD\uAE30\uC640 \uC870\uB9AC \uB3C4\uAD6C\uAC00 \uB298\uC5B4\uC11C \uC788\uB2E4.",
  "\uC0DD\uBB3C \uC218\uC5C5\uC5D0 \uC0AC\uC6A9\uB418\uB294 \uAD50\uC2E4.\\n\uD604\uBBF8\uACBD \uB4F1, \uC2E4\uD5D8 \uB3C4\uAD6C\uAC00 \uC794\uB729 \uC788\uB2E4.",
  "\uBBF8\uC220 \uC218\uC5C5\uC5D0 \uC0AC\uC6A9\uB418\uB294 \uAD50\uC2E4.\\n\uD559\uC0DD\uB4E4\uC758 \uC791\uD488\uC774 \uC804\uC2DC\uB418\uC5B4 \uC788\uB2E4.",
  "\uC2DD\uB2F9 \uC544\uC8FC\uBA38\uB2C8\uAC00 \uC190\uC218 \uB9CC\uB4E0 \uC694\uB9AC\uB294\\n\uC5B8\uC81C\uB098 \uB9DB\uC788\uACE0 \uC601\uC591 \uB9CC\uC810\uC774\uB2E4.",
  "\uBC30\uD2C0\uD559 \uC218\uC5C5\uC5D0 \uC0AC\uC6A9\uB418\uB294 \uC911\uC559 \uC815\uC6D0.\\n\uC6B4\uB3D9\uC744 \uD558\uAC70\uB098 \uD734\uC2DD\uD560 \uC218 \uC788\uB294 \uACF5\uAC04\uC774\uB2E4.",
