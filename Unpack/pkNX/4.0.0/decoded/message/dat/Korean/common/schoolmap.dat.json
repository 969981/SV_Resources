  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758 \uD604\uAD00.\\n\uC911\uC559\uC5D0\uB294 \uBC30\uD2C0\uCF54\uD2B8\uAC00 \uC788\uB2E4.",
  "4\uAC1C\uC758 \uC5D0\uB9AC\uC5B4\uB97C \uBAA8\uD5D8\uD558\uBA70\\n\uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD574 \uBC30\uC6B8 \uC218 \uC788\uB294 \uC218\uC911 \uC815\uC6D0.",
  "\uCE74\uC9C0\uC758 \uAD50\uC2E4.\\n\uC790\uC728 \uD559\uC2B5 \uC2DC\uAC04\uC5D0 \uC0AC\uC6A9\uB41C\uB2E4.",
  "\uC2DC\uC720\uC758 \uAD50\uC2E4.\\n\uBE0C\uB77C\uC774\uC5B4 \uC120\uC0DD\uB2D8\uC774 \uB2F4\uC784\uC774\uB2E4.",
  "\uC77C\uC0C1 \uC6A9\uD488\uBD80\uD130 \uB3C4\uAD6C\uAE4C\uC9C0 \uBB34\uC5C7\uC774\uB4E0 \uAC16\uCDB0\uC838 \uC788\uB2E4.\\nBP\uB85C\uB9CC \uC774\uC6A9\uD560 \uC218 \uC788\uC73C\uB2C8 \uC8FC\uC758\uD560 \uAC83.",
  "\uC2DD\uB2F9 \uC544\uC8FC\uBA38\uB2C8\uAC00 \uC190\uC218 \uB9CC\uB4E0 \uC694\uB9AC\uB294\\n\uC591\uC774 \uD478\uC9D0\uD574\uC11C \uAE08\uBC29 \uBC30\uAC00 \uBD80\uB974\uAC8C \uB41C\uB2E4.",
  "[VAR 0100(0000)]\uC758 \uBC29.\\n\uC544\uCE74\uB370\uBBF8\uC5D0 \uC788\uB294 \uB610 \uD558\uB098\uC758 \uC790\uC2E0\uC758 \uBC29.",
  "\uC2DC\uC720\uC758 \uBC29.\\n\uC544\uB07C\uB294 \uC18C\uD488\uB4E4\uB85C \uAC00\uB4DD\uD558\uB2E4.",
  "\uCE74\uC9C0\uC758 \uBC29.\\n\uB178\uB825\uD55C \uD754\uC801\uC774 \uC794\uB729 \uB0A8\uC544 \uC788\uB2E4.",
  "\uB9AC\uADF8\uBD80\uAC00 \uC0AC\uC6A9\uD558\uB294 \uBD80\uC2E4.\\nPC\uB85C BP\uB97C \uC9C0\uC6D0\uD560 \uC218 \uC788\uB2E4."
