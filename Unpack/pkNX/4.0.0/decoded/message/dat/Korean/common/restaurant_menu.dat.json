  "\uCEF5\uACFC \uB611\uAC19\uC740 \uC544\uC774\uC2A4\uD06C\uB9BC\uC778\uB370\\n\uC2E0\uAE30\uD558\uAC8C\uB3C4 \uB2E4\uB978 \uB9DB\uC778 \uAC83 \uAC19\uC740 \uB290\uB08C\uC774 \uB4E0\uB2E4.",
  "\uB538\uAE30\uC758 \uB2EC\uCF64\uC0C8\uD07C\uD55C \uB9DB\uC744 \uB5A0\uC62C\uB9AC\uAC8C \uD558\uB294\\n\uC2DC\uB7FD\uC774 \uBFCC\uB824\uC9C4 \uBE59\uC218.",
  "\uBA5C\uB860\uC744 \uC5F0\uC0C1\uCF00 \uD558\uB294 \uC0C9\uAC10\uC758\\n\uC2DC\uB7FD\uC774 \uBFCC\uB824\uC9C4 \uBE59\uC218.",
  "\uC0B0\uB73B\uD55C \uB808\uBAAC\uC0C9\uC774 \uB208\uC744 \uC990\uAC81\uAC8C \uD55C\uB2E4.\\n\uC2E0\uB9DB\uC740 \uC5C6\uC9C0\uB9CC \uC815\uC11D\uC801\uC778 \uBE59\uC218.",
  "\uC54C\uB85C\uB77C\uC9C0\uBC29\uC758 \uBC14\uB2F7\uBE5B\uC744 \uBAA8\uD2F0\uBE0C\uB85C \uB9CC\uB4E0\\n\uC2DC\uB7FD\uC774 \uBFCC\uB824\uC9C4 \uBE59\uC218.",
  "\uD3EC\uB3C4 \uC560\uD638\uAC00\uB4E4\uC758 \uC131\uC6D0\uC5D0 \uD798\uC785\uC5B4 \uD0C4\uC0DD\uD55C \uBE59\uC218.\\n\uC9C4\uD55C \uBCF4\uB78F\uBE5B\uC774 \uC778\uC0C1\uC801\uC774\uB2E4.",
  "\uC0B4\uC9DD \uD0DC\uC6B4 \uC18C\uC2A4\uC758 \uB9C8\uC774\uC57C\uB974 \uBC18\uC751\uC5D0\uC11C \uB098\uC624\uB294\\n\uD5A5\uACFC \uAC10\uCE60\uB9DB\uC774 \uC5B4\uB9C8\uC5B4\uB9C8\uD55C \uBCF6\uC74C\uAD6D\uC218.",
  "\uBD81\uC2E0\uC0B0 \uC0AC\uACFC\uB97C \uC0AC\uC6A9\uD55C\\n\uC815\uB9D0 \uB9DB\uC788\uB294 \uC0AC\uACFC \uC0AC\uD0D5.",
  "\uBD81\uC2E0\uC0B0 \uCCAD\uC0AC\uACFC\uB294 \uC2E0\uB9DB\uC774 \uAC15\uD574\uC11C\\n\uD45C\uBA74\uC744 \uAC10\uC2F8\uACE0 \uC788\uB294 \uBB3C\uC5FF\uACFC \uAD81\uD569\uC774 \uC798 \uB9DE\uB294\uB2E4.",
  "\uC0AC\uB78C\uC5D0\uAC8C\uB294 \uC5B4\uB9C8\uC5B4\uB9C8\uD558\uAC8C \uC4F0\uC9C0\uB9CC\\n\uAC89\uBAA8\uC2B5\uC5D0 \uC18D\uB294 \uC544\uC774\uB4E4\uC774 \uB04A\uC774\uC9C8 \uC54A\uB294\uB2E4.",
  "\uB9F5\uACE0 \uB5AB\uC740 \uB77C\uC988\uC5F4\uB9E4\uB97C 100% \uC0AC\uC6A9\uD574\uC11C\\n\uC0AC\uB78C\uC774 \uBA39\uC73C\uBA74 \uD615\uC5B8\uD560 \uC218 \uC5C6\uB294 \uD45C\uC815\uC744 \uC9D3\uAC8C \uB41C\uB2E4.",
  "\uB2E4\uB978 \uB098\uBB34\uC5F4\uB9E4\uC5D0 \uBE44\uD558\uBA74 \uBA39\uAE30 \uD3B8\uD558\uACE0\\n\uBCF5\uC7A1\uD55C \uB9DB\uC774 \uB098\uC11C \uB9C8\uB2C8\uC544\uB4E4 \uC0AC\uC774\uC5D0\uC11C\uB294 \uC778\uAE30\uAC00 \uC788\uB2E4.",
  "\uBB3C\uC5FF\uC758 \uB2E8\uB9DB\uACFC \uB9F5\uACE0 \uC2E0 \uD30C\uC778\uC5F4\uB9E4\uC758 \uB9DB\uC774\\n\uC808\uBB18\uD558\uAC8C \uC5B4\uC6B8\uB9B0\uB2E4.",
