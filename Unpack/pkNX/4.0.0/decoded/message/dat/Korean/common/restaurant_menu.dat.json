  "\uB9E4\uC6B4\uB9DB\uC774 \uB098\uB294 \uC18C\uC2A4 \uB355\uBD84\uC5D0\\n\uCC44\uC18C\uC758 \uB2E8\uB9DB\uC774 \uC0B4\uC544\uB098\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC7BC\uACFC \uB538\uAE30\uB9CC\uC744 \uC0AC\uC6A9\uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uC2EC\uD50C\uD558\uAE30 \uB54C\uBB38\uC5D0 \uC27D\uAC8C \uC9C8\uB9AC\uC9C0 \uC54A\uB294\uB2E4.",
  "\uC2E0\uB9DB\uACFC \uAC10\uCE60\uB9DB\uC758 \uBC38\uB7F0\uC2A4\uAC00 \uD0A4\uD3EC\uC778\uD2B8.\\n\uB9C8\uBA40\uB808\uC774\uB4DC\uB97C \uB109\uB109\uD558\uAC8C \uB123\uC740 \uAC83\uC774 \uAC10\uCE60\uB9DB\uC758 \uBE44\uACB0\uC774\uB2E4.",
  "\uC2EC\uD50C\uD558\uBA74\uC11C\uB3C4 \uC2E4\uC18D \uC788\uACE0 \uB9DB\uC788\uB2E4.\\n\uBE75\uC744 \uBC14\uC0AD\uD558\uAC8C \uAD6C\uC6CC\uC11C \uD48D\uBBF8\uB97C \uB354\uD574\uB3C4 \uC88B\uB2E4.",
  "\uC544\uBCF4\uCE74\uB3C4\uAC00 \uC775\uC740 \uC815\uB3C4\uC5D0 \uB530\uB77C \uB9DB\uC774 \uB2EC\uB77C\\n\uC9C8\uB9AC\uC9C0 \uC54A\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uB2E4\uC591\uD55C \uC2DD\uC7AC\uB8CC\uAC00 \uB9CC\uB4E4\uC5B4 \uB0B4\uB294 \uD558\uBAA8\uB2C8.\\n\uC9C0\uBC29\uC758 \uC774\uB984\uC774 \uBD99\uC740 \uAC12\uC5B4\uCE58\uB97C \uD558\uB294 \uC694\uB9AC\uB2E4.",
  "\uC5EC\uB7EC \uC885\uB958\uC758 \uACFC\uC77C\uC774 \uB9CC\uB4E4\uC5B4 \uB0B4\uB294 \uB9DB\uC740\\n\uC8FC\uC2A4\uB77C\uACE0 \uC0DD\uAC01\uD558\uAE30 \uC5B4\uB824\uC6B8 \uC815\uB3C4\uB85C \uAE4A\uC774\uAC00 \uC788\uB2E4.",
  "\uAD6C\uC6B4 \uCC44\uC18C\uC758 \uAC10\uCE60\uB9DB\uC740 \uC9C4\uD558\uACE0 \uAC15\uD558\uB2E4.\\n\uACC1\uB4E4\uC5EC \uBA39\uAE30\uC5D0\uB3C4, \uC804\uCC44 \uC694\uB9AC\uB85C\uB3C4 \uC190\uC0C9\uC5C6\uB2E4.",
  "\uC18C\uBC15\uD55C \uB9DB\uC5D0 \uD600\uB3C4 \uB9C8\uC74C\uB3C4 \uD3B8\uC548\uD574\uC9C4\uB2E4.\\n\uCCA0\uD310\uC5D0\uC11C \uB9CC\uB4E4\uC5B4\uC9C0\uB294 \uD314\uB370\uC544\uC758 \uC815\uC11D\uC801\uC778 \uD0C0\uD30C\uC2A4.",
  "\uD76C\uADC0\uD55C \uC2DD\uC7AC\uB8CC\uB97C \uC2EC\uD50C\uD558\uAC8C \uC990\uAE38 \uC218 \uC788\uB2E4.\\n\uB0A8\uC740 \uC624\uC77C\uB85C \uD30C\uC2A4\uD0C0\uB97C \uB9CC\uB4E4\uC5B4\uB3C4 \uC88B\uB2E4.",
  "\uC2DC\uC7A5\uC774 \uB208\uC5D0 \uB5A0\uC624\uB97C \uC815\uB3C4\uB85C \uC544\uC8FC \uC2E0\uC120\uD558\uB2E4.\\n\uD50C\uB808\uC774\uD305\uB3C4 \uC544\uB984\uB2E4\uC6B4 \uC694\uB9AC.",
  "\uC18C\uBC15\uD558\uACE0\uB3C4 \uBD80\uB4DC\uB7EC\uC6B4 \uB2E8\uB9DB\uC5D0 \uD3B8\uC548\uD574\uC9C4\uB2E4.\\n\uCC28\uAC8C \uBA39\uC5B4\uB3C4 \uB530\uB73B\uD558\uAC8C \uBA39\uC5B4\uB3C4 \uB9DB\uC788\uB2E4.",
  "\uC2E0\uB9DB\uC774 \uC2DD\uC695\uC744 \uC790\uADF9\uD558\uB294 \uC694\uB9AC.\\n\uB6F0\uC5B4\uB09C \uC2E0\uC120\uB3C4 \uC5ED\uC2DC \uB9DB\uC744 \uB0B4\uB294 \uB370 \uD55C\uBAAB\uD55C\uB2E4.",
  "\uD48D\uBD80\uD55C \uD6C8\uC5F0\uC758 \uD5A5\uAE30\uC640 \uD5C8\uBE0C\uD5A5\uC758 \uC870\uD569.\\n\uADF8\uC57C\uB9D0\uB85C \uD5A5\uC73C\uB85C \uBA39\uB294 \uC694\uB9AC\uB2E4.",
  "\uC7AC\uB8CC\uB294 \uADF8\uB0A0 \uC2DC\uC7A5\uC5D0 \uB098\uC624\uB294 \uC0C1\uD488\uC5D0 \uB530\uB77C \uB2E4\uB974\uB2E4.\\n\uC5B4\uB5A4 \uC758\uBBF8\uB85C\uB294 \uBC14\uB2E4\uAC00 \uB9CC\uB4E4\uC5B4 \uB0B4\uB294 \uD30C\uC2A4\uD0C0.",
  "\uAF43\uC744 \uC8FC\uC81C\uB85C \uD558\uB294 4\uC885\uB958\uC758 \uCD08\uBC25.\\n\uC5B4\uC9F8\uC120\uC9C0 \uD558\uB098\uAC19\uC774 \uB9E4\uC6B4\uB9DB\uC774 \uAC15\uD558\uB2E4.",
  "\uC0C8\uB97C \uC8FC\uC81C\uB85C \uD558\uB294 4\uC885\uB958\uC758 \uCD08\uBC25.\\n\uC5B4\uC9F8\uC120\uC9C0 \uD558\uB098\uAC19\uC774 \uB2E8\uB9DB\uC774 \uAC15\uD558\uB2E4.",
  "\uBC14\uB78C\uC744 \uC8FC\uC81C\uB85C \uD558\uB294 4\uC885\uB958\uC758 \uCD08\uBC25.\\n\uC5B4\uC9F8\uC120\uC9C0 \uD558\uB098\uAC19\uC774 \uC2E0\uB9DB\uC774 \uAC15\uD558\uB2E4.",
  "\uB2EC\uC744 \uC8FC\uC81C\uB85C \uD558\uB294 4\uC885\uB958\uC758 \uCD08\uBC25.\\n\uC5B4\uC9F8\uC120\uC9C0 \uD558\uB098\uAC19\uC774 \uC4F4\uB9DB\uC774 \uAC15\uD558\uB2E4.",
  "\uC624\uB79C \uC2DC\uAC04 \uC219\uC131\uB41C \uB41C\uC7A5\uC744 \uC0AC\uC6A9\uD574\\n\uC721\uC218\uC5D0\uB3C4 \uC815\uC131\uC744 \uB4E4\uC778 \uC694\uB9AC.",
  "\uC11C\uB9AC\uB97C \uC8FC\uC81C\uB85C \uD558\uB294 \uC810\uD3EC \uD55C\uC815 \uC138\uD2B8.\\n\uC170\uD504\uAC00 \uC5C4\uC120\uD55C 4\uC885\uB958\uAC00 \uB098\uC628\uB2E4.",
  "\uC2F8\uB77C\uAE30\uB208\uC744 \uC8FC\uC81C\uB85C \uD558\uB294 \uC810\uD3EC \uD55C\uC815 \uC138\uD2B8.\\n\uC170\uD504\uAC00 \uD63C\uC2E0\uC758 \uD798\uC744 \uB2E4\uD574 \uB9CC\uB4E0 4\uC885\uB958\uAC00 \uB098\uC628\uB2E4.",
  "\uC6B0\uBC15\uC744 \uC8FC\uC81C\uB85C \uD558\uB294 \uC810\uD3EC \uD55C\uC815 \uC138\uD2B8.\\n\uC170\uD504\uAC00 \uCD94\uCC9C\uD558\uB294 4\uC885\uB958\uAC00 \uB098\uC628\uB2E4.",
  "\uC9C4\uB208\uAE68\uBE44\uB97C \uC8FC\uC81C\uB85C \uD558\uB294 \uC810\uD3EC \uD55C\uC815 \uC138\uD2B8.\\n\uC170\uD504\uAC00 \uC628 \uD798\uC744 \uB2E4\uD574 \uB9CC\uB4E0 4\uC885\uB958\uAC00 \uB098\uC628\uB2E4.",
  "\uB9D1\uC740 \uC721\uC218\uB294 \uAC10\uCE60\uB9DB\uC73C\uB85C \uAC00\uB4DD\uD558\uB2E4.\\n\uC815\uC131\uC774 \uAC00\uB4DD \uB2F4\uAE34 \uC810\uD3EC \uD55C\uC815 \uC694\uB9AC.",
  "\uAC00\uACA9\uC740 \uC801\uB2F9\uD558\uBA74\uC11C\uB3C4 \uB9DB\uC740 \uD0C1\uC6D4\uD558\uB2E4.\\n\uD600\uB05D\uC774 \uC800\uB824 \uC624\uB294 \uB9E4\uC6B4\uB9DB\uC740 \uBCF8\uACE0\uC7A5\uC758 \uB9DB\uACFC \uD761\uC0AC\uD558\uB2E4.",
  "\uACE0\uC0C1\uD558\uBA74\uC11C\uB3C4 \uB2F4\uBC31\uD55C \uB2E8\uB9DB\uC774\\n\uD600\uB97C \uBD80\uB4DC\uB7FD\uAC8C \uAC10\uC2F8\uB294 \uC815\uC11D\uC801\uC778 \uB514\uC800\uD2B8.",
  "\uC785\uAC00\uC2EC\uC5D0 \uC54C\uB9DE\uC740 \uC77C\uD488.\\n\uC18C\uBC15\uD55C \uC2E0\uB9DB\uC774 \uD3B8\uC548\uD568\uC744 \uC900\uB2E4.",
  "\uC9C4\uD55C \uC591\uB150\uC774 \uAC04\uC2DD\uC73C\uB85C\uB3C4\\n\uC548\uC8FC\uB85C\uB3C4 \uC801\uB2F9\uD55C \uC778\uAE30 \uBA54\uB274.",
  "\uC8FC\uC778 \uC648, \uAD00\uB3D9\uC5D0\uC11C \uBA39\uC5C8\uB358 \uB9DB\uC744\\n\uC7AC\uD604\uD588\uB2E4\uB294 \uAC04\uC7A5 \uBCA0\uC774\uC2A4\uC758 \uB77C\uBA74.",
  "\uCD5C\uACE0\uAE09 \uC2DD\uC7AC\uB8CC\uB97C \uC0AC\uC6A9\uD574 \uAC08\uB808\uD2B8\uC758 \uC218\uC900\uC744\\n\uD55C\uACC4\uAE4C\uC9C0 \uB04C\uC5B4\uC62C\uB9B0 \uCC9C\uC0C1\uC758 \uC694\uB9AC.",
  "\uD55C\uAECF \uC0AC\uCE58\uB97C \uBD80\uB824 \uCF64\uD3EC\uD2B8\uC758 \uC218\uC900\uC744\\n\uD55C\uACC4\uAE4C\uC9C0 \uB04C\uC5B4\uC62C\uB9B0 \uD30C\uACA9\uC801\uC778 \uC694\uB9AC.",
  "\uC5C4\uC120\uD55C \uC2DD\uC7AC\uB8CC\uB85C \uB77C\uD0C0\uD22C\uC720\uC758 \uC218\uC900\uC744\\n\uD55C\uACC4\uAE4C\uC9C0 \uB04C\uC5B4\uC62C\uB9B0 \uADDC\uACA9 \uC678\uC758 \uC694\uB9AC.",
  "\uCD5C\uACE0\uC758 \uC2DD\uC7AC\uB8CC\uB9CC\uC744 \uC0AC\uC6A9\uD574 \uD0A4\uC288\uC758 \uC218\uC900\uC744\\n\uD55C\uACC4\uAE4C\uC9C0 \uB04C\uC5B4\uC62C\uB9B0 \uCD5C\uACE0\uC758 \uC694\uB9AC.",
  "\uC7AC\uB8CC\uBE44\uB97C \uC544\uB08C\uC5C6\uC774 \uC3DF\uC544\uBD80\uC5B4 \uD3EC\uD1A0\uD440\uC758 \uC218\uC900\uC744\\n\uD55C\uACC4\uAE4C\uC9C0 \uB04C\uC5B4\uC62C\uB9B0 \uAD81\uADF9\uC758 \uC694\uB9AC.",
  "\uAC15\uB82C\uD55C \uB9E4\uC6B4\uB9DB\uC774 \uD2B9\uC9D5\uC778 \uC694\uB9AC.\\n\uD569\uB9AC\uC801\uC778 \uAC00\uACA9\uB3C4 \uB9E4\uB825\uC801\uC774\uB2E4.",
  "\uC774\uAC70 \uD558\uB098\uB9CC\uC73C\uB85C \uD558\uB8E8\uCE58 \uCE7C\uB85C\uB9AC\uB97C \uC5BB\uC744 \uC218 \uC788\uB2E4.\\n\uBC30\uB97C \uCC44\uC6B0\uAE30\uC5D0 \uB6F0\uC5B4\uB09C \uAC00\uC131\uBE44\uB97C \uC790\uB791\uD55C\uB2E4.",
  "\uC778\uACF5\uC801\uC778 \uC2E0\uB9DB\uC774 \uC790\uADF9\uC801\uC774\uB2E4.\\n\uB290\uB07C\uD55C \uC694\uB9AC\uB97C \uBA39\uC740 \uD6C4 \uC785\uAC00\uC2EC\uC73C\uB85C \uC88B\uB2E4.",
  "\uCC44\uC18C\uC758 \uC2E0\uC120\uB3C4\uB294 \uD3C9\uBC94\uD558\uC9C0\uB9CC,\\n\uC2DC\uC800 \uB4DC\uB808\uC2F1\uC758 \uD3C9\uD310\uC774 \uC88B\uB2E4.",
  "\uAC00\uAC8C\uC758 \uAC04\uD310 \uBA54\uB274\uC774\uC790 \uC815\uC11D \uBA54\uB274.\\n\uC591\uC774 \uB9CE\uC544\uC11C \uC80A\uC740\uC774\uB4E4\uC5D0\uAC8C \uC778\uAE30\uAC00 \uC88B\uB2E4.",
  "\uBC14\uC0AD\uD558\uAC8C \uD280\uAE34 \uAC10\uC790\uC640\\n\uC2A4\uCF54\uBE4C\uB7F0 \uC18C\uC2A4\uAC00 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4.",
  "\uBC14\uC0AD\uD558\uACE0 \uAC00\uBCBC\uC6B4 \uC2DD\uAC10\uC774 \uAE30\uBD84 \uC88B\uB2E4.\\n\uC4F4 \uCEE4\uD53C\uC640 \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uACFC\uC790.",
  "\uBC29\uAE08 \uC9E0 \uB808\uBAAC\uACFC \uAC15\uB82C\uD55C \uD0C4\uC0B0 \uB355\uC5D0\\n\uC808\uB85C \uAFC0\uAEBD\uAFC0\uAEBD \uB118\uC5B4\uAC00\uB294 \uC74C\uB8CC.",
  "\uC0B4\uC9DD \uC501\uC4F8\uD55C \uBE14\uB80C\uB4DC \uCEE4\uD53C.\\n\uD5A5\uC774 \uC88B\uC544\uC11C \uC220\uC220 \uB118\uC5B4\uAC04\uB2E4.",
  "\uCE58\uC988\uC640 \uD584\uBFD0\uC778 \uC2EC\uD50C\uD568\uC744 \uC790\uB791\uD55C\uB2E4.\\n\uBD80\uB4DC\uB7EC\uC6B4 \uC2DD\uAC10 \uB355\uBD84\uC5D0 \uBA39\uAE30\uB3C4 \uD3B8\uD558\uB2E4.",
  "\uB9E4\uCF64\uD55C \uC18C\uC2A4\uC640 \uCC44\uC18C \uC704\uC8FC\uC758 \uC18D \uC7AC\uB8CC \uB355\uBD84\uC5D0\\n\uC0B0\uB73B\uD558\uAC8C \uBA39\uC744 \uC218 \uC788\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC9C4\uD55C \uB2E8\uB9DB\uC774 \uACC4\uC18D \uC0DD\uAC01\uB098\uC11C\\n\uACFC\uC2DD\uC744 \uC870\uC2EC\uD574\uC57C \uD558\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uAC10\uC790\uC0D0\uB7EC\uB4DC \uB355\uBD84\uC5D0 \uBC30\uAC00 \uB4E0\uB4E0\uD574\uC9C4\uB2E4.\\n\uC810\uC2EC \uBA54\uB274\uB85C \uC548\uC131\uB9DE\uCDA4\uC778 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC18D \uC7AC\uB8CC\uB294 \uC6B0\uC9C1\uD558\uAC8C \uD53C\uD074\uB9CC \uB4E4\uC5B4 \uC788\uB294\\n\uC9C0\uADF9\uD788 \uC2EC\uD50C\uD55C \uC0CC\uB4DC\uC704\uCE58.",
  "\uC2A4\uD06C\uB7A8\uBE14 \uC5D0\uADF8\uAC00 \uC544\uB2C8\uB77C\\n\uC0B6\uC740 \uC54C\uC758 \uC2AC\uB77C\uC774\uC2A4\uB97C \uC0AC\uC6A9\uD55C \uAC83\uC774 \uD3EC\uC778\uD2B8\uB2E4.",
  "\uC740\uC740\uD55C \uB9E4\uC6B4\uB9DB\uC774 \uBC25\uC744 \uB2EC\uAC8C \uB290\uAEF4\uC9C0\uAC8C \uD55C\uB2E4.\\n\uD1B5\uD1B5\uD558\uAC8C \uBB49\uCCD0\uC838 \uC788\uB294 \uAC83\uB3C4 \uD3EC\uC778\uD2B8\uB2E4.",
  "\uAC04\uC2DD\uC73C\uB85C\uB3C4 \uC2DD\uC0AC\uC758 \uB9C8\uBB34\uB9AC\uB85C\uB3C4 \uC88B\uB2E4.\\n\uB2E8\uB9DB\uC774 \uACFC\uD558\uC9C0 \uC54A\uC544\uC11C \uBA39\uAE30 \uC88B\uB2E4.",
  "\uD600\uAC00 \uC800\uB9B4 \uC815\uB3C4\uB85C \uC0C8\uCF64\uD558\uACE0\\n\uC9ED\uC9E4\uD55C\uB370 \uADF8\uAC8C \uB610 \uB9DB\uC788\uB2E4.",
  "\uD638\uC5F0\uC9C0\uBC29\uC744 \uC5EC\uD589\uD55C \uC8FC\uC778\uC7A5\uC774\\n\uACBD\uD5D8\uD588\uB358 \uB9DB\uC744 \uC7AC\uD604\uD55C \uC694\uB9AC.",
  "\uC77C\uBD80\uB7EC \uACE0\uBA85\uC740 \uD30C\uB9CC \uB123\uC5C8\uB2E4.\\n\uC7A5\uAD6D\uACFC \uBA54\uBC00\uC758 \uB9DB\uC744 \uC990\uAE30\uB294 \uC694\uB9AC.",
  "\uC2A4\uD30C\uC774\uC2DC\uD55C \uC591\uB150\uC774 \uCC38\uC744 \uC218 \uC5C6\uAC8C \uB9DB\uC788\uB2E4.\\n\uB9E4\uC6B4\uB9DB\uC774 \uAC15\uD558\uC9C0\uB9CC, \uAC10\uCE60\uB9DB \uC5ED\uC2DC \uAC15\uD558\uB2E4.",
  "\uBC29\uAE08 \uB9CC\uB4E4\uC5B4\uC11C \uB530\uB048\uB530\uB048\uD55C \uAC83\uB3C4 \uB9DB\uC788\uC9C0\uB9CC,\\n\uCC28\uAC11\uAC8C \uC2DD\uD78C \uAC83\uB3C4 \uCD09\uCD09\uD558\uACE0 \uB9DB\uC788\uB2E4.",
  "\uAC78\uCB49\uD574\uC11C \uC798 \uC2DD\uC9C0 \uC54A\uACE0\\n\uC2E0\uB9DB\uC774 \uB450\uB4DC\uB7EC\uC838\uC11C \uB9DB\uC788\uB2E4.",
  "\uC0B0\uB73B\uD55C \uC4F4\uB9DB\uACFC \uAC15\uB82C\uD55C \uD5A5\uAE30\uAC00\\n\uAE30\uB984\uC9C4 \uC694\uB9AC\uC5D0 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4.",
  "\uAC15\uB82C\uD55C \uAC10\uCE60\uB9DB\uC774 \uB098\uB294 \uAD6D\uBB3C.\\n\uC0AC\uC6A9\uD558\uB294 \uC2DD\uC7AC\uB8CC\uB294 \uC601\uC5C5 \uBE44\uBC00\uC774\uB77C\uACE0 \uD55C\uB2E4.",
  "\uAE30\uBCF8\uC801\uC778 \uCD94\uB85C\uC2A4.\\n\uD2B9\uBCC4\uD55C \uAC83\uC740 \uC5C6\uC9C0\uB9CC \uADF8\uB0E5 \uB9DB\uC788\uB2E4.",
  "\uCD08\uCF5C\uB9BF\uC744 \uBFCC\uB9B0 \uCD94\uB85C\uC2A4.\\n\uD2B9\uBCC4\uD55C \uAC83\uC740 \uC5C6\uC9C0\uB9CC \uADF8\uB0E5 \uB9DB\uC788\uB2E4.",
  "\uC2DC\uB098\uBAAC \uD5A5\uC774 \uB098\uB294 \uCD94\uB85C\uC2A4.\\n\uD2B9\uBCC4\uD55C \uAC83\uC740 \uC5C6\uC9C0\uB9CC \uADF8\uB0E5 \uB9DB\uC788\uB2E4.",
  "\uBC29\uAE08 \uAD6C\uC6E0\uC744 \uB54C\uAC00 \uAC00\uC7A5 \uB9DB\uC788\uB2E4.\\n\uACE0\uC18C\uD55C \uD5A5\uC774 \uC2DD\uC695\uC744 \uC790\uADF9\uD55C\uB2E4.",
  "\uC801\uB2F9\uD558\uAC8C \uAD6C\uC6B4 \uC8FC\uBA39\uBC25.\\n\uAC04\uC7A5 \uBCA0\uC774\uC2A4\uC758 \uC18C\uC2A4 \uB355\uBD84\uC5D0 \uACE0\uC18C\uD55C \uD5A5\uC774 \uB09C\uB2E4.",
  "\uAD00\uB3D9 \uCD9C\uC2E0\uC778 \uC8FC\uC778\uC7A5\uC774 \uC790\uC2E0 \uC788\uAC8C \uB9CC\uB4E0 \uD06C\uB808\uC774\uD504.\\n\uB538\uAE30\uC640 \uCD08\uCF5C\uB9BF\uC744 \uD1A0\uD551\uC73C\uB85C \uC0AC\uC6A9\uD588\uB2E4.",
  "\uAD00\uB3D9 \uCD9C\uC2E0\uC778 \uC8FC\uC778\uC7A5\uC774 \uC790\uC2E0 \uC788\uAC8C \uB9CC\uB4E0 \uD06C\uB808\uC774\uD504.\\n\uB538\uAE30\uC640 \uD718\uD551\uD06C\uB9BC\uC744 \uD1A0\uD551\uC73C\uB85C \uC0AC\uC6A9\uD588\uB2E4.",
  "\uAD00\uB3D9 \uCD9C\uC2E0\uC778 \uC8FC\uC778\uC7A5\uC774 \uC790\uC2E0 \uC788\uAC8C \uB9CC\uB4E0 \uD06C\uB808\uC774\uD504.\\n\uCD08\uCF5C\uB9BF\uACFC \uBC14\uB098\uB098\uB97C \uD1A0\uD551\uC73C\uB85C \uC0AC\uC6A9\uD588\uB2E4.",
  "\uBBFC\uD2B8 \uD5A5\uC740 \uAC15\uD558\uACE0 \uCD08\uCF5C\uB9BF\uC740 \uC501\uC4F8\uD558\uB2E4.\\n\uAC1C\uC131\uC774 \uAC15\uD574\uC11C \uC911\uB3C5\uC131\uC774 \uC788\uB2E4.",
  "\uC0AC\uAC01\uC0AC\uAC01\uD55C \uC2DD\uAC10\uC774 \uAE30\uBD84 \uC88B\uB2E4.\\n\uB2E8\uB9DB\uB3C4 \uAC15\uD558\uC9C0 \uC54A\uC544\uC11C \uC9C8\uB9AC\uC9C0 \uC54A\uB294\uB2E4.",
  "\uC0DD\uB538\uAE30\uB97C \uAC08\uC544\uC11C \uB9CC\uB4E4\uC5C8\uAE30 \uB54C\uBB38\uC5D0\\n\uC2E0\uC120\uD55C \uB2E8\uB9DB\uC744 \uB290\uB084 \uC218 \uC788\uB2E4.",
  "\uC644\uC804\uD788 \uC775\uC740 \uB9DD\uACE0\uB9CC\uC744 \uC5C4\uC120\uD574\uC11C \uC0AC\uC6A9\uD588\uB2E4.\\n\uD600\uAC00 \uB9C8\uBE44\uB420 \uC815\uB3C4\uB85C \uB2EC\uC544\uC11C \uD638\uBD88\uD638\uAC00 \uAC08\uB9B0\uB2E4.",
  "\uC801\uB2F9\uD55C \uC9E0\uB9DB\uC774 \uB098\uB294 \uBCA0\uBCA0\uC194\uD2B8\uC758 \uC18C\uAE08\uC744 \uC0AC\uC6A9\uD55C\\n\uAC00\uAC8C\uC758 \uAC04\uD310 \uC544\uC774\uC2A4\uD06C\uB9BC.",
  "\uC911\uB3C5\uC131\uC774 \uC788\uB294 \uB9E4\uCF64\uB2EC\uCF64\uD55C \uC18C\uC2A4 \uB355\uBD84\uC5D0\\n\uC740\uADFC\uD55C \uC778\uAE30\uB97C \uC790\uB791\uD558\uB294 \uBA54\uB274.",
