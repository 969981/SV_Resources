  "\uC544\uCE74\uB370\uBBF8 \uC250\uC774\uD06C",
  "\uC544\uCE74\uB370\uBBF8 \uD3EC\uD14C\uC774\uD1A0",
  "\uC544\uCE74\uB370\uBBF8 \uC815\uC2DD",
  "\uB9CE\uC740 \uC591\uC758 \uD584\uBC84\uADF8\uC640 \uCE58\uC988\uB85C\\n\uC544\uCE74\uB370\uBBF8\uC758 \uBB38\uC7A5\uC744 \uD45C\uD604\uD55C \uD2B9\uB300\uD615 \uD53C\uC790.",
  "\uC794\uC774 \uB118\uCE60 \uC815\uB3C4\uB85C \uC544\uC774\uC2A4\uD06C\uB9BC\uACFC\\n\uACFC\uC77C\uC744 \uAC00\uB4DD \uCC44\uC6B4 \uCC28\uAC00\uC6B4 \uC74C\uB8CC.",
  "\uD559\uC0DD\uB4E4\uC758 \uBC30\uB97C \uCC44\uC6CC \uC8FC\uACE0 \uC2F6\uB2E4\uB294 \uC5F4\uC758\uAC00\\n\uC678\uD615\uC5D0\uC11C\uB3C4 \uB4DC\uB7EC\uB098\uB294 \uC0B0\uB354\uBBF8 \uAC19\uC740 \uAC10\uC790\uD280\uAE40.",
