  "\uB9E4\uC6B4\uB9DB\uC744 \uB354\uD574\uC11C\\n\uC18D \uC7AC\uB8CC\uC758 \uAC10\uCE60\uB9DB\uC744 \uBCF4\uB2E4 \uAC15\uC870\uC2DC\uD0A8 \uC0CC\uB4DC\uC704\uCE58.",
  "\uD6C4\uB974\uCE20 \uC0CC\uB4DC\uC704\uCE58\uC640 \uB2EE\uC740 \uC0CC\uB4DC\uC704\uCE58.\\n\uB2E4\uB978 \uC810\uC774\uC790 \uD3EC\uC778\uD2B8\uB294 \uBC84\uD130\uB2E4.",
  "\uC18D \uC7AC\uB8CC\uC758 \uB2E8\uB9DB\uC744 \uB3CB\uC6B0\uAE30 \uC704\uD574\\n\uBBF8\uB7C9\uC758 \uC18C\uAE08\uC744 \uB354\uD55C \uC0CC\uB4DC\uC704\uCE58.",
