  "\uC0D0\uB7EC\uB4DC\uCC98\uB7FC \uBA39\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uD1A0\uB9C8\uD1A0\uB97C \uB9CE\uC774 \uB123\uC73C\uBA74 \uBAB8\uC5D0\uB3C4 \uC88B\uB2E4.",
  "\uAF64\uB098 \uAC74\uAC15\uC5D0 \uC88B\uC740 \uC0CC\uB4DC\uC704\uCE58.\\n\uD0A4\uC704\uC758 \uC2E0\uB9DB\uC774 \uD6CC\uB96D\uD55C \uC5ED\uD560\uC744 \uD558\uACE0 \uC788\uB2E4.",
  "\uCC44\uC18C\uC640 \uACFC\uC77C\uB9CC \uB4E4\uC5B4\uAC04 \uC0CC\uB4DC\uC704\uCE58.\\n\uCC44\uC18C\uB97C \uC88B\uC544\uD558\uC9C0 \uC54A\uB294 \uC0AC\uB78C\uC5D0\uAC8C\uB3C4 \uCD94\uCC9C\uD55C\uB2E4.",
