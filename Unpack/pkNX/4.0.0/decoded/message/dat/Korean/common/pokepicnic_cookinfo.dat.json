  "\uCC44\uC18C\uB85C \uC2B9\uBD80\uD558\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uBB3C\uB0C9\uC774\uB97C \uB9CE\uC774 \uB123\uC73C\uBA74 \uB9DB\uC774 \uC815\uB3C8\uB41C\uB2E4.",
  "\uCC44\uC18C\uB85C \uB9CC\uB4DC\uB294 \uC0CC\uB4DC\uC704\uCE58\uC758 \uC644\uC131\uD615.\\n\uC2A4\uD30C\uC774\uC2A4\uC758 \uC591\uC5D0 \uB530\uB77C \uD004\uB9AC\uD2F0\uAC00 \uD06C\uAC8C \uBC14\uB010\uB2E4.",
  "\uD3EC\uB9CC\uAC10\uC774 \uB192\uC740 \uC2DD\uC7AC\uB8CC\uB9CC\uC73C\uB85C \uB9CC\uB4E0\uB2E4.\\n\uAE30\uBCF8\uC801\uC73C\uB85C \uC591\uC744 \uC911\uC2DC\uD55C \uC0CC\uB4DC\uC704\uCE58\uB2E4.",
  "\uB4E0\uB4E0\uD55C \uD3EC\uB9CC\uAC10\uC774 \uCF58\uC149\uD2B8\uC778 \uC0CC\uB4DC\uC704\uCE58.\\n\uB9DB\uBCF4\uB2E4 \uC591\uC744 \uC6B0\uC120\uC2DC\uD588\uB2E4.",
  "\uD3EC\uB9CC\uAC10\uC744 \uCD94\uAD6C\uD558\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uAC74\uAC15\uC5D0 \uC8FC\uC758\uB97C \uAE30\uC6B8\uC774\uBA70 \uBA39\uC5B4\uC57C \uD55C\uB2E4.",
  "\uC2E0\uB9DB \uB355\uBD84\uC5D0 \uC0B0\uB73B\uD558\uAC8C \uBA39\uC744 \uC218 \uC788\uC9C0\uB9CC\\n\uCE7C\uB85C\uB9AC \uC12D\uCDE8\uB7C9\uC740 \uBCC0\uD568\uC5C6\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC774\uB984 \uADF8\uB300\uB85C \uC5B4\uB978 \uCDE8\uD5A5\uC758 \uC0CC\uB4DC\uC704\uCE58.\\n\uB9E4\uCF64\uD55C \uCC44\uC18C\uB294 \uC5B4\uB978\uC758 \uC99D\uAC70\uB2E4.",
  "\uC870\uBBF8\uB8CC\uC758 \uBC38\uB7F0\uC2A4\uB97C \uC870\uC808\uD558\uAE30 \uC5B4\uB824\uC6B4 \uC0CC\uB4DC\uC704\uCE58.\\n\uBC14\uC9C8\uC758 \uD5A5\uC774 \uC2DD\uC695\uC744 \uB3CB\uC6B4\uB2E4.",
  "\uB9E4\uC6B4\uB9DB\uC774 \uB354\uD574\uC838 \uD55C\uCE35 \uAE4A\uC740 \uC5B4\uB978\uC758 \uB9DB\uC774 \uB09C\uB2E4.\\n\uD638\uBD88\uD638\uAC00 \uAC08\uB9AC\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uAE30\uBCF8\uC801\uC73C\uB85C \uB9E4\uC6B4 \uC0CC\uB4DC\uC704\uCE58.\\n\uC790\uADF9\uC801\uC778 \uAC78 \uBABB \uBA39\uB294 \uC0AC\uB78C\uC5D0\uAC8C\uB294 \uCD94\uCC9C\uD558\uC9C0 \uC54A\uB294\uB2E4.",
  "\uCC44\uC18C\uAC00 \uC911\uC2EC\uC774 \uB418\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uB3C5\uD2B9\uD55C \uC18C\uC2A4\uAC00 \uC790\uADF9\uC801\uC774\uB2E4.",
  "\uCC44\uC18C\uAC00 \uC8FC\uC5ED\uC778 \uC0CC\uB4DC\uC704\uCE58.\\n\uC624\uC774\uB97C \uB123\uC740 \uB4A4\uC5D0 \uBC14\uB85C \uBA39\uB3C4\uB85D \uD558\uC790.",
  "\uCC44\uC18C \uC560\uD638\uAC00\uC5D0\uAC8C \uBC14\uCE58\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uB9C8\uC694\uB124\uC988\uB294 \uC545\uC13C\uD2B8 \uC815\uB3C4\uB85C\uB9CC \uCCA8\uAC00\uD558\uB294 \uAC8C \uC88B\uB2E4.",
  "\uCC44\uC18C\uB97C \uC704\uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uAC00\uBCBC\uC6B4 \uB2E8\uB9DB \uB355\uBD84\uC5D0 \uCC44\uC18C\uC758 \uAC10\uCE60\uB9DB\uC774 \uB450\uB4DC\uB7EC\uC9C4\uB2E4.",
  "\uBC84\uD130\uC758 \uB2E8\uB9DB\uACFC \uD638\uC2A4\uB798\uB514\uC2DC\uC758 \uB9E4\uC6B4\uB9DB\uC774\\n\uC798 \uC5B4\uC6B8\uB9AC\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC544\uBCF4\uCE74\uB3C4\uC758 \uC9C4\uD55C \uB9DB\uC774 \uC798 \uBC30\uC5B4 \uC788\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uACFC\uC77C\uC758 \uBC38\uB7F0\uC2A4\uAC00 \uB9DB\uC758 \uD575\uC2EC\uC774\uB2E4.",
  "\uB2E8\uB9DB\uACFC \uB9E4\uC6B4\uB9DB\uC758 \uBC38\uB7F0\uC2A4\uAC00 \uC911\uC694\uD558\uB2E4.\\n\uCE58\uC988\uB294 \uB4EC\uBFCD \uB123\uC5B4\uC57C \uB9DB\uC788\uB2E4.",
  "\uC740\uADFC\uD55C \uC4F4\uB9DB \uB355\uBD84\uC5D0 \uB9E4\uCF64\uB2EC\uCF64\uD55C \uB9DB\uC5D0\\n\uC870\uD654\uAC00 \uC0DD\uAE34 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC18D \uC7AC\uB8CC\uC758 \uB9DB\uC774 \uAC15\uD558\uAE30 \uB54C\uBB38\uC5D0\\n\uC870\uBBF8\uB8CC\uB294 \uC801\uAC8C \uB123\uB294 \uAC8C \uB9DB\uC788\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uD638\uD654\uB86D\uACE0 \uADC0\uD55C \uC2DD\uC7AC\uB8CC\uB97C \uC0AC\uC6A9\uD558\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uB450\uBD80 \uB355\uBD84\uC5D0 \uB354\uC6B1 \uB4E0\uB4E0\uD55C \uD3EC\uB9CC\uAC10\uC774 \uB290\uAEF4\uC9C4\uB2E4.",
  "\uC2DD\uC7AC\uB8CC\uC758 \uBC38\uB7F0\uC2A4\uB97C \uB9DE\uCD94\uAE30\uAC00 \uC5B4\uB824\uC6B4 \uC0CC\uB4DC\uC704\uCE58.\\n\uAC04\uC740 \uC57D\uAC04 \uC138\uAC8C \uD558\uB294 \uD3B8\uC774 \uB9DB\uC788\uB2E4.",
  "\uADF9\uC0C1\uC758 \uB9E4\uC6B4\uB9DB\uC73C\uB85C \uC790\uAE30\uC8FC\uC7A5\uC774 \uAC15\uD55C \uC2DD\uC7AC\uB8CC\uB4E4\uC744\\n\uD558\uB098\uB85C \uC5B4\uC6B0\uB7EC\uC9C0\uAC8C \uD55C \uAC78\uC791 \uC0CC\uB4DC\uC704\uCE58.",
  "\uB450\uBD80 \uC560\uD638\uAC00\uAC00 \uAC1C\uBC1C\uD55C \uB808\uC2DC\uD53C.\\n\uC591\uC774 \uD478\uC9D0\uD55C \uC0CC\uB4DC\uC704\uCE58.",
  "\uB09C\uC774\uB3C4\uAC00 \uAF64 \uB192\uC740 \uC0CC\uB4DC\uC704\uCE58.\\n\uBB3C\uAE30\uB97C \uD655\uC2E4\uD558\uAC8C \uBE80 \uB450\uBD80\uB97C \uC0AC\uC6A9\uD574\uC57C \uD55C\uB2E4.",
  "\uB2F4\uBC31\uD55C \uB450\uBD80\uC640 \uBB3C\uB0C9\uC774\uC758 \uC4F4\uB9DB\uC774 \uC5B4\uC6B8\uB9AC\uB294\\n\uC2E0\uAE30\uD55C \uC0CC\uB4DC\uC704\uCE58.",
  "\uADC0\uC911\uD55C \uC2A4\uD30C\uC774\uC2A4\uC758 \uC9E0\uB9DB \uB355\uBD84\uC5D0\\n\uB450\uBD80\uC5D0 \uC7A0\uC7AC\uB41C \uAC10\uCE60\uB9DB\uC774 \uBE5B\uB098\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uB3C4\uC804 \uC815\uC2E0\uC774 \uB118\uCE58\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uC57D\uAC04 \uC775\uD78C \uCE74\uB808\uD30C\uC6B0\uB354\uB97C \uC0AC\uC6A9\uD55C\uB2E4.",
  "\uD560\uB77C\uD398\uB1E8\uC758 \uC790\uADF9\uC801\uC778 \uB9E4\uC6B4\uB9DB\uC774\\n\uCE74\uB808\uC758 \uD48D\uBBF8\uB97C \uB3CB\uC6B0\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uB9E4\uCF64\uD55C \uB9DB\uC744\\n\uC54C\uC774 \uBD80\uB4DC\uB7FD\uAC8C \uCF54\uD305\uD574 \uC8FC\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC740\uC740\uD55C \uB2EC\uCF64\uD568\uC774 \uB9DB\uC758 \uD0A4\uD3EC\uC778\uD2B8.\\n\uAE4A\uC774\uC640 \uC9C4\uD55C \uB9DB\uC744 \uC790\uC544\uB0B4\uACE0 \uC788\uB2E4.",
  "\uC5B4\uB9C8\uC5B4\uB9C8\uD55C \uC591\uC758 \uC0CC\uB4DC\uC704\uCE58.\\n\uD478\uC9D0\uD55C \uC591\uC774\uC57C\uB9D0\uB85C \uC9C4\uB9AC\uB2E4.",
  "\uC591\uC744 \uC911\uC2DC\uD558\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uB9DB\uC5D0 \uB300\uD574\uC120 \uB531\uD788 \uC5B8\uAE09\uC774 \uC5C6\uB2E4.",
  "\uC624\uC9C1 \uC591\uC5D0\uB9CC \uC2EC\uD608\uC744 \uAE30\uC6B8\uC778 \uC0CC\uB4DC\uC704\uCE58.\\n\uAC04\uC744 \uC798\uD558\uBA74 \uB9DB\uB3C4 \uAD1C\uCC2E\uB2E4.",
  "\uC591\uB9CC\uC774 \uC544\uB2C8\uB77C \uB9DB\uB3C4 \uADF8\uB7ED\uC800\uB7ED \uB9DB\uC788\uB294 \uAC74\\n\uC2A4\uD30C\uC774\uC2A4 \uB355\uBD84\uC774\uB2E4.",
  "\uC2A4\uC2DC\uB97C \uC7AC\uD604\uD558\uACE0\uC790 \uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uC758\uC678\uB85C \uB9DB\uC788\uC5B4\uC11C \uB180\uB77C\uAC8C \uB41C\uB2E4.",
  "\uC2A4\uC2DC\uB97C \uC7AC\uD604\uD558\uACE0\uC790 \uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uBB3C\uB0C9\uC774\uC758 \uC4F4\uB9DB\uC774 \uC798 \uBC30\uC5B4 \uC788\uB2E4.",
  "\uC2A4\uC2DC \uC560\uD638\uAC00\uAC00 \uACE0\uC548\uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uD478\uC9D0\uD55C \uC591\uB3C4 \uC774 \uC0CC\uB4DC\uC704\uCE58\uC758 \uB9E4\uB825 \uC911 \uD558\uB098\uB2E4.",
  "\uC2A4\uC2DC \uC0CC\uB4DC\uC704\uCE58\uC758 \uC644\uC131\uD615.\\n\uC0B0\uB73B\uD55C \uC2E0\uB9DB\uC774 \uC77C\uD488\uC774\uB2E4."
]
