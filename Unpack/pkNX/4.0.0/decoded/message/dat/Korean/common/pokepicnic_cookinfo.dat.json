  "\uC591\uC0C1\uCD94\uC758 \uC2E0\uC120\uD55C \uC2DD\uAC10\uACFC\\n\uD280\uAE40\uC774 \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uD638\uC2A4\uB798\uB514\uC2DC\uC758 \uC0B0\uB73B\uD55C \uB9E4\uC6B4\uB9DB \uB355\uBD84\uC5D0\\n\uB9E4\uC6B0 \uBA39\uAE30 \uC88B\uC740 \uC0CC\uB4DC\uC704\uCE58.",
