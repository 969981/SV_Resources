  "\uBC14\uC9C8\uC758 \uD5A5\uC774 \uC2DD\uC695\uC744 \uB3CB\uC6B0\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uD6C4\uCD94\uB97C \uB9CE\uC774 \uB123\uB294 \uD3B8\uC774 \uBC38\uB7F0\uC2A4\uAC00 \uC7A1\uD600\uC11C \uC88B\uB2E4.",
  "\uAC15\uD55C \uC9E0\uB9DB\uC774 \uCE58\uC988\uC758 \uAC10\uCE60\uB9DB\uACFC\\n\uC9C4\uD55C \uB9DB\uC744 \uB3CB\uC6B0\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uD584\uBC84\uADF8\uAC00 \uC911\uC2EC\uC774 \uB418\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uBE44\uB2C8\uAC70\uC758 \uC2E0\uB9DB\uC774 \uD3EC\uC778\uD2B8.",
