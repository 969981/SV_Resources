  "\uC740\uADFC\uD558\uAC8C \uC2E0\uB9DB\uC774 \uB290\uAEF4\uC9C0\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uC2A4\uD30C\uC774\uC2A4\uB294 \uADF9\uC18C\uB7C9\uB9CC \uC0AC\uC6A9\uD574\uB3C4 \uB41C\uB2E4.",
  "\uAC74\uAC15\uC5D0 \uC88B\uACE0 \uC218\uBD84\uB7C9\uC774 \uB9CE\uC740 \uC0CC\uB4DC\uC704\uCE58.\\n\uCC44\uC18C\uC758 \uC2E0\uC120\uB3C4\uAC00 \uB9DB\uC744 \uACB0\uC815\uD55C\uB2E4.",
