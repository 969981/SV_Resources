[
  "\uD584\uACFC \uBC84\uD130\uB9CC\uC73C\uB85C \uB9CC\uB4E0 \uC2EC\uD50C\uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uC18C\uBC15\uD558\uAE30\uC5D0 \uAE30\uAD50\uB97C \uBD80\uB9B4 \uC218 \uC5C6\uB2E4.",
  "\uC4F4\uB9DB\uC744 \uB354\uD55C \uC7A0\uBD09\uBD48\uB974.\\n\uC4F4\uB9DB\uC744 \uC0AC\uB791\uD55C\uB2E4\uBA74 \uBA39\uC5B4 \uBD10\uC57C \uD55C\uB2E4.",
  "\uB2E8\uB9DB\uC744 \uB354\uD55C \uC7A0\uBD09\uBD48\uB974.\\n\uADF9\uC0C1\uC758 \uB2E8\uB9DB\uC744 \uC990\uAE30\uACE0 \uC2F6\uC744 \uB54C \uCD94\uCC9C\uD55C\uB2E4.",
  "\uC9E0\uB9DB\uC744 \uB354\uD55C \uC7A0\uBD09\uBD48\uB974.\\n\uBB35\uC9C1\uD55C \uC9E0\uB9DB \uB355\uBD84\uC5D0 \uB9E4\uC6B0 \uB9DB\uC788\uB2E4.",
  "\uC2E0\uB9DB\uC744 \uB354\uD55C \uC7A0\uBD09\uBD48\uB974.\\n\uAC15\uB82C\uD55C \uC2E0\uB9DB\uC774 \uC911\uB3C5\uC131\uC744 \uBD88\uB7EC\uC77C\uC73C\uD0A8\uB2E4.",
  "\uB9E4\uC6B4\uB9DB\uC744 \uB354\uD55C \uC7A0\uBD09\uBD48\uB974.\\n\uB9E4\uC6B4\uB9DB\uC744 \uC88B\uC544\uD55C\uB2E4\uBA74 \uC9C0\uB098\uCE60 \uC218 \uC5C6\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC4F4\uB9DB\uC758 \uADF9\uCE58\uB77C\uACE0 \uD560 \uC218 \uC788\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uC2A4\uD30C\uC774\uC2A4\uB294 \uC544\uB08C\uC5C6\uC774 \uBFCC\uB9AC\uB294 \uAC83\uC774 \uC88B\uB2E4.",
  "\uC9E0\uB9DB\uC744 \uC990\uAE30\uB294 \uB9C8\uB2C8\uC544\uC6A9 \uC0CC\uB4DC\uC704\uCE58.\\n\uBA39\uC744 \uB54C\uB294 \uB4DC\uB9C1\uD06C\uAC00 \uD544\uC218\uB2E4.",
  "\uBB34\uC2DC\uBB34\uC2DC\uD560 \uC815\uB3C4\uB85C \uB2EC\uCF64\uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uC2A4\uD30C\uC774\uC2A4\uB97C \uB9CE\uC774 \uBFCC\uB9AC\uB294 \uAC83\uC774 \uB9DB\uC758 \uBE44\uACB0\uC774\uB2E4.",
  "\uC2E0\uB9DB \uB9C8\uB2C8\uC544\uC5D0\uAC8C \uBC14\uCE58\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uC2A4\uD30C\uC774\uC2A4\uAC00 \uC2E0\uC120\uD560\uC218\uB85D \uC2E0\uB9DB\uC774 \uAC15\uD558\uB2E4.",
  "\uD600\uB97C \uCC0C\uB974\uB294 \uB4EF\uD55C \uB9E4\uC6B4\uB9DB\uC758 \uC0CC\uB4DC\uC704\uCE58.\\n\uB9E4\uC6B4 \uAC78 \uC798 \uBABB \uBA39\uB294 \uC0AC\uB78C\uC740 \uC8FC\uC758\uAC00 \uD544\uC694\uD558\uB2E4.",
  "\uC7BC\uACFC \uB538\uAE30\uB9CC\uC744 \uC0AC\uC6A9\uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uC2EC\uD50C\uD558\uAE30 \uB54C\uBB38\uC5D0 \uC27D\uAC8C \uC9C8\uB9AC\uC9C0 \uC54A\uB294\uB2E4.",
  "\uC694\uAD6C\uB974\uD2B8 \uB355\uBD84\uC5D0 \uB2EC\uCF64\uD568\uC774 \uB450\uB4DC\uB7EC\uC838\uC11C\\n\uB354\uC6B1 \uC9C4\uD55C \uB9DB\uC774 \uB09C\uB2E4.",
  "\uD478\uC9D0\uD574\uC11C \uAC04\uC2DD\uC73C\uB85C\uB3C4 \uC2DD\uC0AC \uB300\uC6A9\uC73C\uB85C\uB3C4 OK.\\n\uB2F9\uB3C4 \uB192\uC740 \uD30C\uC778\uC560\uD50C\uC744 \uACE0\uB974\uB294 \uAC83\uC774 \uC88B\uB2E4.",
  "\uC2A4\uD30C\uC774\uC2A4 \uB355\uBD84\uC5D0 \uBAA8\uB4E0 \uC18D \uC7AC\uB8CC\uAC00\\n\uC870\uD654\uB86D\uAC8C \uC5B4\uC6B0\uB7EC\uC9C4 \uC0CC\uB4DC\uC704\uCE58\uC758 \uC644\uC131\uD615.",
  "\uB545\uCF69\uBC84\uD130\uC640 \uBC14\uB098\uB098\uC758 \uC870\uD569\uC774 \uC758\uC678\uB85C \uC798 \uC5B4\uC6B8\uB824\\n\uD3EC\uB9CC\uAC10\uC744 \uB290\uB084 \uC218 \uC788\uB2E4.",
  "\uBC84\uD130\uAC00 \uB354\uD574\uC838\uC11C\\n\uBB35\uC9C1\uD55C \uB4E0\uB4E0\uD568\uC744 \uB290\uB084 \uC218 \uC788\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC7BC\uC758 \uB2EC\uCF64\uD568\uC774 \uB354\uD574\uC838\uC11C\\n\uB354\uC6B1 \uB4E0\uB4E0\uD55C \uD3EC\uB9CC\uAC10\uC744 \uB290\uB084 \uC218 \uC788\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC77C\uBD80\uB7EC \uAC15\uD55C \uB9E4\uC6B4\uB9DB\uC744 \uB354\uD588\uB354\uB2C8\\n\uBB18\uD55C \uC911\uB3C5\uC131\uC744 \uB760\uAC8C \uB418\uC5C8\uB2E4.",
  "\uC9C0\uADF9\uD788 \uC2EC\uD50C\uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uC62C\uB9AC\uBE0C\uC624\uC77C\uC740 \uD2B9\uD788 \uC5C4\uC120\uD574\uC57C \uD55C\uB2E4.",
  "\uD53C\uD074\uC758 \uC2E0\uB9DB\uACFC \uBB3C\uB0C9\uC774\uC758 \uD48D\uBBF8\uAC00\\n\uC0B0\uB4E4\uBC14\uB78C\uCC98\uB7FC \uC5B4\uC6B0\uB7EC\uC9C4 \uC0CC\uB4DC\uC704\uCE58.",
  "\uBC14\uC9C8\uC758 \uD5A5\uC774 \uB354\uD574\uC838\uC11C\\n\uD48D\uBBF8\uAC00 \uAE4A\uC5B4\uC9C4 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC2EC\uD50C\uD558\uBA74\uC11C\uB3C4 \uAC74\uAC15\uC5D0 \uC88B\uC740 \uC0CC\uB4DC\uC704\uCE58.\\n\uC2E0\uB9DB\uC774 \uC911\uB3C5\uC131\uC744 \uBD88\uB7EC\uC77C\uC73C\uD0A8\uB2E4.",
  "\uC2EC\uD50C\uD558\uBA74\uC11C\uB3C4 \uC2E4\uC18D \uC788\uACE0 \uB9DB\uC788\uB2E4.\\n\uBE75\uC744 \uBC14\uC0AD\uD558\uAC8C \uAD6C\uC6CC\uC11C \uD48D\uBBF8\uB97C \uB354\uD574\uB3C4 \uC88B\uB2E4.",
  "\uC720\uBD84\uC758 \uB2EC\uCF64\uD568 \uB355\uBD84\uC5D0 \uC2E0\uB9DB\uC774 \uB450\uB4DC\uB7EC\uC9C0\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uBC84\uD130\uB97C \uB108\uBB34 \uB9CE\uC774 \uB123\uC9C0 \uC54A\uB3C4\uB85D \uC8FC\uC758\uD574\uC57C \uD55C\uB2E4.",
  "\uB9C8\uBA40\uB808\uC774\uB4DC\uC758 \uC2E0\uB9DB\uC774 \uAC15\uD560\uC218\uB85D \uB9DB\uC788\uB2E4.\\n\uCE7C\uB85C\uB9AC\uB97C \uC870\uAE08 \uC2E0\uACBD \uC368\uC57C \uD558\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uB9C8\uBB34\uB9AC\uB85C \uB354\uD574\uC9C0\uB294 \uC9E0\uB9DB\uC774 \uB9DB\uC744 \uACB0\uC815\uD55C\uB2E4.\\n\uC808\uBB18\uD55C \uBC38\uB7F0\uC2A4\uB85C \uC644\uC131\uB418\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uD5C8\uBE0C\uD5A5\uC774 \uD5A5\uAE0B\uD55C \uC18C\uC2DC\uC9C0\uC640\\n\uCF00\uCCA9\uC774 \uB4E4\uC5B4\uAC04 \uC0CC\uB4DC\uC704\uCE58.",
  "\uBA38\uC2A4\uD130\uB4DC\uC758 \uC2E0\uB9DB\uACFC \uB9E4\uC6B4\uB9DB \uB355\uBD84\uC5D0\\n\uB9DB\uC5D0 \uAE4A\uC774\uAC00 \uB354\uD574\uC9C4 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC2E0\uC120\uD55C \uCC44\uC18C\uC640 \uC18C\uC2DC\uC9C0\uB77C\uB294,\\n\uB9DB\uC774 \uC5C6\uC73C\uB824\uC57C \uC5C6\uC744 \uC218 \uC5C6\uB294 \uC870\uD569\uC758 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC815\uC11D\uC801\uC778 \uB9DB\uC744 \uAC00\uC9C4 \uC0CC\uB4DC\uC704\uCE58.\\n\uC4F4\uB9DB\uC774 \uC18D \uC7AC\uB8CC\uB97C \uD558\uB098\uB85C \uC5B4\uC6B0\uB7EC\uC9C0\uAC8C \uD55C\uB2E4.",
  "\uAD50\uBB18\uD55C \uC870\uD569\uC758 \uC0CC\uB4DC\uC704\uCE58.\\n\uCE74\uB808\uD30C\uC6B0\uB354\uB294 \uAC00\uBCCD\uAC8C \uC775\uD788\uB294 \uAC8C \uC88B\uB2E4.",
  "\uB9E4\uC6B4\uB9DB\uC774 \uB354\uD574\uC838 \uBA39\uAE30 \uC88B\uC544\uC84C\uC9C0\uB9CC\\n\uC5ED\uC2DC \uD638\uBD88\uD638\uAC00 \uAC08\uB9AC\uB294 \uC0CC\uB4DC\uC704\uCE58\uB2E4.",
  "\uD1A0\uB9C8\uD1A0\uC758 \uAC10\uCE60\uB9DB \uB355\uBD84\uC5D0 \uB354\uC6B1 \uBA39\uAE30 \uC88B\uC544\uC84C\uC9C0\uB9CC\\n\uADF8\uB7FC\uC5D0\uB3C4 \uD638\uBD88\uD638\uAC00 \uAC08\uB9AC\uB294 \uC0CC\uB4DC\uC704\uCE58\uB2E4.",
  "\uAC15\uB82C\uD55C \uB9E4\uC6B4\uB9DB\uC774 \uC790\uADF9\uC801\uC778 \uC0CC\uB4DC\uC704\uCE58.\\n\uC5EC\uC804\uD788 \uC57C\uC2EC\uC801\uC778 \uC870\uD569\uC774\uB2E4.",
  "\uAC04\uC2DD\uC73C\uB85C \uBA39\uAE30\uC5D0 \uB531 \uC88B\uC740 \uC0CC\uB4DC\uC704\uCE58.\\n\uB2EC\uCF64\uD55C \uC694\uAD6C\uB974\uD2B8\uB97C \uB123\uC5B4 \uB9CC\uB4E0\uB2E4.",
  "\uD0A4\uC704\uC758 \uC544\uB984\uB2E4\uC6B4 \uCD08\uB85D\uBE5B \uB355\uBD84\uC5D0\\n\uB208\uB3C4 \uC785\uB3C4 \uC990\uAC70\uC6B4 \uC0CC\uB4DC\uC704\uCE58\uB2E4.",
  "3\uC885\uB958\uB098 \uB418\uB294 \uACFC\uC77C\uC774 \uB4E4\uC5B4\uAC04 \uC0CC\uB4DC\uC704\uCE58.\\n\uCC28\uAC11\uAC8C \uBA39\uC5B4\uB3C4 \uC77C\uD488\uC774\uB2E4.",
  "\uB514\uC800\uD2B8 \uC0CC\uB4DC\uC704\uCE58\uC758 \uC644\uC131\uD615\uC774\uB77C \uD560 \uC218 \uC788\uB2E4.\\n\uC2A4\uD30C\uC774\uC2A4\uC758 \uB9DB\uC740 \uC740\uADFC\uD558\uAC8C \uB098\uB294 \uC815\uB3C4\uB85C \uCDA9\uBD84\uD558\uB2E4.",
  "\uC2E0\uB9DB\uACFC \uAC10\uCE60\uB9DB\uC758 \uBC38\uB7F0\uC2A4\uAC00 \uD0A4\uD3EC\uC778\uD2B8.\\n\uB9C8\uBA40\uB808\uC774\uB4DC\uB97C \uB109\uB109\uD558\uAC8C \uB123\uB294 \uAC83\uC774 \uC131\uACF5\uC758 \uBE44\uACB0\uC774\uB2E4.",
  "\uD30C\uC778\uC560\uD50C \uB355\uBD84\uC5D0 \uD2B8\uB85C\uD53C\uCEEC\uD55C \uBD84\uC704\uAE30\uAC00 \uB354\uD574\uC84C\uB2E4.\\n\uC2E0\uB9DB\uC774 \uAC15\uD55C \uD3B8\uC774 \uB9DB\uC788\uB2E4.",
  "\uC660\uC9C0 \uC774\uAD6D\uC801\uC778 \uB290\uB08C\uC774 \uB4DC\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uB9E4\uC6B4\uB9DB\uC774 \uB354\uD574\uC838 \uB9DB\uC5D0 \uAE4A\uC774\uAC00 \uC0DD\uACBC\uB2E4.",
  "\uD2B8\uB85C\uD53C\uCEEC\uC774\uB77C\uB294 \uBA85\uCE6D\uC5D0 \uAC78\uB9DE\uC740 \uC0CC\uB4DC\uC704\uCE58.\\n\uC2A4\uD30C\uC774\uC2A4\uB85C \uB9DB\uC774 \uC644\uC131\uB418\uC5C8\uB2E4.",
  "\uC544\uBCF4\uCE74\uB3C4\uAC00 \uC775\uC740 \uC815\uB3C4\uC5D0 \uB530\uB77C \uB9DB\uC774 \uB2EC\uB77C\\n\uC9C8\uB9AC\uC9C0 \uC54A\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uBCF4\uD3B8\uC801\uC778 \uCDE8\uD5A5\uC758 \uC18D \uC7AC\uB8CC\uB85C \uB9CC\uB4E4\uC5B4\uC11C\\n\uB9DB\uC5C6\uAE30\uAC00 \uD798\uB4E0 \uC0CC\uB4DC\uC704\uCE58.",
  "\uB9DB\uC774 \uC5C6\uC73C\uB824\uC57C \uC5C6\uC744 \uC218 \uC5C6\uB294 \uC18D \uC7AC\uB8CC \uB355\uC5D0\\n\uAC71\uC815 \uC5C6\uC774 \uBA39\uC744 \uC218 \uC788\uB294 \uB9DB\uC788\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uC548\uC815\uC801\uC778 \uC0CC\uB4DC\uC704\uCE58\uC758 \uC644\uC131\uD615.\\n\uC9E0\uB9DB\uC774 \uC798 \uBC30\uC5B4 \uC788\uC5B4 \uB9E4\uC6B0 \uB9DB\uC788\uB2E4.",
  "\uC5B8\uC81C\uBD80\uD130 \uC720\uD589\uC774 \uC2DC\uC791\uB410\uB294\uC9C0\uB294 \uC54C \uC218 \uC5C6\uB2E4.\\n\uB808\uC2DC\uD53C\uC758 \uCD9C\uCC98\uB3C4 \uBCA0\uC77C\uC5D0 \uC2F8\uC778 \uC218\uC218\uAED8\uB07C\uC758 \uC0CC\uB4DC\uC704\uCE58.",
  "\uBA39\uC73C\uBA74 \uC624\uB7AB\uB3D9\uC548 \uBC30\uAC00 \uAEBC\uC9C0\uC9C0 \uC54A\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uC591\uC0C1\uCD94\uAC00 \uB4E4\uC5B4\uAC00\uC11C \uB354\uC6B1 \uBA39\uAE30 \uC88B\uC544\uC84C\uB2E4.",
  "\uB9E4\uC6B0 \uD478\uC9D0\uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uCD08\uB9AC\uC870\uC758 \uC9C4\uD55C \uB9DB\uC774 \uC798 \uBC30\uC5B4 \uC788\uB2E4.",
  "\uAC00\uBCBC\uC6B4 \uC4F4\uB9DB\uC774 \uC2DD\uC695\uC744 \uB3CB\uC6B4\uB2E4.\\n\uBC30\uAC00 \uB4E0\uB4E0\uD55C \uC0CC\uB4DC\uC704\uCE58\uB2E4.",
  "\uAC74\uAC15\uC5D0 \uC88B\uACE0 \uD478\uC9D0\uD55C \uC0CC\uB4DC\uC704\uCE58.\\n\uB2E8, \uAC10\uC790\uC0D0\uB7EC\uB4DC\uC758 \uD488\uC9C8\uC5D0 \uB530\uB77C \uB9DB\uC774 \uC88C\uC6B0\uB41C\uB2E4.",
  "\uCC44\uC18C\uD22C\uC131\uC774\uC9C0\uB9CC \uB9CC\uC871\uC2A4\uB7EC\uC6B4 \uC0CC\uB4DC\uC704\uCE58.\\n\uC544\uBCF4\uCE74\uB3C4\uB294 \uC870\uAE08 \uB2E8\uB2E8\uD574\uB3C4 \uB41C\uB2E4.",
  "\uC5EC\uB7EC \uC885\uB958\uC758 \uCC44\uC18C\uAC00 \uB4E4\uC5B4\uAC04 \uC0CC\uB4DC\uC704\uCE58.\\n\uAC04\uC744 \uC138\uAC8C \uD558\uB294 \uAC83\uC774 \uB9C8\uB2C8\uC544 \uC2A4\uD0C0\uC77C.",
  "\uAC10\uC790\uC0D0\uB7EC\uB4DC \uC0CC\uB4DC\uC704\uCE58\uC758 \uC644\uC131\uD615.\\n\uB2EC\uCF64\uD55C \uC2A4\uD30C\uC774\uC2A4\uAC00 \uB9DB\uC744 \uACB0\uC815\uD55C\uB2E4.",
  "\uB9E4\uC6B4\uB9DB\uC774 \uB098\uB294 \uC18C\uC2A4 \uB355\uBD84\uC5D0\\n\uCC44\uC18C\uC758 \uB2E8\uB9DB\uC774 \uC0B4\uC544\uB098\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uD53C\uB9DD\uC758 \uC4F4\uB9DB\uACFC \uB9E4\uCF64\uD55C \uC18C\uC2A4\uAC00\\n\uB9E4\uC6B0 \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uC0CC\uB4DC\uC704\uCE58.",
  "\uCC44\uC18C\uB3C4 \uCDA9\uBD84\uD788 \uC12D\uCDE8\uD560 \uC218 \uC788\uB294 \uC0CC\uB4DC\uC704\uCE58.\\n\uB9E4\uCF64\uD55C \uC18C\uC2A4\uAC00 \uCC44\uC18C\uC758 \uAC10\uCE60\uB9DB\uC744 \uB04C\uC5B4\uB0B8\uB2E4.",
