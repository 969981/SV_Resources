[
  "[VAR 0100(0000)]!\\n\uB54C\uAC00 \uB418\uC5C8\uC5B4![VAR 0114(0027)]",
  "\uC800\uC8FC\uBC1B\uC740 \uC7AC\uC559\uC758 \uBCF4\uBB3C...\\n4\uB9C8\uB9AC\uC758 \uD3EC\uCF13\uBAAC\uC740...[VAR 0114(0027)]",
  "\uC2E4\uC81C\uB85C \uC874\uC7AC\uD55C\uB2E4\uAD6C!![VAR 0114(0027)]",
  "\uD06C\uD06C\uD06D! \uC124\uB9C8 \uC2E0\uBB38\uC5D0\uC11C!!\\n\uADF8\uAC83\uB3C4 \uBAA9\uC218\uC758 \uC778\uD130\uBDF0 \uAE30\uC0AC \uB355\uBD84\uC5D0\\r\\n\uC9C4\uC0C1\uC5D0 \uB3C4\uB2EC\uD558\uAC8C \uB420 \uC904\uC774\uC57C!![VAR 0114(0027)]",
  "\uD3EC\uCF13\uBAAC\uC220\uC0AC\uB294 \uC131\uC2A4\uB7EC\uC6B4 \uB9D0\uB69D\uC744 \uC0AC\uC6A9\uD574\uC11C\\n\uC7AC\uC559\uC758 \uBCF4\uBB3C\uB4E4\uC744 \uC0AC\uB2F9\uC5D0 \uBD09\uC778\uD588\uB2E4\uACE0 \uD574.[VAR 0114(0027)]",
  "\uD55C \uB9C8\uB9AC\uB2F9 \uD558\uB098\uC758 \uC0AC\uB2F9...\\n\uC0AC\uB2F9 \uC8FC\uBCC0\uC5D0 8\uAC1C\uC758 \uB9D0\uB69D\uC744 \uBC15\uC544\uC11C\\r\\n\uC7AC\uC559\uC758 \uD798\uC744 \uC5B5\uB204\uB974\uACE0 \uC788\uB2E4\uB294 \uBAA8\uC591\uC774\uC57C.[VAR 0114(0027)]",
  "\uB2E4\uC2DC \uB9D0\uD574,\\n\uADF8 \uB9D0\uB69D\uB4E4\uC744 \uC804\uBD80 \uBF51\uC73C\uBA74![VAR 0114(0027)]",
  "\uC7AC\uC559\uC758 \uBCF4\uBB3C\uC774\uB77C \uBD88\uB9AC\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uD574\uBC29\uC2DC\uD0AC \uC218 \uC788\uB2E4\uB294 \uAC70\uC57C!![VAR 0114(0027)]",
  "[VAR 0100(0000)],\\n\uBE44\uC881\uC740 \uC0AC\uB2F9 \uC548\uC5D0 \uAC07\uD600 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC744\\r\\n\uBC16\uC73C\uB85C \uAEBC\uB0B4 \uC8FC\uACE0 \uC2F6\uC9C0 \uC54A\uC544?[VAR 0114(0027)]",
  "\uD06C\uD06C\uD06D, \uB108\uC758 \uADF8 \uC0C1\uB0E5\uD55C \uC131\uACA9\uC740\\n\uC815\uB9D0 \uC720\uC6A9\uD558\uB2E4\uB2C8\uAE4C![VAR 0114(0027)]",
  "\uC758\uC678\uB85C \uBE44\uC815\uD55C \uAD6C\uC11D\uC774 \uC788\uB124!\\n\uC5D0\uC774, \uADF8\uB7EC\uC9C0 \uB9D0\uACE0 \uAEBC\uB0B4 \uC8FC\uC790\uACE0![VAR 0114(0027)]",
  "\uD3EC\uCF13\uBAAC\uC220\uC0AC\uC758 \uC790\uC190\uC758 \uB9D0\uC5D0 \uC758\uD558\uBA74\\n\uB9D0\uB69D\uC744 \uBF51\uC73C\uB824\uBA74 \uD3EC\uCF13\uBAAC\uACFC\uC758 \uC720\uB300\uAC00\\r\\n\uD544\uC694\uD558\uB2E4\uB294 \uBAA8\uC591\uC778\uB370...[VAR 0114(0027)]",
  "\uB108 \uC815\uB3C4 \uC2E4\uB825\uC774\uB77C\uBA74 \uAC00\uB2A5\uD560 \uAC70\uC57C.[VAR 0114(0027)]",
  "\uBBFF\uB4E0 \uC548 \uBBFF\uB4E0 \uB108\uC758 \uC790\uC720\uC9C0\uB9CC,\\n\uC77C\uB2E8 \uC9C0\uB3C4\uC5D0 \uC0AC\uB2F9\uC758 \uC704\uCE58\uB97C \uAE30\uB85D\uD574 \uC904\uAC8C.[VAR 0114(0027)]",
  "\uB9C8\uC74C \uAC19\uC544\uC11C\uB294 \uC9C1\uC811 \uAC00 \uBCF4\uACE0 \uC2F6\uC9C0\uB9CC,\\n\uC218\uC5C5\uC744 \uB0B4\uD33D\uAC1C\uCE58\uACE0 \uBAA8\uD5D8\uD558\uB7EC \uB2E4\uB2C8\uB2E4\uAC00\\r\\n\uAD50\uC7A5 \uC120\uC0DD\uB2D8\uD55C\uD14C \uCC0D\uD600\uC11C \uB9D0\uC774\uC57C...[VAR 0114(0027)]",
  "\uD06C\uD06D, \uC5B4\uB5A4 \uC758\uBBF8\uB85C\uB294 \uBCF4\uBB3C\uCC3E\uAE30\uAC00 \uB418\uACA0\uC5B4.\\n\uC7AC\uC559\uC758 \uBCF4\uBB3C\uC774\uAE34 \uD558\uC9C0\uB9CC...\\r\\n\uC544\uBB34\uD2BC, \uC0DD\uAC01 \uC788\uC73C\uBA74 \uD55C\uBC88 \uAC00\uC11C \uC870\uC0AC\uD574 \uC918.[VAR 0114(0027)]",
  "\uB808\uD3EC\uB974 \uC120\uC0DD\uB2D8\uC774\\n\uB098\uB97C \uC2E0\uB8B0\uD558\uB294 \uAC8C \uB290\uAEF4\uC9C4\uB2E4!"
]
