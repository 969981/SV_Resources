[
  "\uC2DC\uD569 \uC804\uC758 \uB5A8\uB9AC\uB294 \uC774 \uAC00\uC2B4...\\n\uC628\uBAB8\uC758 \uC138\uD3EC\uAC00 \uC804\uC728\uD558\uACE0 \uC788\uC5B4.[VAR 0114(001C)]",
  "\uC0C1\uB300\uAC00 [VAR 0100(0000)] \uAC19\uC740\\n\uACE0~\uC800\uC2A4\uD55C \uC0AC\uB78C\uC774\uB77C \uB354 \uADF8\uB7F0 \uAC78\uAE4C?[VAR 0114(001C)]",
  "\uB9AC\uD30C\uB294 \uAE30\uBED0.[VAR 0114(001C)]",
  "\uB098\uC758 \uC190\uAE38\uC744 \uAC70\uCE5C \uC0AC\uB78C\uC774\\n\uC7AC\uB2A5\uC5D0 \uB208\uC744 \uB728\uACE0 \uB0A0\uC544\uC62C\uB790\uC73C\uB2C8\uAE4C \uB9D0\uC774\uC57C.[VAR 0114(001C)]",
  "\uB0A8\uC774 \uB178\uB825\uD558\uB294 \uBAA8\uC2B5\uC744 \uBCF4\uBA74\\n\uB098\uB3C4 \uC6B8\uC9C0 \uC54A\uACE0 \uB178\uB825\uD558\uAC8C \uB418\uAC70\uB4E0.[VAR 0114(001C)]",
  "\uB9AC\uD30C \uC0AC\uC804\uC5D0 \uC2AC\uD514\uC774\uB780 \uC874\uC7AC\uD558\uC9C0 \uC54A\uC544.\\n\uC788\uC744 \uC218 \uC788\uB294 \uAC74 \uC624\uC9C1 \uACBD\uC774\uB85C\uC6B4 \uC544\uB984\uB2E4\uC6C0\uBFD0...[VAR 0114(001C)]",
  "\uADF8\uB7FC, \uC9C4\uC815\uD55C \uD76C\uB85C\uACBD\uB77D \uC5D1\uC11C\uC0AC\uC774\uC988\uB97C\\n[VAR 0100(0000)]\uC5D0\uAC8C \uAC00\uB974\uCCD0 \uC8FC\uACA0\uC5B4![VAR 0114(001C)]",
  "\uC5ED\uC2DC... \uC544\uB984\uB2E4\uC6C0\uB3C4 \uAC15\uD568\uB3C4\\n\uCDA9\uBD84\uD788 \uB450\uB8E8 \uAC16\uCD94\uACE0 \uC788\uB124...![VAR 0114(001C)]",
  "...\uB9AC\uD30C\uC758 \uC5C5\uACC4\uC5D0\uC11C\uB294\\n\uC5B4\uC911\uAC04\uD55C \uC7AC\uB2A5\uC744 \uAC00\uC9C4 \uC0AC\uB78C\uC740\\r\\n\uB300\uCCB4\uB85C \uAE08\uBC29 \uC0AC\uB77C\uC838 \uBC84\uB824.[VAR 0114(001C)]",
  "\uBCBD\uC5D0 \uBD80\uB52A\uCE58\uACE0, \uC88C\uC808\uD574\uC11C\uB294\\n\uC790\uD3EC\uC790\uAE30\uD558\uACE0, \uD0C0\uB77D\uD574\uC11C\\r\\n\uBCF4\uD1B5 \uC0AC\uB78C\uBCF4\uB2E4\uB3C4 \uBD88\uD589\uD574\uC9C0\uACE4 \uD558\uC9C0.[VAR 0114(001C)]",
  "\uADF8\uB807\uAC8C \uB420 \uC904 \uC54C\uC558\uC73C\uBA74 \uCC98\uC74C\uBD80\uD130\\n\uC77C\uB9D0\uC758 \uC7AC\uB2A5\uB3C4 \uC5C6\uB294 \uAC8C \uB098\uC558\uC744 \uD150\uB370 \uB9D0\uC774\uC57C.[VAR 0114(001C)]",
  "...[VAR 0100(0000)][VAR 1900(0001)] \uC0AC\uB77C\uC9C0\uC9C0 \uB9D0\uC544 \uC918.\\n\uC790\uC2E0\uC758 \uC7AC\uB2A5\uC744 \uD55C\uACC4\uAE4C\uC9C0 \uB04C\uC5B4\uC62C\uB824 \uC918.[VAR 0114(001C)]",
  "\uB9AC\uD30C\uC640 \uC57D\uC18D\uC774\uC57C.\\n\uC9C0\uD0AC \uC218 \uC788\uAC8C \uCD5C\uC120\uC744 \uB2E4\uD574 \uC918.[VAR 0114(001C)]",
  "\uADF8\uB7FC, \uC218\uACE0\uD588\uC5B4.[VAR 0114(001C)]"
]
