[
  "[VAR 0100(0000)]! \uC5B4\uC11C \uC624\uB834![VAR 0114(0042)]",
  "\uC81C\uB85C\uC758 \uB300\uACF5\uB3D9\uC5D0 \uB2E4\uB140\uC628\\n\uD53C\uB85C\uB294 \uC880 \uD480\uB838\uB2C8?[VAR 0114(0042)]",
  "\uACFC\uC5F0 \uC80A\uAD6C\uB098!\\n\uB098\uB294 \uBA70\uCE60\uC774 \uC9C0\uB098\uB3C4\\r\\n\uC5EC\uC804\uD788 \uD53C\uB85C\uAC00 \uB0A8\uC544 \uC788\uB294\uB370![VAR 0114(0042)]",
  "\uC138\uC0C1\uC5D0! \uC80A\uC740\uB370\uB3C4 \uC758\uC678\uB124!\\n\uC544\uC9C1 \uADFC\uC721\uD1B5\uC774 \uC774\uD2C0 \uB4A4\uC5D0 \uCC3E\uC544\uC624\uB294\\r\\n\uB098\uC774\uB3C4 \uC544\uB2D0 \uD150\uB370!?[VAR 0114(0042)]",
  "\uB098\uB294 \uB300\uACF5\uB3D9\uC5D0\uC11C \uC870\uC0AC\uD55C \uAC83\uB4E4\uC744\\n\uCC45\uC73C\uB85C \uB9CC\uB4DC\uB290\uB77C\\r\\n\uB3CC\uC544\uC624\uACE0 \uB098\uC11C \uC7A0\uB3C4 \uC548 \uC790\uACE0 \uC9D1\uD544 \uC911\uC774\uC57C.[VAR 0114(0042)]",
  "\uBB3C\uB860 \uD14C\uC0AC \uB2D8\uAED8 \uD5C8\uAC00\uB294 \uBC1B\uC558\uACE0,\\n\uAD6C\uCCB4\uC801\uC778 \uC0AC\uAC74\uC774\uB098 \uC778\uBA85 \uAC19\uC740 \uAC74\\r\\n\uC2E3\uC9C0 \uC54A\uC558\uC73C\uB2C8\uAE4C \uC548\uC2EC\uD574\uB3C4 \uB3FC.[VAR 0114(0042)]",
  "\uADF8\uB9AC\uACE0 \uBC29\uAE08 \uB3C4\uCC29\uD55C\\n\uCC45\uC758 \uACAC\uBCF8\uC774 \uBC14\uB85C \uC774\uAC70\uC57C.[VAR 0114(0042)]",
  "\uC81C\uB85C\uC758 \uB300\uACF5\uB3D9\uC5D0\uC11C\uB294\\n\uC815\uB9D0 \uB9CE\uC740 \uD3D0\uB97C \uB07C\uCCE4\uC73C\uB2C8\uAE4C...[VAR 0114(0042)]",
  "\uC0AC\uACFC\uC758 \uB73B\uC774\uB77C\uAE34 \uBB50\uD558\uC9C0\uB9CC\\n\uB108\uC5D0\uAC8C \uAF2D \uC804\uD574 \uC8FC\uACE0 \uC2F6\uC5C8\uC5B4.[VAR 0114(0042)]",
  "\uADF8\uAC74 \uADF8\uB807\uACE0, \uB124\uAC00 \uAC00\uC9C4 \uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uB97C\\n\uC7A0\uAE50 \uBCF4\uC5EC \uC8FC\uACA0\uB2C8?[VAR 0114(0042)]",
  "\uC5ED\uC2DC... \uCE74\uC9C0\uC640 \uC2DC\uC720\uAC00 \uAC00\uC9C4 \uC624\uBE0C\uC640\\n\uB611\uAC19\uC740 \uBC18\uC751\uC744 \uBCF4\uC774\uACE0 \uC788\uB124.[VAR 0114(0042)]",
  "\uB300\uACF5\uB3D9\uC5D0\uC11C \uD14C\uB77C\uD30C\uACE0\uC2A4\uC758 \uC5D0\uB108\uC9C0\uC5D0\\n\uC9C1\uC811 \uB178\uCD9C\uB410\uAE30 \uB54C\uBB38\uC77C\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4.[VAR 0114(0042)]",
  "\uCE74\uC9C0\uC640 \uC2DC\uC720\uC758 \uB9D0\uC5D0 \uC758\uD558\uBA74, \uB300\uACF5\uB3D9\uC5D0\\n\uB2E4\uB140\uC628 \uB4A4\uB85C, \uC624\uBE0C\uB97C \uCDA9\uC804\uD558\uC9C0 \uC54A\uC544\uB3C4\\r\\n\uD14C\uB77C\uC2A4\uD0C8\uC744 \uD560 \uC218 \uC788\uAC8C \uB410\uB2E4\uB294 \uBAA8\uC591\uC774\uC57C.[VAR 0114(0042)]",
  "...\uADF8\uB9AC\uACE0! \uB300\uACF5\uB3D9\uACFC \uAD00\uB828\uD574\uC11C\\n\uACF5\uC720\uD560 \uC0AC\uD56D\uC774 \uD558\uB098 \uB354 \uC788\uC5B4.[VAR 0114(0042)]",
  "\uD14C\uB77C\uB9AC\uC6C0 \uB3D4 \uCC9C\uC7A5\uC5D0 \uB9E4\uB2EC\uB824 \uC788\uB294\\n\uD14C\uB77C\uB9AC\uC6C0 \uCF54\uC5B4 \uC788\uC9C0?[VAR 0114(0042)]",
  "\uAC70\uAE30\uC5D0\uB294 \uB0B4\uAC00 \uC804\uBD80\uD130 \uD314\uB370\uC544\uC758 \uD759\uC774\uB098\\n\uD0DC\uB77C\uC218\uD638\uC758 \uBB3C\uC744 \uC8FC\uC785\uD558\uACE0 \uC788\uC5C8\uC5B4.[VAR 0114(0042)]",
  "\uADF8 \uB355\uBD84\uC5D0 \uC544\uCE74\uB370\uBBF8 \uC548\uC5D0\uC11C\\n\uD14C\uB77C\uC2A4\uD0C8\uC744 \uC548\uC815\uC801\uC73C\uB85C\\r\\n\uC0AC\uC6A9\uD560 \uC218 \uC788\uAC8C \uB41C \uAC74\uB370...[VAR 0114(0042)]",
  "\uC694\uBC88\uC5D0 \uB300\uACF5\uB3D9\uC5D0\uC11C \uCC44\uCDE8\uD55C \uACB0\uC815\uC744 \uB123\uC5C8\uB354\uB2C8\\n\uCF54\uC5B4\uC758 \uC131\uC9C8\uC774 \uBC14\uB00C\uC5B4\uC11C...[VAR 0114(0042)]",
  "\uB3D4 \uB0B4\uBD80\uC5D0\uC11C \uBB34\uC9C0\uAC2F\uBE5B\uC73C\uB85C \uBE5B\uB098\uB294\\n\uC2A4\uD154\uB77C \uD14C\uB77C\uC2A4\uD0C8\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC774\\r\\n\uCD9C\uD604\uD558\uAC8C \uB410\uC9C0 \uBB50\uC57C![VAR 0114(0042)]",
  "\uD14C\uB77C\uC2A4\uD0C8 \uC5F0\uAD6C\uAC00 \uC21C\uC870\uB86D\uAC8C \uD480\uB9AC\uAC8C \uB3FC\uC11C\\n\uB354 \uB208\uBD80\uC2DC\uAC8C \uBE5B\uB098\uB294 \uAE30\uBD84\uC774\uC57C![VAR 0114(0042)]",
  "\uADF8\uB9AC\uACE0... \uB9DE\uB2E4.\\n\uC785\uAD6C \uB85C\uBE44\uC5D0\uC11C\\c\\n\uAC80\uC740 \uC591\uBCF5\uC744 \uC785\uC740 \uC544\uC800\uC528\uAC00\\n\uB108\uB97C \uCC3E\uACE0 \uC788\uB358\uB370?[VAR 0114(0042)]",
  "\uBCF4\uACE0\uD560 \uAC74 \uC774\uAC78\uB85C \uB05D\uC774\uC57C!\\n\uC2DC\uAC04 \uB0B4 \uC918\uC11C \uACE0\uB9C8\uC6CC![VAR 0114(0042)]",
  "\uB098\uB294 \uC9C0\uAE08\uBD80\uD130 \uCD9C\uD310\uC0AC\uC5D0 \uAC00 \uBD10\uC57C \uD558\uB2C8\uAE4C\\n\uBA3C\uC800 \uC2E4\uB840\uD560\uAC8C.\\c\\n\uB2E4\uC74C\uC5D0 \uD14C\uB77C\uD30C\uACE0\uC2A4\uB97C\\n\uCC2C\uCC2C\uD788 \uAD00\uCC30\uD558\uAC8C \uD574 \uC8FC\uB834![VAR 0114(0042)]"
]
