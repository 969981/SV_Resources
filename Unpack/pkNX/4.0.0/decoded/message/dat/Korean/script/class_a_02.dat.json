[
  "\uC5EC\uB7EC\uBD84 \uC548\uB155~\\n\uADF8\uB7FC, \uC218\uC5C5\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C\uC694~[VAR 0114(002A)]",
  "\uC9C0\uB09C \uC218\uC5C5\uC5D0\uC11C \uBC30\uC6E0\uB358\\n\u201C\uBCFC \uB358\uC9C0\uAE30 ZR \uBC84\uD2BC!\u201D\\r\\n\uB2E4\uB4E4 \uD574 \uBCF4\uC168\uB098\uC694?[VAR 0114(002A)]",
  "\uD3EC\uCF13\uBAAC\uACFC \uD568\uAED8 \uAC78\uC5B4 \uBCF4\uBA74\\n\uB2E4\uB4E4 \uAC1C\uC131\uC774 \uB118\uCCD0\uC11C \uADC0\uC5EC\uC6B8 \uAC70\uC608\uC694![VAR 0114(002A)]",
  "\uC9C0\uB2C8\uACE0 \uC788\uB294 \uBAA8\uB4E0 \uD3EC\uCF13\uBAAC\uACFC\\n\uD568\uAED8 \uB180\uACE0 \uC2F6\uC744 \uB54C\uB294 \uD53C\uD06C\uB2C9\uC744 \uD558\uB294 \uAC83\uB3C4\\r\\n\uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694.[VAR 0114(002A)]",
  "\uB2E4 \uAC19\uC774 \uD14C\uC774\uBE14\uC744 \uB458\uB7EC\uC2F8\uC11C\\n\uC0CC\uB4DC\uC704\uCE58\uB97C \uB9CC\uB4E4\uAC70\uB098, \uD3EC\uCF13\uBAAC\uACFC \uB180 \uC218\uB3C4 \uC788\uACE0\\r\\n\uC990\uAE38 \uAC70\uB9AC\uAC00 \uB9CE\uAC70\uB4E0\uC694![VAR 0114(002A)]",
  "\uC694\uB9AC\uC5D0 \uB300\uD55C \uAC74,\\n\uC0AC\uAD6C\uC544\uB85C \uC120\uC0DD\uB2D8\uC758 \uC218\uC5C5\uC5D0\uC11C \uBC30\uC6B8 \uC218 \uC788\uC5B4\uC694.[VAR 0114(002A)]",
  "\uADF8\uB9AC\uACE0, \uD53C\uD06C\uB2C9\uC744 \uD558\uB2E4 \uBCF4\uBA74\\n\uD14C\uC774\uBE14 \uC606\uC5D0 \uB193\uC5EC \uC788\uB294\\r\\n\uBC14\uAD6C\uB2C8 \uC548\uC5D0\uC11C \uAC00~\uB054[VAR 0114(002A)]",
  "\uC5B4\uB9C8\uC5B4\uB9C8\uD558\uAC8C \uC911\uC694\uD55C \uADF8\uAC83\uC744\\n\uBC1C\uACAC\uD560 \uC218\uB3C4 \uC788\uB294\uB370\uC694![VAR 0114(002A)]",
  "\uD3EC\uCF13\uBAAC\uC774 \uD0DC\uC5B4\uB098\uB294 \uC911\uC694\uD55C \uADF8\uAC83!\\n\uB2E4 \uAC19\uC774 \uB9D0\uD574 \uBCFC\uAE4C\uC694? \uD558\uB098, \uB458...![VAR 0114(002A)]",
  "\uBC15\uC2A4!",
  "\uBAAC\uC2A4\uD130\uBCFC!",
  "\uC54C!",
  "...\uC5B4\uB77C? [VAR 0100(0000)] \uD63C\uC790\\n\uBC15\uC2A4\uB77C\uACE0 \uB9D0\uD55C \uAC83 \uAC19\uC740\uB370\uC694?\\c\\n\uBC15\uC2A4\uB294 \uD3EC\uCF13\uBAAC\uC744 \uB9E1\uAE30\uB294 \uACF3\uC774\uC9C0\\n\uD0DC\uC5B4\uB098\uB294 \uACF3\uC774\uB791\uC740 \uC870\uAE08 \uB2E4\uB974\uC9C0 \uC54A\uB098\uC694?[VAR 0114(002A)]",
  "...\uC5B4\uB77C? [VAR 0100(0000)] \uD63C\uC790\\n\uBAAC\uC2A4\uD130\uBCFC\uC774\uB77C\uACE0 \uB9D0\uD55C \uAC83 \uAC19\uC740\uB370\uC694?\\c\\n\uBCFC\uC5D0\uC11C \uD0DC\uC5B4\uB098\uB294 \uD3EC\uCF13\uBAAC\uC740\\n\uC9C0\uAE08\uAE4C\uC9C0 \uBC1C\uACAC\uB41C \uAC8C \uC5C6\uC9C0 \uC54A\uB098\uC694?[VAR 0114(002A)]",
  "\uD734~ \uB2E4\uD589\uC774\uB2E4.\\n\uB2E4\uB4E4 \uC798\uD588\uC5B4\uC694![VAR 0114(002A)]",
  "\uADF8\uB798\uC694. \uC911\uC694\uD55C \uADF8\uAC83\uC774\uB77C\uB294 \uAC74\\n\uD3EC\uCF13\uBAAC\uC758 \uC54C\uC744 \uB9D0\uD558\uB294 \uAC70\uC608\uC694.[VAR 0114(002A)]",
  "\uC5B4\uB514\uC11C \uB09C \uAC74\uC9C0\uB294 \uC54C \uC218 \uC5C6\uC9C0\uB9CC\\n\uD53C\uD06C\uB2C9\uC5D0 \uC788\uB358 \uD3EC\uCF13\uBAAC\uC774\\r\\n\uBAB0\uB798 \uBC14\uAD6C\uB2C8\uC5D0 \uB123\uC740 \uAC8C \uC544\uB2D0\uAE4C\uC694?[VAR 0114(002A)]",
  "\uC54C\uC740 \uC5EC\uB7EC\uBD84\uC774 \uAC78\uC5B4 \uB2E4\uB2C8\uBA74\uC11C\\n\uB530\uB73B\uD558\uAC8C \uD574 \uC8FC\uBA74 \uBD80\uD654\uD55C\uB2F5\uB2C8\uB2E4![VAR 0114(002A)]",
  "\uBC15\uC2A4 \uC548\uC740 \uB530\uB73B\uD558\uC9C0 \uC54A\uC73C\uB2C8\uAE4C\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC5D0 \uB123\uACE0 \uB370\uB9AC\uACE0 \uB2E4\uB2C8\uC138\uC694![VAR 0114(002A)]",
  "...\uADF8\uB9AC\uACE0 \uD55C \uAC00\uC9C0 \uB354,\\n\uC544\uC8FC \uC911~\uC694\uD55C \uAC83\uC744 \uAC00\uB974\uCCD0 \uB4DC\uB9B4\uAC8C\uC694.[VAR 0114(002A)]",
  "\uC54C\uC740 \uD3EC\uCF13\uBAAC\uC774 \uC778\uAC04\uC744 \uC2E0\uB8B0\uD558\uAE30\uC5D0\\n\uC6B0\uB9AC\uC5D0\uAC8C \uB9E1\uAE30\uB294 \uAC70\uB78D\uB2C8\uB2E4.[VAR 0114(002A)]",
  "\uADF8\uB7EC\uB2C8\uAE4C \uCC45\uC784\uC744 \uAC00\uC9C0\uACE0 \uD0A4\uC6CC \uC8FC\uBA74\\n\uC120\uC0DD\uB2D8\uC740 \uAE30\uC060 \uAC70\uC608\uC694![VAR 0114(002A)]",
  "\uC911\uC694\uD55C \uC21C\uAC04\uC5D0 \uC885\uC774 \uC6B8\uB838\uB124.\\n...\uB2E4\uC74C \uC218\uC5C5\uB3C4 \uAE30\uB300\uD574 \uC8FC\uC138\uC694~[VAR 0114(002A)]",
