[
  "\uC5EC\uAE30\uB294 \uC138\uBC97 \uD50C\uB77C\uC790\uC57C.\\c\\n\uC6D0\uB798\uB294 \uC138\uBC97 \uACF5\uC6D0\uC774\uC5C8\uB294\uB370\\n\uC5B4\uB290\uC0CC\uAC00 \uC774\uB984\uC774 \uBC14\uB00C\uC5B4 \uBC84\uB838\uC5B4.",
  "\uC548\uCABD\uC5D0 \uC788\uB294 \uAC74 \uC138\uBC97 \uC11D\uC0C1!\\c\\n\uC138\uBC97\uB2D8\uB4E4\uC740 \uBA3C \uC61B\uB0A0\uC5D0\\n\uC6B0\uB9AC \uB9C8\uC744\uC744 \uC9C0\uD0A8 \uD788\uC5B4\uB85C\uB4E4\uC774\uC154.",
  "\uBB50\uC57C! \uC138\uBC97 \uC11D\uC0C1\uC774 \uBD80\uC11C\uC838 \uC788\uC796\uC544!\\n\uC2DC\uC720 \uB140\uC11D, \uACB0\uAD6D \uC800\uC9C8\uB7EC \uBC84\uB9B0 \uAC74\uAC00!?",
  "\uC138\uBC97\uB4E4\uC774 \uB098\uC05C \uB140\uC11D\uB4E4\uC774\uC5C8\uB2E4\uC9C0\uB9CC,\\n\uC138\uBC97 \uC11D\uC0C1\uC740 \uAF64 \uB9C8\uC74C\uC5D0 \uB4E4\uC5C8\uB294\uB370...",
  "\uC138\uBC97 \uC11D\uC0C1 \uC77C\uC740 \uACE0\uB9C8\uC6E0\uC5B4!\\n\uB098\uB3C4 \uC870\uAE08\uC740 \uAE30\uBD80\uD588\uB2E4\uAD6C."
