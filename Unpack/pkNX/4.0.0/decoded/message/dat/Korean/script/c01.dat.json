[
  "\uC544\uCE74\uB370\uBBF8\uC758 \uBA85\uBB3C, \uC9C0\uC625\uC758 \uACC4\uB2E8!\\n\uC624\uB974\uAE30 \uC9C4\uC9DC \uD798\uB4E4\uC5C8\uC9C0!?",
  "\uD14C\uC774\uBE14\uC2DC\uD2F0\uB294\\n\uD559\uAD50\uC640 \uBB38\uD654\uC758 \uB9C8\uC744!\\r\\n\uD14C\uC774\uBE14\uCC98\uB7FC \uC9C4\uC9DC \uB113\uB2E4~",
  "\uD559\uAD50\uC5D0\uB294 \uB2E4\uC591\uD55C \uC0AC\uB78C\uACFC\\n\uD3EC\uCF13\uBAAC\uB4E4\uC774 \uC788\uC5B4!\\r\\n\uB108\uB3C4 \uADF8\uC911 \uD55C \uC0AC\uB78C\uC778 \uAC70\uACE0!",
  "\uC2A4\uD0C0\uB2E8 \uC0AC\uB78C\uB4E4\\n\uC870\uAE08 \uBB34\uC11C\uC6B4 \uAC83 \uAC19\uC544~",
  "\uC2A4\uD0C0\uB2E8\uC740 \uC774\uC0C1\uD55C \uCC28\uB97C \uD0C0\uACE0\\n\uBC24\uB9C8\uB2E4 \uD3ED\uC8FC\uD558\uACE0 \uB2E4\uB2CC\uB300.",
  "\uC544\uCE74\uB370\uBBF8\uC5D0\uC11C\uB294 \uC6D0\uD558\uB294 \uC218\uC5C5\uC744\\n\uACE8\uB77C\uC11C \uB4E4\uC744 \uC218 \uC788\uB2E4\uBA70?\\r\\n\uC694\uC998 \uD559\uAD50\uB294 \uC61B\uB0A0\uC774\uB791 \uB2E4\uB974\uAD6C\uB098~",
  "\uC5EC\uBCF4\uC138\uC694? \uB124, \uC544\uCE74\uB370\uBBF8 \uD559\uC0DD\uB4E4\uC740\\n\uB2E4\uB4E4 \uCC29\uD574\uC11C \uB9CE\uC740 \uB3C4\uC6C0\uC774 \uB418\uACE0 \uC788\uB2F5\uB2C8\uB2E4!",
  "\uACFC\uC5F0 \uD314\uB370\uC544 \uCD5C\uB300\uC758 \uB3C4\uC2DC\uB124!\\n\uC644\uC804\uD788 \uAE38\uC744 \uC783\uC5B4\uBC84\uB838\uC5B4!",
  "\uC9C0\uB3C4\uC5D0\uC11C \uB179\uC0C9\uC73C\uB85C \uD45C\uC2DC\uB418\uB294 \uCABD\uC774 \uBD81\uCABD\uC774\uC57C.\\c\\nR \uC2A4\uD2F1\uC744 \uB20C\uB7EC\uC11C \uBD81\uCABD\uC774 \uC704\uC5D0 \uAC00\uB3C4\uB85D\\n\uACE0\uC815\uC2DC\uCF1C \uBCF4\uB294 \uAC74 \uC5B4\uB54C?",
  "\uD130\uB110 \uB05D\uC5D0\uB294\\n\uD3EC\uCF13\uBAAC\uB9AC\uADF8\uAC00 \uC788\uC5B4.\\c\\n\uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAC00 \uB418\uAE30 \uC704\uD55C\\n\uC2DC\uD5D8\uC744 \uBC1B\uC744 \uC218 \uC788\uB2E4\uB294 \uAC83 \uAC19\uC544.",
  "\uD3EC\uCF13\uBAAC\uB9AC\uADF8\uC5D0\uC11C\\n\uBA74\uC811 \uD14C\uC2A4\uD2B8\uB97C \uBCF4\uACE0 \uC654\uC5B4!\\r\\n\uBA74\uC811\uAD00\uC774 \uC9C4\uC9DC \uBB34\uC11C\uC6E0\uC5B4...",
  "\uB9C8\uC744 \uBC16\uC5D0\uB294 \uBCF8 \uC801 \uC5C6\uB294\\n\uD3EC\uCF13\uBAAC\uC774 \uC794\uB729 \uC788\uAD6C\uB098~",
  "\uC288\uD37C \uBAA8\uB378 \uB9AC\uD30C \uC528 \uB9D0\uC774\uC57C!\\n\uD559\uAD50 \uC120\uC0DD\uB2D8 \uC911\uC5D0\\r\\n\uC18C\uAFC9\uCE5C\uAD6C\uAC00 \uC788\uB300!",
  "\uC774 \uC55E\uC5D0\uB294 \uBC14\uC704\uC0B0\uC774 \uBCF5\uC7A1\uD558\uAC8C \uB298\uC5B4\uC11C \uC788\uC5B4!\\n\uAE38\uC744 \uC783\uAE30 \uC2ED\uC0C1\uC774\uB2C8\uAE4C \uC870\uC2EC\uD574\uC57C \uD574!\\c\\n\uBC14\uC704\uC0B0\uC744 \uBE60\uC838\uB098\uAC00\uBA74\\n\uC608\uC220\uC758 \uB9C8\uC744 \uBCF4\uC6B8\uB9C8\uC744\uC774 \uC788\uC744 \uAC70\uC57C.",
  "\uC720\uBA85\uD55C \uBC15\uC0AC\uAC00\\n\uD3EC\uCF13\uBAAC\uC758 \uD14C\uB77C\uC2A4\uD0C8 \uD604\uC0C1\uC744 \uBC1D\uD600\uB0C8\uB300.",
  "\uADF8 \uBC15\uC0AC \uB9D0\uC778\uB370... \uD314\uB370\uC544\uC758 \uB300\uACF5\uC5D0\uC11C\\n\uC5C4\uCCAD\uB09C \uC5F0\uAD6C\uB97C \uD558\uACE0 \uC788\uB2E4\uB098 \uBD10.",
  "\uB9CE~\uC774 \uB9CE\uC774 \uC790\uACE0 \uB098\uBA74\\n\uD559\uAD50 \uAC00\uB294 \uB0A0\uC774 \uCC3E\uC544\uC62C \uAC70\uC57C.",
  "\uB098\uB3C4 \uBE68\uB9AC\\n\uC544\uCE74\uB370\uBBF8\uC5D0 \uB2E4\uB2C8\uACE0 \uC2F6\uC5B4~!",
  "\uC2DC\uAC04\uC740 \uD750\uB974\uACE0...\\n\uB0A0\uC528\uB294 \uBCC0\uD55C\uB2E4...\\c\\n\uC2DC\uAC04\uACFC \uB0A0\uC528\uC5D0 \uB530\uB77C\\n\uC57C\uC0DD \uD3EC\uCF13\uBAAC\uC758 \uD589\uB3D9\uC774 \uB2EC\uB77C\uC9C4\uB2E4\uB354\uAD6C\uB098.",
  "\uC5C4\uCCAD \uD070 \uC5F0\uBABB\uC774\uB2E4~!\\c\\n\uC789\uC5B4\uD0B9\uCC98\uB7FC\\n\uB465\uC2E4\uB465\uC2E4 \uB5A0 \uC788\uACE0 \uC2F6\uC5B4.",
  "\uD559\uAD50 \uC120\uC0DD\uB2D8\uB4E4\uC5D0\uAC8C\\n\uC774\uC0C1\uD55C \uBCC4\uBA85\uC774 \uBD99\uC744 \uB54C\uAC00 \uC788\uC9C0 \uC54A\uC544?\\c\\n\uD559\uC0DD\uB4E4\uC774 \uC790\uD06C \uC528\uAC00~ \uBE0C\uB77C\uB354 \uC138\uC774\uC9C0\uAC00~\\n\uD558\uB294 \uC18C\uB9AC\uB97C \uB4E4\uC5C8\uAC70\uB4E0.",
  "\uD3EC\uCF13\uBAAC\uC5D0 \uB530\uB77C\\n\uBC30\uC6B8 \uC218 \uC5C6\uB294 \uAE30\uC220\uB3C4 \uC788\uAD6C\uB098~",
  "\uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uB97C \uAC16\uACE0 \uC2F6\uC740\uB370\\n\uC131\uC801\uC774 \uC870\uAE08 \uBAA8\uC790\uB790\uC5B4...",
  "\uC6B0\uC218\uD55C \uD559\uC0DD\uC774 \uC544\uB2C8\uBA74\\n\uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uB97C \uBC1B\uC744 \uC218 \uC5C6\uC5B4.\\r\\n\uD30C\uC6CC\uAC00 \uB108\uBB34 \uAC15\uD574\uC11C \uADF8\uB807\uB300.",
  "\uC5EC\uAE30\uB294 \uD14C\uC774\uBE14\uC2DC\uD2F0!\\n\uD314\uB370\uC544\uC5D0\uC11C \uAC00\uC7A5 \uD070 \uB9C8\uC744\uC774\uC57C!",
  "\uC0AC\uACFC \uC324\uC758 \uAC00\uC815 \uC218\uC5C5\uC740\\n\uC815\uB9D0 \uC720\uC775\uD55C \uAC83 \uAC19\uC544~!",
  "\uB808\uD3EC\uB974 \uB2D8\uC758 \uC5ED\uC0AC \uC218\uC5C5,\\n\uC815\uB9D0 \uC7AC\uBBF8\uC788\uC5C8\uC5B4~!",
  "\uC624\uB298\uC740 \uC5B4\uB514\uC5D0 \uC788\uB294\\n\uC0CC\uB4DC\uC704\uCE58 \uAC00\uAC8C\uC5D0\uC11C \uBA39\uC744\uAE4C?",
  "\uAC19\uC740 \uAC00\uAC8C\uB3C4 \uC7A5\uC18C\uC5D0 \uB530\uB77C\\n\uC0C1\uD488 \uAD6C\uC131\uC774 \uBBF8\uBB18\uD558\uAC8C \uB2E4\uB974\uB2E8 \uB9D0\uC774\uC9C0.",
  "\uB9C8\uC744\uC5D0 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC740 \uB300\uBD80\uBD84\\n\uB204\uAD70\uAC00\uC758 \uD30C\uD2B8\uB108\uC57C.\\r\\n\uC7A1\uC73C\uB824 \uD558\uBA74 \uC548 \uB41C\uB2E4\uAD6C.",
  "\uB0B4 \uD3EC\uCF13\uBAAC\uC740\\n\uC8FC\uC704 \uC18C\uB9AC\uC5D0 \uBBFC\uAC10\uD574!",
  "\uAC19\uC740 \uD3EC\uCF13\uBAAC\uC774\uB77C\uB3C4 \uB2A5\uB825\uC774 \uB2E4\uB974\uB2E8 \uB9D0\uC774\uC9C0.\\n\uC131\uACA9\uC774\uB098 \uD2B9\uC131\uB3C4 \uB9D0\uC774\uC57C.",
  "\uD314\uB370\uC544\uC758 \uBE44\uB294 \uCC28\uAC11\uC9C0 \uC54A\uC740 \uB370\uB2E4\\n\uAE08\uBC29 \uADF8\uCCD0\uC11C \uC6B0\uC0B0\uC774 \uB531\uD788 \uD544\uC694 \uC5C6\uC5B4.",
  "\uC6B0\uB9AC \uC544\uB4E4\uC774\\n\uC2A4\uD0C0\uB2E8\uC774\uB77C\uB294 \uACF3\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4\uB354\uB77C~\\r\\n\uC7AC\uBBF8\uC788\uB294 \uB3D9\uC544\uB9AC\uC778\uAC00 \uBD10~",
  "\uC911\uC559 \uAD11\uC7A5\uC5D0 \uC788\uB294 \uBC30\uD2C0\uCF54\uD2B8!\\c\\n\uC0AC\uB78C\uB4E4\uC758 \uC8FC\uBAA9\uC744 \uB044\uB294 \uACF3\uC774\uB77C\\n\uC2E4\uB825\uC5D0 \uC790\uC2E0\uC774 \uC5C6\uC73C\uBA74 \uC4F0\uAE30 \uD798\uB4E4\uB2E8 \uB9D0\uC774\uC9C0.",
  "\uB2E4\uB978 \uC9C0\uBC29\uC5D0\uB294\\n\uCC54\uD53C\uC5B8\uC774 \uD55C \uBA85\uBC16\uC5D0 \uC5C6\uB300!\\c\\n\uD314\uB370\uC544\uB294 \uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAC00\\n\uBA87 \uBA85\uC529\uC774\uB098 \uC788\uC73C\uB2C8 \uAD49\uC7A5\uD55C \uAC83 \uAC19\uC544!",
  "\uC628\uB77C\uC778 \uC8FC\uBB38\uC740 \uB0B4 \uCDE8\uD5A5\uC774 \uC544\uB2C8\uC57C...\\n\uC2E4\uBB3C\uC744 \uBCF4\uACE0 \uC0AC\uACE0 \uC2F6\uAC70\uB4E0.",
  "\uADF8\uAC70 \uC54C\uC544? \uD3EC\uCF13\uBAAC\uC740\\n6\uB9C8\uB9AC\uAE4C\uC9C0 \uC9C0\uB2C8\uACE0 \uB2E4\uB2D0 \uC218 \uC788\uB300!",
  "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 \uAC00\uB4DD \uCC28\uBA74\\n\uD3EC\uCF13\uBAAC\uC774 \uBC15\uC2A4\uB85C \uBCF4\uB0B4\uC9C0\uB294 \uAC70 \uB9DE\uC9C0?",
  "\uD3EC\uCF13\uBAAC\uC758 \uC720\uC2E4\uBB3C\uC744 \uC794\uB729 \uC8FC\uC6CC\uC11C\\n\uAD50\uD658\uD55C LP\uB85C \uC9C0\uBD88\uD558\uBA74...\\r\\n\uB3C8\uC774 \uC5C6\uC5B4\uB3C4 \uC6D0\uD558\uB294 \uAC78 \uC0B4 \uC218 \uC788\uC5B4!",
  "\uD14C\uC774\uBE14\uC2DC\uD2F0~ \uBC30\uC6C0\uC758 \uB9C8\uC744~\u266A\\n\uC544\uCE74\uB370\uBBF8~ \uB098\uC758 \uBAA8\uAD50~ \uB784\uB784\uB77C~\u266A",
  "\uD559\uAD50 \uC785\uAD6C \uD640 \uCC45\uAF42\uC774\uC5D0 \uC788\uB294 \uCC45\uC740\\n\uC6D0\uD558\uB294 \uB9CC\uD07C \uC77D\uC744 \uC218 \uC788\uC5B4!\\r\\n\uCC45\uC744 \uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC5D0\uAC90 \uCC9C\uAD6D\uC774\uB77C\uB2C8\uAE4C~",
  "\uB098\uB294 \uC544\uCE74\uB370\uBBF8 \uC878\uC5C5\uC0DD\uC774\uC57C!\\n\uC544\uC9C1\uB3C4 \uBCF4\uBB3C\uCC3E\uAE30\uB97C \uD558\uACE0 \uC788\uB2C8?",
  "\uC544\uCE74\uB370\uBBF8\uC5D0\uB294 \uC785\uD559 \uC5F0\uB839\uC5D0 \uC81C\uD55C\uC774 \uC5C6\uB2E8\uB2E4!\\n\uADF8\uB798\uC11C \uD560\uBA38\uB2C8\uB3C4 \uC785\uD559\uD560 \uC218 \uC788\uC5B4!\\r\\n...\uB098\uB3C4 \uB2E4\uC2DC \uACF5\uBD80\uD574 \uBCFC\uAE4C?",
  "\uC774 \uC55E\uC740 \uC11C\uBB38\uC774\uC57C!\\n\uC138\uB974\uD074\uB9C8\uC744\uC5D0 \uAC00\uB824\uBA74 \uC774\uCABD\uC73C\uB85C \uAC00\uBA74 \uB3FC!",
  "\uC11C\uBB38\uC740 \uAC74\uB108\uD3B8 \uAE38\uC5D0 \uC788\uC5B4!\\n\uD1B5\uC870\uB9BC \uAC00\uAC8C \uC606\uC744 \uC9C0\uB098\uAC00\uBA74 \uB3FC.",
  "\uC774 \uC55E\uC740 \uB9C9\uB2E4\uB978 \uAE38\uC774\uC57C!\\n\uB354 \uAC00\uB3C4 \uBC14\uB974 \uBD84\uBC14\uB974\uBC16\uC5D0 \uC5C6\uC5B4!",
  "\uBCF4\uBB3C\uCC3E\uAE30\uB97C \uC900\uBE44\uD574\uC57C\uC9C0!\\n\uB51C\uB9AC\uBC84\uB4DC \uD30C\uC6B0\uCE58\uAC00 \uC5B4\uB514\uC5D0 \uC788\uB354\uB77C?",
  "\uB51C\uB9AC\uBC84\uB4DC \uD30C\uC6B0\uCE58\uB294 \uC5EC\uB7EC \uAD70\uB370\uC5D0 \uC788\uB294\uB370\\n\uB0A8\uCABD\uC73C\uB85C \uAC00\uBA74 \uBC14\uB85C \uCC3E\uC744 \uC218 \uC788\uC5B4.",
  "\uD3EC\uCF13\uBAAC\uC13C\uD130\uAC00 \uBCF4\uC774\uBA74 \uC548\uC2EC\uC774 \uB3FC.\\n...\uB098\uC624\uB294 \uC74C\uC545\uB3C4 \uC88B\uACE0 \uB9D0\uC774\uC57C.",
  "\uD55C \uBC88 \uBC29\uBB38\uD588\uB358 \uD3EC\uCF13\uBAAC\uC13C\uD130\uC5D0\uB294\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB85C \uB2E8\uC228\uC5D0 \uAC08 \uC218 \uC788\uC5B4.",
  "\uB9C8\uC744\uACFC \uC2DC\uD2F0\uB294 \uBB50\uAC00 \uB2E4\uB978 \uAC78\uAE4C...\\n\uD06C\uAE30\uC778\uAC00?",
  "\u201C\uC2DC\uD2F0\u201D\uB77C\uACE0 \uBD88\uB9AC\uB294 \uB9C8\uC744\uC740\\n\uD314\uB370\uC544\uC9C0\uBC29\uC5D0 \uC138 \uACF3\uC774 \uC788\uC5B4!\\r\\n\uADF8\uC911 \uD558\uB098\uAC00 \uC774\uACF3 \uD14C\uC774\uBE14\uC2DC\uD2F0\uC57C.",
  "\uC774 \uC8FC\uBCC0\uC5D0 \uD2B9\uC774\uD55C \uC0CC\uB4DC\uC704\uCE58\uB97C\\n\uD30C\uB294 \uACF3\uC774 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uB294\uB370...\\r\\n\uC5B4\uB514\uC5D0 \uC788\uB294 \uAC78\uAE4C?",
  "\uC0CC\uB4DC\uC704\uCE58 \uB9DB\uC788\uC5B4!\\n\uB9E4\uC77C\uB9E4\uC77C \uBA39\uACE0 \uC2F6\uC5B4~!",
  "\uD6C4\uD6C4\uD6C4!\\n\uB2E4\uC74C\uC5D0 \uAC19\uC774 \uB9CC\uB4E4\uC5B4 \uBCFC\uAE4C?",
  "\uBD81\uCABD\uC5D0\uB294 \uC8FC\uD0DD\uAC00\uAC00 \uB298\uC5B4\uC11C \uC788\uC5B4!\\c\\n\uD14C\uC774\uBE14\uC2DC\uD2F0\uC5D0 \uC0AC\uB294 \uC0AC\uB78C\uB4E4\uC740\\n\uAE30\uC219\uC0AC\uC5D0 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4.",
  "\uC0AC\uB78C\uB4E4\uC774 \uD3EC\uCF13\uBAAC\uC744 \uB370\uB9AC\uACE0 \uB2E4\uB2C8\uB294 \uBAA8\uC2B5\uC740\\n\uBCF4\uAE30\uB9CC \uD574\uB3C4 \uD790\uB9C1\uC774 \uB418\uB294 \uAC83 \uAC19\uC544!",
  "\uC0CC\uB4DC\uC704\uCE58 \uB9DB\uC788\uB2E4!\\n\uC774 \uAC00\uAC8C \uAC70\uB294 \uD2B9\uD788 \uB354 \uB9DB\uC788\uC5B4!",
  "\uB51C\uB9AC\uBC84\uB4DC \uD30C\uC6B0\uCE58\uC5D0\uC11C \uC2A4\uB9C8\uD2B8\uD3F0 \uCEE4\uBC84\uB97C \uC0AC\uBA74\\n\uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34\uC758 \uC678\uD615\uC744 \uBC14\uAFC0 \uC218 \uC788\uC5B4!\\r\\n\uC74C~ \uC5B4\uB5A4 \uAC78\uB85C \uD560\uC9C0 \uACE0\uBBFC\uB3FC!",
  "\uC5B8\uC820\uAC00 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC544\uC11C\\n\uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAC00 \uB420 \uAC70\uC57C~!",
  "\uD559\uAD50\uC5D0\uC11C \uBCC4 \uBAA8\uC591 \uC120\uAE00\uB77C\uC2A4\uAC00 \uC720\uD589\uC774\uB2C8?\\n\uB2E8\uCCB4\uB85C \uC4F0\uACE0 \uB2E4\uB2C8\uB294 \uAC78 \uBD24\uAC70\uB4E0.",
  "\uB9C8\uC744\uB9C8\uB2E4 \uBC30\uD2C0\uCF54\uD2B8\uC758\\n\uC0C9\uC774\uB098 \uC678\uD615\uC774 \uB2EC\uB77C.",
  "\uD3EC\uCF13\uBAAC\uC13C\uD130\uC5D0 \uD68C\uBCF5\uD558\uB7EC \uAC08 \uB54C\uB9C8\uB2E4\\n\uC9C1\uC6D0\uC774 \uD1A0\uB9C9 \uC9C0\uC2DD\uC744 \uAC00\uB974\uCCD0 \uC8FC\uB354\uB77C.\\r\\n...\uB098\uD55C\uD14C\uB9CC \uD2B9\uBCC4\uD788 \uAC00\uB974\uCCD0 \uC8FC\uB294 \uAC78\uAE4C!?",
  "\uB51C\uB9AC\uBC84\uB4DC \uD30C\uC6B0\uCE58\uC5D0\uC11C \uC0B0 \uB3C4\uAD6C\uB97C\\n\uD30C\uCE58\uB9AC\uC2A4\uC5D0\uAC8C \uC9C0\uB2C8\uAC8C \uD574 \uC92C\uC5B4!\\c\\n\uC9C0\uB2C8\uAC8C \uD55C \uB3C4\uAD6C\uC5D0 \uB530\uB77C\\n\uC5EC\uB7EC \uBC29\uC2DD\uC73C\uB85C \uAC15\uD574\uC9C8 \uC218 \uC788\uC5B4!",
  "\uC120\uC81C\uACF5\uACA9\uC190\uD1B1\uC744 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC9C0\uB2C8\uAC8C \uD558\uBA74\\n\uAC00\uB054\uC529 \uC88B\uC740 \uC77C\uC774 \uC788\uC744 \uAC70\uC57C!\\r\\n\uC800\uCABD\uC5D0 \uC788\uB294 \uBE68\uAC04 \uAC00\uAC8C\uC5D0\uC11C \uD314\uACE0 \uC788\uC5B4!",
  "\uC11C\uBB38\uC744 \uB098\uAC00\uC11C \uCB49 \uAC78\uC5B4\uAC00\uBA74\\n\uC138\uB974\uD074\uB9C8\uC744\uAE4C\uC9C0 \uAC08 \uC218 \uC788\uC5B4!\\r\\n\uC9C0\uAE08 \uD55C\uCC3D \uC218\uD655\uC81C \uC2DC\uC98C\uC774\uC57C.",
  "\uB3D9\uD0C1\uAD70\uC740 \uC815\uB9D0 \uB9E4\uB825\uC801\uC774\uC57C...\\c\\n\uAC00\uB054 \uC548\uC5D0 \uB4E4\uC5B4\uAC00 \uBCF4\uBA74\\n\uC2E0\uAE30\uD558\uAC8C\uB3C4 \uB9C8\uC74C\uC774 \uCC28\uBD84\uD574\uC9C4\uB2E4\uB2C8\uAE4C!",
  "\uAE38\uC744 \uC783\uC5B4\uBC84\uB838\uC5B4.\\n\uC9C0\uB3C4 \uC571\uC744 \uD655\uC778\uD574 \uBCFC\uAE4C?",
  "\uC774 \uAC00\uAC8C\uC758 \uC694\uB9AC\uB97C \uBA39\uC73C\uBA74\\n\uC54C \uD30C\uC6CC\uAC00 \uC0D8\uC19F\uAC8C \uB3FC.\\c\\n\uD53C\uD06C\uB2C9\uC5D0\uC11C \uD3EC\uCF13\uBAAC\uC758 \uC54C\uC744\\n\uBC1C\uACAC\uD558\uAE30 \uC26C\uC6CC\uC9C0\uC9C0.",
  "\uD3EC\uCF13\uBAAC\uC758 \uC720\uC2E4\uBB3C\uC740\\n\uAE30\uC220\uBA38\uC2E0\uBA38\uC2E0\uC744 \uD1B5\uD574\\r\\nLP\uB85C \uAD50\uD658\uD560 \uC218 \uC788\uC5B4.",
  "\uC694\uC998 \uAE30\uACC4\uB294 \uB9D0\uC744 \uCC38 \uC798\uD558\uB294 \uAC83 \uAC19\uC544!\\n\uAE30\uC220\uBA38\uC2E0\uBA38\uC2E0\uB3C4 \uC74C\uC131\uC774 \uB098\uC624\uB354\uB77C\uACE0.",
  "\uD30C\uCE58\uB9AC\uC2A4\uC758 \uD2B9\uC131\uC740 \uB3C4\uC8FC!\\n\uC57C\uC0DD \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uC11C \uB3C4\uB9DD\uCE58\uB294 \uAC8C \uD2B9\uAE30\uC57C!",
  "\uC694\uC998 \uC790\uB3D9\uD310\uB9E4\uAE30\uB294\\nLP\uB85C\uB3C4 \uC74C\uB8CC\uC218\uB97C \uC0B4 \uC218 \uC788\uAD6C\uB098!",
  "\uD559\uAD50\uB85C \uAC00\uB294 \uACC4\uB2E8\uC740 \uC5B4\uB9C8\uC5B4\uB9C8\uD558\uAC8C \uAE38\uC5B4\uC11C\\n\uC9C0\uC625\uC758 \uACC4\uB2E8\uC774\uB77C \uBD88\uB9AC\uACE0 \uC788\uC5B4.\\r\\n\uD655\uC2E4\uD788 \uD1B5\uD559\uD558\uB294 \uD559\uC0DD\uB4E4\uC740 \uD798\uB4E4 \uAC83 \uAC19\uC544.",
  "\uC57C\uC0DD \uD3EC\uCF13\uBAAC\uC774 \uC790\uACE0 \uC788\uC73C\uBA74 \uADF8\uAC74 \uCC2C\uC2A4\uC57C!\\n\uD5C8\uB97C \uCC14\uB7EC\uC11C \uBA3C\uC800 \uACF5\uACA9\uD560 \uC218 \uC788\uAC70\uB4E0!",
  "\uD3EC\uCF13\uBAAC\uC774 \uC790\uB294 \uBAA8\uC2B5\uC744 \uBCF4\uBA74\\n\uACC4\uC18D\uD574\uC11C \uC0AC\uC9C4\uC744 \uCC0D\uAC8C \uB41C\uB2E8 \uB9D0\uC774\uC9C0!",
  "\uC0C8\uB85C\uC6B4 \uAD50\uC7A5 \uC120\uC0DD\uB2D8...\\n\uD074\uB77C\uBCA8 \uC120\uC0DD\uB2D8\uC774\uB77C\uACE0 \uD558\uB358\uAC00?\\r\\n1\uB144 \uBC18\uCBE4 \uC804\uC5D0 \uCDE8\uC784\uD558\uC168\uC5B4.",
  "\uD559\uC0DD\uD68C\uC7A5 \uB124\uBAA8\uB294\\n\uC815\uB9D0 \uCC29\uD55C \uC544\uC774\uC57C.\\r\\n\uB9C8\uC8FC\uCE60 \uB54C\uB9C8\uB2E4 \uD56D\uC0C1 \uC778\uC0AC\uB97C \uD558\uAC70\uB4E0.",
  "\uC608\uC05C \uACBD\uCE58\uB97C \uBCF4\uAC70\uB4E0\\n\uCE74\uBA54\uB77C \uC571\uC73C\uB85C \uC0AC\uC9C4\uC744 \uCC0D\uC5B4 \uBCF4\uB834!",
  "\uB108\uB3C4 \uC9C0\uBD95 \uC704\uC5D0\uC11C\\n\uB290\uAE0B\uD558\uAC8C \uC788\uB294 \uAC78 \uC88B\uC544\uD558\uB2C8?\\r\\n\uD56D\uC0C1 \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uB834!",
  "\uC774 \uAC00\uAC8C\uC5D0\uC11C \uD559\uAD50\uAC00 \uC9C0\uC815\uD55C\\n\uB2E4\uB978 \uB514\uC790\uC778\uC758 \uAC00\uBC29\uC744 \uC0B4 \uC218 \uC788\uC5B4.\\r\\n\uBB34\uC2A8 \uC0C9\uC73C\uB85C \uD560\uAE4C~?",
  "\uB808\uB098\uC138\uB974 \uC0B4\uB871\uC5D0\uC11C \uBA38\uB9AC\uD558\uACE0 \uC62C \uD14C\uB2C8\uAE4C\\n\uC8FC\uBCC0\uC5D0\uC11C \uC2DC\uAC04 \uC880 \uB54C\uC6B0\uACE0 \uC788\uC5B4~",
  "\uD3EC\uCF13\uBAAC\uC758 \uAE30\uC220 \uC774\uB984 \uAC19\uC740\\n\uD5E4\uC5B4\uC2A4\uD0C0\uC77C\uB3C4 \uC788\uB2E8 \uB9D0\uC774\uC9C0.\\r\\n\uC0AC\uC774\uB4DC \uD30C\uD2B8\uB77C\uB4E0\uC9C0 \uAE41\uC2A8\uD131\uC774\uB77C\uB4E0\uC9C0...",
  "\uC548\uACBD\uACE0\uC744\uC5D0\uC11C \uC548\uACBD\uC744 \uC0AC\uC11C\\n\uC548\uACBD \uB370\uBDD4\uB098 \uD574 \uBCFC\uAE4C!",
  "\uBA4B\uB4E4\uC5B4\uC9C4 \uBAA8\uC790\uAC00 \uC4F0\uACE0 \uC2F6\uC5B4!\\n\uADF8\uB7F0\uB370, \uD5E4\uC5B4\uC2A4\uD0C0\uC77C\uB3C4 \uC790\uB791\uD558\uACE0 \uC2F6\uC5B4!\\r\\n...\uACE0\uBBFC\uC740 \uC77C\uB2E8 \uAC00\uAC8C \uC548\uC5D0\uC11C \uD560\uAE4C?",
  "\uCCB4\uC9C8\uC774 \uB0C9\uD55C \uC0AC\uB78C\uC5D0\uAC90 \uB450\uAEBC\uC6B4 \uC591\uB9D0\uC774 \uC88B\uC544!\\n\uC774 \uAC00\uAC8C\uC5D0\uC11C \uB2E4\uC591\uD55C \uC591\uB9D0\uC744 \uBCFC \uC218 \uC788\uC5B4.",
  "\uACFC\uC77C\uC5D0 \uCC44\uC18C\uC5D0...\\n\uB77C\uC774\uC2A4\uAE4C\uC9C0 \uC788\uC796\uC544!?\\c\\n\uD1B5\uC870\uB9BC \uB300\uC7A5\uC5D0\uC11C \uC2DD\uC7AC\uB8CC\uB97C \uC794\uB729 \uC0AC\uC11C\\n\uC0CC\uB4DC\uC704\uCE58\uB97C \uC2E4\uCEF7 \uB9CC\uB4E4\uC5B4\uC57C\uC9C0!"
]
