[
  "[VAR 0100(0000)] \uB2D8\\n\uBCA0\uC774\uD06C\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uC288\uD37C \uB9E4\uC9C0\uCEEC \uBA54\uC774\uD06C\uC5C5...\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB9AC\uD30C\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uADF8\uB7FC, \uBC30\uD2C0\uCF54\uD2B8\uB85C \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4.",
  "\uC900\uBE44\uAC00 \uB418\uC2DC\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.",
  "\uADF8\uB798... \uC54C\uC558\uC5B4.\\n\uADF8 \uAC74\uC740 \uC774\uCABD\uC5D0\uC11C \uC9C4\uD589\uC2DC\uD0AC\uAC8C.[VAR 0114(002C)]",
  "\uCE90\uCE58\uD504\uB808\uC774\uC988\uB294 \uC54C\uAE30 \uC27D\uAC8C\\n\u201C\uB0B4\uCD94\uB7F4\uD55C \uC544\uB984\uB2E4\uC6C0\uC744\u201D\uB85C \uD558\uC790.[VAR 0114(002C)]",
  "\uADF8\uB9AC\uACE0 \uC0C8\uB85C\uC6B4 \uC0C9\uC758\\n\uC544\uC774\uC100\uB3C4 \uBC1C\uC8FC\uB3C4 \uBD80\uD0C1\uD560\uAC8C.[VAR 0114(002C)]",
  "...\uB9E4\uBC88 \uACE0\uB9C8\uC6CC.\\n\uADF8\uB7FC \uB04A\uC744\uAC8C.[VAR 0114(002C)]",
  "\uD558\uC774~[VAR 0114(002C)]",
  "\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB9AC\uD30C\uB77C\uACE0 \uD574.\\c\\n\uBA54\uC774\uD06C\uC5C5 \uC544\uD2F0\uC2A4\uD2B8\uAC00\\n\uBCF8\uC5C5\uC774\uAE34 \uD558\uC9C0\uB9CC.[VAR 0114(001C)]",
  "\uC6B4\uD5A5\uC774 \uB124 \uCE6D\uCC2C\uC744 \uB9CE\uC774 \uD558\uB354\uB77C.\\n\uB124\uAC00 \uC544\uC8FC \uACE0~\uC800\uC2A4\uD558\uB2E4\uACE0 \uB9D0\uC774\uC57C.[VAR 0114(001C)]",
  "\uD6C4\uD6C4\uD6C4... [VAR 0100(0000)].\\n\uC6B0\uB9AC \uADC0\uC5EC\uC6B4 \uB3C4\uC804\uC790\uB2D8?[VAR 0114(001C)]",
  "\uB9AC\uD30C\uAC00 \uD504\uB85C\uB4C0\uC2A4\uD55C \uC5D1\uC11C\uC0AC\uC774\uC988\uB85C\\n\uC804\uBCF4\uB2E4 \uB354 \uC544\uB984\uB2E4\uC6CC\uC838\uC11C \uAE30\uC058\uC9C0 \uC54A\uC544?[VAR 0114(001C)]",
  "\uD3EC\uCF13\uBAAC\uC758 \uBAB8\uB3C4\\n\uADF8\uB807\uAC8C\uB098 \uAE54\uB054\uD558\uAC8C \uAD00\uB9AC\uD558\uACE0 \uC788\uACE0...\\r\\n...\uBBF8\uC758\uC2DD\uC774 \uB6F0\uC5B4\uB098\uB124.[VAR 0114(001C)]",
  "[~ 30]",
  "\uC778\uAC04\uC774\uB4E0 \uD3EC\uCF13\uBAAC\uC774\uB4E0\\n\uBAB8\uAC00\uC9D0\uC774 \uC911\uC694\uD558\uB2E4\uACE0.[VAR 0114(001C)]",
  "\uB204\uAD6C\uB77C\uB3C4 \uBC14\uAFC0 \uC218 \uC788\uB294 \uB9E4\uC9C1.\\n...\uADF8\uAC8C \uBC14\uB85C \uD654\uC7A5\uC774\uACE0\\r\\n...\uADF8\uAC8C \uBC14\uB85C \uBA54\uC774\uD06C\uC5C5\uC774\uC57C.[VAR 0114(001C)]",
  "\uB9AC\uD30C\uC758 \uAE30\uC220\uB85C \uB108\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uC744\\n\uC9C0\uAE08\uBCF4\uB2E4 \uD6E8~\uC52C \uC544\uB984\uB2F5\uAC8C \uB9CC\uB4E4\uC5B4 \uC904\uAC8C!![VAR 0114(001C)]",
  "\uC2B9\uBD80\uC5D0\uC11C \uC9C4 \uAC83\uB3C4 \uBAA8\uC790\uB77C\\n\uC544\uB984\uB2E4\uC6C0\uC5D0\uC11C\uB3C4 \uBE44\uAE30\uB2E4\uB2C8...[VAR 0114(001C)]",
  "\uB108, \uBCF4\uD1B5\uC774 \uC544\uB2C8\uAD6C\uB098...!\\n\uC544\uB2C8\uC9C0, \uC815\uB9D0 \uCD5C\uACE0\uC57C...![VAR 0114(001C)]",
  "\uC9C0\uAE08\uBCF4\uB2E4 \uB354 \uAC70\uBB3C\uC774 \uB418\uAE30 \uC804\uC5D0\\n\uB9AC\uD30C\uAC00 \uCC1C\uD574 \uB46C\uC57C \uD558\uB824\uB098?[VAR 0114(001C)]",
  "...\uADF8\uB807\uC9C0\uB9CC \uC9C0\uAE08 \uB9AC\uD30C\uC5D0\uAC8C \uD544\uC694\uD55C \uAC74\\n\uC790\uAE30 \uAD00\uB9AC\uB97C \uB354 \uCCA0\uC800\uD788 \uD558\uB294 \uAC83\uC774\uACA0\uC9C0?[VAR 0114(001C)]",
  "\uCD95\uD558\uD574, [VAR 0100(0000)].\\n\uC0C1\uC73C\uB85C \uC774 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C\\r\\n\uBE44\uC7A5\uC758 \uD3EC\uC988\uB85C \uAC74\uB124\uC904\uAC8C.[VAR 0114(001C)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C [VAR 0200(0001)]\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uB808\uBCA8 [VAR 0201(0002)]\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E3\uAC8C \uB3FC.[VAR 0114(001C)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E3\uAC8C \uB3FC.[VAR 0114(001C)]",
  "\uCCB4\uAC04\uC744 \uB2E8\uB828\uD558\uBA74 \uC774 \uAE30\uC220\uB3C4\\n\uACE0~\uC800\uC2A4\uD558\uAC8C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC744 \uAC70\uC57C.[VAR 0114(001C)]",
  "\uB9AC\uD30C\uC640 \uCC0D\uC740 \uD22C\uC0F7,\\nSNS\uC5D0 \uC62C\uB9AC\uBA74 \uC548 \uB3FC![VAR 0114(001C)]",
  "...\uB540\uC774\uB791 \uC774\uAC83\uC800\uAC83 \uB54C\uBB38\uC5D0\\n\uD654\uC7A5\uC774 \uC870\uAE08 \uC9C0\uC6CC\uC84C\uC5B4.[VAR 0114(001C)]",
  "\uBE68\uB9AC \uAC00\uC11C \uB2E4\uC2DC \uACE0\uCCD0\uC57C\uACA0\uB294\uAC78.\\n\uADF8\uB7FC, \uBA3C\uC800 \uAC00 \uBCFC\uAC8C~[VAR 0114(001C)]",
  "\uBCA0\uC774\uD06C\uCCB4\uC721\uAD00 \uD569\uACA9\uC744\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!"
]
