[
  "\uC5EC\uAE30\uAC00 \uBC14\uB85C\\n\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758 \uC785\uAD6C \uB85C\uBE44\uC608\uC694.[VAR 0114(0049)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uB294\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC5D0 \uD798\uC744 \uC3DF\uACE0 \uC788\uB294 \uACF3\uC774\uB77C[VAR 0114(0049)]",
  "\uC55E\uC5D0 \uC788\uB294 \uC911\uC559 \uCF54\uD2B8\uC5D0\uC11C\uB294\\n\uACF5\uC2DD\uC804 \uB4F1\uC744 \uC9C4\uD589\uD558\uACE0 \uC788\uC5B4\uC694.\\r\\n\uC77C\uC815\uC774 \uC5C6\uC744 \uB54C\uB294 \uC790\uC720\uB86D\uAC8C \uC4F8 \uC218 \uC788\uAD6C\uC694.[VAR 0114(0049)]",
  "\uD3EC\uCF13\uBAAC\uC774 \uBC30\uD2C0\uD560 \uAE30\uD68C\uAC00\\n\uB2E4\uB978 \uD559\uAD50\uBCF4\uB2E4 \uB9CE\uC740 \uD3B8\uC774\uC5D0\uC694![VAR 0114(0049)]",
  "\uC554! \uADF8\uB807\uACE0\uB9D0\uACE0~[VAR 0114(004B)]",
  "...\uC5ED\uC2DC \uC2DC\uC544\uB178 \uC120\uC0DD\uB2D8\uC774 \uC788\uC73C\uBA74\\n\uC9C4\uC9C0\uD558\uAC8C \uD558\uAE30 \uD798\uB4DC\uB124\uC694...[VAR 0114(0049)]",
  "\uBC14\uB2F7\uBC14\uB78C\uC774 \uAE30\uBD84 \uC88B\uAC8C \uBD88\uC5B4\uC11C\\n\uC2DC\uD569\uC774 \uC5C6\uB294 \uB0A0\uC5D0\uB294 \uAD00\uAC1D\uC11D\uC774\\r\\n\uD559\uC0DD\uB4E4\uC758 \uC27C\uD130\uAC00 \uB418\uAE30\uB3C4 \uD574\uC694.[VAR 0114(0049)]",
  "\uADF8\uB9AC\uACE0 \uADF8\uB9AC\uACE0,\\n\uC800\uD76C \uD559\uAD50\uC5D0\uB294 \uB180\uB77C\uC6B4 \uBE44\uBC00\uC774 \uC788\uB294\uB370\uC694...[VAR 0114(0049)]",
  "\uBC14\uB85C \uC57C\uC0DD\uC5D0\uC11C\uB3C4\\n\uD14C\uB77C\uC2A4\uD0C8\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774 \uC788\uB2E4\uB294 \uAC70\uC608\uC694![VAR 0114(0049)]",
  "\uC138\uC0C1\uC5D0\uB098!",
  "\uADF8\uB807\uAD70\uC694...",
  "\uC557, \uD314\uB370\uC544\uC5D0\uC11C\uB294\\n\uB2F9\uC5F0\uD55C \uC77C\uC774\uC5C8\uC8E0?[VAR 0114(0049)]",
  "\uD314\uB370\uC544\uC9C0\uBC29\uC5D0\uC11C \uBC1C\uACAC\uB41C \uD604\uC0C1, \uD14C\uB77C\uC2A4\uD0C8...[VAR 0114(004B)]",
  "\uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8\uAC00 \uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uCC98\uB7FC\\n\uD14C\uB77C\uC2A4\uD0C8\uC758 \uBA54\uCEE4\uB2C8\uC998\uC744 \uC81C\uC5B4\uD560 \uC218 \uC788\uB294\\r\\n\uAE30\uC220\uC744 \uBC1C\uBA85\uD588\uAC70\uB4E0~[VAR 0114(004B)]",
  "\uC5B4\uB5BB\uAC8C \uD55C \uAC74\uC9C0 \uAD81\uAE08\uD558\uC9C0~?[VAR 0114(004B)]",
  "\uC7A0\uAE50! \uADF8 \uC124\uBA85\uC740 \uB0B4\uB824\uAC00\uC11C \uD558\uB294 \uD3B8\uC774\\n\uB354 \uC54C\uAE30 \uC26C\uC6B8 \uD14C\uB2C8\uAE4C\\r\\n\uB098\uC911\uC5D0 \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694![VAR 0114(0049)]",
  "\uC815\uB9D0 \uB611 \uBD80\uB7EC\uC84C\uB2E4\uB2C8\uAE4C~[VAR 0114(004B)]",
  "\uADF8\uB807\uC9C0! \uC88B\uC740 \uC0DD\uAC01\uC774 \uB5A0\uC62C\uB790\uC5B4!\\n\uB108\uD76C \uB458\uC774 \uC5EC\uAE30\uC11C \uC2B9\uBD80\uD574 \uBCF4\uC9C0 \uC54A\uC744\uB798?[VAR 0114(004B)]",
  "\uB124? \uC9C0\uAE08 \uBC14\uB85C\uC694!?[VAR 0114(0049)]",
  "\uC751, [VAR 0100(0000)]\uC758 \uC2E4\uB825\uB3C4\\n\uD655\uC778\uD560 \uACB8 \uB9D0\uC774\uC57C.[VAR 0114(004B)]",
  "\uD0C0\uB85C\uB294 \uB9AC\uADF8\uBD80\uC758 \uC0AC\uCC9C\uC655\uC774\uB2C8\uAE4C\\n\uBB54\uAC00 \uBC30\uC6B8 \uAC8C \uC788\uC9C0 \uC54A\uC744\uAE4C~?\\c\\n\uC544\uBC84\uB2D8\uC774 \uD558\uB098\uC9C0\uBC29\uC758\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uC2DC\uAE30\uB3C4 \uD558\uACE0.[VAR 0114(004B)]",
  "\uC557! \uBA4B\uB300\uB85C \uC81C \uAC1C\uC778 \uC815\uBCF4\uB97C...[VAR 0114(0049)]",
  "\uADF8\uB7F0 \uAC74 \uC633\uC9C0 \uC54A\uC544\uC694![VAR 0114(0049)]",
  "\uADF8\uB7FC, \uB458\uC758 \uC2B9\uBD80\uB97C\\n\uD2B9\uB4F1\uC11D\uC5D0\uC11C \uC9C0\uCF1C\uBCF4\uB3C4\uB85D \uD560\uAE4C~[VAR 0114(004B)]",
  "\uC8C4\uC1A1\uD574\uC694... \uC2DC\uC544\uB178 \uC120\uC0DD\uB2D8\uC740\\n\uD55C\uBC88 \uAF42\uD78C \uAC8C \uC788\uC73C\uBA74 \uB9D0\uC774 \uC548 \uD1B5\uD558\uAC70\uB4E0\uC694...[VAR 0114(0049)]",
  "...\uADF8\uB807\uC9C0\uB9CC \uC800\uB3C4 \uC870\uAE08\\n\uAC00\uC2B4\uC774 \uB450\uADFC\uAC70\uB9AC\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694![VAR 0114(0049)]",
  "\uCC38\uACE0\uB85C, \uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uB294\\n\uB354\uBE14\uBC30\uD2C0\uC774 \uC8FC\uB958\uC608\uC694!\\r\\n\uCE5C\uC120 \uC2DC\uD569, \uC5F4\uC2EC\uD788 \uD574\uC694![VAR 0114(0049)]",
  "\uC815\uB9D0 \uAD49\uC7A5\uD574\uC694!\\n\uBCF8\uACE0\uC7A5\uC758 \uD14C\uB77C\uC2A4\uD0C8\uC744 \uB2E4\uB8E8\uB294 \uC2E4\uB825\uC740\\r\\n\uC5ED\uC2DC \uB300\uB2E8\uD558\uB124\uC694![VAR 0114(0049)]",
  "\uC815\uB9D0 \uAD49\uC7A5\uD574\uC694!\\n\uBCF8\uACE0\uC7A5\uC758 \uD14C\uB77C\uC2A4\uD0C8\uC744 \uB2E4\uB8E8\uB294 \uC2E4\uB825\uB3C4\\r\\n\uBCFC \uC218 \uC788\uC5C8\uC73C\uBA74 \uB354 \uC88B\uC558\uACA0\uC9C0\uB9CC\uC694...[VAR 0114(0049)]",
  "\uB2E4\uD589\uC774\uC57C, \uC774\uACBC\uB2E4~\\n...\uC815\uB9D0 \uCE58\uC5F4\uD55C \uC2B9\uBD80\uC600\uC5B4\uC694![VAR 0114(0049)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uB294 \uCD5C\uADFC\uC5D0\uC57C\\n\uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uAC00 \uB3C4\uC785\uB3FC\uC11C,\\r\\n\uB178\uD558\uC6B0\uB97C \uAC00\uB974\uCCD0 \uC8FC\uC2DC\uBA74 \uACE0\uB9D9\uACA0\uC5B4\uC694![VAR 0114(0049)]",
  "\uB458 \uB2E4 \uC218\uACE0\uD588\uC5B4~\\n\uBA4B\uC9C4 \uC2B9\uBD80\uC600\uC5B4![VAR 0114(004B)]",
  "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8\\n\uAD50\uBCF5\uC744 \uC918\uC57C \uD588\uC5C8\uC9C0!\\r\\n\uC774\uAC78 \uC785\uACE0 \uC720\uD559 \uAE30\uBD84\uC744 \uC81C\uB300\uB85C \uB0B4 \uBCF4\uB834![VAR 0114(004B)]",
  "\uC815\uB9D0 \uC798 \uC5B4\uC6B8\uB824\uC694![VAR 0114(0049)]",
  "\uBA4B\uC9C4\uB370~!\\n\uB364\uC73C\uB85C \uC774\uAC83\uB3C4 \uBC1B\uC73C\uB834.[VAR 0114(004B)]",
  "\uD314\uB370\uC544\uC758 \uBD80\uD2F0\uD06C\uC640 \uBBF8\uC6A9\uC2E4\uC5D0\uC11C\\n\uACE0\uB97C \uC218 \uC788\uB294 \uC885\uB958\uB97C \uB298\uB824 \uC8FC\uB294 \uCE74\uB4DC\uB780\uB2E4.[VAR 0114(004B)]",
  "\uC790, \uADF8\uB7FC \uC0C8\uB85C\uC6B4 \uAE30\uBD84\uC73C\uB85C\\n\uB2E4\uC74C\uC740 \uC544\uCE74\uB370\uBBF8 \uC548\uC744 \uB458\uB7EC\uBCFC\uAE4C\uC694?[VAR 0114(0049)]",
  "\uAD50\uB0B4\uB97C \uC774\uB3D9\uD560 \uB54C\uB294 \uC800\uCABD\uC5D0 \uC788\uB294\\n\uAC8C\uC774\uD2B8\uB97C \uD1B5\uD574 \uBAA9\uC801\uC9C0\uB97C \uC815\uD560 \uC218 \uC788\uC5B4\uC694.[VAR 0114(0049)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758 \uC790\uB791\uC774\uC790, \uC138\uACC4\uC801\uC73C\uB85C\\n\uC720\uBA85\uD55C [VAR FF00(0006)]\uD14C\uB77C\uB9AC\uC6C0 \uB3D4[VAR FF00(0000)]\uC744 \uC18C\uAC1C\uD574 \uB4DC\uB9B4\uAC8C\uC694![VAR 0114(0049)]",
  "\uB2E4\uC74C\uC740 \uAC8C\uC774\uD2B8\uB97C \uD1B5\uD574\\n[VAR FF00(0006)]\uD14C\uB77C\uB9AC\uC6C0 \uB3D4[VAR FF00(0000)]\uC73C\uB85C \uAC00 \uBD10\uC694![VAR 0114(0049)]",
  "\uD06C~ \uAC15\uD558\uB358\uB370~\\n\uBAB0\uB4DC\uB958\uAC00 \uC758\uC678\uB85C \uBE60\uB978 \uB140\uC11D\uC778\uB370\\r\\n\uC798 \uB300\uC751\uD588\uC5B4.[VAR 0114(004B)]"
]
