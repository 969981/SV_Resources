[
  "[VAR 0100(0000)] \uB2D8\\n\uCE74\uB77C\uD504\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uACA9\uB958\uC758 \uC694\uB9AC\uC0AC...\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uACE4\uD3EC\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uADF8\uB7FC, \uBC30\uD2C0\uCF54\uD2B8\uB85C \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4.",
  "\uC900\uBE44\uAC00 \uB418\uC2DC\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.",
  "\uACE4\uD3EC \uC544\uC800\uC528!\\n\uB180\uC544 \uC918\uC694, \uB180\uC544 \uC918\uC694~!",
  "\uAD1C\uCC2E\uC73C\uC2DC\uB2E4\uBA74 \uC800\uD76C \uAC00\uAC8C \uC2E0\uBA54\uB274\uB3C4\\n\uD55C\uBC88 \uC2DC\uC2DD\uD574 \uC8FC\uC138\uC694!",
  "\uC774\uAC70 \uB2E4\uB4E4 \uBBF8\uC548\uD558\uAD70!\\n\uC9C0\uAE08\uC740 \uCCB4\uC721\uAD00 \uC77C\uC744 \uD558\uB7EC \uAC00\uC57C \uD574\uC11C \uB9D0\uC774\uC57C![VAR 0114(0018)]",
  "\uC190\uB2D8\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC73C\uB2C8\\n\uB2E4\uC74C\uC5D0 \uC640 \uC92C\uC73C\uBA74 \uC88B\uACA0\uB124![VAR 0114(0018)]",
  "\uB124~!",
  "\uC5B4\uC11C \uC635\uC1FC~!\\n\uC624, \uB108\uAD6C\uB098![VAR 0114(0018)]",
  "\uB9C8\uB9AC\uB124\uC774\uB4DC\uB9C8\uC744\uC5D0\uC11C\uB294\\n\uC2E0\uC138 \uB9CE\uC774 \uC84C\uB2E4![VAR 0114(0018)]",
  "\uB124 \uB355\uBD84\uC5D0 \uAD81\uADF9\uC758 \uBBF8\uC5ED \uC694\uB9AC\uB97C\\n\uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC83 \uAC19\uAD6C\uB098![VAR 0114(0018)]",
  "\uADF8\uB807\uC9C0\uB9CC, \uC2B9\uBD80\uC5D0\uC11C\uB294\\n\uBD10\uC8FC\uC9C0 \uC54A\uC744 \uD14C\uB2C8 \uAC01\uC624\uD558\uAC70\uB77C![VAR 0114(0018)]",
  "[~ 28]",
  "\uC0AC\uACE0 \uD30C\uB294 \uAC83\uC740 \uC2DC\uC7A5\uC758 \uB3C4\uB9AC\uACE0\\n\uBCA0\uACE0 \uCE58\uB294 \uAC83\uC740 \uCCB4\uC721\uAD00\uC758 \uB3C4\uB9AC...[VAR 0114(0018)]",
  "\uAE30\uC220\uACFC \uC218 \uC2F8\uC6C0\uC774\\n\uC18C\uC6A9\uB3CC\uC774\uCE58\uB294 \uBC14\uB2E4![VAR 0114(0018)]",
  "\uBB3C\uD3EC\uCF13\uBAAC\uC758 \uD480\uCF54\uC2A4\uB97C!\\n\uBC30 \uD130\uC9C0\uAC8C \uBA39\uC5EC \uC8FC\uB3C4\uB85D \uD558\uB9C8![VAR 0114(0018)]",
  "\uC640\uD558\uD558! \uC544\uCE68 \uC2DC\uC7A5\uACFC\uB3C4 \uAC19\uC774\\n\uC2DC\uC6D0\uC2DC\uC6D0\uD55C \uD328\uBC30\uC600\uB2E4![VAR 0114(0018)]",
  "\uB108\uC5D0\uAC8C \uB098\uB294 \uADF8\uC800\\n\uB3C4\uB9C8 \uC704\uC758 \uC789\uC5B4\uD0B9\uC774\uAD6C\uB098![VAR 0114(0018)]",
  "\uB450 \uC190 \uB450 \uBC1C \uB2E4 \uB4E4\uC5C8\uB2E4!\\n\uC774\uAC70 \uC6D4\uCC99\uC774\uAD70! \uC6D4\uCC99\uC774\uC57C![VAR 0114(0018)]",
  "\uC218 \uC2F8\uC6C0\uC5D0\uC11C \uAE30\uC8FD\uC9C0 \uC54A\uACE0\\n\uBA4B\uC9C0\uAC8C \uC2B9\uB9AC\uB97C \uB09A\uC544 \uC62C\uB9AC\uB2E4\uB2C8![VAR 0114(0018)]",
  "\uB124\uAC00 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C\\n\uC190\uC5D0 \uB123\uB294 \uC21C\uAC04\uC744\\c\\n\uBA4B\uC9C4 \uD3EC\uC988\uB85C \uAE30\uB150 \uCD2C\uC601\uD558\uC790\uAFB8\uB098!\\n\uC804\uBD80\uD130 \uD574 \uBCF4\uACE0 \uC2F6\uC740 \uAC8C \uC788\uC5B4\uC11C \uB9D0\uC774\uB2E4![VAR 0114(0018)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C [VAR 0200(0001)]\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uB808\uBCA8 [VAR 0201(0002)]\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E3\uAC8C \uB41C\uB2E8\uB2E4![VAR 0114(0018)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E3\uAC8C \uB41C\uB2E8\uB2E4![VAR 0114(0018)]",
  "\uB108\uB77C\uBA74 \uC774 \uAE30\uC220\uB3C4 \uC18C\uD654\uD560 \uC218 \uC788\uC744 \uAC70\uB2E4!\\n\uD2B9\uBCC4 \uC11C\uBE44\uC2A4\uB77C \uC0DD\uAC01\uD558\uACE0 \uAC00\uC9C0\uACE0 \uAC00\uB824\uBB34\uB098![VAR 0114(0018)]",
  "\uADF8\uB7FC \uB098\uB294 \uC2AC\uC2AC \uAC00\uAC8C\uB97C \uC5F4 \uC900\uBE44\uB97C\\n\uC2DC\uC791\uD574\uC57C\uACA0\uAD6C\uB098![VAR 0114(0018)]",
  "\uB2E4\uC74C\uC5D0 \uB610 \uB9CC\uB098\uAE30\uB97C\\n\uAE30\uB300\uD558\uACE0 \uC788\uC73C\uB9C8![VAR 0114(0018)]",
  "\uCE74\uB77C\uD504\uCCB4\uC721\uAD00 \uD569\uACA9\uC744\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!"
]
