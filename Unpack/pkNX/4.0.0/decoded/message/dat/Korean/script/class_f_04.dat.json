[
  "\uADF8\uB7FC, \uC911\uAC04\uACE0\uC0AC\uB97C \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4.\\n\uB2E4\uB4E4 \uC9D1\uC911\uD574\uC11C \uBB38\uC81C\uB97C \uD480\uC5B4 \uC8FC\uC138\uC694.[VAR 0114(0012)]",
  "\uC900\uBE44... \uC2DC\uC791!![VAR 0114(0012)]",
  "1. \uD3EC\uCF13\uBAAC\uC774 \uD14C\uB77C\uC2A4\uD0C8\uD588\uC744 \uB54C\\n    \uBA38\uB9AC \uC704\uC5D0\uC11C \uBE5B\uB098\uB294 \uBCF4\uC11D\uC758 \uC774\uB984\uC740?\\n\\n1) \uD14C\uB77C\uC2A4\uD0C8 \uC8FC\uC5BC 2) \uD14C\uB77C\uC2A4\uC11D\\n3) \uD14C\uB77C\uC2A4\uD0C8 \uC2A4\uD1A4",
