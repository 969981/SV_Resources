[
  "\uC5B4\uB77C? [VAR 0100(0000)][VAR 1900(0006)]\uC796\uC544?\\n\uC774\uB7F0 \uB370\uC11C \uBB50 \uD558\uACE0 \uC788\uB2C8?[VAR 0114(004B)]",
  "\uC120\uC0DD\uB2D8\uC774\uB791 \uC774\uC57C\uAE30\uD558\uB824\uAD6C\uC694!",
  "\uC120\uC0DD\uB2D8\uC740\uC694?",
  "\uB098\uB791 \uC774\uC57C\uAE30\uAC00 \uD558\uACE0 \uC2F6\uC5C8\uB2E4\uACE0?\\n\uC774\uB188\uC758 \uC778\uAE30\uB294 \uBABB \uC18D\uC778\uB2E4\uB2C8\uAE4C![VAR 0114(004B)]",
  "\uB098\uB294 \uBC14\uB2F7\uBC14\uB78C\uC744 \uB290\uB07C\uBA70\\n\uC5B4\uB514\uC11C \uC7AC\uBBF8\uC788\uB294 \uC2B9\uBD80 \uC548 \uD558\uB098~ \uD558\uACE0\\r\\n\uBA4D~\uD558\uB2C8 \uBC30\uD2C0\uCF54\uD2B8\uB97C \uBCF4\uB294 \uC911\uC774\uC5C8\uC9C0![VAR 0114(004B)]",
  "\uC544, \uADF8\uB807\uC9C0.\\n\uBE14\uB8E8\uBCA0\uB9AC\uB3C4\uAC10\uC740 \uC880 \uCC44\uC6E0\uB2C8?[VAR 0114(004B)]",
  "\uC880 \uCC44\uC6B4 \uAC83 \uAC19\uB2E4~ \uC2F6\uC5B4\uC9C0\uBA74\\n\uB0B4\uAC8C \uBCF4\uC5EC \uC8FC\uB7EC \uC624\uB834.[VAR 0114(004B)]",
  "\uB3C4\uAC10\uC744 \uC644\uC131\uD558\uBA74\\n\uD06C\uAC8C \uCE6D\uCC2C\uD574 \uC904\uAC8C~[VAR 0114(004B)]",
  "\uC548\uB155~ [VAR 0100(0000)].[VAR 0114(004B)]",
  "\uB124\uAC00 \uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC5D0\uC11C\\n\uC7A1\uC740 \uD3EC\uCF13\uBAAC\uC740... [VAR 0202(0001)]\uC885\uB958\uAD6C\uB098![VAR 0114(004B)]",
  "\uC544\uC9C1 \uB9CE\uC774 \uBD80\uC871\uD55C\uAC78?\\c\\n\uBB50, \uC720\uD559 \uC628 \uC9C0 \uC5BC\uB9C8 \uC548 \uB410\uC73C\uB2C8\uAE4C\\n\uC9C0\uAE08\uBD80\uD130\uAC00 \uC2DC\uC791\uC778 \uAC70\uC9C0~[VAR 0114(004B)]",
  "\uADF8\uB7ED\uC800\uB7ED \uCC44\uC6CC\uC84C\uB294\uB370?\\c\\n\uB2E4\uC591\uD55C \uC5D0\uB9AC\uC5B4\uAC00 \uC788\uC73C\uB2C8\uAE4C\\n\uC5F4\uC2EC\uD788 \uBAA8\uD5D8\uD574 \uBCF4\uB834~[VAR 0114(004B)]",
  "\uC81C\uBC95 \uCC44\uC6CC\uC84C\uB294\uB370!\\c\\n\uB3D4\uC5D0 \uB2E4\uC591\uD55C \uD3EC\uCF13\uBAAC\uB4E4\uC774 \uC788\uC9C0?\\n\uACF5\uC870 \uC124\uBE44\uC5D0 \uB3C8\uC744 \uC5C4\uCCAD\uB098\uAC8C \uB4E4\uC600\uAC70\uB4E0~[VAR 0114(004B)]",
  "\uAF64 \uB9CE\uC774 \uCC44\uC6CC\uC84C\uB294\uB370!\\c\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uC774\uC0C1\\n\uC644\uC131\uAE4C\uC9C0 \uAC00\uC57C\uC9C0 \uC54A\uACA0\uC5B4!?[VAR 0114(004B)]",
  "\uC5B4\uB77C~?\\n\uC774\uB7EC\uBA74 \uC804\uBD80 \uBAA8\uC740 \uAC70\uC796\uC544![VAR 0114(004B)]",
  "\uBE14\uB8E8\uBCA0\uB9AC\uB3C4\uAC10 \uC644\uC131!\\n\uB300\uB2E8\uD574~! \uC774\uAC70 \uC644\uC804 \uACBD\uC0AC\uC778\uAC78~![VAR 0114(004B)]",
  "\uB124 \uB355\uBD84\uC5D0 \uB3D4\uC5D0 \uC0AC\uB294 \uD3EC\uCF13\uBAAC\uB4E4\uC758\\n\uBAA8\uB4E0 \uB370\uC774\uD130\uAC00 \uBAA8\uC778 \uAC83 \uAC19\uC740\uB370?[VAR 0114(004B)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8 \uD559\uC0DD\uB4E4 \uC911\uC5D0\uC11C\uB3C4\\n\uC644\uC131\uD55C \uC0AC\uB78C\uC774 \uC5C6\uB294\uB370 \uC815\uB9D0 \uB300\uB2E8\uD558\uB2E4\uB2C8\uAE4C~[VAR 0114(004B)]",
  "\uAE30\uB150\uC73C\uB85C \uC774\uAC78 \uC8FC\uB9C8.\\n\uAD49\uC7A5\uD788 \uC88B\uC740 \uAC70\uB77C\uACE0.[VAR 0114(004B)]",
  "\uC2DC\uC544\uB178 \uC120\uC0DD\uB2D8, [VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591.\\n\uAD50\uD658 \uC720\uD559\uC740 \uC990\uAE30\uACE0 \uACC4\uC2DC\uB098\uC694?[VAR 0114(000A)]",
  "\uD074\uB77C\uBCA0\uB9AC~ \uC5B4\uC11C \uC640!\\n\uC2E4\uC740 [VAR 0100(0000)][VAR 1900(0003)] \uB9D0\uC774\uC9C0...[VAR 0114(004B)]",
  "\uC138\uC0C1\uC5D0\uB098![VAR 0114(000A)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C\uB3C4\\n\uD06C\uAC8C \uD65C\uC57D \uC911\uC774\uC168\uAD70\uC694![VAR 0114(000A)]",
  "\uD6C4\uD6C4\uD6C4...\\n\uC5ED\uC2DC \uB0B4 \uC548\uBAA9\uC740 \uD2C0\uB9BC\uC5C6\uB2E4\uB2C8\uAE4C.[VAR 0114(004B)]",
  "\uC2DC\uC544\uB178 \uC120\uC0DD\uB2D8\uB3C4 \uC2E0\uB098\uC2E0 \uAC83 \uAC19\uACE0,\\n\uC800\uB3C4 \uBB54\uAC00 \uAE30\uB150\uD560 \uB9CC\uD55C \uAC83\uC744 \uB4DC\uB9AC\uACE0 \uC2F6\uAD70\uC694.[VAR 0114(000A)]",
  "...\uC5F4\uC2EC\uD788 \uB178\uB825\uD55C \uD559\uC0DD\uC5D0\uAC8C\\n\uC0C1\uC7A5\uC744 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.\\c\\n\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uACF5\uC778\uD574 \uC8FC\uB294 \uAE30\uC5C5\uC5D0\uC11C\uB3C4\\n\uBA54\uC2DC\uC9C0\uAC00 \uC640 \uC788\uC744 \uAC81\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uB3C4\uAC10 \uC571\uC5D0\uC11C \uC5B8\uC81C\uB4E0\uC9C0\\n\uBCF4\uC2E4 \uC218 \uC788\uAC8C \uD574 \uB450\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC5ED\uC2DC \uD074\uB77C\uBCA0\uB9AC~\\n\uC61B\uB0A0\uBD80\uD130 \uC190\uC7AC\uC8FC \uD558\uB098\uB294 \uB05D\uB0B4\uC900\uB2E4\uB2C8\uAE4C![VAR 0114(004B)]",
  "\uC544\uB2C8\uC694, \uADF8 \uC815\uB3C4\uAE4C\uC9C0\uB294...[VAR 0114(000A)]",
  "\uADF8\uB9AC\uACE0 \uC2DC\uC544\uB178 \uC120\uC0DD\uB2D8... \uC544\uBB34\uB798\uB3C4\\n\uD559\uC0DD \uC55E\uC5D0\uC11C \uD074\uB77C\uBCA0\uB9AC\uB77C\uACE0 \uBD80\uB974\uC2DC\uB294 \uAC74 \uC880...[VAR 0114(000A)]",
  "\uC774\uC57C~ [VAR 0100(0000)]\uC758 \uBCF4\uBB3C\uCC3E\uAE30\uB294\\n\uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C\uB3C4 \uB300\uC131\uACF5\uC778\uAC78![VAR 0114(004B)]",
  "\uC55E\uC73C\uB85C\uB3C4 \uB3D4\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uACFC\\n\uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4\uB834![VAR 0114(004B)]",
  "...\uC2DC\uC544\uB178 \uC120\uC0DD\uB2D8?\\n\uB9D0\uC500 \uC911\uC5D0 \uC8C4\uC1A1\uD569\uB2C8\uB2E4\uB9CC...[VAR 0114(000A)]",
  "\uC2AC\uC2AC \uD559\uC0DD\uB4E4 \uC55E\uC5D0\uC11C\\n\uD074\uB77C\uBCA0\uB9AC\uB77C\uACE0 \uBD80\uB974\uC2DC\uB294 \uAC74 \uC5B4\uB5BB\uAC8C \uC548 \uB420\uC9C0...[VAR 0114(000A)]",
  "\uC800\uAE30... \uC81C \uB9D0 \uB4E3\uACE0 \uACC4\uC2DC\uC8E0?[VAR 0114(000A)]",
  "\uAD7F \uBAA8\uB2DD! \uC544\uCE68\uBD80\uD130 \uBD80\uC9C0\uB7F0\uD558\uB124!\\c\\n\uB098\uB294 \uC77C\uCC0D \uAE68\uC11C \uB098\uC654\uB2E8\uB2E4.\\n\uB098\uC774\uB97C \uBA39\uC73C\uB2C8\uAE4C \uC624\uB798 \uBABB \uC790\uACA0\uB354\uB77C\uACE0.[VAR 0114(004B)]",
  "\uC548\uB155, [VAR 0100(0000)]!\\n\uAD50\uD658 \uC720\uD559\uC740 \uC798 \uB9CC\uB07D\uD558\uACE0 \uC788\uB2C8?\\c\\n\uD3EC\uCF13\uBAAC\uB3C4 \uB9CE\uC774 \uC7A1\uACE0!\\n\uBE14\uB8E8\uB808\uD06C\uB3C4 \uD558\uBA74\uC11C \uC990\uAC81\uAC8C \uC9C0\uB0B4\uB834![VAR 0114(004B)]",
  "\uC11D\uC591\uC744 \uAD6C\uACBD\uD558\uAE30\uC5D0\\n\uC644\uC804 \uCD5C\uACE0\uC758 \uC790\uB9AC\uC9C0 \uC54A\uB2C8?\\c\\n\uC774\uAC83\uB9CC \uBD10\uB3C4 \uBC14\uB2E4 \uD55C\uAC00\uC6B4\uB370\uC5D0\\n\uD559\uAD50\uB97C \uC9D3\uAE30 \uC798\uD588\uB2E8 \uC0DD\uAC01\uC774 \uB4E0\uB2E8 \uB9D0\uC774\uC9C0~[VAR 0114(004B)]",
  "\uC548\uB155, [VAR 0100(0000)]!\\n\uB108\uB294 \uBC24\uC5D0\uB3C4 \uAE30\uC6B4\uC774 \uB118\uCE58\uB294\uAD6C\uB098~\\c\\n\uC774 \uC544\uC800\uC528\uB294\\n\uC2AC\uC2AC \uC790\uB7EC \uAC00\uC57C\uC9C0.[VAR 0114(004B)]",
  "\uC548\uB155!\\n\uC624\uB298\uC740 \uBE44\uAC00 \uC624\uB124~\\c\\n\uBB50, \uC637\uC774 \uC816\uB354\uB77C\uB3C4\\n\uD30C\uB3C4 \uB54C\uBB38\uC778\uC9C0 \uBE44 \uB54C\uBB38\uC778\uC9C0 \uC54C \uC218 \uC5C6\uB294 \uAC8C\\r\\n\uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758 \uC7A5\uC810\uC774\uB2C8\uAE4C.[VAR 0114(004B)]",
  "\uC548\uB155, [VAR 0100(0000)]!\\n\uB610 \uBE44\uAC00 \uC624\uB124~\\c\\n\uC785\uAD6C\uC5D0 \uC9C0\uBD95\uC744 \uC124\uCE58\uD560 \uC218\uB3C4 \uC788\uC5C8\uC9C0\uB9CC,\\n\uBB3C\uC744 \uC88B\uC544\uD558\uB294 \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uC73C\uB2C8\uAE4C \uADF8\uB9CC\uB480\uC5B4![VAR 0114(004B)]",
  "\uC544\uC27D\uC9C0\uB9CC \uC624\uB298\uC740\\n\uC11D\uC591\uC744 \uBCF4\uAE30 \uADF8\uB978 \uBAA8\uC591\uC774\uC57C.\\c\\n\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC758 \uD558\uB298\uB85C\\n\uC778\uACF5 \uC11D\uC591\uC774\uB098 \uC990\uAE38\uAE4C?[VAR 0114(004B)]",
  "\uC548\uB155, [VAR 0100(0000)]!\\n\uBE44\uC5D0 \uC816\uC73C\uBA74\uC11C\uB3C4 \uC5F4\uC2EC\uC774\uAD6C\uB098~\\c\\n\uBC14\uB2E5\uC774 \uBBF8\uB044\uB7EC\uC6B8 \uD14C\uB2C8\\n\uBC14\uB2E4\uC5D0 \uBE60\uC9C0\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uB834~[VAR 0114(004B)]",
  "\uBE14\uB8E8\uBCA0\uB9AC\uB3C4\uAC10\uC744 \uC644\uC131\uD558\uAC70\uB4E0\\n\uB3C4\uAC10 \uC571\uC5D0\uC11C [VAR FF00(0006)]X \uBC84\uD2BC[VAR FF00(0000)]\uC744 \uB20C\uB7EC\uC11C\\c\\n\uB3C4\uAC10 \uC644\uC131 \uD45C\uC2DD\uC744 \uCD94\uAC00\uD558\uACE0\\n\uBCF4\uC5EC \uC8FC\uB7EC \uC624\uB834~[VAR 0114(004B)]"
]
