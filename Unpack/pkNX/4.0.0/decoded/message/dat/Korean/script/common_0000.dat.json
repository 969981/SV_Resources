[
  "[~ 21]",
  "\uC0AC\uB9BD \uC624\uB80C\uC9C0 \uC544\uCE74\uB370\uBBF8",
  "\uC0AC\uB9BD \uADF8\uB808\uC774\uD504 \uC544\uCE74\uB370\uBBF8",
  "\uC804\uD1B5\uC73C\uB85C\uBD80\uD130 \uBC30\uC6B0\uBA70\\n\uAC15\uD558\uACE0 \uD06C\uAC8C \uC790\uB77C\uC790",
  "\uAC1C\uAC1C\uC778\uC758 \uAC1C\uC131\uC744 \uC18C\uC911\uD788 \uD558\uBA70\\n\uBBF8\uB798\uB97C \uAC1C\uCC99\uD558\uC790",
  "\uC790, \uB2F9\uC2E0\uB3C4\\n\uD3EC\uCF13\uBAAC\uC2A4\uD130\uC758 \uC138\uACC4\uB85C!",
  "\uC624\uB80C\uC9C0 \uC544\uCE74\uB370\uBBF8\\n\uAD50\uC7A5 \uD074\uB77C\uBCA8",
  "\uADF8\uB808\uC774\uD504 \uC544\uCE74\uB370\uBBF8\\n\uAD50\uC7A5 \uD074\uB77C\uBCA8",
  "\uD48D\uBD80\uD55C \uC790\uC5F0\uACFC\\n\uBE44\uC625\uD55C \uD1A0\uC9C0\uAC00 \uD3BC\uCCD0\uC9C4 \uD314\uB370\uC544\uC9C0\uBC29.",
  "\uC774\uACF3\uC5D0\uB294 \uD3EC\uCF13\uBAAC\uC2A4\uD130...\\n\uC904\uC5EC\uC11C \uD3EC\uCF13\uBAAC\uC774\uB77C \uBD88\uB9AC\uB294",
  "\uC2E0\uBE44\uD55C \uC0DD\uBA85\uCCB4\uAC00\\n\uB9CE\uC774 \uC0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4.",
  "\uD3EC\uCF13\uBAAC\uB4E4\uC740 \uBC14\uB2E4\uB098 \uD558\uB298\\n\uADF8\uB9AC\uACE0 \uB9C8\uC744\uC744 \uBE44\uB86F\uD55C \uB3C4\uCC98\uC5D0 \uC0B4\uACE0 \uC788\uC73C\uBA70",
  "\uC6B0\uB9AC \uC778\uAC04\uB4E4\uC740 \uADF8\uB4E4\uACFC \uD798\uC744 \uD569\uCCD0\\n\uC0DD\uD65C\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.",
  "\uC800\uD76C \uC624\uB80C\uC9C0 \uC544\uCE74\uB370\uBBF8\uB294\\n\uC774\uB7F0 \uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD574 \uB354\uC6B1 \uAE4A\uC774 \uC54C\uAE30 \uC704\uD574",
  "\uC800\uD76C \uADF8\uB808\uC774\uD504 \uC544\uCE74\uB370\uBBF8\uB294\\n\uC774\uB7F0 \uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD574 \uB354\uC6B1 \uAE4A\uC774 \uC54C\uAE30 \uC704\uD574",
  "\uC5EC\uB7EC \uC9C0\uBC29\uC5D0\uC11C \uC628 \uC0AC\uB78C\uB4E4\uC774\\n\uD55C\uB370 \uC5B4\uC6B0\uB7EC\uC838 \uB2E4 \uD568\uAED8 \uACF5\uBD80\uD558\uACE0",
  "\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uAC00 \uB418\uC5B4\\n\uD3EC\uCF13\uBAAC \uBC30\uD2C0\uC744 \uD1B5\uD574 \uD568\uAED8 \uC131\uC7A5\uD558\uB294 \uB4F1",
  "\uB2E4\uC591\uD55C \uCEE4\uB9AC\uD058\uB7FC\uC744 \uD1B5\uD574\\n\uD559\uC0DD\uB4E4\uC758 \uAC00\uB2A5\uC131\uC744 \uC774\uB04C\uC5B4 \uB0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4.",
  "\uC774\uACF3\uC740 \uCE5C\uAD6C\uB4E4\uACFC \uD3EC\uCF13\uBAAC,\\n\uADF8\uB9AC\uACE0 \uC0C8\uB85C\uC6B4 \uC790\uC2E0\uC744 \uB9CC\uB0A0 \uC218 \uC788\uB294 \uACF3...",
  "\uC624\uB80C\uC9C0 \uC544\uCE74\uB370\uBBF8\uC5D0 \uC785\uD559\uD558\uC2DC\uB294 \uADF8\uB0A0\uC744\\n\uC190\uAF3D\uC544 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4.",
  "\uADF8\uB808\uC774\uD504 \uC544\uCE74\uB370\uBBF8\uC5D0 \uC785\uD559\uD558\uC2DC\uB294 \uADF8\uB0A0\uC744\\n\uC190\uAF3D\uC544 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
]
