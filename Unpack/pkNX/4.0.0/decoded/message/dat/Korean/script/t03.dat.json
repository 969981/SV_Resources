[
  "\uD68C\uBCF5\uC740 \uD2C8\uD2C8\uC774!\\n\uC0C1\uC810\uC744 \uBCF4\uBA74 \uC1FC\uD551!\\r\\n\uC774\uAC8C \uBC14\uB85C \uC548\uC804\uD55C \uBAA8\uD5D8\uC758 \uBE44\uACB0\uC774\uC57C!",
  "\uC774 \uD2B8\uB7ED\uC73C\uB85C\\n\uC62C\uB9AC\uBE0C\uB97C \uC6B4\uBC18\uD558\uACE0 \uC788\uC5B4.\\r\\n\uC218\uD655\uCCA0\uC5D0\uB294 \uC9C4\uC9DC \uBC14\uC058\uB2E4\uB2C8\uAE4C!",
  "\u201C\uC0AC\uBCF4\uB2C8\uC5D0\uB974\u201D\uC5D0\uC11C \uD30C\uB294 \uACFC\uC790\uB294\\n\uC5C4\uCCAD\uB098\uAC8C \uB9DB\uC788\uC5B4\uC11C \uC778\uAE30 \uB9CC\uC810\uC774\uC57C!",
  "\uC138\uB974\uD074\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC740\\n\uC2F8\uC6B0\uB294 \uD30C\uD2F0\uC2DC\uC5D0 \uB2E8\uD48D \uB2D8!\\r\\n\uCCAD\uC21C\uD574 \uBCF4\uC774\uB294 \uC678\uBAA8\uC5D0 \uBC29\uC2EC\uD558\uBA74 \uC548 \uB3FC!",
  "\uC138\uB974\uD074\uB9C8\uC744\uC740 \uC9C0\uAE08\\n\uD55C\uCC3D \uC62C\uB9AC\uBE0C \uC218\uD655\uC81C\uB97C \uD558\uB294 \uC911\uC774\uC57C!\\r\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB3C4 \uCD95\uC81C\uC640 \uAD00\uB828\uC774 \uC788\uC9C0!",
  "\uB370\uAD74\uB370\uAD74 \uB07C\uC775~!\\c\\n\uD0C0\uB79C\uD234\uB77C\uB294 \uC2E4\uD0C0\uB798\uB97C \uBAB8\uC5D0 \uAC10\uC544\uC11C\\n\uC678\uBD80\uC758 \uC801\uC73C\uB85C\uBD80\uD130 \uBAB8\uC744 \uC9C0\uD0A8\uB300!",
  "\uC5EC\uAE30\uB294 \uC138\uB974\uD074\uB9C8\uC744!\\n\uC138\uB974\uD074\uC740 \uC11C\uD074\uC774\uB77C\uACE0\uB3C4 \uC77D\uC744 \uC218 \uC788\uC5B4!\\r\\n\uC62C\uB9AC\uBE0C\uB791 \uB611\uAC19\uC740 \uBAA8\uC591\uC774\uC9C0!",
  "\uBE44\uBE44\uC6A9\uC740 \uC11C\uC2DD\uD558\uB358 \uC7A5\uC18C\uC5D0 \uB530\uB77C\\n\uBAA8\uC2B5\uC774 \uB2E4\uB974\uB2E4\uACE0 \uD574.\\c\\n\uC598\uB4E4\uC740 \uC5B4\uB514\uC5D0\uC11C \uC628 \uAC78\uAE4C?",
  "\uC774 \uAC00\uAC8C\uC5D0\uC11C\uB294 \uCC28\uB97C \uB9C8\uC2DC\uBA74\uC11C\\n\uCCB4\uC721\uAD00\uC5D0\uC11C \uC9C4\uD589 \uC911\uC778 \uC2B9\uBD80\uB97C \uBCFC \uC218 \uC788\uC5B4."
]
