[
  "\uB140\uC11D\uB4E4\uC758 \uACF5\uBD80\uB97C \uB3C4\uC640\uC904 \uC900\uBE44\uB294\\nOK\uC778 \uAC70\uC57C?[VAR 0114(0021)]",
