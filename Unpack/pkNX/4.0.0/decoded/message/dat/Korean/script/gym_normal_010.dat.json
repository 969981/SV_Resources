  "[~ 15]",
  "[~ 15]",
  "\uCC38\uD478\uB974\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uB3C4\uC804\uC790\uC758 \uC774\uB984\uC744\\n\uB4F1\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4...\\r\\n[VAR 0100(0000)] \uB2D8\uC774\uC2DC\uAD70\uC694!",
  "\uC774\uACF3\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5 \uCCAD\uBAA9 \uB2D8\uACFC\\n\uC2B9\uBD80\uD558\uB824\uBA74 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C\\r\\n\uD074\uB9AC\uC5B4\uD574\uC57C \uD569\uB2C8\uB2E4.",
  "\uCC38\uD478\uB974\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB294...\\n[VAR FF00(0006)]\uBE44\uBC00 \uBA54\uB274\uB97C \uC8FC\uBB38\uD558\uAE30[VAR FF00(0000)]!",
  "\uD569\uACA9 \uC870\uAC74\uC740 \uCC38\uD478\uB974\uB9C8\uC744\uC5D0\uC11C\\n\uAC00\uC7A5 \uC778\uAE30 \uC788\uB294 \uAC00\uAC8C, [VAR FF00(0006)]\uBCF4\uBB3C\uC2DD\uB2F9[VAR FF00(0000)]\uC5D0\uC11C\\r\\n\uBE44\uBC00 \uBA54\uB274\uB97C \uC8FC\uBB38\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4!",
  "\uD604\uC7AC \uC774 \uB9C8\uC744\uC5D0\uB294 \uB3C4\uC804\uC790\uB2D8 \uC678\uC5D0\uB3C4\\n3\uBA85\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uB3C4\uC804\uC790\uAC00 \uC788\uC2B5\uB2C8\uB2E4.",
  "\uB3C4\uC804\uC790\uB4E4\uAED8\uB294 \uBE44\uBC00 \uBA54\uB274\uC5D0 \uB300\uD55C\\n\uAC01\uAC01 \uB2E4\uB978 \uD78C\uD2B8\uB97C \uC54C\uB824 \uB4DC\uB838\uC2B5\uB2C8\uB2E4.",
  "\uADF8\uBD84\uB4E4\uACFC \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD574\uC11C\\n\uC774\uAE34 \uCABD\uC740 \uC9C4 \uCABD\uC5D0\uAC8C\\r\\n\uD78C\uD2B8\uB97C \uB4E4\uC73C\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",
  "\uBAA8\uC740 \uD78C\uD2B8\uB97C \uD1A0\uB300\uB85C\\n\uBCF4\uBB3C\uC2DD\uB2F9 \uC810\uC6D0\uC744 \uD1B5\uD574\\r\\n\uBE44\uBC00 \uBA54\uB274\uB97C \uC8FC\uBB38\uD574 \uC8FC\uC138\uC694.",
  "\uC8FC\uBB38\uC5D0 \uC131\uACF5\uD55C \uB2E8 \uD55C \uBA85\uB9CC\uC774\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uD569\uACA9\uC790\uAC00 \uB418\uC2ED\uB2C8\uB2E4.",
  "[VAR 0100(0000)] \uB2D8\uC5D0\uAC8C \uB4DC\uB9AC\uB294 \uD78C\uD2B8\uB294\\n[VAR FF00(0006)]\uB2E8\uACE8\uC190\uB2D8\uC758 \uBA39\uB294 \uBC29\uC2DD[VAR FF00(0000)]\uC785\uB2C8\uB2E4!",
  "\uBCF4\uBB3C\uC2DD\uB2F9\uC758 \uB2E8\uACE8\uC190\uB2D8\uC5D0\uAC8C\\n\uBB3C\uC5B4\uBCF4\uC2DC\uBA74 \uB3C4\uC6C0\uC774 \uB420 \uAC81\uB2C8\uB2E4!",
  "[~ 15]"
]
