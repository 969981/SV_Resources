[
  "\uC548\uB155! \uC624\uB298\uB3C4 \uAE30\uC6B4\uCC28\uAC8C!\\n\uBC30\uD2C0\uD559\uC5D0 \uB300\uD574 \uBC30\uC6CC \uBCFC\uAE4C![VAR 0114(0024)]",
  "\uB2E4\uB4E4 \uC911\uAC04\uACE0\uC0AC\uB294 \uC218\uACE0 \uB9CE\uC558\uC5B4![VAR 0114(0024)]",
  "\uC624\uB298\uBD80\uD130 \uC218\uC5C5\uC740 \uD6C4\uBC18\uC804\uC774\uC57C!\\n\uC815\uC2E0 \uBC14\uC9DD \uCC28\uB9AC\uACE0 \uACF5\uBD80\uD574 \uBCF4\uC790![VAR 0114(0024)]",
  "\uB2E4\uB4E4 \u201C\uB808\uCE20\uACE0 R \uBC84\uD2BC\u201D\uC740\\n\uC798 \uC4F0\uACE0 \uC788\uC9C0!?[VAR 0114(0024)]",
  "\uD3EC\uCF13\uBAAC\uC744 \uC55E\uC73C\uB85C \uB808\uCE20\uACE0! \uD574\uC11C[VAR 0114(0024)]",
  "\uB3C4\uAD6C\uB97C \uC8FC\uC6CC \uC624\uAC8C \uD560 \uC218 \uC788\uB2E4\uB2C8!\\n\uC815\uB9D0 \uC720\uC6A9\uD558\uC9C0 \uC54A\uC544?[VAR 0114(0024)]",
  "\uB808\uCE20\uACE0\uB85C \uB0B4\uBCF4\uB0B8 \uC704\uCE58\uC5D0\\n\uC57C\uC0DD \uD3EC\uCF13\uBAAC\uC774 \uC788\uC73C\uBA74\\r\\n\uADF8\uB300\uB85C \uBC30\uD2C0\uC744 \uD560 \uC218\uB3C4 \uC788\uC5B4![VAR 0114(0024)]",
  "\uADF8\uB7F0 \uC2DD\uC73C\uB85C \uC774\uB904\uC9C0\uB294 \uBC30\uD2C0\uC744\\n\uB9E1\uAE30\uAE30 \uBC30\uD2C0\uC774\uB77C\uACE0 \uBD80\uB974\uC9C0!![VAR 0114(0024)]",
  "\uB9D0 \uADF8\uB300\uB85C \uD2B8\uB808\uC774\uB108\uAC00\\n\uC9C0\uC2DC\uB97C \uB0B4\uB9AC\uC9C0 \uC54A\uACE0\\r\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC804\uBD80 \uB9E1\uACA8\uC11C \uBC30\uD2C0\uD558\uB294 \uAC70\uC57C![VAR 0114(0024)]",
  "\uC2B9\uBD80\uC5D0\uC11C \uC774\uAE30\uBA74 \uD3C9\uC18C\uC640 \uAC19\uC774\\n\uACBD\uD5D8\uCE58\uB97C \uC5BB\uC744 \uC218 \uC788\uC9C0![VAR 0114(0024)]",
  "\uB2A5\uC219\uD558\uAC8C \uC0AC\uC6A9\uD558\uBA74 \uD6A8\uC728 \uC88B\uAC8C\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uB4E4\uC744 \uB2E8\uB828\uC2DC\uD0AC \uC218 \uC788\uC5B4![VAR 0114(0024)]",
  "\uB300\uC2E0, \uB9E1\uAE30\uAE30 \uBC30\uD2C0 \uC911\uC5D0\uB294\\n\uB808\uBCA8\uC5C5\uC744 \uD574\uB3C4 \uAE30\uC220\uC744 \uBC30\uC6B0\uC9C0 \uC54A\uACE0\\r\\n\uC9C4\uD654\uB3C4 \uD558\uC9C0 \uC54A\uC73C\uB2C8 \uC8FC\uC758\uD558\uB3C4\uB85D \uD558\uB834![VAR 0114(0024)]",
  "\uADF8\uB9AC\uACE0, \uB9E1\uAE30\uAE30 \uBC30\uD2C0\uC5D0\uC11C \uD328\uBC30\uD558\uBA74\\nHP\uAC00 \uC5BC\uB9C8 \uB0A8\uC9C0 \uC54A\uC740 \uC0C1\uD0DC\uB85C \uB3CC\uC544\uC624\uB2C8\uAE4C\\r\\n\uBE60\uB974\uAC8C \uD68C\uBCF5\uC2DC\uCF1C \uC8FC\uACE0![VAR 0114(0024)]",
  "\uB300\uCDA9 \uB2E4 \uB9D0\uD55C \uAC83 \uAC19\uC740\uB370,\\n\uC9C0\uAE08\uAE4C\uC9C0 \uB9D0\uD55C \uB0B4\uC6A9\uC5D0 \uC9C8\uBB38 \uC788\uB294 \uC0AC\uB78C?[VAR 0114(0024)]",
  "\uC911\uB2E8\uD558\uACE0 \uC2F6\uC73C\uBA74 \uC5B4\uB5BB\uAC8C \uD574\uC694?",
  "\uD3EC\uD68D\uC740 \uD560 \uC218 \uC788\uB098\uC694?",
  "\uB531\uD788 \uC5C6\uC5B4\uC694",
  "\uB9E1\uAE30\uAE30 \uBC30\uD2C0\uC774 \uC2DC\uC791\uB418\uBA74\\n\uC2B9\uBD80\uAC00 \uB0A0 \uB54C\uAE4C\uC9C0 \uC911\uB2E8\uD560 \uC218 \uC5C6\uC5B4!\\c\\n\uB9E1\uAE30\uAE30 \uBC30\uD2C0\uC744 \uC2DC\uC791\uD558\uAE30 \uC804\uC774\uB77C\uBA74\\n\uD3EC\uCF13\uBAAC\uC774 \uC774\uB3D9\uD558\uB294 \uC911\uC5D0\\r\\n\u201C\uBCFC \uB358\uC9C0\uAE30 ZR \uBC84\uD2BC\u201D\uC73C\uB85C \uC911\uB2E8\uD560 \uC218 \uC788\uC5B4![VAR 0114(0024)]",
  "\uB9E1\uAE30\uAE30 \uBC30\uD2C0\uC5D0\uC11C\uB294 \uB0B4\uBC84\uB824 \uB450\uBA74\\n\uC0C1\uB300\uB97C \uC4F0\uB7EC\uB728\uB824 \uBC84\uB9AC\uB2C8\uAE4C\\c\\n\uD3EC\uD68D\uD558\uACE0 \uC2F6\uC73C\uBA74\\n\uC9C1\uC811 \uC9C0\uC2DC\uB97C \uB0B4\uB9AC\uBA74\uC11C \uC2F8\uC6CC\uC57C \uD574![VAR 0114(0024)]",
  "\uC74C! \uB2E4\uB4E4 \uC6B0\uC218\uD55C \uC544\uC774\uB4E4\uC774\uAD6C\uB098!\\n\uC7A5\uB798\uAC00 \uAE30\uB300\uB418\uB294\uAC78![VAR 0114(0024)]",
  "\uB9E1\uAE30\uAE30 \uBC30\uD2C0 \uC911\uC5D0\uB3C4\\n\uD3EC\uCF13\uBAAC\uC740 \uD2B8\uB808\uC774\uB108\uB97C \uC704\uD574\\r\\n\uB178\uB825\uD558\uACE0 \uC788\uC73C\uB2C8\uAE4C![VAR 0114(0024)]",
  "\uC218\uC2DC\uB85C \uC0C1\uD0DC\uB97C \uC0B4\uD53C\uACE0,\\n\uC774\uAE38 \uC218 \uC5C6\uC744 \uAC83 \uAC19\uC73C\uBA74\\r\\n\uB3CC\uC544\uC624\uAC8C \uD558\uB834![VAR 0114(0024)]",
  "\uB2F9\uC5F0\uD55C \uB9D0\uC774\uC9C0\uB9CC\\nHP\uAC00 \uC801\uC740 \uD3EC\uCF13\uBAAC\uC740 \uC9C0\uCE5C \uC0C1\uD0DC\uB77C,[VAR 0114(0024)]",
  "\uB9E1\uAE30\uAE30 \uBC30\uD2C0\uC744 \uAEBC\uB824 \uD558\uB2C8\uAE4C\\n\uB108\uBB34 \uBB34\uB9AC\uD558\uAC8C \uD558\uC9C0 \uB9D0\uACE0![VAR 0114(0024)]",
  "\uADF8\uB798\uC11C, \uC624\uB298\uC758 \uACB0\uB860!![VAR 0114(0024)]",
  "\uB9E1\uAE30\uAE30 \uBC30\uD2C0\uC744 \uC81C\uB300\uB85C \uD558\uB824\uBA74\\n\uC11C\uB85C\uB97C \uC2E0\uB8B0\uD574\uC57C \uD55C\uB2E4![VAR 0114(0024)]",
  "\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC2E0\uB8B0\uB97C \uC783\uC9C0 \uC54A\uAC8C\\n\uC798 \uD65C\uC6A9\uD558\uB3C4\uB85D![VAR 0114(0024)]",
  "\uC774\uB7F0! \uC9C1\uC811 \uCCB4\uD5D8\uD574 \uBCF4\uAC8C \uD558\uB824\uACE0 \uD588\uB294\uB370\\n\uBC8C\uC368 \uC2DC\uAC04\uC774 \uB418\uC5B4 \uBC84\uB838\uB124...[VAR 0114(0024)]",
  "\uADF8\uB7FC, \uD574\uC0B0!\\n\uB2E4\uB4E4 \uAC74\uAC15\uD558\uAC8C \uC9C0\uB0B4\uB834![VAR 0114(0024)]"
]
