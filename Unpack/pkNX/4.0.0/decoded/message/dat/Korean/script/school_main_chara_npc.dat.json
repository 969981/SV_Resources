  "N/A",
  "\uD559\uAD50\uC5D0\uC11C \uACE4\uB780\uD55C \uC77C\uC774 \uC788\uC73C\uC2DC\uAC70\uB4E0\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB9D0\uC500\uD574 \uC8FC\uC138\uC694.[VAR 0114(000A)]",
  "[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591\uC774 \uC800\uD76C \uD559\uAD50\uC5D0 \uC640 \uC8FC\uC154\uC11C\\n\uC5BC\uB9C8\uB098 \uAE30\uC05C\uC9C0 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC548\uB155! \uC804\uD559\uC0DD!\\n\uADFC\uC721\uC740 \uC815\uB9D0 \uCD5C\uACE0\uC9C0 \uC54A\uC544?[VAR 0114(0024)]",
  "\uC548\uB155! \uC804\uD559\uC0DD!\\n\uB2E8\uBC31\uC9C8\uC740 \uCDA9\uBD84\uD788 \uBCF4\uCDA9\uD558\uACE0 \uC788\uB2C8!?[VAR 0114(0024)]",
  "\uC548\uB155, [VAR 0100(0000)].\\n\uC9C8\uBB38\uC740 \uC5B8\uC81C\uB4E0\uC9C0 \uD658\uC601\uC774\uB780\uB2E4.[VAR 0114(0025)]",
  "\uC5B4\uBA38, [VAR 0100(0000)].\\n\uC624\uB298\uB3C4 \uC798 \uC9C0\uB0B4\uB294 \uAC83 \uAC19\uC544\uC11C \uB2E4\uD589\uC774\uC57C.[VAR 0114(0025)]",
  "\uB098\uC5D0\uAC8C \uB9D0\uC744 \uAC78\uC5B4\uC11C\\n\uC2DC\uAC04\uC744 \uB0AD\uBE44\uD558\uB2E4\uB2C8, \uBCC4\uB09C \uC544\uC774\uAD6C\uB098?[VAR 0114(0027)]",
  "[VAR 0100(0000)]...\\n\uB108\uB294 \uC815\uB9D0 \uD765\uBBF8\uB85C\uC6B4 \uD559\uC0DD\uC774\uC57C.[VAR 0114(0027)]",
  "\uB3D9\uD654\uC5D0 \uB300\uD55C \uAC74 \uC544\uC9C1 \uC870\uC0AC \uC911\uC774\uC57C.\\n\uC18D\uBCF4\uB97C \uAE30\uB300\uD558\uACE0 \uC788\uC5B4.[VAR 0114(0027)]",
  "\uC7AC\uC559\uC758 \uBCF4\uBB3C\uCC3E\uAE30...\\n\uC0DD\uAC01 \uC788\uC73C\uBA74 \uD55C\uBC88 \uAC00\uC11C \uC870\uC0AC\uD574 \uC918.[VAR 0114(0027)]",
  "\uC7AC\uC559\uC758 \uBCF4\uBB3C\uB4E4\uC740 \uC798 \uC9C0\uB0B4\uB2C8?\\c\\n\uB370\uB9AC\uACE0 \uC788\uAE30 \uD798\uB4E4\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB0B4\uAC00 \uB9E1\uC544 \uC904 \uD14C\uB2C8 \uB9D0\uB9CC \uD574![VAR 0114(0027)]",
  "\uC9C0\uCCE4\uC73C\uBA74 \uBCF4\uAC74\uC2E4\uC5D0\uC11C\\n\uC7A0\uAE50 \uC790\uACE0 \uAC00\uC9C0 \uADF8\uB798?[VAR 0114(0028)]",
  "[VAR 0100(0000)][VAR 1900(0006)]\uC796\uC544!\\n\uBB34\uB9AC\uD558\uC9C0 \uB9D0\uACE0 \uC26C\uB3C4\uB85D \uD574~[VAR 0114(0028)]",
  "\uB098\uB294 \uC2E0\uACBD \uC4F0\uC9C0 \uB9D0\uACE0\\n\uD3B8\uD788 \uC788\uB2E4 \uAC00\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uCD94\uCC9C\uD558\uB294 \uB514\uC800\uD2B8 \uAC00\uAC8C\uAC00 \uC788\uC73C\uBA74\\n\uACF5\uC720\uD574 \uC8FC\uC9C0 \uC54A\uACA0\uB098?[VAR 0114(0029)]",
  "\uC548\uB155 \uC548\uB155~\\n\uD3EC\uCF13\uBAAC\uC740 \uC5F4\uC2EC\uD788 \uBAA8\uC73C\uACE0 \uC788\uB2C8~?[VAR 0114(002A)]",
  "\uBAA9\uD45C\uB294 \uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC5D0\\n30\uC885\uB958 \uB4F1\uB85D\uD558\uAE30~!\\r\\n\uB2EC\uC131\uD558\uBA74 \uB098\uD55C\uD14C\uB3C4 \uB9D0\uD574 \uC918~[VAR 0114(002A)]",
  "\uBAA9\uD45C\uB294 \uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC5D0\\n100\uC885\uB958 \uB4F1\uB85D\uD558\uAE30~!\\r\\n\uB2EC\uC131\uD558\uBA74 \uB098\uD55C\uD14C\uB3C4 \uB9D0\uD574 \uC918~[VAR 0114(002A)]",
  "\uBAA9\uD45C\uB294 \uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC5D0\\n200\uC885\uB958 \uB4F1\uB85D\uD558\uAE30~!\\r\\n\uB2EC\uC131\uD558\uBA74 \uB098\uD55C\uD14C\uB3C4 \uB9D0\uD574 \uC918~[VAR 0114(002A)]",
  "\uBAA9\uD45C\uB294 \uD3EC\uCF13\uBAAC \uB3C4\uAC10\\n400\uC885\uB958 \uC81C\uD328\uD558\uAE30~!\\c\\n\uC644\uC131\uD558\uBA74 \uB3C4\uAC10 \uC571\uC5D0\uC11C [VAR FF00(0006)]X \uBC84\uD2BC[VAR FF00(0000)]\uC744 \uB20C\uB7EC\uC11C\\n\uB3C4\uAC10 \uC644\uC131\uC758 \uD45C\uC2DD\uC744 \uCD94\uAC00\uD55C \uB2E4\uC74C,\\r\\n\uB0B4\uAC8C \uBCF4\uC5EC \uC8FC\uB7EC \uC640~[VAR 0114(002A)]",
  "\uC55E\uC73C\uB85C\uB3C4 \uD314\uB370\uC544\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uC744\\n\uB9CE~\uC774 \uB9CC\uB098 \uBCF4\uB3C4\uB85D \uD558\uB834~![VAR 0114(002A)]",
  "Wow!\\n\uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uB2E4\uB2C8, \uB561\uD050![VAR 0114(0026)]",
  "Oh~! \uB098\uC758 \uCE5C\uC560\uD558\uB294 [VAR 0100(0000)]!\\n\uC138\uC774\uC9C0\uC640 \uCEE4\uBBA4\uB2C8\uCF00\uC774\uC158\uD558\uC9C0 \uC54A\uC744\uB798!?[VAR 0114(0026)]",
  "\uBE60\uBAA8\uB294 \uC870\uAE08\uC529\\n\uAC74\uAC15\uC744 Refresh\uD558\uACE0 \uC788\uB2E8\uB2E4![VAR 0114(0026)]",
  "\uBE60\uBAA8\uB294 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC5B4!\\n\uC870\uAE08 Silent\uD558\uC9C0\uB9CC \uB9D0\uC774\uC57C![VAR 0114(0026)]",
  "\uBE60\uBAA8\uB294 Very very \uAC74\uAC15\uD558\uB2E8\uB2E4!\\n\uB108\uC5D0\uAC8C \uB9E1\uAE34 \uB098\uC639\uC740\\r\\n\uC798 \uC9C0\uB0B4\uACE0 \uC788\uB2C8~!?[VAR 0114(0026)]",
