[
  "\uC624! \uC6B0\uB9AC \uD559\uC0DD \uCE5C\uAD6C\uC796\uC544!\\n\uC124\uB9C8...[VAR 0114(0046)]",
  "\uBD81\uC2E0\uC758 \uACE0\uC7A5\uC5D0\uC11C \uD3EC\uCF13\uBAAC\uC744\\n150\uC885\uB958 \uC774\uC0C1 \uC7A1\uC558\uAD6C\uB098! \uC815\uB9D0 \uB300\uB2E8\uD55C\uAC78![VAR 0114(0046)]",
  "\uB9DE\uC544\uC694!",
  "\uADF8\uB807\uAC8C\uAE4C\uC9C0 \uB300\uB2E8\uD558\uC9C0\uB294...",
  "\uC815\uB9D0 \uB300\uB2E8\uD558\uB2E4\uB2C8\uAE4C!\\n\uC80A\uC740 \uCE5C\uAD6C\uAC00 \uC544\uC8FC \uC81C\uBC95\uC774\uC57C~[VAR 0114(0046)]",
  "\uC544\uD558\uD558!\\n\uC80A\uC740 \uCE5C\uAD6C\uAC00 \uC880 \uB354 \uB2F9\uB2F9\uD574\uC9C0\uB77C\uAD6C![VAR 0114(0046)]",
  "\uADF8\uB807\uB2E4\uB294 \uAC74 \uC774\uC81C, \uBA3C\uC800 \uC628 \uB098\uBCF4\uB2E4\\n\uBD81\uC2E0\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uC5D0 \uB300\uD574 \uB354 \uC798 \uC54C\uACA0\uAD6C\uB098![VAR 0114(0046)]",
  "...\uADF8\uB807\uC9C0![VAR 0114(0046)]",
  "\uD3EC\uCF13\uBAAC \uD3EC\uD68D\uC758 \uBA85\uC778\uC778 \uB124\uAC8C\\n\uBD80\uD0C1\uD558\uACE0 \uC2F6\uC740 \uAC8C \uC788\uC5B4.[VAR 0114(0046)]",
  "\uBB34\uC2A8 \uBD80\uD0C1\uC774\uC694?",
  "\uAD00\uC2EC \uC5C6\uC5B4\uC694...",
  "\uC801\uADF9\uC801\uC778 \uC790\uC138\uAC00\\n\uBCF4\uAE30 \uC88B\uC740\uAC78!\\r\\n\uADF8\uB7FC, \uC124\uBA85\uD560\uAC8C.[VAR 0114(0046)]",
  "\uC774\uB7F0 \uC774\uB7F0, \uD559\uC0DD \uCE5C\uAD6C!\\n\uB54C\uB85C\uB294 \uBA40\uB9AC \uB3CC\uC544\uAC00\uB294 \uAC83\uB3C4 \uC911\uC694\uD558\uB2E4\uAD6C!\\r\\n...\uC544\uBB34\uD2BC \uB9C8\uC800 \uC774\uC57C\uAE30\uD560\uAC8C.[VAR 0114(0046)]",
  "\uB0B4\uAC00 \uBD81\uC2E0\uC758 \uACE0\uC7A5\uC5D0 \uC628 \uC774\uC720\uB294\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB098\uC11C...\\r\\n\uADF8 \uD3EC\uCF13\uBAAC\uC758 \uC0AC\uC9C4\uC744 \uCC0D\uAE30 \uC704\uD574\uC11C\uC57C.[VAR 0114(0046)]",
  "\uADF8\uB798\uC11C \uC904\uACE7 \uD63C\uC790\uC11C \uCC3E\uC544\uB2E4\uB154\uB294\uB370\\n\uC5B4\uB514 \uC788\uB294\uC9C0 \uC804\uD600 \uBAA8\uB974\uACA0\uB294 \uAC70 \uC788\uC9C0![VAR 0114(0046)]",
  "...\uADF8\uB798\uC11C \uB9D0\uC778\uB370!\\n\uC6B0\uB9AC \uD559\uC0DD \uCE5C\uAD6C\uAC00 \uAC19\uC774 \uCC3E\uC544 \uBD10 \uC8FC\uBA74\\r\\n\uC815\uB9D0 \uACE0\uB9C8\uC6B8 \uAC83 \uAC19\uC740\uB370... \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD574?[VAR 0114(0046)]",
  "\uB0B4\uAC00 \uCC3E\uACE0 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774\\n\uAF64\uB098 \uAC15\uD558\uB2E4\uB294 \uC18C\uBB38\uB3C4 \uC788\uC5B4\uC11C,[VAR 0114(0046)]",
  "\uB9CC\uC57D \uB124\uAC00 \uADF8 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uB294\uB2E4\uBA74,\\n\uB4E0\uB4E0\uD55C \uC5EC\uD589\uC758 \uB3D9\uBC18\uC790\uAC00 \uB418\uC5B4 \uC904 \uAC70\uC57C![VAR 0114(0046)]",
  "\uC5B4\uB54C? \uAD6C\uBBF8\uAC00 \uB2F9\uAE34\uB2E4\uBA74\\n\uB0B4\uAC8C \uC2E4\uB825\uC744 \uBCF4\uC5EC \uC8FC\uC9C0 \uC54A\uC744\uB798?[VAR 0114(0046)]",
  "\uC55E\uC73C\uB85C \uD30C\uD2B8\uB108\uAC00 \uB420 \uAC70\uB2C8\uAE4C\\n\uC2E4\uB825\uC744 \uD30C\uC545\uD574 \uB450\uACE0 \uC2F6\uAC70\uB4E0.\\r\\n\uB108\uC758 \uBA4B\uC9C4 \uBAA8\uC2B5\uC744 \uCC0D\uACE0 \uC2F6\uAE30\uB3C4 \uD558\uACE0 \uB9D0\uC774\uC57C.[VAR 0114(0046)]"
]
