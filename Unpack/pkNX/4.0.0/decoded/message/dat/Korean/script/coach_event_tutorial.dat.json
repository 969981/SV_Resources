[
  "\uC5B4\uB77C? [VAR 0100(0000)][VAR 1900(0006)]\uC796\uC544?\\n\uB9C8\uCE68 \uC798\uB410\uAD70![VAR 0114(004B)]",
  "\uC774\uC57C\uAE30\uB294 \uB4E4\uC5C8\uB2E8\uB2E4.\\n\uBE14\uB8E8\uBCA0\uB9AC\uADF8\uC758 \uCC54\uD53C\uC5B8\uC774 \uB418\uC5C8\uB2E4\uC9C0!?[VAR 0114(004B)]",
  "\uC774\uC57C~ \uB300\uB2E8\uD558\uB124!\\c\\n\uB108\uB97C \uC774\uACF3\uC5D0 \uCD08\uB300\uD55C \uAC74\\n\uC815\uB9D0 \uD0C1\uC6D4\uD55C \uC120\uD0DD\uC774\uC5C8\uB2E4\uB2C8\uAE4C![VAR 0114(004B)]",
  "\uB124\uAC00 \uC5EC\uAE30 \uC624\uACE0\uC11C\\n\uAF64 \uC2DC\uAC04\uC774 \uC9C0\uB09C \uAC83 \uAC19\uC740\uB370...\\c\\n\uC5B4\uB54C? \uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C\\n\uC990\uAC81\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uB2C8?[VAR 0114(004B)]",
  "\uC990\uAC70\uC6CC\uC694!",
  "\uADF8\uB7ED\uC800\uB7ED\uC774\uC694",
  "\uC88B\uC544, \uC88B\uC544.\\n\uB0B4\uAC00 \uB531 \uC6D0\uD558\uB358 \uB300\uB2F5\uC774\uC5C8\uC5B4![VAR 0114(004B)]",
  "\uD750\uC74C, \uADF8\uB7ED\uC800\uB7ED\uC774\uB77C...\\n\uADF8\uB7ED\uC800\uB7ED... \uD6CC\uB96D\uD558\uB2E4\uB294 \uAC70\uAD6C\uB098![VAR 0114(004B)]",
  "\uC544\uBB34\uD2BC, [VAR 0100(0000)]...\\n\uB124\uAC8C \uAE34\uD788 \uBD80\uD0C1\uD558\uACE0 \uC2F6\uC740 \uAC8C \uC788\uB2E8\uB2E4.[VAR 0114(004B)]",
  "\uB124\uAC00 \uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0 \uC628 \uB4A4\uB85C\\n\uD559\uAD50 \uC804\uCCB4\uC5D0 \uD65C\uAE30\uAC00 \uB118\uCE58\uAC8C \uB418\uC5C8\uB2E8 \uB9D0\uC774\uC9C0![VAR 0114(004B)]",
  "\uADF8\uB798\uC11C, \uC55E\uC73C\uB85C\uB294 \uC880 \uB354 \uC801\uADF9\uC801\uC73C\uB85C\\n\uD314\uB370\uC544\uC9C0\uBC29\uC5D0\uC11C \uB2E4\uC591\uD55C \uC0AC\uB78C\uB4E4\uC744\\r\\n[VAR FF00(0006)]\uD2B9\uBCC4 \uAC15\uC0AC[VAR FF00(0000)]\uB85C \uCD08\uBE59\uD574 \uBCFC \uC0DD\uAC01\uC774\uB780\uB2E4![VAR 0114(004B)]",
  "\uB108, \uBC1C\uC774 \uC81C\uBC95 \uB113\uC740 \uAC83 \uAC19\uB358\uB370...\\n\uCE5C\uAD6C\uB3C4 \uB9CE\uC740 \uD3B8\uC774\uC9C0?[VAR 0114(004B)]",
  "\uD639\uC2DC \uC798 \uC544\uB294 \uC120\uC0DD\uB2D8\uC774\uB098\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774 \uC788\uC73C\uBA74 \uCD08\uB300\uD574 \uC8FC\uC9C0 \uC54A\uC744\uB798?\\r\\n\uC544\uB2C8\uBA74, \uAC15\uD55C \uCE5C\uAD6C\uB3C4 \uC88B\uACE0![VAR 0114(004B)]",
  "\uB9E1\uACA8\uB9CC \uC8FC\uC138\uC694!",
  "\uC73C\uC74C...",
  "\uC5ED\uC2DC \uC6B0\uB9AC \uCC54\uD53C\uC5B8!\\n\uC544\uC8FC \uBBFF\uC74C\uC9C1\uD55C\uAC78![VAR 0114(004B)]",
  "\uC5ED\uC2DC \uC6B0\uB9AC \uCC54\uD53C\uC5B8!\\n\uBC8C\uC368 \uB204\uAD6C\uBD80\uD130 \uBD80\uB97C\uC9C0 \uACE0\uBBFC\uD558\uB2E4\uB2C8![VAR 0114(004B)]",
  "\uBD80\uC2E4\uC5D0 \uC788\uB294 PC\uB85C\\n\uCD08\uB300\uD560 \uC0AC\uB78C\uC774\uB791 \uC5F0\uB77D\uD574 \uBCF4\uB834![VAR 0114(004B)]",
  "\uC5EC\uBE44\uB791 \uC774\uAC83\uC800\uAC83 \uCC59\uACA8 \uC8FC\uB294 \uB370\\nBP\uAC00 \uD544\uC694\uD558\uB2C8\uAE4C \uC774\uAC78 \uC0AC\uC6A9\uD558\uACE0.[VAR 0114(004B)]",
  "[VAR 0100(0000)][VAR 1900(0001)] \uC2DC\uC544\uB178 \uC120\uC0DD\uB2D8\uC73C\uB85C\uBD80\uD130\\n200BP\uB97C \uBC1B\uC558\uB2E4!",
  "\uD2B9\uBCC4 \uAC15\uC0AC\uB85C \uCD08\uB300\uD55C \uC0AC\uB78C\uC740\\n\uC774 \uBD80\uC2E4\uC5D0\uC11C \uB300\uAE30\uD560 \uC608\uC815\uC774\uB2C8\uAE4C\\r\\n\uACB8\uC0AC\uACB8\uC0AC \uAD50\uB958\uB3C4 \uB098\uB204\uACE0 \uD558\uB834![VAR 0114(004B)]",
  "\uADF8\uB7FC, \uBD80\uD0C1\uD558\uB9C8~[VAR 0114(004B)]"
]
