[
  "\uC6B4\uB3D9\uC7A5\uC5D0 \uBAA8\uC5EC \uC788\uB358\\n\uC560\uB4E4\uD55C\uD14C\uB294 \uC0AC\uACFC\uD560\uAC8C![VAR 0114(0024)]",
  "\uC544\uBB34\uB9AC \uADF8\uB798\uB3C4 \uC2DC\uD5D8\uC740\\n\uAD50\uC2E4\uC5D0\uC11C \uBD10\uC57C\uC9C0!\\r\\n\uC6B4\uB3D9\uC7A5\uC5D0\uC11C\uB294 \uB2F5\uC744 \uC4F0\uAE30 \uC5B4\uB835\uC796\uC544![VAR 0114(0024)]",
  "\uADF8\uB7FC, \uBD84\uBC1C\uD574\uC11C\\n\uB2F5\uC548\uC9C0\uC640 \uC2F8\uC6CC \uBCF4\uB834![VAR 0114(0024)]",
  "1. \uD3EC\uCF13\uBAAC\uC758 \uD2B9\uC218\uBC29\uC5B4\uAC00 \uB192\uC744\uC218\uB85D\\n    \u3007\u3007 \uAE30\uC220\uB85C \uC785\uB294 \uB370\uBBF8\uC9C0\uAC00 \uC904\uC5B4\uB4E0\uB2E4.\\n\\n1) \uBB3C\uB9AC 2) \uD2B9\uC218 3) \uD14C\uB77C\uC2A4\uD0C8",
  "\uBB3C\uB9AC",
  "\uD2B9\uC218",
  "\uD14C\uB77C\uC2A4\uD0C8",
  "2. \uB2E4\uC74C \uC911, \uAE30\uC220\uC758 \uB370\uBBF8\uC9C0\uC640\\n    \uAD00\uACC4\uC5C6\uB294 \uC694\uC18C\uB294?\\n\\n1) \uAE30\uC220\uC758 \uD0C0\uC785 2) \uAE30\uC220\uC758 \uC704\uB825\\n3) \uAE30\uC220\uC758 \uC774\uB984",
  "\uAE30\uC220\uC758 \uD0C0\uC785",
  "\uAE30\uC220\uC758 \uC704\uB825",
  "\uAE30\uC220\uC758 \uC774\uB984",
  "3. \uD14C\uB77C \uB808\uC774\uB4DC\uBC30\uD2C0\uC740\\n    \uBA87 \uBA85\uC774\uC11C \uB3C4\uC804\uD560 \uC218 \uC788\uB294\uAC00?\\n\\n1) 3\uBA85 2) 4\uBA85 3) 8\uBA85",
  "3\uBA85",
  "4\uBA85",
  "8\uBA85",
  "4. \uB2E4\uC74C \uC911, \uC0C1\uB300\uC758 \uD14C\uB77C\uC2A4\uD0C8 \uC2E4\uB4DC\uB97C\\n    \uD30C\uAD34\uD558\uB294 \uB370 \uC720\uD6A8\uD55C \uD589\uB3D9\uC740?\\n\\n1) \uD3EC\uCF13\uBAAC \uAD50\uD658 2) \uD14C\uB77C\uC2A4\uD0C8\uD558\uC5EC \uACF5\uACA9\\n3) \uC751\uC6D0",
  "\uD3EC\uCF13\uBAAC \uAD50\uD658",
  "\uD14C\uB77C\uC2A4\uD0C8\uD558\uC5EC \uACF5\uACA9",
  "\uC751\uC6D0",
  "5. \uC6B4\uD5A5 \uC120\uC0DD\uB2D8\uC774 \uC88B\uC544\uD558\uB294 \uD0C0\uC785\uC740?\\n\\n1) \uACA9\uD22C 2) \uBD88\uAF43 3) \uC5D0\uC2A4\uD37C",
  "\uACA9\uD22C",
  "\uBD88\uAF43",
  "\uC5D0\uC2A4\uD37C",
  "\uC790, \uAC70\uAE30\uAE4C\uC9C0!!\\n\uD544\uAE30\uAD6C\uB294 \uB0B4\uB824\uB193\uC73C\uC2DC\uACE0![VAR 0114(0024)]",
  "\uB2E4\uB4E4 \uC5F4\uC2EC\uD788 \uD588\uC73C\uB2C8\uAE4C!\\n\uBAA8\uB450 100\uC810\uC77C \uAC70\uC57C![VAR 0114(0024)]",
  "\uADF8\uB7FC, \uC2DC\uD5D8 \uBCF4\uB290\uB77C \uC218\uACE0\uD588\uC5B4!\\n\uACB0\uACFC\uB294 \uC811\uC218\uCC98\uC5D0\uC11C \uB4E3\uB3C4\uB85D \uD558\uB834![VAR 0114(0024)]"
