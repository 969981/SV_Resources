[
  "\uC548\uB155! \uC624\uB298\uB3C4 \uAE30\uC6B4\uCC28\uAC8C!\\n\uBC30\uD2C0\uD559\uC5D0 \uB300\uD574 \uBC30\uC6CC \uBCFC\uAE4C![VAR 0114(0024)]",
  "\uC9C0\uB09C\uBC88\uC5D0 \uBC30\uC6E0\uB358 \uD14C\uB77C \uB808\uC774\uB4DC\uBC30\uD2C0!\\n\uB2E4\uB4E4 \uB3C4\uC804\uD558\uACE0 \uC788\uACA0\uC9C0?[VAR 0114(0024)]",
  "\uD14C\uB77C\uC2A4\uD0C8 \uD3EC\uCF13\uBAAC\uC740 \uAC15\uD574!\\n\uB09C\uC774\uB3C4\uAC00 \uC5B4\uB824\uC6B4 \uC0C1\uB300\uC77C\uC218\uB85D \uB354\uC6B1\\r\\n\uAE4C\uB2E4\uB85C\uC6B4 \uD589\uB3D9\uC744 \uCDE8\uD558\uC9C0.[VAR 0114(0024)]",
  "\uC774\uB984\uD558\uC5EC [VAR FF00(0006)]\uD14C\uB77C\uC2A4\uD0C8 \uC2E4\uB4DC[VAR FF00(0000)]![VAR 0114(0024)]",
  "\uC0C1\uB300\uAC00 \uD14C\uB77C\uC2A4\uD0C8 \uC2E4\uB4DC\uB97C \uC804\uAC1C\uD558\uBA74,[VAR 0114(0024)]",
  "\uC0C1\uB300\uAC00 \uC785\uB294 \uB370\uBBF8\uC9C0\uAC00\\n\uD06C\uAC8C \uC904\uC5B4\uB4E4\uC5B4 \uBC84\uB824![VAR 0114(0024)]",
  "\uADF8\uAC8C \uBC1C\uB3D9\uD558\uBA74 \uACB0\uAD6D...[VAR 0114(0024)]",
  "\uC6B0\uB9AC\uB294 \uAF3C\uC9DD\uC5C6\uC774\\n\uC9C8 \uC218\uB3C4 \uC788\uB294 \uAC70\uC57C...![VAR 0114(0024)]",
  "\uC5EC\uAE30\uC11C \uBB38\uC81C![VAR 0114(0024)]",
  "\uC0C1\uB300\uAC00 \uD14C\uB77C\uC2A4\uD0C8 \uC2E4\uB4DC\uB97C \uC804\uAC1C\uD558\uBA74\\n\uC6B0\uB9AC\uB294 \uBB58 \uD574\uC57C \uD558\uC9C0!?[VAR 0114(0024)]",
  "\uC870\uC6A9\uD788 \uB208\uC744 \uAC10\uB294\uB2E4",
  "\uC9D1\uC5D0 \uC804\uD654\uD55C\uB2E4",
  "\uD14C\uB77C\uC2A4\uD0C8\uD574\uC11C \uACF5\uACA9\uD55C\uB2E4",
  "\uC774\uBD10 \uC774\uBD10,\\n\uADF8\uB0E5 \uCD5C\uD6C4\uB97C \uBC1B\uC544\uB4E4\uC5EC \uBC84\uB9AC\uBA74 \uC5B4\uB5A1\uD574!\\r\\n\uBC1C\uBC84\uB465 \uCE58\uB2E4 \uBCF4\uBA74 \uB3CC\uD30C\uAD6C\uAC00 \uC5F4\uB9AC\uC9C0 \uC54A\uACA0\uC5B4!?[VAR 0114(0024)]",
  "\uC774\uBD10 \uC774\uBD10, \uCD5C\uD6C4\uB97C \uBC1B\uC544\uB4E4\uC774\uACE0\\n\uAC00\uC871\uB4E4\uC774\uB791 \uD1B5\uD654\uB97C \uD558\uBA74 \uC5B4\uB5A1\uD574!\\r\\n\uBC1C\uBC84\uB465 \uCE58\uB2E4 \uBCF4\uBA74 \uB3CC\uD30C\uAD6C\uAC00 \uC5F4\uB9AC\uC9C0 \uC54A\uACA0\uC5B4!?[VAR 0114(0024)]",
  "\uC815\uB2F5\uC774\uC57C! \uC804\uD559\uC0DD\uC740\\n\uD14C\uB77C \uB808\uC774\uB4DC\uBC30\uD2C0\uC758 \uC804\uBB38\uAC00\uC778\uAC78![VAR 0114(0024)]",
  "\uD14C\uB77C\uC2A4\uD0C8 \uC2E4\uB4DC\uB97C \uC804\uAC1C\uD55C \uC0C1\uB300\uC5D0\uAC8C\\n\uC77C\uBC18\uC801\uC778 \uACF5\uACA9\uC740 \uC798 \uD1B5\uD558\uC9C0 \uC54A\uC544![VAR 0114(0024)]",
  "\uADF8\uB807\uC9C0\uB9CC, \uC6B0\uB9AC\uB3C4 \uD14C\uB77C\uC2A4\uD0C8\uD558\uBA74\\n\uC720\uD6A8\uD0C0\uB97C \uB0A0\uB9B4 \uC218 \uC788\uC9C0!\\c\\n\uD14C\uB77C\uC2A4\uD0C8\uD0C0\uC785\uC758 \uAE30\uC220\uC744 \uC0AC\uC6A9\uD558\uBA74\\n\uB354 \uD070 \uB370\uBBF8\uC9C0\uB97C \uC904 \uC218 \uC788\uC5B4![VAR 0114(0024)]",
  "\uACC4\uC18D\uD574\uC11C \uB370\uBBF8\uC9C0\uB97C \uC8FC\uB2E4 \uBCF4\uBA74\\n\uD14C\uB77C\uC2A4\uD0C8 \uC2E4\uB4DC\uB97C \uD30C\uAD34\uD574\uC11C\\r\\n\uC0C1\uB300\uC758 \uC790\uC138\uB97C \uBB34\uB108\uB728\uB9B4 \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(0024)]",
  "\uADF8\uB7EC\uB2C8\uAE4C \uD14C\uB77C \uB808\uC774\uB4DC\uBC30\uD2C0 \uC911\uC5D0\uB294\\n\uD14C\uB77C\uC2A4\uD0C8\uD558\uB294 \uD0C0\uC774\uBC0D\uB3C4 \uC798 \uC0DD\uAC01\uD574\uC57C \uD574.[VAR 0114(0024)]",
  "\uADF8\uB798\uC11C, \uC624\uB298\uC758 \uACB0\uB860!![VAR 0114(0024)]",
  "\uB208\uC5D0\uB294 \uB208!\\n\uD14C\uB77C\uC2A4\uD0C8\uC5D0\uB294 \uD14C\uB77C\uC2A4\uD0C8![VAR 0114(0024)]",
  "\uB3D9\uB8CC\uB4E4\uACFC \uD638\uD761\uC744 \uB9DE\uCDB0\uC11C\\n\uD14C\uB77C\uC2A4\uD0C8 \uC2E4\uB4DC\uB97C \uD30C\uAD34\uD558\uB3C4\uB85D![VAR 0114(0024)]",
  "\uC774\uB7F0! \uC9C1\uC811 \uCCB4\uD5D8\uD574 \uBCF4\uAC8C \uD558\uB824\uACE0 \uD588\uB294\uB370\\n\uBC8C\uC368 \uC2DC\uAC04\uC774 \uB418\uC5B4 \uBC84\uB838\uB124...[VAR 0114(0024)]",
  "\uB2E4\uC74C \uC2DC\uAC04\uC5D0\uB294 \uC911\uAC04\uACE0\uC0AC\uB97C \uBCFC \uAC70\uC57C!\\n100\uC810\uC744 \uBAA9\uD45C\uB85C \uC544\uC790! \uC544\uC790![VAR 0114(0024)]"
]
