[
  "\uD314\uB370\uC544\uC758 \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C \uC654\uB2E4.[VAR 0114(0029)]",
  "\uB0B4 \uC774\uB984\uC740 \uC0AC\uAD6C\uC544\uB85C.\\n\uC55E\uC73C\uB85C \uC798 \uBD80\uD0C1\uD55C\uB2E4.[VAR 0114(0029)]",
  "[VAR 0100(0000)], \uC5ED\uC2DC \uC790\uB124\uC600\uAD70.[VAR 0114(0029)]",
  "\uC720\uD559\uC9C0\uC5D0\uC11C \uC88B\uC740 \uC131\uC801\uC744 \uAE30\uB85D\uD574\uC11C\\n\uC778\uC7AC\uB97C \uBD88\uB7EC \uBAA8\uC73C\uB294 \uC77C\uC744 \uB9E1\uAC8C \uB41C\\r\\n\uB300\uB2E8\uD55C \uD559\uC0DD\uC774 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uAC70\uB4E0.[VAR 0114(0029)]",
  "\uC5B4\uB5A4 \uB300\uB2E8\uD55C \uC778\uBB3C\uC778\uAC00 \uD588\uB294\uB370\\n\uADF8 \uC815\uCCB4\uAC00 \uC790\uB124\uB77C\uBA74 \uB0A9\uB4DD\uC774 \uAC00\uB294\uAD70.[VAR 0114(0029)]",
  "\uAC10\uC0AC\uD569\uB2C8\uB2E4!",
  "\uADF8\uB807\uC8E0?",
  "\uD6D7... \uADF8 \uC194\uC9C1\uD568\uC774\\n\uC131\uACF5\uC758 \uBE44\uACB0\uC778 \uAC74\uAC00?[VAR 0114(0029)]",
  "\uD6D7... \uADF8 \uC7A5\uB09C\uAE30\uAC00\\n\uC131\uACF5\uC758 \uBE44\uACB0\uC778 \uAC74\uAC00?[VAR 0114(0029)]",
  "\uC81C\uC790\uAC00 \uB300\uC131\uD55C \uBAA8\uC2B5\uC744 \uBCF4\uB294 \uAC74\\n\uB098\uC5D0\uAC8C\uB3C4 \uB9E4\uC6B0 \uAE30\uC05C \uC77C\uC774\uB2E4.[VAR 0114(0029)]",
  "\uC790\uB124\uC5D0\uAC8C \uC9C0\uC9C0 \uC54A\uB3C4\uB85D\\n\uB098\uB3C4 \uC774 \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C \uCD5C\uC120\uC744 \uB2E4\uD558\uB9C8.[VAR 0114(0029)]",
  "[VAR 0100(0000)], \uC7A0\uAE50 \uAD1C\uCC2E\uB098?[VAR 0114(0029)]",
  "\uB098\uB3C4 \uC2A4\uB9C8\uD2B8\uD3F0 \uCEE4\uBC84\uB97C \uC0AC\uC11C\\n\uC7A5\uCC29\uD574 \uBD24\uB294\uB370...[VAR 0114(0029)]",
  "\uC774\uB807\uAC8C \uC7A5\uCC29\uD558\uB294 \uAC8C \uB9DE\uB098?[VAR 0114(0029)]",
  "\uB9DE\uC544\uC694!",
  "\uADC0\uC5FD\uB124\uC694!",
  "\uD398\uD37C\uB791 \uB611\uAC19\uC740 \uAC70\uB124\uC694!",
  "\uADF8\uB807\uB2E4\uBA74 \uB2E4\uD589\uC774\uAD70!\\n\uC774\uB7F0 \uAC78 \uD574 \uBCF4\uB294 \uAC8C \uCC98\uC74C\uC774\uB77C...[VAR 0114(0029)]",
  "\uD638\uC624! \uADF8\uB798!?\\n\uC790\uB124\uB3C4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uB098!?\\r\\n\uC815\uB9D0\uC774\uC9C0, \uB0B4 \uB9C8\uC74C\uC5D0 \uC3D9 \uB4DC\uB294 \uCF00\uC774\uC2A4\uC57C![VAR 0114(0029)]",
  "\uD638\uC624? \uD398\uD37C \uCCAD\uB144\uACFC \uAC19\uC740 \uCF00\uC774\uC2A4\uB77C\uACE0?\\n\uADF8 \uCE5C\uAD6C\uB3C4 \uCC38 \uBCF4\uB294 \uB208\uC774 \uC788\uB294\uAC78![VAR 0114(0029)]",
  "\uC774 \uAF43\uBB34\uB2AC \uCEE4\uBC84\uB97C \uC0AC\uAE30 \uC704\uD574\\n\uC628 \uC0C1\uC810\uC744 \uB3CC\uC544\uB2E4\uB154\uB294\uB370\\r\\n\uC54C\uACE0 \uBCF4\uB2C8, \uCE74\uB77C\uD504\uC2DC\uD2F0\uC5D0\uC11C\uB9CC \uD30C\uB294 \uAC83\uC774\uB354\uAD70.[VAR 0114(0029)]",
  "\uADF8\uB798\uB3C4, \uC88B\uC740 \uBB3C\uAC74\uC744 \uC190\uC5D0 \uB123\uC5B4\uC11C\\n\uC544\uC8FC \uB9CC\uC871\uD558\uACE0 \uC788\uB2E4.[VAR 0114(0029)]",
  "[VAR 0100(0000)], \uC790\uB124 \uADF8\uAC70 \uC544\uB098?[VAR 0114(0029)]",
  "\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC5D0 \uB9C8\uBE4C\uD06C\uB77C\uB294\\n\uD06C\uB9BC\uD3EC\uCF13\uBAAC\uC774 \uC788\uB354\uAD70.[VAR 0114(0029)]",
  "\uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uBAA8\uC2B5\uC744 \uD558\uACE0 \uC788\uB294 \uAC74 \uBB3C\uB860\uC774\uACE0\\n\uBAB8\uC5D0\uC11C \uB098\uC624\uB294 \uB2EC\uCF64~\uD55C \uD5A5\uAE30\uAC00\\r\\n\uC774\uB8E8 \uB9D0\uD560 \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uB9E4\uB825\uC801\uC774\uC5C8\uC9C0...[VAR 0114(0029)]",
  "\uC790\uB124\uB294 \uB9C8\uBE4C\uD06C\uC758\\n\uB3C5\uD2B9\uD55C \uC9C4\uD654 \uBC29\uBC95\uC5D0 \uB300\uD574 \uC54C\uACE0 \uC788\uB098?[VAR 0114(0029)]",
  "\uBE59\uAE00\uBE59\uAE00 \uB3CC\uAE30",
  "\uADC0\uC5FD\uB2E4\uACE0 \uCE6D\uCC2C\uD558\uAE30",
  "\uB2EC\uCF64\uD55C \uAC83\uC744 \uBA39\uC774\uAE30",
  "\uD6CC\uB96D\uD55C \uB2F5\uBCC0\uC774\uAD70, [VAR 0100(0000)].\\n\uC774\uBBF8 \uC2DC\uB3C4\uD574 \uBCF8 \uAC74\uAC00?[VAR 0114(0029)]",
  "\u201C\uC633\uC9C0, \uC633\uC9C0! \uC544\uC774\uAD6C \uADC0\uC5EC\uC6CC\uB77C~\u201D\uD558\uACE0\\n\uCE6D\uCC2C\uD574 \uC8FC\uBA74 \uC11C\uB85C \uD750\uBB47\uD574\uC9C0\uAE34 \uD558\uACA0\uB2E4\uB9CC,\\r\\n\uADF8\uB7F0\uB2E4\uACE0 \uC9C4\uD654\uD558\uC9C0\uB294 \uC54A\uB294\uB2E4.[VAR 0114(0029)]",
  "\uC74C~! \uD568\uAED8 \uB545\uCF69\uBC84\uD130 \uC0CC\uB4DC\uC704\uCE58\uB97C \uBA39\uC73C\uBA74\\n\uB9DB\uC788\uC5B4\uC11C \uC9C4\uD654~!\\r\\n...\uAC19\uC740 \uC77C\uC740 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uB294\uB2E4![VAR 0114(0029)]",
  "\uB9C8\uBE4C\uD06C\uB97C \uB9C8\uD718\uD551\uC73C\uB85C \uC9C4\uD654\uC2DC\uD0AC \uAC70\uB77C\uBA74\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC5D0 \uB123\uACE0\\r\\n\uBE59\uAE00\uBE59\uAE00 \uB3CC\uC544 \uBCF4\uB294 \uAC70\uB2E4![VAR 0114(0029)]",
  "\uADF8\uB9AC\uD558\uBA74 \uD06C\uB9BC\uC774 \uC11E\uC774\uBA74\uC11C\\n\uD3ED\uC2E0\uD3ED\uC2E0\uD55C \uB9C8\uD718\uD551\uC774 \uB420 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uB3CC\uAE30 \uC804\uC5D0 \uB9C8\uBE4C\uD06C\uC5D0\uAC8C\\n\uC0AC\uD0D5\uACF5\uC608\uB97C \uC9C0\uB2C8\uAC8C \uD558\uB294 \uAC83\uB3C4 \uC78A\uC9C0 \uB9D0\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uC9C0\uB2C8\uAC8C \uD55C \uC0AC\uD0D5\uACF5\uC608\uC640 \uD68C\uC804 \uBC29\uC2DD\uC5D0 \uB530\uB77C\\n\uB9C8\uD718\uD551\uC758 \uBAA8\uC2B5\uC774 \uB2EC\uB77C\uC9C4\uB2E4\uB294 \uAC83\uB3C4 \uCC38\uACE0\uD574\uB77C.[VAR 0114(0029)]",
  "\uB0B4 \uB9C8\uD718\uD551\uB3C4 \uD604\uC7AC \uBAA8\uC2B5\uC774 \uB418\uB3C4\uB85D\\n\uD68C\uC804\uC744 \uC870\uC815\uD588\uC9C0.[VAR 0114(0029)]",
  "\uC790\uB124\uAC00 \uB098\uB97C \uC774 \uC544\uCE74\uB370\uBBF8\uC5D0 \uCD08\uB300\uD574 \uC900 \uB355\uBD84\uC5D0\\n\uB9C8\uD718\uD551\uACFC \uB9CC\uB0A0 \uC218 \uC788\uC5C8\uB2E4.[VAR 0114(0029)]",
  "\uAC01\uC9C0\uB97C \uC5EC\uD589\uD55C \uC790\uB124\uB77C\uBA74\\n\uBA4B\uC9C4 \uB9CC\uB0A8\uC744 \uB9CE\uC774 \uAC00\uC84C\uACA0\uC9C0?[VAR 0114(0029)]",
  "\uB098\uC640 \uD3EC\uCF13\uBAAC \uAD50\uD658\uC744 \uD1B5\uD574\\n\uADF8 \uADA4\uC801\uC744 \uBCF4\uC5EC \uC8FC\uC9C0 \uC54A\uACA0\uB098?[VAR 0114(0029)]",
  "\uB098\uB294 \uC190\uC9C0\uBE0C\uB9BC\uC744 \uC8FC\uB9C8.\\n\uC790\uB124\uB294 \uC5B4\uB5BB\uAC8C \uD560 \uAC70\uC9C0?[VAR 0114(0029)]",
  "\uC790\uB124\uAC00 \uACAA\uC740 \uBAA8\uD5D8\uC758 \uACB0\uC2E4\uC744\\n\uC870\uAE08 \uB098\uB220 \uBC1B\uC740 \uAE30\uBD84\uC774 \uB4DC\uB294\uAD70.\\c\\n[VAR 0100(0000)], \uAD50\uD658\uD574 \uC918\uC11C \uACE0\uB9D9\uB2E4.[VAR 0114(0029)]",
  "\uC790\uB124\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uB0B4 \uC190\uC9C0\uBE0C\uB9BC\uC744 \uAD50\uD658\uD560 \uAC74\uAC00?[VAR 0114(0029)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "...\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uC744 \uD560 \uC218 \uC5C6\uB124.\\c\\n2\uB9C8\uB9AC \uC774\uC0C1\uC744 \uB370\uB824\uC628 \uB4A4\uC5D0\\n\uB2E4\uC2DC \uD558\uC9C0 \uC54A\uACA0\uB098?[VAR 0114(0029)]",
  "\uB098\uC911\uC5D0 \uB9C8\uC74C\uC774 \uBC14\uB00C\uAC70\uB4E0\\n\uAD50\uD658\uC744 \uBD80\uD0C1\uD558\uC9C0.[VAR 0114(0029)]",
  "\uB098\uC640 \uD3EC\uCF13\uBAAC \uAD50\uD658\uC744 \uD560 \uAC74\uAC00?[VAR 0114(0029)]",
  "\uC6B0\uB9AC \uCC54\uD53C\uC5B8\uAED8\uC11C\\n\uC2B9\uBD80\uB97C \uC6D0\uD558\uB294 \uAC74\uAC00?[VAR 0114(0029)]",
  "\uC900\uBE44\uB294 \uB418\uC5B4 \uC788\uC73C\uB2C8\\n\uC5B8\uC81C\uB4E0 \uB9D0\uD558\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uAE30\uAEBC\uC774 \uC0C1\uB300\uD574 \uC8FC\uC9C0.\\n\uB098\uC758 \uC2E4\uB825\uC744 \uBCF4\uC5EC \uC8FC\uB9C8![VAR 0114(0029)]",
  "[~ 66]",
  "\uB098\uB3C4 \uB098\uB984\uB300\uB85C\\n\uCDA9\uBD84\uD788 \uB2E8\uB828\uD588\uB2E4\uACE0 \uC0DD\uAC01\uD588\uAC74\uB9CC...[VAR 0114(0029)]",
  "\uACFC\uC5F0, \uCC54\uD53C\uC5B8.\\n\uC131\uC7A5\uD558\uB294 \uD3ED\uC758 \uCC28\uC6D0\uC774 \uB2E4\uB974\uAD70.[VAR 0114(0029)]",
  "\uC2B9\uBD80\uB97C \uD574\uC11C \uB9CE\uC774 \uC9C0\uCCE4\uC744 \uD14C\uB2C8\\n\uC774\uAC83\uC744 \uC8FC\uB9C8.[VAR 0114(0029)]",
  "\uC0C8\uCF64\uD55C \uAC83\uC744 \uBA39\uC73C\uBA74\\n\uD53C\uB85C\uAC00 \uD68C\uBCF5\uB420 \uAC70\uB2E4.[VAR 0114(0029)]",
  "[~ 66]",
  "\uBA87 \uBC88\uC744 \uD574\uB3C4\\n\uC790\uB124\uC640\uC758 \uC2B9\uBD80\uB294 \uB2EC\uCF64\uD558\uAD70.[VAR 0114(0029)]",
  "[VAR 0100(0000)], \uC0C1\uB300\uD574 \uC918\uC11C \uACE0\uB9D9\uB2E4.[VAR 0114(0029)]",
  "\uC790\uB124\uB2F5\uC9C0 \uC54A\uAD70.\\n\uC9D1\uC911\uB825\uC774 \uD750\uD2B8\uB7EC\uC9C4 \uAC74\uAC00?\\c\\n\uCEE8\uB514\uC158 \uAD00\uB9AC\uB97C \uCCA0\uC800\uD788 \uD558\uACE0\\n\uD3EC\uCF13\uBAAC\uB4E4\uC744 \uACA9\uB824\uD574 \uC8FC\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uBC30\uD2C0 \uD6C4\uC5D0 \uBA39\uC77C \uC218 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC6A9 \uAC74\uAC15 \uC694\uB9AC \uC218\uC5C5\uC5D0 \uBC18\uC751\uC774 \uC88B\uB354\uAD70.\\r\\n\uB098\uC911\uC5D0 \uC790\uB124\uB3C4 \uB4E4\uC5B4 \uBCF4\uC9C0 \uC54A\uACA0\uB098?[VAR 0114(0029)]",
  "\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC5D0\uB3C4 \uBE44\uB294 \uB0B4\uB9AC\uB294\uAD70.\\c\\n\uD53C\uD06C\uB2C9 \uC911\uC5D0 \uAC11\uC790\uAE30 \uBE44\uB97C \uB9DE\uAC8C \uB418\uB294 \uC77C\uC740\\n\uB3D4 \uC548\uC5D0\uC11C\uB3C4 \uD53C\uD560 \uC218 \uC5C6\uACA0\uC5B4.[VAR 0114(0029)]",
  "\uC774\uACF3 \uC2DD\uB2F9\uC5D0\uC11C \uC8FC\uBB38\uD560 \uC218 \uC788\uB294\\n\uC544\uCE74\uB370\uBBF8 \uC250\uC774\uD06C\uB294 \uB9C8\uC154 \uBD24\uB098?\\c\\n\uD600\uAC00 \uB9C8\uBE44\uB420 \uC815\uB3C4\uB85C \uB2EC\uB2EC\uD574\uC11C\\n\uB9C8\uC2E4\uC218\uB85D \uC6C3\uC74C\uC774 \uC808\uB85C \uB098\uC624\uB354\uAD70.[VAR 0114(0029)]",
  "[VAR 0100(0000)]\uC758 [VAR 0101(0001)][VAR 1900(0001)]\\n\uBAB8\uC5D0\uC11C \uC544\uC8FC \uC724\uAE30\uAC00 \uB098\uB354\uAD70.\\c\\n\uADE0\uD615 \uC7A1\uD78C \uC2DD\uC0AC\uB97C \uC8FC\uB294 \uB370\\n\uC2E0\uACBD\uC744 \uB9CE\uC774 \uC37C\uB098 \uBCF4\uC9C0?[VAR 0114(0029)]",
  "\uB0B4\uAC00 \uAD50\uD658\uD574 \uC900 \uC190\uC9C0\uBE0C\uB9BC\uC740\\n\uC798 \uC9C0\uB0B4\uACE0 \uC788\uB098?\\c\\n\uADF8 \uC544\uC774\uBCF4\uB2E4 \uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uC874\uC7AC\uB97C\\n\uBCF4\uAE30\uB294 \uD798\uB4E4 \uAC70\uB2E4.[VAR 0114(0029)]"
]
