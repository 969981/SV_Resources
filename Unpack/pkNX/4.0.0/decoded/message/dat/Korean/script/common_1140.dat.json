  "[~ 34]",
  "\uC5EC\uAE30\uAC00...\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC758 \uCD5C\uC2EC\uBD80\uC778\uAC00!?[VAR 0114(0006)]",
  "\uB3C4\uCC29~!\\n\uBCF4\uBB3C\uC5D0 \uB300\uD55C \uC804\uC124\uC774 \uC9C4\uC9DC\uC778\uAC00 \uD655\uC778\uD574 \uBCFC\uAE4C!?[VAR 0114(0004)]",
  "\uADF8\uAC74 \uADF8\uB0E5 \uAD50\uACFC\uC11C\uC5D0 \uC4F0\uC5EC \uC788\uB358 \uAC70\uC796\uC544.[VAR 0114(0008)]",
  "\uB85C\uD1A0\uB85C\uD1A0\uB85C\uD1A0\uB85C\uD1A0...",
  "\uD5EC\uB85C~ \uC5B4\uB9B0 \uCE5C\uAD6C\uB4E4.\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC798 \uC654\uC5B4.[VAR 0114(000B)]",
  "\uD5EC\uB85C~ \uC5B4\uB9B0 \uCE5C\uAD6C\uB4E4.\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC798 \uC654\uC5B4.[VAR 0114(000E)]",
  "\uC9C0\uAE08 \uB108\uD76C \uB208\uC55E\uC5D0 \uC788\uB294\\n\uAC74\uBB3C\uC774 \uBC14\uB85C \uC81C\uB85C\uB7A9\uC774\uC57C.[VAR 0114(000B)]",
  "\uC9C0\uAE08 \uB108\uD76C \uB208\uC55E\uC5D0 \uC788\uB294\\n\uAC74\uBB3C\uC774 \uBC14\uB85C \uC81C\uB85C\uB7A9\uC774\uC57C.[VAR 0114(000E)]",
  "\uC5EC\uAE30\uC5D0 \uBC15\uC0AC\uB2D8\uC774 \uACC4\uC2E0 \uAC70\uC8E0!?[VAR 0114(0004)]",
  "\uACB0\uC815\uCCB4\uC5D0 \uB458\uB7EC\uC2F8\uC5EC \uC788\uC5B4...![VAR 0114(0008)]",
  "\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uB0B4\uBD80\uC758 \uACB0\uC815\uCCB4\uB294\\n\uC2E0\uBE44\uD55C \uC5D0\uB108\uC9C0\uB97C \uAC00\uC9C0\uACE0 \uC788\uC5B4\uC11C[VAR 0114(000B)]",
  "\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uB0B4\uBD80\uC758 \uACB0\uC815\uCCB4\uB294\\n\uC2E0\uBE44\uD55C \uC5D0\uB108\uC9C0\uB97C \uAC00\uC9C0\uACE0 \uC788\uC5B4\uC11C[VAR 0114(000E)]",
  "\uC0DD\uBB3C\uC758 \uB2A5\uB825\uC744 \uBCC0\uD654\uC2DC\uD0AC \uBFD0\uB9CC \uC544\uB2C8\uB77C\\n\uAE30\uACC4\uC758 \uAE30\uB2A5\uB3C4 \uD5A5\uC0C1\uC2DC\uD0A4\uB294 \uD6A8\uACFC\uAC00 \uC788\uC5B4.[VAR 0114(000B)]",
  "\uC0DD\uBB3C\uC758 \uB2A5\uB825\uC744 \uBCC0\uD654\uC2DC\uD0AC \uBFD0\uB9CC \uC544\uB2C8\uB77C\\n\uAE30\uACC4\uC758 \uAE30\uB2A5\uB3C4 \uD5A5\uC0C1\uC2DC\uD0A4\uB294 \uD6A8\uACFC\uAC00 \uC788\uC5B4.[VAR 0114(000E)]",
  "\uD3EC\uCF13\uBAAC\uC774\\n\uD14C\uB77C\uC2A4\uD0C8\uD558\uB294 \uAC83\uACFC \uAC19\uC740 \uC5D0\uB108\uC9C0\uC9C0.[VAR 0114(000B)]",
  "\uD3EC\uCF13\uBAAC\uC774\\n\uD14C\uB77C\uC2A4\uD0C8\uD558\uB294 \uAC83\uACFC \uAC19\uC740 \uC5D0\uB108\uC9C0\uC9C0.[VAR 0114(000E)]",
  "\uB2E4\uC2DC \uB9D0\uD574, \uC774 \uAC74\uBB3C \uC790\uCCB4\uAC00\\n\uD14C\uB77C\uC2A4\uD0C8\uD588\uB2E4\uB294 \uAC74\uAC00?[VAR 0114(0006)]",
  "...\uC870\uC6A9\uD788 \uC788\uC5B4 \uBD10, \uD398\uD37C.[VAR 0114(0008)]",
  "\uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uB294 \uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC758\\n\uACB0\uC815\uCCB4\uB85C \uB9CC\uB4E4\uC5B4\uC9C4 \uAC70\uB77C\uB294 \uB73B\uC774\uB124\uC694...?[VAR 0114(0008)]",
  "\uADF9\uD788 \uC77C\uBD80\uB9CC\uC774\\n\uC544\uB294 \uC0AC\uC2E4\uC774\uC9C0\uB9CC \uB9D0\uC774\uC9C0.[VAR 0114(000B)]",
  "\uADF9\uD788 \uC77C\uBD80\uB9CC\uC774\\n\uC544\uB294 \uC0AC\uC2E4\uC774\uC9C0\uB9CC \uB9D0\uC774\uC9C0.[VAR 0114(000E)]",
  "4\uAC1C\uC758 \uC7A0\uAE08\uC7A5\uCE58\uB97C \uD574\uC81C\uD588\uB2E4\uBA74\\n\uC81C\uB85C\uB7A9\uC758 \uAC8C\uC774\uD2B8\uB97C \uC5F4 \uC218 \uC788\uC744 \uAC70\uC57C.[VAR 0114(000B)]",
  "4\uAC1C\uC758 \uC7A0\uAE08\uC7A5\uCE58\uB97C \uD574\uC81C\uD588\uB2E4\uBA74\\n\uC81C\uB85C\uB7A9\uC758 \uAC8C\uC774\uD2B8\uB97C \uC5F4 \uC218 \uC788\uC744 \uAC70\uC57C.[VAR 0114(000E)]",
