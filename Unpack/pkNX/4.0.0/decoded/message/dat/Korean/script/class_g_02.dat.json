[
  "\uC81C\uAD70\uB4E4, \uC218\uC5C5\uC744 \uC2DC\uC791\uD558\uACA0\uB2E4.\\n\uC2A4\uB9C8\uD2B8\uD3F0\uC740 \uC9D1\uC5B4\uB123\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uC9C0\uB09C \uC218\uC5C5\uC5D0\uC11C\uB294 \uD53C\uD06C\uB2C9\uC5D0\uC11C \uC5BB\uC744 \uC218 \uC788\uB294\\n\uC694\uB9AC\uC758 \uD6A8\uACFC\uC5D0 \uB300\uD574 \uC124\uBA85\uD588\uC5C8\uC9C0?[VAR 0114(0029)]",
  "\uC2DD\uC0AC \uD30C\uC6CC\uB97C \uC5BB\uC744 \uC218 \uC788\uC744 \uBFD0\uB9CC \uC544\uB2C8\uB77C\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC \uC804\uC6D0\uC744 \uD68C\uBCF5\uC2DC\uD0AC \uC218 \uC788\uC5B4\uC11C\\r\\n\uB9E4\uC6B0 \uD3B8\uB9AC\uD55C \uCE58\uB8CC \uC218\uB2E8\uC774\uB77C \uD560 \uC218 \uC788\uC9C0.[VAR 0114(0029)]",
  "\uB2E8, \uB2F9\uC5F0\uD55C \uC774\uC57C\uAE30\uC9C0\uB9CC\\n\uC694\uB9AC\uB97C \uD560 \uC218 \uC5C6\uB294 \uBC30\uD2C0 \uC911\uC774\uB098\\r\\n\uAE09\uD558\uAC8C \uD68C\uBCF5\uC2DC\uCF1C\uC57C \uD560 \uB54C\uB294 \uC54C\uB9DE\uC9C0 \uC54A\uB2E4.[VAR 0114(0029)]",
  "\uADF8\uB7F4 \uB54C \uC0AC\uC6A9\uD558\uBA74 \uC88B\uC740 \uAC83\uC774\\n\uD504\uB80C\uB4E4\uB9AC\uC20D\uC774\uB098 \uB9E4\uC810\uC5D0\uC11C \uC0B4 \uC218 \uC788\uB294\\r\\n[VAR FF00(0006)]\uC0C1\uCC98\uC57D[VAR FF00(0000)] \uB4F1\uC758 \uD68C\uBCF5 \uB3C4\uAD6C\uB2E4.[VAR 0114(0029)]",
  "\uD68C\uBCF5 \uB3C4\uAD6C\uB294 \uC989\uC2DC \uD6A8\uB825\uC744 \uBC1C\uD718\uD574\uC11C\\n\uAC00\uBC29\uC744 \uC5F4 \uC218\uB9CC \uC788\uB2E4\uBA74 \uC5B8\uC81C\uB4E0 \uC4F8 \uC218 \uC788\uC9C0.\\r\\n\uBB3C\uB860, \uD55C \uBC88 \uC0AC\uC6A9\uD558\uBA74 \uC0AC\uB77C\uC9C0\uC9C0\uB9CC \uB9D0\uC774\uC57C.[VAR 0114(0029)]",
  "\uC0C1\uCC98\uC57D\uC758 \uD68C\uBCF5\uB7C9\uC740 20,\\n\uC88B\uC740\uC0C1\uCC98\uC57D\uC740 60,\\r\\n\uACE0\uAE09\uC0C1\uCC98\uC57D\uC740 120...[VAR 0114(0029)]",
  "\uBE44\uC300\uC218\uB85D \uD68C\uBCF5\uB7C9\uB3C4 \uB192\uC544\uC9C0\uB2C8\\n\uC9C0\uAC11 \uC0AC\uC815\uC744 \uACE0\uB824\uD574\uC11C \uAD6C\uBE44\uD574 \uB450\uB3C4\uB85D.[VAR 0114(0029)]",
  "...\uADF8\uB807\uC9C0\uB9CC, \uC5EC\uD589\uAE38\uC5D0\uB294\\n\uC5B8\uC81C\uB098 \uC608\uC0C1 \uBC16\uC758 \uC77C\uC774 \uC77C\uC5B4\uB098\uB294 \uBC95.[VAR 0114(0029)]",
  "\uD55C\uBC88 \uC0C1\uC0C1\uD574 \uBD10\uB77C...\\n\uD3EC\uCF13\uBAAC\uC774 \uB2E4\uCCE4\uB294\uB370 \uC0C1\uCC98\uC57D\uC740 \uC5C6\uACE0,\\r\\n\uC0CC\uB4DC\uC704\uCE58\uB97C \uB9CC\uB4E4 \uC2DD\uC7AC\uB8CC\uB3C4 \uB2E4 \uB5A8\uC5B4\uC9C4 \uB370\uB2E4\uAC00\\r\\n\uADFC\uCC98\uC5D0 \uD3EC\uCF13\uBAAC\uC13C\uD130\uB3C4 \uC548 \uBCF4\uC774\uB294 \uC0C1\uD669\uC744...[VAR 0114(0029)]",
  "[VAR 0100(0000)]\uC5D0\uAC8C \uBB3B\uB3C4\uB85D \uD558\uC9C0.\\n\uD68C\uBCF5\uD560 \uC218\uB2E8\uC774 \uC5C6\uB294 \uC704\uD5D8\uD55C \uC0C1\uD669\uC5D0\uC11C\\r\\n\uB108\uB77C\uBA74 \uC8FC\uC704\uC5D0\uC11C \uBB34\uC5C7\uC744 \uCC3E\uC744 \uAC70\uC9C0?[VAR 0114(0029)]",
  "\uBB3C\uAC00",
  "\uC120\uC0DD\uB2D8",
  "\uB5A8\uC5B4\uC838 \uC788\uB294 \uBB3C\uAC74",
  "\uC870\uAE08 \uC804\uC5D0\uB3C4 \uB9D0\uD588\uC9C0\uB9CC\\n\uBB3C\uAC00\uAC00 \uC788\uC5B4\uB3C4 \uC2DD\uC7AC\uB8CC\uAC00 \uC5C6\uC73C\uB2C8\\r\\n\uC694\uB9AC\uB294 \uB9CC\uB4E4 \uC218 \uC5C6\uB294 \uC0C1\uD669\uC774\uB2E4...[VAR 0114(0029)]",
  "...\uBB3C\uB860, \uADFC\uCC98\uC5D0 \uC788\uB2E4\uBA74\\n\uC120\uC0DD\uB2D8\uB4E4\uC774 \uB3C4\uC640\uC8FC\uACA0\uC9C0.\\c\\n\uADF8\uB807\uC9C0\uB9CC, \uC5B8\uC81C \uC5B4\uB514\uC11C\uB098 \uB3C4\uC6C0\uC744 \uC904 \uC5B4\uB978\uC774\\n\uC788\uC744 \uAC70\uB77C\uACE0\uB294 \uC0DD\uAC01\uD558\uC9C0 \uC54A\uB294 \uAC8C \uC88B\uC744 \uAC70\uB2E4...[VAR 0114(0029)]",
  "\uD6CC\uB96D\uD55C \uB2F5\uBCC0\uC774\uC5C8\uB2E4, [VAR 0100(0000)].\\n\uC0DD\uC874 \uC9C0\uC2DD\uC744 \uC798 \uAC16\uCD94\uACE0 \uC788\uAD70.[VAR 0114(0029)]",
  "\uC8FC\uC704\uC5D0 \uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uB294 \uAC83\uC774 \uC788\uB2E4\uBA74\\n\uB5A8\uC5B4\uC838 \uC788\uB294 \uBB3C\uAC74\uC774 \uC788\uB2E4\uB294 \uAC83\uC774\uB2E4!\\c\\n\uC624\uB7AD\uC5F4\uB9E4\uB098 \uC0C1\uCC98\uC57D \uB4F1,\\n\uD68C\uBCF5 \uB3C4\uAD6C\uB97C \uC8FC\uC6B8 \uC218\uB3C4 \uC788\uC9C0.[VAR 0114(0029)]",
  "\u201C[VAR FF00(0006)]\uB808\uCE20\uACE0 R \uBC84\uD2BC[VAR FF00(0000)]\u201D\uC73C\uB85C\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC8FC\uC6CC \uC624\uAC8C \uD560 \uC218\uB3C4 \uC788\uB2E4.[VAR 0114(0029)]",
  "\uB098\uBB34\uC5F4\uB9E4\uB294 \uC0C1\uC810\uC5D0\uC11C \uD30C\uB294 \uB3C4\uAD6C\uC640\uB294 \uB2E4\uB974\uAC8C\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC9C0\uB2C8\uAC8C \uD558\uBA74 \uBC30\uD2C0 \uC911\uC5D0\\r\\n\uD3EC\uCF13\uBAAC\uC774 \uC2A4\uC2A4\uB85C \uD310\uB2E8\uD574\uC11C \uBA39\uC744 \uB54C\uB3C4 \uC788\uC9C0.[VAR 0114(0029)]",
  "\uC0AC\uC6A9\uD560 \uD0C0\uC774\uBC0D\uC744 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uB9E1\uACA8 \uBCF4\uB294 \uAC83\uB3C4\\n\uAF64\uB098 \uD765\uBBF8\uB85C\uC6B4 \uACBD\uD5D8\uC774 \uB420 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uC544\uBB34\uD2BC, \uD68C\uBCF5\uD560 \uC218\uB2E8\uC774 \uC5BC\uB9C8 \uC5C6\uB2E4\uBA74\\n\uC8FC\uC704\uC5D0 \uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uB294 \uAC83\uC744 \uCC3E\uC544 \uBCF4\uB3C4\uB85D![VAR 0114(0029)]",
  "\uB098\uBB34\uC5F4\uB9E4\uC870\uCC28 \uC548 \uBCF4\uC77C \uB54C\uB294\\n\uB2E4\uB978 \uBC29\uBC95\uC73C\uB85C \uD68C\uBCF5\uD560 \uC218\uB3C4 \uC788\uC9C0\uB9CC...\\r\\n\uC885\uC18C\uB9AC\uAC00 \uC624\uB298\uC740 \uADF8\uB9CC\uD558\uB77C\uB294 \uAC83 \uAC19\uAD70.[VAR 0114(0029)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4.\\n\uC774\uB9CC \uC2E4\uB840\uD558\uC9C0.[VAR 0114(0029)]"
]
