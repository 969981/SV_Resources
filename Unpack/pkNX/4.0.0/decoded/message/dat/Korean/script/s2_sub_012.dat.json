  "\uC774\uAC70 \uAD49\uC7A5\uD55C\uB370!\\n\uC11C\uD074 \uBBF8\uC158\uC744 \uD074\uB9AC\uC5B4\uD588\uAD6C\uB098!",
  "\uC774\uAC70 \uAD49\uC7A5\uD55C\uB370!\\n\uC11C\uD074 \uBBF8\uC158\uC744 [VAR 0202(0001)]\uD68C\uB098 \uD074\uB9AC\uC5B4\uD588\uAD6C\uB098!",
  "\uC774\uAC70 \uAD49\uC7A5\uD55C\uB370!\\n\uBE14\uB8E8\uB808\uD06C \uBBF8\uC158\uC744 [VAR 0202(0001)]\uD68C\uB098 \uD074\uB9AC\uC5B4\uD588\uAD6C\uB098!",
  "\uC0C1\uC744 \uC8FC\uAE30\uC5D0\uB294...\\n\uC544\uC9C1 \uC880 \uC774\uB978 \uAC83 \uAC19\uAD6C\uB098.",
  "\uBE14\uB8E8\uB808\uD06C \uBBF8\uC158\uC744 \uC55E\uC73C\uB85C [VAR 0202(0002)]\uD68C\\n\uC11C\uD074 \uBBF8\uC158\uC744 \uC55E\uC73C\uB85C [VAR 0202(0003)]\uD68C \uD074\uB9AC\uC5B4\uD558\uBA74\\r\\n\uAC04\uC2DD\uC744 \uC8FC\uB3C4\uB85D \uD558\uB9C8.",
  "\uBE14\uB8E8\uB808\uD06C \uBBF8\uC158\uC740 \uC5F4\uC2EC\uD788 \uD574 \uC92C\uC73C\uB2C8\\n\uC11C\uD074 \uBBF8\uC158\uC744 \uC55E\uC73C\uB85C [VAR 0202(0003)]\uD68C \uD074\uB9AC\uC5B4\uD558\uBA74\\r\\n\uAC04\uC2DD\uC744 \uC8FC\uB3C4\uB85D \uD558\uB9C8.",
  "\uC11C\uD074 \uBBF8\uC158\uC740 \uC5F4\uC2EC\uD788 \uD574 \uC92C\uC73C\uB2C8\\n\uBE14\uB8E8\uB808\uD06C \uBBF8\uC158\uC744 \uC55E\uC73C\uB85C [VAR 0202(0002)]\uD68C \uD074\uB9AC\uC5B4\uD558\uBA74\\r\\n\uAC04\uC2DD\uC744 \uC8FC\uB3C4\uB85D \uD558\uB9C8.",
  "\uC11C\uD074 \uBBF8\uC158\uC740 \uC720\uB2C8\uC5B8 \uC11C\uD074\uB85C\\n\uCE5C\uAD6C\uC640 \uBE14\uB8E8\uB808\uD06C\uB97C \uC5F4\uC2EC\uD788 \uD558\uB2E4 \uBCF4\uBA74\\r\\n\uB3C4\uC804\uD560 \uC218 \uC788\uB2E4\uB294 \uBAA8\uC591\uC774\uB354\uAD6C\uB098.",
  "\uC544\uB2C8\uBA74 \uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD55C \uC774\uC57C\uAE30\uB97C\\n\uB2E4\uC2DC \uD55C\uBC88 \uB4E4\uB824\uC904\uAE4C?",
  "\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD55C \uC774\uC57C\uAE30\uB97C \uB4E4\uB824\uC904\uAE4C?\\n\uAC00\uC9C0\uACE0 \uC788\uB294 \uAC04\uC2DD\uC744 \uBCF4\uC5EC \uC8FC\uB834.",
  "\uADF8\uAC74 \uB0B4\uAC00 \uC900 \uAC04\uC2DD\uC774 \uC544\uB2CC\uB370...",
  "\uC774\uC57C\uAE30\uB97C \uB4E3\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uB2C8?\\n\uC0AC\uC591\uD560 \uAC83\uC740 \uC5C6\uB2E4\uB9CC.",
  "\uC5F4\uC2EC\uD788 \uB178\uB825\uD55C \uB108\uC5D0\uAC8C\\n\uD3EC\uCF13\uBAAC\uC758 \uAC04\uC2DD\uC744 \uC8FC\uB9C8.",
  "\uADF8\uAC74 [VAR 0109(0004)]!",
  "[VAR 0101(0005)][VAR 1900(0006)]\uB77C\uB294 \uD3EC\uCF13\uBAAC\uC740\\n\uB108\uBB34\uB098\uB3C4 \uD76C\uADC0\uD574\uC11C\\r\\n\uC880\uCC98\uB7FC \uB9CC\uB0A0 \uC218 \uC5C6\uB294 \uB140\uC11D\uC774\uB780\uB2E4.",
  "\uD504\uB9AC\uC838 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC758 \uC124\uC0B0\uC5D0\uC11C \uBA4B\uC9C4 \uC5F0\uBABB\uC744 \uBC1C\uACAC\uD574\uC11C\\n\uAC70\uAE30\uC11C \uD639\uD55C \uC218\uC601\uC744 \uD558\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uADF8\uB7AC\uB354\uB2C8 \uAE00\uC384, \uD3ED\uD3EC \uCABD\uC5D0\uC11C\\n\uD504\uB9AC\uC838\uAC00 \uC29D \uD558\uACE0 \uB0B4\uB824\uC624\uB354\uB2C8\\r\\n\uB178\uB798\uD558\uBA74\uC11C \uBA38\uB9AC \uC704\uB97C \uB0A0\uC544\uB2E4\uB2C8\uC9C0 \uBB50\uB0D0!",
  "\uB098\uB3C4 \uC2E0\uC774 \uB098\uC11C \uD504\uB9AC\uC838\uC640 \uAC19\uC774\\n\uB0A0\uC774 \uC800\uBB3C\uB3C4\uB85D \uB178\uB798\uB97C \uBD88\uB800\uB294\uB370\\r\\n\uC815\uC2E0\uC744 \uCC28\uB824 \uBCF4\uB2C8 \uC544\uCE68\uC774 \uB418\uC5B4 \uC788\uB354\uAD6C\uB098.",
  "\uC36C\uB354 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC758 \uB4F1\uB300\uC5D0 \uC62C\uB77C\uC11C\\n\uBA40\uB9AC \uBCF4\uC774\uB294 \uB9C8\uC744\uC744 \uAD6C\uACBD\uD558\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uADF8\uB7AC\uB354\uB2C8 \uAE00\uC384, \uAC11\uC790\uAE30 \uBE44\uAC00 \uB9C9 \uB0B4\uB9AC\uC9C0 \uBB50\uB0D0!\\n\uADF8\uB798 \uAC00\uC9C0\uACE0 \uC774\uAC70 \uC548 \uB418\uACA0\uB2E4 \uC2F6\uC5B4\uC11C\\r\\n\uB4F1\uB300\uB97C \uB0B4\uB824\uAC00\uB824\uACE0 \uD588\uC9C0.",
  "\uADFC\uB370 \uC774\uC81C\uB294 \uB610, \uBC88\uCA4D\uBC88\uCA4D \uBE5B\uB098\uB294 \uACF3\uC5D0\uC11C\\n\uC36C\uB354\uAC00 \uC5B4\uB9C8\uC5B4\uB9C8\uD55C \uAE30\uC138\uB85C \uB0A0\uC544\uC624\uC9C0 \uBB50\uB0D0!\\r\\n\uB0B4 \uC606\uC744 \uC21C\uC2DD\uAC04\uC5D0 \uC9C0\uB098\uAC14\uB2E8\uB2E4.",
  "\uD30C\uC774\uC5B4 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544 \uC11C\uCABD\uC5D0\uC11C\\n\uC554\uBCBD \uB4F1\uBC18\uC744 \uD558\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uD558\uD544 \uADF8\uB0A0\uC774 \uBAA8\uB798 \uD3ED\uD48D\uC774 \uB9C8~\uC545 \uBD80\uB294 \uB0A0\uC774\uB77C\\n\uC785\uC18D\uC774 \uBAA8\uB798 \uCC9C\uC9C0\uAC00 \uB3FC\uC11C \uC548 \uB418\uACA0\uB354\uB77C\uACE0.\\r\\n\uADF8\uB798\uC11C \uB4F1\uBC18\uC744 \uD3EC\uAE30\uD558\uB824\uACE0 \uD588\uC9C0.",
  "\uADF8\uB7AC\uB354\uB2C8 \uAE00\uC384, \uBAA8\uB798 \uC0AC\uC774\uB85C\uB3C4 \uBCF4\uC77C \uC815\uB3C4\uB85C\\n\uB208\uBD80\uC2DC\uAC8C \uBE5B\uB098\uB294 \uD30C\uC774\uC5B4\uAC00 \uB098\uD0C0\uB098\uC11C\\r\\n\uB098\uB97C \uC751\uC6D0\uD574 \uC8FC\uC9C0 \uBB50\uB0D0!\\r\\n\uB355\uBD84\uC5D0 \uB4F1\uBC18\uC744 \uB05D\uAE4C\uC9C0 \uB9C8\uCE60 \uC218 \uC788\uC5C8\uB2E8\uB2E4!",
  "\uB77C\uC774\uCF54 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uB77C\uC774\uCF54\uC640 \uD568\uAED8\\n\uB4F1\uC0B0\uC744 \uAC04 \uC801\uC774 \uC788\uC5C8\uAC70\uB4E0.",
  "\uADFC\uB370, \uB77C\uC774\uCF54 \uC774 \uB140\uC11D\uC774 \uC5B4\uCC0C\uB098 \uB0A0\uB798\uB358\uC9C0\\n\uB0B4 \uC55E\uC744 \uC800~\uB9CC\uCE58 \uC55E\uC11C\uAC00 \uBC84\uB9AC\uC9C0 \uBB50\uB0D0!\\c\\n\uADF8\uB798\uC11C \uB098\uB3C4 \u201C\uC694\uB188 \uBD10\uB77C?\u201D \uD558\uACE0\\n\uB77C\uC774\uCF54\uB97C \uD544\uC0AC\uC801\uC73C\uB85C \uCAD3\uC544\uAC14\uC9C0!",
  "\uADF8\uB798\uC11C \uACB0\uAD6D, \uBD81\uCABD \uB545\uC5D0 \uD3BC\uCCD0\uC9C4\\n\uC5B4\uB9C8\uC5B4\uB9C8\uD558\uAC8C \uC7A5\uB300\uD55C \uC0AC\uB9C9\uC758 \uACBD\uCE58\uB97C\\r\\n\uB77C\uC774\uCF54\uC640 \uD568\uAED8 \uBCFC \uC218\uAC00 \uC788\uC5C8\uB2E8\uB2E4!",
  "\uC564\uD14C\uC774 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC744 \uBAA8\uD5D8\uD558\uB2E4\\n\uC6B0\uC5F0\uD788 \uC564\uD14C\uC774\uB97C \uB9CC\uB09C \uC801\uC774 \uC788\uAC70\uB4E0.",
  "\uADFC\uB370 \uB9CC\uB09C \uACF3\uC774 \uAD11\uC0B0\uC774\uB77C \uB545\uC744 \uD30C\uB0B4\uC11C \uADF8\uB7F0\uC9C0\\n\uC5EC\uAE30\uC800\uAE30\uC5D0 \uAD6C\uBA4D\uC774 \uBEE5\uBEE5 \uB6AB\uB824 \uC788\uC5C8\uB294\uB370\\c\\n\uC564\uD14C\uC774\uAC00 \uADF8 \uCEE4\uB2E4\uB780 \uAD6C\uBA4D\uC5D0\uC11C\\n\uC29D~ \uD558\uACE0 \uB6F0\uC5B4\uC624\uB974\uC9C0 \uBB50\uB0D0!",
  "\uADF8\uB798\uC11C \uB098\uB3C4 \uC564\uD14C\uC774\uD55C\uD14C \uC9C8 \uC218 \uC5C6\uC9C0 \uD558\uACE0\\n\uC5F4\uC2EC\uD788 \uB530\uB77C\uB2E4\uB154\uB294\uB370, \uADF8\uB7EC\uB2E4 \uBCF4\uB2C8 \uACB0\uAD6D\uC5D4\\r\\n\uAC19\uC774 \uBC14\uB2E4\uB97C \uAD6C\uACBD\uD558\uAC8C \uB410\uB2E8\uB2E4.",
  "\uC2A4\uC774\uCFE4 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uC5B4\uB290 \uB0A0 \uD314\uB370\uC544\uC758 \uC720\uBA85\uD55C \uD638\uC218\uC5D0\uC11C\\n\uC2A4\uC774\uCFE4\uC744 \uBC1C\uACAC\uD55C \uC801\uC774 \uC788\uAC70\uB4E0.",
  "\uADF8\uB798 \uAC00\uC9C0\uACE0 \uB0B4\uAC00 \uC2A4\uC774\uCFE4\uD55C\uD14C\\n\uB204\uAC00 \uB354 \uBA3C\uC800 \uD5E4\uC5C4\uCCD0\uC11C \uD574\uC548\uAC00\uC5D0 \uB3C4\uCC29\uD558\uB098\\r\\n\uC2DC\uD569\uC744 \uD558\uC790\uACE0 \uD588\uC9C0.",
  "\uADF8\uB798\uC11C \uC900\uBE44, \uB545! \uD558\uACE0 \uD5E4\uC5C4\uCE58\uAE30 \uC2DC\uC791\uD558\uB294\uB370\\n\uC2A4\uC774\uCFE4 \uC694\uB188\uC740 \uBB3C \uC704\uB97C \uC7BD\uC2F8\uAC8C \uB2EC\uB9AC\uC9C0 \uBB50\uB0D0!\\r\\n\uB098\uC57C \uC778\uAC04\uC774\uB2C8\uAE4C \uBC30\uC601\uC73C\uB85C \uC5F4\uC2EC\uD788 \uD588\uC9C0!\\c\\n\uBA4B\uC9C4 \uC2B9\uBD80\uC600\uC9C0\uB9CC \uACB0\uAD6D\\n\uC544\uC2AC\uC544\uC2AC\uD558\uAC8C \uB0B4\uAC00 \uC84C\uB2E8\uB2E4.",
  "\uB8E8\uAE30\uC544 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uC544\uB984\uB2E4\uC6B4 \uD314\uB370\uC544\uC758 \uBC14\uB2E4\uB97C\\n\uBC30\uC601\uC73C\uB85C \uC774\uB3D9\uD558\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uADFC\uB370 \uC774 \uBC14\uB2E4\uAC00 \uC5B4\uCC0C\uB098 \uCC28\uAC11\uB358\uC9C0\\n\uC870\uAE08\uB9CC \uD5E4\uC5C4\uCCD0\uB3C4 \uAE08\uBC29 \uCD94\uC6CC\uC9C0\uC9C0 \uBB50\uB0D0!\\c\\n\uADF8\uB798\uC11C \uB35C\uB35C \uB5A8\uBA74\uC11C \uAC00\uAE4C\uC6B4 \uC12C\uC5D0 \uC0C1\uB959\uD588\uC9C0.",
  "\uADF8\uB7AC\uB354\uB2C8 \uAE00\uC384, \uADFC\uCC98\uC5D0\uC11C \uC18C\uC6A9\uB3CC\uC774\uAC00 \uC77C\uB354\uB2C8\\n\uBC14\uB2F7\uC18D\uC5D0\uC11C \uB8E8\uAE30\uC544\uAC00 \uBD88\uC465 \uB098\uD0C0\uB098\uC9C0 \uBB50\uB0D0!\\c\\n\uC5B4\uCC0C\uB098 \uAE5C\uC9DD \uB180\uB790\uB294\uC9C0\\n\uB108\uBB34\uB098\uB3C4 \uAE30\uBED0\uC11C \uCD94\uC6B4 \uC904\uB3C4 \uBAB0\uB790\uB2E8\uB2E4!",
  "\uCE60\uC0C9\uC870 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uADF8\uB54C\uB294 \uB0B4\uAC00 \uC544\uC9C1\\n\uC2E0\uCD9C\uB0B4\uAE30 \uD2B8\uB808\uC774\uB108\uC600\uB294\uB370.",
  "\uD314\uB370\uC544\uC9C0\uBC29 \uB0A8\uC11C\uCABD\uC5D0 \uC788\uB294 \uD3ED\uD3EC \uADFC\uCC98\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC\uC744 \uAC15\uD558\uAC8C \uB9CC\uB4E4\uAE30 \uC704\uD574\\r\\n\uBC24\uC0C8\uB3C4\uB85D \uD6C8\uB828\uC744 \uD558\uACE0 \uC788\uC5C8\uB2E8\uB2E4!",
  "\uADFC\uB370 \uADF8\uB54C! \uBC88\uCA4D\uBC88\uCA4D \uBE5B\uC744 \uB0B4\uBA74\uC11C\\n\uD558\uB298 \uC704\uC5D0 \uCE60\uC0C9\uC870\uAC00 \uB098\uD0C0\uB098\uC9C0 \uBB50\uB0D0!\\c\\n\uADF8\uAC78 \uBCF8 \uB098\uB294 \uCE60\uC0C9\uC870\uAC00\\n\uB098\uB97C \uC751\uC6D0\uD558\uB7EC \uC640 \uC92C\uAD6C\uB098~ \uD588\uB2E8\uB2E4!",
  "\uB77C\uD2F0\uC544\uC2A4 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC758 \uB0A8\uCABD \uBC14\uB2E4\uC5D0\uC11C\\n\uBC30\uC601\uC744 \uD558\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uADFC\uB370 \uC774\uAC8C, \uD55C\uBC14\uD0D5 \uD5E4\uC5C4\uC744 \uCE58\uACE0 \uB098\uB2C8\\n\uC870\uAE08 \uC9C0\uCE58\uAE30 \uC2DC\uC791\uD574\uC11C, \uBB4D\uC73C\uB85C \uC62C\uB77C\uAC00\\r\\n\uBC14\uC704 \uADF8\uB298\uC5D0\uC11C \uC7A0\uAE50 \uC26C\uACE0 \uC788\uC5C8\uC9C0.",
  "\uADF8\uB7AC\uB354\uB2C8 \uB9C8\uCE68 \uB208\uC55E\uC5D0 \uB531!\\n\uB77C\uD2F0\uC544\uC2A4\uAC00 \uC788\uC9C0 \uBB50\uB0D0!\\c\\n\uB208\uC744 \uB9C8\uC8FC\uCE58\uB2C8\uAE4C \uBC29\uAE0B \uC6C3\uB354\uB2C8\\n\uC5B4\uB518\uAC00\uB85C \uB0A0\uC544\uAC00 \uBC84\uB838\uB2E8\uB2E4.",
  "\uB77C\uD2F0\uC624\uC2A4 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC758 \uBD81\uB3D9\uCABD\uC5D0\uC11C\\n\uC6B0\uC5F0\uD788 \uB9C8\uC8FC\uCE5C \uC801\uC774 \uC788\uAC70\uB4E0.",
  "\uB9D0\uC740 \uD1B5\uD558\uC9C0 \uC54A\uC9C0\uB9CC\\n\uC790\uAE30\uB97C \uB530\uB77C\uC624\uB77C\uB294 \uAC83 \uAC19\uAE38\uB798\\c\\n\uB0A0\uC544\uAC00\uB294 \uB77C\uD2F0\uC624\uC2A4\uB97C \uB530\uB77C\\n\uBFB0\uC871\uBFB0\uC871\uD55C \uC554\uC11D \uC9C0\uB300\uB97C \uC62C\uB77C\uAC14\uC9C0.",
  "\uADF8\uB7F0\uB370 \uC774\uAC8C, \uC815\uC2E0\uC744 \uCC28\uB824 \uBCF4\uB2C8 \uC5B4\uB290\uC0C8\\n\uC808\uBCBD\uC5D0 \uB458\uB7EC\uC2F8\uC778 \uC5F0\uBABB\uC5D0 \uC640 \uC788\uC9C0 \uBB50\uB0D0!\\r\\n\uC790\uC2E0\uC758 \uBE44\uBC00 \uC7A5\uC18C\uB97C \uAC00\uB974\uCCD0 \uC900 \uAC78 \uAC70\uC57C.",
  "\uAC00\uC774\uC624\uAC00 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC744 \uBAA8\uD5D8\uD558\uB294 \uC911\uC5D0\\n\uBC14\uB2E4\uC5D0\uC11C \uD2B9\uC774\uD55C \uBC14\uC704\uB97C \uBC1C\uACAC\uD588\uAC70\uB4E0.",
  "\uC774\uC57C~ \uC774\uAC70\\n\uADF8 \uC601\uD5D8\uD558\uAE30\uB85C \uC18C\uBB38\uB09C \uBC14\uC704\uC796\uC544!\\r\\n...\uC774\uB807\uAC8C \uC0DD\uAC01\uC774 \uB4E4\uC5B4\uC11C\\c\\n\uADF8\uB807\uB2E4\uBA74 \uD558\uACE0 \uB208\uC744 \uAC10\uACE0\uB294\\n\uAC00\uB9CC\uD788 \uC18C\uC6D0\uC744 \uBE4C\uC5B4 \uBD24\uC9C0.",
  "\uADF8\uB9AC\uACE0 \uC870\uAE08 \uC788\uB2E4\uAC00 \uB208\uC744 \uB5B4\uB354\uB2C8\\n\uC138\uC0C1\uC5D0 \uAE00\uC384! \uBC14\uC704 \uC55E\uC5D0\\c\\n\uAC00\uC774\uC624\uAC00\uAC00 \uC9E0~\uD558\uACE0 \uB098\uD0C0\uB0AC\uC9C0 \uBB50\uB0D0!\\n\uC544\uC8FC \uB180\uB77C\uC11C \uC790\uBE60\uC9C8 \uBED4\uD588\uB2E8\uB2E4!",
  "\uADF8\uB780\uB3C8 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC744 \uBAA8\uD5D8\uD558\uB294 \uC911\uC5D0\\n\uADF8\uB780\uB3C8\uC744 \uB9C8\uC8FC\uCE5C \uC801\uC774 \uC788\uAC70\uB4E0.",
  "\uB9C8\uC744 \uC544\uB798\uC5D0 \uCEE4\uB2E4\uB780 \uB3D9\uAD74\uC774 \uC788\uB294 \uACF3 \uC788\uC9C0?\\n\uB9C8\uC744 \uC774\uB984\uC774 \uBB50\uB354\uB77C...\\c\\n\uC544\uBB34\uD2BC \uAC70\uAE30\uC5D0\uC11C \uB9C8\uC8FC\uCCE4\uB2E8\uB2E4.",
  "\uADF8\uB798\uC11C \uB098\uB294 \u201C\uC548\uB155! \uADF8\uB780\uB3C8!\u201D \uD558\uACE0\\n\uD06C\uAC8C \uC778\uC0AC\uB97C \uAC74\uB138\uC9C0!\\r\\n\uB300\uB959\uD3EC\uCF13\uBAAC\uC774\uB2C8\uAE4C \uAC70\uAE30\uC5D0 \uAE09\uC744 \uB9DE\uCD98 \uAC70\uC57C.\\r\\n\uADF8\uB7AC\uB354\uB2C8 \uCEE4\uB2E4\uB780 \uC190\uD1B1\uC744 \uBCF4\uC5EC \uC8FC\uB354\uAD6C\uB098.",
  "\uB808\uCFE0\uC7C8 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC5D0\uC11C \uC5C4\uCCAD\uB098\uAC8C \uAC00\uD30C\uB978 \uC808\uBCBD\uC744\\n\uC529\uC529\uD558\uAC8C \uB4F1\uBC18\uD558\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uB05D\uAE4C\uC9C0 \uC62C\uB77C\uAC00\uC11C \uC804\uB9DD\uC744 \uBCF4\uB2C8\\n\uADF8\uAC8C \uB610 \uC5B4\uB9C8\uC5B4\uB9C8\uD55C \uC808\uACBD\uC774\uB354\uAD6C\uB098!\\c\\n\uC544\uB798\uB97C \uB0B4\uB824\uB2E4\uBCF4\uBA74 \uB208\uC55E\uC774 \uC628\uD1B5\\n\uD558\uC580 \uAD6C\uB984\uC73C\uB85C \uAC00\uB4DD\uD55C\\r\\n\uC544\uC8FC \uC2E0\uBE44\uD55C \uC7A5\uC18C\uC600\uC9C0!",
  "\uC544\uBB34\uD2BC \uAE00\uC384 \uAC70\uAE30 \uC788\uC73C\uB2C8, \uAD6C\uB984\uC744 \uB6AB\uACE0\\n\uB808\uCFE0\uC7C8\uAC00 \uC29D~ \uD558\uACE0 \uB0A0\uC544\uC624\uC9C0 \uBB50\uB0D0!\\r\\n\uBCF4\uACE0 \uC5B4\uCC0C\uB098 \uB180\uB790\uB294\uC9C0!",
  "\uCF54\uBC14\uB974\uC628 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uB97C \uBAA8\uD5D8\uD558\uB294\uB370\\n\uCF54\uBC14\uB974\uC628\uC774 \uC808\uBCBD\uC5D0\uC11C \uBD88\uC465 \uB0B4\uB824\uC624\uC9C0 \uBB50\uB0D0.",
  "\uB098\uB294 \uAE5C\uC9DD \uB180\uB77C\uC11C\\n\uC5B4\uC548\uC774 \uBC99\uBC99\uD574 \uC788\uC5C8\uB294\uB370\\c\\n\uB0B4 \uD45C\uC815\uC774 \uC6C3\uACBC\uB294\uC9C0\\n\uCF54\uBC14\uB974\uC628\uC774 \uCC9C\uCC9C\uD788 \uAC78\uC5B4\uC11C\uB294\\c\\n\uADFC\uCC98\uC5D0 \uC788\uB294 \uC720\uBA85\uD55C \uD3ED\uD3EC\uAE4C\uC9C0\\n\uC548\uB0B4\uD574 \uC8FC\uB354\uAD6C\uB098.",
  "\uADF8\uB798\uC11C \uACE0\uB9D9\uB2E4\uACE0 \uC778\uC0AC\uB97C \uD558\uB2C8\\n\uB300\uB098\uBB34 \uC232\uC744 \uAC00\uB85C\uC9C8\uB7EC \uAC00 \uBC84\uB838\uB2E8\uB2E4.",
  "\uD14C\uB77C\uD0A4\uC628 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD3C9\uC18C\uCC98\uB7FC \uC554\uBCBD \uB4F1\uBC18\uC744 \uC990\uAE30\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uC81C\uBC95 \uB192\uC740 \uACF3\uAE4C\uC9C0 \uC62C\uB77C\uAC00\uC11C\\n\uB4A4\uB97C \uB3CC\uC544\uBCF4\uB2C8 \uC815\uD655\uD788 \uB0A8\uCABD \uBC29\uD5A5\uC5D0\\r\\n\uC138\uB974\uD074\uB9C8\uC744\uC774 \uC791\uAC8C \uBCF4\uC774\uB354\uAD6C\uB098.\\c\\n\uADF8\uB798\uC11C \uC7A0\uC2DC \uAD6C\uACBD\uD558\uACE0 \uC788\uC5C8\uB294\uB370 \uAE00\uC384\\n\uC5B4\uB290\uC0C8 \uB0B4 \uC606\uC5D0 \uD14C\uB77C\uD0A4\uC628\uC774 \uC549\uC544 \uC788\uC9C0 \uBB50\uB0D0!",
  "\uC5B4\uCA50\uC9C0 \uD55C\uAC00\uD574 \uBCF4\uC774\uAE38\uB798\\n\uAC19\uC774 \uAC04\uC2DD\uC744 \uBA39\uC5C8\uB2E8\uB2E4.",
  "\uBE44\uB9AC\uB514\uC628 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC744 \uBAA8\uD5D8\uD558\uACE0 \uC788\uC5C8\uB294\uB370\\n\uBE44\uB9AC\uB514\uC628\uC774 \uB098\uBB34 \uADF8\uB298\uC5D0\uC11C \uC26C\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uADF8 \uB098\uBB34\uC5D0 \uB9D0\uC774\uC9C0, \uBB50\uB77C\uACE0 \uD574\uC57C \uD558\uB098...\\n\uC774\uC0C1\uD55C \uBB34\uB2AC\uAC00 \uADF8\uB824\uC838 \uC788\uC5B4\uC11C \uB9D0\uC774\uB2E4.\\c\\n\uD55C\uB3D9\uC548 \uB098\uBB34\uC640 \uBE44\uB9AC\uB514\uC628\uC744\\n\uBC88\uAC08\uC544 \uBCF4\uBA74\uC11C \uB180\uACE0 \uC788\uC5C8\uB2E8\uB2E4.",
  "\uADF8\uB7AC\uB354\uB2C8 \uAE00\uC384, \uBE44\uB9AC\uB514\uC628\uB3C4 \uB0B4 \uCABD\uC744\\n\uC2E0\uAE30\uD558\uB2E4\uB294 \uB4EF\uC774 \uCCD0\uB2E4\uBCF4\uC9C0 \uBB50\uB0D0!\\c\\n\uADF8\uB798\uC11C \uBAA8\uD5D8\uD55C \uC774\uC57C\uAE30\uB97C \uB4E4\uB824\uC92C\uB294\uB370\\n\uC544\uC8FC \uD765\uBBF8\uC9C4\uC9C4\uD558\uAC8C \uB4E3\uB354\uAD6C\uB098.",
  "\uB808\uC2DC\uB77C\uBB34 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC758 \uC5B4\uB5A4 \uB9C8\uC744 \uADFC\uCC98\uC5D0\uC11C\\n\uB808\uC2DC\uB77C\uBB34\uB97C \uBCF8 \uC801\uC774 \uC788\uB2E8\uB2E4.",
  "\uC791\uC5C5\uC6D0\uB4E4\uC774 \uC794\uB729 \uC788\uB294 \uB9C8\uC744\uC774\uB77C\\c\\n\uADF8\uB4E4\uC774 \uC5F4\uC2EC\uD788 \uC77C\uD558\uB294 \uBAA8\uC2B5\uC744\\n\uC554\uC11D \uC9C0\uB300 \uC704\uC5D0\uC11C \uCB49 \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uC5C8\uC9C0.",
  "\uADF8\uB807\uAC8C \uB2E4\uB4E4 \uC5F4\uC2EC\uD788 \uC0AC\uB294\uAD6C\uB098~ \uD558\uACE0 \uC788\uB294\uB370\\n\uB4F1 \uB4A4\uC5D0\uC11C \uAE30\uCC99\uC774 \uB290\uAEF4\uC9C0\uAE38\uB798\\c\\n\uB3CC\uC544\uBCF4\uB2C8 \uB808\uC2DC\uB77C\uBB34\uAC00\\n\uBC14\uB85C \uB4A4\uC5D0 \uC11C \uC788\uC9C0 \uBB50\uB0D0!\\c\\n\uB808\uC2DC\uB77C\uBB34\uB3C4 \uC5F4\uC2EC\uD788 \uC77C\uD558\uB294\\n\uC791\uC5C5\uC6D0\uB4E4\uC774 \uB9C8\uC74C\uC5D0 \uB4E4\uC5C8\uB098 \uBCF4\uB354\uB77C\uACE0.",
  "\uC81C\uD06C\uB85C\uBB34 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD14C\uC774\uBE14\uC2DC\uD2F0\uC5D0\uC11C \uBCF4\uC6B8\uB9C8\uC744\uAE4C\uC9C0\\n\uAC78\uC5B4\uC11C \uAC00\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uADF8\uB7F0\uB370 \uAE00\uC384, \uB3D9\uCABD \uD558\uB298\uC5D0\uC11C \uCEE4\uB2E4\uB780\\n\uAC80\uC740 \uADF8\uB9BC\uC790\uAC00 \uC288\uC289! \uD558\uACE0 \uB0A0\uC544\uAC00\uC9C0 \uBB50\uB0D0!\\c\\n\uC774\uAC8C \uBB34\uC2A8 \uC77C\uC774\uB78C!? \uD558\uACE0\\n\uB192\uC740 \uACF3\uC5D0 \uC62C\uB77C\uAC00\uB2C8 \uC81C\uD06C\uB85C\uBB34\uAC00 \uC788\uB354\uAD6C\uB098!",
  "\uB108\uBB34 \uB180\uB77C \uAC00\uC9C0\uACE0 \uBA4D\uD558\uB2C8 \uCCD0\uB2E4\uBCF4\uACE0 \uC788\uC73C\uB2C8\\n\uC81C\uD06C\uB85C\uBB34\uAC00 \uB0B4 \uCABD\uC73C\uB85C \uB0B4\uB824\uC624\uB354\uAD6C\uB098.\\c\\n\uADF8\uB807\uAC8C \uC5BC\uB9C8\uAC04 \uC11C\uB85C\uB97C \uBE64\uD788 \uBD24\uB294\uB370\\n\uC81C\uD06C\uB85C\uBB34 \uACE0 \uB140\uC11D, \uCC38 \uBA4B\uC9C0\uAC8C \uC0DD\uACBC\uB354\uB77C\uACE0!",
  "\uD050\uB808\uBB34 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uC124\uC0B0\uC744 \uC624\uB974\uB294\uB370\\n\uC5C4\uCCAD\uB09C \uB208\uBCF4\uB77C\uAC00 \uD718\uBAB0\uC544\uCCD0 \uAC00\uC9C0\uACE0\\r\\n\uC57C, \uC774\uAC70 \uC548 \uB418\uACA0\uB2E4 \uD558\uACE0 \uB3D9\uAD74\uC5D0 \uB4E4\uC5B4\uAC14\uAC70\uB4E0.",
  "\uADFC\uB370 \uADF8 \uB3D9\uAD74\uC774 \uAE00\uC384, \uC5C4\uCCAD\uB098\uAC8C \uB113\uC5B4\uC11C\\n\uB9C8\uCE58 \uBBF8\uB85C \uAC19\uC9C0 \uBB50\uB0D0!\\c\\n\uADF8\uB798\uC11C \uC2E0\uB098\uAC8C \uC548\uC744 \uD0D0\uD5D8\uD558\uACE0 \uC788\uB294\uB370\\n\uAC11\uC790\uAE30 \uC5BC\uC74C\uC73C\uB85C \uB41C \uBCBD\uC774 \uC6C0\uC9C1\uC774\uB354\uAD6C\uB098!",
  "\uC5B4\uC774\uCFE0! \uD558\uACE0 \uB180\uB77C\uC11C\\n\uB208\uC744 \uB611\uBC14\uB85C \uB728\uACE0 \uC790\uC138\uD788 \uBCF4\uB2C8\\r\\n\uBCBD\uC774 \uC544\uB2C8\uB77C \uD050\uB808\uBB34\uC600\uC9C0 \uBB50\uB0D0! \uB180\uB784 \uB9CC\uD558\uC9C0!?",
  "\uC194\uAC00\uB808\uC624 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC758 \uD3EC\uCF13\uBAAC\uB9AC\uADF8\uB97C \uBCF4\uB7EC \uAC14\uAC70\uB4E0.",
  "\uBC16\uC5D0\uC11C \uAD6C\uACBD\uD558\uACE0 \uC788\uB294\uB370 \uC2A4\uD0DC\uD504\uAC00\\n\uB098\uB97C \uBCF4\uACE0\uB294 \uC548\uC73C\uB85C \uB4E4\uC5B4\uC624\uB77C\uACE0 \uD558\uB354\uB2C8\\c\\n\uB9AC\uADF8 \uB9C8\uD06C\uAC00 \uC0C8\uACA8\uC838 \uC788\uB294\\n\uC804\uB9DD \uD50C\uB85C\uC5B4\uAE4C\uC9C0 \uC548\uB0B4\uD574 \uC8FC\uC9C0 \uBB50\uB0D0!\\c\\n\uAC70\uAE30\uC11C \uC774\uC81C \uD559\uAD50 \uCABD\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB294\uB370\\n\uAC11\uC790\uAE30 \uCEE4\uB2E4\uB780 \uD0DC\uC591\uC774 \uC9C0\uB098\uAC00\uB354\uAD6C\uB098!",
  "\uD0DC\uC591\uC758 \uC815\uCCB4\uAC00 \uBC14\uB85C \uC194\uAC00\uB808\uC624\uC600\uB2E8\uB2E4!\\c\\n\uC21C\uC2DD\uAC04\uC5D0 \uB2EC\uB824\uAC00 \uBC84\uB824\uC11C\\n\uC778\uC0AC\uAE4C\uC9C0\uB294 \uBABB \uD588\uC9C0\uB9CC, \uC5B4\uCC0C\uB098 \uBA4B\uC9C0\uB358\uC9C0~",
  "\uB8E8\uB098\uC544\uB77C \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC758 \uD574\uBCC0\uC5D0\uC11C\\n\uC800\uB141\uB178\uC744\uC744 \uBCF4\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uADFC\uB370 \uC774\uAC8C, \uD0DC\uC591\uC744 \uAC00\uB9CC\uD788 \uBCF4\uACE0 \uC788\uC73C\uB2C8\\n\uB098 \uC790\uC2E0\uC774 \uC5BC\uB9C8\uB098 \uC791\uC740 \uC874\uC7AC\uC778\uAC00 \uC2F6\uB354\uB77C\uACE0.\\c\\n\uADF8\uB807\uAC8C \uAC10\uC0C1\uC5D0 \uC816\uC5B4 \uC788\uB294 \uC911\uC5D0\\c\\n\uC544\uC9C1 \uD0DC\uC591\uC774 \uC644\uC804\uD788 \uC800\uBB3C\uC9C0 \uC54A\uC558\uB294\uB370\\n\uCEE4\uB2E4\uB780 \uCD08\uC2B9\uB2EC\uC774 \uB208\uC55E\uC744\\r\\n\uD30C\uD30C\uBC15! \uD558\uACE0 \uC2A4\uCCD0 \uC9C0\uB098\uAC00\uC9C0 \uBB50\uB0D0!",
  "\uB108\uBB34 \uC21C\uC2DD\uAC04\uC5D0 \uC77C\uC5B4\uB09C \uC77C\uC774\uB77C\\n\uADF8\uB54C\uB294 \uBAB0\uB790\uC9C0\uB9CC\\c\\n\uADF8 \uC2E4\uB8E8\uC5E3\uC740 \uBD84\uBA85 \uB8E8\uB098\uC544\uB77C\uC600\uC744 \uAC70\uC57C.",
  "\uB124\uD06C\uB85C\uC988\uB9C8 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC758 \uD3ED\uD3EC\uC5D0\uC11C \uC218\uD589\uC744 \uD558\uB294\uB370\\n\uB124\uD06C\uB85C\uC988\uB9C8\uAC00 \uB192\uC740 \uACF3\uC5D0\uC11C\\r\\n\uAD49\uC7A5\uD55C \uB208\uBE5B\uC73C\uB85C \uB098\uB97C \uC9F8\uB824\uBCF4\uC9C0 \uBB50\uB0D0!",
  "\uADF8\uB798\uC11C, \uC774\uAC70 \uB9CC\uB9CC\uD788 \uBCF4\uC5EC\uC120 \uC548 \uB418\uACA0\uB2E4 \uD574\uC11C\\n\u201C\uC774\uB188!!\u201D \uD558\uACE0 \uD06C\uAC8C \uD638\uD1B5\uC744 \uCE58\uB2C8\\r\\n\uB124\uD06C\uB85C\uC988\uB9C8\uAC00 \uAE08\uC138 \uAF41\uBB34\uB2C8\uB97C \uBE7C\uB354\uAD6C\uB098!",
  "\uB0B4 \uC18C\uB9AC\uAC00 \uC5B4\uCC0C\uB098 \uCEF8\uB294\uC9C0\\n\uADFC\uCC98\uC5D0 \uC788\uB358 \uBC14\uB77C\uCCA0\uB85D\uB4E4\uB3C4 \uB180\uB77C\uC11C\\r\\n\uAC19\uC774 \uB2EC\uC544\uB098 \uBC84\uB838\uB2E8\uB2E4! \uD558\uD558\uD558\uD558\uD558!",
  "\uCE58\uACE0\uB9C8 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC744 \uBAA8\uD5D8\uD558\uB294 \uC911\uC5D0\\n\uC218\uD589\uD558\uB294 \uCE58\uACE0\uB9C8\uB97C \uBD24\uC9C0 \uBB50\uB0D0!\\c\\n\u201C\uC544\uC774\uACE0, \uC218\uD589 \uC911\uC774\uC2ED\uB2C8\uAE4C?\u201D \uD558\uACE0 \uB9D0\uC744 \uAC70\uB2C8\\n\uC774\uAC8C \uC0DD\uAC01\uBCF4\uB2E4 \uB9C8\uC74C\uC774 \uC798 \uB9DE\uB354\uAD6C\uB098!",
  "\uADF8\uB798\uC11C \uD55C\uB3D9\uC548 \uAC19\uC774 \uB2E8\uB828\uD558\uACE0 \uC788\uC5C8\uB294\uB370\\n\uAC11\uC790\uAE30 \uCE58\uACE0\uB9C8\uAC00 \uBAB8\uC744 \uCB48\uBF1B\uAC70\uB9AC\uB354\uB2C8\uB9CC",
  "\uADFC\uCC98\uC5D0 \uC790\uB77C\uB09C \uC8FD\uC21C\uC744 \uBF51\uC544\uC11C\\n\uB098\uD55C\uD14C \uC8FC\uC9C0 \uBB50\uB0D0!",
  "\uBE14\uB9AC\uC790\uD3EC\uC2A4 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC758 \uC124\uC0B0\uC5D0\uC11C\\n\uCDE8\uBBF8\uC778 \uB4F1\uC0B0\uC744 \uC990\uAE30\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uB208\uAE38\uC744 \uCB49 \uAC77\uB2E4\uAC00\\n\uC870\uAE08\uB9CC \uB354 \uAC00\uBA74 \uC815\uC0C1\uC774\uB824\uB098 \uC2F6\uB358 \uCC30\uB098\uC5D0\\r\\n\uBB34\uB108\uC9C4 \uC9D1\uC744 \uBC1C\uACAC\uD588\uB294\uB370\\c\\n\uBCBD\uC740 \uC544\uC9C1 \uD2BC\uD2BC\uD574 \uBCF4\uC774\uAE38\uB798\\n\uAC70\uAE30\uC11C \uC7A0\uAE50 \uC26C\uB824\uACE0 \uC2AC\uCA4D \uB4E4\uC5EC\uB2E4\uBD24\uB2E8\uB2E4.",
  "\uADF8\uB7AC\uB354\uB2C8 \uC774\uBBF8 \uC190\uB2D8\uC774 \uC788\uC9C0 \uBB50\uB0D0!\\n\uB208\uCC98\uB7FC \uC0C8\uD558\uC580 \uD3EC\uCF13\uBAAC...\\c\\n\uBE14\uB9AC\uC790\uD3EC\uC2A4\uAC00 \uC548\uC5D0\uC11C \uC7A0\uC744 \uC790\uACE0 \uC788\uC5C8\uB2E8\uB2E4!\\n\uADF8\uAC78 \uBCF4\uACE0 \uB0B4\uAC00 \uC5B4\uCC0C\uB098 \uB180\uB790\uB294\uC9C0!",
  "\uB808\uC774\uC2A4\uD3EC\uC2A4 \uD558\uB2C8\uAE4C \uC0DD\uAC01\uB098\uB294 \uAC74\uB370...\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0 \uB9D0\uC774\uB2E4.\\c\\n\uD314\uB370\uC544\uC9C0\uBC29\uC758 \uC0B0\uC5D0\uC11C\\n\uCDE8\uBBF8\uC778 \uB4F1\uC0B0\uC744 \uC990\uAE30\uACE0 \uC788\uC5C8\uAC70\uB4E0.",
  "\uCD08\uBAA9\uC774 \uC790\uB780 \uB4F1\uC0B0\uB85C\uB97C\\n\uCC9C\uCC9C\uD788 \uB69C\uBC85\uB69C\uBC85 \uAC77\uB2E4 \uBCF4\uB2C8\\c\\n\uB369\uAD74\uB85C \uB4A4\uB36E\uC778 \uD3D0\uD5C8\uAC00 \uC788\uAE38\uB798\\n\uAC70\uAE30\uC11C \uC7A0\uAE50 \uC26C\uB824\uACE0 \uC2AC\uCA4D \uB4E4\uC5EC\uB2E4\uBD24\uB2E8\uB2E4.",
  "\uADF8\uB7AC\uB354\uB2C8 \uAE00\uC384, \uD3D0\uD5C8 \uC548\uC5D0\uC11C\\n\uADF8\uB9BC\uC790\uCC98\uB7FC \uAC80\uC740 \uD3EC\uCF13\uBAAC...\\c\\n\uB808\uC774\uC2A4\uD3EC\uC2A4\uAC00 \uACE0\uAC1C\uB97C \uC464\uC6B1 \uB0B4\uBC00\uC9C0 \uBB50\uB0D0!\\n\uADF8\uAC78 \uBCF4\uACE0 \uB0B4\uAC00 \uC5B4\uCC0C\uB098 \uB180\uB790\uB294\uC9C0!",
  "\uAC04\uC2DD\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4 \uBCF4\uBA74\\n\uB108\uB3C4 \uC5B8\uC820\uAC00 \uB9CC\uB0A0 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C?",
  "[VAR 0101(0005)][VAR 1900(0002)] \uB9CC\uB098\uAC8C \uB418\uAC70\uB4E0\\n\uB098 \uB300\uC2E0 \uC548\uBD80 \uC804\uD574 \uC8FC\uAC70\uB77C~",
  "...\uC624\uC789?\\c\\n\uBC29\uAE08 \uAC78\uB85C \uB0B4\uAC00 \uAC00\uC9C0\uACE0 \uC788\uB358 \uAC04\uC2DD\uC740\\n\uC804\uBD80 \uB2E4 \uC900 \uBAA8\uC591\uC774\uAD6C\uB098!",
  "\uC774\uAC8C \uB2E4 [VAR 0100(0000)] \uB124\uAC00\\n\uC5F4\uC2EC\uD788 \uBE14\uB8E8\uB808\uD06C\uB97C \uD074\uB9AC\uC5B4\uD588\uB2E4\uB294 \uC99D\uAC70\uB780\uB2E4!",
  "\uC774\uC81C \uC904 \uC218 \uC788\uB294 \uAC04\uC2DD\uC740 \uB354 \uC5C6\uB2E4\uB9CC\\n\uAC00\uB054\uC529 \uC774\uC57C\uAE30\uB97C \uB4E4\uC73C\uB7EC \uC640 \uC8FC\uBA74 \uC88B\uACA0\uAD6C\uB098...",
  "[VAR 0100(0000)]!\\n\uB2E4\uC2DC \uB4E3\uACE0 \uC2F6\uC740 \uD3EC\uCF13\uBAAC \uC774\uC57C\uAE30\uAC00 \uC788\uB2C8?",
  "\uB098\uB294 \uD314\uB370\uC544\uC9C0\uBC29 \uC678\uC5D0\uB3C4\\n\uB9CE\uC740 \uC9C0\uBC29\uC744 \uC5EC\uD589\uD588\uB2E8\uB2E4.\\c\\n\uB2E4\uC591\uD55C \uC7A5\uC18C\uC5D0\uC11C\\n\uB2E4\uC591\uD55C \uAC83\uB4E4\uC744 \uBA39\uC5B4 \uBD24\uC9C0.",
  "\uB098\uB294 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB3C4\\n\uC81C\uBC95 \uD558\uB294 \uD3B8\uC774\uB780\uB2E4!\\c\\n\uACE0\uD5A5\uC5D0\uC11C\uB294 \uD30C\uD2B8\uB108\uC778 \uC544\uBCF4\uD06C\uC640 \uD568\uAED8\uB77C\uBA74\\n\uC838 \uBCF8 \uC801\uC774 \uC5C6\uC744 \uC815\uB3C4\uC600\uC9C0!",
  "[VAR 0100(0000)]!\\n\uC640 \uC918\uC11C \uAE30\uC058\uAD6C\uB098.\\c\\n\uB108\uBB34 \uAE30\uBED0\uC11C \uC774\uAC70\\n\uB178\uB798\uAC00 \uC808\uB85C \uB098\uC628\uB2E8 \uB9D0\uC774\uC9C0!\\r\\n\uB530~\uB77C\uB77C\uB77C\uB77C\uB77C \uB77C\uB77C~",
  "\uB0B4\uAC00 \uB9CC\uB4E0 \uAC04\uC2DD\uC740 \uBE44\uB85D\\n\uC7AC\uB8CC\uB294 \uD3C9\uBC94\uD558\uC9C0\uB9CC\\c\\n\uC774\uAC78 \uBA39\uC744 \uD3EC\uCF13\uBAAC\uC774\\n\uAE30\uBED0\uD558\uB294 \uBAA8\uC2B5\uC744 \uC0C1\uC0C1\uD558\uBA70 \uB9CC\uB4E4\uC5C8\uC73C\uB2C8\\r\\n\uBD84\uBA85 \uB2E4\uB4E4 \uB9DB\uC788\uC5B4\uD560 \uAC70\uB2E4!",
  "\uD3EC\uCF13\uBAAC\uC758 \uC5B8\uC5B4\uB294 \uBAA8\uB974\uC9C0\uB9CC\\n\uB208\uC744 \uBCF4\uBA74 \uBB34\uC2A8 \uC0DD\uAC01\uC744 \uD558\uB294\uC9C0\\r\\n\uC54C \uAC83\uB9CC \uAC19\uC740 \uAC8C \uCC38 \uC2E0\uAE30\uD558\uB2E8 \uB9D0\uC774\uC9C0.\\c\\n\uD558~\uD558\uD558\uD558\uD558\uD558!\\n[VAR 0100(0000)], \uB108\uB3C4 \uADF8\uB807\uC9C0?"
]
