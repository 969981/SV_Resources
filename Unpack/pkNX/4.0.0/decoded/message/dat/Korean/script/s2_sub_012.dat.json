  "\uAC00\uC9C0\uACE0 \uB2E4\uB2C8\uB2E4 \uBCF4\uBA74, \uC5B4\uB518\uAC00\uC5D0\uC11C\\n\uAD49\uC7A5\uD55C \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB0A0 \uC218 \uC788\uC744 \uAC70\uB2E4!",
  "\uADF8\uB7EC\uB2C8, \uBE14\uB8E8\uB808\uD06C\uB97C \uC5F4\uC2EC\uD788 \uD588\uB2E4 \uC2F6\uC73C\uBA74\\n\uB0B4\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uB834!",
