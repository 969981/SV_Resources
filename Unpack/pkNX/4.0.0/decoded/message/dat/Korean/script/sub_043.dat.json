[
  "[VAR 0100(0000)][VAR 1900(0001)]\\n[VAR FF00(0008)]\uB2E4\uC591\uD55C \uC2DD\uC7AC\uB8CC[VAR FF00(0000)]\uB97C \uC190\uC5D0 \uB123\uC5C8\uB2E4!",
  "[VAR 0100(0000)][VAR 1900(0001)] \uB2E4\uC591\uD55C \uC2DD\uC7AC\uB8CC\uB97C\\n[VAR FF00(0008)]\uD53C\uD06C\uB2C9[VAR FF00(0000)] \uD3EC\uCF13\uC5D0 \uB123\uC5C8\uB2E4.",
  "\uC544\uAE4C \uC2DD\uC7AC\uB8CC\uB97C \uB108\uBB34 \uB9CE\uC774 \uC0AC \uBC84\uB824\uC11C \uB9D0\uC774\uC57C.\\n\uB108\uD55C\uD14C\uB3C4 \uC870\uAE08 \uB098\uB220 \uC904\uAE4C?",
  "\uD53C\uD06C\uB2C9 \uD558\uBA74\\n\uC5ED\uC2DC \uC0CC\uB4DC\uC704\uCE58\uC9C0!\\r\\n\uB0B4\uAC00 \uC900 \uC2DD\uC7AC\uB8CC\uB85C \uB9CC\uB4E4\uC5B4 \uBCF4\uB834!",
  "\uADF8\uAC74 \uADF8\uB807\uACE0, \uB0B4\uAC00 \uC5F0 \uD53C\uD06C\uB2C9\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC\uC774\uB791 \uC26C\uB2E4 \uAC00\uC9C0 \uC54A\uC744\uB798?",
  "\uB0B4 \uD53C\uD06C\uB2C9\uC5D0 \uC798 \uC654\uC5B4.\\n\uD3EC\uCF13\uBAAC\uC774\uB791 \uC26C\uB2E4 \uAC00\uC9C0 \uC54A\uC744\uB798?",
  "\uB108\uB3C4 \uD3EC\uCF13\uBAAC\uB3C4\\n\uAE30\uC6B4\uC774 \uB118\uCE58\uB294\uAD6C\uB098!\\r\\n\uC5B8\uC81C\uB4E0\uC9C0 \uC26C\uB7EC \uC624\uB834!",
  "\uC9C0\uCCE4\uC744 \uB54C \uB108\uBB34 \uBB34\uB9AC\uD558\uBA74 \uC548 \uC88B\uC73C\uB2C8\uAE4C\\n\uC5B8\uC81C\uB4E0\uC9C0 \uC26C\uB7EC \uC624\uB834!",
  "\uAC00\uBC29\uC5D0 \uC2DD\uC7AC\uB8CC\uB97C \uB108\uBB34 \uB9CE\uC774 \uB123\uC5C8\uB098 \uBD10!\\n\uB108\uD55C\uD14C\uB3C4 \uB098\uB220 \uC904\uAC8C!",
  "\uBC16\uC5D0\uC11C \uBA39\uB294 \uC0CC\uB4DC\uC704\uCE58\uB294 \uCD5C\uACE0\uB77C\uAD6C!\\n\uB108\uB3C4 \uB0B4\uAC00 \uB098\uB220 \uC900 \uAC78\uB85C \uB9CC\uB4E4\uC5B4 \uBD10!",
  "\uAD1C\uCC2E\uB2E4\uBA74 \uB098\uB791 \uAC19\uC774 \uD53C\uD06C\uB2C9\uD558\uBA74\uC11C\\n\uC7A0\uAE50 \uC26C\uB294 \uAC74 \uC5B4\uB54C?",
  "\uB098\uB791 \uAC19\uC774 \uD53C\uD06C\uB2C9\uD558\uBA74\uC11C\\n\uC7A0\uAE50 \uC26C\uB294 \uAC74 \uC5B4\uB54C?",
  "\uB108\uB3C4 \uD3EC\uCF13\uBAAC\uB3C4\\n\uAE30\uC6B4\uC774 \uB118\uCE58\uB294 \uAC83 \uAC19\uB124!\\r\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB180\uB7EC \uC640!",
  "\uC0AC\uC591\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB418\uB294\uB370~\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB180\uB7EC \uC640!",
  "\uC5EC\uAE30\uB294 \uD14C\uC774\uBE14\uC2DC\uD2F0\uC640\\n\uBCF4\uC6B8\uB9C8\uC744\uC758 \uAC00\uC6B4\uB370 \uC9C0\uC810\uC774\uC57C!\\c\\n\uC0CC\uB4DC\uC704\uCE58\uB97C \uBA39\uACE0\\n\uB2E4\uC2DC \uD798\uB0B4\uC11C \uBAA8\uD5D8\uD574\uC57C\uC9C0~!\\c\\n...\uB108\uB3C4 \uD798\uB0B4\uB77C\uB294 \uB73B\uC73C\uB85C\\n\uC2DD\uC7AC\uB8CC\uB97C \uB098\uB220 \uC904\uAC8C!",
  "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8, \uC774 \uC8FC\uBCC0\uC5D0 \uC6C0\uC9C1\uC774\uB294 \uC554\uBCBD\uC774\\n\uC788\uB2E4\uACE0 \uB4E4\uC5C8\uB294\uB370, \uC9C4\uC9DC\uC77C\uAE4C?",
  "\uBCBD\uC774 \uC6C0\uC9C1\uC5EC\uB3C4 \uB180\uB77C\uC9C0 \uC54A\uAC8C\\n\uC7A0\uAE50 \uC26C\uB2E4 \uAC00\uC9C0 \uC54A\uC744\uB798?",
  "\uD798\uC774 \uC870\uAE08 \uB5A8\uC5B4\uC84C\uB2C8?\\n\uC7A0\uAE50 \uC26C\uB2E4 \uAC00\uC9C0 \uC54A\uC744\uB798?",
  "\uC0AC\uB78C\uC774\uB4E0 \uD3EC\uCF13\uBAAC\uC774\uB4E0\\n\uD798\uC744 \uB0B4\uB824\uBA74 \uD734\uC2DD\uB3C4 \uD544\uC694\uD574!\\r\\n\uD798\uB4E4\uBA74 \uC5B8\uC81C\uB4E0\uC9C0 \uC624\uB3C4\uB85D \uD574!",
  "\uADF8\uB807\uAD6C\uB098!\\n\uB108\uBB34 \uBB34\uB9AC\uD558\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574~!",
  "\uC5B8\uB355\uAE38\uC774 \uC0DD\uAC01\uBCF4\uB2E4\\n\uAC00\uD314\uB77C\uC11C \uC9C0\uCCE4\uC5B4...\\c\\n\uC774\uB7F4 \uB54C\uB294 \uC2DD\uC0AC\uD558\uBA74\uC11C\\n\uBAB8\uACFC \uB9C8\uC74C\uC744 \uB9AC\uD504\uB808\uC2DC\uD558\uB294 \uAC8C \uCD5C\uACE0\uC9C0!\\c\\n\uC2DD\uC7AC\uB8CC\uB97C \uB098\uB220 \uC904 \uD14C\uB2C8\uAE4C\\n\uB108\uB3C4 \uB9AC\uD504\uB808\uC2DC\uD558\uB3C4\uB85D \uD558\uB834!",
  "\uBC30\uAC00 \uACE0\uD504\uBA74\\n\uD798\uC744 \uB0B4\uC57C \uD560 \uB54C \uB0BC \uC218 \uC5C6\uC73C\uB2C8\uAE4C!",
  "\uC774\uB807\uAC8C \uB9CC\uB09C \uAC83\uB3C4 \uC778\uC5F0\uC778\uB370\\n\uACB8\uC0AC\uACB8\uC0AC \uB9AC\uD504\uB808\uC2DC\uD558\uACE0 \uAC08\uB798?",
  "\uB108\uB3C4 \uC5B8\uB355\uAE38\uC744 \uC624\uB974\uB290\uB77C \uC9C0\uCCE4\uB2C8?\\n\uC7A0\uAE50 \uB9AC\uD504\uB808\uC2DC\uD558\uACE0 \uAC08\uB798?",
  "\uB9DB\uC788\uB294 \uC2DD\uC0AC\uB85C \uB9AC\uD504\uB808\uC2DC!!\\n\uACE4\uB780\uD560 \uB54C\uB294 \uC11C\uB85C \uB3C4\uC640\uC57C\uC9C0!\\r\\n\uB610 \uD798\uB4E4\uC5B4\uC9C0\uBA74 \uC5B8\uC81C\uB4E0\uC9C0 \uB9D0\uC744 \uAC78\uC5B4 \uC918!",
  "\uC5ED\uC2DC \uC80A\uC740 \uC560\uB294 \uB2E4\uB974\uAD6C\uB098!\\n\uC544~ \uBD80\uB7EC\uC6CC\uB77C~!",
  "\uBA4B\uC9C4 \uACBD\uCE58\uB97C \uBCF4\uBA74\uC11C \uBA39\uB294 \uC0CC\uB4DC\uC704\uCE58\uB294\\n\uADF8 \uB9DB\uC774 \uC815\uB9D0 \uAC01\uBCC4\uD558\uB2E8\uB2E4!\\c\\n\uC6B0\uB9AC\uC758 \uB9CC\uB0A8\uC744 \uAE30\uB150\uD558\uB294 \uB73B\uC73C\uB85C \uC120\uBB3C\uC744 \uC8FC\uB9C8!\\n\uB108\uB3C4 \uC5EC\uD589\uC744 \uB9DB\uBCF4\uB3C4\uB85D \uD558\uB824\uBB34\uB098!!",
  "\uC0CC\uB4DC\uC704\uCE58\uB97C \uBA39\uC73C\uBA74\\n\uC2DD\uC0AC \uD30C\uC6CC\uAC00 \uB9C8\uAD6C \uC19F\uC544\uB098\uC11C\\r\\n\uC5EC\uD589\uC774 \uC990\uAC70\uC6CC\uC9C4\uB2E8\uB2E4!",
  "\uACB8\uC0AC\uACB8\uC0AC \uC5EC\uAE30\uC11C \uC7A0\uAE50\\n\uC26C\uB2E4 \uAC00\uC9C0 \uC54A\uC744\uB798?",
  "\uAC00\uB054\uC740 \uBC1C\uAC78\uC74C\uC744 \uBA48\uCD94\uACE0\\n\uACBD\uCE58\uB97C \uAD6C\uACBD\uD558\uBA70 \uC26C\uC5B4 \uBCF4\uB294 \uAC8C \uC5B4\uB5A0\uB0D0?",
  "\uC5F4\uC2EC\uD788 \uD558\uB294 \uAC83\uB3C4 \uC911\uC694\uD558\uC9C0\uB9CC\\n\uAC00\uB054\uC740 \uBC1C\uAC78\uC74C\uC744 \uBA48\uCDB0 \uBCF4\uB834!\\r\\n\uADF8\uB798\uC57C\uB9CC \uBCFC \uC218 \uC788\uB294 \uACBD\uCE58\uB3C4 \uC788\uB294 \uBC95\uC774\uB780\uB2E4!",
  "\uCE58\uC5F4\uD558\uAC8C \uC0AC\uB294 \uAC8C \uB098\uC05C \uAC74 \uC544\uB2C8\uC9C0!\\n\uD639\uC2DC \uBC1C\uAC78\uC74C\uC744 \uBA48\uCD94\uACE0 \uC2F6\uC5B4\uC9C0\uAC70\uB4E0\\r\\n\uC5B8\uC81C\uB4E0\uC9C0 \uC624\uB824\uBB34\uB098!",
  "\uB9C8\uB9AC\uB124\uC774\uB4DC \uC2DC\uC7A5\uC5D0\uC11C\\n\uC2DD\uC7AC\uB8CC\uB97C \uC2FC\uAC12\uC5D0 \uC0C0\uC5B4!!\\c\\n\uB2E4 \uBA39\uAE30\uC5D0\uB294 \uC880 \uB9CE\uC740 \uAC70 \uAC19\uC73C\uB2C8\uAE4C\\n\uB108\uD55C\uD14C\uB3C4 \uB098\uB220 \uC904\uAC8C!",
  "\uCE5C\uAD6C\uC640 \uC694\uB9AC\uD560 \uB54C\\n\uB2E4\uC591\uD55C \uC2DD\uC7AC\uB8CC\uB97C \uAC00\uC838\uAC00\uBA74\\c\\n\uD2B9\uC774\uD55C \uC0CC\uB4DC\uC704\uCE58\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC5B4\uC11C\\n\uC7AC\uBBF8\uC788\uC9C0 \uC54A\uB2C8?",
  "...\uADF8\uB807\uC9C0! \uC774 \uC8FC\uBCC0\uC740 \uAE38\uC774 \uD5D8\uD558\uB2C8\uAE4C\\n\uC7A0\uAE50 \uC26C\uB2E4 \uAC00\uB3C4\uB85D \uD558\uB834!",
  "\uC5EC\uAE30\uC11C\uBD80\uD130\uB294 \uBD81\uCABD\uC73C\uB85C \uAC00\uB4E0 \uB0A8\uCABD\uC73C\uB85C \uAC00\uB4E0\\n\uBAA8\uB450 \uD5D8\uD558\uB2C8\uAE4C, \uC7A0\uAE50 \uC26C\uB2E4 \uAC00\uB3C4\uB85D \uD558\uB834!",
  "\uD479 \uC26C\uC5C8\uC9C0?\\n\uADF8\uB7FC \uBAA8\uD5D8 \uC798 \uB2E4\uB140\uC624\uB834~!",
  "\uC11C\uCABD\uC5D0 \uC788\uB294 \uB9C8\uB9AC\uB124\uC774\uB4DC\uB9C8\uC744\uC5D0 \uAC00\uB294 \uAC70\uB2C8?\\n\uB0B4\uAC00 \uAD1C\uD55C \uCC38\uACAC\uC744 \uD588\uB098 \uBCF4\uAD6C\uB098~!",
  "\uC624\uC57C \uD638\uC218\uC5D0\uC11C \uD2B9\uC774\uD55C \uD3EC\uCF13\uBAAC\uC744 \uBCF4\uACE0\\n\uC601\uAC10\uC774 \uB5A0\uC62C\uB790\uC5B4!\\c\\n\uBD80\uB514 \uC774 \uD63C\uC2E0\uC744 \uB2F4\uC740 \uB808\uC2DC\uD53C\uB85C\\n\uC0CC\uB4DC\uC704\uCE58\uB97C \uB9CC\uB4E4\uC5B4 \uC918!",
  "[VAR 0100(0000)][VAR 1900(0001)] [VAR FF00(0006)]\uC2A4\uC2DC \uC2A4\uD0C0\uC77C \uC0CC\uB4DC\uC704\uCE58[VAR FF00(0000)]\uB97C\\n\uB9CC\uB4E4 \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4!",
  "\uC2A4\uC2DC\uB294 \uBCF4\uD1B5\\n\uBE75\uC774 \uC544\uB2C8\uB77C \uBC25\uC5D0 \uC5B9\uC5B4\uC11C \uBA39\uC796\uC544?\\c\\n...\uB2E4\uC2DC \uB9D0\uD574, \uC2A4\uC2DC\uB97C \uBE75\uC5D0 \uC5B9\uC73C\uBA74\\n\uB450 \uBC30\uB85C \uB9DB\uC788\uB2E4\uB294 \uAC70\uC9C0!",
  "\uD638\uC218\uC5D0\uC11C \uB9CC\uB09C \uAC83\uB3C4 \uC778\uC5F0\uC778\uB370\\n\uC7A0\uAE50 \uC26C\uB2E4 \uAC08\uB798?",
  "\uD638\uC22B\uAC00\uC5D0\uC11C \uD53C\uD06C\uB2C9\uC774\uB77C\uB2C8,\\n\uBA4B\uC9C0\uC9C0 \uC54A\uB2C8!? \uC7A0\uAE50 \uC26C\uB2E4 \uAC08\uB798?",
  "\uC5B4\uC9F8\uC11C \uD638\uC22B\uAC00\uC5D0 \uC788\uC73C\uBA74\\n\uC774\uB807\uAC8C \uAE30\uBD84\uC774 \uC88B\uC740 \uAC78\uAE4C?\\r\\n\uD638\uC218 \uB355\uBD84\uC5D0 \uC644\uC804\uD788 \uD790\uB9C1\uB41C \uAC83 \uAC19\uC9C0 \uC54A\uC544?",
  "\uD638\uC218\uB97C \uB290\uB07C\uACE0 \uC2F6\uC73C\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB9D0\uC744 \uAC78\uC5B4 \uC918!"
]
