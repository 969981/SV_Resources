[
  "\uC548\uB155, \uC598\uB4E4\uC544?\\n\uB2E4\uB4E4 \uC5B4\uC81C\uBCF4\uB2E4 \uD558\uB8E8 \uC624\uB798\uB418\uC5C8\uAD6C\uB098.[VAR 0114(0027)]",
  "\uC624\uB298\uB3C4 \uC5ED\uC0AC\uC758 \uD6CC\uB96D\uD568\uC5D0 \uB300\uD574\\n\uD568\uAED8 \uC54C\uC544 \uAC00 \uBCF4\uB3C4\uB85D \uD560\uAE4C?[VAR 0114(0027)]",
  "\uC804\uBC18\uAE30 \uC218\uC5C5\uC5D0\uC11C \uB2E4\uB918\uB358\\n\uD314\uB370\uC544\uC758 \uB300\uACF5\uACFC \uADF8 \uB0B4\uBD80...\\r\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0 \uB300\uD55C \uAC74 \uAE30\uC5B5\uD558\uACE0 \uC788\uC9C0?[VAR 0114(0027)]",
  "\uD669\uC81C\uC640 \uC218\uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC744\\n\uC5F4\uAD11\uD558\uAC8C \uD55C \uC2E0\uBE44\uC758 \uB300\uACF5...[VAR 0114(0027)]",
  "\uADF8\uACF3\uC758 \uCD5C\uC2EC\uBD80\uC5D0 \uB3C4\uB2EC\uD558\uB294 \uB370 \uC131\uACF5\uD55C \uAC83\uC740\\n\uC9C0\uAE08\uC73C\uB85C\uBD80\uD130 200\uB144 \uC804\uC774\uB77C\uACE0 \uD574.[VAR 0114(0027)]",
  "\uADF8\uB7F0 \uC5C4\uCCAD\uB09C \uC5C5\uC801\uC744 \uB2EC\uC131\uD55C \uAC83\uC740\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uAD00\uCE21\uB300\uB77C \uBD88\uB9AC\uB294 \uD300\uC774\uC5C8\uC5B4.[VAR 0114(0027)]",
  "\uAD00\uCE21\uB300\uC5D0\uB294\\n\uBC30\uD2C0 \uC2E4\uB825\uC774 \uC6B0\uC218\uD55C \uC790,\\r\\n\uC9C0\uC2DD\uC774 \uD48D\uBD80\uD55C \uC790 \uB4F1[VAR 0114(0027)]",
  "\uD314\uB370\uC544\uC758 \uC7AC\uB2A5 \uC788\uB294 \uC0AC\uB78C\uB4E4\uC774\\n\uC990\uBE44\uD588\uB2E4\uACE0 \uD574.[VAR 0114(0027)]",
  "\uADF8\uC911\uC5D0\uB294 \uC791\uAC00\uC774\uC790\\n\uBC15\uBB3C\uD559\uC5D0 \uC815\uD1B5\uD55C \uC778\uBB3C\uC778\\r\\n[VAR FF00(0006)]\uD5E4\uB354[VAR FF00(0000)]\uB77C\uB294 \uC0AC\uB0B4\uB3C4 \uC788\uC5C8\uC5B4.[VAR 0114(0027)]",
  "\uADF8\uB294 \uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0\uC11C \uADC0\uD658\uD55C \uB4A4\\n\uC790\uC2E0\uC758 \uAE00\uC7AC\uC8FC\uB97C \uC0B4\uB824\uC11C\\r\\n\uD0D0\uD5D8\uAE30\uB97C \uC9D1\uD544\uD574 \uC138\uC0C1\uC5D0 \uB0B4\uB193\uC558\uC9C0.[VAR 0114(0027)]",
  "...\uADF8\uB7FC \uC5EC\uAE30\uC11C \uB098\uC640 \uB208\uC774 \uB9C8\uC8FC\uCE5C\\n\uBD88\uC30D\uD55C [VAR 0100(0000)]\uC5D0\uAC8C \uC9C8\uBB38 \uD558\uB098 \uD560\uAE4C?[VAR 0114(0027)]",
  "\uC5EC\uD0DC\uAE4C\uC9C0 \uD55C \uB9D0\uC744 \uC798 \uB4E4\uC5C8\uB098 \uBCF4\uACA0\uC5B4.\\n\uB300\uACF5\uC758 \uB0B4\uBD80, \uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uCD5C\uC2EC\uBD80\uC5D0\\r\\n\uCD5C\uCD08\uB85C \uB3C4\uB2EC\uD55C \uD300\uC758 \uC774\uB984\uC774 \uBB50\uB77C\uACE0?[VAR 0114(0027)]",
  "\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uBAA8\uD5D8\uB2E8",
  "\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uAD00\uCE21\uB300",
  "\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uC870\uC0AC\uB300",
  "...\uB561!\\n\uB108\uB3C4 \uBAA8\uD5D8\uC774\uB77C\uB294 \uB9D0\uC744 \uB4E4\uC73C\uBA74\\r\\n\uAC00\uC2B4\uC774 \uB9C9 \uC124\uB808\uB294 \uBAA8\uC591\uC774\uAD6C\uB098...[VAR 0114(0027)]",
  "...\uC815\uB2F5!\\n\uC9C0\uB098\uAC00\uB4EF \uB9D0\uD588\uB358 \uAC83\uB3C4 \uC81C\uB300\uB85C \uAE30\uC5B5\uD558\uB2E4\uB2C8\\r\\n\uC0DD\uAC01\uBCF4\uB2E4 \uCD1D\uBA85\uD55C \uCE5C\uAD6C\uAD6C\uB098.[VAR 0114(0027)]",
  "...\uB561!\\n\uC870\uC0AC\uB098 \uAD00\uCE21\uC774\uB098\\r\\n\uD558\uB294 \uC77C\uC5D0 \uD070 \uCC28\uC774\uB294 \uC5C6\uC9C0\uB9CC \uB9D0\uC774\uC57C![VAR 0114(0027)]",
  "\uADF8\uB798! \uC815\uB2F5\uC740\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uAD00\uCE21\uB300\uC57C![VAR 0114(0027)]",
  "\uAD00\uCE21\uB300 \uBA64\uBC84\uC778\\n\uD5E4\uB354\uAC00 \uC4F4 \uD0D0\uD5D8\uAE30\uB294\\r\\n\uC9C0\uAE08\uB3C4 \uC11C\uC810\uC5D0\uC11C \uBCFC \uC218 \uC788\uC9C0.[VAR 0114(0027)]",
  "\uC81C\uBAA9\uC774 \uC544\uB9C8...\\n[VAR FF00(0006)]\uC2A4\uCE7C\uB81B\uBD81[VAR FF00(0000)]\uC774\uC5C8\uC5C8\uB098?[VAR 0114(0027)]",
  "\uC81C\uBAA9\uC774 \uC544\uB9C8...\\n[VAR FF00(0006)]\uBC14\uC774\uC62C\uB81B\uBD81[VAR FF00(0000)]\uC774\uC5C8\uC5C8\uB098?[VAR 0114(0027)]",
  "\uB2F9\uC2DC\uC5D0\uB294 \uD314\uB370\uC544 \uC804\uC5ED\uC774\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0 \uD06C\uAC8C \uC5F4\uAD11\uD558\uB358 \uC2DC\uAE30\uB77C,[VAR 0114(0027)]",
  "\uB204\uAD6C\uB098 \uC2A4\uCE7C\uB81B\uBD81\uC744 \uAC00\uC9C0\uACE0 \uC788\uC744 \uC815\uB3C4\uB85C\\n\uB9CE\uC774 \uD314\uB838\uB2E4\uB294 \uBAA8\uC591\uC774\uC57C.[VAR 0114(0027)]",
  "\uB204\uAD6C\uB098 \uBC14\uC774\uC62C\uB81B\uBD81\uC744 \uAC00\uC9C0\uACE0 \uC788\uC744 \uC815\uB3C4\uB85C\\n\uB9CE\uC774 \uD314\uB838\uB2E4\uB294 \uBAA8\uC591\uC774\uC57C.[VAR 0114(0027)]",
  "\uD558\uC9C0\uB9CC, \uCC45\uC5D0\uB294 \uBBFF\uAE30 \uC5B4\uB824\uC6B4 \uBB18\uC0AC\uC5D0\\n\uAC70\uC9D3\uB9D0 \uAC19\uC740 \uC0BD\uD654, \uAFC8\uAC19\uC740 \uC774\uC57C\uAE30\uB4E4\uBFD0\uC774\uB77C\\r\\n\uC0AC\uB78C\uB4E4\uC740 \uD5E4\uB354\uB97C \uAC70\uC9D3\uB9D0\uC7C1\uC774\uB85C \uCDE8\uAE09\uD588\uC9C0...[VAR 0114(0027)]",
  "\uAD00\uCE21\uB300\uAC00 \uC2E4\uC81C\uB85C \uCD5C\uC2EC\uBD80\uC5D0\\n\uB3C4\uB2EC\uD588\uB294\uC9C0\uB3C4 \uC758\uC2EC\uC744 \uBC1B\uAC8C \uB3FC\uC11C,[VAR 0114(0027)]",
  "\uC2A4\uCE7C\uB81B\uBD81\uC740 \uACB0\uAD6D \uC624\uCEEC\uD2B8 \uCC45\uC73C\uB85C \uBD84\uB958\uB418\uC5B4\\n\uD5CC\uCC45\uBC29\uC5D0 \uC313\uC774\uB294 \uC2E0\uC138\uAC00 \uB418\uC5C8\uB2E4\uACE0 \uD574.[VAR 0114(0027)]",
  "\uBC14\uC774\uC62C\uB81B\uBD81\uC740 \uACB0\uAD6D \uC624\uCEEC\uD2B8 \uCC45\uC73C\uB85C \uBD84\uB958\uB418\uC5B4\\n\uD5CC\uCC45\uBC29\uC5D0 \uC313\uC774\uB294 \uC2E0\uC138\uAC00 \uB418\uC5C8\uB2E4\uACE0 \uD574.[VAR 0114(0027)]",
  "\uC785\uAD6C \uD640 1\uCE35\uC5D0 \uC788\uB294 \uCC45\uC7A5\uC5D0\uB3C4 \uC788\uC744 \uD14C\uB2C8\uAE4C,\\n\uAD00\uC2EC \uC788\uC73C\uBA74 \uD55C\uBC88 \uC77D\uC5B4 \uBCF4\uB3C4\uB85D \uD558\uB834.[VAR 0114(0027)]",
  "\uC5B4\uB77C? \uC774\uC57C\uAE30\uAC00 \uB108\uBB34 \uAE38\uC5C8\uB098?\\n\uC2DC\uAC04 \uCC38 \uBE60\uB974\uB124.[VAR 0114(0027)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0!\\n\uB2E4\uC74C \uC2DC\uAC04\uC5D0\uB3C4 \uC5ED\uC0AC\uC758 \uC218\uC218\uAED8\uB07C\uB97C \uD480\uC5B4 \uBCF4\uC790![VAR 0114(0027)]"
]
