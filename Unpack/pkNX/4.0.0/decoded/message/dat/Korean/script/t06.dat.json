[
  "\uC5EC\uAE30\uB294 \uCC38\uD478\uB974\uB9C8\uC744\uC774\uB780\uB2E4!\\n\uC870\uAE08 \uD63C\uC7A1\uD574 \uBCF4\uC774\uB294 \uB9C8\uC744\uC774\uC9C0?\\r\\n\uB9C8\uC744 \uC774\uB984\uB3C4 \uADF8\uB7F0 \uB73B\uC774\uC57C!",
  "\uBCF4\uBB3C\uC2DD\uB2F9\uC5D0\uB294 \uAC00 \uBD24\uB2C8?\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC758 \uB2E8\uACE8\uC9D1\uC774\uB77C\uB354\uAD6C\uB098!",
  "\uC6B0\uB9AC \uAC00\uAC8C\uC758 \uB9DB\uC740 \uD314\uB370\uC544 \uC81C\uC77C!\\n\uAF2D \uD55C\uBC88 \uB4E4\uB7EC \uC8FC\uC138\uC694~!",
  "\uC2E0\uC120\uB9C8\uB8E8 \uB808\uC2A4\uD1A0\uB791!\\n\uBBF8\uB124\uB784\uC774 \uD48D\uBD80\uD558\uB2F5\uB2C8\uB2E4~",
  "\uC190\uB2D8\uC758 \uD3EC\uCF13\uBAAC,\\n\uC800\uD76C \uAC00\uAC8C\uC5D0\uC11C \uC2DD\uC0AC\uD558\uACE0 \uC2F6\uC740 \uAC83 \uAC19\uC740\uB370\uC694?",
  "\uBE44\uC2FC \uAC00\uAC8C\uC5D0\uB294\\n\uB4DC\uB808\uC2A4 \uCF54\uB4DC\uAC00 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4.\\r\\n\uC5B4\uB5BB\uAC8C \uC0DD\uAE34 \uCF54\uB4DC\uC778 \uAC78\uAE4C...?",
  "\uC6A9\uB3C8\uC744 \uBAA8\uC544\uC11C \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uB9DB\uC788\uB294 \uAC83\uC744 \uBA39\uAC8C \uD574 \uC8FC\uACE0 \uC2F6\uC5B4~",
  "\uB9E4\uCF64~\uD55C \uC694\uB9AC\uAC00 \uC544\uC8FC \uC77C\uD488\uC774\uB78D\uB2C8\uB2E4!\\n\uC790, \uC790, \uC5B4\uC11C \uC624\uC138\uC694~!",
  "\uC9C0\uAE08\uC774\uB77C\uBA74 \uC608\uC57D\uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4\\n\uC2DD\uC0AC\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4~",
  "\uCEE4\uB2E4\uB780 \uBB38\uC774 \uAC00\uB85C\uB9C9\uACE0 \uC788\uC5B4\uC11C\\n\uD314\uB370\uC544\uC758 \uB300\uACF5\uC5D0 \uAC00\uC9C0 \uBABB\uD588\uC5B4!",
  "\uBB38 \uC548\uCABD\uC5D0\uB294 \uC81C\uB85C\uAC8C\uC774\uD2B8\uB77C\uB294\\n\uCD9C\uC785 \uAE08\uC9C0 \uC2DC\uC124\uC774 \uC788\uB300!",
  "\uCC38\uD478\uB974\uB9C8\uC744\uC758 \uBA85\uBB3C,\\n\uBCF4\uBB3C\uC2DD\uB2F9\uC740 \uC774\uCABD\uC785\uB2C8\uB2E4~!\\c\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uC5D0 \uB3C4\uC804 \uC911\uC774\uC2E0 \uBD84\uB4E4\uC740\\n\uBE44\uBC00 \uBA54\uB274\uB3C4 \uC8FC\uBB38\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4~!",
  "\uBCF4\uBB3C\uC2DD\uB2F9\uC5D0\uC11C \uD14C\uB77C\uC2A4\uD0C8\uD0C0\uC785\uC744\\n\uBC14\uAFC0 \uC218 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uB294\uB370,\\r\\n\uC8FC\uBC29\uC7A5\uD55C\uD14C \uBB38\uC804 \uBC15\uB300 \uB2F9\uD558\uACE0 \uB9D0\uC558\uC5B4...",
  "\uC0CC\uB4DC\uC704\uCE58\uB294 \uC5B4\uB5A0\uC2E0\uAC00\uC694~?\\n\uBC30\uACE0\uD504\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uB458\uB7EC\uBCF4\uC138\uC694~!",
  "\uB098\uD398\uC0B0\uC744 \uC624\uB974\uAE30 \uC804\uC5D0\\n\uCC38\uD478\uB974\uB9C8\uC744\uC758 \uC0C1\uC810\uAC00\uC5D0\uC11C \uBC25\uC744 \uBA39\uACE0\\r\\n\uAE30\uC6B4\uC744 \uBCF4\uCDA9\uD558\uB294 \uAC8C \uC88B\uC544!",
  "\uC774 \uB9C8\uC744\uC740\\n\uD314\uB370\uC544 \uAD50\uD1B5\uC758 \uC694\uC9C0\uB780\uB2E4.\\c\\n\uB355\uBD84\uC5D0 \uC678\uBD80\uC5D0\uC11C \uCC3E\uC544\uC624\uB294 \uC0AC\uB78C\uB4E4\uC774 \uB9CE\uC544\uC11C\\n\uC790\uC5F0\uC2A4\uB808 \uC74C\uC2DD\uC810\uC774 \uB9CE\uC544\uC84C\uC9C0.",
  "\uB0B4 \uC694\uC53D\uB9AC\uC2A4...\\n\uC810\uC810 \uB369\uCE58\uAC00 \uCEE4\uC9C0\uACE0 \uC788\uC5B4...\\r\\n\uC880 \uB354 \uD070 \uC9D1\uC73C\uB85C \uC774\uC0AC\uD574\uC57C \uD558\uB098?",
  "\uB098\uD398\uC0B0\uC740 \uAE38\uC774 \uD5D8\uD574!\\n\uAC00\uB824\uAC70\uB4E0 \uCCA0\uC800\uD558\uAC8C \uC900\uBE44\uD558\uB834!",
  "\uC774 \uB9C8\uC744\uC5D0\uB294 \uBC30\uD2C0\uCF54\uD2B8\uAC00 \uC5C6\uB098 \uBD10.\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC740 \uC5B4\uB514\uC5D0\uC11C \uC2F8\uC6B0\uB294 \uAC78\uAE4C?",
  "\uC544\uC8FC \uC608\uC804\uC5D0\uB294 \uACC4\uB2E8 \uC544\uB798\uAC00 \uADF9\uC7A5\uC774\uC5B4\uC11C\\n\uC5F0\uADF9\uC774\uB098 \uCF58\uC11C\uD2B8\uB97C \uD588\uC5C8\uB2E8\uB2E4.",
  "\uC80A\uAD6C\uBA3C, \uD559\uC0DD\uC778\uAC00?\\n\uC790\uC728 \uD559\uC2B5 \uC2DC\uC98C\uC778\uAC00 \uBCF4\uC9C0?"
]
