[
  "\uB108\uC5D0\uAC90 \uADF8\uC57C\uB9D0\uB85C \uD589\uC6B4\uC758 \uB0A0\uC528\uC778\uAC78?\\n\uC124\uC0B0\uC774 \uC0C1\uB0E5\uD568\uC744 \uBCA0\uD47C \uAC78\uAE4C?[VAR 0114(001A)]",
  "\uB108\uC5D0\uAC90 \uADF8\uC57C\uB9D0\uB85C \uCD5C\uC545\uC758 \uB0A0\uC528\uB124.\\n\uC124\uC0B0\uC740 \uC544\uBB34\uB798\uB3C4 \uB0B4 \uD3B8\uC778 \uBAA8\uC591\uC774\uC57C![VAR 0114(001A)]",
  "1\uB144\uC5D0 \uBA87 \uBC88\uC529 \uC774\uB7F0 \uC2DD\uC73C\uB85C\\n\uB9AC\uADF8\uC5D0\uC11C \uC2DC\uCC30\uD558\uB7EC \uC62C \uB54C\uAC00 \uC788\uC5B4.[VAR 0114(001A)]",
  "\uC790\uB9AC\uC5D0 \uAC78\uB9DE\uC740 \uC2E4\uB825\uC744 \uBC1C\uD718\uD558\uC9C0 \uBABB\uD558\uBA74\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0\uC11C \uB0B4\uB824\uC640\uC57C \uD558\uB294 \uD14C\uC2A4\uD2B8...[VAR 0114(001A)]",
  "...\uD14C\uC0AC \uC528\uB294 \uD615\uC2DD\uC801\uC778 \uAC83\uC77C \uBFD0\uC774\uB77C\uACE0 \uD558\uC9C0\uB9CC\\n\uB0B4 \uC0DD\uAC01\uC740 \uC870\uAE08 \uB2EC\uB77C.[VAR 0114(001A)]",
  "\uC2A4\uB178\uBCF4\uB354\uC758 \uAFC8\uC744 \uC811\uAC8C \uB41C \uAC83\uC73C\uB85C\uB3C4 \uBAA8\uC790\uB77C\\n\uB0A8\uC740 \uC7AC\uB2A5\uC744 \uBC1C\uD718\uD560 \uAE30\uD68C\uB9C8\uC800\uB3C4 \uBE7C\uC557\uAE30\uBA74\\r\\n\uB0B4\uAC90 \uB300\uCCB4 \uBB50\uAC00 \uB0A8\uC9C0?[VAR 0114(001A)]",
  "...\uC870\uAE08 \uC18C\uB984 \uB3CB\uB294 \uB9D0\uC744 \uD574 \uBC84\uB838\uC9C0\uB9CC\\n\uC0AC\uC2E4\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uAC04\uB2E8\uD55C \uC774\uC57C\uAE30\uC57C.[VAR 0114(001A)]",
  "\uB0B4\uAC00 \uB108\uB97C \uCCA0\uC800\uD558\uAC8C \uC5BC\uB824 \uBC84\uB9AC\uBA74\\n\uACE0\uBBFC\uD560 \uAC83\uB3C4 \uC5C6\uB294 \uAC70\uB2C8\uAE4C![VAR 0114(001A)]",
  "\uD14C\uC0AC \uC528\uB3C4 \uCC38 \uC9D3\uAD82\uB2E4\uB2C8\uAE4C.\\n\uC808\uB300 \uC774\uAE38 \uC218 \uC5C6\uB294 \uC0C1\uB300\uB97C \uBCF4\uB0B4\uB2E4\uB2C8 \uB9D0\uC774\uC57C.[VAR 0114(001A)]",
  "\uADF8\uB798\uB3C4 \uD6C4\uD68C\uB294 \uC5C6\uC5B4.\\n\uB0B4\uAC00 \uAC00\uC9C4 \uC2E4\uB825\uC744 \uBAA8\uB450 \uBC1C\uD718\uD588\uC73C\uB2C8\uAE4C.[VAR 0114(001A)]",
  "\uC804\uB825\uC73C\uB85C \uB108\uC5D0\uAC8C \uBD80\uB52A\uCCE4\uB294\uB370\uB3C4 \uC838\uC11C...\\n\uBD84\uD558\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uC5B4.[VAR 0114(001A)]",
  "\uADF8\uB798\uC11C \uC774\uC81C\uBD80\uD130 \uC870\uAE08 \uB354 \uC9C4\uC9C0\uD558\uAC8C\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uC77C\uC5D0 \uC784\uD574 \uBCF4\uB824\uACE0 \uD574.[VAR 0114(001A)]",
  "\uB098\uC758 \uCC28\uAC11\uAC8C \uC2DD\uC740 \uC5F4\uC815\uC5D0\\n\uB2E4\uC2DC\uAE08 \uBD88\uC744 \uBD99\uC5EC \uC918\uC11C\\r\\n...\uACE0\uB9C8\uC6CC, [VAR 0100(0000)].[VAR 0114(001A)]",
  "\uB2E4\uC74C\uC5D0 \uC2B9\uBD80\uD560 \uB54C\uB294 \uC9C0\uC9C0 \uC54A\uC744 \uAC70\uC57C.[VAR 0114(001A)]",
  "\uADF8\uB7FC, \uAC10\uAE30 \uAC78\uB9AC\uC9C0 \uC54A\uAC8C\\n\uC870\uC2EC\uD574\uC11C \uB0B4\uB824\uAC00\uB3C4\uB85D \uD574![VAR 0114(001A)]"
]
