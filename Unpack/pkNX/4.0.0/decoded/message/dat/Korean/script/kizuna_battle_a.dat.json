[
  "\uC548\uB155! \uC804\uD559\uC0DD![VAR 0114(0024)]",
  "\uC6B4\uB3D9\uC7A5\uC5D0\uB294 \uBB34\uC2A8 \uC77C\uC774\uC57C?\\n\uD639\uC2DC, \uD2B8\uB808\uC774\uB2DD\uD558\uB7EC \uC628 \uAC70\uC57C!?[VAR 0114(0024)]",
  "\uC5B4\uCA50\uC9C0 \uB208\uBE5B\uB9CC \uBD10\uB3C4\\n\uD22C\uC9C0\uAC00 \uB290\uAEF4\uC9C0\uB354\uB77C\uACE0![VAR 0114(0024)]",
  "\uBBF8\uC548!\\n\uD2B8\uB808\uC774\uB2DD\uC740 \uB0A8\uB4E4\uC774 \uBAA8\uB974\uAC8C \uD558\uB294 \uAC70\uC600\uC9C0!\\r\\n...\uC13C\uC2A4 \uC5C6\uB294 \uC9C8\uBB38\uC774\uC5C8\uB124![VAR 0114(0024)]",
  "\uCE5C\uBD84\uC744 \uB3C8\uB3C5\uD788 \uD560 \uACB8\\n\uAC19\uC774 \uC6B4\uB3D9\uC7A5\uC744 \uB2EC\uB824 \uBCF4\uC9C0 \uC54A\uC744\uB798!?[VAR 0114(0024)]",
  "\uADF8\uB7FC, \uAC00\uC790![VAR 0114(0024)]",
  "\uC6B4\uD5A5 \uC120\uC0DD\uB2D8\uACFC \uC6B4\uB3D9\uC7A5\uC744\\n\uC138 \uBC14\uD034 \uB2EC\uB838\uB2E4...",
  "\uD734~!\\n\uB540 \uD55C\uBC88 \uC2DC\uC6D0\uD558\uAC8C \uD758\uB838\uB124![VAR 0114(0024)]",
  "\uC804\uD559\uC0DD\uB3C4 \uC0DD\uAC01\uBCF4\uB2E4\\n\uD558\uCCB4\uAC00 \uAF64 \uD2BC\uD2BC\uD55C\uAC78![VAR 0114(0024)]",
  "\uC6B4\uB3D9\uD558\uACE0 30\uBD84 \uC774\uB0B4\uC5D0 \uC601\uC591\uBD84\uC744\\n\uACF5\uAE09\uD574 \uC8FC\uBA74, \uADFC\uC721\uC774 \uBD99\uAE30 \uC26C\uC6CC\uC9C4\uB2E4\uAD6C![VAR 0114(0024)]",
  "\uC5B4\uC6B8\uB824 \uC900 \uBCF4\uB2F5\uB3C4 \uD560 \uACB8,\\n\uB0B4\uAC00 \uC9C1\uC811 \uB9CC\uB4E0 \uC0CC\uB4DC\uC704\uCE58\uB97C \uC904\uAC8C!\\r\\n\uC774\uAC70 \uBA39\uACE0 \uAC74\uAC15\uD55C \uBAB8\uC744 \uB9CC\uB4E4\uC5B4 \uBCF4\uB834![VAR 0114(0024)]",
  "\uC6B4\uD5A5 \uC120\uC0DD\uB2D8\uC774 \uB9CC\uB4E0 \uC0CC\uB4DC\uC704\uCE58\uB294\\n\uD37C\uC11D\uD37C\uC11D\uD558\uACE0 \uB0C4\uC0C8\uB3C4 \uC774\uC0C1\uD55C \uB370\uB2E4\\r\\n\uC544\uBB34\uB7F0 \uB9DB\uB3C4 \uB098\uC9C0 \uC54A\uC558\uB2E4...",
  "\uC5B4\uB54C?\\n\uB0B4\uAC00 \uB9CC\uB4E0 \uC0CC\uB4DC\uC704\uCE58\uB294? \uB9DB\uC788\uC5B4?[VAR 0114(0024)]",
  "\uB9DB\uC788\uC5B4\uC694...",
  "\uC194\uC9C1\uD788 \uB9D0\uC500\uB4DC\uB9AC\uC790\uBA74...",
  "\uBBF8\uC548...\\n\uB0B4\uAC00 \uAD1C\uD788 \uB9C8\uC74C \uC4F0\uAC8C \uD588\uAD6C\uB098.[VAR 0114(0024)]",
  "\uBAB8\uC744 \uC6C0\uC9C1\uC774\uB294 \uAC70\uB77C\uBA74 \uBB50\uB4E0\uC9C0 \uC798\uD558\uC9C0\uB9CC\\n\uC694\uB9AC\uC5D0\uB294 \uC644\uC804\uD788 \uC82C\uBCD1\uC774\uB77C\uC11C \uB9D0\uC774\uC57C.[VAR 0114(0024)]",
  "\uC804\uD559\uC0DD\uC774 \uC194\uC9C1\uD788 \uBC18\uC751\uD574 \uC900 \uB355\uBD84\uC5D0\\n\uD655\uC2E4\uD788 \uC54C \uC218 \uC788\uC5C8\uC5B4...[VAR 0114(0024)]",
  "\uADF8\uB7FC, \uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uC790.\\n\uB0B4\uC77C \uC62C \uADFC\uC721\uD1B5\uB3C4 \uAE30\uB300\uD558\uACE0...[VAR 0114(0024)]",
  "\uC6B4\uD5A5 \uC120\uC0DD\uB2D8\uACFC\\n\uC870\uAE08 \uCE5C\uD574\uC84C\uB2E4!"
]
