[
  "\uC548\uB155~\\n\uC990\uAC70\uC6B4 \uC218\uC5C5\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C?[VAR 0114(0025)]",
  "\uB2E4\uB4E4 \uC9C0\uB09C \uC218\uC5C5\uC740\\n\u201C\uD06C\uAC8C\u201D \uB3C4\uC6C0\uC774 \uB410\uB2C8?[VAR 0114(0025)]",
  "\uACF1\uC148\uC774\uB2C8 %\uB2C8 \uC870\uAE08 \uBCF5\uC7A1\uD574\uC11C\\n\uBCF5\uC2B5\uC774 \uD544\uC694\uD588\uC744 \uAC70\uC57C.[VAR 0114(0025)]",
  "\uADF8\uB7FC \uC624\uB298\uB3C4 %\uB97C \uD65C\uC6A9\uD574\uC11C\\n\uD655\uB960\uC5D0 \uB300\uD574 \uC54C\uC544 \uAC00 \uBCFC\uAE4C?[VAR 0114(0025)]",
  "\uC5B4\uB835\uAC8C \uB4E4\uB9B4\uC9C0\uB3C4 \uBAA8\uB974\uC9C0\uB9CC,\\n\uC0AC\uC2E4 \uC5EC\uB7EC\uBD84\uC740 \uC774\uBBF8\\r\\n\uD655\uB960\uC744 \uC77C\uC0C1\uC801\uC73C\uB85C \uC0AC\uC6A9\uD558\uACE0 \uC788\uB2E8\uB2E4.[VAR 0114(0025)]",
  "\uD3EC\uCF13\uBAAC\uC758 \uAE30\uC220\uC5D0\uB294 \uAC01 \uAE30\uC220\uC774\\n\uC0C1\uB300\uC5D0\uAC8C \uB9DE\uC744\uC9C0\uB97C \uB098\uD0C0\uB0B4\uB294\\r\\n\uBA85\uC911\uC774\uB77C\uB294 \uD655\uB960\uC774 \uC874\uC7AC\uD574.[VAR 0114(0025)]",
  "\uBAB8\uD1B5\uBC15\uCE58\uAE30\uC758 \uBA85\uC911\uC740 100!\\n\uB2E4\uC2DC \uB9D0\uD574 100%\uB77C\uB294 \uC18C\uB9AC\uB2C8\uAE4C,\\r\\n100\uBC88 \uC0AC\uC6A9\uD558\uBA74 100\uBC88 \uBAA8\uB450 \uBA85\uC911\uD558\uAC8C \uB3FC.[VAR 0114(0025)]",
  "\uC0C1\uB300\uB97C \uC7A0\uB4E6 \uC0C1\uD0DC\uB85C \uB9CC\uB4DC\uB294\\n\uCD5C\uBA74\uC220\uC758 \uBA85\uC911\uC740 60![VAR 0114(0025)]",
  "\uB2E4\uC2DC \uB9D0\uD574 60%\uB77C\uB294 \uC18C\uB9AC\uB2C8\uAE4C,\\n100\uBC88 \uC911 60\uBC88\uC740 \uB9DE\uB294\uB2E4\uB294 \uAC70\uC57C...\\r\\n\uAC70\uAFB8\uB85C \uB9D0\uD558\uBA74, 40\uBC88\uC740 \uC2E4\uD328\uD55C\uB2E4\uB294 \uAC70\uC9C0.[VAR 0114(0025)]",
  "\uBCF4\uD1B5, \uC704\uB825\uC774 \uC5B4\uB9C8\uC5B4\uB9C8\uD558\uAC8C \uAC15\uD55C \uAE30\uC220\uC77C\uC218\uB85D\\n\uBA85\uC911\uC774 \uB0AE\uC740 \uACBD\uC6B0\uAC00 \uB9CE\uC544.[VAR 0114(0025)]",
  "\uBC18\uB4DC\uC2DC \uB9DE\uB294 \uAE30\uC220\uB85C \uC548\uC815\uC801\uC73C\uB85C \uACF5\uACA9\uD560\uC9C0,\\n\uBA85\uC911\uC774 \uBD88\uC548\uD558\uC9C0\uB9CC \uAC15\uD55C \uAE30\uC220\uC744 \uC0AC\uC6A9\uD560\uC9C0...[VAR 0114(0025)]",
  "\uAE30\uC220\uC744 \uC0DD\uAC01\uD558\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uC5EC\uB7EC\uBD84\uC740\\n\uD655\uB960\uC744 \uACF5\uBD80\uD558\uACE0 \uC788\uB294 \uAC70\uB780\uB2E4~![VAR 0114(0025)]",
  "\uBA85\uC911 \uB54C\uBB38\uC5D0 \uC790\uC8FC \uD654\uC81C\uAC00 \uB418\uB294 \uAC83\uC774\uB77C\uBA74\\n\uD30C\uB3C4\uD0C0\uAE30\uC640 \uD558\uC774\uB4DC\uB85C\uD38C\uD504 \uC544\uB2D0\uAE4C?[VAR 0114(0025)]",
  "\uD30C\uB3C4\uD0C0\uAE30\uB294 \uBA85\uC911\uC774 100\uC774\uB2C8\uAE4C\\n\uBC18\uB4DC\uC2DC \uC704\uB825 90\uC758 \uB370\uBBF8\uC9C0\uB97C \uC904 \uC218 \uC788\uC5B4.[VAR 0114(0025)]",
  "\uD55C\uD3B8, \uD558\uC774\uB4DC\uB85C\uD38C\uD504\uB294 \uBA85\uC911\uC774 80\uC774\uC9C0\uB9CC\\n\uC704\uB825 110\uC758 \uB370\uBBF8\uC9C0\uB97C \uAE30\uB300\uD560 \uC218 \uC788\uC9C0![VAR 0114(0025)]",
  "\uC5EC\uB7EC\uBD84\uC774\uB77C\uBA74 \uD30C\uB3C4\uD0C0\uAE30\uC640 \uD558\uC774\uB4DC\uB85C\uD38C\uD504 \uC911\uC5D0\\n\uC5B4\uB290 \uAE30\uC220\uC744 \uACE0\uB97C \uAC70\uC9C0?[VAR 0114(0025)]",
  "\uD30C\uB3C4\uD0C0\uAE30",
  "\uD558\uC774\uB4DC\uB85C\uD38C\uD504",
  "\uC0C1\uD669\uC5D0 \uB530\uB77C\uC11C",
  "\uC5B4\uBA38, [VAR 0100(0000)][VAR 1900(0001)]\\n\uCC29\uC2E4\uD558\uAC8C \uD480\uC5B4 \uAC00\uB294 \uD0C0\uC785\uC774\uAD6C\uB098.[VAR 0114(0025)]",
  "\uC5B4\uBA38, [VAR 0100(0000)][VAR 1900(0001)]\\n\uBAA8\uD5D8\uC744 \uC88B\uC544\uD558\uB294 \uD0C0\uC785\uC774\uAD6C\uB098.[VAR 0114(0025)]",
  "\uC5B4\uBA38, [VAR 0100(0000)][VAR 1900(0001)]\\n\uC5EC\uB7EC \uC0C1\uD669\uC744 \uACE0\uB824\uD558\uB294 \uD0C0\uC785\uC774\uAD6C\uB098.[VAR 0114(0025)]",
  "\uC120\uC0DD\uB2D8\uC774 \uBB34\uC2EC\uCF54 \uC9C8\uBB38\uD574 \uBC84\uB838\uB294\uB370,\\n\uC5EC\uAE30\uC5D0 \uC815\uB2F5\uC740 \uC5C6\uB2E8\uB2E4!\\r\\n\uAC01\uC790\uAC00 \uC120\uD638\uD558\uB294 \uAE30\uC220\uC744 \uC0AC\uC6A9\uD558\uBA74 \uB3FC.[VAR 0114(0025)]",
  "PP\uB3C4 \uB2E4\uB974\uACE0, \uBCF5\uC218 \uACF5\uACA9 \uAC00\uB2A5 \uC5EC\uBD80\uB3C4 \uB2EC\uB77C\uC11C\\n\uC5B4\uB290 \uAC83\uC774 \uB354 \uB0AB\uB2E4\uACE0 \uB9D0\uD560 \uC218 \uC5C6\uC73C\uB2C8\uAE4C.[VAR 0114(0025)]",
  "\uC774 \uD30C\uB3C4\uD0C0\uAE30-\uD558\uC774\uB4DC\uB85C\uD38C\uD504 \uBB38\uC81C\uB294\\n\uC61B\uB0A0\uBD80\uD130 \uC790\uC8FC \uC758\uACAC\uC774 \uAC08\uB9AC\uB294 \uBB38\uC81C\uC600\uB2E8\uB2E4.[VAR 0114(0025)]",
  "\uC120\uC0DD\uB2D8 \uC785\uC7A5\uC5D0\uC120 \uBC14\uC704\uD0C0\uC785 \uAE30\uC220 \uC911\uC5D0\\n\uC2A4\uD1A4\uC0E4\uC6CC\uB97C \uC4F8\uC9C0, \uC2A4\uD1A4\uC5D0\uC9C0\uB97C \uC4F8\uC9C0\uC5D0 \uB300\uD574[VAR 0114(0025)]",
  "\uB728\uAC81\uAC8C \uC774\uC57C\uAE30\uD574 \uBCF4\uACE0 \uC2F6\uC740\uB370...\\n\uC5B4\uBA38, \uC885\uC18C\uB9AC\uAC00... \uC544\uC27D\uB124...[VAR 0114(0025)]",
  "\uB2E4\uC74C\uC774 \uD6C4\uBC18\uAE30 \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC774\uB124!\\n100%\uC758 \uD798\uC73C\uB85C \uB2E4\uC74C \uC2DC\uAC04\uC5D0 \uBCF4\uC790![VAR 0114(0025)]"
]
