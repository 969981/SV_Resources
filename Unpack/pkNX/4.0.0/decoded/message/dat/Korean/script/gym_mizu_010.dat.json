  "\uBC29\uAE08 \uC9C0\uB098\uAC04 \uB369\uCE58 \uD070 \uC544\uC800\uC528\uAC00\\n\uCE74\uB77C\uD504\uCCB4\uC721\uAD00\uC758 \uAD00\uC7A5\uC778 \uACE4\uD3EC \uB2D8\uC774\uC138\uC694.",
  "\uACE4\uD3EC \uB2D8, \uC0B4\uC9DD \uB35C\uB801\uC774 \uAE30\uC9C8\uC774 \uC788\uC73C\uC154\uC11C\\n\uC2DC\uC7A5\uC5D0 \uC7A5\uC744 \uBCF4\uB7EC \uAC00\uB294\uB370\\r\\n\uC9C0\uAC11\uC744 \uB450\uACE0 \uAC00 \uBC84\uB9AC\uC168\uC5B4\uC694...",
  "\uBD84\uBA85\uD788 \uC5C4\uCCAD \uACE4\uB780\uD574\uD558\uC2E4 \uD150\uB370...\\c\\n\uCE5C\uC808\uD55C \uB3C4\uC804\uC790\uB2D8!\\n\uC800 \uB300\uC2E0 \uC9C0\uAC11\uC744 \uC804\uD574 \uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694!?",
  "\uC544! \uC774\uB807\uAC8C \uC0C1\uB0E5\uD558\uC2E4 \uC218\uAC00!\\n\uC9C0\uAE08 \uC774 \uC790\uB9AC\uC5D0\uC11C \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C\\r\\n\uB4DC\uB9AC\uACE0 \uC2F6\uC744 \uC815\uB3C4\uB124\uC694!",
  "\uC8C4\uC1A1\uD558\uC9C0\uB9CC \uACE4\uD3EC \uB2D8\uC774 \uC548 \uACC4\uC2DC\uBA74\\n\uCCB4\uC721\uAD00\uC5D0 \uB3C4\uC804\uD558\uC2E4 \uC218 \uC5C6\uB294 \uB370\uB2E4\\r\\n\uC81C\uAC00 \uC811\uC218\uCC98\uB97C \uBE44\uC6B8 \uC218 \uC5C6\uB294 \uC0C1\uD669\uC774\uB77C\uC11C\uC694...",
  "\uADF8\uB7FC, \uC774\uAC78 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!",
  "\uBB34\uC0AC\uD788 \uC804\uB2EC\uD574 \uC8FC\uC2DC\uBA74\\n\uD2B9\uBCC4\uD788 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C\\r\\n\uD074\uB9AC\uC5B4\uD55C \uAC83\uC73C\uB85C \uD574 \uB4DC\uB9B4\uAC8C\uC694!",
  "\uACE4\uD3EC \uB2D8\uC740 \uC11C\uCABD \uC0AC\uB9C9\uC744 \uC9C0\uB098\uBA74 \uC788\uB294\\n[VAR FF00(0006)]\uB9C8\uB9AC\uB124\uC774\uB4DC\uB9C8\uC744[VAR FF00(0000)]\uB85C \uD5A5\uD558\uC168\uC5B4\uC694!",
  "\uC0AC\uB9C9\uC5D0\uB294 \uC704\uD5D8\uD55C \uD3EC\uCF13\uBAAC\uC774 \uB9CE\uC73C\uB2C8\\n\uC870\uC2EC\uD788 \uB2E4\uB140\uC624\uC138\uC694~!"
