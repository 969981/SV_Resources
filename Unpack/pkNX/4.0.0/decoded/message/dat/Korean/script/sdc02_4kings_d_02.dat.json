[
  "\uC790! \uC5EC\uAE30\uAC00 \uBC14\uB85C!\\n\uD3F4\uB77C \uC2A4\uD018\uC5B4\uC758 \uBC30\uD2C0\uCF54\uD2B8\uC57C![VAR 0114(004A)]",
  "...\uBB50, \uC5C4\uCCAD \uCDA5\uB2E4\uB294 \uAC83\uB9CC \uBE7C\uBA74\\n\uB2E4\uB978 \uC2A4\uD018\uC5B4\uC640 \uCC28\uC774\uB294 \uC5C6\uC9C0\uB9CC![VAR 0114(004A)]",
  "\uB0B4\uAC00 \uB4DC\uB798\uACE4 \uC870\uB828\uC0AC\uC778\uB370\uB3C4\\n\uCD94\uC6B4 \uAC78 \uAF64 \uC88B\uC544\uD558\uAC70\uB4E0.[VAR 0114(004A)]",
  "\uC5B4\uC774\uCFE0, \uC0DD\uAC01\uD574 \uBCF4\uB2C8\\n\uC0AC\uCC9C\uC655 \uCC4C\uB9B0\uC9C0 \uB54C\uBB38\uC5D0 \uC628 \uAC70\uC600\uC9C0?[VAR 0114(004A)]",
  "\uB0B4\uAC00 \uC900\uBE44\uD55C \uCC4C\uB9B0\uC9C0\uB294\\n[VAR FF00(0006)]\uB3D4 \uD55C\uC815 \uC2B9\uBD80[VAR FF00(0000)]\uC57C![VAR 0114(004A)]",
  "\uB8F0\uC740 \uAC04\uB2E8\uD574!\\n\uB9AC\uADF8\uBD80 \uD6C4\uBC30 \uC138 \uBA85\uC744 \uC774\uAE30\uAE30\uB9CC \uD558\uBA74\\r\\n\uCC4C\uB9B0\uC9C0 \uD569\uACA9\uC774\uC57C![VAR 0114(004A)]",
  "\uB2E8, \uC774\uB984\uB300\uB85C \uBC30\uD2C0\uC5D0 \uB0B4\uBCF4\uB0BC \uC218 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC5D0 \uC870\uAC74\uC774 \uC788\uC9C0![VAR 0114(004A)]",
  "\uCCAB\uC9F8! [VAR FF00(0006)]\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC5D0\uC11C \uC7A1\uC740[VAR FF00(0000)]\\n\uC57C\uC0DD \uD3EC\uCF13\uBAAC\uB9CC\uC744 \uC0AC\uC6A9\uD560 \uAC83![VAR 0114(004A)]",
  "\uB458\uC9F8! [VAR FF00(0006)]\uC790\uC2E0\uC774 \uC7A1\uC740[VAR FF00(0000)]\\n\uD3EC\uCF13\uBAAC\uB9CC\uC744 \uC0AC\uC6A9\uD560 \uAC83![VAR 0114(004A)]",
  "\uC870\uAC74\uC5D0 \uB9DE\uC9C0 \uC54A\uB294 \uD3EC\uCF13\uBAAC\uC744\\n\uC9C0\uB2C8\uACE0 \uC788\uC73C\uBA74 \uB3C4\uC804\uD560 \uC218 \uC5C6\uC5B4.[VAR 0114(004A)]",
  "\uADC0\uCC2E\uB2E4\uACE0 \uC0DD\uAC01\uD560\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uC9C0\uAE08\uAE4C\uC9C0 \uD0A4\uC6CC \uB454 \uB140\uC11D\uB4E4\uB85C\\r\\n\uC190\uC27D\uAC8C \uC774\uAE30\uBA74 \uC7AC\uBBF8\uC5C6\uC796\uC544![VAR 0114(004A)]",
  "\uBB3C\uB860 \uC0C1\uB300\uB3C4 \uAC19\uC740 \uC870\uAC74\uC73C\uB85C\\n\uC5F4\uC2EC\uD788 \uC900\uBE44\uD588\uC73C\uB2C8\uAE4C \uC774\uD574\uD558\uB77C\uACE0.[VAR 0114(004A)]",
  "\uC790, \uADF8\uB7FC [VAR 1100(00FF,0303)]\uBE0C\uB77C\uB354\uC2DC\uC2A4\uD130.\\n\uC0AC\uCC9C\uC655 \uCC4C\uB9B0\uC9C0\uB97C \uC2DC\uC791\uD560 \uC900\uBE44\uB294 \uB410\uC5B4!?[VAR 0114(004A)]",
  "\uB3C4\uC804\uD55C\uB2E4!",
  "\uC124\uBA85\uC744 \uB4E3\uB294\uB2E4",
  "\uADF8\uB9CC\uB454\uB2E4",
  "\uC624\uCF00\uC774!\\n\uADF8\uB7FC \uB098\uC640\uB77C, \uD6C4\uBC30\uB4E4![VAR 0114(004A)]",
  "\u3000\u3000\u3000\u3000\u3000\u3000\u3000\uC798 \uBD80\uD0C1\uD574!\\n\uBC18\uAC00\uC6CC~!\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\uC5F4\uC2EC\uD788 \uD574 \uBCF4\uC790![VAR 0114(004D)]",
  "\uB0B4 \uCC4C\uB9B0\uC9C0\uB294 \uB290\uC2A8~\uD55C \uAC8C \uC2E0\uC870\uB2C8\uAE4C[VAR 0114(004A)]",
  "\uACE7\uC7A5 \uC2B9\uBD80\uB97C \uC2DC\uC791\uD574\uB3C4 \uC88B\uACE0![VAR 0114(004A)]",
  "\uB3D4\uC744 \uB3CC\uC544\uB2E4\uB2C8\uBA70\\n\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC544\uB3C4 \uC88B\uC544![VAR 0114(004A)]",
  "\uADF8\uB7FC \uB290\uC2A8~\uD558\uAC8C!\\n\uC5F4\uC2EC\uD788 \uD574 \uBD10![VAR 0114(004A)]",
  "\uACE7\uC7A5 \uC2B9\uBD80\uB97C \uC2DC\uC791\uD574\uB3C4 \uC88B\uACE0\\n\uAE30\uBD84 \uC804\uD658 \uC0BC\uC544 \uB2E4\uB978 \uACF3\uC5D0 \uB2E4\uB140\uC640\uB3C4 \uB3FC!\\r\\n\uB290\uC2A8~\uD558\uAC8C \uC5F4\uC2EC\uD788 \uD574 \uBD10![VAR 0114(004A)]",
  "\uB098\uB294 \uD68C\uC0C9 \uD3EC\uCF13\uBAAC\uC774 \uC815\uB9D0 \uC88B\uC544!\\n\uB098\uB791 \uC2B9\uBD80\uD560\uB798?",
  "\uC774\uB7F0~ \uB108, \uC870\uAC74\uC5D0 \uC548 \uB9DE\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uB370\uB9AC\uACE0 \uC788\uB294 \uAC83 \uAC19\uC740\uB370!\\c\\n\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC5D0\uC11C!\\n\uC9C1\uC811 \uC7A1\uC740 \uD3EC\uCF13\uBAAC\uB9CC \uB370\uB9AC\uACE0 \uC788\uC5B4\uC57C \uD574!",
  "\uC88B\uC558\uC5B4! \uADF8\uB7FC, \uC798 \uBD80\uD0C1\uD574~!",
  "\uB0A8\uC740 \uBC30\uD2C0\uB3C4 \uC5F4\uC2EC\uD788 \uD574!\\n\uB098\uB3C4 \uC751\uC6D0\uD560\uAC8C!",
  "\uB098\uB294 \uAF64 \uCFE8\uD558\uB2E4\uAD6C...\\n\uCD94\uC704\uC5D0 \uB5A8 \uC900\uBE44\uB294 \uB410\uACA0\uC9C0?",
  "\uC751? \uB108, \uC870\uAC74\uC5D0 \uC548 \uB9DE\uB294\\n\uD3EC\uCF13\uBAAC\uC744 \uB370\uB9AC\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544.\\c\\n\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC5D0\uC11C!\\n\uC9C1\uC811 \uC7A1\uC740 \uD3EC\uCF13\uBAAC\uB9CC \uB370\uB9AC\uACE0 \uC640!",
  "\uD6C4\uD6C4... \uADF8\uB7FC, \uC798 \uBD80\uD0C1\uD574!",
  "\uCD94\uC704\uC5D0 \uC9C0\uC9C0 \uB9D0\uACE0 \uACC4\uC18D \uC5F4\uC2EC\uD788 \uD574.\\n\uB098\uB3C4 \uCFE8\uD558\uAC8C \uC751\uC6D0\uD558\uACE0 \uC788\uC744 \uD14C\uB2C8\uAE4C...",
  "\uBAA8\uC57C\uBAA8\uB77C\uB294 \uC2A4\uD2B8\uB9AC\uBA38 \uC54C\uC544?\\n\uADF8\uBD84\uC758 \uD0C0\uC785\uC73C\uB85C \uC2F8\uC6B8 \uAC70\uC57C!",
  "\uB108\uC758 \uD3EC\uCF13\uBAAC \uC911\uC5D0\\n\uC870\uAC74\uC5D0 \uC548 \uB9DE\uB294 \uD3EC\uCF13\uBAAC\uC774 \uC788\uB294 \uAC83 \uAC19\uC740\uB370?\\c\\n\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC5D0\uC11C!\\n\uC9C1\uC811 \uC7A1\uC740 \uD3EC\uCF13\uBAAC\uB9CC \uB370\uB9AC\uACE0 \uC640\uC57C \uD574!",
  "\uCC0C\uB9BF\uD558\uACE0 \uC9DC\uB9BF\uD55C \uC2B9\uBD80\uB97C \uBD80\uD0C1\uD560\uAC8C!",
  "\uB0A8\uC740 \uBC30\uD2C0\uB3C4 \uD798\uB0B4!\\n\uC9DC\uB9BF\uD55C \uBC30\uD2C0\uC744 \uAE30\uB300\uD560\uAC8C!",
  "\uADF8\uB7EC\uB2C8\uAE4C...\\n\uBC29\uAE08 \uC2B9\uBD80\uB85C \uD558\uB098, \uB458, \uC14B...[VAR 0114(004A)]",
  "\uC624! \uC5B4\uB290\uC0C8 \uC804\uBD80 \uC774\uACBC\uB124![VAR 0114(004A)]",
  "\uADF8\uB7FC, \uC0AC\uCC9C\uC655 \uCC4C\uB9B0\uC9C0\uB294\\n\uC774\uAC78\uB85C \uB9C8\uCE60\uAC8C![VAR 0114(004A)]",
  "\uB9AC\uADF8\uBD80 \uC81C\uAD70\uB4E4\uC740 \uC5EC\uAE30\uC11C \uD1F4\uC7A5!\\n\uB6F0\uC5B4~\uAC00![VAR 0114(004A)]",
  "\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\uC798 \uC788\uC5B4~!\\n\uC218\uACE0\uD588\uC5B4~!\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\uBC14\uC774 \uBC14\uC774![VAR 0114(004D)]",
  "\uC815\uB9D0\uC774\uC9C0\\n\uC21C\uC218\uD558\uACE0 \uADC0\uC5EC\uC6B4 \uB140\uC11D\uB4E4\uC774\uB77C\uB2C8\uAE4C.[VAR 0114(004A)]",
  "\uC0AC\uCC9C\uC655 \uCC4C\uB9B0\uC9C0, \uD798\uB0B4\uC138\uC694!"
]
