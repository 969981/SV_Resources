[
  "\uD558\uC774~[VAR 0114(001C)]",
  "\uB9AC\uD30C\uC758 \uB9C8\uBC95\uC5D0 \uAC78\uB9AC\uACE0 \uC2F6\uC740 \uC0AC\uB78C\uC740 \uB204\uAD6C?[VAR 0114(001C)]",
  "\uD6C4\uD6C4! [VAR 0100(0000)].\\n\uC815\uB9D0 \uC624\uB79C\uB9CC\uC774\uB124~[VAR 0114(001C)]",
  "\uB9AC\uD30C\uB294 [VAR 0100(0000)]\uC758 \uD638\uCD9C\uC774\uB77C\uB294\\n\uC774\uC57C\uAE30\uB97C \uB4E3\uACE0[VAR 0114(001C)]",
  "\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB97C \uBD88\uB7EC\uC11C\\n\uC3DC\uC0B4\uAC19\uC774 \uB0A0\uC544\uC654\uB2E4\uACE0.[VAR 0114(001C)]",
  "\uB9AC\uD30C\uC758 \uC218\uC5C5... \uD559\uC0DD\uB4E4\uC5D0\uAC8C\uB294 \uC870\uAE08\\n\uC790\uADF9\uC774 \uAC15\uD560 \uD150\uB370 \uAD1C\uCC2E\uC744\uAE4C?[VAR 0114(001C)]",
  "\uB098\uC911\uC5D0 \uBB34\uC2A8 \uC77C \uC0DD\uAE30\uBA74\\n\uCC45\uC784\uC838 \uC8FC\uB294 \uAC70\uB2E4?[VAR 0114(001C)]",
  "\uD6C4\uD6C4\uD6C4...\\n\uB4E0\uB4E0\uD55C \uB9AC\uD30C\uC758 \uAE30\uC0AC\uB2D8\uC774\uB124.\\r\\n\uB18D\uB2F4\uC774\uB2C8\uAE4C \uAC71\uC815\uD558\uC9C0 \uB9C8.[VAR 0114(001C)]",
  "\uD6C4\uD6C4\uD6C4...\\n\uAC71\uC815\uD558\uB294 \uBAA8\uC2B5\uC774 \uADC0\uC5FD\uB124.\\r\\n\uB18D\uB2F4\uC774\uB2C8\uAE4C \uAC71\uC815\uD558\uC9C0 \uB9C8.[VAR 0114(001C)]",
  "\uB610 \uBD88\uB7EC \uC8FC\uB2E4\uB2C8\\n\uC815\uB9D0 \uC601\uAD11\uC778\uAC78.[VAR 0114(001C)]",
  "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8, [VAR 0100(0000)].\\n\uB9AC\uD30C\uAC00 \uBB34\uC2A8 \uC77C\uC744 \uD558\uB294\uC9C0 \uAE30\uC5B5\uD558\uACE0 \uC788\uC5B4?[VAR 0114(001C)]",
  "\uC5EC\uAC1D\uAE30 \uC2B9\uBB34\uC6D0",
  "\uB124\uC774\uCC98 \uC544\uD2F0\uC2A4\uD2B8",
  "\uBA54\uC774\uD06C\uC5C5 \uC544\uD2F0\uC2A4\uD2B8",
  "\uB178\uB178, [VAR 0100(0000)].\\n\uD655\uC2E4\uD788 \uC2B9\uBB34\uC6D0\uB3C4 \uC798 \uC5B4\uC6B8\uB9AC\uACA0\uC9C0\uB9CC\\c\\n\uB9AC\uD30C\uB294 \uBA54\uC774\uD06C\uC5C5 \uC544\uD2F0\uC2A4\uD2B8\uC57C.\\n\uC774\uC820 \uC78A\uC73C\uBA74 \uC548 \uB3FC![VAR 0114(001C)]",
  "\uB178\uB178, [VAR 0100(0000)].\\n\uADF8\uAC74 \uC774\uC0C1\uD55C \uC608\uC220\uAC00\uC758 \uBCC4\uBA85\uC774\uACE0\\c\\n\uB9AC\uD30C\uB294 \uBA54\uC774\uD06C\uC5C5 \uC544\uD2F0\uC2A4\uD2B8\uC57C.\\n\uC774\uC820 \uC78A\uC73C\uBA74 \uC548 \uB3FC![VAR 0114(001C)]",
  "\uACE0~\uC800\uC2A4!\\n\uB9AC\uD30C\uB294 \uBA54\uC774\uD06C\uC5C5 \uC544\uD2F0\uC2A4\uD2B8\uC57C!\\c\\n\uBAA8\uB378\uACFC \uCCB4\uC721\uAD00 \uAD00\uC7A5\uB3C4\\n\uACB8\uC5C5\uC73C\uB85C \uD558\uACE0 \uC788\uC9C0\uB9CC.[VAR 0114(001C)]",
  "\uC5EC\uAE30\uC5D0\uB294 \uBAA8\uB974\uB294 \uC0AC\uB78C\uB4E4\uC774 \uB9CE\uC544\uC11C\\n\uB9AC\uD30C\uC758 \uC9C1\uC5C5\uC744 \uAC00\uB974\uCCD0 \uC8FC\uBA74\\r\\n\uB2E4\uB4E4 \uAD00\uC2EC \uC788\uC5B4 \uD558\uB354\uB77C.[VAR 0114(001C)]",
  "\uD314\uB370\uC544\uC5D0\uC11C\uB294 \uC720\uBA85\uC778\uC73C\uB85C \uD1B5\uD588\uB294\uB370\\n\uD574\uC678\uC5D0\uC11C\uB294 \uB9AC\uD30C\uB3C4 \uC544\uC9C1 \uBA40\uC5C8\uB098 \uBD10.[VAR 0114(001C)]",
  "\uC774\uB807\uAC8C \uB41C \uAC70 \uB9AC\uD30C\uC758 \uC544\uB984\uB2E4\uC6C0\uC758 \uBE44\uACB0\uC744\\n\uC138\uACC4\uC5D0 \uD480 \uD328\uD0A4\uC9C0\uB85C \uC804\uD30C\uD574\uC57C\uACA0\uC5B4![VAR 0114(001C)]",
  "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8, [VAR 0100(0000)].\\n\uB9AC\uD30C\uC640 \uD55C \uC57D\uC18D, \uAE30\uC5B5\uD558\uACE0 \uC788\uC5B4?[VAR 0114(001C)]",
  "\uC5F0\uC0C1\uC758 \uC5B4\uB4DC\uBC14\uC774\uC2A4\uB97C\\n\uAE30\uC5B5\uD558\uB2E4\uB2C8, \uAE30\uD2B9\uD55C\uAC78?[VAR 0114(001C)]",
  "\uADF8\uB7F0 \uB9F9\uD55C \uCE90\uB9AD\uD130\uB3C4 \uADC0\uC5FD\uAE34 \uD558\uC9C0\uB9CC...\\n\uBD10\uC8FC\uB294 \uAC74 \uC774\uBC88\uBFD0\uC774\uC57C.[VAR 0114(001C)]",
  "\uC7AC\uB2A5\uC744 \uD55C\uACC4\uAE4C\uC9C0 \uB04C\uC5B4\uC62C\uB824\uC11C\\n\uACC4\uC18D \uB208\uBD80\uC2DC\uAC8C \uBE5B\uB098\uB2EC\uB77C\uACE0 \uC57D\uC18D\uD588\uC9C0...[VAR 0114(001C)]",
  "\uADFC\uB370, \uAD1C\uD55C \uAC71\uC815\uC774\uC5C8\uB098 \uBD10!\\n\uC624\uD788\uB824... \uD6C4\uD6C4!\\r\\n\uB9AC\uD30C\uB97C \uAE5C\uC9DD \uB180\uB77C\uAC8C \uD560 \uC815\uB3C4\uC600\uC5B4.[VAR 0114(001C)]",
  "\uC5B4\uB54C? \uC880 \uB354 \uC5B4\uB978\uC774 \uB418\uACE0 \uB098\uBA74\\n\uB9AC\uD30C\uC758 \uD68C\uC0AC\uC5D0 \uC624\uC9C0 \uC54A\uACA0\uC5B4?\\r\\n\uB108\uB77C\uBA74 \uC138\uACC4\uB3C4 \uB178\uB824\uBCFC \uC218 \uC788\uC744 \uAC70\uC57C.[VAR 0114(001C)]",
  "\uC798 \uBD80\uD0C1\uB4DC\uB824\uC694!",
  "\uC5B4\uB5A1\uD558\uC9C0...?",
  "\uD6C4\uD6C4!\\n\uB300\uB2F5\uC740 \uB098\uC911\uC5D0 \uB4E4\uC744\uAC8C.[VAR 0114(001C)]",
  "\uB9AC\uD30C\uC640\uC758 \uC0C8\uB85C\uC6B4 \uC57D\uC18D\\n\uC808\uB300 \uC78A\uC5B4\uBC84\uB9AC\uBA74 \uC548 \uB3FC.[VAR 0114(001C)]",
  "\uBB34\uC2A8 \uC77C\uC774 \uC788\uC5B4\uB3C4 \uC78A\uC744 \uC218 \uC5C6\uAC8C...\\n\uB9AC\uD30C\uC640 \uCD94\uC5B5\uC744 \uB9CC\uB4E4\uC5B4 \uB458\uAE4C?[VAR 0114(001C)]",
  "...\uADF8\uB798!\\n\uB9AC\uD30C\uC640 \uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD558\uC790.[VAR 0114(001C)]",
  "\uD6C4\uD6C4\uD6C4! \uADF8\uB807\uAC8C \uB098\uC640\uC57C\uC9C0.\\n\uB9AC\uD30C\uB294 \uD558\uB290\uB77C\uAE30\uB97C \uC904\uAC8C.\\r\\n\uB108\uB294 \uC5B4\uB5A4 \uC544\uC774\uB97C \uC904\uB798?[VAR 0114(001C)]",
  "[VAR 0101(0001)][VAR 1900(0002)] \uC8FC\uB2E4\uB2C8\\n\uD6C4\uD6C4! \uBBF8\uC758\uC2DD\uC774 \uB6F0\uC5B4\uB098\uB124.\\c\\n[VAR 0100(0000)][VAR 1900(0006)]\uB77C \uC0DD\uAC01\uD558\uACE0\\n\uC0C1\uB0E5\uD558\uAC8C \uBCF4\uC0B4\uD3B4 \uC904\uAC8C.[VAR 0114(001C)]",
  "[VAR 0100(0000)]\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uB9AC\uD30C\uC758 \uD558\uB290\uB77C\uAE30\uB97C \uAD50\uD658\uD558\uB294 \uAC70\uC9C0?[VAR 0114(001C)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "...\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uC744 \uD560 \uC218 \uC5C6\uC5B4.\\c\\n\uC801\uC5B4\uB3C4 2\uB9C8\uB9AC\uB294 \uC788\uC73C\uBA74 \uC88B\uC744 \uD150\uB370...[VAR 0114(001C)]",
  "\uB9AC\uD30C\uC758 \uB9C8\uC74C\uC774 \uBC14\uB00C\uAE30 \uC804\uC5D0 \uBD80\uD0C1\uD560\uAC8C.[VAR 0114(001C)]",
  "\uD6C4\uD6C4! \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC5B4.\\n\uB9AC\uD30C\uC640 \uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD560 \uAC70\uC9C0?[VAR 0114(001C)]",
  "\uC788\uC796\uC544, [VAR 0100(0000)]. \uB9AC\uD30C\uC640 \uD568\uAED8\\n\uAD81\uADF9\uC758 \uBBF8\uB97C \uD0D0\uAD6C\uD574 \uBCF4\uC9C0 \uC54A\uC744\uB798?[VAR 0114(001C)]",
  "\uC5B4\uBA38, \uB9AC\uD30C\uC758 \uAD8C\uC720\uB97C \uAC70\uC808\uD558\uB2E4\uB2C8\\n\uB300\uB2E8\uD55C \uAC70\uBB3C\uC778\uAC78.[VAR 0114(001C)]",
  "\uD6C4\uD6C4, \uADF8\uB7FC \uC815\uD574\uC84C\uB124.\\n\uBC30\uD2C0\uCF54\uD2B8\uB85C \uAC00\uC790![VAR 0114(001C)]",
  "[~ 59]",
  "\uC544\uB984\uB2E4\uC6C0\uB3C4 \uAC15\uD568\uB3C4\\n\uC804\uBCF4\uB2E4 \uB354 \uAC15\uD55C \uB9C8\uBC95\uC774 \uAC78\uB824 \uC788\uB124![VAR 0114(001C)]",
  "...\uB9AC\uD30C\uC640\uC758 \uC57D\uC18D\\n\uC9C0\uCF1C \uC918\uC11C \uAE30\uBED0.[VAR 0114(001C)]",
  "\uB108\uB77C\uBA74 \uB9AC\uD30C\uB97C \uB6F0\uC5B4\uB118\uB294\\n\uC5C4\uCCAD\uB09C \uAC70\uBB3C\uC774 \uB420 \uC218 \uC788\uC744 \uAC83 \uAC19\uC73C\uB2C8\\r\\n\uC0B4\uC9DD \uC11C\uBE44\uC2A4\uB97C \uD574 \uC8FC\uB294 \uAC8C \uC88B\uACA0\uC9C0?[VAR 0114(001C)]",
  "\uACE0~\uC800\uC2A4\uD55C \uAC70\uB2C8\uAE4C\\n\uB098\uC911\uC5D0 \uCD9C\uC138\uD558\uBA74 \uBCF4\uB2F5\uD558\uAE30\uC57C![VAR 0114(001C)]",
  "[~ 59]",
  "\uC544\uB984\uB2E4\uC6C0\uC73C\uB85C\uB294 \uBB34\uC2B9\uBD80\uB124.\\n\uC790, \uC774\uAC74 \uC11C\uBE44\uC2A4\uC57C.[VAR 0114(001C)]",
  "\uD6C4\uD6C4, [VAR 0100(0000)].\\n\uB2E4\uC74C\uC5D0 \uB610 \uC0C1\uB300\uD574 \uC918.[VAR 0114(001C)]",
  "\uC2B9\uBD80\uC5D0\uC11C\uB3C4 \uC544\uB984\uB2E4\uC6C0\uC5D0\uC11C\uB3C4\\n\uB9AC\uD30C\uC758 \uC2B9\uB9AC\uB124.\\c\\n\uADF8\uB798\uB3C4 \uAE30\uC8FD\uC9C0 \uB9D0\uACE0\\n\uC55E\uC73C\uB85C\uB3C4 \uC798 \uBD80\uD0C1\uD574.[VAR 0114(001C)]",
  "\uB9AC\uD30C\uB294 \uC544\uC8FC \uBC14\uC05C \uC0AC\uB78C\uC774\uC9C0\uB9CC\\n[VAR 0100(0000)][VAR 1900(0003)] \uBD80\uB974\uBA74\\r\\n\uC5B8\uC81C\uB4E0\uC9C0 \uC21C\uC2DD\uAC04\uC5D0 \uAC08 \uAC70\uC57C.[VAR 0114(001C)]",
  "\uC6B4\uD5A5 \uB9D0\uC774\uC57C.\\n\uC120\uC0DD\uB2D8 \uC77C\uC740 \uC81C\uB300\uB85C \uD558\uACE0 \uC788\uC5B4?\\r\\n\uADF8 \uC560, \uC61B\uB0A0\uBD80\uD130 \uB35C\uB801\uC774\uC600\uAC70\uB4E0.[VAR 0114(001C)]",
  "\uAC19\uC740 \uC790\uC138\uB85C\\n\uC624\uB7AB\uB3D9\uC548 \uC788\uB294 \uAC74 \uC88B\uC9C0 \uC54A\uC544.\\c\\n\uADF8\uB7F4 \uB550 \uBB58 \uD558\uBA74 \uC88B\uB0D0\uACE0?\\n\uD6C4\uD6C4! \uB2F9\uC5F0\uD788 \uD76C\uB85C\uACBD\uB77D \uC5D1\uC11C\uC0AC\uC774\uC988\uC9C0.[VAR 0114(001C)]",
  "[VAR 0101(0001)][VAR 1900(0001)]\\n\uAE30\uBCF8 \uBCA0\uC774\uC2A4\uAC00 \uC815\uB9D0 \uC88B\uC740 \uAC83 \uAC19\uC544.\\r\\n\uC774\uB300\uB85C \uC544\uB984\uB2F5\uAC8C \uD0A4\uC6B0\uACA0\uC5B4.[VAR 0114(001C)]",
  "\uB9AC\uD30C\uC758 \uD558\uB290\uB77C\uAE30\uB294\\n\uC798 \uC9C0\uB0B4\uACE0 \uC788\uC5B4?\\c\\n\uACE0~\uC800\uC2A4\uD558\uACE0 \uD30C\uC6CC\uD480\uD55C \uAC8C\\n\uC815\uB9D0 \uB180\uB77C\uC6B4 \uC544\uC774\uC9C0?[VAR 0114(001C)]",
  "[VAR 0100(0000)], \uB108...\\n\uAC00\uC7A5 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC73C\uB85C\\r\\n\uB9AC\uD30C\uB97C \uC120\uD0DD\uD588\uB2E4\uBA70?\\c\\n\uADF8 \uC0AC\uB78C...\\n\uD14C\uC0AC\uAC00 \uAC00\uB974\uCCD0 \uC92C\uC5B4.\\c\\n\uB9D0\uB9CC \uD558\uBA74 \uB2F9\uC7A5\uC774\uB77C\uB3C4\\n\uAC70\uB46C \uC8FC\uB7EC \uAC14\uC744 \uD150\uB370...\\c\\n\uB9AC\uD30C\uB3C4 \uB124\uAC00 \uB9C8\uC74C\uC5D0 \uB4E4\uAC70\uB4E0.\\n\uD6C4\uD6C4...! \uC11C\uB85C \uB9C8\uC74C\uC774 \uB9DE\uC558\uB124.[VAR 0114(001C)]"
]
