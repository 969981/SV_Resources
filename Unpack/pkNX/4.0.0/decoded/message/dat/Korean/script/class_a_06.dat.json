[
  "\uC5EC\uB7EC\uBD84 \uC548\uB155~\\n\uADF8\uB7FC, \uC218\uC5C5\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C\uC694~[VAR 0114(002A)]",
  "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8, \uC911\uAC04\uACE0\uC0AC \uB54C \uC5EC\uB7EC\uBD84\uAED8\\n\uBE44\uBC00\uB85C \uBD80\uD0C1\uD588\uB358 \uC124\uBB38 \uC870\uC0AC \uB9D0\uC774\uC8E0...[VAR 0114(002A)]",
  "\uACB0\uAD6D \uAD50\uC7A5 \uC120\uC0DD\uB2D8\uAED8 \uB4E4\uCF1C\uC11C\\n\uD63C\uB098\uACE0 \uB9D0\uC558\uC9C0 \uBB50\uC608\uC694~[VAR 0114(002A)]",
  "\uC81C \uC548\uC0C9\uB9CC \uBD10\uB3C4\\n\uBB54\uAC00 \uC228\uAE30\uACE0 \uC788\uB2E4\uB294 \uAC8C \uBCF4\uC774\uC2E0\uB2E4\uB098...[VAR 0114(002A)]",
  "\uC81C \uC548\uC0C9\uC774 \uADF8\uB807\uAC8C\\n\uD3C9\uC18C\uC640 \uB2EC\uB790\uB358 \uAC78\uAE4C\uC694...?[VAR 0114(002A)]",
  "\uC548\uC0C9\uC774\uB77C... \uBAB8\uC758 \uC0C9...\\n\uADF8\uB807\uC9C0, \uC624\uB298\uC740 \uD3EC\uCF13\uBAAC\uC758\\r\\n\uBAB8\uC758 \uC0C9\uC5D0 \uB300\uD574 \uBC30\uC6CC \uBCFC \uAC70\uC608\uC694~[VAR 0114(002A)]",
  "\uD3EC\uCF13\uBAAC \uC911\uC5D0\uB294\\n\uC131\uBCC4\uC774\uB098 \uAC1C\uCCB4\uC5D0 \uB530\uB77C \uBAB8\uC758 \uC0C9\uC774\uB098 \uBB34\uB2AC\uAC00\\r\\n\uC57D\uAC04\uC529 \uB2E4\uB978 \uACBD\uC6B0\uAC00 \uC874\uC7AC\uD558\uB294\uB370,[VAR 0114(002A)]",
  "\uB9E4\uC6B0 \uB4DC\uBB3C\uAC8C \uB2E4\uB978 \uAC1C\uCCB4\uC640\uB294\\n\uB2E4\uB978 \uC0C9\uC18C\uB97C \uB9CE\uC774 \uAC00\uC9C4\\r\\n\uAC1C\uCCB4\uAC00 \uD0DC\uC5B4\uB0A0 \uB54C\uB3C4 \uC788\uC5B4\uC694~[VAR 0114(002A)]",
  "\uADF8\uB7F0 \uD3EC\uCF13\uBAAC\uB4E4\uC744 \uC6B0\uB9AC\uB294\\n[VAR FF00(0006)]\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC[VAR FF00(0000)]\uC774\uB77C \uBD88\uB7EC\uC694.[VAR 0114(002A)]",
  "\uADF8\uB4E4\uC744 \uB9CC\uB098\uAE30\uB294\\n\uB9E4\uC6B0 \uB4DC\uBB38 \uC77C\uC774\uC9C0\uB9CC \uB9D0\uC774\uC8E0.[VAR 0114(002A)]",
  "\uC790 \uADF8\uB7FC, \uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC774\\n\uC5B4\uB290 \uC815\uB3C4\uC758 \uD655\uB960\uB85C \uC874\uC7AC\uD558\uB294\uC9C0\\r\\n\uB204\uAD6C \uC544\uB294 \uC0AC\uB78C~?[VAR 0114(002A)]",
  "40\uB9C8\uB9AC\uC5D0 \uD558\uB098",
  "400\uB9C8\uB9AC\uC5D0 \uD558\uB098",
  "4000\uB9C8\uB9AC\uC5D0 \uD558\uB098",
  "40\uB9C8\uB9AC\uC5D0 \uD558\uB098\uAF34\uB85C \uB9CC\uB0A0 \uC218 \uC788\uC73C\uBA74\\n\uC5F0\uAD6C\uAC00 \uC220\uC220 \uD480\uB824\uC11C \uAE30\uC060 \uAC83 \uAC19\uC9C0\uB9CC,\\r\\n\uADF8\uAC83\uBCF4\uB2E4\uB294 \uD6E8~\uC52C \uB4DC\uBB38 \uD655\uB960\uC774\uC5D0\uC694.[VAR 0114(002A)]",
  "\uC624\uC624, \uB0A0\uCE74\uB85C\uC6B4 \uB300\uB2F5\uC778\uB370\uC694~?\\n400\uB9C8\uB9AC\uC5D0 \uD558\uB098\uB3C4 \uD76C\uADC0\uD558\uAE34 \uD558\uC9C0\uB9CC,\\r\\n\uADF8\uBCF4\uB2E4\uB294 \uC880 \uB354 \uD76C\uADC0\uD55C \uD655\uB960\uC774\uC5D0\uC694.[VAR 0114(002A)]",
  "\uC624\uC624! \uC815\uB2F5\uC774\uC5D0\uC694!\\n[VAR 0100(0000)][VAR 1900(0001)] \uB098\uC911\uC5D0\\r\\n\uD3EC\uCF13\uBAAC \uBC15\uC0AC\uAC00 \uB420 \uC218\uB3C4 \uC788\uACA0\uB294\uB370\uC694![VAR 0114(002A)]",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB0A0 \uD655\uB960\uC740\\n\uBB34\uB824 4000\uB9C8\uB9AC\uC5D0 \uD558\uB098\uB78D\uB2C8\uB2E4![VAR 0114(002A)]",
  "\uC57C\uC0DD\uC5D0\uC11C \uB9CC\uB0A0 \uD655\uB960\uB3C4\\n\uC54C\uC5D0\uC11C \uD0DC\uC5B4\uB0A0 \uD655\uB960\uB3C4 \uBAA8\uB450 \uB611\uAC19\uC544\uC694~[VAR 0114(002A)]",
  "\uB300\uC2E0, \uB2E4\uB978 \uC5B8\uC5B4\uB97C \uC0AC\uC6A9\uD558\uB294 \uC9C0\uC5ED\uC5D0\uC11C \uC790\uB780\\n\uD3EC\uCF13\uBAAC\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uBC1C\uACAC\uB41C \uC54C\uC740[VAR 0114(002A)]",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC73C\uB85C \uD0DC\uC5B4\uB0A0 \uD655\uB960\uC774\\n\uD3C9\uC18C\uBCF4\uB2E4 \uB192\uB2E4\uACE0 \uD574\uC694.[VAR 0114(002A)]",
  "\uADF8 \uC774\uC720\uB294 \uC544\uC9C1\\n\uC815\uD655\uD558\uAC8C \uBC1D\uD600\uC9C0\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uB9D0\uC774\uC5D0\uC694.[VAR 0114(002A)]",
  "\uADF8\uB9AC\uACE0, \uC9C0\uB2C8\uACE0\uB9CC \uC788\uC5B4\uB3C4\\n\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB098\uAE30 \uC26C\uC6CC\uC9C0\uB294\\r\\n\uBD80\uC801\uC774 \uC788\uB2E4\uB294 \uC598\uAE30\uB3C4 \uC788\uC5B4\uC694...[VAR 0114(002A)]",
  "\uACFC\uD559\uC801\uC774\uC9C0\uB294 \uC54A\uC9C0\uB9CC\\n\uADF8\uAC8C \uC9C4\uC9DC\uB77C\uBA74 \uC7AC\uBBF8\uC788\uACA0\uB124\uC694~[VAR 0114(002A)]",
  "\uC544, \uBC8C\uC368 \uC885\uC774...[VAR 0114(002A)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0!\\n\uB2E4\uB4E4 \uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4~[VAR 0114(002A)]"
]
