  "[VAR 0100(0000)]![VAR 0114(001E)]",
  "\uAD50\uC7A5 \uC120\uC0DD\uB2D8 \uB9DE\uC8E0?",
  "\uB124\uB974\uCF00 \uB2D8?",
  "\uC9C0\uAE08\uC758 \uB098\uB294 \uB124\uB974\uCF00\uC57C.\\n\uADF8\uB807\uAC8C\uB9CC \uC54C\uC544 \uC918.[VAR 0114(001E)]",
  "\uADF8\uB798, \uC9C0\uAE08\uC758 \uB098\uB294 \uB124\uB974\uCF00.\\n\uC801\uC751\uB825\uC774 \uB6F0\uC5B4\uB09C\uAC78?[VAR 0114(001E)]",
  "\uB9C8\uCE68 \uC798\uB410\uAD70...\\n\uC9C0\uB09C\uBC88\uC5D0 \uD558\uB358 \uC774\uC57C\uAE30\uB97C \uB9C8\uC800 \uB4E4\uB824\uC904\uAC8C.[VAR 0114(001E)]",
  "\uB0B4\uAC00 \uC2A4\uD0C0\uB354\uC2A4\uD2B8 \uB300\uC791\uC804\uC5D0 \uCC38\uAC00\uD558\uACE0 \uC788\uB294 \uAC74\\n\uC2A4\uD0C0\uB2E8\uC5D0\uAC8C \uC0DD\uAE34 \uBB38\uC81C\uC640\\r\\n\uADF8 \uC218\uC218\uAED8\uB07C\uB97C \uBC1D\uD600\uB0B4\uAE30 \uC704\uD574...[VAR 0114(001E)]",
  "\uB2E4\uC2DC \uB9D0\uD574, \uC2A4\uD0C0\uB2E8\uC5D0 \uAC00\uC785\uD55C \uD559\uC0DD\uB4E4\uC774\\n\uB4F1\uAD50\uB97C \uAC70\uBD80\uD558\uB294 \uC774\uC720\uB97C \uC54C\uAE30 \uC704\uD574\uC11C\uC57C.[VAR 0114(001E)]",
  "\uB2E8\uC744 \uD574\uC0B0\uC2DC\uD0A4\uACE0 \uC2F6\uC5B4 \uD558\uB294 \uCE74\uC2DC\uC624\uD398\uC544\uC640\uB294\\n\uC774\uD574\uAD00\uACC4\uAC00 \uB9DE\uAE30\uB3C4 \uD558\uACE0.[VAR 0114(001E)]",
  "\uC2E4\uC81C\uB85C \uB108\uC640 \uD568\uAED8\\n\uC2A4\uD0C0\uB354\uC2A4\uD2B8 \uB300\uC791\uC804\uC5D0 \uCC38\uAC00\uD55C \uB355\uBD84\uC5D0\\r\\n\uC2A4\uD0C0\uB2E8\uC5D0 \uC811\uADFC\uD560 \uC218 \uC788\uC5C8\uC5B4.[VAR 0114(001E)]",
  "\uB2E8\uC758 \uB140\uC11D\uB4E4\uACFC \uC774\uC57C\uAE30\uD574\uC11C\\n\uC54C\uC544\uB0B8 \uAC83\uB3C4 \uC788\uACE0 \uB9D0\uC774\uC57C.[VAR 0114(001E)]",
  "\uD558\uC9C0\uB9CC, \uC880 \uB354 \uC815\uBCF4\uAC00 \uD544\uC694\uD574.[VAR 0114(001E)]",
  "\uADF8\uB7EC\uB2C8 \uB098\uBA38\uC9C0 \uD300\uC758\\n\uC2A4\uD0C0\uB2E8 \uC544\uC774\uB4E4\uACFC\uB3C4 \uC774\uC57C\uAE30\uD574 \uBCF4\uACE0 \uC2F6\uC5B4.[VAR 0114(001E)]",
  "\uB2E4\uC74C \uC544\uC9C0\uD2B8\uC5D0 \uB3C4\uC804\uD560 \uB54C\uB3C4 \uB0B4\uAC00 \uB3C4\uC640\uC904\uAC8C.\\n\uADF8\uB7FC \uB610 \uBCF4\uC790, [VAR 0100(0000)].[VAR 0114(001E)]"
]
