[
  "\uD314\uC790\uD06C\uC785\uB2C8\uB2E4.\\n\uC624\uB298 \uC218\uC5C5\uB3C4 \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC911\uAC04\uACE0\uC0AC\uB294 \uB2E4\uB4E4\\n\uD6CC\uB96D\uD558\uAC8C \uC784\uD574 \uC8FC\uC168\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uADF8\uB798\uC11C, \uC5F4\uC2EC\uD788 \uB178\uB825\uD574 \uC8FC\uC2E0 \uC5EC\uB7EC\uBD84\uC744 \uC704\uD574\\n\uD2B9\uBCC4 \uAC8C\uC2A4\uD2B8\uB97C \uBAA8\uC168\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uB4E4\uC5B4\uC624\uC2DC\uC9C0\uC694, \uCF5C\uC0AC \uB2D8.[VAR 0114(0012)]",
  "\uC2E4\uB840\uD558\uACA0\uB2E4![VAR 0114(002C)]",
  "\uB0B4 \uC774\uB984\uC740 \uCF5C\uC0AC.\\n\uD480\uD3EC\uCF13\uBAAC \uC804\uBB38 \uC608\uC220\uAC00\uC9C0![VAR 0114(0017)]",
  "\uC870\uAC01 \uAC19\uC740 \uC785\uCCB4 \uC791\uD488\uC744 \uC911\uC2EC\uC73C\uB85C\\n\uD65C\uB3D9\uD558\uACE0 \uACC4\uC2E0 \uCF5C\uC0AC \uB2D8\uC785\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC720\uBA85\uD55C \uC791\uD488\uC73C\uB85C\uB294 \uBCF4\uC6B8\uB9C8\uC744\uC5D0 \uC788\uB294\\n\u201C\uD574\uB8E8\uBBF8\uC758 \uCCB4\uB150\u201D\uC774 \uC788\uACA0\uB124\uC694.[VAR 0114(0012)]",
  "\uBCF4\uC6B8\uCCB4\uC721\uAD00\uC5D0 \uB3C4\uC804\uD55C \uBD84\uB4E4\uC774\uC2DC\uB77C\uBA74\\n\uC774\uBBF8 \uB9CE\uC774 \uC54C\uACE0 \uACC4\uC2E4 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uD655\uC2E4\uD788 \uBA87 \uBA85\uC740\\n\uBCF8 \uC801 \uC788\uB294 \uC5BC\uAD74\uC774\uAD70.[VAR 0114(0017)]",
  "\uC790\uD06C \uC528\uC758 \uC218\uC5C5\uC744 \uB4E4\uC744 \uC218 \uC788\uB2E4\uB2C8,\\n\uB108\uD76C\uB294 \uB300\uB2E8\uD55C \uD589\uC6B4\uC544\uB4E4\uC774\uB2E4.[VAR 0114(0017)]",
  "\uC790\uD06C \uC528\uB294 \uD55C\uB54C \uC778\uC0DD\uC5D0 \uC808\uB9DD\uD574\uC11C\\n\uC790\uD3EC\uC790\uAE30\uD558\uB824 \uD588\uB358 \uB098\uB97C...[VAR 0114(0017)]",
  "\uC2A4\uC2A4\uB85C\uC758 \uBAB8\uC744 \uBC14\uCCD0 \uAD6C\uC6D0\uD574 \uC8FC\uC2E0\\n\uC778\uC0DD\uC758 \uC2A4\uC2B9\uC774\uC2DC\uB2E4![VAR 0114(0017)]",
  "\uB0B4\uAC00 \uC9C0\uAE08\uC758 \uC791\uD48D\uC744 \uD655\uB9BD\uD560 \uC218 \uC788\uC5C8\uB358 \uAC83\uB3C4\\n\uB2E4 \uC790\uD06C \uC528\uAC00 \uC788\uC5C8\uAE30\uC5D0...![VAR 0114(0017)]",
  "\uCF5C\uC0AC \uB2D8...![VAR 0114(0012)]",
  "\uC61B\uB0A0\uC774\uC57C\uAE30\uB3C4 \uC88B\uC9C0\uB9CC, \uC624\uB298\uC740 \uCF5C\uC0AC \uB2D8\uB9CC\uC774\\n\uD560 \uC218 \uC788\uB294 \uC218\uC5C5\uC744 \uBD80\uD0C1\uB4DC\uB9AC\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4\uB9CC.[VAR 0114(0012)]",
  "\uC54C\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0017)]",
  "\uADF8\uB798... \uC870\uAE08 \uC804\uC5D0 \uB9D0\uD588\uB358\\n\u201C\uD574\uB8E8\uBBF8\uC758 \uCCB4\uB150\u201D\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD574 \uBCFC\uAE4C?[VAR 0114(0017)]",
  "\uD574\uB8E8\uBBF8\uC758 \uADF8 \uBAA8\uB4E0 \uAC83\uC744 \uB2EC\uAD00\uD55C \uB4EF\uD55C \uD45C\uC815\uC744\\n\uB0B4\uAC00 \uC5B4\uB5A4 \uC2EC\uC815\uC73C\uB85C \uB9CC\uB4E4\uC5C8\uB294\uC9C0\\r\\n\uC774 \uC911\uC5D0 \uC544\uB294 \uC0AC\uB78C \uC788\uB098!?[VAR 0114(0017)]",
  "\uD589\uBCF5\uD55C \uB9C8\uC74C",
  "\uC2AC\uD508 \uB9C8\uC74C",
  "\uD654\uB09C \uB9C8\uC74C",
  "\uC544\uB2C8\uC57C! \uC804\uD600 \uC544\uB2C8\uC57C!\\n...\uBAA8\uB450 \uB2E4 \uD2C0\uB838\uC5B4!![VAR 0114(0017)]",
  "\uADF8\uAC83\uC744 \uB9CC\uB4E4\uC5C8\uC744 \uB54C\uC758 \uB098\uB294\\n\uBAA8\uB4E0 \uAC83\uC744 \uD3EC\uAE30\uD55C \uACBD\uC9C0\uC5D0 \uC774\uB974\uB800\uC5C8\uB2E4![VAR 0114(0017)]",
  "\uC774\uAC83\uC774 \uC88B\uC740 \uD3C9\uAC00\uB97C \uBC1B\uC9C0 \uBABB\uD55C\uB2E4\uBA74\\n\uC608\uC220\uAC00\uB97C \uC740\uD1F4\uD558\uACA0\uB2E4\uB294 \uB9C8\uC74C\uC73C\uB85C...\\r\\n\uBC18\uCBE4 \uCCB4\uB150\uD55C \uC0C1\uD0DC\uC600\uC9C0![VAR 0114(0017)]",
  "\uADF8\uB798\uC11C \u201C\uD574\uB8E8\uBBF8\uC758 \uCCB4\uB150\u201D\uC774\uC5C8\uB358 \uAC70\uAD70\uC694.[VAR 0114(0012)]",
  "\uADF8\uB807\uC2B5\uB2C8\uB2E4, \uC790\uD06C \uC528![VAR 0114(0017)]",
  "\uC608\uC220\uAC00\uB85C\uC11C \uC544\uC9C1 \uD48B\uB0B4\uAE30\uC600\uC744 \uBB34\uB835,\\n\uB098\uB294 \uD070 \uBCD1\uC744 \uC553\uB294 \uAC83\uB3C4 \uBAA8\uC790\uB77C\\r\\n\uC2AC\uB7FC\uD504\uC5D0 \uBE60\uC838 \uCD08\uC870\uD574\uD558\uACE0 \uC788\uC5C8\uB2E4.[VAR 0114(0017)]",
  "\uBB34\uC5C7\uC744 \uB9CC\uB4E4\uC5B4\uC57C \uD314\uB9B4 \uAC83\uC778\uAC00...\\n\uB3C8\uC774\uB098 \uBA85\uC608 \uAC19\uC740 \uAC83\uC5D0\uB9CC \uC5F0\uC5F0\uD588\uC5C8\uC9C0...[VAR 0114(0017)]",
  "\uADF8\uB7F0 \uB9C8\uC74C\uAC00\uC9D0\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC9C4 \uC791\uD488\uC740\\n\uD558\uB098\uAC19\uC774 \uC584\uD30D\uD55C \uC878\uC791\uB4E4\uBFD0![VAR 0114(0017)]",
  "\uADF8\uB7EC\uB2E4 \uC790\uD06C \uC528\uB97C \uB9CC\uB09C \uB355\uBD84\uC5D0,\\n\uB098 \uC790\uC2E0\uC774 \uC5BC\uB9C8\uB098 \uC791\uC740 \uC874\uC7AC\uC778\uC9C0 \uAE68\uB2EB\uACE0...\\r\\n\uB9CE\uC740 \uAC83\uB4E4\uC5D0\uC11C \uD574\uBC29\uB420 \uC218 \uC788\uC5C8\uC9C0!![VAR 0114(0017)]",
  "...\uADF8\uB807\uAC8C \uD574\uC11C \uD0C4\uC0DD\uD55C \uAC83\uC774\\n\u201C\uD574\uB8E8\uBBF8\uC758 \uCCB4\uB150\u201D\uC778 \uAC83\uC774\uB2E4![VAR 0114(0017)]",
  "\uADF8\uB807\uAD70\uC694...\\n\uC800\uB3C4 \uCC98\uC74C \uC54C\uC558\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uAC00\uAE4C\uC6B4 \uC0AC\uC774\uC774\uAE30\uC5D0\\n\uB9D0\uD558\uC9C0 \uC54A\uB294 \uAC83\uB3C4 \uC788\uB294 \uBC95\uC774\uC9C0\uC694.[VAR 0114(0017)]",
  "\uB108\uD76C\uB4E4 \uC5ED\uC2DC \uC0AC\uCD98\uAE30\uC5D0 \uAC00\uC9C0\uACE0 \uC788\uB294\\n\uADFC\uC2EC\uC774\uB098 \uAC71\uC815\uC774 \uB9CE\uC744 \uAC83\uC774\uB2E4.[VAR 0114(0017)]",
  "\uADF8\uB7F4 \uB54C\uB294 \uADF8\uC800 \uC790\uC2E0\uC5D0\uAC8C \uC194\uC9C1\uD558\uACE0,\\n\uC790\uC720\uB86D\uAC8C \uD558\uACE0 \uC2F6\uC740 \uC77C\uC744 \uD558\uBA74 \uB418\uB294 \uAC70\uB2E4!\\r\\n...\uB0A8\uB4E4\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uC9C0 \uC54A\uB294 \uC120\uC5D0\uC11C \uB9D0\uC774\uB2E4.[VAR 0114(0017)]",
  "\uB0B4\uAC00 \uD574 \uC8FC\uACE0 \uC2F6\uC740 \uB9D0\uC740 \uC774\uC0C1\uC774\uB2E4.[VAR 0114(0017)]",
  "\uC0B4\uC9DD \uBD80\uB044\uB7EC\uC6CC\uC9C0\uB294\uAD70...\\n\uC790\uD06C \uC528, \uC800\uB294 \uADF8\uB7FC \uC774\uB9CC!\\r\\n...\uC0AC\uCD98\uAE30 \uC18C\uB144, \uC18C\uB140\uB4E4\uB3C4 \uC548\uB155\uC774\uB2E4![VAR 0114(0017)]",
  "\uCF5C\uC0AC \uB2D8! \uB2F9\uC2E0\uC774\uB780 \uC0AC\uB78C\uC740 \uB300\uCCB4...\\n\uC5B4\uCC0C \uC774\uB9AC\uB3C4 \uD6CC\uB96D\uD55C \uC218\uC5C5\uC744... \uAC00... \uAC00...[VAR 0114(0012)]",
  "\uAC10\uC0AC\uC574...\uC2B5\uB2C8\uB2E4...!![VAR 0114(0012)]",
  "\uC73C\uD750\uC5D0\uC5E5~!\\n\uC5C9 \uC5C9 \uC5C9!!\\r\\n\uD5C8\uC5C9~ \uAEBC\uC774\uAEBC\uC774\uAEBC\uC774...[VAR 0114(0012)]"
]
