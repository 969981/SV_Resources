[
  "\uC548\uB155! \uBBF8\uB798\uC758 \uCC54\uD53C\uC5B8![VAR 0114(004A)]",
  "\uBBF8\uC548 \uBBF8\uC548, \uB9CE\uC774 \uAE30\uB2E4\uB838\uC9C0?[VAR 0114(004A)]",
  "\uBE14\uB8E8\uBCA0\uB9AC\uADF8 \uC0AC\uCC9C\uC655\uC744\\n\uBAA8\uB450 \uC4F0\uB7EC\uB728\uB838\uB124![VAR 0114(004A)]",
  "\uD558\uC194\uB3C4\\n\uADF8\uB807\uAC8C\uAE4C\uC9C0 \uC57D\uD55C \uC560\uB294 \uC544\uB2C8\uC57C.\\r\\n\uC0DD\uAC01\uC774 \uB2E8\uC21C\uD574\uC11C \uADF8\uB807\uC9C0.[VAR 0114(004A)]",
  "\uD558\uC9C0\uB9CC \uADF8\uAC8C \uB610\\n\uC7A5\uC810\uC774\uAE30\uB3C4 \uD558\uB2E4\uB2C8\uAE4C.[VAR 0114(004A)]",
  "\uBD80\uD65C\uB3D9 \uB05D\uB098\uACE0 \uB2E4 \uAC19\uC774\\n\uD558\uC194\uC774 \uB9CC\uB4E0 \uBC25 \uBA39\uB294 \uAC70 \uC88B\uC558\uB294\uB370.[VAR 0114(004A)]",
  "\uADF8 \uB140\uC11D\uB3C4 \uB098\uB984\uB300\uB85C\\n\uACE0\uBBFC\uD558\uACE0 \uC788\uC5C8\uC744 \uC904\uC774\uC57C...[VAR 0114(004A)]",
  "\uB124\uB9AC\uB124\uB294 \uC5B4\uB560\uC5B4?\\n\uC7AC\uBBF8\uC788\uC5C8\uC9C0?[VAR 0114(004A)]",
  "\uB140\uC11D\uC774 \uC2DC\uC720\uB791 \uC774\uC57C\uAE30\uD558\uBA74\\n\uC2E0\uAE30\uD558\uAC8C\uB3C4 \uC8FD\uC774 \uC798 \uB9DE\uC544\uC11C\\r\\n\uADF8\uAC8C \uB610 \uC7AC\uBC0C\uB2E8 \uB9D0\uC774\uC9C0.[VAR 0114(004A)]",
  "\uB124\uB9AC\uB124\uB294...\\n\uC9C4\uC9C0\uD558\uACE0 \uACE0\uC9C0\uC2DD\uD574 \uBCF4\uC774\uC9C0\uB9CC...\\r\\n\uB0A8\uB4E4\uBCF4\uB2E4 \uD6E8\uC52C \uC12C\uC138\uD55C \uB140\uC11D\uC774\uC57C.[VAR 0114(004A)]",
  "\uADF8\uB798\uC11C \uC624\uD574\uBC1B\uAE30 \uC2ED\uC0C1\uC774\uC9C0\uB9CC\\n[VAR 0100(0000)] \uB108\uB294 \uC774\uD574\uD574 \uC92C\uC73C\uBA74 \uC88B\uACA0\uC5B4.[VAR 0114(004A)]",
  "\uD0C0\uB85C\uB294 \uADC0\uC5EC\uC6B4 \uAC83\uC744 \uB108\uBB34 \uC88B\uC544\uD55C \uB098\uBA38\uC9C0\\n\uBC30\uD2C0 \uC2E4\uB825\uAE4C\uC9C0 \uAC15\uD574\uC9C4 \uB140\uC11D\uC774\uC57C.[VAR 0114(004A)]",
  "\uC88B\uC544\uD558\uB294 \uC77C\uC774\uB77C \uB178\uB825\uC744\\n\uB178\uB825\uC73C\uB85C \uC0DD\uAC01\uD558\uC9C0 \uC54A\uB294 \uAC8C \uB300\uB2E8\uD558\uB2E4\uB2C8\uAE4C.[VAR 0114(004A)]",
  "...\uBB50, \uADF8\uB7F0 \uC810\uC740\\n[VAR 0100(0000)] \uB108\uB3C4 \uBE44\uC2B7\uD55C \uAC83 \uAC19\uC9C0\uB9CC![VAR 0114(004A)]",
  "\uAC15\uD574\uC9C0\uB294 \uB370 \uC9D1\uCC29\uD574\uC11C\\n\uC8FC\uBCC0\uB3C4 \uC790\uC2E0\uB3C4 \uBAA8\uB450 \uD76C\uC0DD\uD558\uACE0 \uC788\uB294\\r\\n\uB204\uAC00 \uC880 \uBCF4\uACE0 \uBC30\uC6E0\uC73C\uBA74 \uC88B\uACA0\uB294\uB370...[VAR 0114(004A)]",
  "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8, \uC5B4\uC9F8\uC120\uC9C0 \uD0C0\uB85C\uAC00\\n\uB098\uB9CC \uB9C9 \uB300\uD558\uB294 \uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0.\\r\\n...\uC774\uC720\uAC00 \uBB58\uAE4C?[VAR 0114(004A)]",
  "\uADF8\uB7FC...\\n\uC790, \uC774\uAC8C \uC57D\uC18D\uD55C \uBCF4\uC0C1\uC774\uC57C.[VAR 0114(004A)]",
  "\uBA3C\uC9C0\uAC00 \uC880 \uC313\uC5EC \uC788\uB294 \uAC74\\n\uC2E0\uACBD \uC4F0\uC9C0 \uB9C8.[VAR 0114(004A)]",
  "\uADF8\uAC74 \uADF8\uB807\uACE0 \uB208 \uAE5C\uC9DD\uD560 \uC0C8\uC5D0\\n\uBE14\uB8E8\uBCA0\uB9AC\uADF8\uB97C \uB4F1\uBC18\uD574 \uB0B4\uB2E4\uB2C8![VAR 0114(004A)]",
  "...\uC774\uB807\uAC8C \uB41C \uAC70\\n\uC774\uB300\uB85C \uC815\uC0C1\uAE4C\uC9C0 \uB178\uB824 \uBCF4\uC790\uACE0, [VAR 1100(00FF,0303)]\uBE0C\uB77C\uB354\uC2DC\uC2A4\uD130![VAR 0114(004A)]",
  "\uBE14\uB8E8\uBCA0\uB9AC\uADF8 \uC0AC\uCC9C\uC655\uC744\\n\uBAA8\uB450 \uC4F0\uB7EC\uB728\uB9B0 \uC790\uB9CC\uC774![VAR 0114(004A)]",
  "\uBE14\uB8E8\uBCA0\uB9AC\uADF8\uC758 \uCC54\uD53C\uC5B8\uC778\\n\uCE74\uC9C0\uC5D0\uAC8C \uB3C4\uC804\uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C![VAR 0114(004A)]",
  "\uAE30\uB2E4\uB9AC\uB290\uB77C \uC9C0\uCE58\uB294 \uC904 \uC54C\uC558\uB124.[VAR 0114(0043)]",
  "[VAR 0100(0000)]\uCE58\uACE0\uB294\\n\uC880 \uB2A6\uC740 \uAC70 \uC544\uB2C8\uC57C?\\r\\n...\uACA8\uC6B0 \uC0AC\uCC9C\uC655\uC744 \uC4F0\uB7EC\uB728\uB9AC\uB294 \uAC74\uB370.[VAR 0114(0043)]",
  "\uC774\uAC70 \uCE74\uC9C0 \uC544\uB2C8\uC57C?[VAR 0114(004A)]",
  "\uC5B4\uC9C0\uAC04\uD788\uB3C4 [VAR 0100(0000)][VAR 1900(0003)]\\n\uC2E0\uACBD \uC4F0\uC774\uB098 \uBCF4\uC9C0?[VAR 0114(004A)]",
  "...\uC81C\uBE48\uC774\uC57C\uB9D0\uB85C.[VAR 0114(0043)]",
  "\uC720\uB09C\uD788\uB3C4 [VAR 0100(0000)][VAR 1900(0002)]\\n\uB3D5\uACE0 \uC788\uC9C0 \uC54A\uC544?[VAR 0114(0043)]",
  "\uC2E0\uC785\uC0DD\uD55C\uD14C\uB294 \uCE5C\uC808\uD558\uAC8C \uB300\uD574\uC57C\uC9C0!\\n\uC778\uB958\uB294 \uBAA8\uB450 \uD328\uBC00\uB9AC \uC544\uB2C8\uACA0\uC5B4?[VAR 0114(004A)]",
  "...\uB9D0\uC740 \uC798\uD558\uB124.[VAR 0114(0043)]",
  "\uBB34\uC2A8 \uAFCD\uAFCD\uC774\uC778\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uADF8\uAC83\uB3C4 \uC774\uC81C \uACE7 \uB05D\uB0A0 \uAC70\uC57C.[VAR 0114(0043)]",
  "[VAR 0100(0000)].[VAR 0114(0043)]",
  "\uB204\uAC00 \uB354 \uAC15\uD55C\uC9C0 \uACB0\uD310\uC744 \uB0B4\uC790.[VAR 0114(0043)]",
  "\uC815\uC810\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uACA0\uC5B4.[VAR 0114(0043)]",
  "\uC774\uC81C \uACE7\uC774\uB124...\\n\uB098\uB3C4 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4.[VAR 0114(004A)]",
  "\uC815\uC0C1 \uACB0\uC804\uC744 \uC2DC\uC791\uD558\uB824\uBA74\\n\uC785\uAD6C \uC811\uC218\uCC98\uC5D0\uC11C \uC2E0\uCCAD\uD558\uBA74 \uB3FC.[VAR 0114(004A)]",
  "\uC88B\uC740 \uC77C\uC740 \uC11C\uB450\uB97C\uC218\uB85D \uC88B\uC73C\uB2C8\uAE4C\\n\uBE68\uB9AC \uAC00 \uBCF4\uC790![VAR 0114(004A)]"
