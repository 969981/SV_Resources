[
  "\uBAA8\uD1A0\uB9C8 \uB355\uBD84\uC5D0\\n\uB85C\uC2A4\uD2B8 \uC0AC\uB9C9\uC744 \uB118\uC744 \uC218 \uC788\uC5C8\uC5B4!",
  "\uD3EC\uCF13\uBAAC \uC6CC\uC2DC\uB85C\\n\uBAA8\uB798\uB97C \uAE68\uB057\uD558\uAC8C \uD138\uC5B4 \uB0B4 \uC918\uC57C\uACA0\uC5B4!",
  "\uC5B8\uC81C\uB098 \uB9C8\uB9B4\uC774\uC5C8\uC73C\uBA74 \uD574\uC11C\\n\uC9C4\uD654\uD560 \uAC83 \uAC19\uC744 \uB54C\uB9C8\uB2E4\\c\\n\u201C\uC9C4\uD654 \uCDE8\uC18C B \uBC84\uD2BC!\u201D\uC774\uB77C\uACE0\\n\uC8FC\uBB38\uC744 \uC678\uC6B0\uACE0 \uC788\uC5B4.",
  "\uCE74\uB77C\uD504\uC2DC\uD2F0\uC758 \uBC30\uD2C0\uCF54\uD2B8\uB294\\n\uAC15\uACFC \uC774\uC5B4\uC838 \uC788\uC5B4!",
  "\uC704\uB85C \uC62C\uB77C\uAC00\uACE0 \uC2F6\uB2E4\uBA74\\n\uC2B9\uAC15\uAE30 \uC55E\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uAC70\uB77C~",
  "\uC774 \uC55E\uC740 \uC218\uC2EC\uC774 \uAE4A\uC5B4!\\n\uD30C\uB3C4\uD0C0\uAE30\uB97C \uD560 \uC218 \uC788\uC73C\uBA74 \uC548\uC804\uD560 \uAC70\uC57C.",
  "\uB9C8\uB9AC\uB124\uC774\uB4DC\uB9C8\uC744\uC740 \uC0AC\uB9C9 \uB108\uBA38\uC5D0 \uC788\uC5B4!\\n\uAC08 \uC0DD\uAC01\uC774\uB77C\uBA74 \uCCA0\uC800\uD788 \uC900\uBE44\uD558\uB3C4\uB85D \uD558\uB834!",
  "\uCF54\uC778\uC744 \uAC00\uC9C0\uACE0 \uC788\uB294 \uC791\uC740 \uD3EC\uCF13\uBAAC!\\n\uAC00\uAE4C\uC774 \uAC14\uB354\uB2C8 \uCF54\uC778\uC744 \uB5A8\uC5B4\uB728\uB9AC\uACE0\\r\\n\uC5B4\uB518\uAC00\uB85C \uC0AC\uB77C\uC838 \uBC84\uB838\uC5B4! \uB300\uCCB4 \uBB50\uC600\uC744\uAE4C!?",
  "\uC9D1\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uBB50\uB97C \uC0AC\uB2E4 \uC8FC\uBA74 \uC88B\uC744\uAE4C~?",
  "\uC5B4\uC9F8\uC11C \uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uC74C\uC2DD\uC774\uB791\\n\uD3EC\uCF13\uBAAC\uC774 \uC88B\uC544\uD558\uB294 \uC74C\uC2DD\uC740 \uB2E4\uB978 \uAC78\uAE4C~?",
  "\uB9C8\uC744 \uBCBD\uC774 \uB9C8\uCE58 \uD3ED\uD3EC \uAC19\uC544!\\n\uD3ED\uD3EC\uC624\uB974\uAE30\uB97C \uC5F0\uC2B5\uD558\uAE30 \uB531\uC778\uAC78!",
  "\uD53C\uCF00\uB9C8\uC744\uC5D0\uC11C \uC654\uB294\uB370\\n\uBB3C\uC774 \uD48D\uBD80\uD574\uC11C \uAE5C\uC9DD \uB180\uB790\uC5B4!\\r\\n\uAC70\uAE30\uB294 \uBB3C\uC774 \uAF64 \uADC0\uD55C \uD3B8\uC774\uAC70\uB4E0.",
  "\uB9C8\uB9B4\uC740 \uBB3C\uD0C0\uC785\uC774\uB77C\uC11C \uADF8\uB7F0\uC9C0\\n\uBB3C\uC744 \uC88B\uC544\uD574!",
  "\uBB34\uC5C7\uC744 \uBA39\uC744\uC9C0 \uACE0\uBBFC\uB420 \uB54C\uB294\\n\uACB0\uAD6D \uC624\uB77C\uC624\uB77C\uBC18\uC810\uC5D0 \uAC00\uAC8C \uB41C\uB2E8 \uB9D0\uC774\uC9C0.",
  "\uC5EC\uAE30\uB294 \uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC\uC774\\n\uD734\uC2DD\uD558\uB294 \uACF3\uC774\uC57C.\\c\\n\uB77C\uC774\uB4DC\uD558\uACE0 \uB09C \uB4A4\uC5D0\uB294\\n\uCDA9\uBD84\uD788 \uBCF4\uC0C1\uC744 \uD574 \uC918\uC57C \uD574.",
  "\uCE74\uB77C\uD504\uC2DC\uD2F0\uB294 \uBB3C\uC758 \uB9C8\uC744!\\n\uB108\uB3C4 \uBCF4\uBA74 \uBC14\uB85C \uC774\uD574\uAC00 \uAC08 \uAC70\uC57C!",
  "\uC774 \uB9C8\uC744\uC758 \uC74C\uC2DD\uC810\uC740\\n\uAF64\uB098 \uD3C9\uAC00\uAC00 \uC88B\uC544!\\c\\n\uB300\uBD80\uBD84\uC774 \uB9C8\uB9AC\uB124\uC774\uB4DC\uB9C8\uC744\uC5D0\uC11C \uB098\uC628\\n\uC2E0\uC120\uD55C \uC2DD\uC7AC\uB8CC\uB97C \uC4F0\uACE0 \uC788\uAC70\uB4E0!",
  "\uC80A\uC5C8\uC744 \uB54C \uC2E4\uCEF7 \uC5EC\uD589\uD558\uBA74\uC11C\\n\uC0AC\uC9C4\uC744 \uC794\uB729 \uCC0D\uC5B4 \uB450\uACE0 \uC788\uC5B4.\\c\\n\uC5B8\uC820\uAC00 \uB0B4\uAC00 \uD560\uBA38\uB2C8\uAC00 \uB418\uBA74\\n\uC0AC\uC9C4\uC744 \uBCF4\uBA70 \uACFC\uAC70\uB97C \uD68C\uC0C1\uD558\uB824\uACE0!",
  "\uC774 \uB9C8\uC744\uC740 \uACE4\uD3EC\uAC01\uC774\uB77C\uB294 \uAC00\uAC8C\uAC00\\n\uC720\uBA85\uD558\uAD6C\uB098~",
  "\uB098\uB294 \uC704\uC5D0 \uC788\uB294\\n\uC0CC\uB4DC\uC704\uCE58 \uAC00\uAC8C\uC5D0 \uAC00\uACE0 \uC2F6\uC5B4~",
  "\uC9C0\uB3C4\uB97C \uC77D\uB294 \uAC8C \uC11C\uD234\uB7EC\uC11C \uADF8\uB7F0\uB370...\\n\uBD81\uCABD\uC774 \uC5B4\uB290 \uCABD\uC778\uC9C0 \uC54C\uC544?",
  "\uC9C0\uB3C4 \uC571\uC5D0 \uB179\uC0C9\uC73C\uB85C \uD45C\uC2DC\uB418\uB294 \uCABD\uC774 \uBD81\uCABD\uC774\uC57C.\\n\uAE38\uC744 \uC783\uC744 \uAC83 \uAC19\uC73C\uBA74 \uC9C0\uB3C4\uB97C \uACE0\uC815\uD558\uC9C0 \uADF8\uB798?",
  "\uCE74\uB77C\uD504\uC2DC\uD2F0\uB294 \uC808\uBCBD\uC744 \uB530\uB77C \uB9CC\uB4E4\uC5B4\uC84C\uC5B4!\\n\uADF8\uB798\uC11C \uACC4\uB2E8\uC2DD \uAD6C\uC870\uB85C \uB418\uC5B4 \uC788\uB294 \uAC70\uC57C.",
  "\uC544\uC774\uACE0, \uB9CE\uC774\uB3C4 \uC0AC \uBC84\uB838\uB124!\\n\uB2E4\uC74C\uC740 \uC5B4\uB514\uB97C \uAC00 \uBCFC\uAE4C?",
  "\uB2E4\uC74C\uC740 \uB9C8\uB9AC\uB124\uC774\uB4DC\uB9C8\uC744 \uC2DC\uC7A5\uC758 \uBB3C\uAC74\uC744\\n\uC2F9\uC4F8\uC774\uD558\uC790!",
  "\uC5EC\uAE30\uB294 \uBB3C\uC758 \uACE0\uC7A5 \uCE74\uB77C\uD504~\u266A\\n\uCE74\uB77C\uD504\uB294~ \uBB3C \uAC19\uC740 \uAC78 \uB2F4\uB294 \uBCD1~\u266A",
  "\uC2B9\uAC15\uAE30\uAC00 \uB9CC\uB4E4\uC5B4\uC9C0\uAE30 \uC804\uAE4C\uC9C0\uB294\\n\uB9C8\uC744 \uC704\uC544\uB798\uB97C \uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC\uC73C\uB85C\\r\\n\uC774\uB3D9\uD588\uC5C8\uB300! \uC815\uB9D0 \uD798\uB4E4\uC5C8\uACA0\uB2E4!",
  "\uD3EC\uCF13\uBAAC\uC744 \uD14C\uB77C\uC2A4\uD0C8\uC2DC\uD0A4\uB294\\n\uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uB294\\r\\n\uC6B0\uC218\uD55C \uC0AC\uB78C\uB9CC\uC774 \uAC00\uC9C8 \uC218 \uC788\uB300.",
  "\uD3EC\uCF13\uBAAC\uC758 \uD14C\uB77C\uC2A4\uD0C8\uC740\\n\uD314\uB370\uC544\uC9C0\uBC29\uC5D0\uC11C\uB9CC \uC77C\uC5B4\uB09C\uB2E4\uB098 \uBD10.\\r\\n\uC774\uC720\uAC00 \uB300\uCCB4 \uBB58\uAE4C?",
  "\uC77C\uBC18\uC778\uC740 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uB294\\n\uD314\uB370\uC544\uC758 \uB300\uACF5\uC5D0\uB294\\r\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uB4E4\uC774 \uC788\uC744\uAE4C?",
  "\uC5B4\uC11C \uC624\uC138\uC694! \uACE4\uD3EC\uAC01\uC785\uB2C8\uB2E4!\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uACE4\uD3EC \uB2D8\uC758 \uAC00\uAC8C\uC785\uB2C8\uB2E4!",
  "\uCE74\uB77C\uD504\uC2DC\uD2F0\uC758 \uC544\uB984\uB2E4\uC6B4 \uB9C8\uC744 \uD48D\uACBD\uC740\\n\uCD2C\uC601 \uC2A4\uD3FF\uC73C\uB85C\uB3C4 \uC778\uAE30\uAC00 \uB9CE\uC544.",
  "\uC6B0\uB9AC\uB294 \uB0B4\uB144\uBD80\uD130 \uD559\uAD50\uC5D0 \uB2E4\uB140!\\n\uCE5C\uAD6C\uB4E4\uC744 \uB9CE\uC774 \uC0AC\uADC8 \uC218 \uC788\uC744\uAE4C?",
  "\uAE30\uC219\uC0AC \uC0DD\uD65C\uC774 \uB108\uBB34 \uAE30\uB300\uB3FC!\\n\uC790\uAE30 \uC804\uC5D0 \uACFC\uC790\uB97C \uBA39\uC5B4\uB3C4 \uC548 \uD63C\uB098\uC796\uC544!",
  "\uB9C8\uC744 \uC804\uCCB4\uB97C \uD30C\uB797\uAC8C \uB9CC\uB4E4\uC5C8\uB354\uB2C8\\n\uAD00\uAD11\uAC1D\uB4E4\uC774 \uB298\uC5B4\uB0AC\uC5B4.\\c\\n\uC218\uB144 \uC804\uC5D0 \uACE4\uD3EC \uC528\uAC00 \uC81C\uC548\uD55C \uAC70\uB798.",
  "\uC624\uB298\uB3C4 \uB0B4\uC77C\uB3C4 \uB9E4\uC77C de \uC0CC\uB4DC\u266A\\n\uC0CC\uB4DC\uC704\uCE58 \uD558\uB098 \uC5B4\uB5A0\uC2E0\uAC00\uC694~?",
  "\uCE74\uB77C\uD504\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB294\\n\uBB34\uC9C0\uBB34\uC9C0\uD558\uAC8C \uC5B4\uB824\uC6CC!",
  "\uACE4\uD3EC \uC528\uB294 \uC774 \uB9C8\uC744\uC758 \uAC04\uD310\uC774\uC154!\\n\uC5B8\uC81C\uB098 \uB290\uAE0B\uD558\uACE0 \uC0C1\uB0E5\uD558\uC2E0 \uB370\uB2E4\\r\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uC77C\uC744 \uD560 \uB54C\uB294 \uBA4B\uC788\uAE30\uAE4C\uC9C0 \uD574!",
  "\uC9C0\uD615\uC758 \uAE30\uBCF5\uC774 \uC2EC\uD55C\\n\uD314\uB370\uC544\uC5D0\uC11C\uB294 \uC5B4\uB835\uACA0\uC9C0\uB9CC,\\r\\n\uC790\uC804\uAC70\uB85C \uC5EC\uD589\uD558\uB294 \uAC83\uB3C4 \uC7AC\uBBF8\uC788\uC744 \uAC83 \uAC19\uC544.",
  "\uB2E4\uB978 \uC9C0\uBC29\uC5D0\uC11C\uB294 \uBAA8\uD1A0\uB9C8 \uB9D0\uACE0\\n\uB2E4\uB978 \uD3EC\uCF13\uBAAC\uB3C4 \uD0C0\uACE0 \uB2E4\uB2CC\uB2E4\uB294\uB370 \uC815\uB9D0\uC77C\uAE4C?",
  "\uC774\uBC88 \uB2EC\uC5D0\uB294 \uC5F4\uC2EC\uD788 \uD588\uC73C\uB2C8\uAE4C...\\n\uBE44\uC2FC \uAC00\uBC29 \uC815\uB3C4\uB294 \uC0AC\uB3C4 \uB418\uC9C0 \uC54A\uC744\uAE4C!?",
  "\uAE30\uBD84 \uC804\uD658 \uC0BC\uC544 \uD5E4\uC5B4\uC2A4\uD0C0\uC77C\uC744 \uBC14\uAFD4 \uBD24\uC5B4!\\n\uC5B4\uB54C? \uADC0\uC5FD\uC9C0 \uC54A\uC544?",
  "\uADF8, \uADF8\uB7EC\uB2C8\uAE4C...\\n\uC544, \uC55E\uBA38\uB9AC\uB97C \uC790\uB978 \uAC70 \uB9DE\uC9C0?"
]
