[
  "\uC624! \uC624\uB79C\uB9CC\uC774\uB124!\\n\uBD84\uBA85 \uC774\uB984\uC774... [VAR 0100(0000)], \uB9DE\uC9C0!?[VAR 0114(001B)]",
  "\uC624\uB298\uC740 \uBB34\uC2A8 \uC77C\uC774\uC57C?\\n\uB098\uC640 \uB7A9 \uBC30\uD2C0\uC774\uB77C\uB3C4 \uD558\uB824\uACE0?[VAR 0114(001B)]",
  "\uCCB4\uC721\uAD00 \uC2DC\uCC30\uC774\uC694!",
  "\uB7A9 \uBC30\uD2C0\uC774\uC694!",
  "\uBB50\uC5B4? \uCE58\uD504\uC5D0\uAC8C \uBD80\uD0C1\uBC1B\uC544\uC11C\\n\uB098\uB97C \uC2DC\uCC30\uD558\uB7EC \uC628 \uAC70\uB77C\uACE0!?[VAR 0114(001B)]",
  "HA! HA! HA! \uB108 \uC774 \uB140\uC11D\\n\uC870\uD06C \uC218\uC900\uB3C4 \uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAD6C\uB098!?[VAR 0114(001B)]",
  "\uD760... \uB124\uAC00\\n\uD14C\uC0AC\uC758 \uB300\uB9AC\uC778\uC774\uB780 \uB9D0\uC774\uC9C0?[VAR 0114(001B)]",
  "\uC774\uC57C\uAE30\uB294 \uB300\uAC15 \uC54C\uC544\uB4E4\uC5C8\uC5B4.\\n\uADF8\uB798\uB3C4 \uC774\uB7F0 \uB8E8\uD0A4 \uCC54\uD53C\uC5B8\uC744 \uBCF4\uB0B4\uB2E4\uB2C8\\r\\n\uB098\uB97C \uB108\uBB34 \uBB3C\uB85C \uBCF4\uB294 \uAC83 \uAC19\uAD70.[VAR 0114(001B)]",
  "\uBBF8\uC548...\\n\uB531\uD788 \uB108\uC5D0\uAC8C \uC9DC\uC99D \uB0BC \uC0DD\uAC01\uC740 \uC5C6\uC5C8\uC5B4.[VAR 0114(001B)]",
  "\uBB50, \uC5B4\uCC28\uD53C \uB124\uAC00 \uBCF4\uACE0 \uC2F6\uAE34 \uD588\uACE0\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC654\uC73C\uB2C8 \uC5B4\uCA54 \uC218 \uC5C6\uB098?[VAR 0114(001B)]",
  "\uC774\uB807\uAC8C \uB41C \uAC70\\n\uB108\uC758 \uC2E4\uB825\uC744 \uD655\uC778\uD574 \uC8FC\uACA0\uC5B4.[VAR 0114(001B)]",
  "[VAR 0100(0000)]\uC758 \uC2E4\uB825\uC744\\n\uBCF4\uC5EC \uC904 \uC900\uBE44\uB294 \uB410\uC5B4?[VAR 0114(001B)]",
  "\uC88B\uC544, \uADF8\uB7FC \uC815\uD574\uC84C\uAD70!\\n\uB530\uB77C\uC640, \uAC8C\uB9B4\uB77C \uC2A4\uD14C\uC774\uC9C0\uB97C \uC2DC\uC791\uD558\uC790![VAR 0114(001B)]",
  "\uBB54\uB370, \uBC18\uB300, \uC660\uB370?\\n\uC2E4\uB9DD, \uD76C\uB9DD, \uB610 \uC624\uB77C\uACE0![VAR 0114(001B)]",
  "...\uC751? \uB098\uC640 \uC2F8\uC6B0\uB824\uBA74\\n\uC2F8\uC6B8 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774 \uB450 \uB9C8\uB9AC\uB294 \uC788\uC5B4\uC57C \uD574![VAR 0114(001B)]"
]
