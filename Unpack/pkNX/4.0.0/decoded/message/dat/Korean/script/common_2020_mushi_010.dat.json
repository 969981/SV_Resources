[
  "\uC5B4\uC11C \uC640~ \uD30C\uD2F0\uC2A4\uB9AC \uC0AC\uBCF4\uB2C8\uC5D0\uB974\uC758 \uC810\uC7A5\\n\uB2E8\uD48D\uC774\uB77C\uACE0 \uD574~[VAR 0114(0016)]",
  "\uC5B4\uBA38\uB098~ \uC18C\uBB38\uC774 \uC790\uC790\uD558\uB358\\n\uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8\uC774 \uB108\uC600\uB2C8~?[VAR 0114(0016)]",
  "\uB9DE\uC544\uC694!",
  "\uCC54\uD53C\uC5B8\uC774\uC5D0\uC694!",
  "\uB9CC\uC138~! \uC5ED\uC2DC \uB0B4 \uB208\uC774 \uC633\uC558\uB124~!\\n[VAR 0100(0000)], \uAC15\uD588\uC5C8\uC73C\uB2C8\uAE4C~[VAR 0114(0016)]",
  "\uB0B4\uAC00 \uB9CC\uB4E0 \uCEF5\uCF00\uC774\uD06C\uB3C4\\n\uC815\uB9D0 \uB9DB\uC788\uAC8C \uBA39\uC5B4 \uC92C\uACE0 \uB9D0\uC774\uC57C.\\r\\n\uADF8\uB7F0 \uC560\uB4E4\uC774 \uAF2D \uC7A0\uC7AC\uB825\uC774 \uC788\uB354\uB77C~[VAR 0114(0016)]",
  "\uC5B4\uBA38\uB098~ \uCE58\uD504 \uCC54\uD53C\uC5B8\uC758\\n\uC2EC\uBD80\uB984\uC73C\uB85C \uC5EC\uAE30 \uC628 \uAC70\uC57C~?[VAR 0114(0016)]",
  "...\uC774\uB9D8\uB54C\uCBE4 \uCE58\uD504\uC758 \uC2DC\uCC30\uC774 \uC788\uB2E4\uB294 \uAC78\\n\uC644\uC804\uD788 \uC78A\uACE0 \uC788\uC5C8\uC5B4~[VAR 0114(0016)]",
  "\uC2A4\uD0DC\uD504\uB4E4\uC5D0\uAC8C \uCF00\uC774\uD06C\uB97C \uB098\uB220 \uC8FC\uB7EC \uC628 \uB355\uBD84\uC5D0\\n\uB193\uCE58\uC9C0 \uC54A\uACE0 \uBC1B\uC744 \uC218 \uC788\uAC8C \uB410\uB124~\\r\\n...\uB7ED\uD0A4~![VAR 0114(0016)]",
  "\uADF8\uB7FC, \uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8\uC758 \uC2E4\uB825\uC744 \uD55C\uBC88\\n\uB9DB\uBCF4\uB3C4\uB85D \uD560\uAE4C~?[VAR 0114(0016)]",
  "\uC654\uAD6C\uB098~ \uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8\uC758 \uC2E4\uB825,\\n\uD55C\uBC88 \uB9DB\uBD10\uB3C4 \uB420\uAE4C~?[VAR 0114(0016)]",
  "\uC6B0\uD6C4\uD6C4, \uAE30\uB300\uB418\uB124~\\n\uADF8\uB7FC \uC7A5\uC18C\uB97C \uC62E\uAE30\uC790~[VAR 0114(0016)]",
  "\uC73C\uC751~? \uB2E4\uC74C \uAE30\uD68C\uC5D0~?\\n\uADF8\uB7FC, \uAD1C\uCC2E\uC544\uC9C0\uBA74 \uB2E4\uC2DC \uCC3E\uC544\uC640 \uC918~[VAR 0114(0016)]"
