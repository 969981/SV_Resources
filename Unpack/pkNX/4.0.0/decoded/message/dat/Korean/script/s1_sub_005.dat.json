[
  "\uC624~\uD638\uD638\uD638!\\n\uC624~\uD638\uD638\uD638![VAR 0114(0041)]",
  "\uB180\uB77C\uC6B8 \uC815\uB3C4\uB85C \uBCFC\uB9CC\uD55C \uAC83\uC774\\n\uD558\uB098\uB3C4 \uC5C6\uB294 \uC7A5\uC18C\uB124![VAR 0114(0041)]",
  "\uB0B4\uAC00 \uC6D0\uD558\uB358 \uAC8C \uBC14\uB85C \uC774\uAC70\uC57C!\\n\uB561\uD050, \uBE4C\uB9AC\uC624![VAR 0114(0041)]",
  "\uADF8\uB808\uC774\uD2B8! \uC6B0\uB9AC \uB098\uB9AC\uC544\uC758 \uAE30\uC068\uC774 \uACE7\\n\uB098\uC758 \uD589\uBCF5\uC774\uB77C\uAD6C![VAR 0114(0040)]",
  "\uC774 \uB545\uC744 \uC0AC\uB4E4\uC5EC\uC11C\\n\uC0AC\uC5C5\uC744 \uD574\uB3C4 \uAD1C\uCC2E\uC744 \uAC83 \uAC19\uC544.[VAR 0114(0041)]",
  "\uC5B4\uBA38, \uB2F9\uC2E0\uC740...\\n\uADF8\uB54C \uADF8 \uC11C\uBBFC\uB2D8![VAR 0114(0041)]",
  "\uC815\uB9D0\uC774\uAD70!\\n\uD2C0\uB9BC\uC5C6\uC774 \uADF8\uB54C \uADF8 \uC11C\uBBFC\uC774\uC57C![VAR 0114(0040)]",
  "\uC815\uB9D0\uC774\uC9C0, \uC6B0\uB9AC \uB098\uB9AC\uC544\uC758 \uCE74\uB9AC\uC2A4\uB9C8\uB294 \uD56D\uC0C1\\n\uC0AC\uB78C\uB4E4\uC744 \uB04C\uC5B4\uB4E4\uC778\uB2E4\uB2C8\uAE4C![VAR 0114(0040)]",
  "\uC624~\uD638\uD638\uD638!\\n\uACFC\uC5F0, \uADF8\uB7F0 \uAC70\uC600\uAD70\uC694![VAR 0114(0041)]",
  "\uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uAFC8\uC744 \uC120\uC0AC\uD558\uB294 \uAC83\uC774\\n\uC6B0\uB9AC \uC140\uB7FD\uB4E4\uC758 \uC758\uBB34...[VAR 0114(0041)]",
  "\uADF8\uB7EC\uB2C8 \uC774\uAC83\uC744 \uB4DC\uB9AC\uACA0\uC5B4\uC694.[VAR 0114(0041)]",
  "\uC798 \uB4E4\uC73C\uC138\uC694, \uC11C\uBBFC\uB2D8.\\n\uB3C8\uC740 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uB294 \uACF3\uC5D0 \uC874\uC7AC\uD55C\uB2F5\uB2C8\uB2E4.[VAR 0114(0041)]",
  "\uBE14\uB8E8 \uC624\uC158\uC744 \uBC1C\uACAC\uD560 \uAC00\uB2A5\uC131\uC740\\n\uC5B8\uC81C\uB4E0\uC9C0 \uC874\uC7AC\uD55C\uB2E4\uB294 \uAC70\uC608\uC694...[VAR 0114(0041)]",
  "\uD06C\uC73D! \uD30C\uACE0\uB4E0\uB2E4!\\n\uB9C8\uCE58 \uC694\uAC00 \uD6C4\uC5D0 \uB9C8\uC2DC\uB294 \uB728\uAC70\uC6B4 \uBB3C\uCC98\uB7FC\\r\\n\uAC00\uC2B4\uC18D\uC744 \uD30C\uACE0\uB4DC\uB294 \uBA85\uC5B8\uC774\uC5C8\uC5B4![VAR 0114(0040)]",
  "\uAC00\uC790, \uBE4C\uB9AC\uC624!\\n\uB098, \uBD81\uC2E0\uC758 \uACE0\uC7A5\uC5D0\uC11C \uAC13 \uC218\uD655\uD55C\\r\\n[VAR FF00(0006)]\uACFC\uC77C[VAR FF00(0000)]\uC774 \uBA39\uACE0 \uC2F6\uC5B4\uC84C\uC5B4![VAR 0114(0041)]",
  "\uC720\uD6C4~!\\n\uC5BC\uB9C8 \uC804\uC5D0 \uAC14\uB358 \uC5EC\uD589\uC9C0\uB97C \uB610 \uCC3E\uC544\uAC00\uB2E4\uB2C8!\\r\\n\uC5ED\uC2DC \uC6B0\uB9AC \uB098\uB9AC\uC544\uB294 \uC140\uB7FD\uC758 \uADC0\uAC10\uC774\uB77C\uB2C8\uAE4C![VAR 0114(0040)]",
  "\uB0B4\uAC00 \uC190\uC73C\uB85C \uC9C1\uC811 \uC9E0 \uC560\uD50C \uC8FC\uC2A4\uB97C\\n\uC2E4\uCEF7 \uB9C8\uC2DC\uAC8C \uD574 \uC8FC\uACA0\uC5B4![VAR 0114(0040)]",
  "\uB098\uB9AC\uC544 \uB2D8\uACFC \uBE4C\uB9AC\uC624 \uB2D8\uAED8\uC11C\uB294\\n\uB0A8\uBD80 \uC5D0\uB9AC\uC5B4 5\uC640 \uB0A8\uBD80 \uC5D0\uB9AC\uC5B4 1\uC758\\r\\n\uACBD\uACC4 \uBD80\uADFC\uC73C\uB85C \uAC00\uC168\uC2B5\uB2C8\uB2E4."
]
