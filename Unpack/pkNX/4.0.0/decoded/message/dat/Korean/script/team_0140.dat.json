  "\uB05D\uB0B4\uC790\uB2C8...\\n\uC2A4\uD0C0\uB2E8\uC744 \uD574\uC0B0\uD558\uACA0\uB2E4\uACE0?\\r\\n\uC9C4\uC2EC\uC73C\uB85C \uD558\uB294 \uB9D0\uC774\uC57C?[VAR 0114(0021)]",
  "\uC2A4\uD0C0 \uB300\uC791\uC804 \uB54C\uBB38\uC774\uC57C...\\n\uC6B0\uB9AC\uAC00 \uB108\uBB34 \uC2EC\uD588\uC5B4...[VAR 0114(0009)]",
  "\uBB50, \uC694\uB780\uD558\uAC8C \uC800\uC9C0\uB974\uAE34 \uD588\uC9C0.\\n\uAD34\uB86D\uD788\uB358 \uC560\uB4E4\uC744 \uAD50\uC815\uC5D0 \uBAA8\uC544 \uB193\uACE0 \uB9D0\uC774\uC57C.[VAR 0114(001F)]",
  "\uADF8\uB807\uC9C0\uB9CC \uACB0\uAD6D \uC6B0\uB9AC\uB294\\n\uC2F8\uC6C0\uC740\uCEE4\uB155 \uC544\uBB34\uAC83\uB3C4 \uC548 \uD588\uC796\uC544![VAR 0114(0022)]",
  "\uC6B0\uB9AC\uB294 \uADF8\uC800 \uAD34\uB86D\uD798\uC744 \uADF8\uB9CC\uB450\uC9C0 \uC54A\uC73C\uBA74\\n\uC2F8\uC6C0\uB3C4 \uBD88\uC0AC\uD558\uACA0\uB2E4\uB294 \uC758\uC9C0\uB97C \uBCF4\uC600\uC744 \uBFD0,\\r\\n\uD53C \uD55C \uBC29\uC6B8 \uC548 \uD758\uB9AC\uACE0 \uAC70\uB454 \uC2B9\uB9AC\uC600\uC18C.[VAR 0114(0023)]",
  "\uB9DE\uC544, \uC6B0\uB9AC\uC758 \uBAA8\uC2B5\uC744 \uBCF4\uACE0 \uAC81\uBA39\uC5C8\uB294\uC9C0,\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB294 \uD558\uC9C0\uB3C4 \uC54A\uACE0\\r\\n\uC6B8\uBA74\uC11C \uBE4C\uAE30\uB9CC \uD588\uC796\uC544.[VAR 0114(0020)]",
  "\uADF8\uB807\uC9C0\uB9CC, \uADF8 \uB4A4\uB85C \uADF8 \uC560\uB4E4 \uBAA8\uB450\\n\uAE30\uAC81\uD558\uBA74\uC11C \uB3C4\uB9DD\uAC00 \uBC84\uB838\uC796\uC544.\\r\\n\uBB38\uC81C\uAC00 \uB108\uBB34 \uCEE4\uC84C\uC5B4.\\r\\n\uC544\uCE74\uB370\uBBF8\uB3C4 \uADF8\uB0E5 \uB118\uC5B4\uAC00\uC9C0\uB294 \uC54A\uC744 \uAC70\uC57C.[VAR 0114(0009)]",
  "\uD655\uC2E4\uD788 \uACE4\uB780\uD574\uC9C8 \uC218\uB3C4 \uC788\uAE34 \uD558\uC9C0.[VAR 0114(0021)]",
  "...\uB0B4\uAC00 \uC5B4\uB5BB\uAC8C\uB4E0 \uD574 \uBCFC\uAC8C.[VAR 0114(0009)]",
  "\uC57C, \uC9C0\uAE08 \uBB34\uC2A8 \uC18C\uB9AC\uB97C \uD558\uB294 \uAC70\uC57C?[VAR 0114(001F)]",
  "\uC2A4\uD0C0\uB2E8\uC744 \uC2DC\uC791\uD55C \uAC83\uB3C4 \uB098\uACE0\\n\uBAA8\uB450\uB97C \uD718\uB9D0\uB9AC\uAC8C \uD55C \uAC83\uB3C4 \uB098\uB2C8\uAE4C.[VAR 0114(0009)]",
  "\uADF8\uB7EC\uB2C8\uAE4C \uB0B4\uAC00 \uCC45\uC784\uC744 \uC9C0\uACA0\uC5B4.[VAR 0114(0009)]",
  "...\uC9C4 \uBCF4\uC2A4 \uB098\uB9AC.[VAR 0114(0023)]",
  "\uC774\uC81C \uAD34\uB86D\uD788\uB294 \uC560\uB4E4\uB3C4 \uC5C6\uC73C\uB2C8\uAE4C\\n\uB2E4\uB4E4 \uD559\uAD50\uC5D0 \uB2E4\uB2C8\uB3C4\uB85D \uD574.[VAR 0114(0009)]",
  "\uB108\uB294 \uC5B4\uCA4C\uB824\uACE0?[VAR 0114(001F)]",
