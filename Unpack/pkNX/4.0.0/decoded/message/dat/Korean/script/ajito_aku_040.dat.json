  "\uB124\uAC00 \uD53C\uB098\uC778\uAC00?[VAR 0114(001E)]",
  "\uC640\uC6B0, \uD30C\uACA9\uC801\uC778 \uBA38\uB9AC\uC758 \uAE5C\uC9DD \uAC8C\uC2A4\uD2B8\uB85C\uAD70.\\n\uD3EC\uCF13\uBAAC\uC758 \uAE30\uC220\uB85C \uCE58\uBA74, \uC2B9\uBD80\uAD73\uD788\uAE30?[VAR 0114(0021)]",
