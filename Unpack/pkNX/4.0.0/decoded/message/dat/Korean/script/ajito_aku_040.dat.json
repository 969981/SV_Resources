  "[~ 62]",
  "\uC2A4\uD0C0\uB2E8\uC5D0\uC11C \uAC00\uC7A5 \uAC15\uD55C \uBCF4\uC2A4\uC57C.\\n\uD2B8\uB808\uC774\uB108\uB85C \uCE58\uBA74, \uCE58\uD504 \uCC54\uD53C\uC5B8 \uAC19\uC740?[VAR 0114(0021)]",
  "\uAC19\uC774 \uB2E8\uC744 \uB9CC\uB4E4\uC790\uACE0 \uD55C \uAC83\uB3C4 \uADF8 \uB140\uC11D\uC774\uC57C.\\n\uADF8\uB798\uC11C \u201C\uC9C4 \uBCF4\uC2A4\u201D\uB77C\uACE0 \uBD80\uB974\uACE0 \uC788\uC9C0.[VAR 0114(0021)]",
  "\uADF8 \uC9C4 \uBCF4\uC2A4\uB294 \uC9C0\uAE08 \uC5B4\uB514\uC5D0 \uC788\uC9C0?[VAR 0114(001E)]",
  "\uADF8\uAC78 \uC54C\uC558\uC73C\uBA74 \uC774\uB7EC\uACE0 \uC788\uACA0\uC5B4?\\n1\uB144 \uBC18 \uC815\uB3C4 \uB410\uB098? \uC5F0\uB77D\uB3C4 \uC548 \uB418\uACE0 \uC788\uB2E4\uACE0.[VAR 0114(0021)]",
  "[~ 62]",
  "\uC2A4\uD0C0\uB2E8\uC744 \uACC4\uC18D\uD558\uACE0 \uC788\uC73C\uBA74\\n\uC5B8\uC820\uAC00 \uC5F0\uB77D\uC774 \uC62C \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD588\uB294\uB370,[VAR 0114(0021)]",
  "\uC120\uC0DD\uB4E4\uC740 \uD574\uC0B0\uD558\uB77C\uACE0 \uC2DC\uB044\uB7FD\uAC8C \uAD74\uC9C0 \uC54A\uB098,\\n\uB108\uD76C \uAC19\uC740 \uB140\uC11D\uB4E4\uC774 \uB098\uD0C0\uB098\uC9C8 \uC54A\uB098...[VAR 0114(0021)]",
  "......[VAR 0114(001E)]",
  "\uC5B4\uCA4C\uBA74 \uC6B0\uB9AC\uB97C \uBC84\uB9B0 \uAC78\uC9C0\uB3C4 \uBAA8\uB974\uC9C0...\\n\uC9C4 \uBCF4\uC2A4, \uB2E8\uC744 \uD574\uC0B0\uD558\uACE0 \uC2F6\uC5B4 \uD588\uC73C\uB2C8\uAE4C...[VAR 0114(0021)]",
  "\uC9C4 \uBCF4\uC2A4\uC640 \uC2A4\uD0C0\uB2E8\uC774\\n\uADF8\uB807\uAC8C\uB098 \uC18C\uC911\uD55C \uAC74\uAC00?[VAR 0114(001E)]",
  "\uB2F9\uC5F0\uD55C \uAC78 \uBB58 \uBB3C\uC5B4\uBCF4\uACE0 \uADF8\uB798?\\n\uC544\uCE74\uB370\uBBF8\uB85C \uCE58\uC790\uBA74 \uADF8\uAC70\uB77C\uACE0.\\r\\n...\uBCF4\uBB3C?[VAR 0114(0021)]"
