[
  "\uACB0\uAD6D \uC774\uB807\uAC8C \uB418\uB294 \uAC74\uAC00...[VAR 0114(0021)]",
  "1\uB144 \uD558\uACE0 \uC218\uAC1C\uC6D4 \uC804...",
  "\uD53C\uB098, \uC65C \uADF8\uB798?[VAR 0114(0020)]",
  "\uC9C4 \uBCF4\uC2A4\uC640 \uC0C1\uC758\uD55C \uB0B4\uC6A9\uC774\\n\uAC70\uC758 \uC815\uB9AC\uB418\uC5B4 \uAC00\uACE0 \uC788\uC5B4\uC11C \uB9D0\uC774\uC57C.[VAR 0114(0021)]",
  "\uC0C1\uC758? \uBB34\uC2A8 \uC77C\uB85C?[VAR 0114(001F)]",
  "\uC77C\uB2E8 \uC2A4\uD0C0 \uB300\uC791\uC804\uC5D0 \uB300\uD55C \uAC83,\\n...\uADF8\uB9AC\uACE0 \uB2E8\uC758 \uADDC\uCE59\uC5D0 \uB300\uD55C \uAC70\uC57C.[VAR 0114(0021)]",
  "\uCD5C\uADFC\uC5D0 \uB3D9\uB8CC\uB4E4\uC774 \uB298\uC5C8\uC796\uC544.\\n\uADF8\uB798\uC11C \uB8F0\uC774\uB77C\uACE0 \uD574\uC57C \uD558\uB098,\\r\\n\uADDC\uCE59\uC774 \uD544\uC694\uD558\uB2E4\uB294 \uC774\uC57C\uAE30\uAC00 \uB098\uC640\uC11C \uB9D0\uC774\uC57C.[VAR 0114(0021)]",
  "\uC624\uC624~! \uD53C\uB098\uB77C\uBA74\\n\uC88B\uC740 \uADDC\uCE59\uC744 \uB9CC\uB4E4 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C?[VAR 0114(0022)]",
  "\uC73D, \uADF8\uB807\uAC8C \uB9D0\uD558\uBA74 \uB108\uBB34 \uBD80\uB2F4\uB418\uC796\uC544.[VAR 0114(0021)]",
  "\uB0B4\uAC00 \uBC18\uAC10\uC744 \uC0C0\uB358 \uC774\uC720\uAC00\\n\uD559\uC0DD\uD68C\uC7A5\uC774\uC5B4\uC11C\uC600\uB2E4\uB294 \uAC70 \uB2E4\uB4E4 \uC54C\uBA74\uC11C...[VAR 0114(0021)]",
  "\uC9F1\uB098\uB294 \uADDC\uCE59\uC744 \uB9C8\uAD6C \uB9CC\uB4E4\uC5B4 \uB0B4\uC11C\\n\uC560\uB4E4\uC774 \uC5C4\uCCAD\uB098\uAC8C \uC2EB\uC5B4\uD558\uAE34 \uD588\uC9C0.\\r\\n\uADF8\uB798\uC11C \uAE08\uBC29 \uB2E4\uB978 \uB140\uC11D\uC73C\uB85C \uAD50\uCCB4\uB410\uACE0.[VAR 0114(001F)]",
  "\uC18C\uC778\uB3C4 \uB3D9\uC758\uD558\uB294 \uBC14\uC774\uC624...\\n\uBAA9\uB35C\uBBF8\uC758 \uBA38\uB9AC \uAE38\uC774\uB294 3cm\uAE4C\uC9C0\uB77C\uC9C8 \uC54A\uB098,\\r\\n\uCC38\uC73C\uB85C \uC9DC\uC99D \uB098\uAE30 \uADF8\uC9C0\uC5C6\uB294 \uADDC\uCE59\uB4E4\uC774\uC5C8\uC18C...[VAR 0114(0023)]",
  "\uC5ED\uC2DC \uADF8\uB807\uC9C0? \uADF8\uB7EC\uB2C8\uAE4C \uB0B4\uAC00\\n\uADDC\uCE59\uC744 \uB9CC\uB4E4\uC5B4\uC11C \uC798\uB420 \uB9AC\uAC00 \uC5C6\uB2E4\uACE0...[VAR 0114(0021)]",
  "\uADF8\uB807\uC9C0\uB9CC, \uB2E8\uC6D0\uB4E4\uC744 \uCC59\uAE30\uB294 \uAC74\\n\uAC70\uC758 \uD53C\uB098\uAC00 \uD558\uACE0 \uC788\uC796\uC544.[VAR 0114(0020)]",
  "\uB2E4\uB4E4 \uD53C\uB098\uD55C\uD14C \uC758\uC9C0\uD558\uACE0 \uC788\uACE0,\\n\uC2E0\uB8B0\uD558\uACE0 \uC788\uC5B4.[VAR 0114(0022)]",
  "\uC9C0\uAE08\uC758 \uD53C\uB098\uAC00 \uC0DD\uAC01\uD574 \uB0B8 \uADDC\uCE59\uC774\uB77C\uBA74\\n\uB098\uB3C4 \uC21C\uC21C\uD788 \uB530\uB77C \uC904 \uC0DD\uAC01\uC740 \uC788\uB2E4\uACE0.[VAR 0114(001F)]",
  "...\uB3D9\uAC10\uC774\uC624![VAR 0114(0023)]",
  "\uADF8\uB798, \uC54C\uC558\uC5B4.\\n\uD55C\uB2E4\uACE0... \uD558\uBA74 \uB418\uC796\uC544.[VAR 0114(0021)]",
  "\uB0B4\uAC00 \uD560 \uC218 \uC788\uB294 \uB9CC\uD07C\uC740...\\n\uCDA9\uBD84\uD788 \uD55C \uAC70\uC57C...[VAR 0114(0021)]",
  "\uB0B4 \uC190\uC73C\uB85C \uB9CC\uB4E0 \uADDC\uCE59\uC774\uB2C8\uAE4C,\\n\uBBF8\uB828 \uC5C6\uC774 \uB2E8\uC744 \uB5A0\uB098\uACA0\uC5B4.\\r\\n\uBCF4\uC2A4\uC758 \uC99D\uD45C\uC778 \uC774 \uB2E8 \uBC30\uC9C0\uB97C \uBC1B\uC544 \uC8FC\uACA0\uC5B4?[VAR 0114(0021)]",
  "\uB364\uC73C\uB85C \uC774 \uD30C\uACA9\uC801\uC778\\n\uAE30\uC220\uBA38\uC2E0\uB3C4 \uBC1B\uB3C4\uB85D \uD574.[VAR 0114(0021)]",
  "\uC544~\\n\uC774\uAC78\uB85C \uD30C\uD2F0\uB294 \uB05D\uC778\uAC00...[VAR 0114(0021)]",
  "\uADF8\uAC74 \uADF8\uB807\uACE0, \uB108\uC758 \uD3EC\uCF13\uBAAC,\\n\uD558\uB098\uAC19\uC774 \uC5C4\uCCAD\uB098\uAC8C \uAC15\uD558\uB354\uB77C.[VAR 0114(0021)]",
  "\uADF8\uB7F0 \uAC74 \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C \uC775\uD78C \uAC70\uC57C?\\n\uAE30\uC220 \uAD6C\uC131\uC774\uB77C\uB4E0\uC9C0, \uC721\uC131\uBC95\uC774\uB77C\uB4E0\uC9C0 \uB9D0\uC774\uC57C.[VAR 0114(0021)]",
  "\uB9DE\uC544\uC694!",
  "\uC544\uB2C8\uC694",
  "\uD750\uC74C... \uB108\uB294\\n\uC544\uCE74\uB370\uBBF8\uB97C \uB2E4\uB2C8\uB294 \uAC8C \uC7AC\uBBF8\uC788\uC5B4?[VAR 0114(0021)]",
  "\uC7AC\uBC0C\uC5B4\uC694",
