  "\uACE0\uB9D9\uB2E4.\\n\uB2E8\uB3C4\uC9C1\uC785\uC801\uC73C\uB85C \uBB3C\uC5B4\uBCF4\uC9C0.[VAR 0114(001E)]",
  "\uC774\uB300\uB85C \uC788\uC73C\uBA74 \uB108\uD76C \uBAA8\uB450\\n\uD1F4\uD559 \uCC98\uBD84\uC778 \uAC83\uC740 \uC54C\uACE0 \uC788\uC744 \uD150\uB370[VAR 0114(001E)]",
  "\uC5B4\uC9F8\uC11C \uC2A4\uD0C0\uB2E8\uC744 \uD574\uC0B0\uD558\uACE0\\n\uC544\uCE74\uB370\uBBF8\uC5D0 \uB2E4\uB2C8\uC9C0 \uC54A\uB294 \uAC70\uC9C0?[VAR 0114(001E)]",
  "\uADF8\uB7F0 \uAC8C \uC54C\uACE0 \uC2F6\uC740 \uAC70\uC57C?\\n\uC6B0\uB9AC\uB294 \uCE5C\uAD6C\uB97C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744 \uBFD0\uC774\uC57C.\\r\\n...\uB3CC\uC544\uC62C\uC9C0\uB294 \uC54C \uC218 \uC5C6\uC9C0\uB9CC.[VAR 0114(0021)]",
  "\uCE5C\uAD6C... \uC18C\uC911\uD55C \uB3D9\uB8CC\uC778\uAC00?[VAR 0114(001E)]",
