[
  "[~ 67]",
  "[~ 67]",
  "\uB124 \uCABD\uC5D0\uC11C \uBA3C\uC800 \uC778\uC0AC\uD558\uB7EC \uC624\uB2E4\uB2C8\\n\uC81C\uBC95 \uC13C\uC2A4\uAC00 \uC0DD\uACBC\uB294\uAC78![VAR 0114(0044)]",
  "\uB098\uB3C4 \uCE74\uC9C0\uB791 \uAC19\uC774\\n\uC544\uCE74\uB370\uBBF8\uC5D0 \uBCF5\uADC0\uD588\uC73C\uB2C8\uAE4C.[VAR 0114(0044)]",
  "\uC55E\uC73C\uB85C\uB3C4 \uB098\uB97C \uBCF4\uBA74\\n2\uCD08 \uC548\uC5D0 \uC778\uC0AC\uD558\uB7EC \uC640\uC57C \uD574![VAR 0114(0044)]",
  "\uC54C\uC558\uC5B4!",
  "\uC5E5...",
  "\uC5B4\uBA38, \uC6EC\uC77C\uB85C \uACE0\uBD84\uACE0\uBD84\uD558\uB124.\\n\uBB50 \uC798\uBABB \uBA39\uAE30\uB77C\uB3C4 \uD55C \uAC70\uC57C?[VAR 0114(0044)]",
  "\uD5E4\uD5F7!\\n\uB108\uC758 \uADF8 \uB2F9\uD669\uD55C \uD45C\uC815\uC740\\r\\n\uC5B8\uC81C \uBD10\uB3C4 \uCD5C\uACE0\uB77C\uB2C8\uAE4C![VAR 0114(0044)]",
  "\uC544~ \uD55C\uB3D9\uC548 \uBD81\uC2E0\uC5D0 \uC788\uC5C8\uB354\uB2C8\\n\uC544\uCE74\uB370\uBBF8\uAC00 \uC815\uC2E0\uC5C6\uB294 \uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0.[VAR 0114(0044)]",
  "\uC2A4\uC774\uB85D\uB9C8\uC744\uC5D0\uB294\\n\uC544~\uBB34\uAC83\uB3C4 \uC5C6\uC796\uC544!\\r\\n...\uADF8 \uC810\uC774 \uC88B\uC740 \uAC70\uC9C0\uB9CC.[VAR 0114(0044)]",
  "[VAR 0100(0000)], \uB108 \uB9D0\uC774\uC57C...[VAR 0114(0044)]",
  "\uB0B4\uAC00... \uADF8...\\n\uC218\uC288\uC218\uC288 \uD558\uBA74\uC11C \uCDA4\uCD94\uB294 \uAC70...\\r\\n\uB3D9\uC601\uC0C1\uC73C\uB85C \uCC0D\uAC70\uB098 \uD558\uC9C4 \uC54A\uC558\uC9C0!?[VAR 0114(0044)]",
  "\uC548 \uCC0D\uC5C8\uC5B4",
  "\uC0AC\uC2E4\uC740...",
  "\uD734~ \uB2E4\uD589\uC774\uB2E4!!\\n\uC870\uC885\uB2F9\uD55C \uAC70\uB77C\uACE0\uB294 \uD558\uC9C0\uB9CC\\r\\n\uB0B4 \uC778\uC0DD\uC758 \uC720\uC77C\uD55C \uC624\uC810\uC774\uC5C8\uC5B4![VAR 0114(0044)]",
  "\uBB50\uC5B4!? \uC57C!!\\n\uB2F9\uC7A5 \uC9C0\uC6CC!! \uC54C\uC558\uC5B4!?[VAR 0114(0044)]",
  "\uC0AC\uC9C4\uC774\uB098 \uB3D9\uC601\uC0C1 \uAC19\uC740 \uAC8C \uB0A8\uC558\uB2E4\uAC04\\n\uB098\uC911\uC5D0 \uC720\uBA85\uD574\uC84C\uC744 \uB54C \uACE4\uB780\uD574\uC9C4\uB2E4\uAD6C![VAR 0114(0044)]",
  "\uADFC\uB370 \uACB0\uAD6D \uADF8...\\n\uBCF5\uC22D\uC545\uB3D9\uC774\uB77C\uB294 \uD3EC\uCF13\uBAAC\uC740\\r\\n\uB300\uCCB4 \uBB50\uC600\uB358 \uAC70\uC9C0?[VAR 0114(0044)]",
  "\uC0DD\uAC01\uD574 \uBD24\uB294\uB370, \uBD84\uC704\uAE30\uB77C\uB4E0\uC9C0 \uBB54\uAC00\\n\uC138\uBC97\uB4E4\uC774\uB791 \uBE44\uC2B7\uD55C \uAC83 \uAC19\uC9C0 \uC54A\uC544?[VAR 0114(0044)]",
  "\uADF8\uB7F0 \uAC83 \uAC19\uC544!",
  "\uADF8\uB7F0\uAC00?",
  "\uADF8\uB807\uB2E4\uB2C8\uAE4C!!\\n\uBB54\uAC00 \uAD00\uACC4\uAC00 \uC788\uB294 \uAC8C \uBD84\uBA85\uD574![VAR 0114(0044)]",
  "\uBB50, \uADF8\uB807\uB2E4\uACE0 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uC9C1\uC811 \uB4E4\uC744 \uC218 \uC788\uB294 \uAC74 \uC544\uB2C8\uB2C8\uAE4C...\\r\\n\uC9C4\uC0C1\uC740 \uC5B4\uB460 \uC18D\uC5D0 \uC788\uB294 \uAC70\uB098 \uB9C8\uCC2C\uAC00\uC9C0\uB124![VAR 0114(0044)]",
  "\uB124 \uCABD\uC5D0\uC11C\\n\uBA3C\uC800 \uB9D0\uC744 \uAC78\uC5B4\uC624\uB2E4\uB2C8 \uAE30\uD2B9\uD55C\uAC78![VAR 0114(0044)]",
  "\uADF8 \uC77C \uB4A4\uB85C...\\n\uCE74\uC9C0\uC640\uB294 \uC880 \uC5B4\uB54C?[VAR 0114(0044)]",
  "\uCE5C\uD558\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uC5B4!",
  "\uADF8\uB7ED\uC800\uB7ED?",
  "\uD750\uC751~?\\n\uADF8\uB807\uB2E4\uBA74 \uB2E4\uD589\uC774\uB124.[VAR 0114(0044)]",
  "\uD750\uC751~?\\n\uB098\uC058\uC9C0\uB294 \uC54A\uB2E4\uB2C8 \uB2E4\uD589\uC774\uB124.[VAR 0114(0044)]",
  "\uADF8 \uC560, \uC9C0\uAE08...\\n\uD559\uAD50 \uC77C\uC774\uB77C\uB4E0\uC9C0 \uBD80\uD65C\uB3D9\uC774\uB77C\uB4E0\uC9C0\\r\\n\uC5EC\uB7EC\uBAA8\uB85C \uC5F4\uC2EC\uD788 \uD558\uACE0 \uC788\uC5B4.[VAR 0114(0044)]",
  "...\uBC84\uD300\uBAA9\uC774 \uB418\uC5B4 \uB2EC\uB77C\uACE0\uAE4C\uC9C0\uB294 \uD558\uC9C0 \uC54A\uC744\uAC8C.\\n\uADF8\uC800 \uC608\uC804\uCC98\uB7FC \uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4 \uC918.[VAR 0114(0044)]",
  "\uB2F9\uC5F0\uD558\uC9C0!",
  "\uC2DC\uC720\uC758 \uBD80\uD0C1\uC774\uB77C\uBA74\uC57C!",
  "\uC751...\\n\uC774\uB7F0 \uB9D0 \uD558\uC9C0 \uC54A\uC544\uB3C4\\r\\n\uB108\uD76C\uB294 \uC774\uBBF8 \uCE5C\uAD6C\uC9C0.[VAR 0114(0044)]",
  "\uADF8\uB798! \uB098\uB97C \uC704\uD574\uC11C\uB77C\uB3C4\\n\uAF2D \uBD99\uC5B4 \uC9C0\uB0B4\uB77C\uAD6C![VAR 0114(0044)]",
  "\uC544~! \uB0B4\uAC00 \uB108\uBB34\\n\uACFC\uBCF4\uD638\uD558\uB294 \uAC74 \uC544\uB2CC\uAC00 \uBAB0\uB77C![VAR 0114(0044)]",
  "\uC55E\uC73C\uB85C\uB294 \uCE74\uC9C0\uB97C\\n\uC801\uB2F9\uD788 \uC9C0\uCF1C\uBCF4\uB3C4\uB85D \uD574\uC57C\uACA0\uC5B4!\\r\\n...\uC870\uAE08 \uC678\uB86D\uAE30\uB294 \uD558\uACA0\uC9C0\uB9CC![VAR 0114(0044)]",
  "\uC544, \uC774\uC57C\uAE30\uD558\uB2E4 \uBCF4\uB2C8\\n\uBB54\uAC00 \uC6B0\uC6B8\uD558\uB124.[VAR 0114(0044)]",
  "\uB124 \uC798\uBABB\uC774\uB2C8\uAE4C\\n\uCC45\uC784\uC838 \uC918\uC57C\uACA0\uC5B4![VAR 0114(0044)]",
  "\uADF8\uB7EC\uB2C8\uAE4C...\\n\uB098\uB791 \uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD558\uC790![VAR 0114(0044)]",
  "\uC790\uC138\uB294 \uB418\uC5B4 \uC788\uB124!\\n\uB098\uB294 \uCC28\uB370\uC2A4\uB97C \uC904 \uAC74\uB370\\r\\n\uB108\uB294 \uC5B4\uB5BB\uAC8C \uD560\uB798?[VAR 0114(0044)]",
  "[VAR 0101(0001)][VAR 1900(0006)]\uB77C...\\n\uB124\uAC00 \uACE0\uB978 \uAC83\uCE58\uACE0 \uC88B\uC740 \uD3EC\uCF13\uBAAC\uC774\uB124.\\c\\n\uC18C\uC911\uD788 \uD0A4\uC6B8 \uD14C\uB2C8\uAE4C\\n\uAC71\uC815\uD558\uC9C0 \uB9D0\uB77C\uAD6C![VAR 0114(0044)]",
  "\uB108\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uB0B4 \uCC28\uB370\uC2A4\uB97C \uAD50\uD658\uD558\uB294 \uAC70\uC9C0?[VAR 0114(0044)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uB294 \uAC70 \uBAB0\uB77C?\\c\\n2\uB9C8\uB9AC \uC774\uC0C1 \uB370\uB824\uC624\uACE0 \uB2E4\uC2DC \uB9D0\uD574.[VAR 0114(0044)]",
  "\uC73C\uC73C... \uC65C \uC2EB\uC740 \uAC74\uB370!![VAR 0114(0044)]",
  "\uC5ED\uC2DC \uB098\uB791\\n\uD3EC\uCF13\uBAAC \uAD50\uD658\uC774 \uD558\uACE0 \uC2F6\uC5B4\uC9C4 \uAC70\uC57C?[VAR 0114(0044)]",
  "\uB108, \uD55C\uAC00\uD574 \uBCF4\uC774\uB124.\\n\uB0B4\uAC00 \uC2B9\uBD80\uD574 \uC904\uAE4C?[VAR 0114(0044)]",
  "\uB0B4 \uAD8C\uC720\uB97C \uAC70\uC808\uD558\uB2E4\uB2C8\\n\uD3C9\uC0DD \uD6C4\uD68C\uD558\uAC8C \uB420 \uD150\uB370 \uAD1C\uCC2E\uACA0\uC5B4?[VAR 0114(0044)]",
  "\uD5E4\uD5F7...\\n\uADF8\uB7FC \uC2E4\uB825\uC744 \uBCF4\uC5EC \uC904\uAC8C![VAR 0114(0044)]",
  "[VAR 0100(0000)]!\\n\uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uC796\uC544!\\r\\n\uB098\uB294 \uB354\uBE14\uBC30\uD2C0\uC774 \uD558\uACE0 \uC2F6\uB2E4\uAD6C![VAR 0114(0044)]",
  "...\uADF8 \uAE30\uC220\uB9CC \uBA85\uC911\uD588\uC5B4\uB3C4\\n\uB0B4\uAC00 \uC774\uACBC\uC744 \uAC70\uC57C.[VAR 0114(0044)]",
  "\uB098\uB97C \uC774\uB807\uAC8C\uAE4C\uC9C0 \uBAB0\uC544\uBD99\uC77C \uC218 \uC788\uB294 \uAC74\\n\uB108\uBC16\uC5D0 \uC5C6\uC744\uAC78.[VAR 0114(0044)]",
  "\uC544! \uC7A0\uAE50 \uAE30\uB2E4\uB824!\\n\uC0C1\uC73C\uB85C \uC774\uAC78 \uC904 \uD14C\uB2C8\uAE4C![VAR 0114(0044)]",
  "\uADF8 \uC548\uACBD, \uB108\uB791 \uC798 \uC5B4\uC6B8\uB9AC\uB2C8\uAE4C\\n\uD3C9\uC0DD \uC4F0\uACE0 \uB2E4\uB2C8\uB3C4\uB85D \uD574![VAR 0114(0044)]",
  "[VAR 0100(0000)][VAR 1900(0001)] \uC2DC\uC720\uB85C\uBD80\uD130\\n[VAR FF00(0008)]\uCF54\uBBF9 \uC548\uACBD(\uADF8\uC6B0\uB9B0\uCC28)[VAR FF00(0000)]\uC744 \uBC1B\uC558\uB2E4!",
  "...\uC798 \uB4E4\uC5B4.\\n\uB0B4\uAC00 \uC2B9\uB9AC\uB97C \uC591\uBCF4\uD574 \uC900 \uAC70\uC57C![VAR 0114(0044)]",
  "\uB2E4\uC74C\uC5D0\uB294 \uC774\uBC88\uCC98\uB7FC \uC548 \uB420 \uD14C\uB2C8\uAE4C!\\n\uAC01\uC624\uD558\uB3C4\uB85D \uD574![VAR 0114(0044)]",
  "\uD5E4\uD5F7!\\n\uB0B4\uAC00 \uC804\uB825\uC744 \uB2E4\uD558\uBA74 \uC774 \uC815\uB3C4\uB77C\uAD6C!\\c\\n\uBE14\uB8E8\uBCA0\uB9AC\uADF8 \uCC54\uD53C\uC5B8 \uC790\uB9AC\uB294\\n\uC5B8\uC81C\uB4E0\uC9C0 \uBC1B\uC544 \uC904 \uD14C\uB2C8\uAE4C \uB9D0\uB9CC \uD574![VAR 0114(0044)]",
  "\uC5B4\uC9F8\uC11C \uCE74\uC9C0\uCC98\uB7FC\\n\uD560\uC544\uBC84\uC9C0 \uB9D0\uD22C\uB97C \uC4F0\uC9C0 \uC54A\uB0D0\uACE0?\\c\\n\uADF8\uC57C \uB0B4\uAC00 \uB354 \uBA4B\uC9C0\uB2C8\uAE4C \uADF8\uB807\uC9C0![VAR 0114(0044)]",
  "\uB108, \uC544\uCE74\uB370\uBBF8\uC5D0\uB3C4 \uB9AC\uADF8\uBD80\uC5D0\uB3C4 \uC27D\uAC8C \uC801\uC751\uD558\uACE0\\n\uC815\uB9D0 \uBB34\uC11C\uC6B8 \uC9C0\uACBD\uC774\uB77C\uB2C8\uAE4C!\\r\\n\uC2A4\uD30C\uC774 \uAC19\uC740 \uAC8C \uC801\uC131\uC778 \uAC70 \uC544\uB2C8\uC57C?[VAR 0114(0044)]",
  "\uC624\uAC70\uD3F0\uC740 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC5B4?\\c\\n\uAC00\uBA74\uCC3E\uC544\uC870\uB85C\uC11C \uC138\uBC97\uB4E4\uC744 \uBB34\uCC0C\uB974\uB358 \uC77C\uC774\\n\uAC00\uB054\uC529 \uC0DD\uAC01\uB09C\uB2E8 \uB9D0\uC774\uC9C0.[VAR 0114(0044)]",
  "\uB124\uAC00 \uC900 [VAR 0101(0001)],\\n\uB098\uB97C \uC798 \uB530\uB974\uB294 \uAC70 \uC788\uC9C0.\\r\\n\uB108\uB3C4 \uC880 \uBCF4\uACE0 \uBC30\uC6E0\uC73C\uBA74 \uC2F6\uC744 \uC815\uB3C4\uC57C![VAR 0114(0044)]",
  "\uB0B4\uAC00 \uAD50\uD658\uD574 \uC900 \uCC28\uB370\uC2A4, \uAD49\uC7A5\uD558\uC9C0?\\c\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB530\uB048\uB530\uB048\uD55C \uCC28\uB97C\\n\uB9C8\uC2E4 \uC218 \uC788\uAC8C \uD574 \uC900\uB2E4\uAD6C![VAR 0114(0044)]"
]
