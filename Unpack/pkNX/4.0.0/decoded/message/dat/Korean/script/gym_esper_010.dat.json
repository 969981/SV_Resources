[
  "\uBCA0\uC774\uD06C\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uB3C4\uC804\uC790\uC758 \uC774\uB984\uC744\\n\uB4F1\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4...\\r\\n[VAR 0100(0000)] \uB2D8\uC774\uC2DC\uAD70\uC694!",
  "\uC774\uACF3\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB9AC\uD30C \uB2D8\uACFC\\n\uC2B9\uBD80\uD558\uB824\uBA74 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C\\r\\n\uD074\uB9AC\uC5B4\uD574\uC57C \uD569\uB2C8\uB2E4.",
  "\uBCA0\uC774\uD06C\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB294...\\n[VAR FF00(0006)]\uC5D1\uC11C\uC0AC\uC774\uC988[VAR FF00(0000)]!",
  "\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB9AC\uD30C \uB2D8\uAED8\uC11C \uACE0\uC548\uD558\uC2E0\\n[VAR FF00(0006)]\uD76C\uB85C\uACBD\uB77D \uC5D1\uC11C\uC0AC\uC774\uC988[VAR FF00(0000)]\uB97C\\r\\n\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uD574\uB0B4\uC2DC\uBA74 \uD569\uACA9\uC785\uB2C8\uB2E4!",
  "\uC790\uC138\uD55C \uB8F0\uC740 \uCCB4\uC721\uAD00\uC744 \uB098\uAC00\uC11C\\n\uC67C\uCABD\uC5D0 \uC788\uB294 \uC5D1\uC11C\uC0AC\uC774\uC988 \uD68C\uC7A5\uC758\\r\\n\uAC80\uC740 \uC6B4\uB3D9\uBCF5\uC744 \uC785\uC740 \uC5EC\uC131\uBD84\uC5D0\uAC8C \uB4E4\uC5B4 \uC8FC\uC138\uC694.",
  "\uADF8\uB7FC, \uB2E4\uB140\uC624\uC138\uC694!"
]
