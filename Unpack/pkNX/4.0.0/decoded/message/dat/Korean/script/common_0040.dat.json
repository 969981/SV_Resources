  "\uC77C\uBD80\uB7EC \uC5EC\uAE30\uAE4C\uC9C0\\n\uCC3E\uC544\uC624\uC2DC\uAC8C \uD574\uC11C \uC8C4\uC1A1\uD558\uB124\uC694.[VAR 0114(002B)]",
  "\uBAA8\uCC98\uB7FC \uC624\uC168\uB294\uB370\\n\uCC28\uB77C\uB3C4 \uD55C\uC794 \uB4E4\uACE0 \uAC00\uC2DC\uACA0\uC5B4\uC694?[VAR 0114(002B)]",
  "\uC544\uC774\uACE0,\\n\uADF8\uB807\uAC8C\uAE4C\uC9C0 \uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4...[VAR 0114(000A)]",
