  "...\uC774\uB7F0,\\n\uC544\uC9C1 \uC81C \uC18C\uAC1C\uB97C \uD558\uC9C0 \uC54A\uC558\uAD70\uC694.[VAR 0114(002C)]",
  "\uC624\uB80C\uC9C0 \uC544\uCE74\uB370\uBBF8\uC758 \uAD50\uC7A5,\\n\uD074\uB77C\uBCA8\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uADF8\uB808\uC774\uD504 \uC544\uCE74\uB370\uBBF8\uC758 \uAD50\uC7A5,\\n\uD074\uB77C\uBCA8\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uAD50\uC7A5 \uC120\uC0DD\uB2D8\uAED8\uC11C \uC9C1\uC811\\n\uCC3E\uC544\uC640 \uC8FC\uC2E0 \uAC74\uAC00\uC694!?[VAR 0114(002B)]",
  "\uC800\uD76C \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C \uBC1C\uC0DD\uD55C \uC2E4\uC218\uB294\\n\uBAA8\uB450 \uC81C \uCC45\uC784\uC774\uB2C8\uAE4C\uC694...[VAR 0114(000A)]",
