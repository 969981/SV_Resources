[
  "\uC548\uB155~\\n\uC624\uB298\uB3C4 \uC990\uAC70\uC6B4 \uC218\uC5C5\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C?[VAR 0114(0025)]",
  "\uC9C0\uB09C \uC218\uC5C5\uC5D0\uC11C\uB294 \uAE30\uC220\uC758 \uBA85\uC911\uC73C\uB85C\\n\uD655\uB960\uC5D0 \uB300\uD574 \uACF5\uBD80\uD588\uC5C8\uC9C0?[VAR 0114(0025)]",
  "\uD655\uB960\uC774 \uAF64 \uC7AC\uBBF8\uC788\uB294 \uAC8C, \uD55C \uBC18\uC5D0\\n40\uBA85\uC758 \uD559\uC0DD\uC774 \uC788\uC73C\uBA74, 90%\uC758 \uD655\uB960\uB85C\\r\\n\uC0DD\uC77C\uC774 \uB611\uAC19\uC740 \uC0AC\uB78C\uC774 \uD55C \uC30D\uC740 \uB098\uC628\uB300.[VAR 0114(0025)]",
  "1\uB144\uC774 300\uC77C\uC774 \uB118\uB294\uB370\\n\uCC38 \uC2E0\uAE30\uD558\uC9C0?[VAR 0114(0025)]",
  "\uADF8\uAC74 \uADF8\uB807\uACE0 \uC5EC\uB7EC\uBD84\uC5D0\uAC8C \uC9C0\uAE08\uAE4C\uC9C0\\n\uAC00\uB974\uCCD0 \uC900 \uAC8C, \uD0C0\uC785 \uC0C1\uC131\uC774\uB791 \uAE09\uC18C...[VAR 0114(0025)]",
  "\uB2A5\uB825 \uC0C1\uC2B9 \uAC19\uC740\\n\uB370\uBBF8\uC9C0 \uACC4\uC0B0\uC5D0 \uB300\uD55C \uAC83\uB4E4\uC774\uC5C8\uC9C0?[VAR 0114(0025)]",
  "\uC774\uB7F0 \uC694\uC18C\uB4E4\uC774 \uBAA8\uB450 \uACF1\uD574\uC838\uC11C\\n\uC0C1\uB300\uC758 HP\uB97C \uC904\uC5EC \uB098\uAC00\uB294 \uAC70\uC57C.[VAR 0114(0025)]",
  "\uADF8\uB7F0\uB370 \uC0AC\uC2E4, \uC774\uB7F0 \uAC83\uB4E4\uBCF4\uB2E4\uB3C4\\n\uC544\uC8FC \uAC04\uB2E8\uD55C \uBC29\uBC95\uC73C\uB85C\\r\\n\uAE30\uC220\uC758 \uB370\uBBF8\uC9C0\uB97C \uC62C\uB9B4 \uC218 \uC788\uB2E8\uB2E4![VAR 0114(0025)]",
  "\uADF8\uAC74 \uBC14\uB85C, \uD3EC\uCF13\uBAAC\uC758 \uD0C0\uC785\uACFC\\n\uAC19\uC740 \uAE30\uC220\uC744 \uC0AC\uC6A9\uD558\uB294 \uAC70\uC57C![VAR 0114(0025)]",
  "\uBC14\uC704\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC774\\n\uBC14\uC704\uD0C0\uC785 \uAE30\uC220 \uC2A4\uD1A4\uC5D0\uC9C0\uB97C \uC0AC\uC6A9\uD558\uBA74,\\r\\n\uC704\uB825 100\uC758 1.5\uBC30\uC778 150\uC774 \uB418\uB294 \uAC70\uC9C0.[VAR 0114(0025)]",
  "\uBE44\uC2B7\uD558\uAC8C \uC0DD\uAE30\uAE34 \uD588\uC9C0\uB9CC,\\n\uB545\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC774 \uC2A4\uD1A4\uC5D0\uC9C0\uB97C \uC0AC\uC6A9\uD574\uB3C4\\r\\n\uC704\uB825\uC740 \uADF8\uB300\uB85C 100\uC774\uB780\uB2E4.[VAR 0114(0025)]",
  "\uC774 \uC218\uCE58\uC5D0 \uD6A8\uACFC\uAC00 \uAD49\uC7A5\uD588\uC744 \uB54C\uC640\\n\uAE09\uC18C\uC5D0 \uB9DE\uC558\uC744 \uB54C\uC758 \uACF1\uC148\uC774 \uB354\uD574\uC9C0\uB2C8\uAE4C\\r\\n\uBB34\uC2DC\uD560 \uC218 \uC5C6\uB294 \uC218\uCE58\uB77C\uACE0 \uD560 \uC218 \uC788\uC5B4.[VAR 0114(0025)]",
  "\uADF8\uB7FC, \uC81C\uB300\uB85C \uC774\uD574\uD588\uB294\uC9C0\\n\uC120\uC0DD\uB2D8\uC774 \uC9C8\uBB38 \uD558\uB098 \uD560\uAC8C.[VAR 0114(0025)]",
  "\uC704\uB825 100\uC758 \uD0C0\uC785\uC774 \uC77C\uCE58\uD558\uB294 \uAE30\uC220\uB85C\\n\uADF8 \uD0C0\uC785\uC774 \uC57D\uC810\uC778 \uC0C1\uB300\uB97C \uB9DE\uD614\uC744 \uB54C, \uC704\uB825\uC740?[VAR 0114(0025)]",
  "150",
  "200",
  "300",
  "\uC74C~ \uC544\uC27D\uB124!\\n150\uC774\uB77C\uB2C8, \uD0C0\uC785\uC774 \uC77C\uCE58\uD588\uC744 \uB54C\uC758\\r\\n1.5\uBC30\uB9CC \uACF1\uD55C \uAC83 \uAC19\uC740\uB370?[VAR 0114(0025)]",
  "\uC74C~ \uC544\uC27D\uB124!\\n200\uC774\uB77C\uB2C8, \uC57D\uC810\uC77C \uB54C\uC758\\r\\n2\uBC30\uB9CC \uACF1\uD55C \uAC83 \uAC19\uC740\uB370?[VAR 0114(0025)]",
  "\uBA38\uB9BF\uC18D\uC73C\uB85C \uACC4\uC0B0\uD558\uB2E4\uB2C8 \uC5ED\uC2DC \uB300\uB2E8\uD55C\uB370!\\n[VAR 0100(0000)], \uCC38 \uC798\uD588\uC5B4\uC694~![VAR 0114(0025)]",
  "\uC704\uB825 100\uC5D0\\n\uD0C0\uC785\uC774 \uC77C\uCE58\uD588\uC73C\uB2C8\uAE4C,\\r\\n1.5\uBC30\uB97C \uACF1\uD574\uC11C 150![VAR 0114(0025)]",
  "150\uC5D0 \uC57D\uC810\uC77C \uB54C\uC758\\n2\uBC30\uB97C \uACF1\uD574\uC11C 300![VAR 0114(0025)]",
  "\uADF8\uB798\uC11C \uBB34\uB824!\\n\uC6D0\uB798 \uC704\uB825\uC758 3\uBC30\uAC00 \uB418\uB294 \uAC70\uC57C![VAR 0114(0025)]",
  "\uC5EC\uAE30\uC5D0, \uC6D0\uB798 \uD0C0\uC785\uACFC \uAC19\uC740\\n\uD14C\uB77C\uC2A4\uD0C8\uD0C0\uC785\uC774 \uB418\uBA74\\r\\n\uD0C0\uC785 \uC77C\uCE58\uC77C \uB54C\uC758 \uBC30\uC218\uAC00\\r\\n1.5\uBC30\uAC00 \uC544\uB2C8\uB77C, 2\uBC30\uAC00 \uB41C\uB2E8\uB2E4![VAR 0114(0025)]",
  "\uBB3C\uB860, \uB2E4\uB978 \uD0C0\uC785\uC758 \uAE30\uC220\uC744\\n\uB2E4\uC591\uD558\uAC8C \uC4F8 \uC218 \uC788\uB294 \uAC83\uB3C4 \uAD49\uC7A5\uD55C \uC77C\uC774\uC57C.\\r\\n\uC0C1\uB300\uB97C \uAE5C\uC9DD \uB180\uB77C\uAC8C \uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C.[VAR 0114(0025)]",
  "\uADF8\uB807\uC9C0\uB9CC \uC778\uAC04\uB3C4 \uADF8\uB807\uACE0, \uD3EC\uCF13\uBAAC\uB3C4 \uADF8\uB807\uACE0...[VAR 0114(0025)]",
  "\uC790\uC2E0\uC758 \uD2B9\uC0C9\uC744 \uC0B4\uB824\uC57C \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0\\n\uCD5C\uB300\uD55C\uC758 \uD798\uC744 \uBC1C\uD718\uD560 \uC218 \uC788\uB2E4\uB294 \uAC83.[VAR 0114(0025)]",
  "\uC5EC\uB7EC\uBD84\uC774 \uC774\uAC78 \uC624\uB798\uB3C4\uB85D \uAE30\uC5B5\uD574 \uC8FC\uBA74\\n\uC120\uC0DD\uB2D8\uC740 \uC815\uB9D0 \uAE30\uC060 \uAC70\uC57C.[VAR 0114(0025)]",
  "...\uAD49\uC7A5\uD788 \uCD08\uBCF4\uC801\uC778 \uC774\uC57C\uAE30\uB97C\\n\uC774\uC81C \uC640\uC11C \uD574 \uC8FC\uB2C8 \uC870\uAE08 \uBBF8\uC548\uD558\uB124.[VAR 0114(0025)]",
  "\uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uB3C4\\n\uC21C\uC2DD\uAC04\uC5D0 \uB05D\uB098 \uBC84\uB838\uAD6C\uB098.[VAR 0114(0025)]",
  "\uB2E4\uB4E4 \uD638\uC758\uC801\uC73C\uB85C \uC218\uD559\uC744 \uACF5\uBD80\uD574 \uC918\uC11C\\n\uC815\uB9D0 \uC990\uAC70\uC6B4 \uC2DC\uAC04\uC774\uC5C8\uC5B4.[VAR 0114(0025)]",
  "\uB2E4\uC74C\uC740 \uC990\uAC70\uC6B4 \uAE30\uB9D0\uACE0\uC0AC\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2E8\uB2E4!\\n\uC5F4\uC2EC\uD788 \uBCF5\uC2B5\uD574 \uB450\uB3C4\uB85D \uD558\uB834![VAR 0114(0025)]"
]
