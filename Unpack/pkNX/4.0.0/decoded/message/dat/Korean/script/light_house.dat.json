[
  "\uB4F1\uB300 \uC704\uB294 \uCC38 \uC870\uC6A9\uD558\uAD6C\uB098.\\n\uCC0C\uB9AC\uBE44\uB77C\uB294 \uD3EC\uCF13\uBAAC\uB3C4\\r\\n\uAC00\uB054 \uC26C\uB7EC \uC624\uACE4 \uD574.",
  "\uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB294 \uC5B8\uB355\uAE38\uC5D0\uC11C \uB85C\uD1A0\uBB34\uB97C \uBD24\uC5B4!\\n\uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34 \uB9D0\uACE0 \uC57C\uC0DD \uB85C\uD1A0\uBB34 \uB9D0\uC774\uC57C!",
  "\uCD5C\uCCA8\uB2E8 \uB9C8\uC744 \uBC14\uB85C \uB4A4\uD3B8\uC5D0\\n\uB300\uC790\uC5F0\uC774 \uD3BC\uCCD0\uC838 \uC788\uB2E4\uB2C8!\\r\\n\uB4F1\uC0B0\uAC78\uC758 \uB9C8\uC74C\uC744 \uC790\uADF9\uD558\uB294\uAC78!",
  "\uC704\uC5D0\uC11C \uBCF4\uB2C8\uAE4C\\n\uC2DC\uC7A5\uB3C4 \uC800\uB807\uAC8C \uC791\uAD6C\uB098!",
  "\uB108\uB3C4 \uB85C\uC2A4\uD2B8 \uC0AC\uB9C9\uC744\\n\uC9C0\uB098\uC628 \uAC70\uB2C8?\\r\\n\uBB54\uAC00 \uC774\uC0C1\uD55C \uD3EC\uCF13\uBAAC \uC5C6\uC5C8\uC5B4?",
  "\uC544\uBB34\uB798\uB3C4 \uCE74\uB77C\uD504\uC2DC\uD2F0\uB85C \uB3CC\uC544\uAC08 \uB54C\uB294\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB97C \uC774\uC6A9\uD574\uC57C\uACA0\uC5B4.",
  "\uACBD\uB9E4\uC5D0\uC11C \uD070\uB3C8\uC744 \uC368 \uBC84\uB9AC\uACE0 \uB9D0\uC558\uC5B4...\\n\uBC14\uB2F7\uBC14\uB78C\uC774 \uC624\uB298\uB530\uB77C \uB354 \uB530\uB054\uD558\uB124!",
  "\uCAC0\uB4DD\uCAC0\uB4DD! \uB9D0\uB791\uB9D0\uB791!\\n\uC74C~ \uC774\uB798\uC57C \uCAC0\uB3C4\uAE30\uC9C0!"
]
