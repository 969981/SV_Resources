[
  "\uC548\uB155~\\n\uC990\uAC70\uC6B4 \uC218\uC5C5\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C?[VAR 0114(0025)]",
  "\uB2E4\uB4E4 \uC810 \uBCF4\uB294 \uAC74 \uC88B\uC544\uD558\uB2C8?[VAR 0114(0025)]",
  "\uC544\uCE68 \uB274\uC2A4\uC5D0 \uB098\uC624\uB294 \uC6B4\uC138 \uCF54\uB108\uC5D0\uC11C\\n\uC6B4\uC774 \uC88B\uC740 \uB0A0\uC774\uB77C\uACE0 \uD558\uBA74\\r\\n\uAD1C\uD788 \uB8F0\uB8E8\uB784\uB77C\uD558\uACE0 \uAE30\uBD84\uC774 \uC88B\uC9C0 \uC54A\uC544?[VAR 0114(0025)]",
  "\uADF8\uB798\uC11C, \uC624\uB298\uC740 \uC6B4\uC744 \uC8FC\uC81C\uB85C\\n\uC218\uD559\uC744 \uACF5\uBD80\uD574 \uBCFC \uAC70\uC57C![VAR 0114(0025)]",
  "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC5D0\uC11C \uAC00\uB054 \uB098\uC624\uB294\\n...\uAE09\uC18C\uC5D0 \uB9DE\uC558\uB2E4!\\r\\n\uB77C\uB294 \uB9D0, \uB2E4\uB4E4 \uBCF8 \uC801 \uC788\uC9C0?[VAR 0114(0025)]",
  "\uAE09\uC18C\uC5D0 \uB9DE\uC73C\uBA74 \uB370\uBBF8\uC9C0\uAC00\\n\uD3C9\uC18C\uBCF4\uB2E4 \uC808\uBC18\uC774 \uB354 \uB9CE\uC740\\r\\n1.5\uBC30\uAC00 \uB41C\uB2E8\uB2E4.[VAR 0114(0025)]",
  "\uC5B8\uC81C \uAE09\uC18C\uC5D0 \uB9DE\uACE0 \uB9DE\uD790\uC9C0\uB294\\n\uC644\uC804\uD55C \uC6B4... Luck\uC5D0 \uB2EC\uB9B0 \uC77C\uC774\uC9C0\uB9CC,\\r\\n\uADF8\uAC83\uC774 \uC2B9\uBD80\uC5D0 \uD30C\uB780\uC744 \uC77C\uC73C\uD0A4\uAE30\uB3C4 \uD574.[VAR 0114(0025)]",
  "\uADF8\uB7FC, \uC774 \uC911\uC5D0 \uAE09\uC18C\uC5D0 \uB9DE\uC744 \uD655\uB960\uC774\\n\uC5BC\uB9C8\uB098 \uB418\uB294\uC9C0 \uC544\uB294 \uC0AC\uB78C?[VAR 0114(0025)]",
  "\uC57D 1%(100\uBC88 \uC911\uC5D0 1\uBC88)",
  "\uC57D 4%(100\uBC88 \uC911\uC5D0 4\uBC88)",
  "\uC57D 12%(100\uBC88 \uC911\uC5D0 12\uBC88)",
  "\uD6C4\uD6C4\uD6C4, [VAR 0100(0000)].\\n\uAE09\uC18C\uB294 \uADF8\uAC83\uBCF4\uB2E4\uB294 \uC880 \uB354 \uB9DE\uD788\uAE30 \uC27D\uB2E8\uB2E4.[VAR 0114(0025)]",
  "\uCC38 \uC798\uD588\uC5B4\uC694!\\n\uC5ED\uC2DC [VAR 0100(0000)][VAR 1900(0006)]\uAD6C\uB098![VAR 0114(0025)]",
  "\uD6C4\uD6C4\uD6C4, [VAR 0100(0000)].\\n\uC544\uBB34\uB798\uB3C4 \uADF8\uAC74 \uB108\uBB34 \uC798 \uB9DE\uB294 \uAC70 \uC544\uB2D0\uAE4C?[VAR 0114(0025)]",
  "\uAE09\uC18C\uC5D0 \uB9DE\uC744 \uD655\uB960\uC740\\n\uC815\uD655\uD558\uAC8C\uB294 24\uBD84\uC758 1...\\r\\n4.17%\uB77C\uACE0 \uC804\uD574\uC9C0\uACE0 \uC788\uC5B4.[VAR 0114(0025)]",
  "\uAE09\uC18C\uB97C \uB9DE\uD788\uAE30 \uC26C\uC6B4 \uAE30\uC220\uB3C4 \uC788\uC5B4\uC11C\\n\uC2A4\uD1A4\uC5D0\uC9C0\uB098 \uC100\uB3C4\uD074\uB85C \uAC19\uC740 \uAE30\uC220\uC740\\r\\n\uC57D 12%\uC758 \uD655\uB960\uB85C \uAE09\uC18C\uC5D0 \uB9DE\uB294\uB2E8\uB2E4![VAR 0114(0025)]",
  "\uAE30\uCDA9\uC804\uC774\uB77C\uB294 \uAE30\uC220\uC774\uB098\\n\uD06C\uB9AC\uD2F0\uCEEC\uCEE4\uD130\uB77C\uB294 \uB3C4\uAD6C\uB97C \uC0AC\uC6A9\uD558\uBA74,[VAR 0114(0025)]",
  "\uAE09\uC18C \uBA85\uC911\uB960\uC774 2\uB2E8\uACC4\uB098 \uC62C\uB77C\uC11C\\n50%\uC758 \uD655\uB960\uB85C \uAE09\uC18C\uB97C \uB178\uB9B4 \uC218 \uC788\uC9C0.[VAR 0114(0025)]",
  "\uB9DE\uD788\uBA74 \uAE30\uC05C \uAE09\uC18C,\\n\uB9DE\uC73C\uBA74 \uBD84\uD55C \uAE09\uC18C.[VAR 0114(0025)]",
  "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC5D0\uB294 \uC0DD\uAC01\uBCF4\uB2E4\\n\uB9CE\uC740 \uD655\uB960\uB4E4\uC774 \uC228\uC5B4 \uC788\uB2E8\uB2E4![VAR 0114(0025)]",
  "\uACC4\uC0B0\uC744 \uD1B5\uD574 Luck\uC744 \uC790\uC2E0\uC758 \uD3B8\uC73C\uB85C \uB9CC\uB4E4\uBA74\\n\uC804\uB7B5\uC758 \uD3ED\uC774 \uD6E8\uC52C \uB354 \uB113\uC5B4\uC9C8 \uAC70\uC57C.[VAR 0114(0025)]",
  "\uC5B4\uBA38\uB098, \uC885\uC18C\uB9AC\uAC00...\\n\uBC8C\uC368 \uB05D\uB098\uB2E4\uB2C8, \uC544\uC27D\uB124...[VAR 0114(0025)]",
  "\uB2E4\uC74C \uC2DC\uAC04\uC740 \uC990\uAC70\uC6B4 \uC911\uAC04\uACE0\uC0AC\uB780\uB2E4!\\n\uB2E4\uB4E4 \uAE30\uB300\uD558\uACE0 \uC788\uC73C\uB834~[VAR 0114(0025)]"
]
