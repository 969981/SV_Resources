[
  "...\uADF8 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658 \uC870\uAC74\uC5D0 \uB9DE\uC9C0 \uC54A\uB294 \uAC83 \uAC19\uB2E4!",
  "\uD50C\uB77C\uBCA0\uBCA0\uB77C\uB294 \uD3EC\uCF13\uBAAC\uC740\\n\uAF43\uC758 \uC0C9\uC774 \uC800\uB9C8\uB2E4 \uB2E4\uB974\uB300!\\c\\n\uC544\uBB34 \uC0C9\uC774\uB098 \uC88B\uC73C\uB2C8\uAE4C\\n\uB0B4 \uB204\uB2C8\uBA38\uAE30\uB791 \uAD50\uD658\uD558\uC9C0 \uC54A\uC744\uB798?",
  "\uADF8 \uD50C\uB77C\uBCA0\uBCA0\uB97C\\n\uAD50\uD658\uD574 \uC904 \uAC70\uC57C?",
  "\uD750\uC74C~ \uC544\uC27D\uB2E4!\\n\uB9C8\uC74C\uC774 \uBC14\uB00C\uBA74 \uC598\uAE30\uD574 \uC918!",
  "\uC6B0\uC640, \uC791\uB2E4...! \uADC0\uC5EC\uC6CC...!\\n\uC544, \uAF43\uC744 \uD0C0\uACE0 \uC788\uC5B4... \uC74C!\\c\\n...\uD6C4~! \uB204\uB2C8\uBA38\uAE30\uB3C4 \uADC0\uC5EC\uC6B4 \uAC70\uB77C\uBA74\\n\uC9C0\uC9C0 \uC54A\uC73C\uB2C8\uAE4C, \uC18C\uC911\uD558\uAC8C \uB300\uD574 \uC918!",
  "\uD50C\uB77C\uBCA0\uBCA0 \uB108\uBB34 \uADC0\uC5FD\uB2E4...!\\c\\n\uC774\uCC38\uC5D0 \uBAA8\uB4E0 \uC0C9\uC758 \uD50C\uB77C\uBCA0\uBCA0\uB97C\\n\uC7A1\uC73C\uB7EC \uAC00 \uBCFC\uAE4C!?",
  "\uD3EC\uCF13\uBAAC\uC774\\n\uD55C \uB9C8\uB9AC\uBFD0\uC774\uBA74 \uAD50\uD658\uD560 \uC218 \uC5C6\uC5B4!\\c\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uB450 \uB9C8\uB9AC \uC774\uC0C1 \uB370\uB9AC\uACE0 \uC640 \uC918!",
  "\uAC00\uB8E8\uB204\uB2C8",
  "\uD0DC\uD638",
  "\uD314\uB370\uC544\uC758 \uC6B0\uD30C\uB294\\n\uB3C5\uC744 \uAC00\uC84C\uB2E4\uB294\uB370 \uC9C4\uC9DC\uC57C?\\c\\n\uB0B4\uAC00 \uB2E4\uB978 \uC9C0\uBC29\uC5D0\uC11C \uC7A1\uC740\\n\uD30C\uB780 \uC6B0\uD30C\uB791 \uAD50\uD658\uD558\uC790!",
  "\uC6B0\uC640, \uBB54\uAC00 \uC9C4\uD55C \uC0C9\uC774\uB124...!\\n\uADF8 \uC6B0\uD30C\uB791 \uAD50\uD658\uD574 \uC904 \uAC70\uC57C?",
  "\uC6B0\uD30C\uB791 \uC6B0\uD30C\uB97C \uAD50\uD658\uD558\uACE0 \uC2F6\uC73C\uBA74\\n\uB098\uD55C\uD14C \uB9D0\uD574 \uC918!",
  "\uC9C4\uC9DC \uB3C5\uD0C0\uC785\uC774\uB124!\\n\uD3EC\uC774\uC98C, \uADC0\uC5EC\uC6CC~!\\c\\n\uD30C\uB780 \uC6B0\uD30C\uB3C4 \uBA4B\uC9C4 \uC544\uC774\uB2C8\uAE4C\\n\uB9CE~\uC774 \uADC0\uC5EC\uC6CC\uD574 \uC918!",
  "\uC6B0\uD30C\uC758 \uD314\uB370\uC544\uC758 \uBAA8\uC2B5!\\n\uB208\uAF2C\uB9AC\uAC00 \uB0B4\uB824\uAC00 \uC788\uC5B4\uC11C \uADC0\uC5EC\uC6CC~!\\c\\n\uAC19\uC740 \uD3EC\uCF13\uBAAC\uC774\uB77C\uB3C4 \uC9C0\uBC29\uC5D0 \uB530\uB77C\\n\uBAA8\uC2B5\uC774\uB791 \uD0C0\uC785\uC774 \uB2EC\uB77C\uC11C \uC7AC\uBC0C\uC5B4!",
  "\uC5B4\uB77C? \uD3EC\uCF13\uBAAC\uC744\\n\uD55C \uB9C8\uB9AC\uBC16\uC5D0 \uC548 \uAC00\uC9C0\uACE0 \uC788\uB124?\\c\\n\uAD50\uD658\uC744 \uD558\uB824\uBA74 \uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774\\n\uB450 \uB9C8\uB9AC \uC774\uC0C1\uC740 \uC788\uC5B4\uC57C \uD574!",
  "\uD37C\uB7AD\uC774",
  "\uCCB4\uBBF8",
  "\uD30C\uB3C4\uD0C0\uAE30\uB97C \uD560 \uC218 \uC788\uB294 \uC544\uC774\uAC00 \uC5C6\uC5B4\uC11C\\n\uBC14\uB2E4\uC5D0 \uC0AC\uB294 \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB098\uB7EC \uBABB \uAC00\uACE0 \uC788\uC5B4.\\c\\n\uCC0C\uB974\uC131\uAC8C\uB97C \uAC00\uC9C0\uACE0 \uC788\uB2E4\uBA74\\n\uB0B4 \uACE0\uC6B0\uC2A4\uD2B8\uB791 \uAD50\uD658\uD574 \uC904\uB798?",
  "\uADF8 \uCC0C\uB974\uC131\uAC8C\uB97C \uAD50\uD658\uD574 \uC904 \uAC70\uC57C?",
  "\uD6C4\uD6C4\uD6C4... \uC548 \uB41C\uB2E4\uBA74 \uC5B4\uCA54 \uC218 \uC5C6\uC9C0.\\n\uD3EC\uAE30\uD560 \uC904 \uC544\uB294 \uAC83\uB3C4 \uC778\uC0DD\uC5D0\uC11C \uC911\uC694\uD558\uB2C8\uAE4C.",
  "\uC5B4\uBA38\uB098~ \uD2F0\uBBF8!\\n\uD32C\uD140\uC73C\uB85C \uC9C4\uD654\uD588\uAD6C\uB098~!?\\c\\n\uAD50\uD658\uD558\uBA74 \uC9C4\uD654\uD558\uB294 \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uB2E4\uB294 \uAC8C\\n\uC0AC\uC2E4\uC774\uC5C8\uB124~",
  "\uB0B4 \uD2F0\uBBF8\uB294 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uB2C8?\\c\\n\uB124 \uCC0C\uB974\uC131\uAC8C\uB294\\n\uC544\uC8FC \uCC0C\uB9BF\uCC0C\uB9BF\uD558\uAC8C \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC5B4.",
  "\uD3EC\uCF13\uBAAC\uC774 \uD55C \uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC5B4!\\c\\n\uD6C4\uD6C4\uD6C4... \uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC744\\n\uB450 \uB9C8\uB9AC \uC774\uC0C1 \uB370\uB9AC\uACE0 \uC624\uB834!",
