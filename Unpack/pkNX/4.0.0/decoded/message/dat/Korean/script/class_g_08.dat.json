[
  "\uC9C0\uAE08\uC774\uC57C\uB9D0\uB85C \uADF8\uAC04 \uC81C\uAD70\uB4E4\uC774\\n\uBC30\uC6B4 \uAC83\uB4E4\uC744 \uC2DC\uD5D8\uD560 \uB54C\uB2E4![VAR 0114(0029)]",
  "\uBCBC\uB77D\uCE58\uAE30 \uD55C \uAC83\uB4E4\uC744 \uC78A\uC5B4\uBC84\uB9AC\uAE30 \uC804\uC5D0\\n\uC2DC\uD5D8\uC744 \uC2DC\uC791\uD558\uB3C4\uB85D \uD558\uC9C0.[VAR 0114(0029)]",
  "1. \uB2E4\uC74C \uC911, \uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC744\\n    \uB9CC\uB098\uAE30 \uC26C\uC6CC\uC9C0\uB294 \uC2DD\uC0AC \uD30C\uC6CC\uB294?\\n\\n1) \uBC18\uC9DD\uBC18\uC9DD \uD30C\uC6CC   2) \uC870\uC6B0 \uD30C\uC6CC\\n3) \uD3EC\uD68D \uD30C\uC6CC",
  "\uBC18\uC9DD\uBC18\uC9DD \uD30C\uC6CC",
  "\uC870\uC6B0 \uD30C\uC6CC",
  "\uD3EC\uD68D \uD30C\uC6CC",
  "2. \uB2E4\uC74C \uC911, \uC54C \uD30C\uC6CC\uC758 \uD6A8\uACFC\uB85C\\n    \uC62C\uBC14\uB974\uC9C0 \uC54A\uC740 \uAC83\uC740?\\n\\n1) \uC54C\uC758 \uBD80\uD654\uAC00 \uBE68\uB77C\uC9C4\uB2E4\\n2) \uAC15\uD55C \uD3EC\uCF13\uBAAC\uC774 \uD0DC\uC5B4\uB098\uAE30 \uC26C\uC6CC\uC9C4\uB2E4\\n3) \uC54C\uC744 \uBC1C\uACAC\uD558\uAE30 \uC26C\uC6CC\uC9C4\uB2E4",
  "\uC54C\uC758 \uBD80\uD654\uAC00 \uBE68\uB77C\uC9C4\uB2E4",
  "\uAC15\uD55C \uD3EC\uCF13\uBAAC\uC774 \uD0DC\uC5B4\uB098\uAE30 \uC26C\uC6CC\uC9C4\uB2E4",
  "\uC54C\uC744 \uBC1C\uACAC\uD558\uAE30 \uC26C\uC6CC\uC9C4\uB2E4",
  "3. \uC2DD\uC0AC \uD30C\uC6CC\uC758 \uD6A8\uACFC\uB97C \uB192\uC774\uAE30 \uC704\uD574\\n    \uAC04\uB2E8\uD558\uAC8C \uD560 \uC218 \uC788\uB294 \uC911\uC694\uD55C \uC77C\uC740?\\n\\n1) \uC5EC\uB7EC \uBC88 \uC694\uB9AC\uD55C\uB2E4   2) \uC9D1\uC5D0\uC11C \uC694\uB9AC\uD55C\uB2E4\\n3) \uC5EC\uB7FF\uC774\uC11C \uC694\uB9AC\uD55C\uB2E4",
  "\uC5EC\uB7EC \uBC88 \uC694\uB9AC\uD55C\uB2E4",
  "\uC9D1\uC5D0\uC11C \uC694\uB9AC\uD55C\uB2E4",
  "\uC5EC\uB7FF\uC774\uC11C \uC694\uB9AC\uD55C\uB2E4",
  "4. \uB2E4\uC74C \uC911, \uADC0\uC5EC\uC6B4 \uD3EC\uCF13\uBAAC\uC774\\n    \uB354\uB7EC\uC6CC\uC84C\uC744 \uB54C \uD574\uC57C\uD560 \uD589\uB3D9\uC758 \uC774\uB984\uC740?\\n\\n1) \uD3EC\uCF13\uBAAC \uC6CC\uC2DC   2) \uD3EC\uCF13\uBAAC \uB300\uC2DC\\n3) \uD3EC\uCF13\uBAAC \uC704\uC2DC",
  "\uD3EC\uCF13\uBAAC \uC6CC\uC2DC",
  "\uD3EC\uCF13\uBAAC \uB300\uC2DC",
  "\uD3EC\uCF13\uBAAC \uC704\uC2DC",
  "5. \uC544\uCE74\uB370\uBBF8 \uAD50\uCE59\uC5D0 \uAD00\uD55C \uBB38\uC81C\uC785\uB2C8\uB2E4.\\n    \uAD50\uBCF5 \uC0C1\uC758\uC640 \uD558\uC758\uB294\\n    \uBC18\uB4DC\uC2DC \uACC4\uC808\uC5D0 \uB9DE\uAC8C \uC785\uC5B4\uC57C \uD55C\uB2E4.\\n    \uB9DE\uC73C\uBA74 O, \uD2C0\uB9AC\uBA74 X",
  "O",
  "X",
  "\uB2F5\uC744 \uC801\uC744 \uC2DC\uAC04\uC740 \uBAA8\uB450 \uB05D\uB0AC\uB2E4.\\n\uD544\uAE30\uB97C \uBA48\uCD94\uB3C4\uB85D.[VAR 0114(0029)]",
  "...\uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34 \uCEE4\uBC84\uB97C \uBC14\uAFB8\uB294 \uBC95\uC744\\n\uAC00\uB974\uCCD0 \uC900 \uBCF4\uB2F5\uC73C\uB85C\\r\\n\uC81C\uBC95 \uC26C\uC6B4 \uBB38\uC81C\uB4E4\uB85C \uC900\uBE44\uD588\uB2E4.[VAR 0114(0029)]",
  "\uB2E4\uB4E4 \uCD94\uAC00 \uC2DC\uD5D8\uC744 \uBC1B\uC9C0 \uC54A\uAE30 \uC704\uD574\\n\uCD5C\uC120\uC744 \uB2E4\uD588\uC744 \uAC70\uB77C \uBBFF\uB294\uB2E4.[VAR 0114(0029)]",
  "\uB3CC\uC544\uAC00\uAE30 \uC804\uC5D0\\n\uC811\uC218\uCC98\uC5D0\uC11C \uC810\uC218\uB97C \uB4E3\uACE0 \uAC00\uB3C4\uB85D.[VAR 0114(0029)]"
]
