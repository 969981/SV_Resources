[
  "\uC0AC\uCC9C\uC655 \uBF40\uC090\uC5D0\uAC8C \uB3C4\uC804\uD558\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uAE30\uAECF \uC81C2\uC2DC\uD5D8\uAE4C\uC9C0 \uC640 \uC8FC\uC168\uC9C0\uB9CC\\n\uC624\uBE60\uB791\uC740 \uC5EC\uAE30\uC11C \uBC14\uC774 \uBC14\uC774\uC608\uC694![VAR 0114(0014)]",
  "\uAE30\uAECF \uC81C2\uC2DC\uD5D8\uAE4C\uC9C0 \uC640 \uC8FC\uC168\uC9C0\uB9CC\\n\uC5B8\uB2C8\uB791\uC740 \uC5EC\uAE30\uC11C \uBC14\uC774 \uBC14\uC774\uC608\uC694![VAR 0114(0014)]",
  "\uBF40\uC090\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uC740\\n\uBAA8~\uB450 \uB2E8\uB2E8\uD574\uC694![VAR 0114(0014)]",
  "\uADF8\uB7EC\uB2C8\uAE4C \uB9D0\uB791~\uD55C \uACF5\uACA9\uC73C\uB85C\uB294\\n\uAFC8\uCA4D\uB3C4 \uC548 \uD560 \uAC70\uC608\uC694![VAR 0114(0014)]",
  "\uB098\uC640\uB77C~!\\n\uBF40\uC090\uC758 \uCE5C\uAD6C\uB4E4~![VAR 0114(0014)]",
  "\uC73C\uC559~! \uC73C\uC559~!\\n\uBF40\uC090, \uCE60\uB9AC \uC5B8\uB2C8\uC758 \uBAA9\uC218...\\r\\n\uC2E4\uD328\uD588\uC5B4\uC694~[VAR 0114(0014)]",
  "\uBAA9\uC218\uAC00 \uC544\uB2C8\uB77C \uBCF5\uC218\uC57C.\\n\uC544\uC9C1 \uC5F0\uC7A5\uC744 \uB2E4\uB8E8\uAE30\uC5D4 \uB10C \uB108\uBB34 \uC5B4\uB9AC\uB2E4\uACE0.[VAR 0114(0013)]",
  "\uC544\uBB34\uD2BC \uBF40\uC090,\\n\uC84C\uC73C\uB2C8\uAE4C \uB2E4\uC74C \uC0AC\uB78C\uC744 \uBD88\uB7EC\uC57C\uACA0\uC9C0?[VAR 0114(0013)]",
  "\uB9DE\uB2E4! \uC78A\uACE0 \uC788\uC5C8\uC5B4\uC694~!\\n\uC544\uC800\uC528\uB97C \uBD80\uB974\uB294 \uAC74 \uC9C4\uC9DC \uC624\uB79C\uB9CC\uC774\uB124\uC694![VAR 0114(0014)]",
  "\uC544\uC800\uC528~! \uB098\uC624\uC138\uC694~![VAR 0114(0014)]",
  "...\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C, \uCCAD\uBAA9\uC785\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC774\uC81C \uC0AC\uCC9C\uC655\uC758 \uC808\uBC18\uC744 \uC4F0\uB7EC\uB728\uB9B0 \uAC70\uC57C!\\n\uD6C4\uBC18\uC804\uB3C4 \uC5F4\uC2EC\uD788 \uD574 \uBD10![VAR 0114(0013)]",
  "\uCCAD\uBAA9 \uC544\uC800\uC528\uB294\\n\uC5C4~\uCCAD \uAD49\uC7A5\uD558\uB2E4\uAD6C\uC694![VAR 0114(0014)]"
