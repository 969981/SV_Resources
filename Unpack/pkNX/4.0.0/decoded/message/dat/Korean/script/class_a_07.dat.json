[
  "\uC5EC\uB7EC\uBD84 \uC548\uB155~\\n\uADF8\uB7FC, \uC218\uC5C5\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C\uC694~[VAR 0114(002A)]",
  "\uB2E4\uC74C\uC774 \uAE30\uB9D0\uACE0\uC0AC\uB2C8\uAE4C\\n\uC218\uC5C5\uC740 \uC624\uB298\uC774 \uB9C8\uC9C0\uB9C9\uC774\uC5D0\uC694.[VAR 0114(002A)]",
  "\uB9C8\uC9C0\uB9C9 \uC8FC\uC81C\uB294~ \uC9E0\uC9DC\uC794~\\n\uD3EC\uCF13\uBAAC\uC758 [VAR FF00(0006)]\uD3FC[VAR FF00(0000)]\uC5D0 \uB300\uD574\uC11C\uB78D\uB2C8\uB2E4~\\r\\n\uD3EC\uCF13\uBAAC\uC758 \uD615\uD0DC\uB77C\uACE0 \uC0DD\uAC01\uD558\uBA74 \uC26C\uC6B8 \uAC70\uC608\uC694.[VAR 0114(002A)]",
  "\uAC19\uC740 \uAC1C\uCCB4\uC778 \uD3EC\uCF13\uBAAC\uC774\\n\uD2B9\uC815\uD55C \uC870\uAC74\uC5D0\uC11C \uD3FC\uC744 \uBC14\uAFB8\uB294 \uAC83\uC744\\r\\n[VAR FF00(0006)]\uD3FC\uCCB4\uC778\uC9C0[VAR FF00(0000)]\uB77C\uACE0 \uBD80\uB978\uB2F5\uB2C8\uB2E4~[VAR 0114(002A)]",
  "\uC608\uB97C \uB4E4\uC5B4, \uD314\uB370\uC544\uC5D0\uC11C \uC77C\uBC18\uC801\uC73C\uB85C\\n\uD0C0\uACE0 \uB2E4\uB2C8\uB294 \uBAA8\uD1A0\uB9C8\uC5D0\uAC8C\uB294\\r\\n\uC138 \uAC00\uC9C0 \uD3FC\uC774 \uC788\uC5B4\uC694.[VAR 0114(002A)]",
  "\uD3C9\uC18C\uC5D0\uB294 \uC0AC\uC871 \uBCF4\uD589\uC778 \uB514\uD3F4\uD2B8\uD3FC,\\n\uBC30\uD2C0 \uC911\uC5D0\uB294 \uC774\uC871 \uBCF4\uD589\uC778 \uBC30\uD2C0\uD3FC,[VAR 0114(002A)]",
  "\uADF8\uB9AC\uACE0, \uC5EC\uB7EC\uBD84\uC744 \uD0DC\uC6B8 \uB54C\uB294\\n\uBAA9\uC758 \uC8FC\uBA38\uB2C8\uC640 \uAF2C\uB9AC\uB97C \uBD80\uD480\uB824\uC11C\\r\\n\uB77C\uC774\uB4DC\uD3FC\uC774 \uB41C\uB2F5\uB2C8\uB2E4~[VAR 0114(002A)]",
  "\uB610 \uAC00\uAE4C\uC6B4 \uACF3\uC5D0\uC11C \uCC3E\uC790\uBA74\\n\uC5EC\uB7EC\uBD84\uC774 \uAC00\uC9C0\uACE0 \uC788\uB294 \uAE30\uACC4...[VAR 0114(002A)]",
  "\uC2A4\uB9C8\uD2B8\uD3F0\uC5D0\uB3C4\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774 \uB4E4\uC5B4\uAC00 \uC788\uB2F5\uB2C8\uB2E4~[VAR 0114(002A)]",
  "\uC790 \uADF8\uB7FC, \uC2A4\uB9C8\uD2B8\uD3F0\uC5D0 \uB4E4\uC5B4 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC740 \uB204\uAD6C\uC77C\uAE4C\uC694~?[VAR 0114(002A)]",
  "\uB85C\uD1A0\uBB34!",
  "\uD53C\uCE74\uCE04!",
  "\uD5E4\uB77C\uD06C\uB85C\uC2A4!",
  "[VAR 0100(0000)][VAR 1900(0001)] \uAE30\uACC4\uB3C4\\n\uD3EC\uCF13\uBAAC\uB3C4 \uC544\uC8FC \uC798 \uC544\uB124\uC694~[VAR 0114(002A)]",
  "\uD655\uC2E4\uD788, \uD53C\uCE74\uCE04\uAC00 \uC2A4\uB9C8\uD2B8\uD3F0\uC5D0 \uB4E4\uC5B4 \uC788\uC73C\uBA74\\n\uADC0\uC5EC\uC6CC\uC11C \uACC4\uC18D \uAC78\uC5B4 \uB2E4\uB2C8\uACE0 \uC2F6\uACA0\uB124\uC694~\\r\\n...\uADF8\uB807\uC9C0\uB9CC, \uC815\uB2F5\uC740 \uC544\uB2C8\uC5D0\uC694~![VAR 0114(002A)]",
  "[VAR 0100(0000)], \uC0C1\uC0C1\uB825\uC774 \uB300\uB2E8\uD55C\uB370\uC694!\\n\uD5E4\uB77C\uD06C\uB85C\uC2A4\uAC00 \uC2A4\uB9C8\uD2B8\uD63C\uC774\uB77C\uB294\\r\\n\uAE30\uC220\uC744 \uBC30\uC6B0\uAE34 \uD558\uC8E0~\\r\\n...\uADF8\uB807\uC9C0\uB9CC, \uC815\uB2F5\uC740 \uC544\uB2C8\uC5D0\uC694~![VAR 0114(002A)]",
  "\uB9DE\uC544\uC694, \uC5EC\uB7EC\uBD84\uC758 \uC2A4\uB9C8\uD2B8\uD3F0\uC5D0\uB294\\n\uB85C\uD1A0\uBB34\uAC00 \uB4E4\uC5B4 \uC788\uC5B4\uC11C\\r\\n\uB2E4\uC591\uD55C \uB3C4\uC6C0\uC744 \uC8FC\uACE0 \uC788\uB2F5\uB2C8\uB2E4![VAR 0114(002A)]",
  "\uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34\uC758 \uB85C\uD1A0\uBB34\uB294 \uD2B9\uBCC4\uD574\uC11C\\n\uB2E4\uB978 \uC804\uC790 \uC81C\uD488 \uC548\uC5D0 \uB4E4\uC5B4\uAC00\uC9C0\uB294 \uC54A\uC9C0\uB9CC,[VAR 0114(002A)]",
  "\uC77C\uBC18\uC801\uC778 \uB85C\uD1A0\uBB34\uB294\\n\uC138\uD0C1\uAE30\uB098 \uC804\uC790\uB808\uC778\uC9C0\uC5D0 \uB4E4\uC5B4\uAC00\uC11C\\r\\n\uD3FC\uC744 \uBC14\uAFC0 \uC218\uB3C4 \uC788\uB2F5\uB2C8\uB2E4~[VAR 0114(002A)]",
  "\uB85C\uD1A0\uBB34\uAC00 \uC774\uB840\uC801\uC778 \uAC70\uACE0,\\n\uC77C\uBC18\uC801\uC73C\uB85C\uB294 \uC9C0\uB2CC \uBB3C\uAC74\uC774\uB098 \uB3C4\uAD6C\uC5D0 \uB530\uB77C\\r\\n\uD3FC\uC774 \uBCC0\uD558\uB294 \uD3EC\uCF13\uBAAC\uB4E4\uC774 \uB9CE\uC544\uC694.[VAR 0114(002A)]",
  "\uCDA4\uCD94\uC0C8\uB294 \uC8FC\uB294 \uAF43\uC758 \uAFC0\uC5D0 \uB530\uB77C\\n4\uAC00\uC9C0 \uD3FC\uC73C\uB85C \uBCC0\uD654\uD558\uB294\uB370,[VAR 0114(002A)]",
  "\uD3FC\uC774 \uBC14\uB00C\uBA74\\n\uD0C0\uC785\uC774\uB098 \uAE30\uC220\uC774 \uBC14\uB00C\uB294 \uAC1C\uCCB4\uB3C4 \uC788\uB2F5\uB2C8\uB2E4~[VAR 0114(002A)]",
  "\uD3FC\uCCB4\uC778\uC9C0\uB294 \uC9C4\uD654\uC640\uB294 \uB2E4\uB974\uAC8C\\n\uC6D0\uB798 \uBAA8\uC2B5\uC73C\uB85C \uB3CC\uC544\uAC08 \uC218 \uC788\uACE0,\\c\\n\uC0C9\uC774 \uB2E4\uB978 \uBAA8\uC2B5\uACFC\uB294 \uB2E4\uB974\uAC8C\\n\uAC19\uC740 \uAC1C\uCCB4\uC5D0\uC11C \uBAA8\uC2B5\uC774 \uBC14\uB010\uB2F5\uB2C8\uB2E4.[VAR 0114(002A)]",
  "\uD3FC\uCCB4\uC778\uC9C0...\\n\uC815\uB9D0 \uC2EC\uC624\uD55C \uD604\uC0C1 \uAC19\uC9C0 \uC54A\uB098\uC694?[VAR 0114(002A)]",
  "\uD3EC\uCF13\uBAAC\uC744 \uBCF8\uBC1B\uC544\uC11C...\uB294\\n\uC870\uAE08 \uC774\uC0C1\uD55C \uAC83 \uAC19\uC9C0\uB9CC,[VAR 0114(002A)]",
  "\uC5EC\uB7EC\uBD84\uB3C4 \uC774 \uD559\uAD50\uC5D0\uC11C\\n\uC5F4\uC2EC\uD788 \uB180\uACE0 \uACF5\uBD80\uD574\uC11C...[VAR 0114(002A)]",
  "\uC0C8\uB85C\uC6B4 \uC790\uC2E0\uC73C\uB85C \uD3FC\uCCB4\uC778\uC9C0!\\n\uD558\uBA74 \uC120\uC0DD\uB2D8\uC740 \uAE30\uC060 \uAC83 \uAC19\uC544\uC694!\\r\\n...\uD5E4\uD5E4![VAR 0114(002A)]",
  "\uC544\uCC28! \uAE5C\uBE61\uD588\uB2E4![VAR 0114(002A)]",
  "\uC9C0\uC5ED\uC5D0 \uB530\uB77C \uBAA8\uC2B5\uC774 \uB2E4\uB978\\n\uB9AC\uC804\uD3FC\uC740 \uC77C\uBC18\uC801\uC778 \uBAA8\uC2B5\uACFC\uB294 \uB2EC\uB77C\uC11C\\r\\n\uBC14\uAFC0 \uC218 \uC5C6\uB294 \uC120\uCC9C\uC801\uC778...[VAR 0114(002A)]",
  "...\uD5E4\uD5E4, \uC885\uC774 \uC6B8\uB9AC\uACE0 \uB9D0\uC558\uB124\uC694.[VAR 0114(002A)]",
  "\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC774\uB798\uC11C \uBA74\uBAA9 \uC5C6\uC9C0\uB9CC,\\c\\n\uC9C0\uAE08\uAE4C\uC9C0 \uAC19\uC774 \uACF5\uBD80\uD560 \uC218 \uC788\uC5B4\uC11C \uC990\uAC70\uC6E0\uC5B4\uC694!\\n\uAE30\uB9D0\uACE0\uC0AC\uC5D0\uC11C\uB3C4 \uD798\uB0B4\uC138\uC694~![VAR 0114(002A)]"
]
