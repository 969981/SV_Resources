[
  "\uD314\uC790\uD06C\uC785\uB2C8\uB2E4.\\n\uC624\uB298 \uC218\uC5C5\uB3C4 \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC9C0\uB09C \uC218\uC5C5\uC5D0\uC11C \uC788\uC5C8\uB358 \uC77C\uC740\\n\uC9C4\uC2EC\uC73C\uB85C \uC0AC\uACFC\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uB108\uBB34\uB098\uB3C4 \uAC10\uACA9\uC2A4\uB7EC\uC6B4 \uB098\uBA38\uC9C0\\n\uADF8\uB9CC \uB300\uC131\uD1B5\uACE1\uC744 \uD558\uACE0 \uB9D0\uC558\uB124\uC694...[VAR 0114(0012)]",
  "\uB05D\uB098\uACE0 \uD0C0\uC784 \uC120\uC0DD\uB2D8\uC5D0\uAC8C\\n\uD638\uB418\uAC8C \uD63C\uB098\uACE0 \uB9D0\uC558\uC9C0 \uBB61\uB2C8\uAE4C...[VAR 0114(0012)]",
  "\uC544\uBB34\uD2BC, \uC0C8\uB85C\uC6B4 \uB9C8\uC74C\uC73C\uB85C\\n\uC624\uB298\uC758 \uC218\uC5C5\uC744 \uC2DC\uC791\uD558\uB3C4\uB85D \uD558\uC9C0\uC694.[VAR 0114(0012)]",
  "\uC5EC\uB7EC\uBD84\uAED8\uC11C\uB294\\n\uD314\uB370\uC544 10\uACBD\uC5D0 \uB300\uD574 \uC54C\uACE0 \uACC4\uC2DC\uB098\uC694?[VAR 0114(0012)]",
  "\uC774\uB984 \uADF8\uB300\uB85C \uD314\uB370\uC544\uC9C0\uBC29\uC5D0\uC11C\\n\uACBD\uCE58\uAC00 \uC544\uB984\uB2E4\uC6B4 \uACF3\uC73C\uB85C \uBD88\uB9AC\uB294\\r\\n\uC120\uD0DD\uBC1B\uC740 10\uACF3\uC744 \uB9D0\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uADF8\uC911\uC5D0\uC11C \uC5EC\uB7EC\uBD84\uC774 \uC27D\uAC8C \uBCFC \uC218 \uC788\uB294 \uACF3\uC73C\uB85C\uB294\\n[VAR FF00(0006)]\uC62C\uB9AC\uBE0C \uB300\uB18D\uC6D0[VAR FF00(0000)]\uC774 \uC788\uACA0\uB124\uC694.[VAR 0114(0012)]",
  "\uC138\uB974\uD074\uB9C8\uC744\uB85C \uD5A5\uD558\uB294 \uB3C4\uC911\uC5D0 \uC788\uB294\\n\uC5B8\uB355\uC5D0\uC11C \uBC14\uB77C\uBCFC \uC218 \uC788\uB294\\r\\n\uB4DC\uB113\uC740 \uC62C\uB9AC\uBE0C\uBC2D\uC774 \uADF8\uAC83\uC785\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uD3ED\uD3EC\uB294 \uB450 \uACF3\uC774 \uC788\uB294\uB370,\\n[VAR FF00(0006)]\uB9C8\uAD6C\uCC0C\uB974\uAE30 \uD3ED\uD3EC[VAR FF00(0000)]\uC640\\r\\n[VAR FF00(0006)]\uC624\uC57C \uB300\uD3ED\uD3EC[VAR FF00(0000)]\uAC00 \uC788\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uADF8\uB9AC\uACE0, \uC774 \uC9C0\uBC29\uC5D0\uC11C \uAC00\uC7A5 \uD574\uBC1C \uACE0\uB3C4\uAC00 \uB192\uC740\\n\uB098\uD398\uC0B0\uC758 \uC815\uC0C1, [VAR FF00(0006)]\uD314\uB370\uC544 \uCD5C\uACE0\uBD09[VAR FF00(0000)]\uC774 \uC788\uC9C0\uC694.[VAR 0114(0012)]",
  "\uB9C8\uCC2C\uAC00\uC9C0\uB85C \uB098\uD398\uC0B0\uC5D0 \uC788\uB294 \uC5B4\uB5A4 \uC808\uBCBD\uC740,\\n\uADF8 \uD615\uD0DC \uB54C\uBB38\uC5D0 \uC5B4\uB5A4 \uC774\uB984\uC774 \uBD99\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uADF8\uB7FC, \uC5EC\uB7EC\uBD84\uAED8 \uC9C8\uBB38 \uD558\uB098 \uD558\uC9C0\uC694![VAR 0114(0012)]",
  "\uB098\uD398\uC0B0\uC5D0 \uC788\uB294 \uC138 \uAC08\uB798\uC758 \uC808\uBCBD,\\n\uADF8 \uC808\uBCBD\uC758 \uC774\uB984\uC740 \uB098\uD398\uC758 \uBB34\uC5C7\uC77C\uAE4C\uC694?\\r\\n\uC2E0\uCCB4 \uBD80\uC704\uAC00 \uC815\uB2F5\uC785\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC190",
  "\uADC0",
  "\uAF2C\uB9AC",
  "[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591!\\n\uD6CC\uB96D\uD55C \uC0C1\uC0C1\uB825\uC785\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uC138 \uAC08\uB798\uB85C \uAC08\uB77C\uC9C4 \uADC0\uB77C...\\n\uD3EC\uCF13\uBAAC \uB7ED\uD0A4\uC758 \uADC0\uC600\uB2E4\uBA74\\r\\n\uC815\uB2F5\uC774\uC5C8\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB124\uC694.[VAR 0114(0012)]",
  "\uC138 \uAC08\uB798\uB85C \uAC08\uB77C\uC9C4 \uAF2C\uB9AC\uB77C...\\n\uD3EC\uCF13\uBAAC \uCF04\uD0C0\uB85C\uC2A4\uC758 \uAF2C\uB9AC\uC600\uB2E4\uBA74\\r\\n\uC815\uB2F5\uC774\uC5C8\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB124\uC694.[VAR 0114(0012)]",
  "\uB098\uD398\uC0B0\uC5D0\uB294 [VAR FF00(0006)]\uB098\uD398\uC758 \uC190[VAR FF00(0000)]\uC774\uB77C \uBD88\uB9AC\uB294\\n\uC138 \uAC08\uB798 \uC808\uBCBD\uC774 \uC788\uB2F5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uADF8\uB7F0\uB370, \uC190\uC774\uB77C\uACE0 \uD558\uAE30\uC5D0\uB294\\n\uB108\uBB34\uB098\uB3C4 \uBB49\uB69D\uD574\uC11C, \uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC758\\r\\n\uC190\uC744 \uBE57\uB304 \uAC83\uC774 \uC544\uB2D0\uAE4C \uCD94\uCE21\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uADF8 \uBC16\uC5D0\uB3C4 \uB3D9\uBD80 \uC5D0\uB9AC\uC5B4 3\uC758 \uACE0\uC0B0 \uC9C0\uB300\uC5D0\uC11C\\n\uBC24\uC5D0 \uB204\uB8E9\uC2A4\uC2DC\uD2F0\uB97C \uB0B4\uB2E4\uBCFC \uC218 \uC788\uB294\uB370,[VAR 0114(0012)]",
  "\uADF8\uACF3\uC5D0\uC11C \uBC14\uB77C\uBCF4\uB294 \uACBD\uCE58\uB97C\\n[VAR FF00(0006)]100\uB9CC\uBCFC\uD2B8\uC758 \uC57C\uACBD[VAR FF00(0000)]\uC774\uB77C \uBD80\uB974\uACE0 \uC788\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC18C\uBB38\uC5D0 \uC758\uD558\uBA74, \uB530\uB048\uB530\uB048\uD55C \uCEE4\uD50C\uB4E4\uC5D0\uAC8C\\n\uC778\uAE30 \uB9CC\uC810\uC778 \uC7A5\uC18C\uB77C\uB354\uAD70\uC694.[VAR 0114(0012)]",
  "\uC80A\uC740 \uC138\uB300\uC758 \uB9D0\uC744 \uBE4C\uB9AC\uC790\uBA74\\n\uC140\uCE74 \uBA85\uC18C...\uB77C\uACE0 \uD560 \uC218 \uC788\uACA0\uB124\uC694.[VAR 0114(0012)]",
  "...10\uACBD\uC774\uB77C \uBD80\uB974\uACE0 \uC788\uC9C0\uB9CC\\n\uC138\uC0C1\uC5D0\uB294 \uB9C9\uC0C1 \uAC00 \uBCF4\uBA74 \uC2E4\uB9DD\uD558\uAC8C \uB418\uB294\\r\\n\uAD00\uAD11 \uBA85\uC18C\uAC00 \uC218\uC5C6\uC774 \uC874\uC7AC\uD569\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uAC00\uC9C0 \uB9D0\uB77C\uB294 \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4\uB9CC,\\n\uB108\uBB34 \uAE30\uB300\uD558\uC9C0\uB294 \uC54A\uC73C\uC2DC\uB294 \uAC83\uC774 \uC88B\uC744 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC790\uC2E0\uC758 \uBC1C\uB85C \uAC00\uC11C \uC790\uC2E0\uC758 \uB208\uC73C\uB85C\\n\uC9C1\uC811 \uD655\uC778\uD558\uB294 \uAC83\uC740 \uC911\uC694\uD558\uB2C8\uAE4C\uC694.[VAR 0114(0012)]",
  "\uC2E4\uB9DD\uC2A4\uB7EC\uC6B4 \uCCB4\uD5D8\uB3C4 \uB098\uC058\uC9C0\uB294 \uC54A\uC744 \uAC81\uB2C8\uB2E4.\\n...\uAE30\uD68C\uAC00 \uB41C\uB2E4\uBA74, \uD55C\uBC88 \uC18D\uC544 \uBCF4\uC2DC\uC9C0\uC694.[VAR 0114(0012)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0!\\n\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4![VAR 0114(0012)]"
]
