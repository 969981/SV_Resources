[
  "\uBCF4\uC6B8\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uB3C4\uC804\uC790\uC758 \uC774\uB984\uC744\\n\uB4F1\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4...\\r\\n[VAR 0100(0000)] \uB2D8\uC774\uC2DC\uAD70\uC694!",
  "\uC774\uACF3\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5 \uCF5C\uC0AC \uB2D8\uACFC\\n\uC2B9\uBD80\uD558\uB824\uBA74 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C\\r\\n\uD074\uB9AC\uC5B4\uD574\uC57C \uD569\uB2C8\uB2E4.",
  "\uBCF4\uC6B8\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB294...\\n[VAR FF00(0006)]\uD574\uB8E8\uBBF8 \uBAA8\uC73C\uAE30[VAR FF00(0000)]!",
  "\uBCF4\uC6B8\uC740 \uC608\uC220\uC758 \uB9C8\uC744...\\c\\n\uADF8\uB798\uC11C \uC791\uD488\uC758 \uBAA8\uD2F0\uBE0C\uAC00 \uB418\uB294 \u201C\uC790\uC5F0\u201D\uACFC\\n\uC790\uC5F0\uC744 \uC131\uC7A5\uC2DC\uD0A4\uB294 \u201C\uD0DC\uC591\u201D\uC744 \uAE30\uB9AC\uAE30 \uC704\uD574\\c\\n\uB450 \uC694\uC18C\uB97C \uBAA8\uB450 \uAC00\uC9C4 \uD574\uB8E8\uBBF8\uB97C \uBAA8\uC544\uC11C\\n\uADF9\uC9C4\uD558\uAC8C \uB300\uC811\uD558\uB294 \uD48D\uC2B5\uC774 \uC788\uC2B5\uB2C8\uB2E4.",
  "[VAR 0100(0000)] \uB2D8\uAED8\uC11C\uB294 \uBCF4\uC6B8\uB9C8\uC744\uC5D0\uC11C\\n\uD574\uB2D8 \uAC19\uC740 \uAF43 \uBAA8\uC591\uC758 \uD3EC\uCF13\uBAAC\\r\\n\uD574\uB8E8\uBBF8\uB97C \uCC3E\uC740 \uB2E4\uC74C,",
  "[VAR 0201(0001)]\uB9C8\uB9AC\uB97C \uBAA8\uC544\\n\uD574\uB8E8\uBBF8 \uAD11\uC7A5\uC73C\uB85C \uB370\uB824\uAC00\uC2DC\uBA74\\r\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uD074\uB9AC\uC5B4\uC785\uB2C8\uB2E4!",
  "\uBA3C\uC800 \uD574\uB8E8\uBBF8 \uAD11\uC7A5\uC758 \uC704\uCE58\uB97C\\n\uC9C0\uB3C4\uC5D0 \uB4F1\uB85D\uD574 \uB4DC\uB9B4 \uD14C\uB2C8\\c\\n\uAD11\uC7A5\uC5D0 \uC788\uB294 \uC2A4\uD0DC\uD504\uC5D0\uAC8C\\n\uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.\\c\\n\uCCB4\uC721\uAD00\uC744 \uB098\uAC00\uC11C \uBC14\uB85C \uC624\uB978\uCABD\uC5D0 \uC788\uB294\\n\uCEE4\uB2E4\uB780 \uD574\uB8E8\uBBF8 \uC624\uBE0C\uC81C\uB85C \uAC00\uC2DC\uBA74 \uB429\uB2C8\uB2E4!",
  "\uADF8\uB7FC, \uB2E4\uB140\uC624\uC138\uC694!"
]
