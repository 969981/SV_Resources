  "[VAR 0100(0000)][VAR 1900(0001)] \uC120\uC0DD\uB2D8\uC73C\uB85C\uBD80\uD130\\n[VAR 0204(0001,0000)]BP\uB97C \uBC1B\uC558\uB2E4!",
  "\uAD50\uD658 \uC720\uD559 \uC628 \uD559\uC0DD\uC774\uC9C0?\\n\uB098\uB294 \uD559\uC0DD \uC9C0\uB3C4 \uC120\uC0DD\uB2D8\uC774\uC57C!",
  "\uB2E8\uB3C4\uC9C1\uC785\uC801\uC73C\uB85C \uBB3C\uC5B4\uBCF4\uB294 \uAC74\uB370\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB294 \uC5F4\uC2EC\uD788 \uD558\uACE0 \uC788\uB2C8!?",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C\uB294 \uD559\uC0DD \uAC04\uC758\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD65C\uC131\uD654\uD558\uAE30 \uC704\uD574\\c\\n\uB3D4 \uC548\uC5D0\uC11C \uB2E4\uB978 \uD559\uC0DD\uACFC\\n\uB9CE\uC774 \uC2B9\uBD80\uD560 \uB54C\uB9C8\uB2E4\\r\\nBP\uB97C \uC120\uBB3C\uD558\uACE0 \uC788\uB2E8\uB2E4!",
  "\uC6B0\uC120 \uC5EC\uAE30 \uC774 \uC0AC\uBC14\uB098 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uD559\uC0DD [VAR 0201(0002)]\uBA85\uC744 \uC774\uAE30\uACE0 \uC624\uB834!",
  "\uC6B0\uC120 \uC5EC\uAE30 \uC774 \uCE90\uB2C8\uC5B8 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uD559\uC0DD [VAR 0201(0002)]\uBA85\uC744 \uC774\uAE30\uACE0 \uC624\uB834!",
  "\uC6B0\uC120 \uC5EC\uAE30 \uC774 \uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uD559\uC0DD [VAR 0201(0002)]\uBA85\uC744 \uC774\uAE30\uACE0 \uC624\uB834!",
  "\uC6B0\uC120 \uC5EC\uAE30 \uC774 \uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uD559\uC0DD [VAR 0201(0002)]\uBA85\uC744 \uC774\uAE30\uACE0 \uC624\uB834!",
  "\uC0AC\uBC14\uB098 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uB124\uAC00 \uC774\uAE34 \uD559\uC0DD \uC218\uB294...\\r\\n[VAR 0201(0003)]\uBA85\uC774\uAD6C\uB098!",
  "\uCE90\uB2C8\uC5B8 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uB124\uAC00 \uC774\uAE34 \uD559\uC0DD \uC218\uB294...\\r\\n[VAR 0201(0003)]\uBA85\uC774\uAD6C\uB098!",
  "\uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uB124\uAC00 \uC774\uAE34 \uD559\uC0DD \uC218\uB294...\\r\\n[VAR 0201(0003)]\uBA85\uC774\uAD6C\uB098!",
  "\uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uB124\uAC00 \uC774\uAE34 \uD559\uC0DD \uC218\uB294...\\r\\n[VAR 0201(0003)]\uBA85\uC774\uAD6C\uB098!",
  "\uC804\uBD80 \uB2E4 \uD574\uC11C [VAR 0201(0002)]\uBA85\uC744 \uC774\uAE30\uBA74\\n\uB610 \uCC3E\uC544\uC624\uB834!",
  "\uC5F4\uC2EC\uD788 \uD558\uACE0 \uC788\uAD6C\uB098!\\n\uC801\uADF9\uC801\uC73C\uB85C \uC2B9\uBD80\uD558\uB294 \uBAA8\uC2B5\uC774 \uAE30\uD2B9\uD55C\uAC78!",
  "\uB9CE\uC774 \uB178\uB825\uD588\uC73C\uB2C8\uAE4C \uC0C1\uC73C\uB85C\\nBP\uB97C \uC120\uBB3C\uD574 \uC904\uAC8C!",
  "\uBCF4\uB108\uC2A4\uB85C \uC774\uAC83\uB3C4 \uC904\uAC8C!",
  "\uB2E4\uC74C \uBAA9\uD45C\uB294...\\n[VAR 0201(0002)]\uBA85\uC744 \uC774\uAE30\uB294 \uAC74\uB370\\r\\n\uC774\uBBF8 \uB2EC\uC131\uD588\uAD6C\uB098!?",
  "\uC2E4\uCEF7 \uC2B9\uBD80\uD558\uACE0\\n\uB610 \uC0C1\uD488\uC744 \uBC1B\uC73C\uB7EC \uC624\uB834!",
  "\uC124\uB9C8... \uB108!\\c\\n\uC0AC\uBC14\uB098 \uC5D0\uB9AC\uC5B4\uC5D0 \uC788\uB294\\n\uBAA8\uB4E0 \uD559\uC0DD\uB4E4\uC744 \uC774\uAE34 \uAC83 \uAC19\uC740\uB370!",
  "\uC124\uB9C8... \uB108!\\c\\n\uCE90\uB2C8\uC5B8 \uC5D0\uB9AC\uC5B4\uC5D0 \uC788\uB294\\n\uBAA8\uB4E0 \uD559\uC0DD\uB4E4\uC744 \uC774\uAE34 \uAC83 \uAC19\uC740\uB370!",
  "\uC124\uB9C8... \uB108!\\c\\n\uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4\uC5D0 \uC788\uB294\\n\uBAA8\uB4E0 \uD559\uC0DD\uB4E4\uC744 \uC774\uAE34 \uAC83 \uAC19\uC740\uB370!",
  "\uC124\uB9C8... \uB108!\\c\\n\uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uC5D0 \uC788\uB294\\n\uBAA8\uB4E0 \uD559\uC0DD\uB4E4\uC744 \uC774\uAE34 \uAC83 \uAC19\uC740\uB370!",
  "\uC5B4\uB9C8\uC5B4\uB9C8\uD558\uAC8C \uB178\uB825\uD55C \uB108\uC5D0\uAC8C\\n\uC774 \uC0C1\uC744 \uC8FC\uB3C4\uB85D \uD560\uAC8C!",
  "\uADF8\uB9AC\uACE0 \uC5B4\uB9C8\uC5B4\uB9C8\uD55C \uBCF4\uB108\uC2A4\uB3C4 \uBC1B\uC544 \uC918!",
  "\uB2E4\uB978 \uC5D0\uB9AC\uC5B4\uC5D0\uB3C4 \uC120\uC0DD\uB2D8\uC774 \uACC4\uC2DC\uB2C8\uAE4C\\n\uAC70\uAE30\uC11C\uB3C4 \uC5F4\uC2EC\uD788 \uD558\uB834!",
  "\uBAA8\uB4E0 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uBAA8\uB4E0 \uD559\uC0DD\uC744 \uC4F0\uB7EC\uB728\uB9B0 \uB108\uC5D0\uAC8C\\r\\n\uC120\uC0DD\uB2D8\uC774 \uB3D4 \uCD5C\uC6B0\uC218\uC0C1\uC744 \uC904\uAC8C!",
  "\uC55E\uC73C\uB85C\uB3C4 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C\\n\uB9CE\uC774 \uC990\uACA8 \uC8FC\uB834!",
  "\uC0AC\uBC14\uB098 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C\\n\uBAA8\uB4E0 \uD559\uC0DD\uB4E4\uC744 \uC774\uAE30\uB2E4\uB2C8 \uAD49\uC7A5\uD574!",
  "\uCE90\uB2C8\uC5B8 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C\\n\uBAA8\uB4E0 \uD559\uC0DD\uB4E4\uC744 \uC774\uAE30\uB2E4\uB2C8 \uAD49\uC7A5\uD574!",
  "\uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C\\n\uBAA8\uB4E0 \uD559\uC0DD\uB4E4\uC744 \uC774\uAE30\uB2E4\uB2C8 \uAD49\uC7A5\uD574!",
  "\uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uC5D0\uC11C \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C\\n\uBAA8\uB4E0 \uD559\uC0DD\uB4E4\uC744 \uC774\uAE30\uB2E4\uB2C8 \uAD49\uC7A5\uD574!"
