[
  "\uC544\uC790! \uC2E4\uB840\uD569\uB2C8\uB2E4!![VAR 0114(0024)]",
  "\uB728\uAC70\uC6B4 \uD53C\uAC00 \uD750\uB974\uB294 \uC6B4\uD5A5\uC774\uB2E4!\\n\uD568\uAED8 \uD22C\uC9C0\uB97C \uBD88\uD0DC\uC6CC \uBCF4\uC790\uACE0![VAR 0114(0024)]",
  "\uC548\uB155! \uC804\uD559\uC0DD!\\n\uB124\uAC00 \uB098\uB97C \uCD08\uB300\uD574 \uC900 \uAC70\uAD6C\uB098![VAR 0114(0024)]",
  "\uC0C8\uB85C\uC6B4 \uC77C\uC5D0 \uB3C4\uC804\uD560 \uC0DD\uAC01\uC744 \uD558\uB2C8\uAE4C\\n\uD53C\uAC00 \uB9C9 \uB053\uC5B4\uC624\uB974\uB294 \uAC83 \uAC19\uC544![VAR 0114(0024)]",
  "\uC774\uACF3\uC5D0 \uB098\uB97C \uBD80\uB978 \uB370\uB294\\n\uBB54\uAC00 \uC774\uC720\uAC00 \uC788\uB294 \uAC70\uACA0\uC9C0?[VAR 0114(0024)]",
  "\uADF8\uB798, \uB098\uC5D0\uAC8C\uC11C \uC6D0\uD558\uB294 \uAC8C \uBB50\uC57C!?[VAR 0114(0024)]",
  "\uC5F4\uD608\uC774\uC694!",
  "\uC9C0\uC2DD\uC774\uC694!",
  "\uADF8\uB0E5 \uC788\uC5B4 \uC8FC\uC2DC\uAE30\uB9CC \uD574\uB3C4 \uB3FC\uC694",
  "\uC624\uC624! \uADF8\uAC74 \uB0B4 \uC804\uBB38 \uBD84\uC57C\uB77C\uACE0!\\c\\n\uB098\uC758 \uB728\uAC70\uC6B4 \uD53C\uB85C \uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uB97C\\n\uD65C\uD65C \uD0C0\uC624\uB974\uAC8C \uB9CC\uB4E4\uC5B4 \uC904\uAC8C![VAR 0114(0024)]",
  "\uC624\uC624!\\n\uBC30\uD2C0\uD559\uC5D0 \uAD00\uD55C \uC9C0\uC2DD\uC744 \uAE30\uB300\uD55C \uAC70\uAD6C\uB098!\\c\\n\uC5ED\uC2DC \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC5D0 \uD798\uC744 \uC3DF\uB294\\n\uC544\uCE74\uB370\uBBF8\uB77C\uC11C \uADF8\uB7F0\uAC00![VAR 0114(0024)]",
  "\uBB50\uC57C, \uADF8\uAC8C!\\n\uBB34\uC2A8 \uC77C\uC774\uC57C, \uC804\uD559\uC0DD!\\r\\n\uC774\uC81C \uADF8\uB7F4 \uB098\uC774\uAC00 \uB41C \uAC70\uC57C!?[VAR 0114(0024)]",
  "\uBB50, \uC5B4\uCC0C \uB410\uB4E0\\n\uC774 \uB728\uAC70\uC6B4 \uD53C\uAC00 \uD750\uB974\uB294 \uC6B4\uD5A5 \uC120\uC0DD\uB2D8\uB9CC \uBBFF\uC5B4![VAR 0114(0024)]",
  "\uD558\uB9AC\uBB49\uC758 \uC5B4\uAE68 \uC704\uC5D0 \uC62C\uB77C\uD0D4\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0\\n\uC548\uC2EC\uD574\uB3C4 \uB3FC![VAR 0114(0024)]",
  "\uC804\uD559\uC0DD!\\n\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC774\uB77C\uB294 \uACF3\uC740 \uAD49\uC7A5\uD558\uB358\uB370![VAR 0114(0024)]",
  "\uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758\\n\uC6B4\uB3D9\uC7A5 \uAC19\uC740 \uACF3\uC774\uC5C8\uC5B4![VAR 0114(0024)]",
  "\uD0C1 \uD2B8\uC5EC \uC788\uC5B4\uC11C\\n\uB7EC\uB2DD\uD558\uAE30\uC5D0 \uC544\uC8FC \uC81C\uACA9\uC774\uB354\uB77C\uACE0![VAR 0114(0024)]",
  "\uB2E4\uC74C \uC218\uC5C5\uC740 \uC2E4\uC804 \uD615\uC2DD\uC73C\uB85C\\n\uB3D4 1\uBC14\uD034 \uB2EC\uB9AC\uAE30\uB97C \uD574 \uBCFC\uAE4C \uD558\uB294\uB370\\r\\n\uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD574?[VAR 0114(0024)]",
  "\uC88B\uC740 \uC0DD\uAC01\uC774\uC5D0\uC694!",
  "\uADF8\uAC74 \uC880...",
  "\uADF8\uB807\uC9C0? \uD558\uCCB4\uAC00 \uB2E8\uB828\uB418\uB2C8\uAE4C\\n\uB098\uC060 \uAC74 \uD558\uB098\uB3C4 \uC5C6\uC744 \uAC70\uB77C\uACE0![VAR 0114(0024)]",
  "\uC5ED\uC2DC \uB108\uBB34 \uB098\uAC14\uB098?\\n\uADF8\uB0E5 \uB0B4\uAC00 \uB2EC\uB9AC\uACE0 \uC2F6\uC5B4\uC11C \uADF8\uB7AC\uB098 \uBD10!\\c\\n\uC5B4\uCA54 \uC218 \uC5C6\uB124...\\n\uBC18 \uBC14\uD034\uB9CC \uB3C4\uB294 \uAC78\uB85C \uD574\uC57C\uC9C0![VAR 0114(0024)]",
  "\uBB3C\uB860 \uB108\uB3C4 \uAC19\uC774 \uCC38\uC5EC\uD558\uB294 \uAC70\uC57C![VAR 0114(0024)]",
  "\uC774 \uC544\uCE74\uB370\uBBF8\uC758 \uD559\uC0DD\uB4E4\uC740\\n\uB2E4\uB4E4 \uC758\uC695\uC774 \uB118\uCE58\uB358\uB370![VAR 0114(0024)]",
  "\uD2B9\uD788 \uBC30\uD2C0\uD559 \uC218\uC5C5\uC744 \uB4E3\uB294\\n\uD559\uC0DD\uB4E4\uC758 \uC9D1\uC911\uB825\uC774 \uC815\uB9D0 \uB300\uB2E8\uD588\uC5B4![VAR 0114(0024)]",
  "\uB4E3\uC790 \uD558\uB2C8, \uC774 \uC544\uCE74\uB370\uBBF8\uB294\\n\uBC30\uD2C0\uACFC \uAD00\uB828\uB41C \uC218\uC5C5\uC77C\uC218\uB85D\\r\\n\uC131\uC801 \uBE44\uC911\uC774 \uB192\uB2E4\uB354\uB77C\uACE0![VAR 0114(0024)]",
  "\uD558\uAE34, \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uC798\uD558\uBA74\\n\uB9AC\uADF8\uC5D0\uC11C \uC77C\uD558\uAE30 \uD3B8\uD558\uACE0, \uB808\uC778\uC800 \uBD80\uB300\uB098\\r\\n\uD504\uB85C \uD2B8\uB808\uC774\uB108\uB3C4 \uB178\uB824\uBCFC \uC218 \uC788\uC73C\uB2C8\uAE4C![VAR 0114(0024)]",
  "\uAFC8\uC73C\uB85C \uAC00\uB4DD\uD558\uB124\uC694!",
  "\uADF8\uB7F0 \uAC70\uC600\uC5B4\uC694!?",
  "\uBB3C\uB860, \uB098 \uAC19\uC740\\n\uBC30\uD2C0\uD559 \uAD50\uC0AC\uB3C4 \uB178\uB824\uBCFC \uC218 \uC788\uACE0![VAR 0114(0024)]",
  "\uC73C\uC74C!? \uCC98\uC74C \uB4E3\uB294\uB2E4\uACE0!?\\c\\n\uADF8\uAC83\uB3C4 \uBAA8\uB974\uACE0 \uCC54\uD53C\uC5B8\uAE4C\uC9C0 \uB410\uB2E4\uB2C8\\n\uC815\uB9D0\uB85C \uD3EC\uCF13\uBAAC\uC744 \uC88B\uC544\uD558\uB294\uAD6C\uB098![VAR 0114(0024)]",
  "\uBC30\uD2C0\uD559\uC774\uB4E0 \uB2E4\uB978 \uACFC\uBAA9\uC774\uB4E0\\n\uACF5\uBD80\uB97C \uC5F4\uC2EC\uD788 \uD558\uBA74\\r\\n\uC120\uD0DD\uC9C0\uAC00 \uBB34\uD55C\uD788 \uB113\uC5B4\uC9C4\uB2E4\uAD6C![VAR 0114(0024)]",
  "\uD6C4\uD68C\uAC00 \uB0A8\uC9C0 \uC54A\uAC8C\\n\uC804\uD559\uC0DD\uB3C4 \uB9CE\uC774 \uBC30\uC6CC \uB46C![VAR 0114(0024)]",
  "...\uC5B4\uC9F8 \uC870\uAE08\\n\uC124\uAD50\uD558\uB294 \uAC83\uCC98\uB7FC \uB418\uC5B4 \uBC84\uB838\uB124![VAR 0114(0024)]",
  "\uAD50\uC0AC\uB85C\uC11C\uB3C4 \uC804\uC6B0\uB85C\uC11C\uB3C4\\n\uB124\uAC00 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4\uC11C \uADF8\uB7F0\uAC00 \uBD10.[VAR 0114(0024)]",
  "\uADF8\uB7F0 \uB73B\uC5D0\uC11C, \uCE5C\uBD84\uB3C4 \uC313\uC744 \uACB8\\n\uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD558\uC9C0 \uC54A\uC744\uB798!?[VAR 0114(0024)]",
  "\uC88B\uC544! \uC2DC\uC791\uD558\uC790!\\n\uB098\uB294 \uC694\uAC00\uB791\uC744 \uC904\uAC8C!\\r\\n\uC804\uD559\uC0DD\uC740 \uC5B4\uB5A4 \uC544\uC774\uB97C \uC904\uB798?[VAR 0114(0024)]",
  "[VAR 0101(0001)][VAR 1900(0006)]\uB77C!\\n\uAE30\uD569\uC774 \uB290\uAEF4\uC9C0\uB294 \uAC83 \uAC19\uACE0 \uC88B\uC740\uB370!\\c\\n\uB9E4\uC77C \uAC19\uC774 \uD2B8\uB808\uC774\uB2DD\uD574\uC11C\\n\uBAB0\uB77C\uBCFC \uC815\uB3C4\uB85C \uAC15\uD558\uAC8C \uB9CC\uB4E4\uAC8C![VAR 0114(0024)]",
  "\uC804\uD559\uC0DD\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uB0B4 \uC694\uAC00\uB791\uC744 \uAD50\uD658\uD558\uB294 \uAC70\uB124![VAR 0114(0024)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uC744 \uD560 \uC218 \uC5C6\uC5B4!\\c\\n2\uB9C8\uB9AC \uC774\uC0C1 \uC900\uBE44\uB418\uBA74\\n\uB2E4\uC2DC \uB9D0\uD574 \uC918![VAR 0114(0024)]",
  "\uC9C0\uAE08\uC740 \uD558\uACE0 \uC2F6\uC9C0 \uC54A\uB2C8?\\n\uB9C8\uC74C\uC774 \uBC14\uB00C\uBA74 \uB2E4\uC2DC \uB9D0\uD574 \uC918![VAR 0114(0024)]",
  "\uC548\uB155! \uC804\uD559\uC0DD!\\c\\n\uB098\uC640 \uD3EC\uCF13\uBAAC \uAD50\uD658\uC744\\n\uC2DC\uC791\uD560 \uB9C8\uC74C\uC774 \uB4E4\uC5C8\uB2C8!?[VAR 0114(0024)]",
  "\uC548\uB155! \uC804\uD559\uC0DD!\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uAC00 \uD558\uACE0 \uC2F6\uC5B4\uC11C \uBD88\uB800\uB2C8!?[VAR 0114(0024)]",
  "\uC774\uB7F0! \uADF8\uAC8C \uC544\uB2C8\uC5C8\uAD6C\uB098...\\n\uC2B9\uBD80 \uC2E0\uCCAD\uC774\uB77C\uBA74 \uC5B8\uC81C\uB4E0\uC9C0 \uBC1B\uC544 \uC904\uAC8C![VAR 0114(0024)]",
  "\uB098\uC57C \uAC70\uC808\uD560 \uC774\uC720\uAC00 \uC5C6\uC9C0!\\n\uADF8\uB7FC, \uBC30\uD2C0\uCF54\uD2B8\uAE4C\uC9C0 \uB2EC\uB824\uAC00\uC790![VAR 0114(0024)]",
  "[~ 62]",
  "\uBD84\uD558\uB2E4...!\\n\uB610 \uB098\uC758 \uC644\uD328\uB124![VAR 0114(0024)]",
  "\uD558\uC9C0\uB9CC \uD070 \uC218\uD655\uB3C4 \uC788\uC5C8\uC5B4!\\n\uC774 \uACBD\uD5D8\uC744 \uD1A0\uB300\uB85C \uB2E4\uC74C\uC5D4 \uC774\uAE30\uACA0\uC5B4![VAR 0114(0024)]",
  "\uC804\uD559\uC0DD\uC5D0\uAC8C \uC2E0\uC138 \uC9C4 \uBCF4\uB2F5\uC774\uC57C!\\n\uB0B4 \uB9C8\uC74C\uC774\uB2C8\uAE4C \uBC1B\uC544 \uC918![VAR 0114(0024)]",
  "\uD0C0\uC6B0\uB9B0\uC744 \uB2E8\uC228\uC5D0 \uB4E4\uC774\uD0A4\uACE0\\n\uC11D\uC591\uC744 \uD5A5\uD574 \uB2EC\uB9AC\uB294 \uAC70\uC57C![VAR 0114(0024)]",
  "[~ 62]",
  "\uC774\uBC88 \uC2DC\uD569\uB3C4 \uC88B\uC558\uC5B4!\\n\uACE0\uB9C8\uC6CC! \uC804\uD559\uC0DD![VAR 0114(0024)]",
  "\uB2E4\uC74C\uC5D0\uB294 \uC774\uBC88\uCC98\uB7FC \uB418\uC9C0 \uC54A\uC744 \uAC70\uC57C!\\n\uC11D\uC591\uC744 \uD5A5\uD574 \uC544\uC790![VAR 0114(0024)]",
  "\uC774\uBC88\uC5D0\uB294 \uB0B4\uAC00 \uC774\uACBC\uB124!\\n\uBC30\uD2C0\uD559 \uAD50\uC0AC\uC758 \uCCB4\uBA74\uC744 \uC9C0\uCF1C\uC11C \uB2E4\uD589\uC774\uC57C!\\c\\n\uBC14\uB2E4\uB97C \uBC14\uB77C\uBCF4\uBA74\\n\uD328\uBC30\uD55C \uBD84\uD568\uC744 \uC0BC\uD0AC \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(0024)]",
  "\uB9AC\uADF8\uBD80 \uBD80\uC2E4\uC740\\n\uC80A\uC740\uC774\uB4E4\uB85C \uC641\uC790\uC9C0\uAEC4\uD558\uB124!\\r\\n\uADF8\uC57C\uB9D0\uB85C \uCCAD\uCD98\uC758 \uD55C\uBCF5\uD310\uC778\uAC78![VAR 0114(0024)]",
  "\uB098 \uB9D0\uC774\uC9C0,\\n\uC0AC\uC2E4 \uBE44\uD589\uAE30 \uD0C0\uB294 \uAC78 \uC88B\uC544\uD558\uC9C0 \uC54A\uC544...\\c\\n\uADF8\uB798\uC11C \uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uAE4C\uC9C0 \uC624\uB294 \uB370\\n\uC5C4\uCCAD\uB09C \uAE30\uD569\uC774 \uD544\uC694\uD588\uC5B4.[VAR 0114(0024)]",
  "\uC2B9\uBD80\uD558\uB294 \uC911\uC5D0\uB3C4\\n\uBAB8\uC744 \uB2E8\uB828\uD560 \uC218 \uC788\uC5B4!\\c\\n\uB2E4\uC74C\uC5D0 \uBC30\uD2C0\uD560 \uB54C \uB098\uB97C \uC798 \uBD10 \uBD10!\\n\uB098\uB97C \uB530\uB77C \uD558\uBA74 \uC2EC\uD3D0 \uAE30\uB2A5\uC744 \uB192\uC77C \uC218 \uC788\uB2E4\uAD6C![VAR 0114(0024)]",
  "\uC804\uD559\uC0DD\uC774 \uC900 [VAR 0101(0001)][VAR 1900(0001)]\\n\uC624\uB298\uB3C4 \uAE30\uC6B4\uC774 \uB118\uCE58\uB358\uB370!\\c\\n\uB0B4\uAC00 \uB9CC\uB4E0 \uC0CC\uB4DC\uC704\uCE58\uB3C4\\n\uB9DB\uC788\uAC8C \uBA39\uC5B4 \uC92C\uC5B4![VAR 0114(0024)]",
  "\uB0B4\uAC00 \uAD50\uD658\uD574 \uC900 \uC694\uAC00\uB791\uC740 \uC798 \uC9C0\uB0B4!?\\n\uADF8 \uC544\uC774\uB294 \uD380\uCE58\uAC00 \uD2B9\uAE30\uC57C!\\c\\n\uC5B4\uB5A0\uD55C \uAC15\uC801\uC744 \uC0C1\uB300\uD558\uB354\uB77C\uB3C4\\n\uB2E4\uC591\uD55C \uC8FC\uBA39\uC73C\uB85C \uBD84\uC1C4\uD560 \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(0024)]"
]
