[
  "\uD314\uC790\uD06C\uC785\uB2C8\uB2E4.\\n\uC624\uB298 \uC218\uC5C5\uB3C4 \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC138\uC6D4\uC740 \uD654\uC0B4\uACFC\uB3C4 \uAC19\uB2E4![VAR 0114(0012)]",
  "\uC2DC\uAC04\uC774 \uBE60\uB974\uAC8C \uD750\uB978\uB2E4\uB294 \uC774 \uB9D0\uCC98\uB7FC,\\n\uD6C4\uBC18\uAE30 \uC218\uC5C5\uB3C4 \uC774\uBC88\uC774 \uB9C8\uC9C0\uB9C9\uC785\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC624\uB298 \uC5EC\uB7EC\uBD84\uC5D0\uAC8C \uC804\uD560 \uB0B4\uC6A9\uC740\\n\uC608\uC220\uACFC\uB294 \uC0B4\uC9DD\\r\\n\uAC70\uB9AC\uAC00 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB124\uC694.[VAR 0114(0012)]",
  "\uD558\uC9C0\uB9CC \uC608\uC220\uC774\uB780 \uC774\uB798\uC57C \uD55C\uB2E4\uACE0\\n\uC815\uC758 \uB0B4\uB9B4 \uC218 \uC5C6\uB294 \uAC83\uC774\uB2C8,[VAR 0114(0012)]",
  "\uAC1C\uC758\uCE58 \uC54A\uACE0 \uC774\uC57C\uAE30\uD558\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC5EC\uB7EC\uBD84\uC774 \uAE30\uC5B5\uD558\uC2E4 \uAC83\uC740 \uC774 \uB450 \uAC00\uC9C0!\\n\uB9AC\uBCF8! ...\uADF8\uB9AC\uACE0 \uC99D\uD45C\uC785\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uB9AC\uBCF8\uB3C4 \uC99D\uD45C\uB3C4 \uADF8 \uD3EC\uCF13\uBAAC\uC744\\n\uB098\uD0C0\uB0B4\uB294 \uCE6D\uD638\uC640\uB3C4 \uAC19\uC740 \uAC83.[VAR 0114(0012)]",
  "\uB9AC\uBCF8\uC740 \uD3EC\uCF13\uBAAC\uC774 \uB178\uB825\uD558\uAC70\uB098\\n\uC5B4\uB5A4 \uACBD\uD5D8\uC744 \uC313\uC73C\uBA74,[VAR 0114(0012)]",
  "\uADF8 \uC131\uACFC\uB97C \uC778\uC815\uD558\uB294 \uB73B\uC73C\uB85C\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uB2EC\uC544 \uC8FC\uB294 \uAC83\uC785\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC608\uB97C \uB4E4\uC5B4, \uD2B8\uB808\uC774\uB108\uC640\\n\uCD5C\uACE0\uB85C \uCE5C\uD574\uC9C4 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB294\\r\\n\uC808\uCE5C\uB9AC\uBCF8\uC744 \uB2EC\uC544 \uC904 \uC218 \uC788\uC9C0\uC694.[VAR 0114(0012)]",
  "\uCC38\uACE0\uB85C \uC808\uCE5C\uB9AC\uBCF8\uC758 \uC2EC\uC0AC\uC6D0\uC740\\n\uCE74\uB77C\uD504\uC2DC\uD2F0\uC5D0 \uACC4\uC2E0\uB2F5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uBC18\uBA74\uC5D0 \uC99D\uD45C\uB294\\n\uB300\uBD80\uBD84\uC774 \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB0AC\uC744 \uB54C\\r\\n\uC774\uBBF8 \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC83\uC785\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC7A5\uB09C\uAFB8\uB7EC\uAE30\uC99D\uD45C\uB098\\n\uAE30\uB825\uC758\uC99D\uD45C \uB4F1,\\r\\n\uADF8 \uD3EC\uCF13\uBAAC\uC758 \uC131\uC9C8\uC744 \uB098\uD0C0\uB0B4\uB294 \uAC83\uC774\uC9C0\uC694.[VAR 0114(0012)]",
  "\uC99D\uD45C\uAC00 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC744\\n\uB9CC\uB098\uB294 \uAC83\uC740 \uC628\uC804\uD788 \uC6B4![VAR 0114(0012)]",
  "\uC99D\uD45C\uAC00 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC558\uB2E4\uBA74\\n\uC544\uC8FC \uC6B4\uC774 \uC88B\uC73C\uC2E0 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uCC38\uACE0\uB85C! \uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uB9AC\uBCF8\uC774\uB098 \uC99D\uD45C\uAC00 \uC788\uC73C\uBA74\\n\uD560 \uC218 \uC788\uB294 \uC544\uC8FC \uC0B4\uC9DD \uAE30\uC05C \uC77C\uC774 \uC788\uB294\uB370,\\r\\n\uBB54\uC9C0 \uC544\uC2DC\uB098\uC694?[VAR 0114(0012)]",
  "\uB9AC\uBCF8 \uAD50\uD658",
  "\uC790\uB791\uD560 \uC218 \uC788\uB2E4",
  "\uD638\uCE6D\uC744 \uBC14\uAFC0 \uC218 \uC788\uB2E4",
  "...\uC544\uC27D\uC9C0\uB9CC \uB9AC\uBCF8\uC774\uB098 \uC99D\uD45C\uB294\\n\uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC8FC\uAC70\uB098\\r\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uB2F5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC790\uB791\uD560 \uC218 \uC788\uB2E4\uB77C!\\n\uC544\uC8FC \uC9C0\uB2F9\uD558\uC2E0 \uB9D0\uC500\uC774\uC9C0\uB9CC\\r\\n\uADF8\uAC83\uB9CC\uC73C\uB85C \uB9CC\uC871\uD558\uC2DC\uBA74 \uC548 \uB429\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uC5ED\uC2DC [VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591!\\n\uC9C0\uC2DD\uC774 \uD48D\uBD80\uD558\uC2DC\uAD70\uC694.[VAR 0114(0012)]",
  "\uB9AC\uBCF8\uC774\uB098 \uC99D\uD45C\uAC00 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC740![VAR 0114(0012)]",
  "\uC2B9\uBD80\uC5D0 \uB0B4\uBCF4\uB0BC \uB54C\\n\uC6D0\uD558\uB294 \uD638\uCE6D\uC73C\uB85C \uBD80\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC608\uB97C \uB4E4\uC5B4, \uC808\uCE5C\uB9AC\uBCF8\uC744 \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\u201C\uAC00\uB78F! \uC808\uCE5C \uB525\uC0C1\uC5B4\uB3D9!\u201D\\r\\n...\uC774\uB77C\uB294 \uC2DD\uC73C\uB85C \uBD80\uB97C \uC218 \uC788\uB294 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uADF8\uB9AC\uACE0 \uC880 \uC804\uC5D0\\n\uC99D\uD45C\uB294 \uB300\uBD80\uBD84\uC774 \uB9CC\uB0AC\uC744 \uB54C\\r\\n\uAC00\uC9C0\uACE0 \uC788\uB294 \uAC83\uC774\uB77C \uC124\uBA85\uD588\uC2B5\uB2C8\uB2E4\uB9CC...[VAR 0114(0012)]",
  "\uCD5C\uADFC\uC5D0\uB294 \uB178\uB825 \uC5EC\uD558\uC5D0 \uB530\uB77C\\n\uC5BB\uC744 \uC218 \uC788\uB294 \uC99D\uD45C\uB3C4 \uC788\uB2E4\uACE0 \uD569\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uBBF8\uC2DD\uAC00\uC758\uC99D\uD45C...\\n\uC2B5\uB4DD\uC758\uC99D\uD45C...\\r\\n\uD30C\uD2B8\uB108\uC758\uC99D\uD45C \uB4F1\uB4F1,[VAR 0114(0012)]",
  "\uC774\uB984\uC744 \uD78C\uD2B8 \uC0BC\uC544 \uC870\uC0AC\uD574 \uBCF4\uB294 \uAC83\uB3C4\\n\uD558\uB098\uC758 \uC5EC\uD765\uC774 \uB418\uC2E4 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC774\uAC78\uB85C \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uB3C4\\n\uBAA8\uB450 \uB05D\uC774 \uB0AC\uC2B5\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uB2E4\uC74C \uC2DC\uAC04\uC740 \uAE30\uB9D0\uACE0\uC0AC\uC785\uB2C8\uB2E4.\\n\uD55C \uBC88\uC5D0 \uD1B5\uACFC\uD560 \uC218 \uC788\uB3C4\uB85D\\r\\n\uCCA0\uC800\uD788 \uBCF5\uC2B5\uD574 \uC8FC\uC138\uC694.[VAR 0114(0012)]"
]
