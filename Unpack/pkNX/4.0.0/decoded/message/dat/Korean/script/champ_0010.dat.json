[
  "\uADF8\uB7FC, \uCC54\uD53C\uC5B8 \uB124\uBAA8.\\n\uBBF8\uC548\uD558\uC9C0\uB9CC \uB300\uC2E0 \uC880 \uBD80\uD0C1\uB4DC\uB824\uC694.[VAR 0114(002C)]",
  "\uBBF8\uC548\uD558\uAE34\uC694, \uC624\uD788\uB824 \uAE30\uB300\uB418\uB294\uAC78\uC694!\\n\uB9E1\uACA8\uB9CC \uC8FC\uC138\uC694![VAR 0114(0004)]",
  "\uADF8\uB7FC, \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694.\\n\uB2E4\uC74C\uC5D0 \uB610 \uBD10\uC694.[VAR 0114(002C)]",
  "\uC74C...? \uC2E4\uB840\uD560\uAC8C\uC694.[VAR 0114(002C)]",
  "\uC544, [VAR 0100(0000)]![VAR 0114(0004)]",
  "\uBC29\uAE08 \uADF8 \uC0AC\uB78C\uC740?",
  "\uB300\uB2E8\uD574 \uBCF4\uC774\uB294 \uC0AC\uB78C\uC774\uB124...",
  "[VAR 0100(0000)]\uB3C4 \uAD81\uAE08\uD55C\uAC00 \uBCF4\uB124!\\n\uBC29\uAE08 \uADF8\uBD84\uC740 \uCE58\uD504\uB77C\uACE0 \uBD88\uB9AC\uB294 \uBD84\uC778\uB370\\c\\n\uC5C4\uCCAD\uB098\uAC8C \uAC15\uD558\uACE0, \uBA4B\uC9C0\uACE0,\\n\uB098\uC758 \uBAA9\uD45C\uC778...\\c\\n\uC774 \uC544\uB2C8\uB77C! \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB77C\uBA74\\n\uB204\uAD6C\uB098 \uB3D9\uACBD\uD558\uB294 \uBD84\uC774\uC154~![VAR 0114(0004)]",
  "\uB108\uB3C4 \uADF8\uB807\uAC8C \uB290\uAF08\uC5B4!?\\n\uBC29\uAE08 \uADF8\uBD84\uC740 \uCE58\uD504\uB77C\uACE0 \uBD88\uB9AC\uB294 \uBD84\uC778\uB370\\c\\n\uC5C4\uCCAD\uB098\uAC8C \uAC15\uD558\uACE0, \uBA4B\uC9C0\uACE0,\\n\uB098\uC758 \uBAA9\uD45C\uC778...\\c\\n\uC774 \uC544\uB2C8\uB77C! \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB77C\uBA74\\n\uB204\uAD6C\uB098 \uB3D9\uACBD\uD558\uB294 \uBD84\uC774\uC154~![VAR 0114(0004)]",
  "\uC544! \uADF8\uAC74 \uADF8\uB807\uACE0!\\n\uC544\uAE4C \uAD50\uC2E4\uC5D0\uC11C \uD588\uB358 \uC598\uAE30 \uB9D0\uC778\uB370![VAR 0114(0004)]",
  "\uB0B4 \uC9C8\uBB38\uC5D0 \uB3C4\uAC10 \uC644\uC131\uC774\\n\uBAA9\uD45C\uB77C\uACE0 \uB9D0\uD588\uC5C8\uC796\uC544!\\r\\n\uADF8\uAC83\uB3C4 \uC88B\uC9C0\uB9CC \uB9D0\uC774\uC57C...[VAR 0114(0004)]",
  "\uB0B4 \uC9C8\uBB38\uC5D0 \uAC15\uD55C \uD2B8\uB808\uC774\uB108\uAC00 \uB418\uB294 \uAC8C\\n\uBAA9\uD45C\uB77C\uACE0 \uB9D0\uD588\uC5C8\uC796\uC544!\\r\\n\uADF8\uB807\uB2E4\uBA74 \uB9D0\uC774\uC57C...[VAR 0114(0004)]",
  "\uB0B4 \uC9C8\uBB38\uC5D0 \uBAA9\uD45C\uAC00 \uBB54\uC9C0\\n\uBAA8\uB974\uACA0\uB2E4\uACE0 \uB9D0\uD588\uC5C8\uC796\uC544!\\r\\n\uADF8\uB807\uB2E4\uBA74 \uB9D0\uC774\uC57C...[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uB3C4\\n[VAR FF00(0006)]\uCC54\uD53C\uC5B8 \uB7AD\uD06C[VAR FF00(0000)]\uC5D0 \uB3C4\uC804\uD574 \uBCF4\uB294 \uAC74 \uC5B4\uB54C!?[VAR 0114(0004)]",
  "\uC88B\uC544!",
  "\uD750\uC74C...",
  "\uC624! \uC774\uAC70 \uC774\uC57C\uAE30\uAC00 \uBE60\uB978\uB370!\\n\uADF8\uB7FC \uC77C\uB2E8, \uADF8\uAC8C \uBB54\uC9C0 \uC124\uBA85\uD574 \uC904\uAC8C![VAR 0114(0004)]",
  "\uC5D0\uC5E5~! \uB108\uCC98\uB7FC \uAC15\uD55C \uC560\uAC00\\n\uC9C0\uB098\uCE58\uAE30\uC5D0\uB294 \uC544\uAE4C\uC6B4\uB370~![VAR 0114(0004)]",
  "\uCC54\uD53C\uC5B8 \uB7AD\uD06C\uB77C\uB294 \uAC74 \uB9D0\uC774\uC57C,\\n\uD3EC\uCF13\uBAAC\uC744 \uB2E8\uB828\uC2DC\uD0A4\uACE0\\r\\n\uAE30\uC220\uB85C \uC0AC\uB78C\uB4E4\uC744 \uB9E4\uB8CC\uC2DC\uD0A4\uB294\\r\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uC758 \uD504\uB85C\uB4E4\uC744 \uB9D0\uD558\uB294 \uAC70\uC57C![VAR 0114(0004)]",
  "\uD3EC\uCF13\uBAAC\uB9AC\uADF8\uC758 \uC778\uC815\uC744 \uBC1B\uC73C\uBA74\\n\uCC54\uD53C\uC5B8 \uB7AD\uD06C\uB77C \uBD88\uB9B4 \uC218 \uC788\uC5B4.[VAR 0114(0004)]",
  "\uCC54\uD53C\uC5B8 \uB7AD\uD06C\uC5D0 \uB3C4\uB2EC\uD558\uB824\uBA74\\n\uC218\uC5C5\uC744 \uBC1B\uAE30\uB9CC \uD574\uC11C\uB294 \uC548 \uB418\uACE0\\c\\n8\uAC1C\uC758 \uD3EC\uCF13\uBAAC\uCCB4\uC721\uAD00\uC5D0\uC11C \uC2B9\uB9AC\uD574\uC11C\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBAA8\uC544\uC57C \uD574![VAR 0114(0004)]",
  "\uBC30\uC9C0\uB97C \uBAA8\uB450 \uBAA8\uC73C\uBA74, \uD2B9\uBCC4\uD55C \uD14C\uC2A4\uD2B8...\\n\uCC54\uD53C\uC5B8 \uD14C\uC2A4\uD2B8\uC5D0 \uB3C4\uC804\uD560 \uC218 \uC788\uC5B4.[VAR 0114(0004)]",
  "\uADF8\uB9AC\uACE0 \uD14C\uC2A4\uD2B8\uC5D0\uC11C \uD569\uACA9\uD558\uBA74\\n\uC815\uC2DD\uC73C\uB85C \uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAC00 \uB418\uB294 \uAC70\uC57C![VAR 0114(0004)]",
  "\uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108 \uBAA8\uB450\uAC00 \uB3D9\uACBD\uD558\uB294\\n\uAD49\uC7A5\uD55C \uCE6D\uD638\uB77C\uAD6C~!\\r\\n...\uB0B4 \uC785\uC73C\uB85C \uB9D0\uD558\uB2C8\uAE4C \uC870\uAE08 \uBD80\uB044\uB7FD\uB124.[VAR 0114(0004)]",
  "\uB098\uB294 \uC9C0\uB09C\uBC88 \uBCF4\uBB3C\uCC3E\uAE30\uC5D0\uC11C\\n\uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAC00 \uB410\uC5B4![VAR 0114(0004)]",
  "\uC544, \uBCF4\uBB3C\uCC3E\uAE30\uB77C\uB294 \uAC74 \uB9D0\uC774\uC9C0, \uACE7 \uC2DC\uC791\uB420\\n\uD2B9\uBCC4\uD55C \uC790\uC728 \uD559\uC2B5 \uD504\uB85C\uADF8\uB7A8\uC744 \uB9D0\uD558\uB294 \uAC70\uC57C!\\r\\n\uC9C0\uB09C\uBC88 \uBCF4\uBB3C\uCC3E\uAE30\uB294 \uC785\uD559\uD558\uC790\uB9C8\uC790 \uD588\uC5C8\uACE0![VAR 0114(0004)]",
  "\uD559\uAD50 \uBC16\uC744 \uBAA8\uD5D8\uD558\uBA74\uC11C\\n\uC790\uC720\uB86D\uAC8C \uBC30\uC6B8 \uC218 \uC788\uC5B4\uC11C \uC815\uB9D0 \uC7AC\uBBF8\uC788\uB2E4\uAD6C![VAR 0114(0004)]",
  "\uADF8\uB54C \uC5BB\uC740 \uACBD\uD5D8\uB4E4\uC774\\n\uB098\uC758 \uBCF4\uBB3C\uC774\uC5C8\uB2E4\uACE0\uB098 \uD560\uAE4C?\\r\\n...\uC544\uC9C1 \uD655\uC2E0\uC740 \uBABB\uD558\uACA0\uC9C0\uB9CC.[VAR 0114(0004)]",
  "[VAR 0100(0000)][VAR 1900(0004)] \uD568\uAED8\uB77C\uBA74\\n\uB098\uB3C4 \uB354 \uAC15\uD574\uC9C8 \uC218 \uC788\uC744 \uAC70\uC57C...[VAR 0114(0004)]",
  "\uC77C\uB2E8 \uCCB4\uC721\uAD00\uC774 \uC788\uB294 \uC7A5\uC18C\uB97C\\n\uC9C0\uB3C4 \uC571\uC5D0 \uB4F1\uB85D\uD574 \uC904\uAC8C![VAR 0114(0004)]",
  "\uADF8\uB7FC \uD55C\uBC88 \uC0DD\uAC01\uD574 \uBD10![VAR 0114(0004)]"
]
