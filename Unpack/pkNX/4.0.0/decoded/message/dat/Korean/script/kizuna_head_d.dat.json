[
  "\uC2A4\uD0C0\uB354\uC2A4\uD2B8 \uB300\uC791\uC804\uC5D0\uC11C\uB294\\n\uC815\uB9D0 \uC218\uACE0 \uB9CE\uC73C\uC168\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uBAA8\uB780 \uC591\uC5D0 \uB300\uD55C \uCC98\uC6B0\uB3C4\\n\uC88B\uC740 \uBC29\uD5A5\uC73C\uB85C \uD574\uACB0\uC774 \uB3FC\uC11C\\r\\n\uAD50\uC7A5\uC73C\uB85C\uC11C \uD55C\uC2DC\uB984 \uB35C \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uBAA8\uB780 \uC591\uAED8\uC11C\\n\uB2F9\uC2E0\uC5D0\uAC8C \uB9E4\uC6B0 \uAC10\uC0AC\uD574 \uD558\uACE0 \uC788\uB354\uAD70\uC694.[VAR 0114(000A)]",
  "\uC774\uB7F0 \uAC83\uC744 \uBD80\uD0C1\uD558\uB294 \uAC8C \uC544\uB2C8\uB77C\uB294 \uAC74\\n\uC798 \uC54C\uACE0 \uC788\uC2B5\uB2C8\uB2E4\uB9CC...[VAR 0114(000A)]",
  "[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591, \uC55E\uC73C\uB85C\uB3C4 \uBAA8\uB780 \uC591\uACFC\\n\uBD80\uB514 \uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4 \uC8FC\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uBB3C\uB860\uC774\uC8E0!",
  "\uC774\uBBF8 \uCE5C\uAD6C\uC608\uC694!",
  "...\uB2F9\uC2E0\uC774 \uC804\uD559\uC744 \uC640\uC11C\\n\uC5BC\uB9C8\uB098 \uB2E4\uD589\uC778\uC9C0 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC774\uAC74 \uAD50\uC7A5\uC774 \uB4DC\uB9AC\uB294 \uC0C1\uC785\uB2C8\uB2E4.\\n\uC0AC\uC591\uD558\uC9C0 \uB9D0\uACE0 \uBC1B\uC544 \uC8FC\uC2DC\uC9C0\uC694.[VAR 0114(000A)]",
  "\uC5B8\uC81C\uB098 \uC9C0\uAE08\uCC98\uB7FC \uBA4B\uC9C4\\n[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591\uC73C\uB85C \uC788\uC5B4 \uC8FC\uC138\uC694.[VAR 0114(000A)]",
  "\uD074\uB77C\uBCA8 \uC120\uC0DD\uB2D8\uACFC\uC758\\n\uC720\uB300\uAC00 \uC2F9\uD144\uB2E4!"
