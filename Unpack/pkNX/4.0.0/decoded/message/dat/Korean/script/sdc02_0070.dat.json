[
  "[VAR 0100(0000)] \uC528![VAR 0114(0049)]",
  "\uC18C\uACE4\uC18C\uACE4...? (\uC624\uC2DC\uB290\uB77C \uD5E4\uB9E4\uC9C0\uB294 \uC54A\uC558\uC8E0?)[VAR 0114(0049)]",
  "\uB124!",
  "\uC18C\uACE4\uC18C\uACE4...!",
  "\uC18C\uACE4\uC18C\uACE4! (\uADF8\uAC70 \uB2E4\uD589\uC774\uB124\uC694!)[VAR 0114(0049)]",
  "...\uC18C\uACE4? (...\uBB50\uB77C\uAD6C\uC694?)[VAR 0114(0049)]",
  "\uC5EC\uB7EC\uBD84, \uC54C\uB85C\uB77C!\\n\uADF8\uB7FC, \uC218\uC5C5\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C\uC694!",
  "\uCC98\uC74C \uC218\uC5C5\uC744 \uB4E3\uB294 \uC0AC\uB78C\uB3C4 \uC788\uB294 \uAC83 \uAC19\uB124\uC694!",
  "\uC774\uACF3 \uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4\uB294\\n\uC5F4\uB300 \uC12C \uAC19\uC740 \uD658\uACBD\uC744\\r\\n\uC778\uACF5\uC801\uC73C\uB85C \uC7AC\uD604\uD55C \uACF3\uC774\uC5D0\uC694.",
  "\uADF8\uB9AC\uACE0 \uC774\uACF3\uC5D0\uB294\\n\uB530\uB73B\uD55C \uAE30\uD6C4\uC5D0 \uC801\uC751\uD55C \uD3EC\uCF13\uBAAC\uC774\\r\\n\uB9CE\uC774 \uC0B4\uACE0 \uC788\uB2F5\uB2C8\uB2E4.",
  "\uAC1C\uC911\uC5D0\uB294 \uD3C9\uC18C\uBCF4\uB2E4 \uB9CE\uC740 \uBE5B\uC744 \uCB10\uC5B4\\n\uB2E4\uB978 \uC9C0\uBC29\uC5D0\uC11C\uBCF4\uB2E4\\r\\n\uD06C\uAC8C \uC131\uC7A5\uD55C \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uC5B4\uC694!",
  "\uB9DE\uC544\uC694! \uAC19\uC740 \uD3EC\uCF13\uBAAC\uC774\uB77C\uB3C4 \uC9C0\uBC29\uC5D0 \uB530\uB77C\\n\uBAA8\uC2B5\uC774 \uB2E4\uB978 [VAR FF00(0006)]\uB9AC\uC804\uD3FC[VAR FF00(0000)]\uC744 \uB9D0\uD558\uB294 \uAC70\uC608\uC694!",
  "\uC790, \uADF8\uB7FC \uC774\uC81C \uC2E4\uC804\uC73C\uB85C \uB118\uC5B4\uAC00\uC11C\\n[VAR FF00(0006)]\uC54C\uB85C\uB77C\uC758 \uBAA8\uC2B5[VAR FF00(0000)]\uC774\uB77C \uBD88\uB9AC\uB294\\r\\n\uB9AC\uC804\uD3FC \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC544 \uBCFC\uAE4C\uC694!",
  "\uC7A1\uC740 \uD559\uC0DD\uC740\\n\uC81C\uAC8C \uBCF4\uC5EC \uC8FC\uC138\uC694!",
  "\uADF8\uB7FC, \uC2DC\uC791!",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uB294\\n\uC2E4\uC2B5 \uC704\uC8FC\uC758 \uC218\uC5C5\uC774 \uB9CE\uC544\uC694.[VAR 0114(0049)]",
  "\uADF8\uB7FC, \uCCAB \uBC88\uC9F8 \uC218\uC5C5\\n\uC5F4\uC2EC\uD788 \uD574 \uBD10\uC694![VAR 0114(0049)]",
  "\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC744 \uCC3E\uC544\uC57C \uD560\uC9C0 \uC544\uC2DC\uACA0\uC5B4\uC694?\\c\\n\uAE30~\uB2E4\uB797\uAC8C \uC131\uC7A5\uD55C \uB098\uC2DC\uAC00\\n\uAC00\uC7A5 \uC798 \uC54C\uB824\uC9C4 \uC54C\uB85C\uB77C\uC758 \uBAA8\uC2B5\uC774\uC5D0\uC694![VAR 0114(0049)]",
  "\uADF8\uAC70 \uC54C\uC544?\\n\uC54C\uB85C\uB77C\uC758 \uB2E5\uD2B8\uB9AC\uC624\uB294\\r\\n\uC218\uC5FC \uAC19\uC740 \uAC8C \uB3CB\uC544\uB098 \uC788\uB300!",
  "\uC5F4\uB300 \uC9C0\uBC29\uC778 \uC54C\uB85C\uB77C\uC9C0\uBC29\uC5D0\uC11C\uB294\\n\u201C\uC54C\uB85C\uB77C\u201D\uAC00 \uC778\uC0AC\uB9D0\uC774\uC57C!",
  "\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774 \uC54C\uB85C\uB77C\uC758 \uBAA8\uC2B5\uC774\uB354\uB77C?"
]
