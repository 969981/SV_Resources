[
  "\uC5EC\uB7EC\uBD84, \uB2E4\uB4E4 \uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uBAA8\uB4E0 \uC2DC\uD569\uC774 \uD2B8\uB808\uC774\uB108\uC640\\n\uD3EC\uCF13\uBAAC \uAC04\uC758 \uC720\uB300\uAC00 \uBE5B\uC744 \uBC1C\uD558\uB294\\r\\n\uB208\uC744 \uB5C4 \uC218 \uC5C6\uB294 \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4...[VAR 0114(000A)]",
  "\uC804\uD1B5\uC73C\uB85C\uBD80\uD130 \uBC30\uC6B0\uBA70\\n\uAC15\uD558\uACE0 \uD06C\uAC8C \uC790\uB77C\uC790![VAR 0114(000A)]",
  "\uAC1C\uAC1C\uC778\uC758 \uAC1C\uC131\uC744 \uC18C\uC911\uD788 \uD558\uBA70\\n\uBBF8\uB798\uB97C \uAC1C\uCC99\uD558\uC790![VAR 0114(000A)]",
  "\uC6B0\uB9AC \uC624\uB80C\uC9C0 \uC544\uCE74\uB370\uBBF8\uC758 \uAD50\uD6C8\uC744\\n\uC798 \uBCF4\uC5EC \uC8FC\uB294 \uD6CC\uB96D\uD55C \uB300\uD68C\uC600\uC2B5\uB2C8\uB2E4![VAR 0114(000A)]",
  "\uC6B0\uB9AC \uADF8\uB808\uC774\uD504 \uC544\uCE74\uB370\uBBF8\uC758 \uAD50\uD6C8\uC744\\n\uC798 \uBCF4\uC5EC \uC8FC\uB294 \uD6CC\uB96D\uD55C \uB300\uD68C\uC600\uC2B5\uB2C8\uB2E4![VAR 0114(000A)]",
  "...\uAD50\uC7A5\uC758 \uB9D0\uC740 \uAE38\uC5B4\uC9C0\uAE30 \uC2ED\uC0C1\uC774\uB2C8\\n\uC774\uCBE4\uC5D0\uC11C \uB9C8\uBB34\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uADF8\uB7FC, \uD2B9\uBCC4 \uAC8C\uC2A4\uD2B8\uC774\uC2E0 \uD14C\uC0AC \uC774\uC0AC\uC7A5\uB2D8\uAED8\\n\uD55C\uB9C8\uB514 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uD2B8\uB808\uC774\uB108 \uBD84\uB4E4\uC758 \uC5F4\uC815\uACFC \uB178\uB825!\\n\uADF8\uB9AC\uACE0, \uBAA8\uC5EC \uC8FC\uC2E0 \uBD84\uB4E4\uC758 \uC751\uC6D0\uACFC \uACA9\uB824![VAR 0114(0011)]",
  "\uBAA8\uB4E0 \uAC83\uC774 \uC774 \uD559\uAD50...[VAR 0114(0011)]",
  "\uB354 \uB098\uC544\uAC00 \uD314\uB370\uC544\uC9C0\uBC29\uC744 \uD65C\uAE30\uCC28\uAC8C \uB9CC\uB4DC\uB294\\n\uCD5C\uACE0\uC758 \uC6D0\uB3D9\uB825\uC774\uB77C\uACE0 \uB290\uAF08\uC2B5\uB2C8\uB2E4.[VAR 0114(0011)]",
  "\uADF8\uB9AC\uACE0 \uCC54\uD53C\uC5B8 [VAR 0100(0000)][VAR 1900(0001)]\\n\uCD5C\uC885 \uD14C\uC2A4\uD2B8 \uB54C\uBCF4\uB2E4\uB3C4 \uB354 \uAC15\uD588\uC2B5\uB2C8\uB2E4...[VAR 0114(0011)]",
  "\uD604\uC7AC \uC704\uCE58\uC5D0 \uC548\uC8FC\uD558\uC9C0 \uC54A\uACE0\\n\uC790\uC2E0\uC744 \uB354\uC6B1 \uAC08\uACE0\uB2E6\uC740 \uAC83\uC785\uB2C8\uB2E4.[VAR 0114(0011)]",
  "\uB354\uC6B1 \uAC15\uD574\uC9C0\uACE0 \uC2F6\uB2E4\uB294\\n\uC5EC\uB7EC\uBD84\uB4E4\uC758 \uB728\uAC70\uC6B4 \uC57D\uB3D9\uC774\\r\\n\uD314\uB370\uC544\uC758 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB3C4 \uC804\uD574\uC838\uC11C...[VAR 0114(0011)]",
  "\uD55C \uC0AC\uB78C, \uB610 \uD55C \uC0AC\uB78C\\n\uBBF8\uB798\uC758 \uCC54\uD53C\uC5B8\uC774 \uC2F9\uC744 \uD2D4\uC6B0\uAC8C \uB420 \uADF8\uB0A0\uC744[VAR 0114(0011)]",
  "\uC9C4\uC2EC\uC73C\uB85C \uAE30\uB300\uD558\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0011)]",
  "\uC774\uC0AC\uC7A5\uB2D8, \uAC10\uC0AC\uD569\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC774\uAC83\uC73C\uB85C\\n\uB300\uD68C\uB97C \uB9C8\uCE58\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4!\\r\\n...\uB77C\uACE0 \uB9D0\uC500\uB4DC\uB9AC\uB824 \uD588\uC2B5\uB2C8\uB2E4\uB9CC,[VAR 0114(000A)]",
  "\uC798\uD558\uBA74, \uD559\uC0DD\uBD84\uB4E4\uACFC \uC120\uC0DD\uB2D8\uB4E4\uC758 \uAD50\uB958\uB294 \uBB3C\uB860\\n\uC9C0\uC5ED \uD65C\uC131\uD654\uC5D0\uB3C4 \uB3C4\uC6C0\uC774 \uB420 \uAC83 \uAC19\uB354\uAD70\uC694.\\r\\n\uB530\uB77C\uC11C...[VAR 0114(000A)]",
  "\uBC30\uD2C0 \uC2A4\uCFE8 \uC6CC\uC988\uB294 \uC55E\uC73C\uB85C\uB3C4!\\n\uC815\uAE30\uC801\uC73C\uB85C \uAC1C\uCD5C\uD558\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(000A)]",
  "\uC640~! \uC640~!\\n\uAD50\uC7A5 \uC120\uC0DD\uB2D8 \uCD5C\uACE0~!",
  "\uB2E4\uC74C\uC5D0\uB294 \uB098\uB3C4 \uB098\uAC00 \uBCFC\uAE4C...?",
  "\uB9CC\uC138~![VAR 0114(0004)]",
  "\uB2E4\uC74C\uC5D0\uB294 \uB124\uBAA8 \uC591\uB3C4\\n\uCD9C\uC804\uD574 \uBCF4\uC2DC\uC8E0.[VAR 0114(000A)]",
  "\uB124! \uAF2D \uB098\uAC08\uAC8C\uC694![VAR 0114(0004)]",
  "\uADF8\uB7FC, \uC774\uAC83\uC73C\uB85C \uC81C1\uD68C\\n\uBC30\uD2C0 \uC2A4\uCFE8 \uC6CC\uC988\uB97C \uC885\uB8CC\uD558\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(000A)]",
  "\uB2E4\uC74C \uB300\uD68C\uB3C4 \uAE30\uB300\uD574 \uC8FC\uC2ED\uC2DC\uC624!\\n\uB2E4\uB4E4 \uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4![VAR 0114(000A)]",
  "\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4~!"
]
