[
  "\uD0C0\uB85C \uC120\uBC30\uB294 \uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD574\\n\uCE5C\uC808\uD558\uAC8C \uAC00\uB974\uCCD0 \uC918!",
  "\uD0C0\uB85C\uB294 \uB9E4\uC77C \uC138 \uBC88\uC529\\n\uD3EC\uCF13\uBAAC \uC6CC\uC2DC\uB97C \uD558\uACE0 \uC788\uC5B4.\\r\\n\uADF8\uB798\uC120\uC9C0 \uD3EC\uCF13\uBAAC\uC774 \uC5B8\uC81C \uBD10\uB3C4 \uAE54\uB054\uD574.",
  "\uC81C\uC544\uBB34\uB9AC \uB4DC\uB798\uACE4\uD0C0\uC785\uC774 \uAC15\uD558\uB2E4 \uD574\uB3C4\\n\uD398\uC5B4\uB9AC\uC758 \uD798 \uC55E\uC5D0\uC11C\uB294 \uAF3C\uC9DD\uB3C4 \uBABB \uD55C\uB2E4\uAD6C!",
  "\uD0C0\uC785\uC73C\uB85C\uB294 \uC774\uAE38 \uC218 \uC788\uC744 \uD150\uB370\\n\uD0C0\uB85C\uB294 \uC81C\uBE48\uD55C\uD14C \uD55C \uBC88\uB3C4 \uC774\uAE34 \uC801\uC774 \uC5C6\uB300.",
  "\uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4\uC758 \uB9E4\uB825\uC740 \uBC14\uB2E4\uC57C!\\n\uC9C4\uC9DC \uBC14\uB2F7\uBB3C\uC744 \uC0AC\uC6A9\uD558\uACE0 \uC788\uC5B4.",
  "\uB3D4\uC758 \uD734\uAC8C\uC18C\uC5D0\uB294\\n\uC790\uB3D9\uD310\uB9E4\uAE30\uAC00 \uC788\uB294\uB370\\r\\n\uADF8\uAC78\uB85C \uB2E4\uC591\uD55C \uBCFC\uC744 \uC0B4 \uC218 \uC788\uC5B4!",
  "\uD5E4\uC5C4\uCE58\uB294 \uD3EC\uCF13\uBAAC\uC740\\n\uB2E4\uC774\uBE0C\uBCFC\uB85C \uC27D\uAC8C \uC7A1\uC744 \uC218 \uC788\uC5B4.",
  "\uBE14\uB85D\uC774 \uBAA8\uC5EC \uC788\uB294 \uACF3 \uC911\uC5D0\uC11C\\n\uADDC\uBAA8\uAC00 \uC791\uC740 \uACF3\uC740 \uD734\uAC8C\uC18C!\\r\\n\uD070 \uACF3\uC740 \uC2A4\uD018\uC5B4\uB77C\uACE0 \uBD88\uB7EC!",
  "\uD558\uC194\uC758 \uC694\uB9AC\uB294 \uAD49\uC7A5\uD574!\\n\uB9C8\uADF8\uB9C8\uBC88\uC758 \uBD88\uAF43\uC73C\uB85C \uC2DD\uC7AC\uB8CC\uB97C \uC775\uD788\uAC70\uB4E0!",
  "\uBD88\uAF43\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC740\\n\uD654\uC0C1 \uC0C1\uD0DC\uAC00 \uB418\uC9C0 \uC54A\uC544!\\r\\n\uC774 \uC810\uC744 \uC54C\uC544 \uB450\uBA74 \uB0A8\uB4E4\uBCF4\uB2E4 \uC55E\uC124 \uC218 \uC788\uC5B4!",
  "\uC0AC\uBC14\uB098 \uC5D0\uB9AC\uC5B4\uB294\\n\uC904\uBBA4\uB9C8\uAC00 \uC788\uC5B4\uC11C \uCD5C\uACE0\uC57C!\\c\\n\uB2E4\uB978 \uC5D0\uB9AC\uC5B4\uB85C \uB118\uC5B4\uAC00\uBA74\\n\uB9CC\uB0A0 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774 \uBC14\uB00C\uAC8C \uB3FC!",
  "\uC0AC\uCC9C\uC655\uC804\uC740 \uAC01 \uC2A4\uD018\uC5B4\uC758\\n\uBC30\uD2C0\uCF54\uD2B8\uC5D0\uC11C \uC5F4\uB9AC\uACE0 \uC788\uC5B4!",
  "\uBE14\uB8E8\uBCA0\uB9AC\uADF8\uB294 \uB7AD\uD06C\uAC00 \uB192\uC544\uC9C0\uAE30 \uC804\uAE4C\uC9C0\uB294\\n\uC0AC\uCC9C\uC655\uC5D0\uAC8C \uB3C4\uC804\uC870\uCC28 \uD560 \uC218 \uC5C6\uC5B4.",
  "\uD1B1\uCE58\uB294 \uC9C4\uD654\uD558\uBA74\\n\uB4DC\uB798\uACE4\uD0C0\uC785\uC774 \uCD94\uAC00\uB3FC!\\r\\n\uC5B4\uC9F8\uC11C\uC778 \uAC78\uAE4C? \uC815\uB9D0 \uC2E0\uAE30\uD558\uB2E8 \uB9D0\uC774\uC9C0~",
  "\uD68C\uBCF5 \uBA38\uC2E0\uC744 \uC0AC\uC6A9\uD560 \uB54C\\n\uB4A4\uC5D0 \uC0AC\uB78C\uC774 \uC788\uC73C\uBA74 \uAD1C\uD788 \uAE34\uC7A5\uB3FC...!",
  "\uB124\uB9AC\uB124 \uB2D8\uC740 \uC815\uB9D0 \uCFE8\uD558\uACE0 \uBA4B\uC838!\\n\uD559\uC0DD\uD68C\uC7A5\uC778\uB370\uB2E4 \uC0AC\uCC9C\uC655\uC774\uAE30\uB3C4 \uD558\uACE0 \uB9D0\uC774\uC57C!",
  "\uCE90\uB2C8\uC5B8 \uC5D0\uB9AC\uC5B4\uC5D0\uB294\\n\uC6B0\uB77D\uBD80\uB77D\uD55C \uD3EC\uCF13\uBAAC\uB4E4\uC774 \uB9CE\uC544!\\c\\n\uC0AC\uCC9C\uC655 \uB124\uB9AC\uB124\uB3C4\\n\uAC15\uCCA0\uD3EC\uCF13\uBAAC\uC744 \uC0AC\uC6A9\uD558\uACE0 \uC788\uC9C0!",
  "\uBB34\uC7A5\uC870\uB77C\uB294 \uD3EC\uCF13\uBAAC\uC740\\n\uC57D\uC810\uC774 \uC801\uC5B4\uC11C \uC0C1\uB300\uD558\uAE30 \uAE4C\uB2E4\uB85C\uC6CC!\\c\\n\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC5D0\uC11C\uB294\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB85C\uB3C4 \uD65C\uC57D\uD558\uACE0 \uC788\uC5B4!",
  "\uC5B4\uB5A4 \uC9C0\uBC29\uC5D0\uB294\\n\uC544\uBA38\uAE4C\uC624\uC758 \uCC9C\uC801\uC774 \uC788\uB2E4\uB098 \uBD10.\\c\\n\uBD84\uBA85\uD788 \uC5C4\uCCAD \uBB34\uC12D\uAC8C \uC0DD\uAE34\\n\uD3EC\uCF13\uBAAC\uC77C \uAC70\uC57C!",
  "\uB458 \uB2E4 \uC544\uBA38\uAE4C\uC624\uB97C \uC88B\uC544\uD55C\uB2E4\uB294 \uAC78 \uACC4\uAE30\uB85C\\n\uB0A8\uC790 \uCE5C\uAD6C\uC640 \uAC00\uAE4C\uC6CC\uC9C0\uAC8C \uB410\uC5B4!",
  "\uC5ED\uC2DC \uD06C\uB77C\uD30C\uB85C\\n\uACF5\uC911\uB0A0\uAE30 \uD0C0\uC784\uC5B4\uD0DD\uC740 \uBB34\uB9AC\uC778 \uAC74\uAC00...",
  "\uC5EC\uAE30\uB294 \uC804\uAE30\uB3CC\uC758 \uC554\uAD74\uC774\uC57C!\\n\uC804\uAE30\uC5D0 \uCC0C\uB9BF\uD574\uC9C0\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574!",
  "\uC81C\uBE48\uC740 2\uD559\uB144\uC778\uB370... \uC5B4\uB77C?\\c\\n\uC791\uB144\uC5D0\uB3C4 2\uD559\uB144\uC774\uC9C0 \uC54A\uC558\uB098...?\\n\uBD84\uBA85 \uC7AC\uC791\uB144\uC5D0\uB3C4...",
  "\uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uC5D0\uB294\\n\uCD94\uC704\uC5D0 \uAC15\uD55C \uD3EC\uCF13\uBAAC\uC774 \uC0B4\uACE0 \uC788\uC5B4.\\r\\n\uADF8\uB798\uC11C \uC5BC\uC74C\uD0C0\uC785\uC774 \uB9CE\uC740 \uD3B8\uC774\uC57C!",
  "\uC774 \uC55E\uC740 \uCE90\uB2C8\uC5B8 \uC5D0\uB9AC\uC5B4!\\n\uD45C\uBA74\uC774 \uC6B8\uD241\uBD88\uD241\uD558\uB2C8\uAE4C\\r\\n\uD3EC\uCF13\uBAAC\uC744 \uD0C0\uACE0 \uB2E4\uB2C8\uB294 \uAC8C \uC88B\uC744 \uAC70\uC57C.",
  "\uBE14\uB8E8\uB808\uD06C\uB294 \uC5EC\uB7FF\uC774\uC11C \uD558\uBA74\\n\uBCF4\uC0C1\uC744 \uB354 \uB9CE\uC774 \uBC1B\uC744 \uC218 \uC788\uB300!\\r\\n\uB098\uB294 \uAC19\uC774 \uD560 \uCE5C\uAD6C\uAC00 \uC5C6\uC9C0\uB9CC \uB9D0\uC774\uC9C0...",
  "\uC5EC\uAE30\uB294 \uC13C\uD130 \uC2A4\uD018\uC5B4!\\n4\uAC1C\uC758 \uC5D0\uB9AC\uC5B4\uAC00 \uAD50\uCC28\uD558\uB294 \uACF3\uC774\uC57C!",
  "\uB9AC\uADF8\uBD80 \uB9D0\uC774\uC57C...\\n\uC694\uC998 \uBD84\uC704\uAE30\uAC00 \uC880 \uBCC4\uB85C\uC9C0 \uC54A\uC544?",
  "\uCC54\uD53C\uC5B8\uC774 \uC81C\uBE48\uC5D0\uC11C \uCE74\uC9C0\uB85C\\n\uBC14\uB00C\uACE0 \uB09C \uB4A4\uBD80\uD130...\\r\\n\uBD80\uD65C\uB3D9\uC774 \uC990\uAC81\uC9C0 \uC54A\uAC8C \uB410\uC5B4.",
  "\uC774\uB7F0 \uB9D0 \uD558\uAE30 \uBBF8\uC548\uD558\uC9C0\uB9CC,\\n\uCE74\uC9C0\uAC00 \uB354 \uC774\uC0C1 \uCC54\uD53C\uC5B8\uC774 \uC544\uB2C8\uAC8C \uB3FC\uC11C \uAE30\uBED0.",
  "\uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8\uC740\\n\uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8 \uC0AC\uB78C\uC774 \uC544\uB2C8\uB798!",
  "\uC990\uAC81\uAC8C \uC2B9\uBD80\uD560 \uC218 \uC788\uB294\\n\uB9AC\uADF8\uBD80\uB85C \uB3CC\uC544\uC628 \uAC83 \uAC19\uC544!",
  "\uC774\uB7F0 \uBD80\uD65C\uB3D9\uC774\uB77C\uBA74\\n\uC5F4\uC2EC\uD788 \uD560 \uC218 \uC788\uC5B4!\\r\\n\uC0AC\uCC9C\uC655\uC744 \uBAA9\uD45C\uB85C \uD574 \uBCFC\uAE4C!",
  "\uB3D4\uC5D0 \uC788\uB294 \uBE14\uB85D\uC740\\n\uC801\uC678\uC120\uACFC \uC790\uC678\uC120\uC744 \uB0B4\uBFDC\uACE0 \uC788\uC5B4!\\c\\n...\uD3EC\uCF13\uBAAC\uACFC \uC2DD\uBB3C\uC758 \uC131\uC7A5\uC744\\n\uCD09\uC9C4\uD55C\uB2E4\uB098 \uBD10!",
  "\uC800\uCABD\uC740 \uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uC57C!\\c\\n\uBE59\uC0B0\uC744 \uC778\uACF5\uC801\uC73C\uB85C \uC7AC\uD604\uD574\uC11C\\n\uC81C\uBC95 \uCD94\uC6B4 \uACF3\uC774\uC57C!",
  "\uB808\uC774\uB4DC\uBC30\uD2C0 \uAD00\uB828 \uBBF8\uC158\uC740\\n\uC5EC\uB7FF\uC774\uC11C \uD558\uBA74 \uD6E8\uC52C \uC26C\uC6CC\uC838!",
  "\uD615\uC774\uB791 \uAC19\uC774\\n\uBE14\uB8E8\uB808\uD06C\uC5D0 \uB3C4\uC804\uD560 \uAC70\uC57C!",
  "1\uD559\uB144\uC5D0 \uCE74\uC9C0\uB77C\uB294 \uC560 \uB9D0\uC774\uC57C,\\n\uAC11\uC790\uAE30 \uBD84\uC704\uAE30\uAC00 \uC2F9 \uBC14\uB010 \uAC70 \uC788\uC9C0.",
  "\uAD49\uC7A5\uD55C \uCC54\uD53C\uC5B8\uC804\uC774\uC5C8\uC5B4!\\n\uCE74\uC9C0\uAC00 \uB9CE\uC774 \uBD84\uD574\uD558\uB354\uB77C.",
  "\uCE74\uC9C0, \uD734\uD559\uD588\uB2E4\uB354\uB77C.\\n\uBE68\uB9AC \uAE30\uC6B4\uC744 \uCC28\uB838\uC73C\uBA74 \uC88B\uACA0\uC5B4.",
  "\uC6B0\uC218\uD55C \uD559\uC0DD\uC5D0\uAC8C\uB9CC\\n\uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uAC00 \uC9C0\uAE09\uB410\uC5B4!\\r\\n...\uC7AC\uB8CC\uAC00 \uADC0\uC911\uD558\uB2E4\uB098 \uBD10!",
  "\uD14C\uB77C\uC2A4\uD0C8\uC740 \uC815\uB9D0 \uC2EC\uC624\uD55C \uAC83 \uAC19\uC544!\\n\uC57D\uC810\uC774 \uB298\uC5B4\uB0A0 \uB54C\uB3C4 \uC788\uC796\uC544!",
  "\uAC74\uB108\uD3B8\uC740 \uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4\uC57C!\\n\uAF43\uACFC \uBC14\uB2E4\uAC00 \uB9C8\uCE58 \uC54C\uB85C\uB77C\uC2A4\uB7EC\uC6CC!",
  "\uC5B4\uB77C? \uC124\uB9C8...\\n\uC5D0\uB9AC\uC5B4\uC5D0 \uB530\uB77C \uBE14\uB85D \uC0C9\uC774 \uB2E4\uB978 \uAC74\uAC00?",
  "\uB0B4 \uB4A4\uC5D0\\n\uAE30\uC220\uBA38\uC2E0\uC774 \uB5A8\uC5B4\uC838 \uC788\uC5C8\uC5B4.\\r\\n\uD639\uC2DC \uBC8C\uC368 \uC8FC\uC6E0\uB2C8?",
  "\uB9AC\uADF8\uBD80 \uC560\uB4E4\uC774 \uC694\uC998\\n\uC0AC\uC774\uAC00 \uC090\uAC71\uB304\uB2E4\uB294 \uAC83 \uAC19\uC544.\\r\\n\uAD50\uC0AC\uB85C\uC11C \uAC71\uC815\uB41C\uB2E8 \uB9D0\uC774\uC9C0.",
  "\uB9AC\uADF8\uBD80 \uC560\uB4E4 \uC77C\uC740\\n\uC5B4\uB290 \uC815\uB3C4 \uC77C\uB2E8\uB77D\uB41C \uBAA8\uC591\uC774\uC57C.\\r\\n\uAD50\uC0AC\uB85C\uC11C \uC544\uBB34 \uB3C4\uC6C0\uB3C4 \uB418\uC9C0 \uBABB\uD588\uC5B4...",
  "\uB9AC\uADF8\uBD80 \uC560\uB4E4\uC774\\n\uC608\uC804 \uAC19\uC740 \uC6C3\uC74C\uC744 \uB418\uCC3E\uC740 \uAC83 \uAC19\uC544.\\r\\n\uAD50\uC0AC\uB85C\uC11C \uC55E\uC73C\uB85C\uB3C4 \uC9C0\uCF1C\uBCFC \uC0DD\uAC01\uC774\uC57C.",
  "\uACF5\uC911\uB0A0\uAE30 \uD0C0\uC784\uC5B4\uD0DD\uC5D0\\n\uB3C4\uC804\uD574 \uBCF8 \uC801 \uC788\uB2C8?\\c\\n\uB808\uC5B4\uCF54\uC77C\uB4E4\uC774 \uCF54\uC2A4\uB97C \uB9CC\uB4DC\uB294 \uAC78\\n\uB3C4\uC640\uC8FC\uACE0 \uC788\uC5B4."
]
