[
  "\uC9C0\uAE08\uC774\uC57C\uB9D0\uB85C \uADF8\uAC04 \uC81C\uAD70\uB4E4\uC774\\n\uBC30\uC6B4 \uAC83\uB4E4\uC744 \uC2DC\uD5D8\uD560 \uB54C\uB2E4![VAR 0114(0029)]",
  "\uBCBC\uB77D\uCE58\uAE30 \uD55C \uAC83\uB4E4\uC744 \uC78A\uC5B4\uBC84\uB9AC\uAE30 \uC804\uC5D0\\n\uC2DC\uD5D8\uC744 \uC2DC\uC791\uD558\uB3C4\uB85D \uD558\uC9C0.[VAR 0114(0029)]",
  "1. \uD53C\uD06C\uB2C9\uC744 \uD1B5\uD574 \uC2DD\uC0AC\uB97C \uD588\uC744 \uB54C\\n    \uC5BB\uC744 \uC218 \uC788\uB294 \uD6A8\uACFC\uB85C \uC62C\uBC14\uB974\uC9C0 \uC54A\uC740 \uAC83\uC740?\\n\\n1) HP\uAC00 \uD68C\uBCF5\uB41C\uB2E4   2) \uB3C5\uC774 \uB0AB\uB294\uB2E4\\n3) \uC2A4\uD53C\uB4DC\uAC00 \uC624\uB978\uB2E4 4) \uC2DD\uC0AC \uD30C\uC6CC\uB97C \uC5BB\uB294\uB2E4",
  "HP\uAC00 \uD68C\uBCF5\uB41C\uB2E4",
  "\uB3C5\uC774 \uB0AB\uB294\uB2E4",
  "\uC2A4\uD53C\uB4DC\uAC00 \uC624\uB978\uB2E4",
  "\uC2DD\uC0AC \uD30C\uC6CC\uB97C \uC5BB\uB294\uB2E4",
  "2. \uB2E4\uC74C \uC911, \uC694\uB9AC\uB85C \uC5BB\uC744 \uC218 \uC788\uB294\\n    \uC2DD\uC0AC \uD30C\uC6CC\uC758 \uC885\uB958\uC640 \uAD00\uACC4\uB41C \uAC83\uC740?\\n\\n1) \uC18D \uC7AC\uB8CC\uC640 \uC870\uBBF8\uB8CC 2) \uC2DD\uC0AC \uC778\uC6D0\\n3) \uC2DD\uAE30\uC758 \uC0C9\uAC10",
  "\uC18D \uC7AC\uB8CC\uC640 \uC870\uBBF8\uB8CC",
  "\uC2DD\uC0AC \uC778\uC6D0",
  "\uC2DD\uAE30\uC758 \uC0C9\uAC10",
  "3. \uB2E4\uC74C \uC911, \uD3EC\uCF13\uBAAC\uC758 HP\uB97C \uD68C\uBCF5\uC2DC\uD0A4\uB294\\n    \uD6A8\uACFC\uAC00 \uC788\uB294 \uB098\uBB34\uC5F4\uB9E4\uB294?\\n\\n1) \uBCF5\uC29D\uC5F4\uB9E4 2) \uBC84\uCE58\uC5F4\uB9E4 3) \uC624\uB7AD\uC5F4\uB9E4",
  "\uBCF5\uC29D\uC5F4\uB9E4",
  "\uBC84\uCE58\uC5F4\uB9E4",
  "\uC624\uB7AD\uC5F4\uB9E4",
  "4. \uAC15\uC0B0\uC774\uAC00 \uBC30\uD2C0 \uC911\uC5D0 \uD3EC\uCF13\uBAAC\uC774 \uC9C1\uC811\\n    \uB3C4\uAD6C\uB97C \uC0AC\uC6A9\uD558\uAC8C \uD558\uB824\uBA74\\n    \uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC624\uB7AD\uC5F4\uB9E4\uB97C \uC9C0\uB2C8\uAC8C \uD558\uBA74 \uB41C\uB2E4.\\n    \uB9DE\uC73C\uBA74 O, \uD2C0\uB9AC\uBA74 X",
  "O",
  "X",
  "5. PP\uAC00 0\uC774 \uB418\uBA74 \uAE30\uC220\uC744 \uC4F8 \uC218 \uC5C6\uAC8C \uB41C\uB2E4.\\n    4\uAC1C \uAE30\uC220\uC758 PP\uAC00 \uBAA8\uB450 0\uC774 \uB418\uBA74\\n    \uD3EC\uCF13\uBAAC\uC740 \uD654\uD480\uC774\uBC16\uC5D0 \uC4F8 \uC218 \uC5C6\uAC8C \uB41C\uB2E4.\\n    \uB9DE\uC73C\uBA74 O, \uD2C0\uB9AC\uBA74 X",
  "O",
  "X",
  "\uB2F5\uC744 \uC801\uC744 \uC2DC\uAC04\uC740 \uBAA8\uB450 \uB05D\uB0AC\uB2E4.\\n\uD544\uAE30\uB97C \uBA48\uCD94\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uB2E4\uB4E4 \uC2E4\uB825\uC740 \uCDA9\uBD84\uD788 \uBC1C\uD718\uD588\uB098?[VAR 0114(0029)]",
