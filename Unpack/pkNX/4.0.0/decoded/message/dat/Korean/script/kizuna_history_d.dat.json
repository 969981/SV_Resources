[
  "[VAR 0100(0000)],\\n\uC7AC\uC559\uC758 \uBCF4\uBB3C\uC740 \uCC3E\uC544 \uBD24\uC5B4?[VAR 0114(0027)]",
  "\uC0DD\uAC01 \uC788\uC73C\uBA74 \uD55C\uBC88 \uAC00\uC11C \uC870\uC0AC\uD574 \uC918.[VAR 0114(0027)]",
  "...\uC7AC\uC559\uC758 \uBCF4\uBB3C\uC5D0 \uB300\uD574\\n\uC0C8\uB85C \uBCF4\uACE0\uD560 \uAC74 \uC5C6\uB294 \uAC83 \uAC19\uC740\uB370?[VAR 0114(0027)]",
  "\uC624\uC624! \uC7AC\uC559\uC758 \uADF8\uB987\\n\uB529\uB8E8\uB97C \uC7A1\uC558\uAD6C\uB098!![VAR 0114(0027)]",
  "\uC624\uC624! \uC7AC\uC559\uC758 \uAC80\\n\uD30C\uC624\uC820\uC744 \uC7A1\uC558\uAD6C\uB098!![VAR 0114(0027)]",
  "\uC624\uC624! \uC7AC\uC559\uC758 \uBAA9\uAC04\\n\uCD1D\uC9C0\uC5D4\uC744 \uC7A1\uC558\uAD6C\uB098!![VAR 0114(0027)]",
  "\uC624\uC624! \uC7AC\uC559\uC758 \uACE1\uC625\\n\uC704\uC720\uC774\uB97C \uC7A1\uC558\uAD6C\uB098!![VAR 0114(0027)]",
  "\uD06C\uC73C~! \uD765\uBBF8\uC9C4\uC9C4\uD55C\uB370!\\n\uD638\uAE30\uC2EC\uC774 \uB9C8\uAD6C\uB9C8\uAD6C \uC0D8\uC19F\uC544![VAR 0114(0027)]",
  "\uD615\uD0DC\uB098 \uD06C\uAE30\uB85C \uBBF8\uB8E8\uC5B4 \uBCF4\uAC74\uB300,\\n\uC774 \uADF8\uB987, \uC77C\uC6A9\uD488\uC73C\uB85C \uC0AC\uC6A9\uD588\uB358 \uAC74 \uC544\uB2D0 \uAC70\uC57C![VAR 0114(0027)]",
  "\uC608\uC220\uD488... \uC544\uB2C8\uBA74\\n\uC2E0\uC744 \uBAA8\uC2E4 \uB54C \uC4F0\uB294 \uC81C\uAE30\uB85C\\r\\n\uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC558\uC744\uAE4C!?[VAR 0114(0027)]",
  "\uBFD4\uC774 \uB2EC\uB838\uACE0, \uB208\uC744 \uBCF8\uB72C \uB4EF\uD55C \uB514\uC790\uC778\uC5D0\uC11C\\n\uC5B4\uB5A4 \uC758\uB3C4\uAC00 \uC788\uC5C8\uB2E4\uB294 \uAC8C \uB290\uAEF4\uC9C0\uB294 \uAC83 \uAC19\uC544.[VAR 0114(0027)]",
  "\uC2E0\uC559\uC758 \uB300\uC0C1\uC774\uC5C8\uB358 \uC2E0 \uC790\uCCB4\uAC00\\n\uADF8\uB987\uC758 \uD615\uD0DC\uB97C \uD558\uACE0 \uC788\uC5C8\uB358 \uAC74 \uC544\uB2D0\uAE4C!?[VAR 0114(0027)]",
  "\uCE7C\uC758 \uC190\uC7A1\uC774\uC640 \uB3C4\uC2E0 \uBD80\uBD84\uC774\\n\uC88C\uC6B0 \uC5C4\uB2C8\uAC00 \uB41C \uAC70\uAD6C\uB098![VAR 0114(0027)]",
  "\uD3EC\uCF13\uBAAC\uC774 \uB418\uBA74\uC11C \uBD80\uB7EC\uC9C4 \uAC78\uAE4C?\\n\uC544\uB2C8\uBA74 \uCC98\uC74C\uBD80\uD130...?[VAR 0114(0027)]",
  "\uC7A0\uAE50, \uBD80\uB7EC\uC9C4 \uAC80\uC744\\n\uC655\uC774 \uC77C\uBD80\uB7EC \uC0AC\uB824\uACE0 \uD560 \uAC83 \uAC19\uC9C4 \uC54A\uC740\uB370?[VAR 0114(0027)]",
  "\uC5B4\uCA4C\uBA74 \uBD80\uB7EC\uC9C4 \uC0C1\uD0DC\uB85C \uC0AC\uC6A9\uD558\uB294\\n\uBB34\uAE30\uC600\uC744 \uAC00\uB2A5\uC131\uB3C4 \uC788\uC9C0 \uC54A\uC744\uAE4C...!?[VAR 0114(0027)]",
  "\uC774\uB807\uAC8C\uAE4C\uC9C0 \uAE38\uAC8C \uC774\uC5B4\uC9C4\\n\uBAA9\uAC04\uC774 \uC788\uC744 \uC904\uC774\uC57C, \uC5C4\uCCAD\uB09C \uC7A5\uD3B8\uC778\uB370![VAR 0114(0027)]",
  "\uCD9C\uD1A0\uB418\uB294 \uBAA9\uAC04\uC740 \uB300\uCCB4\uB85C\\n\uB2E8\uC21C\uD55C \uB099\uC11C\uB098 \uC9E7\uC740 \uBA54\uBAA8\uC778 \uACBD\uC6B0\uAC00 \uB9CE\uC740\uB370...\\r\\n\uBB50, \uADF8\uAC83\uB3C4 \uB2F9\uC2DC\uB97C \uC54C \uC218 \uC788\uB294 \uADC0\uD55C \uC790\uB8CC\uC9C0\uB9CC![VAR 0114(0027)]",
  "\uC77D\uC744 \uC218\uB294 \uC5C6\uC9C0\uB9CC, \uC774 \uC815\uB3C4 \uAE38\uC774\uBA74\\n\uC774\uC57C\uAE30\uB824\uB098? \uC544\uB2C8\uBA74 \uB204\uAD70\uAC00\uB97C \uC800\uC8FC\uD558\uB294 \uAE00?[VAR 0114(0027)]",
  "\uBB38\uC790\uAC00 \uD76C\uBBF8\uD574\uC9C4 \uAC8C \uC544\uC27D\uB124!\\n\uC655\uC758 \uD765\uBBF8\uB97C \uB048 \uBAA9\uAC04\uC774\uB77C\uB2C8!\\r\\n\uC5B4\uB5A4 \uBB38\uC7A5\uC774 \uC4F0\uC5EC \uC788\uB358 \uAC78\uAE4C...?[VAR 0114(0027)]",
  "\uACE1\uC625\uC740 \uADF8 \uC2E0\uC131\uD568 \uB54C\uBB38\uC5D0\\n\uC81C\uC0AC\uB97C \uC9C0\uB0BC \uB54C \uBAB8\uC5D0 \uAC78\uCE58\uB294 \uB3C4\uAD6C\uC600\uC5B4.[VAR 0114(0027)]",
  "\uC8FC\uB85C \uD39C\uB358\uD2B8\uCC98\uB7FC\\n\uD558\uB098\uB97C \uBAA9\uC5D0 \uAC78\uC5C8\uB2E4\uACE0 \uD558\uB294\uB370\\r\\n\uC704\uC720\uC774\uB294 4\uAC1C\uB098 \uBD99\uC5B4 \uC788\uB124?[VAR 0114(0027)]",
  "\uADC0\uB098 \uC190\uBAA9\uAC19\uC774 \uD55C \uC30D\uC774 \uB418\uB294 \uBD80\uC704\uB97C\\n\uAFB8\uBBF8\uB294 \uC7A5\uC2DD\uD488\uC774\uC5C8\uB358 \uAC78\uAE4C?\\r\\n\uC544\uB2C8\uBA74 \uC81C\uC0AC\uB97C 4\uBA85\uC774\uC11C \uC9C0\uB0C8\uB2E4\uAC70\uB098...?[VAR 0114(0027)]",
  "\uC561\uC6B4\uC744 \uCAD3\uAE30 \uC704\uD574 \uC0AC\uC6A9\uB418\uB358 \uACE1\uC625\uC774\\n\uC7AC\uC559\uC774\uB77C \uBD88\uB9AC\uAC8C \uB41C \uACBD\uC704\uB294 \uB300\uCCB4 \uBB50\uC600\uC744\uAE4C...?[VAR 0114(0027)]",
  "\uC758\uBB38\uC774 \uC810\uC810 \uB298\uC5B4 \uAC00\uB294 \uAC83 \uAC19\uC544.\\n\uC544\uC544! \uC9C0\uC2DD\uC695\uC774 \uCC44\uC6CC\uC9C0\uB294 \uC774 \uB290\uB08C...![VAR 0114(0027)]",
  "\uC751? \uBCF4\uACE0\uD560 \uC218 \uC788\uB294\\n\uC870\uC0AC\uAC00 \uB354 \uC788\uB294 \uAC83 \uAC19\uC740\uB370?[VAR 0114(0027)]",
  "\uC815\uB9D0 \uACE0\uB9C8\uC6CC, [VAR 0100(0000)].\\n\uC2E4\uBB3C\uC744 \uBCFC \uC218 \uC788\uC5B4\uC11C \uB2E4\uD589\uC774\uC57C.[VAR 0114(0027)]",
  "\uB2E4\uB978 \uC7AC\uC559\uC758 \uBCF4\uBB3C\uC744 \uBC1C\uACAC\uD558\uBA74\\n\uB610 \uBCF4\uACE0\uD558\uB7EC \uC640 \uC918.[VAR 0114(0027)]",
  "...\uC774\uB7F4 \uC218\uAC00, \uBC29\uAE08 \uAC78\uB85C \uC7AC\uC559\uC758 \uBCF4\uBB3C\uC5D0 \uB300\uD55C\\n\uC870\uC0AC \uBCF4\uACE0\uB97C \uBAA8\uB450 \uB9C8\uCCE4\uAD6C\uB098![VAR 0114(0027)]",
  "\uC124\uB9C8 \uB124\uAC00 \uC774 \uC815\uB3C4\uB85C\\n\uD574\uB0BC \uAC70\uB77C\uACE4 \uC0DD\uAC01\uB3C4 \uBABB \uD588\uC5B4.[VAR 0114(0027)]",
  "\uC815\uB9D0 \uACE0\uB9C8\uC6CC, [VAR 0100(0000)].[VAR 0114(0027)]",
  "\uB9C8\uC74C \uAC19\uC544\uC11C\uB294 \uC7AC\uC559\uC758 \uBCF4\uBB3C\uC744\\n\uB0B4 \uC190\uC73C\uB85C \uC9C1\uC811 \uC870\uC0AC\uD574\uC11C\\r\\n\uC218\uC911\uC5D0 \uB123\uACE0 \uC2F6\uC5C8\uC9C0\uB9CC...[VAR 0114(0027)]",
  "\uC5B4\uCC28\uD53C \uC774 \uC77C\uC740 \uB108\uC758 \uADF8 \uC21C\uC218\uD568\uC774 \uC788\uC5C8\uAE30\uC5D0\\n\uAC00\uB2A5\uD55C \uC77C\uC774\uC5C8\uC744 \uAC70\uC57C.[VAR 0114(0027)]",
  "\uBCF4\uBB3C\uC744 \uAC16\uACE0 \uC2F6\uC740 \uB9C8\uC74C\uC740 \uAD74\uB69D\uAC19\uC9C0\uB9CC,\\n\uC77C\uB2E8\uC740 \uB108\uC5D0\uAC8C \uB9E1\uAE30\uB3C4\uB85D \uD560\uAC8C.[VAR 0114(0027)]",
  "\uC774\uAC74 \uB0B4\uAC00 \uC8FC\uB294 \uAC10\uC0AC\uC758 \uD45C\uC2DC\uC57C.\\n\uAC00\uC838\uAC00\uB3C4\uB85D \uD574.[VAR 0114(0027)]",
  "\uD06C\uD06C\uD06D, [VAR 0100(0000)]...\\n\uB108\uB294 \uC815\uB9D0 \uC7AC\uBBF8\uC788\uB294 \uC544\uC774\uC57C.\\r\\n\uADF8\uB7EC\uB2C8, \uAD00\uCC30 \uB9AC\uC2A4\uD2B8\uC5D0 \uC801\uC5B4 \uB450\uB3C4\uB85D \uD558\uACA0\uC5B4.[VAR 0114(0027)]",
  "\uB808\uD3EC\uB974 \uC120\uC0DD\uB2D8\uACFC\uC758\\n\uC720\uB300\uAC00 \uC2F9\uD144\uB2E4!"
]
