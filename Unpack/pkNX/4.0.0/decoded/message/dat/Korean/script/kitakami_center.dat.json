[
  "\uC5B4\uC11C \uC624\uC138\uC694! \uBD81\uC2E0\uC13C\uD130\uC785\uB2C8\uB2E4!\\n\uACE7 \uCD95\uC81C\uAC00 \uC2DC\uC791\uB420 \uC608\uC815\uC785\uB2C8\uB2E4!",
  "\uC7A0\uB9CC\uBCF4\uB77C\uB294 \uD3EC\uCF13\uBAAC\uC758 \uBD84\uB958\uB294\\n\uC878\uC74C\uD3EC\uCF13\uBAAC!\\r\\n...\uBCF4\uAE30\uB9CC \uD574\uB3C4 \uC65C \uADF8\uB7F0\uC9C0 \uC54C\uACA0\uB124!",
  "\uC7AC\uBBF8\uC788\uB294 \uAC8C\uC784\uC744 \uC900\uBE44\uD558\uACE0 \uC788\uC5B4!\\n\uAC00\uBA74 \uCD95\uC81C\uAC00 \uC2DC\uC791\uB418\uBA74 \uB4E4\uB7EC \uC918!",
  "\uBD81\uC2E0\uC13C\uD130\uB294 \uC9C0\uAE08\\n\uD55C\uCC3D \uAC00\uBA74 \uCD95\uC81C\uAC00 \uC5F4\uB9AC\uB294 \uC911\uC774\uC57C!\\r\\n\uCC29\uD55C \uC544\uC774\uB3C4 \uB098\uC05C \uC544\uC774\uB3C4 \uD658\uC601\uC774\uB780\uB2E4!",
  "\uC138\uBC97\uB2D8\uCC98\uB7FC \uC0DD\uAE34 \uD0C8 \uC778\uD615\uC774\\n\uACC4\uB2E8\uC744 \uC62C\uB77C\uAC14\uC5B4!\\r\\n\uC548\uC5D0 \uC788\uB294 \uC0AC\uB78C\uC740 \uD798\uB4E4\uACA0\uB2E4!",
  "\uC124\uB9C8 \uB0B4\uAC00 \uBCF8 \uAC8C\\n\uC9C4\uC9DC \uC138\uBC97\uC774\uC5C8\uB2E4\uB2C8!\\r\\n\uB3D9\uC601\uC0C1\uC73C\uB85C \uCC0D\uC5B4 \uB458\uAC78!",
  "\uAC00\uBA74\uC744 \uC0AC\uACE0 \uC2F6\uC740\uB370\\n\uAC00\uAC8C\uC5D0 \uC544\uBB34\uB3C4 \uC5C6\uC5B4!",
  "\uC8FC\uC778\uC544\uC800\uC528\uAC00 \uB3CC\uC544\uC628 \uBAA8\uC591\uC774\uC57C.\\n\uC774\uC81C \uAC00\uBA74\uC744 \uC0B4 \uC218 \uC788\uACA0\uC5B4!",
  "\uAC00\uBA74\uC774 \uC794\uB729 \uC788\uB124!\\n\uC5B4\uB290 \uAC78\uB85C \uD560\uAE4C~?",
  "\uD53C\uCE74\uCE04 \uAC00\uBA74\uC744 \uC4F0\uBA74\\n\uAE30\uBD84\uB3C4 \uD53C, \uD53C\uCE74\uCE04!?",
  "\uBD80\uCC44\uC9C8\uC744 \uD558\uB2C8\uAE4C \uC2DC\uC6D0\uD574!\\n\uADFC\uB370 \uC190\uC744 \uC6C0\uC9C1\uC600\uB354\uB2C8 \uB540\uC774 \uB098\uB294 \uAC70 \uC788\uC9C0!",
  "\uC62C\uD574\uB3C4 \uC5ED\uC2DC\\n\uC138\uBC97\uB2D8\uC758 \uAC00\uBA74\uC774 \uC778\uAE30 \uC788\uB124!",
  "\uC138\uBC97\uB2D8\uC774 \uC0B4\uC544\uB098\uC168\uB2E4\uB294 \uAC8C \uC815\uB9D0\uC774\uC57C!?\\n\uB098\uB3C4 \uAC00\uBA74\uC744 \uC37C\uC73C\uB2C8 \uCE5C\uD574\uC9C8 \uC218 \uC788\uC744\uAE4C?",
  "\uAE30\uB85C\uCE58 \uB2D8,\\n\uC2E4\uBB3C\uC740 \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uD551\uD06C\uC0C9\uC774 \uC544\uB2C8\uAD6C\uB098~",
  "\uC774\uC57C\uD6C4 \uAC00\uBA74!\\n\uD30C\uB797\uACE0 \uBA4B\uC9C0\uC9C0!?",
  "\uC5E5? \uC138\uBC97\uC774 \uC9C4\uC9DC\uB85C\\n\uC874\uC7AC\uD558\uB294 \uAC70\uC600\uC5B4!?\\r\\n\uB204\uAC00 \uC9C0\uC5B4\uB0B8 \uC774\uC57C\uAE30\uC778 \uC904 \uC54C\uC558\uB294\uB370!",
  "\uC9C4\uC9DC \uC774\uC57C\uD6C4\uB294 \uC5BC\uAD74\uC774 \uC0C8\uD30C\uB797\uAD6C\uB098!\\n\uD639\uC2DC \uCEE8\uB514\uC158\uC774 \uC548 \uC88B\uC740 \uAC78\uAE4C?",
  "\uAC00\uBA74\uC744 \uC4F0\uACE0 \uC788\uC73C\uBA74\\n\uB610 \uB2E4\uB978 \uC790\uC2E0\uC774 \uB41C \uAC70 \uAC19\uC9C0 \uC54A\uC544!?",
  "\uB3C4\uAE68\uBE44\uC758 \uC5ED\uC0AC,\\n\uC544\uC774\uB4E4\uC774 \uB9D0\uC744 \uB4E3\uAC8C \uD558\uB824\uACE0\\r\\n\uC9C0\uC5B4\uB0B8 \uC774\uC57C\uAE30\uC778 \uC904 \uC54C\uC558\uC5B4!",
  "\uC870\uD0C0\uAD6C\uAC00 \uC0AC\uC2E4 \uB098\uC05C \uB140\uC11D\uC774\uC5C8\uB358 \uAC70\uC57C!?\\n\uD558\uB098\uB3C4 \uC548 \uC88B\uC740 \uC774\uC57C\uAE30\uC796\uC544!",
  "\uC5ED\uC0AC\uAC00 \uC801\uD78C \uAC04\uD310\uC5D0 \uADF8\uB824\uC9C4\\n\uC0AC\uB78C \uADF8\uB9BC \uB9D0\uC774\uC57C...\\r\\n\uC138\uBC97\uB4E4\uC758 \uD2B8\uB808\uC774\uB108\uC778 \uAC78\uAE4C?",
  "\uB3C4\uAE68\uBE44 \uD1F4\uCE58 \uD398\uC2A4\uD2F0\uBC8C\uC744 \uD558\uACE0 \uC788\uC5B4!\\n\uD638\uD654\uB85C\uC6B4 \uACBD\uD488\uC744 \uBAA9\uD45C\uB85C \uD55C\uBC88 \uB3C4\uC804\uD574 \uBD10!",
  "\uB3C4\uAE68\uBE44 \uD1F4\uCE58 \uD398\uC2A4\uD2F0\uBC8C\uC740\\n\uD3EC\uCF13\uBAAC\uC744 \uD0C0\uACE0 \uC990\uAE30\uB294 \uB180\uC774\uC785\uB2C8\uB2E4!\\c\\n\uB178\uB77C\uD0A4\uB97C \uBE4C\uB824\uB4DC\uB9AC\uACE0 \uC788\uC5B4\uC11C\\n\uD3EC\uCF13\uBAAC\uC774 \uC5C6\uB294 \uBD84\uB3C4 \uCC38\uAC00\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
]
