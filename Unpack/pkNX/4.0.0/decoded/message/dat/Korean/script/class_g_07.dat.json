[
  "\uC81C\uAD70\uB4E4, \uD6C4\uBC18\uAE30 \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC744 \uC2DC\uC791\uD558\uACA0\uB2E4.\\n\uC2A4\uB9C8\uD2B8\uD3F0\uC740 \uC9D1\uC5B4\uB123\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uC0DD\uAC01\uD574 \uBCF4\uB2C8 \uC218\uC5C5\uC5D0\uC11C \uC758\uC2DD\uC8FC \uC911\uC5D0\\n\u201C\uC2DD\u201D\uC5D0 \uB300\uD55C \uAC83\uB9CC \uB2E4\uB918\uB358 \uAC83 \uAC19\uAD70.[VAR 0114(0029)]",
  "\uC870\uAE08 \uB2A6\uC740 \uAC10\uC774 \uC788\uC9C0\uB9CC,\\n\u201C\uC758\u201D... \uB2E4\uC2DC \uB9D0\uD574 \uC637\uC5D0 \uB300\uD574\uC11C\uB3C4\\r\\n\uC124\uBA85\uD574 \uC8FC\uB3C4\uB85D \uD558\uB9C8.[VAR 0114(0029)]",
  "\uC774\uBBF8 \uC54C\uACE0 \uC788\uACA0\uC9C0\uB9CC\\n\uC6B0\uB9AC \uD559\uAD50\uB294 \uAD50\uD48D\uC774 \uC790\uC720\uB85C\uC6B4 \uD3B8\uC774\uB2E4.[VAR 0114(0029)]",
  "\uD314\uB370\uC544\uC758 \uB2E4\uC591\uD55C \uAE30\uD6C4\uC5D0 \uB9DE\uCDB0\uC11C\\n\uACC4\uC808\uBCC4\uB85C \uAD50\uBCF5\uC774 \uC900\uBE44\uB418\uC5B4 \uC788\uC9C0\uB9CC\\r\\n\uC2DC\uAE30\uC640 \uC0C1\uAD00\uC5C6\uC774 \uC6D0\uD558\uB294 \uAD50\uBCF5\uC744 \uC785\uC5B4\uB3C4 \uB418\uC9C0.[VAR 0114(0029)]",
  "\uC785\uD559\uD588\uC744 \uB54C \uBD04, \uC5EC\uB984, \uAC00\uC744, \uACA8\uC6B8\uC5D0 \uB530\uB978\\n\uC0C1\uC758\uC640 \uD558\uC758\uB97C\\r\\n\uAC01\uAC01 \uB124 \uBC8C\uC529 \uBC1B\uC558\uC744 \uAC70\uB2E4.[VAR 0114(0029)]",
  "...\uD639\uC2DC\uB77C\uB3C4 \uBAB0\uB790\uB358 \uD559\uC0DD\uC774 \uC788\uB2E4\uBA74\\n\uC637\uC7A5\uC744 \uC0B4\uD3B4\uBCF4\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uAD50\uBCF5\uB9CC \uC81C\uB300\uB85C \uCC29\uC6A9\uD558\uACE0 \uC788\uC73C\uBA74\\n\uD559\uAD50\uAC00 \uC9C0\uC815\uD55C \uAC00\uBC29\uC774 \uC544\uB2C8\uC5B4\uB3C4 \uB418\uACE0,[VAR 0114(0029)]",
  "\uBAA8\uC790\uC758 \uC885\uB958\uB098 \uCC29\uC6A9 \uC5EC\uBD80,\\n\uD5E4\uC5B4\uC2A4\uD0C0\uC77C\uB3C4 \uC790\uC720\uB86D\uAC8C \uD560 \uC218 \uC788\uB2E4.[VAR 0114(0029)]",
  "...\uC138\uC774\uC9C0 \uC120\uC0DD\uB2D8\uC758 \uD5E4\uC5B4\uC2A4\uD0C0\uC77C\uB3C4\\n\uB0B4\uAC00 \uC80A\uC5C8\uC744 \uC801\uC5D0\uB294\\r\\n\uAD50\uCE59 \uC704\uBC18\uC774\uC5C8\uB294\uB370 \uB9D0\uC774\uC9C0.[VAR 0114(0029)]",
  "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8...[VAR 0114(0029)]",
  "\uC81C\uAD70\uB4E4\uC774 \uBCF5\uC7A5 \uC678\uC5D0 \uC790\uC8FC\\n\uC5B4\uB808\uC778\uC9C0\uD558\uB294 \uADF8 \uADC0\uC5EC\uC6B4 \uAC83 \uB9D0\uC774\uB2E4\uB9CC\\r\\n...\uB300\uCCB4 \uC5B4\uB5BB\uAC8C \uD558\uB294 \uAC70\uC9C0?[VAR 0114(0029)]",
  "\uAD50\uC2E4 \uCC45\uC0C1\uC774\uC694?",
  "\uAE30\uC219\uC0AC \uBC29\uC774\uC694?",
  "\uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34\uC694?",
  "\uC544\uB2C8, \uADF8\uAC8C \uC544\uB2C8\uB77C...\\n\uC880 \uB354 \uC791\uACE0 \uADC0\uC5EC\uC6B4 \uAC74\uB370...\\r\\n\uADF8\uB7F0\uB370 \uB124 \uCC45\uC0C1\uC740 \uBB34\uC11C\uC6B8 \uC815\uB3C4\uB85C\\r\\n\uB2E4\uB978 \uC810\uC774 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC9C0 \uC54A\uC740\uAC00![VAR 0114(0029)]",
  "\uC544\uB2C8, \uADF8\uAC8C \uC544\uB2C8\uB77C...\\n\uC880 \uB354 \uC791\uACE0 \uADC0\uC5EC\uC6B4 \uAC74\uB370...\\r\\n\uADF8\uB7F0\uB370 \uB0B4\uAC00 \uC81C\uAD70\uB4E4\uC758 \uBC29\uC774 \uC5B4\uB5BB\uAC8C \uC0DD\uACBC\uB294\uC9C0\\r\\n\uC54C\uACE0 \uC788\uC73C\uBA74 \uADF8\uAC83\uB3C4 \uBB38\uC81C\uC774\uC9C0 \uC54A\uC740\uAC00![VAR 0114(0029)]",
  "\uD6CC\uB96D\uD55C \uB2F5\uBCC0\uC774\uC5C8\uB2E4! \uADF8\uB798, \uADF8 \uADC0\uC5EC\uC6B4 \uAC83\uC744\\n\uC5B4\uB5BB\uAC8C \uD558\uB294\uC9C0\uAC00 \uB108\uBB34\uB098\uB3C4 \uAD81\uAE08\uD558\uB354\uAD70!![VAR 0114(0029)]",
  "\uADF8\uB798\uADF8\uB798, \uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34\uC600\uC5B4![VAR 0114(0029)]",
  "...\uACFC\uC5F0, \uCC38\uC73C\uB85C \uD765\uBBF8\uB86D\uAD70!\\n\uB51C\uB9AC\uBC84\uB4DC \uD30C\uC6B0\uCE58\uB77C\uB294 \uAC00\uAC8C\uC5D0\uC11C\\r\\n\uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34\uC758 \uCEE4\uBC84\uB97C \uC0B4 \uC218 \uC788\uB2E8 \uB9D0\uC774\uC9C0![VAR 0114(0029)]",
  "\uC720\uC775\uD55C \uC815\uBCF4 \uACE0\uB9D9\uB2E4...[VAR 0114(0029)]",
  "\uB2F9\uC7A5 \uB0B4\uC77C \uB098\uC758 \uCDE8\uD5A5\uC5D0 \uB9DE\uB294\\n\uAE5C\uCC0D\uD55C \uCF00\uC774\uC2A4\uB97C \uC0AC\uB7EC \uAC00\uC57C\uACA0\uC5B4.[VAR 0114(0029)]",
  "...\uC774\uAC70 \uC7A1\uB2F4\uC774 \uB108\uBB34 \uAE38\uC5B4\uC84C\uAD70.[VAR 0114(0029)]",
  "\uC544\uBB34\uD2BC, \uC9C0\uAE08\uAE4C\uC9C0 \uB098\uC640 \uD568\uAED8\\n\uAC00\uC815\uC774\uB77C\uB294 \uC774\uB984\uC758 \uC0B4\uC544\uAC00\uAE30 \uC704\uD55C \uAE30\uC220\uC744\\r\\n\uAC08\uACE0\uB2E6\uC740 \uC81C\uAD70\uB4E4\uC5D0\uAC8C \uC804\uD560 \uB9D0\uC774 \uC788\uB2E4.[VAR 0114(0029)]",
  "\uB0B4\uAC00 \uAC00\uB974\uCE58\uB294 \uD559\uBB38\uC740 \uC218\uD559 \uAC19\uC740 \uAC83\uACFC\uB294 \uB2EC\uB9AC\\n\uC2DC\uD5D8 \uC810\uC218\uB85C \uC81C\uAD70\uB4E4\uC758 \uBBF8\uB798\uB97C \uACB0\uC815\uC9D3\uB294\\r\\n\uB300\uB2E8\uD55C \uAC83\uC740 \uC544\uB2C8\uB2E4.[VAR 0114(0029)]",
  "...\uADF8\uB807\uC9C0\uB9CC \uC694\uB9AC\uB97C \uD558\uAC70\uB098\\n\uD3EC\uCF13\uBAAC\uC744 \uB3CC\uBCFC \uB54C,\\r\\n\uC544\uB2C8\uBA74 \uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098 \uC785\uC744 \uC637\uC744 \uACE0\uB97C \uB54C[VAR 0114(0029)]",
  "\uB098\uC758 \uC218\uC5C5\uC774 \uC870\uAE08\uC774\uB098\uB9C8 \uC81C\uAD70\uB4E4\uC758 \uC778\uC0DD\uC5D0\\n\uC724\uD65C\uC720\uAC00 \uB418\uC5C8\uB2E4\uBA74 \uB0B4\uAC90 \uB354\uC5C6\uB294 \uC601\uAD11\uC77C \uAC70\uB2E4.\\r\\n...\uD314\uC790\uD06C \uC120\uC0DD\uB2D8\uC758 \uB9D0\uC744 \uBE4C\uB9AC\uC790\uBA74 \uB9D0\uC774\uC9C0.[VAR 0114(0029)]",
  "\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uD568\uAED8\uD574 \uC918\uC11C\\n\uC9C4\uC2EC\uC73C\uB85C \uACE0\uB9D9\uB2E4.[VAR 0114(0029)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4.\\n\uAE30\uB9D0\uC2DC\uD5D8\uB3C4 \uC5F4\uC2EC\uD788 \uC900\uBE44\uD558\uB3C4\uB85D.[VAR 0114(0029)]"
]
