[
  "\uC5EC\uB7EC\uBD84 \uC548\uB155~\\n\uADF8\uB7FC, \uC218\uC5C5\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C\uC694~[VAR 0114(002A)]",
  "\uC9C0\uB09C \uC2DC\uAC04\uC5D0\uB294\\n\uC54C\uC758 \uC18C\uC911\uD568\uC5D0 \uB300\uD574 \uACF5\uBD80\uD588\uC5C8\uC8E0?[VAR 0114(002A)]",
  "\uC544, \uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC5EC\uB7EC\uBD84\uC740\\n\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uC774\uC6A9\uD558\uACE0 \uC788\uB098\uC694?[VAR 0114(002A)]",
  "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC5D0\uB294\\n\uC54C\uC5D0\uC11C \uD0DC\uC5B4\uB098\uB294 \uD3EC\uCF13\uBAAC\uB3C4\\r\\n\uBB38\uC81C\uC5C6\uC774 \uB4F1\uB85D\uB418\uB2C8\uAE4C \uC548\uC2EC\uD558\uC138\uC694~[VAR 0114(002A)]",
  "\uD5E4\uD5E4... \uD3EC\uCF13\uBAAC \uB3C4\uAC10 \uC571\uC740 \uC0AC\uC2E4,\\n\uC81C\uAC00 \uB9CC\uB4E0 \uAC70\uB78D\uB2C8\uB2E4![VAR 0114(002A)]",
  "\uC774 \uD559\uAD50\uC5D0\uC11C \uC120\uC0DD\uB2D8\uC744 \uD558\uAE30\\n\uD6E8~\uC52C \uC804\uC758 \uC77C\uC774\uAE34 \uD558\uC9C0\uB9CC\uC694.[VAR 0114(002A)]",
  "\uC120\uC0DD\uB2D8\uC774 \uC804\uC5D0\uB294\\n\uC5F0\uAD6C\uC6D0\uC774\uC5C8\uAC70\uB4E0\uC694.[VAR 0114(002A)]",
  "\uADF8\uB54C\uB294 \uD074\uB77C\uBCA8 \uC120\uC0DD\uB2D8\uB3C4\\n\uC544\uC9C1 \uC120\uC0DD\uB2D8\uC774 \uC544\uB2C8\uC2E4 \uB54C\uB77C\\r\\n\uAC19\uC740 \uC2DC\uC124\uC5D0\uC11C \uC5F0\uAD6C\uD588\uC5C8\uB2F5\uB2C8\uB2E4~[VAR 0114(002A)]",
  "\uB9E4\uC77C \uD568\uAED8 \uD3EC\uCF13\uBAAC\uC744\\n\uC5F0\uAD6C\uD560 \uC218 \uC788\uC5B4\uC11C \uC990\uAC70\uC6E0\uB294\uB370...\\r\\n\uAC70\uC758 \uB9E4\uC77C \uD63C\uB098\uAE30\uB9CC \uD588\uC9C0\uB9CC \uB9D0\uC774\uC8E0.[VAR 0114(002A)]",
  "\uC5B4\uB77C...? \uC5B4\uCA4C\uB2E4 \uC774 \uC598\uAE30\uAC00 \uB098\uC654\uC9C0?\\n\uB3C4\uAC10\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD558\uB824\uACE0 \uD588\uB294\uB370.[VAR 0114(002A)]",
  "...\uB9DE\uB2E4, \uC624\uB298 \uC218\uC5C5\uC740\\n\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uB294 \uBC95\uC744 \uAC00\uB974\uCE58\uB294 \uAC70\uC600\uC9C0![VAR 0114(002A)]",
  "\uC5EC\uB7EC\uBD84\uB3C4 \uC544\uC2DC\uB2E4\uC2DC\uD53C\\n\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uC73C\uB824\uBA74 \uBA3C\uC800,\\r\\n\uC0C1\uB300\uC758 \uCCB4\uB825\uC744 \uC904\uC5EC\uC57C \uD574\uC694.[VAR 0114(002A)]",
  "\uADF8\uB7F0\uB370, \uCCB4\uB825\uC744 \uC904\uC774\uB294 \uAC83 \uB9D0\uACE0\uB3C4\\n\uBC30\uD2C0 \uC911\uC5D0 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC27D\uAC8C \uB9CC\uB4E4\uC5B4 \uC8FC\uB294\\r\\n\uD14C\uD06C\uB2C9\uC774 \uC788\uB2E4\uB294 \uAC74 \uC54C\uACE0 \uC788\uB098\uC694?[VAR 0114(002A)]",
  "\uB098\uBB34\uC5F4\uB9E4\uB97C \uC900\uB2E4!",
  "\uC0C1\uD0DC \uC774\uC0C1\uC73C\uB85C \uB9CC\uB4E0\uB2E4!",
  "\uD798\uC758 \uCC28\uC774\uB97C \uBCF4\uC5EC \uC900\uB2E4!",
  "\uC5B4\uB77C~? \uC124\uB9C8 \uB2E4\uB978 \uC9C0\uBC29\uC758 \uC774\uC57C\uAE30\uB97C\\n\uD558\uB294 \uAC74 \uC544\uB2C8\uC8E0?\\c\\n\uD314\uB370\uC544\uC5D0\uC11C\uB294 \uC870\uAE08\\n\uC778\uC2DD\uC774 \uB2E4\uB97C \uAC70\uC608\uC694...[VAR 0114(002A)]",
  "\uC640\uC6B0~ \uC798\uD588\uC5B4\uC694, [VAR 0100(0000)]!\\n\uC815\uB2F5\uC774\uC5D0\uC694![VAR 0114(002A)]",
  "\uC640\uC6B0... [VAR 0100(0000)][VAR 1900(0001)]\\n\uBC1C\uC0C1\uC774 \uAF64\uB098 \uC640\uC77C\uB4DC\uD558\uB124\uC694...\\c\\n\uD655\uC2E4\uD788 \uAC15\uD55C \uD3EC\uCF13\uBAAC\uC744 \uB0B4\uBCF4\uB0B4\uBA74\\n\uBC30\uD2C0\uC744 \uC720\uB9AC\uD558\uAC8C \uC774\uB04C\uC5B4 \uAC08 \uC218\uB294 \uC788\uC9C0\uB9CC...[VAR 0114(002A)]",
  "\uB9DE\uC544\uC694, \uC0C1\uD0DC \uC774\uC0C1\uC73C\uB85C \uB9CC\uB4E4\uBA74\\n\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC838\uC694.[VAR 0114(002A)]",
  "\uD2B9\uD788, \uC7A0\uB4E6 \uC0C1\uD0DC\uB85C \uB9CC\uB4E4\uBA74\\n\uD3EC\uD68D\uB960\uC774 \uB9E4\uC6B0 \uD06C\uAC8C \uC62C\uB77C\uAC04\uB2F5\uB2C8\uB2E4![VAR 0114(002A)]",
  "\uC218\uBA74\uAC00\uB8E8\uB098 \uCD5C\uBA74\uC220\uAC19\uC774,\\n\uC0C1\uB300\uB97C \uC7A0\uB4E4\uAC8C \uD558\uB294 \uAE30\uC220\uC774 \uC788\uC73C\uBA74\\r\\n\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uB354 \uB9CE\uC774 \uCC44\uC6B8 \uC218 \uC788\uC744 \uAC70\uC608\uC694![VAR 0114(002A)]",
  "\uADF8 \uBC16\uC5D0 \uD3EC\uD68D\uB960\uC744 \uC62C\uB9AC\uB294 \uBC29\uBC95\uC73C\uB85C\uB294\\n\uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC54C\uB9DE\uC740 \uBCFC\uC744 \uC0AC\uC6A9\uD55C\uB2E4\uAC70\uB098,[VAR 0114(002A)]",
  "\uC2DD\uC0AC\uB97C \uD574\uC11C \uD3EC\uD68D \uD30C\uC6CC\uB97C \uC5BB\uB294\uB2E4\uAC70\uB098,\\n\uD3EC\uCF13\uBAAC\uC758 \uB4A4\uC5D0\uC11C \uC2B9\uBD80\uB97C \uAC70\uB294 \uAC83\uC774 \uC788\uC5B4\uC694.[VAR 0114(002A)]",
  "\uD3EC\uCF13\uBAAC\uC744 \uD3EC\uD68D\uD558\uAE30 \uD798\uB4E4\uC5B4\uC9C8 \uB54C\uB294\\n\uCCB4\uC721\uAD00\uC5D0 \uB3C4\uC804\uD574\uC11C \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBAA8\uC73C\uBA74,[VAR 0114(002A)]",
  "\uC7A1\uC744 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC758 \uCD5C\uB300 \uB808\uBCA8\uC744\\n\uC62C\uB9B4 \uC218 \uC788\uC73C\uB2C8\uAE4C, \uC798 \uAE30\uC5B5\uD574 \uB450\uC138\uC694![VAR 0114(002A)]",
  "\uD3EC\uCF13\uBAAC \uB3C4\uAC10\uC744 \uCC44\uC6B0\uBA74 \uC120\uC0DD\uB2D8\uC5D0\uAC8C\\n\uBCF4\uC5EC \uC8FC\uB294 \uAC83\uB3C4 \uAF2D \uC78A\uC9C0 \uB9C8\uC2DC\uAD6C\uC694![VAR 0114(002A)]",
  "\uC624\uB298\uB3C4 \uC7AC\uBBF8\uC788\uC5C8\uC8E0? \uB2E4\uC74C \uC2DC\uAC04\uC740\\n\uC2DC\uD5D8\uC744 \uBCFC \uAC70\uB2C8\uAE4C \uACF5\uBD80\uD574 \uB450\uC138\uC694~![VAR 0114(002A)]"
]
