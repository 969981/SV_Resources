[
  "\uC54C\uB85C\uB77C\uC758 \uBAA8\uC2B5\uC778 \uD3EC\uCF13\uBAAC\uC740 \uC7A1\uC558\uB098\uC694?",
  "\uC54C\uB85C\uB77C\uB97C \uAC70\uB2C8\uB294 \uAE30\uBD84\uC73C\uB85C\\n\uB3CC\uC544\uB2E4\uB140 \uBCF4\uC138\uC694!",
  "...\uC548\uD0C0\uAE5D\uC9C0\uB9CC \uADF8 \uD3EC\uCF13\uBAAC\uC740\\n\uC54C\uB85C\uB77C\uC758 \uBAA8\uC2B5\uC774 \uC544\uB2C8\uC5D0\uC694.",
  "\uC624\uC624! \uADF8 [VAR 0101(0001)][VAR 1900(0001)]\\n\uD2C0\uB9BC\uC5C6\uB294 \uC54C\uB85C\uB77C\uC758 \uBAA8\uC2B5!",
  "\uC0AC\uC774\uCF54 \uD30C\uC6CC\uB97C \uC9D1\uC911\uC2DC\uD0A8 \uAF2C\uB9AC\uB97C \uD0C0\uACE0\\n\uBBF8\uB044\uB7EC\uC9C0\uB4EF \uC774\uB3D9\uD574\uC11C\\r\\n\uC721\uC9C0 \uC11C\uD37C\uB77C\uACE0\uB3C4 \uBD88\uB9AC\uB294 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uBA38\uB9AC\uC5D0 \uB3CB\uC544\uB09C\\n\uAE08\uC18D \uC7AC\uC9C8\uC758 \uC218\uC5FC\uC744 \uD754\uB4E4\uC5B4\uC11C\\r\\n\uB3D9\uB8CC\uC640 \uAD50\uC2E0\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uAE08\uBE5B\uC73C\uB85C \uBE5B\uB098\uB294 \uC218\uC5FC\uC774 \uACE0\uB3C4\uC758 \uC13C\uC11C\\n\uC5ED\uD560\uC744 \uD574\uC11C \uC218 \uD0AC\uB85C\uBBF8\uD130 \uBC16\uC758 \uC18C\uB9AC\uB3C4\\r\\n\uAC10\uC9C0\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uBCC0\uB355\uC774 \uC2EC\uD558\uACE0 \uC81C\uBA4B\uB300\uB85C\uC5D0 \uC2EB\uC99D\uB3C4 \uC798 \uB0B4\uC11C\\n\uC0AC\uB791\uBC1B\uB294 \uAC83\uBCF4\uB2E4 \uC8FC\uB294 \uAC78 \uC88B\uC544\uD558\uB294\\r\\n\uD2B8\uB808\uC774\uB108\uC5D0\uAC8C \uC778\uAE30 \uB9CC\uC810\uC778 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uB6F0\uC5B4\uB09C \uC2E0\uCCB4 \uB2A5\uB825\uC744 \uAC16\uCD94\uACE0 \uC788\uACE0\\n\uB465\uADFC \uC5BC\uAD74\uACFC \uB9E4\uB044\uB7EC\uC6B4 \uD138 \uB54C\uBB38\uC5D0\\r\\n\uC54C\uB85C\uB77C\uC9C0\uBC29\uC5D0\uC11C \uC778\uAE30 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uC4F0\uB808\uAE30 \uBB38\uC81C\uB97C \uD574\uACB0\uD558\uAE30 \uC704\uD574\\n\uC54C\uB85C\uB77C\uB85C \uB370\uB824\uAC04 \uC9C8\uD37D\uC774\uAC00\\r\\n\uC5B4\uB290\uC0C8 \uBAA8\uC2B5\uC744 \uBC14\uAFBC \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uC774\uBE68\uC774\uB098 \uC190\uD1B1\uC73C\uB85C \uBCF4\uC774\uB294 \uB3C5\uC18C\uC758 \uACB0\uC815\uC744\\n\uB9CC\uC9C0\uAE30\uB9CC \uD574\uB3C4 \uC911\uB3C5\uB420 \uC218 \uC788\uC5B4\uC11C\\r\\n\uB2E4\uAC00\uAC00\uBA74 \uC704\uD5D8\uD55C \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uBB34\uB7ED\uBB34\uB7ED \uC790\uB780 \uD0D3\uC5D0\\n\uC0AC\uC774\uCF54 \uD30C\uC6CC\uAC00 \uD544\uC694 \uC5C6\uAC8C \uB418\uC5B4\\r\\n\uB4DC\uB798\uACE4\uC758 \uD798\uC744 \uAC01\uC131\uD55C \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uC601\uD558 50\uB3C4\uC5D0 \uB2EC\uD558\uB294 \uB0C9\uAE30\uB97C \uBFDC\uACE0\\n\uACFC\uAC70\uC5D0\uB294 \uCF00\uC624\uCF00\uC624\uB77C\uB294 \uC774\uB984\uC73C\uB85C\\r\\n\uBD88\uB9AC\uAE30\uB3C4 \uD55C \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uB208\uC73C\uB85C \uD3D0\uC1C4\uB41C \uC0B0\uC18D\uC5D0 \uC0B4\uBA70\\n\uD138\uC5D0\uC11C \uC5BC\uC74C \uC785\uC790\uB97C \uB9CC\uB4E4\uC5B4 \uB0B4\uB294\\r\\n\uC2E0\uC758 \uD654\uC2E0\uC73C\uB85C \uC22D\uC0C1\uB418\uC5B4 \uC628 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uB208\uC73C\uB85C \uBD09\uC1C4\uB41C \uC0B0\uC545 \uC9C0\uB300\uC5D0 \uC0B4\uBA70\\n\uAC15\uCCA0\uCC98\uB7FC \uB2E8\uB2E8\uD55C \uC5BC\uC74C\uC73C\uB85C \uB41C \uB4F1\uACFC\\r\\n\uBD80\uB4DC\uB7EC\uC6B4 \uBC30\uB97C \uAC00\uC9C4 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uB208\uC744 \uD5E4\uCE58\uAE30 \uC704\uD574\\n\uBC1C\uD1B1\uC774 \uB450\uAECD\uACE0 \uC608\uB9AC\uD558\uAC8C \uBC1C\uB2EC\uD574\uC11C\\r\\n\uC124\uC6D0\uC744 \uACE0\uC18D\uC73C\uB85C \uB2EC\uB9AC\uB294 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uC790\uB825\uC744 \uB760\uB294 \uB3CC\uB85C \uB41C \uBAB8!\\n\uD2B9\uD788 \uC790\uB825\uC774 \uAC15\uD55C \uBD80\uBD84\uC5D0\uB294\\r\\n\uC0AC\uCCA0\uC774 \uBE7D\uBE7D\uD558\uAC8C \uBD99\uC5B4 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uC990\uACA8 \uBA39\uB294 \uB3CC\uC758 \uC601\uD5A5\uC73C\uB85C\\n\uC804\uC2E0\uC5D0 \uC804\uAE30\uB97C \uB760\uACE0 \uC788\uB294\\r\\n\uB9E4\uC6B0 \uD638\uC804\uC801\uC778 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uC2E0\uACBD\uC9C8\uC801\uC774\uACE0 \uC644\uACE0\uD574\uC11C\\n\uAE30\uBD84\uC774 \uC0C1\uD558\uBA74 \uBC29\uC804\uD558\uBA70\\r\\n\uC6B0\uB81B\uC18C\uB9AC\uAC19\uC774 \uD06C\uAC8C \uC6B0\uB294 \uD3EC\uCF13\uBAAC\uC774\uC5D0\uC694!",
  "\uC751!? [VAR 0100(0000)] \uC528,\\n\uBC8C\uC368 \uC7A1\uC740 \uAC70\uC608\uC694?[VAR 0114(0049)]",
  "\uC5F4\uC2EC\uD788 \uD588\uC5B4\uC694!",
  "\uC5EC\uC720\uB85C\uC6E0\uC5B4\uC694!",
  "\uBC30\uD2C0\uBFD0\uB9CC \uC544\uB2C8\uB77C\\n\uD3EC\uD68D \uC2E4\uB825\uAE4C\uC9C0 \uB6F0\uC5B4\uB098\uC2E4 \uC904\uC774\uC57C...[VAR 0114(0049)]",
  "\uC624\uB80C\uC9C0 \uC544\uCE74\uB370\uBBF8\uAC00\\n\uC5BC\uB9C8\uB098 \uC218\uC900 \uB192\uC740 \uACF3\uC778\uC9C0 \uC798 \uC54C\uACA0\uB124\uC694.[VAR 0114(0049)]",
  "\uADF8\uB808\uC774\uD504 \uC544\uCE74\uB370\uBBF8\uAC00\\n\uC5BC\uB9C8\uB098 \uC218\uC900 \uB192\uC740 \uACF3\uC778\uC9C0 \uC798 \uC54C\uACA0\uB124\uC694.[VAR 0114(0049)]",
  "\uC790, \uADF8\uB7FC \uBAA8\uB450 \uC9D1\uD569\uD574 \uC8FC\uC138\uC694~!",
  "\uC2DC\uAC04\uC774 \uB2E4 \uB410\uC73C\uB2C8\\n\uC218\uC5C5\uC740 \uC5EC\uAE30\uC11C \uB9C8\uCE60\uAC8C\uC694!",
  "\uC7A1\uC9C0 \uBABB\uD55C \uD559\uC0DD\uC740\\n\uB2E4\uC74C \uC2DC\uAC04\uAE4C\uC9C0 \uC219\uC81C\uB85C \uC7A1\uC544 \uC624\uC138\uC694!\\r\\n\uADF8\uB7FC, \uD574\uC0B0!",
  "\uCE6B, \uB098\uB294 \uC219\uC81C \uB2F9\uCCA8\uC774\uC796\uC544~",
  "[VAR 0100(0000)] \uC528,\\n\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758 \uC218\uC5C5\uC740 \uC5B4\uB5A0\uC168\uC5B4\uC694?[VAR 0114(0049)]",
  "\uC7AC\uBC0C\uC5C8\uC5B4\uC694!",
  "\uC5EC\uC720\uB85C\uC6E0\uC5B4\uC694!",
  "\uC640~ \uADF8\uAC70 \uB2E4\uD589\uC774\uB124\uC694!\\n\uAD1C\uD788 \uC800\uAE4C\uC9C0 \uBFCC\uB4EF\uD574\uC9C0\uB294\uB370\uC694![VAR 0114(0049)]",
  "\uD314\uB370\uC544\uC5D0\uC11C\uB294 \uC880 \uB354\\n\uC218\uC900 \uB192\uC740 \uC218\uC5C5\uC744 \uD558\uB294\uAD70\uC694...![VAR 0114(0049)]",
  "\uC557! \uC800, \uBD80\uC2E4\uC5D0 \uAC00 \uBD10\uC57C \uD558\uB294 \uAC78\\n\uC78A\uACE0 \uC788\uC5C8\uC5B4\uC694![VAR 0114(0049)]",
  "\uC548\uB0B4\uB294 \uB05D\uB0AC\uC9C0\uB9CC\\n\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD558\uB098\uB9CC \uB354 \uC54C\uB824 \uB4DC\uB9B4\uAC8C\uC694![VAR 0114(0049)]",
  "\uC800\uD76C \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C\uB294\\n[VAR FF00(0006)]\uBE14\uB8E8\uBCA0\uB9AC \uC2A4\uD398\uC15C \uB808\uD06C\uB9AC\uC5D0\uC774\uC158[VAR FF00(0000)]\\r\\n\uC904\uC5EC\uC11C [VAR FF00(0006)]\uBE14\uB8E8\uB808\uD06C[VAR FF00(0000)]\uAC00 \uC720\uD589\uD558\uACE0 \uC788\uC5B4\uC694![VAR 0114(0049)]",
  "\uBE14\uB8E8\uB808\uD06C\uB294 \uB3D4 \uC548\uC5D0\uC11C \uD65C\uB3D9 \uC911\uC77C \uB54C\\n\uC544\uCE74\uB370\uBBF8\uC5D0\uC11C \uB0B4\uB9AC\uB294 \uBBF8\uC158\uC774\uC5D0\uC694.[VAR 0114(0049)]",
  "\uB9E1\uAE30\uAE30 \uBC30\uD2C0\uC744 \uD558\uAC70\uB098\\n\uD2B9\uC815 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uB294 \uB4F1,\\r\\n\uB2E4\uC591\uD55C \uBBF8\uC158\uC5D0 \uB3C4\uC804\uD560 \uC218 \uC788\uC5B4\uC694![VAR 0114(0049)]",
  "\uC5B8\uC81C \uC5B4\uB514\uC11C \uC5B4\uB5A4 \uBBF8\uC158\uC774 \uB098\uC62C\uC9C0\uB294\\n\uB204\uAD6C\uB3C4 \uC608\uCE21\uD560 \uC218 \uC5C6\uC9C0\uB9CC\uC694.[VAR 0114(0049)]",
  "\uBBF8\uC158\uC744 \uD074\uB9AC\uC5B4\uD560 \uB54C\uB9C8\uB2E4 \uC544\uCE74\uB370\uBBF8 \uB0B4 \uD1B5\uD654\uC778\\n[VAR FF00(0006)]BP(\uBE14\uB8E8\uBCA0\uB9AC\uD3EC\uC778\uD2B8)[VAR FF00(0000)]\uB97C \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694![VAR 0114(0049)]",
  "BP\uB294 [VAR FF00(0006)]\uC2DD\uB2F9[VAR FF00(0000)]\uC774\uB098 [VAR FF00(0006)]\uB9E4\uC810[VAR FF00(0000)]\uC5D0\uC11C\\n\uB3C8 \uB300\uC2E0 \uC4F8 \uC218 \uC788\uC5B4\uC694!\\r\\n\uADF8\uB9AC\uACE0 [VAR FF00(0006)]\uBD80\uD65C\uB3D9[VAR FF00(0000)]\uC744 \uD560 \uB54C\uB3C4\uC694...[VAR 0114(0049)]",
  "\uC544\uBB34\uD2BC, \uBE14\uB8E8\uB808\uD06C\uB97C \uD558\uBA74\uC11C\\nBP\uB97C \uB9CE\uC774 \uBAA8\uC544 \uBCF4\uC138\uC694![VAR 0114(0049)]",
  "...\uB05D\uC774\uC5D0\uC694!\\n\uAE09\uD558\uAC8C \uC124\uBA85\uD574\uC11C \uC8C4\uC1A1\uD574\uC694.[VAR 0114(0049)]",
  "\uADF8\uB7FC \uC800\uB294 \uC774\uB9CC \uAC00 \uBCFC\uAC8C\uC694!\\n\uC544\uCE74\uB370\uBBF8\uC5D0\uC11C \uC990\uAC81\uAC8C \uC9C0\uB0B4 \uBCF4\uC138\uC694![VAR 0114(0049)]",
  "\uC774\uD6C4 \uC2A4\uD1A0\uB9AC\uB97C \uC9C4\uD589\uD558\uB824\uBA74\\c\\n\uBCF8\uD3B8 \uBA54\uC778 \uC2DC\uB098\uB9AC\uC624\uC640\\n\uC81C\uB85C\uC758 \uBE44\uBCF4 \uC804\uD3B8 \u201C\uBCBD\uB85D\uC758 \uAC00\uBA74\u201D\uC744\\r\\n\uD074\uB9AC\uC5B4\uD574\uC57C \uD569\uB2C8\uB2E4.\\c\\n[VAR FF00(0006)]\uD314\uB370\uC544\uC9C0\uBC29[VAR FF00(0000)]\uC774\uB098 [VAR FF00(0006)]\uBD81\uC2E0\uC758 \uACE0\uC7A5[VAR FF00(0000)]\uC5D0\\n\uB0A8\uC740 \uC77C\uB4E4\uC744 \uBA3C\uC800 \uB05D\uB0B4 \uC8FC\uC138\uC694!"
]
