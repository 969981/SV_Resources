[
  "\uC5B4\uB77C? \uB108\uB294...[VAR 0114(001A)]",
  "\uD65C\uAC15\uD558\uB7EC \uC628 \uAC70\uC57C?\\n\uC624\uB298 \uB208 \uC0C1\uD0DC\uAC00 \uC88B\uC558\uB358\uAC00...?[VAR 0114(001A)]",
  "\uC2B9\uBD80\uD558\uB7EC \uC654\uC5B4\uC694",
  "\uB9CC\uB098\uB7EC \uC654\uC5B4\uC694",
  "\uC751? \uADF8\uAC74 \uC880...\\n\uC774\uB530 \uC911\uC694\uD55C \uC77C\uC815\uC774 \uC788\uC5B4\uC11C \uB9D0\uC774\uC57C.[VAR 0114(001A)]",
  "\uC73C\uC74C...?\\n\uBB34\uC2A8 \uB73B\uC778\uC9C0 \uC804\uD600 \uBAA8\uB974\uACA0\uB294\uB370...[VAR 0114(001A)]",
  "...\uADF8\uB807\uAD6C\uB098.\\n\uB124\uAC00 \uD14C\uC0AC \uC528 \uB300\uC2E0 \uC654\uB2E4\uB294 \uAC70\uC9C0?[VAR 0114(001A)]",
  "\uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAC00 \uB418\uB2E4\uB2C8,\\n\uAFC8\uC744 \uC774\uB8EC \uAC83 \uAC19\uC544\uC11C \uC798~\uB410\uB124.[VAR 0114(001A)]",
  "...\uC774\uB7F0, \uBBF8\uC548.\\n\uB0B4\uAC00 \uC0DD\uAC01\uD574\uB3C4 \uBE48\uC815\uB300\uB294 \uAC83\uCC98\uB7FC \uB4E4\uB9AC\uB294\uAC78.[VAR 0114(001A)]",
  "\uC815\uB9D0 \uB300\uB2E8\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5B4.\\n\uB2E8\uC9C0, \uAC1C\uC778\uC801\uC73C\uB85C \uC880... \uBCF5\uC7A1\uD574\uC11C \uB9D0\uC774\uC57C.[VAR 0114(001A)]",
  "\uC544\uBB34\uD2BC, \uC2E4\uB825\uC744 \uBCF4\uB7EC \uC654\uB2E4\uB294 \uAC70\uC9C0?\\n\uADF8\uB7FC, \uBE68\uB9AC \uB05D\uB0B4\uB3C4\uB85D \uD558\uC790.[VAR 0114(001A)]",
  "\uC2B9\uBD80\uD560 \uB9C8\uC74C\uC774 \uB4E4\uC5C8\uC5B4?\\n\uADF8\uB7FC, \uBE68\uB9AC \uB05D\uB0B4\uB3C4\uB85D \uD558\uC790.[VAR 0114(001A)]",
  "...\uBC16\uC73C\uB85C \uB098\uAC08\uAE4C?\\n\uB208\uC774 \uB0B4\uB9AC\uC9C0 \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uB124.[VAR 0114(001A)]",
  "\uC5EC\uAE30\uAE4C\uC9C0 \uC640\uC11C \uADF8\uB9CC\uB450\uACA0\uB2E4\uB2C8...\\n\uB108\uB3C4 \uCC38 \uD2B9\uC774\uD55C \uB140\uC11D\uC774\uAD6C\uB098.[VAR 0114(001A)]"
]
