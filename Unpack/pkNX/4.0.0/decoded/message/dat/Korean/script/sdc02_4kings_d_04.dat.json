[
  "\uC74C~\\n\uC5EC\uAE30\uCBE4\uC774\uBA74 \uB418\uACA0\uC9C0?[VAR 0114(004A)]",
  "[VAR 0100(0000)]\uC758 \uC2F8\uC6B0\uB294 \uBAA8\uC2B5...[VAR 0114(004A)]",
  "\uC9C0\uAE08\uAE4C\uC9C0 \uCF54\uD2B8 \uBC16\uC5D0\uC11C \uBCF8 \uAC8C \uC804\uBD80\uC600\uB358\uAC00?[VAR 0114(004A)]",
  "\uC774\uB807\uAC8C \uC815\uBA74\uC73C\uB85C \uB300\uCE58\uD558\uB294 \uAC74 \uCC98\uC74C\uC774\uB124.[VAR 0114(004A)]",
  "[VAR 1100(00FF,0303)]\uBE0C\uB77C\uB354\uC2DC\uC2A4\uD130\uAC00 \uBE14\uB8E8\uBCA0\uB9AC\uADF8\uC5D0\uC11C\\n\uC774\uAE30\uC9C0 \uBABB\uD558\uBA74 \uACE4\uB780\uD574\uC9C8 \uAC70\uC57C...[VAR 0114(004A)]",
  "\uACE4\uB780\uD574\uC9C0\uACE0\uB9D0\uACE0...\\n\uBB34\uC9C0~\uD558\uAC8C \uACE4\uB780\uD574\uC9C0\uACE0\uB9D0\uACE0![VAR 0114(004A)]",
  "...\uADF8\uB807\uB2E4\uACE0 \uD574\uC11C[VAR 0114(004A)]",
  "\uC5EC\uAE30\uC11C \uB0B4\uAC00 \uB110 \uBD10\uC8FC\uBA74\\n\uD558\uB098\uB3C4 \uC990\uAC81\uC9C0 \uC54A\uC73C\uB2C8\uAE4C,\\r\\n\uC870\uAE08\uC740 \uC2E4\uB825\uC744 \uBC1C\uD718\uD574 \uC8FC\uACA0\uC5B4.[VAR 0114(004A)]",
  "...\uBB50!\\n\uB108\uBB34 \uC5B4\uB835\uAC8C \uC0DD\uAC01\uD560 \uAC70 \uC5C6\uC5B4.[VAR 0114(004A)]",
  "\uB108\uB294 \uD3C9\uC18C\uB300\uB85C \uC2F8\uC6B0\uAE30\uB9CC \uD558\uBA74 \uB3FC.[VAR 0114(004A)]",
  "\uAC1C\uC778\uC801\uC73C\uB85C \uC774\uBC88 \uC2B9\uBD80...\\n\uB9CE\uC774 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4.[VAR 0114(004A)]",
  "\uADF8\uB7FC, \uC2AC\uC2AC \uC2DC\uC791\uD574 \uBCFC\uAE4C?[VAR 0114(004A)]",
  "\uC990\uAE30\uBA74\uC11C \uD574 \uBCF4\uC790\uACE0, [VAR 1100(00FF,0303)]\uBE0C\uB77C\uB354\uC2DC\uC2A4\uD130![VAR 0114(004A)]",
  "\uD5E4\uD5E4\uD5F7!\\n\uC5C4\uCCAD\uB098\uAC8C \uC7AC\uBBF8\uC788\uC5C8\uC5B4![VAR 0114(004A)]",
  "[VAR 0100(0000)]...\\n\uB108\uB97C \uB9AC\uADF8\uBD80\uC5D0 \uCD08\uB300\uD558\uAE38 \uC798\uD55C \uAC83 \uAC19\uC544.[VAR 0114(004A)]",
  "\uB098\uB97C \uC774\uAE34 \uC774\uC0C1\\n\uC815\uC2DD \uBD80\uC6D0\uC774 \uB420 \uC218\uBC16\uC5D0 \uC5C6\uACA0\uB294\uAC78!?\\r\\n\uC5B4\uB54C!? \uC88B\uC9C0!?[VAR 0114(004A)]",
  "\uD5E4\uD5E4\uD5F7!\\n\uC2DC\uC6D0\uC2DC\uC6D0\uD55C\uAC78![VAR 0114(004A)]",
  "\uCA68\uCA68\uD558\uAC8C \uAD74\uAE30\uB294!\\n\uB9D0\uC740 \uADF8\uB807\uAC8C \uD574\uB3C4\\r\\n\uC18D\uC740 \uBC18\uB300\uC778 \uBB50 \uADF8\uB7F0 \uAC70\uC9C0!?[VAR 0114(004A)]",
  "\uADF8\uB7FC, \uBD80\uC6D0 \uBA85\uBD80\uC5D0 \uC0AC\uC6A9\uD560\\n\uC0AC\uC9C4\uC744 \uCC0D\uB3C4\uB85D \uD560\uAE4C![VAR 0114(004A)]",
  "...\uC774 \uC0AC\uC9C4, \uB108\uBB34 \uC7A5\uB09C\uC2A4\uB7FD\uAC8C \uCC0D\uC5C8\uB2E4\uACE0\\n\uD0C0\uB85C\uD55C\uD14C \uD63C\uB098\uACA0\uB294\uAC78?[VAR 0114(004A)]",
  "\uADF8\uB9AC\uACE0...\\n\uB610 \uBB54\uAC00 \uD560 \uAC8C \uC788\uC5C8\uB294\uB370...[VAR 0114(004A)]",
  "\uC0AC\uCC9C\uC655\uC744 \uC774\uAE34 \uB140\uC11D\uC5D0\uAC8C\uB294\\n\uAE30\uC220\uBA38\uC2E0\uC744 \uC918\uC57C \uD588\uB358\uAC00?[VAR 0114(004A)]",
  "\uC9C0\uAE08\uC740 \uAC16\uACE0 \uC788\uB294 \uAC8C \uC5C6\uC73C\uB2C8\uAE4C\\n\uC7A0\uAE50 \uAE30\uB2E4\uB824.[VAR 0114(004A)]",
  "\uC0AC\uCC9C\uC655 \uC81C\uBE48\uC5D0\uAC8C \uC2B9\uB9AC\uD558\uC2E0 \uAC83\uC744\\n\uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!"
]
