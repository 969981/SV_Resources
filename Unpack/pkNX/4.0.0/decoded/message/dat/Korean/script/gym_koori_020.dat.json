[
  "\uB098\uD398\uC0B0\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uC5D0 \uAD00\uD55C \uC124\uBA85\uC744\\r\\n\uB2E4\uC2DC \uD55C\uBC88 \uB4E4\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uB098\uD398\uC0B0\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB294\\n[VAR FF00(0006)]\uC124\uC0B0 \uD65C\uAC15\uD558\uAE30[VAR FF00(0000)]!",
  "\uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC\uC744 \uD0C0\uACE0\\n\uC900\uBE44\uB41C \uCF54\uC2A4\uB97C \uC2DC\uAC04 \uB0B4\uC5D0 \uB3CC\uD30C\uD574 \uC8FC\uC138\uC694!",
  "\uC790\uC138\uD55C \uB8F0 \uC124\uBA85\uC740 \uCCB4\uC721\uAD00\uC744 \uB098\uAC00\uC11C\\n\uC67C\uCABD \uC5B8\uB355\uC744 \uC62C\uB77C\uAC00\uBA74 \uC788\uB294\\r\\n\uCD9C\uBC1C \uC9C0\uC810\uC5D0\uC11C \uB4E4\uC5B4 \uC8FC\uC138\uC694.",
  "[VAR 0201(0000)]:[VAR 0201(0001)].[VAR 0201(0002)]",
  "[VAR 0201(0000)]:[VAR 0201(0001)].[VAR 0201(0002)]",
  "[VAR 0201(0000)]:[VAR 0201(0001)].[VAR 0201(0002)]",
  "\u002B[VAR 0200(0000)].[VAR 0201(0001)]",
  "--:--.--",
  "\uC548\uB155! \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC5B4.\\n\uC5EC\uAE30\uAC00 \uC124\uC0B0 \uD65C\uAC15\uD558\uAE30\uC758 \uCD9C\uBC1C \uC9C0\uC810\uC774\uC57C.",
  "\uB108\uB294 \uC774 \uB300\uC790\uC5F0\uC758 \uCF54\uC2A4\uB97C\\n\uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC\uC73C\uB85C \uD65C\uAC15\uD558\uBA74 \uB3FC.",
  "\uBAA9\uD45C \uC2DC\uAC04 \uB0B4\uC5D0 \uACE8\uC778\uC5D0 \uC131\uACF5\uD558\uBA74\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uD074\uB9AC\uC5B4\uC57C!",
  "\uADF8\uB7FC \uBC14\uB85C \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\\n\uC124\uC0B0 \uD65C\uAC15\uD558\uAE30\uC5D0 \uB3C4\uC804\uD560\uB798?",
  "\uC0C8\uD558\uC580 \uC138\uC0C1\uC744 \uC990\uAE30\uB3C4\uB85D \uD558\uB834!\\n\uADF8\uB7FC, \uC2A4\uD0C0\uD2B8!",
  "\uB3C4\uC804\uD55C\uB2E4",
  "\uC124\uBA85\uC744 \uB4E3\uB294\uB2E4",
  "\uADF8\uB9CC\uB454\uB2E4",
  "\uCD95\uD558\uD574! \uACE8\uC778\uC774\uC57C!\\n\uCD5C\uACE0\uB85C \uBA4B\uC9C4 \uD65C\uAC15\uC774\uC5C8\uC5B4!\\r\\n\uB9C8\uCE58 \uD604\uC5ED \uB54C \uADF8\uB8E8\uC0E4\uB97C \uBCF4\uB294 \uAC83 \uAC19\uC740...",
  "\uC5B4\uC774\uCFE0, \uC544\uBB34\uD2BC \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB294 \uB300\uC131\uACF5\uC774\uC57C!\\n\uACB0\uACFC\uB294 \uC811\uC218\uCC98\uC5D0 \uBCF4\uACE0\uD558\uB3C4\uB85D \uD558\uB834!",
  "\uC544\uC27D\uC9C0\uB9CC \uC124\uC0B0 \uD65C\uAC15\uD558\uAE30\uB294 \uC2E4\uD328\uC57C!\\n\uADF8\uB798\uB3C4 \uB2E4\uCE58\uC9C0 \uC54A\uC544\uC11C \uB2E4\uD589\uC774\uB124!",
  "\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB294 \uBA87 \uBC88\uC774\uB4E0\\n\uB3C4\uC804\uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C \uB108\uBB34 \uAC71\uC815\uD558\uC9C0 \uB9C8!\\r\\n\uD3EC\uAE30\uD558\uC9C0 \uB9D0\uACE0, \uBB34\uB9AC\uD558\uC9C0\uB3C4 \uB9D0\uACE0, \uD798\uB0B4\uB834!",
  "\uAE30\uAD8C\uD55C\uB2E4"
]
