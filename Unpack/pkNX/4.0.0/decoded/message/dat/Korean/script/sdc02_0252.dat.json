[
  "\uBB50\uC57C, \uC5EC\uAE30 \uB300\uBC15\uC774\uB2E4!\\n\uB9C8\uCE58 \uD0DC\uB77C\uC218\uD638 \uAC19\uC544![VAR 0114(0044)]",
