[
  "...\uC5B4\uB77C? \uCC98\uC74C \uBCF4\uB294 \uD559\uC0DD\uB3C4\\n\uC788\uB294 \uAC83 \uAC19\uB124?[VAR 0114(002C)]",
  "\uB0B4 \uC774\uB984\uC740 \uB808\uD3EC\uB974. \uC5EC\uB7EC\uBD84\uC5D0\uAC8C\\n\uBA3C \uC61B\uB0A0\uC758 \uD559\uC220\uC744 \uAC00\uB974\uCCD0 \uC904 \uC120\uC0DD\uB2D8\uC774\uC57C.[VAR 0114(0027)]",
  "\uC5ED\uC0AC\uB294 \uC815\uB9D0 \uC88B\uACE0... \uD6CC\uB96D\uD558\uB2E4\uACE0...\\n\uC120\uC778\uB4E4\uC774 \uC313\uC544 \uC62C\uB9B0 \uC2DC\uAC04\uB4E4\uC774...\\r\\n\uC6B0\uB9AC\uAC00 \uC0B4\uACE0 \uC788\uB294 \uC624\uB298\uB85C \uC774\uC5B4\uC838 \uC788\uC73C\uB2C8\uAE4C![VAR 0114(0027)]",
  "\uC544\uBB34\uD2BC, \uC624\uB298\uC740 \uD314\uB370\uC544\uC9C0\uBC29\uC5D0\uC11C\\n\uAC00\uC7A5 \uC2E0\uBE44\uD55C \uC7A5\uC18C\uC778\\r\\n\uC218\uC218\uAED8\uB07C\uC758 \uB300\uACF5\uC5D0 \uB300\uD574 \uBC30\uC6CC \uBCF4\uB3C4\uB85D \uD558\uC790.[VAR 0114(0027)]",
  "\uB2E4\uB4E4 \uC54C\uACE0 \uC788\uB2E4\uC2DC\uD53C,\\n\uD314\uB370\uC544 \uC911\uC559\uC5D0\uB294 \uAC70\uB300\uD55C \uAD6C\uBA4D\uC778\\r\\n\u201C\uD314\uB370\uC544\uC758 \uB300\uACF5\u201D\uC774 \uC874\uC7AC\uD558\uACE0 \uC788\uC5B4.[VAR 0114(0027)]",
  "\uAD6C\uBA4D \uC548\uC740 \u201C\uC5D0\uB9AC\uC5B4 \uC81C\uB85C\u201D\uB77C \uBD88\uB9AC\uB294\uB370,\\n\uC9C0\uCE35\uACFC \uC131\uBD84\uC5D0 \uC758\uD558\uBA74\\r\\n100\uB9CC \uB144 \uC774\uC0C1\uC774\uB098 \uC804\uBD80\uD130\\r\\n\uC874\uC7AC\uD588\uB358 \uAC83\uC73C\uB85C \uC5F0\uAD6C\uB418\uACE0 \uC788\uC5B4.[VAR 0114(0027)]",
  "\uADF8\uB7F0 \uBE44\uBC00 \uAC00\uB4DD\uD55C \uAD6C\uBA4D \uBC11\uBC14\uB2E5\uC5D0\uB294\\n\uC61B\uB0A0\uBD80\uD130 [VAR FF00(0006)]\uC5B4\uB5A4 \uAC83[VAR FF00(0000)]\uC774 \uC7A0\uB4E4\uC5B4 \uC788\uB2E4\uACE0\\r\\n\uC5EC\uACA8\uC9C0\uACE0 \uC788\uC9C0.[VAR 0114(0027)]",
  "...\uADF8\uB7FC \uC5EC\uAE30\uC11C \uB098\uC640 \uB208\uC774 \uB9C8\uC8FC\uCE5C\\n\uBD88\uC30D\uD55C [VAR 0100(0000)]\uC5D0\uAC8C \uC9C8\uBB38 \uD558\uB098 \uD560\uAE4C?[VAR 0114(0027)]",
  "\uD314\uB370\uC544\uC758 \uB300\uACF5 \uB0B4\uBD80...\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC758 \uBC14\uB2E5\uC5D0\\r\\n\uC7A0\uB4E4\uC5B4 \uC788\uB2E4\uACE0 \uC804\uD574 \uB0B4\uB824\uC624\uB294 \uAC83\uC740 \uBB50\uC9C0?[VAR 0114(0027)]",
  "\uBCF4\uBB3C",
  "\uC7A0\uB9CC\uBCF4",
  "\uD3EC\uCF13\uBAAC\uC13C\uD130",
  "\uD6C4\uD6C4, \uC815\uB2F5\uC774\uC57C!\\n\uAF64\uB098 \uAE5C\uCC0D\uD55C\uAC78?\\r\\n\uC608\uC2B5\uB3C4 \uCCA0\uC800\uD788 \uD574 \uC624\uACE0 \uB9D0\uC774\uC57C.[VAR 0114(0027)]",
  "...\uB561! \uADC0\uC5EC\uC6B4 \uB300\uB2F5\uC774\uC5C8\uC9C0\uB9CC\\n\uC7A0\uB4E4\uC5B4 \uC788\uB2E4\uB294 \uB9D0\uC5D0 \uB108\uBB34 \uB04C\uB9B0 \uAC83 \uAC19\uB124?\\r\\n\uC815\uB2F5\uC740 \uBCF4\uBB3C\uC774\uC57C.[VAR 0114(0027)]",
  "...\uB561! \uD765\uBBF8\uB85C\uC6B4 \uB300\uB2F5\uC774\uC5C8\uC9C0\uB9CC\\n\uC815\uB9D0\uB85C \uC788\uB2E4\uBA74 \uADF8\uAC74 \uC624\uD30C\uCE20 \uC218\uC900\uC77C\uAC78?\\r\\n\uC815\uB2F5\uC740 \uBCF4\uBB3C\uC774\uC57C.[VAR 0114(0027)]",
  "\uB300\uACF5\uC758 \uAE4A\uC740 \uACF3\uC5D0\uB294\\n\uC774 \uC138\uC0C1 \uBAA8\uB4E0 \uAC83\uBCF4\uB2E4 \uAC00\uCE58 \uC788\uB294\\r\\n\uBCF4\uBB3C\uC774 \uC7A0\uB4E4\uC5B4 \uC788\uB2E4\uACE0 \uC5EC\uACA8\uC9C0\uACE0 \uC788\uC5B4![VAR 0114(0027)]",
  "\uC9C0\uAE08\uC740 \uC5F0\uAD6C\uC18C\uAC00 \uC138\uC6CC\uC838 \uC788\uC5B4\uC11C\\n\uB0AD\uB9CC\uC774\uACE0 \uBB50\uACE0 \uC5C6\uC9C0\uB9CC \uB9D0\uC774\uC57C...[VAR 0114(0027)]",
  "...\uADF8\uB798, \uD639\uC2DC\uB098 \uD574\uC11C \uB9D0\uD574 \uB450\uB294 \uAC74\uB370\\n\uD314\uB370\uC544\uC758 \uB300\uACF5\uACFC \uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uB294\\r\\n\uAD00\uACC4\uC790 \uC678\uC5D0\uB294 \uCD9C\uC785 \uAE08\uC9C0\uB2C8\uAE4C[VAR 0114(0027)]",
  "\u201C\uC624\uC608~! \uBCF4\uBB3C\uCC3E\uAE30\uB2E4~!\u201D\\c\\n...\uAC19\uC740 \uC7A5\uB09C\uC2A4\uB7EC\uC6B4 \uB9C8\uC74C\uC73C\uB85C\\n\uB4E4\uC5B4\uAC08 \uC0DD\uAC01\uC740 \uD558\uC9C0 \uC54A\uB294 \uAC8C \uC88B\uC544.[VAR 0114(0027)]",
  "\uADF8\uAC8C \uAC00\uB2A5\uD588\uB2E4\uBA74 \uB098\uB3C4\\n\uD55C\uB2EC\uC74C\uC5D0 \uC870\uC0AC\uD558\uB7EC \uAC14\uC744 \uD14C\uB2C8\uAE4C...!![VAR 0114(0027)]",
  "...\uC5B4\uB77C? \uC774\uC57C\uAE30\uAC00 \uB108\uBB34 \uAE38\uC5C8\uB098?\\n\uC2DC\uAC04 \uCC38 \uBE60\uB974\uB124.[VAR 0114(0027)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0!\\n\uB2E4\uC74C \uC2DC\uAC04\uC5D0\uB3C4 \uC5ED\uC0AC\uC758 \uC218\uC218\uAED8\uB07C\uB97C \uD480\uC5B4 \uBCF4\uC790![VAR 0114(0027)]"
]
