[
  "\uB9C8\uC744 \uD68C\uAD00\uC740 \uC9C0\uC5ED \uC0AC\uB78C\uB4E4\uC774 \uBAA8\uC5EC\uC11C\\n\uACF5\uBD80\uD558\uAC70\uB098 \uB2F4\uC18C\uB97C \uB098\uB204\uBA70\\r\\n\uD3B8\uD558\uAC8C \uC9C0\uB0BC \uC218 \uC788\uB294 \uACF3\uC774\uC57C.",
  "\uCD95\uC81C\uC5D0\uB294 \uAC00 \uBD24\uB2C8?\\n\uB2F9\uBD84\uAC04\uC740 \uACC4\uC18D \uC5F4\uB9AC\uB2C8\uAE4C \uAC00\uC11C \uC990\uACA8 \uBCF4\uB834!",
  "\uC138\uBC97 \uD50C\uB77C\uC790 \uCABD\uC5D0\uC11C\\n\uD070 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uC5B4...\\r\\n\uBD88\uAF43\uB180\uC774\uB97C \uD55C\uB2E4\uB294 \uC774\uC57C\uAE30\uB294 \uC5C6\uC5C8\uB294\uB370?",
  "\uC624\uAC70\uD3F0 \uB2D8, \uADF8\uB807\uAC8C\uB098 \uADC0\uC5EC\uC6B4 \uC5BC\uAD74\uC77C \uC904\uC774\uC57C!\\c\\n...\uAD00\uB9AC\uC778 \uC544\uC800\uC528\uD55C\uD14C\\n\uC624\uAC70\uD3F0 \uAD7F\uC988\uB97C \uB9CC\uB4E4\uC790\uACE0 \uC774\uC57C\uAE30\uD574 \uBCFC\uAE4C?",
  "\uD314\uB370\uC544\uC9C0\uBC29\uC5D0\uB294\\n\uCEE4\uB2E4\uB780 \uD559\uAD50\uAC00 \uC788\uB2E4\uBA70!",
  "\uCD95\uC81C \uD558\uBA74 \uC5ED\uC2DC \uBE59\uC218\uC9C0!\\c\\n\uAC1C\uC778\uC801\uC73C\uB85C\uB294 \uBE14\uB8E8 \uC54C\uB85C\uB77C \uBE59\uC218\uB97C \uCD94\uCC9C\uD574!\\n...\uD600\uAC00 \uD30C\uB797\uAC8C \uB418\uAE30\uB294 \uD558\uC9C0\uB9CC!",
  "\uBC16\uC774 \uBB54\uAC00 \uC18C\uB780\uC2A4\uB7EC\uC6B4 \uAC83 \uAC19\uC740\uB370\\n\uC138\uBC97\uB2D8\uC774 \uBD80\uD65C\uD558\uC2DC\uAE30\uB77C\uB3C4 \uD588\uB098?\\r\\n...\uC5D0\uC774, \uADF8\uB7F4 \uB9AC\uAC00 \uC788\uB098! \uD6C4\uD6C4\uD6C4!",
  "\uC624\uAC70\uD3F0 \uB2D8\uC740 \uB9CC\uB098 \uBD24\uC5B4!?\\c\\n\uB0B4\uB144 \uCD95\uC81C\uC5D0\uB294 \uD2C0\uB9BC\uC5C6\uC774\\n\uB3C4\uAE68\uBE44 \uAC00\uBA74\uC774 \uC778\uAE30 \uC808\uC815\uC77C \uAC70\uC57C!"
]
