  "\uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uB97C \uC0AC\uC6A9\uD558\uBA74\\n\uD3EC\uCF13\uBAAC\uC774 \uD14C\uB77C\uC2A4\uD0C8\uD569\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uD3C9\uC18C\uC5D0\uB294 \uB4DC\uB798\uACE4\uD0C0\uC785\uC778\\n\uB525\uC0C1\uC5B4\uB3D9 \uC120\uBC30\uC785\uB2C8\uB2E4\uB9CC...[VAR 0114(0012)]",
