[
  "\uD6D7... \uAE5C\uC9DD \uB180\uB790\uC9C0?[VAR 0114(0009)]",
  "\uB0B4\uAC00 \uBC14\uB85C \uC9C4 \uBCF4\uC2A4...\\n\uADF8\uB9AC\uACE0 \uCE74\uC2DC\uC624\uD398\uC544\uC57C.[VAR 0114(0009)]",
  "\uD559\uAD50 \uC55E\uC5D0\uC11C \uC870\uBB34\uB798\uAE30\uB97C \uC4F0\uB7EC\uB728\uB9B0\\n\uB108\uC758 \uC2E4\uB825\uC744 \uBCF4\uACE0\\r\\n\uC2A4\uD0C0\uB354\uC2A4\uD2B8 \uB300\uC791\uC804\uC744 \uB5A0\uC62C\uB9B4 \uC218 \uC788\uC5C8\uC5B4.[VAR 0114(0009)]",
  "LP\uB97C \uBD88\uB9AC\uB294 \uC77C \uB530\uC704\uB294\\n\uB098\uC758 \uD798\uB9CC \uC788\uC73C\uBA74 \uB204\uC6CC\uC11C \uB5A1 \uBA39\uAE30\uB2C8\uAE4C\\r\\n\uBCF4\uC218\uAC00 \uC788\uC73C\uBA74 \uB3C4\uC640\uC904 \uAC70\uB77C \uC0DD\uAC01\uD588\uC9C0.[VAR 0114(0009)]",
  "\uC791\uC804\uC774 \uC2DC\uC791\uB41C \uB4A4\uB85C\uB294 \uBCF4\uAE09\uBC18\uC774\uB77C\uB294 \uD551\uACC4\uB85C\\n\uACC4\uC18D\uD574\uC11C \uB3D9\uD5A5\uC744 \uC0B4\uD3C8\uACE0 \uB9D0\uC774\uC57C.[VAR 0114(0009)]",
  "\uC774\uC81C \uB098\uB97C \uC4F0\uB7EC\uB728\uB9AC\uAE30\uB9CC \uD558\uBA74\\n\uC2A4\uD0C0\uB2E8\uC740 \uC644\uBCBD\uD558\uAC8C \uB05D\uB0A0 \uAC70\uC57C.\\r\\n...\uADF8\uB7EC\uAE30 \uC704\uD574 \uB110 \uC5EC\uAE30\uAE4C\uC9C0 \uC624\uAC8C \uD55C \uAC70\uACE0.[VAR 0114(0009)]",
  "\uD558\uC9C0\uB9CC, \uC774\uB300\uB85C \uC2A4\uD0C0\uB2E8\uC744\\n\uB05D\uB0B4\uACE0 \uC2F6\uC9C0 \uC54A\uB2E4\uB294 \uB9C8\uC74C \uC5ED\uC2DC \uB4E4\uC5B4!\\r\\n\uADF8\uB7EC\uB2C8\uAE4C \uC190\uC27D\uAC8C \uB2F9\uD574 \uC8FC\uC9C0\uB294 \uC54A\uC744 \uAC70\uC57C![VAR 0114(0009)]",
  "...\uCD5C\uD6C4\uC758 \uC2B9\uBD80\uB97C \uD3BC\uCE60 \uC900\uBE44\uB294 \uB410\uC5B4?[VAR 0114(0009)]",
  "\uC900\uBE44\uB410\uC5B4",
  "\uC7A0\uAE50\uB9CC",
  "...\uC54C\uC558\uC5B4.\\n\uC900\uBE44\uAC00 \uB418\uBA74 \uB2E4\uC2DC \uC624\uB3C4\uB85D \uD574.[VAR 0114(0009)]",
  "...\uACE0\uB9C8\uC6CC.[VAR 0114(0009)]",
  "\uBBF8\uC548, \uAE30\uB2E4\uB9AC\uAC8C \uD588\uAD70.\\c\\n\uD0C0\uC784 \uC120\uC0DD\uB2D8\uC5D0\uAC8C \uBC18\uC131\uBB38\uC744...\\n\uC544\uB2C8, \uC900\uBE44\uAC00 \uC880 \uD544\uC694\uD574\uC11C \uB9D0\uC774\uC57C.[VAR 0114(001E)]",
  "\uADF8 \uBAA9\uC18C\uB9AC\uB294... \uB124\uB974\uCF00?[VAR 0114(0009)]",
  "\uBAA8\uB77C... \uC5ED\uC2DC...\\n\uC544\uB2C8, \uB124\uAC00...\\r\\n\uCE74\uC2DC\uC624\uD398\uC544\uC600\uB358 \uAC74\uAC00.[VAR 0114(001E)]",
  "\uADF8\uB798, \uB9DE\uC544.\\n\uB108\uC5D0\uAC8C\uB3C4 \uBD80\uD0C1\uD560 \uAC8C \uD558\uB098 \uC788\uC5B4.[VAR 0114(0009)]",
  "\uC9C0\uAE08\uBD80\uD130 \uC77C\uC5B4\uB098\uB294 \uC77C\uC744\\n\uB3D9\uC601\uC0C1\uC73C\uB85C \uCD2C\uC601\uD574 \uC92C\uC73C\uBA74 \uD574.\\r\\n\uACB0\uACFC\uB97C \uBAA8\uB4E0 \uB2E8\uC6D0\uB4E4\uC5D0\uAC8C \uBCF4\uB0B4\uC57C \uD558\uB2C8\uAE4C.[VAR 0114(0009)]",
  "\uADF8\uB798... \uC54C\uC558\uC5B4.[VAR 0114(001E)]",
  "...\uADF8\uB7FC \uB2E4\uC2DC\\n\uB0B4 \uC18C\uAC1C\uB97C \uD560\uAC8C.[VAR 0114(0009)]",
  "\uB0B4\uAC00 \uBC14\uB85C \uC2A4\uD0C0\uB2E8\uC758 \uC9C4 \uBCF4\uC2A4,\\n\uCE74\uC2DC\uC624\uD398\uC544...[VAR 0114(0009)]",
  "...\uC544\uB2C8, \uBAA8\uB780![VAR 0114(0008)]",
  "...\uC9C4 \uBCF4\uC2A4\uC758 \uD798 \uC55E\uC5D0\\n\uBB34\uB98E \uAFC7\uAC8C \uB9CC\uB4E4\uC5B4 \uC8FC\uACA0\uC5B4!![VAR 0114(0008)]"
]
