  "\uC790, \uC790, \uCB49\uCB49 \uB4E4\uC5B4\uC624\uC138\uC694.[VAR 0114(0045)]",
  "\uC544, \uC2E0\uBC1C\uC740 \uBC97\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uB429\uB2C8\uB2E4.\\n\uC9C4\uD759\uC774 \uB9CE\uC774 \uBB3B\uC73C\uC2E0 \uBD84\uC740\\r\\n\uC785\uAD6C\uC5D0 \uC788\uB294 \uC218\uB3D7\uAC00\uC5D0\uC11C \uB2E6\uC544 \uC8FC\uC2DC\uAD6C\uC694.[VAR 0114(0045)]",
  "\uC778\uD14C\uB9AC\uC5B4\uAC00 \uCC38 \uAE54\uB054\uD558\uC9C0 \uC54A\uB098\uC694?\\n\uC0C8\uB85C \uC9C0\uC740 \uC2DC\uC124\uC774\uB77C\\r\\n\uB3C4\uC2DC\uC5D0 \uB4A4\uC9C0\uC9C0 \uC54A\uB294 \uC124\uBE44\uB85C \uAC16\uCDB0 \uB1A8\uAC70\uB4E0\uC694![VAR 0114(0045)]",
  "\uC5EC\uAE30\uB294 \uC790\uC720 \uACF5\uAC04\uC785\uB2C8\uB2E4.\\nTV\uB97C \uBCF4\uC154\uB3C4 \uB418\uACE0, \uC7A1\uB2F4\uC744 \uB098\uB204\uC154\uB3C4 \uB418\uACE0,\\r\\n\uC790\uC720\uB86D\uAC8C \uC0AC\uC6A9\uD574 \uC8FC\uC138\uC694.[VAR 0114(0045)]",
  "\uC5D0~ \uC2DD\uB2F9\uC740 \uC800\uAE30\uACE0,\\n\uD654\uC7A5\uC2E4\uC740 \uC774\uCABD...[VAR 0114(0045)]",
  "\uD734\uC2DD\uC774 \uD544\uC694\uD560 \uB54C\uB294\\n\uC548\uCABD\uC5D0 \uC788\uB294 \uBC29\uC744 \uC0AC\uC6A9\uD574 \uC8FC\uC138\uC694.[VAR 0114(0045)]",
  "\uAC1C\uC778\uC2E4\uC740 \uC778\uC6D0\uC218\uC5D0 \uB9DE\uAC8C \uC788\uC73C\uB2C8\uAE4C\\n\uAC71\uC815\uD558\uC9C0 \uB9C8\uC2DC\uAD6C\uC694.[VAR 0114(0045)]",
  "\uC790, \uC124\uBA85\uC740 \uC774 \uC815\uB3C4\uBA74 \uB410\uACA0\uC9C0\uC694...?[VAR 0114(0045)]",
