[
  "\uD504\uB9AC\uC9C0\uB9C8\uC744\uC740\\n\uB208\uACFC \uC9C4\uD63C\uC758 \uB9C8\uC744!\\r\\n\uC694\uC998\uC740 \uB77C\uC774\uBE0C \uD68C\uC7A5\uC73C\uB85C\uB3C4 \uC720\uBA85\uD574.",
  "\uB208\uC740 \uD558\uB298\uD558\uB298!\\n\uCD1B\uBD88\uC740 \uD754\uB4E4\uD754\uB4E4!\\c\\n\uB9E4\uC77C\uB9E4\uC77C\uC774 \uCD95\uC81C \uAC19\uC9C0!",
  "\uC694\uC998 \uD2B8\uB80C\uB4DC\uB294 \uC124\uC0B0 \uD65C\uAC15\uD558\uAE30\uC57C!\\n\uB098\uD398\uC0B0\uC5D0\uC11C \uB3C4\uC804\uD560 \uC218 \uC788\uC5B4!",
  "\uB208\uAF2C\uB9C8 \uADC0\uC5FD\uC9C0?\\n\uC554\uCEF7\uC5D0\uAC8C\uB9CC \uB208\uC5EC\uC544\uB85C\\r\\n\uC9C4\uD654\uD560 \uC218 \uC788\uB294 \uAC00\uB2A5\uC131\uC774 \uC788\uC5B4.",
  "\uC624\uB298\uB3C4 \uC11C\uB298\uD558\uB124...\\n\uB9E4\uC6B4 \uAC78 \uBA39\uACE0 \uBAB8\uC744 \uB530\uB73B\uD558\uAC8C \uD574\uC57C\uC9C0!",
  "\uAD81\uADF9\uC758 \uC0CC\uB4DC\uC704\uCE58\uAC00 \uBB54\uC9C0 \uC544\uB2C8?\\n\uC774\uB984\uC5D0 \u201C\uB9C8\uC2A4\uD130\u201D\uAC00 \uB4E4\uC5B4\uAC04 \uAC74\uB370,\\r\\n\uB808\uC2DC\uD53C\uC5D0 \uB300\uD574\uC11C\uB294 \uC54C\uB824\uC9C4 \uAC8C \uC804\uD600 \uC5C6\uC5B4.",
  "\uBC16\uC5D0\uC11C \uBA39\uC73C\uB2C8\uAE4C\\n\uD3C9\uC18C\uBCF4\uB2E4 \uD6E8\uC52C \uB9DB\uC788\uB2E4~!",
  "1\uB144 \uBC18 \uC804\uC5D0\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uD0C0\uC784 \uB2D8\uC774 \uC740\uD1F4\uD558\uC2E0 \uB4A4\uB85C,\\r\\n\uB3D9\uC0DD\uC778 \uB77C\uC784 \uB2D8\uC774 \uC790\uB9AC\uB97C \uC774\uC5B4\uBC1B\uC558\uC5B4.",
  "\uB77C\uC784 \uB2D8\uC758 \uB77C\uC774\uBE0C \uBCF8 \uC801 \uC788\uC5B4?\\n\uC601\uD63C\uC774 \uB9C9 \uC804\uC728\uD558\uB294 \uB290\uB08C\uC774\uC57C!",
  "\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C \uC9C4\uD589\uD560 \uB550\\n\uBCF4\uB78F\uBE5B \uBB34\uB300\uAC00 \uBE5B\uB098\uC11C \uC815\uB9D0 \uC544\uB984\uB2E4\uC6CC~!"
