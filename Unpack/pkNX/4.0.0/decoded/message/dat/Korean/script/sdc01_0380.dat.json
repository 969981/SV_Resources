[
  "\uAE30\uB85C\uCE58 \uB2D8\uC740\\n\uC9C4\uC9DC \uD558\uB298\uC744 \uB0A0 \uC218 \uC788\uAD6C\uB098!\\r\\n\uB3C4\uAE68\uBE44\uC0B0\uC73C\uB85C \uC29D~ \uD558\uACE0 \uB0A0\uC544\uAC00\uC168\uC5B4!",
  "\uC138\uBC97 \uC870\uD0C0\uAD6C \uB2D8!\\n\uBCF4\uB77C\uC0C9 \uBA38\uD50C\uB7EC\uAC00 \uC9C4\uC9DC \uBA4B\uC9C0\uB354\uB77C!\\r\\n\uD669\uBB34\uC9C0\uC5D0\uC11C \uC0B0\uCC45\uD558\uC2DC\uB294 \uAC78 \uBD24\uC5B4!",
  "\uC0AC\uB78C\uC774 \uC4F0\uB7EC\uC838 \uC788\uB294 \uC904 \uC54C\uC558\uB294\uB370\\n\uC774\uC57C\uD6C4 \uB2D8\uC774 \uB0AE\uC7A0\uC744 \uC8FC\uBB34\uC2DC\uB294 \uC911\uC774\uB354\uAD6C\uB098!\\c\\n\uD558\uAE34, \uC5F0\uBABB \uC8FC\uBCC0\uC774\\n\uC7A0\uC790\uAE30\uC5D0 \uC81C\uACA9\uC774\uAE34 \uD558\uC9C0.",
  "\uC138\uBC97\uB4E4\uC5D0 \uAD00\uD55C\\n\uCCAB \uBC88\uC9F8 \uC815\uBCF4\uB97C \uC190\uC5D0 \uB123\uC5C8\uB2E4!",
  "\uC138\uBC97\uB4E4\uC5D0 \uAD00\uD55C\\n\uB450 \uBC88\uC9F8 \uC815\uBCF4\uB97C \uC190\uC5D0 \uB123\uC5C8\uB2E4!",
  "\uC138\uBC97\uB4E4\uC758 \uC815\uBCF4\uAC00\\n\uC5B4\uB290 \uC815\uB3C4 \uBAA8\uC600\uB2E4!\\r\\n\uC77C\uD589\uACFC \uD569\uB958\uD558\uC790!",
  "\uC138\uBC97\uB4E4\uC758 \uBAA9\uACA9 \uC815\uBCF4\uB97C\\n\uB2E5\uCE58\uB294 \uB300\uB85C \uBAA8\uC544 \uBCF4\uC790!\\r\\n\uB05D\uB098\uBA74 \uC5EC\uAE30\uB85C \uD569\uB958\uD574 \uC918![VAR 0114(0044)]",
  "\uC6B0\uB9AC \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC778\uB370\uB3C4\\n\uB9D0\uC744 \uAC78\uB824\uB2C8\uAE4C \uB108\uBB34 \uBD80\uB044\uB7EC\uC6CC...[VAR 0114(0043)]"
