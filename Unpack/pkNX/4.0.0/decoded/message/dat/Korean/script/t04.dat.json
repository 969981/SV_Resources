[
  "\uC5EC\uAE30\uB294 \uBCF4\uC6B8\uB9C8\uC744!\\n\uAF43\uACFC \uC608\uC220\uC758 \uB9C8\uC744\uC774\uC57C!",
  "\uD574\uB8E8\uBBF8\uC758 \uACE0\uB1CC\uD558\uB294 \uD45C\uC815!\\n\uC791\uAC00\uB294 \uBB34\uC2A8 \uC0DD\uAC01\uC73C\uB85C \uC774\uAC78 \uB9CC\uB4E0 \uAC78\uAE4C?",
  "\uC774\uC0C1\uD55C \uC804\uC2DC\uBB3C \uC55E\uC5D0\uC11C\\n\uC5EC\uC790 \uCE5C\uAD6C\uC640 \uB9CC\uB098\uAE30\uB85C \uD588\uC5B4!\\r\\n\uADFC\uB370 \uC880\uCC98\uB7FC \uC624\uC9C8 \uC54A\uB124!",
  "\uC774\uC0C1\uD55C \uC804\uC2DC\uBB3C \uC55E\uC5D0\uC11C\\n\uB0A8\uC790 \uCE5C\uAD6C\uC640 \uB9CC\uB098\uAE30\uB85C \uD588\uB294\uB370...\\r\\n\uC774 \uB9C8\uC744, \uC774\uC0C1\uD55C \uC804\uC2DC\uBB3C\uC774 \uB108\uBB34 \uB9CE\uC544!",
  "\uBCF4\uC6B8\uB9C8\uC744\uC758 \uBA85\uBB3C, \uBBF8\uAD81 \uC560\uC2AC\uB808\uD2F1!\\n\uD55C\uBC88 \uB3C4\uC804\uD574 \uBD10!",
  "\uBD04\uC774 \uB418\uBA74 \uBC14\uB78C\uC744 \uD0C0\uACE0\\n\uD574\uB108\uCE20\uAC00 \uB0A0\uC544\uC640.",
  "\uC774\uC57C~ \uCF58\uC149\uD2B8 \uD558\uBA70,\\n\uCF58\uD2B8\uB77C\uC2A4\uD2B8 \uD558\uBA70, \uC545\uC13C\uD2B8\uAE4C\uC9C0...\\r\\n\uC804\uBB38\uAC00\uAC00 \uC544\uB2C8\uBA74 \uC774\uD574 \uBABB \uD560 \uAC70\uC57C~",
  "\uC720\uBA85\uD55C \uC791\uD488\uC744 \uBCF4\uB7EC \uC654\uC5B4!\\n\uBB50\uAC00 \uBB54\uC9C0 \uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC \uB9D0\uC774\uC57C!",
  "\uB610 \uB9C9\uB2E4\uB978 \uAE38...\\n\uC73C\uC559~ \uAE38\uC744 \uC783\uC5B4\uBC84\uB838\uC5B4~",
  "\uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB2E4\uB2C8\\n\uC2E4\uB825\uC774 \uC81C\uBC95\uC778\uB370!\\c\\n\uB204\uAD6C\uB3C4 \uC624\uB294 \uAC78 \uBCF8 \uC801\uC774 \uC5C6\uC5B4\uC11C\\n\uBE44\uBC00\uAE30\uC9C0\uB85C \uC4F0\uACE0 \uC788\uC5B4!",
  "\uC9C0\uCCE4\uC744 \uB550\\n\uC7A0\uC2DC \uBA48\uCDB0\uC11C \uBCF4\uB824\uBB34\uB098...\\r\\n\uBA48\uCDB0 \uC11C\uC57C \uBCFC \uC218 \uC788\uB294 \uAC83\uB3C4 \uC788\uB294 \uBC95\uC774\uB780\uB2E4.",
  "\uD574\uB108\uCE20\uAC00 \uC9C4\uD654\uD558\uBA74 \uD574\uB8E8\uBBF8\uAC00 \uB41C\uB2E4\uB2C8\\n\uBBFF\uAE30\uC9C0\uAC00 \uC54A\uC544!\\r\\n\uC9C4\uD654\uB294 \uC9C4\uC9DC \uC2E0\uAE30\uD558\uB2E4\uB2C8\uAE4C!",
  "\uB0B4 \uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC \uBA4B\uC9C0\uC9C0~!?\\c\\n\uC774 \uC544\uC774\uC640 \uD568\uAED8\\n\uC5EC\uAE30\uC800\uAE30 \uC5EC\uD589\uD560 \uAC70\uC57C!",
  "\uC774\uAC83\uC774 \uCF5C\uC0AC \uC120\uC0DD\uB2D8\uC758 \uC791\uD488!?\\n\uC0B4\uC9DD \uC791\uD48D\uC774 \uB2E4\uB978 \uAC83 \uAC19\uC740\uB370...",
  "\uB192\uC740 \uACF3\uC740 \uCD5C\uACE0\uC57C~!\\c\\n\uB9C8\uC744 \uBC16\uC5D0\uB294 \uB9DD\uB8E8\uB77C\uACE0 \uD558\uB294\\n\uB192\uC740 \uD0D1 \uAC19\uC740 \uAC8C \uC788\uB300!"
]
