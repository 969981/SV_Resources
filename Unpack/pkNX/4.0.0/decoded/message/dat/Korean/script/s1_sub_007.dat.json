[
  "\uC624~\uD638\uD638\uD638!\\n\uC624~\uD638\uD638\uD638![VAR 0114(0041)]",
  "\uBD10 \uBD10, \uBE4C\uB9AC\uC624!\\n\uBB3C\uC6C5\uB369\uC774\uAC00 \uC788\uC5B4![VAR 0114(0041)]",
  "\uC624~ \uB098\uC758 \uB098\uB9AC\uC544, \uC774\uAC74 \uD638\uC218\uB77C\uAD6C!\\n\uD314\uB370\uC544\uC5D0\uC11C \uAC00\uC7A5 \uD070!\\r\\n\uADF8 \uC774\uB984\uB3C4 \uC720\uBA85\uD55C \uC624\uC57C \uD638\uC218\uC9C0![VAR 0114(0040)]",
  "\uC774, \uC774\uAC8C \uD638\uC218!?\\n\uBC31\uBC88 \uC591\uBCF4\uD574\uB3C4 \uC5F0\uBABB \uC815\uB3C4\uC778 \uAC83 \uAC19\uC740\uB370!?[VAR 0114(0041)]",
  "\uADFC\uB370, \uBE4C\uB9AC\uC624...\\n\uC5F0\uBABB\uACFC \uD638\uC218\uB294 \uBB50\uAC00 \uB2E4\uB978 \uAC70\uC57C?[VAR 0114(0041)]",
  "\uADF8\uAC74 \uB098\uB3C4 \uC798 \uBAA8\uB974\uACA0\uC5B4, \uB098\uB9AC\uC544...\\n\uC6B0\uB9AC \uC140\uB7FD\uB4E4\uC758 \uAC00\uCE58\uAD00\uC774 \uC6CC\uB099,\\r\\n\uC77C\uBC18 \uC11C\uBBFC\uB4E4\uACFC\uB294 \uB9CE\uC774 \uB2EC\uB77C\uC11C \uB9D0\uC774\uC57C...[VAR 0114(0040)]",
  "\uC5B4\uBA38, \uB2F9\uC2E0\uC740...\\n\uC5EC\uB290 \uB54C\uC640 \uAC19\uC740 \uADF8 \uC11C\uBBFC\uB2D8![VAR 0114(0041)]",
  "\uC815\uB9D0\uC774\uAD70!\\n\uD2C0\uB9BC\uC5C6\uC774 \uC5EC\uB290 \uB54C\uC640 \uAC19\uC740 \uADF8 \uC11C\uBBFC\uC774\uC57C![VAR 0114(0040)]",
  "\uB9C8\uCE68 \uC798 \uC624\uC168\uC5B4\uC694, \uC11C\uBBFC\uB2D8...\\n\uD639\uC2DC \uC5F0\uBABB\uACFC \uD638\uC218\uC758 \uCC28\uC774\uB97C \uC544\uC2DC\uB098\uC694?[VAR 0114(0041)]",
  "\uD06C\uAE30 \uC544\uB2D0\uAE4C\uC694?",
  "\uAE4A\uC774 \uC544\uB2D0\uAE4C\uC694?",
  "\uADF8\uB807\uAD70\uC694! \uC5ED\uC2DC \uC11C\uBBFC\uB2D8\uC774\uB77C\uC11C \uADF8\uB7F0\uC9C0\\n\uC77C\uBC18 \uC0C1\uC2DD\uC5D0 \uD574\uBC15\uD558\uC2DC\uB124\uC694![VAR 0114(0041)]",
  "\uBC1B\uC740 \uAC83\uC774 \uC788\uB2E4\uBA74 \uADF8\uB9CC\uD07C \uB3CC\uB824\uC8FC\uB294 \uAC83\uC774\\n\uC6B0\uB9AC \uC140\uB7FD\uB4E4\uC758 \uC758\uBB34...[VAR 0114(0041)]",
  "\uADF8\uB7EC\uB2C8 \uC774\uAC83\uC744 \uB4DC\uB9AC\uACA0\uC5B4\uC694.[VAR 0114(0041)]",
  "\uC798 \uB4E4\uC73C\uC138\uC694, \uC11C\uBBFC\uB2D8.\\n\uD589\uBCF5\uC774\uB780 \uC774 \uBB3C\uAC00\uC640\uB3C4 \uAC19\uC740 \uAC83...[VAR 0114(0041)]",
  "\uC0DD\uAC01\uD558\uAE30\uC5D0 \uB530\uB77C \uBB3C\uC6C5\uB369\uC774\uB3C4\\n\uC5F0\uBABB\uB3C4 \uD638\uC218\uB3C4 \uB420 \uC218 \uC788\uB294 \uAC70\uC608\uC694.[VAR 0114(0041)]",
  "\uC624~ \uC5ED\uC2DC \uB098\uC758 \uB098\uB9AC\uC544!\\n\uBC29\uAE08 \uBC30\uC6B4 \uC9C0\uC2DD\uC744 \uACE7\uC7A5\\r\\n\uAC00\uB974\uCCD0 \uC900 \uC7A5\uBCF8\uC778\uC5D0\uAC8C \uD65C\uC6A9\uD558\uB2E4\uB2C8![VAR 0114(0040)]",
  "\uAC00\uC790, \uBE4C\uB9AC\uC624!\\n\uB098, \uC6B0\uB9AC \uD68C\uC0AC\uCC98\uB7FC\\r\\n[VAR FF00(0006)]\uD654\uC774\uD2B8\uD55C \uCEEC\uB7EC\uC758 \uC0B0[VAR FF00(0000)]\uC744 \uC624\uB974\uACE0 \uC2F6\uC5B4\uC84C\uC5B4![VAR 0114(0041)]",
  "\uC720\uD6C4~! \uD314\uB370\uC544 \uC5D0\uC2A4\uD14C\uC774\uD2B8\uAC00\\n\uC5EC\uB7EC\uBAA8\uB85C \uD654\uC774\uD2B8\uD55C \uAE30\uC5C5\uC774\uAE34 \uD558\uC9C0!\\r\\n\uC5ED\uC2DC \uC6B0\uB9AC \uB098\uB9AC\uC544\uB294 \uC140\uB7FD\uC758 \uADC0\uAC10\uC774\uB77C\uB2C8\uAE4C![VAR 0114(0040)]",
  "\uC124\uC0B0\uC5D0\uC11C \uC5BC\uC74C\uD3EC\uCF13\uBAAC\uC744 \uAD6C\uACBD\uD558\uBA74\uC11C\\n\uC824\uB77C\uD1A0\uB77C\uB3C4 \uBA39\uC790\uACE0![VAR 0114(0040)]",
  "\uB098\uB9AC\uC544 \uB2D8\uACFC \uBE4C\uB9AC\uC624 \uB2D8\uAED8\uC11C\uB294\\n\uD314\uB370\uC544\uC758 \uCEE4\uB2E4\uB780 \uBB3C\uAC00\uB97C \uBCF4\uB7EC \uAC00\uC168\uC2B5\uB2C8\uB2E4.",
  "\uCEE4\uB2E4\uB780 \uBB3C\uAC00\uAC00 \uC5B4\uB51C\uAE4C\uC694...\\n\uAC15? \uC5F0\uBABB?\\r\\n\uC5B4\uCA4C\uBA74 \uD638\uC218\uC77C\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB124\uC694."
]
