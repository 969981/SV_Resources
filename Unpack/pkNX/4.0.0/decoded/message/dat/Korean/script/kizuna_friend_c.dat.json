[
  "\uC624, \uCC54\uD53C\uC5B8!\\n\uACF5\uBD80\uD558\uB7EC \uC628 \uAC70\uC57C?[VAR 0114(0006)]",
  "\uADF8\uB7F0 \uC148\uC774\uC9C0?",
  "\uC9C0\uB098\uAC00\uB358 \uC911\uC774\uC57C",
  "\uC774\uBD10 \uC774\uBD10! \uC9C0\uAE08\uB3C4 \uCDA9\uBD84\uD788 \uB300\uB2E8\uD55C\uB370\\n\uBA38\uB9AC\uAE4C\uC9C0 \uB611\uB611\uD574\uC9C0\uBA74 \uB09C \uC5B4\uB5A1\uD558\uB77C\uACE0~[VAR 0114(0006)]",
  "\uC785\uAD6C \uACC4\uB2E8\uC5D0\uC11C\\n\uD558\uCCB4\uB77C\uB3C4 \uB2E8\uB828\uD558\uB824\uACE0?[VAR 0114(0006)]",
  "...\uC751?\\n\uC544, \uB098\uB294 \uADF8\uAC83 \uB54C\uBB38\uC5D0 \uC628 \uAC70\uC57C.\\r\\n\uB098\uB97C \uCC3E\uB294 \uBAA8\uD5D8 \uB9D0\uC774\uC57C.[VAR 0114(0006)]",
  "\uC785\uAD6C \uD640\uC5D0 \uC788\uB294 \uCC45\uC7A5\uC5D0\uC11C\\n\uC5C4\uB9C8\uC758 \uC5F0\uAD6C \uB9AC\uD3EC\uD2B8\uB97C \uB4A4\uC9C0\uB2E4\\r\\n\uC774\uB7F0 \uCC45\uC744 \uBC1C\uACAC\uD588\uAC70\uB4E0.[VAR 0114(0006)]",
  "\uC785\uAD6C \uD640\uC5D0 \uC788\uB294 \uCC45\uC7A5\uC5D0\uC11C\\n\uC544\uBE60\uC758 \uC5F0\uAD6C \uB9AC\uD3EC\uD2B8\uB97C \uB4A4\uC9C0\uB2E4\\r\\n\uC774\uB7F0 \uCC45\uC744 \uBC1C\uACAC\uD588\uAC70\uB4E0.[VAR 0114(0006)]",
  "\uB4F1\uB300 \uC5F0\uAD6C\uC18C\uC5D0\uB3C4 \uC788\uC5C8\uB358\\n\uC5C4\uB9C8\uC758 \uC18C\uC911\uD55C \uCC45...\\r\\n\uC2A4\uCE7C\uB81B\uBD81\uC774\uB77C\uACE0 \uD588\uB098?[VAR 0114(0006)]",
  "\uB4F1\uB300 \uC5F0\uAD6C\uC18C\uC5D0\uB3C4 \uC788\uC5C8\uB358\\n\uC544\uBE60\uC758 \uC18C\uC911\uD55C \uCC45...\\r\\n\uBC14\uC774\uC62C\uB81B\uBD81\uC774\uB77C\uACE0 \uD588\uB098?[VAR 0114(0006)]",
  "\uBE44\uC804\uC2A4\uD30C\uC774\uC2A4 \uB9D0\uACE0 \uB2E4\uB978 \uD398\uC774\uC9C0\uB97C\\n\uC81C\uB300\uB85C \uC77D\uB294 \uAC74 \uCC98\uC74C\uC778\uB370 \uAD49\uC7A5\uD55C \uAC70 \uC788\uC9C0![VAR 0114(0006)]",
  "\uC218\uC0C1\uCA4D\uAE34 \uD558\uC9C0\uB9CC \uC7AC\uBC0C\uB354\uB77C\uACE0!\\n\uC0BD\uD654\uB3C4 \uC788\uC5B4\uC11C \uC77D\uAE30 \uC27D\uACE0 \uB9D0\uC774\uC57C![VAR 0114(0006)]",
  "\uC774\uAC78 \uBD10 \uBD10![VAR 0114(0006)]",
  "\uC774 \uD398\uC774\uC9C0, \uBAA8\uB4E0 \uCC45\uC774 \uB2E4\\n\uAE00\uC528\uAC00 \uD750\uB9BF\uD574\uC11C \uC77D\uC744 \uC218\uAC00 \uC5C6\uC5B4.\\r\\n\uBB54\uAC00 \uC704\uD5D8\uD574 \uBCF4\uC774\uC9C0 \uC54A\uC544?[VAR 0114(0006)]",
  "\uC774 \uCC45, \uB9D0\uB3C4 \uC548 \uB418\uB294 \uC774\uC57C\uAE30\uB85C \uAC00\uB4DD\uD558\uC9C0\uB9CC\\n\uBE44\uC804\uC2A4\uD30C\uC774\uC2A4\uC5D0 \uB300\uD55C \uB0B4\uC6A9\uB3C4 \uC788\uC5C8\uACE0,\\c\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0\uC11C \uADF8\uB7F0 \uC77C\uC744 \uACAA\uACE0 \uB098\uB2C8\uAE4C\\n\uC804\uBD80 \uAC70\uC9D3\uB9D0\uC774\uB77C\uACE0 \uD558\uAE30\uB3C4 \uD798\uB4E0 \uAC83 \uAC19\uC544~[VAR 0114(0006)]",
  "\uC5B4\uCA4C\uBA74 \uC5C4\uB9C8\uB294 \uC774 \uCC45\uC744 \uC77D\uACE0\\n\uC5F0\uAD6C\uC790\uAC00 \uB418\uB824\uACE0 \uD558\uC9C0 \uC54A\uC558\uC744\uAE4C?[VAR 0114(0006)]",
  "\uC5B4\uCA4C\uBA74 \uC544\uBE60\uB294 \uC774 \uCC45\uC744 \uC77D\uACE0\\n\uC5F0\uAD6C\uC790\uAC00 \uB418\uB824\uACE0 \uD558\uC9C0 \uC54A\uC558\uC744\uAE4C?[VAR 0114(0006)]",
  "\uC5EC\uAE30\uC5D0 \uC4F0\uC778\\n\uACE0\uB300 \uD3EC\uCF13\uBAAC \uC774\uC57C\uAE30\uC5D0 \uB04C\uB824\uC11C\\r\\n\uC9C1\uC811 \uB9CC\uB098\uACE0 \uC2F6\uC5C8\uB358 \uAC78\uC9C0\uB3C4 \uBAB0\uB77C.[VAR 0114(0006)]",
  "\uC5EC\uAE30\uC5D0 \uC4F0\uC778\\n\uBBF8\uB798 \uD3EC\uCF13\uBAAC \uC774\uC57C\uAE30\uC5D0 \uB04C\uB824\uC11C\\r\\n\uC9C1\uC811 \uB9CC\uB098\uACE0 \uC2F6\uC5C8\uB358 \uAC78\uC9C0\uB3C4 \uBAB0\uB77C.[VAR 0114(0006)]",
  "\uC5B4\uB77C?\\n\uC5C4\uB9C8\uAC00 \uD0C0\uC784\uBA38\uC2E0\uC744 \uB9CC\uB4E4\uC5B4\uC11C\\r\\n\uACE0\uB300 \uD3EC\uCF13\uBAAC\uC774 \uB098\uD0C0\uB0AC\uB358 \uAC70 \uC544\uB2C8\uC5C8\uB098?[VAR 0114(0006)]",
  "\uC5B4\uB77C?\\n\uC544\uBE60\uAC00 \uD0C0\uC784\uBA38\uC2E0\uC744 \uB9CC\uB4E4\uC5B4\uC11C\\r\\n\uBBF8\uB798 \uD3EC\uCF13\uBAAC\uC774 \uB098\uD0C0\uB0AC\uB358 \uAC70 \uC544\uB2C8\uC5C8\uB098?[VAR 0114(0006)]",
  "\uD0C0\uC784\uBA38\uC2E0\uC774 \uB9CC\uB4E4\uC5B4\uC9C0\uAE30 \uC804\uC5D0 \uB098\uC628 \uCC45\uC5D0\\n\uACE0\uB300 \uD3EC\uCF13\uBAAC\uC5D0 \uAD00\uD55C \uC774\uC57C\uAE30\uAC00 \uC4F0\uC5EC \uC788\uB2E4\uB2C8,\\r\\n\uBB54\uAC00 \uC774\uC0C1\uD558\uC9C0 \uC54A\uC544...?[VAR 0114(0006)]",
  "\uD0C0\uC784\uBA38\uC2E0\uC774 \uB9CC\uB4E4\uC5B4\uC9C0\uAE30 \uC804\uC5D0 \uB098\uC628 \uCC45\uC5D0\\n\uBBF8\uB798 \uD3EC\uCF13\uBAAC\uC5D0 \uAD00\uD55C \uC774\uC57C\uAE30\uAC00 \uC4F0\uC5EC \uC788\uB2E4\uB2C8,\\r\\n\uBB54\uAC00 \uC774\uC0C1\uD558\uC9C0 \uC54A\uC544...?[VAR 0114(0006)]",
  "......[VAR 0114(0006)]",
  "\uBB50, \uADF8\uB7F0 \uBD80\uBD84\uC774\\n\uC774 \uCC45\uC758 \uC218\uC0C1\uD55C \uC810\uC774\uC9C0\uB9CC![VAR 0114(0006)]",
  "\uC5C9\uD130\uB9AC\uC5EC\uB3C4 \uBBFF\uC74C\uC744 \uAC16\uACE0 \uD604\uC2E4\uB85C \uB9CC\uB4E0\\n\uC6B0\uB9AC \uC5C4\uB9C8\uAC00 \uB300\uB2E8\uD55C \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD558\uC9C0 \uBB50![VAR 0114(0006)]",
  "\uC5C9\uD130\uB9AC\uC5EC\uB3C4 \uBBFF\uC74C\uC744 \uAC16\uACE0 \uD604\uC2E4\uB85C \uB9CC\uB4E0\\n\uC6B0\uB9AC \uC544\uBE60\uAC00 \uB300\uB2E8\uD55C \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD558\uC9C0 \uBB50![VAR 0114(0006)]",
  "\uADF8\uB7F0 \uC810\uC740 \uB098\uB3C4 \uBCF8\uBC1B\uC544\uC11C\\n\uC55E\uC73C\uB85C \uB354 \uB178\uB825\uD558\uACA0\uC5B4![VAR 0114(0006)]",
  "\uADF8\uB7FC \uB098\uB294 \uD560 \uC77C\uC774 \uC788\uC5B4\uC11C\\n\uBA3C\uC800 \uAC00 \uBCFC\uAC8C![VAR 0114(0006)]"
]
