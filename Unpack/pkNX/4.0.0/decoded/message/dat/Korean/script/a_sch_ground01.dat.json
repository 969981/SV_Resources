[
  "\uC6B4\uB3D9\uC7A5\uC740 \uB113\uC5B4\uC11C\\n\uCEE4\uB2E4\uB780 \uD3EC\uCF13\uBAAC\uC744 \uAEBC\uB0B4\uB3C4 \uAD1C\uCC2E\uC544!",
  "\uAC38\uB77C\uB3C4\uC2A4\uC758 \uC5BC\uAD74\uC740 \uC704\uD611\uC801\uC774\uB77C\\n\uBCF4\uACE0 \uC788\uC73C\uBA74 \uACF5\uACA9\uC774 \uB5A8\uC5B4\uC9C8 \uAC83\uB9CC \uAC19\uC544!",
  "\uD2B8\uB85C\uD53C\uC6B0\uC2A4\uB294 \uACFC\uC77C\uC744 \uB108\uBB34 \uC88B\uC544\uD574\uC11C\\n\uBAA9\uC5D0\uC11C \uACFC\uC77C\uC774 \uC790\uB784 \uC815\uB3C4\uB798!\\r\\n...\uC774\uAC8C \uB9D0\uC774 \uB3FC!?",
  "\uC2DD\uB2F9 \uC694\uB9AC\uB294 \uC774 \uBC2D\uC5D0\uC11C \uC790\uB780\\n\uC2DD\uC7AC\uB8CC\uB85C \uB9CC\uB4E4\uACE0 \uC788\uC5B4.",
  "\uB2E4\uC74C\uC5D0\uB294 \uC5B4\uB5A4 \uAC78 \uD0A4\uC6B8\uAE4C?\\n\uC791\uBB3C\uC774\uB4E0 \uD3EC\uCF13\uBAAC\uC774\uB4E0\\r\\n\uACE0\uBBFC\uB418\uB294 \uAC74 \uB9C8\uCC2C\uAC00\uC9C0\uB124.",
  "\uBAA8\uD1A0\uB9C8\uB294 \uBC18\uC9C0\uB974\uB974 \uC724\uC774 \uB098\uACE0 \uADC0\uC5FD\uC9C0!\\n\uACF5\uBD80\uB85C \uC313\uC778 \uD53C\uB85C\uAC00 \uC2F9 \uAC00\uC2DC\uB294 \uAC83 \uAC19\uC544~",
  "\uBAA8\uD1A0\uB9C8 \uD14C\uB77C\uD53C\uC785\uB2C8\uB2E4~!\\n\uC6D0\uD558\uB294 \uB9CC\uD07C \uBCF4\uACE0 \uAC00\uC138\uC694~",
  "\uBA38\uB4DC\uB098\uAE30\uB791 \uAC19\uC774 \uB9C8\uB77C\uD1A4\uC744 \uD588\uC5B4!\\n\uC9C0\uAD6C\uB825\uC774 \uC7A5\uB09C \uC544\uB2C8\uB354\uB77C!",
  "\uC9C0\uAE08\uBD80\uD130 \uCE5C\uAD6C\uB791\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD560 \uAC70\uC57C!",
  "\uCE5C\uAD6C\uB07C\uB9AC \uBC30\uD2C0\uD558\uBA74 \uC11C\uB85C\uC758 \uC2E4\uB825\uC744 \uB2E4 \uC54C\uC544\uC11C\\n\uC218 \uC2F8\uC6C0\uC774 \uC911\uC694\uD574\uC838.",
  "\uC7A0\uC774 \uC624\uC9C0 \uC54A\uC544\uC11C\\n\uAD50\uB0B4\uB97C \uC0B0\uCC45\uD558\uACE0 \uC788\uC5B4.",
  "\uC800\uBC88\uC5D0 \uB124\uBAA8\uAC00 \uC6B4\uB3D9\uC7A5\uC5D0\uC11C\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C 30\uC5F0\uC2B9\uD558\uB294 \uAC78 \uBD24\uC5B4!\\r\\n\uC5ED\uC2DC \uCC54\uD53C\uC5B8 \uB7AD\uD06C\uB77C\uB2C8\uAE4C!",
  "\uB124\uBAA8\uB294 \uD559\uC0DD\uD68C\uC7A5\uC774\uBA74\uC11C\\n\uCC54\uD53C\uC5B8\uC5D0 \uC131\uC801\uAE4C\uC9C0 \uC6B0\uC218\uD558\uB300!\\r\\n\uBABB\uD558\uB294 \uAC8C \uC788\uAE34 \uD55C \uAC78\uAE4C?",
  "\uCCB4\uC721\uAD00\uC5D0\uC11C \uAE34\uC7A5\uD558\uC9C0 \uC54A\uC73C\uB824\uACE0\\n\uBC30\uD2C0\uCF54\uD2B8\uB97C \uBCF4\uBA70 \uC774\uBBF8\uC9C0 \uD2B8\uB808\uC774\uB2DD \uC911\uC774\uC57C!",
  "\uC789\uC5B4\uD0B9\uC5D0\uC11C \uAC38\uB77C\uB3C4\uC2A4\uB85C \uC9C4\uD654\uC2DC\uD0A4\uB290\uB77C\\n\uC815\uB9D0 \uD798\uB4E4\uC5C8\uC5B4!",
  "\uC790\uBA74\uC11C\uB3C4 \uC6C3\uB294 \uD32C\uD140...\\n\uC815\uB9D0 \uC0AC\uB791\uC2A4\uB7FD\uB2E8 \uB9D0\uC774\uC9C0.",
  "\uAC00\uB054 \uAD50\uC7A5\uC2E4\uC5D0\uC11C \uC774\uC0C1\uD55C \uD5E4\uC5B4\uC2A4\uD0C0\uC77C\uC744 \uD55C\\n\uD559\uC0DD\uC774 \uB098\uC624\uB294 \uAC78 \uBD24\uC5B4."
]
