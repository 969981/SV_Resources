[
  "\uC548\uB155~\\n\uB2E4\uB4E4 \uC911\uAC04\uACE0\uC0AC \uBCF4\uB290\uB77C \uC218\uACE0\uD588\uC5B4.[VAR 0114(0025)]",
  "\uB9CC\uC810\uC778 \uC0AC\uB78C\uB3C4 \uC788\uC5C8\uACE0, \uC544\uC2AC\uC544\uC2AC\uD558\uAC8C \uD1B5\uACFC\uD55C\\n\uC0AC\uB78C\uB3C4 \uC788\uC5C8\uACE0, \uB2E4\uB4E4 \uB178\uB825\uD588\uB098 \uBCF4\uAD6C\uB098.[VAR 0114(0025)]",
  "\uB108\uD76C \uBC18 \uBAA8\uB450\uAC00 \uD569\uACA9\uD574\uC11C\\n\uC120\uC0DD\uB2D8\uC740 \uC815\uB9D0 \uAE30\uC058\uB2E8\uB2E4![VAR 0114(0025)]",
  "\uADF8\uB9CC\uD07C \uB108\uD76C\uAC00 \uC218\uD559\uC744\\n\uC88B\uC544\uD558\uAC8C \uB410\uB2E4\uB294 \uB73B\uC774\uB2C8\uAE4C \uB9D0\uC774\uC57C.[VAR 0114(0025)]",
  "\uB0A8\uC740 \uC218\uC5C5\uB3C4 \uB2E4 \uAC19\uC774 \uD798\uB0B4\uC11C\\n\uC218\uD559 \uC2E4\uB825\uC744 \uD06C\uAC8C \uC131\uC7A5\uC2DC\uCF1C \uBCF4\uC790~![VAR 0114(0025)]",
  "\u201C\uD06C\uAC8C\u201D \uD558\uBA74 \uBB54\uAC00 \uC0DD\uAC01\uB098\uB294 \uAC83 \uC5C6\uB2C8?\\n...\uB9DE\uC544!\\r\\n\uC624\uB298\uC740 \uD3EC\uCF13\uBAAC\uC758 \uB2A5\uB825 \uC0C1\uC2B9\uC744 \uC54C\uC544\uBCFC \uAC70\uC57C.[VAR 0114(0025)]",
  "\uBC30\uD2C0 \uC911\uC5D0 \uD3EC\uCF13\uBAAC\uC758 \uB2A5\uB825\uC774 \uC624\uB974\uAC70\uB098\\n\uB5A8\uC5B4\uC9C8 \uB54C\uAC00 \uC788\uC9C0?[VAR 0114(0025)]",
  "\uC608\uB97C \uB4E4\uC5B4, \uD3EC\uCF13\uBAAC\uC774\\n\uBD84\uBC1C\uC774\uB77C\uB294 \uAE30\uC220\uC744 \uC0AC\uC6A9\uD558\uBA74\\r\\n\uACF5\uACA9\uACFC \uD2B9\uC218\uACF5\uACA9\uC774 1\uB2E8\uACC4 \uC624\uB974\uAC8C \uB3FC.[VAR 0114(0025)]",
  "\uACF5\uACA9\uC774\uB098 \uD2B9\uC218\uACF5\uACA9\uC758 \uB7AD\uD06C\uAC00\\n1\uB2E8\uACC4 \uC624\uB97C \uB54C\uB9C8\uB2E4\\r\\n\uB370\uBBF8\uC9C0\uB294 50%\uC529 \uC99D\uAC00\uD558\uC9C0?[VAR 0114(0025)]",
  "\uC5EC\uAE30\uC11C \uD55C \uBC88 \uB354 \uBD84\uBC1C\uC744 \uC0AC\uC6A9\uD558\uBA74\\n2\uB2E8\uACC4 \uC624\uB978 \uAC83\uC774 \uB418\uB2C8\uAE4C\\r\\n\uC6D0\uB798 \uB370\uBBF8\uC9C0\uC5D0\uC11C 100% \uC99D\uAC00, \uB2E4\uC2DC \uB9D0\uD574\\r\\n\uD55C \uBC88\uC5D0 \uB450 \uBC88 \uACF5\uACA9\uD55C \uC148\uC774 \uB418\uB294 \uAC70\uC9C0.[VAR 0114(0025)]",
  "\uD2B9\uD788, \uCE7C\uCDA4\uC774\uB77C\uB294 \uAE30\uC220\uC740\\n\uACF5\uACA9 \uB7AD\uD06C\uB97C 2\uB2E8\uACC4 \uC62C\uB824\uC11C\\r\\n\uD55C \uBC88\uB9CC \uC0AC\uC6A9\uD574\uB3C4 \uB370\uBBF8\uC9C0\uAC00 2\uBC30\uAC00 \uB41C\uB2E8\uB2E4![VAR 0114(0025)]",
  "\uC5EC\uAE30\uC11C \uBB38\uC81C. \uCE7C\uCDA4\uC744 \uB450 \uBC88 \uC0AC\uC6A9\uD558\uBA74\\n\uACF5\uACA9 \uB7AD\uD06C\uAC00 4\uB2E8\uACC4 \uC624\uB978 \uAC83\uC774 \uB418\uB294\uB370,\\r\\n\uADF8\uB807\uB2E4\uBA74 \uAE30\uC220\uC758 \uB370\uBBF8\uC9C0\uB294 \uC6D0\uB798\uC758 \uBA87 \uBC30\uC9C0?[VAR 0114(0025)]",
  "2\uBC30",
  "3\uBC30",
  "4\uBC30",
  "\uC5ED\uC2DC \uD5F7\uAC08\uB9AC\uAE30 \uC26C\uC6B4 \uBB38\uC81C\uC600\uB098?\\n\uBD84\uBC1C\uC774\uC5C8\uC73C\uBA74 2\uBC30\uAC00 \uB418\uB294 \uAC8C\\r\\n\uC815\uB2F5\uC774\uC5C8\uC744 \uD150\uB370 \uB9D0\uC774\uC9C0...[VAR 0114(0025)]",
  "\uC5B4\uB824\uC6E0\uC744 \uD150\uB370 \uAD49\uC7A5\uD55C\uAC78!\\n\uC5ED\uC2DC [VAR 0100(0000)][VAR 1900(0006)]\uC57C![VAR 0114(0025)]",
  "\uC5ED\uC2DC \uD5F7\uAC08\uB9AC\uAE30 \uC26C\uC6B4 \uBB38\uC81C\uC600\uB098?\\n4\uB2E8\uACC4\uB77C\uACE0 \uD558\uBA74\uC11C\\r\\n4\uBC30\uAC00 \uC544\uB2C8\uB77C\uB294 \uAC8C \uD568\uC815\uC774\uC5C8\uB294\uB370 \uB9D0\uC774\uC57C.[VAR 0114(0025)]",
  "\uB7AD\uD06C\uAC00 1\uB2E8\uACC4 \uC624\uB97C \uB54C\uB9C8\uB2E4\\n\uB370\uBBF8\uC9C0\uAC00 50%\uC529 \uC99D\uAC00\uD55C\uB2E4\uACE0 \uD588\uC9C0?[VAR 0114(0025)]",
  "\uADF8\uB7EC\uB2C8\uAE4C 4\uB2E8\uACC4\uAC00 \uC624\uB974\uBA74 4\u00D750%\uD574\uC11C\\n200%\uAC00 \uC99D\uAC00\uD55C \uC148\uC774 \uB418\uB294 \uAC70\uC57C.[VAR 0114(0025)]",
  "\uADF8\uB9AC\uACE0 \uC6D0\uB798 \uB370\uBBF8\uC9C0\uAC00 100%\uB2C8\uAE4C,\\n\uC5EC\uAE30\uC5D0 200%\uB97C \uB354\uD558\uBA74 300%\uAC00 \uB418\uC9C0?[VAR 0114(0025)]",
  "\uADF8\uB7EC\uB2C8\uAE4C \uB2E4\uC74C\uC5D0 \uC0AC\uC6A9\uD558\uB294 \uAE30\uC220\uC758 \uB370\uBBF8\uC9C0\uB294\\n3\uBC30\uAC00 \uB418\uB294 \uAC70\uC57C.[VAR 0114(0025)]",
  "\uBC29\uAE08 \uD55C \uACC4\uC0B0\uC5D0 \uD0C0\uC785 \uC0C1\uC131\uC774\uB098\\n\uAE09\uC18C \uB370\uBBF8\uC9C0\uC5D0 \uB530\uB978 \uACF1\uC148\uB3C4 \uB4E4\uC5B4\uAC00\uB2C8\uAE4C\\r\\n\uC870\uAE08 \uC624\uB978 \uC815\uB3C4\uB77C\uB3C4 \uBC29\uC2EC\uD560 \uC218 \uC5C6\uB294 \uAC70\uC9C0.[VAR 0114(0025)]",
  "\uCC38\uACE0\uB85C\\n\u201C\uB2A5\uB825\uC774 \uC62C\uB77C\uAC14\uB2E4!\u201D\uB294 1\uB2E8\uACC4,\\r\\n\u201C\uB2A5\uB825\uC774 \uD06C\uAC8C \uC62C\uB77C\uAC14\uB2E4!\u201D\uB294 2\uB2E8\uACC4,\\r\\n\u201C\uB2A5\uB825\uC774 \uB9E4\uC6B0 \uD06C\uAC8C \uC62C\uB77C\uAC14\uB2E4!\u201D\uB294 3\uB2E8\uACC4\uC758\\r\\n\uB2A5\uB825 \uC0C1\uC2B9\uC744 \uC758\uBBF8\uD55C\uB2E8\uB2E4.[VAR 0114(0025)]",
  "\uBC30\uD2C0 \uC911\uC5D0\uB9CC \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294\\n\uD50C\uB7EC\uC2A4\uD30C\uC6CC\uB098 \uC2A4\uD398\uC15C\uC5C5\uC73C\uB85C\uB3C4\\r\\n\uB7AD\uD06C\uB97C \uD06C\uAC8C \uC62C\uB9B4 \uC218 \uC788\uC73C\uB2C8\uAE4C \uCC38\uACE0\uD558\uB834![VAR 0114(0025)]",
  "\uC5B4\uBA38\uB098, \uC885\uC18C\uB9AC\uAC00...\\n\uBC8C\uC368 \uB05D\uB098\uB2E4\uB2C8, \uC544\uC27D\uB124...[VAR 0114(0025)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5B4\uB824\uC6E0\uC744 \uD14C\uB2C8\uAE4C\\n\uBCF5\uC2B5\uD574 \uB46C\uC57C \u201C\uD06C\uAC8C\u201D \uD6A8\uACFC\uAC00 \uC788\uC744 \uAC70\uC57C.\\r\\n\uADF8\uB7FC, \uB2E4\uC74C \uC2DC\uAC04\uC5D0 \uBCF4\uC790![VAR 0114(0025)]"
]
