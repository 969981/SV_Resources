  "\uCD95\uD558\uD574![VAR 0114(0013)]",
  "...\uB77C\uACE0 \uB9D0\uD574 \uC8FC\uACE0 \uC2F6\uC9C0\uB9CC\\n\uCC54\uD53C\uC5B8 \uD14C\uC2A4\uD2B8\uB294\\r\\n\uC544\uC9C1 \uC870\uAE08 \uB354 \uB0A8\uC558\uC5B4.[VAR 0114(0013)]",
  "\uB2E4\uC74C\uC774 \uB4DC\uB514\uC5B4\\n\uCC54\uD53C\uC5B8 \uD14C\uC2A4\uD2B8\uC758 \uB9C8\uC9C0\uB9C9 \uAD00\uBB38\uC774\uC57C.[VAR 0114(0013)]",
  "\uC548\uCABD\uC758 \uBB38\uC744 \uD655\uC778\uD574 \uBD10.[VAR 0114(0013)]",
  "\uC6B0\uB9AC\uC758 \uC288\uD37C \uCD1D\uB300\uC7A5...\\n\uCD5C\uC885 \uD14C\uC2A4\uD2B8\uC758 \uC2DC\uD5D8\uAD00\uC774\\r\\n\uC548\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744 \uAC70\uC57C.[VAR 0114(0013)]",
  "\uC0AC\uCC9C\uC655\uC744 \uC790\uC2E0\uC758 \uC2E4\uB825\uC73C\uB85C \uADF8\uB7EC\uBAA8\uC740\\n\uCC54\uD53C\uC5B8 \uB7AD\uD06C \uCD5C\uAC15\uC758 \uD2B8\uB808\uC774\uB108\uC9C0.[VAR 0114(0013)]",
  "\uBB50! \uC774 \uCE60\uB9AC \uB2D8\uC744 \uC774\uAE34 \uB108\uB77C\uBA74\\n\uBB38\uC81C\uC5C6\uC774 \uC774\uAE38 \uD14C\uC9C0\uB9CC \uB9D0\uC774\uC57C![VAR 0114(0013)]",
  "...\uC11C\uBE44\uC2A4\uD574 \uC904 \uD14C\uB2C8\uAE4C\\n\uC9C0\uBA74 \uC548 \uB3FC![VAR 0114(0013)]",
  "\uBF40\uC090,\\n\uC5B8\uB2C8\uB124 \uD3EC\uCF13\uBAAC \uC88B\uC544\uD574\uC694![VAR 0114(0014)]",
  "\uBF40\uC090,\\n\uC624\uBE60\uB124 \uD3EC\uCF13\uBAAC \uC88B\uC544\uD574\uC694![VAR 0114(0014)]",
  "\uADF8\uB7EC\uB2C8\uAE4C~\\n\uD30C\uC774\uD305~!\uC774\uC5D0\uC694![VAR 0114(0014)]",
  "\uC5D0~ \uADF8\uAC8C... \uAD7F...[VAR 0114(0015)]",
  "\uB420\uC131\uBD80\uB978 \uB098\uBB34\uB294\\n\uB5A1\uC78E\uBD80\uD130 \uC54C\uC544\uBCF4\uB294 \uBC95![VAR 0114(0012)]",
  "\uC73C\uC544, \uAE5C\uC9DD\uC774\uC57C!\\n\uC5B4\uB290 \uD2C8\uC5D0 \uBD80\uD65C\uD55C \uAC70\uC57C...[VAR 0114(0013)]",
  "\uB2F9\uC2E0\uC774\uB77C\uBA74 \uBD84\uBA85\uD788\\n\uD574\uB0BC \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uC790! \uCD9C\uBC1C\uD558\uC2DC\uC8E0, [VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591!\\n\uB2F9\uC2E0\uC758 \uADF8 \uC791\uC740 \uC190\uC73C\uB85C\\r\\n\uCEE4\uB2E4\uB780 \uC2B9\uB9AC\uB97C \uAC70\uBA38\uC950\uB294 \uAC81\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uD798\uB0B4, [VAR 0100(0000)]!\\n\uC138\uAE30\uC758 \uC2B9\uBD80\uB97C \uBCF4\uC5EC \uC918![VAR 0114(0013)]",
  "\uCD5C\uC885 \uC2DC\uD5D8, \uC798 \uB2E4\uB140\uC624\uC138\uC694![VAR 0114(0014)]",
  "...\uAD7F \uB7ED\uC785\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uCD5C\uC885 \uC2DC\uD5D8\uAD00\uC740 \uAC15\uD569\uB2C8\uB2E4... \uD558\uC9C0\uB9CC!\\n\uB2F9\uC2E0\uB3C4 \uCDA9\uBD84\uD788 \uAC15\uD569\uB2C8\uB2E4...!\\c\\n\uADF8\uB7EC\uB2C8 \uC8FC\uB205 \uB4E4\uC9C0 \uB9D0\uACE0,\\n\uD3C9\uC815\uC2EC\uC744 \uAC00\uC9C0\uACE0 \uC2F8\uC6B0\uB3C4\uB85D \uD558\uC138\uC694![VAR 0114(0012)]"
