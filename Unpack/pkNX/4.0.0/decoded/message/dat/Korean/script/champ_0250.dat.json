[
  "\uC0AC\uCC9C\uC655 \uD314\uC790\uD06C\uC5D0\uAC8C \uB3C4\uC804\uD558\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uB2F9\uC2E0\uC774\uB77C\uBA74 \uC5B8\uC820\uAC00\\n\uC5EC\uAE30\uAE4C\uC9C0 \uC624\uC2E4 \uAC70\uB77C \uBBFF\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC5B4\uB9B0 \uC2F9\uC774 \uC131\uC7A5\uD558\uB294 \uAC83\uC740 \uC815\uB9D0\uC774\uC9C0\\n\uB180\uB77C\uC6B8 \uC815\uB3C4\uB124\uC694.[VAR 0114(0012)]",
  "\uC774\uB807\uAC8C\uB098 \uBE68\uB9AC \uACA8\uB8E8\uAC8C \uB420 \uC904\uC774\uC57C.\\n\uC800\uC758 \uC0C1\uC0C1\uC744 \uC544\uB4DD\uD788 \uB6F0\uC5B4\uB118\uB294\uAD70\uC694.[VAR 0114(0012)]",
  "\uAD50\uC0AC\uB780 \uC790\uACE0\uB85C, \uC81C\uC790\uB97C \uC774\uB04C\uC5B4 \uC8FC\uACE0\\n\uADF8\uB4E4\uC758 \uC131\uC7A5\uC744 \uB3D5\uB294 \uAC83\uC774 \uBCF8\uBD84\uC785\uB2C8\uB2E4\uB9CC[VAR 0114(0012)]",
  "\uC9C0\uAE08\uC740 \uADF8\uB7F0\\n\uAD50\uC721\uC790\uB85C\uC11C\uC758 \uBCF8\uBD84\uC740 \uC78A\uACE0...[VAR 0114(0012)]",
  "\uB2F9\uC2E0\uC744 \uC4F0\uB7EC\uB728\uB9AC\uAE30 \uC704\uD574\\n\uC628 \uD798\uC744 \uB2E4\uD558\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uC800\uB294 \uC2E4\uAE30 \uD14C\uC2A4\uD2B8\\n\uCD5C\uD6C4\uC758 \uAD00\uBB38\uC744 \uC9C0\uD0A4\uB294 \uC6A9, \uD314\uC790\uD06C.[VAR 0114(0012)]",
  "\uB9F9\uB82C\uD558\uAC8C \uBAB0\uC544\uCE58\uB294 \uC2B9\uBD80\uC758 \uC228\uACB0\uC744\\n\uC9C1\uC811 \uAC00\uB974\uCCD0 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!![VAR 0114(0012)]",
  "\uC9C0... \uC9C4\uC9DC\\n\uC774\uACA8 \uBC84\uB838\uC5B4.[VAR 0114(0013)]",
