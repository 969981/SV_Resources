  "[~ 10]",
  "[~ 10]",
  "\uB204\uB8E9\uC2A4\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uB3C4\uC804\uC790\uC758 \uC774\uB984\uC744\\n\uB4F1\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4...\\r\\n[VAR 0100(0000)] \uB2D8\uC774\uC2DC\uAD70\uC694!",
  "\uC774\uACF3\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5 \uBAA8\uC57C\uBAA8 \uB2D8\uACFC\\n\uC2B9\uBD80\uD558\uB824\uBA74 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C\\r\\n\uD074\uB9AC\uC5B4\uD574\uC57C \uD569\uB2C8\uB2E4.",
  "\uB204\uB8E9\uC2A4\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB294\\n[VAR FF00(0006)]\uBAA8\uC57C\uBAA8 \uB2D8 \uBC29\uC1A1\uC5D0 \uCD9C\uC5F0\uD558\uAE30[VAR FF00(0000)]!",
  "\uC2A4\uD2B8\uB9AC\uBA38\uC774\uAE30\uB3C4 \uD55C\\n\uBAA8\uC57C\uBAA8 \uB2D8\uC758 \uBC29\uC1A1\uC5D0 \uCD9C\uC5F0\uD574\uC11C\\r\\n\uB300\uBC15 \uCF58\uD150\uCE20\uB97C \uB9CC\uB4E4\uC5B4 \uC8FC\uC138\uC694!",
  "\uC790\uC138\uD55C \uB0B4\uC6A9\uC740 \uBC16\uC73C\uB85C \uB098\uAC00\uC2DC\uBA74\\n\uC54C \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4.",
  "[~ 10]",
  "\uADF8\uB7FC, \uB2E4\uB140\uC624\uC138\uC694!"
]
