[
  "\uC870\uAE08 \uAE34 \uC774\uC57C\uAE30\uB2E4\uB9CC \uAD1C\uCC2E\uACA0\uB2C8?[VAR 0114(0030)]",
  "\uAD1C\uCC2E\uC544\uC9C0\uAC70\uB4E0\\n\uB0B4\uAC8C \uB9D0\uD574 \uC8FC\uB824\uBB34\uB098.[VAR 0114(0030)]",
  "\uB098\uB3C4 \uB0B4 \uC544\uBC84\uC9C0\uC5D0\uAC8C\uC11C \uB4E4\uC740...\\n\uC6B0\uB9AC \uC77C\uC871 \uC548\uC5D0\uC11C \uAD6C\uC804\uB418\uC5B4 \uC628 \uC774\uC57C\uAE30\uB780\uB2E4.[VAR 0114(0030)]",
  "\uB2E4\uB978 \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB294 \uC54C\uB824\uC120 \uC548 \uB418\uB294\\n\uC9C4\uC2E4\uC774 \uB2F4\uAE34 \uC774\uC57C\uAE30\uC774\uB2C8,[VAR 0114(0030)]",
  "\uC808\uB300 \uC785 \uBC16\uC5D0 \uB0B4\uC120 \uC548 \uB41C\uB2E4.[VAR 0114(0030)]",
  "\uC751, \uC54C\uC558\uC5B4...[VAR 0114(0044)]",
  "\uBA3C \uC61B\uB0A0, \uD55C \uC0AC\uB0B4\uC640 \uB3C4\uAE68\uBE44\uAC00 \uC774\uAD6D \uB545\uC5D0\uC11C\\n\uBD81\uC2E0\uC758 \uACE0\uC7A5\uC73C\uB85C \uD758\uB7EC\uB4E4\uC5B4 \uC624\uAC8C \uB418\uC5C8\uB2E4.[VAR 0114(0030)]",
  "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740 \uC790\uC2E0\uB4E4\uACFC \uB2E4\uB974\uAC8C \uC0DD\uAE34\\n\uADF8\uB4E4\uC758 \uBAA8\uC2B5\uC744 \uB450\uB824\uC6CC\uD55C \uB098\uBA38\uC9C0...[VAR 0114(0030)]",
  "\uC0AC\uB0B4\uC640 \uB3C4\uAE68\uBE44\uB97C \uC790\uC2E0\uB4E4\uC758 \uB9C8\uC744\uC5D0\\n\uC811\uADFC\uD558\uC9C0 \uBABB\uD558\uAC8C \uD588\uB2E4.[VAR 0114(0030)]",
  "\uC0AC\uB0B4\uC640 \uB3C4\uAE68\uBE44\uB294 \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\\n\uD658\uC601\uBC1B\uC9C0 \uBABB\uD574 \uC2AC\uD390\uC9C0\uB9CC...[VAR 0114(0030)]",
  "\uC11C\uB85C\uAC00 \uC788\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uD589\uBCF5\uD588\uAE30\uC5D0\\n\uB4B7\uC0B0\uC758 \uB3D9\uAD74\uC5D0\uC11C \uC870\uC6A9\uD788 \uC9C0\uB0B4\uAE30\uB85C \uD588\uB2E4.[VAR 0114(0030)]",
  "\uADF8\uB7EC\uB098 \uB2E8 \uD55C \uC0AC\uB78C,\\n\uADF8\uB4E4\uC744 \uAC00\uC5FE\uC774 \uC5EC\uAE34 \uB9C8\uC744\uC758 \uAC00\uBA74 \uC7A5\uC778\uC740...[VAR 0114(0030)]",
  "\uC0AC\uB0B4\uC640 \uB3C4\uAE68\uBE44\uB97C \uC704\uD574\\n\uAC00\uBA74\uC744 \uBA87 \uAC1C \uB9CC\uB4E4\uC5B4 \uC8FC\uC5C8\uB2E4.[VAR 0114(0030)]",
  "\uC0AC\uB0B4\uAC00 \uC774\uAD6D\uC5D0\uC11C \uAC00\uC838\uC628 \uBCF4\uC11D\uC73C\uB85C \uC7A5\uC2DD\uD55C\\n\uB208\uBD80\uC2DC\uAC8C \uBE5B\uB098\uB294 \uAC00\uBA74\uC774\uC5C8\uB2E4.[VAR 0114(0030)]",
  "\uAC00\uBA74\uC744 \uC368\uC11C \uB9E8\uC5BC\uAD74\uC744 \uAC10\uCD94\uBA74\\n\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uACFC \uCE5C\uD558\uAC8C \uC9C0\uB0BC \uC218 \uC788\uC744 \uD130...[VAR 0114(0030)]",
  "\uC0AC\uB0B4\uC640 \uB3C4\uAE68\uBE44\uB294 \uAC00\uBA74 \uC7A5\uC778\uC758 \uCE5C\uC808\uD568\uC5D0\\n\uD06C\uAC8C \uAE30\uBED0\uD558\uBA70 \uAC10\uC0AC\uB97C \uD45C\uD588\uB2E4.[VAR 0114(0030)]",
  "\uAC00\uBA74\uC744 \uC4F4 \uC0AC\uB0B4\uC640 \uB3C4\uAE68\uBE44\uB294\\n\uB9C8\uC744 \uCD95\uC81C\uC5D0 \uBAB0\uB798 \uB098\uC624\uAE30\uB85C \uD588\uB2E4.[VAR 0114(0030)]",
  "\uC2E0\uBE44\uB85C\uC6B4 \uBAA8\uC2B5\uC758 \uB458\uACFC \uADF8\uB4E4\uC774 \uC4F4\\n\uD654\uB824\uD55C \uAC00\uBA74\uC740 \uAE08\uC138 \uC720\uBA85\uD574\uC84C\uACE0,[VAR 0114(0030)]",
  "\uADF8 \uC18C\uBB38\uC740 \uC21C\uC2DD\uAC04\uC5D0\\n\uBA38\uB098\uBA3C \uB545\uC5D0\uAE4C\uC9C0 \uC54C\uB824\uC9C0\uAC8C \uB418\uC5C8\uB2E4.[VAR 0114(0030)]",
  "\uADF8\uB7EC\uB358 \uC5B4\uB290 \uB0A0, \uB108\uBB34\uB098\uB3C4 \uC9C4\uADC0\uD55C\\n\uBE5B\uB098\uB294 \uAC00\uBA74\uC5D0 \uB300\uD55C \uC18C\uBB38\uC744 \uB4E4\uC740 \uAC83\uC778\uC9C0...[VAR 0114(0030)]",
  "\uC5EC\uB7EC \uB9C8\uB9AC\uC758 \uC695\uC2EC \uB9CE\uC740 \uD3EC\uCF13\uBAAC\uB4E4\uC774\\n\uBD81\uC2E0\uC758 \uACE0\uC7A5\uC744 \uCC3E\uC544\uC654\uB2E4.[VAR 0114(0030)]",
  "\uD3EC\uCF13\uBAAC\uB4E4\uC740\\n\uC0AC\uB0B4\uC640 \uB3C4\uAE68\uBE44\uAC00 \uC0AC\uB294 \uB3D9\uAD74\uC5D0 \uC228\uC5B4\uB4E4\uC5C8\uACE0...[VAR 0114(0030)]",
  "\uACE0\uC774 \uBCF4\uAD00\uB418\uC5B4 \uC788\uB358\\n\uAC00\uBA74\uC744 \uD6D4\uCE58\uB824 \uD588\uB2E4.[VAR 0114(0030)]",
  "\uC6B0\uC5F0\uD788 \uADF8\uB4E4\uACFC \uB9C8\uC8FC\uCE5C \uC0AC\uB0B4\uB294\\n\uAC04\uC2E0\uD788 \uAC00\uBA74 \uD558\uB098\uB97C \uC9C0\uCF1C \uB0C8\uC9C0\uB9CC...[VAR 0114(0030)]",
  "\uD798\uC774 \uBD80\uC871\uD55C \uB098\uBA38\uC9C0, \uC138 \uAC1C\uC758 \uAC00\uBA74\uC740\\n\uD3EC\uCF13\uBAAC\uB4E4\uC5D0\uAC8C \uBE7C\uC557\uAE30\uACE0 \uB9D0\uC558\uB2E4.[VAR 0114(0030)]",
  "\uBA87 \uC2DC\uAC04 \uB4A4,\\n\uB3C4\uAE68\uBE44\uAC00 \uB3D9\uAD74\uC5D0 \uB3CC\uC544\uC654\uC744 \uB54C\uB294...[VAR 0114(0030)]",
  "\uCE58\uC5F4\uD558\uAC8C \uC2F8\uC6B4 \uD754\uC801\uACFC\\n\uBCBD\uB85D\uC758\uAC00\uBA74\uB9CC\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4.[VAR 0114(0030)]",
  "\uC0AC\uB0B4\uB97C \uCC3E\uC73C\uB824\uB294 \uAC83\uC778\uC9C0,\\n\uB3C4\uAE68\uBE44\uB294 \uBCBD\uB85D\uC758\uAC00\uBA74\uC744 \uC4F0\uACE0 \uC0B0\uC744 \uB0B4\uB824\uAC14\uB2E4.[VAR 0114(0030)]",
  "\uADF8\uB9AC\uACE0... \uBE5B\uB098\uB294 \uAC00\uBA74\uC744 \uB4E4\uACE0\\n\uAE30\uBED0\uD558\uACE0 \uC788\uB358 \uD3EC\uCF13\uBAAC\uB4E4\uC744 \uD574\uCE58\uC6E0\uB2E4.[VAR 0114(0030)]",
  "\uC774\uB7EC\uD55C \uC0AC\uC815\uC744 \uC54C \uB9AC \uC5C6\uB358 \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740\\n\uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB09C \uAC83\uC778\uC9C0\uB3C4 \uBAA8\uB978 \uCC44,[VAR 0114(0030)]",
  "\uBD84\uB178\uC5D0 \uBBF8\uCCD0 \uB0A0\uB6F0\uB294 \uB3C4\uAE68\uBE44\uB97C \uBCF4\uACE0\\n\uB450\uB824\uC6C0\uC5D0 \uB5A8 \uBFD0\uC774\uC5C8\uB2E4.[VAR 0114(0030)]",
  "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740 \uC138 \uB9C8\uB9AC\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uC774\\n\uB3C4\uAE68\uBE44\uB85C\uBD80\uD130 \uB9C8\uC744\uC744 \uC9C0\uD0A8 \uAC83\uC774\uB77C \uC5EC\uACBC\uACE0,[VAR 0114(0030)]",
  "\uC560\uC815\uC744 \uB2F4\uC544 \uADF8\uB4E4\uC744 \uC138\uBC97\uC774\uB77C \uBD80\uB974\uBA70\\n\uC815\uC131\uC2A4\uB7FD\uAC8C \uBB3B\uC5B4 \uC8FC\uC5C8\uB2E4.[VAR 0114(0030)]",
  "\uC2AC\uD514\uC5D0 \uC7A0\uAE34 \uB3C4\uAE68\uBE44\uB294, \uB2E4\uCE5C \uBAB8\uC744 \uC774\uB04C\uACE0\\n\uD640\uB85C \uB4B7\uC0B0\uC758 \uB3D9\uAD74\uB85C \uB3CC\uC544\uAC08 \uBFD0\uC774\uC5C8\uB2E4...[VAR 0114(0030)]",
  "[~ 35]"
]
