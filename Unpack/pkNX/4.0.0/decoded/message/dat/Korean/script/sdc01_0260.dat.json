  "\uB610 \uC624\uAC70\uD3F0\uC744 \uB9CC\uB098\uB7EC \uAC00\uACE0 \uC2F6\uC9C0\uB9CC,\\n\uC77C\uB2E8\uC740 \uAC00\uBA74\uC774 \uACE0\uCCD0\uC9C8 \uB54C\uAE4C\uC9C0\\r\\n\uAE30\uB2E4\uB824\uC57C\uACA0\uC9C0~?[VAR 0114(0044)]",
  "\uCE74\uC9C0\uAC00 \uC758\uC2EC\uD558\uC9C0 \uC54A\uAC8C\\n\uC624\uB298\uC740 \uC58C\uC804\uD788\\r\\n\uC624\uB9AC\uC5D4\uD2F0\uC5B4\uB9C1\uC774\uB098 \uD558\uC790.[VAR 0114(0044)]",
