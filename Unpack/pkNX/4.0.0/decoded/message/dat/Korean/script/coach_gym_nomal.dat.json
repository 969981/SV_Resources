[
  "\uD314\uB370\uC544\uC9C0\uBC29 \uD3EC\uCF13\uBAAC\uB9AC\uADF8\uC5D0\uC11C \uC654\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uCCAD\uBAA9\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4.\\n\uBAA8\uCABC\uB85D \uC798 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "...\uB2F9\uC2E0\uC774\uC5C8\uAD70\uC694.[VAR 0114(0015)]",
  "\uB2E4\uB978 \uC9C0\uBC29\uAE4C\uC9C0\\n\uC0AC\uB78C\uC744 \uBD88\uB7EC\uB0B4\uB294 \uB300\uB2F4\uD568...\\r\\n\uC5B4\uB5A4 \uC0AC\uB78C\uC758 \uC601\uD5A5\uC744 \uBC1B\uC740 \uAC81\uB2C8\uAE4C?[VAR 0114(0015)]",
  "\uBB50, \uC800\uC57C \uCD9C\uC7A5\uC744 \uC88B\uC544\uD558\uB294 \uD3B8\uC774\uB77C\\n\uB531\uD788 \uC0C1\uAD00\uC5C6\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC77C \uB54C\uBB38\uC5D0 \uC628 \uAC70\uAE34 \uD569\uB2C8\uB2E4\uB9CC\\n\uBAA8\uCC98\uB7FC\uC774\uB2C8 \uC990\uAE30\uB3C4\uB85D \uD558\uC8E0.[VAR 0114(0015)]",
  "...\uD558\uB098\uC9C0\uBC29\uC758 \uB9DB\uC788\uB294 \uC74C\uC2DD\uC73C\uB85C\uB294\\n\uBE4C\uB9AC\uC9C0\uC0CC\uB4DC\uC640 \uAD6C\uB984\uC544\uC774\uC2A4\uAC00 \uC720\uBA85\uD569\uB2C8\uB2E4.\\r\\n\uB2F9\uC2E0\uC740 \uC5B4\uB5A4 \uC74C\uC2DD\uC774 \uAD81\uAE08\uD558\uC2DC\uC8E0?[VAR 0114(0015)]",
  "\uBE4C\uB9AC\uC9C0\uC0CC\uB4DC",
  "\uAD6C\uB984\uC544\uC774\uC2A4",
  "\uADF8\uB807\uAD70\uC694.\\n\uC5ED\uC2DC \uC0CC\uB4DC\uC704\uCE58\uB97C \uC88B\uC544\uD558\uC2DC\uB294\uAD70\uC694.[VAR 0114(0015)]",
  "\uADF8\uB807\uAD70\uC694.\\n\uB2EC\uCF64\uD55C \uAC83\uC744 \uC88B\uC544\uD558\uC2DC\uB294\uAD70\uC694.[VAR 0114(0015)]",
  "...\uCC38\uACE0\uD574 \uB450\uC9C0\uC694.[VAR 0114(0015)]",
  "\uAC15\uC758\uAC00 \uB05D\uB098\uBA74\\n\uAC00\uC11C \uBC30\uBD88\uB9AC \uBA39\uC5B4 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "...\uB2F9\uC2E0\uC774\uAD70\uC694.[VAR 0114(0015)]",
  "\uC9C0\uB09C\uBC88\uC5D0 \uB9D0\uD588\uB358\\n\uBE4C\uB9AC\uC9C0\uC0CC\uB4DC\uB97C \uBA39\uACE0 \uC654\uC2B5\uB2C8\uB2E4.\\c\\n\uD314\uB370\uC544\uC758 \uC0CC\uB4DC\uC704\uCE58\uC640\uB294\\n\uB2E4\uB974\uBA74\uC11C\uB3C4 \uAF64 \uB9DB\uC788\uB354\uAD70\uC694.\\c\\n\uC7AC\uB8CC\uB85C \uC4F0\uC778 \uB098\uBB34\uC5F4\uB9E4\uAC00\\n\uC785\uB9DB\uC5D0 \uB9DE\uC558\uB294\uC9C0\\r\\n\uCC0C\uB974\uD638\uD06C\uAC00 \uACC4\uC18D \uCABC\uC544\uB300\uC11C...[VAR 0114(0015)]",
  "\uC9C0\uB09C\uBC88\uC5D0 \uB9D0\uD588\uB358\\n\uAD6C\uB984\uC544\uC774\uC2A4\uB97C \uBA39\uACE0 \uC654\uC2B5\uB2C8\uB2E4.\\c\\n\uC2DD\uAC10\uC740 \uBD80\uB4DC\uB7FD\uACE0 \uB9DB\uC740 \uC9C4\uD574\uC11C\\n\uC815\uB9D0 \uBA39\uAE30 \uC88B\uB354\uAD70\uC694.\\c\\n\uD314\uB370\uC544\uC758 \uC544\uC774\uC2A4\uC704\uD2B8\uC5D0\uC11C\uB294\\n\uBCA0\uBCA0\uC194\uD2B8 \uC544\uC774\uC2A4\uAC00 \uC77C\uD488\uC778\uB370\\c\\n\uC5C4\uC120\uD55C \uC7AC\uB8CC\uB97C \uC544\uB08C\uC5C6\uC774 \uC0AC\uC6A9\uD55C\\n\uAD6C\uB984\uC544\uC774\uC2A4\uC758 \uB9DB\uB3C4 \uADF8\uC5D0 \uBABB\uC9C0\uC54A\uC740...[VAR 0114(0015)]",
  "...\uC8C4\uC1A1\uD569\uB2C8\uB2E4.\\n\uB9D0\uC774 \uB108\uBB34 \uAE38\uC5C8\uB124\uC694.[VAR 0114(0015)]",
  "\uD3C9\uC18C \uC5EC\uD589\uC740 \uBA39\uAE30 \uC704\uD574 \uAC00\uB294 \uAC83\uC774\uB77C\\n\uC0DD\uAC01\uD574\uC11C \uADF8\uB7F0\uC9C0\\r\\n\uC800\uB3C4 \uBAA8\uB974\uAC8C \uB9D0\uC774 \uB9CE\uC544\uC9C0\uB294\uAD70\uC694.[VAR 0114(0015)]",
  "\uADC0\uAC00\uD574\uC11C \uB298 \uBA39\uB358 \uC8FC\uBA39\uBC25\uC744 \uBA39\uB294 \uAC83\uB3C4\\n\uAC01\uBCC4\uD558\uC9C0\uB9CC \uB9D0\uC774\uC8E0...[VAR 0114(0015)]",
  "\uB2F9\uC2E0...\\c\\n\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758 \uC2DD\uB2F9\uC744\\n\uC774\uC6A9\uD574 \uBCF4\uC2E0 \uC801\uC740 \uC788\uC2B5\uB2C8\uAE4C?[VAR 0114(0015)]",
  "...\uAF64\uB098 \uC88B\uC740 \uACF3\uC774\uC9C0 \uC54A\uB098\uC694?[VAR 0114(0015)]",
  "...\uADF8\uB807\uAD70\uC694.\\n\uAF64\uB098 \uC88B\uC740 \uACF3\uC774\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC80A\uC740 \uCE35\uC744 \uD0C0\uAE43\uC73C\uB85C \uD574\uC11C\\n\uB9DB\uC774 \uC804\uCCB4\uC801\uC73C\uB85C \uC9C4\uD558\uAE34 \uD588\uC9C0\uB9CC\\r\\n\uC5B4\uB9C8\uC5B4\uB9C8\uD55C \uC591\uC774 \uB208\uC5D0 \uB744\uB354\uAD70\uC694.[VAR 0114(0015)]",
  "\uD2B9\uD788 \uC218\uBD81\uD558\uAC8C \uC313\uC778 \uC544\uCE74\uB370\uBBF8 \uD3EC\uD14C\uC774\uD1A0\uB294\\n\uCDA4\uC774 \uC808\uB85C \uB098\uC62C \uC815\uB3C4\uB85C \uC88B\uC558\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC544\uC9C1 \uB4DC\uC154 \uBCF4\uC2DC\uC9C0 \uC54A\uC558\uB2E4\uBA74\\n\uD55C\uBC88 \uACBD\uD5D8\uD574 \uBCF4\uC2DC\uB294 \uAC78 \uCD94\uCC9C\uB4DC\uB9AC\uC8E0.[VAR 0114(0015)]",
  "\uC81C \uC774\uC57C\uAE30\uB97C \uC774\uB807\uAC8C\uB098\\n\uC9C4\uC9C0\uD558\uAC8C \uB4E4\uC5B4 \uC8FC\uC2DC\uB2E4\uB2C8...[VAR 0114(0015)]",
  "\uB2F9\uC2E0\uC740 \uC5ED\uC2DC \uD2B9\uC774\uD55C \uBD84\uC774\uC2DC\uAD70\uC694.[VAR 0114(0015)]",
  "\uC774\uC655 \uD2B9\uC774\uD558\uC2E0 \uAE40\uC5D0\\n\uC800\uC640 \uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD558\uB294 \uAC83\uC740 \uC5B4\uB5A0\uC2E0\uC9C0\uC694.[VAR 0114(0015)]",
  "\uC800\uB294 \uB178\uACE0\uACE0\uCE58\uB97C \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.\\n\uB2F9\uC2E0\uC740 \uC544\uBB34 \uD3EC\uCF13\uBAAC\uC774\uB098 \uC8FC\uC154\uB3C4 \uB429\uB2C8\uB2E4.[VAR 0114(0015)]",
  "[VAR 0101(0001)][VAR 1900(0006)]\uB77C...\\n\uC0C1\uB2F9\uD788 \uD0A4\uC6B0\uB294 \uBCF4\uB78C\uC774 \uC788\uC744 \uAC83 \uAC19\uB124\uC694.\\r\\n\uAD50\uD658\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uB2F9\uC2E0\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uC81C \uB178\uACE0\uACE0\uCE58\uB97C \uAD50\uD658\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?[VAR 0114(0015)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "...\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uC744 \uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\\c\\n2\uB9C8\uB9AC \uC774\uC0C1 \uC788\uB294 \uC0C1\uD0DC\uB85C\\n\uAD50\uD658\uD558\uC2DC\uB294 \uAC83\uC744 \uAD8C\uC7A5\uB4DC\uB9AC\uC8E0.[VAR 0114(0015)]",
  "...\uADF8\uB7FC, \uB2E4\uC74C\uC5D0 \uC77C\uC815\uC774 \uB9DE\uC73C\uBA74\\n\uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "...\uAD50\uD658\uC744 \uC7AC\uAC1C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?[VAR 0114(0015)]",
  "\uB208\uBE5B\uC744 \uBCF4\uC544 \uD558\uB2C8...\\n\uC800\uC640 \uC2B9\uBD80\uAC00 \uD558\uACE0 \uC2F6\uC73C\uC2E0 \uBAA8\uC591\uC774\uAD70\uC694.[VAR 0114(0015)]",
  "...\uC2E4\uB840\uD588\uC2B5\uB2C8\uB2E4.\\n\uC81C \uCC29\uAC01\uC774\uC5C8\uAD70\uC694.[VAR 0114(0015)]",
  "\uC5C5\uBB34 \uC678\uC758 \uC77C\uC774\uAE34 \uD569\uB2C8\uB2E4\uB9CC\\n\uC0C1\uB300\uD574 \uB4DC\uB9AC\uC8E0.[VAR 0114(0015)]",
  "[~ 55]",
  "...\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uB2F9\uC2E0\uC774\uB77C\uB294 \uC0AC\uB78C\uC740\\n\uC810\uC810 \uB354 \uAC15\uD574\uC9C0\uC2DC\uB124\uC694.[VAR 0114(0015)]",
  "\uB540\uC744 \uD758\uB9AC\uC168\uC744 \uD14C\uB2C8\\n\uC774\uAC78 \uBC1B\uC544 \uC8FC\uC2DC\uC8E0.[VAR 0114(0015)]",
  "\uBBF8\uB124\uB784 \uBCF4\uCDA9\uC740 \uC911\uC694\uD558\uB2C8\uAE4C\uC694.[VAR 0114(0015)]",
  "[~ 55]",
  "\uC774\uAC83\uC744 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.\\n\uC624\uB298\uC740 \uC774\uB9CC \uB9C8\uBB34\uB9AC\uD558\uB3C4\uB85D \uD558\uC8E0.[VAR 0114(0015)]",
  "\uADF8\uB7FC, \uC2E4\uB840\uD558\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uB2F9\uC2E0\uB3C4 \uBBF8\uB044\uB7EC\uC9C8 \uB54C\uAC00 \uC788\uAD70\uC694.\\n...\uC778\uC0DD\uC5D0 \uCC38 \uC5EC\uB7EC \uC77C\uC774 \uC788\uB124\uC694.[VAR 0114(0015)]",
  "\uCC38\uD478\uB974\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB294\\n\uC2A4\uC2A4\uB85C\uB3C4 \uCC38 \uC798 \uACE0\uC548\uD588\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4.\\c\\n\uB3C4\uC804\uC790\uB4E4\uB07C\uB9AC \uC2F8\uC6B0\uAC8C \uD574\uC11C\\n\uC778\uC6D0\uC744 \uCD94\uB9B4 \uC218 \uC788\uB2E4\uB294 \uAC8C \uC7A5\uC810\uC774\uC8E0.[VAR 0114(0015)]",
  "\uD639\uC2DC \uCE58\uD504\uAC00\\n\uD3D0\uB97C \uB07C\uCE58\uAC70\uB098 \uD558\uC9C4 \uC54A\uC2B5\uB2C8\uAE4C?\\c\\n\uC2EB\uC740 \uAC83\uC744 \uC2EB\uB2E4\uACE0 \uD558\uC9C0 \uC54A\uC73C\uBA74\\n\uB9C8\uC74C\uC758 \uD3C9\uC628\uC744 \uCC3E\uAE30 \uD798\uB4E4\uC5B4\uC9C8 \uAC81\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC0AC\uCC9C\uC655 \uD14C\uC2A4\uD2B8\uB294\\n\uC81C \uB2E4\uC74C\uC774 \uD314\uC790\uD06C \uC528\uC778 \uAC8C \uBB38\uC81C\uC785\uB2C8\uB2E4.\\c\\n\uCE60\uB9AC \uC528\uB098 \uBF40\uC090 \uC528\uC600\uB2E4\uBA74\\n\uD070 \uC18C\uB9AC\uB85C \uBD80\uB974\uC9C0 \uC54A\uC544\uB3C4 \uB208\uCE58\uCC4C \uD14C\uB2C8\uAE4C\uC694.[VAR 0114(0015)]",
  "[VAR 0101(0001)][VAR 1900(0001)] \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\\n\uAC1D\uAE30\uB97C \uBD80\uB9AC\uB294 \uAC83 \uAC19\uC9C0\uB294 \uC54A\uB354\uAD70\uC694.[VAR 0114(0015)]",
  "\uC9C0\uB09C\uBC88\uC5D0 \uAD50\uD658\uD574 \uB4DC\uB9B0\\n\uB178\uACE0\uACE0\uCE58\uB294 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC2B5\uB2C8\uAE4C?\\c\\n\uBE44\uD589\uD0C0\uC785\uC73C\uB85C \uD14C\uB77C\uC2A4\uD0C8\uD558\uB294...\\n\uACF5\uC911\uB0A0\uAE30\uB178\uACE0\uACE0\uCE58\uC785\uB2C8\uB2E4.[VAR 0114(0015)]",
  "...\uC774\uBC88\uC5D0 \uCE58\uD504\uC5D0\uAC8C\uC11C\\n\uC5F0\uB77D\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\\c\\n\uB2F9\uC2E0\uC774 \uAC00\uC7A5 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC73C\uB85C\\n\uC800\uB97C \uC120\uD0DD\uD588\uB2E4\uB354\uAD70\uC694...\\c\\n\uC800\uCC98\uB7FC \uD3C9\uBC94\uD55C \uB0A8\uC790\uB97C \uC9C0\uBA85\uD558\uC2DC\uB2E4\uB2C8\\n\uC774\uD574\uAC00 \uC798 \uB418\uC9C0 \uC54A\uB124\uC694.\\c\\n\uD53C\uB85C\uD574\uC11C \uD310\uB2E8\uB825\uC774 \uB5A8\uC5B4\uC9C0\uC2E0 \uAC70\uB77C\uBA74\\n\uC88B\uC740 \uACF5\uC6D0\uC744 \uC18C\uAC1C\uD574 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]"
]
