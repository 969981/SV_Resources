[
  "[~ 27]",
  "[VAR 0100(0000)] \uB2D8\\n\uC138\uB974\uD074\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uACFC\uC790\uBC8C\uB808 \uD30C\uD2F0\uC2DC\uC5D0\uB974...\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB2E8\uD48D\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uADF8\uB7FC, \uBC30\uD2C0\uCF54\uD2B8\uB85C \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4.",
  "\uC900\uBE44\uAC00 \uB418\uC2DC\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.",
  "\uBE44\uBE44\uC6A9~\\n\uB9CE~\uC774 \uBA39\uC73C\uB834~[VAR 0114(002C)]",
  "\uBE44\uC6A9\uB4DC!",
  "\uC5B4\uBA38\uB098~\\n\uBA4B\uC9C4 \uD2B8\uB808\uC774\uB108\uB2D8\uC774\uB124~[VAR 0114(002C)]",
  "\uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30\uC5D0\uC120\\n\uC5F4\uC2EC\uD788 \uAD74\uB824 \uC918\uC11C \uACE0\uB9C8\uC6E0\uC5B4~[VAR 0114(002C)]",
  "\uC544\uCC28~\\n\uC544\uC9C1 \uB0B4 \uC18C\uAC1C\uB97C \uD558\uC9C0 \uC54A\uC558\uC5C8\uC9C0~?[VAR 0114(002C)]",
  "\uD30C\uD2F0\uC2A4\uB9AC \uC0AC\uBCF4\uB2C8\uC5D0\uB974\uC758 \uC810\uC7A5\\n\uB2E8\uD48D\uC774\uB77C\uACE0 \uD574~[VAR 0114(002C)]",
  "\uC544\uCC28\uCC28~ \uC9C0\uAE08\uC740 \uC138\uB974\uD074\uCCB4\uC721\uAD00\uC5D0\uC11C\\n\uC77C\uD558\uB294 \uC2DC\uAC04\uC774\uC5C8\uC9C0~[VAR 0114(0016)]",
  "\uB2E4\uC2DC \uB2E4\uC2DC~\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB2E8\uD48D\uC774\uB77C\uACE0 \uD574~[VAR 0114(0016)]",
  "\uD3C9\uC18C\uC5D0\uB294 \uACFC\uC790\uB97C \uB9CC\uB4DC\uB294\\n\uD30C\uD2F0\uC2DC\uC5D0\uB97C \uD558\uACE0 \uC788\uC5B4~[VAR 0114(0016)]",
  "\uC785\uC5D0 \uB123\uC73C\uBA74 \uD589\uBCF5\uD574\uC9C0\uB294 \uACFC\uC790\uB3C4,\\n\uD480\uACFC \uB098\uBB34\uC5D0 \uC228\uC5B4 \uC788\uB294 \uBC8C\uB808\uD3EC\uCF13\uBAAC\uB3C4,\\r\\n\uC791\uC9C0\uB9CC \uD070 \uD798\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E8\uB2E4~[VAR 0114(0016)]",
  "\uADF8\uB7EC\uB2C8\uAE4C \uBC29\uC2EC\uD558\uC9C0 \uB9D0\uACE0\\n\uC5F4\uC2EC\uD788 \uD574 \uBD10~[VAR 0114(0016)]",
  "\uB108\uC758 \uC2E4\uB825, \uC2B9\uBD80 \uC911\uC5D0\uB3C4\\n\uC810\uC810 \uB354 \uBD80\uD480\uC5B4 \uC624\uB974\uB354\uB77C~[VAR 0114(0016)]",
  "\uB098\uB3C4 \uC9C0\uAE08\uBCF4\uB2E4 \uD6E8~\uC52C \uB354\\n\uC9C4\uD654\uD574\uC57C\uACA0\uC5B4~[VAR 0114(0016)]",
  "\uC544\uBB34\uD2BC \uACB0\uACFC\uB294 \uD569\uACA9~!\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC744 \uC774\uAE34 \uC99D\uD45C\uB85C\\r\\n\uC774 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uC904\uAC8C~[VAR 0114(0016)]",
  "\uB2E8\uD48D [VAR 1100(00FF,0202)]\uB204\uB098\uC5B8\uB2C8\uD45C \uD2B9\uC81C \uCEF5\uCF00\uC774\uD06C\uB3C4 \uC904 \uD14C\uB2C8\uAE4C\\n\uB9CE~\uC774 \uBA39\uB3C4\uB85D \uD574~[VAR 0114(0016)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C [VAR 0200(0001)]\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uB808\uBCA8 [VAR 0201(0002)]\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E4\uC744 \uAC70\uC57C~[VAR 0114(0016)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E4\uC744 \uAC70\uC57C~[VAR 0114(0016)]",
  "\uB9DB\uC788\uAC8C \uBA39\uC5B4 \uC918\uC11C \uACE0\uB9C8\uC6CC!\\n\uB514\uC800\uD2B8\uB85C \uC774 \uAE30\uC220\uBA38\uC2E0\uB3C4 \uBC1B\uC544 \uC904\uB798~?[VAR 0114(0016)]",
  "\uBAA8\uD5D8 \uC911\uC5D0 \uC190\uC5D0 \uB123\uC740 \uAE30\uC220\uBA38\uC2E0\uC740\\n\uAE30\uC220\uBA38\uC2E0\uBA38\uC2E0\uC73C\uB85C \uB354 \uB9CC\uB4E4 \uC218 \uC788\uC5B4~[VAR 0114(0016)]",
  "\uC55E\uC73C\uB85C \uB124\uAC00 \uAC00\uB294 \uAE38\uC774\\n\uB2EC\uCF64\uD558\uACE0 \uBD80\uB4DC\uB7FD\uAE38 \uBC14\uB77C~[VAR 0114(0016)]",
  "\uADF8\uB7FC, \uB610 \uB9CC\uB098\uC790~[VAR 0114(0016)]",
  "\uC138\uB974\uD074\uCCB4\uC721\uAD00 \uD569\uACA9\uC744\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!"
]
