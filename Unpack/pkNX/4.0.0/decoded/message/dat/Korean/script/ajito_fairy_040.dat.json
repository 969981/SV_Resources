  "\uADF8\uB798\uC11C \uC800\uB294 \uADF8 \uCC45\uC784\uC744 \uC9C0\uAE30 \uC704\uD574\\n\uAD50\uC7A5\uC9C1\uC744 \uB0B4\uB824\uB193\uACE0,\\c\\n\uB2F9\uC2DC\uC758 \uC120\uC0DD\uB2D8\uB4E4 \uC5ED\uC2DC \uBAA8\uB450\\n\uD568\uAED8 \uD559\uAD50\uB97C \uADF8\uB9CC\uB450\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(003C)]",
  "\uADF8\uB798\uC11C 1\uB144 \uBC18 \uC804\uC5D0 \uC120\uC0DD\uB2D8\uB4E4\uC774\\n\uBAA8\uC870\uB9AC \uAD50\uCCB4\uB41C \uAC70\uAD70\uC694...[VAR 0114(001E)]",
  "\uC5EC\uB7EC\uBAA8\uB85C \uD3D0\uB97C \uB07C\uCE58\uACE0 \uB9D0\uC558\uC2B5\uB2C8\uB2E4.[VAR 0114(003C)]",
