  "\uC57D 1\uB144 \uBC18 \uC804, \uC2A4\uD0C0\uB2E8\uC740\\n\uC790\uC2E0\uB4E4\uC744 \uAD34\uB86D\uD788\uB358 \uD559\uC0DD\uB4E4\uC744 \uC0C1\uB300\uB85C\\r\\n\uC18C\uB3D9\uC744 \uC77C\uC73C\uCF30\uC2B5\uB2C8\uB2E4.[VAR 0114(003C)]",
  "\uD070\uC77C\uB85C \uBC88\uC9C0\uC9C0\uB294 \uC54A\uC558\uC9C0\uB9CC,\\n\uC804\uB300\uBBF8\uBB38\uC758 \uC0AC\uAC74\uC774\uC5C8\uC9C0\uC694.[VAR 0114(003C)]",
  "\uADF8 \uC77C\uC744 \uACC4\uAE30\uB85C,\\n\uAD34\uB86D\uD798\uC758 \uAC00\uD574\uC790\uC600\uB358 \uD559\uC0DD\uB4E4\uC740\\r\\n\uD558\uB098\uB458 \uC544\uCE74\uB370\uBBF8\uB97C \uADF8\uB9CC\uB450\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(003C)]",
  "\uC544\uCE74\uB370\uBBF8\uC5D0 \uADF8\uB7F0 \uAE30\uB85D\uC740...![VAR 0114(001E)]",
