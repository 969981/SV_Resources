  "\uADF8\uB7F0 \uC640\uC911\uC5D0 \uB2F9\uC2DC \uAD50\uAC10\uC774\\n\uC790\uC2E0\uC774 \uC838\uC57C \uD560 \uCC45\uC784\uC744 \uD53C\uD558\uAE30 \uC704\uD574\\c\\n\uC0AC\uAC74\uACFC \uAD00\uB828\uB41C \uAE30\uB85D\uC744\\n\uC11C\uBC84\uC5D0\uC11C \uBAA8\uB450 \uC9C0\uC6CC \uBC84\uB9B0 \uAC83\uC774\uC9C0\uC694...[VAR 0114(003C)]",
  "\uBB34\uC2A8 \uC9D3\uC744!\\n\uC0AC\uAC74\uC744 \uC740\uD3D0\uD558\uB824 \uD55C \uAC70\uAD70\uC694...![VAR 0114(001E)]",
