  "[VAR 0100(0000)] \uB2D8\\n\uBCF4\uC6B8\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uB124\uC774\uCC98 \uC544\uD2F0\uC2A4\uD2B8...\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uCF5C\uC0AC\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uADF8\uB7FC, \uBC30\uD2C0\uCF54\uD2B8\uB85C \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4.",
  "\uC900\uBE44\uAC00 \uB418\uC2DC\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.",
  "\uB3C4\uC804\uC790\uC5EC![VAR 0114(002C)]",
  "\uD558\uC555![VAR 0114(002C)]",
  "\uC798 \uC654\uB2E4.[VAR 0114(002C)]",
  "\uB0B4 \uC774\uB984\uC740 \uCF5C\uC0AC.\\n\uD480\uD3EC\uCF13\uBAAC \uC804\uBB38 \uC608\uC220\uAC00\uB2E4.\\r\\n\uBCF4\uC6B8\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uAE30\uB3C4 \uD558\uC9C0.[VAR 0114(0017)]",
  "\uB108\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8.\\n\uD48D\uCC28 \uC704\uC5D0\uC11C \uC798 \uBD24\uB2E4.[VAR 0114(0017)]",
  "\uD574\uB8E8\uBBF8\uB97C \uBC1C\uACAC\uD574 \uB0B4\uB294\\n\uB108\uC758 \uADF8 \uAD00\uCC30\uB825...[VAR 0114(0017)]",
  "\uC2E4\uB85C \uC544\uBC29\uAC00\uB974\uB4DC\uD558\uB354\uAD70!![VAR 0114(0017)]",
  "\uB108\uC758 \uADF8 \uC2EC\uBBF8\uC548\uC774 \uC2B9\uBD80\uC5D0\uC11C\uB3C4\\n\uC81C\uB300\uB85C \uBC1C\uD718\uB418\uAE30\uB97C \uAE30\uB300\uD558\uACA0\uB2E4.[VAR 0114(0017)]",
  "\uADF8\uB7FC, \uC6B0\uB9AC \uB458\uC758 \uC608\uC220\uC801\uC778 \uD569\uC791\uD488\uC744\\n\uD55C\uBC88 \uB9CC\uB4E4\uC5B4 \uBCF4\uB3C4\uB85D \uD560\uAE4C![VAR 0114(0017)]",
  "\uC900\uBE44\uB294 \uB410\uACA0\uC9C0!?\\n\uC131\uD615... \uC2DC\uC791\uC774\uB2E4!![VAR 0114(0017)]",
  "[~ 27]",
  "\uCC38\uC73C\uB85C \uC544\uD2F0\uC2A4\uD2F1\uD55C \uD0DD\uD2F1\uC2A4![VAR 0114(0017)]",
  "\uAE30\uC220\uC758 \uD328\uD134!\\n\uD3EC\uCF13\uBAAC\uC758 \uB514\uD14C\uC77C!\\r\\n\uBAA8\uB4E0 \uAC83\uC774 \uC798 \uB2E4\uB4EC\uC5B4\uC838 \uC788\uB354\uAD70![VAR 0114(0017)]",
  "\uB108\uC640\uC758 \uBC30\uD2C0\uC744\\n\uC608\uC220\uC774\uB77C \uBD80\uB974\uC9C0 \uBABB\uD55C\uB2E4\uBA74\\r\\n\uBB34\uC5C7\uC744 \uC608\uC220\uC774\uB77C \uBD80\uB97C \uC218 \uC788\uB2E8 \uB9D0\uC778\uAC00!?[VAR 0114(0017)]",
  "...\uB098\uC758 \uC2EC\uC0AC \uACB0\uACFC\uB294\\n\uD760\uC7A1\uC744 \uB370 \uC5C6\uC774 \uD569\uACA9\uC774\uB2E4![VAR 0114(0017)]",
  "\uADF8 \uC99D\uD45C\uB85C \uC774 \uBC30\uC9C0\uB97C \uC8FC\uACA0\uB2E4!\\n\uAE30\uB150 \uCD2C\uC601\uB3C4 \uD574 \uC8FC\uB3C4\uB85D \uD558\uC9C0!![VAR 0114(0017)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C [VAR 0200(0001)]\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uB808\uBCA8 [VAR 0201(0002)]\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E4\uC744 \uAC70\uB2E4![VAR 0114(0017)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC644\uBCBD\uD558\uAC8C \uB4E4\uC744 \uAC70\uB2E4![VAR 0114(0017)]",
  "\uB108 \uAC19\uC740 \uD2B8\uB808\uC774\uB108\uC5D0\uAC8C\\n\uB098\uC758 \uC774 \uC560\uC7A5\uD488\uC744 \uC8FC\uC9C0 \uC54A\uC744 \uC218 \uC5C6\uACA0\uAD70![VAR 0114(0017)]",
  "\uC544\uC544... \uC601\uAC10\uC774...\\n\uACC4\uC18D\uD574\uC11C \uB5A0\uC624\uB978\uB2E4... \uB5A0\uC62C\uB77C...![VAR 0114(0017)]",
  "\uBC14\uB85C \uC2E0\uC791\uC744 \uB9CC\uB4E4\uB7EC \uAC00\uC57C \uD558\uB2C8\\n\uC774\uB9CC \uC2E4\uB840\uD558\uACA0\uB2E4! \uC798 \uAC00\uB77C![VAR 0114(0017)]",
  "\uBCF4\uC6B8\uCCB4\uC721\uAD00 \uD569\uACA9\uC744\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!",
