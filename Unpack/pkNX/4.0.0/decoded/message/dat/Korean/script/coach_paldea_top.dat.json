  "\uAE00\uB7EC\uBE0C\uC5D0 \uB300\uD55C \uB300\uB2F5\uC740...\\n\uCC9C\uCC9C\uD788 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uACA0\uC5B4\uC694.[VAR 0114(0011)]",
  "\uB2F9\uC2E0 \uAC19\uC740 \uBD84\uC5D0\uAC8C\uC11C\uB294\\n\uBCF4\uAE30 \uB4DC\uBB38 \uC2E4\uC218\uB124\uC694.\\c\\n\uB2E4\uC74C\uC5D0\uB294 \uAF2D \uC800\uB97C \uC774\uACA8 \uC8FC\uC138\uC694.[VAR 0114(0011)]",
  "\uD3EC\uCF13\uBAAC\uB9AC\uADF8\uB97C \uBAA8\uBC29\uD55C \uBD80\uD65C\uB3D9\uC774\uB77C\uB2C8\\n\uC815\uB9D0\uC774\uC9C0 \uD765\uBBF8\uB85C\uC6B4 \uBC1C\uC0C1\uC774\uB124\uC694.\\c\\n\uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uB3C4 \uB3C4\uC785\uD560 \uC218 \uC788\uC744\uC9C0\\n\uD074\uB77C\uBCA8 \uB2D8\uACFC \uAC80\uD1A0\uD574 \uBD10\uC57C\uACA0\uC5B4\uC694.[VAR 0114(0011)]",
  "\uC800\uB3C4 \uBA87 \uBC88\uC778\uAC00\\n\uC81C\uB85C\uB7A9\uC5D0 \uAC04 \uC801\uC774 \uC788\uB294\uB370...\\c\\n\uB0A8\uCCAD\uC758\uB514\uC2A4\uD06C\uB97C \uC785\uAD6C \uD328\uB110\uC5D0\\n\uB123\uC5B4 \uBCFC \uC0DD\uAC01\uC740 \uC804\uD600 \uBABB \uD588\uC5B4\uC694.\\c\\n\uD6C4\uD6C4... \uC5ED\uC2DC \uB2F9\uC2E0\uC740\\n\uC81C \uC0C1\uC0C1\uC744 \uC544\uB4DD\uD788 \uCD08\uC6D4\uD558\uB294 \uBD84\uC774\uB124\uC694.[VAR 0114(0011)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758 \uC785\uAD6C \uB85C\uBE44\uB294\\n\uC815\uB9D0 \uB3C5\uCC3D\uC801\uC774\uACE0 \uBA4B\uC9C4 \uAC83 \uAC19\uC544\uC694.\\c\\n\uBB3C\uB860 \uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758 \uC785\uAD6C \uD640\uB3C4\\n\uAC70\uAE30\uC5D0 \uB4A4\uC9C0\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC9C0\uB9CC\uC694.[VAR 0114(0011)]",
  "\uCC54\uD53C\uC5B8 [VAR 0100(0000)][VAR 1900(0003)]\\n\uAD50\uD658\uD574 \uC8FC\uC2E0 [VAR 0101(0001)]...\\c\\n\uB2F9\uC2E0\uC744 \uB2EE\uC544\uC11C\\n\uC815\uB9D0 \uD6CC\uB96D\uD55C \uC7AC\uB2A5\uC744 \uAC00\uC84C\uB354\uAD70\uC694.[VAR 0114(0011)]",
  "\uC81C\uAC00 \uAD50\uD658\uD574 \uB4DC\uB9B0 \uCD08\uB871\uC21C\uC740\\n\uC798 \uD0A4\uC6B0\uACE0 \uACC4\uC2DC\uB098\uC694?\\c\\n\uADF8 \uC544\uC774\uAC00 \uAC00\uC9C4 \uD798\uC774\\n\uBD84\uBA85 \uB2F9\uC2E0\uC5D0\uAC8C \uB3C4\uC6C0\uC774 \uB420 \uAC70\uC608\uC694.[VAR 0114(0011)]"
]
