  "\uAC00\uB054\uC529 \uAC00\uC2B4\uC774 \uB2F5\uB2F5\uD558\uACE0\\n\uC2DD\uC695\uB3C4 \uBD80\uC9C4\uD569\uB2C8\uB2E4.[VAR 0114(0048)]",
