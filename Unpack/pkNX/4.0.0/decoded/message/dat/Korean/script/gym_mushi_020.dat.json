  "\uACC4\uC18D\uD55C\uB2E4",
  "\uD3EC\uAE30\uD55C\uB2E4",
  "\uC9C0\uB984\uAE38\uC5D0\uB294 \uC2DC\uB828\uC774 \uB530\uB974\uB294 \uBC95!\\n\uB108\uC758 \uAC78\uC74C\uC744 \uBA48\uCD94\uACE0 \uB9D0\uACA0\uC5B4!",
  "\uBBF8\uB2C8\uBE0C\uB4E4\uB3C4\\n\uB108\uB97C \uC778\uC815\uD558\uACE0 \uC6C0\uC9C1\uC5EC \uC8FC\uACA0\uB300!",
  "\uBC30\uD2C0\uB85C \uAD74\uB9AC\uAE30\uB97C \uBC29\uD574\uD558\uB294 \uAC74,\\n\uC62C\uB9AC\uBE0C\uB97C \uD0A4\uC6B0\uB294 \uC218\uACE0\uB85C\uC6C0\uC744\\r\\n\uB290\uB084 \uC218 \uC788\uAC8C \uD558\uB824\uB294 \uAC70\uC57C!",
  "\uAE30\uAD8C\uD55C\uB2E4"
]
