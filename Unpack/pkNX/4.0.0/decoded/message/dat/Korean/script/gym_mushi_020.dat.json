  "[~ 33]",
  "\uC138\uB974\uD074\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uC5D0 \uAD00\uD55C \uC124\uBA85\uC744\\r\\n\uB2E4\uC2DC \uD55C\uBC88 \uB4E4\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uC138\uB974\uD074\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB294\\n[VAR FF00(0006)]\uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30[VAR FF00(0000)]!",
  "\uC62C\uB9AC\uBE0C\uB97C \uBCF8\uB5A0 \uB9CC\uB4E0 \uACF5\uC744 \uAD74\uB824\uC11C\\n\uACE8\uC5D0 \uB123\uC73C\uBA74 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uD074\uB9AC\uC5B4\uC785\uB2C8\uB2E4!\\r\\n\uADF8\uB7EC\uBA74 \uB0B4\uB144\uC5D0 \uC62C\uB9AC\uBE0C\uAC00 \uB9CE\uC774 \uC218\uD655\uB420 \uAC70\uC608\uC694!",
  "\uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30 \uD68C\uC7A5\uC740\\n[VAR FF00(0006)]\uB9C8\uC744 \uBD81\uCABD[VAR FF00(0000)]\uC5D0 \uC788\uC2B5\uB2C8\uB2E4!\\c\\n\uC790\uC138\uD55C \uB8F0\uC740 \uD68C\uC7A5\uC5D0 \uC788\uB294\\n\uC2A4\uD0DC\uD504\uC5D0\uAC8C \uB4E4\uC5B4 \uC8FC\uC138\uC694.",
  "\uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30 \uD68C\uC7A5\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30\uB294\\n\uAC70\uB300\uD55C \uC62C\uB9AC\uBE0C\uACF5\uC744\\r\\n\uC628\uBAB8\uC73C\uB85C \uBD80\uB52A\uCCD0\uC11C \uAD74\uB9AC\uB294 \uCCB4\uB825 \uD14C\uC2A4\uD2B8!",
  "\uB2E4\uC591\uD55C \uC7A5\uC560\uBB3C\uC744 \uB3CC\uD30C\uD558\uC5EC\\n\uACE8\uB300 \uBC14\uAD6C\uB2C8\uC5D0 \uC62C\uB9AC\uBE0C\uACF5\uC744 \uB123\uB294 \uB370\\r\\n\uC131\uACF5\uD558\uBA74 \uD074\uB9AC\uC5B4\uC785\uB2C8\uB2E4!",
  "\uADF8\uB7FC, \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\\n\uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30\uC5D0 \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uC54C\uACA0\uC2B5\uB2C8\uB2E4! \uD48D\uC791\uC744 \uAE30\uC6D0\uD558\uBA70\\n\uC5F4\uC2EC\uD788 \uAD74\uB824 \uC8FC\uC138\uC694!",
  "\uADF8\uB7FC, \uC900\uBE44\uAC00 \uB418\uC2DC\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.",
  "\uC5B4\uC11C \uC624\uC138\uC694! \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\\n\uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30\uC5D0 \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uB098\uB97C \uC774\uAE30\uBA74\\n\uC9C0\uB984\uAE38\uB85C \uC9C0\uB098\uAC08 \uC218 \uC788\uAC8C \uD574 \uC904\uAC8C!",
  "\uBBF8\uB2C8\uBE0C\uB85C \uB9CC\uB4E4\uC5B4\uC9C4 \uBCBD\uC744\\n\uB124\uAC00 \uACFC\uC5F0 \uB3CC\uD30C\uD560 \uC218 \uC788\uC744\uAE4C?",
  "\uBBF8\uB2C8\uBE0C\uB4E4\uC544~!\\n\uAE38\uC744 \uC5F4\uC5B4 \uC918~!",
  "\uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC\uC744 \uD0C0\uACE0 \uBC00\uBA74\\n\uC62C\uB9AC\uBE0C\uB97C \uB354 \uC27D\uAC8C \uAD74\uB9B4 \uC218 \uC788\uC5B4!",
  "[VAR 0100(0000)] \uB2D8 \uB355\uBD84\uC5D0\\n\uB0B4\uB144\uC5D0\uB3C4 \uD48D\uC791\uC77C \uAC70\uC608\uC694!",
  "\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uD569\uACA9\uC785\uB2C8\uB2E4!\\n\uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!",
  "\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACB0\uACFC\uB97C\\n\uC811\uC218\uCC98\uC5D0 \uBCF4\uACE0\uD574 \uC8FC\uC138\uC694!\\r\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uACFC\uC758 \uC2B9\uBD80\uB3C4 \uD798\uB0B4\uC138\uC694!",
  "\uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30\uB97C \uD3EC\uAE30\uD558\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uC815\uB9D0\uB85C \uD3EC\uAE30\uD558\uACA0\uC2B5\uB2C8\uAE4C?",
  "[~ 33]",
