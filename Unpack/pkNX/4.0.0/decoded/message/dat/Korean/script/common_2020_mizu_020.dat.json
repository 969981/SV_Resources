[
  "\uB124\uAC00 \uACBD\uB9E4\uC5D0\uC11C \uBBF8\uC5ED\uC744 \uB099\uCC30\uBC1B\uC544 \uC900 \uB355\uBD84\uC5D0\\n\uC6B0\uB9AC \uAC00\uAC8C\uC758 \uBBF8\uC5ED \uC694\uB9AC\uAC00 \uC778\uAE30 \uC808\uC815\uC774\uB780\uB2E4![VAR 0114(0018)]",
  "\uADF8\uB550 \uC815\uB9D0 \uACE0\uB9C8\uC6E0\uB2E4!\\n\uACFC\uC5F0 \uCC54\uD53C\uC5B8\uC774 \uB420 \uADF8\uB987\uC774\uC5C8\uB358 \uAC8C\uB85C\uAD70![VAR 0114(0018)]",
  "\uD558\uD558, \uC774\uB7F0 \uC77C\uC744 \uD558\uB2E4 \uBCF4\uBA74\\n\uB2E4\uC591\uD55C \uC0AC\uB78C\uC744 \uB9CC\uB098\uAC8C \uB41C\uB2E8 \uB9D0\uC774\uC9C0.[VAR 0114(0018)]",
  "\uB108\uCC98\uB7FC \uAE30\uC138 \uC88B\uAC8C\\n\uD750\uB984\uC744 \uD0C0\uB294 \uC0AC\uB78C\uC774 \uC788\uB294\uAC00 \uD558\uBA74\\r\\n\uC815\uCCB4\uB418\uC5B4 \uADF8\uB300\uB85C \uACE0\uC5EC \uBC84\uB9AC\uB294 \uC0AC\uB78C\uB3C4 \uC788\uB2E8\uB2E4.[VAR 0114(0018)]",
  "\uB098\uC774 \uBA39\uC740 \uC5B4\uB978\uC740\\n\uD6C4\uC790\uB97C \uC6D0\uD558\uAE30 \uC2ED\uC0C1\uC774\uB2E4\uB9CC\\r\\n\uB0B4\uAC8C \uADF8\uAC74 \uC880 \uC9C0\uB8E8\uD558\uB2E8 \uB9D0\uC774\uC9C0.[VAR 0114(0018)]",
  "...\uAC15\uC740 \uD758\uB7EC \uBC14\uB2E4\uAC00 \uB418\uACE0,\\n\uAD6C\uB984\uC744 \uD0C0\uACE0 \uC62C\uB77C \uB2E4\uC2DC \uBE44\uAC00 \uB418\uB294 \uBC95.[VAR 0114(0018)]",
  "\uCC9C\uBCC0\uB9CC\uD654\uD558\uB294 \uACA9\uB958\uC758 \uC694\uB9AC\uC0AC \uACE4\uD3EC \uB2D8\uC744!\\n\uB124 \uBAB8\uC73C\uB85C \uC9C1\uC811 \uB290\uAEF4 \uBCF4\uB3C4\uB85D \uD558\uAC70\uB77C![VAR 0114(0018)]",
  "\uACFC\uC5F0 \uCE58\uD504\uAC00 \uC778\uC815\uD558\uB294 \uC555\uB3C4\uC801\uC778 \uC2E4\uB825!\\n\uC5ED\uC2DC \uC6D4\uCC99\uC774\uAD70! \uC6D4\uCC99\uC774\uC57C![VAR 0114(0018)]",
  "\uC5B4\uB9C8\uC5B4\uB9C8\uD558\uAC8C \uAC70\uC13C \uB108\uC758 \uBB3C\uC0B4\uC740\\n\uC88B\uB4E0 \uB098\uC058\uB4E0 \uC8FC\uC704\uB97C \uD729\uC4F8\uC5B4\uC11C\\r\\n\uB9CE\uC740 \uC601\uD5A5\uC744 \uB07C\uCE60 \uAC8C\uB2E4![VAR 0114(0018)]",
  "\uADF8\uB7F0 \uB124 \uACC1\uC5D0 \uC788\uB294 \uCE5C\uAD6C\uB294\\n\uB108\uC5D0\uAC8C \uC18C\uC911\uD55C \uC874\uC7AC\uAC00 \uB418\uC5B4 \uC904 \uAC70\uACE0.[VAR 0114(0018)]",
  "\uC774\uC57C~ \uC80A\uC740\uC774\uC758 \uD798\uC5D0 \uB2F9\uD588\uB354\uB2C8\\n\uC544\uC800\uC528\uB3C4 \uC758\uC695\uC774 \uB9C8\uAD6C \uC0D8\uC19F\uB294\uAD6C\uB098![VAR 0114(0018)]",
  "\uD14C\uC0AC \uC544\uAC00\uC528\uC5D0\uAC8C \uC804\uD574 \uC8FC\uAC70\uB77C!\\n\uC774 \uACE4\uD3EC\uB294...\\r\\n\uC9C0\uAE08\uBCF4\uB2E4 \uB354 \uC138\uCC28\uAC8C \uBCC0\uD560 \uAC70\uB77C\uACE0 \uB9D0\uC774\uB2E4![VAR 0114(0018)]",
  "\uADF8\uB7FC \uBD80\uD0C1\uD55C\uB2E4, \uC80A\uC740 \uCE5C\uAD6C!\\n\uB2E4\uC74C\uC5D0 \uB610 \uB9CC\uB098\uAE30\uB97C \uAE30\uB300\uD558\uACE0 \uC788\uC73C\uB9C8![VAR 0114(0018)]"
]
