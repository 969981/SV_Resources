[
  "\uC81C\uAD70\uB4E4, \uC218\uC5C5\uC744 \uC2DC\uC791\uD558\uACA0\uB2E4.\\n\uC2A4\uB9C8\uD2B8\uD3F0\uC740 \uC9D1\uC5B4\uB123\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uC911\uAC04\uACE0\uC0AC\uC5D0\uC11C \uC5EC\uB7EC \uBC88\\n\uCD94\uAC00 \uC2DC\uD5D8\uC744 \uBC1B\uC740 \uC0AC\uB78C\uB3C4 \uC788\uC5C8\uC9C0\uB9CC,\\r\\n\uB300\uBD80\uBD84 \uD569\uACA9\uD574\uC11C \uB2E4\uD589\uC774\uAD70.[VAR 0114(0029)]",
  "\uC0B4\uC544\uAC00\uB294 \uB370 \uD544\uC694\uD55C \uC9C0\uC2DD\uACFC \uAE30\uC220\uB4E4\uC744\\n\uC81C\uAD70\uB4E4\uC774 \uC798 \uC2B5\uB4DD\uD558\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544\\r\\n\uC601\uAD11\uC2A4\uB7EC\uC6B8 \uB530\uB984\uC774\uB2E4.[VAR 0114(0029)]",
  "\uD6C4\uBC18\uAE30\uC5D0\uB3C4 \uCC29\uC2E4\uD558\uAC8C\\n\uC0B4\uC544\uAC00\uAE30 \uC704\uD55C \uAE30\uC220\uC744 \uAC08\uACE0\uB2E6\uC544 \uBCF4\uC790.[VAR 0114(0029)]",
  "\uC544\uBB34\uD2BC, \uC5B4\uB5A4 \uD559\uC0DD\uC73C\uB85C\uBD80\uD130\\n\uC2DD\uC0AC \uD30C\uC6CC\uC5D0 \uB300\uD55C \uC9C8\uBB38\uC744 \uBC1B\uC558\uB2E4.[VAR 0114(0029)]",
  "\uC9C8\uBB38\uD55C \uC0AC\uB78C\uC740\\n\uC694\uB9AC\uB97C \uC88B\uC544\uD558\uB294 \uD55C \uB0A8\uD559\uC0DD.[VAR 0114(0029)]",
  "\uADF8\uB294 \uC5B8\uC81C\uB098 \uD63C\uC790\uC11C\\n\uC694\uB9AC\uB97C \uC5F0\uAD6C\uD558\uACE0 \uC788\uC5C8\uB2E4\uBA74\uC11C,[VAR 0114(0029)]",
  "\uC2DD\uC7AC\uB8CC\uC5D0 \uC911\uC810\uC744 \uB450\uACE0\\n\uBC24\uB0AE\uC73C\uB85C \uC694\uB9AC\uBC95\uC744 \uC5F0\uAD6C\uD574 \uC654\uB294\uB370,[VAR 0114(0029)]",
  "\uC880\uCC98\uB7FC \uC2DD\uC0AC \uD30C\uC6CC\uC758 \uD6A8\uACFC\uAC00\\n\uAC15\uD574\uC9C0\uC9C0 \uC54A\uC544\uC11C \uACE0\uBBFC\uC774\uB77C\uB354\uAD70.[VAR 0114(0029)]",
  "\uADF8\uB7FC, \uC911\uAC04\uACE0\uC0AC\uC5D0\uC11C \uC6B0\uC218\uD55C \uC131\uC801\uC744 \uAE30\uB85D\uD55C\\n[VAR 0100(0000)]\uC5D0\uAC8C \uBB3B\uB3C4\uB85D \uD558\uC9C0.[VAR 0114(0029)]",
  "\uC2DD\uC0AC \uD30C\uC6CC\uC758 \uD6A8\uACFC\uB97C \uB192\uC774\uAE30 \uC704\uD574\\n\uD398... \uC544\uB2C8, \uB0A8\uD559\uC0DD\uC774 \uD574\uC57C \uD560 \uC77C\uC740 \uBB50\uC9C0?[VAR 0114(0029)]",
  "\uB354 \uB9CE\uC774 \uB9CC\uB4E4\uAE30",
  "\uC5EC\uB7FF\uC774\uC11C \uC694\uB9AC",
  "\uD398\uD37C\uAC00 \uBB3C\uC5B4\uBCF8 \uAC70\uC608\uC694?",
  "\uC694\uB9AC\uC758 \uC138\uACC4\uB294 \uC2EC\uC624\uD55C \uBC95...\\n\uBB34\uD131\uB300\uACE0 \uB9CE\uC774 \uB9CC\uB4E0\uB2E4\uACE0 \uD574\uC11C\\r\\n\uADF8 \uB178\uB825\uC774 \uACB0\uC2E4\uC744 \uB9FA\uB294\uB2E4\uACE0 \uBCF4\uC7A5\uD558\uC9C0\uB294 \uC54A\uC9C0.[VAR 0114(0029)]",
  "\uD6CC\uB96D\uD55C \uB2F5\uBCC0\uC774\uC5C8\uB2E4.\\n\uC694\uB9AC\uAC00 \uBB34\uC5C7\uC778\uC9C0 \uC798 \uC54C\uACE0 \uC788\uAD70.[VAR 0114(0029)]",
  "\uB044\uC751... \uC694\uB9AC\uB97C \uC88B\uC544\uD558\uB294\\n\uB0A8\uD559\uC0DD\uC758 \uC815\uCCB4\uB294 \uBE44\uBC00\uC774\uB2E4...\\r\\n\uB124 \uB9D0\uB300\uB85C \uD398\uD37C \uCCAD\uB144\uC77C \uC218\uB3C4 \uC788\uACE0,\\r\\n\uC544\uB2D0 \uC218\uB3C4 \uC788\uC9C0...![VAR 0114(0029)]",
  "\uC2DD\uC0AC \uD30C\uC6CC\uC758 \uD6A8\uACFC\uB97C \uB192\uC774\uB824\uBA74\\n\uC0CC\uB4DC\uC704\uCE58\uC5D0 \uB9CE\uC740 \uC2DD\uC7AC\uB8CC\uB97C\\r\\n\uB123\uC744 \uD544\uC694\uAC00 \uC788\uB2E4.[VAR 0114(0029)]",
  "\uD63C\uC790\uC11C\uB294 \uC5B4\uB824\uC6B4 \uC77C\uC774\uC9C0\uB9CC,\\n\uC5EC\uB7FF\uC774\uC11C \uB9CC\uB4E4\uBA74\\r\\n\uADF8\uB9CC\uD07C \uB2E4\uB8E8\uB294 \uBE75\uB3C4 \uCEE4\uC838\uC11C[VAR 0114(0029)]",
  "\uC544\uC8FC \uAC04\uB2E8\uD558\uAC8C\\n\uC2DD\uC7AC\uB8CC\uB97C \uCC44\uC6CC \uB123\uC744 \uC218 \uC788\uB294 \uAC83\uC774\uB2E4.[VAR 0114(0029)]",
  "\uB2E4\uC2DC \uB9D0\uD574, \uB192\uC740 \uD6A8\uACFC\uC758\\n\uC2DD\uC0AC \uD30C\uC6CC\uB97C \uC5BB\uC744 \uC218 \uC788\uB294 \uAC83\uC774\uC9C0.[VAR 0114(0029)]",
  "\uC774\uAC83\uC744 \uAD50\uD6C8 \uC0BC\uC544, \uACE4\uB780\uD560 \uB54C\uB294\\n\uD63C\uC790\uC11C \uC553\uACE0\uB9CC \uC788\uC9C0 \uB9D0\uACE0, \uB2E4\uB978 \uC0AC\uB78C\uACFC \uD568\uAED8\\r\\n\uBB38\uC81C\uB97C \uD574\uACB0\uD558\uB294 \uBC95\uB3C4 \uC788\uB2E4\uB294 \uAC78 \uBA85\uC2EC\uD558\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uD398\uD37C \uCCAD\uB144\uB3C4 \uB2E4\uC74C\uC5D0\uB294\\n\uCE5C\uAD6C\uC640 \uD568\uAED8 \uC694\uB9AC\uD560 \uAC70\uB77C \uBBFF\uB294\uB2E4.[VAR 0114(0029)]",
  "...\uD504\uB77C\uC774\uBC84\uC2DC\uC640 \uAD00\uB828\uB41C \uBB38\uC81C\uB2C8\uAE4C\\n\uB0A8\uD559\uC0DD\uC758 \uC815\uCCB4\uC5D0 \uB300\uD55C \uAC83\uC740\\r\\n\uB108\uBB34 \uAE4A\uC774 \uD30C\uACE0\uB4E4\uC9C0 \uB9D0\uB3C4\uB85D. \uC54C\uACA0\uB098?[VAR 0114(0029)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4.\\n\uC774\uB9CC \uC2E4\uB840\uD558\uC9C0.[VAR 0114(0029)]"
]
