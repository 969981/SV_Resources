[
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0 \uC628 \uAC78 \uD658\uC601\uD574!\\c\\n\uC9C0\uD558\uCCA0\uACFC \uC218\uC911 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB85C\\n\uB4F1\uAD50\uD574 \uBCF4\uB294 \uAC74 \uCC98\uC74C\uC774\uB77C \uB9CE\uC774 \uB180\uB790\uC9C0?",
  "\uCC54\uD53C\uC5B8\uC774 \uB41C \uAC70 \uCD95\uD558\uD574!\\n\uCE74\uC9C0\uB97C \uC774\uAE30\uB2E4\uB2C8 \uAD49\uC7A5\uD55C\uB370!",
  "\uB124\uAC00 \uC628 \uB4A4\uB85C\\n\uC544\uCE74\uB370\uBBF8\uAC00 \uB354 \uD65C\uAE30\uCC28\uAC8C \uBC14\uB00C\uC5C8\uC5B4!",
  "\uB2E4\uC74C \uC218\uC5C5\uC740\\n\uC5B4\uB290 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C \uD558\uB354\uB77C?",
  "\uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uC5D0 \uAC08 \uB54C\\n\uC637\uC744 \uB450\uAECD\uAC8C \uC785\uC9C0 \uC54A\uC73C\uBA74 \uAC10\uAE30\uC5D0 \uAC78\uB9B4 \uAC70\uC57C.",
  "\uAD50\uD658 \uD559\uC0DD\uC73C\uB85C \uC654\uB2E4\uB294 \uAC8C \uB108\uC57C?\\n\uBCC4\uB85C \uAC15\uD574 \uBCF4\uC774\uC9C0\uB294 \uC54A\uB124.",
  "\uBC30\uD2C0 \uC2E4\uB825\uC774 \uC5C6\uC73C\uBA74\\n\uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C \uBC84\uD2F0\uAE30 \uD798\uB4E4\uAC78?",
  "\uB108, \uAC89\uBCF4\uAE30\uC640\uB294 \uB2E4\uB974\uAC8C \uAC15\uD558\uAD6C\uB098!",
  "\uCC9C\uD558\uC758 \uC81C\uBE48\uC744 \uC774\uAE34 \uCE74\uC9C0\uAC00 \uC9C0\uB2E4\uB2C8...",
  "\uB098\uB3C4 \uB108\uCC98\uB7FC\\n\uC9C0\uAE08\uBCF4\uB2E4 \uB354 \uAC15\uD574\uC9C0\uACE0 \uC2F6\uC5B4.",
  "\uD314\uB370\uC544\uC5D0\uB294 \uB108\uCC98\uB7FC\\n\uAC15\uD55C \uC0AC\uB78C\uB4E4\uC774 \uB9CE\uAD6C\uB098!",
  "\uBAAC\uC2A4\uD130\uBCFC\uC740\\n\uC544\uBB34\uB9AC \uB9CE\uC544\uB3C4 \uBD80\uC871\uD55C \uAC83 \uAC19\uC544!",
  "\uBE14\uB8E8\uB808\uD06C\uB85C BP\uB97C \uBAA8\uC73C\uBA74\\n\uC88B\uC740 \uBCFC\uC744 \uC0B4 \uC218 \uC788\uC5B4!",
  "\uC785\uAD6C \uB85C\uBE44\uC758 \uBC30\uD2C0\uCF54\uD2B8\uB294\\n\uBE14\uB8E8\uBCA0\uB9AC\uADF8\uC758 \uACF5\uC2DD \uC2DC\uD569\uC5D0 \uC0AC\uC6A9\uD558\uACE0 \uC788\uC5B4!\\c\\n\uCC54\uD53C\uC5B8\uC804\uC774 \uC5F4\uB9AC\uBA74\\n\uAD00\uAC1D\uC11D\uC774 \uAD00\uC911\uC73C\uB85C \uAC00\uB4DD \uCC2C\uB2E4\uAD6C!",
  "\uD0C0\uB85C\uC640\uC758 \uC2B9\uBD80\uB294 \uC798 \uBD24\uC5B4!\\n\uBCF8 \uC801 \uC5C6\uB294 \uD3EC\uCF13\uBAAC\uB3C4 \uC4F0\uB354\uB77C!",
  "\uCC54\uD53C\uC5B8\uC804\uC5D0\uC11C\uB294 \uAD49\uC7A5\uD588\uC5B4!\\n\uCE74\uC9C0\uB294 \uC0AC\uCC9C\uC655\uC73C\uB85C \uAC15\uB4F1\uB418\uB294 \uAC74\uAC00?",
  "\uCE74\uC9C0\uC640\uC758 \uC2B9\uBD80\uB294 \uC798 \uBD24\uC5B4!\\n\uCE74\uC9C0... \uBB54\uAC00 \uC2AC\uD37C \uBCF4\uC774\uB354\uB77C.",
  "\uB098\uB3C4 \uCC54\uD53C\uC5B8\uC744 \uBAA9\uD45C\uB85C\\n\uC9C0\uAE08\uBCF4\uB2E4 \uB354 \uB178\uB825\uD560 \uAC70\uC57C!",
  "\uB108\uC758 \uC2B9\uBD80\uB97C \uBCF8 \uB4A4\uB85C\\n\uD32C\uC774 \uB418\uC5B4 \uBC84\uB838\uC5B4!",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uB294\\n\uB354\uBE14\uBC30\uD2C0\uC774 \uC8FC\uB958\uC57C.\\c\\n...\uC804\uB7B5\uC758 \uD3ED\uC774 \uB113\uC5B4\uC838\uC11C \uADF8\uB7F0 \uAC70 \uC544\uB2D0\uAE4C?",
  "\uC0AC\uBC14\uB098 \uC5D0\uB9AC\uC5B4\uC5D0\uC11C\\n\uBFD4\uCE74\uB178\uB97C \uC7A1\uC544 \uBCF4\uB294 \uAC74 \uC5B4\uB5A0\uB2C8!",
  "\uBC14\uC704\uD0C0\uC785 \uC5F0\uAD6C 2\uAC00\\n\uC5B4\uB824\uC6CC\uC11C \uC774\uD574\uAC00 \uC798 \uC548 \uB3FC\uC694...",
  "\uD50C\uB7EC\uC2DC\uC758 \uD2B9\uC131\uC740 \uD50C\uB7EC\uC2A4!\\c\\n\uB9C8\uC774\uB18D\uACFC \uD568\uAED8 \uC788\uC73C\uBA74\\n\uD2B9\uC218\uACF5\uACA9\uC774 \uAC15\uD574\uC838!",
  "\uD0C0\uC785 \uC0C1\uC131\uC744 \uBAB0\uB77C\uC11C\\n\uBC30\uD2C0 \uC911\uC5D0 \uBA54\uBAA8\uB97C \uBCF4\uAC8C \uB3FC\uC694...",
  "\uB0A0\uC528\uAC00 \uCD94\uC6CC\uC9C0\uBA74 \uD654\uCD08\uAC00 \uC2DC\uB4DC\uB2C8\uAE4C\\n\uC5BC\uC74C\uD0C0\uC785\uC740 \uD480\uD0C0\uC785\uC5D0 \uAC15\uD558\uB2E4!\\c\\n\uC774\uB7F0 \uC2DD\uC73C\uB85C \uC5F0\uC0C1\uD558\uBA74\\n\uD0C0\uC785 \uC0C1\uC131\uC744 \uC678\uC6B0\uAE30 \uC26C\uC6B8 \uAC70\uC57C!",
  "\uC774 \uAD50\uC2E4\uC740 \uBC14\uB2F7\uC18D\uC5D0 \uC788\uC5B4!\\c\\n\uBAA8\uB2C8\uD130\uB97C \uD1B5\uD574 \uD558\uB298\uC744 \uBE44\uCDB0\uC11C\\n\uB2F5\uB2F5\uD568\uC744 \uC904\uC5EC \uC8FC\uACE0 \uC788\uC9C0.",
  "\uD604\uC2E4 \uC138\uACC4\uAC00 \uBC24\uC774\uBA74\\n\uB3D4 \uB0B4\uBD80\uB3C4 \uBC24\uD558\uB298\uB85C \uBC14\uB00C\uC5B4.\\r\\n\uD604\uC2E4 \uC2DC\uAC04\uACFC \uC5F0\uB3D9\uB418\uC5B4 \uC788\uB098 \uBD10.",
  "\uC2DC\uC720\uB294 \uC81C\uBA4B\uB300\uB85C\uAE34 \uD558\uC9C0\uB9CC\\n\uC5B4\uCA50\uC9C0 \uBBF8\uC6CC\uD560 \uC218 \uC5C6\uB2E8 \uB9D0\uC774\uC9C0~",
  "\uC6B0\uB9AC \uBC18\uC5D0\uB294\\n\uD559\uC0DD\uD68C\uC7A5\uC778 \uB124\uB9AC\uB124\uB791\\r\\n\uB9D0\uAD04\uB7C9\uC774 \uC2DC\uC720\uAC00 \uC788\uC5B4.",
  "\uC81C\uC790\uB9AC\uC5D0\uC11C \uBE59\uAE00\uBE59\uAE00 \uB3CC\uB2E4 \uBCF4\uBA74\\n\uC5C4\uCCAD\uB098\uAC8C \uBE60\uB974\uAC8C \uB3CC \uC218 \uC788\uB2E4\uB294 \uAC70 \uC54C\uC544?",
  "\uB3D4 \uC548\uC5D0\uB294\\n\uD56D\uC0C1 \uC0B0\uB4E4\uBC14\uB78C\uC774 \uBD80\uB294 \uCD08\uC6D0\uC774 \uC788\uC5B4.\\r\\n\uAC70\uAE30\uC11C \uBE59\uAE00\uBE59\uAE00 \uB3CC\uBA74 \uC7AC\uBC0C\uC744 \uAC83 \uAC19\uC544.",
  "\uCD08\uC6D0\uC744 \uAC77\uACE0 \uC788\uC5C8\uB294\uB370\\n\uC5B4\uB514\uC120\uAC00 \uBC14\uB78C\uC774 \uBD88\uB354\uB2C8\\r\\n\uC54C \uC218 \uC5C6\uB294 \uB178\uB7AB\uC18C\uB9AC\uAC00 \uB4E4\uB838\uC5B4.",
  "\uB098\uB294 \uB098\uC911\uC5D0\\n\uD504\uB80C\uB4E4\uB9AC\uC20D\uC5D0\uC11C \uC77C\uD558\uACE0 \uC2F6\uC5B4\uC11C\\r\\n\uC778\uAE30 \uC788\uB294 \uB3C4\uAD6C\uB97C \uC870\uC0AC\uD558\uACE0 \uC788\uC5B4.",
  "\uD3EC\uCF13\uBAAC\uC758 \uC720\uC2E4\uBB3C\uC774 \uC5C6\uC5B4\uB3C4\\nBP\uB9CC \uC788\uC73C\uBA74 \uAE30\uC220\uBA38\uC2E0\uC744 \uC0B4 \uC218 \uC788\uC5B4\uC11C \uD3B8\uD574!",
  "\uD3EC\uCF13\uBAAC\uC758 \uAE30\uC220 \u201C\uB3C4\uC6B0\uBBF8\u201D!\\n\uB354\uBE14\uBC30\uD2C0\uC5D0\uC11C \uD06C\uAC8C \uD65C\uC57D\uD560 \uC218 \uC788\uC5B4!",
  "\uBCFC\uC774\uB098 \uC0C1\uCC98\uC57D\uC740\\n\uB3D4 \uC548\uC5D0 \uC788\uB294 \uC790\uB3D9\uD310\uB9E4\uAE30\uC5D0\uC11C \uC0B4 \uC218 \uC788\uC5B4.",
  "\uBCF5\uD569\uAE08\uC18D\uC740\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC4F0\uB294 \uAC78\uAE4C?\\r\\n\uAE08\uC18D \uB290\uB08C\uC758 \uD3EC\uCF13\uBAAC\uD55C\uD14C \uC4F0\uBA74 \uB418\uB824\uB098?",
  "\uC2DD\uB2F9 \uC74C\uC2DD \uB9D0\uC774\uC57C, \uC790\uADF9\uC801\uC778 \uB9DB\uC774\uAE34 \uD558\uC9C0\uB9CC\\n\uC2DD\uC0AC \uD30C\uC6CC\uAC00 \uBAA8\uB4E0 \uD0C0\uC785\uC5D0 \uD6A8\uACFC \uC788\uC73C\uB2C8\uAE4C\\r\\nBP\uAC00 \uC788\uC73C\uBA74 \uD55C\uBC88 \uBA39\uC5B4 \uBD10!",
  "\uD53C\uD06C\uB2C9\uC744 \uD560 \uAC70\uB77C\uBA74\\n\uCE90\uB2C8\uC5B8 \uC5D0\uB9AC\uC5B4\uAC00 \uC81C\uACA9\uC774\uC57C!\\r\\n\uB124\uB9AC\uB124 \uB2D8\uC758 \uC601\uC5ED\uC774\uAE30\uB3C4 \uD558\uACE0!",
  "\uC0CC\uB4DC\uC704\uCE58\uB97C \uBA39\uC744 \uAC70\uB77C\uBA74\\n\uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4\uAC00 \uB531\uC774\uC57C!\\r\\n\uD0C0\uB85C\uC758 \uC2A4\uD018\uC5B4\uB3C4 \uC788\uAC70\uB4E0!",
  "\uC0AC\uCC9C\uC655\uACFC \uC2F8\uC6B0\uB824\uBA74\\n\uC0AC\uCC9C\uC655 \uCC4C\uB9B0\uC9C0\uB97C \uD074\uB9AC\uC5B4\uD574\uC57C \uD574.",
  "\uB098, \uB192\uC740 \uACF3\uC774 \uBB34\uC11C\uC6CC\uC11C\\n\uB124\uB9AC\uB124\uC758 \uCC4C\uB9B0\uC9C0\uB294 \uBABB \uD558\uACA0\uC5B4...",
  "\uC0AC\uCC9C\uC655 \uC911\uC5D0\uC11C\uB294 \uC81C\uBE48\uC774 \uC88B\uC544!\\n\uC758\uC695 \uC5C6\uC5B4 \uBCF4\uC774\uBA74\uC11C\uB3C4 \uAC15\uD558\uC796\uC544!",
  "\uC0AC\uCC9C\uC655 \uD558\uC194\uC774\uB77C\uB294 \uC560 \uC788\uC796\uC544.\\n\uC0B4\uC9DD \uB9F9\uD55C \uAD6C\uC11D\uC774 \uC788\uC5B4\uC11C \uADC0\uC5EC\uC6B4 \uAC83 \uAC19\uC544!",
  "\uB35C\uB35C... \uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uC5D0 \uB2E4\uB140\uC654\uB354\uB2C8\\n\uBAB8\uC774 \uAF41\uAF41 \uC5BC\uC5C8\uC5B4.\\r\\n\uB530\uB73B\uD574\uC9C0\uAC8C \uD53C\uC790\uB098 \uBA39\uC5B4\uC57C\uC9C0!",
  "\uC2DD\uB2F9 \uBA54\uB274\uB294 \uC804\uBD80\\n\uAD50\uC7A5 \uC120\uC0DD\uB2D8\uC774 \uC88B\uC544\uD558\uB294 \uAC83\uB4E4\uC774\uC57C!\\c\\n\uC601\uC591 \uBC38\uB7F0\uC2A4\uB294 \uB098\uBE60 \uBCF4\uC774\uC9C0\uB9CC\\n\uC2DD\uC0AC \uD30C\uC6CC\uB294 \uAD49\uC7A5\uD558\uB2E4\uACE0!",
  "\uB0B4 \uBC30\uB8E8\uD0A4\uB294\\n\uB7F0\uB2DD\uBA38\uC2E0\uC744 \uC88B\uC544\uD574!",
  "\uB098\uB294 \uD53C\uCE74\uCE04\uB791\\n\uBE14\uB8E8\uBCA0\uB9AC\uADF8\uC5D0 \uB3C4\uC804\uD558\uACE0 \uC788\uC5B4!",
  "\uBD80\uC2E4\uC774 \uBC88\uCA4D\uBC88\uCA4D\uD574\uC11C\\n\uB098\uC639\uC774 \uAE30\uBED0\uD558\uACE0 \uC788\uC5B4!",
  "\uB098\uC639\uC740 \uC190\uD1B1\uC744 \uC138\uC6B4 \uCC44\\n\uD55C\uAECF \uB4E4\uB5A0 \uC788\uB2E4!",
  "\uD32C\uC2DC\uD55C \uBD80\uC2E4\uC774\uB124!\\n\uD0C0\uB85C\uAC00 \uC88B\uC544\uD560 \uAC83 \uAC19\uC544!",
  "\uC774 \uBC29\uC774\uB791 \uBA54\uD0D5\uAD6C...\\n\uBB54\uAC00 \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uAC83 \uAC19\uC544!",
  "\uC9C4\uC9DC \uBA4B\uC9C4 \uBD80\uC2E4\uC774\uC57C!\\n\uBBF8\uC220\uBD80 \uC560\uB4E4 \uAD49\uC7A5\uD558\uB2E4!",
  "\uC800, \uC800\uAC70 \uC124\uB9C8\\n\uC601\uD654\uC5D0 \uB098\uC624\uB294 \uC218\uC218\uAED8\uB07C\uC758 \uC6D0\uBC18 \uC544\uB2C8\uC57C!?",
  "\uAD6C\uBA4D \uD30C\uB294 \uAC78 \uC88B\uC544\uD560 \uAC83 \uAC19\uC740 \uD3EC\uCF13\uBAAC\uC774\\n\uBC29\uC5D0 \uC794\uB729 \uC788\uB124...",
  "\uC904\uBBA4\uB9C8\uAC00 \uD751\uBC31\uC73C\uB85C \uB41C \uBC29\uC5D0 \uC788\uC73C\uB2C8\uAE4C\\n\uC798 \uC548 \uBCF4\uC774\uC796\uC544! \uADC0\uC5EC\uC6CC~!",
  "\uADF8\uAC70 \uC544\uB2C8? \uBB34\uC7A5\uC870\uB294\\n\uC57D\uC810\uC774 \uC801\uC5B4\uC11C \uC0C1\uB300\uD558\uAE30 \uAE4C\uB2E4\uB86D\uB300!",
  "\uBD80\uC2E4\uC774 \uC790\uC5F0\uC5D0 \uB458\uB7EC\uC2F8\uC600\uB124!\\n\uD480\uD3EC\uCF13\uBAAC\uB4E4\uB3C4 \uAE30\uC05C\uAC00 \uBD10!",
  "\uBD80\uC2E4\uC744 \uC5B4\uB460\uC758 \uB2E4\uD06C\uB85C\\n\uBB3C\uB4E4\uC5EC \uC918\uC11C \uACE0\uB9C8\uC6CC...\\r\\n\uC5B4\uB450\uC6CC\uC9C4 \uB355\uC5D0 \uC880 \uD3B8\uD574\uC84C\uC5B4..."
]
