  "\uAE00\uC384...[VAR 0114(0041)]",
  "\uC800\uAE30, \uBE4C\uB9AC\uC624...\\n\uC774\uCABD\uC5D0 \uC788\uB294 \uC11C\uBBFC\uC774 \uC6B0\uB9B4 \uBCF4\uACE0 \uC788\uB294\uB370...?[VAR 0114(0041)]",
  "\uC751? \uC11C\uBBFC\uC774?[VAR 0114(0040)]",
  "\uC815\uB9D0\uC774\uAD70!\\n\uC774\uAC74 \uD2C0\uB9BC\uC5C6\uB294 \uC11C\uBBFC\uC774\uC57C![VAR 0114(0040)]",
  "\uC11C\uBBFC...!?\\n\uC2DC, \uC2E4\uBB3C\uC744 \uBCF4\uAC8C \uB420 \uC904\uC774\uC57C...![VAR 0114(0041)]",
  "\uC5B4, \uC5B4\uCA4C\uC9C0 \uBE4C\uB9AC\uC624!?\\n\uC545\uC218\uB97C \uCCAD\uD558\uBA74 \uC2E4\uB840\uC77C\uAE4C!?\\r\\n\uC0AC\uC778\uC740 \uBC1B\uC544\uB3C4 \uB418\uACA0\uC9C0!?[VAR 0114(0041)]",
  "\uC9C4\uC815\uD574, \uB098\uB9AC\uC544!\\n\uC11C\uBBFC\uC740 \uB3C4\uB9DD\uAC00\uC9C0 \uC54A\uB294\uB2E4\uACE0![VAR 0114(0040)]",
  "\uBBF8, \uBBF8\uC548...\\n\uC11C\uBBFC\uC744 \uC2E4\uC81C\uB85C \uBCF8 \uC77C\uC774 \uAC70\uC758 \uC5C6\uC5B4\uC11C...[VAR 0114(0041)]",
  "\uADF8\uB7F4 \uC218\uBC16\uC5D0...\\n\uB098\uB9AC\uC544\uB294 \uBD80\uB3D9\uC0B0 \uD68C\uC0AC\uC778\\r\\n\uD314\uB370\uC544 \uC5D0\uC2A4\uD14C\uC774\uD2B8\uC758 \uC0AC\uC7A5\uC774\uB2C8\uAE4C.[VAR 0114(0040)]",
  "\uC800\uC5B4... \uC11C\uBBFC\uB2D8...?[VAR 0114(0041)]",
  "\uAD1C\uCC2E\uC73C\uC2DC\uB2E4\uBA74 \uC800\uC640\\n\uD3EC\uCF13\uBAAC\uC73C\uB85C \uACB0\uD22C\uD574 \uC8FC\uC2DC\uACA0\uC5B4\uC694?[VAR 0114(0041)]",
  "\uB9CC\uC57D \uC800\uB97C \uC774\uAE30\uC2E0\uB2E4\uBA74\\n\uB9C9\uB300\uD55C \uBD80\uB97C \uB4DC\uB9AC\uB3C4\uB85D \uD558\uC8E0.[VAR 0114(0041)]",
  "\uB098... \uB098\uC654\uB2E4!\\n\uB098\uB9AC\uC544\uC758 \uCDE8\uBBF8![VAR 0114(0040)]",
  "\uC11C\uBBFC\uC5D0\uAC8C \uC77C\uD655\uCC9C\uAE08\uC758 \uAE30\uD68C \uC8FC\uAE30![VAR 0114(0040)]",
  "\uC624~\uD638\uD638\uD638... \uAC01\uC624\uAC00 \uB418\uC168\uB2E4\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694, \uC11C\uBBFC\uB2D8.[VAR 0114(0041)]",
  "\uB9C9\uB300\uD55C \uBD80\uB97C \uC6D0\uD55C\uB2E4\uBA74\\n\uC11C\uBBFC\uB2F5\uAC8C \uB098\uB9AC\uC544\uC5D0\uAC8C \uB9D0\uC744 \uAC78\uB77C\uACE0![VAR 0114(0040)]",
  "\uB9C9\uB300\uD55C \uBD80\uB97C \uAC78\uACE0\\n\uC800\uC640 \uACB0\uD22C\uD558\uC2DC\uACA0\uC5B4\uC694?[VAR 0114(0041)]",
  "...\uAC00\uB054\uC740 \uC11C\uBBFC \uB54C\uBB38\uC5D0\\n\uC560\uD0DC\uC6B0\uB294 \uAC83\uB3C4 \uB098\uC058\uC9C0 \uC54A\uC9C0\uB9CC,\\c\\n\uC140\uB7FD\uC758 \uC2DC\uAC04\uC740 \uC18C\uC911\uD558\uB2F5\uB2C8\uB2E4!\\n\uC790! \uC9C0\uAE08 \uBC14\uB85C \uC2DC\uC791\uD558\uC2DC\uC8E0!![VAR 0114(0041)]",
  "\uD314\uB370\uC544 \uC5D0\uC2A4\uD14C\uC774\uD2B8\uC758 \uC0AC\uC7A5\uC778 \uC800 \uB098\uB9AC\uC544\uAC00!\\n\uC11C\uBBFC\uB2D8\uC744 \uC9D3\uBC1F\uC544 \uB4DC\uB9AC\uACA0\uC5B4\uC694! \uC624~\uD638\uD638\uD638![VAR 0114(0041)]",
  "\uC720\uD6C4~!\\n\uB098\uB9AC\uC544, \uD30C\uC774\uD305![VAR 0114(0040)]",
  "\uB2F9\uC2E0, \uAD49\uC7A5\uD558\uB124\uC694!\\n\uC5C4\uCCAD\uB09C \uC11C\uBBFC\uC774\uC168\uAD70\uC694![VAR 0114(0041)]",
  "\uC720\uD6C4~!\\n\uC6B0\uB9AC \uB098\uB9AC\uC544\uB294 \uC9C4 \uBAA8\uC2B5\uB3C4 \uADC0\uC5FD\uB2E4\uB2C8\uAE4C![VAR 0114(0040)]",
  "\uC798 \uB4E4\uC73C\uC138\uC694, \uC11C\uBBFC\uB2D8.\\n\uB3C8\uC740 \uC5B4\uB5BB\uAC8C \uC4F0\uB294\uAC00\uAC00 \uAC00\uC7A5 \uC911\uC694\uD574\uC694.[VAR 0114(0041)]",
  "\uBC29\uAE08 \uB4DC\uB9B0 \uC0C1\uAE08\uC740\\n\uC778\uC0DD\uC5D0 \uB3C4\uC6C0\uC774 \uB418\uB294 \uACF3\uC5D0...\\r\\n\uC790\uC2E0\uC744 \uC704\uD55C \uD22C\uC790\uC5D0 \uC4F0\uB3C4\uB85D \uD558\uC138\uC694.[VAR 0114(0041)]",
  "\uADF8\uB807\uAC8C \uD558\uBA74 \uB3C8\uC740 \uC0AC\uB77C\uC838\uB3C4\\n\uC7AC\uC0B0\uC774 \uB418\uC5B4 \uACC4\uC18D \uBE5B\uB0A0 \uD14C\uB2C8\uAE4C\uC694![VAR 0114(0041)]",
  "\uAC00\uC790, \uBE4C\uB9AC\uC624!\\n\uB098, \uC9C0\uAE08 \uB2F9\uC7A5 \uD314\uB370\uC544\uC5D0 \uC788\uB294\\r\\n[VAR FF00(0006)]\uADF8 \uD3ED\uD3EC[VAR FF00(0000)]\uAC00 \uBCF4\uACE0 \uC2F6\uC5B4\uC84C\uC5B4![VAR 0114(0041)]",
  "\uC720\uD6C4~! \uBD81\uC2E0\uC5D0 \uC628 \uC9C0\\n\uC5BC\uB9C8 \uB418\uC9C0\uB3C4 \uC54A\uC558\uB294\uB370 \uBC8C\uC368 \uB3CC\uC544\uAC00\uC790\uB2C8!\\r\\n\uC5ED\uC2DC \uC6B0\uB9AC \uB098\uB9AC\uC544\uB294 \uC140\uB7FD\uC758 \uADC0\uAC10\uC774\uB77C\uB2C8\uAE4C![VAR 0114(0040)]",
  "\uC544\uC544... \uB098\uB9AC\uC544 \uB2D8\uACFC \uBE4C\uB9AC\uC624 \uB2D8\uC740\\n\uB300\uCCB4 \uC5B4\uB514\uB85C \uAC00\uC2E0 \uAC70\uC9C0?",
  "\u201C\uC544\uB984\uB2E4\uC6B4 \uC804\uC6D0 \uD48D\uACBD\uC744\\n \uAC10\uC0C1\uD560 \uC218 \uC788\uB294 \uACF3\uC5D0 \uAC08 \uAC70\uC57C!\u201D\\c\\n\uC774\uB807\uAC8C \uB9D0\uC500\uD558\uC2DC\uB294 \uAC74 \uB4E4\uC5C8\uB294\uB370...\\n\uADF8\uAC8C \uB300\uCCB4 \uC5B4\uB514\uC9C0?"
