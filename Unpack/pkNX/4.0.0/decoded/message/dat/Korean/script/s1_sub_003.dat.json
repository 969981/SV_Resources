[
  "\uC624~\uD638\uD638\uD638!\\n\uC624~\uD638\uD638\uD638![VAR 0114(002C)]",
  "\uC74C~ \uC628\uBAB8\uC73C\uB85C \uB290\uAEF4\uC9C0\uB294 \uC774 \uC74C\uC774\uC628!\\n\uBD81\uC2E0\uC758 \uACF5\uAE30\uB97C \uBABD\uB545 \uC0AC\uB4E4\uC774\uACE0 \uC2F6\uC744 \uC815\uB3C4\uC57C![VAR 0114(002C)]",
  "\uC624~ \uC5ED\uC2DC \uB098\uC758 \uB098\uB9AC\uC544! \uC774\uB7F0 \uC2DC\uACE8\uC5D0 \uC640\uC11C\uB3C4\\n\uBC1C\uC0C1\uC774 \uC815\uB9D0 \uB3C4\uC2DC\uC801\uC774\uB77C\uB2C8\uAE4C![VAR 0114(002C)]",
  "\uC624~ \uBE4C\uB9AC\uC624!\\n\uB4E3\uAE30 \uC88B\uC740 \uC9C4\uC2E4, \uB561\uD050![VAR 0114(0041)]",
