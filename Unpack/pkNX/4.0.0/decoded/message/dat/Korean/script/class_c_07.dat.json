[
  "\uC548\uB155, \uC598\uB4E4\uC544?\\n\uB2E4\uB4E4 \uC5B4\uC81C\uBCF4\uB2E4 \uD558\uB8E8 \uC624\uB798\uB418\uC5C8\uAD6C\uB098.[VAR 0114(0027)]",
  "\uC624\uB298\uC774 \uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC774\uB124.\\n\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC5ED\uC0AC\uC758 \uD6CC\uB96D\uD568\uC5D0 \uB300\uD574\\r\\n\uD568\uAED8 \uC54C\uC544 \uAC00 \uBCF4\uB3C4\uB85D \uD560\uAE4C?[VAR 0114(0027)]",
  "\uC9C0\uB09C \uC218\uC5C5\uC5D0\uC11C\uB294 200\uB144 \uC804\uC5D0 \uC788\uC5C8\uB358\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uAD00\uCE21\uB300\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD588\uC9C0?[VAR 0114(0027)]",
  "\uC544\uC544... \uAC00\uB974\uCCD0 \uC904 \uB0B4\uC6A9\uC774\\n\uD604\uB300\uC5D0 \uAC00\uAE4C\uC6CC\uC838 \uBC84\uB838\uB124...[VAR 0114(0027)]",
  "\uC5ED\uC0AC \uC218\uC5C5\uC740 \uC9C4\uB3C4\uB97C \uB098\uAC08\uC218\uB85D\\n\uBBF8\uB798\uB97C \uD5A5\uD558\uAC8C \uB418\uB294 \uAC8C \uC544\uC27D\uB2E8 \uB9D0\uC774\uC9C0.[VAR 0114(0027)]",
  "\uD604\uB300\uC5D0\uC11C \uACFC\uAC70\uB85C\\n\uC2DC\uAC04\uC744 \uAC70\uC2AC\uB7EC \uC62C\uB77C\uAC00\uB294 \uCABD\uC774\\r\\n\uD6E8\uC52C \uB354 \uB0AD\uB9CC \uC788\uC9C0 \uC54A\uC544!?[VAR 0114(0027)]",
  "\uB9DE\uC544\uC694!",
  "\uBAA8\uB974\uACA0\uC5B4\uC694...",
  "[VAR 0100(0000)][VAR 1900(0001)] \uC774\uD574\uAC00 \uAC00\uB294 \uBAA8\uC591\uC774\uAD6C\uB098!\\c\\n\uADF8\uB807\uC9C0\uB9CC, \uC9C0\uB3C4 \uC694\uB839\uC744 \uB530\uB974\uC9C0 \uC54A\uC73C\uBA74\\n\uAD50\uC7A5 \uC120\uC0DD\uB2D8\uAED8 \uD63C\uB098\uB294 \uAC83\uB3C4 \uD604\uC2E4\uC774\uC9C0...[VAR 0114(0027)]",
  "\uADF8\uB7F4 \uC218\uB3C4 \uC788\uACA0\uB124... \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB098\uC11C\\n\uB2E4\uC74C\uC5D0 \uC774\uB7F0 \uC77C\uC774 \uC77C\uC5B4\uB0AC\uB2E4\uB294\\r\\n\uD750\uB984\uC744 \uC54C\uAE30\uAC00 \uC5B4\uB824\uC6CC\uC9C8 \uD14C\uB2C8\uAE4C...[VAR 0114(0027)]",
  "\uC5B4\uCA54 \uC218 \uC5C6\uAD70...\\n\uBBF8\uB798\uB97C \uD5A5\uD574 \uBC14\uB298\uC744 \uB3CC\uB824 \uBCF4\uB3C4\uB85D \uD560\uAE4C?[VAR 0114(0027)]",
  "\uB9C8\uC9C0\uB9C9 \uC218\uC5C5\uC740 \uD14C\uB77C\uC2A4\uD0C8\uC758\\n\uC5ED\uC0AC\uC5D0 \uB300\uD574 \uBC30\uC6CC \uBCF4\uB3C4\uB85D \uD558\uC790.[VAR 0114(0027)]",
  "\uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uB294 \uC0AC\uC2E4\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0\uC11C \uD0DC\uC5B4\uB09C \uAE30\uC220\uC774\uC57C.[VAR 0114(0027)]",
  "\uAD00\uCE21\uB300\uAC00 \uCD5C\uC2EC\uBD80\uC5D0 \uB3C4\uB2EC\uD55C \uB4A4\uC5D0\uB3C4\\n\uC5D0\uB9AC\uC5B4 \uC81C\uB85C \uD0D0\uC0C9\uC740 \uACC4\uC18D\uB418\uC5C8\uC5B4...[VAR 0114(0027)]",
  "\uADF8\uB9AC\uACE0 \uC9C0\uAE08\uC73C\uB85C\uBD80\uD130 \uC57D 140\uB144 \uC804\uC5D0\\n\uC2E0\uBE44\uD55C \uBE5B\uC744 \uB450\uB978 \uD3EC\uCF13\uBAAC\uC774 \uBC1C\uACAC\uB418\uC5C8\uC9C0.[VAR 0114(0027)]",
  "\uB2E4\uB4E4 \uC774\uBBF8 \uC608\uC0C1\uD588\uACA0\uC9C0\uB9CC,\\n\uADF8\uAC74 \uBC14\uB85C \uD14C\uB77C\uC2A4\uD0C8\uD654\uD55C \uD3EC\uCF13\uBAAC\uC774\uC5C8\uC5B4.[VAR 0114(0027)]",
  "\uADF8 \uD3EC\uCF13\uBAAC\uB4E4\uC744 \uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0\uC11C \uB370\uB824\uC654\uC9C0\uB9CC\\n\uBAB8\uC758 \uBE5B\uC740 \uC0AC\uB77C\uC838 \uBC84\uB838\uACE0, \uC624\uB7AB\uB3D9\uC548\\r\\n\uD14C\uB77C\uC2A4\uD0C8 \uD604\uC0C1\uC740 \uC218\uC218\uAED8\uB07C\uB85C \uB0A8\uAC8C \uB418\uC5C8\uC9C0.[VAR 0114(0027)]",
  "\uADF8\uB7EC\uB2E4 10\uB144 \uC804... \uC774\uC81C\uB294 \uADFC\uB300\uAD6C\uB098.\\n\uB108\uD76C\uB3C4 \uC798 \uC544\uB294 \uD55C \uC778\uBB3C\uC774\\r\\n\uD14C\uB77C\uC2A4\uD0C8\uC758 \uC6D0\uB9AC\uB97C \uBC1D\uD600\uB0B8 \uAC70\uC57C.[VAR 0114(0027)]",
  "...\uADF8\uB7FC \uC5EC\uAE30\uC11C \uB098\uC640 \uB208\uC774 \uB9C8\uC8FC\uCE5C\\n\uBD88\uC30D\uD55C [VAR 0100(0000)]\uC5D0\uAC8C \uC9C8\uBB38 \uD558\uB098 \uD560\uAE4C?[VAR 0114(0027)]",
  "\uD14C\uB77C\uC2A4\uD0C8\uC758 \uC6D0\uB9AC\uB97C \uBC1D\uD600\uB0B8\\n\uC720\uBA85\uD55C \uBC15\uC0AC\uB2D8\uC758 \uC774\uB984\uC740 \uBB50\uC9C0?[VAR 0114(0027)]",
  "\uD5E4\uB354\uBC15\uC0AC",
  "\uC62C\uB9BC\uBC15\uC0AC",
  "\uD22C\uB85C\uBC15\uC0AC",
  "\uD074\uB77C\uBCA8\uBC15\uC0AC",
  "...\uB561!\\n\uD5E4\uB354\uB294 \uD0D0\uD5D8\uAE30\uC758 \uC800\uC790\uC600\uC796\uC544.\\r\\n\uC9C0\uB09C \uC218\uC5C5\uC774\uB791 \uC11E\uC778 \uAC83 \uAC19\uC740\uB370?[VAR 0114(0027)]",
  "...\uC815\uB2F5!\\n\uC804\uD559\uC628 \uC9C0 \uC5BC\uB9C8 \uC548 \uB41C \uB124\uAC00 \uC774\uAC78 \uC54C\uACE0 \uC788\uB2E4\uB2C8,\\r\\n\uC5F4\uC2EC\uD788 \uACF5\uBD80\uD588\uB098 \uBCF4\uAD6C\uB098.[VAR 0114(0027)]",
  "\uB561... \uC544\uB2C8,\\n\uC5B4\uB5A4 \uC758\uBBF8\uB85C\uB294 \uC815\uB2F5\uC774\uAE30\uB3C4 \uD558\uB824\uB098...?[VAR 0114(0027)]",
  "\uC9C0\uAE08\uC73C\uB85C\uBD80\uD130 \uC57D 10\uB144 \uC804\uC5D0 \uC62C\uB9BC\uBC15\uC0AC\uB77C\uB294\\n\uC0AC\uB78C\uC774 \uD14C\uB77C\uC2A4\uD0C8 \uD604\uC0C1\uC758 \uC6D0\uB9AC\uB97C \uBC1D\uD600\uB0C8\uC5B4.[VAR 0114(0027)]",
  "\uC9C0\uAE08\uC73C\uB85C\uBD80\uD130 \uC57D 10\uB144 \uC804\uC5D0 \uD22C\uB85C\uBC15\uC0AC\uB77C\uB294\\n\uC0AC\uB78C\uC774 \uD14C\uB77C\uC2A4\uD0C8 \uD604\uC0C1\uC758 \uC6D0\uB9AC\uB97C \uBC1D\uD600\uB0C8\uC5B4.[VAR 0114(0027)]",
  "\uADF8\uB140\uB294 \uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0 \uC874\uC7AC\uD558\uB294\\n\uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uB294 \uACB0\uC815...\\r\\n\uAC70\uAE30\uC5D0\uC11C \uB098\uC624\uB294 \uC5D0\uB108\uC9C0\uAC00 \uD3EC\uCF13\uBAAC\uC744\\r\\n\uD14C\uB77C\uC2A4\uD0C8\uC2DC\uD0A8\uB2E4\uB294 \uAC83\uC744 \uBC1D\uD600\uB0C8\uACE0,[VAR 0114(0027)]",
  "\uADF8\uB294 \uC5D0\uB9AC\uC5B4 \uC81C\uB85C\uC5D0 \uC874\uC7AC\uD558\uB294\\n\uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uB294 \uACB0\uC815...\\r\\n\uAC70\uAE30\uC5D0\uC11C \uB098\uC624\uB294 \uC5D0\uB108\uC9C0\uAC00 \uD3EC\uCF13\uBAAC\uC744\\r\\n\uD14C\uB77C\uC2A4\uD0C8\uC2DC\uD0A8\uB2E4\uB294 \uAC83\uC744 \uBC1D\uD600\uB0C8\uACE0,[VAR 0114(0027)]",
  "\uD14C\uB77C\uC2A4\uD0C8\uC624\uBE0C\uB97C \uBC1C\uBA85\uD574\uC11C\\n\uAE30\uC220\uC744 \uC2E4\uC6A9\uD654\uD558\uB294 \uB370 \uC131\uACF5\uD588\uC5B4.\\c\\n\uADF8\uB9AC\uACE0 \uADF8\uAC83\uC744 \uD3EC\uCF13\uBAAC\uB9AC\uADF8\uB098\\n\uD559\uAD50\uC5D0 \uC81C\uACF5\uD558\uACE0 \uC788\uC9C0.[VAR 0114(0027)]",
  "...\uC18C\uBB38\uC5D0 \uC758\uD558\uBA74, \uD074\uB77C\uBCA8 \uC120\uC0DD\uB2D8\uB3C4\\n\uAC19\uC740 \uD300\uC5D0\uC11C \uC5F0\uAD6C\uB97C \uD588\uB2E4\uB294 \uAC83 \uAC19\uC544.[VAR 0114(0027)]",
  "\uC544\uB294 \uC778\uBB3C\uC774 \uB098\uC624\uAE30 \uC2DC\uC791\uD558\uBA74\\n\uB0AD\uB9CC\uC774 \uAE08\uC138 \uC0AC\uB77C\uC838 \uBC84\uB9B0\uB2E4\uB2C8\uAE4C...\\r\\n\uC5ED\uC2DC \uADFC\uB300\uC0AC\uB294 \uC7AC\uBBF8\uC5C6\uB2E8 \uB9D0\uC774\uC9C0.[VAR 0114(0027)]",
  "\uC774\uAC78\uB85C \uC5ED\uC0AC \uC218\uC5C5\uC740 \uB05D\uC774\uC57C.\\n\uB2E4\uC74C \uC2DC\uAC04\uC5D0\uB294 \uAE30\uB9D0\uACE0\uC0AC\uB97C \uBCFC \uD14C\uB2C8,\\r\\n\uC624\uB798\uB41C \uC9C0\uC2DD\uB4E4\uC744 \uBD88\uB7EC\uB0B4\uC11C \uC798 \uC900\uBE44\uD558\uB834![VAR 0114(0027)]"
]
