  "\uC18D \uC7AC\uB8CC\uB97C \uC774\uB807\uAC8C \uD558\uACE0...\\n\uC870\uBBF8\uB8CC\uB97C \uC800\uB807\uAC8C \uD558\uBA74...",
  "...\uC544\uC544, \uBBF8\uC548!\\n\uC0DD\uAC01\uC744 \uC880 \uD558\uB290\uB77C!\\c\\n\uB098\uB294 \uC0CC\uB4DC\uC704\uCE58\uC758\\n\uB808\uC2DC\uD53C\uB97C \uC5F0\uAD6C\uD558\uACE0 \uC788\uC5B4.\\c\\n\uC5B8\uC820\uAC00 \uB9C8\uC2A4\uD130 \uB808\uBCA8\uC774\uB77C \uBD88\uB9AC\uB294\\n\uCD5C\uACE0\uC758 \uB808\uC2DC\uD53C\uB97C \uB9CC\uB4DC\uB294 \uAC8C \uAFC8\uC774\uAC70\uB4E0!\\c\\n\uAD1C\uCC2E\uB2E4\uBA74 \uB108\uC5D0\uAC8C\uB3C4\\n\uC0CC\uB4DC\uC704\uCE58\uC758 \uB808\uC2DC\uD53C\uB97C \uAC00\uB974\uCCD0 \uC904\uAC8C!",
  "[VAR 0100(0000)][VAR 1900(0001)] \uC0C8\uB85C\uC6B4\\n\uC0CC\uB4DC\uC704\uCE58\uB97C \uB9CC\uB4E4 \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4!",
  "[VAR 0100(0000)][VAR 1900(0001)] \uC0C8\uB85C\uC6B4 \uB9C8\uC2A4\uD130 \uB808\uBCA8\uC758\\n\uC0CC\uB4DC\uC704\uCE58\uB97C \uB9CC\uB4E4 \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4!",
  "\uAE30\uAC00 \uB9C9\uD788\uAC8C \uB9DB\uC788\uC73C\uB2C8\uAE4C\\n\uAF2D \uD55C\uBC88 \uB9CC\uB4E4\uC5B4 \uBCF4\uB834!",
  "\uB2E4\uC74C\uC5D0 \uB610\\n\uC0C8\uB85C\uC6B4 \uB808\uC2DC\uD53C\uAC00 \uB5A0\uC624\uB974\uBA74 \uAC00\uB974\uCCD0 \uC904\uAC8C!",
  "...\uC544\uC544, \uB108\uAD6C\uB098!\\n\uC0C8\uB85C\uC6B4 \uB808\uC2DC\uD53C\uAC00 \uB5A0\uC62C\uB790\uC5B4!",
  "...\uC544\uC544, \uB108\uAD6C\uB098!\\c\\n\uC9C0\uAE08 \uACE0\uC548\uD558\uACE0 \uC788\uB294 \uB808\uC2DC\uD53C\uC5D0\uB294\\n\uD76C\uADC0\uD55C \uC870\uBBF8\uB8CC\uAC00 \uD544\uC694\uD574.\\c\\n\uBE44\uC804 \uC5B4\uCA4C\uACE0 \uD558\uB294\\n\uB2E4\uC12F \uC885\uB958\uC758 \uC2A4\uD30C\uC774\uC2A4\uC57C...\\c\\n\uD55C \uBC88\uC774\uB77C\uB3C4 \uBCFC \uC218\uB9CC \uC788\uB2E4\uBA74\\n\uC0C8\uB85C\uC6B4 \uB808\uC2DC\uD53C\uAC00 \uB5A0\uC624\uB97C \uD150\uB370...",
  "\uBE44\uC804 \uC5B4\uCA4C\uACE0\uB294\\n\uB2E4\uC12F \uC885\uB958\uC758 \uC2A4\uD30C\uC774\uC2A4\uC57C...\\c\\n\uD55C \uBC88\uC774\uB77C\uB3C4 \uBCFC \uC218\uB9CC \uC788\uB2E4\uBA74\\n\uC0C8\uB85C\uC6B4 \uB808\uC2DC\uD53C\uAC00 \uB5A0\uC624\uB97C \uD150\uB370...",
  "\uB124\uAC00 \uAC00\uC9C0\uACE0 \uC788\uB294 \uADF8, \uADF8\uAC74!\\n\uBE44\uC804 \uC5B4\uCA4C\uACE0 \uC544\uB2C8\uC57C!?\\r\\n\uC73C\uC73C... \uC544, \uC544\uC544...\\r\\n\uBA38\uB9BF\uC18D\uC5D0\uC11C \uB808\uC2DC\uD53C\uAC00 \uB5A0\uC624\uB978\uB2E4~!?",
  "\uD558\uC544... \uD558\uC544...\\n\uC5C4\uCCAD\uB09C \uB808\uC2DC\uD53C\uB97C \uB9CC\uB4E4\uC5C8\uC5B4!\\r\\n\uADF8\uC57C\uB9D0\uB85C \uCD5C\uACE0\uC758 \uC0CC\uB4DC\uC704\uCE58\uC57C...!\\r\\n\uAF2D \uD55C\uBC88 \uB9CC\uB4E4\uC5B4 \uBCF4\uB834...!!",
  "\uB124 \uB355\uBD84\uC5D0 \uB9C8\uC2A4\uD130 \uB808\uBCA8\uC758 \uC0CC\uB4DC\uC704\uCE58\uB97C\\n\uBAA8\uB450 \uAD6C\uD604\uD574 \uB0BC \uC218 \uC788\uC5C8\uC5B4!\\c\\n\uB098\uC758 \uAFC8\uC744 \uC9C0\uC6D0\uD574 \uC918\uC11C\\n\uC815\uB9D0 \uACE0\uB9C8\uC6CC!",
  "\uC138\uC0C1\uC5D0\uB294 \uC544\uC9C1 \uC544\uBB34\uB3C4 \uBAA8\uB974\uB294\\n\uB9DB\uC788\uB294 \uC0CC\uB4DC\uC704\uCE58\uAC00 \uC874\uC7AC\uD560 \uAC70\uC57C!\\c\\n\uB108\uB3C4 \uC0C8\uB85C\uC6B4 \uB808\uC2DC\uD53C\uAC00 \uB5A0\uC624\uB974\uAC70\uB4E0\\n\uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uAC00\uB974\uCCD0 \uC8FC\uB834!"
]
