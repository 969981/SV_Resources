[
  "\uD559\uAD50 \uCD5C\uAC15 \uC120\uBC1C \uB300\uD68C\uC5D0\\n\uC5D4\uD2B8\uB9AC\uD558\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uCC54\uD53C\uC5B8 \uB7AD\uD06C\uC774\uC2E0\\n[VAR 0100(0000)] \uB2D8\uC774\uC2DC\uAD70\uC694!",
  "\uC5D4\uD2B8\uB9AC\uB97C \uC644\uB8CC\uD588\uC2B5\uB2C8\uB2E4.\\n\uADF8\uB7FC, \uD68C\uC7A5\uC73C\uB85C \uC774\uB3D9\uD574 \uC8FC\uC138\uC694.",
  "\uB2E4\uC2DC \uB3CC\uC544\uC628\\n\uBC30\uD2C0 \uC2A4\uCFE8 \uC6CC\uC988!!",
  "\uC790, \uADF8\uB7FC \uBC14\uB85C \uC624\uB298\uC758 \uC81C1\uB77C\uC6B4\uB4DC!\\n\uC5EC\uB7EC\uBD84\uC774 \uC8FC\uBAA9\uD574\uC57C \uD560 \uC2DC\uD569\uC740...!?",
  "\uACC4\uC18D\uD574\uC11C \uC81C2\uB77C\uC6B4\uB4DC!\\n\uBAA8\uB450\uC758 \uAD00\uC2EC\uC744 \uB044\uB294 \uC2DC\uD569\uC740...!?",
  "\uB4DC\uB514\uC5B4 \uC81C3\uB77C\uC6B4\uB4DC!\\n\uB0A8\uC740 \uD2B8\uB808\uC774\uB108\uB294 \uC55E\uC73C\uB85C 4\uBA85!",
  "\uC774\uC81C \uC55E\uC73C\uB85C\\n\uB2E8 \uD558\uB098\uC758 \uC2DC\uD569\uB9CC\uC774 \uB0A8\uC558\uC2B5\uB2C8\uB2E4...\\c\\n\uD559\uAD50 \uCD5C\uAC15\uC758 \uC774\uB984\uC744 \uB450\uACE0 \uACA8\uB8F0\\n\uCD5C\uD6C4\uC758 \uD2B8\uB808\uC774\uB108\uB294 \uC774 \uB450 \uC0AC\uB78C!!",
  "\uCC54\uD53C\uC5B8 [VAR 0100(0000)] VS...",
  "...2-G\\n\uBE44\uC804\uC758 \uC694\uB9AC\uC0AC \uD398\uD37C!",
  "...1-D\\n\uC720\uC131\uC758 \uD574\uCEE4 \uBAA8\uB780!",
  "...\uBC30\uD2C0\uD559 \uAD50\uC0AC\\n\uB728\uAC70\uC6B4 \uD53C\uAC00 \uD750\uB974\uB294 \uC6B4\uD5A5!",
  "...\uC218\uD559 \uAD50\uC0AC\\n\uC2B9\uB960\uC758 \uC218\uD559\uC790 \uD0C0\uC784!",
  "...\uC5ED\uC0AC \uAD50\uC0AC\\n\uACE0\uB300\uC758 \uD0D0\uAD6C\uC790 \uB808\uD3EC\uB974!",
  "...\uD559\uAD50 \uAC04\uD638\uC0AC\\n\uBCF4\uAC74\uC2E4\uC758 \uCC9C\uC0AC \uBBF8\uBAA8\uC0AC!",
  "...\uAC00\uC815 \uAD50\uC0AC\\n\uBB34\uC12D\uB3C4\uB85D \uAC00\uC815\uC801\uC778 \uC0AC\uB098\uC774 \uC0AC\uAD6C\uC544\uB85C!",
  "...\uC0DD\uBB3C \uAD50\uC0AC\\n\uB290\uAE0B\uD568\uC758 \uB300\uBA85\uC0AC \uC9C0\uB2C8\uC5B4!",
  "...\uC5B8\uC5B4\uD559 \uAD50\uC0AC\\n\uCEE4\uBBA4\uB2C8\uCF00\uC774\uC158\uC758 \uD654\uC2E0 \uC138\uC774\uC9C0!",
  "...\uCD5C\uAC15\uC758 \uD559\uC0DD\uD68C\uC7A5\\n\uCC54\uD53C\uC5B8 \uB124\uBAA8!",
  "...\uC544\uCE74\uB370\uBBF8 \uAD50\uC7A5\\n\uC815\uC911\uD55C \uC2E0\uC0AC \uD074\uB77C\uBCA8!",
  "...\uBBF8\uC220 \uAD50\uC0AC\\n\uD3EC\uD6A8\uD558\uB294 \uB4DC\uB798\uACE4 \uD314\uC790\uD06C!",
  "...\uC544\uCE74\uB370\uBBF8 \uC774\uC0AC\uC7A5 \uACB8\\n\uCE58\uD504 \uCC54\uD53C\uC5B8 \uD14C\uC0AC!",
  "\uC73D, [VAR 0100(0000)][VAR 1900(0006)]\uC796\uC544!\\n\uADF8\uB798\uB3C4 \uAC00\uB2A5\uC131\uC744 \uBBFF\uACE0 \uC2B9\uBD80\uD558\uACA0\uC5B4![VAR 0114(0006)]",
  "\uCCC7! \uB108\uB97C \uB9CC\uB098\uB2E4\uB2C8,\\n\uC6B4\uC774 \uB108\uBB34 \uC5C6\uB294 \uAC70 \uC544\uB0D0?[VAR 0114(0006)]",
  "\uC0AC, \uC0C1\uB300\uAC00 [VAR 0100(0000)][VAR 1900(0006)]\uB77C\uACE0 \uD574\uB3C4\\n\uBE0C\uC774\uBE0C\uC774\uB4E4\uC758 \uD798\uC73C\uB85C \uC774\uAE38 \uAC70\uC57C...![VAR 0114(0008)]",
  "\uC5ED\uC2DC [VAR 0100(0000)][VAR 1900(0001)] \uAC15\uD558\uB124...\\n\uADF8\uB798\uB3C4 \uBB54\uAC00 \uC790\uB791\uC2A4\uB7EC\uC6B4 \uAE30\uBD84\uC774\uC57C.[VAR 0114(0008)]",
  "\uC0C1\uB300\uB294 \uC804\uD559\uC0DD\uC778\uAC00!\\n\uB354\uD560 \uB098\uC704 \uC5C6\uB294 \uC0C1\uB300\uC778\uAC78![VAR 0114(0024)]",
  "\uBD84\uD558\uC9C0\uB9CC \uB098\uC758 \uD328\uBC30\uC57C!\\n\uB2E4\uC74C \uC2B9\uBD80\uB3C4 \uAC74\uD22C\uB97C \uBE4C\uAC8C![VAR 0114(0024)]",
  "\uC5B4\uBA38, [VAR 0100(0000)][VAR 1900(0006)]\uAD6C\uB098.\\n\uC0B4\uC0B4 \uBD80\uD0C1\uD560\uAC8C.[VAR 0114(0025)]",
  "\uC804\uC131\uAE30\uC77C \uB54C \uC0C1\uB300\uD574 \uBD24\uC73C\uBA74 \uC88B\uC558\uC744 \uD150\uB370~\\n\uACC4\uC18D \uC5F4\uC2EC\uD788 \uD558\uB834![VAR 0114(0025)]",
  "\uB124\uAC00 \uADF8\uB3D9\uC548 \uC313\uC544 \uC62C\uB9B0 \uC2E4\uB825\uC744\\n\uD55C\uBC88 \uD574\uB3C5\uD574 \uBCFC\uAE4C?[VAR 0114(0027)]",
  "\uC9C4 \uC0AC\uB78C\uC740 \uBB3C\uB7EC\uB0A0 \uBFD0...\\n\uB098\uB97C \uBC1C\uD310 \uC0BC\uC544 \uC655\uC88C\uC5D0 \uC624\uB974\uB3C4\uB85D \uD558\uB834![VAR 0114(0027)]",
  "\uB0B4 \uBCC4\uBA85, \uBB54\uAC00 \uCD0C\uC2A4\uB7FD\uC9C0 \uC54A\uC544...?\\n\uBB50 \uC5B4\uB54C! \uCC9C\uAD6D\uC744 \uBCF4\uC5EC \uC8FC\uACA0\uC5B4![VAR 0114(0028)]",
  "\uB2E4\uCE58\uBA74 \uCE58\uB8CC\uD574 \uC904 \uD14C\uB2C8\uAE4C\\n\uB2E4\uC74C \uC2DC\uD569\uB3C4 \uC5F4\uC2EC\uD788 \uD574~[VAR 0114(0028)]",
  "\uC0C1\uB300\uAC00 \uC790\uB124\uB77C\uB2C8 \uB354\uD560 \uB098\uC704 \uC5C6\uC774 \uC88B\uAD70.\\n\uB098\uC758 \uC2E4\uB825\uC744 \uBCF4\uC5EC \uC8FC\uB9C8![VAR 0114(0029)]",
  "\uC790\uB124\uC758 \uC2E4\uB825\uC740 \uC815\uB9D0 \uB180\uB78D\uAD70.\\n\uACFC\uC5F0 \uCC54\uD53C\uC5B8\uC774\uC57C.[VAR 0114(0029)]",
  "[VAR 0100(0000)][VAR 1900(0006)]\uB791 \uC2F8\uC6B8 \uC218 \uC788\uB2E4\uB2C8,\\n\uC601\uAD11\uC778\uB370~? \uCD5C\uC120\uC744 \uB2E4\uD574 \uBCFC\uAC8C~[VAR 0114(002A)]",
  "\uC88B\uC740 \uC2DC\uD569\uC774\uC5C8\uC5B4~\\n\uC120\uC0DD\uB2D8\uC758 \uBAAB\uAE4C\uC9C0 \uC774\uAE30\uB3C4\uB85D \uD558\uB834~[VAR 0114(002A)]",
  "\uB098\uC758 \uCE5C\uC560\uD558\uB294 [VAR 0100(0000)]~!\\nMe\uB294 \uB3C4\uB9DD\uCE58\uC9C0\uB3C4 \uC228\uC9C0\uB3C4 \uC54A\uB294\uB2E4\uAD6C~![VAR 0114(0026)]",
  "\uC138\uC774\uC9C0\uB294 \uC5EC\uAE30\uC11C \uD0C8\uB77D\uC774\uAD70! So sad~!\\n\uC544\uB514\uC624\uC2A4! \uBC14\uC774 \uBC14\uC774![VAR 0114(0026)]",
  "\uB9CC\uC138~ [VAR 0100(0000)][VAR 1900(0006)]\uC796\uC544!\\n\uC6B0\uB9AC \uB458\uC774 \uACB0\uC2B9\uC804\uC774\uB124!\\r\\n\uCC54\uD53C\uC5B8\uB07C\uB9AC \uC804\uB825\uC73C\uB85C \uC2B9\uBD80\uD574 \uBCF4\uC790![VAR 0114(0004)]",
  "[VAR 0100(0000)]! \uC2B9\uBD80\uD574 \uC918\uC11C \uACE0\uB9C8\uC6CC!\\n\uC815\uB9D0 \uC990\uAC70\uC6E0\uC5B4!\\r\\n\uADF8\uB9AC\uACE0 \uC6B0\uC2B9 \uCD95\uD558\uD574~![VAR 0114(0004)]",
  "\uC774\uBC88 \uC0C1\uB300\uB294 [VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591\uC774\uAD70\uC694.\\n\uD55C \uC0AC\uB78C\uC758 \uD2B8\uB808\uC774\uB108\uB85C\uC11C\\r\\n\uC804\uB825\uC744 \uB2E4\uD574 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC124\uB9C8 \uC774 \uC815\uB3C4\uC774\uC2E4 \uC904\uC774\uC57C...\\n\uBA4B\uC9C4 \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4.\\r\\n\uC6B0\uC2B9 \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4.[VAR 0114(000A)]",
  "[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591 \uC544\uB2C8\uC2ED\uB2C8\uAE4C!\\n\uC774\uBC88 \uC0C1\uB300\uB294 \uC811\uB2C8\uB2E4!\\r\\n\uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC6B0\uC2B9... \uCD95\uC544...\uB4DC\uD799\uB2C8\uB2E4~!\\n\uC800... \uB108\uBB34 \uAC10\uACA9\uD750\uB7FD...\\r\\n\uC73C\uD750\uC5D0\uC5E5~! \uC5C9 \uC5C9 \uC5C9!![VAR 0114(0012)]",
  "\uC774\uBC88\uC5D0\uB3C4 \uCC38\uAC00\uD588\uC5B4\uC694.\\n\uCC54\uD53C\uC5B8 [VAR 0100(0000)]...\\r\\n\uC2E4\uB825\uC744 \uC5BC\uB9C8\uB098 \uC5F0\uB9C8\uD588\uB294\uC9C0 \uC81C\uAC8C \uBCF4\uC5EC \uC8FC\uC138\uC694![VAR 0114(0011)]",
  "\uB2F9\uC2E0\uC774 \uC788\uB294 \uD55C\\n\uD314\uB370\uC544\uB294 \uD3C9\uD654\uB85C\uC6B8 \uAC70\uC608\uC694.\\r\\n\uC6B0\uC2B9 \uCD95\uD558\uB4DC\uB824\uC694.[VAR 0114(0011)]",
  "\uC81C1\uB77C\uC6B4\uB4DC\uC758 \uC2B9\uC790\uB294...\\n\uCC54\uD53C\uC5B8 [VAR 0100(0000)]!",
  "\uC81C2\uB77C\uC6B4\uB4DC\uC758 \uC2B9\uC790\uB294...\\n\uCC54\uD53C\uC5B8 [VAR 0100(0000)]!",
