[
  "\uC654\uAD6C\uB098, [VAR 0100(0000)]![VAR 0114(0004)]",
  "\uD559\uAD50 \uCD5C\uAC15 \uC120\uBC1C \uB300\uD68C\uC5D0 \uCD9C\uC804\uD558\uB824\uBA74\\n\uC2A4\uD0DC\uD504\uC5D0\uAC8C \uC5D4\uD2B8\uB9AC\uB97C \uC2E0\uCCAD\uD574\uC57C \uD574![VAR 0114(0004)]",
  "\uADF8\uB7FC, \uB300\uD68C\uC5D0 \uAD00\uD55C \uC124\uBA85\uC744 \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694![VAR 0114(0004)]",
  "\uD559\uAD50 \uCD5C\uAC15 \uC120\uBC1C \uB300\uD68C\uC758 \uB8F0\uC740\\n\uD559\uC0DD\uACFC \uC120\uC0DD, \uB204\uAD6C\uB098 \uCC38\uAC00\uD560 \uC218 \uC788\uB294\\r\\n\uD1A0\uB108\uBA3C\uD2B8\uC2DD \uB79C\uB364 \uB9E4\uCE58\uC785\uB2C8\uB2E4!",
  "\uC6B4\uC601\uC9C4\uC758 \uCD94\uCCA8\uC744 \uD1B5\uD574\\n\uB300\uC9C4\uC774 \uC815\uD574\uC9C0\uBBC0\uB85C",
  "\uBC30\uD2C0\uCF54\uD2B8\uC5D0 \uC11C\uAE30 \uC804\uAE4C\uC9C0\uB294\\n\uB300\uC804 \uC0C1\uB300\uAC00 \uB204\uAD6C\uC778\uC9C0 \uC54C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4!",
  "\uC774\uAE34 \uC0AC\uB78C\uC740 \uACC4\uC18D\uD574\uC11C\\n\uB2E4\uC74C \uC2DC\uD569\uC744 \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4\uB9CC",
  "\uD55C \uBC88\uC774\uB77C\uB3C4 \uD328\uBC30\uD558\uBA74 \uD0C8\uB77D \uCC98\uB9AC\uB418\uC5B4\\n\uC774\uD6C4\uC758 \uC2DC\uD569\uC5D0\uB294 \uCD9C\uC804\uD558\uC2E4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uAC04\uB2E8\uD788 \uB9D0\uD574, \uC2B9\uBD80\uB97C \uAC70\uB4ED\uD558\uBA70\\n\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uB0A8\uC740 \uB2E8 \uD55C \uC0AC\uB78C\uC774\\r\\n\uD559\uAD50 \uCD5C\uAC15\uC758 \uD2B8\uB808\uC774\uB108\uAC00 \uB418\uB294 \uAC83\uC785\uB2C8\uB2E4!",
  "\uC124\uBA85 \uAC10\uC0AC\uD569\uB2C8\uB2E4![VAR 0114(0004)]",
  "\uAD50\uC7A5 \uC120\uC0DD\uB2D8\uACFC \uC0C1\uC758\uD574\uC11C \uC815\uD55C\\n\uB300\uD68C \uB8F0\uC774\uC57C![VAR 0114(0004)]",
  "\uC9C0\uAE08\uAE4C\uC9C0 \uC5D4\uD2B8\uB9AC\uD55C \uC778\uC6D0 \uC218\uB300\uB85C\uBA74\\n\uC544\uB9C8 4\uBC88 \uC815\uB3C4 \uC774\uAE30\uBA74 \uC6B0\uC2B9\uC77C \uAC70\uC57C![VAR 0114(0004)]",
  "\uC120\uC0DD\uB2D8\uB4E4\uB3C4 \uB2E4\uB4E4\\n\uAC15\uD55C \uC0AC\uB78C\uBFD0\uC774\uB2C8\uAE4C \uC5F4\uC2EC\uD788 \uD574 \uBD10![VAR 0114(0004)]",
  "\uB0B4\uAC00 \uC544\uB2CC \uB2E4\uB978 \uC0AC\uB78C\uD55C\uD14C\\n\uC9C0\uBA74 \uC548 \uB3FC~![VAR 0114(0004)]",
  "\uC900\uBE44\uAC00 \uB418\uC2DC\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694."
]
