[
  "\uB2E4\uB4E4 \uBAA8\uC774\uC168\uB098\uC694?[VAR 0114(000A)]",
  "\uC774\uBBF8 \uC54C\uACE0 \uACC4\uC2E0 \uBD84\uB4E4\uB3C4\\n\uC788\uC73C\uC2DC\uACA0\uC9C0\uB9CC...[VAR 0114(000A)]",
  "\uC6B0\uB9AC \uC624\uB80C\uC9C0 \uC544\uCE74\uB370\uBBF8 \uD559\uC0DD \uC911\uC5D0\uC11C\\n\uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAC00 \uD0C4\uC0DD\uD588\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC6B0\uB9AC \uADF8\uB808\uC774\uD504 \uC544\uCE74\uB370\uBBF8 \uD559\uC0DD \uC911\uC5D0\uC11C\\n\uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAC00 \uD0C4\uC0DD\uD588\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uBC14\uB85C [VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591\uC785\uB2C8\uB2E4![VAR 0114(000A)]",
  "\uC9C4\uC9DC!? \uB300\uB2E8\uD558\uB2E4!",
  "\uC640~! \uC640~! \uAD49\uC7A5\uD574~!",
  "\uC720\uD6C4! \uCC54\uD53C\uC5B8![VAR 0114(0006)]",
  "\uC7AC\uD559 \uC911\uC5D0 \uC774\uB7F0 \uC704\uC5C5\uC744 \uB2EC\uC131\uD558\uC2DC\uB2E4\uB2C8\\n\uAD50\uC7A5\uC73C\uB85C\uC11C \uB9E4\uC6B0 \uAE30\uC069\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC774\uBC88 \uB300\uD68C\uB294 \uD559\uC0DD\uD68C\uC7A5\uC778 \uB124\uBAA8 \uC591\uC774\\n\uC790\uC2E0\uC758 \uCE5C\uAD6C\uC778 \uC0C8 \uCC54\uD53C\uC5B8\uC744\\r\\n\uCD95\uD558\uD558\uAE30 \uC704\uD574 \uAE30\uD68D\uD55C \uB300\uD68C\uC785\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC624\uB298\uC740 \uC0C8\uB85C\uC6B4 \uCC54\uD53C\uC5B8\uC758 \uC2E4\uB825\uC744\\n\uC5EC\uB7EC\uBD84\uAED8 \uC120\uBCF4\uC774\uB294 \uC790\uB9AC\uC774\uAE30\uB3C4 \uD569\uB2C8\uB2E4\uB9CC...[VAR 0114(000A)]",
  "\uD3C9\uC18C\uC5D0 \uC790\uC2E0\uC758 \uC2E4\uB825\uC744\\n\uB4DC\uB7EC\uB0B4\uC9C0 \uC54A\uB294 \uD559\uC0DD\uC774\uB098...[VAR 0114(000A)]",
  "\uAC15\uD55C \uC2E4\uB825\uC744 \uAC00\uC9C4 \uC120\uC0DD\uB2D8\uB4E4\uC5D0\uAC8C\uB3C4\\n\uC8FC\uBAA9\uD574 \uC8FC\uC2DC\uBA74 \uAC10\uC0AC\uD558\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(000A)]",
  "\uADF8\uB7FC, \uD559\uAD50 \uCD5C\uAC15 \uC120\uBC1C \uB300\uD68C...\\n\uBC30\uD2C0 \uC2A4\uCFE8 \uC6CC\uC988\uC758 \uAC1C\uCD5C\uB97C \uC120\uD3EC\uD569\uB2C8\uB2E4![VAR 0114(000A)]"
