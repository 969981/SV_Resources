  "\uC544~ \uAE30\uC5B5\uB098\uB124~ [VAR 0100(0000)][VAR 1900(0003)] \uC5F4\uC2EC\uD788\\n\uC62C\uB9AC\uBE0C\uB97C \uAD74\uB9AC\uB358 \uBAA8\uC2B5![VAR 0114(0016)]",
  "\uB9C8\uCE58 \uACA9\uD22C\uD0C0\uC785\uC73C\uB85C\\n\uD14C\uB77C\uC2A4\uD0C8\uD55C \uAC83 \uAC19\uC740 \uAE30\uC138\uC600\uC5B4~[VAR 0114(0016)]",
  "[VAR 0100(0000)][VAR 1900(0001)]\\n\uC6B0\uB9AC \uCCB4\uC721\uAD00\uC774 \uBA87 \uBC88\uC9F8\uC600\uC5B4~?[VAR 0114(0016)]",
  "\uC138\uB974\uD074\uCCB4\uC721\uAD00\uC774 \uD559\uAD50\uC5D0\uC11C \uAC00\uAE4C\uC6CC\uC11C \uADF8\uB7F0\uC9C0\\n\uCCAB \uBC88\uC9F8 \uCCB4\uC721\uAD00\uC73C\uB85C \uACE0\uB974\uB294 \uD2B8\uB808\uC774\uB108\uAC00\\r\\n\uB9CE\uC774 \uC788\uAC70\uB4E0~[VAR 0114(0016)]",
  "\uADF8\uB798\uC11C \uACFC\uC790\uCC98\uB7FC \uB2EC\uB2EC~\uD558\uAC8C \uC2F8\uC6CC \uB2EC\uB77C\uACE0\\n\uCE58\uD504\uD55C\uD14C \uBD80\uD0C1\uC744 \uBC1B\uC558\uC5C8\uC5B4~[VAR 0114(0016)]",
  "\uADF8\uB807\uC9C0\uB9CC, \uACC4\uC18D \uC9C0\uAE30\uB9CC \uD558\uB2C8\\n\uBC8C\uB808\uD3EC\uCF13\uBAAC\uB4E4\uC774 \uBD88\uC30D\uD560 \uB54C\uB3C4 \uC788\uC5B4...[VAR 0114(0016)]",
  "\uC6B0\uD6C4\uD6C4, \uADF8\uB798\uB3C4 \uC774\uB7F4 \uB54C\uB294\\n\uC804\uB825\uC744 \uB2E4\uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C \uD765\uBD84\uB418\uB124~[VAR 0114(0016)]",
  "\uADF8\uB7FC, \uCCA0\uC800\uD558\uAC8C\\n\uC4F0\uB7EC\uB728\uB824 \uBCFC\uAE4C~?[VAR 0114(0016)]",
  "\uCE58\uD504 \uBABB\uC9C0\uC54A\uAC8C\\n\uD6CC\uB96D\uD55C \uC2E4\uB825\uC774\uC5C8\uC5B4~[VAR 0114(0016)]",
  "\uC544~! \uC804\uB825\uC73C\uB85C \uC2B9\uBD80\uD558\uB2C8\uAE4C\\n\uC838\uB3C4 \uAE30\uBD84\uC774 \uC88B\uB124~![VAR 0114(0016)]",
  "\uC5ED\uC2DC \uB108\uBB34 \uB2EC\uB2EC~\uD558\uAC8C \uC2F8\uC6B0\uB294 \uAC74\\n\uC0C1\uB300\uC5D0\uAC8C\uB3C4 \uB098\uC5D0\uAC8C\uB3C4 \uC88B\uC9C0 \uC54A\uC740 \uAC74\uAC00~?[VAR 0114(0016)]",
  "\uC694\uB9AC \uC2A4\uC2B9\uB2D8\uC778 \uACE4\uD3EC \uC528\uB3C4\\n\uC880 \uB354 \uB098\uB2F5\uAC8C \uD558\uB77C\uACE0 \uD558\uC168\uC73C\uB2C8\uAE4C~[VAR 0114(0016)]",
  "\uC55E\uC73C\uB85C\uB294 \uC880 \uB354\\n\uB098\uB2F5\uAC8C... \uD574 \uBCFC \uC0DD\uAC01\uC774\uC57C![VAR 0114(0016)]",
  "\uCCB4\uC721\uAD00\uC774 \uB108\uBB34 \uC5B4\uB824\uC6CC\uC84C\uB2E4 \uADF8\uB7EC\uBA74\\n\uC4F4\uB9DB\uC73C\uB85C \uBC14\uB010 \uAC70\uB77C\uACE0 \uB458\uB7EC\uB300\uC9C0 \uBB50~[VAR 0114(0016)]",
  "\uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uC790~[VAR 0114(0016)]"
]
