[
  "\uCC45\uC774 \uB108\uBB34 \uB9CE\uC544\uC11C \uB2E4 \uC77D\uC9C0\uB3C4 \uBABB\uD558\uACA0\uC5B4...\\n\uC774 \uD559\uAD50\uC5D0 \uC624\uAE38 \uC798\uD55C \uAC83 \uAC19\uC544!",
  "\uBC30\uD2C0\uD559 \uC218\uC5C5\uC744 \uBC1B\uC73C\uBA74\\n\uAC15\uD574\uC9C4 \uAE30\uBD84\uC774 \uB4E4\uC5B4!",
  "\uD0C0\uC784 \uC120\uC0DD\uB2D8\uC758 \uC218\uD559 \uC218\uC5C5\uC740 \uC54C\uAC8C \uBAA8\uB974\uAC8C\\n\uBC30\uD2C0\uC5D0 \uB300\uD55C \uC9C0\uC2DD\uB3C4 \uBC30\uC6B0\uAC8C \uB41C\uB2E8 \uB9D0\uC774\uC9C0.",
  "\uD3EC\uCF13\uBAAC\uD558\uACE0\uB294 \uBCC4\uB85C \uAD00\uB828 \uC5C6\uAE34 \uD558\uC9C0\uB9CC\\n\uC5B8\uC5B4\uD559 \uC218\uC5C5\uB3C4 \uC7AC\uBBF8\uC788\uC5B4.",
  "[~ 76]",
  "\uC624\uCEEC\uCC98\uB77C\uB294 \uC774\uC0C1\uD55C \uC7A1\uC9C0 \uB9D0\uC774\uC57C!\\n\uC21C \uC5C9\uD130\uB9AC \uAC19\uC740 \uAC70\uC9D3\uB9D0\uB9CC \uC801\uD600 \uC788\uC5B4!",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "\uC785\uAD6C \uD640\uC744 \uB3C4\uC11C\uC2E4\uB85C \uD65C\uC6A9\uD558\uB2E4\uB2C8\\n\uCC38\uC2E0\uD55C \uAC83 \uAC19\uC544.",
  "[~ 76]",
  "\uD3EC\uCF13\uBAAC\uC5D0 \uAD00\uD55C \uAC74 \uC790\uC2E0 \uC788\uC9C0\uB9CC,\\n\uACF5\uBD80\uC5D0\uB294 \uC82C\uBCD1\uC774\uC57C~\\r\\n...\uC2DC\uD5D8\uACF5\uBD80 \uB3C4\uC640\uC904 \uC218 \uC788\uC5B4!?",
  "\uACF5\uBD80\uC5D0\uB294 \uC790\uC2E0 \uC788\uC9C0\uB9CC\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB294 \uC544\uC9C1 \uBD80\uC871\uD55C \uAC83 \uAC19\uC544!\\r\\n...\uBC30\uD2C0 \uC880 \uAC00\uB974\uCCD0 \uC8FC\uB77C!",
  "[~ 76]",
  "\uBE44\uC804\uC2A4\uD30C\uC774\uC2A4\uB77C\uB294 \uC870\uBBF8\uB8CC\uC5D0 \uB300\uD574\\n\uC801\uD78C \uCC45\uC774 \uC5B4\uB514 \uC788\uB354\uB77C...?",
  "[~ 76]",
  "\uADF8\uAC70 \uC54C\uC544?\\n\uC774 \uD559\uAD50\uB294 \uC62C\uD574\uB85C \uCC3D\uB9BD 805\uC8FC\uB144\uC774\uB77C\uB098 \uBD10.",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "\uC5EC\uAE30\uC5D0 \uC788\uB294 \uC0AC\uB78C \uBAA8\uB450 \uB2E4\\n\uACF5\uBD80\uD558\uB7EC \uC628 \uAC70\uAD6C\uB098~",
  "\uB108\uB294 \uC774\uACFC \uCF54\uC2A4\uC57C?\\n\uC544\uB2C8\uBA74 \uBB38\uACFC \uCF54\uC2A4?\\r\\n\uD3EC\uCF13\uBAAC\uC744 \uC88B\uC544\uD55C\uB2E4\uBA74 \uC885\uD569 \uCF54\uC2A4\uB824\uB098?",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "\uB098\uB294 \uBCA0\uC774\uD06C\uB9C8\uC744\uC774\uB77C\uB294\\n\uC791\uC740 \uB9C8\uC744\uC5D0\uC11C \uC654\uC5B4!\\r\\n\uD559\uAD50\uC5D0\uB294 \uC0AC\uB78C\uC774 \uC794\uB729 \uC788\uAD6C\uB098!",
  "[~ 76]",
  "[~ 76]",
  "\uBAA8\uB2C8\uD130\uB97C \uBCF4\uACE0 \uD589\uC120\uC9C0\uB97C \uD655\uC778\uD574 \uB450\uBA74\\n\uAE38\uC744 \uC783\uC9C0 \uC54A\uB294\uB2E4\uB294 \uAC8C \uC815\uB9D0\uC77C\uAE4C?",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "\uC190\uC774 \uB2FF\uC9C0 \uC54A\uB294 \uCC45\uC744\\n\uD30C\uCE58\uB9AC\uC2A4\uAC00 \uAC00\uC838\uB2E4\uC8FC\uACE0 \uC788\uC5B4~!",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "\uC774\uACFC \uCF54\uC2A4\uC758 \uBAA8\uB780\uC774\uB77C\uB294 \uC544\uC774 \uB9D0\uC774\uC57C,\\n\uBA38\uB9AC\uB3C4 \uC88B\uACE0 \uAE30\uACC4\uB97C \uC798 \uB2E4\uB8EC\uB300.\\r\\n\uCD5C\uADFC\uC5D0 \uBCF5\uD559\uD588\uB2E4\uB098 \uBD10.",
  "\uAD50\uACFC\uC11C\uB97C \uC18C\uB9AC \uB0B4\uC11C \uC77D\uC73C\uBA74\\n\uB208\uC774\uB791 \uC785\uC774\uB791 \uADC0\uB97C \uBAA8\uB450 \uC368\uC11C \uC678\uC6B8 \uC218 \uC788\uC5B4!",
  "\uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD574 \uBC30\uC6B0\uACE0 \uC2F6\uC5B4\uC11C\\n\uC785\uD559\uD588\uB294\uB370\\r\\n\uC774\uACFC\uC5D0\uB3C4 \uD765\uBBF8\uAC00 \uC0DD\uACBC\uC5B4!",
  "\uBC8C\uB808\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC740 \uD480\uC744 \uBA39\uC73C\uB2C8\uAE4C...\\n\uBC8C\uB808\uD0C0\uC785\uC740 \uD480\uD0C0\uC785\uC5D0 \uAC15\uD558\uB2E4!",
  "\uACC4\uC18D\uD574\uC11C \uC9C8\uBB38\uC744 \uB358\uC84C\uB354\uB2C8\\n\uC120\uC0DD\uB2D8\uC774 \uB098\uB97C \uAE30\uC5B5\uD558\uC2DC\uAC8C \uB410\uC5B4!",
  "\uC88B\uC740\uC0C1\uCC98\uC57D\uACFC \uACE0\uAE09\uC0C1\uCC98\uC57D \uC911\uC5D0\\n\uD68C\uBCF5\uB7C9\uC774 \uB9CE\uC740 \uAC74... \uC5B4\uB290 \uCABD\uC774\uC9C0?",
  "\uC2A4\uD0C0\uB2E8\uC774\uB77C\uACE0 \uB4E4\uC5B4 \uBD24\uC5B4?\\n\uAF64 \uC624\uB798\uC804\uC5D0 \uBB38\uC81C\uB97C \uC77C\uC73C\uCF30\uC5C8\uC5B4.",
  "[~ 76]",
  "\uC800\uB294 \uC120\uC0DD\uB2D8\uC774 \uC544\uB2C8\uB77C \uD559\uC0DD\uC774\uC5D0\uC694.\\n\uBD10\uC694! \uAD50\uBCF5\uC744 \uC785\uACE0 \uC788\uC796\uC544\uC694!",
  "\uAC15\uCCA0\uD0C0\uC785 \uAE30\uC220\uC740 \uD398\uC5B4\uB9AC\uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n\uD6A8\uACFC\uAC00 \uAD49\uC7A5\uD558\uB2E4... \uC81C\uB300\uB85C \uC678\uC6B4 \uAC70 \uB9DE\uC9C0!?",
  "\uD0C0\uC785\uC774 2\uAC1C\uC778 \uD3EC\uCF13\uBAAC\uC740\\n\uC0C1\uC131\uC744 \uD30C\uC545\uD558\uAE30 \uC5B4\uB824\uC6B4 \uAC83 \uAC19\uC544.",
  "\uBC24\uC5D0\uB3C4 \uC218\uC5C5\uC744 \uB4E4\uC744 \uC218 \uC788\uC5B4\uC11C\\n\uB0AE\uC5D0 \uC77C\uD558\uBA74\uC11C \uB2E4\uB2D0 \uC218 \uC788\uC5B4!",
  "\uC790\uBA74 \uD558\uB8E8\uAC00 \uB05D\uB098 \uBC84\uB9AC\uB294 \uAC8C \uC544\uAE4C\uC6CC\uC11C\\n\uBC24\uC744 \uC0C8\uB294 \uC911\uC774\uC57C...\\r\\n\uADF8\uB9AC\uACE0 \uB2E4\uC74C\uB0A0 \uC544\uCE68\uC5D0 \uD6C4\uD68C\uD558\uACE4 \uD558\uC9C0...",
  "\uD3EC\uCF13\uBAAC\uC774 \uB5A8\uC5B4\uB728\uB9B0 \uCF54\uC778\uC744 \uC8FC\uC6E0\uC5B4.\\c\\n\uB3CC\uB824\uC8FC\uB824\uACE0 \uBCF4\uAD00\uD558\uACE0 \uC788\uB294\uB370\\n\uC791\uC740 \uD3EC\uCF13\uBAAC\uC774\uB77C \uC5B4\uB514 \uC788\uB294\uC9C0 \uBABB \uCC3E\uACA0\uC5B4.",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "\uC624\uB798 \uAC19\uC774 \uAC78\uC5B4 \uB2E4\uB2C8\uB2E4 \uBCF4\uBA74\\n\uC9C4\uD654\uD558\uB294 \uD3EC\uCF13\uBAAC\uB3C4 \uC788\uB300.",
  "[~ 76]",
  "[~ 76]",
  "[~ 76]",
  "\uBC24\uC911\uC758 \uD559\uAD50\uB294 \uC2E0\uAE30\uD55C \uAC83 \uAC19\uC544!\\n\uB0AE\uC77C \uB54C\uB791 \uB3CC\uC544\uB2E4\uB2C8\uB294 \uC0AC\uB78C\uC774 \uB2E4\uB974\uC796\uC544.\\c\\n\uB9C8\uC744 \uBC16\uC5D0\uC11C\uB3C4 \uB0AE\uC774\uB0D0 \uBC24\uC774\uB0D0\uC5D0 \uB530\uB77C\\n\uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB0A0 \uC218 \uC788\uC5B4.",
  "[~ 76]",
  "\uC720\uBA85\uD55C \uBC15\uC0AC\uB2D8\uC758 \uBAA8\uAD50\uC5D0\uC11C\\n\uBC30\uC6B8 \uC218 \uC788\uC5B4\uC11C \uC5BC\uB9C8\uB098 \uC601\uAD11\uC778\uC9C0 \uBAB0\uB77C!",
  "[~ 76]",
