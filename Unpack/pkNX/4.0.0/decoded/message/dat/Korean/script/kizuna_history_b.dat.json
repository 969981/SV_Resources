[
  "1-A\uC758 [VAR 0100(0000)] \uC544\uB2C8\uC57C?[VAR 0114(0027)]",
  "\uC218\uC5C5 \uB54C \uB4E4\uB824\uC900 \uB3D9\uD654\uC758\\n\uB4B7\uC774\uC57C\uAE30\uAC00 \uC54C\uACE0 \uC2F6\uC5B4\uC84C\uB2C8?[VAR 0114(0027)]",
  "\uD06C\uD06C\uD06D...\\n\uBBF8\uB07C\uB97C \uBB38 \uAC8C \uB108\uB77C\uC11C \uC815\uB9D0 \uB2E4\uD589\uC774\uC57C.[VAR 0114(0027)]",
  "\uAC70\uC9D3\uB9D0\uD560 \uAC70 \uC5C6\uC5B4.\\n\uC9C0\uC801 \uD638\uAE30\uC2EC\uC744 \uCC44\uC6B0\uACE0 \uC2F6\uC5B4 \uD558\uB294 \uAC8C\\r\\n\uC5BC\uAD74\uC5D0 \uB2E4 \uB4DC\uB7EC\uB098 \uC788\uB2E4\uACE0.[VAR 0114(0027)]",
  "\uADF8\uB987, \uAC80, \uBAA9\uAC04, \uACE1\uC625,\\n\uC774 4\uAC1C\uC758 \uBCF4\uBB3C\uC744 \uC190\uC5D0 \uB123\uC5C8\uB358\\r\\n\uC655\uC758 \uC131\uC774 \uBB34\uB108\uC9C4 \uC774\uC720...[VAR 0114(0027)]",
  "\uADF8\uAC83\uC740 \uC0AC\uC2E4 \uBCF4\uBB3C\uC774\\n\uD3EC\uCF13\uBAAC\uC774\uC5C8\uAE30 \uB54C\uBB38\uC774\uC57C.[VAR 0114(0027)]",
  "\uBCF4\uBB3C\uB85C \uCDE8\uAE09\uB418\uC5B4\\n\uC218\uB9CE\uC740 \uC0AC\uB78C\uC758 \uC190\uC744 \uAC70\uCCD0\uAC04 4\uB9C8\uB9AC\uC5D0\uAC8C\\r\\n\uC778\uAC04\uC758 \uC695\uC2EC\uACFC \uC800\uC8FC\uB4E4\uC774 \uAE43\uB4E4\uC5B4 \uAC00\uB2E4\uAC00...[VAR 0114(0027)]",
  "\uC655\uC758 \uC695\uB9DD\uACFC \uC811\uCD09\uD55C \uAC83\uC744 \uACC4\uAE30\uB85C\\n\uACB0\uAD6D \uC7AC\uC559\uC774 \uB418\uC5B4 \uB0A0\uB6F0\uAC8C \uB41C \uAC70\uC57C.[VAR 0114(0027)]",
  "\uC784\uAE08\uB2D8\uC740 \uC790\uC2E0\uC758 \uC655\uAD6D\uC744 \uC9C0\uD0A4\uAE30 \uC704\uD574\\n\uACE0\uBA85\uD55C \uD3EC\uCF13\uBAAC\uC220\uC0AC\uB4E4\uC744 \uBD88\uB7EC\\r\\n\uACA9\uC804 \uB05D\uC5D0 \uC7AC\uC559\uC744 \uC7A0\uC7AC\uC6E0\uC5B4.[VAR 0114(0027)]",
  "\uADF8\uB9AC\uACE0 \uD314\uB370\uC544 \uC5B4\uB518\uAC00\uC5D0\\n4\uB9C8\uB9AC\uB97C \uBD09\uC778\uD588\uB2E4\uB294 \uBAA8\uC591\uC774\uC57C.[VAR 0114(0027)]",
  "\uC774 \uC774\uC57C\uAE30...\\n\uB2E8\uC21C\uD788 \uC9C0\uC5B4\uC9C4 \uC774\uC57C\uAE30\uB77C \uC0DD\uAC01\uD558\uB2C8?[VAR 0114(0027)]",
  "\uC758\uC678\uB85C \uB0AD\uB9CC\uC774 \uC5C6\uB294 \uC544\uC774\uAD6C\uB098!![VAR 0114(0027)]",
  "\uD06C\uD06D... \uAF64\uB098 \uAC10\uC774 \uC88B\uC740\uAC78?[VAR 0114(0027)]",
  "\uC5ED\uC0AC\uC801\uC778 \uC7AC\uD574 \uAE30\uB85D, \uAC1C\uC778\uC758 \uC77C\uAE30...\\n\uB2E4\uC591\uD55C \uC790\uB8CC\uB97C \uC77D\uC5B4 \uBD24\uB354\uB2C8\\r\\n\uC774 \uC774\uC57C\uAE30\uB97C \uB4B7\uBC1B\uCE68\uD558\uB294 \uC0AC\uC2E4\uC774 \uB9CE\uB354\uB77C\uACE0.[VAR 0114(0027)]",
  "\uB9CC\uC57D \uC0AC\uC2E4\uC774\uB77C\uB294 \uD655\uC2E0\uC774 \uC0DD\uAE30\uBA74\\n\uB108\uC5D0\uAC8C\uB3C4 \uAC00\uB974\uCCD0 \uC904\uAC8C.[VAR 0114(0027)]",
  "\uB808\uD3EC\uB974 \uC120\uC0DD\uB2D8\uACFC\\n\uC870\uAE08 \uB354 \uCE5C\uD574\uC84C\uB2E4!"
]
