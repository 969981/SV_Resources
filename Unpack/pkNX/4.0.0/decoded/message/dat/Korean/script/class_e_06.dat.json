[
  "\uC548\uB155! \uC624\uB298\uB3C4 \uAE30\uC6B4\uCC28\uAC8C!\\n\uBC30\uD2C0\uD559\uC5D0 \uB300\uD574 \uBC30\uC6CC \uBCFC\uAE4C![VAR 0114(0024)]",
  "\uC9C0\uB09C \uC2DC\uAC04\uC5D0 \uBC30\uC6E0\uB358 \uB9E1\uAE30\uAE30 \uBC30\uD2C0!\\n\uB2E4\uB4E4 \uC798 \uC0AC\uC6A9\uD558\uACE0 \uC788\uC9C0?[VAR 0114(0024)]",
  "\uC798 \uD65C\uC6A9\uD558\uBA74 \uB9CE\uC740 \uD3EC\uCF13\uBAAC\uC744\\n\uC131\uC7A5\uC2DC\uD0AC \uC218 \uC788\uB294 \uB370\uB2E4\uAC00,[VAR 0114(0024)]",
  "\uAE30\uC220\uBA38\uC2E0\uBA38\uC2E0\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC758 \uC720\uC2E4\uBB3C\uB3C4 \uD6A8\uC728\uC801\uC73C\uB85C \uBAA8\uC744 \uC218 \uC788\uC5B4![VAR 0114(0024)]",
  "\uAE30\uC220\uBA38\uC2E0\uBA38\uC2E0\uD558\uB2C8\uAE4C \uB9D0\uC778\uB370!\\n\uB2E4\uB4E4 \uC0AC\uC6A9\uD558\uACE0 \uC788\uC9C0?[VAR 0114(0024)]",
  "\uADF8\uB7FC, \uD55C\uBC88 \uD655\uC778\uD574 \uBCFC\uAE4C![VAR 0114(0024)]",
  "\uAE30\uC220\uBA38\uC2E0\uC744 \uB9CC\uB4DC\uB294 \uB370\\n\uD3EC\uCF13\uBAAC\uC758 \uC720\uC2E4\uBB3C \uC678\uC5D0 \uD544\uC694\uD55C \uAC83\uC774\\r\\n\uD558\uB098 \uB354 \uC788\uB294\uB370, \uBB54\uC9C0 \uC544\uB294 \uC0AC\uB78C?[VAR 0114(0024)]",
  "LP",
  "HP",
  "\uB3C8",
  "\uC624, \uC804\uD559\uC0DD!\\n\uB108\uB294 \uC774\uBBF8 \uC790\uC8FC \uC0AC\uC6A9\uD558\uACE0 \uC788\uB098 \uBCF4\uAD6C\uB098![VAR 0114(0024)]",
  "\uC5D0\uD5E4\uC774, \uC804\uD559\uC0DD!\\n\uC124\uB9C8 HP\uB97C \uBC14\uCCD0\uC57C \uD558\uAC8C \uB9CC\uB4E4\uACA0\uC5B4?\\r\\n\uC774\uAC74 \uBB34\uC2A8 \uC758\uC2DD \uAC19\uC740 \uAC8C \uC544\uB2C8\uB77C\uACE0![VAR 0114(0024)]",
  "\uC544\uAE4C\uC6E0\uC5B4, \uC804\uD559\uC0DD!\\n\uC138\uC0C1\uC5D0\uB294 \uB3C8\uC73C\uB85C\\r\\n\uD574\uACB0\uD560 \uC218 \uC5C6\uB294 \uAC83\uB3C4 \uC788\uB294 \uBC95\uC774\uB77C\uACE0![VAR 0114(0024)]",
  "\uC815\uB2F5\uC740 \uB9AC\uADF8\uD398\uC774!\\n\uC774\uB978\uBC14 LP\uC600\uC5B4![VAR 0114(0024)]",
  "LP\uB294 \uAE30\uC220\uBA38\uC2E0\uBA38\uC2E0\uC744 \uD1B5\uD574\\n\uD3EC\uCF13\uBAAC\uC758 \uC720\uC2E4\uBB3C\uACFC \uAD50\uD658\uD560 \uC218\uB3C4 \uC788\uC9C0![VAR 0114(0024)]",
  "\uCD5C\uADFC\uC5D0\uB294 \uD574\uD0B9\uC774\uB77C\uB294 \uAC78 \uD574\uC11C\\n\uBD80\uC815\uD55C \uBC29\uBC95\uC73C\uB85C LP\uB97C\\r\\n\uC190\uC5D0 \uB123\uB294 \uB140\uC11D\uB3C4 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4...[VAR 0114(0024)]",
  "\uB108\uD76C\uB4E4\uC740 \uADF8\uB7F0 \uB098\uC05C \uC9D3\uC5D0\\n\uC190\uB300\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uB834![VAR 0114(0024)]",
  "\uB9CC\uB4E4\uACE0 \uC2F6\uC740 \uAE30\uC220\uBA38\uC2E0\uC740\\n\uC990\uACA8\uCC3E\uAE30\uC5D0 \uB4F1\uB85D\uD558\uBA74 \uC5B8\uC81C\uB4E0\uC9C0\\r\\n\uC720\uC2E4\uBB3C\uC774 \uC5BC\uB9C8\uB098 \uBAA8\uC600\uB294\uC9C0 \uC54C \uC218 \uC788\uC5B4![VAR 0114(0024)]",
  "\uADF8\uB798\uC11C, \uC624\uB298\uC758 \uACB0\uB860!![VAR 0114(0024)]",
  "\uAE30\uC220\uBA38\uC2E0\uC744 \uB9CC\uB4E4\uB824\uBA74\\n\uC77C\uB2E8 \uD3EC\uCF13\uBAAC\uC758 \uC720\uC2E4\uBB3C\uC774 \uD544\uC694\uD558\uB2E4![VAR 0114(0024)]",
  "\uD3EC\uCF13\uBAAC\uC744 \uB9CE\uC774 \uC2F8\uC6B0\uAC8C \uD574\uC11C\\n\uC720\uC2E4\uBB3C\uC744 \uB9CE\uC774 \uBAA8\uC73C\uB3C4\uB85D![VAR 0114(0024)]",
  "\uC774\uB7F0! \uC9C1\uC811 \uCCB4\uD5D8\uD574 \uBCF4\uAC8C \uD558\uB824\uACE0 \uD588\uB294\uB370\\n\uBC8C\uC368 \uC2DC\uAC04\uC774 \uB418\uC5B4 \uBC84\uB838\uB124...[VAR 0114(0024)]",
  "\uADF8\uB7FC, \uD574\uC0B0!\\n\uB2E4\uB4E4 \uAC74\uAC15\uD558\uAC8C \uC9C0\uB0B4\uB834![VAR 0114(0024)]"
]
