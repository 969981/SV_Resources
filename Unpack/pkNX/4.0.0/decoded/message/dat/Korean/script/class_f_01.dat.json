[
  "\uBBF8\uC220 \uB2F4\uB2F9\uC778 \uD314\uC790\uD06C\uC785\uB2C8\uB2E4.\\n\uC55E\uC73C\uB85C \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.[VAR 0114(0012)]",
  "...\uBBF8\uC220\uC774\uB780 \uBB34\uC5C7\uC778\uAC00![VAR 0114(0012)]",
  "\uC774 \uC548\uC5D0 \uC788\uB294 \uC0AC\uB78C \uC911 \uB300\uBD80\uBD84\uC774\\n\uC878\uC5C5\uD558\uACE0 \uB098\uBA74 \uAE30\uAECF \uBC30\uC6B4 \uC9C0\uC2DD\uC744\\r\\n\uBAA8\uB450 \uC78A\uC5B4\uBC84\uB9AC\uC2E4 \uAC81\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uC2DC\uD5D8\uC774\uB098 \uCDE8\uC9C1\uD560 \uB54C\\n\uBBF8\uC220\uC5D0 \uAD00\uD55C \uC9C0\uC2DD\uC774\uB098 \uBBF8\uC801 \uAC10\uAC01\uC744\\r\\n\uC694\uAD6C\uD558\uB294 \uACBD\uC6B0\uB294 \uADF8\uB9AC \uB9CE\uC9C0 \uC54A\uC73C\uB2C8\uAE4C\uC694.[VAR 0114(0012)]",
  "\uADF8\uB807\uB2E4\uACE0 \uC800\uC758 \uC218\uC5C5\uC774\\n\uC804\uD600 \uC4F8\uBAA8\uC5C6\uB294 \uAC83\uC77C\uAE4C\uC694?[VAR 0114(0012)]",
  "...\uADF8\uB807\uC9C0 \uC54A\uC744 \uAC81\uB2C8\uB2E4.\\n\uC801\uC5B4\uB3C4 \uC800\uB294 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uACE0 \uC2F6\uAD70\uC694.[VAR 0114(0012)]",
  "\uC5EC\uB7EC\uBD84, \uD55C\uBC88 \uC0DD\uAC01\uD574 \uBCF4\uC2DC\uC8E0.\\n\u201C\uC544\uB984\uB2F5\uB2E4\u201D\uC640 \u201C\uC544\uB984\uB2F5\uC9C0 \uC54A\uB2E4\u201D\\r\\n\uBB34\uC5C7\uC774 \uB458\uC758 \uCC28\uC774\uB97C \uB9CC\uB4E4\uC5B4 \uB0B4\uC9C0\uC694?[VAR 0114(0012)]",
  "\uC0C9\uC774\uB098 \uD615\uD0DC\uC694",
  "\uC0AC\uB78C\uB9C8\uB2E4 \uB2EC\uB77C\uC694",
  "\uBAA8\uB974\uACA0\uC5B4\uC694",
  "\uD760... \uADF8\uB807\uAD70\uC694...\\n[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591\uC740 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uB294\uAD70\uC694.[VAR 0114(0012)]",
  "\uC0AC\uC2E4, \uC774 \uC911\uC5D0\\n\uC815\uB2F5\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\\r\\n\uC911\uC694\uD55C \uAC74, \uC0DD\uAC01\uD558\uB294 \uAC83 \uADF8 \uC790\uCCB4\uC785\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC608\uB97C \uB4E4\uC5B4, \uC5B4\uC9F8\uC11C \uAE38\uAC00\uC5D0 \uD540 \uAF43\uC744\\n\uC544\uB984\uB2F5\uB2E4\uACE0 \uB290\uAF08\uB294\uC9C0 \uC0DD\uAC01\uD574 \uBCF8\uB2E4\uAC70\uB098,[VAR 0114(0012)]",
  "\uD558\uB298\uC758 \uD30C\uB780\uC0C9\uACFC \uBC14\uB2E4\uC758 \uD30C\uB780\uC0C9\uC758 \uCC28\uC774,\\n\uC5B4\uC9F8\uC11C \uB098\uBB34\uB4E4\uC774 \uC0C9\uC744 \uBC14\uAFB8\uB294\uAC00,\\r\\n\uBCF4\uC6B8\uB9C8\uC744\uC758 \uD48D\uCC28\uC758 \uC6C0\uC9C1\uC784,\\r\\n\uCE74\uB77C\uD504\uC2DC\uD2F0\uC5D0 \uD750\uB974\uB294 \uBB3C\uC758 \uCC28\uAC00\uC6C0 \uB4F1...[VAR 0114(0012)]",
  "\uC774\uB7F0 \uAC83\uB4E4\uC744 \uC0DD\uAC01\uD558\uAE30\uB9CC \uD574\uB3C4\\n\uC8FC\uBCC0\uC5D0 \uC874\uC7AC\uD558\uB294 \uBAA8\uB4E0 \uAC83\uC744 \uBCF4\uB2E4 \uC120\uBA85\uD558\uACE0,\\r\\n\uBCF4\uB2E4 \uAE4A\uAC8C \uB290\uB07C\uC2E4 \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uADF8\uB7F0 \uACBD\uD5D8\uB4E4\uC774 \uACF5\uBD80\uB97C \uD558\uB2E4 \uC9C0\uCE58\uAC70\uB098\\n\uC77C\uC744 \uD558\uB2E4 \uCEE4\uB2E4\uB780 \uB09C\uAD00\uC5D0 \uBD80\uB52A\uCCE4\uC744 \uB54C...[VAR 0114(0012)]",
  "\uC5EC\uB7EC\uBD84\uC758 \uB4F1\uC744 \uBC00\uC5B4 \uC8FC\uB294\\n\uD798\uC774 \uB418\uC5B4 \uC904 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "...\uC870\uAE08 \uC5B4\uB824\uC6B4 \uC774\uC57C\uAE30\uC600\uC73C\uB2C8\\n\uC774\uD574\uD558\uC9C0 \uBABB\uD588\uB2E4\uACE0 \uAC71\uC815\uD558\uC2E4 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC544\uBB34\uD2BC \uC608\uC220\uC774\uB780!\\n\uC778\uC0DD\uC5D0 \uC5C6\uC5B4\uB3C4 \uAD1C\uCC2E\uC9C0\uB9CC\\r\\n\uC788\uC73C\uBA74 \uB354 \uC990\uAC70\uC6CC\uC9C0\uB294 \uAC83![VAR 0114(0012)]",
  "\uC81C\uAC00 \uC5EC\uB7EC\uBD84\uC758 \uC77C\uC0C1\uC5D0 \uC870\uAE08\uC774\uB098\uB9C8\\n\uC0C9\uC744 \uB354\uD574 \uB4DC\uB9B4 \uC218 \uC788\uB2E4\uBA74 \uAE30\uC060 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uB2E4\uC74C \uC2DC\uAC04\uBD80\uD130\uB294 \uBCF4\uB2E4 \uC2E4\uCC9C\uC801\uC73C\uB85C\\n\uC544\uB984\uB2E4\uC6C0\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD574 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4! \uC774\uC0C1![VAR 0114(0012)]"
]
