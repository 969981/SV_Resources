  "\uADF8\uB798, \uB9DE\uC544!\\n\uAE30\uC5B5\uB825\uC774 \uB300\uB2E8\uD55C\uB370![VAR 0114(0006)]",
  "\uBB50\uB77C\uACE0!?\\n[VAR 0101(0001)]\uC758 \uBCFC\uC744 \uB0B4\uAC00 \uC92C\uC5C8\uC796\uC544!\\r\\n...\uC790\uAE30\uC18C\uAC1C\uB294 \uC548 \uD588\uB358\uAC00?[VAR 0114(0006)]",
  "\uC815\uC2DD\uC73C\uB85C \uB0B4 \uC18C\uAC1C\uB97C \uD560\uAC8C.\\n\uB0B4 \uC774\uB984\uC740 \uD398\uD37C.[VAR 0114(0006)]",
  "\uB124 \uC774\uB984\uC740 \uB9D0\uD558\uC9C0 \uC54A\uC544\uB3C4 \uC54C\uC544.\\n[VAR 0100(0000)]... \uB9DE\uC9C0?[VAR 0114(0006)]",
  "\uD559\uC0DD\uD68C\uC7A5\uC774\uB791 \uAC19\uC774 \uB2E4\uB2CC\uB2E4\uBA70?\\n\uC628 \uD559\uAD50\uC5D0 \uB124 \uC18C\uBB38\uC774 \uC790\uC790\uD558\uB2E4\uACE0.[VAR 0114(0006)]",
  "\uADF8\uB7F0 \uC720\uBA85\uC778\uC744 \uB9CC\uB098\uAE30 \uC704\uD574\\n\uC774 \uBAB8\uAED8\uC11C \uC624\uAE30\uB3C4 \uC2EB\uC740 \uD559\uAD50\uAE4C\uC9C0\\r\\n\uCE5C\uD788 \uD589\uCC28\uD558\uC168\uB2E8 \uB9D0\uC500.[VAR 0114(0006)]",
  "\uC790, \uB098\uC758 \uC57C\uB9DD\uC744 \uC2E4\uD604\uD558\uAE30 \uC704\uD574\\n\uB108\uC758 \uD798\uC744 \uBE4C\uB824\uC8FC\uC9C0 \uC54A\uACA0\uC5B4!?[VAR 0114(0006)]",
  "\uC88B\uC544!",
  "\uC57C\uB9DD\uC774 \uBB54\uB370?",
  "\uC544\uC9C1 \uC544\uBB34\uAC83\uB3C4 \uC124\uBA85 \uC548 \uD588\uB294\uB370 \uC88B\uB2E4\uACE0!?\\n\uB3C4\uB300\uCCB4 \uC5BC\uB9C8\uB098 \uC21C\uC9C4\uD55C \uC608\uC2A4\uB9E8\uC778 \uAC70\uC57C!?[VAR 0114(0006)]",
  "\uD5E4\uD5E4\uD5E4! \uB098\uC758 \uC57C\uB9DD\uC774 \uBB54\uC9C0 \uAD81\uAE08\uD574?\\n\uC88B\uC544, \uC790\uC138\uD788 \uB4E4\uB824\uC8FC\uB3C4\uB85D \uD558\uC9C0![VAR 0114(0006)]",
  "\uC758\uC678\uB77C\uACE0 \uC0DD\uAC01\uD560\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uB098\uB294 \uD53C\uD06C\uB2C9\uD558\uB294 \uAC78 \uC88B\uC544\uD574\uC11C\\r\\n\uC694\uB9AC\uC5D0\uB3C4 \uC7AC\uB2A5\uC774 \uC880 \uC788\uB294 \uD3B8\uC774\uC57C.[VAR 0114(0006)]",
  "\uADF8\uB798\uC11C \uC694\uC998\uC740 \uD3EC\uCF13\uBAAC\uC744 \uAC74\uAC15\uD558\uAC8C \uB9CC\uB4DC\uB294\\n\uAC74\uAC15 \uC694\uB9AC\uB97C \uC5F0\uAD6C\uD558\uACE0 \uC788\uB294\uB370[VAR 0114(0006)]",
  "\uCD5C\uADFC\uC5D0 \uBC1C\uACAC\uD55C \uCC45\uC5D0\\n\uBA39\uC73C\uBA74 \uAE08\uC138 \uAE30\uC6B4\uC774 \uC19F\uC544\uB098\uB294...[VAR 0114(0006)]",
  "\uBE44\uC804\uC2A4\uD30C\uC774\uC2A4\uB77C\uB294\\n\uC2DD\uC7AC\uB8CC\uC5D0 \uB300\uD55C \uC815\uBCF4\uAC00 \uC2E4\uB824 \uC788\uC9C0 \uBB50\uC57C![VAR 0114(0006)]",
  "\uBE44\uC804\uC2A4\uD30C\uC774\uC2A4\uB294 \uBAA8\uB450 \uB2E4\uC12F \uC885\uB958!\\n\uBD84\uB9D0\uC744 \uD600\uB05D\uC73C\uB85C \uC0B4\uC9DD \uB9DB\uBCF4\uAE30\uB9CC \uD574\uB3C4\\r\\n\uC790\uC591 \uAC15\uC7A5! \uD608\uD589 \uCD09\uC9C4!\\r\\n\uB178\uD654 \uBC29\uC9C0\uC5D0 \uBA74\uC5ED \uAC15\uD654\uAE4C\uC9C0![VAR 0114(0006)]",
  "\uAC8C\uB2E4\uAC00, \uD314\uB370\uC544\uC5D0\uC11C\uB9CC \uAD6C\uD560 \uC218 \uC788\uB294\\n\uC5C4\uCCAD\uB098\uAC8C \uD76C\uADC0\uD55C \uC2DD\uC7AC\uB8CC\uB77C\uB294 \uBAA8\uC591\uC774\uC57C![VAR 0114(0006)]",
  "\uADF8\uB807\uC9C0\uB9CC, \uBE44\uC804\uC2A4\uD30C\uC774\uC2A4\uB294\\n\uC8FC\uC778 \uD3EC\uCF13\uBAAC\uC774\uB77C\uB294 \uC874\uC7AC\uAC00 \uC9C0\uD0A4\uACE0 \uC788\uC5B4\uC11C\\r\\n\uC27D\uAC8C \uC190\uC5D0 \uB123\uC744 \uC218\uB294 \uC5C6\uB2E4\uB354\uB77C\uACE0![VAR 0114(0006)]",
  "\uC544, \uC8FC\uC778\uC774\uB77C\uB294 \uAC74 \uB9D0\uC774\uC9C0...\\n\uC774\uB7F0 \uB140\uC11D\uB4E4\uC744 \uB9D0\uD558\uB294 \uAC70\uC57C![VAR 0114(0006)]",
  "\uC9C1\uC811 \uAD6C\uD558\uB7EC \uAC00\uACE0 \uC2F6\uC9C0\uB9CC\\n\uB0B4\uAC00 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB294 \uC82C\uBCD1\uC774\uB77C\uC11C \uB9D0\uC774\uC57C.[VAR 0114(0006)]",
  "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uC798\uD558\uB294\\n\uCE5C\uAD6C\uB3C4 \uB531\uD788 \uC5C6\uACE0...\\r\\n\uD559\uC0DD\uD68C\uC7A5\uC5D0\uAC8C \uBD80\uD0C1\uD558\uB294 \uAC74 \uC9DC\uC99D \uB098\uC11C \uC2EB\uACE0...[VAR 0114(0006)]",
  "\uADF8\uB798\uC11C! \uBD80\uB514 \uB124\uAC00\\n\uD798\uC744 \uBE4C\uB824\uC92C\uC73C\uBA74 \uD55C\uB2E4\uB294 \uAC70\uC57C![VAR 0114(0006)]",
  "\uC544\uC544~! \uADF8\uB9CC, \uADF8\uB9CC!\\n\uC544\uC9C1 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB3FC!![VAR 0114(0006)]",
  "\uC77C\uB2E8 \uC8FC\uC778\uC774 \uC788\uC744 \uAC83 \uAC19\uC740\\n\uC7A5\uC18C\uB97C \uC9C0\uB3C4 \uC571\uC5D0 \uB4F1\uB85D\uD574 \uC904\uAC8C![VAR 0114(0006)]",
  "\uC790\uC138\uD55C \uC774\uC57C\uAE30\uB294 \uB2E4\uC74C\uC5D0 \uD558\uC790!\\n\uC774\uAC74 \uCE5C\uD574\uC9C0\uC790\uB294 \uB73B\uC73C\uB85C \uC8FC\uB294 \uAC70\uC57C.[VAR 0114(0006)]",
  "\uC9C0\uAE08\uC740 \uC77C\uB2E8 \uC0DD\uAC01\uB9CC \uD574 \uBD10![VAR 0114(0006)]"
