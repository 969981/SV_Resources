[
  "\uC624! \uB610 \uB9CC\uB0AC\uB124![VAR 0114(0006)]",
  "\uB0B4\uAC00 \uB204\uAD70\uC9C0 \uAE30\uC5B5\uD558\uC9C0?[VAR 0114(0006)]",
