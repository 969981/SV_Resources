[
  "\uC774 \uAC74\uBB3C...\\n\uC0C8\uB85C\uC6B4 \uAC83\uC758 \uB0C4\uC0C8\uAC00 \uBB3C\uC52C \uD48D\uAE30\uB294\uAD70...[VAR 0114(0027)]",
  "[VAR 0100(0000)]...\\n\uB098\uB97C \uC774\uACF3\uC5D0 \uBD80\uB978 \uAC8C \uB108\uB0D0?[VAR 0114(0027)]",
  "\uC0C8\uB85C \uC9C0\uC740 \uAC74\uCD95\uBB3C\uC5D0 \uB098\uB97C \uCD08\uB300\uD558\uB2E4\uB2C8\\n\uBC30\uC9F1\uC774 \uC81C\uBC95 \uB450\uB451\uD558\uAD6C\uB098?[VAR 0114(0027)]",
  "\uD558\uB098\uB3C4 \uAD6C\uBBF8\uAC00 \uB2F9\uAE30\uC9C0 \uC54A\uB294 \uC81C\uC548\uC774\uC5C8\uC9C0\uB9CC\\n\uB124 \uC5BC\uAD74\uC744 \uBD10\uC11C \uC774\uB807\uAC8C \uC628 \uAC70\uB77C\uACE0.[VAR 0114(0027)]",
  "\uD06C\uD06C\uD06D...\\n\uB9D0\uD558\uC790\uBA74 \uB0B4\uAC8C \uBE5A\uC744 \uD558\uB098 \uC9C4 \uC148\uC774 \uB418\uB294\uAD70.[VAR 0114(0027)]",
  "\uBCF4\uB2F5\uC73C\uB85C \uB098\uC911\uC5D0\\n\uB0B4\uAC00 \uC2DC\uD0A4\uB294 \uC77C\uC744 \uD574 \uC918\uC57C\uACA0\uC5B4.[VAR 0114(0027)]",
  "\uADF8\uB7F4 \uC218\uAC00...",
  "\uC54C\uC558\uC5B4\uC694!",
  "\uD06C\uD06C\uD06D! \uC2A4\uC2A4\uB85C \uBFCC\uB9B0 \uC528\uC557\uC774\uB2C8\\n\uD48D\uC791\uC774\uAE38 \uBC14\uB77C\uAE30\uB098 \uD558\uB77C\uACE0.[VAR 0114(0027)]",
  "\uC5B4\uB77C? \uC758\uC678\uB85C \uD611\uC870\uC801\uC778\uAC78?\\n\uD06C\uD06C\uD06D... \uADF8\uB798 \uC900\uB2E4\uBA74 \uB098\uC57C \uC88B\uC9C0.[VAR 0114(0027)]",
  "\uC790, \uADF8\uB7FC\\n\uC5B4\uB5A4 \uAF2D\uB450\uAC01\uC2DC\uB85C \uC368\uBA39\uC5B4 \uBCF4\uC2E4\uAE4C...\\r\\n\uC55E\uC73C\uB85C\uAC00 \uC7AC\uBC0C\uACA0\uC5B4.[VAR 0114(0027)]",
  "\uBB50\uC57C, \uB108\uAD6C\uB098.\\n\uC800\uBC88\uBCF4\uB2E4 \uBA70\uCE60 \uC624\uB798\uB418\uC5C8\uAD70.[VAR 0114(0027)]",
  "\uC9C0\uB09C\uBC88\uC5D0\uB294 \uB9C8\uC9C0\uBABB\uD574 \uBA3C \uAE38\uC744 \uC654\uB294\uB370\\n\uC0DD\uAC01\uD574 \uBCF4\uB2C8, \uC5EC\uAE30\uB294 \uD558\uB098\uC9C0\uBC29...\\r\\n\uC624\uB79C \uC5ED\uC0AC\uAC00 \uCF1C\uCF1C\uC774 \uC313\uC778 \uBCF4\uBB3C \uCC3D\uACE0\uC600\uC5B4![VAR 0114(0027)]",
  "\uADF8\uC911\uC5D0\uB3C4 \uD574\uC800\uC5D0 \uC7A0\uB4E4\uC5B4 \uC788\uB294 \uC624\uB798\uB41C \uC720\uC801\uC774\\n\uD638\uAE30\uC2EC\uC744 \uB9C8\uAD6C\uB9C8\uAD6C \uC0D8\uC19F\uAC8C \uD55C\uB2E8 \uB9D0\uC774\uC9C0![VAR 0114(0027)]",
  "...\uC5EC\uAE30\uB77C\uBA74 \uAD50\uC7A5\uC758 \uB208\uB3C4 \uB2FF\uC9C0 \uC54A\uC73C\uB2C8\\n\uB354\uB354\uC6B1 \uC798\uB410\uAD70.[VAR 0114(0027)]",
  "\uD06C\uC73C~! \uC774\uB530\uAC00 \uD5E4\uC5C4\uCE58\uB294 \uD3EC\uCF13\uBAAC\uC744 \uB370\uB9AC\uACE0\\n\uD0D0\uC0C9\uC5D0 \uB098\uC11C\uC57C\uACA0\uC5B4![VAR 0114(0027)]",
  "\uC7AC\uBC0C\uACA0\uB124\uC694!",
  "\uC870\uC2EC\uD788 \uB2E4\uB140\uC624\uC138\uC694!",
  "\uD06C\uD06C\uD06D! \uC7AC\uBBF8\uC788\uACE0\uB9D0\uACE0!\\c\\n\uACE0\uB300\uC758 \uC9C0\uD61C\uC5D0 \uC790\uADF9\uC744 \uC5BB\uB294 \uACBD\uD5D8\uC740\\n\uBB34\uC5C7\uACFC\uB3C4 \uBC14\uAFC0 \uC218 \uC5C6\uB294 \uBCF4\uBB3C\uC774\uAC70\uB4E0.[VAR 0114(0027)]",
  "\uD06C\uD06C\uD06D, \uAC71\uC815\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB3FC.\\c\\n\uC720\uC801\uACFC \uC720\uBB3C\uC5D0 \uBB3B\uD78C \uCC44 \uAC00\uB294 \uAC8C\\n\uB0B4\uAC00 \uBC14\uB77C\uB294 \uAC70\uB2C8\uAE4C.[VAR 0114(0027)]",
  "\uC544, \uC544\uC544...\\n[VAR 0100(0000)]... \uB108\uAD6C\uB098...[VAR 0114(0027)]",
  "\uBB34\uC2A8 \uC77C \uC788\uC5B4\uC694?",
  "\uAE30\uC6B4\uC774 \uC5C6\uC73C\uC2DC\uB124\uC694?",
  "\uBCF4\uBA74 \uBAA8\uB974\uACA0\uC5B4?\\n\uD589\uBCF5\uC5D0 \uACA8\uC6CC\uC11C \uC9C0\uCCD0 \uC788\uB294 \uAC70\uB77C\uACE0.[VAR 0114(0027)]",
  "\uD06C\uD06C\uD06D, \uC624\uD788\uB824 \uADF8 \uBC18\uB300\uC57C...\\n\uD589\uBCF5\uC5D0 \uACA8\uC6CC\uC11C \uC9C0\uCCD0 \uC788\uB294 \uAC70\uB77C\uACE0.[VAR 0114(0027)]",
  "\uC5B4\uC81C \uB124\uC624\uB77C\uC774\uD2B8\uC640 \uD5E4\uC5C4\uC744 \uCCD0\uC11C\\n\uD558\uB098\uC9C0\uBC29\uC758 \uD574\uC800\uC720\uC801\uC744 \uAC00 \uBD24\uB294\uB370...[VAR 0114(0027)]",
  "\uAD34... \uAD49\uC7A5\uD588\uC5B4...\\n\uC815\uB9D0... \uCD5C\uACE0\uC600\uC5B4...[VAR 0114(0027)]",
  "\uCE68\uC785\uC790\uB97C \uC800\uC9C0\uD558\uB294 \uC624\uB798\uB41C \uC7A5\uCE58!\\n\uBCBD\uC5D0 \uC801\uD78C \uACE0\uB300 \uBB38\uC790![VAR 0114(0027)]",
  "\uACE0\uB300\uC778\uB4E4\uACFC\uC758 \uC9C0\uD61C \uACA8\uB8E8\uAE30\uB294\\n\uC815\uB9D0\uC774\uC9C0 \uB2EC\uCF64\uD558\uACE0\uB3C4 \uC720\uC775\uD558\uB2E4\uB2C8\uAE4C![VAR 0114(0027)]",
  "\uADF8\uB798\uB3C4 \uC720\uC801\uC758 \uCD5C\uC2EC\uBD80\uAE4C\uC9C0\\n\uB2E8\uC228\uC5D0 \uB3C4\uB2EC\uD574 \uBC84\uB9AC\uBA74 \uC544\uAE4C\uC6B0\uB2C8\uAE4C\\r\\n\uC870\uAE08\uC529 \uD0D0\uC0C9\uD574 \uB098\uAC08 \uC0DD\uAC01\uC774\uC57C.[VAR 0114(0027)]",
  "...\uADF8\uB798, [VAR 0100(0000)].\\n\uB0B4\uAC8C \uC88B\uC740 \uC0DD\uAC01\uC774 \uC788\uC5B4.[VAR 0114(0027)]",
  "\uB108, \uCC54\uD53C\uC5B8\uC774\uB77C\uACE0 \uD588\uC9C0...\\n\uB098\uC640 \uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD558\uC9C0 \uC54A\uACA0\uC5B4?[VAR 0114(0027)]",
  "\uCC54\uD53C\uC5B8\uC758 \uD3EC\uCF13\uBAAC\uC774\uB77C\uBA74\\n\uC5B4\uB5A4 \uAC1C\uCCB4\uB4E0 \uC4F8\uBAA8\uAC00 \uC788\uC744 \uD14C\uB2C8\uAE4C.\\r\\n\uB098\uB294 \uBAA8\uC73C\uB839\uC744 \uC8FC\uC9C0... \uC5B4\uB54C?[VAR 0114(0027)]",
  "\uADF8\uB7FC, \uD3EC\uCF13\uBAAC\uC744 \uACE8\uB77C \uBD10.\\n\uD0D0\uC0C9\uC5D0 \uC720\uC6A9\uD55C \uC885\uC774\uBA74 \uC88B\uACE0.[VAR 0114(0027)]",
  "\uD760, \uB9CC\uC871\uC2A4\uB7EC\uC6B4 \uAD50\uD658\uC774\uC5C8\uC5B4.\\c\\n\uB108\uC758 [VAR 0101(0001)]...\\n\uB0B4\uAC00 \uC2E4\uCEF7 \uADC0\uC5EC\uC6CC\uD574 \uC904\uAC8C.[VAR 0114(0027)]",
  "\uB108\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uB0B4 \uBAA8\uC73C\uB839\uC744 \uAD50\uD658\uD558\uB294 \uAC70\uC9C0?[VAR 0114(0027)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "...\uD589\uB3D9 \uAC00\uB2A5\uD55C \uD3EC\uCF13\uBAAC\uC774\\n1\uB9C8\uB9AC\uBFD0\uC778 \uAC83 \uAC19\uC740\uB370?\\c\\n\uAD50\uD658\uC5D0 \uB3D9\uC758\uD558\uAE30 \uC804\uC5D0 \uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC744\\n2\uB9C8\uB9AC \uC774\uC0C1\uC740 \uB370\uB9AC\uACE0 \uC788\uB294 \uAC8C \uC88B\uB2E4\uACE0.[VAR 0114(0027)]",
  "...\uBCC0\uC2EC\uC740 \uC5ED\uC0AC\uC5D0\uC11C \uC790\uC8FC \uC788\uB294 \uC77C\uC774\uC9C0.\\n\uC774\uBC88\uC5D0\uB3C4 \uADF8\uB807\uAC8C \uB420 \uAC70\uB77C \uAE30\uB300\uD558\uACE0 \uC788\uACA0\uC5B4.[VAR 0114(0027)]",
  "\uB124\uAC00 \uAC00\uC9C4 \uD3EC\uCF13\uBAAC\uC744\\n\uB0B4 \uBAA8\uC73C\uB839\uACFC \uAD50\uD658\uD558\uC9C0 \uC54A\uACA0\uC5B4?[VAR 0114(0027)]",
  "\uACC4\uC18D \uC2E4\uB0B4\uC5D0 \uC788\uC73C\uB2C8\\n\uC0C8\uB85C\uC6B4 \uAC83\uC758 \uB0C4\uC0C8\uAC00 \uB098\uC11C \uBABB \uACAC\uB514\uACA0\uAD70...\\r\\n\uAE30\uBD84 \uC804\uD658\uD560 \uACB8, \uBC16\uC5D0\uC11C \uC2B9\uBD80\uB098 \uD560\uAE4C?[VAR 0114(0027)]",
  "...\uC758\uC678\uB85C \uBC18\uC751\uC774 \uBCC4\uB85C\uB124.\\n\uADF8\uB7FC, \uD63C\uC790 \uC54C\uC544\uC11C \uD560\uAC8C.[VAR 0114(0027)]",
  "\uD06C\uD06C\uD06D, \uC0C1\uB0E5\uD558\uAE30\uB3C4 \uD574\uB77C.\\n\uADF8\uB7FC, \uC804\uC7A5\uC73C\uB85C \uAC00 \uBCFC\uAE4C?[VAR 0114(0027)]",
  "[~ 59]",
  "...\uAF64\uB098 \uAC15\uD55C\uAC78?\\n\uC5EC\uD0DC\uAE4C\uC9C0 \uAC78\uC5B4\uC628 \uAE38\uC774 \uC655\uB3C4\uC600\uB358 \uBAA8\uC591\uC774\uC57C.[VAR 0114(0027)]",
  "\uC774 \uAC15\uD568... \uC774\uC6A9\uD560 \uC218\uB9CC \uC788\uB2E4\uBA74\\n\uC5B8\uC820\uAC00 \uC774\uB7F0\uC800\uB7F0 \uC720\uC801\uC774\uB098 \uBB34\uB364\uB4E4\uC744\\r\\n\uC6D0\uD558\uB294 \uB9CC\uD07C \uC870\uC0AC\uD560 \uC218 \uC788\uC744\uC9C0\uB3C4...!?[VAR 0114(0027)]",
  "\uC88B\uC544...\\n\uC5B4\uC6B8\uB824 \uC900 \uBCF4\uB2F5\uC744 \uC8FC\uACA0\uC5B4.[VAR 0114(0027)]",
  "\uB9E4\uC6B0 \uAC00\uCE58\uAC00 \uB192\uC740 \uAC70\uB2C8\uAE4C\\n\uB9E4\uC77C \uBC24, \uC774 \uB808\uD3EC\uB974 \uC120\uC0DD\uB2D8\uC5D0\uAC8C\\r\\n\uAC10\uC0AC\uB97C \uC62C\uB9AC\uBA70 \uAC10\uC0C1\uD558\uB77C\uACE0.[VAR 0114(0027)]",
  "[~ 59]",
  "\uD06C\uD06C\uD06D, \uB108\uC758 \uADF8 \uAC15\uD568,\\n\uC5ED\uC2DC \uC720\uC6A9\uD574 \uBCF4\uC5EC...\\c\\n\uC774\uBC88\uC5D0\uB3C4 \uB1CC\uBB3C...\uC774 \uC544\uB2C8\uB77C\\n\uBCF4\uB2F5\uC744 \uC8FC\uACA0\uC5B4.[VAR 0114(0027)]",
  "\uC774 \uB808\uD3EC\uB974 \uC120\uC0DD\uB2D8\uACFC \uC313\uC544 \uC62C\uB9B0 \uC5ED\uC0AC\uAC00\\n\uBB34\uC5C7\uACFC\uB3C4 \uBC14\uAFC0 \uC218 \uC5C6\uB294 \uBCF4\uBB3C\uC774 \uB418\uBA74 \uC88B\uACA0\uAD70.[VAR 0114(0027)]",
  "\uD798\uC744 \uAC00\uC9C0\uACE0 \uC788\uC5B4\uB3C4 \uAD50\uB9CC\uC5D0 \uBE60\uC9C0\uBA74\\n\uD5C8\uB97C \uCC14\uB824\uC11C \uD328\uBC30\uD55C\uB2E4...\\c\\n\uC5ED\uC0AC\uC801\uC778 \uC5ED\uC804\uADF9\uC744\\n\uBAB8\uC18C \uC7AC\uD604\uD558\uACE0 \uC2F6\uC5C8\uB358 \uAC70\uC57C?[VAR 0114(0027)]",
  "\uC7AC\uC559\uC758 \uBCF4\uBB3C\uB4E4\uC740 \uC798 \uB2E4\uB8E8\uACE0 \uC788\uC5B4?\\c\\n\uB193\uC544\uC8FC\uACE0 \uC2F6\uC5B4\uC9C0\uAC70\uB4E0\\n\uC5B8\uC81C\uB4E0 \uB9D0\uB9CC \uD558\uB77C\uACE0.[VAR 0114(0027)]",
  "\uB108, \uD314\uB370\uC544\uC758 \uB300\uACF5\uC5D0\\n\uB4E4\uC5B4\uAC14\uC5C8\uB2E4\uB358\uB370, \uC9C4\uC9DC\uC57C?\\c\\n\uADF8\uAC8C \uC0AC\uC2E4\uC774\uB77C\uBA74 \uC790\uB8CC \uC218\uC9D1\uC744 \uC704\uD574\\n\uBA70\uCE60\uAC04 \uC2E0\uBCD1\uC744 \uD655\uBCF4\uD574\uC57C\uACA0\uAD70...[VAR 0114(0027)]",
  "\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC740 \uD655\uC2E4\uD788\\n\uB300\uB2E8\uD55C \uAE30\uC220\uB825\uC758 \uC0B0\uBB3C\uC774\uC57C...\\c\\n\uD558\uC9C0\uB9CC, \uC5ED\uC0AC\uAC00 \uC5C6\uB294 \uC65C\uACE1\uB41C \uC790\uC5F0\uC774\uB77C\\n\uAC1C\uC778\uC801\uC73C\uB85C\uB294 \uD765\uBBF8\uAC00 \uC548 \uC0DD\uAE30\uB354\uAD70.[VAR 0114(0027)]",
  "\uB124\uAC00 \uC900 [VAR 0101(0001)][VAR 1900(0001)]\\n\uAF64\uB098 \uC720\uC6A9\uD55C \uB140\uC11D\uC774\uC57C.\\r\\n\uC720\uC801 \uC870\uC0AC\uC5D0 \uB9CE\uC740 \uB3C4\uC6C0\uC774 \uB418\uACE0 \uC788\uB2E4\uACE0.[VAR 0114(0027)]",
  "\uB098\uB294 \uC624\uB798\uB41C \uBB3C\uAC74\uC744 \uBAA8\uC73C\uB294 \uAC8C\\n\uCDE8\uBBF8\uC778\uB370 \uB9D0\uC774\uC57C.\\c\\n\uB108\uC5D0\uAC8C \uC900 \uBAA8\uC73C\uB839\uC774\\n\uC624\uB798\uB41C \uB3D9\uC804\uC744 \uACC4\uC18D \uD0D0\uB0B4\uC11C \uACE4\uB780\uD588\uC5C8\uC5B4.[VAR 0114(0027)]"
]
