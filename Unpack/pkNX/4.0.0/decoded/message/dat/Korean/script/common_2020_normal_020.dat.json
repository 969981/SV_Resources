[
  "\uC800\uD558\uACE0\uB294 \uC0AC\uCC9C\uC655\uC804...\\n\uC2E4\uAE30 \uD14C\uC2A4\uD2B8 \uB54C \uC2F8\uC6CC \uBCF4\uC168\uC73C\uB2C8[VAR 0114(0015)]",
  "\uAC10\uACA9\uD558\uC2E4 \uB9CC\uD55C \uAC83\uC740\\n\uB531\uD788 \uC5C6\uC744 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4\uB9CC\\r\\n\uBAA8\uCABC\uB85D \uC798 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC624\uB298\uC740 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC73C\uB85C\uC11C \uB9CC\uB09C \uAC83\uC774\uB2C8\\n\uD3C9\uC18C\uC5D0 \uC4F0\uB358 \uD3EC\uCF13\uBAAC\uC744 \uC0AC\uC6A9\uD558\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uB178\uB9D0\uD0C0\uC785...\\n\uBCF4\uD1B5\uC5D0... \uBC0B\uBC0B\uD558\uACE0...\\r\\n\uD3C9\uBC94\uD558\uACE0... \uD754\uD55C \uC874\uC7AC...[VAR 0114(0015)]",
  "\uAC1C\uC131\uC774 \uC5C6\uB294 \uC800\uC640 \uC798 \uC5B4\uC6B8\uB824\uC11C\\n\uB098\uB984 \uC560\uCC29\uC744 \uAC00\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC778\uAC04\uC774\uB4E0 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC9C0\uAE08\uBCF4\uB2E4 \uD6E8\uC52C\\n\uB2E8\uC21C\uD574\uC9C0\uBA74 \uC88B\uC744 \uD150\uB370 \uB9D0\uC774\uC8E0.[VAR 0114(0015)]",
  "\uD2B9\uC774\uD558\uB2E4\uB290\uB2C8 \uAE30\uBC1C\uD558\uB2E4\uB290\uB2C8\\n\uD5C8\uC6B8\uBFD0\uC778 \uAC83\uC774 \uC88B\uC740 \uD3C9\uAC00\uB97C \uBC1B\uB294 \uC138\uC0C1\uC774\uC9C0\uB9CC[VAR 0114(0015)]",
  "\uC2E0\uB098\uB294 \uC5EC\uD589\uC9C0\uBCF4\uB2E4 \uC9D1\uC5D0 \uB3CC\uC544\uC654\uC744 \uB54C\uAC00\\n\uD6E8\uC52C \uB354 \uD3B8\uC548\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C?[VAR 0114(0015)]",
  "\uADF8\uB807\uC2B5\uB2C8\uB2E4.\\n\uC2EC\uD50C\uD55C \uAC83\uC774 \uAC00\uC7A5 \uAC15\uD55C \uAC83\uC785\uB2C8\uB2E4![VAR 0114(0015)]",
  "\uD3C9\uBC94\uD55C \uC81C\uAC8C \uB2F9\uC2E0\uC740\\n\uB108\uBB34\uB098\uB3C4 \uAC15\uD55C \uC790\uADF9\uC774\uAD70\uC694...[VAR 0114(0015)]",
  "...\uD558\uC9C0\uB9CC \uC870\uAE08\uC740 \uC54C \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC0AC\uCC9C\uC655\uC744 \uD560 \uB54C\uB294 \uBE44\uD589\uD0C0\uC785\uC744\\n\uC0AC\uC6A9\uD558\uB77C\uACE0 \uD55C \uC774\uC720\uB97C \uB9D0\uC785\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uD3C9\uD0C4\uD55C \uAE38\uC744 \uAC77\uAE30\uB9CC \uD574\uC11C\uB294\\n\uB193\uCE58\uAC8C \uB418\uB294 \uACBD\uCE58\uAC00 \uC788\uB2E4...[VAR 0114(0015)]",
  "\uAC00\uB054\uC740 \uB2F9\uC2E0\uACFC \uAC19\uC774 \uBE44\uBC94\uD55C \uC7AC\uB2A5\uC744\\n\uBCFC \uD544\uC694\uAC00 \uC788\uB2E4\uB294 \uB73B\uC778 \uAC70\uACA0\uC9C0\uC694.[VAR 0114(0015)]",
  "\uD558\uC9C0\uB9CC \uC5B4\uB514\uAE4C\uC9C0\uB098 \uC5C5\uBB34\uB77C\uC11C \uD558\uB294 \uAC81\uB2C8\uB2E4.\\n\uC6D0\uD574\uC11C \uD558\uB294 \uAC8C \uC544\uB2C8\uB77C\uB294 \uAC78 \uC54C\uC544 \uB450\uC2DC\uAE38.[VAR 0114(0015)]",
  "\uC624\uB298\uC740 \uC57C\uADFC \uC5C6\uB294 \uB0A0\uC774\uB2C8\\n\uC800\uB294 \uC774\uB9CC \uC2E4\uB840\uD558\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]"
]
