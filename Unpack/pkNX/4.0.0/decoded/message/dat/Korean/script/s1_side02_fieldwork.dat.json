[
  "\uD3EC\uCF13\uBAAC\uC758 \uC0AC\uC9C4\uC744 \uCD2C\uC601\uD558\uBA74\uC11C\\n\uC232\uC744 \uC870\uC0AC\uD574 \uC8FC\uC9C0 \uC54A\uC744\uB798?[VAR 0114(0046)]",
