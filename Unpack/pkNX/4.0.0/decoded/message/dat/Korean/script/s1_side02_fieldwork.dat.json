  "\uC9C0\uAE08\uCBE4\uC774\uBA74 \uAD1C\uCC2E\uACA0\uC5B4.\\n\uC870\uC0AC\uB97C \uBD80\uD0C1\uD560\uAC8C, \uC870\uC218.[VAR 0114(0046)]",
  "\uC0AC\uC9C4\uC744 \uCC0D\uC5C8\uAD6C\uB098!\\n\uC5B4\uB514 \uBCF4\uC790...[VAR 0114(0046)]",
  "\uD749\uB0B4\uD3EC\uCF13\uBAAC \uAF2C\uC9C0\uBAA8\uB124!\\n\uC548\uAC1C \uC18D\uC774\uB77C \uADF8\uB7F0\uAC00 \uC9C4\uC9DC \uB098\uBB34\uB85C \uCC29\uAC01\uD558\uACA0\uC5B4![VAR 0114(0046)]",
  "\uC591\uCD08\uD3EC\uCF13\uBAAC \uBD88\uCF1C\uBBF8\uC796\uC544!\\n\uC5B4\uB450\uC6B4 \uBC24\uC5D0 \uB5A0 \uC788\uB294 \uBD88\uAF43\uC774 \uD658\uC0C1\uC801\uC774\uC57C![VAR 0114(0046)]",
  "\uCC28\uBD84\uD3EC\uCF13\uBAAC \uBAB8\uC9C0\uBE0C\uB9BC\uC774\uB124!\\n\uC870\uC6A9\uD55C \uC232\uC18D\uC774\uB77C \uB9C8\uC74C\uC774 \uD3B8\uD55C\uAC00 \uBD10![VAR 0114(0046)]",
  "\uC554\uC11D\uD3EC\uCF13\uBAAC \uAF2C\uB9C8\uB3CC\uC774\uC796\uC544!\\n\uAC78\uB824 \uB118\uC5B4\uC9C0\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574\uC57C\uACA0\uC5B4![VAR 0114(0046)]",
  "\uB3C5\uB3C4\uB9C8\uBC40\uD3EC\uCF13\uBAAC \uC57C\uB3C4\uB1FD\uC774\uB124!\\n\uC5B4\uB460 \uC18D\uC5D0\uC11C \uBA39\uC774\uB97C \uCC3E\uACE0 \uC788\uB294 \uAC74\uAC00?[VAR 0114(0046)]",
  "\uBFD4\uC9D1\uAC8C\uD3EC\uCF13\uBAAC \uD22C\uAD6C\uBFCC\uB17C\uC774\uC796\uC544!\\n\uCEE4\uB2E4\uB780 \uD131\uC774 \uC0AC\uC9C4\uBC1C\uC744 \uC798 \uBC1B\uB294 \uAC83 \uAC19\uC544!![VAR 0114(0046)]",
  "\uBC18\uB527\uBD88\uD3EC\uCF13\uBAAC \uB124\uC624\uBE44\uD2B8\uB124!\\n\uBCFC\uBE44\uD2B8\uC640\uB294 \uC0AC\uC774\uAC00 \uC88B\uB2E4\uB098 \uBD10.[VAR 0114(0046)]",
  "\uB3C4\uD1A0\uB9AC\uD3EC\uCF13\uBAAC \uB3C4\uD1A0\uB9C1\uC778\uAC00...!?\\n\uC21C\uAC04 \uB098\uBB34\uC5F4\uB9E4\uC778 \uC904 \uC54C\uC558\uC5B4![VAR 0114(0046)]",
