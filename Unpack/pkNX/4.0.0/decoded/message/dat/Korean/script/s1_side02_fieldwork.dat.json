  "\uC74C... \uC774\uAC83\uBCF4\uB2E4\uB294 \uB354\\n\uC120\uBA85\uD558\uAC8C \uCC0D\uD600\uC57C \uD560 \uAC83 \uAC19\uC544.\\r\\n\uB370\uC774\uD130\uB97C \uC2A4\uCE94\uD558\uC9C0 \uBABB\uD588\uC5B4.[VAR 0114(0046)]",
  "\uC774 \uD3EC\uCF13\uBAAC\uC740 \uC774\uBBF8 \uCC0D\uC5C8\uC5C8\uC5B4!\\n\uB2E4\uC74C\uC5D0\uB294 \uBCF8 \uC801 \uC5C6\uB294 \uD3EC\uCF13\uBAAC\uC744 \uCC0D\uC5B4 \uBCF4\uC790![VAR 0114(0046)]",
  "\uC74C... \uC774\uAC83\uBCF4\uB2E4\uB294 \uB354\\n\uD06C\uAC8C \uCC0D\uD600\uC57C \uD560 \uAC83 \uAC19\uC544.\\r\\n\uB370\uC774\uD130\uB97C \uC2A4\uCE94\uD558\uC9C0 \uBABB\uD588\uC5B4.[VAR 0114(0046)]",
