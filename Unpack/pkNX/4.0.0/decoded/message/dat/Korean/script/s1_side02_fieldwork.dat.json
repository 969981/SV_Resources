  "\uBCFC\uAC00\uB4DD\uD3EC\uCF13\uBAAC \uD0D0\uB9AC\uC2A4\uC796\uC544!\\n\uB098\uBB34 \uC704\uC5D0\uC11C \uBA39\uC744 \uAC83\uC744 \uCC3E\uACE0 \uC788\uB098 \uBD10![VAR 0114(0046)]",
  "\uAC1C\uAD6C\uB9AC\uBC25\uD3EC\uCF13\uBAAC \uC5F0\uAF43\uBAAC\uC774\uB124!\\n\uB465\uC2E4\uB465\uC2E4 \uB5A0 \uC788\uB294 \uAC8C \uC5EC\uC720\uB85C\uC6CC \uBCF4\uC5EC![VAR 0114(0046)]",
  "\uC804\uAE30\uBB3C\uACE0\uAE30\uD3EC\uCF13\uBAAC \uC800\uB9AC\uC5B4\uC796\uC544!\\n\uC774\uB807\uAC8C\uB098 \uC791\uC740\uB370 \uC6A9\uCF00 \uCC3E\uC544\uB0C8\uB124![VAR 0114(0046)]",
  "\uBC18\uB527\uBD88\uD3EC\uCF13\uBAAC \uBCFC\uBE44\uD2B8\uB124!\\n\uC5C9\uB369\uC774\uB85C \uBE5B\uC758 \uC0AC\uC778\uC744 \uADF8\uB9B0\uB2E4\uB098 \uBD10.[VAR 0114(0046)]",
  "\uB9C8\uC911\uD3EC\uCF13\uBAAC \uD574\uACE8\uBABD...!\\n\uBC24\uC5D0 \uBCF4\uB2C8\uAE4C \uAF64\uB098 \uBD84\uC704\uAE30 \uC788\uB294\uAC78![VAR 0114(0046)]",
  "\uBD80\uC5C9\uC774\uD3EC\uCF13\uBAAC \uBD80\uC6B0\uBD80\uB124!\\n\uC5B8\uC820\uAC04 \uAF2D, \uBC1C\uC744 \uBC14\uAFB8\uB294 \uC21C\uAC04\uC744 \uCC0D\uC5B4 \uBD10\uC57C\uC9C0![VAR 0114(0046)]",
  "\uC624\uC624! \uBC18\uB527\uBD88\uD3EC\uCF13\uBAAC\uC778\\n\uBCFC\uBE44\uD2B8\uC640 \uB124\uC624\uBE44\uD2B8\uC796\uC544!\\r\\n\uC798 \uC5B4\uC6B8\uB9AC\uB294 \uD22C\uC0F7\uC774\uB124![VAR 0114(0046)]",
  "\uBC18\uB527\uBD88\uD3EC\uCF13\uBAAC \uB124\uC624\uBE44\uD2B8\uB124!\\n\uAC19\uC774 \uC788\uB294 \uBCFC\uBE44\uD2B8\uAC00\\r\\n\uB9CC\uB098\uB7EC \uC654\uB098 \uBD10![VAR 0114(0046)]",
  "\uBC18\uB527\uBD88\uD3EC\uCF13\uBAAC \uBCFC\uBE44\uD2B8\uB124!\\n\uAC19\uC774 \uC788\uB294 \uB124\uC624\uBE44\uD2B8\uB97C\\r\\n\uB9CC\uB098\uB7EC \uC628 \uAC74\uAC00 \uBD10![VAR 0114(0046)]",
  "\uC815\uB9D0 \uC88B\uC740\uB370!\\n\uB108\uC5D0\uAC8C \uBD80\uD0C1\uD558\uAE38 \uC815\uB9D0 \uC798 \uD55C \uAC83 \uAC19\uC544![VAR 0114(0046)]",
  "\uC6B0\uB9AC \uC870\uC218\uB294 \uC0AC\uC9C4\uB3C4 \uC798 \uCC0D\uB124!\\c\\n\uC0B4\uC9DD \uB192\uC740 \uACF3\uB3C4 \uC798 \uC0B4\uD3B4\uBD24\uB2C8?\\n\uB098\uBB34 \uC704\uC5D0 \uD3EC\uCF13\uBAAC\uC774 \uC788\uC744 \uB54C\uB3C4 \uC788\uAC70\uB4E0![VAR 0114(0046)]",
  "\uC6B0\uB9AC \uC870\uC218\uAC00 \uC544\uC8FC \uC13C\uC2A4 \uC788\uB294\uAC78!\\c\\n\uB108\uB77C\uBA74 \uB3CC\uC544\uB2E4\uB2C8\uB294 \uD3EC\uCF13\uBAAC\uB3C4\\n\uBB38\uC81C\uC5C6\uC774 \uCC0D\uC744 \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(0046)]",
  "\uC5ED\uC2DC \uC6B0\uB9AC \uC870\uC218\uC57C~!\\c\\n\uADFC\uCC98 \uB3D9\uAD74\uC5D0\uB3C4 \uD3EC\uCF13\uBAAC\uC774 \uC788\uC744\uC9C0 \uBAB0\uB77C!\\n\uB108\uB77C\uBA74 \uBB38\uC81C\uC5C6\uC774 \uCC0D\uC744 \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(0046)]",
  "\uC0AC\uC9C4\uC5D0 \uAF64\uB098 \uC7AC\uB2A5\uC774 \uC788\uB294 \uAC83 \uAC19\uC544!\\c\\n\uBD81\uC11C\uCABD \uBB3C\uAC00\uC5D0 \uC0AC\uB294 \uD3EC\uCF13\uBAAC\uC744 \uCC0D\uB294 \uAC83\uB3C4\\n\uB108\uB77C\uBA74 \uB204\uC6CC\uC11C \uB5A1 \uBA39\uAE30\uC77C \uAC70\uC57C![VAR 0114(0046)]",
  "\uC74C... \uC798 \uCC0D\uC5C8\uC5B4!\\c\\n\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC544\uAE4C \uBC14\uC704 \uADFC\uCC98\uC5D0\uC11C\\n\uBB54\uAC00\uC5D0 \uAC78\uB824\uC11C \uB118\uC5B4\uC9C8 \uBED4\uD588\uC5B4!\\r\\n\uB108\uB3C4 \uB2E4\uB2D0 \uB54C \uBC1C\uBC11\uC744 \uC870\uC2EC\uD558\uB3C4\uB85D \uD558\uB834![VAR 0114(0046)]",
  "\uD3C9\uC18C\uC5D0\uB3C4 \uC0AC\uC9C4\uC744 \uC790\uC8FC\\n\uCC0D\uB294 \uD3B8\uC778\uAC00 \uBCF4\uAD6C\uB098?\\c\\n\uACBD\uACC4\uC2EC\uC774 \uAC15\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uB108\uBB34 \uC811\uADFC\uD558\uBA74 \uB3C4\uB9DD\uCCD0 \uBC84\uB9AC\uB294\uB370,\\r\\n\uB108\uB294 \uBC8C\uC368 \uC54C\uACE0 \uC788\uB294 \uAC83 \uAC19\uB124![VAR 0114(0046)]",
  "\uB2E4\uC591\uD55C \uD0C0\uC785\uC758 \uD3EC\uCF13\uBAAC\uC758\\n\uBA4B\uC9C4 \uC0AC\uC9C4\uB4E4\uC774 \uBAA8\uC774\uACE0 \uC788\uC5B4!\\c\\n\uACE0\uC2A4\uD2B8\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC740\\n\uBAA8\uC2B5\uC744 \uAC10\uCD94\uAE30 \uC804\uC5D0 \uCC0D\uC5B4\uC57C \uD574![VAR 0114(0046)]",
  "...\uC74C! \uD3EC\uCF13\uBAAC\uC758\\n\uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uBAA8\uC2B5\uC744 \uC798 \uB2F4\uC544\uB0B8 \uAC83 \uAC19\uC544!\\c\\n\uC774 \uC815\uB3C4 \uC2E4\uB825\uC774\uB77C\uBA74, \uD3EC\uCF13\uBAAC\uC774 \uB098\uBB34 \uC704\uC5D0\uC11C\\n\uBA39\uC774\uB97C \uCC3E\uB294 \uBAA8\uC2B5\uB3C4 \uCC0D\uC744 \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(0046)]",
  "\uC5ED\uC2DC \uC6B0\uB9AC \uC870\uC218\uC57C!\\n\uD2B9\uC0C9 \uC788\uB294 \uBA4B\uC9C4 \uC0AC\uC9C4\uC778\uAC78!\\c\\n\uADF8\uB7EC\uACE0 \uBCF4\uB2C8, \uC5EC\uAE30\uC11C \uBD81\uB3D9\uCABD\uC5D0\uC11C\\n\uBCBC\uB77D\uC774 \uB5A8\uC5B4\uC9C0\uB294 \uAC83 \uAC19\uC740 \uC18C\uB9AC\uAC00 \uB0AC\uC5C8\uC5B4.\\r\\n\uC804\uAE30\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC774 \uC788\uB294 \uAC78\uAE4C?[VAR 0114(0046)]",
  "\uBAA8\uD2F0\uBE0C\uB3C4 \uAD6C\uB3C4\uB3C4 \uC644\uBCBD\uD574!\\n\uC870\uC218\uB85C\uB9CC \uB450\uAE30\uC5D0 \uC544\uAE4C\uC6B8 \uC815\uB3C4\uC57C...\\c\\n\uADF8\uAC74 \uADF8\uB807\uACE0, \uBD81\uC11C\uCABD\uC5D0 \uBB3C\uAC00\uAC00 \uC788\uB358\uB370\\n\uADF8\uCABD\uC5D0\uB294 \uAC00 \uBD24\uB2C8?[VAR 0114(0046)]",
  "\uC548\uAC1C \uB080 \uC232\uC5D0\uB294 \uC544\uC9C1\\n\uB354 \uB9CE\uC740 \uD3EC\uCF13\uBAAC\uC774 \uC228\uC5B4 \uC788\uC744 \uAC70\uC57C.[VAR 0114(0046)]",
  "\uACC4\uC18D\uD574\uC11C \uC5F4\uC2EC\uD788 \uC870\uC0AC\uD558\uC790!\\n\uAE30\uB300\uD558\uACE0 \uC788\uC744\uAC8C, \uC870\uC218![VAR 0114(0046)]",
