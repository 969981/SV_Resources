[
  "\uBBF8\uBAA8\uC0AC\uC758 \uBCF4\uAC74\uC2E4\uC5D0 \uC798 \uC654\uC5B4~[VAR 0114(0028)]",
  "\uC624\uB298\uC740 \uBB34\uC2A8 \uC77C\uB85C \uC654\uB2C8?\\n\uB108\uB3C4 \uD3EC\uCF13\uBAAC\uB3C4\\r\\n\uC644\uC804 \uAC74\uAC15\uD574 \uBCF4\uC774\uB294 \uAC83 \uAC19\uC740\uB370...[VAR 0114(0028)]",
  "...\uC5B4\uB77C?\\n\uC6B0\uB9AC \uCC98\uC74C \uBCF4\uB294 \uC0AC\uC774\uC778 \uAC70 \uAC19\uC740\uB370, \uB9DE\uC9C0?[VAR 0114(0028)]",
  "\uD750\uC74C~\\n\uC804\uD559 \uC628 \uC9C0 \uC5BC\uB9C8 \uC548 \uB410\uAD6C\uB098~[VAR 0114(0028)]",
  "\uC5D0\uC774, \uC18D\uC774\uB824\uACE0 \uD574 \uBD24\uC790\\n\uB098\uD55C\uD14C\uB294 \uC548 \uD1B5\uD55C\uB2E4\uAD6C...[VAR 0114(0028)]",
  "\uC544~ [VAR 0100(0000)][VAR 1900(0006)]\uAD6C\uB098!\\n\uC18C\uBB38\uC758 \uADF8 \uC544\uC774\uC778\uAC00 \uBCF4\uB124~[VAR 0114(0028)]",
  "\uC785\uD559 \uCCAB\uB0A0\uBD80\uD130 \uC808\uBCBD\uC5D0\uC11C \uB5A8\uC5B4\uC84C\uB2E4\uB290\uB2C8\\n\uC2A4\uD0C0\uB2E8\uC774\uB791 \uD55C\uD310 \uBD99\uC5C8\uB2E4\uB290\uB2C8\\r\\n\uAF64\uB098 \uC720\uBA85\uD558\uB2E4\uAD6C~[VAR 0114(0028)]",
  "\uC544, \uADF8\uB807\uC9C0!\\n\uBCF4\uBB3C\uCC3E\uAE30\uC600\uB098? \uADF8\uAC70 \uC2DC\uC791\uD588\uC9C0?[VAR 0114(0028)]",
  "\uBC16\uC5D0\uC11C \uC7AC\uBBF8\uC788\uB294 \uC77C\uC774 \uC0DD\uAE30\uBA74\\n\uBCF4\uAC74\uC2E4\uC5D0 \uB4E4\uB7EC\uC11C \uC774\uC57C\uAE30\uD574 \uC8FC\uB77C.[VAR 0114(0028)]",
  "\uB0B4\uAC00 \uC880 \uC9C0\uB8E8\uD574\uC11C \uB9D0\uC774\uC57C~\\n\uC218\uC5C5\uC744 \uD558\uB294 \uAC83\uB3C4 \uC544\uB2C8\uACE0,\\r\\n\uC5EC\uAE30\uC5D0\uB294 \uB561\uB561\uC774\uCE58\uB7EC \uC624\uB294 \uC560\uB4E4\uBFD0\uC774\uACE0...[VAR 0114(0028)]",
  "\uADF8\uB7FC \uC798 \uBD80\uD0C1\uD574~\\n\uC57D\uC18D\uC774\uC57C~[VAR 0114(0028)]",
  "\uBBF8\uBAA8\uC0AC \uC120\uC0DD\uB2D8\uACFC\\n\uC870\uAE08 \uCE5C\uD574\uC84C\uB2E4!"
