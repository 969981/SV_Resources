[
  "\uB2E4\uB4E4 \uBAA8\uC774\uC168\uB098\uC694?[VAR 0114(000A)]",
  "\uADF8\uB7FC, \uC9C0\uAE08\uBD80\uD130\\n\uC790\uC728 \uD559\uC2B5 \uD504\uB85C\uADF8\uB7A8\uC5D0 \uB300\uD574 \uC124\uBA85\uD558\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uACFC\uC81C\uC758 \uD14C\uB9C8\uB294 \u201C\uBCF4\uBB3C\uCC3E\uAE30\u201D![VAR 0114(000A)]",
  "\uC5EC\uB7EC\uBD84\uC740 \uC138\uACC4\uB97C \uC5EC\uD589\uD558\uBA74\uC11C\\n\uC790\uC2E0\uB9CC\uC758 \uBCF4\uBB3C\uC744 \uCC3E\uC73C\uC2DC\uBA74 \uB429\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC9C0\uAE08\uAE4C\uC9C0 \uC5EC\uB7EC\uBD84\uC740 \uD559\uAD50 \uC548\uC5D0\uC11C\\n\uB2E4\uC591\uD55C \uC9C0\uC2DD\uC744 \uBC30\uC6CC \uC624\uC168\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uADF8\uB7EC\uB098 \uC774\uC81C\uBD80\uD130\uB294 \uBC14\uAE65 \uC138\uACC4\uB3C4\\n\uACBD\uD5D8\uD558\uBA74\uC11C \uACAC\uBB38\uC744 \uB113\uD788\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uD314\uB370\uC544\uC758 \uD48D\uC694\uB85C\uC6B4 \uC790\uC5F0\uACFC \uBB38\uD654...[VAR 0114(000A)]",
  "\uADF8 \uC18D\uC5D0 \uC0AC\uB294 \uD3EC\uCF13\uBAAC\uB4E4...[VAR 0114(000A)]",
  "\uADF8\uB9AC\uACE0 \uC0AC\uB78C\uB4E4...[VAR 0114(000A)]",
  "\uC5B4\uB514\uC5D0 \uAC00\uC11C\\n\uB204\uAD6C\uB97C \uB9CC\uB098\uACE0, \uBB34\uC5C7\uC744 \uC774\uB8F0\uC9C0.[VAR 0114(000A)]",
  "\uAC01\uC790 \uC790\uC2E0\uC758 \uD3EC\uCF13\uBAAC\uB4E4\uACFC[VAR 0114(000A)]",
  "\uD568\uAED8 \uAC77\uACE0...[VAR 0114(000A)]",
  "\uD568\uAED8 \uC0DD\uAC01\uD558\uBA70...[VAR 0114(000A)]",
  "\uADF8\uB9AC\uACE0 \uD568\uAED8 \uB290\uB07C\uBA74\uC11C...[VAR 0114(000A)]",
  "\uC790\uC2E0\uB9CC\uC758 \uBCF4\uBB3C\uC744 \uCC3E\uC544\uC11C\\n\uB3CC\uC544\uC640 \uC8FC\uC2ED\uC2DC\uC624![VAR 0114(000A)]",
  "\uC774\uBC88 \uC790\uC728 \uD559\uC2B5\uC744 \uD1B5\uD574\\n\uD06C\uAC8C \uC131\uC7A5\uD55C \uC5EC\uB7EC\uBD84\uACFC[VAR 0114(000A)]",
  "\uB2E4\uC2DC \uC778\uC0AC\uD558\uAC8C \uB420 \uADF8\uB0A0\uC744\\n\uC9C4\uC2EC\uC73C\uB85C \uAE30\uB300\uD558\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uADF8\uB7FC, \uBCF4\uBB3C\uCC3E\uAE30 \uC2DC\uC791!\\n...\uC548\uB155\uD788 \uB2E4\uB140\uC624\uC2ED\uC2DC\uC624![VAR 0114(000A)]"
]
