[
  "\uC81C\uAD70\uB4E4, \uC218\uC5C5\uC744 \uC2DC\uC791\uD558\uACA0\uB2E4.\\n\uC2A4\uB9C8\uD2B8\uD3F0\uC740 \uC9D1\uC5B4\uB123\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uC9C0\uB09C \uC218\uC5C5\uC5D0\uC11C\uB294\\nHP\uB97C \uD68C\uBCF5\uD558\uB294 \uBC95\uC5D0 \uB300\uD574 \uC124\uBA85\uD588\uC5C8\uB294\uB370...[VAR 0114(0029)]",
  "\uC218\uC5C5\uC774 \uB05D\uB098\uACE0 \uC77C\uBD80 \uD559\uC0DD\uB4E4\uC774\\n[VAR FF00(0006)]PP(\uD30C\uC6CC\uD3EC\uC778\uD2B8)[VAR FF00(0000)]\uC5D0 \uB300\uD574 \uC9C8\uBB38\uD558\uB354\uAD70.[VAR 0114(0029)]",
  "HP\uAC00 0\uC774 \uB418\uBA74 \uAE30\uC808 \uC0C1\uD0DC\uAC00 \uB418\uC5B4\\n\uD3EC\uCF13\uBAAC\uC774 \uC2F8\uC6B8 \uC218\uAC00 \uC5C6\uB2E4![VAR 0114(0029)]",
  "\uADF8\uB807\uB2E4\uBA74, PP\uAC00 0\uC774 \uB418\uBA74\\n\uD3EC\uCF13\uBAAC\uC740 \uC5B4\uB5BB\uAC8C \uB418\uC9C0?[VAR 0114(0029)]",
  "\uAE30\uC220\uC744 \uC4F8 \uC218 \uC5C6\uAC8C \uB41C\uB2E4",
  "\uB9D0\uC744 \uB4E3\uC9C0 \uC54A\uAC8C \uB41C\uB2E4",
  "\uBAA8\uB4E0 \uB2A5\uB825\uC774 \uB5A8\uC5B4\uC9C4\uB2E4",
  "\uD6CC\uB96D\uD55C \uB2F5\uBCC0\uC774\uC5C8\uB2E4, [VAR 0100(0000)].\\n\uC9C1\uC811 \uACBD\uD5D8\uC744 \uD1B5\uD574 \uD130\uB4DD\uD55C \uAC74\uAC00?[VAR 0114(0029)]",
  "\uC704\uD5D8\uD55C \uC0C1\uD0DC\uAC00 \uB418\uB294 \uAC74 \uB9DE\uC9C0\uB9CC \uD2C0\uB838\uB2E4.\\c\\n...\uB9D0\uC744 \uB4E3\uACE0 \uC548 \uB4E3\uACE0\uB294\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uC758 \uAC1C\uC218\uC5D0 \uB530\uB77C \uACB0\uC815\uB418\uB2C8\uAE4C.[VAR 0114(0029)]",
  "\uC704\uD5D8\uD55C \uC0C1\uD0DC\uAC00 \uB418\uB294 \uAC74 \uB9DE\uC9C0\uB9CC \uD2C0\uB838\uB2E4.\\c\\n\uADF8\uB7F0 \uD30C\uC6CC\uB97C \uB0B4\uAC8C \uD558\uB294\\n\uD3EC\uC778\uD2B8\uAC00 \uC544\uB2C8\uB2C8\uAE4C.[VAR 0114(0029)]",
  "PP\uAC00 0\uC774 \uB41C \uD3EC\uCF13\uBAAC\uC740\\n\uAE30\uC220\uC744 \uC4F8 \uC218 \uC5C6\uAC8C \uB41C\uB2E4.[VAR 0114(0029)]",
  "PP\uB294 \uAE30\uC220\uB9C8\uB2E4 \uB2E4\uB974\uB2C8\uAE4C\\n\uAC19\uC740 \uAE30\uC220\uB9CC \uC0AC\uC6A9\uD558\uB294 \uAC83\uBCF4\uB2E4\\r\\n\uACE8\uACE0\uB8E8 \uC0AC\uC6A9\uD558\uBA74 \uD6A8\uC728\uC801\uC73C\uB85C \uAD00\uB9AC\uD560 \uC218 \uC788\uC9C0.[VAR 0114(0029)]",
  "\uBAA8\uB4E0 \uAE30\uC220\uC758 PP\uAC00 0\uC774 \uB418\uBA74\\n\uC790\uC2E0\uC5D0\uAC8C\uB3C4 \uB370\uBBF8\uC9C0\uB97C \uC8FC\uB294\\r\\n\uBC1C\uBC84\uB465\uC774\uB77C\uB294 \uD589\uB3D9\uBC16\uC5D0 \uD558\uC9C0 \uBABB\uD558\uAC8C \uB41C\uB2E4.[VAR 0114(0029)]",
  "\uADF8\uB807\uAC8C \uB418\uC9C0 \uC54A\uAC8C PP\uB3C4 HP\uC640 \uB9C8\uCC2C\uAC00\uC9C0\uB85C\\n\uD3EC\uCF13\uBAAC\uC13C\uD130\uC5D0\uC11C \uD68C\uBCF5\uC2DC\uD0A4\uB3C4\uB85D.[VAR 0114(0029)]",
  "PP\uC5D0\uC774\uB4DC\uB098 PP\uD68C\uBCF5\uCC98\uB7FC\\nPP\uB97C \uD68C\uBCF5\uC2DC\uD0A4\uB294 \uB3C4\uAD6C\uB3C4 \uC788\uB2E4.\\r\\n\uC774\uB984\uC5D0 PP\uAC00 \uB4E4\uC5B4 \uC788\uB294 \uAC83\uC774 \uD2B9\uC9D5\uC774\uC9C0.[VAR 0114(0029)]",
  "\uB2E8, \uC0C1\uC810\uC5D0\uC11C\uB294 \uD314\uC9C0 \uC54A\uC73C\uB2C8\\n\uBC1C\uACAC\uD588\uB2E4\uBA74 \uC544\uAEF4\uC11C \uC0AC\uC6A9\uD558\uB294 \uAC8C \uC88B\uC744 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uAC15\uD55C \uAE30\uC220\uC77C\uC218\uB85D \uCD5C\uB300 PP\uAC00 \uC801\uC5B4\uC11C\\n\uB0A8\uBC1C\uD588\uB2E4\uAC00\uB294 \uAE08\uBC29 \uACE0\uAC08\uB420 \uD14C\uB2C8\\r\\n\uAE30\uC220\uC758 \uBC38\uB7F0\uC2A4\uB3C4 \uC911\uC694\uD558\uB2E4\uACE0 \uD560 \uC218 \uC788\uC9C0.[VAR 0114(0029)]",
  "\uD3EC\uCF13\uBAAC\uACFC \uBAA8\uD5D8\uD558\uB294 \uB370 \uC788\uC5B4\uC11C\\nHP\uB9CC \uC2E0\uACBD \uC368\uC11C\uB294 \uC548 \uB41C\uB2E4\uB294 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uD30C\uD2B8\uB108\uAC00 \uCD5C\uC0C1\uC758 \uD37C\uD3EC\uBA3C\uC2A4\uB97C\\n\uB0BC \uC218 \uC788\uB3C4\uB85D \uC2E0\uACBD \uC4F0\uBA74\uC11C\\r\\n\uBCF4\uBB3C\uCC3E\uAE30\uC5D0 \uB098\uC11C\uB3C4\uB85D \uD574\uB77C.[VAR 0114(0029)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4.\\n\uB2E4\uC74C \uC2DC\uAC04\uC740 \uC2DC\uD5D8\uC744 \uBCF4\uB294 \uB0A0\uC774\uAD70.\\r\\n\uCC29\uC2E4\uD558\uAC8C \uBCF5\uC2B5\uD574 \uC624\uB3C4\uB85D.[VAR 0114(0029)]"
]
