[
  "[~ 252]",
  "\uB204\uAD70\uAC00\uAC00 \uC790\uAE30 \uBD84\uC218\uB3C4 \uBAA8\uB974\uACE0\\n\uC544\uC9C0\uD2B8\uC5D0 \uCE68\uC785\uD588\uC2B5\uB2C8\uB2E4!\\c\\n\uC2A4\uD0C0\uB2E8\uC758 \uBB34\uC11C\uC6C0\uC744 \uAE68\uB2EB\uAC8C \uD574 \uC8FC\uACE0\\n\uCAD3\uC544\uB0B4\uB294 \uAC81\uB2C8\uB2E4![VAR 0114(002F)]",
  "\uAC01\uC624\uD574\uB77C, \uCE68\uC785\uC790! \uB9CC\uC57D \uB124\uAC00 [VAR 0201(0001)]\uBD84 \uC774\uB0B4\uC5D0\\n\uC6B0\uB9AC\uC758 \uD3EC\uCF13\uBAAC\uC744 [VAR 0201(0002)]\uB9C8\uB9AC \uC4F0\uB7EC\uB728\uB9AC\uBA74\\r\\n\uBCF4\uC2A4\uAC00 \uB9CC\uB098 \uC8FC\uC2E4\uC9C0\uB3C4 \uBAA8\uB974\uC9C0![VAR 0114(002F)]",
  "[~ 252]",
  "\uC6B4 \uC88B\uAC8C \uB2E4\uB978 \uD300\uC744 \uC774\uAE34 \uB140\uC11D\uC774\\n\uC544\uC9C0\uD2B8\uC5D0 \uCE68\uC785\uD588\uC2B5\uB2C8\uB2E4!\\c\\n\uC2A4\uD0C0\uB2E8\uC758 \uD798\uC744 \uBCF4\uC5EC \uC904 \uB54C\uC785\uB2C8\uB2E4!\\n\uD798\uC744 \uD569\uCCD0 \uCE68\uC785\uC790\uB97C \uBAB0\uC544\uB0C5\uC2DC\uB2E4![VAR 0114(002F)]",
  "\uB140\uC11D\uC774 [VAR 0201(0001)]\uBD84 \uC774\uB0B4\uC5D0\\n\uC6B0\uB9AC \uD3EC\uCF13\uBAAC\uC744 [VAR 0201(0002)]\uB9C8\uB9AC \uC4F0\uB7EC\uB728\uB9B0\uB2E4\uBA74 \uBAA8\uB97C\uAE4C\\r\\n\uBCF4\uC2A4\uC758 \uC190\uC744 \uBE4C\uB9B4 \uC21C \uC5C6\uC9C0!![VAR 0114(002F)]",
  "[~ 252]",
  "\uB4DC\uB514\uC5B4 \uC6B0\uB9AC \uC544\uC9C0\uD2B8\uC5D0\uB3C4\\n\uC2A4\uD0C0\uB354\uC2A4\uD2B8 \uC5B4\uCA4C\uACE0\uAC00 \uCC3E\uC544\uC654\uC2B5\uB2C8\uB2E4!\\c\\n\uB2E4\uB978 \uD300\uB4E4\uC758 \uC6D0\uC218\uB97C \uAC1A\uC544\uC11C\\n\uB2E4 \uD568\uAED8 \uBE5B\uB098\uB294 \uAC81\uB2C8\uB2E4![VAR 0114(002F)]",
  "\uB364\uBCBC\uB77C, \uCE68\uC785\uC790! \uB9CC\uC57D \uB124\uAC00 [VAR 0201(0001)]\uBD84 \uC774\uB0B4\uC5D0\\n\uB2E8\uC758 \uD3EC\uCF13\uBAAC\uC744 [VAR 0201(0002)]\uB9C8\uB9AC \uC4F0\uB7EC\uB728\uB9AC\uBA74\\r\\n\uBCF4\uC2A4\uAC00 \uB108\uB97C \uC778\uC815\uD574 \uC8FC\uC2E4\uC9C0\uB3C4 \uBAA8\uB974\uC9C0!![VAR 0114(002F)]",
  "[~ 252]",
  "\uAE34\uAE09 \uC0AC\uD0DC! \uC2A4\uD0C0\uB354\uC2A4\uD2B8 \uB300\uC791\uC804\uC758\\n[VAR 0100(0000)] \uBC1C\uACAC!\\c\\n\uC2E0\uC18D\uD558\uAC8C \uD0DC\uC138\uB97C \uC815\uBE44\uD558\uACE0\\n\uBCF4\uC2A4\uB97C \uC9C0\uD0A4\uC790![VAR 0114(002F)]",
  "\uB140\uC11D\uC774 [VAR 0201(0001)]\uBD84 \uC774\uB0B4\uC5D0\\n\uC6B0\uB9AC \uD3EC\uCF13\uBAAC\uC744 [VAR 0201(0002)]\uB9C8\uB9AC \uC4F0\uB7EC\uB728\uB9AC\uAE30 \uC804\uC5D0\uB294\\r\\n\uBCF4\uC2A4 \uC5C6\uC774 \uC6B0\uB9AC\uB07C\uB9AC \uC0C1\uB300\uD574 \uBCF4\uC790![VAR 0114(002F)]",
  "[~ 252]",
  "\uD558\uB098\uD558\uB098\uC758 \uBCC4\uC740 \uC791\uC744\uC9C0 \uBAB0\uB77C\uB3C4,\\n\uB2E4 \uD568\uAED8 \uBE5B\uB098\uBA74 \uBCC4\uC790\uB9AC\uAC00 \uB418\uB294 \uBC95!\\c\\n\uC6B0\uB9AC\uB294 \uC2A4\uD0C0\uB2E8 \uCD5C\uD6C4\uC758 \uBCF4\uB8E8!\\n\uC5EC\uAE30\uC11C \uC9C8 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4![VAR 0114(002F)]",
  "\uC798 \uB4E4\uC5B4\uB77C, \uCE68\uC785\uC790! \uB9CC\uC57D \uB124\uAC00 [VAR 0201(0001)]\uBD84 \uC774\uB0B4\uC5D0\\n\uC6B0\uB9AC\uC758 \uD3EC\uCF13\uBAAC\uC744 [VAR 0201(0002)]\uB9C8\uB9AC \uC4F0\uB7EC\uB728\uB9B0\uB2E4\uBA74\\r\\n\uBCF4\uC2A4\uB97C \uBD88\uB7EC \uC8FC\uB9C8![VAR 0114(002F)]",
