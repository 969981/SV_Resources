  "\uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC57C.\\n\uD0C0\uC624\uB974\uACE0 \uC2F6\uB2E4\uBA74 \uB0B4\uC77C \uB610 \uC624\uB77C\uACE0.[VAR 0114(001F)]",
