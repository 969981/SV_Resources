[
  "\uC81C\uAD70\uB4E4, \uC218\uC5C5\uC744 \uC2DC\uC791\uD558\uACA0\uB2E4.\\n\uC2A4\uB9C8\uD2B8\uD3F0\uC740 \uC9D1\uC5B4\uB123\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uD544\uB4DC\uC6CC\uD06C \uC911\uC5D0 \uD3EC\uCF13\uBAAC\uC744\\n\uACC4\uC18D \uB370\uB9AC\uACE0 \uAC77\uB2E4 \uBCF4\uBA74[VAR 0114(0029)]",
  "\uD3EC\uCF13\uBAAC\uC758 \uC0C9\uC774 \uBCC0\uD560 \uB54C\uAC00 \uC788\uB2E4\uB294 \uAC83\uC744\\n\uB208\uCE58\uCC48 \uC801 \uC788\uB098?[VAR 0114(0029)]",
  "\uADF8\uAC74 \uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC73C\uB85C\\n\uBCC0\uD588\uB2E4\uAC70\uB098 \uD55C \uAC8C \uC544\uB2C8\uB77C...[VAR 0114(0029)]",
  "...\uB354\uB7EC\uC6CC\uC9C4 \uAC70\uB2E4!![VAR 0114(0029)]",
  "\uBC30\uD2C0\uC744 \uAC70\uB4ED\uD558\uBA70\\n\uAE30\uC220\uC5D0 \uB9DE\uC544 \uC0C1\uCC98 \uC785\uACE0!![VAR 0114(0029)]",
  "\uBE44\uBC14\uB78C\uC744 \uB9DE\uACE0\\n\uBAA8\uB798\uB098 \uC9C4\uD759\uC774 \uBB3B\uC73C\uBA74\uC11C!![VAR 0114(0029)]",
  "\uB354\uB7EC\uC6CC\uC9C4 \uAC70\uB780 \uB9D0\uC774\uB2E4!![VAR 0114(0029)]",
  "\uADC0\uC5EC\uC6B4 \uD3EC\uCF13\uBAAC\uC744\\n\uB354\uB7EC\uC6CC\uC9C4 \uC0C1\uD0DC \uADF8\uB300\uB85C \uB370\uB9AC\uACE0 \uB2E4\uB2C8\uB294\\r\\n\uD2B8\uB808\uC774\uB108\uAC00 \uB9CE\uC774 \uBCF4\uC774\uB354\uAD70.\\r\\n...\uCC38\uC73C\uB85C \uAC1C\uD0C4\uC2A4\uB7FD\uC9C0 \uC54A\uC740\uAC00.[VAR 0114(0029)]",
  "\uADF8\uB7FC, \uADF8\uB7F0 \uBD80\uB044\uB7EC\uC6B4 \uD589\uC704\uB97C \uC6A9\uB0A9\uD558\uC9C0 \uC54A\uB294\\n[VAR 0100(0000)]\uC5D0\uAC8C \uBB3B\uB3C4\uB85D \uD558\uC9C0.[VAR 0114(0029)]",
  "\uD3EC\uCF13\uBAAC\uC774 \uB354\uB7EC\uC6CC\uC84C\uB2E4\uBA74\\n\uBB34\uC5C7\uC744 \uD574\uC57C \uD558\uC9C0?[VAR 0114(0029)]",
  "\uC53B\uACA8 \uC900\uB2E4",
  "\uBA38\uB9AC\uB97C \uC4F0\uB2E4\uB4EC\uB294\uB2E4",
  "\uB0B4\uBC84\uB824 \uB454\uB2E4",
  "\uD6CC\uB96D\uD55C \uB2F5\uBCC0\uC774\uC5C8\uB2E4!\\n\uB108\uB77C\uBA74 \uADF8\uB807\uAC8C \uB300\uB2F5\uD560 \uAC70\uB77C \uBBFF\uACE0 \uC788\uC5C8\uC9C0.[VAR 0114(0029)]",
  "\u201C\uC633\uC9C0, \uC633\uC9C0! \uC544\uC8FC \uC5F4\uC2EC\uD788 \uD588\uAD6C\uB098~\u201D\uD558\uACE0\\n\uC4F0\uB2E4\uB4EC\uC5B4 \uC8FC\uBA74 \uC11C\uB85C \uD750\uBB47\uD574\uC9C0\uAE34 \uD558\uACA0\uB2E4\uB9CC,\\r\\n\uADF8\uB7F0\uB2E4\uACE0 \uB354\uB7EC\uC6C0\uC774 \uC0AC\uB77C\uC9C0\uC9C4 \uC54A\uB294\uB2E4![VAR 0114(0029)]",
  "\uD655\uC2E4\uD788 \uBE44\uC5D0 \uC816\uAC70\uB098 \uC9C4\uD759\uC774 \uBB3B\uC5C8\uC744 \uB54C\uB294\\n\uADF8\uB0E5 \uB0B4\uBC84\uB824 \uB46C\uB3C4 \uC53B\uACA8\uC9C0\uAE34 \uD55C\uB2E4\uB9CC...\\r\\n\uB124\uAC00 \uADF8\uB807\uAC8C \uB9D0\uD558\uB2E4\uB2C8 \uC870\uAE08 \uC758\uC678\uB85C\uAD70.[VAR 0114(0029)]",
  "\uB354\uB7EC\uC6CC\uC84C\uB2E4\uBA74 \uC53B\uB294\uB2E4!\\n\uC138\uC0C1\uC758 \uB2F9\uC5F0\uD55C \uC774\uCE58 \uC544\uB2C8\uB358\uAC00![VAR 0114(0029)]",
  "\uD53C\uD06C\uB2C9\uC744 \uC2DC\uC791\uD558\uACE0\\n\uB370\uB9AC\uACE0 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uAC00\uAE4C\uC774 \uAC00\uBA74\\r\\n\uB2E4\uC591\uD55C \uC561\uC158\uC744 \uCDE8\uD560 \uC218 \uC788\uC9C0.[VAR 0114(0029)]",
  "\uADF8\uC911\uC5D0 \uD558\uB098\uAC00 \uBC14\uB85C\\n\uD3EC\uCF13\uBAAC \uC6CC\uC2DC!\\r\\n...\uB2E4\uC2DC \uB9D0\uD574, \uC53B\uACA8 \uC8FC\uAE30\uB2E4![VAR 0114(0029)]",
  "\uBA3C\uC800 \uC2A4\uD380\uC9C0\uB85C \uAC70\uD488\uC744 \uB0B4\uC11C\\n\uD3EC\uCF13\uBAAC\uC758 \uBAB8\uC744 \uBD80\uB4DC\uB7FD\uACE0\uB3C4\\r\\n\uAF3C\uAF3C\uD558\uAC8C \uBB38\uC9C8\uB7EC \uC8FC\uB294 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uCDA9\uBD84\uD788 \uAC70\uD488\uC774 \uB0AC\uB2E4\uBA74...[VAR 0114(0029)]",
  "\uB354\uB7EC\uC6C0\uC744 \uD761\uC218\uD55C \uAC70\uD488\uC744 \uC0E4\uC6CC\uAE30\uB85C\\n\uD758\uB824\uBCF4\uB0B4\uC11C \uAE54\uB054\uD558\uAC8C \uB9C8\uBB34\uB9AC![VAR 0114(0029)]",
  "\uADF8\uB807\uAC8C \uD558\uBA74 \uD3EC\uCF13\uBAAC\uC774 \uD14C\uB77C\uC2A4\uD0C8\uCC98\uB7FC\\n\uB2E4\uC2DC\uAE08 \uBE5B\uB098\uAE30 \uC2DC\uC791\uD560 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uB9CE\uC740 \uC218\uACE0\uAC00 \uB4E4\uC5B4\uAC00\uC9C0\uB9CC\\n\uCCB4\uB825\uB3C4 \uD68C\uBCF5\uB418\uACE0, \uC0C1\uD0DC \uC774\uC0C1\uB3C4 \uB098\uC744 \uC218 \uC788\uC9C0.[VAR 0114(0029)]",
  "\uB2E8, \uD3EC\uCF13\uBAAC\uC5D0 \uB530\uB77C\\n\uBB38\uC9C0\uB974\uB294 \uAC83\uC744 \uC2EB\uC5B4\uD558\uB294 \uBD80\uBD84\uC774\uB098\\r\\n\uBB3C\uC5D0 \uB2FF\uAE30 \uC2EB\uC5B4\uD558\uB294 \uBD80\uBD84\uC774 \uC788\uC73C\uB2C8\\r\\n\uC774 \uC810\uC740 \uC8FC\uC758\uD558\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uADF8\uB9AC\uACE0 \uAC00\uC7A5 \uC911\uC694\uD55C \uAC83\uC774 \uC788\uB294\uB370,\\n\uB354\uB7EC\uC6B4 \uAC83\uC744 \uC88B\uC544\uD558\uB294 \uD3EC\uCF13\uBAAC\uB3C4\\r\\n\uC788\uB2E4\uB294 \uAC83\uC774\uB2E4.[VAR 0114(0029)]",
  "\uC55E\uC5D0\uC11C \uB9D0\uD55C \uAC83\uACFC \uC0B4\uC9DD \uBAA8\uC21C\uB418\uAE34 \uD558\uC9C0\uB9CC,\\n\uC53B\uACA8 \uC8FC\uB294 \uAC83\uC774 \uBB34\uC870\uAC74 \uCE5C\uC808\uD568\uC744 \uBCA0\uD478\uB294 \uAC8C\\r\\n\uC544\uB2C8\uB77C\uB294 \uAC78 \uBA85\uC2EC\uD558\uB3C4\uB85D.[VAR 0114(0029)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4.\\n\uC774\uB9CC \uC2E4\uB840\uD558\uC9C0.[VAR 0114(0029)]"
]
