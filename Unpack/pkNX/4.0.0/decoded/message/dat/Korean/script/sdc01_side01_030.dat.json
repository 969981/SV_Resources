  "\uACE7\uC7A5 \uAC00\uBA74\uC744 \uC4F0\uACE0\\n\uC790\uC2E0\uC758 \uC5BC\uAD74\uC744 \uC228\uACA8\uB77C.",
  "\uADF8\uB9AC\uD558\uBA74 \uADF8\uB9BC\uC790\uAC00 \uC0AC\uB78C\uC774\uB4E0 \uB3C4\uAE68\uBE44\uB4E0\\n\uAC00\uBA74\uB07C\uB9AC \uC778\uC0AC\uD558\uBA70 \uC9C0\uB098\uCE60\uC9C0\uB2C8.",
  "\uB9CC\uC57D \uAC00\uBA74\uC744 \uAC00\uC9C0\uACE0 \uC788\uC9C0 \uC54A\uAC70\uB4E0\\n\uADF8\uB9BC\uC790\uAC00 \uC0AC\uB78C\uC774\uAE30\uB97C \uBE4C\uC5B4\uB77C.",
  "\uADF8\uB9BC\uC790\uAC00 \uC0AC\uB78C\uC774\uB77C\uBA74 \uC0B4\uC544\uC11C\\n\uB2E4\uC2DC\uB294 \uAC00\uBA74\uC744 \uC78A\uC9C0 \uC54A\uC744\uC9C0\uBA70,",
  "\uADF8\uB9BC\uC790\uAC00 \uB3C4\uAE68\uBE44\uB77C\\n\uADF8\uC5D0\uAC8C \uB9E8\uC5BC\uAD74\uC744 \uBCF4\uC778\uB2E4\uBA74,",
  "\uC601\uD63C\uC744 \uBF51\uD600\uC11C\\n\uB2E4\uC2DC\uB294 \uB9C8\uC744\uB85C \uB3CC\uC544\uAC00\uC9C0 \uBABB\uD560\uC9C0\uB2C8\uB77C.",
  "\uB2F9\uC2DC\uC5D0\uB294 \uB2E4\uB4E4 \uAC00\uBA74\uC744 \uAC00\uC9C0\uACE0 \uB2E4\uB154\uB294\uB370,\\n\uADF8\uAC78 \uC804\uBD80 \uB9CC\uB4E0 \uC0AC\uB78C\uC774...\\r\\n\uB0B4 \uD560\uC544\uBC84\uC9C0\uC758 \uD560\uC544\uBC84\uC9C0\uC758...\\r\\n\uD55C\uCC38 \uC704\uC758 \uD560\uC544\uBC84\uC9C0\uC168\uB300.[VAR 0114(0043)]",
  "\uAD49\uC7A5\uD558\uB2E4!",
  "\uC9C4\uC9DC \uC788\uC5C8\uB358 \uC77C\uC774\uC57C!?",
  "\uBB3C\uB860, \uB3C4\uAE68\uBE44\uB2D8\uC774 \uC601\uD63C\uC744 \uBF51\uC544 \uAC14\uB2E4\uB294 \uAC74\\n\uAC70\uC9D3\uB9D0\uC774\uACA0\uC9C0\uB9CC,\\r\\n\uC6B0\uB9AC \uC870\uC0C1\uB2D8\uC774 \uAC00\uBA74\uC744 \uB9CC\uB4E4\uC5C8\uB2E4\uB294 \uAC74 \uC9C4\uC9DC\uC57C.[VAR 0114(0043)]",
  "\uC6B0\uB9AC \uAC00\uBB38\uC774 \uB300\uB300\uB85C\\n\uAC00\uBA74 \uC7A5\uC778\uC758 \uC9D1\uC548\uC774\uC5C8\uB300...\\r\\n\uADF8\uB798\uC11C \uD560\uC544\uBC84\uC9C0\uB3C4 \uAC00\uBA74\uC744 \uB9CC\uB4E4 \uC904 \uC544\uC154.[VAR 0114(0043)]",
  "\uAC00\uBA74 \uCD95\uC81C\uB3C4 \uC6B0\uB9AC \uC870\uC0C1\uB2D8\uC774\\n\uCC98\uC74C \uC81C\uC548\uD588\uB2E4\uB098 \uBD10.[VAR 0114(0043)]",
  "...\uC774 \uAC04\uD310\uC5D0 \uC4F0\uC5EC \uC788\uB294 \uB0B4\uC6A9 \uB9D0\uC774\uC57C.\\n\uB098\uB294 \uBCC4\uB85C \uC548 \uC88B\uC544\uD574.[VAR 0114(0043)]",
  "\uB3C4\uAE68\uBE44\uB2D8\uC774 \uBB34\uC12D\uB2E4\uACE0,\\n\uD544\uC694 \uC774\uC0C1\uC73C\uB85C \uAC81\uBA39\uC5B4\uC11C\\r\\n\uB9C8\uC744 \uBC16\uC73C\uB85C \uCAD3\uC544\uB0B4\uACE0...[VAR 0114(0043)]",
  "\uB3C4\uAE68\uBE44\uB2D8\uB3C4 \uBD84\uBA85 \uC678\uB85C\uC6E0\uC744 \uAC70\uC57C...[VAR 0114(0043)]",
  "\uD63C\uC790\uC11C \uACC4\uC18D...\\n\uB530\uB3CC\uB9BC\uC744 \uB2F9\uD588\uC796\uC544.[VAR 0114(0043)]",
