  "\uADF8\uB7FC, \uD3EC\uCF13\uBAAC\uC744 \uD68C\uBCF5\uC2DC\uCF1C \uC904\uAC8C.[VAR 0114(0043)]",
  "[VAR 0100(0000)]\uC758 \uD3EC\uCF13\uBAAC\uB4E4\\n\uB0B4\uAC00 \uD68C\uBCF5\uC2DC\uCF1C \uC904 \uD14C\uB2C8\uAE4C... \uC751?[VAR 0114(0043)]",
  "\uC774\uBC88\uC5D0\uC57C\uB9D0\uB85C... \uC774\uAE38 \uAC70\uC57C.[VAR 0114(0043)]",
  "\uC84C\uB124...[VAR 0114(0043)]",
  "\uB2E4 \uB0B4\uAC00 \uC57D\uD574\uC11C\uC57C...\\n\uADF8\uB798\uC11C \uB0B4\uAC00...[VAR 0114(0043)]",
  "\uAC04\uD310...\\n\uACFC\uC81C\uB97C \uB9C8\uC800 \uB05D\uB0B4\uC790.[VAR 0114(0043)]",
