[
  "\uC73C\uC73C... \uCD94\uC6CC...[VAR 0114(001A)]",
  "\uC5EC\uAE30, \uB0C9\uBC29\uC774 \uB108\uBB34 \uAC15\uD55C \uAC70 \uC544\uB2C8\uC57C?[VAR 0114(001A)]",
  "\uB098\uB97C \uBD80\uB978 \uAC8C \uB108\uAD6C\uB098.[VAR 0114(001A)]",
  "\uC81C\uBC95 \uC18C\uB984 \uB3CB\uB294 \uC77C\uC744 \uD588\uB124.[VAR 0114(001A)]",
  "\uB098\uB97C \uBD88\uB7EC \uBD24\uC790 \uC544\uCE74\uB370\uBBF8\uC5D0\\n\uB4DD\uC774 \uB420 \uAC74 \uC5C6\uC744 \uAC83 \uAC19\uC740\uB370 \uB9D0\uC774\uC57C.[VAR 0114(001A)]",
  "\uADF8\uB807\uC9C0 \uC54A\uC544\uC694!",
  "\uC74C...",
  "...\uB531 \uC798\uB77C \uB9D0\uD558\uB294\uAD6C\uB098.\\n\uADF8\uB7F0 \uC790\uC2E0\uAC10\uC740 \uB300\uCCB4 \uC5B4\uB514\uC11C \uB098\uC624\uB294 \uAC70\uC57C?[VAR 0114(001A)]",
  "\uAC70 \uBD10...\\n\uB108\uB3C4 \uC790\uC2E0 \uC5C6\uC796\uC544.[VAR 0114(001A)]",
  "\uADF8\uB807\uC9C0\uB9CC, \uC774\uC655 \uC654\uC73C\uB2C8\\n\uB9E1\uC740 \uC77C\uC740 \uB05D\uAE4C\uC9C0 \uD560\uAC8C.[VAR 0114(001A)]",
  "...\uC77C\uB2E8\uC740 \uB098\uB3C4 \uD504\uB85C\uB2C8\uAE4C.[VAR 0114(001A)]",
  "...\uB108\uAD6C\uB098.[VAR 0114(001A)]",
  "\uB3D4\uC758 \uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uB77C\uB294 \uACF3\uC5D0\uB294 \uAC00 \uBD24\uC5B4?\\n\uAD49\uC7A5\uD55C \uACF3\uC774\uB354\uB77C.[VAR 0114(001A)]",
  "\uC778\uACF5 \uB208\uC774\uB77C\uB294 \uC0DD\uAC01\uC774 \uB4E4\uC9C0 \uC54A\uC744 \uC815\uB3C4\uB85C\\n\uBD80\uB4DC\uB7EC\uC6B4 \uAC8C, \uB9C8\uCE58 \uCC9C\uC5F0 \uB208 \uAC19\uC558\uC5B4.[VAR 0114(001A)]",
  "\uC9C1\uC120\uB3C4 \uACE1\uC120\uB3C4 \uB2E4\uC591\uD574\uC11C\\n\uBCF4\uB4DC\uB97C \uD0C0\uAE30\uC5D0 \uC81C\uACA9\uC77C \uAC83 \uAC19\uB354\uB77C\uACE0.[VAR 0114(001A)]",
  "\uD0C0\uC2E4 \uAC70\uC608\uC694!?",
  "\uAC19\uC774 \uD0C0 \uBD10\uC694!",
  "...\uC544, \uADF8\uB7F0 \uC758\uBBF8\uB85C\\n\uD55C \uB9D0\uC740 \uC544\uB2C8\uC57C.[VAR 0114(001A)]",
  "\uC124\uC0B0\uC744 \uBCF4\uBA74\\n\uAD00\uCC30\uD558\uB294 \uBC84\uB987\uC774 \uB0A8\uC740 \uAC83\uBFD0\uC774\uC9C0.[VAR 0114(001A)]",
  "\uADF8 \uC815\uB3C4\uC758 \uC0B0\uC744 \uAD50\uB0B4\uC5D0 \uB9CC\uB4E4\uC5B4 \uB0B4\uB2E4\uB2C8\\n...\uB300\uB2E8\uD55C \uACF3\uC774\uC57C.[VAR 0114(001A)]",
  "\uC544\uAE4C, \uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uC5D0 \uC788\uB294\\n\uC124\uC0B0\uC744 \uC62C\uB77C\uAC00 \uBD24\uC5B4.[VAR 0114(001A)]",
  "\uB098\uD398\uC0B0\uC774 \uC544\uB2CC \uC124\uC0B0\uC778\uB370\uB3C4\\n\uD130\uBC85\uACE0\uB798\uB4E4\uC774 \uC2E0\uB098\uD558\uB354\uB77C.[VAR 0114(001A)]",
  "\uADF8\uAC78 \uBCF4\uACE0 \uB098\uB3C4...\\n\uC544\uC8FC \uC870\uAE08... \uBCF4\uB4DC\uB97C \uD0C0 \uBD24\uC5B4.[VAR 0114(001A)]",
  "\uC798\uB410\uB124\uC694!",
  "\uC5B4\uB560\uC5B4\uC694?",
  "\uB208 \uC0C1\uD0DC\uAC00 \uC88B\uB354\uB77C.\\n\uC751... \uC88B\uC558\uC5B4.[VAR 0114(001A)]",
  "\uB108\uBB34 \uC624\uB79C\uB9CC\uC5D0 \uD0C0\uB294 \uAC70\uB77C\\n\uB098\uB3C4 \uBAA8\uB974\uAC8C \uB108\uBB34 \uD765\uBD84\uD574 \uBC84\uB838\uC5B4.[VAR 0114(001A)]",
  "\uB2E4\uC2DC\uB294 \uBCF4\uB4DC\uB97C\\n\uD0C0\uC9C0 \uC54A\uC744 \uC0DD\uAC01\uC774\uC5C8\uB294\uB370...[VAR 0114(001A)]",
  "\uC5EC\uAE30\uC5D0 \uC788\uB294 \uB3D9\uC548\uB9CC\uD07C\uC740\\n\uD0C0\uB3C4 \uAD1C\uCC2E\uC73C\uB824\uB098?[VAR 0114(001A)]",
  "...\uC57D\uD55C \uC18C\uB9AC\uB97C \uD574\uC11C \uBBF8\uC548.[VAR 0114(001A)]",
  "\uC774\uC655 \uC18C\uB984 \uB3CB\uB294 \uB9D0\uC744 \uD55C \uAE40\uC5D0\\n\uC880 \uB354 \uC18C\uB984 \uB3CB\uB294 \uC77C\uC744 \uD574 \uBCFC\uAE4C?[VAR 0114(001A)]",
  "\uC6B0\uB9AC \uB458\uC774\\n\uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD558\uB294 \uAC74 \uC5B4\uB54C?[VAR 0114(001A)]",
  "\uC9C4\uC9DC \uD558\uB824\uB294 \uAC70\uC57C?\\n\uADF8\uB7FC, \uB098\uB294 \uD130\uBC85\uACE0\uB798\uB97C \uC904\uAC8C.\\r\\n\uB108\uB294 \uC5B4\uB5BB\uAC8C \uD560\uB798?[VAR 0114(001A)]",
  "[VAR 0101(0001)][VAR 1900(0006)]\uB77C...\\n\uC74C, \uB098\uC058\uC9C0 \uC54A\uC544.\\c\\n\uB108\uC5D0\uAC8C\uC11C \uBC1B\uC740 \uC544\uC774\uB2C8\\n\uC370\uB801\uD55C \uBC29\uC2DD\uC73C\uB85C\uB294 \uD0A4\uC6B0\uC9C0 \uC54A\uACA0\uC5B4.[VAR 0114(001A)]",
  "\uB108\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uB098\uC758 \uD130\uBC85\uACE0\uB798\uB97C \uAD50\uD658\uD558\uB294 \uAC70\uB124.[VAR 0114(001A)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uC744 \uD560 \uC218 \uC5C6\uC5B4.\\c\\n2\uB9C8\uB9AC \uC774\uC0C1\uC740 \uB370\uB824\uC640\uC57C \uD574.[VAR 0114(001A)]",
  "...\uB18D\uB2F4\uC774\uC5C8\uC5B4. \uC2E0\uACBD \uC4F0\uC9C0 \uB9C8.[VAR 0114(001A)]",
  "\uC18C\uB984 \uB3CB\uB294 \uC77C\uC744 \uD574 \uBCFC\uAE4C?\\n\uD3EC\uCF13\uBAAC \uAD50\uD658 \uAC19\uC740 \uAC70 \uB9D0\uC774\uC57C.[VAR 0114(001A)]",
  "\uB108\uC758 \uADF8 \uD45C\uC815...\\n\uB098\uC640 \uC2B9\uBD80\uD558\uACE0 \uC2F6\uC740 \uAC70\uC57C?[VAR 0114(001A)]",
  "\uADF8\uB9CC\uB450\uB294 \uAC8C \uC815\uB2F5\uC774\uC57C.[VAR 0114(001A)]",
  "\uC18C\uB984\uC774 \uB3CB\uB294 \uB300\uB2F5\uC774\uAD70...\\n\uBB50, \uAC00\uB054\uC740 \uAD1C\uCC2E\uC73C\uB824\uB098.[VAR 0114(001A)]",
  "[~ 59]",
  "...\uB098\uC758 \uC644\uD328\uC600\uC5B4.\\n\uD604\uC2E4\uC740 \uC5ED\uC2DC \uCC28\uAC11\uAD6C\uB098.[VAR 0114(001A)]",
  "\uADF8\uB807\uC9C0\uB9CC, \uC990\uAC70\uC6E0\uC5B4.\\n\uC18C\uB4DD\uB3C4 \uC788\uB294 \uAC83 \uAC19\uACE0.[VAR 0114(001A)]",
  "\uD328\uC790\uAC00 \uC2B9\uC790\uC5D0\uAC8C \uC8FC\uB294 \uC120\uBB3C\uC774\uC57C.\\n\uC774\uAC78 \uBC1B\uC544 \uC918.[VAR 0114(001A)]",
  "\uD544\uC694 \uC5C6\uB2E4\uBA74 \uBC84\uB824\uB3C4 \uB3FC.[VAR 0114(001A)]",
  "[~ 59]",
  "\uB098\uC5D0\uAC8C \uD328\uBC30\uB97C \uC548\uACA8 \uC8FC\uB294 \uAC78\\n\uC815\uB9D0 \uC88B\uC544\uD558\uB294 \uBAA8\uC591\uC774\uB124.[VAR 0114(001A)]",
  "\uB2E4\uC74C\uC5D0 \uB610 \uC2B9\uBD80\uD55C\uB2E4\uBA74...\\n\uC18C\uB984 \uB3CB\uB294 \uACB0\uACFC\uB294 \uB098\uC624\uC9C0 \uC54A\uC744 \uAC70\uC57C.[VAR 0114(001A)]",
  "\uBD10\uC8FC\uB294 \uC2B9\uBD80\uC5D0\uC11C\uB294\\n\uC774\uACA8\uB3C4 \uD558\uB098\uB3C4 \uAE30\uC058\uC9C0 \uC54A\uC73C\uB2C8\uAE4C\\r\\n\uB2E4\uC74C\uC5D0\uB294 \uC9C4\uC2EC\uC73C\uB85C \uBD80\uB52A\uCCD0 \uC918.[VAR 0114(001A)]",
  "\uD559\uC0DD\uB4E4\uC744 \uC0C1\uB300\uD558\uB294 \uAC74 \uB098\uB791 \uC548 \uB9DE\uC544...\\n\uC7A5\uB798\uC5D0 \uC88C\uC808\uD558\uAC8C \uB420\uC9C0\uB3C4 \uBAA8\uB978\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB2C8\\r\\n\uBD88\uC30D\uD574\uC11C \uCC28\uB9C8 \uBABB \uBCF4\uACA0\uB354\uB77C\uACE0.[VAR 0114(001A)]",
  "\uB098, \uC5EC\uAE30\uC5D0\uC11C\uB3C4\\n\uC81C\uBC95 \uC54C\uB824\uC838 \uC788\uB294 \uBAA8\uC591\uC774\uC57C.\\c\\n\uAC19\uC774 \uC0AC\uC9C4\uC744 \uCC0D\uC790\uACE0 \uC870\uB974\uB294 \uC0AC\uB78C\uC740\\n\uB108 \uD558\uB098\uB85C \uCDA9\uBD84\uD55C\uB370 \uB9D0\uC774\uC9C0.[VAR 0114(001A)]",
  "\uC5ED\uC2DC \uC5EC\uAE30...\\n\uB0C9\uBC29\uC774 \uB108\uBB34 \uAC15\uD558\uC9C0 \uC54A\uC544?\\r\\n\uB204\uAD6C\uD55C\uD14C \uB9D0\uD574\uC57C \uC628\uB3C4\uB97C \uB192\uC77C \uC218 \uC788\uC9C0?[VAR 0114(001A)]",
  "[VAR 0101(0001)][VAR 1900(0001)] \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC5B4.\\n\uB0B4 \uD3EC\uCF13\uBAAC\uB4E4\uC774\uB791\uB3C4 \uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uACE0.\\r\\n...\uC370\uB801\uD55C \uB290\uB08C\uC740 \uC804\uD600 \uC5C6\uC5B4.[VAR 0114(001A)]",
  "\uB0B4\uAC00 \uAD50\uD658\uD574 \uC900\\n\uD130\uBC85\uACE0\uB798\uB294 \uC5B4\uB5BB\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uC5B4?\\c\\n\uD55C\uB208\uD314\uBA74 \uAE08\uC138 \uC5B4\uB518\uAC00\uB85C \uAC00 \uBC84\uB9AC\uB2C8\uAE4C\\n\uD53C\uD06C\uB2C9 \uD560 \uB54C\uB294 \uC870\uC2EC\uD558\uB294 \uAC8C \uC88B\uC544.[VAR 0114(001A)]",
  "...\uADF8\uB7EC\uACE0 \uBCF4\uB2C8, \uD14C\uC0AC \uC528\uC5D0\uAC8C\uC11C\\n\uC18C\uB984\uC774 \uB3CB\uB294 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5C8\uC5B4.\\c\\n\uB108, \uAC00\uC7A5 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\\n\uB098\uB77C\uACE0 \uB300\uB2F5\uD588\uB2E4\uBA70?\\c\\n\uC5B4\uC9F8\uC11C \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uB294 \uAC74\uC9C0\\n\uC804\uD600 \uC774\uD574\uAC00 \uC548 \uAC00\uAE34 \uD558\uC9C0\uB9CC...\\c\\n\uB124 \uB9C8\uC74C\uC774 \uADF8\uB807\uB2E4\uACE0 \uD558\uB2C8...\\n\uACE0\uB9D9\uAC8C \uC0DD\uAC01\uD558\uACE0\uB294 \uC788\uC5B4.[VAR 0114(001A)]"
]
