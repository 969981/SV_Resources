[
  "[~ 11]",
  "[~ 11]",
  "\uC138\uB974\uD074\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uB3C4\uC804\uC790\uC758 \uC774\uB984\uC744\\n\uB4F1\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4...\\r\\n[VAR 0100(0000)] \uB2D8\uC774\uC2DC\uAD70\uC694!",
  "\uC774\uACF3\uC758 \uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB2E8\uD48D \uB2D8\uACFC\\n\uC2B9\uBD80\uD558\uB824\uBA74 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C\\r\\n\uD074\uB9AC\uC5B4\uD574\uC57C \uD569\uB2C8\uB2E4.",
  "\uC138\uB974\uD074\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB294...\\n[VAR FF00(0006)]\uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30[VAR FF00(0000)]!",
  "\uC62C\uB9AC\uBE0C\uC758 \uACE0\uC7A5 \uC138\uB974\uD074\uB9C8\uC744\uC5D0\uC11C\uB294\\n\uC61B\uB0A0\uBD80\uD130 \uD48D\uC791\uC744 \uAE30\uC6D0\uD558\uBA70\\r\\n\uC62C\uB9AC\uBE0C \uC218\uD655\uC81C\uB97C \uC5F4\uACE0 \uC788\uC2B5\uB2C8\uB2E4.",
  "\uC62C\uB9AC\uBE0C\uB97C \uBCF8\uB5A0 \uB9CC\uB4E0 \uACF5\uC744 \uAD74\uB824\uC11C\\n\uACE8\uC5D0 \uB123\uC73C\uBA74 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uD074\uB9AC\uC5B4\uC785\uB2C8\uB2E4!\\r\\n\uADF8\uB7EC\uBA74 \uB0B4\uB144\uC5D0 \uC62C\uB9AC\uBE0C\uAC00 \uB9CE\uC774 \uC218\uD655\uB420 \uAC70\uC608\uC694!",
  "\uC790\uC138\uD55C \uB8F0\uC740 \uD68C\uC7A5\uC5D0 \uC788\uB294\\n\uC2A4\uD0DC\uD504\uC5D0\uAC8C \uB4E4\uC5B4 \uC8FC\uC138\uC694.",
  "\uC62C\uB9AC\uBE0C \uAD74\uB9AC\uAE30 \uD68C\uC7A5\uC740\\n[VAR FF00(0006)]\uB9C8\uC744 \uBD81\uCABD[VAR FF00(0000)]\uC5D0 \uC788\uC2B5\uB2C8\uB2E4!\\r\\n\uC704\uCE58\uB97C \uB9F5\uC5D0 \uB4F1\uB85D\uD574 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!",
  "\uADF8\uB7FC, \uB2E4\uB140\uC624\uC138\uC694!"
]
