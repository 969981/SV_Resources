[
  "\uD53C\uCF00\uB9C8\uC744\uC5D0 \uC5B4\uC11C \uC624\uB834!\\n\uBD80\uC9C0\uB7F0\uD55C \uC77C\uAFBC\uB4E4\uC774 \uB9CE\uC740 \uCC44\uAD74\uC758 \uB9C8\uC744\uC774\uB780\uB2E4!",
  "\uB3C4\uC2DC\uB97C \uAD00\uAD11\uD558\uB294 \uAC83\uB3C4 \uC88B\uC9C0\uB9CC,\\n\uC774\uB7F0 \uC18C\uBC15\uD55C \uB9C8\uC744\uB3C4 \uAD1C\uCC2E\uC740 \uAC83 \uAC19\uC544~",
  "\uD53C\uCF00\uB77C\uB294 \uAC74 \uAD6C\uBA4D\uC744 \uB0B8\uB2E4\uB294 \uB73B\uC774\uC57C.\\c\\n\uC774\uB984\uCC98\uB7FC \uC8FC\uBBFC \uB300\uB2E4\uC218\uAC00\\n\uCC44\uAD74\uC744 \uC0DD\uC5C5\uC73C\uB85C \uC0BC\uACE0 \uC788\uC9C0.",
  "\uBCA4\uCE58\uB294 \uC815\uB9D0 \uACE0\uB9C8\uC6B4 \uC874\uC7AC\uB77C\uB2C8\uAE4C...!\\n\uB108\uB3C4 \uC5B4\uB978\uC774 \uB418\uBA74 \uC54C\uAC8C \uB420 \uAC70\uC57C.",
  "\uCC44\uAD74\uC7A5\uC5D0\uC11C \uC0B0\uCC98\uB7FC\\n\uCEE4\uB2E4\uB780 \uD3EC\uCF13\uBAAC\uC744 \uBD24\uC5B4!",
  "\uB098\uB294 \uAC15\uCC98\uB7FC\\n\uAE30\uB2E4\uB780 \uD3EC\uCF13\uBAAC\uC744 \uBD24\uB2E4\uB2C8\uAE4C!",
  "\uCF54\uCF54\uB9AC\uB294 \uB545\uD0C0\uC785!\\n\uC804\uAE30\uAC00 \uD1B5\uD558\uC9C0 \uC54A\uACE0, \uB3C5\uC5D0\uB3C4 \uAC15\uD558\uB2E4\uAD6C!\\r\\n...\uBB3C\uC740 \uB07C\uC5B9\uC73C\uBA74 \uC548 \uB3FC!",
  "\uD1F4\uADFC\uAE38\uC5D0\uB294 \uC800\uAE30\uC5D0 \uC788\uB294 \uBC30\uD2C0\uCF54\uD2B8\uC5D0\uC11C\\n\uB3D9\uB8CC\uB4E4\uACFC \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uC990\uAE34\uB2E8\uB2E4!",
  "\uD0C4\uCC28\uACE4\uC774 \uC788\uC5B4\uC11C\\n\uB098\uB3C4 \uC5F4\uC2EC\uD788 \uC77C\uD560 \uC218 \uC788\uC5B4!\\c\\n...\uD798\uC744 \uC4F0\uB294 \uC77C\uBFD0\uB9CC \uC544\uB2C8\uB77C\\n\uC815\uC2E0\uC801\uC778 \uBD80\uBD84\uB3C4 \uB3C4\uC6C0\uC744 \uC8FC\uACE0 \uC788\uC9C0.",
  "\uB9C8\uC744 \uBC16\uC5D0\uC11C \uC4F0\uB7EC\uC9C8 \uBED4\uD588\uB294\uB370,\\n\uC57C\uC0DD\uC758 \uD3EC\uCF13\uBAAC\uC13C\uD130 \uC9C1\uC6D0\uC774\\r\\n\uB098\uB97C \uB3C4\uC640\uC92C\uC5B4.",
  "\uC2DC\uBE44\uAF2C\uC640 \uD568\uAED8\uD558\uB294 \uD558\uB298 \uC5EC\uD589!\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB294 \uC774\uC6A9\uD558\uACE0 \uACC4\uC2DC\uB098\uC694?\\c\\n\uC9C0\uB3C4 \uC571\uC73C\uB85C \uD638\uCD9C\uD574 \uC8FC\uC2DC\uBA74\\n\uC5B4\uB514\uB4E0\uC9C0 \uB2EC\uB824\uAC04\uB2F5\uB2C8\uB2E4!"
]
