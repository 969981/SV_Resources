[
  "\uB124\uAC00 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C \uBC1B\uC73C\uB7EC \uC628 \uAC8C\\n\uC9C4\uC9DC \uC5CA\uADF8\uC81C \uC77C\uC778 \uAC83 \uAC19\uC740\uB370[VAR 0114(001B)]",
  "\uC9C0\uAE08\uC740 \uCC54\uD53C\uC5B8\uC774\uC790\\n\uCE58\uD504\uC758 \uB300\uB9AC\uC778\uC73C\uB85C\uC11C \uC5EC\uAE30\uC5D0 \uC624\uB2E4\uB2C8.[VAR 0114(001B)]",
  "\uC815\uB9D0\uC774\uC9C0, \uC774 \uB098\uC774\uCBE4 \uB418\uBA74\\n\uC2DC\uAC04\uC774 \uC21C\uC2DD\uAC04\uC5D0 \uC9C0\uB098\uAC04\uB2E4\uB2C8\uAE4C...[VAR 0114(001B)]",
  "...\uC774\uB7F0 \uC13C\uCE58\uD55C \uAC10\uC815\uC740 \uB098\uC640 No Match!\\n\uC9C0\uAE08\uBD80\uD130 Nice\uD55C \uB77C\uC784 In The House![VAR 0114(001B)]",
  "\uB098\uB294 \uC9C4\uC911\uD55C Battle\uB85C\\n\uAC80\uC99D\uD558\uC9C0 Your Soul![VAR 0114(001B)]",
  "\uC5B4\uB9B0\uC78E\uC758 Power\\n\uD6CC\uB96D\uD558\uAC8C Grow Up?[VAR 0114(001B)]",
  "\uADF8\uB807\uB2E4\uBA74 \uB098\uC758 \uC601\uD63C\\n\uD754\uB4E4\uC5B4 \uBD10 Come On![VAR 0114(001B)]",
  "HA! HA! HA! \uC138\uC0C1\uC5D0\uB098!\\n\uB108\uC758 \uD380\uCE58\uB77C\uC778, \uC815\uB9D0 \uCD5C\uACE0\uC600\uC5B4![VAR 0114(001B)]",
  "\uB098\uC758 \uC601\uD63C\uC774 \uD754\uB4E4\uB9AC\uB2E4 \uBABB\uD574\\n\uC2A4\uBB34\uB514\uAC00 \uB410\uC744 \uC815\uB3C4\uC57C![VAR 0114(001B)]",
  "\uC544\uAE4C \uB8E8\uD0A4\uB77C\uACE0 \uB9D0\uD55C \uAC74 \uC0AC\uACFC\uD560\uAC8C.[VAR 0114(001B)]",
  "\uD14C\uC0AC\uC5D0\uAC8C \uACE0\uC2A4\uD2B8\uC758 \uD798\uC744 \uC778\uC815\uBC1B\uACE0 \uC2F6\uC5B4\uC11C\\n\uCD08\uC870\uD588\uC5C8\uAC70\uB4E0.[VAR 0114(001B)]",
  "\uC544\uBB34\uD2BC \uB108\uC758 \uBC14\uC774\uBE0C\uB294 \uC9C4\uC9DC\uC600\uC5B4!\\n\uB0B4\uAC00 \uBCF4\uC7A5\uD560\uAC8C![VAR 0114(001B)]",
  "\uC55E\uC73C\uB85C\uB294 \uC774 \uB77C\uC784 \uB2D8\uAED8\uC11C\\n\uB108\uC758 \uB4A4\uB97C \uBD10\uC8FC\uACA0\uC5B4.[VAR 0114(001B)]",
  "\uC9DC\uC99D \uB098\uB294 \uD2B8\uB808\uC774\uB108\uB098\\n\uC720\uB839\uC774 \uB098\uD0C0\uB098\uAC70\uB4E0 \uC5B8\uC81C\uB4E0\uC9C0 \uBD88\uB7EC \uC918!\\r\\n\uB0B4\uAC00 \uD798\uC774 \uB418\uC5B4 \uC904 \uD14C\uB2C8\uAE4C![VAR 0114(001B)]",
  "\uADF8\uB7FC, \uC990\uAC81\uAC8C \uD604\uC138\uB97C \uC990\uAE30\uB3C4\uB85D \uD558\uB77C\uACE0!\\nBye Bye Baby~![VAR 0114(001B)]"
