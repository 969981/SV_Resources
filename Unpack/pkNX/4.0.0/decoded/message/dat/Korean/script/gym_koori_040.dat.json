[
  "[~ 33]",
  "[VAR 0100(0000)] \uB2D8\\n\uB098\uD398\uC0B0\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uC808\uB300\uC601\uB3C4 \uD2B8\uB9AD...\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uADF8\uB8E8\uC0E4\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uADF8\uB7FC, \uBC30\uD2C0\uCF54\uD2B8\uB85C \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4.",
  "\uC900\uBE44\uAC00 \uB418\uC2DC\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.",
  "\uBFCC\uC624~!",
  "\uADF8\uB7F0 \uACF3\uC5D0 \uC788\uC5C8\uB358 \uAC70\uC57C?[VAR 0114(002C)]",
  "\uC73C\uC73C... \uCD94\uC6CC...[VAR 0114(002C)]",
  "...\uB3C4\uC804\uC790\uC778\uAC00?[VAR 0114(002C)]",
  "\uB0B4 \uC774\uB984\uC740 \uADF8\uB8E8\uC0E4.\\n\uC804\uC9C1 \uD504\uB85C \uC2A4\uB178\uBCF4\uB354\uC5D0\\r\\n\uC9C0\uAE08\uC740 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC744 \uD558\uACE0 \uC788\uC9C0.[VAR 0114(001A)]",
  "\uB108\uC758 \uD65C\uAC15\uD558\uB294 \uBAA8\uC2B5\uC740\\n\uC74C... \uCFE8\uD588\uC5B4.[VAR 0114(001A)]",
  "\uADF8\uB807\uB2E4\uACE0 \uB108\uBB34 \uC6B0\uCB50\uD574\uD558\uC9C4 \uB9C8.[VAR 0114(001A)]",
  "\uC124\uC0B0\uC740 \uC704\uD5D8\uD574\uC11C\\n\uC190\uC27D\uAC8C \uC778\uC0DD\uC758 \uCF54\uC2A4\uB97C \uB4A4\uD2C0\uC5B4 \uBC84\uB9AC\uB2C8\uAE4C.[VAR 0114(001A)]",
  "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC57C.\\n...\uC5B4\uB290 \uB54C\uAC00 \uB410\uB4E0\\r\\n\uC775\uC219\uD574\uC9C8 \uBB34\uB835\uC774 \uAC00\uC7A5 \uBB34\uC11C\uC6B4 \uBC95\uC774\uAC70\uB4E0.[VAR 0114(001A)]",
  "\uC774\uB7F0 \uB0A0\uC5D0 \uB0B4\uAC8C \uB3C4\uC804\uD558\uB2E4\uB2C8,\\n\uADF8\uB9CC\uB450\uB294 \uD3B8\uC774 \uC88B\uC744 \uD150\uB370...[VAR 0114(001A)]",
  "...\uC815\uB9D0 \uB098\uC640 \uC2F8\uC6B8 \uAC70\uC57C?[VAR 0114(001A)]",
  "\uB124!",
  "\uC5B4\uB5A1\uD558\uC9C0...",
  "\uC18C\uB984\uC774 \uB3CB\uB294 \uB300\uB2F5\uC774\uAD70... \uC548\uD0C0\uAE5D\uB124.[VAR 0114(001A)]",
  "...\uBA48\uCDB0 \uC11C\uB294 \uAC83 \uB610\uD55C \uC6A9\uAE30\uB2C8\uAE4C.\\n\uADF8\uB807\uC9C0\uB9CC \uB108 \uAC19\uC740 \uC0AC\uB78C\uC740 \uACB0\uAD6D\\r\\n\uC55E\uC73C\uB85C \uB098\uC544\uAC00\uB294 \uAE38\uC744 \uC120\uD0DD\uD558\uB354\uAD70.[VAR 0114(001A)]",
  "\uB098\uB3C4 \uC77C \uB54C\uBB38\uC5D0 \uD558\uB294 \uAC70\uB2C8\uAE4C\\n\uB108\uBB34 \uB098\uC058\uAC8C \uC0DD\uAC01\uD558\uC9C4 \uB9D0\uC544 \uC918.[VAR 0114(001A)]",
  "\uADF8\uB7FC, \uB208\uCC98\uB7FC \uCC28\uAC00\uC6B4 \uD604\uC2E4\uC744\\n\uAC00\uB974\uCCD0 \uC8FC\uB3C4\uB85D \uD558\uC9C0.[VAR 0114(001A)]",
  "\uC5ED\uACBD\uC5D0\uB3C4 \uAD74\uD558\uC9C0 \uC54A\uACE0\\n\uBBF8\uB798\uB97C \uAC1C\uCC99\uD574 \uB098\uAC00\uB294 \uC5F4\uC758...![VAR 0114(001A)]",
  "\uACFC\uAC70\uC758 \uB098\uB97C \uBCF4\uB294 \uAC83\uB9CC \uAC19\uC558\uC5B4...[VAR 0114(001A)]",
  "\uC544\uB2C8, \uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC57C.\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uC918\uC57C\uACA0\uC9C0?[VAR 0114(001A)]",
  "\uC751? \uD569\uACA9\uD55C \uAE30\uB150\uC73C\uB85C\\n\uAC19\uC774 \uC0AC\uC9C4\uC744 \uCC0D\uACE0 \uC2F6\uB2E4\uACE0...?[VAR 0114(001A)]",
  "\uC73C\uC73C... \uADF8\uB7F0 \uAC70 \uC18C\uB984 \uB3CB\uC544\uC11C\\n\uBCC4\uB85C \uC88B\uC544\uD558\uC9C0 \uC54A\uB294\uB370...\\r\\n\uC5B4\uCA54 \uC218 \uC5C6\uC9C0... \uD2B9\uBCC4\uD788 \uD574 \uC8FC\uB294 \uAC70\uC57C.[VAR 0114(001A)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C [VAR 0200(0001)]\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uB808\uBCA8 [VAR 0201(0002)]\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E4\uC744 \uAC70\uC57C.[VAR 0114(001A)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uC370\uB801\uD55C \uC9C0\uC2DC\uB97C \uD574\uB3C4 \uC798 \uB4E4\uC744 \uAC70\uC57C.[VAR 0114(001A)]",
  "\uADF8\uB807\uC9C0, \uC78A\uC5B4\uBC84\uB9AC\uAE30 \uC804\uC5D0\\n\uC774\uAC83\uB3C4 \uAC00\uC838\uAC00.[VAR 0114(001A)]",
  "\uB098\uB791 \uAC19\uC774 \uCC0D\uC740 \uC0AC\uC9C4\uBCF4\uB2E4\\n\uD6E8\uC52C \uC4F8 \uB9CC\uD560 \uAC70\uC57C...[VAR 0114(001A)]",
  "\uCD94\uC6B4 \uAC8C \uC2EB\uC9C0 \uC54A\uB2E4\uBA74\\n\uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uC790... \uADF8\uB7FC \uC774\uB9CC...[VAR 0114(001A)]",
  "\uB098\uD398\uC0B0\uCCB4\uC721\uAD00 \uD569\uACA9\uC744\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!"
]
