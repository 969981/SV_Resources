[
  "\uADF8\uB7FC, \uBAA8\uB780 \uC591.\\n\uADF8\uB9AC\uACE0 \uBCF4\uC2A4 \uC5EC\uB7EC\uBD84\uB4E4.[VAR 0114(000A)]",
  "\uC544\uCE74\uB370\uBBF8\uB97C \uB300\uD45C\uD574\uC11C\\n\uC2A4\uD0C0\uB2E8 \uC5EC\uB7EC\uBD84\uAED8 \uB4DC\uB9B4 \uB9D0\uC500\uC774 \uC788\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC9C4\uC2EC\uC73C\uB85C \uC0AC\uACFC\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "...\uB124?[VAR 0114(0008)]",
  "\uC800 \uD074\uB77C\uBCA8\uC774 \uC544\uCE74\uB370\uBBF8 \uAD50\uC7A5\uC73C\uB85C\uC11C\\n\uC778\uC0DD \uCD5C\uB300\uC758 \uC2E4\uC218\uB97C \uD588\uC2B5\uB2C8\uB2E4...[VAR 0114(000A)]",
  "...\uC751? \uB124?[VAR 0114(0008)]",
  "\uC2A4\uD0C0\uB2E8\uC774 \uACB0\uC131\uB41C \uC774\uC720\uC640 \uADF8 \uD65C\uC57D\uC740\\n\uBCF4\uC2A4 \uC5EC\uB7EC\uBD84\uB4E4\uC744 \uD1B5\uD574 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4...[VAR 0114(000A)]",
  "\uC81C\uAC00 \uBD80\uC784\uD55C \uB4A4\uB85C \uBCF4\uC544 \uC628\\n\uAD34\uB86D\uD798 \uC5C6\uB294 \uC544\uCE74\uB370\uBBF8\uC758 \uBAA8\uC2B5\uC740...[VAR 0114(000A)]",
  "\uC5EC\uB7EC\uBD84\uB4E4\uC758 \uC2AC\uD514\uACFC \uBD84\uB178...\\n\uADF8\uB9AC\uACE0 \uC6A9\uAE30\uB97C \uD1B5\uD574 \uC7C1\uCDE8\uD55C \uAC83\uC774\uB77C\uB294 \uAC78\uC694.[VAR 0114(000A)]",
  "...\uACB0\uB860\uBD80\uD130 \uB9D0\uC500\uB4DC\uB9AC\uC9C0\uC694.[VAR 0114(000A)]",
  "\uC2A4\uD0C0\uB2E8\uC5D0 \uB300\uD55C \uD574\uC0B0 \uC694\uCCAD...\\n\uADF8\uB9AC\uACE0 \uBCF4\uC2A4 \uC5EC\uB7EC\uBD84\uC5D0\uAC8C \uBCF4\uB0B8 \uD1F4\uD559 \uACBD\uACE0\uB97C\\r\\n\uC989\uAC01 \uCCA0\uD68C\uD558\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(000A)]",
  "\uADF8\uB807\uB2E4\uB294 \uAC83\uC740...[VAR 0114(0021)]",
  "\uADF8\uB807\uC2B5\uB2C8\uB2E4!\\n\uC2A4\uD0C0\uB2E8\uC740 \uD574\uC0B0\uD560 \uD544\uC694\uAC00 \uC5C6\uB294 \uAC81\uB2C8\uB2E4!![VAR 0114(000A)]",
  "\uB9CC\uC138~! \uBAA8\uB780\uC544!\\n\uC55E\uC73C\uB85C\uB3C4 \uB2E4 \uD568\uAED8 \uC9C0\uB0BC \uC218 \uC788\uC5B4![VAR 0114(0022)]",
  "\uCC38\uC73C\uB85C \uAE30\uC058\uAE30 \uADF8\uC9C0\uC5C6\uB3C4\uB2E4![VAR 0114(0023)]",
  "\uADF8, \uADF8\uB807\uC9C0\uB9CC...\\n\uB098\uB294 \uBAA8\uB450\uB97C \uBC30\uC2E0\uD558\uACE0...[VAR 0114(0008)]",
  "\uC2A4\uD0C0\uB354\uC2A4\uD2B8 \uB300\uC791\uC804\uC778\uAC00 \uD558\uB294 \uADF8\uAC70?\\n\uAD50\uC7A5 \uC120\uC0DD\uB2D8\uAED8 \uB2E4 \uB4E4\uC5C8\uC5B4.[VAR 0114(0020)]",
  "\uB2E8\uC5D0 \uC9D1\uCC29\uD558\uB2E4 \uD1F4\uD559\uB2F9\uD558\uAE30 \uC9C1\uC804\uC778\\n\uC6B0\uB9AC\uB97C \uAC71\uC815\uD574\uC11C \uD55C \uC77C\uC774\uC796\uC544.[VAR 0114(0021)]",
  "\uD574\uC0B0\uD558\uB77C\uACE0 \uD574\uC11C\\n\uACE0\uBD84\uACE0\uBD84\uD788 \uB530\uB97C \uC6B0\uB9AC\uB3C4 \uC544\uB2C8\uC5C8\uACE0 \uB9D0\uC774\uC57C.[VAR 0114(001F)]",
  "\uC6B0\uB9AC\uB97C \uAC71\uC815\uD558\uB294 \uBAA8\uB780 \uB098\uB9AC\uC758\\n\uB9C8\uC74C\uC18D\uC740 \uC774\uBBF8 \uD6E4\uD788 \uAFF0\uB6AB\uC5B4 \uBCF4\uACE0 \uC788\uC5C8\uC18C...[VAR 0114(0023)]",
  "\uAC71\uC815 \uB07C\uCCD0\uC11C \uBBF8\uC548\uD574.\\n\uC6B0\uB9B0 \uC774\uC81C \uAD1C\uCC2E\uC73C\uB2C8\uAE4C.[VAR 0114(0022)]",
  "\uADF8, \uADF8\uB807\uC9C0\uB9CC...[VAR 0114(0008)]",
  "...\uB9C8\uC800 \uC774\uC57C\uAE30\uD558\uC8E0.[VAR 0114(000A)]",
  "\uC55E\uC11C \uB9D0\uC500\uB4DC\uB838\uB2E4\uC2DC\uD53C,\\n\uC2A4\uD0C0\uB2E8\uC5D0 \uB300\uD55C \uD574\uC0B0 \uC694\uCCAD\uC740 \uCCA0\uD68C\uD560 \uAC81\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uB2E8, \uC2A4\uD0C0\uB2E8 \uC5EC\uB7EC\uBD84\uB4E4\uC774\\n\uC9C0\uAE08\uAE4C\uC9C0 \uBC8C\uC774\uC2E0...[VAR 0114(000A)]",
  "\uC7A5\uAE30\uAC04\uC5D0 \uAC78\uCE5C \uBB34\uB2E8\uACB0\uC11D!\\n\uAD50\uBCF5\uC758 \uAC1C\uC870![VAR 0114(000A)]",
  "\uC544\uCE74\uB370\uBBF8 \uBE44\uD488\uC758 \uBB34\uD5C8\uAC00 \uBC18\uCD9C![VAR 0114(000A)]",
  "\uADF8\uB9AC\uACE0 \uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC\uC758\\n\uAC1C\uC870 \uBC0F \uD3ED\uC8FC![VAR 0114(000A)]",
  "...\uB4F1\uB4F1! \uC218\uB9CE\uC740 \uAD50\uCE59 \uC704\uBC18\uC744\\n\uADF8\uB0E5 \uBD10\uB4DC\uB9B4 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4![VAR 0114(000A)]",
  "\uADF8\uB7EC\uB2C8, \uC774\uC5D0 \uB300\uD55C \uCC98\uBD84\uC73C\uB85C\\n\uBD09\uC0AC \uD65C\uB3D9\uC744 \uD574 \uC8FC\uC154\uC57C\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uBD09\uC0AC \uD65C\uB3D9...?[VAR 0114(0008)]",
  "\uBC14\uB85C, \uC2A4\uD0C0\uB2E8 \uC5EC\uB7EC\uBD84\uAED8\uC11C\\nSTC\uB97C \uC6B4\uC601\uD558\uC2DC\uB294 \uAC81\uB2C8\uB2E4.[VAR 0114(000A)]",
  "ST... \uBB50\uC758 \uC904\uC784\uB9D0\uC774\uC5D0\uC694?[VAR 0114(0008)]",
  "S\uB294 \uC2A4\uD0C0, T\uB294 \uD2B8\uB808\uC774\uB2DD,\\nC\uB294 \uC13C\uD130\uB97C \uC758\uBBF8\uD569\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uB2E4\uC2DC \uB9D0\uD574, \uC2A4\uD0C0 \uD2B8\uB808\uC774\uB2DD \uC13C\uD130.\\c\\n\uC544\uCE74\uB370\uBBF8\uC640 \uD3EC\uCF13\uBAAC\uB9AC\uADF8\uAC00 \uAC1C\uC124\uD560 \uC608\uC815\uC778,\\n\uD2B8\uB808\uC774\uB108\uB97C \uC591\uC131\uD558\uAE30 \uC704\uD55C \uC2DC\uC124\uC774\uC8E0.[VAR 0114(000A)]",
  "[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591\uC774 \uC544\uC9C0\uD2B8\uC5D0\\n\uB3C4\uC804\uD558\uB294 \uBAA8\uC2B5\uC5D0\uC11C \uC601\uAC10\uC744 \uC5BB\uC5C8\uB2F5\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC2A4\uD0C0\uB2E8\uC758 \uC804\uBC95\uACFC \uC544\uC9C0\uD2B8\uB294\\n\uADF8\uC57C\uB9D0\uB85C \uC720\uB2C8\uD06C\uD558\uBA74\uC11C\uB3C4 \uB3C5\uCC3D\uC801\uC774\uB354\uAD70\uC694![VAR 0114(000A)]",
  "\uADF8\uB7EC\uB2C8 \uC544\uC9C0\uD2B8\uB294 \uD2B8\uB808\uC774\uB2DD \uC2DC\uC124\uB85C \uB450\uACE0,\\n\uC2A4\uD0C0\uB2E8 \uC5EC\uB7EC\uBD84\uC740 STC\uC758 \uC2A4\uD0DC\uD504\uB85C\uC11C\\r\\n\uACC4\uC18D\uD574\uC11C \uD65C\uB3D9\uD574 \uC8FC\uC2DC\uBA74 \uB429\uB2C8\uB2E4.[VAR 0114(000A)]",
  "...\uC774\uC0C1\uC785\uB2C8\uB2E4\uB9CC,\\n\uBB54\uAC00 \uAC71\uC815\uB418\uB294 \uAC83\uC740 \uC5C6\uC73C\uC2E0\uC9C0\uC694.[VAR 0114(000A)]",
  "\uADF8\uAC8C... \uC7AC\uBC0C\uC5B4 \uBCF4\uC774\uAE34 \uD558\uACE0,\\n\uBB54\uAC00 \uC708\uC708\uCC98\uB7FC \uB290\uAEF4\uC9C0\uAE34 \uD558\uB294\uB370...[VAR 0114(0008)]",
  "\uBC8C\uC744 \uBC1B\uB294 \uC785\uC7A5\uC778 \uC6B0\uB9AC\uAC00 \uB9D0\uD558\uB294 \uAC8C\\n\uC870\uAE08 \uC774\uC0C1\uD558\uAE34 \uD558\uC9C0\uB9CC, \uBAA8\uB780\uB3C4 \uAC19\uC774 \uD558\uC790![VAR 0114(0020)]",
  "\uB3D9\uC758\uD558\uC624...\\n\uBAA8\uB780 \uB098\uB9AC\uB3C4 \uAC19\uC774...[VAR 0114(0023)]",
  "\uD559\uAD50\uB3C4 \uAC19\uC774 \uB2E4\uB2C8\uB294 \uAC70\uC57C!\\n\uBB34\uC2A8 \uC77C\uC774 \uC788\uC5B4\uB3C4, \uC6B0\uB9AC\uAC00 \uC9C0\uCF1C \uC904 \uD14C\uB2C8\uAE4C![VAR 0114(0022)]",
  "\uC2A4\uD0C0\uB2E8\uC744 \uD558\uBA74\uC11C\\n\uD559\uAD50\uB3C4 \uB2E4\uB2D0 \uC218 \uC788\uC73C\uBA74 \uC88B\uACA0\uB2E4\uACE0\\r\\n\uC6B0\uB9AC\uB07C\uB9AC\uB3C4 \uC804\uBD80\uD130 \uC598\uAE30\uD588\uC5C8\uAC70\uB4E0.[VAR 0114(0021)]",
  "...\uC65C, \uC2EB\uC5B4?[VAR 0114(001F)]",
  "\uC598\uB4E4\uC544...[VAR 0114(0008)]",
  "[VAR 0100(0000)]... \uB108\uB294 \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD574?[VAR 0114(0008)]",
  "\uC88B\uC740 \uC0DD\uAC01\uC778 \uAC83 \uAC19\uC544!",
  "\uC5F4\uC2EC\uD788 \uD574 \uBD10!",
  "\uADF8, \uADF8\uCE58\uB9CC!\\n\uC73C\uC74C... \uC74C....[VAR 0114(0008)]",
  "\uC9C0\uAE08 \uBC14\uB85C \uC815\uD558\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4.\\n\uCC9C\uCC9C\uD788 \uC0DD\uAC01\uD574 \uBCF4\uC2DC\uC9C0\uC694.[VAR 0114(000A)]",
  "\uC77C\uB2E8,\\n\uD574\uC0B0\uD558\uB3C4\uB85D \uD560\uAE4C\uC694?\\r\\n...\uB2E8\uC774 \uC544\uB2C8\uB77C \uC9C0\uAE08 \uC774 \uC790\uB9AC \uB9D0\uC785\uB2C8\uB2E4![VAR 0114(000A)]",
  "[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591\uAED8\uC11C\uB294 \uB098\uC911\uC5D0\\n\uAD50\uC7A5\uC2E4\uB85C \uC640 \uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?[VAR 0114(000A)]"
]
