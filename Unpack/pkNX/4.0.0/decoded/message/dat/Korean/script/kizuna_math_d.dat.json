  "\uC5B8\uC81C\uB098 \uC808\uBB18\uD55C \uD0C0\uC774\uBC0D\uC5D0 \uB098\uD0C0\uB098 \uC8FC\uB294\\n[VAR 0100(0000)]\uC5D0\uAC8C \uAC10\uC0AC\uD574\uC57C\uACA0\uB294\uAC78?[VAR 0114(0025)]",
