  "\uC8C4, \uC8C4\uC1A1\uD574\uC694!\\n\uC774\uBBF8 \uB208\uCE58\uCC44\uC168\uAD70\uC694...",
  "\uC628\uC885\uC77C \uC2DC\uC120\uC774 \uB290\uAEF4\uC84C\uC73C\uB2C8 \uB2F9\uC5F0\uD558\uC9C0!\\n\uB098\uD55C\uD14C \uBB3C\uC5B4\uBCF4\uACE0 \uC2F6\uC740 \uAC8C \uC788\uB294 \uAC70 \uC544\uB2C8\uC57C!?[VAR 0114(0025)]",
  "\uB124? \uB124...",
  "\uC800, \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774\uC2E4 \uB54C\uBD80\uD130\\n\uD0C0\uC784 \uB2D8\uC758 \uC655\uD32C\uC774\uC5C8\uC5B4\uC694!\\r\\n\uBC14\uC704 \uAE30\uC220\uB3C4 \uC5C4\uCCAD \uC88B\uC544\uD558\uAD6C\uC694!!",
  "\uC5B4\uBA38\uB098.[VAR 0114(0025)]",
  "\uADF8\uB7F0\uB370, 1\uB144 \uBC18 \uC804\uC5D0\\n\uAC11\uC790\uAE30 \uC740\uD1F4\uD558\uC168\uC796\uC544\uC694...\\r\\n\uC5B4\uC9F8\uC11C \uADF8\uB9CC\uB450\uC2E0 \uAC70\uC608\uC694?",
  "...\uBB50\uC57C, \uADF8\uAC8C \uAD81\uAE08\uD588\uB358 \uAC70\uC57C?[VAR 0114(0025)]",
  "\uD0C0\uC784 \uB2D8\uC774 \uC740\uD1F4\uD558\uC2E0 \uC774\uC720,\\n\uACF5\uC2DD\uC801\uC73C\uB85C \uBC1C\uD45C\uB41C \uAC83\uB3C4 \uC5C6\uACE0,",
  "\uC5EC\uCB64\uBD10\uB3C4 \uB300\uCDA9 \uC5BC\uBC84\uBB34\uB9B0\uB2E4\uACE0\\n\uD559\uC0DD\uB4E4 \uC0AC\uC774\uC5D0\uC11C\uB3C4 \uC18C\uBB38\uC774 \uC790\uC790\uD574\uC11C...",
  "\uD0C0\uC784 \uB2D8\uC774 \uB9D0\uC500\uD558\uACE0 \uC2F6\uC9C0 \uC54A\uC73C\uC2E0 \uAC78\\n\uC5EC\uCB64\uBCF4\uB294 \uAC8C \uC2E4\uB840\uC778 \uAC83 \uAC19\uAE30\uB3C4 \uD558\uACE0...\\r\\n\uADF8\uB798\uC11C \uC6A9\uAE30\uAC00 \uC548 \uB098\uB294 \uBC14\uB78C\uC5D0...",
  "\uADF8\uB798\uC11C \uADF8 \uAC00\uC2B4 \uC124\uB808\uB294 \uC2DC\uC120\uC744...\\n\uACE0\uC0DD\uD558\uAC8C \uD574\uC11C \uBBF8\uC548.[VAR 0114(0025)]",
  "\uB124? \uAC00\uC2B4\uC774 \uC124\uB808\uC694...?",
  "\uC544, \uC544\uBB34\uD2BC...\\n\uADF8\uB9CC\uB454 \uC774\uC720\uB294 \uB9D0\uC774\uC9C0,\\r\\n\uC880 \uB354 \uAD50\uC0AC \uC77C\uC5D0 \uC9D1\uC911\uD558\uACE0 \uC2F6\uC5B4\uC11C\uC57C.[VAR 0114(0025)]",
  "\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uC77C\uC774 \uC2EB\uC5B4\uC11C\\n\uADF8\uB9CC\uB454 \uAC8C \uC544\uB2C8\uB77C...[VAR 0114(0025)]",
  "\uCCB4\uC721\uAD00\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD558\uBA74\\n\uC61B\uB0A0 \uC0DD\uAC01\uC774 \uB098\uC11C \uC870\uAE08 \uC4F8\uC4F8\uD574\uC9C0\uB2C8\uAE4C...[VAR 0114(0025)]",
