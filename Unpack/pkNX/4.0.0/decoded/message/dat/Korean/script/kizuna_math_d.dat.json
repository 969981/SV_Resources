[
  "[VAR 0100(0000)]!\\n\uB108\uB3C4 \uC9C0\uCF1C\uBD10 \uC918![VAR 0114(0025)]",
  "\uC9C0\uAE08\uBD80\uD130 \uC804\uC5D0 \uADF8 \uC2DC\uC120\uC758 \uC8FC\uC778\uC744\\n\uC7A0\uBCF5\uD574\uC11C \uAE30\uB2E4\uB9AC\uB824\uB358 \uCC38\uC774\uC5C8\uAC70\uB4E0![VAR 0114(0025)]",
