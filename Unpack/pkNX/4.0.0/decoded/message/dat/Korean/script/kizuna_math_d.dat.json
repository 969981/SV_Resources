  "\uB2E4\uC2DC \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC73C\uB85C\\n\uBCF5\uADC0\uD558\uC2E4 \uC0DD\uAC01\uC740 \uC5C6\uC73C\uC2E0 \uAC70\uC608\uC694?",
  "\uC751... \uC5C6\uC5B4.[VAR 0114(0025)]",
  "\uC9C0\uAE08\uC740 \uB3D9\uC0DD\uC774 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC73C\uB85C\uC11C\\n\uC798\uD574 \uC8FC\uACE0 \uC788\uACE0,[VAR 0114(0025)]",
  "\uC5B8\uB2C8\uC778 \uB098\uB294\\n\uAD50\uC0AC \uC77C\uC774 \uAC00\uC7A5 \uC990\uAC70\uC6B0\uB2C8\uAE4C.[VAR 0114(0025)]",
  "\uADF8\uB7EC\uB2C8\uAE4C, \uD0C0\uC784 \uB2D8\uC774 \uC544\uB2C8\uB77C\\n\uD0C0\uC784 \uC120\uC0DD\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC \uC8FC\uBA74\\r\\n\uC120\uC0DD\uB2D8\uC740 \uC815\uB9D0 \uAE30\uC060 \uAC70\uC57C.[VAR 0114(0025)]",
