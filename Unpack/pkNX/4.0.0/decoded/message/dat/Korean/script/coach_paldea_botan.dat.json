  "\uB098\uB97C \uC790\uC8FC \uBC16\uC73C\uB85C \uBD88\uB7EC\uB0B4 \uC918\uC11C \uACE0\uB9C8\uC6CC.\\c\\n\uC804\uC9C1 \uC9D1\uC21C\uC774 \uC785\uC7A5\uC5D0\uC11C \uC870\uAE08 \uD798\uB4E4\uAE34 \uD558\uC9C0\uB9CC...\\n\uADF8\uB798\uB3C4 \uC7AC\uBBF8\uC788\uC5B4.[VAR 0114(0008)]",
  "\uB124\uAC00 \uAD50\uD658\uD574 \uC900 [VAR 0101(0001)],\\n\uB0B4 \uBE0C\uC774\uBE0C\uC774\uB4E4\uACFC\uB3C4 \uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uC5B4.[VAR 0114(0008)]",
