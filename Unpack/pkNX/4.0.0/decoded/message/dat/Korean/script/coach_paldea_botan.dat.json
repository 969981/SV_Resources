  "[~ 60]",
  "\uC544~ \uC5B4\uB5BB\uAC8C \uB41C \uAC70\uC57C~\\n\uBE0C\uC774\uBE0C\uC774\uB4E4\uC774 \uB2F9\uD588\uC796\uC544~[VAR 0114(0008)]",
