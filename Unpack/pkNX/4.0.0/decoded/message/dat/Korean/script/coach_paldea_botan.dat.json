  "\uBB50, \uC801\uC751 \uD6C8\uB828\uC778 \uC148 \uCE58\uACE0\\n\uC870\uAE08\uC740... \uD798\uB0B4 \uBCFC\uAC8C...[VAR 0114(0008)]",
  "\uADF8\uB807\uB2E4\uACE0 \uC774\uB7F0 \uB0AF\uC120 \uACF3\uC5D0\\n\uD63C\uC790 \uC624\uB798 \uB0A8\uACA8 \uB450\uBA74 \uC548 \uB3FC.[VAR 0114(0008)]",
