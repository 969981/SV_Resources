  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74 \uAD50\uD658\uD560 \uC218 \uC5C6\uC5B4.\\n2\uB9C8\uB9AC\uB294 \uC9C0\uB2C8\uACE0 \uC788\uC5B4\uC57C \uD574.[VAR 0114(0008)]",
  "\uAD50\uD658\uD558\uC9C0 \uC54A\uC744 \uAC70\uC57C?\\n\uD63C\uC2E0\uC758 \uBE0C\uC774\uBE0C\uC774\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB294\uB370.[VAR 0114(0008)]",
  "\uC9C0\uB09C\uBC88\uC5D0 \uBABB \uD588\uB358 \uD3EC\uCF13\uBAAC \uAD50\uD658, \uB2E4\uC2DC \uD560\uAE4C?[VAR 0114(0008)]",
  "\uD639\uC2DC, [VAR 0100(0000)]...\\n\uB098\uB97C \uC2B5\uACA9\uD558\uB824\uB294 \uAC70\uC57C?[VAR 0114(0008)]",
  "\uB208\uC744 \uBC18\uC9DD\uAC70\uB9AC\uAE38\uB798\\n\uC2B5\uACA9\uC778 \uC904 \uC54C\uC558\uC5B4.[VAR 0114(0008)]",
