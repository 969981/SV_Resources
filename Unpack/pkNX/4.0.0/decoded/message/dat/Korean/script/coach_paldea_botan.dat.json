[
  "\uC548\uB155, [VAR 0100(0000)].[VAR 0114(0008)]",
  "\uC5EC\uAE30\uAC00 \uBD80\uC2E4 \uB9DE\uC9C0?\\n\uC774\uC81C\uBD80\uD130 \uB0B4\uAC00 \uC811\uC218\uD558\uB824\uACE0.[VAR 0114(0008)]",
