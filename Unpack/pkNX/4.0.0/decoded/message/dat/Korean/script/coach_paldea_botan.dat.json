  "\uC54C\uACE0 \uC788\uC5B4!",
  "\uC5B4\uC9F8\uC11C?",
  "\uC557, \uADF8\uB798!?\\n\uADF8\uB807\uAC8C \uC720\uBA85\uD55C \uAC70\uC600\uC5B4!?[VAR 0114(0008)]",
  "\uC557, \uBAA8\uB974\uB294\uAD6C\uB098!?\\n\uBC29\uAE08 \uC54C\uC544\uB0B8 \uAC74\uB370 \uAC00\uB974\uCCD0 \uC904\uAC8C...[VAR 0114(0008)]",
  "\uC5EC\uAE30\uBCF4\uB2E4 \uB354 \uC544\uB798\uCE35\uC5D0\\n\uD574\uC800 \uC790\uC6D0 \uAC1C\uBC1C \uD50C\uB79C\uD2B8\uAC00 \uC788\uB294\uB370[VAR 0114(0008)]",
  "\uAC70\uAE30\uC11C \uD574\uC591 \uC5F0\uAD6C\uB97C \uD558\uBA74\uC11C\\n\uD574\uC800 \uC790\uC6D0\uC744 \uC870\uC0AC\uD558\uACE0 \uC788\uB300![VAR 0114(0008)]",
  "\uBB3C\uB860, \uD559\uC0DD\uC740\\n\uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uB2E4\uB294 \uBAA8\uC591\uC774\uC57C...[VAR 0114(0008)]",
  "\uADF8\uB798\uB3C4, \uC6B0\uB9AC \uBC1C\uBC11\uC5D0\uC11C \uCD5C\uC2E0 \uACFC\uD559\uC774\\n\uC6C0\uC9C1\uC774\uACE0 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB2C8 \uAFC8\uB9CC \uAC19\uC544~![VAR 0114(0008)]",
  "\uC557, [VAR 0100(0000)]!\\n\uB0B4 \uC774\uC57C\uAE30 \uC880 \uB4E4\uC5B4 \uBD10![VAR 0114(0008)]",
  "\uB4E4\uC744\uAC8C!",
  "\uC548 \uB4E4\uC744\uB798",
  "\uACE0\uB9C8\uC6CC! \uB108\uBB34 \uD765\uBD84\uB3FC\uC11C\\n\uB3C4\uC800\uD788 \uBABB \uCC38\uACA0\uC5B4\uC11C \uB9D0\uC774\uC57C![VAR 0114(0008)]",
  "\uC751? \uAC11\uC790\uAE30 \uC65C \uADF8\uB798?\\n\uBB50, \uB4E3\uC9C0 \uC54A\uC544\uB3C4 \uB9D0\uD560 \uAC70\uC9C0\uB9CC![VAR 0114(0008)]",
  "\uC774 \uC544\uCE74\uB370\uBBF8 \uBC11\uC5D0 \uC788\uB294\\n\uD574\uC800 \uC790\uC6D0 \uAC1C\uBC1C \uD50C\uB79C\uD2B8 \uC788\uC796\uC544!\\r\\n\uC548\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4 \uC654\uC5B4! \uC815\uB9D0 \uAD49\uC7A5\uD588\uB2E4\uAD6C![VAR 0114(0008)]",
  "\uC785\uAD6C \uB85C\uBE44\uC5D0\uC11C\\n\uC774\uACF3\uC5D0 \uB300\uD574 \uC870\uC0AC\uD558\uACE0 \uC788\uC5C8\uB294\uB370...[VAR 0114(0008)]",
  "\uD558\uC580 \uC591\uBCF5\uC758 \uB304\uB514\uD55C \uC544\uC800\uC528\uAC00 \uC640\uC11C\uB294\\n\uC6C3\uC73C\uBA74\uC11C \uAD6C\uACBD\uC2DC\uCF1C \uC92C\uC5B4.[VAR 0114(0008)]",
