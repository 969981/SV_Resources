[
  "[~ 18]",
  "...\uC624, \uC5B4\uB514\uC11C \uB098\uD0C0\uB09C \uAC70\uC57C?\\n\uC804\uD600 \uB208\uCE58\uCC44\uC9C0 \uBABB\uD588\uC5B4.[VAR 0114(002C)]",
  "\uB108\uB294...\\n\uADF8\uB7EC\uB2C8\uAE4C... \uB9D0\uD558\uC9C0 \uB9D0\uACE0 \uC788\uC5B4 \uBD10!\\r\\n\uB0B4\uAC00 \uB9DE\uD600 \uBCFC \uD14C\uB2C8\uAE4C![VAR 0114(002C)]",
  "\uC790\uC5F0 \uD559\uAD50\uC5D0 \uCC38\uAC00 \uC911\uC778\\n\uD314\uB370\uC544\uC5D0\uC11C \uC628 \uD559\uC0DD \uCE5C\uAD6C! \uB9DE\uC9C0?[VAR 0114(002C)]",
  "\uC815\uB2F5\uC774\uC5D0\uC694!",
  "\uC5B4\uB5BB\uAC8C \uC544\uC168\uC5B4\uC694?",
  "\uD6C4\uD6C4\uD6C4~\\n\uC881\uC740 \uB3D9\uB124\uB2E4 \uBCF4\uB2C8\uAE4C \uC774\uAC83\uC800\uAC83\\r\\n\uADC0\uC5D0 \uB4E4\uC5B4\uC624\uB294 \uC815\uBCF4\uAC00 \uC788\uAC70\uB4E0![VAR 0114(002C)]",
  "\uB0B4 \uC774\uB984\uC740 \uC138\uB958.\\n\uCE74\uBA54\uB77C\uB97C \uC880 \uC88B\uC544\uD558\uB294 \uB098\uADF8\uB124\uB784\uAE4C?[VAR 0114(0046)]",
  "\uC774\uCABD\uC740 \uB0B4 \uD30C\uD2B8\uB108 \uAC00\uB514\uC57C.\\n\uBA38\uB9AC\uC758 \uBFD4\uC774 \uADC0\uC5FD\uC9C0?[VAR 0114(0046)]",
  "\uADF8\uB989!",
  "\uAC11\uC791\uC2A4\uB7EC\uC6B4 \uBD80\uD0C1\uC774\uB77C \uBBF8\uC548\uD558\uC9C0\uB9CC,\\n\uB124 \uC0AC\uC9C4\uC744 \uCC0D\uC5B4\uB3C4 \uB420\uAE4C?[VAR 0114(0046)]",
  "\uC774\uB7F0 \uC774\uB7F0, \uD559\uC0DD \uCE5C\uAD6C...\\n\uB108\uBB34 \uC21C\uC9C4\uD574\uC11C \uAC71\uC815\uC778\uAC78.\\r\\n\uBAA8\uB974\uB294 \uC0AC\uB78C\uC744 \uC123\uBD88\uB9AC \uBBFF\uB294 \uAC74 \uC88B\uC9C0 \uC54A\uB2E4\uAD6C.[VAR 0114(0046)]",
  "\uBB3C\uB860, \uC0AC\uC9C4\uC740 \uCC0D\uC744 \uAC70\uC9C0\uB9CC![VAR 0114(0046)]",
  "\uBC29\uAE08 \uB9CC\uB09C \uC0AC\uB78C\uC744\\n\uACFC\uD558\uAC8C \uBBFF\uC9C0 \uC54A\uB294\uB2E4\uB77C!\\r\\n\uC544\uC8FC \uB611 \uBD80\uB7EC\uC9C4 \uD559\uC0DD \uCE5C\uAD6C\uC778\uAC78![VAR 0114(0046)]",
  "\uB10C \uBB54\uAC00 \uC2E0\uC120\uD558\uACE0\\n\uC7AC\uBC0C\uB294 \uAC83 \uAC19\uC544.[VAR 0114(0046)]",
  "\uB098\uB294 \uB2F9\uBD84\uAC04\\n\uC774 \uB9C8\uC744\uC744 \uAC70\uC810\uC73C\uB85C \uC0BC\uC744 \uC608\uC815\uC774\uC57C.[VAR 0114(0046)]",
  "\uD560 \uC77C\uC774 \uB2E4 \uB05D\uB098\uBA74\\n\uB610 \uC774\uC57C\uAE30\uD558\uC790.\\c\\n\uBD81\uC2E0\uB3C4\uAC10\uC5D0 \uD3EC\uCF13\uBAAC\uC744\\n150\uB9C8\uB9AC \uB4F1\uB85D\uD55C\uB2E4\uB4E0\uC9C0 \uD558\uB294 \uAC70 \uB9D0\uC774\uC57C![VAR 0114(0046)]",
  "\uC6B0\uB9AC \uD559\uC0DD \uCE5C\uAD6C\uC5D0\uAC8C\uB294 \uC544\uC9C1\\n\uD560 \uC77C\uC774 \uB354 \uC788\uC9C0 \uC54A\uB098?\\c\\n\uBD81\uC2E0\uB3C4\uAC10\uC5D0 \uD3EC\uCF13\uBAAC\uC744\\n150\uB9C8\uB9AC \uB4F1\uB85D\uD55C\uB2E4\uB4E0\uC9C0 \uD558\uB294 \uAC70 \uB9D0\uC774\uC57C!\\r\\n\uADF8\uAC8C \uB2E4 \uB05D\uB098\uBA74 \uB610 \uC774\uC57C\uAE30\uD558\uC790.\\c\\n\uC2DC\uAC04\uC740 \uC18C\uC911\uD558\uB2E4\uAD6C!\\n\uD0C0\uC784 \uC774\uC988 \uBA38\uB2C8! \uC624\uCF00\uC774?[VAR 0114(0046)]"
]
