[
  "\uC2E4\uB840\uD569\uB2C8\uB2E4.[VAR 0114(002C)]",
  "\uC870\uAE08 \uC804\uC5D0\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0\uAC8C \uC2B9\uB9AC\uD55C \uBD84\uC774\uC2DC\uC8E0?[VAR 0114(002C)]",
  "\uC774\uB984\uC740 \uBD84\uBA85...\\n[VAR 0100(0000)] \uB2D8\uC774\uC2DC\uAD6C\uC694.[VAR 0114(002C)]",
  "\uB2F9\uC2E0\uB3C4 \uCC54\uD53C\uC5B8\uC744\\n\uBAA9\uD45C\uB85C \uD558\uACE0 \uACC4\uC2E0\uAC00\uC694?[VAR 0114(002C)]",
  "\uC88B\uC740 \uB2F5\uBCC0 \uAC10\uC0AC\uD569\uB2C8\uB2E4.\\n\uBCF4\uAE30 \uB4DC\uBB38 \uC80A\uC740 \uC7AC\uB2A5...\\r\\n\uACC4\uC18D\uD574\uC11C \uB354 \uB192\uC740 \uACF3\uC744 \uD5A5\uD574 \uC815\uC9C4\uD574 \uC8FC\uC138\uC694.[VAR 0114(002C)]",
  "\uC5B4\uBA38, \uADF8\uB807\uAD70\uC694.\\n\uBCF4\uAE30 \uB4DC\uBB38 \uC80A\uC740 \uC7AC\uB2A5...\\r\\n\uADF8 \uC2E4\uB825\uC774 \uB108\uBB34 \uC544\uAE5D\uB124\uC694.[VAR 0114(002C)]",
  "\uC774\uB7F0, \uC81C \uC18C\uAC1C\uAC00 \uB2A6\uC5C8\uB124\uC694.[VAR 0114(002C)]",
  "\uC81C \uC774\uB984\uC740 \uD14C\uC0AC.\\n\uD3EC\uCF13\uBAAC\uCCB4\uC721\uAD00\uC744 \uC6B4\uC601\uD558\uB294\\r\\n\uD3EC\uCF13\uBAAC\uB9AC\uADF8\uC758 \uC704\uC6D0\uC7A5\uC785\uB2C8\uB2E4.[VAR 0114(0011)]",
  "\uB2F9\uC2E0\uC774 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uACC4\uC18D\uD574\uC11C \uBAA8\uC73C\uC2E0\uB2E4\uBA74\\n\uC5B8\uC820\uAC00 \uB2E4\uC2DC \uB9CC\uB0A0 \uC218 \uC788\uACA0\uB124\uC694.[VAR 0114(0011)]",
  "\uADF8\uB7FC, \uC800\uB294 \uC774\uB9CC.[VAR 0114(0011)]"
]
