  "\uC544\uB2C8, \uC544\uB2C8\uC9C0!\\n\uC6B0\uB9AC \uC14B\uC740 \uCC98\uC74C\uC774\uC796\uC544![VAR 0114(0006)]",
  "\uADF8\uB7EC\uC2DC\uAD70\uC694.[VAR 0114(0045)]",
  "\uC219\uC18C\uB294 \uC774 \uAC74\uBB3C \uC548\uC5D0 \uC788\uB294\\n\uBC29\uC744 \uC774\uC6A9\uD558\uC2DC\uBA74 \uB429\uB2C8\uB2E4.\\r\\n\uC774\uBD88\uB3C4 \uB2E4 \uD587\uBCD5\uC5D0 \uB9D0\uB824 \uB450\uC5C8\uC2B5\uB2C8\uB2E4![VAR 0114(0045)]",
  "\uC624\uC624... \uAC10\uB3D9 \uC11C\uBE44\uC2A4![VAR 0114(0008)]",
