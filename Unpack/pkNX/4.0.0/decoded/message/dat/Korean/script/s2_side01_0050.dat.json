  "\uC640~!\\n\uC5EC\uAE30\uAC00 \uC2A4\uC774\uB85D\uB9C8\uC744\uC774\uAD6C\uB098![VAR 0114(0004)]",
  "\uBB54\uAC00 \uD314\uB370\uC544\uB791\\n\uB0C4\uC0C8\uBD80\uD130 \uB2E4\uB978 \uAC83 \uAC19\uC544~![VAR 0114(0004)]",
  "\uD558\uC544... \uD558\uC544... \uBA38\uB9AC\uAC00 \uC5B4\uC9C0\uB7EC\uC6CC...\\n\uB4DC\uB514\uC5B4 \uB9C8\uC744\uC5D0 \uB3C4\uCC29\uD55C \uAC70\uC57C...?[VAR 0114(0008)]",
