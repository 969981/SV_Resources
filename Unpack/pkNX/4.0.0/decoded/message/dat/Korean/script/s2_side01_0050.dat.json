  "\uADF8\uCE58\uB9CC... \uC804\uD30C\uAC00...\\n\uBD88\uC548\uC815\uD588\uB2E8 \uB9D0\uC774\uC57C...[VAR 0114(0008)]",
  "\uC544\uC774\uACE0~\\n\uC5B4\uC11C \uC624\uC138\uC694, \uC5EC\uB7EC\uBD84.[VAR 0114(0045)]",
  "\uC548\uB155\uD558\uC138\uC694![VAR 0114(0004)]",
  "\uC608, \uC548\uB155\uD558\uC138\uC694~\\n\uC800\uB294 \uC774 \uB9C8\uC744\uC758 \uAD00\uB9AC\uC778\uC785\uB2C8\uB2E4.[VAR 0114(0045)]",
