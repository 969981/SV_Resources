[
  "\uC5B4\uC11C \uC635\uC1FC~![VAR 0114(0018)]",
  "\uACA9\uB958\uC758 \uC694\uB9AC\uC0AC \uACE4\uD3EC\uAC00 \uC9C1\uC811!\\n\uBC30\uB2EC\uD558\uB7EC \uC654\uB2E4![VAR 0114(0018)]",
  "\uC6B0\uC624\uC624\uC637~! \uB108\uAD6C\uB098![VAR 0114(0018)]",
  "\uD559\uC0DD \uC2E0\uBD84\uC5D0 \uD2B9\uBCC4 \uAC15\uC0AC\uB97C\\n\uCD08\uB300\uD558\uB294 \uC77C\uAE4C\uC9C0 \uB9E1\uACE0 \uC788\uB294 \uAC70\uB0D0!?[VAR 0114(0018)]",
  "\uC815\uB9D0\uC774\uC9C0 \uAD49\uC7A5\uD55C \uC544\uC774\uB77C\uB2C8\uAE4C![VAR 0114(0018)]",
  "\uB9DE\uC544\uC694!",
  "\uADF8 \uC815\uB3C4\uAE4C\uC9C0\uB294...",
  "\uC640\uD558\uD558!\\n\uC790\uC2E0\uC744 \uAE0D\uC815\uD560 \uC218 \uC788\uB294 \uC790\uC2E0\uAC10\uAE4C\uC9C0!\\r\\n\uC774\uAC70 \uC6D4\uCC99\uC774\uAD70! \uC6D4\uCC99\uC774\uC57C![VAR 0114(0018)]",
  "\uC640\uD558\uD558!\\n\uAD49\uC7A5\uD55C \uAC74 \uAD49\uC7A5\uD558\uB2E4\uACE0 \uD574\uC57C\uC9C0!\\r\\n\uB108\uBB34 \uACB8\uC190\uD574 \uBD24\uC790 \uC88B\uC744 \uAC74 \uC5C6\uB2E4\uACE0![VAR 0114(0018)]",
  "\uC544\uBB34\uD2BC, \uC774\uB807\uAC8C \uC6D0\uC815\uC744 \uB098\uC62C \uAE30\uD68C\uB97C \uC918\uC11C\\n\uC815\uB9D0 \uACE0\uB9D9\uB2E4![VAR 0114(0018)]",
  "\uB098\uB3C4 \uD559\uC0DD\uB4E4\uACFC \uD568\uAED8\\n\uC131\uC7A5\uD574 \uBCF4\uB3C4\uB85D \uD558\uB9C8![VAR 0114(0018)]",
  "\uC5EC\uAE30\uB294 \uBC14\uB2E4\uC5D0 \uB458\uB7EC\uC2F8\uC5EC \uC788\uC5B4\uC11C \uADF8\uB7F0\uC9C0\\n\uD658\uACBD\uC774 \uC544\uC8FC \uC88B\uB354\uAD6C\uB098![VAR 0114(0018)]",
  "\uB098\uB3C4 \uD3EC\uCF13\uBAAC\uB4E4\uB3C4\\n\uBC14\uB2F7\uBC14\uB78C\uC5D0 \uAE30\uBD84\uC774 \uB4E4\uB5A0 \uC788\uB2E8\uB2E4![VAR 0114(0018)]",
  "\uADF8\uB7F0\uB370 \uC2DD\uB2F9 \uBA54\uB274\uC5D0\\n\uD574\uC0B0\uBB3C\uC774 \uD558\uB098\uB3C4 \uC5C6\uB2E8 \uB9D0\uC774\uC9C0...[VAR 0114(0018)]",
  "\uC778\uADFC \uBC14\uB2E4\uC5D0\uC11C \uC5BB\uC740 \uC2E0\uC120\uD55C \uD574\uC0B0\uBB3C\uC744\\n\uBC30\uBD80\uB974\uAC8C \uBA39\uC744 \uC218 \uC788\uB2E4\uBA74...\\r\\n\uD559\uC0DD\uB4E4\uC774 \uAE30\uBED0\uD558\uC9C0 \uC54A\uC744\uAE4C!?[VAR 0114(0018)]",
  "\uAE30\uBED0\uD560 \uAC70\uC608\uC694!",
  "\uC9C0\uAE08\uB3C4 \uAD1C\uCC2E\uC740\uB370...",
  "\uB108\uC758 \uADF8 \uB9D0\uC5D0 \uD655\uC2E0\uC774 \uC11C\uB294\uAD6C\uB098!\\n\uC774 \uC0AC\uB098\uC774 \uACE4\uD3EC\uAC00! \uD55C\uBC88 \uD798\uC744 \uC368 \uBCF4\uB9C8!![VAR 0114(0018)]",
  "\uC815\uD06C \uD478\uB4DC\uB3C4 \uAC00\uB054\uC529\uC740 \uAD1C\uCC2E\uB2E4\uB9CC\\n\uB9E4 \uB07C\uB2C8 \uBA39\uC73C\uBA74 \uC601\uC591\uC774 \uBD88\uADE0\uD615\uD574\uC9C8 \uAC8C\uB2E4![VAR 0114(0018)]",
  "\uD559\uC0DD\uB4E4\uC544, \uAE30\uB2E4\uB824\uB77C!\\n\uD63C\uB780\uC5D0 \uBE60\uC9C4 \uC2DD\uB2F9\uC774\uB780 \uC774\uB984\uC758 \uC5B4\uC7A5\uC744!\\r\\n\uACE4\uD3EC\uAC01\uC774 \uAD6C\uC6D0\uD574 \uC904 \uD14C\uB2C8 \uB9D0\uC774\uB2E4![VAR 0114(0018)]",
  "\uC624\uC637! \uB108\uAD6C\uB098!\\n\uB4E3\uACE0 \uB180\uB77C\uC9C0 \uB9D0\uAC70\uB77C![VAR 0114(0018)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758\\n\uD559\uC0DD\uC2DD\uB2F9\uACFC \uACE4\uD3EC\uAC01\uC774...\\r\\n\uCF5C\uB77C\uBCF4\uB97C \uD558\uAC8C \uB410\uC9C0 \uBB50\uB0D0![VAR 0114(0018)]",
  "\uAD49\uC7A5\uD574\uC694!",
  "\uAE30\uB300\uB3FC\uC694!",
  "\uC774\uC81C \uB9C9 \uACB0\uC815\uB41C \uAC83\uC774\uB77C\\n\uC815\uC2DD\uC73C\uB85C \uAC00\uB3D9\uD558\uB824\uBA74 \uBA40\uC5C8\uC9C0\uB9CC \uB9D0\uC774\uB2E4![VAR 0114(0018)]",
  "\uC6B0\uC120 \uACE4\uD3EC\uAC01\uC758 \uBA85\uBB3C\uC778 \uBD88\uB3C4\uC7A5\uC744\\n\uD559\uC0DD\uB4E4\uC758 \uCDE8\uD5A5\uC5D0 \uB9DE\uAC8C \uC5B4\uB808\uC778\uC9C0\uD560 \uAC70\uB780\uB2E4![VAR 0114(0018)]",
  "\uC131\uC7A5 \uC911\uC778 \uC5B4\uB9B0\uC774\uB4E4\uC5D0\uAC8C\\n\uC88B\uC740 \uAC83\uC744 \uBA39\uC774\uACE0 \uC2F6\uC73C\uB2C8 \uB9D0\uC774\uB2E4![VAR 0114(0018)]",
  "...\uC774\uAC70, \uD558\uACE0 \uC2F6\uC740 \uC77C\uC744 \uD558\uB2E4 \uBCF4\uB2C8\\n\uC601\uC591\uD559\uC758 \uC138\uACC4\uAE4C\uC9C0 \uC640 \uBC84\uB9AC\uACE0 \uB9D0\uC558\uAD70![VAR 0114(0018)]",
  "\uB124\uAC00 \uC774 \uC544\uCE74\uB370\uBBF8\uB85C \uCD08\uB300\uD574 \uC900 \uB355\uBD84\uC5D0\\n\uB098\uB3C4 \uB9CE\uC774 \uBC30\uC6B0\uAC8C \uB418\uB294\uAD6C\uB098![VAR 0114(0018)]",
  "\uC640\uD558\uD558! \uC815\uB9D0 \uACE0\uB9D9\uB2E4![VAR 0114(0018)]",
  "\uC774\uB300\uB85C \uD750\uB984\uC744 \uD0C0\uC11C\\n\uB098\uC640 \uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD558\uB294 \uAC74 \uC5B4\uB5A0\uB0D0!?[VAR 0114(0018)]",
  "\uC640\uD558\uD558!\\n\uB098\uB294 \uAC00\uBE44\uB8E8\uC0AC\uB97C \uC8FC\uB9C8!\\r\\n\uB108\uB294 \uC5B4\uB5BB\uAC8C \uD560 \uAC70\uC9C0?[VAR 0114(0018)]",
  "[VAR 0101(0001)][VAR 1900(0006)]\uB77C! \uD65C\uAE30\uAC00 \uB118\uCE58\uB294\uAD6C\uB098!\\n\uC774\uAC70 \uC6D4\uCC99\uC774\uAD70! \uC6D4\uCC99\uC774\uC57C!\\c\\n\uC815\uC131\uC744 \uB2E4\uD574\uC11C \uD0A4\uC6B0\uB3C4\uB85D \uD558\uB9C8![VAR 0114(0018)]",
  "\uB108\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uB098\uC758 \uAC00\uBE44\uB8E8\uC0AC\uB97C \uAD50\uD658\uD558\uB294 \uAC70\uC9C0?[VAR 0114(0018)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uC744 \uD560 \uC218 \uC5C6\uB2E8\uB2E4!\\c\\n2\uB9C8\uB9AC \uC774\uC0C1\uC740 \uB370\uB824\uC628 \uB2E4\uC74C\uC5D0\\n\uC774\uC57C\uAE30\uD558\uC790\uAFB8\uB098![VAR 0114(0018)]",
  "\uC6B0\uC624\uC624\uC637~!?\\n\uC124\uB9C8 \uAC70\uC808\uC744 \uB2F9\uD560 \uC904\uC774\uC57C![VAR 0114(0018)]",
  "\uB098\uC640 \uD3EC\uCF13\uBAAC \uAD50\uD658\uC744 \uD560 \uB9C8\uC74C\uC774 \uB4E0 \uAC70\uB0D0!?[VAR 0114(0018)]",
  "\uC5B4\uC11C \uC635\uC1FC~!\\c\\n\uC774 \uC544\uC800\uC528\uC640 \uC2F1\uC2F1\uD55C \uC2B9\uBD80\uB97C\\n\uC2DC\uC791\uD574 \uBCF4\uB294 \uAC74 \uC5B4\uB5A0\uB0D0!?[VAR 0114(0018)]",
  "\uADF8\uAC70 \uC544\uC27D\uAD6C\uB098... \uD06C\uD751.[VAR 0114(0018)]",
  "\uC774\uAC70 \uAC70\uBB3C\uC774 \uAC78\uB838\uAD70!\\n\uADF8\uB7FC, \uC7A5\uC18C\uB97C \uC62E\uAE38\uAE4C![VAR 0114(0018)]",
  "[~ 58]",
  "\uC815\uB9D0\uC774\uC9C0 \uAEBE\uC77C \uC904 \uBAA8\uB974\uB294 \uAE30\uC138\uB77C\uB2C8\uAE4C!\\n\uB9C8\uCE58 \uD3ED\uD3EC\uB97C \uC624\uB974\uB294 \uC789\uC5B4\uD0B9 \uAC19\uAD6C\uB098![VAR 0114(0018)]",
  "\uC80A\uC740\uC774\uC5D0\uAC8C\uC11C \uC790\uADF9\uC744 \uC5BB\uC740 \uB355\uBD84\uC5D0\\n\uC774 \uC544\uC800\uC528\uB3C4 \uC131\uC7A5\uD560 \uC218 \uC788\uC5C8\uB2E8\uB2E4![VAR 0114(0018)]",
  "\uC790, \uB108\uCC98\uB7FC \uD654\uB048\uD55C \uC774\uAC78 \uAC00\uC838\uAC00\uAC70\uB77C![VAR 0114(0018)]",
  "\uADF8\uB7FC, \uB2E4\uC74C\uC5D0 \uB610 \uB9CC\uB098\uAE30\uB97C\\n\uAE30\uB300\uD558\uACE0 \uC788\uC73C\uB9C8![VAR 0114(0018)]",
  "[~ 58]",
  "\uC6B0\uC637! \uC6B0\uC624\uC624\uC637!?\\n\uC774\uAC70 \uB0B4\uAC00 \uB09A\uC5EC \uBC84\uB838\uAD6C\uB098![VAR 0114(0018)]",
  "\uC0AC\uB098\uC774 \uACE4\uD3EC!\\n\uB2E4\uC74C \uC2B9\uBD80\uB3C4 \uAE30\uB300\uD558\uACE0 \uC788\uC73C\uB9C8![VAR 0114(0018)]",
  "\uCC9C\uBCC0\uB9CC\uD654\uD558\uB294 \uACA9\uB958\uC758 \uC694\uB9AC\uC0AC \uACE4\uD3EC\uB97C\\n\uC804\uBD80 \uD5E4\uC544\uB9AC\uAE34 \uC5B4\uB824\uC6E0\uB098 \uBCF4\uAD6C\uB098!\\r\\n\uC640\uD558\uD558\uD558![VAR 0114(0018)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uB294 \uC0C9\uC774 \uB9C8\uC74C\uC5D0 \uB4E4\uB354\uAD6C\uB098!\\n\uB9C8\uCE58 \uCE74\uB77C\uD504\uC2DC\uD2F0\uCC98\uB7FC\\r\\n\uC120\uBA85\uD55C \uD30C\uB780\uC0C9\uC774\uB77C\uC11C \uB9D0\uC774\uB2E4![VAR 0114(0018)]",
  "\uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC5D0\\n\uAFCB\uAFCB\uD558\uAC8C \uD53C\uC5B4\uB09C \uAF43\uB4E4!\\r\\n\uC5B4\uCA5C \uC774\uB9AC\uB3C4 \uC544\uB984\uB2F5\uAE30 \uADF8\uC9C0\uC5C6\uB2E8 \uB9D0\uC778\uAC00...![VAR 0114(0018)]",
  "\uAC00\uAE4C\uC774\uC5D0\uC11C \uD559\uC0DD\uB4E4\uC744 \uBCF4\uB2C8\\n\uC5EC\uB7EC\uBAA8\uB85C \uBC30\uC6B8 \uC810\uC774 \uB9CE\uB354\uAD6C\uB098!\\c\\n\uBA4B\uC9C4 \uD3EC\uC988\uB3C4 \uC0C8\uB85C \uBC30\uC6E0\uACE0 \uB9D0\uC774\uB2E4!\\n\uC774\uAC70 \uC6D4\uCC99\uC774\uAD70! \uC6D4\uCC99\uC774\uC57C![VAR 0114(0018)]",
  "\uB124\uAC00 \uAD50\uD658\uD574 \uC900 [VAR 0101(0001)][VAR 1900(0001)]\\n\uC544\uC8FC \uD314\uD314\uD558\uB354\uAD6C\uB098!\\r\\n\uC55E\uC73C\uB85C\uAC00 \uAE30\uB300\uB418\uB294 \uD3EC\uCF13\uBAAC\uC774\uB780 \uB9D0\uC774\uC9C0![VAR 0114(0018)]",
  "\uB0B4\uAC00 \uAD50\uD658\uD574 \uC900 \uAC00\uBE44\uB8E8\uC0AC\uB294\\n\uC544\uC8FC \uC608\uB9AC\uD558\uB2E8\uB2E4!\\c\\n\uAC00\uB054 \uC2A4\uC2A4\uB85C \uC0B4\uC744 \uBC84\uB9B4 \uB54C\uAC00 \uC788\uC73C\uB2C8\\n\uB108\uBB34 \uB180\uB77C\uC9C0 \uB9D0\uAC70\uB77C![VAR 0114(0018)]",
  "\uC640\uD558\uD558!\\n\uD14C\uC0AC \uC544\uAC00\uC528\uD55C\uD14C\uC11C \uB4E4\uC5C8\uB2E4!\\c\\n\uAC00\uC7A5 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC73C\uB85C\\n\uC774 \uC0AC\uB098\uC774 \uACE4\uD3EC\uB97C \uAF3D\uC558\uB2E4\uC9C0!?\\c\\n\uC544\uC800\uC528\uAC00 \uB108\uBB34 \uAE30\uBED0\uC11C\\n\uC758\uC695\uC774 \uCF78\uCF78 \uC0D8\uC19F\uC9C0 \uBB50\uB0D0!\\c\\n\uB098\uB3C4 \uB108\uB97C \uC18C\uC911\uD558\uAC8C \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E8\uB2E4![VAR 0114(0018)]"
]
