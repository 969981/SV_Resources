[
  "\uD558~\uC774, \uC54C\uB85C\uB77C!\\n\uB098\uB294 \uC54C\uB85C\uB77C\uC758 \uD3EC\uCF13\uBAAC\uC744 \uC88B\uC544\uD574!",
  "\uC54C\uB85C\uB77C\uC758 \uBAA8\uC2B5\uC778\\n\uB531\uAD6C\uB9AC\uB97C \uD55C\uBC88 \uBD24\uC73C\uBA74 \uC88B\uACA0\uB294\uB370\\r\\n\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774\uB098 \uBC15\uC2A4\uC5D0 \uC5C6\uB2C8?",
  "\uC774\uC0C1\uD558\uAC8C\uB3C4 \uB531\uAD6C\uB9AC\uB9CC\\n\uBABB \uCC3E\uACA0\uB2E8 \uB9D0\uC774\uC9C0...",
  "\uADF8 \uD3EC\uCF13\uBAAC\uC740...\\n\uADF8\uB0E5 \uB531\uAD6C\uB9AC\uB3C4 \uC544\uB2C8\uC796\uC544!",
  "\uADF8 \uD3EC\uCF13\uBAAC\uC740...\\n\uADF8\uB0E5 \uB531\uAD6C\uB9AC\uC796\uC544!!\\r\\n\uB0B4\uAC00 \uBCF4\uACE0 \uC2F6\uC740 \uAC74 \uC54C\uB85C\uB77C\uC758 \uBAA8\uC2B5\uC774\uC57C!!",
  "\uADF8 \uD3EC\uCF13\uBAAC\uC740...\\n\uC54C\uB85C\uB77C\uC758 \uBAA8\uC2B5\uC778 \uB531\uAD6C\uB9AC!!",
  "\uC774\uAD6D\uC801\uC778 \uB290\uB08C\uC758 \uD280\uC5B4\uB098\uC628 \uBA38\uB9AC!\\n\uB208\uC379\uB3C4 \uC218\uC5FC\uB3C4 \uC815\uB9D0 \uB2A0\uB984\uD574 \uBCF4\uC5EC~!",
  "...\uD1B5\uC2E0\uAD50\uD658\uC73C\uB85C \uC9C4\uD654\uD558\uB2C8\uAE4C\\n\uC57C\uC0DD\uC5D0\uC11C\uB294 \uC798 \uC548 \uBCF4\uC774\uB098 \uBD10.",
  "\uAC10\uC0AC\uC758 \uB73B\uC73C\uB85C \uC54C\uB85C\uB77C\uC640\\n\uB531\uAD6C\uB9AC\uC5D0 \uC5B4\uC6B8\uB9AC\uB294 \uAC10\uC815 \uD45C\uD604\uC744 \uAC00\uB974\uCCD0 \uC904\uAC8C!",
  "[VAR 0100(0000)][VAR 1900(0001)] \uC5EC\uC790\uC544\uC774\uB85C\uBD80\uD130\\n[VAR FF00(0008)]\uC804\uAE30Z \uAC10\uC815 \uD45C\uD604[VAR FF00(0000)]\uC744 \uBC30\uC6E0\uB2E4!",
  "\uC804\uAE30Z \uD3EC\uC988\uB294 \uC190\uC758 \uAC01\uB3C4\uAC00 \uD3EC\uC778\uD2B8\uC57C!\\n\uADF8\uB9AC\uACE0 \uD070 \uC18C\uB9AC\uB85C \u201C\uC54C\uB85C\uB77C!\u201D\uB77C\uACE0 \uC678\uCCD0 \uBD10!"
]
