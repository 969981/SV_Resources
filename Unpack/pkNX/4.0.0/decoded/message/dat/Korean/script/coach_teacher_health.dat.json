  "\uADF8\uB798\uB3C4 \uBB50, \uB124 \uB355\uBD84\uC5D0 \uBAA8\uCC98\uB7FC \uC5BB\uC740 \uAE30\uD68C\uB2C8\uAE4C\\n\uC5F4\uC2EC\uD788 \uD574 \uBD10\uC57C\uACA0\uC9C0![VAR 0114(0028)]",
  "\uC88B\uC544! \uCD9C\uC7A5 \uD2B9\uC9D1 \uBBF8\uBAA8\uC0AC\uC758 \uBCF4\uAC74\uC2E4\uC744\\n\uC81C\uB300\uB85C \uBCF4\uC5EC \uC8FC\uACA0\uC5B4![VAR 0114(0028)]",
  "\uC544~! [VAR 0100(0000)]!\\n\uB0B4 \uC774\uC57C\uAE30 \uC880 \uB4E4\uC5B4 \uBD10~![VAR 0114(0028)]",
  "\uB098, \uCCAB \uC218\uC5C5\uBD80\uD130 \uC81C\uB300\uB85C \uC0AC\uACE0 \uCCE4\uC5B4...[VAR 0114(0028)]",
  "\uADF8\uAC8C, \uC218\uC5C5 \uC790\uCCB4\uB294 \uC81C\uB300\uB85C \uD588\uAC70\uB4E0?[VAR 0114(0028)]",
  "\uADFC\uB370 \uAD50\uC2E4\uC744 \uD5F7\uAC08\uB824\uC11C\\n\uC5C9\uB6B1\uD55C \uBC18\uC5D0\uC11C \uD574 \uBC84\uB838\uC9C0 \uBB50\uC57C!![VAR 0114(0028)]",
  "\uADF8\uAC70 \uD070\uC77C\uC774\uB124\uC694",
  "\uADF8\uB7F4 \uB54C\uB3C4 \uC788\uC8E0 \uBB50!",
  "\uB355\uBD84\uC5D0 \uC790\uC2B5 \uC911\uC778 \uAD50\uC2E4\uC5D0 \uAC11\uC790\uAE30 \uB4E4\uC5B4\uC640\uC11C\\n\uBCF4\uAC74 \uC218\uC5C5\uC744 \uC2DC\uC791\uD558\uB294\\r\\n\uC218\uC0C1\uD55C \uC0AC\uB78C\uC774 \uB418\uC5B4 \uBC84\uB838\uC5B4...[VAR 0114(0028)]",
  "\uC544\uB2C8... \uBCF4\uD1B5 \uC5C6\uC9C0 \uC54A\uC544?\\n\uC704\uB85C\uD574 \uC8FC\uB824\uB294 \uB9C8\uC74C\uC740 \uAE30\uC058\uC9C0\uB9CC\\r\\n\uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C\uB3C4 \uC720\uB840\uC5C6\uB294 \uC77C\uC774\uC796\uC544...[VAR 0114(0028)]",
  "\uC544~ \uC774 \uC774\uC57C\uAE30\uB294 \uADF8\uB9CC\uD560\uB798!\\n\uC0DD\uAC01\uB9CC \uD574\uB3C4 \uBD80\uB044\uB7EC\uC6CC \uC8FD\uACA0\uC5B4![VAR 0114(0028)]",
  "\uC548 \uC88B\uC740 \uC77C\uC740 \uBE68\uB9AC \uD138\uC5B4 \uBC84\uB9AC\uACE0\\n\uB2E4\uC74C\uC744 \uC900\uBE44\uD574\uC57C\uACA0\uC5B4![VAR 0114(0028)]",
  "[VAR 0100(0000)]!\\n\uB0B4 \uC774\uC57C\uAE30 \uC880 \uB4E4\uC5B4 \uBD10~![VAR 0114(0028)]",
  "\uB0B4\uAC00 \uC804\uC5D0 \uC5C9\uB6B1\uD55C \uAD50\uC2E4\uC5D0\uC11C\\n\uC218\uC5C5\uC744 \uD588\uB2E4\uACE0 \uD588\uC796\uC544.[VAR 0114(0028)]",
  "\uADF8 \uBC18 \uC544\uC774\uB4E4 \uC5EC\uB7FF\uC774\\n\uB098\uD55C\uD14C \uC9C8\uBB38\uC744 \uD558\uB7EC \uCC3E\uC544\uC628 \uAC70 \uC788\uC9C0![VAR 0114(0028)]",
  "\uB098\uC5D0\uAC8C \uC788\uC5B4\uC11C \uAD50\uC2E4\uC744 \uD5F7\uAC08\uB9B0 \uC0AC\uAC74\uC740\\n\uC78A\uC5B4\uBC84\uB9AC\uACE0 \uC2F6\uC740 \uD751\uC5ED\uC0AC\uC600\uB294\uB370...[VAR 0114(0028)]",
  "\uADF8 \uC560\uB4E4\uC5D0\uAC8C\uB294\\n\uD5C8\uD2BC \uC77C\uC774 \uC544\uB2C8\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB2C8\uAE4C[VAR 0114(0028)]",
  "\uBB50\uB784\uAE4C...\\n\uB300\uBC15 \uAE30\uBEE4\uC5B4![VAR 0114(0028)]",
  "\uC798\uB410\uB124\uC694!",
  "\uB300\uBC15\uC774\uB124\uC694!",
  "\uC815\uB9D0 \uADF8\uB807\uB2E4\uB2C8\uAE4C![VAR 0114(0028)]",
  "\uAD50\uC0AC \uC77C\uC740 \uC5ED\uC2DC \uC990\uAC70\uC6B4 \uAC83 \uAC19\uC544!\\n\uBB3C\uB860, \uD798\uB4E4 \uB54C\uB3C4 \uC788\uC9C0\uB9CC.[VAR 0114(0028)]",
  "\uAFC8\uC744 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uC544\uC11C \uC815\uB9D0 \uB2E4\uD589\uC774\uC57C.\\n[VAR 0100(0000)]... \uACE0\uB9C8\uC6CC![VAR 0114(0028)]",
  "\uB9DE\uB2E4! \uC544\uC9C1 \uC2DC\uAC04 \uAD1C\uCC2E\uC544?[VAR 0114(0028)]",
  "\uB108\uD55C\uD14C \uB9E4\uBC88 \uB3C4\uC6C0\uB9CC \uBC1B\uC544\uC11C\\n\uBB54\uAC00 \uBCF4\uB2F5\uC774 \uD558\uACE0 \uC2F6\uC740\uB370...[VAR 0114(0028)]",
  "\uD3EC\uCF13\uBAAC \uAD50\uD658\uC73C\uB85C\\n\uC880 \uB354 \uAC00\uAE4C\uC6CC\uC838 \uBCF4\uB294 \uAC74 \uC5B4\uB54C?[VAR 0114(0028)]",
  "\uC624\uCF00\uC774~\\n\uB098\uB294 \uC2DC\uB9C8\uC0AC\uB9AC\uB97C \uC904 \uAC74\uB370\\r\\n[VAR 0100(0000)][VAR 1900(0001)] \uC5B4\uB5BB\uAC8C \uD560\uB798?[VAR 0114(0028)]",
  "[VAR 0101(0001)][VAR 1900(0006)]\uB77C\uB2C8 \uC81C\uBC95\uC778\uB370!\\n\uC644\uC804 \uB108\uB791 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4!\\c\\n\uAC74\uAC15\uD558\uAC8C \uC465\uC465 \uC790\uB784 \uC218 \uC788\uB3C4\uB85D\\n\uB0B4\uAC00 \uC798 \uBCF4\uC0B4\uD544\uAC8C![VAR 0114(0028)]",
  "\uB108\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uB0B4 \uC2DC\uB9C8\uC0AC\uB9AC\uB97C \uAD50\uD658\uD558\uB294 \uAC70\uC9C0?[VAR 0114(0028)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBFD0\uC774\uBA74\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uB2E4\uAD6C!\\r\\n2\uB9C8\uB9AC \uC774\uC0C1\uC740 \uB370\uB824\uC624\uB3C4\uB85D \uD574~[VAR 0114(0028)]",
  "\uD5D0~ \uC9C4\uC2EC\uC774\uC57C? \uB0B4 \uC81C\uC548\uC744 \uCC28 \uBC84\uB9AC\uB2E4\uB2C8\\n\uB098\uC911\uC5D0 \uD6C4\uD68C\uD558\uAC8C \uB420\uAC78~?[VAR 0114(0028)]",
  "\uB098\uB791 \uD3EC\uCF13\uBAAC \uAD50\uD658\uC73C\uB85C\\n\uAC00\uAE4C\uC6CC\uC9C0\uACE0 \uC2F6\uC5B4\uC9C4 \uAC70\uC57C?[VAR 0114(0028)]",
  "\uBB34\uC2A8 \uC77C\uC774\uC57C, [VAR 0100(0000)]?\\n\uD639\uC2DC \uB098\uB791 \uC2B9\uBD80\uD558\uACE0 \uC2F6\uC740 \uAC70\uC57C?[VAR 0114(0028)]",
  "\uC544\uB2C8\uB77C\uACE0?\\n\uBB50, \uB098\uC57C \uC0C1\uAD00\uC5C6\uC9C0\uB9CC.[VAR 0114(0028)]",
  "\uC88B\uC544~ \uB9C8\uCE68 \uD55C\uAC00\uD558\uB2C8\uAE4C\\n\uC5B4\uC6B8\uB824 \uC904\uAC8C.[VAR 0114(0028)]",
  "[~ 61]",
  "\uC544\uC774\uB4E4\uC740 \uC5B8\uC81C\uB098 \uC804\uB825\uC774\uB77C\\n\uBABB \uB2F9\uD558\uACA0\uB2E4\uB2C8\uAE4C~[VAR 0114(0028)]",
  "\uD2B9\uD788 \uB108\uB294 \uC9C0\uB098\uCE58\uAC8C \uAC15\uD558\uB2C8\uAE4C\\n\uC880 \uBD10\uC8FC\uB294 \uBC95\uC744 \uBC30\uC6B0\uB77C\uAD6C![VAR 0114(0028)]",
  "\uB098\uB97C \uC774\uACBC\uC73C\uB2C8\uAE4C\\n\uBA4B\uC9C4 \uD3EC\uC988\uB97C \uAC00\uB974\uCCD0 \uC904\uAC8C.[VAR 0114(0028)]",
  "\uC544\uC9C1 \uC544\uC2AC\uC544\uC2AC\uD558\uAC8C\\n\uCD0C\uC2A4\uB7EC\uC6CC\uC9C0\uAE30 \uC804\uC778 \uAC78\uB85C \uC544\uB294\uB370...\\r\\n\uD310\uB2E8\uC740 \uB124\uAC00 \uC54C\uC544\uC11C \uD574~[VAR 0114(0028)]",
  "[VAR 0100(0000)][VAR 1900(0001)] \uBBF8\uBAA8\uC0AC \uC120\uC0DD\uB2D8\uC73C\uB85C\uBD80\uD130\\n[VAR FF00(0008)]\uC774\uB9C8 V \uC0AC\uC778 \uAC10\uC815 \uD45C\uD604[VAR FF00(0000)]\uC744 \uBC30\uC6E0\uB2E4!",
  "\uC790, \uC751\uAE09 \uCC98\uCE58\uB294 \uB2E4 \uD588\uACE0...\\n\uC774\uAC83\uB3C4 \uAC00\uC838\uAC00\uB3C4\uB85D \uD574.[VAR 0114(0028)]",
  "\uBB34\uB9AC\uD558\uB2E4 \uB2E4\uCE58\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574~[VAR 0114(0028)]",
  "\uC5B4\uB77C?\\n\uC774\uC81C \uC880 \uBD10\uC8FC\uB294 \uBC95\uC744 \uBC30\uC6B4 \uAC70\uC57C?\\c\\n\uB108\uB3C4 \uC870\uAE08\uC740 \uC5B4\uB978\uC2A4\uB7EC\uC6CC\uC84C\uAD6C\uB098~[VAR 0114(0028)]",
  "\uB3D4\uC5D0 \uC788\uB294 \uD68C\uBCF5 \uBA38\uC2E0\uC740 \uC368 \uBCF8 \uC801 \uC788\uC5B4?\\c\\n\uC5EC\uAE30\uC11C\uB294 \uC9C1\uC811 \uC870\uC791\uD574\uC11C \uD68C\uBCF5\uD560 \uC218 \uC788\uAD6C\uB098~\\n\uBB54\uAC00 \uC61B\uB0A0 \uC0DD\uAC01\uC774 \uB098\uB124~[VAR 0114(0028)]",
  "\uC774 \uC544\uCE74\uB370\uBBF8 \uB9D0\uC774\uC57C,\\n\uBCF4\uAC74\uC2E4\uC774 \uC5C6\uC9C0 \uC54A\uC544?\\c\\n\uADF8\uB7FC, \uB561\uB561\uC774\uCE58\uACE0 \uC2F6\uC744 \uB54C\\n\uB2E4\uB4E4 \uC5B4\uB514\uC5D0 \uAC00\uB294 \uAC78\uAE4C?[VAR 0114(0028)]",
  "\uC218\uC5C5\uC744 \uC900\uBE44\uD558\uB294 \uAC70 \uB9D0\uC774\uC57C,\\n\uAF64\uB098 \uD798\uB4E4\uB354\uB77C...\\c\\n\uD3C9\uBC94\uD558\uAC8C \uD574\uB0B4\uB294 \uC6B0\uB9AC \uC544\uCE74\uB370\uBBF8 \uC120\uC0DD\uB2D8\uB4E4\uC774\\n\uC874\uACBD\uC2A4\uB7EC\uC6B8 \uC815\uB3C4\uC57C~[VAR 0114(0028)]",
  "\uB124\uAC00 \uC900 [VAR 0101(0001)][VAR 1900(0001)]\\n\uB108\uBB34 \uAE30\uC6B4\uC774 \uB118\uCCD0\uC11C \uACE4\uB780\uD560 \uC815\uB3C4\uC57C!\\r\\n\uB204\uAD6C\uB97C \uC544\uC8FC \uC3D9 \uBE7C\uB2EE\uC558\uB2E4\uB2C8\uAE4C~[VAR 0114(0028)]",
  "\uB0B4\uAC00 \uAD50\uD658\uD574 \uC900 \uC2DC\uB9C8\uC0AC\uB9AC, \uAD49\uC7A5\uD558\uC9C0?\\n\uD76C\uADC0\uD55C \uD2B9\uC131\uB3C4 \uAC00\uC9C0\uACE0 \uC788\uC5B4.\\c\\n\uC5F4\uC2EC\uD788 \uD0A4\uC6CC\uC11C\\n\uBB34\uB300 \uC704\uC5D0 \uC62C\uB824 \uC918\uC57C \uD574~[VAR 0114(0028)]"
]
