[
  "\uC2E4\uB840\uD569\uB2C8\uB2E4~[VAR 0114(0028)]",
  "\uC5EC\uAE30\uAC00 \uBBF8\uBAA8\uC0AC\uC758 \uC0C8\uB85C\uC6B4 \uBCF4\uAC74\uC2E4?[VAR 0114(0028)]",
