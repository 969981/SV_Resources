[
  "\uBCA0\uC774\uD06C\uB9C8\uC744\uC5D0 \uC5B4\uC11C \uC624\uB834!\\n\uC5EC\uAE30\uB294 \uBCC4\uACFC \uB3C4\uC790\uAE30\uC758 \uB9C8\uC744\uC774\uB780\uB2E4!",
  "\uC6B0\uB9AC \uAC00\uC871\uC740 \uB300\uB300\uB85C\\n\uB3C4\uC790\uAE30 \uC7A5\uC778\uC774\uC57C!",
  "\uBB3C\uC774 \uC878\uC878...\\c\\n\uD558\uC774\uB4DC\uB85C\uD38C\uD504\uCC98\uB7FC\\n\uB098\uC624\uBA74 \uC7AC\uBBF8\uC788\uC744 \uD150\uB370!",
  "\uC774 \uC811\uC2DC \uC9C4\uC9DC \uD06C\uB2E4~!\\n\uC0CC\uB4DC\uC704\uCE58\uB97C \uBA87 \uC778\uBD84\uC774\uB098 \uC62C\uB9B4 \uC218 \uC788\uC744\uAE4C?",
  "\uBCA0\uC774\uD06C\uB9C8\uC744\uC758 \uC2DD\uAE30\uB294\\n\uD314\uB370\uC544\uC5D0\uC11C\uB3C4 \uC778\uAE30 \uB9CC\uC810\uC778 \uACF5\uC608\uD488\uC774\uC57C.",
  "\uB3C4\uC790\uAE30\uB294 \uD654\uB355\uC5D0\uC11C \uD0DC\uC5B4\uB098\uC9C0!\\c\\n\uC131\uD615\uD55C \uC810\uD1A0\uB97C \uB123\uACE0\\n\uC218\uC77C\uC5D0 \uAC78\uCCD0 \uCC9C\uCC9C\uD788 \uAD6C\uC6CC\uC11C \uB9CC\uB4E0\uB2E8\uB2E4.",
  "\uC774 \uB9C8\uC744\uC758 \uBC30\uD2C0\uCF54\uD2B8\uB294\\n\uC61B\uB0A0\uC5D0 \uCC9C\uBB38\uB300\uB85C \uB9CC\uB4E4\uC5B4\uC9C4 \uAC70\uC57C.",
  "\uC774 \uC55E\uC5D0 \uC788\uB294 \uC5B8\uB355\uAE38\uC744 \uC62C\uB77C\uAC14\uB354\uB2C8\\n\uCC3B\uC794\uCC98\uB7FC \uC0DD\uAE34 \uD3EC\uCF13\uBAAC\uC774 \uC788\uB354\uAD6C\uB098.",
  "\uBCA0\uC774\uD06C\uB9C8\uC744\uAE4C\uC9C0 \uC624\uB290\uB77C\\n\uD798\uB4E4\uC9C0 \uC54A\uC558\uB2C8?\\c\\n\uD55C\uBC88 \uB3C4\uCC29\uD588\uC73C\uBA74 \uB2E4\uC74C\uBD80\uD130\uB294\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB85C \uC62C \uC218 \uC788\uC5B4.",
  "\uBCA0\uC774\uD06C\uB9C8\uC744\uC740 \uBD88\uD3B8\uD55C \uACF3\uC5D0 \uC704\uCE58\uD574\uC11C\\n\uBAA8\uD1A0\uB9C8\uAC00 \uC5C6\uC73C\uBA74 \uC548 \uB3FC!",
  "\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB9AC\uD30C\uB97C \uBCF4\uB7EC \uC654\uB294\uB370\\n\uC811\uC2DC\uB3C4 \uC608\uC05C \uAC83 \uAC19\uC544~!",
  "\uCC9C\uBB38\uB300\uC5D0 \uADF8\uB824\uC9C4\\n\uC2EC\uD50C\uD55C \uD3EC\uCF13\uBAAC \uADF8\uB9BC, \uADC0\uC5FD\uC9C0 \uC54A\uC544?\\r\\n\uC800\uB7F0 \uAC78 \uB3C4\uD2B8 \uADF8\uB9BC\uC774\uB77C\uACE0 \uD558\uB358\uAC00?"
]
