  "[~ 61]",
  "...\uC5B4\uC9F8\uC11C \uC5EC\uAE30\uAE4C\uC9C0?[VAR 0114(0023)]",
  "\uB3D9\uC9C0\uB97C \uAD6C\uD558\uACE0 \uC2F6\uC5B4\uC11C\uC694!",
  "\uC774\uB300\uB85C \uACC4\uC18D\uD574\uC11C \uB4F1\uAD50\uB97C \uAC70\uBD80\uD558\uBA74\\n\uCD94\uBA85 \uB098\uB9AC\uB294 \uD1F4\uD559\uC778 \uAC70\uC8E0...?",
  "......[VAR 0114(0023)]",
  "\uAD34\uB86D\uD798\uC744 \uB2F9\uD558\uB358 \uC6B0\uB9AC\uAC00\\n\uC9C0\uAE08 \uD559\uAD50\uC5D0 \uB2E4\uB2D0 \uC218 \uC788\uB294 \uAC74...",
  "\uC2A4\uD0C0\uB2E8 \uC5EC\uB7EC\uBD84\uC774\\n\uB300\uC791\uC804\uC5D0\uC11C \uD65C\uC57D\uD574 \uC8FC\uC2E0 \uB355\uBD84\uC774\uC796\uC544\uC694!",
  "\uADF8\uB7F0 \uC0AC\uB78C\uB4E4\uC774 \uD1F4\uD559\uC744 \uB2F9\uD574\uC57C \uD558\uB2E4\uB2C8\\n\uC800\uB294 \uADF8\uB7F0 \uAC70 \uC2EB\uC5B4\uC694!",
  "...\uBBF8\uC548\uD558\uC624.[VAR 0114(0023)]",
  "\uC544\uC9C1\uAE4C\uC9C0 \uC9C4 \uBCF4\uC2A4\uB77C\uB294 \uC0AC\uB78C\uC774\uB791\\n\uC5F0\uB77D\uC774 \uC548 \uB418\uB294 \uAC70\uC608\uC694...?",
  "\uADF8\uB807\uC18C, \uADF8\uB0A0 \uC774\uD6C4 \uACC4\uC18D...[VAR 0114(0023)]",
  "\uC9C4 \uBCF4\uC2A4 \uB098\uB9AC\uAC00 \uC5C6\uC73C\uBA74\\n\uB2E8 \uC5ED\uC2DC \uC5C6\uB294 \uAC83\uC774\uACE0... \uB2E8\uC774 \uC5C6\uC73C\uBA74\\r\\n\uB450\uADFC\uB450\uADFC \uC544\uCE74\uB370\uBBF8 \uB77C\uC774\uD504\uB3C4 \uC5C6\uB294 \uAC83![VAR 0114(0023)]",
  "\uADF8\uB7EC\uB2C8, \uC9C4 \uBCF4\uC2A4 \uB098\uB9AC\uAC00 \uADC0\uD658\uD560 \uB54C\uAE4C\uC9C0\\n\uC6B0\uB9AC\uB294 \uC544\uC9C0\uD2B8\uB97C \uC9C0\uCF1C\uC57C\uB9CC \uD558\uB294 \uAC83\uC774\uC624![VAR 0114(0023)]",
  "\uB108\uD76C\uB4E4\uC774 \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uC2E0\uB8B0\uD558\uB294\\n\uC9C4 \uBCF4\uC2A4\uB294 \uB300\uCCB4 \uB204\uAD6C\uC9C0?[VAR 0114(001E)]",
  "[~ 61]",
  "[~ 61]",
  "\uC6B0\uB9AC\uB294 \uC2E4\uC81C\uB85C \uC9C4 \uBCF4\uC2A4 \uB098\uB9AC\uC640\\n\uB9CC\uB09C \uC801\uC740 \uC5C6\uC18C.[VAR 0114(0023)]",
  "[~ 61]",
  "\uBCF8\uC778\uC758 \uB9D0\uC5D0 \uC758\uD558\uBA74 \uCE69\uAC70 \uC911\uC774\uB77C\uB354\uAD70...\\n\uC6B0\uB9AC\uC640 \uB9C8\uCC2C\uAC00\uC9C0\uB85C \uAD34\uB86D\uD798\uC774 \uC6D0\uC778\uC774\uB77C\uACE0...[VAR 0114(0023)]",
  "\uBD88\uC30D\uD574\uC694...",
  "\uC6D0\uB798 \uC774\uB984\uB3C4, \uC5B4\uB5BB\uAC8C \uC0DD\uACBC\uB294\uC9C0\uB3C4 \uBAA8\uB974\uC9C0\uB9CC\\n\uC6B0\uB9AC\uC758 \uBC97\uC778 \uAC83\uC740 \uBCC0\uD568\uC5C6\uC18C.\\c\\n\uC6B0\uB9AC\uB294 \uADF8\uC800 \uC9C4 \uBCF4\uC2A4 \uB098\uB9AC\uC758 \uADC0\uD658\uC744\\n\uC544\uC9C0\uD2B8\uC5D0\uC11C \uAE30\uB2E4\uB9B4 \uBFD0![VAR 0114(0023)]",
  "\uADF8\uB798\uC11C \uCD94\uBA85 \uB098\uB9AC\uB294\\n\uD559\uAD50\uC5D0 \uAC00\uC9C0 \uC54A\uB294 \uAC70\uAD70\uC694...",
  "...\uD558\uC9C0\uB9CC \uC78A\uC73C\uC2DC\uBA74 \uC548 \uB3FC\uC694!\\n\uCD94\uBA85 \uB098\uB9AC\uC5D0\uAC8C\uB294 \uC2A4\uD0C0\uB2E8 \uB9D0\uACE0\uB3C4\\r\\n\uC800 \uAC19\uC740 \uB3D9\uC9C0\uAC00 \uC788\uB2E4\uB294 \uAC78\uC694!",
  "\uB3D9\uC9C0...[VAR 0114(0023)]",
  "[~ 61]",
  "[~ 61]",
  "...\uACE0\uB9D9\uC18C.[VAR 0114(0023)]",
  "\uAD34\uB86D\uD798... \uB4F1\uAD50 \uAC70\uBD80\uB77C...\\n\uC9C4\uC0C1\uC5D0 \uD55C \uBC1C\uC9DD \uB354 \uB2E4\uAC00\uAC04 \uAC83 \uAC19\uAD70.\\r\\n\uC544\uB2C8, \uADF8\uBCF4\uB2E4\uB3C4...[VAR 0114(001E)]",
  "\uD559\uC0DD\uB4E4\uC774 \uAC00\uC9C0\uACE0 \uC788\uB294 \uBB38\uC81C\uC640...\\n\uD589\uB3D9\uC758 \uC774\uC720...\\r\\n\uADF8\uB9AC\uACE0 \uC18C\uC911\uD55C \uC720\uB300\uB97C...[VAR 0114(001E)]",
