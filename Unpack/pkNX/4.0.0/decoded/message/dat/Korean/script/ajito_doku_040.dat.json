[
  "\uB3D9\uC9C0\uB4E4\uC774\uC5EC, \uBBF8\uC548\uD558\uC624...[VAR 0114(0023)]",
  "1\uB144 \uD558\uACE0 \uC218\uAC1C\uC6D4 \uC804...",
  "\uBBF8\uC548\uD558\uC624...\\n\uC637\uAC10\uC744 \uB2A6\uAC8C \uC785\uC218\uD558\uB294 \uBC14\uB78C\uC5D0...[VAR 0114(0023)]",
  "\uCA50\uB2E4...!\\n\uD2B9\uD788 \uC774 \uBD80\uCE20, \uC644\uC804 \uC8FD\uC5EC\uC8FC\uB294\uB370![VAR 0114(001F)]",
  "\uADF8\uAC74 \uB2C8\uD2B8\uB85C\uCC28\uC9C0\uC5D0\uC11C\\n\uC601\uAC10\uC744 \uC5BB\uC5B4 \uB9CC\uB4E0 \uAC83\uC774\uC624...[VAR 0114(0023)]",
  "\uB0B4 \uAD50\uBCF5\uB3C4 \uC0C1\uC0C1\uD55C \uB300\uB85C\uC57C!\\n\uC815\uB9D0 \uACE0\uB9C8\uC6CC![VAR 0114(0022)]",
  "\uC9C0\uC625\uC758 \uC544\uC774\uB3CC\uC774\uB77C\uB294 \uBE44\uD30C \uB098\uB9AC\uC758\\n\uCF58\uC149\uD2B8\uB97C \uB9CC\uC871\uC2DC\uD0AC \uC218 \uC788\uC5C8\uB2E4\uBA74 \uB2E4\uD589\uC774\uC624.[VAR 0114(0023)]",
  "\uC774\uAC78\uB85C \uAD50\uBCF5 \uAC1C\uC870\uB3C4 \uBAA8\uB450 \uB05D\uB0AC\uAD70.\\n\uC815\uB9D0 \uACE0\uB9C8\uC6CC, \uCD94\uBA85.[VAR 0114(0021)]",
  "\uB450 \uC0AC\uB78C \uB2E4, \uADF8 \uC815\uB3C4\uB85C \uAC15\uD55C \uC778\uC0C1\uC774\uBA74\\n\uC555\uBC15\uAC10\uC774 \uC7A5\uB09C \uC544\uB2D0 \uAC70\uC57C.[VAR 0114(0021)]",
  "\uADF8\uAC74 \uADF8\uB807\uACE0\\n\uC9C4\uC9DC \uB300\uB2E8\uD55C \uC190\uC7AC\uC8FC\uB780 \uB9D0\uC774\uC9C0~[VAR 0114(0020)]",
  "\uC624\uD0C0\uCFE0\uB77C\uB294 \uC774\uC720\uB9CC\uC73C\uB85C\\n\uCD94\uBA85\uC744 \uAD34\uB86D\uD78C \uB140\uC11D\uB4E4\uC740 \uC815\uB9D0 \uBC14\uBCF4\uB77C\uB2C8\uAE4C~[VAR 0114(0020)]",
  "\uC624\uD0C0\uCFE0\uC758 \uAE38\uC740 \uACE0\uB09C\uC73C\uB85C \uAC00\uB4DD\uD55C \uAC00\uC2DC\uBC2D\uAE38!\\n\uBC94\uC778\uC758 \uC774\uD574 \uB530\uC704, \uBC14\uB77C\uC9C0\uB3C4 \uC54A\uC18C![VAR 0114(0023)]",
  "\uC624\uC624~! \uBB50\uC57C, \uCD94\uBA85!\\n\uAE30\uD569\uC774 \uC81C\uBC95 \uB2E8\uB2E8\uD788 \uB4E4\uC5B4\uAC00 \uC788\uB294\uB370![VAR 0114(001F)]",
  "\uB124 \uB9D0\uC774 \uB9DE\uC544, \uCD94\uBA85\uC544.\\n\uBA4B\uC9C4 \uB9C8\uC74C\uAC00\uC9D0\uC774\uC57C~[VAR 0114(0022)]",
  "\uADF8\uB7FC, \uC2A4\uD0C0 \uB300\uC791\uC804\uC744 \uC704\uD574\\n\uB2E4\uC74C\uC73C\uB85C \uD574\uC57C \uD560 \uC77C\uC740 \uBC30\uD2C0 \uC5F0\uC2B5\uC778\uAC00?[VAR 0114(0021)]",
  "\uBCF4\uC2A4\uC778 \uC6B0\uB9AC\uAC00 \uB2E4\uB978 \uBA64\uBC84\uB4E4\uBCF4\uB2E4\\n\uC57D\uD558\uBA74 \uC548 \uB418\uB2C8\uAE4C \uB9D0\uC774\uC57C.[VAR 0114(0021)]",
  "\uC54C\uACA0\uC18C...\\n\uC804\uC2EC\uC804\uB825\uC744 \uB2E4\uD574 \uC218\uB828\uC5D0 \uB9E4\uC9C4\uD558\uACA0\uC18C...![VAR 0114(0023)]",
  "\uC804\uC2EC\uC804\uB825\uC744 \uB2E4\uD574\uB3C4\\n\uAC70\uC2A4\uB97C \uC218 \uC5C6\uB294 \uC6B4\uBA85\uC778 \uAC83\uC778\uAC00...[VAR 0114(0023)]",
  "\uC6B4\uBA85 \uC5ED\uC2DC \uADDC\uCE59...[VAR 0114(0023)]",
  "\uADDC\uCE59\uC5D0 \uB530\uB77C \uC774\uAC83\uC744...\\n\uADF8\uB300\uC5D0\uAC8C \uB9E1\uAE30\uACA0\uC18C.[VAR 0114(0023)]",
  "\uB354\uC2A4\uD2B8\uB97C \uC288\uD2B8\uD558\uB294 \uAE30\uC220\uC774 \uC801\uD78C\\n\uAE30\uACC4 \uC7A5\uCE58\uB3C4 \uBC1B\uC73C\uC2DC\uC624.[VAR 0114(0023)]",
  "\uADF8\uB300\uC758 \uC774\uB984...\\n[VAR 0100(0000)][VAR 1900(0006)]\uB77C\uACE0 \uD588\uB358\uAC00?[VAR 0114(0023)]",
  "\uBBF8\uB828 \uD558\uB098 \uB0A8\uC9C0 \uC54A\uC744 \uC815\uB3C4\uB85C\\n\uBA85\uBC31\uD55C \uC18C\uC778\uC758 \uC644\uD328\uC600\uC18C...[VAR 0114(0023)]",
  "\uCD94\uBA85 \uB098\uB9AC!!",
  "\uB3C4, \uB3D9\uC9C0!?[VAR 0114(0023)]",
  "\uBB34\uC2A8 \uC77C\uC774 \uC788\uC5B4\uB3C4 \uB108\uB97C \uC9C1\uC811 \uB9CC\uB098\uC11C\\n\uD574 \uC8FC\uACE0 \uC2F6\uC740 \uB9D0\uC774 \uC788\uB2E4\uB354\uAD70.[VAR 0114(001E)]",
  "\uCD94\uBA85 \uB098\uB9AC, \uC7A0\uAE50\uC774\uB77C\uB3C4 \uC88B\uC73C\uB2C8\uAE4C\\n\uC81C \uB9D0\uC744 \uB4E4\uC5B4 \uC8FC\uC138\uC694!!",
