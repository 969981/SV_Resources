[
  "\uBAA8\uD1A0\uB9C8\uB97C \uD0C0\uACE0\\n\uC0AC\uB9C9\uC744 \uC774\uB3D9\uD588\uB354\uB2C8 \uC9C0\uCCE4\uC5B4!\\c\\n\uC778\uAC04\uB3C4 \uD3EC\uCF13\uBAAC\uB3C4\\n\uCDA9\uBD84\uD788 \uC26C\uC5B4 \uC918\uC57C \uD574.",
  "\uC5EC\uAE30\uB294 \uB9C8\uB9AC\uB124\uC774\uB4DC\uB9C8\uC744!\\n\uBA85\uBB3C\uC778 \uC2DC\uC7A5\uC740 \uC0AC\uB78C\uB4E4\uB85C \uBD81\uC801\uC778\uB2E8\uB2E4!",
  "\uC790~! \uB2E4\uB4E4 \uC774\uB9AC \uC640\uC11C \uBCF4\uC2DC\uB77C!\\n\uC2E0\uC120\uD55C \uC0C1\uD488\uC774 \uC794\uB729~!",
  "\uB9C8\uB9AC\uB124\uC774\uB4DC\uB77C\uB294 \uAC74 \uACE0\uAE30\uB098 \uC0DD\uC120\uC744\\n\uB808\uBAAC\uC999\uC774\uB098 \uC2DD\uCD08\uC5D0 \uC7AC\uC6CC \uB450\uB294 \uC870\uB9AC\uBC95\uC774\uC57C!",
  "\uC774 \uB9C8\uC744\uC758 \uBA39\uAC70\uB9AC\uB294\\n\uC9C4\uC9DC \uC9C4\uC9DC \uB9DB\uC788\uC5B4!\\c\\n\uC7AC\uB8CC\uAC00 \uC2E0\uC120\uD558\uACE0 \uD798 \uC788\uB2E4\uB2C8\uAE4C!\\n\uB9C8\uCE58 \uB098\uCC98\uB7FC \uB9D0\uC774\uC57C~!",
  "\uC2DC\uC7A5 \uC548\uC5D0\uB294\\n\uBC30\uD2C0\uCF54\uD2B8\uAC00 \uC788\uC5B4!\\c\\n\uC5EC\uAE30\uC11C\uB294 \uAC08\uB4F1\uC774 \uC0DD\uAE30\uBA74\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C \uC815\uD558\uAC8C \uB418\uC5B4 \uC788\uAC70\uB4E0!",
  "\uB0B4\uAC00 \uD0DC\uC5B4\uB098\uAE30 \uC804\uC5D0\uB294\\n\uC2DC\uC7A5\uC5D0 \uC2F8\uC6C0\uC774 \uB04A\uC774\uC9C8 \uC54A\uC558\uB300!\\c\\n\uC9C0\uAE08\uC740 \uAD00\uAD11\uAC1D\uC774 \uB298\uC5B4\uB098\uC11C\\n\uC5B4\uB9B0\uC774\uB3C4 \uC548\uC2EC\uD558\uACE0 \uB2E4\uB2D0 \uC218 \uC788\uC9C0\uB9CC.",
  "\uD559\uC0DD\uB3C4 \uACBD\uB9E4\uC5D0 \uCC38\uAC00\uD558\uB7EC \uC654\uB098?\\c\\n\uAC12\uC744 \uB108\uBB34 \uB192\uAC8C \uBD88\uB7EC\uC11C\\n\uBE48\uD138\uD130\uB9AC\uAC00 \uB418\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uB77C\uACE0!",
  "\uBC24\uC774 \uB418\uBA74 \uB9C8\uC744 \uC704\uC5D0\\n\uACE0\uC2A4\uD2B8\uD3EC\uCF13\uBAAC\uC774 \uCC3E\uC544\uC628\uB2E8\uB2E4.\\r\\n...\uC5B4\uC9F8\uC11C\uC77C\uAE4C?",
  "\uBC14\uB2E4\uC5D0\uC11C \uBD88\uC5B4\uC624\uB294 \uBC14\uB2F7\uBC14\uB78C\uC740\\n\uC815\uB9D0 \uC0C1\uCF8C\uD558\uB2E4\uB2C8\uAE4C~!\\c\\n\uAC15\uCCA0\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC740\\n\uC18C\uAE08\uC808\uC774\uAC00 \uB418\uB2C8\uAE4C \uC2EB\uC5B4\uD558\uB824\uB098?",
  "\uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC\uC774 \uC788\uC73C\uBA74 \uB4E0\uB4E0\uD558\uB2E8\uB2E4!\\c\\n\uAC00\uB054\uC740 \uBC18\uB300\uB85C\\n\uB0B4\uAC00 \uC5C5\uACE0 \uB2E4\uB140 \uBCFC\uAE4C!? \uC73C\uC544\uD558\uD558!",
  "\uB610 \uAD11\uACE0 \uC6B0\uD3B8\uC774 \uC654\uC5B4!\\c\\n\uACF5\uCC98\uB7FC \uBB49\uCCD0 \uAC00\uC9C0\uACE0\\n\uD3EC\uCF13\uBAAC\uC774\uB791 \uB178\uB294 \uB370 \uC4F8\uAE4C...",
  "\uC774 \uB124\uBAA8\uB09C \uAC83\uC740 \uCEE8\uD14C\uC774\uB108\uB77C\uB294 \uAC70\uC57C.\\c\\n\uC548\uC5D0 \uD654\uBB3C\uC744 \uC794\uB729 \uC2E4\uC5B4\uC11C\\n\uBC14\uB2E4 \uAC74\uB108\uB85C \uC6B4\uBC18\uD560 \uB54C \uC4F0\uB294 \uAC70\uC9C0.",
  "\uBA40\uB9AC \uB5A8\uC5B4\uC9C4 \uC9C0\uBC29\uC5D0\uB294 \uBC30\uB85C \uC774\uB3D9\uD55C\uB2E8\uB2E4!\\n\uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC\uC740 \uC9C0\uCCD0\uC11C \uD798\uB4E4\uC5B4\uD558\uAC70\uB4E0.",
  "\uAC74\uB108\uD3B8\uC5D0 \uC788\uB294 \uC554\uC11D \uC9C0\uB300\uAE4C\uC9C0 \uD5E4\uC5C4\uCCE4\uB294\uB370\\n\uC554\uC11D \uC9C0\uB300 \uC704\uC5D0 \uBB54\uAC00 \uC788\uB294 \uAC83 \uAC19\uC558\uC5B4...!\\c\\n\uC190\uC5D0 \uB123\uC73C\uB824\uBA74\\n\uC808\uBCBD\uC744 \uC624\uB97C \uC218 \uC788\uC5B4\uC57C\uACA0\uC9C0\uB9CC...",
  "\uD788\uD788, \uAC04\uD310\uC5D0 \uC5BC\uAD74\uC774 \uB6AB\uB824 \uC788\uC5B4\uC11C\\n\uC7AC\uBBF8\uC788\uB294 \uC0AC\uC9C4\uC744 \uCC0D\uC744 \uC218 \uC788\uC5B4!",
  "\uC788\uC796\uC544, \uB9E8\uB3CC\uD540\uC740 \uC54C\uACA0\uB294\uB370\\n\uADFC\uC721\uC9C8\uC778 \uAC74 \uBB50\uC57C...?\\r\\n\uC800\uB7F0 \uD3EC\uCF13\uBAAC\uC774 \uC788\uC5C8\uB098...?",
  "\uBC14\uB2E4 \uC704\uB97C \uB098\uB294 \uCC0C\uB9AC\uBE44\uD06C, \uBA4B\uC9C0\uB2E4~\\c\\n\uC800 \uC560\uB4E4, \uAC00\uB054 \uB9C8\uC744 \uB4A4\uD3B8\uC5D0 \uC788\uB294\\n\uD574\uBCC0\uC5D0\uC11C \uC26C\uACE0 \uC788\uC744 \uB54C\uAC00 \uC788\uC5B4.",
  "\uCE74\uB77C\uD504\uC2DC\uD2F0\uC5D0 \uC788\uB294 \uACE4\uD3EC\uAC01\uC5D0\\n\uBA39\uC73C\uB7EC \uAC00 \uBCF8 \uC801 \uC788\uC5B4?\\c\\n\uB9C8\uB9AC\uB124\uC774\uB4DC\uB9C8\uC744\uC5D0\uC11C \uB098\uC628\\n\uC2E0\uC120\uD55C \uC2DD\uC7AC\uB8CC\uB97C \uC0AC\uC6A9\uD558\uACE0 \uC788\uB300!",
  "\uAC00\uB054 \uCE74\uB77C\uD504\uCCB4\uC721\uAD00\uC758\\n\uACE4\uD3EC \uB2D8\uC774 \uC2DC\uC7A5\uC5D0 \uC624\uC2E4 \uB54C\uAC00 \uC788\uC5B4!\\c\\n\uACE4\uD3EC \uB2D8, \uACBD\uB9E4\uC5D0\uC11C \uC774\uAE30\uBA74\\n\uAE30\uBED0\uC11C \uCDA4\uC744 \uCD94\uC2E0\uB2E4\uB2C8\uAE4C!",
  "\uC774 \uB299\uC740\uC774\uB3C4 \uC655\uB144\uC5D0\uB294\\n\uACBD\uB9E4\uB2C8 \uC2F8\uC6C0\uC774\uB2C8\\r\\n\uC774\uB7F0\uC800\uB7F0 \uB9D0\uC37D\uC744 \uBD80\uB9AC\uACE0 \uB2E4\uB154\uB2E8\uB2E4.",
  "\uBA4B\uC9C4 \uD574\uBCC0\uC778\uB370\uB3C4 \uC798 \uC54C\uB824\uC9C0\uC9C0 \uC54A\uC558\uC5B4!\\n\uB2E4\uB4E4 \uC2DC\uC7A5\uC5D0 \uD479 \uBE60\uC84C\uB098 \uBD10~"
]
