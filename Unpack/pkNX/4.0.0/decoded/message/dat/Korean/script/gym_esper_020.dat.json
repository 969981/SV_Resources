[
  "\uBCA0\uC774\uD06C\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uC5D0 \uAD00\uD55C \uC124\uBA85\uC744\\r\\n\uB2E4\uC2DC \uD55C\uBC88 \uB4E4\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uBCA0\uC774\uD06C\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB294\\n[VAR FF00(0006)]\uC5D1\uC11C\uC0AC\uC774\uC988[VAR FF00(0000)]!",
  "\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB9AC\uD30C \uB2D8\uAED8\uC11C \uACE0\uC548\uD558\uC2E0\\n[VAR FF00(0006)]\uD76C\uB85C\uACBD\uB77D \uC5D1\uC11C\uC0AC\uC774\uC988[VAR FF00(0000)]\uB97C\\r\\n\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uD574\uB0B4\uC2DC\uBA74 \uD569\uACA9\uC785\uB2C8\uB2E4!",
  "\uC790\uC138\uD55C \uB8F0\uC740 \uCCB4\uC721\uAD00\uC744 \uB098\uAC00\uC11C\\n\uC67C\uCABD\uC5D0 \uC788\uB294 \uC5D1\uC11C\uC0AC\uC774\uC988 \uD68C\uC7A5\uC758\\r\\n\uAC80\uC740 \uC6B4\uB3D9\uBCF5\uC744 \uC785\uC740 \uC5EC\uC131\uBD84\uC5D0\uAC8C \uB4E4\uC5B4 \uC8FC\uC138\uC694.",
  "\uC548\uB155! \uC804\uD559\uC0DD!!\\n\uD76C\uB85C\uACBD\uB77D \uC5D1\uC11C\uC0AC\uC774\uC988 \uD68C\uC7A5\uC5D0 \uC798 \uC654\uC5B4![VAR 0114(0024)]",
  "\uBB50? \uC5B4\uC9F8\uC11C \uBC30\uD2C0\uD559 \uB2F4\uB2F9 \uC6B4\uD5A5 \uC120\uC0DD\uB2D8\uC774\\n\uCCB4\uC721\uAD00 \uC778\uC2A4\uD2B8\uB7ED\uD130\uB97C \uD558\uACE0 \uC788\uB0D0\uACE0?[VAR 0114(0024)]",
  "...\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB9AC\uD30C\uC640 \uB098\uB294\\n\uC5B4\uB9B4 \uC801\uBD80\uD130 \uC544\uB294 \uC0AC\uC774\uAC70\uB4E0.[VAR 0114(0024)]",
  "\uC9C4 \uCABD\uC774 \uC774\uAE34 \uCABD\uC758 \uB9D0\uC744\\n\uB4E4\uC5B4\uC8FC\uAE30\uB85C \uD558\uACE0 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD588\uB294\uB370\\r\\n\uAC70\uAE30\uC11C \uC18C\uACE4\uC18C\uACE4...[VAR 0114(0024)]",
  "...\uC544\uBB34\uD2BC! \uBAB8\uB9CC\uB4E4\uAE30\uC5D0\uB3C4 \uB3C4\uC6C0\uC774 \uB418\uB2C8\uAE4C\\n\uC218\uC5C5\uC774 \uC5C6\uC744 \uB54C \uC640\uC11C \uB3C4\uC640\uC8FC\uACE0 \uC788\uC5B4.[VAR 0114(0024)]",
  "\uC5D1\uC11C\uC0AC\uC774\uC988\uC758 \uB8F0\uC740 \uAC04\uB2E8\uD574!\\n\uB0B4\uAC00 \uC2DC\uBC94\uC744 \uBCF4\uC5EC \uC8FC\uBA74\\r\\n\uAC19\uC740 \uB3D9\uC791\uC744 \uB530\uB77C \uD558\uBA74 \uB3FC![VAR 0114(0024)]",
  "\uADF8\uB7FC, \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C \uC2DC\uC791\uD558\uC790.\\n\uBAB8\uACFC \uB9C8\uC74C \uBAA8\uB450 \uC900\uBE44 \uB410\uB2C8!?[VAR 0114(0024)]",
  "\uADF8\uB7FC~ \uB808\uCE20 \uC5D1\uC11C\uC0AC\uC774\uC988!\\n\uAC10\uC815\uC744 \uD3ED\uBC1C\uC2DC\uCF1C \uC918!![VAR 0114(0024)]",
  "\uADF8\uB798! \uC900\uBE44\uB294 \uCCA0\uC800\uD788 \uD574\uC57C\uC9C0!\\n\uC900\uBE44\uB418\uB294 \uB300\uB85C \uB0B4\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC918.[VAR 0114(0024)]",
  "\uC88B\uC544! \uC88B\uC740 \uC6C0\uC9C1\uC784\uC774\uC57C!\\n\uC804\uD559\uC0DD\uB3C4 \uD3EC\uCF13\uBAAC\uB3C4 \uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uB294\uB370![VAR 0114(0024)]",
  "\uCD5C\uACE0\uC57C! \uD6CC\uB96D\uD574!\\n\uC644\uBCBD\uD55C \uD45C\uD604\uB825\uC5D0 \uBBF8\uC18C\uAC00 \uC808\uB85C \uC9C0\uC5B4\uC9C0\uB294\uB370![VAR 0114(0024)]",
  "\uBAB8\uB3C4 \uC5B4\uB290 \uC815\uB3C4 \uB2EC\uC544\uC62C\uB790\uC73C\uB2C8\uAE4C\\n\uB2E4\uC74C\uC740 \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C \uADFC\uC721\uC744 \uC790\uADF9\uD574 \uBCF4\uC790![VAR 0114(0024)]",
  "\uD3C9\uC18C \uD558\uB358 \uBC30\uD2C0\uBCF4\uB2E4 \uD06C\uAC8C \uC6C0\uC9C1\uC5EC\uC11C!\\n\uD568\uAED8 \uAFC8\uC758 BODY\uB97C \uB9CC\uB4E4\uC5B4 \uBCF4\uC790!",
  "\uC88B\uC558\uC5B4! \uD3EC\uCF13\uBAAC\uB3C4 \uADFC\uC721\uB3C4\\n\uAE30\uC068\uC5D0 \uACE0\uB3D9\uCE58\uACE0 \uC788\uB294\uB370![VAR 0114(0024)]",
  "\uD798\uB4E4\uACA0\uC9C0\uB9CC \uC870\uAE08\uB9CC \uB354!\\n\uC774\uC81C \uC5D1\uC11C\uC0AC\uC774\uC988 \uD6C4\uBC18\uC774\uC57C![VAR 0114(0024)]",
  "\uD758\uB7EC\uB0B4\uB9AC\uB294 \uB540! \uB118\uCCD0\uD750\uB974\uB294 \uAC10\uC815!\\n\uC815\uB9D0\uC774\uC9C0 \uBCFC\uB9CC\uD55C \uC5D1\uC11C\uC0AC\uC774\uC988\uC600\uC5B4![VAR 0114(0024)]",
  "\uD37C\uD399\uD2B8! \uB204\uAC00 \uC120\uC0DD\uB2D8\uC778\uC9C0\\n\uD5F7\uAC08\uB9B4 \uC815\uB3C4\uC600\uC5B4![VAR 0114(0024)]",
  "\uC790, \uADF8\uB7FC \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB85C \uD55C \uBC88 \uB354 \uD798\uB0B4 \uBCFC\uAE4C!\\n\uC313\uC5EC \uC624\uB294 \uC816\uC0B0\uC744 \uC774\uACA8 \uB0B4\uACE0 \uD55C\uACC4\uB97C \uB118\uC5B4 \uBD10![VAR 0114(0024)]",
  "\uC9C0\uCCE4\uC744 \uB54C\uC57C\uB9D0\uB85C\\n\uADFC\uC721\uC774 \uAC00\uC7A5 \uB9CE\uC774 \uC131\uC7A5\uD558\uB294 \uBC95\uC774\uB780\uB2E4!",
  "\uC218\uACE0\uD588\uC5B4!\\n\uC774\uC0C1\uC73C\uB85C \uC5D1\uC11C\uC0AC\uC774\uC988 \uC885\uB8CC~![VAR 0114(0024)]",
  "\uACB0\uACFC\uB294 \uD760\uC7A1\uC744 \uB370 \uC5C6\uC774 \uD569\uACA9\uC774\uC57C!\\n\uCD95\uD558\uD574![VAR 0114(0024)]",
  "\uC790, \uADF8\uB7FC! \uC811\uC218\uCC98\uAE4C\uC9C0 \uC804\uC18D\uB825\uC73C\uB85C \uCD9C\uBC1C!\\n\uD569\uACA9\uC744 \uBCF4\uACE0\uD558\uB294 \uAC83\uAE4C\uC9C0\uAC00\\r\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB77C\uACE0![VAR 0114(0024)]",
  "\uC774\uB7F0, \uC544\uAE5D\uB2E4...!\\n\uBCA0\uC774\uD06C\uCCB4\uC721\uAD00\uC5D0 \uB3C4\uC804\uD558\uB824\uBA74\\r\\n\uC870\uAE08 \uB354 \uB2E8\uB828\uD574\uC57C \uD560 \uAC83 \uAC19\uC544.[VAR 0114(0024)]",
  "\uB124\uAC8C \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294 \uC5F4\uC815\uC774 \uC788\uB2E4\uBA74\\n\uB2E4\uC74C\uC5D0 \uB610 \uADF8 \uC5F4\uC758\uB97C \uBCF4\uC5EC \uC8FC\uB7EC \uC640 \uC918![VAR 0114(0024)]",
  "\uB610 \uC654\uAD6C\uB098, \uC804\uD559\uC0DD!\\n\uD76C\uB85C\uACBD\uB77D \uC5D1\uC11C\uC0AC\uC774\uC988 \uD68C\uC7A5\uC5D0 \uC798 \uC654\uC5B4![VAR 0114(0024)]",
