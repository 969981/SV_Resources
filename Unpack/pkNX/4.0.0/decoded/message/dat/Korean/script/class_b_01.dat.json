[
  "\uB2E4\uB4E4 \uB9CC\uB098\uC11C \uBC18\uAC00\uC6CC.\\n\uC218\uD559\uC744 \uB9E1\uACE0 \uC788\uB294 \uD0C0\uC784 \uC120\uC0DD\uB2D8\uC774\uB77C\uACE0 \uD574.[VAR 0114(0025)]",
  "\uC5EC\uB7EC\uBD84\uB4E4\uC5D0\uAC8C \uBA3C\uC800 \uC9C8\uBB38 \uD558\uB098 \uD560\uAC8C.\\n\uC218\uD559\uC774\uB098 \uACC4\uC0B0\uD558\uB294 \uAC83\uC740\\r\\n\uB2E4\uB4E4 \uC88B\uC544\uD558\uB2C8?[VAR 0114(0025)]",
  "\uC88B\uC544\uD574\uC694~!",
  "\uC870\uAE08\uC740...",
  "\uC73C\uC74C...",
  "\uC5B4\uBA38\uB098, \uD6C4\uD6C4\uD6C4...\\n\uB300\uB2F5\uD574 \uC918\uC11C \uACE0\uB9C8\uC6CC.[VAR 0114(0025)]",
  "\uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uB3C4 \uC788\uACE0, \uC2EB\uC5B4\uD558\uB294 \uC0AC\uB78C\uB3C4 \uC788\uACE0\\n\uB2E4\uC591\uD558\uB2C8 \uC815\uB9D0 \uBA4B\uC9C0\uB124.[VAR 0114(0025)]",
  "\uB2E4\uB4E4 \uB108\uBB34 \uAC71\uC815\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB3FC.\\c\\n\uC120\uC0DD\uB2D8\uACFC \uD568\uAED8\\n\uC2E0\uB098\uAC8C \uACF5\uBD80\uD574 \uBCF4\uC790~![VAR 0114(0025)]",
  "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8,\\n\uB2E4\uB4E4 \uD3EC\uCF13\uBAAC\uC758 \uD0C0\uC785 \uC0C1\uC131\uC740 \uC798 \uC54C\uACE0 \uC788\uB2C8?[VAR 0114(0025)]",
  "\uD480\uC740 \uBB3C\uC5D0 \uAC15\uD558\uACE0\\n\uBB3C\uC740 \uBD88\uAF43\uC5D0 \uAC15\uD558\uC9C0?[VAR 0114(0025)]",
  "\uADF8\uB7FC, \uD3EC\uCF13\uBAAC\uC5D0 \uB300\uD574 \uC798 \uC54C \uAC83 \uAC19\uC740\\n[VAR 0100(0000)]\uC5D0\uAC8C \uC9C8\uBB38 \uD558\uB098 \uD560\uAE4C?[VAR 0114(0025)]",
  "\uBD88\uAF43\uC5D0 \uAC15\uD55C \uBB3C\uD0C0\uC785 \uAE30\uC220 \uBB3C\uB300\uD3EC\uB97C\\n\uBD88\uAF43\uD0C0\uC785 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C \uC0AC\uC6A9\uD558\uBA74\\r\\n\uB370\uBBF8\uC9C0\uB294 \uC5B4\uB5BB\uAC8C \uB418\uC9C0?[VAR 0114(0025)]",
  "\uC808\uBC18\uC774 \uB41C\uB2E4",
  "\uBCC0\uD558\uC9C0 \uC54A\uB294\uB2E4",
  "\uB450 \uBC30\uAC00 \uB41C\uB2E4",
  "\uC5B4\uBA38, \uB300\uB2E8\uD55C \uC5ED\uBC1C\uC0C1\uC778\uB370?\\n\uADF8\uB807\uC9C0\uB9CC \uC120\uC0DD\uB2D8\uC774\uB77C\uBA74\\r\\n\uC2EB\uC5B4\uD558\uB294 \uAC83\uC5D0 \uB2FF\uC73C\uBA74 \uB354 \uAD34\uB85C\uC6B8 \uAC83 \uAC19\uC544.[VAR 0114(0025)]",
  "[VAR 0100(0000)][VAR 1900(0001)] \uCC38\uC744\uC131\uC774 \uAC15\uD55C\uAC00 \uBCF4\uAD6C\uB098.\\n\uADF8\uB807\uC9C0\uB9CC \uC120\uC0DD\uB2D8\uC774\uB77C\uBA74\\r\\n\uC2EB\uC5B4\uD558\uB294 \uAC83\uC5D0 \uB2FF\uC73C\uBA74 \uB354 \uAD34\uB85C\uC6B8 \uAC83 \uAC19\uC544.[VAR 0114(0025)]",
  "\uCC38 \uC798\uD588\uC5B4\uC694!\\n\uC5ED\uC2DC [VAR 0100(0000)][VAR 1900(0006)]\uAD6C\uB098![VAR 0114(0025)]",
  "\uC0C1\uB300\uC5D0\uAC8C \uC57D\uC810\uC778 \uD0C0\uC785\uC758 \uAE30\uC220\uC744 \uC0AC\uC6A9\uD558\uBA74\\n\uD6A8\uACFC\uAC00 \uB6F0\uC5B4\uB098\uC11C \uB370\uBBF8\uC9C0\uAC00 \uB450 \uBC30\uAC00 \uB3FC.[VAR 0114(0025)]",
  "\uBC18\uB300\uB85C \uC0C1\uB300\uC5D0\uAC8C \uC720\uB9AC\uD55C \uD0C0\uC785\uC73C\uB85C \uACF5\uACA9\uD558\uBA74\\n\uD6A8\uACFC\uAC00 \uBCC4\uB85C\uB77C \uB370\uBBF8\uC9C0\uAC00 \uC808\uBC18\uC774 \uB418\uC9C0...[VAR 0114(0025)]",
  "\uD6C4\uD6C4\uD6C4! \uBC30\uD2C0\uD559 \uC218\uC5C5 \uAC19\uC544\uC11C\\n\uC6B4\uD5A5 \uC120\uC0DD\uB2D8\uC5D0\uAC90 \uC870\uAE08 \uBBF8\uC548\uD558\uC9C0\uB9CC,\\r\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uC608\uB85C \uB4E4\uBA74\uC11C \uACF5\uBD80\uD558\uBA74[VAR 0114(0025)]",
  "\uC0B4\uC9DD \uC5B4\uB824\uC6B4 \uC218\uD559\uB3C4\\n\uB2E4 \uAC19\uC774 \uC7AC\uBC0C\uAC8C \uBC30\uC6B8 \uC218 \uC788\uC744 \uAC83 \uAC19\uC9C0?[VAR 0114(0025)]",
  "\uC5B4\uBA38\uB098, \uC885\uC18C\uB9AC\uAC00...\\n\uBC8C\uC368 \uB05D\uB098\uB2E4\uB2C8, \uC544\uC27D\uB124...[VAR 0114(0025)]",
  "\uB2E4\uC74C\uC5D0 \uB610 \uC5EC\uB7EC\uBD84\uACFC \uACF5\uBD80\uD560 \uB0A0\uC744\\n\uAE30\uB300\uD558\uACE0 \uC788\uC744\uAC8C~[VAR 0114(0025)]"
]
