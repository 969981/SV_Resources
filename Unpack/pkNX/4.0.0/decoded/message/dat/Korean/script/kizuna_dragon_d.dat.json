[
  "[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591 \uC544\uB2C8\uC2ED\uB2C8\uAE4C.[VAR 0114(0012)]",
  "\uB2F9\uC2E0\uC740 \uD56D\uC0C1\\n\uC911\uC694\uD55C \uC21C\uAC04\uC5D0 \uB098\uD0C0\uB098\uC2DC\uB294\uAD70\uC694.[VAR 0114(0012)]",
  "\uC911\uC694\uD55C \uC21C\uAC04\uC774\uC694?",
  "\uBB34\uC2A8 \uC77C \uC788\uC5B4\uC694?",
  "\uC2E4\uC740...[VAR 0114(0012)]",
  "\uD314\uC790\uD06C \uB2D8\\n\uBAA8\uC2DC\uB7EC \uC654\uC2B5\uB2C8\uB2E4.",
  "\uC624\uC168\uAD70\uC694.[VAR 0114(0012)]",
  "\uC77C\uC871\uC758 \uC218\uC7A5 \uC790\uB9AC\uB97C \uACC4\uC2B9\uD560\\n\uACB0\uC2EC\uC774 \uC11C\uC2E0 \uBAA8\uC591\uC774\uAD70\uC694.",
  "...\uADF8\uB807\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC800\uB294 \uACB0\uC2EC\uD588\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uACC4\uC18D \uC774 \uC544\uCE74\uB370\uBBF8\uC758\\n\uAD50\uC0AC\uB85C \uC788\uACA0\uB2E4\uB294 \uACB0\uC2EC\uC744\uC694!![VAR 0114(0012)]",
  "\uBB34, \uBB34\uC2A8 \uB9D0\uC500\uC744...! \uC77C\uC871\uC774 \uC5B4\uB5BB\uAC8C \uB418\uB4E0\\n\uC0C1\uAD00\uC5C6\uB2E4\uB294 \uB9D0\uC500\uC774\uC2E0\uAC00\uC694!?",
  "\uC0C1\uAD00\uC5C6\uC2B5\uB2C8\uB2E4!![VAR 0114(0012)]",
  "\uBCF4\uC2ED\uC2DC\uC624!\\n\uC774 \uBC29\uC5D0 \uC788\uB294 \uC608\uC220\uB4E4\uC744![VAR 0114(0012)]",
  "\uC544\uC774\uB4E4\uC774 \uD65C\uAE30\uCC28\uAC8C\\n\uC790\uC2E0\uC758 \uAC10\uC131\uC744 \uD3BC\uCE58\uACE0 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C![VAR 0114(0012)]",
  "\uC77C\uC871\uC758 \uC624\uB79C \uD608\uD1B5\uC744 \uC9C0\uD0A4\uB294 \uAC83\uB3C4\\n\uBB3C\uB860 \uC911\uC694\uD55C \uC77C\uC774\uC9C0\uC694.[VAR 0114(0012)]",
  "\uADF8\uB807\uC9C0\uB9CC \uC800\uB294 \uADF8\uAC83\uBCF4\uB2E4, \uBBF8\uB798\uC5D0 \uC2F9\uC744 \uD2D4\uC6B8\\n\uC7AC\uB2A5\uB4E4\uC744 \uC9C0\uCF1C\uBCF4\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4...[VAR 0114(0012)]",
  "\uC194\uC9C1\uD788 \uADF8\uCABD\uC774\\n\uD6E8\uC52C \uB354 \uC7AC\uBC0C\uC5B4 \uBCF4\uC774\uAE30\uB3C4 \uD558\uAD6C\uC694![VAR 0114(0012)]",
  "...\uB9D0\uC774 \uD1B5\uD558\uC9C0 \uC54A\uACA0\uB124\uC694.",
  "\uADF8\uB807\uC9C0\uB9CC,\\n\uD314\uC790\uD06C \uB2D8\uC758 \uADF8 \uB300\uB2F4\uD568...",
  "\uC5ED\uC2DC \uC6A9\uC758 \uC758\uC9C0\uB97C \uC774\uC5B4\uBC1B\uAE30\uC5D0\\n\uAC78\uB9DE\uC740 \uBD84\uC774\uC2DC\uB124\uC694.",
  "\uC800\uB294 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uACA0\uC5B4\uC694!\\n\uBA87 \uBC88\uC774\uACE0 \uB2F9\uC2E0\uC744 \uC124\uB4DD\uD558\uACA0\uC2B5\uB2C8\uB2E4!",
  "\uC608! \uC5BC\uB9C8\uB4E0\uC9C0 \uD574 \uBCF4\uC2ED\uC2DC\uC624!\\n\uB048\uAE30\uB77C\uBA74 \uC790\uC2E0 \uC788\uC73C\uB2C8\uAE4C\uC694![VAR 0114(0012)]",
  "\uC544\uBC84\uC9C0\uC758 \uAC74\uAC15\uC774 \uC548 \uC88B\uB2E4\uB294 \uAC83\uB3C4\\n\uC800\uB97C \uC124\uB4DD\uD558\uAE30 \uC704\uD574 \uAFB8\uBBFC\\r\\n\uC0C8\uBE68\uAC04 \uAC70\uC9D3\uB9D0\uC774\uC5C8\uC744 \uD14C\uC9C0\uC694![VAR 0114(0012)]",
  "...! \uADF8\uB7FC, \uC774\uB9CC!",
  "\uD5C8\uD5C8, \uC774\uAC70 \uBD80\uB044\uB7EC\uC6B4 \uBAA8\uC2B5\uC744\\n\uBCF4\uC5EC \uB4DC\uB9AC\uACE0 \uB9D0\uC558\uB124\uC694.[VAR 0114(0012)]",
  "\uD558\uB9C8\uD130\uBA74 \uAD50\uC0AC\uB97C \uADF8\uB9CC\uB450\uACE0\\n\uACE0\uD5A5\uC73C\uB85C \uB3CC\uC544\uAC08 \uBED4\uD588\uC2B5\uB2C8\uB2E4...[VAR 0114(0012)]",
  "\uADF8\uB807\uC9C0\uB9CC, \uD559\uC0DD\uB4E4\uC758 \uBAA8\uC2B5\uACFC\\n[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591\uC758 \uB9D0\uC500 \uB355\uBD84\uC5D0\\r\\n\uAC70\uC808\uD560 \uC6A9\uAE30\uB97C \uC5BB\uC744 \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC815\uB9D0 \uC544\uC774\uB4E4\uC5D0\uAC8C\\n\uBB50\uB77C \uAC10\uC0AC\uD574\uC57C \uD560\uC9C0 \uBAA8\uB974\uACA0\uB124\uC694.[VAR 0114(0012)]",
  "\uC81C\uAC00 \uC785\uC740 \uC740\uD61C\uB97C \uB2E4 \uAC1A\uAE30\uC5D0\uB294 \uBD80\uC871\uD558\uACA0\uC9C0\uB9CC\\n\uC774\uAC83\uC744 \uBC1B\uC544 \uC8FC\uC138\uC694.[VAR 0114(0012)]",
  "\uC790, \uADF8\uB7FC!\\n\uC55E\uC73C\uB85C\uB3C4 \uC800\uB294![VAR 0114(0012)]",
  "\uAD50\uC0AC\uB77C\uB294 \uCC9C\uC9C1\uC744\\n\uACC4\uC18D\uD574 \uB098\uAC00\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uD314\uC790\uD06C \uC120\uC0DD\uB2D8\uACFC\uC758\\n\uC720\uB300\uAC00 \uC2F9\uD144\uB2E4!"
]
