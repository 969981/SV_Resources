  "\uADF8\uB798\uC11C... \uBB34\uC791\uC815 \uB0A8\uC744 \uC2EB\uC5B4\uD558\uB294 \uAC74\\n\uC88B\uC9C0 \uC54A\uB2E4\uB294 \uAC78 \uBC30\uC6B8 \uC218 \uC788\uC5C8\uC5B4![VAR 0114(0044)]",
  "\uC544\uBB34\uD2BC \uB0B4 \uB9D0\uC740... \uB355\uBD84\uC5D0 \uC7AC\uBBF8\uC788\uC5C8\uC5B4!\\n\uB2E4\uB4E4 \uC774\uACF3\uC5D0 \uC640 \uC918\uC11C \uACE0\uB9C8\uC6CC![VAR 0114(0044)]",
  "\uD2B9\uD788, [VAR 0100(0000)]...[VAR 0114(0044)]",
  "\uC774\uACF3\uC5D0 \uC628 \uC0AC\uB78C\uC774 \uB108\uB77C\\n\uC5BC\uB9C8\uB098 \uB2E4\uD589\uC778\uC9C0 \uBAA8\uB974\uACA0\uC5B4.[VAR 0114(0044)]",
  "\uBB50!\\n\uB531\uD788 \uC601\uC6D0\uD788 \uBABB \uBCF4\uAC8C \uB418\uB294 \uAC74 \uC544\uB2C8\uC9C0\uB9CC![VAR 0114(0044)]",
