[
  "[VAR 0100(0000)], \uC5B4\uC11C \uC624\uB834![VAR 0114(0042)]",
  "\uC774\uAC78\uB85C \uBAA8\uB450...\uB294 \uC544\uB2C8\uC9C0\uB9CC\\n\uC5B4\uB290 \uC815\uB3C4 \uBAA8\uC600\uB124.[VAR 0114(0042)]",
  "......[VAR 0114(0044)]",
  "\uADF8\uB7FC, \uAD00\uB9AC\uC778 \uC544\uC800\uC528.\\n\uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694.[VAR 0114(0042)]",
  "\uC608, \uADF8\uB7FC...\\n\uC790~ \uC5EC\uB7EC\uBD84, \uC88B\uC740 \uC544\uCE68\uC785\uB2C8\uB2E4.[VAR 0114(0045)]",
