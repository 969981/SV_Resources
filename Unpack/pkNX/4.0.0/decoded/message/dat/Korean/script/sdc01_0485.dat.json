  "\uC815\uB9D0 \uBBF8\uC548\uD558\uAC8C \uB410\uC5B4.\\n\uB300\uACF5\uACFC \uAD00\uB828\uB41C \uC77C\uC5D0 \uC9C4\uCC99\uC774 \uC788\uC5B4\uC11C\\r\\n\uAF2D \uB3CC\uC544\uAC00 \uBD10\uC57C\uB9CC \uD558\uAC70\uB4E0.[VAR 0114(0042)]",
  "\uC778\uC194\uC790\uB85C \uB3D9\uD589\uD558\uAE34 \uD588\uC9C0\uB9CC,\\n\uB108\uD76C\uB294 \uC815\uB9D0 \uC6B0\uC218\uD55C \uC544\uC774\uB4E4\uC774\uB2C8\uAE4C\\r\\n\uB0B4\uAC00 \uC5C6\uC5B4\uB3C4 \uAD1C\uCC2E\uC744 \uAC70\uC57C.[VAR 0114(0042)]",
  "\uAD00\uB9AC\uC778 \uC544\uC800\uC528, \uC8C4\uC1A1\uD558\uC9C0\uB9CC,\\n\uB0A8\uC740 \uC77C\uC815 \uB3D9\uC548 \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694.[VAR 0114(0042)]",
