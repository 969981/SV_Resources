[
  "\uB2F9\uC2E0\uC774 \uC18C\uBB38\uC73C\uB85C\uB9CC \uB4E3\uB358\\n[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591... \uB9DE\uB098\uC694?[VAR 0114(002C)]",
  "\uB124\uBAA8 \uC591\uC5D0\uAC8C\uC11C \uAE30\uB300\uB418\uB294 \uC2E0\uC785\uC774 \uC788\uB2E4\uB294\\n\uC774\uC57C\uAE30\uB294 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.[VAR 0114(002C)]",
  "...\uAC11\uC790\uAE30 \uB9D0\uC744 \uAC78\uC5B4\uC11C\\n\uB180\uB77C\uAC8C \uD55C \uBAA8\uC591\uC774\uAD70\uC694.[VAR 0114(002C)]",
  "\uC81C \uC774\uB984\uC740 \uD314\uC790\uD06C.\\n\uD3EC\uCF13\uBAAC\uB9AC\uADF8 \uC0AC\uCC9C\uC655 \uC911 \uD55C \uBA85\uC785\uB2C8\uB2E4.\\r\\n\uC544\uCE74\uB370\uBBF8\uC5D0\uC11C\uB294 \uBBF8\uC220\uC744 \uB2F4\uB2F9\uD558\uACE0 \uC788\uC8E0.[VAR 0114(0012)]",
  "[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591\uC740 \uC5B4\uC9F8\uC11C\\n\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBAA8\uC544\\r\\n\uCC54\uD53C\uC5B8\uC774 \uB418\uB824\uB294 \uAC70\uC8E0?[VAR 0114(0012)]",
  "\uAC15\uD574\uC9C0\uAE30 \uC704\uD574\uC11C\uC694",
  "\uCE5C\uAD6C\uAC00 \uAD8C\uD574\uC11C\uC694",
  "\uBCF4\uBB3C\uC744 \uCC3E\uC73C\uB824\uAD6C\uC694",
  "\uADF8\uB0E5\uC694",
  "...\uB2F5\uBCC0 \uAC10\uC0AC\uD569\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC815\uB2F5\uC774\uB77C\uB294 \uAC83\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\\n\u201C\uBAA8\uB4E0 \uAE38\uC740 \uD314\uB370\uC544\uC758 \uB300\uACF5\uC73C\uB85C \uC774\uC5B4\uC838 \uC788\uB2E4.\u201D\\r\\n\uB77C\uB294 \uC774\uC57C\uAE30\uB3C4 \uC788\uC73C\uB2C8\uAE4C\uC694.[VAR 0114(0012)]",
  "\uB2F9\uC2E0\uC758 \uCE5C\uAD6C\uC778 \uB124\uBAA8 \uC591\uC740\\n\uD314\uB370\uC544 \uC0AC\uC0C1 \uCD5C\uC5F0\uC18C \uCC54\uD53C\uC5B8...[VAR 0114(0012)]",
  "\uC5B4\uCA4C\uBA74 \uB2F9\uC2E0\uB3C4\\n\uADF8\uB140\uC640 \uAC19\uC740 \uAC00\uB2A5\uC131\uC744\\r\\n\uAC00\uC9C0\uACE0 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uAD70\uC694.[VAR 0114(0012)]",
  "\uCC54\uD53C\uC5B8 \uB7AD\uD06C\uAC00 \uB418\uACE0\uC790 \uD558\uC2E0\uB2E4\uBA74\\n\uC800\uC640\uB3C4 \uC2F8\uC6B0\uAC8C \uB420 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC9C0\uACE0 \uB098\uC11C \uD6C4\uD68C\uD558\uC2DC\uAE30 \uC804\uC5D0\\n\uC9C0\uAE08\uBD80\uD130 \uC5F4\uC2EC\uD788 \uD574 \uC8FC\uC138\uC694.[VAR 0114(0012)]",
  "\uC81C\uAC00 \uB9E1\uACE0 \uC788\uB294 \uBBF8\uC220 \uC218\uC5C5\uB3C4\\n\uAE30\uD68C\uAC00 \uB418\uC2E0\uB2E4\uBA74 \uAF2D \uC218\uAC15\uD574 \uC8FC\uC2DC\uAD6C\uC694.[VAR 0114(0012)]"
]
