[
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758 \uC5EC\uB7EC\uBD84.\\n\uB9CC\uB098\uC11C \uBC18\uAC00\uC6CC.[VAR 0114(0025)]",
  "\uD0C0\uC784 \uC120\uC0DD\uB2D8\uC774\uB77C\uACE0 \uD574.\\n\uAC19\uC774 \uC990\uAC70\uC6B4 \uC218\uC5C5\uC744 \uB9CC\uB4E4\uC5B4 \uBCF4\uC790.[VAR 0114(0025)]",
  "\uC5B4\uBA38\uB098, [VAR 0100(0000)].\\n\uC18C\uBB38\uC740 \uB4E4\uC5C8\uC5B4.[VAR 0114(0025)]",
  "\uBE14\uB8E8\uBCA0\uB9AC\uC758 \uCC54\uD53C\uC5B8\uC73C\uB85C\uC11C\\n\uC5F4\uC2EC\uD788 \uD558\uACE0 \uC788\uB2E4\uBA70?[VAR 0114(0025)]",
  "\uC815\uB9D0 \uB300\uB2E8\uD55C\uAC78!\\n\uC120\uC0DD\uB2D8\uAE4C\uC9C0 \uBFCC\uB4EF\uD574\uC9C0\uB294 \uAE30\uBD84\uC774\uC57C.[VAR 0114(0025)]",
  "\uD0C0\uC784 \uC120\uC0DD\uB2D8\uC774 \uD544\uC694\uD558\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uC5EC\uAE30\uC5D0 \uBD88\uB7EC \uC8FC\uB834![VAR 0114(0025)]",
  "\uD0C0\uC784 \uC120\uC0DD\uB2D8!",
  "\uC790\uC8FC \uBD80\uB97C\uAC8C\uC694!",
  "\uC5B4\uBA38, \uBC8C\uC368 \uBD80\uB974\uB294 \uAC70\uB2C8?\\n\uD6C4\uD6C4\uD6C4, \uC815\uB9D0 \uC7AC\uBBF8\uC788\uB294 \uC544\uC774\uB77C\uB2C8\uAE4C.[VAR 0114(0025)]",
  "\uC5B4\uBA38, \uC0C1\uB2F9\uD788 \uC801\uADF9\uC801\uC778\uAC78!\\n\uC120\uC0DD\uB2D8\uB3C4 \uAC00\uC2B4\uC774 \uC124\uB808\uB124![VAR 0114(0025)]",
  "\uBD80\uD65C\uB3D9\uC5D0 \uBAA8\uD5D8\uC5D0 \uB9CE\uC774 \uBC14\uC058\uACA0\uC9C0\uB9CC\\n\uACF5\uBD80\uD558\uB294 \uAC83\uB3C4 \uC78A\uC9C0\uB294 \uB9D0\uB834.[VAR 0114(0025)]",
  "\uAC11\uC791\uC2A4\uB7FD\uACA0\uC9C0\uB9CC [VAR 0100(0000)]\uC5D0\uAC8C\\n\uBCF5\uC2B5 \uBB38\uC81C\uB97C \uD558\uB098 \uB0B4 \uBCFC\uAE4C?[VAR 0114(0025)]",
  "\uC77C\uBC18\uC801\uC778 \uC0C1\uD669\uC5D0\uC11C \uD3EC\uCF13\uBAAC\uC758 \uAE30\uC220\uC774\\n\uAE09\uC18C\uC5D0 \uB9DE\uC744 \uD655\uB960\uC740 \uC5BC\uB9C8\uC9C0?[VAR 0114(0025)]",
  "\uC57D 1%",
  "\uC57D 4%",
  "\uC57D 12%",
  "\uD6C4\uD6C4\uD6C4, [VAR 0100(0000)].\\n\uC815\uB9D0 \uC544\uAE4C\uC6E0\uC5B4.\\c\\n\uC815\uB2F5\uC740 \uC57D 4%\uC57C.\\n\uC798 \uAE30\uC5B5\uD574 \uB450\uB834.[VAR 0114(0025)]",
  "\uCC38 \uC798\uD588\uC5B4\uC694!\\n\uC5ED\uC2DC [VAR 0100(0000)][VAR 1900(0006)]\uAD6C\uB098!\\r\\n\uBC30\uC6B4 \uC9C0\uC2DD\uC744 \uC798 \uC0C8\uACA8 \uB450\uACE0 \uC788\uB124.[VAR 0114(0025)]",
  "\uC120\uC0DD\uB2D8 \uB9D0\uC774\uC9C0... \uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC758\\n\uD559\uC0DD\uB4E4\uC744 \uBCF4\uACE0 \uC788\uC73C\uBA74 \uC0B4\uC9DD \uAC71\uC815\uC774 \uB4E4\uC5B4.[VAR 0114(0025)]",
  "\uC218\uC5C5\uC758 \uB300\uBD80\uBD84\uC774 \uBC30\uD2C0\uD559\uAC19\uC774\\n\uC2B9\uBD80\uC640 \uAD00\uB828\uB41C \uAC83\uBFD0\uC774\uB354\uB77C\uACE0...[VAR 0114(0025)]",
  "\uC7A5\uB798\uC5D0 \uC9C0\uC2DD\uC744 \uD65C\uC6A9\uD560 \uC218 \uC788\uB294\\n\uC9C1\uC7A5\uC5D0 \uB2E4\uB2D0 \uC544\uC774\uB4E4\uC774\uC57C \uC88B\uACA0\uC9C0.[VAR 0114(0025)]",
  "\uADF8\uB7F0\uB370, \uB9CC\uC57D \uAFC8\uC744 \uC774\uB8E8\uC9C0 \uBABB\uD558\uBA74...?\\n\uB2E4\uB978 \uAE38\uB9C8\uC800 \uB9C9\uD600 \uBC84\uB9AC\uC9C0 \uC54A\uC744\uAE4C?[VAR 0114(0025)]",
  "\uC218\uD559\uC774\uB098 \uAC00\uC815, \uC5B8\uC5B4\uD559\uAC19\uC774...\\n\uB2E4\uC591\uD55C \uBBF8\uB798\uAC00 \uC788\uB2E4\uB294 \uAC78\\r\\n\uC544\uB294 \uAC8C \uC911\uC694\uD55C\uB370 \uB9D0\uC774\uC57C.[VAR 0114(0025)]",
  "\uD5DB\uB41C \uACF5\uBD80 \uAC19\uC740 \uAC83\uC740 \uC5C6\uB2E4\uACE0\\n\uC0DD\uAC01\uD558\uAE30\uB3C4 \uD558\uACE0...[VAR 0114(0025)]",
  "...\uBBF8\uC548, \uB9D0\uC774 \uB108\uBB34 \uAE38\uC5B4\uC84C\uB124.[VAR 0114(0025)]",
  "\uAD1C\uCC2E\uC544\uC694!",
  "\uACF5\uBD80\uAC00 \uB410\uC5B4\uC694!",
  "\uC5B4\uBA38, \uD6C4\uD6C4\uD6C4...\\n[VAR 0100(0000)][VAR 1900(0001)] \uC0C1\uB0E5\uD558\uAD6C\uB098.\\r\\n\uC120\uC0DD\uB2D8, \uC5F4\uC2EC\uD788 \uD574 \uBCFC\uAC8C![VAR 0114(0025)]",
  "[VAR 0100(0000)], \uC800\uBC88\uC5D0\uB294\\n\uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4 \uC918\uC11C \uACE0\uB9C8\uC6CC.[VAR 0114(0025)]",
  "\uADF8 \uB4A4\uB85C \uC5EC\uAE30 \uAD50\uC7A5 \uC120\uC0DD\uB2D8\uD55C\uD14C \uAC00\uC11C\\n\uC9C1\uC811 \uB2F4\uD310\uC744 \uC9C0\uC5C8\uC5B4!\\r\\n\uBC30\uD2C0\uD559 \uC774\uC678\uC758 \uC218\uC5C5\uB3C4 \uB298\uB824 \uB2EC\uB77C\uACE0 \uB9D0\uC774\uC57C![VAR 0114(0025)]",
  "\uC5B4\uB5BB\uAC8C \uB410\uC5B4\uC694?",
  "\uB300\uB2E8\uD574\uC694!",
  "\u201C\uAE30\uCD08 \uACFC\uBAA9\uC744 \uBC14\uAFC0 \uC218\uB294 \uC5C6\uACE0\\n \uC120\uD0DD \uACFC\uBAA9\uC744 \uB298\uB9AC\uB294 \uAC70\uB77C\uBA74 \uBB38\uC81C\uC5C6\uC8E0~\u201D\\r\\n...\uB77C\uACE0 \uD558\uC2DC\uB354\uB77C![VAR 0114(0025)]",
  "...\uC560\uCD08\uC5D0 [VAR 0100(0000)]\uC5D0\uAC8C\\n\uD2B9\uBCC4 \uAC15\uC0AC\uB97C \uCD08\uB300\uD558\uB294 \uC77C\uC744 \uB9E1\uAE34 \uAC83\uB3C4\\r\\n\uC774\uB7F0 \uD6A8\uACFC\uB97C \uAE30\uB300\uD574\uC11C\uC600\uB2E4\uB098 \uBD10.[VAR 0114(0025)]",
  "\uC544\uBB34\uD2BC, \uB098\uC11C \uBC84\uB9AC\uACE0 \uB9D0\uC558\uC5B4!\\n\uD6C4\uD6C4\uD6C4... \uC0B4\uC9DD \uBD80\uB044\uB7FD\uB124.[VAR 0114(0025)]",
  "\uCC38\uAC00 \uC778\uC6D0\uC740 \uC801\uC9C0\uB9CC\\n\uC5EC\uAE30\uC11C\uB3C4 \uC5F4\uC2EC\uD788 \uC218\uD559\uC744 \uAC00\uB974\uCE60 \uD14C\uB2C8\uAE4C\\r\\n[VAR 0100(0000)]\uB3C4 \uC751\uC6D0\uD574 \uC918![VAR 0114(0025)]",
  "\uACE0\uBBFC\uC744 \uD574\uACB0\uD588\uB354\uB2C8\\n\uB9E5\uC774 \uD0C1 \uD480\uB9AC\uB294 \uAC83 \uAC19\uC544.[VAR 0114(0025)]",
  "\uBB54\uAC00 \uBA4B\uC9C4 \uC77C\uC744 \uD574\uC11C\\n\uD790\uB9C1\uD558\uACE0 \uC2F6\uC740\uAC78...[VAR 0114(0025)]",
  "\uADF8\uB798, [VAR 0100(0000)].\\n\uB098\uC640 \uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD558\uC9C0 \uC54A\uC744\uB798?[VAR 0114(0025)]",
  "\uD6C4\uD6C4\uD6C4, \uBD80\uD0C1\uD574 \uBCF4\uAE38 \uC798\uD588\uB124.\\n\uC120\uC0DD\uB2D8\uC740 \uC554\uBA4D\uC774\uB97C \uC904\uAC8C!\\r\\n[VAR 0100(0000)][VAR 1900(0001)] \uC5B4\uB5BB\uAC8C \uD560\uB798?[VAR 0114(0025)]",
  "[VAR 0101(0001)][VAR 1900(0006)]\uB77C\uB2C8 \uBA4B\uC9C4\uAC78!\\n\uBC8C\uC368\uBD80\uD130 \uD790\uB9C1\uC774 \uB418\uB294 \uAE30\uBD84\uC774\uC57C!\\c\\n\uAD50\uD658\uD574 \uC918\uC11C \uACE0\uB9C8\uC6CC.\\n\uC18C\uC911\uD788 \uD0A4\uC6B8\uAC8C.[VAR 0114(0025)]",
  "[VAR 0100(0000)]\uC758 [VAR 0101(0001)][VAR 1900(0004)]\\n\uC120\uC0DD\uB2D8\uC758 \uC554\uBA4D\uC774\uB97C \uAD50\uD658\uD558\uB294 \uAC70\uC9C0?[VAR 0114(0025)]",
  "\uC5B4\uBC84\uC774\uAC00 \uC790\uC2E0\uC774 \uC544\uB2CC \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC5B4\uB77C? \uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774\\n1\uB9C8\uB9AC\uBFD0\uC778 \uBAA8\uC591\uC774\uC57C.\\c\\n\uAD50\uD658\uC744 \uD558\uB824\uBA74\\n2\uB9C8\uB9AC \uC774\uC0C1\uC740 \uC9C0\uB2C8\uACE0 \uC788\uC5B4\uC57C \uD574.[VAR 0114(0025)]",
  "\uC5B4\uBA38, \uAD50\uD658\uD558\uACE0 \uC2F6\uC9C0 \uC54A\uB2C8?\\n\uC870\uAE08 \uC12D\uC12D\uD55C\uAC78.[VAR 0114(0025)]",
  "\uC5B4\uBA38, [VAR 0100(0000)].\\n\uC120\uC0DD\uB2D8\uACFC \uD3EC\uCF13\uBAAC\uC744 \uAD50\uD658\uD560 \uAC70\uB2C8?[VAR 0114(0025)]",
  "\uC5B4\uBA38, [VAR 0100(0000)]. \uD639\uC2DC \uC120\uC0DD\uB2D8\uACFC\\n\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uAC00 \uD558\uACE0 \uC2F6\uC740 \uAC70\uB2C8?[VAR 0114(0025)]",
  "\uC2B9\uBD80\uAC00 \uD558\uACE0 \uC2F6\uC5B4\uC9C0\uBA74\\n\uC5B8\uC81C\uB4E0\uC9C0 \uB9D0\uD574 \uC8FC\uB834.[VAR 0114(0025)]",
  "\uADF8\uB7FC \uB098\uC57C \uC88B\uC9C0.\\n\uC0B4\uC0B4 \uBD80\uD0C1\uD560\uAC8C.[VAR 0114(0025)]",
  "[~ 65]",
  "[VAR 0100(0000)], \uAD49\uC7A5\uD574!\\n\uC815\uB9D0 \uAC15\uD558\uAD6C\uB098.[VAR 0114(0025)]",
  "\uC120\uC0DD\uB2D8\uC774 \uC804\uC131\uAE30 \uB54C\uC600\uC5B4\uB3C4\\n\uC774\uAE30\uC9C0 \uBABB\uD588\uC744 \uAC70\uC57C.[VAR 0114(0025)]",
  "\uC57D\uC18C\uD558\uC9C0\uB9CC \uC120\uC0DD\uB2D8\uC758\\n\uB9C8\uC74C\uC744 \uBC1B\uC544 \uC8FC\uACA0\uB2C8?[VAR 0114(0025)]",
  "\uBAA8\uD5D8\uC5D0 \uB3C4\uC6C0\uC774 \uB41C\uB2E4\uBA74\\n\uC120\uC0DD\uB2D8\uB3C4 \uAE30\uC060 \uAC70\uC57C.[VAR 0114(0025)]",
  "[~ 65]",
  "\uB108\uC640 \uC2B9\uBD80\uB97C \uD558\uBA74\\n\uD604\uC5ED \uC2DC\uC808\uC774 \uC0DD\uAC01\uB098\uACE4 \uD574.[VAR 0114(0025)]",
  "\uADF8\uB7FC \uC624\uB298\uC740 \uC774\uB9CC \u2018\uBC14\uC704\uBC14\uC704\u2019\uD560\uAE4C!\\n\uB2E4\uC74C\uC5D0 \uB610 \uC990\uAC81\uAC8C \uC2B9\uBD80\uD574 \uBCF4\uC790![VAR 0114(0025)]",
  "\uB098\uB3C4 \uC544\uC9C1 \uC4F8 \uB9CC\uD55C \uAC83 \uAC19\uC9C0?\\c\\n\uC2B9\uBD80\uD574 \uC918\uC11C \uACE0\uB9C8\uC6CC.\\n\uC990\uAC70\uC6B4 \uC2B9\uBD80\uC600\uC5B4.[VAR 0114(0025)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8 \uC544\uC774\uB4E4\uC5D0\uAC8C\\n\uBC14\uC704\uD0C0\uC785\uC758 \uD6CC\uB96D\uD568\uC5D0 \uB300\uD574 \uAC00\uB974\uCE58\uBA74\\r\\n\uB098\uC911\uC5D0 \uBC14\uC704\uD0C0\uC785 \uC804\uBB38\uAC00\uAC00 \uB9CE\uC544\uC9C0\uB824\uB098?[VAR 0114(0025)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uB294\\nBP\uB77C\uB294 \uD1B5\uD654\uAC00 \uC788\uB2E4\uBA70?\\r\\n\uB098\uC911\uC5D0 \uC218\uD559 \uBB38\uC81C\uC5D0 \uD65C\uC6A9\uD560 \uC218 \uC788\uACA0\uC5B4.[VAR 0114(0025)]",
  "\uC880 \uC804\uC5D0 \uB0A0 \uB3D9\uC0DD\uC73C\uB85C \uCC29\uAC01\uD55C \uC544\uC774\uAC00\\n\uC0AC\uC778\uD574 \uB2EC\uB77C\uACE0 \uC870\uB974\uB354\uB77C!\\c\\n\uB098\uB791 \uB77C\uC784\uC774\uB791\\n\uD558\uB098\uB3C4 \uC548 \uB2EE\uC740 \uAC83 \uAC19\uC740\uB370...[VAR 0114(0025)]",
  "[VAR 0100(0000)]\uC758 [VAR 0101(0001)][VAR 1900(0001)]\\n\uCC29\uD558\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uC5B4.\\c\\n\uD56D\uC0C1 \uB0B4 \uCF5C\uB85C\uC194\uD2B8\uC758 \uC5B4\uAE68 \uC704\uC5D0\uC11C\\n\uB290\uAE0B\uD558\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uB2E8\uB2E4.[VAR 0114(0025)]",
  "\uB0B4\uAC00 \uAD50\uD658\uD574 \uC900 \uC554\uBA4D\uC774\uC640\uB294\\n\uC0AC\uC774\uC88B\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uB2C8?\\c\\n\uC554\uBA4D\uC774\uB294 \uC9C4\uD654\uD558\uB294 \uC2DC\uAC04\uB300\uC5D0 \uB530\uB77C\\n\uBAA8\uC2B5\uC774 \uB2EC\uB77C\uC9C0\uB294 \uD2B9\uC774\uD55C \uD3EC\uCF13\uBAAC\uC774\uB780\uB2E4.[VAR 0114(0025)]"
]
