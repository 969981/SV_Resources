[
  "\uC5EC\uB7EC\uBD84 \uC548\uB155~\\n\uADF8\uB7FC, \uC218\uC5C5\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C\uC694~[VAR 0114(002A)]",
  "\uB2E4\uB4E4 \uC911\uAC04\uACE0\uC0AC \uBCF4\uB290\uB77C\\n\uC815\uB9D0 \uC218\uACE0 \uB9CE\uC558\uC5B4\uC694~[VAR 0114(002A)]",
  "\uC124\uBB38 \uC870\uC0AC\uB3C4 \uB3C4\uC6C0\uC774 \uB9CE\uC774 \uB418\uC5C8\uC5B4\uC694!\\n\uB2E4\uC74C\uC5D0 \uCC38\uACE0\uD558\uB3C4\uB85D \uD560\uAC8C\uC694~[VAR 0114(002A)]",
  "\uC790, \uADF8\uB7FC\\n\uC0DD\uBB3C \uC218\uC5C5\uC758 \uD6C4\uBC18\uC804\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C\uC694?[VAR 0114(002A)]",
  "\uC6B0\uB9AC\uB3C4 \uD3EC\uCF13\uBAAC\uCC98\uB7FC\\n\uC9C0\uC2DD\uC744 \uC9C4\uD654\uC2DC\uCF1C \uBCF4\uC544\uC694~![VAR 0114(002A)]",
  "\uADF8\uB798\uC694, \uC9C4\uD654...\\n\uD5E4\uD5E4, \uC9C4\uD654\uC2DC\uD0A4\uB294 \uAC70\uC608\uC694.[VAR 0114(002A)]",
  "\uC624\uB298\uC740 \uD3EC\uCF13\uBAAC\uC758 \uC9C4\uD654\uC5D0 \uB300\uD574\\n\uBC30\uC6CC \uBCFC \uAC70\uC608\uC694~[VAR 0114(002A)]",
  "\uD3EC\uCF13\uBAAC\uC740 \uC2F8\uC6C0\uC744 \uD1B5\uD574\\n\uB808\uBCA8\uC774 \uC624\uB974\uBA74\\r\\n\uAE30\uC220\uC744 \uBC30\uC6B0\uAC70\uB098 \uB354 \uAC15\uD574\uC838\uC694.[VAR 0114(002A)]",
  "\uADF8\uB9AC\uACE0, \uB808\uBCA8\uC774\\n\uC77C\uC815\uD55C \uC218\uC900\uAE4C\uC9C0 \uC624\uB974\uBA74...[VAR 0114(002A)]",
  "\uBAA8\uC2B5\uC774 \uBC14\uB00C\uBA74\uC11C\\n\uB2A5\uB825\uB3C4 \uD06C\uAC8C \uC624\uB978\uB2F5\uB2C8\uB2E4~![VAR 0114(002A)]",
  "\uADF8\uAC8C \uBC14\uB85C \uD3EC\uCF13\uBAAC\uC758 \uC9C4\uD654\uB77C\uB294 \uAC70\uC608\uC694![VAR 0114(002A)]",
  "\uC9C4\uD654\uB97C \uD558\uBA74 \uC5C4\uCCAD\uB098\uAC8C \uAC15\uD574\uC838\uC11C\\n\uC2B9\uBD80\uB97C \uD560 \uB54C\uB3C4\\r\\n\uB4EC\uC9C1\uD55C \uD30C\uD2B8\uB108\uAC00 \uB418\uC5B4 \uC900\uB2F5\uB2C8\uB2E4~[VAR 0114(002A)]",
  "...\uD558\uC9C0\uB9CC! \uC9C4\uD654\uC2DC\uD0A4\uC9C0 \uC54A\uACE0\\n\uD604\uC7AC \uBAA8\uC2B5 \uADF8\uB300\uB85C\\r\\n\uADC0\uC5EC\uC6CC\uD558\uACE0 \uC2F6\uC744 \uB54C\uB3C4 \uC788\uC8E0~?[VAR 0114(002A)]",
  "\uADF8\uB7F4 \uB54C\uB294 \uC9C4\uD654\uAC00 \uC2DC\uC791\uB418\uC5C8\uC744 \uB54C\\n\uB2F9\uD669\uD558\uC9C0 \uB9D0\uACE0, \uC774 \uB9D0\uC744 \uC678\uCE58\uB294 \uAC70\uC608\uC694![VAR 0114(002A)]",
  "\uB2E4 \uAC19\uC774 \uB9D0\uD574 \uBCFC\uAE4C\uC694?\\n\uC9C4\uD654 \uCDE8\uC18C\uB294...? \uD558\uB098, \uB458...![VAR 0114(002A)]",
  "A \uBC84\uD2BC!",
  "B \uBC84\uD2BC!",
  "C \uBC84\uD2BC!",
  "...\uC5B4\uB77C? [VAR 0100(0000)] \uD63C\uC790\\n\uB2F5\uC744 \uD2C0\uB9B0 \uAC83 \uAC19\uC740\uB370\uC694?\\c\\nA \uBC84\uD2BC\uC740 \uBB54\uAC00 OK\uB098\\n\uACB0\uC815\uD560 \uB54C \uC4F0\uB294 \uB290\uB08C\uC774\uC9C0 \uC54A\uB098\uC694~?[VAR 0114(002A)]",
  "Best\uD55C \uC815\uB2F5\uC758 B!\\n\uBAA8\uB450 \uC815\uB2F5\uC774\uC5D0\uC694~![VAR 0114(002A)]",
  "...\uC5B4\uB77C? [VAR 0100(0000)] \uD63C\uC790\\n\uB2F5\uC744 \uD2C0\uB9B0 \uAC83 \uAC19\uC740\uB370\uC694?\\c\\nC \uBC84\uD2BC\uC774\uB77C... \uBB54\uAC00 \uAD49\uC7A5\uD788\\n\uD5A5\uC218\uB97C \uC790\uADF9\uD558\uB294 \uAC83 \uAC19\uC740 \uB9D0\uC774\uB124\uC694~[VAR 0114(002A)]",
  "\uB9DE\uC544\uC694!\\n\uBC14\uB85C \u201C\uC9C4\uD654 \uCDE8\uC18C B \uBC84\uD2BC!\u201D\uC774\uC5D0\uC694~[VAR 0114(002A)]",
  "\uC9C4\uD654\uAC00 \uC2DC\uC791\uB418\uC790\uB9C8\uC790 \uC678\uCE58\uBA74\\n\uBAA8\uC2B5\uC774 \uBC14\uB00C\uB294 \uAC83\uC744 \uBA48\uCD9C \uC218 \uC788\uC5B4\uC694.[VAR 0114(002A)]",
  "\uBCC0\uD568\uC5C6\uB294\uB3CC\uC774\uB77C\uB294\\n\uB3C4\uAD6C\uB97C \uC9C0\uB2C8\uAC8C \uD558\uB294 \uAC83\uC73C\uB85C\uB3C4\\r\\n\uC9C4\uD654\uC758 \uC6C0\uC9C1\uC784\uC744 \uBA48\uCD9C \uC218 \uC788\uB2F5\uB2C8\uB2E4~[VAR 0114(002A)]",
  "\uCC38\uACE0\uB85C, \uC9C4\uD654\uD558\uB294 \uC870\uAC74\uC740\\n\uD3EC\uCF13\uBAAC\uB9C8\uB2E4 \uAC00\uC9C0\uAC01\uC0C9\uC774\uC5D0\uC694.[VAR 0114(002A)]",
  "\uBD88\uAF43\uC758\uB3CC\uC774\uB098 \uCC9C\uB465\uC758\uB3CC \uAC19\uC740\\n\uB3C4\uAD6C\uB97C \uC0AC\uC6A9\uD574\uC57C \uC9C4\uD654\uD55C\uB2E4\uAC70\uB098,\\r\\n\uD2B9\uC815 \uAE30\uC220\uC744 \uBC30\uC6CC\uC57C \uD558\uB294 \uACBD\uC6B0\uB3C4 \uC788\uACE0,\\r\\n\uD2B9\uC815 \uD3EC\uCF13\uBAAC\uC744 \uC4F0\uB7EC\uB728\uB824\uC57C \uD558\uB294 \uACBD\uC6B0\uB3C4 \uC788\uC8E0.[VAR 0114(002A)]",
  "\uC131\uC6D0\uC22D\uC744 \uC800\uC2B9\uAC13\uC22D\uC73C\uB85C\\n\uC9C4\uD654\uC2DC\uD0A4\uB294 \uBC29\uBC95\uC774 \uD2B9\uD788 \uB354 \uD2B9\uC774\uD55C\uB370,[VAR 0114(002A)]",
  "\uC5B4\uB5A4 \uAE30\uC220\uC744...[VAR 0114(002A)]",
  "...\uC774\uB7F0, \uB9C8\uCE68 \uB531\\n\uC2DC\uAC04\uC774 \uB418\uC5B4 \uBC84\uB838\uB124\uC694~[VAR 0114(002A)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0!\\n\uB2E4\uB4E4 \uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4~[VAR 0114(002A)]"
]
