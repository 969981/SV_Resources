  "\uC5B4\uB5A4 \uD65C\uC57D\uC774\uC694?",
  "\uC5EC\uAE30\uC800\uAE30\uC5D0\uC11C\uC694?",
  "\uC2B9\uBD80\uC5D0 \uAC15\uD558\uB2E4\uB4E0\uC9C0\\n\uAD49\uC7A5\uD55C \uD3EC\uCF13\uBAAC\uC744 \uB370\uB9AC\uACE0 \uC788\uB2E4\uB4E0\uC9C0\\r\\n\uC628\uAC16 \uC774\uC57C\uAE30\uAC00 \uB4E4\uB9AC\uB354\uAD70.[VAR 0114(0029)]",
  "\uB2F9\uC0AC\uC790\uB85C\uC11C \uC870\uAE08 \uC131\uAC00\uC2E4 \uC218\uB3C4 \uC788\uACA0\uB2E4\uB9CC,\\n\uB2E4\uB4E4 \uADF8\uB9CC\uD07C \uC790\uB124\uC5D0\uAC8C \uAD00\uC2EC\uC774 \uB9CE\uB2E4\uB294 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uC774 \uAC00\uC815\uC2E4\uC740\\n\uD559\uC0DD\uB4E4\uC758 \uC27C\uD130 \uAC19\uC740 \uACF3\uC774\uB77C,[VAR 0114(0029)]",
