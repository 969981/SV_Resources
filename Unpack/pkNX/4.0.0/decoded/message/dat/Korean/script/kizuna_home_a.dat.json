[
  "\uB098\uC758 \uC131\uCC44\uB77C \uD560 \uC218 \uC788\uB294\\n\uAC00\uC815\uC2E4\uC5D0 \uC798 \uC654\uB2E4.[VAR 0114(0029)]",
  "1-A [VAR 0100(0000)]...[VAR 0114(0029)]",
