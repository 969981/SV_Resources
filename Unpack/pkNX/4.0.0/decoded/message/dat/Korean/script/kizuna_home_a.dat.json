  "\uC790\uB124\uAC00 \uC694\uC998 \uC6CC\uB099\\n\uD654\uC81C\uC758 \uC911\uC2EC\uC774\uB2E4 \uBCF4\uB2C8\uAE4C\\r\\n\uB098\uAE4C\uC9C0 \uD765\uBBF8\uAC00 \uC0DD\uAE30\uB354\uAD70.[VAR 0114(0029)]",
  "\uBD80\uB2F4 \uC904 \uC0DD\uAC01\uC740 \uC5C6\uB2E4\uB9CC\\n\uAD1C\uCC2E\uB2E4\uBA74 \uB610 \uB4E4\uB7EC \uB2E4\uC624.[VAR 0114(0029)]",
  "\uC0AC\uAD6C\uC544\uB85C \uC120\uC0DD\uB2D8\uACFC\\n\uC870\uAE08 \uCE5C\uD574\uC84C\uB2E4!"
