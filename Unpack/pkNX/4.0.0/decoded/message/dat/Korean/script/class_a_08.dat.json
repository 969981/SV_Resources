[
  "\uC5EC\uB7EC\uBD84 \uC548\uB155~\\n\uC624\uB298\uC740 \uAE30\uB9D0\uACE0\uC0AC\uB97C \uBCFC \uAC70\uC608\uC694~[VAR 0114(002A)]",
  "\uC9C0\uAE08\uAE4C\uC9C0 \uBC30\uC6B4 \uAC83\uC744 \uBAA8\uB450 \uBCF5\uC2B5\uD558\uB294 \uC815\uB3C4\uB2C8\uAE4C\\n\uC5EC\uB7EC\uBD84\uC774\uB77C\uBA74 \uBB38\uC81C\uC5C6\uC744 \uAC70\uC608\uC694~![VAR 0114(002A)]",
  "\uCD08\uC870\uD574\uD558\uC9C0 \uB9D0\uACE0,\\n\uCE68\uCC29\uD558\uAC8C \uBB38\uC81C\uB97C \uD480\uC5B4 \uBCF4\uB3C4\uB85D \uD558\uC138\uC694![VAR 0114(002A)]",
  "1. \uB2E4\uC74C \uC911, \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC27D\uAC8C \uB9CC\uB4DC\uB294\\n    \uBC29\uBC95\uC73C\uB85C \uC801\uC808\uD55C \uAC83\uC740 \uBA87 \uAC1C\uC778\uAC00?\\n\\n\u3131) \uB9C8\uBE44 \uC0C1\uD0DC\uB85C \uB9CC\uB4E0\uB2E4 \u3134) \uD3EC\uCF13\uD480\uC744 \uC4F4\uB2E4\\n\u3137) \uB098\uBB34\uC5F4\uB9E4\uB97C \uC900\uB2E4 \u3139) \uB4A4\uC5D0\uC11C \uD5C8\uB97C \uCC0C\uB978\uB2E4",
  "1\uAC1C",
  "2\uAC1C",
  "3\uAC1C",
  "4\uAC1C",
  "2. \uC0C8\uB85C\uC6B4 \uD3EC\uCF13\uBAAC\uC744 \uB9CC\uB098\uB294 \uBC29\uBC95\uC740\\n    \uC7A1\uAC70\uB098 \uAD50\uD658\uD558\uB294 \uAC83\uBFD0\uC774\uB2E4.\\n    \uB9DE\uC73C\uBA74 O, \uD2C0\uB9AC\uBA74 X",
  "O",
  "X",
  "3. \uBCC0\uD568\uC5C6\uB294\uB3CC\uC744 \uC9C0\uB2C8\uACE0 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\\n    \uBD88\uAF43\uC758\uB3CC \uB4F1\uC758 \uC9C4\uD654 \uB3C4\uAD6C\uB97C \uC0AC\uC6A9\uD558\uBA74\\n    \uADF8 \uD3EC\uCF13\uBAAC\uC740 \uC9C4\uD654\uD560\uAE4C?\\n\\n1) \uC9C4\uD654\uD55C\uB2E4 2) \uC9C4\uD654\uD558\uC9C0 \uC54A\uB294\uB2E4",
  "\uC9C4\uD654\uD55C\uB2E4",
  "\uC9C4\uD654\uD558\uC9C0 \uC54A\uB294\uB2E4",
  "4. \uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC744\\n    \uB9CC\uB0A0 \uC218 \uC788\uB294 \uD655\uB960\uC740?\\n\\n1) 2000\uB9C8\uB9AC\uC5D0 \uD558\uB098 2) 4000\uB9C8\uB9AC\uC5D0 \uD558\uB098\\n3) 6000\uB9C8\uB9AC\uC5D0 \uD558\uB098",
  "2000\uB9C8\uB9AC\uC5D0 \uD558\uB098",
  "4000\uB9C8\uB9AC\uC5D0 \uD558\uB098",
  "6000\uB9C8\uB9AC\uC5D0 \uD558\uB098",
  "5. \uCDA4\uCD94\uC0C8\uB77C\uB294 \uD3EC\uCF13\uBAAC\uC5D0\uAC8C\uB294\\n    3\uAC1C\uC758 \uD3FC\uC774 \uC874\uC7AC\uD55C\uB2E4.\\n    \uB9DE\uC73C\uBA74 O, \uD2C0\uB9AC\uBA74 X",
  "O",
  "X",
  "\u2606\u2605\uC810\uC218\uC640 \uBB34\uAD00\uD55C \uC9C8\uBB38\uC785\uB2C8\uB2E4\u2605\u2606\\n\\n\uC9C0\uB2C8\uC5B4 \uC120\uC0DD\uB2D8\uC758 \uC218\uC5C5\uC740 \uC5B4\uB560\uB098\uC694?\\n\uC544\uC9C1 \uC775\uC219\uD558\uC9C0 \uC54A\uC544\uC11C \uBBF8\uC548\uD588\uC9C0\uB9CC,\\n\uC120\uC0DD\uB2D8\uC740 \uC815\uB9D0 \uC990\uAC70\uC6E0\uB2F5\uB2C8\uB2E4~!",
  "\uC990\uAC70\uC6E0\uC5B4\uC694!",
  "\uACE0\uB9C8\uC6E0\uC5B4\uC694!",
  "\uD798\uB0B4\uC138\uC694!",
  "\uC790~ \uAE30\uBED0\uB3C4 \uC2AC\uD37C\uB3C4 \uC2DC\uD5D8\uC740 \uC5EC\uAE30\uAE4C\uC9C0!\\n\uB2E4\uB4E4 \uC990\uAC81\uAC8C \uBB38\uC81C\uB97C \uD480\uC5C8\uB2E4\uBA74 \uC88B\uACA0\uB124\uC694~[VAR 0114(002A)]",
  "\uD5E4\uD5E4... \uC774\uBC88\uC5D0\uB3C4 \uC0B4\uC9DD \uBD80\uB044\uB7EC\uC6B4\\n\uC124\uBB38 \uC870\uC0AC\uB97C \uB123\uC5B4 \uBC84\uB838\uC5B4\uC694.\\r\\n\uAD50\uC7A5 \uC120\uC0DD\uB2D8\uAED8\uB294 \uBE44\uBC00\uC774\uC5D0\uC694~[VAR 0114(002A)]",
  "\uAE08\uBC29 \uCC44\uC810\uD560 \uD14C\uB2C8\uAE4C,\\n\uC124\uB808\uB294 \uB9C8\uC74C\uC73C\uB85C \uACB0\uACFC\uB97C \uAE30\uB2E4\uB824 \uC8FC\uC138\uC694![VAR 0114(002A)]"
