[
  "\uBBF8\uBAA8\uC0AC\uC758 \uBCF4\uAC74\uC2E4\uC5D0 \uC798 \uC654\uC5B4~[VAR 0114(0028)]",
  "\uC5B4\uB77C?\\n[VAR 0100(0000)], \uC870\uAE08 \uC529\uC529\uD574\uC9C4 \uAC83 \uAC19\uC740\uB370?[VAR 0114(0028)]",
  "\uC624~ \uC790\uAE30 \uC785\uC73C\uB85C \uAE0D\uC815\uD558\uB294 \uAC70\uC57C~?\\n\uADF8\uB807\uC9C0\uB9CC, \uC9C4\uC9DC \uD45C\uC815\uBD80\uD130 \uBC14\uB010 \uAC83 \uAC19\uC544.[VAR 0114(0028)]",
  "\uC544\uB2C8\uAE34~ \uC9C4\uC9DC\uB798\uB450.\\n\uD45C\uC815\uBD80\uD130 \uBC14\uB010 \uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0.[VAR 0114(0028)]",
  "\uBCF4\uBB3C\uCC3E\uAE30\uC5D0\uC11C\\n\uC774\uAC83\uC800\uAC83 \uB9CE\uC774 \uACBD\uD5D8\uD588\uB098 \uBCF4\uB124~[VAR 0114(0028)]",
  "\uC5B4\uB5A4 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0\\n\uB4E4\uB824\uC8FC\uC9C0 \uC54A\uC744\uB798?[VAR 0114(0028)]",
  "\uD750\uC74C~\\n\uADF8\uB7F0 \uC7AC\uBBF8\uC788\uB294 \uC77C\uC774 \uC788\uC5C8\uAD6C\uB098~[VAR 0114(0028)]",
  "\uC544\uC774\uB4E4\uC740 \uAD49\uC7A5\uD558\uB2E4\uB2C8\uAE4C~\\n\uB9E4\uC77C \uC0C8\uB85C\uC6B4 \uC77C\uC5D0\\r\\n\uB3C4\uC804\uD558\uC796\uC544...[VAR 0114(0028)]",
  "\uADF8\uC5D0 \uBE44\uD558\uBA74 \uB098\uB294...[VAR 0114(0028)]",
  "...\uB098, \uC6D0\uB798\uB294\\n\uD559\uAD50 \uC120\uC0DD\uB2D8\uC774 \uB418\uACE0 \uC2F6\uC5C8\uC5B4~[VAR 0114(0028)]",
  "\uC544, \uC9C0\uAE08\uC740 \uADF8\uB0E5 \uD559\uAD50 \uAC04\uD638\uC0AC\uC57C.\\n\uC218\uC5C5 \uAC19\uC740 \uAC74 \uBABB \uD558\uB294 \uCABD \uB9D0\uC774\uC57C.[VAR 0114(0028)]",
  "\uBCF4\uAC74 \uAD50\uC0AC \uC2DC\uD5D8\uC5D0\uC11C\\n\uB9E4\uBC88 \uB5A8\uC5B4\uC84C\uAC70\uB4E0~[VAR 0114(0028)]",
  "\uBA87 \uBC88\uC744 \uD574\uB3C4 \uC548 \uB3FC\uC11C\\n\uC601\uC601 \uBCF4\uAC74\uC2E4\uC5D0 \uBC15\uD600 \uC788\uAC8C \uB41C \uAC70\uC9C0.[VAR 0114(0028)]",
  "\uC557, \uBBF8\uC548.\\n\uC6B0\uC6B8\uD55C \uC774\uC57C\uAE30\uB97C \uD574 \uBC84\uB838\uB124.[VAR 0114(0028)]",
  "\uB124\uAC00 \uC88B\uC740 \uB9AC\uC2A4\uB108\uB77C\uC11C \uADF8\uB7F0\uAC00?\\n\uB098\uB3C4 \uBAA8\uB974\uAC8C \uB9D0\uC774 \uACC4\uC18D \uB098\uC624\uAC8C \uB418\uB124.[VAR 0114(0028)]",
  "\uB0B4 \uC774\uC57C\uAE30\uAC00 \uC9C8\uB9AC\uC9C0 \uC54A\uC558\uB2E4\uBA74\\n\uB2E4\uC74C\uC5D0 \uB610 \uBCF4\uB7EC \uC640~[VAR 0114(0028)]",
  "\uBBF8\uBAA8\uC0AC \uC120\uC0DD\uB2D8\uACFC\\n\uC870\uAE08 \uB354 \uCE5C\uD574\uC84C\uB2E4!"
]
