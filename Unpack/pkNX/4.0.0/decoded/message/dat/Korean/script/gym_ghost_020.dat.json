[
  "\uD504\uB9AC\uC9C0\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uC5D0 \uAD00\uD55C \uC124\uBA85\uC744\\r\\n\uB2E4\uC2DC \uD55C\uBC88 \uB4E4\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uD504\uB9AC\uC9C0\uCCB4\uC721\uAD00\uC758 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uACFC\uC81C\uB294\\n[VAR FF00(0006)]\uC624\uD504\uB2DD \uC561\uD2B8[VAR FF00(0000)]!\\r\\n...\uD754\uD788 \uB9D0\uD558\uB294 \uBC14\uB78C\uC7A1\uC774\uC785\uB2C8\uB2E4!",
  "\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC758 \uB77C\uC774\uBE0C\uAC00 \uC2DC\uC791\uB418\uAE30 \uC804\uC5D0\\n\uC2A4\uD14C\uC774\uC9C0 \uC704\uC5D0\uC11C \uD3EC\uCF13\uBAAC \uC2B9\uBD80!\\r\\n\uB728\uAC70\uC6B4 \uC2B9\uBD80\uB85C \uAD00\uAC1D\uB4E4\uC744 \uD765\uBD84\uC2DC\uCF1C \uC8FC\uC138\uC694!",
  "\uB77C\uC774\uBE0C \uD68C\uC7A5\uC5D0 \uC788\uB294 MC\uC640 \uC774\uC57C\uAE30\uD558\uBA74\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C \uC2DC\uC791\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",
  "\uC654\uAD6C\uB098! \uBC14\uB78C\uC7A1\uC774 \uD2B8\uB808\uC774\uB108!\\n\uB0B4 \uC774\uB984\uC740 MC \uD55C\uBC29!\\r\\n\uB77C\uC774\uBE0C \uD68C\uC7A5\uC740 \uC774\uCABD\uC774\uC57C![VAR 0114(003B)]",
  "\uC774\uC81C\uBD80\uD130 \uB108\uB294\\n\uD3EC\uCF13\uBAAC\uC744 2\uB9C8\uB9AC \uB0B4\uBCF4\uB0B4\uC11C \uC2F8\uC6B0\uB294\\r\\n\uB354\uBE14\uBC30\uD2C0\uC744 \uD558\uAC8C \uB420 \uAC70\uC57C![VAR 0114(003B)]",
  "[~ 55]",
  "\uB354\uBE14\uB85C \uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB97C \uD55C \uBC29 \uBA39\uC5EC \uC8FC\uBA74\\n\uC990\uAC70\uC6C0\uC774 \uB354\uBE14\uC774\uB2C8\uAE4C, \uAC1D\uC11D\uC740 \uD6C4\uB048!\\r\\n\uD68C\uC7A5\uC740 \uD654\uB048! \uD504\uB9AC\uC9C0\uB9C8\uC744\uC740 \uB530\uB048\uB530\uB048\uC774\uB77C\uACE0![VAR 0114(003B)]",
  "\uADF8\uB807\uAC8C \uB2EC\uC544\uC624\uB978 \uB77C\uC774\uBE0C \uD68C\uC7A5\uC5D0\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5\uC774 \uD765\uACB9\uAC8C \uB4F1\uC7A5\uD558\uBA74!\\r\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uD074\uB9AC\uC5B4~! \uC624\uCF00\uC774?[VAR 0114(003B)]",
  "\uC2A4\uD14C\uC774\uC9C0\uC5D0 \uC624\uB974\uBA74 \uC624\uD504\uB2DD \uC561\uD2B8 \uC2DC\uC791\uC774\uC57C!\\n3\uC5F0\uC2B9 \uC804\uC5D0\uB294 \uB3C4\uC911\uC5D0 \uB098\uAC08 \uC218 \uC5C6\uC73C\uB2C8\uAE4C\\r\\n\uAC01\uC624\uD558\uACE0 \uB3C4\uC804\uD558\uB77C\uACE0![VAR 0114(003B)]",
  "\uC624\uD504\uB2DD \uC561\uD2B8 \u0026 \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8!\\n\uD55C \uBC29 \uB0A0\uB824 \uBCFC \uC900\uBE44 Are You OK!?[VAR 0114(003B)]",
  "OK!",
  "\uC544\uC9C1\uC774\uC694",
  "\uC124\uBA85\uC744 \uB4E3\uB294\uB2E4",
  "\uC6CC\uC6B0! \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uC5D0 \uB3C4\uC804\uD558\uB824\uBA74\\n\uC2F8\uC6B8 \uC218 \uC788\uB294 \uD3EC\uCF13\uBAAC\uC774 2\uB9C8\uB9AC\uB294 \uD544\uC694\uD558\uB2E4\uACE0![VAR 0114(003B)]",
  "\uCC45\uC784\uC774 \uB9C9\uC911\uD55C \uC77C\uC774\uB2C8\uAE4C\\n\uC900\uBE44\uB294 \uCCA0\uC800\uD788 \uD574 \uB46C![VAR 0114(003B)]",
  "\uADF8\uB7FC, \uBC14\uB85C \uC2E4\uC804\uC774\uB2E4!\\n\uC2A4\uD14C\uC774\uC9C0\uB85C \uC62C\uB77C\uAC00 \uBD10![VAR 0114(003B)]",
  "Ladies \u0026 Gentlemen!\\n\uC774\uBC88 \uB77C\uC774\uBE0C\uC758 \uC624\uD504\uB2DD \uC561\uD2B8\uB294\\r\\n[VAR 0100(0000)]\uC758 \uB354\uBE14\uBC30\uD2C0 3\uC5F0\uC804!![VAR 0114(003B)]",
  "\uB3C4\uC804\uC790 [VAR 0100(0000)][VAR 1900(0004)]\\n\uAC00\uC7A5 \uCC98\uC74C \uC2B9\uBD80\uD560 \uC0C1\uB300\uB294...[VAR 0114(003B)]",
  "\uC0B0\uB4E4\uBC14\uB78C\uC744 \uBD80\uB974\uB294 \uC18C\uB144 \uD37C\uD3EC\uBA38~\\n\uC6B0~\uD0C4![VAR 0114(003B)]",
  "\uB354\uBE14\uBC30\uD2C0... 1\u002B1...\\n\uC815\uB2F5\uC774 \uBB54\uC9C0 \uB108\uB294 \uC54C\uC544?",
