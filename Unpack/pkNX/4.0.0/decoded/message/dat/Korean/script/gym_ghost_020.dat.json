  "\uAD00\uAC1D\uB4E4\uC758 \uC751\uC6D0\uD558\uB294 \uC18C\uB9AC\uAC00\\n\uC870\uAE08 \uCEE4\uC84C\uB2E4!",
  "\uD504\uB9AC\uC9C0 \uC2A4\uD14C\uC774\uC9C0\uC758 \uCD5C\uC2E0 \uAE30\uC220!\\n\uAD00\uAC1D\uB4E4\uC758 \uC5F4\uAE30\uAC00 \uB728\uAC70\uC6B8\uC218\uB85D\\r\\n\uC870\uBA85\uC774 \uB9CE\uC774 \uCF1C\uC9C0\uB294 \uC2DC\uC2A4\uD15C![VAR 0114(003B)]",
  "\uADF8\uB300\uB85C \uACC4\uC18D\uD574\uC11C \uAD00\uAC1D\uB4E4\uC5D0\uAC8C\\n\uD06C\uAC8C \uD55C \uBC29 \uBA39\uC5EC \uC8FC\uB77C\uACE0![VAR 0114(003B)]",
  "\uACC4\uC18D\uD574\uC11C!\\n\uB2E4\uC74C \uB300\uC804 \uC0C1\uB300\uB294...[VAR 0114(003B)]",
  "\uD638\uBD88\uD638\uAC00 \uAC08\uB9AC\uB294 \uC74C\uC545\uAC00! \uC0C8\uBBF8![VAR 0114(003B)]",
  "\uC11C\uB85C\uC758 \uC57D\uC810\uC740 \uBCF4\uC644\uD558\uACE0 \uAC15\uC810\uC740 \uC0B4\uB9AC\uB294 \uAC83!\\n\uADF8\uAC83\uC774 \uB450 \uB9C8\uB9AC\uC758 \uD569\uCC3D\uACFC \uD558\uBAA8\uB2C8~!",
  "\uAD00\uAC1D\uB4E4\uC740 \uC5F4\uAE30\uC5D0 \uD729\uC2F8\uC600\uB2E4!",
  "[VAR 0100(0000)][VAR 1900(0003)] \uBA4B\uC9C0\uAC8C \uD55C \uBC29 \uB0A0\uB9B0 \uB355\uC5D0\\n\uD568\uC131\uB3C4 \uC870\uBA85\uB3C4 \uD654\uB824\uD574\uC84C\uC5B4~![VAR 0114(003B)]",
  "\uADF8\uC57C\uB9D0\uB85C \uC11C\uD504\uB77C\uC774\uC988\uC758 \uC5F0\uC18D!\\n\uB124\uAC00 \uC774 \uC815\uB3C4\uB85C \uD574 \uC904 \uC904\uC774\uC57C![VAR 0114(003B)]",
  "\uB2E4\uC74C\uC774 \uB77C\uC2A4\uD2B8, \uC138 \uBC88\uC9F8!\\n\uCD5C\uD6C4\uC758 \uC0C1\uB300\uB294...[VAR 0114(003B)]",
  "\uBC14\uB85C \uB098, MC \uD55C\uBC29~![VAR 0114(003B)]",
  "MC\uB3C4 \uD3EC\uCF13\uBAAC\uB3C4 \uB0B4\uAC00 \uD55C \uC218 \uC704!\\n\uB354\uBE14\uB85C \uBCF4\uB0B4 \uC8FC\uB9C8, \uC800 \uD558\uB298 \uC704![VAR 0114(003B)]",
  "\uAD00\uAC1D\uB4E4\uC758 \uC5F4\uAE30\uAC00 \uCD5C\uACE0\uC870\uC5D0 \uB2EC\uD588\uB2E4!",
  "\uC640\uC6B0! \uC640\uC6B0!\\n\uC815\uB9D0 \uAD49\uC7A5\uD55C \uC2B9\uBD80\uC600\uC5B4!",
  "\uBCF4\uAE30 \uB4DC\uBB38\\n\uBA4B\uC9C4 \uC2B9\uBD80\uC600\uC5B4!",
  "Thank You, [VAR 0100(0000)]!\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB294 \uD569\uACA9\uC774\uC57C! \uCD95\uD558\uD574!\\r\\n\uBAA8\uB450 \uD569\uACA9\uC790\uC5D0\uAC8C \uD798\uCC28\uAC8C \uBC15\uC218~![VAR 0114(003B)]",
  "\uB4F1\uACE8\uC774 \uC624\uC2F9\uD560 \uC815\uB3C4\uC758 \uC77C\uCCB4\uAC10!\\n\uBA54\uC778\uC744 \uBD80\uB97C \uC900\uBE44\uB294 Perfect\uD558\uAD70![VAR 0114(003B)]",
  "\uADF8\uB7FC, \uB2E4 \uAC19\uC774\\n\uC624\uB298\uC758 \uC8FC\uC778\uACF5\uC744 \uBD88\uB7EC \uBCF4\uC790\uACE0![VAR 0114(003B)]",
  "Come On!\\n\uC18C\uC6B8\uD480 \uBE44\uD2B8... \uB77C~\uC774\uC774\uC784!![VAR 0114(003B)]",
  "\uB77C\uC784! \uB77C\uC784! \uB77C\uC784!\\n\uB77C\uC784! \uB77C\uC784! \uB77C\uC784!",
  "\uC870\uC6A9!![VAR 0114(001B)]",
  "Hey People...[VAR 0114(001B)]",
  "\uC0D8\uC774 \uB0A0 \uC815\uB3C4\uB85C \uC0D8\uC19F\uB294 \uC774 \uC5F4\uAE30!\\n\uC2E0\uB098\uAC8C Party\uD560 \uC900\uBE44\uB294 Are You Ready!?[VAR 0114(001B)]",
  "\uC608~\uC2A4!! We Are Ready!!\\n\uB77C\uC784! \uB77C\uC784! \uB77C\uC784! \uB77C\uC784!",
  "\uBA4B\uC9C4 \uC624\uD504\uB2DD\uC774\uC5C8\uC5B4, Baby!\\n\uB0B4\uAC00 \uC654\uC73C\uB2C8 \uC774\uC81C \uB354 \uC7AC\uBC0C\uC5B4\uC9C8 \uAC70\uC57C![VAR 0114(001B)]",
  "\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uC218\uACE0 \uC218\uACE0!\\n\uB10C \uC9C4\uC9DC \uCD5C\uACE0 \uCD5C\uACE0\uC57C! Thank You![VAR 0114(003B)]",
  "\uB2F9\uBD84\uAC04\uC740 \uB77C\uC784 \uD0C0\uC784\uC774 \uACC4\uC18D\uB420 \uAC70\uB2C8\uAE4C\\n\uCCB4\uC721\uAD00 \uC811\uC218\uCC98\uC5D0 \uAC00\uC11C \uBCF4\uACE0\uD574 \uB46C.[VAR 0114(003B)]",
  "\uAD00\uAC1D\uB4E4\uC740 \uCCB4\uC721\uAD00 \uAD00\uC7A5\uC5D0 \uD479 \uBE60\uC838 \uC788\uB2E4!\\n...\uC811\uC218\uCC98\uC5D0 \uBCF4\uACE0\uD558\uC790!"
