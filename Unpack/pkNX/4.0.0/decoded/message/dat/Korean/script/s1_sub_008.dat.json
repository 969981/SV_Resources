[
  "\uC624~\uD638\uD638\uD638!\\n\uC624~\uD638\uD638\uD638![VAR 0114(0041)]",
  "\uB05D\uC5C6\uC774 \uD3BC\uCCD0\uC9C4 \uC21C\uBC31\uC758 \uC138\uC0C1\uC774\uB77C\uB2C8!\\n\uCD5C\uACE0\uB85C \uBA4B\uC9C4\uAC78![VAR 0114(0041)]",
  "\uADF8\uB7EC\uAC8C \uB9D0\uC774\uC57C!\\n\uC6B0\uB9AC \uB098\uB9AC\uC544\uAC00 \uB9C8\uB828\uD574 \uC900 \uC774 \uC637\uC744 \uC785\uC5C8\uB354\uB2C8\\r\\n\uD558\uB098\uB3C4 \uC548 \uCDA5\uACE0 \uB530\uB73B\uD558\uAE30\uAE4C\uC9C0 \uD558\uB2E4\uB2C8\uAE4C![VAR 0114(0040)]",
  "\uCD5C\uACE0\uAE09 \uC637\uAC10\uC744 \uC0AC\uC6A9\uD574\uC11C \uB9CC\uB4E0\\n\uCD5C\uACE0\uAE09 \uBE0C\uB79C\uB4DC\uB2C8\uAE4C \uB2F9\uC5F0\uD558\uC9C0![VAR 0114(0041)]",
  "\uC774 \uC637\uC744 \uC785\uC9C0 \uC54A\uACE0\\n\uB4F1\uC0B0\uD558\uB294 \uC0AC\uB78C\uC774 \uBD88\uC30D\uD558\uAC8C \uB290\uAEF4\uC9C8 \uC815\uB3C4\uC57C.[VAR 0114(0040)]",
  "\uC5B4\uBA38, \uB2F9\uC2E0\uC740...\\n\uC775\uC219\uD55C \uADF8 \uC11C\uBBFC\uB2D8![VAR 0114(0041)]",
  "\uC815\uB9D0\uC774\uAD70!\\n\uD2C0\uB9BC\uC5C6\uC774 \uC775\uC219\uD55C \uADF8 \uC11C\uBBFC\uC774\uC57C![VAR 0114(0040)]",
  "\uB098\uB9AC\uC544, \uBD10 \uBD10!\\n\uC774 \uC11C\uBBFC, \uC5C4\uCCAD\uB098\uAC8C \uC587\uC740 \uC637\uC744 \uC785\uACE0 \uC788\uC5B4![VAR 0114(0040)]",
  "\uC5B4\uBA38\uB098, \uC138\uC0C1\uC5D0!\\n\uC5B4\uCA5C \uC774\uB9AC\uB3C4 \uC587\uB514\uC587\uC740 \uC637\uAC10\uC774 \uB2E4 \uC788\uB2F4![VAR 0114(0041)]",
  "\uBE4C\uB9AC\uC624!\\n\uC11C\uBBFC\uB4E4\uC740 \uB2E4 \uCD94\uC704\uC5D0 \uAC15\uD55C \uAC70\uC57C?[VAR 0114(0041)]",
  "\uBAA8\uB974\uACA0\uC5B4... \uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC,\\n\uC11C\uBBFC\uB4E4 \uC0AC\uC774\uC5D0\uC11C\uB294 \uB3C8\uC774 \uC5C6\uB294 \uC0C1\uD669\uC744 \uBE57\uB300\uC5B4\\r\\n\uC8FC\uBA38\uB2C8\uAC00 \uC370\uB801\uD558\uB2E4\uACE0 \uD55C\uB2E4\uB098 \uBD10.[VAR 0114(0040)]",
  "\uADF8\uB7EC\uB2C8\uAE4C \uB2E4\uB4E4 \uCD94\uC704\uC5D0\\n\uC775\uC219\uD55C \uAC70 \uC544\uB2D0\uAE4C?[VAR 0114(0040)]",
  "\uBE4C\uB9AC\uC624, \uC790\uAE30\uB294 \uC815\uB9D0\uC774\uC9C0...[VAR 0114(0041)]",
  "\uB108\uBB34\uB098\uB3C4 \uB611\uB611\uD558\uB2E4\uB2C8\uAE4C!\\n\uC790, \uACE8\uB4E0 \uB098\uB9AC\uC544\uC0C1\uC744 \uC904\uAC8C![VAR 0114(0041)]",
  "\uADF8\uB808\uC774\uD2B8~![VAR 0114(0040)]",
  "\uACE4\uACBD\uC5D0 \uCC98\uD55C \uC11C\uBBFC\uC5D0\uAC8C \uC190\uC744 \uB0B4\uBBF8\uB294 \uAC83\uC774\\n\uC6B0\uB9AC \uC140\uB7FD\uB4E4\uC758 \uC758\uBB34...[VAR 0114(0041)]",
  "\uC774\uAC83\uC744 \uB4DC\uB9B4 \uD14C\uB2C8\\n\uD798\uB0B4\uC11C \uCD94\uC704\uB97C \uACAC\uB514\uB3C4\uB85D \uD558\uC138\uC694.[VAR 0114(0041)]",
  "\uC798 \uB4E4\uC73C\uC138\uC694, \uC11C\uBBFC\uB2D8.\\c\\n\u201C\uC190\uC774 \uCC28\uAC00\uC6B4 \uC0AC\uB78C\uC740 \uC2EC\uC7A5\uC774 \uB728\uAC81\uB2E4!\u201D\\n\uB77C\uB294 \uB9D0\uC740 \uBBF8\uC2E0\uC5D0 \uBD88\uACFC\uD558\uB2E4!![VAR 0114(0041)]",
  "\uC774 \uC0AC\uC2E4\uC744 \uC808\uB300 \uC78A\uC9C0 \uB9C8\uC138\uC694...[VAR 0114(0041)]",
  "\uC624~ \uC5ED\uC2DC \uB098\uC758 \uB098\uB9AC\uC544!\\n\uBA85\uC5B8\uC744 \uC810\uC810 \uB300\uCDA9 \uC9D3\uB294 \uAC83\uB3C4 \uB9E4\uB825\uC801\uC774\uB77C\uB2C8\uAE4C![VAR 0114(0040)]",
  "\uAC00\uC790, \uBE4C\uB9AC\uC624!\\n\uC6B0\uB9AC\uC758 \uD734\uAC00\uB3C4 \uC2AC\uC2AC \uB9C8\uC9C0\uB9C9\uC774\uB124...[VAR 0114(0041)]",
  "\uD53C\uB0A0\uB808\uB97C \uC704\uD574\\n\uD314\uB370\uC544\uC9C0\uBC29\uC758 [VAR FF00(0006)]\uD55C\uAC00\uC6B4\uB370[VAR FF00(0000)]\uB97C\\r\\n\uB0B4\uB824\uB2E4\uBCF4\uB7EC \uAC00\uACE0 \uC2F6\uC5B4\uC84C\uC5B4![VAR 0114(0041)]",
  "\uC720\uD6C4~! \uADF8\uB7F0 \uAD49\uC7A5\uD55C \uACF3\uC5D0 \uAC00\uC11C\uB3C4\\n\uC704\uC5D0\uC11C \uB0B4\uB824\uB2E4\uBCFC \uC0DD\uAC01\uC744 \uD558\uB2E4\uB2C8!\\r\\n\uC5ED\uC2DC \uC6B0\uB9AC \uB098\uB9AC\uC544\uB294 \uC140\uB7FD\uC758 \uADC0\uAC10\uC774\uB77C\uB2C8\uAE4C![VAR 0114(0040)]",
  "\uB300\uACF5 \uC548\uC5D0\uB294 \uB4E4\uC5B4\uAC00\uC9C0 \uBABB\uD560 \uC218\uB3C4 \uC788\uC9C0\uB9CC\\n\uC77C\uB2E8 \uB9AC\uADF8\uC5D0 \uC2E0\uCCAD\uD574 \uB458\uAC8C![VAR 0114(0040)]",
  "\uB098\uB9AC\uC544 \uB2D8\uACFC \uBE4C\uB9AC\uC624 \uB2D8\uAED8\uC11C\uB294\\n\uC800\uD76C \uD68C\uC0AC\uCC98\uB7FC \uD654\uC774\uD2B8\uD55C \uC0B0\uC73C\uB85C\\r\\n\uB4F1\uC0B0\uC744 \uAC00\uC168\uC2B5\uB2C8\uB2E4.",
  "...\uC800\uD76C \uD68C\uC0AC\uAC00 \uD654\uC774\uD2B8\uD55C\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC\\n\uC0C8\uD558\uC580 \uC0B0\uC774\uB77C\uACE0 \uD558\uBA74 \uB098\uD398\uC0B0\uC774 \uC720\uBA85\uD558\uC8E0."
]
