  "\uC2AC\uC2AC \uB2E4\uB4E4 \uC900\uBE44\uB410\uC73C\uB824\uB098!?\\n\uC820\uD2C0\uB9E8 \uC544\uC800\uC528~! \uC900\uBE44\uB410\uB098\uC694~!?[VAR 0114(0019)]",
  "\uC800\uB294 \uC5B8\uC81C\uB4E0\uC9C0 \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4~[VAR 0114(000A)]",
  "\uC6B0\uD788\uD788\uD788!\\n\uAD1C\uCC2E\uC740 \uBAA8\uC591\uC774\uB124![VAR 0114(0019)]",
  "\uC774 \uC601\uC0C1 \uC5B4\uB518\uAC00\uC5D0\\n\uC820\uD2C0\uB9E8 \uC544\uC800\uC528\uAC00 \uC228\uC5B4 \uC788\uC5B4![VAR 0114(0019)]",
  "\uB208\uC744 \uCF54\uC77C\uCC98\uB7FC \uD06C\uAC8C \uB728\uACE0\\n\uAF3C\uAF3C\uD558\uAC8C \uC798 \uCC3E\uC544 \uBD10~![VAR 0114(0019)]",
  "\uADF8\uB7FC, \uC900\uBE44\uD558\uC2DC\uACE0!\\n\uC2DC~\uC791![VAR 0114(0019)]",
  "...\uC74C?\\n\uB4E4\uCF1C \uBC84\uB838\uAD70\uC694.[VAR 0114(000A)]",
  "[VAR 0100(0000)][VAR 1900(0003)]\\n\uC820\uD2C0\uB9E8 \uC544\uC800\uC528\uB97C \uBC1C\uACAC![VAR 0114(0019)]",
  "\uD558\uC9C0~\uB9CC! \uD55C \uBC88\uC5D0 \uCC3E\uC544\uB0B4\uC9C0 \uBABB\uD55C\\n[VAR 0100(0000)][VAR 1900(0001)]...[VAR 0114(0019)]",
  "\uAD49\uC7A5\uD574! \uC5C4\uCCAD\uB098\uAC8C \uBA4B\uC838!\\c\\n\uACE0\uB7EC\uBA74~ \uB2E4\uC74C \uC228\uBC14\uAF2D\uC9C8\uC744 \uC900\uBE44\uD558\uB294 \uB3D9\uC548\\n\uC6B0\uB9AC\uC758 \uB3C4\uC804\uC790\uB2D8\uC740...[VAR 0114(0019)]",
  "\uBAA8\uC57C\uBAA8\uC758 \uD32C\uACFC \uBC30\uD2C0\uC744 \uD3BC\uCE58\uACA0\uC2B5\uB2C8\uB2E4~!\\n\uD3EC\uCF13\uBAAC \uB9E4\uB2C8\uC544, \uB098\uC624\uC138\uC694~![VAR 0114(0019)]",
  "\uBAA8\uC57C\uBAA8\uC57CTV\uC5EC, \uC601\uC6D0\uD558\uB77C!",
  "\uC2B9\uB9AC~!\\n\uBA4B\uC9C0\uB2E4~! \uC6B0\uB9AC \uB3C4\uC804\uC790\uB2D8~![VAR 0114(0019)]",
  "\uACE0\uB7EC\uBA74~\\n\uCE74\uBA54\uB77C\uB97C \uC804\uD658\uD560\uAC8C![VAR 0114(0019)]",
  "\uB2E4\uC74C \uBB34\uB300\uB294 \uC5EC\uAE30!\\n\uBAA8\uB450\uAC00 \uC88B\uC544\uD558\uB294 \uD3EC\uCF13\uBAAC\uC13C\uD130\uC785\uB2C8\uB2E4~![VAR 0114(0019)]",
  "\uC5EC\uAE30\uC5D0\uB3C4 \uC820\uD2C0\uB9E8 \uC544\uC800\uC528\uAC00 \uC228\uC5B4 \uC788\uC73C\uB2C8\uAE4C\\n\uC5F4\uC2EC\uD788 \uCC3E\uC544 \uBCF4\uB77C\uAD6C~![VAR 0114(0019)]",
  "...\uC74C? \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uB179\uC544\uB4E4\uC5C8\uB2E4\uACE0\\n\uC0DD\uAC01\uD588\uC2B5\uB2C8\uB2E4\uB9CC...[VAR 0114(000A)]",
  "\uC820\uD2C0\uB9E8 \uC544\uC800\uC528 \uBC1C\uACAC\uD558\uAE30, \uB450 \uBC88\uC9F8\uB3C4 \uC131\uACF5![VAR 0114(0019)]",
  "\uD558\uC9C0~\uB9CC! \uD55C \uBC88\uC5D0 \uCC3E\uC544\uB0B4\uC9C0 \uBABB\uD55C\\n[VAR 0100(0000)][VAR 1900(0001)]...[VAR 0114(0019)]",
  "\uC7A5\uD558\uB2E4! \uC5ED\uC2DC \uB300\uB2E8\uD574!\\c\\n\uACE0\uB7EC\uBA74~ \uB2E4\uC74C \uC228\uBC14\uAF2D\uC9C8\uC744 \uC900\uBE44\uD558\uB294 \uB3D9\uC548\\n\uC6B0\uB9AC\uC758 \uB3C4\uC804\uC790\uB2D8\uC740...[VAR 0114(0019)]",
  "\uB610\uB2E4\uC2DC \uBC30\uD2C0\uC744 \uD3BC\uCE58\uACA0\uC2B5\uB2C8\uB2E4~!\\n\uD3EC\uCF13\uBAAC \uB9E4\uB2C8\uC544, \uB098\uC624\uC138\uC694~![VAR 0114(0019)]",
  "\uBAA8\uC57C\uBAA8 \uB2D8\uAED8\uC11C \uBCF4\uACE0 \uACC4\uC154!\\n\uC9C0\uC9C0 \uC54A\uC744 \uAC70\uC57C!",
  "\uC2B9\uB9AC~!\\n\uBA4B\uC9C0\uB2E4~! \uC6B0\uB9AC \uB3C4\uC804\uC790\uB2D8~![VAR 0114(0019)]",
  "\uBC1C\uACAC\uD574 \uB0B4\uB294 \uC2E4\uB825\uB3C4\\n\uBC30\uD2C0 \uC2E4\uB825\uB3C4 \uC0AC\uB0E5\uAFBC \uBEA8\uCE58\uB294\uB370~!\\r\\n\uACE0\uB7EC\uBA74~ \uCE74\uBA54\uB77C\uB97C \uC804\uD658\uD560\uAC8C![VAR 0114(0019)]",
  "\uB9C8\uC9C0\uB9C9 \uBB34\uB300\uB294 \uC5EC\uAE30!\\n\uACA9\uC804\uC774 \uD3BC\uCCD0\uC9C0\uB294 \uBC30\uD2C0\uCF54\uD2B8![VAR 0114(0019)]",
  "\uACFC\uC5F0 \uC774 \uC778\uD30C \uC18D\uC5D0\uC11C\\n\uC820\uD2C0\uB9E8 \uC544\uC800\uC528\uB97C \uCC3E\uC544\uB0BC \uC218 \uC788\uC744 \uAC83\uC778\uAC00!?\\r\\n\uB9C8\uC9C0\uB9C9 \uC228\uBC14\uAF2D\uC9C8 \uC2DC\uC791~![VAR 0114(0019)]",
  "\uC774\uB7F4 \uC218\uAC00...\\n\uAD50\uC7A5\uC740 \uAC10\uB3D9\uD588\uC2B5\uB2C8\uB2E4...\\c\\n\uAD50\uC7A5\uBFD0\uB9CC \uC544\uB2C8\uB77C, \uC790\uC2E0\uB9CC\uC758 \uBCF4\uBB3C\uB3C4\\n\uC5F4\uC2EC\uD788 \uCC3E\uC544 \uBCF4\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4.[VAR 0114(000A)]",
  "\uC6B0\uD788...! [VAR 0100(0000)] \uB355\uBD84\uC5D0\\n\uAD6C\uB3C5\uC790 \uC218\uAC00 \uC800\uB9AC\uB354\uD504\uCC98\uB7FC \uCB49\uCB49...!!\\r\\n\uC544\uCC28, \uC774\uAC8C \uC544\uB2C8\uC9C0, \uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8 \uD074\uB9AC\uC5B4~![VAR 0114(0019)]",
  "\uC774\uC57C~ \uCE58\uC5F4\uD55C \uAC8C\uC784\uC5D0\\n\uC804 \uC138\uACC4 \uC0AC\uB78C\uB4E4\uC774 \uC544\uC8FC \uD765\uBD84\uC758 \uB3C4\uAC00\uB2C8\uC600\uC5B4![VAR 0114(0019)]",
