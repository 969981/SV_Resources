  "\uD76C\uADC0\uD55C \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC0C9\uC774 \uB2E4\uB978 \uD3EC\uCF13\uBAAC\uC740\\n\uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
  "\uC9C0\uB2CC \uD3EC\uCF13\uBAAC\uC774 1\uB9C8\uB9AC\uBC16\uC5D0 \uC5C6\uC796\uC544!\\n2\uB9C8\uB9AC \uC774\uC0C1\uC740 \uB370\uB9AC\uACE0 \uC788\uC5B4\uC57C \uD574.[VAR 0114(0013)]",
  "\uC9C0\uAE08 \uC774 \uCE60\uB9AC \uB2D8\uC744 \uC560\uD0DC\uC6B0\uAC8C \uD560 \uC148\uC774\uC57C?\\n\uB2E4\uB978 \uC0AC\uB78C\uC774\uB791 \uAD50\uD658\uD574 \uBC84\uB9B0\uB2E4~?[VAR 0114(0013)]",
