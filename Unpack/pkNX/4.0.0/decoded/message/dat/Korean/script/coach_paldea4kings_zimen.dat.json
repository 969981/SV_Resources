  "\uC758\uC678\uB124\uC694!",
  "\uBA4B\uC9C4 \uCF64\uBE44\uB124\uC694!",
  "\uC65C, \uADF8\uB54C\uB3C4 \uC774\uC0C1\uD55C \uB514\uC2A4\uD06C\uB97C\\n\uBE0C\uB77C\uC774\uC5B4\uB77C\uB294 \uC0AC\uB78C\uC5D0\uAC8C \uC8FC\uB294 \uAC78 \uAE5C\uBE61\uD588\uC796\uC544![VAR 0114(0013)]",
