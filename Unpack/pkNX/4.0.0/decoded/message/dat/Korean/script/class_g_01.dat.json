[
  "...\uC529\uC529\uD55C \uC544\uC774\uB4E4\uC774\uB85C\uAD70.[VAR 0114(002C)]",
  "\uB0B4 \uC774\uB984\uC740 \uC0AC\uAD6C\uC544\uB85C.\\c\\n\uC774 \uC2DC\uAC04\uC5D0\uB294 \uC0B4\uC544\uAC00\uB294 \uB370 \uD544\uC694\uD55C\\n\uC9C0\uC2DD\uACFC \uAE30\uC220\uC744 \uBC30\uC6B0\uAC8C \uB420 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uC774 \uC911\uC5D0\uB294 \uBD80\uBAA8\uB2D8\uC758 \uD488\uC744 \uB5A0\uB098\\n\uAE30\uC219\uC0AC\uC5D0\uC11C \uD640\uB85C \uC9C0\uB0B4\uB294 \uC0AC\uB78C\uC774 \uB9CE\uC73C\uB2C8,[VAR 0114(0029)]",
  "\uB0B4\uAC00 \uC804\uC218\uD574 \uC900 \uC9C0\uC2DD\uC744 \uD1B5\uD574\\n\uC81C\uAD70\uB4E4\uC758 \uC758\uC2DD\uC8FC\uAC00\\r\\n\uBCF4\uB2E4 \uB098\uC544\uC9C0\uAE38 \uBC14\uB780\uB2E4.[VAR 0114(0029)]",
  "\uADF8\uC911\uC5D0\uC11C \uB108\uD76C\uAC00 \uAC00\uC7A5 \uAD00\uC2EC\uC774 \uC788\uB294 \uAC74\\n\uC5ED\uC2DC \u201C\uC2DD\u201D\uC774\uACA0\uC9C0?[VAR 0114(0029)]",
  "\uD53C\uD06C\uB2C9\uC5D0\uC11C \uC0CC\uB4DC\uC704\uCE58\uB97C \uBA39\uC73C\uBA74\\n[VAR FF00(0006)]\uC2DD\uC0AC \uD30C\uC6CC[VAR FF00(0000)]\uB77C\uB294 \uAC83\uC774 \uC0DD\uACA8\uC11C\\r\\n\uB2E4\uC591\uD55C \uD6A8\uACFC\uB97C \uC5BB\uC744 \uC218 \uC788\uB2E4.[VAR 0114(0029)]",
  "\uCCB4\uB825\uC744 \uD68C\uBCF5\uD560 \uC218 \uC788\uC744 \uBFD0\uB9CC \uC544\uB2C8\uB77C\\n\uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC9C4\uB2E4\uAC70\uB098\\r\\n\uACBD\uD5D8\uCE58\uB97C \uB9CE\uC774 \uBC1B\uC744 \uC218\uB3C4 \uC788\uC9C0.[VAR 0114(0029)]",
  "\uB9DB\uC788\uB294 \uC0CC\uB4DC\uC704\uCE58\uB97C \uB9CC\uB4E4\uBA74\\n\uD55C\uCE35 \uB354 \uAC15\uD654\uB41C \uD6A8\uACFC\uB97C \uC5BB\uC744 \uC218 \uC788\uC744 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uADF8\uB9AC\uACE0, \uBCF4\uB2E4 \uC720\uC6A9\uD55C \uC2DD\uC0AC \uD30C\uC6CC\uB97C\\n\uC5BB\uAE30 \uC704\uD574\uC11C\uB294 \uC694\uB9AC\uB97C \uD560 \uB54C\\r\\n\uC5B4\uB5A4 \uAC83\uC774 \uC911\uC694\uD558\uAC8C \uC791\uC6A9\uD558\uB294\uB370...[VAR 0114(0029)]",
  "[VAR 0100(0000)]\uC5D0\uAC8C \uBB3B\uB3C4\uB85D \uD558\uC9C0.\\n\uB354 \uC88B\uC740 \uC2DD\uC0AC \uD30C\uC6CC\uB97C \uC5BB\uAE30 \uC704\uD574\\r\\n\uB108\uB77C\uBA74 \uBB34\uC5C7\uC744 \uC2E0\uACBD \uC4F8 \uAC70\uC9C0?[VAR 0114(0029)]",
  "\uC18D \uC7AC\uB8CC\uC640 \uC870\uBBF8\uB8CC",
  "\uC694\uB9AC\uD558\uB294 \uC18D\uB3C4",
  "\uC560\uC815\uC744 \uB2F4\uC558\uB294\uAC00",
  "\uD6CC\uB96D\uD55C \uB2F5\uBCC0\uC774\uC5C8\uB2E4, [VAR 0100(0000)].\\n\uC9D1\uC548\uC77C\uC744 \uB3C4\uC6B0\uBA74\uC11C\\r\\n\uC774\uBBF8 \uC774\uD574\uD558\uACE0 \uC788\uC5C8\uB098?[VAR 0114(0029)]",
  "...\uADF8\uAC74 \uD2C0\uB9B0 \uB2F5\uC774\uB2E4.\\n\uC18D\uB3C4\uB97C \uB0B4\uAE30\uBCF4\uB2E4\uB294 \uC815\uC131\uC744 \uB4E4\uC774\uB294 \uAC83\uC744\\r\\n\uB354 \uC911\uC694\uD558\uAC8C \uC5EC\uACBC\uC73C\uBA74 \uC88B\uACA0\uAD70.[VAR 0114(0029)]",
  "\uD6D7...! \uC7AC\uBBF8\uC788\uB294 \uB2F5\uBCC0\uC774\uAD70.\\n\uB0B4\uAC00 \uC6D0\uD558\uB294 \uB2F5\uC740 \uC544\uB2C8\uC5C8\uC9C0\uB9CC...\\r\\n\uC5B4\uB5A4 \uC758\uBBF8\uB85C \uC815\uB2F5\uC774\uB77C \uD560 \uC218 \uC788\uACA0\uC5B4.[VAR 0114(0029)]",
  "\uB354 \uC88B\uC740 \uC2DD\uC0AC \uD30C\uC6CC\uB97C \uC5BB\uAE30 \uC704\uD574\uC11C\uB294\\n\uC18D \uC7AC\uB8CC\uC640 \uC870\uBBF8\uB8CC... \uC27D\uAC8C \uB9D0\uD558\uC790\uBA74\\r\\n\uC2DD\uC7AC\uB8CC\uAC00 \uC911\uC694\uD55C \uAC83\uC774\uB2E4.[VAR 0114(0029)]",
  "\uC608\uB97C \uB4E4\uC5B4, \uB2E8\uB9DB\uC774 \uB098\uB294 \uC2DD\uC7AC\uB8CC\uB97C\\n\uB9CE\uC774 \uC0AC\uC6A9\uD558\uBA74 \uC54C \uD30C\uC6CC\uB97C \uC5BB\uAE30 \uC26C\uC6CC\uC9C0\uACE0...[VAR 0114(0029)]",
  "\uC4F4\uB9DB\uC774 \uB098\uB294 \uC2DD\uC7AC\uB8CC\uB97C \uB9CE\uC774 \uC0AC\uC6A9\uD558\uBA74\\n\uC720\uC2E4\uBB3C \uD30C\uC6CC\uB97C \uC5BB\uAE30 \uC26C\uC6CC\uC9C0\uB294 \uB4F1,[VAR 0114(0029)]",
  "\uC6D0\uD558\uB294 \uD6A8\uACFC\uB97C \uB178\uB9AC\uBA74\uC11C\\n\uC0CC\uB4DC\uC704\uCE58\uB97C \uB9CC\uB4E4\uB2E4 \uBCF4\uBA74\\r\\n\uC694\uB9AC\uAC00 \uD6E8\uC52C \uB354 \uC88B\uC544\uC9C8 \uAC70\uB2E4.\\c\\n\uB808\uC2A4\uD1A0\uB791\uC5D0\uC11C \uC2DD\uC0AC\uD558\uB294 \uAC83\uC73C\uB85C\uB3C4\\n\uC2DD\uC0AC \uD30C\uC6CC\uB97C \uC5BB\uC744 \uC218 \uC788\uC73C\uB2C8 \uCC38\uACE0\uD558\uB3C4\uB85D.[VAR 0114(0029)]",
  "...\uC81C\uAD70\uB4E4\uC774 \uC774\uB7F0 \uC9C0\uC2DD\uB4E4\uC744 \uC798 \uC775\uD600\uC11C\\n\uAC00\uC815 \uC218\uC5C5\uC744 \uC798 \uC774\uD574\uD558\uAC8C \uB41C\uB2E4\uBA74\\r\\n\uB0B4\uAC8C \uADF8 \uC774\uC0C1 \uAE30\uC05C \uAC83\uC740 \uC5C6\uC744 \uAC70\uB2E4.[VAR 0114(0029)]",
  "\uC624\uB298 \uC218\uC5C5\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4.\\n\uC774\uB9CC \uC2E4\uB840\uD558\uC9C0.[VAR 0114(0029)]"
]
