[
  "\uB204\uB8E9\uC2A4\uC2DC\uD2F0\uB294 \uC990\uAE30\uACE0 \uC788\uC5B4?\\n\uD558\uC774\uD14C\uD06C\uC640 \uBE44\uC988\uB2C8\uC2A4\uC758 \uB9C8\uC744\uC774\uC57C!",
  "\uC5EC\uAE30\uC11C\uBD80\uD130 \uBD81\uCABD\uC740 \uBA54\uC778 \uC2A4\uD2B8\uB9AC\uD2B8!\\c\\n\uC804\uAD11\uD310\uC73C\uB85C \uB458\uB7EC\uC2F8\uC778 \uAE38\uC740\\n\uB204\uB8E9\uC2A4\uC2DC\uD2F0\uC5D0\uC11C\uB9CC \uBCFC \uC218 \uC788\uB294 \uAD11\uACBD\uC774\uC9C0!",
  "\uC591\uB9D0\uC740 \uCC29\uC6A9\uAC10\uC774 \uACE7 \uC0DD\uBA85!\\n\uD56D\uC0C1 \uC2E0\uACE0 \uB2E4\uB140\uC57C \uD558\uB2C8\uAE4C!",
  "\uAC00\uBC29\uC740 \uBA4B\uC774 \uAC00\uC7A5 \uC911\uC694\uD574!\\n\uC218\uB0A9\uACF5\uAC04\uC740 \uADF8 \uB2E4\uC74C\uC774\uB77C\uACE0!",
  "\uC5EC\uAE30\uAC00 \uBC14\uB85C \uBAA8\uC57C\uBAA8 \uB2D8\uC758 \uCCB4\uC721\uAD00...\\n\uD56D\uC0C1 \uC601\uC0C1\uC73C\uB85C \uBD24\uC5C8\uB294\uB370, \uC644\uC804 \uAC10\uB3D9\uC774\uC57C!",
  "\uC800\uBC88 \uBAA8\uC57C\uBAA8\uC57CTV \uBD24\uC5B4?\\n\uB9AC\uD30C \uB2D8\uACFC \uD55C \uCF5C\uB77C\uBCF4 \uBC29\uC1A1, \uCD5C\uACE0\uC600\uC5B4!",
  "\uBAA8\uC57C\uBAA8 \uB2D8\uB3C4 \uC9C4\uC9DC \uADC0\uC5EC\uC6E0\uC5B4~!\\n\uC5ED\uC2DC \uAC00\uC7A5 \uC778\uAE30 \uC788\uB294 \uC2A4\uD2B8\uB9AC\uBA38\uC57C~",
  "\uB9C8\uC744 \uC548\uC5D0 \uC790\uC5F0\uC774 \uC788\uC73C\uBA74\\n\uC0AD\uB9C9\uD588\uB358 \uB9C8\uC74C\uB3C4 \uCE58\uC720\uB418\uB294 \uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0.",
  "\uB204\uB8E9\uC2A4\uC2DC\uD2F0\uC5D0 \uC0B4\uBA74\\n\uB9E4\uC77C \uAC10\uC131\uC744 \uC790\uADF9\uBC1B\uB294 \uAE30\uBD84\uC774\uB77C\uB2C8\uAE4C!",
  "\uC544~ \uB124, \uD558\uC774\uD37C\uBCFC \uB9D0\uC500\uC774\uC2DC\uC8E0?\\c\\n\uC288\uD37C\uBCFC\uBCF4\uB2E4 \uB6F0\uC5B4\uB098\uB2E4\uACE0 \uD558\uB2C8\uAE4C\\n300\uAC1C \uC815\uB3C4 \uBC1C\uC8FC\uD574 \uB450\uACA0\uC2B5\uB2C8\uB2E4!",
  "\uB098\uB3C4 \uC5B4\uB978\uC774 \uB418\uBA74\\n\uC778\uD50C\uB8E8\uC5B8\uC11C \uD560\uB798!",
  "\uC138\uC0C1\uC5D0\uB294 \uC815\uB9D0\\n\uB2E4\uC591\uD55C \uC77C\uB4E4\uC774 \uC874\uC7AC\uD558\uB294\uAD6C\uB098!",
  "\uC0CC\uB4DC\uC704\uCE58\uB97C \uB9CC\uB4E4\uB824\uACE0 \uD588\uB294\uB370\\n\uD53D\uC774 \uB2E4 \uB5A8\uC5B4\uC84C\uC9C0 \uBB50\uC57C!\\r\\n\uC5ED\uC2DC \uC18C\uBAA8\uD488\uC740 \uC794\uB729 \uC0AC \uB46C\uC57C \uD55C\uB2E4\uB2C8\uAE4C!",
  "\uCC38\uD478\uB974\uB9C8\uC744\uC758 \uBCF4\uBB3C\uC2DD\uB2F9\uB3C4 \uAC00 \uBCF4\uACE0 \uC2F6\uACE0,\\n\uCE74\uB77C\uD504\uC2DC\uD2F0\uC758 \uACE4\uD3EC\uAC01\uB3C4 \uAD1C\uCC2E\uC740 \uAC83 \uAC19\uACE0...\\r\\n\uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC \uBD80\uB97C\uAE4C?",
  "\uC870\uAE08 \uC774\uB530\uAC00 \uD3EC\uCF13\uBAAC \uC7A1\uC73C\uB7EC \uAC08 \uAC70\uB2C8\uAE4C\\n\uD3EC\uD68D \uD30C\uC6CC\uAC00 \uC19F\uC544\uB098\uB294\\r\\n\uC694\uB9AC\uB97C \uBA39\uC73C\uBA74 \uC88B\uC744 \uAC83 \uAC19\uC740\uB370~",
  "\uD3EC\uCF13\uBAAC\uC774 \uBC14\uB2E4 \uC704\uB97C \uB098\uB294\\n\uC21C\uAC04\uC744 \uC798 \uB178\uB824\uC11C... \uCC30\uCE75!",
  "\uC774 \uC544\uB798 \uBC30\uAC00 \uC788\uC5B4!\\n\uBC14\uB2E4 \uBC11\uBC14\uB2E5\uAE4C\uC9C0 \uAC00 \uBCF4\uACE0 \uC2F6\uB2E4~",
  "\uB204\uB8E9\uC2A4\uC2DC\uD2F0\uB294 \uAC10\uC2DC \uCE74\uBA54\uB77C\uAC00\\n\uC794\uB729 \uC788\uC5B4\uC11C \uCE58\uC548\uC774 \uBCF4\uC7A5\uB418\uC5B4 \uC788\uC9C0!\\c\\n\uC601\uC0C1\uC740 \uB204\uB8E9\uC2A4\uCCB4\uC721\uAD00\uC758\\n\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uC5D0 \uD65C\uC6A9\uB418\uACE0 \uC788\uB300.",
  "\uBCA0\uC774\uD06C\uB9C8\uC744\uC5D0\uC11C \uB3C4\uC790\uAE30 \uB9CC\uB4E4\uAE30 \uCCB4\uD5D8!\\n\uB2E4\uC74C \uD50C\uB79C\uC740 \uADF8\uAC78\uB85C \uC9C4\uD589\uD558\uC790!",
  "\uD3EC\uCF13\uBAAC \uC2B9\uBD80\uB294 \uC628\uB77C\uC778 \uC2A4\uD2B8\uB9AC\uBC0D\uB3C4 \uC88B\uC9C0\uB9CC,\\n\uB0B4 \uB208\uC73C\uB85C \uC9C1\uC811 \uBCF4\uACE0 \uC2F6\uC5B4!",
  "\uB77C\uC784\uC758 \uC2E0\uACE1\uC774 \uB098\uC654\uC5B4!\\n\uBE68\uB9AC \uB4E4\uC5B4 \uBD10\uC57C\uC9C0!",
  "\uB9AC\uD30C\uAC00 \uD504\uB85C\uB4C0\uC2A4\uD55C \uD55C\uC815 \uD654\uC7A5\uD488!\\n\uC804\uBD80 \uBA4B\uC838\uC11C \uBB58 \uC0AC\uC57C \uD560\uC9C0 \uACE0\uBBFC\uB3FC~!",
  "\uBE4C\uB529\uC774 \uB9D0\uB3C4 \uC548 \uB418\uAC8C \uD06C\uB124!\\n\uBCF4\uB2E4\uAC00 \uBAA9\uC774 \uC544\uD50C \uC9C0\uACBD\uC774\uC57C!",
  "\uB2E4\uC12F \uAC1C \uBAA8\uB450 \uBD80\uB3D9\uC0B0 \uD68C\uC0AC\uC778\\n\uD314\uB370\uC544 \uC5D0\uC2A4\uD14C\uC774\uD2B8\uC758 \uC18C\uC720\uB77C\uB098 \uBD10.",
  "\uB9C8\uC744\uC758 \uC804\uAE30\uB294 \uBE48\uB098\uB450\uB77C\uB294 \uD3EC\uCF13\uBAAC\uC774\\n\uC5F4\uC2EC\uD788 \uB9CC\uB4E4\uC5B4 \uB0B4\uACE0 \uC788\uC5B4!",
  "\uCD5C\uC560\uAC00! \uC804\uAD11\uD310\uC5D0!\\n\uB098\uC758 \uCD5C\uC560\uAC00! \uAC00\uB054\uC529\uC774\uC9C0\uB9CC \uB098\uC624\uACE0 \uC788\uC5B4!\\r\\n\uC544\uC544... \uCF5C\uC0AC \uB2D8...!!",
  "\uD55C\uBC88 \uC785\uC218\uD55C \uAE30\uC220\uBA38\uC2E0\uC740\\n\uAE30\uC220\uBA38\uC2E0\uBA38\uC2E0\uC73C\uB85C \uB354 \uB9CC\uB4E4 \uC218 \uC788\uC5B4\uC694.",
  "\uD30C\uB3C4\uD0C0\uAE30\uB97C \uD560 \uC218 \uC788\uB294\\n\uB77C\uC774\uB4DC\uD3EC\uCF13\uBAAC\uC774 \uC788\uC73C\uBA74\\r\\n\uBC14\uB2E4\uC5D0 \uB6F0\uC5B4\uB4E4\uC5B4\uB3C4 \uAD1C\uCC2E\uC744 \uD150\uB370.",
  "\uC5EC\uAE30\uB294 \uC61B\uB0A0\uC5D0 \uAD11\uC0B0\uC5D0\uC11C \uB098\uC628 \uAD11\uC11D\uC744\\n\uBC30\uB85C \uC6B4\uBC18\uD558\uB294 \uD56D\uAD6C \uB9C8\uC744\uC774\uC5C8\uC5B4!\\c\\n\uADF8\uB7AC\uB358 \uACF3\uC774 \uC9C0\uAE08\uC740 \uC774\uB807\uAC8C \uC5B4\uB9C8\uC5B4\uB9C8\uD55C\\n\uBE44\uC988\uB2C8\uC2A4 \uD5C8\uBE0C\uAC00 \uB418\uC5C8\uB2E4\uB2C8, \uB180\uB78D\uC9C0 \uC54A\uC544!?",
  "\uB204\uB8E9\uC2A4\uC2DC\uD2F0\uC758 \u201C\uB204\uB8E9\uC2A4\u201D\uB77C\uB294 \uAC74\\n\uC5B4\uB514\uC5D0\uC11C \uC628 \uB9D0\uC77C\uAE4C? \uB204\uB8E9?\\c\\n100\uB9CC\uBCFC\uD2B8\uC758 \uC57C\uACBD\uC774\uB77C\uACE0 \uBD88\uB9AC\uB294 \uAC78 \uBCF4\uBA74\\n\uC870\uB3C4\uB97C \uC138\uB294 \uB2E8\uC704\uC640\uB3C4 \uAD00\uB828\uC774 \uC788\uB294 \uAC78\uAE4C?",
  "\uC720\uBA85\uD55C \uBC15\uC0AC\uB2D8 \uC788\uC9C0 \uC54A\uC558\uC5B4?\\n\uC694\uC998 \uBBF8\uB514\uC5B4\uC5D0 \uC548 \uB098\uC624\uB294 \uAC83 \uAC19\uB124.",
  "\uD2F0\uC2A4\uD47C\uB9C8\uC744 \uADFC\uCC98\uC5D0 \uC788\uB294 \uB4F1\uB300 1\uCE35\uC744\\n\uC5F0\uAD6C\uC2E4\uB85C \uC4F0\uACE0 \uC788\uB2E4\uC9C0 \uC544\uB9C8?",
  "\uAC89\uBAA8\uC2B5\uC774 \uB2EC\uB77C\uC9C0\uBA74\\n\uAE30\uBD84\uB3C4 \uB2EC\uB77C\uC9C4\uB2E4!\\c\\n\uC5B4\uB5A4 \uC637\uC744 \uC785\uB290\uB0D0\uC5D0 \uB530\uB77C\\n\uADF8\uB0A0 \uD558\uB8E8\uAC00 \uB2EC\uB77C\uC9C8 \uAC70\uC57C.",
  "\uC0C1\uCC98\uC57D\uC740 \uC0C0\uACE0, \uC2DD\uC7AC\uB8CC\uB3C4 \uC0C0\uACE0...\\n\uBAAC\uC2A4\uD130\uBCFC\uB3C4 \uC0C0\uC5B4!\\r\\n\uC78A\uC5B4\uBC84\uB9B0 \uAC74 \uC5C6\uACA0\uC9C0?",
  "\uC5EC\uCC28\uD558\uBA74 \uACF5\uC911\uB0A0\uAE30\uD0DD\uC2DC\uB85C\\n\uD504\uB80C\uB4E4\uB9AC\uC20D\uAE4C\uC9C0 \uB0A0\uC544\uAC00\uC9C0 \uBB50!",
  "[~ 44]",
  "\uBAA8\uC57C\uBAA8\uB294 \uC774\uBBF8 \uC218\uB144 \uC804\uBD80\uD130\\n\uC2A4\uD2B8\uB9AC\uBC0D\uC744 \uD588\uC5C8\uC5B4.\\r\\n...\uB300\uCCB4 \uBA87 \uC0B4\uC778 \uAC78\uAE4C?",
  "\uB7ED\uC2DC\uC624\uC758 \uD138\uC774 \uCC38 \uBA4B\uC9C0\uC9C0 \uC54A\uB2C8!?\\c\\n\uC2B9\uBD80\uD558\uACE0 \uB098\uBA74 \uBC14\uB85C\uBC14\uB85C\\n\uD3EC\uCF13\uBAAC \uC6CC\uC2DC\uB85C \uC53B\uACA8 \uC8FC\uACE0 \uC788\uAC70\uB4E0!",
  "\uC5B8\uC820\uAC00 \uBD80\uC790\uAC00 \uB418\uBA74\\n\u201C\uC5EC\uAE30\uBD80\uD130 \uC5EC\uAE30\uAE4C\uC9C0 \uC804\uBD80 \uC8FC\uC138\uC694!\u201D\\r\\n\uB77C\uACE0 \uD574 \uBCF4\uACE0 \uC2F6\uC5B4!",
  "\uC6B0\uBB3C\uC6B0\uBB3C... \uC6B0\uBB3C\uC6B0\uBB3C...\\c\\n\uB204\uB8E9\uC2A4\uCCB4\uC721\uAD00\uC740 \uB3C4\uC804\uC790\uC758 \uBAA8\uC2B5\uC744\\n\uC778\uD130\uB137\uC73C\uB85C \uC0DD\uC911\uACC4\uD558\uACE0 \uC788\uC5B4.",
  "\uAFC0\uAEBD\uAFC0\uAEBD... \uAFC0\uAEBD\uAFC0\uAEBD...\\c\\n\uC5BC\uB9C8 \uC804\uC5D0 \uCCB4\uC721\uAD00 \uBC29\uC1A1\uC5D0 \uB098\uC628\\n\uB124\uBAA8\uB77C\uB294 \uC0AC\uB78C\uC758 \uD3EC\uCF13\uBAAC, \uC815\uB9D0 \uAD49\uC7A5\uD588\uC5B4!",
  "\uC544\uCE74\uB370\uBBF8\uC5D0\uB294\\n\uCC45\uC774 \uBB34\uC9C0\uBB34\uC9C0\uD558\uAC8C \uB9CE\uB300!\\c\\n\uC785\uD559\uD558\uBA74 \uC624\uCEEC\uCC98\uB97C \uC794\uB729 \uC77D\uC5B4\uC57C\uC9C0!",
  "\uC774 \uC55E\uC5D0 \uC788\uB294 \uB4F1\uB300\uC5D0\uC11C\\n\uB204\uB8E9\uC2A4\uC2DC\uD2F0\uB97C \uD55C\uB208\uC5D0 \uBCFC \uC218 \uC788\uC5B4.",
  "\uD48D\uACBD \uC0AC\uC9C4\uB3C4 \uC88B\uC9C0\uB9CC,\\n\uD56D\uC0C1 \uCD94\uC5B5\uC5D0 \uB0A8\uB294 \uAC74\\r\\n\uC0AC\uB78C\uC774\uB098 \uD3EC\uCF13\uBAAC\uC774 \uB098\uC624\uB294 \uC0AC\uC9C4\uC778 \uAC83 \uAC19\uC544."
]
