[
  "[~ 25]",
  "[VAR 0100(0000)] \uB2D8\\n\uCC38\uD478\uB974\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uCCAD\uBAA9 \uB2D8\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2E4 \uAC70\uBA74\\n\uBCF4\uBB3C\uC2DD\uB2F9 \uC810\uC6D0\uC5D0\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.",
  "[VAR 0100(0000)] \uB2D8, \uCC38\uD478\uB974\uCCB4\uC721\uAD00\uC744\\n\uC751\uC6D0\uD558\uB294 \uBCF4\uBB3C\uC2DD\uB2F9\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uBE44\uBC94\uD55C \uC0D0\uB7EC\uB9AC\uB9E8...\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uCCAD\uBAA9\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uADF8\uB7FC, \uBC30\uD2C0\uCF54\uD2B8\uB85C \uC62C\uB77C\uAC00\uC2DC\uC8E0.",
  "\uC900\uBE44\uAC00 \uB418\uC2DC\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.",
  "\uCCAD\uBAA9 \uC528~!\\n\uB098\uC624\uC138\uC694~!",
  "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C.[VAR 0114(002C)]",
  "\uC81C\uAC00 \uBC14\uB85C \uCC38\uD478\uB974\uCCB4\uC721\uAD00\uC5D0 \uBC30\uC18D\uB41C\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5, \uCCAD\uBAA9\uC785\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uCCB4\uC721\uAD00 \uD14C\uC2A4\uD2B8\uB97C \uD558\uC2DC\uB290\uB77C\\n\uC218\uACE0 \uB9CE\uC73C\uC168\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC5D0~ \uC0AC\uC2E4... \uC774 \uAC00\uAC8C\uB294\\n\uAD6C\uC6B4 \uC8FC\uBA39\uBC25 \uB9D0\uACE0 \uB2E4\uB978 \uBA54\uB274\uB3C4 \uB9DB\uC788\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uB108\uBB34 \uC7A1\uB2F4\uC774 \uAE38\uC5B4\uC9C0\uBA74\\n\uC0C1\uC0AC\uC5D0\uAC8C \uD63C\uB0A0 \uD14C\uB2C8\\r\\n\uC2AC\uC2AC \uC2B9\uBD80\uB97C \uC2DC\uC791\uD558\uC8E0.[VAR 0114(0015)]",
  "\uB2E4\uC2DC \uD55C\uBC88 \uC778\uC0AC\uB4DC\uB9AC\uC8E0. \uCCAD\uBAA9\uC785\uB2C8\uB2E4.\\n\uBAA8\uCABC\uB85D \uC798 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC608\uC0AC\uB86D\uC9C0 \uC54A\uC740 \uC2E4\uB825\uC774\uC2DC\uAD70\uC694.\\n\uC800\uB3C4 \uBAA8\uB974\uAC8C \uBB34\uD45C\uC815\uC774 \uB418\uC5B4 \uBC84\uB838\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uC800\uC758 \uD328\uBC30\uC774\uB2C8\\n\uBC30\uC9C0\uB97C \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4\uB9CC...[VAR 0114(0015)]",
  "...\uBC30\uD2C0\uC744 \uD588\uB354\uB2C8 \uBC30\uAC00 \uACE0\uD504\uAD70\uC694.\\n\uAD1C\uCC2E\uC73C\uC2DC\uB2E4\uBA74 \uAC19\uC774 \uB4DC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?[VAR 0114(0015)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C [VAR 0200(0001)]\uAC1C \uBAA8\uC73C\uC168\uC73C\uB2C8,\\n\uB808\uBCA8 [VAR 0201(0002)]\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0...\\r\\n\uB2F9\uC2E0\uC758 \uB9D0\uC744 \uC798 \uB4E4\uC744 \uAC81\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uBAA8\uC73C\uC168\uC73C\uB2C8,\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774\uB77C\uB3C4 \uC7A1\uC73C\uC2E4 \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4.\\r\\n\uC9C0\uC2DC\uB97C \uAC70\uC2A4\uB974\uB294 \uC77C\uB3C4 \uC5C6\uC744 \uAC70\uACE0\uC694.[VAR 0114(0015)]",
  "...\uC5EC\uAE30 \uC694\uB9AC\uB294\\n\uB9DB\uC5D0 \uAE4A\uC774\uAC00 \uC788\uACE0 \uC88B\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uB2F9\uC2E0\uCC98\uB7FC \uAE30\uC6B4\uC774 \uB118\uCE58\uB294 \uC544\uC774\uC5D0\uAC90\\n\uD544\uC694 \uC5C6\uC744 \uAC83 \uAC19\uC9C0\uB9CC, \uC774\uAC83\uB3C4 \uBC1B\uC544 \uC8FC\uC2DC\uC8E0.[VAR 0114(0015)]",
  "\uC74C\uC2DD\uAC12\uC740 \uC81C\uAC00 \uB0C8\uC2B5\uB2C8\uB2E4.\\n\uC774\uB798 \uBD2C\uB3C4 \uC5B4\uB978\uC774\uB2C8\uAE4C\uC694...[VAR 0114(0015)]",
  "\uADF8\uB7FC \uC774\uB9CC \uC2E4\uB840\uD558\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0015)]",
  "\uCC38\uD478\uB974\uCCB4\uC721\uAD00 \uD569\uACA9\uC744\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!",
  "\uC6B0\uC801\uC6B0\uC801...\\n\uC640\uAD6C\uC640\uAD6C...[VAR 0114(0015)]"
]
