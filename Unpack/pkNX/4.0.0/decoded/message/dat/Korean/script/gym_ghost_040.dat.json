[
  "[~ 40]",
  "[VAR 0100(0000)] \uB2D8\\n\uD504\uB9AC\uC9C0\uCCB4\uC721\uAD00\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!",
  "\uC18C\uC6B8\uD480 \uBE44\uD2B8...\\n\uCCB4\uC721\uAD00 \uAD00\uC7A5 \uB77C\uC784\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
  "\uADF8\uB7FC, \uBC30\uD2C0\uCF54\uD2B8\uB85C \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4.",
  "\uC900\uBE44\uAC00 \uB418\uC2DC\uBA74\\n\uC81C\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC8FC\uC138\uC694.",
  "\uB77C\uC784\uC5D0\uAC8C \uB3C4\uC804\uD558\uC2DC\uB824\uBA74 \uC2F8\uC6B8 \uC218 \uC788\uB294\\n\uD3EC\uCF13\uBAAC\uC774 \uB450 \uB9C8\uB9AC\uB294 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4!",
  "YO YO...!",
  "...\uBC30\uD2C0\uCF54\uD2B8\uC5D0\uC11C\\n\uB9AC\uB4DC\uBBF8\uCEEC\uD55C \uB9D0\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4!",
  "\uC624\uB298\uC5D0\uC57C\uB9D0\uB85C \uAEBE\uC5B4 \uC8FC\uC9C0 \uB108\uC640\uC758 \uB7A9 \uBC30\uD2C0\u266A\\n\uB108\uB294 \uACB0\uAD6D \uC4F0\uB7EC\uC9C0\uC9C0 \uB098\uD55C\uD14C \uBE44\uD2C0\uBE44\uD2C0\u266A",
  "\uB098\uC758 \uB7A9\uC744 \uC798 \uB4E4\uC5B4\uB77C, \uCCB4\uC721\uAD00 \uAD00\uC7A5\u266A\\n\uB098\uB294 \uB300\uBC15 \uAC00\uAC8C\uC758 \uC544\uB974\uBC14\uC774\uD2B8 \uB300\uC7A5\u266A",
  "\uB465\uB465 \uC704\uB07C\uC704\uB07C...\\n\uB465\uB465 \uC704\uB07C\uC704\uB07C...",
  "\uC54C\uBC14\uC5D0\uC120 \uB300\uC7A5?\u266A\\n\uB124 \uB77C\uC784 \uC218\uC900\uC740 \uD658\uC7A5\u266A\\r\\n\uC84C\uC73C\uBA74 \uC9D1\uC5D0\uB098 \uAC00, \uC9C0\uAE08 \uB2F9\uC7A5\u266A[VAR 0114(001B)]",
  "\uB0B4 \uC774\uB984\uC740 \uB77C\uC784\u266A \uC0C1\uB0E5\uD568 \uADF8\uAC8C \uBB50\uC784?\u266A\\n\uAC00\uCC28 \uC5C6\uC774 \uD130\uB728\uB9AC\uC9C0 Like a Dynamite\u266A[VAR 0114(001B)]",
  "\uB124 \uC54C\uBC14 \uC2E4\uB825 \uB0B4\uAC00 \uC54C \uBC14?\u266A\\n\uADF8\uB7F4 \uBC14\uC5D0 \uB7A9\uC774\uB098 \uB354 \uC5F4\uB819 Please!\u266A[VAR 0114(001B)]",
  "\uB465\uB465 \uC704\uB07C\uC704\uB07C...\\n\uB465\uB465 \uC704\uB07C\uC704\uB07C...",
  "\uC644\uD328, \uCC38\uD328, \uB0AD\uD328! \uB2E4\uC74C\uC5D0\uC57C\uB9D0\uB85C \uB9AC\uBCA4\uC9C0!\\n\uB05D\uB098\uACE0 \uBCF4\uC790 \uC0DD\uACC4\uC720\uC9C0~!",
  "\uAE30\uB2E4\uB824! \uB610 \uB3C4\uB9DD\uCE58\uB294 \uAC70\uC57C!?\\c\\n\uD558\uC544... \uC0DD\uACC4\uC720\uC9C0\uAC00 \uBB50\uC57C! \uC0DD\uACC4\uC720\uC9C0\uAC00!\\n\uBC14\uC774\uBE0C\uB3C4 \uC644\uC804 \uC81C\uBA4B\uB300\uB85C\uACE0![VAR 0114(001B)]",
  "\uD3EC\uAE30\uAC00 \uC774\uB9AC\uB3C4 \uBE60\uB974\uB2E4\uB2C8 \uCC38 \uC2AC\uD504\uB124!\\nMan~! \uB048\uAE30 \uC788\uB294 \uB140\uC11D \uC5B4\uB514 \uC5C6\uB098?[VAR 0114(001B)]",
  "...\uC74C?[VAR 0114(001B)]",
  "\uC6B0\uB9AC \uBC14\uB78C\uC7A1\uC774\uB2D8\uAED8\uC11C \uB2E4\uC74C \uC0C1\uB300\uC774\uC2E0\uAC00 \uBCF4\uB124?\\n\uCCB4\uC721\uAD00 \uBC30\uD2C0\uC774\uB791 \uB7A9 \uBC30\uD2C0, \uC5B4\uB290 \uCABD\uC774\uC57C?[VAR 0114(001B)]",
  "\uCCB4\uC721\uAD00 \uBC30\uD2C0\uC774\uC694!",
  "\uB7A9 \uBC30\uD2C0\uC774\uC694!",
  "\uADF8\uB798, \uB7A9\uC77C \uB9AC\uAC00 \uC5C6\uC9C0!\\n\uADF8\uB7F4 \uC904 \uC54C\uC558\uB2E4\uB2C8\uAE4C! HA! HA! HA![VAR 0114(001B)]",
  "HA! HA! \uB108\uC758 \uADF8 \uB300\uB2F5\\n\uC9C4\uB2F4\uC73C\uB85C \uB300\uB2F4\uD55C \uB18D\uB2F4\uC774\uC5C8\uC5B4![VAR 0114(001B)]",
  "...\uC751? \uB0B4\uAC00 \uB9D0\uC744\\n\uC774\uC0C1\uD558\uAC8C \uD558\uB294 \uAC83 \uAC19\uB2E4\uACE0?[VAR 0114(001B)]",
  "\uC774\uAC74 \uB7A9\uC774\uB77C\uB294 \uAC70\uC57C!\\c\\n\uC6B8\uB9BC\uC774 \uBE44\uC2B7\uD55C \uB9D0\uB4E4\uC744\\n\uC774\uC5B4 \uB9DE\uCD94\uB294 \uC601\uD63C\uC758 \uB178\uB798\uC9C0![VAR 0114(001B)]",
  "\uAE5C\uAE4C\uBBF8 \uC5EC\uD589\uD588\uC9C0, \uAC11\uC790\uAE30 \uBCBC\uB77D \uCE58\uC9C0\u266A\\n\uC0C1\uB2F9\uD788 \uB2F9\uD669\uD588\uC9C0, \uC554\uC6B8\uD55C \uB0A0\uC774\uC5C8\uC9C0\u266A\\r\\n...\uAC19\uC740 \uAC70 \uB9D0\uC774\uC57C! \uBB34\uC2A8 \uC18C\uB9B0\uC9C0 \uC54C\uACA0\uC5B4?[VAR 0114(001B)]",
  "\uBB50, \uB108\uB294 \uD3EC\uCF13\uBAAC \uD2B8\uB808\uC774\uB108\uB2C8\uAE4C!\\n\uB728\uAC70\uC6B4 \uC5F4\uC815\uC740 \uC2B9\uBD80\uC5D0\uC11C \uBCF4\uB3C4\uB85D \uD558\uACA0\uC5B4![VAR 0114(001B)]",
  "\uB0B4\uAC00 \uBCF8\uC5C5\uC740 \uB798\uD37C\uC774\uAE34 \uD558\uC9C0\uB9CC\\n\uACE0\uC2A4\uD2B8\uD3EC\uCF13\uBAAC\uC744 \uB2E4\uB8E8\uB294 \uC2E4\uB825\uC774\uB77C\uBA74\\r\\n\uB530\uB77C\uC62C \uC0AC\uB78C\uC774 \uC5C6\uAC70\uB4E0.[VAR 0114(001B)]",
  "\uB0B4 \uC774\uB984\uC740 \uB77C\uC784!\\na.k.a. \uC18C\uC6B8\uD480 \uBE44\uD2B8![VAR 0114(001B)]",
  "\uC9C0\uAE08\uBD80\uD130 \uB4E4\uC5B4 \uC8FC\uC9C0, \uB108\uC758 Vibe!\\n\uC774 Field\uC5D0\uC11C \uAC78\uACE0 \uC2F8\uC6CC, \uB108\uC758 Soul \u0026 Life!![VAR 0114(001B)]",
  "HA! HA! HA! \uC88B\uC740\uB370!\\n\uB108\uC758 \uC601\uD63C\uC774 \uC798 \uB290\uAEF4\uC84C\uC5B4![VAR 0114(001B)]",
  "\uB0B4\uAC00 \uD0C4\uC131\uC744 \uC9C0\uB974\uAC8C \uD558\uB2E4\uB2C8, \uB300\uB2E8\uD558\uC796\uC544!\\n\uC790! \uC774 \uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C \uBC1B\uC544 \uC918![VAR 0114(001B)]",
  "\uADF8\uB9AC\uACE0 \uB364\uC73C\uB85C, \uD2B9\uB4F1\uC11D\uC5D0\uC11C\\n\uB098\uC758 \uB77C\uC774\uBE0C\uB97C \uB4E4\uB824\uC904\uAC8C![VAR 0114(001B)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C [VAR 0200(0001)]\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uB808\uBCA8 [VAR 0201(0002)]\uAE4C\uC9C0\uC758 \uD3EC\uCF13\uBAAC\uC744 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E3\uAC8C \uB3FC![VAR 0114(001B)]",
  "\uCCB4\uC721\uAD00 \uBC30\uC9C0\uB97C 8\uAC1C \uAC00\uC9C0\uACE0 \uC788\uC73C\uBA74\\n\uC5B4\uB5A4 \uD3EC\uCF13\uBAAC\uC774\uB4E0 \uC7A1\uAE30 \uC26C\uC6CC\uC9C0\uACE0\\r\\n\uB108\uC758 \uB9D0\uB3C4 \uC798 \uB4E4\uC744 \uAC70\uC57C![VAR 0114(001B)]",
  "\uB7A9\uC73C\uB85C \uBAA8\uB450 \uD568\uAED8 \uD765\uBD84! \uC88B\uC544\uC9C0\uB294 \uAE30\uBD84!\\n\uC774\uAC74 \uB364\uC73C\uB85C \uC8FC\uB294 \uC120\uBB3C\uC774\uC57C![VAR 0114(001B)]",
  "\uB108\uC758 \uC18C\uB9AC\uB97C \uC870\uAE08 \uB354 \uB4E3\uACE0 \uC2F6\uC73C\uB2C8\uAE4C!\\n\uC77C\uC774 \uB2E4 \uB05D\uB098\uBA74 \uB610 \uC624\uB3C4\uB85D \uD574!\\r\\n\uB2E4\uC74C\uC5D0\uB294 \uB7A9 \uBC30\uD2C0\uB3C4 \uAD1C\uCC2E\uC73C\uB2C8\uAE4C \uB9D0\uC774\uC57C![VAR 0114(001B)]",
  "\uADF8\uB7FC, Nice\uD55C \uBAA8\uD5D8\uC774 \uC788\uAE30\uB97C \uC751\uC6D0\uD560\uAC8C.\\nBye Bye Baby~![VAR 0114(001B)]",
  "\uD504\uB9AC\uC9C0\uCCB4\uC721\uAD00 \uD569\uACA9\uC744\\n\uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!"
]
