[
  "\uC624\uB79C\uB9CC\uC774\uAD70, [VAR 0100(0000)].[VAR 0114(0029)]",
  "\uC790\uB124\uB3C4 \uC2DD\uC0AC\uD558\uB7EC \uC654\uB098?[VAR 0114(0029)]",
  "\uC2DD\uC0AC\uD558\uB7EC \uC654\uC5B4\uC694",
  "\uADF8\uB0E5 \uB4E4\uB7EC \uBD24\uC5B4\uC694",
  "\uD6D7, \uB9CE\uC774 \uBA39\uACE0\\n\uBAB8\uC744 \uD0A4\uC6B0\uB3C4\uB85D \uD574\uB77C.[VAR 0114(0029)]",
  "\uD5A5\uAE0B\uD55C \uB0C4\uC0C8\uC5D0\\n\uC774\uB04C\uB824 \uC654\uB098 \uBCF4\uAD70.[VAR 0114(0029)]",
  "\uB098\uB294...\\n\uD559\uC0DD\uC2DD\uB2F9\uC744 \uC2DC\uCC30\uD558\uB7EC \uC654\uB2E4\uACE0\uB098 \uD560\uAE4C?[VAR 0114(0029)]",
  "\uD559\uC0DD\uB4E4\uC774 \uD3C9\uC18C\uC5D0 \uC5B4\uB5A4 \uC601\uC591\uC18C\uB97C\\n\uC12D\uCDE8\uD558\uACE0 \uC788\uB294\uC9C0 \uD655\uC778\uD558\uACE0 \uC788\uC5C8\uB2E4.[VAR 0114(0029)]",
  "\uC2DD\uB2F9 \uBA54\uB274 \uC911\uC5D0\uC11C \uD2B9\uD788\\n\uB2EC\uCF64\uD558\uACE0 \uB9DB\uC788\uB294\\r\\n\uB545\uCF69\uBC84\uD130 \uC0CC\uB4DC\uC704\uCE58\uAC00 \uC2E0\uACBD \uC4F0\uC774\uB354\uAD70.[VAR 0114(0029)]",
  "\uADF8\uB7FC, \uD558\uB098 \uC8FC\uBB38\uD574 \uBCFC\uAE4C...[VAR 0114(0029)]",
  "\uC557! \uC0AC\uAD6C\uC544\uB85C \uC120\uC0DD\uB2D8\uC774\uB2E4!\\n\uC815\uB9D0 \uB304\uB514\uD558\uACE0 \uBA4B\uC838~!",
  "\uC120\uC0DD\uB2D8\uB3C4 \uC2DD\uB2F9\uC5D0 \uC624\uC2DC\uB294\uAD6C\uB098!\\n\uC5D0\uADF8 \uC0CC\uB4DC\uC704\uCE58\uB97C \uB4DC\uC2DC\uB824\uB098?",
  "\uC5D0\uC774~ \uC0AC\uAD6C\uC544\uB85C \uC120\uC0DD\uB2D8\uC774\uB77C\uBA74 \uB2F9\uC5F0\uD788\\n\uB9E4\uCF64~\uD55C \uC5B4\uB978\uC758 \uC0CC\uB4DC\uC704\uCE58\uC9C0!",
  "\uADF8\uB798! \uCFE8\uD55C \uC774\uBBF8\uC9C0\uC2DC\uB2C8\uAE4C!\\n\uBD84\uBA85\uD788 \uC5B4\uB978\uC758 \uC0CC\uB4DC\uC704\uCE58\uB97C \uB4DC\uC2E4 \uAC70\uC57C!",
  "......[VAR 0114(0029)]",
  "...\uC5B4, \uC5B4\uB978\uC758 \uC0CC\uB4DC\uC704\uCE58\uB85C\\n\uD558\uB098 \uBD80\uD0C1\uD558\uC9C0.[VAR 0114(0029)]",
  "\uC120\uC0DD\uB2D8!!",
  "\uB545\uCF69\uBC84\uD130 \uC0CC\uB4DC\uC704\uCE58!!",
  "\uC544, \uC544\uC544! [VAR 0100(0000)],\\n\uB545\uCF69\uBC84\uD130 \uC0CC\uB4DC\uC704\uCE58\uB97C \uCD94\uCC9C\uD558\uB294 \uAC74\uAC00?\\r\\n\uADF8\uB807\uB2E4\uBA74 \uADF8\uAC78\uB85C \uD558\uC9C0.[VAR 0114(0029)]",
  "\uD558\uB9C8\uD130\uBA74 \uBA39\uC9C0\uB3C4 \uBABB\uD558\uB294\\n\uB9E4\uC6B4 \uAC78 \uC8FC\uBB38\uD560 \uBED4\uD588\uAD70...[VAR 0114(0029)]",
  "[VAR 0100(0000)],\\n\uB098\uB97C \uB9C9\uC544 \uC918\uC11C \uACE0\uB9D9\uB2E4.[VAR 0114(0029)]",
  "\uC544\uBB34\uB798\uB3C4 \uB0B4\uAC00 \uB304\uB514\uD558\uB2E4\uB4E0\uC9C0,\\n\uB2A0\uB984\uD574 \uBCF4\uC778\uB2E4\uB4E0\uC9C0, \uCC28\uAC00\uC6CC \uBCF4\uC778\uB2E4\uB4E0\uC9C0,\\r\\n\uCFE8\uD558\uB2E4\uB294 \uC774\uC57C\uAE30\uB97C \uB9CE\uC774 \uB4E4\uC5B4\uC11C \uB9D0\uC774\uB2E4.[VAR 0114(0029)]",
  "\uB098\uB3C4 \uBAA8\uB974\uAC8C \uADF8\uB4E4\uC758 \uD658\uC0C1\uC744\\n\uAE68\uC9C0 \uC54A\uC73C\uB824 \uBB34\uB9AC\uD558\uAC8C \uB418\uB354\uAD70...[VAR 0114(0029)]",
  "\uB73B\uD558\uC9C0 \uC54A\uAC8C \uC790\uB124\uC5D0\uAC90\\n\uB0B4 \uBCF8\uC131\uC744 \uBCF4\uC774\uACE0 \uB9D0\uC558\uB2E4\uB9CC...\\r\\n\uB458\uB9CC\uC758 \uBE44\uBC00\uB85C \uD574 \uB2E4\uC624.[VAR 0114(0029)]",
  "\uC0AC\uAD6C\uC544\uB85C \uC120\uC0DD\uB2D8\uACFC\\n\uC870\uAE08 \uB354 \uCE5C\uD574\uC84C\uB2E4!"
