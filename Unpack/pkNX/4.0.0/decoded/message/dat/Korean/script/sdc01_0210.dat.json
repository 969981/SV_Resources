[
  "[VAR 0100(0000)]!\\n\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4\uAD6C!\\r\\n\uC57D\uC18D \uAC19\uC740 \uAC74 \uD55C \uC801 \uC5C6\uC9C0\uB9CC![VAR 0114(0044)]",
  "\uADF8\uAC8C...\\n\uB108\uD55C\uD14C \uBCFC\uC77C\uC774 \uC788\uC5B4\uC11C \uB9D0\uC774\uC57C.[VAR 0114(0044)]",
  "...\uC5B4\uC81C \uADF8 \uC77C \uB9D0\uC774\uC57C!\\n\uC544\uBB34\uD55C\uD14C\uB3C4 \uB9D0 \uC548 \uD588\uC9C0!?[VAR 0114(0044)]",
  "\uC548 \uD588\uC5B4",
  "\uBB34\uC2A8 \uC77C?",
  "\uC9C4\uC9DC\uC9C0~!?\\n\uAC70\uC9D3\uB9D0\uD558\uBA74\\r\\n\uB610\uAC00\uC2A4\uAC00 \uAFC0\uAEBD \uC0BC\uCF1C \uBC84\uB9B4 \uAC70\uC57C![VAR 0114(0044)]",
  "\uBB34\uC2A8 \uC77C\uC774\uB0D0\uB2C8, \uADF8 \uC77C \uC788\uC796\uC544!\\n\uB3C4\uAE68... \uB3C4\uB07C \uB4E0 \uB098\uBB34\uAFBC\uC774\uB791 \uB9CC\uB09C \uAC70 \uB9D0\uC774\uC57C!\\r\\n\uC73C\uC73C! \uB108, \uC758\uC678\uB85C \uC9D3\uAD82\uAD6C\uB098![VAR 0114(0044)]",
  "\uC544\uBB34\uD2BC, \uADF8\uB54C \uACC4\uB2E8\uC5D0\uC11C \uC8FC\uC6B4 \uAC70 \uAC00\uC9C0\uACE0 \uC788\uC9C0?[VAR 0114(0044)]",
  "\uC6B0\uB9AC \uD560\uC544\uBC84\uC9C0\uAC00\\n\uB9C8\uC744\uC758 \uC5ED\uC0AC\uC5D0 \uB300\uD574\uC11C \uC798 \uC544\uB2C8\uAE4C\\r\\n\uC5B4\uC81C \uC788\uC5C8\uB358 \uC77C\uC5D0 \uB300\uD574 \uBB3C\uC5B4\uBCF4\uB824\uACE0.[VAR 0114(0044)]",
  "\uC6B0\uB9AC \uC9D1\uC774 \uC5B4\uB518\uC9C0\uB294 \uC54C\uC9C0?\\n\uADF8\uB7FC, \uBE68\uB9AC \uC640![VAR 0114(0044)]",
  "\uD560\uC544\uBC84\uC9C0\uD55C\uD14C\\n\uADF8\uAC78 \uBCF4\uC5EC \uC8FC\uB294 \uAC70\uC57C.[VAR 0114(0044)]",
  "\uAC04\uD310\uC744 \uC544\uC9C1 \uD558\uB098\uBC16\uC5D0 \uBABB \uCC3E\uC558\uC5B4!\\n\uC2DC\uC720\uAC00 \uC5B4\uB514\uC5D0\uB3C4 \uC5C6\uB294 \uAC70 \uC788\uC9C0!\\r\\n\uADFC\uB370, \uADF8\uB7F0 \uC790\uC720\uBD84\uBC29\uD55C \uBAA8\uC2B5\uC774 \uB610...",
  "\uCE74\uC9C0\uB77C\uB294 \uC560 \uB9D0\uC774\uC57C. \uB0AF\uC744 \uB9CE\uC774 \uAC00\uB9AC\uB2C8?\\n\uB108\uD55C\uD14C\uB294 \uB9C8\uC74C\uC744 \uC5F0 \uAC83 \uAC19\uB358\uB370.",
  "\uCC0C\uB294 \uB4EF\uC774 \uB354\uC6B4 \uAC74 \uC544\uC9C1 \uD798\uB4E4\uC9C0\uB9CC,\\n\uBC8C\uB808\uD3EC\uCF13\uBAAC\uC5D0\uB294 \uC775\uC219\uD574\uC84C\uC5B4!",
  "\uAC00\uBA74 \uCD95\uC81C\uB294 \uB2F9\uBD84\uAC04 \uACC4\uC18D\uB418\uB2C8\\n\uB9C8\uC74C\uAECF \uC990\uAE30\uB3C4\uB85D \uD558\uC138\uC694![VAR 0114(0045)]"
]
