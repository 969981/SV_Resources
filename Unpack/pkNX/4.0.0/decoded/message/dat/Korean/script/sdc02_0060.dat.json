[
  "\uC5EC\uAE30\uAC00 \uBC14\uB85C \uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uAC00 \uC790\uB791\uD558\uB294\\n\uC138\uACC4\uC801\uC778 \uC218\uC911 \uC815\uC6D0...[VAR 0114(0049)]",
  "[VAR FF00(0006)]\uD14C\uB77C\uB9AC\uC6C0 \uB3D4[VAR FF00(0000)]\uC774\uC5D0\uC694![VAR 0114(0049)]",
  "\uBCBD\uACFC \uCC9C\uC7A5\uC744 \uD504\uB85C\uC81D\uD130\uAC00\\n\uBE44\uCD94\uACE0 \uC788\uC5B4\uC11C \uADF8\uB7F0\uC9C0, \uBC14\uB2F7\uC18D\uC5D0 \uC788\uB294\uB370\uB3C4\\r\\n\uB9C8\uCE58 \uBC16\uC5D0 \uC788\uB294 \uAC83 \uAC19\uC9C0 \uC54A\uB098\uC694?[VAR 0114(0049)]",
  "\uD3EC\uCF13\uBAAC\uC774 \uC9C0\uB0B4\uAE30 \uC801\uC808\uD55C \uD658\uACBD\uC744\\n\uC778\uACF5\uC801\uC73C\uB85C \uC870\uC131\uD55C \uACF3\uC774\uC5D0\uC694.[VAR 0114(0049)]",
  "\uC124\uACC4\uB294 \uB0B4\uAC00 \uC9C1\uC811 \uD588\uC9C0!\\n\uB3C8\uC774 \uC5C4\uCCAD\uB098\uAC8C \uB9CE\uC774 \uB4E4\uC5B4\uAC14\uB2E4\uACE0~[VAR 0114(004B)]",
  "\uB3D4 \uB0B4\uBD80\uB294 4\uAC1C\uC758\\n\uD658\uACBD \uC5D0\uB9AC\uC5B4\uB85C \uAD6C\uC131\uB418\uC5B4 \uC788\uC5B4\uC694...[VAR 0114(0049)]",
  "\uC6B0\uC120 \uC774\uCABD\uC740 \uC544\uC5F4\uB300 \uBD84\uC704\uAE30\uC758\\n\uC0AC\uBC14\uB098 \uC5D0\uB9AC\uC5B4.[VAR 0114(0049)]",
  "\uC624\uB978\uCABD\uC740 \uD2B8\uB85C\uD53C\uCEEC\uD55C \uBD84\uC704\uAE30\uC758\\n\uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4\uC608\uC694.[VAR 0114(0049)]",
  "\uC67C\uCABD\uC740 \uAC70\uCE5C \uACC4\uACE1 \uAC19\uC740 \uBD84\uC704\uAE30\uC758\\n\uCE90\uB2C8\uC5B8 \uC5D0\uB9AC\uC5B4\uACE0...[VAR 0114(0049)]",
  "\uAC00\uC7A5 \uC548\uCABD\uC5D0\uB294 \uC124\uAD6D \uBD84\uC704\uAE30\uC758\\n\uD3F4\uB77C \uC5D0\uB9AC\uC5B4\uAC00 \uC788\uC5B4\uC694.[VAR 0114(0049)]",
  "\uAE30\uC628\uACFC \uC2B5\uB3C4 \uB4F1\uC740 \uC5D0\uB9AC\uC5B4\uB9C8\uB2E4\\n\uC815\uBC00\uD558\uAC8C \uC124\uC815\uB418\uC5B4 \uC788\uC5B4\uC11C...[VAR 0114(0049)]",
  "\uC5D0\uB9AC\uC5B4\uAC00 \uBC14\uB00C\uBA74 \uC11C\uC2DD\uD558\uB294 \uD3EC\uCF13\uBAAC\uC774\\n\uD06C\uAC8C \uB2EC\uB77C\uC9C0\uAE30\uB3C4 \uD574\uC694![VAR 0114(0049)]",
  "\uACE0\uC2EC\uD55C \uD754\uC801\uC774 \uB290\uAEF4\uC9C0\uC9C0 \uC54A\uC544~?[VAR 0114(004B)]",
  "[VAR 0100(0000)] \uC528\uB294\\n\uC5B4\uB5A4 \uC5D0\uB9AC\uC5B4\uAC00 \uAC00\uC7A5 \uAD00\uC2EC \uC788\uC73C\uC138\uC694?[VAR 0114(0049)]",
  "\uC544\uC5F4\uB300 \uBD84\uC704\uAE30\uC758 \uC0AC\uBC14\uB098 \uC5D0\uB9AC\uC5B4",
  "\uD2B8\uB85C\uD53C\uCEEC\uD55C \uBD84\uC704\uAE30\uC758 \uCF54\uC2A4\uD2B8 \uC5D0\uB9AC\uC5B4",
  "\uACC4\uACE1 \uAC19\uC740 \uBD84\uC704\uAE30\uC758 \uCE90\uB2C8\uC5B8 \uC5D0\uB9AC\uC5B4",
  "\uC124\uAD6D \uBD84\uC704\uAE30\uC758 \uD3F4\uB77C \uC5D0\uB9AC\uC5B4",
  "\uAC00\uC7A5 \uC815\uC11D\uC801\uC778 \uACF3\uC774\uB124\uC694.\\c\\n\uC2DC\uC57C\uAC00 \uD0C1 \uD2B8\uC5EC \uC788\uC5B4\uC11C\\n\uD3EC\uCF13\uBAAC\uC758 \uC0DD\uD0DC\uB97C \uAD00\uCC30\uD558\uAE30\uB3C4 \uC88B\uC544\uC694![VAR 0114(0049)]",
  "\uD6C4\uD6C4, \uC800\uB791 \uD1B5\uD558\uB294 \uAC8C \uC788\uC73C\uC2DC\uB124\uC694!\\n\uC81C\uAC00 \uAC00\uC7A5 \uC88B\uC544\uD558\uB294 \uACF3\uC774\uAC70\uB4E0\uC694!\\r\\n\uB290\uAE0B\uD55C \uBD84\uC704\uAE30\uB77C \uB9C8\uC74C\uC774 \uD3B8\uD574\uC9C0\uB294 \uACF3\uC774\uC5D0\uC694![VAR 0114(0049)]",
  "\uAC70\uCE5C \uACF3\uC744 \uC88B\uC544\uD558\uC2DC\uB294\uAD70\uC694!\\c\\n\uC804\uAE30\uB3CC\uC774\uB77C\uB294 \uC2E0\uAE30\uD55C \uAD11\uC11D\uC774\\n\uC788\uB294 \uACF3\uC774\uAE30\uB3C4 \uD574\uC694![VAR 0114(0049)]",
  "\uCD94\uC6B4 \uACF3\uC744 \uC88B\uC544\uD558\uC2DC\uB294\uAD70\uC694!\\c\\n\uC800\uB294 \uADF8\uB2E4\uC9C0 \uC88B\uC544\uD558\uC9C0 \uC54A\uC9C0\uB9CC\\n\uC5BC\uC74C\uD3EC\uCF13\uBAAC\uC740 \uADC0\uC5FD\uB2E4\uACE0 \uC0DD\uAC01\uD574\uC694![VAR 0114(0049)]",
  "\uD3EC\uCF13\uBAAC\uC744 \uD68C\uBCF5\uC2DC\uD0A4\uACE0 \uC2F6\uC744 \uB54C\uB294\\n\uB3D4 \uB0B4\uBD80\uC5D0 \uC124\uCE58\uB418\uC5B4 \uC788\uB294\\r\\n[VAR FF00(0006)]\uC140\uD504 \uD68C\uBCF5 \uBA38\uC2E0[VAR FF00(0000)]\uC744 \uC774\uC6A9\uD574 \uC8FC\uC138\uC694![VAR 0114(0049)]",
  "\uADF8\uB7FC, \uC2DC\uC544\uB178 \uC120\uC0DD\uB2D8.[VAR 0114(0049)]",
  "\uBE14\uB8E8\uBCA0\uB9AC \uC544\uCE74\uB370\uBBF8\uC5D0\uC11C\\n\uC57C\uC0DD \uD3EC\uCF13\uBAAC\uC774 \uD14C\uB77C\uC2A4\uD0C8\uC744 \uD558\uACE0\\r\\n\uACB0\uC815\uC774 \uC0DD\uC131\uB418\uB294 \uC774\uC720\uB97C \uC124\uBA85\uD574 \uC8FC\uC2DC\uACA0\uC5B4\uC694?[VAR 0114(0049)]",
  "\uC751? \uC774\uBBF8 \uC54C\uACE0 \uC788\uC73C\uBA74\uC11C \uBB58...\\n\uC544\uC544! \uC774\uB7EC\uB824\uACE0 \uB4A4\uB85C \uBBF8\uB8EC \uAC70\uC600\uAD70.[VAR 0114(004B)]",
  "\uADF8 \uBE44\uBC00\uC740...\\n\uCC9C\uC7A5\uC744 \uBCF4\uC2DC\uB77C![VAR 0114(004B)]",
  "\uC800\uAC74 \uD14C\uB77C\uB9AC\uC6C0 \uB3D4\uC744 \uB0B4\uB824\uB2E4\uBCF4\uB294\\n[VAR FF00(0006)]\uD14C\uB77C\uB9AC\uC6C0 \uCF54\uC5B4[VAR FF00(0000)]![VAR 0114(004B)]",
  "\uC548\uC5D0\uB294 \uD314\uB370\uC544\uC5D0\uC11C \uCC44\uCDE8\uD55C\\n\uC5B4\uB5A4 \uBB3C\uC9C8\uC774 \uB179\uC544\uB4E0 \uC561\uCCB4\uAC00 \uB4E4\uC5B4 \uC788\uC9C0![VAR 0114(004B)]",
  "\uC800\uAC78 \uD1B5\uD574\uC11C \uD14C\uB77C\uC2A4\uD0C8 \uC5D0\uB108\uC9C0\uB97C\\n\uB0B4\uBCF4\uB0B4\uACE0 \uC788\uC5B4\uC11C\\r\\n\uB3D4\uC5D0\uC11C \uD14C\uB77C\uC2A4\uD0C8\uC744 \uD560 \uC218 \uC788\uB2E8 \uB9D0\uC500![VAR 0114(004B)]",
  "\uC6B0\uC640~! \uADF8\uB807\uAD6C\uB098~!\\n\uB300\uB2E8\uD558\uB2E4~![VAR 0114(0049)]",
  "\uADF8\uB7F0\uB370, \uD14C\uB77C\uB9AC\uC6C0 \uCF54\uC5B4 \uC548\uC5D0\uB294\\n\uC5B4\uB5A4 \uBB3C\uC9C8\uC774 \uB4E4\uC5B4 \uC788\uB294 \uAC70\uC608\uC694?\\r\\n\uC544\uC9C1 \uACF5\uAC1C\uB41C \uC815\uBCF4\uAC00 \uC544\uB2CC\uAC00\uC694...?[VAR 0114(0049)]",
  "\uD6C4\uD6C4\uD6C4, \uADF8\uAC74 \uB9D0\uC774\uC9C0...[VAR 0114(004B)]",
