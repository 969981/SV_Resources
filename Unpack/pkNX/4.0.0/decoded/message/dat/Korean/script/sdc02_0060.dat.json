  "\uB9C8\uCE68 \uC218\uC5C5\uC744 \uC2DC\uC791\uD558\uB098 \uBCF4\uB124\uC694![VAR 0114(0049)]",
  "[VAR 0100(0000)] \uC528, \uC774\uB807\uAC8C \uB41C \uAC70 \uC800\uB791 \uAC19\uC774\\n\uC800\uD76C \uD559\uAD50\uC5D0\uC11C\uC758 \uCCAB \uC218\uC5C5\uC744 \uB4E4\uC73C\uC2DC\uACA0\uC5B4\uC694?[VAR 0114(0049)]",
  "\uD5E4\uD5E4, \uACF5\uBD80\uC5D0 \uC801\uADF9\uC801\uC778 \uBAA8\uC2B5\uC774\\n\uBCF4\uAE30 \uC88B\uC740\uB370\uC694![VAR 0114(0049)]",
  "\uD639\uC2DC \uACF5\uBD80\uB97C \uC548 \uC88B\uC544\uD558\uC138\uC694?\\n\uADF8\uB807\uC9C0\uB9CC, \uBAA8\uCC98\uB7FC\uC758 \uAE30\uD68C\uB2C8\uAE4C \uAC19\uC774 \uB4E4\uC5B4\uC694!![VAR 0114(0049)]",
  "\uB3D4 \uB0B4\uBD80 \uC9C0\uB3C4\uB97C\\n\uC2A4\uB9C8\uD2B8\uB85C\uD1A0\uBB34\uC5D0 \uB4F1\uB85D\uD574 \uB4DC\uB9B4\uAC8C\uC694.[VAR 0114(0049)]",
