  "[~ 31]",
  "\uADF8\uB807\uAC8C \uB098\uC640\uC57C\uC9C0!\\n\uADF8\uB7FC, \uC2E4\uD5D8 \uC7A5\uC18C\uB85C \uC774\uB3D9\uD558\uC790![VAR 0114(004E)]",
