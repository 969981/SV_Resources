  "\uADF8\uB7FC \uC2DC\uC791\uD558\uC790~!\\n\uC2F1\uD06C\uB85C \uC2F1\uD06C\uB85C~![VAR 0114(004E)]",
  "\uB108\uB294 \uB2E4\uC2DC \uD3EC\uCF13\uBAAC\uACFC\\n\uB9C8\uC74C\uC744 \uC2F1\uD06C\uB85C\uD55C \uC0C1\uD0DC\uC57C![VAR 0114(004E)]",
  "\uC774\uBC88\uC774 \uB450 \uBC88\uC9F8 \uC2F1\uD06C\uB85C\uB2C8\uAE4C\\n\uB2E4\uC591\uD55C \uD589\uB3D9\uC744 \uD560 \uC218 \uC788\uC744 \uAC70\uC57C![VAR 0114(004E)]",
  "\uADF8\uB7FC, \uBC30\uD2C0 \uD14C\uC2A4\uD2B8 \uAC1C\uC2DC!\\n\uADF8 \uC0C1\uD0DC\uB85C \uD3EC\uCF13\uBAAC\uACFC \uBC30\uD2C0\uD574 \uBD10![VAR 0114(004E)]",
  "\uC73C\uC74C~!\\n\uB108\uC640 \uCD5C\uACE0\uB85C \uC2F1\uD06C\uAC00 \uC798 \uB9DE\uB294\uB370![VAR 0114(004E)]",
  "\uB108 \uC815\uB3C4 \uC778\uC7AC\uB77C\uBA74\\n\uC774 \uB300\uB2E8\uD55C \uBB3C\uAC74\uC744 \uAC00\uC9C8 \uC790\uACA9\uC774 \uC788\uC5B4![VAR 0114(004E)]",
  "\uC2DC\uC81C\uD488\uC774\uB77C \uC678\uD615\uC774 \uC870\uAE08...\\n\uADF8\uB807\uAE34 \uD558\uC9C0\uB9CC...[VAR 0114(004E)]",
