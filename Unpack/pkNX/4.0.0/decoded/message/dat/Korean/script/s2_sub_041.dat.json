  "\uC2F1\uD06C\uB85C \uC911\uC778 \uB3D9\uC548\uC5D0\uB294\\n\uB124\uAC00 \uC0DD\uAC01\uD558\uB294 \uB300\uB85C \uD3EC\uCF13\uBAAC\uC774 \uC6C0\uC9C1\uC77C \uAC70\uC57C![VAR 0114(004E)]",
  "\uBA3C\uC800 \uBCF4\uD589 \uD14C\uC2A4\uD2B8\uBD80\uD130 \uC2DC\uC791\uD574 \uBCFC\uAE4C!\\n\uC800\uCABD\uC5D0 \uC788\uB294 \uB098\uBB34\uAE4C\uC9C0 \uC774\uB3D9\uD574 \uBD10![VAR 0114(004E)]",
