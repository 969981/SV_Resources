[
  "\uD314\uC790\uD06C\uC785\uB2C8\uB2E4.\\n\uC624\uB298 \uC218\uC5C5\uB3C4 \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC9C0\uB09C \uC2DC\uAC04\uC5D0 \uD55C \uD14C\uB77C\uC2A4\uD0C8\uC5D0 \uAD00\uD55C \uC218\uC5C5\uC744\\n\uC88B\uAC8C \uBD10 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC6B4\uD5A5 \uC120\uC0DD\uB2D8\uAED8\uC11C\uB3C4\\n\uD559\uC0DD\uB4E4\uC5D0\uAC8C \uBC30\uD2C0\uC5D0 \uAD00\uD55C \uC9C0\uC2DD\uC744 \uC880 \uB354\\r\\n\uAC00\uB974\uCCD0 \uB2EC\uB77C\uACE0 \uBD80\uD0C1\uD558\uC2DC\uB354\uAD70\uC694...[VAR 0114(0012)]",
  "\uADF8\uB798\uC11C \uC774\uBC88 \uC2DC\uAC04\uC5D0\uB3C4\\n\uD14C\uB77C\uC2A4\uD0C8\uC5D0 \uB300\uD574 \uC54C\uC544\uBCF4\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uB760\uBE0C \uB760\uC774\uBE0C!",
  "\uC624\uB298\uB3C4 \uB525\uC0C1\uC5B4\uB3D9 \uC120\uBC30\uAC00 \uB3C4\uC640\uC904 \uAC81\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uADF8\uB7FC, \uB525\uC0C1\uC5B4\uB3D9 \uC120\uBC30\uB2D8.\\n\uD14C\uB77C\uC2A4\uD0C8\uC744 \uBD80\uD0C1\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uB760\uC774~\uBE0C!",
  "\uC790, \uC9C0\uB09C \uC2DC\uAC04\uC5D0\uB294\\n\uD480\uD0C0\uC785\uC73C\uB85C \uD14C\uB77C\uC2A4\uD0C8\uD588\uC5C8\uC2B5\uB2C8\uB2E4\uB9CC,\\r\\n\uC774\uBC88\uC5D0\uB294 \uD615\uD0DC\uAC00 \uB2E4\uB974\uC9C0\uC694?[VAR 0114(0012)]",
  "\uB9C8\uCE58 \uB208\uCC98\uB7FC \uC0DD\uAE34 \uD14C\uB77C\uC2A4\uD0C8 \uC8FC\uC5BC...\\n\uC5EC\uB7EC \uAC08\uB798\uB85C \uBED7\uC740 \uBAA8\uC2B5\uC774 \uC815\uB9D0 \uC544\uB984\uB2F5\uB124\uC694.[VAR 0114(0012)]",
  "\uAC00\uAE4C\uC774\uC5D0 \uC788\uC73C\uBA74\\n\uC0B4\uC9DD \uC11C\uB298\uD55C \uB290\uB08C\uB3C4 \uB4E4\uACE0\uC694.[VAR 0114(0012)]",
  "\uC790, \uC774 \uBAA8\uC2B5\uC758 \uD14C\uB77C\uC2A4\uD0C8 \uC8FC\uC5BC\uC740\\n\uC5B4\uB5A4 \uD0C0\uC785\uC744 \uB098\uD0C0\uB0B4\uB294 \uAC78\uAE4C\uC694?[VAR 0114(0012)]",
  "\uBB3C\uD0C0\uC785",
  "\uC5BC\uC74C\uD0C0\uC785",
  "\uACE0\uC2A4\uD2B8\uD0C0\uC785",
  "\uC544\uAE5D\uB124\uC694, [VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591!\\n\uBB3C\uC5D0\uC11C \uC0C1\uD0DC\uAC00 \uBCC0\uD55C \uD0C0\uC785\uC785\uB2C8\uB2E4![VAR 0114(0012)]",
  "[VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591!\\n100\uC810 \uB9CC\uC810\uC785\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uC544\uAE5D\uB124\uC694, [VAR 0100(0000)] [VAR 1100(00FF,0101)]\uAD70\uC591!\\n\uC11C\uB298\uD55C \uAC83\uC740 \uAC19\uC9C0\uB9CC, \uC0B4\uC9DD \uB2E4\uB978 \uD0C0\uC785\uC785\uB2C8\uB2E4![VAR 0114(0012)]",
  "\uADF8\uB807\uC2B5\uB2C8\uB2E4. \uB525\uC0C1\uC5B4\uB3D9 \uC120\uBC30\uC758 \uBA38\uB9AC \uC704\uC5D0\\n\uB208\uC758 \uACB0\uC815\uC774 \uBC18\uC9DD\uC774\uACE0 \uC788\uB294 \uAC83\uC740\\r\\n\uC5BC\uC74C\uD0C0\uC785\uC774 \uB418\uC5C8\uAE30 \uB54C\uBB38\uC785\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC9C0\uAE08 \uB525\uC0C1\uC5B4\uB3D9 \uC120\uBC30\uB294\\n\uC5BC\uC74C\uD0C0\uC785\uC774\uAE30 \uB54C\uBB38\uC5D0[VAR 0114(0012)]",
  "\uD3C9\uC18C\uC5D0\uB294 4\uBC30 \uC57D\uC810\uC778 \uC5BC\uC74C\uD0C0\uC785 \uAE30\uC220\uB3C4\\n\uD6A8\uACFC\uAC00 \uBCC4\uB85C\uC774\uAC8C \uB429\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uCC38\uACE0\uB85C, \uB208\uC758 \uACB0\uC815\uC758 \uD615\uD0DC\uB85C\uB294\\n\uB2E4\uC591\uD55C \uC885\uB958\uAC00 \uC788\uC2B5\uB2C8\uB2E4\uB9CC,\\r\\n\uB300\uBD80\uBD84\uC774 \uC721\uAC01\uD615\uC73C\uB85C \uBD84\uB958\uB429\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uB204\uAC00 \uC815\uD55C \uAC83\uB3C4 \uC544\uB2CC\uB370\\n\uB611\uAC19\uC740 \uD615\uD0DC\uB85C \uACA8\uC6B8 \uD558\uB298\uC5D0 \uD769\uB0A0\uB9AC\uB294 \uBAA8\uC2B5...[VAR 0114(0012)]",
  "\uC5EC\uB7EC\uBD84\uB3C4 \uC790\uC5F0\uC758 \uC2E0\uBE44\uB85C\uC6C0\uC774\\n\uB290\uAEF4\uC9C0\uC9C0 \uC54A\uC73C\uC2ED\uB2C8\uAE4C?[VAR 0114(0012)]",
  "...\uC5D0\uD5F4!\\c\\n\uAD00\uACC4\uC5C6\uB294 \uC774\uC57C\uAE30\uC9C0\uB9CC,\\n\uC9C0\uB2C8\uC5B4 \uC120\uC0DD\uB2D8\uC758 \uC548\uACBD\uB3C4 \uC721\uAC01\uD615\uC774\uB124\uC694.[VAR 0114(0012)]",
  "\uC54C\uB824 \uB4DC\uB9AC\uB294 \uAC83\uC744 \uAE5C\uBE61\uD588\uC2B5\uB2C8\uB2E4\uB9CC,\\n\uD3EC\uCF13\uBAAC\uC758 \uD14C\uB77C\uC2A4\uD0C8\uD0C0\uC785\uC740 \uCC38\uD478\uB974\uB9C8\uC744\uC758\\r\\n[VAR FF00(0006)]\uBCF4\uBB3C\uC2DD\uB2F9[VAR FF00(0000)]\uC5D0\uC11C \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uC8FC\uBC29\uC7A5\uC774 \uC601 \uAE4C\uB2E4\uB85C\uC6B4 \uBD84\uC774\uB77C\\n\uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uC73C\uBA74 \uD560 \uC218 \uC5C6\uC9C0\uB9CC \uB9D0\uC774\uC8E0...[VAR 0114(0012)]",
  "\uADF8\uB7FC, \uB2E4\uC74C \uC2DC\uAC04\uC5D0\uB294\\n\uC911\uAC04\uACE0\uC0AC\uB97C \uBCF4\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4!\\r\\n\uB525\uC0C1\uC5B4\uB3D9 \uC120\uBC30\uB2D8\uB3C4 \uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4.[VAR 0114(0012)]",
  "\uB760\uBE0C\uB9C1..."
