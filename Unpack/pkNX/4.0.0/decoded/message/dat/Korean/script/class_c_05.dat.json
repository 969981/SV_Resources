[
  "\uC548\uB155, \uC598\uB4E4\uC544?\\n\uB2E4\uB4E4 \uC5B4\uC81C\uBCF4\uB2E4 \uD558\uB8E8 \uC624\uB798\uB418\uC5C8\uAD6C\uB098.[VAR 0114(0027)]",
  "\uC624\uB298\uB3C4 \uC5ED\uC0AC\uC758 \uD6CC\uB96D\uD568\uC5D0 \uB300\uD574\\n\uD568\uAED8 \uC54C\uC544 \uAC00 \uBCF4\uB3C4\uB85D... \uD560\uAE4C \uD588\uB294\uB370\\r\\n\uB2E4\uB4E4 \uC2DC\uD5D8 \uBCF4\uB290\uB77C \uB10B\uC774 \uB098\uAC04 \uAC83 \uAC19\uB124.[VAR 0114(0027)]",
  "\uAC00\uB054\uC740 \uB178\uC120\uC744 \uBC14\uAFD4\uC11C\\n\uC7AC\uBBF8\uC788\uB294 \uC2DC\uAC04\uC744 \uAC00\uC9C0\uB294 \uAC83\uB3C4 \uC88B\uACA0\uC9C0?[VAR 0114(0027)]",
  "\uADF8\uB7EC\uB2C8\uAE4C \uC624\uB298\uC740 \uD314\uB370\uC544\uC5D0 \uC804\uD574 \uB0B4\uB824\uC624\uB294\\n\uC544\uC8FC \uBA3C~ \uC61B\uB0A0\uC758 \uB3D9\uD654\uB97C \uB4E4\uB824\uC904\uAC8C.[VAR 0114(0027)]",
  "\uC61B\uB0A0 \uC61B\uB0A0\uC5D0, \uBCF4\uBB3C\uC744 \uBAA8\uC73C\uB294 \uAC83\uC744\\n\uC544~\uC8FC \uC88B\uC544\uD558\uB294 \uC784\uAE08\uB2D8\uC774 \uC0B4\uACE0 \uC788\uC5C8\uC5B4\uC694.[VAR 0114(0027)]",
  "\uC5B4\uB290 \uB0A0, \uC784\uAE08\uB2D8\uC774 \uB2E4\uB978 \uB098\uB77C\uC758 \uBCF4\uBB3C\uC744\\n\uD2B9\uD788 \uC88B\uC544\uD55C\uB2E4\uB294 \uC18C\uBB38\uC744 \uB4E4\uC740 \uD55C \uC0C1\uC778\uC774,\\r\\n\uB3D9\uCABD \uB098\uB77C\uC5D0\uC11C \uCC3E\uC544\uC654\uC5B4\uC694.[VAR 0114(0027)]",
  "\uC0C1\uC778\uC740 \uB124 \uAC00\uC9C0 \uBCF4\uBB3C\uC744\\n\uC784\uAE08\uB2D8 \uC55E\uC5D0 \uB298\uC5B4\uB193\uC558\uC5B4\uC694.[VAR 0114(0027)]",
  "\uC0C1\uC778\uC774 \uB298\uC5B4\uB193\uC740 \uBCF4\uBB3C\uC740\\n\uADF8\uB987... \uAC80...\\r\\n\uBAA9\uAC04... \uADF8\uB9AC\uACE0 \uACE1\uC625...[VAR 0114(0027)]",
  "\uC9C4\uADC0\uD55C \uBCF4\uBB3C\uC744 \uB9C8\uC8FC\uD55C \uC784\uAE08\uB2D8\uC740\\n\uB6F8 \uB4EF\uC774 \uD06C\uAC8C \uAE30\uBED0\uD588\uC5B4\uC694.[VAR 0114(0027)]",
  "\uADF8\uB798\uC11C \uC218\uB9CE\uC740 \uAE08\uD654\uB97C \uC0C1\uC778\uC5D0\uAC8C \uC8FC\uACE0\\n4\uAC1C\uC758 \uBCF4\uBB3C\uC744 \uAC00\uC9C0\uAC8C \uB410\uB2F5\uB2C8\uB2E4.[VAR 0114(0027)]",
  "...\uADF8\uB7FC \uC5EC\uAE30\uC11C \uB098\uC640 \uB208\uC774 \uB9C8\uC8FC\uCE5C\\n\uBD88\uC30D\uD55C [VAR 0100(0000)]\uC5D0\uAC8C \uC9C8\uBB38 \uD558\uB098 \uD560\uAE4C?[VAR 0114(0027)]",
  "4\uAC1C\uC758 \uBCF4\uBB3C \uC911,\\n\uBAA9\uAC04\uC774\uB780 \uC5B4\uB5A4 \uBB3C\uAC74\uC774\uC9C0?[VAR 0114(0027)]",
  "\uB098\uBB34\uD310",
  "\uC545\uAE30",
  "\uC9C0\uD321\uC774",
  "...\uC815\uB2F5!\\n\uD3C9\uC18C\uC5D0 \uC5EC\uB7EC \uC9C0\uC2DD\uC744 \uD0D0\uAD6C\uD558\uB294 \uBAA8\uC591\uC774\uB124?[VAR 0114(0027)]",
  "...\uB561!\\n\uC124\uB9C8 \uC624\uB974\uAC04\uC774\uB791 \uD5F7\uAC08\uB838\uB2E4\uB294\\r\\n\uB18D\uB2F4\uC744 \uD558\uB824\uB358 \uAC74 \uC544\uB2C8\uC9C0?[VAR 0114(0027)]",
  "...\uB561!\\n\uC124\uB9C8 \uBAA9\uBC1C\uC774\uB791 \uD5F7\uAC08\uB838\uB2E4\uB294\\r\\n\uB18D\uB2F4\uC744 \uD558\uB824\uB358 \uAC74 \uC544\uB2C8\uC9C0?[VAR 0114(0027)]",
  "\uBAA9\uAC04\uC774\uB77C\uB294 \uAC83\uC740 \uACE0\uB300\uC758 \uB3D9\uCABD \uB098\uB77C\uC5D0\uC11C\\n\uAE00\uC744 \uAE30\uB85D\uD558\uAE30 \uC704\uD574 \uC0AC\uC6A9\uD588\uB358 \uB098\uBB34\uD310\uC774\uC57C.[VAR 0114(0027)]",
  "\uB2E4\uB4E4 \uC54C\uB2E4\uC2DC\uD53C,\\n\uBAA9\uAC04\uC740 \uC885\uC774\uAC00 \uB110\uB9AC \uBCF4\uAE09\uB418\uBA74\uC11C\\r\\n\uC810\uC810 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uAC8C \uB418\uC5C8\uC9C0.[VAR 0114(0027)]",
  "\uC885\uC774 \uB300\uC2E0 \uC0AC\uC6A9\uD558\uB358 \uB098\uBB34\uD310\uC774 \uBCF4\uBB3C\uC774\uB77C\uB2C8,\\n\uC5B4\uC9C0\uAC04\uD788 \uB300\uB2E8\uD55C \uBB3C\uAC74\uCC98\uB7FC \uBCF4\uC600\uB358 \uAC78\uAE4C?\\r\\n\uAD49\uC7A5\uD55C \uAC00\uB974\uCE68\uC774 \uC801\uD600 \uC788\uB358 \uAC78\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4.[VAR 0114(0027)]",
  "\uC774\uC57C\uAE30\uB97C \uB9C8\uC800 \uD560\uAC8C.\\n\uC784\uAE08\uB2D8\uC774 \uBCF4\uBB3C\uC744 \uC190\uC5D0 \uB123\uC740 \uADF8\uB0A0 \uBC24...[VAR 0114(0027)]",
  "\uB054\uCC0D\uD55C \uC7AC\uC559\uC774 \uB4E4\uC774\uB2E5\uCCD0\uC11C, \uC784\uAE08\uB2D8\uC758 \uC131\uC740\\n\uD558\uB8FB\uBC24 \uC0AC\uC774\uC5D0 \uBB34\uB108\uC9C0\uACE0 \uB9D0\uC558\uB300...[VAR 0114(0027)]",
  "\uC5B4\uB77C? \uC544\uC9C1 \uC548 \uB05D\uB0AC\uB294\uB370...\\n\uC2DC\uAC04 \uCC38 \uBE60\uB974\uB124.[VAR 0114(0027)]",
  "\uB4B7\uC774\uC57C\uAE30\uAC00 \uAD81\uAE08\uD55C \uC0AC\uB78C\uC740,\\n\uB098\uC911\uC5D0 \uB530\uB85C \uC120\uC0DD\uB2D8\uD55C\uD14C \uC624\uB3C4\uB85D \uD558\uB834.[VAR 0114(0027)]"
]
