  "\uB4E3\uC790 \uD558\uB2C8, \uC2A4\uD0C0\uB2E8\uC740 \uC544\uC9C0\uD2B8\uC5D0\uC11C\\n\uC544\uCE74\uB370\uBBF8\uB97C \uC2B5\uACA9\uD560 \uACC4\uD68D\uC744 \uC138\uC6B0\uACE0 \uC788\uB2E4\uB358\uB370.[VAR 0114(001E)]",
  "\uADF8\uB534 \uC18C\uBB38\uB3C4 \uC788\uB294 \uAC70\uC57C?\\n\uC61B\uB0A0\uC774\uB791 \uD558\uB098\uB3C4 \uC548 \uBCC0\uD588\uB124.\\r\\n\uC9C4\uC9DC \uC5B4\uCC98\uAD6C\uB2C8\uC5C6\uB294 \uB140\uC11D\uB4E4\uC774\uB77C\uB2C8\uAE4C...[VAR 0114(001F)]",
  "[~ 64]",
  "\uC870\uAE08 \uC804\uAE4C\uC9C0 \uAC1C\uC870\uB41C \uCC28\uB7C9\uC744 \uD0C0\uACE0\\n\uB3CC\uC544\uB2E4\uB2C8\uB358 \uAC74 \uBB50\uC9C0...?[VAR 0114(001E)]",
