  "...\uC774\uB7F0 \uC774\uB7F0,\\n\uB2A6\uC9C0 \uC54A\uC740 \uAC83 \uAC19\uAD70.[VAR 0114(001F)]",
  "\uBA5C\uB9AC, \uC5B4\uC11C \uC640![VAR 0114(0022)]",
  "...\uCE74\uB974\uBCF8,\\n\uBA87 \uB9C8\uB9AC \uC815\uB3C4 \uC9C4\uD654\uC2DC\uCF1C \uC654\uB2E4\uACE0.[VAR 0114(001F)]",
  "\uC774\uAC78\uB85C \uD30C\uC6CC \uBD80\uC871\uC740 \uC5B4\uB5BB\uAC8C\uB4E0 \uB420 \uD14C\uB2C8\uAE4C\\n\uC2A4\uD0C0\uBAA8\uBE4C\uB3C4 \uC6C0\uC9C1\uC77C \uAC70\uC57C.[VAR 0114(001F)]",
  "\uC798\uB41C \uC77C\uC774\uC9C0 \uC54A\uC18C\uC774\uAE4C! \uC624\uB974\uD2F0\uAC00 \uB098\uB9AC.[VAR 0114(0023)]",
  "\uC785\uB9CC \uC0B0 \uAC74 \uC544\uB2C8\uC5C8\uB124...[VAR 0114(0020)]",
  "\uC2DC\uB044\uB7EC! \uB108\uB294 \uADF8 \uC785\uC774 \uBB38\uC81C\uC57C!\\n\uADF8\uB7F0 \uC810\uC774 \uC9DC\uC99D \uB098\uB294 \uAC70\uB77C\uACE0![VAR 0114(001F)]",
  "\uADF8\uAC74 \uBA5C\uB85C\uCF54\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC796\uC544...[VAR 0114(0020)]",
  "\uB9D0\uD22C\uB3C4 \uD0DC\uB3C4\uB3C4 \uBD88\uB7C9\uD558\uB2C8\uAE4C\\n\uC560\uB4E4\uC774 \uC2EB\uC5B4\uD558\uB294 \uAC70 \uC544\uB2C8\uC57C?[VAR 0114(0020)]",
  "\uADF8\uAC83 \uB54C\uBB38\uC774 \uC544\uB2C8\uC57C, \uD2F0\uAC00.[VAR 0114(0022)]",
  "\uBA5C\uB9AC\uB294 \uADC0\uC5FD\uAC8C \uC0DD\uACBC\uB2E4\uB294 \uC774\uC720\uB85C\\n\uC9C8\uD22C\uD558\uB294 \uC560\uB4E4\uC5D0\uAC8C \uB2F9\uD55C \uAC83 \uB54C\uBB38\uC5D0\\r\\n\uC77C\uBD80\uB7EC \uD241\uBA85\uC2A4\uB7FD\uACE0 \uBD88\uB7C9\uD558\uAC8C \uAD6C\uB294 \uAC70\uC57C.[VAR 0114(0022)]",
  "\uC74C~ \uADF8\uAC83 \uB54C\uBB38\uC5D0 \uC2EB\uC5B4\uD558\uB294 \uC560\uB4E4\uC774\\n\uC788\uB294 \uAC83\uB3C4 \uB9DE\uAE34 \uD558\uC9C0\uB9CC...[VAR 0114(0022)]",
  "\uC544\uC73C~ \uBE44\uD30C \uC5B8\uB2C8!\\n\uADF8 \uC598\uAE30\uB294 \uADF8\uB9CC \uC880 \uD574![VAR 0114(001F)]",
  "\uADF8\uB798, \uC774\uC57C\uAE30\uB294 \uC774\uCBE4 \uD558\uC790.\\n\uC2AC\uC2AC \uC2DC\uC791\uD560 \uC2DC\uAC04\uC774\uB2C8\uAE4C.[VAR 0114(0021)]",
  "\uB4DC\uB514\uC5B4 \uC2DC\uC791\uC774\uAD6C\uB098, \uC2A4\uD0C0 \uB300\uC791\uC804...[VAR 0114(0022)]",
  "\uADF8\uAC74 \uADF8\uB807\uACE0, \uC9C4 \uBCF4\uC2A4 \uB098\uB9AC\uC758 \uACC4\uD68D\uC740\\n\uC81C\uB300\uB85C \uC9C4\uD589\uB418\uACE0 \uC788\uC18C?[VAR 0114(0023)]",
  "\uADF8\uB798, \uAC00\uD574\uC790\uB4E4\uC744 \uBAA8\uB450\\n\uC6B4\uB3D9\uC7A5\uC73C\uB85C \uBD88\uB7EC\uB0C8\uB300.[VAR 0114(0021)]",
  "\uB4DC\uB514\uC5B4 \uB54C\uAC00 \uB41C \uAC74\uAC00...!\\n\uD0C0\uC624\uB978\uB2E4... \uD65C\uD65C \uD0C0\uC62C\uB77C![VAR 0114(001F)]",
  "\uADF8\uB807\uAC8C \uD0C0\uC624\uB974\uACE0 \uD0C0\uC624\uB974\uB2E4...\\n\uC644\uC804\uD788 \uC5F0\uC18C\uD574 \uBC84\uB9B0 \uAC74\uAC00...[VAR 0114(001F)]",
  "...\uC5EC\uAE30\uAE4C\uC9C0\uAD70.[VAR 0114(001F)]",
  "\uB108\uC758 [VAR 0101(0001)],\\n\uC9C4\uC9DC \uAE30\uD569\uC774 \uB300\uB2E8\uD558\uB354\uB77C.[VAR 0114(001F)]",
  "\uC774 \uB2E8 \uBC30\uC9C0\uB294 \uB098\uB97C \uC774\uAE34 \uC99D\uD45C\uC57C!\\n\uB2F9\uB2F9\uD558\uAC8C \uAC00\uC838\uAC00\uB77C\uACE0.[VAR 0114(001F)]",
  "\uC774\uC81C \uC544\uBB34\uB798\uB3C4 \uC88B\uC73C\uB2C8\uAE4C\\n\uC774 \uAE30\uC220\uBA38\uC2E0\uB3C4 \uAC00\uC838\uAC00.[VAR 0114(001F)]",
