[
  "...\uADF8\uB7EC\uBA74 \uC870\uAE08 \uC774\uB530\\n\uD53C\uC544\uB178 \uB808\uC2A8 \uC2DC\uAC04\uC5D0 \uB2E4\uC2DC \uBD59\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(002C)]",
