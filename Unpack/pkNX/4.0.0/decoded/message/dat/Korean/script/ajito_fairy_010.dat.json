  "\uBAA8\uB974\uACA0\uB294\uB370\uC694",
  "\uC774\uB7F0...[VAR 0114(003C)]",
  "\uC544\uC2DC\uB294\uC9C0 \uBAA8\uB974\uACA0\uC9C0\uB9CC,\\n\uC774\uACF3\uC740 \uC800\uD76C \uC624\uB974\uD2F0\uAC00 \uB3C4\uB828\uB2D8\uC774 \uB2E4\uC2A4\uB9AC\uB294\\r\\n\uD398\uC5B4\uB9AC \uAD70\uB2E8, \uD300 \uB8E8\uD06C\uBC14\uC758 \uC544\uC9C0\uD2B8\uC785\uB2C8\uB2E4.[VAR 0114(003C)]",
  "\uC557, \uC800\uAE30...\\n\uADF8\uAC70\uB97C \uBA4B\uB300\uB85C \uAC00\uB974\uCCD0 \uC8FC\uC2DC\uBA74...[VAR 0114(002F)]",
  "\uC548 \uB418\uB294 \uAC70\uC600\uB098\uC694?\\n\uC774\uAC70 \uD06C\uAC8C \uC2E4\uB840\uD588\uAD70\uC694.[VAR 0114(003C)]",
  "\uC774 \uBD84\uC740 \uC544\uB294 \uBD84\uC774\uC2E0\uC9C0\uC694.[VAR 0114(003C)]",
  "\uC544\uB9C8 \uC6B0\uB9AC\uC758 \uC801\uC77C \uAC81\uB2C8\uB2E4![VAR 0114(002F)]",
  "\uADF8\uB807\uAD70\uC694... \uADF8\uB807\uB2E4\uB294 \uAC83\uC740\\n\uB3C4\uB828\uB2D8\uC758 \uC801\uC774\uB77C\uACE0\uB3C4 \uBCF4\uBA74 \uB429\uB2C8\uAE4C?[VAR 0114(003C)]",
  "\uB9DE\uC544\uC694!",
  "\uADF8\uB807\uAC8C \uB420\uAC78\uC694...?",
  "\uD750\uC74C, \uADF8\uB807\uAD70\uC694...\\n\uADF8\uB807\uB2E4\uBA74...[VAR 0114(003C)]",
  "\uC751...?[VAR 0114(002F)]",
  "\uC800\uC640 \uD55C\uBC88\\n\uC2E4\uB825\uC744 \uACA8\uB904 \uC8FC\uC2E4 \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?[VAR 0114(003C)]",
  "\uC900\uBE44\uAC00 \uD544\uC694\uD558\uC2E0\uAC00 \uBCF4\uAD70\uC694.\\n\uADF8\uB807\uB2E4\uBA74 \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(003C)]",
  "\uADF8\uB7FC, \uC2DC\uC791\uD558\uC2DC\uC9C0\uC694.[VAR 0114(003C)]",
  "...\uD6CC\uB96D\uD558\uC2DC\uAD70\uC694.[VAR 0114(003C)]",
  "\uC800\uC758 \uC8FC\uC778 \uC624\uB974\uD2F0\uAC00 \uB3C4\uB828\uB2D8\uC740\\n\uC800\uBCF4\uB2E4 \uC2E4\uB825\uC774 \uB6F0\uC5B4\uB09C \uBD84\uC774\uC2DC\uB2C8\\r\\n\uC870\uC2EC\uD558\uC2ED\uC2DC\uC624.[VAR 0114(003C)]",
  "\uADF8\uB7FC, \uC2E4\uB840\uD558\uACA0\uC2B5\uB2C8\uB2E4.[VAR 0114(003C)]",
  "\uC218, \uC218\uACE0\uD558\uC168\uC2A4\uD0C0...[VAR 0114(002F)]",
  "\uBC29\uAE08 \uADF8 \uC2E0\uC0AC\uBD84\uC740 \uC544\uCE74\uB370\uBBF8\uC758\\n\uC804\uC784 \uAD50\uC7A5\uC774\uB77C\uB294 \uAC83 \uAC19\uC740\uB370\\r\\n\uC9C0\uAE08\uC740 \uBCF4\uC2A4\uC758 \uAD50\uC721 \uB2F4\uB2F9\uC774\uB77C\uB294 \uBAA8\uC591\uC774\uB77C\\r\\n\uAC00\uB054 \uBCF4\uC2A4\uB97C \uB9CC\uB098\uB7EC \uC624\uACE4 \uD574...[VAR 0114(002F)]",
  "...\uC774\uB7F0 \uB9D0\uC774\uB098\\n\uD558\uACE0 \uC788\uC744 \uB54C\uAC00 \uC544\uB2C8\uC5C8\uC9C0![VAR 0114(002F)]",
  "\uB124\uAC00 \uC801\uC774\uB77C\uB294 \uAC83\uC740 \uD655\uC778\uD588\uC73C\uB2C8\uAE4C\\n\uB098\uB294 \uC774\uB9CC \uBCF4\uACE0\uD558\uB7EC \uAC00 \uBCF4\uACA0\uC5B4![VAR 0114(002F)]",
  "\uC218\uACE0\uD558\uC168\uC2A4\uD0C0~![VAR 0114(002F)]"
