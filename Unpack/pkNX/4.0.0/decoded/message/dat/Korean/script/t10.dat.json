[
  "\uC5EC\uAE30\uB294 \uC2A4\uC774\uB85D\uB9C8\uC744\uC774\uC57C.\\n\uC790\uC5F0\uACFC \uC0AC\uACFC\uAC00 \uBA85\uBB3C\uC774\uC9C0.",
  "\uC790\uC5F0 \uD559\uAD50\uB97C \uD558\uB7EC \uD574\uC678\uC5D0\uC11C \uC654\uB2E4\uBA70?\\n\uC5B4\uCA50\uC9C0 \uBABB \uBCF4\uB358 \uC5BC\uAD74\uC774\uB354\uB77C\uB2C8!",
  "\uCD95\uC81C \uC900\uBE44\uB294 \uC798 \uB418\uACE0 \uC788\uC5B4?\\n\uBB3C\uAC74\uC774 \uB2A6\uC5B4\uC9C0\uACE0 \uC788\uC5B4\uC11C \uB9D0\uC774\uC57C...",
  "\uC694\uC998 \uB9E4\uC77C \uC9D1\uC5D0\uC11C\\n\uBCF6\uC74C\uAD6D\uC218 \uB9CC\uB4DC\uB294 \uAC83\uB9CC \uC5F0\uC2B5\uD558\uACE0 \uC788\uC5B4.",
  "\uB3C4\uCC9C\uC0C1\uC810\uC740 \uC815\uB9D0 \uD3B8\uB9AC\uD558\uB2E4\uAD6C!\\n\uB3C4\uAD6C\uB294 \uBB3C\uB860\uC774\uACE0\\c\\n\uC8FC\uC778 \uD560\uBA38\uB2C8\uAC00 \uC9C1\uC811 \uC9E0\\n\uB530\uB73B\uD55C \uC591\uB9D0\uB3C4 \uD314\uACE0 \uC788\uAC70\uB4E0!",
  "\uC774 \uC55E\uC744 \uCB49 \uC62C\uB77C\uAC00\uBA74 \uBD81\uC2E0\uC13C\uD130\uC57C!\\n\uB098\uB984 \uC0B0\uAE38\uC774\uB2C8\uAE4C \uD798\uB0B4\uC11C \uAC00 \uBCF4\uB834!",
  "\uBC1C\uCC59\uC774\uC758 \uBC30!\\n\uBCF4\uACE0 \uC788\uC73C\uBA74 \uB208\uC774 \uBE59\uBE59 \uB3C4\uB294 \uAC83 \uAC19\uC544~!",
  "\uC2DC\uC720\uC640 \uCE74\uC9C0\uB294\\n\uD574\uC678\uC5D0 \uC788\uB294 \uC544\uCE74\uB370\uBBF8\uC5D0 \uC785\uD559\uD588\uB2E4\uC9C0?",
  "\uC2DC\uB044\uB7EC\uC6B4 \uB0A8\uB9E4\uAC00 \uB3CC\uC544\uC654\uB2E4\uBA70?",
  "\uB17C\uC5D0 \uC2EC\uC740 \uBCBC\uAC00 \uC775\uC73C\uBA74\\n\uADF8\uAC78\uB85C \uB77C\uC774\uC2A4\uB97C \uB9CC\uB4E4 \uC218 \uC788\uB2E8\uB2E4!",
  "\uB77C\uC774\uC2A4\uB97C \uC0CC\uB4DC\uC704\uCE58\uC5D0 \uB07C\uC6CC \uB123\uB294\uB2E4\uACE0!?\\n\uBD81\uC2E0\uC5D0\uC11C\uB294 \uB4E3\uB3C4 \uBCF4\uB3C4 \uBABB\uD55C \uBC29\uBC95\uC774\uC57C!",
  "\uC774 \uB9C8\uC744\uC5D0\uB294 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC796\uC544?\\n\uADF8\uAC8C \uBC14\uB85C \uC7A5\uC810\uC778 \uAC70\uC57C.",
  "\uC5EC\uAE30\uB294 \uC2A4\uC774\uB85D\uB9C8\uC744.\\n\uAC00\uBA74 \uCD95\uC81C\uB85C \uC720\uBA85\uD558\uC9C0!",
  "\uCCAD\uB144\uD68C \uC0AC\uB78C\uB4E4\uC774 \uC990\uAC70\uC6B4 \uCD95\uC81C\uB97C \uB9CC\uB4E4\uB824\uACE0\\n\uC5F4\uC2EC\uD788 \uC900\uBE44\uD588\uC73C\uB2C8\uAE4C, \uC7AC\uBBF8\uC788\uAC8C \uC990\uAE30\uB834!",
  "\uBD81\uC2E0\uC13C\uD130\uC5D0\uC11C\\n\uC138\uBC97\uB2D8\uC744 \uBD24\uC5B4!!\\r\\n\uBD81\uC2E0\uB5A1\uC744 \uC794\uB729 \uB4DC\uC2DC\uB358\uB370!!",
  "\uC624\uAC70\uD3F0 \uB2D8\uACFC \uCE5C\uD574\uC9C4\\n\uC544\uC774\uAC00 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4!\\r\\n...\uD639\uC2DC \uCE74\uC9C0\uB824\uB098?",
  "\uB098\uB294 \uC870\uD0C0\uAD6C \uB2D8\uC774 \uC88B\uC544!\\n\uCD08\uB85D\uC0C9\uC778 \uAC8C \uB9C8\uC74C\uC5D0 \uB4E4\uAC70\uB4E0!",
  "\uC870\uD0C0\uAD6C \uB2D8\uC744 \uBD24\uB294\uB370\\n\uC2E4\uBB3C\uC740 \uAC00\uBA74\uB9CC\uD07C \uCD08\uB85D\uC0C9\uC774 \uC544\uB2C8\uC5C8\uC5B4!!",
  "\uC624\uAC70\uD3F0 \uB2D8\uC740 \uAC00\uBA74\uB3C4 \uC2E4\uBB3C\uB3C4\\n\uCD08\uB85D\uC0C9\uC774\uB77C\uC11C \uC88B\uC544!",
  "\uACFC\uC77C \uC0AC\uD0D5 \uAC00\uAC8C\uC5D0\uC11C \uD30C\uB294 \uC0AC\uACFC \uC0AC\uD0D5!\\c\\n\uC560\uD50C \uD790\uC2A4\uC5D0\uC11C \uAC13 \uC218\uD655\uD55C \uC0AC\uACFC\uB97C\\n\uD1B5\uC73C\uB85C \uC0AC\uC6A9\uD558\uACE0 \uC788\uC5B4!",
  "\uB2E4\uB4E4 \uAC00\uBA74\uC744 \uC4F0\uACE0 \uB2E4\uB140\uC11C\\n\uAC00\uBA74 \uCD95\uC81C\uB77C\uACE0 \uBD80\uB974\uB294 \uAC78\uAE4C...?",
