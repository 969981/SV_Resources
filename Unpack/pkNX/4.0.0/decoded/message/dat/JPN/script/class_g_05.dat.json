[
  "{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3000\u30B9\u30DE\u30DB\u3092\u3000\u3057\u307E\u3044\u305F\u307E\u3048\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u3088\u3046[VAR 0114(0029)]",
  "{\u4E2D\u9593\u8A66\u9A13|\u3061\u3085\u3046\u304B\u3093\u3057\u3051\u3093}\u306F\u3000{\u4F55\u5EA6|\u306A\u3093\u3069}\u3082\\n{\u8FFD\u8A66|\u3064\u3044\u3057}\u3092\u3000{\u53D7|\u3046}\u3051\u305F{\u8005|\u3082\u306E}\u304C\u3000\u3044\u305F\u304C\\r\\n\u304A\u304A\u3080\u306D\u3000{\u5408\u683C|\u3054\u3046\u304B\u304F}\u3067\u3000\u304A\u3081\u3067\u305F\u3044[VAR 0114(0029)]",
  "{\u751F|\u3044}\u304D\u3066\u3044\u304F\u3046\u3048\u3067\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306A{\u77E5\u8B58|\u3061\u3057\u304D}\\n{\u6280\u80FD|\u304E\u306E\u3046}\u304C\u3000{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3089\u306B\u3000{\u606F|\u3044\u304D}\u3065\u3044\u3066\u3044\u308B\u3053\u3068\\r\\n\u30EF\u30AC\u30CF\u30A4\u306F\u3000{\u5149\u6804|\u3053\u3046\u3048\u3044}\u306B\u3000{\u601D|\u304A\u3082}\u3046[VAR 0114(0029)]",
  "{\u5F8C\u671F|\u3053\u3046\u304D}\u3082\u3000\u307F\u3063\u3061\u308A\u3068\\n{\u751F|\u3044}\u304D\u308B{\u8853|\u3059\u3079}\u3092\u3000\u307F\u304C\u3044\u3066\u304F\u308C\u305F\u307E\u3048[VAR 0114(0029)]",
  "\u3055\u3066\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u306B\u3064\u3044\u3066\\n{\u4E00\u90E8|\u3044\u3061\u3076}\u306E{\u751F\u5F92|\u305B\u3044\u3068}\u304B\u3089\u3000{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u304C\u3000\u3042\u3063\u305F[VAR 0114(0029)]",
  "{\u8CEA\u554F\u8005|\u3057\u3064\u3082\u3093\u3057\u3083}\u306F\\n{\u6599\u7406\u597D|\u308A\u3087\u3046\u308A\u305A}\u304D\u306A\u3000{\u7537\u5B50\u751F\u5F92|\u3060\u3093\u3057\u305B\u3044\u3068}[VAR 0114(0029)]",
  "{\u5F7C|\u304B\u308C}\u306F\u3000\u3044\u3064\u3082\u3000\uFF11{\u4EBA|\u308A}\u3067\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306E{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u3092\u3000\u3057\u3066\u3044\u308B\u305D\u3046\u3067[VAR 0114(0029)]",
  "{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u306B\u3000\u3053\u3060\u308F\u308A\\n{\u65E5\u591C|\u306B\u3061\u3084}\u3000{\u8ABF\u7406\u6CD5|\u3061\u3087\u3046\u308A\u307B\u3046}\u3092\u3000{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u3057\u3066\u3044\u305F\u304C[VAR 0114(0029)]",
  "\u306A\u304B\u306A\u304B\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u306E{\u52B9\u679C|\u3053\u3046\u304B}\u3092\\n{\u9AD8|\u305F\u304B}\u3081\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u305A\u3000\u3053\u307E\u3063\u3066\u3044\u305F[VAR 0114(0029)]",
  "\u3067\u306F\u3000{\u4E2D\u9593\u8A66\u9A13|\u3061\u3085\u3046\u304B\u3093\u3057\u3051\u3093}\u3067\u3000{\u512A\u79C0|\u3086\u3046\u3057\u3085\u3046}\u3060\u3063\u305F\\n[VAR 0100(0000)]\u3055\u3093\u306B\u3000{\u554F|\u3068}\u304A\u3046[VAR 0114(0029)]",
  "{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u306E{\u52B9\u679C|\u3053\u3046\u304B}\u3092\u3000{\u9AD8|\u305F\u304B}\u3081\u308B\u306B\\n\u30DA\u2026\u2026\u3000{\u7537\u5B50\u751F\u5F92|\u3060\u3093\u3057\u305B\u3044\u3068}\u306F\u3000\u3069\u3046\u3059\u308B\u3079\u304D\u304B\uFF1F[VAR 0114(0029)]",
  "{\u56DE\u6570|\u304B\u3044\u3059\u3046}\u3092\u3053\u306A\u3059",
  "\u307F\u3093\u306A\u3067{\u6599\u7406|\u308A\u3087\u3046\u308A}",
  "\u30DA\u30D1\u30FC\uFF1F",
  "{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306E{\u4E16\u754C|\u305B\u304B\u3044}\u306F\u3000{\u6DF1|\u3075\u304B}\u3044\u2026\u2026\\n\u3084\u307F\u304F\u3082\u306B\u3000{\u56DE\u6570|\u304B\u3044\u3059\u3046}\u3092\u3000\u3053\u306A\u3057\u305F\u3068\u3066\\r\\n{\u52AA\u529B|\u3069\u308A\u3087\u304F}\u304C\u3000{\u5B9F|\u307F\u306E}\u308B\u3068\u306F\u3000{\u9650|\u304B\u304E}\u3089\u306A\u3044\u306E\u3060[VAR 0114(0029)]",
  "\u3054{\u540D\u7B54|\u3081\u3044\u3068\u3046}\u3060\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306E{\u4F55|\u306A\u3093}\u305F\u308B\u304B\u3092\u3000{\u5FC3\u5F97|\u3053\u3053\u308D\u3048}\u3066\u3044\u308B\u306A[VAR 0114(0029)]",
  "\u30B0\u30CC\u2026\u2026\u3000{\u6599\u7406\u597D|\u308A\u3087\u3046\u308A\u305A}\u304D\u306A\u3000{\u7537\u5B50\u751F\u5F92|\u3060\u3093\u3057\u305B\u3044\u3068}\u306E\\n{\u6B63\u4F53|\u3057\u3087\u3046\u305F\u3044}\u306F\u3000{\u79D8\u5BC6|\u3072\u307F\u3064}\u3060\u2026\u2026\\r\\n\u30DA\u30D1\u30FC{\u9752\u5E74|\u305B\u3044\u306D\u3093}\u304B\u3082\u3000\u3057\u308C\u306A\u3044\u3057\\r\\n{\u9055|\u3061\u304C}\u3046\u304B\u3082\u3000\u3057\u308C\u306A\u3044\u306E\u3060\u3088\u2026\u2026\uFF01[VAR 0114(0029)]",
  "{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u306E{\u52B9\u679C|\u3053\u3046\u304B}\u3092\u3000{\u9AD8|\u305F\u304B}\u3081\u308B\u306B\u306F\\n{\u591A|\u304A\u304A}\u304F\u306E{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u304C\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306B\\r\\n\u306F\u3055\u307E\u308C\u3066\u3044\u308B\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308B[VAR 0114(0029)]",
  "\uFF11{\u4EBA|\u308A}\u3067\u306F\u3000{\u96E3\u6613\u5EA6|\u306A\u3093\u3044\u3069}\u304C\u3000{\u9AD8|\u305F\u304B}\u304F\u3068\u3082\\n{\u8907\u6570\u4EBA|\u3075\u304F\u3059\u3046\u306B\u3093}\u3067\u3000{\u4F5C|\u3064\u304F}\u308C\u3070\u3000\u305D\u308C\u3060\u3051\\r\\n\u3042\u3064\u304B\u3048\u308B\u30D1\u30F3\u3082\u3000{\u5927|\u304A\u304A}\u304D\u304F\u306A\u308B[VAR 0114(0029)]",
  "\u3055\u3059\u308C\u3070\u3000\u3044\u3068\u3082{\u7C21\u5358|\u304B\u3093\u305F\u3093}\u306B\\n{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3092\u3000{\u4E57|\u306E}\u305B\u308B\u3053\u3068\u304C\u3000{\u53EF\u80FD|\u304B\u306E\u3046}\u3060\u306A[VAR 0114(0029)]",
  "\u3059\u306A\u308F\u3061\u3000{\u52B9\u679C|\u3053\u3046\u304B}\u306E{\u9AD8|\u305F\u304B}\u3044\\n{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u3092\u3000{\u5F97|\u3048}\u3089\u308C\u308B\u306E\u3060[VAR 0114(0029)]",
  "{\u6559\u8A13|\u304D\u3087\u3046\u304F\u3093}\u3068\u3057\u3066\u3000\u3053\u307E\u3063\u305F\u3068\u304D\u306F\\n\uFF11{\u4EBA|\u308A}\u3067\u3000{\u62B1|\u304B\u304B}\u3048{\u8FBC|\u3053}\u307E\u305A\u306B\u3000{\u8AB0|\u3060\u308C}\u304B\u3068\\r\\n{\u554F\u984C|\u3082\u3093\u3060\u3044}\u3092\u3000{\u89E3\u6C7A|\u304B\u3044\u3051\u3064}\u3059\u308B{\u8853|\u3059\u3079}\u3082\u3000\u3042\u308B\u3068\u3044\u3046\u3053\u3068\u3060\u306A[VAR 0114(0029)]",
  "\u30DA\u30D1\u30FC{\u9752\u5E74|\u305B\u3044\u306D\u3093}\u3082\u3000{\u4ECA\u5F8C|\u3053\u3093\u3054}\u306F\u3000{\u53CB|\u3068\u3082}\u3068\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3092\u3000\u3057\u3066\u304F\u308C\u308B\u306B\u3000{\u9055|\u3061\u304C}\u3044\u306A\u3044[VAR 0114(0029)]",
  "\u2026\u2026{\u7537\u5B50\u751F\u5F92|\u3060\u3093\u3057\u305B\u3044\u3068}\u306E\u3000{\u6B63\u4F53|\u3057\u3087\u3046\u305F\u3044}\u306F\\n\u30D7\u30E9\u30A4\u30D9\u30FC\u30C8\u306A{\u554F\u984C|\u3082\u3093\u3060\u3044}\u3000\u3067\u3042\u308B\u304B\u3089\\r\\n\u3042\u307E\u308A\u3000{\u8A6E\u7D22|\u305B\u3093\u3055\u304F}\u3057\u306A\u3044\u3088\u3046\u306B\u3000\u3088\u308D\u3057\u3044\u306A\uFF1F[VAR 0114(0029)]",
  "{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u7D42\u4E86|\u3057\u3085\u3046\u308A\u3087\u3046}\u3060\\n\u3053\u308C\u306B\u3066\u3000{\u5931\u793C|\u3057\u3064\u308C\u3044}\u3059\u308B[VAR 0114(0029)]"
]
