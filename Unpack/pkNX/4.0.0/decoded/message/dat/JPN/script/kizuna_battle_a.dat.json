[
  "{\u62BC\u5FCD|\u304A\u3059}\uFF01\u3000{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\uFF01[VAR 0114(0024)]",
  "\u3082\u3057\u304B\u3057\u3066\u3000\u30B0\u30E9\u30A6\u30F3\u30C9\u306B\\n\u30C8\u30EC\u30FC\u30CB\u30F3\u30B0\u306B\u3000{\u6765|\u304D}\u305F\u306E\u304B\uFF01\uFF1F[VAR 0114(0024)]",
  "\u3069\u3046\u308A\u3067\u3000\u305D\u306E{\u77B3|\u3072\u3068\u307F}\u306B\\n{\u95D8\u5FD7|\u3068\u3046\u3057}\u3092\u3000{\u611F|\u304B\u3093}\u3058\u305F\u308F\u3051\u3060\uFF01[VAR 0114(0024)]",
  "\u3059\u307E\u306A\u3044\uFF01\\n\u30C8\u30EC\u30FC\u30CB\u30F3\u30B0\u3068\u306F\u3000{\u4EBA\u77E5|\u3072\u3068\u3057}\u308C\u305A\u3000\u3084\u308B\u3082\u306E\uFF01\\r\\n\u2026\u2026{\u91CE\u66AE|\u3084\u307C}\u306A\u3053\u3068\u3092\u3000{\u805E|\u304D}\u3044\u3066\u3057\u307E\u3063\u305F\u306A\uFF01[VAR 0114(0024)]",
  "{\u89AA\u4EA4|\u3057\u3093\u3053\u3046}\u3092\u3000{\u6DF1|\u3075\u304B}\u3081\u308B\u305F\u3081\u3000\u3068\u3082\u306B\\n\u30B0\u30E9\u30A6\u30F3\u30C9\u3092\u3000{\u8D70|\u306F\u3057}\u308D\u3046\u3058\u3083\u306A\u3044\u304B\uFF01[VAR 0114(0024)]",
  "\u3055\u3042\u3000\u3044\u304F\u305E\uFF01[VAR 0114(0024)]",
  "\u30AD\u30CF\u30C0{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\u3000\u30B0\u30E9\u30A6\u30F3\u30C9\u3092\\n\uFF13{\u5468|\u3057\u3085\u3046}\u3000{\u8D70|\u306F\u3057}\u3063\u305F\u2026\u2026",
  "\u3075\u3045\uFF01\\n\u3044\u3044{\u6C57|\u3042\u305B}\u3000\u304B\u3044\u305F\u306A\uFF01[VAR 0114(0024)]",
  "{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\u306F\u3000\u306A\u304B\u306A\u304B\\n\u3044\u3044{\u8DB3|\u3042\u3057}\u30B3\u30B7\u3092\u3000\u3057\u3066\u3044\u308B\u306A\uFF01[VAR 0114(0024)]",
  "{\u904B\u52D5|\u3046\u3093\u3069\u3046}\u3057\u3066\u3000\uFF13\uFF10{\u5206\u4EE5\u5185|\u3075\u3093\u3044\u306A\u3044}\u306B\u3000{\u6804\u990A|\u3048\u3044\u3088\u3046}\u3092\\n{\u88DC\u7D66|\u307B\u304D\u3085\u3046}\u3059\u308B\u3068\u3000{\u7B4B\u8089|\u304D\u3093\u306B\u304F}\u304C\u3000\u3064\u304D\u3084\u3059\u3044\u305E\uFF01[VAR 0114(0024)]",
  "\u3064\u304D\u3042\u3063\u3066\u304F\u308C\u305F\u3000{\u793C|\u308C\u3044}\u3082\u3000\u304B\u306D\u3066\\n\u308F\u305F\u3057\u306E\u3000{\u624B\u4F5C|\u3066\u3065\u304F}\u308A\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\uFF01\\r\\n{\u98DF|\u305F}\u3079\u3066\u3000{\u4F53|\u304B\u3089\u3060}\u3092\u3000{\u4F5C|\u3064\u304F}\u3063\u3066\u304F\u308C\uFF01[VAR 0114(0024)]",
  "\u30AD\u30CF\u30C0{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306E\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306F\\n\u30D1\u30B5\u30D1\u30B5\u3057\u3066\u3044\u3066\u3000{\u5302|\u306B\u304A}\u3044\u3082\u3000\u30AD\u30C4\u304F\\r\\n\u307E\u3063\u305F\u304F\u3000{\u5473|\u3042\u3058}\u304C\u3000\u3057\u306A\u304B\u3063\u305F\u2026\u2026",
  "\u308F\u305F\u3057\u306E\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306F\\n\u304A\u3044\u3057\u304B\u3063\u305F\u304B\u306A\uFF1F[VAR 0114(0024)]",
  "\u304A\u3044\u3057\u304B\u3063\u305F\u3067\u3059\u2026\u2026",
  "{\u6B63\u76F4|\u3057\u3087\u3046\u3058\u304D}\u306B{\u8A00|\u3044}\u3046\u3068\u2026\u2026",
  "\u3059\u307E\u306A\u3044\u2026\u2026\\n{\u6C17|\u304D}\u3092\u3000{\u9063|\u3064\u304B}\u308F\u305B\u3066\u3057\u307E\u3063\u305F\u306A[VAR 0114(0024)]",
  "{\u4F53|\u304B\u3089\u3060}\u3092\u3000{\u52D5|\u3046\u3054}\u304B\u3059\u306E\u306F\u3000{\u5F97\u610F|\u3068\u304F\u3044}\u3060\u304C\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306F\u3000\u3066\u3093\u3067\u3000\u30C0\u30E1\u306A\u3093\u3060[VAR 0114(0024)]",
  "{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\u306E\u3000{\u6B63\u76F4|\u3057\u3087\u3046\u3058\u304D}\u306A{\u53CD\u5FDC|\u306F\u3093\u306E\u3046}\u3067\\n{\u81EA\u5206|\u3058\u3076\u3093}\u3068\u3000{\u5411|\u3080}\u304D\u3042\u3048\u305F\u3088\u2026\u2026[VAR 0114(0024)]",
  "\u305D\u308C\u3067\u306F\u3000\u307E\u305F\u306A\\n{\u7B4B\u8089\u75DB|\u304D\u3093\u306B\u304F\u3064\u3046}\u3092\u3000{\u697D|\u305F\u306E}\u3057\u307F\u306B\u306A\u2026\u2026[VAR 0114(0024)]",
  "\u30AD\u30CF\u30C0{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\\n\u3061\u3087\u3063\u3068\u3000\u306A\u304B\u3088\u304F\u306A\u3063\u305F\uFF01"
]
