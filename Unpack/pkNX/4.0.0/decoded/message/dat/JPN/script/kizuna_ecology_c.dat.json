  "\u308F\u3042\u30FC\u3000\u308F\u3042\u30FC\uFF01\\n{\u5C0F|\u3061\u3044}\u3055\u3044\u30DD\u30B1\u30E2\u30F3\u3000{\u5927|\u304A\u304A}\u304D\u3044\u30DD\u30B1\u30E2\u30F3\uFF01\\r\\n\u3042\u3063\u3000\u3053\u3093\u306A\u30B5\u30A4\u30BA\u306E\u3000\u30C7\u30FC\u30BF\u307E\u3067\uFF01\uFF01[VAR 0114(002A)]",
