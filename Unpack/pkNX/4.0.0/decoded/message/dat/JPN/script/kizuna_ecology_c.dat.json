  "{\u5927\u5909|\u305F\u3044\u3078\u3093}\u306B\u3000\u306A\u3063\u3066\u304D\u307E\u3057\u305F\u304C\\n\u30DC\u30FC\u30EB\u3092\u3000\u304B\u307E\u3048\u3066\u3000\u3048\u3044\u3084\u3063\uFF01\\r\\n\u2026\u2026\u306E{\u7CBE\u795E|\u305B\u3044\u3057\u3093}\u3067\u3000\u30D5\u30A1\u30A4\u30C8\u3067\u3059\u3088\u304A[VAR 0114(002A)]"
