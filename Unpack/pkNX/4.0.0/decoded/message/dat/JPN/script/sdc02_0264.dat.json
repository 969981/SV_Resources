[
  "\u3042\u306E{\u5B50|\u3053}\u3000\u30B3\u30E9\u30A4\u30C9\u30F3\u3060\u3063\u3051\uFF1F\\n\u3084\u308B\u3058\u3083\u3093\uFF01\u3000\u3072\u3068\u3063{\u8DF3|\u3068}\u3073\u306D\uFF01[VAR 0114(0044)]",
  "\u3042\u306E{\u5B50|\u3053}\u3000\u30DF\u30E9\u30A4\u30C9\u30F3\u3060\u3063\u3051\uFF1F\\n\u3084\u308B\u3058\u3083\u3093\uFF01\u3000\u3072\u3068\u3063{\u8DF3|\u3068}\u3073\u306D\uFF01[VAR 0114(0044)]",
  "\u3053\u306E{\u8ABF\u5B50|\u3061\u3087\u3046\u3057}\u3067\\n{\u9032|\u3059\u3059}\u3093\u3067\u3044\u304D\u307E\u3057\u3087\uFF01[VAR 0114(0044)]",
  "\u307E\u30FC\u305F\u3000{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\uFF01\u3000{\u5CA9|\u3044\u308F}\u3063\u3053\u308D\u306E\u304F\u305B\u306B\\n\u3042\u305F\u3057\u3092\u3000{\u6B62|\u3068}\u3081\u308B\u306A\u3093\u3066\u3000\u30CA\u30DE\u30A4\u30AD\uFF01\\r\\n{\u5149|\u3072\u304B}\u308B\u3084\u3064\u3000\u3069\u3053\u306B\u3000\u3044\u3093\u306E\u3088\uFF01\uFF1F[VAR 0114(0044)]",
  "\u3053\u3053\u2026\u2026\u3000{\u9B3C|\u304A\u306B}\u304C{\u5C71|\u3084\u307E}\u3088\u308A\\n{\u5165|\u3044}\u308A{\u7D44|\u304F}\u3093\u3060\u3000{\u5730\u5F62|\u3061\u3051\u3044}\u3060\u306A[VAR 0114(0043)]",
  "{\u5730\u5F62|\u3061\u3051\u3044}\u306B\u306F\u3000{\u6CE8\u610F|\u3061\u3085\u3046\u3044}\u3059\u308B\u3093\u3060\u3088\\n{\u843D|\u304A}\u3061\u3066\u3082\u3000{\u52A9|\u305F\u3059}\u3051\u3089\u308C\u306A\u3044\u304B\u3089\u306D[VAR 0114(0042)]"
