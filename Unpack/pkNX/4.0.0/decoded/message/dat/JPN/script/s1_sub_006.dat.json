[
  "\u30AA\u30FC\u30C3\u30DB\u30C3\u30DB\u30C3\u30DB\uFF01\\n\u30AA\u30FC\u30C3\u30DB\u30C3\u30DB\u30C3\u30DB\uFF01[VAR 0114(0041)]",
  "\u30D3\u30EA\u30AA\u3000{\u898B|\u307F}\u308B\u30B6\u30DE\u30B9\uFF01\\n\u306A\u3093\u3066{\u7D20\u6575|\u3059\u3066\u304D}\u306A\u3000{\u690D\u6728\u9262|\u3046\u3048\u304D\u3070\u3061}\u306A\u306E\uFF01[VAR 0114(0041)]",
  "\u30CD\u30A2\u3061\u3083\u3093\uFF01\u3000\\n\u3053\u308C\u3000{\u679C\u6A39\u5712|\u304B\u3058\u3085\u3048\u3093}\u3060\u3088\uFF01\\r\\n\u30AD\u30DF\u306B\u306F\u3000{\u690D\u6728\u9262|\u3046\u3048\u304D\u3070\u3061}\u306B\u3000{\u898B|\u307F}\u3048\u308B\u304B\u3082\u3060\u3051\u3069\uFF01[VAR 0114(0040)]",
  "{\u5618|\u3046\u305D}\u3067\u3057\u3087\u3046\u2026\u2026\uFF1F\\n\u3053\u308C\u304C\u3000{\u679C\u6A39|\u304B\u3058\u3085}\u306E{\u5712|\u3048\u3093}\uFF01\uFF1F\\r\\n\u306A\u3093\u3066\u3000\u3064\u3064\u307E\u3057\u3044\u306E\uFF01\uFF01[VAR 0114(0041)]",
  "\u30D3\u30EA\u30AA\uFF01\\n{\u8A02\u6B63|\u3066\u3044\u305B\u3044}\u3092\u3000\u3042\u308A\u304C\u3068\u30B6\u30DE\u30B9[VAR 0114(0041)]",
  "\u3044\u3044\u3063\u3066\u3053\u3068\uFF01\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E{\u751F\u614B|\u305B\u3044\u305F\u3044}\u306F\\n\u307E\u3060\u3000{\u8B0E|\u306A\u305E}\u304C\u3000{\u591A|\u304A\u304A}\u3044\u304B\u3089\u306D\uFF01[VAR 0114(0040)]",
  "\u3042\u3042\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\uFF01\\n\u306A\u3093\u3066\u3000{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u306A{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u2026\u2026\\r\\n\u3044\u3064\u3060\u3063\u3066\u3000\u3042\u305F\u304F\u3057\u306E{\u80F8|\u3080\u306D}\u3092\u3000{\u9AD8\u9CF4|\u305F\u304B\u306A}\u3089\u305B\u308B\uFF01\uFF01[VAR 0114(0041)]",
  "\u3042\u3089\u2026\u2026\uFF1F\u3000{\u5642|\u3046\u308F\u3055}\u3092\u3059\u308C\u3070\\n\u304A\u306A\u3058\u307F\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u304B\u305F\uFF01[VAR 0114(0041)]",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u3060\u3000\u3042\u308C\u306F\\n{\u9593\u9055|\u307E\u3061\u304C}\u3044\u306A\u304F\u3000\u304A\u306A\u3058\u307F\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u3060\u306D\uFF01[VAR 0114(0040)]",
  "\u3042\u305F\u304F\u3057\u3000\u3082\u3063\u3068\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u3053\u3068\u3000{\u77E5|\u3057}\u308A\u305F\u3044\uFF01\\r\\n\u304A{\u8FD1|\u3061\u304B}\u3065\u304D\u306B\u3000\u306A\u308A\u305F\u3044\u30B6\u30DE\u30B9\uFF01\uFF01[VAR 0114(0041)]",
  "\u2026\u2026\u3067\u3000\u3042\u308B\u304B\u3089\u3057\u3066\u3000\u3042\u305F\u304F\u3057\u3068\\n{\u518D\u5EA6|\u3055\u3044\u3069}\u3000{\u6C7A\u95D8|\u3051\u3063\u3068\u3046}\u3057\u3066\u304F\u308C\u306A\u3044\u30B6\u30DE\u30B9\u304B\uFF1F[VAR 0114(0041)]",
  "\u3067\u2026\u2026\u3000\u3067\u305F\uFF01\\n\u30CD\u30A2\u3061\u3083\u3093\u306E{\u8DA3\u5473|\u3057\u3085\u307F}\uFF01\\r\\n{\u6226|\u305F\u305F\u304B}\u3046\u3053\u3068\u3067\u3000{\u76F8\u624B|\u3042\u3044\u3066}\u306E\u3053\u3068\u3092\u3000{\u77E5|\u3057}\u308B\u3084\u30FC\u3064\uFF01[VAR 0114(0040)]",
  "\u30DB\u30DB\u30DB\u2026\u2026\u3000{\u899A\u609F|\u304B\u304F\u3054}\u3092\u3000{\u6C7A|\u304D}\u3081\u305F\u3089\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u307B\u3046\u304B\u3089\u3000\u304A{\u8A98|\u3055\u305D}\u3044\u3042\u305D\u3070\u305B[VAR 0114(0041)]",
  "\u30BB\u30EC\u30D6\u3068\u3000{\u6C7A\u95D8|\u3051\u3063\u3068\u3046}\u3067\u304D\u308B\u3000\u307E\u305F\u3068\u306A\u3044{\u6A5F\u4F1A|\u304D\u304B\u3044}\uFF01\\n\u30CD\u30A2\u3061\u3083\u3093\u306B\u3000{\u8A71|\u306F\u306A}\u3057\u304B\u3051\u306A\u3088\uFF01[VAR 0114(0040)]",
  "\u3042\u305F\u304F\u3057\u3068\u306E\u3000{\u6C7A\u95D8|\u3051\u3063\u3068\u3046}\uFF01\\n{\u53D7|\u3046}\u3051\u3066\u304F\u3060\u3055\u308B\u30B6\u30DE\u30B9\u306D\uFF1F[VAR 0114(0041)]",
  "\u2026\u2026{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306B\u3000\u3058\u3089\u3055\u308C\u308B\u306E\u3082\\n\u305F\u307E\u306B\u306F\u3000\u3044\u3044\u30B6\u30DE\u30B9\u304C\\c\\n\u30BB\u30EC\u30D6\u306E{\u6642\u9593|\u3058\u304B\u3093}\u306F\u3000{\u8CB4\u91CD|\u304D\u3061\u3087\u3046}\u30B6\u30DE\u30B9\uFF01\\n{\u4ECA|\u3044\u307E}\u3059\u3050\u3000\u3084\u3063\u3061\u307E\u3046\u30B6\u30DE\u30B9\u3088\u3049\u3049\u3049\uFF01\uFF01[VAR 0114(0041)]",
  "\u30D1\u30EB\u30C7\u30A2\u30A8\u30B9\u30C6\u30FC\u30C8\u3000{\u793E\u9577|\u3057\u3083\u3061\u3087\u3046}\u3000\u30CD\u30A2\uFF01\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u3092\u3000\u3076\u3063\u3064\u3076\u3059\u30B6\u30DE\u30B9\u3088\u3049\u3049\u3049\uFF01[VAR 0114(0041)]",
  "\u3072\u3085\u30FC\u3000\u3072\u3085\u30FC\uFF01\\n\u304C\u3093\u3070\u3063\u3066\u306D\u3000\u30CD\u30A2\u3061\u3083\u3093\uFF01[VAR 0114(0040)]",
  "\u307E\u305F\u3057\u3066\u3082\u3000{\u8CA0|\u307E}\u3051\u30B6\u30DE\u30B9\uFF01\\n\u3042\u306A\u305F\u3000\u3044\u3063\u305F\u3044\u3000{\u4F55\u8005|\u306A\u306B\u3082\u306E}\u30B6\u30DE\u30B9\u304B\uFF01[VAR 0114(0041)]",
  "\u306D\u3048\u3000\u30D3\u30EA\u30AA\uFF01\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306F\u3000\u307F\u3093\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u3000{\u5F37|\u3064\u3088}\u3044\u306E\uFF01\uFF1F\\r\\n\u305D\u308C\u3068\u3082\u3000\u3053\u306E{\u65B9|\u304B\u305F}\u304C\u3000{\u7279\u5225|\u3068\u304F\u3079\u3064}\uFF01\uFF1F[VAR 0114(0041)]",
  "\u30CD\u30A2\u3061\u3083\u3093\u3000\u3042\u306E{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306F\u3000\u304D\u3063\u3068\\n{\u9078|\u3048\u3089}\u3070\u308C\u3057{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306B\u3057\u304B\u3000{\u6301|\u3082}\u3066\u306A\u3044\u2026\u2026[VAR 0114(0040)]",
  "\u30CF\u30F3\u30B0\u30EA\u30FC{\u7CBE\u795E|\u305B\u3044\u3057\u3093}\u3092\u3000{\u6301|\u3082}\u3063\u3066\u3044\u308B\u3093\u3060\u3088\uFF01\uFF01[VAR 0114(0040)]",
  "\u30CF\u30F3\u30B0\u30EA\u30FC{\u7CBE\u795E|\u305B\u3044\u3057\u3093}\uFF01\uFF1F\u3000\u30BB\u30EC\u30D6\u306B\u306F\\n{\u4E00\u751F|\u3044\u3063\u3057\u3087\u3046}\u3000{\u6301|\u3082}\u3066\u306A\u3044\u3068\u3044\u3046\u3000\u3042\u306E\u2026\u2026\uFF01\uFF1F[VAR 0114(0041)]",
  "\u3069\u3046\u308A\u3067\u3000{\u52DD|\u304B}\u3066\u306A\u3044\u306F\u305A\u30B6\u30DE\u30B9\\n\u3042\u305F\u304F\u3057\u3000{\u76EE|\u3081}\u304B\u3089\u3000\u304A\u3060\u3093\u3054\u3057\u3093\u3058\u3085\u2026\u2026[VAR 0114(0041)]",
  "\u2026\u2026\u3057\u3093\u3058\u3085\u306E{\u8A71|\u306F\u306A\u3057}\u3092\u3000\u3057\u305F\u3089\\n\u3042\u305F\u304F\u3057\u3000{\u6C34\u8FBA|\u307F\u305A\u3079}\u306B\u3000{\u884C|\u3044}\u304D\u305F\u304F\u306A\u3063\u305F\u30B6\u30DE\u30B9\uFF01[VAR 0114(0041)]",
  "\u3055\u3066\u3000\u30D3\u30EA\u30AA\uFF01\\n\u3042\u305F\u304F\u3057\u3000{\u4ECA|\u3044\u307E}\u3059\u3050\u3000\u30D1\u30EB\u30C7\u30A2\u3067\\r\\n{\u4E00\u756A|\u3044\u3061\u3070\u3093}\u3000[VAR FF00(0006)]{\u5927|\u304A\u304A}\u304D\u306A{\u6C34\u8FBA|\u307F\u305A\u3079}[VAR FF00(0000)]\u3092\u3000{\u898B|\u307F}\u305F\u3044\u30B6\u30DE\u30B9\uFF01[VAR 0114(0041)]",
  "\u3072\u3085\u30FC\uFF01\u3000{\u597D\u5947\u5FC3|\u3053\u3046\u304D\u3057\u3093}\u306F\\n\u3044\u3064\u3060\u3063\u3066\u3000{\u7A81\u7136|\u3068\u3064\u305C\u3093}\u306A\u3093\u3060\uFF01\\r\\n\u30CD\u30A2\u3061\u3083\u3093\u3000\u30BB\u30EC\u30D6\u306E{\u9451|\u304B\u304C\u307F}\u3060\u306D\uFF01[VAR 0114(0040)]",
  "{\u6E56\u7554|\u3053\u306F\u3093}\u306E{\u5CF6|\u3057\u307E}\u3067\u3000{\u6C7A\u95D8\u75B2|\u3051\u3063\u3068\u3046\u3065\u304B}\u308C\u3092\\n\u30EA\u30E9\u30AF\u30BC\u30FC\u30B7\u30E7\u30F3\u3068\u3000\u3044\u3053\u3046\u304B\uFF01[VAR 0114(0040)]",
  "\u30CD\u30A2\u3055\u307E\u3068\u3000\u30D3\u30EA\u30AA\u3055\u307E\u306F\\n\u3053\u3053\u3000\u30AD\u30BF\u30AB\u30DF\u306E{\u91CC|\u3055\u3068}\u3067\\r\\n\u30D5\u30EB\u30FC\u30C4{\u8FB2\u5712|\u306E\u3046\u3048\u3093}\u3092\u3000{\u898B|\u307F}\u306B\u3044\u304B\u308C\u307E\u3057\u305F"
