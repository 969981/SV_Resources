[
  "\u3048\u3063\uFF1F\u3000{\u79D8\u5BC6|\u3072\u307F\u3064}\u306E\u30E1\u30CB\u30E5\u30FC\uFF1F\\n\u3061\u3087\u3063\u3068\u3000\u308F\u304B\u3089\u306A\u3044\u308F",
  "{\u5B9D\u98DF\u5802|\u305F\u304B\u3089\u3057\u3087\u304F\u3069\u3046}\u306B\u306F\u3000\u3042\u3063\u3068{\u9A5A|\u304A\u3069\u308D}\u304F\\n\u3057\u304B\u3051\u304C\u3000\u3042\u308B\u3089\u3057\u3044\u305E\u3044",
  "\u30AA\u30E9\u3000\u3053\u3093\u306A\u3000\u3046\u3081\u3048{\u6599\u7406|\u308A\u3087\u3046\u308A}\\n{\u98DF|\u304F}\u3063\u305F\u306E\u306F\u3000{\u521D|\u306F\u3058}\u3081\u3066\u3060\uFF01\uFF01",
  "{\u5642|\u3046\u308F\u3055}\u3067\u306F\u3000\u3053\u306E{\u5E97|\u307F\u305B}\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n\u30C6\u30E9\u30B9\u30BF\u30A4\u30D7\u3092\u3000\u30C1\u30A7\u30F3\u30B8\u3067\u304D\u308B\u3089\u3057\u3044\\r\\n\u2026\u2026{\u666E\u901A|\u3075\u3064\u3046}\u306B\u3000{\u98EF|\u3081\u3057}\u3082\u3000\u3046\u307E\u3044"
]
