[
  "\u3088\u3046\u3053\u305D\u3000\u30CA\u30C3\u30DA{\u5C71|\u3084\u307E}\u30B8\u30E0\u3078\uFF01",
  "{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}{\u8005|\u3057\u3083}\u306E\\n\u304A{\u540D\u524D|\u306A\u307E\u3048}\u3092\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3057\u307E\u3059\u2026\u2026\\r\\n[VAR 0100(0000)]\u3055\u3093\u3000\u3067\u3059\u306D\uFF01",
  "{\u5F53|\u3068\u3046}\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30B0\u30EB\u30FC\u30B7\u30E3\u3068\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308B\u306B\u306F\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u3092\\r\\n\u30AF\u30EA\u30A2\u3059\u308B{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308A\u307E\u3059",
  "\u30CA\u30C3\u30DA{\u5C71|\u3084\u307E}\u30B8\u30E0\u306E\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u306F\u2026\u2026\\n[VAR FF00(0006)]{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u3059\u3079\u308A[VAR FF00(0000)]\u3067\u3059\uFF01",
  "\u30E9\u30A4\u30C9\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u4E57|\u306E}\u3063\u3066\u3000{\u7528\u610F|\u3088\u3046\u3044}\u3055\u308C\u305F\\n\u30B3\u30FC\u30B9\u3092\u3000{\u6642\u9593\u5185|\u3058\u304B\u3093\u306A\u3044}\u306B\u3000\u30B4\u30FC\u30EB\u3057\u3066\u304F\u3060\u3055\u3044\uFF01",
  "\u304F\u308F\u3057\u3044\u30EB\u30FC\u30EB\u306F\u3000{\u5F53|\u3068\u3046}\u30B8\u30E0\u3092\u3000{\u51FA|\u3067}\u3066\\n{\u5DE6\u624B|\u3072\u3060\u308A\u3066}\u306E{\u5742|\u3055\u304B}\u3092\u3000\u306E\u307C\u3063\u305F{\u5148|\u3055\u304D}\\r\\n{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u3059\u3079\u308A\u3000{\u958B\u59CB\u5730\u70B9|\u304B\u3044\u3057\u3061\u3066\u3093}\u3067\u3000{\u8AAC\u660E|\u305B\u3064\u3081\u3044}\u3057\u307E\u3059\u306D",
  "\u305D\u308C\u3067\u306F\u3000\u3044\u3063\u3066\u3089\u3063\u3057\u3083\u3044\uFF01"
]
