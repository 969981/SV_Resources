[
  "[VAR 0100(0000)]\u3055\u3093\uFF01\\n\u3042\u306A\u305F\u3082\u3000{\u898B\u5B88|\u307F\u307E\u3082}\u3063\u3066\u3066\uFF01[VAR 0114(0025)]",
  "\u3053\u308C\u304B\u3089\u3000{\u4F8B|\u308C\u3044}\u306E{\u8996\u7DDA|\u3057\u305B\u3093}\u306E{\u5B50|\u3053}\u3092\\n{\u5F85|\u307E}\u3061\u3076\u305B\u3000\u3059\u308B\u3068\u3053\u308D\u306A\u306E\u3088\uFF01[VAR 0114(0025)]",
  "{\u5F85|\u307E}\u3061\u3076\u305B\uFF01\uFF1F",
  "\u3069\u3046\u3057\u3066\uFF01\uFF1F",
  "\u3044\u3064\u307E\u3067\u3082\u3000{\u8996\u7DDA|\u3057\u305B\u3093}\u3060\u3051\\n{\u611F|\u304B\u3093}\u3058\u308B\u306E\u306F\u3000\u30B9\u30C3\u30AD\u30EA\u3057\u306A\u3044\u3057[VAR 0114(0025)]",
  "{\u98DF\u5802|\u3057\u3087\u304F\u3069\u3046}\u3067\u3000{\u9854|\u304B\u304A}\u306F\\n\u304A\u307C\u3048\u307E\u3057\u305F\u304B\u3089\u306D\uFF01[VAR 0114(0025)]",
  "\u2026\u2026\u30CF\u30C3\uFF01[VAR 0114(0025)]",
  "\u3042\u306A\u305F\u3067\u3057\u3087\u3046\uFF01\\n{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u3000\u308F\u305F\u3057\u3092\u3000{\u898B|\u307F}\u3066\u3044\u308B\u306E\u306F\uFF01[VAR 0114(0025)]",
  "\u305F\u3000\u30BF\u30A4\u30E0\u3055\u3093\uFF01\uFF1F\\n\u3069\u3046\u3057\u3066\u3000\u308F\u304B\u3063\u305F\u3093\u3067\u3059\u2026\u2026\uFF01\uFF1F",
  "\u3059\u3000\u3059\u307F\u307E\u305B\u3093\uFF01\\n{\u6C17|\u304D}\u3065\u3044\u3066\u3089\u3063\u3057\u3083\u3063\u305F\u3093\u3067\u3059\u306D",
  "\u305D\u308A\u3083\u3042\u3000{\u56DB\u516D\u6642\u4E2D|\u3057\u308D\u304F\u3058\u3061\u3085\u3046}\u3000{\u898B|\u307F}\u3089\u308C\u305F\u3089\u306D\uFF01\\n{\u4F55|\u306A\u306B}\u304B\u3000\u308F\u305F\u3057\u306B\u3000{\u805E|\u304D}\u304D\u305F\u3044\u3053\u3068\u304C\\r\\n\u3042\u308B\u3093\u3058\u3083\u3000\u306A\u3044\u3067\u3059\u304B\uFF01\uFF1F[VAR 0114(0025)]",
  "\u306F\u3000\u306F\u3044\u2026\u2026",
  "\u308F\u305F\u3057\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306E\u3053\u308D\u304B\u3089\\n\u30BF\u30A4\u30E0\u3055\u3093\u306E\u3000{\u5927|\u3060\u3044}\u30D5\u30A1\u30F3\u3067\uFF01\\r\\n\u3044\u308F{\u6280|\u308F\u3056}\u3000\u3059\u3063\u3054\u304F\u3000{\u597D|\u3059}\u304D\u3067\uFF01\uFF01",
  "\u3042\u3089[VAR 0114(0025)]",
  "\u3067\u3082\u3000\uFF11{\u5E74\u534A\u524D|\u306D\u3093\u306F\u3093\u307E\u3048}\\n{\u7A81\u7136|\u3068\u3064\u305C\u3093}\u3000{\u5F15\u9000|\u3044\u3093\u305F\u3044}\u3057\u3061\u3083\u3063\u3066\u2026\u2026\\r\\n\u3069\u3046\u3057\u3066\u3000\u3084\u3081\u3061\u3083\u3063\u305F\u3093\u3067\u3059\u304B\uFF1F",
  "\u2026\u2026\u306A\u3042\u3093\u3060\\n\u305D\u3093\u306A\u3053\u3068\u304C\u3000{\u805E|\u304D}\u304D\u305F\u304B\u3063\u305F\u306E[VAR 0114(0025)]",
  "\u30BF\u30A4\u30E0\u3055\u3093\u306E\u3000{\u5F15\u9000\u7406\u7531|\u3044\u3093\u305F\u3044\u308A\u3086\u3046}\u306F\\n{\u516C\u5F0F|\u3053\u3046\u3057\u304D}\u306B\u3000{\u767A\u8868|\u306F\u3063\u3074\u3087\u3046}\u3055\u308C\u3066\u307E\u305B\u3093\u3057",
  "{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u3057\u3066\u3082\u3000\u306F\u3050\u3089\u304B\u3055\u308C\u305F\u3063\u3066\\n{\u751F\u5F92|\u305B\u3044\u3068}\u306E{\u9593|\u3042\u3044\u3060}\u3067\u3082\u3000{\u5642|\u3046\u308F\u3055}\u306B\u306A\u3063\u3066\u3066\u2026\u2026",
  "\u30BF\u30A4\u30E0\u3055\u3093\u304C\u3000{\u8A00|\u3044}\u3044\u305F\u304F\u306A\u3044\u3053\u3068\\n{\u805E|\u304D}\u304F\u306E\u306F\u3000{\u5931\u793C|\u3057\u3064\u308C\u3044}\u304B\u3082\u3063\u3066\u2026\u2026\\r\\n\u3060\u304B\u3089\u3000{\u52C7\u6C17|\u3086\u3046\u304D}\u304C\u3000{\u51FA|\u3067}\u306A\u304F\u3066\u2026\u2026",
  "\u305D\u308C\u3067\u3000\u30C9\u30AD\u30C9\u30AD{\u71B1\u8996\u7DDA|\u306D\u3063\u3057\u305B\u3093}\u3092\u2026\u2026\\n\u3054\u3081\u3093\u306A\u3055\u3044\u306D[VAR 0114(0025)]",
  "\u3048\u3000\u30C9\u30AD\u30C9\u30AD\u2026\u2026\uFF1F",
  "\u3042\u3000\u3046\u3046\u3093\u2026\u2026\\n\u3084\u3081\u305F{\u7406\u7531|\u308A\u3086\u3046}\u306F\u306D\u3000\u3082\u3063\u3068\\r\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306B\u3000{\u96C6\u4E2D|\u3057\u3085\u3046\u3061\u3085\u3046}\u3057\u305F\u304B\u3063\u305F\u304B\u3089\u306A\u306E[VAR 0114(0025)]",
  "\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u304C\u3000{\u5ACC|\u3044\u3084}\u3067\\n\u3084\u3081\u305F\u308F\u3051\u3058\u3083\u306A\u3044\u304B\u3089\u2026\u2026[VAR 0114(0025)]",
  "\u30B8\u30E0\u306E\u3053\u3068\u3000{\u8A71|\u306F\u306A}\u3059\u3068\\n\u306A\u3064\u304B\u3057\u304F\u3066\u3000\u3055\u307F\u3057\u304F\u306A\u3063\u3061\u3083\u3046[VAR 0114(0025)]",
  "\u3060\u304B\u3089\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u306E{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\\n\u306F\u3050\u3089\u304B\u3057\u3061\u3083\u3063\u3066\u305F\u306E\u306D[VAR 0114(0025)]",
  "\u305D\u3046\u3060\u3063\u305F\u3093\u3067\u3059\u304B\u2026\u2026",
  "\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306B\\n{\u623B|\u3082\u3069}\u3063\u305F\u308A\u306F\u3000\u3057\u306A\u3044\u3093\u3067\u3059\u304B\uFF1F",
  "\u3048\u3048\u2026\u2026\u3000{\u623B|\u3082\u3069}\u3089\u306A\u3044[VAR 0114(0025)]",
  "{\u4ECA|\u3044\u307E}\u306F\u3000{\u59B9|\u3044\u3082\u3046\u3068}\u304C\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3092\\n\u304D\u3061\u3093\u3068\u3000\u3053\u306A\u3057\u3066\u304F\u308C\u3066\u307E\u3059[VAR 0114(0025)]",
  "{\u59C9|\u3042\u306D}\u306E\u308F\u305F\u3057\u306F\u3000{\u4ECA|\u3044\u307E}\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304C\u3000{\u4E00\u756A\u697D|\u3044\u3061\u3070\u3093\u305F\u306E}\u3057\u3044\u306E[VAR 0114(0025)]",
  "\u3060\u304B\u3089\u3000\u30BF\u30A4\u30E0\u3055\u3093\u3000\u3058\u3083\u306A\u304F\u3066\\n\u30BF\u30A4\u30E0{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3063\u3066\u3000{\u547C|\u3088}\u3093\u3067\u304F\u308C\u305F\u3089\\r\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3000\u3068\u3063\u3066\u3082\u3000\u3046\u308C\u3057\u3044\u308F[VAR 0114(0025)]",
  "\u306F\u3044\u3000{\u6B8B\u5FF5|\u3056\u3093\u306D\u3093}\u3067\u3059\u3051\u3069\u2026\u2026\\n{\u7D0D\u5F97|\u306A\u3063\u3068\u304F}\u3057\u307E\u3057\u305F\uFF01",
  "\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\\n\u30BF\u30A4\u30E0{\u5148\u751F|\u305B\u3093\u305B\u3044}\uFF01",
  "\u3053\u308C\u306B\u3066\u3000{\u4E00\u4EF6\u843D\u7740|\u3044\u3063\u3051\u3093\u3089\u304F\u3061\u3083\u304F}\u306D[VAR 0114(0025)]",
  "\u3042\u30FC\u3000{\u7DCA\u5F35|\u304D\u3093\u3061\u3087\u3046}\u3057\u305F\uFF01\\n\u3044\u3063\u3071\u3044\u3000\u30AB\u30C3\u30B3\u3044\u3044\u3053\u3068\u3000{\u8A00|\u3044}\u3063\u3061\u3083\u3063\u305F\uFF01[VAR 0114(0025)]",
  "\u30C9\u30AD\u30C9\u30AD{\u71B1\u8996\u7DDA|\u306D\u3063\u3057\u305B\u3093}\u306B\u3000{\u6C17|\u304D}\u3065\u3044\u305F\u3068\u304D\u306F\\n\u3061\u3087\u3063\u3068\u3000{\u6016|\u3053\u308F}\u304B\u3063\u305F\u3051\u3069\u2026\u2026[VAR 0114(0025)]",
  "\u3042\u306A\u305F\u304C\u3000\u3044\u3066\u304F\u308C\u305F\u304B\u3089\\n\u30D5\u30A1\u30F3\u3067\u3044\u3066\u304F\u308C\u305F\u3000\u3042\u306E{\u5B50|\u3053}\u3068\\r\\n\u3061\u3083\u3093\u3068\u3000{\u5411|\u3080}\u304D{\u5408|\u3042}\u3048\u305F\u308F[VAR 0114(0025)]",
  "\u3044\u3063\u3064\u3082\u3000\u3044\u3044\u3068\u3053\u306B\\n{\u51FA|\u3067}\u304F\u308F\u3059\u3000[VAR 0100(0000)]\u3055\u3093\u306B\u3000{\u611F\u8B1D|\u304B\u3093\u3057\u3083}\u306D[VAR 0114(0025)]",
  "{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304B\u3089\u306E\\n\u3061\u3087\u3063\u3068\u3057\u305F\u3000\u304A{\u793C|\u308C\u3044}\u3088\\r\\n{\u5192\u967A|\u307C\u3046\u3051\u3093}\u306B\u3000{\u5F79\u7ACB|\u3084\u304F\u3060}\u3066\u3066\u307B\u3057\u3044\u308F[VAR 0114(0025)]",
  "\u30BF\u30A4\u30E0{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\u306E\\n\u304D\u305A\u306A\u304C\u3000{\u82BD\u751F|\u3081\u3070}\u3048\u305F\uFF01"
]
