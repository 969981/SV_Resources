[
  "{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3000\u30B9\u30DE\u30DB\u3092\u3000\u3057\u307E\u3044\u305F\u307E\u3048\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u3088\u3046[VAR 0114(0029)]",
  "{\u524D|\u307E\u3048}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3067\u306F\u3000\u30D4\u30AF\u30CB\u30C3\u30AF\u3067\u306E\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306E{\u52B9\u679C|\u3053\u3046\u304B}\u3092\u3000{\u8AAC\u660E|\u305B\u3064\u3081\u3044}\u3057\u305F\u306A[VAR 0114(0029)]",
  "{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u3092\u3000\u3064\u3051\u305F\u308A\\n{\u624B\u6301|\u3066\u3082}\u3061\u306E\u30DD\u30B1\u30E2\u30F3\u3000{\u5168\u54E1|\u305C\u3093\u3044\u3093}\u3092\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3067\u304D\\r\\n\u3068\u3066\u3082{\u4FBF\u5229|\u3079\u3093\u308A}\u306A\u3000{\u6CBB\u7642\u624B\u6BB5|\u3061\u308A\u3087\u3046\u3057\u3085\u3060\u3093}\u3060[VAR 0114(0029)]",
  "\u305F\u3060\u3057\u3000\u3042\u305F\u308A{\u524D|\u307E\u3048}\u3060\u304C\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306E\u3067\u304D\u306A\u3044\u3000{\u6226\u95D8\u4E2D|\u305B\u3093\u3068\u3046\u3061\u3085\u3046}\u3084\\r\\n{\u6025|\u3044\u305D}\u3044\u3067\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3057\u305F\u3044{\u5834\u5408|\u3070\u3042\u3044}\u3000\u305D\u3050\u308F\u306A\u3044[VAR 0114(0029)]",
  "\u305D\u3093\u306A\u3068\u304D\u3000{\u4F7F\u7528|\u3057\u3088\u3046}\u3059\u3079\u304D\u306F\\n\u30D5\u30EC\u30F3\u30C9\u30EA\u30A3\u30B7\u30E7\u30C3\u30D7\u3084\u3000{\u8CFC\u8CB7\u90E8|\u3053\u3046\u3070\u3044\u3076}\u3067\u3000{\u8CB7|\u304B}\u3048\u308B\\r\\n[VAR FF00(0006)]\u30AD\u30BA\u3050\u3059\u308A[VAR FF00(0000)]\u306A\u3069\u306E\u3000{\u56DE\u5FA9\u9053\u5177|\u304B\u3044\u3075\u304F\u3069\u3046\u3050}\u3060[VAR 0114(0029)]",
  "{\u56DE\u5FA9\u9053\u5177|\u304B\u3044\u3075\u304F\u3069\u3046\u3050}\u306F\u3000{\u5373\u52B9\u6027|\u305D\u3063\u3053\u3046\u305B\u3044}\u304C\u3000\u3042\u308A\\n\u30D0\u30C3\u30B0\u3092\u3000{\u958B|\u3072\u3089}\u3051\u308B\u3068\u304D\u306F\u3000\u3044\u3064\u3067\u3082\u3000{\u4F7F|\u3064\u304B}\u3048\u308B\\r\\n\u3082\u3061\u308D\u3093\u3000\uFF11{\u5EA6|\u3069}\u3000{\u4F7F|\u3064\u304B}\u3048\u3070\u3000\u306A\u304F\u306A\u308B\u304C\u306A[VAR 0114(0029)]",
  "\u30AD\u30BA\u3050\u3059\u308A\u306E\u3000{\u56DE\u5FA9\u91CF|\u304B\u3044\u3075\u304F\u308A\u3087\u3046}\u306F\u3000\uFF12\uFF10\\n\u3044\u3044\u30AD\u30BA\u3050\u3059\u308A\u306F\u3000\uFF16\uFF10\\r\\n\u3059\u3054\u3044\u30AD\u30BA\u3050\u3059\u308A\u306F\u3000\uFF11\uFF12\uFF10\u2026\u2026[VAR 0114(0029)]",
  "{\u9AD8\u4FA1|\u3053\u3046\u304B}\u306A\u3082\u306E\u307B\u3069\u3000{\u56DE\u5FA9\u91CF|\u304B\u3044\u3075\u304F\u308A\u3087\u3046}\u3082\u3000{\u9AD8|\u305F\u304B}\u304F\u306A\u308B\u306E\u3067\\n\u30B5\u30A4\u30D5\u3068\u3000{\u76F8\u8AC7|\u305D\u3046\u3060\u3093}\u3057\u3064\u3064\u3000\u30B9\u30C8\u30C3\u30AF\u3059\u308B\u3088\u3046\u306B[VAR 0114(0029)]",
  "\u2026\u2026\u3057\u304B\u3057\u3000{\u65C5\u5148|\u305F\u3073\u3055\u304D}\u3067\u306F\\n\u30A4\u30EC\u30AE\u30E5\u30E9\u30FC\u306A\u3053\u3068\u304C\u3000\u3064\u304D\u3082\u306E[VAR 0114(0029)]",
  "{\u60F3\u50CF|\u305D\u3046\u305E\u3046}\u3057\u3066\u307F\u3066\u307B\u3057\u3044\u2026\u2026\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u50B7|\u304D\u305A}\u3064\u304D\u3000\u30AD\u30BA\u3050\u3059\u308A\u304C\u3000\u306A\u3044\\r\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306E{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3082\u3000{\u5C3D|\u3064}\u304D\u305F\\r\\n{\u8FD1|\u3061\u304B}\u304F\u306B\u3000\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u3082\u3000{\u898B|\u307F}\u3042\u305F\u3089\u306A\u3044[VAR 0114(0029)]",
  "[VAR 0100(0000)]\u3055\u3093\u306B\u3000{\u554F|\u3068}\u304A\u3046\\n{\u56DE\u5FA9\u624B\u6BB5|\u304B\u3044\u3075\u304F\u3057\u3085\u3060\u3093}\u304C\u3000\u306A\u3044\u3000{\u5371\u6A5F\u7684\u72B6\u6CC1|\u304D\u304D\u3066\u304D\u3058\u3087\u3046\u304D\u3087\u3046}\u3067\\r\\n{\u5468\u56F2|\u3057\u3085\u3046\u3044}\u3067\u3000{\u63A2|\u3055\u304C}\u3059\u3079\u304D\u3082\u306E\u306F\u3000{\u4F55|\u306A\u306B}\u304B\u306D\uFF1F[VAR 0114(0029)]",
  "{\u6C34\u5834|\u307F\u305A\u3070}",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u5148\u751F|\u305B\u3093\u305B\u3044}",
  "{\u843D|\u304A}\u3061\u3066\u3044\u308B\u3082\u306E",
  "{\u5148|\u3055\u304D}\u307B\u3069\u3000\u3044\u3063\u305F\u3088\u3046\u306B\\n{\u6C34\u5834|\u307F\u305A\u3070}\u304C\u3000\u3042\u308C\u3069\u3000{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u304C\u3000\u306A\u3044\u306E\u3067\\r\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306F\u3067\u304D\u306C\u3000{\u8A2D\u5B9A|\u305B\u3063\u3066\u3044}\u306A\u306E\u3060\u2026\u2026[VAR 0114(0029)]",
  "\u2026\u2026\u3082\u3061\u308D\u3093\u3000{\u8FD1|\u3061\u304B}\u304F\u306B\u3000\u3044\u308C\u3070\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u305F\u3061\u304C\u3000{\u529B|\u3061\u304B\u3089}\u306B\u306A\u308D\u3046\\c\\n\u3060\u304C\u3000\u3044\u3064\u3067\u3082\u3000\u3069\u3053\u3067\u3082\u3000{\u52A9|\u305F\u3059}\u3051\u3066\u304F\u308C\u308B\\n{\u5927\u4EBA|\u304A\u3068\u306A}\u304C\u3000\u3044\u308B\u3068\u306F\u3000{\u601D|\u304A\u3082}\u308F\u306C\u3053\u3068\u3060\u2026\u2026[VAR 0114(0029)]",
  "[VAR 0100(0000)]\u3055\u3093\u3000\u3054{\u540D\u7B54|\u3081\u3044\u3068\u3046}\u3060\\n\u30B5\u30D0\u30A4\u30D0\u30EB{\u77E5\u8B58|\u3061\u3057\u304D}\u306B\u3000{\u9577|\u305F}\u3051\u3066\u3044\u308B\u306A[VAR 0114(0029)]",
  "{\u5468\u56F2|\u3057\u3085\u3046\u3044}\u3067\u3000\u30AD\u30E9\u30EA\u3068\u3000\u304B\u304C\u3084\u304F\u3082\u306E\u3000\u3042\u308C\u3070\\n\u305D\u308C\u306F\u3000{\u843D|\u304A}\u3061\u3066\u3044\u308B\u3082\u306E\u3060\uFF01\\c\\n\u30AA\u30EC\u30F3\u306E\u307F\u3000\u3084\u3000\u30AD\u30BA\u3050\u3059\u308A\u3000\u306A\u3069\\n{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}{\u9053\u5177|\u3069\u3046\u3050}\u3092\u3000{\u62FE|\u3072\u308D}\u3046\u3053\u3068\u304C\u3000\u3067\u304D\u308B\u3084\u3082\u3057\u308C\u3093[VAR 0114(0029)]",
  "\u300E[VAR FF00(0006)]\u30EC\u30C3\u30C4\u30B4\u30FC\u3000\uFF32\u30DC\u30BF\u30F3[VAR FF00(0000)]\u300F\u3067\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n{\u62FE|\u3072\u308D}\u3063\u3066\u3082\u3089\u3046\u3053\u3068\u3082\u3000{\u53EF\u80FD|\u304B\u306E\u3046}\u3060\u305E[VAR 0114(0029)]",
  "\u304D\u306E\u307F\u306F\u3000\u30B7\u30E7\u30C3\u30D7\u306E{\u9053\u5177|\u3069\u3046\u3050}\u3068\u3000{\u9055|\u3061\u304C}\u3044\\n\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u6301|\u3082}\u305F\u305B\u308B\u3068\u3000{\u6226\u95D8\u4E2D|\u305B\u3093\u3068\u3046\u3061\u3085\u3046}\\r\\n\u30DD\u30B1\u30E2\u30F3{\u81EA\u8EAB|\u3058\u3057\u3093}\u3067\u3000{\u8003|\u304B\u3093\u304C}\u3048\u3066\u3000{\u98DF|\u305F}\u3079\u3066\u304F\u308C\u308B[VAR 0114(0029)]",
  "{\u4F7F|\u3064\u304B}\u3044\u3069\u304D\u3092\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n\u307E\u304B\u305B\u3066\u307F\u308B\u306E\u3082\u3000\u307E\u305F\u3000{\u4E00\u8208|\u3044\u3063\u304D\u3087\u3046}\u3060\u306A[VAR 0114(0029)]",
  "\u3068\u3082\u304B\u304F\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u306B\u3000\u3053\u307E\u3063\u305F\u3089\u3000{\u5468\u56F2|\u3057\u3085\u3046\u3044}\u3067\\n\u30AD\u30E9\u30EA\u3068\u3000\u304B\u304C\u3084\u304F\u3082\u306E\u3092\u3000{\u63A2|\u3055\u304C}\u3059\u3088\u3046\u306B[VAR 0114(0029)]",
  "\u304D\u306E\u307F\u3082\u3000{\u898B|\u307F}\u3042\u305F\u3089\u306A\u3051\u308C\u3070\\n\u307B\u304B\u306E{\u65B9\u6CD5|\u307B\u3046\u307B\u3046}\u3067\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3082\u3000\u3067\u304D\u308B\u304C\u2026\u2026\\r\\n\u3069\u3046\u3082\u3000{\u9418|\u304B\u306D}\u306E{\u97F3|\u306D}\u304C\u3000{\u8A31|\u3086\u308B}\u3057\u3066\u304F\u308C\u306A\u3044\u3089\u3057\u3044[VAR 0114(0029)]",
  "{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u7D42\u4E86|\u3057\u3085\u3046\u308A\u3087\u3046}\u3060\\n\u3053\u308C\u306B\u3066\u3000{\u5931\u793C|\u3057\u3064\u308C\u3044}\u3059\u308B[VAR 0114(0029)]"
]
