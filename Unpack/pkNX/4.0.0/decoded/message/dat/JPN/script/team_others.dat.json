[
  "{\u5148\u982D|\u305B\u3093\u3068\u3046}\u304B\u3089\u3000\uFF13{\u5339|\u3073\u304D}\u3081\u307E\u3067\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u3067\\n\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306B\u3000{\u6311|\u3044\u3069}\u307F\u307E\u3059\u304C\u3000\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F",
  "\u3059\u3067\u306B\u3000\u30DC\u30B9\u3092{\u5012|\u305F\u304A}\u3057\u305F\u3000\u30A2\u30B8\u30C8\u3067\u3059\\c\\n{\u5148\u982D|\u305B\u3093\u3068\u3046}\u304B\u3089\u3000\uFF13{\u5339|\u3073\u304D}\u3081\u307E\u3067\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u3067\\n\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306B\u3000{\u6311|\u3044\u3069}\u307F\u307E\u3059\u304C\u3000\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F",
  "{\u5148\u982D|\u305B\u3093\u3068\u3046}\u304B\u3089\u3000\uFF13{\u5339|\u3073\u304D}\u3081\u307E\u3067\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u3067\\n\uFF33\uFF34\uFF23\u3067\u3000\u30C8\u30EC\u30FC\u30CB\u30F3\u30B0\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u307E\u3059\u304B\uFF1F",
  "\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306E\u3000\u30DC\u30B9\u306B\\n\u3075\u305F\u305F\u3073\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3092\u3000{\u6311|\u3044\u3069}\u307F\u307E\u3059\u304B\uFF1F",
  "{\u6226|\u305F\u305F\u304B}\u3048\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\n\uFF13{\u5339|\u3073\u304D}\u3088\u308A\u3000{\u5C11|\u3059\u304F}\u306A\u3044\u306E\u3067\\r\\n\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306B\u3000{\u6311|\u3044\u3069}\u3081\u307E\u305B\u3093",
  "{\u6226|\u305F\u305F\u304B}\u3048\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\n\uFF13{\u5339|\u3073\u304D}\u3088\u308A\u3000{\u5C11|\u3059\u304F}\u306A\u3044\u306E\u3067\\r\\n\uFF33\uFF34\uFF23\u3067\u3000\u30C8\u30EC\u30FC\u30CB\u30F3\u30B0\u3067\u304D\u307E\u305B\u3093",
  "\u3044\u3046\u3053\u3068\u3092\u3000\u304D\u3044\u3066\u304F\u308C\u308B\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3044\u306A\u3044\u306E\u3067\\r\\n\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306B\u3000{\u6311|\u3044\u3069}\u3081\u307E\u305B\u3093",
  "\u3044\u3046\u3053\u3068\u3092\u3000\u304D\u3044\u3066\u304F\u308C\u308B\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3044\u306A\u3044\u306E\u3067\\r\\n\uFF33\uFF34\uFF23\u3067\u3000\u30C8\u30EC\u30FC\u30CB\u30F3\u30B0\u3067\u304D\u307E\u305B\u3093"
]
