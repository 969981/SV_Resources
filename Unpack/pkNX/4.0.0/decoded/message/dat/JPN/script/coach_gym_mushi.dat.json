  "\u3042\u306A\u305F\u306E\u3000[VAR 0101(0001)]\u3061\u3083\u3093\u306F\\n{\u98DF\u6B32|\u3057\u3087\u304F\u3088\u304F}{\u65FA\u76DB|\u304A\u3046\u305B\u3044}\u3067\u3000\u3068\u3063\u3066\u3082\u3000\u30CF\u30F3\u30B0\u30EA\uFF5E\uFF01\\c\\n\u308F\u305F\u3057\u304C\u3000{\u4F5C|\u3064\u304F}\u3063\u305F\u3000\u304A{\u83D3\u5B50|\u304B\u3057}\u3082\\n\u3044\uFF5E\u3063\u3071\u3044\u3000{\u98DF|\u305F}\u3079\u3066\u304F\u308C\u307E\u3059\uFF5E[VAR 0114(0016)]",
  "\u308F\u305F\u3057\u304C\u3000\u304A{\u9001|\u304A\u304F}\u308A\u3057\u305F\\n\u30DF\u30C4\u30CF\u30CB\u30FC\u3061\u3083\u3093\u306F\u3000\u30E1\u30B9\u306A\u306E\u3067\uFF5E\\r\\n\u30D3\u30FC\u30AF\u30A4\u30F3\u307E\u3067\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3057\u307E\u3059\u3088\uFF5E[VAR 0114(0016)]",
  "\u30C8\u30C3\u30D7\u304B\u3089\u3000{\u8A00|\u3044}\u308F\u308C\u305F\u3053\u3068\\n{\u601D|\u304A\u3082}\u3044{\u51FA|\u3060}\u3057\u307E\u3057\u305F\uFF5E\\c\\n[VAR 0100(0000)]\u3055\u3093\\n{\u4E00\u756A|\u3044\u3061\u3070\u3093}{\u597D|\u3059}\u304D\u306A\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306B\\r\\n\u308F\u305F\u3057\u3092\u3000{\u9078|\u3048\u3089}\u3093\u3067\u304F\u308C\u305F\u3063\u3066\uFF5E\\c\\n\u304A{\u83D3\u5B50|\u304B\u3057}\u307F\u305F\u3044\u3000{\u7518|\u3042\u307E}\u304F\u3066\\n{\u512A|\u3084\u3055}\u3057\u3044\u3000{\u8A00\u8449|\u3053\u3068\u3070}\u3092\u3000\u3042\u308A\u304C\u3068\uFF5E\\c\\n{\u4ECA\u5EA6|\u3053\u3093\u3069}\u3000[VAR 0100(0000)]\u3055\u3093{\u5C02\u7528|\u305B\u3093\u3088\u3046}\u306B\\n\u30AB\u30C3\u30D7\u30B1\u30FC\u30AD\u3092\u3000{\u713C|\u3084}\u3044\u3066\u304D\u307E\u3059\u306D\uFF5E\uFF01[VAR 0114(0016)]"
