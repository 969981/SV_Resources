[
  "[VAR 0100(0000)]\u306F\\n[VAR FF00(0008)]\u3044\u308D\u3093\u306A{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}[VAR FF00(0000)]\u3092\u3000{\u624B|\u3066}\u306B{\u5165|\u3044}\u308C\u305F\uFF01",
  "[VAR 0100(0000)]\u306F\u3000\u3044\u308D\u3093\u306A{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3092\\n[VAR FF00(0008)]\u30D4\u30AF\u30CB\u30C3\u30AF[VAR FF00(0000)]\u30DD\u30B1\u30C3\u30C8\u306B\u3000\u3057\u307E\u3063\u305F",
  "\u3055\u3063\u304D\u3000{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3000{\u8CB7|\u304B}\u3044\u3059\u304E\u305F\u304B\u3089\\n\u30A2\u30F3\u30BF\u3000\u3082\u3089\u3063\u3066\u304F\u308C\u308B\u304B\uFF1F",
  "\u30D4\u30AF\u30CB\u30C3\u30AF\u3068\u3044\u3048\u3070\\n\u3084\u3063\u3071\u308A\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\uFF01\\r\\n\u3042\u3052\u305F{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3067\u3000{\u4F5C|\u3064\u304F}\u3063\u3066\u307F\u3066\u3088",
  "\u3064\u3044\u3067\u306B\u3000\u30AA\u30EC\u306E\u30D4\u30AF\u30CB\u30C3\u30AF\u3067\\n\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u3044\u304F\u304B\u3044\uFF1F",
  "\u30AA\u30EC\u306E\u30D4\u30AF\u30CB\u30C3\u30AF\u3078\u3000\u3088\u3046\u3053\u305D\\n\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u3044\u304F\u304B\u3044\uFF1F",
  "\u30A2\u30F3\u30BF\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\\n{\u5143\u6C17|\u3052\u3093\u304D}\u3000\u3044\u3063\u3071\u3044\u3060\u306A\uFF01\\r\\n\u3044\u3064\u3067\u3082\u3000{\u4F11|\u3084\u3059}\u307F\u306B\u304D\u306A\u3088",
  "{\u75B2|\u3064\u304B}\u308C\u3066\u305F\u3089\u3000{\u7121\u7406|\u3080\u308A}\u305B\u305A\u3060\u305C\\n\u3044\u3064\u3067\u3082\u3000{\u4F11|\u3084\u3059}\u307F\u306B\u304D\u306A\u3088",
  "\u30D0\u30C3\u30B0\u306B\u3000{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3000\u3064\u3081\u3059\u304E\u3061\u3083\u3063\u305F\uFF01\\n\u304A\u3059\u305D\u308F\u3051\u3000\u3057\u3066\u3042\u3052\u308B\u306D\uFF01",
  "{\u5916|\u305D\u3068}\u3067{\u98DF|\u305F}\u3079\u308B\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306F\u3000{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\u3088\uFF01\\n\u304A\u3059\u305D\u308F\u3051\u3067\u3000{\u4F5C|\u3064\u304F}\u3063\u3066\u307F\u3066\u306D\uFF01",
  "\u3053\u306E\u307E\u307E\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000\u30D4\u30AF\u30CB\u30C3\u30AF\u3057\u3066\\n\u3061\u3087\u3063\u3068\u3000{\u4F11\u606F|\u304D\u3085\u3046\u305D\u304F}\u3057\u3066\u3044\u3063\u305F\u3089\uFF1F",
  "\u308F\u305F\u3057\u3068\u3000\u30D4\u30AF\u30CB\u30C3\u30AF\u3057\u3066\\n\u3061\u3087\u3063\u3068\u3000{\u4F11\u606F|\u304D\u3085\u3046\u305D\u304F}\u3057\u3066\u3044\u304B\u306A\u3044\uFF1F",
  "\u3042\u306A\u305F\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\\n{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000\u306A\u3063\u305F\u306D\uFF01\\r\\n\u307E\u305F\u3000\u3044\u3064\u3067\u3082\u3000\u304A\u3044\u3067\u3088\uFF01",
  "{\u9060\u616E|\u3048\u3093\u308A\u3087}\u3057\u306A\u304F\u3066\u3000\u3044\u3044\u306E\u306B\u30FC\\n\u307E\u305F\u3000\u3044\u3064\u3067\u3082\u3000\u304A\u3044\u3067\u3088\uFF01",
  "\u3053\u3053\u306F\u3000\u30C6\u30FC\u30D6\u30EB\u30B7\u30C6\u30A3\u3068\\n\u30DC\u30A6\u30EB\u30BF\u30A6\u30F3\u306E\u3000{\u771F|\u307E}\u3093{\u4E2D|\u306A\u304B}\u3042\u305F\u308A\uFF01\\c\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3000{\u98DF|\u305F}\u3079\u305F\u3089\\n{\u5192\u967A\u518D\u958B|\u307C\u3046\u3051\u3093\u3055\u3044\u304B\u3044}\u3000\u304C\u3093\u3070\u308B\u305E\u30FC\uFF01\\c\\n\u2026\u2026\u304D\u307F\u3082\u3000\u304C\u3093\u3070\u308C\u308B\u3088\u3046\u306B\\n{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3000\u308F\u3051\u3066\u3042\u3052\u3061\u3083\u3046\uFF01",
  "\u305D\u3046\u3044\u3048\u3070\u3000\u3053\u306E\u3042\u305F\u308A\u3067\u3000{\u5CA9|\u3044\u308F}\u306E{\u58C1|\u304B\u3079}\u304C\\n{\u52D5|\u3046\u3054}\u3044\u305F\u3063\u3066\u3000{\u805E|\u304D}\u3044\u305F\u3051\u3069\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u304B\u306A\u30FC\uFF1F",
  "{\u58C1|\u304B\u3079}\u304C\u3000{\u52D5|\u3046\u3054}\u3044\u3066\u3082\u3000{\u9A5A|\u304A\u3069\u308D}\u304B\u306A\u3044\u3088\u3046\u306B\\n\u3061\u3087\u3063\u3068\u3060\u3051\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u3044\u304D\u306A\u3088\uFF01",
  "\u304C\u3093\u3070\u308A\u3000{\u8DB3|\u305F}\u308A\u306A\u304F\u306A\u3063\u3061\u3083\u3063\u305F\uFF1F\\n\u3061\u3087\u3063\u3068\u3060\u3051\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u3044\u304D\u306A\u3088\uFF01",
  "{\u4EBA|\u3072\u3068}\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\\n\u304C\u3093\u3070\u308B\u305F\u3081\u306B\u306F\u3000{\u4F11|\u3084\u3059}\u307E\u306A\u3044\u3068\uFF01\\r\\n{\u75B2|\u3064\u304B}\u308C\u305F\u3089\u3000\u307E\u305F{\u6765|\u304D}\u3066\u306D\uFF01",
  "\u305D\u3063\u304B\uFF01\\n{\u7121\u7406|\u3080\u308A}\u3057\u306A\u3044\u3088\u3046\u306B\u306D\uFF01",
  "{\u5742\u9053|\u3055\u304B\u307F\u3061}\u304C\u3000{\u601D|\u304A\u3082}\u3063\u3066\u305F\u3088\u308A\\n\u30AD\u30C4\u304F\u3066\u3000\u3078\u3068\u3078\u3068\u2026\u2026\\c\\n\u3053\u3093\u306A\u3068\u304D\u306F\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u3057\u3066\\n{\u5FC3|\u3053\u3053\u308D}\u3082{\u4F53|\u304B\u3089\u3060}\u3082\u3000\u30EA\u30D5\u30EC\u30C3\u30B7\u30E5\uFF01\\c\\n{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3000\u308F\u3051\u3066\u3042\u3052\u308B\u304B\u3089\\n\u3042\u306A\u305F\u3082\u3000\u30EA\u30D5\u30EC\u30C3\u30B7\u30E5\u306A\u3055\u3044\uFF01",
  "\u304A{\u8179|\u306A\u304B}\u304C\u3000{\u7A7A|\u3059}\u3044\u3066\u305F\u3089\\n\u304C\u3093\u3070\u308C\u308B\u3082\u3093\u3082\u3000\u304C\u3093\u3070\u308C\u306A\u3044\u3082\u3093\uFF01",
  "{\u65C5|\u305F\u3073}\u306F{\u9053\u9023|\u307F\u3061\u3065}\u308C\u3000{\u4E16|\u3088}\u306F{\u60C5|\u306A\u3055}\u3051\uFF01\\n{\u6D41|\u306A\u304C}\u308C\u3067\u3000\u30EA\u30D5\u30EC\u30C3\u30B7\u30E5\u3057\u3066\u3044\u304F\uFF1F",
  "\u3042\u306A\u305F\u3082\u3000{\u5742\u9053|\u3055\u304B\u307F\u3061}\u3067\u3000{\u75B2|\u3064\u304B}\u308C\u305F\u306E\uFF1F\\n\u3061\u3087\u3063\u3068\u3000\u30EA\u30D5\u30EC\u30C3\u30B7\u30E5\u3057\u3066\u307F\u308B\uFF1F",
  "\u304A\u3044\u3057\u3044{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u3067\u3000\u30EA\u30D5\u30EC\u30C3\u30B7\u30E5\uFF01\uFF01\\n\u3053\u307E\u3063\u305F\u3068\u304D\u306F\u3000\u304A\u305F\u304C\u3044\u3055\u307E\uFF01\\r\\n\u3057\u3093\u3069\u304F\u306A\u3063\u305F\u3089\u3000{\u58F0|\u3053\u3048}\u304B\u3051\u3066\u306D",
  "\u3055\u3059\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u308F\u306D\uFF01\\n\u3042\u30FC\u3093\u3000\u3046\u3089\u3084\u307E\u3057\u3044\u30FC\uFF01",
  "\u3044\u3044{\u666F\u8272|\u3051\u3057\u304D}\u3092\u3000{\u898B|\u307F}\u306A\u304C\u3089\u3000{\u98DF|\u305F}\u3079\u308B\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306F\u3000{\u683C\u5225|\u304B\u304F\u3079\u3064}\u3060\u3063\u306F\u3063\u306F\uFF01\\c\\n{\u51FA\u4F1A|\u3067\u3042}\u3048\u305F{\u8A18\u5FF5|\u304D\u306D\u3093}\u306B\u3000\u30D7\u30EC\u30BC\u30F3\u30C8\uFF01\\n\u30AD\u30DF\u3082\u3000{\u65C5|\u305F\u3073}\u3092\u3000{\u5473|\u3042\u3058}\u308F\u3044\u306A\u3088\uFF01\uFF01",
  "\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000{\u98DF|\u305F}\u3079\u308B\u3068\\n{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u304C\u3000\u307F\u306A\u304E\u3063\u3066\\r\\n{\u65C5|\u305F\u3073}\u304C\u3000{\u697D|\u305F\u306E}\u3057\u304F\u306A\u308B\u3093\u3060\u3063\u306F\u3063\u306F\uFF01",
  "\u3064\u3044\u3067\u306B\u3000\u3053\u3053\u3044\u3089\u3067\\n{\u8DB3|\u3042\u3057}\u3092{\u6B62|\u3068}\u3081\u3066\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u3044\u304F\u304B\u3044\uFF1F",
  "\u305F\u307E\u306B\u306F\u3000{\u8DB3|\u3042\u3057}\u3092{\u6B62|\u3068}\u3081\u3066\\n{\u666F\u8272|\u3051\u3057\u304D}\u3092\u3000{\u898B|\u307F}\u306A\u304C\u3089\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u3044\u304F\u304B\u3044\uFF1F",
  "\u304C\u3093\u3070\u308B\u306E\u3082\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u3060\u304C\\n\u305F\u307E\u306B\u306F\u3000{\u8DB3|\u3042\u3057}\u3092{\u6B62|\u3068}\u3081\u3066\u307F\u3088\uFF01\\r\\n\u305D\u3046\u3057\u3066\u3000{\u898B|\u307F}\u3048\u308B{\u666F\u8272|\u3051\u3057\u304D}\u3082\u3000\u3042\u308B\u3093\u3060\u3063\u306F\u3063\u306F\uFF01",
  "{\u751F|\u3044}\u304D{\u6025|\u3044\u305D}\u3050\u306E\u3082\u3000\u3088\u3057\uFF01\\n\u3082\u3057\u3000{\u6B62|\u3068}\u307E\u308A\u305F\u304F\u306A\u3063\u305F\u3089\\r\\n\u3044\u3064\u3067\u3082\u3000{\u6765|\u304D}\u306A\u3055\u3044",
  "\u30DE\u30EA\u30CA\u30FC\u30C9{\u5E02\u5834|\u3044\u3061\u3070}\u3067\u3000{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\\n\u304A{\u5F97|\u3068\u304F}\u306B\u3000{\u8CB7|\u304B}\u3063\u3061\u3083\u3063\u305F\uFF01\uFF01\\c\\n\u3067\u3082\u3000{\u98DF|\u305F}\u3079\u304D\u308C\u306A\u3044\u304B\u3089\\n\u3042\u306A\u305F\u306B\u3000\u30D5\u30A9\u30FC\u30E6\u30FC\uFF01",
  "\u304A{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u3068\u3000{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3059\u308B\u3068\u304D\u306B\\n\u3044\u308D\u3093\u306A{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3092\u3000{\u6301|\u3082}\u3063\u3066\u304A\u304F\u3068\\c\\n{\u5909|\u3078\u3093}\u306A\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\\n{\u4F5C|\u3064\u304F}\u308C\u3066\u3000{\u697D|\u305F\u306E}\u3057\u3044\u306E\u3088\u306D\u30FC\uFF01",
  "\u2026\u2026\u305D\u3046\u3060\uFF01\u3000\u3053\u306E\u3042\u305F\u308A\\n\u3051\u308F\u3057\u3044\u304B\u3089\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u3044\u304D\u306A\u3088\u30FC\uFF01",
  "\u3053\u3053\u304B\u3089\u3000{\u5317|\u304D\u305F}\u3082{\u5357|\u307F\u306A\u307F}\u3082\u3000\u3051\u308F\u3057\u3044\u304B\u3089\\n{\u884C|\u3044}\u304F\u306A\u3089\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u3044\u304D\u306A\u3088\u30FC\uFF01",
  "\u3044\u3063\u3071\u3044\u3000{\u4F11|\u3084\u3059}\u3081\u305F\u3067\u3057\u3087\uFF01\\n{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3000\u3044\u3063\u3066\u3089\u3063\u3057\u3083\u30FC\u3044\uFF01",
  "{\u897F|\u306B\u3057}\u306E\u3000\u30DE\u30EA\u30CA\u30FC\u30C9\u30BF\u30A6\u30F3\u306B\u3000{\u884C|\u3044}\u304F\u306A\u3089\\n{\u4F59\u8A08|\u3088\u3051\u3044}\u306A\u304A{\u4E16\u8A71|\u305B\u308F}\u3000\u3060\u3063\u305F\u304B\u3082\u306D\u30FC\uFF01",
  "\u30AA\u30FC\u30B8\u30E3\u306E{\u6E56|\u307F\u305A\u3046\u307F}\u3067\u3000{\u5909|\u3078\u3093}\u306A\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u898B|\u307F}\u3066\u305F\u3089\u3000\u3072\u3089\u3081\u3044\u305F\u3093\u3060\uFF01\\c\\n{\u6E3E\u8EAB|\u3053\u3093\u3057\u3093}\u306E\u30EC\u30B7\u30D4\u3067\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\\n\u305C\u3072\u3068\u3082\u3000{\u4F5C|\u3064\u304F}\u3063\u3066\u307F\u3066\u304F\u308C\u3088\uFF01",
  "[VAR 0100(0000)]\u306F\u3000[VAR FF00(0006)]\u30B9\u30B7\u3075\u3046\u30B5\u30F3\u30C9[VAR FF00(0000)]\u3092\\n{\u4F5C|\u3064\u304F}\u308C\u308B\u3088\u3046\u306B\u3000\u306A\u3063\u305F\uFF01",
  "{\u666E\u901A|\u3075\u3064\u3046}\u3000\u30B9\u30B7\u306F\u3000\u30D1\u30F3\u3058\u3083\u306A\u304F\u3066\\n\u30E9\u30A4\u30B9\u306B\u3000{\u4E57|\u306E}\u305B\u3066\u3000{\u98DF|\u305F}\u3079\u308B\u3088\u306A\\c\\n\u2026\u2026\u3064\u307E\u308A\u3000\u30B9\u30B7\u3092\u3000\u30D1\u30F3\u306B\\n{\u4E57|\u306E}\u305B\u308B\u3068\u3000\uFF12{\u500D|\u3070\u3044}\u3000\u304A\u3044\u3057\u3044\u3093\u3060\u3088\uFF01",
  "{\u6E56|\u307F\u305A\u3046\u307F}\u3067\u3000{\u4F1A|\u3042}\u3063\u305F\u306E\u3082\u3000{\u4F55|\u306A\u306B}\u304B\u306E{\u7E01|\u3048\u3093}\u3060\uFF01\\n\u3072\u3068{\u606F|\u3044\u304D}\u3000\u3064\u3044\u3066\u3044\u304D\u306A\u3088\uFF01",
  "{\u6E56|\u307F\u305A\u3046\u307F}\u306E\u307B\u3068\u308A\u3067\u3000\u30D4\u30AF\u30CB\u30C3\u30AF\uFF01\\n{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\u3060\u308D\uFF1F\u3000\u3072\u3068{\u606F|\u3044\u304D}\u3000\u3064\u3044\u3066\u304F\u304B\uFF1F",
  "{\u6E56|\u307F\u305A\u3046\u307F}\u306E\u307B\u3068\u308A\u3063\u3066\u3000\u306A\u3093\u3067\\n\u3053\u3093\u306A\u306B\u3000{\u6C17\u6301|\u304D\u3082}\u3061\u3044\u3044\u3093\u3060\uFF1F\\r\\n\u304A\u304B\u3052\u3067\u3000\u3059\u3063\u304B\u308A\u3000\u3044\u3084\u3055\u308C\u305F\u308D\uFF01",
  "{\u6E56|\u307F\u305A\u3046\u307F}\u3000{\u611F|\u304B\u3093}\u3058\u305F\u304F\u306A\u3063\u305F\u3089\\n\u3044\u3064{\u4F55\u6642|\u306A\u3093\u3069\u304D}\u3067\u3082\u3000{\u8A00|\u3044}\u3044\u306A\u3088"
]
