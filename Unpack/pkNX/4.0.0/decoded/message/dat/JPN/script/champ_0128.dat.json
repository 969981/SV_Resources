[
  "\u3093\u30B8\u30E3\u30AB\u3000\u30D1\u30FC\u30F3\uFF01\uFF01\\n\u3053\u3053\u3067\u3000{\u6226|\u305F\u305F\u304B}\u3046\u3088\u30FC\uFF01[VAR 0114(0004)]",
  "\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u306F\u3000\u3053\u3093\u306A{\u611F|\u304B\u3093}\u3058\u304B\u30FC\uFF01\\n\u3075\u3080\u3075\u3080\uFF01\u3000{\u8981|\u3088\u3046}\u30C1\u30A7\u30C3\u30AF\u3060\u306D\uFF01[VAR 0114(0004)]",
  "\u30DD\u30B1\u30E2\u30F3\u306E{\u8DB3|\u3042\u3057}\u306E\u3000\u3075\u3093\u3070\u308A\u3068\u304B\u306B\\n\u3061\u3087\u3063\u3074\u308A\u3000{\u5F71\u97FF|\u3048\u3044\u304D\u3087\u3046}\u3042\u308B\u304B\u3082\u3067\u3057\u3087\uFF01[VAR 0114(0004)]",
  "{\u5F37\u5F15|\u3054\u3046\u3044\u3093}\u306B\u3000\u3064\u308C\u3066\u304D\u3061\u3083\u3063\u305F\u3051\u3069\\n\u30B8\u30E0{\u524D|\u307E\u3048}\u306E\u3000{\u6E96\u5099\u904B\u52D5|\u3058\u3085\u3093\u3073\u3046\u3093\u3069\u3046}\u3063\u3066\u3053\u3068\u3067\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\uFF01\\n{\u5B9F|\u307F\u306E}\u308A\u3042\u308B{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3092\u3000\u3057\u3088\u3063\uFF01[VAR 0114(0004)]",
  "\u3053\u306E{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u308F\u305F\u3057\u306E{\u8CA0|\u307E}\u3051\uFF01\\n\u3059\u3063\u3054\u304F\u3000{\u5F37|\u3064\u3088}\u304F\u306A\u3063\u3066\u308B\u30FC\uFF01[VAR 0114(0004)]",
  "\u3053\u306E{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u308F\u305F\u3057\u306E{\u52DD|\u304B}\u3061\u3000\u3060\u306D\uFF01\\n\u3067\u3082\u3000\u30CA\u30A4\u30B9\u30D5\u30A1\u30A4\u30C8\u3000\u3060\u3063\u305F\u3088\uFF01[VAR 0114(0004)]",
  "\u3046\u3093\u3000\u3044\u3044\u306D\\n\u3082\u3046\u3000\u305D\u308D\u305D\u308D\u3060\u306D\u2026\u2026\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\\n{\u4F53\u6E29|\u304B\u3089\u3060\u3042\u3063\u305F}\u307E\u3063\u3066\u3000{\u6E96\u5099\u4E07\u7AEF|\u3058\u3085\u3093\u3073\u3070\u3093\u305F\u3093}\u3060\uFF01\\r\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u306E\u304A{\u793C|\u308C\u3044}\u306B\u3000\u3053\u308C\u3000\u3069\u3046\u305E\uFF01[VAR 0114(0004)]",
  "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u307E\u3067\u3000\u3082\u3046{\u5C11|\u3059\u3053}\u3057\uFF01\\n{\u6B8B|\u306E\u3053}\u308A\uFF12\u3064\u3000\u304C\u3093\u3070\u3063\u3066\uFF01[VAR 0114(0004)]",
  "{\u53D7\u4ED8|\u3046\u3051\u3064\u3051}\u307E\u3067\u3000{\u9001|\u304A\u304F}\u3063\u3066\u304F\u306D\uFF01[VAR 0114(0004)]"
]
