[
  "\u3093\u30B8\u30E3\u30AB\u3000\u30D1\u30FC\u30F3\uFF01\uFF01[VAR 0114(0004)]",
  "\u3053\u308C\u304B\u3089\u3000[VAR 0100(0000)]\u304C\\n{\u66AE|\u304F}\u3089\u3059\u3000{\u90E8\u5C4B|\u3078\u3084}\u3067\u30FC\u3059\uFF01[VAR 0114(0004)]",
  "\u2026\u2026\u3063\u3066\u3000\u308F\u305F\u3057\u3082\\n{\u521D|\u306F\u3058}\u3081\u3066\u3000{\u5165|\u306F\u3044}\u308B\u3093\u3060\u3051\u3069[VAR 0114(0004)]",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3000{\u521D\u65E5|\u3057\u3087\u306B\u3061}\u304B\u3089\\n\u3044\u308D\u3044\u308D\u3042\u3063\u3066\u3000{\u75B2|\u3064\u304B}\u308C\u305F\u3067\u3057\u3087\u30FC\\r\\n\u30D9\u30C3\u30C9\u3067\u3000\u3086\u3063\u304F\u308A\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u306D\uFF01[VAR 0114(0004)]",
