[
  "\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u2026\u2026",
  "[VAR 0100(0000)]\u3088\u306D\uFF01\uFF1F\\n\u3042\u305F\u3057\u3000\u30BC\u30A4\u30E6\u3060\u3051\u3069\uFF01[VAR 0114(0044)]",
  "{\u805E|\u304D}\u3044\u305F\u308F\u3088\uFF01\u3000\u3042\u3093\u305F\u3000{\u4ECA|\u3044\u307E}\\n\u30D6\u30EB\u30FC\u30D9\u30EA\u30FC{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306B\u3000{\u7559\u5B66|\u308A\u3085\u3046\u304C\u304F}\u3057\u3066\u308B\u3093\u3060\u3063\u3066\uFF01\uFF1F[VAR 0114(0044)]",
  "\u3075\u3075\u3093\uFF01\u3000{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304B\u3089\u3000{\u805E|\u304D}\u3044\u305F\u306E\uFF01\\n\u307E\u3055\u304B\u3000\u3042\u3093\u305F\u304C\u3000\u30D6\u30EB\u30D9\u30EA\u306B\u3000\u3044\u308B\u3068\u306F\u306D[VAR 0114(0044)]",
  "\u3053\u3061\u3068\u3089\u3000{\u88CF|\u3046\u3089}\u306F\u3000\u3068\u308C\u3066\u3093\u306E\uFF01\\n\u3057\u3087\u3063\u3071\u3044{\u5618|\u3046\u305D}\u3000\u3064\u3044\u3066\u3082\u3000{\u7121\u99C4|\u3080\u3060}\u3088\uFF01[VAR 0114(0044)]",
  "\u306D\u3048\u3000\u3072\u3055\u3057\u3076\u308A\u306B\\n\u3061\u3087\u3063\u3068\u3000{\u9854\u898B|\u304B\u304A\u307F}\u305B\u306A\u3055\u3044\u3088\uFF01[VAR 0114(0044)]",
  "\u3048\u30FC\u3068\u3000\u305D\u3046\u306D\u2026\u2026\\n\u30C6\u30E9\u30EA\u30A6\u30E0\u30C9\u30FC\u30E0\u306B\u306F\u3000{\u884C|\u3044}\u3063\u305F\uFF1F[VAR 0114(0044)]",
  "\u30C9\u30FC\u30E0\u306E{\u4E2D\u5FC3|\u3061\u3085\u3046\u3057\u3093}\u306B\\n\u30BB\u30F3\u30BF\u30FC\u30B9\u30AF\u30A8\u30A2\u3063\u3066\u3000{\u5E83\u5834|\u3072\u308D\u3070}\u304C\u3000\u3042\u308B\u304B\u3089\\r\\n\u305D\u3053\u3067\u3000{\u5F85|\u307E}\u3061{\u5408|\u3042}\u308F\u305B\u3000\u3057\u307E\u3057\u3087\uFF01\\r\\n{\u5F85|\u307E}\u305F\u305B\u305F\u3089\u2026\u2026\u3000\u308F\u304B\u3063\u3066\u308B\u308F\u3088\u306D\uFF1F[VAR 0114(0044)]"
]
