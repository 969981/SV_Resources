[
  "\u30D8\u30A4\u3000\u30E9\u30C3\u30B7\u30E3\u30A4\uFF01\\n\u30AB\u30E9\u30D5\u30B8\u30E0\u3078\u3000\u3088\u3046\u3053\u305D\u304A\uFF01[VAR 0114(0018)]",
  "\u3063\u3066\u3000\u30A6\u30AA\u30FC\u30C3\uFF01\uFF1F\\n\u306A\u3093\u3060\u3000\u304A{\u524D|\u307E\u3048}\u3055\u3093\u3060\u3063\u305F\u304B\u3044\uFF01\\r\\n{\u5225|\u3079\u3064}\u306E\u304A{\u5BA2|\u304D\u3083\u304F}\u3055\u3093\u3068\u3000{\u52D8\u9055|\u304B\u3093\u3061\u304C}\u3044\u3057\u3068\u3063\u305F\uFF01[VAR 0114(0018)]",
  "\u30C8\u30C3\u30D7\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\uFF1F",
  "{\u4EE3|\u304B}\u308F\u308A\u306B{\u6765|\u304D}\u307E\u3057\u305F",
  "\u307B\u3046\uFF01\u3000\u305D\u3046\u304B\u3044\u3000\u305D\u3046\u304B\u3044\uFF01\\n\u30AA\u30E2\u30C0\u30AB{\u5B22|\u3058\u3087\u3046}\u306E\u3000{\u8A08|\u306F\u304B}\u3089\u3044\u304B\u3044\uFF01[VAR 0114(0018)]",
  "\u3064\u3044\u3053\u306E{\u9593|\u3042\u3044\u3060}\\n\u30D0\u30C3\u30B8{\u96C6|\u3042\u3064}\u3081\u3068\u3063\u305F\u3000\u304A{\u524D|\u307E\u3048}\u3055\u3093\u304C\\r\\n\u3082\u3046\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u3068\u306F\u306A\u3042\uFF01[VAR 0114(0018)]",
  "\u307E\u308B\u3067\u3000{\u51FA\u4E16\u9B5A|\u3057\u3085\u3063\u305B\u3046\u304A}\u30DD\u30B1\u30E2\u30F3\uFF01\\n\u30D4\u30C1\u30D4\u30C1\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3067\u3000{\u5927\u6F01|\u305F\u3044\u308A\u3087\u3046}\u3060\u3044\uFF01[VAR 0114(0018)]",
  "\u305D\u3093\u306A{\u51FA\u4E16\u982D|\u3057\u3085\u3063\u305B\u304C\u3057\u3089}\u3000\u3058\u304D\u3058\u304D\u306B\u3000\u30AA\u30A4\u30E9\u3092\\n{\u898B\u6975|\u307F\u304D\u308F}\u3081\u306B\u3000{\u6765|\u304D}\u3066\u304F\u308C\u308B\u3068\u306F\u306A\u3042\uFF01[VAR 0114(0018)]",
  "\u3053\u3061\u3068\u3089\u3000{\u8A55\u4FA1|\u3072\u3087\u3046\u304B}\u3055\u308C\u308B\u306E\u306F\\n\u30EC\u30B9\u30C8\u30E9\u30F3{\u7D4C\u55B6|\u3051\u3044\u3048\u3044}\u3067\u3000{\u6163|\u306A}\u308C\u3063\u3053\u3060\u3044[VAR 0114(0018)]",
  "\u3055\u3042\u3066\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC{\u8DB3|\u305F}\u308A\u3048\u308B\u304B\\n\u30AA\u30A4\u30E9\u3068\u3000\u3072\u3068{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3044\u3063\u3068\u304F\u304B\u3044\uFF1F[VAR 0114(0018)]",
  "\u30D8\u30A4\u3000\u30E9\u30C3\u30B7\u30E3\u30A4\uFF01\u3000\u3069\u3046\u3060\u3044\uFF1F\\n\u30AA\u30A4\u30E9\u3068\u3000\u3072\u3068{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3044\u3063\u3068\u304F\u304B\u3044\uFF1F[VAR 0114(0018)]",
  "\u3088\u3063\u3057\u3083\uFF01\\n\u304A\u3058\u3055\u3093\u306B\u3000\u3064\u3044\u3066\u304D\u306A\uFF01[VAR 0114(0018)]",
  "{\u5177\u6750|\u3050\u3056\u3044}\u3068\u3000\u30B1\u30F3\u30AB\u306F\u3000{\u65EC|\u3057\u3085\u3093}\u304C\u3000{\u547D|\u3044\u306E\u3061}\uFF01\\n{\u50B7|\u3044\u305F}\u307E\u306D\u3048\u3046\u3061\u306B\u3000{\u623B|\u3082\u3069}\u3063\u3066\u3053\u3044\u3088\u304A\uFF01[VAR 0114(0018)]"
]
