  "\u30EA\u30C3\u30D7\u3000\u3068\u3063\u3066\u3082\u3000{\u5FD9|\u3044\u305D\u304C}\u3057\u3044\u3051\u3069\\n[VAR 0100(0000)]\u3061\u3083\u3093\u304C\u3000{\u547C|\u3088}\u3093\u3067\u304F\u308C\u305F\u3089\\r\\n\u3044\u3064\u3060\u3063\u3066\u3000\u3061\u3087\u3063\u3071\u3084\u3067\u3000{\u6765|\u304F}\u308B\u308F[VAR 0114(001C)]",
  "\u30AD\u30CF\u30C0\u3061\u3083\u3093\u3063\u3066\\n\u3061\u3083\u3042\u3093\u3068\u3000{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3000\u3084\u3063\u3066\u308B\uFF1F\\r\\n{\u6614|\u3080\u304B\u3057}\u304B\u3089\u3000\u3042\u306E{\u5B50|\u3053}\u3000\u305D\u305D\u3063\u304B\u3057\u3044\u306E[VAR 0114(001C)]",
  "{\u540C|\u304A\u306A}\u3058{\u4F53\u52E2|\u305F\u3044\u305B\u3044}\u3067\u3000\u305A\u3063\u3068\\n{\u904E|\u3059}\u3054\u3057\u3066\u308B\u306E\u306F\u3000\u3088\u304F\u306A\u3044\u306E\\c\\n\u305D\u3046\u3044\u3046\u3068\u304D\u3000\u3069\u3046\u3059\u308B\u304B\u3063\u3066\uFF1F\\n\u3093\u3075\u3063\uFF01\u3000{\u559C\u6012\u9A5A\u697D|\u304D\u3069\u304D\u3087\u3046\u3089\u304F}\u30A8\u30AF\u30B5\u30B5\u30A4\u30BA\u3088[VAR 0114(001C)]",
  "[VAR 0101(0001)]\u3061\u3083\u3093\u306F\\n\u3068\u3063\u3066\u3082\u3000\u3044\u3044{\u7D20\u6750|\u305D\u3056\u3044}\\r\\n{\u7F8E|\u3046\u3064\u304F}\u3057\u304F\u3000{\u80B2|\u305D\u3060}\u3066\u3066\u3044\u304F\u308F\u306D[VAR 0114(001C)]",
  "\u30EA\u30C3\u30D7\u306E\u3000\u30D2\u30E9\u30D2\u30CA\u3061\u3083\u3093\\n{\u8ABF\u5B50|\u3061\u3087\u3046\u3057}\u306F\u3000\u3069\u3046\u304B\u3057\u3089\uFF1F\\c\\n\u30B4\u30A4\u30B9\u30FC\u3067\u3000\u30E8\u30FC\u30C4\u30FC\u3067\\n\u30AF\u30EA\u30D3\u30C4\u3057\u3061\u3083\u3046\u3000{\u7D20\u6750|\u305D\u3056\u3044}\u3067\u3057\u3087[VAR 0114(001C)]",
  "[VAR 0100(0000)]\u3061\u3083\u3093\u3000\u3042\u306A\u305F\u2026\u2026\\n{\u4E00\u756A|\u3044\u3061\u3070\u3093}{\u597D|\u3059}\u304D\u306A\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306B\\r\\n\u30EA\u30C3\u30D7\u3092\u3000{\u9078|\u3048\u3089}\u3093\u3067\u304F\u308C\u305F\u306E\u306D\\c\\n\u3042\u306E{\u4EBA|\u3072\u3068}\u2026\u2026\\n\u30AA\u30E2\u30C0\u30AB\u3061\u3083\u3093\u304C\u3000{\u6559|\u304A\u3057}\u3048\u3066\u304F\u308C\u305F\u306E\\c\\n{\u8A00|\u3044}\u3063\u3066\u304F\u308C\u308C\u3070\u3000\u3059\u3050\u306B\u3067\u3082\\n{\u56F2|\u304B\u3053}\u3044\u306B\u3000\u3044\u3063\u305F\u306E\u306B\u2026\u2026\\c\\n\u30EA\u30C3\u30D7\u3082\u3000\u3042\u306A\u305F\u306E\u3053\u3068\u3000\u304A{\u6C17|\u304D}\u306B\u3060\u304B\u3089\\n\u3093\u3075\u3063\u2026\u2026\uFF01\u3000{\u76F8\u601D|\u305D\u3046\u3057}{\u76F8\u611B|\u305D\u3046\u3042\u3044}\u306D[VAR 0114(001C)]"
]
