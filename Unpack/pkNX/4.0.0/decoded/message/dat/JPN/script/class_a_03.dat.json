[
  "\u3069\u304A\u3082\u3000\u3069\u304A\u3082\\n\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u307E\u3057\u3087\u3046\u304B\u3042[VAR 0114(002A)]",
  "{\u524D\u56DE|\u305C\u3093\u304B\u3044}\u306F\u3000\u30BF\u30DE\u30B4\u306E\\n{\u5927\u5207|\u305F\u3044\u305B\u3064}\u3055\u3092\u3000\u304A{\u4F1D|\u3064\u305F}\u3048\u3057\u305F\u3093\u3067\u3057\u305F[VAR 0114(002A)]",
  "\u3042\u3042\u3000\u305D\u3046\u3044\u3048\u3070\u3000\u307F\u306A\u3055\u3093\u306F\\n\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u304F\u308C\u3066\u307E\u3059\uFF1F[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u306F\u3000\u30BF\u30DE\u30B4\u304B\u3089\\n{\u751F|\u3046}\u307E\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u3061\u3083\u3042\u3093\u3068\\r\\n{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3055\u308C\u308B\u306E\u3067\u3000{\u5B89\u5FC3|\u3042\u3093\u3057\u3093}\u3057\u3066\u304F\u3060\u3055\u3044\u306D\u3048[VAR 0114(002A)]",
  "\u3048\u3078\u3078\u2026\u2026\u3000\u3058\u3064\u306F\\n\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u30A2\u30D7\u30EA\u306F\\r\\n\u307C\u304F\u304C\u3000{\u4F5C|\u3064\u304F}\u3063\u305F\u3093\u3067\u3059\u3088[VAR 0114(002A)]",
  "\u3053\u306E{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3067\u3000{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3059\u308B\u3088\u308A\\n\u305A\u30FC\u3063\u3068{\u524D|\u307E\u3048}\u306B\u3000\u306A\u308A\u307E\u3059\u304C[VAR 0114(002A)]",
  "\u307C\u304F\u306F\u3000{\u7814\u7A76\u54E1|\u3051\u3093\u304D\u3085\u3046\u3044\u3093}\u3060\u3063\u305F\u3093\u3067\u3059[VAR 0114(002A)]",
  "\u305D\u306E\u3068\u304D\u306F\u3000\u307E\u3060\\n\u30AF\u30E9\u30D9\u30EB{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3082\u3000{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3058\u3083\u306A\u304F\u3066\\r\\n{\u540C|\u304A\u306A}\u3058{\u65BD\u8A2D|\u3057\u305B\u3064}\u3067\u3000{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u3057\u3066\u307E\u3057\u305F[VAR 0114(002A)]",
  "{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u6BCE\u65E5|\u307E\u3044\u306B\u3061}\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u3067\u304D\u3066\u3000{\u697D|\u305F\u306E}\u3057\u304B\u3063\u305F\u306A\u3042\u2026\u2026\\r\\n{\u6012|\u304A\u3053}\u3089\u308C\u3066\u3070\u304B\u308A\u3000\u3067\u3057\u305F\u3051\u3069\u306D\u3048[VAR 0114(002A)]",
  "\u3042\u308C\u2026\u2026\uFF1F\u3000\u306A\u3093\u3067\u3000\u3053\u3093\u306A{\u8A71|\u306F\u306A\u3057}\u306B\uFF1F\\n{\u56F3\u9451|\u305A\u304B\u3093}\u306E{\u8A71|\u306F\u306A\u3057}\u3092\u3000\u3057\u3066\u305F\u306F\u305A\u306A\u306E\u306B\u306A\u3042[VAR 0114(002A)]",
  "\u2026\u2026\u305D\u3046\u3060\u3000{\u4ECA\u65E5|\u304D\u3087\u3046}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u6355\u7372|\u307B\u304B\u304F}\u3092\u3000{\u6559|\u304A\u3057}\u3048\u306A\u304F\u3061\u3083[VAR 0114(002A)]",
  "\u307F\u306A\u3055\u3093\u3000{\u77E5|\u3057}\u3063\u3066\u308B\u3088\u3046\u306B\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6355|\u3064\u304B}\u307E\u3048\u308B\u306B\u306F\u3000\u307E\u305A\\r\\n{\u76F8\u624B|\u3042\u3044\u3066}\u306E{\u4F53\u529B|\u305F\u3044\u308A\u3087\u304F}\u3092\u3000{\u6E1B|\u3078}\u3089\u3057\u307E\u3059\u3088\u306D\u3048[VAR 0114(002A)]",
  "\u3067\u306F\u3000{\u4F53\u529B|\u305F\u3044\u308A\u3087\u304F}\u3092\u3000{\u6E1B|\u3078}\u3089\u3059{\u4EE5\u5916|\u3044\u304C\u3044}\u306B\u3082\\n{\u6226\u95D8\u4E2D|\u305B\u3093\u3068\u3046\u3061\u3085\u3046}\u3000\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6355|\u3064\u304B}\u307E\u3048\u3084\u3059\u304F\u3059\u308B\\r\\n\u30C6\u30AF\u30CB\u30C3\u30AF\u304C\u3000\u3042\u308B\u306E\u306F\u3000{\u77E5|\u3057}\u3063\u3066\u307E\u3059\u304B\u3042\uFF1F[VAR 0114(002A)]",
  "\u304D\u306E\u307F\u3092\u3042\u3052\u308B",
  "{\u72B6\u614B\u7570\u5E38|\u3058\u3087\u3046\u305F\u3044\u3044\u3058\u3087\u3046}\u306B\u3059\u308B",
  "{\u529B|\u3061\u304B\u3089}\u306E{\u5DEE|\u3055}\u3092{\u898B|\u307F}\u305B\u308B",
  "\u3042\u308C\u308C\u30FC\uFF1F\u3000\u3082\u3057\u304B\u3057\u3066\\n\u3088\u305D\u306E{\u5730\u65B9|\u3061\u307B\u3046}\u306E\u3000{\u8A71|\u306F\u306A\u3057}\u3067\u3059\u304B\u306D\u3048\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2\u3067\u306F\u3000\u3061\u3087\u304A\u3063\u3068\\n{\u8A8D\u8B58|\u306B\u3093\u3057\u304D}\u304C\u3000{\u9055|\u3061\u304C}\u3046\u304B\u3082\u3067\u3059\u2026\u2026[VAR 0114(002A)]",
  "\u308F\u3042\u30FC\u3000[VAR 0100(0000)]\u3055\u3093\\n\u3059\u3054\u3044\uFF01\u3000\u3042\u305F\u308A\u3067\u3059\uFF01[VAR 0114(002A)]",
  "\u304A\u304A\u3063\u3068\u3000[VAR 0100(0000)]\u3055\u3093\\n{\u767A\u60F3|\u306F\u3063\u305D\u3046}\u304C\u3000\u30EF\u30A4\u30EB\u30C9\u3067\u3059\u306D\u3048\u2026\u2026\\c\\n\u305F\u3057\u304B\u306B\u3000{\u5F37|\u3064\u3088}\u3044\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u51FA|\u3060}\u305B\u3070\\n{\u6226\u95D8|\u305B\u3093\u3068\u3046}\u306F\u3000{\u6709\u5229|\u3086\u3046\u308A}\u306B\u3000{\u904B|\u306F\u3053}\u3079\u307E\u3059\u3051\u3069\u3082[VAR 0114(002A)]",
  "\u306F\u3044\u3000{\u72B6\u614B\u7570\u5E38|\u3058\u3087\u3046\u305F\u3044\u3044\u3058\u3087\u3046}\u306B\u3000\u3059\u308C\u3070\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6355|\u3064\u304B}\u307E\u3048\u3084\u3059\u3044\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "{\u7279|\u3068\u304F}\u306B\u3000\u306D\u3080\u308A{\u72B6\u614B|\u3058\u3087\u3046\u305F\u3044}\u3067\u306F\\n{\u6355\u7372\u7387|\u307B\u304B\u304F\u308A\u3064}\u304C\u3000\u3050\u3050\u30FC\u3093\u3068\u3000\u30A2\u30C3\u30D7\uFF01[VAR 0114(002A)]",
  "\u306D\u3080\u308A\u3054\u306A\u3000\u3055\u3044\u307F\u3093\u3058\u3085\u3064\u306A\u3069\\n{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000\u306D\u3080\u3089\u305B\u308B{\u6280|\u308F\u3056}\u304C\u3000\u3042\u308C\u3070\\r\\n\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u3000\u3044\u3063\u3071\u3044\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3067\u304D\u307E\u3059\u30FC\uFF01[VAR 0114(002A)]",
  "\u307B\u304B\u306B\u3000{\u6355\u7372\u7387|\u307B\u304B\u304F\u308A\u3064}\u3092\u3000{\u4E0A|\u3042}\u3052\u308B\u306B\u306F\\n\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u9069|\u3066\u304D}\u3057\u305F\u30DC\u30FC\u30EB\u3092\u3000{\u4F7F|\u3064\u304B}\u3044\u308F\u3051\u305F\u308A[VAR 0114(002A)]",
  "{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u3092\u3057\u3066\u3000\u307B\u304B\u304F\u30D1\u30EF\u30FC\u3092\u3000\u3064\u3051\u305F\u308A\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u5F8C|\u3046\u3057}\u308D\u304B\u3089\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3092\u3057\u304B\u3051\u305F\u308A[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6355|\u3064\u304B}\u307E\u3048\u308B\u306E\u306B\u3000{\u884C|\u3044}\u304D\u3065\u307E\u3063\u305F\u3089\\n\u30B8\u30E0\u3092\u3000\u3081\u3050\u3063\u3066\u3000\u30B8\u30E0\u30D0\u30C3\u30B8\u3092\u3000\u3082\u3089\u3063\u3066[VAR 0114(002A)]",
  "{\u6355|\u3064\u304B}\u307E\u3048\u3089\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u306E\u30EC\u30D9\u30EB\u3092\\n{\u5E95\u4E0A|\u305D\u3053\u3042}\u3052\u3059\u308B\u306E\u3082\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u3067\u3059\u3088\u304A[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u3000{\u57CB|\u3046}\u307E\u3063\u3066\u304D\u305F\u3089\u3000\u305C\u3072\uFF01\\n\u30B8\u30CB\u30A2{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306B\u3000{\u898B|\u307F}\u305B\u306B\u304D\u3066\u304F\u3060\u3055\u3042\u3044[VAR 0114(002A)]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000{\u697D|\u305F\u306E}\u3057\u304B\u3063\u305F\u3067\u3059\\n{\u6B21\u56DE|\u3058\u304B\u3044}\u306F\u3000\u30C6\u30B9\u30C8\u3092\u3000\u3057\u307E\u3059\u304B\u3089\u306D\u3048[VAR 0114(002A)]"
]
