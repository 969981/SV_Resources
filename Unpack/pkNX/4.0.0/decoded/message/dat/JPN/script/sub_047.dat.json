[
  "{\u5177\u6750|\u3050\u3056\u3044}\u3092\u3000\u3053\u3046\u3057\u3066\u2026\u2026\\n{\u8ABF\u5473\u6599|\u3061\u3087\u3046\u307F\u308A\u3087\u3046}\u3092\u3000\u3042\u3042\u3059\u308C\u3070\u2026\u2026",
  "\u2026\u2026\u3042\u3042\u3000\u3054\u3081\u3093\uFF01\\n{\u8003|\u304B\u3093\u304C}\u3048\u3054\u3068\u3000\u3057\u3066\u3066\uFF01\\c\\n\u307C\u304F\u306F\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306E\\n\u30EC\u30B7\u30D4\u3092\u3000{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u3057\u3066\u3044\u308B\u3093\u3060\\c\\n\u3044\u3064\u304B\u3000\u30DE\u30B9\u30BF\u30FC\u30EC\u30D9\u30EB\u3068\u3000{\u547C|\u3088}\u3070\u308C\u308B\\n{\u81F3\u9AD8|\u3057\u3053\u3046}\u306E\u30EC\u30B7\u30D4\u3092\u3000{\u601D|\u304A\u3082}\u3044\u3064\u304F\u306E\u304C\u3000{\u5922|\u3086\u3081}\u3067\u306D\uFF01\\c\\n\u3088\u304B\u3063\u305F\u3089\u3000\u304D\u307F\u306B\u3082\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306E\\n\u30EC\u30B7\u30D4\u3092\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3042\u3052\u3088\u3046\uFF01",
  "[VAR 0100(0000)]\u306F\u3000{\u65B0|\u3042\u305F\u3089}\u3057\u3044\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000{\u4F5C|\u3064\u304F}\u308C\u308B\u3088\u3046\u306B\u3000\u306A\u3063\u305F\uFF01",
  "[VAR 0100(0000)]\u306F\u3000{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u30DE\u30B9\u30BF\u30FC\u30EC\u30D9\u30EB\u306E\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000{\u4F5C|\u3064\u304F}\u308C\u308B\u3088\u3046\u306B\u3000\u306A\u3063\u305F\uFF01",
  "\u307B\u3063\u307A\u305F\u3000{\u843D|\u304A}\u3063\u3053\u3068\u3057\u3061\u3083\u3046\u307B\u3069\\n\u304A\u3044\u3057\u3044\u304B\u3089\u3000{\u4F5C|\u3064\u304F}\u3063\u3066\u307F\u3066\u306D\uFF01",
  "{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u30EC\u30B7\u30D4\u3092\u3000{\u601D|\u304A\u3082}\u3044\u3064\u3044\u305F\u3089\\n\u307E\u305F\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3042\u3052\u308B\u3088\uFF01",
  "\u2026\u2026\u3042\u3042\u3000\u304D\u307F\u304B\uFF01\\n{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u30EC\u30B7\u30D4\u3092\u3000{\u601D|\u304A\u3082}\u3044\u3064\u3044\u305F\u3088\uFF01",
  "\u2026\u2026\u3042\u3042\u3000\u304D\u307F\u304B\uFF01\\c\\n{\u4ECA|\u3044\u307E}\u3000{\u8003|\u304B\u3093\u304C}\u3048\u3066\u308B\u3000\u30EC\u30B7\u30D4\u306B\u306F\\n\u3081\u305A\u3089\u3057\u3044{\u8ABF\u5473\u6599|\u3061\u3087\u3046\u307F\u308A\u3087\u3046}\u304C\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306A\u3093\u3060\\c\\n{\u79D8\u4F1D|\u3072\u3067\u3093}\u306E{\u4F55|\u306A\u3093}\u3068\u304B\uFF5E\u3068\u3000{\u547C|\u3088}\u3070\u308C\u3066\u3044\u308B\\n\uFF15{\u7A2E\u985E|\u3057\u3085\u308B\u3044}\u306E\u30B9\u30D1\u30A4\u30B9\u3000\u306A\u3093\u3060\u3051\u3069\u2026\u2026\\c\\n\u3072\u3068{\u76EE|\u3081}\u3067\u3082\u3000{\u898B|\u307F}\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u308C\u3070\\n{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u30EC\u30B7\u30D4\u3092\u3000{\u601D|\u304A\u3082}\u3044\u3064\u304F\u304B\u3082\u306A\u3041",
  "{\u79D8\u4F1D|\u3072\u3067\u3093}\u306E{\u4F55|\u306A\u3093}\u3068\u304B\uFF5E\u306F\\n\uFF15{\u7A2E\u985E|\u3057\u3085\u308B\u3044}\u306E\u30B9\u30D1\u30A4\u30B9\u3000\u306A\u3093\u3060\u3051\u3069\u2026\u2026\\c\\n\u3072\u3068{\u76EE|\u3081}\u3067\u3082\u3000{\u898B|\u307F}\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u308C\u3070\\n{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u30EC\u30B7\u30D4\u3092\u3000{\u601D|\u304A\u3082}\u3044\u3064\u304F\u304B\u3082\u306A\u3041",
  "\u304D\u307F\u304C\u3000{\u6301|\u3082}\u3063\u3066\u3044\u308B\u3000\u305D\u3000\u305D\u308C\u306F\uFF01\\n{\u79D8\u4F1D|\u3072\u3067\u3093}\u306E{\u4F55|\u306A\u3093}\u3068\u304B\uFF5E\u3000\u3058\u3083\u306A\u3044\u304B\uFF01\uFF1F\\r\\n\u3046\u3046\u2026\u2026\u3000\u3042\u3000\u3042\u3042\u2026\u2026\\r\\n{\u982D|\u3042\u305F\u307E}\u306E{\u4E2D|\u306A\u304B}\u306B\u3000\u30EC\u30B7\u30D4\u304C\u3000{\u6D6E|\u3046}\u304B\u3093\u3067\u304F\u308B\u30FC\u30C3\uFF01\uFF1F",
  "\u30CF\u30A1\u3000\u30CF\u30A1\u2026\u2026\u3000\u3059\u3055\u307E\u3058\u3044\\n\u30EC\u30B7\u30D4\u3092\u3000{\u751F|\u3046}\u307F{\u51FA|\u3060}\u3057\u3066\u3057\u307E\u3063\u305F\uFF01\\r\\n\u307E\u3055\u306B\u3000{\u81F3\u9AD8|\u3057\u3053\u3046}\u306E\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3060\u2026\u2026\uFF01\\r\\n\u305C\u3072\u3000{\u4F5C|\u3064\u304F}\u3063\u3066\u307F\u3066\u306D\u2026\u2026\uFF01\uFF01",
  "\u304D\u307F\u306E\u304A\u304B\u3052\u3067\u3000\u30DE\u30B9\u30BF\u30FC\u30EC\u30D9\u30EB\u306E\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000\u3059\u3079\u3066\u3000{\u5F62|\u304B\u305F\u3061}\u306B\u3067\u304D\u305F\u3088\uFF01\\c\\n\u307C\u304F\u306E{\u5922|\u3086\u3081}\u3092\u3000{\u5F8C\u62BC|\u3042\u3068\u304A}\u3057\u3057\u3066\u304F\u308C\u3066\\n{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3042\u308A\u304C\u3068\u3046\u306D\uFF01",
  "{\u4E16|\u3088}\u306E{\u4E2D|\u306A\u304B}\u306B\u306F\u3000\u307E\u3060\u3000{\u8AB0|\u3060\u308C}\u3082{\u77E5|\u3057}\u3089\u306A\u3044\\n\u304A\u3044\u3057\u3044\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u304C\u3000\u3042\u308B\u306F\u305A\uFF01\\c\\n\u304D\u307F\u3082\u3000{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u30EC\u30B7\u30D4\u3092\u3000{\u601D|\u304A\u3082}\u3044\u3064\u3044\u305F\u3089\\n\u3044\u308D\u3093\u306A{\u4EBA|\u3072\u3068}\u306B\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3042\u3052\u3066\u306D\uFF01"
]
