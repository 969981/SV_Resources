[
  "\u3053\u3053\u306F\u3000\u30C1\u30E3\u30F3\u30D7\u30EB\u30BF\u30A6\u30F3\\n\u30B4\u30C1\u30E3\u30B4\u30C1\u30E3\u3068\u3000\u3057\u3066\u308B\u3067\u3057\u3087\uFF1F\\r\\n{\u753A|\u307E\u3061}\u306E{\u540D\u524D|\u306A\u307E\u3048}\u3000\u307E\u3093\u307E\u3088\u306D\uFF01",
  "{\u5B9D\u98DF\u5802|\u305F\u304B\u3089\u3057\u3087\u304F\u3069\u3046}\u306B\u306F\u3000{\u884C|\u3044}\u3063\u305F\uFF1F\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306E{\u884C|\u3044}\u304D\u3064\u3051\u3000\u306A\u3093\u3060\u3063\u3066\uFF01",
  "\u3046\u3061\u306E{\u5473|\u3042\u3058}\u306F\u3000\u30D1\u30EB\u30C7\u30A2\u3044\u3061\uFF01\\n\u3069\u3046\u305E\u3000{\u98DF|\u305F}\u3079\u3066\u3044\u3063\u3066\u304F\u3060\u3055\u3044\uFF01",
  "\u30EC\u30B9\u30C8\u30E9\u30F3\u3000{\u9BAE\u5EA6\u4E00\u756A|\u305B\u3093\u3069\u3044\u3061\u3070\u3093}\uFF01\\n\u30DF\u30CD\u30E9\u30EB\u3000\u305F\u3063\u3077\u308A\u3067\u3059\u3088\u30FC",
  "\u3042\u306A\u305F\u306E\u30DD\u30B1\u30E2\u30F3\u3000{\u5F53\u5E97|\u3068\u3046\u3066\u3093}\u3067\\n\u304A{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u3057\u305F\u3044\u3093\u3058\u3083\u3000\u3042\u308A\u307E\u305B\u3093\uFF1F",
  "\u304A{\u9AD8|\u305F\u304B}\u3044\u304A{\u5E97|\u307F\u305B}\u306B\u306F\\n\u30C9\u30EC\u30B9\u30B3\u30FC\u30C9\u304C\u3000\u3042\u308B\u3063\u3066\u3000{\u805E|\u304D}\u3044\u305F\u305C\\r\\n\u3069\u3093\u306A\u30B3\u30FC\u30C9\u304C\u3000\u3042\u308B\u3093\u3060\u308D\u3046\u306A\u2026\u2026\uFF1F",
  "\u304A\u3053\u3065\u304B\u3044\u3000\u305F\u3081\u3066\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n\u304A\u3044\u3057\u3044\u3082\u306E\u3000{\u98DF|\u305F}\u3079\u3055\u305B\u3066\u3042\u3052\u305F\u30FC\u3044",
  "\u304B\u3089\uFF5E\u3044{\u6599\u7406|\u308A\u3087\u3046\u308A}\u304C\u3000\u304A\u3059\u3059\u3081\u3060\u3088\uFF01\\n\u3055\u3042\u3055\u3042\u3000{\u5BC4|\u3088}\u3063\u3068\u3044\u3067\uFF01",
  "\u305F\u3060{\u4ECA|\u3044\u307E}\u3000\u3054{\u4E88\u7D04|\u3088\u3084\u304F}\u306A\u3057\u3067\u3082\\n\u3054{\u5165\u5E97|\u306B\u3085\u3046\u3066\u3093}\u3000\u3044\u305F\u3060\u3051\u307E\u3059\u3088",
  "\u3067\u3063\u304B\u3044{\u9580|\u3082\u3093}\u304C\u3000\u3058\u3083\u307E\u3057\u3066\u3066\\n\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u306B\u3000{\u884C|\u3044}\u3051\u306A\u3044\u3093\u3060",
  "{\u9580|\u3082\u3093}\u306E{\u5965|\u304A\u304F}\u306B\u306F\u3000\u30BC\u30ED\u30B2\u30FC\u30C8\u3063\u3066\u3044\u3046\\n{\u7ACB\u5165\u7981\u6B62|\u305F\u3061\u3044\u308A\u304D\u3093\u3057}\u306E{\u65BD\u8A2D|\u3057\u305B\u3064}\u304C\u3000\u3042\u308B\u3093\u3060\u3063\u3066",
  "\u30C1\u30E3\u30F3\u30D7\u30EB\u30BF\u30A6\u30F3\u3000{\u540D\u7269|\u3081\u3044\u3076\u3064}\\n{\u5B9D\u98DF\u5802|\u305F\u304B\u3089\u3057\u3087\u304F\u3069\u3046}\u306F\u3000\u3053\u3061\u3089\u3060\u3088\u30FC\uFF01\\c\\n\u30B8\u30E0\u30C6\u30B9\u30C8{\u4E2D|\u3061\u3085\u3046}\u306A\u3089\\n{\u79D8\u5BC6|\u3072\u307F\u3064}\u306E\u30E1\u30CB\u30E5\u30FC\u3082\u3000{\u6CE8\u6587|\u3061\u3085\u3046\u3082\u3093}\u3067\u304D\u308B\u3088\u30FC\uFF01",
  "{\u5B9D\u98DF\u5802|\u305F\u304B\u3089\u3057\u3087\u304F\u3069\u3046}\u3067\u3000\u30C6\u30E9\u30B9\u30BF\u30A4\u30D7\\n\u30C1\u30A7\u30F3\u30B8\u3067\u304D\u308B\u3063\u3066\u3000{\u805E|\u304D}\u3044\u305F\u3093\u3060\u3051\u3069\\r\\n\u30B7\u30A7\u30D5\u306B\u3000{\u9580\u524D\u6255|\u3082\u3093\u305C\u3093\u3070\u3089}\u3044\u3000\u3055\u308C\u3061\u3083\u3063\u305F\u2026\u2026",
  "\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306F\u3000\u3044\u304B\u304C\u3067\u3059\u304B\uFF1F\\n\u304A{\u8179|\u306A\u304B}\u304C\u3000{\u7A7A|\u3059}\u3044\u3066\u306A\u304F\u3066\u3082\u3000\u3069\u3046\u305E\u30FC\uFF01",
  "\u30CA\u30C3\u30DA{\u5C71|\u3084\u307E}\u3092\u3000\u306E\u307C\u308B{\u524D|\u307E\u3048}\u306F\\n\u30C1\u30E3\u30F3\u30D7\u30EB\u306E\u3000{\u5546\u5E97\u8857|\u3057\u3087\u3046\u3066\u3093\u304C\u3044}\u3067\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u3057\u3066\\r\\n\u30D1\u30EF\u30FC\u3000\u3064\u3051\u3066\u3044\u304F\u3093\u3060",
  "\u3053\u306E{\u753A|\u307E\u3061}\u306F\u3000\u30D1\u30EB\u30C7\u30A2\u306E\\n{\u4EA4\u901A|\u3053\u3046\u3064\u3046}\u306E{\u8981|\u304B\u306A\u3081}\u306B\u3000\u306A\u3063\u3066\u3044\u3066\u306D\\c\\n\u3088\u305D\u304B\u3089\u3000{\u8A2A|\u304A\u3068\u305A}\u308C\u308B{\u4EBA|\u3072\u3068}\u304C\u3000{\u591A|\u304A\u304A}\u3044\u304B\u3089\\n{\u81EA\u7136|\u3057\u305C\u3093}\u3068\u3000{\u98F2\u98DF\u5E97|\u3044\u3093\u3057\u3087\u304F\u3066\u3093}\u304C\u3000{\u5897|\u3075}\u3048\u3066\u3044\u3063\u305F\u3093\u3060",
  "\u3046\u3061\u306E\u3000\u30E8\u30AF\u30D0\u30EA\u30B9\u3061\u3083\u3093\\n{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u3000{\u5927|\u304A\u304A}\u304D\u304F\u306A\u3063\u3066\u304D\u3066\u2026\u2026\\r\\n{\u5927|\u304A\u304A}\u304D\u306A{\u90E8\u5C4B|\u3078\u3084}\u306B\u3000{\u5F15|\u3072}\u3063{\u8D8A|\u3053}\u305D\u3046\u304B\u3057\u3089\uFF1F",
  "\u30CA\u30C3\u30DA{\u5C71|\u3084\u307E}\u306E\u3000{\u9053|\u307F\u3061}\u306E\u308A\u306F\u3000\u3051\u308F\u3057\u3044\uFF01\\n{\u884C|\u3044}\u304F\u306A\u3089\u3000{\u7528\u610F|\u3088\u3046\u3044}\u306F\u3000\u3057\u3063\u304B\u308A\u306D",
  "\u3053\u306E{\u753A|\u307E\u3061}\u3000\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u304C\u3000\u306A\u3044\u3088\u306D\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3068\u306F\u3000\u3069\u3053\u3067\u3000{\u6226|\u305F\u305F\u304B}\u3046\u3093\u3060\u308D\uFF1F",
  "{\u9060|\u3068\u304A}\u3044{\u6614|\u3080\u304B\u3057}\u3000{\u968E\u6BB5|\u304B\u3044\u3060\u3093}\u306E{\u4E0B|\u3057\u305F}\u306F\u3000{\u5287\u5834|\u3052\u304D\u3058\u3087\u3046}\u306B\u306A\u3063\u3066\u3066\\n{\u6F14\u5287|\u3048\u3093\u3052\u304D}\u3084\u3000\u30B3\u30F3\u30B5\u30FC\u30C8\u3092\u3000\u3057\u3066\u3044\u305F\u306E\u3088",
  "\u304A{\u82E5|\u308F\u304B}\u3044\u306E\u3000{\u5B66\u751F|\u304C\u304F\u305B\u3044}\u3055\u3093\u304B\u3044\\n{\u8AB2\u5916\u6388\u696D|\u304B\u304C\u3044\u3058\u3085\u304E\u3087\u3046}\u306E\u3000\u30B7\u30FC\u30BA\u30F3\u3058\u3083\u306A"
]
