  "{\u8CB4\u69D8|\u304D\u3055\u307E}\u306E\u3000[VAR 0101(0001)]\u306F\\n\u306A\u304B\u306A\u304B\u306B\u3000{\u6709\u7528|\u3086\u3046\u3088\u3046}\u3060\u306A\\r\\n{\u907A\u8DE1|\u3044\u305B\u304D}\u306E{\u8ABF\u67FB|\u3061\u3087\u3046\u3055}\u3067\u3000{\u5F79|\u3084\u304F}\u306B{\u7ACB|\u305F}\u3063\u3066\u3044\u308B\u305E[VAR 0114(0027)]",
