[
  "\u3054\u304D\u3052\u3093\u3088\u3046\\n{\u697D|\u305F\u306E}\u3057\u3044{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306B\u3000\u3057\u307E\u3057\u3087\u3046\u306D[VAR 0114(0025)]",
  "\u307F\u306A\u3055\u3093\u3000{\u524D|\u307E\u3048}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\\n\u3050\u30FC\u3093\u3068\u3000{\u5FA9\u7FD2|\u3075\u304F\u3057\u3085\u3046}\u3057\u3066\u304F\u308C\u307E\u3057\u305F\u304B\uFF1F[VAR 0114(0025)]",
  "\u304B\u3051{\u7B97|\u3056\u3093}\u3068\u304B\u3000\uFF05\u3068\u304B\\n\u3061\u3087\u3063\u3068\u3000{\u5927\u5909|\u305F\u3044\u3078\u3093}\u3060\u3063\u305F\u3082\u306E\u306D[VAR 0114(0025)]",
  "\u305D\u308C\u3067\u306F\u3000{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000\uFF05\u3092\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\\n{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3092\u3000{\u77E5|\u3057}\u3063\u3066\u3044\u304D\u307E\u3057\u3087\u3046\u304B[VAR 0114(0025)]",
  "\u3080\u305A\u304B\u3057\u304F\u3000{\u805E|\u304D}\u3053\u3048\u308B\u3051\u3069\\n\u3058\u3064\u306F\u3000\u307F\u306A\u3055\u3093\u3000\u3059\u3067\u306B\\r\\n{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3092\u3000{\u4F7F|\u3064\u304B}\u3044\u3053\u306A\u3057\u3066\u3044\u308B\u3093\u3067\u3059[VAR 0114(0025)]",
  "\u30DD\u30B1\u30E2\u30F3\u306E{\u6280|\u308F\u3056}\u306B\u306F\u3000\u305D\u308C\u305E\u308C\\n\u3061\u3083\u3093\u3068\u3000{\u76F8\u624B|\u3042\u3044\u3066}\u306B\u3000\u3042\u305F\u308B\u304B\u3069\u3046\u304B\\r\\n{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}\u3068\u3044\u3046\u3000{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u304C\u3000\u3042\u308B\u306E[VAR 0114(0025)]",
  "\u305F\u3044\u3042\u305F\u308A\u306E\u3000{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}\u306F\u3000\uFF11\uFF10\uFF10\uFF01\\n\u3053\u308C\u306F\u3000\uFF11\uFF10\uFF10\uFF05\u3063\u3066\u3053\u3068\u3000\u3060\u304B\u3089\\r\\n\uFF11\uFF10\uFF10{\u56DE|\u304B\u3044}\u3000\u3084\u3063\u3066\u3000\uFF11\uFF10\uFF10{\u56DE|\u304B\u3044}\u3000\u3042\u305F\u308B\u308F\u306D[VAR 0114(0025)]",
  "{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000\u306D\u3080\u308A\u306B\u3000\u3057\u3066\u3057\u307E\u3046\\n\u3055\u3044\u307F\u3093\u3058\u3085\u3064\u306E\u3000{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}\u306F\u3000\uFF16\uFF10\uFF01[VAR 0114(0025)]",
  "\u3064\u307E\u308A\u3000\uFF16\uFF10\uFF05\u3060\u304B\u3089\\n\uFF11\uFF10\uFF10{\u56DE\u4E2D|\u304B\u3044\u3061\u3085\u3046}\u3000\uFF16\uFF10{\u56DE|\u304B\u3044}\u3000\u3042\u305F\u308B\u2026\u2026\\r\\n{\u9006|\u304E\u3083\u304F}\u3092\u3044\u3048\u3070\u3000\uFF14\uFF10{\u56DE|\u304B\u3044}\u306F\u3000{\u5931\u6557|\u3057\u3063\u3071\u3044}\u3057\u3066\u3057\u307E\u3046\u306E[VAR 0114(0025)]",
  "{\u4E00\u822C\u7684|\u3044\u3063\u3071\u3093\u3066\u304D}\u306B\u3000\u3068\u3073\u306C\u3051\u3066\u3000{\u5F37|\u3064\u3088}\u3044{\u6280|\u308F\u3056}\u306B\\n{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}\u304C\u3000{\u4F4E|\u3072\u304F}\u3044\u3082\u306E\u304C\u3000{\u591A|\u304A\u304A}\u3044\u3067\u3059\u306D[VAR 0114(0025)]",
  "{\u7D76\u5BFE|\u305C\u3063\u305F\u3044}\u3000\u3042\u305F\u308B{\u6280|\u308F\u3056}\u3067\u3000{\u624B|\u3066}\u304C\u305F\u304F\u3000\u3044\u304F\u304B\\n{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}\u304C\u3000{\u4E0D\u5B89|\u3075\u3042\u3093}\u3060\u3051\u3069\u3000{\u5F37|\u3064\u3088}\u3044{\u6280|\u308F\u3056}\u3092\u3000{\u4F7F|\u3064\u304B}\u3046\u304B\u2026\u2026[VAR 0114(0025)]",
  "{\u6280|\u308F\u3056}\u3092\u3000{\u8003|\u304B\u3093\u304C}\u3048\u3066\u308B\u3060\u3051\u3067\u3082\u3000\u307F\u306A\u3055\u3093\u306F\\n{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3092\u3000\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u3066\u3044\u308B\u3093\u3067\u3059\u3088\u30FC\uFF01[VAR 0114(0025)]",
  "{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}\u3067\u3000{\u8A71\u984C|\u308F\u3060\u3044}\u306B\u3000\u3042\u304C\u308B\u306E\u306F\\n\u306A\u307F\u306E\u308A\u3000\u3068\u3000\u30CF\u30A4\u30C9\u30ED\u30DD\u30F3\u30D7\u3000\u304B\u3057\u3089\uFF1F[VAR 0114(0025)]",
  "\u306A\u307F\u306E\u308A\u306F\u3000{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}\u304C\u3000\uFF11\uFF10\uFF10\u306A\u306E\u3067\\n{\u7D76\u5BFE|\u305C\u3063\u305F\u3044}\u306B\u3000{\u5A01\u529B|\u3044\u308A\u3087\u304F}\uFF19\uFF10\u306E\u3000\u30C0\u30E1\u30FC\u30B8\u3092\u3000{\u4E0E|\u3042\u305F}\u3048\u307E\u3059[VAR 0114(0025)]",
  "\u30CF\u30A4\u30C9\u30ED\u30DD\u30F3\u30D7\u306F\u3000{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}\u304C\u3000\uFF18\uFF10\u3067\u3059\u304C\\n{\u5A01\u529B|\u3044\u308A\u3087\u304F}\uFF11\uFF11\uFF10\u3082\u306E\u3000\u30C0\u30E1\u30FC\u30B8\u304C\u3000{\u898B|\u307F}\u3053\u3081\u307E\u3059\uFF01[VAR 0114(0025)]",
  "\u307F\u306A\u3055\u3093\u306F\u3000\u306A\u307F\u306E\u308A\u3068\u3000\u30CF\u30A4\u30C9\u30ED\u30DD\u30F3\u30D7\\n\u3069\u3063\u3061\u306E{\u6280|\u308F\u3056}\u3092\u3000{\u9078|\u3048\u3089}\u3073\u305F\u3044\u3067\u3059\u304B\u306D\uFF1F[VAR 0114(0025)]",
  "\u306A\u307F\u306E\u308A",
  "\u30CF\u30A4\u30C9\u30ED\u30DD\u30F3\u30D7",
  "{\u5834\u5408|\u3070\u3042\u3044}\u306B\u3088\u308B",
  "\u3042\u3089\u3000[VAR 0100(0000)]\u3055\u3093\u306F\\n\u30B3\u30C4\u30B3\u30C4{\u624B|\u3066}\u304C\u305F\u304F\u30BF\u30A4\u30D7\u3000\u306A\u306E\u306D[VAR 0114(0025)]",
  "\u3042\u3089\u3000[VAR 0100(0000)]\u3055\u3093\u306F\\n\u30ED\u30DE\u30F3\u3076\u3063{\u653E|\u3071\u306A}\u3057\u30BF\u30A4\u30D7\u3000\u306A\u306E\u306D[VAR 0114(0025)]",
  "\u3042\u3089\u3000[VAR 0100(0000)]\u3055\u3093\u306F\\n\u3044\u308D\u3093\u306A{\u72B6\u6CC1|\u3058\u3087\u3046\u304D\u3087\u3046}\u3092\u3000{\u8003|\u304B\u3093\u304C}\u3048\u3066\u308B\u306E\u306D\uFF1F[VAR 0114(0025)]",
  "{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3000{\u601D|\u304A\u3082}\u308F\u305A\u3000{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u3057\u3061\u3083\u3063\u305F\u3051\u3069\\n{\u6B63\u89E3|\u305B\u3044\u304B\u3044}\u306F\u3000\u306A\u3044\u306E\uFF01\\r\\n{\u597D|\u3059}\u304D\u306A{\u6280|\u308F\u3056}\u3092\u3000{\u4F7F|\u3064\u304B}\u3048\u3070\u3000\u3044\u3044\u3093\u3067\u3059\u3088\u30FC[VAR 0114(0025)]",
  "\uFF30\uFF30\u3068\u304B\u3000{\u8907\u6570|\u3075\u304F\u3059\u3046}\u306B\u3000\u3042\u305F\u308B\u3068\u304B\u3000{\u9055|\u3061\u304C}\u3063\u3066\\n\u3069\u3063\u3061\u304C\u3000\u3044\u3044\u304B\u3068\u304B\u3000\u306A\u3044\u3082\u306E[VAR 0114(0025)]",
  "\u3053\u306E\u3000\u306A\u307F\u306E\u308A\u30CF\u30A4\u30C9\u30ED{\u554F\u984C|\u3082\u3093\u3060\u3044}\u306F\\n{\u6614|\u3080\u304B\u3057}\u304B\u3089\u3000{\u8B70\u8AD6|\u304E\u308D\u3093}\u3055\u308C\u3084\u3059\u3044\u306E[VAR 0114(0025)]",
  "{\u5148\u751F\u7684|\u305B\u3093\u305B\u3044\u3066\u304D}\u306B\u306F\u3000\u3044\u308F\u30BF\u30A4\u30D7\u306E\\n\u3044\u308F\u306A\u3060\u308C\u3000\u304B\u3000\u30B9\u30C8\u30FC\u30F3\u30A8\u30C3\u30B8\u3000\u304B[VAR 0114(0025)]",
  "\u305D\u3063\u3061\u306E\u307B\u3046\u3092\\n{\u8352\u3005|\u3042\u3089\u3042\u3089}\u3057\u304F\u3000{\u8A9E|\u304B\u305F}\u308A{\u5408|\u3042}\u3044\u305F\u3044\u3093\u3060\u3051\u3069\\r\\n\u3042\u3089\u3000\u30C1\u30E3\u30A4\u30E0\u306D\u3000{\u6B8B\u5FF5|\u3056\u3093\u306D\u3093}\u2026\u2026[VAR 0114(0025)]",
  "{\u6B21|\u3064\u304E}\u306F\u3000{\u5F8C\u671F|\u3053\u3046\u304D}\u3000{\u6700\u5F8C|\u3055\u3044\u3054}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\uFF01\\n\uFF11\uFF10\uFF10\uFF05\u306E\u3000{\u529B|\u3061\u304B\u3089}\u3067\u3000\u304A{\u4F1A|\u3042}\u3044\u3057\u307E\u3057\u3087\u3046[VAR 0114(0025)]"
]
