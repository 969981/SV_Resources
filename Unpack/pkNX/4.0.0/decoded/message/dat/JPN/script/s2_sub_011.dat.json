[
  "\u306F\u3041\u3044\u3000\u30A2\u30ED\u30FC\u30E9\uFF01\\n\u30A2\u30BF\u30B7\u3000\u30A2\u30ED\u30FC\u30E9\u306E\u30DD\u30B1\u30E2\u30F3\u3000{\u5927\u597D|\u3060\u3044\u3059}\u304D\u3088\uFF01",
  "\u30A2\u30ED\u30FC\u30E9\u306E\u3059\u304C\u305F\u306E\\n\u30B4\u30ED\u30FC\u30CB\u30E3\u3092\u3000\u3072\u3068{\u76EE|\u3081}\u3000{\u898B|\u307F}\u305F\u3044\u3093\u3060\u3051\u3069\\r\\n{\u624B\u6301|\u3066\u3082}\u3061\u304B\u3000\u30DC\u30C3\u30AF\u30B9\u306B\u3000\u3044\u3089\u3063\u3057\u3083\u3089\u306A\u3044\uFF1F",
  "\u3069\u3046\u3057\u3066\u3082\u3000\u30B4\u30ED\u30FC\u30CB\u30E3\u3060\u3051\\n{\u898B|\u307F}\u3064\u3051\u3089\u308C\u306A\u3044\u3093\u3067\u3059\u306E\u2026\u2026",
  "\u305D\u306E\u30DD\u30B1\u30E2\u30F3\u306F\u2026\u2026\\n\u30B4\u30ED\u30FC\u30CB\u30E3\u3067\u3059\u3089\u3000\u3042\u308A\u307E\u305B\u3093\u308F\uFF01",
  "\u305D\u306E\u30DD\u30B1\u30E2\u30F3\u306F\u2026\u2026\\n\u30B7\u30F3\u30D7\u30EB\u306A\u3000\u30B4\u30ED\u30FC\u30CB\u30E3\u3000\u3067\u3059\u308F\uFF01\uFF01\\r\\n{\u898B|\u307F}\u305F\u3044\u306E\u306F\uFF01\u3000\u30A2\u30ED\u30FC\u30E9\u306E\u3059\u304C\u305F\uFF01\uFF01",
  "\u305D\u306E\u30DD\u30B1\u30E2\u30F3\u306F\u2026\u2026\\n\u30A2\u30ED\u30FC\u30E9\u306E\u3059\u304C\u305F\u306E\u3000\u30B4\u30ED\u30FC\u30CB\u30E3\uFF01\uFF01",
  "\u30A8\u30AD\u30BE\u30C1\u30C3\u30AF\u306B\u3000{\u982D|\u3042\u305F\u307E}\u304C\u3000\u30D1\u30C3\u30AB\u30FC\u30F3\uFF01\\n\u307E\u3086{\u6BDB|\u3052}\u3082\u3000\u304A\u30D2\u30B2\u3082\u3000{\u51DB\u3005|\u308A\u308A}\u3057\u304F\u3063\u3066\u3088\u30FC\uFF01",
  "\u2026\u2026{\u901A\u4FE1|\u3064\u3046\u3057\u3093}{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3067\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\u304B\u3089\\n{\u91CE\u751F|\u3084\u305B\u3044}\u3067\u306F\u3000\u3042\u307E\u308A\u3000{\u898B|\u307F}\u3064\u304B\u3089\u306A\u3044\u306E\u306D",
  "{\u611F\u8B1D|\u304B\u3093\u3057\u3083}\u3064\u3044\u3067\u306B\u3000\u30A2\u30ED\u30FC\u30E9\u304B\u3064\\n\u30B4\u30ED\u30FC\u30CB\u30E3\u306A\u3000\u30A8\u30E2\u30FC\u30C8\u3092\u3000\u304A{\u8A66|\u305F\u3081}\u3057\u3042\u308C\uFF01",
  "[VAR 0100(0000)]\u306F\u3000{\u5973|\u304A\u3093\u306A}\u306E{\u5B50|\u3053}\u304B\u3089\\n[VAR FF00(0008)]\u3067\u3093\u304D\uFF3A\u30A8\u30E2\u30FC\u30C8[VAR FF00(0000)]\u3092\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3082\u3089\u3063\u305F\uFF01",
  "\u3067\u3093\u304D\uFF3A\u30DD\u30FC\u30BA\u306F\u3000{\u624B|\u3066}\u306E{\u89D2\u5EA6|\u304B\u304F\u3069}\u304C\u3000\u30DD\u30A4\u30F3\u30C8\uFF01\\n\u305D\u3057\u3066\u3000{\u5927|\u304A\u304A}\u304D\u306A{\u58F0|\u3053\u3048}\u3067\u3000\u30A2\u30ED\u30FC\u30E9\u3000\u3067\u3059\u308F\uFF01"
]
