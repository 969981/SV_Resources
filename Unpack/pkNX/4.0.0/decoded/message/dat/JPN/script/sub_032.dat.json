[
  "\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u2026\u2026",
  "\u3069\u304A\u3082\u3000[VAR 0100(0000)]\u3055\u3093\\n\u30B8\u30CB\u30A2\u3067\u3059[VAR 0114(002A)]",
  "{\u5B66\u6821\u6700\u5F37\u5927\u4F1A|\u304C\u3063\u3053\u3046\u3055\u3044\u304D\u3087\u3046\u305F\u3044\u304B\u3044}\\n{\u512A\u52DD|\u3086\u3046\u3057\u3087\u3046}\u3000\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "{\u6559|\u304A\u3057}\u3048{\u5B50|\u3054}\u304C\u3000{\u5B66\u6821\u6700\u5F37|\u304C\u3063\u3053\u3046\u3055\u3044\u304D\u3087\u3046}\u3060\u3068\\n\u307C\u304F\u3082\u3000{\u9F3B|\u306F\u306A}\u304C\u3000{\u9AD8|\u305F\u304B}\u3044\u306A\u3042[VAR 0114(002A)]",
  "\u2026\u2026\u30B3\u30DB\u30F3\uFF01\u3000\u30B8\u30CB\u30A2{\u5148\u751F|\u305B\u3093\u305B\u3044}\uFF01[VAR 0114(000A)]",
  "\u3042\u3000\u30AF\u30E9\u30D9\u30EB{\u5148\u751F|\u305B\u3093\u305B\u3044}\\n{\u4ECA|\u3044\u307E}\u304B\u3089\u3000{\u672C\u984C|\u307B\u3093\u3060\u3044}\u3000{\u8A71|\u306F\u306A}\u3057\u307E\u3059\u304B\u3089\u30FC[VAR 0114(002A)]",
  "{\u5B9F|\u3058\u3064}\u3092\u3044\u3046\u3068\u3000{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\\n{\u5F37\u529B|\u304D\u3087\u3046\u308A\u3087\u304F}\u306A\u3000\u30C6\u30E9\u30EC\u30A4\u30C9\u304C\\r\\n\u3042\u3061\u3053\u3061\u3067\u3000{\u78BA\u8A8D|\u304B\u304F\u306B\u3093}\u3055\u308C\u3066\u3044\u307E\u3057\u3066\u306D\u3048[VAR 0114(002A)]",
  "\u30A2\u30AB\u30C7\u30DF\u30FC\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u306E\u30DD\u30B1\u30E2\u30F3\u304C\\n\u30B1\u30AC\u3092\u3057\u305F{\u5831\u544A|\u307B\u3046\u3053\u304F}\u304C\u3000{\u76F8\u6B21|\u3042\u3044\u3064}\u3044\u3067\u3044\u308B\u3093\u3067\u3059\u30FC[VAR 0114(002A)]",
  "{\u5148\u751F|\u305B\u3093\u305B\u3044}\u305F\u3061\u3082\u3000{\u624B\u5206|\u3066\u308F}\u3051\u3057\u3066\\n{\u8ABF\u67FB|\u3061\u3087\u3046\u3055}\u3057\u3066\u308B\u3093\u3067\u3059\u304C\u3000{\u624B|\u3066}\u304C{\u8DB3|\u305F}\u308A\u306A\u304F\u3066\u2026\u2026[VAR 0114(002A)]",
  "\u305D\u3053\u3067\u3000{\u5B66\u6821\u6700\u5F37|\u304C\u3063\u3053\u3046\u3055\u3044\u304D\u3087\u3046}\u306A\u3000[VAR 0100(0000)]\u3055\u3093\u306B\\n\u304A{\u624B\u4F1D|\u3066\u3064\u3060}\u3044\u3092\u3000\u3057\u3066\u3082\u3089\u3048\u308B\u3068\\r\\n\u3068\u3063\u3066\u3082\u3000{\u52A9|\u305F\u3059}\u304B\u308B\u3093\u3067\u3059\u304C\u2026\u2026[VAR 0114(002A)]",
  "\u307E\u304B\u305B\u3066\u304F\u3060\u3055\u3044\uFF01",
  "\u30D2\u30DE\u306A\u3068\u304D\u306A\u3089",
  "\u308F\u3042\u3044\u3000\u3084\u3063\u305F\u3042\uFF01\\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u30FC[VAR 0114(002A)]",
  "{\u8ABF\u67FB|\u3061\u3087\u3046\u3055}\u30C7\u30FC\u30BF\u306F\u3000{\u81EA\u52D5\u7684|\u3058\u3069\u3046\u3066\u304D}\u306B\\n{\u56F3\u9451|\u305A\u304B\u3093}\u30A2\u30D7\u30EA\u3067\u3000\u30AD\u30E3\u30C3\u30C1\u30A2\u30C3\u30D7\\r\\n\u3057\u3066\u304A\u308A\u307E\u3059\u306E\u3067[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u3055\u3093\u306F\u3000\u3068\u306B\u304B\u304F\\n{\u5F37|\u3064\u3088}\u3081\u306E\u3000\u30C6\u30E9\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB\u3067\\r\\n\u305F\u304F\u3055\u3093\u3000{\u6226|\u305F\u305F\u304B}\u3063\u3066\u304F\u3060\u3055\u3042\u3044\uFF01[VAR 0114(002A)]",
  "{\u5B66\u6821\u6700\u5F37|\u304C\u3063\u3053\u3046\u3055\u3044\u304D\u3087\u3046}\u3067\u3082\\n{\u7121\u7406|\u3080\u308A}\u306F\u3000{\u7981\u7269|\u304D\u3093\u3082\u3064}\u3067\u3059\u3088\u30FC[VAR 0114(002A)]",
  "{\u5927\u5207|\u305F\u3044\u305B\u3064}\u306A{\u751F\u5F92|\u305B\u3044\u3068}\u304C\u3000\u30B1\u30AC\u3067\u3082\\n\u3057\u305F\u3089\u3000{\u60B2|\u304B\u306A}\u3057\u3044\u3067\u3059\u306E\u3067\u2026\u2026[VAR 0114(002A)]",
  "\u305D\u308C\u3067\u306F\u3000\u305F\u306E\u307F\u307E\u3057\u305F\u3088\u30FC\uFF01[VAR 0114(002A)]"
]
