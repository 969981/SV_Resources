[
  "\u30A2\u30F3\u30BF\u304C\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u3000{\u6765|\u304D}\u305F\u306E\\n\u307B\u3093\u306E\u3061\u3087\u3063\u3068{\u524D|\u307E\u3048}\u3000\u3060\u3063\u305F\u306E\u306B[VAR 0114(001B)]",
  "{\u4ECA|\u3044\u307E}\u3058\u3083\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u3067\\n\u30C8\u30C3\u30D7\u306E{\u4EE3|\u304B}\u308F\u308A\u3068\u3000\u304D\u305F\u3082\u3093\u3060[VAR 0114(001B)]",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u3000\u3053\u306E{\u6B73|\u3068\u3057}\u306B\u306A\u308B\u3068\\n{\u6642\u9593|\u3058\u304B\u3093}\u304C\u3000\u3042\u3063\u3068\u3044\u3046{\u9593|\u307E}\u306B\u3000{\u904E|\u3059}\u304E\u3066\u3044\u304F\u3088[VAR 0114(001B)]",
  "\u2026\u2026\u306A\u3093\u3066\u3000\u30BB\u30F3\u30C1\u306A{\u611F|\u304B\u3093}\u3058\u306F\u3000\u30CE\u30FC\u30DE\u30C3\u30C1\uFF01\\n\u30CA\u30A4\u30B9\u306A\u30E9\u30A4\u30E0\u304C\u3000\u30A4\u30F3\u30C0\u30CF\u30A6\u30B9\uFF01[VAR 0114(001B)]",
  "\u30DE\u30B8{\u6C17|\u304D}\u306A\u3000\u30D0\u30C8\u30EB\u3067\\n{\uFF23\uFF28\uFF25\uFF23\uFF2B\u3000\uFF29\uFF34\u3000\uFF2F\uFF35\uFF34|\u30C1\u30A7\u30B1\u30E9}\u306A\u3000\u30BD\u30A6\u30EB\uFF01[VAR 0114(001B)]",
  "{\u82E5\u8449|\u308F\u304B\u3070}\u306A\u30D1\u30EF\u30FC\u304C\\n\u305F\u308F\u308F\u306B\u3000{\u719F|\u3046}\u308C\u308A\u3083\u3042[VAR 0114(001B)]",
  "\u30A2\u30BF\u30A4\u306E{\u9B42|\u305F\u307E\u3057\u3044}\u3000\uFF33\uFF28\uFF21\uFF2B\uFF25\u3057\u306A\uFF01[VAR 0114(001B)]",
  "\uFF28\uFF21\uFF28\uFF21\uFF28\uFF21\uFF01\u3000\u306A\u3093\u3066\u3053\u3063\u305F\u3044\uFF01\\n\u30A2\u30F3\u30BF\u306E\u30D1\u30F3\u30C1\u3000\u30B5\u30A4\u30C3\u30B3\u30FC\u3060\u306D\uFF01[VAR 0114(001B)]",
  "\u30A2\u30BF\u30A4\u306E{\u9B42|\u305F\u307E\u3057\u3044}\u3000{\u9707|\u3075\u308B}\u3048\u3059\u304E\u3066\\n\u30B9\u30E0\u30FC\u30B8\u30FC\u306B\u3000\u306A\u3063\u3061\u307E\u3063\u305F\u3088\uFF01[VAR 0114(001B)]",
  "\u3055\u3063\u304D\u306F\u3000\u30EB\u30FC\u30AD\u30FC\u306A\u3093\u3066\\n{\u8A00|\u3044}\u3063\u3066\u3000{\u60AA|\u308F\u308B}\u304B\u3063\u305F\u306D[VAR 0114(001B)]",
  "\u30AA\u30E2\u30C0\u30AB\u306B\u3000\u30B4\u30FC\u30B9\u30C8\u306E{\u529B|\u3061\u304B\u3089}\u3092\\n{\u8A8D|\u307F\u3068}\u3081\u3055\u305B\u305F\u304F\u3066\u3000{\u7126|\u3042\u305B}\u3063\u3061\u307E\u3063\u3066\u305F\u306E\u3055[VAR 0114(001B)]",
  "\u30A2\u30F3\u30BF\u306E\u30D0\u30A4\u30D6\u30B9\u306F\u3000{\u672C\u7269|\u307B\u3093\u3082\u306E}\u3060\\n\u30A2\u30BF\u30A4\u304C\u3000{\u4FDD\u8A3C|\u307B\u3057\u3087\u3046}\u3059\u308B[VAR 0114(001B)]",
  "\u3053\u308C\u304B\u3089\u306F\u3000\u3053\u306E\u30E9\u30A4\u30E0\u304C\\n\u30A2\u30F3\u30BF\u306E\u30D0\u30C3\u30AF\u306B\u3000\u3064\u3044\u3066\u308B\u304B\u3089[VAR 0114(001B)]",
  "\u30E0\u30AB\u3064\u304F\u30C8\u30EC\u30FC\u30CA\u30FC\u3084\\n{\u970A|\u308C\u3044}\u304C\u3000\u3044\u305F\u3089\u3000\u3059\u3050{\u547C|\u3088}\u3073\u306A\\r\\n\u30A2\u30BF\u30A4\u304C\u3000{\u529B|\u3061\u304B\u3089}\u306B\u306A\u308B\u3088[VAR 0114(001B)]",
  "\uFF27\uFF2F\uFF2F\uFF24\u306A{\u73FE\u4E16|\u3052\u3093\u305B}\u3092\u3000{\u8B33\u6B4C|\u304A\u3046\u304B}\u3057\u306A\uFF01\\n\u30D0\u30A4\u30D0\u30A4\u3000\u30D9\u30A4\u30D3\u30FC\uFF01[VAR 0114(001B)]"
]
