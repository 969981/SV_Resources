[
  "\u30A6\u30AA\u30FC\u30C3\uFF01\\n{\u9045\u523B|\u3061\u3053\u304F}\u3000{\u9045\u523B|\u3061\u3053\u304F}\u30FC\u30C3\uFF01[VAR 0114(002C)]",
  "\u3042\u30FC\uFF01\u3000\u30CF\u30A4\u30C0\u30A4\u3055\u3093\uFF01\\n{\u5F85|\u307E}\u3063\u3066\u304F\u3060\u3055\u30FC\u3044\uFF01",
  "\u3042\u30FC\u3000{\u884C|\u3044}\u3063\u3061\u3083\u3063\u305F\\n{\u5FD8|\u308F\u3059}\u308C\u3082\u306E\u3000\u3042\u308B\u306E\u306B\u2026\u2026",
  "\u3082\u3057\u304B\u3057\u3066\u3000\u30B8\u30E0\u3078\u306E\\n{\u6311\u6226\u8005|\u3061\u3087\u3046\u305B\u3093\u3057\u3083}\u3055\u3093\u3000\u3067\u3059\u3088\u306D\uFF1F",
  "\u306F\u3044\uFF01",
  "\u3048\u3063\u3068\u2026\u2026",
  "\u3084\u3063\u3071\u308A\uFF01\u3000\u305D\u3046\u3067\u3059\u3088\u306D\uFF01",
  "{\u53E3|\u304F\u3061}\u3067\u306F\u3000\u305D\u3046{\u8A00|\u3044}\u3063\u3066\u3082\\n\u304D\u3063\u3068\u3000{\u6311\u6226\u8005|\u3061\u3087\u3046\u305B\u3093\u3057\u3083}\u3055\u3093\u3000\u3067\u3059\u3088\uFF01",
  "{\u5148|\u3055\u304D}\u307B\u3069\u306E\u3000{\u5927|\u304A\u304A}\u304D\u306A\u304A\u3058\u3055\u3093\u306F\\n\u30AB\u30E9\u30D5\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30CF\u30A4\u30C0\u30A4",
  "{\u5F7C|\u304B\u308C}\u3063\u305F\u3089\u3000\u3061\u3087\u3063\u3074\u308A\u3000\u30AA\u30C1\u30E3\u30E1\u3067\\n{\u5E02\u5834|\u3044\u3061\u3070}\u306B\u3000{\u8CB7|\u304B}\u3044{\u51FA|\u3060}\u3057\u306B\u3000{\u884C|\u3044}\u304F\u306E\u306B\\r\\n\u30B5\u30A4\u30D5\u3092\u3000{\u5FD8|\u308F\u3059}\u308C\u3061\u3083\u3063\u305F\u3093\u3067\u3059",
  "\u304D\u3063\u3068\u3000\u30CF\u30A4\u30C0\u30A4\u3055\u3093\u3000\u3053\u307E\u3063\u3066\u308B\u2026\u2026\\c\\n{\u89AA\u5207|\u3057\u3093\u305B\u3064}\u306A\u3000{\u6311\u6226\u8005|\u3061\u3087\u3046\u305B\u3093\u3057\u3083}\u3055\u3093\uFF01\\n\u30B5\u30A4\u30D5\u3092\u3000{\u5C4A|\u3068\u3069}\u3051\u3066\u304F\u308C\u307E\u305B\u3093\u304B\uFF01\uFF1F",
  "\u3042\u3042\u3000\u306A\u3093\u3066{\u512A|\u3084\u3055}\u3057\u3044\u306E\uFF01\\n{\u4ECA|\u3044\u307E}\u3000\u3053\u3053\u3067\u3000\u30B8\u30E0\u30D0\u30C3\u30B8\u3092\\r\\n\u3042\u3052\u3061\u3083\u3044\u305F\u3044\u304F\u3089\u3044\uFF01",
  "\u3059\u307F\u307E\u305B\u3093\u3000\u30CF\u30A4\u30C0\u30A4\u3055\u3093\u304C\u3000\u3044\u306A\u3044\u3068\\n\u30B8\u30E0\u306E{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3082\u3000\u3067\u304D\u307E\u305B\u3093\u3057\\r\\n\u308F\u305F\u3057\u3082\u3000{\u53D7\u4ED8|\u3046\u3051\u3064\u3051}\u3092\u3000{\u96E2|\u306F\u306A}\u308C\u3089\u308C\u306A\u3044\u3093\u3067\u3059\u2026\u2026",
  "\u305D\u308C\u3067\u306F\u3000\u3053\u3061\u3089\\n\u304A{\u9858|\u306D\u304C}\u3044\u3057\u307E\u3059\u306D\uFF01",
  "{\u7279\u5225|\u3068\u304F\u3079\u3064}\u306B\u3000{\u5C4A|\u3068\u3069}\u3051\u3066\u304F\u308C\u305F\u3089\\n\u30B8\u30E0\u30C6\u30B9\u30C8\u3000\u30AF\u30EA\u30A2\u3068\u3000\u3057\u307E\u3059\u306E\u3067\uFF01",
  "\u30CF\u30A4\u30C0\u30A4\u3055\u3093\u306F\u3000{\u897F|\u306B\u3057}\u306E{\u7802\u6F20|\u3055\u3070\u304F}\u3092\u3000{\u629C|\u306C}\u3051\u305F{\u5148|\u3055\u304D}\\n[VAR FF00(0006)]\u30DE\u30EA\u30CA\u30FC\u30C9\u30BF\u30A6\u30F3[VAR FF00(0000)]\u306B\u3000{\u5411|\u3080}\u304B\u3044\u307E\u3057\u305F\uFF01",
  "{\u7802\u6F20|\u3055\u3070\u304F}\u306F\u3000{\u5371\u967A|\u304D\u3051\u3093}\u306A\u30DD\u30B1\u30E2\u30F3\u3082\\n{\u591A|\u304A\u304A}\u3044\u306E\u3067\u3000\u304A{\u6C17|\u304D}\u3092\u3064\u3051\u3066\u30FC\uFF01"
]
