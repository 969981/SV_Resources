[
  "\u3088\u3046\u3053\u305D\u3000\u30D5\u30EA\u30C3\u30B8\u30B8\u30E0\u3078\uFF01",
  "{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}{\u8005|\u3057\u3083}\u306E\\n\u304A{\u540D\u524D|\u306A\u307E\u3048}\u3092\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3057\u307E\u3059\u2026\u2026\\r\\n[VAR 0100(0000)]\u3055\u3093\u3000\u3067\u3059\u306D\uFF01",
  "{\u5F53|\u3068\u3046}\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30E9\u30A4\u30E0\u3068\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308B\u306B\u306F\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u3092\\r\\n\u30AF\u30EA\u30A2\u3059\u308B{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308A\u307E\u3059",
  "\u30D5\u30EA\u30C3\u30B8\u30B8\u30E0\u306E\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u306F\u2026\u2026\\n[VAR FF00(0006)]\u30AA\u30FC\u30D7\u30CB\u30F3\u30B0\u30A2\u30AF\u30C8[VAR FF00(0000)]\uFF01\\r\\n\u2026\u2026\u3044\u308F\u3086\u308B\u3000{\u524D\u5EA7|\u305C\u3093\u3056}\u3067\u3059\u306D\uFF01",
  "\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306E\u30E9\u30A4\u30D6\u304C\u3000{\u59CB|\u306F\u3058}\u307E\u308B{\u524D|\u307E\u3048}\u306B\\n\u30B9\u30C6\u30FC\u30B8{\u4E0A|\u3058\u3087\u3046}\u3067\u3000\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\uFF01\\r\\n{\u71B1|\u3042\u3064}\u3044{\u6B7B\u95D8|\u3057\u3068\u3046}\u3067\u3000{\u5BA2\u5E2D|\u304D\u3083\u304F\u305B\u304D}\u3092\u3000{\u76DB|\u3082}\u308A{\u4E0A|\u3042}\u3052\u3066\u304F\u3060\u3055\u3044\uFF01",
  "\u30E9\u30A4\u30D6{\u4F1A\u5834|\u304B\u3044\u3058\u3087\u3046}\u306B\u3044\u308B\u3000\uFF2D\uFF23\u3068\u3000{\u8A71|\u306F\u306A}\u305B\u3070\\n\u30B8\u30E0\u30C6\u30B9\u30C8\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u3089\u308C\u307E\u3059\u3088",
  "\u305D\u308C\u3067\u306F\u3000\u3044\u3063\u3066\u3089\u3063\u3057\u3083\u3044\uFF01"
]
