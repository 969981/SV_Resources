[
  "\u30AC\u30E9\u30CA\u30C4\u306E\u3048\u3060\u3092\u3000\u3042\u3093\u3067\u306D\\n\u30AC\u30E9\u30CA\u30C4\u306E\u3048\u3060\u3092\u3000\u3042\u3093\u3067\u306D\u2026\u2026\\r\\n\u30A2\u30AF\u30BB\u30B5\u30EA\u30FC\u304C\u3000\u3067\u304D\u308B\u306E\uFF01",
  "\u30AC\u30E9\u30CA\u30C4\u306E\u3048\u3060\u3092\u3000\u304F\u308C\u305F\u3089\\n\u30AC\u30E9\u30CA\u30C4\u30D6\u30EC\u30B9\u304B\u3000\u30AC\u30E9\u30CA\u30C4\u30EA\u30FC\u30B9\u3092\\r\\n\u3042\u3093\u3067\u3042\u3052\u308B\u3088\uFF01",
  "\u30AC\u30E9\u30CA\u30C4\u30D6\u30EC\u30B9",
  "\u30AC\u30E9\u30CA\u30C4\u30EA\u30FC\u30B9",
  "\u307E\u305F{\u4ECA\u5EA6|\u3053\u3093\u3069}",
  "{\u4ECA|\u3044\u307E}\u306F\u3000\u3044\u3089\u306A\u3044\u306E\u306D\uFF01\\n\u3058\u3083\u3042\u3000\u307E\u305F{\u4ECA\u5EA6|\u3053\u3093\u3069}\uFF01",
  "\u30AC\u30E9\u30CA\u30C4\u30D6\u30EC\u30B9\u306F\u3000\u30AC\u30E9\u30CA\u30C4\u306E\u3048\u3060\u304C\\n\uFF18{\u672C|\u307D\u3093}\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u3060\u3051\u3069\u3000\u3044\u30FC\u3044\uFF1F",
  "\u30AC\u30E9\u30CA\u30C4\u30EA\u30FC\u30B9\u306F\u3000\u30AC\u30E9\u30CA\u30C4\u306E\u3048\u3060\u304C\\n\uFF11\uFF15{\u672C|\u307B\u3093}\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u3060\u3051\u3069\u3000\u3044\u30FC\u3044\uFF1F",
  "\u30AC\u30E9\u30CA\u30C4\u306E\u3048\u3060\u304C\u3000{\u8DB3|\u305F}\u308A\u306A\u3044\u3088\uFF01\\n\u30B3\u30FC\u30B9\u30C8\u30A8\u30EA\u30A2\u3000{\u6B69|\u3042\u308B}\u304D\u307E\u308F\u3063\u3066\u3000{\u62FE|\u3072\u308D}\u3063\u3066\u306D\uFF01",
  "\u308F\u304B\u3063\u305F\u308F\uFF01\u3000\u307E\u304B\u305B\u3066\uFF01",
  "\u3042\u307F\u3000\u3042\u307F\u2026\u2026\\n\u3042\u307F\u3000\u3042\u307F\u2026\u2026",
  "\u306F\u3044\u3000\u3069\u3046\u305E\\n\u3042\u307F\u305F\u3066\u3000\u30DB\u30E4\u30DB\u30E4\u3088",
  "\u30AC\u30E9\u30EB\u306E\u3059\u304C\u305F\u306E\\n\u30E4\u30C9\u30F3\u306B\u3000\u3064\u3051\u3066\u3042\u3052\u3066\uFF01"
]
