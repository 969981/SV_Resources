[
  "\u30AA\u30FC\u30C3\u30DB\u30C3\u30DB\u30C3\u30DB\uFF01\\n\u30AA\u30FC\u30C3\u30DB\u30C3\u30DB\u30C3\u30DB\uFF01[VAR 0114(0041)]",
  "{\u898B\u6E21|\u307F\u308F\u305F}\u3059{\u9650|\u304B\u304E}\u308A\u3000{\u767D\u9280|\u306F\u304F\u304E\u3093}\u306E{\u4E16\u754C|\u305B\u304B\u3044}\\n{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\u306B\u3000\u30AA\u30FB\u30C4\u3000\u30B6\u30DE\u30B9\u306D\u3048\uFF01[VAR 0114(0041)]",
  "\u305D\u3046\u3060\u306D\uFF01\u3000\u30CD\u30A2\u3061\u3083\u3093\u304C\\n{\u7528\u610F|\u3088\u3046\u3044}\u3057\u3066\u304F\u308C\u305F\u3000\u3053\u306E{\u670D|\u3075\u304F}\u3092\u3000{\u7740|\u304D}\u3066\u308C\u3070\\r\\n{\u5BD2|\u3055\u3080}\u3055\u3082\u3000\u3078\u3063\u3061\u3083\u3089\u3000\u3042\u3063\u305F\u304B\u3044\u3088\uFF01[VAR 0114(0040)]",
  "{\u6700\u9AD8\u7D1A|\u3055\u3044\u3053\u3046\u304D\u3085\u3046}\u306E\u3000{\u751F\u5730|\u304D\u3058}\u3092\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u308B\\n{\u6700\u9AD8\u7D1A|\u3055\u3044\u3053\u3046\u304D\u3085\u3046}\u306E\u3000\u30D6\u30E9\u30F3\u30C9\u3082\u306E\u3000\u30B6\u30DE\u30B9\u304B\u3089\u306D\uFF01[VAR 0114(0041)]",
  "\u3082\u306F\u3084\u3000\u3053\u306E{\u670D|\u3075\u304F}\u3092\u3000{\u7740|\u304D}\u305A\u306B\\n{\u767B\u5C71|\u3068\u3056\u3093}\u3057\u3066\u308B{\u4EBA|\u3072\u3068}\u304C\u3000\u304B\u308F\u3044\u305D\u3046\u3060\u3088[VAR 0114(0040)]",
  "\u3042\u3089\u2026\u2026\uFF1F\\n\u304A{\u7D04\u675F|\u3084\u304F\u305D\u304F}\u306E\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u304B\u305F\uFF01[VAR 0114(0041)]",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u3060\u3000\u3042\u308C\u306F\\n{\u9593\u9055|\u307E\u3061\u304C}\u3044\u306A\u304F\u3000\u304A{\u7D04\u675F|\u3084\u304F\u305D\u304F}\u306E\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u3060\u306D\uFF01[VAR 0114(0040)]",
  "\u30CD\u30A2\u3061\u3083\u3093\u3000{\u898B|\u307F}\u3066\u3088\uFF01\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E{\u670D|\u3075\u304F}\u306E\u3000{\u751F\u5730|\u304D\u3058}\u306E{\u8584|\u3046\u3059}\u3055\u3092\uFF01[VAR 0114(0040)]",
  "\u307E\u3000\u307E\u3042\uFF01\u3000\u306A\u3093\u3066\\n\u30DA\u30E9\u30DA\u30E9\u306A{\u751F\u5730|\u304D\u3058}\u3000\u306A\u3093\u3056\u3093\u3057\u3087\uFF01[VAR 0114(0041)]",
  "\u306D\u3048\u3000\u30D3\u30EA\u30AA\uFF01\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306F\u3000{\u5BD2|\u3055\u3080}\u3055\u306B\u3000{\u5F37|\u3064\u3088}\u3044\u306E\u304B\u3057\u3089\uFF1F[VAR 0114(0041)]",
  "\u308F\u304B\u3089\u306A\u3044\u2026\u2026\u3000\u308F\u304B\u3089\u306A\u3044\u3051\u3069\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E{\u9593|\u3042\u3044\u3060}\u3067\u306F\u3000\u304A{\u91D1|\u304B\u306D}\u304C\u3000\u306A\u3044\u3053\u3068\u3092\\r\\n\u3075\u3068\u3053\u308D\u304C\u3000{\u5BD2|\u3055\u3080}\u3044\u3068\u3000{\u8A00|\u3044}\u3046\u3089\u3057\u3044\u3088[VAR 0114(0040)]",
  "\u3060\u304B\u3089\u3000{\u5BD2|\u3055\u3080}\u3055\u306B\u306F\\n{\u6163|\u306A}\u308C\u3066\u308B\u306E\u304B\u306A\uFF1F[VAR 0114(0040)]",
  "\u30D3\u30EA\u30AA\u3000\u3042\u306A\u305F\u3063\u3066\u2026\u2026[VAR 0114(0041)]",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000{\u535A\u8B58|\u306F\u304F\u3057\u304D}\u306D\uFF01\\n\u30B4\u30FC\u30EB\u30C7\u30F3\u30FB\u30CD\u30A2{\u8CDE|\u3057\u3087\u3046}\u3000{\u53D7\u8CDE|\u3058\u3085\u3057\u3087\u3046}\u30B6\u30DE\u30B9\uFF01[VAR 0114(0041)]",
  "\u3084\u3063\u305F\u30FC\uFF01[VAR 0114(0040)]",
  "\u3053\u307E\u3063\u3066\u3044\u308B{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306B\u306F\u3000{\u624B|\u3066}\u3092{\u5DEE|\u3055}\u3057\u306E\u3079\u308B\\n\u305D\u308C\u304C\u3000\u3042\u305F\u304F\u3057\u305F\u3061\u3000\u30BB\u30EC\u30D6\u306E{\u52D9|\u3064\u3068}\u3081\u2026\u2026[VAR 0114(0041)]",
