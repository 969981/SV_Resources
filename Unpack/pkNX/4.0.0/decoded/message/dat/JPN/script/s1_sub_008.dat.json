  "\u305D\u306E\u3053\u3068\u3092\u3000{\u6C7A|\u3051\u3063}\u3057\u3066\\n{\u5FD8|\u308F\u3059}\u308C\u3066\u306F\u3000\u3044\u3051\u306A\u3044\u30B6\u30DE\u30B9\u3088\u2026\u2026[VAR 0114(0041)]",
  "\u3055\u3059\u304C\u3000\u30CD\u30A2\u3061\u3083\u3093\uFF01\u3000\u3060\u3093\u3060\u3093\\n{\u91D1\u8A00|\u304D\u3093\u3052\u3093}\u304C\u3000\u30C6\u30AD\u30C8\u30FC\u306B\u3000\u306A\u3063\u3066\u3044\u304F\uFF01[VAR 0114(0040)]",
  "\u3055\u3066\u3000\u30D3\u30EA\u30AA\uFF01\u3000\u3042\u305F\u304F\u3057\u305F\u3061\u306E\\n{\u4F11\u6687|\u304D\u3085\u3046\u304B}\u3082\u3000\u305D\u308D\u305D\u308D\u3000{\u7D42|\u304A}\u308F\u308A\u2026\u2026[VAR 0114(0041)]",
  "\u30E9\u30B9\u30C8\u306E\u3000\u3057\u3081\u304F\u304F\u308A\u306B\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u306E\u3000[VAR FF00(0006)]\u30C9{\u771F|\u307E}\u3093{\u4E2D|\u306A\u304B}[VAR FF00(0000)]\u3092\\r\\n{\u898B\u4E0B|\u307F\u304A}\u308D\u3057\u306B\u3000{\u884C|\u3044}\u304D\u305F\u3044\u30B6\u30DE\u30B9\uFF01[VAR 0114(0041)]",
  "\u3072\u3085\u30FC\uFF01\\n\u3059\u3054\u3044{\u5834\u6240|\u3070\u3057\u3087}\u3067\u3082\u3000{\u4E0A|\u3046\u3048}\u304B\u3089\u3000{\u898B\u4E0B|\u307F\u304A}\u308D\u3059\uFF01\\r\\n\u30CD\u30A2\u3061\u3083\u3093\u3000\u30BB\u30EC\u30D6\u306E{\u9451|\u304B\u304C\u307F}\u3060\u306D\uFF01[VAR 0114(0040)]",
  "{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u306E{\u4E2D|\u306A\u304B}\u306F\u3000{\u5165|\u306F\u3044}\u308C\u306A\u3044\u304B\u3082\u3000\u3060\u3051\u3069\\n\u3044\u3061\u304A\u3046\u3000\u30EA\u30FC\u30B0\u306B\u3000{\u7533\u8ACB|\u3057\u3093\u305B\u3044}\u3057\u3066\u304A\u304F\u306D\uFF01[VAR 0114(0040)]",
  "\u30CD\u30A2\u3055\u307E\u3068\u3000\u30D3\u30EA\u30AA\u3055\u307E\u306F\\n{\u6211|\u308F}\u304C{\u793E|\u3057\u3083}\u306E\u3088\u3046\u306A\u3000\u30DB\u30EF\u30A4\u30C8\u306A{\u5C71|\u3084\u307E}\u3078\\r\\n{\u767B|\u306E\u307C}\u308A\u306B\u3000\u3044\u304B\u308C\u307E\u3057\u305F",
  "\u2026\u2026{\u5F0A\u793E|\u3078\u3044\u3057\u3083}\u304C\u3000\u30DB\u30EF\u30A4\u30C8\u304B\u306F\u3000\u3068\u3082\u304B\u304F\\n{\u767D|\u3057\u308D}\u3044{\u5C71|\u3084\u307E}\u306A\u3089\u3000\u30CA\u30C3\u30DA{\u5C71|\u3084\u307E}\u304C\u3000{\u6709\u540D|\u3086\u3046\u3081\u3044}\u3067\u3059\u306D"
