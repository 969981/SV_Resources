[
  "[VAR 0100(0000)]\u3055\u3093\uFF01\uFF1F\\n\u3042\u3042\u3000{\u9A5A|\u304A\u3069\u308D}\u3044\u305F\uFF01[VAR 0114(0025)]",
  "\u304A{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u3067\u3059\u304B\uFF1F",
  "{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3057\u3066\u307E\u3057\u305F\uFF1F",
  "\u3044\u3044\u3048\u3000\u3044\u3044\u3048\\n{\u9055|\u3061\u304C}\u3046\u306E\u3088\u30FC\uFF01[VAR 0114(0025)]",
  "\u3055\u3063\u304D\u3000\u30A8\u30F3\u30C8\u30E9\u30F3\u30B9\u3092\\n{\u6B69|\u3042\u308B}\u3044\u3066\u305F\u3089\u306D[VAR 0114(0025)]",
  "{\u4F8B|\u308C\u3044}\u306E\u3000\u30C9\u30AD\u30C9\u30AD{\u71B1\u8996\u7DDA|\u306D\u3063\u3057\u305B\u3093}\\n{\u611F|\u304B\u3093}\u3058\u3061\u3083\u3063\u305F\u306E\u3088\uFF01[VAR 0114(0025)]",
  "\u305D\u308C\u3067\u3000\u3068\u3063\u3055\u306B\u3000{\u8FD1|\u3061\u304B}\u304F\u306E\\n{\u98DF\u5802|\u3057\u3087\u304F\u3069\u3046}\u306B\u3000{\u99C6|\u304B}\u3051\u3053\u3093\u3060\u306E[VAR 0114(0025)]",
  "\u3053\u3053\u3063\u3066\u3000{\u51FA\u5165\u53E3|\u3067\u3044\u308A\u3050\u3061}\u3000\u3072\u3068\u3064\u3060\u304B\u3089\\n{\u8996\u7DDA|\u3057\u305B\u3093}\u306E{\u4EBA|\u3072\u3068}\u304C\u3000{\u8FFD|\u304A}\u3044\u304B\u3051\u3066\u304D\u305F\u3089\\r\\n{\u6B63\u4F53|\u3057\u3087\u3046\u305F\u3044}\u304C\u3000\u308F\u304B\u308B\u3068\u3000{\u601D|\u304A\u3082}\u3063\u305F\u306E\uFF01[VAR 0114(0025)]",
  "\u3042\uFF01\u3000{\u8AB0|\u3060\u308C}\u304B\u3000{\u6765|\u304D}\u305F\u308F\uFF01[VAR 0114(0025)]",
  "\u2026\u2026\u304A\u304B\u3057\u3044\u306A\uFF1F\\n\u3053\u3053\u306B\u3000{\u5165|\u306F\u3044}\u3063\u305F\u3068\u3000{\u601D|\u304A\u3082}\u3063\u305F\u306E\u306B",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000\u3042\u306E\u3053\u3068\\n{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u3067\u304D\u306A\u304B\u3063\u305F\u2026\u2026",
  "\u3042\u306E{\u5973\u6027|\u3058\u3087\u305B\u3044}\u2026\u2026\u3000{\u4F55\u5EA6|\u306A\u3093\u3069}\u304B\\n{\u898B|\u307F}\u305F\u3053\u3068\u3000\u3042\u308B\u3088\u3046\u306A\u2026\u2026[VAR 0114(0025)]",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u751F\u5F92|\u305B\u3044\u3068}\u3000\u307F\u305F\u3044\u3060\u3051\u3069\\n{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u306E{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u3058\u3083\u3000\u306A\u3055\u305D\u3046\u306D\u2026\u2026\uFF1F[VAR 0114(0025)]",
  "{\u4ECA\u5EA6|\u3053\u3093\u3069}\u3000{\u898B|\u307F}\u304B\u3051\u305F\u3089\\n\u3053\u3063\u3061\u304B\u3089\u3000\u3044\u3063\u3061\u3083\u3046\u308F\uFF01[VAR 0114(0025)]",
  "\u3072\u3068\u308A\u3058\u3083\u3000{\u6016|\u3053\u308F}\u304B\u3063\u305F\u304B\u3089\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000\u3044\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u3068\u3046[VAR 0114(0025)]",
  "\u30BF\u30A4\u30E0{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304B\u3089\\n{\u4FE1\u983C|\u3057\u3093\u3089\u3044}\u3092\u3000{\u611F|\u304B\u3093}\u3058\u308B\uFF01"
]
