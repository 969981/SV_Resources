[
  "\u30C8\u30C3\u30D7\u3068\u306E\u3000{\u5F85|\u307E}\u3061{\u5408|\u3042}\u308F\u305B{\u6642\u523B|\u3058\u3053\u304F}\u2026\u2026\\n\u30A2\u30DD{\u7121|\u306A}\u3057\u306E\u3000{\u73CD\u5BA2|\u3061\u3093\u304D\u3083\u304F}\u2026\u2026[VAR 0114(0015)]",
  "\u3042\u306E{\u4EBA|\u3072\u3068}\u306E\u3000\u3084\u308A\u305D\u3046\u306A\u3053\u3068\u3067\u3059\\n\u3059\u3079\u3066\u3092\u3000{\u5BDF|\u3055\u3063}\u3057\u307E\u3057\u305F\u2026\u2026[VAR 0114(0015)]",
  "\u3088\u308D\u3057\u304F\u304A{\u9858|\u306D\u304C}\u3044\u3057\u307E\u3059",
  "\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059",
  "\u3069\u3046\u3082\u3000\u3054{\u4E01\u5BE7|\u3066\u3044\u306D\u3044}\u306B\u2026\u2026[VAR 0114(0015)]",
  "\u30C8\u30C3\u30D7\u306F\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u306E{\u4E0A\u53F8|\u3058\u3087\u3046\u3057}\u3000\u306A\u3093\u3067\u3059\u304C\\n\u307E\u3055\u304B\u3000{\u5B66\u751F|\u304C\u304F\u305B\u3044}\u307E\u3067\u3000\u3053\u304D\u3064\u304B\u3046\u3068\u306F\u2026\u2026[VAR 0114(0015)]",
  "\u306A\u308B\u307B\u3069\uFF1F\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u5927\u4F1A|\u305F\u3044\u304B\u3044}\u306B\\n\u30C8\u30C3\u30D7\u3092\u3000{\u547C|\u3088}\u3076\u305F\u3081\u306B\u3000\u304A{\u624B\u4F1D|\u3066\u3064\u3060}\u3044\u3092\u2026\u2026[VAR 0114(0015)]",
  "{\u597D|\u3059}\u304D\u3067\u3000\u3084\u3063\u3066\u308B\u306A\u3089\u3000\u3044\u3044\u3093\u3067\u3059\\n{\u81EA\u5206|\u3058\u3076\u3093}\u306F\u3000{\u9858|\u306D\u304C}\u3044{\u4E0B|\u3055}\u3052\u306A\u3093\u3067\u2026\u2026[VAR 0114(0015)]",
  "\u2026\u2026\u2026\u2026\u3000\u2026\u2026\u2026\u2026\\n\u2026\u2026\u2026\u2026\u3000\u2026\u2026\u2026\u2026[VAR 0114(0015)]",
  "\u305D\u308C\u3067\u306F\u3000\u3068\u3063\u3068\u3068\\n\u30BF\u30B9\u30AF{\u5B8C\u4E86|\u304B\u3093\u308A\u3087\u3046}\u3068\u3000\u3044\u304D\u307E\u3057\u3087\u3046[VAR 0114(0015)]",
  "{\u9762\u5012|\u3081\u3093\u3069\u3046}\u306A{\u4ED5\u4E8B|\u3057\u3054\u3068}\u306F\\n\u3068\u3063\u3068\u3068\u3000\u3084\u3063\u3066\u3057\u307E\u3044\u307E\u3057\u3087\u3046[VAR 0114(0015)]",
  "\u3067\u306F\u3000{\u98DF\u5802|\u3057\u3087\u304F\u3069\u3046}\u306B[VAR 0114(0015)]",
  "\u306F\u3084\u304F\u3000{\u7D42|\u304A}\u308F\u3089\u305B\u305F\u3044\u3093\u3067\u3059\u304C\u2026\u2026[VAR 0114(0015)]"
]
