[
  "{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3000\u30B9\u30DE\u30DB\u3092\u3000\u3057\u307E\u3044\u305F\u307E\u3048\\n{\u4ECA\u671F|\u3053\u3093\u304D}\u3000{\u6700\u5F8C|\u3055\u3044\u3054}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u3088\u3046[VAR 0114(0029)]",
  "\u3075\u308A{\u8FD4|\u304B\u3048}\u308C\u3070\u3000{\u8863\u98DF\u4F4F|\u3044\u3057\u3087\u304F\u3058\u3085\u3046}\u306E\u3000\u300E{\u98DF|\u3057\u3087\u304F}\u300F\u3070\u304B\u308A\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3067\u3000\u3068\u308A\u3042\u3064\u304B\u3063\u3066\u3057\u307E\u3063\u305F\u306A[VAR 0114(0029)]",
  "{\u4ECA|\u3044\u307E}\u3055\u3089\u3067\u306F\u3000\u3042\u308B\u304C\\n\u300E{\u8863|\u3044}\u300F\u2026\u2026\u3000\u3064\u307E\u308A\u3000{\u670D|\u3075\u304F}\u306B\u3064\u3044\u3066\\r\\n\u30EF\u30AC\u30CF\u30A4\u3000{\u8AAC\u660E|\u305B\u3064\u3081\u3044}\u3055\u305B\u3066\u3044\u305F\u3060\u3053\u3046[VAR 0114(0029)]",
  "{\u5B58|\u305E\u3093}\u3058\u3066\u3044\u308B\u3068\u3000{\u601D|\u304A\u3082}\u3046\u304C\\n{\u6211|\u308F}\u304C{\u6821|\u3053\u3046}\u306F\u3000{\u81EA\u7531|\u3058\u3086\u3046}\u306A{\u6821\u98A8|\u3053\u3046\u3075\u3046}\u3060[VAR 0114(0029)]",
  "\u30D1\u30EB\u30C7\u30A2\u306E\u3000{\u591A\u69D8|\u305F\u3088\u3046}\u306A{\u6C17\u5019|\u304D\u3053\u3046}\u306B\u3000\u3042\u308F\u305B\u3066\\n{\u5B63\u7BC0|\u304D\u305B\u3064}\u306E{\u5236\u670D|\u305B\u3044\u3075\u304F}\u304C\u3000{\u7528\u610F|\u3088\u3046\u3044}\u3055\u308C\u3066\u3044\u308B\u304C\\r\\n\u3044\u3064\u3000\u3069\u306E{\u5236\u670D|\u305B\u3044\u3075\u304F}\u3092\u3000{\u7740|\u304D}\u3066\u3082\u3000\u304B\u307E\u308F\u306A\u3044[VAR 0114(0029)]",
  "{\u5165\u5B66\u6642|\u306B\u3085\u3046\u304C\u304F\u3058}\u306B\u3000{\u6625\u590F\u79CB\u51AC\u7528|\u306F\u308B\u306A\u3064\u3042\u304D\u3075\u3086\u3088\u3046}\u306E\\n\u30C8\u30C3\u30D7\u30B9\u3068\u3000\u30DC\u30C8\u30E0\u30B9\u304C\\r\\n\uFF14{\u7740|\u3061\u3083\u304F}\u305A\u3064\u3000{\u914D|\u304F\u3070}\u3089\u308C\u3066\u3044\u308B\u306F\u305A[VAR 0114(0029)]",
  "\u2026\u2026\u3082\u3057\u3000{\u6C17|\u304D}\u3065\u3044\u3066\u3044\u306A\u3044\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u306F\\n{\u5404\u81EA|\u304B\u304F\u3058}\u3000\u30AF\u30ED\u30FC\u30BC\u30C3\u30C8\u3092\u3000{\u78BA\u8A8D|\u304B\u304F\u306B\u3093}\u3059\u308B\u3088\u3046\u306B[VAR 0114(0029)]",
  "{\u5236\u670D|\u305B\u3044\u3075\u304F}\u3055\u3048\u3000{\u7740\u7528|\u3061\u3083\u304F\u3088\u3046}\u3057\u3066\u3044\u308C\u3070\\n{\u5B66\u6821\u6307\u5B9A|\u304C\u3063\u3053\u3046\u3057\u3066\u3044}\u306E\u3000\u30D0\u30C3\u30B0\u3067\u306A\u304F\u3068\u3082[VAR 0114(0029)]",
  "{\u5E3D\u5B50|\u307C\u3046\u3057}\u306E{\u7A2E\u985E|\u3057\u3085\u308B\u3044}\u3084\u3000{\u7740\u8131|\u3061\u3083\u304F\u3060\u3064}\\n{\u9AEA\u578B|\u304B\u307F\u304C\u305F}\u3055\u3048\u3000{\u81EA\u7531|\u3058\u3086\u3046}\u306B\u3057\u3066\u3000\u304B\u307E\u308F\u306A\u3044[VAR 0114(0029)]",
  "\u2026\u2026\u30BB\u30A4\u30B8{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306E\u3000{\u9AEA\u578B|\u304B\u307F\u304C\u305F}\u3082\\n\u30EF\u30AC\u30CF\u30A4\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306A\u3089\\r\\n{\u6821\u5247\u9055\u53CD|\u3053\u3046\u305D\u304F\u3044\u306F\u3093}\u3000\u3060\u3063\u305F\u3053\u3068\u3067\u3042\u308D\u3046\u306A[VAR 0114(0029)]",
  "\u305D\u3046\u3044\u3048\u3070\u2026\u2026[VAR 0114(0029)]",
  "{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3089\u304C\u3000{\u670D\u88C5\u4EE5\u5916|\u3075\u304F\u305D\u3046\u3044\u304C\u3044}\u3067\u3000\u3088\u304F\\n\u30A2\u30EC\u30F3\u30B8\u3057\u3066\u3044\u308B\u3000\u304B\u308F\u3044\u3044\u30A2\u30EC\u306F\\r\\n\u2026\u2026\u3044\u3063\u305F\u3044\u3000\u3069\u3046\u3084\u308B\u306E\u304B\u306D\uFF1F[VAR 0114(0029)]",
  "{\u6559\u5BA4|\u304D\u3087\u3046\u3057\u3064}\u306E{\u673A|\u3064\u304F\u3048}\uFF1F",
  "{\u5BEE|\u308A\u3087\u3046}\u306E{\u90E8\u5C4B|\u3078\u3084}\uFF1F",
  "\u30B9\u30DE\u30DB\u30ED\u30C8\u30E0\uFF1F",
  "\u3044\u3084\u3000{\u9055|\u3061\u304C}\u3046\u2026\u2026\\n\u3082\u3063\u3068\u3000{\u5C0F|\u3061\u3044}\u3055\u304F\u3066\u3000\u304B\u308F\u3044\u3044\u30A2\u30EC\u3060\u2026\u2026\\r\\n\u3068\u3044\u3046\u304B\u3000\u304D\u307F\u306E{\u673A|\u3064\u304F\u3048}\u3000\u3059\u3055\u307E\u3058\u304F\\r\\n{\u4F55|\u306A\u3093}\u306E{\u5909\u54F2|\u3078\u3093\u3066\u3064}\u3082\u3000\u306A\u3044\u3067\u306F\u306A\u3044\u304B\uFF01[VAR 0114(0029)]",
  "\u3044\u3084\u3000{\u9055|\u3061\u304C}\u3046\u2026\u2026\\n\u3082\u3063\u3068\u3000{\u5C0F|\u3061\u3044}\u3055\u304F\u3066\u3000\u304B\u308F\u3044\u3044\u30A2\u30EC\u3060\u2026\u2026\\r\\n\u3068\u3044\u3046\u304B\u3000\u30EF\u30AC\u30CF\u30A4\u304C\u3000{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3089\u306E\\r\\n{\u90E8\u5C4B|\u3078\u3084}\u306E\u3053\u3068\u3000{\u77E5|\u3057}\u3063\u3066\u305F\u3089\u3000{\u554F\u984C|\u3082\u3093\u3060\u3044}\u3067\u3042\u308D\u3046[VAR 0114(0029)]",
  "\u3054{\u540D\u7B54|\u3081\u3044\u3068\u3046}\uFF01\u3000\u3042\u306E\u3000\u304B\u308F\u3044\u3044\u3084\u3064\u3060\uFF01\\n\u3068\u3066\u3082\u3000{\u6C17|\u304D}\u306B\u306A\u3063\u3066\u3044\u305F\u306E\u3060\uFF01\uFF01[VAR 0114(0029)]",
  "\u305D\u3046\u2026\u2026\u3000\u30B9\u30DE\u30DB\u30ED\u30C8\u30E0\u3060\uFF01[VAR 0114(0029)]",
  "\u2026\u2026\u306A\u308B\u307B\u3069\u3000{\u8208\u5473\u6DF1|\u304D\u3087\u3046\u307F\u3076\u304B}\u3044\uFF01\\n\u30C7\u30EA\u30D0\u30FC\u30C9\u30DD\u30FC\u30C1\u306A\u308B\u3000\u30B7\u30E7\u30C3\u30D7\u3067\\r\\n\u30B9\u30DE\u30DB\u30ED\u30C8\u30E0\u306E\u3000\u30AB\u30D0\u30FC\u3092\u3000{\u8CB7|\u304B}\u3048\u308B\u3068\uFF01[VAR 0114(0029)]",
  "{\u6709\u76CA|\u3086\u3046\u3048\u304D}\u306A{\u60C5\u5831|\u3058\u3087\u3046\u307B\u3046}\u3000{\u611F\u8B1D|\u304B\u3093\u3057\u3083}\u3059\u308B\u2026\u2026[VAR 0114(0029)]",
  "\u3055\u3063\u305D\u304F\u3000{\u660E\u65E5|\u307F\u3087\u3046\u306B\u3061}\u3000\u30EF\u30AC\u30CF\u30A4{\u597D|\u3054\u306E}\u307F\u306E\\n\u304B\u308F\u3044\u3089\u3057\u3044\u30B1\u30FC\u30B9\u3092\u3000{\u8CB7|\u304B}\u3044\u306B\u3044\u304F\u3068\u3057\u3088\u3046[VAR 0114(0029)]",
  "\u2026\u2026{\u96D1\u8AC7|\u3056\u3064\u3060\u3093}\u304C\u3000{\u904E|\u3059}\u304E\u3066\u3057\u307E\u3063\u305F\u306A[VAR 0114(0029)]",
  "\u3055\u3066\u3000\u3053\u308C\u307E\u3067\u3000\u30EF\u30AC\u30CF\u30A4\u3068\\n{\u5BB6\u5EAD\u79D1|\u304B\u3066\u3044\u304B}\u3068\u3044\u3046\u3000{\u751F|\u3044}\u304D\u308B{\u8853|\u3059\u3079}\u3092\\r\\n\u307F\u304C\u3044\u3066\u304D\u305F\u3000{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3089\u3078\u3000{\u544A|\u3064}\u3050[VAR 0114(0029)]",
  "\u30EF\u30AC\u30CF\u30A4\u306E{\u5B66\u554F|\u304C\u304F\u3082\u3093}\u306F\u3000{\u6570\u5B66|\u3059\u3046\u304C\u304F}\u306A\u3069\u3068\u3000{\u9055|\u3061\u304C}\u3063\u3066\\n{\u8A66\u9A13|\u3057\u3051\u3093}\u306E{\u70B9\u6570|\u3066\u3093\u3059\u3046}\u304C\u3000{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3089\u306E{\u884C|\u3086}\u304F{\u672B|\u3059\u3048}\u3092\\r\\n{\u5206|\u308F}\u304B\u3064\u3088\u3046\u306A\u3000\u305F\u3044\u305D\u3046\u306A\u3082\u306E\u3067\u306F\u3000\u306A\u3044[VAR 0114(0029)]",
  "\u2026\u2026\u3060\u304C\u3000{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3092\u3057\u305F\u308A\\n\u30DD\u30B1\u30E2\u30F3\u306E\u304A{\u4E16\u8A71|\u305B\u308F}\u3092\u3000\u3057\u3066\u3044\u308B\u3068\u304D\\r\\n{\u671D\u8D77|\u3042\u3055\u304A}\u304D\u3066\u3000{\u7740|\u304D}\u308B\u3082\u306E\u3092\u3000{\u9078|\u3048\u3089}\u3076\u3068\u304D\u306A\u3069\u3067[VAR 0114(0029)]",
  "{\u5C11|\u3059\u3053}\u3057\u3060\u3051\u3000{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3089\u306E\u3000{\u4EBA\u751F|\u3058\u3093\u305B\u3044}\u3092\u3000{\u8C4A|\u3086\u305F}\u304B\u306B\u3059\u308B\\n{\u6F64\u6ED1\u6CB9|\u3058\u3085\u3093\u304B\u3064\u3086}\u3068\u3000\u306A\u3063\u3066\u304F\u308C\u308C\u3070\u3000{\u5149\u6804|\u3053\u3046\u3048\u3044}\u3060\\r\\n\u2026\u2026\u30CF\u30C3\u30B5\u30AF{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306E\u3000{\u53D7|\u3046}\u3051{\u58F2|\u3046}\u308A\u3067\u3042\u308B\u304C\u306A[VAR 0114(0029)]",
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u307E\u3067\u3000\u304A{\u4ED8|\u3064}\u304D{\u5408|\u3042}\u3044\\n\u3044\u305F\u3060\u304D\u3000{\u611F\u8B1D|\u304B\u3093\u3057\u3083}\u3059\u308B[VAR 0114(0029)]",
  "{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u7D42\u4E86|\u3057\u3085\u3046\u308A\u3087\u3046}\u3060\\n{\u671F\u672B\u8A66\u9A13|\u304D\u307E\u3064\u3057\u3051\u3093}\u3082\u3000\u304C\u3093\u3070\u308A\u305F\u307E\u3048[VAR 0114(0029)]"
]
