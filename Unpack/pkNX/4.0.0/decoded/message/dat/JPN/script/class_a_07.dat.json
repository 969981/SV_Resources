[
  "\u3069\u304A\u3082\u3000\u3069\u304A\u3082\\n\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u307E\u3057\u3087\u3046[VAR 0114(002A)]",
  "{\u6B21|\u3064\u304E}\u304C\u3000{\u671F\u672B|\u304D\u307E\u3064}\u30C6\u30B9\u30C8\u306A\u306E\u3067\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3068\u3057\u3066\u306F\u3000{\u4ECA\u65E5|\u304D\u3087\u3046}\u304C\u3000{\u6700\u5F8C|\u3055\u3044\u3054}\u3067\u3059[VAR 0114(002A)]",
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u306E\u30C6\u30FC\u30DE\u306F\u3000\u3058\u3083\u3058\u3083\u3058\u3083\u3042\u3093\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000[VAR FF00(0006)]\u30D5\u30A9\u30EB\u30E0[VAR FF00(0000)]\u3000\u306B\u3064\u3044\u3066\u3067\u3059\\r\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000{\u5F62|\u304B\u305F\u3061}\u306E\u3053\u3068\u3060\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\u304F\u3060\u3055\u3044[VAR 0114(002A)]",
  "{\u540C|\u304A\u306A}\u3058{\u500B\u4F53|\u3053\u305F\u3044}\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\n\u3042\u308B{\u6761\u4EF6\u4E0B|\u3058\u3087\u3046\u3051\u3093\u304B}\u3067\u3000\u30D5\u30A9\u30EB\u30E0\u3092\u3000{\u5909|\u304B}\u3048\u308B\u3053\u3068\u3092\\r\\n[VAR FF00(0006)]\u30D5\u30A9\u30EB\u30E0\u30C1\u30A7\u30F3\u30B8[VAR FF00(0000)]\u3068\u3000{\u547C|\u3088}\u3073\u307E\u3059\u3088\u30FC[VAR 0114(002A)]",
  "{\u4F8B|\u305F\u3068}\u3048\u3070\u3000\u30D1\u30EB\u30C7\u30A2\u3067\u3000{\u4E00\u822C\u7684|\u3044\u3063\u3071\u3093\u3066\u304D}\u306B\\n\u30E9\u30A4\u30C9\u3055\u308C\u3066\u3044\u308B\u3000\u30E2\u30C8\u30C8\u30AB\u30B2\u306B\u306F\\r\\n\uFF13\u3064\u306E\u30D5\u30A9\u30EB\u30E0\u304C\u3000\u3042\u308A\u307E\u3042\u3059[VAR 0114(002A)]",
  "{\u65E5\u5E38|\u306B\u3061\u3058\u3087\u3046}\u3067\u306F\u3000{\u56DB|\u3088}\u3064{\u8DB3|\u3042\u3057}\u306E\u3000\u30C7\u30D5\u30A9\u30EB\u30C8\u30D5\u30A9\u30EB\u30E0\\n{\u6226\u95D8\u6642|\u305B\u3093\u3068\u3046\u3058}\u306B\u306F\u3000{\u4E8C\u8DB3\u6B69\u884C|\u306B\u305D\u304F\u307B\u3053\u3046}\u306E\u3000\u30D0\u30C8\u30EB\u30D5\u30A9\u30EB\u30E0[VAR 0114(002A)]",
  "\u305D\u3057\u3066\u3000\u307F\u306A\u3055\u3093\u3092\u3000{\u4E57|\u306E}\u305B\u308B\u3068\u304D\u306F\\n\u306E\u3069{\u888B|\u3076\u304F\u308D}\u3068\u3000\u3057\u3063\u307D\u3092\u3000\u3075\u304F\u3089\u307E\u305B\u3066\\r\\n\u30E9\u30A4\u30C9\u30D5\u30A9\u30EB\u30E0\u3068\u3000\u306A\u308A\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u3042\u3068\u306F\u3000{\u8EAB\u8FD1|\u307F\u3062\u304B}\u306A\u3068\u3053\u308D\u3067\u3000\u3044\u3046\u3068\\n\u307F\u306A\u3055\u3093\u304C\u3000{\u6301|\u3082}\u3063\u3066\u3044\u308B\u3000{\u6A5F\u68B0|\u304D\u304B\u3044}\u2026\u2026[VAR 0114(002A)]",
  "\u30B9\u30DE\u30DB\u306B\u3082\u3000\u3068\u3042\u308B\u30DD\u30B1\u30E2\u30F3\u304C\\n{\u5165|\u306F\u3044}\u3063\u3066\u3044\u308B\u3082\u306E\u3082\u3000\u3042\u308A\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u3055\u3066\u3000\u30B9\u30DE\u30DB\u306B\u3000{\u5165|\u306F\u3044}\u3063\u3066\u3044\u308B\\n\u30DD\u30B1\u30E2\u30F3\u306F\u3000\u3044\u3063\u305F\u3044\u3000{\u8AB0|\u3060\u308C}\u3067\u3057\u3087\u3046\uFF1F[VAR 0114(002A)]",
  "\u30ED\u30C8\u30E0",
  "\u30D4\u30AB\u30C1\u30E5\u30A6",
  "\u30D8\u30E9\u30AF\u30ED\u30B9",
  "[VAR 0100(0000)]\u3055\u3093\u306F\u3000{\u6A5F\u68B0|\u304D\u304B\u3044}\u3082\\n\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u304A\u304F\u308F\u3057\u3044\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u305F\u3057\u304B\u306B\u3000\u30D4\u30AB\u30C1\u30E5\u30A6\u304C\\n\u30B9\u30DE\u30DB\u306B\u3000{\u5165|\u306F\u3044}\u3063\u3066\u305F\u3089\u3000\u304B\u308F\u3044\u304F\u3063\u3066\\r\\n\u305F\u304F\u3055\u3093\u3000{\u6B69|\u3042\u308B}\u304D\u305F\u304F\u306A\u3063\u3061\u3083\u3046\u304B\u3082\uFF1F\\r\\n\u2026\u2026\u3067\u3082\u3000{\u4ECA\u56DE|\u3053\u3093\u304B\u3044}\u306F\u3000\u306F\u305A\u308C\u3067\u3059\u3088\u30FC\uFF01[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u3055\u3093\u3000\u3046\u307E\u3044\uFF01\\n\u305F\u3057\u304B\u306B\u3000\u30D8\u30E9\u30AF\u30ED\u30B9\u306F\u3000\u30B9\u30DE\u30FC\u30C8\u30DB\u30FC\u30F3\\r\\n{\u7565|\u308A\u3083\u304F}\u3057\u3066\u3000\u30B9\u30DE\u30DB\u306E{\u6280|\u308F\u3056}\u3092\u3000{\u899A|\u304A\u307C}\u3048\u307E\u3059\u306D\u3048\\r\\n\u2026\u2026\u3067\u3082\u3000{\u4ECA\u56DE|\u3053\u3093\u304B\u3044}\u306F\u3000\u306F\u305A\u308C\u3067\u3059\u3088\u30FC\uFF01[VAR 0114(002A)]",
  "\u305D\u3046\u3067\u3059\u3000\u307F\u306A\u3055\u3093\u306E\\n\u30B9\u30DE\u30DB\u306B\u306F\u3000\u30ED\u30C8\u30E0\u304C\u3000{\u5165|\u306F\u3044}\u3063\u3066\u3044\u3066\\r\\n\u3044\u308D\u3044\u308D\u3000\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u304F\u308C\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u30B9\u30DE\u30DB\u30ED\u30C8\u30E0\u306E\u3000\u30ED\u30C8\u30E0\u306F\u3000{\u7279\u5225|\u3068\u304F\u3079\u3064}\u306A\u306E\u3067\\n\u307B\u304B\u306E\u3000{\u96FB\u5316\u88FD\u54C1|\u3067\u3093\u304B\u305B\u3044\u3072\u3093}\u306B\u306F\u3000{\u5165|\u306F\u3044}\u3063\u305F\u308A\u3057\u307E\u305B\u3093\u304C[VAR 0114(002A)]",
  "{\u901A\u5E38|\u3064\u3046\u3058\u3087\u3046}\u306E\u3000\u30ED\u30C8\u30E0\u306F\u3000{\u6D17\u6FEF\u6A5F|\u305B\u3093\u305F\u304F\u304D}\u3084\\n{\u96FB\u5B50|\u3067\u3093\u3057}\u30EC\u30F3\u30B8\u306B\u3000{\u5165|\u306F\u3044}\u308B\u3053\u3068\u3067\\r\\n\u30D5\u30A9\u30EB\u30E0\u3092\u3000{\u5909|\u304B}\u3048\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u307E\u3042\u3059[VAR 0114(002A)]",
  "\u30ED\u30C8\u30E0\u306F\u3000{\u4F8B\u5916|\u308C\u3044\u304C\u3044}\u306A\u3093\u3067\u3059\u304C\u3000{\u4E00\u822C\u7684|\u3044\u3063\u3071\u3093\u3066\u304D}\u306B\u306F\\n{\u6301|\u3082}\u3061{\u7269|\u3082\u306E}\u3084\u3000{\u9053\u5177|\u3069\u3046\u3050}\u306B\u3088\u3063\u3066\u3000\u30D5\u30A9\u30EB\u30E0\u304C\\r\\n{\u5909|\u304B}\u308F\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u591A|\u304A\u304A}\u3044\u3067\u3059[VAR 0114(002A)]",
  "\u30AA\u30C9\u30EA\u30C9\u30EA\u306F\u3000{\u82B1|\u306F\u306A}\u306E\u30DF\u30C4\u3092\u3000{\u4E0E|\u3042\u305F}\u3048\u308B\u3068\\n\uFF14\u3064\u306E\u3000\u30D5\u30A9\u30EB\u30E0\u306B\u3000{\u5909\u5316|\u3078\u3093\u304B}\u3057\u307E\u3059\u3057[VAR 0114(002A)]",
  "\u30D5\u30A9\u30EB\u30E0\u304C\u3000{\u5909|\u304B}\u308F\u308B\u3068\\n\u30BF\u30A4\u30D7\u3084{\u6280|\u308F\u3056}\u304C\u3000{\u5909|\u304B}\u308F\u308B\u3082\u306E\u3082\u3000\u3044\u307E\u3059\u3088\u30FC[VAR 0114(002A)]",
  "\u30D5\u30A9\u30EB\u30E0\u30C1\u30A7\u30F3\u30B8\u306F\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3068\u3000{\u9055|\u3061\u304C}\u3063\u3066\\n\u3082\u3068\u306E{\u59FF|\u3059\u304C\u305F}\u306B\u3000{\u623B|\u3082\u3069}\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u307E\u3059\u3057\\c\\n{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044\u3068\u3000{\u9055|\u3061\u304C}\u3063\u3066\\n{\u540C\u4E00\u500B\u4F53|\u3069\u3046\u3044\u3064\u3053\u305F\u3044}\u3067\u3000{\u59FF|\u3059\u304C\u305F}\u304C\u3000{\u5909|\u304B}\u308F\u308A\u307E\u3059[VAR 0114(002A)]",
  "\u30D5\u30A9\u30EB\u30E0\u30C1\u30A7\u30F3\u30B8\u2026\u2026\\n{\u5965\u6DF1|\u304A\u304F\u3076\u304B}\u3044{\u73FE\u8C61|\u3052\u3093\u3057\u3087\u3046}\u3000\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u7FD2|\u306A\u3089}\u3063\u3066\u2026\u2026\\n\u3058\u3083\u3042\u3000\u306A\u3044\u3067\u3059\u3051\u3069[VAR 0114(002A)]",
  "\u307F\u306A\u3055\u3093\u3082\u3000\u3053\u306E{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3067\\n\u3044\u3063\u3071\u3044\u3000{\u904A|\u3042\u305D}\u3093\u3067\u3000\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u3066\u2026\u2026[VAR 0114(002A)]",
  "{\u65B0|\u3042\u305F\u3089}\u3057\u3044{\u81EA\u5206|\u3058\u3076\u3093}\u306B\u3000\u30D5\u30A9\u30EB\u30E0\u30C1\u30A7\u30F3\u30B8\uFF01\\n\u3057\u3066\u3044\u3063\u3066\u304F\u308C\u308B\u3068\u3000\u3046\u308C\u3057\u3044\u306A\u3042\\r\\n\u2026\u2026\u306A\u3093\u3061\u3083\u3063\u3066\uFF01[VAR 0114(002A)]",
  "\u3042\u3042\uFF01\u3000{\u8A00|\u3044}\u3044{\u5FD8|\u308F\u3059}\u308C\u3066\u305F\uFF01[VAR 0114(002A)]",
  "{\u5730\u57DF|\u3061\u3044\u304D}\u306B\u3088\u3063\u3066\u3000{\u9055|\u3061\u304C}\u3046\\n\u30EA\u30FC\u30B8\u30E7\u30F3\u30D5\u30A9\u30FC\u30E0\u306F\u3000{\u4E00\u822C\u7684|\u3044\u3063\u3071\u3093\u3066\u304D}\u306A{\u59FF|\u3059\u304C\u305F}\u3068\u306F\\r\\n{\u9055|\u3061\u304C}\u3063\u3066\u3066\u3000{\u5909|\u304B}\u308F\u308B\u3053\u3068\u306E\u306A\u3044\u3000{\u5148\u5929\u7684|\u305B\u3093\u3066\u3093\u3066\u304D}\u306A\u2026\u2026[VAR 0114(002A)]",
  "\u2026\u2026\u3048\u3078\u3078\\n\u30C1\u30E3\u30A4\u30E0\u3000{\u9CF4|\u306A}\u3063\u3061\u3083\u3044\u307E\u3057\u305F[VAR 0114(002A)]",
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u307E\u3067\u3000\u3053\u3093\u306A\u3067\u3000\u3059\u307F\u307E\u305B\u3093\u3067\u3059\u304C\\c\\n{\u4ECA|\u3044\u307E}\u307E\u3067\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000{\u697D|\u305F\u306E}\u3057\u304B\u3063\u305F\u3067\u3059\\n{\u671F\u672B|\u304D\u307E\u3064}\u30C6\u30B9\u30C8\u3000\u304C\u3093\u3070\u3063\u3066\u304F\u3060\u3055\u3044\u306D\u3048[VAR 0114(002A)]"
]
