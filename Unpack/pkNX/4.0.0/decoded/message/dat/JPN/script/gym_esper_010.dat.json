[
  "\u3088\u3046\u3053\u305D\u3000\u30D9\u30A4\u30AF\u30B8\u30E0\u3078\uFF01",
  "{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}{\u8005|\u3057\u3083}\u306E\\n\u304A{\u540D\u524D|\u306A\u307E\u3048}\u3092\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3057\u307E\u3059\u2026\u2026\\r\\n[VAR 0100(0000)]\u3055\u3093\u3000\u3067\u3059\u306D\uFF01",
  "{\u5F53|\u3068\u3046}\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30EA\u30C3\u30D7\u3068\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308B\u306B\u306F\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u3092\\r\\n\u30AF\u30EA\u30A2\u3059\u308B{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308A\u307E\u3059",
  "\u30D9\u30A4\u30AF\u30B8\u30E0\u306E\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u306F\u2026\u2026\\n[VAR FF00(0006)]\u30A8\u30AF\u30B5\u30B5\u30A4\u30BA[VAR FF00(0000)]\u3067\u3059\uFF01",
  "\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30EA\u30C3\u30D7\u304C\u3000{\u767A\u660E|\u306F\u3064\u3081\u3044}\u3057\u305F\\n[VAR FF00(0006)]{\u559C\u6012\u9A5A\u697D|\u304D\u3069\u304D\u3087\u3046\u3089\u304F}\u30A8\u30AF\u30B5\u30B5\u30A4\u30BA[VAR FF00(0000)]\u3092\\r\\n{\u6700\u5F8C|\u3055\u3044\u3054}\u307E\u3067\u3000{\u6210|\u306A}\u3057{\u9042|\u3068}\u3052\u308C\u3070\u3000{\u5408\u683C|\u3054\u3046\u304B\u304F}\u3067\u3059\uFF01",
  "\u304F\u308F\u3057\u3044\u30EB\u30FC\u30EB\u306F\u3000{\u5F53|\u3068\u3046}\u30B8\u30E0\u3092\u3000{\u51FA|\u3067}\u3066\\n{\u5DE6\u624B|\u3072\u3060\u308A\u3066}\u306B\u3042\u308B\u3000\u30A8\u30AF\u30B5\u30B5\u30A4\u30BA{\u4F1A\u5834|\u304B\u3044\u3058\u3087\u3046}\u306E\\r\\n{\u9ED2|\u304F\u308D}\u3044\u30B8\u30E3\u30FC\u30B8\u306E{\u5973\u6027|\u3058\u3087\u305B\u3044}\u306B\u3000\u304A{\u805E|\u304D}\u304D\u304F\u3060\u3055\u3044",
  "\u305D\u308C\u3067\u306F\u3000\u3044\u3063\u3066\u3089\u3063\u3057\u3083\u3044\uFF01"
]
