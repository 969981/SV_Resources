  "{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u30C6\u30B9\u30C8\u306F\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u306E{\u6B21|\u3064\u304E}\u304C\\n\u30CF\u30C3\u30B5\u30AF\u3055\u3093\u306A\u306E\u304C\u3000\u3088\u304F\u306A\u3044\u3067\u3059\\c\\n\u30C1\u30EA\u3055\u3093\u304B\u3000\u30DD\u30D4\u30FC\u3055\u3093\u306A\u3089\\n{\u5927\u58F0|\u304A\u304A\u3054\u3048}\u3067\u3000{\u547C|\u3088}\u3070\u306A\u304F\u3066\u3082\u3000{\u6C17|\u304D}\u3065\u3044\u3066\u304F\u308C\u307E\u3059[VAR 0114(0015)]",
  "[VAR 0101(0001)]\u306F\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u3067\u3059\\n\u304B\u3089\u3052\u3093\u304D\u3067\u306F\u3000\u306A\u3044\u3068\u3000{\u601D|\u304A\u3082}\u3044\u307E\u3059[VAR 0114(0015)]",
  "{\u5148\u65E5|\u305B\u3093\u3058\u3064}\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\\n\u30CE\u30B3\u30B3\u30C3\u30C1\u3000\u3069\u3046\u3067\u3059\u304B\uFF1F\\c\\n\u3072\u3053\u3046\u30BF\u30A4\u30D7\u306B\u3000\u30C6\u30E9\u30B9\u30BF\u30EB\u3059\u308B\\n\u305D\u3089\u3068\u3076\u30CE\u30B3\u30B3\u30C3\u30C1\u2026\u2026\u3000\u306A\u3093\u3067\u3059\u3088[VAR 0114(0015)]",
  "\u2026\u2026{\u5148\u65E5|\u305B\u3093\u3058\u3064}\u3000\u30C8\u30C3\u30D7\u304B\u3089\\n{\u9023\u7D61|\u308C\u3093\u3089\u304F}\u304C\u3000\u3042\u308A\u307E\u3057\u305F\\c\\n\u3042\u306A\u305F\u304C\\n{\u4E00\u756A|\u3044\u3061\u3070\u3093}{\u597D|\u3059}\u304D\u306A\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306B\\r\\n{\u9078|\u3048\u3089}\u3093\u3060\u306E\u306F\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u3060\u3068\u2026\u2026\\c\\n{\u81EA\u5206|\u3058\u3076\u3093}\u306E\u3088\u3046\u306A\u3000{\u5E73\u51E1|\u3078\u3044\u307C\u3093}\u306A{\u7537|\u304A\u3068\u3053}\u3092\\n{\u6307\u540D|\u3057\u3081\u3044}\u3059\u308B\u3068\u306F\u3000{\u7406\u89E3|\u308A\u304B\u3044}\u306B\u3000{\u82E6|\u304F\u308B}\u3057\u307F\u307E\u3059\\c\\n{\u75B2|\u3064\u304B}\u308C\u3066\u3000{\u5224\u65AD\u529B|\u306F\u3093\u3060\u3093\u308A\u3087\u304F}\u304C\u3000{\u843D|\u304A}\u3061\u3066\u3044\u308B\u306A\u3089\\n\u3044\u3044{\u516C\u5712|\u3053\u3046\u3048\u3093}\u3092\u3000{\u7D39\u4ECB|\u3057\u3087\u3046\u304B\u3044}\u3057\u307E\u3059\u3088[VAR 0114(0015)]"
]
