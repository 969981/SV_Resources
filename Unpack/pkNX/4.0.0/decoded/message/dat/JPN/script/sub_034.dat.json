[
  "\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u2026\u2026",
  "[VAR 0100(0000)]\u3055\u3093\uFF01\u3000\u30B8\u30CB\u30A2\u3067\u3059\uFF01\uFF01[VAR 0114(002A)]",
  "{\u4ECA|\u3044\u307E}\u3055\u3063\u304D\u3000{\u9ED2|\u304F\u308D}\u3044{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\u306E\\n\u30C6\u30E9\u30B9\u30BF\u30EB{\u53CD\u5FDC|\u306F\u3093\u306E\u3046}\u304C\u3000\u306A\u304F\u306A\u3063\u305F\u3093\u3067\u3059\u304C\\r\\n\u3082\u3057\u304B\u3057\u3066\u3000{\u4F55|\u306A\u306B}\u304B\u3000{\u77E5|\u3057}\u3063\u3066\u307E\u3059\u304B\u3042\uFF01\uFF1F[VAR 0114(002A)]",
  "{\u52DD|\u304B}\u3061\u307E\u3057\u305F\uFF01",
  "{\u5927\u5909|\u305F\u3044\u3078\u3093}\u3067\u3057\u305F\uFF01",
  "\u3044\u3084\u3000{\u6226|\u305F\u305F\u304B}\u3063\u3066\u308B\u3057\u30FC\uFF01\uFF01[VAR 0114(002A)]",
  "\u306F\u3042\u2026\u2026\u3000\u3042\u308C\u307B\u3069\\n{\u5371\u967A|\u304D\u3051\u3093}\u3060\u3068\u3000{\u8A00|\u3044}\u3063\u305F\u306E\u306B\u3044\u2026\u2026[VAR 0114(002A)]",
  "\u3067\u3082\u3000[VAR 0100(0000)]\u3055\u3093\u304C\\n{\u7121\u4E8B|\u3076\u3058}\u3067\u3000\u3088\u304B\u3063\u305F\u3067\u3059\u3088\u30FC[VAR 0114(002A)]",
  "\u304A\u304B\u3052\u3055\u307E\u3067\u3000\u30C6\u30E9\u30B9\u30BF\u30EB\u3000\u30A8\u30CD\u30EB\u30AE\u30FC\u304C\\n{\u653E\u5C04|\u307B\u3046\u3057\u3083}\u3055\u308C\u308B\u3000{\u6CD5\u5247\u6027|\u307B\u3046\u305D\u304F\u305B\u3044}\u3082\u3000\u308F\u304B\u3063\u3066\u304D\u307E\u3057\u305F[VAR 0114(002A)]",
  "{\u8ABF\u67FB|\u3061\u3087\u3046\u3055}\u3000\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u30FC\\n\u304A{\u624B\u4F1D|\u3066\u3064\u3060}\u3044\u306E\u3000{\u8B1D\u793C|\u3057\u3083\u308C\u3044}\u3000{\u9001|\u304A\u304F}\u308A\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u305F\u3060\u2026\u2026\u3000{\u653E\u5C04|\u307B\u3046\u3057\u3083}\u3055\u308C\u308B\u3000\u30A8\u30CD\u30EB\u30AE\u30FC\u304C\\n\u3060\u3093\u3060\u3093\u3068\u3000{\u5927|\u304A\u304A}\u304D\u304F\u3000\u306A\u3063\u3066\u3044\u308B\u306E\u3067[VAR 0114(002A)]",
  "{\u4ECA\u5F8C|\u3053\u3093\u3054}\u3082\u3000{\u9ED2|\u304F\u308D}\u3044{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\u306E\u3000\u30C6\u30E9\u30EC\u30A4\u30C9\u304C\\n{\u78BA\u8A8D|\u304B\u304F\u306B\u3093}\u3055\u308C\u308B\u3088\u3046\u306B\u3000\u306A\u308B\u304B\u3082\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u3055\u3093\u306F\u3000{\u7121\u7406|\u3080\u308A}\u306B\u3000{\u8A00|\u3044}\u3063\u3066\u3082\\n{\u805E|\u304D}\u3044\u3066\u304F\u308C\u306A\u3044\u3000\u3067\u3057\u3087\u3046\u304B\u3089\\r\\n{\u5F37|\u3064\u3088}\u304F\u306F\u3000{\u6B62|\u3068}\u3081\u306A\u3044\u3067\u3059\u3051\u3069\u2026\u2026[VAR 0114(002A)]",
  "{\u4ECA\u5F8C|\u3053\u3093\u3054}\u306F\u3000\u304F\u308C\u3050\u308C\u3082\\n{\u6C17|\u304D}\u3092\u3064\u3051\u3066\u304F\u3060\u3055\u3044\u306D\u3048[VAR 0114(002A)]",
  "\u3042\u3000\u30AF\u30E9\u30D9\u30EB{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306B\u3000{\u77E5|\u3057}\u3089\u308C\u308B\u3068\\n\u30AA\u30B3\u30EA\u30B6\u30EB\u3088\u308A\u3000{\u6012|\u304A\u3053}\u3089\u308C\u3061\u3083\u3046\u306E\u3067\\r\\n\u3053\u306E\u3053\u3068\u306F\u3000\u3075\u305F\u308A\u3060\u3051\u306E\u3000\u30D2\u30DF\u30C4\u3067\u2026\u2026[VAR 0114(002A)]",
  "\u305D\u308C\u3067\u306F\u30FC\uFF01[VAR 0114(002A)]"
]
