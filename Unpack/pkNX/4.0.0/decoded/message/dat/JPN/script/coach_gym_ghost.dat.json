  "\u30A8\u30F3\u30C8\u30E9\u30F3\u30B9\u306E\u3000\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\\n\u306A\u304B\u306A\u304B\u3000\u3044\u3044\u3058\u3083\u306A\u3044\u304B\\c\\n{\u5BA2\u5E2D|\u304D\u3083\u304F\u305B\u304D}\u306B\u3000\u304B\u3053\u307E\u308C\u3066\u3066\\n\u30E9\u30A4\u30F4\u3082\u3000\u3067\u304D\u305D\u3046\u3060\u306D[VAR 0114(001B)]",
  "{\u60AA|\u308F\u308B}\u3055\u3057\u3066\u3000\u30BF\u30A4\u30E0{\u59C9|\u306D\u3048}\u3055\u3093\u3092\\n\u3053\u307E\u3089\u3059\u3093\u3058\u3083\u306A\u3044\u3088\uFF01\\c\\n\u3042\u306E{\u4EBA|\u3072\u3068}\u3000\u30AD\u30EC\u3055\u305B\u305F\u3089\\n\u30A2\u30BF\u30A4\u3088\u308A\u3000{\u6016|\u3053\u308F}\u3044\u304B\u3089\u306D\uFF01[VAR 0114(001B)]",
  "\u30A2\u30F3\u30BF\u306E\u3000[VAR 0101(0001)]\uFF01\\n\u306A\u304B\u306A\u304B\u3000\u30CE\u30EA\u304C\u3000\u3044\u3044\u306D\uFF01\\c\\n\u30A2\u30BF\u30A4\u304C\u3000{\u6B4C|\u3046\u305F}\u3063\u3066\u308B\u3068\\n{\u5408|\u3042}\u3044\u306E{\u624B|\u3066}\u3000{\u5165|\u3044}\u308C\u3066\u304F\u308C\u308B\u3088\uFF01[VAR 0114(001B)]",
  "\uFF24\uFF2A\u3000\uFF22\uFF2F\uFF23\uFF28\uFF29\u306F\u3000{\u9054\u8005|\u305F\u3063\u3057\u3083}\u304B\u3044\uFF01\uFF1F\\c\\n{\u97F3\u697D|\u304A\u3093\u304C\u304F}\u3092\u3000{\u8074|\u304D}\u304B\u305B\u3066\u3084\u308B\u3068\\n{\u559C|\u3088\u308D\u3053}\u3093\u3067\u3000{\u8E0A|\u30C0\u30F3\u30B9}\u3063\u3066\u304F\u308C\u308B\u3055\uFF01[VAR 0114(001B)]",
  "\u30AA\u30E2\u30C0\u30AB\u304C\u3000{\u8A00|\u3044}\u3063\u3066\u305F\u3051\u3069\\n[VAR 0100(0000)]\uFF01\u3000\u30A2\u30F3\u30BF\u2026\u2026\\c\\n{\u4E00\u756A|\u3044\u3061\u3070\u3093}{\u597D|\u3059}\u304D\u306A\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306B\\n\u30A2\u30BF\u30A4\u3092\u3000\u30CE\u30DF\u30CD\u30FC\u30C8\u3000\u3057\u305F\u3093\u3060\u3063\u3066\uFF01\uFF1F\\c\\n\u30D5\u30F3\u30C3\uFF01\u3000\u30A2\u30BF\u30A4\u306B\u3000\u30E9\u30F4\u30B3\u30FC\u30EB\u306A\u3093\u3066\\n{\u7269\u597D|\u3082\u306E\u305A}\u304D\u3082\u3000\u3044\u305F\u3082\u3093\u3060\u306D\uFF01\\c\\n\u2026\u2026\u307E\uFF01\u3000\u307B\u304B\u3067\u3082\u306A\u3044\\n\u30A2\u30F3\u30BF\u306B\u3000{\u8A8D|\u307F\u3068}\u3081\u3089\u308C\u305F\u3093\u3060\\r\\n{\u7D20\u76F4|\u3059\u306A\u304A}\u306B\u3000{\u53D7|\u3046}\u3051\u3068\u3063\u3066\u304A\u304F\u3088\uFF01[VAR 0114(001B)]"
