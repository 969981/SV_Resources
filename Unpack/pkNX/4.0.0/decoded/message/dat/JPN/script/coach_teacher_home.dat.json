  "[VAR 0100(0000)]\u3055\u3093\\n\u304A{\u76F8\u624B|\u3042\u3044\u3066}\u3000{\u611F\u8B1D|\u304B\u3093\u3057\u3083}\u3059\u308B[VAR 0114(0029)]",
