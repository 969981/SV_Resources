  "{\u6226\u95D8|\u305B\u3093\u3068\u3046}{\u5F8C|\u3054}\u306B\u3000{\u98DF|\u305F}\u3079\u3055\u305B\u308B\u3000\u30DD\u30B1\u30E2\u30F3{\u7528|\u3088\u3046}\\n\u30D8\u30EB\u30B7\u30FC{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306E\u3000{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u597D\u8A55|\u3053\u3046\u3072\u3087\u3046}\u3060\\r\\n{\u4ECA\u5EA6|\u3053\u3093\u3069}\u3000\u304D\u307F\u3082\u3000{\u53D7|\u3046}\u3051\u3066\u307F\u308B\u304B\u306D\uFF1F[VAR 0114(0029)]",
  "\u30C6\u30E9\u30EA\u30A6\u30E0\u30C9\u30FC\u30E0\u306B\u3082\\n{\u96E8|\u3042\u3081}\u306F\u3000{\u964D|\u3075}\u308B\u306E\u3060\u306A\\c\\n\u30D4\u30AF\u30CB\u30C3\u30AF{\u4E2D|\u3061\u3085\u3046}\u3000{\u6025|\u304D\u3085\u3046}\u306A{\u96E8|\u3042\u3081}\u306B\u3000{\u898B\u821E|\u307F\u307E}\u308F\u308C\u308B\u306E\u306F\\n\u30C9\u30FC\u30E0\u306E{\u4E2D|\u306A\u304B}\u3067\u3082\u3000{\u5909|\u304B}\u308F\u3089\u306C\u3088\u3046\u3060[VAR 0114(0029)]",
  "\u3053\u3061\u3089\u306E{\u98DF\u5802|\u3057\u3087\u304F\u3069\u3046}\u3067\u3000{\u6CE8\u6587|\u3061\u3085\u3046\u3082\u3093}\u3067\u304D\u308B\\n{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u30B7\u30A7\u30FC\u30AD\u306F\u3000{\u98F2|\u306E}\u3093\u3067\u307F\u305F\u304B\u306D\uFF1F\\c\\n{\u820C|\u3057\u305F}\u304C\u3000\u30DE\u30D2\u3059\u308B\u307B\u3069\u3000\u3042\u307E\u3063\u3042\u307E\u3067\\n{\u98F2|\u306E}\u3081\u3070\u3000{\u7B11|\u3048}\u307F\u304C\u3000\u3053\u307C\u308C\u3066\u3057\u307E\u3046\u306E\u3060\u3088[VAR 0114(0029)]",
  "[VAR 0100(0000)]\u3055\u3093\u306E\u3000[VAR 0101(0001)]\u306F\\n{\u4F53|\u304B\u3089\u3060}\u306E\u30C4\u30E4\u304C\u3000{\u7D20\u6674|\u3059\u3070}\u3089\u3057\u3044\\c\\n\u30D0\u30E9\u30F3\u30B9\u306E\u3044\u3044\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u3092\\n{\u5FC3|\u3053\u3053\u308D}\u304C\u3051\u3066\u3044\u305F\u306E\u304B\u306D\uFF1F[VAR 0114(0029)]",
