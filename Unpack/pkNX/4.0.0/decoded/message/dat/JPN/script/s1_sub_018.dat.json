[
  "\u308F\u305F\u3057\u305F\u3061\u3063\u3066\u3000\u3081\u3063\u3061\u3083\\n\u30E9\u30D6\u30E9\u30D6\u306A\u3000\u30AB\u30C3\u30D7\u30EB\u3060\u3088\u306D\u30FC\uFF1F",
  "\u3093\u3060\u306A\u3042\uFF01\u3000\u308F\u3057\u3089\u307F\u305F\u3044\u306B\\n\u3044\u3064\u3082\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306A\u30AB\u30C3\u30D7\u30EB\u3000\u306A\u3093\u3066\\r\\n\u30DD\u30B1\u30E2\u30F3{\u754C|\u304B\u3044}\u306B\u3082\u3000{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u3057\u306A\u3044\u3060\u308D\uFF01",
  "\u3060\u3088\u306D\u3048\uFF01",
  "\u2026\u2026\u305D\u3053\u306E{\u4EBA|\u3072\u3068}\uFF01",
  "\u3082\u3057\u3000\u308F\u305F\u3057\u305F\u3061\u3000\u307F\u305F\u3044\u306B\\n\u30E9\u30D6\u30E9\u30D6\u306A\u3000\u30DD\u30B1\u30E2\u30F3\uFF01\\r\\n{\u898B|\u307F}\u3064\u3051\u305F\u3089\u3000\u3064\u308C\u3066\u304D\u3066\u307F\u3066\u3088\uFF01",
  "\u3044\u306A\u3044\u3068\u3000{\u601D|\u304A\u3082}\u3046\u3051\u3069\u306A\uFF01\\n\u30A2\u30CF\u30C3\u30CF\u30FC\uFF01",
  "\u3044\u3064\u3082\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u3067\\n\u30E9\u30D6\u30E9\u30D6\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u3000{\u898B|\u307F}\u3064\u3051\u305F\u306E\uFF1F",
  "\u3044\u308B\u308F\u3051\u3000\u306A\u3044\u3088\u306A\uFF01\\n\u30A2\u30CF\u30C3\u30CF\u30FC\uFF01",
  "\u305D\u306E\u30DD\u30B1\u30E2\u30F3\u306F\u2026\u2026\\n\u30E9\u30D6\u30E9\u30D6\u3063\u3066\u30EF\u30B1\u3058\u3083\u3000\u306A\u3055\u305D\u3046\u3060\u305C\uFF01\\r\\n\u30A2\u30CF\u30C3\u30CF\u30FC\uFF01",
  "\u306A\u3000\u306A\u3093\u3060\uFF1F\u3000\u30EF\u30C3\u30AB\u30CD\u30BA\u30DF\uFF01\uFF1F\\c\\n\u3044\u3064\u3082\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306A\u3000\u306A\u304B\u3088\u3057\u30AB\u30C3\u30D7\u30EB\\n\uFF12{\u5339|\u3072\u304D}\u30BB\u30C3\u30C8\u3067\u3000\u30E9\u30D6\u30E9\u30D6\u3060\u3068\uFF01\uFF1F",
  "\u306A\u3000\u306A\u3093\u3060\uFF1F\u3000\u30A4\u30C3\u30AB\u30CD\u30BA\u30DF\uFF01\uFF1F\\c\\n\u30E9\u30D6\u30E9\u30D6\u3059\u304E\u3066\u3000{\u7389|\u305F\u307E}\u306E\u3088\u3046\u306A\\n\u304A{\u5B50|\u3053}\u304C\u3000{\u751F|\u3046}\u307E\u308C\u3061\u3083\u3063\u3066\u308B\uFF01\uFF1F",
  "\u306A\u3000\u306A\u3093\u3060\uFF1F\u3000\u30A4\u30C3\u30AB\u30CD\u30BA\u30DF\uFF01\uFF1F\\c\\n\u30E9\u30D6\u30E9\u30D6\u3059\u304E\u3066\u3000{\u5B50\u4F9B|\u3053\u3069\u3082}\u304C\u3000\uFF12{\u5339|\u3072\u304D}\u3082\uFF01\uFF1F\\n\u306A\u304B\u3088\u3057\u3000\u30AA\u30FC\u30D0\u30FC\u3000\u30B6\u3000\u30D5\u30A1\u30DF\u30EA\u30FC\u3060\u3068\uFF01\uFF1F",
  "\u3044\u308B\u306E\u306D\u2026\u2026\u3000\u30DD\u30B1\u30E2\u30F3{\u754C|\u304B\u3044}\u306B\u3082\\n\u308F\u305F\u3057\u305F\u3061\u3000\u307F\u305F\u3044\u306A\u3000\u30E9\u30D6\u30E9\u30D6\u304C\uFF01",
  "{\u898B|\u307F}\u305B\u3064\u3051\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u3068\u306D\\n\u304A{\u793C|\u308C\u3044}\u306B\u3000\u30A8\u30E2\u30FC\u30C8\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3042\u3052\u308B",
  "[VAR 0100(0000)]\u306F\u3000\u30AB\u30C3\u30D7\u30EB\u304B\u3089\\n[VAR FF00(0008)]\u30CF\u30FC\u30C8\uFF08{\u53F3|\u307F\u304E}\uFF09\u30A8\u30E2\u30FC\u30C8[VAR FF00(0000)]\u3068\\r\\n[VAR FF00(0008)]\u30CF\u30FC\u30C8\uFF08{\u5DE6|\u3072\u3060\u308A}\uFF09\u30A8\u30E2\u30FC\u30C8[VAR FF00(0000)]\u3092\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3082\u3089\u3063\u305F\uFF01",
  "\u30E9\u30D6\u30E9\u30D6\u30A8\u30E2\u30FC\u30C8\u2026\u2026\\n{\u8AB0|\u3060\u308C}\u304B\u3068\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000\u3084\u3063\u3066\u307F\u3066\u306D",
  "{\u4EBA\u9593|\u306B\u3093\u3052\u3093}\u306B\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3082\\n\u30E9\u30D6\u304C\u3000\u3042\u3075\u308C\u3068\u308B\u3093\u3060\u306A"
]
