[
  "\u30CF\u30C3\u30B3\u30A6\u30B7\u30C6\u30A3\u3000{\u697D|\u305F\u306E}\u3057\u3093\u3067\u308B\uFF1F\\n\u30CF\u30A4\u30C6\u30AF\u3068\u3000\u30D3\u30B8\u30CD\u30B9\u306E\u3000{\u753A|\u307E\u3061}\u306A\u3093\u3060\uFF01",
  "\u3053\u3053\u304B\u3089\u3000{\u5317|\u304D\u305F}\u306F\u3000\u30E1\u30A4\u30F3\u30B9\u30C8\u30EA\u30FC\u30C8\uFF01\\c\\n{\u96FB\u5149\u63B2\u793A\u677F|\u3067\u3093\u3053\u3046\u3051\u3044\u3058\u3070\u3093}\u306B\u3000\u304B\u3053\u307E\u308C\u305F{\u9053|\u307F\u3061}\u306F\\n\u30CF\u30C3\u30B3\u30A6\u306A\u3089\u3067\u306F\u306E\u3000\u30D3\u30B8\u30E5\u30A2\u30EB\u3055",
  "\u30BD\u30C3\u30AF\u30B9\u306F\u3000{\u5C65|\u306F}\u304D{\u5FC3\u5730|\u3054\u3053\u3061}\u304C\u3000{\u547D|\u3044\u306E\u3061}\uFF01\\n\u3044\u3064\u3082\u3000{\u8EAB|\u307F}\u306B{\u7740|\u3064}\u3051\u308B\u3082\u306E\u3000\u3060\u304B\u3089\u306D",
  "\u30D0\u30C3\u30B0\u306F\u3000\u30AA\u30B7\u30E3\u30EC\u3055\u304C\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\uFF01\\n{\u53CE\u7D0D|\u3057\u3085\u3046\u306E\u3046}\u306A\u3093\u3066\u3000{\u4E8C|\u306B}\u306E{\u6B21|\u3064\u304E}\u3088",
  "\u3053\u3053\u304C\u3000\u30CA\u30F3\u30B8\u30E3\u30E2\u3055\u307E\u306E\u3000\u30B8\u30E0\u2026\u2026\\n\u3044\u3064\u3082\u3000{\u52D5\u753B|\u3069\u3046\u304C}\u3067\u3000{\u898B|\u307F}\u3066\u308B\u304B\u3089\u3000\u30B8\uFF5E\u30F3\uFF01",
  "\u3053\u306E{\u524D|\u307E\u3048}\u306E\u3000\u30C9\u30F3\u30CA\u30E2\u30F3\u30B8\u30E3\uFF34\uFF36\u3000{\u898B|\u307F}\u305F\uFF1F\\n\u30EA\u30C3\u30D7\u3061\u3083\u3093\u3068\u306E\u3000\u30B3\u30E9\u30DC{\u914D\u4FE1|\u306F\u3044\u3057\u3093}\u3000\u3088\u304B\u3063\u305F\uFF01",
  "\u30CA\u30F3\u30B8\u30E3\u30E2\u3061\u3083\u3093\u3000\u304B\u308F\u3044\u3044\u3088\u306A\uFF5E\uFF01\\n{\u4E00\u756A|\u3044\u3061\u3070\u3093}\u3000{\u52E2|\u3044\u304D\u304A}\u3044\u304C\u3042\u308B\u3000{\u914D\u4FE1\u8005|\u306F\u3044\u3057\u3093\u3057\u3083}\u3060\u3088",
  "{\u753A|\u307E\u3061}\u306E{\u4E2D|\u306A\u304B}\u306B\u3000{\u81EA\u7136|\u3057\u305C\u3093}\u304C\u3042\u308B\u3068\\n\u3059\u3055\u3093\u3060{\u5FC3|\u3053\u3053\u308D}\u3082\u3000\u3044\u3084\u3055\u308C\u308B\u3088\u306A",
  "\u30CF\u30C3\u30B3\u30A6\u30B7\u30C6\u30A3\u306B\u3000{\u4F4F|\u3059}\u3093\u3067\u308B\u3068\\n{\u6BCE\u65E5|\u307E\u3044\u306B\u3061}\u3000{\u611F\u6027|\u304B\u3093\u305B\u3044}\u304C\u3000{\u523A\u6FC0|\u3057\u3052\u304D}\u3055\u308C\u308B\u306D",
  "\u306F\u3044\u3000\u30CF\u30A4\u30D1\u30FC\u30DC\u30FC\u30EB\u3063\u3059\u306D\uFF01\\c\\n\u30B9\u30FC\u30D1\u30FC\u30DC\u30FC\u30EB\u3088\u308A\u3000\u3059\u3054\u3044\u3093\u3067\\n\uFF13\uFF10\uFF10{\u500B|\u3053}\u3000{\u767A\u6CE8|\u306F\u3063\u3061\u3085\u3046}\u3057\u3068\u304D\u307E\u3063\u3059\uFF01",
  "\u308F\u305F\u3057\u3082\u3000\u304A\u304A\u304D\u304F\u306A\u3063\u305F\u3089\\n\u3044\u3093\u3075\u308B\u3048\u3093\u3055\u30FC\u306B\u3000\u306A\u308B\u30FC\uFF01",
  "{\u4E16|\u3088}\u306E{\u4E2D|\u306A\u304B}\u306B\u306F\\n\u3044\u308D\u3093\u306A{\u4ED5\u4E8B|\u3057\u3054\u3068}\u304C\u3000\u3042\u308B\u3093\u3060\u306A\u3042\uFF01",
  "\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000{\u4F5C|\u3064\u304F}\u308D\u3046\u3068\u3057\u305F\u3089\\n\u30D4\u30C3\u30AF\u3092\u3000{\u5207|\u304D}\u3089\u3057\u3066\u305F\u2026\u2026\uFF01\\r\\n{\u6D88\u8017\u54C1|\u3057\u3087\u3046\u3082\u3046\u3072\u3093}\u306F\u3000{\u591A|\u304A\u304A}\u3081\u306B\u3000{\u8CB7|\u304B}\u3063\u3066\u304A\u3053\u3046\u306A",
  "\u30C1\u30E3\u30F3\u30D7\u30EB\u30BF\u30A6\u30F3\u306E\u3000{\u5B9D\u98DF\u5802|\u305F\u304B\u3089\u3057\u3087\u304F\u3069\u3046}\u3082\u3000{\u98DF|\u305F}\u3079\u305F\u3044\u3057\\n\u30AB\u30E9\u30D5\u30B7\u30C6\u30A3\u306E\u3000\u30CF\u30A4\u30C0\u30A4{\u5036\u697D\u90E8|\u304F\u3089\u3076}\u3082\u3000\u3044\u3044\u3057\\r\\n\u305D\u3089\u3068\u3076\u30BF\u30AF\u30B7\u30FC\u3000{\u547C|\u3088}\u3093\u3058\u3083\u3046\uFF1F",
  "\u3053\u306E\u3042\u3068\u3000\u30DD\u30B1\u30E2\u30F3\u3000{\u6355|\u3064\u304B}\u307E\u3048\u308B\u304B\u3089\\n\u307B\u304B\u304F\u30D1\u30EF\u30FC\u304C\u3000\u307F\u306A\u304E\u308B\\r\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3000{\u98DF|\u305F}\u3079\u305F\u3044\u306A\u30FC",
  "{\u6D77|\u3046\u307F}\u306E{\u4E0A|\u3046\u3048}\u3092\u3000\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u98DB|\u3068}\u3093\u3067\u308B\\n\u30BF\u30A4\u30DF\u30F3\u30B0\u3092\u3000{\u72D9|\u306D\u3089}\u3063\u3066\u2026\u2026\u3000\u30D1\u30B7\u30E3\u30EA\uFF01",
  "\u3057\u305F\u306B\u3000\u304A\u3075\u306D\u304C\u3000\u3042\u308B\u306E\uFF01\\n\u3046\u307F\u306E\u305D\u3053\u307E\u3067\u3000\u3044\u304D\u305F\u3044\u306A\u30FC",
  "\u30CF\u30C3\u30B3\u30A6\u30B7\u30C6\u30A3\u306F\u3000{\u76E3\u8996|\u304B\u3093\u3057}\u30AB\u30E1\u30E9\u304C\\n\u3044\u3063\u3071\u3044\u3067\u3000{\u6CBB\u5B89|\u3061\u3042\u3093}\u304C\u3000{\u5B88|\u307E\u3082}\u3089\u308C\u3066\u3044\u308B\uFF01\\c\\n\u305D\u306E{\u6620\u50CF|\u3048\u3044\u305E\u3046}\u306F\u3000\u30CF\u30C3\u30B3\u30A6\u30B8\u30E0\u306E\\n\u30B8\u30E0\u30C6\u30B9\u30C8\u3067\u3000{\u4F7F|\u3064\u304B}\u308F\u308C\u3066\u308B\u3089\u3057\u3044\u305E",
  "\u30D9\u30A4\u30AF\u30BF\u30A6\u30F3\u3067\u3000{\u9676\u5668\u4F5C|\u3068\u3046\u304D\u3065\u304F}\u308A\u3000{\u4F53\u9A13|\u305F\u3044\u3051\u3093}\uFF01\\n{\u6B21|\u3064\u304E}\u306E\u30D7\u30E9\u30F3\u306F\u3000\u305D\u308C\u3067\u3000\u3044\u304D\u307E\u3057\u3087\u3046\uFF01",
  "\u30CD\u30C3\u30C8{\u914D\u4FE1|\u306F\u3044\u3057\u3093}\u3082\u3000\u3044\u3044\u3051\u3069\u3055\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u306F\u3000{\u751F|\u306A\u307E}\u3067{\u89B3|\u307F}\u305F\u3044\u306E\uFF01",
  "\u30E9\u30A4\u30E0\u306E{\u65B0\u66F2|\u3057\u3093\u304D\u3087\u304F}\u3000{\u914D\u4FE1|\u306F\u3044\u3057\u3093}\u3055\u308C\u3066\u308B\uFF01\\n\u306F\u3084\u304F\u3000{\u805E|\u304D}\u304B\u306A\u304D\u3083\uFF01",
  "\u30EA\u30C3\u30D7\u3000\u30D7\u30ED\u30C7\u30E5\u30FC\u30B9\u306E\u3000{\u9650\u5B9A|\u3052\u3093\u3066\u3044}\u30B3\u30B9\u30E1\\n\u3069\u308C\u3082\u3000{\u7D20\u6575|\u3059\u3066\u304D}\u3067\u3000{\u8FF7|\u307E\u3088}\u3063\u3061\u3083\u3046\uFF5E\uFF01",
  "\u30D3\u30EB\u306E{\u9AD8|\u305F\u304B}\u3055\u304C\u3000\u3068\u3093\u3067\u3082\u306A\u3044\uFF01\\n{\u898B|\u307F}\u3066\u305F\u3089\u3000{\u9996|\u304F\u3073}\u304C\u3000{\u75DB|\u3044\u305F}\u304F\u306A\u3063\u3066\u304D\u305F",
  "\uFF15\u3064\u3068\u3082\u3000{\u5168\u90E8|\u305C\u3093\u3076}\u3000{\u4E0D\u52D5\u7523\u4F1A\u793E|\u3075\u3069\u3046\u3055\u3093\u304C\u3044\u3057\u3083}\\n\u30D1\u30EB\u30C7\u30A2\u30A8\u30B9\u30C6\u30FC\u30C8\u306E\u3000\u30D3\u30EB\u3089\u3057\u3044\u3088",
  "{\u753A|\u307E\u3061}\u306E{\u96FB\u6C17|\u3067\u3093\u304D}\u306F\u3000\u30BA\u30D4\u30AB\u3063\u3066\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u304C\u3093\u3070\u3063\u3066\u3000{\u767A\u96FB|\u306F\u3064\u3067\u3093}\u3057\u3066\u308B\u306E\uFF01",
  "{\u63A8|\u304A}\u3057\u304C\uFF01\u3000{\u96FB\u5149\u63B2\u793A\u677F|\u3067\u3093\u3053\u3046\u3051\u3044\u3058\u3070\u3093}\u306B\uFF01\\n{\u63A8|\u304A}\u3057\u304C\uFF01\u3000\u305F\u307E\u306B\u3000{\u6620|\u3046\u3064}\u3063\u3066\u308B\uFF01\\r\\n\u306F\u3041\u3093\u2026\u2026\u3000\u30B3\u30EB\u30B5\u3055\u3093\u2026\u2026\uFF01\uFF01",
  "{\u4E00\u5EA6|\u3044\u3061\u3069}\u3000{\u624B|\u3066}\u306B{\u5165|\u3044}\u308C\u305F\u3000\u308F\u3056\u30DE\u30B7\u30F3\u306F\\n\u308F\u3056\u30DE\u30B7\u30F3\u30DE\u30B7\u30F3\u3067\u3000{\u4F5C|\u3064\u304F}\u308C\u307E\u3059\u304B\u3089\u306D",
  "\u306A\u307F\u306E\u308A\u304C\u3000\u3067\u304D\u308B\\n\u30E9\u30A4\u30C9\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3044\u305F\u3089\\r\\n{\u6D77|\u3046\u307F}\u306B\u3000{\u98DB|\u3068}\u3073\u3053\u3093\u3067\u3082\u3000{\u5E73\u6C17|\u3078\u3044\u304D}\u3088\u306D",
  "{\u6614|\u3080\u304B\u3057}\u306F\u3000{\u9271\u5C71|\u3053\u3046\u3056\u3093}\u306E{\u9271\u77F3|\u3053\u3046\u305B\u304D}\u3092\\n{\u8239|\u3075\u306D}\u3067{\u904B|\u306F\u3053}\u3076\u3000{\u6E2F\u753A|\u307F\u306A\u3068\u307E\u3061}\u3060\u3063\u305F\u3093\u3060\\c\\n\u305D\u308C\u304C\u3000{\u4ECA|\u3044\u307E}\u3058\u3083\u3000\u3053\u30FC\u3093\u306A\\n\u30D3\u30B8\u30CD\u30B9{\u8857|\u304C\u3044}\u306B\u3000\u306A\u3063\u3061\u3083\u3046\u306A\u3093\u3066\u306D",
  "\u30CF\u30C3\u30B3\u30A6\u30B7\u30C6\u30A3\u306E\u3000\u30CF\u30C3\u30B3\u30A6\u3063\u3066\\n{\u767A\u884C|\u306F\u3063\u3053\u3046}\uFF1F\u3000{\u767A\u9175|\u306F\u3063\u3053\u3046}\uFF1F\\c\\n\uFF11\uFF10\uFF10{\u4E07|\u307E\u3093}\u30DC\u30EB\u30C8\u306E{\u591C\u666F|\u3084\u3051\u3044}\u3063\u3066\\n{\u8A00|\u3044}\u308F\u308C\u308B\u304F\u3089\u3044\u3060\u304B\u3089\u3000{\u767A\u5149|\u306F\u3063\u3053\u3046}\u304B\u306A\uFF1F",
  "{\u6709\u540D|\u3086\u3046\u3081\u3044}\u306A{\u535A\u58EB|\u306F\u304B\u305B}\u304C\u3000\u3044\u305F\u3058\u3083\u3093\\n{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u3000\u30E1\u30C7\u30A3\u30A2\u306B\u3000{\u51FA|\u3067}\u306A\u3044\u3088\u306D",
  "\u30B3\u30B5\u30B8\u306E{\u8FD1|\u3061\u304B}\u304F\u306B\u3000{\u706F\u53F0|\u3068\u3046\u3060\u3044}\u304C\u3000\u3042\u3063\u3066\\n\uFF11{\u968E|\u304B\u3044}\u304C\u3000{\u7814\u7A76\u5BA4|\u3051\u3093\u304D\u3085\u3046\u3057\u3064}\u306B\u3000\u306A\u3063\u3066\u308B\u3093\u3060\u3063\u3066",
  "{\u898B|\u307F}\u305F{\u76EE|\u3081}\u3092\u3000{\u5909|\u304B}\u3048\u308C\u3070\\n{\u6C17\u5206|\u304D\u3076\u3093}\u3082\u3000{\u5909|\u304B}\u308F\u308B\uFF01\\c\\n\u3069\u3093\u306A{\u670D|\u3075\u304F}\u3092\u3000{\u7740|\u304D}\u308B\u304B\u3067\\n\uFF11{\u65E5|\u306B\u3061}\u304C\u3000{\u5909|\u304B}\u308F\u308B\u3088\u306A",
  "\u30AD\u30BA\u3050\u3059\u308A\u306B\u3000{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u306B\\n\u30E2\u30F3\u30B9\u30BF\u30FC\u30DC\u30FC\u30EB\uFF01\\r\\n{\u8CB7|\u304B}\u3044{\u5FD8|\u308F\u3059}\u308C\u306F\u3000\u306A\u3044\u304B\u3057\u3089\uFF1F",
  "\u3044\u3056\u3068\u306A\u308C\u3070\u3000\u305D\u3089\u3068\u3076\u30BF\u30AF\u30B7\u30FC\u3067\\n\u30D5\u30EC\u30F3\u30C9\u30EA\u30A3\u30B7\u30E7\u30C3\u30D7\u307E\u3067\u3000\u30B4\u30FC\u3057\u3088\u3046",
  "[~ 44]",
  "\u30CA\u30F3\u30B8\u30E3\u30E2\u306F\u3000{\u4F55\u5E74|\u306A\u3093\u306D\u3093}\u3082\u3000{\u524D|\u307E\u3048}\u304B\u3089\\n{\u52D5\u753B|\u3069\u3046\u304C}\u306E{\u914D\u4FE1|\u306F\u3044\u3057\u3093}\u3000\u3084\u3063\u3066\u3044\u308B\u3093\u3060\\r\\n\u2026\u2026{\u5F7C\u5973|\u304B\u306E\u3058\u3087}\u3000{\u4F55\u6B73|\u306A\u3093\u3055\u3044}\u306A\u3093\u3060\u308D\uFF1F",
  "\u30EB\u30AF\u30B7\u30AA\u306E{\u6BDB\u4E26|\u3051\u306A}\u307F\\n\u304B\u3063\u3053\u3044\u3044\u3060\u308D\u30FC\uFF01\\c\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3057\u305F\u3089\u3000\u3059\u3050\u306B\\n\u30DD\u30B1\u30E2\u30F3\u30A6\u30A9\u30C3\u30B7\u30E5\u3067\u3000{\u6D17|\u3042\u3089}\u3063\u3066\u308B\u3093\u3060",
  "\u3044\u3064\u304B\u3000\u304A\u304B\u306D\u3082\u3061\u306B\u3000\u306A\u3063\u3066\\n\u3053\u3053\u304B\u3089\u3000\u3053\u3053\u307E\u3067\u3000\u305C\u3093\u3076\u3000\u3061\u3087\u3046\u3060\u3044\uFF01\\r\\n\u2026\u2026\u3063\u3066\u3000\u3044\u3046\u3093\u3060\u30FC\uFF01",
  "\u3082\u3050\u3082\u3050\u3000\u3082\u3050\u3082\u3050\\c\\n\u30CF\u30C3\u30B3\u30A6\u30B8\u30E0\u306F\u3000{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u306E{\u69D8\u5B50|\u3088\u3046\u3059}\u304C\\n\u30CD\u30C3\u30C8\u306B\u3000{\u751F\u914D\u4FE1|\u306A\u307E\u306F\u3044\u3057\u3093}\u3055\u308C\u308B\u3093\u3060",
  "\u3054\u304F\u3054\u304F\u3000\u3054\u304F\u3054\u304F\\c\\n\u3061\u3087\u3063\u3068{\u524D|\u307E\u3048}\u306E\u3000\u30B8\u30E0{\u914D\u4FE1|\u306F\u3044\u3057\u3093}\\n\u30CD\u30E2\u3063\u3066{\u4EBA|\u3072\u3068}\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u3000\u3059\u3054\u304B\u3063\u305F\uFF01",
  "\u30A2\u30AB\u30C7\u30DF\u30FC\u306B\u306F\u3000\u305F\u304F\u3055\u3093\\n{\u672C|\u307B\u3093}\u304C\u3000\u3042\u308B\u3093\u3060\u3063\u3066\uFF01\\c\\n{\u5165\u5B66|\u306B\u3085\u3046\u304C\u304F}\u3057\u305F\u3089\u3000\u30AA\u30FC\u30AB\u30EB\u30C1\u30E3\u30FC\\n\u3044\u3063\u3071\u3044\u3000{\u8AAD|\u3088}\u3080\u305E\uFF01",
  "\u3053\u306E{\u5148|\u3055\u304D}\u306E\u3000{\u706F\u53F0|\u3068\u3046\u3060\u3044}\u304B\u3089\\n\u30CF\u30C3\u30B3\u30A6\u30B7\u30C6\u30A3\u304C\u3000{\u4E00\u671B|\u3044\u3061\u307C\u3046}\u3067\u304D\u308B\u3088",
  "{\u98A8\u666F\u5199\u771F|\u3075\u3046\u3051\u3044\u3057\u3083\u3057\u3093}\u3082\u3000{\u597D|\u3059}\u304D\u3060\u3051\u3069\\n{\u601D|\u304A\u3082}\u3044{\u51FA|\u3067}\u306B\u3000{\u6B8B|\u306E\u3053}\u308B\u306E\u306F\u3000\u3044\u3064\u3082\u3000{\u4EBA|\u3072\u3068}\u3084\\r\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u5199|\u3046\u3064}\u3063\u3066\u308B\u3000{\u5199\u771F|\u3057\u3083\u3057\u3093}\u306A\u306E\u3088\u306D"
]
