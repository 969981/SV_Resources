[
  "[VAR 0100(0000)]\uFF01\\n{\u5F85|\u307E}\u3063\u305F\u308F\u3088\uFF01\\r\\n{\u5F85|\u307E}\u3061\u3042\u308F\u305B\u3000\u3057\u3066\u306A\u3044\u3051\u3069\uFF01[VAR 0114(0044)]",
  "\u3061\u3087\u3063\u3068\u2026\u2026\\n\u3042\u3093\u305F\u306B\u3000{\u7528|\u3088\u3046}\u304C\u3042\u3063\u3066[VAR 0114(0044)]",
  "{\u6628\u65E5|\u304D\u306E\u3046}\u306E\u2026\u2026\u3000\u3042\u308C\uFF01\\n{\u8AB0|\u3060\u308C}\u306B\u3082\u3000{\u8A00|\u3044}\u3063\u3066\u306A\u3044\u3067\u3057\u3087\u3046\u306D\uFF01\uFF1F[VAR 0114(0044)]",
  "{\u8A00|\u3044}\u3063\u3066\u306A\u3044",
  "\u3042\u308C\u3063\u3066\uFF1F",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u3067\u3057\u3087\u3046\u306D\u30FC\uFF01\uFF1F\\n\u3042\u3093\u305F\u3000{\u5618|\u3046\u305D}\u3064\u3044\u3066\u305F\u3089\\r\\n\u30C9\u30AC\u30FC\u30B9\u3000{\u4E38\u98F2|\u307E\u308B\u306E}\u307F\u3000\u3060\u304B\u3093\u306D[VAR 0114(0044)]",
  "\u3042\u308C\u3063\u305F\u3089\u3000\u3042\u308C\u3088\uFF01\\n{\u4F1A|\u3042}\u3063\u305F\u3053\u3068\uFF01\u3000\u304A\u306B\u2026\u2026\u3000\u304A\u306B\u304E\u308A{\u5C0F\u50E7|\u3053\u305E\u3046}\u3068\uFF01\\r\\n\u3082\u3046\uFF01\u3000{\u610F\u5916|\u3044\u304C\u3044}\u3068\u3000{\u6027\u683C\u60AA|\u305B\u3044\u304B\u304F\u308F\u308B}\u3044\u306D\uFF01[VAR 0114(0044)]",
  "{\u968E\u6BB5|\u304B\u3044\u3060\u3093}\u3067\u3000{\u62FE|\u3072\u308D}\u3063\u305F\u3084\u3064\\n{\u6301|\u3082}\u3063\u3066\u308B\u3067\u3057\u3087[VAR 0114(0044)]",
  "\u3046\u3061\u306E\u3000\u3058\u30FC\u3061\u3083\u3093\\n{\u6751|\u3080\u3089}\u306E{\u6B74\u53F2|\u308C\u304D\u3057}\u3000\u304F\u308F\u3057\u3044\u304B\u3089\\r\\n{\u6628\u65E5|\u304D\u306E\u3046}\u306E\u3053\u3068\u3000\u3044\u308D\u3044\u308D\u3000{\u76F8\u8AC7|\u305D\u3046\u3060\u3093}\u3057\u3088\u3046\u3088[VAR 0114(0044)]",
  "\u3046\u3061\u306E{\u5834\u6240|\u3070\u3057\u3087}\u3000\u308F\u304B\u308B\u3067\u3057\u3087\uFF1F\\n\u306F\u3084\u304F\u3000{\u6765|\u304D}\u3066\u3088\u306D[VAR 0114(0044)]",
  "\u3058\u30FC\u3061\u3083\u3093\u306B\\n\u3042\u308C\u3000{\u898B|\u307F}\u305B\u3066\u3042\u3052\u3066[VAR 0114(0044)]",
  "{\u770B\u677F|\u304B\u3093\u3070\u3093}\u3081\u3050\u308A\u3000\uFF11\u3064\u3057\u304B\u3000\u307E\u308F\u308C\u3066\u306A\u3044\uFF01\\n\u30BC\u30A4\u30E6\u3055\u3093\u304C\u3000{\u5168\u7136|\u305C\u3093\u305C\u3093}\u3000\u3044\u306A\u3044\u3093\u3060\uFF01\\r\\n\u3067\u3082\u3000\u305D\u3093\u306A\u3000{\u81EA\u7531|\u3058\u3086\u3046}\u306A\u3068\u3053\u308D\u304C\u2026\u2026",
  "\u30B9\u30B0\u30EA\u304F\u3093\u3063\u3066\u3000{\u4EBA\u898B\u77E5|\u3072\u3068\u307F\u3057}\u308A\uFF1F\\n\u3042\u306A\u305F\u306B\u306F\u3000{\u5FC3\u958B|\u3053\u3053\u308D\u3072\u3089}\u3044\u3066\u308B\u306E\u306D",
  "{\u84B8|\u3080}\u3057{\u6691|\u3042\u3064}\u3044\u306E\u306F\u3000\u307E\u3060\u3060\u3051\u3069\\n\u3080\u3057\u30DD\u30B1\u30E2\u30F3\u306B\u306F\u3000{\u6163|\u306A}\u308C\u3066\u304D\u305F\u305E\uFF01",
  "\u30AA\u30E2\u30C6{\u796D|\u307E\u3064}\u308A\u306F\u3000\u3057\u3070\u3089\u304F\u3000{\u7D9A|\u3064\u3065}\u304D\u307E\u3059\u3093\u3067\\n\u3069\u3046\u305E\u3000{\u697D|\u305F\u306E}\u3057\u3093\u3067\u3063\u3066\u304F\u3060\u3055\u3044[VAR 0114(0045)]"
]
