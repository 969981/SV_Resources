  "\u3042\u3093\u305F\u306E\u3000[VAR 0101(0001)]\u3000{\u5F93\u9806|\u3058\u3085\u3046\u3058\u3085\u3093}\u3088\\n\u3042\u3093\u305F\u306B\u3082\u3000{\u898B\u7FD2|\u307F\u306A\u3089}\u3063\u3066\u307B\u3057\u3044\u304F\u3089\u3044\uFF01[VAR 0114(0044)]",
  "\u3042\u305F\u3057\u306E\u3000\u30C1\u30E3\u30C7\u30B9\u3000\u3044\u3044\u3067\u3057\u3087\uFF1F\\c\\n\u3044\u3064\u3067\u3082\u3000\u30A2\u30C4\u30A2\u30C4\u306E\u304A{\u8336|\u3061\u3083}\\n\u304A{\u898B\u821E|\u307F\u307E}\u3044\u3057\u3066\u3000\u3042\u3052\u308B\u3093\u3060\u304B\u3089[VAR 0114(0044)]"
]
