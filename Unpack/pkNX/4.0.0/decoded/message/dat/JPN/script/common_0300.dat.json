[
  "\u3088\u3063\u3057\u3083\u30FC\uFF01\\n\u30AA\u30FC\u30D7\u30F3\u30EF\u30A4\u30EB\u30C9\u3060\u30FC\uFF01",
  "\u30E9\u30A4\u30C9\u3057\u3066\u3000\u3044\u304F\u3088\uFF01\\n\u30E2\u30C8\u30C8\u30AB\u30B2\u30FC\uFF01",
  "{\u7686|\u307F\u306A}\u3055\u3093\u3000\u304A{\u6C17|\u304D}\u3092\u3064\u3051\u3066\u30FC\uFF01\\n\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u3078\u306E\u3000{\u7ACB|\u305F}\u3061{\u5165|\u3044}\u308A\u306F\\r\\n{\u5371|\u3042\u3076}\u306A\u3044\u306E\u3067\u3000{\u6821\u5247\u9055\u53CD|\u3053\u3046\u305D\u304F\u3044\u306F\u3093}\u3067\u3059\u304B\u3089\u306D\u30FC\uFF01[VAR 0114(000A)]",
  "[VAR 0100(0000)]\uFF01\u3000\u3044\u304F\u3088\u30FC\uFF01[VAR 0114(0004)]",
  "{\u6CE8\u610F|\u3061\u3085\u3046\u3044}\u306F\u3000{\u805E|\u304D}\u3044\u3066\u304F\u308C\u305F\u3067\u3057\u3087\u3046\u304B\uFF1F\\c\\n\u2026\u2026{\u5143\u6C17|\u3052\u3093\u304D}\u306E\u3044\u3044\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u305F\u3061\u3070\u304B\u308A\u3067\\n{\u5FC3\u914D|\u3057\u3093\u3071\u3044}\u304C\u3000{\u7D76|\u305F}\u3048\u307E\u305B\u3093\u3088[VAR 0114(000A)]",
  "{\u4F55|\u306A\u306B}\u3057\u3066\u3082\u3044\u3044\u3063\u3066\u3000{\u8A00|\u3044}\u308F\u308C\u308B\u3068\\n{\u9006|\u304E\u3083\u304F}\u306B\u3000\u3080\u305A\u304B\u3057\u3044\u3093\u3060\u3088\u306D",
  "{\u5F85|\u307E}\u3063\u3066\u307E\u3057\u305F\u3000{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\uFF01\\n\u304A\u3053\u3065\u304B\u3044\u3067\u3000{\u8CB7|\u304B}\u3063\u305F\u3000\u30AB\u30E1\u30E9\u3067\\r\\n{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\u306E{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3000{\u64AE|\u3068}\u3063\u3066\u3084\u308B\uFF01",
  "{\u50D5|\u307C\u304F}\u306B\u3068\u3063\u3066\\n{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u306F\u3000\u30DD\u30B1\u30E2\u30F3{\u63A2|\u3055\u304C}\u3057\uFF01\\r\\n{\u56F3\u9451|\u305A\u304B\u3093}\u306B\u3000\u3044\u3063\u3071\u3044\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3059\u308B\u305E\u30FC\uFF01",
  "\u3069\u3053\u306B\u3000{\u884C|\u3044}\u3053\u3046\u304B\u306A\uFF1F\\n{\u8AB0|\u3060\u308C}\u304B\u306B\u3000{\u6C7A|\u304D}\u3081\u3066\u307B\u3057\u3044\u2026\u2026",
  "\u3044\u308D\u3093\u306A{\u5834\u6240|\u3070\u3057\u3087}\u3067\\n\u30D4\u30AF\u30CB\u30C3\u30AF\u3057\u307E\u304F\u308A\u3088\u30FC\uFF01"
]
