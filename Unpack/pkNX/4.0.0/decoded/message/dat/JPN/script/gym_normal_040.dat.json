  "\u30B8\u30E0\u30D0\u30C3\u30B8\u304C\u3000\uFF18\u3064\u3000\u3042\u308C\u3070\\n\u3069\u3093\u306A\u30DD\u30B1\u30E2\u30F3\u3067\u3082\u3000{\u6355|\u3064\u304B}\u307E\u3048\u3089\u308C\u307E\u3059\\r\\n{\u6307\u793A|\u3057\u3058}\u306B\u3000{\u80CC|\u305D\u3080}\u304F\u3053\u3068\u3082\u3000\u306A\u3044\u3067\u3057\u3087\u3046[VAR 0114(0015)]",
