  "\u3048\u30FC\u3068\u2026\u2026\u3000\u3053\u306E{\u5E97|\u307F\u305B}\u306F\\n{\u713C|\u3084}\u304D\u304A\u306B\u304E\u308A{\u4EE5\u5916|\u3044\u304C\u3044}\u3082\u3000\u3046\u307E\u3044\u3067\u3059[VAR 0114(0015)]",
