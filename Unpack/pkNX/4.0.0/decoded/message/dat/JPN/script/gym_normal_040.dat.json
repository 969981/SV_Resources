  "\u3042\u306A\u305F\u306E\u3088\u3046\u306A\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306A{\u5B50|\u3053}\u306B\u306F\\n{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306A\u3055\u305D\u3046\u3067\u3059\u304C\u3000\u3053\u3061\u3089\u3082\u3000\u3069\u3046\u305E[VAR 0114(0015)]",
  "{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u306E\u304A{\u4EE3|\u3060\u3044}\u306F\u3000\u3044\u308A\u307E\u305B\u3093\u3088\\n\u3053\u308C\u3067\u3082\u3000{\u5927\u4EBA|\u304A\u3068\u306A}\u3067\u3059\u306E\u3067\u2026\u2026[VAR 0114(0015)]",
