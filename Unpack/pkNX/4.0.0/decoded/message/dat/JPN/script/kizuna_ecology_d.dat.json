[
  "\u3042\u3000[VAR 0100(0000)]\u3055\u3093\\n\u3069\u304A\u3082\u3000\u3069\u304A\u3082\uFF01[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u3000\uFF12\uFF10\uFF10{\u7A2E\u985E|\u3057\u3085\u308B\u3044}\uFF01\\n{\u96C6|\u3042\u3064}\u3081\u3066\u304F\u3060\u3055\u3063\u305F\u3093\u3067\u3059\u306D\u3048\uFF01[VAR 0114(002A)]",
  "\u308F\u3042\u30FC\u3000\u308F\u3042\u30FC\uFF01\\n{\u5C71|\u3084\u307E}\u306E\u30DD\u30B1\u30E2\u30F3\u3000{\u6D77|\u3046\u307F}\u306E\u30DD\u30B1\u30E2\u30F3\uFF01\\r\\n\u3042\u3063\u3000\u3053\u3093\u306A\u3068\u3053\u308D\u306B\u3082\u3000\u3044\u308B\u3093\u3060\uFF01\uFF01\uFF01[VAR 0114(002A)]",
  "\u2026\u2026\u3059\u307F\u307E\u305B\u3093\\n\u3068\u308A\u307F\u3060\u3057\u3061\u3083\u3044\u307E\u3057\u305F\u3042[VAR 0114(002A)]",
  "\u304A\u304B\u3052\u3055\u307E\u3067\u3000\u30DD\u30B1\u30E2\u30F3\u306E{\u8ABF\u67FB|\u3061\u3087\u3046\u3055}\\n{\u5927|\u3060\u3044}\u3000{\u5927|\u3060\u3044}\u3000{\u5927\u524D\u9032|\u3060\u3044\u305C\u3093\u3057\u3093}\u3067\u3059\u3088\u304A\u30FC\uFF01[VAR 0114(002A)]",
  "\u304A{\u793C|\u308C\u3044}\u306B\u3000\u3053\u3061\u3089\\n{\u5DEE|\u3055}\u3057{\u4E0A|\u3042}\u3052\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u3055\u3093\u306F\u3000\u30DD\u30B1\u30E2\u30F3\\n{\u6355|\u3064\u304B}\u307E\u3048\u308B\u3000\u30D7\u30ED\u30D5\u30A7\u30C3\u30B7\u30E7\u30CA\u30EB\uFF01[VAR 0114(002A)]",
  "{\u6B21|\u3064\u304E}\u306F\u3000\u3044\u3088\u3044\u3088\u3000{\u5B8C\u5168\u5236\u8987|\u304B\u3093\u305C\u3093\u305B\u3044\u306F}\uFF01\\n{\u76EE\u6A19|\u3082\u304F\u3072\u3087\u3046}\u3000\uFF14\uFF10\uFF10{\u7A2E\u985E|\u3057\u3085\u308B\u3044}\u3067\u3000\u3044\u3063\u3066\u307F\u307E\u3057\u3087\u3046\uFF01[VAR 0114(002A)]",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3080\u305A\u304B\u3057\u3044\u3053\u3068\u3067\u3059\u304C\\n[VAR 0100(0000)]\u3055\u3093\u306A\u3089\u3000\u3084\u308A\u3068\u3052\u3089\u308C\u307E\u3059[VAR 0114(002A)]",
