[
  "\u30E2\u30C8\u30C8\u30AB\u30B2\u306E\u3000\u304A\u304B\u3052\u3067\\n\u30ED\u30FC\u30B9\u30C8{\u7802\u6F20|\u3055\u3070\u304F}\u3092\u3000{\u8D8A|\u3053}\u3048\u3089\u308C\u305F\u306A\uFF01",
  "\u30DD\u30B1\u30E2\u30F3\u30A6\u30A9\u30C3\u30B7\u30E5\u3067\u3000{\u7802|\u3059\u306A}\u3092\\n\u304D\u308C\u3044\u306B\u3000{\u843D|\u304A}\u3068\u3057\u3066\u3042\u3052\u306A\u3044\u3068\u306D",
  "\u305A\u3063\u3068\u3000\u30DE\u30EA\u30EB\u3061\u3083\u3093\u3067\u3000\u3044\u3066\u307B\u3057\u3044\u304B\u3089\\n{\u9032\u5316|\u3057\u3093\u304B}\u3057\u305D\u3046\u306B\u3000\u306A\u3063\u305F\u3089\\c\\n\u300E{\u9032\u5316|\u3057\u3093\u304B}\u30AD\u30E3\u30F3\u30BB\u30EB\u3000\uFF22\u30DC\u30BF\u30F3\uFF01\u300F\u3063\u3066\\n\u304A\u307E\u3058\u306A\u3044\u3092\u3000\u3059\u308B\u306E",
  "\u30AB\u30E9\u30D5\u30B7\u30C6\u30A3\u306E\u3000\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u306F\\n{\u5DDD|\u304B\u308F}\u3068\u3000\u3064\u306A\u304C\u3063\u3066\u3044\u308B\u3093\u3060\uFF01",
  "{\u4E0A|\u3046\u3048}\u306B\u3000{\u884C|\u3044}\u304D\u305F\u3051\u308C\u3070\\n{\u6607\u964D\u6A5F|\u3057\u3087\u3046\u3053\u3046\u304D}\u306E{\u524D|\u307E\u3048}\u3067\u3000{\u5F85|\u307E}\u3063\u3068\u308C\u3070\u3000\u3048\u3048\u305E\u3044",
  "\u3053\u3053\u304B\u3089{\u5148|\u3055\u304D}\u306F\u3000{\u6DF1|\u3075\u304B}\u304F\u306A\u3063\u3066\u308B\u3088\uFF01\\n\u306A\u307F\u306E\u308A\u304C\u3000\u3067\u304D\u308C\u3070\u3000{\u5B89\u5168|\u3042\u3093\u305C\u3093}\u3060\u306A",
  "\u30DE\u30EA\u30CA\u30FC\u30C9\u30BF\u30A6\u30F3\u306F\u3000{\u7802\u6F20|\u3055\u3070\u304F}\u306E{\u5411|\u3080}\u3053\u3046\uFF01\\n{\u884C|\u3044}\u304F\u306A\u3089\u3000{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u306F\u3000{\u5165\u5FF5|\u306B\u3085\u3046\u306D\u3093}\u306B\u306D",
  "\u30B3\u30A4\u30F3\u3092\u3000{\u6301|\u3082}\u3063\u305F\u3000{\u5C0F|\u3061\u3044}\u3055\u306A\u30DD\u30B1\u30E2\u30F3\uFF01\\n{\u8FD1|\u3061\u304B}\u3065\u3044\u305F\u3089\u3000\u30B3\u30A4\u30F3\u3000{\u843D|\u304A}\u3063\u3053\u3068\u3057\u3066\\r\\n\u3069\u3063\u304B\u306B\u3000{\u6D88|\u304D}\u3048\u3061\u307E\u3063\u305F\uFF01\u3000{\u4F55|\u306A\u306B}\u3042\u308C\uFF01\uFF1F",
  "\u304A{\u5BB6|\u3046\u3061}\u3067\u3000{\u5F85|\u307E}\u3063\u3066\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n{\u4F55|\u306A\u306B}\u304B\u3000{\u8CB7|\u304B}\u3063\u3066\u3000{\u5E30|\u304B\u3048}\u308D\u3046\u304B\u306A\u3041",
  "\u307C\u304F\u306E\u3000\u3059\u304D\u306A\u3000\u305F\u3079\u3082\u306E\u3068\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u3059\u304D\u306A\u3000\u305F\u3079\u3082\u306E\\r\\n\u3061\u3087\u3063\u3068\u3000\u3061\u304C\u3046\u306E\u3000\u306A\u3093\u3067\u304B\u306A\u30FC\uFF1F",
  "{\u753A|\u307E\u3061}\u306E{\u58C1|\u304B\u3079}\u304C\u3000{\u6EDD|\u305F\u304D}\u307F\u305F\u3044\uFF01\\n\u305F\u304D\u306E\u307C\u308A\u306E\u3000{\u7DF4\u7FD2|\u308C\u3093\u3057\u3085\u3046}\u306B\u306F\u3000\u3082\u3063\u3066\u3053\u3044\u306D\uFF01",
  "\u30D4\u30B1\u30BF\u30A6\u30F3\u304B\u3089\u3000{\u6765|\u304D}\u305F\u304B\u3089\\n{\u6C34|\u307F\u305A}\u306E{\u591A|\u304A\u304A}\u3055\u306B\u3000\u30D3\u30C3\u30AF\u30EA\u3060\uFF01\\r\\n{\u5411|\u3080}\u3053\u3046\u3067\u3000{\u6C34|\u307F\u305A}\u306F\u3000{\u8CB4\u91CD|\u304D\u3061\u3087\u3046}\u3060\u304B\u3089\u306D",
  "\u30DE\u30EA\u30EB\u306F\u3000\u307F\u305A\u30BF\u30A4\u30D7\uFF01\\n\u3084\u3063\u3071\u308A\u3000\u304A{\u6C34|\u307F\u305A}\u304C\u3000{\u597D|\u3059}\u304D\u306A\u306E\uFF01",
  "{\u4F55|\u306A\u306B}\u3092\u3000{\u98DF|\u305F}\u3079\u308B\u304B\u3000\u3053\u307E\u3063\u305F\u3068\u304D\u306F\\n\u3064\u3044\u3000{\u6765\u6765\u6765\u8ED2|\u3089\u3044\u3089\u3044\u3089\u3044\u3051\u3093}\u306B\u3000{\u6765|\u304D}\u3066\u3057\u307E\u3046\u3088",
  "\u3053\u3053\u306F\u3000\u30E9\u30A4\u30C9\u30DD\u30B1\u30E2\u30F3\u304C\\n\u3072\u3068{\u4F11|\u3084\u3059}\u307F\u3059\u308B\u3000{\u5834\u6240|\u3070\u3057\u3087}\u3055\\c\\n\u30E9\u30A4\u30C9\u3057\u305F\u3042\u3068\u306F\u3000\u3061\u3083\u3093\u3068\\n\u306D\u304E\u3089\u3063\u3066\u3042\u3052\u306A\u3044\u3068\u306D",
  "\u30AB\u30E9\u30D5\u30B7\u30C6\u30A3\u306F\u3000{\u6C34|\u307F\u305A}\u306E{\u753A|\u307E\u3061}\uFF01\\n{\u898B|\u307F}\u308C\u3070\u3000\u308F\u304B\u308B\u3088\u30FC\uFF01",
  "\u3053\u306E{\u753A|\u307E\u3061}\u306E\u3000{\u98F2\u98DF\u5E97|\u3044\u3093\u3057\u3087\u304F\u3066\u3093}\u306F\\n{\u8A55\u4FA1|\u3072\u3087\u3046\u304B}\u3000{\u9AD8|\u305F\u304B}\u3044\u3088\uFF01\\c\\n\u307B\u3068\u3093\u3069\u304C\u3000\u30DE\u30EA\u30CA\u30FC\u30C9{\u7523|\u3055\u3093}\u306E\\n{\u65B0\u9BAE|\u3057\u3093\u305B\u3093}\u306A{\u7D20\u6750|\u305D\u3056\u3044}\u3092\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u308B\u304B\u3089\u306D\uFF01",
  "{\u82E5|\u308F\u304B}\u3044\u3046\u3061\u306B\u3000\u3044\u3063\u3071\u3044\u3000{\u65C5\u884C|\u308A\u3087\u3053\u3046}\u3057\u3066\\n{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3092\u3000\u3044\u3063\u3071\u3044\u3000{\u64AE|\u3068}\u308B\u306E\\c\\n\u3044\u3064\u304B\u3000\u304A\u3070\u3042\u3061\u3083\u3093\u306B\u3000\u306A\u3063\u305F\u3089\\n{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3092\u3000{\u898B|\u307F}\u3066\u3000{\u6614|\u3080\u304B\u3057}\u3092\u3000{\u601D|\u304A\u3082}\u3044{\u8FD4|\u304B\u3048}\u3059\u306E",
  "\u3053\u306E{\u753A|\u307E\u3061}\u306F\u3000\u30CF\u30A4\u30C0\u30A4{\u5036\u697D\u90E8|\u304F\u3089\u3076}\u3063\u3066\\n\u304A{\u5E97|\u307F\u305B}\u304C\u3000{\u6709\u540D|\u3086\u3046\u3081\u3044}\u306A\u306E\u304B\u30FC",
  "\u308F\u305F\u3057\u3000{\u4E0A|\u3046\u3048}\u306B\u3042\u308B\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1{\u5C4B|\u3084}\u3055\u3093\u306B\u3000{\u884C|\u3044}\u304D\u305F\u30FC\u3044",
  "{\u5730\u56F3|\u3061\u305A}\u3092\u3000{\u8AAD|\u3088}\u3080\u306E\u304C\u3000{\u82E6\u624B|\u306B\u304C\u3066}\u3067\u3055\\n\u2026\u2026{\u5317|\u304D\u305F}\u3063\u3066\u3000\u3069\u3063\u3061\u3060\u3063\u3051\uFF1F",
  "\u30DE\u30C3\u30D7\u30A2\u30D7\u30EA\u3067\u3000{\u7DD1\u8272|\u307F\u3069\u308A\u3044\u308D}\u306E{\u65B9\u89D2|\u307B\u3046\u304C\u304F}\u304C\u3000{\u5317|\u304D\u305F}\u3088\\n{\u8FF7|\u307E\u3088}\u3046\u3088\u3046\u306A\u3089\u3000{\u5730\u56F3|\u3061\u305A}\u3092\u3000{\u56FA\u5B9A|\u3053\u3066\u3044}\u3057\u3066\u307F\u305F\u3089\uFF1F",
  "\u30AB\u30E9\u30D5\u306F\u3000{\u5D16|\u304C\u3051}\u306B\u3042\u308F\u305B\u3066\u3000\u3067\u304D\u305F{\u753A|\u307E\u3061}\uFF01\\n\u3060\u304B\u3089\u3000{\u6BB5\u3005|\u3060\u3093\u3060\u3093}\u306A{\u69CB\u9020|\u3053\u3046\u305E\u3046}\u306B\u3000\u306A\u3063\u3066\u308B\u3093\u3060",
  "\u3044\u3084\u30FC\u3000{\u7206\u8CB7|\u3070\u304F\u304C}\u3044\u3057\u3061\u3083\u3063\u305F\uFF01\\n{\u6B21|\u3064\u304E}\u306F\u3000\u3069\u3053\u3078\u3000{\u884C|\u3044}\u3053\u3046\u304B\uFF1F",
  "\u304A{\u6B21|\u3064\u304E}\u306F\u3000\u30DE\u30EA\u30CA\u30FC\u30C9\u30BF\u30A6\u30F3\u306E\\n{\u5E02\u5834|\u3044\u3061\u3070}\u3067\u3000{\u7206\u8CB7|\u3070\u304F\u304C}\u3044\u3088\uFF01",
  "\u3053\u3053\u306F\u3000{\u6C34|\u307F\u305A}\u306E{\u90FD|\u307F\u3084\u3053}\u3000\u30AB\u30E9\u30D5\uFF5E\u266A\\n\u30AB\u30E9\u30D5\u3068\u306F\uFF5E\u3000{\u6C34|\u307F\u305A}\u3068\u304B\u3092\u3000{\u5165|\u3044}\u308C\u308B{\u74F6|\u3073\u3093}\uFF5E\u266A",
  "{\u6607\u964D\u6A5F|\u3057\u3087\u3046\u3053\u3046\u304D}\u304C\u3000\u3067\u304D\u308B{\u524D|\u307E\u3048}\u306F\\n{\u753A|\u307E\u3061}\u306E{\u4E0A\u4E0B|\u3046\u3048\u3057\u305F}\u3092\u3000\u30E9\u30A4\u30C9\u30DD\u30B1\u30E2\u30F3\u3067\\r\\n{\u79FB\u52D5|\u3044\u3069\u3046}\u3057\u3066\u305F\u3093\u3060\u3063\u3066\uFF01\u3000{\u5927\u5909|\u305F\u3044\u3078\u3093}\uFF01",
  "\u30DD\u30B1\u30E2\u30F3\u3092\u3000\u30C6\u30E9\u30B9\u30BF\u30EB\u3059\u308B\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u30AA\u30FC\u30D6\u306F\\r\\n{\u512A\u79C0|\u3086\u3046\u3057\u3085\u3046}\u306A{\u4EBA|\u3072\u3068}\u3057\u304B\u3000{\u6301|\u3082}\u3063\u3066\u306A\u3044\u305D\u3046\u3060",
  "\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u30C6\u30E9\u30B9\u30BF\u30EB\u3059\u308B\u306E\u3063\u3066\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3060\u3051\u3000\u3089\u3057\u3044\u306D\\r\\n\u3069\u3046\u3044\u3046{\u7406\u7531|\u308A\u3086\u3046}\u304C\u3000\u3042\u308B\u3093\u3060\u308D\u3046\uFF1F",
  "{\u4E00\u822C\u4EBA|\u3044\u3063\u3071\u3093\u3058\u3093}\u304C\u3000{\u5165|\u306F\u3044}\u308C\u306A\u3044\\n\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u306B\u306F\\r\\n\u3069\u3093\u306A\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3044\u308B\u3093\u3058\u3083\u308D\u3046\uFF1F",
  "\u30CF\u30A4\u30C0\u30A4{\u5036\u697D\u90E8|\u304F\u3089\u3076}\u3078\u3000\u3088\u3046\u3053\u305D\uFF01\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30CF\u30A4\u30C0\u30A4\u3055\u3093\u306E\u3000\u304A{\u5E97|\u307F\u305B}\u3060\u3088\uFF01",
  "\u30AB\u30E9\u30D5\u30B7\u30C6\u30A3\u306E\u3000{\u7F8E|\u3046\u3064\u304F}\u3057\u3044{\u753A\u4E26|\u307E\u3061\u306A}\u307F\u306F\\n{\u64AE\u5F71|\u3055\u3064\u3048\u3044}\u30B9\u30DD\u30C3\u30C8\u3068\u3057\u3066\u3000{\u4EBA\u6C17|\u306B\u3093\u304D}\u3060\u3088",
  "\u307C\u304F\u305F\u3061\u3000{\u6765\u5E74|\u3089\u3044\u306D\u3093}\u304B\u3089\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3060\u306D\uFF01\\n{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u3000\u3044\u3063\u3071\u3044\u3000\u3067\u304D\u308B\u304B\u306A\uFF1F",
  "{\u5BEE\u751F\u6D3B|\u308A\u3087\u3046\u305B\u3044\u304B\u3064}\u3063\u3066\u3000{\u697D|\u305F\u306E}\u3057\u307F\uFF01\u3000{\u5BDD|\u306D}\u308B{\u524D|\u307E\u3048}\u306B\\n\u304A{\u83D3\u5B50|\u304B\u3057}\u3000{\u98DF|\u305F}\u3079\u3066\u3082\u3000{\u6012|\u304A\u3053}\u3089\u308C\u306A\u3044\u3093\u3067\u3057\u3087\uFF1F",
  "{\u753A\u5168\u4F53|\u307E\u3061\u305C\u3093\u305F\u3044}\u3092\u3000{\u9752|\u3042\u304A}\u304F\u3057\u305F\u3089\\n{\u89B3\u5149|\u304B\u3093\u3053\u3046}\u306E\u304B\u305F\u304C\u3000{\u5897|\u3075}\u3048\u305F\u306E\\c\\n{\u6570\u5E74\u524D|\u3059\u3046\u306D\u3093\u307E\u3048}\u306B\u3000\u30CF\u30A4\u30C0\u30A4\u3055\u3093\u304C\\n{\u63D0\u6848|\u3066\u3044\u3042\u3093}\u3057\u305F\u3093\u3067\u3059\u3063\u3066",
  "{\u4E00\u5EA6|\u3044\u3061\u3069}\u3067\u3082\u3000{\u4E8C\u5EA6|\u306B\u3069}\u3067\u3082\u3000\u307E\u3044\u3069\u30FB\u3055\u3093\u3069\u266A\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306F\u3000\u3044\u304B\u304C\u3067\u3059\u304B\u30FC\uFF1F",
  "\u30AB\u30E9\u30D5\u30B8\u30E0\u306E\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u306F\\n\u3068\u30FC\u3063\u3066\u3082\u3000\u3080\u305A\u304B\u3057\u3044\u306E\u3088",
  "\u30CF\u30A4\u30C0\u30A4\u3055\u3093\u306F\u3000\u3053\u306E{\u753A|\u307E\u3061}\u306E{\u9854|\u304B\u304A}\u306D\uFF01\\n\u3044\u3064\u3082\u3000\u304A\u304A\u3089\u304B\u3067\u3000{\u512A|\u3084\u3055}\u3057\u3044\u3051\u3069\\r\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306E\u3068\u304D\u306F\u3000\u304B\u3063\u3053\u3044\u3044\u306E\uFF01",
  "{\u5730\u5F62|\u3061\u3051\u3044}\u306E{\u8D77\u4F0F|\u304D\u3075\u304F}\u304C\u3000{\u6FC0|\u306F\u3052}\u3057\u3044\\n\u30D1\u30EB\u30C7\u30A2\u3067\u306F\u3000{\u7121\u7406|\u3080\u308A}\u3060\u3051\u3069\\r\\n{\u81EA\u8EE2\u8ECA|\u3058\u3066\u3093\u3057\u3083}\u3067\u3000{\u65C5|\u305F\u3073}\u3059\u308B\u306E\u3082\u3000\u3042\u3053\u304C\u308C\u308B\u3088",
  "\u307B\u304B\u306E{\u5730\u65B9|\u3061\u307B\u3046}\u3067\u306F\u3000\u30E2\u30C8\u30C8\u30AB\u30B2{\u4EE5\u5916|\u3044\u304C\u3044}\u306B\u3082\\n\u30E9\u30A4\u30C9\u3057\u3066\u308B\u3063\u3066\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u304B\u306A\uFF5E\uFF1F",
  "{\u4ECA\u6708|\u3053\u3093\u3052\u3064}\u3000\u304C\u3093\u3070\u3063\u305F\u304B\u3089\u2026\u2026\\n{\u9AD8\u7D1A|\u3053\u3046\u304D\u3085\u3046}\u30D0\u30C3\u30B0\u3000{\u8CB7|\u304B}\u3063\u3066\u3082\u3000\u3044\u3044\u3088\u306D\uFF01",
  "{\u9AEA\u578B|\u304B\u307F\u304C\u305F}\u3092\u3000{\u5909|\u304B}\u3048\u3066\u3000{\u6C17\u5206\u8EE2\u63DB|\u304D\u3076\u3093\u3066\u3093\u304B\u3093}\uFF01\\n\u3069\u3046\uFF1F\u3000\u304B\u308F\u3044\u3044\u3067\u3057\u3087\uFF1F",
  "\u3048\u3048\u3063\u3068\u2026\u2026\\n{\u524D\u9AEA|\u307E\u3048\u304C\u307F}\u3092\u3000{\u5207|\u304D}\u3063\u305F\u306E\u304B\u306A\uFF1F"
]
