[
  "\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u30ED\u30C8\u2026\u2026",
  "\u3069\u304A\u3082\u3000[VAR 0100(0000)]\u3055\u3093\\n\u30B8\u30CB\u30A2\u3067\u3059[VAR 0114(002A)]",
  "\u30C6\u30E9\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB\\n\u305F\u304F\u3055\u3093\u3000{\u6226|\u305F\u305F\u304B}\u3063\u3066\u304F\u308C\u3066\\r\\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u30FC[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u3055\u3093\u306E\u3000\u304A\u304B\u3052\u3055\u307E\u3067\\n{\u8ABF\u67FB|\u3061\u3087\u3046\u3055}\u304C{\u9032|\u3059\u3059}\u3093\u3067\u3000\u308F\u304B\u3063\u305F\u3053\u3068\u304C\u3000\u3042\u308A\u307E\u3042\u3059[VAR 0114(002A)]",
  "\u3069\u3046\u3084\u3089\u3000{\u6642\u6298|\u3068\u304D\u304A\u308A}\u3000\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u304B\u3089\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u306E\u3000\u30A8\u30CD\u30EB\u30AE\u30FC\u304C\u3000{\u653E\u5C04|\u307B\u3046\u3057\u3083}\u3055\u308C\\r\\n{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\u306B\u3000{\u5F71\u97FF|\u3048\u3044\u304D\u3087\u3046}\u3092\u3000\u304A\u3088\u307C\u3057\u3066\u3044\u308B\u3088\u3046\u3067\u3059[VAR 0114(002A)]",
  "\u3068\u308A\u308F\u3051\u3000{\u5927|\u304A\u304A}\u304D\u306A{\u5F71\u97FF|\u3048\u3044\u304D\u3087\u3046}\u3092\u3000{\u53D7|\u3046}\u3051\u305F\\n\u30C6\u30E9\u30EC\u30A4\u30C9\u306E\u3000{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\u306F\\r\\n[VAR FF00(0006)]{\u9ED2|\u304F\u308D}\u3044{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}[VAR FF00(0000)]\u306B\u3000{\u5909\u5316|\u3078\u3093\u304B}\u3057\u3066\u3044\u308B\u305D\u3046\u3067\u3059\u30FC[VAR 0114(002A)]",
  "{\u9ED2|\u304F\u308D}\u3044{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\u306E\u3000\u30C6\u30E9\u30B9\u30BF\u30EB\u30DD\u30B1\u30E2\u30F3\u306F\\n\u3042\u307E\u308A\u306B\u3082\u3000{\u5F37\u5927|\u304D\u3087\u3046\u3060\u3044}\u2026\u2026[VAR 0114(002A)]",
  "{\u4E26|\u306A}\u307F\u306E\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u3067\u306F\\n{\u6B6F|\u306F}\u304C{\u7ACB|\u305F}\u305F\u306A\u3044\u3000{\u5F37|\u3064\u3088}\u3055\u306A\u3093\u3067\u3059\u30FC[VAR 0114(002A)]",
  "\u3044\u304F\u3089\u3000[VAR 0100(0000)]\u3055\u3093\u3067\u3082\\n{\u5371\u967A|\u304D\u3051\u3093}\u306A\u30EC\u30D9\u30EB\u2026\u2026[VAR 0114(002A)]",
  "\u3044\u3044\u3067\u3059\u304B\uFF1F\u3000\u30DE\u30C3\u30D7\u30A2\u30D7\u30EA\u3067\\n{\u5834\u6240|\u3070\u3057\u3087}\u3092\u3000{\u78BA\u8A8D|\u304B\u304F\u306B\u3093}\u3067\u304D\u305F\u3068\u3057\u3066\u3082\\c\\n{\u9ED2|\u304F\u308D}\u3044{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\u306F\u3000{\u5371\u967A|\u304D\u3051\u3093}\u306A\u306E\u3067\\n{\u7D76\u5BFE|\u305C\u3063\u305F\u3044}\u306B\u3000{\u6311|\u3044\u3069}\u307E\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3088\u30FC\uFF01[VAR 0114(002A)]",
  "\u308F\u304B\u308A\u307E\u3057\u305F\uFF01",
  "\u3069\u3046\u3067\u3057\u3087\u3046\u306D\u2026\u2026",
  "\u3046\u30FC\u3093\u3000{\u7D20\u76F4|\u3059\u306A\u304A}\u3059\u304E\u3066\\n\u3061\u3087\u3063\u3068\u3000\u3042\u3084\u3057\u3044\u3067\u3059\u304C\u2026\u2026[VAR 0114(002A)]",
  "\u3044\u3084\u3042\u3000\u3075\u304F\u307F\u3092\u3000{\u6301|\u3082}\u305F\u305B\u3066\u308B\\n{\u5834\u5408|\u3070\u3042\u3044}\u3058\u3083\u3000\u306A\u3044\u3093\u3067\u3059\u3063\u3066\u3048[VAR 0114(002A)]",
  "\u307E\u304D\u3053\u3093\u3067\u304A\u3044\u3066\u3000\u3059\u307F\u307E\u305B\u3093\u304C\\n{\u5371\u967A|\u304D\u3051\u3093}\u306A\u3093\u3067\u3059\u304B\u3089\u306D\u3048\u30FC\uFF01\\r\\n{\u9ED2|\u304F\u308D}\u3044{\u7D50\u6676|\u3051\u3063\u3057\u3087\u3046}\u3000\u30C0\u30E1\u3000{\u7D76\u5BFE|\u305C\u3063\u305F\u3044}\u30FC\uFF01[VAR 0114(002A)]",
  "\u305D\u308C\u3067\u306F\\n\u305F\u306E\u307F\u307E\u3057\u305F\u3088\u30FC\uFF01[VAR 0114(002A)]"
]
