[
  "\u30DD\u30B1\u30E2\u30F3\u30C8\u30EC\u30FC\u30CA\u30FC\u3000\u305F\u308B\u3082\u306E\uFF01\\n\u3055\u3044\u304D\u3087\u3046\u3063\u3066\u3000{\u8A00\u8449|\u3053\u3068\u3070}\u306B\u3000\u3042\u3053\u304C\u308C\u308B\u305C\uFF01",
  "\u3055\u3044\u304D\u3087\u3046\u306E\u3042\u304B\u3057\u3000{\u6301|\u3082}\u3063\u3066\u308B\u3000\u30DD\u30B1\u30E2\u30F3\\n\u3044\u3064\u304B\u3000{\u898B|\u307F}\u3066\u307F\u305F\u3044\u306E\u3060\u305C\uFF01",
  "\u305D\u3093\u3058\u3087\u305D\u3053\u3089\u306B\u3000\u3044\u306A\u3044\u304B\u3089\\n\u3055\u3044\u304D\u3087\u3046\u3000\u306A\u306E\u3060\u305C\uFF01",
  "\u305D\u306E\u30DD\u30B1\u30E2\u30F3\u306F\u2026\u2026\\n\u3055\u3044\u304D\u3087\u3046\u306E\u3042\u304B\u3057\u3000{\u6301|\u3082}\u3063\u3066\u306A\u3044\u306E\u3060\u305C\uFF01",
  "\u305D\u306E\u30DD\u30B1\u30E2\u30F3\u306F\u2026\u2026\\n\u3055\u3044\u304D\u3087\u3046\u306E[VAR 0101(0001)]\u3000\u3060\u305C\uFF01\uFF1F",
  "\u304A\u304A\u304A\u2026\u2026\u3000\u3059\u3054\u3044\u305C\u30FC\uFF01\\n\u3042\u3053\u304C\u308C\u308B\u306E\u3060\u305C\u30FC\uFF01",
  "\u304A{\u793C|\u308C\u3044}\u306B\u3000\u30AC\u30E9\u30EB{\u5730\u65B9|\u3061\u307B\u3046}\u3067\u3000{\u6D41\u884C|\u306F\u3084}\u3063\u3066\u308B\\n\u3055\u3044\u304D\u3087\u3046\u306A\u3000\u30A8\u30E2\u30FC\u30C8\u3000{\u6559|\u304A\u3057}\u3048\u308B\u305C\uFF01",
  "[VAR 0100(0000)]\u306F\u3000{\u7537|\u304A\u3068\u3053}\u306E{\u5B50|\u3053}\u304B\u3089\\n[VAR FF00(0008)]\u30EA\u30B6\u30FC\u30C9\u30F3\u30DD\u30FC\u30BA\u30A8\u30E2\u30FC\u30C8[VAR FF00(0000)]\u3092\\r\\n{\u6559|\u304A\u3057}\u3048\u3066\u3082\u3089\u3063\u305F\uFF01",
  "\u30EA\u30B6\u30FC\u30C9\u30F3\u30DD\u30FC\u30BA\u306F\\n\u30AC\u30E9\u30EB{\u5730\u65B9|\u3061\u307B\u3046}\u306E\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306E\\r\\n\u3055\u3044\u304D\u3087\u3046\u306A\u3000{\u6C7A|\u304D}\u3081\u30DD\u30FC\u30BA\u3000\u306A\u306E\u3060\u305C\uFF01"
