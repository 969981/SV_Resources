[
  "\u3055\u3042\u3066\u3000\u3044\u3088\u3044\u3088\u3000\u304A{\u6B21|\u3064\u304E}\u306F\\n\u30AA\u30A4\u30E9\u3068\u306E\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3060\u306A[VAR 0114(004A)]",
