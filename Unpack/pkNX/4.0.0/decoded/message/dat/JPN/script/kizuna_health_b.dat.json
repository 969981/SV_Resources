[
  "\u3088\u3046\u3053\u305D\u30FC\\n\u30DF\u30E2\u30B6\u306E{\u533B\u52D9\u5BA4|\u3044\u3080\u3057\u3064}\u3078\u30FC[VAR 0114(0028)]",
  "\u3042\u308C\uFF1F\u3000[VAR 0100(0000)]\\n\u3061\u3087\u3063\u3068\u3000\u305F\u304F\u307E\u3057\u304F\u306A\u3063\u305F\uFF1F[VAR 0114(0028)]",
  "\u3048\u30FC\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u3067\u3000{\u8A00|\u3044}\u3046\u30FC\uFF1F\\n\u3067\u3082\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u3000{\u9854|\u304B\u304A}\u3064\u304D\u3000{\u5909|\u304B}\u308F\u3063\u305F[VAR 0114(0028)]",
  "\u3044\u3084\u30FC\u3000\u3084\u3063\u3071\u3000\u3061\u3087\u3063\u3068\\n{\u9854|\u304B\u304A}\u3064\u304D\u3000{\u5909|\u304B}\u308F\u3063\u305F\u3088[VAR 0114(0028)]",
  "{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u3067\u3000\u3044\u3063\u3071\u3044\\n\u3044\u308D\u3093\u306A\u3053\u3068\u3000{\u7D4C\u9A13|\u3051\u3044\u3051\u3093}\u3057\u3066\u3093\u3060\u308D\u30FC\u306D[VAR 0114(0028)]",
  "\u3069\u3093\u306A\u3053\u3068\u3000\u3057\u3066\u308B\u304B\\n{\u8A71|\u306F\u306A\u3057}\u3000{\u805E|\u304D}\u304B\u305B\u3066\u3088[VAR 0114(0028)]",
  "\u3078\u30FC\u3000\u305D\u3093\u306A\\n\u304A\u3082\u3057\u308D\u3044\u3053\u3068\u3000\u3057\u3066\u3093\u3060\u306D\u30FC[VAR 0114(0028)]",
  "{\u5B50\u4F9B|\u3053\u3069\u3082}\u3063\u3066\u3000\u3059\u3054\u3044\u308F\u30FC\u2026\u2026\\n{\u6BCE\u65E5|\u307E\u3044\u306B\u3061}\u3000{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u3053\u3068\\r\\n\u30C1\u30E3\u30EC\u30F3\u30B8\u3057\u3066\u3093\u3060\u3082\u3093[VAR 0114(0028)]",
  "\u305D\u308C\u306B\u3000\u304F\u3089\u3079\u3066\u2026\u2026[VAR 0114(0028)]",
  "\u2026\u2026\u3042\u305F\u3057\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306B\\n\u306A\u308A\u305F\u304B\u3063\u305F\u3093\u3060\u30FC[VAR 0114(0028)]",
  "\u3042\u3000{\u4ECA|\u3044\u307E}\u306F\u3000{\u5B66\u6821\u4FDD\u5065\u5E2B|\u304C\u3063\u3053\u3046\u307B\u3051\u3093\u3057}\u306A\u306E\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3068\u304B\u3000\u3067\u304D\u306A\u3044\u3084\u3064[VAR 0114(0028)]",
  "{\u990A\u8B77\u6559\u8AED|\u3088\u3046\u3054\u304D\u3087\u3046\u3086}\u306E{\u8A66\u9A13|\u3057\u3051\u3093}\\n{\u5168\u7136|\u305C\u3093\u305C\u3093}\u3000{\u53D7|\u3046}\u304B\u3093\u306A\u304F\u3066\u3055\u30FC[VAR 0114(0028)]",
  "{\u4F55\u5EA6|\u306A\u3093\u3069}\u3000\u3084\u3063\u3066\u3082\u3000\u30C0\u30E1\u3067\\n{\u533B\u52D9\u5BA4|\u3044\u3080\u3057\u3064}\u3067\u3000\u304F\u3055\u3063\u3061\u3083\u3063\u305F[VAR 0114(0028)]",
  "\u3042\u3000\u3054\u3081\u3093\\n{\u6697|\u304F\u3089}\u3044{\u8A71|\u306F\u306A\u3057}\u3000\u3057\u3061\u3083\u3063\u305F\u306D[VAR 0114(0028)]",
  "\u3042\u3093\u305F\u3000{\u805E|\u304D}\u304D{\u4E0A\u624B|\u3058\u3087\u3046\u305A}\u306A\u3093\u3060\u3082\u3093\\n\u3064\u3044\u3064\u3044\u3000{\u8A71|\u306F\u306A}\u3057\u3061\u3083\u3046[VAR 0114(0028)]",
  "\u3053\u308C\u306B\u3000{\u61F2|\u3053}\u308A\u305A\u306B\\n\u307E\u305F\u3000{\u4F1A|\u3042}\u3044\u306B\u304D\u3066\u306D[VAR 0114(0028)]",
  "\u30DF\u30E2\u30B6{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\\n\u307E\u305F{\u5C11|\u3059\u3053}\u3057\u3000\u306A\u304B\u3088\u304F\u306A\u3063\u305F\uFF01"
]
