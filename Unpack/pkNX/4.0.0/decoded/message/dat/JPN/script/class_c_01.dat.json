[
  "\u2026\u2026\u304A\u3084\uFF1F\u3000{\u521D|\u306F\u3058}\u3081\u3066\u306E\\n{\u751F\u5F92|\u305B\u3044\u3068}\u3082\u3000\u3044\u308B\u3088\u3046\u3060\u306A[VAR 0114(002C)]",
  "\u30EF\u30BF\u30B7\u306F\u3000\u30EC\u30DB\u30FC\u30EB\\n{\u8CB4\u69D8|\u304D\u3055\u307E}\u305F\u3061\u306B\u3000{\u53E4|\u3044\u306B\u3057\u3048}\u306E{\u5B66\u8853|\u304C\u304F\u3058\u3085\u3064}\u3092\u3000{\u6388|\u3055\u305A}\u3051\u308B{\u8005|\u3082\u306E}\u3060[VAR 0114(0027)]",
  "{\u6B74\u53F2|\u308C\u304D\u3057}\u306F\u3000\u30A4\u30A4\u2026\u2026\u3000{\u7D20\u6674|\u3059\u3070}\u3089\u3057\u3044\u2026\u2026\\n{\u5148\u4EBA|\u305B\u3093\u3058\u3093}\u305F\u3061\u304C\u3000{\u7A4D|\u3064}\u307F{\u91CD|\u304B\u3055}\u306D\u305F\u3000{\u6642\u9593|\u3058\u304B\u3093}\u304C\\r\\n{\u6211\u3005|\u308F\u308C\u308F\u308C}\u306E{\u751F|\u3044}\u304D\u308B\u3000{\u4ECA|\u3044\u307E}\u3078\u3068\u3000{\u7E4B|\u3064\u306A}\u304C\u3063\u3066\u3044\u308B\u2026\u2026\uFF01[VAR 0114(0027)]",
  "{\u672C\u65E5|\u307B\u3093\u3058\u3064}\u306F\u3000\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3067\\n{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\u306B\u3000{\u672A\u77E5|\u307F\u3061}\u306A\u308B{\u5834\u6240|\u3070\u3057\u3087}\\r\\n{\u8B0E|\u306A\u305E}\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u306B\u3064\u3044\u3066\u3000{\u5B66|\u307E\u306A}\u3073\u305F\u307E\u3048[VAR 0114(0027)]",
  "{\u7686|\u307F\u306A}\u3082\u3000{\u77E5|\u3057}\u3063\u3066\u308B\u3088\u3046\u306B\\n\u30D1\u30EB\u30C7\u30A2{\u4E2D\u592E|\u3061\u3085\u3046\u304A\u3046}\u306B\u306F\u3000{\u5DE8\u5927|\u304D\u3087\u3060\u3044}\u306A{\u7A7A\u6D1E|\u304F\u3046\u3069\u3046}\\r\\n\u300E\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u300F\u304C\u3000{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u3057\u3066\u3044\u308B[VAR 0114(0027)]",
  "{\u7A74|\u3042\u306A}\u306E{\u4E2D|\u306A\u304B}\u306F\u3000\u300E\u30A8\u30EA\u30A2\u30BC\u30ED\u300F\u3068\u3000{\u547C|\u3088}\u3070\u308C\u3066\u304A\u308A\\n\u305D\u306E{\u5730\u5C64|\u3061\u305D\u3046}\u3084\u3000{\u6210\u5206|\u305B\u3044\u3076\u3093}\u306B\u3088\u308B\u3068\\r\\n\uFF11\uFF10\uFF10{\u4E07\u5E74\u4EE5\u4E0A|\u307E\u3093\u306D\u3093\u3044\u3058\u3087\u3046}\u3082\u3000{\u524D|\u307E\u3048}\u304B\u3089\\r\\n{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u3059\u308B\u3068\u3000{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u3055\u308C\u3066\u3044\u308B\u306E\u3060[VAR 0114(0027)]",
  "\u305D\u3093\u306A{\u8B0E|\u306A\u305E}\u3081\u304F\u3000{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u306E{\u5E95|\u305D\u3053}\u306B\u306F\\n{\u6614|\u3080\u304B\u3057}\u304B\u3089\u3000[VAR FF00(0006)]\u3042\u308B\u3082\u306E[VAR FF00(0000)]\u304C\u3000{\u7720|\u306D\u3080}\u308B\u3068\u3000{\u4FE1|\u3057\u3093}\u3058\u3089\u308C\u3066\u3044\u305F[VAR 0114(0027)]",
  "\u2026\u2026\u3055\u3066\u3000\u3053\u3053\u3067\u3000\u30EF\u30BF\u30B7\u3068\u3000{\u76EE|\u3081}\u304C{\u5408|\u3042}\u3063\u305F\\n\u3042\u308F\u308C\u306A\u3000[VAR 0100(0000)]\u306B\u3000\u30AF\u30A8\u30B9\u30C1\u30E7\u30F3[VAR 0114(0027)]",
  "\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u3000{\u5185\u90E8|\u306A\u3044\u3076}\u2026\u2026\\n\u30A8\u30EA\u30A2\u30BC\u30ED\u306E\u3000{\u5965\u5E95|\u304A\u304F\u305D\u3053}\u306B\u3000{\u7720|\u306D\u3080}\u308B\u3068\\r\\n{\u4FE1|\u3057\u3093}\u3058\u3089\u308C\u3066\u305F\u3082\u306E\u306F\u3000{\u4F55|\u306A\u3093}\u3060\u308D\u3046\u304B\uFF1F[VAR 0114(0027)]",
  "{\u8CA1\u5B9D|\u3056\u3044\u307B\u3046}",
  "\u30AB\u30D3\u30B4\u30F3",
  "\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC",
  "\u30D5\u30C3\u3000{\u6B63\u89E3|\u305B\u3044\u304B\u3044}\u3060\uFF01\\n\u306A\u304B\u306A\u304B\u3069\u3046\u3057\u3066\u3000{\u5C0F\u8CE2|\u3053\u3056\u304B}\u3057\u3044\\r\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306E{\u4E88\u7FD2|\u3088\u3057\u3085\u3046}\u3082\u3000\u30D0\u30C3\u30C1\u30EA\u3060\u306A[VAR 0114(0027)]",
  "\u2026\u2026{\u4E0D\u6B63\u89E3|\u3075\u305B\u3044\u304B\u3044}\uFF01\u3000{\u611B|\u3042\u3044}\u3089\u3057\u3044\u3000{\u7B54|\u3053\u305F}\u3048\u3060\u304C\\n{\u7720|\u306D\u3080}\u308B\u3068\u3044\u3046\u3000{\u8A00\u8449|\u3053\u3068\u3070}\u306B\u3000{\u5F15|\u3072}\u3063\u3071\u3089\u308C\u305F\u304B\uFF1F\\r\\n{\u6B63\u89E3|\u305B\u3044\u304B\u3044}\u306F\u3000{\u8CA1\u5B9D|\u3056\u3044\u307B\u3046}\u3060\u3088[VAR 0114(0027)]",
  "\u2026\u2026{\u4E0D\u6B63\u89E3|\u3075\u305B\u3044\u304B\u3044}\uFF01\u3000{\u8208\u5473\u6DF1|\u304D\u3087\u3046\u307F\u3076\u304B}\u3044\u3000{\u7B54|\u3053\u305F}\u3048\u3060\u304C\\n{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3042\u3063\u305F\u3089\u3000\u30AA\u30FC\u30D1\u30FC\u30C4\u3082\u306E\u3060\\r\\n{\u6B63\u89E3|\u305B\u3044\u304B\u3044}\u306F\u3000{\u8CA1\u5B9D|\u3056\u3044\u307B\u3046}\u3060\u3088[VAR 0114(0027)]",
  "\u305D\u3046\uFF01\u3000{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u306E\u3000{\u5965\u5E95|\u304A\u304F\u305D\u3053}\u306B\u306F\\n\u3053\u306E{\u4E16|\u3088}\u306E\u3000\u3059\u3079\u3066\u306E{\u7269|\u3082\u306E}\u3088\u308A\u3000{\u4FA1\u5024|\u304B\u3061}\u304C\u3042\u308B\\r\\n{\u8CA1\u5B9D|\u3056\u3044\u307B\u3046}\u304C\u3000{\u7720|\u306D\u3080}\u308B\u3068\u3000{\u4FE1|\u3057\u3093}\u3058\u3089\u308C\u3066\u3044\u305F\u306E\u3060\uFF01[VAR 0114(0027)]",
  "{\u4ECA|\u3044\u307E}\u3067\u306F\u3000{\u7814\u7A76\u6240|\u3051\u3093\u304D\u3085\u3046\u3058\u3087}\u304C\u3000{\u5EFA|\u305F}\u3063\u3066\u304A\u308A\\n\u30ED\u30DE\u30F3\u3082\u3000\u3078\u3063\u305F\u304F\u308C\u3082\u3000\u306A\u3044\u304C\u306D\u2026\u2026[VAR 0114(0027)]",
  "\u2026\u2026\u3042\u3042\u3000{\u4E00\u5FDC|\u3044\u3061\u304A\u3046}\u3000{\u8A00|\u3044}\u3063\u3066\u304A\u304F\u304C\\n\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u3000\u304A\u3088\u3073\u3000\u30A8\u30EA\u30A2\u30BC\u30ED\u306F\\r\\n{\u95A2\u4FC2\u8005\u4EE5\u5916|\u304B\u3093\u3051\u3044\u3057\u3083\u3044\u304C\u3044}\u3000{\u7ACB|\u305F}\u3061{\u5165|\u3044}\u308A{\u7981\u6B62|\u304D\u3093\u3057}\u3060[VAR 0114(0027)]",
  "{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u3060\u3000\u30A6\u30C3\u30D2\u30E7\u30FC\uFF01\\c\\n\u2026\u2026\u306A\u3069\u3068\u3044\u3046\u3000\u305F\u308F\u3051\u305F{\u614B\u5EA6|\u305F\u3044\u3069}\u3067\\n{\u8DB3|\u3042\u3057}\u3092\u3000{\u8E0F|\u3075}\u307F{\u5165|\u3044}\u308C\u306A\u3044\u3088\u3046\u306B[VAR 0114(0027)]",
  "{\u53EF\u80FD|\u304B\u306E\u3046}\u306A\u3089\u3000\u30EF\u30BF\u30B7\u304C\u3000{\u4E00\u76EE\u6563|\u3044\u3061\u3082\u304F\u3055\u3093}\u306B\\n{\u8ABF|\u3057\u3089}\u3079\u306B\u3000{\u884C|\u3044}\u304D\u305F\u3044\u306E\u3060\u304B\u3089\u2026\u2026\uFF01\uFF01[VAR 0114(0027)]",
  "\u2026\u2026\u304A\u3084\uFF1F\u3000{\u8A71|\u306F\u306A}\u3057\u3059\u304E\u305F\u304B\\n{\u6642\u8A08|\u3068\u3051\u3044}\u304C\u3000{\u9032|\u3059\u3059}\u307F\u3059\u304E\u305F\u3088\u3046\u3060[VAR 0114(0027)]",
