[
  "\u3088\u3046\u3000{\u5144|\u306B\u3044}\u3061\u3083\u3093\\n\u30DD\u30B1\u30E2\u30F3\u3000{\u5F37|\u3064\u3088}\u305D\u3046\u3060\u306A",
  "\u3088\u3046\u3000{\u59C9|\u306D\u3048}\u3061\u3083\u3093\\n\u30DD\u30B1\u30E2\u30F3\u3000{\u5F37|\u3064\u3088}\u305D\u3046\u3060\u306A",
  "\u3042\u3093\u305F\u306A\u3089\\n\u30AD\u30BF\u30AB\u30DF{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u3092\u3000{\u5012|\u305F\u304A}\u305B\u308B\u304B\u3082\u306A",
  "\u30AD\u30BF\u30AB\u30DF{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\uFF1F",
  "{\u8AB0|\u3060\u308C}\u3067\u3059\u304B\uFF1F",
  "\u30AD\u30BF\u30AB\u30DF{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u306F\\n{\u6751|\u3080\u3089}\u306E{\u5916|\u305D\u3068}\u306B\u3000{\u51FA\u6CA1|\u3057\u3085\u3064\u307C\u3064}\u3059\u308B\\r\\n{\u9B3C|\u304A\u306B}\u306E{\u9762|\u3081\u3093}\u3092\u3000\u304B\u3076\u3063\u305F\u3000{\u5F37|\u3064\u3088}\u3044\u30C8\u30EC\u30FC\u30CA\u30FC\u3060",
  "\u305D\u3044\u3064\u3089\u306F\u3000{\u5F37|\u3064\u3088}\u3044{\u5B50|\u3053}\u304C\u3000{\u5927\u597D|\u3060\u3044\u3059}\u304D\u3067\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3092\u3000{\u5FC3\u5F85|\u3053\u3053\u308D\u307E}\u3061\u306B\u3000\u3057\u3066\u3044\u308B\u305C",
  "\u30AD\u30BF\u30AB\u30DF{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u306F\\n\uFF17{\u4EBA|\u306B\u3093}\u3000\u3044\u308B\u3063\u3066\u3000{\u5642|\u3046\u308F\u3055}\u306A\u3093\u3060\u304C\u2026\u2026",
  "{\u6226|\u305F\u305F\u304B}\u3046\u306A\u3089\u3000{\u6CE8\u610F|\u3061\u3085\u3046\u3044}\u3057\u308D\u3088\\n\u3084\u3064\u3089\u3000{\u4E00\u7B4B\u7E04|\u3072\u3068\u3059\u3058\u306A\u308F}\u3067\u306F\u3000\u3044\u304B\u306A\u3044\u305C\\r\\n\uFF11{\u4EBA|\u308A}\u306B\u3000{\u52DD|\u304B}\u3064\u3054\u3068\u306B\u3000\u30A4\u30A4\u30E2\u30CE\u3000\u3084\u308B\u3088",
  "{\u5642|\u3046\u308F\u3055}\u306F\u3000{\u805E|\u304D}\u3044\u3066\u308B\u305C\\n{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u306B\u3000{\u52DD|\u304B}\u3063\u305F\u307F\u305F\u3044\u3060\u306A\\r\\n{\u7D04\u675F\u901A|\u3084\u304F\u305D\u304F\u3069\u304A}\u308A\u3000\u30A4\u30A4\u30E2\u30CE\u3000\u3084\u308B\u305C",
  "{\u5642|\u3046\u308F\u3055}\u306F\u3000{\u805E|\u304D}\u3044\u3066\u308B\u305C\\n{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u306B\u3000{\u52DD|\u304B}\u3063\u305F\u307F\u305F\u3044\u3060\u306A\\r\\n{\u7D04\u675F\u901A|\u3084\u304F\u305D\u304F\u3069\u304A}\u308A\u3000\u30A4\u30A4\u30E2\u30CE\u3000\u3084\u308B\u305C",
  "{\u6B8B|\u306E\u3053}\u308A\u306E{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u306F\u3000\uFF11{\u4EBA|\u308A}\u3060\u2026\u2026\\n{\u5834\u6240|\u3070\u3057\u3087}\u306E\u30D2\u30F3\u30C8\u3092\u3000{\u805E|\u304D}\u304F\u304B\u3044\uFF1F",
  "{\u6B8B|\u306E\u3053}\u308A\u306E{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u306F\u3000[VAR 0200(0001)]{\u4EBA|\u306B\u3093}\u3060\u2026\u2026\\n{\u5834\u6240|\u3070\u3057\u3087}\u306E\u30D2\u30F3\u30C8\u3092\u3000{\u805E|\u304D}\u304F\u304B\u3044\uFF1F",
  "{\u9B3C|\u304A\u306B}\u304C{\u5C71|\u3084\u307E}\u3088\u308A\u3000{\u9752|\u3042\u304A}\u306E{\u65B9\u89D2|\u307B\u3046\u304C\u304F}\\n{\u7AF9\u6797|\u3061\u304F\u308A\u3093}\u306E{\u4E2D|\u306A\u304B}\u306B\u3000{\u6211|\u308F\u308C}\u306F\u3042\u308A",
  "{\u9B3C|\u304A\u306B}\u306E{\u89D2|\u3064\u306E}\u3000{\u9060\u65B9|\u3048\u3093\u307D\u3046}\u3088\u308A\\n{\u81E8|\u306E\u305E}\u3080{\u5834\u6240|\u3070\u3057\u3087}\u3000{\u6211|\u308F\u308C}\u306F\u3042\u308A",
  "{\u9B3C|\u304A\u306B}\u306E{\u53E3|\u304F\u3061}\u3088\u308A\u3000{\u6D41|\u306A\u304C}\u308C\u308B{\u6C34|\u307F\u305A}\u306E\\n{\u508D|\u304B\u305F\u308F}\u3089\u306E{\u72ED\u9593|\u306F\u3056\u307E}\u306B\u3000{\u6211|\u308F\u308C}\u306F\u3042\u308A",
  "{\u5730\u7344|\u3058\u3054\u304F}\u3068{\u697D\u571F|\u3089\u304F\u3069}\u3000\u3044\u305A\u308C\u3082\u3000{\u9078|\u3048\u3089}\u3079\u308B\\n{\u6C60|\u3044\u3051}\u306E\u307B\u3068\u308A\u306B\u3000{\u6211|\u308F\u308C}\u306F\u3042\u308A",
  "{\u82E6|\u304F\u308B}\u3057\u307E\u306C{\u571F\u5730|\u3068\u3061}\\n{\u5947\u5CA9|\u304D\u304C\u3093}\u306E{\u8352\u91CE|\u3053\u3046\u3084}\u306B\u3000{\u6211|\u308F\u308C}\u306F\u3042\u308A",
  "{\u9B3C|\u304A\u306B}\u306E{\u89D2|\u3064\u306E}\u3000{\u9577|\u306A\u304C}\u304F\u306A\u304D\u307B\u3046\\n{\u8DB3\u5834|\u3042\u3057\u3070}\u306B\u3057\u3066\u3000{\u6211|\u308F\u308C}\u306F\u3042\u308A",
  "{\u591C\u77E5|\u3088\u308B\u3057}\u3089\u306C{\u6C60|\u3044\u3051}\u3000{\u508D|\u304B\u305F\u308F}\u3089\u306E{\u7A74|\u3042\u306A}\\n{\u843D|\u304A}\u3061\u308C\u3070\u3000{\u6211|\u308F\u308C}\u306F\u3042\u308A",
  "\u3053\u308C\u3067\u2026\u2026\u3000{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u306F\\n\uFF11{\u4EBA\u6B8B|\u308A\u306E\u3053}\u3089\u305A\u3000{\u5012|\u305F\u304A}\u3057\u305F\u307F\u305F\u3044\u3060\u306A",
  "\u3042\u3093\u305F\u307B\u3069\u3000{\u5F37|\u3064\u3088}\u3044\u3084\u3064\u306A\u3089\\n\u3088\u3046\u3084\u304F\u3000{\u672C\u6C17|\u307B\u3093\u304D}\u3092\u3000{\u51FA|\u3060}\u305B\u305D\u3046\u3060\u2026\u2026",
  "\u30CF\u30C3\uFF01\uFF01",
  "{\u67D0|\u305D\u308C\u304C\u3057}\u306F\u3000{\u552F\u4E00|\u3086\u3044\u3044\u3064}\u306E\\n{\u88CF|\u3046\u3089}\u30AD\u30BF\u30AB\u30DF{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u2026\u2026",
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u306E{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u308B\u3086\u3048\\n{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u304C\u3000{\u51FA\u6765\u6B21\u7B2C|\u3067\u304D\u3057\u3060\u3044}\\r\\n{\u77E5|\u3057}\u3089\u305B\u308B\u304C\u3000\u3088\u3044",
  "{\u67D0|\u305D\u308C\u304C\u3057}\u3068\u306E\u3000{\u6700\u5F8C|\u3055\u3044\u3054}\u306E{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u2026\u2026\\n{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u306F\u3000{\u6EDE|\u3068\u3069\u3053\u304A}\u308A\u306A\u3044\u304B\uFF1F",
  "\u2026\u2026{\u51FA|\u3067}\u306A\u304A\u3057\u3066\u307E\u3044\u308C",
  "\u3075\u3055\u308F\u3057\u304D{\u5834\u6240|\u3070\u3057\u3087}\u3078\u3000{\u79FB|\u3046\u3064}\u308B\u305E\\n\u2026\u2026\u3064\u3044\u3066\u307E\u3044\u308C",
  "{\u88CF|\u3046\u3089}\u30AD\u30BF\u30AB\u30DF{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u3000\u30E0\u30E9\u30DE\u30B5\uFF01\\n\u3044\u3056\u2026\u2026\u3000{\u53C2|\u307E\u3044}\u308B\uFF01",
  "\u30AB\u30C3\u30AB\u30C3\u30AB\uFF01\u3000\u307E\u3055\u304B\\n{\u67D0|\u305D\u308C\u304C\u3057}\u307E\u3067\u3000{\u5012|\u305F\u304A}\u3057\u3066\u3057\u307E\u3046\u3068\u306F\uFF01\\r\\n\u305D\u306E{\u529B|\u3061\u304B\u3089}\u3000\u307B\u3081\u3066\u3064\u304B\u308F\u305D\u3046\u305E\uFF01",
  "\u2026\u2026\u2026\u2026\u3000\u2026\u2026\u2026\u2026\\n\u2026\u2026\u2026\u2026\u3000\u2026\u2026\u2026\u2026",
  "\u2026\u2026\u306A\u3093\u3061\u3083\u3063\u3066\u306D\uFF01\\n\u304A{\u75B2|\u3064\u304B}\u308C\u3055\u307E\uFF01",
  "{\u904A|\u3042\u305D}\u3093\u3067\u3082\u3089\u3063\u305F\u3000{\u9B3C\u9762\u8846|\u304D\u3081\u3093\u3057\u3085\u3046}\u30A4\u30D9\u30F3\u30C8\uFF01\\n{\u5B50\u4F9B|\u3053\u3069\u3082}\u305F\u3061\u306E\u3000{\u8DB3\u8170|\u3042\u3057\u3053\u3057}\u3092\u3000{\u935B|\u304D\u305F}\u3048\u305F\u308A\\r\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u306E{\u697D|\u305F\u306E}\u3057\u3055\u3092\u3000{\u6559|\u304A\u3057}\u3048\u308B\u305F\u3081\u306E\u3000{\u4F01\u753B|\u304D\u304B\u304F}\u3067\u3055",
  "{\u6BCE\u5E74|\u307E\u3044\u3068\u3057}\u3000\u30AA\u30E2\u30C6{\u796D|\u307E\u3064}\u308A\u306E\u3000{\u6642\u671F|\u3058\u304D}\u306B\\n\u3084\u3063\u3066\u306F\u3000\u3044\u308B\u3082\u306E\u306E\u2026\u2026",
  "\u30B9\u30BF\u30C3\u30D5\u304C\u3000{\u672C\u6C17|\u307B\u3093\u304D}\u3000{\u51FA|\u3060}\u3057\u3059\u304E\u3061\u3083\u3063\u3066\\n\u30AF\u30EA\u30A2\u3067\u304D\u308B{\u5B50|\u3053}\u3000\u3044\u306A\u304B\u3063\u305F\u3093\u3060\u3088\u306A\uFF01",
  "\u30AA\u30EC\u307E\u3067\u3000{\u5012|\u305F\u304A}\u305B\u305F\u306E\u3000{\u591A\u5206|\u305F\u3076\u3093}\\n\u3042\u3093\u305F\u304C\u3000{\u521D|\u306F\u3058}\u3081\u3066\u3060\u305C\uFF01",
  "\u3063\u3066\u306A\u308F\u3051\u3067\u3000\u304A\u3081\u3067\u3068\u3046\uFF01\\n{\u8CDE\u54C1|\u3057\u3087\u3046\u3072\u3093}\u3092\u3000\u304F\u308C\u3066\u3084\u308D\u3046\uFF01\uFF01",
  "\u3053\u308C\u304B\u3089\u3082\u3000\u30AD\u30BF\u30AB\u30DF\u306E\u3000{\u81EA\u7136|\u3057\u305C\u3093}\u306E{\u4E2D|\u306A\u304B}\u3067\\n{\u5F37|\u3064\u3088}\u304F\u3000{\u5927|\u304A\u304A}\u304D\u304F\u3000{\u80B2|\u305D\u3060}\u3063\u3066\u304F\u308C\u3088\u306A\uFF01",
  "\u304A\u304A\u3000{\u5F37|\u3064\u3088}\u304D{\u5B50|\u3053}\u3088\uFF01\\n{\u67D0|\u305D\u308C\u304C\u3057}\u306B\u3000{\u4F1A|\u3042}\u3044\u306B\u304D\u305F\u306E\u304B\uFF01\\r\\n\u30AB\u30C3\u30AB\u30C3\u30AB\u3000{\u6109\u5FEB|\u3086\u304B\u3044}\u3084\u3000{\u6109\u5FEB|\u3086\u304B\u3044}"
]
