  "\u30D1\u30EB\u30C7\u30A2\u30A8\u30B9\u30C6\u30FC\u30C8\u3000{\u793E\u9577|\u3057\u3083\u3061\u3087\u3046}\u3000\u30CD\u30A2\uFF01\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u3092\u3000\u3076\u3063\u3064\u3076\u3059\u30B6\u30DE\u30B9\u3088\u3049\u3049\u3049\uFF01[VAR 0114(0041)]",
  "\u3072\u3085\u30FC\u3000\u3072\u3085\u30FC\uFF01\\n\u304C\u3093\u3070\u3063\u3066\u306D\u3000\u30CD\u30A2\u3061\u3083\u3093\uFF01[VAR 0114(0040)]",
  "\u3042\u306A\u305F\u3000\u3059\u3054\u3044\u30B6\u30DE\u30B9\uFF01\\n\u3068\u3066\u3064\u3082\u306A\u3044{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u3000\u3060\u308F\uFF01[VAR 0114(0041)]",
  "\u3072\u3085\u30FC\u3000\u3072\u3085\u30FC\uFF01\\n\u30CD\u30A2\u3061\u3083\u3093\u3000{\u8CA0|\u307E}\u3051\u3066\u3082\u3000\u304B\u308F\u3044\u3044\u3088\uFF01[VAR 0114(0040)]",
  "{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u3088\u3000\u3044\u3044\u30B6\u30DE\u30B9\u304B\uFF1F\\n\u304A{\u91D1|\u304B\u306D}\u306F\u3000\u3069\u3046{\u4F7F|\u3064\u304B}\u3046\u304B\u304C\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u30B6\u30DE\u30B9[VAR 0114(0041)]",
  "{\u5148|\u3055\u304D}\u307B\u3069\u306E\u3000{\u8CDE\u91D1|\u3057\u3087\u3046\u304D\u3093}\u306F\\n{\u4EBA\u751F|\u3058\u3093\u305B\u3044}\u306B\u3000{\u6709\u610F\u7FA9|\u3086\u3046\u3044\u304E}\u306A\u3082\u306E\u2026\u2026\\r\\n{\u81EA\u5206|\u3058\u3076\u3093}\u3078\u306E{\u6295\u8CC7|\u3068\u3046\u3057}\u3000\u3068\u3057\u3066\u3000{\u4F7F|\u3064\u304B}\u3046\u30B6\u30DE\u30B9\u3088[VAR 0114(0041)]",
  "\u305D\u3046\u3059\u308C\u3070\u3000\u304A{\u91D1|\u304B\u306D}\u306F\u3000\u306A\u304F\u306A\u3063\u3066\u3082\\n{\u8CA1\u7523|\u3056\u3044\u3055\u3093}\u3068\u3057\u3066\u3000\u304B\u304C\u3084\u304D{\u7D9A|\u3064\u3065}\u3051\u308B\u30B6\u30DE\u30B9[VAR 0114(0041)]",
  "\u3055\u3066\u3000\u30D3\u30EA\u30AA\uFF01\\n\u3042\u305F\u304F\u3057\u3000{\u4ECA|\u3044\u307E}\u3059\u3050\u3000\u30D1\u30EB\u30C7\u30A2\u306E\\r\\n[VAR FF00(0006)]\u3042\u306E{\u6EDD|\u305F\u304D}[VAR FF00(0000)]\u3092\u3000{\u898B|\u307F}\u306B\u3044\u304D\u305F\u3044\u30B6\u30DE\u30B9\uFF01[VAR 0114(0041)]",
  "\u3072\u3085\u30FC\uFF01\u3000\u30AD\u30BF\u30AB\u30DF\u306B\\n{\u6765|\u304D}\u305F\u3070\u3063\u304B\u308A\u3067\u3000\u3082\u3046{\u5E30|\u304B\u3048}\u308B\uFF01\\r\\n\u30CD\u30A2\u3061\u3083\u3093\u3000\u30BB\u30EC\u30D6\u306E{\u9451|\u304B\u304C\u307F}\u3060\u306D\uFF01[VAR 0114(0040)]",
  "\u3042\u3042\u3000\u30CD\u30A2\u3055\u307E\u3000\u30D3\u30EA\u30AA\u3055\u307E\\n\u3069\u3061\u3089\u3078\u3000{\u884C|\u3044}\u3063\u3066\u3057\u307E\u308F\u308C\u305F\u306E\u3067\u3057\u3087\u3046\uFF1F",
  "{\u7F8E|\u3046\u3064\u304F}\u3057\u3044{\u7530\u5712|\u3067\u3093\u3048\u3093}\u3092\\n{\u898B\u6E21|\u307F\u308F\u305F}\u305B\u308B{\u5834\u6240|\u3070\u3057\u3087}\u3078\u3000{\u884C|\u3044}\u304F\u30B6\u30DE\u30B9\uFF01\\c\\n\u2026\u2026\u306A\u3069\u3068\u3000\u304A\u3063\u3057\u3083\u3063\u3066\u3044\u307E\u3057\u305F\u304C\\n\u3044\u3063\u305F\u3044\u3000\u305D\u308C\u306F\u3000{\u4F55\u51E6|\u3044\u305A\u3053}\uFF1F"
