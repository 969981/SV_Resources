[
  "\u30AA\u30FC\u30C3\u30DB\u30C3\u30DB\u30C3\u30DB\uFF01\\n\u30AA\u30FC\u30C3\u30DB\u30C3\u30DB\u30C3\u30DB\uFF01[VAR 0114(002C)]",
