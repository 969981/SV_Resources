  "\u30CD\u30A2\u3061\u3083\u3093\uFF01\\n{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u3069\u3046\u3084\u3063\u3066\\r\\n{\u6642\u9593|\u3058\u304B\u3093}\u3068\u304A{\u91D1|\u304B\u306D}\u3092\u3000{\u6D6A\u8CBB|\u308D\u3046\u3072}\u3057\u3088\u3063\u304B\uFF01\uFF1F[VAR 0114(0040)]",
