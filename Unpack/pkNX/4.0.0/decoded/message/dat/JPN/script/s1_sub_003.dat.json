  "\u3055\u3059\u304C\u3000\u30CD\u30A2\u3061\u3083\u3093\uFF01\\n{\u7530\u820E|\u3044\u306A\u304B}\u306B\u3000{\u6765|\u304D}\u3066\u3082\u3000{\u767A\u60F3|\u306F\u3063\u305D\u3046}\u304C\u3000\u30B7\u30C6\u30A3\uFF01[VAR 0114(002C)]",
