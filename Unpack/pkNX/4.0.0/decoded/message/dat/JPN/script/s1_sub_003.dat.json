  "\u306D\u3048\u3000\u30D3\u30EA\u30AA\u2026\u2026\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u304C\u3000\u3053\u3063\u3061\u3092\u3000{\u898B|\u307F}\u3066\u308B\u2026\u2026[VAR 0114(0041)]",
  "\u3048\u3063\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u304C\uFF1F[VAR 0114(0040)]",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u3060\u3000\u3042\u308C\u306F\\n{\u9593\u9055|\u307E\u3061\u304C}\u3044\u306A\u304F\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u3060\u306D\uFF01[VAR 0114(0040)]",
