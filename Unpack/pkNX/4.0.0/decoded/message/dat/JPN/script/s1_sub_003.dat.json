  "\u3069\u3000\u3069\u3046\u3057\u307E\u3057\u3087\u3046\u3000\u30D3\u30EA\u30AA\uFF01\\n{\u63E1\u624B|\u3042\u304F\u3057\u3085}\u3000\u304A{\u9858|\u306D\u304C}\u3044\u3059\u308B\u306E\u306F\u3000\u30DE\u30CA\u30FC{\u9055\u53CD|\u3044\u306F\u3093}\uFF01\uFF1F\\r\\n\u30B5\u30A4\u30F3\u3000\u3082\u3089\u3063\u3066\u3082\u3000\u3044\u3044\u30B6\u30DE\u30B9\uFF01\uFF1F[VAR 0114(0041)]",
  "{\u843D|\u304A}\u3061{\u7740|\u3064}\u3044\u3066\u3000\u30CD\u30A2\u3061\u3083\u3093\uFF01\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306F\u3000{\u9003|\u306B}\u3052\u306A\u3044\u3088\uFF01[VAR 0114(0040)]",
  "\u3054\u3000\u3054\u3081\u3093\u306A\u3055\u3044\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306A\u3093\u3066\u3000\u3081\u3063\u305F\u306B\u3000{\u898B|\u307F}\u306A\u3044\u3057\u2026\u2026[VAR 0114(0041)]",
  "\u3057\u304B\u305F\u306A\u3044\u3088\u2026\u2026\\n\u30CD\u30A2\u3061\u3083\u3093\u306F\u3000{\u4E0D\u52D5\u7523\u4F1A\u793E|\u3075\u3069\u3046\u3055\u3093\u304C\u3044\u3057\u3083}\\r\\n\u30D1\u30EB\u30C7\u30A2\u30A8\u30B9\u30C6\u30FC\u30C8\u306E\u3000{\u793E\u9577|\u3057\u3083\u3061\u3087\u3046}\u3060\u3082\u3093[VAR 0114(0040)]",
  "\u3082\u3057\u3082\u3057\uFF1F\\n\u305D\u3053\u306E\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u304B\u305F[VAR 0114(0041)]",
  "\u3042\u305F\u304F\u3057\u3068\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n{\u6C7A\u95D8|\u3051\u3063\u3068\u3046}\u3092\u3000\u3057\u3066\u304F\u308C\u306A\u3044\u30B6\u30DE\u30B9\u304B\uFF1F[VAR 0114(0041)]",
  "\u3082\u3057\u3000\u3042\u305F\u304F\u3057\u306B\u3000{\u52DD|\u304B}\u3066\u305F\u3089\\n{\u5DE8\u4E07|\u304D\u3087\u307E\u3093}\u306E{\u5BCC|\u3068\u307F}\u3092\u3000{\u4E0E|\u3042\u305F}\u3048\u308B\u30B6\u30DE\u30B9\u3088[VAR 0114(0041)]",
  "\u3067\u2026\u2026\u3000\u3067\u305F\uFF01\\n\u30CD\u30A2\u3061\u3083\u3093\u306E{\u8DA3\u5473|\u3057\u3085\u307F}\uFF01[VAR 0114(0040)]",
  "{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306B\u3000\u30C1\u30E3\u30F3\u30B9\u3092\u3000{\u4E0E|\u3042\u305F}\u3048\u308B\u3084\u30FC\u3064\uFF01[VAR 0114(0040)]",
  "\u30DB\u30DB\u30DB\u2026\u2026\u3000{\u899A\u609F|\u304B\u304F\u3054}\u3092\u3000{\u6C7A|\u304D}\u3081\u305F\u3089\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u307B\u3046\u304B\u3089\u3000\u304A{\u8A98|\u3055\u305D}\u3044\u3042\u305D\u3070\u305B[VAR 0114(0041)]",
  "{\u5DE8\u4E07|\u304D\u3087\u307E\u3093}\u306E{\u5BCC|\u3068\u307F}\u304C\u3000{\u6B32|\u307B}\u3057\u3051\u308C\u3070\\n{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u3089\u3057\u304F\u3000\u30CD\u30A2\u3061\u3083\u3093\u306B\u3000{\u8A71|\u306F\u306A}\u3057\u304B\u3051\u306A\u3088\uFF01[VAR 0114(0040)]",
  "{\u5DE8\u4E07|\u304D\u3087\u307E\u3093}\u306E{\u5BCC|\u3068\u307F}\u3092\u3000\u304B\u3051\u3066\\n\u3042\u305F\u304F\u3057\u3068\u3000{\u6C7A\u95D8|\u3051\u3063\u3068\u3046}\u3059\u308B\u30B6\u30DE\u30B9\u306D\uFF1F[VAR 0114(0041)]",
