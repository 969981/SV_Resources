[
  "{\u706F\u53F0|\u3068\u3046\u3060\u3044}\u306E{\u4E0A|\u3046\u3048}\u306F\u3000{\u9759|\u3057\u305A}\u304B\u3060\u306A\\n\u30AB\u30A4\u30C7\u30F3\u3063\u3066\u3000\u30DD\u30B1\u30E2\u30F3\u3082\\r\\n\u305F\u307E\u306B\u3000{\u7FBD|\u306F\u306D}\u3092{\u4F11|\u3084\u3059}\u3081\u306B\u304F\u308B\u3088",
  "\u3053\u3053\u307E\u3067\u306E{\u5742\u9053|\u3055\u304B\u307F\u3061}\u3067\u3000\u30ED\u30C8\u30E0\u3000{\u898B|\u307F}\u305F\u3088\uFF01\\n\u30B9\u30DE\u30DB\u306B\u3000{\u5165|\u306F\u3044}\u3063\u3066\u306A\u3044\u3000{\u751F|\u306A\u307E}\u306E\u30ED\u30C8\u30E0\uFF01",
  "{\u6700\u5148\u7AEF|\u3055\u3044\u305B\u3093\u305F\u3093}\u306E{\u753A|\u307E\u3061}\u306E\\n\u3059\u3050{\u88CF|\u3046\u3089}\u306B\u3000{\u5927\u81EA\u7136|\u3060\u3044\u3057\u305C\u3093}\u3060\u306A\u3093\u3066\uFF01\\r\\n\u3084\u307E\u30AC\u30FC\u30EB{\u5FC3|\u3054\u3053\u308D}\u3000\u304F\u3059\u3050\u3089\u308C\u3061\u3083\u3046",
  "{\u4E0A|\u3046\u3048}\u304B\u3089\u3000{\u898B|\u307F}\u305F\u3089\u3000{\u5E02\u5834|\u3044\u3061\u3070}\u3082\\n\u3042\u3093\u306A\u306B\u3000{\u5C0F|\u3061}\u3063\u3061\u3083\u3044\u3084\uFF01",
  "\u3042\u306A\u305F\u3082\\n\u30ED\u30FC\u30B9\u30C8{\u7802\u6F20|\u3055\u3070\u304F}\u3092\u3000{\u8D8A|\u3053}\u3048\u3066\u304D\u305F\u306E\uFF1F\\r\\n\u306A\u3093\u304B\u3000{\u5909|\u3078\u3093}\u306A\u30DD\u30B1\u30E2\u30F3\u3000\u3044\u306A\u304B\u3063\u305F\uFF1F",
  "\u30AB\u30E9\u30D5\u30B7\u30C6\u30A3\u306B\u3000{\u623B|\u3082\u3069}\u308B\u306E\u306F\u3000\u3055\u3059\u304C\u306B\\n\u305D\u3089\u3068\u3076\u30BF\u30AF\u30B7\u30FC\u3000{\u4F7F|\u3064\u304B}\u3063\u3061\u3083\u304A\u3046\u304B\u306A",
  "{\u7AF6|\u305B}\u308A\u3067\u3000{\u5927\u91D1|\u305F\u3044\u304D\u3093}\u3000\u306F\u305F\u3044\u3061\u307E\u3063\u305F\u2026\u2026\\n{\u6F6E\u98A8|\u3057\u304A\u304B\u305C}\u304C\u3000{\u76EE|\u3081}\u306B\u3000\u3057\u307F\u308B\u305C\uFF01",
  "\u3071\u3063\u3074\u3071\u3063\u3074\u3000\u3082\u3063\u3061\u3082\u3063\u3061\uFF01\\n\u3093\u30FC\uFF01\u3000\u305D\u308C\u304C\u3000\u30D1\u30D4\u30E2\u30C3\u30C1\uFF01"
]
