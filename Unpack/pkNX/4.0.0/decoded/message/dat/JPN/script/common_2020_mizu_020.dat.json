[
  "\u304A{\u524D|\u307E\u3048}\u3055\u3093\u304C\u3000\u30EF\u30AB\u30E1\u3092\u3000{\u7AF6|\u305B}\u3063\u3066\u304F\u308C\u3066\u304B\u3089\\n\u3046\u3061\u306E\u3000\u30EF\u30AB\u30E1{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306F\u3000{\u5927\u4EBA\u6C17|\u3060\u3044\u306B\u3093\u304D}\uFF01[VAR 0114(0018)]",
  "\u3042\u306E\u3068\u304D\u306F\u3000\u3042\u308A\u304C\u3068\u3046\u306A\u3042\uFF01\\n\u3055\u3059\u304C\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306E{\u5668|\u3046\u3064\u308F}\u3060\u3044\uFF01[VAR 0114(0018)]",
  "\u3044\u3084\u306F\u3084\u3000\u3053\u3046\u3044\u3046{\u4ED5\u4E8B|\u3057\u3054\u3068}\u3000\u3057\u3066\u308B\u3068\\n\u3044\u308D\u3093\u306A{\u4EBA\u9593|\u306B\u3093\u3052\u3093}\u306B\u3000{\u4F1A|\u3042}\u3046\u3093\u3060\u306A\u3042[VAR 0114(0018)]",
  "\u304A{\u524D|\u307E\u3048}\u3055\u3093\u307F\u305F\u3044\u306B\\n{\u52E2|\u3044\u304D\u304A}\u3044\u3088\u304F\u3000{\u6D41|\u306A\u304C}\u308C\u308B{\u8005|\u3082\u306E}\u3082\u3000\u3044\u308C\u3070\\r\\n{\u505C\u6EDE|\u3066\u3044\u305F\u3044}\u3057\u3000\u3088\u3069\u3080{\u8005|\u3082\u306E}\u3082\u3000\u304A\u308B[VAR 0114(0018)]",
  "{\u5E74\u98DF|\u3068\u3057\u304F}\u3063\u305F{\u5927\u4EBA|\u304A\u3068\u306A}\u306F\\n{\u5F8C\u8005|\u3053\u3046\u3057\u3083}\u3092\u3000{\u671B|\u306E\u305E}\u307F\u304C\u3061\u3060\u304C\\r\\n\u30AA\u30A4\u30E9\u306B\u3083\u3042\u3000\u3061\u3087\u304A\u3063\u3068\u3000{\u9000\u5C48|\u305F\u3044\u304F\u3064}\u3060\u3044[VAR 0114(0018)]",
  "\u2026\u2026{\u5DDD|\u304B\u308F}\u306F{\u6D41|\u306A\u304C}\u308C\u3000{\u6D77|\u3046\u307F}\u3068\u306A\u308A\\n{\u96F2|\u304F\u3082}\u3078\u306E\u307C\u308A\u3000\u307E\u305F{\u96E8|\u3042\u3081}\u3068\u306A\u308B[VAR 0114(0018)]",
  "{\u5343\u5909\u4E07\u5316|\u305B\u3093\u307A\u3093\u3070\u3093\u304B}\u306E\u3000{\u6FC0\u6D41|\u3052\u304D\u308A\u3085\u3046}\u30CF\u30A4\u30C0\u30A4\uFF01\\n\u305D\u306E{\u8EAB|\u307F}\u3092\u3082\u3063\u3066\u3000{\u6E2C|\u306F\u304B}\u3063\u3066\u307F\u3066\u304F\u308C\u3044\uFF01[VAR 0114(0018)]",
  "\u30C8\u30C3\u30D7\u3082\u3000{\u8A8D|\u307F\u3068}\u3081\u308B\u3000\u305D\u306E{\u5727|\u3042\u3064}\u3088\uFF01\\n\u3055\u3059\u304C\u306B\u3000{\u5927\u6F01|\u305F\u3044\u308A\u3087\u3046}\u3060\u3044\u3000{\u5927\u6F01|\u305F\u3044\u308A\u3087\u3046}\u3060\u3044\uFF01[VAR 0114(0018)]",
  "{\u6FC0|\u306F\u3052}\u3057\u3059\u304E\u308B{\u6C34\u6D41|\u3059\u3044\u308A\u3085\u3046}\u306F\\n{\u826F|\u3088}\u304F\u3082{\u60AA|\u308F\u308B}\u304F\u3082\u3000{\u5468\u56F2|\u3057\u3085\u3046\u3044}\u3092\u3000\u307E\u304D\u3053\u307F\\r\\n{\u591A\u5927|\u305F\u3060\u3044}\u306A{\u5F71\u97FF|\u3048\u3044\u304D\u3087\u3046}\u3092\u3000\u3082\u305F\u3089\u3059\u3060\u308D\u3046\uFF01[VAR 0114(0018)]",
  "\u306A\u304A{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000\u3044\u3066\u304F\u308C\u308B\u3000{\u53CB\u4EBA|\u3086\u3046\u3058\u3093}\u306F\\n\u304A{\u524D|\u307E\u3048}\u3055\u3093\u306B\u3068\u3063\u3066\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u306A{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u3060\u306A[VAR 0114(0018)]",
  "{\u82E5|\u308F\u304B}\u3044{\u529B|\u3061\u304B\u3089}\u306B\u3000\u3042\u3066\u3089\u308C\u3066\\n\u304A\u3058\u3055\u3093\u3000\u3084\u308B{\u6C17|\u304D}\u304C\u3000{\u9244\u7832\u6C34|\u3066\u3063\u307D\u3046\u307F\u305A}\uFF01[VAR 0114(0018)]",
  "\u30AA\u30E2\u30C0\u30AB{\u5B22|\u3058\u3087\u3046}\u306B\u3000{\u4F1D|\u3064\u305F}\u3048\u3066\u304A\u3044\u3066\u304F\u308C\uFF01\\n\u30CF\u30A4\u30C0\u30A4\u306F\u3000\u3088\u308A{\u6FC0|\u306F\u3052}\u3057\u304F\u3000{\u5909\u5316|\u3078\u3093\u304B}\u3059\u308B\u2026\u2026\u3000\u3068\uFF01[VAR 0114(0018)]",
  "{\u983C|\u305F\u306E}\u3093\u3060\u305E\u3000{\u82E5\u8005|\u308F\u304B\u3082\u306E}\u3088\uFF01\\n\u307E\u305F\u306E\u3054{\u6765\u5E97|\u3089\u3044\u3066\u3093}\u3092\u3000\u304A{\u5F85|\u307E}\u3061\u3057\u3068\u308B\u304B\u3089\u306A\uFF01[VAR 0114(0018)]"
]
