[
  "[VAR 0100(0000)]\u306F\u3000\u30B7\u30F3\u30AF\u30ED\u30DF\u304B\u3089\\n[VAR 0204(0001,0000)]\uFF22\uFF30\u3000\u3082\u3089\u3063\u305F\uFF01",
  "\u3046\u3046\u30FC\u3093\u3000\u30B7\u30F3\u30AF\u30ED\u30FC\uFF01[VAR 0114(002C)]",
  "\u2026\u2026\u30CF\u30C3\uFF01\\n\u308F\u305F\u3057\u306F\u3000\u3059\u3054\u3044{\u7814\u7A76\u54E1|\u3051\u3093\u304D\u3085\u3046\u3044\u3093}\\r\\n{\u540D\u524D|\u306A\u307E\u3048}\u306F\u3000\u30B7\u30F3\u30AF\u30ED\u30DF\uFF01[VAR 0114(004E)]",
  "\u3059\u3054\u3044{\u5B9F\u9A13|\u3058\u3063\u3051\u3093}\u306E\u3000\u30E2\u30CB\u30BF\u30FC\u3068\u3057\u3066\\n\u3042\u306A\u305F\u3000\u304A{\u624B\u4F1D|\u3066\u3064\u3060}\u3044\u3000\u3057\u3066\u307F\u306A\u3044\uFF1F[VAR 0114(004E)]",
  "{\u4E16\u7D00|\u305B\u3044\u304D}\u306E{\u5927\u767A\u898B|\u3060\u3044\u306F\u3063\u3051\u3093}\u2026\u2026\\n\u305D\u306E{\u76EE\u6483\u8005|\u3082\u304F\u3052\u304D\u3057\u3083}\u306B\u3000\u306A\u308C\u308B\u3068\u3044\u3046\u306E\u306B\uFF01\uFF1F[VAR 0114(004E)]",
  "[~ 31]",
  "\u305D\u3046\u3053\u306A\u304F\u3063\u3061\u3083\uFF01\\n{\u5B9F\u9A13|\u3058\u3063\u3051\u3093}{\u5834\u6240|\u3070\u3057\u3087}\u306B\u3000{\u79FB\u52D5|\u3044\u3069\u3046}\u3059\u308B\u308F\u306D\uFF01[VAR 0114(004E)]",
  "{\u4ECA|\u3044\u307E}\u304B\u3089\u3000\u304A\u3053\u306A\u3046{\u5B9F\u9A13|\u3058\u3063\u3051\u3093}\u306F\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000\u3064\u308C{\u6B69|\u3042\u308B}\u3044\u3066\u306A\u3044\u3068\u3000\u3044\u3051\u306A\u3044\u306E[VAR 0114(004E)]",
  "{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u304C\u3000\u3067\u304D\u305F\u3089\\n{\u58F0|\u3053\u3048}\u3092\u3000\u304B\u3051\u3066\u3088\u306D\uFF01[VAR 0114(004E)]",
  "\u3059\u3054\u3044{\u5B9F\u9A13|\u3058\u3063\u3051\u3093}\u306E\u3000\u30E2\u30CB\u30BF\u30FC\u3068\u3057\u3066\\n\u304A{\u624B\u4F1D|\u3066\u3064\u3060}\u3044\u3000\u3067\u304D\u305D\u3046\uFF1F[VAR 0114(004E)]",
  "\u305D\u3046\u3053\u306A\u304F\u3063\u3061\u3083\uFF01\\n\u3058\u3083\u3000\u3055\u3063\u305D\u304F\u2026\u2026\\r\\n\u30B7\u30F3\u30AF\u30ED\u3000\u30B7\u30F3\u30AF\u30ED\u30FC\uFF01[VAR 0114(004E)]",
  "\u3042\u306A\u305F\u306F\u3000{\u4ECA|\u3044\u307E}\u3000\u30DD\u30B1\u30E2\u30F3\u3068\\n{\u6C17\u6301|\u304D\u3082}\u3061\u304C\u3000\u30B7\u30F3\u30AF\u30ED\u3057\u3066\u3044\u307E\u3059\uFF01[VAR 0114(004E)]",
  "\u30B7\u30F3\u30AF\u30ED\u3057\u3066\u308B\u304B\u3089\u3000\u3042\u306A\u305F\u304C\\n{\u601D|\u304A\u3082}\u3046\u3068\u304A\u308A\u306B\u3000\u30DD\u30B1\u30E2\u30F3\u3082\u3000{\u52D5|\u3046\u3054}\u304F\u308F\uFF01[VAR 0114(004E)]",
  "\u305D\u308C\u3058\u3083\u3000{\u6B69\u884C|\u307B\u3053\u3046}\u30C6\u30B9\u30C8\u304B\u3089\uFF01\\n{\u5411|\u3080}\u3053\u3046\u306E{\u6728|\u304D}\u307E\u3067\u3000{\u79FB\u52D5|\u3044\u3069\u3046}\u3057\u3066\u307F\u3066\uFF01[VAR 0114(004E)]",
  "\u3046\u3046\u30FC\u3093\uFF01\u3000\u3042\u306A\u305F\u3063\u3066\\n\u3068\u3063\u3066\u3082\u3000\u30B7\u30F3\u30AF\u30ED\u30CB\u30B7\u30C6\u30A3\uFF01[VAR 0114(004E)]",
  "\u3044\u3044\u30C7\u30FC\u30BF\u304C\u3000\u3068\u308C\u305F\u308F\u3000\u3042\u308A\u304C\u3068\u3046\uFF01\\n\u3053\u308C\u2026\u2026\u3000{\u7C97\u54C1|\u305D\u3057\u306A}\u3088\uFF01[VAR 0114(004E)]",
  "\u3042\u306A\u305F\u3000\u3068\u3063\u3066\u3082\u3000{\u7B4B|\u3059\u3058}\u304C\u3044\u3044\u304B\u3089\\n\u3082\u3046\uFF11{\u56DE|\u304B\u3044}\u3060\u3051\u3000\u3064\u304D\u3042\u3063\u3066\u3061\u3087\u3046\u3060\u3044\uFF01[VAR 0114(004E)]",
  "{\u6B21|\u3064\u304E}\u306E{\u5B9F\u9A13|\u3058\u3063\u3051\u3093}\u306F\u3000\u3061\u3087\u3063\u3074\u308A\u3000{\u5927\u5909|\u305F\u3044\u3078\u3093}\u3060\u304B\u3089\\n{\u7C97\u54C1|\u305D\u3057\u306A}\u3058\u3083\u306A\u304F\u3000\u3059\u3063\u3054\u3044\u306E\u3000\u3042\u3052\u308B\u308F\u3088\uFF01[VAR 0114(004E)]",
  "\u3059\u3054\u3044{\u5B9F\u9A13|\u3058\u3063\u3051\u3093}\u306E\u3000\u30E2\u30CB\u30BF\u30FC\u3068\u3057\u3066\\n\u304A{\u624B\u4F1D|\u3066\u3064\u3060}\u3044\u3059\u308B{\u6C17|\u304D}\u306B\u3000\u306A\u3063\u3061\u3083\u3063\u305F\uFF1F[VAR 0114(004E)]",
  "{\u4E16\u7D00|\u305B\u3044\u304D}\u306E{\u5927|\u3060\u3044}\u30FB{\u5927\u767A\u898B|\u3060\u3044\u306F\u3063\u3051\u3093}\u2026\u2026\\n\u30D1\u30A4\u30AA\u30CB\u30A2\u306B\u3000\u306A\u308C\u308B\u3068\u3044\u3046\u306E\u306B\uFF01\uFF1F[VAR 0114(004E)]",
  "\u3058\u3083\u3000\u3044\u304F\u308F\u3088\u30FC\uFF01\\n\u30B7\u30F3\u30AF\u30ED\u3000\u30B7\u30F3\u30AF\u30ED\u30FC\uFF01[VAR 0114(004E)]",
  "\u3042\u306A\u305F\u306F\u3000\u3075\u305F\u305F\u3073\u3000\u30DD\u30B1\u30E2\u30F3\u3068\\n{\u6C17\u6301|\u304D\u3082}\u3061\u304C\u3000\u30B7\u30F3\u30AF\u30ED\u3057\u3066\u3044\u307E\u3059\uFF01[VAR 0114(004E)]",
  "\u30B7\u30F3\u30AF\u30ED\u3082\u3000\uFF12{\u56DE\u76EE|\u304B\u3044\u3081}\u3068\u3082\u3000\u306A\u308C\u3070\\n\u3044\u308D\u3093\u306A{\u884C\u52D5|\u3053\u3046\u3069\u3046}\u304C\u3000\u3067\u304D\u308B\u306F\u305A\u3088\uFF01[VAR 0114(004E)]",
  "\u305D\u308C\u3058\u3083\u3000{\u6226\u95D8|\u305B\u3093\u3068\u3046}\u30C6\u30B9\u30C8\u3000{\u958B\u59CB|\u304B\u3044\u3057}\uFF01\\n\u305D\u306E{\u72B6\u614B|\u3058\u3087\u3046\u305F\u3044}\u3067\u3000\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u6226|\u305F\u305F\u304B}\u3063\u3066\u307F\u3066\uFF01[VAR 0114(004E)]",
  "\u3046\u3046\u30FC\u3093\uFF01\u3000\u3042\u306A\u305F\u3063\u3066\\n{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\u306B\u3000\u30B7\u30F3\u30AF\u30ED\u30CB\u30B7\u30C6\u30A3\uFF01[VAR 0114(004E)]",
  "\u3042\u306A\u305F\u307B\u3069\u306E\u3000{\u9038\u6750|\u3044\u3064\u3056\u3044}\u306B\u306A\u3089\\n\u3059\u3063\u3054\u3044\u3000\u3053\u308C\u3092\u3000{\u6E21|\u308F\u305F}\u305B\u308B\u308F[VAR 0114(004E)]",
  "{\u8A66\u4F5C\u54C1|\u3057\u3055\u304F\u3072\u3093}\u3060\u304B\u3089\u3000{\u898B|\u307F}\u305F{\u76EE|\u3081}\u304C\\n\u3061\u3087\u3063\u3068\u2026\u2026\u3000\u30A2\u30EC\u3060\u3051\u308C\u3069\u2026\u2026[VAR 0114(004E)]",
  "{\u4F7F|\u3064\u304B}\u3048\u3070\u3000\u3044\u3064\u3067\u3082\u3000\u3069\u3053\u3067\u3082\u3000\u30B7\u30F3\u30AF\u30ED\uFF01\uFF01\\n\u3044\u308D\u3093\u306A\u30DD\u30B1\u30E2\u30F3\u3067\u3000{\u8A66|\u305F\u3081}\u3057\u3066\u3061\u3087\u3046\u3060\u3044\uFF01[VAR 0114(004E)]",
  "{\u5B9F\u9A13|\u3058\u3063\u3051\u3093}\u306F\u3000{\u4E2D\u65AD|\u3061\u3085\u3046\u3060\u3093}\u306D\u2026\u2026\\n\u30B7\u30F3\u30AF\u30ED\u3057\u305F\u304F\u306A\u3063\u305F\u3089\u3000\u307E\u305F{\u6765|\u304D}\u3066\\r\\n{\u8133|\u306E\u3046}\u306B{\u8CA0\u8377|\u3075\u304B}\u304C\u3000\u304B\u304B\u308A\u3059\u304E\u305F\u306E\u304B\u3057\u3089\u2026\u2026[VAR 0114(004E)]",
  "\u30B7\u30F3\u30AF\u30ED\u30DE\u30B7\u30F3\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u308B\uFF1F\\c\\n\u30DE\u30B7\u30F3\u306E\u3000\uFF2C\u30DC\u30BF\u30F3\u3092\u3000{\u62BC|\u304A}\u3057\u306A\u304C\u3089\\n\uFF32\u30DC\u30BF\u30F3\u3092\u3000{\u62BC|\u304A}\u3059\u3068\u3000\u30B7\u30F3\u30AF\u30ED\u3067\u304D\u308B\u308F\uFF01[VAR 0114(004E)]",
  "\u3044\u3063\u3071\u3044\u3000\u30B7\u30F3\u30AF\u30ED\u3057\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u3068\uFF01\\n{\u9001|\u304A\u304F}\u3089\u308C\u3066\u304D\u305F\u3000\u30C7\u30FC\u30BF\u3000{\u5F79\u7ACB|\u3084\u304F\u3060}\u3063\u3066\u308B\u308F\uFF01\\r\\n{\u8B1D\u793C|\u3057\u3083\u308C\u3044}\u306B\u3000\uFF22\uFF30\u3092\u3000{\u9001|\u304A\u304F}\u308B\u308F\u306D\uFF01[VAR 0114(004E)]"
]
