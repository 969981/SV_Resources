  "\u304B\u3053\u307E\u308C\u3066\u3044\u308C\u3070\u3000{\u5B89\u5B9A|\u3042\u3093\u3066\u3044}\u3068\\n{\u5B89|\u3084\u3059}\u3089\u304E\u3092\u3000{\u4E0E|\u3042\u305F}\u3048\u3066\u304F\u308C\u308B\u30B6\u30DE\u30B9\u304C\u2026\u2026[VAR 0114(0041)]",
  "\u3067\u3082\u3000\u305D\u3046\u3057\u3066\u3000{\u5F97|\u3048}\u3089\u308C\u305F\u3000{\u5E78|\u3057\u3042\u308F}\u305B\u306F\\n{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3042\u308B\u304B\u3069\u3046\u304B\u3000\u308F\u304B\u3089\u306A\u3044\u30B6\u30DE\u30B9[VAR 0114(0041)]",
  "\u3075\u2026\u2026\u3000{\u6DF1|\u3075\u304B}\u3044\uFF01\\n{\u5B50\u4F9B|\u3053\u3069\u3082}\u306B\u306F\u3000{\u6DF1|\u3075\u304B}\u3059\u304E\u308B\u3088\u3000\u30CD\u30A2\u3061\u3083\u3093\uFF01[VAR 0114(0040)]",
  "\u3055\u3066\u3000\u30D3\u30EA\u30AA\uFF01\\n\u3042\u305F\u304F\u3057\u3000{\u540D\u6240|\u3081\u3044\u3057\u3087}\u3067\u3082\u3000\u306A\u3093\u3067\u3082\u306A\u3044\\r\\n[VAR FF00(0006)]\u3078\u3093\u3074\u306A{\u5834\u6240|\u3070\u3057\u3087}[VAR FF00(0000)]\u306B\u3000{\u884C|\u3044}\u304D\u305F\u3044\u30B6\u30DE\u30B9\uFF01[VAR 0114(0041)]",
  "\u3072\u3085\u30FC\uFF01\\n{\u540D\u6240|\u3081\u3044\u3057\u3087}\u3000{\u884C|\u3044}\u304D\u3059\u304E\u3066\u3000{\u98FD|\u3042}\u304D\u3066\u308B\uFF01\\r\\n\u30CD\u30A2\u3061\u3083\u3093\u3000\u30BB\u30EC\u30D6\u306E{\u9451|\u304B\u304C\u307F}\u3060\u306D\uFF01[VAR 0114(0040)]",
  "{\u5357|\u307F\u306A\u307F}\uFF15{\u756A|\u3070\u3093}\u30A8\u30EA\u30A2\u3068\u3000{\u5357|\u307F\u306A\u307F}\uFF11{\u756A|\u3070\u3093}\u30A8\u30EA\u30A2\u306E\\n{\u5883\u76EE|\u3055\u304B\u3044\u3081}\u306B\u3000\u3044\u3044\u3068\u3053\u308D\u304C\u3000\u3042\u308B\u3093\u3060\u3088\uFF01[VAR 0114(0040)]",
