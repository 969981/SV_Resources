  "\u3042\u3089\u2026\u2026\uFF1F\\n\u3044\u3064\u305E\u3084\u306E\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u304B\u305F\uFF01[VAR 0114(0041)]",
