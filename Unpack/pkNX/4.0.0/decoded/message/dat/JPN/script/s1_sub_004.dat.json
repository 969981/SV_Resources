  "{\u5076\u7136|\u3050\u3046\u305C\u3093}\u304B\u3000{\u904B\u547D|\u3046\u3093\u3081\u3044}\u304B\u3000\u306F\u305F\u307E\u305F\\n\u30BB\u30EC\u30D6\u30A4\u30AA\u30F3\u306B\u3000{\u5438|\u3059}\u3044\u3088\u305B\u3089\u308C\u305F\u306E\u304B\u306A\uFF1F[VAR 0114(0040)]",
  "\u30AA\u30FC\u30C3\u30DB\u30C3\u30DB\u30C3\u30DB\uFF01\\n\u3088\u3054\u3056\u3093\u3059\uFF01\u3000\u3088\u3054\u3056\u3093\u3059\uFF01[VAR 0114(0041)]",
