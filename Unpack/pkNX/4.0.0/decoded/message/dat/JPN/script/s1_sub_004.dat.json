  "\u307E\u3055\u306B\u3000\u3044\u3084\u3057{\u7CFB|\u3051\u3044}\u30BB\u30EC\u30D6\uFF01\\n\u3072\u3085\u30FC\u3000\u3072\u3085\u30FC\uFF01[VAR 0114(0040)]",
