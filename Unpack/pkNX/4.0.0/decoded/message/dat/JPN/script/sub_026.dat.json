[
  "\u3053\u3053\u306F\u3000\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\\n\u306F\u3050\u308C{\u8005|\u3082\u306E}\u305F\u3061\u306E{\u5BB6|\u3044\u3048}\u3000\u3060\u3088",
  "\u30B9\u30BF\u30FC\u30C0\u30B9\u30C8\uFF1F\u3000{\u5BA3\u6226\u5E03\u544A|\u305B\u3093\u305B\u3093\u3075\u3053\u304F}\uFF1F\\n\u2026\u2026\u30AA\u30EC\u305F\u3061\u306F\u3000{\u77E5|\u3057}\u3089\u306A\u3044\u3088\\r\\n{\u672C\u90E8|\u307B\u3093\u3076}\u306E{\u4EBA|\u3072\u3068}\u305F\u3061\u3068\u3000{\u9023\u7D61|\u308C\u3093\u3089\u304F}\u3068\u3063\u3066\u306A\u3044\u3057",
  "\u306A\u3093\u3082\u3000\u304A\u3082\u3066\u306A\u3057\u3000\u3067\u304D\u306A\u3044\u3051\u3069\\n\u2026\u2026\u3053\u308C\u3000\u3042\u3052\u308B",
  "[VAR 0100(0000)]\u306F\\n[VAR FF00(0008)]\u30B9\u30DD\u30FC\u30C4\u30AD\u30E3\u30C3\u30D7\uFF08\u30B9\u30BF\u30FC\uFF09[VAR FF00(0000)]\u3092\u3000{\u624B|\u3066}\u306B{\u5165|\u3044}\u308C\u305F\uFF01",
  "\u3044\u3064\u307E\u3067\u3067\u3082\u3000\u3044\u3066\u3082\u3044\u3044\u3057\\n\u3044\u3064\u3000{\u5E30|\u304B\u3048}\u3063\u3066\u3082\u3000\u3044\u3044\u304B\u3089\u306D",
  "\u3053\u3053\u306F\u3000\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\\n\u306F\u3050\u308C{\u8005|\u3082\u306E}\u305F\u3061\u306E{\u5BB6|\u3044\u3048}\u3000\u3060\u3088",
  "\u30AA\u30EC\u305F\u3061\u3000{\u56E3\u6D3B\u52D5|\u3060\u3093\u304B\u3064\u3069\u3046}\u306B\u3000{\u75B2|\u3064\u304B}\u308C\u305F\u3060\u3051\\n{\u5185\u7DD2|\u306A\u3044\u3057\u3087}\u3067\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306B\u3082\u3000{\u884C|\u3044}\u3063\u3066\u308B\u3088",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\\n\u304A{\u75B2|\u3064\u304B}\u308C\u3055\u307E\u3067\u30B9\u30BF\u30FC\uFF01",
  "\u3053\u3053\u3067\u306F\u3000{\u8AB0|\u3060\u308C}\u3082\u3000{\u4E89|\u3042\u3089\u305D}\u308F\u306A\u3044\\n\u3060\u304B\u3089\u3000{\u5C45\u5FC3\u5730|\u3044\u3054\u3053\u3061}\u304C\u3000\u3044\u3044\u306E\\r\\n{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3088\u308A\u3000\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u3088\u308A\u3000{\u5BB6|\u3044\u3048}\u3088\u308A\u306D"
]
