  "{\u81EA\u5206|\u3058\u3076\u3093}\u3068\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\u3000\u30A6\u30D1\u30FC\u306F\\n\u3066\u3093\u306D\u3093\u3000\u304B\u308F\u3044{\u5B50|\u3053}\u3061\u3083\u3093\u3084\\c\\n\u30C1\u30EA\u3061\u3083\u3093\u307F\u305F\u3044\u306B\u3000{\u8A08\u7B97|\u3051\u3044\u3055\u3093}\u3055\u308C\u305F\\n{\u7F8E\u4EBA|\u3073\u3058\u3093}\u3055\u3093\u3068\u3000\u30D0\u30E9\u30F3\u30B9\u3000\u3048\u3048\u3084\u308D\uFF1F[VAR 0114(0013)]"
