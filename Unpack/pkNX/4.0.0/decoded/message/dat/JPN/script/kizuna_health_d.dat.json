[
  "\u3088\u3046\u3053\u305D\u30FC\\n\u30DF\u30E2\u30B6\u306E{\u533B\u52D9\u5BA4|\u3044\u3080\u3057\u3064}\u3078\u30FC[VAR 0114(0028)]",
  "\u3042\uFF01\u3000[VAR 0100(0000)]\uFF01\\n\u3088\u304F\u3000{\u6765|\u304D}\u3066\u304F\u308C\u305F\u308F\uFF01[VAR 0114(0028)]",
  "\u3042\u305F\u3057\u306D\u3000\u306A\u3093\u3068\u2026\u2026[VAR 0114(0028)]",
  "{\u990A\u8B77\u6559\u8AED|\u3088\u3046\u3054\u304D\u3087\u3046\u3086}\u306E\\n{\u8A66\u9A13|\u3057\u3051\u3093}\u3000{\u53D7|\u3046}\u304B\u3063\u305F\u306E\uFF01[VAR 0114(0028)]",
  "\u304A\u3081\u3067\u3068\u3046\uFF01",
  "\u3088\u304B\u3063\u305F\uFF01",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u3000\u3042\u308A\u304C\u3068\uFF01[VAR 0114(0028)]",
  "[VAR 0100(0000)]\u304C\u3000{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u3067\\n\u30C1\u30E3\u30EC\u30F3\u30B8\u3057\u3066\u308B\u306E\u3000{\u77E5|\u3057}\u3063\u305F\u3089\\r\\n\u3042\u305F\u3057\u3082\u3000\u304C\u3093\u3070\u3093\u306A\u3044\u3068\u3063\u3066\u3000{\u601D|\u304A\u3082}\u3063\u305F\u3093\u3060[VAR 0114(0028)]",
  "\u307E\u3042\u3000{\u534A\u5206\u4EE5\u4E0A|\u306F\u3093\u3076\u3093\u3044\u3058\u3087\u3046}\u306F\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u306E\\n{\u52AA\u529B|\u3069\u308A\u3087\u304F}\u306E\u304A\u304B\u3052\u3000\u3060\u3051\u3069\u306D\u30FC\uFF01[VAR 0114(0028)]",
  "[VAR 0100(0000)]\u3000{\u80CC\u4E2D|\u305B\u306A\u304B}\\n{\u62BC|\u304A}\u3057\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u3068[VAR 0114(0028)]",
  "\u3067\u3082\u3055\u30FC\u3000{\u4ECA\u5E74\u5EA6|\u3053\u3093\u306D\u3093\u3069}\u306F\u3000{\u65B0|\u3042\u305F\u3089}\u3057\u3044\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3000\u3084\u308B{\u67A0|\u308F\u304F}\u304C\u3000\u306A\u3044\u3093\u3060\u3063\u3066\uFF01[VAR 0114(0028)]",
  "\u3057\u3070\u3089\u304F\u306F\u3000{\u533B\u52D9\u5BA4|\u3044\u3080\u3057\u3064}\u306E\\n\u30DF\u30E2\u30B6{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3000\u3084\u3063\u3066\u308B\u3088[VAR 0114(0028)]",
  "\u3067\u3082\u3000\u3044\u3064\u304B\u306F\u3000\u3053\u306E{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3067\\n{\u6559\u58C7|\u304D\u3087\u3046\u3060\u3093}\u306B\u3000{\u7ACB|\u305F}\u3064\u304B\u3089\uFF01[VAR 0114(0028)]",
  "\u305D\u3093\u3068\u304D\u306F\u3000\u30D3\u30B7\u30D0\u30B7\\n{\u4FDD\u5065|\u307B\u3051\u3093}\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3042\u3052\u308B\u3088\uFF01[VAR 0114(0028)]",
  "\u30DF\u30E2\u30B6{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306E\u3000{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\\n{\u697D|\u305F\u306E}\u3057\u307F\u306B\u3057\u3066\u3066\u3088\u306D\u30FC\uFF01[VAR 0114(0028)]",
  "\u30DF\u30E2\u30B6{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\u306E\\n\u304D\u305A\u306A\u304C\u3000{\u82BD\u751F|\u3081\u3070}\u3048\u305F\uFF01"
]
