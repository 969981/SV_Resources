  "\u3055\u3063\u3059\u304C\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\uFF01\\n\u3082\u3046\u3000{\u8AB0|\u3060\u308C}\u3092{\u547C|\u3088}\u3076\u304B\u3000{\u60A9|\u306A\u3084}\u3093\u3067\u308B\u3093\u3060\u306D\uFF01[VAR 0114(004B)]",
