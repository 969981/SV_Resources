  "\u2026\u2026{\u541B|\u304D\u307F}\u3063\u3066\u3000{\u9854|\u304B\u304A}{\u5E83|\u3072\u308D}\u305D\u3046\u3060\u3057\\n\u304A{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u3082\u3000{\u591A|\u304A\u304A}\u3044\u3067\u3057\u3087\uFF1F[VAR 0114(004B)]",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3084\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\uFF01\\n{\u5F37|\u3064\u3088}\uFF5E\u3044\u3000\u304A{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u306A\u3093\u304B\u3000\u3044\u305F\u3089\\r\\n{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306B\u3000{\u62DB\u5F85|\u3057\u3087\u3046\u305F\u3044}\u3057\u3066\u307B\u3057\u3044\u306A\u30FC[VAR 0114(004B)]",
  "\u307E\u304B\u305B\u3066\u304F\u3060\u3055\u3044\uFF01",
