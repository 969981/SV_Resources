  "{\u805E|\u304D}\u3044\u305F\u3088\u30FC\u3000\u30D6\u30EB\u30D9\u30EA\u30FC\u30B0\u306E\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306B\u3000\u306A\u3063\u305F\u3093\u3060\u3063\u3066\uFF01\uFF1F[VAR 0114(004B)]",
  "\u3044\u3084\u30FC\u3000\u3059\u3054\u3044\u306D\uFF01\\c\\n[VAR 0100(0000)]\u3055\u3093\u306B\u3000{\u6765|\u304D}\u3066\u3082\u3089\u3063\u3066\\n{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3088\u304B\u3063\u305F\u3088\uFF01[VAR 0114(004B)]",
  "{\u541B|\u304D\u307F}\u304C\u3000{\u6765|\u304D}\u3066\u304B\u3089\\n\u3057\u3070\u3089\u304F\u3000{\u7D4C|\u305F}\u3064\u3051\u3069\\c\\n\u30D6\u30EB\u30FC\u30D9\u30EA\u30FC{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306F\\n{\u697D|\u305F\u306E}\u3057\u3093\u3067\u3082\u3089\u3048\u3066\u308B\u304B\u306A\uFF1F[VAR 0114(004B)]",
