  "\u307E\u3042\u307E\u3042\u3067\u3059",
  "\u3044\u3044\u306D\u3000\u3044\u3044\u306D\\n\u3061\u3087\u3046\u3069\u3000\u3044\u3044\u306D\u30FC[VAR 0114(004B)]",
  "\u3078\u3048\u30FC\u3000\u307E\u3042\u307E\u3042\u304B\\n\u307E\u3042\u307E\u3042\u3000{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\u3063\u3066\u3000\u3053\u3068\u3060\u306D\uFF01[VAR 0114(004B)]",
  "\u305D\u3093\u306A\u3000[VAR 0100(0000)]\u3055\u3093\u306B\\n{\u6298|\u304A}\u308A{\u5165|\u3044}\u3063\u3066\u3000{\u76F8\u8AC7|\u305D\u3046\u3060\u3093}\u304C\u3000\u3042\u308B\u3093\u3060\u3051\u3069\u2026\u2026[VAR 0114(004B)]",
  "[VAR 0100(0000)]\u3055\u3093\u304C\\n\u30D6\u30EB\u30FC\u30D9\u30EA\u30FC{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306B\u3000{\u6765|\u304D}\u3066\u304F\u308C\u305F\u304A\u304B\u3052\u3067\\r\\n{\u5B66\u5712|\u304C\u304F\u3048\u3093}{\u5168\u4F53|\u305C\u3093\u305F\u3044}\u304C\u3000\u3068\u3063\u3066\u3082\u3000{\u6D3B\u6C17|\u304B\u3063\u304D}\u3065\u3044\u305F\u3093\u3060\u3088\u306D[VAR 0114(004B)]",
