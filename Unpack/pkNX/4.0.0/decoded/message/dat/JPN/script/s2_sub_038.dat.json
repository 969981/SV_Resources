  "\u306A\u3093\u3068\u306A\u304F\u306F\u3000\u3088\u304F\u306A\u3044\u2026\u2026\\n\u3082\u3063\u3068\u3000\u3057\u3063\u304B\u308A\u3000{\u8003|\u304B\u3093\u304C}\u3048\u308D\u3088\u2026\u2026\uFF01",
