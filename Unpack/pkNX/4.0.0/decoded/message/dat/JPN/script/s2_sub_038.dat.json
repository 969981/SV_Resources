  "[VAR 0100(0000)]\u306F\u3000{\u7537|\u304A\u3068\u3053}\u306E{\u5B50|\u3053}\u304B\u3089\\n[VAR FF00(0008)]{\u5DE6\u624B|\u3072\u3060\u308A\u3066}\u306E\u3046\u305A\u304D\u30A8\u30E2\u30FC\u30C8[VAR FF00(0000)]\u3092\u3000{\u6388|\u3055\u305A}\u3051\u3089\u308C\u305F\uFF01",
  "\u30D5\u30F3\u30C3\u3000{\u6211|\u308F}\u304C{\u540C\u5FD7|\u3069\u3046\u3057}\u3088\\n{\u5DE6\u624B|\u3072\u3060\u308A\u3066}\u306B\u2026\u2026\u3000{\u98F2|\u306E}\u307E\u308C\u308B\u306A\u3088\u2026\u2026\uFF01\uFF01"
