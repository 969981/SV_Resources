  "\u304A\u305F\u304C\u3044\u304C\u3000\u3044\u308C\u3070\u3000{\u5E78|\u3057\u3042\u308F}\u305B\u3060\u3063\u305F\u306E\u3067\\n{\u88CF\u5C71|\u3046\u3089\u3084\u307E}\u306E{\u6D1E|\u3069\u3046}\u304F\u3064\u3067\u3000\u3064\u3064\u307E\u3057\u304F\u3000{\u66AE|\u304F}\u3089\u3057{\u59CB|\u306F\u3058}\u3081\u305F[VAR 0114(0030)]",
