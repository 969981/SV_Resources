  "{\u7537|\u304A\u3068\u3053}\u304C\u3000{\u7570\u56FD|\u3044\u3053\u304F}\u3088\u308A\u3000{\u6301|\u3082}\u3061\u3053\u3093\u3060\u3000{\u5B9D\u77F3|\u307B\u3046\u305B\u304D}\u3092\\n\u3042\u3057\u3089\u3063\u305F\u3000{\u5149|\u3072\u304B}\u308A\u304B\u304C\u3084\u304F\u3000{\u898B\u4E8B|\u307F\u3054\u3068}\u306A\u304A{\u9762|\u3081\u3093}[VAR 0114(0030)]",
  "\u304A{\u9762|\u3081\u3093}\u3092\u3000\u304B\u3076\u308C\u3070\u3000{\u7D20\u9854|\u3059\u304C\u304A}\u3092\u3000{\u96A0|\u304B\u304F}\u3057\\n{\u6751\u4EBA|\u3080\u3089\u3073\u3068}\u3068\u3000\u306A\u304B\u3088\u304F\u3067\u304D\u308B[VAR 0114(0030)]",
  "{\u7537|\u304A\u3068\u3053}\u3068{\u9B3C|\u304A\u306B}\u306F\u3000\u304A{\u9762\u8077\u4EBA|\u3081\u3093\u3057\u3087\u304F\u306B\u3093}\u306E\u3000{\u512A|\u3084\u3055}\u3057\u3055\u306B\\n\u305F\u3044\u305D\u3046\u3000{\u559C|\u3088\u308D\u3053}\u3073\u3000{\u611F\u8B1D|\u304B\u3093\u3057\u3083}\u3057\u305F\u305D\u3046\u3060[VAR 0114(0030)]",
