[
  "{\u5C11|\u3059\u3053}\u3057\u3000{\u9577|\u306A\u304C}\u3044{\u8A71|\u306F\u306A\u3057}\u306B\u3000\u306A\u308B\u304C\\n\u3088\u308D\u3057\u3044\u304B\u306A\uFF1F[VAR 0114(0030)]",
