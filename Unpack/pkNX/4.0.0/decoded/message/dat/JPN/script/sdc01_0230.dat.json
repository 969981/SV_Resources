  "{\u4E16|\u3088}\u306B\u3082\u3000\u3081\u305A\u3089\u3057\u3044\u3000\u304B\u304C\u3084\u304F\u304A{\u9762|\u3081\u3093}\u306E\\n{\u5642|\u3046\u308F\u3055}\u3092\u3000{\u805E|\u304D}\u304D\u3064\u3051\u305F\u306E\u3067\u3042\u308D\u3046\u304B\u2026\u2026[VAR 0114(0030)]",
