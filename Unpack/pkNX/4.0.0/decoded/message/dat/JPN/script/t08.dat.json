[
  "\u30D5\u30EA\u30C3\u30B8\u30BF\u30A6\u30F3\u306F\\n{\u96EA|\u3086\u304D}\u3068\u3000{\u93AE\u9B42|\u3061\u3093\u3053\u3093}\u306E\u3000{\u753A|\u307E\u3061}\uFF01\\r\\n{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u306F\u3000\u30E9\u30A4\u30F4{\u4F1A\u5834|\u304B\u3044\u3058\u3087\u3046}\u3082\u3000{\u6709\u540D|\u3086\u3046\u3081\u3044}\u3060\u3088",
  "{\u96EA|\u3086\u304D}\u304C\u3000\u3072\u3089\u3072\u3089\uFF01\\n\u308D\u3046\u305D\u304F\u306E{\u706B|\u3072}\u306F\u3000\u3086\u3089\u3086\u3089\uFF01\\c\\n{\u6BCE\u65E5|\u307E\u3044\u306B\u3061}\u304C\u3000\u304A{\u796D|\u307E\u3064\u308A}\u307F\u305F\u3044\u3000\u3067\u3057\u3087\uFF01",
  "{\u4ECA|\u3044\u307E}\u306E\u30C8\u30EC\u30F3\u30C9\u306F\u3000{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u3059\u3079\u308A\uFF01\\n\u30CA\u30C3\u30DA{\u5C71|\u3084\u307E}\u3067\u3000{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3067\u304D\u308B\u306E\u3088\uFF01",
  "\u30E6\u30AD\u30EF\u30E9\u30B7\u3000\u304B\u308F\u3044\u3044\u3060\u308D\u3046\uFF01\\n\u30E1\u30B9\u3060\u3051\u304C\u3000\u30E6\u30AD\u30E1\u30CE\u30B3\u306B\\r\\n{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\u3000{\u53EF\u80FD\u6027|\u304B\u306E\u3046\u305B\u3044}\u304C\u3000\u3042\u308B\u306E\u3060",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000{\u51B7|\u3072}\u3048\u308B\u308F\u2026\u2026\\n\u304B\u3089\u3044\u306E\u3000{\u98DF|\u305F}\u3079\u3066\u3000{\u6E29|\u3042\u3063\u305F}\u307E\u308D\uFF01",
  "{\u7A76\u6975|\u304D\u3085\u3046\u304D\u3087\u304F}\u306E\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000{\u77E5|\u3057}\u3063\u3066\u308B\uFF1F\\n{\u540D\u524D|\u306A\u307E\u3048}\u306B\u3000\u300E\u30DE\u30B9\u30BF\u30FC\u300F\u3063\u3066\u3000\u3064\u3044\u3066\u3066\\r\\n\u30EC\u30B7\u30D4\u306F\u3000{\u4E00\u5207\u4E0D\u660E|\u3044\u3063\u3055\u3044\u3075\u3081\u3044}\u306A\u306E\u2026\u2026",
  "\u304A\u305D\u3068\u3067\u3000\u305F\u3079\u308B\u3068\\n\u3044\u3064\u3082\u3088\u308A\u3000\u304A\u3044\u3057\u3044\u30FC\uFF01",
  "\uFF11{\u5E74\u534A\u524D|\u306D\u3093\u306F\u3093\u307E\u3048}\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306E\\n\u30BF\u30A4\u30E0\u3055\u3093\u304C\u3000{\u5F15\u9000|\u3044\u3093\u305F\u3044}\u3057\u3066\u3000{\u59B9|\u3044\u3082\u3046\u3068}\u306E\\r\\n\u30E9\u30A4\u30E0\u3055\u3093\u304C\u3000{\u5F15|\u3072}\u304D{\u7D99|\u3064}\u3044\u3060\u3093\u3060",
  "\u30E9\u30A4\u30E0\u306E\u30E9\u30A4\u30F4\u3000{\u89B3|\u307F}\u305F\u3053\u3068\u3000\u3042\u308B\uFF1F\\n{\u9707|\u3075\u308B}\u3048\u308B\u305C\uFF01\u3000\u305F\u307E\u3057\u3044\u3063\u3066\u3084\u3064\u304C\u3055\uFF01",
  "\u30B8\u30E0\u30C6\u30B9\u30C8\u3067\u306F\u3000{\u7D2B|\u3080\u3089\u3055\u304D}\u306E\u30B9\u30C6\u30FC\u30B8\u304C\\n{\u5149|\u3072\u304B}\u3063\u3066\u3000\u3068\u3063\u3066\u3082\u3000\u30AD\u30EC\u30FC\u306A\u306E\uFF01"
]
