  "\u308F\u3084\u3058\u3083\uFF01\\n\u306D\u30FC\u3061\u3083\u3093\u306B\u3000{\u52DD|\u304B}\u3063\u3061\u307E\u3063\u305F\u30FC\uFF01[VAR 0114(0043)]",
  "\u308F\u3084\u3058\u3083\uFF01\\n\u306D\u30FC\u3061\u3083\u3093\u3068\u3000{\u540C|\u304A\u306A}\u3058\u304F\u3089\u3044\u3000\u3064\u3048\u30FC[VAR 0114(0043)]",
  "\u304F\u3084\u3057\u3044\u2026\u2026\u3000\u3042\u305F\u3057\u304C\\n{\u8CA0|\u307E}\u3051\u308B\u306A\u3093\u3066\u3000\u3042\u308A\u3048\u306A\u3044\u306E\u306B\uFF01\uFF01[VAR 0114(0044)]",
  "\u3075\u3046\u3093\u2026\u2026\u3000\u3042\u305F\u3057{\u76F8\u624B|\u3042\u3044\u3066}\u306B\\n\u3053\u3053\u307E\u3067\u3000\u3067\u304D\u308B\u3068\u306F\u306D[VAR 0114(0044)]",
  "\u2026\u2026\u307E\u3000\u304E\u308A\u304E\u308A\u3000{\u5408\u683C|\u3054\u3046\u304B\u304F}\u3063\u3066\u3068\u3053\u304B\u306A[VAR 0114(0044)]",
  "\u3057\u304B\u305F\u306A\u3044\u306D\u3000\u3042\u3093\u305F\u306A\u3089\\n\u3042\u305F\u3057\u306E{\u820E\u5F1F|\u3057\u3083\u3066\u3044}\u3000\u3068\u3057\u3066\\r\\n{\u6751|\u3080\u3089}\u306B{\u5165|\u306F\u3044}\u3063\u3066\u3082\u3000\u3044\u3044\u3063\u3066\u3053\u3068\u306B\u2026\u2026[VAR 0114(0044)]",
  "\u3053\u308A\u3083\u30FC\uFF01\u3000{\u52DD\u624B|\u304B\u3063\u3066}\u306B\\n\u306A\u30FC\u306B\u3000\u3084\u3063\u3068\u308B\uFF01[VAR 0114(002C)]",
