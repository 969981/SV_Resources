  "\u2026\u2026\u3069\u3046\u3057\u3066\u3082\u3000{\u5165|\u306F\u3044}\u308A\u305F\u3044\u306A\u3089\\n\u3042\u305F\u3057\u3068\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3057\u306A\u304D\u3083\u3000\u30C0\u30E1[VAR 0114(0044)]",
  "\u306D\u3000\u306D\u30FC\u3061\u3083\u3093\\n{\u6226|\u305F\u305F\u304B}\u3044\u305F\u3044\u3060\u3051\u3000\u3044\u3058\u308F\u308B\u2026\u2026[VAR 0114(0043)]",
