  "{\u6751|\u3080\u3089}\u307E\u3067\u306E{\u9053|\u307F\u3061}\u3000\u30AC\u30C3\u30BF\u30AC\u30BF\u306A\u3093\u3067\\n{\u8ECA\u9154|\u304F\u308B\u307E\u3088}\u3044\u3059\u308B{\u4EBA|\u3072\u3068}\u3000{\u591A|\u304A\u304A}\u3044\u3093\u3067\u3059\u3088[VAR 0114(0045)]",
  "{\u4E57|\u306E}\u308A{\u7269|\u3082\u306E}\u306B\u3000{\u9154|\u3088}\u3046\u306E\u306F\u3000{\u8033|\u307F\u307F}\u306E{\u4E2D|\u306A\u304B}\u306B\u3042\u308B\\n\u30D0\u30E9\u30F3\u30B9{\u611F\u899A|\u304B\u3093\u304B\u304F}\u3092\u3000{\u4FDD|\u305F\u3082}\u3064\u3000{\u5668\u5B98|\u304D\u304B\u3093}\u304C\\r\\n{\u63FA|\u3086}\u308C\u306B\u3088\u3063\u3066\u3000{\u7570\u5E38|\u3044\u3058\u3087\u3046}\u3092\u3000\u304D\u305F\u3059\u304B\u3089\u3060\u3088[VAR 0114(0042)]",
