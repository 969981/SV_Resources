  "\u2026\u2026\u306A\u3093\u3068\uFF01\u3000\u30D0\u30B9{\u505C|\u3066\u3044}\u3067\\n{\u4F53\u8ABF|\u305F\u3044\u3061\u3087\u3046}\u306E{\u60AA|\u308F\u308B}\u3044\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u304C\uFF01\uFF1F[VAR 0114(0045)]",
