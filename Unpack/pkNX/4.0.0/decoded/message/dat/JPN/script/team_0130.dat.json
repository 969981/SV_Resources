[
  "\u30D5\u30C3\u2026\u2026\u3000{\u9A5A\u6115|\u304D\u3087\u3046\u304C\u304F}\u3057\u305F\u3060\u308D\u3046[VAR 0114(0009)]",
  "\u308F\u305F\u3057\u3053\u305D\u304C\u3000\u30DE\u30B8\u30DC\u30B9\u2026\u2026\\n\u305D\u3057\u3066\u3000\u30AB\u30B7\u30AA\u30DA\u30A2\u306E{\u6B63\u4F53|\u3057\u3087\u3046\u305F\u3044}\u3060[VAR 0114(0009)]",
  "{\u5B66\u6821\u524D|\u304C\u3063\u3053\u3046\u307E\u3048}\u3067\u3000\u3057\u305F\u3063\u3071\u3092\u3000{\u5012|\u305F\u304A}\u3057\u305F\\n\u3042\u306A\u305F\u306E{\u5F37|\u3064\u3088}\u3055\u3092\u3000{\u898B|\u307F}\u3066\\r\\n\u30B9\u30BF\u30FC\u30C0\u30B9\u30C8{\u5927\u4F5C\u6226|\u3060\u3044\u3055\u304F\u305B\u3093}\u3092\u3000{\u601D|\u304A\u3082}\u3044\u3064\u3044\u305F\u306E\u3060[VAR 0114(0009)]",
  "\u308F\u305F\u3057\u306E{\u529B|\u3061\u304B\u3089}\u3055\u3048\u3000\u3042\u308C\u3070\\n\uFF2C\uFF30\u306A\u3069\u3000{\u6E6F\u6C34|\u3086\u307F\u305A}\u306E\u3054\u3068\u304F\u3000{\u5897|\u3075}\u3084\u305B\u308B\\r\\n{\u5831\u916C|\u307B\u3046\u3057\u3085\u3046}\u304C\u3042\u308C\u3070\u3000{\u4E57|\u306E}\u3063\u3066\u304F\u308B\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\u306A[VAR 0114(0009)]",
  "{\u88DC\u7D66\u73ED|\u307B\u304D\u3085\u3046\u306F\u3093}\u3068\u3057\u3066\u3000\u305A\u3063\u3068\\n{\u52D5\u5411|\u3069\u3046\u3053\u3046}\u3092\u3000{\u898B\u5F35|\u307F\u306F}\u3063\u3066\u3044\u305F\u305E[VAR 0114(0009)]",
  "\u3042\u3068\u306F\u3000\u308F\u305F\u3057\u3092\u3000\u3046\u3061{\u8CA0|\u307E}\u304B\u305B\u3070\\n\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306F\u3000{\u5B8C\u74A7|\u304B\u3093\u307A\u304D}\u306B\u3000{\u7D42|\u304A}\u308F\u308B\\r\\n\u2026\u2026\u305D\u306E\u305F\u3081\u306B\u3000{\u52D5|\u3046\u3054}\u3044\u3066\u3082\u3089\u3063\u305F[VAR 0114(0009)]",
  "\u3060\u304C\u3000{\u540C\u6642|\u3069\u3046\u3058}\u306B\u3000\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u3092\\n{\u7D42|\u304A}\u308F\u3089\u305B\u305F\u304F\u306A\u3044\u3000{\u6C17\u6301|\u304D\u3082}\u3061\u3082\u3042\u308B\uFF01\\r\\n\u3084\u3059\u3084\u3059\u3068\u3000{\u8CA0|\u307E}\u3051\u308B\u308F\u3051\u306B\u306F\u3000\u3044\u304B\u306A\u3044\uFF01[VAR 0114(0009)]",
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u306E{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u2026\u2026\\n{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u306F\u3000\u3067\u304D\u3066\u3044\u308B\u304B\uFF1F[VAR 0114(0009)]",
  "\u3067\u304D\u3066\u308B",
  "\u3061\u3087\u3063\u3068{\u5F85|\u307E}\u3063\u3066",
  "\u2026\u2026\u308F\u304B\u3063\u305F\\n{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u3092\u3057\u3066\u3000{\u51FA\u76F4|\u3067\u306A\u304A}\u3059\u3053\u3068\u3060[VAR 0114(0009)]",
  "\u2026\u2026{\u611F\u8B1D|\u304B\u3093\u3057\u3083}\u3059\u308B[VAR 0114(0009)]",
  "\u3059\u307E\u306A\u3044\u3000{\u5F85|\u307E}\u305F\u305B\u305F\u306A\\c\\n\u30BF\u30A4\u30E0{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306E\u3000{\u53CD\u7701\u6587|\u306F\u3093\u305B\u3044\u3076\u3093}\u304C\u2026\u2026\\n\u3044\u3084\u3000{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u306B\u3000{\u624B\u9593|\u3066\u307E}\u3069\u3063\u3066\u306A[VAR 0114(001E)]",
  "\u3082\u3057\u304B\u3057\u3066\\n\u305D\u306E{\u58F0|\u3053\u3048}\u306F\u3000\u30CD\u30EB\u30B1\u304B\uFF1F[VAR 0114(0009)]",
  "\u30DC\u30BF\u2026\u2026\u3000\u3084\u306F\u308A\\n\u3044\u3084\u3000\u3042\u3093\u305F\u304C\u2026\u2026\\r\\n\u30AB\u30B7\u30AA\u30DA\u30A2\u3000\u3060\u3063\u305F\u306E\u304B[VAR 0114(001E)]",
  "\u3042\u3042\u3000\u305D\u3046\u3060\\n\u30CD\u30EB\u30B1\u306B\u3082\u3000{\u4E00\u4ED5\u4E8B|\u3072\u3068\u3057\u3054\u3068}\u3000{\u983C|\u305F\u306E}\u3082\u3046\u304B[VAR 0114(0009)]",
  "\u3053\u308C\u304B\u3089\u3000{\u8D77|\u304A}\u3053\u308B\u3053\u3068\u3092\\n{\u52D5\u753B|\u3069\u3046\u304C}\u3067\u3000{\u64AE\u5F71|\u3055\u3064\u3048\u3044}\u3057\u3066\u3082\u3089\u3046\u305E\\r\\n{\u52DD\u6557|\u3057\u3087\u3046\u306F\u3044}\u3092\u3000{\u5168\u56E3\u54E1|\u305C\u3093\u3060\u3093\u3044\u3093}\u306B\u3000{\u901A\u9054|\u3064\u3046\u305F\u3064}\u3059\u308B\u304B\u3089\u306A[VAR 0114(0009)]",
  "\u3042\u3000\u3042\u3042\u2026\u2026 \u308F\u304B\u3063\u305F[VAR 0114(001E)]",
  "\u2026\u2026\u3042\u3089\u305F\u3081\u3066\\n{\u540D\u4E57|\u306A\u306E}\u3063\u3066\u304A\u3053\u3046\u304B[VAR 0114(0009)]",
  "\u308F\u305F\u3057\u304C\u3000\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\\n\u30DE\u30B8\u30DC\u30B9\u3000\u30AB\u30B7\u30AA\u30DA\u30A2\u2026\u2026[VAR 0114(0009)]",
  "\u2026\u2026\u3067\u306F\u306A\u304F\u3000\u30DC\u30BF\u30F3\uFF01[VAR 0114(0008)]",
  "\u2026\u2026\u30DE\u30B8\u30DC\u30B9\u306E{\u529B|\u3061\u304B\u3089}\u306E{\u524D|\u307E\u3048}\u306B\\n{\u982D|\u3053\u3046\u3079}\u3092{\u5782|\u305F}\u308C\u3066\u3000\u3072\u308C{\u4F0F|\u3075}\u3059\u304C\u3044\u3044\uFF01\uFF01[VAR 0114(0008)]"
]
