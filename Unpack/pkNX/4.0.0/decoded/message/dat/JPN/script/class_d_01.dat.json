  "{\u89AA\u611B|\u3057\u3093\u3042\u3044}\u306A\u308B\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u306E\u307F\u3093\u306A\uFF01\\n{\u4F53|\u304B\u3089\u3060}\u306F\u3000\u304A{\u5143\u6C17|\u3052\u3093\u304D}\u3067\u3059\u304B\uFF1F[VAR 0114(002C)]",
