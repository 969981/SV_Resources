  "\u305D\u3046\u305D\u3046\u3000\u30EF\u30B7\u306E\u30EC\u30C3\u30B9\u30F3\u306F\u3000{\u8A00\u8A9E\u5B66|\u3052\u3093\u3054\u304C\u304F}\uFF01\\n{\u8A00\u8449|\u3053\u3068\u3070}\u306B\u3064\u3044\u3066\u306E\u3000\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u306A\u3093\u3060\u3088\u306A\uFF01[VAR 0114(0026)]",
  "\u304A\u306F\u3088\u3046\uFF01\u3000\u3053\u3093\u306B\u3061\u306F\uFF01\u3000\u306A\u30FC\u3093\u3066\\n{\u6328\u62F6|\u3042\u3044\u3055\u3064}\u306E{\u8A00\u8449|\u3053\u3068\u3070}\u3082\u3000\u3068\u3053\u308D{\u5909|\u304B}\u308F\u308C\u3070\\r\\n\u30B0\u30C3\u30E2\u30FC\u30CB\u30F3\uFF01\u3000\u30CF\u30ED\u30FC\uFF01\u3000\u306B\u306A\u308B\u3093\u3060\u306D\uFF01[VAR 0114(0026)]",
  "\u3044\u304F\u3064\u304B\u306E{\u8A00\u8449|\u3053\u3068\u3070}\u3092\u3000{\u5408\u4F53|\u304C\u3063\u305F\u3044}\u3055\u305B\u305F\\n\u304A\u306F\u3053\u3093\u30CF\u30ED\u30C1\u30E3\u30AA\u3063\u3066\u3000{\u6328\u62F6|\u3042\u3044\u3055\u3064}\u3059\u308B\\r\\n{\u52D5\u753B\u914D\u4FE1\u8005|\u3069\u3046\u304C\u306F\u3044\u3057\u3093\u3057\u3083}\u3082\u3000\u3044\u308B\u3093\u3060\u3063\u3066\uFF01[VAR 0114(0026)]",
  "{\u4E16\u754C|\u305B\u304B\u3044}\u306B\u306F\u3000\u3044\u3063\u3071\u3044\u306E{\u56FD|\u304F\u306B}\u304C\u3000\u3042\u3063\u3066\\n{\u56FD|\u304F\u306B}\u3054\u3068\u306B\u3000\u3044\u3063\u3071\u3044\u306E{\u8A00\u8449|\u3053\u3068\u3070}\u304C\u3000\u3042\u308A\u307E\u3059\uFF01[VAR 0114(0026)]",
  "\u30B0\u30E9\u30B7\u30A2\u30B9\uFF01\u3000\u30E1\u30EB\u30B7\u30FC\uFF01\u3000\u30B7\u30A7\u30A4\u30B7\u30A7\u30A4\uFF01\\n\u30C0\u30F3\u30B1\u30B7\u30A7\u30FC\u30F3\uFF01\u3000\u30B5\u30F3\u30AD\u30E5\u30FC\uFF01\\r\\n\u3053\u308C{\u5168\u90E8|\u305C\u3093\u3076}\u3000{\u540C|\u304A\u306A}\u3058{\u610F\u5473|\u3044\u307F}\uFF01\u3000\u308F\u304B\u308B\u304B\u306A\uFF1F[VAR 0114(0026)]",
