  "\u30B0\u30E9\u30B7\u30A2\u30B9\uFF01\u3000\u30E1\u30EB\u30B7\u30FC\uFF01\u3000\u30B7\u30A7\u30A4\u30B7\u30A7\u30A4\uFF01\\n\u3053\u308C{\u5168\u90E8|\u305C\u3093\u3076}\u3000\u3042\u308A\u304C\u3068\u3046\u3063\u3066{\u8A00\u8449|\u3053\u3068\u3070}\uFF01\\r\\n\u30B5\u30F3\u30AD\u30E5\u30FC\u306F\u3000{\u5927|\u3060\u3044}\u30D2\u30F3\u30C8\u3060\u3063\u305F\u308F\u306A\uFF01[VAR 0114(0026)]",
