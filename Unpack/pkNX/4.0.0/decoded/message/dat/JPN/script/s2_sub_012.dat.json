  "\u304A\u3084\u307E\u3000\u3059\u3054\u3044\uFF01\\n\u30B5\u30FC\u30AF\u30EB\u30DF\u30C3\u30B7\u30E7\u30F3\u3092\u3000[VAR 0202(0001)]{\u56DE|\u304B\u3044}\u3082\u3000{\u9054\u6210|\u305F\u3063\u305B\u3044}\uFF01",
  "\u3042\u3089\u307E\u3000\u3059\u3054\u3044\uFF01\\n\u30D6\u30EB\u30EC\u30AF\u306E\u30DF\u30C3\u30B7\u30E7\u30F3\u3092\u3000[VAR 0202(0001)]{\u56DE|\u304B\u3044}\u3082\u3000{\u9054\u6210|\u305F\u3063\u305B\u3044}\uFF01",
  "\u3054{\u8912\u7F8E|\u307B\u3046\u3073}\u3092\u3000\u3042\u3052\u308B\u306E\u306F\u2026\u2026\\n\u307E\u3060\u3000\u306F\u3084\u3044\u304B\u3082\u306D",
  "\u30D6\u30EB\u30EC\u30AF\u306E\u30DF\u30C3\u30B7\u30E7\u30F3\u3092\u3000\u3042\u3068[VAR 0202(0002)]{\u56DE|\u304B\u3044}\\n\u30B5\u30FC\u30AF\u30EB\u30DF\u30C3\u30B7\u30E7\u30F3\u3000\u3042\u3068[VAR 0202(0003)]{\u56DE|\u304B\u3044}\\r\\n{\u9054\u6210|\u305F\u3063\u305B\u3044}\u3057\u305F\u3089\u3000\u304A\u3084\u3064\u3092\u3000{\u5DEE|\u3055}\u3057{\u4E0A|\u3042}\u3052\u308B\u306D",
  "\u30D6\u30EB\u30EC\u30AF\u306E\u30DF\u30C3\u30B7\u30E7\u30F3\u306F\u3000\u304C\u3093\u3070\u308C\u3066\u3044\u308B\u304B\u3089\\n\u30B5\u30FC\u30AF\u30EB\u30DF\u30C3\u30B7\u30E7\u30F3\u3092\u3000\u3042\u3068[VAR 0202(0003)]{\u56DE|\u304B\u3044}\\r\\n{\u9054\u6210|\u305F\u3063\u305B\u3044}\u3067\u304D\u305F\u3089\u3000\u304A\u3084\u3064\u3092\u3000{\u5DEE|\u3055}\u3057{\u4E0A|\u3042}\u3052\u308B\u306D",
  "\u30B5\u30FC\u30AF\u30EB\u30DF\u30C3\u30B7\u30E7\u30F3\u306F\u3000\u304C\u3093\u3070\u308C\u3066\u3044\u308B\u304B\u3089\\n\u30D6\u30EB\u30EC\u30AF\u306E\u30DF\u30C3\u30B7\u30E7\u30F3\u3092\u3000\u3042\u3068[VAR 0202(0002)]{\u56DE|\u304B\u3044}\\r\\n{\u9054\u6210|\u305F\u3063\u305B\u3044}\u3057\u305F\u3089\u3000\u304A\u3084\u3064\u3092\u3000{\u5DEE|\u3055}\u3057{\u4E0A|\u3042}\u3052\u308B\u306D",
  "\u30B5\u30FC\u30AF\u30EB\u30DF\u30C3\u30B7\u30E7\u30F3\u306F\u306D\\n\u30E6\u30CB\u30AA\u30F3\u30B5\u30FC\u30AF\u30EB\u3067\u3000\u304A{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u3068\u3000\u30D6\u30EB\u30EC\u30AF\u3092\\r\\n\u305F\u304F\u3055\u3093\u3000\u3084\u3063\u3066\u305F\u3089\u3000{\u59CB|\u306F\u3058}\u307E\u308B\u307F\u305F\u3044\u3060\u3088",
  "\u305D\u308C\u3068\u3082\u3000\u3081\u305A\u3089\u3057\u3044\u3000\u30DD\u30B1\u30E2\u30F3\u306E\u304A{\u8A71|\u306F\u306A\u3057}\\n\u3082\u3046{\u4E00\u5EA6|\u3044\u3061\u3069}\u3000{\u805E|\u304D}\u304D\u305F\u3044\u306E\uFF1F",
  "\u30DD\u30B1\u30E2\u30F3\u306E\u304A{\u8A71|\u306F\u306A\u3057}\u3000\u3069\u308C\u304C\u3000\u3044\u3044\u304B\u306A\uFF1F\\n\u304A\u3084\u3064\u304C\u3000\u3042\u3063\u305F\u3089\u3000{\u898B|\u307F}\u305B\u3066\u3054\u3089\u3093",
  "\u305D\u308C\u306F\u3000\u307C\u304F\u304C\u3000\u3042\u3052\u305F\\n\u304A\u3084\u3064\u3058\u3083\u3000\u306A\u3044\u306D\u2026\u2026",
  "\u304A{\u8A71|\u306F\u306A\u3057}\u3000{\u805E|\u304D}\u304B\u306A\u304F\u3066\u3000\u3044\u3044\u306E\uFF1F\\n{\u9060\u616E|\u3048\u3093\u308A\u3087}\u3057\u306A\u304F\u3066\u3082\u3000\u3044\u3044\u3093\u3060\u3088\uFF1F",
  "\u304C\u3093\u3070\u3063\u3066\u3044\u308B\u3000[VAR 0100(0000)]\u3055\u3093\u306B\u306F\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u304A\u3084\u3064\u3092\u3000{\u5DEE|\u3055}\u3057{\u4E0A|\u3042}\u3052\u308B\u306D",
  "\u305D\u308C\u306F\u3000[VAR 0109(0004)]\uFF01",
  "[VAR 0101(0005)]\u3063\u3066\u3000\u30DD\u30B1\u30E2\u30F3\u306F\u306D\uFF1F\\n\u3068\u3063\u3066\u3082\u3000\u3081\u305A\u3089\u3057\u304F\u3066\\r\\n\u3081\u3063\u305F\u306B\u3000{\u4F1A|\u3042}\u3048\u306A\u3044\u3093\u3060\u3088\uFF1F",
  "\u30D5\u30EA\u30FC\u30B6\u30FC\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2\u306E{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u3067\u3000{\u7D20\u6575|\u3059\u3066\u304D}\u306A{\u6C60|\u3044\u3051}\u3092\u3000{\u898B|\u307F}\u3064\u3051\u3066\\n\u305D\u3053\u3067\u3000{\u5BD2\u4E2D\u6C34\u6CF3|\u304B\u3093\u3061\u3085\u3046\u3059\u3044\u3048\u3044}\u3092\u3000\u3057\u3066\u3044\u305F\u306E\u306D\uFF1F",
  "\u305D\u3046\u3057\u305F\u3089\u3000{\u6EDD|\u305F\u304D}\u306E\u307B\u3046\u304B\u3089\\n\u3076\u308F\u3063\u3068\u3000\u30D5\u30EA\u30FC\u30B6\u30FC\u304C\u3000{\u964D|\u304A}\u308A\u3066\u304D\u3066\\r\\n\u307C\u304F\u306E{\u982D\u4E0A|\u305A\u3058\u3087\u3046}\u3092\u3000{\u6B4C|\u3046\u305F}\u3044\u306A\u304C\u3089\u3000{\u98DB|\u3068}\u3073\u307E\u308F\u3063\u305F\uFF01",
  "\u307C\u304F\u306F\u3000\u3046\u308C\u3057\u304F\u306A\u3063\u3066\u3000\u30D5\u30EA\u30FC\u30B6\u30FC\u3068\\n{\u65E5|\u3072}\u304C{\u66AE|\u304F}\u308C\u3066\u3082\u3000{\u6B4C|\u3046\u305F}\u3044{\u7D9A|\u3064\u3065}\u3051\u3066\u306D\uFF1F\\r\\n{\u6C17|\u304D}\u3065\u3044\u305F\u3089\u3000{\u671D|\u3042\u3055}\u306B\u3000\u306A\u3063\u3066\u3044\u305F\u3088",
  "\u30B5\u30F3\u30C0\u30FC\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3067\u3000{\u706F\u53F0|\u3068\u3046\u3060\u3044}\u306B\u3000\u306E\u307C\u3063\u3066\\n{\u9060|\u3068\u304A}\u304F\u306B{\u898B|\u307F}\u3048\u308B\u3000{\u753A|\u307E\u3061}\u3092\u3000\u306A\u304C\u3081\u3066\u3044\u305F\u306E",
  "\u305D\u3046\u3057\u305F\u3089\u3000\u30B6\u30FC\u30B6\u30FC\u3068\u3000{\u6025|\u304D\u3085\u3046}\u306B{\u96E8|\u3042\u3081}\uFF01\\n\u307C\u304F\u306F\u3000\u3053\u308A\u3083\u3044\u304B\u3093\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\\r\\n{\u706F\u53F0|\u3068\u3046\u3060\u3044}\u3092\u3000{\u964D|\u304A}\u308A\u3088\u3046\u3068\u3000\u3057\u305F\u3093\u3060\u3088",
  "\u3059\u308B\u3068\u3000\u30D3\u30AB\u30D3\u30AB\u30C3\u3068\u3000{\u5149|\u3072\u304B}\u3063\u305F\u3068\u3053\u308D\u306B\\n\u3059\u3054\u3044{\u52E2|\u3044\u304D\u304A}\u3044\u3067\u3000\u30B5\u30F3\u30C0\u30FC\u304C\u3000{\u98DB|\u3068}\u3093\u3067\u304D\u305F\uFF01\\r\\n\u307C\u304F\u306E{\u6A2A|\u3088\u3053}\u3092\u3000{\u901A|\u3068\u304A}\u308A{\u904E|\u3059}\u304E\u3066\u3000\u3044\u3063\u305F\u3093\u3060\u3088\u306D",
  "\u30D5\u30A1\u30A4\u30E4\u30FC\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2\u306E\u3000{\u897F|\u306B\u3057}\u306E\u307B\u3046\u3067\\n\u30ED\u30C3\u30AF\u30AF\u30E9\u30A4\u30DF\u30F3\u30B0\u3092\u3000\u3057\u3066\u3044\u305F\u306E\u306D",
  "\u305D\u306E{\u65E5|\u3072}\u306F\u3000{\u5929\u6C17|\u3066\u3093\u304D}\u304C\u3000\u30D6\u30EF\u30C3\u3068\u3000{\u7802\u5D50|\u3059\u306A\u3042\u3089\u3057}\uFF01\\n{\u53E3|\u304F\u3061}\u306E{\u4E2D|\u306A\u304B}\u304C\u3000{\u7802|\u3059\u306A}\u3060\u3089\u3051\u3067\u3000{\u5ACC|\u3044\u3084}\u3041\u306B\u306A\u3063\u3066\u306D\\r\\n\u30AF\u30E9\u30A4\u30DF\u30F3\u30B0\u3092\u3000\u3084\u3081\u3088\u3046\u3068\u3057\u305F\u3000\u305D\u306E\u3068\u304D",
  "{\u7802\u5D50|\u3059\u306A\u3042\u3089\u3057}\u306E{\u4E2D|\u306A\u304B}\u3067\u3082\u3000{\u898B|\u307F}\u3048\u308B\u3088\u3046\u306A\\n\u307E\u3076\u3057\u3055\u3067\u3000\u30D5\u30A1\u30A4\u30E4\u30FC\u304C\u3000{\u73FE|\u3042\u3089\u308F}\u308C\u3066\\r\\n\u307C\u304F\u3092\u3000\u306F\u3052\u307E\u3057\u3066\u304F\u308C\u305F\u3093\u3060\u3088\u306D\uFF1F\\r\\n\u305D\u306E\u304A\u304B\u3052\u3067\u3000{\u5D16|\u304C\u3051}\u3092\u3000{\u767B|\u306E\u307C}\u308A\u304D\u308C\u305F\u3088",
  "\u30E9\u30A4\u30B3\u30A6\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30E9\u30A4\u30B3\u30A6\u3068\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\\n{\u5C71\u767B|\u3084\u307E\u306E\u307C}\u308A\u3092\u3000\u3057\u305F\u3053\u3068\u304C\u3000\u3042\u3063\u305F\u3093\u3060\u3088\u306D",
  "\u30E9\u30A4\u30B3\u30A6\u3063\u3066\u3000\u3068\u3063\u3066\u3082\u3000{\u7D20\u65E9|\u3059\u3070\u3084}\u3044\u304B\u3089\\n\u307C\u304F\u306E{\u5148|\u3055\u304D}\u3092\u3000\u3050\u3050\u30FC\u3093\u3068\u3000{\u884C|\u3044}\u3063\u3061\u3083\u3046\u308F\u3051\\c\\n\u3060\u304B\u3089\u3000\u307C\u304F\u306F\u3000\u306A\u306B\u304F\u305D\u30FC\u3063\u3066\\n\u30E9\u30A4\u30B3\u30A6\u3092\u3000{\u5FC5\u6B7B|\u3072\u3063\u3057}\u306B\u3000{\u8FFD|\u304A}\u3044\u304B\u3051\u308B\u306E\u306D",
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u306B\u306F\u3000{\u5317|\u304D\u305F}\u306E{\u5927\u5730|\u3060\u3044\u3061}\u306B\u3000{\u5E83|\u3072\u308D}\u304C\u308B\\n\u3059\u3054\u304F{\u58EE\u5927|\u305D\u3046\u3060\u3044}\u306A\u3000{\u7802\u6F20|\u3055\u3070\u304F}\u306E{\u666F\u8272|\u3051\u3057\u304D}\u3092\u306D\\r\\n\u30E9\u30A4\u30B3\u30A6\u306E{\u96A3|\u3068\u306A\u308A}\u3067\u3000{\u898B|\u307F}\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u305F\u3093\u3060",
  "\u30A8\u30F3\u30C6\u30A4\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3092\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3057\u3066\u3044\u305F\u3089\\n\u305F\u307E\u305F\u307E\u3000{\u4F1A|\u3042}\u3063\u305F\u3053\u3068\u304C\u3000\u3042\u3063\u3066\u306D",
  "\u305D\u3053\u306F\u3000{\u9271\u5C71|\u3053\u3046\u3056\u3093}\u3067\u3000{\u5730\u9762|\u3058\u3081\u3093}\u304C\u3000{\u6398|\u307B}\u3089\u308C\u3066\u3066\\n\u3042\u3061\u3053\u3061\u3000{\u7A74|\u3042\u306A}\u304C\u3000\u3042\u3044\u3066\u3044\u308B\u3093\u3060\u3051\u3069\\c\\n\u30A8\u30F3\u30C6\u30A4\u306F\u3000{\u5927|\u304A\u304A}\u304D\u306A{\u7A74|\u3042\u306A}\u3067\u3082\\n\u30D3\u30E5\u30D3\u30E5\u30F3\u30C3\u3068\u3000\u3072\u3068\u3063{\u8DF3|\u3068}\u3073\uFF01",
  "\u307C\u304F\u3082\u306D\u3000\u30A8\u30F3\u30C6\u30A4\u306B\u3000{\u8CA0|\u307E}\u3051\u3058\u3068\\n{\u4E00\u751F\u61F8\u547D|\u3044\u3063\u3057\u3087\u3046\u3051\u3093\u3081\u3044}\u3000\u3064\u3044\u3066\u3044\u3063\u3066\\r\\n\u3064\u3044\u306B\u306F\u3000\u306A\u3089\u3093\u3067\u3000{\u6D77|\u3046\u307F}\u3092{\u898B|\u307F}\u305F\u3093\u3060\u3088",
  "\u30B9\u30A4\u30AF\u30F3\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u3042\u308B{\u65E5|\u3072}\u3000\u30D1\u30EB\u30C7\u30A2\u306E\u3000{\u6709\u540D|\u3086\u3046\u3081\u3044}\u306A{\u6E56|\u307F\u305A\u3046\u307F}\u3067\\n\u30B9\u30A4\u30AF\u30F3\u3092\u3000{\u898B|\u307F}\u304B\u3051\u305F\u304B\u3089\u306D",
  "\u307C\u304F\u3068\u3000\u30B9\u30A4\u30AF\u30F3\\n\u3069\u3063\u3061\u304C\u3000{\u901F|\u306F\u3084}\u304F\u3000{\u5CB8|\u304D\u3057}\u307E\u3067\u3000{\u6CF3|\u304A\u3088}\u3052\u308B\u304B\\r\\n{\u7AF6\u8D70|\u304D\u3087\u3046\u305D\u3046}\u3057\u3088\u3046\u3063\u3066\u3000{\u8A00|\u3044}\u3063\u305F\u306E\u306D",
  "\u3088\u3046\u3044\u30C9\u30F3\u3067\u3000{\u6CF3|\u304A\u3088}\u304E{\u59CB|\u306F\u3058}\u3081\u305F\u3089\\n\u30B9\u30A4\u30AF\u30F3\u306F\u3000{\u6C34|\u307F\u305A}\u306E{\u4E0A|\u3046\u3048}\u3092\u3000{\u8D70|\u306F\u3057}\u308B\u304B\u3089\u3000{\u901F|\u306F\u3084}\u304F\u3066\u306D\\r\\n\u3053\u3063\u3061\u306F\u3000{\u4EBA\u9593|\u306B\u3093\u3052\u3093}\u3060\u304B\u3089\u3000{\u80CC\u6CF3|\u305B\u304A\u3088}\u304E\u3060\u3088\uFF1F\\c\\n\u3044\u3044{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3060\u3063\u305F\u3093\u3060\u3051\u3069\u306D\\n\u30AE\u30EA\u30AE\u30EA\u3000{\u8CA0|\u307E}\u3051\u3061\u3083\u3063\u305F\u3093\u3060",
  "\u30EB\u30AE\u30A2\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u304D\u308C\u3044\u306A\u3000\u30D1\u30EB\u30C7\u30A2\u306E{\u6D77|\u3046\u307F}\u3092\\n{\u80CC\u6CF3|\u305B\u304A\u3088}\u304E\u3067\u3000{\u79FB\u52D5|\u3044\u3069\u3046}\u3057\u3066\u305F\u3093\u3060\u3088",
  "\u3059\u3063\u3054\u304F\u3000{\u51B7|\u3064\u3081}\u305F\u3044{\u6D77|\u3046\u307F}\u3000\u3060\u3063\u305F\u304B\u3089\\n{\u5C11|\u3059\u3053}\u3057{\u6CF3|\u304A\u3088}\u3044\u3060\u3089\u3000{\u5BD2|\u3055\u3080}\u304F\u306A\u3063\u3061\u3083\u3063\u3066\u306D\\c\\n\u30D6\u30EB\u30D6\u30EB\u30C3\u3068\u3000\u3075\u308B\u3048\u306A\u304C\u3089\\n{\u8FD1|\u3061\u304B}\u304F\u306E{\u5CF6|\u3057\u307E}\u306B\u3000{\u4E0A\u9678|\u3058\u3087\u3046\u308A\u304F}\u3057\u305F\u306E",
  "\u305D\u3046\u3057\u305F\u3089\u3000{\u8FD1|\u3061\u304B}\u304F\u306B\u3000{\u5927|\u304A\u304A}\u304D\u306A{\u6E26|\u3046\u305A}\u304C\u3000\u3067\u304D\u3066\\n{\u6D77|\u3046\u307F}\u304B\u3089\u3000\u3076\u308F\u3063\u3068\u3000\u30EB\u30AE\u30A2\u304C\u3000{\u51FA|\u3067}\u3066\u304D\u305F\uFF01\\c\\n\u3053\u308C\u306B\u306F\u3000\u307C\u304F\u3082\u3000\u305F\u307E\u3052\u305F\u306D\\n\u3046\u308C\u3057\u304F\u306A\u3063\u3066\u3000{\u5BD2|\u3055\u3080}\u3055\u3082\u3000\u3075\u3063{\u98DB|\u3068}\u3093\u3060\u3088",
  "\u30DB\u30A6\u30AA\u30A6\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u3042\u306E\u3068\u304D\u306F\u3000\u307C\u304F\u3082\u3000\u305D\u3046\u2026\u2026\\n\u307E\u3060\u307E\u3060\u3000\u304B\u3051\u3060\u3057\u30C8\u30EC\u30FC\u30CA\u30FC\u3000\u3060\u3063\u305F\u306D",
  "\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u306E\u3000{\u5357\u897F|\u306A\u3093\u305B\u3044}\u306E{\u6EDD|\u305F\u304D}\\n\u305D\u306E{\u8FD1|\u3061\u304B}\u304F\u3067\u3000\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u5F37|\u3064\u3088}\u304F\u3059\u308B\u305F\u3081\u306B\\r\\n{\u591C\u901A|\u3088\u3069\u304A}\u3057\u3000{\u8A13\u7DF4|\u304F\u3093\u308C\u3093}\u3057\u3066\u3044\u305F\u3000\u305D\u306E\u3068\u304D\uFF01",
  "\u30AD\u30E9\u30AD\u30E9\u30C3\u3068\u3000\u304B\u304C\u3084\u304D\u306A\u304C\u3089\\n{\u4E0A\u7A7A|\u3058\u3087\u3046\u304F\u3046}\u306B\u3000\u30DB\u30A6\u30AA\u30A6\u304C\u3000{\u73FE|\u3042\u3089\u308F}\u308C\u305F\u3093\u3060\u3088\uFF01\\c\\n\u30DB\u30A6\u30AA\u30A6\u306F\u3000\u304D\u3063\u3068\u3000\u307C\u304F\u3092\\n{\u5FDC\u63F4|\u304A\u3046\u3048\u3093}\u3057\u306B\u3000\u304D\u3066\u304F\u308C\u305F\u306E\u304B\u3082\u306D",
  "\u30E9\u30C6\u30A3\u30A2\u30B9\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2\u306E\u3000{\u5357|\u307F\u306A\u307F}\u306E{\u6D77|\u3046\u307F}\u3067\\n{\u80CC\u6CF3|\u305B\u304A\u3088}\u304E\u3092\u3000\u3057\u3066\u3044\u305F\u3093\u3060\u3088\u306D",
  "\u3072\u3068\u3057\u304D\u308A\u3000{\u6CF3|\u304A\u3088}\u3044\u3067\\n\u3055\u3059\u304C\u306B\u3000\u3061\u3087\u3063\u3068\u3000{\u75B2|\u3064\u304B}\u308C\u3061\u3083\u3063\u305F\u304B\u3089\\r\\n{\u9678|\u308A\u304F}\u306B{\u623B|\u3082\u3069}\u3063\u3066\u3000{\u5CA9\u9670|\u3044\u308F\u304B\u3052}\u3067\u3000\u3072\u3068{\u4F11|\u3084\u3059}\u307F\u3000\u3057\u3066\u3044\u305F\u306E",
  "\u305D\u3053\u306B\u3000\u3061\u3087\u30FC\u3046\u3069\u3000{\u5076\u7136|\u3050\u3046\u305C\u3093}\u306D\uFF01\\n\u30E9\u30C6\u30A3\u30A2\u30B9\u304C\u3000\u3053\u308D\u3063\u3068\u3000\u3044\u3066\u306D\\c\\n\u307C\u304F\u3068\u3000{\u76EE|\u3081}\u304C{\u5408|\u3042}\u3046\u3068\u3000\u306B\u3063\u3053\u308A\u3000{\u7B11|\u308F\u3089}\u3063\u3066\\n\u3069\u3053\u304B\u3078\u3000{\u98DB|\u3068}\u3093\u3067\u3044\u3063\u305F\u3093\u3060",
  "\u30E9\u30C6\u30A3\u30AA\u30B9\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2\u306E\u3000{\u5317\u6771|\u307B\u304F\u3068\u3046}\u306E\u307B\u3046\u3067\\n\u3070\u3063\u305F\u308A\u3068\u3000{\u4F1A|\u3042}\u3063\u305F\u3053\u3068\u304C\u3000\u3042\u3063\u3066\u306D",
  "{\u8A00\u8449|\u3053\u3068\u3070}\u306F\u3000\u308F\u304B\u3089\u306A\u3044\u3093\u3060\u3051\u3069\\n\u3064\u3044\u3066\u3053\u3044\u3068\u3000{\u8A00|\u3044}\u308F\u308C\u305F\u3000{\u6C17|\u304D}\u304C\u3057\u3066\\c\\n{\u98DB|\u3068}\u3093\u3067\u3044\u304F\u3000\u30E9\u30C6\u30A3\u30AA\u30B9\u3092\u3000{\u8FFD|\u304A}\u3044\u304B\u3051\u3066\\n\u30C8\u30B2\u30C8\u30B2\u3057\u305F\u3000{\u5CA9\u5834|\u3044\u308F\u3070}\u3092\u3000{\u767B|\u306E\u307C}\u3063\u3066\u3044\u3063\u305F\u308F\u3051",
  "{\u6C17|\u304D}\u3065\u3044\u305F\u3089\u3000\u307E\u308F\u308A\u304C\\n{\u5D16|\u304C\u3051}\u306B\u3000\u304B\u3053\u307E\u308C\u305F\u3000{\u6C60|\u3044\u3051}\u3060\u3063\u305F\u3093\u3060\u3088\\r\\n\u304D\u3063\u3068\u3000{\u79D8\u5BC6|\u3072\u307F\u3064}\u306E{\u5834\u6240|\u3070\u3057\u3087}\u3000\u3060\u3063\u305F\u3093\u3060\u306D",
  "\u30AB\u30A4\u30AA\u30FC\u30AC\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3092\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3057\u3066\u3044\u305F\u3089\\n{\u6D77|\u3046\u307F}\u3067\u3000{\u5909|\u304B}\u308F\u3063\u305F{\u5CA9|\u3044\u308F}\u3092\u3000{\u898B|\u307F}\u304B\u3051\u3066\u306D",
  "\u3042\u3063\u3000\u3053\u308C\u306F\u3000{\u6709\u540D|\u3086\u3046\u3081\u3044}\u306A\\n\u3054{\u5229\u76CA|\u308A\u3084\u304F}\u304C\u3042\u308B\u3000{\u5CA9|\u3044\u308F}\u3060\uFF01\\r\\n\u2026\u2026\u3063\u3066\u3000{\u601D|\u304A\u3082}\u3044{\u51FA|\u3060}\u3057\u3066\u306D\\c\\n\u3058\u3083\u3042\u3000\u305D\u308C\u306A\u3089\u3068\u3000{\u76EE|\u3081}\u3092\u3064\u3076\u3063\u3066\\n\u304A{\u9858|\u306D\u304C}\u3044\u3054\u3068\u3092\u3000\u3057\u3066\u307F\u305F\u306E",
  "\u3057\u3070\u3089\u304F\u3000{\u7D4C|\u305F}\u3063\u3066\u3000{\u76EE|\u3081}\u3092\u3042\u3051\u305F\u3089\\n{\u5CA9|\u3044\u308F}\u306E{\u624B\u524D|\u3066\u307E\u3048}\u306B\u3000\u306A\u3093\u3068\uFF01\\c\\n\u30AB\u30A4\u30AA\u30FC\u30AC\u304C\u3000\u30BA\u30C9\u30F3\u30C3\u3066\u3000{\u73FE|\u3042\u3089\u308F}\u308C\u305F\u306E\uFF01\\n\u307C\u304F\u3000\u3068\u3063\u3066\u3082\u3000{\u9A5A|\u304A\u3069\u308D}\u3044\u3061\u3083\u3063\u305F\u3093\u3060\u304B\u3089\uFF01",
  "\u30B0\u30E9\u30FC\u30C9\u30F3\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3092\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3057\u3066\u3044\u305F\u3068\u304D\u306B\\n\u30B0\u30E9\u30FC\u30C9\u30F3\u3092\u3000{\u898B|\u307F}\u304B\u3051\u305F\u3053\u3068\u304C\u3000\u3042\u3063\u3066\u306D",
  "{\u753A|\u307E\u3061}\u306E{\u4E0B|\u3057\u305F}\u306B\u3000{\u5927|\u304A\u304A}\u304D\u306A{\u7A7A\u6D1E|\u304F\u3046\u3069\u3046}\u304C\u3000\u3042\u308B\u3067\u3057\u3087\u3046\uFF1F\\n\u306A\u3093\u3066\u3044\u3046\u3000{\u540D\u524D|\u306A\u307E\u3048}\u306E{\u753A|\u307E\u3061}\u3000\u3060\u3063\u305F\u304B\u306A\u2026\u2026\\c\\n\u3068\u3082\u304B\u304F\u3000\u305D\u3053\u306B\\n\u30C1\u30E9\u30C3\u3068\u3000\u3044\u305F\u3093\u3060\u3088",
  "\u3042\u3063\u3000\u30B0\u30E9\u30FC\u30C9\u30F3\u3060\u3063\u3066\u3000{\u601D|\u304A\u3082}\u3063\u3066\\n{\u5143\u6C17|\u3052\u3093\u304D}\u3088\u304F\u3000{\u6328\u62F6|\u3042\u3044\u3055\u3064}\u3057\u3066\u307F\u305F\u306E\\r\\n\u3060\u3063\u3066\u3000\u305F\u3044\u308A\u304F\u30DD\u30B1\u30E2\u30F3\u3000\u3060\u304B\u3089\u306D\\r\\n\u305D\u3046\u3057\u305F\u3089\u3000{\u5927|\u304A\u304A}\u304D\u306A\u30C4\u30E1\u3092\u3000{\u898B|\u307F}\u305B\u3066\u304F\u308C\u305F\u3088",
  "\u30EC\u30C3\u30AF\u30A6\u30B6\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2\u3067\u3000\u3059\u3063\u3054\u304F\u3000\u3051\u308F\u3057\u3044{\u5D16|\u304C\u3051}\u3092\\n\u3048\u3044\u3084\u3063\u3066\u3000\u30AF\u30E9\u30A4\u30DF\u30F3\u30B0\u3000\u3057\u3066\u3044\u305F\u306E",
  "{\u767B|\u306E\u307C}\u308A\u304D\u3063\u305F\u3000\u3068\u3053\u308D\u304C\\n\u307E\u3041\u3000\u3059\u3063\u3054\u304F{\u7D76\u666F|\u305C\u3063\u3051\u3044}\u3067\u306D\\c\\n{\u898B\u4E0B|\u307F\u304A}\u308D\u3057\u305F\u3089\u3000\u305D\u3053\u306F\\n{\u8996\u754C|\u3057\u304B\u3044}{\u4E00\u9762|\u3044\u3061\u3081\u3093}\u306E\u3000{\u767D|\u3057\u308D}\u3044{\u96F2|\u304F\u3082}\uFF01\\r\\n{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u306A{\u5834\u6240|\u3070\u3057\u3087}\u3000\u3060\u3063\u305F\u306D\u30FC",
  "\u305D\u3046\u3057\u305F\u3089\u3000{\u96F2|\u304F\u3082}\u3092\u3000{\u7A81|\u3064}\u304D{\u629C|\u306C}\u3051\u3066\\n\u30EC\u30C3\u30AF\u30A6\u30B6\u304C\u3000\u30BA\u30D0\u30C3\u3068\u3000{\u98DB|\u3068}\u3073{\u51FA|\u3060}\u3057\u3066\u304D\u305F\uFF01\\r\\n\u3042\u308C\u306F\u306D\u30FC\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000{\u9A5A|\u304A\u3069\u308D}\u3044\u305F\u3088",
  "\u30B3\u30D0\u30EB\u30AA\u30F3\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2\u3092\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3057\u3066\u3044\u305F\u3089\u3000{\u5D16|\u304C\u3051}\u304B\u3089\\n\u30B3\u30D0\u30EB\u30AA\u30F3\u304C\u3000\u3072\u3087\u3044\u3063\u3068\u3000{\u964D|\u304A}\u308A\u3066\u304D\u3066\u306D",
  "\u3042\u308C\u307E\u3042\u3068\u3000\u307C\u304F\\n\u3057\u3070\u3089\u304F\u3000\u3042\u3063\u3051\u306B\u3000\u3068\u3089\u308C\u3066\u3044\u305F\u3089\\c\\n\u307C\u304F\u306E{\u9854|\u304B\u304A}\u304C\u3000\u304A\u3082\u3057\u308D\u304B\u3063\u305F\u306E\u304B\u306A\uFF1F\\n\u30B3\u30D0\u30EB\u30AA\u30F3\u306F\u3000\u3086\u3063\u304F\u308A\u3000{\u6B69|\u3042\u308B}\u304D{\u59CB|\u306F\u3058}\u3081\u3066\u306D\\c\\n{\u8FD1|\u3061\u304B}\u304F\u306B\u3042\u3063\u305F\u3000{\u6709\u540D|\u3086\u3046\u3081\u3044}\u306A\\n{\u6EDD|\u305F\u304D}\u3092\u3000{\u6848\u5185|\u3042\u3093\u306A\u3044}\u3057\u3066\u304F\u308C\u305F\u3093\u3060\u3088",
  "\u304A{\u793C|\u308C\u3044}\u3092\u3000{\u8A00|\u3044}\u3063\u305F\u3089\u3000\u30B3\u30D0\u30EB\u30AA\u30F3\u306F\\n{\u7AF9|\u305F\u3051}\u3084\u3076\u3092\u3000{\u8D70|\u306F\u3057}\u308A{\u629C|\u306C}\u3051\u3066\u3000\u3044\u3063\u3061\u3083\u3063\u305F\u3088",
  "\u30C6\u30E9\u30AD\u30AA\u30F3\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u3042\u308B{\u65E5|\u3072}\u3000\u3044\u3064\u3082\u306E\u3088\u3046\u306B\\n\u30ED\u30C3\u30AF\u30AF\u30E9\u30A4\u30DF\u30F3\u30B0\u3092\u3000{\u697D|\u305F\u306E}\u3057\u3093\u3067\u3044\u305F\u3093\u3060",
  "\u3051\u3063\u3053\u3046\u306A\u3000{\u9AD8|\u305F\u304B}\u3055\u307E\u3067\u3000{\u767B|\u306E\u307C}\u3063\u305F\u3068\u3053\u308D\u3067\\n\u3075\u308A{\u8FD4|\u304B\u3048}\u3063\u3066\u307F\u308B\u3068\u3000\u3061\u3087\u30FC\u3046\u3069\u3000{\u5357|\u307F\u306A\u307F}\u306E\u307B\u3046\u306B\\r\\n\u30BB\u30EB\u30AF\u30EB\u30BF\u30A6\u30F3\u304C\u3000{\u5C0F|\u3061\u3044}\u3055\u304F\u3000{\u898B|\u307F}\u3048\u3066\u306D\\c\\n\u3057\u3070\u3089\u304F\u3000{\u898B\u5165|\u307F\u3044}\u3063\u3066\u3044\u305F\u3089\u3000{\u7A81\u7136|\u3068\u3064\u305C\u3093}\\n\u307C\u304F\u306E{\u6A2A|\u3088\u3053}\u306B\u3000\u30C6\u30E9\u30AD\u30AA\u30F3\u304C\u3000{\u5EA7|\u3059\u308F}\u3063\u3066\u306D\uFF01",
  "\u306A\u3093\u3060\u304B\u3000\u30D2\u30DE\u305D\u3046\u3060\u3063\u305F\u304B\u3089\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000\u304A\u3084\u3064\u3092\u3000{\u98DF|\u305F}\u3079\u305F\u3088",
  "\u30D3\u30EA\u30B8\u30AA\u30F3\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3092\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3057\u3066\u3044\u305F\u3089\\n\u30D3\u30EA\u30B8\u30AA\u30F3\u304C\u3000{\u6728\u9670|\u3053\u304B\u3052}\u3067\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u3044\u305F\u3093\u3060",
  "\u305D\u306E\u3000{\u6728|\u304D}\u3063\u3066\u3044\u3046\u306E\u304C\u3000\u306A\u3093\u3060\u304B\\n\u3075\u3057\u304E\u306A{\u6A21\u69D8|\u3082\u3088\u3046}\u3092\u3000\u3057\u3066\u3044\u3066\u306D\uFF1F\\c\\n\u3057\u3070\u3089\u304F\u306E{\u9593|\u3042\u3044\u3060}\u3000{\u6728|\u304D}\u3068\u3000\u30D3\u30EA\u30B8\u30AA\u30F3\u3092\\n{\u4EA4\u4E92|\u3053\u3046\u3054}\u306B\u3000{\u898B|\u307F}\u3066\u3000{\u697D|\u305F\u306E}\u3057\u3093\u3067\u305F\u3093\u3060\u3088",
  "\u305D\u3046\u3057\u305F\u3089\u3000\u30D3\u30EA\u30B8\u30AA\u30F3\u3082\u3000\u307C\u304F\u306E\u307B\u3046\u3092\\n{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u305D\u3046\u306B\u3000{\u898B|\u307F}\u3064\u3081\u308B\u3082\u3093\u3067\u306D\uFF1F\\c\\n{\u5192\u967A|\u307C\u3046\u3051\u3093}\u306E{\u8A71|\u306F\u306A\u3057}\u3092\u3000\u3057\u3066\u3042\u3052\u305F\u3089\\n{\u697D|\u305F\u306E}\u3057\u305D\u3046\u306B\u3000{\u805E|\u304D}\u3044\u3066\u304F\u308C\u305F\u3093\u3060\u3088",
  "\u30EC\u30B7\u30E9\u30E0\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u306E\u3000\u3068\u3042\u308B{\u753A|\u307E\u3061}\u306E\u3000{\u8FD1|\u3061\u304B}\u304F\u3067\\n\u30EC\u30B7\u30E9\u30E0\u3092\u3000{\u898B|\u307F}\u304B\u3051\u305F\u3053\u3068\u304C\u3000\u3042\u308B\u3093\u3060\u3088",
  "\u305D\u306E{\u753A|\u307E\u3061}\u306F\u3000{\u4F5C\u696D\u54E1|\u3055\u304E\u3087\u3046\u3044\u3093}\u3055\u3093\u304C\\n\u3044\u3063\u3071\u3044\u3000\u3044\u3089\u3063\u3057\u3083\u308B\u3000{\u753A|\u307E\u3061}\u3067\u306D\\c\\n{\u5F7C|\u304B\u308C}\u3089\u306E\u3000\u304C\u3093\u3070\u308A\u3092\u3000{\u5CA9\u5834|\u3044\u308F\u3070}\u306E{\u4E0A|\u3046\u3048}\u304B\u3089\\n\u307C\u304F\u3000\u305A\u3063\u3068\u3000\u306A\u304C\u3081\u3066\u3044\u305F\u306E",
  "\u304C\u3093\u3070\u3063\u3066\u308B\u306A\u3042\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\u305F\u3089\\n{\u80CC\u5F8C|\u306F\u3044\u3054}\u306B\u3000{\u6C17\u914D|\u3051\u306F\u3044}\u3092\u3000{\u611F|\u304B\u3093}\u3058\u3066\u306D\\c\\n\u3075\u308A{\u5411|\u3080}\u3044\u305F\u3089\u3000\u30EC\u30B7\u30E9\u30E0\u304C\\n\u305D\u3053\u306B\u3000{\u7ACB|\u305F}\u3063\u3066\u3044\u305F\u306E\uFF01\\c\\n\u30EC\u30B7\u30E9\u30E0\u3082\u3000\u304C\u3093\u3070\u3063\u3066\u308B\\n{\u4F5C\u696D\u54E1|\u3055\u304E\u3087\u3046\u3044\u3093}\u3055\u3093\u305F\u3061\u304C\u3000{\u597D|\u3059}\u304D\u306A\u306E\u304B\u3082\u306D\u3047",
  "\u30BC\u30AF\u30ED\u30E0\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30C6\u30FC\u30D6\u30EB\u30B7\u30C6\u30A3\u304B\u3089\u3000\u30DC\u30A6\u30EB\u30BF\u30A6\u30F3\u307E\u3067\\n{\u6B69|\u3042\u308B}\u3044\u3066\u3000{\u5411|\u3080}\u304B\u3063\u3066\u3044\u305F\u3093\u3060\u3088",
  "\u305D\u3046\u3057\u305F\u3089\u3000{\u6771|\u3072\u304C\u3057}\u306E{\u7A7A|\u305D\u3089}\u306B\u3000{\u5927|\u304A\u304A}\u304D\u306A\\n{\u9ED2|\u304F\u308D}\u3044{\u5F71|\u304B\u3052}\u304C\u3000\u30D3\u30E5\u30D0\u30C3\u3068\u3000{\u98DB|\u3068}\u3093\u3067\u3044\u305F\uFF01\\c\\n\u306A\u3093\u3060\u306A\u3093\u3060\uFF01\uFF1F\u3000\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\\n{\u9AD8|\u305F\u304B}\u3044\u3068\u3053\u308D\u306B\u3000{\u767B|\u306E\u307C}\u3063\u3066\u307F\u305F\u3089\u3000\u30BC\u30AF\u30ED\u30E0\u3060\uFF01",
  "\u307C\u304F\u3000\u3073\u3063\u304F\u308A\u3057\u3066\u3000\u30DD\u30AB\u30F3\u3068\u3000{\u898B\u4E0A|\u307F\u3042}\u3052\u3066\u305F\u3089\\n\u30BC\u30AF\u30ED\u30E0\u304C\u3000\u307C\u304F\u306E\u3068\u3053\u308D\u306B\u3000{\u964D|\u304A}\u308A\u3066\u304D\u3066\u306D\\c\\n\u3057\u3070\u3089\u304F\u3000{\u898B|\u307F}\u3064\u3081\u3042\u3063\u305F\u3093\u3060\u3051\u3069\\n\u3044\u3084\u3042\u3000\u30BC\u30AF\u30ED\u30E0\u3000{\u683C\u597D|\u304B\u3063\u3053\u3046}\u3088\u304B\u3063\u305F\u306D\u3047",
  "\u30AD\u30E5\u30EC\u30E0\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u3092\u3000{\u767B|\u306E\u307C}\u3063\u3066\u305F\u3089\\n\u3059\u3054\u3044{\u5439\u96EA|\u3075\u3076\u304D}\u306B\u3000\u307F\u307E\u308F\u308C\u3066\u306D\\r\\n\u3053\u308A\u3083\u305F\u307E\u3089\u3093\u3068\u3000{\u6D1E|\u3069\u3046}\u304F\u3064\u306B\u3000{\u5165|\u306F\u3044}\u3063\u305F\u3089",
  "\u305D\u306E{\u6D1E|\u3069\u3046}\u304F\u3064\u304C\u306D\u3047\u3000\u3059\u3063\u3054\u304F\u3000{\u5E83|\u3072\u308D}\u304F\u3066\\n\u307E\u308B\u3067\u3000{\u8FF7\u8DEF|\u3081\u3044\u308D}\u307F\u305F\u3044\u306A\u306E\uFF01\\c\\n\u307C\u304F\u3000{\u697D|\u305F\u306E}\u3057\u304F\u306A\u3063\u3061\u3083\u3063\u3066\\n{\u4E2D|\u306A\u304B}\u3092\u3000{\u63A2\u691C|\u305F\u3093\u3051\u3093}\u3057\u3066\u3044\u305F\u3089\\r\\n{\u7A81\u7136|\u3068\u3064\u305C\u3093}\u3000{\u6C37|\u3053\u304A\u308A}\u306E{\u58C1|\u304B\u3079}\u304C\u3000{\u52D5|\u3046\u3054}\u304D\u3060\u3057\u3066\u306D\uFF1F",
  "\u3084\u3084\uFF01\uFF1F\u3000\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\\n{\u76EE|\u3081}\u3092\u3053\u3089\u3057\u3066\u3000\u3088\u304F{\u898B|\u307F}\u305F\u3089\\r\\n\u30AD\u30E5\u30EC\u30E0\u3060\u3063\u305F\u306E\uFF01\u3000\u30D3\u30C3\u30AF\u30EA\u3067\u3057\u3087\u3046\uFF1F",
  "\u30BD\u30EB\u30AC\u30EC\u30AA\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u306E\\n\u30DD\u30B1\u30E2\u30F3\u30EA\u30FC\u30B0\u3092\u3000{\u898B|\u307F}\u306B\u3044\u3063\u305F\u3093\u3060",
  "{\u5916|\u305D\u3068}\u304B\u3089\u3000{\u898B|\u307F}\u3066\u305F\u3089\u3000\u30B9\u30BF\u30C3\u30D5\u3055\u3093\u304C\\n\u307C\u304F\u306B\u3000{\u6C17|\u304D}\u3065\u3044\u3066\u3000{\u4E2D|\u306A\u304B}\u306B\u3000{\u5165|\u3044}\u308C\u3066\u304F\u308C\u3066\\c\\n\u30EA\u30FC\u30B0\u306E\u30DE\u30FC\u30AF\u304C\u3000{\u63CF|\u304B}\u304B\u308C\u3066\u308B\\n{\u5C55\u671B|\u3066\u3093\u307C\u3046}\u30D5\u30ED\u30A2\u307E\u3067\u3000{\u6848\u5185|\u3042\u3093\u306A\u3044}\u3057\u3066\u304F\u308C\u305F\u306E\\c\\n\u305D\u3053\u3067\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E\u307B\u3046\u3092\u3000\u306A\u304C\u3081\u3066\u305F\u3089\\n{\u7A81\u7136|\u3068\u3064\u305C\u3093}\u3000{\u5927|\u304A\u304A}\u304D\u306A{\u5F71|\u304B\u3052}\u304C\u3000{\u6A2A\u5207|\u3088\u3053\u304E}\u3063\u3066\u306D\uFF01",
  "\u305D\u306E{\u6B63\u4F53|\u3057\u3087\u3046\u305F\u3044}\u306F\u3000\u306A\u3093\u3068\u3000\u30BD\u30EB\u30AC\u30EC\u30AA\uFF01\\c\\n{\u4E00\u77AC|\u3044\u3063\u3057\u3085\u3093}\u3067\u3000{\u8D70|\u306F\u3057}\u308A{\u53BB|\u3055}\u3063\u3061\u3083\u3063\u3066\\n{\u6328\u62F6|\u3042\u3044\u3055\u3064}\u3067\u304D\u306A\u304B\u3063\u305F\u3051\u3069\u3000{\u683C\u597D|\u304B\u3063\u3053\u3046}\u3088\u304B\u3063\u305F\u306D\u3047",
  "\u30EB\u30CA\u30A2\u30FC\u30E9\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u306E\u3000\u30D3\u30FC\u30C1\u3067\\n{\u5915\u65E5|\u3086\u3046\u3072}\u3092\u3000\u306A\u304C\u3081\u3066\u3044\u305F\u3093\u3060\u3088",
  "{\u592A\u967D|\u305F\u3044\u3088\u3046}\u3092\u3000{\u898B|\u307F}\u3066\u3044\u308B\u3068\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u304C\\n\u3044\u304B\u306B\u3000\u3061\u3063\u307D\u3051\u306A\u306E\u304B\u3000{\u601D|\u304A\u3082}\u3044{\u77E5|\u3057}\u3089\u3055\u308C\u308B\u306D\\c\\n\u3061\u3087\u3063\u3068\u3000\u30BB\u30F3\u30C1\u30E1\u30F3\u30BF\u30EB\u306A\\n{\u6C17\u5206|\u304D\u3076\u3093}\u306B\u3000\u306A\u3063\u3061\u3083\u3063\u3066\u305F\u3089\\c\\n\u307E\u3060\u3000{\u592A\u967D|\u305F\u3044\u3088\u3046}\u304C\u3000{\u6C88|\u3057\u305A}\u307F\u304D\u3063\u3066\u306A\u3044\u306E\u306B\\n{\u5927|\u304A\u304A}\u304D\u306A\u3000{\u4E09\u65E5\u6708|\u307F\u304B\u3065\u304D}\u304C\u3000{\u76EE|\u3081}\u306E{\u524D|\u307E\u3048}\u3092\\r\\n\u30B7\u30E5\u30D0\u30D0\u30C3\u3068\u3000{\u6A2A\u5207|\u3088\u3053\u304E}\u3063\u305F\u3093\u3060\u3088\uFF01",
  "{\u4E00\u77AC|\u3044\u3063\u3057\u3085\u3093}\u3059\u304E\u3066\u3000\u305D\u306E\u3068\u304D\u306F\\n\u3088\u304F\u3000\u308F\u304B\u3089\u306A\u304B\u3063\u305F\u3051\u3069\\c\\n\u3042\u306E\u30B7\u30EB\u30A8\u30C3\u30C8\u306F\u3000\u304D\u3063\u3068\\n\u30EB\u30CA\u30A2\u30FC\u30E9\u3067\u3000{\u9593\u9055|\u307E\u3061\u304C}\u3044\u306A\u3044\u3088",
  "\u30CD\u30AF\u30ED\u30BA\u30DE\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3067\u3000{\u6EDD\u884C|\u305F\u304D\u304E\u3087\u3046}\u3092\u3000\u3057\u3066\u3044\u305F\u3089\\n\u30CD\u30AF\u30ED\u30BA\u30DE\u304C\u3000{\u9AD8|\u305F\u304B}\u3044\u3068\u3053\u308D\u304B\u3089\\r\\n\u3059\u3054\u3044{\u76EE|\u3081}\u3064\u304D\u3067\u3000\u307C\u304F\u3092\u3000\u306B\u3089\u3093\u3067\u304D\u305F\u306E\uFF01",
  "\u30CA\u30E1\u3089\u308C\u305F\u3089\u3000\u3044\u3051\u306A\u3044\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\\n\u300E{\u559D|\u304B\u3064}\u3063\uFF01\uFF01\u300F\u3063\u3066\u3000{\u53EB|\u3055\u3051}\u3093\u3067\u307F\u305F\u3089\\r\\n\u30CD\u30AF\u30ED\u30BA\u30DE\u306F\u3000\u3059\u3050\u306B\u3000{\u9003|\u306B}\u3052\u3066\u3044\u3063\u305F\u3088",
  "\u307C\u304F\u306E{\u5927\u58F0|\u304A\u304A\u3054\u3048}\u306B\u3000\u30D3\u30C3\u30AF\u30EA\u3057\u305F\u306E\u304B\\n{\u8FD1|\u3061\u304B}\u304F\u306B\u3044\u305F\u3000\u30E1\u30D6\u30AD\u30B8\u30AB\u305F\u3061\u3082\\r\\n{\u9003|\u306B}\u3052\u3061\u3083\u3063\u305F\u306D\u3047\u3000\u306F\u306F\u306F\u306F\u306F",
  "\u30C0\u30AF\u30DE\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3092\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3057\u3066\u3044\u305F\u3089\\n\u30C0\u30AF\u30DE\u304C\u3000{\u4FEE\u884C|\u3057\u3085\u304E\u3087\u3046}\u3057\u3066\u305F\u306E\uFF01\\c\\n\u300E\u304A\u3084\u3000{\u4FEE\u884C|\u3057\u3085\u304E\u3087\u3046}\u3067\u3059\u304B\uFF1F\u300F\u3063\u3066\u3000{\u8A71|\u306F\u306A}\u3057\u304B\u3051\u305F\u3089\\n\u306A\u3093\u3068\u3000{\u610F\u6C17\u6295\u5408|\u3044\u304D\u3068\u3046\u3054\u3046}\u3000\u3057\u3061\u3083\u3063\u3066\u306D\uFF1F",
  "\u3057\u3070\u3089\u304F\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u4F53|\u304B\u3089\u3060}\u3092{\u935B|\u304D\u305F}\u3048\u3066\u305F\u3089\\n{\u7A81\u7136|\u3068\u3064\u305C\u3093}\u3000\u30C0\u30AF\u30DE\u304C\u3000\u30E2\u30B8\u30E2\u30B8\u3057\u3060\u3057\u3066\u306D\uFF1F",
  "\u3059\u3050\u305D\u3070\u306B\u3000{\u751F|\u306F}\u3048\u3066\u305F\u3000\u30BF\u30B1\u30CE\u30B3\u3092\\n{\u5F15|\u3072}\u3063\u3053{\u629C|\u306C}\u3044\u3066\u3000\u307C\u304F\u306B\u3000\u304F\u308C\u305F\u3093\u3060\u3088\u306D\u3047",
  "\u30D6\u30EA\u30B6\u30DD\u30B9\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2\u306E{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u3067\u3000{\u8DA3\u5473|\u3057\u3085\u307F}\u306E\\n{\u767B\u5C71|\u3068\u3056\u3093}\u3092\u3000\u3057\u3066\u3044\u305F\u3093\u3060\u3088",
  "{\u96EA\u9053|\u3086\u304D\u307F\u3061}\u3092\u3000{\u6B69|\u3042\u308B}\u304D\u306B\u3000{\u6B69|\u3042\u308B}\u3044\u3066\\n\u3082\u3046{\u5C11|\u3059\u3053}\u3057\u3067\u3000{\u5C71\u9802|\u3055\u3093\u3061\u3087\u3046}\u304B\u306A\u3068\u3000{\u601D|\u304A\u3082}\u3063\u305F{\u77E2\u5148|\u3084\u3055\u304D}\\r\\n\u304F\u305A\u308C\u305F{\u5BB6|\u3044\u3048}\u3092\u3000{\u767A\u898B|\u306F\u3063\u3051\u3093}\u3057\u3066\u306D\uFF1F\\c\\n{\u58C1|\u304B\u3079}\u306F\u3000\u307E\u3060\u3000\u3057\u3063\u304B\u308A\u3057\u3066\u305F\u304B\u3089\\n\u3053\u3053\u3067\u3000\u3072\u3068{\u4F11|\u3084\u3059}\u307F\u3057\u3088\u3046\u304B\u3068\u3000{\u8997|\u306E\u305E}\u3044\u305F\u3093\u3060",
  "\u305D\u3046\u3057\u305F\u3089\u3000\u306A\u3093\u3068\u3000{\u5148\u5BA2|\u305B\u3093\u304D\u3083\u304F}\u304C\u3000\u3044\u3066\u306D\uFF01\\n{\u767D|\u3057\u308D}\u3044{\u96EA|\u3086\u304D}\u306E\u3088\u3046\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u2026\u2026\\c\\n\u30D6\u30EA\u30B6\u30DD\u30B9\u304C\u3000{\u4E2D|\u306A\u304B}\u3067\u3000{\u5BDD|\u306D}\u3066\u305F\u306E\uFF01\\n\u3044\u3084\u3042\u3000\u3042\u308C\u306B\u306F\u3000{\u9A5A|\u304A\u3069\u308D}\u304B\u3055\u308C\u305F\u306D\u3047",
  "\u30EC\u30A4\u30B9\u30DD\u30B9\u3068\u3044\u3048\u3070\u2026\u2026\\n\u307C\u304F\u304C\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306B\u306D\uFF1F\\c\\n\u30D1\u30EB\u30C7\u30A2\u306E{\u5C71|\u3084\u307E}\u3067\u3000{\u8DA3\u5473|\u3057\u3085\u307F}\u306E\\n{\u767B\u5C71|\u3068\u3056\u3093}\u3092\u3000\u3057\u3066\u3044\u305F\u3093\u3060",
  "{\u8349\u6728|\u304F\u3055\u304D}\u306E\u3000{\u751F|\u306F}\u3048\u305F\u3000{\u767B\u5C71\u9053|\u3068\u3056\u3093\u3069\u3046}\u3092\\n\u3086\u3063\u304F\u308A\u3000\u3086\u3063\u304F\u308A\u3068\u3000{\u6B69|\u3042\u308B}\u3044\u3066\u3044\u305F\u3089\\c\\n{\u9053\u4E2D|\u3069\u3046\u3061\u3085\u3046}\u3000\u30C4\u30BF\u307E\u307F\u308C\u306E\u3000{\u5EC3\u589F|\u306F\u3044\u304D\u3087}\u3092\u3000{\u898B|\u307F}\u3064\u3051\u3066\u306D\\n\u3053\u3053\u3067\u3000\u3072\u3068{\u4F11|\u3084\u3059}\u307F\u3057\u3088\u3046\u304B\u3068\u3000{\u8997|\u306E\u305E}\u3044\u305F\u3093\u3060",
  "\u305D\u3046\u3057\u305F\u3089\u3000\u306A\u3093\u3068\u3000{\u5EC3\u589F|\u306F\u3044\u304D\u3087}\u306E{\u4E2D|\u306A\u304B}\u304B\u3089\\n{\u9ED2|\u304F\u308D}\u3044{\u5F71|\u304B\u3052}\u306E\u3088\u3046\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u2026\u2026\\c\\n\u30EC\u30A4\u30B9\u30DD\u30B9\u304C\u3000\u30D2\u30E7\u30B3\u30C3\u3068\u3000{\u9854|\u304B\u304A}\u3092{\u51FA|\u3060}\u3057\u3066\\n\u307C\u304F\u3000\u3068\u3063\u3066\u3082\u3000{\u9A5A|\u304A\u3069\u308D}\u3044\u3061\u3083\u3063\u305F\u3093\u3060\u3088\u306D\u3047",
  "\u304A\u3084\u3064\u3092\u3000{\u6301|\u3082}\u3063\u3066\u3044\u308C\u3070\u3000\u3042\u306A\u305F\u3082\\n\u3082\u3057\u304B\u3057\u305F\u3089\u3000{\u4F1A|\u3042}\u3048\u308B\u304B\u3082\u3000\u3057\u308C\u306A\u3044\u306D\u3047",
  "[VAR 0101(0005)]\u306B\u3000{\u4F1A|\u3042}\u3048\u305F\u3089\\n\u3088\u308D\u3057\u304F\u3000{\u8A00|\u3044}\u3063\u3066\u304A\u3044\u3066\u306D",
  "\u2026\u2026\u3042\u308C\u3042\u308C\uFF1F\\c\\n{\u4ECA|\u3044\u307E}\u306E\u3067\u3000\u3061\u3087\u3046\u3069\u3000{\u624B\u6301|\u3066\u3082}\u3061\u306E\\n\u304A\u3084\u3064\u304C\u3000\u306A\u304F\u306A\u3063\u3061\u3083\u3063\u305F\u3088",
  "[VAR 0100(0000)]\u3055\u3093\u304C\u3000\u304C\u3093\u3070\u3063\u3066\\n\u30D6\u30EB\u30EC\u30AF\u3092\u3000{\u9054\u6210|\u305F\u3063\u305B\u3044}\u3057\u305F\u3000\u304A\u304B\u3052\u3060\u306D\u3047",
  "\u3082\u3046\u3000\u304A\u3084\u3064\u306F\u3000{\u5DEE|\u3055}\u3057{\u4E0A|\u3042}\u3052\u3089\u308C\u306A\u3044\u3051\u3069\\n\u305F\u307E\u306B\u306F\u3000\u307C\u304F\u306E{\u8A71|\u306F\u306A\u3057}\u2026\u2026\u3000{\u805E|\u304D}\u304D\u306B\u304D\u3066\u306D",
  "[VAR 0100(0000)]\u3055\u3093\uFF01\u3000\u3082\u3046{\u4E00\u5EA6|\u3044\u3061\u3069}\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u8A71|\u306F\u306A\u3057}\u3092\u3000{\u805E|\u304D}\u304D\u305F\u3044\u306E\u304B\u306A\uFF1F",
  "\u307C\u304F\u306F\u306D\uFF1F\u3000\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u3000{\u4EE5\u5916|\u3044\u304C\u3044}\u306B\u3082\\n\u305F\u304F\u3055\u3093\u306E\u3000{\u5730\u65B9|\u3061\u307B\u3046}\u3092\u3000{\u65C5|\u305F\u3073}\u3057\u3066\u3044\u305F\u3093\u3060\u3088\\c\\n\u3044\u308D\u3044\u308D\u306A{\u5834\u6240|\u3070\u3057\u3087}\u3067\\n\u3044\u308D\u3044\u308D\u306A\u30E2\u30CE\u3092\u3000{\u98DF|\u305F}\u3079\u305F\u306D\u3047",
  "\u307C\u304F\u306F\u306D\uFF1F\u3000\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3082\\n\u3051\u3063\u3053\u3046\u3000{\u5F37|\u3064\u3088}\u304B\u3063\u305F\u3093\u3060\u3088\uFF1F\\c\\n{\u76F8\u68D2|\u3042\u3044\u307C\u3046}\u306E\u3000\u30A2\u30FC\u30DC\u30C3\u30AF\u3068\\n{\u5730\u5143|\u3058\u3082\u3068}\u3058\u3083\u3042\u3000{\u8CA0|\u307E}\u3051{\u77E5|\u3057}\u3089\u305A\u3000\u3060\u3063\u305F\u306D\u3047",
  "[VAR 0100(0000)]\u3055\u3093\\n{\u6765|\u304D}\u3066\u304F\u308C\u3066\u3000\u3046\u308C\u3057\u3044\u3088\\c\\n\u3046\u308C\u3057\u304F\u3066\u3000\u306A\u3093\u3060\u304B\\n{\u6B4C|\u3046\u305F}\u3044\u305F\u304F\u3000\u306A\u3063\u3061\u3083\u3063\u305F\u306A\u3041\\r\\n\u305F\u30FC\u3089\u3089\u3089\u3089\u3089\u3000\u3089\u3089\u30FC",
  "\u307C\u304F\u304C\u3000{\u4F5C|\u3064\u304F}\u3063\u3066\u3044\u308B\u3000\u304A\u3084\u3064\\n{\u6750\u6599|\u3056\u3044\u308A\u3087\u3046}\u306F\u3000{\u666E\u901A|\u3075\u3064\u3046}\u306A\u3093\u3060\u3051\u3069\u306D\\c\\n{\u98DF|\u305F}\u3079\u3066\u304F\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\n{\u559C|\u3088\u308D\u3053}\u3093\u3067\u304F\u308C\u308B\u306E\u3092\u3000{\u60F3\u50CF|\u305D\u3046\u305E\u3046}\u3057\u3066\u3000{\u4F5C|\u3064\u304F}\u308B\u304B\u3089\\r\\n\u304D\u3063\u3068\u3000\u3059\u3063\u3054\u304F\u3000\u304A\u3044\u3057\u3044\u3093\u3060\u3088\u306D\u3047",
  "\u30DD\u30B1\u30E2\u30F3\u306E{\u8A00\u8449|\u3053\u3068\u3070}\u306F\u3000\u308F\u304B\u3089\u306A\u3044\u3051\u3069\\n{\u76EE|\u3081}\u3092{\u898B|\u307F}\u308C\u3070\u3000{\u4F55|\u306A\u306B}\u3092{\u8003|\u304B\u3093\u304C}\u3048\u3066\u308B\u304B\\r\\n\u306A\u3093\u3068\u306A\u304F\u3000\u308F\u304B\u308B\u304B\u3089\u3000{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u3060\u306D\u3047\\c\\n\u306F\u306F\u306F\u306F\u306F\u306F\u3000[VAR 0100(0000)]\u3055\u3093\u3082\\n\u305D\u3046\u3000{\u601D|\u304A\u3082}\u3046\u3067\u3057\u3087\u3046\uFF1F"
]
