  "\u30EA\u30DC\u30F3\u3084\u3000\u3042\u304B\u3057\u3092\\n\u3064\u3051\u305F\u3000\u30DD\u30B1\u30E2\u30F3\u306F\uFF01[VAR 0114(0012)]",
