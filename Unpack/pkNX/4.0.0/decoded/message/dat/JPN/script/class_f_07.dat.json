  "\u306A\u304B\u3088\u3057\u30EA\u30DC\u30F3\u306E\u3000{\u8A8D\u5B9A\u4EBA|\u306B\u3093\u3066\u3044\u306B\u3093}\u306F\\n\u30AB\u30E9\u30D5\u30B7\u30C6\u30A3\u306B\u3000\u3044\u3089\u3063\u3057\u3083\u3044\u307E\u3059\u306D[VAR 0114(0012)]",
  "\u3068\u3053\u308D\u304B\u308F\u3063\u3066\u3000\u3042\u304B\u3057\u306F\\n\u307B\u3068\u3093\u3069\u304C\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u51FA\u4F1A|\u3067\u3042}\u3063\u305F\u3068\u304D\u306B\\r\\n\u3059\u3067\u306B\u3000\u3064\u3044\u3066\u3044\u308B\u3082\u306E\u3067\u3059[VAR 0114(0012)]",
  "\u308F\u3093\u3071\u304F\u306A\u3042\u304B\u3057\u3000\u3084\\n\u3052\u3093\u304D\u306E\u3042\u304B\u3057\u3000\u306A\u3069\\r\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u6027\u8CEA|\u305B\u3044\u3057\u3064}\u304C\u3000{\u8868\u73FE|\u3072\u3087\u3046\u3052\u3093}\u3055\u308C\u3066\u3044\u307E\u3059[VAR 0114(0012)]",
  "\u3042\u304B\u3057\u304C\u3000\u3064\u3044\u305F\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n{\u51FA\u4F1A|\u3067\u3042}\u3048\u308B\u304B\u3069\u3046\u304B\u306F\u3000\u307E\u3063\u305F\u304F\u306E{\u904B|\u3046\u3093}\uFF01[VAR 0114(0012)]",
  "\u3042\u304B\u3057\u304C\u3000\u3064\u3044\u305F\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u6355|\u3064\u304B}\u307E\u3048\u3089\u308C\u305F\u3089\u3000\u3068\u3066\u3082\u3000{\u5E78\u904B|\u3053\u3046\u3046\u3093}\u3067\u3059\u3088[VAR 0114(0012)]",
