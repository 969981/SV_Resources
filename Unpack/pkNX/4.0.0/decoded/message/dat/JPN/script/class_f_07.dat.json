  "\u30EA\u30DC\u30F3\u3082\u3000\u3042\u304B\u3057\u3082\u3000\u305D\u306E\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u8868|\u3042\u3089\u308F}\u3059\u3000{\u79F0\u53F7|\u3057\u3087\u3046\u3054\u3046}\u306E\u3088\u3046\u306A\u3082\u306E[VAR 0114(0012)]",
  "\u30EA\u30DC\u30F3\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u304C\u3093\u3070\u3063\u305F\u308A\\n{\u4F55|\u306A\u306B}\u304B\u3057\u3089\u3000{\u7D4C\u9A13|\u3051\u3044\u3051\u3093}\u3092\u3000{\u7A4D|\u3064}\u3081\u3070[VAR 0114(0012)]",
  "\u305D\u306E{\u6210\u679C|\u305B\u3044\u304B}\u3092\u3000{\u8A8D|\u307F\u3068}\u3081\u3089\u308C\\n\u30DD\u30B1\u30E2\u30F3\u306B\u3000\u3064\u3051\u3089\u308C\u308B\u306E\u3067\u3059[VAR 0114(0012)]",
