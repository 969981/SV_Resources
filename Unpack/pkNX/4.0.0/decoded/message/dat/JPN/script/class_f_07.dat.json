[
  "\u30CF\u30C3\u30B5\u30AF\u3067\u3059\\n\u3088\u308D\u3057\u304F\u304A{\u9858|\u306D\u304C}\u3044\u3057\u307E\u3059\u3067\u3059\u3088[VAR 0114(0012)]",
