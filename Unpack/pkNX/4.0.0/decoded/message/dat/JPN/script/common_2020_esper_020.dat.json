[
  "{\u672C\u756A\u524D|\u307B\u3093\u3070\u3093\u307E\u3048}\u306E\u3000{\u80F8|\u3080\u306D}\u306E{\u9AD8\u9CF4|\u305F\u304B\u306A}\u308A\u2026\u2026\\n{\u4F53\u4E2D|\u304B\u3089\u3060\u3058\u3085\u3046}\u306E{\u7D30\u80DE|\u3055\u3044\u307C\u3046}\u304C\u3000{\u6D6E\u8DB3\u7ACB|\u3046\u304D\u3042\u3057\u3060}\u3063\u3066\u308B[VAR 0114(001C)]",
