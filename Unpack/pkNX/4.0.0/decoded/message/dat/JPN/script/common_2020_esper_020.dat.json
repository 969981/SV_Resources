  "\u2026\u2026\u30EA\u30C3\u30D7\u306E{\u696D\u754C|\u304E\u3087\u3046\u304B\u3044}\u306F\u306D\\n{\u534A\u7AEF|\u306F\u3093\u3071}\u306A{\u624D\u80FD|\u3055\u3044\u306E\u3046}\u306E\u3000{\u6301|\u3082}\u3061{\u4E3B|\u306C\u3057}\u306F\\r\\n\u3060\u3044\u305F\u3044\u3000\u3059\u3050\u306B{\u6D88|\u304D}\u3048\u3066\u3063\u3061\u3083\u3046[VAR 0114(001C)]",
  "{\u58C1|\u304B\u3079}\u306B\u3000\u3076\u3061\u3042\u305F\u3063\u3066\u3000{\u632B\u6298|\u3056\u305B\u3064}\u3057\u3066\\n{\u81EA\u68C4|\u3084\u3051}\u306B\u306A\u3063\u3066\u3000{\u5815\u843D|\u3060\u3089\u304F}\u3057\u3066\\r\\n{\u666E\u901A|\u3075\u3064\u3046}\u306E{\u4EBA|\u3072\u3068}\u3088\u308A\u3082\u3000{\u4E0D\u5E78|\u3075\u3053\u3046}\u306B\u3000\u306A\u3063\u3061\u3083\u3046\u306E[VAR 0114(001C)]",
  "\u305D\u308C\u306A\u3089\u3000{\u6700\u521D|\u3055\u3044\u3057\u3087}\u304B\u3089\u3000{\u624D\u80FD|\u3055\u3044\u306E\u3046}\u306A\u3093\u3066\\n\u3061\u3087\u3063\u3068\u3082\u3000\u306A\u3051\u308C\u3070\u3000\u3088\u304B\u3063\u305F\u306E\u306B\u306D[VAR 0114(001C)]",
  "\u2026\u2026[VAR 0100(0000)]\u3061\u3083\u3093\u306F\u3000{\u6D88|\u304D}\u3048\u306A\u3044\u3067\\n{\u81EA\u5206|\u3058\u3076\u3093}\u306E{\u624D\u80FD|\u3055\u3044\u306E\u3046}\u3092\u3000{\u7A76\u6975|\u304D\u3085\u3046\u304D\u3087\u304F}\u307E\u3067\u3000{\u7A81|\u3064}\u304D\u3064\u3081\u3066[VAR 0114(001C)]",
