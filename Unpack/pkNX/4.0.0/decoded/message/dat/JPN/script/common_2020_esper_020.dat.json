  "\u307B\u304B\u306E{\u4EBA|\u3072\u3068}\u304C\u3000\u304C\u3093\u3070\u3063\u3066\u308B\u306E\u3000{\u898B|\u307F}\u305F\u3089\\n{\u81EA\u5206|\u3058\u3076\u3093}\u3082\u3000{\u6CE3|\u306A}\u304B\u306A\u3044\u3067\u3000\u304C\u3093\u3070\u308C\u308B[VAR 0114(001C)]",
  "\u30EA\u30C3\u30D7\u306E{\u8F9E\u66F8|\u3058\u3057\u3087}\u306B\u3000{\u54C0|\u304B\u306A}\u3057\u307F\u306F\u3000\u306A\u3044\\n\u3042\u3063\u3066\u3044\u3044\u306E\u306F\u3000{\u9A5A|\u304A\u3069\u308D}\u304D\u306E{\u7F8E|\u3046\u3064\u304F}\u3057\u3055\u3060\u3051\u2026\u2026[VAR 0114(001C)]",
