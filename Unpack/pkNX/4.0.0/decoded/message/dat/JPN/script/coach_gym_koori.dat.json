  "\u3081\u305A\u3089\u3057\u3044\u30DD\u30B1\u30E2\u30F3\u306F\\n{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3067\u304D\u307E\u305B\u3093",
  "{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044\u306E\u30DD\u30B1\u30E2\u30F3\u306F\\n{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3067\u304D\u307E\u305B\u3093",
  "\u30DD\u30B1\u30E2\u30F3\u304C\u3000\uFF11{\u5339|\u3074\u304D}\u3060\u3068\\n\u30B5\u30E0\u304F\u3066\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3067\u304D\u306A\u3044\\c\\n{\u624B\u6301|\u3066\u3082}\u3061\u3067\u3000\uFF12{\u5339\u4EE5\u4E0A|\u3072\u304D\u3044\u3058\u3087\u3046}\\n\u3064\u308C\u3066\u304D\u3066\u304F\u308C\u306A\u3044\u3068\u3000[VAR 0114(001A)]",
  "\u2026\u2026{\u5197\u8AC7|\u3058\u3087\u3046\u3060\u3093}\u3060\u304B\u3089\u3000{\u6C17|\u304D}\u306B\u3057\u306A\u3044\u3067[VAR 0114(001A)]",
