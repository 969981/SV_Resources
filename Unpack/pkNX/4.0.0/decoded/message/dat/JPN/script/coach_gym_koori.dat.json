  "\u3053\u3053\u306B\u3000{\u6765|\u304D}\u305F\u3068\u304D\u304F\u3089\u3044\u306F\\n{\u89E3\u7981|\u304B\u3044\u304D\u3093}\u3057\u3066\u3082\u3000\u3044\u3044\u304B\u306A[VAR 0114(001A)]",
