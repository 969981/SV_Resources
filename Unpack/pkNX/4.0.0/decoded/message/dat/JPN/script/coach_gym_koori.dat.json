  "[~ 59]",
  "\u2026\u2026{\u5B8C\u6557|\u304B\u3093\u3071\u3044}\u3060\\n{\u73FE\u5B9F|\u3052\u3093\u3058\u3064}\u306F\u3000{\u51B7|\u3064\u3081}\u305F\u3044\u306D[VAR 0114(001A)]",
