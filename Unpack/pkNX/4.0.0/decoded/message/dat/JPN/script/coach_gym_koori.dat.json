  "{\u6557\u8005|\u306F\u3044\u3057\u3083}\u304B\u3089\u3000{\u52DD\u8005|\u3057\u3087\u3046\u3057\u3083}\u3078\\n\u3053\u308C\u3000{\u6301|\u3082}\u3063\u3066\u3044\u304D\u306A\u3088[VAR 0114(001A)]",
  "\u3044\u3089\u306A\u304B\u3063\u305F\u3089\\n{\u6368|\u3059}\u3066\u3066\u3044\u3044\u3088[VAR 0114(001A)]",
  "[~ 59]",
  "\u307C\u304F\u3092\u3000{\u8CA0|\u307E}\u304B\u3059\u306E\u304C\\n{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000{\u597D|\u3059}\u304D\u307F\u305F\u3044\u3060\u306D[VAR 0114(001A)]",
  "{\u6B21|\u3064\u304E}\u3000\u3084\u308B\u3068\u304D\u306F\\n\u30B5\u30E0\u3044{\u7D50\u679C|\u3051\u3063\u304B}\u306B\u3000\u3055\u305B\u306A\u3044\u3088[VAR 0114(001A)]",
  "{\u624B|\u3066}\u3092{\u629C|\u306C}\u304B\u308C\u3066\u3000{\u52DD|\u304B}\u3063\u3066\u3082\\n{\u5168\u7136|\u305C\u3093\u305C\u3093}\u3000\u3046\u308C\u3057\u304F\u306A\u3044\u304B\u3089\\r\\n{\u6B21|\u3064\u304E}\u306F\u3000{\u672C\u6C17|\u307B\u3093\u304D}\u3067\u3000{\u6765|\u304D}\u306A\u3088[VAR 0114(001A)]",
  "{\u5B66\u751F|\u304C\u304F\u305B\u3044}\u3063\u3066\u3000{\u82E6\u624B|\u306B\u304C\u3066}\u2026\u2026\\n{\u5C06\u6765|\u3057\u3087\u3046\u3089\u3044}\u3000{\u632B\u6298|\u3056\u305B\u3064}\u3059\u308B\u304B\u3082\u3063\u3066\u3000{\u601D|\u304A\u3082}\u3046\u3068\\r\\n{\u6C17|\u304D}\u306E{\u6BD2|\u3069\u304F}\u3067\u3000{\u898B|\u307F}\u3066\u3089\u308C\u306A\u3044[VAR 0114(001A)]",
  "\u307C\u304F\u3000\u3053\u3063\u3061\u3067\u3082\\n\u3061\u3087\u3063\u3068\u3000{\u77E5|\u3057}\u3089\u308C\u3066\u308B\u307F\u305F\u3044\\c\\n\u30C4\u30FC\u30B7\u30E7\u30C3\u30C8{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3000\u306D\u3060\u3089\u308C\u308B\u306E\u306F\\n\u3042\u3093\u305F\u3060\u3051\u3067\u3000{\u5145\u5206|\u3058\u3085\u3046\u3076\u3093}\u3060\u3088[VAR 0114(001A)]",
  "\u3084\u3063\u3071\u308A\u3000\u3053\u3053\\n{\u7A7A\u8ABF|\u304F\u3046\u3061\u3087\u3046}\u3000\u30B5\u30E0\u304F\u306A\u3044\uFF1F\\r\\n{\u8AB0|\u3060\u308C}\u306B{\u8A00|\u3044}\u3048\u3070\u3000{\u6E29\u5EA6|\u304A\u3093\u3069}\u3000{\u4E0A|\u3042}\u3052\u3066\u304F\u308C\u308B\u306E\uFF1F[VAR 0114(001A)]",
  "[VAR 0101(0001)]\u306F\u3000{\u4E0A\u3005|\u3058\u3087\u3046\u3058\u3087\u3046}\u3060\\n\u307C\u304F\u306E\u30DD\u30B1\u30E2\u30F3\u3068\u3000\u306A\u304B\u3088\u304F\u3084\u3063\u3066\u308B\\r\\n\u2026\u2026{\u4ECA|\u3044\u307E}\u3093\u3068\u3053\u3000\u30B5\u30E0\u304F\u306A\u3044\u3088[VAR 0114(001A)]",
  "{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\\n\u30A2\u30EB\u30AF\u30B8\u30E9\u306F\u3000\u3069\u3046\uFF1F\\c\\n\u3059\u3050\u3000\u3069\u3063\u304B\u306B\u3000{\u884C|\u3044}\u3063\u3061\u3083\u3046\u304B\u3089\\n\u30D4\u30AF\u30CB\u30C3\u30AF\u306E\u3068\u304D\u3000{\u6C17|\u304D}\u3092\u3064\u3051\u3066[VAR 0114(001A)]",
  "\u2026\u2026\u305D\u3046\u3044\u3048\u3070\u3000\u30AA\u30E2\u30C0\u30AB\u3055\u3093\u306B\\n\u30B5\u30E0\u3044\u3053\u3068\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3082\u3089\u3063\u305F\\c\\n\u3042\u3093\u305F\u3000{\u4E00\u756A|\u3044\u3061\u3070\u3093}{\u597D|\u3059}\u304D\u306A\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306F\\n\u307C\u304F\u3063\u3066\u3000{\u7B54|\u3053\u305F}\u3048\u305F\u3089\u3057\u3044\u306D\\c\\n{\u4F55|\u306A\u306B}\u304C\u3000\u3069\u3046\u3059\u308C\u3070\u3000\u305D\u3046\u306A\u308B\u306E\u304B\\n{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000{\u7406\u89E3|\u308A\u304B\u3044}\u304C\u3000\u3067\u304D\u306A\u3044\u3093\u3060\u3051\u3069\u2026\u2026\\c\\n\u3044\u3061\u304A\u3046\u3000{\u6C17\u6301|\u304D\u3082}\u3061\u306F\u3000{\u4F1D|\u3064\u305F}\u308F\u3063\u305F\u304B\u3089\\n\u2026\u2026\u3042\u308A\u304C\u3068\u3046\u3063\u3066\u3000{\u8A00|\u3044}\u3063\u3066\u304A\u304F[VAR 0114(001A)]"
