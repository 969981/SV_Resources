  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3059\u308B\u3093\u3060\uFF1F\\n\u3058\u3083\u3042\u3000\u307C\u304F\u304B\u3089\u306F\u3000\u30A2\u30EB\u30AF\u30B8\u30E9\u3092\\r\\n\u3042\u3093\u305F\u306F\u3000\u3069\u3046\u3059\u308B\uFF1F[VAR 0114(001A)]",
  "[VAR 0101(0001)]\u304B\\n\u3046\u3093\u2026\u2026\u3000{\u60AA|\u308F\u308B}\u304F\u306A\u3044\u306D\\c\\n\u3042\u3093\u305F\u304B\u3089\u3000\u305F\u304F\u3055\u308C\u305F\u3093\u3060\\n\u30B5\u30E0\u3044{\u80B2|\u305D\u3060}\u3066{\u65B9|\u304B\u305F}\u306F\u3000\u3057\u306A\u3044\u3088[VAR 0114(001A)]",
  "\u3042\u3093\u305F\u306E\u3000[VAR 0101(0001)]\u3068\\n\u307C\u304F\u306E\u3000\u30A2\u30EB\u30AF\u30B8\u30E9\u3092\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3059\u308B\u3088[VAR 0114(001A)]",
