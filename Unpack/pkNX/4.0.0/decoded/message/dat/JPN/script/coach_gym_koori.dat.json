  "{\u76F4\u7DDA|\u3061\u3087\u304F\u305B\u3093}\u3082\u3000{\u66F2\u7DDA|\u304D\u3087\u304F\u305B\u3093}\u3082\u3000{\u5145\u5B9F|\u3058\u3085\u3046\u3058\u3064}\u3057\u3066\u3066\\n\u30DC\u30FC\u30C9\u306B\u3000{\u4E57|\u306E}\u308B\u306B\u306F\u3000\u3046\u3063\u3066\u3064\u3051\u3060[VAR 0114(001A)]",
