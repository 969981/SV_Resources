  "\u305F\u304F\u3055\u3093\u306E{\u91D1\u8CA8|\u304D\u3093\u304B}\u3092\u3000{\u5546\u4EBA|\u3057\u3087\u3046\u306B\u3093}\u306B\u3000{\u4E0E|\u3042\u305F}\u3048\\n\uFF14\u3064\u306E{\u5B9D|\u305F\u304B\u3089}\u3092\u3000\u3086\u305A\u3063\u3066\u3082\u3089\u3044\u307E\u3057\u305F[VAR 0114(0027)]",
  "\u2026\u2026\u3055\u3066\u3000\u3053\u3053\u3067\u3000\u30EF\u30BF\u30B7\u3068\u3000{\u76EE|\u3081}\u304C{\u5408|\u3042}\u3063\u305F\\n\u3042\u308F\u308C\u306A\u3000[VAR 0100(0000)]\u306B\u3000\u30AF\u30A8\u30B9\u30C1\u30E7\u30F3[VAR 0114(0027)]",
  "{\u5B9D|\u305F\u304B\u3089}\u306E\u3046\u3061\u306E\u3000\uFF11\u3064\u3000\u30E2\u30C3\u30AB\u30F3\u3068\u306F\\n\u3069\u3046\u3044\u3063\u305F\u3082\u306E\u304B\u3000{\u77E5|\u3057}\u3063\u3066\u3044\u308B\u304B\uFF1F[VAR 0114(0027)]",
  "{\u6728|\u304D}\u306E{\u677F|\u3044\u305F}",
