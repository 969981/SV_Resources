  "\u305F\u307E\u306B\u306F\u3000{\u8DA3\u5411|\u3057\u3085\u3053\u3046}\u3092\u3000{\u5909|\u304B}\u3048\u3066\\n{\u697D|\u305F\u306E}\u3057\u3044{\u6642\u9593|\u3058\u304B\u3093}\u3092\u3000\u304F\u308C\u3066\u3084\u308B[VAR 0114(0027)]",
  "\u30D1\u30EB\u30C7\u30A2\u306B\u3000{\u4F1D|\u3064\u305F}\u308F\u308B\u3000\u3080\u304B\uFF5E\u3057{\u6614|\u3080\u304B\u3057}\u306E\\n\u304A\u3068\u304E{\u8A71|\u3070\u306A\u3057}\u3092\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3084\u308D\u3046[VAR 0114(0027)]",
  "\u3042\u308B\u3068\u3053\u308D\u306B\u3000{\u5B9D|\u305F\u304B\u3089}\u3092\u3000{\u96C6|\u3042\u3064}\u3081\u308B\u306E\u304C\\n{\u5927\u597D|\u3060\u3044\u3059}\u304D\u306A\u3000{\u738B|\u304A\u3046}\u3055\u307E\u304C\u3000\u3044\u307E\u3057\u305F[VAR 0114(0027)]",
  "{\u738B|\u304A\u3046}\u3055\u307E\u306F\u3000{\u7570\u56FD|\u3044\u3053\u304F}\u306E{\u5B9D|\u305F\u304B\u3089}\u304C\u3000{\u5927\u597D|\u3060\u3044\u3059}\u304D\\c\\n\u3046\u308F\u3055\u3092\u3000{\u805E|\u304D}\u304D\u3064\u3051\u3066\u3000\u3042\u308B{\u65E5|\u3072}\\n{\u6771|\u3072\u304C\u3057}\u306E{\u56FD|\u304F\u306B}\u304B\u3089\u3000{\u5546\u4EBA|\u3057\u3087\u3046\u306B\u3093}\u304C\u3000\u3084\u3063\u3066\u304D\u307E\u3057\u305F[VAR 0114(0027)]",
  "{\u5546\u4EBA|\u3057\u3087\u3046\u306B\u3093}\u306F\u3000\uFF14\u3064\u306E{\u5B9D|\u305F\u304B\u3089}\u3092\\n{\u738B|\u304A\u3046}\u3055\u307E\u306E{\u524D|\u307E\u3048}\u306B\u3000\u306A\u3089\u3079\u307E\u3057\u305F[VAR 0114(0027)]",
  "\u306A\u3089\u3079\u3089\u308C\u305F\u306E\u306F\\n\u30A6\u30C4\u30EF\u2026\u2026\u3000\u30C4\u30EB\u30AE\u2026\u2026\\r\\n\u30E2\u30C3\u30AB\u30F3\u2026\u2026\u3000\u30DE\u30AC\u30BF\u30DE\u2026\u2026[VAR 0114(0027)]",
