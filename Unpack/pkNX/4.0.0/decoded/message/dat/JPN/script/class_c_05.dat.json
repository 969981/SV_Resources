  "\u2026\u2026{\u4E0D\u6B63\u89E3|\u3075\u305B\u3044\u304B\u3044}\uFF01\\n\u305D\u308C\u306F\u3000{\u6728\u7434|\u3082\u3063\u304D\u3093}\u3060\u308D\u3000\u3068\u3044\u3046\\r\\n\u30C4\u30C3\u30B3\u30DF\u3092\u3000{\u5F85|\u307E}\u3063\u3066\u3044\u308B\u306E\u304B\uFF1F[VAR 0114(0027)]",
  "\u2026\u2026{\u4E0D\u6B63\u89E3|\u3075\u305B\u3044\u304B\u3044}\uFF01\\n\u305D\u308C\u306F\u3000\u30E8\u30A6\u30AB\u30F3\u3060\u308D\u3000\u3068\u3044\u3046\\r\\n\u30C4\u30C3\u30B3\u30DF\u3092\u3000{\u5F85|\u307E}\u3063\u3066\u3044\u308B\u306E\u304B\uFF1F[VAR 0114(0027)]",
  "\u30E2\u30C3\u30AB\u30F3\u3068\u306F\u3000{\u53E4\u4EE3|\u3053\u3060\u3044}\u3000{\u6771|\u3072\u304C\u3057}\u306E{\u56FD|\u304F\u306B}\u3067\\n{\u6587\u5B57|\u3082\u3058}\u3092\u3000{\u8A18|\u3057\u308B}\u3059\u305F\u3081\u306B\u3000{\u4F7F|\u3064\u304B}\u308F\u308C\u305F\u3000{\u6728|\u304D}\u306E{\u677F|\u3044\u305F}\u3060\\r\\n\u2026\u2026{\u6F22\u5B57|\u304B\u3093\u3058}\u3067\u3000{\u66F8|\u304B}\u304F\u3068\u3000{\u6728\u7C21|\u3082\u3063\u304B\u3093}\u3060\u306A[VAR 0114(0027)]",
  "\u3054{\u5B58\u77E5|\u305E\u3093\u3058}\u306E\u3068\u304A\u308A\u3000{\u6728\u7C21|\u3082\u3063\u304B\u3093}\u306F\\n{\u7D19|\u304B\u307F}\u304C\u3000{\u666E\u53CA|\u3075\u304D\u3085\u3046}\u3057\u3066\u3044\u304F\u3053\u3068\u306B\u3088\u308A\\r\\n\u3042\u307E\u308A\u3000{\u4F7F|\u3064\u304B}\u308F\u308C\u306A\u304F\u306A\u3063\u3066\u3044\u3063\u305F[VAR 0114(0027)]",
