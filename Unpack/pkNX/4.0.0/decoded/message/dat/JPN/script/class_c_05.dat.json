[
  "\u3084\u3042\u3000{\u8CB4\u69D8|\u304D\u3055\u307E}\u305F\u3061\\n{\u6628\u65E5|\u304D\u306E\u3046}\u3088\u308A\u3000{\u4E00\u65E5\u5206|\u3044\u3061\u306B\u3061\u3076\u3093}\u3000{\u53E4|\u3075\u308B}\u304F\u306A\u3063\u305F\u306A[VAR 0114(0027)]",
