  "\u3088\u3046\u3053\u305D\u3000\u30C1\u30E3\u30F3\u30D7\u30EB\u30B8\u30E0\u3078\uFF01",
  "{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}{\u8005|\u3057\u3083}\u306E\\n\u304A{\u540D\u524D|\u306A\u307E\u3048}\u3092\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3057\u307E\u3059\u2026\u2026\\r\\n[VAR 0100(0000)]\u3055\u3093\u3000\u3067\u3059\u306D\uFF01",
  "{\u5F53|\u3068\u3046}\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30A2\u30AA\u30AD\u3068\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308B\u306B\u306F\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u3092\\r\\n\u30AF\u30EA\u30A2\u3059\u308B{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308A\u307E\u3059",
  "\u30C1\u30E3\u30F3\u30D7\u30EB\u30B8\u30E0\u306E\\n\u30B8\u30E0\u30C6\u30B9\u30C8\u306F\u2026\u2026\\r\\n[VAR FF00(0006)]{\u79D8\u5BC6|\u3072\u307F\u3064}\u306E\u30E1\u30CB\u30E5\u30FC\u3092\u3000{\u6CE8\u6587|\u3061\u3085\u3046\u3082\u3093}\u305B\u3088[VAR FF00(0000)]\uFF01",
  "{\u5408\u683C|\u3054\u3046\u304B\u304F}{\u6761\u4EF6|\u3058\u3087\u3046\u3051\u3093}\u306F\u3000\u30C1\u30E3\u30F3\u30D7\u30EB\u30BF\u30A6\u30F3\u3067\\n{\u5927\u4EBA\u6C17|\u3060\u3044\u306B\u3093\u304D}\u306E\u304A{\u5E97|\u307F\u305B}\u3000[VAR FF00(0006)]{\u5B9D\u98DF\u5802|\u305F\u304B\u3089\u3057\u3087\u304F\u3069\u3046}[VAR FF00(0000)]\u306B\u3066\\r\\n{\u79D8\u5BC6|\u3072\u307F\u3064}\u306E\u30E1\u30CB\u30E5\u30FC\u3092\u3000{\u6CE8\u6587|\u3061\u3085\u3046\u3082\u3093}\u3059\u308B\u3053\u3068\u3067\u3059",
  "{\u4ECA|\u3044\u307E}\u3000\u3053\u306E{\u753A|\u307E\u3061}\u306B\u306F\\n\u3042\u306A\u305F{\u4EE5\u5916|\u3044\u304C\u3044}\u306B\u3000\uFF13{\u4EBA|\u306B\u3093}\u306E\\r\\n\u30B8\u30E0\u30C6\u30B9\u30C8{\u6311\u6226\u8005|\u3061\u3087\u3046\u305B\u3093\u3057\u3083}\u304C\u3000\u3044\u307E\u3059",
  "{\u53C2\u52A0\u8005|\u3055\u3093\u304B\u3057\u3083}\u306F\u3000{\u79D8\u5BC6|\u3072\u307F\u3064}\u306E\u30E1\u30CB\u30E5\u30FC\u306B\u3000\u3064\u3044\u3066\\n\u305D\u308C\u305E\u308C\u3000{\u9055|\u3061\u304C}\u3063\u305F\u30D2\u30F3\u30C8\u3092\u3000{\u77E5|\u3057}\u3063\u3066\u3044\u307E\u3059",
  "{\u6311\u6226\u8005\u540C\u58EB|\u3061\u3087\u3046\u305B\u3093\u3057\u3083\u3069\u3046\u3057}\u3067\u3000\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3092\u3000\u3057\u3066\\n{\u52DD|\u304B}\u3063\u305F\u307B\u3046\u304C\u3000{\u8CA0|\u307E}\u3051\u305F\u307B\u3046\u306E\\r\\n\u30D2\u30F3\u30C8\u3092\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3082\u3089\u3063\u3066\u304F\u3060\u3055\u3044",
  "{\u96C6|\u3042\u3064}\u3081\u305F\u30D2\u30F3\u30C8\u3092\u3000\u3082\u3068\u306B\\n{\u5B9D\u98DF\u5802|\u305F\u304B\u3089\u3057\u3087\u304F\u3069\u3046}\u306E{\u5E97\u54E1|\u3066\u3093\u3044\u3093}\u3055\u3093\u306B\\r\\n{\u79D8\u5BC6|\u3072\u307F\u3064}\u306E\u30E1\u30CB\u30E5\u30FC\u3092\u3000{\u6CE8\u6587|\u3061\u3085\u3046\u3082\u3093}\u3057\u3066\u304F\u3060\u3055\u3044",
  "{\u6CE8\u6587|\u3061\u3085\u3046\u3082\u3093}\u3067\u304D\u305F\u3000{\u4E00\u540D|\u3044\u3061\u3081\u3044}\u306E\u307F\u304C\\n\u30B8\u30E0\u30C6\u30B9\u30C8\u306E{\u5408\u683C\u8005|\u3054\u3046\u304B\u304F\u3057\u3083}\u3068\u3000\u306A\u308A\u307E\u3059",
  "[VAR 0100(0000)]\u3055\u3093\u306E\u30D2\u30F3\u30C8\u306F\\n[VAR FF00(0006)]{\u5E38\u9023|\u3058\u3087\u3046\u308C\u3093}\u3055\u3093\u306E{\u98DF|\u305F}\u3079{\u65B9|\u304B\u305F}[VAR FF00(0000)]\u3067\u3059\uFF01",
