[
  "\u3042\u3093\u305F\u306B\u3068\u3063\u3066\u306F\u3000{\u5E78\u904B|\u3053\u3046\u3046\u3093}\u306A{\u5929\u6C17|\u3066\u3093\u304D}\u3060\\n{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u304C\u3000{\u512A|\u3084\u3055}\u3057\u3055\u3092\u3000{\u898B|\u307F}\u305B\u305F\u306E\u304B\u306A[VAR 0114(001A)]",
  "\u3042\u3093\u305F\u306B\u3068\u3063\u3066\u306F\u3000{\u6700\u60AA|\u3055\u3044\u3042\u304F}\u3060\\n{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u306F\u3000\u307C\u304F\u306E{\u5473\u65B9|\u307F\u304B\u305F}\u307F\u305F\u3044[VAR 0114(001A)]",
  "{\u5E74|\u306D\u3093}\u306B\u3000{\u4F55\u5EA6|\u306A\u3093\u3069}\u304B\u3000\u3053\u3046\u3044\u3046\u3075\u3046\u306B\\n\u30EA\u30FC\u30B0\u306E{\u8996\u5BDF|\u3057\u3055\u3064}\u304C\u3000\u3042\u308B\u3093\u3060[VAR 0114(001A)]",
  "\u3075\u3055\u308F\u3057\u3044{\u5B9F\u529B|\u3058\u3064\u308A\u3087\u304F}\u3092\u3000{\u767A\u63EE|\u306F\u3063\u304D}\u3067\u304D\u306A\u3051\u308C\u3070\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u304B\u3089\u3000{\u964D|\u304A}\u308D\u3055\u308C\u308B\u30C6\u30B9\u30C8[VAR 0114(001A)]",
  "\u2026\u2026\u30AA\u30E2\u30C0\u30AB\u3055\u3093\u306F\\n{\u5F62\u5F0F\u7684|\u3051\u3044\u3057\u304D\u3066\u304D}\u306A\u3082\u306E\u3063\u3066\u3000{\u8A00|\u3044}\u3063\u3066\u308B\u3051\u3069[VAR 0114(001A)]",
  "\u30B9\u30CE\u30FC\u30DC\u30FC\u30C0\u30FC\u306E{\u5922|\u3086\u3081}\u3092\u3000{\u7D76|\u305F}\u305F\u308C\u3066\\n{\u6B8B|\u306E\u3053}\u308A\u306E{\u624D\u80FD|\u3055\u3044\u306E\u3046}\u3055\u3048\u3082\u3000{\u5208|\u304B}\u308A\u3068\u3089\u308C\u305F\u3089\\r\\n\u307C\u304F\u306B\u306F\u3000{\u4F55|\u306A\u306B}\u304C\u3000{\u6B8B|\u306E\u3053}\u308B\u3093\u3060\uFF1F[VAR 0114(001A)]",
  "\u3061\u3087\u3063\u3068\u3000\u30B5\u30E0\u3044\u3053\u3068\u3000{\u8A00|\u3044}\u3063\u3061\u3083\u3063\u305F\u3051\u3069\\n\u2026\u2026{\u8A71|\u306F\u306A\u3057}\u306F\u3000\u3082\u3046{\u5C11|\u3059\u3053}\u3057\u3000{\u7C21\u5358|\u304B\u3093\u305F\u3093}\u306A\u3093\u3060[VAR 0114(001A)]",
  "\u3042\u3093\u305F\u3092\u3000{\u5B8C\u819A|\u304B\u3093\u3077}\u306A\u304D\u307E\u3067\u306B\\n{\u51CD|\u3053\u3054}\u3048\u3055\u305B\u308C\u3070\u3000\u3044\u3044\u3060\u3051\u3060\u304B\u3089[VAR 0114(001A)]",
  "\u30AA\u30E2\u30C0\u30AB\u3055\u3093\u3082\u3000{\u4EBA|\u3072\u3068}\u304C\u3000{\u60AA|\u308F\u308B}\u3044\\n{\u7D76\u5BFE|\u305C\u3063\u305F\u3044}\u3000{\u52DD|\u304B}\u3066\u306A\u3044{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000\u3088\u3053\u3059\u306A\u3093\u3066[VAR 0114(001A)]",
  "\u3060\u3051\u3069\u3000{\u5F8C\u6094|\u3053\u3046\u304B\u3044}\u306F\u3000\u3057\u3066\u3044\u306A\u3044\\n{\u5B9F\u529B|\u3058\u3064\u308A\u3087\u304F}\u306F\u3000{\u51FA|\u3060}\u3057\u304D\u3063\u305F\u3064\u3082\u308A\u3060[VAR 0114(001A)]",
  "{\u672C\u6C17|\u307B\u3093\u304D}\u3067\u3000\u3042\u3093\u305F\u306B\u3000\u3076\u3064\u304B\u3063\u3066\\n{\u8CA0|\u307E}\u3051\u3066\u2026\u2026\u3000\u304F\u3084\u3057\u3044\u3063\u3066\u3000{\u601D|\u304A\u3082}\u3048\u305F[VAR 0114(001A)]",
  "\u3082\u3046{\u5C11|\u3059\u3053}\u3057\u3000{\u672C\u6C17|\u307B\u3093\u304D}\u3067\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\\n\u3084\u3063\u3066\u307F\u3088\u3046\u3063\u3066\u3000{\u601D|\u304A\u3082}\u3063\u305F[VAR 0114(001A)]",
  "\u307C\u304F\u306E\u3000{\u51B7|\u3055}\u3081\u304D\u3063\u305F{\u60C5\u71B1|\u3058\u3087\u3046\u306D\u3064}\u306B\\n\u3075\u305F\u305F\u3073\u3000{\u706B|\u3072}\u3092\u3000{\u706F|\u3068\u3082}\u3057\u3066\u304F\u308C\u3066\\r\\n\u2026\u2026\u3042\u308A\u304C\u3068\u3046\u3000[VAR 0100(0000)][VAR 0114(001A)]",
  "{\u6B21|\u3064\u304E}\u3000\u3084\u308B\u3068\u304D\u306F\u3000{\u8CA0|\u307E}\u3051\u306A\u3044\u3088[VAR 0114(001A)]",
  "{\u98A8\u90AA|\u304B\u305C}\u3000{\u5F15|\u3072}\u304B\u306A\u3044\u3088\u3046\u306B\\n{\u6C17|\u304D}\u3092\u3064\u3051\u3066\u3000{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u3000{\u4E0B|\u304F\u3060}\u3063\u3066[VAR 0114(001A)]"
]
