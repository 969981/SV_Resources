  "\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8{\u63A5\u7D9A|\u305B\u3064\u305E\u304F}\u3000\u3059\u308B\u305F\u3081\u306B\\n{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306A{\u60C5\u5831|\u3058\u3087\u3046\u307B\u3046}\u3092\u3000{\u53D7|\u3046}\u3051\u3068\u308A\u307E\u3059\\c\\n{\u60C5\u5831|\u3058\u3087\u3046\u307B\u3046}\u3092\u3000{\u53D7|\u3046}\u3051\u3068\u3063\u305F\u3042\u3068\u306B\\n\u30EC\u30DD\u30FC\u30C8\u3092\u3000{\u66F8|\u304B}\u304D\u307E\u3059\u304C\\r\\n\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F",
  "\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8{\u63A5\u7D9A|\u305B\u3064\u305E\u304F}\u306B\\n{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306A{\u60C5\u5831|\u3058\u3087\u3046\u307B\u3046}\u3092\u3000{\u53D7|\u3046}\u3051\u3068\u308A\u307E\u3057\u305F",
