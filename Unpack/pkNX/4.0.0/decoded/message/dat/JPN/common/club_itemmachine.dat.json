  "[VAR 0204(0001,0000)]\uFF22\uFF30\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306B\u306A\u308B\u3051\u3069\\n\u30D7\u30EA\u30F3\u30BF\u30FC\u306E{\u6027\u80FD|\u305B\u3044\u306E\u3046}\u3092\u3000{\u6539\u826F|\u304B\u3044\u308A\u3087\u3046}\u3059\u308B\uFF1F",
  "{\u6539\u826F|\u304B\u3044\u308A\u3087\u3046}\u3000{\u4E86\u89E3|\u308A\u3087\u3046\u304B\u3044}\uFF01\\n\u3055\u3063\u305D\u304F\u3000\u3068\u308A\u304B\u304B\u308B\u306D\uFF01",
  "\u2026\u2026\u305B\u3044\u3084\uFF01\u3000\u3069\u3063\u3053\u3044\u3057\u3087\uFF01\uFF01",
  "\u3075\u3045\u2026\u2026\u3000{\u6539\u826F|\u304B\u3044\u308A\u3087\u3046}\u3000{\u5B8C\u4E86|\u304B\u3093\u308A\u3087\u3046}\uFF01\\c\\n{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306A\u3000\u304A\u3068\u3057\u3082\u306E{\u6570|\u3059\u3046}\u3068\\n\uFF22\uFF30\u304C\u3000{\u5C11|\u3059\u304F}\u306A\u304F\u3000\u306A\u3063\u305F\u3088\uFF01\\c\\n\u30D7\u30EA\u30F3\u30C8\u3067\u304D\u308B\u3000{\u9053\u5177|\u3069\u3046\u3050}\u304C\u3000\uFF12{\u500D|\u3070\u3044}\u306B\u306A\u308B\\n[VAR FF00(0006)]{\u9053\u5177|\u3069\u3046\u3050}\uFF12{\u500D|\u3070\u3044}\u30C1\u30E3\u30F3\u30B9[VAR FF00(0000)]\u3092\u3000{\u8FFD\u52A0|\u3064\u3044\u304B}\u3057\u305F\u3088\uFF01\\c\\n{\u6027\u80FD|\u305B\u3044\u306E\u3046}\u306B\u3000{\u95A2\u4FC2|\u304B\u3093\u3051\u3044}\u306A\u3044\u3051\u3069\\n{\u898B|\u307F}\u305F{\u76EE|\u3081}\u3082\u3000\u30B9\u30FC\u30D1\u30FC\u306B\u3000\u3057\u3066\u307F\u305F\u3088\uFF01\\r\\n\u3068\u3044\u3046\u308F\u3051\u3067\u3000{\u5F15|\u3072}\u304D{\u7D9A|\u3064\u3065}\u304D\u2026\u2026",
  "\u3075\u3045\u2026\u2026\u3000\uFF12{\u6BB5\u968E|\u3060\u3093\u304B\u3044}{\u6539\u826F|\u304B\u3044\u308A\u3087\u3046}\u3000{\u5B8C\u4E86|\u304B\u3093\u308A\u3087\u3046}\uFF01\\c\\n{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306A\u3000\u304A\u3068\u3057\u3082\u306E{\u6570|\u3059\u3046}\u3068\\n\uFF22\uFF30\u304C\u3000{\u5C11|\u3059\u304F}\u306A\u304F\u3000\u306A\u3063\u305F\u3088\uFF01\\c\\n\u3081\u305A\u3089\u3057\u3044\u30DC\u30FC\u30EB\u304C\u3000\u30D7\u30EA\u30F3\u30C8\u3055\u308C\u308B\u304B\u3082\uFF01\uFF1F\\n[VAR FF00(0006)]\u30EC\u30A2\u30DC\u30FC\u30EB\u30C1\u30E3\u30F3\u30B9[VAR FF00(0000)]\u3092\u3000{\u8FFD\u52A0|\u3064\u3044\u304B}\u3057\u305F\u3088\uFF01\\c\\n{\u6027\u80FD|\u305B\u3044\u306E\u3046}\u306B\u3000{\u95A2\u4FC2|\u304B\u3093\u3051\u3044}\u306A\u3044\u3051\u3069\\n{\u898B|\u307F}\u305F{\u76EE|\u3081}\u3082\u3000\u30CF\u30A4\u30D1\u30FC\u306B\u3000\u3057\u3066\u307F\u305F\u3088\uFF01\\r\\n\u3068\u3044\u3046\u308F\u3051\u3067\u3000{\u5F15|\u3072}\u304D{\u7D9A|\u3064\u3065}\u304D\u2026\u2026",
  "\u3075\u3045\u2026\u2026\u3000{\u6700\u7D42|\u3055\u3044\u3057\u3085\u3046}{\u6539\u826F|\u304B\u3044\u308A\u3087\u3046}\u3000{\u5B8C\u4E86|\u304B\u3093\u308A\u3087\u3046}\uFF01\\c\\n{\u9053\u5177|\u3069\u3046\u3050}\u304C\u3000{\u8907\u6570|\u3075\u304F\u3059\u3046}{\u500B|\u3053}\u3067\u3082\\n\u30D7\u30EA\u30F3\u30C8\u3055\u308C\u308B\u3088\u3046\u306B\u3000\u306A\u3063\u305F\u3088\uFF01\\c\\n\u30C6\u30E9\u30D4\u30FC\u30B9\u30B9\u30C6\u30E9\u3082\\n\u30D7\u30EA\u30F3\u30C8\u3055\u308C\u308B\u3088\u3046\u306B\u3000\u306A\u3063\u305F\u3088\uFF01\\c\\n{\u6027\u80FD|\u305B\u3044\u306E\u3046}\u306B\u3000{\u95A2\u4FC2|\u304B\u3093\u3051\u3044}\u306A\u3044\u3051\u3069\\n{\u898B|\u307F}\u305F{\u76EE|\u3081}\u3082\u3000\u30DE\u30B9\u30BF\u30FC\u306B\u3000\u3057\u3066\u307F\u305F\u3088\uFF01\\c\\n{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u306B\u3000{\u5354\u529B|\u304D\u3087\u3046\u308A\u3087\u304F}\u3057\u3066\u304F\u308C\u3066\\n{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3042\u308A\u304C\u3068\u3046\u306D\uFF01\\r\\n\u3068\u3044\u3046\u308F\u3051\u3067\u3000{\u5F15|\u3072}\u304D{\u7D9A|\u3064\u3065}\u304D\u2026\u2026",
  "\u30D7\u30EA\u30F3\u30BF\u30FC\u306E{\u6027\u80FD|\u305B\u3044\u306E\u3046}\u3092\u3000{\u6539\u826F|\u304B\u3044\u308A\u3087\u3046}\u3059\u308B\u306B\u306F\\n{\u8A66\u884C|\u3057\u3053\u3046}{\u56DE\u6570|\u304B\u3044\u3059\u3046}\u304C\u3000{\u8DB3|\u305F}\u308A\u306A\u3044\u304B\u306A\u2026\u2026",
  "\u30D7\u30EA\u30F3\u30BF\u30FC\u306E{\u6027\u80FD|\u305B\u3044\u306E\u3046}\u306F\\n{\u6700\u7D42|\u3055\u3044\u3057\u3085\u3046}{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u307E\u3067\u3000{\u6539\u826F|\u304B\u3044\u308A\u3087\u3046}{\u6E08|\u305A}\u307F\u3060\u3088\uFF01",
  "\u30D7\u30EA\u30F3\u30BF\u30FC\u306E{\u6027\u80FD|\u305B\u3044\u306E\u3046}\u3092\u3000\u3055\u3089\u306B\\n{\u6539\u826F|\u304B\u3044\u308A\u3087\u3046}\u3059\u308B\u305F\u3081\u3000{\u7814\u7A76\u4E2D|\u3051\u3093\u304D\u3085\u3046\u3061\u3085\u3046}\u3060\u3088\uFF01"
