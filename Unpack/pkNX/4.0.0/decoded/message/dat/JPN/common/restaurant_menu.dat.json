  "\u30AD\u30BF\u30AB\u30DF\u7523\u306E\u3000\u30DF\u30EB\u30AF\u3092\u3000\u4F7F\u7528\u3057\u305F \\n\u5730\u5143\u304C\u3000\u8A87\u308B\u3000\u540D\u7523\u54C1\u306E\u3000\u3072\u3068\u3064\u3002",
  "\u30AB\u30C3\u30D7\u3068\u3000\u30A2\u30A4\u30B9\u30AF\u30EA\u30FC\u30E0\u306F\u3000\u540C\u3058\u3002\\n\u306A\u306E\u306B\u3000\u3069\u3053\u304B\u3000\u98A8\u5473\u304C\u9055\u3046\u3000\u4E0D\u601D\u8B70\u3002",
  "\u3044\u3061\u3054\u306E\u3000\u7518\u9178\u3063\u3071\u3055\u3092\u3000\u30A4\u30E1\u30FC\u30B8\u3057\u305F\\n\u30B7\u30ED\u30C3\u30D7\u304C\u3000\u304B\u304B\u3063\u305F\u3000\u304B\u304D\u6C37\u3002",
  "\u30E1\u30ED\u30F3\u3092\u3000\u9023\u60F3\u3055\u305B\u308B\u3000\u30AB\u30E9\u30FC\u30EA\u30F3\u30B0\u306E\\n\u30B7\u30ED\u30C3\u30D7\u304C\u3000\u304B\u304B\u3063\u305F\u3000\u304B\u304D\u6C37\u3002",
  "\u8EFD\u5FEB\u306A\u3000\u30EC\u30E2\u30F3\u8272\u304C\u3000\u76EE\u306B\u3000\u3046\u308C\u3057\u3044\u3002\\n\u9178\u5473\u306F\u3000\u306A\u3044\u304C\u3000\u5B9A\u756A\u306E\u3000\u304B\u304D\u6C37\u3002",
  "\u30A2\u30ED\u30FC\u30E9\u5730\u65B9\u306E\u3000\u6D77\u306E\u8272\u3092\u3000\u30E2\u30C1\u30FC\u30D5\u306B\u3057\u305F\\n\u8272\u5408\u3044\u306E\u3000\u30B7\u30ED\u30C3\u30D7\u304C\u3000\u304B\u304B\u3063\u305F\u3000\u304B\u304D\u6C37\u3002",
  "\u3076\u3069\u3046\u597D\u304D\u306E\u3000\u58F0\u304B\u3089\u3000\u751F\u307E\u308C\u305F\u3000\u304B\u304D\u6C37\u3002\\n\u6FC3\u3044\u7D2B\u8272\u306F\u3000\u30A4\u30F3\u30D1\u30AF\u30C8\u304C\u3000\u3042\u308B\u3002",
  "\u7126\u3052\u305F\u3000\u30BD\u30FC\u30B9\u306E\u3000\u30E1\u30A4\u30E9\u30FC\u30C9\u53CD\u5FDC\u306B\u3088\u308B\\n\u9999\u308A\u3068\u3000\u65E8\u5473\u304C\u3000\u305F\u307E\u3089\u306A\u3044\u3000\u713C\u304D\u305D\u3070\u3002",
  "\u30AD\u30BF\u30AB\u30DF\u7523\u306E\u3000\u308A\u3093\u3054\u3092\u3000\u4F7F\u7528\u3057\u305F\\n\u3058\u3064\u306B\u3000\u7F8E\u5473\u3057\u3044\u3000\u308A\u3093\u3054\u3042\u3081\u3002",
  "\u30AD\u30BF\u30AB\u30DF\u7523\u306E\u3000\u3042\u304A\u308A\u3093\u3054\u306F\u3000\u9178\u5473\u304C\u5F37\u304F\\n\u8868\u9762\u3092\u304A\u304A\u3046\u3000\u6C34\u3042\u3081\u3068\u3000\u76F8\u6027\u304C\u3000\u826F\u3044\u3002",
  "\u4EBA\u9593\u306B\u306F\u3000\u3068\u3066\u3064\u3082\u306A\u304F\u3000\u82E6\u3044\u306E\u3060\u304C\\n\u898B\u305F\u76EE\u306B\u3000\u3060\u307E\u3055\u308C\u308B\u3000\u5B50\u4F9B\u306F\u3000\u5F8C\u3092\u7D76\u305F\u306A\u3044\u3002",
  "\u8F9B\u304F\u3066\u3000\u6E0B\u3044\u3000\u30BA\u30EA\u306E\u307F\u3000\uFF11\uFF10\uFF10\uFF05\u3000\u306A\u306E\u3067\\n\u4EBA\u9593\u304C\u98DF\u3079\u308B\u3068\u3000\u4F55\u3068\u3082\u3044\u3048\u306A\u3044\u3000\u9854\u306B\u306A\u308B\u3002",
  "\u307B\u304B\u306E\u3000\u304D\u306E\u307F\u306B\u3000\u6BD4\u3079\u308B\u3068\u3000\u98DF\u3079\u3084\u3059\u304F\\n\u8907\u96D1\u306A\u3000\u5473\u308F\u3044\u304C\u3000\u901A\u306E\u9593\u3067\u3000\u4EBA\u6C17\u306A\u306E\u3060\u3002",
  "\u6C34\u3042\u3081\u306E\u3000\u7518\u3055\u3068\u3000\u8F9B\u304F\u3066\u3000\u9178\u3063\u3071\u3044\\n\u30D1\u30A4\u30EB\u306E\u3000\u5473\u304C\u3000\u7D76\u5999\u306A\u3000\u4E00\u54C1\u3002",
  "\u5B66\u5712\u30D4\u30B6",
  "\u5B66\u5712\u30B7\u30A7\u30FC\u30AD",
