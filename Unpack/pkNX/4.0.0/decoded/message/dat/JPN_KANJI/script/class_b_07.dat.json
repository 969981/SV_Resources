[
  "\u3054\u304D\u3052\u3093\u3088\u3046\u3000{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\\n{\u697D|\u305F\u306E}\u3057\u3044{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306B\u3000\u3057\u307E\u3057\u3087\u3046\u306D[VAR 0114(0025)]",
  "{\u524D|\u307E\u3048}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u6280|\u308F\u3056}\u306E{\u547D\u4E2D|\u3081\u3044\u3061\u3085\u3046}\u3067\\n{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3092\u3000\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u307E\u3057\u305F\u306D[VAR 0114(0025)]",
  "{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3063\u3066\u3000\u304A\u3082\u3057\u308D\u304F\u3063\u3066\u3000\u30AF\u30E9\u30B9\u306B\\n{\u751F\u5F92|\u305B\u3044\u3068}\u304C\u3000\uFF14\uFF10{\u4EBA|\u306B\u3093}\u3044\u305F\u3089\u3000\uFF19\uFF10\uFF05\u306E{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3067\\r\\n{\u540C|\u304A\u306A}\u3058\u3000{\u8A95\u751F\u65E5|\u305F\u3093\u3058\u3087\u3046\u3073}\u306E{\u4EBA|\u3072\u3068}\u304C\u3000\uFF11{\u7D44|\u304F\u307F}\u306F\u3000\u3044\u308B\u3089\u3057\u3044\u308F[VAR 0114(0025)]",
  "\uFF11{\u5E74|\u306D\u3093}\u3063\u3066\u3000\uFF13\uFF10\uFF10{\u65E5\u4EE5\u4E0A|\u306B\u3061\u3044\u3058\u3087\u3046}\\n\u3042\u308B\u306E\u306B\u3000{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u3088\u306D[VAR 0114(0025)]",
  "\u3068\u3053\u308D\u3067\u3000\u307F\u306A\u3055\u3093\u306B\u306F\u3000{\u4ECA|\u3044\u307E}\u307E\u3067\\n\u30BF\u30A4\u30D7{\u76F8\u6027|\u3042\u3044\u3057\u3087\u3046}\u3068\u304B\u3000{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u3068\u304B\u2026\u2026[VAR 0114(0025)]",
  "{\u80FD\u529B\u4E0A\u6607|\u306E\u3046\u308A\u3087\u304F\u3058\u3087\u3046\u3057\u3087\u3046}\u3068\u304B\u306E\\n\u30C0\u30E1\u30FC\u30B8{\u8A08\u7B97|\u3051\u3044\u3055\u3093}\u3092\u3000{\u6559|\u304A\u3057}\u3048\u3066\u304D\u307E\u3057\u305F\u306D[VAR 0114(0025)]",
  "\u3053\u308C\u3089\u306F\u3000{\u5168\u90E8|\u305C\u3093\u3076}\u3000\u304B\u3051{\u7B97|\u3056\u3093}\u3055\u308C\u3066\\n{\u76F8\u624B|\u3042\u3044\u3066}\u306E\u3000{\u4F53\u529B|\u305F\u3044\u308A\u3087\u304F}\u3092\u3000\u3051\u305A\u3063\u3066\u3044\u304F\u308F[VAR 0114(0025)]",
  "\u3060\u3051\u3069\u3000\u3058\u3064\u306F\u3000\u3053\u308C\u3089\u3088\u308A\u3082\\n\u3068\u3063\u3066\u3082\u3000{\u7C21\u5358|\u304B\u3093\u305F\u3093}\u306A\u3053\u3068\u3067\\r\\n{\u6280|\u308F\u3056}\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u3000{\u4E0A|\u3042}\u3052\u3089\u308C\u308B\u306E[VAR 0114(0025)]",
  "\u305D\u308C\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u306E\u30BF\u30A4\u30D7\u3068\\n{\u540C|\u304A\u306A}\u3058{\u6280|\u308F\u3056}\u3092\u3000{\u4F7F|\u3064\u304B}\u3046\u3053\u3068\uFF01[VAR 0114(0025)]",
  "\u3044\u308F\u30BF\u30A4\u30D7\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\n\u3044\u308F\u306E{\u6280|\u308F\u3056}\u3000\u30B9\u30C8\u30FC\u30F3\u30A8\u30C3\u30B8\u3092\u3000{\u4F7F|\u3064\u304B}\u3046\u3068\\r\\n{\u5A01\u529B|\u3044\u308A\u3087\u304F}\uFF11\uFF10\uFF10\u304C\u3000\uFF11\uFF0E\uFF15{\u500D|\u3070\u3044}\u3067\u3000\uFF11\uFF15\uFF10\u306B\u3000\u306A\u308B\u306E[VAR 0114(0025)]",
  "{\u4F3C|\u306B}\u3066\u308B\u3051\u3069\u3000\u3058\u3081\u3093\u30BF\u30A4\u30D7\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\n\u30B9\u30C8\u30FC\u30F3\u30A8\u30C3\u30B8\u3092\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u3082\\r\\n{\u5A01\u529B|\u3044\u308A\u3087\u304F}\u306F\u3000\uFF11\uFF10\uFF10\u306E\u307E\u307E\u3000\u306A\u306E\u3088\u306D[VAR 0114(0025)]",
  "\u3053\u306E{\u6570\u5B57|\u3059\u3046\u3058}\u306B\u3000{\u52B9\u679C|\u3053\u3046\u304B}\u30D0\u30C4\u30B0\u30F3\u3084\\n{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u306E\u3000\u304B\u3051{\u7B97|\u3056\u3093}\u304C\u3000{\u4E57|\u306E}\u3063\u3066\u304F\u308B\u304B\u3089\\r\\n\u3042\u306A\u3069\u308C\u306A\u3044\u3000{\u6570\u5B57|\u3059\u3046\u3058}\u306A\u306E\u3088[VAR 0114(0025)]",
  "\u305D\u308C\u3067\u306F\u3000\u3061\u3083\u3093\u3068\\n{\u7406\u89E3|\u308A\u304B\u3044}\u3067\u304D\u3066\u308B\u304B\u3000{\u554F\u984C|\u3082\u3093\u3060\u3044}\u306D[VAR 0114(0025)]",
  "{\u5A01\u529B|\u3044\u308A\u3087\u304F}\uFF11\uFF10\uFF10\u306E\u3000\u30BF\u30A4\u30D7{\u4E00\u81F4\u6280|\u3044\u3063\u3061\u308F\u3056}\u3092\\n{\u5F31\u70B9|\u3058\u3083\u304F\u3066\u3093}\u306E{\u76F8\u624B|\u3042\u3044\u3066}\u306B\u3000{\u5F53|\u3042}\u3066\u308B\u3068\u3000\u305D\u306E{\u5A01\u529B|\u3044\u308A\u3087\u304F}\u306F\uFF1F[VAR 0114(0025)]",
  "\uFF11\uFF15\uFF10",
  "\uFF12\uFF10\uFF10",
  "\uFF13\uFF10\uFF10",
  "\u3093\u30FC\u3000{\u60DC|\u304A}\u3057\u3044\uFF01\\n\uFF11\uFF15\uFF10\u3060\u3068\u3000\u30BF\u30A4\u30D7{\u4E00\u81F4|\u3044\u3063\u3061}\u306E\u3000\uFF11\uFF0E\uFF15{\u500D|\u3070\u3044}\u3057\u304B\\r\\n\u304B\u3051{\u7B97|\u3056\u3093}\u3000\u3055\u308C\u3066\u306A\u3044\u307F\u305F\u3044[VAR 0114(0025)]",
  "\u3093\u30FC\u3000{\u60DC|\u304A}\u3057\u3044\uFF01\\n\uFF12\uFF10\uFF10\u3060\u3068\u3000{\u5F31\u70B9|\u3058\u3083\u304F\u3066\u3093}\u306E\u3000\uFF12{\u500D|\u3070\u3044}\u3057\u304B\\r\\n\u304B\u3051{\u7B97|\u3056\u3093}\u3000\u3055\u308C\u3066\u306A\u3044\u307F\u305F\u3044[VAR 0114(0025)]",
  "{\u982D|\u3042\u305F\u307E}\u306E{\u4E2D|\u306A\u304B}\u3067\u3000{\u8A08\u7B97|\u3051\u3044\u3055\u3093}\u3000\u3055\u3059\u304C\u306D\uFF01\\n[VAR 0100(0000)]\u3055\u3093\u3000\u3048\u3089\u3044\u308F\uFF01[VAR 0114(0025)]",
  "{\u5A01\u529B|\u3044\u308A\u3087\u304F}\u304C\u3000\uFF11\uFF10\uFF10\u3067\\n\u30BF\u30A4\u30D7{\u4E00\u81F4|\u3044\u3063\u3061}\u306E\u3000\u304B\u3051{\u7B97|\u3056\u3093}\u3057\u3066\\r\\n\uFF11\uFF0E\uFF15{\u500D|\u3070\u3044}\u3067\u3000\uFF11\uFF15\uFF10\uFF01[VAR 0114(0025)]",
  "\uFF11\uFF15\uFF10\u306B\u3000{\u5F31\u70B9|\u3058\u3083\u304F\u3066\u3093}\u306E\u3000\uFF12{\u500D|\u3070\u3044}\u3092\\n\u304B\u3051{\u7B97|\u3056\u3093}\u3057\u3066\u3000\uFF13\uFF10\uFF10\uFF01[VAR 0114(0025)]",
  "\u306A\u3093\u3068\uFF01\u3000\u3082\u3068\u306E{\u5A01\u529B|\u3044\u308A\u3087\u304F}\u306E\\n\uFF13{\u500D|\u3070\u3044}\u306B\u3000\u306A\u3063\u3061\u3083\u3063\u305F\uFF01[VAR 0114(0025)]",
  "\u3057\u304B\u3082\u3000\u3082\u3068\u306E\u30BF\u30A4\u30D7\u3068\\n{\u540C|\u304A\u306A}\u3058\u3000\u30C6\u30E9\u30B9\u30BF\u30A4\u30D7\u306B\u3000\u306A\u308B\u3068\\r\\n\u30BF\u30A4\u30D7{\u4E00\u81F4|\u3044\u3063\u3061}\u306E\u3000{\u500D\u6570|\u3070\u3044\u3059\u3046}\u306F\\r\\n\uFF11\uFF0E\uFF15{\u500D|\u3070\u3044}\u3067\u306A\u304F\u3000\uFF12{\u500D|\u3070\u3044}\u306B\u3082\u3000\u306A\u308A\u307E\u3059\uFF01[VAR 0114(0025)]",
  "\u3082\u3061\u308D\u3093\u3000{\u9055|\u3061\u304C}\u3046\u30BF\u30A4\u30D7\u306E\u3000{\u6280|\u308F\u3056}\u3092\\n\u305F\u304F\u3055\u3093\u3000{\u4F7F|\u3064\u304B}\u3048\u308B\u306E\u3082\u3000\u3059\u3054\u3044\u3053\u3068\u3088\\r\\n{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000\u30D3\u30C3\u30AF\u30EA\u3055\u305B\u3089\u308C\u308B\u3082\u306E[VAR 0114(0025)]",
  "\u3067\u3082\u3000{\u4EBA\u9593|\u306B\u3093\u3052\u3093}\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\u306D[VAR 0114(0025)]",
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u306F\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u306E{\u6301|\u3082}\u3061{\u5473|\u3042\u3058}\u304C\\n{\u4E00\u756A|\u3044\u3061\u3070\u3093}\u3000{\u529B|\u3061\u304B\u3089}\u3092\u3000{\u767A\u63EE|\u306F\u3063\u304D}\u3059\u308B\u3063\u3066\u3053\u3068[VAR 0114(0025)]",
  "\u304A\u307C\u3048\u3066\u304A\u3044\u3066\u304F\u308C\u308B\u3068\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3000\u3068\u3063\u3066\u3082\u3000\u3046\u308C\u3057\u3044\u308F[VAR 0114(0025)]",
  "\u2026\u2026\u3059\u3063\u3054\u304F\u3000{\u521D\u6B69\u7684|\u3057\u3087\u307B\u3066\u304D}\u306A\u3053\u3068\\n{\u4ECA|\u3044\u307E}\u3055\u3089\u3067\u3000\u3054\u3081\u3093\u306A\u3055\u3044\u306D[VAR 0114(0025)]",
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3082\u3000\u3042\u3063\u3068\u3044\u3046{\u9593|\u307E}\u306B\\n{\u7D42|\u304A}\u308F\u3063\u3061\u3083\u3063\u305F\u308F\u306D[VAR 0114(0025)]",
  "\u307F\u306A\u3055\u3093\u3000{\u610F\u6B32\u7684|\u3044\u3088\u304F\u3066\u304D}\u306B\u3000{\u6570\u5B57|\u3059\u3046\u3058}\u3092\\n{\u5B66|\u307E\u306A}\u3093\u3067\u304F\u308C\u3066\u3000\u3068\u3063\u3066\u3082\u3000{\u697D|\u305F\u306E}\u3057\u304B\u3063\u305F\u308F[VAR 0114(0025)]",
  "{\u6B21\u56DE|\u3058\u304B\u3044}\u306F\u3000{\u697D|\u305F\u306E}\u3057\u3044\u3000{\u671F\u672B|\u304D\u307E\u3064}\u30C6\u30B9\u30C8\u3067\u3059\uFF01\\n\u3057\u3063\u304B\u308A\u3000{\u5FA9\u7FD2|\u3075\u304F\u3057\u3085\u3046}\u3057\u3066\u3000\u306E\u305E\u3093\u3067\u304F\u3060\u3055\u3044\u306D[VAR 0114(0025)]"
