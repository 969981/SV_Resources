  "{\u5FC3|\u3053\u3053\u308D}\u306E\u304A{\u4F11|\u3084\u3059}\u307F\u3092\u3000\u3068\u3063\u3066\u3044\u305F\u3060\u304D\u305F\u304F\u3066\\n{\u7559\u5B66|\u308A\u3085\u3046\u304C\u304F}\u3068\u3044\u3046{\u540D\u76EE|\u3081\u3044\u3082\u304F}\u3067\u3000\u3054{\u5B9F\u5BB6|\u3058\u3063\u304B}\u306E\\r\\n\u30AC\u30E9\u30EB{\u5730\u65B9|\u3061\u307B\u3046}\u306B\u3000{\u5E30\u7701|\u304D\u305B\u3044}\u3057\u3066\u3082\u3089\u3044\u307E\u3057\u305F[VAR 0114(003C)]",
  "\u305D\u3093\u306A{\u77E2\u5148|\u3084\u3055\u304D}\u3000{\u5F53\u6642|\u3068\u3046\u3058}\u306E{\u6559\u982D|\u304D\u3087\u3046\u3068\u3046}\u304C\\n{\u81EA\u8EAB|\u3058\u3057\u3093}\u306E{\u8CAC\u4EFB|\u305B\u304D\u306B\u3093}\u304B\u3089\u3000{\u9003|\u306E\u304C}\u308C\u308B\u305F\u3081\\c\\n{\u4E8B\u4EF6|\u3058\u3051\u3093}\u306B\u3000{\u95A2\u9023|\u304B\u3093\u308C\u3093}\u3059\u308B{\u8A18\u9332|\u304D\u308D\u304F}\u3092\\n\u30B5\u30FC\u30D0\u30FC\u304B\u3089\u3000{\u6D88|\u3051}\u3057\u3066\u3057\u307E\u3063\u305F\u306E\u3067\u3059\u2026\u2026[VAR 0114(003C)]",
  "\u306A\u3093\u3066\u3053\u3068\u3092\uFF01\\n{\u96A0|\u3044\u3093}\u307A\u3044\u3055\u308C\u3066\u3044\u305F\u306E\u3067\u3059\u304B\u2026\u2026\uFF01[VAR 0114(001E)]",
  "\u3082\u3061\u308D\u3093\u3000{\u6559\u982D|\u304D\u3087\u3046\u3068\u3046}\u306B\u306F\\n\u3057\u304B\u308B\u3079\u304D{\u5BFE\u51E6|\u305F\u3044\u3057\u3087}\u3092\u3000\u304A\u3053\u306A\u3044\u307E\u3057\u305F[VAR 0114(003C)]",
  "\u3057\u304B\u3057\u3000\u305D\u306E{\u884C\u70BA|\u3053\u3046\u3044}\u3092\\n{\u6B62|\u3068}\u3081\u3089\u308C\u306A\u304B\u3063\u305F\u3000\u30EF\u30BF\u30AF\u30B7\u3084\\r\\n\u307B\u304B\u306E{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3082\u3000{\u540C\u7F6A|\u3069\u3046\u3056\u3044}\u3067\u3059\u2026\u2026[VAR 0114(003C)]",
  "{\u8CAC\u4EFB|\u305B\u304D\u306B\u3093}\u3092\u3068\u3063\u3066\u3000\u30EF\u30BF\u30AF\u30B7\u306F\\n{\u6821\u9577|\u3053\u3046\u3061\u3087\u3046}\u3068\u3044\u3046{\u8077|\u3057\u3087\u304F}\u3092\u3000{\u5F15\u9000|\u3044\u3093\u305F\u3044}\u3057\\c\\n{\u5F53\u6642|\u3068\u3046\u3058}\u306E{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304C\u305F\u3082\u3000{\u5168\u54E1|\u305C\u3093\u3044\u3093}\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000\u3084\u3081\u3066\u3044\u305F\u3060\u304D\u307E\u3057\u305F[VAR 0114(003C)]",
  "\u305D\u308C\u3067\u3000\uFF11{\u5E74\u534A\u524D|\u306D\u3093\u306F\u3093\u307E\u3048}\u3000{\u5148\u751F|\u305B\u3093\u305B\u3044}\u305F\u3061\u304C\\n{\u7DCF\u5165|\u305D\u3046\u3044}\u308C{\u66FF|\u304B}\u3048\u306B\u3000\u306A\u3063\u305F\u306E\u3067\u3059\u306D\u2026\u2026[VAR 0114(001E)]",
  "\u3054{\u8FF7\u60D1|\u3081\u3044\u308F\u304F}\u3092\u3000\u304A\u304B\u3051\u3057\u307E\u3057\u305F\u306D[VAR 0114(003C)]",
  "{\u723A|\u3058\u3044}\u3084\u3000\u3069\u3046\u3057\u3066\\n{\u4ECA|\u3044\u307E}\u306B\u306A\u3063\u3066\u3000\u305D\u3093\u306A{\u8A71|\u306F\u306A\u3057}\u3092\uFF1F[VAR 0114(0020)]",
  "\u2026\u2026{\u574A|\u307C\u3063}\u3061\u3083\u307E\u3082\u3000\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u3082\\n{\u4ECA|\u3044\u307E}\u306E\u307E\u307E\u3067\u306F\u3000\u3088\u304F\u3042\u308A\u307E\u305B\u3093\\r\\n{\u4F55|\u306A\u306B}\u304B\u3000\u304D\u3063\u304B\u3051\u306B\u3000\u306A\u308C\u3070\u3068\u2026\u2026[VAR 0114(003C)]",
  "{\u4ECA|\u3044\u307E}\u3055\u3089\u3000{\u4EF2\u9593|\u306A\u304B\u307E}\u3000{\u88CF\u5207|\u3046\u3089\u304E}\u3063\u3066\u3000\u30AA\u30EC\u3060\u3051\\n{\u5B66\u6821\u884C|\u304C\u3063\u3053\u3046\u3044}\u304F\u306A\u3093\u3066\u3000{\u8003|\u304B\u3093\u304C}\u3048\u3089\u308C\u306A\u3044\u3088[VAR 0114(0020)]",
  "\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306E\u307F\u3093\u306A\u304C\\n{\u5927\u4E8B|\u3060\u3044\u3058}\u306A\u306E\u3067\u3059\u306D[VAR 0114(001E)]",
  "\u3042\u305F\u308A\u307E\u3048\u3060\u308D[VAR 0114(0020)]",
  "\u30AA\u30EC\u306E\u2026\u2026\u3000{\u5B9D\u7269|\u305F\u304B\u3089\u3082\u3093}\u3060\u3082\u3093[VAR 0114(0020)]"
]
