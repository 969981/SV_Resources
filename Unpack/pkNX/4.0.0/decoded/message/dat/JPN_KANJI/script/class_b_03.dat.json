[
  "\u3054\u304D\u3052\u3093\u3088\u3046\\n{\u697D|\u305F\u306E}\u3057\u3044{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306B\u3000\u3057\u307E\u3057\u3087\u3046\u306D[VAR 0114(0025)]",
  "\u307F\u306A\u3055\u3093\u3000{\u5360|\u3046\u3089\u306A}\u3044\u3063\u3066\\n\u304A{\u597D|\u3059}\u304D\u304B\u3057\u3089\uFF1F[VAR 0114(0025)]",
  "{\u671D|\u3042\u3055}\u306E\u30CB\u30E5\u30FC\u30B9\u306E\u3000{\u5360|\u3046\u3089\u306A}\u3044\u30B3\u30FC\u30CA\u30FC\u3067\\n{\u904B\u52E2|\u3046\u3093\u305B\u3044}\u304C\u3000\u3088\u304B\u3063\u305F\u3089\\r\\n\u306A\u3093\u3068\u306A\u304F\u3000\u30EB\u30F3\u30EB\u30F3{\u6C17\u5206|\u304D\u3076\u3093}\u3088\u306D[VAR 0114(0025)]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000{\u904B|\u3046\u3093}\u306B\u307E\u3064\u308F\u308B\u3000\u304A{\u984C|\u3060\u3044}\u3067\\n{\u6570\u5B57|\u3059\u3046\u3058}\u3092\u3000\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u3066\u3044\u304D\u307E\u3057\u3087\u3046\uFF01[VAR 0114(0025)]",
  "\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3067\u3000\u305F\u307E\u306B\u3000{\u8D77|\u304A}\u304D\u308B\\n\u2026\u2026{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u306B\u3000{\u5F53|\u3042}\u305F\u3063\u305F\uFF01\\r\\n{\u898B|\u307F}\u305F\u3053\u3068\u3000\u3042\u308B\u3093\u3058\u3083\u306A\u3044\u304B\u3057\u3089\uFF1F[VAR 0114(0025)]",
  "{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u306B\u3000{\u5F53|\u3042}\u305F\u308B\u3068\u3000\u30C0\u30E1\u30FC\u30B8\u304C\\n\u3044\u3064\u3082\u3088\u308A\u3000\u3082\u3046{\u534A\u5206|\u306F\u3093\u3076\u3093}\u3000{\u591A|\u304A\u304A}\u3044\\r\\n\uFF11\uFF0E\uFF15{\u500D|\u3070\u3044}\u306B\u3082\u3000\u306A\u3063\u3066\u3057\u307E\u3046\u306E[VAR 0114(0025)]",
  "\u3044\u3064\u3000{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u306B{\u5F53|\u3042}\u305F\u308B\u304B\u3000{\u5F53|\u3042}\u3066\u3089\u308C\u308B\u304B\u306F\\n\u307E\u3063\u305F\u304F\u306E{\u904B|\u3046\u3093}\u2026\u2026\u3000\u30E9\u30C3\u30AD\u30FC\u306A\u3093\u3067\u3059\u3051\u3069\\r\\n\u305D\u308C\u304C\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u306B\u3000{\u6CE2\u4E71|\u306F\u3089\u3093}\u3092\u3000{\u8D77|\u304A}\u3053\u3059\u3093\u3067\u3059[VAR 0114(0025)]",
  "\u305D\u308C\u3067\u306F\u3000{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u306B\u3000{\u5F53|\u3042}\u305F\u308B\\n{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3092\u3000{\u77E5|\u3057}\u3063\u3066\u3044\u308B{\u4EBA|\u3072\u3068}\u306F\u3000\u3044\u307E\u3059\u304B\uFF1F[VAR 0114(0025)]",
  "{\u7D04|\u3084\u304F}\uFF11\uFF05\u3000\uFF08\uFF11\uFF10\uFF10{\u56DE|\u304B\u3044}\u306B\uFF11{\u56DE|\u304B\u3044}\uFF09",
  "{\u7D04|\u3084\u304F}\uFF14\uFF05\u3000\uFF08\uFF11\uFF10\uFF10{\u56DE|\u304B\u3044}\u306B\uFF14{\u56DE|\u304B\u3044}\uFF09",
  "{\u7D04|\u3084\u304F}\uFF11\uFF12\uFF05\u3000\uFF08\uFF11\uFF10\uFF10{\u56DE|\u304B\u3044}\u306B\uFF11\uFF12{\u56DE|\u304B\u3044}\uFF09",
  "\u3046\u3075\u3075\u3000[VAR 0100(0000)]\u3055\u3093\\n{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u3063\u3066\u3000\u3082\u3046\u3061\u3087\u3063\u3068\u3000{\u5F53|\u3042}\u305F\u3063\u3061\u3083\u3046\u306E\u3088[VAR 0114(0025)]",
  "\u306F\u3044\u3000\u3088\u304F\u3067\u304D\u307E\u3057\u305F\uFF01\\n\u3055\u3059\u304C\u3000[VAR 0100(0000)]\u3055\u3093\uFF01[VAR 0114(0025)]",
  "\u3046\u3075\u3075\u3000[VAR 0100(0000)]\u3055\u3093\\n\u3055\u3059\u304C\u306B\u3000\u305D\u308C\u306F\u3000{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u3059\u304E\u308B\u304B\u3082\uFF1F[VAR 0114(0025)]",
  "{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u306B\u3000{\u5F53|\u3042}\u305F\u308B\u3000{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u306F\\n{\u6B63\u78BA|\u305B\u3044\u304B\u304F}\u306B\u306F\u3000\uFF12\uFF14{\u5206|\u3076\u3093}\u306E\uFF11\u2026\u2026\\r\\n\uFF14\uFF0E\uFF11\uFF17\uFF05\u3068\u3000\u3044\u308F\u308C\u3066\u3044\u307E\u3059[VAR 0114(0025)]",
  "{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u306B\u3000{\u5F53|\u3042}\u305F\u308A\u3084\u3059\u3044{\u6280|\u308F\u3056}\u3082\u3000\u3042\u3063\u3066\\n\u30B9\u30C8\u30FC\u30F3\u30A8\u30C3\u30B8\u3084\u3000\u30B7\u30E3\u30C9\u30FC\u30AF\u30ED\u30FC\u3060\u3068\\r\\n{\u7D04|\u3084\u304F}\uFF11\uFF12\uFF05\u306E{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3067\u3000{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u306B\uFF01[VAR 0114(0025)]",
  "\u304D\u3042\u3044\u3060\u3081\u3000\u3068\u3044\u3046{\u6280|\u308F\u3056}\u3084\\n\u30AF\u30EA\u30C6\u30A3\u30AB\u30C3\u30C8\u3000\u3068\u3044\u3046{\u9053\u5177|\u3069\u3046\u3050}\u3092\u3000{\u4F7F|\u3064\u304B}\u3046\u3068[VAR 0114(0025)]",
  "{\u6025\u6240\u7387|\u304D\u3085\u3046\u3057\u3087\u308A\u3064}\u304C\u3000\uFF12{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u3082\u3000{\u4E0A|\u3042}\u304C\u3063\u3066\\n\uFF15\uFF10\uFF05\u306E{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3067\u3000{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u3092\u3000{\u72D9|\u306D\u3089}\u3048\u307E\u3059[VAR 0114(0025)]",
  "{\u5F53|\u3042}\u305F\u3063\u3066\u3000\u3046\u308C\u3057\u3044\u3000{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\\n{\u5F53|\u3042}\u3066\u3089\u308C\u3066\u3000\u304F\u3084\u3057\u3044\u3000{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}[VAR 0114(0025)]",
  "\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3063\u3066\u3000{\u601D|\u304A\u3082}\u3063\u305F\u3088\u308A\\n{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u306E{\u6570\u5B66|\u3059\u3046\u304C\u304F}\u304C\u3000{\u96A0|\u304B\u304F}\u308C\u3066\u3044\u308B\u3093\u3067\u3059[VAR 0114(0025)]",
  "{\u8A08\u7B97|\u3051\u3044\u3055\u3093}\u3057\u3066\u3000\u30E9\u30C3\u30AD\u30FC\u3092\u3000{\u51FA|\u3060}\u305B\u305F\u3089\\n\u3082\u3063\u3068\u3000{\u6226\u7565|\u305B\u3093\u308A\u3083\u304F}\u306E{\u5E45|\u306F\u3070}\u304C\u3000{\u5E83|\u3072\u308D}\u304C\u308B\u304B\u3082\u3067\u3059\u3088[VAR 0114(0025)]",
  "\u3042\u3089\u3000\u30C1\u30E3\u30A4\u30E0\uFF1F\\n\u3082\u3046{\u7D42|\u304A}\u308F\u308A\u306A\u306E\u306D\u3000{\u6B8B\u5FF5|\u3056\u3093\u306D\u3093}\u2026\u2026[VAR 0114(0025)]",
  "{\u6B21\u56DE|\u3058\u304B\u3044}\u306F\u3000{\u697D|\u305F\u306E}\u3057\u3044\u3000{\u4E2D\u9593|\u3061\u3085\u3046\u304B\u3093}\u30C6\u30B9\u30C8\u3067\u3059\uFF01\\n\u307F\u306A\u3055\u3093\u3000{\u5FC3\u5F85|\u3053\u3053\u308D\u307E}\u3061\u306B\u3000\u3057\u3066\u3044\u3066\u304F\u3060\u3055\u3044\u306D[VAR 0114(0025)]"
]
