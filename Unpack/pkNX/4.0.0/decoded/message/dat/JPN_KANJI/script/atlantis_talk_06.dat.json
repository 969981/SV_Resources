[
  "[VAR 0101(0001)]\u3063\u3066\u3000\u30BF\u30A4\u30E0\u30DE\u30B7\u30F3\u3067\\n{\u4ECA|\u3044\u307E}\u306E{\u6642\u4EE3|\u3058\u3060\u3044}\u306B\u3000{\u6765|\u304D}\u3066\u304B\u3089\u306F\u2026\u2026[VAR 0114(0004)]",
