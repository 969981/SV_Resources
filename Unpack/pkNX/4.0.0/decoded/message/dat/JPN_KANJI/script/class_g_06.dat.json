[
  "{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3000\u30B9\u30DE\u30DB\u3092\u3000\u3057\u307E\u3044\u305F\u307E\u3048\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u3088\u3046[VAR 0114(0029)]",
  "\u30D5\u30A3\u30FC\u30EB\u30C9\u30EF\u30FC\u30AF{\u4E2D|\u3061\u3085\u3046}\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\n\u305A\u3063\u3068\u3000\u3064\u308C{\u6B69|\u3042\u308B}\u3044\u3066\u3044\u308B\u3068[VAR 0114(0029)]",
  "\u30DD\u30B1\u30E2\u30F3\u306E{\u8272\u5473|\u3044\u308D\u307F}\u304C\u3000{\u5909\u5316|\u3078\u3093\u304B}\u3057\u3066\u3044\u308B\u306E\u306B\\n{\u6C17|\u304D}\u3065\u3044\u305F{\u8005|\u3082\u306E}\u306F\u3000\u3044\u308B\u3060\u308D\u3046\u304B\uFF1F[VAR 0114(0029)]",
  "\u3044\u3084\u306A\u306B\u3000{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n\u306A\u3063\u305F\u308F\u3051\u3067\u306F\u3000\u306A\u3044\u2026\u2026[VAR 0114(0029)]",
  "\u2026\u2026{\u6C5A|\u3088\u3054}\u308C\u3066\u3044\u308B\u306E\u3060\uFF01\uFF01[VAR 0114(0029)]",
  "{\u6226\u95D8|\u305B\u3093\u3068\u3046}\u3092\u3000\u304B\u3055\u306D\uFF01\uFF01\\n{\u6280|\u308F\u3056}\u3092{\u53D7|\u3046}\u3051\u3000{\u50B7|\u304D\u305A}\u3064\u304D\uFF01\uFF01[VAR 0114(0029)]",
  "{\u96E8\u98A8|\u3042\u3081\u304B\u305C}\u306B\u3000\u307E\u307F\u308C\uFF01\uFF01\\n{\u7802|\u3059\u306A}\u3084\u3000\u3069\u308D\u3092\u3000\u307E\u3068\u3044\uFF01\uFF01[VAR 0114(0029)]",
  "{\u6C5A|\u3088\u3054}\u308C\u3066\u3057\u307E\u3063\u3066\u3044\u308B\u306E\u3060\uFF01\uFF01[VAR 0114(0029)]",
  "\u304B\u308F\u3044\u3044\u3000\u30DD\u30B1\u30E2\u30F3\u3061\u3083\u3093\u3092\\n{\u6C5A|\u3088\u3054}\u308C\u305F\u307E\u307E\u3000\u3064\u308C{\u6B69|\u3042\u308B}\u3044\u3066\u3044\u308B\\r\\n\u30C8\u30EC\u30FC\u30CA\u30FC\u304C\u3000{\u591A|\u304A\u304A}\u304F\u3000{\u898B\u53D7|\u307F\u3046}\u3051\u3089\u308C\u308B\\r\\n\u2026\u2026\u306A\u3052\u304B\u308F\u3057\u3044\u3053\u3068\u3060[VAR 0114(0029)]",
  "\u3067\u306F\u3000\u305D\u3093\u306A\u3000{\u6065|\u306F}\u305A\u3079\u304D{\u884C\u70BA|\u3053\u3046\u3044}\u3092\\n{\u8A31|\u3086\u308B}\u305B\u306A\u3044\u3000[VAR 0100(0000)]\u3055\u3093\u306B\u3000{\u554F|\u3068}\u304A\u3046[VAR 0114(0029)]",
  "\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u6C5A|\u3088\u3054}\u308C\u3066\u304D\u305F\u3089\\n\u3069\u3046\u3059\u308C\u3070\u3000\u3088\u3044\u306E\u3060\uFF1F[VAR 0114(0029)]",
  "{\u6D17|\u3042\u3089}\u3063\u3066\u3042\u3052\u308B",
  "{\u982D|\u3042\u305F\u307E}\u3092\u306A\u3067\u308B",
  "\u307B\u3046\u3063\u3066\u304A\u304F",
  "\u3054{\u540D\u7B54|\u3081\u3044\u3068\u3046}\uFF01\u3000\u304D\u307F\u306A\u3089\u3000\u305D\u306E\u3088\u3046\u306B\\n{\u7B54|\u3053\u305F}\u3048\u3066\u304F\u308C\u308B\u3068\u3000{\u78BA\u4FE1|\u304B\u304F\u3057\u3093}\u3057\u3066\u3044\u305F[VAR 0114(0029)]",
  "\u3046\u3080\u3046\u3080\uFF01\u3000\u3088\u304F\u3000\u304C\u3093\u3070\u3063\u305F\u306D\u3068\\n\u306A\u3067\u3066\u3042\u3052\u308C\u3070\u3000\u304A\u305F\u304C\u3044\u3000\u30CB\u30C3\u30B3\u30EA\u3060\u304C\\r\\n{\u6C5A|\u3088\u3054}\u308C\u304C\u3000{\u843D|\u304A}\u3061\u308B\u308F\u3051\u3067\u306F\u306A\u3044\uFF01[VAR 0114(0029)]",
  "\u305F\u3057\u304B\u306B\u3000{\u96E8|\u3042\u3081}\u3084\u3000\u3069\u308D{\u6C5A|\u3088\u3054}\u308C\u306F\\n\u307B\u3046\u3063\u3066\u304A\u3044\u3066\u3082\u3000{\u843D|\u304A}\u3061\u3066\u3044\u304F\u304C\u2026\u2026\\r\\n\u304D\u307F\u304B\u3089\u3000\u305D\u306E\u3088\u3046\u306A{\u8A00\u8449|\u3053\u3068\u3070}\u3092\u3000{\u805E|\u304D}\u304F\u3068\u306F\u306A[VAR 0114(0029)]",
  "{\u6C5A|\u3088\u3054}\u308C\u305F\u3089\u3000{\u6D17|\u3042\u3089}\u3046\uFF01\\n\u3053\u308C\u3053\u305D\u304C\u3000{\u4E16\u754C|\u305B\u304B\u3044}\u306E{\u5E38\u8B58|\u3058\u3087\u3046\u3057\u304D}\u3060\u306A[VAR 0114(0029)]",
  "\u30D4\u30AF\u30CB\u30C3\u30AF\u3092\u3000{\u958B|\u3072\u3089}\u3044\u3066\\n{\u624B\u6301|\u3066\u3082}\u3061\u306E\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u8FD1|\u3061\u304B}\u3065\u304F\u3068\\r\\n\u3044\u308D\u3044\u308D\u306A\u30A2\u30AF\u30B7\u30E7\u30F3\u3092\u3000\u304A\u3053\u306A\u3048\u308B[VAR 0114(0029)]",
  "\u305D\u306E{\u4E2D|\u306A\u304B}\u306E\u3000\u3072\u3068\u3064\u304C\\n\u30DD\u30B1\u30E2\u30F3\u30A6\u30A9\u30C3\u30B7\u30E5\uFF01\\r\\n\u2026\u2026\u3064\u307E\u308A\u3000{\u6D17|\u3042\u3089}\u3046\u3053\u3068\u3060\uFF01[VAR 0114(0029)]",
  "\u307E\u305A\u306F\u3000\u30B9\u30DD\u30F3\u30B8\u3092\u3000{\u6CE1\u7ACB|\u3042\u308F\u3060}\u3066\u306A\u304C\u3089\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u4F53|\u304B\u3089\u3060}\u3092\u3000{\u512A|\u3084\u3055}\u3057\u304F\\r\\n\u3066\u3044\u306D\u3044\u306B\u3000\u30B4\u30B7\u30B4\u30B7\u3059\u308B\u304C\u3044\u3044[VAR 0114(0029)]",
  "\u3058\u3085\u3046\u3076\u3093\u3000{\u6CE1\u7ACB|\u3042\u308F\u3060}\u3063\u305F\u3089\u3000{\u9803\u5408|\u3053\u308D\u3042\u3044}\u2026\u2026[VAR 0114(0029)]",
  "{\u6C5A|\u3088\u3054}\u308C\u3092\u3000\u3064\u3064\u3093\u3067\u3044\u308B\u3000{\u6CE1|\u3042\u308F}\u3092\\n\u30B7\u30E3\u30EF\u30FC\u3067\u3000\u30B5\u30C3\u30D1\u30EA\u3000{\u6D41|\u306A\u304C}\u3057\u3066\u3000{\u4ED5\u4E0A|\u3057\u3042}\u3052\u3060\uFF01[VAR 0114(0029)]",
  "\u30DD\u30B1\u30E2\u30F3\u306F\u3000\u30C6\u30E9\u30B9\u30BF\u30EB\u306E\u3054\u3068\u304F\\n\u3075\u305F\u305F\u3073\u3000\u304B\u304C\u3084\u304F\u3053\u3068\u3060\u308D\u3046[VAR 0114(0029)]",
  "{\u5927\u5909|\u305F\u3044\u3078\u3093}\u306A\u3000\u304A{\u4E16\u8A71|\u305B\u308F}\u3067\u306F\u3000\u3042\u308B\u304C\\n{\u4F53\u529B|\u305F\u3044\u308A\u3087\u304F}\u3082\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3057\u3000{\u72B6\u614B\u7570\u5E38|\u3058\u3087\u3046\u305F\u3044\u3044\u3058\u3087\u3046}\u3082\u3000{\u6CBB|\u306A\u304A}\u308B\u3060\u308D\u3046[VAR 0114(0029)]",
  "\u305F\u3060\u3057\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3000\u3088\u3063\u3066\u306F\\n\u30B4\u30B7\u30B4\u30B7\u3055\u308C\u305F\u304F\u306A\u3044\u3000{\u90E8\u5206|\u3076\u3076\u3093}\\r\\n{\u6C34|\u307F\u305A}\u306B{\u6FE1|\u306C}\u308C\u305F\u304F\u306A\u3044\u3000{\u90E8\u5206|\u3076\u3076\u3093}\u304C\u3000\u3042\u308B\u306E\u3067\\r\\n{\u6CE8\u610F|\u3061\u3085\u3046\u3044}\u3057\u3066\u3000\u3042\u3052\u308B\u3088\u3046\u306B[VAR 0114(0029)]",
  "\u305D\u3057\u3066\u3000\u3082\u3063\u3068\u3082\u3000{\u91CD\u8981|\u3058\u3085\u3046\u3088\u3046}\u306A\u306E\u306F\\n{\u6C5A|\u3088\u3054}\u308C{\u597D|\u305A}\u304D\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u3044\u308B\u3053\u3068[VAR 0114(0029)]",
  "{\u77DB\u76FE|\u3080\u3058\u3085\u3093}\u3059\u308B\u3053\u3068\u3092\u3000{\u8A00|\u3044}\u3046\u304C\\n{\u6D17|\u3042\u3089}\u3063\u3066\u3042\u3052\u308B\u3060\u3051\u304C\u3000{\u512A|\u3084\u3055}\u3057\u3055\u3067\u306F\\r\\n\u306A\u3044\u3053\u3068\u3092\u3000\u304A{\u5FD8|\u308F\u3059}\u308C\u306A\u304D\u3088\u3046\u3000\u305F\u306E\u3080[VAR 0114(0029)]",
  "{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u7D42\u4E86|\u3057\u3085\u3046\u308A\u3087\u3046}\u3060\\n\u3053\u308C\u306B\u3066\u3000{\u5931\u793C|\u3057\u3064\u308C\u3044}\u3059\u308B[VAR 0114(0029)]"
]
