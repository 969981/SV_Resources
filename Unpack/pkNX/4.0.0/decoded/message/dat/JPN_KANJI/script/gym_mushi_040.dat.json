  "\u30D3\u30E8\u30F3\u30C9",
  "\u3042\u3089\u3000\u3042\u3089\uFF5E\\n{\u7D20\u6575|\u3059\u3066\u304D}\u306A\u30C8\u30EC\u30FC\u30CA\u30FC\u3055\u3093\uFF5E[VAR 0114(002C)]",
  "\u30AA\u30EA\u30FC\u30D6\u3053\u308D\u304C\u3057\u3000{\u4E0A\u624B|\u3058\u3087\u3046\u305A}\u306B\\n\u30B3\u30ED\u30B3\u30ED\u3057\u3066\u304F\u308C\u3066\u3000\u3042\u308A\u304C\u3068\u306D\uFF5E[VAR 0114(002C)]",
  "\u3042\u3089\uFF5E\u3000{\u81EA\u5DF1|\u3058\u3053}{\u7D39\u4ECB|\u3057\u3087\u3046\u304B\u3044}\u304C\\n\u307E\u3060\u3060\u3063\u305F\u304B\u3057\u3089\uFF5E\uFF1F[VAR 0114(002C)]",
  "\u30D1\u30C6\u30A3\u30B9\u30EA\u30FC\u3000\u30E0\u30AF\u30ED\u30B8\\n{\u5E97\u9577|\u3066\u3093\u3061\u3087\u3046}\u306E\u3000\u30AB\u30A8\u30C7\u3067\u3059\uFF5E[VAR 0114(002C)]",
  "\u3042\u3089\u3089\uFF5E\uFF1F\u3000{\u4ECA|\u3044\u307E}\u306F\\n\u30BB\u30EB\u30AF\u30EB\u30B8\u30E0\u306E\u3000\u30B7\u30D5\u30C8\u3060\u3063\u305F\u308F\uFF5E[VAR 0114(0016)]",
  "\u3044\u3051\u306A\u3044\u3000\u3044\u3051\u306A\u3044\uFF5E\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306E\u3000\u30AB\u30A8\u30C7\u3067\u3059\u306D\uFF5E[VAR 0114(0016)]",
  "{\u666E\u6BB5|\u3075\u3060\u3093}\u306F\u3000\u304A{\u83D3\u5B50|\u304B\u3057}\u3092\u3000{\u4F5C|\u3064\u304F}\u3063\u3066\u308B\\n\u30D1\u30C6\u30A3\u30B7\u30A8\u3055\u3093\u3000\u306A\u3093\u3067\u3059\u3088\uFF5E[VAR 0114(0016)]",
  "{\u53E3|\u304F\u3061}\u306B\u3000{\u5165|\u3044}\u308C\u3066\u3000{\u5E78|\u3057\u3042\u308F}\u305B\u306A\u3000\u304A{\u83D3\u5B50|\u304B\u3057}\u3082\\n{\u8349\u6728|\u304F\u3055\u304D}\u306B\u3000\u3072\u305D\u3080\u3000\u3080\u3057\u30DD\u30B1\u30E2\u30F3\u3082\\r\\n{\u5C0F|\u3061\u3044}\u3055\u3044\u3051\u3069\u3000{\u5927|\u304A\u304A}\u304D\u306A{\u529B|\u3061\u304B\u3089}\u3092\u3000{\u6301|\u3082}\u3063\u3066\u307E\u3059\uFF5E[VAR 0114(0016)]",
  "{\u8DB3|\u3042\u3057}\u3092\u3000\u3059\u304F\u308F\u308C\u306A\u3044\u3088\u3046\\n\u3075\u3093\u3070\u3063\u3066\u304F\u3060\u3055\u3044\u306D\uFF5E[VAR 0114(0016)]",
  "\u3042\u306A\u305F\u306E{\u5F37|\u3064\u3088}\u3055\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u306E{\u6700\u4E2D|\u3055\u3044\u3061\u3085\u3046}\u3067\u3082\\n\u3069\u3093\u3069\u3093\u3000\u3075\u304F\u3089\u3093\u3067\u3044\u304D\u307E\u3057\u305F\uFF5E[VAR 0114(0016)]",
  "\u308F\u305F\u3057\u3082\u3000\u3082\uFF5E\u3063\u3068\\n{\u9032\u5316|\u3057\u3093\u304B}\u3057\u306A\u3044\u3068\u3000\u3067\u3059\u306D\uFF5E[VAR 0114(0016)]",
  "{\u6539|\u3042\u3089\u305F}\u3081\u307E\u3057\u3066\u3000{\u5408\u683C|\u3054\u3046\u304B\u304F}\u3067\uFF5E\u3059\uFF01\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306B\u3000{\u52DD|\u304B}\u3063\u305F{\u8A3C|\u3042\u304B\u3057}\u3068\u3057\u3066\\r\\n\u30B8\u30E0\u30D0\u30C3\u30B8\u3092\u3000\u3055\u3057\u3042\u3052\u307E\u3059\uFF5E[VAR 0114(0016)]",
  "\u30AB\u30A8\u30C7{\u7279\u88FD|\u3068\u304F\u305B\u3044}\u3000{\u624B\u4F5C|\u3066\u3065\u304F}\u308A\u30B1\u30FC\u30AD\u3082\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000\u305F\u30FC\u3093\u3068\u3000\u3081\u3057\u3042\u304C\u308C\uFF5E[VAR 0114(0016)]",
  "\u30B8\u30E0\u30D0\u30C3\u30B8\u3092\u3000[VAR 0200(0001)]\u3064\u3000\u304A{\u6301|\u3082}\u3061\u306A\u3089\\n\u30EC\u30D9\u30EB[VAR 0201(0002)]\u307E\u3067\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u306F\\r\\n{\u6355|\u3064\u304B}\u307E\u3048\u3084\u3059\u304F\u3000\u3044\u3046\u3053\u3068\u3082\u3000\u304D\u304D\u307E\u3059\uFF5E[VAR 0114(0016)]",
  "\u30B8\u30E0\u30D0\u30C3\u30B8\u3092\u3000\uFF18\u3064\u3000\u304A{\u6301|\u3082}\u3061\u306A\u3089\\n\u3069\u3093\u306A\u30DD\u30B1\u30E2\u30F3\u3067\u3082\u3000{\u6355|\u3064\u304B}\u307E\u3048\u3089\u308C\u307E\u3059\u306D\\r\\n\u304D\u3061\u3093\u3068\u3000\u3044\u3046\u3053\u3068\u3082\u3000\u304D\u3044\u3066\u304F\u308C\u307E\u3059\u3088\uFF5E[VAR 0114(0016)]",
  "\u3059\u3054\u3044{\u98DF|\u305F}\u3079\u3063\u3077\u308A\u3000\u3060\u3063\u305F\u306E\u3067\\n\u30C7\u30B6\u30FC\u30C8\u306B\u3000\u308F\u3056\u30DE\u30B7\u30F3\u3082\u3000\u3069\u3046\u304B\u3057\u3089\uFF5E\uFF1F[VAR 0114(0016)]",
  "{\u5192\u967A|\u307C\u3046\u3051\u3093}\u306E{\u9014\u4E2D|\u3068\u3061\u3085\u3046}\u3067\u3000{\u624B|\u3066}\u306B{\u5165|\u3044}\u308C\u305F\\n\u308F\u3056\u30DE\u30B7\u30F3\u306F\u3000\u308F\u3056\u30DE\u30B7\u30F3\u30DE\u30B7\u30F3\u3067\\r\\n{\u4F5C|\u3064\u304F}\u308C\u308B\u3088\u3046\u306B\u3000\u306A\u308A\u307E\u3059\u304B\u3089\u306D\uFF5E[VAR 0114(0016)]",
