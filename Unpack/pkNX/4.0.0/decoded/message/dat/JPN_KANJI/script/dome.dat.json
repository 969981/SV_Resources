[
  "\u30BF\u30ED{\u5148\u8F29|\u305B\u3093\u3071\u3044}\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u306E\u3053\u3068\\n{\u512A|\u3084\u3055}\u3057\u304F\u3000{\u6559|\u304A\u3057}\u3048\u3066\u304F\u308C\u308B\u3093\u3060\u3088",
  "\u30BF\u30ED\u3061\u3083\u3093\u3063\u3066\u3000{\u6BCE\u65E5|\u307E\u3044\u306B\u3061}\u3000\uFF13{\u56DE|\u304B\u3044}\u3082\\n\u30DD\u30B1\u30E2\u30F3\u30A6\u30A9\u30C3\u30B7\u30E5\u3000\u3057\u3066\u308B\u306E\u3088\\r\\n\u3044\u3064\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3000\u304D\u308C\u3044\u306A\u306E",
  "\u3044\u304F\u3089\u3000\u30C9\u30E9\u30B4\u30F3\u30BF\u30A4\u30D7\u304C\u3000{\u5F37|\u3064\u3088}\u304F\u3066\u3082\\n\u30D5\u30A7\u30A2\u30EA\u30FC\u306E{\u529B|\u3061\u304B\u3089}\u3067\u3000\u3072\u3068\u3072\u306D\u308A\u3088\uFF01",
  "\u30BF\u30A4\u30D7\u3067\u306F\u3000{\u52DD|\u304B}\u3063\u3066\u308B\u306E\u306B\\n\u30BF\u30ED\u3061\u3083\u3093\u306F\u3000\u30AB\u30AD\u30C4\u30D0\u30BF\u304F\u3093\u306B\\r\\n{\u52DD|\u304B}\u3066\u305F\u3053\u3068\u3000\u306A\u3044\u3093\u3060\u3063\u3066",
  "\u30B3\u30FC\u30B9\u30C8\u30A8\u30EA\u30A2\u306E\u3000{\u9B45\u529B|\u307F\u308A\u3087\u304F}\u306F\u3000{\u6D77|\u3046\u307F}\uFF01\\n{\u6D77\u6C34|\u304B\u3044\u3059\u3044}\u306F\u3000{\u672C\u7269|\u307B\u3093\u3082\u306E}\u3092\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u308B\u306E\u3088",
  "\u30C9\u30FC\u30E0\u306E\u3000{\u4F11\u61A9|\u304D\u3085\u3046\u3051\u3044}{\u6240|\u3058\u3087}\u306B\u306F\\n{\u81EA\u52D5|\u3058\u3069\u3046}{\u8CA9\u58F2\u6A5F|\u306F\u3093\u3070\u3044\u304D}\u304C\u3000\u3042\u3063\u3066\u3055\uFF01\\r\\n\u3044\u308D\u3093\u306A\u30DC\u30FC\u30EB\u304C\u3000{\u8CB7|\u304B}\u3048\u308B\u3093\u3060\uFF01",
  "{\u6CF3|\u304A\u3088}\u3044\u3067\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u306F\\n\u30C0\u30A4\u30D6\u30DC\u30FC\u30EB\u3067\u3000{\u6355|\u3064\u304B}\u307E\u3048\u3084\u3059\u3044\u3088",
  "\u30D6\u30ED\u30C3\u30AF\u304C\u3000{\u96C6|\u3042\u3064}\u307E\u3063\u3066\u308B\u3068\u3053\u308D\u306F\\n{\u5C0F|\u3061\u3044}\u3055\u3081\u306E\u304C\u3000{\u4F11\u61A9|\u304D\u3085\u3046\u3051\u3044}{\u6240|\u3058\u3087}\uFF01\\r\\n{\u5927|\u304A\u304A}\u304D\u3081\u306E\u304C\u3000\u30B9\u30AF\u30A8\u30A2\u3063\u3066\u3000\u3044\u3046\u3093\u3060\uFF01",
  "\u30A2\u30AB\u30DE\u30C4\u304F\u3093\u306E{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3000\u3059\u3054\u3044\u3088\uFF01\\n\u30D6\u30FC\u30D0\u30FC\u30F3\u306E{\u706B|\u3072}\u3067\u3000{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3000{\u713C|\u3084}\u304F\u306E\uFF01",
  "\u307B\u306E\u304A\u30BF\u30A4\u30D7\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u306F\\n\u3084\u3051\u3069{\u72B6\u614B|\u3058\u3087\u3046\u305F\u3044}\u306B\u3000\u306A\u3089\u306A\u3044\uFF01\\r\\n{\u77E5|\u3057}\u3063\u3066\u308B\u3068\u3000{\u5DEE|\u3055}\u304C\u3064\u304F\u305C\uFF01",
  "\u30B5\u30D0\u30F3\u30CA\u30A8\u30EA\u30A2\u306F\\n\u30B7\u30DE\u30DE\u304C\u3000\u3044\u308B\u304B\u3089\u3000{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\uFF01\\c\\n\u30A8\u30EA\u30A2\u3092\u3000\u307E\u305F\u3050\u3068\\n{\u4F1A|\u3042}\u3048\u308B\u30DD\u30B1\u30E2\u30F3\u3000{\u5909|\u304B}\u308F\u308B\u3088\uFF01",
  "{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}{\u6226|\u305B\u3093}\u306F\u3000{\u5404|\u304B\u304F}\u30B9\u30AF\u30A8\u30A2\u306E\\n\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u3067\u3000\u304A\u3053\u306A\u308F\u308C\u308B\u308F\uFF01",
  "\u30D6\u30EB\u30D9\u30EA\u30FC\u30B0\u3067\u3000\u30E9\u30F3\u30AF\u304C\u3000{\u9AD8|\u305F\u304B}\u304F\u306A\u3044\u3068\\n{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u306B\u3000{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3055\u3048\u3000\u3067\u304D\u306A\u3044\u306E\u3088",
  "\u30CA\u30C3\u30AF\u30E9\u30FC\u306F\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\u3068\\n\u30C9\u30E9\u30B4\u30F3\u30BF\u30A4\u30D7\u304C\u3000{\u5897|\u3075}\u3048\u308B\u3093\u3060\u3042\\r\\n\u306A\u3093\u3067\u3060\u308D\u3046\u3000{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u3060\u306D\u3048",
  "{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u30DE\u30B7\u30F3\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u308B\u3068\u304D\\n{\u5F8C|\u3046\u3057}\u308D\u306B\u3000{\u4EBA|\u3072\u3068}\u304C\u3044\u308B\u3068\u3000{\u7DCA\u5F35|\u304D\u3093\u3061\u3087\u3046}\u3059\u308B\u2026\u2026\uFF01",
  "\u30CD\u30EA\u30CD\u3055\u307E\u306F\u3000\u30AF\u30FC\u30EB\u3067\u3000{\u7D20\u6575|\u3059\u3066\u304D}\uFF01\\n{\u751F\u5F92|\u305B\u3044\u3068}{\u4F1A\u9577|\u304B\u3044\u3061\u3087\u3046}\u3060\u3057\u3000{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u3060\u3057\uFF01",
  "\u30AD\u30E3\u30CB\u30AA\u30F3\u30A8\u30EA\u30A2\u306F\\n\u30B4\u30C4\u3044\u30DD\u30B1\u30E2\u30F3\u3000{\u591A|\u304A\u304A}\u3081\uFF01\\c\\n{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u3000\u30CD\u30EA\u30CD\u3082\\n\u306F\u304C\u306D\u30DD\u30B1\u30E2\u30F3\u3000\u304F\u308A{\u51FA|\u3060}\u3059\u305C\uFF01",
  "\u30A8\u30A2\u30FC\u30E0\u30C9\u3063\u3066\u3000\u30DD\u30B1\u30E2\u30F3\u306F\\n{\u5F31\u70B9|\u3058\u3083\u304F\u3066\u3093}\u3000{\u5C11|\u3059\u304F}\u306A\u304F\u3066\u3000{\u624B\u5F37|\u3066\u3054\u308F}\u3044\u305E\uFF01\\c\\n\u30C6\u30E9\u30EA\u30A6\u30E0\u30C9\u30FC\u30E0\u3067\u306F\\n\u305D\u3089\u3068\u3076\u30BF\u30AF\u30B7\u30FC\u3067\u3082\u3000{\u5927\u6D3B\u8E8D|\u3060\u3044\u304B\u3064\u3084\u304F}\u3060\uFF01",
  "\u3042\u308B{\u5730\u65B9|\u3061\u307B\u3046}\u306B\u3000\u30A2\u30FC\u30DE\u30FC\u30AC\u30A2\u306E\\n{\u5929\u6575|\u3066\u3093\u3066\u304D}\u304C\u3000\u3044\u308B\u3089\u3057\u3044\\c\\n\u304D\u3063\u3068\u3000{\u6050|\u304A\u305D}\u308D\u3057\u3044{\u59FF|\u3059\u304C\u305F}\u306E\\n\u30DD\u30B1\u30E2\u30F3\u3000\u306A\u3093\u3060\u308D\u3046\u306A\uFF01",
  "\u30A2\u30FC\u30DE\u30FC\u30AC\u30A2{\u597D|\u305A}\u304D\u304C\u3000\u304D\u3063\u304B\u3051\u3067\\n{\u5F7C|\u304B\u308C}\u3068\u3000\u306A\u304B\u3088\u304F\u306A\u3063\u305F\u306E\uFF01",
  "\u3055\u3059\u304C\u306B\u3000\u30B1\u30E9\u30E9\u30C3\u30D1\u3067\\n\u305D\u3089\u3068\u3076\u30BF\u30A4\u30E0\u30A2\u30BF\u30C3\u30AF\u306F\u3000{\u7121\u8B00|\u3080\u307C\u3046}\u3088\u306D",
  "\u3053\u3053\u306F\u3000{\u96FB\u6C17|\u3067\u3093\u304D}{\u77F3|\u3044\u3057}\u306E{\u5CA9\u7A9F|\u304C\u3093\u304F\u3064}\uFF01\\n{\u96FB\u6C17|\u3067\u3093\u304D}\u3092\u3000{\u5E2F|\u304A}\u3073\u308B\u3068\u3000\u30D3\u30EA\u30D3\u30EA\u30D3\u30EA\uFF01",
  "\u30AB\u30AD\u30C4\u30D0\u30BF\u3055\u3093\u3063\u3066\\n\uFF12{\u5E74\u751F|\u306D\u3093\u305B\u3044}\u3060\u3051\u3069\u2026\u2026\u3000\u3042\u308C\uFF1F\\c\\n{\u53BB\u5E74|\u304D\u3087\u306D\u3093}\u3082\u3000\u304A\u3068\u3068\u3057\u3082\\n\uFF12{\u5E74\u751F|\u306D\u3093\u305B\u3044}\u3060\u3063\u305F\u3000\u3088\u3046\u306A\u2026\u2026",
  "\u30DD\u30FC\u30E9\u30A8\u30EA\u30A2\u306F\u3000{\u5BD2|\u3055\u3080}\u3044\u306E\u304C\\n{\u5F97\u610F|\u3068\u304F\u3044}\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u68F2|\u3059}\u3093\u3067\u308B\u3088\\r\\n\u3053\u304A\u308A\u30BF\u30A4\u30D7\u304C\u3000{\u6C17\u6301|\u304D\u3082}\u3061\u3000{\u591A|\u304A\u304A}\u3044\u304B\u306A\uFF01",
  "\u3053\u306E{\u5148|\u3055\u304D}\u306F\u3000\u30AD\u30E3\u30CB\u30AA\u30F3\u30A8\u30EA\u30A2\uFF01\\n{\u5CA9\u808C|\u3044\u308F\u306F\u3060}\u304C\u3000\u30B4\u30C4\u30B4\u30C4\u3057\u3066\u308B\u304B\u3089\\r\\n\u30DD\u30B1\u30E2\u30F3\u306B\u3000\u30E9\u30A4\u30C9\u3057\u305F\u3089\u3000\u3044\u3044\u3088",
  "\u30D6\u30EB\u30EC\u30AF\u306F\u3000\u307F\u3093\u306A\u3067\u3000\u3084\u308C\u3070\\n{\u5831\u916C|\u307B\u3046\u3057\u3085\u3046}\u304C\u3000{\u5897|\u3075}\u3048\u308B\u3093\u3060\u3063\u3066\uFF01\\r\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3084\u308B\u3000{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u3000\u3044\u306A\u3044\u3051\u3069\u2026\u2026",
  "\u3053\u3053\u306F\u3000\u30BB\u30F3\u30BF\u30FC\u30B9\u30AF\u30A8\u30A2\uFF01\\n\uFF14\u3064\u306E\u30A8\u30EA\u30A2\u304C\u3000{\u4EA4|\u307E\u3058}\u308F\u308B\u3068\u3053\u308D\uFF01",
  "{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u3000\u30EA\u30FC\u30B0{\u90E8|\u3076}\\n\u3061\u3087\u3063\u3068\u3000{\u96F0\u56F2\u6C17|\u3075\u3093\u3044\u304D}\u3000{\u60AA|\u308F\u308B}\u3044\u3088\u306D\u2026\u2026",
  "\u30AB\u30AD\u30C4\u30D0\u30BF\u3055\u3093\u304B\u3089\u3000\u30B9\u30B0\u30EA\u3055\u3093\u306B\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u304C\u3000{\u4EE3|\u304B}\u308F\u3063\u3066\u304B\u3089\u2026\u2026\\r\\n{\u90E8\u6D3B|\u3076\u304B\u3064}\u304C\u3000{\u697D|\u305F\u306E}\u3057\u304F\u306A\u304F\u306A\u3063\u3061\u3083\u3063\u305F",
  "{\u60AA|\u308F\u308B}\u3044\u3051\u3069\u3000\u30B9\u30B0\u30EA\u306B\u306F\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u3000\u3084\u3081\u3066\u307B\u3057\u304B\u3063\u305F\\r\\n\u3060\u304B\u3089\u3000\u3046\u308C\u3057\u3044\u3088",
  "{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306F\\n{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306E{\u4EBA|\u3072\u3068}\u3058\u3083\u3000\u306A\u3044\u3093\u3060\u3063\u3066\uFF01",
  "{\u697D|\u305F\u306E}\u3057\u304F\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3067\u304D\u308B\\n\u30EA\u30FC\u30B0{\u90E8|\u3076}\u304C\u3000{\u623B|\u3082\u3069}\u3063\u3066\u304D\u305F\u3088\u306A\uFF01",
  "{\u4ECA|\u3044\u307E}\u306E{\u90E8\u6D3B|\u3076\u304B\u3064}\u306A\u3089\\n\u308F\u305F\u3057\u3000\u304C\u3093\u3070\u308C\u308B\uFF01\\r\\n{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u3068\u304B\u3000{\u76EE\u6307|\u3081\u3056}\u3057\u3061\u3083\u3046\uFF01",
  "\u30C9\u30FC\u30E0\u306B\u3042\u308B\u3000\u30D6\u30ED\u30C3\u30AF\u306F\\n{\u8D64\u5916\u7DDA|\u305B\u304D\u304C\u3044\u305B\u3093}\u3000{\u7D2B\u5916\u7DDA|\u3057\u304C\u3044\u305B\u3093}\u3092\u3000{\u51FA|\u3060}\u3057\u3066\u3044\u308B\uFF01\\c\\n\u2026\u2026\u30DD\u30B1\u30E2\u30F3\u3084\u3000{\u690D\u7269|\u3057\u3087\u304F\u3076\u3064}\u306E\\n{\u6210\u9577|\u305B\u3044\u3061\u3087\u3046}\u3092\u3000\u3046\u306A\u304C\u3057\u3066\u308B\u3089\u3057\u3044\uFF01",
  "\u3042\u3063\u3061\u306F\u3000\u30DD\u30FC\u30E9\u30A8\u30EA\u30A2\uFF01\\c\\n{\u6C37\u5C71|\u3072\u3087\u3046\u3056\u3093}\u3092\u3000{\u4EBA\u5DE5\u7684|\u3058\u3093\u3053\u3046\u3066\u304D}\u306B\\n{\u518D\u73FE|\u3055\u3044\u3052\u3093}\u3057\u3066\u308B\u304B\u3089\u3000\u3055\u3093\u3080\u3044\u305E\u30FC\uFF1F",
  "\u30EC\u30A4\u30C9\u30D0\u30C8\u30EB{\u7CFB|\u3051\u3044}\u306E\u3000\u30DF\u30C3\u30B7\u30E7\u30F3\u306F\\n\u307F\u3093\u306A\u3067\u3000\u3084\u308C\u3070\u3000{\u697D|\u3089\u304F}\u3061\u3093\u3060\u306A\uFF01",
  "\u304A{\u5144|\u306B\u3044}\u3061\u3083\u3093\u3068\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\\n\u30D6\u30EB\u30EC\u30AF\u3000\u3059\u308B\u3093\u3060\u30FC\uFF01",
  "\uFF11{\u5E74\u751F|\u306D\u3093\u305B\u3044}\u306E\u3000\u30B9\u30B0\u30EA\u3063\u3066{\u5B50|\u3053}\\n{\u6025|\u304D\u3085\u3046}\u306B\u3000{\u96F0\u56F2\u6C17|\u3075\u3093\u3044\u304D}\u3000{\u5909|\u304B}\u308F\u3063\u305F\u306E\u3088",
  "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3{\u6226|\u305B\u3093}\u3000\u3059\u3054\u304B\u3063\u305F\\n\u30B9\u30B0\u30EA\u304F\u3093\u3000\u3088\u3063\u307D\u3069\u3000\u304F\u3084\u3057\u304B\u3063\u305F\u306E\u306D",
  "\u30B9\u30B0\u30EA\u304F\u3093\u3000{\u4F11\u5B66|\u304D\u3085\u3046\u304C\u304F}\u3057\u305F\u3093\u3060\u3063\u3066\\n\u306F\u3084\u304F\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u306A\u308B\u3068\u3000\u3044\u3044\u3088\u306D",
  "{\u512A\u79C0|\u3086\u3046\u3057\u3085\u3046}\u306A{\u751F\u5F92|\u305B\u3044\u3068}\u306B\u3000\u3060\u3051\uFF01\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u30AA\u30FC\u30D6\u304C\u3000{\u914D|\u304F\u3070}\u3089\u308C\u305F\u306E\\r\\n\u2026\u2026{\u6750\u6599|\u3056\u3044\u308A\u3087\u3046}\u304C\u3000{\u8CB4\u91CD|\u304D\u3061\u3087\u3046}\u306A\u3093\u3060\u3063\u3066\uFF01",
  "\u30C6\u30E9\u30B9\u30BF\u30EB\u3063\u3066\u3000{\u5965\u6DF1|\u304A\u304F\u3076\u304B}\u3044\uFF01\\n{\u5F31\u70B9|\u3058\u3083\u304F\u3066\u3093}\u304C\u3000{\u5897|\u3075}\u3048\u3061\u3083\u3046\u3068\u304D\u3082\u3000\u3042\u308B\u3057\uFF01",
  "{\u5411|\u3080}\u3053\u3046\u306F\u3000\u30B3\u30FC\u30B9\u30C8\u30A8\u30EA\u30A2\uFF01\\n\u304A{\u82B1|\u306F\u306A}\u3068{\u6D77|\u3046\u307F}\u3067\u3000\u30A2\u30ED\u30FC\u30E9\u306A{\u6C17\u5206|\u304D\u3076\u3093}\uFF01\uFF1F",
  "\u3042\u308C\uFF1F\u3000\u3082\u3057\u304B\u3057\u3066\u2026\u2026\\n\u30A8\u30EA\u30A2\u306B\u3088\u3063\u3066\u3000\u30D6\u30ED\u30C3\u30AF\u306E{\u8272|\u3044\u308D}\u3000{\u9055|\u3061\u304C}\u3046\uFF1F",
  "{\u79C1|\u308F\u305F\u3057}\u306E{\u5F8C|\u3046\u3057}\u308D\u306B\\n\u308F\u3056\u30DE\u30B7\u30F3\u3000{\u843D|\u304A}\u3061\u3066\u305F\u3088\\r\\n\u3082\u3046\u3000{\u62FE|\u3072\u308D}\u3063\u305F\uFF1F",
  "\u30EA\u30FC\u30B0{\u90E8|\u3076}\u306E\u3000{\u5B50|\u3053}\u305F\u3061\\n{\u95A2\u4FC2|\u304B\u3093\u3051\u3044}\u304C\u3000\u30AE\u30AF\u30B7\u30E3\u30AF\u3057\u3066\u308B\uFF1F\\r\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\u3057\u3066\u3000{\u653E|\u307B\u3046}\u3063\u3066\u304A\u3051\u306A\u3044\u308F",
  "\u30EA\u30FC\u30B0{\u90E8|\u3076}\u306E\u3000{\u5B50|\u3053}\u305F\u3061\\n\u306A\u3093\u3060\u304B\u3000{\u843D|\u304A}\u3061{\u7740|\u3064}\u3044\u305F\u307F\u305F\u3044\\r\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\u3057\u3066\u3000{\u4F55|\u306A\u306B}\u3082\u3067\u304D\u306A\u304B\u3063\u305F\u308F",
  "\u30EA\u30FC\u30B0{\u90E8|\u3076}\u306E\u3000{\u5B50|\u3053}\u305F\u3061\\n{\u524D|\u307E\u3048}\u307F\u305F\u3044\u306B\u3000{\u7B11\u9854|\u3048\u304C\u304A}\u304C\u3000{\u623B|\u3082\u3069}\u3063\u3066\u304D\u305F\u306E\\r\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\u3057\u3066\u3000{\u898B\u5B88|\u307F\u307E\u3082}\u3063\u3066\u3044\u304D\u305F\u3044\u308F",
  "\u305D\u3089\u3068\u3076\u30BF\u30A4\u30E0\u30A2\u30BF\u30C3\u30AF\\n{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3057\u305F\u3053\u3068\u3000\u3042\u308B\uFF1F\\c\\n\u30EC\u30A2\u30B3\u30A4\u30EB\u305F\u3061\u304C\u3000\u30B3\u30FC\u30B9\u306E\\n\u304A{\u624B\u4F1D|\u3066\u3064\u3060}\u3044\u3000\u3057\u3066\u308B\u3093\u3060\u3088"
]
