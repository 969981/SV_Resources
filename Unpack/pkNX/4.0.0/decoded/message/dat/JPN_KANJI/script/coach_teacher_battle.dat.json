  "\u30BF\u30A6\u30EA\u30F3\u3092\u3000{\u4E00\u6C17|\u3044\u3063\u304D}{\u98F2|\u306E}\u307F\u3057\u305F\u3089\\n{\u5915\u65E5|\u3086\u3046\u3072}\u306B\u3000{\u5411|\u3080}\u304B\u3063\u3066\u3000{\u62BC\u5FCD|\u304A\u3059}\u3060\u306A\uFF01[VAR 0114(0024)]",
  "[~ 62]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000\u3044\u3044{\u8A66\u5408|\u3057\u3042\u3044}\u3060\u3063\u305F\uFF01\\n{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\uFF01\u3000\u3042\u308A\u304C\u3068\u3046\uFF01[VAR 0114(0024)]",
  "{\u4ECA\u5EA6|\u3053\u3093\u3069}\u306F\u3000\u3053\u3046\u306F\u3000\u3044\u304B\u306A\u3044\u305E\uFF01\\n{\u5915\u65E5|\u3086\u3046\u3072}\u306B\u3000{\u5411|\u3080}\u304B\u3063\u3066\u3000{\u62BC\u5FCD|\u304A\u3059}\u3060\uFF01[VAR 0114(0024)]",
  "{\u4ECA\u56DE|\u3053\u3093\u304B\u3044}\u306F\u3000{\u52DD|\u304B}\u305F\u305B\u3066\u3082\u3089\u3063\u305F\u306A\uFF01\\n\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}{\u6559\u5E2B|\u304D\u3087\u3046\u3057}\u306E\u3000{\u9762\u76EE|\u3081\u3093\u3082\u304F}\u3092\u3000{\u4FDD|\u305F\u3082}\u3066\u305F\u3088\uFF01\\c\\n{\u8CA0|\u307E}\u3051\u305F\u3000\u304F\u3084\u3057\u3055\u306F\\n{\u6D77|\u3046\u307F}\u3092\u3000\u306A\u304C\u3081\u3066\u3000{\u98F2|\u306E}\u307F\u3053\u3080\u3093\u3060\uFF01[VAR 0114(0024)]",
  "\u30EA\u30FC\u30B0{\u90E8|\u3076}\u306E\u3000{\u90E8\u5BA4|\u3076\u3057\u3064}\u306F\\n{\u82E5\u8005|\u308F\u304B\u3082\u306E}\u304C\u3000\u3072\u3057\u3081\u304D\u3042\u3063\u3066\u3066\\r\\n{\u9752\u6625|\u305B\u3044\u3057\u3085\u3093}\u304C\u3000{\u5927\u6E0B\u6EDE|\u3060\u3044\u3058\u3085\u3046\u305F\u3044}\u3060\u306A\uFF01[VAR 0114(0024)]",
  "\u3058\u3064\u3092\u3000\u3044\u3046\u3068\\n\u308F\u305F\u3057\u306F\u3000{\u98DB\u884C\u6A5F|\u3072\u3053\u3046\u304D}\u304C\u3000{\u82E6\u624B|\u306B\u304C\u3066}\u3067\u306A\u2026\u2026\\c\\n\u30D6\u30EB\u30FC\u30D9\u30EA\u30FC{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u307E\u3067\u3000{\u6765|\u304F}\u308B\u306E\u306B\\n\u3059\u3054\u304F\u3000{\u6C17\u5408|\u304D\u3042}\u3044\u304C\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306A\u3093\u3060\u3088[VAR 0114(0024)]",
  "{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u306E{\u6700\u4E2D|\u3055\u3044\u3061\u3085\u3046}\u3067\u3082\\n{\u4F53|\u304B\u3089\u3060}\u3092\u3000{\u935B|\u304D\u305F}\u3048\u3089\u308C\u308B\u305E\uFF01\\c\\n{\u6B21|\u3064\u304E}\u306B\u3000{\u6226|\u305F\u305F\u304B}\u3046\u3068\u304D\u3000\u308F\u305F\u3057\u3092\u3000{\u898B|\u307F}\u3066\u304F\u308C\uFF01\\n\u3042\u306E{\u52D5|\u3046\u3054}\u304D\u3067\u3000{\u5FC3\u80BA|\u3057\u3093\u3071\u3044}{\u6A5F\u80FD|\u304D\u306E\u3046}\u3092\u3000{\u9AD8|\u305F\u304B}\u3081\u3066\u3044\u308B\u3093\u3060\uFF01[VAR 0114(0024)]",
  "{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\u306E\u3000[VAR 0101(0001)]\u306F\\n{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u3044\u3063\u3071\u3044\u3060\uFF01\\c\\n\u308F\u305F\u3057\u304C\u3000{\u4F5C|\u3064\u304F}\u3063\u305F\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3082\\n\u304A\u3044\u3057\u304F\u3000{\u98DF|\u305F}\u3079\u3066\u304F\u308C\u308B\u305E\uFF01[VAR 0114(0024)]",
  "{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\u3000\u30A2\u30B5\u30CA\u30F3\u306F\u3000\u3069\u3046\u3060\uFF01\uFF1F\\n\u3042\u306E{\u5B50|\u3053}\u306F\u3000\u30D1\u30F3\u30C1\u306E{\u4F7F|\u3064\u304B}\u3044{\u624B|\u3066}\uFF01\\c\\n\u3069\u3093\u306A{\u5F37\u6575|\u304D\u3087\u3046\u3066\u304D}\u304C\u3000{\u76F8\u624B|\u3042\u3044\u3066}\u3082\\n\u3044\u308D\u3093\u306A{\u62F3|\u3053\u3076\u3057}\u3067\u3000{\u7C89\u7815|\u3075\u3093\u3055\u3044}\u3059\u308B\u305E\uFF01[VAR 0114(0024)]"
]
