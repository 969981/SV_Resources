  "\u3068\u308A\u3042\u3048\u305A\u3000\u30D6\u30EB\u30EC\u30AF\uFF01\\n\u30D6\u30EB\u30EC\u30AF\u3057\u3066\u3000\uFF22\uFF30\u3000{\u96C6|\u3042\u3064}\u3081\u3066\u307F\u3066\u304F\u3060\u3055\u3044\uFF01[VAR 0114(0049)]",
  "\u2026\u2026{\u4EE5\u4E0A|\u3044\u3058\u3087\u3046}\u3067\u3059\uFF01\\n{\u6025|\u3044\u305D}\u304E{\u8DB3|\u3042\u3057}\u3067\u3000\u3059\u307F\u307E\u305B\u3093[VAR 0114(0049)]",
  "\u305D\u308C\u3067\u306F\u3000\u308F\u305F\u3057\u306F\u3000\u3053\u308C\u3067\uFF01\\n{\u5B66\u5712|\u304C\u304F\u3048\u3093}{\u751F\u6D3B|\u305B\u3044\u304B\u3064}\u3000{\u697D|\u305F\u306E}\u3057\u3093\u3067\u304F\u3060\u3055\u3044\u306D\uFF01[VAR 0114(0049)]",
  "\u3053\u3053\u304B\u3089{\u5148|\u3055\u304D}\\n\u304A{\u8A71|\u306F\u306A\u3057}\u3092\u3000{\u9032|\u3059\u3059}\u3081\u308B\u305F\u3081\u306B\u306F\\c\\n{\u672C\u7DE8|\u307B\u3093\u307A\u3093}\u3000\u30E1\u30A4\u30F3\u30B7\u30CA\u30EA\u30AA\u3068\\n\u30BC\u30ED\u306E{\u79D8\u5B9D|\u3072\u307B\u3046}\u3000{\u524D\u7DE8|\u305C\u3093\u307A\u3093}\u3000\u300E{\u78A7|\u307F\u3069\u308A}\u306E{\u4EEE\u9762|\u304B\u3081\u3093}\u300F\u3092\\r\\n\u30AF\u30EA\u30A2\u3057\u3066\u3044\u308B\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308A\u307E\u3059\\c\\n[VAR FF00(0006)]\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}[VAR FF00(0000)]\u3084\u3000[VAR FF00(0006)]\u30AD\u30BF\u30AB\u30DF\u306E{\u91CC|\u3055\u3068}[VAR FF00(0000)]\u3067\\n\u3084\u308A{\u6B8B|\u306E\u3053}\u3057\u305F\u3053\u3068\u3092\u3000{\u7D42|\u304A}\u308F\u3089\u305B\u307E\u3057\u3087\u3046\uFF01"
