[
  "\u30A2\u30AB\u30C7\u30DF\u30FC{\u540D\u7269|\u3081\u3044\u3076\u3064}\u3000{\u5730\u7344|\u3058\u3054\u304F}\u306E{\u968E\u6BB5|\u304B\u3044\u3060\u3093}\uFF01\\n{\u4E0A|\u3042}\u304C\u3063\u3066\u304F\u308B\u306E\u3000{\u5927\u5909|\u305F\u3044\u3078\u3093}\u3060\u3063\u305F\u3067\u3057\u3087\uFF01",
  "\u30C6\u30FC\u30D6\u30EB\u30B7\u30C6\u30A3\u306F\\n{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3068\u3000{\u6587\u5316|\u3076\u3093\u304B}\u306E\u3000{\u753A|\u307E\u3061}\uFF01\\r\\n\u30C6\u30FC\u30D6\u30EB\u307F\u305F\u3044\u306B\u3000{\u5E83|\u3072\u308D}\u3044\u306A\u3042",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306B\u306F\u3000\u3044\u308D\u3093\u306A{\u4EBA|\u3072\u3068}\u3084\\n\u3044\u308D\u3093\u306A\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3044\u308B\u3088\uFF01\\r\\n\u304D\u307F\u3082\u3000\u3044\u308D\u3093\u306A{\u4EBA|\u3072\u3068}\u306E\u3000\u3072\u3068\u308A\u3060\u306D\uFF01",
  "\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306E\u3000{\u4EBA|\u3072\u3068}\u305F\u3061\u3063\u3066\\n\u3061\u3087\u3063\u3068\u3000\u3053\u308F\u3044\u3088\u306D\u30FC",
  "\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306F\u3000{\u5909|\u3078\u3093}\u306A{\u8ECA|\u304F\u308B\u307E}\u306B\u3000{\u4E57|\u306E}\u3063\u3066\\n{\u591C|\u3088}\u306A{\u591C|\u3088}\u306A\u3000{\u66B4\u8D70|\u307C\u3046\u305D\u3046}\u3057\u3066\u308B\u3093\u3060\u3063\u3066",
  "\u30A2\u30AB\u30C7\u30DF\u30FC\u3067\u306F\u3000{\u597D|\u3059}\u304D\u306A{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3092\\n{\u9078|\u3048\u3089}\u3093\u3067\u3000{\u53D7|\u3046}\u3051\u3089\u308C\u308B\u3093\u3060\u308D\uFF1F\\r\\n{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u306E{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306F\u3000{\u9055|\u3061\u304C}\u3046\u306D\u30FC",
  "\u3082\u3057\u3082\u3057\uFF1F\u3000{\u672C\u6821|\u307B\u3093\u3053\u3046}\u306E{\u751F\u5F92|\u305B\u3044\u3068}\u306F\\n\u307F\u30FC\u3093\u306A\u3000\u3044\u3044{\u5B50|\u3053}\u3067\u3000{\u52A9|\u305F\u3059}\u304B\u3063\u3066\u307E\u3059\u306E\u3088",
  "\u3055\u3059\u304C\u3000\u30D1\u30EB\u30C7\u30A2{\u6700\u5927|\u3055\u3044\u3060\u3044}\u306E\u3000{\u90FD\u5E02|\u3068\u3057}\uFF01\\n{\u5B8C\u5168|\u304B\u3093\u305C\u3093}\u306B\u3000{\u8FF7|\u307E\u3088}\u3063\u3061\u3083\u3063\u305F\u3088\uFF01",
  "\u30DE\u30C3\u30D7\u3067\u3000{\u7DD1|\u307F\u3069\u308A}\u306E\u307B\u3046\u304C\u3000{\u5317|\u304D\u305F}\u3060\u3088\\c\\n\uFF32\u30B9\u30C6\u30A3\u30C3\u30AF\u3092\u3000{\u62BC|\u304A}\u3057{\u8FBC|\u3053}\u3093\u3067\\n{\u5317|\u304D\u305F}\u3092{\u4E0A|\u3046\u3048}\u306B\u3000{\u56FA\u5B9A|\u3053\u3066\u3044}\u3057\u3066\u307F\u305F\u3089\uFF1F",
  "\u30C8\u30F3\u30CD\u30EB\u306E{\u5148|\u3055\u304D}\u306B\u306F\\n\u30DD\u30B1\u30E2\u30F3\u30EA\u30FC\u30B0\u304C\u3000\u3042\u308B\u306E\u3088\u306D\\c\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u306B\u3000\u306A\u308C\u308B\\n\u30C6\u30B9\u30C8\u3092\u3000{\u53D7|\u3046}\u3051\u3089\u308C\u308B\u3093\u3067\u3057\u3087\uFF1F",
  "\u30DD\u30B1\u30E2\u30F3\u30EA\u30FC\u30B0\u3067\\n{\u9762\u63A5|\u3081\u3093\u305B\u3064}\u30C6\u30B9\u30C8\u3000{\u53D7|\u3046}\u3051\u3066\u304D\u305F\uFF01\\r\\n{\u9762\u63A5\u5B98|\u3081\u3093\u305B\u3064\u304B\u3093}\u306E{\u4EBA|\u3072\u3068}\u2026\u2026\u3000\u3053\u308F\u304B\u3063\u305F\u30FC",
  "{\u753A|\u307E\u3061}\u306E{\u5916|\u305D\u3068}\u306B\u306F\u3000{\u898B|\u307F}\u305F\u3053\u3068\u306A\u3044\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u305F\u304F\u3055\u3093\u3000\u3044\u308B\u306E\u3088\u306D\u30FC",
  "\u30B9\u30FC\u30D1\u30FC\u30E2\u30C7\u30EB\u306E\u3000\u30EA\u30C3\u30D7\u3055\u3093\uFF01\\n{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306E\u3000{\u8AB0|\u3060\u308C}\u304B\u3068\\r\\n{\u5E7C|\u304A\u3055\u306A}\u306A\u3058\u307F\u3000\u306A\u3093\u3067\u3059\u3063\u3066\uFF01",
  "\u3053\u306E{\u5148|\u3055\u304D}\u306F\u3000{\u5CA9\u5C71|\u3044\u308F\u3084\u307E}\u304C\u3000{\u5165|\u3044}\u308A{\u7D44|\u304F}\u3093\u3067\u3044\u308B\uFF01\\n{\u8FF7|\u307E\u3088}\u3044\u3084\u3059\u3044\u304B\u3089\u3000{\u6CE8\u610F|\u3061\u3085\u3046\u3044}\u3057\u3066\u306D\\c\\n{\u5CA9\u5C71|\u3044\u308F\u3084\u307E}\u3092\u3000{\u629C|\u306C}\u3051\u308C\u3070\\n{\u82B8\u8853|\u3052\u3044\u3058\u3085\u3064}\u306E{\u753A|\u307E\u3061}\u3000\u30DC\u30A6\u30EB\u30BF\u30A6\u30F3\u3060\u3088",
  "{\u6709\u540D|\u3086\u3046\u3081\u3044}\u306A{\u535A\u58EB|\u306F\u304B\u305B}\u304C\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n\u30C6\u30E9\u30B9\u30BF\u30EB{\u73FE\u8C61|\u3052\u3093\u3057\u3087\u3046}\u3092\u3000{\u89E3\u660E|\u304B\u3044\u3081\u3044}\u3057\u305F\u306E\u3088\u306D",
  "{\u4F8B|\u308C\u3044}\u306E{\u535A\u58EB|\u306F\u304B\u305B}\u2026\u2026\u3000\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u3067\\n\u3059\u3054\u3044{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u3092\u3000\u3057\u3066\u308B\u3093\u3060\u3068\u3055",
  "\u3044\u30FC\u3063\u3071\u3044\u3000{\u5BDD|\u306D}\u305F\u3089\\n{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3000{\u884C|\u3044}\u3051\u308B{\u65E5|\u3072}\u306B\u3000\u306A\u308B\u304B\u3089\u306D",
  "\u307C\u304F\u3082\u3000\u306F\u3084\u304F\\n\u3042\u304B\u3067\u307F\u30FC\u3000\u3057\u305F\u30FC\u3044\uFF01",
  "{\u6642\u9593|\u3058\u304B\u3093}\u306F\u3000{\u904E|\u3059}\u304E\u308B\u2026\u2026\\n{\u5929\u6C17|\u3066\u3093\u304D}\u306F\u3000\u3046\u3064\u308D\u3046\u2026\u2026\\c\\n{\u6642\u9593|\u3058\u304B\u3093}\u3084\u3000{\u5929\u6C17|\u3066\u3093\u304D}\u306B\u3088\u3063\u3066\u3000{\u91CE\u751F|\u3084\u305B\u3044}\u306E\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u884C\u52D5|\u3053\u3046\u3069\u3046}\u304C\u3000{\u5909|\u304B}\u308F\u308B\u305D\u3046\u3058\u3083",
  "{\u6C60|\u3044\u3051}\u3000\u3067\u3063\u3051\u30FC\uFF01\\c\\n\u30B3\u30A4\u30AD\u30F3\u30B0\u307F\u305F\u3044\u306B\\n\u3077\u304B\u3077\u304B\u3000{\u6D6E|\u3046}\u304D\u305F\u3044\u306A",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3063\u3066\u3000{\u5909|\u3078\u3093}\u306A\\n\u3042\u3060{\u540D|\u306A}\u3000\u3064\u3051\u3089\u308C\u308B\u308F\u3088\u306D\\c\\n\u30CF\u30C3\u3055\u3093\u304C\uFF5E\u3068\u304B\u3000\u30BB\u30A4\u30B8\u30CB\u30AD\u304C\uFF5E\u3068\u304B\\n{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u304C\u3000{\u8A71|\u306F\u306A}\u3057\u3066\u308B\u306E\u3000{\u805E|\u304D}\u3044\u3061\u3083\u3063\u305F",
  "\u30DD\u30B1\u30E2\u30F3\u306B\u3088\u3063\u3066\\n{\u899A|\u304A\u307C}\u3048\u3089\u308C\u306A\u3044{\u6280|\u308F\u3056}\u3082\u3000\u3042\u308B\u306E\u3088\u306D",
  "\u30C6\u30E9\u30B9\u30BF\u30EB\u30AA\u30FC\u30D6\u3000{\u6B32|\u307B}\u3057\u3044\u3051\u3069\\n\u3061\u3087\u3063\u3068\u3000{\u6210\u7E3E|\u305B\u3044\u305B\u304D}\u304C\u3000{\u8DB3|\u305F}\u308A\u306A\u304B\u3063\u305F\u2026\u2026",
  "{\u512A\u79C0|\u3086\u3046\u3057\u3085\u3046}\u306A{\u751F\u5F92|\u305B\u3044\u3068}\u3000\u3058\u3083\u306A\u3044\u3068\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u30AA\u30FC\u30D6\u3000\u3082\u3089\u3048\u306A\u3044\u306E\\r\\n\u30D1\u30EF\u30FC\u304C\u3000{\u5F37|\u3064\u3088}\u3059\u304E\u308B\u306E\u306D",
  "\u3053\u3053\u306F\u3000\u30C6\u30FC\u30D6\u30EB\u30B7\u30C6\u30A3\\n\u30D1\u30EB\u30C7\u30A2\u3067\u3000{\u4E00\u756A|\u3044\u3061\u3070\u3093}\u3000{\u5927|\u304A\u304A}\u304D\u306A{\u753A|\u307E\u3061}\u3055\uFF01",
  "\u30B5\u30EF\u3061\u3083\u3093\u306E\u3000{\u5BB6\u5EAD\u79D1|\u304B\u3066\u3044\u304B}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\\n\u3068\u3063\u3066\u3082\u3000\u305F\u3081\u306B\u306A\u308B\u306E\u3088\uFF5E\uFF01",
  "\u30EC\u30DB\u3055\u307E\u306E\u3000{\u6B74\u53F2|\u308C\u304D\u3057}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\\n\u3068\u3063\u3066\u3082\u3000{\u697D|\u305F\u306E}\u3057\u3044\u308F\u3088\uFF5E\uFF01",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u3069\u3053\u306E\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1{\u5C4B|\u3084}\u3055\u3093\u3067\u3000{\u98DF|\u305F}\u3079\u3088\u3046\u304B\u306A\uFF1F",
  "{\u540C|\u304A\u306A}\u3058{\u5E97|\u307F\u305B}\u3067\u3082\u3000{\u5834\u6240|\u3070\u3057\u3087}\u306B\u3088\u3063\u3066\\n{\u54C1|\u3057\u306A}\u305E\u308D\u3048\u304C\u3000{\u5FAE\u5999|\u3073\u307F\u3087\u3046}\u306B\u3000{\u9055|\u3061\u304C}\u3046\u3082\u3093\u306D",
  "{\u753A|\u307E\u3061}\u306B\u3044\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u306F\u3000\u3060\u3044\u305F\u3044\\n{\u8AB0|\u3060\u308C}\u304B\u306E\u30D1\u30FC\u30C8\u30CA\u30FC\u3000\u306A\u3093\u3060\\r\\n{\u6355|\u3064\u304B}\u307E\u3048\u3088\u3046\u3068\u3057\u3061\u3083\u3000\u30C0\u30E1\u3060\u3088",
  "\u308F\u305F\u3057\u306E\u30DD\u30B1\u30E2\u30F3\\n\u3082\u306E\u304A\u3068\u306B\u3073\u3093\u304B\u3093\u3000\u306A\u306E\uFF01",
  "{\u540C|\u304A\u306A}\u3058\u30DD\u30B1\u30E2\u30F3\u3067\u3082\u3000{\u6027\u683C|\u305B\u3044\u304B\u304F}\u3084\\n{\u7279\u6027|\u3068\u304F\u305B\u3044}\u3084\u3000{\u5F37|\u3064\u3088}\u3055\u304C\u3000{\u9055|\u3061\u304C}\u3046\u3093\u3060\u3088\u306A",
  "\u30D1\u30EB\u30C7\u30A2\u306E{\u96E8|\u3042\u3081}\u306F\u3000{\u51B7|\u3064\u3081}\u305F\u304F\u306A\u3044\u3057\\n\u3059\u3050{\u6B62|\u3084}\u3080\u304B\u3089\u3000\u30AB\u30B5\u306A\u3093\u3066\u3000\u3055\u3055\u306A\u3044\u306E",
  "\u3046\u3061\u306E{\u606F\u5B50|\u3080\u3059\u3053}\u304C\\n\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u306B\u3000{\u5165|\u306F\u3044}\u3063\u305F\u3089\u3057\u3044\u306E\u3088\uFF5E\\r\\n{\u697D|\u305F\u306E}\u3057\u3044{\u90E8\u6D3B|\u3076\u304B\u3064}\u3000\u306A\u3093\u3067\u3057\u3087\u3046\u306D\u3047\uFF5E",
  "{\u4E2D\u592E\u5E83\u5834|\u3061\u3085\u3046\u304A\u3046\u3072\u308D\u3070}\u306E\u3000\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\uFF01\\c\\n\u307F\u3093\u306A\u306B\u3000{\u6CE8\u76EE|\u3061\u3085\u3046\u3082\u304F}\u3055\u308C\u308B\u304B\u3089\\n{\u81EA\u4FE1|\u3058\u3057\u3093}\u304C\u306A\u3044\u3068\u3000{\u4F7F|\u3064\u304B}\u3048\u306A\u3044\u3088\u306D",
  "\u3088\u305D\u306E{\u5730\u65B9|\u3061\u307B\u3046}\u306F\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\\n\uFF11{\u4EBA|\u308A}\u3057\u304B\u3000\u3044\u306A\u3044\u3093\u3060\u3063\u3066\uFF01\\c\\n\u30D1\u30EB\u30C7\u30A2\u306F\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u304C\\n{\u4F55\u4EBA|\u306A\u3093\u306B\u3093}\u3082\u3000\u3044\u308B\u304B\u3089\u3000\u3059\u3054\u3044\u3088\u306D\uFF01",
  "\u30CD\u30C3\u30C8{\u901A\u8CA9|\u3064\u3046\u306F\u3093}\u306F\u3000{\u82E6\u624B|\u306B\u304C\u3066}\u3067\u306D\u2026\u2026\\n{\u73FE\u7269|\u3052\u3093\u3076\u3064}\u3092\u3000{\u898B|\u307F}\u3066\u304B\u3089\u3000{\u8CB7|\u304B}\u3044\u305F\u3044\u306E\u3088",
  "{\u77E5|\u3057}\u3063\u3066\u308B\u304B\uFF1F\u3000\u30DD\u30B1\u30E2\u30F3\u3063\u3066\\n\uFF16{\u5339|\u3074\u304D}\u307E\u3067\u3000{\u624B\u6301|\u3066\u3082}\u3061\u306B\u3000{\u5165|\u3044}\u308C\u3089\u308C\u308B\u3093\u3060\uFF01",
  "{\u6301|\u3082}\u3061\u304D\u308C\u306A\u3044\u3000\u30DD\u30B1\u30E2\u30F3\u306F\\n\u30DC\u30C3\u30AF\u30B9\u306B\u3000{\u9001|\u304A\u304F}\u3089\u308C\u308B\u3093\u3067\u3057\u3087",
  "\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u304A\u3068\u3057\u3082\u306E\u3000{\u62FE|\u3072\u308D}\u3044\u307E\u304F\u3063\u3066\\n{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\uFF2C\uFF30\u3067\u3000{\u6255|\u306F\u3089}\u3048\u3070\u2026\u2026\\r\\n\u304A{\u91D1|\u304B\u306D}\u304C\u3000\u306A\u304F\u3066\u3082\u3000{\u6B32|\u307B}\u3057\u3044\u3082\u306E\u3000{\u8CB7|\u304B}\u3048\u308B\uFF01",
  "\u30C6\u30FC\u30D6\u30EB\u30B7\u30C6\u30A3\u30FC\u3000{\u5B66|\u307E\u306A}\u3073\u306E{\u753A|\u307E\u3061}\uFF5E\u266A\\n\u30A2\u30AB\u30C7\u30DF\u30FC\u3000{\u6211|\u308F}\u304C{\u6BCD\u6821|\u307C\u3053\u3046}\uFF5E\u3000\u30E9\u30E9\u30E9\uFF5E\u266A",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E\u3000\u30A8\u30F3\u30C8\u30E9\u30F3\u30B9\u30DB\u30FC\u30EB\u306F\\n{\u672C\u68DA|\u307B\u3093\u3060\u306A}\u306E{\u672C|\u307B\u3093}\u3000{\u8AAD|\u3088}\u307F{\u653E\u984C|\u307B\u3046\u3060\u3044}\uFF01\\r\\n{\u672C\u597D|\u307B\u3093\u305A}\u304D\u306B\u306F\u3000\u305F\u307E\u3089\u306A\u3044\u306E\u30FC",
  "\u30AA\u30EC\u3000\u30A2\u30AB\u30C7\u30DF\u30FC\u306E\u3000{\u5352\u696D\u751F|\u305D\u3064\u304E\u3087\u3046\u305B\u3044}\uFF01\\n{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u3063\u3066\u3000\u307E\u3060\u3000{\u7D9A|\u3064\u3065}\u3044\u3066\u308B\u306E\u304B\u306A",
  "\u30A2\u30AB\u30C7\u30DF\u30FC\u306F\u3000{\u5E74\u9F62\u5236\u9650|\u306D\u3093\u308C\u3044\u305B\u3044\u3052\u3093}\u306A\u3057\uFF01\\n\u304A\u3070\u3042\u3055\u3093\u3067\u3082\u3000{\u5165\u5B66|\u306B\u3085\u3046\u304C\u304F}\u3067\u304D\u308B\u3093\u3067\u3059\u3063\u3066\uFF01\\r\\n\u2026\u2026\u308F\u305F\u3057\u3082\u3000{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u306A\u304A\u3057\u3061\u3083\u3046\uFF1F",
  "\u3053\u306E{\u5148|\u3055\u304D}\u306F\u3000{\u897F\u9580|\u306B\u3057\u3082\u3093}\u3060\u3088\\n\u30BB\u30EB\u30AF\u30EB\u30BF\u30A6\u30F3\u306B\u3000{\u884C|\u3044}\u304F\u306A\u3089\u3000{\u897F\u9580|\u306B\u3057\u3082\u3093}\uFF01",
  "{\u897F\u9580|\u306B\u3057\u3082\u3093}\u306F\u3000{\u5411|\u3080}\u3053\u3046\u306E{\u9053|\u307F\u3061}\uFF01\\n{\u7F36|\u304B\u3093}\u3065\u3081{\u5C4B|\u3084}\u3055\u3093\u306E\u3000{\u6A2A|\u3088\u3053}\u3092{\u901A|\u3068\u304A}\u308B\u306E",
  "\u3053\u306E{\u5148|\u3055\u304D}\u306F\u3000{\u884C|\u3044}\u304D{\u6B62|\u3069}\u307E\u308A\uFF01\\n\u30D0\u30EB\u30FB\u30AD\u30D0\u30EB\u3057\u304B\u3000\u306A\u3044\u3088\uFF01",
  "{\u8AB2\u5916\u6388\u696D|\u304B\u304C\u3044\u3058\u3085\u304E\u3087\u3046}\u306E\u3000{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u3057\u3088\uFF01\\n\u30C7\u30EA\u30D0\u30FC\u30C9\u30DD\u30FC\u30C1\u306F\u3000\u3069\u3053\u3060\u3063\u3051\uFF1F",
  "\u30C7\u30EA\u30D0\u30FC\u30C9\u30DD\u30FC\u30C1\u3063\u3066\u3000\u3044\u304F\u3064\u304B\u3000\u3042\u308B\u3051\u3069\\n{\u5357|\u307F\u306A\u307F}\u306E\u307B\u3046\u306B\u3000{\u884C|\u3044}\u3051\u3070\u3000\u3059\u3050\u3000{\u898B|\u307F}\u3064\u304B\u308B\u3088",
  "\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u304C\u3000{\u898B|\u307F}\u3048\u3066\u308B\u3068\u3000{\u5B89\u5FC3|\u3042\u3093\u3057\u3093}\\n\u2026\u2026{\u6D41|\u306A\u304C}\u308C\u3066\u304F\u308B\u3000{\u97F3\u697D|\u304A\u3093\u304C\u304F}\u3082\u3000\u3044\u3044\u3057",
  "\uFF11{\u5EA6|\u3069}\u3000{\u884C|\u3044}\u3063\u305F\u3000\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u306B\u306F\\n\u305D\u3089\u3068\u3076\u30BF\u30AF\u30B7\u30FC\u3067\u3000\u3059\u3050\u306B\u3000{\u623B|\u3082\u3069}\u308C\u308B\u308F\u3088",
  "\u30BF\u30A6\u30F3\u3068\u3000\u30B7\u30C6\u30A3\u3063\u3066\\n{\u4F55|\u306A\u306B}\u304C\u3000{\u9055|\u3061\u304C}\u3046\u3093\u3060\u2026\u2026\u3000{\u5927|\u304A\u304A}\u304D\u3055\uFF1F",
  "\uFF5E\u30B7\u30C6\u30A3\u3068\u3000{\u547C|\u3088}\u3070\u308C\u308B{\u753A|\u307E\u3061}\u306F\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u306B\u3000\uFF13\u3064\u3000\u3042\u308B\uFF01\\r\\n\uFF11\u3064\u304C\u3000\u3053\u3053\u3000\u30C6\u30FC\u30D6\u30EB\u30B7\u30C6\u30A3\u3060",
  "\u3053\u306E\u3042\u305F\u308A\u306B\u3000\u3081\u305A\u3089\u3057\u3044\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u304C\u3000{\u58F2|\u3046}\u3063\u3066\u308B\u3063\u3066\\r\\n{\u805E|\u304D}\u3044\u305F\u3093\u3060\u3051\u3069\u2026\u2026\u3000\u3069\u3053\u3060\u308D\u3046\uFF1F",
  "\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3000\u304A\u3044\u3057\u30FC\u3044\uFF01\\n\u307E\u3044\u306B\u3061\u3000\u305F\u3079\u305F\u30FC\u3044\uFF01",
  "\u3046\u3075\u3075\uFF01\u3000{\u4ECA\u5EA6|\u3053\u3093\u3069}\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3057\u3066\u307F\u3088\u3063\u304B\uFF1F",
  "{\u5317|\u304D\u305F}\u306B\u306F\u3000{\u4F4F\u5B85\u8857|\u3058\u3085\u3046\u305F\u304F\u304C\u3044}\u304C\u3000{\u4E26|\u306A\u3089}\u3093\u3067\u308B\uFF01\\c\\n\u3055\u3059\u304C\u306B\u3000\u30C6\u30FC\u30D6\u30EB\u306B\u3000{\u4F4F|\u3059}\u3093\u3067\u308B\u3068\\n{\u5B66\u751F\u5BEE|\u304C\u304F\u305B\u3044\u308A\u3087\u3046}\u306F\u3000{\u65AD|\u3053\u3068\u308F}\u3089\u308C\u308B\u3063\u3066\u3000{\u805E|\u304D}\u304F\u306D",
  "{\u8AB0|\u3060\u308C}\u304B\u304C\u3000\u30DD\u30B1\u30E2\u30F3\u3092\u3000\u3064\u308C{\u6B69|\u3042\u308B}\u3044\u3066\u308B\u306E\\n{\u898B|\u307F}\u308B\u3060\u3051\u3067\u3082\u3000\u3044\u3084\u3055\u308C\u308B\u308F",
  "\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3000\u3046\u307E\u3063\uFF01\\n\u3053\u306E{\u5E97|\u307F\u305B}\u306E\u306F\u3000{\u7279|\u3068\u304F}\u306B\u3000\u3046\u307E\u3046\u307E\u3063\uFF01",
  "\u30C7\u30EA\u30D0\u30FC\u30C9\u30DD\u30FC\u30C1\u3067\u3000\u30B9\u30DE\u30DB\u30AB\u30D0\u30FC\u3000{\u8CB7|\u304B}\u3046\u3068\\n\u30B9\u30DE\u30DB\u30ED\u30C8\u30E0\u3092\u3000{\u7740|\u304D}\u305B\u304B\u3048\u3000\u3067\u304D\u308B\u3088\uFF01\\r\\n\u3046\u30FC\u3093\u3000\u3069\u308C\u306B\u3057\u3088\u3046\u304B\u2026\u2026\u3000{\u60A9|\u306A\u3084}\u3080\uFF01",
  "\u3044\u3064\u304B\u3000\u30DD\u30B1\u30E2\u30F3\u3000\u3064\u304B\u307E\u3048\u305F\u3089\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u306B\u3000\u306A\u308B\u3093\u3060\u30FC\uFF01",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3067\u3000{\u661F\u5F62|\u307B\u3057\u304C\u305F}\u306E\u30B5\u30F3\u30B0\u30E9\u30B9\u3000{\u6D41\u884C|\u306F\u3084}\u3063\u3066\u308B\u306E\uFF1F\\n{\u96C6\u56E3|\u3057\u3085\u3046\u3060\u3093}\u3067\u3000\u304B\u3051\u3066\u308B\u306E\u3000{\u898B|\u307F}\u305F\u304B\u3089\u3055",
  "{\u753A|\u307E\u3061}\u306B\u3088\u3063\u3066\u3000\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u306E\\n{\u8272|\u3044\u308D}\u3068\u304B\u3000{\u898B|\u307F}\u305F{\u76EE|\u3081}\u304C\u3000{\u9055|\u3061\u304C}\u3046\u3093\u3060\u305C",
  "\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u306E\u3000\u304A{\u59C9|\u306D\u3048}\u3055\u3093\\n{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3059\u308B\u305F\u3073\u3000{\u8C46\u77E5\u8B58|\u307E\u3081\u3061\u3057\u304D}\u3000{\u6559|\u304A\u3057}\u3048\u3066\u304F\u308C\u308B\\r\\n\u2026\u2026\u30AA\u30EC\u3060\u3051\u3000{\u7279\u5225|\u3068\u304F\u3079\u3064}\u306A\u306E\u304B\u306A\uFF01\uFF1F",
  "\u30C7\u30EA\u30D0\u30FC\u30C9\u30DD\u30FC\u30C1\u3067\u3000{\u8CB7|\u304B}\u3063\u305F\\n{\u9053\u5177|\u3069\u3046\u3050}\u3092\u3000\u30D1\u30C1\u30EA\u30B9\u306B\u3000{\u6301|\u3082}\u305F\u305B\u305F\u306E\uFF01\\c\\n{\u6301|\u3082}\u305F\u305B\u308B{\u9053\u5177|\u3069\u3046\u3050}\u306B\u3000\u3088\u3063\u3066\\n\u3044\u308D\u3044\u308D\u3000{\u5F37|\u3064\u3088}\u304F\u306A\u308B\u3093\u3060\u304B\u3089\uFF01",
  "\u305B\u3093\u305B\u3044\u306E\u30C4\u30E1\uFF01\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n{\u6301|\u3082}\u305F\u305B\u305F\u3089\u3000\u305F\u307E\u306B\u3000\u3046\u308C\u3057\u3044\u3088\uFF01\\r\\n\u305D\u3053\u306E\u3000{\u8D64|\u3042\u304B}\u3044{\u5E97|\u307F\u305B}\u3067\u3000{\u58F2|\u3046}\u3063\u3066\u305F\u306E\u3055\uFF01",
  "{\u897F\u9580|\u306B\u3057\u3082\u3093}\u304B\u3089\u3000\u305A\u30FC\u3063\u3068\u3000{\u6B69|\u3042\u308B}\u3044\u3066\u3044\u304F\u3068\\n\u30BB\u30EB\u30AF\u30EB\u30BF\u30A6\u30F3\u307E\u3067\u3000{\u884C|\u3044}\u3051\u308B\u3088\uFF01\\r\\n{\u4ECA|\u3044\u307E}\u306F\u3000{\u53CE\u7A6B\u796D|\u3057\u3085\u3046\u304B\u304F\u3055\u3044}\u306E\u30B7\u30FC\u30BA\u30F3\u3000\u3060\u306D",
  "\u30C9\u30FC\u30BF\u30AF\u30F3\u3063\u3066\u3000{\u9B45\u529B\u7684|\u307F\u308A\u3087\u304F\u3066\u304D}\u2026\u2026\\c\\n\u305F\u307E\u306B\u3000{\u4E2D|\u306A\u304B}\u306B\u3000{\u5165|\u306F\u3044}\u3089\u305B\u3066\u3082\u3089\u3046\u3068\\n{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u3068\u3000{\u5FC3|\u3053\u3053\u308D}\u304C\u3000{\u843D|\u304A}\u3061{\u7740|\u3064}\u304F\u306E",
  "{\u9053|\u307F\u3061}\u306B\u3000{\u8FF7|\u307E\u3088}\u3063\u3066\u3057\u307E\u3063\u305F\u3088\\n\u30DE\u30C3\u30D7\u30A2\u30D7\u30EA\u3067\u3082\u3000{\u898B|\u307F}\u308B\u304B",
  "\u3053\u3053\u306E{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3000{\u98DF|\u305F}\u3079\u308B\u3068\\n\u30BF\u30DE\u30B4\u30D1\u30EF\u30FC\u304C\u3000\u308F\u3044\u3066\u304F\u308B\u3088\\c\\n\u30D4\u30AF\u30CB\u30C3\u30AF\u3067\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n\u30BF\u30DE\u30B4\u304C\u3000{\u898B|\u307F}\u3064\u304B\u308A\u3084\u3059\u304F\u306A\u308B\u3093\u3060",
  "\u30DD\u30B1\u30E2\u30F3\u306E\\n\u304A\u3068\u3057\u3082\u306E\u306F\u3000\u308F\u3056\u30DE\u30B7\u30F3\u30DE\u30B7\u30F3\u3067\\r\\n\uFF2C\uFF30\u306B\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u3066\u3082\u3089\u3048\u308B\u3088",
  "{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u306E{\u6A5F\u68B0|\u304D\u304B\u3044}\u306F\u3000\u3059\u30FC\u3050\u3000\u3057\u3083\u3079\u308B\uFF01\\n\u308F\u3056\u30DE\u30B7\u30F3\u30DE\u30B7\u30F3\u3082\u3000{\u97F3\u58F0|\u304A\u3093\u305B\u3044}\u3000{\u51FA|\u3067}\u308B\u3088\u306A",
  "\u30D1\u30C1\u30EA\u30B9\u306E\u3000\u3068\u304F\u305B\u3044\u306F\u3000\u306B\u3052\u3042\u3057\uFF01\\n{\u91CE\u751F|\u3084\u305B\u3044}\u306E\u30DD\u30B1\u30E2\u30F3\u304B\u3089\u3000\u306B\u3052\u308B\u306E\u3000\u3046\u307E\u3044\u306E\uFF01",
  "{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u306E\u3000{\u81EA\u52D5\u8CA9\u58F2\u6A5F|\u3058\u3069\u3046\u306F\u3093\u3070\u3044\u304D}\u3063\u3066\\n\uFF2C\uFF30\u3067\u3082\u3000{\u98F2|\u306E}\u307F\u3082\u306E\u304C\u3000{\u8CB7|\u304B}\u3048\u308B\u3093\u3060\u306A",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u968E\u6BB5|\u304B\u3044\u3060\u3093}\u306F\u3000{\u9577|\u306A\u304C}\u3059\u304E\u3066\\n{\u5730\u7344|\u3058\u3054\u304F}\u306E{\u968E\u6BB5|\u304B\u3044\u3060\u3093}\u3063\u3066\u3000{\u547C|\u3088}\u3070\u308C\u3066\u308B\u306E\\r\\n\u305F\u3057\u304B\u306B\u3000{\u901A|\u304B\u3088}\u3044\u306E{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u306F\u3000{\u5927\u5909|\u305F\u3044\u3078\u3093}\u3088\u306D",
  "{\u91CE\u751F|\u3084\u305B\u3044}\u306E\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u5BDD|\u306D}\u3066\u305F\u3089\u3000\u30C1\u30E3\u30F3\u30B9\uFF01\\n{\u4E0D\u610F|\u3075\u3044}\u3092\u3000\u3064\u3044\u3066\u3000{\u5148\u624B|\u305B\u3093\u3066}\u304C\u3000\u3068\u308C\u308B\uFF01",
  "\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u5BDD|\u306D}\u3066\u308B{\u59FF|\u3059\u304C\u305F}\u3092\u3000{\u898B|\u307F}\u308B\u3068\\n{\u5199\u771F\u64AE\u5F71|\u3057\u3083\u3057\u3093\u3055\u3064\u3048\u3044}\u3000{\u6B62|\u3068}\u307E\u3089\u306A\u304F\u306A\u3063\u3061\u3083\u3046",
  "{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u3000{\u6821\u9577\u5148\u751F|\u3053\u3046\u3061\u3087\u3046\u305B\u3093\u305B\u3044}\\n\u30AF\u30E9\u30D9\u30EB\u3055\u3093\u3000\u3067\u3057\u305F\u3063\u3051\uFF1F\\r\\n\uFF11{\u5E74\u534A|\u306D\u3093\u306F\u3093}\u304F\u3089\u3044{\u524D|\u307E\u3048}\u306B\u3000{\u5C31\u4EFB|\u3057\u3085\u3046\u306B\u3093}\u306A\u3055\u3063\u305F\u306E\u3088\u306D",
  "{\u751F\u5F92\u4F1A\u9577|\u305B\u3044\u3068\u304B\u3044\u3061\u3087\u3046}\u306E\\n\u30CD\u30E2\u3061\u3083\u3093\u3000\u3044\u3044{\u5B50|\u3053}\u3088\u306D\\r\\n\u3059\u308C{\u9055|\u3061\u304C}\u3046\u3068\u304D\u3000\u3044\u3064\u3082\u3000{\u6328\u62F6|\u3042\u3044\u3055\u3064}\u3057\u3066\u304F\u308C\u308B\u306E",
  "\u304D\u308C\u3044\u306A{\u666F\u8272|\u3051\u3057\u304D}\u306B\u3000{\u51FA\u4F1A|\u3067\u3042}\u3063\u305F\u3089\\n\u30AB\u30E1\u30E9\u30A2\u30D7\u30EA\u3067\u3000{\u5199\u771F|\u3057\u3083\u3057\u3093}\u3092\u3000{\u64AE|\u3068}\u3063\u3066\u307F\u306A",
  "\u304D\u307F\u3082\u3000{\u5C4B\u6839|\u3084\u306D}\u306E{\u4E0A|\u3046\u3048}\u3067\\n\u306E\u3093\u3073\u308A\u3059\u308B\u306E\u3000{\u597D|\u3059}\u304D\u306A\u30AF\u30C1\uFF1F\\r\\n\u3067\u3082\u3000{\u843D|\u304A}\u3063\u3053\u3061\u306A\u3044\u3088\u3046\u306B\u306D",
  "\u3053\u306E{\u5E97|\u307F\u305B}\u3067\u3000{\u5B66\u6821\u6307\u5B9A|\u304C\u3063\u3053\u3046\u3057\u3066\u3044}\u306E\\n\u30D0\u30C3\u30B0\u306E{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044\u3092\u3000{\u8CB7|\u304B}\u3048\u308B\u3093\u3060\\r\\n\u3069\u306E{\u8272|\u3044\u308D}\u306B\u3000\u3057\u3088\u3046\u304B\u306A\u30FC\uFF1F",
  "\u30D8\u30A2\u30E1\u30A4\u30AF\u30B5\u30ED\u30F3\u3067\u3000{\u9AEA\u578B|\u304B\u307F\u304C\u305F}\u3000{\u5909|\u304B}\u3048\u3066\u304F\u308B\u304B\u3089\\n\u3053\u306E\u3078\u3093\u3067\u3000{\u6642\u9593|\u3058\u304B\u3093}\u3000\u3064\u3076\u3057\u3066\u3066\u30FC",
  "\u30DD\u30B1\u30E2\u30F3\u306E{\u6280|\u308F\u3056}\u3000\u307F\u305F\u3044\u306A\\n{\u9AEA\u578B|\u304B\u307F\u304C\u305F}\u306E{\u540D\u524D|\u306A\u307E\u3048}\u3000\u3042\u308B\u3088\u306D\\r\\n\u30B5\u30A4\u30C9\u30D1\u30FC\u30C8\u3068\u304B\u3000\u30AE\u30D6\u30BD\u30F3\u30BF\u30C3\u30AF\u3068\u304B\u2026\u2026",
  "\u30E1\u30AC\u30CD\u306E{\u91CC|\u3055\u3068}\u3067\u3000\u30E1\u30AC\u30CD\u3000{\u8CB7|\u304B}\u3063\u3066\\n\u30E1\u30AC\u30CD\u30C7\u30D3\u30E5\u30FC\u3000\u3057\u3061\u3083\u304A\u3063\u304B\u306A\uFF01",
  "\u30AA\u30B7\u30E3\u30EC\u306A\u307C\u3046\u3057\u3000\u304B\u3076\u308A\u305F\u3044\uFF01\\n\u305D\u306E\u304F\u305B\u3000{\u9AEA\u578B|\u304B\u307F\u304C\u305F}\u3082\u3000\u30A2\u30D4\u30FC\u30EB\u3057\u305F\u3044\uFF01\\r\\n\u2026\u2026\u3068\u308A\u3042\u3048\u305A\u3000{\u5E97|\u307F\u305B}\u306B{\u5165|\u306F\u3044}\u3063\u3066\u3000{\u60A9|\u306A\u3084}\u3080\u304B\u306A",
  "{\u51B7|\u3072}\u3048{\u6027|\u3057\u3087\u3046}\u306B\u306F\u3000\u3076\u3042\u3064\u3044{\u9774\u4E0B|\u304F\u3064\u3057\u305F}\u304C\u3000\u3044\u3044\u306E\uFF01\\n\u3053\u306E{\u5E97|\u307F\u305B}\u3067\u3000\u3044\u308D\u3044\u308D\u3000{\u898B|\u307F}\u308C\u308B\u308F\u3088",
  "{\u679C\u7269|\u304F\u3060\u3082\u306E}\u306B\u3000\u304A{\u91CE\u83DC|\u3084\u3055\u3044}\u306B\u2026\u2026\\n\u30E9\u30A4\u30B9\u307E\u3067\u3000\u305D\u308D\u3063\u3066\u308B\uFF01\uFF1F\\c\\n{\u7F36|\u304B\u3093}\u306E{\u5927\u5C06|\u305F\u3044\u3057\u3087\u3046}\u3067\u3000{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3000{\u8CB7|\u304B}\u3044\u3053\u3093\u3067\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3000{\u4F5C|\u3064\u304F}\u308A\u307E\u304F\u308A\u3060\uFF01"
]
