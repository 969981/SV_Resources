[
  "\u3088\u3046\u3053\u305D\u3000\u30D9\u30A4\u30AF\u30BF\u30A6\u30F3\u3078\\n\u3053\u3053\u306F\u3000{\u661F|\u307B\u3057}\u3068\u3000{\u9676\u78C1\u5668|\u3068\u3046\u3058\u304D}\u306E\u3000{\u753A|\u307E\u3061}\u3088",
  "\u307C\u304F\u306E{\u5BB6\u65CF|\u304B\u305E\u304F}\u306F\u3000{\u4EE3\u3005|\u3060\u3044\u3060\u3044}\\n{\u9676\u5668\u8077\u4EBA|\u3068\u3046\u304D\u3057\u3087\u304F\u306B\u3093}\u3000\u306A\u3093\u3060\u305C\uFF01",
  "\u304A{\u6C34|\u307F\u305A}\u304C\u3000\u30C1\u30E7\u30ED\u30C1\u30E7\u30ED\u2026\u2026\\c\\n\u30CF\u30A4\u30C9\u30ED\u30DD\u30F3\u30D7\u3000\u307F\u305F\u3044\u306B\\n{\u51FA|\u3067}\u305F\u3089\u3000\u304A\u3082\u3057\u308D\u3044\u306E\u306B\u306D",
  "\u3053\u306E\u304A{\u76BF|\u3055\u3089}\u3000\u3067\u3063\u3051\u30FC\uFF01\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3000{\u4F55\u4EBA\u5206|\u306A\u3093\u306B\u3093\u3076\u3093}\u3060\u308D\u30FC\u306A\uFF1F",
  "\u30D9\u30A4\u30AF\u306E{\u98DF\u5668|\u3057\u3087\u3063\u304D}\u306F\u3000\u30D1\u30EB\u30C7\u30A2\u3067\u3082\\n{\u5927\u4EBA\u6C17|\u3060\u3044\u306B\u3093\u304D}\u306E\u3000{\u5DE5\u82B8\u54C1|\u3053\u3046\u3052\u3044\u3072\u3093}\u306A\u306E\u3088",
  "{\u9676\u5668|\u3068\u3046\u304D}\u306F\u3000\u304B\u307E\u3069\u3067\u3000{\u751F|\u3046}\u307E\u308C\u308B\uFF01\\c\\n{\u6210\u5F62|\u305B\u3044\u3051\u3044}\u3057\u305F\u3000{\u7C98\u571F|\u306D\u3093\u3069}\u3092\u3000{\u5165|\u3044}\u308C\u3066\\n\u3086\u3063\u304F\u308A\u3068\u3000{\u6570\u65E5|\u3059\u3046\u3058\u3064}\u304B\u3051\u3066\u3000{\u713C\u6210|\u3057\u3087\u3046\u305B\u3044}\u3059\u308B\u3093\u3060",
  "\u3053\u306E{\u753A|\u307E\u3061}\u306E\u3000\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u306F\\n{\u6614|\u3080\u304B\u3057}\u3000{\u5929\u6587\u53F0|\u3066\u3093\u3082\u3093\u3060\u3044}\u3068\u3057\u3066\u3000{\u4F5C|\u3064\u304F}\u3089\u308C\u305F\u306E\u3088",
  "\u3053\u306E{\u5148|\u3055\u304D}\u306E\u3000{\u5742\u9053|\u3055\u304B\u307F\u3061}\u3092\u3000\u306E\u307C\u3063\u305F\u3089\u306D\\n\u304A{\u8336|\u3061\u3083}\u306E\u3088\u3046\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u304A\u308A\u307E\u3057\u305F\u3088",
  "\u30D9\u30A4\u30AF\u30BF\u30A6\u30F3\u307E\u3067\u3000{\u6765|\u304F}\u308B\u306E\\n{\u9AA8|\u307B\u306D}\u304C\u3000{\u6298|\u304A}\u308C\u305F\u3093\u3058\u3083\u306A\u3044\uFF1F\\c\\n\uFF11{\u56DE|\u304B\u3044}\u3067\u3082\u3000{\u5230\u7740|\u3068\u3046\u3061\u3083\u304F}\u3057\u3061\u3083\u3048\u3070\u3000{\u4ECA\u5EA6|\u3053\u3093\u3069}\u306F\\n\u305D\u3089\u3068\u3076\u30BF\u30AF\u30B7\u30FC\u3067\u3000{\u6765|\u3053}\u308C\u308B\u304B\u3089\u306D",
  "\u30D9\u30A4\u30AF\u30BF\u30A6\u30F3\u306F\u3000{\u7ACB\u5730|\u308A\u3063\u3061}\u304C\u3000{\u4E0D\u4FBF|\u3075\u3079\u3093}\uFF01\\n\u30E2\u30C8\u30C8\u30AB\u30B2\u304C\u3000{\u6B20|\u304B}\u304B\u305B\u306A\u3044\u306E\u3088",
  "\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306E\u3000\u30EA\u30C3\u30D7\u3061\u3083\u3093{\u76EE\u5F53|\u3081\u3042}\u3066\u3067\\n{\u6765|\u304D}\u305F\u3051\u3069\u3000\u304A{\u76BF|\u3055\u3089}\u3082\u3000\u304B\u308F\u3044\u3044\uFF5E\uFF01",
  "{\u5929\u6587\u53F0|\u3066\u3093\u3082\u3093\u3060\u3044}\u306E\u3000\u30B7\u30F3\u30D7\u30EB\u306A\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u7D75|\u3048}\u3000\u304B\u308F\u3044\u3044\u3088\u306D\\r\\n\u30C9\u30C3\u30C8{\u7D75|\u3048}\u3063\u3066\u3000\u3044\u3046\u3093\u3067\u3057\u3087\uFF1F"
]
