[
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}\uFF01\\n{\u62BC\u5FCD|\u304A\u3059}\uFF01\u3000\u3084\u3063\u3066\u3044\u304F\u305E\uFF01[VAR 0114(0024)]",
  "{\u4E2D\u9593|\u3061\u3085\u3046\u304B\u3093}\u30C6\u30B9\u30C8\u3000\u307F\u3093\u306A\\n\u30CA\u30A4\u30B9\u30D5\u30A1\u30A4\u30C8\uFF01\u3000\u3060\u3063\u305F\u305E\uFF01[VAR 0114(0024)]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u304B\u3089\u3000{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u5F8C\u534A\u6226|\u3053\u3046\u306F\u3093\u305B\u3093}\u3060\uFF01\\n\u30D3\u30B7\u30D0\u30B7\u3000{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u3066\u3044\u3053\u3046\u306A\uFF01[VAR 0114(0024)]",
  "\u307F\u3093\u306A\u306F\\n\u300E\u30EC\u30C3\u30C4\u30B4\u30FC\u3000\uFF32\u30DC\u30BF\u30F3\u300F\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u3044\u308B\u304B\uFF01\uFF1F[VAR 0114(0024)]",
  "\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u524D\u65B9|\u305C\u3093\u307D\u3046}\u3078\u3000\u30EC\u30C3\u30C4\u30B4\u30FC\u3055\u305B\uFF01[VAR 0114(0024)]",
  "{\u96E2|\u306F\u306A}\u308C\u305F{\u9053\u5177|\u3069\u3046\u3050}\u3092\u3000{\u62FE|\u3072\u308D}\u3063\u3066\u3082\u3089\u3048\u308B\\n{\u5927\u52A9|\u304A\u304A\u3060\u3059}\u304B\u308A\u306A\u3000\u3042\u3044\u3053\u3068\u3070\u3060\u306A\uFF01[VAR 0114(0024)]",
  "\u30EC\u30C3\u30C4\u30B4\u30FC\u3057\u305F{\u5148|\u3055\u304D}\u306B\\n{\u91CE\u751F|\u3084\u305B\u3044}\u306E\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3044\u308C\u3070\\r\\n\u305D\u306E\u307E\u307E\u3000{\u6226\u95D8|\u305B\u3093\u3068\u3046}\u306B\u3000\u306A\u308B\u305E\uFF01[VAR 0114(0024)]",
  "\u305D\u306E{\u6226|\u305F\u305F\u304B}\u3044\u3092\\n\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB\u3068\u3000\u3044\u3046\uFF01\uFF01[VAR 0114(0024)]",
  "{\u6587\u5B57\u901A|\u3082\u3058\u3069\u304A}\u308A\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u304C\\n{\u6307\u793A|\u3057\u3058}\u305B\u305A\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\r\\n\u304A\u307E\u304B\u305B\u3067\u3000{\u6226|\u305F\u305F\u304B}\u3063\u3066\u3082\u3089\u3046\u3093\u3060\uFF01[VAR 0114(0024)]",
  "{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u306B\u3000{\u52DD|\u304B}\u3064\u3068\u3000\u3044\u3064\u3082\u3069\u304A\u308A\\n{\u7D4C\u9A13\u5024|\u3051\u3044\u3051\u3093\u3061}\u3092\u3000{\u5F97|\u3048}\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u308B\u305E\uFF01[VAR 0114(0024)]",
  "{\u4F7F|\u3064\u304B}\u3044\u3053\u306A\u305B\u3070\u3000{\u52B9\u7387|\u3053\u3046\u308A\u3064}\u3088\u304F\\n{\u624B\u6301|\u3066\u3082}\u3061\u3092\u3000{\u935B\u932C|\u305F\u3093\u308C\u3093}\u3059\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u308B\u306A\uFF01[VAR 0114(0024)]",
  "\u305F\u3060\u3057\u3000\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB{\u4E2D|\u3061\u3085\u3046}\u306B\\n\u30EC\u30D9\u30EB\u30A2\u30C3\u30D7\u3057\u3066\u3082\u3000{\u6280|\u308F\u3056}\u3092\u3000{\u899A|\u304A\u307C}\u3048\u306A\u3044\u3057\\r\\n{\u9032\u5316|\u3057\u3093\u304B}\u3057\u306A\u3044\u306E\u306F\u3000{\u8981\u6CE8\u610F|\u3088\u3046\u3061\u3085\u3046\u3044}\u3060\uFF01[VAR 0114(0024)]",
  "\u3042\u3068\u306F\u3000\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB\u3067\u3000{\u8CA0|\u307E}\u3051\u308B\u3068\\n\u308F\u305A\u304B\u306A{\u4F53\u529B|\u305F\u3044\u308A\u3087\u304F}\u3067\u3000{\u623B|\u3082\u3069}\u3063\u3066\u304F\u308B\u304B\u3089\\r\\n{\u624B|\u3066}\u3070\u3084\u304F\u3000{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3057\u3066\u3042\u3052\u308B\u3088\u3046\u306B\uFF01[VAR 0114(0024)]",
  "\u3042\u3089\u304B\u305F\u3000{\u8A71|\u306F\u306A}\u3057\u3066\u3057\u307E\u3063\u305F\u304C\\n\u3053\u3053\u307E\u3067\u3067\u3000{\u4F55|\u306A\u306B}\u304B{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u306F\u3000\u3042\u308B\u304B\uFF1F[VAR 0114(0024)]",
  "{\u4E2D\u65AD|\u3061\u3085\u3046\u3060\u3093}\u3059\u308B\u306B\u306F\uFF1F",
  "{\u6355\u7372|\u307B\u304B\u304F}\u306F\u3067\u304D\u308B\uFF1F",
  "{\u7279|\u3068\u304F}\u306B\u306A\u3044",
  "\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB\u304C\u3000{\u59CB|\u306F\u3058}\u307E\u308B\u3068\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u304C\u3064\u304F\u307E\u3067\u3000\u3084\u3081\u3089\u308C\u306A\u3044\u305E\uFF01\\c\\n\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB\u304C\u3000{\u59CB|\u306F\u3058}\u307E\u308B{\u524D|\u307E\u3048}\u306E\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u79FB\u52D5|\u3044\u3069\u3046}\u3057\u3066\u3044\u308B{\u9593|\u3042\u3044\u3060}\u306A\u3089\\r\\n\u300E\u30DC\u30FC\u30EB{\u6295|\u306A}\u3052\u3000\uFF3A\uFF32\u30DC\u30BF\u30F3\uFF01\u300F\u3067\u3000{\u4E2D\u65AD\u53EF\u80FD|\u3061\u3085\u3046\u3060\u3093\u304B\u306E\u3046}\u3060\uFF01[VAR 0114(0024)]",
  "\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB\u3067\u306F\u3000\u307B\u3063\u3066\u304A\u304F\u3068\\n{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000{\u5012|\u305F\u304A}\u3057\u3066\u3057\u307E\u3046\uFF01\\c\\n{\u6355\u7372|\u307B\u304B\u304F}\u3057\u305F\u3051\u308C\u3070\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u306E\\n{\u6307\u793A|\u3057\u3058}\u3067\u3000{\u6226|\u305F\u305F\u304B}\u3046{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308B\u305E\uFF01[VAR 0114(0024)]",
  "\u3046\u3080\uFF01\u3000\u307F\u3093\u306A\u3000{\u512A\u79C0|\u3086\u3046\u3057\u3085\u3046}\u3060\u306A\uFF01\\n{\u5C06\u6765|\u3057\u3087\u3046\u3089\u3044}\u304C\u3000{\u697D|\u305F\u306E}\u3057\u307F\u3060\uFF01[VAR 0114(0024)]",
  "\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB{\u4E2D|\u3061\u3085\u3046}\u3067\u3082\\n\u30DD\u30B1\u30E2\u30F3\u306F\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u306E\u305F\u3081\\r\\n\u304C\u3093\u3070\u3063\u3066\u304F\u308C\u3066\u3044\u308B\uFF01[VAR 0114(0024)]",
  "{\u9069\u5B9C|\u3066\u304D\u304E}\u3000{\u69D8\u5B50|\u3088\u3046\u3059}\u3092\u3000{\u898B|\u307F}\u3066\u3042\u3052\u3066\\n{\u8CA0|\u307E}\u3051\u305D\u3046\u306B\u306A\u3063\u305F\u3089\\r\\n{\u64A4\u9000|\u3066\u3063\u305F\u3044}\u3092\u3000\u3046\u306A\u304C\u3059\u3093\u3060\u305E\uFF01[VAR 0114(0024)]",
  "\u3082\u3061\u308D\u3093\u3060\u304C\u3000\uFF28\uFF30\u304C\u3000{\u4F4E|\u3072\u304F}\u3044\\n\u30DD\u30B1\u30E2\u30F3\u306F\u3000{\u75B2|\u3064\u304B}\u308C\u3066\u3044\u308B\uFF01[VAR 0114(0024)]",
  "\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB\u3092\u3000\u3044\u3084\u304C\u308B\u306E\u3067\\n\u3042\u307E\u308A\u3000{\u7121\u7406|\u3080\u308A}\u3055\u305B\u306A\u3044\u3088\u3046\u306B\u306A\uFF01[VAR 0114(0024)]",
  "{\u7D50\u8AD6|\u3051\u3064\u308D\u3093}\uFF01\uFF01[VAR 0114(0024)]",
  "\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB\u306F\u3000\u305F\u304C\u3044\u306B\\n{\u4FE1\u983C\u95A2\u4FC2|\u3057\u3093\u3089\u3044\u304B\u3093\u3051\u3044}\u304C\u3000\u3042\u3063\u3066\u3053\u305D\uFF01[VAR 0114(0024)]",
  "\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u898B\u640D|\u307F\u305D\u3053}\u306A\u308F\u308C\u306A\u3044\u3088\u3046\\n\u3046\u307E\u304F\u3000{\u6D3B\u7528|\u304B\u3064\u3088\u3046}\u3059\u308B\u3093\u3060\u305E\uFF01[VAR 0114(0024)]",
  "\u30E0\u30E0\uFF01\u3000{\u4F53|\u304B\u3089\u3060}\u3067\u3000{\u4F53\u9A13|\u305F\u3044\u3051\u3093}\u3057\u3066\u3082\u3089\u304A\u3046\u3068\\n{\u601D|\u304A\u3082}\u3063\u305F\u304C\u3000\u3082\u3046{\u6642\u9593|\u3058\u304B\u3093}\u304B\u2026\u2026[VAR 0114(0024)]",
  "\u305D\u308C\u3067\u306F\u3000{\u89E3\u6563|\u304B\u3044\u3055\u3093}\u3060\uFF01\\n\u304A\u306E\u304A\u306E\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000{\u904E|\u3059}\u3054\u3057\u3066\u304F\u308C\uFF01[VAR 0114(0024)]"
]
