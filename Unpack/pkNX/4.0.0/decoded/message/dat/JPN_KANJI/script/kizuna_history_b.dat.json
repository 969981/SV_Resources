  "\u30A6\u30C4\u30EF\u3000\u30C4\u30EB\u30AE\u3000\u30E2\u30C3\u30AB\u30F3\u3000\u30DE\u30AC\u30BF\u30DE\\n{\u4EE5\u4E0A|\u3044\u3058\u3087\u3046}\u3000\uFF14\u3064\u306E{\u5B9D|\u305F\u304B\u3089}\u3092\u3000{\u624B|\u3066}\u306B{\u5165|\u3044}\u308C\u305F\\r\\n{\u738B|\u304A\u3046}\u306E{\u57CE|\u3057\u308D}\u304C\u3000{\u58CA|\u3053\u308F}\u308C\u305F{\u7406\u7531|\u308A\u3086\u3046}\u2026\u2026[VAR 0114(0027)]",
