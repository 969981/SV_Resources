[
  "\u30AD\u30BF\u30AB\u30DF\u30BB\u30F3\u30BF\u30FC\u3078\u3000\u3088\u3046\u3053\u305D\uFF01\\n\u3082\u3046\u3059\u3050\u3000\u304A{\u796D|\u307E\u3064}\u308A\u304C\u3000{\u59CB|\u306F\u3058}\u307E\u308B\u3088\uFF01",
  "\u30AB\u30D3\u30B4\u30F3\u3063\u3066\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n{\u5206\u985E|\u3076\u3093\u308B\u3044}\u306F\u3000\u3044\u306D\u3080\u308A\u30DD\u30B1\u30E2\u30F3\uFF01\\r\\n\u2026\u2026{\u898B|\u307F}\u308C\u3070\u3000\u308F\u304B\u308B\u3088\u306A\uFF01",
  "\u304A\u3082\u3057\u308D\u3044\u30B2\u30FC\u30E0\u3000{\u7528\u610F|\u3088\u3046\u3044}\u3057\u3066\u308B\u3088\\n\u30AA\u30E2\u30C6{\u796D|\u307E\u3064}\u308A\u304C\u3000{\u59CB|\u306F\u3058}\u307E\u3063\u305F\u3089\u3000{\u6765|\u304D}\u3066\u3054\u3089\u3093",
  "\u30AD\u30BF\u30AB\u30DF\u30BB\u30F3\u30BF\u30FC\u3067\u306F\\n\u30AA\u30E2\u30C6{\u796D|\u307E\u3064}\u308A\u306E\u3000{\u771F|\u307E}\u3063{\u6700\u4E2D|\u3055\u3044\u3061\u3085\u3046}\uFF01\\r\\n\u3044\u3044{\u5B50|\u3053}\u3082\u3000\u308F\u308B\u3044{\u5B50|\u3053}\u3082\u3000{\u5BC4|\u3088}\u3063\u3066\u304D\u306A\uFF01",
  "\u3068\u3082\u3063\u3053\u3063\u307D\u3044\u3000{\u7740|\u304D}\u3050\u308B\u307F\u304C\\n{\u968E\u6BB5|\u304B\u3044\u3060\u3093}\u3000\u304B\u3051\u3042\u304C\u3063\u3066\u3044\u3063\u305F\u305C\uFF01\\r\\n{\u4E2D|\u306A\u304B}\u306E{\u4EBA|\u3072\u3068}\u3000{\u5927\u5909|\u305F\u3044\u3078\u3093}\u3060\u306A\uFF01",
  "\u304A\u308C\u304C\u3000{\u898B|\u307F}\u305F\u3084\u3064\\n{\u672C\u7269|\u307B\u3093\u3082\u306E}\u306E\u3068\u3082\u3063\u3053\u3000\u3060\u3063\u305F\u306E\u304B\u3088\uFF01\\r\\n{\u52D5\u753B|\u3069\u3046\u304C}\u3000{\u64AE|\u3068}\u3063\u3068\u304D\u3083\u3000\u3088\u304B\u3063\u305F\uFF01",
  "\u304A{\u9762|\u3081\u3093}\u3092\u3000{\u8CB7|\u304B}\u3044\u305F\u3044\u306E\u306B\\n\u304A{\u5E97|\u307F\u305B}\u306E{\u4EBA|\u3072\u3068}\u304C\u3000\u3044\u306A\u3044\u306E\u3088",
  "\u304A{\u5E97|\u307F\u305B}\u306E{\u4EBA|\u3072\u3068}\u3000{\u623B|\u3082\u3069}\u3063\u3066\u304D\u305F\u307F\u305F\u3044\\n{\u4ECA|\u3044\u307E}\u306A\u3089\u3000\u304A{\u9762|\u3081\u3093}\u3000{\u8CB7|\u304B}\u3048\u305D\u3046\u3088",
  "\u304A{\u9762|\u3081\u3093}\u304C\u3000\u3044\u3063\u3071\u3044\uFF01\\n\u3069\u308C\u306B\u3000\u3057\u3088\u3046\u304B\u306A\u30FC\uFF01",
  "\u30D4\u30AB\u30C1\u30E5\u30A6\u304A{\u9762|\u3081\u3093}\u3000\u304B\u3076\u3063\u305F\u3089\\n{\u6C17\u5206|\u304D\u3076\u3093}\u306F\u3000\u30D4\u30C3\u30D4\u30AB\u30C1\u30E5\u30A6\uFF01\uFF1F",
  "\u3046\u3061\u308F\u3067\u3000\u3042\u304A\u3050\u3068\u3000\u3059\u305A\u3057\u3044\uFF01\\n\u3067\u3082\u3000{\u624B|\u3066}\u3092{\u52D5|\u3046\u3054}\u304B\u3059\u3068\u3000{\u6C57|\u3042\u305B}\u3070\u3080\uFF01",
  "{\u4ECA\u5E74|\u3053\u3068\u3057}\u3082\u3000\u3068\u3082\u3063\u3053\u3055\u307E\u306E\\n\u304A{\u9762|\u3081\u3093}\u306F\u3000\u3084\u3063\u3071\u308A\u3000{\u4EBA\u6C17|\u306B\u3093\u304D}\u3088\u306D\uFF01",
  "\u3068\u3082\u3063\u3053\u3055\u307E\u3000{\u751F|\u3044}\u304D\u3066\u305F\u3063\u3066\u3000\u30DE\u30B8\uFF01\uFF1F\\n\u304A{\u9762|\u3081\u3093}\u3057\u3066\u3000\u304A{\u8FD1|\u3061\u304B}\u3065\u304D\u306B\u3000\u306A\u308D\u3046\u304B\u3057\u3089\uFF1F",
  "{\u672C\u7269|\u307B\u3093\u3082\u306E}\u306E\u3000\u30AD\u30C1\u30AD\u30AE\u30B9\u3055\u307E\u3063\u3066\\n\u3042\u3093\u307E\u308A\u3000\u30D4\u30F3\u30AF\u3058\u3083\u3000\u306A\u3044\u306E\u306D\u30FC",
  "\u30DE\u30B7\u30DE\u30B7\u30E9\u306E\u3000\u304A{\u9762|\u3081\u3093}\uFF01\\n{\u9752|\u3042\u304A}\u304F\u3066\u3000\u304B\u3063\u3051\u30FC\u305C\uFF01",
  "\u3048\u3063\u3000\u3068\u3082\u3063\u3053\u3063\u3066\\n{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3044\u308B\u306E\u304B\u3088\uFF01\\r\\n{\u4F5C|\u3064\u304F}\u308A{\u8A71|\u3070\u306A\u3057}\u304B\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\u305F\uFF01",
  "\u30EA\u30A2\u30EB\u3000\u30DE\u30B7\u30DE\u30B7\u30E9\u3063\u3066\u3000{\u9854|\u304B\u304A}\u3000{\u771F|\u307E}\u3063{\u9752|\u3055\u304A}\uFF01\\n\u3082\u3057\u304B\u3057\u3066\u3000{\u6C17\u5206|\u304D\u3076\u3093}\u304C\u3000{\u60AA|\u308F\u308B}\u3044\u306E\u304B\uFF1F",
  "\u304A{\u9762|\u3081\u3093}\u3000\u304B\u3076\u3063\u3066\u308B\u3068\\n{\u9055|\u3061\u304C}\u3046{\u81EA\u5206|\u3058\u3076\u3093}\u306B\u3000\u306A\u308C\u305F{\u6C17|\u304D}\u3000\u3059\u308B\u3088\u306D\uFF01",
  "{\u9B3C|\u304A\u306B}\u306E{\u6B74\u53F2|\u308C\u304D\u3057}\u3063\u3066\u3000{\u5B50\u4F9B|\u3053\u3069\u3082}\u306B\\n\u3044\u3046\u3053\u3068\u3000\u304D\u304B\u305B\u308B\u305F\u3081\u306E\\r\\n{\u4F5C|\u3064\u304F}\u308A{\u8A71|\u3070\u306A\u3057}\u3060\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\u305F\uFF01",
  "\u30A4\u30A4\u30CD\u30A4\u30CC\u3063\u3066\u3000{\u60AA|\u308F\u308B}\u3044\u30E4\u30C4\u3000\u3060\u3063\u305F\u306E\uFF01\uFF1F\\n{\u5168\u7136|\u305C\u3093\u305C\u3093}\u3000\u30A4\u30A4\u30CD\u3058\u3083\u3000\u306A\u3044\u3058\u3083\u3093\uFF01",
  "{\u6B74\u53F2|\u308C\u304D\u3057}\u306E{\u770B\u677F|\u304B\u3093\u3070\u3093}\u306B\\n{\u63CF|\u3048\u304C}\u304B\u308C\u3066\u308B\u3000{\u4EBA\u9593|\u306B\u3093\u3052\u3093}\u306E{\u7D75|\u3048}\u2026\u2026\\r\\n\u3068\u3082\u3063\u3053\u305F\u3061\u306E\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u304B\u3057\u3089\uFF1F",
  "{\u9B3C\u9000\u6CBB|\u304A\u306B\u305F\u3044\u3058}\u30D5\u30A7\u30B9\u3000\u3084\u3063\u3066\u308B\u3088\uFF01\\n{\u8C6A\u83EF\u666F\u54C1|\u3054\u3046\u304B\u3051\u3044\u3072\u3093}\u3000{\u76EE\u6307|\u3081\u3056}\u3057\u3066\u3000{\u904A|\u3042\u305D}\u3093\u3067\u307F\u3066\u3088\uFF01",
  "{\u9B3C\u9000\u6CBB|\u304A\u306B\u305F\u3044\u3058}\u30D5\u30A7\u30B9\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n\u30E9\u30A4\u30C9\u3057\u3066\u3000{\u904A|\u3042\u305D}\u3073\u307E\u3059\uFF01\\c\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3044\u306A\u3044{\u4EBA|\u3072\u3068}\u3067\u3082\u3000{\u5927\u4E08\u592B|\u3060\u3044\u3058\u3087\u3046\u3076}\uFF01\\n\u30AA\u30C9\u30B7\u30B7\u304C\u3000\u30B9\u30BF\u30F3\u30D0\u3063\u3066\u307E\u3059\uFF01"
]
