  "\u3069\u3063\u3061\u304C\u3000{\u52DD|\u304B}\u3063\u3066\u3082\\n\u304B\u308F\u3044\u3044{\u6226|\u305F\u305F\u304B}\u3044\u3000\u3067\u3057\u305F\uFF01\\r\\n\u304C\u3093\u3070\u3063\u305F\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u62CD\u624B|\u306F\u304F\u3057\u3085}\u3057\u307E\u3057\u3087\u3046\uFF01[VAR 0114(0049)]",
  "\u30AB\u30AD\u30C4\u30D0\u30BF\u3063\u3066\u3000\u3069\u3046\u3057\u3066\\n\u3042\u3093\u306A\u306B\u3000\u3061\u3083\u3093\u3068\u3000\u3057\u306A\u3044\u3093\u3060\u308D\\c\\n[VAR 0100(0000)]\u3055\u3093\u304B\u3089\u3082\\n{\u4F55|\u306A\u306B}\u304B\u3000{\u8A00|\u3044}\u3063\u3066\u3084\u3063\u3066\u304F\u3060\u3055\u3044[VAR 0114(0049)]",
  "\u30B9\u30B0\u30EA\u304F\u3093\u3000\u30A4\u30E1\u30C1\u30A7\u30F3\u3057\u3066\u304B\u3089\\n{\u6027\u683C|\u305B\u3044\u304B\u304F}\u3000{\u5909|\u304B}\u308F\u3063\u3061\u3083\u3044\u307E\u3057\u305F\u3051\u3069\\r\\n{\u898B|\u307F}\u305F{\u76EE|\u3081}\u306F\u3000\u304B\u308F\u3044\u3044\u2026\u2026\u3000\u3067\u3059\u3088\u306D\uFF1F[VAR 0114(0049)]",
  "\u308F\u305F\u3057\u306E\u30D1\u30D1\u3063\u3066\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3067\\n{\u898B|\u307F}\u305F{\u76EE|\u3081}\u3000\u3059\u3063\u3054\u304F\u3000{\u6016|\u3053\u308F}\u3044\u3093\u3067\u3059\u3088\\c\\n{\u7537|\u304A\u3068\u3053}\u306E{\u5B50|\u3053}\u306B\u3000{\u58F0|\u3053\u3048}\u304B\u3051\u3089\u308C\u3066\u3082\\n\u30D1\u30D1\u306E{\u540D\u524D|\u306A\u307E\u3048}\u3000{\u51FA|\u3060}\u3059\u3068\u3000{\u9003|\u306B}\u3052\u3061\u3083\u3046\u304F\u3089\u3044[VAR 0114(0049)]",
  "[VAR 0100(0000)]\u3055\u3093\u304B\u3089\\n\u3086\u305A\u3063\u3066\u3082\u3089\u3063\u305F\u3000[VAR 0101(0001)]\uFF01\\r\\n\u304B\u308F\u3044\u304F\u3066\u3000\u304B\u308F\u3044\u3059\u304E\u3067\u3059\u3088\u30FC\uFF01[VAR 0114(0049)]",
  "{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\u3000\u30D6\u30EB\u30FC\u306F\u3000\u304B\u308F\u3044\u3059\u304E\u3066\\n{\u8FF7\u60D1|\u3081\u3044\u308F\u304F}\u3000\u304B\u3051\u3066\u306A\u3044\u3067\u3059\u304B\uFF1F\\c\\n\u30B0\u30E9\u30F3\u30D6\u30EB\u307E\u3067\u3000{\u80B2|\u305D\u3060}\u3066\u305F\u3089\\n\u304A{\u8179|\u306A\u304B}\u3092\u3000\u307E\u304F\u3089\u306B\u3000{\u5BDD|\u306D}\u3066\u307F\u3066\u304F\u3060\u3055\u3044\u306D\uFF01[VAR 0114(0049)]"
]
