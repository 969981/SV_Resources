  "[~ 40]",
  "[VAR 0100(0000)]\u3055\u3093\\n\u3088\u3046\u3053\u305D\u3000\u30D5\u30EA\u30C3\u30B8\u30B8\u30E0\u3078",
  "\u30BD\u30A6\u30EB\u30D5\u30EB\u30D3\u30FC\u30C8\u2026\u2026\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30E9\u30A4\u30E0\u306B\u3000{\u6311|\u3044\u3069}\u307F\u307E\u3059\u304B\uFF1F",
  "\u305D\u308C\u3067\u306F\u3000\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u306B\\n\u3054{\u6848\u5185|\u3042\u3093\u306A\u3044}\u3044\u305F\u3057\u307E\u3059",
  "{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u304C\u3000\u3067\u304D\u307E\u3057\u305F\u3089\\n\u3044\u3064\u3067\u3082\u3000\u304A{\u58F0|\u3053\u3048}\u304C\u3051\u304F\u3060\u3055\u3044",
  "\u30E9\u30A4\u30E0\u306B\u3000{\u6311|\u3044\u3069}\u3080\u306B\u306F\\n{\u6226|\u305F\u305F\u304B}\u3048\u308B\u30DD\u30B1\u30E2\u30F3\u304C\u3000\uFF12{\u5339|\u3072\u304D}\u306F\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u3067\u3059\u3088\uFF01",
  "\uFF39\uFF2F\u3000\uFF39\uFF2F\u2026\u2026\uFF01",
  "\u2026\u2026\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u304B\u3089\\n\u30EA\u30BA\u30DF\u30AB\u30EB\u306A{\u8A71|\u306F\u306A}\u3057{\u58F0|\u3054\u3048}\u304C\u3000{\u805E|\u304D}\u3053\u3048\u308B\uFF01",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3053\u305D\u3000{\u8CA0|\u307E}\u304B\u3059\u305C\u3000\u30E9\u30C3\u30D7\u30D0\u30C8\u30EB\u3067\u266A\\n\uFF39\uFF2F\u3000{\u53CB|\u3068\u3082}\uFF01\u3000{\u5012|\u305F\u304A}\u3059\u305C\u3000\u30A4\u30C3\u30C4\u3000\u3042\u304A{\u5411|\u3080}\u3051\u266A",
  "\u30AA\u30EC\u306E\u3000\u30E9\u30C3\u30D7\u3000{\u8074|\u304D}\u3051\u3088\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u266A\\n\u30AA\u30EC\u306F\u3000\u30C8\u30C3\u30D7\u3000{\u5E97|\u307F\u305B}\u306E\u3000\u30D0\u30A4\u30C8\u30EA\u30FC\u30C0\u30FC\u266A",
  "\u30BA\u30F3\u30BA\u30F3\u3000\u30C1\u30E3\u30C3\u30C1\u30E3\u30AB\u2026\u2026\\n\u30BA\u30F3\u30BA\u30F3\u3000\u30C1\u30E3\u30C3\u30C1\u30E3\u30AB\u2026\u2026",
  "\u30D0\u30A4\u30C8\u3058\u3083\u3000\u30EA\u30FC\u30C0\u30FC\uFF1F\u266A\\n{\uFF32\uFF28\uFF39\uFF2D\uFF25|\u30E9\u30A4\u30E0}\u3058\u3083\u3000\u30D3\u30AE\u30CA\u30FC\u266A\\r\\n{\u6557\u8005|\u306F\u3044\u3057\u3083}\u306F\u3000{\u5E30|\u304B\u3048}\u308A\u306A\u3000{\u53BB|\u3055}\u3063\u3068\u304D\u306A\u266A[VAR 0114(001B)]",
  "\u30A2\u30BF\u30A4\u306F\u3000\u30E9\u30A4\u30E0\u266A\u3000{\u512A|\u3084\u3055}\u3057\u3055\u3000{\u7686\u7121|\u304B\u3044\u3080}\u266A\\n\u3058\u3083\u306A\u3044\u304B\uFF1F\u3000\u30E9\u30A4\u30AF\u3000\u30B6\u30FB\u30C0\u30A4\u30CA\u30DE\u30A4\u30C4\u266A[VAR 0114(001B)]",
  "\u30EF\u30C3\u30AF\u3067\u3000\u30EF\u30CA\u30D3\u306A\u3000\u30A2\u30F3\u30BF\u306B\u306F\u266A\\n\u30E9\u30C3\u30D7\u3067\u3000{\u5B66|\u307E\u306A}\u3073\u306A\u3000\u30CA\u30F3\u30DE\u30A4\u30C0\u266A\u3000\uFF28\uFF25\uFF39\uFF01[VAR 0114(001B)]",
  "\u30BA\u30F3\u30BA\u30F3\u3000\u30C1\u30E3\u30C3\u30C1\u30E3\u30AB\u2026\u2026\\n\u30BA\u30F3\u30BA\u30F3\u3000\u30C1\u30E3\u30C3\u30C1\u30E3\u30AB\u2026\u2026",
  "{\u5B8C\u6557|\u304B\u3093\u3071\u3044}\u3000{\u60E8\u6557|\u3056\u3093\u3071\u3044}\u3000{\u4E21\u6210\u6557|\u308A\u3087\u3046\u305B\u3044\u3070\u3044}\\n{\u6B21|\u3064\u304E}\u3053\u305D\u3000\u30EA\u30D9\u30F3\u30B8\u3000{\u5348\u5F8C|\u3054\u3054}\uFF13{\u6642|\u3058}\u30FC\uFF01",
  "{\u5F85|\u307E}\u3061\u306A\uFF01\u3000\u307E\u3060\u3000\u30CE\u3063\u3066\u304D\u306A\u3088\uFF01\\c\\n\u30CF\u30C3\u2026\u2026\u3000\u306A\u3093\u3060\u3044\u3000{\u5348\u5F8C|\u3054\u3054}\uFF13{\u6642|\u3058}\u3063\u3066\uFF01\\n{\u81EA\u7531|\u3058\u3086\u3046}\u306A\u30D0\u30A4\u30D6\u30B9\u3000\u30AD\u30E1\u3084\u304C\u3063\u3066\u3055\uFF01[VAR 0114(001B)]",
  "\u3042\u304D\u3089\u3081\u3000\u306F\u3084\u3081\u3067\u3000{\u60B2|\u304B\u306A}\u3057\u3044\u306D\uFF01\\n{\u9AA8|\u307B\u306D}\u3042\u308B\u3000{\u76F8\u624B|\u3042\u3044\u3066}\u306F\u3000\u3044\u306A\u3044\u304B\u306D\uFF01\u3000\u30E1\u30FC\u30F3\uFF01[VAR 0114(001B)]",
  "\u2026\u2026\u3093\uFF1F[VAR 0114(001B)]",
  "\u304A{\u6B21|\u3064\u304E}\u306E{\u76F8\u624B|\u3042\u3044\u3066}\u306F\u3000{\u524D\u5EA7|\u305C\u3093\u3056}\u306E\u30A2\u30F3\u30BF\uFF1F\\n\u30B8\u30E0\u30D0\u30C8\u30EB\u3000\u30E9\u30C3\u30D7\u30D0\u30C8\u30EB\u3000\u3069\u3063\u3061\u3060\u3044\uFF1F[VAR 0114(001B)]",
  "\u30B8\u30E0\u30D0\u30C8\u30EB\uFF01",
  "\u30E9\u30C3\u30D7\u30D0\u30C8\u30EB\uFF01",
  "\u30E9\u30C3\u30D7\u306A\u3000\u308F\u304D\u3083\u306A\u3044\\n{\u9055|\u3061\u304C}\u3044\u306A\u3044\u3063\u3066\u306D\uFF01\u3000\uFF28\uFF21\uFF28\uFF21\uFF28\uFF21\uFF01[VAR 0114(001B)]",
  "\uFF28\uFF21\uFF28\uFF21\uFF01\u3000\u30A2\u30F3\u30BF\u306E\u30A2\u30F3\u30B5\u30FC\\n\u30B8\u30E7\u30FC\u30AF\u304C\u3000{\u4E0A\u624B|\u3058\u3087\u3046\u305A}\u306A{\u5197\u8AC7|\u3058\u3087\u3046\u3060\u3093}\u3060\uFF01[VAR 0114(001B)]",
  "\u2026\u2026\u3093\uFF1F\u3000\u30A2\u30BF\u30A4\u306E{\u8A71|\u306F\u306A}\u3057{\u65B9|\u304B\u305F}\u304C\\n{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u306B\u3000{\u805E|\u304D}\u3053\u3048\u308B\u3063\u3066\uFF1F[VAR 0114(001B)]",
  "\u3053\u3044\u3064\u306F\u3000\u30E9\u30C3\u30D7\uFF01\\c\\n{\u97F3|\u304A\u3068}\u306E{\u97FF|\u3072\u3073}\u304D\u304C\u3000{\u540C|\u304A\u306A}\u3058{\u8A00\u8449|\u3053\u3068\u3070}\u3092\\n\u304F\u308A{\u8FD4|\u304B\u3048}\u3057\u3000\u3064\u3080\u3050\u3000{\u9B42|\u305F\u307E\u3057\u3044}\u306E{\u6B4C|\u3046\u305F}\u3055[VAR 0114(001B)]",
  "\u30E4\u30DF\u30E9\u30DF\u3000{\u65C5\u7ACB|\u305F\u3073\u3060}\u3061\u3000\u305F\u3061\u307E\u3061\u3000\u304B\u307F\u306A\u308A\u266A\\n\u305D\u3093\u306A{\u6BCE\u65E5|\u307E\u3044\u306B\u3061}\u3000\u3060\u3044\u305F\u3044\u3000\u3042\u308A\u304C\u3061\u266A\\r\\n\u2026\u2026\u3063\u3066\u306A{\u611F|\u304B\u3093}\u3058\u3055\uFF01\u3000{\u4F1D|\u3064\u305F}\u308F\u3063\u305F\u304B\u3044\uFF1F[VAR 0114(001B)]",
  "\u307E\u3000\u30A2\u30F3\u30BF\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u30C8\u30EC\u30FC\u30CA\u30FC\uFF01\\n{\u6602|\u305F\u304B}\u3076\u308B\u30CF\u30FC\u30C8\u306F\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3067\u3000{\u51FA|\u3060}\u3057\u306A\uFF01[VAR 0114(001B)]",
  "\u30A2\u30BF\u30A4\u3082\u3000{\u672C\u696D|\u307B\u3093\u304E\u3087\u3046}\u306F\u3000\u30E9\u30C3\u30D1\u30FC\u3060\u3051\u3069\\n\u30B4\u30FC\u30B9\u30C8\u30DD\u30B1\u30E2\u30F3\u3000{\u4F7F|\u3064\u304B}\u308F\u305B\u305F\u3089\\r\\n{\u53F3|\u307F\u304E}\u306B{\u51FA|\u3067}\u308B{\u8005|\u3082\u306E}\u306F\u3000\u3061\u3087\u3063\u3068\u3000\u3044\u306A\u3044\u3088[VAR 0114(001B)]",
  "\u30A2\u30BF\u30A4\u306F\u3000\u30E9\u30A4\u30E0\uFF01\\n\uFF41\uFF0E\uFF4B\uFF0E\uFF41\u3000\u30BD\u30A6\u30EB\u30D5\u30EB\u30D3\u30FC\u30C8\uFF01[VAR 0114(001B)]",
  "{\u8A9E|\u304B\u305F}\u308A\u306A\u3000\u30D0\u30A4\u30D6\u30B9\uFF01\\n{\u970A|\u308C\u3044}\u30FB{\u751F\u547D|\u305B\u3044\u3081\u3044}\uFF01\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308B\u30D5\u30A3\u30FC\u30EB\u30C9\uFF01\uFF01[VAR 0114(001B)]",
  "\uFF28\uFF21\uFF28\uFF21\uFF28\uFF21\uFF01\u3000\u3044\u3044\u306D\u3047\uFF01\\n\u30A2\u30F3\u30BF\u306E{\u9B42|\u305F\u307E\u3057\u3044}\u3000\u30D3\u30F3\u30D3\u30F3{\u611F|\u304B\u3093}\u3058\u305F\u3088\uFF01[VAR 0114(001B)]",
  "\u30A2\u30BF\u30A4\u3092\u3000\u3046\u306A\u3089\u305B\u308B\u3068\u306F\u3000{\u6C17\u9AA8|\u304D\u3053\u3064}\u304C\u3042\u308B\uFF01\\n\u30D5\u30F3\u30C3\uFF01\u3000\u30B8\u30E0\u30D0\u30C3\u30B8\u3000{\u6301|\u3082}\u3063\u3066\u3044\u304D\u306A\uFF01[VAR 0114(001B)]",
  "\u30A2\u30BF\u30A4\u306E\u30E9\u30A4\u30D6\u3000{\u7279\u7B49\u5E2D|\u3068\u304F\u3068\u3046\u305B\u304D}\u3067\\n{\u8074|\u304D}\u3051\u308B{\u6A29\u5229|\u3051\u3093\u308A}\u3082\u3000\u3064\u3044\u3067\u306B\u3000\u3069\u3046\u3060\u3044\uFF1F[VAR 0114(001B)]",
  "\u30B8\u30E0\u30D0\u30C3\u30B8\u3000[VAR 0200(0001)]{\u500B|\u3053}\u3000{\u6301|\u3082}\u3063\u3066\u308A\u3083\\n\u30EC\u30D9\u30EB[VAR 0201(0002)]\u307E\u3067\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\r\\n{\u6355|\u3064\u304B}\u307E\u3048\u3084\u3059\u3044\u3057\u3000\u3044\u3046\u3053\u3068\u3082\u3000\u304D\u304F\u3088\uFF01[VAR 0114(001B)]",
  "\u30B8\u30E0\u30D0\u30C3\u30B8\u3000\uFF18{\u500B|\u3053}\u3000{\u6301|\u3082}\u3063\u3066\u308A\u3083\\n\u3069\u3093\u306A\u30DD\u30B1\u30E2\u30F3\u3067\u3082\u3000{\u6355|\u3064\u304B}\u307E\u3048\u3089\u308C\u308B\u3057\\r\\n\u3057\u3063\u304B\u308A\u3000\u3044\u3046\u3053\u3068\u3082\u3000\u304D\u304F\u3088\uFF01[VAR 0114(001B)]",
  "\u30E9\u30C3\u30D7\u3067\u3000{\u8208\u596E|\u3053\u3046\u3075\u3093}\u3000\u3044\u3044{\u6C17\u5206|\u304D\u3076\u3093}\u3060\uFF01\\n\u3082\u3072\u3068\u3064\u3000\u30AA\u30DE\u30B1\u306B\u3000\u30D7\u30EC\u30BC\u30F3\u30C8\u3060\u3088\uFF01[VAR 0114(001B)]",
  "\u307E\u3060\u307E\u3060\u3000{\u8074|\u304D}\u304B\u305B{\u8DB3|\u305F}\u308A\u306A\u3044\u306D\u3047\uFF01\\n{\u7528\u4E8B|\u3088\u3046\u3058}\u304C\u3000{\u7D42|\u304A}\u308F\u3063\u305F\u3089\u3000\u307E\u305F{\u6765|\u304D}\u306A\uFF01\\r\\n{\u4ECA\u5EA6|\u3053\u3093\u3069}\u306F\u3000\u30E9\u30C3\u30D7\u30D0\u30C8\u30EB\u3067\u3082\u3000\u3044\u3044\u3055\u306D\uFF01[VAR 0114(001B)]",
  "\u30B0\u30C3\u30C9\u306A{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3000{\u5FDC\u63F4|\u304A\u3046\u3048\u3093}\u3057\u3066\u308B\u3088\\n\u30D0\u30A4\u30D0\u30A4\uFF01\u3000\u30D9\u30A4\u30D3\u30FC\uFF01[VAR 0114(001B)]",
  "\u30D5\u30EA\u30C3\u30B8\u30B8\u30E0\u3000{\u5408\u683C|\u3054\u3046\u304B\u304F}\\n\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01"
