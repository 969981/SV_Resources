[
  "[VAR 0100(0000)]\u306F\u3000{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304B\u3089\\n[VAR 0204(0001,0000)]\uFF22\uFF30\u3000\u3082\u3089\u3063\u305F\uFF01",
  "{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}{\u7559\u5B66|\u308A\u3085\u3046\u304C\u304F}\u306E\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\uFF01\\n\u308F\u305F\u3057\u306F\u3000{\u751F\u5F92|\u305B\u3044\u3068}{\u6307\u5C0E|\u3057\u3069\u3046}\u306E\u3000{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3088\uFF01",
  "\u3044\u304D\u306A\u308A\u3060\u3051\u3069\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3084\u3063\u3066\u308B\uFF01\uFF1F",
  "\u30D6\u30EB\u30FC\u30D9\u30EA\u30FC{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u3067\u306F\u3000{\u751F\u5F92|\u305B\u3044\u3068}{\u540C\u58EB|\u3069\u3046\u3057}\u306E\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3092\u3000\u3082\u308A\u3042\u3052\u308B\u305F\u3081\u306B\\c\\n\u30C9\u30FC\u30E0{\u5185|\u306A\u3044}\u3067\u3000\u307B\u304B\u306E{\u751F\u5F92|\u305B\u3044\u3068}\u3068\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308C\u3070\u3000\u3059\u308B\u307B\u3069\\r\\n\uFF22\uFF30\u3092\u3000\u30D7\u30EC\u30BC\u30F3\u30C8\u3057\u3066\u308B\u306E\uFF01",
  "\u307E\u305A\u306F\u3000\u3053\u3061\u3089\u3000\u30B5\u30D0\u30F3\u30CA\u30A8\u30EA\u30A2\u3067\\n[VAR 0201(0002)]{\u4EBA|\u306B\u3093}\u306E\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u306B\u3000{\u52DD|\u304B}\u3063\u3066\u307F\u3066\uFF01",
  "\u307E\u305A\u306F\u3000\u3053\u3061\u3089\u3000\u30AD\u30E3\u30CB\u30AA\u30F3\u30A8\u30EA\u30A2\u3067\\n[VAR 0201(0002)]{\u4EBA|\u306B\u3093}\u306E\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u306B\u3000{\u52DD|\u304B}\u3063\u3066\u307F\u3066\uFF01",
  "\u307E\u305A\u306F\u3000\u3053\u3061\u3089\u3000\u30B3\u30FC\u30B9\u30C8\u30A8\u30EA\u30A2\u3067\\n[VAR 0201(0002)]{\u4EBA|\u306B\u3093}\u306E\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u306B\u3000{\u52DD|\u304B}\u3063\u3066\u307F\u3066\uFF01",
  "\u307E\u305A\u306F\u3000\u3053\u3061\u3089\u3000\u30DD\u30FC\u30E9\u30A8\u30EA\u30A2\u3067\\n[VAR 0201(0002)]{\u4EBA|\u306B\u3093}\u306E\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u306B\u3000{\u52DD|\u304B}\u3063\u3066\u307F\u3066\uFF01",
  "\u30B5\u30D0\u30F3\u30CA\u30A8\u30EA\u30A2\u3067\\n\u3042\u306A\u305F\u304C\u3000{\u52DD|\u304B}\u3063\u305F\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u306F\u2026\u2026\\r\\n[VAR 0201(0003)]{\u4EBA|\u306B\u3093}\u306D\uFF01",
  "\u30AD\u30E3\u30CB\u30AA\u30F3\u30A8\u30EA\u30A2\u3067\\n\u3042\u306A\u305F\u304C\u3000{\u52DD|\u304B}\u3063\u305F\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u306F\u2026\u2026\\r\\n[VAR 0201(0003)]{\u4EBA|\u306B\u3093}\u306D\uFF01",
  "\u30B3\u30FC\u30B9\u30C8\u30A8\u30EA\u30A2\u3067\\n\u3042\u306A\u305F\u304C\u3000{\u52DD|\u304B}\u3063\u305F\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u306F\u2026\u2026\\r\\n[VAR 0201(0003)]{\u4EBA|\u306B\u3093}\u306D\uFF01",
  "\u30DD\u30FC\u30E9\u30A8\u30EA\u30A2\u3067\\n\u3042\u306A\u305F\u304C\u3000{\u52DD|\u304B}\u3063\u305F\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u306F\u2026\u2026\\r\\n[VAR 0201(0003)]{\u4EBA|\u306B\u3093}\u306D\uFF01",
  "{\u5408\u8A08|\u3054\u3046\u3051\u3044}\u3000[VAR 0201(0002)]{\u4EBA|\u306B\u3093}\u306B\u3000{\u52DD|\u304B}\u3066\u305F\u3089\\n\u307E\u305F\u3000{\u6765|\u304D}\u3066\u3088\u306D\uFF01",
  "\u3088\u304F\u3000\u304C\u3093\u3070\u3063\u305F\u306D\uFF01\\n{\u7A4D\u6975\u7684|\u305B\u3063\u304D\u3087\u304F\u3066\u304D}\u306B\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3057\u3066\u3000\u3048\u3089\u3044\uFF01",
  "\u304C\u3093\u3070\u3063\u305F{\u8CDE|\u3057\u3087\u3046}\u3067\\n\uFF22\uFF30\u3092\u3000\u30D7\u30EC\u30BC\u30F3\u30C8\uFF01",
  "\u3082\u3046\uFF11\u3064\u3000\u304A\u307E\u3051\u306B\u3000\u3042\u3052\u3061\u3083\u3046\uFF01",
  "{\u6B21|\u3064\u304E}\u306E{\u76EE\u6A19|\u3082\u304F\u3072\u3087\u3046}\u306F\u2026\u2026\\n[VAR 0201(0002)]{\u4EBA|\u306B\u3093}\u306B\u3000{\u52DD|\u304B}\u3064\u3053\u3068\u3000\u306A\u3093\u3060\u3051\u3069\\r\\n\u3082\u3046\u3000{\u9054\u6210|\u305F\u3063\u305B\u3044}\u3057\u3066\u308B\u3093\u3060\uFF01\uFF1F",
  "\u30AC\u30F3\u30AC\u30F3\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3057\u305F\u3089\\n\u307E\u305F\u3000{\u8CDE\u54C1|\u3057\u3087\u3046\u3072\u3093}\u3000\u3082\u3089\u3044\u306B\u304D\u3066\u306D\uFF01",
  "\u3082\u3057\u304B\u3057\u3066\u2026\u2026\u3000\u3042\u306A\u305F\uFF01\\c\\n\u30B5\u30D0\u30F3\u30CA\u30A8\u30EA\u30A2\u306B\u3000\u3044\u308B\\n{\u5168\u751F\u5F92|\u305C\u3093\u305B\u3044\u3068}\u306B\u3000{\u52DD|\u304B}\u3063\u3066\u308B\u307F\u305F\u3044\u3088\uFF01",
  "\u3082\u3057\u304B\u3057\u3066\u2026\u2026\u3000\u3042\u306A\u305F\uFF01\\c\\n\u30AD\u30E3\u30CB\u30AA\u30F3\u30A8\u30EA\u30A2\u306B\u3000\u3044\u308B\\n{\u5168\u751F\u5F92|\u305C\u3093\u305B\u3044\u3068}\u306B\u3000{\u52DD|\u304B}\u3063\u3066\u308B\u307F\u305F\u3044\u3088\uFF01",
  "\u3082\u3057\u304B\u3057\u3066\u2026\u2026\u3000\u3042\u306A\u305F\uFF01\\c\\n\u30B3\u30FC\u30B9\u30C8\u30A8\u30EA\u30A2\u306B\u3000\u3044\u308B\\n{\u5168\u751F\u5F92|\u305C\u3093\u305B\u3044\u3068}\u306B\u3000{\u52DD|\u304B}\u3063\u3066\u308B\u307F\u305F\u3044\u3088\uFF01",
  "\u3082\u3057\u304B\u3057\u3066\u2026\u2026\u3000\u3042\u306A\u305F\uFF01\\c\\n\u30DD\u30FC\u30E9\u30A8\u30EA\u30A2\u306B\u3000\u3044\u308B\\n{\u5168\u751F\u5F92|\u305C\u3093\u305B\u3044\u3068}\u306B\u3000{\u52DD|\u304B}\u3063\u3066\u308B\u307F\u305F\u3044\u3088\uFF01",
  "\u305D\u3093\u306A\u3000\u3042\u306A\u305F\u306B\u306F\\n\u3068\u3066\u3064\u3082\u306A\u304F\u3000\u304C\u3093\u3070\u3063\u305F\u3067{\u8CDE|\u3057\u3087\u3046}\uFF01",
  "\u305D\u3057\u3066\u3000{\u8FFD\u52A0|\u3064\u3044\u304B}\u3067\\n\u3068\u3066\u3064\u3082\u306A\u3044\u3000\u304A\u307E\u3051\uFF01",
  "\u307B\u304B\u306E\u30A8\u30EA\u30A2\u306B\u3082\u3000{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304C\u3000\u3044\u308B\u304B\u3089\\n\u305D\u3063\u3061\u3067\u3082\u3000\u304C\u3093\u3070\u3063\u3066\u306D\uFF01",
  "{\u5168|\u305C\u3093}\u30A8\u30EA\u30A2\u3067\u3000{\u5168\u751F\u5F92|\u305C\u3093\u305B\u3044\u3068}\u3092\u3000{\u5012|\u305F\u304A}\u3057\u305F\\n\u3042\u306A\u305F\u306B\u306F\u3000{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304B\u3089\\r\\n\u30C9\u30FC\u30E0{\u6700\u512A\u79C0\u8CDE|\u3055\u3044\u3086\u3046\u3057\u3085\u3046\u3057\u3087\u3046}\u3092\u3000\u3042\u3052\u3061\u3083\u3046\uFF01",
  "\u3053\u308C\u304B\u3089\u3082\u3000{\u697D|\u305F\u306E}\u3057\u3093\u3067\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3084\u3063\u3066\u3044\u3063\u3066\u306D",
  "\u30B5\u30D0\u30F3\u30CA\u30A8\u30EA\u30A2\u3067\u3000\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\uFF01\\n{\u5168|\u305C\u3093}{\u751F\u5F92|\u305B\u3044\u3068}\u306B\u3000{\u52DD|\u304B}\u3063\u3061\u3083\u3046\u306A\u3093\u3066\u3000\u3059\u3054\u3044\u308F",
  "\u30AD\u30E3\u30CB\u30AA\u30F3\u30A8\u30EA\u30A2\u3067\u3000\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\uFF01\\n{\u5168|\u305C\u3093}{\u751F\u5F92|\u305B\u3044\u3068}\u306B\u3000{\u52DD|\u304B}\u3063\u3061\u3083\u3046\u306A\u3093\u3066\u3000\u3059\u3054\u3044\u308F",
  "\u30B3\u30FC\u30B9\u30C8\u30A8\u30EA\u30A2\u3067\u3000\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\uFF01\\n{\u5168|\u305C\u3093}{\u751F\u5F92|\u305B\u3044\u3068}\u306B\u3000{\u52DD|\u304B}\u3063\u3061\u3083\u3046\u306A\u3093\u3066\u3000\u3059\u3054\u3044\u308F",
  "\u30DD\u30FC\u30E9\u30A8\u30EA\u30A2\u3067\u3000\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\uFF01\\n{\u5168|\u305C\u3093}{\u751F\u5F92|\u305B\u3044\u3068}\u306B\u3000{\u52DD|\u304B}\u3063\u3061\u3083\u3046\u306A\u3093\u3066\u3000\u3059\u3054\u3044\u308F"
]
