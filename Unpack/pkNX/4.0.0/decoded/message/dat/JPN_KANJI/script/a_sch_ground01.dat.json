[
  "\u30B0\u30E9\u30A6\u30F3\u30C9\u306F\u3000{\u5E83|\u3072\u308D}\u3044\u304B\u3089\\n{\u5927|\u304A\u304A}\u304D\u3044\u30DD\u30B1\u30E2\u30F3\u3000{\u51FA|\u3060}\u3057\u3066\u3082\u3000{\u5E73\u6C17|\u3078\u3044\u304D}\u306A\u3093\u3060\uFF01",
  "\u30AE\u30E3\u30E9\u30C9\u30B9\u306E{\u9854|\u304B\u304A}\u3000{\u898B|\u307F}\u3066\u308B\u3068\\n\u3044\u304B\u304F\u3067\u3000{\u653B\u6483|\u3053\u3046\u3052\u304D}\u3000{\u4E0B|\u3055}\u304C\u3063\u3061\u3083\u3046\u3088",
  "\u30C8\u30ED\u30D4\u30A6\u30B9\u306F\u3000\u30D5\u30EB\u30FC\u30C4\u304C\u3000{\u597D|\u3059}\u304D\u3059\u304E\u3066\\n{\u9996|\u304F\u3073}\u304B\u3089\u3000\u30D5\u30EB\u30FC\u30C4\u3000{\u751F|\u306F}\u3048\u305F\u3093\u3060\u3063\u3066\uFF01\\r\\n\u2026\u2026\u305D\u3093\u306A\u3000\u30D0\u30AB\u306A\uFF01\uFF1F",
  "{\u98DF\u5802|\u3057\u3087\u304F\u3069\u3046}\u306E{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306F\u3000\u3053\u3053\u306E{\u7551|\u306F\u305F\u3051}\u3067\\n{\u4F5C|\u3064\u304F}\u3089\u308C\u305F\u3000{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3067\u3000{\u4F5C|\u3064\u304F}\u3063\u3066\u308B\u3093\u3060\u3088",
  "\u304A{\u6B21|\u3064\u304E}\u306F\u3000{\u4F55|\u306A\u306B}\u3092\u3000{\u80B2|\u305D\u3060}\u3066\u3088\u3046\u304B\u306A\uFF1F\\n{\u4F5C\u7269|\u3055\u304F\u3082\u3064}\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\u3000{\u540C|\u304A\u306A}\u3058{\u60A9|\u306A\u3084}\u307F\u306D",
  "\u30E2\u30C8\u30C8\u30AB\u30B2\u3063\u3066\u3000\u30C4\u30E4\u30C4\u30E4\u3067\u3000\u30AD\u30E5\u30FC\u30C8\uFF01\\n{\u52C9\u5F37\u75B2|\u3079\u3093\u304D\u3087\u3046\u3065\u304B}\u308C\u304C\u3000\u3044\u3084\u3055\u308C\u308B\u3045\u30FC",
  "\u30E2\u30C8\u30C8\u30AB\u30B2\u3000\u30BB\u30E9\u30D4\u30FC\u3000{\u59CB|\u306F\u3058}\u3081\u307E\u3057\u305F\uFF01\\n{\u597D|\u3059}\u304D\u306A\u3060\u3051\u3000{\u898B|\u307F}\u3066\u3063\u3066\u3088",
  "\u30C9\u30ED\u30D0\u30F3\u30B3\u3068\u3000\u30DE\u30E9\u30BD\u30F3\u3057\u3066\u305F\uFF01\\n\u3058\u304D\u3085\u3046\u308A\u3087\u304F\u304C\u3000\u3059\u3054\u3044\u3093\u3060\u308F\uFF01",
  "\u3053\u308C\u304B\u3089\u3000{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u3068\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3059\u308B\u3093\u3060\uFF01",
  "{\u53CB\u9054\u540C\u58EB|\u3068\u3082\u3060\u3061\u3069\u3046\u3057}\u3060\u3068\u3000\u304A\u305F\u304C\u3044\u3000{\u624B|\u3066}\u306E{\u5185|\u3046\u3061}\\n{\u77E5|\u3057}\u3063\u3066\u308B\u304B\u3089\u3000{\u8AAD|\u3088}\u307F{\u5408|\u3042}\u3044\u304C\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u3088\u306A",
  "\u306A\u3093\u3060\u304B\u3000{\u5BDD|\u306D}\u3064\u3051\u306A\u3044\u304B\u3089\\n{\u6821\u5185|\u3053\u3046\u306A\u3044}\u3092\u3000\u304A{\u6563\u6B69|\u3055\u3093\u307D}\u3057\u3066\u308B\u306E",
  "\u3053\u306E{\u524D|\u307E\u3048}\u3000\u30CD\u30E2\u3061\u3083\u3093\u304C\u3000\u30B0\u30E9\u30A6\u30F3\u30C9\u3067\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\uFF13\uFF10{\u9023\u52DD|\u308C\u3093\u3057\u3087\u3046}\u3057\u3066\u305F\uFF01\\r\\n\u3055\u3059\u304C\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\uFF01",
  "\u30CD\u30E2\u3055\u3093\u306F\u3000{\u751F\u5F92\u4F1A\u9577|\u305B\u3044\u3068\u304B\u3044\u3061\u3087\u3046}\u3067\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u3067\u3000{\u6210\u7E3E\u512A\u79C0|\u305B\u3044\u305B\u304D\u3086\u3046\u3057\u3085\u3046}\uFF01\\r\\n{\u82E6\u624B|\u306B\u304C\u3066}\u306A\u3053\u3068\u306F\u3000\u3042\u308B\u306E\u304B\u306A\uFF1F",
  "\u30B8\u30E0\u3067\u3000{\u7DCA\u5F35|\u304D\u3093\u3061\u3087\u3046}\u3057\u306A\u3044\u3088\u3046\u306B\\n\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u3092\u3000{\u898B|\u307F}\u3064\u3081\u3066\u3000\u30A4\u30E1\u30C8\u30EC{\u4E2D|\u3061\u3085\u3046}\uFF01",
  "\u30B3\u30A4\u30AD\u30F3\u30B0\u304B\u3089\u3000\u30AE\u30E3\u30E9\u30C9\u30B9\u306B\\n{\u9032\u5316|\u3057\u3093\u304B}\u3055\u305B\u308B\u306E\u3000{\u5927\u5909|\u305F\u3044\u3078\u3093}\u3060\u3063\u305F\u3088",
  "{\u5BDD|\u306D}\u3066\u3066\u3082\u3000{\u7B11|\u308F\u3089}\u3063\u3066\u308B\u3000\u30B2\u30F3\u30AC\u30FC\\n\u305F\u307E\u3089\u306A\u304F\u3000{\u611B|\u3044\u3068}\u3057\u3044\u3093\u3060\u306A",
  "{\u6821\u9577\u5BA4|\u3053\u3046\u3061\u3087\u3046\u3057\u3064}\u304B\u3089\u3000\u305F\u307E\u306B\\n{\u5909|\u3078\u3093}\u306A{\u9AEA\u5F62|\u304B\u307F\u304C\u305F}\u306E\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u304C\u3000{\u51FA|\u3067}\u3066\u304F\u308B\u306E"
]
