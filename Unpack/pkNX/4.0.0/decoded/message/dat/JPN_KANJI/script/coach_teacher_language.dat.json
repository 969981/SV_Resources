  "\u30CD\u30AF\u30B9\u30C8{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3082\\n{\u5FC3\u5F85|\u3053\u3053\u308D\u307E}\u3061\u306B\u3000\u3057\u3066\u308B\u3088\u30FC\uFF01[VAR 0114(0026)]",
  "\u30BB\u30A4\u30B8\u306E\u3000\u3060\u3044\u3076\\n\u3044\u3044\u3068\u3053\u3000{\u898B|\u307F}\u3061\u3083\u3063\u305F\u306D\uFF01\\c\\n\u30CD\u30AF\u30B9\u30C8\u306F\u3000\u30AA\u30CC\u30B7\u306E\u3000\u3044\u3044\u3068\u3053\\n\u30EF\u30B7\u306B\u3000{\u898B|\u307F}\u305B\u3066\u304A\u304F\u3093\u306A\u306F\u308C\u30FC\uFF01[VAR 0114(0026)]",
  "\u30A2\u30AB\u30C7\u30DF\u30FC\u306E{\u751F\u5F92|\u305B\u3044\u3068}\u304C\u3000\u30EF\u30B7\u306E\u3053\u3068\\n\u30BB\u30A4\u30B8\u30CB\u30AD\u3063\u3066\u3000{\u547C|\u3088}\u3093\u3067\u305F\u3051\u3069\\r\\n\u30CB\u30AD\u3063\u3066\u3000\u3069\u3046\u3044\u3046{\u610F\u5473|\u3044\u307F}\u3000\u3067\u3063\u3057\u3083\u308D\u306A\u30FC\uFF01[VAR 0114(0026)]",
  "\u30BB\u30A4\u30B8\u304C\u3000{\u51FA\u5F35|\u3057\u3085\u3063\u3061\u3087\u3046}\u3057\u3066\u308B\u3068\u304D\\n\u30D1\u30E2\u3055\u3093\u306F\u3000\u30BB\u30A4\u30B8\u30BA\u3000\u30AF\u30E9\u30B9\u3067\\r\\n\u307F\u3093\u306A\u304C\u3000\u304A{\u4E16\u8A71|\u305B\u308F}\u3057\u3066\u304F\u308C\u3066\u308B\u306E\u3060\uFF01[VAR 0114(0026)]",
  "{\u65B0|\u3042\u305F\u3089}\u3057\u3044{\u73FE\u5834|\u3052\u3093\u3070}\u306F\u3000{\u77E5|\u3057}\u3089\u306A\u3044{\u4EBA|\u3072\u3068}\\n\u3044\u3063\u3071\u3044\u3000\u3044\u3063\u3071\u3044\u3000\u3060\u306D\uFF01\uFF01\\c\\n\u3067\u3082\u3000\u30A4\u30E2\u3065\u308B{\u5F0F|\u3057\u304D}\u306B\u3000\u306A\u304B\u3088\u304F\u306A\u308C\u3070\\n{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u3000\uFF11\uFF10\uFF10{\u4EBA|\u306B\u3093}\u3000\u3067\u304D\u308B\u308F\u306A\uFF01[VAR 0114(0026)]",
  "[VAR 0100(0000)]\u306E\u3000[VAR 0101(0001)]\u3055\u3093\u306F\\n{\u8D85|\u3061\u3087\u3046}\u30D9\u30EA\u30D9\u30EA\u3044\u3044{\u5B50|\u3053}\u3000\u3067\u3093\u304C\u306A\uFF01\\r\\n[VAR 0100(0000)]\u306B\u3000{\u4F3C|\u306B}\u305F\u306E\u304B\u3082\u306D\u30FC\uFF01[VAR 0114(0026)]",
  "\u30C8\u30EC\u30FC\u30C9\u3057\u305F\u3000\u30CB\u30E3\u30FC\u30B9\u3055\u3093\u306F\\n\u3054{\u6A5F\u5ACC|\u304D\u3052\u3093}\u3000{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\u3067\u3042\u308D\u3046\u304B\uFF01\uFF1F\\c\\n{\u60B2|\u304B\u306A}\u3057\u3044\u3068\u304D\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3068\u3000\u3044\u308C\u3070\\n\u3059\u3050\u3055\u307E\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u30DE\u30C3\u30AF\u30B9\u3000\u3060\u306D\u30FC\uFF01[VAR 0114(0026)]"
