[
  "\u304A\u30FC\u3044\uFF01\u3000[VAR 0100(0000)]\uFF01\\n\u3053\u3063\u3061\u3000\u3053\u3063\u3061\uFF01[VAR 0114(0004)]",
  "\u3053\u3053\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\uFF01[VAR 0114(0004)]",
  "\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u95A2\u4FC2|\u304B\u3093\u3051\u3044}\u3059\u308B\\n\u3044\u308D\u3093\u306A\u3053\u3068\u304C\u3000\u3067\u304D\u308B\u3093\u3060\uFF01[VAR 0114(0004)]",
  "\u305D\u308C\u3067\u306F\u3000\u304F\u308F\u3057\u3044\\n\u3054{\u8AAC\u660E|\u305B\u3064\u3081\u3044}\u3092\u3000\u304A{\u9858|\u306D\u304C}\u3044\u3057\u307E\u3059\uFF01[VAR 0114(0004)]",
  "\u306F\u3044\u3000\u304B\u3057\u3053\u307E\u308A\u307E\u3057\u305F\uFF01\\n\u3088\u3046\u3053\u305D\u3000\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u3078",
  "\u308F\u305F\u3057\u306F\u3000\u307F\u306A\u3055\u3093\u306E\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000\u3044\u305F\u3057\u307E\u3059\u3088",
  "\u305D\u3061\u3089\u306E{\u7AEF\u672B|\u305F\u3093\u307E\u3064}\u306F\\n\u308F\u3056\u30DE\u30B7\u30F3\u30DE\u30B7\u30F3\uFF01",
  "\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u6280|\u308F\u3056}\u3092\u3000{\u899A|\u304A\u307C}\u3048\u3055\u305B\u308B\\n\u308F\u3056\u30DE\u30B7\u30F3\u3092\u3000{\u4F5C|\u3064\u304F}\u308C\u308B\u3000{\u88C5\u7F6E|\u305D\u3046\u3061}\u3067\u3059",
  "\u308F\u3056\u30DE\u30B7\u30F3\u3092\u3000{\u4F5C|\u3064\u304F}\u308B\u306B\u306F\u3000[VAR FF00(0006)]\uFF2C\uFF30[VAR FF00(0000)]\u3068\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000[VAR FF00(0006)]\u304A\u3068\u3057\u3082\u306E[VAR FF00(0000)]\u304C\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u3067\u3059\u3088",
  "\u30B7\u30E7\u30C3\u30D7\u3084\u3000\u30DE\u30B7\u30F3\u3067\u3000{\u4F7F|\u3064\u304B}\u3048\u308B\u3000\uFF2C\uFF30\uFF01\\n\u3044\u3063\u3071\u3044\u3000{\u6301|\u3082}\u3063\u3066\u308B\u304B\u3089\u3000\u308F\u3051\u3066\u3042\u3052\u308B\u306D\uFF01[VAR 0114(0004)]",
  "\u3042\u3068\u3000\u3053\u308C\u3082\uFF01[VAR 0114(0004)]",
  "[VAR 0100(0000)]\u306F\u3000\u30CD\u30E2\u304B\u3089\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n[VAR FF00(0008)]\u304A\u3068\u3057\u3082\u306E[VAR FF00(0000)]\u3092\u3000\u305F\u304F\u3055\u3093\u3000\u308F\u3051\u3066\u3082\u3089\u3063\u305F\uFF01",
  "\u304A{\u96A3|\u3068\u306A\u308A}\u3000\u30D5\u30EC\u30F3\u30C9\u30EA\u30A3\u30B7\u30E7\u30C3\u30D7\u3067\u306F\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6355\u7372|\u307B\u304B\u304F}\u3059\u308B\u3000\u30E2\u30F3\u30B9\u30BF\u30FC\u30DC\u30FC\u30EB\u3084\\r\\n\u30AD\u30BA\u3050\u3059\u308A\u306A\u3069\u3000\u304A{\u6C42|\u3082\u3068}\u3081\u3044\u305F\u3060\u3051\u307E\u3059",
  "[VAR FF00(0006)]\uFF2C\uFF30\uFF08\u30EA\u30FC\u30B0\u30DA\u30A4\uFF09[VAR FF00(0000)]\u3068\u3044\u3046\u3000\u30DD\u30A4\u30F3\u30C8\u3067\u3082\\n\u304A{\u652F\u6255|\u3057\u306F\u3089}\u3044\u304C\u3000\u3067\u304D\u307E\u3059\u3088\\r\\n\uFF11\uFF2C\uFF30\u306F\u3000\uFF11{\u5186|\u3048\u3093}\u306E{\u4FA1\u5024|\u304B\u3061}\u304C\u3000\u3042\u308A\u307E\u3059",
  "\u30E6\u30CB\u30AA\u30F3\u30B5\u30FC\u30AF\u30EB\u3067\u306F\u3000{\u901A\u4FE1|\u3064\u3046\u3057\u3093}\u3067\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3059\u308B\u3000\u30E1\u30F3\u30D0\u30FC\u3092\\r\\n{\u52DF\u96C6|\u307C\u3057\u3085\u3046}\u3059\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u307E\u3059\u3088",
  "\u3053\u307E\u3063\u305F\u3053\u3068\u304C\u3000\u3042\u308A\u307E\u3057\u305F\u3089\\n\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u307E\u3067\u3000\u304A{\u8D8A|\u3053}\u3057\u304F\u3060\u3055\u3044",
  "\u306F\u30FC\u3044\uFF01\\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01[VAR 0114(0004)]",
  "\u3053\u307E\u3063\u305F\u3068\u304D\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\uFF01\\n\u3053\u3053\u3000\u30C6\u30B9\u30C8\u306B\u3000{\u51FA|\u3067}\u308B\u304B\u3089\u306D\uFF01[VAR 0114(0004)]",
  "\u305D\u3057\u3066\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u6163|\u306A}\u308C\u3066\u304D\u305F\u3089\\n\u30AA\u30B9\u30B9\u30E1\u306E\u3000\u3042\u3044\u3053\u3068\u3070\uFF01\\r\\n\u300E[VAR FF00(0006)]\u30EC\u30C3\u30C4\u30B4\u30FC\u3000\uFF32\u30DC\u30BF\u30F3\uFF01[VAR FF00(0000)]\u300F[VAR 0114(0004)]",
  "{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u6B69|\u3042\u308B}\u3044\u3066\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u306B\\n{\u843D|\u304A}\u3061\u3066\u308B{\u9053\u5177|\u3069\u3046\u3050}\u3000{\u62FE|\u3072\u308D}\u3063\u3066\u304D\u3066\u30FC\u3068\u304B\uFF01\\r\\n{\u6226|\u305F\u305F\u304B}\u3063\u3066\u304D\u3066\u30FC\u3068\u304B\uFF01\u3000\u304A{\u9858|\u306D\u304C}\u3044\u3067\u304D\u308B\u3093\u3060\uFF01[VAR 0114(0004)]",
  "\u30D7\u30E9\u30C8\u30BF\u30A6\u30F3\u3092\u3000{\u629C|\u306C}\u3051\u305F\u3089\\n{\u5357|\u307F\u306A\u307F}\uFF11{\u756A|\u3070\u3093}\u30A8\u30EA\u30A2\u3000{\u540D\u7269|\u3081\u3044\u3076\u3064}\u3000{\u901A\u5B66|\u3064\u3046\u304C\u304F}\u306E{\u5742|\u3055\u304B}\uFF01\\c\\n{\u8840\u6C17\u76DB|\u3051\u3063\u304D\u3055\u304B}\u3093\u306A\u3000\u30C8\u30EC\u30FC\u30CA\u30FC\u304C\\n\u3046\u3088\u3046\u3088\u3000\u3057\u3066\u308B\u304B\u3089\u3000\u304C\u3093\u3070\u3063\u3066\u306D\uFF01[VAR 0114(0004)]"
]
