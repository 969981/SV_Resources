[
  "\u3069\u304A\u3082\u3000\u3069\u304A\u3082\\n\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u307E\u3057\u3087\u3046\u304B\u3042[VAR 0114(002A)]",
  "{\u4E2D\u9593|\u3061\u3085\u3046\u304B\u3093}\u30C6\u30B9\u30C8\u3000\u307F\u3093\u306A\\n\u3068\u3063\u3066\u3082\u3000\u304A\u308A\u3053\u3046\u3055\u3093\u3000\u3067\u3057\u305F\u3088[VAR 0114(002A)]",
  "\u30A2\u30F3\u30B1\u30FC\u30C8\u3082\u3000{\u52A9|\u305F\u3059}\u304B\u308A\u307E\u3057\u305F\\n{\u4ECA\u5F8C|\u3053\u3093\u3054}\u306E{\u53C2\u8003|\u3055\u3093\u3053\u3046}\u306B\u3000\u3055\u305B\u3066\u3082\u3089\u3044\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u3055\u3066\u3000{\u4ECA\u65E5|\u304D\u3087\u3046}\u304B\u3089\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u5F8C\u534A\u6226|\u3053\u3046\u306F\u3093\u305B\u3093}\u3067\u3059[VAR 0114(002A)]",
  "\u307C\u304F\u305F\u3061\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u306E\u3088\u3046\u306B\\n{\u77E5\u8B58|\u3061\u3057\u304D}\u3092\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3055\u305B\u3066\u3044\u304D\u307E\u3057\u3087\u3046\u30FC\uFF01[VAR 0114(002A)]",
  "\u305D\u3046\u3000{\u9032\u5316|\u3057\u3093\u304B}\u2026\u2026\\n\u3048\u3078\u3078\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3067\u3059[VAR 0114(002A)]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n{\u9032\u5316|\u3057\u3093\u304B}\u3092\u3000{\u5B66|\u307E\u306A}\u3093\u3067\u3044\u304D\u307E\u3059\u3088\u30FC[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6226|\u305F\u305F\u304B}\u308F\u305B\u3066\\n\u30EC\u30D9\u30EB\u3092\u3000{\u4E0A|\u3042}\u3052\u3066\u3044\u304F\u3068\\r\\n{\u6280|\u308F\u3056}\u3092\u3000{\u899A|\u304A\u307C}\u3048\u305F\u308A\u3000{\u5F37|\u3064\u3088}\u304F\u306A\u308A\u307E\u3059[VAR 0114(002A)]",
  "\u305D\u3057\u3066\u3000\u30EC\u30D9\u30EB\u304C\\n\u3042\u308B{\u7A0B\u5EA6|\u3066\u3044\u3069}\u3000{\u9AD8|\u305F\u304B}\u304F\u306A\u308B\u3068\u2026\u2026[VAR 0114(002A)]",
  "{\u59FF|\u3059\u304C\u305F}\u304B\u305F\u3061\u304C\u3000{\u5909|\u304B}\u308F\u308A\\n{\u80FD\u529B|\u306E\u3046\u308A\u3087\u304F}\u304C\u3000{\u5927|\u304A\u304A}\u304D\u304F\u3000{\u4E0A|\u3042}\u304C\u308A\u307E\u3042\u3059[VAR 0114(002A)]",
  "\u305D\u308C\u304C\u3000\u30DD\u30B1\u30E2\u30F3\u306E{\u9032\u5316|\u3057\u3093\u304B}\u3000\u3067\u3059\uFF01\\n[VAR 0114(002A)]",
  "{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\u3068\u3000\u3068\u3063\u3066\u3082\\n{\u5F37|\u3064\u3088}\u304F\u306A\u308B\u306E\u3067\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3067\\r\\n{\u5FC3\u5F37|\u3053\u3053\u308D\u3065\u3088}\u3044\u3000\u30D1\u30FC\u30C8\u30CA\u30FC\u3068\u3000\u306A\u308A\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u2026\u2026\u3057\u304B\u3057\uFF01\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3055\u305B\u305A\u306B\\n{\u4ECA|\u3044\u307E}\u307E\u3067\u3068\u3000{\u540C|\u304A\u306A}\u3058{\u59FF|\u3059\u304C\u305F}\u306E\u307E\u307E\\r\\n\u304B\u308F\u3044\u304C\u308A\u305F\u3044{\u4EBA|\u3072\u3068}\u3082\u3000\u3044\u307E\u3059\u3088\u306D\u3048[VAR 0114(002A)]",
  "\u305D\u3093\u306A\u3068\u304D\u306F\u3000{\u9032\u5316|\u3057\u3093\u304B}\u304C\u3000{\u59CB|\u306F\u3058}\u307E\u3063\u305F\u3068\u304D\u306B\\n\u3042\u308F\u3066\u305A\u3000\u3042\u3044\u3053\u3068\u3070\u3092\u3000\u3068\u306A\u3048\u308B\u3093\u3067\u3059[VAR 0114(002A)]",
  "\u307F\u3093\u306A\u3067\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u8A00|\u3044}\u3063\u3066\u307F\u307E\u3057\u3087\u3046\\n{\u9032\u5316|\u3057\u3093\u304B}\u30AD\u30E3\u30F3\u30BB\u30EB\u2026\u2026\u3000\u305B\u30FC\u306E\u3063\uFF01[VAR 0114(002A)]",
  "\uFF21\u30DC\u30BF\u30F3\uFF01",
  "\uFF22\u30DC\u30BF\u30F3\uFF01",
  "\uFF23\u30DC\u30BF\u30F3\uFF01",
  "\u2026\u2026\u3042\u308C\u308C\uFF1F\u3000[VAR 0100(0000)]\u3055\u3093\u3060\u3051\\n\u304A{\u7B54|\u3053\u305F}\u3048\u304C\u3000{\u9055|\u3061\u304C}\u3046\u3088\u3046\u3067\u3059\\c\\n\uFF21\u30DC\u30BF\u30F3\u306F\u3000\u30AA\u30C3\u30B1\u30FC\u3068\u304B\\n{\u6C7A\u5B9A|\u3051\u3063\u3066\u3044}\u3060\u30FC\u3063\u3066{\u611F|\u304B\u3093}\u3058\u3000\u3057\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u30D9\u30B9\u30C8\u306A\u3000\u30A2\u30F3\u30B5\u30FC\u306E\u3000\uFF22\uFF01\\n\u307F\u306A\u3055\u3093\u3000\u3042\u305F\u308A\u3067\u3059\uFF01[VAR 0114(002A)]",
  "\u2026\u2026\u3042\u308C\u308C\uFF1F\u3000[VAR 0100(0000)]\u3055\u3093\u3060\u3051\\n\u304A{\u7B54|\u3053\u305F}\u3048\u304C\u3000{\u9055|\u3061\u304C}\u3046\u3088\u3046\u3067\u3059\\c\\n\uFF23\u30DC\u30BF\u30F3\u2026\u2026\u3000\u306A\u3093\u3060\u304B\u3000\u3068\u3066\u3082\\n{\u61D0|\u306A\u3064}\u304B\u3057\u3044\u3000{\u6C17\u6301|\u304D\u3082}\u3061\u306B\u306A\u308B\u3000{\u8A00\u8449|\u3053\u3068\u3070}\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u305D\u3046\u306A\u3093\u3067\u3059\u3000\u3042\u3044\u3053\u3068\u3070\u306F\\n\u300E{\u9032\u5316|\u3057\u3093\u304B}\u30AD\u30E3\u30F3\u30BB\u30EB\u3000\uFF22\u30DC\u30BF\u30F3\uFF01\u300F[VAR 0114(002A)]",
  "{\u9032\u5316|\u3057\u3093\u304B}\u304C\u3000{\u59CB|\u306F\u3058}\u307E\u3063\u3066\u3000\u3059\u3050\u3067\u3042\u308C\u3070\\n{\u59FF|\u3059\u304C\u305F}\u306E{\u5909\u5316|\u3078\u3093\u304B}\u3092\u3000{\u6B62|\u3068}\u3081\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u307E\u3042\u3059[VAR 0114(002A)]",
  "\u304B\u308F\u3089\u305A\u306E\u3044\u3057\u3000\u3068\u3044\u3046\\n{\u9053\u5177|\u3069\u3046\u3050}\u3092\u3000{\u6301|\u3082}\u305F\u305B\u308B\u3053\u3068\u3067\u3082\\r\\n{\u9032\u5316|\u3057\u3093\u304B}\u306E{\u52D5|\u3046\u3054}\u304D\u3092\u3000{\u6B62|\u3068}\u3081\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u3061\u306A\u307F\u306B\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\u3000{\u6761\u4EF6|\u3058\u3087\u3046\u3051\u3093}\u306F\\n\u30DD\u30B1\u30E2\u30F3\u306B\u3088\u3063\u3066\u3000\u3055\u307E\u3056\u307E[VAR 0114(002A)]",
  "\u307B\u306E\u304A\u306E\u3044\u3057\u3084\u3000\u304B\u307F\u306A\u308A\u306E\u3044\u3057\u306A\u3069\\n{\u9053\u5177|\u3069\u3046\u3050}\u3092\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\u3082\u306E\u3084\\r\\n{\u7279\u5B9A|\u3068\u304F\u3066\u3044}\u306E{\u6280|\u308F\u3056}\u3092\u3000{\u899A|\u304A\u307C}\u3048\u308B{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308B\u3082\u306E\\r\\n{\u7279\u5B9A|\u3068\u304F\u3066\u3044}\u306E\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u5012|\u305F\u304A}\u3059{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308B\u3082\u306E[VAR 0114(002A)]",
  "\u30AA\u30B3\u30EA\u30B6\u30EB\u304C\u3000\u30B3\u30CE\u30E8\u30B6\u30EB\u306B\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\\n{\u65B9\u6CD5|\u307B\u3046\u307B\u3046}\u306A\u3093\u304B\u306F\u3000{\u7279|\u3068\u304F}\u306B\u3000{\u5909|\u304B}\u308F\u3063\u3066\u3066[VAR 0114(002A)]",
  "\u3042\u308B{\u6280|\u308F\u3056}\u3092\u2026\u2026[VAR 0114(002A)]",
  "\u2026\u2026\u3059\u307F\u307E\u305B\u3093\u3000\u3061\u3087\u3046\u3069\\n{\u6642\u9593|\u3058\u304B\u3093}\u306B\u3000\u306A\u3063\u3061\u3083\u3044\u307E\u3057\u305F\u3042[VAR 0114(002A)]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u3053\u3053\u307E\u3067\u306B\u3000\u3057\u3066\u304A\u304D\u307E\u3059\\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3042[VAR 0114(002A)]"
]
