  "{\u7D9A|\u3064\u3065}\u304D\u306F\u3000\u307E\u305F{\u4ECA\u5EA6|\u3053\u3093\u3069}\u2026\u2026\\n{\u5CA9\u5CA9|\u30AC\u30F3\u30AC\u30F3}\u30C3\uFF01\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3057\u307E\u3057\u3087\u3046\u306D\u30FC[VAR 0114(0025)]",
  "\u307E\u3060\u307E\u3060\u3000\u308F\u305F\u3057\u3082\\n{\u6368|\u3059}\u3066\u305F\u3082\u306E\u3058\u3083\u3000\u306A\u3044\u306E\u304B\u3057\u3089\uFF1F\\c\\n\u304A{\u76F8\u624B|\u3042\u3044\u3066}\u3000\u3042\u308A\u304C\u3068\u3046\\n{\u697D|\u305F\u306E}\u3057\u3044{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3060\u3063\u305F\u308F[VAR 0114(0025)]",
  "\u30D6\u30EB\u30FC\u30D9\u30EA\u30FC{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u3067\\n\u3044\u308F\u30BF\u30A4\u30D7\u306E\u3000\u3059\u3054\u3044\u3068\u3053\u308D\u3000{\u6559|\u304A\u3057}\u3048\u305F\u3089\\r\\n{\u5C06\u6765|\u3057\u3087\u3046\u3089\u3044}\u3000\u3044\u308F\u30BF\u30A4\u30D7{\u4F7F|\u3064\u304B}\u3044\u3000{\u5897|\u3075}\u3048\u308B\u304B\u3057\u3089\uFF1F[VAR 0114(0025)]",
  "\u30D6\u30EB\u30FC\u30D9\u30EA\u30FC{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306B\u306F\\n\uFF22\uFF30\u3063\u3066\u3044\u3046\u3000{\u901A\u8CA8|\u3064\u3046\u304B}\u304C\u3000\u3042\u308B\u306E\u306D\uFF1F\\r\\n{\u6570\u5B66|\u3059\u3046\u304C\u304F}\u306E{\u554F\u984C|\u3082\u3093\u3060\u3044}\u306B\u3000{\u4F7F|\u3064\u304B}\u3048\u305D\u3046\u3060\u308F[VAR 0114(0025)]",
  "\u3055\u3063\u304D\u3000{\u59B9|\u3044\u3082\u3046\u3068}\u3068\u3000{\u9593\u9055|\u307E\u3061\u304C}\u3048\u3089\u308C\u3066\\n\u30B5\u30A4\u30F3\u3092\u3000\u306D\u3060\u3089\u308C\u3061\u3083\u3063\u305F\u308F\\c\\n\u308F\u305F\u3057\u3068\u3000\u30E9\u30A4\u30E0\\n{\u5168\u7136|\u305C\u3093\u305C\u3093}\u3000{\u4F3C|\u306B}\u3066\u306A\u3044\u3068\u3000{\u601D|\u304A\u3082}\u3046\u3093\u3060\u3051\u3069\u2026\u2026[VAR 0114(0025)]",
  "[VAR 0100(0000)]\u3055\u3093\u306E\u3000[VAR 0101(0001)]\u306F\\n\u3044\u3044{\u5B50|\u3053}\u306B\u3000\u3057\u3066\u3044\u307E\u3059\u3088\\c\\n\u3044\u3064\u3082\u3000\u308F\u305F\u3057\u306E\u3000\u30AD\u30E7\u30B8\u30AA\u30FC\u30F3\u3055\u3093\u306E\\n{\u80A9|\u304B\u305F}\u306B{\u4E57|\u306E}\u3063\u3066\u3000\u306E\u3093\u3073\u308A\u3000\u3057\u3066\u308B\u308F[VAR 0114(0025)]",
  "{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\u3000\u30A4\u30EF\u30F3\u30B3\u306F\\n\u306A\u304B\u3088\u304F\u3000\u3084\u308C\u3066\u3044\u308B\u304B\u3057\u3089\uFF1F\\c\\n\u30A4\u30EF\u30F3\u30B3\u306F\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\u3000{\u6642\u9593\u5E2F|\u3058\u304B\u3093\u305F\u3044}\u3067\\n{\u59FF|\u3059\u304C\u305F}\u304C{\u5909|\u304B}\u308F\u308B\u3000\u3081\u305A\u3089\u3057\u3044\u3000\u30DD\u30B1\u30E2\u30F3\u3088[VAR 0114(0025)]"
]
