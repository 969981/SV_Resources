[
  "\u2026\u2026{\u5143\u6C17|\u3052\u3093\u304D}\u305D\u3046\u306A\u3000{\u5B50\u4F9B|\u3053\u3069\u3082}\u305F\u3061\u3060[VAR 0114(002C)]",
  "\u30EF\u30AC\u30CF\u30A4\u306F\u3000\u30B5\u30EF\u30ED\\c\\n\u3053\u306E{\u6642\u9593|\u3058\u304B\u3093}\u3067\u306F\u3000{\u751F|\u3044}\u304D\u3066\u3044\u304F\u3046\u3048\u3067\\n{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u306A{\u77E5\u8B58|\u3061\u3057\u304D}\u3000{\u6280\u80FD|\u304E\u306E\u3046}\u3092\u3000{\u5B66|\u307E\u306A}\u3093\u3067\u3082\u3089\u3046[VAR 0114(0029)]",
  "\u3053\u306E{\u4E2D|\u306A\u304B}\u306B\u306F\u3000{\u89AA\u5143|\u304A\u3084\u3082\u3068}\u3092\u3000{\u96E2|\u306F\u306A}\u308C\u3000{\u5BEE|\u308A\u3087\u3046}\u3067\\n{\u4E00\u4EBA\u66AE|\u3072\u3068\u308A\u3050}\u3089\u3057\u3092\u3000\u3057\u3066\u3044\u308B{\u8005|\u3082\u306E}\u3082\u3000{\u591A|\u304A\u304A}\u3044[VAR 0114(0029)]",
  "\u30EF\u30AC\u30CF\u30A4\u304C\u3000{\u6388|\u3055\u305A}\u3051\u308B{\u77E5\u8B58|\u3061\u3057\u304D}\u306B\u3088\u308A\\n{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3089\u306E\u3000{\u8863|\u3044}\u30FB{\u98DF|\u3057\u3087\u304F}\u30FB{\u4F4F|\u3058\u3085\u3046}\u304C\\r\\n\u3088\u308A{\u826F|\u3088}\u304D\u3082\u306E\u306B\u3000\u306A\u308B\u3053\u3068\u3092\u3000{\u9858|\u306D\u304C}\u3046[VAR 0114(0029)]",
  "\u3055\u3057\u3042\u305F\u3063\u3066\u3000\u304D\u307F\u305F\u3061\u304C\\n{\u6C17|\u304D}\u306B\u306A\u308B\u306E\u306F\u3000\u300E{\u98DF|\u3057\u3087\u304F}\u300F\u3067\u3042\u308D\u3046\u306A[VAR 0114(0029)]",
  "\u30D4\u30AF\u30CB\u30C3\u30AF\u3067\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000{\u98DF|\u305F}\u3079\u308B\u3068\\n[VAR FF00(0006)]{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC[VAR FF00(0000)]\u3068\u3044\u3046\u3082\u306E\u304C\u3000{\u4ED8\u4E0E|\u3075\u3088}\u3055\u308C\\r\\n\u3055\u307E\u3056\u307E\u306A{\u52B9\u679C|\u3053\u3046\u304B}\u304C\u3000\u3042\u308B[VAR 0114(0029)]",
  "{\u4F53\u529B|\u305F\u3044\u308A\u3087\u304F}\u306E{\u56DE\u5FA9|\u304B\u3044\u3075\u304F}\u3092\u3000\u3059\u308B\u3060\u3051\u3067\u306A\u304F\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u6355|\u3064\u304B}\u307E\u3048\u3084\u3059\u304F\u306A\u3063\u305F\u308A\\r\\n{\u7D4C\u9A13\u5024|\u3051\u3044\u3051\u3093\u3061}\u3092\u3000{\u591A|\u304A\u304A}\u304F\u3000\u3082\u3089\u3048\u305F\u308A\u3060[VAR 0114(0029)]",
  "\u304A\u3044\u3057\u3044\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000{\u4F5C|\u3064\u304F}\u308C\u3070\\n\u3088\u308A\u3044\u3063\u305D\u3046\u3000{\u52B9\u679C|\u3053\u3046\u304B}\u304C\u3000{\u5897|\u3075}\u3048\u308B\u3067\u3042\u308D\u3046[VAR 0114(0029)]",
  "\u305D\u3057\u3066\u3000\u3055\u3089\u306B{\u5F79\u7ACB|\u3084\u304F\u3060}\u3064\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u3092\\n{\u5F97|\u3048}\u308B\u305F\u3081\u306B\u306F\u3000{\u6599\u7406|\u308A\u3087\u3046\u308A}\u3092\u3059\u308B\u3055\u3044\u306E\\r\\n{\u4F55|\u306A\u306B}\u304B\u304C\u3000{\u91CD\u8981|\u3058\u3085\u3046\u3088\u3046}\u306B\u3000\u306A\u3063\u3066\u304F\u308B\u306E\u3060\u304C\u2026\u2026[VAR 0114(0029)]",
  "\u3067\u306F\u3000[VAR 0100(0000)]\u3055\u3093\u306B\u3000{\u554F|\u3068}\u304A\u3046\\n\u3055\u3089\u306A\u308B\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u3092\u3000{\u5F97|\u3048}\u308B\u305F\u3081\u306B\u306F\\r\\n\u304D\u307F\u306F\u3000{\u4F55|\u306A\u306B}\u306B\u3000{\u6C17|\u304D}\u3092\u3064\u3051\u308B\u306E\u3060\uFF1F[VAR 0114(0029)]",
  "{\u5177\u6750|\u3050\u3056\u3044}\u3068{\u8ABF\u5473\u6599|\u3061\u3087\u3046\u307F\u308A\u3087\u3046}",
  "{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306E\u30B9\u30D4\u30FC\u30C9",
  "{\u611B\u60C5|\u3042\u3044\u3058\u3087\u3046}\u3092\u3053\u3081\u308B",
  "[VAR 0100(0000)]\u3055\u3093\u3000\u3054{\u540D\u7B54|\u3081\u3044\u3068\u3046}\u3060\\n{\u5BB6|\u3044\u3048}\u3067\u3000\u304A{\u624B\u4F1D|\u3066\u3064\u3060}\u3044\u3057\u3066\\r\\n\u3059\u3067\u306B\u3000{\u7406\u89E3|\u308A\u304B\u3044}\u3057\u3066\u3044\u305F\u306E\u304B\u306A\uFF1F[VAR 0114(0029)]",
  "\u2026\u2026\u305D\u306E{\u7B54|\u3053\u305F}\u3048\u306F\u3000{\u9593\u9055|\u307E\u3061\u304C}\u3044\u3060\\n\u30B9\u30D4\u30FC\u30C9\u3088\u308A\u304B\u306F\u3000\u3066\u3044\u306D\u3044\u3055\u3092\\r\\n{\u5927\u4E8B|\u3060\u3044\u3058}\u306B\u3057\u3066\u307B\u3057\u3044\u3068\u3000{\u9858|\u306D\u304C}\u304A\u3046[VAR 0114(0029)]",
  "\u30D5\u30C3\u2026\u2026\uFF01\u3000\u304A\u3082\u3057\u308D\u3044{\u7B54|\u3053\u305F}\u3048\u3060\\n{\u6C42|\u3082\u3068}\u3081\u308B{\u7B54|\u3053\u305F}\u3048\u3067\u306F\u3000\u306A\u3044\u304C\u2026\u2026\\r\\n\u3042\u308B{\u610F\u5473|\u3044\u307F}\u3000{\u6B63|\u305F\u3060}\u3057\u3044\u3068\u3000{\u8A00|\u3044}\u3048\u308B[VAR 0114(0029)]",
  "\u3055\u3089\u306A\u308B\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u3092\u3000{\u5F97|\u3048}\u308B\u305F\u3081\u306B\u306F\\n{\u5177\u6750|\u3050\u3056\u3044}\u3068{\u8ABF\u5473\u6599|\u3061\u3087\u3046\u307F\u308A\u3087\u3046}\u2026\u2026\u3000\u3044\u308F\u3086\u308B\\r\\n{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u304C\u3000{\u91CD\u8981|\u3058\u3085\u3046\u3088\u3046}\u3068\u3000{\u8A00|\u3044}\u3048\u308B[VAR 0114(0029)]",
  "{\u4F8B|\u305F\u3068}\u3048\u3070\u3000{\u7518|\u3042\u307E}\u3044{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3092\u3000{\u591A|\u304A\u304A}\u304F\\n{\u4F7F|\u3064\u304B}\u3046\u3068\u3000\u30BF\u30DE\u30B4\u30D1\u30EF\u30FC\u304C\u3000\u3064\u304D\u3084\u3059\u304F\u2026\u2026[VAR 0114(0029)]",
  "{\u82E6|\u306B\u304C}\u3044{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3092\u3000{\u591A|\u304A\u304A}\u304F\u3000{\u4F7F|\u3064\u304B}\u3046\u3068\\n\u304A\u3068\u3057\u3082\u306E\u30D1\u30EF\u30FC\u304C\u3000\u3064\u304D\u3084\u3059\u304F\u306A\u308B\u3000\u306A\u3069[VAR 0114(0029)]",
  "{\u6B32|\u307B}\u3057\u3044{\u52B9\u679C|\u3053\u3046\u304B}\u3092\u3000{\u72D9|\u306D\u3089}\u3063\u3066\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000{\u4F5C|\u3064\u304F}\u308C\u308C\u3070\\r\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u304C\u3000\u3055\u3089\u306B\u3000{\u597D|\u3053\u306E}\u307E\u3057\u304F\u306A\u308B\u3060\u308D\u3046\\c\\n\u3044\u3061\u304A\u3046\u3000\u30EC\u30B9\u30C8\u30E9\u30F3\u306E\u3000{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u3067\u3082\\n{\u98DF\u4E8B|\u3057\u3087\u304F\u3058}\u30D1\u30EF\u30FC\u3092\u3000\u3064\u3051\u3089\u308C\u308B\u304B\u3089\u306A[VAR 0114(0029)]",
  "\u2026\u2026{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u3089\u304C\u3000{\u77E5\u8B58|\u3061\u3057\u304D}\u3092\u3000{\u8EAB|\u307F}\u306B\u3064\u3051\\n{\u5BB6\u5EAD\u79D1|\u304B\u3066\u3044\u304B}\u3092\u3000\u3088\u308A\u3000{\u7406\u89E3|\u308A\u304B\u3044}\u3057\u3066\u304F\u308C\u308B\u3068\\r\\n\u30EF\u30AC\u30CF\u30A4\u3068\u3057\u3066\u3082\u3000{\u975E\u5E38|\u3072\u3058\u3087\u3046}\u306B\u3000{\u559C|\u3088\u308D\u3053}\u3070\u3057\u3044[VAR 0114(0029)]",
  "{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u306F\u3000{\u7D42\u4E86|\u3057\u3085\u3046\u308A\u3087\u3046}\u3060\\n\u3053\u308C\u306B\u3066\u3000{\u5931\u793C|\u3057\u3064\u308C\u3044}\u3059\u308B[VAR 0114(0029)]"
]
