  "{\u8FD1|\u3061\u304B}\u304F\u3067\u3000{\u5B66\u751F|\u304C\u304F\u305B\u3044}\u3055\u3093\u3000{\u898B|\u307F}\u3068\u3063\u305F\u3089\\n\u3044\u308D\u3044\u308D\u3000{\u5B66|\u307E\u306A}\u3076\u3053\u3068\u304C\u3000{\u591A|\u304A\u304A}\u3044\u306A\uFF01\\c\\n{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u3000{\u6620|\u3070}\u3048\uFF5E\u306A\u30DD\u30FC\u30BA\u304C\\n{\u5927\u6F01|\u305F\u3044\u308A\u3087\u3046}\u3060\u3044\uFF01\u3000{\u5927\u6F01|\u305F\u3044\u308A\u3087\u3046}\u3060\u3044\uFF01[VAR 0114(0018)]",
  "{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u3066\u304F\u308C\u305F\u3000[VAR 0101(0001)]\u306F\\n\u3068\u308C\u305F\u3066\u3000\u30D4\u30C1\u30D4\u30C1\uFF01\\r\\n{\u5148|\u3055\u304D}\u304C\u3000{\u697D|\u305F\u306E}\u3057\u307F\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u3060\u3044\uFF01[VAR 0114(0018)]",
  "\u30AA\u30A4\u30E9\u304C\u3000{\u653E\u6D41|\u307B\u3046\u308A\u3085\u3046}\u3057\u305F\\n\u30DF\u30AC\u30EB\u30FC\u30B5\u306F\u3000\u304D\u308C\u3042\u3058\u3000\u30D0\u30C4\u30B0\u30F3\uFF01\\c\\n\u305F\u307E\u306B\u3000\u307F\u305A\u304B\u3089\u3000{\u8EAB|\u307F}\u3092{\u6368|\u3059}\u3066\u308B\u304C\\n\u3073\u3063\u304F\u308A\u3000\u304A\u3063\u305F\u307E\u3052\u308B\u306A\u3088\u304A\uFF01[VAR 0114(0018)]",
  "\u30AC\u30C3\u30CF\u30C3\u30CF\uFF01\\n\u30AA\u30E2\u30C0\u30AB{\u5B22|\u3058\u3087\u3046}\u304B\u3089\u3000{\u805E|\u304D}\u3044\u305F\u305E\uFF01\\c\\n\u304A{\u524D|\u307E\u3048}\u3055\u3093\u304C\\n{\u4E00\u756A|\u3044\u3061\u3070\u3093}{\u597D|\u3059}\u304D\u306A\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u306B\\r\\n{\u7537|\u304A\u3068\u3053}\u3000\u30CF\u30A4\u30C0\u30A4\u3092\u3000{\u9078|\u3048\u3089}\u3093\u3067\u304F\u308C\u305F\u3068\uFF01\\c\\n\u304A\u3058\u3055\u3093\u3000\u3046\u308C\u3057\u304F\u3066\\n\u3084\u308B{\u6C17|\u304D}\u304C\u3000{\u9244\u7832\u6C34|\u3066\u3063\u307D\u3046\u307F\u305A}\u3060\u3044\uFF01\\c\\n\u30AA\u30A4\u30E9\u3082\u3000\u304A{\u524D|\u307E\u3048}\u3055\u3093\u306E\u3053\u3068\\n{\u5927\u4E8B|\u3060\u3044\u3058}\u306B\u3000{\u601D|\u304A\u3082}\u3063\u3068\u308B\u304B\u3089\u306A\u3042\uFF01[VAR 0114(0018)]"
]
