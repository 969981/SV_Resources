  "[VAR 0101(0001)]\u306F\u3000\u30B0\u30F3\u30B0\u30F3\u3000{\u5B9F|\u307F\u306E}\u3063\u3066\u308B\u3088\uFF01\\n{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\u3000\u30DD\u30B1\u30E2\u30F3{\u540C\u58EB|\u3069\u3046\u3057}\u3067\\r\\n{\u6226|\u305F\u305F\u304B}\u308F\u305B\u305F\u308A\u3082\u3000{\u697D|\u305F\u306E}\u3057\u305D\u3046\u3060\u306D\uFF01[VAR 0114(0004)]",
  "{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u305F\u3000\u30B1\u30F3\u30BF\u30ED\u30B9\u306F\\n{\u524D|\u307E\u3048}\u306E{\u5B9D|\u305F\u304B\u3089}{\u63A2|\u3055\u304C}\u3057\u3067\u3000{\u6D3B\u8E8D|\u304B\u3064\u3084\u304F}\u3057\u3066\u304F\u308C\u305F\u3093\u3060\uFF01\\c\\n[VAR 0100(0000)]\u304C\u3000{\u80B2|\u305D\u3060}\u3066\u3066\u304F\u308C\u308B\u306A\u3089\\n\u3053\u308C{\u4EE5\u4E0A|\u3044\u3058\u3087\u3046}\u3000\u3046\u308C\u3057\u3044\u3053\u3068\u3063\u3066\u3000\u306A\u3044\u3088\uFF01[VAR 0114(0004)]"
]
