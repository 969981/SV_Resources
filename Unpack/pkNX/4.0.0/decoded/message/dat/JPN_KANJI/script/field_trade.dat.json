[
  "\u2026\u2026\u305D\u306E\u30DD\u30B1\u30E2\u30F3\u306F\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u306E\\n{\u6761\u4EF6|\u3058\u3087\u3046\u3051\u3093}\u3092\u3000{\u6E80|\u307F}\u305F\u3057\u3066\u3044\u306A\u3044\u3088\u3046\u3060\uFF01",
  "\u30D5\u30E9\u30D9\u30D9\u3063\u3066\u3000\u30DD\u30B1\u30E2\u30F3\\n{\u82B1|\u306F\u306A}\u306E{\u8272|\u3044\u308D}\u304C\u3000\u305D\u308C\u305E\u308C\u3000{\u9055|\u3061\u304C}\u3046\u3093\u3060\u3063\u3066\uFF01\\c\\n\u3069\u3093\u306A{\u8272|\u3044\u308D}\u3067\u3082\u3000\u3044\u3044\u304B\u3089\\n\u307C\u304F\u306E\u3000\u30E6\u30AD\u30CF\u30DF\u3068\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u306A\u3044\uFF1F",
  "\u305D\u306E\u3000\u30D5\u30E9\u30D9\u30D9\u3092\\n{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u3066\u304F\u308C\u308B\u3093\u3060\uFF1F",
  "\u3080\u304A\u30FC\u3093\u3000{\u6B8B\u5FF5|\u3056\u3093\u306D\u3093}\uFF01\\n{\u6C17|\u304D}\u304C{\u5909|\u304B}\u308F\u3063\u305F\u3089\u3000\u3088\u308D\u3057\u304F\uFF01",
  "\u3048\u3000\u3061\u3063\u3061\u3083\u2026\u2026\uFF01\u3000\u304B\u308F\u2026\u2026\uFF01\\n\u3042\u3000{\u82B1|\u306F\u306A}\u306B\u3082\u3000{\u4E57|\u306E}\u3063\u3066\u2026\u2026\u3000\u3093\uFF01\\c\\n\u2026\u2026\u3075\u3046\uFF01\u3000\u30E6\u30AD\u30CF\u30DF\u3082\u3000{\u8CA0|\u307E}\u3051\u3058\u3068\\n\u304B\u308F\u3044\u3044\u304B\u3089\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u306B\u3057\u3066\u306D",
  "\u30D5\u30E9\u30D9\u30D9\u3063\u3066\u3000\u304B\u308F\u3044\u3059\u304E\u308B\u2026\u2026\uFF01\\c\\n\u3044\u308D\u3093\u306A{\u8272|\u3044\u308D}\u306E\u3000\u30D5\u30E9\u30D9\u30D9\\n{\u5168\u90E8|\u305C\u3093\u3076}\u3000{\u6355|\u3064\u304B}\u307E\u3048\u3061\u3083\u304A\u3063\u304B\u306A\uFF01",
  "\u30DD\u30B1\u30E2\u30F3\u304C\\n\uFF11{\u5339|\u3074\u304D}\u3060\u3051\u3060\u3068\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3067\u304D\u306A\u3044\u3088\uFF01\\c\\n{\u624B\u6301|\u3066\u3082}\u3061\u306F\\n\uFF12{\u5339\u4EE5\u4E0A|\u3072\u304D\u3044\u3058\u3087\u3046}\u3067\u3000\u3088\u308D\u3057\u304F\uFF01",
  "\u3053\u3086\u304D\u3061",
  "\u30D2\u30AB\u30BF\u30ED",
  "\u30D1\u30EB\u30C7\u30A2\u306E\u3000\u30A6\u30D1\u30FC\u3063\u3066\\n{\u6BD2|\u3069\u304F}{\u6301|\u3082}\u3063\u3066\u308B\u3063\u3066\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\uFF1F\\c\\n\u308F\u305F\u3057\u304C\u3000\u3088\u305D\u306E{\u5730\u65B9|\u3061\u307B\u3046}\u3067\u3000{\u6355|\u3064\u304B}\u307E\u3048\u305F\\n{\u9752|\u3042\u304A}\u3044\u30A6\u30D1\u30FC\u3068\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u3088\u3046\u3088\uFF01",
  "\u308F\u3063\u3000\u306A\u3093\u304B\u3000{\u6FC3|\u3053}\u3044\u306D\u2026\u2026\uFF01\\n\u305D\u306E\u30A6\u30D1\u30FC\u3068\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3067\u3000\u3044\u3044\u306E\uFF1F",
  "\u30A6\u30D1\u30FC\u3068\u3000\u30A6\u30D1\u30FC\u306E\u3000{\u4EA4\u63DB\u4F1A|\u3053\u3046\u304B\u3093\u304B\u3044}\\n\u3084\u308A\u305F\u304F\u306A\u3063\u305F\u3089\u3000{\u6559|\u304A\u3057}\u3048\u3066\u3088\u306D\uFF01",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3069\u304F\u30BF\u30A4\u30D7\u3060\uFF01\\n\u30DD\u30A4\u30BA\u30F3\u3000\u304B\u308F\u3044\u30FC\uFF01\\c\\n{\u9752|\u3042\u304A}\u3044\u30A6\u30D1\u30FC\u3082\u3000{\u7D20\u6575|\u3059\u3066\u304D}\u3060\u304B\u3089\\n\u3046\u30FC\u3093\u3068\u3000\u304B\u308F\u3044\u304C\u3063\u3066\u3088\u306D\uFF01",
  "\u30A6\u30D1\u30FC\u306E\u3000\u30D1\u30EB\u30C7\u30A2\u306E\u3059\u304C\u305F\uFF01\\n{\u9589|\u3068}\u3058\u305F{\u76EE|\u3081}\u304C\u3000\u305F\u308C\u3066\u3066\u3000\u304B\u308F\u3044\u3044\u306E\u30FC\uFF01\\c\\n{\u540C|\u304A\u306A}\u3058\u30DD\u30B1\u30E2\u30F3\u3067\u3082\u3000{\u5730\u65B9|\u3061\u307B\u3046}\u306B\u3088\u3063\u3066\\n{\u59FF|\u3059\u304C\u305F}\u3084\u30BF\u30A4\u30D7\u304C\u3000{\u9055|\u3061\u304C}\u3046\u306E\u3000\u304A\u3082\u3057\u308D\u3044\u306D\uFF01",
  "\u3042\u308C\uFF1F\u3000\u30DD\u30B1\u30E2\u30F3\\n\uFF11{\u5339|\u3074\u304D}\u3057\u304B\u3000{\u6301|\u3082}\u3063\u3066\u306A\u3044\u3093\u3060\uFF1F\\c\\n{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3059\u308B\u306A\u3089\u3000{\u624B\u6301|\u3066\u3082}\u3061\u306F\\n\uFF12{\u5339\u4EE5\u4E0A|\u3072\u304D\u3044\u3058\u3087\u3046}\u304C\u3000\u30EB\u30FC\u30EB\u3088\uFF01",
  "\u30DE\u30B5\u30AA",
  "\u30C1\u30A7\u30DF",
  "\u30E9\u30A4\u30C9{\u6280|\u308F\u3056}\uFF1A\u306A\u307F\u306E\u308A\u3000\u3067\u304D\u308B{\u5B50|\u3053}\u3000\u3044\u306A\u304F\u3066\\n{\u6D77|\u3046\u307F}\u306E\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u4F1A|\u3042}\u3048\u306A\u3044\u306E\u3088\u3093\\c\\n\u30D0\u30C1\u30F3\u30A6\u30CB\u3000{\u6301|\u3082}\u3063\u3066\u305F\u3089\\n\u308F\u305F\u3057\u306E\u3000\u30B4\u30FC\u30B9\u30C8\u3068\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u3066\u3048\u3093",
  "\u305D\u306E\u3000\u30D0\u30C1\u30F3\u30A6\u30CB\u3067\u3000\u3044\u3044\u306E\u306D\u3093\uFF1F",
  "\u3046\u3075\u3075\u2026\u2026\u3000\u3084\u3081\u3061\u3083\u3046\u306E\u306D\u3093\uFF1F\\n{\u4EBA\u751F|\u3058\u3093\u305B\u3044}\u3000{\u601D|\u304A\u3082}\u3044\u304D\u308A\u304C\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u3088",
  "\u3042\u3089\u307E\u30FC\u3000\u3061\u307F\u3061\u3083\u3093\\n\u30B2\u30F3\u30AC\u30FC\u306B\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3057\u305F\u306E\u3093\u30FC\uFF01\uFF1F\\c\\n{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3059\u308B\u3068\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\\n\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u3044\u308B\u3063\u3066\u3000\u30DE\u30B8\u3060\u3063\u305F\u306E\u306D\u30FC\u3093",
  "\u308F\u305F\u3057\u306E\u3000\u3061\u307F\u3061\u3083\u3093\\n{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000\u3057\u3066\u308B\u304B\u3057\u3089\u3093\uFF1F\\c\\n\u3042\u306A\u305F\u306E\u3000\u30D0\u30C1\u30F3\u30A6\u30CB\u306F\\n\u3068\u3063\u3066\u3082\u3000\u30D0\u30C1\u30D0\u30C1\u3000\u3057\u3066\u308B\u308F\u3088\u3093",
  "\u30DD\u30B1\u30E2\u30F3\u3000\uFF11{\u5339|\u3074\u304D}\u3060\u3051\u3060\u3068\\n{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3067\u304D\u306A\u3044\u306E\u3088\u3093\uFF01\\c\\n\u3046\u3075\u3075\u2026\u2026\u3000{\u624B\u6301|\u3066\u3082}\u3061\u306F\\n\uFF12{\u5339\u4EE5\u4E0A|\u3072\u304D\u3044\u3058\u3087\u3046}\u3067\u3000\u3088\u308D\u3057\u304F\u306D\u3093\uFF01",
