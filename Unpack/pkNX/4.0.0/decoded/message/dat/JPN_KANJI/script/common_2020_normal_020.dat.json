[
  "{\u81EA\u5206|\u3058\u3076\u3093}\u3068\u306F\u3000{\u56DB\u5929\u738B\u6226|\u3057\u3066\u3093\u306E\u3046\u305B\u3093}\u2026\u2026\\n{\u5B9F\u6280|\u3058\u3064\u304E}\u30C6\u30B9\u30C8\u3067\u3000{\u6226|\u305F\u305F\u304B}\u3063\u3066\u3044\u308B\u306E\u3067[VAR 0114(0015)]",
  "\u3053\u308C\u3068\u3044\u3063\u3066\\n{\u4F55|\u306A\u3093}\u306E{\u611F\u6168|\u304B\u3093\u304C\u3044}\u3082\u3000\u306A\u3044\u3067\u3057\u3087\u3046\u304C\\r\\n\u3088\u308D\u3057\u304F\u304A{\u9858|\u306D\u304C}\u3044\u3057\u307E\u3059[VAR 0114(0015)]",
  "\u3053\u306E{\u5EA6|\u305F\u3073}\u306F\u3000\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3068\u3057\u3066\u3000\u306A\u306E\u3067\\n\u3044\u3064\u3082\u306E\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u4F7F|\u3064\u304B}\u308F\u305B\u3066\u3082\u3089\u3044\u307E\u3059[VAR 0114(0015)]",
  "\u30CE\u30FC\u30DE\u30EB\u30BF\u30A4\u30D7\u2026\u2026\\n{\u666E\u901A|\u3075\u3064\u3046}\u2026\u2026\u3000{\u4E26|\u306A}\u307F\u2026\u2026\\r\\n{\u5E73\u51E1|\u3078\u3044\u307C\u3093}\u2026\u2026\u3000\u3042\u308A\u304D\u305F\u308A\u2026\u2026[VAR 0114(0015)]",
  "{\u500B\u6027|\u3053\u305B\u3044}\u306E\u306A\u3044{\u81EA\u5206|\u3058\u3076\u3093}\u306B\u3000{\u4F3C|\u306B}\u3064\u304B\u308F\u3057\u304F\\n{\u611B\u7740|\u3042\u3044\u3061\u3083\u304F}\u304C\u3000{\u6301|\u3082}\u3066\u307E\u3059[VAR 0114(0015)]",
  "{\u4EBA\u9593|\u306B\u3093\u3052\u3093}\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u3082\u3063\u3068\\n\u308F\u304B\u308A\u3084\u3059\u304F\u3067\u3000\u3044\u3044\u3093\u3067\u3059[VAR 0114(0015)]",
  "\u3084\u308C\u3000{\u7A81\u98DB|\u3068\u3063\u3074}\u3055\u3060\u3000{\u5947\u629C|\u304D\u3070\u3064}\u3055\u3060\\n\u30B1\u30EC\u30F3{\u5473|\u307F}\u304C\u3000{\u8A55\u4FA1|\u3072\u3087\u3046\u304B}\u3055\u308C\u308B\u3000{\u4E16|\u3088}\u306E{\u4E2D|\u306A\u304B}\u3067\u3059\u304C[VAR 0114(0015)]",
  "{\u697D|\u305F\u306E}\u3057\u3044{\u65C5\u884C\u5148|\u308A\u3087\u3053\u3046\u3055\u304D}\u3088\u308A\u3082\u3000{\u5E30|\u304B\u3048}\u3063\u3066\u304D\u305F\\n\u308F\u304C{\u5BB6|\u3084}\u304C\u3000{\u4E00\u756A|\u3044\u3061\u3070\u3093}\u3000{\u5B89|\u3084\u3059}\u3089\u3050\u3067\u3057\u3087\u3046\uFF1F[VAR 0114(0015)]",
  "\u305D\u3046\u3000\u30B7\u30F3\u30D7\u30EB\u306A\u306E\u304C\\n{\u4E00\u756A|\u3044\u3061\u3070\u3093}\u3000{\u5F37|\u3064\u3088}\u3044\u3093\u3067\u3059\u3088[VAR 0114(0015)]",
  "{\u5E73\u51E1|\u3078\u3044\u307C\u3093}\u306A{\u81EA\u5206|\u3058\u3076\u3093}\u306B\u3068\u3063\u3066\\n\u3042\u306A\u305F\u306F\u3000{\u523A\u6FC0|\u3057\u3052\u304D}\u304C\u3000{\u5F37|\u3064\u3088}\u3059\u304E\u308B[VAR 0114(0015)]",
  "\u2026\u2026\u3067\u3082\u3000{\u5C11|\u3059\u3053}\u3057\u3060\u3051\u3000\u308F\u304B\u308A\u307E\u3057\u305F[VAR 0114(0015)]",
  "{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u306E\u3068\u304D\u306F\u3000\u3072\u3053\u3046\u30BF\u30A4\u30D7\u3092\\n{\u4F7F|\u3064\u304B}\u3048\u3068\u3000{\u8A00|\u3044}\u308F\u308C\u305F{\u610F\u5473|\u3044\u307F}[VAR 0114(0015)]",
  "{\u5E73|\u305F\u3044}\u3089\u306A{\u9053|\u307F\u3061}\u3092\u3000{\u6B69|\u3042\u308B}\u304F\u3060\u3051\u3067\u306F\\n{\u6C17|\u304D}\u3065\u3051\u306A\u3044{\u666F\u8272|\u3051\u3057\u304D}\u304C\u3000\u3042\u308B\u2026\u2026[VAR 0114(0015)]",
  "\u305F\u307E\u306B\u306F\u3000\u3042\u306A\u305F\u306E\u3088\u3046\u306A\u3000{\u7A7A|\u305D\u3089}\u3092{\u884C|\u3044}\u304F\\n{\u624D\u80FD|\u3055\u3044\u306E\u3046}\u3092\u3000{\u898B\u4E0A|\u307F\u3042}\u3052\u308B\u306E\u3082\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u3060[VAR 0114(0015)]",
  "\u3042\u304F\u307E\u3067\u3000{\u696D\u52D9|\u304E\u3087\u3046\u3080}\u306A\u3089\u3000\u3084\u308B\u3060\u3051\u3067\u3059\\n{\u597D|\u3059}\u304D{\u597D|\u3053\u306E}\u3093\u3067\u306F\u3000\u3084\u308A\u307E\u305B\u3093\u3088[VAR 0114(0015)]",
  "{\u672C\u65E5|\u307B\u3093\u3058\u3064}\u3000\u30CE\u30FC{\u6B8B\u696D|\u3056\u3093\u304E\u3087\u3046}\u30C7\u30FC\u306A\u306E\u3067\\n\u3053\u308C\u306B\u3066\u3000\u3055\u3088\u3046\u306A\u3089[VAR 0114(0015)]"
]
