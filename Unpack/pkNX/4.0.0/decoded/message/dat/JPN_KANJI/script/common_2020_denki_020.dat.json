[
  "\u30C9\u30F3\u30CA\u30E2\u30F3\u30B8\u30E3\uFF34\uFF36\u3092\u3000\u3054{\u89A7|\u3089\u3093}\u306E{\u7686|\u307F\u306A}\u306E{\u8005|\u3082\u306E}\uFF01\\n\u304A\u306F\u3053\u3093\u30CF\u30ED\u30C1\u30E3\u30AA\uFF01\u3000\u30CA\u30F3\u30B8\u30E3\u30E2\u3067\u3059\uFF01[VAR 0114(0019)]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u306E\u30B2\u30B9\u30C8\u306F\u3000\u306A\u308A\u305F\u3066\u30DB\u30E4\u30DB\u30E4\\n{\u65B0|\u3057\u3093}\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306E\u3000[VAR 0100(0000)]{\u6C0F|\u3057}\u3060\uFF5E\uFF01[VAR 0114(0019)]",
  "[VAR 0100(0000)]{\u6C0F|\u3057}\u3063\u3066\u3070\u3000\u30B8\u30E0\u30EA{\u754C\u9688|\u304B\u3044\u308F\u3044}\u3067\u3082\\n{\u6FC0|\u3052\u304D}\u30D0\u30BA\u306A\u3000{\u8A71\u984C|\u308F\u3060\u3044}\u306E{\u4E2D\u5FC3|\u3061\u3085\u3046\u3057\u3093}\u3000\u306A\u3093\u3060\u3088\uFF5E\uFF1F[VAR 0114(0019)]",
  "{\u601D|\u304A\u3082}\u3048\u3070\u3000\u30AD\u30DF\u306E\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u3063\u3077\u308A\\n{\u8D85|\u3061\u3087\u3046}\u30D3\u30EA\u30D3\u30EA\u3063\u3068\u3000\u30AD\u30C6\u305F\u3093\u3060\u3088\u306D\u3047[VAR 0114(0019)]",
  "\u3069\u3093\u3060\u3051\u3000\u30D0\u30BA\u308B{\u52D5\u753B|\u3069\u3046\u304C}\u306B\u3000\u306A\u308B\u304B\\n{\u4ECA|\u3044\u307E}\u304B\u3089\u3000{\u6570\u5B57|\u3059\u3046\u3058}\u304C\u3000{\u697D|\u305F\u306E}\u3057\u307F\u3059\u304E\u308B\uFF5E\uFF01[VAR 0114(0019)]",
  "\u3093\u3058\u3083\u3082\u30FC\u3000{\u52D5\u753B|\u3069\u3046\u304C}\u306E{\u5F15|\u3072}\u304D\u306F\\n\u3053\u306E\u304F\u3089\u3044\u306B\u3000\u3057\u3068\u3044\u3066\u2026\u2026[VAR 0114(0019)]",
