  "\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30CA\u30F3\u30B8\u30E3\u30E2\u304C\uFF01\\n\u3081\u3063\u305F\u306B\u3000{\u898B|\u307F}\u308C\u306A\u3044\u3000{\u672C\u6C17\u51FA|\u307B\u3093\u304D\u3060}\u3057\u3066\u307F\u305F\uFF01[VAR 0114(0019)]",
  "\u3044\u3084\u3044\u3084\u3000{\u8CA0|\u307E}\u3051\u3066\u3000\u304F\u3084\u3057\u3044\\n{\u6C17\u6301|\u304D\u3082}\u3061\u3082\u3000\u3042\u308B\u3051\u3069\u3055\u3042\u2026\u2026\uFF1F[VAR 0114(0019)]",
  "{\u4ECA\u56DE|\u3053\u3093\u304B\u3044}\u306E\u3000\u30C9\u30F3\u30CA\u30E2\u30F3\u30B8\u30E3\uFF34\uFF36\\n{\u8996\u8074\u8005\u6570|\u3057\u3061\u3087\u3046\u3057\u3083\u3059\u3046}\u3000{\u7206\u4E0A|\u3070\u304F\u3042}\u304C\u308A\uFF01\\r\\n\u3042\u30FC\u3093\u3000{\u5E78|\u3057\u3042\u308F}\u305B\uFF01\u3000{\u5929|\u3066\u3093}\u306B{\u53EC|\u3081}\u3055\u308C\uFF5E\uFF01\uFF01[VAR 0114(0019)]",
  "\u3084\u3063\u3071\u3000{\u8A71\u984C|\u308F\u3060\u3044}\u306E{\u4EBA\u7269|\u3058\u3093\u3076\u3064}\u306F\\n{\u96C6\u5BA2\u529B|\u3057\u3085\u3046\u304D\u3083\u304F\u308A\u3087\u304F}\u304C\u3000{\u9055|\u3061\u304C}\u3046\u308F\uFF5E\uFF01\uFF01[VAR 0114(0019)]",
  "\u307E\u305F{\u5B9A\u671F\u7684|\u3066\u3044\u304D\u3066\u304D}\u306B\u3000\u30B3\u30E9\u30DC\u3057\u3066\u306D\uFF01\u3000\u3042\u3068\\n\u307B\u304B\u306E{\u914D\u4FE1\u8005|\u306F\u3044\u3057\u3093\u3057\u3083}\u306E\u3000{\u52D5\u753B|\u3069\u3046\u304C}\u306B\u306F\u3000{\u51FA|\u3067}\u306A\u3044\u3067\u306D\uFF01[VAR 0114(0019)]",
  "\u305D\u3093\u3058\u3083\u3082\u30FC\u3000\u30C8\u30C3\u30D7\u306B\u3000\u3088\u308D\u3057\u304F\uFF01\\n\u3044\u3044\u30AB\u30F3\u30B8\u306B\u3000{\u5831\u544A|\u307B\u3046\u3053\u304F}\u3057\u3068\u3044\u3066\uFF5E\uFF01[VAR 0114(0019)]",
