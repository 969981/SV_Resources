[
  "\u3054\u304D\u3052\u3093\u3088\u3046\\n{\u4E2D\u9593|\u3061\u3085\u3046\u304B\u3093}\u30C6\u30B9\u30C8\u3000\u304A{\u75B2|\u3064\u304B}\u308C\u3055\u307E\u3067\u3057\u305F[VAR 0114(0025)]",
  "{\u6E80\u70B9|\u307E\u3093\u3066\u3093}\u306E{\u4EBA|\u3072\u3068}\u3082\u3000\u30AE\u30EA\u30AE\u30EA\u3060\u3063\u305F{\u4EBA|\u3072\u3068}\u3082\\n\u307F\u306A\u3055\u3093\u3000\u3088\u304F\u3000\u304C\u3093\u3070\u308A\u307E\u3057\u305F\u306D[VAR 0114(0025)]",
  "\u30AF\u30E9\u30B9{\u5168\u54E1|\u305C\u3093\u3044\u3093}\u304C\u3000{\u5408\u683C|\u3054\u3046\u304B\u304F}\u3067\u304D\u3066\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3000\u3068\u3063\u3066\u3082\u3000\u3046\u308C\u3057\u3044\u3067\u3059[VAR 0114(0025)]",
  "\u3053\u308C\u306F\u3082\u3046\u3000\u307F\u306A\u3055\u3093\u3000{\u6570\u5B57|\u3059\u3046\u3058}\u3092\\n{\u597D|\u3059}\u304D\u306B\u3000\u306A\u3063\u3066\u304D\u305F\u3063\u3066\u3053\u3068\u3088\u306D[VAR 0114(0025)]",
  "{\u6B8B|\u306E\u3053}\u308A\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3082\u3000\u307F\u3093\u306A\u3067\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000\u3050\u30FC\u3093\u3068\u3000\u304C\u3093\u3070\u308A\u307E\u3057\u3087\u3046\u30FC\uFF01[VAR 0114(0025)]",
  "\u3050\u30FC\u3093\u3068\u3000\u3068\u3044\u3048\u3070\uFF01\\n\u2026\u2026\u305D\u3046\u3088\u306D\uFF01\\r\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000{\u80FD\u529B\u4E0A\u6607|\u306E\u3046\u308A\u3087\u304F\u3058\u3087\u3046\u3057\u3087\u3046}\u3088\u306D\uFF01[VAR 0114(0025)]",
  "{\u6226\u95D8\u4E2D|\u305B\u3093\u3068\u3046\u3061\u3085\u3046}\u3000\u30DD\u30B1\u30E2\u30F3\u306E{\u80FD\u529B|\u306E\u3046\u308A\u3087\u304F}\u304C\u3000{\u4E0A|\u3042}\u304C\u3063\u305F\u308A\\n{\u4E0B|\u3055}\u304C\u3063\u305F\u308A\u3059\u308B\u3053\u3068\u304C\u3000\u3042\u308B\u308F\u3088\u306D[VAR 0114(0025)]",
  "{\u4F8B|\u305F\u3068}\u3048\u3070\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\n\u3075\u308B\u3044\u305F\u3066\u308B\u3000\u3068\u3044\u3046{\u6280|\u308F\u3056}\u3092\u3000{\u4F7F|\u3064\u304B}\u3046\u3068\\r\\n{\u653B\u6483|\u3053\u3046\u3052\u304D}\u3068{\u7279\u653B|\u3068\u304F\u3053\u3046}\u304C\u3000\uFF11{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u3000{\u4E0A|\u3042}\u304C\u308A\u307E\u3059[VAR 0114(0025)]",
  "{\u653B\u6483|\u3053\u3046\u3052\u304D}\u3084{\u7279\u653B|\u3068\u304F\u3053\u3046}\u306E\u3000\u30E9\u30F3\u30AF\u304C\\n\uFF11{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u3000{\u4E0A|\u3042}\u304C\u308B\u3054\u3068\u306B\\r\\n\u30C0\u30E1\u30FC\u30B8\u306F\u3000\uFF15\uFF10\uFF05\u3000{\u4E0A\u6607|\u3058\u3087\u3046\u3057\u3087\u3046}\u3059\u308B\u306E\u3088\u306D[VAR 0114(0025)]",
  "\u3082\u3046{\u4E00\u5EA6|\u3044\u3061\u3069}\u3000\u3075\u308B\u3044\u305F\u3066\u308B\u3092\u3000{\u4F7F|\u3064\u304B}\u3046\u3068\\n\uFF12{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u3000{\u4E0A\u6607|\u3058\u3087\u3046\u3057\u3087\u3046}\u3057\u305F\u3053\u3068\u306B\u3000\u306A\u308B\u304B\u3089\\r\\n\u3082\u3068\u306E\u3000\u30C0\u30E1\u30FC\u30B8\u3088\u308A\u3000\uFF11\uFF10\uFF10\uFF05\u3000{\u4E0A|\u3042}\u304C\u3063\u3066\\r\\n\u3064\u307E\u308A\u3000\uFF12{\u56DE\u5206|\u304B\u3044\u3076\u3093}\u306E\u3000\u30C0\u30E1\u30FC\u30B8\u306B\u3000\u306A\u308A\u307E\u3059[VAR 0114(0025)]",
  "\u3064\u308B\u304E\u306E\u307E\u3044\u3000\u3068\u3044\u3046{\u6280|\u308F\u3056}\u306F\\n{\u653B\u6483|\u3053\u3046\u3052\u304D}\u30E9\u30F3\u30AF\u304C\u3000\uFF12{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u3000{\u4E0A|\u3042}\u304C\u308B\u306E\u3067\\r\\n\uFF11{\u5EA6|\u3069}\u3000{\u4F7F|\u3064\u304B}\u3048\u3070\u3000\u30C0\u30E1\u30FC\u30B8\u306F\u3000\uFF12{\u500D|\u3070\u3044}\u3088\uFF01[VAR 0114(0025)]",
  "\u3067\u306F\u3000\u3064\u308B\u304E\u306E\u307E\u3044\u3092\u3000\uFF12{\u56DE|\u304B\u3044}\u3000{\u4F7F|\u3064\u304B}\u3046\u3068\\n{\u653B\u6483|\u3053\u3046\u3052\u304D}\u30E9\u30F3\u30AF\u304C\u3000\uFF14{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u3000{\u4E0A|\u3042}\u304C\u308A\u307E\u3059\u304C\\r\\n{\u6280|\u308F\u3056}\u306E\u30C0\u30E1\u30FC\u30B8\u306F\u3000{\u4F55\u500D|\u306A\u3093\u3070\u3044}\u306B\u3000\u306A\u308B\u3067\u3057\u3087\u3046\uFF1F[VAR 0114(0025)]",
  "\uFF12{\u500D|\u3070\u3044}",
  "\uFF13{\u500D|\u3070\u3044}",
  "\uFF14{\u500D|\u3070\u3044}",
  "\u305D\u3046\u306A\u306E\u3000\u3053\u3053\u3000{\u9593\u9055|\u307E\u3061\u304C}\u3048\u3084\u3059\u3044\u308F\u3088\u306D\\n\u3075\u308B\u3044\u305F\u3066\u308B\u306A\u3089\u3000\uFF12{\u500D|\u3070\u3044}\u306E\\r\\n\u30C0\u30E1\u30FC\u30B8\u3067\u3000{\u6B63\u89E3|\u305B\u3044\u304B\u3044}\u306A\u3093\u3067\u3059\u3051\u3069\u2026\u2026[VAR 0114(0025)]",
  "\u3080\u305A\u304B\u3057\u3044\u306E\u306B\u3000\u3059\u3054\u3044\u308F\u306D\uFF01\\n\u3055\u3059\u304C\u3000[VAR 0100(0000)]\u3055\u3093\u3000\u3060\u308F\uFF01[VAR 0114(0025)]",
  "\u305D\u3046\u306A\u306E\u3000\u3053\u3053\u3000{\u9593\u9055|\u307E\u3061\u304C}\u3048\u3084\u3059\u3044\u308F\u3088\u306D\\n\uFF14{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u3000\u3060\u304B\u3089\u3068\u3044\u3063\u3066\\r\\n\uFF14{\u500D|\u3070\u3044}\u306B\u306F\u3000\u306A\u3089\u306A\u3044\u3068\u3053\u308D\u304C\u3000\u30DF\u30BD\u306A\u306E[VAR 0114(0025)]",
  "\u30E9\u30F3\u30AF\u304C\u3000\uFF11{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u3000{\u4E0A|\u3042}\u304C\u308B\u306B\u3064\u308C\u3066\\n\uFF15\uFF10\uFF05\u3000\u30C0\u30E1\u30FC\u30B8\u304C\u3000{\u5897|\u3075}\u3048\u307E\u3059\u304B\u3089[VAR 0114(0025)]",
  "\uFF14{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u3060\u3068\u3000\uFF14\u00D7\uFF15\uFF10\uFF05\u3067\\n\uFF12\uFF10\uFF10\uFF05\u3000{\u5897|\u3075}\u3048\u308B\u3053\u3068\u306B\u3000\u306A\u308A\u307E\u3059[VAR 0114(0025)]",
  "\u3082\u3068\u3082\u3068\u306E\u3000\u30C0\u30E1\u30FC\u30B8\u304C\u3000\uFF11\uFF10\uFF10\uFF05\u3067\u3059\u304B\u3089\\n\uFF12\uFF10\uFF10\uFF05\u3092\u3000\u30D7\u30E9\u30B9\u3059\u308B\u3068\u3000\uFF13\uFF10\uFF10\uFF05\u306B\u3000\u306A\u3063\u3066[VAR 0114(0025)]",
  "{\u6B21|\u3064\u304E}\u306B\u3000{\u4F7F|\u3064\u304B}\u3046{\u6280|\u308F\u3056}\u306E\u3000\u30C0\u30E1\u30FC\u30B8\u306F\\n\uFF13{\u500D|\u3070\u3044}\u3000\u3068\u3044\u3046\u3053\u3068\u306B\u3000\u306A\u308A\u307E\u3059\u306D[VAR 0114(0025)]",
  "{\u4ECA|\u3044\u307E}\u306E{\u8A08\u7B97|\u3051\u3044\u3055\u3093}\u306B\u3000\u30BF\u30A4\u30D7{\u76F8\u6027|\u3042\u3044\u3057\u3087\u3046}\u3084\\n{\u6025\u6240|\u304D\u3085\u3046\u3057\u3087}\u30C0\u30E1\u30FC\u30B8\u306E\u3000\u304B\u3051{\u7B97|\u3056\u3093}\u3082\u3000{\u5165|\u306F\u3044}\u308B\u306E\u3067\\r\\n{\u5C11|\u3059\u3053}\u3057\u306E{\u4E0A\u6607|\u3058\u3087\u3046\u3057\u3087\u3046}\u3067\u3082\u3000{\u6C17|\u304D}\u304C{\u629C|\u306C}\u3051\u307E\u305B\u3093\u3088[VAR 0114(0025)]",
  "\u3061\u306A\u307F\u306B\\n\u300E{\u80FD\u529B|\u306E\u3046\u308A\u3087\u304F}\u304C\u3000{\u4E0A|\u3042}\u304C\u3063\u305F\u300F\u306F\u3000\uFF11{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\\r\\n\u300E\u3050\u30FC\u3093\u3068\u3000{\u4E0A|\u3042}\u304C\u3063\u305F\u300F\u306F\u3000\uFF12{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\\r\\n\u300E\u3050\u3050\u30FC\u3093\u3068\u3000{\u4E0A|\u3042}\u304C\u3063\u305F\u300F\u306F\u3000\uFF13{\u6BB5\u968E|\u3060\u3093\u304B\u3044}\u306E\\r\\n{\u80FD\u529B\u4E0A\u6607|\u306E\u3046\u308A\u3087\u304F\u3058\u3087\u3046\u3057\u3087\u3046}\u3092\u3000{\u8868|\u3042\u3089\u308F}\u3057\u3066\u3044\u308B\u306E[VAR 0114(0025)]",
  "{\u6226\u95D8|\u305B\u3093\u3068\u3046}\u306E\u3068\u304D\u3060\u3051\u3000{\u4F7F|\u3064\u304B}\u3048\u308B\\n\u30D7\u30E9\u30B9\u30D1\u30EF\u30FC\u3084\u3000\u30B9\u30DA\u30B7\u30E3\u30EB\u30A2\u30C3\u30D7\u3067\u3082\\r\\n\u30E9\u30F3\u30AF\u3092\u3000\u3050\u30FC\u3093\u3068\u3000{\u4E0A|\u3042}\u3052\u3089\u308C\u307E\u3059\u304B\u3089\u306D[VAR 0114(0025)]",
  "\u3042\u3089\u3000\u30C1\u30E3\u30A4\u30E0\uFF1F\\n\u3082\u3046{\u7D42|\u304A}\u308F\u308A\u306A\u306E\u306D\u3000{\u6B8B\u5FF5|\u3056\u3093\u306D\u3093}\u2026\u2026[VAR 0114(0025)]",
  "{\u4ECA\u56DE|\u3053\u3093\u304B\u3044}\u306F\u3000\u3080\u305A\u304B\u3057\u304B\u3063\u305F\u304B\u3089\\n\u3050\u30FC\u3093\u3068\u3000{\u5FA9\u7FD2|\u3075\u304F\u3057\u3085\u3046}\u3057\u3066\u304F\u3060\u3055\u3044\u306D\\r\\n\u305D\u308C\u3067\u306F\u3000\u307E\u305F\u3000\u304A{\u4F1A|\u3042}\u3044\u3057\u307E\u3057\u3087\u3046[VAR 0114(0025)]"
]
