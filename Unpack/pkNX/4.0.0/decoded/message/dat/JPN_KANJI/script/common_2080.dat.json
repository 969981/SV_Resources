  "\u30AF\u30E9\u30D9\u30EB{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\u3000{\u8A71|\u306F\u306A}\u3057\u3042\u3063\u3066\\n{\u5927\u4F1A|\u305F\u3044\u304B\u3044}\u30EB\u30FC\u30EB\u3000{\u6C7A|\u304D}\u3081\u305F\u3093\u3060\uFF01[VAR 0114(0004)]",
