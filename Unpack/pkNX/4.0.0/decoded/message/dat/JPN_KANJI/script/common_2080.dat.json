  "\u305D\u308C\u3067\u306F\u3000{\u5927\u4F1A|\u305F\u3044\u304B\u3044}\u306E\\n\u3054{\u8AAC\u660E|\u305B\u3064\u3081\u3044}\u3092\u3000\u304A{\u9858|\u306D\u304C}\u3044\u3057\u307E\u3059\uFF01[VAR 0114(0004)]",
