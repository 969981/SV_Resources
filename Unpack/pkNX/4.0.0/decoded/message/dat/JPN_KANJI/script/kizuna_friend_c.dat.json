  "\u30A8\u30F3\u30C8\u30E9\u30F3\u30B9\u306E{\u672C\u68DA|\u307B\u3093\u3060\u306A}\u3067\\n{\u7236|\u3068\u3046}\u3061\u3083\u3093\u306E\u3000{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u30EC\u30DD\u30FC\u30C8\u3092\\r\\n\u3042\u3055\u3063\u3066\u305F\u3089\u3000\u3053\u306E{\u672C|\u307B\u3093}\u3000{\u898B|\u307F}\u3064\u3051\u3066\u3055[VAR 0114(0006)]",
  "{\u706F\u53F0|\u3068\u3046\u3060\u3044}\u306E{\u7814\u7A76\u6240|\u3051\u3093\u304D\u3085\u3046\u3058\u3087}\u306B\u3082\u3000\u3042\u3063\u305F\\n{\u6BCD|\u304B\u3042}\u3061\u3083\u3093\u306E\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u306A{\u672C|\u307B\u3093}\u2026\u2026\\r\\n\u30B9\u30AB\u30FC\u30EC\u30C3\u30C8\u30D6\u30C3\u30AF\u3000\u3060\u3063\u3051\u304B\uFF1F[VAR 0114(0006)]",
  "{\u706F\u53F0|\u3068\u3046\u3060\u3044}\u306E{\u7814\u7A76\u6240|\u3051\u3093\u304D\u3085\u3046\u3058\u3087}\u306B\u3082\u3000\u3042\u3063\u305F\\n{\u7236|\u3068\u3046}\u3061\u3083\u3093\u306E\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u306A{\u672C|\u307B\u3093}\u2026\u2026\\r\\n\u30D0\u30A4\u30AA\u30EC\u30C3\u30C8\u30D6\u30C3\u30AF\u3000\u3060\u3063\u3051\u304B\uFF1F[VAR 0114(0006)]",
  "{\u79D8\u4F1D|\u3072\u3067\u3093}\u30B9\u30D1\u30A4\u30B9\u3000{\u4EE5\u5916|\u3044\u304C\u3044}\u306E\u30DA\u30FC\u30B8\\n{\u521D|\u306F\u3058}\u3081\u3066\u3000\u3061\u3083\u3093\u3068\u3000{\u8AAD|\u3088}\u3093\u3060\u3051\u3069\u3000\u3059\u3052\u3048\u305E\uFF01[VAR 0114(0006)]",
  "\u3046\u3055\u3093\u304F\u3055\u3044\u3051\u3069\u3000\u304A\u3082\u3057\u308C\u3048\u3093\u3060\uFF01\\n{\u633F\u7D75|\u3055\u3057\u3048}\u3082\u3000\u3042\u3063\u3066\u3000{\u8AAD|\u3088}\u307F\u3084\u3059\u3044\u3057\uFF01[VAR 0114(0006)]",
