  "\u3063\u3064\u30FC\u304B\u3000\u3053\u306E{\u672C|\u307B\u3093}\u3000{\u8AAD|\u3088}\u3093\u3060\u304B\u3089\\n{\u6BCD|\u304B\u3042}\u3061\u3083\u3093\u306F\u3000{\u7814\u7A76\u8005|\u3051\u3093\u304D\u3085\u3046\u3057\u3083}\u306B\u3000\u306A\u3063\u305F\u306E\u304B\u3082[VAR 0114(0006)]",
  "\u3063\u3064\u30FC\u304B\u3000\u3053\u306E{\u672C|\u307B\u3093}\u3000{\u8AAD|\u3088}\u3093\u3060\u304B\u3089\\n{\u7236|\u3068\u3046}\u3061\u3083\u3093\u306F\u3000{\u7814\u7A76\u8005|\u3051\u3093\u304D\u3085\u3046\u3057\u3083}\u306B\u3000\u306A\u3063\u305F\u306E\u304B\u3082[VAR 0114(0006)]",
