[
  "\u3069\u304A\u3082\u3000\u3069\u304A\u3082\\n{\u751F\u7269\u62C5\u5F53|\u305B\u3044\u3076\u3064\u305F\u3093\u3068\u3046}\u306E\u3000\u30B8\u30CB\u30A2\u3067\u3059[VAR 0114(002A)]",
  "\u307C\u304F\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3067\u306F\u3000\u307F\u306A\u3055\u3093\u3068\\n{\u5927\u597D|\u3060\u3044\u3059}\u304D\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3064\u3044\u3066\\r\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u3066\u3044\u304D\u307E\u3057\u3087\u3046[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3\u306E\u3053\u3068\u3000\u305F\u304F\u3055\u3093\\n{\u597D|\u3059}\u304D\u306B\u306A\u3063\u3066\u3082\u3089\u3048\u308B\u3068\u3000\u3046\u308C\u3057\u3044\u306A\u3042[VAR 0114(002A)]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u306E\u3053\u3068\u3000\u3082\u3063\u3068{\u6DF1|\u3075\u304B}\u304F\\n{\u77E5|\u3057}\u308C\u308B{\u65B9\u6CD5|\u307B\u3046\u307B\u3046}\u3092\u3000{\u6559|\u304A\u3057}\u3048\u3061\u3083\u3044\u307E\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u307F\u306A\u3055\u3093\u304C\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u306E\u30DD\u30B1\u30E2\u30F3\u3068\\n\u3082\u3063\u3068\u3000\u306A\u304B\u3088\u3057\u3055\u3093\u306B\u3000\u306A\u308A\u305F\u304B\u3063\u305F\u3089\u2026\u2026[VAR 0114(002A)]",
  "\u30DC\u30FC\u30EB\u304B\u3089\u3000{\u51FA|\u3060}\u3057\u3066\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u6B69|\u3042\u308B}\u3044\u3066\u307F\u307E\u3057\u3087\u3046\u304B\u3042[VAR 0114(002A)]",
  "\u3042\u3044\u3053\u3068\u3070\u306F\u3000\u300E\u30DC\u30FC\u30EB{\u6295|\u306A}\u3052\u3000[VAR FF00(0006)]\uFF3A\uFF32\u30DC\u30BF\u30F3[VAR FF00(0000)]\uFF01\u300F\\c\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u5F8C|\u3046\u3057}\u308D\u304B\u3089\u3000\u3064\u3044\u3066{\u6765|\u304D}\u3066\\n\u3068\u3063\u3066\u3082\u3000\u304B\u308F\u3044\u3044\u3093\u3067\u3059[VAR 0114(002A)]",
  "\u3064\u3044\u3066{\u6765|\u304F}\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u8A71|\u306F\u306A}\u3057\u304B\u3051\u308B\u3068\\n{\u53CD\u5FDC|\u306F\u3093\u306E\u3046}\u3057\u3066\u304F\u308C\u308B\u306E\u3067\u3000{\u8A66|\u305F\u3081}\u3057\u3066\u304F\u3060\u3055\u3042\u3044\\r\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3053\u3068\u3000\u3082\u3063\u3068\u3000{\u77E5|\u3057}\u308C\u308B\u304B\u3082\uFF1F[VAR 0114(002A)]",
  "\u2026\u2026\u305F\u3060\u3057\uFF01\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\n\u3064\u308C{\u6B69|\u3042\u308B}\u3044\u3061\u3083\u3000\u30C0\u30E1\u306A{\u5834\u6240|\u3070\u3057\u3087}\u3082\u3000\u3042\u308A\u307E\u3059\\r\\n\u3069\u306A\u305F\u304B\u3000\u308F\u304B\u308A\u307E\u3059\u304B\u306D\u3048\uFF1F[VAR 0114(002A)]",
  "{\u6C34\u8FBA|\u307F\u305A\u3079}",
  "{\u90E8\u5C4B|\u3078\u3084}\u306E{\u4E2D|\u306A\u304B}",
  "{\u8349|\u304F\u3055}\u3080\u3089",
  "{\u6C34|\u307F\u305A}\u304C\u3000{\u82E6\u624B|\u306B\u304C\u3066}\u306A\u3000\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u3044\u307E\u3059\u304C\\n\u30DD\u30B1\u30E2\u30F3{\u7528|\u3088\u3046}\u306E\u30DC\u30FC\u30C8\u3082\u3000\u3042\u308A\u307E\u3059\u306E\u3067\\r\\n\u3069\u3093\u3069\u3093\u3000\u3064\u308C{\u6B69|\u3042\u308B}\u3044\u3061\u3083\u3063\u3066\u304F\u3060\u3055\u3042\u3044[VAR 0114(002A)]",
  "\u308F\u3042\u3000\u3042\u305F\u308A\u3067\u3059\uFF01\\n[VAR 0100(0000)]\u3055\u3093\u3000{\u4E88\u7FD2|\u3088\u3057\u3085\u3046}\u3000\u30D0\u30C3\u30C1\u30EA\u3067\u3059[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3\u306F\u3000{\u8349|\u304F\u3055}\u3080\u3089\u304C\u3000{\u5927\u597D|\u3060\u3044\u3059}\u304D\uFF01\\n\u3080\u3057\u308D\u3000{\u6B69|\u3042\u308B}\u3044\u3061\u3083\u3063\u3066\u3000{\u5E73\u6C17|\u3078\u3044\u304D}\u306A\u3093\u3067\u3059[VAR 0114(002A)]",
  "\u3064\u308C{\u6B69|\u3042\u308B}\u304D\u304C\u3000\u30C0\u30E1\u306A{\u5834\u6240|\u3070\u3057\u3087}\u306F\\n\u306A\u3093\u3068\u3000{\u90E8\u5C4B|\u3078\u3084}\u306E{\u4E2D|\u306A\u304B}\u3000\u306A\u3093\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3\u306B\u3088\u3063\u3066\u306F\u3000{\u6B69|\u3042\u308B}\u304D{\u56DE|\u307E\u308F}\u308B\u3068\\n{\u58C1|\u304B\u3079}\u3084{\u673A|\u3064\u304F\u3048}\u306A\u3069\u3000{\u58CA|\u3053\u308F}\u3057\u3061\u3083\u3046\u306E\u3067\\r\\n\u3069\u3093\u306A\u30DD\u30B1\u30E2\u30F3\u3067\u3082\u3000{\u7981\u6B62|\u304D\u3093\u3057}\u3057\u3066\u308B\u3093\u3067\u3059[VAR 0114(002A)]",
  "\u306A\u306E\u3067\u3000\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u51FA|\u3060}\u3059\u306E\u306F\\n{\u57FA\u672C|\u304D\u307B\u3093}\u3000\u304A{\u5916|\u305D\u3068}\u3067\u3000\u304A{\u9858|\u306D\u304C}\u3044\u3057\u307E\u3059\u306D\u3048\\r\\n\u305F\u307E\u306B\u3000{\u6559\u5BA4\u5185|\u304D\u3087\u3046\u3057\u3064\u306A\u3044}\u3067\u3082\u3000{\u898B|\u307F}\u304B\u3051\u307E\u3059\u304C\u2026\u2026[VAR 0114(002A)]",
  "{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u6B69|\u3042\u308B}\u3044\u3066\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3059\u308B\u3068\\n\u3082\u30FC\u3063\u3068\u3000\u306A\u304B\u3088\u3057\u3055\u3093\u306B\u3000\u306A\u308C\u307E\u3059[VAR 0114(002A)]",
  "\u3042\uFF01\u3000\u3064\u308C{\u6B69|\u3042\u308B}\u3051\u308B\u306E\u306F\\n{\u5148\u982D|\u305B\u3093\u3068\u3046}\u306E\u30DD\u30B1\u30E2\u30F3\u3000\u3067\u3059\u304B\u3089\u306D\u3048[VAR 0114(002A)]",
  "\u3042\u3044\u3053\u3068\u3070\u306F\u3000\u300E\u30DC\u30FC\u30EB{\u6295|\u306A}\u3052\u3000[VAR FF00(0006)]\uFF3A\uFF32\u30DC\u30BF\u30F3[VAR FF00(0000)]\uFF01\u300F\\n{\u91CE\u751F|\u3084\u305B\u3044}\u306E\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u6295|\u306A}\u3052\u308B\u3068\\r\\n\u305D\u306E\u307E\u307E\u3000{\u6226\u95D8|\u305B\u3093\u3068\u3046}\u306B\u3000\u306A\u308A\u307E\u3059\u3088[VAR 0114(002A)]",
  "\u305D\u308C\u3058\u3083\u3042\u3000{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u3053\u3053\u307E\u3067\\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3042[VAR 0114(002A)]"
]
