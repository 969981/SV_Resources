  "{\u601D|\u304A\u3082}\u3044{\u51FA|\u3060}\u3059\u308F\uFF5E\u3000[VAR 0100(0000)]\u3055\u3093\u306E\\n\u30AA\u30EA\u30FC\u30D6\u3000\u3053\u308D\u304C\u3057\u3063\u3077\u308A[VAR 0114(0016)]",
  "\u307E\u308B\u3067\u3000\u304B\u304F\u3068\u3046\u30BF\u30A4\u30D7\u306B\\n\u30C6\u30E9\u30B9\u30BF\u30EB\u3057\u305F\u3088\u3046\u306A\u3000{\u52E2|\u3044\u304D\u304A}\u3044\u3060\u3063\u305F\u3082\u306E\uFF5E[VAR 0114(0016)]",
  "[VAR 0100(0000)]\u3055\u3093\u306B\u3068\u3063\u3066\u3000\u3046\u3061\u306F\\n{\u4F55\u56DE\u76EE|\u306A\u3093\u304B\u3044\u3081}\u306E\u30B8\u30E0\u3000\u3060\u3063\u305F\u3093\u3067\u3057\u3087\u3046\uFF5E\uFF1F[VAR 0114(0016)]",
  "\u30BB\u30EB\u30AF\u30EB\u30B8\u30E0\u306F\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u304B\u3089\u3000{\u8FD1|\u3061\u304B}\u3044\u306E\u3067\\n{\u6700\u521D|\u3055\u3044\u3057\u3087}\u306E\u30B8\u30E0\u306B\u3000{\u9078|\u3048\u3089}\u3093\u3067\u304F\u308C\u308B\\r\\n\u30C8\u30EC\u30FC\u30CA\u30FC\u3055\u3093\u3000{\u591A|\u304A\u304A}\u3044\u3093\u3067\u3059\u3088\uFF5E[VAR 0114(0016)]",
