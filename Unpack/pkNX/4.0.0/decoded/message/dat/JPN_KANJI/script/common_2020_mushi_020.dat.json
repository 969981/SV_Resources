  "\u3067\u3082\u3000\u3080\u3057\u3061\u3083\u3093\u305F\u3061\\n{\u8CA0|\u307E}\u3051\u3066\u3070\u304B\u308A\u3060\u3068\u3000\u304B\u308F\u3044\u305D\u3046\u2026\u2026[VAR 0114(0016)]",
  "\u3046\u3075\u3075\u3000\u3053\u3046\u3044\u3063\u305F{\u6A5F\u4F1A|\u304D\u304B\u3044}\u3060\u3068\\n{\u672C\u6C17\u51FA|\u307B\u3093\u304D\u3060}\u305B\u308B\u304B\u3089\u3000{\u9AD8|\u305F\u304B}\u307E\u3063\u3061\u3083\u3046\u308F\uFF5E[VAR 0114(0016)]",
  "{\u5B8C\u819A|\u304B\u3093\u3077}\u306A\u304D\u307E\u3067\u306B\\n\u3072\u306D\u3063\u3066\u3055\u3057\u3042\u3052\u307E\u3059\u306D\uFF5E\uFF01[VAR 0114(0016)]",
