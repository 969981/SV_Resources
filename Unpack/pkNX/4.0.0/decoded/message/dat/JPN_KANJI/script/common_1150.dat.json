[
  "[~ 16]",
  "\u30BC\u30ED\u30E9\u30DC\u306E\\n\u30B2\u30FC\u30C8\u3092\u3000{\u958B|\u3072\u3089}\u304D\u307E\u3059\u304B\uFF1F",
  "[VAR 0100(0000)]\u306F\\n\u30BC\u30ED\u30E9\u30DC\u306E\u3000\u30B2\u30FC\u30C8\u3092\u2026\u2026",
  "\u3061\u3087\u3063\u3068\u3000{\u5F85|\u307E}\u3063\u305F\u30FC\uFF01[VAR 0114(0006)]",
  "\u3048\u30FC\u3000{\u4F55|\u306A\u306B}\uFF1F\\n\u3044\u3088\u3044\u3088\u3063\u3066\u3068\u304D\u306B\u2026\u2026[VAR 0114(0004)]",
  "\u30E4\u30D0\u3044\u3000\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u51FA|\u3067}\u3066\u304F\u308B\u306A\u3089\\n[VAR 0101(0001)]\u3082\u3000\u3044\u305F\u307B\u3046\u304C\\r\\n\u3044\u3044\u3093\u3058\u3083\u306D\u3048\u304B\uFF1F[VAR 0114(0006)]",
  "\u305F\u3057\u304B\u306B\u3000{\u5165|\u3044}\u308A{\u6C5F|\u3048}\u306E\u307B\u3089{\u7A74|\u3042\u306A}\u3067\u306E\\n[VAR 0101(0001)]\u306A\u3089\u3000{\u5FC3\u5F37|\u3053\u3053\u308D\u3065\u3088}\u3044\uFF01\\r\\n\u3042\u306E{\u6226|\u305F\u305F\u304B}\u3044\u3063\u3077\u308A\u3000{\u898B|\u307F}\u305F\u3044\uFF01[VAR 0114(0004)]",
  "\u3048\u30FC\u3000\u3067\u3082\u2026\u2026\\n\u30A8\u30EA\u30A2\u30BC\u30ED\u3000{\u6765|\u304D}\u3066\u304B\u3089\\r\\n\u30E9\u30A4\u30C9\u3059\u308B\u3093\u3082\u3000{\u5ACC|\u3044\u3084}\u304C\u3063\u3066\u308B\u3057\u2026\u2026\\r\\n\u3063\u3066\u304B\u3000\u30D0\u30C8\u30EB\u30D5\u30A9\u30EB\u30E0\u306B\u3000\u306A\u308C\u3093\u306E\u3067\u3057\u3087\uFF1F[VAR 0114(0008)]",
  "\u30A2\u30A4\u30C4\u306F\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306F\u3000{\u5F37|\u3064\u3088}\u3044\u3093\u3060\\c\\n{\u79D8\u4F1D|\u3072\u3067\u3093}\u30B9\u30D1\u30A4\u30B9\u3000{\u98DF|\u304F}\u3063\u3066\u305F\u3057\\n\u3053\u3053\u305E\u3063\u3066\u3068\u304D\u306F\u3000{\u6226|\u305F\u305F\u304B}\u3046\u3060\u308D\uFF01[VAR 0114(0006)]",
  "\u305D\u308C\u306B\u3000\u30A8\u30EA\u30A2\u30BC\u30ED\u306F\u3000\u30A2\u30A4\u30C4\u304C\\n\u3057\u3070\u3089\u304F\u3000{\u66AE|\u304F}\u3089\u3057\u3066\u305F{\u5834\u6240|\u3070\u3057\u3087}\u3000\u3060\u3057\u2026\u2026\\c\\n\u30DC\u30FC\u30EB\u304B\u3089\u3000{\u51FA|\u3060}\u3057\u3068\u3051\u3070\\n{\u5BB6\u65CF|\u304B\u305E\u304F}\u3082\u3000{\u898B|\u307F}\u3064\u3051\u3066\u304F\u308C\u308B\u304B\u3082\u3060\u305C\uFF1F[VAR 0114(0006)]",
  "\u30DA\u30D1\u30FC\u306B\u3057\u3066\u306F\u3000{\u4E00\u7406|\u3044\u3061\u308A}\u3042\u308B\u3088\u306D\uFF01[VAR 0114(0004)]",
  "\u3046\u3046\u30FC\u3093\\n\u305D\u3046\u306A\u3093\u304B\u306A\u3041\u2026\u2026[VAR 0114(0008)]",
  "[VAR 0100(0000)]\uFF01\\n[VAR 0101(0001)]\u3000{\u51FA|\u3060}\u3057\u3061\u3083\u3048\uFF01[VAR 0114(0004)]",
  "{\u5927\u4E08\u592B|\u3060\u3044\u3058\u3087\u3046\u3076}\u3060\u3063\u3066\uFF01\\n[VAR 0101(0001)]\u304C\u3000{\u6226|\u305F\u305F\u304B}\u3048\u306A\u304F\u3063\u3066\u3082\\r\\n\u308F\u305F\u3057\u304C\u3000{\u5B88|\u307E\u3082}\u308B\u304B\u3089\uFF01\u3000\u306D\uFF01[VAR 0114(0004)]",
  "\u30A2\u30AE\u30E3\u2026\u2026\uFF1F",
  "\u304A\u3063\u3057\u3083\uFF01\u3000[VAR 0100(0000)]\uFF01\\n[VAR 0101(0001)]\u30DC\u30FC\u30EB\u306B\u3000{\u7D9A|\u3064\u3065}\u3044\u3066\\r\\n\u30E9\u30DC\u306E\u30B2\u30FC\u30C8\u3082\u3000\u30AA\u30FC\u30D7\u30F3\u3060\uFF01[VAR 0114(0006)]"
]
