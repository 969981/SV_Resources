[
  "{\u7802\u6F20|\u3055\u3070\u304F}\u3092\u3000\u30E2\u30C8\u30C8\u30AB\u30B2\u3068\\n{\u79FB\u52D5|\u3044\u3069\u3046}\u3057\u3066\u304D\u3066\u3000{\u75B2|\u3064\u304B}\u308C\u305F\u30FC\uFF01\\c\\n{\u4EBA\u9593|\u306B\u3093\u3052\u3093}\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\\n\u3061\u3083\u3093\u3068\u3000{\u4F11|\u3084\u3059}\u307E\u306A\u3044\u3068\u306D",
  "\u3053\u3053\u306F\u3000\u30DE\u30EA\u30CA\u30FC\u30C9\u30BF\u30A6\u30F3\\n{\u540D\u7269|\u3081\u3044\u3076\u3064}\u306E{\u5E02\u5834|\u3044\u3061\u3070}\u306F\u3000{\u5927\u8CD1|\u304A\u304A\u306B\u304E}\u308F\u3044\u3055\uFF01",
  "\u3055\u3042\u3055\u3042\u3000{\u5BC4|\u3088}\u3063\u3068\u3044\u3067\uFF01\\n{\u65B0\u9BAE|\u3057\u3093\u305B\u3093}\u306A{\u5546\u54C1|\u3057\u3087\u3046\u3072\u3093}\u304C\u3000\u3044\u3063\u3071\u3044\u3060\u3088\uFF01",
  "\u30DE\u30EA\u30CA\u30FC\u30C9\u3068\u306F\u3000{\u8089|\u306B\u304F}\u3084{\u9B5A|\u3055\u304B\u306A}\u3092\\n\u30EC\u30E2\u30F3{\u6C41|\u3058\u308B}\u3084{\u9162|\u3059}\u306B\u3000{\u6F2C|\u3064}\u3051\u308B\u3000{\u8ABF\u7406\u6CD5|\u3061\u3087\u3046\u308A\u307B\u3046}\u3060\u3088\uFF01",
  "\u3053\u306E\u307E\u3061\u306E\u3000\u305F\u3079\u3082\u306E\u306F\\n\u3068\u3063\u3066\u3082\u3000\u304A\u3044\u3057\u3044\u306E\uFF01\\c\\n\u305D\u3056\u3044\u304C\u3000\u3057\u3093\u305B\u3093\u3067\u3000\u30D4\u30C1\u30D4\u30C1\uFF01\\n\u307E\u308B\u3067\u3000\u308F\u305F\u3057\u307F\u305F\u3044\u30FC\uFF01",
  "{\u5E02\u5834|\u3044\u3061\u3070}\u306E{\u4E2D|\u306A\u304B}\u306B\u306F\\n\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u304C\u3000\u3042\u308B\u306E\uFF01\\c\\n\u3053\u3053\u3067\u306E\u3000\u30B1\u30F3\u30AB\u306F\u3000\u3054{\u6CD5\u5EA6|\u306F\u3063\u3068}\uFF01\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3067\u3000{\u6C7A|\u304D}\u3081\u308B\u306E\u3088",
  "\u307C\u304F\u304C\u3000{\u751F|\u3046}\u307E\u308C\u308B{\u524D|\u307E\u3048}\u3000{\u5E02\u5834|\u3044\u3061\u3070}\u306F\\n\u30B1\u30F3\u30AB\u304C\u3000{\u7D76|\u305F}\u3048\u306A\u304B\u3063\u305F\u307F\u305F\u3044\uFF01\\c\\n{\u4ECA|\u3044\u307E}\u306F\u3000{\u89B3\u5149\u5BA2|\u304B\u3093\u3053\u3046\u304D\u3083\u304F}\u3082\u3000{\u5897|\u3075}\u3048\u305F\u3057\\n{\u5B50\u4F9B|\u3053\u3069\u3082}\u3067\u3082\u3000{\u5B89\u5FC3|\u3042\u3093\u3057\u3093}\u3057\u3066\u3000{\u5165|\u306F\u3044}\u308C\u308B\u3088",
  "{\u5B66\u751F|\u304C\u304F\u305B\u3044}\u3055\u3093\u3082\\n{\u7AF6|\u305B}\u308A\u3000\u3084\u3093\u306E\u304B\u3044\uFF1F\\c\\n{\u5024\u6BB5|\u306D\u3060\u3093}\u3000\u3064\u308A\u3042\u3052\u3059\u304E\u3066\u3000\u30B9\u30AB\u30F3\u30D4\u30F3\u306B\\n\u306A\u3089\u306D\u3048\u3088\u3046\u3000{\u6C17|\u304D}\u3043\u3064\u3051\u306A\u3088\uFF01",
  "{\u753A|\u307E\u3061}\u306E{\u4E0A|\u3046\u3048}\u306B\u306F\u3000{\u591C|\u3088\u308B}\u306B\u306A\u308B\u3068\\n\u30B4\u30FC\u30B9\u30C8\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3084\u3063\u3066\u304F\u308B\u306E\\r\\n\u2026\u2026{\u4F55\u6545|\u306A\u305C}\u304B\u3057\u3089\u306D\uFF1F",
  "{\u6D77|\u3046\u307F}\u304B\u3089\u3000{\u6D41|\u306A\u304C}\u308C\u3066\u304F\u308B\u3000{\u6F6E\u98A8|\u3057\u304A\u304B\u305C}\u304C\\n\u3068\u3063\u3066\u3082\u3000{\u6C17\u6301|\u304D\u3082}\u3061\u3044\u3044\u30FC\uFF01\\c\\n\u306F\u304C\u306D\u30BF\u30A4\u30D7\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u306F\\n\u3057\u304A\u3065\u3051\u306B\u3000\u3055\u308C\u3066\u3000\u30A4\u30E4\u3060\u3063\u305F\u308A\uFF1F",
  "\u30E9\u30A4\u30C9\u30DD\u30B1\u30E2\u30F3\u306F\u3000\u305F\u3088\u308A\u306B\u306A\u308B\uFF01\\c\\n\u305F\u307E\u306B\u306F\u3000{\u9006|\u304E\u3083\u304F}\u306B\u3000\u30AA\u30EC\u304C\\n\u304A\u3093\u3076\u3057\u3066\u3084\u308B\u304B\u306A\uFF01\u3000\u30AC\u30C3\u30CF\u30C3\u30CF\uFF01",
  "\u307E\u305F\u3000\u30C0\u30A4\u30EC\u30AF\u30C8\u30E1\u30FC\u30EB\uFF01\\c\\n{\u4E38|\u307E\u308B}\u3081\u3066\u3000\u30DC\u30FC\u30EB\u306B\u3057\u3066\\n\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u904A|\u3042\u305D}\u3076\u304B\u2026\u2026",
  "\u3053\u306E{\u56DB\u89D2|\u3057\u304B\u304F}\u3044\u306E\u306F\u3000\u30B3\u30F3\u30C6\u30CA\u3060\u3088\\c\\n\u305F\u304F\u3055\u3093\u306E{\u8377\u7269|\u306B\u3082\u3064}\u3092\u3000\u3064\u3081\u3066\\n{\u6D77|\u3046\u307F}\u306E{\u5411|\u3080}\u3053\u3046\u3078\u3000{\u904B|\u306F\u3053}\u3076\u3093\u3060",
  "{\u9060|\u3068\u304A}\u304F\u306E{\u5730\u65B9|\u3061\u307B\u3046}\u3078\u306F\u3000{\u8239|\u3075\u306D}\u3067{\u884C|\u3044}\u304F\uFF01\\n\u30E9\u30A4\u30C9\u30DD\u30B1\u30E2\u30F3\u3060\u3068\u3000{\u75B2|\u3064\u304B}\u308C\u3061\u3083\u3046\u304B\u3089\u306D",
  "{\u5411|\u3080}\u3053\u3046\u306E{\u5CA9\u5834|\u3044\u308F\u3070}\u307E\u3067\u3000{\u6CF3|\u304A\u3088}\u3044\u3060\u3068\u304D\\n{\u5CA9\u5834|\u3044\u308F\u3070}\u306E{\u4E0A|\u3046\u3048}\u306B\u3000{\u4F55|\u306A\u306B}\u304B\u3000\u3042\u3063\u305F\u3088\u3046\u306A\u2026\u2026\uFF01\\c\\n{\u5D16|\u304C\u3051}\u3092\u3000\u306E\u307C\u308C\u306A\u3044\u3068\\n\u3068\u308C\u306A\u3055\u305D\u3046\u3060\u3063\u305F\u304C\u2026\u2026",
  "\u308F\u3042\u3044\u3000{\u9854|\u304B\u304A}\u30CF\u30E1{\u770B\u677F|\u304B\u3093\u3070\u3093}\u3067\\n{\u697D|\u305F\u306E}\u3057\u3044{\u5199\u771F|\u3057\u3083\u3057\u3093}\u304C\u3000{\u64AE|\u3068}\u308C\u308B\u3088\uFF01",
  "\u306D\u3048\u3000\u30CA\u30DF\u30A4\u30EB\u30AB\u306F\u3000\u308F\u304B\u308B\u3051\u3069\\n\u30DE\u30C3\u30C1\u30E7\u306A\u307B\u3046\u306F\u3000{\u4F55|\u306A\u306B}\u2026\u2026\uFF1F\\r\\n\u3042\u3093\u306A\u30DD\u30B1\u30E2\u30F3\u3000\u3044\u308B\u2026\u2026\uFF1F",
  "{\u6D77|\u3046\u307F}\u306E{\u4E0A|\u3046\u3048}\u3092\u3000\u30BF\u30A4\u30AB\u30A4\u30C7\u30F3\u304C\\n{\u98DB|\u3068}\u3093\u3067\u308B{\u59FF|\u3059\u304C\u305F}\u3000{\u6620|\u3070}\u3048\u308B\u308F\uFF5E\\c\\n\u3042\u306E{\u5B50|\u3053}\u305F\u3061\u3000{\u753A|\u307E\u3061}\u306E{\u88CF|\u3046\u3089}\u306E\\n\u30D3\u30FC\u30C1\u3067\u3000\u305F\u307E\u306B\u3000{\u4F11|\u3084\u3059}\u3093\u3067\u308B\u308F\u3088",
  "\u30AB\u30E9\u30D5\u30B7\u30C6\u30A3\u306E\\n\u30CF\u30A4\u30C0\u30A4{\u5036\u697D\u90E8|\u304F\u3089\u3076}\u3000{\u98DF|\u305F}\u3079\u306B\u3044\u3063\u305F\uFF1F\\c\\n\u30DE\u30EA\u30CA\u30FC\u30C9\u306E\u3000{\u65B0\u9BAE|\u3057\u3093\u305B\u3093}\u306A\\n{\u98DF\u6750|\u3057\u3087\u304F\u3056\u3044}\u3092\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u308B\u3093\u3067\u3059\u3063\u3066\uFF01",
  "\u305F\u307E\u306B\u3000\u30AB\u30E9\u30D5\u30B8\u30E0\u306E\\n\u30CF\u30A4\u30C0\u30A4\u3055\u3093\u304C\u3000{\u5E02\u5834|\u3044\u3061\u3070}\u306B\u3000{\u6765|\u304F}\u308B\u305C\uFF01\\c\\n\u3042\u306E{\u4EBA|\u3072\u3068}\u3000{\u7AF6|\u305B}\u308A\u3067\u3000{\u52DD|\u304B}\u3064\u3068\\n\u3046\u308C\u3057\u304F\u3066\u3000{\u8E0A|\u304A\u3069}\u308A\u3060\u3059\u3093\u3060",
  "\u30AA\u30A4\u30E9\u3082\u3000{\u82E5|\u308F\u304B}\u3044\u3053\u308D\u306F\\n{\u7AF6|\u305B}\u308A\u306B\u3000\u30B1\u30F3\u30AB\u306B\\r\\n\u3044\u308D\u3044\u308D\u3000\u3084\u3093\u3061\u3083\u3057\u305F\u3082\u3093\u3088",
  "\u3044\u3044\u30D3\u30FC\u30C1\u306A\u306E\u306B\u3000{\u7A74\u5834|\u3042\u306A\u3070}\u306A\u306E\uFF01\\n\u307F\u3093\u306A\u3000{\u5E02\u5834|\u3044\u3061\u3070}\u306B\u3000{\u5922\u4E2D|\u3080\u3061\u3085\u3046}\u306A\u306E\u306D"
]
