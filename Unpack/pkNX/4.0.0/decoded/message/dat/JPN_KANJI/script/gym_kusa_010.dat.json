[
  "\u3088\u3046\u3053\u305D\u3000\u30DC\u30A6\u30EB\u30B8\u30E0\u3078\uFF01",
  "{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}{\u8005|\u3057\u3083}\u306E\\n\u304A{\u540D\u524D|\u306A\u307E\u3048}\u3092\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3057\u307E\u3059\u2026\u2026\\r\\n[VAR 0100(0000)]\u3055\u3093\u3000\u3067\u3059\u306D\uFF01",
  "{\u5F53|\u3068\u3046}\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30B3\u30EB\u30B5\u3068\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308B\u306B\u306F\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u3092\\r\\n\u30AF\u30EA\u30A2\u3059\u308B{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u304C\u3000\u3042\u308A\u307E\u3059",
  "\u30DC\u30A6\u30EB\u30B8\u30E0\u306E\u3000\u30B8\u30E0\u30C6\u30B9\u30C8\u306F\u2026\u2026\\n[VAR FF00(0006)]\u30AD\u30DE\u30EF\u30EA{\u96C6|\u3042\u3064}\u3081\u3000[VAR FF00(0000)]\u3067\u3059\uFF01",
  "\u30DC\u30A6\u30EB\u306F\u3000{\u82B8\u8853|\u3052\u3044\u3058\u3085\u3064}\u306E{\u753A|\u307E\u3061}\u2026\u2026\\c\\n{\u4F5C\u54C1|\u3055\u304F\u3072\u3093}\u306E\u3000\u30E2\u30C1\u30FC\u30D5\u3068\u306A\u308B\u3000\u300E{\u81EA\u7136|\u3057\u305C\u3093}\u300F\u3084\\n{\u81EA\u7136|\u3057\u305C\u3093}\u3092{\u80B2|\u306F\u3050\u304F}\u3080\u3000\u300E{\u592A\u967D|\u305F\u3044\u3088\u3046}\u300F\u306B\u3000{\u611F\u8B1D|\u304B\u3093\u3057\u3083}\u3057\u3066\u304A\u308A\\c\\n\u3069\u3061\u3089\u306E{\u8981\u7D20|\u3088\u3046\u305D}\u3082\u3000{\u6301|\u3082}\u3063\u3066\u3044\u308B\u3000\u30AD\u30DE\u30EF\u30EA\u3092\\n{\u96C6|\u3042\u3064}\u3081\u3066\u3000\u3082\u3066\u306A\u3059{\u98A8\u7FD2|\u3075\u3046\u3057\u3085\u3046}\u304C\u3000\u3042\u308B\u306E\u3067\u3059",
  "[VAR 0100(0000)]\u3055\u3093\u306B\u306F\u3000\u30DC\u30A6\u30EB\u30BF\u30A6\u30F3\u3067\\n{\u592A\u967D|\u305F\u3044\u3088\u3046}\u306E\u3088\u3046\u306A\u3000\u304A{\u82B1|\u306F\u306A}\u306E\u30DD\u30B1\u30E2\u30F3\\r\\n\u30AD\u30DE\u30EF\u30EA\u3092\u3000{\u898B|\u307F}\u3064\u3051\u3066\u3044\u305F\u3060\u304D",
  "[VAR 0201(0001)]{\u5339|\u3074\u304D}\u3000{\u96C6|\u3042\u3064}\u3081\u3066\\n\u30AD\u30DE\u30EF\u30EA{\u5E83\u5834|\u3072\u308D\u3070}\u3078\u3068\u3000\u3064\u308C\u3066\u3044\u3051\u3070\\r\\n\u30B8\u30E0\u30C6\u30B9\u30C8\u3000\u30AF\u30EA\u30A2\u3068\u3000\u306A\u308A\u307E\u3059\uFF01",
  "\u307E\u305A\u306F\u3000\u30AD\u30DE\u30EF\u30EA{\u5E83\u5834|\u3072\u308D\u3070}\u306E\u3000{\u5834\u6240|\u3070\u3057\u3087}\u3092\\n\u30DE\u30C3\u30D7\u306B\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3057\u307E\u3059\u306E\u3067\\c\\n\u305D\u3053\u306B\u3044\u308B\u3000\u30B9\u30BF\u30C3\u30D5\u304B\u3089\\n{\u8A71|\u306F\u306A\u3057}\u3092\u3000{\u805E|\u304D}\u3044\u3066\u307F\u3066\u304F\u3060\u3055\u3044\u306D\\c\\n\u30B8\u30E0\u3092\u3000{\u51FA|\u3067}\u3066\u3000\u3059\u3050{\u53F3|\u307F\u304E}\uFF01\u3000{\u5927|\u304A\u304A}\u304D\u306A\\n\u30AD\u30DE\u30EF\u30EA\u306E\u30AA\u30D6\u30B8\u30A7\u304C\u3000{\u76EE|\u3081}\u3058\u308B\u3057\u3067\u3059\uFF01",
  "\u305D\u308C\u3067\u306F\u3000\u3044\u3063\u3066\u3089\u3063\u3057\u3083\u3044\uFF01"
]
