[
  "\u30AA\u30FC\u30C3\u30DB\u30C3\u30DB\u30C3\u30DB\uFF01\\n\u30AA\u30FC\u30C3\u30DB\u30C3\u30DB\u30C3\u30DB\uFF01[VAR 0114(0041)]",
  "{\u898B|\u307F}\u3066\u3000\u30D3\u30EA\u30AA\uFF01\\n{\u6C34|\u307F\u305A}\u305F\u307E\u308A\u304C\u3000\u3042\u308B\u30B6\u30DE\u30B9[VAR 0114(0041)]",
  "\u30CD\u30A2\u3061\u3083\u3093\u3000\u3053\u308C\u3000{\u6E56|\u307F\u305A\u3046\u307F}\u3060\u3088\uFF01\\n\u30D1\u30EB\u30C7\u30A2\u3067\u3000{\u4E00\u756A\u5927|\u3044\u3061\u3070\u3093\u304A\u304A}\u304D\u3044\uFF01\\r\\n{\u6709\u540D|\u3086\u3046\u3081\u3044}\u306A\u3000\u30AA\u30FC\u30B8\u30E3\u306E{\u6E56|\u307F\u305A\u3046\u307F}\u3055\uFF01[VAR 0114(0040)]",
  "\u3053\u3000\u3053\u308C\u304C\u3000{\u6E56|\u307F\u305A\u3046\u307F}\uFF01\uFF1F\\n{\u767E\u6B69|\u3072\u3083\u3063\u307D}\u3086\u305A\u3063\u3066\u3000{\u6C60|\u3044\u3051}\u3067\u306F\u306A\u304F\uFF01\uFF1F[VAR 0114(0041)]",
  "\u306D\u3048\u3000\u30D3\u30EA\u30AA\u2026\u2026\u3000{\u6C60|\u3044\u3051}\u3068{\u6E56|\u307F\u305A\u3046\u307F}\u306F\\n\u3069\u3053\u304C\u3000{\u9055|\u3061\u304C}\u3046\u3093\u30B6\u30DE\u30B9\u304B\uFF1F[VAR 0114(0041)]",
  "\u308F\u304B\u3089\u306A\u3044\u3088\u3000\u30CD\u30A2\u3061\u3083\u3093\u2026\u2026\\n\u307C\u304F\u305F\u3061\u3000\u30BB\u30EC\u30D6\u306E{\u4FA1\u5024\u89B3|\u304B\u3061\u304B\u3093}\u306F\\r\\n{\u4E00\u822C|\u3044\u3063\u3071\u3093}\u3088\u308A\u3000\u3060\u3044\u3076\u3000\u30B6\u30EB\u3060\u304B\u3089\u2026\u2026[VAR 0114(0040)]",
  "\u3042\u3089\u2026\u2026\uFF1F\\n\u3044\u3064\u3082\u306E\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u304B\u305F\uFF01[VAR 0114(0041)]",
  "{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u3060\u3000\u3042\u308C\u306F\\n{\u9593\u9055|\u307E\u3061\u304C}\u3044\u306A\u304F\u3000\u3044\u3064\u3082\u306E\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u3060\u306D\uFF01[VAR 0114(0040)]",
  "\u3068\u304D\u306B\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u304B\u305F\u2026\u2026\\n{\u6C60|\u3044\u3051}\u3068{\u6E56|\u307F\u305A\u3046\u307F}\u306E{\u9055|\u3061\u304C}\u3044\u3092\u3000\u3054{\u5B58\u77E5|\u305E\u3093\u3058}\u30B6\u30DE\u30B9\u304B\uFF1F[VAR 0114(0041)]",
  "{\u5927|\u304A\u304A}\u304D\u3055\uFF1F",
  "{\u6DF1|\u3075\u304B}\u3055\uFF1F",
  "\u306A\u308B\u307B\u3069\u3000\u3055\u3059\u304C\u306F\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\uFF01\\n{\u4E00\u822C\u7684|\u3044\u3063\u3071\u3093\u3066\u304D}\u306A{\u77E5\u8B58|\u3061\u3057\u304D}\u306B\u3000\u304F\u308F\u3057\u3044\u30B6\u30DE\u30B9\u306D\uFF01[VAR 0114(0041)]",
  "{\u4E0E|\u3042\u305F}\u3048\u3089\u308C\u305F\u3089\u3000{\u4E0E|\u3042\u305F}\u3048{\u8FD4|\u304B\u3048}\u3059\u306E\u304C\\n\u3042\u305F\u304F\u3057\u305F\u3061\u3000\u30BB\u30EC\u30D6\u306E{\u52D9|\u3064\u3068}\u3081\u2026\u2026[VAR 0114(0041)]",
  "\u3059\u306A\u308F\u3061\u3000\u3053\u3061\u3089\u306E{\u54C1|\u3057\u306A}\u3092\\n{\u5DEE|\u3055}\u3057{\u4E0A|\u3042}\u3052\u308B\u30B6\u30DE\u30B9\u3088[VAR 0114(0041)]",
  "\u3044\u3044\u30B6\u30DE\u30B9\u304B\uFF1F\u3000{\u5EB6\u6C11|\u3057\u3087\u307F\u3093}\u306E\u304B\u305F\\n{\u5E78|\u3057\u3042\u308F}\u305B\u3068\u306F\u3000{\u6C34\u8FBA|\u307F\u305A\u3079}\u306E\u3088\u3046\u306A\u3082\u306E\u2026\u2026[VAR 0114(0041)]",
  "{\u8003|\u304B\u3093\u304C}\u3048{\u65B9|\u304B\u305F}\u3057\u3060\u3044\u3067\u3000{\u6C34|\u307F\u305A}\u305F\u307E\u308A\u306B\u3082\\n{\u6C60|\u3044\u3051}\u306B\u3082\u3000{\u6E56|\u307F\u305A\u3046\u307F}\u306B\u3082\u3000\u306A\u308B\u3093\u30B6\u30DE\u30B9\u306E\u3088[VAR 0114(0041)]",
  "\u3055\u3059\u304C\u3000\u30CD\u30A2\u3061\u3083\u3093\uFF01\\n\u3044\u307E\u3000{\u6559|\u304A\u305D}\u308F\u3063\u305F{\u77E5\u8B58|\u3061\u3057\u304D}\u3092\u3000\u3055\u3063\u305D\u304F\\r\\n{\u672C\u4EBA|\u307B\u3093\u306B\u3093}\u306B\u3000{\u62AB\u9732|\u3072\u308D\u3046}\u3059\u308B\u306A\u3093\u3066\uFF01[VAR 0114(0040)]",
  "\u3055\u3066\u3000\u30D3\u30EA\u30AA\uFF01\\n\u3042\u305F\u304F\u3057\u3000{\u6211|\u308F}\u304C{\u793E|\u3057\u3083}\u306E\u3088\u3046\u306B\\r\\n[VAR FF00(0006)]\u30DB\u30EF\u30A4\u30C8\u306A{\u5C71|\u3084\u307E}[VAR FF00(0000)]\u306B\u3000{\u767B|\u306E\u307C}\u3063\u3066\u307F\u305F\u3044\u30B6\u30DE\u30B9[VAR 0114(0041)]",
  "\u3072\u3085\u30FC\uFF01\u3000\u30D1\u30EB\u30C7\u30A2\u30A8\u30B9\u30C6\u30FC\u30C8\u306F\\n\u306A\u3093\u3060\u304B\u3093\u3060\u3000\u30DB\u30EF\u30A4\u30C8\u306A{\u4F01\u696D|\u304D\u304E\u3087\u3046}\u3060\u3057\uFF01\\r\\n\u30CD\u30A2\u3061\u3083\u3093\u3000\u30BB\u30EC\u30D6\u306E{\u9451|\u304B\u304C\u307F}\u3060\u306D\uFF01[VAR 0114(0040)]",
  "{\u96EA\u5C71|\u3086\u304D\u3084\u307E}\u3067\u3000\u3053\u304A\u308A\u30DD\u30B1\u30E2\u30F3\u3000{\u898B|\u307F}\u306A\u304C\u3089\\n\u30B8\u30A7\u30E9\u30FC\u30C8\u3067\u3082\u3000{\u5473|\u3042\u3058}\u308F\u304A\u3046\u3088\uFF01[VAR 0114(0040)]",
  "\u30CD\u30A2\u3055\u307E\u3068\u3000\u30D3\u30EA\u30AA\u3055\u307E\u306F\\n\u30D1\u30EB\u30C7\u30A2\u306E\u3000{\u5927|\u304A\u304A}\u304D\u306A{\u6C34\u8FBA|\u307F\u305A\u3079}\u3078\u3000{\u884C|\u3044}\u304B\u308C\u307E\u3057\u305F",
  "{\u5927|\u304A\u304A}\u304D\u306A{\u6C34\u8FBA|\u307F\u305A\u3079}\u3068\u306F\u2026\u2026\\n{\u5DDD|\u304B\u308F}\uFF1F\u3000{\u6C60|\u3044\u3051}\uFF1F\\r\\n\u3072\u3087\u3063\u3068\u3057\u3066\u3000{\u6E56|\u307F\u305A\u3046\u307F}\u3000\u3067\u3057\u3087\u3046\u304B\uFF1F"
]
