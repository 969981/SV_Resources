[
  "\u3042\u3000\u3069\u304A\u3082\u3000\u3069\u304A\u3082\uFF01[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u3055\u3093\u3000\u3082\u3046\\n{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306B\u306F\u3000{\u6163|\u306A}\u308C\u307E\u3057\u305F\u304B\u306D\u3048\uFF1F[VAR 0114(002A)]",
  "\u305D\u308C\u306F\u3000\u3088\u304B\u3063\u305F\u3042\\n{\u697D|\u305F\u306E}\u3057\u305D\u3046\u3067\u3000\u3046\u308C\u3057\u3044\u306A\u3042[VAR 0114(002A)]",
  "\u304D\u3063\u3068\u3000\u3053\u308C\u304B\u3089\\n{\u697D|\u305F\u306E}\u3057\u304F\u306A\u3063\u3066\u304D\u307E\u3059\u3088\u304A\\r\\n{\u4F55|\u306A\u306B}\u304B\u3042\u3063\u305F\u3089\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u60A9|\u306A\u3084}\u307F\u307E\u3057\u3087\u3046\u30FC[VAR 0114(002A)]",
  "\u305D\u3046\u3060\uFF01\u3000\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u30A2\u30D7\u30EA\\n{\u4F7F|\u3064\u304B}\u3063\u3066\u304F\u308C\u3066\u307E\u3059\u304B\u3042\uFF1F[VAR 0114(002A)]",
  "\u3058\u3064\u306F\u3000{\u958B\u767A|\u304B\u3044\u306F\u3064}\u3057\u305F\u306E\\n\u3048\u3078\u3078\u2026\u2026\u3000\u307C\u304F\u3067\u3057\u3066[VAR 0114(002A)]",
  "\u307F\u3093\u306A\u304C\u3000\u30DD\u30B1\u30E2\u30F3\u3000{\u6355|\u3064\u304B}\u307E\u3048\u308B\u3068\\n\u307C\u304F\u306B\u3000\u30C7\u30FC\u30BF\u304C\u3000{\u9001|\u304A\u304F}\u3089\u308C\u3066\u304D\u3066\\r\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u8ABF\u67FB|\u3061\u3087\u3046\u3055}\u304C\u3000{\u9032|\u3059\u3059}\u3080\u3093\u3067\u3059\u30FC[VAR 0114(002A)]",
  "\u3060\u304B\u3089\u3000{\u77E5|\u3057}\u3089\u306A\u3044\u30DD\u30B1\u30E2\u30F3\u3000{\u898B|\u307F}\u3064\u3051\u305F\u3089\\n{\u6355|\u3064\u304B}\u307E\u3048\u3066\u3000{\u56F3\u9451|\u305A\u304B\u3093}\u3092\u3000{\u57CB|\u3046}\u3081\u3066\u307F\u3066\u304F\u3060\u3055\u3042\u3044[VAR 0114(002A)]",
  "\u307E\u305A\u306F\u3000{\u76EE\u6A19|\u3082\u304F\u3072\u3087\u3046}\u3000\uFF13\uFF10{\u7A2E\u985E|\u3057\u3085\u308B\u3044}\u30FC\uFF01[VAR 0114(002A)]",
  "{\u96C6|\u3042\u3064}\u3081\u305F\u3089\u3000{\u6559|\u304A\u3057}\u3048\u3066\u304F\u3060\u3055\u3044\u306D\u3048[VAR 0114(002A)]"
]
