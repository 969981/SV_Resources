  "\u30D6\u30EB\u30FC\u30D9\u30EA\u30FC{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306E\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3055\u3093\u3082\\n\u3044\u3044{\u5B50|\u3053}\u305F\u3061\u3000\u3070\u304B\u308A\u3067\u3059\u306D\\r\\n\u3068\u3066\u3082\u3000{\u6559|\u304A\u3057}\u3048\u304C\u3044\u304C\u3000\u3042\u308A\u307E\u3059\u3067\u3059\u3088[VAR 0114(0012)]",
