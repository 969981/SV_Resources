[
  "\u3053\u3053\u306F\u3000\u3068\u3082\u3063\u3053\u30D7\u30E9\u30B6\u3088\\c\\n\u3068\u3082\u3063\u3053{\u516C\u5712|\u3053\u3046\u3048\u3093}\u3063\u3066\u3000{\u547C|\u3088}\u3070\u308C\u3066\u305F\u3051\u3069\\n\u3044\u3064\u306E\u307E\u306B\u304B\u3000{\u540D\u524D|\u306A\u307E\u3048}\u3000{\u5909|\u304B}\u308F\u3063\u3066\u305F\u306E",
  "{\u5965|\u304A\u304F}\u306B\u3042\u308B\u306E\u306F\u3000\u3068\u3082\u3063\u3053{\u50CF|\u305E\u3046}\uFF01\\c\\n\u3068\u3082\u3063\u3053\u3055\u307E\u306F\u3000{\u5927\u6614|\u304A\u304A\u3080\u304B\u3057}\u306B\\n{\u6751|\u3080\u3089}\u3092{\u5B88|\u307E\u3082}\u3063\u305F\u3000\u30D2\u30FC\u30ED\u30FC\u306A\u3093\u3060\u305C",
  "\u304A\u3044\uFF01\u3000\u3068\u3082\u3063\u3053{\u50CF|\u305E\u3046}\u3000{\u58CA|\u3053\u308F}\u308C\u3066\u3093\u3058\u3083\u3093\uFF01\\n\u30BC\u30A4\u30E6\u304C\u3000\u3064\u3044\u306B\u3000\u3084\u3063\u3061\u307E\u3063\u305F\u306E\u304B\uFF01\uFF1F",
  "\u3068\u3082\u3063\u3053\u304C\u3000{\u60AA|\u308F\u308B}\u3044\u3084\u3064\u3000\u3060\u3063\u305F\u3068\u3057\u3066\u3082\\n\u3068\u3082\u3063\u3053{\u50CF|\u305E\u3046}\u306F\u3000\u306A\u3093\u304B\u3000{\u597D|\u3059}\u304D\u3060\u3063\u305F\u3093\u3060\u3088\u306A",
  "\u3068\u3082\u3063\u3053{\u50CF|\u305E\u3046}\u3000\u3042\u308A\u304C\u3068\u306A\uFF01\\n\u304A\u308C\u3082\u3000\u3061\u3087\u3063\u3068\u3060\u3051\u3000{\u52DF\u91D1|\u307C\u304D\u3093}\u3057\u305F\u305C"
]
