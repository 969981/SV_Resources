[
  "\u304A\u306F\u3088\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\\n\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u3067\u3059\\c\\n{\u5927\u5207|\u305F\u3044\u305B\u3064}\u306A\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u4F11|\u3084\u3059}\u307E\u305B\u3066\u3042\u3052\u307E\u3059\u304B\uFF1F",
  "\u3053\u3093\u306B\u3061\u306F\uFF01\\n\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u3067\u3059\\c\\n\u304A{\u75B2|\u3064\u304B}\u308C\u306E\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u4F11|\u3084\u3059}\u307E\u305B\u3066\u3042\u3052\u307E\u3059\u304B\uFF1F",
  "\u304A{\u75B2|\u3064\u304B}\u308C\u3055\u307E\u3067\u3059\uFF01\\n\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u3067\u3059\\c\\n\u304C\u3093\u3070\u3063\u305F\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u4F11|\u3084\u3059}\u307E\u305B\u3066\u3042\u3052\u307E\u3059\u304B\uFF1F",
  "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306E\u3000[VAR 0100(0000)]\u3055\u3093\\n\u304A\u306F\u3088\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\\c\\n{\u5927\u5207|\u305F\u3044\u305B\u3064}\u306A\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u4F11|\u3084\u3059}\u307E\u305B\u3066\u3042\u3052\u307E\u3059\u304B\uFF1F",
  "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306E\u3000[VAR 0100(0000)]\u3055\u3093\\n\u3053\u3093\u306B\u3061\u306F\uFF01\\c\\n\u304A{\u75B2|\u3064\u304B}\u308C\u306E\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u4F11|\u3084\u3059}\u307E\u305B\u3066\u3042\u3052\u307E\u3059\u304B\uFF1F",
  "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306E\u3000[VAR 0100(0000)]\u3055\u3093\\n{\u9045|\u304A\u305D}\u304F\u307E\u3067\u3000\u304A{\u75B2|\u3064\u304B}\u308C\u3055\u307E\u3067\u3059\\c\\n\u304C\u3093\u3070\u3063\u305F\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u4F11|\u3084\u3059}\u307E\u305B\u3066\u3042\u3052\u307E\u3059\u304B\uFF1F",
  "{\u4F11|\u3084\u3059}\u307E\u305B\u308B",
  "{\u9053|\u307F\u3061}\u306B{\u8FF7|\u307E\u3088}\u3063\u305F",
  "{\u8A95\u751F\u65E5|\u305F\u3093\u3058\u3087\u3046\u3073}\u306E{\u767B\u9332|\u3068\u3046\u308D\u304F}",
  "\u3084\u3081\u308B",
  "\u305D\u308C\u3067\u306F\\n\u304A{\u9810|\u3042\u305A}\u304B\u308A\u3044\u305F\u3057\u307E\u3059\uFF01",
  "\u304A{\u9810|\u3042\u305A}\u304B\u308A\u3057\u305F\u3000[VAR 0101(0000)]\u306F\\n{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000\u306A\u308A\u307E\u3057\u305F\u3088\uFF01",
  "\u304A{\u9810|\u3042\u305A}\u304B\u308A\u3057\u305F\u3000[VAR 0101(0000)]\u305F\u3061\u306F\\n\u307F\u3093\u306A\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000\u306A\u308A\u307E\u3057\u305F\u3088\uFF01",
  "\u307E\u305F\u306E\u3054{\u5229\u7528|\u308A\u3088\u3046}\u3092\\n\u304A{\u5F85|\u307E}\u3061\u3057\u3066\u3044\u307E\u3059\u306D\uFF01",
  "\u30C6\u30E9\u30B9\u30BF\u30EB\u30AA\u30FC\u30D6\u3082\\n\u30C1\u30E3\u30FC\u30B8\u3057\u3066\u304A\u304D\u307E\u3057\u305F\u3088\uFF01",
  "[VAR 0100(0000)]\u3055\u3093\u306B\u3000\u304A\u3059\u3059\u3081\u306E\\n{\u884C|\u3044}\u304F\u3079\u304D\u3000{\u5834\u6240|\u3070\u3057\u3087}\u306F\u2026\u2026",
  "\u307E\u305A\u306F\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\uFF01\\n\u30AA\u30EC\u30F3\u30B8\u30A2\u30AB\u30C7\u30DF\u30FC\u3092\u3000{\u76EE\u6307|\u3081\u3056}\u3057\u307E\u3057\u3087\u3046\uFF01\\r\\n{\u521D\u767B\u6821|\u306F\u3064\u3068\u3046\u3053\u3046}\u3000{\u697D|\u305F\u306E}\u3057\u307F\u3067\u3059\u306D\uFF01",
  "\u307E\u305A\u306F\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\uFF01\\n\u30B0\u30EC\u30FC\u30D7\u30A2\u30AB\u30C7\u30DF\u30FC\u3092\u3000{\u76EE\u6307|\u3081\u3056}\u3057\u307E\u3057\u3087\u3046\uFF01\\r\\n{\u521D\u767B\u6821|\u306F\u3064\u3068\u3046\u3053\u3046}\u3000{\u697D|\u305F\u306E}\u3057\u307F\u3067\u3059\u306D\uFF01",
  "\u307E\u3060\u307E\u3060\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3067\u3059\uFF01\\n\u30AA\u30EC\u30F3\u30B8\u30A2\u30AB\u30C7\u30DF\u30FC{\u5185|\u306A\u3044}\u3092\u3000{\u63A2\u7D22|\u305F\u3093\u3055\u304F}\u3057\u307E\u3057\u3087\u3046\uFF01\\c\\n\u3044\u308D\u3093\u306A{\u90E8\u5C4B|\u3078\u3084}\u306B\u3000{\u5165|\u306F\u3044}\u3063\u3066\u307F\u308B\u3068\\n{\u65B0|\u3042\u305F\u3089}\u3057\u3044{\u51FA\u4F1A|\u3067\u3042}\u3044\u304C\u3000\u3042\u308B\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3088",
  "\u307E\u3060\u307E\u3060\u3000{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u3067\u3059\uFF01\\n\u30B0\u30EC\u30FC\u30D7\u30A2\u30AB\u30C7\u30DF\u30FC{\u5185|\u306A\u3044}\u3092\u3000{\u63A2\u7D22|\u305F\u3093\u3055\u304F}\u3057\u307E\u3057\u3087\u3046\uFF01\\c\\n\u3044\u308D\u3093\u306A{\u90E8\u5C4B|\u3078\u3084}\u306B\u3000{\u5165|\u306F\u3044}\u3063\u3066\u307F\u308B\u3068\\n{\u65B0|\u3042\u305F\u3089}\u3057\u3044{\u51FA\u4F1A|\u3067\u3042}\u3044\u304C\u3000\u3042\u308B\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3088",
  "\u2026\u2026{\u4ECA|\u3044\u307E}\u306F\u3000\u3054\u3056\u3044\u307E\u305B\u3093\u306D\uFF01\\n\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u306E\u3000\u3069\u3053\u3078\u3067\u3082\\r\\n{\u81EA\u7531|\u3058\u3086\u3046}\u306B\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3067\u304D\u307E\u3059\u3088\uFF01",
  "\u30BB\u30EB\u30AF\u30EB\u30BF\u30A6\u30F3\u306E\u3000\u30BB\u30EB\u30AF\u30EB\u30B8\u30E0\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30AB\u30A8\u30C7\u3055\u3093\u306B\\n{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3059\u308B\u306E\u306F\u3000\u3069\u3046\u3067\u3059\u304B\uFF1F",
  "\u30DC\u30A6\u30EB\u30BF\u30A6\u30F3\u306E\u3000\u30DC\u30A6\u30EB\u30B8\u30E0\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30B3\u30EB\u30B5\u3055\u3093\u306B\\n{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3059\u308B\u306E\u306F\u3000\u3069\u3046\u3067\u3059\u304B\uFF1F",
  "\u30AB\u30E9\u30D5\u30BF\u30A6\u30F3\u306E\u3000\u30AB\u30E9\u30D5\u30B8\u30E0\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30CF\u30A4\u30C0\u30A4\u3055\u3093\u306B\\n{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3059\u308B\u306E\u306F\u3000\u3069\u3046\u3067\u3059\u304B\uFF1F",
  "\u30CF\u30C3\u30B3\u30A6\u30BF\u30A6\u30F3\u306E\u3000\u30CF\u30C3\u30B3\u30A6\u30B8\u30E0\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30CA\u30F3\u30B8\u30E3\u30E2\u3055\u3093\u306B\\n{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3059\u308B\u306E\u306F\u3000\u3069\u3046\u3067\u3059\u304B\uFF1F",
  "\u30C1\u30E3\u30F3\u30D7\u30EB\u30BF\u30A6\u30F3\u306E\u3000\u30C1\u30E3\u30F3\u30D7\u30EB\u30B8\u30E0\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30A2\u30AA\u30AD\u3055\u3093\u306B\\n{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3059\u308B\u306E\u306F\u3000\u3069\u3046\u3067\u3059\u304B\uFF1F",
  "\u30CA\u30C3\u30DA{\u5C71|\u3084\u307E}\u306E\u3000\u30CA\u30C3\u30DA{\u5C71|\u3084\u307E}\u30B8\u30E0\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30B0\u30EB\u30FC\u30B7\u30E3\u3055\u3093\u306B\\n{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3059\u308B\u306E\u306F\u3000\u3069\u3046\u3067\u3059\u304B\uFF1F",
  "\u30D5\u30EA\u30C3\u30B8\u30BF\u30A6\u30F3\u306E\u3000\u30D5\u30EA\u30C3\u30B8\u30B8\u30E0\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30E9\u30A4\u30E0\u3055\u3093\u306B\\n{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3059\u308B\u306E\u306F\u3000\u3069\u3046\u3067\u3059\u304B\uFF1F",
  "\u30D9\u30A4\u30AF\u30BF\u30A6\u30F3\u306E\u3000\u30D9\u30A4\u30AF\u30B8\u30E0\uFF01\\c\\n\u30B8\u30E0\u30EA\u30FC\u30C0\u30FC\u3000\u30EA\u30C3\u30D7\u3055\u3093\u306B\\n{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3059\u308B\u306E\u306F\u3000\u3069\u3046\u3067\u3059\u304B\uFF1F",
  "\u3044\u308F\u30BF\u30A4\u30D7\u306E\u3000\u30CC\u30B7\u306E\u3059\u307F\u304B\uFF01\\c\\n{\u5CA9\u58C1|\u304C\u3093\u307A\u304D}\u306E\u30CC\u30B7\u3068\u3000{\u547C|\u3088}\u3070\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u63A2|\u3055\u304C}\u3057\u3066\u307F\u308B\u306E\u306F\u3000\u3044\u304B\u304C\u3067\u3057\u3087\u3046\uFF1F",
  "\u306F\u304C\u306D\u30BF\u30A4\u30D7\u306E\u3000\u30CC\u30B7\u306E\u3059\u307F\u304B\uFF01\\c\\n{\u6F5C\u92FC|\u305B\u3093\u3053\u3046}\u306E\u30CC\u30B7\u3068\u3000{\u547C|\u3088}\u3070\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u63A2|\u3055\u304C}\u3057\u3066\u307F\u308B\u306E\u306F\u3000\u3044\u304B\u304C\u3067\u3057\u3087\u3046\uFF1F",
  "\u3072\u3053\u3046\u30BF\u30A4\u30D7\u306E\u3000\u30CC\u30B7\u306E\u3059\u307F\u304B\uFF01\\c\\n{\u5927\u7A7A|\u305F\u3044\u304F\u3046}\u306E\u30CC\u30B7\u3068\u3000{\u547C|\u3088}\u3070\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u63A2|\u3055\u304C}\u3057\u3066\u307F\u308B\u306E\u306F\u3000\u3044\u304B\u304C\u3067\u3057\u3087\u3046\uFF1F",
  "\u3058\u3081\u3093\u30BF\u30A4\u30D7\u306E\u3000\u30CC\u30B7\u306E\u3059\u307F\u304B\uFF01\\c\\n{\u571F\u9707|\u3069\u3057\u3093}\u306E\u30CC\u30B7\u3068\u3000{\u547C|\u3088}\u3070\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u63A2|\u3055\u304C}\u3057\u3066\u307F\u308B\u306E\u306F\u3000\u3044\u304B\u304C\u3067\u3057\u3087\u3046\uFF1F",
  "\u30C9\u30E9\u30B4\u30F3\u30BF\u30A4\u30D7\u306E\u3000\u30CC\u30B7\u306E\u3059\u307F\u304B\uFF01\\c\\n{\u507D\u7ADC|\u304E\u308A\u3085\u3046}\u306E\u30CC\u30B7\u3068\u3000{\u547C|\u3088}\u3070\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\n{\u63A2|\u3055\u304C}\u3057\u3066\u307F\u308B\u306E\u306F\u3000\u3044\u304B\u304C\u3067\u3057\u3087\u3046\uFF1F",
  "\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u3000\u30C1\u30FC\u30E0\u30FB\u30EB\u30AF\u30D0\u30FC\u306E\u30A2\u30B8\u30C8\uFF01\\c\\n\u30D5\u30A7\u30A2\u30EA\u30FC{\u7D44|\u3050\u307F}\u306E\u30DC\u30B9\u3000\u30AA\u30EB\u30C6\u30A3\u30AC\u3055\u3093\u304C\\n{\u6226|\u305F\u305F\u304B}\u3046{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000{\u5F85|\u307E}\u3063\u3066\u3044\u308B\u3088\u3046\u3067\u3059",
  "\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u3000\u30C1\u30FC\u30E0\u30FB\u30BB\u30AE\u30F3\u306E\u30A2\u30B8\u30C8\uFF01\\c\\n\u3042\u304F{\u7D44|\u3050\u307F}\u306E\u30DC\u30B9\u3000\u30D4\u30FC\u30CB\u30E3\u3055\u3093\u304C\\n{\u6226|\u305F\u305F\u304B}\u3046{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000{\u5F85|\u307E}\u3063\u3066\u3044\u308B\u3088\u3046\u3067\u3059",
  "\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u3000\u30C1\u30FC\u30E0\u30FB\u30B7\u30A7\u30C0\u30EB\u306E\u30A2\u30B8\u30C8\uFF01\\c\\n\u307B\u306E\u304A{\u7D44|\u3050\u307F}\u306E\u30DC\u30B9\u3000\u30E1\u30ED\u30B3\u3055\u3093\u304C\\n{\u6226|\u305F\u305F\u304B}\u3046{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000{\u5F85|\u307E}\u3063\u3066\u3044\u308B\u3088\u3046\u3067\u3059",
  "\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u3000\u30C1\u30FC\u30E0\u30FB\u30B7\u30FC\u306E\u30A2\u30B8\u30C8\uFF01\\c\\n\u3069\u304F{\u7D44|\u3050\u307F}\u306E\u30DC\u30B9\u3000\u30B7\u30E5\u30A6\u30E1\u30A4\u3055\u3093\u304C\\n{\u6226|\u305F\u305F\u304B}\u3046{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000{\u5F85|\u307E}\u3063\u3066\u3044\u308B\u3088\u3046\u3067\u3059",
  "\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u3000\u30C1\u30FC\u30E0\u30FB\u30AB\u30FC\u30D5\u306E\u30A2\u30B8\u30C8\uFF01\\c\\n\u304B\u304F\u3068\u3046{\u7D44|\u3050\u307F}\u306E\u30DC\u30B9\u3000\u30D3\u30EF\u3055\u3093\u304C\\n{\u6226|\u305F\u305F\u304B}\u3046{\u76F8\u624B|\u3042\u3044\u3066}\u3092\u3000{\u5F85|\u307E}\u3063\u3066\u3044\u308B\u3088\u3046\u3067\u3059",
  "\u30D1\u30EB\u30C7\u30A2\u306E{\u5927\u7A74|\u304A\u304A\u3042\u306A}\u3000\u30A8\u30EA\u30A2\u30BC\u30ED\uFF01\\c\\n\u305F\u306E\u3082\u3057\u3044\u3000\u304A{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u304C\\n\u3042\u306A\u305F\u3092\u3000{\u5F85|\u307E}\u3063\u3066\u3044\u308B\u3088\u3046\u3067\u3059",
  "\u30DE\u30C3\u30D7\u30A2\u30D7\u30EA\u306B\u3000{\u76EE\u7684\u5730|\u3082\u304F\u3066\u304D\u3061}\u3068\u3057\u3066\\n{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3055\u305B\u3066\u3044\u305F\u3060\u304D\u307E\u3059\u306D",
