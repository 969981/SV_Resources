[
  "\u305D\u308C\u3067\u306F\u3000{\u7B2C\u4E00\u56DE\u6226|\u3060\u3044\u3044\u3063\u304B\u3044\u305B\u3093}\uFF01\\n{\u6CE8\u76EE|\u3061\u3085\u3046\u3082\u304F}\u306E\u30AB\u30FC\u30C9\u306F\u2026\u2026\uFF01\uFF1F",
  "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u3000[VAR 0100(0000)]\u3000\uFF36\uFF33\u2026\u2026",
  "\u2026\u2026\uFF12\uFF0D\uFF27\u3000\u30DA\u30D1\u30FC\uFF01",
  "{\u80A9\u66F8|\u304B\u305F\u304C}\u304D\u306E{\u5DEE|\u3055}\u304C\\n{\u7B11|\u308F\u3089}\u3063\u3061\u3083\u3046\u30EC\u30D9\u30EB\u3061\u3083\u3093\u3000\u3060\u306A\u2026\u2026[VAR 0114(0006)]",
  "[VAR 0100(0000)]\uFF01\u3000\u30AA\u30EC\u304C\\n\u30A8\u30F3\u30C8\u30EA\u30FC\u3057\u3066\u3066\u3000\u30D3\u30C3\u30AF\u30EA\u3057\u305F\u308D\uFF01[VAR 0114(0006)]",
  "\u3078\u3078\u3063\\n\u305D\u306E\u30EA\u30A2\u30AF\u30B7\u30E7\u30F3\u304C\u3000{\u898B|\u307F}\u305F\u304B\u3063\u305F\u305C\uFF01[VAR 0114(0006)]",
  "\u3048\u3000\u308F\u304B\u3063\u3066\u305F\u306E\u304B\uFF1F\\n\u3055\u3059\u304C\u3000\u30AA\u30EC\u306E{\u89AA\u53CB|\u30C0\u30C1}\u3060\u306A\u2026\u2026[VAR 0114(0006)]",
  "\u30AA\u30EC\u3000\u30A8\u30EA\u30A2\u30BC\u30ED\u3067\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u306E\\n{\u529B\u4E0D\u8DB3|\u3061\u304B\u3089\u3076\u305D\u304F}\u3092\u3000{\u601D|\u304A\u3082}\u3044{\u77E5|\u3057}\u3063\u3066\u3055[VAR 0114(0006)]",
  "\u30DE\u30D5\u30A3\u30C6\u30A3\u30D5\u305F\u3061\u3068\u3000{\u96A0|\u304B\u304F}\u308C\u3066\\n{\u731B\u7279\u8A13|\u3082\u3046\u3068\u3063\u304F\u3093}\u3057\u3066\u305F\u3093\u3060\u305C\uFF01[VAR 0114(0006)]",
  "{\u4F55|\u306A\u3093}\u304B\u3000\u3042\u3063\u305F\u3068\u304D\u306F\u3000\u307E\u305F\\n\u30AA\u30DE\u30A8\u3068\u3000{\u80A9\u4E26|\u304B\u305F\u306A\u3089}\u3079\u3066\u3000{\u6226|\u305F\u305F\u304B}\u3044\u305F\u3044[VAR 0114(0006)]",
  "\u3060\u304B\u3089\u3000{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\\n\u307E\u3050\u308C\u3067\u3082\u3000{\u52DD|\u304B}\u30FC\u3064\uFF01\uFF01[VAR 0114(0006)]",
  "\u30D4\u30EA\u30C3\u3068{\u5473\u5909|\u3042\u3058\u3078\u3093}\u3000{\u65B0\u751F|\u3057\u3093\u305B\u3044}\u30DA\u30D1\u30FC\uFF01\\n\u3054{\u8CDE\u5473|\u3057\u3087\u3046\u307F}\u3042\u308C\u3000\u3060\u305C\uFF01[VAR 0114(0006)]",
  "{\u7B2C\u4E00\u56DE\u6226|\u3060\u3044\u3044\u3063\u304B\u3044\u305B\u3093}\u3000{\u52DD\u8005|\u3057\u3087\u3046\u3057\u3083}\u306F\u2026\u2026\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u3000[VAR 0100(0000)]\uFF01",
  "\u308F\u30FC\u3000\u308F\u30FC\uFF01\\n{\u606F\u5B50|\u3080\u3059\u3053}\u3000\u3084\u308B\u3058\u3083\u3093\uFF01",
  "{\u521D\u6226|\u3057\u3087\u305B\u3093}\u304B\u3089\u3000\u3059\u3054\u3044{\u6226|\u305F\u305F\u304B}\u3044\uFF01",
  "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u306E{\u529B|\u3061\u304B\u3089}\u3063\u3066\u3000\u3064\u3048\u30FC\uFF01\\n\u304F\u3084\u3057\u3044\u3051\u3069\u3000{\u8A87|\u307B\u3053}\u3089\u3057\u3044\u305C[VAR 0114(0006)]",
  "\u30AA\u30EC\u3082\u3000\u30B8\u30E0\u3068\u304B\\n\u307E\u308F\u3063\u3066\u307F\u308B\u304B\u306A\u2026\u2026\uFF1F[VAR 0114(0006)]",
  "\u30AA\u30EC\u306E\u3076\u3093\u307E\u3067\\n{\u4E8C\u56DE\u6226|\u306B\u304B\u3044\u305B\u3093}\u3082\u3000\u304C\u3093\u3070\u308C\u3088\uFF01[VAR 0114(0006)]"
]
