[
  "\u3053\u3053\u306F\u3000\u30DC\u30A6\u30EB\u30BF\u30A6\u30F3\\n{\u82B1|\u306F\u306A}\u3068\u3000{\u82B8\u8853|\u3052\u3044\u3058\u3085\u3064}\u306E\u3000{\u753A|\u307E\u3061}\u306A\u306E\uFF01",
  "\u30AD\u30DE\u30EF\u30EA\u306E\u3000{\u60A9|\u306A\u3084}\u307E\u3057\u3044{\u9854|\u304B\u304A}\uFF01\\n{\u4F5C\u8005|\u3055\u304F\u3057\u3083}\u306F\u3000\u3069\u3046\u3044\u3046{\u6C17\u6301|\u304D\u3082}\u3061\u3067\u3000{\u4F5C|\u3064\u304F}\u3063\u305F\u3093\u3060\uFF1F",
  "{\u5909|\u3078\u3093}\u306A{\u7F6E\u7269|\u304A\u304D\u3082\u306E}\u306E\u3000{\u524D|\u307E\u3048}\u3067\\n{\u5F7C\u5973|\u304B\u306E\u3058\u3087}\u3068\u3000{\u5F85|\u307E}\u3061\u3042\u308F\u305B\uFF01\\r\\n\u306A\u306E\u306B\u3000{\u5168\u7136|\u305C\u3093\u305C\u3093}\u3000{\u6765|\u3053}\u306A\u3044\u3093\u3060\uFF01",
  "{\u5909|\u3078\u3093}\u306A{\u7F6E\u7269|\u304A\u304D\u3082\u306E}\u306E\u3000{\u524D|\u307E\u3048}\u3067\\n{\u5F7C|\u304B\u308C}\u3068\u3000{\u5F85|\u307E}\u3061\u3042\u308F\u305B\u3000\u306A\u3093\u3060\u3051\u3069\\r\\n\u3053\u306E{\u753A|\u307E\u3061}\u3000{\u5909|\u3078\u3093}\u306A{\u7F6E\u7269|\u304A\u304D\u3082\u306E}\u3000{\u591A|\u304A\u304A}\u3059\u304E\u3088",
  "\u30DC\u30A6\u30EB{\u540D\u7269|\u3081\u3044\u3076\u3064}\u3000{\u8FF7\u5BAE|\u3081\u3044\u304D\u3085\u3046}\u30A2\u30B9\u30EC\u30C1\u30C3\u30AF\uFF01\\n\u30C1\u30E3\u30EC\u30F3\u30B8\u3057\u3066\u307F\u3066\u306D",
  "{\u6625|\u306F\u308B}\u306B\u306A\u308B\u3068\u3000{\u98A8|\u304B\u305C}\u306B{\u4E57|\u306E}\u3063\u3066\\n\u30D2\u30DE\u30CA\u30C3\u30C4\u304C\u3000{\u98DB|\u3068}\u3093\u3067\u304F\u308B\u3093\u3060",
  "\u3044\u3084\u3042\u3000\u30B3\u30F3\u30BB\u30D7\u30C8\u304C\\n\u30B3\u30F3\u30C8\u30E9\u30B9\u30C8\u3067\u3000\u30A2\u30AF\u30BB\u30F3\u30C8\u3060\u306A\u3042\\r\\n{\u7D20\u4EBA|\u3057\u308D\u3046\u3068}\u306B\u306F\u3000\u308F\u304B\u3089\u3093\u3060\u308D\u3046\u306A\u3042",
  "{\u6709\u540D|\u3086\u3046\u3081\u3044}\u306A{\u4F5C\u54C1|\u3055\u304F\u3072\u3093}\u3092\u3000{\u898B|\u307F}\u306B\u304D\u305F\u3093\u3060\uFF01\\n\u3088\u304F\u308F\u304B\u3089\u306A\u3044\u3051\u3069\u3000\u3044\u3044\u306D\uFF01",
  "\u307E\u305F\u3000\u3044\u304D\u3069\u307E\u308A\u2026\u2026\\n\u3075\u3047\u3000\u307E\u3044\u3054\u306B\u3000\u306A\u3063\u3061\u3083\u3063\u305F",
  "\u3053\u3053\u307E\u3067\u3000{\u6765|\u3053}\u308C\u308B\u3068\u306F\\n\u306A\u304B\u306A\u304B\u3000\u3059\u3054\u3044\u305E\uFF01\\c\\n{\u8AB0|\u3060\u308C}\u3082\u3000\u305F\u3069\u308A{\u7740|\u3064}\u3051\u306A\u3044\u304B\u3089\\n{\u79D8\u5BC6\u57FA\u5730|\u3072\u307F\u3064\u304D\u3061}\u306B\u3000\u3057\u3066\u308B\u3093\u3060\uFF01",
  "{\u75B2|\u3064\u304B}\u308C\u305F\u3089\\n{\u5C11|\u3059\u3053}\u3057\u3000{\u7ACB|\u305F}\u3061{\u6B62|\u3069}\u307E\u3063\u3066\u307F\u308B\u2026\u2026\\r\\n\u305D\u3046\u3057\u3066\u3000{\u898B|\u307F}\u3048\u308B\u3082\u306E\u3082\u3000\u3042\u308B\u3058\u3083\u308D",
  "\u30D2\u30DE\u30CA\u30C3\u30C4\u304C\u3000{\u9032\u5316|\u3057\u3093\u304B}\u3059\u308B\u3068\\n\u30AD\u30DE\u30EF\u30EA\u306B\u3000\u306A\u308B\u306E\u3000{\u4FE1|\u3057\u3093}\u3058\u3089\u308C\u306A\u3044\\r\\n{\u9032\u5316|\u3057\u3093\u304B}\u3063\u3066\u3000\u3061\u3087\u30FC\u3075\u3057\u304E\uFF01",
  "\u308F\u305F\u3057\u306E\u3000\u30E9\u30A4\u30C9\u30DD\u30B1\u30E2\u30F3\u3000\u3044\u3044\u3060\u308D\u30FC\uFF01\\c\\n\u3053\u3044\u3064\u3068\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\\n\u3044\u308D\u3093\u306A\u3068\u3053\u308D\u3092\u3000{\u65C5|\u305F\u3073}\u3057\u3066\u308B\u3093\u3060",
  "\u3053\u308C\u304C\u3000\u30B3\u30EB\u30B5{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306E\u3000{\u4F5C\u54C1|\u3055\u304F\u3072\u3093}\u304B\uFF01\\n\u3061\u3087\u3063\u3068\u3000{\u4F5C\u98A8|\u3055\u304F\u3075\u3046}\u304C\u3000{\u9055|\u3061\u304C}\u3046\u3088\u3046\u3060\u304C\u2026\u2026",
  "{\u9AD8|\u305F\u304B}\u3044\u3068\u3053\u308D\u3000\u3055\u3044\u3053\u30FC\uFF01\\c\\n{\u753A|\u307E\u3061}\u306E{\u5916|\u305D\u3068}\u306B\u306F\u3000\u3084\u3050\u3089\u3063\u3066\u3044\u3046\\n{\u9AD8|\u305F\u304B}\u3044{\u5854|\u3068\u3046}\u307F\u305F\u3044\u306A\u306E\u3000\u3042\u308B\u3093\u3060\u3063\u3066\uFF01"
]
