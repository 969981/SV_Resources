[
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3082\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\uFF01\\n{\u62BC\u5FCD|\u304A\u3059}\uFF01\u3000\u3057\u3081\u304F\u304F\u3063\u3066\u3044\u3053\u3046\uFF01[VAR 0114(0024)]",
  "\u30AD\u30DF\u305F\u3061\u306E{\u77E5\u8B58|\u3061\u3057\u304D}\u306F\\n\u3058\u3085\u3046\u3076\u3093\u306B\u3000{\u5F37|\u3064\u3088}\u3044\uFF01[VAR 0114(0024)]",
  "\u3082\u306F\u3084\u3000{\u6559|\u304A\u3057}\u3048\u308B\u3053\u3068\u306F\\n\u3042\u307E\u308A\u3000\u306A\u3044\u306E\u3060\u304C\u2026\u2026[VAR 0114(0024)]",
  "\u3055\u3089\u306A\u308B{\u9AD8|\u305F\u304B}\u307F\u3092\u3000{\u76EE\u6307|\u3081\u3056}\u3057\u3066\uFF01[VAR 0114(0024)]",
  "{\u901A\u4FE1\u5BFE\u6226|\u3064\u3046\u3057\u3093\u305F\u3044\u305B\u3093}\u306B\u304A\u3051\u308B\\n\u30EB\u30FC\u30EB\u3092\u3000\u304A\u307C\u3048\u3066\u3082\u3089\u304A\u3046\uFF01[VAR 0114(0024)]",
  "{\u901A\u4FE1\u5BFE\u6226\u6642|\u3064\u3046\u3057\u3093\u305F\u3044\u305B\u3093\u3058}\u3067\u306F\u3000\uFF12{\u4EBA|\u308A}\u3060\u3068\\n\u30B7\u30F3\u30B0\u30EB\u30D0\u30C8\u30EB\u3084\u3000\u30C0\u30D6\u30EB\u30D0\u30C8\u30EB\uFF01[VAR 0114(0024)]",
  "{\u53CB\u9054|\u3068\u3082\u3060\u3061}\uFF14{\u4EBA|\u306B\u3093}\u3000{\u96C6|\u3042\u3064}\u307E\u308C\u3070\\n\u30DE\u30EB\u30C1\u30D0\u30C8\u30EB\u3067\u3000{\u6226|\u305F\u305F\u304B}\u3048\u308B\u305E\uFF01[VAR 0114(0024)]",
  "{\u8AB2\u5916\u6388\u696D\u4E2D|\u304B\u304C\u3044\u3058\u3085\u304E\u3087\u3046\u3061\u3085\u3046}\u306E\u3000\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u306F\\n\u30DD\u30B1\u30E2\u30F3\u306E{\u6570|\u304B\u305A}\u3082\u3000{\u5F37|\u3064\u3088}\u3055\u3082\\r\\n{\u81EA\u7531|\u3058\u3086\u3046}\u306B\u3000{\u6226|\u305F\u305F\u304B}\u308F\u305B\u3066\u3044\u308B\u3060\u308D\u3046\uFF01[VAR 0114(0024)]",
  "\u3057\u304B\u3057\u3000{\u901A\u4FE1\u5BFE\u6226\u6642|\u3064\u3046\u3057\u3093\u305F\u3044\u305B\u3093\u3058}\u306F\\n\u3044\u304F\u3064\u304B\u306E{\u898F\u5B9A|\u304D\u3066\u3044}\u304C\u3000{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u3059\u308B\uFF01[VAR 0114(0024)]",
  "\u3072\u3068\u3064\u306F\u3000\u30EC\u30D9\u30EB{\u88DC\u6B63|\u307B\u305B\u3044}\uFF01[VAR 0114(0024)]",
  "[VAR FF00(0006)]{\u5236\u9650|\u305B\u3044\u3052\u3093}\u306A\u3057\u3000[VAR FF00(0000)]\u3068\u3044\u3046\u30EB\u30FC\u30EB\u306F\\n\u30EC\u30D9\u30EB\u306F\u3000\u3044\u3064\u3082\u306E\u307E\u307E\uFF01\\r\\n{\u624B\u6301|\u3066\u3082}\u3061\u3067\u3000{\u540C|\u304A\u306A}\u3058\u30DD\u30B1\u30E2\u30F3\u3084\u3000{\u540C|\u304A\u306A}\u3058\u3082\u3061\u3082\u306E\u304C\\r\\n\u304B\u3076\u3063\u3066\u3044\u3066\u3082\u3000\uFF2F\uFF2B\u3060\uFF01[VAR 0114(0024)]",
  "[VAR FF00(0006)]\u30CE\u30FC\u30DE\u30EB\u30EB\u30FC\u30EB[VAR FF00(0000)]\u306F\u3000\u3069\u3093\u306A{\u5F37|\u3064\u3088}\u3055\u306E\\n\u30DD\u30B1\u30E2\u30F3\u3067\u3082\u3000\u30EC\u30D9\u30EB\uFF15\uFF10\u3068\u3057\u3066\\r\\n{\u529B|\u3061\u304B\u3089}\u3092\u3000{\u767A\u63EE|\u306F\u3063\u304D}\u3057\u3066\u3082\u3089\u3046\u3000\u30EB\u30FC\u30EB\u3060\uFF01[VAR 0114(0024)]",
  "\u30EC\u30D9\u30EB\u304C{\u4F4E|\u3072\u304F}\u3044\u3000\u30DD\u30B1\u30E2\u30F3\u3067\u3082\\n{\u6210\u9577|\u305B\u3044\u3061\u3087\u3046}\u3057\u305F\u3042\u3068\u306E\u3000{\u529B|\u3061\u304B\u3089}\u3092\u3000\u3075\u308B\u3063\u3066\u304F\u308C\u308B\uFF01[VAR 0114(0024)]",
  "\u3053\u3061\u3089\u3082\u3000{\u540C|\u304A\u306A}\u3058\u30DD\u30B1\u30E2\u30F3\\n{\u540C|\u304A\u306A}\u3058\u3082\u3061\u3082\u306E\u3000\u304B\u3076\u308A\u306F\u3000\uFF2F\uFF2B\uFF01[VAR 0114(0024)]",
  "{\u6280|\u308F\u3056}\u3055\u3048\u3000{\u899A|\u304A\u307C}\u3048\u308C\u3070\\n\u30EC\u30D9\u30EB\u3092\u3000{\u4E0A|\u3042}\u3052\u306A\u304F\u3066\u3082\u3000{\u6D3B\u8E8D|\u304B\u3064\u3084\u304F}\u3067\u304D\u308B\u306E\u304C\\r\\n\u30CE\u30FC\u30DE\u30EB\u30EB\u30FC\u30EB\u306E\u3000{\u5F37|\u3064\u3088}\u307F\u3060\u306A\uFF01[VAR 0114(0024)]",
  "{\u6700\u5F8C|\u3055\u3044\u3054}\u306B\u3000[VAR FF00(0006)]\u30D5\u30E9\u30C3\u30C8\u30EB\u30FC\u30EB[VAR FF00(0000)]\u306F\\n\u30EC\u30D9\u30EB\uFF15\uFF10{\u4EE5\u4E0A|\u3044\u3058\u3087\u3046}\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\r\\n\u30EC\u30D9\u30EB\uFF15\uFF10\u306B\u3000{\u7D71\u4E00|\u3068\u3046\u3044\u3064}\u3055\u308C\u308B\uFF01[VAR 0114(0024)]",
  "\u30D5\u30E9\u30C3\u30C8\u30EB\u30FC\u30EB\u306F\u3000{\u4E00\u756A|\u3044\u3061\u3070\u3093}\\n{\u6226\u7565\u6027|\u305B\u3093\u308A\u3083\u304F\u305B\u3044}\u304C\u3000{\u9AD8|\u305F\u304B}\u3044\u3000\u30EB\u30FC\u30EB\u3060\uFF01[VAR 0114(0024)]",
  "\u3053\u306E\u30EB\u30FC\u30EB\u306F\u3000{\u624B\u6301|\u3066\u3082}\u3061\u3067\\n{\u540C|\u304A\u306A}\u3058\u30DD\u30B1\u30E2\u30F3\u3000{\u540C|\u304A\u306A}\u3058\u3082\u3061\u3082\u306E\u3092\\r\\n{\u4F7F\u7528|\u3057\u3088\u3046}\u3059\u308B\u306E\u306F\u3000{\u7981\u6B62|\u304D\u3093\u3057}\u3055\u308C\u3066\u3044\u308B\uFF01[VAR 0114(0024)]",
  "\u3055\u3042\u3000\u3053\u3053\u3067\u3000{\u554F\u984C|\u3082\u3093\u3060\u3044}\u3060\uFF01[VAR 0114(0024)]",
  "\u30CE\u30FC\u30DE\u30EB\u30EB\u30FC\u30EB\u3068\u3000\u30D5\u30E9\u30C3\u30C8\u30EB\u30FC\u30EB\u2026\u2026\\n\u3042\u3048\u3066\u3000{\u4F4E|\u3072\u304F}\u3044\u30EC\u30D9\u30EB\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u3067\\r\\n{\u6226|\u305F\u305F\u304B}\u3044\u305F\u3044\u3068\u304D\u3000\u3069\u3061\u3089\u304C\u3000\u3088\u3044\u3060\u308D\u3046\uFF1F[VAR 0114(0024)]",
  "\u30CE\u30FC\u30DE\u30EB\u30EB\u30FC\u30EB",
  "\u30D5\u30E9\u30C3\u30C8\u30EB\u30FC\u30EB",
  "{\u6B8B\u5FF5|\u3056\u3093\u306D\u3093}\uFF01\u3000\u30CE\u30FC\u30DE\u30EB\u30EB\u30FC\u30EB\u306F\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u30EC\u30D9\u30EB\u304C\u3000{\u4F4E|\u3072\u304F}\u304F\u3066\u3082\\r\\n\u30EC\u30D9\u30EB\uFF15\uFF10\u306B\u3000{\u7D71\u4E00|\u3068\u3046\u3044\u3064}\u3055\u308C\u3066\u3057\u307E\u3046\u3093\u3060\uFF01[VAR 0114(0024)]",
  "\u3055\u3059\u304C\u3000{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\uFF01\\n\u3088\u304F\u3000{\u805E|\u304D}\u3044\u3066\u3044\u305F\u3088\u3046\u3060\u306A\uFF01[VAR 0114(0024)]",
  "{\u6226\u7565\u7684|\u305B\u3093\u308A\u3083\u304F\u3066\u304D}\u306B\u3000\u3042\u3048\u3066\\n\u30EC\u30D9\u30EB\uFF15\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u51FA|\u3060}\u3057\u305F\u3044\u3068\u304D\u306F\\r\\n\u30D5\u30E9\u30C3\u30C8\u30EB\u30FC\u30EB\u3067\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u304C\u3000\u30D9\u30B9\u30C8\u3060\u306A\uFF01[VAR 0114(0024)]",
  "\u3082\u3061\u308D\u3093\u3000{\u5236\u9650|\u305B\u3044\u3052\u3093}\u306A\u3057\u3000\u3060\u3068\\n\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u30EC\u30D9\u30EB\u3082\u3000\u3082\u3061\u3082\u306E\u3082\\r\\n{\u81EA\u7531|\u3058\u3086\u3046}\u306B\u3000{\u7D44|\u304F}\u307F{\u5408|\u3042}\u308F\u305B\u3089\u308C\u308B\uFF01[VAR 0114(0024)]",
  "{\u53CB\u9054\u540C\u58EB|\u3068\u3082\u3060\u3061\u3069\u3046\u3057}\u3067\u3000{\u597D|\u3059}\u304D\u306A\u3088\u3046\u306B\\n{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308B\u306A\u3089\u3000\u3046\u3063\u3066\u3064\u3051\u3060\u306A\uFF01[VAR 0114(0024)]",
  "{\u7D50\u8AD6|\u3051\u3064\u308D\u3093}\uFF01\uFF01[VAR 0114(0024)]",
  "{\u7D76\u5BFE|\u305C\u3063\u305F\u3044}\u3000\u30EC\u30D9\u30EB\uFF15\uFF10\u304C\u3000\u30CE\u30FC\u30DE\u30EB\u3067\uFF01\\n{\u4F4E|\u3072\u304F}\u304F\u3066\u3000\u3044\u3044\u306E\u304C\u3000\u30D5\u30E9\u30C3\u30C8\u3060\uFF01[VAR 0114(0024)]",
  "{\u53CB\u9054|\u3068\u3082\u3060\u3061}\u3068\u3000{\u71B1|\u3042\u3064}\u3044{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u306B\\n{\u80F8|\u3080\u306D}\u3000{\u8E8D|\u304A\u3069}\u3089\u305B\u3066\u304F\u308C\uFF01[VAR 0114(0024)]",
  "\u30E0\u30E0\uFF01\u3000{\u4F53|\u304B\u3089\u3060}\u3067\u3000{\u4F53\u9A13|\u305F\u3044\u3051\u3093}\u3057\u3066\u3082\u3089\u304A\u3046\u3068\\n{\u601D|\u304A\u3082}\u3063\u305F\u304C\u3000\u3082\u3046{\u6642\u9593|\u3058\u304B\u3093}\u304B\u2026\u2026[VAR 0114(0024)]",
  "{\u6B21\u56DE|\u3058\u304B\u3044}\u306F\u3000{\u671F\u672B|\u304D\u307E\u3064}\u30C6\u30B9\u30C8\u3092\u3000\u304A\u3053\u306A\u3046\u305E\uFF01\\n\uFF11\uFF10\uFF10{\u70B9|\u3066\u3093}\u3000{\u76EE\u6307|\u3081\u3056}\u3057\u3066\u3000{\u62BC\u5FCD|\u304A\u3059}\u3000{\u62BC\u5FCD|\u304A\u3059}\u3060\uFF01[VAR 0114(0024)]"
