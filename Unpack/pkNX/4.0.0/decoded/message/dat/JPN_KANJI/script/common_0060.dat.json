  "\u30DB\u30B2\u30EF\u30FC",
  "\u3053\u304C\u3082\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u30AF\u30EF\u30C3\u30B9\u3055\u3093[VAR 0114(000A)]",
  "\u30AF\u30EF\u30D7\u30EB\u30C3\uFF01",
  "{\u7686|\u307F\u306A}\u3055\u3093\u3000\u3068\u3066\u3082\u3000{\u4EBA|\u3072\u3068}\u306A\u3064\u3063\u3053\u304F\u3066\\n{\u79C1|\u308F\u305F\u3057}\u306E\u305D\u3070\u3092\u3000{\u96E2|\u306F\u306A}\u308C\u306A\u3044\u3093\u3067\u3059\u3088[VAR 0114(000A)]",
  "\u2026\u2026\u304A\u3084\uFF1F[VAR 0114(000A)]",
  "\u3075\u3080\u2026\u2026\u3000{\u6821\u9577|\u3053\u3046\u3061\u3087\u3046}\u3088\u308A\u3082\\n[VAR 0100(0000)]\u3055\u3093\u304C\u3000{\u6C17|\u304D}\u306B\u306A\u308B\u3088\u3046\u3067\u3059[VAR 0114(000A)]",
  "{\u9078\u629E|\u305B\u3093\u305F\u304F}\u3092\u3000{\u898B\u5B88|\u307F\u307E\u3082}\u308A\u305F\u3044\u3067\u3059\u304C\\n\u305D\u308D\u305D\u308D\u3000{\u6B21|\u3064\u304E}\u306E\u304A{\u5B85|\u305F\u304F}\u306B\u3000{\u5411|\u3080}\u304B\u308F\u306A\u3044\u3068\u2026\u2026[VAR 0114(000A)]",
  "\u3042\u3061\u3089\u306E\u304A{\u5BB6|\u3046\u3061}\u306B\u3000\u3044\u307E\u3059\u306E\u3067\\n\u3058\u3063\u304F\u308A\u3000{\u8003|\u304B\u3093\u304C}\u3048\u3066\\r\\n{\u6C7A|\u304D}\u307E\u3063\u305F\u3089\u3000{\u4F1D|\u3064\u305F}\u3048\u306B\u304D\u3066\u304F\u3060\u3055\u3044[VAR 0114(000A)]",
  "\u305D\u308C\u3067\u306F\u3000\u307E\u305F{\u5F8C|\u306E\u3061}\u307B\u3069\\n\u2026\u2026{\u5931\u793C|\u3057\u3064\u308C\u3044}\u3044\u305F\u3057\u307E\u3059[VAR 0114(000A)]",
  "\u3068\u3063\u3066\u3082\u3000{\u793C\u5100\u6B63|\u308C\u3044\u304E\u305F\u3060}\u3057\u3044\\n{\u6821\u9577\u5148\u751F|\u3053\u3046\u3061\u3087\u3046\u305B\u3093\u305B\u3044}\u3060\u3063\u305F\u308F\u306D[VAR 0114(002B)]",
  "\u307F\u3093\u306A\u3000{\u7D20\u6575|\u3059\u3066\u304D}\u3060\u3051\u3069\\n\uFF11{\u5339|\u3074\u304D}\u3000{\u9078|\u3048\u3089}\u3070\u306A\u3044\u3068\u3044\u3051\u306A\u3044\u3093\u3060\uFF1F[VAR 0114(002B)]",
  "\u305B\u3063\u304B\u304F\u3060\u3057\u3000\u3053\u306E{\u5B50|\u3053}\u305F\u3061\u3068\\n{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u6B69|\u3042\u308B}\u3044\u3066\\r\\n{\u69D8\u5B50|\u3088\u3046\u3059}\u3092\u3000{\u898B|\u307F}\u3066\u307F\u308B\u306E\u306F\u3000\u3069\u3046\uFF1F[VAR 0114(002B)]",
  "\u30DD\u30B1\u30E2\u30F3\u306E\u3053\u3068\\n\u3044\u3063\u3071\u3044\u3000\u308F\u304B\u308B\u304B\u3082[VAR 0114(002B)]",
  "\u305D\u308C\u3068\u2026\u2026\\n\u30DE\u30DE\u304B\u3089\u3000{\u5165\u5B66\u795D|\u306B\u3085\u3046\u304C\u304F\u3044\u308F}\u3044\uFF01\\r\\n\u304A{\u51FA|\u3067}\u304B\u3051\u3059\u308B\u306A\u3089\u3000{\u6301|\u3082}\u3063\u3066\u3044\u304D\u306A\u3055\u3044[VAR 0114(002B)]",
  "{\u65B0|\u3042\u305F\u3089}\u3057\u3044\u30B9\u30DE\u30DB\uFF01\\n{\u8AAC\u660E\u66F8|\u305B\u3064\u3081\u3044\u3057\u3087}\u3092\u3000{\u8AAD|\u3088}\u3080\u308F\u306D\uFF01\\c\\n\u300E{\u9053|\u307F\u3061}\u306B\u3000{\u8FF7|\u307E\u3088}\u3063\u305F\u3089\u3000[VAR FF00(0006)]\uFF39\u30DC\u30BF\u30F3[VAR FF00(0000)]\uFF01\u300F\\n\u30DE\u30C3\u30D7\u304C\u3000{\u898B|\u307F}\u308C\u3066\u3000{\u4FBF\u5229|\u3079\u3093\u308A}\u307F\u305F\u3044\u3088\\r\\n{\u5927\u4E8B|\u3060\u3044\u3058}\u306B\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u306D[VAR 0114(002B)]",
  "\u3044\u3063\u3066\u3089\u3063\u3057\u3083\u3044\uFF01[VAR 0114(002B)]"
