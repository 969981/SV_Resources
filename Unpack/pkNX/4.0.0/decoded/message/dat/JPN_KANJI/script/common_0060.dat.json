[
  "\u30DD\u30B1\u30E2\u30F3\u305F\u3061\u3088\\n{\u51FA|\u3067}\u3066\u304D\u3066\u304F\u3060\u3055\u3044[VAR 0114(000A)]",
  "[~ 23]",
  "{\u5165\u5B66|\u306B\u3085\u3046\u304C\u304F}\u3059\u308B{\u751F\u5F92|\u305B\u3044\u3068}\u306B\u306F\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6E21|\u308F\u305F}\u3059{\u6C7A|\u304D}\u307E\u308A\u3067\u3057\u3066[VAR 0114(000A)]",
  "\uFF13{\u5339|\u3073\u304D}\u306E{\u4E2D|\u306A\u304B}\u304B\u3089\\n\u30D1\u30FC\u30C8\u30CA\u30FC\u3068\u306A\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\r\\n\uFF11{\u5339|\u3074\u304D}\u3000{\u9078|\u3048\u3089}\u3093\u3067\u3082\u3089\u3044\u307E\u3059[VAR 0114(000A)]",
  "\u304F\u3055\u306D\u3053\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u30CB\u30E3\u30AA\u30CF\u3055\u3093[VAR 0114(000A)]",
  "\u306F\u306B\u3083\u3042",
