[
  "\u3069\u304A\u3082\u3000\u3069\u304A\u3082\\n\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u307E\u3057\u3087\u3046\u304B\u3042[VAR 0114(002A)]",
  "{\u524D\u56DE|\u305C\u3093\u304B\u3044}\u3000\u304A{\u4F1D|\u3064\u305F}\u3048\u3057\u305F\\n\u300E\u30DC\u30FC\u30EB{\u6295|\u306A}\u3052\u3000\uFF3A\uFF32\u30DC\u30BF\u30F3\uFF01\u300F\\r\\n\u307F\u306A\u3055\u3093\u3000\u3084\u3063\u3066\u307F\u307E\u3057\u305F\u304B\u306D\u3048\uFF1F[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306B\u3000{\u6B69|\u3042\u308B}\u304F\u3068\\n{\u500B\u6027\u8C4A|\u3053\u305B\u3044\u3086\u305F}\u304B\u3067\u3000\u3068\u3063\u3066\u3082\u3000\u304B\u308F\u3044\u3044\u3067\u3059[VAR 0114(002A)]",
  "{\u624B\u6301|\u3066\u3082}\u3061\u306E\u30DD\u30B1\u30E2\u30F3\u3000\u307F\u3093\u306A\u3068\\n\u3075\u308C\u3042\u3044\u305F\u3044\u3068\u304D\u306F\u3000\u30D4\u30AF\u30CB\u30C3\u30AF\u3082\\r\\n\u304A\u3059\u3059\u3081\u3000\u306A\u3093\u3067\u3059[VAR 0114(002A)]",
  "\u307F\u3093\u306A\u3067\u3000\u30C6\u30FC\u30D6\u30EB\u3092\u3000\u304B\u3053\u3063\u3066\\n\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\u3000{\u4F5C|\u3064\u304F}\u3063\u305F\u308A\\r\\n\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u904A|\u3042\u305D}\u3079\u305F\u308A\u3000{\u697D|\u305F\u306E}\u3057\u3044\u3053\u3068\u3060\u3089\u3051[VAR 0114(002A)]",
  "{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306B\u3064\u3044\u3066\u306F\u3000\u30B5\u30EF\u30ED{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306E\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3067\u3000{\u6559|\u304A\u3057}\u3048\u3066\u304F\u308C\u307E\u3059\u3088\u304A[VAR 0114(002A)]",
  "\u305D\u3057\u3066\u3000\u30D4\u30AF\u30CB\u30C3\u30AF\u3092\u3000\u3057\u3066\u308B\u3068\\n\u30C6\u30FC\u30D6\u30EB\u306E{\u6A2A|\u3088\u3053}\u306B\u3000{\u7F6E|\u304A}\u3044\u3066\u3042\u308B\\r\\n\u30D0\u30B9\u30B1\u30C3\u30C8\u306E{\u4E2D|\u306A\u304B}\u304B\u3089\u3000\u305F\u307E\uFF5E\u306B[VAR 0114(002A)]",
  "\u3059\u3054\u30FC\u304F\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u306A\u30A2\u30EC\u304C\\n{\u898B|\u307F}\u3064\u304B\u308B\u3053\u3068\u304C\u3000\u3042\u308B\u3093\u3067\u3059\u3088[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u751F|\u3046}\u307E\u308C\u3066\u304F\u308B\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u306A\u30A2\u30EC\uFF01\\n\u307F\u3093\u306A\u3067\u3000{\u8A00|\u3044}\u3063\u3066\u307F\u307E\u3057\u3087\u3046\u2026\u2026\u3000\u305B\u30FC\u306E\u3063\uFF01[VAR 0114(002A)]",
  "\u30DC\u30C3\u30AF\u30B9\uFF01",
  "\u30E2\u30F3\u30B9\u30BF\u30FC\u30DC\u30FC\u30EB\uFF01",
  "\u30BF\u30DE\u30B4\uFF01",
  "\u2026\u2026\u3042\u308C\u308C\uFF1F\u3000[VAR 0100(0000)]\u3055\u3093\u3060\u3051\\n\u30DC\u30C3\u30AF\u30B9\u3063\u3066\u3000\u304A{\u7B54|\u3053\u305F}\u3048\u3067\u3059\uFF1F\\c\\n\u30DC\u30C3\u30AF\u30B9\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u3092\u3000\u3042\u305A\u3051\u308B\u3082\u306E\\n{\u751F|\u3046}\u307E\u308C\u308B\u3068\u306F\u3000\u3061\u3087\u3063\u3068\u3000{\u9055|\u3061\u304C}\u3044\u307E\u3059\u304B\u306D\u3048\uFF1F[VAR 0114(002A)]",
  "\u2026\u2026\u3042\u308C\u308C\uFF1F\u3000[VAR 0100(0000)]\u3055\u3093\u3060\u3051\\n\u30E2\u30F3\u30B9\u30BF\u30FC\u30DC\u30FC\u30EB\u3063\u3066\u3000\u304A{\u7B54|\u3053\u305F}\u3048\u3067\u3059\uFF1F\\c\\n\u30DC\u30FC\u30EB\u304B\u3089\u3000{\u751F|\u3046}\u307E\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u306F\\n{\u4ECA|\u3044\u307E}\u306E\u3068\u3053\u308D\u3000\u307E\u3060\u3000{\u78BA\u8A8D|\u304B\u304F\u306B\u3093}\u3055\u308C\u3066\u306A\u3044\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u3088\u304B\u3063\u305F\u3042\uFF01\\n\u307F\u306A\u3055\u3093\u3000\u3042\u305F\u308A\u3067\u3059\uFF01[VAR 0114(002A)]",
  "\u305D\u3046\u3067\u3059\u3000{\u5927\u4E8B|\u3060\u3044\u3058}\u306A\u30A2\u30EC\u3068\u306F\\n\u30DD\u30B1\u30E2\u30F3\u306E\u30BF\u30DE\u30B4\u3000\u306A\u3093\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u3069\u3053\u304B\u3089\u3000{\u6301|\u3082}\u3063\u3066\u304D\u305F\u304B\u3000{\u4E0D\u660E|\u3075\u3081\u3044}\u3067\u3059\u304C\\n\u30D4\u30AF\u30CB\u30C3\u30AF\u306B\u3044\u305F\u3000\u30DD\u30B1\u30E2\u30F3\u304C\u3000\u3053\u3063\u305D\u308A\\r\\n\u30D0\u30B9\u30B1\u30C3\u30C8\u306B\u3000{\u5165|\u3044}\u308C\u305F\u3093\u3067\u3057\u3087\u3046\u306D\u3048[VAR 0114(002A)]",
  "\u30BF\u30DE\u30B4\u306F\u3000\u307F\u306A\u3055\u3093\u304C\u3000{\u6B69|\u3042\u308B}\u304F\u3053\u3068\u3067\\n{\u6E29|\u3042\u305F\u305F}\u307E\u3063\u3066\u3000{\u751F|\u3046}\u307E\u308C\u3066\u304D\u3066\u304F\u308C\u307E\u3059\u3088[VAR 0114(002A)]",
  "\u30DC\u30C3\u30AF\u30B9{\u5185|\u306A\u3044}\u3067\u306F\u3000{\u6E29|\u3042\u305F\u305F}\u307E\u3089\u306A\u3044\u306E\u3067\\n{\u624B\u6301|\u3066\u3082}\u3061\u306B\u3000{\u5165|\u3044}\u308C\u3066\u3000{\u6B69|\u3042\u308B}\u3044\u3066\u304F\u3060\u3055\u3044\u306D\u3048[VAR 0114(002A)]",
  "\u2026\u2026\u3072\u3068\u3064\u3060\u3051\u3000\u3068\u30FC\u3063\u3066\u3082\\n{\u5927\u4E8B|\u3060\u3044\u3058}\u306A\u3053\u3068\u3092\u3000\u304A{\u4F1D|\u3064\u305F}\u3048\u3057\u307E\u3059\u306D[VAR 0114(002A)]",
  "\u30BF\u30DE\u30B4\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u4EBA\u9593|\u306B\u3093\u3052\u3093}\u3092\\n{\u4FE1\u983C|\u3057\u3093\u3089\u3044}\u3057\u3066\u3000{\u9810|\u3042\u305A}\u3051\u3066\u304F\u308C\u305F\u3082\u306E\u3067\u3059[VAR 0114(002A)]",
  "\u3060\u304B\u3089\u3000{\u8CAC\u4EFB|\u305B\u304D\u306B\u3093}\u3082\u3063\u3066\u3000{\u80B2|\u305D\u3060}\u3066\u3066\u304F\u308C\u308B\u3068\uFF01\\n\u30B8\u30CB\u30A2{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3000\u3046\u308C\u3057\u3044\u306A\u3042[VAR 0114(002A)]",
  "{\u5927\u4E8B|\u3060\u3044\u3058}\u306A\u3053\u3068\u3000{\u8A00|\u3044}\u3063\u305F\u306E\u306B\\n\u30C1\u30E3\u30A4\u30E0\u3068\u3000\u304B\u3076\u3063\u3061\u3083\u3063\u305F\\r\\n\u2026\u2026{\u6B21|\u3064\u304E}\u306E{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3082\u3000{\u697D|\u305F\u306E}\u3057\u307F\u306B\u3000\u3057\u3066\u307E\u3042\u3059[VAR 0114(002A)]",
