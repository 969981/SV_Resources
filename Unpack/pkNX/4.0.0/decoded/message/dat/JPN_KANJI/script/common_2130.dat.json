  "{\u60AA|\u308F\u308B}\u3044\u304C\\n{\u672C\u6C17|\u307B\u3093\u304D}\u3092\u3000{\u51FA|\u3060}\u3055\u305B\u3066\u3082\u3089\u3046\u3088\uFF01[VAR 0114(0024)]",
  "{\u7B2C\u4E09\u56DE\u6226|\u3060\u3044\u3055\u3093\u304B\u3044\u305B\u3093}\u3000{\u52DD\u8005|\u3057\u3087\u3046\u3057\u3083}\u306F\u2026\u2026\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u3000[VAR 0100(0000)]\uFF01",
