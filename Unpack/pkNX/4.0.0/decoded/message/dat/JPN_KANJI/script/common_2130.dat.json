[
  "\u3044\u3088\u3044\u3088\u3000{\u7B2C\u4E09\u56DE\u6226|\u3060\u3044\u3055\u3093\u304B\u3044\u305B\u3093}\uFF01\\n{\u6B8B|\u306E\u3053}\u308B\u30C8\u30EC\u30FC\u30CA\u30FC\u306F\u3000\u3042\u3068\uFF14{\u540D|\u3081\u3044}\uFF01",
