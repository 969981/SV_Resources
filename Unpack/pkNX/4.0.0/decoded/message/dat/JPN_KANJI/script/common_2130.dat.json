  "\u2026\u2026{\u610F\u5916|\u3044\u304C\u3044}\u304B\u3082\u3000\u3057\u308C\u306A\u3044\u304C\\n{\u5927\u4EBA|\u304A\u3068\u306A}\u3082\u3000{\u65E5\u3005|\u3072\u3073}\u3000{\u5B66|\u307E\u306A}\u3093\u3067\u3044\u308B\u3093\u3060\u3088[VAR 0114(0024)]",
  "\u3067\u306A\u3044\u3068\u3000{\u5B50\u4F9B|\u3053\u3069\u3082}\u306B\u3000{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u308D\u3068\\n\u3048\u3089\u305D\u3046\u306B\u3000{\u8A00|\u3044}\u3048\u306A\u3044\u3060\u308D\u3046\uFF01\uFF1F[VAR 0114(0024)]",
