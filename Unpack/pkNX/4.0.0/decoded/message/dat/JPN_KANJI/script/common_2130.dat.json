  "\u3053\u3053\u306F\u3000\u308F\u305F\u3057\u306E{\u5F37|\u3064\u3088}\u307F\u3092\\n{\u6700\u5927\u9650|\u3055\u3044\u3060\u3044\u3052\u3093}\u3000{\u6D3B|\u3044}\u304B\u305B\u308B{\u5834|\u3070}\uFF01[VAR 0114(0024)]",
  "\u3053\u306E\u3088\u3046\u306A{\u5927\u4F1A|\u305F\u3044\u304B\u3044}\u304C\u3000{\u958B|\u3072\u3089}\u304B\u308C\u308B\\n\u304D\u3063\u304B\u3051\u3068\u306A\u3063\u305F\u3000{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\u306B\u3000{\u611F\u8B1D|\u304B\u3093\u3057\u3083}\u3060\uFF01[VAR 0114(0024)]",
  "{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\u2026\u2026\\n\u3044\u3084\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u3000[VAR 0100(0000)]\uFF01[VAR 0114(0024)]",
