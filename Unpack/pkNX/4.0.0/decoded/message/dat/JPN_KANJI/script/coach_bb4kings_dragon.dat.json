  "\u3078\u3063\u3078\u3063\u3078\uFF01\\n{\u52DD|\u304B}\u3061\u3000{\u62FE|\u3072\u308D}\u308F\u305B\u3066\u3082\u3089\u3063\u305F\u305C\\c\\n{\u8CA0|\u307E}\u3051\u3066\u3000\u304F\u3084\u3057\u304F\u3066\u3082\\n\u30B9\u30B0\u30EA\u307F\u3066\u3048\u306B\u3000{\u843D|\u304A}\u3061\u306D\u3048\u3067\u304F\u308C\u3088\uFF1F[VAR 0114(004A)]",
  "\u30AA\u30A4\u30E9\u304C\u3000\u304A{\u8170|\u3053\u3057}\u306B\u3000\u3064\u3051\u3066\u3093\u306E\\n\u30B9\u30AB\u30FC\u30C8\u3060\u3068\u3000{\u601D|\u304A\u3082}\u3046\u3060\u308D\u3043\uFF1F\\c\\n{\u9055|\u3061\u304C}\u3046\u3093\u3060\u3088\u306A\u30FC\u3000\u3078\u3063\u3078\u3063\u3078\u30FC\uFF01\\n\u3053\u308C\u3000\u30DE\u30F3\u30C8\u3000{\u5DFB|\u307E}\u3044\u3066\u3093\u306E\u3088[VAR 0114(004A)]",
  "\u30AA\u30A4\u30E9\u3000{\u5EA7\u5B66|\u3056\u304C\u304F}\u304C\u3000{\u82E6\u624B|\u306B\u304C\u3066}\u3067\u3088\u30FC\\n\uFF13{\u56DE|\u304B\u3044}\u304F\u3089\u3044\uFF1F\u3000{\u7559\u5E74|\u308A\u3085\u3046\u306D\u3093}\u3057\u3066\u3093\u3060\\c\\n\u307B\u304B\u306E\u3084\u3064\u3088\u308A\u3000{\u9577|\u306A\u304C}\u3081\u306B\\n{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u3000{\u697D|\u305F\u306E}\u3057\u3081\u3066\u3000{\u5F97|\u3068\u304F}\u3060\u3088\u306A\u3042[VAR 0114(004A)]",
  "\u30A4\u30B9\u3063\u3066\u3000\u3044\u3044\u3088\u306A\\n\u3042\u308A\u304C\u3066\u3048\u3088\u306A\\c\\n{\u7ACB|\u305F}\u3063\u3066\u308B\u3068\u3000{\u75B2|\u3064\u304B}\u308C\u3093\u306E\u306B\\n\u306A\u3093\u3067\u3000\u307F\u3093\u306A\u3000{\u7ACB|\u305F}\u3063\u3066\u3093\u3060\uFF1F[VAR 0114(004A)]",
  "\u30AD\u30E7\u30FC\u30C0\u30A4\u306E\u3000[VAR 0101(0001)]\u3068\u306F\\n\u3088\u308D\u3057\u304F\u3000\u3084\u3063\u3066\u308B\u305C\u3043\\c\\n[VAR 0100(0000)]\u3060\u3068\u3000{\u601D|\u304A\u3082}\u3063\u3066\\n\u304B\u308F\u3044\u304C\u3063\u3066\u308B\u304B\u3089\u3000{\u5B89\u5FC3|\u3042\u3093\u3057\u3093}\u3057\u308D\u30FC\u3044[VAR 0114(004A)]",
  "\u30AA\u30A4\u30E9\u306E\u3000\u30B8\u30E5\u30E9\u30EB\u30C9\u30F3\\n{\u4F53|\u304B\u3089\u3060}\u304C\u3000\u30D4\u30AB\u30D4\u30AB\u3060\u3068\u3000{\u559C|\u3088\u308D\u3053}\u3076\u3093\u3060\\c\\n\u305F\u307E\u306B\u306F\u3000\u30AD\u30E5\u30AD\u30E5\u3063\u3068\\n\u307F\u304C\u3044\u3066\u3084\u3063\u3066\u304F\u308C\u30FC\u3044[VAR 0114(004A)]"
]
