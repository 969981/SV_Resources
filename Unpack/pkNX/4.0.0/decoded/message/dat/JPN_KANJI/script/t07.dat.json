[
  "\u30D4\u30B1\u30BF\u30A6\u30F3\u3078\u3000\u3088\u3046\u3053\u305D\\n{\u50CD|\u306F\u305F\u3089}\u304D{\u8005|\u3082\u306E}\u304C\u3000{\u591A|\u304A\u304A}\u3044\u3000{\u63A1\u6398|\u3055\u3044\u304F\u3064}\u306E{\u753A|\u307E\u3061}\u3060",
  "{\u90FD\u4F1A|\u3068\u304B\u3044}\u3067\u3000{\u89B3\u5149|\u304B\u3093\u3053\u3046}\u3082\u3000\u3044\u3044\u3051\u3069\\n\u3053\u3046\u3044\u3046\u3000{\u7D20\u6734|\u305D\u307C\u304F}\u306A{\u753A|\u307E\u3061}\u3082\u3000\u30AA\u30C4\u3088\u306D\u30FC",
  "\u30D4\u30B1\u3068\u306F\u3000{\u7A74|\u3042\u306A}\u3092{\u958B|\u3042}\u3051\u308B\u3053\u3068\\c\\n\u305D\u306E{\u540D|\u306A}\u306E\u3068\u304A\u308A\u3000{\u4F4F\u6C11|\u3058\u3085\u3046\u307F\u3093}\u306E{\u591A|\u304A\u304A}\u304F\u304C\\n{\u63A1\u6398|\u3055\u3044\u304F\u3064}\u3092\u3000{\u751F\u696D|\u306A\u308A\u308F\u3044}\u306B\u3057\u3066\u3044\u308B\u306E\u3055",
  "\u30D9\u30F3\u30C1\u306E\u3000\u3042\u308A\u304C\u305F\u307F\u2026\u2026\uFF01\\n{\u5927\u4EBA|\u304A\u3068\u306A}\u306B\u306A\u3063\u305F\u3089\u3000\u308F\u304B\u308B\u3088",
  "{\u63A1\u6398\u5834|\u3055\u3044\u304F\u3064\u3058\u3087\u3046}\u3067\u3000{\u5C71|\u3084\u307E}\u306E\u3088\u3046\u306B\\n{\u5927|\u304A\u304A}\u304D\u306A\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u898B|\u307F}\u305F\u306E\u3088\uFF01",
  "\u308F\u305F\u3057\u3082\u3000{\u5DDD|\u304B\u308F}\u306E\u3088\u3046\u306B\\n{\u9577|\u306A\u304C}\u3044\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u898B|\u307F}\u305F\u308F\uFF01",
  "\u30B4\u30DE\u30BE\u30A6\u306F\u3000\u3058\u3081\u3093\u30BF\u30A4\u30D7\uFF01\\n\u3067\u3093\u304D\u306F\u3000{\u52B9|\u304D}\u304B\u306A\u3044\u3057\u3000\u3069\u304F\u306B\u3082\u3000{\u5F37|\u3064\u3088}\u3044\u305E\uFF01\\r\\n\u2026\u2026\u307F\u305A\u306F\u3000\u304B\u3051\u306A\u3044\u3067\u306D",
  "{\u4ED5\u4E8B\u5E30|\u3057\u3054\u3068\u304C\u3048}\u308A\u306F\u3000\u3042\u306E\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u3067\\n{\u4EF2\u9593|\u306A\u304B\u307E}\u3068\u3000\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u3084\u3063\u3066\u3093\u3060",
  "\u30C8\u30ED\u30C3\u30B4\u30F3\u304C\u3000\u3044\u308B\u304B\u3089\\n\u3042\u305F\u3057\u3082\u3000{\u4ED5\u4E8B|\u3057\u3054\u3068}\u3092\u3000\u304C\u3093\u3070\u308C\u308B\\c\\n\u2026\u2026{\u529B\u4ED5\u4E8B|\u3061\u304B\u3089\u3057\u3054\u3068}\u3060\u3051\u3000\u3058\u3083\u306A\u304F\u3066\\n{\u7CBE\u795E\u9762|\u305B\u3044\u3057\u3093\u3081\u3093}\u3067\u3082\u3000{\u52A9|\u305F\u3059}\u3051\u3066\u3082\u3089\u3063\u3066\u308B\u3088",
  "{\u753A|\u307E\u3061}\u306E{\u5916|\u305D\u3068}\u3067\u3000{\u5012|\u305F\u304A}\u308C\u305D\u3046\u306B\u3000\u306A\u3063\u305F\u3068\u304D\\n{\u91CE\u751F|\u3084\u305B\u3044}\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u30BB\u30F3\u30BF\u30FC\u304A{\u59C9|\u306D\u3048}\u3055\u3093\u306B\\r\\n{\u52A9|\u305F\u3059}\u3051\u3066\u3082\u3089\u3063\u305F\u305C",
  "\u30A4\u30AD\u30EA\u30F3\u30B3\u304C\u3000{\u904B|\u306F\u3053}\u3093\u3067\u304F\u308C\u308B\u3000{\u7A7A|\u305D\u3089}\u306E{\u65C5|\u305F\u3073}\uFF01\\n\u305D\u3089\u3068\u3076\u30BF\u30AF\u30B7\u30FC\u3000{\u5229\u7528|\u308A\u3088\u3046}\u3057\u3066\u307E\u3059\uFF1F\\c\\n\u30DE\u30C3\u30D7\u30A2\u30D7\u30EA\u304B\u3089\u3000{\u547C|\u3088}\u3093\u3067\u3082\u3089\u3048\u308C\u3070\\n\u3069\u3053\u3067\u3082\u3000\u304B\u3051\u3064\u3051\u307E\u3059\u304B\u3089\u306D"
]
