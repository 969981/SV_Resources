[
  "[VAR 0100(0000)]\u3055\u3093\uFF01[VAR 0114(0049)]",
  "\u30D2\u30BD\u30D2\u30BD\u2026\u2026\uFF1F\u3000\uFF08{\u8FF7|\u307E\u3088}\u308F\u305A\u3000{\u6765|\u3053}\u308C\u307E\u3057\u305F\uFF1F\uFF09[VAR 0114(0049)]",
  "{\u6765|\u3053}\u308C\u305F\uFF01",
  "\u30D2\u30BD\u30D2\u30BD\u2026\u2026\uFF01",
  "\u30D2\u30BD\u30C3\u30D2\uFF01\u3000\uFF08\u3088\u304B\u3063\u305F\u3067\u3059\uFF01\uFF09[VAR 0114(0049)]",
  "\u2026\u2026\u30D2\u30BD\u30D2\uFF1F\u3000\uFF08\u2026\u2026\u306A\u3093\u3066\u3000{\u8A00|\u3044}\u3044\u307E\u3057\u305F\uFF1F\uFF09[VAR 0114(0049)]",
  "\u307F\u306A\u3055\u3093\u3000\u30A2\u30ED\u30FC\u30E9\uFF01\\n\u305D\u308C\u3067\u306F\u3000{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u307E\u3059\uFF01",
  "{\u521D|\u306F\u3058}\u3081\u3066\u306E{\u4EBA|\u3072\u3068}\u3082\\n\u3044\u308B\u307F\u305F\u3044\u3067\u3059\u306D\uFF01",
  "\u3053\u3053\u3000\u30B3\u30FC\u30B9\u30C8\u30A8\u30EA\u30A2\u306F\\n{\u5357|\u307F\u306A\u307F}\u306E{\u5CF6|\u3057\u307E}\u306E\u3088\u3046\u306A\u3000{\u74B0\u5883|\u304B\u3093\u304D\u3087\u3046}\u3092\\r\\n{\u4EBA\u5DE5|\u3058\u3093\u3053\u3046}{\u7684|\u3066\u304D}\u306B\u3000{\u518D\u73FE|\u3055\u3044\u3052\u3093}\u3057\u3066\u3044\u307E\u3059",
  "\u305D\u3057\u3066\u3000\u3053\u3053\u306B\u306F\u3000\u305D\u3093\u306A\\n{\u6696|\u3042\u305F\u305F}\u304B\u3044{\u6C17\u5019|\u304D\u3053\u3046}\u306B\u3000{\u9806\u5FDC|\u3058\u3085\u3093\u306E\u3046}\u3057\u305F\\r\\n\u30DD\u30B1\u30E2\u30F3\u304C\u3000{\u591A|\u304A\u304A}\u304F\u3000{\u66AE|\u304F}\u3089\u3057\u3066\u3044\u307E\u3059",
  "{\u901A\u5E38|\u3064\u3046\u3058\u3087\u3046}\u3088\u308A\u3000\u305F\u304F\u3055\u3093\u3000{\u5149|\u3072\u304B\u308A}\u3092{\u6D74|\u3042}\u3073\u3066\\n\u307B\u304B\u306E{\u5730\u65B9|\u3061\u307B\u3046}\u3088\u308A\u3082\u3000{\u5927|\u304A\u304A}\u304D\u304F\\r\\n{\u6210\u9577|\u305B\u3044\u3061\u3087\u3046}\u3057\u3066\u3044\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3082\u3000\u3044\u307E\u3059\u3088\uFF01",
  "\u305D\u3046\uFF01\u3000{\u540C|\u304A\u306A}\u3058\u30DD\u30B1\u30E2\u30F3\u3067\u3082\u3000{\u5225|\u3079\u3064}\u306E{\u5730\u65B9|\u3061\u307B\u3046}\u3067\\n{\u59FF|\u3059\u304C\u305F}\u304C{\u9055|\u3061\u304C}\u3046\u3000[VAR FF00(0006)]\u30EA\u30FC\u30B8\u30E7\u30F3\u30D5\u30A9\u30FC\u30E0[VAR FF00(0000)]\u3000\u3067\u3059\u306D\uFF01",
  "\u305D\u308C\u3067\u306F\u3000\u307F\u306A\u3055\u3093\u3000{\u5B9F\u969B|\u3058\u3063\u3055\u3044}\u306B\\n\u30EA\u30FC\u30B8\u30E7\u30F3\u30D5\u30A9\u30FC\u30E0\u3000[VAR FF00(0006)]\u30A2\u30ED\u30FC\u30E9\u306E\u3059\u304C\u305F[VAR FF00(0000)]\u306E\\r\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6355|\u3064\u304B}\u307E\u3048\u3066\u307F\u307E\u3057\u3087\u3046\uFF01",
  "{\u6355|\u3064\u304B}\u307E\u3048\u305F\u3089\u3000\u308F\u305F\u3057\u307E\u3067\\n{\u898B|\u307F}\u305B\u306B\u304D\u3066\u304F\u3060\u3055\u3044\u306D",
  "\u305D\u308C\u3067\u306F\u3000{\u6388\u696D\u958B\u59CB|\u3058\u3085\u304E\u3087\u3046\u304B\u3044\u3057}\uFF01",
  "\u30D6\u30EB\u30FC\u30D9\u30EA\u30FC{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306F\u3000{\u5B9F\u969B|\u3058\u3063\u3055\u3044}\u306B\\n\u3084\u3063\u3066\u307F\u308B{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u304C\u3000{\u591A|\u304A\u304A}\u3044\u3093\u3067\u3059[VAR 0114(0049)]",
  "\u3067\u306F\u3067\u306F\u3000{\u521D\u6388\u696D|\u306F\u3064\u3058\u3085\u304E\u3087\u3046}\\n\u304C\u3093\u3070\u3063\u3061\u3083\u3044\u307E\u3057\u3087\u3063\u304B\uFF01[VAR 0114(0049)]",
  "{\u63A2|\u3055\u304C}\u3059\u30DD\u30B1\u30E2\u30F3\u3000\u308F\u304B\u308A\u307E\u3059\uFF1F\\c\\n\u306A\u304C\uFF5E\u304F\u3000{\u6210\u9577|\u305B\u3044\u3061\u3087\u3046}\u3057\u305F\u3000\u30CA\u30C3\u30B7\u30FC\u306A\u3093\u3066\\n\u30A2\u30ED\u30FC\u30E9\u306E\u3059\u304C\u305F\u306E\u3000{\u5B9A\u756A|\u3066\u3044\u3070\u3093}\u3067\u3059\u306D\uFF01[VAR 0114(0049)]",
  "\u3088\u3046\u3000{\u77E5|\u3057}\u3063\u3066\u308B\u304B\uFF1F\\n\u30C0\u30B0\u30C8\u30EA\u30AA\u3063\u3066\u3000\u30A2\u30ED\u30FC\u30E9\u3060\u3068\\r\\n\u304A\u30D2\u30B2\u2026\u2026\uFF1F\u3000\u304C\u3000{\u751F|\u306F}\u3048\u3066\u308B\u3093\u3060\u305E",
  "{\u5357|\u307F\u306A\u307F}\u306E{\u5CF6|\u3057\u307E}\u306E\u3000\u30A2\u30ED\u30FC\u30E9{\u5730\u65B9|\u3061\u307B\u3046}\u306F\\n\u300E\u30A2\u30ED\u30FC\u30E9\u300F\u304C\u3000{\u6328\u62F6|\u3042\u3044\u3055\u3064}\u306A\u306E\uFF01",
  "\u3069\u306E\u30DD\u30B1\u30E2\u30F3\u304C\\n\u30A2\u30ED\u30FC\u30E9\u306E\u3059\u304C\u305F\u3000\u3060\u3063\u3051\uFF1F"
