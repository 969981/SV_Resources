[
  "\u304A\u308A\u3083\uFF01\u3000\u3068\u304F\u3068\u3000{\u898B|\u307F}\u3084\u304C\u308C\uFF01\\n\u30DD\u30FC\u30E9\u30B9\u30AF\u30A8\u30A2\u306E\u3000\u30D0\u30C8\u30EB\u30B3\u30FC\u30C8\u30FC\uFF01[VAR 0114(004A)]",
  "\u2026\u2026\u307E\u3042\u3000\u3068\u308A\u308F\u3051\u3000{\u5BD2|\u3055\u307F}\u3044\u3060\u3051\u3067\\n\u307B\u304B\u306E\u30B9\u30AF\u30A8\u30A2\u3068\u3000{\u5909|\u304B}\u308F\u3093\u306D\u3048\u304B\uFF01[VAR 0114(004A)]",
  "\u30AA\u30A4\u30E9\u3000\u30C9\u30E9\u30B4\u30F3{\u4F7F|\u3064\u304B}\u3044\u3000\u3060\u3051\u3069\\n{\u5BD2|\u3055\u307F}\u3044\u306E\u3000\u308F\u308A\u3068\u3000{\u597D|\u3059}\u304D\u3060\u305C[VAR 0114(004A)]",
  "\u304A\u3063\u3068\u3000\u305D\u3046\u3044\u3084\u3000\u30AD\u30E7\u30FC\u30C0\u30A4\\n{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u30C1\u30E3\u30EC\u30F3\u30B8\u306B\u3000{\u6765|\u304D}\u305F\u3093\u3060\u3063\u305F\u306A[VAR 0114(004A)]",
  "\u3046\u3061\u306E\u30C1\u30E3\u30EC\u30F3\u30B8\u306F\\n[VAR FF00(0006)]\u30C9\u30FC\u30E0{\u9650\u5B9A|\u3052\u3093\u3066\u3044}{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}[VAR FF00(0000)]\u3060\uFF01[VAR 0114(004A)]",
  "\u30EB\u30FC\u30EB\u306F\u3000{\u5358\u7D14|\u305F\u3093\u3058\u3085\u3093}\uFF01\\n\u30EA\u30FC\u30B0{\u90E8|\u3076}\u306E{\u5F8C\u8F29|\u3053\u3046\u306F\u3044}\u3000\uFF13{\u4EBA|\u306B\u3093}\u306B\u3000{\u52DD|\u304B}\u3061\u3083\u3042\\r\\n\u305D\u308C\u3067\u3000\u30C1\u30E3\u30EC\u30F3\u30B8\u306F\u3000\u30AA\u30B7\u30E1\u30A7\u3088\uFF01[VAR 0114(004A)]",
  "\u305F\u3060\u3057\u3000\u305D\u306E{\u540D|\u306A}\u306E\u3068\u30FC\u308A\uFF01\\n{\u6226|\u305F\u305F\u304B}\u308F\u305B\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3083\u3000{\u6761\u4EF6|\u3058\u3087\u3046\u3051\u3093}\u304C\u3042\u308B\uFF01[VAR 0114(004A)]",
  "\u3072\u3068\u30FC\u3064\uFF01\u3000[VAR FF00(0006)]\u30C6\u30E9\u30EA\u30A6\u30E0\u30C9\u30FC\u30E0\u3067[VAR FF00(0000)]\\n[VAR FF00(0006)]{\u6355|\u3064\u304B}\u307E\u3048\u305F[VAR FF00(0000)]\u3000{\u91CE\u751F|\u3084\u305B\u3044}\u306E\u30DD\u30B1\u30E2\u30F3\u3067\u3000\u3042\u308B\u3053\u3068\uFF01[VAR 0114(004A)]",
  "\u3075\u305F\u30FC\u3064\uFF01\u3000[VAR FF00(0006)]{\u81EA\u5206|\u3058\u3076\u3093}\u3067[VAR FF00(0000)]\\n[VAR FF00(0006)]{\u6355|\u3064\u304B}\u307E\u3048\u305F[VAR FF00(0000)]\u3000\u30DD\u30B1\u30E2\u30F3\u3067\u3000\u3042\u308B\u3053\u3068\uFF01[VAR 0114(004A)]",
  "{\u6761\u4EF6|\u3058\u3087\u3046\u3051\u3093}\u3000{\u6E80|\u307F}\u305F\u3057\u3066\u306D\u3048\u3000\u30DD\u30B1\u30E2\u30F3\u304C\\n{\u624B\u6301|\u3066\u3082}\u3061\u306B\u3000\u3044\u308B\u3068\u3000{\u6311|\u3044\u3069}\u3081\u306D\u3048\u304B\u3089\u306A[VAR 0114(004A)]",
  "{\u9762\u5012|\u3081\u3093\u3069\u3046}\u304B\u3082\u3000\u3057\u3093\u306D\u3047\u3051\u3069\\n{\u4ECA|\u3044\u307E}\u307E\u3067\u306E{\u8CAF\u91D1|\u3061\u3087\u304D\u3093}\u3067\u3000\u30DB\u30A4\u30DB\u30A4\\r\\n{\u52DD|\u304B}\u3063\u3061\u307E\u3063\u3066\u3082\u3000\u3064\u307E\u3093\u306D\u3048\u3082\u3093\u306A\uFF01[VAR 0114(004A)]",
  "\u3082\u3061\u308D\u3093\u3000{\u76F8\u624B|\u3042\u3044\u3066}\u3082\u3000{\u540C|\u304A\u306A}\u3058{\u6761\u4EF6|\u3058\u3087\u3046\u3051\u3093}\u3067\\n\u304C\u3093\u3070\u3063\u3066\u308B\u304B\u3089\u3000{\u52D8\u5F01|\u304B\u3093\u3079\u3093}\u3057\u3066\u304F\u308C\u3084[VAR 0114(004A)]",
  "\u305D\u3044\u3058\u3083\u3000\u30AD\u30E7\u30FC\u30C0\u30A4\\n{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u30C1\u30E3\u30EC\u30F3\u30B8\u3000\u3084\u308B\u304B\uFF01\uFF1F[VAR 0114(004A)]",
  "{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3059\u308B\uFF01",
  "{\u8AAC\u660E|\u305B\u3064\u3081\u3044}\u3092{\u805E|\u304D}\u304F",
  "\u307E\u305F{\u4ECA\u5EA6|\u3053\u3093\u3069}",
  "\u304A\u3046\uFF01\u3000\u305D\u3044\u3058\u3083\\n{\u5F8C\u8F29|\u3053\u3046\u306F\u3044}\u305F\u3061\u30FC\u3000{\u51FA|\u3067}\u3066\u3053\u3044\u3084\u30FC\uFF01[VAR 0114(004A)]",
  "\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3088\u308D\u3057\u304F\uFF01\\n\u3088\u308D\u3057\u304F\u306D\u30FC\uFF01\u3000\u3000\u3000\u3000\u3000\u30E8\u30ED\u30B7\u30AF\u3060\u3088\uFF01[VAR 0114(004D)]",
  "\u30AA\u30A4\u30E9\u306E\u30C1\u30E3\u30EC\u30F3\u30B8\u306F\\n\u3086\u308B\uFF5E\u304F\u304C\u3000\u30E2\u30C3\u30C8\u30FC\u3060[VAR 0114(004A)]",
  "\u30BD\u30C3\u30B3\u30FC\u3067\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\\n\u304A\u3063{\u59CB|\u3071\u3058}\u3081\u308B\u3082\u3000\u3088\u3057\uFF01[VAR 0114(004A)]",
  "\u30C9\u30FC\u30E0\u3000\u307E\u308F\u3063\u3066\\n\u30DD\u30B1\u30E2\u30F3\u3000{\u6355|\u3064\u304B}\u307E\u3048\u308B\u3082\u3000\u3088\u3057\uFF01[VAR 0114(004A)]",
  "\u305D\u3044\u3058\u3083\u3000\u3054\u3086\u308B\u308A\u3068\uFF01\\n{\u53CC\u65B9|\u305D\u3046\u307B\u3046}\u3000\u304C\u3093\u3070\u3063\u3066\u304F\u308C\u30FC\u3044[VAR 0114(004A)]",
  "\u30BD\u30C3\u30B3\u30FC\u3067\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u304A\u3063{\u59CB|\u3071\u3058}\u3081\u3066\u3082\u3000\u3044\u3044\u3057\\n{\u6C17\u5206|\u304D\u3076\u3093}{\u8EE2\u63DB|\u3066\u3093\u304B\u3093}\u306B\u3000\u3069\u3063\u304B\u3000{\u884C|\u3044}\u3063\u3066\u3082\u3000\u3044\u3044\u305C\uFF01\\r\\n\u3086\u308B\uFF5E\u304F\u3000\u304C\u3093\u3070\u3063\u3066\u304F\u308C\u30FC\u3044[VAR 0114(004A)]",
  "{\u8336\u8272|\u3061\u3083\u3044\u308D}\u3044\u30DD\u30B1\u30E2\u30F3\u3000{\u5927\u597D|\u3060\u3044\u3059}\u304D\uFF01\\n\u307C\u304F\u3068\u3000{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3059\u308B\u304B\u3044\uFF1F",
  "\u3042\u3061\u3083\u30FC\u3000\u304D\u307F\u306E\u30DD\u30B1\u30E2\u30F3\\n{\u6761\u4EF6|\u3058\u3087\u3046\u3051\u3093}\u3092\u3000{\u6E80|\u307F}\u305F\u3057\u3066\u306A\u3044\u307F\u305F\u3044\uFF01\\c\\n\u30C6\u30E9\u30EA\u30A6\u30E0\u30C9\u30FC\u30E0\u3067\uFF01\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u3067\uFF01\\n{\u6355|\u3064\u304B}\u307E\u3048\u305F\u3000\u30DD\u30B1\u30E2\u30F3\u3060\u3051\u3000\u3064\u308C\u3066\u304D\u3066\u306D",
  "\u308F\u3061\u3083\u30FC\uFF01\u3000\u3088\u308D\u3057\u304F\u306D\u30FC\uFF01",
  "{\u6B8B|\u306E\u3053}\u308A\u306E{\u8A66\u5408|\u3057\u3042\u3044}\u3082\u3000\u304C\u3093\u3070\u3063\u3066\uFF01\\n{\u8336\u8272|\u3061\u3083\u3044\u308D}\u3044{\u58F0\u63F4|\u305B\u3044\u3048\u3093}\u3067\u3000{\u5FDC\u63F4|\u304A\u3046\u3048\u3093}\u3057\u3066\u308B\u306D\uFF01",
  "\u308F\u305F\u3057\u306F\u3000\u30AF\u30FC\u30EB\u306A{\u5973|\u304A\u3093\u306A}\u2026\u2026\\n{\u9707|\u3075\u308B}\u3048\u308B{\u6E96\u5099|\u3058\u3085\u3093\u3073}\u306F\u2026\u2026\u3000\u3044\u3044\u308F\u306D\uFF1F",
  "\u3042\u3089\uFF1F\u3000\u3042\u306A\u305F\u306E\u30DD\u30B1\u30E2\u30F3\\n{\u6761\u4EF6|\u3058\u3087\u3046\u3051\u3093}\u3092\u3000{\u6E80|\u307F}\u305F\u3057\u3066\u306A\u3044\u308F\\c\\n\u30C6\u30E9\u30EA\u30A6\u30E0\u30C9\u30FC\u30E0\u3067\uFF01\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u3067\uFF01\\n{\u6355|\u3064\u304B}\u307E\u3048\u305F\u3000\u30DD\u30B1\u30E2\u30F3\u3060\u3051\u3000\u3064\u308C\u3066\u304F\u308B\u306E\u3088",
  "\u3075\u3075\u2026\u2026\u3000\u3088\u308D\u3057\u304F\uFF01",
  "{\u5BD2|\u3055\u3080}\u3055\u306B\u3000{\u8CA0|\u307E}\u3051\u305A\u3000\u304C\u3093\u3070\u3063\u3066\\n\u30AF\u30FC\u30EB\u306B\u3000{\u58F0\u63F4|\u305B\u3044\u3048\u3093}\u3092\u3000{\u9001|\u304A\u304F}\u308B\u308F\u2026\u2026",
  "\u30CA\u30F3\u30B8\u30E3\u30E2\u3063\u3066\u3000{\u914D\u4FE1|\u306F\u3044\u3057\u3093}{\u8005|\u3057\u3083}\u3000{\u77E5|\u3057}\u3063\u3066\u308B\uFF1F\\n{\u5F7C\u5973|\u304B\u306E\u3058\u3087}\u306E\u30BF\u30A4\u30D7\u3067\u3000{\u6226|\u305F\u305F\u304B}\u3063\u3061\u3083\u3046\u3088\uFF1F",
  "\u3042\u3093\u305F\u306E\u30DD\u30B1\u30E2\u30F3\\n{\u6761\u4EF6|\u3058\u3087\u3046\u3051\u3093}\u3092\u3000{\u6E80|\u307F}\u305F\u3057\u3066\u306A\u3044\u305E\u3088\uFF1F\\c\\n\u30C6\u30E9\u30EA\u30A6\u30E0\u30C9\u30FC\u30E0\u3067\uFF01\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u3067\uFF01\\n{\u6355|\u3064\u304B}\u307E\u3048\u305F\u3000\u30DD\u30B1\u30E2\u30F3\u3060\u3051\u3000\u3064\u308C\u3066\u3053\u306A\u304D\u3083\uFF01",
  "\u30D3\u30EA\u30C3\u3068\u3000\u30D0\u30EA\u30C3\u3068\u3000\u30E8\u30ED\u30B7\u30AF\u306D\uFF01",
  "{\u5F15|\u3072}\u304D{\u7D9A|\u3064\u3065}\u304D\u3000\u304C\u3093\u3070\u3063\u3066\uFF01\\n\u30B7\u30D3\u308C\u308B\u30D0\u30C8\u308A\u3092\u3000{\u898B\u5B88|\u307F\u307E\u3082}\u3063\u3066\u308B\u3088\uFF01",
  "\u3048\u3048\u3063\u3068\u3000{\u4ECA|\u3044\u307E}\u306E\u3067\\n\u3044\u3061\u3000\u306B\u3044\u3000\u3055\u3093\u2026\u2026[VAR 0114(004A)]",
  "\u304A\u3063\uFF01\u3000\u3044\u3064\u306E{\u9593|\u307E}\u306B\u304B\\n{\u5168\u54E1|\u305C\u3093\u3044\u3093}\u306B\u3000{\u52DD|\u304B}\u3063\u3066\u305F\u307F\u3066\u3048\u3060\u306A\uFF01[VAR 0114(004A)]",
  "\u3063\u3064\u30FC\u30EF\u30B1\u3067\u3060\uFF01\\n{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u30C1\u30E3\u30EC\u30F3\u30B8\u306F\u3000{\u7D42\u4E86|\u3057\u3085\u3046\u308A\u3087\u3046}\u3088\uFF01[VAR 0114(004A)]",
  "\u305D\u3044\u3058\u3083\u3000\u30EA\u30FC\u30B0{\u90E8\u54E1|\u3076\u3044\u3093}\u306E\\n{\u8AF8\u541B|\u3057\u3087\u304F\u3093}\u306F\u3000{\u64A4\u53CE|\u3066\u3063\u3057\u3085\u3046}\uFF01\u3000\u304B\u3051{\u8DB3|\u3042\u3057}\u30FC\uFF01[VAR 0114(004A)]",
  "\u3000\u3000\u3000\u3000\u3000\u3000\u3055\u3088\u3046\u306A\u3089\uFF01\\n\u304A\u3064\u304B\u308C\u30FC\uFF01\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u30D0\u30A4\u30D0\u30FC\u30A4\uFF01[VAR 0114(004D)]",
  "{\u7D20\u76F4|\u3059\u306A\u304A}\u3067\u3000\u304B\u308F\u3044\u3044\u3084\u3064\u3089[VAR 0114(004A)]",
  "{\u56DB\u5929\u738B|\u3057\u3066\u3093\u306E\u3046}\u30C1\u30E3\u30EC\u30F3\u30B8\u3000\u304C\u3093\u3070\u3063\u3066\u306D\uFF01"
]
