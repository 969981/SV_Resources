  "\u305B\u3063\u304B\u304F\u306E\u3000\u306B\u3058\u3057\u3051\u3093\u3000\u3067\u3059\u3051\u3069\\n\u304A\u306D\u30FC\u3061\u3083\u3093\u306F\u3000\u3053\u3053\u3067\u3000\u30D0\u30A4\u30D0\u30A4\uFF01[VAR 0114(0014)]",
