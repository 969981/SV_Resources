  "\u3044\u3084\u3000\u306A\u306B\\n{\u6B63\u89E3|\u305B\u3044\u304B\u3044}\u306F\u3000\u3042\u308A\u307E\u305B\u3093\\r\\n{\u8003|\u304B\u3093\u304C}\u3048\u3066\u3082\u3089\u3046\u3053\u3068\u304C\u3000{\u91CD\u8981|\u3058\u3085\u3046\u3088\u3046}\u306A\u306E\u3067\u3059[VAR 0114(0012)]",
