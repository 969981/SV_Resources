  "\u2026\u2026\u304D\u3063\u3068\u3000{\u9055|\u3061\u304C}\u3044\u307E\u3059\\n{\u9055|\u3061\u304C}\u3046\u3068\u3000{\u601D|\u304A\u3082}\u3044\u305F\u3044\u3067\u3059\u306D[VAR 0114(0012)]",
