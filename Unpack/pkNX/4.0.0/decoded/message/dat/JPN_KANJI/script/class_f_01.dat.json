  "\u305D\u308C\u306F\u304D\u3063\u3068\u3000{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u306B\u3000{\u75B2|\u3064\u304B}\u308C\u305F\u3068\u304D\\n{\u4ED5\u4E8B|\u3057\u3054\u3068}\u3067\u3000{\u5927\u5909|\u305F\u3044\u3078\u3093}\u306A{\u76EE|\u3081}\u306B\u3000\u3042\u3063\u305F\u3068\u304D\u2026\u2026[VAR 0114(0012)]",
