  "\u3053\u306E{\u5B66\u5712|\u304C\u304F\u3048\u3093}\u306E\u3000{\u5B66|\u307E\u306A}\u3073{\u820E|\u3084}\u306F\\n\u3058\u3064\u306B\u3000\u3044\u3044\u30C7\u30B6\u30A4\u30F3\u3092\u3000\u3057\u3066\u3044\u308B\\r\\n\u30C7\u30B6\u30A4\u30CA\u30FC\u306E{\u540D|\u306A}\u3092\u3000{\u77E5|\u3057}\u308A\u305F\u3044\u3082\u306E\u3060[VAR 0114(0017)]",
  "{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3082\u3000{\u82B8\u8853|\u3052\u3044\u3058\u3085\u3064}\u3082\\n{\u697D|\u305F\u306E}\u3057\u3044\u3053\u3068\u3000\u3070\u304B\u308A\u3067\u306F\u3000\u306A\u3044\\c\\n\u3057\u304B\u3057\u3000\u3042\u304D\u3089\u3081\u3066\u304F\u308C\u308B\u306A\u3088\\n\u3042\u304C\u304F\u306E\u3092\u3000\u3084\u3081\u308C\u3070\u3000\u305D\u3053\u3067\u3000{\u67AF|\u304B}\u308C\u308B\u305E[VAR 0114(0017)]",
