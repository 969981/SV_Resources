[
  "\u3069\u304A\u3082\u3000\u3069\u304A\u3082\\n\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3092\u3000{\u59CB|\u306F\u3058}\u3081\u307E\u3057\u3087\u3046\u304B\u3042[VAR 0114(002A)]",
  "\u305D\u3046\u3044\u3048\u3070\u3000{\u4E2D\u9593|\u3061\u3085\u3046\u304B\u3093}\u30C6\u30B9\u30C8\u3067\u3000\u307F\u306A\u3055\u3093\u306B\\n\u30D2\u30DF\u30C4\u3067\u3000{\u66F8|\u304B}\u3044\u3066\u3082\u3089\u3063\u305F\u3000\u30A2\u30F3\u30B1\u30FC\u30C8\u2026\u2026[VAR 0114(002A)]",
  "{\u4F55\u6545|\u306A\u305C}\u304B\u3000\u30AF\u30E9\u30D9\u30EB{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306B\\n\u30D0\u30EC\u3066\u3066\u3000{\u6012|\u304A\u3053}\u3089\u308C\u3061\u3083\u3044\u307E\u3057\u305F\u3042[VAR 0114(002A)]",
  "\u306A\u3093\u3067\u3082\u3000\u307C\u304F\u306E\u3000{\u9854\u8272|\u304B\u304A\u3044\u308D}\u3067\\n{\u96A0|\u304B\u304F}\u3057\u3054\u3068\u3000\u3057\u3066\u308B\u306E\u3000\u308F\u304B\u3063\u305F\u3068\u304B[VAR 0114(002A)]",
  "\u305D\u3093\u306A\u306B\u3000\u307C\u304F\u3000\u3044\u3064\u3082\u3068\\n{\u9854\u8272|\u304B\u304A\u3044\u308D}\u3000{\u9055|\u3061\u304C}\u3063\u305F\u304B\u306A\u3042\u2026\u2026\uFF1F[VAR 0114(002A)]",
  "{\u9854\u8272|\u304B\u304A\u3044\u308D}\u2026\u2026\u3000{\u4F53|\u304B\u3089\u3060}\u306E{\u8272|\u3044\u308D}\u2026\u2026\\n\u305D\u3046\u3000{\u4ECA\u56DE|\u3053\u3093\u304B\u3044}\u306F\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\r\\n{\u4F53|\u304B\u3089\u3060}\u306E{\u8272|\u3044\u308D}\u306B\u3000\u3064\u3044\u3066\u3067\u3059[VAR 0114(002A)]",
  "\u30DD\u30B1\u30E2\u30F3\u306E{\u4E2D|\u306A\u304B}\u306B\u306F\u3000{\u6027\u5225|\u305B\u3044\u3079\u3064}\u3084\\n{\u500B\u4F53|\u3053\u305F\u3044}\u306B\u3088\u3063\u3066\u3000{\u4F53|\u304B\u3089\u3060}\u306E{\u8272|\u3044\u308D}\u3084\u3000\u3082\u3088\u3046\u304C\\r\\n\u3058\u3083\u3063\u304B\u3093\u3000{\u9055|\u3061\u304C}\u3046\u3082\u306E\u304C\u3000{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u3057\u307E\u3059\u304C[VAR 0114(002A)]",
  "\u3054\u304F\u307E\u308C\u306B\u3000\u307B\u304B\u306E{\u500B\u4F53|\u3053\u305F\u3044}\u3088\u308A\\n{\u7570|\u3053\u3068}\u306A\u308B{\u8272\u7D20|\u3057\u304D\u305D}\u3092\u3000{\u591A|\u304A\u304A}\u304F\u3000{\u6301|\u3082}\u3063\u305F\\r\\n{\u500B\u4F53|\u3053\u305F\u3044}\u304C\u3000{\u751F|\u3046}\u307E\u308C\u308B\u3053\u3068\u304C\u3000\u3042\u308A\u307E\u3042\u3059[VAR 0114(002A)]",
  "\u305D\u308C\u304C\u3000[VAR FF00(0006)]{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044[VAR FF00(0000)]\u3000\u3068\\n{\u547C|\u3088}\u3070\u308C\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u3067\u3059[VAR 0114(002A)]",
  "{\u5F7C|\u304B\u308C}\u3089\u306B\u3000{\u51FA\u4F1A|\u3067\u3042}\u3048\u308B\u306E\u306F\\n\u3068\u3066\u3082\u3000\u3081\u305A\u3089\u3057\u3044\u3053\u3068\u3000\u3067\u3059\u304C[VAR 0114(002A)]",
  "\u3055\u3066\u3000{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u306F\\n\u3069\u308C\u304F\u3089\u3044\u306E{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3067\u3000{\u5B58\u5728|\u305D\u3093\u3056\u3044}\u3059\u308B\u304B\\r\\n{\u77E5|\u3057}\u3063\u3066\u3044\u308B{\u4EBA|\u3072\u3068}\u306F\u3000\u3044\u307E\u3059\u304B\u3042\uFF1F[VAR 0114(002A)]",
  "\uFF14\uFF10{\u5339|\u3074\u304D}\u306B\u3000\uFF11{\u5339|\u3074\u304D}",
  "\uFF14\uFF10\uFF10{\u5339|\u3074\u304D}\u306B\u3000\uFF11{\u5339|\u3074\u304D}",
  "\uFF14\uFF10\uFF10\uFF10{\u5339|\u3073\u304D}\u306B\u3000\uFF11{\u5339|\u3074\u304D}",
  "\uFF14\uFF10{\u5339|\u3074\u304D}\u306B\u3000\uFF11{\u5339|\u3074\u304D}\u304F\u3089\u3044\u3000\u3044\u308C\u3070\\n{\u7814\u7A76|\u3051\u3093\u304D\u3085\u3046}\u3082\u3000{\u9032|\u3059\u3059}\u3093\u3067\u3000\u3046\u308C\u3057\u3044\u3093\u3067\u3059\u304C\\r\\n\u3058\u3064\u306F\u3000\u3082\u30FC\u3063\u3068\u3000\u3081\u305A\u3089\u3057\u3044\u3093\u3067\u3059[VAR 0114(002A)]",
  "\u304A\u304A\u3000\u3044\u3044\u3068\u3053\u308D\u3000\u3064\u304D\u307E\u3059\u306D\u3048\\n\uFF14\uFF10\uFF10{\u5339|\u3074\u304D}\u306B\u3000\uFF11{\u5339|\u3074\u304D}\u3067\u3082\u3000{\u8CB4\u91CD|\u304D\u3061\u3087\u3046}\u3067\u3059\u304C\\r\\n\u3058\u3064\u306F\u3000\u3082\u3046{\u5C11|\u3059\u3053}\u3057\u3000\u3081\u305A\u3089\u3057\u3044\u3093\u3067\u3059[VAR 0114(002A)]",
  "\u308F\u3042\u3000\u3042\u305F\u308A\u3067\u3059\uFF01\\n[VAR 0100(0000)]\u3055\u3093\u306F\u3000{\u5C06\u6765|\u3057\u3087\u3046\u3089\u3044}\\r\\n\u30DD\u30B1\u30E2\u30F3{\u535A\u58EB|\u306F\u304B\u305B}\u306B\u3000\u306A\u3063\u3061\u3083\u3046\u304B\u3082\u3067\u3059\u306D\u3048[VAR 0114(002A)]",
  "\u306A\u3093\u3068\u3000{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044\u306E\u3000{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u306F\\n\uFF14\uFF10\uFF10\uFF10{\u5339|\u3073\u304D}\u306B\u3000\uFF11{\u5339|\u3074\u304D}\u306A\u3093\u3067\u3059\uFF01[VAR 0114(002A)]",
  "{\u91CE\u751F|\u3084\u305B\u3044}\u3067\u3000{\u51FA\u4F1A|\u3067\u3042}\u3046\u306E\u3082\\n\u30BF\u30DE\u30B4\u304B\u3089\u3000{\u751F|\u3046}\u307E\u308C\u308B\u306E\u3082\\r\\n\u3069\u3061\u3089\u3082\u3000{\u540C|\u304A\u306A}\u3058{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u3000\u3067\u3059\u3088\u30FC[VAR 0114(002A)]",
  "\u305F\u3060\u3057\u3000{\u9055|\u3061\u304C}\u3046{\u8A00\u8A9E|\u3052\u3093\u3054}\u3092\u3000{\u8A71|\u306F\u306A}\u3059{\u5730\u57DF|\u3061\u3044\u304D}\u3067\u3000{\u80B2|\u305D\u3060}\u3063\u305F\\n\u30DD\u30B1\u30E2\u30F3{\u540C\u58EB|\u3069\u3046\u3057}\u304B\u3089\u3000{\u751F|\u3046}\u307E\u308C\u305F\u3000\u30BF\u30DE\u30B4\u306F[VAR 0114(002A)]",
  "{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044\u3067\u3000{\u751F|\u3046}\u307E\u308C\u308B\u3000{\u78BA\u7387|\u304B\u304F\u308A\u3064}\u304C\\n{\u4E00\u822C|\u3044\u3063\u3071\u3093}\u3088\u308A\u3082\u3000{\u5927|\u304A\u304A}\u304D\u304F\u306A\u308A\u307E\u3059[VAR 0114(002A)]",
  "\u305D\u306E{\u7406\u7531|\u308A\u3086\u3046}\u306F\u3000\u307E\u3060\\n{\u89E3\u660E|\u304B\u3044\u3081\u3044}\u3055\u308C\u3066\u306A\u3044\u3093\u3067\u3059\u3051\u3069\u306D\u3048[VAR 0114(002A)]",
  "\u3042\u3068\u306F\u3000{\u6301|\u3082}\u3063\u3066\u308B\u3060\u3051\u3067\\n{\u8272\u9055|\u3044\u308D\u3061\u304C}\u3044\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u306B\u3000{\u4F1A|\u3042}\u3044\u3084\u3059\u304F\u306A\u308B\\r\\n\u304A\u307E\u3082\u308A\u304C\u3000\u3042\u308B\u3068\u304B\u3000\u306A\u3044\u3068\u304B\u2026\u2026[VAR 0114(002A)]",
  "{\u79D1\u5B66\u7684|\u304B\u304C\u304F\u3066\u304D}\u3067\u306F\u3000\u306A\u3044\u3067\u3059\u304C\\n\u3082\u3057\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u3060\u3063\u305F\u3089\u3000{\u697D|\u305F\u306E}\u3057\u3044\u3067\u3059\u3088\u306D\u3048[VAR 0114(002A)]",
  "\u2026\u2026\u3042\u3000\u30C1\u30E3\u30A4\u30E0\u3000{\u9CF4|\u306A}\u3063\u3061\u3083\u3063\u305F[VAR 0114(002A)]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u304A\u3057\u307E\u3044\u3067\u3059\u30FC\\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3042[VAR 0114(002A)]"
]
