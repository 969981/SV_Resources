[
  "[~ 21]",
  "{\u79C1\u7ACB|\u3057\u308A\u3064}\u3000\u30AA\u30EC\u30F3\u30B8\u30A2\u30AB\u30C7\u30DF\u30FC",
  "{\u79C1\u7ACB|\u3057\u308A\u3064}\u3000\u30B0\u30EC\u30FC\u30D7\u30A2\u30AB\u30C7\u30DF\u30FC",
  "{\u4F1D\u7D71|\u3067\u3093\u3068\u3046}\u304B\u3089\u3000{\u5B66|\u307E\u306A}\u3073\\n{\u5F37|\u3064\u3088}\u304F\u3000{\u5927|\u304A\u304A}\u304D\u304F\u3000{\u80B2|\u305D\u3060}\u3064",
  "\u3072\u3068\u308A\u3072\u3068\u308A\u306E\u3000{\u500B\u6027|\u3053\u305B\u3044}\u3092\u3000{\u5927\u5207|\u305F\u3044\u305B\u3064}\u306B\\n{\u672A\u6765|\u307F\u3089\u3044}\u3092\u3000{\u5207|\u304D}\u308A{\u958B|\u3072\u3089}\u304F",
  "\u3055\u3042\u3000\u304D\u307F\u3082\\n\u30DD\u30B1\u30C3\u30C8\u30E2\u30F3\u30B9\u30BF\u30FC\u306E\u3000{\u4E16\u754C|\u305B\u304B\u3044}\u3078\uFF01",
  "\u30AA\u30EC\u30F3\u30B8\u30A2\u30AB\u30C7\u30DF\u30FC\\n{\u6821\u9577|\u3053\u3046\u3061\u3087\u3046}\u3000\u30AF\u30E9\u30D9\u30EB",
  "\u30B0\u30EC\u30FC\u30D7\u30A2\u30AB\u30C7\u30DF\u30FC\\n{\u6821\u9577|\u3053\u3046\u3061\u3087\u3046}\u3000\u30AF\u30E9\u30D9\u30EB",
  "\u305F\u304F\u3055\u3093\u306E{\u81EA\u7136|\u3057\u305C\u3093}\\n{\u8C4A|\u3086\u305F}\u304B\u306A{\u571F\u5730|\u3068\u3061}\u304C\u3000{\u5E83|\u3072\u308D}\u304C\u308B\u3000\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}",
  "\u3053\u3053\u306B\u306F\u3000\u30DD\u30B1\u30C3\u30C8\u30E2\u30F3\u30B9\u30BF\u30FC\u2026\u2026\\n\u3061\u3062\u3081\u3066\u3000\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u547C|\u3088}\u3070\u308C\u308B",
  "{\u4E0D\u601D\u8B70|\u3075\u3057\u304E}\u306A\u3000{\u751F|\u3044}\u304D{\u7269|\u3082\u306E}\u304C\\n{\u6570\u591A|\u304B\u305A\u304A\u304A}\u304F\u3000{\u66AE|\u304F}\u3089\u3057\u3066\u3044\u307E\u3059",
  "\u30DD\u30B1\u30E2\u30F3\u305F\u3061\u306F\u3000{\u6D77|\u3046\u307F}\u3084{\u7A7A|\u305D\u3089}\\n{\u753A|\u307E\u3061}\u306E{\u4E2D|\u306A\u304B}\u3000\u3044\u305F\u308B\u3068\u3053\u308D\u306B\u3000{\u4F4F|\u3059}\u3093\u3067\u3044\u3066",
  "{\u79C1|\u308F\u305F\u3057}\u305F\u3061\u3000{\u4EBA\u9593|\u306B\u3093\u3052\u3093}\u306F\u3000{\u5F7C|\u304B\u308C}\u3089\u3068\\n{\u52A9|\u305F\u3059}\u3051{\u5408|\u3042}\u3044\u3000{\u751F\u6D3B|\u305B\u3044\u304B\u3064}\u3057\u3066\u3044\u307E\u3059",
  "\u30AA\u30EC\u30F3\u30B8\u30A2\u30AB\u30C7\u30DF\u30FC\u3067\u306F\u3000\u305D\u3093\u306A\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3053\u3068\u3092\u3000\u3082\u3063\u3068{\u6DF1|\u3075\u304B}\u304F\u3000{\u77E5|\u3057}\u308B\u305F\u3081\u306B",
  "\u30B0\u30EC\u30FC\u30D7\u30A2\u30AB\u30C7\u30DF\u30FC\u3067\u306F\u3000\u305D\u3093\u306A\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3053\u3068\u3092\u3000\u3082\u3063\u3068{\u6DF1|\u3075\u304B}\u304F\u3000{\u77E5|\u3057}\u308B\u305F\u3081\u306B",
  "\u3044\u308D\u3093\u306A{\u5730\u65B9|\u3061\u307B\u3046}\u304B\u3089\u3000{\u4EBA|\u3072\u3068}\u304C{\u96C6|\u3042\u3064}\u307E\u308A\\n{\u7686|\u307F\u306A}\u3067\u3000{\u5B66|\u307E\u306A}\u3073\u3042\u3063\u305F\u308A",
  "\u30DD\u30B1\u30E2\u30F3\u30C8\u30EC\u30FC\u30CA\u30FC\u3068\u3057\u3066\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u6226|\u305F\u305F\u304B}\u308F\u305B\u3000\u3068\u3082\u306B{\u6210\u9577|\u305B\u3044\u3061\u3087\u3046}\u3057\u305F\u308A",
  "\u3055\u307E\u3056\u307E\u306A\u3000{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}{\u5185\u5BB9|\u306A\u3044\u3088\u3046}\u3067\\n{\u751F\u5F92|\u305B\u3044\u3068}\u306E{\u53EF\u80FD\u6027|\u304B\u306E\u3046\u305B\u3044}\u3092\u3000{\u5F15|\u3072}\u304D{\u51FA|\u3060}\u3057\u307E\u3059",
  "\u3053\u3053\u306F\u3000{\u4EF2\u9593|\u306A\u304B\u307E}\u3068\u3000\u30DD\u30B1\u30E2\u30F3\u3068\\n{\u65B0|\u3042\u305F\u3089}\u3057\u3044{\u81EA\u5206|\u3058\u3076\u3093}\u306B\u3000{\u51FA\u4F1A|\u3067\u3042}\u3048\u308B{\u5834\u6240|\u3070\u3057\u3087}\u2026\u2026",
  "\u30AA\u30EC\u30F3\u30B8\u30A2\u30AB\u30C7\u30DF\u30FC\u3078\u306E\\n{\u5165\u5B66|\u306B\u3085\u3046\u304C\u304F}\u3092\u3000{\u5FC3|\u3053\u3053\u308D}\u3088\u308A\u3000\u304A{\u5F85|\u307E}\u3061\u3057\u3066\u3044\u307E\u3059",
  "\u30B0\u30EC\u30FC\u30D7\u30A2\u30AB\u30C7\u30DF\u30FC\u3078\u306E\\n{\u5165\u5B66|\u306B\u3085\u3046\u304C\u304F}\u3092\u3000{\u5FC3|\u3053\u3053\u308D}\u3088\u308A\u3000\u304A{\u5F85|\u307E}\u3061\u3057\u3066\u3044\u307E\u3059"
]
