[
  "\u3088\u3046\u3053\u305D\u30FC\\n\u30DF\u30E2\u30B6\u306E{\u533B\u52D9\u5BA4|\u3044\u3080\u3057\u3064}\u3078\u30FC[VAR 0114(0028)]",
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u3069\u30FC\u3057\u305F\u306E\uFF1F\\n\u3042\u3093\u305F\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\\r\\n{\u5168\u7136|\u305C\u3093\u305C\u3093}\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u305D\u30FC\u3060\u3051\u3069\u2026\u2026[VAR 0114(0028)]",
  "\u3063\u3066\u3000\u3042\u308C\uFF1F\\n{\u521D|\u306F\u3058}\u3081\u3066{\u898B|\u307F}\u308B\u3000{\u9854|\u304B\u304A}\u3060\u306D\uFF1F[VAR 0114(0028)]",
  "\u3078\u3048\u30FC\u3000{\u8EE2\u5165|\u3066\u3093\u306B\u3085\u3046}\u3057\u3066\u304D\u305F\\n\u3070\u3063\u304B\u308A\u306A\u3093\u3060\u30FC[VAR 0114(0028)]",
  "\u3044\u3084\u3044\u3084\u3000\u305D\u3046\u3044\u3046{\u624B\u6CD5|\u3057\u3085\u307B\u3046}\\n{\u4ECA|\u3044\u307E}\u3069\u304D\u3000{\u6D41\u884C|\u306F\u3084}\u3093\u306A\u3044\u304B\u3089\u2026\u2026[VAR 0114(0028)]",
  "\u3042\u30FC\u3000[VAR 0100(0000)]\u306D\uFF01\\n{\u5642|\u3046\u308F\u3055}\u306B\u306A\u3063\u3066\u308B{\u5B50|\u3053}\u3058\u3083\u30FC\u3093[VAR 0114(0028)]",
  "{\u5165\u5B66\u65E9\u3005|\u306B\u3085\u3046\u304C\u304F\u305D\u3046\u305D\u3046}\u3000{\u5D16|\u304C\u3051}\u304B\u3089\u3000{\u843D|\u304A}\u3061\u305F\u3068\u304B\\n\u30B9\u30BF\u30FC{\u56E3|\u3060\u3093}\u3068\u3000\u30AC\u30C1\u30F3\u30B3\u3057\u305F\u3068\u304B\uFF1F\\r\\n\u3051\u3063\u3053\u30FC\u3000{\u8A71\u984C|\u308F\u3060\u3044}\u306E{\u4EBA|\u3072\u3068}\u3060\u3088[VAR 0114(0028)]",
  "\u3042\u3000\u305D\u3046\u3060\\n{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u3063\u3066\u3084\u3064\u3000{\u59CB|\u306F\u3058}\u307E\u3063\u305F\u3093\u3067\u3057\u3087\u30FC\uFF1F[VAR 0114(0028)]",
  "{\u5916|\u305D\u3068}\u3067\u3000\u304A\u3082\u3057\u308D\u3044\u3053\u3068\u3000\u3042\u3063\u305F\u3089\u3055\\n{\u533B\u52D9\u5BA4|\u3044\u3080\u3057\u3064}\u307E\u3067\u3000{\u6559|\u304A\u3057}\u3048\u306B\u304D\u3066\u3088[VAR 0114(0028)]",
  "\u3060\u3063\u3066\u3000\u3042\u305F\u3057\u3000\u30D2\u30DE\u306A\u3093\u3060\u30FC\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3082\u3000{\u6301|\u3082}\u3063\u3066\u306A\u3044\u3057\\r\\n\u3053\u3053\u3000\u30B5\u30DC\u308A\u306B{\u6765|\u304F}\u308B\u3000{\u751F\u5F92|\u305B\u3044\u3068}\u3070\u3063\u304B\u3060\u3057\u2026\u2026[VAR 0114(0028)]",
  "\u3093\u3058\u3083\u3000\u3088\u308D\u30FC\\n{\u7D04\u675F|\u3084\u304F\u305D\u304F}\u3060\u3088\u30FC[VAR 0114(0028)]",
  "\u30DF\u30E2\u30B6{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3068\\n\u3061\u3087\u3063\u3068\u3000\u306A\u304B\u3088\u304F\u306A\u3063\u305F\uFF01"
]
