[
  "\u305D\u308C\u3067\u306F\u3000\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u3000\u30CD\u30E2\\n{\u4EE3|\u304B}\u308F\u308A\u3092\u3000\u304A{\u9858|\u306D\u304C}\u3044\u3057\u307E\u3059\u306D[VAR 0114(002C)]",
  "\u307E\u3063\u304B\u305B\u3066\u304F\u3060\u3055\u3044\u3088\uFF01\\n\u3080\u3057\u308D\u3000{\u697D|\u305F\u306E}\u3057\u307F\u3067\u3059\uFF01[VAR 0114(0004)]",
  "\u305D\u308C\u3067\u306F\u3000\u304A\u307E\u304B\u305B\u3057\u307E\u3059\\n\u3054\u304D\u3052\u3093\u3088\u3046[VAR 0114(002C)]",
