  "\u3042\u3000[VAR 0100(0000)]\uFF01[VAR 0114(0004)]",
  "{\u4ECA|\u3044\u307E}\u306E{\u4EBA|\u3072\u3068}\u306F\uFF1F",
  "\u3059\u3054\u305D\u3046\u306A{\u4EBA|\u3072\u3068}\u2026\u2026",
  "[VAR 0100(0000)]\u3082\u3000{\u6C17|\u304D}\u306B\u306A\u308B\u3088\u306D\uFF01\\n\u3042\u306E{\u4EBA|\u3072\u3068}\u306F\u3000\u30C8\u30C3\u30D7\u3063\u3066\u3000{\u547C|\u3088}\u3070\u308C\u3066\u308B\\c\\n{\u5F37|\u3064\u3088}\u304F\u3066\u3000\u3059\u3054\u304F\u3066\u3000\u304B\u3063\u3053\u3088\u304F\u3066\\n\u308F\u305F\u3057\u306E{\u76EE\u6A19|\u3082\u304F\u3072\u3087\u3046}\u3067\u2026\u2026\\c\\n\u3044\u3084\uFF01\u3000\u30DD\u30B1\u30E2\u30F3\u30C8\u30EC\u30FC\u30CA\u30FC\u306A\u3089\\n{\u8AB0|\u3060\u308C}\u3082\u304C\u3000\u3042\u3053\u304C\u308C\u308B{\u4EBA|\u3072\u3068}\u3000\u306A\u3093\u3060\u30FC\uFF01[VAR 0114(0004)]",
  "\u3084\u3063\u3071\u3000\u308F\u304B\u308B\uFF01\uFF1F\\n\u3042\u306E{\u4EBA|\u3072\u3068}\u306F\u3000\u30C8\u30C3\u30D7\u3063\u3066\u3000{\u547C|\u3088}\u3070\u308C\u3066\u308B\\c\\n{\u5F37|\u3064\u3088}\u304F\u3066\u3000\u3059\u3054\u304F\u3066\u3000\u304B\u3063\u3053\u3088\u304F\u3066\\n\u308F\u305F\u3057\u306E{\u76EE\u6A19|\u3082\u304F\u3072\u3087\u3046}\u3067\u2026\u2026\\c\\n\u3044\u3084\uFF01\u3000\u30DD\u30B1\u30E2\u30F3\u30C8\u30EC\u30FC\u30CA\u30FC\u306A\u3089\\n{\u8AB0|\u3060\u308C}\u3082\u304C\u3000\u3042\u3053\u304C\u308C\u308B{\u4EBA|\u3072\u3068}\u3000\u306A\u3093\u3060\u30FC\uFF01[VAR 0114(0004)]",
  "\u3042\u3063\uFF01\u3000\u305D\u308C\u3067\u3055\uFF01\\n\u3055\u3063\u304D\u306E\u3000{\u6559\u5BA4|\u304D\u3087\u3046\u3057\u3064}\u3067\u306E{\u8A71|\u306F\u306A\u3057}\uFF01[VAR 0114(0004)]",
  "\u308F\u305F\u3057\u306E{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u306B\u3000{\u56F3\u9451|\u305A\u304B\u3093}\u306E{\u5B8C\u6210|\u304B\u3093\u305B\u3044}\u3092\\n{\u76EE\u6307|\u3081\u3056}\u3059\u3063\u3066\u3000{\u8A00|\u3044}\u3063\u3066\u304F\u308C\u305F\u3088\u306D\uFF01\\r\\n\u3067\u3082\u3000\u3084\u3063\u3071\u308A\u3055\u2026\u2026[VAR 0114(0004)]",
  "\u308F\u305F\u3057\u306E{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u306B\u3000{\u5F37|\u3064\u3088}\u3044\u30C8\u30EC\u30FC\u30CA\u30FC\u3092\\n{\u76EE\u6307|\u3081\u3056}\u3059\u3063\u3066\u3000{\u8A00|\u3044}\u3063\u3066\u304F\u308C\u305F\u3088\u306D\uFF01\\r\\n\u305D\u308C\u306A\u3089\u3055\u2026\u2026[VAR 0114(0004)]",
  "\u308F\u305F\u3057\u306E{\u8CEA\u554F|\u3057\u3064\u3082\u3093}\u306B\u3000{\u76EE\u6307|\u3081\u3056}\u3059\u3082\u306E\u304C\\n\u308F\u304B\u3089\u306A\u3044\u3063\u3066\u3000{\u8A00|\u3044}\u3063\u3066\u305F\u3067\u3057\u3087\uFF01\\r\\n\u305D\u308C\u306A\u3089\u3055\u2026\u2026[VAR 0114(0004)]",
  "[VAR 0100(0000)]\u3082\\n[VAR FF00(0006)]\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF[VAR FF00(0000)]\u3000{\u76EE\u6307|\u3081\u3056}\u3057\u3066\u307F\u306A\u3044\uFF01\uFF1F[VAR 0114(0004)]",
  "\u3044\u3044\u3088\uFF01",
  "\u3046\u30FC\u3093\u2026\u2026",
  "\u3048\uFF01\u3000{\u8A71|\u306F\u306A\u3057}\u3000\u306F\u3084\u3059\u304E\uFF01\\n\u3068\u308A\u3042\u3048\u305A\u3000{\u8AAC\u660E|\u305B\u3064\u3081\u3044}\u3055\u305B\u3066\u307B\u3057\u3044\u306A\uFF01[VAR 0114(0004)]",
  "\u3048\u30FC\uFF01\u3000{\u5F37|\u3064\u3088}\u3044\u3093\u3060\u304B\u3089\\n\u3082\u3063\u305F\u3044\u306A\u3044\u3088\u30FC\uFF01[VAR 0114(0004)]",
  "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u3063\u3066\u306E\u306F\\n\u30DD\u30B1\u30E2\u30F3\u3092\u3000{\u935B|\u304D\u305F}\u3048\u3066\\r\\n\u305D\u306E{\u6280|\u308F\u3056}\u3067\u3000{\u4EBA\u3005|\u3072\u3068\u3073\u3068}\u3092\u3000{\u9B45\u4E86|\u307F\u308A\u3087\u3046}\u3059\u308B\\r\\n\u30DD\u30B1\u30E2\u30F3{\u52DD\u8CA0|\u3057\u3087\u3046\u3076}\u3000\u30D7\u30ED{\u7D1A|\u304D\u3085\u3046}\u306E{\u4EBA|\u3072\u3068}\u305F\u3061\uFF01[VAR 0114(0004)]",
  "\u30DD\u30B1\u30E2\u30F3\u30EA\u30FC\u30B0\u306B\u3000{\u8A8D|\u307F\u3068}\u3081\u3089\u308C\u308B\u3068\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u3092\u3000{\u540D\u4E57|\u306A\u306E}\u308C\u308B\u3093\u3060[VAR 0114(0004)]",
  "\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u306B\u3000{\u5230\u9054|\u3068\u3046\u305F\u3064}\u3059\u308B\u306B\u306F\\n{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3092\u3000{\u53D7|\u3046}\u3051\u308B\u3060\u3051\u3058\u3083\u3000\u30C0\u30E1\u3067\\c\\n\uFF18\u3064\u306E\u3000\u30DD\u30B1\u30E2\u30F3\u30B8\u30E0\u3092\u3000{\u52DD|\u304B}\u3061{\u629C|\u306C}\u3044\u3066\\n\u30B8\u30E0\u30D0\u30C3\u30B8\u3092\u3000{\u96C6|\u3042\u3064}\u3081\u308B\u3093\u3060\u3088\uFF01[VAR 0114(0004)]",
  "\u305D\u3057\u305F\u3089\u3000{\u7279\u5225|\u3068\u304F\u3079\u3064}\u306A\u30C6\u30B9\u30C8\u2026\u2026\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30C6\u30B9\u30C8\u306B\u3000{\u6311\u6226|\u3061\u3087\u3046\u305B\u3093}\u3067\u304D\u308B[VAR 0114(0004)]",
  "{\u5408\u683C|\u3054\u3046\u304B\u304F}\u3059\u308C\u3070\u3000{\u6674|\u306F}\u308C\u3066\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u306B\u3000\u306A\u308C\u308B\u3093\u3060\u3088\uFF01[VAR 0114(0004)]",
  "\u30DD\u30B1\u30E2\u30F3\u30C8\u30EC\u30FC\u30CA\u30FC\u3000\u307F\u3093\u306A\u306E\u3042\u3053\u304C\u308C\uFF01\\n\u3059\u3063\u3054\u3044{\u79F0\u53F7|\u3057\u3087\u3046\u3054\u3046}\u3000\u306A\u306E\u3060\u30FC\uFF01\\r\\n\u2026\u2026\u3063\u3066\u3000{\u81EA\u5206|\u3058\u3076\u3093}\u3067{\u8A00|\u3044}\u3046\u306E\u3000{\u6065|\u306F}\u305A\u304B\u3057\u3044\u306D[VAR 0114(0004)]",
  "\u308F\u305F\u3057\u306F\u3000{\u524D\u56DE|\u305C\u3093\u304B\u3044}\u306E{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u3067\\n\u30C1\u30E3\u30F3\u30D4\u30AA\u30F3\u30E9\u30F3\u30AF\u306B\u3000\u306A\u3063\u305F\u3093\u3060\uFF01[VAR 0114(0004)]",
  "\u3042\u3000{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u3063\u3066\u3044\u3046\u306E\u306F\\n\u3082\u3046\u3059\u3050{\u59CB|\u306F\u3058}\u307E\u308B\u3000{\u7279\u5225|\u3068\u304F\u3079\u3064}\u306A{\u8AB2\u5916\u6388\u696D|\u304B\u304C\u3044\u3058\u3085\u304E\u3087\u3046}\uFF01\\r\\n{\u524D|\u307E\u3048}\u306E\u306F\u3000{\u5165\u5B66\u65E9\u3005|\u306B\u3085\u3046\u304C\u304F\u305D\u3046\u305D\u3046}\u3000\u3042\u3063\u305F\u3093\u3060\uFF01[VAR 0114(0004)]",
  "{\u5B66\u6821|\u304C\u3063\u3053\u3046}\u306E{\u5916|\u305D\u3068}\u3067\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u3057\u306A\u304C\u3089\\n{\u81EA\u7531|\u3058\u3086\u3046}\u306B\u3000{\u5B66|\u307E\u306A}\u3079\u3066\u3000{\u697D|\u305F\u306E}\u3057\u3044\u3093\u3060\u3088\uFF01[VAR 0114(0004)]",
  "{\u4ECA|\u3044\u307E}\u3000{\u601D|\u304A\u3082}\u3048\u3070\u3000\u3042\u306E{\u7D4C\u9A13|\u3051\u3044\u3051\u3093}\u304C\\n{\u5B9D\u7269|\u305F\u304B\u3089\u3082\u306E}\u2026\u2026\u3000\u3060\u3063\u305F\u306E\u304B\u306A\uFF1F[VAR 0114(0004)]",
  "[VAR 0100(0000)]\u3068\u3000{\u4E00\u7DD2|\u3044\u3063\u3057\u3087}\u306A\u3089\\n\u308F\u305F\u3057\u3082\u3000\u3082\u3063\u3068\u3000{\u5F37|\u3064\u3088}\u304F\u306A\u308C\u308B\u2026\u2026[VAR 0114(0004)]",
  "\u3042\u3089\u304B\u3058\u3081\u3000\u30B8\u30E0\u306E{\u5834\u6240|\u3070\u3057\u3087}\\n\u30DE\u30C3\u30D7\u30A2\u30D7\u30EA\u306B\u3000{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3057\u3061\u3083\u304A\u3063\u304B\uFF01[VAR 0114(0004)]",
  "{\u8003|\u304B\u3093\u304C}\u3048\u3068\u3044\u3066\u306D\uFF01[VAR 0114(0004)]"
