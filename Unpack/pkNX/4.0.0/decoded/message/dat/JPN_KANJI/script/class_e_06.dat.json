[
  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u3082\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000\u30D0\u30C8\u30EB{\u5B66|\u304C\u304F}\uFF01\\n{\u62BC\u5FCD|\u304A\u3059}\uFF01\u3000\u3084\u3063\u3066\u3044\u304F\u305E\uFF01[VAR 0114(0024)]",
  "\u3053\u306E{\u524D|\u307E\u3048}\u3000{\u6559|\u304A\u3057}\u3048\u305F\u3000\u304A\u307E\u304B\u305B\u30D0\u30C8\u30EB\uFF01\\n\u307F\u3093\u306A\u3000\u3084\u3063\u3066\u304F\u308C\u3066\u308B\u3060\u308D\u3046\u304B\uFF01[VAR 0114(0024)]",
  "\u304A\u307E\u304B\u305B\u3092\u3000{\u4F7F|\u3064\u304B}\u3044\u3053\u306A\u305B\u3070\u3000\u30DD\u30B1\u30E2\u30F3\u3092\\n\u305F\u304F\u3055\u3093\u3000{\u6210\u9577|\u305B\u3044\u3061\u3087\u3046}\u3055\u305B\u308B\u3053\u3068\u304C\u3000\u3067\u304D\u308B\u3057[VAR 0114(0024)]",
  "\u308F\u3056\u30DE\u30B7\u30F3\u30DE\u30B7\u30F3\u3067\u3000{\u4F7F|\u3064\u304B}\u3048\u308B\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n\u304A\u3068\u3057\u3082\u306E\u3082\u3000{\u52B9\u7387|\u3053\u3046\u308A\u3064}\u3088\u304F\u3000{\u96C6|\u3042\u3064}\u3081\u3089\u308C\u308B\uFF01[VAR 0114(0024)]",
  "\u308F\u3056\u30DE\u30B7\u30F3\u30DE\u30B7\u30F3\uFF01\\n\u30AD\u30DF\u305F\u3061\u3000{\u4F7F|\u3064\u304B}\u3063\u3066\u3044\u308B\u304B\uFF1F[VAR 0114(0024)]",
  "\u305D\u308C\u3058\u3083\u3042\u3000\u30C1\u30A7\u30C3\u30AF\u3059\u308B\u305E\uFF01[VAR 0114(0024)]",
  "\u308F\u3056\u30DE\u30B7\u30F3\u3092\u3000{\u4F5C|\u3064\u304F}\u308B\u306B\u306F\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u304A\u3068\u3057\u3082\u306E\u3068\u3000\u3082\u3046\u3072\u3068\u3064\\r\\n{\u4F55|\u306A\u306B}\u304C\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u3060\u3063\u305F\u304B\u3000\u304A\u307C\u3048\u3066\u3044\u308B\u304B\uFF1F[VAR 0114(0024)]",
  "\uFF2C\uFF30",
  "\uFF28\uFF30",
  "\u304A{\u91D1|\u304B\u306D}",
  "{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\uFF01\u3000\u30AD\u30DF\u306F\\n\u3059\u3067\u306B\u3000{\u4F7F|\u3064\u304B}\u3044\u3053\u306A\u3057\u3066\u305D\u3046\u3060\u306A\uFF01[VAR 0114(0024)]",
  "\u304A\u3044\u304A\u3044\u3000{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\uFF01\\n\uFF28\uFF30\u3092\u3000\u3055\u3057\u3060\u3059\u306A\u3093\u3066\\r\\n{\u5100\u5F0F|\u304E\u3057\u304D}\u307F\u305F\u3044\u306A\u3053\u3068\u306F\u3000\u306A\u3044\u305E\uFF01[VAR 0114(0024)]",
  "{\u60DC|\u304A}\u3057\u3044\u305E\u3000{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\uFF01\\n{\u4E16|\u3088}\u306E{\u4E2D|\u306A\u304B}\u3000\u306A\u3093\u3067\u3082\u3000\u304A{\u91D1|\u304B\u306D}\u3067\\r\\n\u3053\u3068\u304C\u3000{\u904B|\u306F\u3053}\u3076\u308F\u3051\u3067\u306F\u3000\u306A\u3044\u3093\u3060\uFF01[VAR 0114(0024)]",
  "{\u7B54|\u3053\u305F}\u3048\u306F\u3000\u30EA\u30FC\u30B0\u30DA\u30A4\uFF01\\n{\u901A\u79F0|\u3064\u3046\u3057\u3087\u3046}\u3000\uFF2C\uFF30\u3060\u306A\uFF01[VAR 0114(0024)]",
  "\uFF2C\uFF30\u306F\u3000\u308F\u3056\u30DE\u30B7\u30F3\u30DE\u30B7\u30F3\u3067\u3000\u30DD\u30B1\u30E2\u30F3\u306E\\n\u304A\u3068\u3057\u3082\u306E\u3068\u3000{\u5F15|\u3072}\u304D{\u63DB|\u304B}\u3048\u3067\u304D\u308B\u305E\uFF01[VAR 0114(0024)]",
  "{\u6700\u8FD1|\u3055\u3044\u304D\u3093}\u3000\u30CF\u30C3\u30AD\u30F3\u30B0\uFF1F\u3000\u3068\u3044\u3046\u3084\u3064\u3067\\n\uFF2C\uFF30\u3092\u3000{\u4E0D\u6B63|\u3075\u305B\u3044}\u306B\u3000{\u624B|\u3066}\u306B{\u5165|\u3044}\u308C\u3066\u3044\u308B{\u8F29|\u3084\u304B\u3089}\u3082\\r\\n\u3044\u308B\u3068\u3000{\u805E|\u304D}\u3044\u3066\u3044\u308B\u2026\u2026[VAR 0114(0024)]",
  "\u30AD\u30DF\u305F\u3061\u306F\u3000\u305D\u3093\u306A\\n{\u60AA\u4E8B|\u3042\u304F\u3058}\u306B\u3000{\u624B|\u3066}\u3092{\u67D3|\u305D}\u3081\u306A\u3044\u3088\u3046\u306B\uFF01[VAR 0114(0024)]",
  "{\u4F5C|\u3064\u304F}\u308A\u305F\u3044\u3000\u308F\u3056\u30DE\u30B7\u30F3\u306F\\n\u30A6\u30A9\u30C3\u30C1{\u767B\u9332|\u3068\u3046\u308D\u304F}\u3059\u308C\u3070\u3000\u304A\u3068\u3057\u3082\u306E\u306E\\r\\n{\u96C6|\u3042\u3064}\u307E\u308A{\u5177\u5408|\u3050\u3042\u3044}\u3092\u3000\u3044\u3064\u3067\u3082\u3000\u30C1\u30A7\u30C3\u30AF\u3067\u304D\u308B\u305E[VAR 0114(0024)]",
  "{\u7D50\u8AD6|\u3051\u3064\u308D\u3093}\uFF01\uFF01[VAR 0114(0024)]",
  "\u308F\u3056\u30DE\u30B7\u30F3\u3092\u3000{\u4F5C|\u3064\u304F}\u308B\u306B\u306F\u3000\u3068\u306B\u304B\u304F\\n\u30DD\u30B1\u30E2\u30F3\u306E\u3000\u304A\u3068\u3057\u3082\u306E\u304C\u3000{\u5FC5\u8981|\u3072\u3064\u3088\u3046}\u3060\uFF01[VAR 0114(0024)]",
  "\u30DD\u30B1\u30E2\u30F3\u3068\u3000{\u6226|\u305F\u305F\u304B}\u3044\u307E\u304F\u3063\u3066\\n\u305F\u304F\u3055\u3093\u3000\u304A\u3068\u3057\u3082\u306E\u3092\u3000{\u96C6|\u3042\u3064}\u3081\u3066\u304F\u308C\uFF01[VAR 0114(0024)]",
  "\u30E0\u30E0\uFF01\u3000{\u4F53|\u304B\u3089\u3060}\u3067\u3000{\u4F53\u9A13|\u305F\u3044\u3051\u3093}\u3057\u3066\u3082\u3089\u304A\u3046\u3068\\n{\u601D|\u304A\u3082}\u3063\u305F\u304C\u3000\u3082\u3046{\u6642\u9593|\u3058\u304B\u3093}\u304B\u2026\u2026[VAR 0114(0024)]",
  "\u305D\u308C\u3067\u306F\u3000{\u89E3\u6563|\u304B\u3044\u3055\u3093}\u3060\uFF01\\n\u304A\u306E\u304A\u306E\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306B\u3000{\u904E|\u3059}\u3054\u3057\u3066\u304F\u308C\uFF01[VAR 0114(0024)]"
