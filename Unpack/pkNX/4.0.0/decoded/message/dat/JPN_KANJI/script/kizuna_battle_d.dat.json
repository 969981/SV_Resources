  "\u308F\u305F\u3057\u306E\u3000\u3044\u3044\u3068\u3053\u308D\u306F\u3000{\u5143\u6C17|\u3052\u3093\u304D}\u306A\u3068\u3053\u308D\uFF01\\n\u305D\u3063\u3061\u306B\u3000{\u6CE8\u529B|\u3061\u3085\u3046\u308A\u3087\u304F}\u3059\u308B\u3053\u3068\u306B\u3000\u3057\u305F\u305E\uFF01[VAR 0114(0024)]",
  "{\u6388\u696D|\u3058\u3085\u304E\u3087\u3046}\u3067\u3082\u3000{\u8A00|\u3044}\u3063\u305F\u3060\u308D\u3046\uFF1F\\n\u2026\u2026{\u4EBA|\u3072\u3068}\u3082\u3000\u30DD\u30B1\u30E2\u30F3\u3082\\r\\n\u3044\u3044\u3068\u3053\u308D\u3092\u3000{\u4F38|\u306E}\u3070\u3057\u3066\u3042\u3052\u306A\u3044\u3068\u306A\uFF01[VAR 0114(0024)]",
  "{\u8EE2\u5165\u751F|\u3066\u3093\u306B\u3085\u3046\u305B\u3044}\u306B\u306F\u3000{\u4E16\u8A71|\u305B\u308F}\u306B\u306A\u3063\u305F\uFF01\\n{\u6C17\u6301|\u304D\u3082}\u3061\u3092\u3000{\u53D7|\u3046}\u3051\u3068\u3063\u3066\u304F\u308C\uFF01[VAR 0114(0024)]",
  "\u3055\u3066\u3000{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u3069\u3046\u3084\u3063\u3066\\n\u30BF\u30F3\u30D1\u30AF{\u8CEA|\u3057\u3064}\u3092\u3000{\u88DC\u7D66|\u307B\u304D\u3085\u3046}\u3057\u3088\u3046\u304B\u306A\uFF01[VAR 0114(0024)]",
