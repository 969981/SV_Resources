  "{\u76EE\u6A19|\u3082\u304F\u3072\u3087\u3046}\u306F\u3000{\u9054\u6210|\u305F\u3063\u305B\u3044}\u3057\u305F\u304B\u3089\\n{\u6599\u7406|\u308A\u3087\u3046\u308A}\u306F\u3000\u3057\u3070\u3089\u304F\u3000\u304A{\u4F11|\u3084\u3059}\u307F\u3060\uFF01[VAR 0114(0024)]",
  "\u2026\u2026\u3042\u3042\u3000{\u76EE\u6A19|\u3082\u304F\u3072\u3087\u3046}\u3068\u3044\u3046\u306E\u306F\\n\u3044\u3064\u3082\u3000\u304A{\u4E16\u8A71|\u305B\u308F}\u306B\u3000\u306A\u3063\u3066\u3044\u308B\\r\\n\u30DF\u30E2\u30B6{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306B\u3000{\u6069\u8FD4|\u304A\u3093\u304C\u3048}\u3057\u3059\u308B\u3053\u3068\u3060[VAR 0114(0024)]",
