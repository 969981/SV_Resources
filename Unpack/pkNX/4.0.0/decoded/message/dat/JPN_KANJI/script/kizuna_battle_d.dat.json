  "\u30CF\u30CF\u30CF\uFF01\u3000\u308F\u305F\u3057\u306B\\n{\u4F1A|\u3042}\u3044\u306B\u304D\u3066\u304F\u308C\u305F\u306E\u304B\uFF01[VAR 0114(0024)]",
  "\u308F\u305F\u3057\u306F\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u3092\\n{\u54C1\u5B9A|\u3057\u306A\u3055\u3060}\u3081\u3000\u3057\u3066\u3044\u308B\u3093\u3060\uFF01[VAR 0114(0024)]",
  "{\u8CFC\u8CB7\u90E8|\u3053\u3046\u3070\u3044\u3076}\u306E\u3000\u30B5\u30F3\u30C9\u30A6\u30A3\u30C3\u30C1\u306F\\n\u304A\u3044\u3057\u304F\u3066\u3000{\u6804\u990A|\u3048\u3044\u3088\u3046}\u30D0\u30E9\u30F3\u30B9\u3082\u3000{\u6700\u9AD8|\u3055\u3044\u3053\u3046}\u3060\u305E\uFF01[VAR 0114(0024)]",
  "{\u624B\u4F5C|\u3066\u3065\u304F}\u308A\u306F\uFF1F",
