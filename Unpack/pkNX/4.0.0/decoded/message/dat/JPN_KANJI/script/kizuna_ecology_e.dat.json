[
  "\u3042\u3000[VAR 0100(0000)]\u3055\u3093\\n\u3069\u304A\u3082\u3000\u3069\u304A\u3082\uFF01[VAR 0114(002A)]",
  "\u3048\uFF01\uFF1F\u3000\u3082\u3057\u304B\u3057\u3066\\n\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u3000\uFF14\uFF10\uFF10{\u7A2E\u985E|\u3057\u3085\u308B\u3044}\uFF01\\r\\n{\u96C6|\u3042\u3064}\u3081\u3066\u304F\u3060\u3055\u3063\u305F\u3093\u3067\u3059\u304B\u3042\uFF01\uFF1F[VAR 0114(002A)]",
  "\u308F\u3042\u30FC\u3000\u308F\u3042\u30FC\uFF01\\n\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u306E\u3000{\u5B8C\u6210|\u304B\u3093\u305B\u3044}\u3060\u3042\u30FC\uFF01\\r\\n\u3059\u3054\u3044\u30FC\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3059\u3054\u3044\u3067\u3059\u30FC\uFF01[VAR 0114(002A)]",
  "\u30D1\u30EB\u30C7\u30A2{\u5730\u65B9|\u3061\u307B\u3046}\u306E\u3000\u30DD\u30B1\u30E2\u30F3{\u8ABF\u67FB|\u3061\u3087\u3046\u3055}\u306F\\n[VAR 0100(0000)]\u3055\u3093\u306E\u3000\u304A\u304B\u3052\u3067\\r\\n\u3053\u308C{\u4EE5\u4E0A|\u3044\u3058\u3087\u3046}\u306A\u3044\u304F\u3089\u3044\u3000{\u9032|\u3059\u3059}\u307F\u307E\u3057\u305F\u3042\uFF01[VAR 0114(002A)]",
  "\u3053\u306E{\u524D|\u307E\u3048}\u3000\u3042\u3084\u3057\u3044\u304A{\u5E97|\u307F\u305B}\u3067\u3000{\u8CB7|\u304B}\u3063\u305F\\n\u304A\u307F\u3084\u3052\u3067\u3000\u3059\u307F\u307E\u305B\u3093\u304C\\r\\n{\u5148\u751F|\u305B\u3093\u305B\u3044}\u304B\u3089\u3000\u3053\u3061\u3089\u3000\u30D7\u30EC\u30BC\u30F3\u30C8\u3067\u3059\uFF01[VAR 0114(002A)]",
  "{\u4F55|\u306A\u306B}\u304B\u3000\u3082\u3063\u3068\u3000\u3061\u3083\u3093\u3068\u3057\u305F\u3082\u306E\\n\u3042\u3052\u3089\u308C\u308C\u3070\u3000\u3044\u3044\u3093\u3067\u3059\u3051\u3069\u304A\u2026\u2026[VAR 0114(002A)]",
  "{\u4F55|\u306A\u306B}\u3084\u3089\u3000\u3055\u308F\u304C\u3057\u3044\u3067\u3059\u304C\\n\u3069\u3046\u3055\u308C\u307E\u3057\u305F\u304B\uFF1F[VAR 0114(000A)]",
  "\u3042\u3000\u30AF\u30E9\u30D9\u30EB{\u5148\u751F|\u305B\u3093\u305B\u3044}\uFF01\\n\u3058\u3064\u306F\u3000\u304B\u304F\u304B\u304F\u3057\u304B\u3058\u304B\u3067\u2026\u2026[VAR 0114(002A)]",
  "\u306A\u3093\u3068\uFF01[VAR 0114(000A)]",
  "[VAR 0100(0000)]\u3055\u3093\u3000\u305D\u3093\u306A{\u5049\u696D|\u3044\u304E\u3087\u3046}\u3092\\n{\u9054\u6210|\u305F\u3063\u305B\u3044}\u3055\u308C\u305F\u306E\u3067\u3059\u306D[VAR 0114(000A)]",
  "\u307C\u304F\u3082\\n\u30D3\u30C3\u30AF\u30EA\u3057\u3061\u3083\u3044\u307E\u3057\u305F\u3088\u30FC[VAR 0114(002A)]",
  "\u30B8\u30CB\u30A2{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3082\u3000{\u559C|\u3088\u308D\u3053}\u3093\u3067\u3044\u307E\u3059\u3057\\n{\u79C1|\u308F\u305F\u3057}\u304B\u3089\u3082\u3000\u304A{\u795D|\u3044\u308F}\u3044\u3055\u305B\u3066\u304F\u3060\u3055\u3044[VAR 0114(000A)]",
  "\u2026\u2026\u304C\u3093\u3070\u3063\u3066\u3044\u308B{\u751F\u5F92|\u305B\u3044\u3068}\u306B\u306F\\n{\u8CDE\u72B6|\u3057\u3087\u3046\u3058\u3087\u3046}\u3092\u3000{\u5DEE|\u3055}\u3057{\u4E0A|\u3042}\u3052\u307E\u3057\u3087\u3046\\c\\n\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451|\u305A\u304B\u3093}\u3092\u3000{\u8A8D\u5B9A|\u306B\u3093\u3066\u3044}\u3057\u3066\u3044\u308B\\n{\u4F01\u696D|\u304D\u304E\u3087\u3046}\u304B\u3089\u3082\u3000\u30E1\u30C3\u30BB\u30FC\u30B8\u304C\u3000{\u5C4A|\u3068\u3069}\u3044\u3066\u3044\u307E\u3059\u3088[VAR 0114(000A)]",
  "{\u56F3\u9451|\u305A\u304B\u3093}\u30A2\u30D7\u30EA\u3067\u3000\u3044\u3064\u3067\u3082\\n{\u898B|\u307F}\u3089\u308C\u308B\u3088\u3046\u306B\u3000\u3057\u3066\u304A\u304D\u307E\u3057\u305F[VAR 0114(000A)]",
  "\u30AF\u30E9\u30D9\u30EB{\u5148\u751F|\u305B\u3093\u305B\u3044}\u306F\\n\u30D7\u30ED\u30B0\u30E9\u30DF\u30F3\u30B0\u3082\u3000\u3059\u3054\u3044\u3093\u3067\u3059[VAR 0114(002A)]",
  "\u305D\u308C\u306F\u305D\u3046\u3068\u3000[VAR 0100(0000)]\u3055\u3093\\n{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\u3000\u3088\u304F\u304C\u3093\u3070\u308A\u307E\u3057\u305F\u306D\u3048[VAR 0114(002A)]",
  "[VAR 0100(0000)]\u3055\u3093\u306E\u3000{\u5B9D|\u305F\u304B\u3089}\u304C\\n\u30DD\u30B1\u30E2\u30F3{\u56F3\u9451\u5B8C\u6210|\u305A\u304B\u3093\u304B\u3093\u305B\u3044}\u3000\u3060\u3063\u305F\u306A\u3089\\r\\n{\u5B9D\u63A2|\u305F\u304B\u3089\u3055\u304C}\u3057\u3000{\u5927\u6210\u529F|\u3060\u3044\u305B\u3044\u3053\u3046}\u3067\u3059\u306D\u3048\uFF01[VAR 0114(002A)]",
  "\u305F\u3057\u304B\u306B\u3000\u30B8\u30CB\u30A2{\u5148\u751F|\u305B\u3093\u305B\u3044}\\n\u3044\u3044\u3053\u3068\u3000{\u8A00|\u3044}\u3046\u3058\u3083\u306A\u3044\u3067\u3059\u304B[VAR 0114(000A)]",
  "\u3048\u3078\u3078\u2026\u2026\u3000{\u4E00\u5FDC|\u3044\u3061\u304A\u3046}\\n{\u62C5\u4EFB|\u305F\u3093\u306B\u3093}\u306E{\u5148\u751F|\u305B\u3093\u305B\u3044}\u3000\u3067\u3059\u304B\u3089[VAR 0114(002A)]",
  "{\u56F3\u9451|\u305A\u304B\u3093}\u306F\u3000{\u5B8C\u6210|\u304B\u3093\u305B\u3044}\u3057\u305F\u3068\u3057\u3066\u3082\\n\u307E\u3060\u307E\u3060\u3000{\u5192\u967A|\u307C\u3046\u3051\u3093}\u306F\u3000{\u59CB|\u306F\u3058}\u307E\u3063\u305F\u3070\u304B\u308A[VAR 0114(002A)]",
  "\u3053\u308C\u304B\u3089\u3082\u3000\u30D1\u30EB\u30C7\u30A2\u306E\u30DD\u30B1\u30E2\u30F3\u306B\\n\u3044\u30FC\u3063\u3071\u3044\u3000{\u51FA\u4F1A|\u3067\u3042}\u3063\u3066\u304F\u3060\u3055\u3044\u306D\u3048[VAR 0114(002A)]",
  "{\u6821\u9577|\u3053\u3046\u3061\u3087\u3046}\u3082\u3000{\u898B\u5B88|\u307F\u307E\u3082}\u3063\u3066\u3044\u307E\u3059\u3088[VAR 0114(000A)]"
