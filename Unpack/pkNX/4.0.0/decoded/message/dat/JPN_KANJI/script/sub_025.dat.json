  "\u30D2\u30C3\u30D2\uFF01\u3000\u30EF\u30B7\u306F\\n[VAR 0101(0001)]{\u5927\u597D|\u3060\u3044\u3059}\u304D\u3000{\u9AA8\u8463\u54C1|\u3053\u3063\u3068\u3046\u3072\u3093}\u30B3\u30EC\u30AF\u30BF\u30FC",
  "[VAR 0109(0002)]\u3000[VAR 0201(0003)]{\u500B|\u3053}\u3067\\n\u3044\u308F\u304F\u3064\u304D\u306E{\u9AA8\u8463\u54C1|\u3053\u3063\u3068\u3046\u3072\u3093}\u3068\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u3066\u3084\u308D\u3046\u304B\uFF1F",
  "[VAR 0109(0002)]\u304C\u3000{\u8DB3|\u305F}\u308A\u3093\u3088\u3046\u3058\u3083\\n[VAR 0101(0001)]\u3068\u3000{\u6226|\u305F\u305F\u304B}\u3048\u3070\\r\\n\u3072\u3087\u3063\u3053\u308A\u3000{\u843D|\u304A}\u3068\u3057\u3066\u304F\u308C\u308B\u305E\u3044",
  "\u30D2\u30C3\u30D2\uFF01\u3000\u3053\u308C\u3058\u3083\u3000\u3053\u308C\u3058\u3083\\n[VAR 0101(0001)]\u3092\u3000{\u8EAB\u8FD1|\u307F\u3062\u304B}\u306B\u3000{\u611F|\u304B\u3093}\u3058\u3089\u308C\u308B\u308F\u3044",
  "\u305D\u308C\u3058\u3083\u3042\u3000{\u7D04\u675F|\u3084\u304F\u305D\u304F}\u306E{\u54C1|\u3057\u306A}\u3058\u3083\\n\u3044\u3044{\u6028\u5FF5|\u304A\u3093\u306D\u3093}\u304C\u3000\u3053\u3082\u3063\u3068\u308B\u305E",
