  "\u30DB\u30C3\u30DB\uFF01\u3000\u30EF\u30B7\u306F\\n[VAR 0101(0001)]{\u5927\u597D|\u3060\u3044\u3059}\u304D\u3000{\u9AA8\u8463\u54C1|\u3053\u3063\u3068\u3046\u3072\u3093}\u30B3\u30EC\u30AF\u30BF\u30FC",
  "[VAR 0109(0002)]\u3000[VAR 0201(0003)]{\u500B|\u3053}\u3067\\n\u304A\u3081\u3067\u305F\u3044{\u9AA8\u8463\u54C1|\u3053\u3063\u3068\u3046\u3072\u3093}\u3068\u3000{\u4EA4\u63DB|\u3053\u3046\u304B\u3093}\u3057\u3066\u3084\u308D\u3046\u304B\uFF1F",
