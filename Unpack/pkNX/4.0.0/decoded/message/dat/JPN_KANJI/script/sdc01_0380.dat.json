[
  "\u30AD\u30C1\u30AD\u30AE\u30B9\u3055\u307E\u3063\u3066\u3000{\u672C\u5F53|\u307B\u3093\u3068\u3046}\u306B\\n{\u7A7A|\u305D\u3089}\u3092\u3000{\u98DB|\u3068}\u3079\u308B\u3093\u3060\u306D\uFF01\\r\\n{\u9B3C|\u304A\u306B}\u304C{\u5C71|\u3084\u307E}\u3092\u3000\u30AE\u30E5\u30FC\u30F3\u3063\u3066\u3000{\u98DB|\u3068}\u3093\u3067\u3063\u305F\uFF01",
  "\u3068\u3082\u3063\u3053\u306E\u3000\u30A4\u30A4\u30CD\u30A4\u30CC\u3055\u307E\uFF01\\n{\u7D2B|\u3080\u3089\u3055\u304D}\u306E\u30DE\u30D5\u30E9\u30FC\u304C\u3000{\u7D20\u6575|\u3059\u3066\u304D}\u306D\uFF01\\r\\n{\u8352\u5730|\u3042\u308C\u3061}\u3067\u3000\u304A{\u6563\u6B69|\u3055\u3093\u307D}\u3057\u3066\u305F\u306E\uFF01",
  "{\u4EBA|\u3072\u3068}\u304C\u3000{\u5012|\u305F\u304A}\u308C\u3066\u308B\u3068\u3000{\u601D|\u304A\u3082}\u3063\u305F\u3089\\n\u304A{\u663C\u5BDD\u4E2D|\u3072\u308B\u306D\u3061\u3085\u3046}\u306E\u3000\u30DE\u30B7\u30DE\u30B7\u30E9\u3055\u307E\u3000\u3058\u3083\u3063\u305F\uFF01\\c\\n\u305F\u3057\u304B\u306B\u3000{\u6C60|\u3044\u3051}\u306E\u307E\u308F\u308A\u306F\\n{\u5BDD\u5FC3\u5730|\u306D\u3054\u3053\u3061}\u3000\u30D0\u30C4\u30B0\u30F3\u3058\u3083\u304B\u3089\u306E",
  "\u3068\u3082\u3063\u3053\u306E{\u60C5\u5831|\u3058\u3087\u3046\u307B\u3046}\\n\uFF11\u3064\u3081\u3092\u3000{\u624B|\u3066}\u306B{\u5165|\u3044}\u308C\u305F\uFF01",
  "\u3068\u3082\u3063\u3053\u306E{\u60C5\u5831|\u3058\u3087\u3046\u307B\u3046}\\n\uFF12\u3064\u3081\u3092\u3000{\u624B|\u3066}\u306B{\u5165|\u3044}\u308C\u305F\uFF01",
  "\u3068\u3082\u3063\u3053\u305F\u3061\u306E\\n{\u60C5\u5831|\u3058\u3087\u3046\u307B\u3046}\u304C\u3000{\u96C6|\u3042\u3064}\u307E\u3063\u3066\u304D\u305F\uFF01\\r\\n\u30BC\u30A4\u30E6\u305F\u3061\u3068\u3000{\u5408\u6D41|\u3054\u3046\u308A\u3085\u3046}\u3057\u3088\u3046\uFF01",
  "\u3068\u3082\u3063\u3053\u306E\u3000{\u76EE\u6483\u60C5\u5831|\u3082\u304F\u3052\u304D\u3058\u3087\u3046\u307B\u3046}\\n\u304B\u305F\u3063\u3071\u3057\u304B\u3089\u3000{\u96C6|\u3042\u3064}\u3081\u308B\u308F\u3088\uFF01\\r\\n{\u7D42|\u304A}\u308F\u3063\u305F\u3089\u3000{\u5408\u6D41|\u3054\u3046\u308A\u3085\u3046}\u306D\uFF01[VAR 0114(0044)]",
  "\u3044\u304F\u3089\u3000{\u6751|\u3080\u3089}\u306E{\u4EBA|\u3072\u3068}\u3067\u3082\\n{\u8A71|\u306F\u306A}\u3057\u304B\u3051\u3093\u306E\u3000{\u7167|\u3066}\u308C\u3093\u3079\u2026\u2026[VAR 0114(0043)]"
]
