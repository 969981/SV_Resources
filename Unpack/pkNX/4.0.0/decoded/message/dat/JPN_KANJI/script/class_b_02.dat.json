  "\uFF12\uFF10\uFF10\uFF10{\u5186|\u3048\u3093}\u3067\u3000\uFF12\uFF10\uFF10{\u5186|\u3048\u3093}\u306E\u3000\u30E2\u30F3\u30B9\u30BF\u30FC\u30DC\u30FC\u30EB\u306F\\n\uFF11\uFF10{\u500B|\u3053}\u3000{\u8CB7|\u304B}\u3046\u3053\u3068\u304C\u3000\u3067\u304D\u307E\u3059\u2026\u2026\u3000\u304C\uFF01[VAR 0114(0025)]",
  "\u30E2\u30F3\u30B9\u30BF\u30FC\u30DC\u30FC\u30EB{\u7CFB|\u3051\u3044}\u306E\u3000{\u9053\u5177|\u3069\u3046\u3050}\u3092\\n\u307E\u3068\u3081\u3066\u3000\uFF11\uFF10{\u500B\u4EE5\u4E0A|\u3053\u3044\u3058\u3087\u3046}\u3000{\u8CB7|\u304B}\u3046\u3068[VAR 0114(0025)]",
