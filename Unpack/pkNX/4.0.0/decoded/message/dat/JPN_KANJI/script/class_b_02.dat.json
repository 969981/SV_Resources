  "{\u4ECA\u65E5|\u304D\u3087\u3046}\u306F\u3000\u308F\u305F\u3057\u304C\u3000{\u5927\u597D|\u3060\u3044\u3059}\u304D\u306A\\n\u304A{\u8CB7|\u304B}\u3044\u3082\u306E\u3092\u3000\u30C6\u30FC\u30DE\u306B\\r\\n{\u6570\u5B57|\u3059\u3046\u3058}\u3092\u3000\u304A{\u52C9\u5F37|\u3079\u3093\u304D\u3087\u3046}\u3057\u3066\u3044\u304D\u307E\u3057\u3087\u3046\uFF01[VAR 0114(0025)]",
