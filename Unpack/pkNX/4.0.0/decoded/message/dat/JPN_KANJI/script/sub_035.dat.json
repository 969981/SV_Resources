  "\u3042\u306A\u305F\u306E\u3000[VAR 0102(0001)]\u306F\\n\u3048\u30FC\u3068\u3000\u305D\u3046\u306D\u3047\u2026\u2026",
  "\u30A4\u30C3\u30C4\u3000\u30A2\u3000\u30D3\u30C3\u30B0\u3000\u30DD\u30B1\u30E2\u30F3\uFF01\uFF01\uFF01\uFF01\\c\\n\u3053\u3093\u306A\u306B\u3000{\u5927|\u304A\u304A}\u304D\u3044\u306E\\n\u3081\u3063\u305F\u306B\u3000\u304A{\u76EE|\u3081}\u306B\u3000\u304B\u304B\u308C\u306A\u3044\u308F\uFF01",
